532","spoiler":false},{"segments":[{"spoiler":false,"text":"三海賊の一人であり、“黒蛇商会” の主として商人の顔も持つ女性。"},{"spoiler":false,"text":"海賊の隠れ港を統治し、港にある娼館の経営も行なっている。"},{"spoiler":false,"text":"直接戦闘ではなく、絡め手や権謀術数によって物事に勝利していく頭脳派。"},{"spoiler":false,"text":"同じ三海賊のオリヴィアとは今まで何度も小競り合いを起こしており、仇敵として互いに相手を忌み嫌っている関係。"}],"source":"bangumi","sourceCharacterId":"89933"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c47a999a9ae12808fe8d99c92677188291eb666039e41b2594309cf3edeee21b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40086bb98d56ea3b1c5c4ef2b499eb8ff929a7879e4cd64bd0dc3b4eddfc1b55.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122992:89933:5741:1","source":"bangumi"}]},{"characterId":"char_c31951","characterName":"クレア・コクラウン","sourceIds":{"bangumi":[{"characterId":"89934","match":"exact-normalized-name-in-linked-work","subjectId":"122992"}],"egsCharacterIds":["6063"],"vndbCharacterId":"c31951"},"originalCharacterName":"クレア・コクラウン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A navy officer and a junior of Klaus. She was a friend of Klaus' deceased sister, and has been acquainted with Klaus from an early age and treated him like a brother."},{"spoiler":false,"text":"She has a cheerful and friendly personality, and although there are some gaps, she is very good navigator. She has always been secretly in love with her childhood friend, Klaus."},{"spoiler":false,"text":"Edited from Getchu"}],"source":"vndb","sourceCharacterId":"c31951"},{"segments":[{"spoiler":false,"text":"ヴァンクラッドが身体を乗っ取ったクラウスの後輩であり、海軍に所属する航海士。"},{"spoiler":false,"text":"クラウスの死んだ妹の友人で、幼い頃からクラウスと面識があり、彼を兄のように慕っていた。明るく、人懐っこい性格でどこか抜けたところがあるが、航海士としては非常に優秀。"},{"spoiler":false,"text":"幼馴染のクラウスに昔からずっと恋心を抱いている。"}],"source":"egs","sourceCharacterId":"6063","sourceWorkId":"21532","spoiler":false},{"segments":[{"spoiler":false,"text":"ヴァンクラッドが身体を乗っ取ったクラウスの後輩であり、海軍に所属する航海士。"},{"spoiler":false,"text":"明るく人懐っこい性格で、どこか抜けたところもあるが航海士としては非常に優秀。"},{"spoiler":false,"text":"クラウスの死んだ妹の友人で、幼い頃からクラウスと面識があった。"},{"spoiler":false,"text":"幼なじみである彼を兄のように慕い、そしてずっと恋心を抱いている。"}],"source":"bangumi","sourceCharacterId":"89934"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0c2f1842213802619a0a7939956466b07f17909602f266ce9e47fed4dd0a841.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b69b87f25b7c4120068f13d664d6d330da035eb1f84d732bd2f0e08112806c63.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤乃 理香","creatorId":"vndb:s945","sourcePersonId":"vndb:s945","canonicalEntityId":"vndb:s945","name":"藤乃 理香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62894","source":"vndb"}]},{"characterId":"char_c49387","characterName":"クラウス・アインハルト","sourceIds":{"bangumi":[{"characterId":"89935","match":"exact-normalized-name-in-linked-work","subjectId":"122992"}],"egsCharacterIds":["6060"],"vndbCharacterId":"c49387"},"originalCharacterName":"クラウス・アインハルト","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young Navy officer whose body was possesses by Van Clad, the protagonist of this work."},{"spoiler":false,"text":"His original personality was kind, diligent, hardworking and he was highly valued by others."},{"spoiler":false,"text":"Van Clad, who possessed his body, uses the trust that Klaus had from his surroundings to manipulate the navy and the pirates as he plans to achieve vengeance."},{"spoiler":false,"text":"Edited from Getchu"}],"source":"vndb","sourceCharacterId":"c49387"},{"segments":[{"spoiler":false,"text":"本作の主人公で、ヴァンクラッドに身体を乗っ取られてしまった海軍将校の青年。"},{"spoiler":false,"text":"元の人格は、心優しく勤勉で努力家で周囲からの評価は非常に高かった。"},{"spoiler":false,"text":"その身体を乗っ取ったヴァンクラッドは、クラウスが持っていた周囲からの信頼を利用して、海軍の顔と海賊の顔を使い分け、復讐を成就させようと画策していく。"}],"source":"egs","sourceCharacterId":"6060","sourceWorkId":"21532","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公で、ヴァンクラッドに身体を乗っ取られてしまった海軍将校の青年。"},{"spoiler":false,"text":"元の人格は心優しく勤勉で努力家。 周囲からの評価も非常に高かった。"},{"spoiler":false,"text":"周囲からの信頼を利用しながら海賊としても暗躍し、2つの顔を使い分けることで復讐を成就させようと画策していく。"}],"source":"bangumi","sourceCharacterId":"89935"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/ccb31a2e817bcbab65cbe4a50e2c408b7a855428a76b7785ae2665b913e928e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c72ef0e646d44cc8ccf7b8f30cfc44336e509371c1ffe805b0818c93df0d8f6.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c49388","characterName":"テオ","sourceIds":{"bangumi":[{"characterId":"89937","match":"exact-normalized-name-in-linked-work","subjectId":"122992"}],"egsCharacterIds":["6064"],"vndbCharacterId":"c49388"},"originalCharacterName":"テオ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Cecil's younger brother, a boy who lives with other orphans in the slums."},{"spoiler":false,"text":"His personality is s