8318","sourcePersonId":"vndb:s8318","canonicalEntityId":"vndb:s8318","name":"石谷 春貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:72229","source":"vndb"}]},{"characterId":"char_c69238","characterName":"とりの","sourceIds":{"bangumi":[],"egsCharacterIds":["19493"],"vndbCharacterId":"c69238"},"originalCharacterName":"とりの","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"308"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アリカの海賊団にいる自称、アリカの舎弟。"},{"spoiler":false,"text":"エセ任侠な口調を多用する。"},{"spoiler":false,"text":"アリカを親分と慕い、青を組長と慕い、リルフィーを社長と慕う。"},{"spoiler":false,"text":"つまり忠誠心の欠片もない、気まぐれお気楽な女性。"},{"spoiler":false,"text":"基本はものぐさで、真面目にお仕事をするのが大嫌いだが、面白いことや危険な遊びには興味津々。"},{"spoiler":false,"text":"ゴシップや噂話にも目がなく、青や空子と一緒に悪ふざけをして、よく怒られる。"},{"spoiler":false,"text":"アホだと自覚はしているが、それこそ海賊だという風に誤認している。"},{"spoiler":false,"text":"忠誠心はないというものの、アリカに対しては家族としての愛情が強く、アリカを本気で傷つけようとする存在は絶対に許さない。"}],"source":"egs","sourceCharacterId":"19493","sourceWorkId":"24664","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"19493","sourceWorkId":"24664","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40616b441338a9cecad0ae627d20cae105a18a88611dbf7554794256d9c8bcfe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85bf3511e34b0cc63090e81d239586ac7a70f95f46ea751047c871af3ba60a6d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朝香 ゆず","creatorId":"vndb:s14336","sourcePersonId":"vndb:s14336","canonicalEntityId":"vndb:s1