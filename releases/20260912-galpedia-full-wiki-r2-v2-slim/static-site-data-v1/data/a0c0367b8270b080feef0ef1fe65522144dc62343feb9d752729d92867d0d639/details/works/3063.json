etail"},"actors":[]},{"characterId":"char_vndb_c34998","characterName":"神応寺 古都","sourceIds":{"vndbCharacterId":"c34998"},"originalCharacterName":"神応寺 古都","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1128"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuichi's classmate."},{"spoiler":false,"text":"Koto is the only daughter of the wealthy and well-connected Kamiouji family. As would be expected for an ojou-sama character, she has been sheltered for a good part of her life. Due to her upbringing, she is very docile and more likely to follow than lead."},{"spoiler":false,"text":"Koto joins the Occult Study Group out of sheer curiosity, or so she claims."},{"spoiler":false,"text":"Taken from a review by Moroboshi Yuumei"}],"source":"vndb","sourceCharacterId":"c34998"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a168f0deb590ce43ac9c53c9cfb432d1eb480be140abd08c22af0026f132ae57.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a48f24c4c7595de86f66db7f4f547336f924d699b0967425c95891ec50e5019.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"乃田 あす実","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"韮井叶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12877","source":"vndb"}]},{"characterId":"char_vndb_c34999","characterName":"木乃内 ひなた","sourceIds":{"vndbCharacterId":"c34999"},"originalCharacterName":"木乃内 ひなた","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"803"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"147"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious first-year student."},{"spoiler":false,"text":"Hinata comes from a family with an extensive history of martial arts. Despite being of short stature, she is actually very strong and quite capable when it comes to physical activities. During her first days at school, she managed to try out every sports club, only to find all of them to be too easy for her. She did not earn her reputation as a \"monster\" until she defeated the president of the Judo club in a sparring match. Things did not improve for her after several members of the club tried to ambush her repeatedly (only for her to beat them with ease)."},{"spoiler":false,"text":"Wishing to see something new, Hinata decides to join the Occult Study Group."},{"spoiler":false,"text":"Taken from a review by Moroboshi Yuumei"}],"source":"vndb","sourceCharacterId":"c34999"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73b185b40d5e6a9d76306337d52bfb6b6cf0a2c81ef74e5f0c7c58349c966e5f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/1915bcc8134d3eabf7ee37de6e130042ba8c88c1816f99768595cbb94497de13.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茶谷 やすら","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12872","source":"vndb"}]},{"characterId":"char_vndb_c35000","characterName":"八乙女 維月","sourceIds":{"vndbCharacterId":"c35000"},"originalCharacterName":"八乙女 維月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"419"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"169"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Lead heroine and childhood friend of Yuuichi."},{"spoiler":false,"text":"At heart, Itsuki is a strong and determined girl. For the most part, her classmates are intimidated by her quick wit and notable intellect (resulting in keeping their distance from her). Because of this, she has grown used to doing things her way."},{"spoiler":false,"text":"Though she will never openly admit it, she feels good when leading and protecting others. In fact, her sense of responsibility for others is what caused her to leave the school's computer club (where she was concidered a master hacker) and start the Occult Study Group."},{"spoiler":false,"text":"Taken from a review by Moroboshi Yuumei"}],"source":"vndb","sourceCharacterId":"c35000"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98c677dc31a344edbe7ae6b3f86574f678db80aee1b085f48785a432e8804f91.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/043f631d477270a704d8969e5be531ccb1a0b4f0e218a5b6c4288c306d8d43f1.webp","width":228,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本条 真琴","creatorId":"vndb:s2246","sourcePersonId":"vndb:s2246","canonicalEntityId":"vndb:s2246","name":"本条 真琴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12878","source":"vndb"}]},{"characterId":"char_vndb_c35001