{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"13253","model":{"presentationWorkId":"vndb:v2886","staff":{"artwork":[{"creditedName":"松竜","creatorId":"vndb:s1159","sourcePersonId":"egs:creator:2044","canonicalEntityId":"vndb:s1159","name":"松竜","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:81609","source":"egs"},{"creditedName":"双月明","creatorId":"egs:creator:12886","sourcePersonId":"egs:creator:12886","canonicalEntityId":"egs:creator:12886","name":"双月明","roleCode":"artwork","roleLabel":"原画","identityStatus":"no-alias-hit","relationId":"egs:work-creator:81610","source":"egs"},{"creditedName":"こもわた遙華","creatorId":"vndb:s1804","sourcePersonId":"egs:creator:5521","canonicalEntityId":"vndb:s1804","name":"こもわた遙華","detail":"SD原画","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:81611","source":"egs"}],"scenario":[{"creditedName":"高瀬奈緒文","creatorId":"vndb:s5595","sourcePersonId":"egs:creator:2376","canonicalEntityId":"vndb:s5595","name":"高瀬奈緒文","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:81612","source":"egs"},{"creditedName":"竜リン(折畑啓助)","creatorId":"vndb:s4084","sourcePersonId":"egs:creator:3549","canonicalEntityId":"vndb:s4084","name":"竜リン(折畑啓助)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:81613","source":"egs"},{"creditedName":"座敷猫(飯崎島)","creatorId":"vndb:s3671","sourcePersonId":"egs:creator:1977","canonicalEntityId":"vndb:s3671","name":"座敷猫(飯崎島)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:81614","source":"egs"},{"creditedName":"企画屋","creatorId":"vndb:s1025","sourcePersonId":"egs:creator:188","canonicalEntityId":"vndb:s1025","name":"企画屋","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:81615","source":"egs"}],"music":[{"creditedName":"Many Miles High","creatorId":"egs:creator:12887","sourcePersonId":"egs:creator:12887","canonicalEntityId":"egs:creator:12887","name":"Many Miles High","roleCode":"music","roleLabel":"作品音乐","identityStatus":"no-alias-hit","relationId":"egs:work-creator:85797","source":"egs"},{"creditedName":"四十万 行道","creatorId":"vndb:s1033","sourcePersonId":"vndb:s1033","canonicalEntityId":"vndb:s1033","name":"四十万 行道","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:38593","source":"vndb"}],"other":[{"creditedName":"高瀬奈緒文","creatorId":"vndb:s5595","sourcePersonId":"egs:creator:2376","canonicalEntityId":"vndb:s5595","name":"高瀬奈緒文","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:218829","source":"egs"},{"creditedName":"三咲 里奈","creatorId":"vndb:s516","sourcePersonId":"vndb:s516","canonicalEntityId":"vndb:s516","name":"伊藤 静","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:38590","source":"vndb"},{"creditedName":"水霧 けいと","creatorId":"vndb:s955","sourcePersonId":"vndb:s955","canonicalEntityId":"vndb:s955","name":"水桐 けいと","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:38591","source":"vndb"},{"creditedName":"神月 社","creatorId":"vndb:s4003","sourcePersonId":"vndb:s4003","canonicalEntityId":"vndb:s4003","name":"神月 社","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:38597","source":"vndb"}]},"cast":[{"characterId":"char_c13882","characterName":"朱島 歩武","sourceIds":{"bangumi":[],"egsCharacterIds":["17942"],"vndbCharacterId":"c13882"},"originalCharacterName":"朱島 歩武","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The hero. A young man doomed to clean up Yumina's messes."},{"spoiler":false,"text":"After joining the Debate Club together with Yumina, he finds himself the club's errand boy - scouting opponents, guarding the candidate, and generally doing whatever Kirara tells him to. Ayumu has few memories of childhood and no knowledge of his parents. He was raised by a man named Akashima Takehito, who subjected Ayumu to a harsh regimen of martial arts and survival training. One day, Takehito revealed the purpose of Ayumu's training. He was to enter Jinbu Academy and protect Midorishita Yumina, a girl whom Takehito claimed would one day save the world. Little did Ayumu know that he would first have to save Yumina from her own bad grades."},{"spoiler":false,"text":"“ No way you're dragging me into this! ”"},{"spoiler":false,"text":"from jast website"}],"source":"vndb","sourceCharacterId":"c13882"},{"segments":[{"spoiler":false,"text":"神撫学園2年生。2-Cクラス・論説部。本編の主人公。"},{"spoiler":false,"text":"なんでも中庸。程ほどがんばり、それなりに成果を出す。"},{"spoiler":false,"text":"『翠下弓那という少女を守りにいけ』という父親の命令で神撫学園に転校してくる。"},{"spoiler":false,"text":"しかし、本人は父親のスパルタ教育の反動で、極端な面倒ごとを敬遠する性格。"},{"spoiler":false,"text":"この転校も、父親の支配から逃れられたことぐらいしか感じていなかったが……"},{"spoiler":false,"text":"「なんでこっちまで飛び火するんだ！面倒事なんて一切ごめんだぞ！」"}],"source":"egs","sourceCharacterId":"17942","sourceWorkId":"10991","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0e0a07a39ceecda2241494ae8321a614532bb034fac74222b95e04109a683a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37de7744c1a0992cb5760f71e274404647e84dafcc6b3d885afe783a68949ac6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井 真人","creatorId":"vndb:s395","sourcePersonId":"vndb:s395","canonicalEntityId":"vndb:s395","name":"福島 潤","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20866","source":"vndb"}]},{"characterId":"char_c13883","characterName":"翠下 弓那","sourceIds":{"bangumi":[{"characterId":"11699","match":"exact-normalized-name-in-linked-work","subjectId":"994"}],"egsCharacterIds":["17943"],"vndbCharacterId":"c13883"},"originalCharacterName":"翠下 弓那","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main heroine. Due to a failed test and a history of bad grades, she will have to repeat the second year unless she can become student council president, a position that comes with the power to change any school rule. Led by Kurokawa Kirara, she charges towards the one bright spot in a dark and dismal future. Yumina is a friendly and cheerful girl with stunning good looks. She does have more than a few screws loose, however, and completely fails to live up to her ideals of modesty, competence, and efficiency. In her quest to become student council president, she will face many passionate rivals and harsh challenges. How will the experience change her? Will she ever make the third year?"},{"spoiler":false,"text":"“ It's like the whole world is out to get me! ”"},{"spoiler":false,"text":"from jast website"}],"source":"vndb","sourceCharacterId":"c13883"},{"segments":[{"spoiler":false,"text":"神撫学園2年生。2-Cクラス・論説部。歩武のクラスメイト。"},{"spoiler":false,"text":"真面目で実直、一生懸命なガンバリ娘。"},{"spoiler":false,"text":"しかしその性格は何故か勉学で一切報われていない。"},{"spoiler":false,"text":"歩武とは喧嘩友達として、騒がしくも楽しい日々を過ごしている。"},{"spoiler":false,"text":"孤児院育ちの捨て子という経歴があるが、その過去をバネに育ててくれた人に恩返ししようと日々努力する。"},{"spoiler":false,"text":"「なんて不条理な世の中！どうしてあたしがこんな目に遭うわけ！？」"}],"source":"egs","sourceCharacterId":"17943","sourceWorkId":"10991","spoiler":false},{"segments":[{"spoiler":false,"text":"神抚学园二年级学生。歩武的同学。"},{"spoiler":false,"text":"一本正经表里如一性格十分努力的杂草魂系少女。"},{"spoiler":false,"text":"但是在学习方面她的努力完全没有得到回报，似乎天天苦于补考与补习与交报告。"},{"spoiler":false,"text":"与歩武在他转校时邂逅，之后作为友人一起过着喧嚣的日子。"},{"spoiler":false,"text":"有着被双亲抛弃在孤儿院里长大的过去，之所以执着于耿直的生活方式，也是因为有着能够在养育自己的人面前昂首挺胸地报恩的目标TOKA。"},{"spoiler":false,"text":"因此，与惫懒的歩武常常吵架。"}],"source":"bangumi","sourceCharacterId":"11699"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e77c4cf94f9387e9bcddde45d824c02da6dbf28a79256bbb19a3656f0870587.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/3700ca576932b4fe8cd89240b2bbbaa72eeb44cddf28e3feb24064750d5457ab.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水霧けいと","creatorId":"vndb:s955","sourcePersonId":"vndb:s955","canonicalEntityId":"vndb:s955","name":"水桐 けいと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10117:11699:6173:1","source":"bangumi"}]},{"characterId":"char_c13884","characterName":"黒河 雲母","sourceIds":{"bangumi":[{"characterId":"11700","match":"exact-normalized-name-in-linked-work","subjectId":"994"}],"egsCharacterIds":["17944"],"vndbCharacterId":"c13884"},"originalCharacterName":"黒河 雲母","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The mastermind behind Yumina's candidacy. She clearly has her own reasons for supporting Yumina, but she's not about to reveal them. Her diminutive figure belies a powerful ego, and she often uses cunning ploys and underhanded tricks to lead the Debate Club to victory. No one can tell what she's really thinking at any given moment, but she is often seen wearing a dark and dangerous smile. While few people would call themselves her friend, she does seem to have a vast network of contacts throughout the academy, a fact which only adds to the mystery surrounding this strange girl."},{"spoiler":false,"text":"“ ...Hmph, you're an odd one. ”"},{"spoiler":false,"text":"from jast website"}],"source":"vndb","sourceCharacterId":"c13884"},{"segments":[{"spoiler":false,"text":"神撫学園3年生。論説部の部長。"},{"spoiler":false,"text":"弓那に「星徒会大戦」出場を進言した張本人。"},{"spoiler":false,"text":"一見してチビッ子のような容姿だが、その本質は極悪人も裸足で逃げ出す腹黒さ。"},{"spoiler":false,"text":"智謀、策謀を得意とし、ありえない人脈を操る。"},{"spoiler":false,"text":"弓那を星徒会長候補に推したのには、何か裏があるようだ……。"},{"spoiler":false,"text":"「好奇心は猫をも殺す……お前の命は九つもないだろう？」"}],"source":"egs","sourceCharacterId":"17944","sourceWorkId":"10991","spoiler":false},{"segments":[{"spoiler":false,"text":"神抚学园三年级学生。辩论部部长。"},{"spoiler":false,"text":"出现在为了取消留级决定而四处奔走的弓那面前，邀请她参加大规模星徒会长选·星徒会大战。"},{"spoiler":false,"text":"与可爱的外貌相反有着腹黑的性格，在社团活动中也擅长智略与计策。"},{"spoiler":false,"text":"虽然能够称得上友人的相识甚少，但似乎在学园内拥有广泛的人脉，是个从上到下都高深莫测的人物。"},{"spoiler":false,"text":"计划让弓那成为星徒会长候补似乎也有着不可告人的目的。"},{"spoiler":false,"text":"虽然公称身高141cm，但那是包含了马尾的数值。"}],"source":"bangumi","sourceCharacterId":"11700"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00cc0e13c564b1e74949fca1b36882bec7d90cd35017795e1b734fe537cfe87b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3e07076566a0fec87ecf1de005a3cd6058d3758e23f0a8e754d6efed0d5d049.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水橋かおり","creatorId":"vndb:s131","sourcePersonId":"vndb:s131","canonicalEntityId":"vndb:s131","name":"水橋 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10117:11700:3851:1","source":"bangumi"}]},{"characterId":"char_c13885","characterName":"御木津 藍","sourceIds":{"bangumi":[{"characterId":"11701","match":"exact-normalized-name-in-linked-work","subjectId":"994"}],"egsCharacterIds":["17945"],"vndbCharacterId":"c13885"},"originalCharacterName":"御木津 藍","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An eccentric girl who transfers to Jinbu Academy shortly after the Election War begins. Despite her spotless record and glowing letters of recommendation, she decides to join the underdogs of the Debate Club. While glad of the boost to their strength, the other members wonder at her motives. She does seem to be interested in a certain someone... She claims to be an average girl born and raised in the heartland of Japan, but it is obvious from the things she says and does that there's something very off about this girl. Loyal to her desires, Ai always eats and plays to the fullest. When something grabs her interest, rest assured that she will pursue it no matter what stands in her way, often dragging other people (usually Ayumu) along for the ride. In contrast to her doll-like appearance, she shows incredible athletic ability."},{"spoiler":false,"text":"“ I look forward to working with you all. ”"},{"spoiler":false,"text":"from jast website"}],"source":"vndb","sourceCharacterId":"c13885"},{"segments":[{"spoiler":false,"text":"神撫学園1年生。論説部。歩武達の後輩。"},{"spoiler":false,"text":"「星徒会大戦」開幕後に学園に転入。論説部に入部。"},{"spoiler":false,"text":"予測不能、目的不明、意味のわからない言動を連発する不思議少女。"},{"spoiler":false,"text":"そんな彼女もクラスでは人気者。"},{"spoiler":false,"text":"そして、見かけによらず多趣味。"},{"spoiler":false,"text":"いつもはぼーっとしているが、興奮すると眼の色が変わる。"},{"spoiler":false,"text":"「これから正部員として、力を尽くさせてもらう。よろしく」"}],"source":"egs","sourceCharacterId":"17945","sourceWorkId":"10991","spoiler":false},{"segments":[{"spoiler":false,"text":"神抚学园1年生。在选举途中加入辩论部的谜之转校生。"},{"spoiler":false,"text":"才让人觉得有着什么不可告人的目的与使命，结果她的真实身份只是不认真工作的自由人。"},{"spoiler":false,"text":"貌似喜欢吃喝玩乐，以及调戏歩武和部长，这次也用他人难以理解的行动胡搅蛮缠。"}],"source":"bangumi","sourceCharacterId":"11701"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f536c5abfec28b7b4e0424a778d3e001cd8dd0f4131e71b370f39e752babc713.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5e456e41c5e071aed6b01b8978046c4df023dc9cc8cb64469d3441284a9491f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今井麻美","creatorId":"vndb:s240","sourcePersonId":"vndb:s240","canonicalEntityId":"vndb:s240","name":"今井 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10117:11701:4061:1","source":"bangumi"}]},{"characterId":"char_c13886","characterName":"本間 麻衣乃","sourceIds":{"bangumi":[{"characterId":"11704","match":"exact-normalized-name-in-linked-work","subjectId":"994"}],"egsCharacterIds":["17948"],"vndbCharacterId":"c13886"},"originalCharacterName":"本間 麻衣乃","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A shy, mild-mannered girl who loves to read books and take care of the school library. At Jinbu Academy, where athletics are king, culture clubs like the Library Committee occupy the bottom of the social pecking order. Even so, Maino works hard to make the voices of the minority heard across campus. She recognizes her lack of self-esteem and hopes to become more confident through the campaign. Her goal is an academy where all students are equal."},{"spoiler":false,"text":"“ I'm starting to understand what you meant,"},{"spoiler":false,"text":"Akashima-san. ”"},{"spoiler":false,"text":"from jast website"}],"source":"vndb","sourceCharacterId":"c13886"},{"segments":[{"spoiler":false,"text":"神撫学園2年生。図書委員会委員長。【第1回戦対立候補】"},{"spoiler":false,"text":"掃き溜めのような図書委員の中で、愛情を持って本を扱う少女。"},{"spoiler":false,"text":"内向的で、人付き合いも苦手。"},{"spoiler":false,"text":"今回は学園星徒の「意識改革」をマニュフェストに掲げての「星徒会大戦」参戦。"},{"spoiler":false,"text":"争いごとは苦手だけど、一生懸命がんばるつもりらしい。"},{"spoiler":false,"text":"「朱島さんの言うこと、少し、分かる気がします」"}],"source":"egs","sourceCharacterId":"17948","sourceWorkId":"10991","spoiler":false},{"segments":[{"spoiler":false,"text":"神抚学园二年级学生。图书委员会委员长。"},{"spoiler":false,"text":"不怎么擅长与人交往的内向少女。"},{"spoiler":false,"text":"然而，在众多因为比其他活动轻松这个理由而成为图书委员的星徒中，她对于管理书籍的热忱是货真价实的，曾几何时之间被周围的同伴们所认同，坐上了图书委员长的宝座。"},{"spoiler":false,"text":"在这次的星徒会大战中则是以学园星徒的意识改革为目标，被周围的人推上了风口浪尖，成为了候补者。"},{"spoiler":false,"text":"虽然不喜欢争论，对于竞争对手的弓那也以普通的态度接触，但似乎打算在辩论战中明确表示自己的意思。"}],"source":"bangumi","sourceCharacterId":"11704"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f22f78edd98733c0908ed424a84d275275e5e8adf91d3577342f8d3deb81d92f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36cb3dfb27cb395190bb6a56959a1279572a04d2b66d612fe81c04af71ed479c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10117:11704:4689:1","source":"bangumi"}]},{"characterId":"char_c13887","characterName":"緋ノ宮 黎","sourceIds":{"bangumi":[{"characterId":"11702","match":"exact-normalized-name-in-linked-work","subjectId":"994"}],"egsCharacterIds":["17949"],"vndbCharacterId":"c13887"},"originalCharacterName":"緋ノ宮 黎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Yumina's rival candidates, and the very person whose vote of no confidence kicked off this Election War. The leader of the Sports Clubs Alliance, Rei is a charismatic young man whose Casanova charm and dashing good looks have earned him the admiration of a large segment of the academy's female population. His fan club's membership is in the triple digits. Rei is not only enormously popular. He is also a first-rate tennis player who has led his team twice to victory in the national championships. Although he is considered one of the strongest contenders for student council president, some worry that he seems awfully fond of his little sister..."},{"spoiler":false,"text":"“ Sorry, but I'm taking over this rally! ”"},{"spoiler":false,"text":"from jast website"}],"source":"vndb","sourceCharacterId":"c13887"},{"segments":[{"spoiler":false,"text":"神撫学園3年生。男子硬式テニス部部長。【第2回戦対立候補】"},{"spoiler":false,"text":"最高のルックス。一流の運動神経。"},{"spoiler":false,"text":"まさに運動部のカリスマ・オブ・カリスマ。"},{"spoiler":false,"text":"学内にファンクラブを有するほどの人望で星徒をまとめあげた、「星徒会大戦」開催の立役者。"},{"spoiler":false,"text":"自らも次期星徒会会長を狙い立候補する。"},{"spoiler":false,"text":"そんな華麗な話題の影で、極度のシスコン疑惑も……。"},{"spoiler":false,"text":"「悪いが、その演説――この俺様が、支配する！」"}],"source":"egs","sourceCharacterId":"17949","sourceWorkId":"10991","spoiler":false},{"segments":[{"spoiler":false,"text":"神抚学园3年生。"},{"spoiler":false,"text":"男子硬式网球部的部长，在选举中作为运动部联合的代表成为候补。"},{"spoiler":false,"text":"尽管在2回战败给弓那，他的实力还是得到了承认。"},{"spoiler":false,"text":"弓那的好友灯的哥哥，每次有事时都会关照妹妹。"},{"spoiler":false,"text":"然而最近因为灯貌似开始展示出离开哥哥庇护的征兆，在烦恼着之类的。"}],"source":"bangumi","sourceCharacterId":"11702"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59f22e7c08a41565aa5157607d73dd24c33787ab735fe4425bb8e4ed35f6107b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95e528f1a17ea0e6d8630e0c49fe3069637b2f9f429691836781c7db888cb02e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤健太郎","creatorId":"vndb:s89","sourcePersonId":"vndb:s89","canonicalEntityId":"vndb:s89","name":"伊藤健太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10117:11702:4391:1","source":"bangumi"}]},{"characterId":"char_c13888","characterName":"緋ノ宮 灯","sourceIds":{"bangumi":[{"characterId":"11703","match":"exact-normalized-name-in-linked-work","subjectId":"994"}],"egsCharacterIds":["17946"],"vndbCharacterId":"c13888"},"originalCharacterName":"緋ノ宮 灯","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student, and Ayumu's classmate. Tomori is a kind and gentle girl who also happens to be Hinomiya Rei's younger sister. She and her brother are said to be quite close. Friends with Yumina since they entered the academy together, Tomori has been instrumental to Yumina's advancement. Without her help, Yumina would never have made it to second year. While she does not take part in this election's debate battles, she does provide support for Yumina and the rest of the Debate Club. Tomori has never had a boyfriend. This is due in large part to the fact that attempts to get close to her are invariably met with violent interference from an unknown third party."},{"spoiler":false,"text":"“ Let's all try to have a good time, okay? ”"},{"spoiler":false,"text":"from jast website"}],"source":"vndb","sourceCharacterId":"c13888"},{"segments":[{"spoiler":false,"text":"神撫学園2年生。2-Cクラス・論説部。歩武のクラスメイト。"},{"spoiler":false,"text":"みんなに好かれる優しい女の子。"},{"spoiler":false,"text":"弓那の勉強をサポートして、進級に大きく貢献した。"},{"spoiler":false,"text":"対戦相手・体育連合の“緋ノ宮黎”の妹でもある。"},{"spoiler":false,"text":"異性との交際経験はナシ。"},{"spoiler":false,"text":"一説によると彼女に近づく男は兄の妨害工作によって……？"},{"spoiler":false,"text":"「歩武くんも大変だろうけど、気楽に行こうよ、ね？」"}],"source":"egs","sourceCharacterId":"17946","sourceWorkId":"10991","spoiler":false},{"segments":[{"spoiler":false,"text":"神抚学园二年级学生。歩武他们的同学。"},{"spoiler":false,"text":"在班里也拥有人气的稳重温柔的少女。"},{"spoiler":false,"text":"緋ノ宮 黎的妹妹。与哥哥的关系似乎很好。"},{"spoiler":false,"text":"与弓那是自入学以来的朋友，弓那能够在二年级接着进级，原因的四成在她。"},{"spoiler":false,"text":"在今年的选举中虽然并没有亲自参加辩论战，但作为幕后人员支援着弓那她们的活动。"},{"spoiler":false,"text":"顺带一提，至今为止还没有与异性交往过。"},{"spoiler":false,"text":"这据说是因为被她吸引向她接近的男子，暗地里受到了激烈无比的妨碍工作的关系。"}],"source":"bangumi","sourceCharacterId":"11703"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d18427f95b2b7728d51a37c44dc8c0ba7506a9749e746686e2c0f5f73dc58e60.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/745b1002c6dad0f159bf89522c7da730cf12ba9d533049a87f055e21bba949a7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10117:11703:4714:1","source":"bangumi"}]},{"characterId":"char_c13889","characterName":"坂上 陽子","sourceIds":{"bangumi":[{"characterId":"11706","match":"exact-normalized-name-in-linked-work","subjectId":"994"}],"egsCharacterIds":["17951"],"vndbCharacterId":"c13889"},"originalCharacterName":"坂上 陽子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student, Youko is Sakaue Tsukuyo' s older twin sister and the vice-chair of the Shrine Maiden Committee. Her personality is the exact opposite of her sister's, forceful and outgoing. Has strong beliefs and is willing to use others to achieve her goals. It was Youko who proposed the formation of the Shrine Maiden Committee, and her drive that made it possible. While Tsukuyo remains secluded in the commitee's shrine, Youko works tirelessly to expand the committee's influence over the student body - though to what purpose, no one knows."},{"spoiler":false,"text":"“ Pathetic."},{"spoiler":false,"text":"You should drop out before you embarrass yourself. ”"},{"spoiler":false,"text":"from jast website"}],"source":"vndb","sourceCharacterId":"c13889"},{"segments":[{"spoiler":false,"text":"神撫学園2年生。巫女委員会副委員長。【第3回戦対立候補】"},{"spoiler":false,"text":"月夜の双子の姉。まさに月と太陽ほど性格が対照的。"},{"spoiler":false,"text":"社交的で弁がたち、頻繁に星徒たちと会合を開いている。"},{"spoiler":false,"text":"着々と人脈と勢力を拡大中だが、その目的を知るものはいない。"},{"spoiler":false,"text":"「笑えない冗談ね。恥をかかないうちに棄権したら？」"}],"source":"egs","sourceCharacterId":"17951","sourceWorkId":"10991","spoiler":false},{"segments":[{"spoiler":false,"text":"神抚学园二年级学生。巫女委员会副委员长。"},{"spoiler":false,"text":"虽然是月夜的双胞胎姐姐，但性格却与妹妹完全相反，积极地进行发言，与许多星徒交上了朋友。"},{"spoiler":false,"text":"拥有着坚定的信念，为了守护自己的信念不惜利用他人，性格极端利己主义。"},{"spoiler":false,"text":"是提议设立巫女委员会的始作俑者，巫女委员会能够真正建立似乎也是拜她的积极活动所赐。"},{"spoiler":false,"text":"在月夜蹲在特别栋不出来的同时，陽子却频繁地集合星徒举办会议，稳步地扩展着势力。"},{"spoiler":false,"text":"然而关于她的真正目的，则无人知晓。"}],"source":"bangumi","sourceCharacterId":"11706"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43d41b90952b6e4c89ff5b9f34be4124e4cd4efe0c857338a15f455efd43470b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f7b04d5311b8053ef9ca2ac95adfee46fc16f6988e0998eaaed70c7722d8226.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10117:11706:4956:1","source":"bangumi"}]},{"characterId":"char_c13890","characterName":"坂上 月夜","sourceIds":{"bangumi":[{"characterId":"11705","match":"exact-normalized-name-in-linked-work","subjectId":"994"}],"egsCharacterIds":["17950"],"vndbCharacterId":"c13890"},"originalCharacterName":"坂上 月夜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student at Jinbu Academy, Tsukuyo is the quiet and mysterious chairwoman of the Shrine Maiden Committee. Wears traditional shrine maiden clothing instead of the standard issue academy uniform. The Shrine Maiden Committee is a newly-formed organization that administers all events of religious significance inside the academy, and Tsukuyo became its first chairwoman when she was only in her first year. She is rarely seen out in public, instead spending most of her time in the committee's shrine. Has many zealous worshippers even outside the committee. They claim to be drawn to some mystical power she is said to possess."},{"spoiler":false,"text":"“ I love to watch the sun set. It's always... So beautiful. ”"},{"spoiler":false,"text":"from jast website"}],"source":"vndb","sourceCharacterId":"c13890"},{"segments":[{"spoiler":false,"text":"神撫学園2年生。巫女委員会委員長。【第3回戦対立候補】"},{"spoiler":false,"text":"学内の主だった行事を執り仕切る常任委員会の初代委員長。"},{"spoiler":false,"text":"学内特別棟に篭り、巫女服で生活している。"},{"spoiler":false,"text":"神秘的な雰囲気と、不思議な力で、星徒に多数の信者がいる。"},{"spoiler":false,"text":"「夕日がきれいですね……本当に、いい景色です」"}],"source":"egs","sourceCharacterId":"17950","sourceWorkId":"10991","spoiler":false},{"segments":[{"spoiler":false,"text":"神抚学园二年级学生。巫女委员会委员长。"},{"spoiler":false,"text":"洋溢着神秘氛围的文静少女。"},{"spoiler":false,"text":"不是穿着学园制服，而是穿着自办的巫女服生活着。"},{"spoiler":false,"text":"巫女委员会是为了主持学院内活动以外的活动而在去年新设的常任委员会。月夜以一年级学生的身份就任了初代委员长。"},{"spoiler":false,"text":"但是她很少会进行一些显眼的活动，基本上都蹲在学园用地的巫女委员会特别栋里不出来。"},{"spoiler":false,"text":"拥有不可思议的力量，被她的神秘性所吸引，巫女委员会以外的众多星徒似乎也成为了她的信徒。"}],"source":"bangumi","sourceCharacterId":"11705"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/194d6541748c1dc59899a601f3c469c10c4624c50d648c8a7aacc08f3a28a8a2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b59ac0ad7f4176c93da0c84a7309aec3ed7c4c8a94d845676513b1cdecbbc4e9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阪田佳代","creatorId":"vndb:s650","sourcePersonId":"vndb:s650","canonicalEntityId":"vndb:s650","name":"鮎川ひなた","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10117:11705:5133:1","source":"bangumi"}]},{"characterId":"char_c13891","characterName":"神楽 那由他","sourceIds":{"bangumi":[{"characterId":"11707","match":"exact-normalized-name-in-linked-work","subjectId":"994"}],"egsCharacterIds":["17952"],"vndbCharacterId":"c13891"},"originalCharacterName":"神楽 那由他","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The current student council president, Nayuta practically embodies the word \"extraordinary\", far outstripping the rest of the student body in both beauty and brains. Her regal, some would say imperious demeanor seems only natural coming from someone so gifted. This high-handedness has earned her the passionate support of those with certain... specialized tastes. She declared an Election War and brought down the previous Student Council President when she was still only in her first year. Ever since, she has reigned unchallenged. The quintessential autocrat, she believes that the masses cannot be trusted with freedom and must be ruled by the firm hand of a capable leader."},{"spoiler":false,"text":"“ Your uniform is quite untidy. Didn't I warn you about this last week? ”"},{"spoiler":false,"text":"from jast website"}],"source":"vndb","sourceCharacterId":"c13891"},{"segments":[{"spoiler":false,"text":"神撫学園3年生。現星徒会長。"},{"spoiler":false,"text":"容姿端麗、成績優秀、なにもかもがパーフェクトな人物。"},{"spoiler":false,"text":"3年前に「星徒会大戦」を開催し、勝利。"},{"spoiler":false,"text":"現在まで地位を堅持し続けている。"},{"spoiler":false,"text":"愚民は優れた為政者に統制される必要があると考えている。"},{"spoiler":false,"text":"「あなた、服装が乱れていますわよ。先週も注意したはずですけど"}],"source":"egs","sourceCharacterId":"17952","sourceWorkId":"10991","spoiler":false},{"segments":[{"spoiler":false,"text":"神抚学园三年级学生。现星徒会长。"},{"spoiler":false,"text":"拥有学园首屈一指的美丽容貌与优秀成绩，仿佛正是那体现了何谓才色兼备的完美人类。"},{"spoiler":false,"text":"大小姐一般的性格也因为她是她而被认同，特别在一部分的星徒中受到了狂热的支持。"},{"spoiler":false,"text":"进入学园之后不久就向当时的星徒会揭起反旗，举办了星徒会大战。"},{"spoiler":false,"text":"那由他在其役中取得优胜，从那以来一直作为会长君临着学园的顶点。"},{"spoiler":false,"text":"不给愚民们自由，而由优秀的执政者来支配他们的体制才是正确的。这就是她的持论。"}],"source":"bangumi","sourceCharacterId":"11707"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0d0b7c1f944a9bbdcfc5ac050b12fb4f7a1ca10df32d236ef79be15fc41613e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9cb105e2ab577d436a0b98f044ca20b8970600bbcfeeca6c3734e5f3546a4a7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤静","creatorId":"vndb:s516","sourcePersonId":"vndb:s516","canonicalEntityId":"vndb:s516","name":"伊藤 静","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10117:11707:4272:1","source":"bangumi"}]},{"characterId":"char_c13898","characterName":"観月 直人","sourceIds":{"bangumi":[{"characterId":"11708","match":"exact-normalized-name-in-linked-work","subjectId":"994"}],"egsCharacterIds":["17947"],"vndbCharacterId":"c13898"},"originalCharacterName":"観月 直人","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ayumu's classmate."}],"source":"vndb","sourceCharacterId":"c13898"},{"segments":[{"spoiler":false,"text":"神撫学園2年生。2-Cクラス・論説部。歩武のクラスメイト。"},{"spoiler":false,"text":"成績優秀、品行方正な男の子。"},{"spoiler":false,"text":"歩武が転校してきてすぐ友達となる。"},{"spoiler":false,"text":"弓那の勉強をサポートして、進級に大きく貢献した。"},{"spoiler":false,"text":"“緋ノ宮 灯”と親しくしても大丈夫な唯一の男の子。"},{"spoiler":false,"text":"灯とは世にも珍しい男女の友情で結ばれている。"},{"spoiler":false,"text":"「ほら、そんなこと言わないで。僕と朱島くんの仲じゃない」"}],"source":"egs","sourceCharacterId":"17947","sourceWorkId":"10991","spoiler":false},{"segments":[{"spoiler":false,"text":"神抚学园二年级学生。歩武他们的同学。"},{"spoiler":false,"text":"歩武转校之后最先交好的人物。胸襟豁达性格稳重待人温和的少年。"},{"spoiler":false,"text":"成绩也很优秀，说弓那能够升到二年级的理由有四成是托他教导的福也不为过。"},{"spoiler":false,"text":"与友人灯之间的友情超越了性别。"},{"spoiler":false,"text":"虽然一时之间曾被她的哥哥列入黑名单，但凭借着天生的机灵与处世术脱离了危机。目前似乎是唯一一个与灯独处也能被原谅的男子星徒，与灯保持着交友关系。"}],"source":"bangumi","sourceCharacterId":"11708"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d52d5fbc754a97baefa1d45a47b466a85dcd540f04ff4931f6ff4e04336c082.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25a7976bdf5a53ba37b4f192fb090a4058af5f2397b6543b0833ba62c028af61.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平田宏美","creatorId":"vndb:s1058","sourcePersonId":"vndb:s1058","canonicalEntityId":"vndb:s1058","name":"平田 宏美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10117:11708:5439:1","source":"bangumi"}]},{"characterId":"char_vndb_c13904","characterName":"ベリダディア＝エフェメラントソード","sourceIds":{"vndbCharacterId":"c13904"},"originalCharacterName":"ベリダディア＝エフェメラントソード","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A resident of Tilscied, the virtual reality world and training simulation into which Kirara sends Yumina and friends. Veridadia is a royal knight of Midorstan whose honest and likable personality quickly endears her to the Debate Club crew. She does, however, have a tendency towards self-effacement, believing herself to be immature and inexperienced. Her sword is larger than she is, but because it is part of her, she wields it easily."}],"source":"vndb","sourceCharacterId":"c13904"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/792b4e4528c877ba1e1d5c96c7db17b2e9ec30aa9bba2c4f4a5663f380b08593.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16fb2b7f745434c847e8b0f973b7914fb9e62b5000768b5853ca5c49885c900e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"姫川 あいり","creatorId":"vndb:s925","sourcePersonId":"vndb:s925","canonicalEntityId":"vndb:s925","name":"峰岸 由香里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20875","source":"vndb"}]},{"characterId":"char_vndb_c13932","characterName":"睦越 八枝美","sourceIds":{"vndbCharacterId":"c13932"},"originalCharacterName":"睦越 八枝美","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The cute and lively girl who runs the school store, which buys and sells everything from stationery and uniforms to weapons, armor, and"},{"spoiler":false,"text":"otherworldly grimoires."},{"spoiler":false,"text":"“There’s nothing money can’t buy!” is her motto, but she remains unable to acquire true love."}],"source":"vndb","sourceCharacterId":"c13932"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bfa5ab4f90331cd2c2b4248094a3741079d48d0e6e2638c8f24e529c87b338b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b23d8caf14dc3bd063e88348e84c38029013db6d937c7f0bb0f5658f862f0ad3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天野 かなで","creatorId":"vndb:s2428","sourcePersonId":"vndb:s2428","canonicalEntityId":"vndb:s2428","name":"天野かなで","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20879","source":"vndb"}]},{"characterId":"char_vndb_c34331","characterName":"リリーティア・ラングレイ","sourceIds":{"vndbCharacterId":"c34331"},"originalCharacterName":"リリーティア・ラングレイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b1884217e5df81c8af12a45f3158a25341ca7a652c9afc98f5f8eba25493f46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a2b4287293aff04b62e2f48c78200860a806f7f8fb142d7ac83a6530bc3377f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"塔月 芽衣","creatorId":"vndb:s1648","sourcePersonId":"vndb:s1648","canonicalEntityId":"vndb:s1648","name":"中村 繪里子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20880","source":"vndb"}]},{"characterId":"char_vndb_c36538","characterName":"ユプシラ＝ダナ＝ミドルスタン","sourceIds":{"vndbCharacterId":"c36538"},"originalCharacterName":"ユプシラ＝ダナ＝ミドルス