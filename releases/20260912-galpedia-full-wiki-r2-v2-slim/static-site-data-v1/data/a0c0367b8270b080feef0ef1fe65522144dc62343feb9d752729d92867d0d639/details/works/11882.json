。"},{"spoiler":false,"text":"金髪で、男好きするボッキュッボンのナイスバディ。"},{"spoiler":false,"text":"性格は傲慢で高飛車。また全て自分の思い通りになると信じて疑わない。"},{"spoiler":false,"text":"アドバイスをしたがるが、そのほとんどが的外れで役に立たない。"},{"spoiler":false,"text":"しかしアドバイス通り動いて失敗しても、それは相手の行動に問題があったと開き直る。"}],"source":"egs","sourceCharacterId":"15947","sourceWorkId":"11882","spoiler":false},{"segments":[{"spoiler":false,"text":"FPIの捜査官で、教師として主人公の学園に潜入する。"},{"spoiler":false,"text":"その口調をはじめ、金髪にボディコンといった外見からもお色気モード全開なお姉さん。"},{"spoiler":false,"text":"エッチが大好きで、今回の任務はヤル気満々。色々と変な性癖の持ち主。"},{"spoiler":false,"text":"ハンナとは姉妹という設定にしている。"},{"spoiler":false,"text":"「あら、あなたが例の…。ふふっ、思ったより可愛い子ね」"}],"source":"bangumi","sourceCharacterId":"204658"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"15947","sourceWorkId":"11882","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"15947","sourceWorkId":"11882","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"171 cm","valueContext":null,"source":"egs","sourceCharacterId":"15947","sourceWorkId":"11882","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"15947","sourceWorkId":"11882","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"15947","sourceWorkId":"11882","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39fa54d07ed88f5b5b7c08a449892f5b88953c09f3ce65aae74e98281bb6f129.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a80b0ff8f516d58c4c60f35ebdd44217591318276dbfc2843c7b7170ce91fe27.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"秋葉モモ代","creatorId":"vndb:s2288","sourcePersonId":"vndb:s2288","canonicalEntityId":"vndb:s2288","name":"秋葉 モモ代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:50347:204658:32278:1","source":"bangumi"}]},{"characterId":"char_c29478","characterName":"ハンナ・スミス","sourceIds":{"bangumi":[{"characterId":"204659","match":"exact-normalized-name-in-linked-work","subjectId":"50347"}],"egsCharacterIds":["15948"],"vndbCharacterId":"c29478"},"originalCharacterName":"ハンナ・スミス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"舞子と今回の任務でチームを組む女性潜入捜査官。"},{"spoiler":false,"text":"彼女もまた舞子と同じく転校生という設定で、主人公の学校に編入してきた。"},{"spoiler":false,"text":"ジョディは姉で、姉妹という設定になっている。"},{"spoiler":false,"text":"何処かの国のお金持ちの娘で、ひどく甘やかされて育った。故に傍若無人なところがある。"},{"spoiler":false,"text":"学園では薄幸の美少女を演じ、それに騙されて近付く男子を手玉に取って楽しんでいる。"},{"spoiler":false,"text":"また誰かが困っている姿を見るのも大好き。"}],"source":"egs","sourceCharacterId":"15948","sourceWorkId":"11882","spoiler":false},{"segments":[{"spoiler":false,"text":"好奇心が旺盛で、なんでも試してみたいタイプ。"},{"spoiler":false,"text":"だが、そのせいで妙な失敗をすることも少なくない。"},{"spoiler":false,"text":"コスプレ好きが高じて今回の担当に就くが、たまにジョディの妹という設定を忘れてしまう。"},{"spoiler":false,"text":"口調は能天気で無礼な雰囲気。胸がないのをそれなりに気にしている。"},{"spoiler":false,"text":"「はじめまして～！　へぇ～、君がそうなんだ？　あははっ、ドジだよね～！」"}],"source":"bangumi","sourceCharacterId":"204659"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"15948","sourceWorkId":"11882","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"15948","sourceWorkId":"11882","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"15948","sourceWorkId":"11882","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"15948","sourceWorkId":"11882","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"15948","sourceWorkId":"11882","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc4b4049cc6443e1a9950f1caa87f943c6a9bc6083093c2dc2af6376cde7b95c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83680218b81759422459fb5f0bb7d2d591786870f67c9cb57299c4fdda8d8da7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"津軽 りんご","creatorId":"vndb:s2586","sourcePersonId":"vndb:s2586","canonicalEntityId":"vndb:s2586","name":"津軽 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12360","source":"vndb"}]},{"characterId":"char_c29480","characterName":"真野 もとか","sourceIds":{"bangumi":[{"characterId":"204660","match":"exact-normalized-name-in-linked-work","subjectId":"50347"}],"egsCharacterIds":["15949"],"vndbCharacterId":"c29480"},"originalCharacterName":"真野 もとか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と家族ぐるみの付き合いのある幼馴染にして、同級生。"},{"spoiler":false,"text":"曲がったことや筋の通らないことが大嫌いな純粋真っ直ぐな性格の女の子。"},{"spoiler":false,"text":"エッチな話には知ったかぶりな受け答えをしているが、全て本などからの知識でしかなく、基本耳年増。"},{"spoiler":false,"text":"学園ではクラスメイトや友達からも信頼されている。"},{"spoiler":false,"text":"主人公に対しては、好意を抱いているようだが、素直になれず素っ気ない態度を取っている。"}],"source":"egs","sourceCharacterId":"15949","sourceWorkId":"11882","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼なじみで、それ以上の気持ちを抱いている。"},{"spoiler":false,"text":"素直ではないので、主人公に対して つっけんどんな態度をとってしまう。"},{"spoiler":false,"text":"ただ、舞子たちが来てからは、彼女たちに対抗して前より積極的になった。"},{"spoiler":false,"text":"経験はなく耳年増。胸は大きめだが、ジョディより小さいのを悔しがっている。"},{"spoiler":false,"text":"「仕方ないわね、してあげる。…な、何よその顔！　仕方なくなのよ！　わかってるわね！」"}],"source":"bangumi","sourceCharacterId":"204660"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"15949","sourceWorkId":"11882","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"15949","sourceWorkId":"11882","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"15949","sourceWorkId":"11882","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"15949","sourceWorkId":"11882","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"15949","sourceWorkId":"11882","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/8820610e5900ae53d4bb42490f83a60565fc2d5d247d73fb1806c6b7d51ae71e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17fb366470cee98886d502631b25d8873cc6a08be26d3b3dbd62b65dbe1d2cac.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桃華れん","creatorId":"vndb:s2692","sourcePersonId":"vndb:s2692","canonical