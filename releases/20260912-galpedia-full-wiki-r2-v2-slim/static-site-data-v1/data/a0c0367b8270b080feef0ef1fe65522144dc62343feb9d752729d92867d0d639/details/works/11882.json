 あんず","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:23974","source":"vndb"}]},"cast":[{"characterId":"char_c29476","characterName":"柚木 舞子","sourceIds":{"bangumi":[{"characterId":"204657","match":"exact-normalized-name-in-linked-work","subjectId":"50347"}],"egsCharacterIds":["15946"],"vndbCharacterId":"c29476"},"originalCharacterName":"柚木 舞子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ウィルス感染した主人公を見張る任務のために派遣されたFPI女性捜査官。"},{"spoiler":false,"text":"帰国子女という設定で、主人公の学校に編入してきた。"},{"spoiler":false,"text":"容姿端麗、学業優秀、運動神経抜群なことから、転校初日から学園のアイドル的な存在になる。"},{"spoiler":false,"text":"規律に厳しく融通の利かない性格だが、普段は温厚で優しい。"},{"spoiler":false,"text":"しかし、怒らせるとかなりヤバイらしく、今回、チームを組んでいるジョディらからも恐れられている。"}],"source":"egs","sourceCharacterId":"15946","sourceWorkId":"11882","spoiler":false},{"segments":[{"spoiler":false,"text":"FPIの捜査官。帰国子女という設定で偽名を名乗っている。"},{"spoiler":false,"text":"今回の任務は乗り気ではないが、生真面目な性格なので職務は果たそうとする。"},{"spoiler":false,"text":"ただ、処女なのでエッチについての知識は希薄。時にずれた言動を主人公から突っ込まれている。"},{"spoiler":false,"text":"丁寧な口調のため、少々堅苦しい雰囲気も。"},{"spoiler":false,"text":"「任務だから仕方なく、です。誤解しないで下さい」"}],"source":"bangumi","sourceCharacterId":"204657"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"15946","sourceWorkId":"11882","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"15946","sourceWorkId":"11882","sourceField":null,"scoped":true},{"label":"身高（本版本）","value"