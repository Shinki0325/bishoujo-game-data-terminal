:"source-only","source":"vndb","value":"76"},"height":{"reviewState":"source-only","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chisa Tsukamoto is the daughter of the printing shop where Kazuki gets his doujinshi printed and a junior student at Kazuki's school. She is hardworking and looks after the business when her parents go out of town, but she is clumsy and scatterbrained and sometimes makes mistakes with the printing process. She is often seen chasing a runaway cart."},{"spoiler":false,"text":"From AniDB"}],"source":"vndb","sourceCharacterId":"c8642"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5dfc4dd5bdf67cc3592fa69fc28ef3fcb3a5767c98b5c82b16a2b19e0d89cf11.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3eda6866ee64896359cf6e6447af70bb079dd37459fc3f748364213f7c04d3fb.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"馬場 澄江","creatorId":"vndb:s12739","sourcePersonId":"vndb:s12739","canonicalEntityId":"vndb:s12739","name":"馬場 澄江","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35454","source":"vndb"}]},{"characterId":"char_vndb_c8643","characterName":"桜井 あさひ","sourceIds":{"vndbCharacterId":"c8643"},"originalCharacterName":"桜井 あさひ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"619"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"81"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Asahi Sakurai is anime and manga fan by day and a famous idol by night. She is the seiyuu of Card Master Peach, the main character of the popular anime in the Comic Party world (and a double parody, of Wedding Peach and Cardcaptor Sakura). Even though she is an idol, she is nervous around people so she often stutters and forgets what she was going to say. Asahi disguises herself with eyeglasses and a hat when she wants to enjoy the public without a crowd around her which quickly forms when her identity is revealed."},{"spoiler":false,"text":"From AniDB"}],"source":"vndb","sourceCharacterId":"c8643"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/5745b1d780a4fe835e33aa86a3fe35ae4dcc0327c1affcb65bd89b473d198a3e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbecc66ed039ae8c68c1f5bf9b6fa7ee78c5efcb701e7c86d17a47182b3bc675.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"こおろぎ さとみ","creatorId":"vndb:s802","sourcePersonId":"vndb:s802","canonicalEntityId":"vndb:s802","name":"こおろぎ さとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35447","source":"vndb"}]},{"characterId":"char_vndb_c8645","characterName":"千堂 和樹","sourceIds":{"vndbCharacterId":"c8645"},"originalCharacterName":"千堂 和樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this title. An indifferent college student, he has some talent as an artist and is persuaded to form the \"Brother 2\" doujinshi partnership with Taishi."},{"spoiler":false,"text":"From AniDB"}],"source":"vndb","sourceCharacterId":"c8645"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12055240e6442e58e796ea439a2c95d17eed75465cd7f948c0e82640e33b8917.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5f1156f532887119caf0ec090a7f3d27c48a6bb1dd03ff54a05ca9889229621.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c8646","characterName":"九品仏 大志","sourceIds":{"vndbCharacterId":"c8646"},"originalCharacterName":"九品仏 大志","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1225"},"height":{"reviewState":"source-only","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The other half of \"Brother 2\", he is a typical otaku who sees the doujinshi concept as the leading pop-culture format of the 21st century. Grandiose in the expressions of his dreams, he takes charge of the logistical aspects of the partnership (paying registration fees, arranging printers, etc.), leaving the actual artwork to Kazuki."},{"spoiler":false,"text":"From AniDB"}],"source":"vndb","sourceCharacterId":"c8646"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63ed3165cf71a1a810fb4767f68e4fcf185822cd62d7429f68ba904be40710f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e6dec1b4449113cfb56127ef8d8658f73a70eb1