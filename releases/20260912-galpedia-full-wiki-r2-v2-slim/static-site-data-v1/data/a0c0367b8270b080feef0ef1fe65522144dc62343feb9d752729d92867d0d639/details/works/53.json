7"},"birthday":{"reviewState":"source-only","source":"vndb","value":"612"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aya Hasebe is a timid girl who draws original doujinshi. She usually gets Kazuki's attention by pulling on his shirt rather than calling out to him. Aya's circle is called \"Jamming Book Store\". Her doujinshi doesn't sell well because she has a hard time attracting customers even though it has good artwork and costs only 200 yen. Kazuki admires her artwork and creative story so he tries to help her sell whenever he can."},{"spoiler":false,"text":"From AniDB"}],"source":"vndb","sourceCharacterId":"c8640"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67bc13881557d9b22cda62b7943b43fc9bda088b13eba34070102e65cbfd691d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a806d5e13a2ce558aa3f3b1ed57929af352c9aacec2c9f1a43499bea3b6b5e17.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"園崎 未恵","creatorId":"vndb:s677","sourcePersonId":"vndb:s677","canonicalEntityId":"vndb:s677","name":"園崎 未恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35444","source":"vndb"}]},{"characterId":"char_vndb_c8641","characterName":"芳賀 玲子","sourceIds":{"vndbCharacterId":"c8641"},"originalCharacterName":"芳賀 玲子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"revi