{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"1020","model":{"presentationWorkId":"vndb:v137","staff":{"artwork":[{"creditedName":"志水直隆(志水なおたか)","creatorId":"vndb:s2213","sourcePersonId":"egs:creator:71","canonicalEntityId":"vndb:s2213","name":"志水直隆(志水なおたか)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:377","source":"egs"}],"scenario":[{"creditedName":"シナリオ制作チームさるさる","creatorId":"egs:creator:5656","sourcePersonId":"egs:creator:5656","canonicalEntityId":"egs:creator:5656","name":"シナリオ制作チームさるさる","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:272869","source":"egs"},{"creditedName":"猫屋惣右衛門","creatorId":"vndb:s3263","sourcePersonId":"egs:creator:416","canonicalEntityId":"vndb:s3263","name":"猫屋惣右衛門","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:378","source":"egs"}],"music":[{"creditedName":"黄昏の夢","creatorId":"vndb:s2259","sourcePersonId":"egs:creator:4319","canonicalEntityId":"vndb:s2259","name":"黄昏の夢","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:15957","source":"egs"},{"creditedName":"マツ","creatorId":"vndb:s1109","sourcePersonId":"vndb:s1109","canonicalEntityId":"vndb:s1109","name":"まつ","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:4478","source":"vndb"}],"other":[{"creditedName":"志水 直隆","creatorId":"vndb:s2213","sourcePersonId":"vndb:s2213","canonicalEntityId":"vndb:s2213","name":"志水 なおたか","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:4472","source":"vndb"},{"creditedName":"うしゃぎ 雪","creatorId":"vndb:s2292","sourcePersonId":"vndb:s2292","canonicalEntityId":"vndb:s2292","name":"うしゃぎ 雪","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:4475","source":"vndb"},{"creditedName":"齋藤 紀子","creatorId":"vndb:s2345","sourcePersonId":"vndb:s2345","canonicalEntityId":"vndb:s2345","name":"齋藤 紀子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:4476","source":"vndb"},{"creditedName":"さばみそ亭","creatorId":"vndb:s19125","sourcePersonId":"vndb:s19125","canonicalEntityId":"vndb:s19125","name":"身から出た鯖","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:4479","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c42426","characterName":"舞岡 紅葉","sourceIds":{"vndbCharacterId":"c42426"},"originalCharacterName":"舞岡 紅葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Momiji is a student at Saint Michael's Nursing School and Kaede's only blood-related child. She wants to be a great nurse just like her mother, but her greatest dream revolves around her older brother, Shinobu. She's always had strong feelings for her foster brother, but he has a hard time thinking about her as anything more than a little sister, especially since she can act like a spoiled little girl. Their relationship might become a romantic one depending on whether Momiji manages to win over his heart."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c42426"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c8af0c5cc07e3f99ae4c7aa6d343ee36b44215a826e485a2beb055238e14c08.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/401eae40deac086c26894cc4b9ec806f1d29b0299481e7b60af7d43268bc6a25.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"内村 みるく","creatorId":"vndb:s1015","sourcePersonId":"vndb:s1015","canonicalEntityId":"vndb:s1015","name":"池田 千草","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1455","source":"vndb"}]},{"characterId":"char_vndb_c42427","characterName":"睦月 知沙","sourceIds":{"vndbCharacterId":"c42427"},"originalCharacterName":"睦月 知沙","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chisa is a class president of Momiji's and Nanana's class. Her parents run a hospital, and that is why she too wants to become a great nurse one day. She works very hard not just to develop her own skills, but to also keep the entire class in line to accomplish their shared goal. However, serving as the shining example has left Chisa isolated and lonely. She has been attending all-girls schools all these years, and she has never had a boyfriend before hence why she desires to fall in love this year. Her new substitute teacher, Nakagawa Shinobu, just might prove out to be the perfect kind of guy that she was looking for."},{"spoiler":false,"text":"Edited from JAST USA and Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c42427"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f245e9e24efb205cc0a769bc41f54b7fcc02c22d1882c3237196a2a294be0f7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b89821f9279abde2b38387d4e67baea2fbf16809d31b5f19f869dc6ec433ca77.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結城 みづほ","creatorId":"vndb:s2068","sourcePersonId":"vndb:s2068","canonicalEntityId":"vndb:s2068","name":"武政 弘子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1459","source":"vndb"}]},{"characterId":"char_vndb_c42428","characterName":"吉野 奈々菜","sourceIds":{"vndbCharacterId":"c42428"},"originalCharacterName":"吉野 奈々菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nanana is also a student at Saint Michael's Nursing School, and she is Momiji's best friend. She went through a troublesome childhood, but she is now healthy and energetic. A nurse took good care of her when she was a child. Therefore, she wants to become a good nurse herself. As Momiji's confidante, Nanana knows just how much Shinobu really means to her. Even though she sometimes likes to tease her more simple-minded friend, Nanana's too considerate and sweet to admit her own feelings for the doctor."},{"spoiler":false,"text":"Edited from JAST USA and Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c42428"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08c851c5114d2a42065d8425ea25ed32cf0d365a9637b3886ea438f7d67c38f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a3e44bd518eff3843353107bb3078640234bc3d2ad962646262515ab4057894.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"芹澤 綾","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1456","source":"vndb"}]},{"characterId":"char_vndb_c42429","characterName":"片倉 詠美","sourceIds":{"vndbCharacterId":"c42429"},"originalCharacterName":"片倉 詠美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Eimi is a young nun and teacher that works alongside Shinobu at Saint Michael's Nursing School. She has a gentle and cheerful kind of personality. All students trust her, but she's not exactly a traditional nun. Let's just say that her love may not be exclusive only to God."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c42429"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/670f15b87ca5e019c8816e98dd9382bf0884b84a609949ee78d43cb9667652bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83c1b69126baf596dea84079c2032fc4614dbf76e197cb8baec4c7e16d1b8a0f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日 ほのか","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1457","source":"vndb"}]},{"characterId":"char_vndb_c42430","characterName":"舞岡 楓","sourceIds":{"vndbCharacterId":"c42430"},"originalCharacterName":"舞岡 楓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kaede is Momiji's mother and Shinobu's foster mother. She used to be an experienced nurse at Saint Michael's General Hospital, but since last year, she started working as a teacher at Saint Michael's Nursing School instead. Kaede still looks very young and has a very glamorous body. On top of it, she is also aggressive in her sexual pursuits and has very good techniques in bed. She has a certain hold on Shinobu, not only because she raised him, but also because she was his first love! Of course, he was just a child and she rebuffed him back then, but now that he's older and she's just as attractive, who knows what could happen? She might even seduce him herself!"},{"spoiler":false,"text":"Edited from JAST USA and Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c42430"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47d30d1fb6a65e07f3b1f3521b33dfe75a47515ffc782fe72dd3fb10c803e1fb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86d01eb40a77cf02fa35dc0ec98c65f0735ffde1714a4b57068469245a8763f3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真姫 澪香","creatorId":"vndb:s2067","sourcePersonId":"vndb:s2067","canonicalEntityId":"vndb:s2067","name":"真姫 澪香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1458","source":"vndb"}]},{"characterId":"char_vndb_c63887","characterName":"中川 忍","sourceIds":{"vndbCharacterId":"c63887"},"originalCharacterName":"中川 忍","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nakagawa Shinobu finally made it. Overcoming the early death of his parents, he kept his heart on his goal of becoming a great doctor. Now he's right where he wants to be; working as a pediatrician in a hospital, helping kids overcome illness, and surrounded by pretty nurses. When he gets a call to give all that up, you would think his response would be a resounding no. But how do you turn down a request from the woman who raised you?"},{"spoiler":false,"text":"So Shinobu finds himself transferred to a nursing school. While there may not be patients to heal, the job does come with an abundance of pretty nurses... well, student nurses. And quite a few of the women he meets develop, or already possess, a grand crush on the young physician. How well will he be able to juggle romance and a demanding new job?"},{"spoiler":false,"text":"Okay, Shinobu's not a saint. He likes the ladies and has no problem sneaking a little peek if the opportunity presents itself. But he's also a good teacher, and he really cares about how his students perform, even if he is a little easy on them."},{"spoiler":false,"text":"From Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c63887"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8f766374477890cb6f7469996565bc6b451dd431e3e6a27c6b30dbbf8b03944.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74b495cfef7b5d14e096804e829637a3b439193e3a717bfa1d611a95132bf327.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p89","sourceCompanyId":"egs:brand:210","canonicalEntityId":"vndb:p89","name":"トラヴュランス","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:1020:210","source":"egs"},{"companyId":"vndb:p89","sourceCompanyId":"vndb:p89","canonicalEntityId":"vndb:p89","name":"トラヴュランス","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:14959:v137","source":"vndb"},{"companyId":"vndb:p1899","sourceCompanyId":"vndb:p1899","canonicalEntityId":"vndb:p1899","name":"株式会社コンテンツトラフィック","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:14960:v137","source":"vndb"},{"companyId":"vndb:p89","sourceCompanyId":"vndb:p89","canonicalEntityId":"vndb:p89","name":"トラヴュランス","roleCodes":["developer","publisher"],"identityStatus":"sour