firmed","relationId":"egs:work-creator:69940","source":"egs"},{"creditedName":"Chai*","creatorId":"vndb:s5757","sourcePersonId":"egs:creator:13054","canonicalEntityId":"vndb:s5757","name":"Chai*","detail":"ED曲 「想歌」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:69942","source":"egs"},{"creditedName":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","creatorId":"vndb:s592","sourcePersonId":"egs:creator:13068","canonicalEntityId":"vndb:s592","name":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","detail":"デモムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:74091","source":"egs"},{"creditedName":"黒崎 朔夜","creatorId":"vndb:s5137","sourcePersonId":"vndb:s5137","canonicalEntityId":"vndb:s5137","name":"黒崎 朔夜","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:19168","source":"vndb"},{"creditedName":"Chai","creatorId":"vndb:s5757","sourcePersonId":"vndb:s5757","canonicalEntityId":"vndb:s5757","name":"Chai","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:19169","source":"vndb"},{"creditedName":"け～まる","creatorId":"vndb:s6704","sourcePersonId":"vndb:s6704","canonicalEntityId":"vndb:s6704","name":"け～まる","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:19171","source":"vndb"},{"creditedName":"け～まる","creatorId":"vndb:s6704","sourcePersonId":"vndb:s6704","canonicalEntityId":"vndb:s6704","name":"け～まる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:19172","source":"vndb"},{"creditedName":"re-in.Carnation∞YURIA","creatorId":"vndb:s8834","sourcePersonId":"vndb:s8834","canonicalEntityId":"vndb:s8834","name":"re-in.Carnation∞YURIA","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:19173","source":"vndb"}]},"cast":[{"characterId":"char_c37607","characterName":"矢代 陣馬","sourceIds":{"bangumi":[{"characterId":"60302","match":"exact-normalized-name-in-linked-work","subjectId":"60192"}],"egsCharacterIds":["19691"],"vndbCharacterId":"c37607"},"originalCharacterName":"矢代 陣馬","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":">"},{"spoiler":false,"text":"本作の主人公で、武芸・兵法全般に長けた上忍。"},{"spoiler":false,"text":"「霞谷」壊滅後、東間国の姫君・紗代姫の下で「山吹組」を再編。"},{"spoiler":false,"text":"生き残った忍びたちの組頭を務める。"},{"spoiler":false,"text":"忍びの冷酷さと人の優しさを併せ持った好青年。"},{"spoiler":false,"text":"「…試してみろ。その刃が俺を捕らえる前に、貴様の命は無い」"}],"source":"egs","sourceCharacterId":"19691","sourceWorkId":"9575","spoiler":false},{"segments":[{"spoiler":false,"text":"本編の主人公。忍びの里『霞谷』で生まれ育ち、武芸・学識全般に長けた上忍。"},{"spoiler":false,"text":"敵に里を焼かれ「霞谷」が壊滅した後、東間国の君主である紗代姫の下、生き残った忍びたちを 『山吹組』として再編し、その組頭を務める。人の優しさと忍びの冷酷さを併せ持つ好漢。"}],"source":"bangumi","sourceCharacterId":"60302"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd15b2dc78bcd101577877970e39a70afae77c7511df5202d6ae4d9bc58e699c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a4ef24bf623766f47d6656b9ad3ad107289a5a746ac8875dbc45e5fddb66165.webp","width":256,"height":127,"source":"static-detail"},"actors":[]},{"characterId":"char_c37608","characterName":"室鷲 那爪","sourceIds":{"bangumi":[{"characterId":"60303","match":"exact-normalized-name-in-linked-work","subjectId":"60192"}],"egsCharacterIds":["19692"],"vndbCharacterId":"c37608"},"originalCharacterName":"室鷲 那爪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":">"},{"spoiler":false,"text":"父の命によって、陣馬の許婚となったくノ一。"},{"spoiler":false,"text":"負けん気が強く、男っぽい口調や態度を見せるが、その奥では、女性らしい気遣いや優しさを持っている。"},{"spoiler":false,"text":"得意技は、鉄をも両断する鋼糸を操る「殺弦術」。"},{"spoiler":false,"text":"「大丈夫。あんたの背中は私が守る！　だから、絶対に振り返るな…！」"}],"source":"egs","sourceCharacterId":"19692","sourceWorkId":"9575","spoiler":false},{"segments":[{"spoiler":false,"text":"霞谷頭領の娘であり、生粋のくノ一。負けん気が強く、男っぽい口調や態度ながら、芯には女性らしい気遣いや優しさが垣間見える。父の命により陣馬の許婚となるが、那爪自身は忍び働きをまだ続けていたいという思いが強い。鉄をも両断する鋼糸を操る『殺弦術』を得意とする。"}],"source":"bangumi","sourceCharacterId":"60303"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24a7748fdf0655992172ad510636be8b10d945b777f004d963869612a838728d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d1d39f9b6bd739784d4a7f4db86c611c08a18dcbc335e4086a0cfa79919ae9c.webp","width":256,"height":128,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:60192:60303:4956:1","source":"bangumi"}]},{"characterId":"char_c37609","characterName":"望月 紗代","sourceIds":{"bangumi":[{"characterId":"60306","match":"exact-normalized-name-in-linked-work","subjectId":"60192"}],"egsCharacterIds":["19693"],"vndbCharacterId":"c37609"},"originalCharacterName":"望月 紗代","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":">"},{"spoiler":false,"text":"父である前主の急逝によって、東間国の当主となった姫君。"},{"spoiler":false,"text":"国を想い、優しくも毅然とした姿勢は、民衆から厚い支持を得ている。"},{"spoiler":false,"text":"霞谷の生き残りを集め「隠密山吹組」を組織し、隣国・芦屋の侵攻を阻止せんと奮闘する。"},{"spoiler":false,"text":"「戦いましょう。この命ある限り…。民を守る為に、芦屋に屈する訳には参りません」"}],"source":"egs","sourceCharacterId":"19693","sourceWorkId":"9575","spoiler":false},{"segments":[{"spoiler":false,"text":"陣馬が仕える東間国の姫君。前当主・望月秀光の急逝により、一人娘の紗代が家督を継ぐこととなった。壊滅した霞谷の生き残りを『隠密山吹組』として組織。隣国・芦屋の侵攻を防止するために、女の身でありながら国を背負って起つこととなる。国を想い、民からも慕われる、優しくも毅然とした姫君。"}],"source":"bangumi","sourceCharacterId":"60306"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/8618d36b55d97902e70b5a7e93a48dab1010ef97affe8103a3eb2fd02cad9512.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aacd5e1cf8c6334696485d5e24c71baa12d602367fc22475ea19d23292d7d330.webp","width":256,"height":127,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:60192:60306:5890:1","source":"bangumi"}]},{"characterId":"char_c37610","characterName":"水無月 夕凪","sourceIds":{"bangumi":[{"characterId":"60304","match":"exact-normalized-name-in-linked-work","subjectId":"60192"}],"egsCharacterIds":["19694"],"vndbCharacterId":"c37610"},"originalCharacterName":"水無月 夕凪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":">"},{"spoiler":false,"text":"高い実力を持つ、霞谷上忍衆の一人。"},{"spoiler":false,"text":"物腰柔らかな包容力のあるくノ一で、仲間内のお姉さん的存在。"},{"spoiler":false,"text":"得意技は水の幻惑術だが、薬術や房中術にも精通している。"},{"spoiler":false,"text":"陣馬の親に恩義があり、今では陣馬に忠実に仕えている。"},{"spoiler":false,"text":"「陣馬さま、速やかなご決断を。忍びとして、大局を見失ってはなりませぬ」"}],"source":"egs","sourceCharacterId":"19694","sourceWorkId":"9575","spoiler":false},{"segments":[{"spoiler":false,"text":"里でも屈指の実力を持つ霞谷上忍衆の１人。水の幻惑術を得意とし、薬術や房中術にも精通する。仲間の忍びに対しては姉のように振舞う、物腰柔らかな包容力のある女性。かつて陣馬の親に恩義があり、それゆえに、陣馬に忠実に仕えている。"}],"source":"bangumi","sourceCharacterId":"60304"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5baf947feb82d5c21cf81baeb6ed9b02ba1502e3a5c1ed71614954afb5c10cc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/9537a964b7ec823aca9690c49d84d74d163f85ec5aae2ff196229716fc817e2c.webp","width":256,"height":127,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:60192:60304:5741:1","source":"bangumi"}]},{"characterId":"char_c37611","characterName":"九鬼 朱火","sourceIds":{"bangumi":[{"characterId":"60305","match":"exact-normalized-name-in-linked-work","subjectId":"60192"}],"egsCharacterIds":["19695"],"vndbCharacterId":"c37611"},"originalCharacterName":"九鬼 朱火","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":">"},{"spoiler":false,"text":"「火縄銃」や「焙烙火矢」などの火気・火術に長けた中忍。"},{"spoiler":false,"text":"性格は明るく快活で、無邪気。"},{"spoiler":false,"text":"火縄銃の射撃術は抜群の才能を誇るが、身体が小さいため、力は弱い。"},{"spoiler":false,"text":"「あたしは、逃げない。目を逸らさない。絶対に、諦めたりしない…ッ!!」"}],"source":"egs","sourceCharacterId":"19695","sourceWorkId":"9575","spoiler":false},{"segments":[{"spoiler":false,"text":"若くして火縄銃や焙烙火矢などの火器・火術を扱う事に長け、中忍でも頭角を現していた少女。"},{"spoiler":false,"text":"火縄銃の射撃術は抜群の才能を誇るが、小柄な身体に比例して力は弱い。明るく快活で、歳相応の無邪気な性格。陣馬に懐いており、忍びの技の教えを受けていた。"}],"source":"bangumi","sourceCharacterId":"60305"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27b474a73f90f1737b7a9fd5a1fe20123118f536b9ad5dc5ec682dc17589f19c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d142a12c6b733198579bc988b800df08206aba28a6d1f56af6e44a447ab8a742.webp","width":256,"height":127,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:60192:60305:4830:1","source":"bangumi"}]},{"characterId":"char_c37612","characterName":"玉梓","sourceIds":{"bangumi":[],"egsCharacterIds":["19696","19702"],"vndbCharacterId":"c37612"},"originalCharacterName":"玉梓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":">"},{"spoiler":false,"text":"敵国の大将・芦屋の愛妾。"},{"spoiler":false,"text":"物腰柔らか、眉目秀麗な切れ者で、芦屋の寵愛を一身に受ける。"},{"spoiler":false,"text":"しかし、芦屋の元に現れたのは最近のことで、その過去は一切不明。"},{"spoiler":false,"text":"彼女の、妖艶な笑みの裏に隠されているものとは？"},{"spoiler":false,"text":"「妾は、玉梓と申します。女の身で、殿にいささかの寵を頂いている者にございます」"}],"source":"egs","sourceCharacterId":"19696","sourceWorkId":"9575","spoiler":false},{"segments":[{"spoiler":false,"text":">"},{"spoiler":false,"text":"慈悲深い聖女のような巫女風の外見とは裏腹に、邪悪な知恵と狡猾な房中術を会得している、最強の外法使い。"},{"spoiler":false,"text":"彼女の房中術は、骸すらも操ることが出来る。"},{"spoiler":false,"text":"自らの目的に対する執着は異様なほど強く、偏愛的。"},{"spoiler":false,"text":"「祝福します。妾の新たな眷属…。幽世の狭間にて、傀儡となりて舞うのです」"}],"source":"egs","sourceCharacterId":"19702","sourceWorkId":"9575","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7de5d75259816f4b60863dff7dbe6823944803aebf91e60d8e3ce27a580f7f9d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28d1238f4817c23bbca805a053a09930df98eadb6caaa48c699c4ba4db917f6b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深井 晴花","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"ももぞの薫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9471","source":"vndb"}]},{"characterId":"char_c37613","characterName":"深鷺","sourceIds":{"bangumi":[],"egsCharacterIds":["19697"],"vndbCharacterId":"c37613"},"originalCharacterName":"深鷺","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":">"},{"spoiler":false,"text":"貧しい猟師の父に捨てられ、山の中で生き延びた野生児。"},{"spoiler":false,"text":"その後、冥極党に拾われ、獣を使役する術を習得、冥極党最強の七人衆に、名を連ねるまでに成長する。"},{"spoiler":false,"text":"自分たち以外が皆、敵であると教え込まれ、残酷な任務も躊躇なくこなす。"},{"spoiler":false,"text":"「どこに逃げようとも、私の獣がお前を逃がさない。残されている選択は、死だけだ」"}],"source":"egs","sourceCharacterId":"19697","sourceWorkId":"9575","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9652d827aa13002e19f121897e6f9ff1abd1b0377d2cf2b3f217e01fe6764c8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc90e89acd6b387c3341567b8df58a5ab2d93417ad5a207a1a6d39453f497788.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"咲 ゆたか","creatorId":"vndb:s1595","sourcePersonId":"vndb:s1595","canonicalEntityId":"vndb:s1595","name":"坂田 有希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9478","source":"vndb"}]},{"characterId":"char_c40087","characterName":"刑部 破軍","sourceIds":{"bangumi":[],"egsCharacterIds":["19698"],"vndbCharacterId":"c40087"},"originalCharacterName":"刑部 破軍","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":">"},{"spoiler":false,"text":"「男は殺し、女は犯す」、悪党然とした巨漢男。"},{"spoiler":false,"text":"豪快かつ残虐な性格で、その豪腕を生かした戦闘力は脅威。"},{"spoiler":false,"text":"力任せの戦いを好むが、計略を使ったり、状況を分析する冷静さも持っている。"},{"spoiler":false,"text":"「足掻いてみろ。そして絶望しろ、てめぇが三百人いても、俺を殺すことはできねぇ」"}],"source":"egs","sourceCharacterId":"19698","sourceWorkId":"9575","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51f0486d887f7f4b89f6f1d63ce735ea79151ab229c4524967e5c48c0df090c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3ffbddade057ba8bda90dc8598a9ecfe42562d908442626672285109dadc56b4.webp","width":236,"height":256,"source":"static-detail"},"actors":[{"creditedName":"星 一人","creatorId":"vndb:s927","sourcePersonId":"vndb:s927","canonicalEntityId":"vndb:s927","name":"星一人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9475","source":"vndb"}]},{"characterId":"char_c40088","characterName":"業鬼","sourceIds":{"bangumi":[],"egsCharacterIds":["19699"],"vndbCharacterId":"c40088"},"originalCharacterName":"業鬼","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":">"},{"spoiler":false,"text":"異形な風体をした不気味な虚無僧。"},{"spoiler":false,"text":"身体の中に無数の「蟲」を飼っており、様々な局面で使役する。"},{"spoiler":false,"text":"その風貌どおり心根も醜く歪んでおり、他人が苦しむ様に、至上の悦びを感じる。"},{"spoiler":false,"text":"「ケヒャヒャ…どれ、搾り尽くしてくれようか。若いおなごの精は、何よりも糧じゃからのぅ？」"}],"source":"egs","sourceCharacterId":"19699","sourceWorkId":"9575","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf1c4df92ed11d20ac2a629edde2567679f16c700bc81710b2bafa5d7087b969.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a27bb047a3e54612cc21842a9d1f2f6edeb5b0e331af4ce6bd6f843039a65604.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"星 一人","creatorId":"vndb:s927","sourcePersonId":"vndb:s927","canonicalEntityId":"vndb:s927","name":"星一人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9476","source":"vndb"}]},{"characterId":"char_c40089","characterName":"弥勒 影斎","sourceIds":{"bangumi":[],"egsCharacterIds":["19700"],"vndbCharacterId":"c40089"},"originalCharacterName":"弥勒 影斎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":">"},{"spoiler":false,"text":"伝説的な忍びの名を受け継いだ若いくノ一。"},{"spoiler":false,"text":"戦いを望み、冥極党に身をおく彼女は、闇から闇へと、数多の命を葬りさってきた。"},{"spoiler":false,"text":"その影に沈みこむ姿は、黒い死神そのもの。"},{"spoiler":false,"text":"「─はン、この程度か？　期待外れも甚だしい。もういい、影に呑まれて……死にな！」"}],"source":"egs","sourceCharacterId":"19700","sourceWorkId":"9575","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/7605549abf684946c9768c8aea12d1099cdbdade6316be40060539be6e15536a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/633ee2d13bfc57b7e91da07b579f84cdaac0927349e6a69b1d999a8e8ec03a10.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平野 響子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"藤本 教子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"so