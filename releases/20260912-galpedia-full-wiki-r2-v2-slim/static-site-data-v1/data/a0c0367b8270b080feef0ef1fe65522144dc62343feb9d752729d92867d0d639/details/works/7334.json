7fc73cfb9fad1e6a9aa5a21cc290ea54bc30f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/704644d8caf5da32c034461896f1dbc7b5cc3989a2efaae956d9abb60c4f9765.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩居 由希子","creatorId":"vndb:s1160","sourcePersonId":"vndb:s1160","canonicalEntityId":"vndb:s1160","name":"岩居 由希子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:794","source":"vndb"}]},{"characterId":"char_vndb_c36414","characterName":"女の子","sourceIds":{"vndbCharacterId":"c36414"},"originalCharacterName":"女の子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"8"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":true,"text":"A 7th floor patient Himeko was charged with back when she was still a volunteer helper at the hospice. This girl was a hallmark of purity and innocence and Himeko used to be very attached to her. She sadly died at her age of just 8."},{"spoiler":false,"text":"Edited from Wikipedia & Neechin.net"}],"source":"vndb","sourceCharacterId":"c36414"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39fafeeabbe9a8e784da1939bff178ba915f1dcc9931ea31c1d2199415bbb901.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e61c54ac58b2f3f10d97fb3fb0bcf881787475adec9e9d72578789159fa4e73.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"能登 麻美子","creatorId":"vndb:s468","sourcePersonId":"vndb:s468","canonicalEntityId":"vndb:s468","name":"能登 麻美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:791","source":"vndb"}]},{"characterId":"char_vndb_c36415","characterName":"セツミのお母さん","sourceIds":{"vndbCharacterId":"c36415"},"originalCharacterName":"セツミのお母さん","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Setsumi's mother is a kind and caring mother who works very hard to pay for Setsumi's hospital fees. She understands Setsumi well and is doing her best to help her out as much as she can."},{"spoiler":false,"text":"Edited from Wikipedia & Neechin.net"}],"source":"vndb","sourceCharacterId":"c36415"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[{"creditedName":"田中 涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:789","source":"vndb"}]},{"characterId":"char_vndb_c6579","characterName":"篠原 千尋","sourceIds":{"vndbCharacterId":"c6579"},"originalCharacterName":"篠原 千尋","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Himeko's younger sister. She is a devout Christian believer with a kind personality and a hospice volunteer on hospital's 7th floor."},{"spoiler":false,"text":"From Wikipedia & Neechin.net"}],"source":"vndb","sourceCharacterId":"c6579"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/2139665e8ea3d58c9e20da083002002631db1e92dbcb6b5a9bed84aac15b82b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a89fac3370a4d058d9dc656a68640cd8706923181e8e3ec729fc1a8e94297963.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤 邑子","creatorId":"vndb:s833","sourcePersonId":"vndb:s833","canonicalEntityId":"vndb:s833","name":"後藤 邑子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:792","source":"vndb"}]},{"characterId":"char_vndb_c939","characterName":"佐倉 瀬津美","sourceIds":{"vndbCharacterId":"c939"},"originalCharacterName":"佐倉 瀬津美","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Age in Narcissu: 22"},{"spoiler":false,"text":"Age in Narcissu Side 2nd: 15"},{"spoiler":false,"text":"Setsumi has a childlike physique. She has a taciturn and stoic kind of personality. She loves cars and is knowledgeable about them. Because of her terminal illness, she has no friends and is always seen alone. After many years of receiving treatment, she became totally desperate about everything - life or time, or each day passing doesn't matter to her anymore. It is just like she stated once: \"My time came to a halt\". Everything is very painful to her because she was left behind alone as the world around her continued to move on."},{"spoiler":false,"text":"In Narcissu, she met Atou Yuu, a new resident of the hospital's 7th floor, the hospice, and for a short moment did she come to know something like hope."},{"spoiler":true,"text":"They escaped together and headed to Awajishima, to watch the beautiful blooming narcissus. Along the way, they grew attached to each other and the girl found herself emotional again, happy with her new skirt, blushing... At the end of their journey, she asked for a bikini, and after a long day of playing at the beach, she went into the sea and ended her very life."},{"spoiler":false,"text":"In Narcissu Side 2nd, when she was still an outpatient at her age of 15, she met a resident of the hospital's 7th floor, one of hospice's patients, called Himeko. Their bond grew quickly as Himeko and Setsumi enjoyed their summer days together."},{"spoiler":false,"text":"Edited from Wikipedia & Neechin.net"}],"source":"vndb","sourceCharacterId":"c939"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d18ea2711d1d8f535320647cfc1a7bad8f75cb127bac98ca9ea1821e5df4711c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17658a11a43db493bdd09d34617ce272a3a69ec19c984e759876933ce488dde7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"綾川 りの","creatorId":"vndb:s1054","sourcePersonId":"vndb:s1054","canonicalEntityId":"vndb:s1054","name":"綾川 りの","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:793","source":"vndb"}]},{"characterId":"char_vndb_c941","characterName":"篠原 姫子","sourceIds":{"vndbCharacterId":"c941"},"originalCharacterName":"篠原 姫子","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"23"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Often called “Onee-san” (big sister) by her younger sister and friends, Himeko is a car-loving enthusiast with a bright and brisk type of personality. Cheerful and full of energy, no one ever expected that she would one day become a patient in the same ward she had spent so much time volunteering at. Ever since her time in the hospice as a patient began, she became cold and harsh towards her sister and her best friend, but she still loved them immensely. Before she became ill, she was a very active, tomboyish girl who held a great love for cars and knew a great deal about them and the roads they drive on."},{"spoiler":true,"text":"Despite what she says, she is actually religious, and always cares for her family and friends. Maintaining a bright and optimistic appearance throughout the game, only at the end, her inner side is shown as she questioned God and cried with Setsumi by her side. At the end, she managed to bid farewell to the girl with a smile. She is very understanding and mature despite what she shows, and holds a great pain in her heart about one girl whom she once took care of as a helper."},{"spoiler":false,"text":"Edited from Wikipedia & Neechin.net"}],"source":"vndb","sourceCharacterId":"c941"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4880fc0160135819d2a6b2607f2aedcd502684054cf809474addfbd5e8a4a56.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76b9a7d1c604da8a625f122b9418c23a279ce0111ef0868e8e4b74fc4e4c0b3e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせ なつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:790","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p11","sourceCompanyId":"egs:brand:1351","canonicalEntityId":"vndb:p11","name":"ステージ☆なな","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:7334:1351","source":"egs"},{"companyId":"vndb:p135","sourceCompanyId":"vndb:p135","canonicalEntityId":"vndb:p135","name":"ねこねこソフト","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:100209:v70","source":"vndb"},{"companyId":"vndb:p15893","source