acts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/8082c1fb92536f9a59dd5ea6989d2e9b7de537098620ae122a786e8effd1d331.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e29ff2d6248267ffebb04a6a2d14505b13d23f1ec7aa4c5121a24fbd32efeb9.webp","width":165,"height":256,"source":"static-detail"},"actors":[{"creditedName":"釘宮 理恵","creatorId":"vndb:s500","sourcePersonId":"vndb:s500","canonicalEntityId":"vndb:s500","name":"釘宮理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42292","source":"vndb"}]},{"characterId":"char_vndb_c52423","characterName":"セシル＝グレイス","sourceIds":{"vndbCharacterId":"c52423"},"originalCharacterName":"セシル＝グレイス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The maid that takes care of Mother Goose's house."},{"spoiler":false,"text":"An extremely good maid, but she doesn't talk much or show much expression, she's like a doll."},{"spoiler":false,"text":"She gives off a cold and robotic impression, but she's not cruel."},{"spoiler":false,"text":"She's just not good at expressing herself, and is actually a very kind and girly girl at heart."}],"source":"vndb","sourceCharacterId":"c52423"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed5d7e654638f2f19f2c3c67d8f56798c05d97d65b028a3cd51072c2d6261687.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/8497d8ce81447167c78e2191ed9523faba2a184946890718b0497b8e457dfade.webp","width":165,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤 かな恵","creatorId":"vndb:s853","sourcePersonId":"vnd