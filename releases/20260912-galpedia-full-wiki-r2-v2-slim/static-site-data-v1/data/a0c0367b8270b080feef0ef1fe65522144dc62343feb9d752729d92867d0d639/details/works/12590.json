onId":"vndb:vn-staff:36419","source":"vndb"},{"creditedName":"翡翠","creatorId":"vndb:s13319","sourcePersonId":"vndb:s13319","canonicalEntityId":"vndb:s13319","name":"翡翠","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:36420","source":"vndb"},{"creditedName":"杉本 晃志郎","creatorId":"vndb:s51095","sourcePersonId":"vndb:s51095","canonicalEntityId":"vndb:s51095","name":"掘江 満","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:36421","source":"vndb"}]},"cast":[{"characterId":"char_c1576","characterName":"切原 想子","sourceIds":{"bangumi":[{"characterId":"18163","match":"exact-normalized-name-in-linked-work","subjectId":"16480"}],"egsCharacterIds":["12247"],"vndbCharacterId":"c1576"},"originalCharacterName":"切原 想子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"21"},"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"3月18日"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Souko is an intelligent, calm, and attractive woman with a quick mind who can adapt to any situation flexibly. Despite her rough and occasionally absentminded nature, these qualities add to her charm and appeal. She is also notorious for her bad luck, particularly in trivial matters. Still, she is a caring person and a reliable senior to the protagonist."},{"spoiler":false,"text":"Hobbies: Playing guitar and listening to music"},{"spoiler":false,"text":"Favorite things: Cola and pancakes"},{"spoiler":false,"text":"\"That's an intriguing deduction. But from an outsider's perspective like ours, it seems the root of the problem lies within the family's internal conflicts.\""},{"spoiler":false,"text":"Translated and edited from Getchu"}],"source":"vndb","sourceCharacterId":"c1576"},{"segments":[{"spoiler":false,"text":"職業：大学生（主人公の先輩）"},{"spoiler":false,"text":"趣味：ギター・音楽鑑賞　好物：コーラ・ホットケーキ"},{"spoiler":false,"text":"知的でクールなかっこいい女性で、頭の回転も非常に速く、状況に応じて臨機応変に立ち回ることができる。"},{"spoiler":false,"text":"だが大雑把でところどころ抜けているあたりにギャップと愛嬌がある。"},{"spoiler":false,"text":"また、運が悪いことで有名。とにかく些細なところで非常に運が悪い。"},{"spoiler":false,"text":"しかし面倒見がよく、主人公とっては良い先輩。"}],"source":"egs","sourceCharacterId":"12247","sourceWorkId":"12590","spoiler":false},{"segments":[{"spoiler":false,"text":"理性，帅气的酷女，脑子转得非常快，能够根据状况不同而随机应变。"},{"spoiler":false,"text":"然而又有着大大咧咧随处脱线的一面，让人因为落差而莞尔一笑。"},{"spoiler":false,"text":"此外，以恶运强而闻名。总之在小事上运气非常糟糕。"},{"spoiler":false,"text":"不过很会关照人，对主人公来说是个很好的前辈。"},{"spoiler":false,"text":"带着1打可乐来到七凭馆。负责搬运的当然是主人公。"},{"spoiler":false,"text":"「很有趣的推理呢。但是在身为无关者的我们看来，原因更像是出于家族间的争执呢」"}],"source":"bangumi","sourceCharacterId":"18163"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"12247","sourceWorkId":"12590","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"12247","sourceWorkId":"12590","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"12247","sourceWorkId":"12590","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"12247","sourceWorkId":"12590","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf9e3e15ede29688e55d03fd8edd52c4fb87b0afff1b1cade1645fe862d6d2b6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c482c3b2e3c174c4a44ee9b090e1f69115de56aef2cd763a59f05d902be3c6e6.webp","width":183,"height":220,"source":"static-detail"},"actors":[{"creditedName":"西口有香","creatorId":"vndb:s24","sourcePersonId":"vndb:s24","canonicalEntityId":"vndb:s24","name":"西口 有香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16480:18163:6592:1","source":"bangumi"}]},{"characterId":"char_c1577","characterName":"七月 紅緒","sourceIds":{"bangumi":[{"characterId":"18635","match":"exact-normalized-name-in-linked-work","subjectId":"16480"}],"egsCharacterIds":["12249"],"vndbCharacterId":"c1577"},"originalCharacterName":"七月 紅緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"7月4日"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She’s one of the daughters of the Nanatsuki family. She looks like a lady from a high class family, well she is, but that’s just the outer shell she created. Only the people in the house knows how she really is. She keeps a black cat (with different colored eyes). Also pretty calm most of the time whatever the situation."},{"spoiler":false,"text":"From Accany's review."}],"source":"vndb","sourceCharacterId":"c1577"},{"segments":[{"spoiler":false,"text":"職業：七月家次女"},{"spoiler":false,"text":"趣味：演劇鑑賞・映画鑑賞 好物：ココア・サンドウィッチ"},{"spoiler":false,"text":"一見お嬢様風。いや、基本的にはお嬢様。"},{"spoiler":false,"text":"気品や立ち居振る舞いは自然と身に付けている。しかし、それは所謂 “表向き”の姿であって本来の姿ではない。"},{"spoiler":false,"text":"どうやら何か隠している様子。素の彼女を知っているのは館の住人だけ……。"},{"spoiler":false,"text":"また趣味と関連してラヴクラフトと云うオッドアイの珍しい黒猫を飼っている。"}],"source":"egs","sourceCharacterId":"12249","sourceWorkId":"12590","spoiler":false},{"segments":[{"spoiler":false,"text":"一见之下很像大小姐。哦不对，基本上说就是大小姐。"},{"spoiler":false,"text":"气质与行为举止自然而然地环绕周身。但是，那只是所谓的“表面”姿态，不是原本的姿态。"},{"spoiler":false,"text":"貌似隐藏着什么的样子。知道她的本来面目的只有洋馆的住人……"},{"spoiler":false,"text":"此外出于兴趣养着一只名为Lovecraft的异色瞳黑猫。"},{"spoiler":false,"text":"「比起诅咒这种说法，也许七不可思议这种说法更合适呢」"}],"source":"bangumi","sourceCharacterId":"18635"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"12249","sourceWorkId":"12590","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"12249","sourceWorkId":"12590","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"12249","sourceWorkId":"12590","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"12249","sourceWorkId":"12590","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/544a384e7f25202ea93d3b64c8ca9d65b3cd4fef892a23367488626a79f8efc1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/3534260a4fe98a6ac9bf9da950cd4e5b7a9c9e8d3b18096515c2d06a13550d57.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16480:18635:8580:1","source":"bangumi"}]},{"characterId":"char_c1578","characterName":"七月 詩音","sourceIds":{"bangumi":[{"characterId":"18694","match":"exact-normalized-name-in-linked-work","subjectId":"16480"}],"egsCharacterIds":["12250"],"vndbCharacterId":"c1578"},"originalCharacterName":"七月 詩音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"3月18日"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Another one of the daughters in the Nanatsuki family. Shion is an introvert and lives on the top of the tower beside the main building. Or she’s only restricted to living there. Therefore she has never seen the outside world and doesn’t know quite a lot of things we consider common sense. Somewhat shy and softspoken. Loves singing."},{"spoiler":false,"text":"Edited from Accany's review."}],"source":"vndb","sourceCharacterId":"c1578"},{"segments":[{"spoiler":false,"text":"職業：七月家末娘"},{"spoiler":false,"text":"趣味：歌うこと　好物：果物（特に苺）"},{"spoiler":false,"text":"内向的で寡黙な少女。"},{"spoiler":false,"text":"幼い頃から幽閉されて育ったせいで外の世界を知らない。館の外へ出ることも禁止されている。"},{"spoiler":false,"text":"好きなことは歌うことで、彼女にとって一番大切なかけがえのないもの。"},{"spoiler":false,"text":"歌を褒められるとほのかに照れるという無邪気で可愛らしい一面も併せ持つ。"}],"source":"egs","sourceCharacterId":"12250","sourceWorkId":"12590","spoiler":false},{"segments":[{"spoiler":false,"text":"内向的で寡黙な少女。"},{"spoiler":false,"text":"幼い頃から幽閉されて育ったせいで外の世界を知らない。館の外へ出ることも禁止されている。"},{"spoiler":false,"text":"好きなことは歌うことで、彼女にとって一番大切なかけがえのないもの。"},{"spoiler":false,"text":"歌を褒められるとほのかに照れるという無邪気で可愛らしい一面も併せ持つ。"},{"spoiler":false,"text":"「……この歌を唄うと、とても落ち着けるんです」"}],"source":"bangumi","sourceCharacterId":"18694"}],"profileFa