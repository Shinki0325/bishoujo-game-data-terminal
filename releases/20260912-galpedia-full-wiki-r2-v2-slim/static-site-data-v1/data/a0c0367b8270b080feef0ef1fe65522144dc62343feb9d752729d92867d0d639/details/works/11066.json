{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"11066","model":{"presentationWorkId":"vndb:v839","staff":{"artwork":[{"creditedName":"火炎味噌","creatorId":"vndb:s5557","sourcePersonId":"egs:creator:2427","canonicalEntityId":"vndb:s5557","name":"火炎味噌","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:68699","source":"egs"}],"scenario":[{"creditedName":"JUN","creatorId":"egs:creator:240","sourcePersonId":"egs:creator:240","canonicalEntityId":"egs:creator:240","name":"JUN","roleCode":"scenario","roleLabel":"剧本","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:68700","source":"egs"},{"creditedName":"JUN","creatorId":"vndb:s1628","sourcePersonId":"vndb:s1628","canonicalEntityId":"vndb:s1628","name":"JUN","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:16332","source":"vndb"}],"music":[],"other":[{"creditedName":"火炎 味噌","creatorId":"vndb:s5557","sourcePersonId":"vndb:s5557","canonicalEntityId":"vndb:s5557","name":"西 義隆","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:16333","source":"vndb"}]},"cast":[{"characterId":"char_c56262","characterName":"松本 優希","sourceIds":{"bangumi":[{"characterId":"104262","match":"exact-normalized-name-in-linked-work","subjectId":"271092"}],"egsCharacterIds":["17799"],"vndbCharacterId":"c56262"},"originalCharacterName":"松本 優希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"スタイル抜群で見事な巨乳を持つ、魅惑の美人教師。"},{"spoiler":false,"text":"大の美少年好きの彼女は、美少年たちに囲まれたハーレムを夢想し、教職免許を取った。"},{"spoiler":false,"text":"故に、現在、可愛い教え子たちへの劣情を必至に堪えながら、平静を装い、教鞭をふるっている。"},{"spoiler":false,"text":"その類い稀な美貌と男好きするボディから、幾多の男から交際を申し込まれるが、大人の男性特有の体臭や体毛などが生理的に受け付けず、未だ独身で処女。"}],"source":"egs","sourceCharacterId":"17799","sourceWorkId":"11066","spoiler":false},{"segments":[{"spoiler":false,"text":"担任を持つ女教師で、"},{"spoiler":false,"text":"タイトなスーツの似合う妙齢の女性。"},{"spoiler":false,"text":"だが実は、美少年好きで"},{"spoiler":false,"text":"教師になったと"},{"spoiler":false,"text":"密かに自称しており、"},{"spoiler":false,"text":"教え子相手に劣情を抱く事も"},{"spoiler":false,"text":"しばしば。"},{"spoiler":false,"text":"美人なので恋人が出来かけた事も"},{"spoiler":false,"text":"あるのだが、"},{"spoiler":false,"text":"男性の体臭や体毛などを"},{"spoiler":false,"text":"嫌悪するが故に、"},{"spoiler":false,"text":"未だ独り身の処女。"}],"source":"bangumi","sourceCharacterId":"104262"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c1d089d8632f8fa509aa7860c026aaeef56b213473fc3dbb2ec7c094beed945.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81261eacb0f2d04b1b1d9ab533b56dbab7a54c2db769f72195a01efedfb87475.webp","width":153,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木川絵理子","creatorId":"vndb:s1634","sourcePersonId":"vndb:s1634","canonicalEntityId":"vndb:s1634","name":"木川 絵理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271092:104262:4668:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p392","sourceCompanyId":"egs:brand:1513","canonicalEntityId":"vndb:p392","name":"アンダーリップ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:11066:1513","source":"egs"},{"companyId":"vndb:p392","sourceCompanyId":"vndb:p392","canonicalEntityId":"vndb:p392","name":"アンダーリップ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:1956:v839","source":"vndb"},{"companyId":"vndb:p392","sourceCompanyId":"vndb:p392","canonicalEntityId":"vndb:p392","name":"アンダーリップ","roleCodes":["develope