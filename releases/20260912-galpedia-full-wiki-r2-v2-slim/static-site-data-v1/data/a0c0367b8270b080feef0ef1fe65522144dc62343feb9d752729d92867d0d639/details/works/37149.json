elationId":"vndb:vn-staff:210756","source":"vndb"},{"creditedName":"桜沢 大","creatorId":"vndb:s10914","sourcePersonId":"vndb:s10914","canonicalEntityId":"vndb:s10914","name":"桜沢 大","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:210758","source":"vndb"},{"creditedName":"フューチャーハンズ","creatorId":"vndb:s15938","sourcePersonId":"vndb:s15938","canonicalEntityId":"vndb:s15938","name":"Future-hands(フューチャーハンズ)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:210759","source":"vndb"},{"creditedName":"ヤマネ","creatorId":"vndb:s27284","sourcePersonId":"vndb:s27284","canonicalEntityId":"vndb:s27284","name":"ヤマネ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:210760","source":"vndb"},{"creditedName":"みぢあ","creatorId":"vndb:s41601","sourcePersonId":"vndb:s41601","canonicalEntityId":"vndb:s41601","name":"海老根 竜司","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:210762","source":"vndb"}]},"cast":[{"characterId":"char_c44309","characterName":"アナスタシア","sourceIds":{"bangumi":[{"characterId":"65419","match":"exact-normalized-name-in-linked-work","subjectId":"222336"}],"egsCharacterIds":["10940"],"vndbCharacterId":"c44309"},"originalCharacterName":"アナスタシア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"謎の美少女。"},{"spoiler":false,"text":"聖マリス学園の学園長で、妖魔ハンターの組織の長。"},{"spoiler":false,"text":"膨大な霊力を持つ少女。"},{"spoiler":false,"text":"ヒカルが妖魔と戦う際に、助言や力を与える。"},{"spoiler":false,"text":"「昨日付けでこの学園に配属されたアナスタシア・アウグストです」"}],"source":"egs","sourceCharacterId":"10940","sourceWorkId":"9681","spoiler":false},{"segments":[{"spoiler":false,"text":"W（ダブリュー）が所属するマスタープロのマネージャー。"},{"spoiler":false,"text":"姉妹や主人公を影から支え、導く。　しかしその正体は……。"},{"spoiler":false,"text":"光も闇も人間もすべてを統べる神様の半身。"},{"spoiler":false,"text":"だが力はリュードミラ （黒アナ） に吸われてしまった。"},{"spoiler":false,"text":"冷静沈着で感情を表に出さない。"},{"spoiler":false,"text":"一見子供のような姿だが、明晰な頭脳にはあらゆる知識が詰まっている。"},{"spoiler":false,"text":"なぜか主人公の名前だけは覚えない。"},{"spoiler":false,"text":"戦いおいては参謀的な立場を取るが、姉妹の代わりに敵と戦うことも。"}],"source":"egs","sourceCharacterId":"10940","sourceWorkId":"14612","spoiler":false},{"segments":[{"spoiler":false,"text":"ヴァルハラ兵団、ワルキューレヴァクターの指揮官。六枚の翼を持つ、三つの『ストゥラ』（神聖）の持ち主。"},{"spoiler":false,"text":"プラチナのように輝く銀髪が特徴の美しい少女。見た目は幼く胸の起伏もほとんど目立たない。"},{"spoiler":false,"text":"しかし内面に秘めたオーラは絶大。背中に光る６枚もの翼が桁違いの霊力を示している。最強最高位の女神。"},{"spoiler":false,"text":"冷静でクール。感情の起伏が少ない。"},{"spoiler":false,"text":"幼い頃泉のほとりで倒れていたところをオーディンに拾われた。それ以前の記憶を失っている。"},{"spoiler":false,"text":"オーディンの養女となり、彼を父として慕う。その力を認められ、ヴァルハラ兵団に徴用され、後に指揮官となる。"},{"spoiler":false,"text":"使用人だったロキに対して、侮蔑の感情を強く抱いている。"},{"spoiler":false,"text":"武器は身の丈ほどもある覇剣「ヴィザール」。　トールと同等とも言われる強神ヴィザールの剣。一振りで嵐を呼び、山をも断つと言われる。"}],"source":"egs","sourceCharacterId":"10940","sourceWorkId":"25697","spoiler":false},{"segments":[{"spoiler":false,"text":"完全新規シナリオのアナザーストーリー『ジャンヌとアナスタシア～蝶の夢』に登場。"},{"spoiler":false,"text":"不思議な夢を見ていたジャンヌはアナスタシアと名乗る謎の美少女と出会う。"},{"spoiler":false,"text":"ふたりは淫靡な夢の迷宮へと足を踏み入れ、新たな〇〇の数々を味わうこととなる"}],"source":"egs","sourceCharacterId":"10940","sourceWorkId":"33383","spoiler":false},{"segments":[{"spoiler":false,"text":"ソドムの王に囚われ、鳥籠に入れられている謎の美少女。"},{"spoiler":false,"text":"闘技大会の余興として、たびたび観客の前で嬲りものにされる。"}],"source":"egs","sourceCharacterId":"10940","sourceWorkId":"37149","spoiler":false},{"segments":[{"spoiler":false,"text":"最強最高位の女神"},{"spoiler":false,"text":"「哀れな劣等種族よ神の力を思い知りましたか」"},{"spoiler":false,"text":"ヴァルハラ兵団、ワルキューレヴァクターの指揮官。"},{"spoiler":false,"text":"プラチナのように輝く銀髮が特徴の美しい少女。見た目は幼いが内に秘めた"},{"spoiler":false,"text":"オーラは絶大。背中に光る6枚もの翼が桁違いの霊力を示している。"},{"spoiler":false,"text":"冷静でクール。感情の起伏が少ない。"},{"spoiler":false,"text":"主神オーディンの養女であり、彼を父として慕う。"},{"spoiler":false,"text":"使用人だったロキに対して、侮蔑の感情を強く抱いている。"}],"sou