"vndb"},{"creditedName":"高岡 嘉子","creatorId":"vndb:s36781","sourcePersonId":"vndb:s36781","canonicalEntityId":"vndb:s36781","name":"高岡 嘉子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:11506","source":"vndb"}]},"cast":[{"characterId":"char_c14025","characterName":"音羽 葉子","sourceIds":{"bangumi":[{"characterId":"140427","match":"exact-normalized-name-in-linked-work","subjectId":"120318"},{"characterId":"140427","match":"exact-normalized-name-in-linked-work","subjectId":"41747"}],"egsCharacterIds":["8366"],"vndbCharacterId":"c14025"},"originalCharacterName":"音羽 葉子","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The third heroine of Natsu Kagura and the elder of the Otowa Clan. A Freeloader of Minamori shrine and a gentle person. She is very calm in any situation. Youko is actually an incarnation of nine tailed fox spectre. She was sealed by the great grandfather of Otowa, long time ago, and since then she had been serving at the Otowa home. Due to the nature of a fox, her smile is unexpectedly a part of her scheming. She has a bad habit of teasing other people, especially Keika, even during sex with her. In many ocassion, she demonstrated her great knowledges regarding the situatiion, including the youkai's detail. Youko seems to know Kijima from Oni Kagura series since long time ago. She has daughter named Nanaka, who appears at Debo no Subako. Youko appears at Aozora Magiccer which is direct sequel of Youko's route from Natsu Kagura and take place in alternate (fantasy) universe. Youko also makes cameo at Kagura Douchukii."}],"source":"vndb","sourceCharacterId":"c14025"},{"segments":[{"spoiler":false,"text":"音羽家一番の年長者。 神社の居候。 音羽家で一番胸の大きい人。"},{"spoiler":false,"text":"一見おっとりさんで、大抵のことには動じず笑顔のままで対応できる大物。"},{"spoiler":false,"text":"しかし時々人をからかう悪い癖を持っていて、意外と腹黒い部分もある。"},{"spoiler":false,"text":"実は昔の大妖怪で狐の化身。 桂香たちの祖父に封じられ、以来音羽家に仕えている。"},{"spoiler":false,"text":"現在は霊力のほとんどが封じられているので簡単な雑務しか出来ないが、膨大な知識を持っていて妖怪や退魔についても詳しい。"}],"source":"egs","sourceCharacterId":"8366","sourceWorkId":"20961","spoiler":false},{"segments":[{"spoiler":false,"text":"音羽家一番の年長者。神社の居候。"},{"spoiler":false,"text":"音羽家で一番胸の大きい人。"},{"spoiler":false,"text":"一見おっとりさんで、常に微笑みをたたえています。"},{"spoiler":false,"text":"大抵のことには動じず、笑顔のままで対応出来る大物。"},{"spoiler":false,"text":"ただし本性が妖怪なので、腹黒い部分もあるようです。"},{"spoiler":false,"text":"年の功というか、策士の人。"}],"source":"bangumi","sourceCharacterId":"140427"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d55d252216ff2165c052a032126a0d9658816f70ae8a3c4b41052e26de9cc89.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/0788968f245192b9c7f86d8401dfc7a3b06796cdcc84fb22e2e2344b0280c8d8.webp","width":123,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青山 ゆかり","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5240","source":"vndb"}]},{"characterId":"char_c20719","characterName":"滝峰 幹也","sourceIds":{"bangumi":[{"characterId":"140632","match":"exact-normalized-name-in-linked-work","subjectId":"120318"},{"characterId":"140632","match":"exact-normalized-name-in-linked-work","subjectId":"41747"}],"egsCharacterIds":["8367"],"vndbCharacterId":"c20719"},"originalCharacterName":"滝峰 幹也","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist, Takimine Mikiya is a priest apprentice of the Takimine clan. A mild-mannered pacifist and a relative of the heroines. He’s dispatched to help Otowa house exterminating an abnormally massive amount of demons emerging in Minamori’s land. Mikiya is remarkably skilled in Onmyouji spells (able to perform one without incantation), various shikigamis summoning, medical purification, healing spell, and a very strong spiritual power. Though his Onmyouji destruction spell (by projecting it through kick and fist) is able to deal high damage, it’s still required access and full spiritual power preparation by the user. It’s makes him powerful yet vulnerable to enemy’s counterattack. During one of the confrontation, Mikiya having his power sealed by a Spider specter. Thus keeping him from front line’s fighting as often as the more combat oriented Otowa sisters. Mikiya tends to rely on Keika, Hatsuka, and his shikigamis when direct combat is required. Later, as explained at Keika’s ending, Mikiya occasionally travels to another cities and reappears as temporary lecturer in it’s sequel, TsukiKagura. Mikiya also reappears in Aozora Magiccer!! as the sequel of Youko’s ending."}],"source":"vndb","sourceCharacterId":"c20719"},{"segments":[{"spoiler":false,"text":"音羽姉妹とは親戚関係にある神社の倅。"},{"spoiler":false,"text":"拳や蹴りで妖怪を退治する格闘術の使い手。"},{"spoiler":false,"text":"性格は温厚な平和主義者。 そのため戦闘はあまり好きではないのだが、なまじ腕があるせいであちこちの助っ人に派遣されている。"},{"spoiler":false,"text":"本人はデスクワークへの異動を常に申請中。"},{"spoiler":false,"text":"もっとも、上層部は無視している模様。"}],"source":"egs","sourceCharacterId":"8367","sourceWorkId":"20961","spoiler":false},{"segments":[{"spoiler":false,"text":"神主候補の青年。"},{"spoiler":false,"text":"ヒロイン達とは親戚関係にある神社の倅。"},{"spoiler":false,"text":"拳や蹴りで妖怪を退治する格闘術の使い手ですが、"},{"spoiler":false,"text":"性格は温厚な平和主義者です。"},{"spoiler":false,"text":"その為、戦闘はあまり好きではないのですが、"},{"spoiler":false,"text":"なまじ腕があるせいで、あちこちの助っ人に"},{"spoiler":false,"text":"派遣されています。"},{"spoiler":false,"text":"本人はデスクワークへの異動を常に申請中。"}],"source":"bangumi","sourceCharacterId":"140632"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc673e37546ea15af4f4d883da16c7572263f3669befec4cd3e6d24f8dd7428e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/495ff8283e85a53ae264183ff1b9b31960fb46ba4bbfc170570e69c5aa250e71.webp","width":91,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c69625","characterName":"ミツハ","sourceIds":{"bangumi":[{"characterId":"140173","match":"exact-normalized-name-in-linked-work","subjectId":"217687"}],"egsCharacterIds":["22389"],"vndbCharacterId":"c69625"},"originalCharacterName":"ミツハ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公・その１。"},{"spoiler":false,"text":"空を飛ぶ不思議な能力をもち、研究対象とし在籍していた軍の研究施設から脱走した逃亡者。"},{"spoiler":false,"text":"逃げ出した後、空賊団の頭領の娘に拾われ、山の中腹にある小さな村に居を構えている。"},{"spoiler":false,"text":"研究施設以前の記憶がなく、空を飛べる力は周囲には秘密にしている。"},{"spoiler":false,"text":"基本的に困っている人は助けようという性格。特技は機械いじり。"},{"spoiler":false,"text":"武器は、研究施設から一緒に逃げた喋る杖の「スー」（女の子）。御神木製で、自分の記憶を求め、空の冒険に出る。"}],"source":"egs","sourceCharacterId":"22389","sourceWorkId":"8522","spoiler":false},{"segments":[{"spoiler":false,"text":"山の中腹にある小さな村に居を構えている少年。"},{"spoiler":false,"text":"空を飛ぶ不思議な能力をもち、研究対象とし在籍していた軍の研究施設から脱走した逃亡者。"},{"spoiler":false,"text":"研究施設以前の記憶がありません。空を飛べる力は周囲には秘密にしています。"},{"spoiler":false,"text":"基本的に、正義の子。困っている人は助けようという性格です。特技は機械いじり。"},{"spoiler":false,"text":"武器は、研究施設から一緒に逃げた喋る杖の『スー』。御神木製。"},{"spoiler":false,"text":"自分の記憶を求めて、空の冒険に出ます。"}],"source":"bangumi","sourceCharacterId":"140173"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68bf15db774c36f3c3895f871825de372970ced542b740a0c581cee416fefb0f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46e406a7ee06da2e72dc9a772a9b4c73ae1842f5f7105b6b3dcfcab4563aec23.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中國卓郎","creatorId":"vndb:s1067","sourcePersonId":"vndb:s1067","canonicalEntityId":"vndb:s1067","name":"中國 卓郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217687:140173:4606:1","source":"bangumi"}]},{"characterId":"char_c69626","characterName":"ティリナ","sourceIds":{"bangumi":[{"characterId":"140174","match":"exact-normalized-name-in-linked-work","subjectId":"217687"}],"egsCharacterIds":["22390"],"vndbCharacterId":"c69626"},"originalCharacterName":"ティリナ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公・その２。魔女見習いの女の子。"},{"spoiler":false,"text":"魔女であり師匠でもある祖母ファナと、二人暮らしをしている。"},{"spoiler":false,"text":"反射神経で動く突撃系元気娘。考える前に飛べ。すっげえナイスで格好いい魔女に憧れている。"},{"spoiler":false,"text":"祖母の命令で魔女の修行としてあちこち飛び回り、世界の不思議や神獣を封じている。"},{"spoiler":false,"text":"魔女であることは、基本的に秘密。"}],"source":"egs","sourceCharacterId":"22390","sourceWorkId":"8522","spoiler":false},{"segments":[{"spoiler":false,"text":"魔女であり師匠でもある祖母と、二人暮らしをしている魔女見習いの女の子。"},{"spoiler":false,"text":"祖母の命令で魔女の修行としてあちこち飛び回り、世界の不思議や神獣を封じています。"},{"spoiler":false,"text":"魔女であることは、基本的に秘密にしています。反射神経で動く突撃系元気娘。考える前に飛べ。"},{"spoiler":false,"text":"すっげえナイスで格好いい魔女に憧れています。"}],"source":"bangumi","sourceCharacterId":"140174"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a1a25f5ea49a055109f1b9bd864365396ac759073564696298bc1c245274edd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/acb4c6d78654776edef55c282811322b7bb1b8b6c6d77b06822eed5a79bac01a.webp","width":213,"height":256,"so