:"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:66939","source":"vndb"},{"creditedName":"株式会社キューブ","creatorId":"vndb:s2651","sourcePersonId":"vndb:s2651","canonicalEntityId":"vndb:s2651","name":"株式会社キューブ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66942","source":"vndb"},{"creditedName":"獏プロダクション","creatorId":"vndb:s4261","sourcePersonId":"vndb:s4261","canonicalEntityId":"vndb:s4261","name":"有限会社獏プロダクション","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66943","source":"vndb"},{"creditedName":"下山 真吾","creatorId":"vndb:s10276","sourcePersonId":"vndb:s10276","canonicalEntityId":"vndb:s10276","name":"下山 真吾","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66945","source":"vndb"},{"creditedName":"やべ あきら","creatorId":"vndb:s40461","sourcePersonId":"vndb:s40461","canonicalEntityId":"vndb:s40461","name":"やべあきら","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66946","source":"vndb"}]},"cast":[{"characterId":"char_c47850","characterName":"西尾 彩","sourceIds":{"bangumi":[{"characterId":"46975","match":"exact-normalized-name-in-linked-work","subjectId":"104355"}],"egsCharacterIds":["23579"],"vndbCharacterId":"c47850"},"originalCharacterName":"西尾 彩","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"マリテレビ入社五年目の中堅女子アナウンサー。"},{"spoiler":false,"text":"可愛らしい顔立ちと、抜群のプロポーション、明るいキャラクターで「女子アナ人気ランキング」では常に上位にランクしている。"},{"spoiler":false,"text":"本人は報道志望だが、バラエティー番組を担当することが多く、自分のアナウンス能力に自信がないこととも相俟って思い悩んでいる。"},{"spoiler":false,"text":"そんな彼女は女王様気質を隠し持ち、それを必死に隠しているが、最近、彼女の担当ADになった主人公に「イジメてオーラ」を感じたことから、主人公でちょっとしたストレス発散をするようになった。"}],"source":"egs","sourceCharacterId":"23579","sourceWorkId":"12057","spoiler":false},{"segments":[{"spoiler":false,"text":"マリテレビ入社5年目の中堅人気女子アナ。"},{"spoiler":false,"text":"明るくサバサバした印象と、バラエティ番組などにおける見事な仕切りで社内外の評価が高く、女子アナ人気ランキングでも常に上位。"},{"spoiler":false,"text":"また人当たりがよく、上司やスタッフ・共演者からの信頼も厚いが、一方で鬱積したストレスを主人公に当たることで晴らすという隠れた一面も。"},{"spoiler":false,"text":"本人は報道志望だが、現在はバラエティ番組のレギュラーの方が多い。"},{"spoiler":false,"text":"それが、自分のアナウンス能力に満足できていない点と相まって、微妙なコンプレックスになっている。"},{"spoiler":false,"text":"先天的な女王様気質を必死で隠しているものの、主人公に対してだけはS気質を見せてしまう （彼女自身は可愛がっているつもり）。"},{"spoiler":false,"text":"主人公の愛称 “みのキュー”の名付け親で、いつしかスタッフ内にもそのあだ名が浸透している。"},{"spoiler":false,"text":"「あんた、あのコーヒーに何か混ぜたの……？　正直に言わないと、このまま握り潰すわよ！」"}],"source":"bangumi","sourceCharacterId":"46975"}],"profileFacts":[{"label":"年龄（本版本）","value":"27 岁","valueContext":null,"source":"egs","sourceCharacterId":"23579","sourceWorkId":"12057","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"23579","sourceWorkId":"12057","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"23579","sourceWorkId":"12057","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"23579","sourceWorkId":"12057","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"23579","sourceWorkId":"12057","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"51 kg","valueContext":null,"source":"egs","sourceCharacterId":"23579","sourceWorkId":"12057","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/6442653480692211eace389fd540ea56960181ad3a8d9dc04d28d1f6ec774649.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a0b1384af0a08129aba2316fc7776eb55c97b5f8ab7ecd9c7e37a29d61809b9.webp","width":75,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:104355:46975:6131:1","source":"bangumi"}]},{"characterId":"char_c47851","characterName":"宮瀬 香織","sourceIds":{"bangumi":[{"characterId":"46976","match":"exact-normalized-name-in-linked-work","subjectId":"104355"}],"egsCharacterIds":["23580"],"vndbCharacterId":"c47851"},"originalCharacterName":"宮瀬 香織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"マリテレビ入社一年目の新人女子アナウンサー。22歳。"},{"spoiler":false,"text":"アイドル顔負けのルックスで、まだ担当番組は少ないものの、既に熱狂的なファンがついており、その人気は非常に高い。"},{"spoiler":false,"text":"原稿読みはあまり得意ではなく、たびたび噛んでしまうが、それがファンの間では“萌えポイント”として評価されている。"},{"spoiler":false,"text":"真面目な彼女自身は何とかアナウンス技術を磨こうと日々努力している。"},{"spoiler":false,"text":"しかし、人気と実力が伴わないことから先輩女子アナウンサーにやっかまれ、陰口を叩かれることも多く、それが彼女のストレスになっている。"}],"source":"egs","sourceCharacterId":"23580","sourceWorkId":"12057","spoiler":false},{"segments":[{"spoiler":false,"text":"マリテレビ入社1年目の新人女子アナ。"},{"spoiler":false,"text":"アイドル顔負けのルックスで、まだまだ担当番組は少ないが、一部に熱狂的なファンも多く、写真週刊誌などで特集を組まれることも多い。"},{"spoiler":false,"text":"原稿読みはあまり得意ではなく度々噛んでしまうのだが、それもファンの間では萌えポイントとして評価され、噛むことを期待される風潮も。"},{"spoiler":false,"text":"一部の先輩アナウンサーからは、ルックスだけで女子アナに採用されたとやっかまれ、それがストレスになってしまっている。"},{"spoiler":false,"text":"何事にも真面目な頑張り屋で、時間が空くと原稿読みや実況の練習をしている。"},{"spoiler":false,"text":"「良薬は口に苦しっていいますけど……んくっ……蓑田さんのってそんなに苦くないですよね……」"}],"source":"bangumi","sourceCharacterId":"46976"}],"profileFacts":[{"label":"年龄（本版本）","value":"22 岁","valueContext":null,"source":"egs","sourceCharacterId":"23580","sourceWorkId":"12057","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"23580","sourceWorkId":"12057","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"23580","sourceWorkId":"12057","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"23580","sourceWorkId":"12057","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"23580","sourceWorkId":"12057","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"49 kg","valueContext":null,"source":"egs","sourceCharacterId":"23580","sourceWorkId":"12057","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/061e48c5aafc42933622bff4aabac4317945c4c1f14c24b25331dd8e6b3ebca8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99bd9058524cf13fe63d88dae2a413492a52c4d2ae1418ed52edef9cc57d78df.webp","width":69,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优",