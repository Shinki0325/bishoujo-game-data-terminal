:"bangumi","value":"24"},"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"3月14日"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Occupation: Office Lady"},{"spoiler":false,"text":"Desired Position: Production Office (Hopes to be a producer some day)"},{"spoiler":false,"text":"A very smart and strong-willed woman. Could be a model with her looks."},{"spoiler":false,"text":"She's in her 3rd year of work as an office lady for a editorial company. She often thinks of how she would do things differently if she was in charge, so she hopes to move into a production position."},{"spoiler":false,"text":"She wants to be recognized for her talents, but she has not yet received an offer from any companies (Though she has been asked if she’d like to be a model at those same companies). Fed up only being judged on her physical appearance, she’s willing to put up with a lot if it means getting to where she wants to be."},{"spoiler":false,"text":"Our hero sees this and happily begins to lead her down the path to a type of work she probably never considered..."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c67752"},{"segments":[{"spoiler":false,"text":"凛々しく知的、意志の強い才女。"},{"spoiler":false,"text":"モデルで十分いけそうなルックスの持ち主。"},{"spoiler":false,"text":"編集プロダクションに勤めて3年目のOL。"},{"spoiler":false,"text":"今の会社で仕事をするうち、自分ならもっとこうするのに…と考えるようになり、人に使われるより自分の考えでやっていきたいと制作側を志望する。"},{"spoiler":false,"text":"作り手として認められたいが、これまで受けた会社では内定もらえずにきた。"},{"spoiler":false,"text":"（タレントとしての採用の打診はあった……）。"},{"spoiler":false,"text":"外見しか評価されないことに焦り、苛立ちを感じており、作り手として採用して貰うためなら多少のことはガマンしようと思っている。"},{"spoiler":false,"text":"その気持ちを主人公に見透かされ、まんまと怪しげな方向へ誘導されてしまい、思わぬ事態へ陥っていく……。"}],"source":"egs","sourceCharacterId":"10656","sourceWorkId":"14876","spoiler":false},{"segments":[{"spoiler":false,"text":"編集プロダクションに勤めて3年目のOL。"},{"spoiler":false,"text":"今の会社で仕事をするうち、自分ならもっとこうするのに…と考えるようになり、人に使われるより自分の考えでやっていきたいと制作側を志望する。"},{"spoiler":false,"text":"作り手として認められたいが、これまで面接を受けた会社ではタレントとしての採用の打診しかなかった。"},{"spoiler":false,"text":"外見しか評価されないことに焦り、苛立ちを感じており、作り手として採用してもらうためなら多少のことはガマンしようと思っている。"},{"spoiler":false,"text":"その気持ちを主人公に見透かされ、まんまと怪しげな方向へ誘導されてしまい、思わぬ事態へ陥っていく……"}],"source":"bangumi","sourceCharacterId":"62790"}],"profileFacts":[{"label":"星座","source":"bangumi","sourceCharacterId":"62790","value":"うお座"},{"label":"年龄（本版本）","value":"24 岁","valueContext":null,"source":"egs","sourceCharacterId":"10656","sourceWorkId":"14876","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"10656","sourceWorkId":"14876","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"10656","sourceWorkId":"14876","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"10656","sourceWorkId":"14876","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"10656","sourceWorkId":"14876","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"10656","sourceWorkId":"14876","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46216ee5b3d662fc17c70eaf63f81f396e476030e1f102f5d290dec169eeb968.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/baf4aa6a5d2d5509bd7f16c0ecbb4a74f9f4e74b21f035adbdbbce792b729337.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:243583:62790:5741:1","source":"bangumi"}]},{"characterId":"char_c67753","characterName":"松浦 八千穂","sourceIds":{"bangumi":[{"characterId":"62791","match":"exact-normalized-name-in-linked-work","subjectId":"243583"}],"egsCharacterIds":["10657"],"vndbCharacterId":"c67753"},"originalCharacterName":"松浦 八千穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"21"},"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"9月15日"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Occupation: Student"},{"spoiler":false,"text":"Desired Position: Sales Department"},{"spoiler":false,"text":"A bright, friendly student. She's got better style than a swimsuit model."},{"spoiler":false,"text":"She attends a women's college. She's always dreamed of being in show biz. She’s never thought about being the one in the spotlight. She just wants to work along side famous people, almost like a fan."},{"spoiler":false,"text":"With that reasoning, no company has even offered her an interview. Feeling a sense of impending doom, she realizes she has to do something fast."},{"spoiler":false,"text":"Sensing her impatience, our hero uses kind words and the hope of a job offer to slowly lead her astray..."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c67753"},{"segments":[{"spoiler":false,"text":"明るく人当たりがいい、元気な女子大生。"},{"spoiler":false,"text":"そこらのグラドルよりずっと見事なスタイルを持つ。"},{"spoiler":false,"text":"お嬢様系女子大に通っている。"},{"spoiler":false,"text":"華やかな芸能界に憧れる夢見る乙女。"},{"spoiler":false,"text":"自分がタレントになりたい、スポットライトを浴びたい…という思いはなく、あくまで憧れの芸能人の側で働きたい…というファン気質丸出しの安易な意図の持ち主。"},{"spoiler":false,"text":"その甘い考えのため、これまで受けた会社では一次面接すら通ってこなかった。"},{"spoiler":false,"text":"何度も落ちて来たので流石に危機感を感じており、何とかしないと…という焦りを抱いている。"},{"spoiler":false,"text":"そんな焦燥感を見抜いた主人公に、甘い言葉で内定をチラつかされ、自分からどんどん深みにハマっていくことに……。"}],"source":"egs","sourceCharacterId":"10657","sourceWorkId":"14876","spoiler":false},{"segments":[{"spoiler":false,"text":"お嬢様系女子大に通う、華やかな芸能界に憧れる夢見る乙女。"},{"spoiler":false,"text":"自分がタレントになりたい、スポットライトを浴びたい…という思いはなく、あくまで憧れの芸能人の側で働きたい…というファン気質丸出しの安易な意図の持ち主。"},{"spoiler":false,"text":"その甘い考えのため、これまで受けた会社では一次面接すら通ってこなかった。"},{"spoiler":false,"text":"何度も落ちてきたので流石に危機感を感じており、なんとかしないと…という焦りを抱いている。"},{"spoiler":false,"text":"そんな焦燥感を見抜いた主人公に、甘い言葉で内定をチラつかされ、自分からどんどん深みにハマっていくことに……"}],"source":"bangumi","sourceCharacterId":"62791"}],"profileFacts":[{"label":"星座","source":"bangumi","sourceCharacterId":"62791","value":"おとめ座"},{"label":"年龄（本版本）","value":"21 岁","valueContext":null,"source":"egs","sourceCharacterId":"10657","sourceWorkId":"14876","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"10657","sourceWorkId":"14876","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"10657","sourceWorkId":"14876