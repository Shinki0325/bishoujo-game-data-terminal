ue character just to Kouhei who leaves a terrible first impression. She does not belong to any club, but she tries to join in literature activities. She likes her old school's uniform, and even though she has the new school's uniform in her possession, she continues to wear her old one. She is bad at putting her own hair into pigtails."}],"source":"vndb","sourceCharacterId":"c4761"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8e67ce734f05d50a4d2d17800fffdaa74af72dc60f5726082f7373e19454509.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/abb81ddfbfb247fa2aff7ed5601b390919ac7470cbc9b90265957f2f6c4f91ba.webp","width":256,"height":150,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p49","sourceCompanyId":"egs:brand:183","canonicalEntityId":"vndb:p49","name":"Tactics","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:590:183","source":"egs"},{"companyId":"vndb:p49","sourceCompanyId":"vndb:p49","canonicalEntityId":"vndb:p49","name":"Tactics","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:14105:v6072","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
