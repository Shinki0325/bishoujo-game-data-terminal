{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"20054","model":{"presentationWorkId":"egs:20054","staff":{"artwork":[],"scenario":[],"music":[],"other":[{"creditedName":"奥井雅美","creatorId":"vndb:s5616","sourcePersonId":"egs:creator:12660","canonicalEntityId":"vndb:s5616","name":"奥井雅美","detail":"OP曲「ヒカリノハナ」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:215393","source":"egs"}]},"cast":[{"characterId":"char_bangumi_92580","characterName":"Yoroi Sakon","sourceIds":{"bangumi":[{"characterId":"92580","match":"source-roster","subjectId":"29469"},{"characterId":"92580","match":"source-roster","subjectId":"328307"},{"characterId":"92580","match":"source-roster","subjectId":"4828"},{"characterId":"92580","match":"source-roster","subjectId":"492255"},{"characterId":"92580","match":"source-roster","subjectId":"51705"}]},"originalCharacterName":"Yoroi Sakon","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0216"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美琴の父で、帝国情報省外務二課長。神出鬼没でマイペースな性格だが、悠陽の信頼も厚い実力者。権謀術数に極めて長ける。美琴には情報省に勤務していることを内緒にしており、表向きは城内省御用達の貿易商として動き回っている。"},{"spoiler":false,"text":"12･5事件後に一時姿をくらますが、桜花作戦後には姿を見せている。"},{"spoiler":false,"text":"『TE』にも登場しており、帝国軍と国連軍（横浜基地）の間を取り持つなど、裏で暗躍している。"}],"source":"bangumi","sourceCharacterId":"92580"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf228e5b22ece41ee2f1b66e83b932359232148999e971585444e527c7615dd7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c02803d56a3c388c9937367faf647d8aa66b9dd8e01fd1f7565d4e04f6745e3d.webp","width":79,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_92582","characterName":"Kyouzuka Shizue","sourceIds":{"bangumi":[{"characterId":"92582","match":"source-roster","subjectId":"116744"},{"characterId":"92582","match":"source-roster","subjectId":"29469"},{"characterId":"92582","match":"source-roster","subjectId":"328307"},{"characterId":"92582","match":"source-roster","subjectId":"4827"},{"characterId":"92582","match":"source-roster","subjectId":"4828"}]},"originalCharacterName":"Kyouzuka Shizue","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"国連軍横浜基地PXにいる「食堂のおばちゃん」。階級は臨時曹長。かつては柊町2丁目に住み、柊町駅の近く商店街沿い踏切の手前の角で「京塚食堂」を経営していた。衛士の息子がおり転属を繰り返している。疎開中は、北海道網走で食料不足に苦しむ。横浜基地に住み込みで働いている。"},{"spoiler":false,"text":"武の分の食事の量を（無理矢理）増やしてくれる。"}],"source":"bangumi","sourceCharacterId":"92582"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/4139e18f73eaadc4a6fdb9742aa6567e78503c7daba9ebadbcd29c6b054646aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed3987b3166d89d44fc8c8b4a8ec9a4c4fd6fd14d80cc5e1be4cee4cb82a3f81.webp","width":108,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:2282","sourceCompanyId":"egs:brand:2282","canonicalEntityId":"egs:brand:2282","name":"MAGES.(5pb.)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:20054:2282","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
