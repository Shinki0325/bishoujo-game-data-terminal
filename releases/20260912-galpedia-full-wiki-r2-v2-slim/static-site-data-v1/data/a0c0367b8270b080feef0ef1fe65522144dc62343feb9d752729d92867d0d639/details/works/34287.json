"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The first ghost to come to the town from the outside world."},{"spoiler":false,"text":"Since she doesn't have her own place, she is currently staying at Sayoko’s."},{"spoiler":false,"text":"Her upbeat and extroverted personality make her very effective as the town's therapist."}],"source":"vndb","sourceCharacterId":"c126849"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a19e27b951d91ce0ac93d11708fa3d1875d1bf3aefa5cf26f1a93130ae79179.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd7f49d36b4a083e482f018c17d20b7705a6718c49ebdb1d3fb7b0085933e086.webp","width":184,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c129822","characterName":"パシフィカ","sourceIds":{"vndbCharacterId":"c129822"},"originalCharacterName":"パシフィカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl of many talents who can wear the hat of a detective, that of a teacher, or even that of a craftswoman. She's in charge of fixing all sorts of troublesome situations around town. She sounds like one extremely influential individual but, around Sayoko, she behaves like any other normal girl."}],"source":"vndb","sourceCharacterId":"c129822"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/2416048ae3cac8c9b207d431ccb99e8b58c29a0a5f896924ebb90795ee602b27.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3eb1cb2e6b51bfe752410fe1c92c86faf81f523a799d11a64d61d2095ea76392.webp","width":158,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c129823","characterName":"アーニャ","sourceIds":{"vndbCharacterId":"c129823"},"originalCharacterName":"アーニャ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Works at the local repairshop. She's not very good with people and she can come off as standoffish but she gets along well with Sayoko. Despite what her apparent lack of femininity may suggest, she's the most experienced one of her group when it comes to handling guys."}],"source":"vndb","sourceCharacterId":"c129823"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a74ebf9f3a9a2d4483dab986677d1316f997f2c6b50728c2f0944af3ae75e8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3eaf96bc8f3f969efec97d2864cc23330b65594511e5e04412cfcc0e043f1e76.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c129824","characterName":"警部","sourceIds":{"vndbCharacterId":"c129824"},"originalCharacterName":"警部","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Works to maintain peace and order in town."},{"spoiler":false,"text":"You can find him patrolling the streets every day. His sluggish speech makes him sound just as unmotivated as he looks, but he actually takes his job very seriously."},{"spoiler":false,"text":"He insists that he's a police chief, but whether or not police ranks are even a thing at all in this town is a mystery."}],"source":"vndb","sourceCharacterId":"c129824"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe0bce30cff261a42e4cc5e928701e5e2131910f11d0ea2d0167ebb0956b71f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91c38e2733769d5b82d6ea46d1555dbe527cae865f2b15be3614adcb6776d82e.webp","width":177,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c129825","characterName":"クラーラ","sourceIds":{"vndbCharacterId":"c129825"},"originalCharacterName":"クラーラ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A few years younger than Sayoko, she has devoted her life to the Priest and the Church."},{"spoiler":false,"text":"She's young but hardworking, genuine, and kind to everyone. All these characteristics make her loved by almost every single ghost... Sayoko and the other girls being notable exceptions."}],"source":"vndb","sourceCharacterId":"c129825"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d643c35b1712814aaeb0b9a83172e9a369dfbc0f79bac84327c3337eb9a55ef1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/979ff2c50ecd076f669ee712b718071a732ad8a7b088192c1364f34f335efc27.webp","width":179,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c129826","characterName":"神父","sourceIds":{"vndbCharacterId":"c129826"},"originalCharacterName":"神父","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The spiritual leader of the Church. It wouldn't be a stretch to say he is the most influential ghost in town."},{"spoiler":false,"text":"For some reason, he seems very intent on capturing Yoru..."}],"source":"vndb","sourceCharacterId":"c129826"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/feb4ec1c57f9228c738b4fceef433c899da2ed3c77cc37065d6b40b3531bf55e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8da64a9699c6bc1acadb3557335f5761ce4b879eca75a3c678e4e8809609d15.webp","width":158,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c131780","characterName":"ロゥ","sourceIds":{"vndbCharacterId":"c131780"},"originalCharacterName":"ロゥ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A few years older than Sayoko and the other girls, she can be found working at a costume shop on the outskirts of the town."},{"spoiler":false,"text":"She has a somewhat intimidating appearance, but she's kind and considerate. She also happens to like playing the piano."},{"spoiler":false,"text":"It's rare to see her actually working at her shop, as she's mostly dillydallying around."}],"source":"vndb","sourceCharacterId":"c131780"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/acc2b9fc806adad2f9a6a489703e0b2fc60b27c04a66514cb8b550abfa5bd7e8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f852fe1e667fc0dfe787017d6d9ac95baa0b3fc2a3b74a18300e2939620aa3af.webp","width":183,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"cha