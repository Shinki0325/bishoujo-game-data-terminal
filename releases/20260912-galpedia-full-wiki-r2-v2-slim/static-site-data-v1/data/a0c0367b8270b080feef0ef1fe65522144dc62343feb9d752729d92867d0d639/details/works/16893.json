},{"characterId":"49872","match":"exact-normalized-name-in-linked-work","subjectId":"365700"}],"egsCharacterIds":["8786"],"vndbCharacterId":"c6692"},"originalCharacterName":"乳泉 燈華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"130"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"T"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"11"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"72"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Actual Breast Priestess. Grandmother of Ukyou. Mother of Renka and Momoka."},{"spoiler":false,"text":"In Chichi Miko!!:"},{"spoiler":false,"text":"She is still young, but she wants to give the job to a younger girl."},{"spoiler":false,"text":"Chichi Miko!! Plus 1:"},{"spoiler":false,"text":"She married Ukyou and had a daughter with him. The three of them live together in the shrine."}],"source":"vndb","sourceCharacterId":"c6692"},{"segments":[{"spoiler":false,"text":"乳泉神社の神主をつとめる、主人公の祖母。"},{"spoiler":false,"text":"霊能者と言われていて、神秘的なイメージを持つが、基本的に穏やかな気性だけれど、時々、主人公や娘達に悪戯をしかけたりとお茶目な面もある。"},{"spoiler":false,"text":"どっしりした超乳の持ち主で、チクビは敏感な陥没チクビ。"},{"spoiler":false,"text":"母乳体質で、飲んだ者に特殊な効果が表れる母乳が出る。"},{"spoiler":false,"text":"乳巫女候補への乳巫女特訓時には、祖母から依頼を受けたとして、乳天狗（!?）に変装して指導に当たるが、髪とボディライン・態度などで、みんなにはバレバレ。"}],"source":"egs","sourceCharacterId":"8786","sourceWorkId":"15287","spoiler":false},{"segments":[{"spoiler":false,"text":"右京と結ばれてからも現役で乳泉神社の神主をつとめる、主人公の祖母。"},{"spoiler":false,"text":"陥没乳首で、母乳体質。"},{"spoiler":false,"text":"娘の鏡華を産んで以来、ますます若々しく美しくなって、母乳の出も良くなっているので、よく右京に搾って貰っている。"}],"source":"egs","sourceCharacterId":"8786","sourceWorkId":"16893","spoiler":false},{"segments":[{"spoiler":false,"text":"乳泉神社で現・乳巫女を務める右京の祖母。"},{"spoiler":false,"text":"年齢に不釣り合いな美貌と、超乳を持つ美女。"},{"spoiler":false,"text":"普段は神社の巫女らしく年相応に落ち着いていて、穏やかでしとやかな印象を受けるが、こと乳巫女関連になると人が変わる。"},{"spoiler":false,"text":"毎日おっぱいを搾って乳泉神社 特製のお守りを作っていたが、最近聖乳の出が悪くなってきたのを気にしているもよう。"},{"spoiler":false,"text":"「よいですか、右京？　これから貴方は、皆と共に乳巫女修行に勤めるのですよ」"}],"source":"bangumi","sourceCharacterId":"49872"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"49872","value":"乳泉神社、乳巫女の伝統"},{"label":"胸围（本版本）","value":"140 cm","valueContext":null,"source":"egs","sourceCharacterId":"8786","sourceWorkId":"16893","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"t","valueContext":null,"source":"egs","sourceCharacterId":"8786","sourceWorkId":"16893","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"8786","sourceWorkId":"16893","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"110 cm","valueContext":null,"source":"egs","sourceCharacterId":"8786","sourceWorkId":"16893","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"8786","sourceWorkId":"16893","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"hip":[{"comparisonValue":"110","source":"vndb","sourceCharacterId":"c6692","value":"110"},{"comparisonValue":"110","scope":"sourceWork","source":"egs","sourceCharacterId":"8786","sourceWorkId":"15287","value":"110"},{"comparisonValue":"110","scope":"sourceWork","source":"egs","sourceCharacterId":"8786","sourceWorkId":"16893","value":"110"},{"comparisonValue":"11","source":"bangumi","sourceCharacterId":"49872","value":"11"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/0235e54e501d786292452b0d9137c941d98e6190ce38cd7687ee9997ad545378.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c401c50c426f4ab90866b028aeee39c03fd89b6c6c3cb8af4af8c998331e6750.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞森柚子","creatorId":"egs:creator:36244","sourcePersonId":"egs:creator:36244","canonicalEntityId":"egs:creator:36244","name":"瑞森柚子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:365700:49872:25171:1","source":"bangumi"},{"creditedName":"このえ ゆずこ","creatorId":"vndb:s995","sourcePersonId":"vndb:s995","canonicalEntityId":"vndb:s995","name":"このえ ゆずこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45899","source":"vndb"}]},{"characterId":"char_c6697","characterName":"乳泉 鏡華","sourceIds":{"bangumi":[{"characterId":"144407","match":"exact-normalized-name-in-linked-work","subjectId":"365700"}],"egsCharacterIds":["8787"],"vndbCharacterId":"c6697"},"originalCharacterName":"乳泉 鏡華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"216"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"100"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"K"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daughter of Ukyou and Touka. She loves her father."}],"source":"vndb","sourceCharacterId":"c6697"},{"segments":[{"spoiler":false,"text":"燈華と右京の間に出来た愛娘。"},{"spoiler":false,"text":"見た目は母似にて、ちょっとツンとした感じだけど、意外と優しい性格。"},{"spoiler":false,"text":"スタイルも似ておっぱいも大きいし、乳首も一緒で陥没気味。"},{"spoiler":false,"text":"きっと燈華が若い頃は、こんな感じだったと誰しも思う。"},{"spoiler":false,"text":"以前から、一緒にお風呂に入っていたけど、最近の鏡華は、女らしくなった上に、今までにない甘え方をしてくるようになって、その度、ドキドキさせられることも。"}],"source":"egs","sourceCharacterId":"8787","sourceWorkId":"16893","spoiler":false},{"segments":[{"spoiler":false,"text":"好き：お父さん（右京）"},{"spoiler":false,"text":"燈華と右京の間にできた愛娘。 学園2年生。"},{"spoiler":false,"text":"見た目は母に似てちょっとツンとした感じだけど、意外と優しい性格。"},{"spoiler":false,"text":"大きなおっぱいと、陥没気味の乳首も母親譲り。"},{"spoiler":false,"text":"きっと燈華が若い頃はこんな感じだったと、誰しも思う。"},{"spoiler":false,"text":"以前から右京と一緒にお風呂に入っていたが、最近は父親をドキドキさせっぱなし。"},{"spoiler":false,"text":"女らしくなった上に、今までにない甘え方をしてくるようになった。"},{"spoiler":false,"text":"「お父さん、私のおっぱい……洗ってくれる？」"}],"source":"bangumi","sourceCharacterId":"144407"}],"profileFacts":[{"label":"胸围（本版本）","value":"100 cm","valueContext":null,"source":"egs","sourceCharacterId":"8787","sourceWorkId":"16893","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"k","valueContext":null,"source":"egs","sourceCharacterId":"8787","sourceWorkId":"16893","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"8787","sourceWorkId":"16893","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"8787","sourceWorkId":"16893","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"8787","sourceWorkId":"16893","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c292b4902cfc0b04dbbf049cebf04d50700293503fe2c4f21b4592a613992122.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f87f42a3ae5edb4bc4b6c5d3a7194485faaa929ea8e9bfa77c06f36b75e2cc7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞森柚子","creatorId":"egs:creator:36244","sourcePersonId":"egs:creator:36244","canonicalEntityId":"egs:creator:36244","name":"瑞森柚子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:365700:144407:251