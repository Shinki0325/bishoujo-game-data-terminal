bel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:153374","source":"vndb"}]},"cast":[{"characterId":"char_c77587","characterName":"イヴ","sourceIds":{"bangumi":[{"characterId":"68137","match":"exact-normalized-name-in-linked-work","subjectId":"267514"}],"egsCharacterIds":["20682"],"vndbCharacterId":"c77587"},"originalCharacterName":"イヴ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Eve is a young woman who was found unconscious by Yuuma outside his home on a snowy January day. After being taken in and cared for by Yuuma, Eve told him that she would now be at his service as his maid to thank him for his kindness and to finally stop him from living a life full of loneliness and bitterness."},{"spoiler":false,"text":"Eve is a very serious young woman and takes her job very much to heart by doing all the domestic chores, shopping and cooking. Having a rather maternal character, she even manages to be already on the doorstep when Yuuma comes home late at night from work to give her a warm welcome, which makes Yuuma melt with happiness."}],"source":"vndb","sourceCharacterId":"c77587"},{"segments":[{"spoiler":false,"text":"主人公・北見佑馬の下にやってきたメイドさん。"},{"spoiler":false,"text":"日々の暮らしに疲れていた佑馬に『癒し』を与えたいと、佑馬の家で住み込みで仕事をし始める。"},{"spoiler":false,"text":"自分を住まわせてくれた佑馬に恩義を感じていて、精一杯尽そうとしている。"},{"spoiler":false,"text":"見た目に反して知識不足なことが多く、特に自分の感情のことはよくわかっていない。"},{"spoiler":false,"text":"容姿も性格もまさに『理想のメイドさん』だが、実は本人も知らない大きな秘密を抱えている。"}],"source":"egs","sourceCharacterId":"20682","sourceWorkId":"27427","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・北見佑馬の下にやってきたメイドさん。"},{"spoiler":false,"text":"日々の暮らしに疲れていた佑馬に『癒し』を与えたいと、"},{"spoiler":false,"text":"佑馬の家で住み込みで仕事をし始める。"},{"spoiler":false,"text":"自分を住まわせてくれた佑馬に恩義を感じていて、"},{"spoiler":false,"text":"精一杯尽そうとしている。"},{"spoiler":false,"text":"見た目に反して知識不足なことが多く、"},{"spoiler":false,"text":"特に自分の感情のことはよくわかっていない。"},{"spoiler":false,"text":"容姿も性格もまさに『理想のメイドさん』だが、"},{"spoiler":false,"text":"実は本人も知らない大きな秘密を抱えている。"},{"spoiler":false,"text":"「これからも、ご主人様を癒やして差し上げたいと思います。ぜひ、ご遠慮なく、どんなことでもお申し付けくださいませ」"}],"source":"bangumi","sourceCharacterId":"68137"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f60f863b2c23ef2a084b13384fc4a39531c57ada2ea0198bcbc8eebe58ded989.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9bad3dc36551d9c5f8333dddbbf1546f71cfed9d8fe7fe8c807fd25bdc926a5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:267514:68137:4937:1","source":"bangumi"}]},{"characterId":"char_vndb_c82113","characterName":"相川","sourceIds":{"vndbCharacterId":"c82113"},"originalCharacterName":"相川","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aikawa is a young adult who is hardly younger or older than Yuuma who hangs around her house. She seems to have a connection with Eve and her work as a maid but we don't really know."},{"spoiler":true,"text":"Aikawa is the scientist who created Eve, she considers herself as Eve's mother and even wrote her name in her family notebook."}],"source":"vndb","sourceCharacterId":"c82113"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8b42cdf469808b6fcdeda9bd75f55fb5a8bf5439e4e676fcd5a2ad6a4d8881d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb701b6f18b6e6ee4918bcdc3d954e3b037120bd3c1d941638097a61a1216f9e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"飴川 紫乃","creatorId":"vndb:s15910","sourcePersonId":"vndb:s15910","canonicalEntityId":"vndb:s15910","name":"小澤 みのり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:79663","source":"vndb"}]},{"characterId":"char_vndb_c82647","characterName":"北見 佑馬","sourceIds":{"vndbCharacterId":"c82647"},"originalCharacterName":"北見 佑馬","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuma is a young man who is an office worker. He is quite tired of his daily routine, which can only be reduced to work and the time it takes to get home from work. He starts to despair because he is tired of loneliness and wants to fall in love."},{"spoiler":false,"text":"One snowy day in early January, Yuuma found an older girl in a maid uniform collapsed in front of his house. Her name was Eve and she told him that from that day she would be there to comfort him from the stress of daily life."}],"source":"vndb","sourceCharacterId":"c82647"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/738094216c23245a6b3d71539ed2a50cb84ea03620a11e757a92715907ba7407.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89bfdb4fd6d4c621afca5