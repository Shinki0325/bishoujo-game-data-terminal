calEntityId":"egs:creator:17895","name":"のねむはろわ","detail":"ムービー","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:112993","source":"egs"},{"creditedName":"子川忠","creatorId":"egs:creator:17900","sourcePersonId":"egs:creator:17900","canonicalEntityId":"egs:creator:17900","name":"子川忠","detail":"ディレクター","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:135040","source":"egs"},{"creditedName":"トーマス・リー","creatorId":"egs:creator:19836","sourcePersonId":"egs:creator:19836","canonicalEntityId":"egs:creator:19836","name":"トーマス・リー","detail":"プロデューサー","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:135041","source":"egs"},{"creditedName":"ヒマリ","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:65326","source":"vndb"},{"creditedName":"奥山 歩","creatorId":"vndb:s857","sourcePersonId":"vndb:s857","canonicalEntityId":"vndb:s857","name":"平松 真奈実","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:65327","source":"vndb"}]},"cast":[{"characterId":"char_c54359","characterName":"苗場 朗","sourceIds":{"bangumi":[],"egsCharacterIds":["10705"],"vndbCharacterId":"c54359"},"originalCharacterName":"苗場 朗","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Student of class 2-C, member of the Volunteer Department. An exceptional guy with great grades and a professional in athletic activities. He doesn't have a purpose just as an average student and member, but he will stand up to protect his club from his sister as a result of her twisted proposition to endanger school clubs."},{"spoiler":false,"text":"He is unable to use magic, but he is a skilled battler. But he appears to have the power to strip bras and undergarments from other people with the snap of his fingers."},{"spoiler":false,"text":"He plays the role of hit and run in the team."}],"source":"vndb","sourceCharacterId":"c54359"},{"segments":[{"spoiler":false,"text":"本作の主人公にして、みんなから弟扱いされる少し可哀想な子。"},{"spoiler":false,"text":"勉強は学年でトップを取り、運動能力も非常に高い。"},{"spoiler":false,"text":"基本的にマルチな才能の持ち主で、非常に優秀……なのだが、絶対的な姉や、周りの人間も何かしら秀でているせいで常に日陰者。"},{"spoiler":false,"text":"そのせいか、ややひねくれた性格をしている。"},{"spoiler":false,"text":"現在は姉が部活に入っていないことから、自分は旧知の人間がいたボランティア部に入部しており、毎日部活に顔を出したりしては特に目的も無く毎日を過ごしていた。"},{"spoiler":false,"text":"だが、今回の騒動を切っ掛けに姉の暴走を止めるため、立ち上がる事になる。"},{"spoiler":false,"text":"なお、本作で唯一『魔法少女』に変身しないで魔法を使える人物。"},{"spoiler":false,"text":"とはいえ、ご大層な名前の割には相手のブラのホックを外すくらいの事しか出来ない、見かけ倒しな魔法。"}],"source":"egs","sourceCharacterId":"10705","sourceWorkId":"14808","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62194e23c57dbd642d6470b587446db96424da97932a8fe164b2c1f22b7f8c52.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02c71d630c9c48364240ddd4f41ccaf35822f310eb7d592c5e7d95ca50cbb509.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c54351","characterName":"最凶外道","sourceIds":{"vndbCharacterId":"c54351"},"originalCharacterName":"最凶外道","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Student of class 3-B and the school's representative. The protagonist's elder sister. She is by far the most exceptional student with incredible scores and records."},{"spoiler":false,"text":"She likes to coerce her brother into doing humiliating stuff, but at school she is a respectful girl loved by everyone. But ever since she becomes the school's representative, her personality becomes very malevolent."}],"source":"vndb","sourceCharacterId":"c54351"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1ebaf1e567912e7a2aaa74e31ef747f51373a8eca9a41e2131fa8566f2bed21f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3c053ebf73eb8502b132fe042b677da509e182b02406f713cda8f5bf3db5225.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ヒマリ","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36467","source":"vndb"}]},{"characterId":"char_vndb_c54352","characterName":"三条 綾女","sourceIds":{"vndbCharacterId":"c54352"},"originalCharacterName":"三条 綾女","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Student of class 1-B. Manager of the Volunteer Department."},{"spoiler":false,"text":"For her young age, she is a gifted prodigy with great smarts that can rival Hikari's. Though, Sanjou's personality is not as bright as she looks and she's sometimes reckless who often expresses through action rather than words."}],"source":"vndb","sourceCharacterId":"c54352"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba0692845974a53ca5e5d0e9028bd489e3898cb13d09cd37bbe25c06702c62ac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6466ea3175dc622ef1c9810310fc221c55d23a45d