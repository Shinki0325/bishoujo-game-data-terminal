wState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園で教頭を務め、理事長とは親戚に関係にある女性。"},{"spoiler":false,"text":"世間体や体面を非常に気にするタイプで、自分より下の者、劣っている者には、大きな態度をとる。"},{"spoiler":false,"text":"「私の言うことがわかっているのかしら？　全く無能ね！」"}],"source":"egs","sourceCharacterId":"19228","sourceWorkId":"9856","spoiler":false},{"segments":[{"spoiler":false,"text":"教頭。世間体や対面を気にしているタイプ。"},{"spoiler":false,"text":"下の人間には大きな態度をとる。理事長とは親戚関係。"}],"source":"bangumi","sourceCharacterId":"94032"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/772d75932846678ef7fdf0185773fb11dd63253710cc6ad1e3a3e5956dd5c983.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f49ff705f9d8db0027679d177ca582db891bc3562bd63b4598836278659cc94.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"志方馨","creatorId":"vndb:s3107","sourcePersonId":"vndb:s3107","canonicalEntityId":"vndb:s3107","name":"志方 馨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230766:94032:36447:1","source":"bangumi"}]},{"characterId":"char_c59099","characterName":"東屋 照代","sourceIds":{"bangumi":[{"characterId":"94033","match":"exact-normalized-name-in-linked-work","subjectId":"230766"}],"egsCharacterIds":["19232"],"vndbCharacterId":"c59099"},"originalCharacterName":"東屋 照代","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"優しい養護教諭。"},{"spoiler":false,"text":"癒し系で献身的な性格なため、男女問わず、生徒から人気がある。"},{"spoiler":false,"text":"健気な夕実を実の妹のように可愛がっていているが……。"},{"spoiler":false,"text":"「六条先生。今日はどうしたんですか？　顔色が悪いですよ」"}],"source":"egs","sourceCharacterId":"19232","sourceWorkId":"9856","spoiler":false},{"segments":[{"spoiler":false,"text":"保険医（養護教諭）。優しく献身的な性格で男女問わず生徒の人気も高い。"},{"spoiler":false,"text":"癒し系だが芯の強いタイプ。精神的に疲れている夕実の心配をよくしている。"},{"spoiler":false,"text":"健気な夕実を実の妹のように可愛がっている。"}],"source":"bangumi","sourceCharacterId":"94033"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00d0a069e60f178f5e13080d967c80d5464d44b4a24cd11ad49d0c57b7ae76a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd57304fefa827f2fc407c049f074f1ec428f1d8065b0d660405931f69175c13.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"酒井 たから","creatorId":"vndb:s7490","sourcePersonId":"vndb:s7490","canonicalEntityId":"vndb:s7490","name":"酒井 たから","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:44405","source":"vndb"}]},{"characterId":"char_c59100","characterName":"横川 紀子","sourceIds":{"bangumi":[{"characterId":"94034","match":"exact-normalized-name-in-linked-work","subjectId":"230766"}],"egsCharacterIds":["19231"],"vndbCharacterId":"c59100"},"originalCharacterName":"横川 紀子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"横川姉妹の母親で、PTA会長を務める人妻。"},{"spoiler":false,"text":"常にリーダーシップを取りたがり、生徒が何か問題を起こすと細かいことにまで口うるさく言ってくる"},{"spoiler":false,"text":"規律にうるさく、厳しいキッチリタイプ。"},{"spoiler":false,"text":"一方で、夫の前では甘えた感じで丸くなる面も併せ持つ。"},{"spoiler":false,"text":"「もう少し先生方がしっかりしてくれないと、ダメじゃないですか！」"}],"source":"egs","sourceCharacterId":"19231","sourceWorkId":"9856","spoiler":false},{"segments":[{"spoiler":false,"text":"PTA会長。常にリーダーシップを取っていくキャリアウーマンタイプ。"},{"spoiler":false,"text":"規則に厳しく生徒などに問題が起こると何かにつけて細かい事まで口うるさく言ってくる。"},{"spoiler":false,"text":"外ではキッチリしたタイプだが、夫の前では甘えた感じで丸くなる。"},{"spoiler":false,"text":"華道をやっているが、かなりのモノらしい。娘にも薦めて習わせていたが、不精の梓は無理だった。"}],"source":"bangumi","sourceCharacterId":"94034"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c0cc0d633707f346905319785db8bcda49405e889776c53a4b1753230c82968.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03c4435f8152a656d1e323df60095aa820ea7f579db93b54402f49631a8e6b81.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"比未子","creatorId":"vndb:s1499","sourcePersonId":"vndb:s1499","canonicalEntityId":"vndb:s1499","name":"比未子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230766:94034:18171:1","source":"bangumi"}]},{"characterId":"char_c59102","characterName":"横川 梓","sourceIds":{"bangumi":[{"characterId":"94035","match":"exact-normalized-name-in-linked-work","subjectId":"230766"}],"egsCharacterIds":["19229"],"vndbCharacterId":"c59102"},"originalCharacterName":"横川 梓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"紀子の娘で、聖の双子の姉。"},{"spoiler":false,"text":"明るく活発、スポーツ万能少女だが、反面勉強は苦手で、授業もすぐサボりたがる。"},{"spoiler":false,"text":"葵とは親友の間柄。"},{"spoiler":false,"text":"「照代ちゃん。ベット空いてるかなぁ？　授業疲れちゃったぁ」"}],"source":"egs","sourceCharacterId":"19229","sourceWorkId":"9856","spoiler":false},{"segments":[{"spoiler":false,"text":"紀子の娘での双子の姉。明るく活発なスポーツ万能娘。"},{"spoiler":false,"text":"勉強は苦手で、すぐに授業をサボりたがる。すぐに調子に乗って悪ノリする事もあるが、本人に悪気はない。"},{"spoiler":false,"text":"恋愛経験がなく純情だが、一度火がつくと勢いで一気にいってしまうタイプ。"},{"spoiler":false,"text":"陸上部に所属している。葵とは親友同士。"}],"source":"bangumi","sourceCharacterId":"94035"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/image