eight":256,"source":"static-detail"},"actors":[{"creditedName":"由宇翼","creatorId":"vndb:s1420","sourcePersonId":"vndb:s1420","canonicalEntityId":"vndb:s1420","name":"由宇 翼","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230766:94036:18193:1","source":"bangumi"}]},{"characterId":"char_c59104","characterName":"沢辺 夕実","sourceIds":{"bangumi":[{"characterId":"94037","match":"exact-normalized-name-in-linked-work","subjectId":"230766"}],"egsCharacterIds":["19227"],"vndbCharacterId":"c59104"},"originalCharacterName":"沢辺 夕実","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"健気で幸薄い少女。"},{"spoiler":false,"text":"理事長は育ての親で、彼には感謝している様子。"},{"spoiler":false,"text":"明るく振る舞ってはいるものの、何かを秘めている雰囲気が見え隠れしている。"},{"spoiler":false,"text":"実はかなりの苦労人で、波乱万丈の人生を送ってきたようだが……。"},{"spoiler":false,"text":"「先生！　おはようございます！　大丈夫ですか？　顔色悪いですよ」"}],"source":"egs","sourceCharacterId":"19227","sourceWorkId":"9856","spoiler":false},{"segments":[{"spoiler":false,"text":"苦労人で波乱万丈の人生を送ってきているが健気に明るく振舞っているが、何かを秘めている雰囲気。"},{"spoiler":false,"text":"育ての親である理事長には感謝している。テニス部に所属。"}],"source":"bangumi","sourceCharacterId":"94037"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56ad81789abe3e0dee17cca1c0e8f316d6d1e6a5adfd99acf74306aa084d0a97.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4127e6c3ed08f62fbabb6f710c251aa8395cbfc7ba40ceb523c00f050b848e3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天川なぎ","creatorId":"vndb:s5101","sourcePersonId":"vndb:s5101","canonicalEntityId":"vndb:s5101","name":"天川なぎ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:44403","source":"vndb"}]},{"characterId":"char_c59105","characterName":"佐田 葵","sourceIds":{"bangumi":[{"characterId":"94038","match":"exact-normalized-name-in-linked-work","subjectId":"230766"}],"egsCharacterIds":["19225"],"vndbCharacterId":"c59105"},"originalCharacterName":"佐田 葵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"理事長自慢の一人娘で、主人公のメインターゲットの一人。"},{"spoiler":false,"text":"学園では水泳部に所属し、生徒会長も務める。"},{"spoiler":false,"text":"箱入り娘らしく高飛車な性格だが、面倒見も良いため、生徒からは慕われている。"},{"spoiler":false,"text":"父が大好きで、独占したいと思っているようだが……。"},{"spoiler":false,"text":"「わたくし、そんなこと認めませんわ！」"}],"source":"egs","sourceCharacterId":"19225","sourceWorkId":"9856","spoiler":false},{"segments":[{"spoiler":false,"text":"箱入りお嬢様で理事長の自慢の一人娘。"},{"spoiler":false,"text":"高飛車な性格だが、しっかりしていて面倒見はいいので生徒たちには慕われている様子。"},{"spoiler":false,"text":"学園では生徒会長をしている。父親が大好きで独占したいと思っている。"}],"source":"bangumi","sourceCharacterId":"94038"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c96e5532da23acddc317acb427b2a1cc8c801c0fc28f16cbb7e299b799f99120.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab564519af288be173d5b21f742a43cf1126d0bf4e943d9d62443b07b58f9ed1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天天","creatorId":"vndb:s2922","sourcePersonId":"vndb:s2922","canonicalEntityId":"vndb:s2922","name":"天天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230766:94038:18086:1","source":"bangumi"}]},{"characterId":"char_c59106","characterName":"佐田 裕香","sourceIds":{"bangumi":[{"characterId":"94039","match":"exact-normalized-name-in-linked-work","subjectId":"230766"}],"egsCharacte