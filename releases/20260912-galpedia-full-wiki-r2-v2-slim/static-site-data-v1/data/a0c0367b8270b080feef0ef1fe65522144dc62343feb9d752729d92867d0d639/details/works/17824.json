{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"17824","model":{"presentationWorkId":"vndb:v11695","staff":{"artwork":[{"creditedName":"鋼丸(鋼丸R、鋼丸S、鋼丸SS)","creatorId":"vndb:s6952","sourcePersonId":"egs:creator:444","canonicalEntityId":"vndb:s6952","name":"鋼丸(鋼丸R、鋼丸S、鋼丸SS)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:111361","source":"egs"}],"scenario":[{"creditedName":"ししいふとし","creatorId":"vndb:s39993","sourcePersonId":"egs:creator:17764","canonicalEntityId":"vndb:s39993","name":"ししいふとし","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:111360","source":"egs"}],"music":[{"creditedName":"Joke Drops(JokeDrops)","creatorId":"egs:creator:16738","sourcePersonId":"egs:creator:16738","canonicalEntityId":"egs:creator:16738","name":"Joke Drops(JokeDrops)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:113270","source":"egs"},{"creditedName":"Joke Drops","creatorId":"vndb:s5622","sourcePersonId":"vndb:s5622","canonicalEntityId":"vndb:s5622","name":"Joke Drops","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:94907","source":"vndb"},{"creditedName":"奏森 愛","creatorId":"vndb:s3801","sourcePersonId":"vndb:s3801","canonicalEntityId":"vndb:s3801","name":"盛合 千鶴子","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:94909","source":"vndb"}],"other":[]},"cast":[{"characterId":"char_c31640","characterName":"奥村 真央","sourceIds":{"bangumi":[{"characterId":"46815","match":"exact-normalized-name-in-linked-work","subjectId":"78477"}],"egsCharacterIds":["4745"],"vndbCharacterId":"c31640"},"originalCharacterName":"奥村 真央","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"１年生。帰宅部。"},{"spoiler":false,"text":"明るく、子犬のような人懐っこい性格。"},{"spoiler":false,"text":"口下手で、焦るとよく言い間違いなどで相手を困惑させる。"},{"spoiler":false,"text":"お嬢様学校に入ったからには、何か没頭出来るものでもないかと常に探している。"},{"spoiler":false,"text":"差し当たり、自称帰宅部部長として、勝手に一人で帰宅時間の記録などを行ったりしている。"},{"spoiler":false,"text":"お菓子大好き。新商品チェックはかかさない。"},{"spoiler":false,"text":"友達想いであり、ケンカの仲裁などにはよく入る。"},{"spoiler":false,"text":"しかし口下手な為効果的な仲裁になることは少ないが、空気がやわらぎ、結果として解決することも多い。"},{"spoiler":false,"text":"セックスに興味がないわけではないが、自分にはまだ早いかな？などと根拠もなく考えている。"}],"source":"egs","sourceCharacterId":"4745","sourceWorkId":"17824","spoiler":false},{"segments":[{"spoiler":false,"text":"明るく、子犬のように人懐っこい性格。"},{"spoiler":false,"text":"お菓子が大好きで、新商品のチェックは欠かさない。"},{"spoiler":false,"text":"口下手だが友達思いの天然系。"},{"spoiler":false,"text":"お嬢様学園に入ったからには、何か没頭できるものでもないかと常に探している。"},{"spoiler":false,"text":"性的な話題には食いつくが、セックスはまだ自分には早いと考えている。"}],"source":"bangumi","sourceCharacterId":"46815"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38041f7058a67ba2507fc1c915eb1bb1eea545efe744ef76eb7b61ee4496774a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76974ee6fd0d591091b489849e3be0ba8e55ec6d462bb108d885c9b446efb189.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:78477:46815:11646:1","source":"bangumi"}]},{"characterId":"char_c31641","characterName":"秋山 華音","sourceIds":{"bangumi":[{"characterId":"46816","match":"exact-normalized-name-in-linked-work","subjectId":"78477"}],"egsCharacterIds":["4746"],"vndbCharacterId":"c31641"},"originalCharacterName":"秋山 華音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"2年生。JKアイドル。"},{"spoiler":false,"text":"おバカで生意気。『現役ＪＫアイドル』として活動。"},{"spoiler":false,"text":"歌唱力、ダンス力、ルックス全て抜群。アイドルとして非の打ちどころなし。"},{"spoiler":false,"text":"自分が楽しいこと、目立つこと、褒められること、自分の力が認められること、それにより成果が出ることが好き。"},{"spoiler":false,"text":"日常では生意気な性格が目立つが、それも『自分が楽しいこと』を追求した結果。"},{"spoiler":false,"text":"ずさんで後かたずけが出来ない。楽屋などはちらかしっぱなし。"},{"spoiler":false,"text":"セックスは普通に愛し合った男性としたい、という女性らしい一面がある。"},{"spoiler":false,"text":"口淫は経験済み。\"ご奉仕\"と称して、業界人やクライアントに\"ご奉仕\"することで仕事を勝ち取ることも。"},{"spoiler":false,"text":"口淫テクは相当のもの。自らで勉強し、手コキなども習得済み。"}],"source":"egs","sourceCharacterId":"4746","sourceWorkId":"17824","spoiler":false},{"segments":[{"spoiler":false,"text":"おバカで生意気。 “現役JKアイドル” として活動中。"},{"spoiler":false,"text":"歌唱力、ダンス力、ルックスすべて抜群。 アイドルとして非の打ち所なし。"},{"spoiler":false,"text":"仕事が楽しく、学生でいる必要性が見出せないでいる。"},{"spoiler":false,"text":"後片付けが出来ないずさんな性格。"},{"spoiler":false,"text":"仕事を勝ち取るために覚えた口淫ご奉仕テクは相当なもので、手コキなども習得済み。"}],"source":"bangumi","sourceCharacterId":"46816"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38b162690411f0b5c923730837212b936535d61842cd7644547d0e26167f5bd4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae4bdb766ace453da619737aeca910d6dd71214187bba89e24e9e6882ee4b63d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"落合周","creatorId":"vndb:s3702","sourcePersonId":"vndb:s3702","canonicalEntityId":"vndb:s3702","name":"落合 周","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:78477:46816:25371:1","source":"bangumi"}]},{"characterId":"char_c31642","characterName":"三浦 琴子","sourceIds":{"bangumi":[{"characterId":"46817","match":"exact-normalized-name-in-linked-work","subjectId":"78477"}],"egsCharacterIds":["4747"],"vndbCharacterId":"c31642"},"originalCharacterName":"三浦 琴子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"2年生。紗英の姉。"},{"spoiler":false,"text":"しっかり者。頭もよく優等生。真面目が過ぎてしまい、融通がきかないことも。"},{"spoiler":false,"text":"茶道部所属。静かで落ち着いた雰囲気が好きだが、妹の体調の手前、あまり部活の出席は出来ていない。"},{"spoiler":false,"text":"両親は死亡。彼らの遺産でどうにか経済面は心配なさそうだが、生活面では琴子が妹を支えるしかない。"},{"spoiler":false,"text":"妹を想う余り、時にきつく叱りつけたりすることもある。"},{"spoiler":false,"text":"セックスは時期が来ればいずれ…ぐらいの意識。"},{"spoiler":false,"text":"エッチな話については、興味があり、常に聞きたがっているが、多人数でしゃべっているときには、\"優等生\"のレッテルのせいで入りづらい。"}],"source":"egs","sourceCharacterId":"4747","sourceWorkId":"17824","spoiler":false},{"segments":[{"spoiler":false,"text":"紗英の姉。 両親はすでに他界している。"},{"spoiler":false,"text":"静かで落ち着いた雰囲気が好きで、茶道部に所属しているものの、妹が病気で部活にはあまり出席できていない。"},{"spoiler":false,"text":"頭が良く優等生。 まじめが過ぎてしまい、融通が利かないこともある。"},{"spoiler":false,"text":"胸は控えめで、紗英を羨ましく感じている。"},{"spoiler":false,"text":"セックスはいずれ自然に……程度の意識。"}],"source":"bangumi","sourceCharacterId":"46817"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f723e5608eb6ad6143016b1ec1eb76f4494b63e429ded65ecfaf5243b3eafcd3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e174647bbe8734aebb6008d94eb5c364ad823b119c93dad441a0c4b7040e136a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤宮菜穂","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:78477:46817:6019:1","source":"bangumi"}]},{"characterId":"char_c31643","characterName":"三浦 紗英","sourceIds":{"bangumi":[{"characterId":"46818","match":"exact-normalized-name-in-linked-work","subjectId":"78477"}],"egsCharacterIds":["4748"],"vndbCharacterId":"c31643"},"originalCharacterName":"三浦 紗英","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"１年生。琴子の妹。"},{"spoiler":false,"text":"病弱。いつも姉に守られてきたせいか甘えん坊。泣き虫。"},{"spoiler":false,"text":"しかし頑張り屋でもあり、いざというときの行動力はある。"},{"spoiler":false,"text":"ただ、体や実力が伴わないことがしばしばあり、とても落ち込む。"},{"spoiler":false,"text":"おしゃべりが好き。基本聞き役に周りがちだが、真央とはよく合う。"},{"spoiler":false,"text":"体の割に無茶をしたくなることもあり、琴子によくとがめられる。"},{"spoiler":false,"text":"セックスについては想像もつかない。"},{"spoiler":false,"text":"セックスの話題なんかが出ると、よくわからず、また恥ずかしい為、口をつぐんでしまう。"}],"source":"egs","sourceCharacterId":"4748","sourceWorkId":"17824","spoiler":false},{"segments":[{"spoiler":false,"text":"おしゃべりが好き。 甘えん坊で泣き虫だが、頑張り屋でもある。"},{"spoiler":false,"text":"行動力自体はあるものの、体力や実力が伴わないことがしばしばで、健康な普通の生活を望んでいる。"},{"spoiler":false,"text":"性的な話題はよく分からず、また恥ずかしくて口をつぐんでしまう。"},{"spoiler":false,"text":"琴子よりも胸が大きいことを申し訳なく思いつつも、若干自慢に思っている。"}],"source":"bangumi","sourceCharacterId":"46818"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4ae8115931bc5a40e61984916cc4969844aba9cf93c3b2fd5bc944a2bc0dd099.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/5391bf766d88663c49d087bfddcd7709ae2e3dad93441f1201d4f619623c4dfb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西野ゆみこ","creatorId":"vndb:s934","sourcePersonId":"vndb:s934","canonicalEntityId":"vndb:s934","name":"西野 ゆみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:78477:46818:14142:1","source":"bangumi"}]},{"characterId":"char_c31644","characterName":"本間 雪乃","sourceIds":{"bangumi":[{"characterId":"46819","match":"exact-normalized-name-in-linked-work","subjectId":"78477"}],"egsCharacterIds":["4749"],"vndbCharacterId":"c31644"},"originalCharacterName":"本間 雪乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"3年生。貧乳少女。"},{"spoiler":false,"text":"一人でいるのが好き。物事を俯瞰的に見たがる。"},{"spoiler":false,"text":"クラスでもそこまで目立たない存在だが、アンニュイな雰囲気が魅力的と一部の女子に人気。"},{"spoiler":false,"text":"小説や映画を一人で楽しむのが趣味。"},{"spoiler":false,"text":"作品を見ては、自論を展開し、自分の中でほくそ笑む。"},{"spoiler":false,"text":"小説を読みながら、他者の会話を盗み聞きするのも楽しい。"},{"spoiler":false,"text":"セックスは機会が無い為、興味もない。"},{"spoiler":false,"text":"貧乳。すごく気にしているが、ブラをしても落ちてしまうのでしていない。"}],"source":"egs","sourceCharacterId":"4749","sourceWorkId":"17824","spoiler":false},{"segments":[{"spoiler":false,"text":"クラスでもあまり目立たないが、アンニュイな雰囲気が魅力的と一部の女子に人気。"},{"spoiler":false,"text":"気分屋で独りでいるのが好き。"},{"spoiler":false,"text":"小説や映画を一人で楽しむのが趣味で、自論を展開しては自分の中でほくそ笑んでいる。"},{"spoiler":false,"text":"ブラをしても落ちてしまうので、いつもしていないほどの貧乳。 本人はすごく気にしている。"},{"spoiler":false,"text":"機会が無いためセックスには興味がない。"}],"source":"bangumi","sourceCharacterId":"46819"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2ad6a045689bda53f9e33b15ab04d6eaaff53415f3bd678b977ca0f48c2bed5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1ef445634ac24ec173c29c892326ec732146f185a3888c53863f44720eeaea1b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘志穂","creatorId":"vndb:s738","sourcePersonId":"vndb:s738","canonicalEntityId":"vndb:s738","name":"橘 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:78477:46819:7169:1","source":"bangumi"}]},{"characterId":"char_c31645","characterName":"夏目 麗香","sourceIds":{"bangumi":[{"characterId":"46820","match":"exact-normalized-name-in-linked-work","subjectId":"78477"}],"egsCharacterIds":["4750"],"vndbCharacterId":"c31645"},"originalCharacterName":"夏目 麗香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"3年生。大物政治家の娘。"},{"spoiler":false,"text":"趣味は風呂、男とのお食事会。"},{"spoiler":false,"text":"父のような野心溢れる男が好き。"},{"spoiler":false,"text":"自分さえ良ければ良いという典型的自己中。"},{"spoiler":false,"text":"トラブルは全て親の力で何とかなると思っているし、自分に刃向う者なんていないと思っている。"},{"spoiler":false,"text":"また、男にはモテる為、自尊心は尊大になるばかり。"},{"spoiler":false,"text":"しかし未だ自分にふさわしい男性は現れていないため、体も心も許したことがない。"},{"spoiler":false,"text":"実は生まれ持っての打たれ弱さがあり、自分が不利になると弱い。"},{"spoiler":false,"text":"自分にふさわしい男との行為まで処女は大事にしてある。"}],"source":"egs","sourceCharacterId":"4750","sourceWorkId":"17824","spoiler":false},{"segments":[{"spoiler":false,"text":"大物政治家の娘。 趣味は風呂、男とのお食事会。"},{"spoiler":false,"text":"自分さえ良ければよいという典型的自己中。"},{"spoiler":false,"text":"ただし生まれ持っての打たれ弱さがあり、自分が不利になると弱い。"},{"spoiler":false,"text":"ファザコンで、父親のような野心あふれる男が好き。"},{"spoiler":false,"text":"巨乳であることを誇りに思っている。"},{"spoiler":false,"text":"自分にふさわしい男との行為まで処女を大事に守っている。"}],"source":"bangumi","sourceCharacterId":"46820"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c51439650d908f6cef783c53104615f322168a1542072b76221324763dda6454.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e85271bbe283526238b5c5f84e72577eaacf0c4ad660b25e83e8c81ab2571ba8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和泉忍","creatorId":"vndb:s1623","sourcePersonId":"vndb:s1623","canonicalEn