ce":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ゲームのメインヒロイン。"},{"spoiler":false,"text":"中流家庭で何不自由なく幸せに育った優等生で、学園のアイドル的存在。"},{"spoiler":false,"text":"学園生の代表で組織する自治委員会の委員長でもある。"},{"spoiler":false,"text":"清純で、誰にでも優しく、困っている人を見ると放っておけない。"},{"spoiler":false,"text":"頭脳明晰、母性的で潔癖症。正義感が強く、"},{"spoiler":false,"text":"スイートナイツとなって学園を守る ことに強い使命感を持っている。"},{"spoiler":false,"text":"将来は外交官を目指しており、難民を救うために尽くしたいと考えている。"},{"spoiler":false,"text":"国際上級官僚を育成する総合部国際科に属している。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"2055","spoiler":false},{"segments":[{"spoiler":false,"text":"『魔法戦士スイートナイツ』のヒロイン。"},{"spoiler":false,"text":"清楚で正義感の強いスイートナイツの中心的存在。"},{"spoiler":false,"text":"メッツァーに対して敵同士以上の想いがある。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"10418","spoiler":false},{"segments":[{"spoiler":false,"text":"第一世代魔法戦士のリーダー格。"},{"spoiler":false,"text":"現在はかつての学び舎である国際教導学園に復学し、外交官となるための勉強を続けながら、特別講師として時折後輩たちのために教鞭を執っている。"},{"spoiler":false,"text":"明るく積極的な性格で、誰からも好かれる優等生。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"17330","spoiler":false},{"segments":[{"spoiler":false,"text":"メッツァーの宿敵。"},{"spoiler":false,"text":"清純な容姿と純真な正義の心に、淫らな肉体を併せ持つ美しい戦士。"},{"spoiler":false,"text":"一度覚えてしまった被虐の悦びからは二度と逃げられない……。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"18638","spoiler":false},{"segments":[{"spoiler":false,"text":"「こんな自分にはもう、魔法戦士の資格なんてないのかも……」"},{"spoiler":false,"text":"スイートナイツの一人。"},{"spoiler":false,"text":"現在地上で活動している魔法戦士たちのリーダー格。"},{"spoiler":false,"text":"明るく積極的な性格で、誰からも好かれる優等生。"},{"spoiler":false,"text":"国際教導学園で特別講師を務めていたが、講師退任後行方が分からなくなっている。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士スイートナイツ」ほか"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士のリーダー格の一人。"},{"spoiler":false,"text":"明るく積極的な性格で、誰からも好かれる優等生。"},{"spoiler":false,"text":"以前の戦いで、悪の野望を防ぐためにゲートに飛び込み、取り込まれたままいまだ帰還していない。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"26584","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士スイートナイツのリーダー、スイートリップ。本名は七瀬凛々子。"},{"spoiler":false,"text":"世界の支配を企む悪と戦い続けてきた歴戦の魔法戦士。その優しさと悪に屈することない強さで他の魔法戦士たちからも慕われている。"},{"spoiler":false,"text":"以前の戦いでゲートと呼ばれる魔導演算装置に取り込まれ、しばらくの間消息不明となっていたが、仲間たちによって無事救出される。"},{"spoiler":false,"text":"しかし、異空間に長期間囚われたことで、彼女は戦うための力を失ってしまう。 現在は国際教導学園の学生として、自身の次の道を模索している。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"スイートナイツの一人、魔法戦士スイートリップ。"},{"spoiler":false,"text":"現在は特別魔法外交官として活躍している。"},{"spoiler":false,"text":"かつて倒した悪の組織の残党が暗躍しているという情報を聞き、調査へと赴く。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"37809","spoiler":false},{"segments":[{"spoiler":false,"text":"ゲームのメインヒロイン。"},{"spoiler":false,"text":"中流家庭で何不自由なく幸せに育った優等生で、 学園のアイドル的存在。学園生の代表で組織する 自治委員会の委員長でもある。"},{"spoiler":false,"text":"清純で、誰にでも優しく、困っている人を見ると 放っておけない。頭脳明晰、母性的で潔癖症。正義感が強く、スイートナイツとなって学園を守る ことに強い使命感を持っている。"},{"spoiler":false,"text":"将来は外交官を目指しており、難民を救うために 尽くしたいと考えている。国際上級官僚を育成す る総合部国際科に属している。"}],"source":"bangumi","sourceCharacterId":"96131"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a55f22b1500af098caa60ce65d63437402b9533e4ccf14fd5f2b6885b1dece56.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93e929f8899aaac84d2e6c72f4e17d6fda8fad73948c4bd180803979c036d637.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽月理恵","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222239:96131:5907:1","source":"bangumi"}]},{"characterId":"char_c33542","characterName":"彩姫 くるみ","sourceIds":{"bangumi":[{"characterId":"96151","match":"exact-normalized-name-in-linked-work","subjectId":"222234"}],"egsCharacterIds":["15750"],"vndbCharacterId":"c33542"},"originalCharacterName":"彩姫 くるみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔法戦士レムティアシータ"},{"spoiler":false,"text":"私立白耀学園の生徒会執行部員にして白耀学園最強の魔法戦士。"},{"spoiler":false,"text":"昔その力をコントロールできず放出してしまい街を一時的に機能停止させた事から、その力を使う事を拒んでいた。"},{"spoiler":false,"text":"しかし学園執行部員の説得と協力により今では執行部が持つ切り札としての抑止力となる。"},{"spoiler":false,"text":"学園執行部員達を心から尊敬している。"}],"source":"egs","sourceCharacterId":"15750","sourceWorkId":"12050","spoiler":false},{"segments":[{"spoiler":false,"text":"国際教導学園・現代文学科に通う学生。"},{"spoiler":false,"text":"清楚な雰囲気、丁寧で優しげな物腰、黙っていても目立ってしまう端麗な容姿を持つ聡明な少女。"},{"spoiler":false,"text":"魔法戦士の存在を噂程度には知っていて、秘かに憧れを持っていた。"},{"spoiler":false,"text":"正義感や人の役に立ちたいという思いが強く、クイーンティアナに与えられた力と白薔薇の助力によって魔法戦士となる。"}],"source":"bangumi","sourceCharacterId":"96151"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e66a3d7aeb9bc45d84e30aee81b2e3e1601ed43a2c62f32d4c2cf2ccd9009878.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0ab609ad9384029a7de08822ce5f629596553e24ed25d8e60f8ee430ce21a40b.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222239:96151:6349:1","source":"bangumi"}]},{"characterId":"char_c35715","characterName":"エンシェル・レナ","sourceIds":{"bangumi":[],"egsCharacterIds":["7975"],"vndbCharacterId":"c35715"},"originalCharacterName":"エンシェル・レナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ゲームの主人公。"},{"spoiler":false,"text":"地上の人間には極めて珍しい、エンシェリウムカードを使うことの 出来る能力者『エンシェリアン』。"},{"spoiler":false,"text":"街を歩くとイヤでも目立つほどの美少女で、全校男子の憧れのような存在だが、目立つことが嫌いで控えめな優等生。"},{"spoiler":false,"text":"勉強は出来るが 　家事はやや苦手で、掃除をしていて家の物を壊したり、料理をしていて鍋を焦がしたりする。ぬいぐるみが大好き。"},{"spoiler":false,"text":"男性経験はなく、性的なことに関しては極めて初心。"},{"spoiler":false,"text":"純真で素直な反面、やきもち妬きで意地っ張りなところがあり、約束を破ること が何よりも嫌い。"},{"spoiler":false,"text":"元々正義感が強く、悪に対して敢然と立ち向かう強さを持っており、光臨天使エンシェル・レナとなって懸命に戦う。"}],"source":"egs","sourceCharacterId":"7975","sourceWorkId":"4552","spoiler":false},{"segments":[{"spoiler":false,"text":"エンシェリウムカードで変身する最強の魔法戦士。"},{"spoiler":false,"text":"世界が混沌とし悪が蔓延り始め人々が苦しむ中、強い力による支配が秩序を生むと信じ、ディネロに手を貸す。良いのか？"}],"source":"egs","sourceCharacterId":"7975","sourceWorkId":"10418","spoiler":false},{"segments":[{"spoiler":false,"text":"バレキシアにてアザハイド帝国と戦闘を続ける光臨天使。"},{"spoiler":false,"text":"エンシェリウムカードという、ごく限られた能力者のみが使用可能な多用途戦闘システムによって変身する。"},{"spoiler":false,"text":"時折地上に戻ってきて『白薔薇』と連携している。"}],"source":"egs","sourceCharacterId":"7975","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"“光臨天使” と呼ばれる、最強の戦士。"},{"spoiler":false,"text":"“エンシェリウムカード” という、ロアの魔法戦士たちとは違う力によって変身し、アザハイド帝国と戦っている。"},{"spoiler":false,"text":"清楚で純真、まじめで控えめな性格ながら、秘めたる強い意志を持つ。"}],"source":"egs","sourceCharacterId":"7975","sourceWorkId":"17330","spoiler":false},{"segments":[{"spoiler":false,"text":"エンシェリウムカード「オリジナル・ワン」によって朋衛玲奈が変身した光臨天使。"}],"source":"egs","sourceCharacterId":"7975","sourceWorkId":"25236","spoiler":false},{"segments":[{"spoiler":false,"text":"地上の人間には極めて珍しい、エンシェリウムカードを使うことの出来る能力者「エンシェリアン」。"},{"spoiler":false,"text":"地上の正義と平和を守りたいという強い意志と共に、光臨天使エンシェル・レナとなって悪と戦う。"},{"spoiler":false,"text":"レナはネフィーレと出会うことで、スイートリップたち魔法戦士のいる世界へと向かうことになる。"}],"source":"egs","sourceCharacterId":"7975","sourceWorkId":"37809","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c3caa06efeb11d64e9ed5a42b2509b511dabf21f95afe4e57ed11050f09bcb6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5be669ef3978f5867e12839f0b941fabdff9b4f8d16297c79f9730e5460659d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c33541","characterName":"朋衛 玲奈","sourceIds":{"vndbCharacterId":"c33541"},"originalCharacterName":"朋衛 玲奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7af569f8dae46d050784f53557760e43d80bd08ed746c85f3e9b12802c82d5c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cff197812dd999b8389d4fe38191b3ac8945dbf1804559a39bce19683d90859d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"遠野 そよぎ","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:49152","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:208","sourceCompanyId":"egs:brand:208","canonicalEntityId":"egs:brand:208","name":"Triangle","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:17330:208","source":"egs"},{"companyId":"vndb:p332","sourceCompanyId":"vndb:p332","canonicalEntityId":"vndb:p332","name":"Triangle","roleCodes":