d":"vndb:s8495","sourcePersonId":"vndb:s8495","canonicalEntityId":"vndb:s8495","name":"武村 ゆみこ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:112875","source":"vndb"},{"creditedName":"東狐 萌衣","creatorId":"vndb:s14515","sourcePersonId":"vndb:s14515","canonicalEntityId":"vndb:s14515","name":"東狐 萌衣","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:112876","source":"vndb"},{"creditedName":"安井 光","creatorId":"vndb:s14516","sourcePersonId":"vndb:s14516","canonicalEntityId":"vndb:s14516","name":"安井 光","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:112877","source":"vndb"},{"creditedName":"桑名 真吾","creatorId":"vndb:s14517","sourcePersonId":"vndb:s14517","canonicalEntityId":"vndb:s14517","name":"桑名真吾","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:112878","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c39721","characterName":"湊戸 アイ","sourceIds":{"vndbCharacterId":"c39721"},"originalCharacterName":"湊戸 アイ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"322"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the game. \"Beniyuri\" isn't her real name, but one of the \"nicknames\" she and the others each chose to use to refer to each other due their amnesiac state."},{"spoiler":false,"text":"Even without her memories, Beniyuri is a kind, patient, well-mannered and optimistic girl, who is unable to abandon someone in trouble regardless of the danger. In that same regard, she can be quite stubborn at times and could come across as a bit of a busybody meddler. Still, even though she doesn't necessarily have a bad attitude, she holds a certain hesitance towards, and has a tendency to draw a line against developing a deeper relationship with other people."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c39721"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e992bf93230b77ebdde2059c93d7c546ff420882b1073ea0f9b8a1d485a9e099.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35b7a67f93cd4f4c78362288b6aeca35fc776d51c9b372856afbc214b5a67165.webp","width":200,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中原 麻衣","creatorId":"vndb:s444","sourcePersonId":"vndb:s444","canonicalEntityId":"vndb:s444","name":"中原 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:60239","source":"vndb"}]},{"characterId":"char_vndb_c39722","characterName":"緋影","sourceIds":{"vndbCharacterId":"c39722"},"originalCharacterName":"緋影","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"101"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hikage is the first person Beniyuri meets in the mansion and, of course, like her he has no memory of who he is. He's calm, logical, perceptive and sarcastic. Even if he doesn't necessarily mean any harm, his blunt attitude and the way it seems as if he doesn't care if he offends someone makes him come across as aloof. Nevertheless, his ability to keep a cool head even in difficult situations makes him a capable and reliable ally so, naturally, he ends up taking on a bit of a leadership role among the group of amnesiacs."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c39722"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6bcd192fc1bdc90dd2a791e7759d0fa4f6c7d86baa7245efb06c41af925a7591.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af62810b1d457b1c234f4a5ed3ef2453af9dafd4618f7abc6c44c5acdf5e3b1d.webp","width":200,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石川 界人","creatorId":"vndb:s4435","sourcePersonId":"vndb:s4435","canonicalEntityId":"vndb:s4435","name":"石川 界人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:60242","source":"vndb"}]},{"characterId":"char_vndb_c39724","characterName":"山都","sourceIds":{"vndbCharacterId":"c39724"},"originalCharacterName":"山都","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"707"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"With his curt, rough way of speaking, his hot-headed and confrontational attitude, along with his brooding Yamato can come across as pretty intimidating and not exactly the friendliest of guys. True to their conflicting color schemes, Yamato is a complete contrast to Hikage. Where Hikage is calm, Yamato is brash and quick to panic. Where Hikage is the type to plan his actions, Yamato lets his emotions guide him... so unsurprisingly they clash quite a bit and the game gives them a bit of a rival-like role. In the game, Yamato is one of the characters that is most vocal about his desire to rush to reclaim their memories and find a way out of their situation."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c39724"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40dcd47e2934be4825e060259184b86f226df0b2c4642b7e86c65983428aa054.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57f61417991de986e9c9d8ee87e2dcf4db0d93927221b6b9309cf3bc5328518b.webp","width":200,"height":256,"source":"static-detail"},"actors":[{"creditedName":"細谷 佳正","creatorId":"vndb:s251","sourcePersonId":"vndb:s251","canonicalEntityId":"vndb:s251","name":"細谷 佳正","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:60238","source":"vndb"}]},{"characterId":"char_vndb_c39725","characterName":"鴉翅","sourceIds":{"vndbCharacterId":"c39725"},"originalCharacterName":"鴉翅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"403"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Cheerful and sociable with a devil may care attitude towards the dangerous situation that they found themselves in, Karasuba might seem like he's fooling around with the way he casually teases everyone (often with a mean edge to it) and shamelessly flirts with Beniyuri but he actually sharper and more perceptive than he appears. Despite the flippant way he carries himself, he's the type who keeps his true intentions to himself and is pretty pragmatic and pessimistic. That said, he makes it pretty clear earlier on that he doesn't really trust anyone in their group."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c39725"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d9047bbeec59b09075725345f34a65966a21e166be342a2f1b6f55d0acc3fc5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e07fa983e8c4972515defcef58db5234de8fd04f518c12f02924a1b3e547d513.webp","width":200,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柿原 徹也","creatorId":"vndb:s80","sourcePersonId":"vndb:s80","canonicalEntityId":"vndb:s80","name":"柿原 徹也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:60237","source":"vndb"}]},{"characterId":"char_vndb_c39726","characterName":"鉤翅","sourceIds":{"vndbCharacterId":"c39726"},"originalCharacterName":"鉤翅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1202"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kagiha is what you'd call the 'big brother' figure of the group. He has a soft-spoken and gentle personality, so despite his tall stature he's a pacifist and prefers not to fight if he doesn't have to. He seems to worry about and look after the group members, and sometimes plays the role of the mediator when some of the guys get a little rowdy."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c39726"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/7639634a129768dafc56242b1bad69ce0be7268344317ee1e907cbdd00468f16.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da17ac3d32b7cf2d6db3f0cd39634c2d770c1c1526e2224c5a2b0eea4dc6ab44.webp","width":200,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳥海 浩輔","creatorId":"vndb:s45","sourcePersonId":"vndb:s45","canonicalEntityId":"vndb:s45","name":"鳥海 浩輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:60236","source":"vndb"}]},{"characterId":"char_vndb_c39727","characterName":"紋白","sourceIds":{"vndbCharacterId":"c39727"},"originalCharacterName":"紋白","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"707"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The mysterious kitsune mask-wearing guy who seems to have saved Beniyuri from monsters at the start of the game. A person of few words, it's a unclear whether Monshiro is actually a friend or foe, so the other guys often advise Beniyuri against trusting him because they suspect that he could be the Master of the Mansion himself."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c39727"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec40a2e1eca06790de2e1b4ceadbfc52b6a9637b7605b6e0e3274413ec16b3fe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17390a3b8d70cf9ba55101f1c5a2c3712bbde81533604900cb0da119587acb58.webp","width":200,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松岡 禎丞","creatorId":"vndb:s748","sourcePersonId":"vndb:s748","canonicalEntityId":"vndb:s748","name":"松岡 禎丞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:60240","source":"vndb"}]},{"characterId":"char_vndb_c39728","characterName":"ウサギ","sourceIds":{"vndbCharacterId":"c39728"},"originalCharacterName":"ウサギ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1120"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The young rabbit mask-wearing girl who seems to serve the Master of the Mansion. Usagi sometimes appears to give the group the Master's message or offer some exposition before disappearing just as mysteriously and suddenly. Just like in Monshiro's case, the guys are wary of her and warns Beniyuri against trying to befriend her."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c39728"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f6546c44e9a4ba293c912fa6d8565b95c8430be50bda44377490e3128deaf89.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10b8315560094a122e4e258909e2c947e5434a3b4928491d51affd9b06064b16.webp","width":200,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長縄 まりあ","creatorId":"vndb:s2653","sourcePersonId":"vndb:s2653","canonicalEntityId":"vndb:s2653","name":"長縄 まりあ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:60241","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p589","sourceCompanyId":"egs:brand:2924","canonicalEntityId":"vndb:p589","name":"オトメイト","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:22355:2924","source":"egs"},{"companyId":"vndb:p9619","sourceCompanyId":"vndb:p9619","canonicalEntityId":"vndb:p9619","name":"snow rowan","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:145640:v15771","source":"vndb"},{"companyId":"vndb:p12800","sourceCompanyId":"vndb:p12800","canonicalEntityId":"vndb:p12800","name":"Captain's Sanctuary","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:145641:v15771","source":"vndb"},{"companyId":"vndb:p21128","sourceCompanyId":"vndb:p21128","canonicalEntityId":"vndb:p21128","name":"RuDant","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:145642:v15