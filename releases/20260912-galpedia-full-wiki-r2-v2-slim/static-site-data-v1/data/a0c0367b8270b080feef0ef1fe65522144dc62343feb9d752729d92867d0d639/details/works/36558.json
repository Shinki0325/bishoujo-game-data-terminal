vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:281171","source":"egs"},{"creditedName":"朝妻ユタカ","creatorId":"vndb:s4472","sourcePersonId":"egs:creator:15666","canonicalEntityId":"vndb:s4472","name":"朝妻ユタカ","detail":"ディレクション","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:281172","source":"egs"},{"creditedName":"草壁 祭","creatorId":"vndb:s402","sourcePersonId":"vndb:s402","canonicalEntityId":"vndb:s402","name":"草香 祭","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:207335","source":"vndb"},{"creditedName":"電気式華憐音楽集団","creatorId":"vndb:s606","sourcePersonId":"vndb:s606","canonicalEntityId":"vndb:s606","name":"電気式華憐音楽集団","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:207336","source":"vndb"},{"creditedName":"丸谷 秀人","creatorId":"vndb:s1125","sourcePersonId":"vndb:s1125","canonicalEntityId":"vndb:s1125","name":"丸谷 秀人","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:207338","source":"vndb"},{"creditedName":"華憐","creatorId":"vndb:s2434","sourcePersonId":"vndb:s2434","canonicalEntityId":"vndb:s2434","name":"華憐","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:207339","source":"vndb"},{"creditedName":"華憐","creatorId":"vndb:s2434","sourcePersonId":"vndb:s2434","canonicalEntityId":"vndb:s2434","name":"華憐","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:207340","source":"vndb"},{"creditedName":"朝妻 ユタカ","creatorId":"vndb:s4472","sourcePersonId":"vndb:s4472","canonicalEntityId":"vndb:s4472","name":"朝妻 ユタカ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:207342","source":"vndb"},{"creditedName":"Naynit Kcalb Studio","creatorId":"vndb:s7472","sourcePersonId":"vndb:s7472","canonicalEntityId":"vndb:s7472","name":"たいにゃん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:207344","source":"vndb"}]},"cast":[{"characterId":"char_c140639","characterName":"禊ヶ原トワ","sourceIds":{"bangumi":[{"characterId":"162539","match":"exact-normalized-name-in-linked-work","subjectId":"496133"}],"egsCharacterIds":["26088"],"vndbCharacterId":"c140639"},"originalCharacterName":"禊ヶ原トワ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Owns the Magical Heart \"Serendibite\""},{"spoiler":false,"text":"The discoverer of the \"Magical Heart,\" which became the key to saving humanity, and the founder of the academy city, lost both her beloved sister, with whom she had a close relationship, and her mother due to the ambitions of a single traitor. Since then, she has sworn revenge and infiltrated the academy city, \"Seika Renaissance Polis Fukkou (commonly known as Fukkou Academy),\" disguised as a transfer student. Holding the Magical Heart left behind by her sister, she transforms into the Black Jewel Princess."},{"spoiler":false,"text":"Wielding the whip \"Barthory,\" enveloped in jet-black flames, she fights with unmatched skill and versatility."},{"spoiler":false,"text":"Having lived with the word \"revenge\" engraved in her heart, she strictly disciplines herself. To survive, she has had to become highly suspicious of others. However, her true nature is kind-hearted and somewhat naive."},{"spoiler":false,"text":"She meets Shizune Daonault (Dee), who looks exactly like her deceased sister, and as they bond, she begins to love her. This love ultimately brings further tragedy to Towa..."}],"source":"vndb","sourceCharacterId":"c140639"},{"segments":[{"spoiler":false,"text":"人類を救う鍵となった『マジカルハート』の発見者であり、学園都市の創設者である母と、仲睦まじかった最愛の妹を、一人の裏切り者の野心により失う。"},{"spoiler":false,"text":"以来、復讐を誓い、転校生と偽って学園都市『星華ルネサンスポリス復光（通称：復光学園）』へと身を投じる。"},{"spoiler":false,"text":"妹の遺したマジカルハートをもって、黒き宝石姫へと変身。"},{"spoiler":false,"text":"漆黒の炎をまとった鞭『バートリー』を変幻自在に振るう。"},{"spoiler":false,"text":"復讐の二文字を胸に生きてきたので、自らをを厳しく律している。"},{"spoiler":false,"text":"身を潜め、生き残るために、猜疑心も強くなければならなかった。"},{"spoiler":false,"text":"本来の性格は心優しく、お人よしの一面がある。"},{"spoiler":false,"text":"亡き妹と瓜二つである雫音ダオナルト（ディー）と知り合い、心を通わせるうちに、彼女を愛するようになる。"},{"spoiler":false,"text":"そのことが、トワにとってさらなる悲劇を生むことになる……。"}],"source":"egs","sourceCharacterId":"26088","sourceWorkId":"36558","spoiler":false},{"segments":[{"spoiler":false,"text":"所有マジカルハート『セレンディバイト』"},{"spoiler":false,"text":"人類を救う鍵となった『マジカルハート』の発見者であり、"},{"spoiler":false,"text":"学園都市の創設者である母と、仲睦まじかった最愛の妹を、"},{"spoiler":false,"text":"一人の裏切り者の野心により失う。"},{"spoiler":false,"text":"以来、復讐を誓い、転校生と偽って学園都市『星華ルネサンスポリス復光（通称：復光学園）』へと身を投じる。"},{"spoiler":false,"text":"妹の遺したマジカルハートをもって、黒き宝石姫へと変身。"},{"spoiler":false,"text":"漆黒の炎をまとった鞭『バートリー』を変幻自在に振るう。"},{"spoiler":false,"text":"復讐の二文字を胸に生きてきたので、自らをを厳しく律している。"},{"spoiler":false,"text":"身を潜め、生き残るために、猜疑心もつよくなければならなかった。"},{"spoiler":false,"text":"本来の性格は心優しく、お人よしの一面がある。"},{"spoiler":false,"text":"亡き妹と瓜二つである雫音ダオナルト（ディー）と知り合い、"},{"spoiler":false,"text":"心を通わせるうちに、彼女を愛するようになる。"},{"spoiler":false,"text":"そのことが、トワにとってさらなる悲劇を生むことになる……。"}],"source":"bangumi","sourceCharacterId":"162539"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4ab54c1d446299f1946075d64fc9bd6c74cf8b67675c6daa5822dce153a76fae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/358d71c2606ede4bce0be7c341de976dd63be3c1ea3cca33002a4e432dad7079.webp","width":130,"height":256,"source":"static-detail"},"actors":[{"creditedName":"笹本菜津枝","creatorId":"vndb:s11698","sourcePersonId":"vndb:s11698","canonicalEntityId":"vndb:s11698","name":"笹本 菜津枝","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:496133:162539:15946:1","source":"bangumi"}]},{"characterId":"char_c140640","characterName":"雫音ダオナルト","sourceIds":{"bangumi":[{"characterId":"162540","match":"exact-normalized-name-in-linked-work","subjectId":"496133"}],"egsCharacterIds":["26089"],"vndbCharacterId":"c140640"},"originalCharacterName":"雫音ダオナルト","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student at Fukkou Academy, commonly known as Dee."},{"spoiler":false,"text":"She has large, curious eyes reminiscent of a cat and brown skin. Her appearance is the spitting image of Towa's sister, who tragically died in the past."},{"spoiler":false,"text":"Towa meets Dee on her first day as a transfer student, and they quickly become close. Dee, who is sincere and genuine, gradually earns Towa's trust. Eventually, they are drawn to each other, and even after becoming lovers, they maintain a refreshing innocence. Because Dee closely resembles her late sister, she becomes the most precious person to Towa."}],"source":"vndb","sourceCharacterId":"c140640"},{"segments":[{"spoiler":false,"text":"復光学園に通う“星徒（せいと）”で通称ディー。"},{"spoiler":false,"text":"猫を思わせる好奇心に満ち溢れた大きな瞳と、褐色の肌。"},{"spoiler":false,"text":"それは、かつて悲劇的な死を遂げたトワの妹と瓜二つの姿であった。"},{"spoiler":false,"text":"トワとは転校初日に知り合い、すぐに親しくなる。"},{"spoiler":false,"text":"裏表なく親身になって接してくるディーに、いつしかトワは心を許していく。"},{"spoiler":false,"text":"やがてお互いに惹かれ合うようになるが、恋人となってからも初々しさを見せる。"},{"spoiler":false,"text":"妹と酷似していることもあり、トワにとって何よりも大切な存在となる。"}],"source":"egs","sourceCharacterId":"26089","sourceWorkId":"36558","spoiler":false},{"segments":[{"spoiler":false,"text":"復光学園に通う“星徒（せいと）”で通称ディー。"},{"spoiler":false,"text":"猫を思わせる好奇心に満ち溢れた大きな瞳と、褐色の肌。"},{"spoiler":false,"text":"それは、かつて悲劇的な死を遂げたトワの妹と瓜二つの姿であった。"},{"spoiler":false,"text":"トワとは転校初日に知り合い、すぐに親しくなる。"},{"spoiler":false,"text":"裏表なく親身になって接してくるディーに、いつしかトワは心を許していく。"},{"spoiler":false,"text":"やがてお互いに惹かれ合うようになるが、恋人となってからも初々しさを見せる。"},{"spoiler":false,"text":"妹と酷似していることもあり、トワにとって何よりも大切な存在となる。"}],"source":"bangumi","sourceCharacterId":"162540"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fb7e9d16b44af3034d14c1768c39c874ffa72b0bfcd4b2f25c3c62738587923.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14e668ff8b1be72a193d3bdbe49bf12bbab8d4fd7824834bfd40055ccff7695d.webp","width":130,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朝比奈幸","creatorId":"vndb:s21648","sourcePersonId":"vndb:s21648","canonicalEntityId":"vndb:s21648","name":"朝比奈 幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:496133:162540:17080:1","source":"bangumi"},{"creditedName":"綾音 まこ","creatorId":"vndb:s2581","sourcePersonId":"vndb:s2581","canonicalEntityId":"vndb:s2581","name":"綾音 まこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:98084","source":"vndb"}]},{"characterId":"char_c140641","characterName":"暁宮エリス","sourceIds":{"bangumi":[{"characterId":"162541","match":"exact-normalized-name-in-linked-work","subjectId":"496133"}],"egsCharacterIds":["26090"],"vndbCharacterId":"c140641"},"originalCharacterName":"暁宮エリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Owning the Magical Heart \"Moonstone\""},{"spoiler":false,"text":"She possesses an overwhelming power that surpasses other Magical Hearts."},{"spoiler":false,"text":"She is the daughter of the chairman of the academy city \"Seika Renaissance Polis Fukkou\" and serves as the \"Student Council President.\" Pure and beautiful, she always wears a loving smile and is adored and revered by everyone at the academy, akin to a saint. To Towa, however, she is the daughter of her nemesis and a sworn enemy who has inherited all of her power and ambition."},{"spoiler":false,"text":"Since childhood, she has been in a romantic relationship with her maid, Yuzuki Celestina, whom she adores like an older sister."}],"source":"vndb","sourceCharacterId":"c140641"},{"segments":[{"spoiler":false,"text":"他のマジカルハートを圧倒するほどの絶大な力を秘めている。"},{"spoiler":false,"text":"学園都市『星華ルネサンスポリス復光』の理事長の娘であり、“星徒会長”を務めている。"},{"spoiler":false,"text":"清らかで美しく、慈愛に満ちた微笑みをたたえており、学園の皆から愛され慕われている聖女というべき存在。"},{"spoiler":false,"text":"トワにとっては仇の娘であり、その権力と野心を全て受け継いだ宿敵である。"},{"spoiler":false,"text":"幼いころから姉のように慕う、メイドの夕蒼セレスティナと恋愛関係にある。"}],"source":"egs","sourceCharacterId":"26090","sourceWorkId":"36558","spoiler":false},{"segments":[{"spoiler":false,"text":"所有マジカルハート『ムーンストーン』"},{"spoiler":false,"text":"他のマジカルハートを圧倒するほどの絶大な力を秘めている。"},{"spoiler":false,"text":"学園都市『星華ルネサンスポリス復光』の理事長の娘であり“星徒会長”を務めている。"},{"spoiler":false,"text":"清らかで美しく、慈愛に満ちた微笑みをたたえており、学園の皆から愛され慕われている聖女というべき存在。"},{"spoiler":false,"text":"トワにとっては仇の娘であり、その権力と野心を全て受け継いだ宿敵である。"},{"spoiler":false,"text":"幼いころから姉のように慕う、メイドの夕蒼セレスティナと恋愛関係にある。"}],"source":"bangumi","sourceCharacterId":"162541"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87e00667f63dca34c29cf515fe25186a476d217aee14710adbf0f36a0712f858.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6aba1c545a7ecbeddf30a408244ce67a879e44e7648528369aa809e7fe23a14a.webp","width":130,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡本理絵","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:496133:162541:13368:1","source":"bangumi"}]},{"characterId":"char_c140644","characterName":"夕蒼セレスティナ","sourceIds":{"bangumi":[{"characterId":"162542","match":"exact-normalized-name-in-linked-work","subjectId":"496133"}],"egsCharacterIds":["26091"],"vndbCharacterId":"c140644"},"originalCharacterName":"夕蒼セレスティナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Owning the Magical Heart of \"Rubellite\""},{"spoiler":false,"text":"She is an impenetrable guardian who protects her master from all disasters."},{"spoiler":false,"text":"A loyal maid serving Eris. Rather than being merely a servant, she is like an older sister who"},{"spoiler":false,"text":"is trusted wholeheartedly. Her personality is elusive and unpredictable, often wearing a subtle smile that gives the impression that she might be the one in control."},{"spoiler":false,"text":"She possesses a maternal, voluptuous figure and is known for her nurturing presence. She also has a deep love for novels and stories and is a member of the literature club."}],"source":"vndb","sourceCharacterId":"c140644"},{"segments":[{"spoiler":false,"text":"あらゆる災厄から主人を護り抜く鉄壁の守護者。"},{"spoiler":false,"text":"エリスに仕える忠実なるメイド。"},{"spoiler":false,"text":"使用人というよりは姉のような存在であり、心から信頼されている。"},{"spoiler":false,"text":"性格的には飄々として、つかみどころがない。"},{"spoiler":false,"text":"常に含みのある薄笑いを浮かべており、まるでセレナの方が主導権を握っているかのように見えることも。"},{"spoiler":false,"text":"その性格的にも体型的にも母性溢れる爆乳の持ち主。"},{"spoiler":false,"text":"何気に小説や物語の類が大好きであり、文芸部に所属している。"}],"source":"egs","sourceCharacterId":"26091","sourceWorkId":"36558","spoiler":false},{"segments":[{"spoiler":false,"text":"所有マジカルハート『ルベライト』"},{"spoiler":false,"text":"あらゆる災厄から主人を護り抜く鉄壁の守護者。"},{"spoiler":false,"text":"エリスに仕える忠実なるメイド。"},{"spoiler":false,"text":"使用人というよりは姉のような存在であり、心から信頼されている。"},{"spoiler":false,"text":"性格的には飄々として、つかみどころがない。"},{"spoiler":false,"text":"常に含みのある薄笑いを浮かべており、まるでセレナの方が主導権を握っているかのように見えることも。"},{"spoiler":false,"text":"その性格的にも体型的にも母性溢れる爆乳の持ち主。"},{"spoiler":false,"text":"何気に小説や物語の類が大好きであり、文芸部に所属している。"}],"source":"bangumi","sourceCharacterId":"162542"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53f06a187951d37f828732bf038bdaba6cda413c76f0e6423a0764c256da8554.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c22bd8f1b2c370911930f28614bed2c9e121668a08c85c931e064d86aa7dea5.webp","width":130,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:496133:162542:15684:1","source":"bangumi"}]},{"characterId":"char_c140645","characterName":"月影レイカ","sourceIds":{"bangumi":[{"characterId":"162543","match":"exact-normalized-name-in-linked-work","subjectId":"496133"}],"egsCharacterIds":["26092"],"vndbCharacterId":"c140645"},"originalCharacterName":"月影レイカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Possessing the Magical Heart \"Lapis Lazuli\""},{"spoiler":false,"text":"She wields twin swords named \"Shamsheer Zomorodnegarl.\""},{"spoiler":false,"text":"At Fukkou Academy, she serves as the Vice President of the Student Council. Her dashing demeanor makes her popular within the academy, and she holds a prince-like position. She comes from an old and prestigious family, which she takes great pride in. As a result, she harbors a strong sense of rivalry and complex towards Eris, the President."},{"spoiler":false,"text":"Despite having a personality that is the complete opposite, she strangely gets along well with Senbazuru Izuna. They share a peculiar distance, having been physically close many times but never quite becoming lovers. She is sometimes teased by Izuna for having a smaller chest than Eris."}],"source":"vndb","sourceCharacterId":"c140645"},{"segments":[{"spoiler":false,"text":"宝剣『シャムシール・ゾモロドネガル』と名付けた二刀を振るう。"},{"spoiler":false,"text":"学園都市ルネサンスポリスの星徒会にて、副会長を務めている。"},{"spoiler":false,"text":"颯爽とした言動から学園内でも人気が高く、王子様的なポジションにある。"},{"spoiler":false,"text":"旧家の家柄であり、それを誇りにしている。"},{"spoiler":false,"text":"そのため内心では会長であるエリスに強い対抗心とコンプレックスを抱いている。"},{"spoiler":false,"text":"性格的に正反対の千羽鶴イヅナと何故か相性が良い。"},{"spoiler":false,"text":"何度も身体を重ねつつも、恋人とも呼べない不思議な距離感にある。"},{"spoiler":false,"text":"エリスより胸が小さいことを、イヅナにからかわれていたりもする。"}],"source":"egs","sourceCharacterId":"26092","sourceWorkId":"36558","spoiler":false},{"segments":[{"spoiler":false,"text":"所有マジカルハート『ラピスラズリ』"},{"spoiler":false,"text":"宝剣『シャムシール・ゾモロドネガル』と名付けた二刀を振るう。"},{"spoiler":false,"text":"学園都市ルネサンスポリスの星徒会にて、副会長を務めている。"},{"spoiler":false,"text":"颯爽とした言動から学園内でも人気が高く、王子様的なポジションにある。"},{"spoiler":false,"text":"旧家の家柄であり、それを誇りにしている。"},{"spoiler":false,"text":"そのため内心では会長であるエリスにつよい対抗心とコンプレックスを抱いている。"},{"spoiler":false,"text":"性格的に正反対の千羽鶴イヅナと何故か相性が良い。"},{"spoiler":false,"text":"何度も身体を重ねつつも、恋人とも呼べない不思議な距離感にある。"},{"spoiler":false,"text":"エリスより胸が小さいことを、イヅナにからかわれていたりもする。"}],"source":"bangumi","sourceCharacterId":"162543"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e2142ebc5155f65e99c205ce6f4e7a1966a7eb2c9a81801a01b7940dd4b46d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/810f973d2e0475662526af0930914de46e8ddaa224c3b322be07703fcdda6440.webp","width":130,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白砂菓夏海","creatorId":"vndb:s24677","sourcePersonId":"vndb:s24677","canonicalEntityId":"vndb:s24677","n