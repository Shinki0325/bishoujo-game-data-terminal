"26093","sourceWorkId":"36558","spoiler":false},{"segments":[{"spoiler":false,"text":"所有マジカルハート『シトリン』"},{"spoiler":false,"text":"宝石姫としては長大な大砲と、デリンジャーのような短銃を使い分ける。"},{"spoiler":false,"text":"享楽的な性格で、おおよそ星徒会のメンバーとは思えないような異端の存在。"},{"spoiler":false,"text":"嘲るような笑みを浮かべながら、何かと挑発的な言動をとることが多い。"},{"spoiler":false,"text":"小柄ですばしっこく、いわゆる『メスガキ』的な振る舞いを見せる。"},{"spoiler":false,"text":"普段からつるんでいるレイカの野心に積極的に加担することはないが、気まぐれなのか、それとも愛情からなのか協力することも。"}],"source":"bangumi","sourceCharacterId":"162544"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f86ebe38aa7b9da8c7afcd19962554c1bb8dcce531651da45d800da24354782.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d472732e3b8a3014d52893a7d7c8c0135bf9d8962a249006292e16cd860769b.webp","width":130,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤沢れい香","creatorId":"vndb:s14338","sourcePersonId":"vndb:s14338","canonicalEntityId":"vndb:s14338","name":"藤沢 れい香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:496133:162544:32998:1","source":"bangumi"}]},{"characterId":"char_vndb_c141556","characterName":"王子","sourceIds":{"vndbCharacterId":"c141556"},"originalCharacterName":"王子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"--The white prince with eyes filled with sorrow."}],"source":"vndb","sourceCharacterId":"c141556"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eea4560c6c511b56a5184a07104055386ff0e395cd8919eb43a078695bda0acc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd555f36f53a88bbe