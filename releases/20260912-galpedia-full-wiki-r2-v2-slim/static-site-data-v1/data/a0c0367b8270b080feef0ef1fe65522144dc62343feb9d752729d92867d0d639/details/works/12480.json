creator:122405","source":"egs"},{"creditedName":"亀井理恵子","creatorId":"egs:creator:19802","sourcePersonId":"egs:creator:19802","canonicalEntityId":"egs:creator:19802","name":"亀井理恵子","detail":"広報","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:122406","source":"egs"},{"creditedName":"土天冥海","creatorId":"vndb:s504","sourcePersonId":"egs:creator:5360","canonicalEntityId":"vndb:s504","name":"土天冥海","detail":"演出","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:92245","source":"egs"},{"creditedName":"市川 小紗","creatorId":"vndb:s2100","sourcePersonId":"vndb:s2100","canonicalEntityId":"vndb:s2100","name":"市川 小紗","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:57978","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c50503","characterName":"南 真樹夫","sourceIds":{"vndbCharacterId":"c50503"},"originalCharacterName":"南 真樹夫","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"height":{"reviewState":"source-only","source":"vndb","value":"171"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third year student at Seiryu Academy and Hikari and Seiji's childhood friend."},{"spoiler":false,"text":"He is an excellent student from a wealthy family, and intends to follow in the footsteps of his parents by becoming a doctor after graduating. Currently living alone due to personal circumstances. His hobby is washing his hands."},{"spoiler":true,"text":"In reality, his thoughts, feelings, and living situation all actually belong to Seiji. His mind and memories have been manipulated by Seiji in a cruel plot to ruin his and his girlfriend Hikari's lives. The trigger for his hypnosis is the ringtone of his cell phone, while his fixation on repetitively washing his hands is a byproduct of being in a trance."}],"source":"vndb","sourceCharacterId":"c50503"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48a47465922c7c920f8be0d1794ddefefcdb7f4b4a04dd5535251aef75bdb34c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99a2f2fde7520274347c8942dcc6c4f95a81546b382fcc8a237d2e211f7500ee.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c50504","characterName":"園部 空","sourceIds":{"vndbCharacterId":"c50504"},"originalCharacterName":"園部 空","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"height":{"reviewState":"source-only","source":"vndb","value":"169"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hikari's older sister. Works as a tour guide at a bus company. Along with having beautiful looks and a large chest, she possesses a strong core and is trained in self-defense. Due to being seven years older than her sister's trio of friends, she has watched over them since she was in middle school. While she is generally very popular with her colleagues, superiors, and customers, she tends to be rather harsh toward Makio. Currently, she is engaged to her coworker Ryou Isezaki, and the two are scheduled to be married in November."},{"spoiler":true,"text":"She has secretly been in love with Makio since they first met, but has refused to act on her feelings due to the age difference between them. Her aloof demeanor when interacting with him is due to embarrassment rather than dislike. She has tried many different things to attempt to overcome this longing, but they have all only resulted in her adoration deepening further. Her concern for her sister and Makio's well-beings eventually pushes her into uncovering Seiji's plot, and the actions she takes to protect them both drive much of the later parts of the story."}],"source":"vndb","sourceCharacterId":"c50504"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40af61cd813f1644d98c778b53bd401f933f36604ed0a7c4c005dc9f82b874f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8d058874c86aee148975495d5b6e4443f0742f7ddd17ca1aee10e5e31d58577.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c50505","characterName":"園部 ひかり","sourceIds":{"vndbCharacterId":"c50505"},"originalCharacterName":"園部 ひかり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sora's younger sister. A third year student at Seiryu Academy and Makio and Seiji's childhood friend. She is a gentle and kindhearted girl who hopes to enter nursing school after graduation. She is in the same class as Makio, and has recently become extremely concerned by his sudden change in attitude toward herself and Seiji."},{"spoiler":true,"text":"In reality, she and Makio had begun dating just before his mind was tampered with. She has no knowledge of Seiji's true nature, nor of his role in causing Makio's strange behavior."}],"source":"vndb","sourceCharacterId":"c50505"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/158f443a866f47e644dc7c0cb494e1b2773e511db04f66b8f55fe627d902b351.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35834d5e4296209a2376acfeb3bacfbbf4f62593f973f099a86441297cf6d064.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c50506","characterName":"及川 誠二","sourceIds":{"vndbCharacterId":"c50506"},"originalCharacterName":"及川 誠二","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"height":{"reviewState":"source-only","source":"vndb","value":"177"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third year student and Seiryu Academy and Makio and Hikari's childhood friend. He is an orphan who lives alone and supports himself by working part-time. Hopes that he, Makio and Hikari will remain friends for the rest of their lives. Lately, he's been worried about how differently Makio has been acting."},{"spoiler":true,"text":"In reality, he is a cruel and vindictive individual who believes himself to be above all other people, and is willing to eliminate anyone who threatens this worldview. He became consumed by jealousy after discovering that his friends had started dating behind his back, and devised an elaborate plot to destroy them both in retaliation. Using hypnosis, he has transmitted all of his thoughts and feelings onto Makio and convinced him that their respective backgrounds and living situations are the opposite of what they actually are in order to compel him to do terrible things to the people he loves."}],"source":"vndb","sourceCharacterId":"c50506"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/66e4133f86e3b1425abb2790c204ad4192163492993a89efc3c82f832bc0fe60.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b39814ec6bd7e7a5feeb9c44423924c1121b73e720923228492ac7b2a118591.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c50507","characterName":"伊勢崎 僚","sourceIds":{"vndbCharacterId":"c50507"},"originalCharacterName":"伊勢崎 僚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"27"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man who works as a driver for the same bus company as Sora. While his looks make him seem somewhat older than he actually is, his warm demeanor makes him well-liked nonetheless. He is deceptively strong for his build, and is capable of skillfully driving a large bus as though it were a part of his own body. He and Sora are currently engaged, and are on track to be married in November."},{"spoiler":true,"text":"Beneath his harmless front, he is actually a serial philanderer who has been secretly seeing many other women throughout his relationship with Sora. In particular, the daughter of his supervisor is currently four months pregnant with his child, and his engagement to Sora was done solely as a means of avoiding having to take responsibility for it. His proximity to Sora eventually causes him to unwittingly become Seiji's accomplice."}],"source":"vndb","sourceCharacterId":"c50507"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/8085e7d320a4437fe01ead2c9ac709f9fb892ddd394db8e9e637862ec7dde193.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/