nflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e79f2f8352dc1aff028dcb0b38398acd857eeec6c1c2d0eec50f40f122686331.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/9391ef2bcefd8d7af77c7f2e3cf8c8dc7e7000e3c6e2e656286848889d344b33.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朝比奈幸","creatorId":"vndb:s21648","sourcePersonId":"vndb:s21648","canonicalEntityId":"vndb:s21648","name":"朝比奈 幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:119531:29888:17080:1","source":"bangumi"},{"creditedName":"綾音 まこ","creatorId":"vndb:s2581","sourcePersonId":"vndb:s2581","canonicalEntityId":"vndb:s2581","name":"綾音 まこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:61901","source":"vndb"}]},{"characterId":"char_c32329","characterName":"御巫 優羽","sourceIds":{"bangumi":[{"characterId":"29889","match":"exact-normalized-name-in-linked-work","subjectId":"119531"}],"egsCharacterIds":["6607"],"vndbCharacterId":"c32329"},"originalCharacterName":"御巫 優羽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Middle child of the sisters. After protagonist left house took it extra personal feeling abandon. Since his return she has been especially cold to him but shows her soft side doting on younger sister."}],"source":"vndb","sourceCharacterId":"c32329"},{"segments":[{"spoiler":false,"text":"【ムリにツンツンしている妹】"},{"spoiler":false,"text":"反発する妹。"},{"spoiler":false,"text":"一見扱いがむつかしそうだが、一回デレるとチョロい。そのチョロさを引き出すためには割の合わないパフォーマンスが必要な妹。"},{"spoiler":false,"text":"兄が自分達を嫌って家を出たと誤解している。"},{"spoiler":false,"text":"兄のいう事にはとことん逆らう。"},{"spoiler":false,"text":"素直に兄を立てるいい妹だったが兄への親愛の情は裏切られたと感じたことによりそのまま反転している状態。"},{"spoiler":false,"text":"本当は素直に兄に甘えたいと葛藤しているが、プライドが邪魔しているため、兄の前ではつい憎まれ口をきいてしまっている。"},{"spoiler":false,"text":"ムリにツンツンしているため少し疲れている状態。"},{"spoiler":false,"text":"主人公はそのことに気づいてないため、そのすれ違いが余計な摩擦を生んでいく。"},{"spoiler":false,"text":"主人公への呼び方：あんた　お兄ちゃん"},{"spoiler":false,"text":"「はあ？　つーか聞いてないんですけど！」"}],"source":"egs","sourceCharacterId":"6607","sourceWorkId":"21380","spoiler":false},{"segments":[{"spoiler":false,"text":"兄に対して反発する妹。"},{"spoiler":false,"text":"飛馬が自分たちを嫌って家を出たと誤解しているため、飛馬の言うことにはとことん逆らう。"},{"spoiler":false,"text":"裏切られたと感じたことによって、兄への親愛の情がそのまま反転している状態。"},{"spoiler":false,"text":"本当は昔のように素直に甘えたいと思っているが、プライドが邪魔している。"},{"spoiler":false,"text":"飛馬は気付かないが、ムリにツンツンしているため最近はツンキャラに少し疲れている。"},{"spoiler":false,"text":"一見扱いが難しそうだが、一回デレるとチョロい。"},{"spoiler":false,"text":"ただし、そのチョロさを引き出すためには割に合わないパフォーマンスが必要となる。"},{"spoiler":false,"text":"「はあ？　つーか聞いてないんですけど！」"}],"source":"bangumi","sourceCharacterId":"29889"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74403597cd9dd51898887076ee02b5d4f9053db7eaabb0b42a276ff2e8f67dba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d51e789d85c3b9cabc002928838a3b888e28e73bbb40149da23c4b1bff7dbdef.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:119531:29889:10026:1","source":"bangumi"}]},{"characterId":"char_c32330","characterName":"御巫 陽菜","sourceIds":{"bangumi":[{"characterId":"29890","match":"exact-normalized-name-in-linked-work","subjectId":"119531"}],"egsCharacterIds":["6608"],"vndbCharacterId":"c32330"},"originalCharacterName":"御巫 陽菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The baby of family and is treated that way as well. She is only one that seems to be particular happy that the protagonist is back. Doesn't like to be seen as immature or childish."}],"source":"vndb","sourceCharacterId":"c32330"},{"segments":[{"spoiler":false,"text":"【かなりウザイけど可愛い妹】"},{"spoiler":false,"text":"妹としては可愛いがひたすらウザイ。"},{"spoiler":false,"text":"かつては大人しい妹だったが、歌ってみた系や生放送などで人気を博して自信をつけた結果、やたら可愛いアピールしてくるようになってしまった。"},{"spoiler":false,"text":"三女にとっては自分の成長を認めず、今さら年上ぶってきている兄が非常にウザイと思っている。"},{"spoiler":false,"text":"主人公への呼び方：お兄様"},{"spoiler":false,"text":"「よし！　陽菜ちゃん今日も可愛いぞ、てへり♪」"}],"source":"egs","sourceCharacterId":"6608","sourceWorkId":"21380","spoiler":false},{"segments":[{"spoiler":false,"text":"妹としては可愛いが、ひたすらウザイ。"},{"spoiler":false,"text":"かつてはおとなしい妹だったが、歌ってみた系や生放送などで人気を博して自信をつけた結果、やたら可愛いアピールするようになった。"},{"spoiler":false,"text":"自分の成長を認めず、年上ぶってくる兄を非常にウザイと思っている。"},{"spoiler":false,"text":"「よし！　陽菜ちゃん今日も可愛いぞ、てへり♪」"}],"source":"bangumi","sourceCharacterId":"29890"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c94650b87fde9dd394fe2a28e5c88dcc08b323068f93af1c0a49c108cbb9bbf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc6a59b01abbdfd343425f41d68e93c900d4190c2d61e2e1768662043588c5a9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間宮菜南子","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:119531:29890:15995:1","source":"bangumi"}]},{"characterId":"char_vndb_c64405","characterName":"御巫 飛馬","sourceIds":{"vndbCharacterId":"c64405"},"originalCharacterName":"御巫 飛馬","character