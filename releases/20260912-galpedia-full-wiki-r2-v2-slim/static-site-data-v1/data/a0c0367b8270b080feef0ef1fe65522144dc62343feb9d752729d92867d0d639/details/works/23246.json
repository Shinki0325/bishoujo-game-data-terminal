"},{"characterId":"97398","match":"source-roster","subjectId":"618697"}]},"originalCharacterName":"Amaterasu","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"毎夜のごとくヒカルの夢枕に立ち、彼をどこかへ誘おうとします。古代の巫女の衣装に身を包み、救いを求めるようにヒカルを見つめています。"},{"spoiler":false,"text":"『夢を紡ぐ力』を持つ一族の正当な継承者。それ故、幼い頃から厳しく育てられたために女の子らしいことは何も知らずにいます。"},{"spoiler":false,"text":"けれど、いつも神に捧げる供物を作っていたためか、料理の腕は女の子達の中では一番です。"},{"spoiler":false,"text":"戦闘時にはそのたおやかな姿に似合わず、長槍を振り回します。"},{"spoiler":false,"text":"属性は『土』。"}],"source":"bangumi","sourceCharacterId":"97398"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/617ad57281a7d91b7681d06ca56f411ca45996605e76476506b6568f13c44068.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f957b242325045223e82c62d115e4204dd2edd3249f411b66973969a69f9da6.webp","width":173,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c38095","characterName":"稲佐 白兎","sourceIds":{"bangumi":[{"characterId":"35173","match":"exact-normalized-name-in-linked-work","subjectId":"142739"},{"characterId":"35173","match":"source-roster","subjectId":"142739"},{"characterId":"35173","match":"source-roster","subjectId":"461261"}],"egsCharacterIds":["7387"],"vndbCharacterId":"c38095"},"originalCharacterName":"稲佐 白兎","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Weapon: Her charm"},{"spoiler":false,"text":"Attribute: Metal"}],"source":"vndb","sourceCharacterId":"c38095"},{"segments":[{"spoiler":false,"text":"八雲学園の先輩。"},{"spoiler":false,"text":"大地と並んで郷土史研究会の幽霊部員その2。"},{"spoiler":false,"text":"小柄だがバストは十分に先輩であることをアピールしている。"},{"spoiler":false,"text":"独特の雰囲気をもち、険悪なムードの中でも平然と乗り込んできて空気を代えてしまう。"},{"spoiler":false,"text":"変に英語が混じったインチキ外人風のしゃべり方を好むが、キャラ付けということで狙ってやっているらしい。"},{"spoiler":false,"text":"大地に対しては、セクハラまがいの行動をしてからかっている。"},{"spoiler":false,"text":"武器は呪符系。属性は金。"}],"source":"egs","sourceCharacterId":"7387","sourceWorkId":"22384","spoiler":false},{"segments":[{"spoiler":false,"text":"悪戯好きで巨乳な先辈"},{"spoiler":false,"text":"稲佐 白兎（いなさ はくと）"},{"spoiler":false,"text":"武器：呪符系／属性：金"},{"spoiler":false,"text":"郷土史研究会の幽霊部员で、小さい身体に大きな胸を持つ小悪魔な先辈。主人公にセクハラまがいの悪戯をしてからかうのが趣味。"},{"spoiler":false,"text":"「グッモーニーン♪　おはよ、おふたりさん」"}],"source":"bangumi","sourceCharacterId":"35173"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5bc67f3a525d95f85e7de48902a94ed74b1515c8113f2ad305d87b4f2252691f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d7818fcb15a22befe724527bd435836bd4487b04c7f1dea098a0923d991314b.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c38096","characterName":"縁","sourceIds":{"bangumi":[{"characterId":"35169","match":"exact-normalized-name-in-linked-work","subjectId":"142739"},{"characterId":"35169","match":"source-roster","subjectId":"142739"},{"characterId":"35169","match":"source-roster","subjectId":"461261"}],"egsCharacterIds":["7388"],"vndbCharacterId":"c38096"},"originalCharacterName":"縁","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Weapon: Scythe"},{"spoiler":false,"text":"Attribute: Earth"}],"source":"vndb","sourceCharacterId":"c38096"},{"segments":[{"spoiler":false,"text":"ある日突然大地の前に現れ、彼を付け狙う。"},{"spoiler":false,"text":"裏出雲が撃退する対象である魔物の群れ「黄泉軍（ヨモツイクサ）」たちを率いる存在とされ、実際に現れる場所・時代には必ず黄泉軍が湧く。"},{"spoiler":false,"text":"裏出雲側からは、不死の存在という意味合いで「石長姫（イワナガヒメ）」の名で呼ばれている。"},{"spoiler":false,"text":"武器は大鎌。属性は土。"}],"source":"egs","sourceCharacterId":"7388","sourceWorkId":"22384","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と几度も接触する谜多き少女"},{"spoiler":false,"text":"縁（えにし）"},{"spoiler":false,"text":"武器：大镰／属性：土"},{"spoiler":false,"text":"主人公を付け狙う谜に満ちた少女。魔物の群れ\"黄泉军\"を率いていると目され、裏出云からは畏怖を込めて\"石长姫\"と呼ばれている。"},{"spoiler":false,"text":"「縁――とでも名乗っておくわ。"},{"spoiler":false,"text":"私と贵方の関系を表わすのなら、そんな名こそが相応しい」"}],"source":"bangumi","sourceCharacterId":"35169"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5d10d0622e158d284d2c68822038ad9225a608482d392c760ad13662b49fd4d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/6562af009ee2a87f5af2aea0c994ae331d3692bd6b29e00c70b084bcdccdeda9.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c38097","characterName":"久世 大地","sourceIds":{"bangumi":[{"characterId":"35171","match":"exact-normalized-name-in-linked-work","subjectId":"142739"},{"characterId":"35171","match":"source-roster","subjectId":"142739"},{"characterId":"35171","match":"source-roster","subjectId":"461261"}],"egsCharacterIds":["7389"],"vndbCharacterId":"c38097"},"originalCharacterName":"久世 大地","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Weapon: Sword"},{"spoiler":false,"text":"Attribute: Wood"}],"source":"vndb","sourceCharacterId":"c38097"},{"segments":[{"spoiler":false,"text":"八雲学園に通う少年。"},{"spoiler":false,"text":"義妹の美空、幼馴染の穂波たちと平凡な日常を過ごしてきたが、放課後の学園で一人の少女に遭遇してから一変、前世を巡る様々な宿業により、神代の世界を揺るがす闘いに巻き込まれていく。"},{"spoiler":false,"text":"武器は険。属性は木。"}],"source":"egs","sourceCharacterId":"7389","sourceWorkId":"22384","spoiler":false},{"segments":[{"spoiler":false,"text":"八雲学園に通う少年。"},{"spoiler":false,"text":"美空や穂波たちと平凡な日常を過ごしてきたが、放課後の学園で縁と遭遇してから一変、"},{"spoiler":false,"text":"前世を巡る様々な宿業により、神代の世界を揺るがす闘いに巻き込まれていく。"},{"spoiler":false,"text":"「ほっとけないな、やっぱり。 やるぜ俺は」"}],"source":"bangumi","sourceCharacterId":"35171"}],"profileFacts":[{"label":"属性","source":"bangumi","sourceCharacterId":"35171","value":"木"},{"label":"武器","source":"bangumi","sourceCharacterId":"35171","value":"剣"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d54c7a5b5b2d09ae7171142090d480aa340bf2b2051193af2775b063ead0ee1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c02d8e02ca126cb9682aed13bc3c59a337f4b955dfb5ee8269084dfb7fcf6c6.webp","width":256,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:148","sourceCompanyId":"egs:brand:148","canonicalEntityId":"egs:brand:148","name":"Studio e.go!","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:23246:148","source":"egs"}],"missingStates":["current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
