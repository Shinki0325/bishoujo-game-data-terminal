ex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"リアリストな郷土史研究会の部长"},{"spoiler":false,"text":"西洞院 绮花（にしのとういん あやか）"},{"spoiler":false,"text":"武器：射撃系（具现化した武器を飞ばして攻撃）／属性：火"},{"spoiler":false,"text":"郷土史研究会の部长を务める、リーダーシップ抜群の先辈。运命や偶然を信じないリアリストで、何事にも动じない頼もしさを持つ。"},{"spoiler":false,"text":"「ふーん。で、こっちの用事はどうなるのかしら？」"}],"source":"bangumi","sourceCharacterId":"35170"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72c8ba187472748a01327e5bfc63e6d87e7fb4c3d47373e3c9a50b78a805be02.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c595f3710942113b79e205b8ccdec6ff618f2def7bb80c4c7e510383d8f8653.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_35172","characterName":"Kuze Misora","sourceIds":{"bangumi":[{"characterId":"35172","match":"source-roster","subjectId":"142739"},{"characterId":"35172","match":"source-roster","subjectId":"461261"}]},"originalCharacterName":"Kuze Misora","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大地の義妹。 大地を “兄貴” と呼んでいる。"},{"spoiler":false,"text":"性格は元気系で、小柄だが腕力が強い。"},{"spoiler":false,"text":"時に腹パンなどのハードコミュニケーションをしてしまう不器用な兄思い。"},{"spoiler":false,"text":"小さい頃は “兄ちゃん” と呼んでいたが、昔のことを言うと照れ臭いので暴れる。"},{"spoiler":false,"text":"燃費が悪く、常に何かしらお腹を空かせている。"},{"spoiler":false,"text":"大地が巻き込まれた非日常の事態を知り、自分も兄を守るために参戦する。"},{"spoiler":false,"text":"「早く起きないと、兄貴の朝ごはんもあたしが全部食べちゃうんだからね？」"}],"source":"bangumi","sourceCharacterId":"35172"}],"profileFacts":[{"label":"属性","source":"bangumi","sourceCharacterId":"35172","value":"金"},{"label":"武器","source":"bangumi","sourceCharacterId":"35172","value":"ナックル（手甲）"}],"metadataCandidateConfl