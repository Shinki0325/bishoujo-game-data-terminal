acterId":"13360","match":"exact-normalized-name-in-linked-work","subjectId":"14529"}],"egsCharacterIds":["11974"],"vndbCharacterId":"c72790"},"originalCharacterName":"カル・ルスラン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"帝国ジュニア・アカデミー第二学年所属。"},{"spoiler":false,"text":"１４年前の統一戦争で帝国軍に滅ぼされた小国「ルスラン」のお姫様であるが、現在は王家復興を願う多くの遺臣たち期待を一身に背負いつつ帝都で勉学に励む。"},{"spoiler":false,"text":"そしてもうひとつ裏の顔は、違法Ｅテクノロジー研究および、違法Ｅウェポンを取り締まる政府組織「パシアテ文明保存管理局」、通称“ライブラリ”の学生エージェント。"},{"spoiler":false,"text":"相手がライブラリの命令に応じず強硬手段に出る場合は、超重機動兵「アルパー」を呼び出し戦闘も行う。"},{"spoiler":false,"text":"長身でスタイル抜群、凛とした美貌を備えた美少女。"},{"spoiler":false,"text":"実年齢よりずっと大人びて見えるため学校では一目置かれ、近寄りがたいと思われることもあるが、根は正直者、生真面目な努力家。"}],"source":"egs","sourceCharacterId":"11974","sourceWorkId":"13845","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b591830fa81ad8f0686ba6049201cecc10f5882b676272679c9d60682c26ea7b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d15434ebb4c5f57723851e0f28be5ce4e80aec7911879a649397dab07d12ce0.webp","width":256,"height":251,"source":"static-detail"},"actors":[{"creditedName":"茅原 実里","creatorId":"vndb:s1459","sourcePersonId":"vndb:s1459","canonicalEntityId":"vndb:s1459","name":"茅原 実里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:6880","source":"vndb"}]},{"characterId":"char_c76236","characterName":"トアラ・ラボアキン","sourceIds":{"bangumi":[],"egsCharacterIds":["11980"],"vndbCharacterId":"c76236"},"originalCharacterName":"トアラ・ラボアキン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"フルクラム帝国支配圏にある小王国から、帝国ジュニアアカデミーに留学してきた王族の少年。第二学年所属。"},{"spoiler":false,"text":"小柄な体つきのため、実際の年より幼くみられることが多い。"},{"spoiler":false,"text":"帝国到着早々、留学初日にＥテクノロジー絡みのテロ事件に巻き込まれ、それが縁でカルと知り合う。以後、なにかにつけ彼女と行動をともにすることに。"},{"spoiler":false,"text":"性格は素直で純朴。田舎者で世間知らずな反面、存続の危機に立たされるほどの深刻な財政難に苦しむ貧乏小国の出身のためか、芯はかなり強く、知恵も回る。"},{"spoiler":false,"text":"真っ正直で、物の裏の読むことが苦手なカルの知恵袋的なポジション。"},{"spoiler":false,"text":"また学年成績トップクラスの知能を活かし、アカデミーで試験があるたびに、彼女の臨時家庭教師を務めている。"}],"source":"egs","sourceCharacterId":"11980","sourceWorkId":"13845","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e97aff44fc710dbb13cb12a6db53202d600e69f8a9b956e214f676be8d408e51.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c2dc8f04bc412a33ba8eb0c9188a4cfb8dcbece15cbce9cc2a8774e71d6ae8f.webp","width":127,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永 朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:6877","source":"vndb"}]},{"characterId":"char_vndb_c76235","characterName":"アマネカ・マッハバスター","sourceIds":{"vndbCharacterId":"c76235"},"originalCharacterName":"アマネカ・マッハバスター","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/221b426e69b198a94e95a3605659c326a95033d7b60f3f88120cf391b910626e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e45