"name":"有限会社ノーマライズ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:9998","source":"vndb"}]},"cast":[{"characterId":"char_c28081","characterName":"武田 赤音","sourceIds":{"bangumi":[{"characterId":"24554","match":"exact-normalized-name-in-linked-work","subjectId":"4009"}],"egsCharacterIds":["12220"],"vndbCharacterId":"c28081"},"originalCharacterName":"武田 赤音","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You've finally come.\""},{"spoiler":false,"text":"A mercenary in service to the Takigawa Corporation, which rules Tokyo's economy with an iron fist. A disciple of the Karuno-ryu school of swordsmanship, Akane is an efficient and deadly combatant more than a match for opponents twice his size. He desires only to settle the score with his nemesis, Igarasu Yoshia, and will destroy anything that stands in his way."},{"spoiler":false,"text":"From JAST USA"}],"source":"vndb","sourceCharacterId":"c28081"},{"segments":[{"spoiler":false,"text":"東京経済を支配する瀧川商事の食客。"},{"spoiler":false,"text":"刈流兵法といわれる古流剣術の使い手であり、小柄な身体に似合わず凄絶な剣を振るう。"},{"spoiler":false,"text":"宿敵・伊烏義阿との決着に固執するがため、それを邪魔するものは悉く排除しようとするが……。"}],"source":"egs","sourceCharacterId":"12220","sourceWorkId":"6193","spoiler":false},{"segments":[{"spoiler":false,"text":"本篇的主人公。"},{"spoiler":false,"text":"支配东京经济的泷川商事的食客。"},{"spoiler":false,"text":"身缠女式绯色和服，腰插有着「风」之异名的长二尺三寸三分之刀『藤原光秋』。"},{"spoiler":false,"text":"执着于和宿敌・伊乌义阿的对决，为此不惜排除一切碍事之物。"},{"spoiler":false,"text":"身为名为刈流兵法的古流剑术的使用者，其那与娇小身材极不相称的凄惨之剑，宛如呼吸一般流畅地挥洒着死尸与灾厄。"},{"spoiler":false,"text":"「没有才气没有剑心玩弄刀刃的蠢货。在你配得的凄惨中死去吧」"}],"source":"bangumi","sourceCharacterId":"24554"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/068cd4233fd168c7d08e840e8faccdb2d791fbbf8f8ca501dbf5193e24678922.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef48fbed1a3e5bd259582653fc8a14f64dd58713186a43180b7b6dc83bcac9d7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤原美央子","creatorId":"vndb:s462","sourcePersonId":"vndb:s462","canonicalEntityId":"vndb:s462","name":"藤原 美央子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:4009:24554:13824:1","source":"bangumi"}]},{"characterId":"char_c28082","characterName":"伊烏 義阿","sourceIds":{"bangumi":[{"characterId":"24555","match":"exact-normalized-name-in-linked-work","subjectId":"4009"}],"egsCharacterIds":["12221"],"vndbCharacterId":"c28082"},"originalCharacterName":"伊烏 義阿","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I've finally found you.\""},{"spoiler":false,"text":"A mercenary in service to the Hokodome-no-Kai, an underground militia that fights to overthrow Takigawa. He was once Akane's elder disciple in the Karuno-ryu school of swordsmanship. Now he pursues Akane relentlessly, seeking vengeance for the murder of his bride-to-be. Igarasu is a master of iai, the art of the draw-and-strike, and wields an inhuman technique known as the Hiru-no-Tsuki."},{"spoiler":false,"text":"From JAST USA"}],"source":"vndb","sourceCharacterId":"c28082"},{"segments":[{"spoiler":false,"text":"非合法武装集団「矛止の会」の傭兵にして、赤音の兄弟子。"},{"spoiler":false,"text":"居合術の達人であり、想い人を殺した赤音を仇と狙う男。"}],"source":"egs","sourceCharacterId":"12221","sourceWorkId":"6193","spoiler":false},{"segments":[{"spoiler":false,"text":"非合法武装集团「矛止之会」的佣兵。"},{"spoiler":false,"text":"曾经与赤音同门学艺，他的师兄。"},{"spoiler":false,"text":"执拗地追寻着杀害了意中人的赤音，想要报仇雪恨。"},{"spoiler":false,"text":"拔刀术达人，拥有被称为「昼之月」的魔之剑技。"},{"spoiler":false,"text":"腰插与赤音之刀出自同一工匠之手的长二尺四寸一分之刀。"},{"spoiler":false,"text":"「洗雪被你这畜生背叛、杀害的她的怨恨」"}],"source":"bangumi","sourceCharacterId":"24555"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5fdab7ef590ea009a90b360ba7597bf9b6745d2c91a25bffc0e3c051a81d7c8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3ad68acb87b9a2802cd6e580d771788e47d69e52c4deadd71618da77a126d5d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花田光","creatorId":"vndb:s2027","sourcePersonId":"vndb:s2027","canonicalEntityId":"vndb:s2027","name":"花田 光","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:4009:24555:4702:1","source":"bangumi"}]},{"characterId":"char_c28083","characterName":"瀧川 弓","sourceIds":{"bangumi":[{"characterId":"24556","match":"exact-normalized-name-in-linked-work","subjectId":"4009"}],"egsCharacterIds":["12222"],"vndbCharacterId":"c28083"},"originalCharacterName":"瀧川 弓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You're the only one I have, Akane.\""},{"spoiler":false,"text":"The president of the Takigawa Corporation. Forced from childhood to behave as a man, she clings to Akane as the only person who wants her to be a woman."},{"spoiler":false,"text":"From JAST USA"}],"source":"vndb","sourceCharacterId":"c28083"},{"segments":[{"spoiler":false,"text":"瀧川商事女社長。"},{"spoiler":false,"text":"男物のスーツに身を包むショートカットの麗人。"},{"spoiler":false,"text":"いつも“八坂”という護衛を近くに置く。"},{"spoiler":false,"text":"赤音を盲愛する彼女に対し、八坂自身はあまり赤音を良く思っていないらしいが……。"}],"source":"egs","sourceCharacterId":"12222","sourceWorkId":"6193","spoiler":false},{"segments":[{"spoiler":false,"text":"泷川商事女社长。"},{"spoiler":false,"text":"穿着男式西装的短发丽人。"},{"spoiler":false,"text":"盲目地爱着赤音。"},{"spoiler":false,"text":"「赤音很强呢」"}],"source":"bangumi","sourceCharacterId":"24556"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbad962baff8b0911342dc2d10a305cd92f6ef1f8564947b9f3e006f6ed2c2dd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bd73af16645b9af2fde38dc3b8edd69cce9a3dd18b22246a0dec63b9449ef79.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松元恵","creatorId":"egs:creator:8999","sourcePersonId":"egs:creator:8999","canonicalEntityId":"egs:creator:8999","name":"松元恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:4009:24556:4515:1","source":"bangumi"},{"creditedName":"守田 羽糸","creatorId":"vndb:s882","sourcePersonId":"vndb:s882","canonicalEntityId":"vndb:s882","name":"芳幸末","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:4426","source":"vndb"}]},{"characterId":"char_c28086","characterName":"桂葉 恭子","sourceIds":{"bangumi":[{"characterId":"24560","match":"exact-normalized-name-in-linked-work","subjectId":"4009"}],"egsCharacterIds":["12223"],"vndbCharacterId":"c28086"},"originalCharacterName":"桂葉 恭子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chief of the Takigawa Corporation's Second Division. As a member of the vice president's faction, she works tirelessly to undermine Yumi's authority."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c28086"},{"segments":[{"spoiler":false,"text":"瀧川商事第二管理局長。"},{"spoiler":false,"text":"実務能力は高いことから、府外からの物資搬入を取仕切っているが、反社長派に組しているらしく、食えない女。"}],"source":"egs","sourceCharacterId":"12223","sourceWorkId":"6193","spoiler":false},{"segments":[{"spoiler":false,"text":"泷川商事第二管理局长。"},{"spoiler":false,"text":"实务能力很高，管理着来自府外的物资搬入。"},{"spoiler":false,"text":"属于反社长派一伙的老谋深算的女人。"},{"spoiler":false,"text":"「啊啦。您有什么不满意的呢？」"}],"source":"bangumi","sourceCharacterId":"24560"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/0575c77647d20777f03fca629217da6cdd14f43f16afe53a266b8d43f94805f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f46ec7b47b88458fe36481f32ab2bab6c44bb962bf897a75be5661fdd535653c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"富山あかり","creatorId":"vndb:s891","sourcePersonId":"vndb:s891","canonicalEntityId":"vndb:s891","name":"歌織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:4009:24560:12717:1","source":"bangumi"}]},{"characterId":"char_vndb_c28084","characterName":"藤原 一輪 光秋","sourceIds":{"vndbCharacterId":"c28084"},"originalCharacterName":"藤原 一輪 光秋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Don't sulk. You know I love you.\""},{"spoiler":false,"text":"An eccentric woman who shares history with both Akane and Igarasu. She watches passively from afar as their conflict proceeds toward its inevitable conclusion."},{"spoiler":false,"text":"From JAST USA"}],"source":"vndb","sourceCharacterId":"c28084"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/ter