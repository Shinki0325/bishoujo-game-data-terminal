"originalCharacterName":"吉原 美桜里","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1024"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"98"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"169"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"99"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"柊那の通う病院に勤めるナース。"},{"spoiler":false,"text":"柊那とは特に親しく、柊那にとっては「お姉さん」的な存在。"},{"spoiler":false,"text":"肉感的なボディに巨乳。優しく気さくで明るくて、人懐っこい女性。"},{"spoiler":false,"text":"性欲も強く、機会があれば主人公とエッチしたいと思っているらしい。"}],"source":"egs","sourceCharacterId":"26882","sourceWorkId":"3349","spoiler":false},{"segments":[{"spoiler":false,"text":"柊那の通う病院に勤務する看護婦。"},{"spoiler":false,"text":"病院内に数いる看護婦の中でも柊那とは特に親しくしている。「お姉さん」的な存在。"},{"spoiler":false,"text":"柊那に優しい性格を見せる反面、性欲が強く、機会があれば"},{"spoiler":false,"text":"主人公と関係を持ちたいと機会をうかがっている。"}],"source":"bangumi","sourceCharacterId":"48043"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/018a1e0f1e15cc152a337f6263d82f776a74d217e3a6d6ba4ed2e27b1a949f27.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc9b640b9148a3b1ad4cd528faf65c649bb945b5f8936fb7754b706b3f3b0ecb.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c5275","characterName":"南 瑚乃葉","sourceIds":{"bangumi":[{"characterId":"48040","match":"exact-normalized-name-in-linked-work","subjectId":"149736"}],"egsCharacterIds":["26879"],"vndbCharacterId":"c5275"},"originalCharacterName":"南 瑚乃葉","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"721"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染で、同級生。"},{"spoiler":false,"text":"また主人公のバイト先であるメイド喫茶「サザンクロス」のマスターの娘で、抗議のない日は店の手伝いをしている。"},{"spoiler":false,"text":"父親一人に育てられたためか、男優りで強気な面を覗かせるが、人当たりがよく可愛らしい容姿もあって、学園、喫茶店でもアイドル的な人気がある。"},{"spoiler":false,"text":"主人公に対してあれこれ口うるさいが、ほのかな恋心を寄せている。友人の柊那に主人公の告白の手伝いを頼まれ、複雑な想いのまま仲介を引き受ける。"}],"source":"egs","sourceCharacterId":"26879","sourceWorkId":"3349","spoiler":false},{"segments":[{"spoiler":false,"text":"メインヒロインの一人。洋人とは幼馴染であり、同級生でもある。"},{"spoiler":false,"text":"洋人のバイト先である喫茶店のマスターの娘で、講義の無い日は店の手伝いをしている。父親一人の手で育てられたためか、洋人に対しては時折、男勝りの強気な面を見せるところも。多少うるさがられているところもあるが、洋人のことをいつも気遣う世話好きな性格。人当たりもよく、学園の生徒からも喫茶店の客からも好かれている、マドンナ的な存在。友人である柊那に、洋人への告白を手伝って欲しいと相談され、複雑な思いで仲介役となる。"}],"source":"bangumi","sourceCharacterId":"48040"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fd1e8ca218c163dc36b4347ccf10b645de6b490ad61b39cb56ddd35126f0bd0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d793d0e5fd65f3887b583cc07986936c11b7bbd3cd3cf4c32c86bfbaf975a9cd.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c11944","characterName":"ににこ","sourceIds":{"vndbCharacterId":"c11944"},"orig