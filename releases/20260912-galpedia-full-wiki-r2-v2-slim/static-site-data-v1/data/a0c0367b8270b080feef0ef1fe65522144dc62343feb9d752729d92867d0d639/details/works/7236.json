her","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:276411","source":"egs"},{"creditedName":"川合 正起","creatorId":"vndb:s898","sourcePersonId":"vndb:s898","canonicalEntityId":"vndb:s898","name":"川合 正起","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:48801","source":"vndb"},{"creditedName":"キド カヲル","creatorId":"vndb:s3056","sourcePersonId":"vndb:s3056","canonicalEntityId":"vndb:s3056","name":"キド カヲル","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:48806","source":"vndb"},{"creditedName":"下山 真吾","creatorId":"vndb:s10276","sourcePersonId":"vndb:s10276","canonicalEntityId":"vndb:s10276","name":"下山 真吾","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:48807","source":"vndb"}]},"cast":[{"characterId":"char_c30721","characterName":"咲夜","sourceIds":{"bangumi":[{"characterId":"92106","match":"exact-normalized-name-in-linked-work","subjectId":"229779"}],"egsCharacterIds":["25779"],"vndbCharacterId":"c30721"},"originalCharacterName":"咲夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“那霧の里”のくノ一。"},{"spoiler":false,"text":"主人公の妹として幼い頃から一緒に育てられた。"},{"spoiler":false,"text":"里の男たちにも劣らない戦闘力を持ち、また主人公と同じ、特殊な力を持っている。"},{"spoiler":false,"text":"主人公が里を抜けた理由を知るべく、自ら志願して追い忍となった。"}],"source":"egs","sourceCharacterId":"25779","sourceWorkId":"7236","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹として幼い頃から一緒に育てられた少女。今は“追い忍”となり、裏切り者の主人公を追っている。物心つくまえから主人公を慕っていた咲夜は、裏切りの理由を知る為、自ら志願して“追い忍”となる。"},{"spoiler":false,"text":"主人公と同じく生まれついての能力を持っており、その能力を里内部でも秘密にする為、「くノ一」としての教育も主人公が行っていた。"},{"spoiler":false,"text":"「兄様……いや、裏切り者！ 覚悟！」"}],"source":"bangumi","sourceCharacterId":"92106"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b08a1f846ee1222cd1d810a6524dbd46f2c587b942d47e777343657fe2308434.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c73f492926bbc4822683567bff4a7e1f82126b33f27ea9dd8b7ea684b82dabe0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229779:92106:5890:1","source":"bangumi"}]},{"characterId":"char_c30722","characterName":"蛍","sourceIds":{"bangumi":[{"characterId":"92107","match":"exact-normalized-name-in-linked-work","subjectId":"229779"}],"egsCharacterIds":["25780"],"vndbCharacterId":"c30722"},"originalCharacterName":"蛍","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“那霧の里”のくノ一。"},{"spoiler":false,"text":"妾の子として生まれた、主人公の異母兄妹。"},{"spoiler":false,"text":"“妾の子”である自分を妹として扱ってくれた主人公に秘めた想いを持つ。またくノ一として育ててくれたのも主人公だった。"},{"spoiler":false,"text":"忍者としても優秀で、蟲を使った術に長けているが、特殊能力を持つ咲夜に対して強い劣等感を抱いている。"},{"spoiler":false,"text":"敵側に寝返った主人公と、返り討ちに遭った咲夜、二人の抹殺の任を受ける。"}],"source":"egs","sourceCharacterId":"25780","sourceWorkId":"7236","spoiler":false},{"segments":[{"spoiler":false,"text":"“那霧の里”のくノ一。"},{"spoiler":false,"text":"妾の子として生まれた、緋影の異母姉妹。自分に「くノ一」の教育を行い、なにより“妾の娘”だということを差別せずに接してくれた主人公に対して秘めた想いを抱く。しかし、優秀で美しく、そして特殊な能力を持つ咲夜に対して劣等感を抱いていた。"},{"spoiler":false,"text":"咲夜に負けまいと言う想いがそうさせたのか、現在では“蟲”を自在に使役するすべを身に付けている。"},{"spoiler":false,"text":"裏切り者の主人公、そして身体に秘密を抱えたまま捕らえられた咲夜、二人を抹殺する任を受け、追い忍となってやってくる。"},{"spoiler":false,"text":"「しょせんは裏切り者、ふたりまとめて片付けてくれる！」"}],"source":"bangumi","sourceCharacterId":"92107"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e013b6ca9386cbd61e4f0dfad4f2806b47ddb619855fa4d7373a58c4e0b2ef5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f5e503b8624468f44c79b809ed3e58ea48724ff9a5eaa830e0cd253bff0633d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永見はるか","creatorId":"vndb:s452","sourcePersonId":"vndb:s452","canonicalEntityId":"vndb:s452","name":"永見 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229779:92107:4674:1","source":"bangumi"}]},{"characterId":"char_c30723","characterName":"朱火","sourceIds":{"bangumi":[{"characterId":"92108","match":"exact-normalized-name-in-linked-work","subjectId":"229779"}],"egsCharacterIds":["25781"],"vndbCharacterId":"c30723"},"originalCharacterName":"朱火","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“卍谷”のくノ一。"},{"spoiler":false,"text":"卍谷党首・兵衛の命を受けた、主人公の目付け役。"},{"spoiler":false,"text":"明るく、飄々としていて、つかみどころがなく、敵味方から恐れられた主人公に対しても態度を変えない。"},{"spoiler":false,"text":"戦闘になると、普段の彼女からは想像できないほど冷徹になる。"}],"source":"egs","sourceCharacterId":"25781","sourceWorkId":"7236","spoiler":false},{"segments":[{"spoiler":false,"text":"卍谷頭領 兵衛に使えるくノ一。兵衛の命を受けた、主人公の目付け役。"},{"spoiler":false,"text":"やけに明るく、つかみ所のない性格。普段は女の色香を振りまき飄々としているが、こと戦闘になると冷徹。敵味方問わず“朧目”と恐れられる主人公に対しても言葉はばからず、ずけずけと物を言う。"},{"spoiler":false,"text":"「例え愛する者でも、"},{"spoiler":false,"text":"掟のために殺さなければならない…悲しい話さ…」"}],"source":"bangumi","sourceCharacterId":"92108"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bfdd02a903cc23b29c879d9362f54e8a816