s23733","name":"臼田裕次郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:179455","source":"vndb"},{"creditedName":"桐下 暁","creatorId":"vndb:s31572","sourcePersonId":"vndb:s31572","canonicalEntityId":"vndb:s31572","name":"Sous le Paulownia","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:179457","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c101077","characterName":"鈴蘭","sourceIds":{"vndbCharacterId":"c101077"},"originalCharacterName":"鈴蘭","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"C"},"height":{"reviewState":"source-only","source":"vndb","value":"154"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"source-only","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Suzuran came to Akihabara with Kikyou in order to carry out a certain mission."},{"spoiler":false,"text":"Suzuran is a ninja who suffers from a typical Chuunibyou's delusions of grandeur. She claims that one of her eyes is a different color because it's her \"evil eye,\" but she simply has a color contact put in. The truth behind the bandage she has wrapped around one arm, which she insists is \"the black dragon from the demon world that I sealed away,\" is actually..."},{"spoiler":false,"text":"Even though Suzuran likes to make fun of the airheaded Kikyou, her jokes tend to miss the mark, and she often ends up being made fun of by the main character instead."},{"spoiler":false,"text":"\"Hmph... You shouldn't speak so brazenly. It makes you look weak.\""}],"source":"vndb","sourceCharacterId":"c101077"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/861347ab14fe632a86cb1820e8adf8339398e980fc9a4d776e7c75e3f0ca90eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e151a806502192e751b3975a7fb787888405e6679fa063c37c5644f0587ecf34.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小波 すず","creatorId":"vndb:s14338","sourcePersonId":"vndb:s14338","canonicalEntityId":"vndb:s14338","name":"藤沢 れい香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89697","source":"vndb"}]},{"characterId":"char_vndb_c101078","characterName":"桔梗","sourceIds":{"vndbCharacterId":"c101078"},"originalCharacterName":"桔梗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"G"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"},"weight":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female ninja from the same village as Suzuran."},{"spoiler":false,"text":"Innocent, ditzy, and erotic, Kikyou is a ninja who acts like an older sister."},{"spoiler":false,"text":"Although Kikyou has a little more common sense than Suzuran, she's an airhead, and not exactly the brightest girl. She's admired as if she were an older sister to Suzuran, however, she gets a lot of flack from Suzuran due to her clumsiness. When it comes to Suzuran's Chuunibyou antics, Kikyou regards her with warmth and understanding. She may be a ditz, but she's a first-rate ninja. For some reason, there are a lot of cases when she ends up the victim of the main character's accidental groping."},{"spoiler":false,"text":"She's practically a machine for creating sexual situations out of thin air."},{"spoiler":false,"text":"\"Just call me Kikyou.\""}],"source":"vndb","sourceCharacterId":"c101078"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/516a48e1b24a06a86a9c91408d1c2d4a8eb4a155995e5dca9ecb8cb0e7ff6eeb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b64ee550cb535818c271772d43de78a5f2ccc07942847b1a31ae0692493fb5d4.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"のはら ゆうか","creatorId":"vndb:s5060","sourcePersonId":"vndb:s5060","canonicalEntityId":"vndb:s5060","name":"みたか りん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89699","source":"vndb"}]},{"characterId":"char_vndb_c103106","characterName":"主人公","sourceIds":{"vndbCharacterId":"c103106"},"originalCharacterName":"主人公","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c103107","characterName":"主人公","sourceIds":{"vndbCharacterId":"c103107"},"originalCharacterName":"主人公","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c87835","characterName":"すみれ","sourceIds":{"vndbCharacterId":"c87835"},"originalCharacterName":"すみれ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"},"weight":{"reviewState":"source-only","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The only daughter of the Ninja Village chief."},{"spoiler":false,"text":"Already has the sufficient qualities, ability and knowledge of a ninja, but is a natural clutz and always making mistakes. Ordered to train by her father, she has left the ninja village hidden in the mountains and left for the city. Leaving the mountains without any food or a coin in her pocket, she passes out from hunger. There she is saved by the main character who happened to pass by."},{"spoiler":false,"text":"In order to repay the debt of saving her life, she barges into the main character's house as an univited guest. Loves to eat and is always pigging out!"},{"spoiler":false,"text":"\"My master is the one who is most dear to me... Even if it means risking my life, I'll protect him.\""}],"source":"vndb","sourceCharacterId":"c87835"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/014716e69039981c5ef1649b032f32baa6038dbd4d8c0ddf160d159656f03c1a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b387b6e45fd7d32ec71d40fee641cd3eb87f843674c13fc4becd7150ed665a5.webp","width":216,"height":256,"source":"static-detail"},"actors":[{"creditedName":"尾野山みか","creatorId":"vndb:s943","sourcePersonId":"vndb:s943","canonicalEntityId":"vn