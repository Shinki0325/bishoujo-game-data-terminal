vn-staff:104627","source":"vndb"},{"creditedName":"福山 恭子","creatorId":"vndb:s50769","sourcePersonId":"vndb:s50769","canonicalEntityId":"vndb:s50769","name":"福山 恭子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:104628","source":"vndb"}]},"cast":[{"characterId":"char_c17921","characterName":"常盤 イツカ","sourceIds":{"bangumi":[{"characterId":"23142","match":"exact-normalized-name-in-linked-work","subjectId":"87370"}],"egsCharacterIds":["3387"],"vndbCharacterId":"c17921"},"originalCharacterName":"常盤 イツカ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"地方にある全寮制の学園に通う三年生で、身長、体重、学力は平均程度。スポーツは得意な方。明るく前向きなムードメーカー。また責任感が強かったので、所属していたサッカー部では最近まで主将を務めていた。現在は受験を控え、主将の交代は済んでいる。"},{"spoiler":false,"text":"しかし最近はふさぎ込む事が多く、神経質で精神的に不安定。人知れず泣いている時もある。これまでの彼とは逆の印象が強くなっている。そこには何か、大きな原因があるようだが………？"}],"source":"egs","sourceCharacterId":"3387","sourceWorkId":"19791","spoiler":false},{"segments":[{"spoiler":false,"text":"地方にある全寮制の学園に通う三年生で、身長・体重・学力は平均程度。 スポーツは得意なほう。"},{"spoiler":false,"text":"明るく前向きなムードメーカー。 また責任感が強かったので、所属していたサッカー部では最近まで主将を務めていた。"},{"spoiler":false,"text":"現在は受験を控え、主将の交代は済んでいる。"},{"spoiler":false,"text":"しかし最近はふさぎ込むことが多く、神経質で精神的に不安定。"},{"spoiler":false,"text":"人知れず泣いている時もあり、これまでの彼とは逆の印象が強くなっている。"},{"spoiler":false,"text":"そこには何か、大きな原因があるようだが……？"},{"spoiler":false,"text":"「お前は強いな、夕顔。 その強さの半分でも、俺に備わっていれば………」"}],"source":"bangumi","sourceCharacterId":"23142"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b689f7b27e71200cb7fc5b5ecc83d71e8f5a0572641b4f6aa94e3e4ba730fa74.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b476839765ab2599652a3a93523ef30bdcbda164c30af05f88f78196203220b4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"興津和幸","creatorId":"vndb:s85","sourcePersonId":"vndb:s85","canonicalEntityId":"vndb:s85","name":"興津 和幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:87370:23142:5007:1","source":"bangumi"}]},{"characterId":"char_c17922","characterName":"舞弦 朝顔","sourceIds":{"bangumi":[{"characterId":"23143","match":"exact-normalized-name-in-linked-work","subjectId":"87370"}],"egsCharacterIds":["3383"],"vndbCharacterId":"c17922"},"originalCharacterName":"舞弦 朝顔","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"イツカの幼馴染みの一人。イツカと同じく地元の出身で、実家は隣同士。幼馴染みゆえに付き合いが長く、イツカと最も仲が良い存在。また最も恋人に近い存在でもある。"},{"spoiler":false,"text":"性格は活発で単純。運動も得意で、最近まで所属していた陸上部では好記録を残している。性格と体力のおかげで、イツカとは相性が良いのだが、お互いに素直ではないのでぶつかり合う事がしばしば。いつも殴り合いレベルのスキンシップを繰り返している。"},{"spoiler":false,"text":"朝顔には双子の妹がいて、名前は夕顔。夕顔は朝顔とは反対に、内向的で大人しい。朝顔はそれに対してコンプレックスを抱えている。"}],"source":"egs","sourceCharacterId":"3383","sourceWorkId":"19791","spoiler":false},{"segments":[{"spoiler":false,"text":"イツカの幼なじみの一人。 イツカと同じく地元の出身で、実家は隣同士。"},{"spoiler":false,"text":"幼なじみゆえに付き合いが長く、イツカと最も仲が良い存在。 また最も恋人に近い存在でもある。"},{"spoiler":false,"text":"性格は活発で単純。 運動も得意で、最近まで所属していた陸上部では好記録を残している。"},{"spoiler":false,"text":"性格と体力のおかげでイツカとは相性が良いのだが、お互いに素直ではないのでぶつかり合うことがしばしば。"},{"spoiler":false,"text":"いつも殴り合いレベルのスキンシップを繰り返している。"},{"spoiler":false,"text":"朝顔には双子の妹がいて、名前は夕顔。"},{"spoiler":false,"text":"夕顔は朝顔とは反対に、内向的でおとなしい。 朝顔はそれに対してコンプレックスを抱えている。"},{"spoiler":false,"text":"「イツカ、余計な事は考えないで、黙ってついてきなさい」"}],"source":"bangumi","sourceCharacterId":"23143"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92b4aaed4a309eea15c40465ffc0d266f7080a1e6d29f790cae59579edc70ced.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba68469081b91094f5e6d11e220ee611b1072435bba05c6419360f6fcb1fbdd1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山本希望","creatorId":"vndb:s1455","sourcePersonId":"vndb:s1455","canonicalEntityId":"vndb:s1455","name":"山本 希望","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:87370:23143:7147:1","source":"bangumi"}]},{"characterId":"char_c17923","characterName":"本並 栞","sourceIds":{"bangumi":[{"characterId":"23144","match":"exact-normalized-name-in-linked-work","subjectId":"87370"}],"egsCharacterIds":["3384"],"vndbCharacterId":"c17923"},"originalCharacterName":"本並 栞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"イツカ達のクラスの担任教師。イツカと出会ったのは、教育実習の時。イツカが一年生の時に、栞が教育実習生としてクラスにやって来た。担当は国語。国立大卒の才女なので、物理学などにも通じている。"},{"spoiler":false,"text":"性格は社交的で親しみやすく、心優しい。しかし映画などに影響を受け易く、そのうえ手先が不器用でおっちょこちょい。その為、しばしば映画で見たカメラなどを購入し、使いこなせないという事件が発生する。だがそうやって大人と子供の部分を併せ持っている事が、かえって学園生達に慕われる結果となっている。"},{"spoiler":false,"text":"栞は地元で有名な本並家のお嬢様なので、親が決めた婚約者がいる。これに関して学園生の多くが、結婚はもう少し大人になってからの方が良いと心配している。"}],"source":"egs","sourceCharacterId":"3384","sourceWorkId":"19791","spoiler":false},{"segments":[{"spoiler":false,"text":"イツカたちのクラスの担任教師。"},{"spoiler":false,"text":"イツカと初めて出会ったのは教育実習の時。一年生の時にやって来た。"},{"spoiler":false,"text":"担当は国語。 国立大卒の才女なので、物理学などにも通じている。"},{"spoiler":false,"text":"性格は社交的で親しみやすく、心優しい。 映画などの影響を受けやすく、そして手先が不器用でおっちょこちょい。"},{"spoiler":false,"text":"そのため、しばしば映画で見たカメラなどを購入し、使いこなせないという事件が発生する。"},{"spoiler":false,"text":"だがそうやって大人と子供の部分を併せ持っていることが、かえって学園生たちに慕われる結果となっている。"},{"spoiler":false,"text":"栞は地元で有名な本並家のお嬢様なので、親が決めた婚約者がいる。"},{"spoiler":false,"text":"これに関して学園生の多くが、結婚はもう少し大人になってからのほうが良いと心配している。"},{