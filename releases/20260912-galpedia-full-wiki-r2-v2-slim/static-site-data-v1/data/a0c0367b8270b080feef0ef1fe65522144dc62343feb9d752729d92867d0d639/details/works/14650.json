:work-creator:196037","source":"egs"},{"creditedName":"七海 真咲","creatorId":"vndb:s2271","sourcePersonId":"vndb:s2271","canonicalEntityId":"vndb:s2271","name":"七海 真咲","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:59001","source":"vndb"},{"creditedName":"櫻龍","creatorId":"vndb:s2769","sourcePersonId":"vndb:s2769","canonicalEntityId":"vndb:s2769","name":"櫻龍","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:59002","source":"vndb"},{"creditedName":"櫻龍","creatorId":"vndb:s2769","sourcePersonId":"vndb:s2769","canonicalEntityId":"vndb:s2769","name":"櫻龍","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:59003","source":"vndb"},{"creditedName":"Myuw","creatorId":"vndb:s11847","sourcePersonId":"vndb:s11847","canonicalEntityId":"vndb:s11847","name":"Myuw","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:59007","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c86432","characterName":"友城 真樹","sourceIds":{"vndbCharacterId":"c86432"},"originalCharacterName":"友城 真樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this story."},{"spoiler":false,"text":"Masaki is an ordinary student. One day, he decided to chase after a mysterious girl to the shrine, little did he know that's when his daily life took a drastic change. The day after, Masaki realized that he has been cursed by a ghost. He has to follow what it says, otherwise he will die."},{"spoiler":false,"text":"Masaki is a very decent player in his school's baseball club, which is in total contrast with his sloppy studying. He is also bad at making conversation with girls, even to his childhood friend Miki."}],"source":"vndb","sourceCharacterId":"c86432"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5ba2d4a21d3c734dc0c11e63767bd2416ad0409d56b03dbd93360ae45673144b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/460ec21a341755d382efd9d79dd15a2eaeea4c2bd8e73481b8c65e9e557f0cbf.webp","width":113,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c86434","characterName":"向野 美樹","sourceIds":{"vndbCharacterId":"c86434"},"originalCharacterName":"向野 美樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Miki is the classmate and childhood friend of the protagonist, Masaki."},{"spoiler":false,"text":"Despite looking like a normal girl from outside appearance, Miki possesses a supernatural power that allows her to communicate with an omnipotent existence. It grants her access to all information from the past, present and future, with a price to pay. Every time Miki uses the power she would get a headache, and the harder to retrieve that information, the more intense the headache becomes."},{"spoiler":true,"text":"Later on in the story, Miki had an accident and was possessed by Sharo - a fox youkai. Because of that, she found herself being hunted down by demons who want his soul. With Sharo's assistance, Miki has to fight those demons in order to keep both Sharo and herself safe."},{"spoiler":false,"text":"A kind and obedient girl, she worries a lot about Masaki's sloppiness in his daily life."}],"source":"vndb","sourceCharacterId":"c86434"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3329263a4675b0269d84d5347222c7f953b442dfbf2d8c7e18998ff