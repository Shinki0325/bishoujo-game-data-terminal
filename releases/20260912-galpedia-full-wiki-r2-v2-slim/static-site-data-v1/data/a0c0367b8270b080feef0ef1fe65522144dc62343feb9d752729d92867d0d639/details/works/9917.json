","relationId":"vndb:vn-staff:61891","source":"vndb"},{"creditedName":"巫浄 スウ","creatorId":"vndb:s644","sourcePersonId":"vndb:s644","canonicalEntityId":"vndb:s644","name":"巫浄 スウ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:61892","source":"vndb"}]},"cast":[{"characterId":"char_c28730","characterName":"アリア・マリアンヌ","sourceIds":{"bangumi":[{"characterId":"94297","match":"exact-normalized-name-in-linked-work","subjectId":"218633"}],"egsCharacterIds":["18793"],"vndbCharacterId":"c28730"},"originalCharacterName":"アリア・マリアンヌ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本編主人公。"},{"spoiler":false,"text":"大国ブルギリア皇国の16騎士の一人。"},{"spoiler":false,"text":"王の勅命の下、帝国に跋扈する邪悪なる魔女を駆るべく、帝国全土を奔走し、その勇名を轟かせている。"},{"spoiler":false,"text":"16騎士の中で最強と呼ばれ、悪を憎み正義を重んじる姿に民衆から絶大な支持を得て、敬われている。"}],"source":"egs","sourceCharacterId":"18793","sourceWorkId":"9917","spoiler":false},{"segments":[{"spoiler":false,"text":"『魔女狩りの騎士～人格転移の檻～』のメインヒロイン。"},{"spoiler":false,"text":"大国ブルギリア皇国の16騎士の一人。"},{"spoiler":false,"text":"王の勅命の下、帝国に跋扈する邪悪なる魔女を駆るべく、帝国全土を奔走し、その勇名を轟かせている。"},{"spoiler":false,"text":"16騎士の中で最強と呼ばれ、悪を憎み正義を重んじる姿に民衆から絶大な支持を得て、敬われている。"},{"spoiler":false,"text":"本作では、彼女が16騎士に任命される前の新兵時代のエピソードが描かれる。"}],"source":"egs","sourceCharacterId":"18793","sourceWorkId":"10412","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公。大国ブルギリア皇国の16騎士の一人。"},{"spoiler":false,"text":"帝国に跋扈する邪悪なる魔女を狩るため、王の勅命のもと、弟で従卒のキリルを引き連れ帝国全土を奔走、その勇名を轟かせている。"},{"spoiler":false,"text":"『16騎士』の中でも最強と謂われ、最も悪を憎む正義の女騎士として民衆からは聖人の様に敬われている。"}],"source":"bangumi","sourceCharacterId":"94297"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65aa1c12d633951a5cd48bda6313c41f75d61bd353b874ce3a5d4e9d680de294.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bb50f3e5233c9058ab5ec3efbb5fadbc81a233755224cdab3bbfc125998a967.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤咲かおり","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"藤咲 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218633:94297:6105:1","source":"bangumi"}]},{"characterId":"char_c28731","characterName":"カラム","sourceIds":{"bangumi":[{"characterId":"94298","match":"exact-normalized-name-in-linked-work","subjectId":"218633"}],"egsCharacterIds":["19210"],"vndbCharacterId":"c28731"},"originalCharacterName":"カラム","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“殺戮武器のマエストロ”として伝説的に畏れられる魔女。"},{"spoiler":false,"text":"魔女には天啓ともいうべく邪悪なる使命があり、それを果たすべく行動していると云われ、彼女は「人の魂を使って最強の武器を精錬する」ことを使命とし、数多くの人々を虐殺しては邪剣を鍛えている。"},{"spoiler":false,"text":"その邪剣の名は「スネーク・ソード」と呼ばれ、彼女を討伐に来た剣士たちをことごとく退けてきた。"}],"source":"egs","sourceCharacterId":"19210","sourceWorkId":"9917","spoiler":false},{"segments":[{"spoiler":false,"text":"『殺戮武器のマエストロ』として伝説的に畏れられる魔女。魔女には天啓ともいうべき邪悪な使命があって、それを果たすべく行動しているという。"},{"spoiler":false,"text":"彼女の場合は、『人の魂を使って最強の武器を精錬する』事を使命としていて、そのため多くの人々を虐殺しては邪剣を鍛えるための血肉としている。"},{"spoiler":false,"text":"その血塗られた剣の名を『スネーク・ソード』と言い、彼女は邪剣を駆って討伐に向った幾人もの剣士たちをあの世へ送り届けている。"}],"source":"bangumi","sourceCharacterId":"94298"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/916d202437a52f5bf251771d5c4708b9176dcc9b0aa87084dda10332192ce0e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/885e0104dcc2cc0683691329e1c9baa1a7930d4789c7056e9200fa8eeb8a6d9a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上みゆ","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218633:94298:6558:1","source":"bangumi"}]},{"characterId":"char_c28732","characterName":"ルーマカ・ボルジア","sourceIds":{"bangumi":[{"characterId":"94299","match":"exact-normalized-name-in-linked-work","subjectId":"218633"}],"egsCharacterIds":["19211"],"vndbCharacterId":"c28732"},"originalCharacterName":"ルーマカ・ボルジア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ブルギリア皇国内ディンランス地方の領主。"},{"spoiler":false,"text":"ブルギリア皇国において、かなり高名な血筋の高級貴族の子として生まれ、その性格は極めて温厚で平和主義者。また縁起を重んじる。"},{"spoiler":false,"text":"ブルギリアにある32の領主の中で最も辣腕と云われている。"}],"source":"egs","sourceCharacterId":"19211","sourceWorkId":"9917","spoiler":false},{"segments":[{"spoiler":false,"text":"ブルギリア皇国内にあるディンランス地方の領主である。"},{"spoiler":false,"text":"ブルギリア皇国ではかなり高名な血筋の高級貴族の生まれで、極めて温厚で平和主義者。また、いわゆる縁起を重んじる。"},{"spoiler":false,"text":"現在、ブルギリアにある32の領主のうちでも一番の辣腕と噂される。"}],"source":"bangumi","sourceCharacterId":"94299"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6da09b27f7525867ac4c2d81149f8159f46763474af1a410a35db236ba6d3144.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/6701a0cf944987a5a20b64b8d467bcf1415d719c7f9a10bc4ae5c1635c8be914.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹間千ノ美","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218633:94299:19333:1","source":"bangumi"}]},{"characterId":"char_c28733","characterName":"ノア","sourceIds":{"bangumi":[{"characterId":"94300","match":"exact-normalized-name-in-linked-work","subjectId":"218633"}],"egsCharacterIds":["19212"],"vndbCharacterId":"c28733"},"originalCharacterName":"ノア","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ディンランス地方の領主・ルーマカに傅くメイド。"},{"spoiler":false,"text":"幼少の頃よりルーマカに仕えてきた。"},{"spoiler":false,"text":"純粋無垢で明るく素直、誰からも好かれる心優しき性格。"},{"spoiler":false,"text":"街に訪れたアリア一行の案内役を務める。"}],"source":"egs","sourceCharacterId":"19212","sourceWorkId":"9917","spoiler":false},{"segments":[{"spoiler":false,"text":"ディンランス地方の領主ルーマカの屋敷のメイド。"},{"spoiler":false,"text":"子供の頃から領主ルーマカに仕えている。純真無垢で明るく素直な性格で、誰からも好かれる清楚な美少女。"},{"spoiler":false,"text":"街を訪れたアリアとキリルの一行の案内役となる。"}],"source":"bangumi","sourceCharacterId":"94300"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b92f2d1e663c1382b4f759cd8dfb9ec07696e4c1cd9da0e0c65a030ee09ee636.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31f1dafe9bb8583bce06a10fcf676a99479faf0f97475f333390bf4fbd38bb97.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由倉奈於","creatorId":"vndb:s923","sourcePersonId":"vndb:s923","canonicalEntityId":"vndb:s923","name":"由倉 奈於","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218633:94300:6083:1","source":"bangumi"}]},{"characterId":"char_c28734","characterName":"キリル・マリアンヌ","sourceIds":{"bangumi":[{"characterId":"94301","match":"exact-normalized-name-in-linked-work","subjectId":"218633"}],"egsCharacterIds":["19213"],"vndbCharacterId":"c28734"},"originalCharacterName":"キリル・マリアンヌ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アリアの弟。"},{"spoiler":false,"text":"大国ブルギリア皇国の士官学校を卒業後、姉の従卒として魔女討伐の任務に就いている。"},{"spoiler":false,"text":"民衆から英雄的に敬われ、それに恥じない活躍をみせる姉に憧憬と尊敬を抱いている。"},{"spoiler":false,"text":"まだまだ見聞が狭く、世間知らずなところも多々あり、姉に頼りがち。"},{"spoiler":false,"text":"それでも憧れの姉に一人前の男として認めてもらおうと、虎視眈々と功績を得るチャンスを狙っている。"}],"source":"egs","sourceCharacterId":"19213","sourceWorkId":"9917","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・アリアの弟。大国ブルギリア皇国の士官学校を卒業後、姉の従卒として魔女討伐の任務に就いている。"},{"spoiler":false,"text":"姉のことを慕っており、憧憬と尊敬のまなざしでその美しい横顔を眺めることが日課の一つ。"},{"spoiler":false,"text":"姉に対してはワガママだったり甘えん坊だったり、まだまだ世間知らずな幼さを残す少年という風。最近は憧れの姉に一人前の男だと認めてもらいたいと、功績のチャンスを窺っている。"}],"source":"bangumi","sourceCharacterId":"94301"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/4178efe418895b181aaf26ada2d371b8246dc59d7d59274ecb89cd6e040bb2b0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/331e561b44058a24104f7442bcfb81d5f3b59e71212234b1566843e6f4d803ad.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c28735","characterName":"ムンニル","sourceIds":{"vndbCharacterId":"c28735"},"originalCharacterName":"ムンニル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13fe4c01d3e6b9e3d0e16c73f3496f7e8d3df7ceeebd9fe78ba676ae49f71dab.webp","f