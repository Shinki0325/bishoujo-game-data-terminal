e-native","relationId":"vndb:vn-staff:175587","source":"vndb"},{"creditedName":"しまさらゆめき","creatorId":"vndb:s9293","sourcePersonId":"vndb:s9293","canonicalEntityId":"vndb:s9293","name":"しまさらゆめき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:175588","source":"vndb"},{"creditedName":"aina","creatorId":"vndb:s9294","sourcePersonId":"vndb:s9294","canonicalEntityId":"vndb:s9294","name":"aina","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:175589","source":"vndb"},{"creditedName":"グランテール井上","creatorId":"vndb:s9295","sourcePersonId":"vndb:s9295","canonicalEntityId":"vndb:s9295","name":"グランテール井上","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:175590","source":"vndb"},{"creditedName":"こび","creatorId":"vndb:s10984","sourcePersonId":"vndb:s10984","canonicalEntityId":"vndb:s10984","name":"kobi","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:175592","source":"vndb"},{"creditedName":"On-Jin ～音人～","creatorId":"vndb:s18224","sourcePersonId":"vndb:s18224","canonicalEntityId":"vndb:s18224","name":"笠畑 栄樹","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:175593","source":"vndb"}]},"cast":[{"characterId":"char_c98061","characterName":"アルエット","sourceIds":{"bangumi":[{"characterId":"106027","match":"exact-normalized-name-in-linked-work","subjectId":"339900"}],"egsCharacterIds":["23715"],"vndbCharacterId":"c98061"},"originalCharacterName":"アルエット","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"プエラリウムに突如として迷いこんだ異端者。「メイデン」の資質が認められたため、規則に従って入学を許可される。"},{"spoiler":false,"text":"溌溂とした頬に無垢なまなざし、軽やかな所作。ひとりだけ春をまとったような少女。"},{"spoiler":false,"text":"明るく優しい性格で、生徒たちの排他的な態度に遭っても、委縮したり反発したりしない。"},{"spoiler":false,"text":"本来は楽しいもの・ことが好きで、この学園の異様な禁欲に戸惑う場面も多いが、なんとか場に馴染もうと努力しつづける。"},{"spoiler":false,"text":"ひょんなことから「夜の学園」の姿を目撃し、異形の者とルクとの戦いに巻きこまれていくことになる。"}],"source":"egs","sourceCharacterId":"23715","sourceWorkId":"31275","spoiler":false},{"segments":[{"spoiler":false,"text":"プエラリウムに突如として迷いこんだ異端者。「メイデン」の資質が認められたため、規則に従って入学を許可される。"},{"spoiler":false,"text":"溌溂とした頬に無垢なまなざし、軽やかな所作。ひとりだけ春をまとったような少女。"},{"spoiler":false,"text":"明るく優しい性格で、生徒たちの排他的な態度に遭っても、委縮したり反発したりしない。"},{"spoiler":false,"text":"本来は楽しいもの・ことが好きで、この学園の異様な禁欲に戸惑う場面も多いが、なんとか場に馴染もうと努力しつづける。"},{"spoiler":false,"text":"ひょんなことから「夜の学園」の姿を目撃し、異形の者とルクとの戦いに巻きこまれていくことになる。"},{"spoiler":false,"text":"突然闯入普埃拉利姆的外来者。"},{"spoiler":false,"text":"因被认可具有「少女」的资质而依照制度获准入学。"},{"spoiler":false,"text":"她的脸颊朝气蓬勃，目光纯洁无瑕，举止轻盈欢快。"},{"spoiler":false,"text":"唯有这位少女的周身仿佛萦绕着烂漫的春日气息。"},{"spoiler":false,"text":"她的性格开朗而温柔，即使遭到其他学生的排挤，也不会退缩或反抗。"},{"spoiler":false,"text":"本质上钟爱新鲜有趣的事物，尽管时常对这所学园异样的禁欲感到困惑，也依然在想办法努力融入其中。"},{"spoiler":false,"text":"意外目睹「夜晚的学园」所呈现的样貌后，她被卷入了异形者与露珂的战斗中。"}],"source":"bangumi","sourceCharacterId":"106027"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/165931af3e95b02c62ac9d53d9b87fd6925e80014dc566105449320b8fce0b61.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fbd461a350d43093efc3cc9bbd0c941673645e7abadd056ef9372e3c4b321fd2.webp","width":162,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ミルノ純","creatorId":"vndb:s564","sourcePersonId":"vndb:s564","canonicalEntityId":"vndb:s564","name":"ミルノ 純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:339900:106027:6167:1","source":"bangumi"}]},{"characterId":"char_c98062","characterName":"ルク","sourceIds":{"bangumi":[{"characterId":"106028","match":"exact-normalized-name-in-linked-work","subjectId":"339900"}],"egsCharacterIds":["23716"],"vndbCharacterId":"c98062"},"originalCharacterName":"ルク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"特進クラス１位。教師のアドラーからも一目置かれている、エヴァーメイデン筆頭候補。"},{"spoiler":false,"text":"氷のような瞳、作り物めいた青白い肌、闇よりも濃い黒髪。冬の夜を思わせる孤高の少女。"},{"spoiler":false,"text":"常に無表情で寡黙、他者との交流を好まない、孤高の少女。常に学園の規律に殉じ、一切の無駄を排して「メイデン」としての己を高めつづける。"},{"spoiler":false,"text":"朝起きたあとは跪いて祈りの言葉を口ずさむ。「汝、花園にありて、花を手折ることなかれ」"},{"spoiler":false,"text":"異界と化した夜の学園で、得体のしれない怪物と戦っている。"}],"source":"egs","sourceCharacterId":"23716","sourceWorkId":"31275","spoiler":false},{"segments":[{"spoiler":false,"text":"特進クラス１位。教師のアドラーからも一目置かれている、エヴァーメイデン筆頭候補。"},{"spoiler":false,"text":"氷のような瞳、作り物めいた青白い肌、闇よりも濃い黒髪。冬の夜を思わせる孤高の少女。"},{"spoiler":false,"text":"常に無表情で寡黙、玲瓏たる雰囲気と厳格な言動で、他者を寄せつけない。常に学園の規律に殉じ、一切の無駄を排して「メイデン」としての己を高めつづける。"},{"spoiler":false,"text":"朝起きたあとは跪いて祈りの言葉を口ずさむ。"},{"spoiler":false,"text":"「汝、花園にありて、花を手折ることなかれ」"},{"spoiler":false,"text":"異界と化した夜の学園で、得体のしれない怪物と戦っている。"},{"spoiler":false,"text":"特进班首席。"},{"spoiler":false,"text":"永恒少女的最佳候选人，就连老师阿德拉也对她另眼相看。"},{"spoiler":false,"text":"冷彻如冰的眼眸、工艺品般苍白的肌肤、比黑夜更为深邃的秀发。"},{"spoiler":false,"text":"这位孤高的少女让人联想到冬天的夜晚。"},{"spoiler":false,"text":"她总是面无表情、沉默寡言，以凛然的气质和严谨的言行拒绝他人的靠近。"},{"spoiler":false,"text":"同时还始终恪守学园制度，并摒弃一切杂念，不断磨练身为「少女」的自己。"},{"spoiler":false,"text":"早晨醒来后，她会跪地吟诵祈祷词。"},{"spoiler":false,"text":"「汝，身处此园，莫折其花」"},{"spoiler":false,"text":"夜晚时分则在化作异界的学园中，与来历不明的怪物战斗着。"}],"source":"bangumi","sourceCharacterId":"106028"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d0ade456fe2f1decc0334beff0c50124e3831135cbe46cf9e8ef0d787e864c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/980bad944be87bd7780095d14d71d7b4d3d02a7b7fbf48db98c15bcfb7a5e311.webp","width":162,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:339900:106028:8580:1","source":"bangumi"}]},{"characterId":"char_c98063","characterName":"アヴェルラ","sourceIds":{"bangumi":[{"characterId":"106029","match":"exact-normalized-name-in-linked-work","subjectId":"339900"}],"egsCharacterIds":["23717"],"vndbCharacterId":"c98063"},"originalCharacterName":"アヴェルラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"特進クラス２位。"},{"spoiler":false,"text":"美しい容姿と優雅な所作で人を魅了する、誰よりも華やかな少女。"},{"spoiler":false,"text":"負けず嫌いかつプライドの高い性格で、高圧的に振舞うことが多い。「外部から紛れこんで居ついた怪しい存在」であるアルエットへは露骨な嫌悪や侮蔑を口にする。"},{"spoiler":false,"text":"パヴォーネ曰く、「アヴェルラ女王様にとっては、この学園の生徒全員が敵か手駒なのよ」。"},{"spoiler":false,"text":"エヴァーメイデンへの執着が人一倍強く、１位であるルクに対抗意識を燃やしている。"}],"source":"egs","sourceCharacterId":"23717","sourceWorkId":"31275","spoiler":false},{"segments":[{"spoiler":false,"text":"特進クラス２位。"},{"spoiler":false,"text":"美しい容姿と優雅な所作で人を魅了する、誰よりも華やかな少女。"},{"spoiler":false,"text":"負けず嫌いかつ気位の高い性格で、高圧的に振舞うことが多い。「外部から紛れこんで居ついた怪しい存在」であるアルエットへは露骨な嫌悪や侮蔑を口にする。"},{"spoiler":false,"text":"エヴァーメイデンへの執着が人一倍強く、１位であるルクに対抗意識を燃やしている。"},{"spoiler":false,"text":"パヴォーネ曰く、「アヴェルラ女王様にとっては、この学園の生徒全員が敵か手駒なのよ」。"},{"spoiler":false,"text":"特进班次席。"},{"spoiler":false,"text":"这位少女拥有摄人心魄的美艳容貌与优雅举止，且华丽夺目无人能及。"},{"spoiler":false,"text":"她争强好胜、气傲心高，往往表现得很霸道。"},{"spoiler":false,"text":"此外，还毫不掩饰对阿尔艾特这一「从外部混进来的可疑存在」的厌恶与蔑视。"},{"spoiler":false,"text":"她对永恒少女的执着远胜过他人，并对首席露珂抱有强烈的竞争意识。"},{"spoiler":false,"text":"帕沃尼曰「对阿薇拉女王陛下来说，其他学生不是敌人就是手下啦」。"}],"source":"bangumi","sourceCharacterId":"106029"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74540a22ab66a631386e719582c5fa417190879c058b6bac403b28c77040a457.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcacbd0c9d29965de7cf84dafef1f70fc2537e858bc8246644a5c7be88ccae92.webp","width":152,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤原由林","creatorId":"vndb:s992","sourcePersonId":"vndb:s992","canonicalEntityId":"vndb:s992","name":"藤原 由林","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:339900:106029:25037:1","source":"bangumi"}]},{"characterId":"char_c98064","characterName":"ロビン","sourceIds":{"bangumi":[{"characterId":"106030","match":"exact-normalized-name-in-linked-work","subjectId":"339900"}],"egsCharacterIds":["23718"],"vndbCharacterId":"c98064"},"originalCharacterName":"ロビン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"特進クラス３位。"},{"spoiler":false,"text":"燃えるような赤い髪に黄金の瞳、野性的で凛々しい少女。"},{"spoiler":false,"text":"アドラーの目のあるところでは如才なく振舞うが、本来は大胆かつ奔放な気質で、口調もざっくばらん。旺盛な知識欲を満たすために、時間があれば図書室で本を読んでいる。"},{"spoiler":false,"text":"他者に対しては良くも悪くも無関心で、アルエットの入学に関してもあまり思うところはない様子。"},{"spoiler":false,"text":"ただ、キャナリーだけは気に入らないようで、何かと強く当たる。"}],"source":"egs","sourceCharacterId":"23718","sourceWorkId":"31275","spoiler":false},{"segments":[{"spoiler":false,"text":"特進クラス３位。"},{"spoiler":false,"text":"燃えるような赤い髪に黄金の瞳、野性的で凛々しい少女。"},{"spoiler":false,"text":"アドラーの目のあるところでは如才なく振舞うが、本来は大胆かつ奔放な気質で、口調もざっくばらん。旺盛な知識欲を満たすために、時間があれば図書室で本を読んでいる。"},{"spoiler":false,"text":"他者に対しては良くも悪くも無関心で、アルエットの入学に関してもあまり思うところはない様子。"},{"spoiler":false,"text":"ただ、キャナリーだけは気に入らないようで、何かと強く当たる。"},{"spoiler":false,"text":"特进班中位列第三。"},{"spoiler":false,"text":"有着火红的头发和金色的眼睛，野性凛然的少女。"},{"spoiler":false,"text":"虽然在阿德拉面前表现得稳重端庄，但她其实大胆而奔放，说起话来也直言无讳。"},{"spoiler":false,"text":"为了满足自身旺盛的求知欲，有时间就会泡在图书馆看书。"},{"spoiler":false,"text":"她并不关心其他人是好是坏，而且对阿尔艾特的入学也没有什么意见。"},{"spoiler":false,"text":"但似乎唯独不喜欢卡娜莉，对待她总是更为刻薄。"}],"source":"bangumi","sourceCharacterId":"106030"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65ad141aa7c41eba0626952f71b4408698db6c88346f698e2b6a1bdbcaf22774.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40b748204dd9219619063d0f20d694796fc00b61f95f25bc4fd7d12f2aa4f572.webp","width":165,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:339900:106030:5741:1","source":"bangumi"}]},{"characterId":"char_c98065","characterName":"キャナリー","sourceIds":{"bangumi":[{"characterId":"106031","match":"exact-normalized-name-in-linked-work","subjectId":"339900"}],"egsCharacterIds":["23719"],"vndbCharacterId":"c98065"},"originalCharacterName":"キャナリー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"特進クラス４位。"},{"spoiler":false,"text":"妖精の絵画から抜け出てきたような、儚げで可憐な少女。"},{"spoiler":false,"text":"おっとりとした気質で、押しに弱く、周囲を窺いすぎて自分の意見を呑みこむこともしばしば。"},{"spoiler":false,"text":"アルエットの世話係という貧乏くじを引くことになるが、本人に嫌がるそぶりはなく、親身に面倒を見る。"},{"spoiler":false,"text":"アルエットからすると最初から穏やかに接してくれる優しい人物だが、何故かロビンからは嫌われているようだ。"}],"source":"egs","sourceCharacterId":"23719","sourceWorkId":"31275","spoiler":false},{"segments":[{"spoiler":false,"text":"特進クラス４位。"},{"spoiler":false,"text":"妖精の絵画から抜け出てきたような、儚げで可憐な少女。"},{"spoiler":false,"text":"おっとりとした気質で、押しに弱く、周囲を窺いすぎて自分の意見を呑みこむこともしばしば。"},{"spoiler":false,"text":"アルエットの世話係という貧乏くじを引くことになるが、本人に嫌がるそぶりはなく、親身に面倒を見る。"},{"spoiler":false,"text":"アルエットからすると最初から穏やかに接してくれる優しい人物だが、何故かロビンからは嫌われているようだ。"},{"spoiler":false,"text":"特进班中位列第四。"},{"spoiler":false,"text":"这位少女梦幻而可爱，如同从绘有精灵的画卷中走出来的一样。"},{"spoiler":false,"text":"她为人稳重、温顺老实，常常因为过于在意周围而压抑自身的看法。"},{"spoiler":false,"text":"虽不幸成为了阿尔艾特的看护人，但她本人并没有表现不情愿，反而无微不至地照顾着阿尔艾特。"},{"spoiler":false,"text":"在阿尔艾特看来，她自始至终都温和待人，是个亲切温柔的人，但不知为何，萝宾似乎并不喜欢她。"}],"source":"bangumi","sourceCharacterId":"106031"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9a85231a1c6e64e71d31aa819ace6556ab25ff07923581eb67cd99b891401e8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eea8b4fe976faf1106389d8409f4abe717513c35c2ac985eafbc66c20b53c823.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西連寺亜希","creatorId":"vndb:s14876","sourcePersonId":"vndb:s14876","canonicalEntityId":"vndb:s14876","name":"西連寺 亜希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:339900:106031:36177:1","source":"bangumi"}]},{"characterId":"char_c98066","characterName":"マコー","sourceIds":{"bangumi":[{"characterId":"106032","match":"exact-normalized-name-in-linked-work","subjectId":"339900"}],"egsCharacterIds":["23720"],"vndbCharacterId":"c98066"},"originalCharacterName":"マコー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"特進クラス５位。"},{"spoiler":false,"text":"眼鏡の奥から気丈なまなざしを投げかける、見るからに生真面目な少女。"},{"spoiler":false,"text":"不器用な努力家で、面倒見の良い性格。基本的には規則に従うことを良しとするが、個人の良識を優先してしまうこともある。"},{"spoiler":false,"text":"熱心に勉強に励んでいるものの、要領が悪くて成果を上げきれておらず、最近はさらに調子を落としている。"