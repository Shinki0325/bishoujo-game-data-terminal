d":"vndb:vn-staff:223615","source":"vndb"},{"creditedName":"井元 翔大","creatorId":"vndb:s54091","sourcePersonId":"vndb:s54091","canonicalEntityId":"vndb:s54091","name":"井元 翔大","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:223617","source":"vndb"},{"creditedName":"佐渡 大志","creatorId":"vndb:s54092","sourcePersonId":"vndb:s54092","canonicalEntityId":"vndb:s54092","name":"佐渡 大志","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:223618","source":"vndb"},{"creditedName":"佐渡 大志","creatorId":"vndb:s54092","sourcePersonId":"vndb:s54092","canonicalEntityId":"vndb:s54092","name":"佐渡 大志","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:223619","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c168353","characterName":"女王コロネリア","sourceIds":{"vndbCharacterId":"c168353"},"originalCharacterName":"女王コロネリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Cornelia is the young queen who rules the kingdom of Panetelia. With outstanding political skills, she has led her kingdom to prosperity and is widely beloved by her people."},{"spoiler":false,"text":"However, when Alice first speaks with Cornelia, she receives a harsh glare and cryptic words delivered in a condescending tone."},{"spoiler":false,"text":"This event puzzles Alice greatly, yet there seems to be some deeper reason behind it...?"},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c168353"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6efd304f173cc6d12b0b8a8a86edd67e8ca4e9b2de89dc8d118b6ca2ab1edce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9ae10892c1e4c5416d724deeea1ae5de03ca00f18ff74864680e1e53d3bdabe2.webp","width":175,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川 育美","creatorId":"vndb:s14378","sourcePersonId":"vndb:s14378","canonicalEntityId":"vndb:s14378","name":"長谷川 育美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102577","source":"vndb"}]},{"characterId":"char_vndb_c170364","characterName":"Fran Bluebell","sourceIds":{"vndbCharacterId":"c170364"},"originalCharacterName":"Fran Bluebell","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Fran is Alice's classmate at the Royal Magic Academy."},{"spoiler":false,"text":"Born into the prestigious Bluebell family, Fran quickly rose through the ranks to become a knight of the kingdom at a young age, earning a position as one of the Queen's closest aides. Currently, under a secret order from the Queen, Fran attends the academy as a student."},{"spoiler":false,"text":"Coming from a lineage of knights and burdened by an inferiority complex due to her exceptionally talented elder brother, Fran has chosen to disguise herself as a boy, rigorously training in swordsmanship and magic."},{"spoiler":false,"text":"Yet beneath her stoic exterior, she secretly dreams of wearing cute outfits and some good old-fashioned girly fun...?"},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c170364"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86b9759ae39f9e2afea6ebdc9fbed54f8d7762855fe31d5017816e518226ebc4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b6cf1502b4a747f72a768ac6e116e82240580cdcd80269466333619a0b65c80.webp","width":96,"height":256,"source":"static-detail"},"actors":[{"creditedName":"日笠 陽子","creatorId":"vndb:s616","sourcePersonId":"vndb:s616","canonicalEntityId":"vndb:s616","name":"日笠陽子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102574","source":"vndb"}]},{"characterId":"char_vndb_c170365","characterName":"Crois","sourceIds":{"vndbCharacterId":"c170365"},"originalCharacterName":"Crois","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"When Alice is walking through town, she finds a mysterious girl collapsed by the roadside ─ this is Crois. She works as a close aide to the queen, secretly carrying out various investigations under her orders."},{"spoiler":false,"text":"However, Crois is also a natural-born criminal who repeatedly steals without remorse. Taking bread from bakeries when hungry and emptying shop registers when she's broke."},{"spoiler":false,"text":"After repeatedly stealing, Crois found herself banned from every shop in town, eventually collapsing from hunger. It was Alice who came to her rescue. Ever since, Crois seems to hold special feelings for Alice, who regularly feeds her..."},{"spoiler":false,"text":"On dates with Crois, gently accepting her outrageous behavior and enjoying lots of bread together may bring you closer to her."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c170365"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d915525fb4ff2b9158d53512c561e0608725a4cdc89a63f77da8fd14704bb1d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e3f634a7beec41f792ee2c9362857012c66dcd67d13b798030e3b17683ec606.webp","width":148,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水野朔","creatorId":"vndb:s44075","sourcePersonId":"vndb:s44075","canonicalEntityId":"vndb:s44075","name":"水野朔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102580","source":"vndb"}]},{"characterId":"char_vndb_c170366","characterName":"Chocolat","sourceIds":{"vndbCharacterId":"c170366"},"originalCharacterName":"Chocolat","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chocolat is a healer working at a clinic in the royal capital."},{"spoiler":false,"text":"They first met when Alice fell and injured herself in the street, and Chocolat used her healing magic to help her."},{"spoiler":false,"text":"Usually gentle and beloved by everyone, Chocolat can become quite frightening when angered, concealing an intense severity that might lead her to say things like, \"Anyone who doesn't value their life can die!\""},{"spoiler":false,"text":"On dates with Chocolat, you'll discover her many charming facets: a kind and dependable older sister figure, her strict expression when scolding you, and even her unexpectedly clumsy moments."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c170366"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f6cc194e529bf332518e78ffbdeab10b8ab12f7e17b89cd185a480b0f65bea7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/665a9668356980e49a7536b6862798b4e01ea36d233298ca69e8a04733cdcd54.webp","width":77,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤 静","creatorId":"vndb:s516","sourcePersonId":"vndb:s516","canonicalEntityId":"vndb:s516","name":"伊藤 静","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102573","source":"vndb"}]},{"characterId":"char_vndb_c170370","characterName":"Hasis","sourceIds":{"vndbCharacterId":"c170370"},"originalCharacterName":"Hasis","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hasis is a mysterious young man whom Alice meets in the church."},{"spoiler":false,"text":"He is a highly skilled assassin. Raised from childhood as a member of an assassin organization, his life has revolved around executing targets in a dark and narrow world."},{"spoiler":false,"text":"To Hasis, Alice’s smile was a ray of hope. How will encountering her change the life of this young man who has only known darkness?"},{"spoiler":false,"text":"On dates with Hasis, you'll discover that he's not merely emotionless, but that there’s another side hidden deep within him."},{"spoiler":false,"text":"Gently help him reveal the true feelings he keeps hidden inside."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c170370"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3782a5bb639461a1ec19d11937384e35e2636971ce41874f198e5e34df4dee9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fbcafb17dfce13bebb64e9dcfcbe0314e14b6641fa11602aada8193802f3ae5c.webp","width":85,"height":256,"source":"static-detail"},"actors":[{"creditedName":"島﨑 信長","creatorId":"vndb:s1248","sourcePersonId":"vndb:s1248","canonicalEntityId":"vndb:s1248","name":"島﨑 信長","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102575","source":"vndb"}]},{"characterId":"char_vndb_c170371","characterName":"Noah","sourceIds":{"vndbCharacterId":"c170371"},"originalCharacterName":"Noah","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Noah is a prodigy who entered the Royal Magic Academy through academic acceleration."},{"spoiler":false,"text":"Having grown up entirely dedicated to his studies, Noah excels academically but knows very little about practical subjects, physical activities, or leisure."},{"spoiler":false,"text":"After meeting Alice, Noah finds himself frequently invited on outings to various places. Despite his initial resistance claiming, \"I have to study!,\" he eventually ends up getting dragged around by Alice anyway."},{"spoiler":false,"text":"During dates with Noah, you can expect plenty of heartwarming moments as this usually serious boy's eyes sparkle or as he panics in response to new experiences."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c170371"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb4084f8f81656256f84232d1dcc7a767fb19e20fa0fcdeb1752c8e86b3d1dc4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44a2e8cbbe089ffb09ff05c7a879bb56475d583af15cf5de3b794a2be77adccf.webp","width":142,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青山 吉能","creatorId":"vndb:s36306","sourcePersonId":"vndb:s36306","canonicalEntityId":"vndb:s36306","name":"青山 吉能","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:102579","source":"vndb"}]},{"characterId":"char_vndb_c170372","characterName":"Shail","sourceIds":{"vndbCharacterId":"c170372"},"originalCharacterName":"Shail","characterNameSource":null,"role":