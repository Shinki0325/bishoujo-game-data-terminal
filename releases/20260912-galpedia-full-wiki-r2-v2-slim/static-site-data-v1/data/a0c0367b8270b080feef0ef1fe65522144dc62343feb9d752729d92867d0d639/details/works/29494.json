bangumi","sourceCharacterId":"74076"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3eb210d166714de8af11f8ceac0b76c633be08d080e91078851fb307aba6d890.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad2ee1bfb325c9f0097cb71b3a42d38ce6dd9236f2d7ca2757ba48b9ea35ebd5.webp","width":118,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風音","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87620","source":"vndb"}]},{"characterId":"char_c87621","characterName":"蓮城寺 舞","sourceIds":{"bangumi":[{"characterId":"74077","match":"exact-normalized-name-in-linked-work","subjectId":"295925"},{"characterId":"74077","match":"exact-normalized-name-in-linked-work","subjectId":"319943"}],"egsCharacterIds":["22179"],"vndbCharacterId":"c87621"},"originalCharacterName":"蓮城寺 舞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The daughter of a family that once led one of the pre-war 'zaibatsu' mega-corporations of Japan. She is currently the Captain of the Knights, and she wields a parrying dagger and rapier in matches. She is an effective leader, but her sense of humor and tendency to persistently try to recruit people she thinks will be useful to the knighthood can be off-putting. She is the head of the faction in the knighthood focused on reforming the system, which in the past has had a tendency toward corruption."}],"source":"vndb","sourceCharacterId":"c87621"},{"segments":[{"spoiler":false,"text":"日本有数の財閥の娘にして、見る人を引き付ける魅力を持つカリスマ騎士団長。"},{"spoiler":false,"text":"柔らかな物腰で人当たりと面倒見がいいお姉さん。"},{"s