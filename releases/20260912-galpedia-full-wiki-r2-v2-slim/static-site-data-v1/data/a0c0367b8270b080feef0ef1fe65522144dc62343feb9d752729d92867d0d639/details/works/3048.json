lationId":"vndb:vn-staff:3","source":"vndb"},{"creditedName":"久坂 真生","creatorId":"vndb:s3502","sourcePersonId":"vndb:s3502","canonicalEntityId":"vndb:s3502","name":"島村 孝一","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:6","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c1783","characterName":"双葉","sourceIds":{"vndbCharacterId":"c1783"},"originalCharacterName":"双葉","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Saddled with the unpleasantly demanding duty of serving as Hanabi's butler, this little cat-boy would evoke a lot of pity. After all, he must be at her service every hour of every day. However, it turns out that he actually enjoys it a little bit too much. He also has a fiancée that is waiting for him in Cat Kingdom."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c1783"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/390be9a2a6b3464b7e5c2a9057d450720dbb176d93dfd6312161a7511f71f16c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d22e8288746838b41b7a43c8cd641f338ea81b94041cf4b68c17b1a9c2d5668.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c1784","characterName":"青葉 七海","sourceIds":{"vndbCharacterId":"c1784"},"originalCharacterName":"青葉 七海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"As the daughter of Ibuki's landlord, his senpai at college and more importantly his lifelong friend, Nanami feels an obligation to look out for him. She can't seem to make up her mind whether she's going to act like his older sister or his wife. When Ibuki's apartment starts to fill with other girls, she senses that her relationship with him may be threatened."},{"spoiler":false,"text":"Edited from Wikipedia and Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c1784"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/822b753273f1b2396610e10faace0bbcac65818ddd3a25be47fde1aef7bb8482.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6ba39262a70e7fd1037a6c4f3eccdb64c1d03dacc4c7b10d60f0c7efbc7a9d8c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大橋 小夜子","creatorId":"vndb:s488","sourcePersonId":"vndb:s488","canonicalEntityId":"vndb:s488","name":"大橋 小夜子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1","source":"vndb"}]},{"characterId":"char_vndb_c1785","characterName":"蜜柑","sourceIds":{"vndbCharacterId":"c1785"},"originalCharacterName":"蜜柑","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A catgirl maid who came to Ibuki's world to serve him under the orders of the Cat God. She is very good at doing general housework and is good-natured and friendly. She can be silly at times, especially when she gets the urge to play with a distracting object. She's always wanted to have a family and will do anything that is in her power to create one with Ibuki."},{"spoiler":false,"text":"Edited from Wikipedia and Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c1785"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5badc6e30a37870875a845bc0b294668946232fe04f8262d7cb287659d75f6af.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d146edb1354134552ba713b9d7801f7a50017c751378202c5ec5f7017c3c672.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一宮 桜","creatorId":"vndb:s491","sourcePersonId":"vndb:s491","canonicalEntityId":"vndb:s491","name":"一宮 桜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:4","source":"vndb"}]},{"characterId":"char_vndb_c1786","characterName":"花火","sourceIds":{"vndbCharacterId":"c1786"},"originalCharacterName":"花火","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A sexy and mischievous bunny girl, Hanabi is certainly used to living in-style or at least her version of it. As an infamous art thief, she's used to rolling in money but she's a free-spender even if her taste is questionable. She's proud of her sexual abilities and always takes the lead during sex. Like the other uninvited guests, she came to Ibuki's world by accident after Mikan's teleportation."},{"spoiler":false,"text":"Edited from Wikipedia and Ben Woodhouse's Walkthrough and Ecchifan's Walkthrough"}],"source":"vndb","sourceCharacterId":"c1786"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa1686829b883d107183ab7508e4b9f1d8a5c6376d2c14241dc6b46ac57e1ff7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26c6f32fe618c0597972ef6adab929b8c0c53c380a0b19c015d41a84e9fd1c77.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瀬野 あや子","creatorId":"vndb:s489","sourcePersonId":"vndb:s489","canonicalEntityId":"vndb:s489","name":"瀬野 あや子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2","source":"vndb"}]},{"characterId":"char_vndb_c1787","characterName":"琥珀","sourceIds":{"vndbCharacterId":"c1787"},"originalCharacterName":"琥珀","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A high-leveled shrine maiden from Cat Kingdom, who was sent to Ibuki's world by the Cat God in order to fix discrepancies and to create a balance between the two kingdoms. She's very modest and loves to combine sex with Shinto rituals."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c1787"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61ff36171a3ddfd6428f2d2ff720868c1185e464a08e4c3bcb67e1d56815a4d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63533a20f587cc15087326dd9a04f6291b203ebe49c403365be2a92d364746b8.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和泉 あやか","creatorId":"vndb:s493","sourcePersonId":"vndb:s493","canonicalEntityId":"vndb:s493","name":"和泉あやか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:6","source":"vndb"}]},{"characterId":"char_vndb_c1788","characterName":"真珠","sourceIds":{"vndbCharacterId":"c1788"},"originalCharacterName":"真珠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shinju is the lead police detective in charge of pursuit of Hanabi. She got pulled into Ibuki's world by accident. Surprisingly, she gets along well with the cats she's been forced to be around, even though she's their natural enemy, a canine. Her self-discipline comes from her military background. While she's proud of her job, she's also self-conscious, worrying that it obscures her femininity."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c1788"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/174127bd4f6c69fe898b13645923411ce78d78502ad6d31caaa43ec700732163.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15bb1915e621d7c28aac12fe7bf13b8c3728628b999df48dfbbe14324289fc9a.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高奈 ゆか","creatorId":"vndb:s492","sourcePersonId":"vndb:s492","canonicalEntityId":"vndb:s492","name":"高森 奈緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5","source":"vndb"}]},{"characterId":"char_vndb_c1798","characterName":"小星","sourceIds":{"vndbCharacterId":"c1798"},"originalCharacterName":"小星","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Koboshi is a catgirl robot. As a soldier of the Meowtis Empire National Security Force, she's been loaned to Shinju in order to track down and arrest Hanabi. However, she's adorably inept, always falling down or shorting out. But her clumsy behavior endears her to Ibuki, enough to make her mechanical nature a non-issue."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c1798"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16c16d89e6dc55003040c47b4e9dd3084933fb44ee881283b384f06855b1d754.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ceb2493333df3525f07a0ac6a04e414642d96e463539695ef3e92649222f37c5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"篠宮 薫","creatorId":"vndb:s490","sourcePersonId":"vndb:s490","canonicalEntityId":"vndb:s490","name":"篠宮 薫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:3","source":"vndb"}]},{"characterId":"char_vndb_c49076","characterName":"高雄 伊吹","sourceIds":{"vndbCharacterId":"c49076"},"originalCharacterName":"高雄 伊吹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A botany student at Kaibara University who is a cat lover and wishes to have a catgirl. His devotion and care for cats doesn't go unnoticed and so it catches the attention of the Cat God. And so as a reward Cat God gifts Ibuki a catgirl therefore fulfilling his wish. But this catgirl comes with complications. A mishap in her transport from the Cat Kingdom allowed a few extra travelers to jump over to the human world. With no other place to go, these extra girls have no choice but to congregate around his humble abode. And now the group must come together as one big happy family and wait for the time when they can return to their own world."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c49076"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfbc2014159ae6fd08c9e3b1170601929f2e4b1203a2d574a4c4415d64ffe075.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fcf5d4d86daae5fff5f89af5fef00ca74f4ede607824b955cb2ab4098cf773d5.webp","width":234,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c56436","characterName":"猫 神","sourceIds":{"vndbCharacterId":"c56436"},"originalCharacterName":"猫 神","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A benevolent Cat God that rules over the Cat Kingdom. As a reward for Ibuki's good deeds towards cats, the Cat God gifts Ibuki a catgirl that Ibuki has wanted for so long."}],"source":"vndb","sourceCharacterId":"c56436"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d225ae2f65906eae637aac43963fcb4370a408f1adbfbb627ab4eb6a1de10cf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97b51c5ee95f69fa416ad394b252dd94ff19634ae1cbcb2655ecdf5bf738f67c.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c56437","characterName":"Exelion Restaurant Manager","sourceIds":{"vndbCharacterId":"c56437"},"originalCharacterName":"Exelion Restaurant Manager","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The owner of Exelion Restaurant and its manager. Ibuki works as a part-time waiter at her restaurant. Later on, she will also employ Shinju and Koboshi."}],"source":"vndb","sourceCharacterId":"c56437"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-a