476","canonicalEntityId":"vndb:s15476","name":"空賀 花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:96578","source":"vndb"}]},{"characterId":"char_vndb_c133878","characterName":"守屋 ミク","sourceIds":{"vndbCharacterId":"c133878"},"originalCharacterName":"守屋 ミク","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"611"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"99"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An Expressionless Robot-Senpai"},{"spoiler":false,"text":"Zodiac: Gemini"},{"spoiler":false,"text":"A senpai at Acacia Academy, she shares a room with Yui and Akari in the dormitory. Because of her self-paced personality and lack of expressions, she is nicknamed \"Robot.\" She excels in both academics and sports, especially in electronic warfare. Since she is not good at socializing, she gets confused when it is time to instruct her kouhai."},{"spoiler":false,"text":"Translated and edited from the official website"}],"source":"vndb","sourceCharacterId":"c133878"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9cb18d211720aba0a61ea98ef1426991e2a2100c245151f8e55d5426c99a13fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0cc9aa214bdc598de193eb994b7b489e199811a628eaf39ad38d5789d50556f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"逢真井 もこ","creatorId":"vndb:s14782","sourcePersonId":"vndb:s14782","canonicalEntityId":"vndb:s14782","name":"京 亜耶奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:96577","source":"vndb"}]},{"characterId":"char_vndb_c137441","characterName":"佐伯 ルリコ","sourceIds":{"vndbCharacterId":"c137441"},"originalCharacterName":"佐伯 ルリコ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"808"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Villainess, Somehow Hard to Detest"},{"spoiler":false,"text":"Zodiac: Leo"},{"spoiler":false,"text":"A classmate at Acacia Academy, who is in a different squad from Yui and the others. She has a strange laugh like a typical ojousama character from a manga, but she actually appears to be a daughter of the president. With such a girl as a ruler, is this country going to be alright? Despite being talked behind her back, it looks like she is surprisingly popular. She seems to have a personal connection with Akari, often acting harshly toward her."},{"spoiler":false,"text":"Translated and edited from the official website"}],"source":"vndb","sourceCharacterId":"c137441"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51edc85b47b68d7c43a45b5e7b974dffd7bf2f24f1f2fa409aad38a0a26fd017.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/623eef5ab983ec7a43496bbf2b40f15735348f3b2043a52e093c8042a77c122b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"狐今 あまね","creatorId":"vndb:s38314","sourcePersonId":"vndb:s38314","canonicalEntityId":"vndb:s38314","name":"狐今 あまね","rol