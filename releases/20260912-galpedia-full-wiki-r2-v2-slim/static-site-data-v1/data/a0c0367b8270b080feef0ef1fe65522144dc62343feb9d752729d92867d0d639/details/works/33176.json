sonId":"egs:creator:38613","canonicalEntityId":"egs:creator:38613","name":"スタジオフリークス","detail":"収録スタジオ","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:304766","source":"egs"},{"creditedName":"タハラ白樹","creatorId":"vndb:s21315","sourcePersonId":"egs:creator:38597","canonicalEntityId":"vndb:s21315","name":"タハラ白樹","detail":"グラフィック","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:304767","source":"egs"}]},"cast":[{"characterId":"char_c115546","characterName":"中澤 茜","sourceIds":{"bangumi":[{"characterId":"118548","match":"exact-normalized-name-in-linked-work","subjectId":"405692"}],"egsCharacterIds":["24386"],"vndbCharacterId":"c115546"},"originalCharacterName":"中澤 茜","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Mei-san, I won't lose to you, okay!\""},{"spoiler":false,"text":"After graduating from high school, she moved to the city to pursue an idol career. She was able to join an agency without any difficulties, becoming a newcomer who debuted as a center of an idol group."},{"spoiler":false,"text":"However, after refusing a big-shot producer casting couch invitations, her group was no longer invited to any shows, and spent their days waiting for job offers to come. All members in the group blamed her which made her feel awkward."},{"spoiler":false,"text":"Due to her growing up in the countryside, she is kind-hearted and earnest, unfamiliar with the world around her. She is also simple-minded, often decides things on the spur of the moment. She isn't interested in love, and had never dated any man so far."},{"spoiler":false,"text":"She met Mei when she joined the agency and looks up to her like she is her older sister. Despite their age difference, they got along really well and became good friends."},{"spoiler":false,"text":"Translated and edited from the Official website"}],"source":"vndb","sourceCharacterId":"c115546"},{"segments":[{"spoiler":false,"text":"学園卒業後、アイドルを目指して上京してきた。"},{"spoiler":false,"text":"すんなり事務所に所属し、アイドルグループのセンターとしてデビューした大型新人。"},{"spoiler":false,"text":"しかし、大物プロデューサーの枕営業の誘いを断ったことで番組に呼ばれなくなり、鳴かず飛ばずの日々を送っている。"},{"spoiler":false,"text":"メンバーからも責められて、気まずい思いをしている。"},{"spoiler":false,"text":"田舎で育ったため、心優しく真面目だが世俗には疎い。"},{"spoiler":false,"text":"単純な性格で、勢いで物事を決めてしまう一面がある。"},{"spoiler":false,"text":"本人は恋愛に興味がなく、今まで付き合った男性はいない。"},{"spoiler":false,"text":"藤代芽以とは、事務所に入った頃からの付き合いで、お姉さん的な存在。"},{"spoiler":false,"text":"不思議なほど馬が合い、年は離れているがすぐに親友になった。"}],"source":"egs","sourceCharacterId":"24386","sourceWorkId":"33176","spoiler":false},{"segments":[{"spoiler":false,"text":"純粋で押しに弱い努力家なアイドル"},{"spoiler":false,"text":"学園卒業後、アイドルを目指して上京してきた。"},{"spoiler":false,"text":"すんなり事務所に所属し、アイドルグループのセンターとしてデビューした大型新人。"},{"spoiler":false,"text":"しかし、大物プロデューサーの枕営業の誘いを断ったことで番組に呼ばれなくなり、鳴かず飛ばずの日々を送っている。"},{"spoiler":false,"text":"メンバーからも責められて、気まずい思いをしている。"},{"spoiler":false,"text":"田舎で育ったため、心優しく真面目だが世俗には疎い。"},{"spoiler":false,"text":"単純な性格で、勢いで物事を決めてしまう一面がある。"},{"spoiler":false,"text":"本人は恋愛に興味がなく、今まで付き合った男性はいない。"},{"spoiler":false,"text":"藤代芽以とは、事務所に入った頃からの付き合いで、お姉さん的な存在。"},{"spoiler":false,"text":"不思議なほど馬が合い、年は離れているがすぐに親友になった。"}],"source":"bangumi","sourceCharacterId":"118548"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c1130dddc763f9baf935910c43bae1b0a5a582f54bc08eb7ee79c8081cefec9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/5188fbba95aafba3e79847f8a89a89db7af96270d8ebdfa4ce458540f0a91d89.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風鈴みすず","creatorId":"vndb:s12799","sourcePersonId":"vndb:s12799","canonicalEntityId":"vndb:s12799","name":"日向 結希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:405692:118548:26471:1","source":"bangumi"}]},{"characterId":"char_c115650","characterName":"藤代 芽以","sourceIds":{"bangumi":[{"characterId":"118549","match":"exact-normalized-name-in-linked-work","subjectId":"405692"}],"egsCharacterIds":["24387"],"vndbCharacterId":"c115650"},"originalCharacterName":"藤代 芽以","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Akane-chan, please stay out of this! Because you're still young!\""},{"spoiler":false,"text":"Although she had difficulties when she was auditioning, after many efforts, she is now an idol belonging to an agency."},{"spoiler":false,"text":"Her serious personality made it difficult for her to get noticed in the entertainment industry. However, she has confident in her proportions, and knows how to show them off. As a gravure idol, she has a fanbase, but is not well-known."},{"spoiler":false,"text":"Due to her being difficult to work with, her agency is abandoning her which made her become desperate for works because she is approaching her 30s."},{"spoiler":false,"text":"Since she is also taking good care of her kouhai, she is well-liked by them. However, due to her strong sense of justice, she is being shunned by her superiors."},{"spoiler":false,"text":"Translated and edited from the Official website"}],"source":"vndb","sourceCharacterId":"c115650"},{"segments":[{"spoiler":false,"text":"なかなかオーディションに合格できず、努力を重ね、今の事務所に所属したアイドル志望の女性。"},{"spoiler":false,"text":"生真面目な性格のせいで、芸能界ではなかなか芽が出ないが自分のプロポーションには自信があり、見せ方を熟知しておりグラビアアイドルとして、固定ファンはいるが知名度はそれほど高くない。"},{"spoiler":false,"text":"身持ちが固いため事務所からも見捨てられ気味で、年齢もアラサーが迫ってきていることもあり焦っている。"},{"spoiler":false,"text":"面倒見がいいため後輩に好かれやすいが、正義感が強く年上からは煙たがられている。"}],"source":"egs","sourceCharacterId":"24387","sourceWorkId":"33176","spoiler":false},{"segments":[{"spoiler":false,"text":"身持ちの固いお姉さん気質のグラビアアイドル"},{"spoiler":false,"text":"なかなかオーディションに合格できず、努力を重ね、今の事務所に所属したアイドル志望の女性。"},{"spoiler":false,"text":"生真面目な性格のせいで、芸能界ではなかなか芽が出ないが自分のプロポーションには自信があり、"},{"spoiler":false,"text":"見せ方を熟知しておりグラビアアイドルとして、固定ファンはいるが知名度はそれほど高くない。"},{"spoiler":false,"text":"身持ちが固いため事務所からも見捨てられ気味で、年齢もアラサーが迫ってきていることもあり焦っている。"},{"spoiler":false,"text":"面倒見がいいため後輩に好かれやすいが、正義感が強く年上からは煙たがられている。"}],"source":"bangumi","sourceCharacterId":"118549"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5f32930cf80ed5f554f1730cc61feb19da67ef303ea840a30e1060c39272de1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/385e20bd0a84d3849c7e479c78002105718930e9b8e5c19d01eac63f283b5eeb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風花ましろ","creatorId":"vndb:s5762","sourcePersonId":"vndb:s5762","canonicalEntityId":"vndb:s5762","name":"中野 純花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:405692:118549:20833:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p12551","sourceCompanyId":"egs:brand:7203","canonicalEntityId":"vndb:p12551","name":"Guilty'Dash","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:33176:7203","source":"egs"},{"companyId":"vndb:p12551","sourceCompanyId":"vndb:p12551","canonicalEntityId":"vndb:p12551","name":"Guilty`Dash","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:106290:v38341","source":"vndb"},{"companyId":"vndb:p12551","sourceCompanyId":"vndb:p12551","canonicalEntityId":"vndb:p12551","name":"Guilty`Dash","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:107923:v38341","source":"vndb"}],"m