{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"36031","model":{"presentationWorkId":"egs:36031","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_101380","characterName":"Ramizel Erlenmeyer","sourceIds":{"bangumi":[{"characterId":"101380","match":"source-roster","subjectId":"351423"}]},"originalCharacterName":"Ramizel Erlenmeyer","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"豪爽的天才炼金术士"},{"spoiler":false,"text":"「艾德维格」居民们的领导角色。"},{"spoiler":false,"text":"笑容明快，性格温和，颇受众人信赖。"},{"spoiler":false,"text":"正义感强，性格豪爽，对身手颇有自信，时不时会与魔物对战。"},{"spoiler":false,"text":"遇到与自己一样都是鍊金术士的苏菲和普拉芙妲，决定守护她们的成长。"},{"spoiler":false,"text":"豪快なる異才の錬金術士"},{"spoiler":false,"text":"「エルデ=ヴィーゲ」に住む人々のまとめ役。"},{"spoiler":false,"text":"明るい笑顔と温和な雰囲気で、皆から頼られている。"},{"spoiler":false,"text":"正義感が強く豪快な性格でもあり、自慢の腕っぷしで魔物に立ち向かうこともしばしば。自身と同じく錬金術士のソフィーやプラフタと出会い、彼女たちの成長を見守っていくことに。"}],"source":"bangumi","sourceCharacterId":"101380"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52fc9d101ae46501d102bb2c124f6f39cfd472f0c3348a29370635a5feecaeda.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da680fe47b2babbe83fc9712d16c45b98fe67d4e60f3817eb4579affaf367d6d.webp","width":187,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋李依","creatorId":"vndb:s10632","sourcePersonId":"vndb:s10632","canonicalEntityId":"vndb:s10632","name":"高橋 李依","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:351423:101380:17491:1","source":"bangumi"}]},{"characterId":"char_bangumi_119320","char