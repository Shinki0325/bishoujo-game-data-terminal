s/v1/images/a4/a4cc34d5848ad1415a1428cb751542832cccbe53cc81bddae61f1bcc00bbb41d.webp","width":256,"height":214,"source":"static-detail"},"actors":[{"creditedName":"早瀬雪未","creatorId":"vndb:s36935","sourcePersonId":"vndb:s36935","canonicalEntityId":"vndb:s36935","name":"早瀬 雪未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:351423:119324:38688:1","source":"bangumi"}]},{"characterId":"char_bangumi_119325","characterName":"KATRINA BALBASTRE","sourceIds":{"bangumi":[{"characterId":"119325","match":"source-roster","subjectId":"351423"}]},"originalCharacterName":"KATRINA BALBASTRE","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"不真面目なサボリ魔店主"},{"spoiler":false,"text":"ロイテールにある食事処「水晶の輝き亭」の店主。愛称はカティ。"},{"spoiler":false,"text":"高い情報収集能力を持ち、それを活かして「エルデ＝ヴィーゲ」についての様々な情報を集めている。"},{"spoiler":false,"text":"料理の腕も一級なのだが、店主としての勤務態度は不真面目で、店内で堂々とサボっているのが日常。"}],"source":"bangumi","sourceCharacterId":"119325"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a443b6525031daaa94c24441937f4b0662e462f14bc09fa6224cfefdc09d7409.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11fedd9d27da98a74389c9aefe121af520d0c5821fb739434035c51cb1122822.webp","width":256,"height":233,"source":"static-detail"},"actors":[{"creditedName":"沼倉愛美","creatorId":"vndb:s5613","sourcePersonId":"vndb:s5613","canonicalEntityId":"vndb:s5613","name":"沼倉愛美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:351423:119325:5824:1","source":"bangumi"}]},{"characterId":"char_bangumi_119326","characterName":"GNOME DUMORTIER","sourceIds":{"bangumi":[{"characterId":"119326","match":"source-roster","subjectId":"351423"}]},"originalCharacterName":"GNOME DUMORTIER","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"働き者の心優しい青年"},{"spoiler":false,"text":"食事処「水晶の輝き亭」で働く真面目で心優しい青年。"},{"spoiler":false,"text":"店の仕事をほとんどしないカティに代わり、実質店を仕切っている従業員。"},{"spoiler":false,"text":"カティに対して恩義を感じているため、少しでも彼女の力になりたいと考えている。"}],"source":"bangumi","sourceCharacterId":"119326"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/812150417c65c0e535635ddc702cc798334f1c7f95ba065cf38bf630312a8060.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c0818c06b8da4cc6a31baa9799a3c7a94df80e2caa585ff5933ff5590537a7e.webp","width":256,"height":250,"source":"static-detail"},"actors":[{"creditedName":"大野柚布子","creatorId":"vndb:s15239","sourcePersonId":"vndb:s15239","canonicalEntityId":"vndb:s15239","name":"大野 柚布子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:351423:119326:25436:1","source":"bangumi"}]},{"characterId":"char_bangumi_33879","characterName":"索菲·诺伊恩缪拉","sourceIds":{"bangumi":[{"characterId":"33879","match":"source-roster","subjectId":"138202"},{"characterId":"33879","match":"source-roster","subjectId":"249447"},{"characterId":"33879","match":"source-roster","subjectId":"351423"}]},"originalCharacterName":"索菲·诺伊恩缪拉","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"156"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A17　　16歳"},{"spoiler":false,"text":"キルヘン・ベルの街はずれでアトリエを営んでいる少女。"},{"spoiler":false,"text":"明るくほわっとした性格で周りを和ませるが、時間にルーズであるなど、ずぼらなところも多い。"},{"spoiler":false,"text":"錬金術が大好きで、人のために使うことに大きな喜びを感じている。"},{"spoiler":false,"text":"錬金術に関しての好奇心や努力は人一倍だが、家事全般は基本的にせず、特に掃除は人にまかせきり。"},{"spoiler":false,"text":"A18　　20歳"},{"spoiler":false,"text":"フィリスに錬金術を教える錬金術士。フィリスからはソフィー先生と呼ばれ、慕われている。"},{"spoiler":false,"text":"公認試験の合格を目指し、故郷を飛び出して世界各地を旅している。"},{"spoiler":false,"text":"天真爛漫で明るい性格だが、さまざまなことを経験して成長した結果、大人らしい一面を見せることも。"},{"spoiler":false,"text":"A19　　24歳"},{"spoiler":false,"text":"長い間、旅を続けている錬金術士。"},{"spoiler":false,"text":"年長者としてリディーとスールにアドバイスすることも。"},{"spoiler":false,"text":"だが、どこか抜けているところがある。"},{"spoiler":false,"text":"錬金術の腕前はかなりのもので、ソフィーに錬金術を教えた"},{"spoiler":false,"text":"師匠に迫る常識外れなレベルにまで到達している。"}],"source":"bangumi","sourceCharacterId":"33879"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"33879","value":"炼金术士"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a7b822ebf0bab1ad58147ebeb1adcb1d94fccfe91dfa41ee6875df58fe6f68c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca0963e349017a3cfb5f2da4444009c0f5175391ec47919fd0a8dd0a26be0483.webp","width":256,"height":253,"source":"static-detail"},"actors":[{"creditedName":"相坂優歌","creatorId":"vndb:s16699","sourcePersonId":"vndb:s16699","canonicalEntityId":"vndb:s16699","name":"相坂 優歌","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:351423:33879:13563:1","source":"bangumi"}]},{"characterId":"char_bangumi_34136","characterName":"Plachta","sourceIds":{"bangumi":[{"characterId":"34136","match":"source-roster","subjectId":"138202"},{"characterId":"34136","match":"source-roster","subjectId":"351423"}]},"originalCharacterName":"Plachta","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A17"},{"spoiler":false,"text":"アトリエの本棚にしまわれていた、ソフィーのおばあちゃんの古い本。"},{"spoiler":false,"text":"ソフィーがこの本にレシピを書き込んだことで目覚め、ソフィーに錬金術を教える先生のような立場になる。"},{"spoiler":false,"text":"ある出来事をきっかけに人の姿となるが、本の姿だった時と性格は変わらず、ソフィーに錬金術に関するアドバイスをしてくれる。"},{"spoiler":false,"text":"一方で錬金術以外のことはまったくダメダメで、人の姿で街中を出歩くようになってからは、意味不明な発言をしては周囲を困らせている。"},{"spoiler":false,"text":"性格は冷静だが、意外と大胆な所もある。"},{"spoiler":false,"text":"人の姿を取り戻したことで、ある使命を思い出そうとする。"},{"spoiler":false,"text":"A18"},{"spoiler":false,"text":"ソフィーと共に旅する少女で、彼女の錬金術の師匠でもある。ソフィーとはとても仲が良く、親友や家族ともいえる間柄。"},{"spoiler":false,"text":"真面目で冷静な性格だが、どことなく抜けている面もある。"},{"spoiler":false,"text":"錬金術の知識は豊富で、弟子のソフィーや、孫弟子のフィリスを優しく見守り、的確な助言を与える。"},{"spoiler":false,"text":"A19"},{"spoiler":false,"text":"旅の錬金術士であるソフィーとともに旅をしている錬金術士。"},{"spoiler":false,"text":"ソフィーの錬金術の師匠であり、彼女のことを親友とも家族とも思っている。"},{"spoiler":false,"text":"性格は真面目で冷静だが、どこか抜けているところも。豊富な錬金術の知識でリディーたちをサポートし、見守っていく。"}],"source":"bangumi","sourceCharacterId":"34136"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"34136","value":"炼金术士"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e152fa3461f0bc37de4e90348438aeabf651fa6e5fe9cbb8a9681ffa85fa3698.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0c588b38eb8fec535d2f5b45c7563e10e1f79fe87260447e26c527f1c917fc2.webp","width":157,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井口裕香","creatorId":"vndb:s3971","sourcePersonId":"vndb:s3971","canonicalEntityId":"vndb:s3971","name":"井口 裕香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:351423:34136:4851:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p910","sourceCompanyId":"egs:brand:766","canonicalEntityId":"vndb:p910","name":"ガスト","roleCodes":["brand"],"identitySt