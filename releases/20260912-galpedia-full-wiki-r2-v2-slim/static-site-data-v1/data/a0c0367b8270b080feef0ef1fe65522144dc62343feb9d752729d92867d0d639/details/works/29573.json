"source":"vndb","value":"803"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"69"},"height":{"reviewState":"source-only","source":"vndb","value":"142"},"hip":{"reviewState":"source-only","source":"vndb","value":"63"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"},"weight":{"reviewState":"source-only","source":"vndb","value":"33"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is an 11-year-old prodigy who skipped grades to transfer from St. Bernardi Academy's primary school. She can be a bit cheeky and foul-mouthed, but she also has a kind side. She transforms into White Angel and supports Haruka and Aoi with the mechanical weapons she developed."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c71414"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/1827facfa2ad1a727a71d88b0cd2ee27a1d001d65bd3b12e69a7f0ae078e6954.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f54bbc6ebd65c309012af541b01db573794ddf4b7f63e06acfeac84124ba1b5.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"釘宮 理恵","creatorId":"vndb:s500","sourcePersonId":"vndb:s500","canonicalEntityId":"vndb:s500","name":"釘宮理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73008","source":"vndb"}]},{"characterId":"char_vndb_c85552","characterName":"テスラ・ヴァイオレット","sourceIds":{"vndbCharacterId":"c85552"},"originalCharacterName":"テスラ・ヴァイオレット","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1224"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"source-only","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl transferred to St. Cherine's School as an exchange student alongside her twin sister, Nine. Her true identity is the 'Twin Phantom' for the secret organization Black Fund. After battling the Twin Angels numerous times, they eventually reconciled and became allies."},{"spoiler":false,"text":"After her transformation, she specializes in long-range attacks using lightning strikes."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c85552"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd1641db03c5def32f9df1a04d546f3ed5c7890324872ac87c6018b67f3054f8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb138430cb213fc732bdcac744bd7a3d3c2fc7fdf664f93a32b39d24b4e75cb4.webp","width":183,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c85553","characterName":"ナイン・ヴァイオレット","sourceIds":{"vndbCharacterId":"c85553"},"originalCharacterName":"ナイン・ヴァイオレット","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1224"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"},"weight":{"reviewState":"source-only","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tesla's twin sister, who is quiet and unassuming. She is well-liked by some female students, possibly for her boyish appearance. Despite being expressionless, she is kind-hearted and enjoys spending time with the animals in the backyard. Like Tesla, she once served as an adversary as Twin Phantom, but she has since reconciled and become a friend."},{"spoiler":false,"text":"After her transformation, she overwhelms her enemies with powerful attacks using her great sword."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c85553"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c500b919e37983f723edc0482201c38d20f3155e4aa99620ae1e561a382cace9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02104c01da492151cbca422a162f7c26a37a137e23777829d9ad37866f65eb32.webp","width":183,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c85554","characterName":"葉月 つかさ","sourceIds":{"vndbCharacterId":"c85554"},"originalCharacterName":"葉月 つかさ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"808"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A scientist researching on the 'Holy Grail's Fragment' while serving as a temporary lecturer at St. Cherine's Academy."},{"spoiler":false,"text":"She is a prodigy who graduated from a postgraduate program by skipping grades and utilizes her knowledge and skills for her own activities as an 'Ama no Tsukai'. Her weapon of choice is a pair of pistols."},{"spoiler":false,"text":"Translated from the official site"},{"spoiler":true,"text":"She is actually Kurumi's aunt, who died in an accident eleven years ago. She assisted the time-traveling Kurumi and her friends in returning to the future and chose to remain in this time period herself, even after learning about her fate. In Tesla's route, she obtained the Holy Grail Clock dropped by Augusto, which enabled her to survive."},{"spoiler":true,"text":"She is a friend of Kasumi and Chihiro and regrets that if she had developed PokeTen one step earlier, she could have saved them."}],"source":"vndb","sourceCharacterId":"c85554"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/911f622fb26bee05b574b7ed0a8ebbea8bd22b52796fa4bc25f75b6575a9f569.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/2563eadc255bff9367b38018d33c9681bd1101ea0c6867eb3fc2cf3a7eeab7a2.webp","width":183,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c86614","characterName":"ユーチャリス・ミストルテイン","sourceIds":{"vndbCharacterId":"c86614"},"originalCharacterName":"ユーチャリス・ミストルテイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"621"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0fd058c8675816479cee1b03a57ce7d24c3f773ae17dedcc9c74f97d955105a6.webp","fallbackUrl":"https://wiki-asse