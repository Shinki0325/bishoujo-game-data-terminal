tityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:56980","source":"vndb"},{"creditedName":"青葉 りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:56981","source":"vndb"},{"creditedName":"上田 朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:56982","source":"vndb"}]},"cast":[{"characterId":"char_c121807","characterName":"法月 蓮","sourceIds":{"bangumi":[{"characterId":"133344","match":"exact-normalized-name-in-linked-work","subjectId":"11541"}],"egsCharacterIds":["11179"],"vndbCharacterId":"c121807"},"originalCharacterName":"法月 蓮","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真紅郎のクラスにいる目立たない男子学生。"},{"spoiler":false,"text":"一見おとなしそうな印象だが、内心では攻撃的な気性を持つ。"},{"spoiler":false,"text":"友達が多いタイプではないが、貴久とは以前からの知り合いで、ある約束を交わしている。"}],"source":"egs","sourceCharacterId":"11179","sourceWorkId":"14440","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f7f7c751ce529a3fcbfed274c96a68f8e60e8e880b9fb04758a9830ea338c3b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1d7c74c9798f01439d6e6d67ac6cefdbf3c5d73756b46ff7f5c4ff0764682da.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"古河徹人","creatorId":"vndb:s299","sourcePersonId":"vndb:s299","canonicalEntityId":"vndb:s299","name":"古河 徹人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11541:133344:6265:1","source":"bangumi"}]},{"characterId":"char_c121808","characterName":"明智 貴久","sourceIds":{"bangumi":[{"characterId":"133343","match":"exact-normalized-name-in-linked-work","subjectId":"11541"}],"egsCharacterIds":["11180"],"vndbCharacterId":"c121808"},"originalCharacterName":"明智 貴久","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"クラスメイト。"},{"spoiler":false,"text":"真紅郎が唯一気を許せる親友。"},{"spoiler":false,"text":"お互い干渉しすぎることはなく、真紅郎の仕事についても深く詮索してこない。"},{"spoiler":false,"text":"明るく適度に不真面目な性格も、真紅郎と気が合う理由の一つ。"}],"source":"egs","sourceCharacterId":"11180","sourceWorkId":"14440","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/9989dde3470cf5afbe34eceef830459a7351ad99168dacb9185cc8babe6dba06.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc6b81a1d6287a8cbc953e5e9eb499aed4edf7b510b195567615c9bfa0917814.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"越田直樹","creatorId":"vndb:s6882","sourcePersonId":"vndb:s6882","canonicalEntityId":"vndb:s6882","name":"越田 直樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11541:133343:13994:1","source":"bangumi"}]},{"characterId":"char_c23936","characterName":"ルナ・フリード・クイーン","sourceIds":{"bangumi":[{"characterId":"11118","match":"exact-normalized-name-in-linked-work","subjectId":"11541"}],"egsCharacterIds":["11172"],"vndbCharacterId":"c23936"},"originalCharacterName":"ルナ・フリード・クイーン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真紅郎と行動を共にすることとなる終焉の姫君。"},{"spoiler":false,"text":"現存する世界最後の吸血鬼の真祖である。"},{"spoiler":false,"text":"吸血鬼史上、もっともヘッポコな吸血鬼。"},{"spoiler":false,"text":"身体能力は低いが、吸血鬼史上もっとも打たれ強く、驚異的な回復能力を持っているため、戦闘時に盾やエサとして扱われることもある。"},{"spoiler":false,"text":"おバカでわがままで偉そうなロリっ子。"},{"spoiler":false,"text":"追われる立場になる前は、人間界との接触を制限されていた。"},{"spoiler":false,"text":"人間の学校に通ってみたいというお馬鹿な発想により、組織から狙われているにも関わらず、脳天気に学校に通う。"},{"spoiler":false,"text":"自分が生き残ったことに対してやや後ろ向きな考えを持っているが、真紅郎と出会うことで少しずつ何かが変わっていくのを感じ始めた。"}],"source":"egs","sourceCharacterId":"11172","sourceWorkId":"14440","spoiler":false},{"segments":[{"spoiler":false,"text":"和真紅郎共同行动，最后的吸血鬼公主。"},{"spoiler":false,"text":"同时也是依旧存活的世界上最后一个吸血鬼真祖。"},{"spoiler":false,"text":"然而，却是吸血鬼历史上最笨蛋的存在，身体能力也是相当低。虽说如此，倒也十分耐打，还拥有着令人叹为观止的回复能力，也因此战斗时被当作盾牌或诱饵的事时有发生。"},{"spoiler":false,"text":"任性又自大的笨蛋罗莉。"},{"spoiler":false,"text":"在被追杀之前就被严格限制与人类的接触。"},{"spoiler":false,"text":"出于她那试着到人类学校上学的骚主意，完全无视组织的猎杀，一脸悠哉得意地上学去了。"},{"spoiler":false,"text":"对于自己就是残存下来的最后一人这种事，其实她是蛮消极的，但在和真紅郎邂逅后，似乎慢慢开始有所改变。"}],"source":"bangumi","sourceCharacterId":"11118"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59056bf9b90a2dd4279bd2249634690b03d1f4d6a25762b03313edd52a0a96a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d3d516f619d927d6f17a8947cf898daa8c744d9f0af985067565c96dea310e2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11541:11118:5922:1","source":"bangumi"}]},{"characterId":"char_c23937","characterName":"リネット・ヴァンス","sourceIds":{"bangumi":[{"characterId":"11119","match":"exact-normalized-name-in-linked-work","subjectId":"11541"}],"egsCharacterIds":["11173"],"vndbCharacterId":"c23937"},"originalCharacterName":"リネット・ヴァンス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"姫君を守るライカンスロープ。"},{"spoiler":false,"text":"強力な戦闘能力を持っている。"},{"spoiler":false,"text":"身の丈よりも大きな剣を操る屈強な戦士。"},{"spoiler":false,"text":"何事にも無関心で口数は少ないが、ルナのこととなると異常な執着を見せ、眷属以上の強い想いを抱いている。"},{"spoiler":false,"text":"やる気があるのかないのか分からない無表情だが、いざルナの護衛となると凄まじい身体能力を発揮し向かってくる敵をなぎ倒す。"},{"spoiler":false,"text":"武術の心得があるわけではなく、ほぼ我流で鍛えた。"},{"spoiler":false,"text":"普段は大剣をルナに預けているため、常に近くで護衛をしている。"}],"source":"egs","sourceCharacterId":"11173","sourceWorkId":"14440","spoiler":false},{"segments":[{"spoiler":false,"text":"守护着公主殿下的狼人。"},{"spoiler":false,"text":"拥有着强大的战斗力，挥舞着比自己还要大的剑，是个无比强悍的战士。"},{"spoiler":false,"text":"对什么事都毫不关心，很少开口讲话，但一旦牵涉到ルナ就会变得异常执着，对她抱持着超过部下该有的情感。"},{"spoiler":false,"text":"向来没什么表情，也不知她究竟有没有认真去干，只是作为ルナ护卫时就会发挥出惊人的身体能力，将眼前的敌人通通打倒。"},{"spoiler":false,"text":"倒也不是向谁学习过武术，基本上都是自学而来的。"},{"spoiler":false,"text":"由于平时那把大剑都由ルナ保管，总是使用近身肉搏战。"}],"source":"bangumi","sourceCharacterId":"11119"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3ad608ac9804b5dff59315e7a65ac36706d6212dda14ea153e1fb9be88d462d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d195a35216d43106b2b42ab58119bbf7cb4e7ebaa3f49e0ef84ebb1ccc872a97.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11541:11119:5928:1","source":"bangumi"}]},{"characterId":"char_c23938","characterName":"二階堂 凛子","sourceIds":{"bangumi":[{"characterId":"11120","match":"exact-normalized-name-in-linked-work","subjectId":"11541"}],"egsCharacterIds":["11174"],"vndbCharacterId":"c23938"},"originalCharacterName":"二階堂 凛子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"両親を殺されて以来、正義と力を得るために、組織 『銀の弾丸』 のハンターとなる。"},{"spoiler":false,"text":"組織の黒い部分を知っていても、それは正義のためだと自分に言い聞かせて疑わない。"},{"spoiler":false,"text":"『銀の弾丸』＝絶対の正義だと思っている。"},{"spoiler":false,"text":"組織を嗅ぎ回る真紅郎を監視するために同居する。"},{"spoiler":false,"text":"ルナが吸血鬼の真祖だと分かるヒントをたびたび聞くが、その都度別解釈をして気づかないという、ちょっとアホな子。"},{"spoiler":false,"text":"実はかわいいものが好きという女の子な面も持ち合わせているが、周りには隠しており、バレそうになると必死にごまかす。"},{"spoiler":false,"text":"愛用の銃は肌身離さず、いつでも奇襲に備えている。"}],"source":"egs","sourceCharacterId":"11174","sourceWorkId":"14440","spoiler":false},{"segments":[{"spoiler":false,"text":"在双亲遇害之后，为了贯彻正义、获得力量，她加入组织——『银之炮弹』成为了猎人。"},{"spoiler":false,"text":"尽管知道组织那见不得人的黑暗一面，却依旧坚信着那也是为了正义，自欺欺人着。"},{"spoiler":false,"text":"对于她来说，『银之炮弹』就等同于绝对的正义。"},{"spoiler":false,"text":"为了监视组织的调查对象真紅郎而和他同居。"},{"spoiler":false,"text":"其实有很多能证明ルナ就是吸血鬼真祖的暗示，但每次都会被别的解释敷衍了事，而她竟然还没察觉，又是笨蛋一只。"},{"spoiler":false,"text":"虽然有着喜欢可爱东西的女孩子的一面，但本人竭力隐瞒着这一点，一旦露馅就会全力搪塞过去。"},{"spoiler":false,"text":"喜欢的枪总是片刻不离身，随时准备发动奇袭。"}],"source":"bangumi","sourceCharacterId":"11120"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/1836f719e7a1857cc15d4d17b5d509339625e8ce005d1de390540bb42a802bfb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b016ec12679cb42b86af56ff0550665687b4e5db1b0a55d5892e9ea7ddb35ced.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11541:11120:4830:1","source":"bangumi"}]},{"characterId":"char_c23939","characterName":"神津 沙耶香","sourceIds":{"bangumi":[{"characterId":"11121","match":"exact-normalized-name-in-linked-work","subjectId":"11541"}],"egsCharacterIds":["11175"],"vndbCharacterId":"c23939"},"originalCharacterName":"神津 沙耶香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"男子の間で学園1、2を争う人気を誇るお嬢様。"},{"spoiler":false,"text":"桐ヶ崎市で一番大きい神津総合病院院長の一人娘。"},{"spoiler":false,"text":"本人はそれを自慢することなく控えめ。それが人気の秘密でもある。"},{"spoiler":false,"text":"父親に対し常に尊敬と感謝の気持ちを抱いているが、バイトを禁止されている等、普通の女の子として過ごせないことには不満を抱いている。"},{"spoiler":false,"text":"沙耶香の父・神津恵介は昔、真紅郎の両親と吸血鬼を使った研究をしていたが、真紅郎と沙耶香は共にそのことは知らない。"}],"source":"egs","sourceCharacterId":"11175","sourceWorkId":"14440","spoiler":false},{"segments":[{"spoiler":false,"text":"在男生中有着极高的人气，足以跻身学校受欢迎排行榜上的前二名，大小姐一个。"},{"spoiler":false,"text":"也是桐ヶ崎市最大的医院——神津総合病院院长的独生女。"},{"spoiler":false,"text":"她本人对那倒是毫不自夸，为人谨慎客气。或许这也正是她受欢迎的秘密。"},{"spoiler":false,"text":"对自己的父亲很是尊敬和感谢，但对于禁止打工等，让她没法像个普通女孩子般生活这一点，她多少有些不满。"},{"spoiler":false,"text":"在过去，沙耶香的父亲神津恵介曾经和真紅郎的双亲利用吸血鬼进行过研究，但真紅郎和沙耶香都并不知晓此事。"}],"source":"bangumi","sourceCharacterId":"11121"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d0e8b526b484fe3aa58c3f97957afa1fb24ca22a0562c18c4cac56fdf67bf2f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a2bb3796e14f6d920524293576e1eb39c71456715b4a3166b24b8ebf3f255df.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11541:11121:5906:1","source":"bangumi"}]},{"characterId":"char_c23940","characterName":"アリス","sourceIds":{"bangumi":[{"characterId":"11122","match":"exact-normalized-name-in-linked-work","subjectId":"11541"}],"egsCharacterIds":["11176"],"vndbCharacterId":"c23940"},"originalCharacterName":"アリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真紅郎たちの前に現れた人造吸血鬼。"},{"spoiler":false,"text":"『銀の弾丸』 により生み出された隠密偵察用試作タイプで、諜報活動が主な任務。"},{"spoiler":false,"text":"他の人造吸血鬼と違い、人間に近い人格を持ち、電子機器を操る能力を持つ。"},{"spoiler":false,"text":"『銀の弾丸』 は他にも人造吸血鬼の研究をしているが、いまだ成功した事例は少ないという。"}],"source":"egs","sourceCharacterId":"11176","sourceWorkId":"14440","spoiler":false},{"segments":[{"spoiler":false,"text":"出现在真紅郎他们面前的人造吸血鬼。"},{"spoiler":false,"text":"在『银之炮弹』成立前就被用于隐秘侦察的试作体，主要任务是进行谍报行动。"},{"spoiler":false,"text":"和其他人造吸血鬼不同，她拥有更接近于人类的人格，还能够操纵电子机器。"},{"spoiler":false,"text":"虽然『银之炮弹』仍然在进行人造吸血鬼的研究，但到目前为止还是鲜有成功的案例。"},{"spoiler":false,"text":"mask江神理纱/mask"}],"source":"bangumi","sourceCharacterId":"11122"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21a44f971c8f537609b3bec9c413ffa8c4e39963e29826cfb8701addb7bbb548.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf609b4c702c7a652820783e83004c04a8b8acc2e4b28692ebda740dfffe2d08.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11541:11122:6016:1","source":"bangumi"}]},{"characterId":"char_c23941","characterName":"フランシスカ・ポアロ","sourceIds":{"bangumi":[{"characterId":"11123","match":"exact-normalized-name-in-linked-work","subjectId":"11541"}],"egsCharacterIds":["11177"],"vndbCharacterId":"c23941"},"originalCharacterName":"フランシスカ・ポアロ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"拷問と戦闘をこよなく愛する、残忍でコワレ気味な吸血鬼。"},{"spoiler":false,"text":"死んだ後の世界に恐怖を抱き、生に対して異常な執着心を見せる。"},{"spoiler":false,"text":"ルナのことが好きであるが、その曲がった愛情が独占欲という形に変わり、真紅郎たちから奪おうとする。"},{"spoiler":false,"text":"またルナを捕まえた際には監禁し、死なない程度に血を吸ったり拷問して楽しもうと妄想しては、よだれを垂らしている。"},{"spoiler":false,"text":"自分のことをこの上なく愛しており、曲がった性格を指摘されても 『チャームポイント』」だと譲らない。"},{"spoiler":false,"text":"人間を殺すことには躊躇いを持たない。"}],"source":"egs","sourceCharacterId":"11177","sourceWorkId":"14440","spoiler":false},{"segments":[{"spoiler":false,"text":"极度酷爱拷问和战斗，残忍无比，让人心生恐惧的吸血鬼。"},{"spoiler":false,"text":"十分害怕死后的世界，却也因此对生存有着异常的执着。"},{"spoiler":false,"text":"喜欢ルナ，但那扭曲的爱情早已化作独占欲，一心想要从真紅郎他们手里抢到她。"},{"spoiler":false,"text":"而且经常会想入非非地妄想着捕获ルナ再将她监禁起来，对她进行拷问，吸她的血而又不会让她死得痛快。"},{"spoiler":false,"text":"无比自爱，就算被人指责性格扭曲，她也只会坚持那才是「迷人的地方」。"},{"spoiler":false,"text":"残杀人类对于她来说，是无需半点犹豫的小事。"}],"source":"bangumi","sourceCharacterId":"11123"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0f219cf78b453d839434f91917039050322c359ba30f17d7d5bc1aa889f627f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a178567d8becbc5993e3d9f7a28f6eee9d87775beae19aa62e997b2b15da7e8b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11541:11123:4675:1","source":"bangumi"}]},{"characterId":"char_c23942","characterName":"コーデリア・メリヴェール","sourceIds":{"bangumi":[{"characterId":"11124","match":"exact-normalized-name-in-linked-work","subjectId":"11541"}],"egsCharacterIds":["11178"],"vndbCharacterId":"c23942"},"originalCharacterName":"コーデリア・メリヴェール","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“銀の弾丸”No.2を誇る、女幹部。"},{"spoiler":false,"text":"幾多の困難を乗り越え、現在の座を勝ち取ってきた実力派。"},{"spoiler":false,"text":"深夜営業のファミレスの常連で、ドリンクバーやサラダバーで粘る庶民的な趣味を持っている。"},{"spoiler":false,"text":"戦闘力はずば抜けて高く、戦いにおいて 『銀の弾丸』 の中でも突出した存在。"},{"spoiler":false,"text":"目的のためには手段を選ばない冷徹な面も持つ。"},{"spoiler":false,"text":"その並外れた戦闘能力から、人間ではないと噂される程。"}],"source":"egs","sourceCharacterId":"11178","sourceWorkId":"14440","spoiler":false},{"segments":[{"spoiler":false,"text":"以『银之炮弹』No.2而自傲的女干部。"},{"spoiler":false,"text":"她是跨越无数难关而爬到今日地位的实力派人物。"},{"spoiler":false,"text":"意外地有着爱喝酒爱吃沙拉的庶民兴趣，是深夜经营的家庭餐馆的常客。"},{"spoiler":false,"text":"战斗力远在他人之上，置身战场时即使是在『银之炮弹』的成员中也相当突出。"},{"spoiler":false,"text":"有着为达目的不择手段的冷酷一面。"},{"spoiler":false,"text":"因她那非人的战斗能力，让周围不禁传闻她并非人类。"}],"source":"bangumi","sourceCharacterId":"11124"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e4bd25947dd849588c7278f00bd355360e704ac40b4fee0cbeaa937b1504fff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb8f6d8ed42077be3ab31d285c1ab362bdcb4b774cd70b937c3841b49477d6e7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11541:11124:5741:1","source":"bangumi"}]},{"characterId":"char_vndb_c130538","characterName":"江神 真紅郎","sourceIds":{"vndbCharacterId":"c130538"},"originalCharacterName":"江神 真紅郎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1649","sourceCompanyId":"egs:brand:3065","canonicalEntityId":"vndb:p1649","name":"3rdEye","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:14440:3065","source":"egs"},{"companyId":"vndb:p1649","sourceCompanyId":"vndb:p1649","canonicalEntityId":"vndb:p1649","name":"3rdEye","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:12022:v5349","source":"vndb"},{"companyId":"vndb:p1649","sourceCompanyId":"vndb:p1649","canonicalEntityId":"vndb:p1649","name":"3rdEye","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:22016:v5349","source":"vndb"},{"companyId":"vndb:p2263","sourceCompanyId":"vndb:p2263","canonicalEntityId":"vndb:p2263","name":"萌えAPP","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:22017:v5349","source":"vndb"},{"companyId":"vndb:p1649","sourceCompanyId":"vndb:p1649","canonicalEntityId":"vndb:p1649","name":"3rdEye","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:24637:v5349","source":"vndb"},{"companyId":"vndb:p2263","sourceCompanyId":"vndb:p2263","canonicalEntityId":"vndb:p2263","name":"萌えAPP","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:24638:v5349","source":"vndb"},{"companyId":"vndb:p