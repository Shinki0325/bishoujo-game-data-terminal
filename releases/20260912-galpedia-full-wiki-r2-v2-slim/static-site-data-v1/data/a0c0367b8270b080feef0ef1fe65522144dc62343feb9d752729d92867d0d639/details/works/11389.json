r":false,"text":"有閑セレブ妻。28歳。"},{"spoiler":false,"text":"資産家の家に生まれ、年の離れた会社社長と結婚。家政婦に家事一切を任せて、有り余る時間と金を使って、自由奔放な生活を送っている。"},{"spoiler":false,"text":"仕事で忙しく留守がちの夫は、妻に甘く、彼女の振る舞いに対して、一切の口を挟まず、寛大な態度で接している。"},{"spoiler":false,"text":"それをいいことにワインの会で知り合ったソムリエと不倫の関係にある。"},{"spoiler":false,"text":"しかし、互いに割り切った「大人の関係」と思っているため、不倫に対する罪悪感はない。"}],"source":"egs","sourceCharacterId":"16489","sourceWorkId":"11389","spoiler":false},{"segments":[{"spoiler":false,"text":"年の離れた会社社長の妻。。"},{"spoiler":false,"text":"専業主婦だが家事は一切行わず、家庭内のすべてのことを家政婦に任せ、自分はファッションやグルメなど、好きなことにだけたっぷり時間とお金を使っている"},{"spoiler":false,"text":"夫は仕事が忙しいため留守がちで、しかも妻に甘いため、夫婦と言うよりは寛大な父と甘えんぼうな娘のような関係である。"},{"spoiler":false,"text":"それをいいことに現在はワインの会で知り合った、某ソムリエと不倫中。"},{"spoiler":false,"text":"互いに割り切った “大人の関係” だと思っているので不倫に対する罪悪感はない。"}],"source":"bangumi","sourceCharacterId":"52471"}],"profileFacts":[{"label":"年龄（本版本）","value":"28 岁","valueContext":null,"source":"egs","sourceCharacterId":"16489","sourceWorkId":"11389","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"16489","sourceWorkId":"11389","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"16489","sourceWorkId":"11389","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"16489","sourceWorkId":"11389","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"16489","sourceWorkId":"11389","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"16489","sourceWorkId":"11389","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2ed684de4c01d48a8766e3d8fad49d147971ffc998d962e8da979f7512bce0a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70d16c12808801ae309ffba11f51fcea78bda49a10fb2995541264632d43b020.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:211405:52471:5890:1","source":"bangumi"}]},{"characterId":"char_c58918","characterName":"佐伯 カオリ","sourceIds":{"bangumi":[{"characterId":"52472","match":"exact-normalized-name-in-linked-work","subjectId":"211405"}],"egsCharacterIds":["16490"],"vndbCharacterId":"c58918"},"originalCharacterName":"佐伯 カオリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"都内の某学園に通う二年生。"},{"spoiler":false,"text":"成績優秀で、明朗快活な女の子。"},{"spoiler":false,"text":"やや行き過ぎた正義感の持ち主で、過去、援助交際目当ての中年男性に声をかけられ、不快な思いをしたことから、同じ学園の運動部の男子と結託し、美人局（つつもたせ）的な「援交オヤジ狩り」を行っている。但し、あくまでもダメな大人を懲らしめるためであり、金銭を奪ったりはしていない。"},{"spoiler":false,"text":"性に対して潔癖で、未だ処女。また最近、自分の身体が女性らしく、ふくよかになってきたことに、やや戸惑いを感じているようだ。"}],"source":"egs","sourceCharacterId":"16490","sourceWorkId":"11389","spoiler":false},{"segments":[{"spoiler":false,"text":"都内の某学園に通う2年生。"},{"spoiler":false,"text":"明るく活発な性格の女の子で、成績も優秀。"},{"spoiler":false,"text":"最近、自分の身体つきがどんどん女性らしくまろやかなラインになってきたことに、多少とまどいを覚えている。"},{"spoiler":false,"text":"少々行きすぎた正義感の持ち主で、運動部の男子学生と結託して、援交目当ての男性を呼び出しては男子学生にボコらせる “援交オヤジ狩り” を行っている。"},{"spoiler":false,"text":"金銭などは一切受け取らず、「こんなダメ大人は痛い目にあって当然」だと思っている。"},{"spoiler":false,"text":"性的には潔癖で、まだ処女。しかし年相応に興味はある。"}],"source":"bangumi","sourceCharacterId":"52472"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"16490","sourceWorkId":"11389","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"16490","sourceWorkId":"11389","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"16490","sourceWorkId":"11389","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"16490","sourceWorkId":"11389","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"16490","sourceWorkId":"11389","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92ff54ad9262a8506b68124cd6e201ce9d9c17eb87354baceeb3b57603a496d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1effc9b9b1d4701a224122f309399b9a7d1fdc3bb718f24d28d2c3e8700aec58.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川知子","creatorId":"vndb:s694","sourcePersonId":"vndb:s694","canonicalEntityId":"vndb:s694","name":"ひむろゆり(氷室百合)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:211405:52472:5924:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p680","sourceCompanyId":"egs:brand:2186","canonicalEntityId":"vndb:p680","name":"極フェロ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:11389:2186","source":"egs"},{"companyId":"vndb:p680","sourc