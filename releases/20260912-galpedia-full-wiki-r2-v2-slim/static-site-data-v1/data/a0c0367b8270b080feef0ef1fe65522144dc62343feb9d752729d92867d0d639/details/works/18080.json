"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62439","characterName":"フェアリ一","sourceIds":{"vndbCharacterId":"c62439"},"originalCharacterName":"フェアリ一","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A fairy primarily encountered near the entrance to the dungeon. She likes humans and has a mischievous character, sometimes even pulling pranks in town."},{"spoiler":false,"text":"She plays innocent pranks because she likes humans, but her simple-mindedness also makes her go too far at times."}],"source":"vndb","sourceCharacterId":"c62439"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f20e51c0645c451e35732f4471190bc9b83763b1be3dbeca0a979a31651bd16.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb343646fe930c8d50a6fe59255be6b40257d94acf387cf2c9baa9192dc11dbd.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62440","characterName":"ワ一ウルフ","sourceIds":{"vndbCharacterId":"c62440"},"originalCharacterName":"ワ一ウルフ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A half-human, half-wolf girl. Hates being treated like a dog, but very much acts like one. Nevertheless, her physical strength is genuinely powerful. She loves to fight and is happy to be challenged to sexual duels as well."}],"source":"vndb","sourceCharacterId":"c62440"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/6928cbc8d7d0a68dda22bd52718e59d1414c4656ab9c0ac17e08c79e31a762b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b43b3fb9a42387a63d7b286a7bf077debbbd347a6876757f6839451db9f072d.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62441","characterName":"ソ一サラ一","sourceIds":{"vndbCharacterId":"c62441"},"originalCharacterName":"ソ一サラ一","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A witch who conducts magical experiments within the dungeon."},{"spoiler":false,"text":"She treats adventurers as guinea pigs and throws them out after draining their magical power, but she does this out of an eagerness for research, not any particular malice. However, she gets very angry when someone interrupts her work."}],"source":"vndb","sourceCharacterId":"c62441"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0f1d0208c056a56538bd8926b79f2fda69e64ca4ebeaaebfa4dd0bc77499e95.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37e9d5b4bfee35c45c31def8973fdff6ab91f5d37b046080f8b23b2ace8ac369.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62442","characterName":"フアイタ一","sourceIds":{"vndbCharacterId":"c62442"},"originalCharacterName":"フアイタ一","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A stout warrior who defends the first floor of the dungeon. Her absolute defense can turn any physical attack, and she can even deflect and counter magical attacks. Although she may appear human at first glance, her ability to effortlessly wear extremely heavy armor is literally superhuman."}],"source":"vndb","sourceCharacterId":"c62442"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0d5925693997fcea6e2b37ea7447dc3293ab4239c6cc63aa85fa93a7935d58e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73754a1015a8cf806322db296ad4fba9ca1728793b530008ef5ca03096828a67.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62445","characterName":"ドラ ゴ 二ュ一 ト","sourceIds":{"vndbCharacterId":"c62445"},"originalCharacterName":"ドラ ゴ 二ュ一 ト","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A half-human, half-dragon girl. The dragon newt family far surpasses humanity in physical prowess and fighting skill. In addition, they can use their breath as a weapon. However, this girl is still in training. Nevertheless, her nimble body allows her to unleash quick sword skills that can easily overwhelm the average human warrior."}],"source":"vndb","sourceCharacterId":"c62445"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e397cc02078601cbee141cd40ca098c3ff21a12d20bc6e39f905c7d98906663b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82ea5168aefdbfc2928636b029e8892568c2c0dcf0f1200f206fd1cd735c16f0.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62447","characterName":"ハ一ピ一","sourceIds":{"vndbCharacterId":"c62447"},"originalCharacterName":"ハ一ピ一","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl of the bird people race. According to one legend, harpies are filthy monsters. but this one prefers being very clean. She also likes singing and aspires to become a diva. Her songs are laced with magic, and if you carelessly listen to them, your body will fall under a spell of pleasure and become unable to move."}],"source":"vndb","sourceCharacterId":"c62447"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e8c7deddc214d3a438b6b2f9cc54076786d8d0ae4239ca941267611979886a4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/832a3a2e845614bdc06cc960fbf0db73d25cfcbae4a8f108e94dba606427fd75.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62449","characterName":"スライム","sourceIds":{"vndbCharacterId":"c62449"},"originalCharacterName":"スライム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A monster composed entirely of viscous liquid. She's a carefree individual, and loves sex. Her specialty is ensnaring opponents with her sticky body and depriving them of energy in her embrace. Due to her poor agility, she can't directly attack. Instead, her basic strategy is to create dummies that capture her opponent when attacked."}],"source":"vndb","sourceCharacterId":"c62449"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12da4d0f1df52ef75b22c5ac6c2b6747ed3b42a87c95dc174e2772bd0600eec3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62a4e8dfa1366fa37508293d6beee7882654a6b4ec3ec3ba635032052fb5db70.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62450","characterName":"リリム","sourceIds":{"vndbCharacterId":"c62450"},"originalCharacterName":"リリム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A demon of the night endowed with great magic that guards the second floor. Fascinated by ninja for some reason, she's read a large number of books about them that she collected from who knows where. Despite the books, she has a lot of misconceptions about ninja. Someone needs to teach her that a female ninja is a kunoichi and that 'coward' and unfair' are not words of praise."}],"source":"vndb","sourceCharacterId":"c62450"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fa0a3008f92bce1f1e55b0e54277faca843a1ab0e67f4b759b1c93fb565a431.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60434bc5196ddab46a4cb29c4a0d83a8eb79a02e1b0d99c3634c6e3e7ef6a5c3.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62451","characterName":"エンジェル","sourceIds":{"vndbCharacterId":"c62451"},"originalCharacterName":"エンジェル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An angel residing in the depths of the dungeon. With her beautiful, pure form and recovery magic, she's the epitome of an angel. She appears to be some kind of divine messenger, but the identity of the god she serves is unclear.She corrupts adventurers who come to visit her under the guise of healing them."}],"source":"vndb","sourceCharacterId":"c62451"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fceb959f77b080508c6555dd0f7b7097860374a2300c376882a7ac4781f5118f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58d540a0e7ef98cfa85c5eeebe1b223e52d034e03110c5b9152c000ebf9b378b.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62452","characterName":"ヴァンパィア","sourceIds":{"vndbCharacterId":"c62452"},"originalCharacterName":"ヴァンパィア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Vampires are blood-sucking demons that live in darkness and control the shadows. Her diet should naturally consist of blood. but instead she directly absorbs the life energy from her victims. Her ruby red lips provide intense pleasure as she drains out a man's life. Due to this ability she is called a life-sucking princess."}],"source":"vndb","sourceCharacterId":"c62452"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27041dbffba7f5a6261c70d64c311c45d90709e343ec4aa7d802d46e577bd4c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68495e69cd185d302152befd86374456029dba338ac13a3fa87bc6eff7656ac6.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62453","characterName":"サキュバス","sourceIds":{"vndbCharacterId":"c62453"},"originalCharacterName":"サキュバス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An erotic demon that inhabits people's dreams. She shows lewd dreams to men and is adept at sucking out their life energy while giving the men pleasure. Not restricted to the realm of dreams, she"},{"spoiler":false,"text":"can also enter the real world to entice men with her body."}],"source":"vndb","sourceCharacterId":"c62453"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f0173647b9f1deaaa009975ce2565c6da997e33f748ea99dad882fea7d975e8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76a47a5c4fc50c28c2469a29c158223233e27b5d659dd6328923e04a17c83718.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62454","characterName":"ゥロボロス","sourceIds":{"vndbCharacterId":"c62454"},"originalCharacterName":"ゥロボロス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The half-human half-snake protector of the dungeon. Her serpentine body is twisted in the symbol of infinity and contains the power to manipulate causality."},{"spoiler":false,"text":"What is she using this dungeon for? If you defeat her,perhaps you can find out."}],"source":"vndb","sourceCharacterId":"c62454"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dda085e2b3705eaacf3f95cf3ee9ab3aefe0af794b275b2295ef5292811395e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cd7c0fdbefb4bcafa4c56e0d