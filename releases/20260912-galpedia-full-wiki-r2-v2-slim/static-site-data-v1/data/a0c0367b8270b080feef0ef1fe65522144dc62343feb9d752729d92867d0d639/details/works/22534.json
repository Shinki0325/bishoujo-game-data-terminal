tus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year student at Seifu Academy. The younger sister. A virgin."},{"spoiler":false,"text":"Her grades are average, and she’s active in the light music club."},{"spoiler":false,"text":"She’s half-French, with strong French heritage, and her breasts are on the larger side."},{"spoiler":false,"text":"She’s free-spirited and willful, and she’s terrible at household chores."},{"spoiler":false,"text":"She respects her older sister, but when they’re face to face, she’s nothing but sarcastic."},{"spoiler":false,"text":"She finds the protagonist suspicious."},{"spoiler":false,"text":"Translated and edited from Gyutto"}],"source":"vndb","sourceCharacterId":"c23775"},{"segments":[{"spoiler":false,"text":"聖楓学園一年生。美姉妹の妹。処女。"},{"spoiler":false,"text":"成績はそこそこ、軽音楽部で活躍している。"},{"spoiler":false,"text":"フランス人とのハーフで、フランス系の血が濃く、おっぱいはきもち大きめ。"},{"spoiler":false,"text":"自由奔放で我侭なタイプで、家事全般は苦手。"},{"spoiler":false,"text":"姉のことは尊敬しているが、面と向かうと憎まれ口ばかり。"},{"spoiler":false,"text":"主人公の事をうさんくさく思っている。"}],"source":"egs","sourceCharacterId":"7273","sourceWorkId":"11361","spoiler":false},{"segments":[{"spoiler":false,"text":"聖楓学園1年生。"},{"spoiler":false,"text":"成績そこそこ、軽音楽部に所属"},{"spoiler":false,"text":"彼氏無し。自由奔放で、我が侭な所あり。"},{"spoiler":false,"text":"主人公の事をうさんくさく思っている。"},{"spoiler":false,"text":"鼻が良くて、汗臭いのが嫌い。"},{"spoiler":false,"text":"処女だったが、主人公に催眠薬を使われて無理矢理奪われている。"}],"source":"egs","sourceCharacterId":"7273","sourceWorkId":"22534","spoiler":false},{"segments":[{"spoiler":false,"text":"圣枫学园1年生。"},{"spoiler":false,"text":"自由奔放且傲娇属性的真理奈的妹妹。"},{"spoiler":false,"text":"girlspop乐队所属的学园歌姬。"},{"spoiler":false,"text":"尊敬姐姐，但面对面时只会说一些惹人讨厌的话。"},{"spoiler":false,"text":"不但不认可新的父亲，还认为他形迹可疑……倒不如说很讨厌。"}],"source":"bangumi","sourceCharacterId":"14555"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-