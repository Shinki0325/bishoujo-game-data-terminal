":"vndb:s14254","canonicalEntityId":"vndb:s14254","name":"ダックスインターナショナル","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:8296","source":"vndb"},{"creditedName":"ぱきら","creatorId":"vndb:s38265","sourcePersonId":"vndb:s38265","canonicalEntityId":"vndb:s38265","name":"ぱきら","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:8297","source":"vndb"},{"creditedName":"有限会社草薙","creatorId":"vndb:s13199","sourcePersonId":"vndb:s13199","canonicalEntityId":"vndb:s13199","name":"株式会社草薙","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:8298","source":"vndb"},{"creditedName":"スタジオクレフ","creatorId":"vndb:s45004","sourcePersonId":"vndb:s45004","canonicalEntityId":"vndb:s45004","name":"株式会社スタジオクレフ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:8299","source":"vndb"}]},"cast":[{"characterId":"char_c43257","characterName":"ことりん","sourceIds":{"bangumi":[{"characterId":"23252","match":"exact-normalized-name-in-linked-work","subjectId":"16864"}],"egsCharacterIds":["21179"],"vndbCharacterId":"c43257"},"originalCharacterName":"ことりん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"228"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"70"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の従兄妹で、天真爛漫な女の子。"},{"spoiler":false,"text":"元気で明るく、人懐っこいタイプ。"},{"spoiler":false,"text":"しっかり者の頑張り屋さんなのだが、反面、何でも一人で抱え込んでしまうことも。"}],"source":"egs","sourceCharacterId":"21179","sourceWorkId":"8947","spoiler":false},{"segments":[{"spoiler":false,"text":"一樹の従兄妹で、とばりと悠姫の親友。"},{"spoiler":false,"text":"元気で明るい天真爛漫な女の子。人懐っこく、背後から人に抱きつく癖がある。しっかり者の頑張り屋さんだが、それが裏目に出て、何でも一人で抱え込んでしまうことが多い。透き通った綺麗な歌声をもっているが、いつもヘンテコな歌ばかり口ずさんでいる。また、耳年増で妄想癖があり、エロ妄想が始まるとなかなか元の世界に戻ってこない。"},{"spoiler":false,"text":"小さい頃から何かと支えてくれた一樹を、「お兄ちゃん」と呼んで慕っているが、お互いに相手を異性として意識しておらず、裸を見られても気にしない仲。"},{"spoiler":false,"text":"「おにいちゃん、一緒にお風呂入る？」"}],"source":"bangumi","sourceCharacterId":"23252"}],"profileFacts":[{"label":"身高（本版本）","value":"149 cm","valueContext":null,"source":"egs","sourceCharacterId":"21179","sourceWorkId":"8947","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be204a07e2351b77f65dbdd36d4b94ffeafde3c50aa47dcda19b573a4290847f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a73cad6f4c3a2deaaa0ade340e60b57e0f6d231a3a73e2e0231b40bf84d5244c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊原ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16864:23252:4916:1","source":"bangumi"}]},{"characterId":"char_c43258","characterName":"藍沢 とばり","sourceIds":{"bangumi":[{"characterId":"23253","match":"exact-normalized-name-in-linked-work","subjectId":"16864"}],"egsCharacterIds":["21180"],"vndbCharacterId":"c43258"},"originalCharacterName":"藍沢 とばり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1024"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"69"},"height":{"reviewState":"no-conflict","source":"vndb","value":"142"},"hip":{"reviewState":"source-only","source":"vndb","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公や恋鳥の幼馴染で、由緒ある家柄の一人娘。"},{"spoiler":false,"text":"一見、静かで落ち着いた雰囲気の少女だが、中身はちょいS気味のゴーイングマイウェイ。"},{"spoiler":false,"text":"大和撫子を目指しているが、どちらかというと「姉御」っぽい。"}],"source":"egs","sourceCharacterId":"21180","sourceWorkId":"8947","spoiler":false},{"segments":[{"spoiler":false,"text":"小さくて華奢な身体と小悪魔のような含み笑いが特徴的な、恋鳥の幼なじみ。静かで落ち着いた雰囲気を醸し出しているが、中身はゴーイングマイウェイでちょいSな性格。一樹に命令したり恋鳥達にセクハラをして楽しんでいるが、すべて愛ゆえのこと。"},{"spoiler":false,"text":"由緒ある家柄の一人娘で、大和撫子を目指しているが、やっていることがどこかずれている。大好きな仁侠映画の影響か、行動派で情に厚く、大和撫子というよりは『姉御』になってしまった。"},{"spoiler":false,"text":"可愛いものが好きで、ぽわぽわでもこもこしたものを前にすると、我を忘れて無邪気に喜んでしまう女の子らしい一面もある。"},{"spoiler":false,"text":"「それはそれ、これはこれですわ」"}],"source":"bangumi","sourceCharacterId":"23253"}],"profileFacts":[{"label":"身高（本版本）","value":"142 cm","valueContext":null,"source":"egs","sourceCharacterId":"21180","sourceWorkId":"8947","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f97aea815f043288f75e90e8f812bf8378310eca73c939271a75520976a8cdab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b4917740b09f0828b46c60dccd9c19c0ccb380d2ea6c7c309f4a67cc6e89867.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16864:23253:4810:1","source":"bangumi"}]},{"characterId":"char_c43259","characterName":"姫","sourceIds":{"bangumi":[{"characterId":"23254","match":"exact-normalized-name-in-linked-work","subjectId":"16864"}],"egsCharacterIds":["21181"],"vndbCharacterId":"c43259"},"originalCharacterName":"姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"430"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"77"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイトでドイツ系アメリカ人のクォーター。"},{"spoiler":false,"text":"クールな物腰や仕草で少々近寄りがたいが、意外と世話焼き。"},{"spoiler":false,"text":"物ごとを一歩引いた位置から見るリアリストで、同年代の少女たちより、大人びた所があるが……。"}],"source":"egs","sourceCharacterId":"21181","sourceWorkId":"8947","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、ドイツ系アメリカ人の父と日本人の母を持つクォーター。とあるきっかけで、恋鳥達と仲良くなった。"},{"spoiler":false,"text":"意地悪そうな仕草とクールな物腰のおかげで少々近寄りがたいが、意外に世話焼き。不意打ちに弱かったり、プライドを刺激されるとムキになってしまう子供らしい一面も。"},{"spoiler":false,"text":"理数系科目やメカモノに強く、今はサイクリングがひそかな趣味。物事を一歩引いた位置から見るリアリストであり、同年代の娘達からみると大人びて見えるのだが、自分に素直な恋鳥やこころのことを、時折うらやましそうに見ている。"},{"spoiler":false,"text":"「お嬢さまっていうなっ！」"}],"source":"bangumi","sourceCharacterId":"23254"}],"profileFacts":[{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"21181","sourceWorkId":"8947","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/570fa92c369b221a7bad3ceb1b01273ab3cac768a37753308290ae10a3c9da78.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80700d4b3a424ab0b776da63f6350951ba227780091ebd77cb6242f108f3ea58.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16864:23254:4646:1","source":"bangumi"}]},{"characterId":"char_c43260","characterName":"日菜森 こころ","sourceIds":{"bangumi":[{"characterId":"23255","match":"exact-normalized-name-in-linked-work","subjectId":"16864"}],"egsCharacterIds":["21182"],"vndbCharacterId":"c43260"},"originalCharacterName":"日菜森 こころ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"701"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"お隣に住む幼馴染。"},{"spoiler":false,"text":"純粋で素直、誰にでも優しい家庭的な女の子。"},{"spoiler":false,"text":"主人公たちより一つ年上なのだが、お姉さん扱いされない事が不満らしい。"}],"source":"egs","sourceCharacterId":"21182","sourceWorkId":"8947","spoiler":false},{"segments":[{"spoiler":false,"text":"一樹の隣の家に住む幼なじみ。純粋で素直な性格に加え、誰にでも優しく接するため、異性はもちろん同性にも好かれている。"},{"spoiler":false,"text":"一流シェフ顔負けの料理の腕を持つが、本人は素朴な家庭料理を作るのが好き。裁縫も得意で、自分や恋鳥達の服を作ることもある。"},{"spoiler":false,"text":"実家は花屋を経営しており、本人もガーデニングが趣味。3年前に母親を亡くし、日菜森家の家事を一手に担っている。"},{"spoiler":false,"text":"一樹よりもひとつ年上だが、なかなか年上扱いしてもらえないことが不満らしい。"},{"spoiler":false,"text":"「わたし、お姉さんなんだよっ？」"}],"source":"bangumi","sourceCharacterId":"23255"}],"profileFacts":[{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"21182","sourceWorkId":"8947","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77cfd0f3f2caf4ab47435f47860deca025ea0763d6cae6e0d08a9174fad2baf3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68146cbb45068632008dfc4d8682d82920b09bf087ae9af54813f08604c05c0a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16864:23255:4809:1","source":"bangumi"}]},{"characterId":"char_c43261","characterName":"加賀見 朔夜","sourceIds":{"bangumi":[{"characterId":"23256","match":"exact-normalized-name-in-linked-work","subjectId":"16864"}],"egsCharacterIds":["21183"],"vndbCharacterId":"c43261"},"originalCharacterName":"加賀見 朔夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1103"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"72"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"成績優秀、運動神経抜群の生徒会長。"},{"spoiler":false,"text":"……なのだが、無口で表情が乏しく、どこか神秘的な雰囲気を醸し出している。"},{"spoiler":false,"text":"おいしい料理を作ってくれるこころに懐いている様子。"}],"source":"egs","sourceCharacterId":"21183","sourceWorkId":"8947","spoiler":false},{"segments":[{"spoiler":false,"text":"極端に無口で表情に乏しい、どこか神秘的な雰囲気を持つ少女。成績は学年トップクラスの上、運動神経にも優れる優等生。"},{"spoiler":false,"text":"こころとはクラスメイトで、学園の生徒会長を務める。感情をほとんど表に現すことがなく、誰も彼女の笑顔を見たことがない。実はかなりの健啖家で、おいしいごはんを作ってくれるこころに懐いている。"},{"spoiler":false,"text":"また、大の猫好きで、捨て猫を見つけては家に連れて帰るため、実家はさながら猫屋敷のようになっているらしい。基本的になんでもこなす器用人だが、じゃんけんはとても弱い。"},{"spoiler":false,"text":"「……おなかすいた」"}],"source":"bangumi","sourceCharacterId":"23256"}],"profileFacts":[{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"21183","sourceWorkId":"8947","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/100058009532499860aa0a7dd5858e48d261dcfccb4bf893d30fce7959d7fc4d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc529ca278912172b6bdd20fb5f0ad63f6751f30f90ae792d9544df9133756cb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結下みちる","creatorId":"vndb:s794","sourcePersonId":"vndb:s794","canonicalEntityId":"vndb:s794","name":"結下 みちる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16864:23256:4705:1","source":"bangumi"}]},{"characterId":"char_vndb_c43267","characterName":"麻生 水瀬","sourceIds":{"vndbCharacterId":"c43267"},"originalCharacterName":"麻生 水瀬","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"214"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6780061a08cc8055cd770fde2dfa6d7f29603224e86bdbb0dcd8b9257aa6131.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/0061afa7bdd298b1c35824fed2f4ad13ff4c965a6a76bb1151b59c1e92e4efe7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"倉田 まりや","crea