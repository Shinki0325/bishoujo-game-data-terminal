"sourceCharacterId":"205937"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f05c262c4c0bded81f3f2e841eb3c76248dd4a0786dcec2346173f4e6b64096.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/9373fa457ac8d83ba0cadb392dd3c0d79324a96a42a30e133830c930aaf34f16.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Raica","creatorId":"vndb:s5100","sourcePersonId":"vndb:s5100","canonicalEntityId":"vndb:s5100","name":"Raica","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:58892","source":"vndb"}]},{"characterId":"char_c25002","characterName":"美原 悠宇","sourceIds":{"bangumi":[{"characterId":"205936","match":"exact-normalized-name-in-linked-work","subjectId":"265997"}],"egsCharacterIds":["3882"],"vndbCharacterId":"c25002"},"originalCharacterName":"美原 悠宇","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Central heroine that invites protag to room. Her motives are not clear but she strangely nice to protag despite having no relationship outside of being class mates."},{"spoiler":true,"text":"Yuu has known about protagonist for awhile before they meet. She is famous YOU online gamer that is second only to protagonist. She used to be a tom boy only having guy friends and natural loved video games. But she became more self conscious so after she graduated and moved she decide to be more girly and give up gaming. But after she found out about protagonist she couldn't help her self. Not knowing how to approach him she asks him to room. Despite this she is still afraid of reveling self as YOU and that she is actual a gamer/tomboy."}],"source":"vndb","sourceCharacterId":"c25002"},{"segments":[{"spoiler":false,"text":"卒業を来年に控えた三年生。"},{"spoiler":false,"text":"クラスでは結構可愛い方に分類される女の子。成績は良い部類で、大学へ進学予定。"},{"spoiler":false,"text":"髪型はショート。身長は165センチ程度で主人公と同じ位。"},{"spoiler":false,"text":"体系は、どちらかというとスリムな方で、胸の大きさは普通。"},{"spoiler":false,"text":"性格はややツンで勝ち気、少々ガサツでサバサバしたタイプ。"},{"spoiler":false,"text":"外見はかわいい部類だが、勝ち気でガサツな性格が災いしてか、彼氏が出来た事が無く、勿論処女。"}],"source":"egs","sourceCharacterId":"3882","sourceWorkId":"20532","spoiler":false},{"segments":[{"spoiler":false,"text":"卒業を来年に控えた三年生。"},{"spoiler":false,"text":"クラスではけっこう可愛いほうに分類される女の子。"},{"spoiler":false,"text":"成績も良く、大学へ進学予定。"},{"spoiler":false,"text":"性格はややツンで勝ち気、少々ガサツでサバサバしたタイプ。"},{"spoiler":false,"text":"外見はかわいい部類だが、勝ち気でガサツな性格が災いしてか彼氏ができたことが無く、もちろん処女。"}],"source":"bangumi","sourceCharacterId":"205936"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db0d504360336ec068b3a5bc519b36b7c1c99905f8b957081a163a8d9b936e17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0e87e584d76232067fc664c80b00a6694d16714f5de532746e1bb5d8bad59f3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜 華","creatorId":"vndb:s10011","sourcePersonId":"vndb:s10011","canonicalEntityId":"vndb:s10011","name":"桜 華","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:58893","source":"vndb"}]},{"characterId":"char_c25003","characterName":"坂上 芽衣","sourceIds":{"bangumi":[{"characterId":"205938","match":"exact-normalized-name-in-linked-work","subjectId":"265997"}],"egsCharacterIds":["3883"],"vndbCharacterId":"c25003"},"originalCharacterName":"坂上 芽衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"description