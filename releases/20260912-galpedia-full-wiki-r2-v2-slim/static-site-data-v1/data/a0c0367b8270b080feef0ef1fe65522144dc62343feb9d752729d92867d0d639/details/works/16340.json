icalEntityId":"vndb:s1001","name":"聖 少女","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:78061","source":"vndb"},{"creditedName":"回転 木馬","creatorId":"vndb:s1027","sourcePersonId":"vndb:s1027","canonicalEntityId":"vndb:s1027","name":"回転 木馬","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:78065","source":"vndb"},{"creditedName":"デン","creatorId":"vndb:s1029","sourcePersonId":"vndb:s1029","canonicalEntityId":"vndb:s1029","name":"デン","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:78066","source":"vndb"}]},"cast":[{"characterId":"char_c25991","characterName":"姫乃 百合亜","sourceIds":{"bangumi":[{"characterId":"33817","match":"exact-normalized-name-in-linked-work","subjectId":"41090"}],"egsCharacterIds":["9208"],"vndbCharacterId":"c25991"},"originalCharacterName":"姫乃 百合亜","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"After a nude image her dear older sister took of her got leaked into the internet by a retro virus, and due to an unspecified amount of people seeing it, Yuria was decreed to have severely broken the Law Against Sexual Misconduct."},{"spoiler":false,"text":"Raised in an ordinary middle-class family, Yuria's parents had a good relationship with her, and she loved them as well. However, they abandoned her right after she got arrested, and left Yuria in a desperate state, leading to her signing a pledge for the transfer procedure to Seiren Gakuen. As a result, her life has gone completely off the rails..."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c25991"},{"segments":[{"spoiler":false,"text":"信用していたお姉様に撮られたヌード画像がレトロウイルスによりネットに流出してしまい、その画像が不特定多数の人に見られた事が問題となり、「SM禁止法違反」で誠憐学園行きとなってしまった少女。"},{"spoiler":false,"text":"平凡な中流の家庭で育ち、両親との関係も良好で、百合亜は両親を愛していた。"},{"spoiler":false,"text":"だがその両親は、娘がSM禁止法違反で逮捕されてしまった後ろめたさで、百合亜を置いて蒸発してしまう。"},{"spoiler":false,"text":"それが原因で自暴自棄になった百合亜は、ヤケになって誠憐学園の編入手続きの誓約書にサインをしてしまう。"},{"spoiler":false,"text":"結果、彼女の人生は、大きくレールから外れることになる……。"}],"source":"egs","sourceCharacterId":"9208","sourceWorkId":"16340","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/839fda913acb76e4fa1c0a2b44772434c8ce66970086eeac29a7a05d5f66931f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e4c44d8f9206ab535444a424f10fe7f68b961a0b0db7ca16f0064572e1f92ec.webp","width":83,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高村優里","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41090:33817:13512:1","source":"bangumi"}]},{"characterId":"char_c25992","characterName":"仁科 絵理","sourceIds":{"bangumi":[{"characterId":"48599","match":"exact-normalized-name-in-linked-work","subjectId":"41090"}],"egsCharacterIds":["9211"],"vndbCharacterId":"c25992"},"originalCharacterName":"仁科 絵理","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who has a complex over her boyish appearance and manners and wishes to be more feminine. However, she has to constantly worry about the image she gives off to others, and as such acts more boyishly. After finding out a certain secret about her, Eri's best friend betrayed her, and she was sent to Seiren Gakuen as a result."},{"spoiler":false,"text":"She actually went to the same school as Yuria, but the two never talked to each other. Eri had been interested in Yuria even before coming out, and after meeting her again at Seiren Gakuen, assumes they are two peas in a pod, doing her best to befriend Yuria immediately."},{"spoiler":false,"text":"Eri is also bad with men, but uses the masculine pronoun \"boku\" to address herself."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c25992"},{"segments":[{"spoiler":false,"text":"自分の容姿を「男の子みたいだ」とコンプレックスに感じており、女の子らしくしたいと望んでいる。"},{"spoiler":false,"text":"だが、周りが見ている自分へのイメージに対して、期待を裏切らないよう演じてしまってもいる。"},{"spoiler":false,"text":"そのイメージとは反対に真正なレズだったことが仇となり、信用していた友人に裏切られ告発され、誠憐学園に送られることとなった。"},{"spoiler":false,"text":"そこで一緒になった百合亜とは前の学園が同じだったが、顔見知り程度で話したことはなかった。"},{"spoiler":false,"text":"前々から百合亜のことが気になっていた事実をカミングアウトすると、同じくSM禁止法違反で捕まった彼女に対して自分と同じ性癖だと確信し、関係を迫るようになる。"},{"spoiler":false,"text":"しかし “令嬢” となるための授業では、男たちの性欲処理係として扱われていく――"},{"spoiler":false,"text":"ちなみに一人称は “ボク”。"}],"source":"egs","sourceCharacterId":"9211","sourceWorkId":"16340","spoiler":false},{"segments":[{"spoiler":false,"text":"自分の容姿が男の子みたいだとコンプレックスに感じており、女の子らしくしたいと望んでいる。"},{"spoiler":false,"text":"だが、周りが見ている自分へのイメージに対して、期待を裏切らないよう演じてしまってもいる。"},{"spoiler":false,"text":"そのイメージに反して真正なレズだったことが仇となり、信用していた友人に裏切られ告発され、誠憐学園に送られることとなった。"},{"spoiler":false,"text":"そこで一緒になった百合亜とは同じ学園だったが、顔見知り程度で話したことはなかった。"},{"spoiler":false,"text":"前々から百合亜のことが気になっていた事実をカミングアウトすると、同じくSM禁止法違反で捕まった彼女に対して自分と同じ性癖だと確信し、関係を迫るようになる。"},{"spoiler":false,"text":"しかし “令嬢” となるための授業では、男たちの性欲処理係として扱われていく――"},{"spoiler":false,"text":"ちなみに一人称は “ボク”。"},{"spoiler":false,"text":"「ほらボクって、男の人は苦手だから……」"}],"source":"bangumi","sourceCharacterId":"48599"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70b5e2c7fa005c7d612b0a66a61a3267e552fb9949da1e9953612125a221b3cf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e0e9022c5c1ee68b2bfe17fd2