lse,"text":"学生時代に複数の男たちにレイプされ、心に大きな傷を負っていたが、主人公の洗脳術によって立ち直り、主人公の忠実な助手として働くようになった。"},{"spoiler":false,"text":"しかし、最近になって、不穏な動きが目立つようになってきて……。"}],"source":"egs","sourceCharacterId":"18317","sourceWorkId":"10739","spoiler":false},{"segments":[{"spoiler":false,"text":"常に余裕のある微笑みを浮かべている、啓発セミナーの講師。"},{"spoiler":false,"text":"理知的な話し方をするが、優しいお姉さんといった感じで、冷たい感じは受けない。"},{"spoiler":false,"text":"ただし、彼女の本心は全く見えない。"}],"source":"bangumi","sourceCharacterId":"219089"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08d35494475f9274cae436eb4cf9a942300108abda872b0e8501d8ae2a925671.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d9af00a0734bff55fa4ddcaae04a4d98316c516e80f5f109da0e39455ef86a6.webp","width":159,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c70945","characterName":"渡会 静香","sourceIds":{"bangumi":[{"characterId":"219087","match":"exact-normalized-name-in-linked-work","subjectId":"217796"}],"egsCharacterIds":["18288"],"vndbCharacterId":"c70945"},"originalCharacterName":"渡会 静香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"24"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"トラウマ：「裏切り」"},{"spoiler":false,"text":"舞台となる学園に勤める女教師。主人公の同僚。"},{"spoiler":false,"text":"将来の夢は役者になることで、現在の教師の仕事は、あくまでも夢が叶うまでの繋ぎでしかない。"},{"spoiler":false,"text":"しかし、学生たちと接しているうちに情が移り、夢と教師としての仕事の板挟みにあって苦悩している。"}],"source":"egs","sourceCharacterId":"18288","sourceWorkId":"8713","spoiler":false},{"segments":[{"spoiler":false,"text":"学生思いの情熱的な女教師。"},{"spoiler":false,"text":"教師になる前に、女優を志した時期があり、そのとき主人公に恥ずかしい写真を撮られている。"},{"spoiler":false,"text":"その写真をネタに脅され、無理やりAVに出演させられる。"}],"source":"egs","sourceCharacterId":"18288","sourceWorkId":"10770","spoiler":false},{"segments":[{"spoiler":false,"text":"学生や教師の仕事が大好きで、前向きな姿勢を崩さない女性。"},{"spoiler":false,"text":"常に学生や学園のことを考えており、弱音を吐きそうになる主人公をいつも明るく励ましている。"},{"spoiler":false,"text":"流されそうになる主人公も、彼女がいるので頑張ろうと思いとどまっている。"},{"spoiler":false,"text":"昔は女優になるという夢を持っていた。"}],"source":"bangumi","sourceCharacterId":"219087"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/615a3a50a85ded536d93c59d4d3e6f7b6b21db7434e9082cf652ad8ce3ca59aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a4b24d9a60347f9871a59ae832fb8a0f90cf680f2ddae472c42060af0d193e6.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"しまだ かおり","creatorId":"vndb:s2665","sourcePersonId":"vndb:s2665","canonicalEntityId":"vndb:s2665","name":"しまだ かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41878","source":"vndb"}]},{"characterId":"char_c70946","characterName":"御厨 聡美","sourceIds":{"bangumi":[{"characterId":"219091","match":"exact-normalized-name-in-linked-work","subjectId":"217796"}],"egsCharacterIds":["18289"],"vndbCharacterId":"c70946"},"originalCharacterName":"御厨 聡美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"トラウマ：「姉の死」"},{"spoiler":false,"text":"舞台となる学園に通う女子学生。"},{"spoiler":false,"text":"彼女に代わってお使いに出た姉が事故に巻き込まれて亡くなったため、それが彼女の大きなトラウマになっている。"},{"spoiler":false,"text":"姉が自分の身代りになったと思い込み、それが彼女の心を苦しめている。"}],"source":"egs","sourceCharacterId":"18289","sourceWorkId":"8713","spoiler":false},{"segments":[{"spoiler":false,"text":"静香が教師として勤める学園の女学生。"},{"spoiler":false,"text":"姉が自分をかばって事故で亡くなったトラウマから自暴自棄になっている。"},{"spoiler":false,"text":"その心理を主人公に巧みに衝かれ、AVに出演させられる。"}],"source":"egs","sourceCharacterId":"18289","sourceWorkId":"10770","spoiler":false},{"segments":[{"spoiler":false,"text":"大人しくて物腰も柔らかく口調も丁寧な、学年一の優等生。"},{"spoiler":false,"text":"しかし、優秀であろうとかなりの無理をしており、今にも壊れそうな危うい雰囲気を纏っている。"},{"spoiler":false,"text":"時々、彼女しかいない場所で誰かと話し合う声などが聞こえたりしている。"}],"source":"bangumi","sourceCharacterId":"219091"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df11ae9f433fd7927b8b8f436e9e5110b92e7dca63d634cf6ee83882f982e7d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4db60d5b50f0e141326b335685fc7a95e757ef74074022fe052b46a8323917b.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"mahilo","creatorId":"vndb:s1492","sourcePersonId":"vndb:s1492","canonicalEntityId":"vndb:s1492","name":"眞尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41879","source":"vndb"}]},{"characterId":"char_vndb_c70947","characterName":"晴海 三継","sourceIds":{"vndbCharacterId":"c70947"},"originalCharacterName":"晴海 三継","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","me