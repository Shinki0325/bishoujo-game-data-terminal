{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"29471","model":{"presentationWorkId":"vndb:v23070","staff":{"artwork":[{"creditedName":"フェイトリネ-アルファ","creatorId":"vndb:s11936","sourcePersonId":"vndb:s11936","canonicalEntityId":"vndb:s11936","name":"フェイトリネ-アルファ","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:148795","source":"vndb"}],"scenario":[{"creditedName":"Waffle","creatorId":"vndb:s29887","sourcePersonId":"vndb:s29887","canonicalEntityId":"vndb:s29887","name":"Waffle","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:148797","source":"vndb"}],"music":[{"creditedName":"Zack Parrish","creatorId":"vndb:s12287","sourcePersonId":"vndb:s12287","canonicalEntityId":"vndb:s12287","name":"Zack Parrish","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:148796","source":"vndb"}],"other":[{"creditedName":"Badriel","creatorId":"vndb:s1838","sourcePersonId":"vndb:s1838","canonicalEntityId":"vndb:s1838","name":"Badriel","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:148793","source":"vndb"},{"creditedName":"Wanaca","creatorId":"vndb:s5464","sourcePersonId":"vndb:s5464","canonicalEntityId":"vndb:s5464","name":"Wanaca","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:148794","source":"vndb"},{"creditedName":"Exilim","creatorId":"vndb:s29888","sourcePersonId":"vndb:s29888","canonicalEntityId":"vndb:s29888","name":"Exilim","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:148798","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c84662","characterName":"Uzui Azusa","sourceIds":{"vndbCharacterId":"c84662"},"originalCharacterName":"Uzui Azusa","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Azusa may be a student at the prestigious Victoria Academy of Music, but she doesn’t take her studies seriously. She would far rather stare at the cute girls in her local maid café than practice the cello."},{"spoiler":false,"text":"Azusa’s father is incredibly famous in the world of classical music, and Azusa has a lot to live up to. The professors at her university constantly compare Azusa to her father, much to our heroine’s chagrin, and she’d really rather be judged on her own merits than those of her father’s."},{"spoiler":false,"text":"Unfortunately, Azusa’s only positive qualities are her exuberant energy and her unerring optimism."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c84662"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9ef4cbe8a43a9e8d45f664806257a23d2464800cba7ec31b10c832663ca4535a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/4882a46bce37d4c07ba90963810a24d84c3eba6d84b3b8e67e4dd0557a91ae56.webp","width":167,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c84663","characterName":"Suminoe Marilyn","sourceIds":{"vndbCharacterId":"c84663"},"originalCharacterName":"Suminoe Marilyn","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Azusa’s childhood friend. Mari – or ‘Marilyn’ - has stood by Azusa’s side through thick and thin. Mari routinely waking Azusa up in the mornings, reminds her about impending deadlines, and helps Azusa study in the university library."},{"spoiler":false,"text":"Despite everything Mari does for Azusa, Azusa regards her as a bit of a nag, and wishes she would just lighten up a little."},{"spoiler":false,"text":"Mari's father is obsessed with Western culture, and named her after the actress Marilyn Monroe."},{"spoiler":false,"text":"Edited from Steam"}],"source":"vndb","sourceCharacterId":"c84663"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c764ec350fa070ebd2790914860e27837863199149d08e890d37b94ada2dafa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad4dac0f491cff807836f129f2a983fd7e3e6418da330394152b161f23c04927.webp","width":167,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c84664","characterName":"Matsubara Mamiko","sourceIds":{"vndbCharacterId":"c84664"},"originalCharacterName":"Matsubara Mamiko","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The object of Azusa’s affections, and the most beautiful girl on the school campus. Mamiko is something of a musical genius, who can play the piano, the clarinet, and the harp, but she never boasts about her great accomplishments."},{"spoiler":false,"text":"All the girls in the Victoria Academy want to be like Mamiko, all the boys wish she was their girlfriend, and vice versa. Unfortunately, Mamiko is simply too perfect, and most people are intimidated by her goddess-like demeanour."},{"spoiler":false,"text":"Though Mamiko has a large number of fans, she doesn’t have many friends... That is, until Azusa begins to pursue her."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c84664"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bd0e73041d9b2ccccd5aa73a6a06dbea46e654965650f0236d89bda8723477c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/240691b0c5f8b2865d7cbcc874ed754ad3ee9c201b5bb312aad590248e020800.webp","width":167,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p4019","sourceCompanyId":"egs:brand:4611","canonicalEntityId":"vndb:p4019","name":"Winged Cloud","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:29471:4611","source":"egs"},{"companyId":"vndb:p12725","sourceCompanyId":"vndb:p12725","canonicalEntityId":"vndb:p12725","name":"GrownUpByTheSakuraDungeon","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:119060:v23070","source":"vndb"},{"companyId":"vndb:p4019","sourceCompanyId":"vndb:p4019","canonicalEntityId":"vndb:p4019","name":"Winged Cloud","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:155092:v23070","source":"vndb"},{"companyId":"vndb:p4019","sourceCompanyId":"vndb:p4019","canonicalEntityId":"vndb:p4019","name":"Winged Cloud","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:64916:v23070","source":"vndb"},{"companyId":"vndb:p4019","sourceCompanyId":"vndb:p4019","canonicalEntityId":"vndb:p4019","name":"Winged Cloud","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:64917:v23070","source":"vndb"},{"companyId":"vndb:p6627","sourceCompanyId":"vndb:p6627","canonicalEntityId":"vndb:p6627","name":"Kimgaemandoo","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:67556:v23070","source":"vndb"},{"companyId":"vndb:p8132","sourceCompanyId":"vndb:p8132","canonicalEntityId":"vndb:p8132","name":"MIÐGARÐ","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:72765:v23070","source":"vndb"},{"companyId":"vndb:p11141","sourceCompanyId":"vndb:p11141","canonicalEntityId":"vndb:p11141","name":"Oji-san","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:84695:v23070","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","egs-creator-credit-missing"],"source":"terminal-wiki-full-runtime-v7"}}
