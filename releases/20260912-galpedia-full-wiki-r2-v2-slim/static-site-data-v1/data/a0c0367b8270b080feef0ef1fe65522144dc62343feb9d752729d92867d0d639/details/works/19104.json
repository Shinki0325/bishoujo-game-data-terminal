{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"19104","model":{"presentationWorkId":"vndb:v12626","staff":{"artwork":[{"creditedName":"八月朔日珈瑠","creatorId":"vndb:s4915","sourcePersonId":"egs:creator:5455","canonicalEntityId":"vndb:s4915","name":"八月朔日珈瑠","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:120708","source":"egs"}],"scenario":[{"creditedName":"青山拓也","creatorId":"vndb:s2621","sourcePersonId":"egs:creator:391","canonicalEntityId":"vndb:s2621","name":"青山拓也","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:120709","source":"egs"}],"music":[{"creditedName":"クサノ ユウキ","creatorId":"vndb:s11387","sourcePersonId":"vndb:s11387","canonicalEntityId":"vndb:s11387","name":"クサノ ユウキ","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:99924","source":"vndb"}],"other":[{"creditedName":"八月朔日 珈瑠","creatorId":"vndb:s4915","sourcePersonId":"vndb:s4915","canonicalEntityId":"vndb:s4915","name":"八月朔日珈瑠","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:99922","source":"vndb"}]},"cast":[{"characterId":"char_c24726","characterName":"長谷倉 真奈","sourceIds":{"bangumi":[{"characterId":"215490","match":"exact-normalized-name-in-linked-work","subjectId":"224302"}],"egsCharacterIds":["731"],"vndbCharacterId":"c24726"},"originalCharacterName":"長谷倉 真奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【可愛そうな眼鏡娘】"},{"spoiler":false,"text":"クラスに１人は居る「眼鏡」「無口で根暗」「友達居ない」「休み時間は読書」"},{"spoiler":false,"text":"「何も主張しない（出来ない）」を絵に書いたような少女。"},{"spoiler":false,"text":"それまでは教室の片隅で平穏に過ごしていたが、クラスの不良“村瀬”に目を付けられたのが運のつき。"},{"spoiler":false,"text":"不良達の策略により肉奴隷としての人生を歩むことに。"},{"spoiler":false,"text":"それほど大きくない身長とはアンバランスな豊満な乳房がポイント。"},{"spoiler":false,"text":"本人的には気にしている所だが、男性諸氏にとっては熟れた果実状態である。"},{"spoiler":false,"text":"常に俯き加減でボソボソと小声で話す辺りに自分への自信の無さが伺える。"},{"spoiler":false,"text":"加えて度のキツい眼鏡を常に着用し、あまりファッションなどにも気を配らない様子。"},{"spoiler":false,"text":"同性異性関わらず心を許せる友達は学園には居ない。"}],"source":"egs","sourceCharacterId":"731","sourceWorkId":"19104","spoiler":false},{"segments":[{"spoiler":false,"text":"「無口」 「影薄い」 「無主張」 「押しに弱い」 「友好関係狭い」"},{"spoiler":false,"text":"クラスで１人は居た「眼鏡」「無口で根暗」"},{"spoiler":false,"text":"「友達居ない」「休み時間は読書」「何も主張しない"},{"spoiler":false,"text":"（出来ない）」を具現化した今作のメインヒロイン。"},{"spoiler":false,"text":"それでも、今回の騒動に巻き込まれるまでは"},{"spoiler":false,"text":"平穏無事に過ごしていたのだが、クラスの不良"},{"spoiler":false,"text":"「村瀬」に心をときめかしてしまったのが運のつき。"},{"spoiler":false,"text":"不良達の策略により肉奴隷としての人生を"},{"spoiler":false,"text":"歩むことになってしまった。"},{"spoiler":false,"text":"それほど大きくない身長とは"},{"spoiler":false,"text":"アンバランスな豊満な乳房がポイント。"},{"spoiler":false,"text":"本人的には気にしている所だが、"},{"spoiler":false,"text":"男性諸氏にとっては熟れた果実状態である。"},{"spoiler":false,"text":"常に俯き加減でボソボソと小声で話す辺りに"},{"spoiler":false,"text":"自分への自信の無さが伺える。"},{"spoiler":false,"text":"加えて度のキツい眼鏡を常に着用し、"},{"spoiler":false,"text":"あまりファッションなどにも気を配らない様子。"},{"spoiler":false,"text":"同性異性関わらず心を許せる友達は"},{"spoiler":false,"text":"学園には居ないようである。"}],"source":"bangumi","sourceCharacterId":"215490"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/4903e0e8e0f7e5f508cb9aafd8cc5dbd47230eafed8b86c7b90dffbac071c582.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c068091256b3f753d9c2430d69b4168a540d02992d7cb6b422d6e891ad569d05.webp","width":137,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長月 空","creatorId":"vndb:s12698","sourcePersonId":"vndb:s12698","canonicalEntityId":"vndb:s12698","name":"長月 空","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53409","source":"vndb"}]},{"characterId":"char_c24727","characterName":"相田 祐里子","sourceIds":{"bangumi":[{"characterId":"215491","match":"exact-normalized-name-in-linked-work","subjectId":"224302"}],"egsCharacterIds":["732"],"vndbCharacterId":"c24727"},"originalCharacterName":"相田 祐里子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【メガネの不良女子】"},{"spoiler":false,"text":"茶髪に着崩した制服と典型的な不良娘。"},{"spoiler":false,"text":"人懐っこい性格で主人公にもフレンドリーな（無遠慮な）口調と態度で接して来る。"},{"spoiler":false,"text":"反面、子供が無邪気に虫を殺すような残虐さも持ち合わせており、自分よりヒエラルキーの低い者にはどの様な事をしても許されると思っている節がある。"},{"spoiler":false,"text":"学園ではクラスメイトの村瀬と付き合っているのだが、性に大変奔放であり、現在までに100人以上（老若男女関わらず）と肉体関係を結んでいるのだが、当の村瀬はその事を知らない。"},{"spoiler":false,"text":"実は根っからのマゾヒスト体質で、作中では自分より明らかに格下のキモオタ（主人公）から"},{"spoiler":false,"text":"奴隷のような扱いをされる事に、何よりの快感を見出してしまう。"}],"source":"egs","sourceCharacterId":"732","sourceWorkId":"19104","spoiler":false},{"segments":[{"spoiler":false,"text":"「素行不良」 「性に奔放」 「人懐っこい」 「残虐性」 「マゾヒスト」"},{"spoiler":false,"text":"茶髪に着崩した制服とテンプレ通りな不良娘。"},{"spoiler":false,"text":"人懐っこい性格で主人公にもフレンドリーな"},{"spoiler":false,"text":"（無遠慮な）口調と態度で接して来る。"},{"spoiler":false,"text":"反面、子供ながらの残虐的な面も持ち合わせており、"},{"spoiler":false,"text":"自分よりヒエラルキーの低い者にはどの様な事をしても"},{"spoiler":false,"text":"許されると思っている節がある。"},{"spoiler":false,"text":"学園ではクラスメイトの村瀬と付き合っているのだが、"},{"spoiler":false,"text":"性に大変奔放であり、現在までに１００人以上"},{"spoiler":false,"text":"（老若男女関わらず）と肉体関係を結んでいるのだが、"},{"spoiler":false,"text":"当の村瀬はその事を知らないでいる。"},{"spoiler":false,"text":"実は根っからのマゾヒスト体質で、作中では自分より"},{"spoiler":false,"text":"明らかに格下のキモオタ（主人公）から奴隷のような"},{"spoiler":false,"text":"扱いをされる事に、何よりの快感を見出してしまう。"}],"source":"bangumi","sourceCharacterId":"215491"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-as