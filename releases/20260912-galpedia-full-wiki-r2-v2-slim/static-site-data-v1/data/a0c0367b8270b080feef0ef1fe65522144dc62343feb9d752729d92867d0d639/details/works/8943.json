dentityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"広宇が通う学園の先輩。学力優秀、容姿端麗、学校一の美人で、男子生徒全ての憧れの存在。今まで数え切れない程の男から想いを告げられている。しかし誰も夏子の心を射止めた人物はいない。"},{"spoiler":false,"text":"普段は大人びた感じだが、ラーメンを前にすると目の色が変わったりとお茶目な一面もちらほら。広宇の恋心とは違った憧れの存在。"},{"spoiler":false,"text":"体の弱かった夏子の母は、夏子を産んだことにより、命を落としてしまっていた。最愛の妻を失った父親は、その事実を受け止められず、夏子に妻の姿を重ねて見るようになった。夏子も事情を知り、"},{"spoiler":false,"text":"それを甘んじて受け止めたのだが、そんな日々が続くにつれ重荷に感じていく。"}],"source":"egs","sourceCharacterId":"21184","sourceWorkId":"8943","spoiler":false},{"segments":[{"spoiler":false,"text":"広宇就读的学校的学姐。成绩很好，长相漂亮，学校的第一美女，所有男生憧憬的对象。"},{"spoiler":false,"text":"虽然有无数的男生对她告白过，但是至今谁也没能得到她的芳心。"},{"spoiler":false,"text":"平时看起来很成熟，但是看到拉面就变的很孩子气。对広宇而言，她不是爱恋而是憧憬的对象。"},{"spoiler":false,"text":"夏子的母亲因为体质虚弱，因为生下夏子而去世了。"},{"spoiler":false,"text":"失去了最爱的妻子的父亲无法接受这个事实，把夏子当成了妻子的影子。"},{"spoiler":false,"text":"夏子知道后，虽然乐观的接受了这件事情，但是这样一天天的感觉到了很大的压力。"}],"source":"bangumi","sourceCharacterId":"77435"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"21184","sourceWorkId":"8943","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"21184","sourceWorkId":"8943","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"21184","sourceWorkId":"8943","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"21184","sourceWorkId":"8943","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"54 kg","valueContext":null,"source":"egs","sourceCharacterId":"21184","sourceWorkId":"8943","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53a4f8c4815a196364113fc4dfe1e80740c51804468c47f4f2b360ccb97fad81.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42d572fdd826a95e3f0b0859fa2a7f8c7accd2a12e9e949b8aee56239ebc6c75.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"ももぞの薫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:27628:77435:6131:1","source":"bangumi"}]},{"characterId":"char_c55356","characterName":"森田 奈緒","sourceIds":{"bangumi":[{"characterId":"77436","match":"exact-normalized-name-in-linked-work","subjectId":"27628"}],"egsCharacterIds":["21185"],"vndbCharacterId":"c55356"},"originalCharacterName":"森田 奈緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"5/3"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"広宇が通う学園の後輩。元気という言葉は奈緒のためにある。そう思えてしまう程の暴走小娘。常に自分のペースを持ち、他人に合わせようとしない。広宇は唯一、奈緒のペースを乱せる人物である。"},{"spoiler":false,"text":"地元にある手作りアイスクリーム屋『ならさわ』でバイトしていて看板娘（自称）らしい。ならさわのクリーム善ざいとアイスモナカが大の好物。"},{"spoiler":false,"text":"幼い頃の奈緒は、横暴な父親が母親を迫害することに心を痛めていた。そんな日々が続くにつれ、母親は精神的に追い詰められていった。そして、奈緒の心にも深い傷が残った。"}],"source":"egs","sourceCharacterId":"21185","sourceWorkId":"8943","spoiler":false},{"segments":[{"spoiler":false,"text":"広宇所在学校的学妹。活力十足这句话几乎就是为了奈緒存在的一样，就是一个可以这么去理解的暴走小丫头。"},{"spoiler":false,"text":"一直保持着自己的步调，不和其他人配合。広宇是唯一能打乱奈緒步调的人。"},{"spoiler":false,"text":"在当地的手工冰淇淋店“ならさわ”打工，自称是招牌小姐的样子。最喜欢吃“ならさわ”的冰淇淋和抹茶。"},{"spoiler":false,"text":"小时候的奈緒，在粗暴的父亲虐待母亲的时候心疼不已。"},{"spoiler":false,"text":"随着这样的日子的持续，母亲的精神终于崩溃了。而且，奈緒的心中也留下了深深的伤痕。"}],"source":"bangumi","sourceCharacterId":"77436"}],"profileFacts":[{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"21185","sourceWorkId":"8943","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"21185","sourceWorkId":"8943","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"21185","sourceWorkId":"8943","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"21185","sourceWorkId":"8943","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"45 kg","valueContext":null,"source":"egs","sourceCharacterId":"21185","sourceWorkId":"8943","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f9b8b69ae109c57e736e7aead781f3e7cf48e9961969e55766fac775b8f069ba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28470813e475e99614cb70ccf58ae19b7de2c3ed123d925ea8b53be56625dc77.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","na