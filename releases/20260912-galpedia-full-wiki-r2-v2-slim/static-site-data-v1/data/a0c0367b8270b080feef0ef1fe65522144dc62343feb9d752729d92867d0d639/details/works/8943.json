eviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"35"}},"descriptions":[{"segments":[{"spoiler":false,"text":"容姿は子供そのものだが、正真正銘、広宇の祖母である。"},{"spoiler":false,"text":"前に出版した夢占いの本がベストセラーになり、今や地元だけに留まらず全国的にもその名が知れ渡っているが、広宇からしてみたらただの毒舌妖怪ばばあである。"},{"spoiler":false,"text":"甘い物に目がなく、料理をするとなんでも甘く作ってしまう。"},{"spoiler":false,"text":"糖分控えめで注文すると塩分が多くなる。"}],"source":"egs","sourceCharacterId":"18285","sourceWorkId":"8943","spoiler":false},{"segments":[{"spoiler":false,"text":"『夢見師』から登場の夢占い師。"},{"spoiler":false,"text":"甘いものがなによりの好物。"},{"spoiler":false,"text":"一見、幼い少女に見えるが、本当の年齢は……？"}],"source":"egs","sourceCharacterId":"18285","sourceWorkId":"10782","spoiler":false},{"segments":[{"spoiler":false,"text":"虽然长相看起来很象小孩子，实实在在的是広宇的祖母。"},{"spoiler":false,"text":"因为之前出版的占梦书销量很好，虽然现在住在老家，但是在全国都很有名，对広宇来说却只是个毒舌妖怪的老太婆。喜欢吃甜食，不管什么食物都做的很甜。如果要求少放糖的话就会放很多盐。"}],"source":"bangumi","sourceCharacterId":"77434"}],"profileFacts":[{"label":"胸围（本版本）","value":"66 cm","valueContext":null,"source":"egs","sourceCharacterId":"18285","sourceWorkId":"8943","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"140 cm","valueContext":null,"source":"egs","sourceCharacterId":"18285","sourceWorkId":"8943","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"69 cm","valueContext":null,"source":"egs","sourceCharacterId":"18285","sourceWorkId":"8943","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"18285","sourceWorkId":"8943","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"35 kg","valueContext":null,"source":"egs","sourceCharacterId":"18285","sourceWorkId":"8943","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b76461ce17b35a4f22d9c38a63fd23110cd4f6e2d5b34ad975c528f7d0daed3.we