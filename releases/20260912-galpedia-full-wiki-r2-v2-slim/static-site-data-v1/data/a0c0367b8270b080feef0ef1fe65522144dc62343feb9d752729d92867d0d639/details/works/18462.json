atus":"auto-confirmed","relationId":"egs:work-creator:115965","source":"egs"},{"creditedName":"栗栖","creatorId":"vndb:s720","sourcePersonId":"egs:creator:2594","canonicalEntityId":"vndb:s720","name":"栗栖","detail":"企画、原作","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:169800","source":"egs"},{"creditedName":"チームいーちゃん","creatorId":"vndb:s699","sourcePersonId":"egs:creator:16111","canonicalEntityId":"vndb:s699","name":"チームいーちゃん","detail":"グラフィック","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:169801","source":"egs"},{"creditedName":"巫浄スウ","creatorId":"vndb:s644","sourcePersonId":"egs:creator:15520","canonicalEntityId":"vndb:s644","name":"巫浄スウ","detail":"演出","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:169802","source":"egs"},{"creditedName":"EDEN","creatorId":"vndb:s536","sourcePersonId":"egs:creator:15521","canonicalEntityId":"vndb:s536","name":"EDEN","detail":"演出","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:169803","source":"egs"},{"creditedName":"C'est moi","creatorId":"vndb:s974","sourcePersonId":"egs:creator:18966","canonicalEntityId":"vndb:s974","name":"C'est moi","detail":"背景美術","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:169804","source":"egs"},{"creditedName":"EDEN","creatorId":"vndb:s536","sourcePersonId":"vndb:s536","canonicalEntityId":"vndb:s536","name":"EDEN","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:97987","source":"vndb"},{"creditedName":"EDEN","creatorId":"vndb:s536","sourcePersonId":"vndb:s536","canonicalEntityId":"vndb:s536","name":"EDEN","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:97988","source":"vndb"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:97989","source":"vndb"},{"creditedName":"巫浄 スウ","creatorId":"vndb:s644","sourcePersonId":"vndb:s644","canonicalEntityId":"vndb:s644","name":"巫浄 スウ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:97993","source":"vndb"},{"creditedName":"笹山 逸刀斎","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:97994","source":"vndb"},{"creditedName":"栗栖","creatorId":"vndb:s720","sourcePersonId":"vndb:s720","canonicalEntityId":"vndb:s720","name":"栗栖","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:97996","source":"vndb"},{"creditedName":"真田 アキラ","creatorId":"vndb:s35156","sourcePersonId":"vndb:s35156","canonicalEntityId":"vndb:s35156","name":"真田 アキラ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:97999","source":"vndb"}]},"cast":[{"characterId":"char_c13046","characterName":"狼谷 凜","sourceIds":{"bangumi":[{"characterId":"57439","match":"exact-normalized-name-in-linked-work","subjectId":"68227"}],"egsCharacterIds":["505"],"vndbCharacterId":"c13046"},"originalCharacterName":"狼谷 凜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main heroine who recently transferred to Ryuusei Academy, and is a classmate of Akito."},{"spoiler":false,"text":"Has a bit of a shadowy atmosphere, and she's one who doesn't speak unless spoken to. Beautiful and has a nice figure. Has good grades, and the number of boys secretly aiming to date her is rapidly increasing. The girls are also fond of her."},{"spoiler":false,"text":"Behind the face she puts on everyday, she's actually a demon hunter who hunts Youmas ever since she was a child. She's an elite demon hunter who uses the power of the wolf, and so she has its high offensive power, explosive speed, and most of all, the ability to materialize a sword out of the fang of her spirit wolf."},{"spoiler":false,"text":"Using her sword and ablities, she mercilessly eliminates Youmas without hesitation as an elite demon hunter. She's also known as the \"wolf of the silver blade\", and is feared even by Youmas."},{"spoiler":false,"text":"Slightly edited and translated from Official Site"}],"source":"vndb","sourceCharacterId":"c13046"},{"segments":[{"spoiler":false,"text":"本作のメインヒロイン。"},{"spoiler":false,"text":"最近龍泉学園に転入してきた転校生で、秋斗のクラスメイト。"},{"spoiler":false,"text":"少し影があるような雰囲気を持ち自分から進んで話す方ではないが、美人でスタイルがいい。"},{"spoiler":false,"text":"成績もよくて密かに狙っている男子が急増中。同性にも好かれている。"},{"spoiler":false,"text":"そんな表の顔とは裏腹に、幼い頃から妖魔とずっと闘ってきた降魔師でもある。"},{"spoiler":false,"text":"降魔師の中でもトップクラスの狼の因子を持ち、攻撃力瞬発力、なにより強力な狼の牙に代わる刀を具現化させる能力を持つ。"},{"spoiler":false,"text":"それを武器に一切の容赦も躊躇もなく妖魔を倒してしまう凄腕の降魔師。"},{"spoiler":false,"text":"銀刃の狼という二つ名で呼ばれ、妖魔からも恐れられている。"}],"source":"egs","sourceCharacterId":"505","sourceWorkId":"18462","spoiler":false},{"segments":[{"spoiler":false,"text":"本作的女主。"},{"spoiler":false,"text":"最近转学到龙泉学园，秋斗的同学。"},{"spoiler":false,"text":"给人有点无精打采的感觉，从不自己主动起头话题，长得很漂亮，身材也很好。"},{"spoiler":false,"text":"成绩不错，暗地里准备向她告白的男生正在急速增加，在同性中也很受欢迎。"},{"spoiler":false,"text":"与其光鲜的外表不同，她从小就成为了一名降魔师并一直与妖魔战斗至今。"},{"spoiler":false,"text":"在降魔师中拥有着最顶级的狼的因子，这不仅使她具有极强的攻击力、爆发力，更有着能召唤出与狼牙媲美的刀。"},{"spoiler":false,"text":"她以此为武器毫不犹豫的斩杀妖魔，是个能干的降魔师。"},{"spoiler":false,"text":"有着“银刃之狼”的称号，被妖魔们惧怕着。"},{"spoiler":false,"text":"“妖魔要立马处理掉”"}],"source":"bangumi","sourceCharacterId":"57439"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41a30e4cbd869c123381b5ac9caa4a8931f96f9b68889a96ac006eee67739df7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1ad1a8332a0ccbf1a112bb420feeda82cd9ba642835e3091c1ebe697097c602.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:68227:57439:8055:1","source":"bangumi"}]},{"characterId":"char_c13047","characterName":"西崎 秋斗","sourceIds":{"bangumi":[{"characterId":"57440","match":"exact-normalized-name-in-linked-work","subjectId":"68227"}],"egsCharacterIds":["507"],"vndbCharacterId":"c13047"},"originalCharacterName":"西崎 秋斗","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist who is attending Ryuusei Academy. An unfortunate person who got wounded by a Youma, which infected him with a virus that will cause him to morph into a Youma. However, he remained human with his personality intact. It turns out that he has the qualities of a rare breed of Youma which can transform freely from human to Youma and back, called \"Kakusei-mono\". However, he can't control it, and if he completely succumbs to negative emotions, he will lose himself."},{"spoiler":false,"text":"Same with his other male schoolmates, he admires Rin. Because that same Rin plans to kill him if he completely loses himself to the Youma virus, he thinks of ways to seduce her and make her fall for him. He's a pure but perverted gentleman who lets his delusions run wild everyday."},{"spoiler":false,"text":"Slightly edited and translated from Official Site"}],"source":"vndb","sourceCharacterId":"c13047"},{"segments":[{"spoiler":false,"text":"本作的主角，在龙泉学园上学。"},{"spoiler":false,"text":"被妖魔弄伤，似乎即将变成妖魔的不幸之人。"},{"spoiler":false,"text":"不过，他有觉醒者的资质——感染了妖魔病毒却没有变成妖魔，依然保持着人类的形态，人格也依然不变的特殊个体。"},{"spoiler":false,"text":"与其他男生一样憧憬着凜。"},{"spoiler":false,"text":"差点被憧憬之人杀掉，但总想着怎么将她怎么将她攻略（性意义上的），平时也一直是各种妄想的纯粹的变态绅士。"},{"spoiler":false,"text":"“狼谷同学的胸部实在是太厉害了”"}],"source":"bangumi","sourceCharacterId":"57440"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/726cd4011bf7a3089a9fa8d19cb744bbf5e6dc710f435c2e0efff492a33d8359.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce289e627bae57c25a26c3bbb45095eb766a154ccff3e8cc1cf277f39f0c56bb.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c13048","characterName":"獅子原・シン・要","sourceIds":{"vndbCharacterId":"c13048"},"originalCharacterName":"獅子原・シン・要","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man who is said to be the strongest Youma at the moment. He is a lion-class Youma who can transform from human to Youma and back, known as \"Kakusei-mono\"."},{"spoiler":false,"text":"A quarter-Indian, effeminate person. He is Rin's target of revenge, and since Rin always throws a wrench in his plans at every opportunity she gets, he also aims to take her life."},{"spoiler":false,"text":"Slightly edited and translated from Official Site"}],"source":"vndb","sourceCharacterId":"c13048"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb0a3bd6a67bb15610f4d051681d758bac55a84dcc3bbe86b40665f7d1a0ae9d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64841d2e6721a05fcc6ffb429cd38219156daee97af9867435211ed264858e71.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c65050","characterName":"獅子原・シン・要","sourceIds":{"vndbCharacterId":"c65050"},"originalCharacterName":"獅子原・シン・要","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The lion-class, Youma form of Shishihara."}],"source":"vndb","sourceCharacterId":"c65050"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03b01725e454a8dc6eec2d9c58691e4a9d8ded2b40fa73a4a3f1d656fa51a338.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b00951d4cb5964089eb2ca20c63da0039394bcead58440cf39594ad22d366013.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c65051","characterName":"西崎 秋斗","sourceIds":{"vndbCharacterId":"c65051"},"originalCharacterName":"西崎 秋斗","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The tiger-class, Youma form of Akito. In this form, he is more powerful than Shishihara and faster than Rin."},{"spoiler":false,"text":"Unknown to him, he is the last surviving member of the Nishizaki clan, so the tiger-class youma flows within his blood. It is the reason why he wasn't infected by the lion-class or snake-class youma virus."}],"source":"vndb","sourceCharacterId":"c65051"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e481a7b9c7d15a64927f8543156a8bd4e8464ad3246f11623d0e15d4e296769a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a58317b64f66494f3c230f11970f620f54b04da2289b1363769433ba33b7fe0.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:1036","sourceCompanyId":"egs:brand:1036","canonicalEntityId":"egs:brand:1036","name":"LiLiTH","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:18462:1036","source":"egs"},{"companyId":"vndb:p18928","sourceCompanyId":"vndb:p18928","canonicalEntityId":"vndb:p18928","name":"絮足瑞林","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:120101:v12297","source":"vndb"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:30440:v12297","source":"vndb"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:30441:v12297","source":"vndb"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:80204:v12297","source":"vndb"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:80205:v12297","source":"vndb"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:80207:v12297","source":"vndb"}],"missingStates":[],"source":