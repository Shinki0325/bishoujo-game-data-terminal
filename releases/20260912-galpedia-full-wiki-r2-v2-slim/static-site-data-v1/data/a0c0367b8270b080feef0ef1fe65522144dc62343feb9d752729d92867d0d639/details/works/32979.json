6","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92097","source":"vndb"}]},{"characterId":"char_vndb_c115947","characterName":"ロベルト・ギー","sourceIds":{"vndbCharacterId":"c115947"},"originalCharacterName":"ロベルト・ギー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"27"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is the competent butler of the theater and the heroine's superior, and although he sometimes treats the manager harshly, he serves faithfully."},{"spoiler":false,"text":"He is uncompromising when it comes to his work and is always perfect so no one can complain."},{"spoiler":false,"text":"His abilities are high, but there are many unknown points in his career, and his origins are shrouded in mystery."},{"spoiler":false,"text":"Translated from the official twitter"}],"source":"vndb","sourceCharacterId":"c115947"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0dfd8c09f88404648c6e305428c3cc2886bb0a5f429ca377dc8418de96e4841b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5d2ef8a21c2f2a0cd1c7ad235185fae06ca19471801e8890f068bc501fa9b3c.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本間 かいな","creatorId":"vndb:s11602","sourcePersonId":"vndb:s11602","canonicalEntityId":"vndb:s11602","name":"本間 かいな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92102","source":"vndb"}]},{"characterId":"char_vndb_c115948","characterName":"マクシミリアン","sourceIds":{"vndbCharacterId":"c115948"},"originalCharacterName":"マクシミリアン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Although he is the manager of the theater, he tends to be absent due to his wanderlust, and it is a mystery whether he fulfills his role as manager."},{"spoiler":false,"text":"He is usually aloof, but he sometimes shows a chilling and cold side."},{"spoiler":false,"text":"He is kind to women, and seems to be particularly fond of the heroine."},{"spoiler":false,"text":"Translated from the official twtter"}],"source":"vndb","sourceCharacterId":"c115948"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdd7e012334beffae0e499deba78ea4cf5d2f55940ec85b80e277c34b9ea9bf3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4dcdd0f37b78fbc78e5f4994beafc3e2fcdae8563166b5a8d042c64b4444e044.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一夜愛","creatorId":"vndb:s8349","sourcePersonId":"vndb:s8349","canonicalEntityId":"vndb:s8349","name":"大下 孝太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92103","source":"vndb"}]},{"characterId":"char_vndb_c115949","characterName":"ヴァレリアス・マクロン","sourceIds":{"vndbCharacterId":"c115949"},"originalCharacterName":"ヴァレリアス・マクロン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"27"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Although he has a rough and troublesome personality, he is in fact a very caring and dependable big brother figure."},{"spoiler":false,"text":"He makes a living as a jack-of-all-trades, but he is always short of money due to his huge appetite."},{"spoiler":false,"text":"Contrary to his bombastic appearance, he plays the piano delicately and beautifully."},{"spoiler":false,"text":"Translated from the official twitter"}],"source":"vndb","sourceCharacterId":"c115949"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/040a6dd136a56016cd532b3f1d835cc7cfe8300764d29a3fc366483f7b759f70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76b5f2d1dca285cc53e4e03211cb12fd1d5c66baf6a9310ae85dde3ac998bbac.webp","width":184,"height":256,"source":"static-detail"},"actors":[{"creditedName":"八神 仙","creatorId":"vndb:s34034","sourcePersonId":"vndb:s34034","canonicalEntityId":"vndb:s34034","name":"八神仙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92104","source":"vndb"}]},{"characterId":"char_vndb_c115951","characterName":"マール・テリエ","sourceIds":{"vndbCharacterId":"c115951"},"originalCharacterName":"マール・テリエ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is gentle, kind-hearted, and a bit withdrawn at times, but when the time comes, he is able to speak his mind and express his opinions clearly."},{"spoiler":false,"text":"A sensible person among the eccentric theater members, he often helps to mediate disputes."},{"spoiler":false,"text":"He paints in monochrome with a distinct world view."},{"spoiler":false,"text":"Translated from the official twitter"}],"source":"vndb","sourceCharacterId":"c115951"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://