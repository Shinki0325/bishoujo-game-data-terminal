oiler":false,"text":"今だ二十代にも見える綺麗な女性で、テレビでも活躍する有名な女優さん。"},{"spoiler":false,"text":"しかし、演技以外のことは極めて無頓着でダメな人。 家事もまったく出来ない。"},{"spoiler":false,"text":"性格はいい加減でオヤジ的。 いつも美華に迷惑を掛けている。"},{"spoiler":false,"text":"「美華、私再婚する。 相手……？　あんたの恋人」"},{"spoiler":false,"text":"美华的母亲。"},{"spoiler":false,"text":"看起来还像是二十来岁的美丽的女性，在电视上大为活跃的有名女演员。"},{"spoiler":false,"text":"然而，是个对演技以外的事情都极其漠不关心的废人。家务也完全做不来。"},{"spoiler":false,"text":"性格也大叔得让人受不了。总是给美华添麻烦。"},{"spoiler":false,"text":"「美华，我要再婚。对象……？就你的恋人」"}],"source":"bangumi","sourceCharacterId":"38676"}],"profileFacts":[{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"38676","value":"火车便当（幕之内最高～！）"},{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"1471","sourceWorkId":"18869","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"1471","sourceWorkId":"18869","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"1471","sourceWorkId":"18869","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"1471","sourceWorkId":"18869","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"1471","sourceWorkId":"18869","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8bca80d56c133e5b3c0e217b05f3f0d61c48117d80a179f0c462b7e53b783d46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9313d3c3156486a9561c6dfbb595a4f2f7971574d9c8a252c251f5c4d3e239d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identitySta