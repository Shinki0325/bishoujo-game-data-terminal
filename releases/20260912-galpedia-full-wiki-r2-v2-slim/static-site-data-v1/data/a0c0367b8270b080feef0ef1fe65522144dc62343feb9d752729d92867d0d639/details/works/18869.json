":"c18826"},"originalCharacterName":"猫川 あめり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"920"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Favorite Food: chocolate sundae, fruit mousse pudding"},{"spoiler":false,"text":"Skills: inconspicuous, good memory"},{"spoiler":false,"text":"Has loved our protagonist ever since he saved her from being assaulted on a train."},{"spoiler":false,"text":"She’s always by his side, but no one ever seems to notice her. Of course, that includes our protagonist, as well..."}],"source":"vndb","sourceCharacterId":"c18826"},{"segments":[{"spoiler":false,"text":"上根子坂学園の生徒で、ぺるしゃの従妹。気弱な性格だが、痴漢に遭っていたところを主人公に助けられ、勇気を出して告白をした。クラスではあまり目立たない少女で、高也の近くにいても彼に気が付かれないことが多い。二重人格者で、別人格に切り替わると性格も容姿も変わってしまう。別人格と区別するために「黒ちゃん」と呼ばれている。"},{"spoiler":false,"text":"猫川 あめり（白）"},{"spoiler":false,"text":"あめりの別人格で、「白ちゃん」と呼ばれている。天才少女であり、数学や物理学に精通している。無遠慮な性格で毒舌をよく吐く。高也のことを嫌悪しており、黒ちゃんのことも敵対視している。"}],"source":"bangumi","sourceCharacterId":"38674"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"1468","sourceWorkId":"18869","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"1468","sourceWorkId":"18869","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"145 cm","valueContext":null,"source":"egs","sourceChara