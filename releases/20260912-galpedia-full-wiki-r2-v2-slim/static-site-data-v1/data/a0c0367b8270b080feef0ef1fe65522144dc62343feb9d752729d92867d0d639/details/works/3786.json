749","match":"exact-normalized-name-in-linked-work","subjectId":"229571"},{"characterId":"94749","match":"exact-normalized-name-in-linked-work","subjectId":"229572"},{"characterId":"94749","match":"exact-normalized-name-in-linked-work","subjectId":"229573"}],"egsCharacterIds":["13923","13927"],"vndbCharacterId":"c10166"},"originalCharacterName":"レイア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main heroine of the first game. Her name was never mentioned in the first game, she was simply referred to as Valkyrie. She was captured by Duke."},{"spoiler":false,"text":"In the second game her name is revealed to be Leia."}],"source":"vndb","sourceCharacterId":"c10166"},{"segments":[{"spoiler":false,"text":"大神から命じられ人間たちを守り、戦場を駆ける戦乙女。"},{"spoiler":false,"text":"しかし、自ら人間を守ることが自分に課せられた使命であると信じている。"},{"spoiler":false,"text":"その凛々しい顔付きからややキツイ印象を与えるが、人当たりが良く、誰とでもすぐに打ち解けられる温厚な性格。"},{"spoiler":false,"text":"ひとたび戦場に出れば、鬼神の如き活躍を見せ、人間に害する悪を容赦なく叩きのめす。"},{"spoiler":false,"text":"神々の力が封じ込められた「黄金の指輪」の加護がなくなると、彼女本来の力が失われる。"},{"spoiler":false,"text":"天空の戦士たちを統率する軍師・フレイアを尊敬し、憧れの念を抱いている。"}],"source":"egs","sourceCharacterId":"13923","sourceWorkId":"3786","spoiler":false},{"segments":[{"spoiler":false,"text":"人間界を守るべく降臨した「日輪の戦乙女」で、前作のヒロイン。"},{"spoiler":false,"text":"慈愛と優しさに満ちた性格だが、敵に対しては容赦しない。"},{"spoiler":false,"text":"しかし、人質をとられるなどの手段にはめっぽう弱く、"},{"spoiler":false,"text":"そこを突かれて、デュークに捕らわれてしまった。"},{"spoiler":false,"text":"度重なる凌辱調教で、清らかだった肉体は開発され尽くしてしまったが、"},{"spoiler":false,"text":"心は堕ちる寸前で抵抗を続けている。"},{"spoiler":false,"text":"だが、デュークの興味が新たな戦乙女に移ると……？"}],"source":"egs","sourceCharacterId":"13927","sourceWorkId":"10459","spoiler":false},{"segments":[{"spoiler":false,"text":"蒼穹の戦乙女レイアはラグナロクでデュークに別れを告げたものの、"},{"spoiler":false,"text":"彼のことが忘れられずに帰ってきてしまう。"},{"spoiler":false,"text":"名目上は「ミッドガルドの治安を守る」ということだが……。"},{"spoiler":false,"text":"嫉妬するとブラックヴァルキリーに変身。"},{"spoiler":false,"text":"デュークを独り占めしようとする。"}],"source":"egs","sourceCharacterId":"13927","sourceWorkId":"11296","spoiler":false},{"segments":[{"spoiler":false,"text":"人当たりが良く温厚で誰とでもすぐにうち解けます。性格も非常によいです。"},{"spoiler":false,"text":"しかし、ひとたび戦場に出ると容赦なく人間を害する悪を打ちのめします。"},{"spoiler":false,"text":"人々を守るためなら何でもするという信念があります。また、この信念を通すためならどんなことでもします。"},{"spoiler":false,"text":"ヴァルキリーは大神の命令で人間を守っていますが、自身も人々を助けるのが自分に課せられた生涯の勤めだと信じています。"},{"spoiler":false,"text":"人々にはヴァルキリー様、戦争乙女、盾の乙女(スカルメール）などとも呼ばれています。"},{"spoiler":false,"text":"いつも慎ましく清楚で優しいフレイアに、尊敬し憧れの念を抱いています。"},{"spoiler":false,"text":"ヴァルキリーが本来の力を発揮するには、神々の力を封じ込めた黄金の指輪が必要です。"}],"source":"bangumi","sourceCharacterId":"94749"}],"profileFacts":[{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"13923","sourceWorkId":"3786","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"54 kg","valueContext":null,"source":"egs","sourceCharacterId":"13923","sourceWorkId":"3786","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d827901143f864b7ab67fba068502d2811d681d9452c36ce1228947561df929d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3f0228e7a89768919e90a2bc92deb2871f0c831e41be723dc1cab792c42806f.webp","width":129,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229571:94749:6036:1","source":"bangumi"}]},{"characterId":"char_c30001","characterName":"フレイア","sourceIds":{"bangumi":[{"characterId":"94750","match":"exact-normalized-name-in-linked-work","subjectId":"229571"},{"characterId":"94750","match":"exact-normalized-name-in-linked-work","subjectId":"229573"}],"egsCharacterIds":["13924"],"vndbCharacterId":"c30001"},"originalCharacterName":"フレイア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"177cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"58Kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔王に調教され、主人公の肉奴兼秘書に貶められた、天空の戦士たちを統率する元軍師。"},{"spoiler":false,"text":"ヴァルキリーの憧れの存在。"},{"spoiler":false,"text":"頭の切れる知的なお姉さん。性格は優しく物静かで温厚だが、規律や躾に厳しい。"},{"spoiler":false,"text":"そんな彼女は魔王に堕とされてからは、その知識や才能を快楽を得るために使うようになり、ヴァルキリーに対しても自分と同じように快楽を味わって欲しいと願うように……。"}],"source":"egs","sourceCharacterId":"13924","sourceWorkId":"3786","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公によって調教、籠絡され、"},{"spoiler":false,"text":"完全な性奴隷へと堕ちた前作のヒロインたち。"},{"spoiler":false,"text":"以前の面影はどこにもなく、ただひたすら快楽を求め、"},{"spoiler":false,"text":"まぐわい続けている。"}],"source":"egs","sourceCharacterId":"13924","sourceWorkId":"10459","spoiler":false},{"segments":[{"spoiler":false,"text":"ヴァルキリーを含む、天空の戦士達を統率していた軍師ですが、魔王に調教されてしまい、"},{"spoiler":false,"text":"現在は主人公の肉奴隷兼秘書として生活を送っています。"},{"spoiler":false,"text":"ヴァルキリーのお姉さん的存在ですが、調教後のフレイアはヴァルキリーにも"},{"spoiler":false,"text":"自分と同じような快楽を早く味わってもらいたいと思っています。"},{"spoiler":false,"text":"知的で非常に頭が切れ躾に厳しいお姉さんです。基本的には物静かですが、悪いことは誰であろうと注意をします。"},{"spoiler":false,"text":"フレイアの厳しさの裏には常に優しさがあります。"},{"spoiler":false,"text":"しかし、調教されてしまったフレイアは、快楽を得るためにその知識や才能を使います。"},{"spoiler":false,"text":"特にエッチシーンでは、自身を蔑み豹変したようにエッチに没頭します。"}],"source":"bangumi","sourceCharacterId":"94750"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98e2a89d4323134b4473f8d42bc4df76e8818c6d2ee776e2035cf880d122497c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4ed29f0f5b31ca99451be3abcf0c9c3ee831b38bc33312f5fa69da351d59d5c5.webp","width":129,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229571:94750:4675:1","source":"bangumi"}]},{"characterId":"char_c30002","characterName":"スクルド","sourceIds":{"bangumi":[{"characterId":"94751","match":"exact-normalized-name-in-linked-work","subjectId":"229571"},{"characterId":"94751","match":"exact-normalized-name-in-linked-work","subjectId":"229572"},{"characterId":"94751","match":"exact-normalized-name-in-linked-work","subjectId":"229573"}],"egsCharacterIds":["13925"],"vndbCharacterId":"c30002"},"originalCharacterName":"スクルド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"150cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"42Kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヴァルキリーを慕い、憧れる後輩の見習い女神。"},{"spoiler":false,"text":"跳ねっ返りで気が強く、意地っ張りな元気娘。"},{"spoiler":false,"text":"しかし、ヴァルキリーやフレイアなど、気を許した相手に対しては素直さを見せる。"},{"spoiler":false,"text":"男が嫌いだが、それよりも悪が許せず、悪の権化であると信じている悪魔を根絶やしにしたいと思っている。"},{"spoiler":false,"text":"まだまだ肉体的にも、精神的にも幼い。"}],"source":"egs","sourceCharacterId":"13925","sourceWorkId":"3786","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公によって調教、籠絡され、"},{"spoiler":false,"text":"完全な性奴隷へと堕ちた前作のヒロインたち。"},{"spoiler":false,"text":"以前の面影はどこにもなく、ただひたすら快楽を求め、"},{"spoiler":false,"text":"まぐわい続けている。"}],"source":"egs","sourceCharacterId":"13925","sourceWorkId":"10459","spoiler":false},{"segments":[{"spoiler":false,"text":"見習いの戦乙女で、レイアを助けにデュークの命を狙ったのも今は昔。"},{"spoiler":false,"text":"すっかり、みんなから空気扱いされていじめられる姿が板に付いてしまった。"},{"spoiler":false,"text":"仕返しに姿を消す薬を飲んで悪戯しまくり、ストレス解消していたが……。"}],"source":"egs","sourceCharacterId":"13925","sourceWorkId":"11296","spoiler":false},{"segments":[{"spoiler":false,"text":"ヴァルキリーに憧れている少女で、自分もいつかはヴァルキリーのようになりたいと思っています。今は見習いの女神です。"},{"spoiler":false,"text":"スクルドは男と悪魔が大嫌いで、ヴァルキリーのことを心の底から愛しています。"},{"spoiler":false,"text":"基本的には気が強く意地っ張りの元気っ娘です。"},{"spoiler":false,"text":"しかし、ヴァルキリーやフレイア等、気を許した相手には素直でよい子です。"},{"spoiler":false,"text":"男が嫌いですが、それよりも悪魔自体が大嫌いです。"},{"spoiler":false,"text":"絶対正義の精神を持っているため、悪魔を根絶やしにしようと思っています。"}],"source":"bangumi","sourceCharacterId":"94751"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c188583461a8e1ed7eb9cbffefa7ea0f13ff603322915d557324cd4b2a21d7f7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0cf298fbae04eaf1b573cfdbcc0b39c2f7fad58609915d1fd6c729bf36fe0e66.webp","width":150,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本井えみ","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229571:94751:4177:1","source":"bangumi"}]},{"characterId":"char_c30004","characterName":"フェンリル","sourceIds":{"bangumi":[{"characterId":"94752","match":"exact-normalized-name-in-linked-work","subjectId":"229571"},{"characterId":"94752","match":"exact-normalized-name-in-linked-work","subjectId":"229572"},{"characterId":"94752","match":"exact-normalized-name-in-linked-work","subjectId":"229573"}],"egsCharacterIds":["13926"],"vndbCharacterId":"c30004"},"originalCharacterName":"フェンリル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"170cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"54Kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔族のみで構成された「魔法騎士団」の団長。主人公のお目付け役。"},{"spoiler":false,"text":"主人公とも地位は変わらないが、人間と魔族のハーフである主人公と違い、純血の魔族で、由緒ある血統を持つ魔族のエリート。"},{"spoiler":false,"text":"性格は気が強く、高慢だが、それは自身の弱さを隠すための虚勢でしかなく、またその身分の高さから、なかなか素直になれない。"},{"spoiler":false,"text":"胸が大きく、挑発的なスタイルをしているが、そうした見た目に反して貞操観念が強い。"},{"spoiler":false,"text":"ハーフで身分の低い主人公を小馬鹿にしているが、密かに好意を抱いている。"}],"source":"egs","sourceCharacterId":"13926","sourceWorkId":"3786","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公によって調教、籠絡され、"},{"spoiler":false,"text":"完全な性奴隷へと堕ちた前作のヒロインたち。"},{"spoiler":false,"text":"以前の面影はどこにもなく、ただひたすら快楽を求め、"},{"spoiler":false,"text":"まぐわい続けている。"}],"source":"egs","sourceCharacterId":"13926","sourceWorkId":"10459","spoiler":false},{"segments":[{"spoiler":false,"text":"元々デュークのお目付け役として魔界の上層部から送り込まれた魔族のエリート。"},{"spoiler":false,"text":"今ではデュークにすっかり心を奪われてしまった。"},{"spoiler":false,"text":"身体は完全に雌奴隷に堕ちきっているものの、態度は素直じゃないまま。"},{"spoiler":false,"text":"疲れて自室に帰ってきたデュークを、かいがいしく世話するのだが……。"}],"source":"egs","sourceCharacterId":"13926","sourceWorkId":"11296","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法と剣を同時に支える完全な魔族のみで構成された『魔法騎士団』の団長です。"},{"spoiler":false,"text":"地位は主人公と同じですが『エリート集団のトップ』で、さらに由緒ある血統なため、"},{"spoiler":false,"text":"魔界内においては比較にならないほどの身分差があります。"},{"spoiler":false,"text":"完全な魔族であるフェンリルは、人間の血が流れている主人公のことをいつも小馬鹿にしています。"},{"spoiler":false,"text":"魔王が任命した主人公のお目付役で、常に主人公を監視しています。"},{"spoiler":false,"text":"見た目よりも貞操観念が強く、一度主人公とエッチするとヴァルキリーにかなり強い嫉妬を抱いたりします。"},{"spoiler":false,"text":"気が強く高慢ですが、それは寂しさや自身の弱さを隠すために虚勢を張っているだけです。"},{"spoiler":false,"text":"気高いので心を許した相手でも素直になることが出来ません。"}],"source":"bangumi","sourceCharacterId":"94752"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb08edb6485355a28c35a1c9d7722b1e4b7e0fc1dea96467a176633c28b3ef03.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f26c13f12cd1594fa7accdd43e89de14884d51bf7620a5c950064d09396203ab.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あらいしずか","creatorId":"vndb:s665","sourcePersonId":"vndb:s665","canonicalEntityId":"vndb:s665","name":"あらい しずか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229571:94752:4647:1","source":"bangumi"}]},{"characterId":"char_vndb_c127559","characterName":"デューク","sourceIds":{"vndbCharacterId":"c127559"},"originalCharacterName":"デューク","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/273b5a549052f09dbb254ffcc4a810e490c094d9219aac05ba143b608716fb1a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5fd627b99dc919f21a4adf655bc5fbf2ebbefdc5de769274541e68d936cce0c.webp","width":173,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p490","sourceCompanyId":"egs:brand:328","canonicalEntityId":"vndb:p490","name":"ルネ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:3786:328","source":"egs"},{"companyId":"vndb:p490","sourceCompanyId":"vndb:p490","canonicalEntityId":"vndb:p490","name":"ルネ","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:141071:v1084","source":"vndb"},{"companyId":"vndb:p490","sourceCompanyId":"vndb:p490","canonicalEntityId":"vndb:p490","name":"ルネ","roleCodes":["developer","publisher"],"identityStatus":"sour