 anxious about relationship with her."}],"source":"vndb","sourceCharacterId":"c82531"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p4248","sourceCompanyId":"egs:brand:4213","canonicalEntityId":"vndb:p4248","name":"ぱちぱちそふと","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:27794:4213","source":"egs"},{"companyId":"vndb:p15756","sourceCompanyId":"vndb:p15756","canonicalEntityId":"vndb:p15756","name":"SVN","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:131816:v25707","source":"vndb"},{"companyId":"vndb:p4248","sourceCompanyId":"vndb:p4248","canonicalEntityId":"vndb:p4248","name":"ぱちぱちそふと","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:71571:v25707","source":"vndb"},{"companyId":"vndb:p4248","sourceCompanyId":"vndb:p4248","canonicalEntityId":"vndb:p4248","name":"ぱちぱちそふと","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:71572:v25707","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
