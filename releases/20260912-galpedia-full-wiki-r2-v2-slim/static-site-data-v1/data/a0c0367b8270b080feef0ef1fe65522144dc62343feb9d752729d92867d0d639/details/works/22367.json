ce":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The leader and brains who manages the group of delinquents."},{"spoiler":false,"text":"This red-haired young man is the leader of the Bad Apples. Taciturn and poker-faced, it is hard to to know what he's thinking. Because of that, most people in their first meeting tend to think of him as a scary person. But he is a person with a strong purpose and charisma, which makes all the members trust deeply in him."},{"spoiler":false,"text":"From Otome Jikan"},{"spoiler":true,"text":"His real name is Fudoh Alma."}],"source":"vndb","sourceCharacterId":"c40064"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87db3f28884ceda0fb78dd2b35fd9452d3d06e3a44c7cb81140949b025b5800c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbed3204bf533f83e1898226db234459dad57ebc17764dc8921e065caa9d3562.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井 孝宏","creatorId":"vndb:s50","sourcePersonId":"vndb:s50","canonicalEntityId":"vndb:s50","name":"櫻井 孝宏","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64016","source":"vndb"}]},{"characterId":"char_vndb_c40065","characterName":"ヒガ","sourceIds":{"vndbCharacterId":"c40065"},"originalCharacterName":"ヒガ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A large and strait-laced man who acts as Alma's right-hand."},{"spoiler":false,"text":"This large young man wears a white tokkofuku. He has the appearance of being a bad boy in the olden days and even his speech is rough, but his current behavior is because he arrived at this school. It looks like while he was alive he used to be the complete opposite...!? He looks brusque and mean, but he's a kind person."},{"spoiler":false,"text":"From Otome Jikan"},{"spoiler":true,"text":"His real name is Higa Katsumi."}],"source":"vndb","sourceCharacterId":"c40065"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f0a4a191257da3b0b36ec3989fb1563580fe6cc568c9355a244ab3e8efbb0f7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13399d66b550e0bb97d28bd8261069fb8c215e1c80776331c8bc2ce8148073b7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"諏訪部 順一","creatorId":"vndb:s66","sourcePersonId":"vndb:s66","canonicalEntityId":"vndb:s66","name":"諏訪部 順一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64019","source":"vndb"}]},{"characterId":"char_vndb_c40066","characterName":"シキシマ","sourceIds":{"vndbCharacterId":"c40066"},"originalCharacterName":"シキシマ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The elusive my-pace artist."},{"spoiler":false,"text":"He is neither a delinquent nor a good student. Everyone recognizes this person as an eccentric man and, just like that nickname, his movements are also considerably strange. He appears and disappears everywhere around school, always alone and quietly drawing."},{"spoiler":false,"text":"From Otome Jikan"},{"spoiler":true,"text":"His full name is Shikishima Natsuhisa (四季島 夏久). He dies at the age of seventeen."}],"source":"vndb","sourceCharacterId":"c40066"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d7093ac648d20e95d206f1a9d5