{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"10961","model":{"presentationWorkId":"vndb:v4879","staff":{"artwork":[{"creditedName":"沖史慈宴","creatorId":"vndb:s39320","sourcePersonId":"egs:creator:13632","canonicalEntityId":"vndb:s39320","name":"沖史慈宴","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:75245","source":"egs"},{"creditedName":"アイゼン伯爵","creatorId":"vndb:s20106","sourcePersonId":"vndb:s20106","canonicalEntityId":"vndb:s20106","name":"アイゼン伯爵","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:53732","source":"vndb"}],"scenario":[{"creditedName":"騎西ソアラ","creatorId":"vndb:s5114","sourcePersonId":"egs:creator:2251","canonicalEntityId":"vndb:s5114","name":"騎西ソアラ","detail":"共通、プラティーナ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:75246","source":"egs"},{"creditedName":"神堂劾(九十九神一)","creatorId":"vndb:s1280","sourcePersonId":"egs:creator:2054","canonicalEntityId":"vndb:s1280","name":"神堂劾(九十九神一)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:75247","source":"egs"}],"music":[{"creditedName":"Lip on Hip","creatorId":"vndb:s1083","sourcePersonId":"egs:creator:2553","canonicalEntityId":"vndb:s1083","name":"Lip on Hip","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:88851","source":"egs"}],"other":[{"creditedName":"騎西ソアラ","creatorId":"vndb:s5114","sourcePersonId":"egs:creator:2251","canonicalEntityId":"vndb:s5114","name":"騎西ソアラ","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:134458","source":"egs"},{"creditedName":"神堂 劾","creatorId":"vndb:s1280","sourcePersonId":"vndb:s1280","canonicalEntityId":"vndb:s1280","name":"神堂 劾","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:53735","source":"vndb"},{"creditedName":"騎西 ソアラ","creatorId":"vndb:s5114","sourcePersonId":"vndb:s5114","canonicalEntityId":"vndb:s5114","name":"騎西 ソアラ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:53737","source":"vndb"},{"creditedName":"沖史慈 宴","creatorId":"vndb:s39320","sourcePersonId":"vndb:s39320","canonicalEntityId":"vndb:s39320","name":"沖史慈 宴","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:53738","source":"vndb"},{"creditedName":"沖史慈 宴","creatorId":"vndb:s39320","sourcePersonId":"vndb:s39320","canonicalEntityId":"vndb:s39320","name":"沖史慈 宴","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:53740","source":"vndb"}]},"cast":[{"characterId":"char_c57516","characterName":"ラキュハリス・ルチル","sourceIds":{"bangumi":[{"characterId":"12690","match":"exact-normalized-name-in-linked-work","subjectId":"14401"}],"egsCharacterIds":["17358"],"vndbCharacterId":"c57516"},"originalCharacterName":"ラキュハリス・ルチル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の妹でおにいちゃん子。魔法属性は風。"},{"spoiler":false,"text":"底抜けに明るい性格。（何も考えていないという話も）"},{"spoiler":false,"text":"お兄ちゃんと一緒にいたいからという理由で学院に入学するも、"},{"spoiler":false,"text":"そのずば抜けた魔力ゆえ、飛び級して最上級クラス（トレース）に所属。"},{"spoiler":false,"text":"その上、何の気無しに読んだ文字が、"},{"spoiler":false,"text":"実は現在では失われた知識である古代文字だったりと、"},{"spoiler":false,"text":"秘めた才能の高さを散見させる。"},{"spoiler":false,"text":"今回数十年ぶりに使い魔の卵が誕生したことを受けて、"},{"spoiler":false,"text":"エレメンタルリンカー候補生となるが、"},{"spoiler":false,"text":"その高すぎる能力と相反する外見＆性格のギャップゆえ、彼女を妬む者も多い。"}],"source":"egs","sourceCharacterId":"17358","sourceWorkId":"10961","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的妹妹，兄控。魔法属性为风。"},{"spoiler":false,"text":"无限开朗的性格（也被说成是什么都没想）。"},{"spoiler":false,"text":"为了和哥哥在一起而入学学院，凭着那无限的魔力而跳级进入最高级班トレース。"},{"spoiler":false,"text":"此外，无意中读出的文字实际上是现在已失传的古代文字，隐藏的才能之高可见一斑。"},{"spoiler":false,"text":"凭着极高的潜在能力，成为了エレメンタルリンカー(elemental link)（能使用使魔的魔女）候补生，由于过于出众的能力和她外表＆性格的反差，嫉妒她的人也很多。"}],"source":"bangumi","sourceCharacterId":"12690"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/120b081d46f677fa108a2eab23bad3b1a186a2061acc92b5753049b5003be643.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5e2dd8c9f719747e208eb9d820f0085d68eb7abea506ef4cbe3038db24f3769.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14401:12690:6016:1","source":"bangumi"}]},{"characterId":"char_vndb_c57517","characterName":"蓮華石 ニナ","sourceIds":{"vndbCharacterId":"c57517"},"originalCharacterName":"蓮華石 ニナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4fe9f75a4bed67e7baaa3ebe1bdf2b6cd7f10e5ab306b676588c7fc90655a56.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9e1e7014ef5a7e93229a068b443fd3aa3903a4a70a7f313c46a334f6f069ccf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮沢 ゆあな","creatorId":"vndb:s830","sourcePersonId":"vndb:s830","canonicalEntityId":"vndb:s830","name":"宮沢ゆあな","roleCode":"voice-actor"