{"spoiler":false,"text":"小さい頃に迷い込んだ神社の裏手で裕治に助け出された時から、暗い所が苦手になった。"}],"source":"egs","sourceCharacterId":"12664","sourceWorkId":"13609","spoiler":false},{"segments":[{"spoiler":false,"text":"会照顾人好管事的青梅竹马。"},{"spoiler":false,"text":"唯独对裕治是照顾着他但又采取冷淡的态度，似乎是有什么理由的。"},{"spoiler":false,"text":"对她的爱称「ひめ」从名字中的取出来的。"},{"spoiler":false,"text":"自从小时候迷失在神社后院被裕治救出来后就变得怕暗的地方了。"}],"source":"bangumi","sourceCharacterId":"78996"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"12664","sourceWorkId":"13609","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"12664","sourceWorkId":"13609","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"12664","sourceWorkId":"13609","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"12664","sourceWorkId":"13609","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"47 kg","valueContext":null,"source":"egs","sourceCharacterId":"12664","sourceWorkId":"13609","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb8d61bde0bd1c59d061f4f2131195a258ae173615cd9192d5192dec79e2a460.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8396fdbf26eed0acc93b9a32c7476372723c9c7d891f338cba7fdd22314b573a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"愛川すず","creatorId":"vndb:s25984","sourcePersonId":"vndb:s25984","canonicalEntityId":"vndb:s25984","name":"愛川すず","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:25474","source":"vndb"}]},{"characterId":"char_c18566","characterName":"桐崎 理英","sourceIds":{"bangumi":[{"characterId":"78992","match":"exact-no