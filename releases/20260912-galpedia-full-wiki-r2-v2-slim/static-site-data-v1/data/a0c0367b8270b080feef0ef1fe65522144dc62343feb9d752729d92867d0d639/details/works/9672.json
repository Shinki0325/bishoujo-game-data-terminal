iler":false,"text":"処女。"}],"source":"bangumi","sourceCharacterId":"199591"}],"profileFacts":[{"label":"年龄（本版本）","value":"22 岁","valueContext":null,"source":"egs","sourceCharacterId":"19479","sourceWorkId":"9672","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11e321fb9817631cd557dd7785e9b1d2188d204ffa07bac1a306ff04a6f18cd4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed284b65e3afaeac4a1d022bd3a9363d1662bfd3ce7b8f7ada230681049deeaf.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安倍ようこ","creatorId":"vndb:s1369","sourcePersonId":"vndb:s1369","canonicalEntityId":"vndb:s1369","name":"安倍 ようこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224162:199591:24814:1","source":"bangumi"}]},{"characterId":"char_c70296","characterName":"足利 巴琉","sourceIds":{"bangumi":[{"characterId":"199592","match":"exact-normalized-name-in-linked-work","subjectId":"224162"}],"egsCharacterIds":["19480"],"vndbCharacterId":"c70296"},"originalCharacterName":"足利 巴琉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"26"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has been a newscaster for three years and is Rikako's senior. She is affectionately called “Haru-chan” by everyone."},{"spoiler":false,"text":"She has a harsh personality and mannerisms, and can be strict with everyone, however, once she opens her heart to someone, she becomes obedient."},{"spoiler":false,"text":"She sometimes gets aroused during filming and her body lights up. She masturbates in an empty studio to get rid of it. She is not a virgin."},{"spoiler":false,"tex