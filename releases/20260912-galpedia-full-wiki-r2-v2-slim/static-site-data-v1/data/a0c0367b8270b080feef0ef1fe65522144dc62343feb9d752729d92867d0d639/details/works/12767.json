:false,"text":"主人公と幼なじみの少女。 自称・妹後輩。"},{"spoiler":false,"text":"なぜか同級生である川内野優美に並々ならぬ愛情を注がれている。"},{"spoiler":false,"text":"彼女自身は百合でもなければレズでもない。 ただ少し残念なだけの弓張学園新入生。"},{"spoiler":false,"text":"美術部所属。"},{"spoiler":false,"text":"原画：狗神煌"}],"source":"bangumi","sourceCharacterId":"31321"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de73aa50f0dba29e26367fdda5f08b1655142619580ede8901d4f82afa368cfc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/361d9d07f0b657a4e501335d289e19ee1e27e52fe547459a983503d2cfa68b9d.webp","width":133,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c27450","characterName":"小日向 はやみ","sourceIds":{"vndbCharacterId":"c27450"},"originalCharacterName":"小日向 はやみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1225"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"75"},"height":{"reviewState":"source-only","source":"vndb","value":"146"},"hip":{"reviewState":"source-only","source":"vndb","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hayami is a girl in Takuma's class who sits next to him. She has an unsociable personality and a sharp attitude towards others, not wanting to become friends with others, due to her accepting her own status as an outcast."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c27450"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d179392aec5dd9d028a369554b737a1960cfc