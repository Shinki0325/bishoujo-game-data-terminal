{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"25951","model":{"presentationWorkId":"egs:25951","staff":{"artwork":[],"scenario":[{"creditedName":"枯野瑛","creatorId":"vndb:s11216","sourcePersonId":"egs:creator:5158","canonicalEntityId":"vndb:s11216","name":"枯野瑛","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:192593","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_188868","characterName":"キヨラ","sourceIds":{"bangumi":[{"characterId":"188868","match":"source-roster","subjectId":"1414"}]},"originalCharacterName":"キヨラ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"闇の魔物たちに一族、国を滅ぼされ、一人生き残った「伽羅紗（からしゃ）の国」の姫君。憎き闇の魔物への復讐を誓い、臣下の残党と共に戦いの日々へと身を投じる。細腕ならも刀や太刀、弓を使いこなし、強力な必殺技等によっていかなる局面でも将として大いに活躍することができる。"}],"source":"bangumi","sourceCharacterId":"188868"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6ca89d65a0021f0abf2c742e07f0cfb6d82d09dea5263d2c04981db2c5205af.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb6270328e01e10c56b783a345eca7b7f2b85dd15d77d53df564b0f75fe34d6a.webp","width":149,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小清水亜美","creatorId":"vndb:s622","sourcePersonId":"vndb:s622","canonicalEntityId":"vndb:s622","name":"小清水 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1414:188868:4474:1","source":"bangumi"}]},{"characterId":"char_bangumi_188869","characterName":"シャマナ","sourceIds":{"bangumi":[{"characterId":"188869","match":"source-roster","subjectId":"1414"}]},"originalCharacterName":"シャマナ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人知れず森に暮らし、数々の秘術を伝えてきた「魔女」たちの一人。使い魔として、森にすむ妖精を連れている。幼いながらも強力な魔力を持ち、多くの攻撃魔法を扱うことができる、魔法戦の要となるユニット。"}],"source":"bangumi","sourceCharacterId":"188869"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e9ee398be106fa13ce58a8e1065fa6123f6cd8b7395b8245483983aeefe72c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb5a13860a31a532199f3feb6cd35972acd7b557c5a084a0a9fa0f78ada26580.webp","width":244,"height":256,"source":"static-detail"},"actors":[{"creditedName":"斎藤千和","creatorId":"vndb:s475","sourcePersonId":"vndb:s475","canonicalEntityId":"vndb:s475","name":"斎藤千和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1414:188869:4249:1","source":"bangumi"}]},{"characterId":"char_bangumi_188870","characterName":"マノフィカ","sourceIds":{"bangumi":[{"characterId":"188870","match":"source-roster","subjectId":"1414"}]},"originalCharacterName":"マノフィカ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"かつて砂漠に栄えた大国「陽炎の都シストラム」の美しき女王。世を救うため、終末に復活を約束されていた。途方もなく永い眠りのせいか、時々不思議な発言をする。強力な攻撃と癒し、支援の力を自在に使いこなす、オールマイティな魔法ユニットとして活躍できる。"}],"source":"bangumi","sourceCharacterId":"188870"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4f04f2889f9eb40a92bc6163ba104201627866363e2f23ebddc6db8a1169e1d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f6ccea2e33e1033fa6bec224df671ae6ff73a685d5623163db18d2bf053fab7.webp","width":135,"height":256,"source":"static-detail"},"actors":[{"creditedName":"能登麻美子","creatorId":"vndb:s468","sourcePersonId":"vndb:s468","canonicalEntityId":"vndb:s468","name":"能登麻美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1414:188870:3827:1","source":"bangumi"}]},{"characterId":"char_bangumi_188871","characterName":"ヴィラン","sourceIds":{"bangumi":[{"characterId":"188871","match":"source-roster","subjectId":"1414"}]},"originalCharacterName":"ヴィラン","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"金色の狼に変身する能力を持ち、神を忌み嫌うような発言を繰り返す男。しかし、その身には神の力を受けた証である「聖痕」が刻まれているなど、謎が多い。力で屈服させた（らしい）闇の魔物を引き連れており、その生命力を吸収する事で無尽の体力を持つ狂戦士として大暴れすることができる。"}],"source":"bangumi","sourceCharacterId":"188871"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3aa13e9bfc03000a935d264fac3692e2dff2efaf42553f0b625e540275ed11ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8b466e1b87f53b8815815f89bfca2695cf2a406567b7727fc338419992c5f10.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"乃村健次","creatorId":"vndb:s679","sourcePersonId":"vndb:s679","canonicalEntityId":"vndb:s679","name":"乃村 健次","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1414:188871:4443:1","source":"bangumi"}]},{"characterId":"char_bangumi_188872","characterName":"テンガイ","sourceIds":{"bangumi":[{"characterId":"188872","match":"source-roster","subjectId":"1414"}]},"originalCharacterName":"テンガイ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"伽羅紗の隠れ里に暮らす特殊戦闘のエキスパート「忍者」の軍を統べる男。攻撃する距離や範囲によって扱い方が変化する、鎖鎌による攻撃が非常に強力。刀も扱える。また、敵を不利な状況に陥れる忍術や、トリッキーな技の数々により、主に前～中衛で安定した強さを発揮できる。"}],"source":"bangumi","sourceCharacterId":"188872"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a10945e7ac040ade90d32bc78da14a5ef0d6a1190ddf68be85b7d3deb0f82e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/9758bcb8ca381339bb3ebf6b32ffc7b0034f6e10a92a52174022c07a1e656e6f.webp","width":178,"height":256,"source":"static-detail"},"actors":[{"creditedName":"掛川裕彦","creatorId":"vndb:s5088","sourcePersonId":"vndb:s5088","canonicalEntityId":"vndb:s5088","name":"掛川 裕彦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1414:188872:4294:1","source":"bangumi"}]},{"characterId":"char_bangumi_188873","characterName":"アレクシード","sourceIds":{"bangumi":[{"characterId":"188873","match":"source-roster","subjectId":"1414"}]},"originalCharacterName":"アレクシード","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「神よ! 私に大切なものを護るための力を!」"},{"spoiler":false,"text":"闇との戦いで父を亡くし、若くして騎士団領・オージェンの君主となった青年。神の導きにより、世界に光の未来を取り戻すべく騎士団とともに闇との戦いに身を投じる。実直な性格で、若いながらも臣下からの信頼は厚い。"},{"spoiler":false,"text":"剣と槍、盾を自在に使いこなし、前線で兵を率いての大活躍が期待できる。"}],"source":"bangumi","sourceCharacterId":"188873"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57a841631703028252f9305d50fcebd5efe799337d83bc75bd683189f2fd0ebc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c8075524a4c0f89d68897215eb881d27116d0eeb7e4cae8972253bc449834af.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近藤隆","creatorId":"vndb:s72","sourcePersonId":"vndb:s72","canonicalEntityId":"vndb:s72","name":"近藤 隆","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1414:188873:4265:1","source":"bangumi"}]},{"characterId":"char_bangumi_188874","characterName":"ミルヒレーテ","sourceIds":{"bangumi":[{"characterId":"188874","match":"source-roster","subjectId":"1414"}]},"originalCharacterName":"ミルヒレーテ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「この暖かき光が、永遠のものでありますように……」"},{"spoiler":false,"text":"騎士団領の古き神殿にて神に仕える司祭で、幼い頃に聖痕を授かっている。お告げにあった“灯火の勇者”を待ち望んでいる。"},{"spoiler":false,"text":"回復役の要として、戦いでは重要な役割を担う。成長の仕方によっては武器を振り回す事も……"}],"source":"bangumi","sourceCharacterId":"188874"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/8263b6c5867e972f21ace906e1d354680a1b49e99f440eabd15c5c1148ddd288.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e3738730580db4118d7a5d685bafd38e00b4704b072f21db590032fa4d5e109.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤利奈","creatorId":"vndb:s360","sourcePersonId":"vndb:s360","canonicalEntityId":"vndb:s360","name":"佐藤 利奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1414:188874:4670:1","source":"bangumi"}]},{"characterId":"char_bangumi_188875","characterName":"セルピナ","sourceIds":{"bangumi":[{"characterId":"188875","match":"source-roster","subjectId":"1414"}]},"originalCharacterName":"セルピナ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「百年の間、この日を待っていました」"},{"spoiler":false,"text":"「微睡みの森」にて隠遁生活を送る、最も歴史の古い「エルフ族」の女性で、「白の賢者」と呼ばれている。"},{"spoiler":false,"text":"強力な魔力を持ち、多くの攻撃魔法を扱うことができる、魔法戦の要となるユニット"}],"source":"bangumi","sourceCharacterId":"188875"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/224f8d3a7f87ad66205952a829442a3f6a4b06f8cc8073aed8489ebfb96bc8e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f3a9d4d2bb0addb202df743d5eed850c24c37fcb92cf6f3f29a7989f8137ed4.webp","width":119,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中理恵","creatorId":"vndb:s1665","sourcePersonId":"vndb:s1665","canonicalEntityId":"vndb:s1665","name":"田中理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1414:188875:3862:1","source":"bangumi"}]},{"characterId":"char_bangumi_188876","characterName":"ラムシン","sourceIds":{"bangumi":[{"characterId":"188876","match":"source-roster","subjectId":"1414"}]},"originalCharacterName":"ラムシン","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「これが、巫撃道士の力だ!」"},{"spoiler":false,"text":"「燎の国」に伝わる、秘術を用いて闇のものへと裁きを行なう「巫撃道士」の最後の生き残り。"},{"spoiler":false,"text":"剣、手裏剣による攻撃や技、符術による魔法攻撃など、育て方や戦い方によって多彩な活躍が可能。"}],"source":"bangumi","sourceCharacterId":"188876"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/7056be75e5613aef670aaca28e4f1556c21cb8d9875870655918eb180b4c8bdf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4eb7cac4e921cb65653f31163b15cb8817a637874b482f383e9c893fb99674e6.webp","width":110,"height":256,"source":"static-detail"},"actors":[{"creditedName":"沢城みゆき","creatorId":"vndb:s43","sourcePersonId":"vndb:s43","canonicalEntityId":"vndb:s43","name":"沢城 みゆき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1414:188876:4244:1","source":"bangumi"}]},{"characterId":"char_bangumi_188877","characterName":"ティフェレイ","sourceIds":{"bangumi":[{"characterId":"188877","match":"source-roster","subjectId":"1414"}]},"originalCharacterName":"ティフェレイ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「勝利の曲を捧げましょう!」"},{"spoiler":false,"text":"海と多くの島で構成される「サジッタ諸島」で、魂に響く詩や曲を作り神に捧げる、神職の楽士。"},{"spoiler":false,"text":"非常に有利な攻撃範囲を持つ弓による攻撃と、独特の「楽曲スキル」によって他では真似出来ない活躍が可能。"}],"source":"bangumi","sourceCharacterId":"188877"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f602ae2fc2981de0e9ab97ea0842478952db950e43cb2d3fd0bb9fd8b1ff475.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4aca901177c8e0f50fded5d8e9b88645ab6794e244b034fb53e0c8b1cb113b13.webp","width":123,"height":256,"source":"static-detail"},"actors":[{"creditedName":"千葉進歩","creatorId":"vndb:s400","sourcePersonId":"vndb:s400","canonicalEntityId":"vndb:s400","name":"千葉進歩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1414:188877:3837:1","source":"bangumi"}]},{"characterId":"char_bangumi_188878","characterName":"キダム","sourceIds":{"bangumi":[{"characterId":"188878","match":"source-roster","subjectId":"1414"}]},"originalCharacterName":"キダム","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「冒険だぜ! ロマンだぜぇ!」"},{"spoiler":false,"text":"冒険とロマンがたまらなく好きで、「冒険商人」として世界を駆け回っている青年。"},{"spoiler":false,"text":"マップに隠された秘宝を見つけ出したり、宝箱の罠を解除したり、魔物の弱点を見抜いたりといった独自の能力で仲間をサポート。ナイフや弩を扱え、戦闘でも死角は少ない。"}],"source":"bangumi","sourceCharacterId":"188878"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/206bc102ace73c8ee2a8b8a43392bd255b86bc862fae3dc040ab60eeec0730fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1ad1f76d20c5b0a490a6fb00c38b0c3339b70d65eb2ef55b002e0574dcf7fa83.webp","width":87,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杉田智和","creatorId":"vndb:s370","sourcePersonId":"vndb:s370","canonicalEntityId":"vndb:s370","name":"杉田 智和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1414:188878:4513:1","source":"bangumi"}]},{"characterId":"char_bangumi_188879","characterName":"カッテント","sourceIds":{"bangumi":[{"characterId":"188879","match":"source-roster","subjectId":"1414"}]},"originalCharacterName":"カッテント","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「まったく、おまえたちは心配性だナ」"},{"spoiler":false,"text":"ヒト族よりも歴史の古い、発明種族「ブルカヌス族」の男の子(人間より長生きなので、人間に置き換えた年齢は不明)。"},{"spoiler":false,"text":"武器の力をパワーアップさせる支援能力が使える他、攻撃力が高い「斧・鎚」や飛距離のある「弩」を装備できるなど、全距離での活躍が可能。"}],"source":"bangumi","sourceCharacterId":"188879"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1ca9bf54f96d9503a6c31f0a7a89340ba6e05ce1538a1b6804a75d03aca9774f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c486868f5b083d1810b876cd300e780bf0fe8e23f4f6ade9cebd73b2af91fbe1.webp","width":196,"height":256,"source":"static-detail"},"actors":[{"creditedName":"代永翼","creatorId":"vndb:s291","sourcePersonId":"vndb:s291","canonicalEntityId":"vndb:s291","name":"代永 翼","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1414:188879:4874:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:5555","sourceCompanyId":"egs:brand:5555","canonicalEntityId":"egs:brand:5555","name":"フライト・プラン","roleCodes":["brand"],"identityStatus":"alias-only-review","relationId":"egs:work-brand:25951:5555","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
