urce-native","relationId":"vndb:vn-staff:127263","source":"vndb"},{"creditedName":"SUGAR","creatorId":"vndb:s39809","sourcePersonId":"vndb:s39809","canonicalEntityId":"vndb:s39809","name":"SUGAR","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:127264","source":"vndb"},{"creditedName":"みぢあ","creatorId":"vndb:s41601","sourcePersonId":"vndb:s41601","canonicalEntityId":"vndb:s41601","name":"海老根 竜司","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:127265","source":"vndb"}]},"cast":[{"characterId":"char_c41754","characterName":"一之瀬 湊","sourceIds":{"bangumi":[{"characterId":"39399","match":"exact-normalized-name-in-linked-work","subjectId":"161729"}],"egsCharacterIds":["7915"],"vndbCharacterId":"c41754"},"originalCharacterName":"一之瀬 湊","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染。水華学園の二年生でクラスメイト。"},{"spoiler":false,"text":"幼い頃は主人公と仲もよく、一緒に遊んだりもしていたが、お互い成長した後はそれなりに距離が出来ていた。"},{"spoiler":false,"text":"とはいえ、家が近所で、学園、クラスも一緒なため、割りと接点が多い。"},{"spoiler":false,"text":"一緒に出かけたりするほどの仲ではないが、お互いに気軽な相手となっている。"},{"spoiler":false,"text":"頼まれると断れないお人よしで、面倒見のよい性格なため、あえて目立ちすぎないように一歩引くようにしている……が、成績優秀で面倒見の良さも周囲に知られているなど、ほとんど隠しきれておらず、なんだかんだと頼られることが多い。"},{"spoiler":false,"text":"普段はそんな素振りを見せることはないが、心許している相手にはツンとした態度を見せたり、からかったりなど意外とお茶目。"}],"source":"egs","sourceCharacterId":"7915","sourceWorkId":"22903","spoiler":false},{"segments":[{"spoiler":false,"text":"所属：水華学園 2年生"},{"spoiler":false,"text":"主人公の幼なじみでクラスメイト。 お人好しで、頼まれると断れない性格。"},{"spoiler":false,"text":"幼い頃は一緒に遊ぶほど仲が良かったが、成長してからはそれなりに距離ができている。"},{"spoiler":false,"text":"とはいえ家が近所で学園もクラスも一緒なため、互いに気の置けない相手となっている。"},{"spoiler":false,"text":"お人好しを自覚して目立たないよう心掛けているが、なんだかんだで頼られてしまっている。"},{"spoiler":false,"text":"心を許した相手には、多少ツンとした態度を見せたり からかったりと、お茶目な一面も。"},{"spoiler":false,"text":"「油断しているから何度も私にぶつかるんだからねっ？　も―少ししっかりして欲しいかな」"}],"source":"bangumi","sourceCharacterId":"39399"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3db6882f02864d1bbd43dc65624fbe1685d3e78d347522a62c216d645a34a5b3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40fd5c789ce0ab6734f8b757cb6adbb2fc813aba7767cbafa92f3a1cb193d491.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朝比奈幸","creatorId":"vndb:s21648","sourcePersonId":"vndb:s21648","canonicalEntityId":"vndb:s21648","name":"朝比奈 幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:161729:39399:17080:1","source":"bangumi"},{"creditedName":"綾音 まこ","creatorId":"vndb:s2581","sourcePersonId":"vndb:s2581","canonicalEntityId":"vndb:s2581","name":"綾音 まこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67789","source":"vndb"}]},{"characterId":"char_c41755","characterName":"立花 月下","sourceIds":{"bangumi":[{"characterId":"39398","match":"exact-normalized-name-in-linked-work","subjectId":"161729"}],"egsCharacterIds":["7916"],"vndbCharacterId":"c41755"},"originalCharacterName":"立花 月下","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水華学園の三年生で主人公の先輩。"},{"spoiler":false,"text":"長身かつスタイルもよく、物静かな立ち振る舞いや言動から、学園でも目立つ先輩、クールな美人として知られている。"},{"spoiler":false,"text":"自分の身に起きている不思議な現象を調べようとする主人公に忠告めいた言葉を告げるなど、どこか謎めいたところがある。"},{"spoiler":false,"text":"表情の少ない大人しい性格であり、口数も必要最低限でそっけない。"},{"spoiler":false,"text":"そうしたところからクールな性格だと見られがちだが、実はコミュ障気味で、人と接するのが苦手。"},{"spoiler":false,"text":"そうした面を隠すために、あえてクールに振舞っている節もある。"}],"source":"egs","sourceCharacterId":"7916","sourceWorkId":"22903","spoiler":false},{"segments":[{"spoiler":false,"text":"所属：水華学園 3年生"},{"spoiler":false,"text":"水華学園の3年生で、主人公の先輩。"},{"spoiler":false,"text":"長身でスタイルが良く、物静かで孤高な立ち振る舞いから学園でも目立つ存在。"},{"spoiler":false,"text":"不思議な現象を調べようとする主人公に忠言するなど、どこか謎めいたところがある。"},{"spoiler":false,"text":"あまり感情を見せず、口数も必要最低限でそっけないためクールな性格と思われがちだが、"},{"spoiler":false,"text":"実はコミュ障気味で、人と接するのが苦手。 それを隠すために装っている節もある。"},{"spoiler":false,"text":"「……あまり学園内をウロウロしないほうがいいよ」"}],"source":"bangumi","sourceCharacterId":"39398"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f32d8d74241ea3c554a73d65229f3752bcd6a365932f0596b5e7b068348bb37.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/447ed78d930b9c29e32a569db80a34c8f562f319d927bd3edb109fe032b02f00.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:161729:39398:10027:1","source":"bangumi"}]},{"characterId":"char_c41756","characterName":"鈴 雛実","sourceIds":{"bangumi":[{"characterId":"39397","match":"exact-normalized-name-in-linked-work","subjectId":"161729"}],"egsCharacterIds":["7917"],"vndbCharacterId":"c41756"},"originalCharacterName":"鈴 雛実","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水華学園の一年生で主人公の後輩。"},{"spoiler":false,"text":"小柄な体つきと、ころころ変わる表情の豊かさが特徴的な女の子。"},{"spoiler":false,"text":"主人公とは水華学園に入る前からの知り合いであり、Loveな意味で主人公を慕っているため、常日頃から色々とアピールしている。"},{"spoiler":false,"text":"しかし、ほぼ空回りに終わるため、その気持ちに気付かれていない。"},{"spoiler":false,"text":"明るく朗らかで、ポジティブな性格。"},{"spoiler":false,"text":"実は計算して行動する少し黒いところがあるのだが、根本的におバカな所があり、計算された行動なのに色々駄々漏れなため周囲からは微笑ましく見られている。"}],"source":"egs","sourceCharacterId":"7917","sourceWorkId":"22903","spoiler":false},{"segments":[{"spoiler":false,"text":"所属：水華学園 1年生"},{"spoiler":false,"text":"主人公を Love の意味で慕っている後輩。 自分の欲求には素直な性格。"},{"spoiler":false,"text":"常日頃から色々とアピールしているが、ことごとく空回りして好意を気づいてもらえていない。"},{"spoiler":false,"text":"ポジティブで明るく朗らかだが、少し腹黒い一面も。"},{"spoiler":false,"text":"何かと計算して行動するが、色々とダダ漏れなので周囲からは微笑ましく見られている。"},{"spoiler":false,"text":"「何かの縁…… いい言葉ですねっ。 申し合わせたわけでもないのに、偶然出会ってしまう…… これって、赤い糸とかいうやつかもしれませんよ～」"}],"source":"bangumi","sourceCharacterId":"39397"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43450d3fad4984ed2d436b44175f2106e4649ca19814db60aa4e92ba8e8ea13c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/761a7a518382b5b5a7b90ba28099fe3b62923ea9824b6eba5512c06207df2271.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:161729:39397:5928:1","source":"bangumi"}]},{"characterId":"char_c42537","characterName":"詩歌 栞","sourceIds":{"bangumi":[{"characterId":"39395","match":"exact-normalized-name-in-linked-work","subjectId":"161729"}],"egsCharacterIds":["7918"],"vndbCharacterId":"c42537"},"originalCharacterName":"詩歌 栞","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイトであり、クラス委員長も務めている。"},{"spoiler":false,"text":"三つ編み眼鏡、成績優秀な優等生というまさに委員長な女の子。"},{"spoiler":false,"text":"規律や良識に厳しく、真面目でやや潔癖なところがある。"},{"spoiler":false,"text":"しかし想定外の事態などに弱く、大きなトラブルなどが起きると途端にヘタレてしまう。"},{"spoiler":false,"text":"麻姫とは仲が悪いようで仲が良く、本人は否定するがケンカ友達のような関係になっている。"},{"spoiler":false,"text":"同じクラス内で麻姫にからかわれやすい主人公には共感するものがあるのか、麻姫にからかわれていたりすると助けてくれる。"}],"source":"egs","sourceCharacterId":"7918","sourceWorkId":"22903","spoiler":false},{"segments":[{"spoiler":false,"text":"所属：水華学園 2年生"},{"spoiler":false,"text":"主人公のクラスメイトであり、クラス委員長も務めている。。"},{"spoiler":false,"text":"規律や良識に厳しく、まじめでやや潔癖なところがある。"},{"spoiler":false,"text":"しかし想定外の事態などに弱く、大きなトラブルが起きると途端にヘタレてしまう。対称的な麻姫とは、仲が悪いようで仲が良く、本人は否定するがケンカ友達のような関係になっている。"},{"spoiler":false,"text":"同じく麻姫にからかわれやすい主人公には共感するものがあるのか、助けてくれることがある。"},{"spoiler":false,"text":"「本当に……みんな、思いのほか噂に踊らされすぎていて嘆かわしい限りよね」"}],"source":"bangumi","sourceCharacterId":"39395"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fde9acdb030788b13c2e95a5b1b0fa2b02461d820cce5f8f01564741f71760c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef5fe92bff5656ce4444f2f4e13a282e0a318e3ef9f5cd5a29869785e2d02980.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽村しき","creatorId":"vndb:s7496","sourcePersonId":"vndb:s7496","canonicalEntityId":"vndb:s7496","name":"羽村しき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:161729:39395:19373:1","source":"bangumi"}]},{"characterId":"char_c42538","characterName":"黒沢 麻姫","sourceIds":{"bangumi":[{"characterId":"39394","match":"exact-normalized-name-in-linked-work","subjectId":"161729"}],"egsCharacterIds":["7919"],"vndbCharacterId":"c42538"},"originalCharacterName":"黒沢 麻姫","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。"},{"spoiler":false,"text":"派手目な外見を裏切ることなく、楽しいこと・遊ぶことが大好き。"},{"spoiler":false,"text":"性に関しても奔放であり経験豊富。つまり非処女。"},{"spoiler":false,"text":"とはいえ、学園生活も楽しんでいるため、学園ではしっかり分別はつけている。"},{"spoiler":false,"text":"明るく奔放な性格で、誰に対しても壁を作らず接するので人当たりがよい。"},{"spoiler":false,"text":"割りと寂しがり屋であり、常に人とかかわっていたいタイプである。"},{"spoiler":false,"text":"栞の初心さやリアクションが面白いのか、猥談を聞かせたり、スキンシップを取ったりでからかうのが日課。"},{"spoiler":false,"text":"同様に主人公も初心な反応を返してしまうためか、よくからかわれている。"}],"source":"egs","sourceCharacterId":"7919","sourceWorkId":"22903","spoiler":false},{"segments":[{"spoiler":false,"text":"水華学園 2年生"},{"spoiler":false,"text":"主人公のクラスメイト。 派手目な外見を裏切ることなく、楽しいこと・遊ぶことが大好き。"},{"spoiler":false,"text":"性に関しても奔放であり経験豊富。 非処女。"},{"spoiler":false,"text":"とはいえ学園生活も楽しんでいるため、学園ではしっかり分別はつけている。"},{"spoiler":false,"text":"明るく奔放な性格で、誰に対しても壁を作らず接するので人当たりが良い。"},{"spoiler":false,"text":"わりと寂しがり屋でもあり、常に人と関わっていたいタイプ。"},{"spoiler":false,"text":"栞のウブさやリアクションがおもしろいのか、猥談を聞かせたりスキンシップをとったりでからかうのが日課。"},{"spoiler":false,"text":"同様に主人公もウブな反応を返してしまうためか、よくからかわれている。"},{"spoiler":false,"text":"「おっやおやぁ～？ もっと顔が赤くなってきた！　何を想像しちゃってるのかなー？ 元気になってきちゃった？」"}],"source":"bangumi","sourceCharacterId":"39394"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3ce68664339fcc6ec14455d8f8c0fc77e5486ab149b22916803441735e4fc72.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3ef7cb4fabd493cd45f91780d0f9ca725fc921e224b5916def6c39bc027fbf06.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上みゆ","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:161729:39394:6558:1","source":"bangumi"}]},{"characterId":"char_c42539","characterName":"城戸 風香","sourceIds":{"bangumi":[{"characterId":"39396","match":"exact-normalized-name-in-linked-work","subjectId":"161729"}],"egsCharacterIds":["7920"],"vndbCharacterId":"c42539"},"originalCharacterName":"城戸 風香","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水華学園の教師で、主人公達のクラス担任。"},{"spoiler":false,"text":"いかにも大人の女性といった容姿ながら、生徒に対してはくだけた調子で接するため生徒からの人気は高い。"},{"spoiler":false,"text":"ちなみに大人の女性としてそれなりの経験は積んでいる。つまり非処女。"},{"spoiler":false,"text":"大人の余裕を感じさせるような包容力のある大らかな性格で、生徒を軽くからかったりすることもあったりと茶目っ気もある。"},{"spoiler":false,"text":"ただし、素は快楽主義者であり、楽しければいいやという思考があったりする。"}],"source":"egs","sourceCharacterId":"7920","sourceWorkId":"22903","spoiler":false},{"segments":[{"spoiler":false,"text":"所属：水華学園 教師"},{"spoiler":false,"text":"学園の教師で、主人公たちのクラス担任。"},{"spoiler":false,"text":"いかにも大人の女性といった容姿で、学生に対してはくだけた調子で接するため人気が高い。"},{"spoiler":false,"text":"ちなみに、大人の女性としてそれなりの経験は積んでいる。つまり非処女。"},{"spoiler":false,"text":"大人の余裕を感じさせる包容力のある大らかな性格で、学生をからかったりと茶目っ気もある。"},{"spoiler":false,"text":"ただし素は快楽主義者であり、楽しければいいやという思考があったりする。"},{"spoiler":false,"text":"「はーい、それじゃ今日もいくわよー。 ん～、席は全部埋まってるみたいだから出席はショートカットするわね～」"}],"source":"bangumi","sourceCharacterId":"39396"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40234dc783a0fc1440c16764177848c9a06774265c23c6d68277269d0b9d2989.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae16594394f633b25dd1edcc69d824a30fbec8c75779007819d90e512cc07fef.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由倉奈於","creatorId":"vndb:s923","sourcePersonId":"vndb:s923","canonicalEntityId":"vndb:s923","name":"由倉 奈於","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:161729:39396:6083:1","source":"bangumi"}]},{"characterId":"char_vndb_c132340","characterName