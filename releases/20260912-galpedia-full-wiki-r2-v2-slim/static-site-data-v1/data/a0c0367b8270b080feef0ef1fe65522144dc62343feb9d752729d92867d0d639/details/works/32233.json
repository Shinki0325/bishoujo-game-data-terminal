{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"32233","model":{"presentationWorkId":"vndb:v33852","staff":{"artwork":[{"creditedName":"ティータ.J(椿T太、湊みなも)","creatorId":"vndb:s1835","sourcePersonId":"egs:creator:5033","canonicalEntityId":"vndb:s1835","name":"ティータ.J(椿T太、湊みなも)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:245090","source":"egs"}],"scenario":[{"creditedName":"利波創造","creatorId":"vndb:s4272","sourcePersonId":"egs:creator:17824","canonicalEntityId":"vndb:s4272","name":"利波創造","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:245089","source":"egs"},{"creditedName":"結城","creatorId":"egs:creator:17264","sourcePersonId":"egs:creator:17264","canonicalEntityId":"egs:creator:17264","name":"結城","roleCode":"scenario","roleLabel":"剧本","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:245091","source":"egs"},{"creditedName":"結城","creatorId":"vndb:s4271","sourcePersonId":"vndb:s4271","canonicalEntityId":"vndb:s4271","name":"結城","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:181830","source":"vndb"}],"music":[],"other":[{"creditedName":"ティータ・J","creatorId":"vndb:s1835","sourcePersonId":"vndb:s1835","canonicalEntityId":"vndb:s1835","name":"ティータ・J","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:181829","source":"vndb"}]},"cast":[{"characterId":"char_c106319","characterName":"椎名 琴里","sourceIds":{"bangumi":[{"characterId":"105922","match":"exact-normalized-name-in-linked-work","subjectId":"366341"}],"egsCharacterIds":["24033"],"vndbCharacterId":"c106319"},"originalCharacterName":"椎名 琴里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A bright and energetic female college student living alone at university."},{"spoiler":false,"text":"She is the type who will say what she likes and dislikes what she dislikes. She used to be a member of the swimming club and looks good in a swimsuit."},{"spoiler":false,"text":"Her incredible figure has also made her a model for a local newspaper."},{"spoiler":false,"text":"Until now she has focused on club activities rather than romance, so she has never had a boyfriend and has never had sex."},{"spoiler":false,"text":"This summer, she returned to her parents' home in Hebigahara City for the first time in a long while to help out at the inn that Himari runs."},{"spoiler":false,"text":"Her parents run an inn, so she is good at cooking."},{"spoiler":false,"text":"Her relationship with Himari is close as they are close in age, and she looks up to her as an older sister rather than a mother."}],"source":"vndb","sourceCharacterId":"c106319"},{"segments":[{"spoiler":false,"text":"明るく快活的で魅力的な女子大生"},{"spoiler":false,"text":"大学で一人暮らししてる明るく元気な女子大生。"},{"spoiler":false,"text":"好きなら好き、嫌いなものは嫌いと物事をはっきり言う性格。"},{"spoiler":false,"text":"以前は水泳部に所属していたことがあり、水着姿が似合う。"},{"spoiler":false,"text":"スタイルも抜群なため地方紙のモデルになったことがある。"},{"spoiler":false,"text":"今まで恋愛より部活だったため、彼氏はおらず、性の経験もない。"},{"spoiler":false,"text":"この夏、久しぶりに蛇が原市にある実家へ戻ってきた。"},{"spoiler":false,"text":"陽葵が切り盛りしている旅館を手伝うために。"},{"spoiler":false,"text":"実家が旅館を営んでいたおかげで料理が得意。"},{"spoiler":false,"text":"陽葵との関係は年齢が近いこともあり良好で母というよりは姉として慕っている。"}],"source":"egs","sourceCharacterId":"24033","sourceWorkId":"32233","spoiler":false},{"segments":[{"spoiler":false,"text":"大学で一人暮らししてる明るく元気な女子大生。"},{"spoiler":false,"text":"好きなら好き、嫌いなものは嫌いと物事をはっきり言う性格。"},{"spoiler":false,"text":"以前は水泳部に所属していたことがあり、水着姿が似合う。"},{"spoiler":false,"text":"スタイルも抜群なため地方紙のモデルになったことがある。"},{"spoiler":false,"text":"今まで恋愛より部活だったため、彼氏はおらず、性の経験もない。"},{"spoiler":false,"text":"この夏、久しぶりに蛇が原市にある実家へ戻ってきた。"},{"spoiler":false,"text":"陽葵が切り盛りしている旅館を手伝うために。"},{"spoiler":false,"text":"実家が旅館を営んでいたおかげで料理が得意。"},{"spoiler":false,"text":"陽葵との関係は年齢が近いこともあり良好で母というよりは姉として慕っている。"}],"source":"bangumi","sourceCharacterId":"105922"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f9d329d6e18e65580ec830d1ed370e55dbc550bb3a33a7fa2b9f1af6c1b7e990.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08ab8ddb4afd67f1b4be2202e02f69f4f0ebd4a7289993392f71260353d24df0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:366341:105922:5936:1","source":"bangumi"}]},{"characterId":"char_c124911","characterName":"椎名 陽葵","sourceIds":{"bangumi":[{"characterId":"105923","match":"exact-normalized-name-in-linked-work","subjectId":"366341"}],"egsCharacterIds":["24034"],"vndbCharacterId":"c124911"},"originalCharacterName":"椎名 陽葵","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A gentle, caring and easy-going adult woman."},{"spoiler":false,"text":"She cannot leave people in trouble alone."},{"spoiler":false,"text":"She married Kotori's father and lived a happy life, but her husband died suddenly a few years ago."},{"spoiler":false,"text":"Since then, she has been running the inn on her own. She had come close to giving up on the inn many times, but in order to protect the inn she inherited from her husband and a place for Kotori to return to, she continued to run it on her own, but the business situation became unsustainable and she was forced to rent it out as a dormitory for single people."}],"source":"vndb","sourceCharacterId":"c124911"},{"segments":[{"spoiler":false,"text":"若々しくも熟れた未亡人の女将"},{"spoiler":false,"text":"優しく面倒見も良いおっとりした大人の女性。"},{"spoiler":false,"text":"困っている人を放っておけない。"},{"spoiler":false,"text":"琴里の父と結婚し、幸せな生活を送っていたが、数年前に夫が急死。"},{"spoiler":false,"text":"それ以降は1人で旅館を切り盛りしている。"},{"spoiler":false,"text":"夫から譲りうけた旅館と琴里が帰ってくる場所を守るためにずっと一人で切り盛りしていたが経営状況が立ち行かなくなったため仕方なく単身寮として貸し出ている。"}],"source":"egs","sourceCharacterId":"24034","sourceWorkId":"32233","spoiler":false},{"segments":[{"spoiler":false,"text":"優しく面倒見も良いおっとりした大人の女性。"},{"spoiler":false,"text":"困っている人を放っておけない。"},{"spoiler":false,"text":"琴里の父と結婚し、幸せな生活を送っていたが、数年前に夫が急死。"},{"spoiler":false,"text":"それ以降は1人で旅館を切り盛りしている。"},{"spoiler":false,"text":"夫から譲りうけた旅館と琴里が帰ってくる場所を守るためにずっと一人で切り盛りしていたが"},{"spoiler":false,"text":"経営状況が立ち行かなくなったため仕方なく単身寮として貸し出ている。"}],"source":"bangumi","sourceCharacterId":"105923"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d0cb92b851ace719d587d7c080cfc24ca08f073e2074f92dc9b8fe7e3aa6e85.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/546b13c40f35f2373e822406bbf3ad7f3aaac0300a91e43fd23e3280809a5eb4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:366341:105923:4727:1","source":"bangumi"}]},{"characterId":"char_vndb_c150369","characterName":"大道","sourceIds":{"vndbCharacterId":"c150369"},"originalCharacterName":"大道","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is the leader of the men living in the dormitory."},{"spoiler":false,"text":"He has a rough appearance and a bad mouth."},{"spoiler":false,"text":"He likes Himari and is persistently after her."},{"spoiler":false,"text":"Ever since Kotori came to help him, he has been dying to get his hands on her too."}],"source":"vndb","sourceCharacterId":"c150369"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1e2c1bfcdb2c4d608d35866778611b6a17dd33ab05d349753e03eb65dab3ecd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/522df32f2fafc570a4c3227af83c08d2ad0aec8940de11aac56546d40a1318dc.webp","width":205,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p12551","sourceCompanyId":"egs:brand:7203","canonicalEntityId":"vndb:p12551","name":"Guilty'Dash","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:32233:7203","source":"egs"},{"companyId":"vndb:p12551","sourceCompanyId":"vndb:p12551","canonicalEntityId":"vndb:p12551","name":"Guilty`Dash","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:97093:v33852","source":"vndb"},{"companyId":"vndb:p12551","sourceCompanyId":"vndb:p12551","canonicalEntityId":"vndb:p12551","name":"Guilty`Dash","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:98615:v33852","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
