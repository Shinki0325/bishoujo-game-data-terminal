nfirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“How can you believe in others so easily?”"},{"spoiler":false,"text":"Takamichi’s co-worker, Haruka takes the opposite approach to teaching, subjecting her students to strict rules and harsh words. She is initially suspicious of Takamichi’s relationship with Lo being more than that of teacher and student, and sternly warns him of such. As she begins to slowly trust Takamichi and Lo, she expresses affection towards them in her own blunt manner."},{"spoiler":false,"text":"From エロ + デレ Blog"}],"source":"vndb","sourceCharacterId":"c20770"},{"segments":[{"spoiler":false,"text":"【貴路の同僚】"},{"spoiler":false,"text":"貴路の同僚の教師。"},{"spoiler":false,"text":"冷静沈着だが、どこか人情味のある性格で生徒や学校の信頼が厚い。"}],"source":"egs","sourceCharacterId":"18403","sourceWorkId":"10716","spoiler":false},{"segments":[{"spoiler":false,"text":"貴路の同僚教師。"},{"spoiler":false,"text":"冷静沈着に加え、人情味もあり、学生からの人気が高い。学校からも信頼されている。"}],"source":"bangumi","sourceCharacterId":"65002"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a39683175bb83323cc97354f4d03dd9acb96bef6f3f59003ab7202959f32754.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0f6618fe5b3c34c1820398093f9dfb7bbcd2f665c4af8b04b4a04c82513cde1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7645:65002:5741:1","source":"bangumi"}]},{"characterId":"char_c20771","characterName":"不可咲 貴路","sourceIds":{"bangumi":[{"characterId":"65000","match":"exact-normalized-name-in-linked-work","subjectId":"7645"}],"egsCharacterIds":["18401"],"vndbCharacterId":"c20771"},"originalCharacterName":"不可咲 貴路","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“Why did I save you? Well, that’s obvious, isn’t it? I couldn’t help but save you.”"},{"spoiler":false,"text":"A teacher at a local school, Takamichi has gradually grown discontent with himself, unsure if he is capable of earning respect from his students, and yet also gaining their obedience without resorting to disciplinary measures. Takamichi’s innately good nature is also his most vulnerable weakness: he is modest, to the point of self-depreciation, and he is compassionate, yet his trust in others often attracts danger."},{"spoiler":false,"text":"From エロ + デレ Blog"}],"source":"vndb","sourceCharacterId":"c20771"},{"segments":[{"spoiler":false,"text":"【悩める新米教師】"},{"spoiler":false,"text":"幼いころからの夢であった担任になったばかりの新米教師。"},{"spoiler":false,"text":"クラス経営が巧くいかず自信を喪失している。"}],"source":"egs","sourceCharacterId":"18401","sourceWorkId":"10716","spoiler":false},{"segments":[{"spoiler":false,"text":"幼い頃からの夢であったクラス担任になったはいいが全くもって巧くいかず、自信を喪失している。"}],"source":"bangumi","sourceCharacterId":"65000"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/5878e0d2ff37a0359db77b79153d0bf7c32456b883cc01d2d4f1ec218d76a35a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a323ea2ab2bb9e248d72f9903f07ca4b740e6b273a96fa0474bee4286c07620.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立花慎之介","creatorId":"vndb:s55","sourcePersonId":"vndb:s55","canonicalEntityId":"vndb:s55","name":"立花 慎之介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7645:65000:4645:1","source":"bangumi"},{"cr