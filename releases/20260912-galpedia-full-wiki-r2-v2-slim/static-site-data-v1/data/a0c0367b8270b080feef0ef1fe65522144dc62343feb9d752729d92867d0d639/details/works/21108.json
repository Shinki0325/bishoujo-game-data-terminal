us":"source-native","relationId":"vndb:vn-staff:94505","source":"vndb"},{"creditedName":"ちゃい","creatorId":"vndb:s2530","sourcePersonId":"vndb:s2530","canonicalEntityId":"vndb:s2530","name":"ちゃい","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:94507","source":"vndb"},{"creditedName":"雅 しぐれ","creatorId":"vndb:s10367","sourcePersonId":"vndb:s10367","canonicalEntityId":"vndb:s10367","name":"雅しぐれ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:94513","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c12904","characterName":"五条 咲","sourceIds":{"vndbCharacterId":"c12904"},"originalCharacterName":"五条 咲","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"On her way home with Makoto, they end up becoming lost. Inquisitive and very much an \"actions over words\" kind of girl, Saki is an optimist. She was raised being addressed as \"Hanahime-san\" because of a family tradition, but is unaware of what that title actually means. In spite of her aversion towards cherry blossoms, for some reason, she also feels drawn to them."},{"spoiler":false,"text":"Translation of the official website's character profile."}],"source":"vndb","sourceCharacterId":"c12904"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/711baea1ad7ccee31f7a6fd9c20b56c7e05daf44de9749bf6a9c3326c26823a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c60c7e61c9a08bf3beed31b3fe8db51a04b75073c38490a9164e06e59086364c.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柚月 春香","creatorId":"vndb:s2536","sourcePersonId":"vndb:s2536","canonicalEntityId":"vndb:s2536","name":"柚月 春香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50382","source":"vndb"}]},{"characterId":"char_vndb_c12905","characterName":"吹雪","sourceIds":{"vndbCharacterId":"c12905"},"originalCharacterName":"吹雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The owner of the mansion Saki and Makoto found when they lost their way. Although Fubuki tells them to go home practically every time they encounter one another, he allows them to stay at his mansion until they find a way to leave Hanari. It's difficult to discern what he really means to get at when talking to him, due to the vagueness of his words."},{"spoiler":false,"text":"He seems to be an Oni (Japanese demon) due to the two red horns on his forehead, but he doesn't know for certain as he barely has any idea why and how long he's been around. From his actions around Saki, it seems that Fubuki once knew her. Emotionally subdued, he usually spends his days alone. He is a sweet tooth."},{"spoiler":false,"text":"Translation of the official website's character profile."}],"source":"vndb","sourceCharacterId":"c12905"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81fc7011aab6c9b5d9ed27002f35d9496e06ce4a21a40ce49d06842b725048c6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b1b09fb54724fbb104d1d8fc7ac67697ca56277ee1e21643c59debab733abf0.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紀之","creatorId":"vndb:s15","sourcePersonId":"vndb:s15","canonicalEntityId":"vndb:s15","name":"杉山 紀彰","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50378","source":"vndb"}]},{"characterId":"char_vndb_c12906","characterName":"佐原 真人","sourceIds":{"vndbCharacterId":"c12906"},"originalCharacterName":"佐原 真人","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"174"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Saki's childhood friend, Makoto works towards his dream of becoming a chef whilst working part time at Saki's father's café. He comes to put his cooking skills to good use at the mansion Fubuki allowed Saki and himself to stay in indefinitely. Makoto is responsible and hard-working, but has a tendency to think too deeply into things and depressing himself as a result."},{"spoiler":false,"text":"He's harbored feelings for Saki for a long time, but has never told her even once. Him and Saki were involved in a similar situation as the current one when they were little- however, he let go of her hand when they were lost in the mountains, and deeply regrets having done so..."},{"spoiler":false,"text":"Translation of the official website's character profile."}],"source":"vndb","sourceCharacterId":"c12906"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e409cc266d694e01434f0a67837505589b497c403dceb0163426309c42e150b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67305c6beb6b477c10a9bc97c260cf5a08f111e244725a0c3159a78adc44b28d.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"逢坂 良太","creatorId":"vndb:s248","sourcePersonId":"vndb:s248","canonicalEntityId":"vndb:s248","name":"逢坂 良太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50379","source":"vndb"}]},{"characterId":"char_vndb_c12915","characterName":"垂氷","sourceIds":{"vndbCharacterId":"c12915"},"originalCharacterName":"垂氷","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"135"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Taruhi has an outward appearance of a young boy, but he's actually some kind of non-human creature. Sometimes, he's called \"hamushi (small winged insect; louse)\" by the mansion's residents. A resident of the mansion as well, Taruhi functions as a caretaker to the others. He usually can complete his chores and tasks (such as the housekeeping and laundry) flawlessly. However, he's not good at cooking."},{"spoiler":false,"text":"Though polite with a gentle smile, sometimes what he says is fairly venomous. Ever since Saki and Makoto arrived in Hanari, he begins to undergo a certain \"change\"."},{"spoiler":false,"text":"Translation of the official website's character profile."}],"source":"vndb","sourceCharacterId":"c12915"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0545742d529542c115f5747a9a1405806fced3b99fda71e24d41af6372111eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd05439874dcb0c85c6134f324484872adfdf46d11533948a5f95ad3e3412e90.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新沢 真","creatorId":"vndb:s959","sourcePersonId":"vndb:s959","canonicalEntityId":"vndb:s959","name":"市来 光弘","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50380","source":"vndb"}]},{"characterId":"char_vndb_c12916","characterName":"陽向","sourceIds":{"vndbCharacterId":"c12916"},"originalCharacterName":"陽向","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An alcohol-loving \"cat\" that lives in the mansion Saki and Makoto wanders into, Hinata is capable of switching between his feline and human form at his whim. In spite of his laziness, he hates being bored and constantly seeks amusement."},{"spoiler":false,"text":"Foul-mouthed and not above thievery, Hinata doesn't have a very good personality. He prizes his hair (or fur?), and is somewhat of a narcissist. He sees Saki more like a toy, and never passes up the chance to give her a hard time."},{"spoiler":false,"text":"Translation of the official website's character profile."}],"source":"vndb","sourceCharacterId":"c12916"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b71a13d6379ed264971d1596d34bccae827b51c6b96c3016051a501136116817.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec836da62e7c82ee7a9324c5a924f1f19a66c7b9a5dae4b41d19739428daddcc.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西野 真人","creatorId":"vndb:s1850","sourcePersonId":"vndb:s1850","canonicalEntityId":"vndb:s1850","name":"西野 真人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50381","source":"vndb"}]},{"characterId":"char_vndb_c12917","characterName":"霧島","sourceIds":{"vndbCharacterId":"c12917"},"originalCharacterName":"霧島","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"190"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Seemingly brawny and taciturn, Kirishima is also a resident of the mansion in Hanari. As one would expect from his appearance, Kirishima takes charge of any task that requires power. However, he also has a more delicate side in his alcohol-making hobby. Kirishima is able to travel between Hanamo and Hanari freely."},{"spoiler":false,"text":"A kind man, he regularly looks out for Saki. However, he also has tendencies to push people away. Ever since Saki arrived in Hanari, he begins to gradually recall his past that he had forgotten."},{"spoiler":false,"text":"Translation of the official website's character profile."}],"source":"vndb","sourceCharacterId":"c12917"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/739d18af14ac8ccaaa85b9de3d5c55a3a9786cfed8dbc5780d59dd48c988e9e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36d9c67e3f9b5cb73ac92cb7dc546deca6478feee7c00d88c5570c0f1c9e07d0.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ミノベ サトル","creatorId":"vndb:s1378","sourcePersonId":"vndb:s1378","canonicalEntityId":"vndb:s1378","name":"新垣 樽助","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50384","source":"vndb"}]},{"characterId":"char_vndb_c12918","characterName":"仔鬼","sourceIds":{"vndbCharacterId":"c12918"},"originalCharacterName":"仔鬼","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A small, masked child that suddenly appeared before Saki's eyes, Ko'oni disappears just as quickly. It becomes apparent that Ko'oni doesn't allow himself to be seen by anybody other than Saki. He also seems to know a great deal about Saki and the residents of the mansion in Hanari..."},{"spoiler":false,"text":"Translation of the official website's character profile."}],"source":"vndb","sourceCharacterId":"c12918"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/4366a906b28a19b0310864b4c449fdfe7f07a5da271da1914e848a63e12bd916.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/4166cb108a95ad8d6bbdf8aa2f17ee44b2a3f6ffb32d6afbff1b6791c73c425e.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤 くらら","creatorId":"vndb:s2538","sourcePersonId":"vndb:s2538","canonicalEntityId":"vndb:s2538","name":"澤 くらら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50383","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p3118","sourceCompanyId":"egs:brand:4391","canonicalEntityId":"vndb:p3118","name":"Mead","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:21108:4391","source":"egs"},{"companyId":"vndb:p1665","sourceCompanyId":"vndb:p1665","canonicalEntityId":"vndb:p1665","name":"ホビボックス株式会社","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:28110:v11633","source":"vndb"},{"companyId":"vndb:p3118","sourceCompanyId":"vndb:p3118","canonicalEntityId":"vndb:p3118","name":"Mead","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:28111:v11633","source":"vndb"},{"companyId":"vndb:p3118","sourceCompanyId":"vndb:p3118","canonicalEntityId":"vndb:p3118","name":"Mead","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:30836:v11633","source":"vndb"},{"companyId":"vndb:p