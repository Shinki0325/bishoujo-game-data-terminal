"no-conflict","source":"bangumi","value":"86"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の父親の友人の娘。"},{"spoiler":false,"text":"主人公一家とは、家族ぐるみの付き合いがあり、主人公とも幼い頃より親しくしていた。"},{"spoiler":false,"text":"主人公に淡い恋心を抱いているが、気位が高く、素直になれない性格から、自分から好きと言えない。"},{"spoiler":false,"text":"主人公が不特定多数の女性と関係を持つことが許せず、自らも弁護人の資格を得て、現在では「セックス裁判」一流弁護人と呼ばれるようになる。しかし、主人公には勝ったことがない。"},{"spoiler":false,"text":"普段は真面目で冷静だが、主人公が絡むと子供っぽくなってしまう。"}],"source":"egs","sourceCharacterId":"14363","sourceWorkId":"13099","spoiler":false},{"segments":[{"spoiler":false,"text":"父親の友人の娘。"},{"spoiler":false,"text":"現在は海外出張をしているため、主人公の家に預けられる事になる。"},{"spoiler":false,"text":"幼少の頃より、主人公の家族と付き合いがあり、昔は主人公とも仲が良く、誠実で優しい主人公に対し、淡い恋心を持っていた……。"},{"spoiler":false,"text":"大人になった今でもその思いが消えないのだが、非常に気位が高いため、主人公に対し、素直になれない。"},{"spoiler":false,"text":"自分以外の女性と次々と関係を持つ、主人公が許せず、弁護人の猛勉○する。"},{"spoiler":false,"text":"その結果、今では 『SEX裁判』 の超一流の弁護人と噂されるようになる。"},{"spoiler":false,"text":"ただ、主人公には一度も勝った事がない為、主人公程有名ではない。"},{"spoiler":false,"text":"普段は真面目で冷静だが、主人公の事が絡むと子供っぽい性格が顔を出し、主人公にその事でよくからかわれる。"}],"source":"bangumi","sourceCharacterId":"204598"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"14363","sourceWorkId":"13099","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"14363","sourceWorkId":"13099","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"14363","sourceWorkId":"13099","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d331f92f8f8a5fafa4ecde41ff076f056153ed03dea59cfbad476ab31887a73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/557f8cf85d8e348e51002178045775c93e8677f4cde4941a9229476398b3343f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:50355:204598:6351:1","source":"bangumi"}]},{"characterId":"char_c47846","characterName":"小早川 菖蒲","sourceIds":{"bangumi":[{"characterId":"204599","match":"exact-normalized-name-in-linked-work","subjectId":"50355"}],"egsCharacterIds":["14364"],"vndbCharacterId":"c47846"},"originalCharacterName":"小早川 菖蒲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公に弟子入りした巨乳娘。立ち位置的には秘書。"},{"spoiler":false,"text":"お馬鹿なことから、「セックス裁判」を申し込まれれば、負けてしまうと危惧した彼女が貞操を守ろうと、腕っこきの弁護人である主人公に弟子入りし、主人公もこれを受け入れ、住み込みで働くことになった。"}],"source":"egs","sourceCharacterId":"14364","sourceWorkId":"13099","spoiler":false},{"segments":[{"spoiler":false,"text":"はちきれんばかりの巨乳で男性を魅了する少女。"},{"spoiler":false,"text":"今年、『SEX裁判』 をする事が可能な歳になる。"},{"spoiler":false,"text":"お馬鹿な性格のため、このままではすぐに『SEX裁判』を申し込まれ、負けてしまうと危惧し主人公の噂を聞きつけ、押しかけで弟子入りをしてしまうと言った、行動的な部分も垣間見える。"},{"spoiler":false,"text":"また、主人公自身も『この乳を一人にするのは危険だ』と判断し、主人公の家の家事全般をする事で住み込みの弟子入りを了承する。"},{"spoiler":false,"text":"立ち位置は主人公の秘書と言った感じ。"},{"spoiler":false,"text":"しかし、この行動がヒロインAの怒りのボルテージを更に上げる結果になってしまうとは主人公自身気付いていない。"}],"source":"bangumi","sourceCharacterId":"204599"}],"profileFacts":[{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"14364","sourceWorkId":"13099","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"14364","sourceWorkId":"13099","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"14364","sourceWorkId":"13099","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/273a508c66a64105105e1783f17f95ff30a3bb0e84dde9503113b5c780c131fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12f7c7055af0eebc01d860c225fb65a5e03a543a78390cc565791920be6abef2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"有河春花","creatorId":"vndb:s877","sourcePersonId":"vndb:s877","canonicalEntityId":"vndb:s877","name":"春河 あかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:50355:204599:19159:1","source":"bangumi"}]},{"characterId":"char_c47847","characterName":"城ヶ崎 玲奈","sourceIds":{"bangumi":[{"characterId":"204600","match":"exact-normalized-name-in-linked-work","subjectId":"50355"}],"egsCharacterIds":["14365"],"vndbCharacterId":"c47847"},"originalCharacterName":"城ヶ崎 玲奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"名家のお嬢様。"},{"spoiler":false,"text":"自己中心的な性格で、何事も自分の思い通りになると思っている。"},{"spoiler":false,"text":"一番良いもので周囲を固めないと気が済まない主義で、「セックス裁判」で最も優秀とされる主人公を顧問弁護人として召抱えようとするが断られる。"},{"spoiler":false,"text":"自分の思い通りにならなかったことは、これが初めてだった彼女は、主人公を気に入り、ちょくちょく主人公宅に押し掛けてくる。"}],"source":"egs","sourceCharacterId":"14365","sourceWorkId":"13099","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の住む街の名家のお嬢様。"},{"spoiler":false,"text":"自分中心で世界が回っていると思っているフシがあり、高飛車。"},{"spoiler":false,"text":"周りのものは1番のもので固めないと気がすまない主義である。"},{"spoiler":false,"text":"そのため、主人公を自分専用の弁護人にしようと話を持ちかけたが、断られてしまう。"},{"spoiler":false,"text":"初めて、自分の思い通りに動かない主人公を気に入り、自分の婿にしようと頻繁に主人公の家に押しかけてくるが、自分から言い出すプライドが許さず、現在に至る。"},{"spoiler":false,"text":"凛とは犬猿の仲であり、よくいがみ合っている。"}],"source":"bangumi","sourceCharacterId":"204600"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3398443a9e80fe375735b5a85d800a949c56c863afc4d27391a9ffffbee1406.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83985bef1d62365ebab8eb19dc43e33cadd6900dec0ec14fc23d921dd09aa6ba.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永見はるか","creatorId":"vndb:s452","sourcePersonId":"vndb:s452","canonicalEntityId":"vndb:s452","name":"永見 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:50355:204600:4674:1","source":"bangumi"}]},{"characterId":"char_c47848","characterName":"七海 ののか","sourceIds":{"bangumi":[{"characterId":"204601","match":"exact-normalized-name-in-linked-work","subjectId":"50355"}],"egsCharacterIds":["14366"],"vndbCharacterId":"c47848"},"originalCharacterName":"七海 ののか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"時代劇「大岡越前守」をこよなく愛する「セックス裁判」の裁判員。"},{"spoiler":false,"text":"そのため裁判中の口調が時代劇風に変化する（「あい、待たれよ!!」「双方の言い分はようわかった……」など）。"},{"spoiler":false,"text":"裁判員の仕事を天職だと思っているらしい。"},{"spoiler":false,"text":"笑顔が眩しい明朗快活な女性。"},{"spoiler":false,"text":"興奮すると「裁判長ロボ」を破壊し、全てを自分で取り仕切ってしまうため、問題視されている。"},{"spoiler":false,"text":"「大岡越前」のような渋いおじ様に処女を捧げることを夢見る自称「永遠の美少女」。"}],"source":"egs","sourceCharacterId":"14366","sourceWorkId":"13099","spoiler":false},{"segments":[{"spoiler":false,"text":"笑顔が眩しい明朗活発な 『SEX裁判』 の裁判員。"},{"spoiler":false,"text":"時代劇の 『大岡越前守』 が大好きで裁定を下す職業である、この裁判員の仕事を天職だと思っている。"},{"spoiler":false,"text":"『SEX裁判』中は、口調が時代劇風に変化する。（『あい、待たれよ!!』、『双方の言い分はようわかった……』等）"},{"spoiler":false,"text":"また、興奮してしまうと、『裁判長ロボ』を破壊し、自分で取り仕切ってしまうため、政府からは問題児とされている。"},{"spoiler":false,"text":"ただ、辞めさせられそうになるも本人の弁が立つため、政府からは厳重注意でいつも終わっている。"},{"spoiler":false,"text":"いつか大岡越前のような渋いおじ様に処女を捧げる事を夢見ている、自称 『永遠の美少女』 。"},{"spoiler":false,"text":"実際の年齢は……"}],"source":"bangumi","sourceCharacterId":"204601"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"14366","sourceWorkId":"13099","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"14366","sourceWorkId":"13099","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"14366","sourceWorkId":"13099","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e6465725b1da55f602158278a45b720948fa714c0dae2a0fd63875c8582b3d9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbfb9b955c84673f6566f749c8e595843ff76320cbfa16fd395bd9c5a4105a98.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紅月 ことね","creatorId":"vndb:s1649","sourcePersonId":"vndb:s1649","canonicalEntityId":"vndb:s1649","name":