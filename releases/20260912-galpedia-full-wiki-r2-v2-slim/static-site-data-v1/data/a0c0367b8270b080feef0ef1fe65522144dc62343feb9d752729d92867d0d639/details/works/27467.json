es/f7/f7d722575c3efea63c38e2afdcb3ce59b759ff2703b056ccc47a8efd20a8343c.webp","width":219,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c70907","characterName":"吉畑 菜緒","sourceIds":{"vndbCharacterId":"c70907"},"originalCharacterName":"吉畑 菜緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nao is Shouta's neighbor and first love. She's known him since he was a baby and treats him like a little brother. She is unaware of his feelings for her."},{"spoiler":false,"text":"Nao was a delinquent back in high school, but now is married and has a daughter, Natsuhi. She works hard to support her family and pay the debts of her lazy husband."},{"spoiler":false,"text":"Lately, Nao is worried because Natsuhi doesn't seem to care about her future, so Nao asks Shouta to be her daughter's tutor and help the girl with her studies."}],"source":"vndb","sourceCharacterId":"c70907"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44a85cafd9baa9c4c9040eb2680dddd39f0feb21097a870f9aedd7c799b2c96c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df7b3d0a87be4ada6e888a1ae96db6e2f0533d69228fad94ff69a5a494e52523.webp","width":150,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎津 まお","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:77733","source":"vndb"}]},{"characterId":"char_vndb_c70908","characterName":"吉畑 夏妃","sourceIds":{"vndbCharacterId":"c70908"},"originalCharacterName":"吉畑 夏妃","characterNameSource":null,"role":"primary","status":"source-only-candidate",