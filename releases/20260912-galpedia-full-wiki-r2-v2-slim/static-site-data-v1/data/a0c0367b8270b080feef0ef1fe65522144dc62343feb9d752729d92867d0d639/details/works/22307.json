tps://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c335c7b472b60453b9107fbc7f5b924b1d5225ed4c9c6b5c6c38d0d2b5ca03e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab1814228ed729d186ab4e68c778e73fba8712dc6e19af70af84fe31548b2991.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅倉 ともよ","creatorId":"vndb:s5493","sourcePersonId":"vndb:s5493","canonicalEntityId":"vndb:s5493","name":"浅倉 ともよ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:65467","source":"vndb"}]},{"characterId":"char_vndb_c37887","characterName":"なな様","sourceIds":{"vndbCharacterId":"c37887"},"originalCharacterName":"なな様","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A diabolical master phantom thief terrorizing Tea Town, and the leader of the Red-headed Thieves. Whether or not she actually wants it, she will take it with her own hands."},{"spoiler":false,"text":"She is a charismatic person who has such a skill that she once brought together a group of thieving cats in a desolate town."},{"spoiler":false,"text":"Even today, she cheerfully follows her instincts, and if she can't find something interesting, she makes it happen herself."},{"spoiler":false,"text":"translated from the official website"}],"source":"vndb","sourceCharacterId":"c37887"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f6cf26a4caf94081a890aa4010df751d3cbc7994e85b7512d03e93e6b9166f8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a31ec79aeacd3d4d4d3a9faf0727f69c63c2a4139c40ddb0e7b708378a0cbd10.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藍沢 夏癒","creatorId":"vndb:s3233","sourcePersonId":"vndb:s3233","canonicalEntityId":"vndb:s3233","name":"藍沢 夏癒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:65466","source":"vndb"}]},{"characterId":"char_vndb_c37888","characterName":"店長","sourceIds":{"vndbCharacterId":"c37888"},"originalCharacterName":"店長","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Her name is Tsukune. She is the manager of \"Fancy Shop ＝ Mary Ann\", a small store that sells mysterious knick-knacks."},{"spoiler":false,"text":"She is serious and hardworking, but she is also bit of a goofball, and has recently fallen victim to the \"mental illness curse\" after failing to properly handle an on-sale product in the store."},{"spoiler":false,"text":"She is actually reasonably old and has more knowledge about Tea Town than most people."},{"spoiler":false,"text":"However, she is basically a shut-in, so she lacks knowledge about the world, which is quite the imbalance."},{"spoiler":false,"text":"She prefers to be called \"Tsuu-chan\"."},{"spoiler":false,"text":"translated from the official website"}],"source":"vndb","sourceCharacterId":"c37888"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c5dceb034e4a91821de687afd016b3b6bf8e0de98f1777413f506ec264ff32b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfd7cffac8e9bb2ddcfac42d4aa4e9f808ada98a871082254a1f05feddaeb54f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"亜久城 皐月","creatorId":"vndb:s5660","sourcePersonId":"vndb:s5660","canonicalEntityId":"vndb:s5660","name":"亜久城 皐月","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:65468","source":"vndb"}]},{"characterId":"char_vndb_c37892","characterName":"小鳥遊 姉妹","sourceIds":{"vndbCharacterId":"c37892"},"originalCharacterName":"小鳥遊 姉妹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A part-timer who works at \"Fancy Shop = Mary Ann\"."},{"spoiler":false,"text":"She's a girl with a dual personality: Kururi (who has insomnia) and Suimu (who has hypersomnia) both live together in one body."},{"spoiler":false,"text":"Aside from Kururi, no one has ever been able to have a conversation with Suimu, since she sleeps all the time."},{"spoiler":false,"text":"\"You don't have to count her as a character,\" says the manager."},{"spoiler":false,"text":"Apparently, her family is actually rich."},{"spoiler":false,"text":"translated/edited from the official website"}],"source":"vndb","sourceCharacterId":"c37892"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3b85c4ed94645d60094c2c8b2a5769acc7a70fa8790a64dcd304026ded36891.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32128f324a5602fa4e83d97d1e563b78a60653354307361776af30cad69ddaf3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西浦 のどか","creatorId":"vndb:s9915","sourcePersonId":"vndb:s9915","canonicalEntityId":"vndb:s9915","name":"西浦 のどか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:65469","source":"vndb"}]},{"characterId":"char_vndb_c37893","characterName":"パットマン","sourceIds":{"vndbCharacterId":"c37893"},"originalCharacterName":"パットマン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The envoy of justice who protects the town."},{"spoiler":false,"text":"His suit, with a design that can be described as immoral or blasphemous, is said to make anyone who takes one look at it succumb before justice and feel fear in their hearts. His existence is indispensable for maintaining peace in Tea Town, and his daily routine consists solely of chasing after Nana-sama."},{"spoiler":false,"text":"Perhaps because of his age, he has recently been trying to cut back on cholesterol, out of concern for his health."},{"spoiler":false,"text":"translated from the official website"}],"source":"vndb","sourceCharacterId":"c37893"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33b3bcbc7bcef5f909e99cac1e833a9d8bf46d488730bb487ce437bf3b5c10ac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1373407a5b7359d6e94d4a849d71831cf05048d97874fe77d0a4a78ee0f547c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ザンジバル 斉藤","creatorId":"vndb:s21481","sourcePersonId":"vndb:s21481","canonicalEntityId":"vndb:s21481","name":"ザンジバル 斉藤","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:65470","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p4911","sourceCompanyId":"egs:brand:4309","canonicalEntityId":"vndb:p4911","name":"studioハイライト","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:22307:4309","source":"egs"},{"companyId":"vndb:p4911","sourceCompanyId":"vndb:p4911","canonicalEntityId":"vndb:p4911","name":"studioハイライト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:47591