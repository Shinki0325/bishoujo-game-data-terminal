e":"vndb"},{"creditedName":"時風 聖夜","creatorId":"vndb:s28299","sourcePersonId":"vndb:s28299","canonicalEntityId":"vndb:s28299","name":"時風 聖夜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:124642","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c51183","characterName":"チェスター","sourceIds":{"vndbCharacterId":"c51183"},"originalCharacterName":"チェスター","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is afflicted by Enigma, with only a few weeks left to live. Yet he continues on with a laid-back attitude, as though he has no regrets, or perhaps it is just his character."},{"spoiler":false,"text":"He washes up on the beach of Carlyle, and is nursed back to consciousness by the local inhabitants. As he spends his time on the island, growing closer to everyone, he start uncovering one of its other faces. How will Chester use his remaining time in this world?"},{"spoiler":false,"text":"From Fruitbat Factory"}],"source":"vndb","sourceCharacterId":"c51183"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c23de93a0b79c063e62d076c349c2caed9ded639e2aeaaeaa2d5ebca61980d83.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc45dc2ae7d95430240e4a419d4a4e4ec6d846cf21cb58dfe4e9e700b31c056c.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c51184","characterName":"エンヴィリオ","sourceIds":{"vndbCharacterId":"c51184"},"originalCharacterName":"エンヴィリオ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"gender":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"n"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious living doll that Chester meets on the island. It possesses an androgynous appearance, and although it usually behaves like a young child, it tends to change its attitude suddenly and utter a word or two that seem to hint at something beyond common knowledge."},{"spoiler":false,"text":"It doesn't seem like it minds the fact it is despised and shunned by the islanders. For whatever reason, it shows no interest in anyone but Chester."},{"spoiler":false,"text":"From Fruitbat Factory"}],"source":"vndb","sourceCharacterId":"c51184"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/7288179835f871b927f7da28c66b7d414606efbe73ab9cfb7d811443fa875cd1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77c727dcae16afb558e260263fc7da9448d55619b84397f95f43c6dde28e103b.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c51185","characterName":"ラウロ","sourceIds":{"vndbCharacterId":"c51185"},"originalCharacterName":"ラウロ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young woodcutter. He has his lost parents at a young age and has grown up with his sister Colette, which in part explains his slight sister complex."},{"spoiler":false,"text":"He is hotheaded and has a foul mouth, but is an honest and gentle boy on the inside."},{"spoiler":false,"text":"From Fruitbat Factory"}],"source":"vndb","sourceCharacterId":"c51185"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b53b605d04926e9f3244cdf2e0dc031405fee9e147042638ea3cf958f081644c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aab9cb32b0b898e6c509c96504816da3ece033d46accdc851b1b2a7636a653b4.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c51186","characterName":"イグニス","sourceIds":{"vndbCharacterId":"c51186"},"originalCharacterName":"イグニス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man mysterious even for an inhabitant of the island. He shows little emotion, and hardly ever speaks; no one can tell what truly is going on inside his mind. An artisan dollmaker."},{"spoiler":false,"text":"From Fruitbat Factory"}],"source":"vndb","sourceCharacterId":"c51186"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1a420bdf4bedd74ca9451d380145914b2e99ffa3a2042ca61cbf80e2fbe8541.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3c4afd5221d9083ee2b7d25b4fb19bf35c9236de3f8f084b8c9d1bef4315892.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c51187","characterName":"グレタ","sourceIds":{"vndbCharacterId":"c51187"},"originalCharacterName":"グレタ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The only doctor on the island, Greta's red hair makes her stand out from all other inhabitants. She is the one to recognize Chester's disease, and provides him with a temporary place to live, as well as information about the island. Her mannerism makes her seem a lot older than she looks."},{"spoiler":false,"text":"From Fruitbat Factory"}],"source":"vndb","sourceCharacterId":"c51187"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94d54ff14ae2d54287f1d02a2bf13617221d6da42fe940e5e765bd509963e7d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c05087d44d20339ff03f0346326deaeaadc7ddd1e394714cc64e3c88031d1dd3.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c51188","characterName":"コレット","sourceIds":{"vndbCharacterId":"c51188"},"originalCharacterName":"コレット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who works as a weaver on the island. She has lost her parents at a young age, and has lived alone with her brother Lauro since. She is good at household chores, but hopeless at cooking."},{"spoiler":false,"text":"From Fruitbat Factory"}],"source":"vndb","sourceCharacterId":"c51188"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d58fce75169e51bc7ef2e8a08046527a4f72be2d228bf5f4d67540dc038ad38.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/774f208e758e28546993bad49dc5ca9f4ed437f77b9b2d9d73fb896af1a11b6f.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c51189","characterName":"エリオット","sourceIds":{"vndbCharacterId":"c51189"},"originalCharacterName":"エリオット","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFa