primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An ojou-sama who is the daughter of a businessman who owns most of the island, Haruka is quite the sheltered girl who doesn’t know much about the world. However, she is really curious about everything and is extremely happy when she does things for the first time (including being tsukkomied). She stays with her maid Aria at the church overlooking the sea since her body is weak, so she doesn’t show up at school much. She likes roleplaying. Her dream is to open a kakigoori (shaved ice) house."},{"spoiler":false,"text":"From Micchi's review"}],"source":"vndb","sourceCharacterId":"c3097"},{"segments":[{"spoiler":false,"text":"キスに興味津々のお年頃なお嬢様。"},{"spoiler":false,"text":"海辺に建つ小さな教会で、メイドとふたりきりで住んでいる。"},{"spoiler":false,"text":"身体が弱く療養中のため、滅多に学園には現れない。"},{"spoiler":false,"text":"将来の夢は、教会でかき氷屋をはじめること。"}],"source":"egs","sourceCharacterId":"7475","sourceWorkId":"11923","spoiler":false},{"segments":[{"spoiler":false,"text":"处于对接吻兴致勃勃年纪的大小姐。"},{"spoiler":false,"text":"和女仆两人独自住在建在海边的小教会里。"},{"spoiler":false,"text":"由于身体柔弱而处在疗养中，在学园中很少出现。"},{"spoiler":false,"text":"将来的梦想是在教会开刨冰店。"}],"source":"bangumi","sourceCharacterId":"12227"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"7475","sourceWorkId":"11923","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"7475","sourceWorkId":"11923","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"79 cm","valueContext":null,"source