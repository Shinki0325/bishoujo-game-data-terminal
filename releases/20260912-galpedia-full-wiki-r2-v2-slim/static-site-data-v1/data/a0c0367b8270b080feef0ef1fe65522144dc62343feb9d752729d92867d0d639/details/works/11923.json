CharacterId":"7471","sourceWorkId":"11923","spoiler":false},{"segments":[{"spoiler":false,"text":"在露天咖啡店『海鸥』打工的少女。"},{"spoiler":false,"text":"某天对主人公一见钟情后，展开了热烈的接近。"},{"spoiler":false,"text":"理由不明。住所不明。"},{"spoiler":false,"text":"三围就算不问也会主动告诉。"},{"spoiler":false,"text":"常常把爱猫『ノンポリ』放在头上。"}],"source":"bangumi","sourceCharacterId":"12224"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"7471","sourceWorkId":"11923","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"7471","sourceWorkId":"11923","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"7471","sourceWorkId":"11923","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"7471","sourceWorkId":"11923","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/394627beb8614a3ed51c4df39e75e58d6d639eb51788571d6eeac4863b65d3a0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b15ec24279af38ef8c7b575e8acf80c1cd7ca6da1056f0d0ceae9dab48a3f062.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:4529:12224:4809:1","source":"bangumi"}]},{"characterId":"char_c3095","characterName":"青山 つかさ","sourceIds":{"bangumi":[{"characterId":"12225","match":"exact-normalized-name-in-linked-work","subjectId":"4529"}],"egsCharacterIds":["7473"],"vndbCharacterId":"c3095"},"originalCharacterName":"青山 つかさ","characterNameSource":null,"role":"primary","status":"source-only-candidate","id