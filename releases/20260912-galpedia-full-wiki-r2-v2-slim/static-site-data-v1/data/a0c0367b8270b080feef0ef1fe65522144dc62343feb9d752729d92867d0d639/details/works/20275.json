{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"20275","model":{"presentationWorkId":"vndb:v14765","staff":{"artwork":[{"creditedName":"泉水いこ","creatorId":"vndb:s7802","sourcePersonId":"egs:creator:12357","canonicalEntityId":"vndb:s7802","name":"泉水いこ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:129813","source":"egs"}],"scenario":[{"creditedName":"朝凪軽(GM、夕凪)","creatorId":"vndb:s3018","sourcePersonId":"egs:creator:784","canonicalEntityId":"vndb:s3018","name":"朝凪軽(GM、夕凪)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:129814","source":"egs"}],"music":[],"other":[{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:107961","source":"vndb"}]},"cast":[{"characterId":"char_c23701","characterName":"綾咲 椿","sourceIds":{"bangumi":[{"characterId":"173335","match":"exact-normalized-name-in-linked-work","subjectId":"181311"}],"egsCharacterIds":["3518"],"vndbCharacterId":"c23701"},"originalCharacterName":"綾咲 椿","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『魔児』を生み出す為の『依り代』として菫の手で集められた子供の一人。"},{"spoiler":false,"text":"何処からか連れてこられた孤児。"},{"spoiler":false,"text":"集められた子供達の中で唯一不思議な力を持っていた。"},{"spoiler":false,"text":"子供のころから現在に至るまで、どちらかというと尊大な口調で、あまり周りのことを考えない発言をする。"},{"spoiler":false,"text":"そのため、千歳以外の周囲の人物からは少し距離を置かれていた。"},{"spoiler":false,"text":"ある日、屋敷に迷い込んできた秋隆と恋仲となり、秋隆の間に子供ができれば秋隆を独り占めできると考え、書物で読んだ子供が作れるという箱を作り、子供を産み出す儀式を秋隆と行う。"},{"spoiler":false,"text":"しかし儀式で産まれたのは黒い魔障の子供、魔児（まご）だった。"},{"spoiler":false,"text":"さらに儀式が失敗したことにより、魔児は暴走。"},{"spoiler":false,"text":"屋敷を燃やし、村人を死なせるという惨事を引き起こす。"},{"spoiler":false,"text":"その惨事の際、椿は五感全てを失い、植物人間の状態となる。"},{"spoiler":false,"text":"村の神主の菫の陰謀により、村では表向きは死んだという事にされ、村の外れの元屋敷にて監禁生活を送ることとなる。"},{"spoiler":false,"text":"数年後、思念体として復活を遂げた椿は、壊れた箱に念を込め箱を直し、菫によって奪われた力を取り戻し、元に戻る機会を待っていた。"},{"spoiler":false,"text":"そんなある日、思念体となった椿の元へナタリアに連れられ、秋隆が現れる。"},{"spoiler":false,"text":"椿は秋隆に箱を託し、魔児の欠片を、奪われた力を秋隆と共に取り戻そうとする。"}],"source":"egs","sourceCharacterId":"3518","sourceWorkId":"20275","spoiler":false},{"segments":[{"spoiler":false,"text":"“魔児” を生み出すための依り代として菫の手で集められた子供の一人で、唯一不思議な力を持っていた。"},{"spoiler":false,"text":"ある日、屋敷に迷い込んできた秋隆と恋仲となる。"},{"spoiler":false,"text":"秋隆との間に子供ができれば彼を独り占めできると考え、子供を産み出す儀式を秋隆と行う。"},{"spoiler":false,"text":"しかし儀式の失敗により、黒い魔障の子供・魔児（まご）は暴走。"},{"spoiler":false,"text":"その惨事の際、椿は五感すべてを失い、植物人間状態になってしまう。"},{"spoiler":false,"text":"菫の陰謀により村では死んだということにされ、村外れの元屋敷にて監禁生活を送ることとなる。"},{"spoiler":false,"text":"数年後、思念体として復活を遂げた椿は、菫に奪われた力を取り戻し元に戻る機会を待っていた。"},{"spoiler":false,"text":"そんなある日、ナタリアに連れられて秋隆が現れる。"},{"spoiler":false,"text":"椿は秋隆に箱を託し、魔児の欠片を、奪われた力を秋隆と共に取り戻そうとする。"}],"source":"bangumi","sourceCharacterId":"173335"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"3518","sourceWorkId":"20275","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"3518","sourceWorkId":"20275","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0cf9f869df5e37332eadf186ecaa632d5283556267ce56a8bc30225e8be3650e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5ba164ea63150d42948d22d1a656e168c62943bd45794b7e45b7e691bf6322c1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川知子","creatorId":"vndb:s694","sourcePersonId":"vndb:s694","canonicalEntityId":"vndb:s694","name":"ひむろゆり(氷室百合)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:181311:173335:5924:1","source":"bangumi"}]},{"characterId":"char_c23703","characterName":"東堂 千歳","sourceIds":{"bangumi":[{"characterId":"173336","match":"exact-normalized-name-in-linked-work","subjectId":"181311"}],"egsCharacterIds":["3519"],"vndbCharacterId":"c23703"},"originalCharacterName":"東堂 千歳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"清純派の巫女。"},{"spoiler":false,"text":"『魔児』を生み出す為の『依り代』として菫の手で集められた子供の一人。"},{"spoiler":false,"text":"非常に心優しく、面倒見も良い、明るい感じの女の子。"},{"spoiler":false,"text":"子供の頃、周りの人間から避けられていた椿と唯一仲良くしていた。"},{"spoiler":false,"text":"椿と一緒に仲良くなった秋隆に恋心を抱くが、秋隆にとっては妹的な存在だった。"},{"spoiler":false,"text":"秋隆と椿が恋仲になった為、椿に嫉妬するようになる。"},{"spoiler":false,"text":"過去の事件の後、惨事を忘れるためか、巫女として献身的に働き、村人からも愛される巫女として成長する。"},{"spoiler":false,"text":"神社を切り盛りする立場と忙しく働いていたある日、村から追放されたはずの秋隆と再会する。"},{"spoiler":false,"text":"突然の再会に喜ぶ千歳だが、秋隆は千歳を避けるように逃げ出す。"},{"spoiler":false,"text":"秋隆の不審な態度に戸惑いながらも、いまだ秋隆への強い恋心を抱いていた千歳は、その思いを叶えるため、秋隆を探し始める。"}],"source":"egs","sourceCharacterId":"3519","sourceWorkId":"20275","spoiler":false},{"segments":[{"spoiler":false,"text":"“魔児” を生み出すための依り代として菫の手で集められた子供。"},{"spoiler":false,"text":"非常に心優しく、面倒見も良い、明るい感じの女の子。"},{"spoiler":false,"text":"子供の頃、周りの人間から避けられていた椿と唯一仲良くしていた。"},{"spoiler":false,"text":"しかし想いを寄せていた秋隆と椿が恋仲になったため、椿に嫉妬するようになる。"},{"spoiler":false,"text":"過去の事件の後、惨事を忘れるためか献身的に働き、村人からも愛される巫女として成長する。"},{"spoiler":false,"t