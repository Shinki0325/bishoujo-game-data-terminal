{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"20152","model":{"presentationWorkId":"vndb:v14521","staff":{"artwork":[{"creditedName":"鉄豚(てつぶた)","creatorId":"vndb:s21799","sourcePersonId":"egs:creator:20700","canonicalEntityId":"vndb:s21799","name":"鉄豚(てつぶた)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:128991","source":"egs"}],"scenario":[{"creditedName":"Team・Birth-tale(チームバーステイル)","creatorId":"vndb:s6623","sourcePersonId":"egs:creator:20701","canonicalEntityId":"vndb:s6623","name":"Team・Birth-tale(チームバーステイル)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:128993","source":"egs"},{"creditedName":"三家原 優人","creatorId":"vndb:s5745","sourcePersonId":"vndb:s5745","canonicalEntityId":"vndb:s5745","name":"三家原 優人","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:106802","source":"vndb"},{"creditedName":"紀伊国屋 虎辰","creatorId":"vndb:s39836","sourcePersonId":"vndb:s39836","canonicalEntityId":"vndb:s39836","name":"紀伊国屋 虎辰","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:106805","source":"vndb"}],"music":[{"creditedName":"岩垂 徳行","creatorId":"vndb:s418","sourcePersonId":"vndb:s418","canonicalEntityId":"vndb:s418","name":"岩垂 徳行","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:106799","source":"vndb"},{"creditedName":"Kenichi Kunishima","creatorId":"vndb:s3354","sourcePersonId":"vndb:s3354","canonicalEntityId":"vndb:s3354","name":"國島 憲一","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:106803","source":"vndb"},{"creditedName":"愛川 ありす","creatorId":"vndb:s50678","sourcePersonId":"vndb:s50678","canonicalEntityId":"vndb:s50678","name":"愛川 ありす","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:106807","source":"vndb"}],"other":[{"creditedName":"都月景(都月系)","creatorId":"vndb:s33188","sourcePersonId":"egs:creator:19370","canonicalEntityId":"vndb:s33188","name":"都月景(都月系)","detail":"プロット","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:128992","source":"egs"},{"creditedName":"璃杏","creatorId":"vndb:s1176","sourcePersonId":"egs:creator:19148","canonicalEntityId":"vndb:s1176","name":"璃杏","detail":"OP曲「ドリームワンダーランド」、ED曲「Endless Refraom ～時空の旋律～」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:134139","source":"egs"},{"creditedName":"しほり(瀬名、She-holly)","creatorId":"vndb:s1875","sourcePersonId":"egs:creator:12650","canonicalEntityId":"vndb:s1875","name":"しほり(瀬名、She-holly)","detail":"挿入歌「Dark-Unlimited」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:197804","source":"egs"},{"creditedName":"璃杏","creatorId":"vndb:s1176","sourcePersonId":"vndb:s1176","canonicalEntityId":"vndb:s1176","name":"璃杏","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:106800","source":"vndb"},{"creditedName":"しほり","creatorId":"vndb:s1875","sourcePersonId":"vndb:s1875","canonicalEntityId":"vndb:s1875","name":"しほり","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:106801","source":"vndb"},{"creditedName":"都月 景","creatorId":"vndb:s33188","sourcePersonId":"vndb:s33188","canonicalEntityId":"vndb:s33188","name":"都月 景","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:106804","source":"vndb"},{"creditedName":"愛川 ありす","creatorId":"vndb:s50678","sourcePersonId":"vndb:s50678","canonicalEntityId":"vndb:s50678","name":"愛川 ありす","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:106808","source":"vndb"}]},"cast":[{"characterId":"char_c22097","characterName":"アリス リデル","sourceIds":{"bangumi":[{"characterId":"26334","match":"exact-normalized-name-in-linked-work","subjectId":"94395"}],"egsCharacterIds":["3811"],"vndbCharacterId":"c22097"},"originalCharacterName":"アリス リデル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"青の国キャロルの書主（ブックマーカー）。"},{"spoiler":false,"text":"倒れていたアキトを介抱し、この世界の案内役を買ってでる。"},{"spoiler":false,"text":"世話好きで優しい女の子なのだが、おひとよしすぎて困っている人を見るとほっとけないため、そのせいでトラブルに巻き込まれることも多い。"},{"spoiler":false,"text":"ラビットとは実の姉妹のように仲が良く、お互い信頼し合っている。"}],"source":"egs","sourceCharacterId":"3811","sourceWorkId":"20152","spoiler":false},{"segments":[{"spoiler":false,"text":"青之国度キャロル的书主（Bookmarker）。"},{"spoiler":false,"text":"关照倒下了的アキト，主动承担起他在这个世界的导游责任。"},{"spoiler":false,"text":"是个喜欢照顾别人的温柔女孩，但因为过分好心，看到犯愁的人就不会放手，所以经常被牵连进麻烦的事情之中。"},{"spoiler":false,"text":"与ラビット的关系犹如亲生姐妹一样融洽，互相信任。"},{"spoiler":false,"text":"「犯愁的人可得去帮忙啊！」"},{"spoiler":false,"text":"☆何谓书主（Bookmarker）？"},{"spoiler":false,"text":"承担所在国度的故事的人（主人公）。"},{"spoiler":false,"text":"除了能够利用书签与书的门来往别的国度，还拥有各种各样不可思议的力量。"},{"spoiler":false,"text":"倘若Bookmarker消失，所在国度的故事会终结消失。"}],"source":"bangumi","sourceCharacterId":"26334"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c443e27dd649940cf466f51a69af996ea194153b7b75766943d3befa39e18e7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/033f35e7b0a281d93eaa741b41c03987fff588c07e1c843ef8de851af7b455e3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:94395:26334:4727:1","source":"bangumi"}]},{"characterId":"char_c22098","characterName":"ラビット ホワイト","sourceIds":{"bangumi":[{"characterId":"26335","match":"exact-normalized-name-in-linked-work","subjectId":"94395"}],"egsCharacterIds":["3812"],"vndbCharacterId":"c22098"},"originalCharacterName":"ラビット ホワイト","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ミステリアスな仮面をつけた青の国キャロルの騎士隊長。"},{"spoiler":false,"text":"トランプの槍を武器とし、寡黙かつ勇敢な振る舞いで部下たちの信頼も厚い。"},{"spoiler":false,"text":"アリスとは長年の親友であり、彼女の危機にはどんな時でも颯爽と駆けつけてくれる。"},{"spoiler":false,"text":"二人だけの時には仮面を外して、その素顔を見せることも……？"}],"source":"egs","sourceCharacterId":"3812","sourceWorkId":"20152","spoiler":false},{"segments":[{"spoiler":false,"text":"戴着神秘面具的青之国度キャロル的骑士队长。"},{"spoiler":false,"text":"将扑克牌里的长枪当作武器，沉默而勇敢的身影得到了部下深厚的信赖。"},{"spoiler":false,"text":"与アリス是长年的挚友，只要是她出现危机，无论什么时候都会飒爽地赶过来。"},{"spoiler":false,"text":"两人独处时会摘下面具，露出本来面目？"},{"spoiler":false,"text":"「退下アリス，后面交给我」"}],"source":"bangumi","sourceCharacterId":"26335"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf77052bfbbd61423b61662cb1d8a9713c8046cfa3b6ae25e9714505cb8a9e3d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35a3d07f000d79a23e69d6085aa71550aace60f12d046396b231a4f55f1c4561.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"河原木志穂","creatorId":"vndb:s13","sourcePersonId":"vndb:s13","canonicalEntityId":"vndb:s13","name":"河原木 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:94395:26335:4422:1","source":"bangumi"}]},{"characterId":"char_c22099","characterName":"メイ ブランシェット","sourceIds":{"bangumi":[{"characterId":"26336","match":"exact-normalized-name-in-linked-work","subjectId":"94395"}],"egsCharacterIds":["3813"],"vndbCharacterId":"c22099"},"originalCharacterName":"メイ ブランシェット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"赤の国ペローの天才科学者。またの名を「変態科学者」。"},{"spoiler":false,"text":"思考と感性が最先端過ぎて、周りの理解を得られず孤立しがち。"},{"spoiler":false,"text":"そのせいで態度が超偉そうになっているが、自分を馬鹿にしないアマラにだけは心を開いている。"},{"spoiler":false,"text":"頭にかぶっているのは万能帽子「AKA-ZUKIN」。"},{"spoiler":false,"text":"手の部分が形状記憶合金になっており、自在に変形させることができる。"}],"source":"egs","sourceCharacterId":"3813","sourceWorkId":"20152","spoiler":false},{"segments":[{"spoiler":false,"text":"赤之国度ペロー的天才科学家。还有个名字是“变态科学家”。"},{"spoiler":false,"text":"思考与感性过于前卫，得不到周围的理解而经常处于孤立状态。"},{"spoiler":false,"text":"因此尽管态度非常傲慢，但是唯独向不小看自己的アマラ敞开心扉。"},{"spoiler":false,"text":"头上戴着的是万能帽子『AKA-ZUKIN』。"},{"spoiler":false,"text":"手的部分是形状记忆合金，能够自由变形。"},{"spoiler":false,"text":"「只要有我这个天才出马就没有不可能的事情！」"}],"source":"bangumi","sourceCharacterId":"26336"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a8f5ff38b293980f78e19bd14dcb7cfb979706df512b3320a47b7a16b94bb6c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9d4b3107fe81b9cded2a15ee38f60bacf7bd5c03ac86405f61ff9a2881cf280.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"尾崎真実","creatorId":"vndb:s199","sourcePersonId":"vndb:s199","canonicalEntityId":"vndb:s199","name":"尾崎 真実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:94395:26336:8165:1","source":"bangumi"}]},{"characterId":"char_c22100","characterName":"アマラ ウルフ","sourceIds":{"bangumi":[{"characterId":"26337","match":"exact-normalized-name-in-linked-work","subjectId":"94395"}],"egsCharacterIds":["3814"],"vndbCharacterId":"c22100"},"originalCharacterName":"アマラ ウルフ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"軍の最高司令官であり赤の国ペローのブックマーカー。"},{"spoiler":false,"text":"射撃戦を得意とし、狙った獲物は確実に仕留めてのける。"},{"spoiler":false,"text":"勇敢で判断力に優れているが、熱くなると我を忘れてしまう欠点も。"},{"spoiler":false,"text":"自分にはない発想力をもつメイのことを面白がって、なにかと気にかけてやっていた。"},{"spoiler":false,"text":"さばさばとして男勝りな振る舞いから、部下たちにお姉さまとして慕われているが、本人はそんな自分の性格を気にしており、女の子らしくなりたいと密かに願っている。"}],"source":"egs","sourceCharacterId":"3814","sourceWorkId":"20152","spoiler":false},{"segments":[{"spoiler":false,"text":"军队最高司令官，赤之国度ペロー的书主（Bookmarker）。"},{"spoiler":false,"text":"擅长射击战，能够准确无误射中猎物。"},{"spoiler":false,"text":"尽管勇敢并且有优秀的判断力，然而也有一旦焦躁就会忘我的缺点。"},{"spoiler":false,"text":"觉得拥有自己所缺乏的想象力的メイ有趣，关注她的一举一动。"},{"spoiler":false,"text":"大大咧咧的汉子般的举止，被部下视作大姐头而仰慕着，然而本人很在意自己这样的性格，暗地里希望自己能够变得有女人味。"},{"spoiler":false,"text":"「噢，好哎～、打架的话随时奉陪」"}],"source":"bangumi","sourceCharacterId":"26337"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/6303a35f403d47a0e5fe005bbad7aa0ffde1a0b1d513158917d654ee5367c8a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43fa1a281cfe91e151e0330d6c807e04ee8867ccd2cb21a10ab71de3c88fb819.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:94395:26337:4937:1","source":"bangumi"}]},{"characterId":"char_c22101","characterName":"ヘンゼル クラム","sourceIds":{"bangumi":[{"characterId":"26338","match":"exact-normalized-name-in-linked-work","subjectId":"94395"}],"egsCharacterIds":["3815"],"vndbCharacterId":"c22101"},"originalCharacterName":"ヘンゼル クラム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"緑の国グリムの双子の書主（ブックマーカー）の一人。"},{"spoiler":false,"text":"グレーテルの姉であり、ヤーコプ魔術学園の会長を務める。"},{"spoiler":false,"text":"この国を支配していた悪しき魔女を倒した勇者として、人々に絶大な信頼と人気を誇っている。"},{"spoiler":false,"text":"自ら「勇者会長」と名乗るが、すぐに仕事をさぼったり、言動素行のノリが軽いため、お調子者とみられがち。"},{"spoiler":false,"text":"が、当人はあえて奔放に振る舞うことで「勇者」という肩書きのもつ重みを消してやろうと考えているらしい。"}],"source":"egs","sourceCharacterId":"3815","sourceWorkId":"20152","spoiler":false},{"segments":[{"spoiler":false,"text":"绿之国度グリム的双胞胎书主（Bookmarker）之一。"},{"spoiler":false,"text":"グレーテル的姐姐，担任着ヤーコプ魔术学园的会长。"},{"spoiler":false,"text":"作为打倒了支配这个国度的坏蛋魔女的勇者，获得人民极大的信赖与人气。"},{"spoiler":false,"text":"自称“勇者会长”，因为经常丢下工作，言行轻佻，所以被人认为不可靠。"},{"spoiler":false,"text":"不过，本人似乎是想通过奔放的风格来消除“勇者”这样沉重的头衔。"},{"spoiler":false,"text":"「你好你好，我是勇者会长ヘンゼル妹～子！」"}],"source":"bangumi","sourceCharacterId":"26338"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80f09dfca2df202a7d69aa82197dc598db44737c7525c0053ea8d108d474b4d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e495970f0a7fef9417b70ad37f720623cf7f9d7e6723ff97d50f5c20afff88a8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:94395:26338:5052:1","source":"bangumi"}]},{"characterId":"char_c22102","characterName":"グレーテル クラム","sourceIds":{"bangumi":[{"characterId":"26339","match":"exact-normalized-name-in-linked-work","subjectId":"94395"}],"egsCharacterIds":["3816"],"vndbCharacterId":"c22102"},"originalCharacterName":"グレーテル クラム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"緑の国グリムの双子の書主（ブックマーカー）の一人。"},{"spoiler":false,"text":"ヘンゼルの妹であり、ヤーコプ魔術学園の副会長を務める。"},{"spoiler":false,"text":"めんどうくさがりな姉を叱りつつ、学園の様々な仕事をてきぱきとこなす才媛。魔法の才能にも優れており、悪しき魔女との戦いでは献身的に姉を助けた。が、その力のせいで幼少時には魔女の同族として差別されていたというトラウマがあり、姉以外の相手には慇懃無礼な態度をとってしまい、なかなか心を開けない。"}],"source":"egs","sourceCharacterId":"3816","sourceWorkId":"20152","spoiler":false},{"segments":[{"spoiler":false,"text":"緑之国度グリム的双胞胎书主（Bookmarker）之一。"},{"spoiler":false,"text":"ヘンゼル的妹妹，担任着ヤーコプ魔术学园的副会长。"},{"spoiler":false,"text":"一边叱责着怕麻烦的姐姐，一边一手一脚完成学园各种工作的才女。"},{"spoiler":false,"text":"魔法的才能也很优秀，在与坏蛋魔女的战斗中奋身协助姐姐。"},{"spoiler":false,"text":"然而，因为这份力量，自小被当作魔女的同族而受到歧视，这份精神障碍让她对姐姐以外的人表现出口是心非的态度，不怎么打开心扉。"},{"spoiler":false,"text":"「为什么姐姐会这样白痴？」"}],"source":"bangumi","sourceCharacterId":"26339"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9a2b89956b8043a43546317620a3e722aa80ba08aac81b8934733b388cce592.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35466092000de07b9623e7eadc5a524681ef32092cb9bb2766d94a7914949d0d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:94395:26339:4646:1","source":"bangumi"}]},{"characterId":"char_c22103","characterName":"アリババ ラシード","sourceIds":{"bangumi":[{"characterId":"26340","match":"exact-normalized-name-in-linked-work","subjectId":"94395"}],"egsCharacterIds":["3817"],"vndbCharacterId":"c22103"},"originalCharacterName":"アリババ ラシード","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"黄の国の「書主」にして大商隊を束ねる若き女族長。一人称はボク。"},{"spoiler":false,"text":"ロマンと冒険をこよなく愛し、常にお宝や儲け話に対するアンテナを張っている。"},{"spoiler":false,"text":"性格はさっぱりとしていて陽気で元気。"},{"spoiler":false,"text":"が、商人としての手練手管は抜け目ないものであり、様々な駆け引きや周囲への気配りといった形でその才能を発揮する。"},{"spoiler":false,"text":"砂漠で出会ったアキトたち一行に冒険の予感を感じとり、行動を共にすることに。"},{"spoiler":false,"text":"意見のまとめ役として場をしきることが多い。武器はブーメラン。"}],"source":"egs","sourceCharacterId":"3817","sourceWorkId":"20152","spoiler":false},{"segments":[{"spoiler":false,"text":"黄之国度的书主（Bookmarker），管束大商队的年轻女族长。第一人称是ボク。"},{"spoiler":false,"text":"深爱浪漫与冒险，经常伸出探寻宝物宝藏的触角。"},{"spoiler":false,"text":"性格豪爽阳光活泼。"},{"spoiler":false,"text":"但是，作为商人来说，手段花招毫无破绽，使出各种策略并笼络周围的人，尽展所长。"},{"spoiler":false,"text":"在沙漠遇见アキト一行时感到冒险的预感，开始与他们一起行动。"},{"spoiler":false,"text":"经常作为意见的归纳者主持大局。武器是回飞镖。"},{"spoiler":false,"text":"「好厉害啊那东西！充满了浪漫，简直就是最棒啊！！」"}],"source":"bangumi","sourceCharacterId":"26340"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee9af65883ddf02f65f2b24e59e2a5ffec1155e378b952b50e5e5f746d0b75f4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb90a3ad2e6df6b52992c950ce57a7660d2df2b71c956c8b0a9407e367b9e191.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林桂子","creatorId":"vndb:s443","sourcePersonId":"vndb:s443","canonicalEntityId":"vndb:s443","name":"美月(声優)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:94395:26340:16180:1","source":"bangumi"}]},{"characterId":"char_c22104","characterName":"吉備 桃子","sourceIds":{"bangumi":[{"characterId":"26341","match":"exact-normalized-name-in-linked-work","subjectId":"94395"}],"egsCharacterIds":["3818"],"vndbCharacterId":"c22104"},"originalCharacterName":"吉備 桃子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"日本の昔話のような雰囲気をもつ白の国の書主にして、幼い鬼のお姫さま。まだ地位を継承して日が浅く、かんしゃくを起こしては城を飛び出してしまう。"},{"spoiler":false,"text":"アキトたちはその折りに出会い、トラブルを巻き起こすこととなる。"},{"spoiler":false,"text":"両親とは死別しており、伯父や三忠臣に支えられて責務を果たしているのだが、実力の無さを自身が一番痛感しており、思い悩んで小さな胸を痛め続けている。まだ未熟ながらも「吉備之焔（きびのほむら）」という浄化の術を会得している。"}],"source":"egs","sourceCharacterId":"3818","sourceWorkId":"20152","spoiler":false},{"segments":[{"spoiler":false,"text":"拥有日本古老故事般的氛围的白之国度的书主（Bookmarker），年幼的鬼公主。"},{"spoiler":false,"text":"继承地位的日子尚浅，发脾气离开了主城。"},{"spoiler":false,"text":"因此与アキト一行相遇，引发了麻烦事。"},{"spoiler":false,"text":"与父母死别，在伯父与三忠臣的支持下尽职尽责，但是最内疚的是自身没有实力，小小的胸口一直怀着苦恼与痛苦。"},{"spoiler":false,"text":"尽管还不能独当一面，不过懂得名为“吉備之焔（きびのほむら）”的净化术。"},{"spoiler":false,"text":"「我的名字不是你，而是桃子！快低下头来，你这区区平民」"}],"source":"bangumi","sourceCharacterId":"26341"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/639a612244967524a70872d644955fbc3944a28d6aa9ec1d8d0c21893d41ece5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d71b44c8c087f33253f0f196f9c72bc1171413307e8676cf0648a1c5f2f788d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"種﨑敦美","creatorId":"vndb:s196","sourcePersonId":"vndb:s196","canonicalEntityId":"vndb:s196","name":"種﨑 敦美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:94395:26341:7575:1","source":"bangumi"}]},{"characterId":"char_c22105","characterName":"夢童 アキト","sourceIds":{"bangumi":[{"characterId":"26333","match":"exact-normalized-name-in-linked-work","subjectId":"94395"}],"egsCharacterIds":["3810"],"vndbCharacterId":"c22105"},"originalCharacterName":"夢童 アキト","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"目つきのせいで勘違いされやすいが、正義感が強くて優しい青年。"},{"spoiler":false,"text":"両親は事故で他界しており、今は幼い妹と二人暮らし。"},{"spoiler":false,"text":"心を閉ざしてしまった妹のために、大好きだった絵本を読み聞かせているさなか、意識を失い、メルトピアの世界にのみこまれてしまう。"},{"spoiler":false,"text":"アリスたちの助けを受けながら元の世界に戻る方法を探すことになる。"}],"source":"egs","sourceCharacterId":"3810","sourceWorkId":"20152","spoiler":false},{"segments":[{"spoiler":false,"text":"本作的主人公。"},{"spoiler":false,"text":"因为眼神而经常让人产生误会，其实是个正义感很强的温柔青年。"},{"spoiler":false,"text":"父母因为事故而离世，现在与年幼的妹妹过着两人生活。"},{"spoiler":false,"text":"为了关闭心扉的妹妹，对着她阅读以前很喜欢的图画书之际，失去了意识被メルトピア的世界所吞噬。"},{"spoiler":false,"text":"一边接受アリス等人的帮助，一边寻找回到原本的世界的方法。"},{"spoiler":false,"text":"「别把我跟你们这些虚构人物当作同类……」"},{"spoiler":false,"text":"☆何谓司书（Libra）？"},{"spoiler":false,"text":"对于这个世界可说是传说般的人物。位置在所有故事的最上位，是守护世界均衡的救世主。"},{"spoiler":false,"text":"据说发言能够改变所有故事的剧情发展。"},{"spoiler":false,"text":"アリス猜测アキト可能是司书。"}],"source":"bangumi","sourceCharacterId":"26333"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12b1afa347f0bd3b43c1e24002b830d1e0eabb44501c4fddd8bfa349656df65f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aabbbde2a217a8f24239c2b06462f00c5a8011f779553c4eb6bc8fde7d076a04.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c107868","characterName":"Mudou Yui","sourceIds":{"vndbCharacterId":"c107868"},"originalCharacterName":"Mudou Yui","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:4158","sourceCompanyId":"egs:brand:4158","canonicalEntityId":"egs:brand:4158","name":"side-B(2014年-)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:20152:4158","source":"egs"},{"companyId":"vndb:p4113","sourceCompanyId":"vndb:p4113","canonicalEntityId":"vndb:p4113","name":"Side-B","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:36925:v14521","source":"vndb"},{"companyId":"vndb:p4113","sourceCompanyId":"vndb:p4113","canonicalEntityId":"vndb:p4113","name":"Side-B","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:40126:v14521","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
