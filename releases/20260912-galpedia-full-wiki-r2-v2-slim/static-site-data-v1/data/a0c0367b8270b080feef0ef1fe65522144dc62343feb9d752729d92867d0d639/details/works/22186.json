{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"22186","model":{"presentationWorkId":"egs:22186","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_10588","characterName":"周瑜","sourceIds":{"bangumi":[{"characterId":"10588","match":"source-roster","subjectId":"135172"},{"characterId":"10588","match":"source-roster","subjectId":"144422"},{"characterId":"10588","match":"source-roster","subjectId":"14463"},{"characterId":"10588","match":"source-roster","subjectId":"162447"},{"characterId":"10588","match":"source-roster","subjectId":"188516"},{"characterId":"10588","match":"source-roster","subjectId":"216765"},{"characterId":"10588","match":"source-roster","subjectId":"216766"},{"characterId":"10588","match":"source-roster","subjectId":"2409"},{"characterId":"10588","match":"source-roster","subjectId":"375912"},{"characterId":"10588","match":"source-roster","subjectId":"450504"},{"characterId":"10588","match":"source-roster","subjectId":"71125"}]},"originalCharacterName":"周瑜","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"字公谨 （こうきん）。"},{"spoiler":false,"text":"吴的大军师，孙策的好友。统帅文武百官的吴之柱石。"},{"spoiler":false,"text":"从「理」与「利」的角度判断事物的现实主义者。不过因为有着能理解幽默的能力，意外地也有着诙谐的一面。"},{"spoiler":false,"text":"深爱着孙策、深爱着吴国，胸中暗藏激情的女性。"},{"spoiler":false,"text":"看透了一刀本质中的才能，在许多事情上行了方便，与黄盖一起主动促进一刀的成长。"},{"spoiler":false,"text":"「为了实现孙吴的天下，赌上我全部的才能。……伯符。我一定会让你成为天下人」"}],"source":"bangumi","sourceCharacterId":"10588"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7feb2ce7692331082b8a84518b3f04e1cb339c37b393f55d2dfa4eaaf1cde798.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fb532cabb441ea70dd1be1d76e7bacede4f8a6828f094fed4fc7cdefec1c9b8.webp","width":251,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_22899","characterName":"华琳","sourceIds":{"bangumi":[{"characterId":"22899","match":"source-roster","subjectId":"129020"},{"characterId":"22899","match":"source-roster","subjectId":"135172"},{"characterId":"22899","match":"source-roster","subjectId":"14463"},{"characterId":"22899","match":"source-roster","subjectId":"162447"},{"characterId":"22899","match":"source-roster","subjectId":"188516"},{"characterId":"22899","match":"source-roster","subjectId":"216765"},{"characterId":"22899","match":"source-roster","subjectId":"216766"},{"characterId":"22899","match":"source-roster","subjectId":"2409"},{"characterId":"22899","match":"source-roster","subjectId":"289734"},{"characterId":"22899","match":"source-roster","subjectId":"364764"},{"characterId":"22899","match":"source-roster","subjectId":"375912"},{"characterId":"22899","match":"source-roster","subjectId":"409322"},{"characterId":"22899","match":"source-roster","subjectId":"430332"},{"characterId":"22899","match":"source-roster","subjectId":"450504"},{"characterId":"22899","match":"source-roster","subjectId":"530380"},{"characterId":"22899","match":"source-roster","subjectId":"71125"}]},"originalCharacterName":"华琳","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魏国主公。不折不扣的女王，为人孤傲少话。在第三话遇到关羽，喜爱关羽一头黑发。"}],"source":"bangumi","sourceCharacterId":"22899"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/2842b4123f6266829b22cbc28f9c1fef0d7ce8c0268f16a82b17014e613ffc55.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wi