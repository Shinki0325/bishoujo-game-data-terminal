.webp","width":92,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c19305","characterName":"夏侯淵 妙才","sourceIds":{"bangumi":[{"characterId":"22901","match":"exact-normalized-name-in-linked-work","subjectId":"129020"},{"characterId":"22901","match":"source-roster","subjectId":"129020"},{"characterId":"22901","match":"exact-normalized-name-in-linked-work","subjectId":"135172"},{"characterId":"22901","match":"source-roster","subjectId":"135172"},{"characterId":"22901","match":"exact-normalized-name-in-linked-work","subjectId":"14463"},{"characterId":"22901","match":"source-roster","subjectId":"14463"},{"characterId":"22901","match":"source-roster","subjectId":"162447"},{"characterId":"22901","match":"source-roster","subjectId":"188516"},{"characterId":"22901","match":"source-roster","subjectId":"216765"},{"characterId":"22901","match":"source-roster","subjectId":"216766"},{"characterId":"22901","match":"exact-normalized-name-in-linked-work","subjectId":"2409"},{"characterId":"22901","match":"source-roster","subjectId":"2409"},{"characterId":"22901","match":"source-roster","subjectId":"289734"},{"characterId":"22901","match":"source-roster","subjectId":"364764"},{"characterId":"22901","match":"source-roster","subjectId":"375912"},{"characterId":"22901","match":"source-roster","subjectId":"409322"},{"characterId":"22901","match":"source-roster","subjectId":"430332"},{"characterId":"22901","match":"source-roster","subjectId":"71125"}],"egsCharacterIds":["4096"],"vndbCharacterId":"c19305"},"originalCharacterName":"夏侯淵 妙才","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"As Karin's cousin and Shunran's younger sister, she is one of Gi's generals."}],"source":"vndb","sourceCharacterId":"c19305"},{"segments":[{"spoiler":false,"text":"夏侯惇の双子の妹にして曹操の愛人。そして曹操の片腕の武人。姉、夏侯惇と共に身も心も曹操に捧げている。"},{"spoiler":false,"text":"姉とは違い、常に冷静沈着。ブレーキの壊れたトラックのように暴走する夏侯惇を、クールに補佐している。"}],"source":"egs","sourceCharacterId":"4096","sourceWorkId":"11334","spoiler":false},{"segments":[{"spoiler":false,"text":"魏の制御棒にして自制心にして縁の下の力持ち的ポジションの秋蘭。"},{"spoiler":false,"text":"今作でも、地味めなポジションながらキラリと光る いぶし銀な活躍を見せている。"},{"spoiler":false,"text":"しかし姉者との喧嘩の行く末は、一体どうなってしまうのだろうか……！"}],"source":"egs","sourceCharacterId":"4096","sourceWorkId":"13835","spoiler":false},{"segments":[{"spoiler":false,"text":"魏の武将で弓の名手。"},{"spoiler":false,"text":"夏候惇の双子の妹にして、その補佐役。"},{"spoiler":false,"text":"心と身体、すべてを曹操に捧げている。"},{"spoiler":false,"text":"常に冷静沈着。飄々と姉をサポートしているが、実は気苦労が多い。"},{"spoiler":false,"text":"必殺技：「一矢一殺」「伏撃射」「魏武の閃光」"},{"spoiler":false,"text":"夢想†奥義：「虎狼の雄叫び」"},{"spoiler":false,"text":"夢想†秘奥義：「弓箭繚乱」"}],"source":"egs","sourceCharacterId":"4096","sourceWorkId":"18595","spoiler":false},{"segments":[{"spoiler":false,"text":"春蘭の双子の妹でその良き補佐役。"},{"spoiler":false,"text":"クールで飄々とした性格だが本気で怒らせるととても怖いらしい。"},{"spoiler":false,"text":"武者揃いの魏将たちの自制心であり、縁の下の力持ちポジション。"},{"spoiler":false,"text":"今回は姉に付き合って北郷隊に新兵として入隊することに。"},{"spoiler":false,"text":"北郷隊の運命を握っているのは彼女かもしれない。"}],"source":"egs","sourceCharacterId":"4096","sourceWorkId":"21440","spoiler":false},{"segments":[{"spoiler":false,"text":"初代："},{"spoiler":false,"text":"夏候惇的孪生妹妹。辅佐着像坏了刹车的卡车般暴走的夏候惇。"},{"spoiler":false,"text":"与夏候惇一样，是曹操的表姐兼爱人。与姐姐一样全部都奉献给曹操。"},{"spoiler":false,"text":"本来为人轻浮，然而为了支援直线型的姐姐，实际上承受了更多的苦难。有“罢了罢了，姐姐会……”的口头禅。"},{"spoiler":false,"text":"真恋姬："},{"spoiler":false,"text":"夏侯惇的双胞胎妹妹&曹操的爱人。也是曹操倚为左右手的武人。"},{"spoiler":false,"text":"与姐姐・夏侯惇一起将其身心都献给了曹操。"},{"spoiler":false,"text":"与姐姐不同，总是能保持冷静沉着。酷酷地辅佐着仿佛坏掉了刹车的卡车一般暴走的夏侯惇。"},{"spoiler":false,"text":"虽然貌似悠然地支援着姐姐，但其实其中辛劳有谁知。"},{"spoiler":false,"text":"然而，从心底里深爱着老是给她添麻烦的姐姐。"}],"source":"bangumi","sourceCharacterId":"22901"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b77b2facb0f8e1e07d060fdcb149ec5038f360ee230f20a4bee29219e5e00b1d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eedc388a043350c46feafd6c595d877092069d28019aff3073ed1e9e7e4b58ca.webp","width":202,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c19306","characterName":"桂花","sourceIds":{"bangumi":[{"characterId":"22898","match":"exact-normalized-name-in-linked-work","subjectId":"129020"},{"characterId":"22898","match":"source-roster","subjectId":"129020"},{"characterId":"22898","match":"exact-normalized-name-in-linked-work","subjectId":"135172"},{"characterId":"22898","match":"source-roster","subjectId":"135172"},{"characterId":"22898","match":"exact-normalized-name-in-linked-work","subjectId":"14463"},{"characterId":"22898","match":"source-roster","subjectId":"14463"},{"characterId":"22898","match":"source-roster","subjectId":"162447"},{"characterId":"22898","match":"source-roster","subjectId":"188516"},{"characterId":"22898","match":"source-roster","subjectId":"216765"},{"characterId":"22898","match":"source-roster","subjectId":"216766"},{"characterId":"22898","match":"exact-normalized-name-in-linked-work","subjectId":"2409"},{"characterId":"22898","match":"source-roster","subjectId":"2409"},{"characterId":"22898","match":"source-roster","subjectId":"289734"},{"characterId":"22898","match":"source-roster","subjectId":"364764"},{"characterId":"22898","match":"source-roster","subjectId":"375912"},{"characterId":"22898","match":"source-roster","subjectId":"409322"},{"characterId":"22898","match":"source-roster","subjectId":"430332"},{"characterId":"22898","match":"source-roster","subjectId":"450504"},{"characterId":"22898","match":"source-roster","subjectId":"71125"}],"egsCharacterIds":["4097"],"vndbCharacterId":"c19306"},"originalCharacterName":"桂花","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The strategist of the Gi kingdom. Out of all of Sousou's subordinates, she is most likely the one who enjoys being teased by her the most. Hates Kazuto."}],"source":"vndb","sourceCharacterId":"c19306"},{"segments":[{"spoiler":false,"text":"曹操の王としての器、天運、才能に惚れ込み、全てを捧げる少女。"},{"spoiler":false,"text":"罵られても、苛められても、それが快感に繋がるド変態ではあるのだが、その対象は曹操一人。"}],"source":"egs","sourceCharacterId":"4097","sourceWorkId":"11334","spoiler":false},{"segments":[{"spoiler":false,"text":"魏の丞相にして、華琳の犬。"},{"spoiler":false,"text":"今作では各陣営の貧ニューズと貧乳の誓いを結び、"},{"spoiler":false,"text":"巨乳人撲滅に向けて秘策を練っているらしい。"}],"source":"egs","sourceCharacterId":"4097","sourceWorkId":"13835","spoiler":false},{"segments":[{"spoiler":false,"text":"曹操に絶対の忠誠を誓い、すべてを捧げる魏の軍師。"},{"spoiler":false,"text":"その智謀は、諸葛亮に勝るとも劣らない。"},{"spoiler":false,"text":"バカな人間が大嫌いで夏候惇を目の敵にしているが、曹操を想うあまりの思い込みと暴走ぶりは夏候惇と五十歩百歩。"},{"spoiler":false,"text":"※曹操・夏候惇・夏候淵のみ選択可能"}],"source":"egs","sourceCharacterId":"4097","sourceWorkId":"18595","spoiler":false},{"segments":[{"spoiler":false,"text":"魏の丞相にして、華琳に全てを捧げる犬（ペット）。"},{"spoiler":false,"text":"虐められると悦んでしまうド変態だが華琳以外にはツン１００％。"},{"spoiler":false,"text":"華琳にまとわりつく一刀のことを目の敵にしている。"},{"spoiler":false,"text":"しかしそんな大ッ嫌い（？）な一刀の子を宿していることが、発覚したからもう大変！　マタニティライフは波瀾必至！？"}],"source":"egs","sourceCharacterId":"4097","sourceWorkId":"21440","spoiler":false},{"segments":[{"spoiler":false,"text":"荀彧（Xún Yù），字文若。曹操的重要谋士，智谋堪比孔明，有轻微的妄想症，对自己的贫乳有点在意。喜爱曹操。"}],"source":"bangumi","sourceCharacterId":"22898"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"22898","value":"魏军"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1de68ed7d527c9ff146c8993ed9f54f428b20bb9d6625b4a455310a9ea4716d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b8d191307a5c87123054298314061ed1867ed76f125a1ab73fa24bb84b0e2b9.webp","width":102,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c203","characterName":"張飛 翼徳","sourceIds":{"bangumi":[{"characterId":"11050","match":"exact-normalized-name-in-linked-work","subjectId":"129020"},{"characterId":"11050","match":"source-roster","subjectId":"129020"},{"characterId":"11050","match":"exact-normalized-name-in-linked-work","subjectId":"135172"},{"characterId":"11050","match":"source-roster","subjectId":"135172"},{"characterId":"11050","match":"exact-normalized-name-in-linked-work","subjectId":"14463"},{"characterId":"11050","match":"source-roster","subjectId":"14463"},{"characterId":"11050","match":"source-roster","subjectId":"162447"},{"characterId":"11050","match":"source-roster","subjectId":"188516"},{"characterId":"11050","match":"source-roster","subjectId":"216765"},{"characterId":"11050","match":"source-roster","subjectId":"216766"},{"characterId":"11050","match":"exact-normalized-name-in-linked-work","subjectId":"2409"},{"characterId":"11050","match":"source-roster","subjectId":"2409"},{"characterId":"11050","match":"source-roster","subjectId":"375912"},{"characterId":"11050","match":"source-roster","subjectId":"409322"},{"characterId":"11050","match":"source-roster","subjectId":"71125"}],"egsCharacterIds":["4090"],"vndbCharacterId":"c203"},"originalCharacterName":"張飛 翼徳","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chouhi joins Kazuto along with Kan'u after the two discover him together. Unlike Kan'u, who holds a more reserved master-servant-like relationship with Kazuto, she treats Kazuto like an older sibling and calls him \"big brother,\" similar to how she treats Kan'u."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c203"},{"segments":[{"spoiler":false,"text":"劉備・関羽と共に、弱い人たちを少しでも助けたいと旅をしている少女。"},{"spoiler":false,"text":"粗野な振る舞いが目立つが、それも子供ゆえ。本当は甘えん坊である。"}],"source":"egs","sourceCharacterId":"4090","sourceWorkId":"11334","spoiler":false},{"segments":[{"spoiler":false,"text":"蜀一番の元気印の鈴々も、少しは大人に……なるわけもなく。相変わらず、翠とつるんでいるらしい。"},{"spoiler":false,"text":"季衣とは仲が悪いような……見方によっては仲が良いような、そんな関係。"},{"spoiler":false,"text":"そろそろ恋する乙女の意識が発露してきているらしい……？"}],"source":"egs","sourceCharacterId":"4090","sourceWorkId":"13835","spoiler":false},{"segments":[{"spoiler":false,"text":"弱い人たちを助けるために関羽と共に旅をしている。"},{"spoiler":false,"text":"関羽と互角の力があるが、如何せん子供なため、よく失敗したり関羽に怒られたりしている。"},{"spoiler":false,"text":"めちゃくちゃ食いしん坊で、大食漢。"},{"spoiler":false,"text":"必殺技：「突撃敢行」「猛虎の撃」「猛虎粉砕撃」"},{"spoiler":false,"text":"夢想†奥義：「蛇矛槍打」"},{"spoiler":false,"text":"夢想†秘奥義：「堅固防遏」"}],"source":"egs","sourceCharacterId":"4090","sourceWorkId":"18595","spoiler":false},{"segments":[{"spoiler":false,"text":"関羽と並び称される元気印の蜀の豪傑。"},{"spoiler":false,"text":"突撃粉砕勝利が合言葉の鉄砲玉娘。"},{"spoiler":false,"text":"相変わらずのペタンコ。"}],"source":"egs","sourceCharacterId":"4090","sourceWorkId":"21440","spoiler":false},{"segments":[{"spoiler":false,"text":"初代："},{"spoiler":false,"text":"与関羽一起，一刀在刚开始时所会面的少女。"},{"spoiler":false,"text":"明明还是个小孩子，却挥舞着一把比身高要长几倍的蛇矛砍倒敌人的烈火美少女。是个能与関羽匹敌的豪杰，奈何还是个小孩子，时而因为恶作剧而被関羽怒叱。尽管如此她还是非常冷静，原本也是个爱撒娇的孩子。"},{"spoiler":false,"text":"她还会与离战场以外不远的地方的孩子们一起玩耍，抓抓虫子什么的，拥有着与年龄相符的一面。"},{"spoiler":false,"text":"真恋姬："},{"spoiler":false,"text":"与刘备・关羽一同，想要尽可能多地帮助弱者们而进行着旅行的少女。"},{"spoiler":false,"text":"明明是个矮子，却爱用与其完全不相称的巨大巨大的蛇矛（だぼう）。"},{"spoiler":false,"text":"虽然有着足以与关羽势均力敌的武力，无奈因为还是个孩子，常常失败被关羽怒责。"},{"spoiler":false,"text":"粗鲁的言行十分扎眼，但那也是因为还是个孩子。其实是个撒娇鬼。"},{"spoiler":false,"text":"然而，十分讨厌被当成孩子对待。"}],"source":"bangumi","sourceCharacterId":"11050"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0ee1b42422d8e302da6a6cc71e433f7a24df06c6298749c3d9ff752a787a0a31.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb46031829357140fee657db7401d9bcd9e970eca8d6ae52ccf92f7a84c5650e.webp","width":133,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c217","characterName":"愛紗","sourceIds":{"bangumi":[{"characterId":"22864","match":"exact-normalized-name-in-linked-work","subjectId":"129020"},{"characterId":"22864","match":"source-roster","subjectId":"129020"},{"characterId":"22864","match":"exact-normalized-name-in-linked-work","subjectId":"135172"},{"characterId":"22864","match":"source-roster","subjectId":"135172"},{"characterId":"22864","match":"exact-normalized-name-in-linked-work","subjectId":"14463"},{"characterId":"22864","match":"source-roster","subjectId":"14463"},{"characterId":"22864","match":"source-roster","subjectId":"162447"},{"characterId":"22864","match":"source-roster","subjectId":"162783"},{"characterId":"22864","match":"source-roster","subjectId":"188516"},{"characterId":"22864","match":"source-roster","subjectId":"208774"},{"characterId":"22864","match":"exact-normalized-name-in-linked-work","subjectId":"214099"},{"characterId":"22864","match":"source-roster","subjectId":"214099"},{"characterId":"22864","match":"source-roster","subjectId":"216765"},{"characterId":"22864","match":"source-roster","subjectId":"216766"},{"characterId":"22864","match":"exact-normalized-name-in-linked-work","subjectId":"2409"},{"characterId":"22864","match":"source-roster","subjectId":"2409"},{"characterId":"22864","match":"source-roster","subjectId":"364764"},{"characterId":"22864","match":"source-roster","subjectId":"409322"},{"characterId":"22864","match":"source-roster","subjectId":"430332"},{"characterId":"22864","match":"source-roster","subjectId":"450504"},{"characterId":"22864","match":"source-roster","subjectId":"71125"}],"egsCharacterIds":["4089"],"vndbCharacterId":"c217"},"originalCharacterName":"愛紗","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the main female protagonists and main heroines in the Koihime†Musou series, Kan'u shows up shortly after Kazuto is transported back in time and saves him from a group of bandits. Due to Kazuto's strange attire and manner of speech, she subsequently mistakes him to be the \"Messenger from Heaven\" and becomes the first person to vow her loyalty to him."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c217"},{"segments":[{"spoiler":false,"text":"劉備・張飛と共に庶人の暮らしを守るべく、義憤に燃えて各地を旅していた少女。"},{"spoiler":false,"text":"生真面目な性格をしており、性に対しては人一倍羞恥を感じるタイプ。"}],"source":"egs","sourceCharacterId":"4089","sourceWorkId":"11334","spoiler":false},{"segments":[{"spoiler":false,"text":"濃ゆい面子の揃っている蜀の中心人物として、日々苦労を重ねている。"},{"spoiler":false,"text":"今作では、一刀直属の近衛隊の育成に力を注ぎつつ、若手育成に精を出している。"},{"spoiler":false,"text":"相変わらず春蘭とは好敵手な関係……らしい？"}],"source":"egs","sourceCharacterId":"4089","sourceWorkId":"13835","spoiler":false},{"segments":[{"spoiler":false,"text":"庶人の暮らしを守るべく義憤に燃えて各地を旅している少女。"},{"spoiler":false,"text":"理想家で、力のない人々が平和に暮らせる世の中を作るために日々奮闘している。"},{"spoiler":false,"text":"必殺技：「闘刃」「青龍の刃」「青龍逆鱗の太刀」"},{"spoiler":false,"text":"夢想†奥義：「闘気顕現」"},{"spoiler":false,"text":"夢想†秘奥義：「戦塵颱風」"}],"source":"egs","sourceCharacterId":"4089","sourceWorkId":"18595","spoiler":false},{"segments":[{"spoiler":false,"text":"蜀の武神として大陸中にその名を馳せる武将。"},{"spoiler":false,"text":"桃香の元で一刀を補佐しつつ、若手の育成にも精を出している。苦労性なのは相変わらず。"}],"source":"egs","sourceCharacterId":"4089","sourceWorkId":"21440","spoiler":false},{"segments":[{"spoiler":false,"text":"一刀刚来到三国志世界时遇见的少女。"},{"spoiler":false,"text":"挥动那把比人的身高还要长的青龙偃月刀，将袭击一刀的盗贼赶走的豪杰。向一刀诉说收复大陆上战乱的旋涡、替天行道的愿望，发誓效忠于他。"},{"spoiler":false,"text":"是个理想家，为了让世上弱势的人们过上平和的生活而每天奋斗着。性格一本正经，属于面对H时要比别人更要难为情的类型。爱吃醋，当目睹一刀与别的女性喋喋不休的时候就会不高兴起来。但是，本人并没有发觉自己在吃醋。"}],"source":"bangumi","sourceCharacterId":"22864"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e38bb785ab48993391316c9d245a0aa029fb3c51650bc01b111c0c2b4d42763.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/977343aa7449f688340cac3162867ae99f381d32510093d81e196378853f6a02.webp","width":136,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c328","characterName":"朱里","sourceIds":{"bangumi":[{"characterId":"11051","match":"source-roster","subjectId":"129020"},{"characterId":"11051","match":"exact-normalized-name-in-linked-work","subjectId":"14463"},{"characterId":"11051","match":"source-roster","subjectId":"14463"},{"characterId":"11051","match":"source-roster","subjectId":"162447"},{"characterId":"11051","match":"source-roster","subjectId":"188516"},{"characterId":"11051","match":"source-roster","subjectId":"216765"},{"characterId":"11051","match":"source-roster","subjectId":"216766"},{"characterId":"11051","match":"exact-normalized-name-in-linked-work","subjectId":"2409"},{"characterId":"11051","match":"source-roster","subjectId":"2409"},{"characterId":"11051","match":"source-roster","subjectId":"450504"},{"characterId":"11051","match":"source-roster","subjectId":"71125"}],"egsCharacterIds":["4092"],"vndbCharacterId":"c328"},"originalCharacterName":"朱里","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"When she was evacuating a village and met Kazuto, she was impressed to see the very \"Messenger from Heaven\" helping the people. She then begs Kazuto to let her join his army, and he allows her to due to his knowledge that she was a master strategist."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c328"},{"segments":[{"spoiler":false,"text":"黄巾党の乱が発生し、それを討伐に向かった劉備たちの前に現れた少女。"},{"spoiler":false,"text":"人が傷つくことを悲しく思うような、心優しい性格をしている。"}],"source":"egs","sourceCharacterId":"4092","sourceWorkId":"11334","spoiler":false},{"segments":[{"spoiler":false,"text":"蜀の大丞相となった朱里。ヌケ気味な桃香の補佐をしながら、蜀の領土を切り盛りしている。"},{"spoiler":false,"text":"軍部の仕事を雛里に任せて政務に集中しており、一刀のフォローに生き甲斐を感じている。"},{"spoiler":false,"text":"相変わらず、艶本には目が無いらしい。"}],"source":"egs","sourceCharacterId":"4092","sourceWorkId":"13835","spoiler":false},{"segments":[{"spoiler":false,"text":"鳳統と並び「伏龍」と称される名軍師。"},{"spoiler":false,"text":"温厚で少し引っ込み思案だが、人が傷つくことを悲しく思うような心優しい性格をしている。"},{"spoiler":false,"text":"焦ったり困ったりした時の口癖から「はわわ軍師」と呼ばれている。"},{"spoiler":false,"text":"※関羽・張飛・趙雲のみ選択可能"}],"source":"egs","sourceCharacterId":"4092","sourceWorkId":"18595","spoiler":false},{"segments":[{"spoiler":false,"text":"字孔明（こうめい）。"},{"spoiler":false,"text":"想要将自己的能力（智谋）奉献给让这个世界变得尽可能美好的事业，加入刘备阵营的少女。"},{"spoiler":false,"text":"黏上了从歹徒手中救她一命的主人公，变得在所有方面都对他尽心服侍。"},{"spoiler":false,"text":"性格温厚，有一点内向，但又有着悲伤于世人被伤害的慈悲心肠。相当的天然系。"},{"spoiler":false,"text":"喜欢料理，料理手艺相当高。"}],"source":"bangumi","sourceCharacterId":"11051"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/745eae2f51d357f041409169988f303bb48b7634c3ec7a354888d85b729f60f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f26a4dea1d29f4947ca75bf7d0bfadf606a0e27af7fc24e6fbfb455d81a65947.webp","width":131,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c329","characterName":"星","sourceIds":{"bangumi":[{"characterId":"22905","match":"source-roster","subjectId":"129020"},{"characterId":"22905","match":"exact-normalized-name-in-linked-work","subjectId":"14463"},{"characterId":"22905","match":"source-roster","subjectId":"14463"},{"characterId":"22905","match":"source-roster","subjectId":"162447"},{"characterId":"22905","match":"source-roster","subjectId":"188516"},{"characterId":"22905","match":"source-roster","subjectId":"214099"},{"characterId":"22905","match":"source-roster","subjectId":"216765"},{"characterId":"22905","match":"source-roster","subjectId":"216766"},{"characterId":"22905","match":"exact-normalized-name-in-linked-work","subjectId":"2409"},{"characterId":"22905","match":"source-roster","subjectId":"2409"},{"characterId":"22905","match":"source-roster","subjectId":"375912"},{"characterId":"22905","match":"source-roster","subjectId":"409322"},{"characterId":"22905","match":"source-roster","subjectId":"450504"},{"characterId":"22905","match":"source-roster","subjectId":"71125"}],"egsCharacterIds":["4091"],"vndbCharacterId":"c329"},"originalCharacterName":"星","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She joins Kazuto after the battle with Enshou. She has a strong obsession of menma of all kinds. She also has a habit of running around the city as the masked hero of justice, \"Butterfly Mask\" in her patrol shift."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c329"},{"segments":[{"spoiler":false,"text":"切れ長の目を持ち、長い髪を宙に躍らせながら、舞踏をするように敵を倒していく勇者。"},{"spoiler":false,"text":"総じてクールであり、美しさに自分だけの拘りを持っているが、その趣味は他人の美意識とはかなりズレていて、変だったりする。"}],"source":"egs","sourceCharacterId":"4091","sourceWorkId":"11334","spoiler":false},{"segments":[{"spoiler":false,"text":"五虎将軍の一人で、常山の昇り竜……とは言われるものの、本人はあまり出しゃばらず、軍部では愛紗のフォローに廻っている。"},{"spoiler":false,"text":"本人曰く 「私に求められているのは、真面目に仕事をする姿では無いはずだ！」 だそうだ。"},{"spoiler":false,"text":"要約すると、面倒らしい。"},{"spoiler":false,"text":"ストライクフリーダムな雪蓮と仲が良く、昼間っから街の呑み屋で酒盛りをしているところを、よく目撃されているらしい。"}],"source":"egs","sourceCharacterId":"4091","sourceWorkId":"13835","spoiler":false},{"segments":[{"spoiler":false,"text":"「神槍」とも称されている、関羽・張飛にも匹敵する武人。"},{"spoiler":false,"text":"冷静沈着ながらも、おちゃらけた性格。"},{"spoiler":false,"text":"美しさに自分だけのコダワリを持っているが、他人の美意識とはかなりズレている。"},{"spoiler":false,"text":"好物はメンマ。"},{"spoiler":false,"text":"必殺技：「龍撃」「龍牙」「蒼龍星」"},{"spoiler":false,"text":"夢想†奥義：「星雲神妙撃」"},{"spoiler":false,"text":"夢想†秘奥義：「華蝶見参」"}],"source":"egs","sourceCharacterId":"4091","sourceWorkId":"18595","spoiler":false},{"segments":[{"spoiler":false,"text":"有着细长而清秀的眼睛，舞动于空中的长发，仿佛舞蹈一般击败敌人的勇者。总的来说是个酷姐，对于美有着只属于自己的坚持，但因为其之美意识与他人有着相当的偏差，显得很是奇异。"},{"spoiler":false,"text":"喜欢的食物是笋干与酒。如果酒与笋干被他人横刀夺爱的话，就会发动絮絮叨叨絮絮叨叨絮絮叨叨絮絮叨叨的语言攻势。"}],"source":"bangumi","sourceCharacterId":"22905"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/675e84c266517bd481d9b5bca2838a55c7b2f701611718602776a7d575f6562e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/0704359413be2b6dd88cd77b26d0a35bc226db806a3b23d63985be13f9bbd15f.webp","width":202,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c33350","characterName":"馬超","sourceIds":{"bangumi":[{"characterId":"11052","match":"exact-normalized-name-in-linked-work","subjectId":"129020"},{"characterId":"11052","match":"so