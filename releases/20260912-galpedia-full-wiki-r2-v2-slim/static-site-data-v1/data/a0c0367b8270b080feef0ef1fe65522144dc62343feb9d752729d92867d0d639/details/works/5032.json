ive","relationId":"vndb:vn-staff:12859","source":"vndb"},{"creditedName":"有限会社コーデックス","creatorId":"vndb:s5581","sourcePersonId":"vndb:s5581","canonicalEntityId":"vndb:s5581","name":"有限会社codeX(有限会社コーデックス)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:12860","source":"vndb"},{"creditedName":"慶次郎","creatorId":"vndb:s35380","sourcePersonId":"vndb:s35380","canonicalEntityId":"vndb:s35380","name":"慶次郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:12861","source":"vndb"}]},"cast":[{"characterId":"char_c18652","characterName":"朝日奈 真一","sourceIds":{"bangumi":[{"characterId":"118144","match":"exact-normalized-name-in-linked-work","subjectId":"28649"}],"egsCharacterIds":["19551"],"vndbCharacterId":"c18652"},"originalCharacterName":"朝日奈 真一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"このゲームの主人公。"},{"spoiler":false,"text":"世界中に笑顔を振りまくと心に決めた熱血青年。"},{"spoiler":false,"text":"ひたすら熱く、他人の笑顔を求める。"},{"spoiler":false,"text":"つい先日までは自分の未来を見失いつつあった無職の青年だったが、"},{"spoiler":false,"text":"『Ｙの紋章』を持つ者として防衛軍にスカウトされることに。"},{"spoiler":false,"text":"『Ｙの紋章』とは別名をユーモアの紋章。"},{"spoiler":false,"text":"お笑いを愛する心――ユーモア・マインドが誰よりも高い、選ばれた人間だけが持つ勇者の証。"},{"spoiler":false,"text":"彼は紋章の力を使い宇宙人たちと戦う。"},{"spoiler":false,"text":"体力と熱意は人並み以上にあるが、頭のネジは人並み比べてかなりゆるい。"}],"source":"egs","sourceCharacterId":"19551","sourceWorkId":"5032","spoiler":false},{"segments":[{"spoiler":false,"text":"ライアーソフト第１４弾「絶対地球防衛機メガラフター」の主人公。"},{"spoiler":false,"text":"体力と熱意は誰にも負けないが、頭がついてこないやや残念な青年。"},{"spoiler":false,"text":"世界中に笑いを振りまくことを信条にしている。"}],"source":"egs","sourceCharacterId":"19551","sourceWorkId":"9637","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6d47230a9e5a267998270486a71b35e137cc4972e1c2d77d78206b9b9881bbe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/679b9a36569ad902dec81b159e3a7c838f425a1a1356df20982768ef095a897c.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c18659","characterName":"桐山ヒカリ","sourceIds":{"bangumi":[{"characterId":"118146","match":"exact-normalized-name-in-linked-work","subjectId":"28649"}],"egsCharacterIds":["19550"],"vndbCharacterId":"c18659"},"originalCharacterName":"桐山ヒカリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真一より１歳年上の幼なじみで、公務員。天性のクール人間。"},{"spoiler":false,"text":"真一からは「ヒカリさん」と呼ばれ、慕われる一方で恐れられてもいる女性。"},{"spoiler":false,"text":"常に冷めたキャラクターだが、表情が冷たいわけではなく、ただ単にあまり笑わないだけ。"},{"spoiler":false,"text":"笑うときも微笑で止まっている。"},{"spoiler":false,"text":"無感情という訳でもなく感情はちゃんとあり、真一のことは手のかかる駄目な弟と思って世話してくれている。"},{"spoiler":false,"text":"真一が就職してから、地球防衛軍付市民被害監視係となり、公私ともども真一に関わっていく。"}],"source":"egs","sourceCharacterId":"19550","sourceWorkId":"5032","spoiler":false},{"segments":[{"spoiler":false,"text":"ライアーソフト第１４弾「絶対地球防衛機メガラフター」のヒロイン。"},{"spoiler":false,"text":"滅多に笑うことのない、天性のクール人間。真一にとっては信頼する、そして頭の上がらないお姉さん的存在。"}],"source":"egs","sourceCharacterId":"19550","sourceWorkId":"9637","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d93eb8c9f254ffe5ef88b1bcd38f0f32a13116944e39ba9ee6b7c5e5154314c8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/956f6c526a15ff89acd2f5397f6265a09146d4592b2531d470517f219d047102.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和田カヨ","creatorId":"vndb:s570","sourcePersonId":"vndb