:"c149510"},{"segments":[{"spoiler":false,"text":"聖レイクリア医院の新任の医師。 脳神経内科医。医師4年目。"},{"spoiler":false,"text":"子供の頃、母親がノスフェラ病で亡くなったので、その撲滅を志して医者になり、妹が同じ病を患っていることもあって治療法を熱心に研究している。"},{"spoiler":false,"text":"ノスフェラ病専門の聖レイクリア医院に招かれて、それまで勤めていた総合病院を辞め、看護師である恋人を連れて転籍。 同時に妹も転院させた。"},{"spoiler":false,"text":"しかし、彼自身がB型ノスフェラ病にかかってしまい、“異常覚醒をした者を見ると自制出来ないほど激しく性的興奮してしまう” という異常覚醒をしてしまう。"}],"source":"egs","sourceCharacterId":"519","sourceWorkId":"18170","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_c26300","characterName":"温森 あかり","sourceIds":{"bangumi":[{"characterId":"137127","match":"exact-normalized-name-in-linked-work","subjectId":"182066"}],"egsCharacterIds":["514"],"vndbCharacterId":"c26300"},"originalCharacterName":"温森 あかり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A new nurse at the clinic. She is the lover of the main character. She is in her second year as a nurse."},{"spoiler":false,"text":"In her first year, she worked in the neurology ward of a general hospital. She met the main character there and started dating him. This is the first time she has dated a man."},{"spoiler":false,"text":"The main character asked her to come work with him at St. ReiKuria Clinic, she gladly agreed."},{"spoiler":false,"text":"Although she and the main character are very much in love, they have not kissed yet because they are both shy."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sour