reditedName":"AKKO","creatorId":"vndb:s5624","sourcePersonId":"vndb:s5624","canonicalEntityId":"vndb:s5624","name":"AKKO","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:16224","source":"vndb"},{"creditedName":"白峰 美津子","creatorId":"vndb:s22467","sourcePersonId":"vndb:s22467","canonicalEntityId":"vndb:s22467","name":"白峰 美津子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:16228","source":"vndb"},{"creditedName":"Yummy","creatorId":"vndb:s44351","sourcePersonId":"vndb:s44351","canonicalEntityId":"vndb:s44351","name":"Yummy","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:16232","source":"vndb"}]},"cast":[{"characterId":"char_c1562","characterName":"泉戸 ましろ","sourceIds":{"bangumi":[{"characterId":"1801","match":"source-roster","subjectId":"114064"},{"characterId":"1801","match":"source-roster","subjectId":"131917"},{"characterId":"1801","match":"source-roster","subjectId":"18333"},{"characterId":"1801","match":"source-roster","subjectId":"198439"},{"characterId":"1801","match":"exact-normalized-name-in-linked-work","subjectId":"3177"},{"characterId":"1801","match":"source-roster","subjectId":"3177"}],"egsCharacterIds":["8239"],"vndbCharacterId":"c1562"},"originalCharacterName":"泉戸 ましろ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"403"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She calls Yuuri her husband. Pretty obvious from her cute ears that she isn’t a human. She has considerable power even among the tayutama and hopes for the union of humans and tayutama. She doesn’t get the current technology so it’s pretty funny to see her fumble around with it. She has a pretty optimistic and cute personality. Florence student."},{"spoiler":false,"text":"From Accany's review"}],"source":"vndb","sourceCharacterId":"c1562"},{"segments":[{"spoiler":false,"text":"創聖学院女子学部（フローレス）カリキュラムＳ受講生（最上級生）。"},{"spoiler":false,"text":"裕理を「夫」と呼び、積極的にアタックしてくる太転依（たゆたい）の娘。"},{"spoiler":false,"text":"その姿勢は何かを覚悟しているように見え、なし崩し的に泉戸家に住むことに。"},{"spoiler":false,"text":"知識が全体的に古く、能天気で寛容的だが、怒ると恐ろしい。"},{"spoiler":false,"text":"アメリとは裕理と巡った恋のライバル。"},{"spoiler":false,"text":"「私はいつでも、どんな時でも、裕理さんの味方ですから」"}],"source":"egs","sourceCharacterId":"8239","sourceWorkId":"10100","spoiler":false},{"segments":[{"spoiler":false,"text":"最強の力を持った太転依、綺久羅美守毘売の化成した姿。"},{"spoiler":false,"text":"人と太転依との共存を志し、芦原町での事件の後、夫である裕理と共に全国を精力的に巡っていた。"},{"spoiler":false,"text":"鷹千帆が国内でも特に濃い神気の集まる土地であることが発覚し、矢古民町に八衢神社が建立されてからは、泉戸こはくと共にと2人で暮らしている。"},{"spoiler":false,"text":"礼節正しい大人の女性だが、自分の意見を曲げない頑固なところがあったり、子供のようにはしゃいでしまったり、娘のように可愛がっているこはくに対して親バカっぷりを発揮したりすることもある。"},{"spoiler":false,"text":"裕理とは精神的に繋がっており、いつでも言葉を交わせるため、そういう意味で寂しさは感じることは無いのだが、こはくと空のやり取りなどを見ていると、つい羨ましくなって、裕理に泣き付くこともある。"},{"spoiler":false,"text":"好きな物はましゅまろ。"},{"spoiler":false,"text":"最近、恋愛小説を読み始め、夢中になってしまっているらしい。"}],"source":"egs","sourceCharacterId":"8239","sourceWorkId":"21942","spoiler":false},{"segments":[{"spoiler":false,"text":"开学日突然出现的少女，创圣学院女子学部S课程学生（最上级生）。其真正身分是以前绮久罗美守毗卖“化成”的太转依，懂得使用咒术，“真白”是裕理取的名称。外表和人类分表不大，但有狐耳和尾。知识非常古老，不懂得操作电器。对裕理在恋爱上积极展开攻势，之后更住在泉户家。保持着绮久罗美守毗卖的思想和记忆，要和裕理创造“人类和太转依共存的世界”。"}],"source":"bangumi","sourceCharacterId":"1801"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/5549be002b3b6a27ab520da7fe6dd389c0e8888428aeb5c7ee8e0de857ad79d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee11443c5c871897273d9d33cd90fe64f24fcfe3f47aa19b7e0f9c781dd5572e.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3177:1801:4689:1","source":"bangumi"}]},{"characterId":"char_c1563","characterName":"小鳥遊 ゆみな","sourceIds":{"bangumi":[{"characterId":"1803","match":"exact-normalized-name-in-linked-work","subjectId":"3177"}],"egsCharacterIds":["8241"],"vndbCharacterId":"c1563"},"originalCharacterName":"小鳥遊 ゆみな","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"122"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"69"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AA"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"144"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"73"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuri’s non-blood-related sister. She used to live together with Yuuri and his father but lives with someone else now for reasons unknown. Yumina is really shy and sometimes fails in what she does. Kind of a crybaby. She idolises Mifuyu completely and is also a florence student."},{"spoiler":false,"text":"From Accany's review"}],"source":"vndb","sourceCharacterId":"c1563"},{"segments":[{"spoiler":false,"text":"創聖学院女子学部（フローレス）カリキュラムＣ受講生。"},{"spoiler":false,"text":"とある事情から、神社である泉戸家に捨て子同然で預けられ、現在は、祖父母同然の存在だった小鳥遊家に養子縁組している。"},{"spoiler":false,"text":"成績は常に上位だが、他人の視線があると極度に緊張し、失敗してしまうタイプ。"},{"spoiler":false,"text":"絵や料理、裁縫など、一人で地道にコツコツやるものは得意な様子。"},{"spoiler":false,"text":"「うわああああん！　ゆみなが全部悪いんですううう！」"}],"source":"egs","sourceCharacterId":"8241","sourceWorkId":"10100","spoiler":false},{"segments":[{"spoiler":false,"text":"大創聖学院フローレス校を優秀な成績で卒業。"},{"spoiler":false,"text":"在学中は学院生たち自身の手によって選ばれる総代、ミレディにも選出された。"},{"spoiler":false,"text":"泉戸裕理と血の繋がりは無いが、共に暮らしていた時期もあり彼を兄と慕っている。"},{"spoiler":false,"text":"緊張するとパニックに陥るところは相変わらずだが、ネガティブな性格は多少改善されたのか、さまざまなことに積極的に挑戦するようになった。"}],"source":"egs","sourceCharacterId":"8241","sourceWorkId":"21942","spoiler":false},{"segments":[{"spoiler":false,"text":"创圣女学院学部C课程学生。生于富裕家庭“天见”，但其后天见家没落，由美奈被托付于泉户家。一起生活的由美奈已当裕理为哥哥，但因裕理母亲的死，而转为“小鸟游”家的养女。性格害羞，喜欢绘画、料理、裁缝等可以一人自己做的事。和亚芽里相熟并称之为“姐姐”，非常憧憬创圣女学院学部的“贵妇（ミレディ）”（总代理）如月美冬。"},{"spoiler":false,"text":"另外，这角色是来自本作担当原画的萌木原文武所属的同人团体ZIP所制作的成人游戏《Purism×Egoist》（2004年4月16日发售）中的角色，有翅膀的人造人“由美奈（ゆみな）”"}],"source":"bangumi","sourceCharacterId":"1803"}],"profileFacts":[],"metadataCandidateConflicts":{"height":[{"comparisonValue":"144","source":"vndb","sourceCharacterId":"c1563","value":"144"},{"comparisonValue":"144.5","scope":"sourceWork","source":"egs","sourceCharacterId":"8241","sourceWorkId":"10100","value":"144.5"},{"comparisonValue":"149.9","scope":"sourceWork","source":"egs","sourceCharacterId":"8241","sourceWorkId":"21942","value":"149.9"},{"comparisonValue":"144.5","source":"bangumi","sourceCharacterId":"1803","value":"144.5cm"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b025eee769f9326d3b326f46f0f247b632e3071fc0efdaa337dfface6c9d086.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/4262459b8ca315f05e292c83976d8fdf7fe0fe18b99371958aedcb4280942e01.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水橋かおり","creatorId":"vndb:s131","sourcePersonId":"vndb:s131","canonicalEntityId":"vndb:s131","name":"水橋 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3177:1803:3851:1","source":"bangumi"}]},{"characterId":"char_c1564","characterName":"如月 美冬","sourceIds":{"bangumi":[{"characterId":"1804","match":"source-roster","subjectId":"114064"},{"characterId":"1804","match":"source-roster","subjectId":"131917"},{"characterId":"1804","match":"source-roster","subjectId":"18333"},{"characterId":"1804","match":"source-roster","subjectId":"198439"},{"characterId":"1804","match":"exact-normalized-name-in-linked-work","subjectId":"3177"},{"characterId":"1804","match":"source-roster","subjectId":"3177"}],"egsCharacterIds":["8242"],"vndbCharacterId":"c1564"},"originalCharacterName":"如月 美冬","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"301"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"169"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mifuyu is a refined girl part of the curriculum S in Florence (S for Special); she is very clever but has trouble understanding how to maintain and form relationships. She is the daughter of Kisaragi Kazuhiko. Her family is old and very rich, not to mention Mifuyu knows how to handle a sword. She cares about Yumina quite a lot."},{"spoiler":true,"text":"She becomes Nue's mother figure after they overcome their differences."},{"spoiler":true,"text":"Edited from Accany's review"}],"source":"vndb","sourceCharacterId":"c1564"},{"segments":[{"spoiler":false,"text":"創聖学院女子学部（フローレス）カリキュラムＳ受講生（最上級生）。"},{"spoiler":false,"text":"名家“如月家”出身の才女で、常に冷静で思慮深い人格者。"},{"spoiler":false,"text":"周囲の信頼も厚く、選ばれるべくして選ばれた「ミレディ（女子学部総代）」。"},{"spoiler":false,"text":"後輩であるゆみなのことを、何かと気にかけている様子。"},{"spoiler":false,"text":"「あの夜、学校の側に住んでいた生徒が、バイクの音を聞いたとかでな……」"}],"source":"egs","sourceCharacterId":"8242","sourceWorkId":"10100","spoiler":false},{"segments":[{"spoiler":false,"text":"由緒正しき名家、政財界に大きな影響力を持つ如月家の中心的存在。"},{"spoiler":false,"text":"泉戸ましろの『人と太転依の共存』に理解を示し、さの実現に向け政治的な面から押し進める親太転依派の代表的な人物である。"},{"spoiler":false,"text":"泉戸裕理、ましろ夫妻とは学生時代に知り合い、最も早い時期から太転依との交流を持ってきた。"},{"spoiler":false,"text":"生真面目な性格から誤解を招かれることも多いが、常に周りの皆のために最善を考える優しい心の持ち主である。"}],"source":"egs","sourceCharacterId":"8242","sourceWorkId":"21942","spoiler":false},{"segments":[{"spoiler":false,"text":"创圣学院女子学部S课程学生（最上级生）兼贵妇（总代理）。“贵妇”是女子学部中特别优秀的监督生的领导生，需要得到全校学生和教师八成以上的支持才能被选出。美冬生于名家如月家，幼时开始已接受严谨的教育。擅长各种武艺，特别是剑术。冷静沉稳而深思熟虑，虽然性格严肃但实际心中想逃离这种束缚。兴趣是读书，特别是以“自由恋爱”为题材的故事。意识到由美奈对自己的憧憬。另外，据自己各种推理，认为阻止扩充工程的人是裕理，但其实并无关系。"}],"source":"bangumi","sourceCharacterId":"1804"}],"profileFacts":[],"metadataCandidateConflicts":{"waist":[{"comparisonValue":"59","source":"vndb","sourceCharacterId":"c1564","value":"59"},{"comparisonValue":"59","scope":"sourceWork","source":"egs","sourceCharacterId":"8242","sourceWorkId":"10100","value":"59"},{"comparisonValue":"58","source":"bangumi","sourceCharacterId":"1804","value":"58"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47b4fd7cd23b44a3f1be9421d4588ea0034882e3dc323c93d1cdf1dd8c32a145.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8ca868c79d95f96ce781a0dbbd56a5efccf867a928ee5ad513a26cdc98e675d.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤静","creatorId":"vndb:s516","sourcePersonId":"vndb:s516","canonicalEntityId":"vndb:s516","name":"伊藤 静","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3177:1804:4272:1","source":"bangumi"}]},{"characterId":"char_c1565","characterName":"河合 アメリ","sourceIds":{"bangumi":[{"characterId":"1802","match":"source-roster","subjectId":"114064"},{"characterId":"1802","match":"source-roster","subjectId":"131917"},{"characterId":"1802","match":"source-roster","subjectId":"18333"},{"characterId":"1802","match":"source-roster","subjectId":"198439"},{"characterId":"1802","match":"exact-normalized-name-in-linked-work","subjectId":"3177"},{"characterId":"1802","match":"source-roster","subjectId":"3177"}],"egsCharacterIds":["8240"],"vndbCharacterId":"c1565"},"originalCharacterName":"河合 アメリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"809"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuri' childhood friend. She’s really active and fun but probably the character with the most mood swings in the story. Obvious that she holds a thing or two for Yuuri. Her family is also pretty rich. Her father is the headmaster of Suraitory and also good friends with Yuuri’s father, Kawai Genzou."},{"spoiler":false,"text":"From Accany's review"}],"source":"vndb","sourceCharacterId":"c1565"},{"segments":[{"spoiler":false,"text":"創聖学院一般学部（スライトリー）カリキュラムＳ受講生（最上級生）。"},{"spoiler":false,"text":"裕理の同級生であり、幼い頃から一緒に遊んでいた幼馴染でもある。"},{"spoiler":false,"text":"他人を巻き込む「ゴーイングマイウェイ」な性格だが、恋愛に関しては臆病な面があり、裕理との仲もあまり進展する気配がない。"},{"spoiler":false,"text":"しかし、積極的な恋のライバル・ましろの登場により……？"},{"spoiler":false,"text":"「全部あたしのおかげでしょ？　死ぬほど感謝しなさいよね？」"}],"source":"egs","sourceCharacterId":"8240","sourceWorkId":"10100","spoiler":false},{"segments":[{"spoiler":false,"text":"大手企業グループ『河合ホールディングズ』の女会長として名を馳せる人物。"},{"spoiler":false,"text":"空たちの通う、私立鷹千帆学院の学院長も務めている。"},{"spoiler":false,"text":"ましろの夫、泉戸裕理とは幼馴染であり、一時は裕理を巡ってましろとぎこちなくなることもあったが、今では良き協力者であり、長年の友人となっている。"},{"spoiler":false,"text":"好物はアメで、ポケットやカバンにはいつも大量のアメを忍ばせている。"}],"source":"egs","sourceCharacterId":"8240","sourceWorkId":"21942","spoiler":false},{"segments":[{"spoiler":false,"text":"裕理的青梅竹马兼同学，和裕理如家人般的亲近。创圣学院一般学部S课程学生（最上级生），父亲是一般学部的理事，母亲是大企业建筑公司的会长。做事有自己的一套，但不会有特别的计划。对裕理有一些好感，然而自己对恋爱不擅长，一直都只是朋友，视真白为对手。另外，虽然名字像是西方人但实际无关。"}],"source":"bangumi","sourceCharacterId":"1802"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b83639d0489cfa78bd0de2280594c45542202cb3b80debfa2314ad457a0ac79.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d33113ade8803f77718f0e18cd4695d0c42d5a1183adbf3628332eaccd49a475.webp","width":136,"height":256,"source":"static-detail"},"actors":[{"creditedName":"下田麻美","creatorId":"vndb:s1597","sourcePersonId":"vndb:s1597","canonicalEntityId":"vndb:s1597","name":"下田 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3177:1802:4990:1","source":"bangumi"}]},{"characterId":"char_c69191","characterName":"応龍","sourceIds":{"bangumi":[],"egsCharacterIds":["28259"],"vndbCharacterId":"c69191"},"originalCharacterName":"応龍","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"de