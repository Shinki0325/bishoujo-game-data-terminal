{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"18509","model":{"presentationWorkId":"vndb:v6716","staff":{"artwork":[{"creditedName":"福永 ユミ","creatorId":"vndb:s1081","sourcePersonId":"vndb:s1081","canonicalEntityId":"vndb:s1081","name":"梅鳥 うりり","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:66534","source":"vndb"},{"creditedName":"桜沢 いづみ","creatorId":"vndb:s3999","sourcePersonId":"vndb:s3999","canonicalEntityId":"vndb:s3999","name":"桜沢 いづみ","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:66536","source":"vndb"}],"scenario":[{"creditedName":"沖水 ミル","creatorId":"vndb:s4000","sourcePersonId":"vndb:s4000","canonicalEntityId":"vndb:s4000","name":"沖水 ミル","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:66537","source":"vndb"}],"music":[],"other":[{"creditedName":"上田 メタヲ","creatorId":"vndb:s238","sourcePersonId":"vndb:s238","canonicalEntityId":"vndb:s238","name":"上田 メタヲ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66532","source":"vndb"},{"creditedName":"西沢 はぐみ","creatorId":"vndb:s394","sourcePersonId":"vndb:s394","canonicalEntityId":"vndb:s394","name":"西沢 はぐみ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:66533","source":"vndb"},{"creditedName":"村上 智右","creatorId":"vndb:s2329","sourcePersonId":"vndb:s2329","canonicalEntityId":"vndb:s2329","name":"村上 智右","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66535","source":"vndb"},{"creditedName":"囲 智之","creatorId":"vndb:s4001","sourcePersonId":"vndb:s4001","canonicalEntityId":"vndb:s4001","name":"囲 智之","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:66538","source":"vndb"},{"creditedName":"囲 智之","creatorId":"vndb:s4001","sourcePersonId":"vndb:s4001","canonicalEntityId":"vndb:s4001","name":"囲 智之","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66539","source":"vndb"},{"creditedName":"路","creatorId":"vndb:s4002","sourcePersonId":"vndb:s4002","canonicalEntityId":"vndb:s4002","name":"路","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66540","source":"vndb"},{"creditedName":"神月 社","creatorId":"vndb:s4003","sourcePersonId":"vndb:s4003","canonicalEntityId":"vndb:s4003","name":"神月 社","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66541","source":"vndb"}]},"cast":[{"characterId":"char_c27296","characterName":"沢渡 夏雪","sourceIds":{"bangumi":[{"characterId":"12628","match":"exact-normalized-name-in-linked-work","subjectId":"15351"}],"egsCharacterIds":["10377"],"vndbCharacterId":"c27296"},"originalCharacterName":"沢渡 夏雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"831"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公・葛の義姉。幼少期の頃に初めて葛と対面。"},{"spoiler":false,"text":"当時は従姉だったが、翌年両親を不慮の事故で失い、主人公の両親が彼女を養子にしたため戸籍上の姉になった。"},{"spoiler":false,"text":"だが、両親と共に過ごした土地に残ることを頑として譲らず、以降もずっと生まれ育った宝来町で生活している。"},{"spoiler":false,"text":"葛とは出会った当時からずっと姉として接しており、本当の弟のように葛を可愛がっている。"},{"spoiler":false,"text":"毎年夏になると、自分を訪ねてくる葛と会えることを楽しみにしている。"},{"spoiler":false,"text":"性格的には、幼少の頃はややお転婆な一面を見せることもあったが、柔和で温厚。"},{"spoiler":false,"text":"いついかなる時も、姉として強い責任感と愛情を持って葛に接する。"},{"spoiler":false,"text":"たまに茶目っ気を見せて、狼狽する葛の反応を見て愉しんだりする一面もある。"}],"source":"egs","sourceCharacterId":"10377","sourceWorkId":"15133","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公葛的义姐。小时候就见过葛。"},{"spoiler":false,"text":"当时是表姐，第二年父母不幸因故双亡以后，葛的父母就把夏雪领养回去。"},{"spoiler":false,"text":"只是，她想留在曾经和父母住过的土地上，坚决不让步，随后便一直住在养育她的宝来镇上。"},{"spoiler":false,"text":"从和葛见面的那时起，就一直作为姐姐来把他当做真正的弟弟那样疼爱。"},{"spoiler":false,"text":"每年夏天一到，都会很开心见到自己一个来探望她的葛。"},{"spoiler":false,"text":"性格方面，虽然小时候会让人看见自己假小子的一面，实际上很温柔。"},{"spoiler":false,"text":"不知不觉间，对待葛的感情，有了作为姐姐那份强烈的责任感以及对他有爱情的感觉。"},{"spoiler":false,"text":"时不时会恶作剧一下，看见葛狼狈的反应感到无比欢乐。"}],"source":"bangumi","sourceCharacterId":"12628"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87eefe9914c19d26aa146560cdcf1a59e11ed977283f799b87c93ab0aaef7d7f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23c81d94a5a35b7b9d86f16ae4ffce4769b496ae923b23e17abd6f57b0a23acc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15351:12628:6359:1","source":"bangumi"}]},{"characterId":"char_c27297","characterName":"宮沢 純葉","sourceIds":{"bangumi":[{"characterId":"12629","match":"exact-normalized-name-in-linked-work","subjectId":"15351"}],"egsCharacterIds":["10378"],"vndbCharacterId":"c27297"},"originalCharacterName":"宮沢 純葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"719"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"夏雪と同じ宝来町に住む女の子。葛とは幼い頃に出会う。"},{"spoiler":false,"text":"人当たりがよく、とある時期まではクラスのリーダー的存在だった。"},{"spoiler":false,"text":"他人に打ち解けない葛にあまり良い印象を持っていなかったが、秘めたる情熱の持ち主であることを知って、淡い恋心を抱くようになる。"},{"spoiler":false,"text":"当初はとっつきづらい性格をしていた葛だったが、純葉との交流を深めるうちに気さくさを身につけていく。"},{"spoiler":false,"text":"将来は少女漫画家になりたいと思っている。"},{"spoiler":false,"text":"一見、直情的な性格に見えるが、実は繊細な心の持ち主。"},{"spoiler":false,"text":"他人を傷つけると、自分はもっと傷ついてしまうタイプ。"}],"source":"egs","sourceCharacterId":"10378","sourceWorkId":"15133","spoiler":false},{"segments":[{"spoiler":false,"text":"和夏雪一起住在宝来镇的女孩。和葛小时候相遇过。"},{"spoiler":false,"text":"待人接物态度良好，曾经是班级领导一般的存在。"},{"spoiler":false,"text":"对无法与他人相处的葛的印象不太好，但是知道他内心充满热情，对他有淡淡的恋慕心。"},{"spoiler":false,"text":"当初抱着难以相处性格的葛，和纯叶深深地交流以后渐渐变得开朗起来。"},{"spoiler":false,"text":"将来想成为少女漫画家。"},{"spoiler":false,"text":"一见面以为是那种直率的性格，实际上很细心。"},{"spoiler":false,"text":"是一旦伤害了他人，便会给自己带来更多伤害的类型。"}],"source":"bangumi","sourceCharacterId":"12629"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f202e3ddf6779b2927f63d243285537baa897bdad5a65d65055672052ad8fa8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a41d05ebb0e56e4e834d2f58302f79162459551c51adc5a0158b052c6af31e4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb: