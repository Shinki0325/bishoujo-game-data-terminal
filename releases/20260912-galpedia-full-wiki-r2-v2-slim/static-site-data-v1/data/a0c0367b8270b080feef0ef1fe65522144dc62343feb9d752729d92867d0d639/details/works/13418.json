terIds":["14009"],"vndbCharacterId":"c35955"},"originalCharacterName":"セル","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ライアーソフト第１５弾「ぼーん・ふりーくす！」の主人公。"},{"spoiler":false,"text":"父から継いだ診療所を営む、人当たりの良い医師の青年。"},{"spoiler":false,"text":"ただ１人の肉親である妹を、不治の病から解放するためには手段を選ばない。"}],"source":"egs","sourceCharacterId":"14009","sourceWorkId":"9637","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公。ヒロインの兄。"},{"spoiler":false,"text":"人当たりのよい、優しい田舎街の医者。"},{"spoiler":false,"text":"父から引き継いだ診療所を営んでいる。"},{"spoiler":false,"text":"幼い頃から病床に伏せったままのウラシルを元気な体に直してあげようと、医者を志し、首都にある最高学府的存在の院で医学を修め、医者になる。"},{"spoiler":false,"text":"それは同時に、ウラシルの病が不治のものである現実を知ることにもなる。"},{"spoiler":false,"text":"しかし、彼はけしてあきらめず、ついに、その病を打ち倒す方法を見つけだすことになる。"}],"source":"egs","sourceCharacterId":"14009","sourceWorkId":"13418","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7972a54493590f760dd43db7a4c4df58455b778ee3a6a18d06e1bd71176b8c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9cb68a69e75112fbba02e04c3b8d44dd17958cc62f0e48b0db01d1640181cceb.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c35956","characterName":"ウラシル","sourceIds":{"bangumi":[{"characterId":"118131","match":"exact-normalized-name-in-linked-work","subjectId":"135838"},{"characterId":"118131","match":"exact-normalized-name-in-linked-work","subjectId":"60910"}],"egsCharacterIds":["14010"],"vndbCharacterId":"c35956"},"originalCharacterName":"ウラシル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ライアーソフト第１５弾「ぼーん・ふりーくす！」のヒロイン。"},{"spoiler":false,"text":"不治の病を患った少女。"},{"spoiler":false,"text":"ただ一人の肉親である兄を心より慕っており、彼の考え付いた特殊な治療方法もけなげに受け入れる。"}],"source":"egs","sourceCharacterId":"14010","sourceWorkId":"9637","spoiler":false},{"segments":[{"spoiler":false,"text":"メインヒロイン。主人公の妹。"},{"spoiler":false,"text":"幼い頃からずっと、病を患い、それはすでに彼女の体いたるところを蝕んでいる。"},{"spoiler":false,"text":"父が亡くなってからは、兄一人、妹一人の暮らしをしていて、ずっと兄である主人公に迷惑をかけてきたと思っているため、控えめな態度が染みついている。"},{"spoiler":false,"text":"素地は、年相応の明るさと元気さ、快活さを持っていて、この辺は、治療のために一時的に元気になったとたんに現れてきて、主人公を戸惑わせたり。"},{"spoiler":false,"text":"セルの考えついた治療方法のため、一時的に健康に近い体調になり、診療所を手伝ったりしている。"}],"source":"egs","sourceCharacterId":"14010","sourceWorkId":"13418","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c24372c22c05967c177115373954fccc4fca3ecf170880936fc7cc10c05d052b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e986e0858c3b4c8a784d383f7bfc9f6636faddb20d7a217063cadc66150fc60.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:60910:118131:4832:1","source":"bangumi"}]},{"characterId":"char_c35957","characterName":"フェニル","sourceIds":{"bangumi":[{"characterId":"118130","match":"exact-normalized-name-in-linked-work","subjectId":"60910"}],"egsCharacterIds":["14011"],"vndbCharacterId":"c35957"},"originalCharacterName":"フェニル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の学生時代の級友で、当時の彼女で、現在の共同研究者。"},{"spoiler":false,"text":"主人公の診療所を片手間に手伝いつつ、ウラシルの治療にかこつけて、自分の探求欲を満たしていたりする。"},{"spoiler":false,"text":"大人びているが、意地悪く人をからかったりするのが好きな性格。"},{"spoiler":false,"text":"頭もよく、主人公の治療行為を技術面で支えている。"},{"spoiler":false,"text":"研究に関しては考え方はシビアで、経過、結果に希望的な観測を一切入れないタイプ。"},{"spoiler":false,"text":"彼女にとっては、今回の治療は、自らの研究の成果の実践ととらえられている。"}],"source":"egs","sourceCharacterId":"14011","sourceWorkId":"13418","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cef8e0a18651d78cd66e7dd28f9b78611370b2c5e4bbb786400b3d0da3ad38c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5fcfa3df0b0e10a2f187b91de293a56a7166c1be6afe4590df7bcbe9339df558.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:60910:118130:6106:1","source":"bangumi"}]},{"characterId":"char_c35958","characterName":"システィ","sourceIds":{"bangumi":[{"characterId":"118129","match":"exact-normalized-name-in-linked-work","subjectId":"60910"}],"egsCharacterIds":["14012"],"vndbCharacterId":"c35958"},"originalCharacterName":"システィ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の診療所に患者として訪れた少女。"},{"spoiler":false,"text":"家はかなりの資産家。"},{"spoiler":false,"text":"ウラシルと同じ病気を患っている。ただし、病状はずっと軽い。"},{"spoiler":false,"text":"診療所に通っているうちに、ウラシルと仲良くなる。"},{"spoiler":false,"text":"性質は温和だが、頭はよく、物事をよく見ている。"},{"spoiler":false,"text":"主人公に対しては、どことなく隔意のあるところを最初は見せる。"}],"source":"egs","sourceCharacterId":"14012","sourceWorkId":"13418","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts