urce":"vndb"}],"other":[{"creditedName":"かずなさやか(計名さや香)","creatorId":"vndb:s859","sourcePersonId":"egs:creator:6048","canonicalEntityId":"vndb:s859","name":"かずなさやか(計名さや香)","detail":"主題歌 「楽園ハンター」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:74513","source":"egs"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:8561","source":"vndb"},{"creditedName":"計名 さや香","creatorId":"vndb:s859","sourcePersonId":"vndb:s859","canonicalEntityId":"vndb:s859","name":"計名 さや香","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:8562","source":"vndb"},{"creditedName":"齋藤 紀子","creatorId":"vndb:s2345","sourcePersonId":"vndb:s2345","canonicalEntityId":"vndb:s2345","name":"齋藤 紀子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:8565","source":"vndb"}]},"cast":[{"characterId":"char_c58709","characterName":"遠海 弥生","sourceIds":{"bangumi":[{"characterId":"55302","match":"exact-normalized-name-in-linked-work","subjectId":"217750"}],"egsCharacterIds":["19205"],"vndbCharacterId":"c58709"},"originalCharacterName":"遠海 弥生","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"94"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the residents at Paradise Mannor. When Akihiko mets her for the first time he falls in love."},{"spoiler":false,"text":"She works at a bendo shop."}],"source":"vndb","sourceCharacterId":"c58709"},{"segments":[{"spoiler":false,"text":"穏やかで優しい奥様。結婚二年目。"},{"spoiler":false,"text":"主人公にとって心のオアシスとも呼べる存在。"},{"spoiler":false,"text":"新婚とも呼べる時期でありながら、近所のお弁当屋でパートタイマーとして働きながら、何故か一人暮らしをしている。"},{"spoiler":false,"text":"容姿端麗、性格よしの彼女が一人暮らしをしている訳とは……？"},{"spoiler":false,"text":"「貴方って、とっても頼もしくって素敵な男の子だと思うわ」"}],"source":"egs","sourceCharacterId":"19205","sourceWorkId":"9923","spoiler":false},{"segments":[{"spoiler":false,"text":"優しく穏やかな薄幸奥様。明るく優しく、穏やかな女性。近所にある小さなお弁当屋さんでパートタイマーとして働いている。"},{"spoiler":false,"text":"OL時代に上司の紹介で見合いをし、そして結婚。しかし夫は弥生の上司のコネが欲しかっただけであったため結婚生活はすぐに破綻、愛人を作り帰宅はおろか家に生活費を入れなくなってしまう。弥生は、夫が家に帰ってこない原因を『自分が至らないため』と思いこみ、家賃の安い『楽園荘』に引っ越しパートタイマーとして働き、質素に暮らしながら夫の心が自分のところに戻ってくるのを信じ、辛抱強く待っている。"}],"source":"bangumi","sourceCharacterId":"55302"}],"profileFacts":[{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"19205","sourceWorkId":"9923","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"19205","sourceWorkId":"9923","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"19205","sourceWorkId":"9923","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"19205","sourceWorkId":"9923","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"47 kg","valueContext":null,"source":"egs","sourceCharacterId":"19205","sourceWorkId":"9923","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e433e010518d96c5a01c55003840cf4080193a0e72a2b7f1c7551448503e2e7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e95aeb9422415bb624356ef48a41eed830ec1b25dda0edba90b95bf37896106.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217750:55302:4940:1","source":"bangumi"}]},{"characterId":"char_c58710","characterName":"溝内 恭子","sourceIds":{"bangumi":[{"characterId":"55303","match":"exact-normalized-name-in-linked-work","subjectId":"217750"}],"egsCharacterIds":["19206"],"vndbCharacterId":"c58710"},"originalCharacterName":"溝内 恭子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"98"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"96"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the residents at Paradise Mannor. She works at a cabinet club. She drinks heavily and dose not clean her room. Her husband works overseas."}],"source":"vndb","sourceCharacterId":"c58710"},{"segments":[{"spoiler":false,"text":"妖艶な色気を振りまく人妻。結婚七年目。"},{"spoiler":false,"text":"本能に忠実で自堕落、非常にルーズで、ゴミ出しルールを破っては大家に小言を言われている様子。"},{"spoiler":false,"text":"夫は長距離トラック運転手なため、不在であることが多い。"},{"spoiler":false,"text":"もっとも彼女的には、それは最高の条件で、夫のいない間に、若い子をつまみ食いして楽しんでいる。"},{"spoiler":false,"text":"「可愛い子猫ちゃんね。いろいろ教えてあげたくなっちゃうわ」"}],"source":"egs","sourceCharacterId":"19206","sourceWorkId":"9923","spoiler":false},{"segments":[{"spoiler":false,"text":"気まぐれで妖艶な女性。穏やかで落ち着いた物腰をしているが、その動作言動一つ一つにどこかねっとりとからみつくような色香を漂わせる。本能に忠実で、自堕落さを好む。あまり几帳面ではない。"},{"spoiler":false,"text":"元キャバクラ店員。そして今は小さなスナックのママとして働いているが、本来の気まぐれな性格ゆえに営業時間はその日の気分次第。"},{"spoiler":false,"text":"結婚7年目、子無し。夫は運送会社勤務の長距離トラック運転手であり、長期に家を空けることが多々。『稼ぎが良くて家にあまりいない』、恭子にとっては最高の条件を持つ夫である。夫の居ない間は『若い子のつまみ食い』を楽しんでいたが、ここ近年は『ピンとくる』出会いが無く、暇な時間を過ごしていた。"},{"spoiler":false,"text":"夫を愛しているが、それは『稼ぎが良くて留守がち』という条件があるからこそ。本来は若い男が好きで、特に『ウブ』な若い子にイタズラをして楽しんでいる。"}],"source":"bangumi","sourceCharacterId":"55303"}],"profileFacts":[{"label":"胸围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"19206","sourceWorkId":"9923","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"19206","sourceWorkId":"9923","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"19206","sourceWorkId":"9923","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"19206","sourceWorkId":"9923","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"51 kg","valueContext":null,"source":"egs","sourceCharacterId":"19206","sourceWorkId":"9923","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8ee704d3b1a1530c225d7240efca1403f23be7d7896776cefbb4f771916b9207.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58896d6f55016cf24b9e5a3e62159e3a679c856a65a30621bf03866db112709c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MARIO","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217750:55303:4918:1","source":"bangumi"}]},{"characterId":"char_c58711","characterName":"岩崎 真由美","sourceIds":{"bangumi":[{"characterId":"55304","match":"exact-normalized-name-in-linked-work","subjectId":"217750"}],"egsCharacterIds":["19207"],"vndbCharacterId":"c58711"},"originalCharacterName":"岩崎 真由美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"95"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the residents at Paradise Mannor. She is very energetic."}],"source":"vndb","sourceCharacterId":"c58711"},{"segments":[{"spoiler":false,"text":"元気快活、さっぱり爽やかな専業主婦。三人の子持ち。"},{"spoiler":false,"text":"夫は普通のサラリーマンだが、残業徹夜泊まりは当たり前の状態。"},{"spoiler":false,"text":"出産で崩れた体型を取り戻そうと、日中はヨガやエアロビに精を出す。"},{"spoiler":false,"text":"一番下の子はまだ幼いため、母乳が出る。"},{"spoiler":false,"text":"「ねぇ、母乳の出が悪いの。おっぱいマッサージを手伝ってよ～」"}],"source":"egs","sourceCharacterId":"19207","sourceWorkId":"9923","spoiler":false},{"segments":[{"spoiler":false,"text":"元気はつらつ明るい奥様。快活元気で細かいことは気にしないすっきりとした姉御タイプ。専業主婦。子供は一歳と三歳半の子供の二人。（日中は祖母の家に遊びに行っている）"},{"spoiler":false,"text":"夫は普通のサラリーマン。SEなので、残業徹夜泊まりは当たり前の状態。夫とは社内結婚。昔は相当遊んでいた。出産して体型が崩れてしまったため、昔の栄光と取り戻そう＆昔のモテ体型に戻そうと日中はヨガやエアロビに精を出している。一番下の子はまだ幼いためか、母乳が出る。"}],"source":"bangumi","sourceCharacterId":"55304"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"19207","sourceWorkId":"9923","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"19207","sourceWorkId":"9923","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"19207","sourceWorkId":"9923","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"19207","sourceWorkId":"9923","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"51 kg","valueContext":null,"source":"egs","sourceCharacterId":"19207","sourceWorkId":"9923","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c830f5a0e06da0b77680a6ca3ec2de71e23ac6d2c557ead311a632e937f4636d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1de0b49f73627abfd5fc2a97a60d41d0816a8ec19fd321fe6e7a14c06cc58742.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白井うさぎ","creatorId":"vndb:s3002","sourcePersonId":"vndb:s3002","canonicalEntityId":"vndb:s3002","name":"白井 うさぎ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217750:55304:26282:1","source":"bangumi"}]},{"characterId":"char_c58712","characterName":"谷橋 千尋","sourceIds":{"bangumi":[{"characterId":"55305","match":"exact-normalized-name-in-linked-work","subjectId":"217750"}],"egsCharacterIds":["19208"],"vndbCharacterId":"c58712"},"originalCharacterName":"谷橋 千尋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the residents at Paradise Mannor she has a very serious personality."}],"source":"vndb","sourceCharacterId":"c58712"},{"segments":[{"spoiler":false,"text":"クールで気真面目、融通の利かない教育ママ。"},{"spoiler":false,"text":"趣味は節約・貯蓄で、無駄な散財、行動を嫌い、専業主婦やチャラチャラした人を見下した所がある。"},{"spoiler":false,"text":"夫とは職場結婚で、小学生の子供がいるが、彼女の堅すぎる口調や物腰が災いしてか、数年前から家族と別居状態。"},{"spoiler":false,"text":"「私は、その……、貴方を大家代理人としか見ておりませんので」"}],"source":"egs","sourceCharacterId":"19208","sourceWorkId":"9923","spoiler":false},{"segments":[{"spoiler":false,"text":"クールで生真面目な奥様。頭は良いが、頭が固すぎて融通の利かない、教育ママタイプの女性。会計事務所に勤め、趣味は節約、貯蓄（節約は貯蓄に繋がっている）。無駄な散在や行動を嫌う為、化粧品すら持っていない。専業主婦やちゃらちゃらした人間を見下しているところがある。"},{"spoiler":false,"text":"考え方も口調も物腰も、とにかく全てが堅い。夫とは職場結婚。小学生低学年の子供有り。しかし数年前から夫とは別居状態になっている。その原因は千尋の『考え方の固さ・融通のきかなさ・常に冷静沈着すぎる態度』でありそれに夫が根をあげて家を出て行ってしまう。以来、ずっと別居中。職場では顔を見せるが、会話もほとんど無い仮面夫婦。"},{"spoiler":false,"text":"しかし当の千尋は『夫婦といえども所詮は他人。無理をして一緒にいる必要性を感じないし、建設的でもない』と考え、自分も家賃の安いこの『楽園荘』に引っ越してくる。……本人はこの状況を苦ともしていない素振りをしているが本当は、ただ違和感を無理矢理理性で押し殺しているだけであるため、余計な質問をしてくる人間が大嫌い。口調と物腰の固さ、そして何より近づきがたい雰囲気を醸し出しているため友人は居ない。"}],"source":"bangumi","sourceCharacterId":"55305"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"19208","sourceWorkId":"9923","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"19208","sourceWorkId":"9923","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"19208","sourceWorkId":"9923","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"19208","sourceWorkId":"9923","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"58 kg","valueContext":null,"source":"egs","sourceCharacterId":"19208","sourceWorkId":"9923","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/adebb455df77ce95b2d18ca38f9cb13cf759c6b00aec332ea8c51d3b12cf1f1b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/425f38b9b