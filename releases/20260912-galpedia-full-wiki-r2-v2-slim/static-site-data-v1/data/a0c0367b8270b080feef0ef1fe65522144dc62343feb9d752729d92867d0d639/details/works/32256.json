","source":"vndb"},{"creditedName":"泉 達也","creatorId":"vndb:s32633","sourcePersonId":"vndb:s32633","canonicalEntityId":"vndb:s32633","name":"泉 達也","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:181271","source":"vndb"},{"creditedName":"松田 岳久","creatorId":"vndb:s32639","sourcePersonId":"vndb:s32639","canonicalEntityId":"vndb:s32639","name":"松田 岳久","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:181272","source":"vndb"},{"creditedName":"松田 岳久","creatorId":"vndb:s32639","sourcePersonId":"vndb:s32639","canonicalEntityId":"vndb:s32639","name":"松田 岳久","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:181273","source":"vndb"},{"creditedName":"赤坂 喜幸","creatorId":"vndb:s32640","sourcePersonId":"vndb:s32640","canonicalEntityId":"vndb:s32640","name":"赤坂 喜幸","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:181274","source":"vndb"},{"creditedName":"赤坂 喜幸","creatorId":"vndb:s32640","sourcePersonId":"vndb:s32640","canonicalEntityId":"vndb:s32640","name":"赤坂 喜幸","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:181275","source":"vndb"},{"creditedName":"辰巳 拓馬","creatorId":"vndb:s32641","sourcePersonId":"vndb:s32641","canonicalEntityId":"vndb:s32641","name":"辰巳 拓馬","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:181277","source":"vndb"},{"creditedName":"ポールトゥウィン株式会社","creatorId":"vndb:s39454","sourcePersonId":"vndb:s39454","canonicalEntityId":"vndb:s39454","name":"ポールトゥウィン株式会社","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:181278","source":"vndb"},{"creditedName":"長谷川 剛","creatorId":"vndb:s53026","sourcePersonId":"vndb:s53026","canonicalEntityId":"vndb:s53026","name":"長谷川 剛","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:181280","source":"vndb"},{"creditedName":"Nagaura Nozomi","creatorId":"vndb:s53027","sourcePersonId":"vndb:s53027","canonicalEntityId":"vndb:s53027","name":"Nagaura Nozomi","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:181282","source":"vndb"},{"creditedName":"Hayashi Shouhei","creatorId":"vndb:s53028","sourcePersonId":"vndb:s53028","canonicalEntityId":"vndb:s53028","name":"Hayashi Shouhei","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:181284","source":"vndb"},{"creditedName":"Hayashi Shouhei","creatorId":"vndb:s53028","sourcePersonId":"vndb:s53028","canonicalEntityId":"vndb:s53028","name":"Hayashi Shouhei","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:181285","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c136860","characterName":"Eureka de Soleil","sourceIds":{"vndbCharacterId":"c136860"},"originalCharacterName":"Eureka de Soleil","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The noble daughter of the Soleil family."},{"spoiler":true,"text":"She calls her self Eureka, but her real name is actually Margaret."},{"spoiler":false,"text":"Once a proud noble family celebrated for its masterful musical prowess, after misfortune and conflict befalls her family, they are forced to live a life less grand than it's patriarch would like."},{"spoiler":true,"text":"Affter Eureka's mother, Aurica, leaves with her brother, Astel, her father grows more resentful of her after failing to impart his musical aptitude to the maladroit Eureka"},{"spoiler":false,"text":"To help ease her family's financial burden, she departs for the Galleria Manor, where she hears of a certain job opening-one searching specifically for someone talented at finding lost things. With her trusty dowsing pendant, sprightly mettle, and cheerful smile, she aims to help anyone who might need it- noble or peasant, adult or child, human or in-human."}],"source":"vndb","sourceCharacterId":"c136860"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/126a2f78f88757436e898827df520751aa5bc66c93cd10120dc9764b032004a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bd80255737410a86701bd5e5c5f1582fc9393301a12ae33b846f9e0df585988.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c138239","characterName":"Nachiroux Colbert","sourceIds":{"vndbCharacterId":"c138239"},"originalCharacterName":"Nachiroux Colbert","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 17 year-old witch on the cusp of adulthood. Like many teens her age, she is rebellious and stubborn, especially when it comes to her mother. As a child, she was ridiculed by her classmates because of her mother's unsightly appearance."},{"spoiler":true,"text":"School and friends are of no interest to Nachi. What Interests her is magic and alchemy, but because her mother despises magic and its unauthorized use is banned, she resorts to studying it in private with the help of a grimoire known only as \"Pol's Book of Magic\""},{"spoiler":true,"text":"After her grandfather passed, she inherited the family store, called the Galleria General Store, where common provisions used to be sold. But now, only dust antiques and old are pieces line the shelves, and few patrons visit anymore. Still, Nachiroux's fond Memories of her grandfather keeps her running to the store everyday without fail."}],"source":"vndb","sourceCharacterId":"c138239"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9ff00c2f7f7e2f6f408113e775546772f2d9698b803e69fed366b8bb1fd8f6e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/5363f32dc49e0c104ec301d617d0180b9a31e9f741155e330cecf4f0d1d750d7.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c144530","characterName":"Lanterne de Fantasmagorie","sourceIds":{"vndbCharacterId":"c144530"},"originalCharacterName":"Lanterne de Fantasmagorie","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"A curious lantern containing a wandering spirit."},{"spoiler":true,"text":"the lantern itself accompanied Nachiroux when she arrived in Alstella as an infant"},{"spoiler":false,"text":"When it partners with an individual who serves as its medium, it has the capability of observing their experiences, as well as venture off on its own into the labyrinth, commanding the puppet soldiers to do its own bidding. In addition, although Eureka is its main medium, it tends to dwell itself onto beings with a defenseless, weak spirit, or a low sense of awareness."},{"spoiler":false,"text":"The Lanterne cannot interact with the world directly, but is capable of limited communication with its mediums and a select few astute individuals who can see it."},{"spoiler":false,"text":"As for the wandering spirits themselves, many speculate on who or what they may be. Some believe they are many, while some believe they are one. Some believe they are arbitrators, and some believe they are merely observers. Whatever they may be, one thing is for certain- they are omnipotent beings choosing to involve themselves in this enigmatic tale."}],"source":"vndb","sourceCharacterId":"c144530"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6aa9ed7a4a38676c4e97dd517ae4df5b8372315b3c267ab4dfcf7f947d865714.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/611519f29ae0ff9da505146e35854e1dbea9e009b8ff3799b207edf6f38ba1ae.webp","width":198,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c144531","characterName":"Madame Marta","sourceIds":{"vndbCharacterId":"c144531"},"originalCharacterName":"Madame Marta","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An eccentric old witch, and a masterful alchemist with no parallel after years upon years of honing her skills in prison. She knows the ins and outs of the wardrobe, its dangers, and helps Eureka become Fantie's medium. She also helps Fantie by fabricating scrolls that grant special abilities useful for exploring the labyrinth"},{"spoiler":false,"text":"Employed by Count Bismont at Galleria manor, her task is to locate the nine Curios d'art, magical items hidden within the perilous labyrinth beneath the manor. She seems to know far more than she lets on..."},{"spoiler":false,"text":"When she was younger she was an aspiring witch, but she flew too close to the sun and wound up in jail after causing a tragic accident with her magic."}],"source":"vndb","sourceCharacterId":"c144531"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3ce93309a5f471484f99e471218e565c26c77525483f5367a1439aa47754be4a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/252c5d29ff60542ef07a97d559a50900b3e22d948e2bdf4ae1e901d91216c6e1.webp","width":203,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c144532","characterName":"Pericot","sourceIds":{"vndbCharacterId":"c144532"},"originalCharacterName":"Pericot","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":true,"text":"A manania who was once a bisque doll. She was accidentally animated by Eureka with the power of one of the Curios d'art."},{"spoiler":false,"text":"Madame Marta treats her as her granddaughter, and often assigns her chores."},{"spoiler":false,"text":"While many might perceive her as a standoffish and unfriendly, she deeply cares for those who can see past her distrustful facade."},{"spoiler":true,"text":"When she was newly born, Nachiroux raised her and taught her how to speak. her name originates from when she was a child."},{"spoiler":false,"text":"Since she dons an invisibility cloak that allows her to sneak about the manor grounds undetected, if you do spot her, you might find her munching on a rat or entertaining a scary cat."}],"source":"vndb","sourceCharacterId":"c144532"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fcf62e8d2f40b22340271a0ccdd1f7b795d253380b757b091e6ff1b8880d9aec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02eb0b6ba127bec3c916ac7df83a3b390f63eed0f62284ea97739003395021ff.webp","width":154,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p88","sourceCompanyId":"egs:brand:746","canonicalEntityId":"vndb:p88","name":"日本一ソフトウェア","roleCodes":["brand"],"identity