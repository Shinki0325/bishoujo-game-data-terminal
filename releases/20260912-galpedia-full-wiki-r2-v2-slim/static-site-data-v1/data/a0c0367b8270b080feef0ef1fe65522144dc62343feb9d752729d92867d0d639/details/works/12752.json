{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"12752","model":{"presentationWorkId":"vndb:v2206","staff":{"artwork":[{"creditedName":"船堀斉晃","creatorId":"vndb:s7079","sourcePersonId":"egs:creator:5023","canonicalEntityId":"vndb:s7079","name":"船堀斉晃","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:79049","source":"egs"}],"scenario":[{"creditedName":"弓月 誠","creatorId":"vndb:s10604","sourcePersonId":"vndb:s10604","canonicalEntityId":"vndb:s10604","name":"弓月 誠","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:32781","source":"vndb"}],"music":[{"creditedName":"有限会社 クワイア","creatorId":"vndb:s1266","sourcePersonId":"vndb:s1266","canonicalEntityId":"vndb:s1266","name":"有限会社 クワイア","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:32778","source":"vndb"}],"other":[{"creditedName":"やべあきら","creatorId":"vndb:s40461","sourcePersonId":"egs:creator:40574","canonicalEntityId":"vndb:s40461","name":"やべあきら","detail":"イベントCG彩色","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:276430","source":"egs"},{"creditedName":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","creatorId":"vndb:s592","sourcePersonId":"egs:creator:13068","canonicalEntityId":"vndb:s592","name":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","detail":"デモムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:82691","source":"egs"},{"creditedName":"船堀 斉晃","creatorId":"vndb:s7079","sourcePersonId":"vndb:s7079","canonicalEntityId":"vndb:s7079","name":"船堀 斉晃","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:32779","source":"vndb"}]},"cast":[{"characterId":"char_c32567","characterName":"原口 由紀","sourceIds":{"bangumi":[{"characterId":"147066","match":"exact-normalized-name-in-linked-work","subjectId":"419313"}],"egsCharacterIds":["14954"],"vndbCharacterId":"c32567"},"originalCharacterName":"原口 由紀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の義母。"},{"spoiler":false,"text":"まだまだ若々しく、美しさとスタイルを保っている。"},{"spoiler":false,"text":"優しく、包容力もあり、家事も万事こなす良妻賢母。"},{"spoiler":false,"text":"再婚して早々、夫が海外へ長期出張してしまい、寂しい思いをしている。"},{"spoiler":false,"text":"そのため、熟れた肉体を持て余し、ついつい自慰に耽る日々が続いていたが、それを主人公に覗かれ……。"},{"spoiler":false,"text":"「あ、京介くん、おはよう。いま起こしにいこうと思っていたところよ」"}],"source":"egs","sourceCharacterId":"14954","sourceWorkId":"12752","spoiler":false},{"segments":[{"spoiler":false,"text":"京介の義理の母。優しく美しく家事も万能と絵に描いたような良妻賢母。"},{"spoiler":false,"text":"新婚早々夫は海外長期出張になってしまい、その豊満で熟れた体を持て余し、ついつい自慰に耽る日々を送っている。"},{"spoiler":false,"text":"ある晩、自慰をしていた所を京介に覗かれてしまい、それをきっかけに肉体関係を持つようになる。"},{"spoiler":false,"text":"「あ、京介くん、おはよう。いま起こしに行こうと思っていたところよ」"}],"source":"bangumi","sourceCharacterId":"147066"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0eda05f1bb214b8fc38076dcb933896b0bc5cedc40baa264dde2d0e6e770aff8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9baa8d7c3a0fdb44f53cdd1cd8dda99f7497ab00890647b563e8c8b706e0b3a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:419313:147066:6131:1","source":"bangumi"}]},{"characterId":"char_c32569","characterName":"原口 真奈美","sourceIds":{"bangumi":[{"characterId":"147067","match":"exact-normalized-name-in-linked-work","subjectId":"419313"}],"egsCharacterIds":["14955"],"vndbCharacterId":"c32569"},"originalCharacterName":"原口 真奈美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"由紀の連れ子で、主人公の義姉。女子大生。"},{"spoiler":false,"text":"性格はあかるく大らかで、天然なのか、主人公の前でついつい下着のままうろうろしてしまうこともあるが、好きな人の前では気弱になって普通に話せなくなってしまう可愛らしい一面も。しかし、酔っ払うと途端に大胆なる。"},{"spoiler":false,"text":"その酒癖から主人公に襲いかかってしまい……。"},{"spoiler":false,"text":"「あぁ、このままじゃ絶対に遅刻しちゃう！　大切なゼミなのにどうしよう!?」"}],"source":"egs","sourceCharacterId":"14955","sourceWorkId":"12752","spoiler":false},{"segments":[{"spoiler":false,"text":"由紀の娘で京介の義姉である女子大生。"},{"spoiler":false,"text":"明るくおおらかで、京介の前でも下着姿でうろうろすることもしばしば。"},{"spoiler":false,"text":"その反面、好きな人には告白できないほど弱気な一面も持っているが、酔うと抑えていた気持ちが爆発し、好きな人に対して大胆になってしまうという癖がある。"},{"spoiler":false,"text":"酔った勢いで京介を襲ってから肉体関係を持つことに。"},{"spoiler":false,"text":"「あぁ、このままじゃ絶対遅刻しちゃう！ 大切なゼミなのにどうしよう!?」"}],"source":"bangumi","sourceCharacterId":"147067"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16cc92a2d660eb4019268963779b7f7b328e0cf2f4d20e2272228d9534bc995a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/751603187d02c1750ee669f1cea25a43d66df771e4c0a7be6445c04aab28bc08.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:419313:147067:4956:1","source":"bangumi"}]},{"characterId":"char_c32570","characterName":"原口 理沙","sourceIds":{"bangumi":[{"characterId":"147068","match":"exact-normalized-name-in-linked-work","subjectId":"419313"}],"egsCharacterIds":["14956"],"vndbCharacterId":"c32570"},"originalCharacterName":"原口 理沙","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"由紀の連れ子で、主人公の同い年の義姉。"},{"spoiler":false,"text":"小悪魔的な性格で、性にも奔放。ウブな主人公をからかい半分に、ファーストキスの相手を務めたり、手コキをしてあげるなど、色んなエッチな手解きをして楽しんでいる。"},{"spoiler":false,"text":"姉の真奈美が主人公に好意を抱いていることに気付き、一肌どころかもろ肌脱いで橋渡しをしてあげようと……。"},{"spoiler":false,"text":"「ねぇ京介、さっきは真奈美ねえさんの下着姿見て、かなり興奮しちゃったんじゃない？」"}],"source":"egs","sourceCharacterId":"14956","sourceWorkId":"12752","spoiler":false},{"segments":[{"spoiler":false,"text":"由紀の娘で京介の義姉である女子学生。"},{"spoiler":false,"text":"京介をからかって楽しんでいるようで、ことあるごとに性的なことも含めてちょっかいをかけてくる。"},{"spoiler":false,"text":"初な弟に色々手ほどきをするのが面白いらしく、初めてのキスや手コキの相手になっている。"},{"spoiler":false,"text":"母親の由紀には負けるものの、90センチを超えるであろう巨乳の持ち主で、その美巨乳で京介にパイズリ奉仕して楽しむことも。"},{"spoiler":false,"text":"姉の真奈美が京介に好意を抱いていることに気付き、橋渡しをしてあげるなど姉思いの面ももっている。"},{"spoiler":false,"text":"「ねえ京介、さっきは真奈美ねえさんの下着姿を見て、かなり興奮しちゃったんじゃない？」"}],"source":"bangumi","sourceCharacterId":"147068"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5dc70b78d275be264b05b83eeef46e3737e5dd22b686a19a21c8a238cd7f3a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25333c89f9ea41466ffd915c729fba6f0d99e7aa9ae1ebf09ae8a78dee402efa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:419313:147068:6106:1","source":"bangumi"}]},{"characterId":"char_vndb_c50741","characterName":"原口 京介","sourceIds":{"vndbCharacterId":"c50741"},"originalCharacterN