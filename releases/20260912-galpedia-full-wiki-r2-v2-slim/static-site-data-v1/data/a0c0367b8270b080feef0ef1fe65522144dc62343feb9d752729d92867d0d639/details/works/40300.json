descriptions":[{"segments":[{"spoiler":false,"text":"A detective in the “Special Division for Anomalous Crimes,” assigned to cases steeped in the mysterious and inexplicable. He may appear carefree, but his deep knowledge and quiet empathy drive him to pursue truth for the victims’ sake. Haunted by past trauma, he refuses to embrace modern technology, relying instead on an outdated ARI device with only the most basic functions."},{"spoiler":false,"text":"From Official English website"}],"source":"vndb","sourceCharacterId":"c156978"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a75548224a05ff72b0c92dcca46e01aa202d2d6cae71fcdbea2690a938b4932.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/111a0e9a588ebefb574d1089c21c9eab65621950938c000ed88f3e5fdb8b3695.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阿座上 洋平","creatorId":"vndb:s149","sourcePersonId":"vndb:s149","canonicalEntityId":"vndb:s149","name":"阿座上 洋平","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:96957","source":"vndb"}]},{"characterId":"char_vndb_c156979","characterName":"クイン理音","sourceIds":{"vndbCharacterId":"c156979"},"originalCharacterName":"クイン理音","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A brilliant, eccentric engineer and the creator of the AR system “Echoes of Kyoto.” She feels more at home in the digital world than in reality, making face-to-face interaction a challenge. A devoted cat lover, she carries a cat-shaped ARI device named Galaxy, which she treats as a treasured companion."},{"spoiler":false,"text":"From Official English website"}],"source":"vndb","sourceCharacterId":"c156979"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/cabdfbd45e917ee45e5278ea712ad99c977965a7606b3b7a47ec5534a673725e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2be0f37eceba5ce9d78a657ce4c1cd26643ae64ffd91db308c3ee3c1506ce8c4.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天麻 ゆうき","creatorId":"vndb:s47251","sourcePersonId":"vndb:s47251","canonicalEntityId":"vndb:s47251","name":"天麻 ゆうき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:96963","source":"vndb"}]},{"characterId":"char_vndb_c156980","characterName":"長浜 正義","sourceIds":{"vndbCharacterId":"c156980"},"originalCharacterName":"長浜 正義","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Meiji-era detective who upholds law, order, and honor as absolute ideals. He embodies the spirit of both the traditional samurai and the forward-looking Meiji era. Though his strict bearing suggests severity, beneath it lies a kind heart and a deep empathy for those he serves."},{"spoiler":false,"text":"From Official English website"}],"source":"vndb","sourceCharacterId":"c156980"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9befcf06fa12a35b4f2ad1bbbbb7b1eae9031ad2993a069f9316a20350c5cff0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a59868ce5b21c2734c14e7703b57b9514f21806c8c50b11a138d1efa7d6f9abd.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"置鮎 龍太郎","creatorId":"vndb:s747","sourcePersonId":"vndb:s747","canonicalEntityId":"vndb:s747","name":"置鮎 龍太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:96959","source":"vndb"}]},{"characterId":"char_vndb_c156981","characterName":"咲","sourceIds":{"vndbCharacterId":"c156981"},"originalCharacterName":"咲","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The most captivating geisha in Kyoto, renowned for her elegance and allure. Behind her beauty is a sharp intellect and a wealth of cultural knowledge. With an information network stretching across Gion, she helps guide Masayoshi’s investigations from the shadows."},{"spoiler":false,"text":"From Official English website"},{"spoiler":true,"text":"Her real name is Take."}],"source":"vndb","sourceCharacterId":"c156981"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/9114288896e1f52540627955a49063f3f708f5e2298f4cdc60bf9a4d09139304.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3fdca808d26e1735dba40db0299e52af6e106308cb73cd501fd5bfcd306962f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"日笠 陽子","creatorId":"vndb:s616","sourcePersonId":"vndb:s616","canonicalEntityId":"vndb:s616","name":"日笠陽子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:96958","source":"vndb"}]},{"characterId":"char_vndb_c156982","characterName":"ヒカリ","sourceIds":{"vndbCharacterId":"c156982"},"originalCharacterName":"ヒカリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoi