egments":[{"spoiler":false,"text":"エリック学園のフィギュアスケート部に所属する女子学生。"},{"spoiler":false,"text":"日本選手権で二連覇を成し遂げた実力者で、将来を嘱望される逸材。"},{"spoiler":false,"text":"また、その美貌からアイドル的な人気を博している。"},{"spoiler":false,"text":"優しく面倒見が良い聡明な性格だが、極度の男性恐怖症で、男性の手を触れただけでも卒倒してしまうほど。"},{"spoiler":false,"text":"接する時間の長い主人公とは、多少、その男性恐怖症も緩和されてようにも見えるが……。"}],"source":"egs","sourceCharacterId":"25768","sourceWorkId":"7263","spoiler":false},{"segments":[{"spoiler":false,"text":"日本選手権2連覇の超実力者。その美貌から日本フィギュアスケート界のアイドルで、次のオリンピックの目玉的存在。その美しい演技は日本では敵なし。主人公は是非3連覇をと思っているが本人はあまり興味は無いようだ。"},{"spoiler":false,"text":"極度の男性恐怖症だが、主人公と一緒にいると嬉しそうだ。"}],"source":"bangumi","sourceCharacterId":"136630"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"25768","sourceWorkId":"7263","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"25768","sourceWorkId":"7263","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"25768","sourceWorkId":"7263","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"25768","sourceWorkId":"7263","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"46 kg","valueContext":null,"source":"egs","sourceCharacterId":"25768","sourceWorkId":"7263","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a45c88ce6cb203cc536e7ce652b101bc59c236db25ba82b0fb753a08a1439c17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6773301c2677cd8ba48c97f0a0994c9cad0025850497ece816e2761af8548cd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永瀬江美弥","creatorId":"vndb:s61","sourcePersonId":"vndb:s61","canonicalEntityId":"vndb:s61","name":"永瀬 いくみ","roleCode":"voice-acto