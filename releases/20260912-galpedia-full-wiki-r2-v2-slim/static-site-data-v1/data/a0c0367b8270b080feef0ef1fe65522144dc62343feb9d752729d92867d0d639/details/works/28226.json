{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"28226","model":{"presentationWorkId":"vndb:v26446","staff":{"artwork":[{"creditedName":"斎藤なつき","creatorId":"vndb:s2566","sourcePersonId":"egs:creator:105","canonicalEntityId":"vndb:s2566","name":"斎藤なつき","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:212157","source":"egs"},{"creditedName":"JAMBREAD","creatorId":"vndb:s9847","sourcePersonId":"egs:creator:27657","canonicalEntityId":"vndb:s9847","name":"JAMBREAD","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:212159","source":"egs"}],"scenario":[{"creditedName":"反事象桂林","creatorId":"vndb:s3722","sourcePersonId":"egs:creator:106","canonicalEntityId":"vndb:s3722","name":"反事象桂林","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:212158","source":"egs"}],"music":[],"other":[{"creditedName":"ざくそん","creatorId":"vndb:s9317","sourcePersonId":"vndb:s9317","canonicalEntityId":"vndb:s9317","name":"ざくそん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:159695","source":"vndb"}]},"cast":[{"characterId":"char_c47589","characterName":"シンフォニックシュガー","sourceIds":{"bangumi":[{"characterId":"96141","match":"exact-normalized-name-in-linked-work","subjectId":"222233"}],"egsCharacterIds":["2314"],"vndbCharacterId":"c47589"},"originalCharacterName":"シンフォニックシュガー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"AB"},"bust":{"reviewState":"source-only","source":"vndb","value":"76"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"普段は物静かな天才科学者。シンフォニックリリーに信頼以上の気持ちを寄せいている。"},{"spoiler":false,"text":"対ファルケ・シルヴァ抵抗組織『白薔薇』のメンバーとして莉々奈を奪回しようとエクセリウムで活動中。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"冷静沈着ながら敵対した相手には容赦のない攻撃をする。"},{"spoiler":false,"text":"今まで虚勢を張りながらも堕ちきらなかった彼女が心の支えのない中精神を疲労させていき姦計にはまっていく。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"19685","spoiler":false},{"segments":[{"spoiler":false,"text":"「私の声が聞こえたのなら、きっと莉々奈さんが私を呼んでくれたからです」"},{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"普段は物静かで冷静沈着な天才科学者。"},{"spoiler":false,"text":"莉々奈とは厚い信頼関係に結ばれており、理論・技術面から百合瀬財団の活動を支えている。"},{"spoiler":false,"text":"幼げな容姿に似合わない強靭な意思と折れない心を持つ。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士シンフォニックナイツ」ほか"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"天才的な頭脳を持つ世界的な科学者。"},{"spoiler":false,"text":"シンフォニックリリーとともに国際教導学園から身を引き、自らの魔法研究を進める傍ら魔法戦士として活動を続けている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"28226","spoiler":false},{"segments":[{"spoiler":false,"text":"歴戦の魔法戦士、シンフォニックナイツの一人。"},{"spoiler":false,"text":"物静かで冷静沈着、数々の魔法理論や技術を開発している天才科学者。"},{"spoiler":false,"text":"現在は異世界ロアにて研究活動を行っており、時折レムティアシータに技術的なアドバイスを与えている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"31509","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックナイツの一人、シンフォニックシュガー。本名は甘樹菜々芭。"},{"spoiler":false,"text":"優秀な技術者で、魔法戦士たちの新たな力をいくつも開発する。"},{"spoiler":false,"text":"国際教導学園で教師として働きながら、魔法技術の研究も怠らない。"},{"spoiler":false,"text":"シンフォニックリリーである百合瀬莉々奈とは深い絆で結ばれたパートナー。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックナイツの一人、シンフォニックシュガー。優秀な研究者、技術者として、魔法戦士たちの勝利を支えている。同じシンフォニックナイツの一人である莉々奈とは深い絆で結ばれており、彼女の経営する国際教導学園で教師としても働いている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"40423","spoiler":false},{"segments":[{"spoiler":false,"text":"見た目は幼げな、物静かで無表情な天才技術者"},{"spoiler":false,"text":"集中し始めると周りのことが全く目に入らなくなる"},{"spoiler":false,"text":"その明晰な頭脳を巡って両親が争い、挙げ句二人ともが不慮の死を遂げたため、自分の持つ才能に嫌悪感すら持ってしまっていた。そのためか、感情の表現もうまくない。"},{"spoiler":false,"text":"莉々奈に出会ったことでその頭脳を人類のために役立てることに喜びと、両親への贖罪を見いだす。また、自分の力を役立てる道を見つけてくれた莉々奈に対し、信頼関係以上の感情を抱いている。"}],"source":"bangumi","sourceCharacterId":"96141"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/8609a430ae70cca7f0b6e759a667e02697a36c766f741c77a34be38ffd50cffc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/1712c987ff84caddb112cef83a5939ceff92a62c4c53b935d6c40b3f59bc9fff.webp","width":156,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:290282:96141:4810:1","source":"bangumi"}]},{"characterId":"char_c49836","characterName":"シンフォニックリリー","sourceIds":{"bangumi":[{"characterId":"96140","match":"exact-normalized-name-in-linked-work","subjectId":"200512"},{"characterId":"96140","match":"exact-normalized-name-in-linked-work","subjectId":"222233"},{"characterId":"96140","match":"exact-normalized-name-in-linked-work","subjectId":"222234"},{"characterId":"96140","match":"exact-normalized-name-in-linked-work","subjectId":"222242"}],"egsCharacterIds":["15746","16092"],"vndbCharacterId":"c49836"},"originalCharacterName":"シンフォニックリリー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"826"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"A"},"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"聡明で頭がよく、清楚、純真で強い正義感を持つ。"},{"spoiler":false,"text":"世界有数の百合瀬財閥の令嬢だが、そういったことをひけらかすことのない控えめな性格。"},{"spoiler":false,"text":"しかし、自分の立場や出自が持つ重要性は十分自覚している。"},{"spoiler":false,"text":"人にはない“魔力”という力を自分が持ってしまったことを恐れ、 悩んでいたが、ある日、かつてメッツァーと戦ったスイートナイツの存在を知り、彼女たちのように自分の力を正義のために使って悪と戦うことを決意。"},{"spoiler":false,"text":"魔力を利用した強化変身システムの開発を財閥の研究部門に指示、 自ら被験者となって研究を主導し、同時に運用・管理・バックアップを行う機関「ミネルヴァ・ガード」を創設。"},{"spoiler":false,"text":"完成したシステムを自ら装備し、はびこる悪と戦うためにシンフォニックナイツとなった。"}],"source":"egs","sourceCharacterId":"15746","sourceWorkId":"8708","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックリリー"},{"spoiler":false,"text":"私立白耀魔法学園の生徒会長にして百合瀬財閥の頭取。"},{"spoiler":false,"text":"常に冷静な判断力と柔らかな人当たりで生徒からの信頼も厚い。"},{"spoiler":false,"text":"趣味は音楽鑑賞。"},{"spoiler":false,"text":"特に生徒会室では常にクラシックが流れている。"}],"source":"egs","sourceCharacterId":"15746","sourceWorkId":"12050","spoiler":false},{"segments":[{"spoiler":false,"text":"百合瀬財団当主として忙しい日々を送りながら、次世代の魔法戦士を育てるために、国際教導学園を買い取って魔法教育に力を入れている。"}],"source":"egs","sourceCharacterId":"15746","sourceWorkId":"26584","spoiler":false},{"segments":[{"spoiler":false,"text":"聡明、清楚、純真で強い正義感を持つ。"},{"spoiler":false,"text":"世界有数の百合瀬財閥の令嬢。"},{"spoiler":false,"text":"『魔法戦士シンフォニックナイツ』に登場するヒロイン。"},{"spoiler":false,"text":"今作ではファルケの毒牙にかかり、彼を支援する。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"10418","spoiler":false},{"segments":[{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"清純可憐な百合瀬財団の当主だったが、そのあまりにも正義に純粋な心を利用されて、ファルケに調教されてしまう。"},{"spoiler":false,"text":"現在はファルケの配下となって彼の野望のために活動中。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"「あなたに身も心も翻弄されていた、以前の私とは違います」"},{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"清純可憐で聡明な、世界的財閥である百合瀬財団の当主。"},{"spoiler":false,"text":"ファルケに調教されて配下となっていたが、今は正義の心を取り戻して平和のために尽くしており、『ゲート計画』の危険性を見抜き、計画を阻止すべく行動している。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士シンフォニックナイツ」ほか"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"世界的財閥である百合瀬財団の当主。"},{"spoiler":false,"text":"様々な事情から国際教導学園の運営から退き、魔法戦士としての任務を全うするべく日々活動している。"},{"spoiler":false,"text":"現在は魔法犯罪者の大量脱走事件を追っている。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"28226","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックナイツの一人、シンフォニックリリー。本名は百合瀬莉々奈。"},{"spoiler":false,"text":"世界有数の規模を誇る百合瀬財団の総帥。国際教導学園の理事長でもある。"},{"spoiler":false,"text":"生まれ持ったカリスマ性、優れた知力、卓越した戦術眼で、魔法戦士の指揮官のようなポジションとして活躍している。"},{"spoiler":false,"text":"指揮だけでなく、自ら前線で戦うことも珍しくない。"},{"spoiler":false,"text":"財界や政界とのつながりもあり、魔法戦士が十全に活躍できるよう各界と様々な調整を行っている。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"世界有数の財閥である百合瀬財閥の総帥にして、魔法戦士シンフォニックナイツの一人、シンフォニックリリー。魔法戦士が多く集まる国際教導学園の理事長でもある。その卓越した能力とカリスマ性で、前線で戦いながら魔法戦士たちを指揮することも多い。財界や政界とのつながりもあり、魔法戦士の障害にならぬよう各界と様々な調整を行っている。最近、過去の調教の記憶を悪夢としてみるようになり、そのことで悩んでいる。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"40423","spoiler":false},{"segments":[{"spoiler":false,"text":"聡明で頭がよく、清楚、純真で強い正義感を持つ。"},{"spoiler":false,"text":"世界有数の百合瀬財閥の令嬢だが、そういったことをひけらかすことのない控えめな性格。"},{"spoiler":false,"text":"しかし、自分の立場や出自が持つ重要性は十分自覚している。"},{"spoiler":false,"text":"人にはない“魔力”という力を自分が持ってしまったことを恐れ、 悩んでいたが、ある日、かつてメッツァーと戦ったスイートナイツの存在を知り、彼女たちのように自分の力を正義のために使って悪と戦うことを決意。"},{"spoiler":false,"text":"魔力を利用した強化変身システムの開発を財閥の研究部門に指示、 自ら被験者となって研究を主導し、同時に運用・管理・バックアップを行う機関『ミネルヴァ・ガード』を創設。"},{"spoiler":false,"text":"完成したシステムを自ら装備し、はびこる悪と戦うためにシンフォニックナイツとなった。"}],"source":"bangumi","sourceCharacterId":"96140"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/265b82f2a42d6fc45d4e7fe1bfdd98cf7d11568ff4b703a4ff4ff08f76e8a55f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/968d921c14904fe34f7955a05b9572d701679c10f058cb86ad083c96446f3e0c.webp","width":156,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤邑鈴香","creatorId":"vndb:s2309","sourcePersonId":"vndb:s2309","canonicalEntityId":"vndb:s2309","name":"藤邑鈴香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:290282:96140:16173:1","source":"bangumi"}]},{"characterId":"char_vndb_c125391","characterName":"甘樹 菜々芭","sourceIds":{"vndbCharacterId":"c125391"},"originalCharacterName":"甘樹 菜々芭","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"606"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"76"},"height":{"reviewState":"source-only","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"},"weight":{"reviewState":"source-only","source":"vndb","value":"39"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb447f2d258b4fd0e72b6b88b3586da31e099e18546563e1f703fedcec4354a9.webp","fallbackUrl":"https:/