94","source":"vndb"},{"creditedName":"まついさん","creatorId":"vndb:s22108","sourcePersonId":"vndb:s22108","canonicalEntityId":"vndb:s22108","name":"松井 章","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:215495","source":"vndb"},{"creditedName":"鳥島 烏","creatorId":"vndb:s36268","sourcePersonId":"vndb:s36268","canonicalEntityId":"vndb:s36268","name":"鳥島烏","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:215496","source":"vndb"},{"creditedName":"古山・F・半兵衛","creatorId":"vndb:s45928","sourcePersonId":"vndb:s45928","canonicalEntityId":"vndb:s45928","name":"古山・F・半兵衛","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:215497","source":"vndb"},{"creditedName":"三澄 クラゲ","creatorId":"vndb:s45930","sourcePersonId":"vndb:s45930","canonicalEntityId":"vndb:s45930","name":"三澄 クラゲ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:215498","source":"vndb"},{"creditedName":"まいじん","creatorId":"vndb:s45931","sourcePersonId":"vndb:s45931","canonicalEntityId":"vndb:s45931","name":"まいじん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:215499","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c152146","characterName":"アイリア","sourceIds":{"vndbCharacterId":"c152146"},"originalCharacterName":"アイリア","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A pure and innocent girlhood."},{"spoiler":false,"text":"Born as a princess in the land of fairies and raised with great care, she grew up sheltered and ignorant of the world and its norms."},{"spoiler":false,"text":"After losing her mother, the queen, to illness and having her homeland invaded, she is forced to wander the world as a slave."},{"spoiler":false,"text":"She had no knowledge or experience of sexuality, but learns desperately in order to survive."},{"spoiler":false,"text":"Her personality is quiet and shy, always reading the mood and trying not to upset others."},{"spoiler":false,"text":"At first, she only laments her misfortune, but gradually she begins to carve out her own path through her own choices."}],"source":"vndb","sourceCharacterId":"c152146"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1ca9e7fe0391fbf50e5154038bdc460019c75e3913a4c5e2c4a1a2547a15e8e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1defa38a7727495c8f7c39b4b014e65a010c9a15637e1433f3016cd85c961dfe.webp","width":160,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高梨 はなみ","creatorId":"vndb:s5060","sourcePersonId":"vndb:s5060","canonicalEntityId":"vndb:s5060","name":"みたか りん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:100298","source":"vndb"}]},{"characterId":"char_vndb_c152148","characterName":"アイリア","sourceIds":{"vndbCharacterId":"c152148"},"originalCharacterName":"アイリア","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Her youth spent earning money as a prostitute while striving to return to her homeland."},{"spoiler":false,"text":"For over a decade, she wandered as a prostitute and came to master the skills needed to survive."},{"spoiler":false,"text":"Because of that, her personality has changed—compared to her naive childhood, she now sees things with calm discernment."},{"spoiler":false,"text":"During her journey, she"},{"spoiler":true,"text":"experiences pregnancy and childbirth, becoming a mother, but feeling she cannot be with her child in her current state, she parts ways with them."},{"spoiler":true,"text":"When she learns that her homeland has been destroyed, she is overwhelmed by despair."},{"spoiler":true,"text":"Even so, she manages to rise again, and together with her reunited daughter, sets her sights on restoring their fallen homeland."}],"source":"vndb","sourceCharacterId":"c152148"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6dafea708a3eb337c3906d5b84167fbb8b3cf65fb5e0ff9fc27448de89f4589b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90df128798719dbb359189452af7e1e54d7a1e3f113937b5f2362eb0289c6382.webp","width":123,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高梨 はなみ","creatorId":"vndb:s5060","sourcePersonId":"vndb:s5060","canonicalEntityId":"vndb:s5060","name":"みたか りん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:100299","source":"vndb"}]},{"characterId":"char_vndb_c152149","characterName":"アイリア","sourceIds":{"vndbCharacterId":"c152149"},"originalCharacterName":"アイリア","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":true,"text":"An era in which she gathers prostitutes from around the world to establish a nation."},{"spoiler":true,"text":"Several decades have passed since her youth, and she has fully matured into a graceful, beautiful woman."},{"spoiler":true,"text":"The small brothel that began as the first step toward restoring her homeland has grown to the scale of what can be called an entire nation."},{"spoiler":true,"text":"She declares its founding and reclaims her place as princess—Airia."},{"spoiler":false,"text":"Gentle and warm-hearted, she believes in the power of expressing love and dislikes conflict."}],"source":"vndb","sourceCharacterId":"c152149"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d0597731297e8932b9a1b6a534ec1273d2a9cfb9168add3fd083c7c3b097bae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/265ac3c2cf195e46954b05ad14f7afceb7d8bea2139d2929c924015e89e8e24d.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高梨 はなみ","creatorId":"vndb:s5060","sourcePersonId":"vndb:s5060","canonicalEntityId":"vndb:s5060","name":"みたか りん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:100300","source":"vndb"}]},{"characterId":"char_vndb_c155391","characterName":"エルム","sourceIds":{"vndbCharacterId":"c155391"},"originalCharacterName":"エルム","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d8d3f31ff6002ca8edef66445f6e0f0da6eaaa9a739a5713a968b4e43403365.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fdde201046031813ebd4cdb45428f4cfca91eaceaf14d1937595de1cb993dc3a.webp","width":228,"height":256,"source":"static-detail"},"actors":[{"creditedName":"綾音 まこ","creatorId":"vndb:s2581","sourcePersonId":"vndb:s2581","canonicalEntityId":"vndb:s2581","name":"綾音 まこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:100297","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p11244","sourceCompanyId":"egs:brand:6784","canonicalEntityId":"vndb:p11244","name":"だーくワン!","role