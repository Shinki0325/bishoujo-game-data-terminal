る。"}],"source":"egs","sourceCharacterId":"6068","sourceWorkId":"21430","spoiler":false},{"segments":[{"spoiler":false,"text":"何でも言うことを聞いてしまう天使タイプ。"},{"spoiler":false,"text":"“流した汗は裏切らない！” をモットーに、ひたむきにアイドル活動をしている。"},{"spoiler":false,"text":"前妻の連れ子という日陰者であるため、自分という人間に負い目を感じている。"},{"spoiler":false,"text":"そしてその全てを知ったうえで受け入れてくれた主人公に憧れを抱き、崇拝している。"}],"source":"bangumi","sourceCharacterId":"28397"}],"profileFacts":[{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"6068","sourceWorkId":"21430","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0ca17d29fd83da05c25e2d23abcd05325ba9f767ab88bb93952b6f7e5e0ab56.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0aa878acaf761d168611fb2497d9d28c9f406fb6805b8b75d962a28316ae2c4e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:120360:28397:6016:1","source":"bangumi"}]},{"characterId":"char_c31062","characterName":"南野 今日子","sourceIds":{"bangumi":[{"characterId":"28398","match":"exact-normalized-name-in-linked-work","subjectId":"120360"}],"egsCharacterIds":["6069"],"vndbCharacterId":"c31062"},"originalCharacterName":"南野 今日子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"I"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"強気な外見とは裏腹にしっかりしているようでおっとり、ちょっとお姉さんタイプ。 ３人のよきまとめ役として機能する。"},{"spoiler":false,"text":"主人公の提案を何でも信じてしまう。"},{"spoiler":false,"text":"「お前のためだ」、「仲間のために」「俺を信じてほしい」 そういった、殺し文句に騙されて主人公に好き放題されてしまう。"},{"spoiler":false,"text":"他のヒロイン達にもそうだが、主人公も彼女には甘える姿勢をとることが多い。"}],"source":"egs","sourceCharacterId":"6069","sourceWorkId":"21430","spoiler":false},{"segments":[{"spoiler":false,"text":"少し強気な印象とは裏腹に、おっとりとしたお姉さんタイプ。"},{"spoiler":false,"text":"3人の中では一番のしっかり者で、良きまとめ役として機能している。"},{"spoiler":false,"text":"美穂・明菜だけでなく、主人公も時には彼女に甘えてしまうことも。"},{"spoiler":false,"text":"「お前のためだ」 「俺を信じてほしい」 などと都合のいい殺し文句に釣られて、主人公の提案を何でも信じてしまう。"}],"source":"bangumi","sourceCharacterId":"28398"}],"profileFacts":[{"label":"罩杯（本版本）","value":"i","valueContext":null,"source":"egs","sourceCharacterId":"6069","sourceWorkId":"21430","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/6209db7417a922a9b7f80643a76b55d7db3b459d45da715bf8bb74f8c283bddb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d5cb80b7aa579dc0fb686ab7deb25239e8cc6275bc821beeadc55bc8fec2ba9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中理々","creatorId":"vndb:s1977","sourcePersonId":"vndb:s1977","canonicalEntityId":"vndb:s1977","name":"田中 理々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:120360:28398:17081:1","source":"bangumi"}]},{"characterId":"char_c31063","characterName":"浅香 明菜","sourceIds":{"bangumi":[{"characterId":"28399","match":"exact-normalized-name-in-linked-work","subjectId":"120360"}],"egsCharacterIds":["6070"],"vndbCharacterId":"c31063"},"originalCharacterName":"浅香 明菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"自分を可愛いと思っているわりとこまっしゃくれキャラ。"},{"spoiler":false,"text":"子役あがりで、アイドル声優に転向しようとしてる。"},{"spoiler":false,"text":"やや胸が控えめなのがコンプレックス。"},{"spoiler":false,"text":"しったかぶりの耳年増。大人未満。 いちいち他人をライバル視しており、体つきはグラビア娘と比較し、人気などは正統派アイドルと比較する。"},{"spoiler":false,"text":"「どうせすぐ汚れるくせに」などが口癖。"},{"spoiler":false,"text":"ちょっと、挑発してやればムキになり食いさかっがくるため扱いやすい。"}],"source":"egs","sourceCharacterId":"6070","sourceWorkId":"21430","spoiler":false},{"segments":[{"spoiler":false,"text":"自分のことを可愛いと思っている小生意気なタイプ。"},{"spoiler":false,"text":"子役あがりでアイドル声優に転向しようとしている。"},{"spoiler":false,"text":"知ったかぶりの耳年増で、「どうせすぐ汚れるくせに」 などが口癖。"},{"spoiler":false,"text":"負けず嫌いな性格で、つい他人をライバル視してしまう。"},{"spoiler":false,"text":"ちょっと挑発してやればムキになるため扱いやすい。"}],"source":"bangumi","sourceCharacterId":"28399"}],"profileFacts":[{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"6070","sourceWorkId":"21430","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b008d72f7c52f1abfb67b4b8af8d66865bc202f9349163a7ddf75272489da53.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c9eaf15baa809cbcf756aaa9f09bd176deebd71e25f6617d67246a6c67fbc943.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西野ゆみこ","creatorId":"vndb:s934","sourcePersonId":"vndb:s934","canonicalEntityId":"vndb:s934","name":"西野 ゆみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:120360:28399:14142:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p2863","sourceCompanyId":"egs:brand:3650","canonicalEntityId":"vndb:p2863","name":"D:drive.","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:21430:3650","source":"egs"},{"companyId":"vndb:p2863","sourceCompanyId":"vndb:p2863","canonicalEntityId":"vndb:p2863","name":"D:drive.","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:162465:v16469