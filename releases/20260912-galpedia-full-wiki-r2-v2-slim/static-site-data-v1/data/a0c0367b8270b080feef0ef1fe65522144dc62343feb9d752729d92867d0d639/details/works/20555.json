lue":"m","source":"vndb","sourceCharacterId":"c26314","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"4313","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"4313","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"55383","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91eef73d7d4ecf00c2e8335eeb1c1b2c5466884bf04f00926aeb6933ce4ab8bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44a05b57942dfdbd3019f9c5a610cb148a406c7c7f640cdfd1cba30f2e43ce15.webp","width":166,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:107645:55383:11646:1","source":"bangumi"}]},{"characterId":"char_c26315","characterName":"住山 暁","sourceIds":{"bangumi":[{"characterId":"55384","match":"exact-normalized-name-in-linked-work","subjectId":"107645"}],"egsCharacterIds":["4314"],"vndbCharacterId":"c26315"},"originalCharacterName":"住山 暁","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Unknown to protag that he is childhood friend he knew back in the day. He was consider to be one of the toughest and strongest kids when growing. His reputation followed him even after cross dressing as a scary woman despite having little proof to this. Is very kind and friendly to protag an seen as being good buddies again after learning secret."},{"spoiler":true,"text":"Is a poor student forced to cross dress. According to school they will lower fees if men who can't afford cross dressing. After reuniting with protag is very happy but soon becomes jealous. Seeing him be sexual harassed by other 2 heros he decides to protect him by becoming his older sister that will help him sexually. But really just afraid to tell him his true feelings."}],"source":"vndb","sourceCharacterId":"c26315"},{"segments":[{"spoiler":false,"text":"先輩の不良っぽい男の娘"},{"spoiler":false,"text":"実は主人公の幼なじみ。"},{"spoiler":false,"text":"かつて主人公にとって男の憧れのような頼れる兄貴分だったのだが今はすっかり女の子らしくなっているので主人公は複雑。"},{"spoiler":false,"text":"男の心を残している暁は女装に関してはかなり不本意。学費免除など優遇されるためイヤイヤ女装している。"},{"spoiler":false,"text":"今回のカミングアウト事件でようやく自分の正体を告げることが出来てほっとしている。"},{"spoiler":false,"text":"昔と変わらない男子として近づいていくのだが腕組みされたりすると、主人公はかなり女の子として意識してしまう。"},{"spoiler":false,"text":"最終的に自分が男の娘であることを自覚して男姉ちゃん（おねえちゃん）として覚醒。"},{"spoiler":false,"text":"主人公の下半身のお世話をしようとして乗り込んでくることに。"}],"source":"egs","sourceCharacterId":"4314","sourceWorkId":"20555","spoiler":false},{"segments":[{"spoiler":false,"text":"先輩の不良っぽい男の娘"},{"spoiler":false,"text":"実は主人公の幼なじみ。"},{"spoiler":false,"text":"かつて主人公にとって男の憧れのような頼れる兄貴分だったのだが今はすっかり女の子らしくなっているので主人公は複雑。"},{"spoiler":false,"text":"男の心を残している暁は女装に関してはかなり不本意。学費免除など優遇されるためイヤイヤ女装している。"},{"spoiler":false,"text":"今回のカミングアウト事件でようやく自分の正体を告げることが出来てほっとしている。"},{"spoiler":false,"text":"昔と変わらない男子として近づいていくのだが腕組みされたりすると、主人公はかなり女の子として意識してしまう。"},{"spoiler":false,"text":"最終的に自分が男の娘であることを自覚して男姉ちゃん（おねえちゃん）として覚醒。"},{"spoiler":false,"text":"主人公の下半身のお世話をしようとして乗り込んでくることに。"}],"source":"bangumi","sourceCharacterId":"55384"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c26315","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"4314","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"4314","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"55384","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5e0c8ebecb8cf17bfffcf283144691c7aefe8241092702cdae81526269718a4.webp",