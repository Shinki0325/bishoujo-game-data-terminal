Name":"松浦 幸治","creatorId":"vndb:s47878","sourcePersonId":"vndb:s47878","canonicalEntityId":"vndb:s47878","name":"松浦 幸治","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:16952","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c5276","characterName":"パルフェ・シュクレール","sourceIds":{"vndbCharacterId":"c5276"},"originalCharacterName":"パルフェ・シュクレール","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A witch apprentice who inherited the \"Black Cat Magic Shop\" from her deceased mother. She is a third-year high school student at Flor Hermos Magic Academy, but she is taking a leave of absence to concentrate on running the store. Parfait's father was a court mage, but her died when Parfait was just one year old. Despite that, Parfait has a cheerful disposition. She is clumsy and prefers to do things at her own pace. Her catchphrase is \"Hamyu\"."},{"spoiler":false,"text":"Translated from Wikipedia."}],"source":"vndb","sourceCharacterId":"c5276"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/498b7bc27173bc970732099772a3e5e952936da6795923f90bd3e50b10896312.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b5a7916b13b8d5363dd4dcb154430b898c55f0741252b886cedfe9c50ac33ea.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"古山 きみこ","creatorId":"vndb:s1596","sourcePersonId":"vndb:s1596","canonicalEntityId":"vndb:s1596","name":"こやま きみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8415","source":"vndb"},{"creditedName":"양 정화","creatorId":"vndb:s11866","sourcePersonId":"vndb:s11866","canonicalEntityId":"vndb:s11866","name":"양 정화","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8422","source":"vndb"}]},{"characterId":"char_vndb_c5283","characterName":"サケマス","sourceIds":{"vndbCharacterId":"c5283"},"originalCharacterName":"サケマス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A male black cat who acts as a familiar of Parfait. He can understand and speak human language, but he can be rude sometimes. Sakemasu's hair is tinged with magic, so from time to time it is used as a material of the store's products."},{"spoiler":false,"text":"Translated from Wikipedia."}],"source":"vndb","sourceCharacterId":"c5283"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cd20e1ad7c0caacd42b73f98c1f8cc0f5f45a277606e0f008bb939cde75a987.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d79ff5019be7560de3de61faf2f7593a503e467e69dadca01bd2a711de8e5027.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三田 ゆう子","creatorId":"vndb:s11949","sourcePersonId":"vndb:s11949","canonicalEntityId":"vndb:s11949","name":"三田 ゆう子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8424","source":"vndb"},{"creditedName":"최 준영","creatorId":"vndb:s25627","sourcePersonId":"vndb:s25627","canonicalEntityId":"vndb:s25627","name":"최 준영","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8426","source":"vndb"}]},{"characterId":"char_vndb_c5284","characterName":"フローレ・ミルフィア","sourceIds":{"vndbCharacterId":"c5284"},"originalCharacterName":"フローレ・ミル