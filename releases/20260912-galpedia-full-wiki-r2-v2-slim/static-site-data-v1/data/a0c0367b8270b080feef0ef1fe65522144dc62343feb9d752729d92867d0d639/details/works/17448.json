ges/5a/5a8ae23e586997dc96d6ac8163899a977cc224111519681cdcca4d6a12abb155.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/963c4c2823e2ea2e59125875984576bfeb0a7300cca6d65c6cac32d4646e9548.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c12519","characterName":"千歳","sourceIds":{"vndbCharacterId":"c12519"},"originalCharacterName":"千歳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"805"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Known as the Demon Chieftain of the Nine Provinces of the Western Seas, he is also a member of the Ten-Demon Alliance. He has short light brown hair, red-colored eyes, and pale skin."},{"spoiler":false,"text":"Chitose is the most cheerful out of all of the characters. His easygoing nature makes him very popular with other demons. He is somewhat over-confident, often letting a little praise go to his head. What makes him attractive to you is that he has a very expressive face and you are never bored in his presence."},{"spoiler":false,"text":"Taken from Demon's bond wiki"}],"source":"vndb","sourceCharacterId":"c12519"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d75ba2f75511f9c0e7f81ae712d7e6999fe383ad9e07642a4c104c7602095b03.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8fa6aa57dd5b6acdfe11046bda924514cb33fee2048f1995fe06ef8a3f3cb6c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤 健太郎","creatorId":"vndb:s89","sourcePersonId":"vndb:s89","canonicalEntityId":"vndb:s89","name":"伊藤健太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45283","source":"vndb"}]},{"characterId":"char_vndb_c12520","characterName":"千耶","sourceIds":{"vndbCharacterId":"c12520"},"originalCharacterName":"千耶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"211"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kazuya is the Demon Chieftain of the Six Districts of Mutsu and a member of the Ten-Demon Alliance."},{"spoiler":false,"text":"He is the calmest out of all of the characters. While his aloofness makes others keep their distance, he is trusted by other chieftains and demon villagers. He rarely expresses his feelings and will give you the cold shoulder at first, but that makes his smiles much more worthwhile."},{"spoiler":false,"text":"He has short black hair, amethyst-colored eyes, and pale skin."},{"spoiler":false,"text":"Taken from Demon's bond wiki."}],"source":"vndb","sourceCharacterId":"c12520"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f4cfe459a5e93ddcaf61aa9b4bbabc750d9908f14d9ee9981915a18b4c7bf0a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c913e30def06c9ad7bed544740eaa6ae1f722100c67051a19026eb27ab2cc7e4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神谷 浩史","creatorId":"vndb:s132","sourcePersonId":"vndb:s132","canonicalEntityId":"vndb:s132","name":"神谷 浩史","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45284","source":"vndb"}]},{"characterId":"char_vndb_c12521","characterName":"千岳","sourceIds