birthday":{"reviewState":"source-only","source":"vndb","value":"1008"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Known as the Living God of the Western Provinces, he is also a member of the Ten-Demon Alliance. Unlike any other clan, his is highly worshiped by humans."},{"spoiler":false,"text":"He is considered the most elegant out of all of the characters. Despite his refined and elegant appearance, he is very forward with you. He also loves to deal out venomous quips, making it difficult to tell when he is truly serious. You might think he is teasing you at first, but you will notice the seriousness in his eyes along your journey with him."},{"spoiler":false,"text":"Shin has long dark pink hair that is worn in a high ponytail, amber-colored eyes, and pale skin."},{"spoiler":false,"text":"Taken from Demon's bond wiki."}],"source":"vndb","sourceCharacterId":"c12522"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aadd2051ce954b6729aa4e39d05dfe7383a1148870856512057d71d83ef5d84e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d178a31d9f8a0d3ec5644a804c9c8cb6d01246d44fda2eec3ea5e3511563cd0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"日野 聡","creatorId":"vndb:s82","sourcePersonId":"vndb:s82","canonicalEntityId":"vndb:s82","name":"日野 聡","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45282","source":"vndb"}]},{"characterId":"char_vndb_c12523","characterName":"八瀬 千羽","sourceIds":{"vndbCharacterId":"c12523"},"originalCharacterName":"八瀬 千羽","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only"