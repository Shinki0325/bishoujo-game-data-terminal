ative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/824d6f1721c5b80faa4a1168a27f2daffeab6b54588159b09c5130ff32576b00.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c0baed1deff367edfca96416eb3980c2115833087fe6262b2d9e351ef010821.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西松 和彦","creatorId":"vndb:s3818","sourcePersonId":"vndb:s3818","canonicalEntityId":"vndb:s3818","name":"西松 和彦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45297","source":"vndb"}]},{"characterId":"char_vndb_c12528","characterName":"月島 勲朗","sourceIds":{"vndbCharacterId":"c12528"},"originalCharacterName":"月島 勲朗","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a95ec70c65d0d0035c405e4dca616699d8635b1386768b37178bca25a8814465.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc4ba0e87f22d3c06deb16228cac4fb1622cda174ad51999fa333b864f89e48f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原 凡","creatorId":"vndb:s3819","sourcePersonId":"vndb:s3819","canonicalEntityId":"vndb:s3819","name":"石原 凡","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45298","source":"vndb"}]},{"characterId":"char_vndb_c12529","characterName":"南雲 秀","sourceIds":{"vndbCharacterId":"c12529"},"originalCharacterName":"南雲 秀","characterNameSource":null,"role":"side","status":"so