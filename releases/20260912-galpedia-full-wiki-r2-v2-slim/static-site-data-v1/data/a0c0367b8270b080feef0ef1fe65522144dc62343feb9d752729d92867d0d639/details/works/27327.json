gments":[{"spoiler":false,"text":"A female teacher with a serious, intelligent and mature atmosphere. She is suspicious of the main character's behavior and begins to probe the main character's personal affairs, which leads to the main character raping her to keep her quiet, and then blackmailed. She is serious but has a cheerful and gentle personality, and is often adored by the students. She is a caring homeroom teacher who meddles in various ways to rehabilitate the protagonist. Because she trusts her students, she is sometimes easily deceived."}],"source":"vndb","sourceCharacterId":"c42136"},{"segments":[{"spoiler":false,"text":"真面目で理知的な大人の女性の雰囲気を持つ主人公の担任教師。 水泳部顧問。"},{"spoiler":false,"text":"主人公を更生させようと何かとお節介をやく。"},{"spoiler":false,"text":"ふとしたきっかけで、主人公の行動に疑念を持ち、その身辺を探り始めるが、逆に気づかれてしまい、口封じのために凌辱される。"},{"spoiler":false,"text":"その後、主人公に肉体関係を強要され続ける事になる。"}],"source":"egs","sourceCharacterId":"20608","sourceWorkId":"27327","spoiler":false},{"segments":[{"spoiler":false,"text":"真面目で理知的な大人の雰囲気を持つ女教師。"},{"spoiler":false,"text":"ふとしたきっかけで、主人公の行動を怪しみはじめ、"},{"spoiler":false,"text":"主人公の身辺を探り始めたために、主人公に口封じのために凌辱され、"},{"spoiler":false,"text":"その後、そのことをネタに、肉体関係を強要されてしまう。"},{"spoiler":false,"text":"基本的には真面目だが明るく優しい性格なので、"},{"spoiler":false,"text":"よく学生達からは慕われている。"},{"spoiler":false,"text":"主人公を更生させようと色々お節介をしてくる世話焼きな担任。"},{"spoiler":false,"text":"学生を信用しているため、簡単にだまされたりする場合がある。"}],"source":"bangumi","sourceCharacterId":"93663"}],"profileFacts":[{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"20608","sourceWorkId":"27327","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"20608","sourceWorkId":"27327","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"20608","sourceWorkId":"27327","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharact