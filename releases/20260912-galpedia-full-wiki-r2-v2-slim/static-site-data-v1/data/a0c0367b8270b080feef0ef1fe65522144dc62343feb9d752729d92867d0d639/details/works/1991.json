":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:201063","source":"egs"},{"creditedName":"志水 直隆","creatorId":"vndb:s2213","sourcePersonId":"vndb:s2213","canonicalEntityId":"vndb:s2213","name":"志水 なおたか","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:4603","source":"vndb"},{"creditedName":"齋藤 紀子","creatorId":"vndb:s2345","sourcePersonId":"vndb:s2345","canonicalEntityId":"vndb:s2345","name":"齋藤 紀子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:4606","source":"vndb"},{"creditedName":"マツ","creatorId":"vndb:s1109","sourcePersonId":"vndb:s1109","canonicalEntityId":"vndb:s1109","name":"まつ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:4608","source":"vndb"}]},"cast":[{"characterId":"char_c51907","characterName":"五十嵐 優菜","sourceIds":{"bangumi":[{"characterId":"124638","match":"exact-normalized-name-in-linked-work","subjectId":"397347"}],"egsCharacterIds":["22775"],"vndbCharacterId":"c51907"},"originalCharacterName":"五十嵐 優菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「聖ミカエル総合病院」の看護婦で、現在は看護学校に実習講師として出向している正看護婦。"},{"spoiler":false,"text":"『尽くしてあげちゃう2～なんでもしちゃうの～』にも登場。"},{"spoiler":false,"text":"20代中半で主人公とはほぼ同年代。"},{"spoiler":false,"text":"しかし立ち振る舞いが大人びているので、主人公に対してもちょっとお姉さん風な感じで接する。"},{"spoiler":false,"text":"学生時代、一生を添い遂げようと誓った恋人が居たが、処女を捧げる前に交通事故で他界している。"},{"spoiler":false,"text":"以来失語症寸前の口数の少なさになってしまった。"},{"spoiler":false,"text":"主人公と話すときも、必要最低限の言葉しか話さない。"},{"spoiler":false,"text":"主人公には昔の恋人の面影があるらしく、初めはそれを追いかけるように主人公に接してくる。"},{"spoiler":false,"text":"しかし主人公への思いが特別なものに育つにつれて、愛おしさと同時に心中の悩みも大きくなってしまう。"},{"spoiler":false,"text":"相変わらずの「……（こくこく）」「……（ふるふる）」"}],"source":"egs","sourceCharacterId":"22775","sourceWorkId":"1991","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の先輩でむつみとも仲がいい。"},{"spoiler":false,"text":"ほっそり清楚な感じだが、着やせするタイプなのか胸は結構ある。"},{"spoiler":false,"text":"物静かでお嬢様然とした雰囲気。"},{"spoiler":false,"text":"声が小さくて、おもわず守ってあげたくなりそう。"},{"spoiler":false,"text":"大の猫好きで、発見すると別人のように興奮する。"}],"source":"egs","sourceCharacterId":"22775","sourceWorkId":"3684","spoiler":false},{"segments":[{"spoiler":false,"text":"『尽くしてあげちゃう2』、『看護しちゃうぞ2』に登場。"},{"spoiler":false,"text":"原画：志水直隆（トラヴュランス）"},{"spoiler":false,"text":"主人公の一つ年上の先輩で、むつみとも親しい。"},{"spoiler":false,"text":"真っ白い肌と穏やかで柔らかい物腰はいかにも「深窓の令嬢」と言う感じ。"},{"spoiler":false,"text":"中肉中背、胸は大きめ。癖のないストレートロングの黒髪、とろんとした瞳と太めの眉、大きな眼鏡がチャームポイント。"},{"spoiler":false,"text":"声も小さく、下級生である主人公達にも常に敬語を使う。"},{"spoiler":false,"text":"特に主人公に「お願い」をする際は、真っ赤な顔のまま彼の服の裾をつんつん引っ張る様な感じ。"}],"source":"egs","sourceCharacterId":"22775","sourceWorkId":"3801","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の先輩で、むつみとも仲がいい。学業優秀で、一言でたとえるなら「深窓の令嬢」と言う感じ。"}],"source":"bangumi","sourceCharacterId":"124638"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/440f1d52d92e73cc25e4f360ec8fc1bcd720135f92699fb7c17e6b04156ca485.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28c5e0e22c990a2ccf7f0a65718d2d6fb9473611b9103d07cfa33769ec5fff37.webp","width":183,"height":220,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c12309","characterName":"中村 泳二","sourceIds":{"vndbCharacterId":"c12309"},"originalCharacterName":"中村 泳二","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He's the hero of this story. He happened to become a father while he was leading a vagabond life in Europe. Even after becoming a father, he still flatters girls, following his philosophy, \"Always be kind to women.\" He returns to his country and starts working at the nursing school. Of course, student nurses won't leave this good-looking father alone!"}],"source":"vndb","sourceCharacterId":"c12309"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c69835","characterName":"長崎 晶","sourceIds":{"vndbCharacterId":"c69835"},"originalCharacterName":"長崎 晶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/507752576a23c6cad1638c38451e0cef8e1c6b4fae8ea2799b420dcc1c6a7411.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39c2f955208ba694ce657c21da4e078cfdd4b21d0c0696c387886c1f8cd9e363.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鎌田 千歳","creatorId":"vndb:s197","sourcePersonId":"vndb:s197","canonicalEntityId":"vndb:s197","name":"内川 藍維","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1553","source":"vndb"}]},{"characterId":"char_vndb_c69836","characterName":"石神 ひばり","sourceIds":{"vndbCharacterId":"c69836"},"originalCharacterName":"石神 ひばり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fb1652478ba38758a5a16da4c7c69cece7e7d6ef3c2bcb0c8692e2e53da2da4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1