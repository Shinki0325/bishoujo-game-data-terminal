terIds":["16782"],"vndbCharacterId":"c60779"},"originalCharacterName":"天道 りんね","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公、兼メインヒロイン。"},{"spoiler":false,"text":"勉強や運動が苦手な少女。ネットゲームが趣味。"},{"spoiler":false,"text":"親しい友人もおらず、教室の隅っこが定位置。"},{"spoiler":false,"text":"人と話すのも苦手で、コミュニケーションが取れない。"},{"spoiler":false,"text":"常に猫背で、気弱な性格と不愉快な言動のせいか、通っている学校でイジメられている。"},{"spoiler":false,"text":"だが、『アタシは悪くない。悪いのはアタシを理解しないヤツらだ』と思い込んでおり、常に内心で人を見下している。"},{"spoiler":false,"text":"『高野聖』とは同じクラスで、人気者の彼女を妬ましく思い、一方的に毛嫌いし、敵視している。"},{"spoiler":false,"text":"世の中がつまらない、退屈だと感じており、世界が壊れる妄想をしていたところ、突如として現れた不思議な生物『カピラ』から、『キミの体内には膨大な魔力があり、魔法を使える素質がある』と告げられ、魔法の力を手に入れる。"},{"spoiler":false,"text":"魔法の力で魔法少女へと変身するも、その力を人助けではなく、私利私欲のために使いはじめる。"},{"spoiler":false,"text":"自分をイジメていたクラスメイトや、気に食わないと思うモノを片っ端からブッ潰し、退屈な日常を壊して、誰もが自分を崇拝する世界を作るために行動していく。"},{"spoiler":false,"text":"『破壊・憎悪・嫉妬』といった負の『想いの力』を持っており、破壊的な魔法を得意とする。"}],"source":"egs","sourceCharacterId":"16782","sourceWorkId":"24960","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公 兼 メインヒロイン。"},{"spoiler":false,"text":"親しい友人はおらず、教室の隅っこを定位置とするいじめられっ子。"},{"spoiler":false,"text":"「悪いのはアタシを理解しないヤツらだ」と思っており、内心で人を見下している。"},{"spoiler":false,"text":"また人気者の高野聖を妬ましく思い、一方的に敵視している。"},{"spoiler":false,"text":"世の中をつまらない・退屈だと感じており、日々世界が壊れる妄想をしていた。"},{"spoiler":false,"text":"そんな時に魔法の力を授けられ、さっそく私利私欲のために魔法少女の力を使い、"},{"spoiler":false,"text":"気に食わないモノを片っ端からブッ潰して、誰もが自分を崇拝する世界を作るために行動していく。"},{"spoiler":false,"text":"“破壊・憎悪・嫉妬”といった負の想いの力を持っており、破壊的な魔法を得意とする。"}],"source":"bangumi","sourceCharacterId":"54295"}],"profileFacts":[{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"16782","sourceWorkId":"24960","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"16782","sourceWorkId":"24960","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/241ee13979cf291044fd1c842e305545c39713b14b2fa5c516b2e211fefdca49.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4c5a5d19116b5ae29b9b7b693853a95adb880eecd3962f1bbf426b50f90d031.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:211417:54295:6359:1","source":"bangumi"}]},{"characterId":"char_c60780","characterName":"高野 聖","sourceIds":{"bangumi":[{"characterId":"54296","match":"exact-normalized-name-in-linked-work","subjectId":"211417"}],"egsCharacterIds":["16783"],"vndbCharacterId":"c60780"},"originalCharacterName":"高野 聖","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"りんねと違って容姿端麗。成績優秀。スポーツ万能。"},{"spoiler":false,"text":"誰に対しても優しく接し、困っている人を見捨てられない、正義感溢れる正統派ヒロイン。"},{"spoiler":false,"text":"『りんねと仲良くなりたい』と心から思っており、日頃から親しく接するも、彼女からは毛嫌いされている。"},{"spoiler":false,"text":"なお、本人は毛嫌いされていることに気付いていない。"},{"spoiler":false,"text":"りんねと同じく体内に魔力を持っており、魔法を使える素質がある。"},{"spoiler":false,"text":"暴走する魔法少女のりんねを止めるため、困っているカピラを救うために、自身も魔法少女になることを決意する。"},{"spoiler":false,"text":"何度犯されても、倒されても、『りんねを救いたい』という思いから、不屈の闘志で立ち上がっていく。"},{"spoiler":false,"text":"『癒し・