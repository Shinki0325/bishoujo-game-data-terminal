也是个爱哭鬼。爱赖床，每天大辅的日课就是来叫她起床（青梅竹马+邻居）喜欢动物，特别是猫狗什么的。一直诺守着约定喜欢着大辅，无论何时何地都大辅身边行动以至学园的人公认是一对夫妻（悠说的）其实天音更像一种妹妹般存在的女孩。"}],"source":"bangumi","sourceCharacterId":"70029"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30afd31856ddcdcd4d3e7aa768a310ab4a6335c9fff61b25d573ea8e0754fd69.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18ff1b2aa28a0784ef70f4188f3778ba11dc1f7ce64ca6edf5ae4107c47bc365.webp","width":200,"height":200,"source":"static-detail"},"actors":[{"creditedName":"倖月美和","creatorId":"vndb:s1637","sourcePersonId":"vndb:s1637","canonicalEntityId":"vndb:s1637","name":"倖月 美和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:23561:70029:11300:1","source":"bangumi"}]},{"characterId":"char_c706","characterName":"七城 柚子","sourceIds":{"bangumi":[{"characterId":"70030","match":"exact-normalized-name-in-linked-work","subjectId":"23561"}],"egsCharacterIds":["23920"],"vndbCharacterId":"c706"},"originalCharacterName":"七城 柚子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1224"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"73"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"75"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"再会した幼友達の少女。"},{"spoiler":false,"text":"陸上部員で、ハイジャンプ競技。いつも夕方まで居残り練習している努力家。"},{"spoiler":false,"text":"ブルマと体操服がトレードマーク。"},{"spoiler":false,"text":"身長が低く、やや幼児体型気味なので、たまに小学生の男の子と間違われることも。"}],"source":"egs","sourceCharacterId":"23920","sourceWorkId":"218","spoiler":false},{"segments":[{"spoiler":false,"text":"是Canvas中的小loli，其实更像一个小正太。因为叫自己为“ボク”，很容易让人误认为是小学的男生。她那娇小的身躯让人想不到的是居然是陆上部练跳高的。小学的时候和大辅是同班同学，和大辅约定有一天要成为天使。"}],"source":"bangumi","sourceCharacterId":"70030"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa280c715a5f1a065ae0340971748d03b56ab87f78a303099b517570cfebf04b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/ddbc2cac6de190ac3d42b4f3ae7f86cdb701cc38f5e218a5ed2e9fe7cdeb3a7a.webp","width":200,"height":200,"source":"static-detail"},"actors":[{"creditedName":"本山友美","creatorId":"vndb:s4441","sourcePersonId":"vndb:s4441","canonicalEntityId":"vndb:s4441","name":"本山友美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:23561:70030:34620:1","source":"bangumi"}]},{"characterId":"char_c707","characterName":"君影 百合奈","sourceIds":{"bangumi":[{"characterId":"70032","match":"exact-normalized-name-in-linked-work","subjectId":"23561"}],"egsCharacterIds":["23921"],"vndbCharacterId":"c707"},"originalCharacterName":"君影 百合奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"321"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の先輩。"},{"spoiler":false,"text":"人見知りが激しく、いつも寡黙。"},{"spoiler":false,"text":"とても花が好きで、放課後は屋上の花壇にいることが多い。"},{"spoiler":false,"text":"一度打ち解けた相手には、献身的に尽くす可愛いところもある。"}],"source":"egs","sourceCharacterId":"23921","sourceWorkId":"218","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的前辈，性格非常安静。喜欢花卉，经常在天台一人摆弄花草。她主动要求主人公为她画自己的肖像，为的是要解开一个诅咒。"}],"source":"bangumi","sourceCharacterId":"70032"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd1acae0e18f9b2ce777611a894b4aeb98298bc7f4fab4586fbffac2911ff03d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75bfe1b38564b39c23adc5fb388f1d639b15ea8b995e84950ffadd3f581f2d5d.webp","width":200,"height":200,"source":"static-detail"},"actors":[{"creditedName":"藤咲かおり","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"韮井叶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:23561:70032:6105:1","source":"bangumi"}]},{"characterId":"char_c708","characterName":"桜塚 恋","sourceIds":{"bangumi":[{"characterId":"70033","match":"exact-normalized-name-in-linked-work","subjectId":"23561"}],"egsCharacterIds":["23922"],"vndbCharacterId":"c708"},"originalCharacterName":"桜塚 恋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1014"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"父親の再婚相手の娘。後輩で、義理の妹。"},{"spoiler":false,"text":"いつも主人公に冷たくあたるが、心憎からず想っていることも……。"},{"spoiler":false,"text":"学園の男子に人気が高く、言い寄る男が後をたたない。"},{"spoiler":false,"text":"ツンデレ属性全開で、主人公を翻弄する。"}],"source":"egs","sourceCharacterId":"23922","sourceWorkId":"218","spoiler":false},{"segments":[{"spoiler":false,"text":"父亲再婚带过来的女孩，通称“義妹”。Canvas中唯一一个有暴力倾向，常常对大辅拳脚相加，每次都是以充满魄力的飞踢登场，汗...深入了解她之后才发现她是个可爱的女孩。"}],"source":"bangumi","sourceCharacterId":"70033"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16ce4755f3d609e031024920e437352a4fcaa63414bb849dd0f49b7df2dd50e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f342d85164c5e1321f948ea598364bb0e5097f4acc054ae0ac65453e2cef924.webp","width":200,"height":200,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:23561:70033:4432:1","source":"bangumi"}]},{"characterId":"char_c709","characterName":"篠宮 悠","sourceIds":{"bangumi":[{"characterId":"70031","match":"exact-normalized-name-in-linked-work","subjectId":"23561"}],"egsCharacterIds":["23923"],"vndbCharacterId":"c709"},"originalCharacterName":"篠宮 悠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"126"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source"