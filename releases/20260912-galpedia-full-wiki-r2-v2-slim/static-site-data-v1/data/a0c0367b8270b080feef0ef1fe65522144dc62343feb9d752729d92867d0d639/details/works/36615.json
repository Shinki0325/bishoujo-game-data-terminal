"sourceCharacterId":"134516"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0ff4c559d590c991e14ce6967977f5850b32132b0a32f6d07a1fb1a0cf3b78ad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/895581ec05d34639b0ad8c8a0e4e7531b5b10c092100afc77614200b0c2d0ce0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"福圓美里","creatorId":"vndb:s362","sourcePersonId":"vndb:s362","canonicalEntityId":"vndb:s362","name":"福圓 美里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:42119:134516:4372:1","source":"bangumi"}]},{"characterId":"char_c58905","characterName":"小野寺 雷火","sourceIds":{"bangumi":[{"characterId":"134513","match":"exact-normalized-name-in-linked-work","subjectId":"42119"}],"egsCharacterIds":["3452"],"vndbCharacterId":"c58905"},"originalCharacterName":"小野寺 雷火","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"この物語の主人公。姫守学園の2回生で、今がまさに青春まっただなか。"},{"spoiler":false,"text":"実は、家が旧華族で、現在は化学工場と大病院と姫守学園を経営している小野寺財閥の御曹司。"},{"spoiler":false,"text":"しかし身分を鼻にかけて気取った所が無く、むしろ庶民派で、誰とでもすぐに仲よくなれるお人好し。"},{"spoiler":false,"text":"イブキやユリから好意を寄せられるが、昔からの関係が壊れるのおそれて、どちらとも付き合ったりしていない。"},{"spoiler":false,"text":"父親が女装魔女っ娘であるが故、１０年前に母親が愛想尽かして家から出て行ったという切ない過去を持つ。"},{"spoiler":false,"text":"「ごそごそ、もぞもぞ……よ、よかったぁ～、ちゃんとある」"}],"source":"egs","sourceCharacterId":"3452","sourceWorkId":"12828","spoiler":false},{"segments":[{"spoiler":false,"text":"好きなもの：アイスおむすび、洋食　 嫌いなもの：すぶた（特にパイナップル）、メロンの生ハム"},{"spoiler":false,"text":"趣味・特技：ポテト時計、理科の実験　 コンプレックス：女の子っぽい顔"},{"spoiler":false,"text":"この物語の主人公。姫守学園の2回生で、今がまさに青春まっただなか。"},{"spoiler":false,"text":"家が旧華族で、現在は化学工場と大病院と姫守学園を経営している小野寺財閥の御曹司。"},{"spoiler":false,"text":"しかし身分を鼻にかけて気取ったところがなく、むしろ庶民派で、誰とでもすぐに仲良くなれるお人好し。"},{"spoiler":false,"text":"イブキやユリから好意を寄せられるが、昔からの関係が壊れるのを恐れて、どちらとも付き合ったりしていない。"},{"spoiler":false,"text":"父親が女装魔女っ娘であるが故、10年前に母親が愛想尽かして家から出て行ったという切ない過去を持つ。"},{"spoiler":false,"text":"「ごそごそ、もぞもぞ……よ、よかったぁ～、ちゃんとある」"}],"source":"bangumi","sourceCharacterId":"134513"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c58905","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"3452","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"3452","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"134513","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36a2ecf047198f1adb1e4db1b32584b53f3c13c2bb64ff4babc23647543209af.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d4970e3bf7299f6a5821c38e242e8e4e5340d7dca817a06698b232de4e68302.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今井麻美","creatorId":"vndb:s240","sourcePersonId":"vndb:s240","canonicalEntityId":"vndb:s240","name":"今井 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:42119:134513:4061:1","source":"bangumi"}]},{"characterId":"char_c66892","characterName":"小野寺 凍仁","sourceIds":{"bangumi":[{"characterId":"134526","match":"exact-normalized-name-in-linked-work","subjectId":"42119"}],"egsCharacterIds":["3457"],"vndbCharacterId":"c66892"},"originalCharacterName":"小野寺 凍仁","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"旧華族にして小野寺財閥の当主、ライカの父親。"},{"spoiler":false,"text":"御碕町にある病院の顧問を務め、同時に姫守学園の理事長として生徒達を見守る壮年男性。"},{"spoiler":false,"text":"非常に慎重な性格をしており、厳格な言動を取りがちだが、それは愛情の裏返しである。"},{"spoiler":false,"text":"小野寺家は魔女っ娘の家系として、火炎のマージプリズムが代々受け継がれてきた。"},{"spoiler":false,"text":"毎夜、凍仁は魔女っ娘に変身し、学園に攻め込んでくる謎の組織と戦っている。"},{"spoiler":false,"text":"「ショボーン。もっと見たかったのに」"}],"source":"egs","sourceCharacterId":"3457","sourceWorkId":"12828","spoiler":false},{"segments":[{"spoiler":false,"text":"好きなもの：とこぶし　 嫌いなもの：フグ（当たる可能性が少しでもあるから）"},{"spoiler":false,"text":"趣味・特技：息子を可愛がること　 コンプレックス：妻がうにょむにょ"},{"spoiler":false,"text":"旧華族である小野寺財閥の当主にして、ライカの実父。妻とは別居中。"},{"spoiler":false,"text":"御碕病院の顧問を務め、同時に姫守学園の理事長として学生たちを見守る壮年男性。"},{"spoiler":false,"text":"非常に慎重で合理的な性格をしており、厳格な言動を取りがちだが、それは愛情の裏返しである。"},{"spoiler":false,"text":"小野寺家は守人の家系として火炎の変霊晶柱（マージプリズム）が代々受け継がれており、凍仁は魔晶石を守るために魔女っ娘に変身し、謎の組織と攻防戦を繰り広げていた。"},{"spoiler":false,"text":"しかし、プリズムと魔法の存在は極秘中の極秘。事情を知らない者には、変態オヤジが遊んでいるようにしか見えない。"},{"spoiler":false,"text":"「ぐへっ、ぐへへへへ、セミロングの男の娘萌え～」"}],"source":"bangumi","sourceCharacterId":"134526"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e448756aba7b40f4469a588cc77017967fd2629d2a3ee65ef685f5d45f450564.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/968cdf1cbd97d9ac04d6d00c76f26ec74bcc7f1f1c2416f77b47aefc9497d430.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一条和矢","creatorId":"vndb:s256","sourcePersonId":"vndb:s256","canonicalEntityId":"vndb:s256","name":"一条 和矢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:42119:134526:4612:1","source":"bangumi"}]},{"characterId":"char_c66894","characterName":"ダディ","sourceIds":{"bangumi":[{"characterId":"134527","match":"exact-normalized-name-in-linked-work","subjectId":"42119"}],"egsCharacterIds":["3458"],"vndbCharacterId":"c66894"},"originalCharacterName":"ダディ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"毎夜、風車島に攻め込んでくる謎の男。"},{"spoiler":false,"text":"雷電のマージプリズムを持つ魔女っ娘で、その能力は凍仁と拮抗している。"},{"spoiler":false,"text":"理知的であり、目的のためには冷酷な手段も厭わない。"},{"spoiler":false,"text":"某国の軍部に所属する医療隊員らしいが、詳しい事は不明である。"},{"spoiler":false,"text":"「とっひょ～～～～～～っ」"}],"source":"egs","sourceCharacterId":"3458","sourceWorkId":"12828","spoiler":false},{"segments":[{"spoiler":false,"text":"好きなもの：あんこ　 嫌いなもの：スパム（最近のはうまくなったらしいが）"},{"spoiler":false,"text":"趣味・特技：気象予想　 コンプレックス：トップシークレット"},{"spoiler":false,"text":"合衆国特務機関に所属する医療隊員にして、凍仁に次ぐプリズム研究者。"},{"spoiler":false,"text":"理知的であり、目的のためには冷酷な手段も厭わないが、家庭では良き父親（ダディ）。"},{"spoiler":false,"text":"いかなる経緯か、小野寺が管理していた雷電の変霊晶柱（マージプリズム）を所持しており、ハロルドは凍仁同様に魔女っ娘に変身することができる。"},{"spoiler":false,"text":"毎晩のように風車島へ攻めいっては魔晶石を狙う。"},{"spoiler":false,"text":"そしてこの夏、マージ彗星の最接近に伴い、地球上のプリズムはその魔力を増幅させてゆく。"},{"spoiler":false,"text":"この好機に乗じて、ハロルドはある作戦を実行に移すのだが……。"},{"spoiler":false,"text":"「お前に勝ち目は無い。凍仁、諦めて私と共闘しろ」"}],"source":"bangumi","sourceCharacterId":"134527"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a63a5eff27e054bb39ed86c7f6753f5d2956bcc2f8cb6e736343bd5412514b9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40f697dddb51e867b73dd880c347325271866755abd3ea3fb50938aa9bf79b64.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡野浩介","creatorId":"vndb:s2575","sourcePersonId":"vndb:s2575","canonicalEntityId":"vndb:s2575","name":"岡野 浩介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:42119:134527:3937