e,"text":"イブキはライカのお昼ゴハン係で、いつも手作り弁当を持参する。"},{"spoiler":false,"text":"それがユリとの約束だから…。"},{"spoiler":false,"text":"「ふっふーん。ほんまウチがおらな、しゃーないんから！」"}],"source":"bangumi","sourceCharacterId":"134514"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/402cf2702721d573f5312ad1dd5a768cf6bbd30631692ba148527908049f2f3b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/aba393094cd08ac546a724e5d302811576811a599880e8ebb5932b89c2d54350.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊原ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:42119:134514:4916:1","source":"bangumi"}]},{"characterId":"char_c58899","characterName":"和知 百合","sourceIds":{"bangumi":[{"characterId":"88242","match":"exact-normalized-name-in-linked-work","subjectId":"42119"}],"egsCharacterIds":["3454"],"vndbCharacterId":"c58899"},"originalCharacterName":"和知 百合","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"65"},"height":{"reviewState":"no-conflict","source":"vndb","value":"137"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"小野寺家に代々仕えている和知家の少女。　姫守学園に通う2回生。"},{"spoiler":false,"text":"ライカやイブキと同い歳で幼馴染みだけど、侍女（メイド）として一歩距離をおいた態度をとりがち。"},{"spoiler":false,"text":"とても無口で無表情。ライカとイブキにのみ、ほんのちょっぴり感情を見せる。"},{"spoiler":false,"text":"ライカの母がいなくなってから、小野寺家の家事を取り仕切っている、ある意味最強の存在。"},{"spoiler":false,"text":"先祖は小野寺家に御庭番の忍者だったそうで、彼女もまるで忍者のようだけど、本人は否定している。"},{"spoiler":false,"text":"「無乳……？　…………お仕置き、フッ（吹き矢）」"}],"source":"egs","sourceCharacterId":"3454","sourceWorkId":"12828","spoiler":false},{"segments":[{"spoiler":false,"text":"好きなもの：たくあん　 嫌いなもの：旦那様に害をなすもの"},{"spoiler":false,"text":"趣味・特技：家事全般。特にジャム作りが得意　 コンプレックス：オッパイがほとんどないこと"},{"spoiler":false,"text":"小野寺家に代々仕えている和知家の少女。姫守学園に通う2回生。"},{"spoiler":false,"text":"ライカやイブキと同い歳で幼なじみだけど、侍女（メイド）として一歩距離をおいた態度を取りがち。"},{"spoiler":false,"text":"とても無口で無表情。ライカとイブキにのみ、ほんのちょっぴり感情を見せる。"},{"spoiler":false,"text":"ライカの母がいなくなってから、小野寺家の家事を取り仕切っている、ある意味最強の存在。"},{"spoiler":false,"text":"運動神経抜群で猫のように俊敏。"},{"spoiler":false,"text":"先祖は小野寺家に御庭番の忍者だったそうで、彼女もまるで忍者のようだけど、本人は否定している。"},{"spoiler":false,"text":"朝食と夕飯は用意するけど、お弁当は作らない。"},{"spoiler":false,"text":"それがイブキとの約束だから。"},{"spoiler":false,"text":"「無乳……？…………お仕置き、フッ（吹き矢）」"}],"source":"bangumi","sourceCharacterId":"88242"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/790d11defd22527b0e02b7d7ad19c38e0486b4d575dad70547d4001ef23b4404.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/0905c291aa3cd3019b1dd7a73ebf4d77eb33c76e890090ad140c4d87ffaa7432.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"門脇舞以","creatorId":"vndb:s440","sourcePersonId":"vndb:s440","canonicalEntityId":"vndb:s440","name":"門脇 舞以","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:42119:88242:4402:1","source":"bangumi"}]},{"characterId":"char_c58901","characterName":"プチ姫","sourceIds":{"bangumi":[{"characterId":"134515","match":"exact-normalized-name-in-linked-work","subjectId":"42119"}],"egsCharacterIds":["3455"],"vndbCharacterId":"c58901"},"originalCharacterName":"プチ姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"交換留学で姫守学園にやってきた金髪お嬢様。"},{"spoiler":false,"text":"ライカのクラスメート。２年生にしてはスタイル抜群。"},{"spoiler":false,"text":"貴族の娘で気位が高いけれど、一般常識にうといために突拍子もない言動をとってしまう。"},{"spoiler":false,"text":"意地っ張りな性格が災いして、お高くとまってる印象を受けるけれど、ホントは家庭的。"},{"spoiler":false,"text":"負けん気の強さは他の追随を許さない。"},{"spoiler":false,"text":"「この大たわけが！」"}],"source":"egs","sourceCharacterId":"3455","sourceWorkId":"12828","spoiler":false},{"segments":[{"spoiler":false,"text":"好きなもの：お風呂、あんこ、外国人が喜びそうな日本ぽいもの"},{"spoiler":false,"text":"嫌いなもの：豆 「食べ飽きたのだ！だが甘い豆は珍しいのでOK！」"},{"spoiler":false,"text":"趣味・特技：優雅な散策（と称した探検）　 コンプレックス：「そんなものはない!!」"},{"spoiler":false,"text":"交換留学で姫守学園にやってきた金髪お嬢様。"},{"spoiler":false,"text":"ライカのクラスメイト。2回生にしてはスタイル抜群。"},{"spoiler":false,"text":"貴族の娘で気位が高いけれど、一般常識にうといために突拍子もない言動をとってしまう。"},{"spoiler":false,"text":"意地っ張りな性格が災いして お高くとまってる印象を受けるけれど、ホントは家庭的。"},{"spoiler":false,"text":"負けん気の強さは他の追随を許さない。"},{"spoiler":false,"text":"坂道と入り組んだ町並みは、彼女にとっては大きなおもちゃ箱のようで、放課後は探検ゴッコの毎日。"},{"spoiler":false,"text":"実は交換留学の他にも裏の目的があるらしいが……？"},{"spoiler":false,"text":"休み時間・授業中を問わず、常に黒服にサングラスの屈強なボディガード・ボブ＆マイケルを従えている。"},{"spoiler":false,"text":"しかし、ときたま二人の前から雲隠れして、ライカを巻き込んで探検に出かけてしまう。"},{"spoiler":false,"text":"「黙れ、このAカップ庶民め！」"}],"source":"bangumi","sourceCharacterId":"134515"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6a5923b328353ee149b3a3dd0190b0bf7e0e94905b96602d37b246d0d787353.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2109d17ebc6d00468fd961468c3dd612dbf93f9e5b926ac1828100f4449fab4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"cr