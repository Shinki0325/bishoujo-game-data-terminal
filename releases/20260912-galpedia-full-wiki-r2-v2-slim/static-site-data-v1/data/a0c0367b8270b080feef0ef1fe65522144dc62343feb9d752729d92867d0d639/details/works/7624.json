inalCharacterName":"今原 椎菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"やや押しに弱いクラス委員長。"},{"spoiler":false,"text":"困った人を見ていると助けずには居られないという優しい心の持ち主。"},{"spoiler":false,"text":"主人公のことは、他のものより放って置けないらしく、亜弥に厳しく突っ込まれる。"},{"spoiler":false,"text":"男に対してほとんど免疫が無く、触れられただけで失神することも珍しくない。"}],"source":"egs","sourceCharacterId":"25558","sourceWorkId":"7624","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の同級生で、亜弥のの親友。クラス委員長で、やや押しに弱い。"},{"spoiler":false,"text":"困った人を見ていると助けずには居られないという優しい心の 持ち主。"},{"spoiler":false,"text":"主人公に対しては、他の者よりも放って置けないタイプらしく、 亜弥に厳しく突っ込まれる事しばし。とはいえ、男に対しほとんど 免疫が無く、触れられただけで失神することも珍しくない。"}],"source":"bangumi","sourceCharacterId":"147011"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a4424b02d96f48d8f0ff86a7276d644e123a1a48af4c8803e060c876128c979.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac594c1c886e5e75a22079d11f325cf72116656cdf720d2da8628e16fd5471b1.webp","width":200,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤咲かおり","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"藤咲 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:386276:147011:6105:1","source":"bangumi"}]},{"characterId":"char_c36940","characterName":"綾瀬 紗那","sourceIds":{"bangumi":[{"characterId":"147012","match":"exact-normalized-name-in-linked-work","subjectId":"386276"}],"egsCharacterIds":["25559"],"vndbCharacterId":"c36940"},"originalCharacterName":"綾瀬 紗那","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染で喧嘩友達。高飛車で我が儘、常に高圧的。"},{"spoiler":false,"text":"対抗心が強く、いつも自分の家の自慢をしに来ては、主人公に嫌がられている。"},{"spoiler":false,"text":"勉強もスポーツも万能という彼女だが……搦め手に弱く、主人公のウソに騙されては、すぐ真っ赤になって怒っている。"}],"source":"egs","sourceCharacterId":"25559","sourceWorkId":"7624","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公とは幼馴染で喧嘩友達。父親同士が親友にしてライバルという関係。高飛車で我が儘、常に高圧的で、典型的お嬢タイプ。"},{"spoiler":false,"text":"対抗心が強く、いつも自分の家の自慢をしに来ては、主人公に嫌がられている。"},{"spoiler":false,"text":"勉強も出来、スポーツも万能という彼女だが……搦め手に弱く、主人公のウソに騙されては、 すぐ真っ赤になって怒っている。"}],"source":"bangumi","sourceCharacterId":"147012"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a24fe86c79657845ce288a884453125f1ca4eccf3a052709884488ed0422bebb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/060dec7583bbc64eb55bf93811a9e2cd666e422268c59c7953380703d35cfe39.webp","width":200,"height":256,"source":"static-detail"},"actors":[{"creditedName":"若泉絵子","creatorId":"vndb:s1099","sourcePersonId":"vndb:s1099","canonicalEntityId":"vndb:s1099","name":"若泉 絵子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:386276:147012:25167:1","source":"bangumi"}]},{"characterId":"char_c36941","characterName":"添嶋 君香","sourceIds":{"bangumi":[{"characterId":"147013","match":"exact-normalized-name-in-linked-work","subjectId":"386276"}],"egsCharacterIds":["25560"],"vndbCharacterId":"c36941"},"originalCharacterName":"添嶋 君香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公付きのメイドで、主人公にとっては姉であり母であり教師である。"},{"spoiler":false,"text":"性格はクールで実直。"},{"spoiler":false,"text":"主人公に対して基本的に絶対***の姿勢を貫くが少しでも悪ふざけをす