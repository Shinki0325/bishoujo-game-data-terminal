dType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Soft-spoken and hesitant, Kurumi believes herself to be an unremarkable and plain girl, and has trouble accepting compliments. Easily intimidated, indecisive, and destructively weak-willed, she even refuses to voice any protests when she is put up for sale, instead keeping her objections to herself out of fear of punishment. However, once having learned that she is no longer in her own world, she feels that she no longer has any place to belong, and asks to be taken to a demon’s home of her own free will."},{"spoiler":false,"text":"(Taken from eroderekko)"}],"source":"vndb","sourceCharacterId":"c4582"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/721a2aff046dc2e4d063e2b5ea45be43278d890f9eb3e6ff67c44cf57bcddd48.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc50d382dc67efda9404446cf89a03ddd1237d9643b31c156bf9a2f7e338176a.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏野 こおり","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11553","source":"vndb"}]},{"characterId":"char_vndb_c4583","characterName":"レオン","sourceIds":{"vndbCharacterId":"c4583"},"originalCharacterName":"レオン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Cruel, domineering, and hedonistic, he views female servants, especially humans, as less than bags of meat to derive pleasure from. He is quick to dismiss Kurumi, declaring her to be useless if he cannot sleep with her. Once learning that she is submissive to his advances, he forces her into servitude as a maid, although he makes it clear that she is to serve him in other ways as well."},{"spoiler":false,"text":"Taken from eroderekko"}],"source":"vndb","sourceCharacterId":"c4583"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/def95e5b859149e96e9983a57ce74ca9638f9b60879ad23aef13b397322a31a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aadea6556605fc2713a34d06858bca42c33dc09965f00164ca901dfc071cd368.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"寺島 拓篤","creatorId":"vndb:s63","sourcePersonId":"vndb:s63","canonicalEntityId":"vndb:s63","name":"寺島 拓篤","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11554","source":"vndb"}]},{"characterId":"char_vndb_c4584","characterName":"デルタ","sourceIds":{"vndbCharacterId":"c4584"},"originalCharacterName":"デルタ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He possesses an emotionless and practical mindset, projecting an impersonal demeanor towards all around him. His only interest is in his research, and he considers Kurumi, as a human, to be his most fascinating subject yet. Intent on studying her emotions, he frequently makes sexual advances towards her, merely to gauge her reaction."},{"spoiler":false,"text":"(Taken from eroderekko)"}],"source":"vndb","sourceCharacterId":"c4584"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd85a965cd0c9a432c33f93b7c654ee0f1d19bce2d750fa5bfa932af75bcfeb2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf5c5934ce9ae3a4ad5193a22a67ee8e26da86cef4f64a6b95d7ea07afea1728.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大川 透","creatorId":"vndb:s551","sourcePersonId":"vndb:s551","canonicalEntityId":"vndb:s551","name":"大川 透","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11559","source":"vndb"}]},{"characterId":"char_vndb_c4585","characterName":"城崎 焔","sourceIds":{"vndbCharacterId":"c4585"},"originalCharacterName":"城崎 焔","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kurumi’s underclassman. Being unusually observant of her daily schedule, he comes to realize her lack of companionship, and tries his best to keep her company whenever she needs it. He confesses his love to her, but admits that he doesn’t need an answer right away."},{"spoiler":false,"text":"(Taken from eroderekko)"}],"source":"vndb","sourceCharacterId":"c4585"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/7643defe6e32eeaba01e268e140b1c56182b78549afd6cbf73e26df997540e99.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/717e29fff017501d18eea69c917004c932305fe6800e35cc4211dd1a6c84a3f8.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平川 大輔","creatorId":"vndb:s133","sourcePersonId":"vndb:s133","canonicalEntityId":"vndb:s133","name":"平川 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11557","source":"vndb"}]},{"characterId":"char_vndb_c4586","characterName":"リュカ","sourceIds":{"vndbCharacterId":"c4586"},"originalCharacterName":"リュカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"188"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A simple-minded and slow-witted demon, he is the one who captured Kurumi, seemingly interested in only his own gain. Despite his initial attempts to sell her, he comes to pity her and tries to guide her back to the human world. He takes her into his home when these attempts fail, but his caretaking efforts only yield more difficulties, as he treats her like a pet and denies her all independence, assuming her to be incapable of performing even the most basic of actions."},{"spoiler":false,"text":"Taken from eroderekko"}],"source":"vndb","sourceCharacterId":"c4586"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1739cdd4f25b4041e0d038f96532169eec1f87b4bda162a3ad34a8c9a503210.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/4427e3f2970eafa603cf66c038194e03ecbb39448f14fb9038b3556c5a245880.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浜田 賢二","creatorId":"vndb:s385","sourcePersonId":"vndb:s385","canonicalEntityId":"vndb:s385","name":"浜田 賢二","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11558","source":"vndb"}]},{"characterId":"c