ojo.date/terminal-wiki/v1/characters/v1/images/6d/6d968590ccb07462c6901749d3eaf20a1577b76011a82447a3db3418767731bd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永井ちひろ","creatorId":"vndb:s530","sourcePersonId":"vndb:s530","canonicalEntityId":"vndb:s530","name":"逢川奈々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:50380:62203:18652:1","source":"bangumi"}]},{"characterId":"char_c46362","characterName":"田山 文","sourceIds":{"bangumi":[{"characterId":"62205","match":"exact-normalized-name-in-linked-work","subjectId":"50380"}],"egsCharacterIds":["10229"],"vndbCharacterId":"c46362"},"originalCharacterName":"田山 文","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"先輩である優月に異常な好意を抱いているが、自称レズではない。"},{"spoiler":false,"text":"実際に違うのだが、可愛い女の子がとにかく好きで、そのメンタリティーはアイドルオタクに近い。"},{"spoiler":false,"text":"アイドルがAV等に出演することについても肯定的で、優月が周吾とただならぬ仲であると気付いたときには『優月先輩と周吾のセックスが見たい……』と思ってしまう。"},{"spoiler":false,"text":"ある種とてもひねくれた変態。"},{"spoiler":false,"text":"興奮すると鼻血を出すぞ。"}],"source":"egs","sourceCharacterId":"10229","sourceWorkId":"15275","spoiler":false},{"segments":[{"spoiler":false,"text":"先輩である優月に異常な好意を抱いているが、自称レズではない。"},{"spoiler":false,"text":"実際に違うのだが、可愛い女の子がとにかく好きで、そのメンタリティーはアイドルオタクに近い。"},{"spoiler":false,"text":"アイドルがAV等に出演することについても肯定的で、優月が周吾とただならぬ仲であると気付いた時には 「優月先輩と周吾のセックスが見たい……」 と思ってしまう。"},{"spoiler":false,"text":"ある種とてもひねくれた変態。"},{"spoiler":false,"text":"興奮すると鼻血を出すぞ。"}],"source":"bangumi","sourceCharacterId":"62205"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41ecdee95ee99946d69fbca109f8fc4b830d6a380bf710e0ef84c56fd66ed1a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/ch