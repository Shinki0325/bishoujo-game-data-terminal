{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"15289","model":{"presentationWorkId":"vndb:v7078","staff":{"artwork":[{"creditedName":"TATSU屋","creatorId":"vndb:s8036","sourcePersonId":"vndb:s8036","canonicalEntityId":"vndb:s8036","name":"TATSU屋","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:68978","source":"vndb"}],"scenario":[{"creditedName":"日高 真一","creatorId":"vndb:s8035","sourcePersonId":"vndb:s8035","canonicalEntityId":"vndb:s8035","name":"日高 真一","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:68977","source":"vndb"}],"music":[],"other":[]},"cast":[{"characterId":"char_c43730","characterName":"三国 真奈美","sourceIds":{"bangumi":[{"characterId":"193551","match":"exact-normalized-name-in-linked-work","subjectId":"613929"}],"egsCharacterIds":["11425"],"vndbCharacterId":"c43730"},"originalCharacterName":"三国 真奈美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the wife of Yuuichi, Yuji's older brother. In other words, his brother's wife. In short, a married woman."},{"spoiler":false,"text":"A beautiful and cheerful woman whom Yuuji also secretly admires."},{"spoiler":false,"text":"She accepted me in a good mood even though I had to live with her."},{"spoiler":true,"text":"With the approval of her husband, she offers herself to the landlord for cheaper rent."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c43730"},{"segments":[{"spoiler":false,"text":"雄一の妻で、雄二から見れば義姉。"},{"spoiler":false,"text":"美人で頭も切れるが男性関係は奔放。"},{"spoiler":false,"text":"雄一と結婚したのも数多知っている男の中で、身体の相性＋将来性を加味してのこと。"},{"spoiler":false,"text":"とはいえ、結婚してからは愛しているのは夫だけ、らしい。"}],"source":"egs","sourceCharacterId":"11425","sourceWorkId":"15289","spoiler":false},{"segments":[{"spoiler":false,"text":"雄二の兄・雄一の奥さん。"},{"spoiler":false,"text":"つまり兄貴の嫁さん。要するに人妻。"},{"spoiler":false,"text":"雄二もひそかに憧れていた、美人で明るい女性。"},{"spoiler":false,"text":"同居することになっても機嫌よく受け入れてくれたのだが……。"}],"source":"bangumi","sourceCharacterId":"193551"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f4f340e3fc7151a9b94f8595240e9acbbc664cffcf7a042681db2a9bff5fdc9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c6278652c9695efc6d58b8a434c63885b0c572f5246249ab8f529d6a4add279.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c43731","characterName":"勝山 由香里","sourceIds":{"bangumi":[{"characterId":"193552","match":"exact-normalized-name-in-linked-work","subjectId":"613929"}],"egsCharacterIds":["11426"],"vndbCharacterId":"c43731"},"originalCharacterName":"勝山 由香里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the wife who lives next door."},{"spoiler":false,"text":"She looks wild and is a wild woman inside too."},{"spoiler":false,"text":"But what is it about the neighbor that brings in the housekeepers so often?"},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c43731"},{"segments":[{"spoiler":false,"text":"三国家の隣家に住む奥さん。"},{"spoiler":false,"text":"何だか攻撃的な雰囲気（雄二談）の美人で、初対面の雄二にいきなり身体をくっつけてきたりする。"},{"spoiler":false,"text":"よほどお得意さまなのか、異常な頻度でさまざまな業者が家に来訪している。"}],"source":"egs","sourceCharacterId":"11426","sourceWorkId":"15289","spoiler":false},{"segments":[{"spoiler":false,"text":"三国家の隣に住む勝山家の奥様。ということは人妻。"},{"spoiler":false,"text":"見た目がワイルドで、中身もワイルドな女性。"},{"spoiler":false,"text":"しかし、お隣はなんでまた御用聞きが頻繁に来るのだろう……？"}],"source":"bangumi","sourceCharacterId":"193552"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd62449e35c7f96414476186a15a67a5249efd4e98cf8c7f41c9fc6956db2d38.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f52c480f56336091ce8a077eea992743c396461cdf2dfdd04bcf14af1ffd230.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c43732","characterName":"野中 孝子","sourceIds":{"bangumi":[{"characterId":"193553","match":"exact-normalized-name-in-linked-work","subjectId":"613929"}],"egsCharacterIds":["11427"],"vndbCharacterId":"c43732"},"originalCharacterName":"野中 孝子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One day, a mysterious woman suddenly attacks Yuuji. She probably is a married woman, since she mentioned her husband."},{"spoiler":false,"text":"She is kind of quiet and her expression is dark, so it is very scary when she comes at you."},{"spoiler":true,"text":"She sees her husband cheat on her with Yukari. The affair did not go the whole way because he suffers from erectile dysfunction."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c43732"},{"segments":[{"spoiler":false,"text":"ある日突然雄二に襲い掛かってくる謎の女性。"},{"spoiler":false,"text":"ボサボサの頭、目の下に不健康そうな隈。"},{"spoiler":false,"text":"どうやら、原因は真奈美にあるようだが………？"}],"source":"egs","sourceCharacterId":"11427","sourceWorkId":"15289","spoiler":false},{"segments":[{"spoiler":false,"text":"ある日突然雄二に襲い掛かってくる謎の女性。"},{"spoiler":false,"text":"ボサボサの頭、目の下に不健康そうな隈。"},{"spoiler":false,"text":"どうやら、原因は真奈美にあるようだが……？"}],"source":"bangumi","sourceCharacterId":"193553"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb829b0d6ec2a5f70701c0caba10ccad8507a5185d2e3951b389447326e2e264.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f552b05a769471dc54c3d5182464fe7d1964544e238e93facf008053c9a214af.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c43733","characterName":"竹原 香織","sourceIds":{"bangumi":[{"characterId":"193554","match":"exact-normalized-name-in-linked-work","subjectId":"613929"}],"egsCharacterIds":["11428"],"vndbCharacterId":"c43733"},"originalCharacterName":"竹原 香織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One day, the landlord introduced to me a mysterious, kimono-clad beauty."},{"spoiler":false,"text":"She must be a married woman because her husband was mentioned...."},{"spoiler":true,"text":"a debt incurred by her husband is being paid off by offering her sexual services to the landlord."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c43733"},{"segments":[{"spoiler":false,"text":"隆介の身の回りを世話しているらしい和服美人。"},{"spoiler":false,"text":"隆介の部下が仕事の不始末の責任をとって差し出してきたというが………？"}],"source":"egs","sourceCharacterId":"11428","sourceWorkId":"15289","spoiler":false},{"segments":[{"spoiler":false,"text":"隆介の身の回りを世話しているらしい和服美人。"},{"spoiler":false,"text":"隆介の部下が仕事の不始末の責任をとって差し出してきたというが……？"}],"source":"bangumi","sourceCharacterId":"193554"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/827dfe67fa3c5f2ccb3c9f033a132c94d1988912754a727ec7e69c1d27034a5e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6eb5295b853eda79229e6662e234344e297dc14a0e08804b0b6a3d5aea7547ad.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c94454","characterName":"三国 雄二","sourceIds":{"bangumi":[{"characterId":"196183","match":"exact-normalized-name-in-linked-work","subjectId":"613929"}],"egsCharacterIds":["11429"],"vndbCharacterId":"c94454"},"originalCharacterName":"三国 雄二","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist."},{"spoiler":false,"text":"He is a pitiful young man who was kicked out of his parents' house due to being a ronin."},{"spoiler":false,"text":"He is not good with women, probably because he went to a boys' school."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c94454"},{"segments":[{"spoiler":false,"text":"主人公。浪人生。"},{"spoiler":false,"text":"両親が海外移住することになり、家を追い出されるも弟を溺愛する兄の家で暮らすことになってしまう。"},{"spoiler":false,"text":"強引な兄に育てられたせいか押しに弱い。"}],"source":"egs","sourceCharacterId":"11429","sourceWorkId":"15289","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公。"},{"spoiler":false,"text":"浪人した挙句に実家を追い出された哀れな青年。"},{"spoiler":false,"text":"男子校出身のためか、女性の扱いが苦手。"}],"source":"bangumi","sourceCharacterId":"196183"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad72d55a9f662f20d7989a557291d0a9d0f6067c425745c5508f6a32afcf73e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d691379c1af0cda4682965c8603106d87faaad5216d9aa3f1d24e5caa66c35f.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c94455","characterName":"三国 雄一","sourceIds":{"bangumi":[{"characterId":"196185","match":"exact-normalized-name-in-linked-work","subjectId":"613929"}],"egsCharacterIds":["11430"],"vndbCharacterId":"c94455"},"originalCharacterName":"三国 雄一","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is Yuji's older brother and Manami's husband."},{"spoiler":false,"text":"He is a big man with a soft personality who can get away with most things with a smile."},{"spoiler":false,"text":"He is abnormally devoted to his younger brother. He's a bit of a brocon."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c94455"},{"segments":[{"spoiler":false,"text":"雄二の兄。弟ラブ。弟がらみのことでは冷静さを失うほど。"},{"spoiler":false,"text":"まだ若いが会社では重要なプロジェクトを任されるなどかなりのやり手サラリーマン。"},{"spoiler":false,"text":"雄二は知らなかったが女性関係でもやり手で、両手で足りないほど彼女がいたらしい。"}],"source":"egs","sourceCharacterId":"11430","sourceWorkId":"15289","spoiler":false},{"segments":[{"spoiler":false,"text":"雄二の兄で、真奈美のだんなさん。"},{"spoiler":false,"text":"柔和な人柄で、大抵のことは笑って済ませる大きな男。"},{"spoiler":false,"text":"異常なほど弟思い。っというかブラコン？"}],"source":"bangumi","sourceCharacterId":"196185"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d0498191cfc2b297eae3a014f5db7803a01917b00fc11a25f37d1a4343c70cd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c974da9c3c88687e5e13fd6c94641123939232d29bd709b81f063e926b732700.webp","width":159,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c94456","characterName":"勝山 啓造","sourceIds":{"bangumi":[{"characterId":"196186","match":"exact-normalized-name-in-linked-work","subjectId":"613929"}],"egsCharacterIds":["11431"],"vndbCharacterId":"c94456"},"originalCharacterName":"勝山 啓造","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yukari's husband, a very quiet man."},{"spoiler":false,"text":"He seems to work in a very respectable profession and always comes home at the same time."},{"spoiler":false,"text":"Why did he marry Yukari?"},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c94456"},{"segments":[{"spoiler":false,"text":"由香里の夫。寡黙でごっつい人。"},{"spoiler":false,"text":"なぜ由香里と結婚したのか謎（雄二談）"}],"source":"egs","sourceCharacterId":"11431","sourceWorkId":"15289","spoiler":false},{"segments":[{"spoiler":false,"text":"由香里の夫で、やけに無口な男。"},{"spoiler":false,"text":"お堅い職業に就いているらしく、帰宅時間が常に一定。"},{"spoiler":false,"text":"なぜ由香里さんと結婚したのだろう？"}],"source":"bangumi","sourceCharacterId":"196186"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1b474fffcb436abd61eeaad6c89f2022a5affb16efe45e7fcc4a696b545d824.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff0bef1555057fe5635cabadd343e75bdcaf076eb308720f0360a723abcf9635.webp","width":159,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c94457","characterName":"番田 隆介","sourceIds":{"bangumi":[{"characterId":"196187","match":"exact-normalized-name-in-linked-work","subjectId":"613929"}],"egsCharacterIds":["11432"],"vndbCharacterId":"c94457"},"originalCharacterName":"番田 隆介","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The old man is a landowner who owns the land where the Katsuyama family lives."},{"spoiler":false,"text":"I don't know why, but he often comes to to play."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c94457"},{"segments":[{"spoiler":false,"text":"三国家、勝山家を含む一体の土地を所有している大地主のじいさん。"},{"spoiler":false,"text":"どういう関係なのか、三国家（というか真奈美のところ）に遊びに来たりする。"},{"spoiler":false,"text":"何やら、関係があるようだが………？"}],"source":"egs","sourceCharacterId":"11432","sourceWorkId":"15289","spoiler":false},{"segments":[{"spoiler":false,"text":"三国家、勝山家の建つ土地を所有している大地主のじいさん。"},{"spoiler":false,"text":"なぜか知らないけど、よく三国家に遊びに来る。"}],"source":"bangumi","sourceCharacterId":"196187"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d2e4f9a4f85622da5ee4503d71fb0b45b44a66403e76fa853af1e2dcca14f3f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f29f173730e0a0353a7756eae060ec07f9635c6328f60a02e534bf2ca8c535a.webp","width":159,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:450","sourceCompanyId":"egs:brand:450","canonicalEntityId":"egs:brand:450","name":"コンプリーツ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:15289:450","source":"egs"},{"companyId":"vndb:p176","sourceCompanyId":"vndb:p176","canonicalEntityId":"vndb:p176","name":"N43 Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:163901:v7078","source":"vndb"},{"companyId":"vndb:p181","sourceCompanyId":"vndb:p181","canonicalEntityId":"vndb:p181","name":"コンプリーツ","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:163902:v7078","source":"vndb"},{"companyId":"vndb:p181","sourceCompanyId":"vndb:p181","canonicalEntityId":"vndb:p181","name":"コンプリーツ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:16612:v7078","source":"vndb"},{"companyId":"vndb:p181","sourceCompanyId":"vndb:p181","canonicalEntityId":"vndb:p181","name":"コンプリーツ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"v