ce":"egs","sourceCharacterId":"7881","sourceWorkId":"22444","spoiler":false},{"segments":[{"spoiler":false,"text":"クラス委員長を務めており正義感が強く、まじめな女の子。"},{"spoiler":false,"text":"あまり人との交流は得意ではなく、恋愛に対しても奥手。"},{"spoiler":false,"text":"そんな自分を変えたいと思い、親友の京子がいる野球部のマネージャーに 2年から参加。"},{"spoiler":false,"text":"勉強熱心で頑張り屋な性格のため、今では誰もが頼るマネージャーに。"},{"spoiler":false,"text":"「私、絶対一番に応援するから！」"}],"source":"bangumi","sourceCharacterId":"37753"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c84b551c83736ddeb9811a0d5f08ec141d52054fdddc8605a5adc29a181b454.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f3d70ec0a16357b55d8b1248f983dac51ed708a46c3cc0ed558ccb422717234.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:145569:37753:5928:1","source":"bangumi"}]},{"characterId":"char_c39074","characterName":"青葉 京子","sourceIds":{"bangumi":[{"characterId":"37754","match":"exact-normalized-name-in-linked-work","subjectId":"145569"}],"egsCharacterIds":["7882"],"vndbCharacterId":"c39074"},"originalCharacterName":"青葉 京子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"桜庭学園３年B組"},{"spoiler":false,"text":"主人公と幼馴染で主人公が所属している野球部のマネージャーを務めている。"},{"spoiler":false,"text":"クラスではムードメーカー的な存在で頼まれ事は断れない性格。"},{"spoiler":false,"text":"張り切って頑張るのだが不器用なため空回りする事が多々ある。"},{"spoiler":false,"text":"小さい頃から一途に主人公を想っていて、主人公を支えるためにずっとマネージャーをやっている。"}],"source":"egs","sourceCharacterId":"7882","sourceWorkId":"22444","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と幼なじみで、主人公が所属している野球部のマネージャーを務めている。"},{"spoiler":false,"text":"クラスではムードメーカー的な存在で、頼まれ事は断れない性格。"},{"spoiler":false,"text":"張り切って頑張るのだが、不器用なため空回りすることが多々ある。"},{"spoiler":false,"text":"小さい頃から一途に主人公を想っていて、彼を支えるためにずっとマネージャーをやっている。"},{"spoiler":false,"text":"「私って、不器用だからさ……」"}],"source":"bangumi","sourceCharacterId":"37754"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2af1315d914da98881eb0d5b875a022bff902d0554a9e62bf1cb475143f864c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7fa406348a5ad2808a23f38a1d462121d240de4b66c7b222a935ad9e27519bd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:145569:37754:15637:1","source":"bangumi"}]},{"characterId":"char_c39075","characterName":"若林 奈央","sourceIds":{"bangumi":[{"characterId":"37755","match":"exact-normalized-name-in-linked-work","subjectId":"145569"}],"egsCharacterIds":["7883"],"vndbCharacterId":"c39075"},"originalCharacterName":"若林 奈央","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"桜庭学園３年B組"},{"spoiler":false,"text":"「だる～い」「うざ～い」「ウケる～」が口癖の女の子。"},{"spoiler":false,"text":"クラスの行事に積極的に参加する事はなく、よく授業をサボっている。"},{"spoiler":false,"text":"なかなか懐いてくれない猫のような性格だが、ひょんな事から主人公と一緒に居る機会が多くなり、徐々に心を開いていく。"},{"spoiler":false,"text":"他人とは関わりたくないが自分の家族は何よりも大切に思っているようだ。"}],"source":"egs","sourceCharacterId":"7883","sourceWorkId":"22444","spoiler":false},{"segments":[{"spoiler":false,"text":"「だる～い」 「うざ～い」 「ウケる～」 が口癖の女の子。"},{"spoiler":false,"text":"クラスの行事に積極的に参加することはなく、よく授業をサボっている。"},{"spoiler":false,"text":"なかなか懐いてくれない猫のような性格だが、"},{"spoiler":false,"text":"ひょんなことから主人公と一緒に居る機会が多くなり、徐々に心を開いていく。"},{"spoiler":false,"text":"他人とは関わりたくないが、自分の家族は何よりも大切に思っている。"},{"spoiler":false,"text":"「え～マジで？　それウケるんですけど！」"}],"source":"bangumi","sourceCharacterId":"37755"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5eb61c2592aae24b00cad5e5c05967557f4f13ee197b0a4953873f815a3c9b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9fae040e11e49ae856cea4a8611328bd1d714de4cc6e7ddf38b4c0e204de8697.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:145569:37755:6351:1","source":"bangumi"}]},{"characterId":"char_c39076","characterName":"宮城野 凛","sourceIds":{"bangumi":[{"characterId":"37756","match":"exact-normalized-name-in-linked-work","subjectId":"145569"}],"egsCharacterIds":["7884"],"vndbCharacterId":"c39076"},"originalCharacterName":"宮城野 凛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"桜庭学園３年B組"},{"spoiler":false,"text":"学年１の成績で、その容姿から学年のマドンナと言われている。"},{"spoiler":false,"text":"周りからはいい大学に入ってキャリアを積み順風満帆な人生を送るんだろうなと羨ましく思われているが、どうやら本人にはそんな事に興味はないらしく、勉強も暇つぶしでやっているとの事。"},{"spoiler":false,"text":"一見冷めた性格のように見えるが、実は誰よりも熱い心の持ち主。"},{"spoiler":false,"text":"そして甘えたがり。"}],"source":"egs","sourceCharacterId":"7884","sourceWorkId":"22444","spoiler":false},{"segments":[{"spoiler":false,"text":"学年 1位の成績で、その容姿もあって学年のマドンナと言われている。"},{"spoiler":false,"text":"周りからは、良い大学に入って順風満帆な人生を送るんだろうなと羨ましく思われているが、"},{"spoiler":false,"text":"どうやら本人はそんなことに興味はないらしく、勉強も暇潰しでやっているとのこと。"},{"spoiler":false,"text":"一見冷めた性格のように見えるが、実は誰よりも熱い心の持ち主。"},{"spoiler":false,"text":"そして甘えたがり。"},{"spoiler":false,"text":"「世界で一番好きって言って……？」"}],"source":"bangumi","sourceCharacterId":"37756"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4b5c91b84307ce23848b501fd9e917b503f25d84b7664ce8dfee45e4d81fa3d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88ad360f0faa7534063992ec65efbee27794d8f06b7326e3b4c7068cc12f68b2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:145569:37756:5900:1","source":"bangumi"}]},{"characterId":"char_vndb_c39077","characterName":"武下 勝也","sourceIds":{"vndbCharacterId":"c39077"},"originalCharacterName":"武下 勝也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb9161bf6f8a872ab2aa4e1d651b7ab30540ef791da60a40ba4f71bb13775790.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/5263a6caa37920a1c412a9f3d9f5cefb6c21df3f7e448ff5f863df3fd938ae5d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c46266","characterName":"亘理 静香","sourceIds":{"vndbCharacterId":"c46266"},"originalCharacterName":"亘理 静香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":