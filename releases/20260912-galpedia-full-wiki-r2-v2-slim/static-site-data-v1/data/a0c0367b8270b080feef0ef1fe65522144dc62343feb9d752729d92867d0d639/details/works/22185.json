{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"22185","model":{"presentationWorkId":"vndb:v17865","staff":{"artwork":[{"creditedName":"桜ロマ子(桜島サロマ子)","creatorId":"vndb:s2746","sourcePersonId":"egs:creator:1811","canonicalEntityId":"vndb:s2746","name":"桜ロマ子(桜島サロマ子)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:153330","source":"egs"}],"scenario":[{"creditedName":"チャック雅","creatorId":"vndb:s4496","sourcePersonId":"egs:creator:433","canonicalEntityId":"vndb:s4496","name":"チャック雅","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:153331","source":"egs"},{"creditedName":"まこっちゃ","creatorId":"vndb:s4497","sourcePersonId":"egs:creator:1343","canonicalEntityId":"vndb:s4497","name":"まこっちゃ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:153332","source":"egs"},{"creditedName":"タスク(タスク父者)","creatorId":"vndb:s4499","sourcePersonId":"egs:creator:15590","canonicalEntityId":"vndb:s4499","name":"タスク(タスク父者)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:233886","source":"egs"},{"creditedName":"猫 舎楽","creatorId":"vndb:s5398","sourcePersonId":"vndb:s5398","canonicalEntityId":"vndb:s5398","name":"猫 舎楽","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:121896","source":"vndb"}],"music":[],"other":[{"creditedName":"チャック雅","creatorId":"vndb:s4496","sourcePersonId":"vndb:s4496","canonicalEntityId":"vndb:s4496","name":"チャック雅","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:121890","source":"vndb"},{"creditedName":"チャック雅","creatorId":"vndb:s4496","sourcePersonId":"vndb:s4496","canonicalEntityId":"vndb:s4496","name":"チャック雅","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121891","source":"vndb"},{"creditedName":"まこっちゃ","creatorId":"vndb:s4497","sourcePersonId":"vndb:s4497","canonicalEntityId":"vndb:s4497","name":"まこっちゃ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121893","source":"vndb"},{"creditedName":"タスク","creatorId":"vndb:s4499","sourcePersonId":"vndb:s4499","canonicalEntityId":"vndb:s4499","name":"タスク","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121895","source":"vndb"},{"creditedName":"たくろう","creatorId":"vndb:s5738","sourcePersonId":"vndb:s5738","canonicalEntityId":"vndb:s5738","name":"たくろう","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121898","source":"vndb"},{"creditedName":"PONSUKE","creatorId":"vndb:s6178","sourcePersonId":"vndb:s6178","canonicalEntityId":"vndb:s6178","name":"PONSUKE","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121899","source":"vndb"},{"creditedName":"音月 もづく","creatorId":"vndb:s6228","sourcePersonId":"vndb:s6228","canonicalEntityId":"vndb:s6228","name":"おゆき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121900","source":"vndb"},{"creditedName":"相川 よいち","creatorId":"vndb:s6264","sourcePersonId":"vndb:s6264","canonicalEntityId":"vndb:s6264","name":"相川 よいち","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121901","source":"vndb"},{"creditedName":"信城 蛍","creatorId":"vndb:s8784","sourcePersonId":"vndb:s8784","canonicalEntityId":"vndb:s8784","name":"信城 蛍","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121902","source":"vndb"},{"creditedName":"CF-X","creatorId":"vndb:s10645","sourcePersonId":"vndb:s10645","canonicalEntityId":"vndb:s10645","name":"CF-X","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121903","source":"vndb"},{"creditedName":"ant","creatorId":"vndb:s12341","sourcePersonId":"vndb:s12341","canonicalEntityId":"vndb:s12341","name":"ant","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121904","source":"vndb"},{"creditedName":"ふじみ とわ","creatorId":"vndb:s12342","sourcePersonId":"vndb:s12342","canonicalEntityId":"vndb:s12342","name":"ふじみ とわ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121905","source":"vndb"}]},"cast":[{"characterId":"char_c38036","characterName":"アナスタシア＝オースティン","sourceIds":{"bangumi":[{"characterId":"91322","match":"exact-normalized-name-in-linked-work","subjectId":"154167"},{"characterId":"91322","match":"exact-normalized-name-in-linked-work","subjectId":"328399"}],"egsCharacterIds":["8167"],"vndbCharacterId":"c38036"},"originalCharacterName":"アナスタシア＝オースティン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Holy Princess who reigns at the top of the Holy Kingdom, Austin."},{"spoiler":false,"text":"Having just lost her mother, the previous queen, she now rules the country at a young age."},{"spoiler":false,"text":"As she is not yet old enough to succeed her as queen, her title remains Princess."},{"spoiler":false,"text":"A brave woman who willingly takes part in battles to inspire her soldiers, her skills are said to be the best in the Holy Kingdom, and she is hailed as the reincarnation of the Valkyrie who once led the Fileille Holy Warriors and sealed away the great magician with her own hands."}],"source":"vndb","sourceCharacterId":"c38036"},{"segments":[{"spoiler":false,"text":"聖王国【オースティン 】の頂点に君臨する聖王女。"},{"spoiler":false,"text":"先代の女王である母親を失ったばかりで、若くして国を取り仕切っている。"},{"spoiler":false,"text":"女王を継ぐ年齢には達していないため、称号としてはあくまで王女のままである。"},{"spoiler":false,"text":"兵を鼓舞するため進んで戦闘にも参加する勇敢な女性で、その腕は聖王国でも随一と言われ、かつて【フィレーユ聖戦女隊】を率いて最後に自らの手で大魔導師を封印したという戦乙女の再来と謳われる。"}],"source":"egs","sourceCharacterId":"8167","sourceWorkId":"22185","spoiler":false},{"segments":[{"spoiler":false,"text":"聖王国・オースティン の頂点に君臨する聖王女。"},{"spoiler":false,"text":"女王である母親を失ったばかりで、若くして国を取り仕切っている。"},{"spoiler":false,"text":"兵を鼓舞するため進んで戦闘にも参加する勇敢な女性で、その腕は聖王国でも随一。"},{"spoiler":false,"text":"かつて大魔導師を封印したという戦乙女の再来と謳われている。"},{"spoiler":false,"text":"また知略にも富み、巧みな交渉術で周辺諸国との良好な関係を保っている。"},{"spoiler":false,"text":"多忙で抑圧された日々を送っているせいか、性格がやや歪んでおり、"},{"spoiler":false,"text":"捕えた蛮族への拷問を見学して密かに悦に浸るなど、サディスティックな一面も持つ。"},{"spoiler":false,"text":"蛮族の襲撃に晒されているところをアシュレイに救われ、気に入ってしまう。"}],"source":"bangumi","sourceCharacterId":"91322"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f358d3b6f2da2476555b8d9f992c623460f642dc4eda475a493c2659587fc61d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/5215db9753e1bcadc007807f360629816cbc79a7c5bcb5f7278ba706525b7c23.webp","width":111,"height":256,"source":"static-detail"},"actors":[{"creditedName":"愛遥花","creatorId":"vndb:s5504","sourcePersonId":"vndb:s5504","canonicalEntityId":"vndb:s5504","name":"愛 遥花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154167:91322:28649:1","source":"bangumi"}]},{"characterId":"char_c38037","characterName":"リナ＝パスカル","sourceIds":{"bangumi":[{"characterId":"91323","match":"exact-normalized-name-in-linked-work","subjectId":"154167"},{"characterId":"91323","match":"exact-normalized-name-in-linked-work","subjectId":"328399"}],"egsCharacterIds":["8168"],"vndbCharacterId":"c38037"},"originalCharacterName":"リナ＝パスカル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A woman who serves as the leader of the Holy Knights."},{"spoiler":false,"text":"She is an elite member of the aristocratic class, and is the descendant of a female knight from the Fileille Holy Women's Squad who once participated in the extermination squad."},{"spoiler":false,"text":"A dignified woman who combines grace and dignity, she is the most skilled of all the knights, and is also famous as a commander with a wealth of tactics and strategies."},{"spoiler":false,"text":"However, due to her pride as an elite, she can also be a little arrogant, and perhaps because she is in charge of the Knights, she also lacks flexibility in her thinking. To put it simply, she is strict."},{"spoiler":false,"text":"In general, she is loved and trusted by her subordinates, but some of them are dissatisfied with being looked down upon due to their lowly family background."}],"source":"vndb","sourceCharacterId":"c38037"},{"segments":[{"spoiler":false,"text":"聖騎士団の団長を務める女性。"},{"spoiler":false,"text":"かつて討伐隊に参加した【フィレーユ聖戦女隊】の女騎士の子孫で、貴族階級のエリート。"},{"spoiler":false,"text":"気品と品格を兼ね備える凛とした女性で、全騎士の中で最も腕が立つ人物であり、また豊富な戦術・戦略を持つ指揮官としても名高い。"},{"spoiler":false,"text":"ただしエリート故の気位の高さから、いささか鼻持ちならない部分もあり、また騎士団を統括する身のためか柔軟な思考に欠ける面もある。平たく言えば、お堅い。"},{"spoiler":false,"text":"基本的には部下から慕われていて信頼も厚いが、中には家柄の低さから軽く見られて不満を持っている者もいる。"}],"source":"egs","sourceCharacterId":"8168","sourceWorkId":"22185","spoiler":false},{"segments":[{"spoiler":false,"text":"聖騎士団の団長。 気品と品格を兼ね備える凛とした女性。"},{"spoiler":false,"text":"かつて大魔導師討伐隊に参加した女騎士の子孫で、貴族階級のエリート。"},{"spoiler":false,"text":"全騎士の中で最も腕が立ち、豊富な戦術・戦略を持つ指揮官としても名高い。"},{"spoiler":false,"text":"しかしエリートゆえの気位の高さから、いささか鼻持ちならない部分もある。"},{"spoiler":false,"text":"お堅く柔軟な思考に欠け、家柄で人を判断してしまうことも。"},{"spoiler":false,"text":"部下からの信頼は厚いが、逆に不満を持つ者も少なくない。"}],"source":"bangumi","sourceCharacterId":"91323"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/401f0fcf845716c374f761ce19b0aa77ea440811b98a627077d7643e03f9e505.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/097d0964427bd924086994f8a10b4c64f3a4b3f2e66c31953fb6abc7cb7f94c2.webp","width":61,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤沢 美月","creatorId":"vndb:s2983","sourcePersonId":"vndb:s2983","canonicalEntityId":"vndb:s2983","name":"藤沢 美月","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:65063","source":"vndb"}]},{"characterId":"char_c38038","characterName":"ゼノヴィア＝アルスール","sourceIds":{"bangumi":[{"characterId":"91324","match":"exact-normalized-name-in-linked-work","subjectId":"154167"},{"characterId":"91324","match":"exact-normalized-name-in-linked-work","subjectId":"328399"}],"egsCharacterIds":["8169"],"vndbCharacterId":"c38038"},"originalCharacterName":"ゼノヴィア＝アルスール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Though still young, this saint has outstanding abilities that have earned her the position of court priest."},{"spoiler":false,"text":"With God's blessing, she can perform miracles such as purifying evil spirits and healing."},{"spoiler":false,"text":"Her powers are so great that she is said to be able to heal any injured person as long as they are not dead."},{"spoiler":false,"text":"She is a kind-hearted woman who shows mercy to even the most evil of people."},{"spoiler":false,"text":"She is sometimes called a hypocrite who only speaks nice things, but that is not her true nature; she can be stubborn and inflexible when it comes to sticking to her belief that she wants to help people."}],"source":"vndb","sourceCharacterId":"c38038"},{"segments":[{"spoiler":false,"text":"まだ若いながら、その突出した能力で宮廷司祭の地位を持つ聖女。"},{"spoiler":false,"text":"神の加護により、悪霊の浄化や治癒の奇跡などを行う。"},{"spoiler":false,"text":"その力は凄まじく、どんな怪我人でも死んでさえいなければ元通りに治療してしまうと言われる。"},{"spoiler":false,"text":"どんな悪人にでも情けをかけてしまう心優しい女性。"},{"spoiler":false,"text":"時には綺麗事ばかり並べる偽善者と呼ばれることもあるが、それは彼女の本質ではなく、人を助けたいと思う信念を貫くためならば、頑固で融通が利かないところすらあるほど。"}],"source":"egs","sourceCharacterId":"8169","sourceWorkId":"22185","spoiler":false},{"segments":[{"spoiler":false,"text":"若くして宮廷司祭の地位を持つ聖女。 神の加護で悪霊の浄化や治癒を行う。"},{"spoiler":false,"text":"その力は凄まじく、どんな怪我人でも生きてさえいれば治してしまうほど。"},{"spoiler":false,"text":"人を助けたいと思う信念は堅く、時に頑固で融通が利かないところも。"},{"spoiler":false,"text":"たとえ悪人であっても情けを掛けてしまう優しい心を持っている。"},{"spoiler":false,"text":"時には綺麗事ばかりの偽善者と呼ばれることもあるが、それは彼女の本質ではない。"}],"source":"bangumi","sourceCharacterId":"91324"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cdadc93c033613f85be4074bcdb21c340cadec4a9c4ea2020fbf23649cbb36c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/9666812c056626da08a8d5bdf358567fd07621a12953f4b5dff3ace49b1c366a.webp","width":118,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柏木美優","creatorId":"vndb:s1030","sourcePersonId":"vndb:s1030","canonicalEntityId":"vndb:s1030","name":"柏木 美優","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154167:91324:6540:1","source":"bangumi"}]},{"characterId":"char_c38039","characterName":"フレデリカ＝アルクィン","sourceIds":{"bangumi":[{"characterId":"91325","match":"exact-normalized-name-in-linked-work","subjectId":"154167"},{"characterId":"91325","match":"exact-normalized-name-in-linked-work","subjectId":"328399"}],"egsCharacterIds":["8170"],"vndbCharacterId":"c38039"},"originalCharacterName":"フレデリカ＝アルクィン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the female knights of the Holy Knights, she is the captain of the First Knight Corps."},{"spoiler":false,"text":"She was not born in the Holy Kingdom, but volunteered to be baptized from a neighboring city due to her poor family background, and has worked her way up to become a knight captain through her skills."},{"spoiler":false,"text":"In reality, she was offered up by her parents at a young age, but in theory she volunteered (this is the case for all those with similar backgrounds)."},{"spoiler":false,"text":"She is often looked down upon by those born in the Holy Kingdom, but the female knights who came from outside the Kingdom look upon her with envy, wanting to emulate her as a hero who has risen to become a knight captain, and she is loved for her friendly personality and caring and nurturing nature."}],"source":"vndb","sourceCharacterId":"c38039"},{"segments":[{"spoiler":false,"text":"聖騎士団の女騎士の一人で、第一騎士隊の騎士隊長。"},{"spoiler":false,"text":"聖王国の生まれではなく、貧しい実家のため近隣都市から志願して洗礼を受け、その腕で騎士隊長まで上り詰めた叩き上げの女騎士。"},{"spoiler":false,"text":"実際には幼少時に親に差し出されたというのが正解だが、建前上志願したことになっている(これは出自が似たような者全員がそうなっている)。"},{"spoiler":false,"text":"聖王国生まれの者からは低く見られがちだが、同じく外から入ってきた女騎士達には騎士隊長まで上り詰めた英雄として着たいと羨望のまなざしを向けられ、人懐っこい性格と世話焼きで面倒見の良いいところもあって慕われている。"}],"source":"egs","sourceCharacterId":"8170","sourceWorkId":"22185","spoiler":false},{"segments":[{"spoiler":false,"text":"第一騎士隊の騎士隊長。 近隣都市から志願して騎士となり、その腕で隊長まで上り詰めた。"},{"spoiler":false,"text":"聖王国生まれからは見下されがちだが、同じ境遇の者たちからは英雄視されている。"},{"spoiler":false,"text":"実はフレデリカを始め、志願兵たちは皆 幼少時に貧しい親に差し出された者たち。"},{"spoiler":false,"text":"建前として志願したことにされている。"},{"spoiler":false,"text":"戦いにおいては、現場の判断で独自に作戦の変更を行う柔軟な思考の持ち主。"},{"spoiler":false,"text":"また人懐っこい性格と面倒見の良さから、多くの部下に慕われている。"},{"spoiler":false,"text":"何もかも正反対な 騎士団長・リナ からはよく睨まれている。"}],"source":"bangumi","sourceCharacterId":"91325"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b37fe6172ca3558aa771faebc52fa93e084a4844122448b0c13df2391173566c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f4b5de2ae0e78253b4b4cbeeefa0a8ad4179112ce7aa2507f8821c5a039b533.webp","width":96,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤宮菜穂","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154167:91325:6019:1","source":"bangumi"}]},{"characterId":"char_c38040","characterName":"サリエナ＝ハドリー","sourceIds":{"bangumi":[{"characterId":"91326","match":"exact-normalized-name-in-linked-work","subjectId":"154167"},{"characterId":"91326","match":"exact-normalized-name-in-linked-work","subjectId":"328399"}],"egsCharacterIds":["8171"],"vndbCharacterId":"c38040"},"originalCharacterName":"サリエナ＝ハドリー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A woman who holds the position of court magician."},{"spoiler":false,"text":"She also serves as the commander of the Magician Division."},{"spoiler":false,"text":"Although she is a magician, she is also known as the Magic Knight because she wears armor and goes to the front lines as a knight."},{"spoiler":false,"text":"She likes to make clear distinctions between black and white, and is not satisfied unless everything is orderly."},{"spoiler":false,"text":"Perhaps because of this, she also has a strong sense of justice, and her actions based on the principle of immediately killing evil often lead to conflict with Xenovia."},{"spoiler":false,"text":"Her sword skills are only average, but her strength is increased many times over by combining her skills with magic."}],"source":"vndb","sourceCharacterId":"c38040"},{"segments":[{"spoiler":false,"text":"宮廷魔術師の地位を持つ女性。"},{"spoiler":false,"text":"魔導師団の団長も務めている。"},{"spoiler":false,"text":"魔術師ながら、鎧をょ身につけ騎士として前線にも出るため魔導騎士と呼ばれることもある。"},{"spoiler":false,"text":"白黒ハッキリつけたがる性格で、何事も整然としていないと気が済まない性格。"},{"spoiler":false,"text":"そのためか正義心も強く、悪・即・斬の理念に基づいた行動はよくゼノヴィアとの衝突を招く。"},{"spoiler":false,"text":"剣の腕はそこそこだが、魔術との連携によりその強さを何倍にも高めている。"}],"source":"egs","sourceCharacterId":"8171","sourceWorkId":"22185","spoiler":false},{"segments":[{"spoiler":false,"text":"宮廷魔術師の地位を持つ女性で、魔導師団の団長も務めている。"},{"spoiler":false,"text":"魔術師でありながら騎士として前線にも出るため、魔導騎士と呼ばれることも。"},{"spoiler":false,"text":"剣の腕はそこそこだが、魔術との連携によりその強さを何倍にも高めている。"},{"spoiler":false,"text":"白黒ハッキリつけたがる性格で、何事も整然としていないと気が済まない。"},{"spoiler":false,"text":"正義心も強く、“悪・即・斬” の理念に基づいた行動はよく ゼノヴィア との衝突を招く。"},{"spoiler":false,"text":"永続的な付与魔術を持つ主人公に並々ならぬ興味を持ち、早々に親しい関係になる。"}],"source":"bangumi","sourceCharacterId":"91326"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3b0af6dea3177aea201a9c85c56c5dd33bcf1f173c297a896163b6e6cb6e70d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/4323ddf51e9b7a366dfec12a7d172f8c6a305e7fabbe9260edebc67aa26f3e03.webp","width":109,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梅田未央","creatorId":"vndb:s940","sourcePersonId":"vndb:s940","canonicalEntityId":"vndb:s940","name":"梅田 未央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154167:91326:25056:1","source":"bangumi"}]},{"characterId":"char_c43934","characterName":"アシュレイ＝ガーランド","sourceIds":{"bangumi":[{"characterId":"91321","match":"exact-normalized-name-in-linked-work","subjectId":"252082"}],"egsCharacterIds":["20096"],"vndbCharacterId":"c43934"},"originalCharacterName":"アシュレイ＝ガーランド","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this work is an ancient great magician."},{"spoiler":false,"text":"He is the strongest being who recovered his original great power by recovering the magical equipment \"Le Magnus\"."},{"spoiler":false,"text":"However, he has not yet overcome his own flaws, and continues to research for his original purpose."},{"spoiler":false,"text":"Basically, he is devoted to repelling his enemies, and does not think of anything other than invasion to obtain necessary research materials, but from his experience of fighting against the world and being sealed away in the \"Sealing War\" a thousand years ago, he is conscious of taking the initiative against dangerous opponents."},{"spoiler":false,"text":"Ashley is targeted by a new species of demi-human created by the Gareth Empire, but he fights back and takes Ashley into custody. Ashley is interested in the research of the demi-human called Oni, and takes only the barbarian Elemera, who he uses as a spy, and the elf Judith, who he uses as a spy, and attempts to infiltrate the Gareth Empire, leaving the Holy Kingdom to the other women."}],"source":"vndb","sourceCharacterId":"c43934"},{"segments":[{"spoiler":false,"text":"本作の主人公である古の大魔術師。"},{"spoiler":false,"text":"魔装具【ル・マグナス】を取り戻し、本来の強大な力を取り戻した最強の存在。"},{"spoiler":false,"text":"しかし自身の抱える欠陥はいまだ克服されたわけではなく、本来の目的のためいまだ研究を続けている。"},{"spoiler":false,"text":"基本的には敵を退ける事に徹し、必要な研究材料を手に入れるための侵略以外は考えていないが、千年前の【封印戦争】において世界を相手に戦い封印された経験から、危険な相手には先手を打つ意識を持っている。"},{"spoiler":false,"text":"【ガレス】帝国が独自に生み出した新種の亜人にその身を狙われ、返り討ちにしつつその身柄を確保したアシュレイは、【オニ】と呼ばれるその亜人の研究に興味を持ち、密偵として使っている蛮族のエレメラとエルフのジュディスのみを伴い、聖王国は他の女達に任せて【ガレス】帝国への潜入を試みる。"}],"source":"egs","sourceCharacterId":"20096","sourceWorkId":"26960","spoiler":false},{"segments":[{"spoiler":false,"text":"世界の改変を企て、全人類を敵に回し封印されていた古の大魔導師。"},{"spoiler":false,"text":"常人よりも魔力の少ない凡人であったが、知識に研究、鍛錬も重ねてそれを補っていた。"},{"spoiler":false,"text":"その肉体には高度な禁呪が施されており、驚異的な耐久性と半永久的な生命を持つ。"},{"spoiler":false,"text":"復活後は得意の秘術で女性の肉体を手に入れ、"},{"spoiler":false,"text":"付与術師 “シンディ＝クロフォード” として聖王国への潜入を果たす。"},{"spoiler":false,"text":"その目的は、聖王国に封印されている半身たる魔装具 “ル・マグナス” を取り戻すこと。"},{"spoiler":false,"text":"魔装具なしでは強大な力を行使できず、奇策により聖王国を内部から崩壊させようと企んでいる。"}],"source":"bangumi","sourceCharacterId":"91321"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e762728bcc777f41b5995e946f8f7f464fb8bf2c2f3fe38f5d30db11ee8ac9a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfdfc823fe6d07905fa4f84c6e3094320ae0ad3e6f12e11e34a4855cccd6553f.webp","width":104,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c72021","characterName":"エレメラ=ガーウィ","sourceIds":{"bangumi":[{"characterId":"91327","match":"exact-normalized-name-in-linked-work","subjectId":"154167"},{"characterId":"91327","match":"exact-normalized-name-in-linked-work","subjectId":"328399"}],"egsCharacterIds":["8173"],"vndbCharacterId":"c72021"},"originalCharacterName":"エレメラ=ガーウィ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female archer from the Northern Barbarians who attempts to assassinate Ashley on Vols' orders."},{"spoiler":false,"text":"Even among the Northern Barbarians who excel at forest combat, she excels in stealth techniques and is often assigned espionage and assassination missions."},{"spoiler":false,"text":"She is a rare rebellious character among the barbarians, who tend to be male chauvinists, and because she is not only strong-willed but also skilled, the men in the tribes accept her as a member of their fighting groups (setting aside emotional issues)."}],"source":"vndb","sourceCharacterId":"c72021"},{"segments":[{"spoiler":false,"text":"ヴォルスの命令でアシュレイ暗殺しようとする、北の蛮族の女弓使い。"},{"spoiler":false,"text":"森林戦闘を得意とする北の蛮族の中でも特に隠行の術に優れており、諜報・暗殺任務を任される事が多い。"},{"spoiler":false,"text":"比較的男尊女卑の傾向が強い蛮族の中では珍しい跳ねっ返りで、気が強いだけでなく腕も立つため男達も彼女が戦闘集団に混じって戦う事を(感情的な問題はさておいて)認められている。"}],"source":"egs","sourceCharacterId":"8173","sourceWorkId":"22185","spoiler":false},{"segments":[{"spoiler":false,"text":"ヴォルスの命令でアシュレイ暗殺を実行する女弓使い。"},{"spoiler":false,"text":"隠行の術に優れており、諜報・暗殺任務を任されることが多い。"},{"spoiler":false,"text":"気が強く腕も立つため、男尊女卑の蛮族の中でも戦闘集団に混じって戦うことを認められている。"},{"spoiler":false,"text":"暗殺に失敗すると○辱され殺されそうになるが、その場に現れたヴォルスの提案でアシュレイの手下となる。"},{"spoiler":false,"text":"その後は隙を見て復讐を企むが、アシュレイの美しい容姿に潜む強烈な野心、野生的な戦闘本能や残虐性に惚れ込み、虜となって忠誠を誓う。"}],"source":"bangumi","sourceCharacterId":"91327"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f20925bd4e03e34250e9ad47d477daf19f61af310927b019e8bdb1d3f1cc1b53.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/9665bdc87990dde32cabddfe10c110fbecd15b3708cb64f34aac81b28b44db3f.webp","width":167,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水口まつり","creatorId":"vndb:s879","sourcePersonId":"vndb:s879","canonicalEntityId":"vndb:s879","name":"水口 まつり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154167:91327:6380:1","source":"bangumi"}]},{"characterId":"char_c72022","characterName":"ノエル=シルヴェール","sourceIds":{"bangumi":[{"characterId":"91330","match":"exact-normalized-name-in-linked-work","subjectId":"154167"},{"characterId":"91330","match":"exact-normalized-name-in-linked-work","subjectId":"328399"}],"egsCharacterIds":["8174"],"vndbCharacterId":"c72022"},"originalCharacterName":"ノエル=シルヴェール","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the vice-captain and a confidant of Lina, the leader of the Holy Knights."},{"spoiler":false,"text":"She is strict and honest, and at first glance gives the impression of being stubborn, but in reality she has a flexible way of thinking."},{"spoiler":false,"text":"Although she is an aristocrat, she is able to treat commoners equally to a certain extent, and she tends to value courtesy, obligation, and human feelings."}],"source":"vndb","sourceCharacterId":"c72022"},{"segments":[{"spoiler":false,"text":"聖騎士団長リナの腹心で、副団長。"},{"spoiler":false,"text":"謹厳実直で一見すると頭が堅い印象を受けるが、実際には柔軟な思考の持ち主。"},{"spoiler":false,"text":"貴族ながら平民にもある程度隔てなく接する事の出来る人物で、礼節や義理人情を重んじる傾向にある。"}],"source":"egs","sourceCharacterId":"8174","sourceWorkId":"22185","spoiler":false},{"segments":[{"spoiler":false,"text":"聖騎士団長リナの腹心で、副団長。"},{"spoiler":false,"text":"謹厳実直で一見すると頭が堅い印象を受けるが、実際には柔軟な思考の持ち主。"},{"spoiler":false,"text":"貴族ながら平民にもある程度隔てなく接する事の出来る人物で、礼節や義理人情を重んじる傾向にある。"}],"source":"bangumi","sourceCharacterId":"91330"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb81a72262ca384bc6a57f479ac5b733ac599e2652342007792eec4fd17cac8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/524eb01f259e69314a0a7a1f1e73be42fd61b417dff68247fd858b65e96db2f6.webp","width":58,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐倉ゆき","creatorId":"vndb:s839","sourcePersonId":"vndb:s839","canonicalEntityId":"vndb:s839","name":"佐倉 ゆき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154167:91330:15997:1","source":"bangumi"}]},{"characterId":"char_c72023","characterName":"カトリーヌ=オードラン","sourceIds":{"bangumi":[{"characterId":"91329","match":"exact-normalized-name-in-linked-work","subjectId":"154167"},{"characterId":"91329","match":"exact-normalized-name-in-linked-work","subjectId":"328399"}],"egsCharacterIds":["8175"],"vndbCharacterId":"c72023"},"originalCharacterName":"カトリーヌ=オードラン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Captain of the Royal Guard under the direct command of Holy Princess Anastasia."},{"spoiler":false,"text":"A strict and earnest woman who always tries to be strict with herself and others."},{"spoiler":false,"text":"However, her attitude is also the flip side of her weakness of not having confidence in herself, and she acts to maintain her strong will."},{"spoiler":false,"text":"She is just as skilled as Lina, the leader of the Holy Knights, and has high leadership skills, but some say that \"it's hard to relax when she's around.\""}],"source":"vndb","sourceCharacterId":"c72023"},{"segments":[{"spoiler":false,"text":"聖王女アナスタシア直属の親衛隊隊長。"},{"spoiler":false,"text":"厳格で生真面目な性格であり、自他共に厳しくある事を常に心がけている女性。"},{"spoiler":false,"text":"しかしその態度は自分に自信が持てない弱さの裏返しでもあり、強い意志を維持するための行動という一面がある。"},{"spoiler":false,"text":"聖騎士団長のリナに負けず劣らず腕が立ち、統率力は高いが中には「一緒にいると気が休まらない」という者も。"}],"source":"egs","sourceCharacterId":"8175","sourceWorkId":"22185","spoiler":false},{"segments":[{"spoiler":false,"text":"聖王女アナスタシア直属の親衛隊隊長。"},{"spoiler":false,"text":"厳格で生真面目な性格であり、自他共に厳しくある事を常に心がけている女性。"},{"spoiler":false,"text":"しかしその態度は自分に自信が持てない弱さの裏返しでもあり、強い意志を維持するための行動という一面がある。"},{"spoiler":false,"text":"聖騎士団長のリナに負けず劣らず腕が立ち、統率力は高いが中には「一緒にいると気が休まらない」という者も。"}],"source":"bangumi","sourceCharacterId":"91329"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/576b93f3404683e5718a49e96da71f4ed79f03cfd07332e52a9379ceed27bf76.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6de97821af03e192b5953aafda14aefe45368df4bf54dfa203acfb17f220e1d6.webp","width":58,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154167:91329:10027:1","source":"bangumi"}]},{"characterId":"char_c72026","characterName":"ヴォルス＝タッカーツキィ","sourceIds":{"bangumi":[{"characterId":"91328","match":"exact-normalized-name-in-linked-work","subjectId":"154167"}],"egsCharacterIds":["8172"],"vndbCharacterId":"c72026"},"originalCharacterName":"ヴォルス＝タッカーツキィ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is the leader of the Northern Barbarians who are attacking the Holy Kingdom."},{"spoiler":false,"text":"They are currently struggling after Ashley brought magical equipment to the Holy Knights."},{"spoiler":false,"text":"The Northern Barbarians are losing women, and are planning to survive by overrunning the Holy Kingdom, a country of women."},{"spoiler":false,"text":"He quickly saw through Ashley's true identity, and is cunning enough to quickly join forces with her as soon as his assassination attempt fails."},{"spoiler":false,"text":"He is attracted to Ashley's goals and charisma, and eventually pledges to support her with the support of his entire nation."}],"source":"vndb","sourceCharacterId":"c72026"},{"segments":[{"spoiler":false,"text":"聖王国に攻め込んでいる北の蛮族の長。"},{"spoiler":false,"text":"アシュレイが聖騎士団に魔装具を持ち込んだ事で現在苦戦を強いられている。"},{"spoiler":false,"text":"北の蛮族は女性の数が減っており、女性の国である聖王国を蹂躙することで存続を図ろうと考えている。"},{"spoiler":false,"text":"アシュレイの正体をいち早く見抜き、暗殺に失敗した途端 すぐさま手の結ぶ狡猾さを持ちっている。"},{"spoiler":false,"text":"アシュレイの目的やそのカリスマ性に