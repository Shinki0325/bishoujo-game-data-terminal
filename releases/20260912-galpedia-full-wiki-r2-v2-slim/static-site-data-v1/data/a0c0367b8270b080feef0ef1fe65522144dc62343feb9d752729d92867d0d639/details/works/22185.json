ール","sourceIds":{"vndbCharacterId":"c72025"},"originalCharacterName":"カール","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62c19ae2d9fe60b398ced3b3339f32a228aa52a2b3d73b21edc1569056f86d50.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f96c577907c3b9bf61aaa5f444048c8d47776a72f86b012077c5154ff6130626.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳥井 紅子","creatorId":"vndb:s3223","sourcePersonId":"vndb:s3223","canonicalEntityId":"vndb:s3223","name":"鳥井 紅子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:65064","source":"vndb"}]},{"characterId":"char_vndb_c72027","characterName":"ベルナルド＝カディウス四世","sourceIds":{"vndbCharacterId":"c72027"},"originalCharacterName":"ベルナルド＝カディウス四世","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/4080cf5a5aec8e1d70729deef9d08bdfefce3f2e1790df9946cf99f6cc3642a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc310a3a57ae1a04434179a97f8f2f51fc213a8064ad9697f2e0fba86e99fdb3.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c72028","characterName":"ジュディス＝ユーレンティヌス","sourceIds":{"vndbCharacterId":"c72028"},"originalCharacterName":"ジュディス＝ユーレンティヌス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tetsu to Ra -Fairies Falldown-"},{"spoiler":false,"text":"One of the ancient race of high elves, she is extremely young among them, yet ages far more slowly than humans and is already over a hundred years old."},{"spoiler":false,"text":"However, due to her seclusion in the fairy realm, both her mind and body are not fully matured, giving her a somewhat faint physical presence compared to elves living in the human world."},{"spoiler":false,"text":"The high elves, who are a higher species residing in the fairy realm, are more skilled in spirit magic than the elves who settle in the forests of the human world, especially Judith, who excels in stealth techniques and wind magic."},{"spoiler":false,"text":"Yurentinus is the name of the village to which Judith belongs in the fairy realm, which corresponds to what humans would refer to as a surname."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c72028"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c763724c82d5ac378269004789c6e9bd7091695ca399363dd49e1e0ee454938f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98556f5e130effebd38c7870b42aeb2dbb42b157a250a45eaea788e123216e46.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐倉 もも花","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:65055","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p465","sourceCompanyId":"egs:brand:2451","canonicalEntityId":"vndb:p465","name":"つるみく","roleCodes":["brand"],"identityStatus":"auto-confirm