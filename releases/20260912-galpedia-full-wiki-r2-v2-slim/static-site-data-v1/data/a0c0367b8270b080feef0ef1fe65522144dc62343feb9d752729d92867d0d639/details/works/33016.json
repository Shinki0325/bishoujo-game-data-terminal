":"59304"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6645ed1c31b56f46a59f86709ec7c453b2c86c0a1d7d1b78622a97af966b550.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b6a7928e72d41e5d5f1164886f0c183169ae7501b25f06023bfd4b107d485de.webp","width":164,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_59655","characterName":"尼亚","sourceIds":{"bangumi":[{"characterId":"59655","match":"source-roster","subjectId":"205916"},{"characterId":"59655","match":"source-roster","subjectId":"368785"}]},"originalCharacterName":"尼亚","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"猫のような耳が特徴の少女。さばさばした性格でパーティのツッコミ役。年が近いレックスとは馬が合う喧嘩友達。グーラ出身のドライバーで、ビャッコからは「お嬢様」と呼ばれている。ニアを操作時はビャッコに乗ってフィールドを移動できる。"}],"source":"bangumi","sourceCharacterId":"59655"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a07826890d9c94dad6432f9354c8ec57dbc3f982bbc49484acfaa599902c8ab0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1704b1b9a9b75ddc0a2d1af072507e56e323c400e6ec0ec7c28d97349f7c070.webp","width":174,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大和田仁美","creatorId":"vndb:s17876","sourcePersonId":"vndb:s17876","canonicalEntityId":"vndb:s17876","name":"大和田 仁美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:368785:59655:15988:1","source":"bangumi"}]},{"characterId":"char_bangumi_59656","characterName":"虎","sourceIds":{"bangumi":[{"characterId":"59656","match":"source-roster","subjectId":"205916"},{"characterId":"59656","match":"source-roster","subjectId":"368785"}]},"originalCharacterName":"虎","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ノポン族の少年。レックスを「アニキ」と呼び慕っている。メカ好きでドライバーに憧れている。祖父の代から3代かけて人工ブレイドのハナを完成させた。武器はドリルの付いた「ハナシールド」。"}],"source":"bangumi","sourceCharacterId":"59656"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f35464f3f096576160f5b922316d99bf6e6ad608ad685a47a7dcfc5c03434d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/7853927570343e1aa14a017840e9d913a00dc994f89c9d96eefec9f63cc49d50.webp","width":234,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_59657","characterName":"花","sourceIds":{"bangumi":[{"characterId":"59657","match":"source-roster","subjectId":"205916"},{"characterId":"59657","match":"source-roster","subjectId":"368785"}]},"originalCharacterName":"花","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"トラが作り上げた人工ブレイド。少女型のメタリックなボディをしている。ノポン語を話せ語尾に「も」をつける。通常のブレイドと強化の方法が異なり、ミニゲーム「Tiger!Tiger!」で手に入れたアイテムを使った「ハナライズ」で行い、能力を高めたり属性やタイプを自由にカスタマイズできる。パワーアップするとメイド服を着た「ハナJK」という姿に変わる。"}],"source":"bangumi","sourceCharacterId":"59657"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a8bc282e4872ee90d923cb3d72acc3721d260ed2385879f5c6a463cdbbfbbfa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2bfd26a2a23f8b7f1f0c8c09bb039f1e8ffcd4584fc4cce107b325f1e67e2958.webp","width":174,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_59658","characterName":"Zeke","sourceIds":{"bangumi":[{"characterId":"59658","match":"source-roster","subjectId":"205916"},{"characterId":"59658","match":"source-roster","subjectId":"368785"}]},"originalCharacterName":"Zeke","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「雷轟のジーク」の二つ名を持つ流れ者のドライバー。一人称は「ワイ」で関西弁で話す。レックスたちよりも年上だがどこか抜けている。左目に眼帯をしており、本人曰くその下には「覇王の心眼」が隠されているらしい。「極・玄武」は「アルティメット・ゲンブ」と読む。"}],"source":"bangumi","sourceCharacterId":"59658"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/2383cfdd2800e992153a431d2f9490b3f7b64715ea4efe960ecbbcf46e9f22ec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79b75adf39f53009864f2dedc06738ea32adaddcb5c94f4823f15dbc4a23baed.webp","width":173,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_59659","characterName":"Pandoria","sourceIds":{"bangumi":[{"characterId":"59659","match":"source-roster","subjectId":"205916"},{"characterId":"59659","match":"source-roster","subjectId":"368785"}]},"originalCharacterName":"Pandoria","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ジークのブレイド。大きな丸眼鏡をかけた女性。ジークと同じく関西弁で話す。テキパキした性格でジークの世話を焼いている。大型の剣「紫電参式轟」を生み出すことができ、持っている杖は剣の柄の部分。属性は雷。"}],"source":"bangumi","sourceCharacterId":"59659"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8ce789a111a8103ff8d62b7769e0a3a347f5e2536afab7b2e1add2bcc5cecb51.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa6ac9271d26f120c6eb2118219dcf7141242483cfb4dd865aa9b7fcdcf6c4c2.webp","width":140,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_59660","characterName":"Dromarch","sourceIds":{"bangumi":[{"characterId":"59660","match":"source-roster","subjectId":"205916"},{"characterId":"59660","match":"source-roster","subjectId":"368785"}]},"originalCharacterName":"Dromarch","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"ニアのブレイド。白い虎のような姿をしており、人語を話すことができる。ニアが幼い頃から一緒におり、執事のように従っている。属性は水。"}],"source":"bangumi","sourceCharacterId":"59660"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/990747a8a22a6501e7492e565ad3b883818353fa07dc4c8ccc3f7175f8279e8e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4fe5ff53a1a961261c21ea10635f7e3686590507a2b6184858a1fd9c92ea31cc.webp","width":211,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_66470","characterName":"メレフ","sourceIds":{"bangumi":[{"characterId":"66470","match":"source-roster","subjectId":"205916"},{"characterId":"66470","match":"source-roster","subjectId":"368785"}]},"originalCharacterName":"メレフ","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"スペルビア帝国特別執権官にして帝国最強のドライバー。「天の聖杯」を追い、たびたびレックスとホムラの行く手に立ちふさがる。"}],"source":"bangumi","sourceCharacterId":"66470"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/676203f5db8c1769c891db579253e93786bf4d9cd9363835062cfddcc