riptions":[{"segments":[{"spoiler":false,"text":"Saki is a first year student and know about Tatsuya from when he studied with her mother. When she sees a mural he painted, she immediately recognises his art style and begs him to tutor her in art."},{"spoiler":false,"text":"Whilst Saki is an extremely bright and sensible girl, she can sometimes show a childish, emotional side when upset."}],"source":"vndb","sourceCharacterId":"c104888"},{"segments":[{"spoiler":false,"text":"新入生の少女。真面目で芯が強く、少々堅物な委員長タイプ……かと思いきや、世間知らずで子供っぽいところもあり、同性はもちろん異性からも、庇護欲をかきたてられる存在となっている。"},{"spoiler":false,"text":"趣味と特技は絵を描くこと。"},{"spoiler":false,"text":"自己流で非凡なセンスを見せることもあるが、最近は少し伸び悩んでいる。"},{"spoiler":false,"text":"過去には心をなくすほどの出来事に見舞われたが、その際に心の支えになったのが、主人公の作品だった。"},{"spoiler":false,"text":"故に、好んで主人公の画風を模倣している。"},{"spoiler":false,"text":"そのまっすぐさと危なっかしさから、主人公は彼女から目を離せない。"},{"spoiler":false,"text":"入学してしばらくした後に、主人公が恩人だと気づき、弟子入りを志願。主人公に袖にされるも、しぶとく社会科準備室へと押しかけるようになる。"}],"source":"egs","sourceCharacterId":"24000","sourceWorkId":"32223","spoiler":false},{"segments":[{"spoiler":false,"text":"新入生の少女。真面目で芯が強く、少々堅物な委員長タイプ……"},{"spoiler":false,"text":"かと思いきや、世間知らずで子供っぽいところもあり、"},{"spoiler":false,"text":"同性はもちろん異性からも、庇護欲をかきたてられる存在となっている。"},{"spoiler":false,"text":"趣味と特技は絵を描くこと。"},{"spoiler":false,"text":"自己流で非凡なセンスを見せることもあるが、"},{"spoiler":false,"text":"最近は少し伸び悩んでいる。"},{"spoiler":false,"text":"過去には心をなくすほどの出来事に見舞われたが、"},{"spoiler":false,"text":"その際に心の支えになったのが、主人公の作品だった。"},{"spoiler":false,"text":"故に、好んで主人公の画風を模倣している。"},{"spoiler":false,"text":"そのまっすぐさと危なっかしさから、"},{"spoiler":false,"text":"主人公は彼女から目を離せない。"},{"spoiler":false,"text":"入学してしばらくした後に、主人公が恩人だと気づき、"},{"spoiler":false,"text":"弟子入りを志願。主人公に袖にされるも、"},{"spoiler":false,"text":"しぶとく社会科準備室へと押しかけるようになる。"}],"source":"bangumi","sourceCharacterId":"106800"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"24000","sourceWorkId":"32223","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","value