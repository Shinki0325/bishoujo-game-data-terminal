:false,"text":"狭霧ヶ丘学園に通う２年生。"},{"spoiler":false,"text":"性格は比較的真面目で、人当たりもよい。"},{"spoiler":false,"text":"わりと社交的な性格でもあり、初対面の人間とも気兼ねなく話せるタイプ。"},{"spoiler":false,"text":"一方でそれ以上に特筆できる特技などは持ち合わせておらず、"},{"spoiler":false,"text":"部活などにも所属せずに日々をのんびり過ごしている。"},{"spoiler":false,"text":"しかし見た目はやや中性的ながらも整っていて、"},{"spoiler":false,"text":"周囲の女子から見てもわりと好印象。"},{"spoiler":false,"text":"ただし本人は、自分のそんな評判について過大評価だと思っている。"},{"spoiler":false,"text":"現に生まれてこの方、異性と付き合ったことは一度もない。"}],"source":"egs","sourceCharacterId":"541","sourceWorkId":"18153","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d093e5a00c019871345b1fb3b22a41e2c891f94c1de9a89ecc3d4055950aba5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38c351fa6dbc9af636dcfa3fdffbe2e3b3c1b1844f61403ea60dcc2ab43f530e.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c13646","characterName":"のどっち","sourceIds":{"bangumi":[{"characterId":"55404","match":"exact-normalized-name-in-linked-work","subjectId":"62621"}],"egsCharacterIds":["536"],"vndbCharacterId":"c13646"},"originalCharacterName":"のどっち","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1101"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The new transfer student that Confess to Minato"}],"source":"vndb","sourceCharacterId":"c13646"},{"segments