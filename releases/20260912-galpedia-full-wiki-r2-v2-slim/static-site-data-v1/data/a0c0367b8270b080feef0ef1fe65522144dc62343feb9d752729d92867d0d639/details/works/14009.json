Id":"vndb:s194","name":"あおき さやか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28026","source":"vndb"}]},{"characterId":"char_vndb_c8620","characterName":"柊 旭","sourceIds":{"vndbCharacterId":"c8620"},"originalCharacterName":"柊 旭","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's older sister. She is a student at a university of arts and is majoring in design. After both of their parents died, she started doing housework and took care of the protagonist as a substitute parent. The protagonist was worried about being a burden to her so he moved to the Hisekisou apartment complex, but she actually has a brother complex so she is hoping that he will return."},{"spoiler":false,"text":"Based on Wikipedia"}],"source":"vndb","sourceCharacterId":"c8620"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/644af17ecac2203384d20285a974962499676fbdb7f31e9d896cb0fa7de830a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec05587f54e61e65803fceeffe86e4bde2d53ee12dc8cd6b14481f3cfc6e1943.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"遠野 そよぎ","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28028","source":"vndb"}]},{"characterId":"char_vndb_c8621","characterName":"遊田","sourceIds":{"vndbCharacterId":"c8621"},"originalCharacterName":"遊田","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A nun living in room 201 of the Hisekisou apartment complex. She is the homeroom teacher of the protagonist's class. She teaches music but is also in charge of student guidance. She is an extremely useless adult. She always oversleeps, she tells weird proverbs to the protagonist and the heroines, and she tells dirty jokes. During events at the church she plays the pipe organ."},{"spoiler":false,"text":"Based on Wikipedia"}],"source":"vndb","sourceCharacterId":"c8621"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/7191167481243ac38ae14c9c3c7929728c4c27754be8be5cd1809766ae8ae01e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59ee617af6e79e343050b3250604d9a98fadcaf646fe1a3a36b02203f41d0308.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"湖月 紅れ葉","creatorId":"vndb:s1659","sourcePersonId":"vndb:s1659","canonicalEntityId":"vndb:s1659","name":"稲田 佳乃香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28040","source":"vndb"}]},{"characterId":"char_vndb_c8622","characterName":"姫","sourceIds":{"vndbCharacterId":"c8622"},"originalCharacterName":"姫","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The granddaughter of the president of the company that the protagonist's parents worked for. She calls the protagonist \"onii-chan\" and acts like a spoiled baby ever since he taught her how to fold paper airplanes. Whenever she encounters the protagonist, she secretly follows him to the apartment complex and the church and causes commotion."},{"spoiler":false,"text":"Based on Wikipedia"},{"spoiler":true,"text":"Hime real name is 姫光空 (Hikari Sora). At first she hate to called as Sora so she use ヒカリ (hikari) to make other people call her. But yuuhi give her nickname and called her Hime as their friendship."}],"source":"vndb","sourceCharacterId":"c8622"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/2797dbf579a5d9813ede6e9b235d3fcd4dadf56bef9a8ba178d3c88c6b5c8e7a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9551530da63397325cae5fbcf7b8de911995dd6d215a38c73ac8a34de8ef4db.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風音","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28032","source":"vndb"}]},{"characterId":"char_vndb_c8623","characterName":"楓","sourceIds":{"vndbCharacterId":"c8623"},"originalCharacterName":"楓","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hime's attendant and maid that takes care of her in place of her busy parents. She is an expert at housework. She dotes on Hime too much and gets nosebleeds if she becomes too excited. She is willing to kill if it's for Hime's sake, and she warns the protagonist whenever possible."},{"spoiler":false,"text":"Based on Wikipedia"}],"source":"vndb","sourceCharacterId":"c8623"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08ede376b825b6e4570d2998836c9aacd2325820680d2842fb03d41dc64f0ed2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15