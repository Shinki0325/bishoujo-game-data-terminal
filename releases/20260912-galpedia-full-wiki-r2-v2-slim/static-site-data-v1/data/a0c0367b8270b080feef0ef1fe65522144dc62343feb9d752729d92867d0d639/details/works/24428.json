vndb:vn-staff:133893","source":"vndb"}]},"cast":[{"characterId":"char_c55762","characterName":"如月 零","sourceIds":{"bangumi":[{"characterId":"47928","match":"exact-normalized-name-in-linked-work","subjectId":"196972"}],"egsCharacterIds":["13214"],"vndbCharacterId":"c55762"},"originalCharacterName":"如月 零","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1018"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rei, the only child of the Kisaragi family and the protagonist's cousin. Since she was often exposed to the political conflict between groups from her young age with her relatives, she's not friendly with people other than close friends. In order to avoid unnecessary troubles, rarely going out and often spends her time at the House of the Kisaragi family called \"Mechanical mansion deep in the forest\"."}],"source":"vndb","sourceCharacterId":"c55762"},{"segments":[{"spoiler":false,"text":"財閥、如月家の一人娘。"},{"spoiler":false,"text":"多くの分家を持つからくり職人の一族であり、現在はＩＴ、機械産業を中核としたグループを形成している。"},{"spoiler":false,"text":"幼い頃から親族との間のグループ間の政治抗争に晒される事が多かったため、親しい人間以外には愛想が悪い。"},{"spoiler":false,"text":"不必要なトラブルを避けるためにも外に出る事は滅多に無く『森の奥のからくり屋敷』と呼ばれる如月家本家の邸宅で過ごしている。"},{"spoiler":false,"text":"如月家の分家一族でありながら、如月の本家に対して距離を保ちつつ独自の生活を担っていた卯月家とは、余計なしがらみがないため気を抜いて付き合える間柄だった。"},{"spoiler":false,"text":"そのため、誠一とは家族のように育つ。"},{"spoiler":false,"text":"如月家の跡取りとして古くから受け継がれてきた独自の儀式について、誠一が知らない知識を多々持っている。"}],"source":"egs","sourceCharacterId":"13214","sourceWorkId":"24428","spoiler":false},{"segments":[{"spoiler":false,"text":"身長：162cm　 体重：55kg　 スリーサイズ：B88/ W56/ H85"},{"spoiler":false,"text":"多くの分家を持つ財閥・如月家の一人娘。"},{"spoiler":false,"text":"如月は からくり職人の一族であり、現在はIT・機械産業を中核としている。"},{"spoiler":false,"text":"“森の奥のからくり屋敷” と呼ばれる如月家本家の邸宅で過ごしている。"},{"spoiler":false,"text":"幼い頃から政治抗争に晒されてきたため、親しい人間以外には愛想が悪い。"},{"spoiler":false,"text":"しがらみの薄い卯月家とは気楽に付き合える間柄で、誠一とは家族のように育った。"},{"spoiler":false,"text":"如月家の跡取りとして、受け継がれてきた儀式について様々な知識を持っている。"},{"spoiler":false,"text":"「私はこの土地で朽ちていく。 その覚悟は出来ている」"}],"source":"bangumi","sourceCharacterId":"47928"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"13214","sourceWorkId":"24428","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"13214","sourceWorkId":"24428","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"13214","sourceWorkId":"24428","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"13214","sourceWorkId":"24428","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"55 kg","valueContext":null,"source":"egs","sourceCharacterId":"13214","sourceWorkId":"24428","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e17827039bbb3f086317fe24e7dc3e583fc1dc7c1cfa437bf87d313cc22f542e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/2063ce94250d49a03e7e7fa074090a203dc6b0d3895c4e64094db191425855bd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三宅麻理恵","creatorId":"vndb:s2258","sourcePersonId":"vndb:s2258","canonicalEntityId":"vndb:s2258","name":"三宅 麻理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relation