"spoiler":false,"text":"屋敷が事件の渦中にあってもなお、普段の態度を崩すことはない。"},{"spoiler":false,"text":"零が化けた姿なのか、あるいは……。"},{"spoiler":false,"text":"「……ふふ、楽しいわね」"}],"source":"bangumi","sourceCharacterId":"47927"}],"profileFacts":[{"label":"胸围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"13220","sourceWorkId":"24428","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"13220","sourceWorkId":"24428","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"13220","sourceWorkId":"24428","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"42 cm","valueContext":null,"source":"egs","sourceCharacterId":"13220","sourceWorkId":"24428","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"68 kg","valueContext":null,"source":"egs","sourceCharacterId":"13220","sourceWorkId":"24428","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/7230fb127032e773c057f9c7edf5e12010d203ae0c34f2e18cd2602b79aa0212.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f10ff7558979a064934689b63dda1dc64ed3be91c0bb415777e6a2480f9c3445.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三宅麻理恵","creatorId":"vndb:s2258","sourcePersonId":"vndb:s2258","canonicalEntityId":"vndb:s2258","name":"三宅 麻理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:196972:47927:6846:1","source":"bangumi"}]},{"characterId":"char_c55764","characterName":"水無月 一葉","sourceIds":{"bangumi":[{"characterId":"47926","match":"exact-normalized-name-in-linked-work","subjectId":"196972"}],"egsCharacterIds":["13215"],"vndbCharacterId":"c55764"},"originalCharacterName":"水無月 一葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"907"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"71"},"height":{"reviewState":"no-conflict","source":"vndb","value":"146"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"62"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"48"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A maid working for the Kisaragi family. Kazuha likes to read manga and play games, especially TCG, but she cannot discuss it with someone else, since the Kisaragi family doesn't talk too much. She wants to know what happened to her parents and the truth of the fire incident, which happened in the past at the house of her family."}],"source":"vndb","sourceCharacterId":"c55764"},{"segments":[{"spoiler":false,"text":"如月家で働くメイド。"},{"spoiler":false,"text":"零や誠一より年下で、学校には通っていない。"},{"spoiler":false,"text":"実家は元は如月家の別の分家だったが、過去に起きた火災事故により家族共に焼失。一人残された一葉がサエに引き取られる。"},{"spoiler":false,"text":"サエの息子夫婦は既に独立しているため、一葉がサエの手伝いをしている。"},{"spoiler":false,"text":"戸籍上は養女だが、サエの事をお婆様と呼んで慕っている。"},{"spoiler":false,"text":"少女らしくゲームや漫画が好きで特にＴＣＧが好きだが、如月家の人間では話が合わない事が多いため、少し物足りなく思っている。"},{"spoiler":false,"text":"過去に起きた実家の火災事件の真相を知りたいと思っている。"}],"source":"egs","sourceCharacterId":"13215","sourceWorkId":"24428","spoiler":false},{"segments":[{"spoiler":false,"text":"身長：146cm　 体重：43kg　 スリーサイズ：B71/ W48/ H62"},{"spoiler":false,"text":"如月家で働くメイド。"},{"spoiler":false,"text":"零や誠一より年下で、学園には通っていない。"},{"spoiler":false,"text":"如月家の分家だが火災で家族と家を失い、如月家の家政婦・さえに引き取られた。"},{"spoiler":false,"text":"戸籍上は養女だが、さえのことをお婆様と呼んで慕っている。"},{"spoiler":false,"text":"少女らしくゲームや漫画が好きで、特にTCGが好き。"},{"spoiler":false,"text":"如月家の人間では話が合わないことが多いため、少し物足りなく思っている。"},{"spoiler":false,"text":"過去に起きた火災事故の真相を知りたいと思っている。"},{"spoiler":false,"text":"「はい！　せいいっぱいお世話いたします！」"}],"source":"bangumi","sourceCharacterId":"47926"}],"profileFacts":[{"label":"胸围（本版本）","value":"71 cm","valueContext":null,"source":"egs","sourceCharacterId":"13215","sourceWorkId":"24428","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"146 cm","valueContext":null,"source":"egs","sourceCharacterId":"13215","sourceWorkId":"24428","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"13215","sourceWorkId":"24428","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"48 cm","valueContext":null,"source":"egs","sourceCharacterId":"13215","sourceWorkId":"24428","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"43 kg","valueContext":null,"source":"egs","sourceCharacterId":"13215","sourceWorkId":"24428","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aaba91b945b34a49e0fbd41b7e3631dbcbb28c9287045b39c581b2f82087688d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/deebb72bc4f512d79349adc378c6ada0582666c56a18f4b5a590b854f4d5d87e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長妻樹里","creatorId":"vndb:s1197","sourcePersonId":"vndb:s1197","canonicalEntityId":"vndb:s1197","name":"長妻 樹里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:196972:47926:8493:1","source":"bangumi"}]},{"characterId":"char_c55765","characterName":"野上 美優","sourceIds":{"bangumi":[{"characterId":"47925","match":"exact-normalized-name-in-linked-work","subjectId":"196972"}],"egsCharacterIds":["13216"],"vndbCharacterId":"c55765"},"originalCharacterName":"野上 美優","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","