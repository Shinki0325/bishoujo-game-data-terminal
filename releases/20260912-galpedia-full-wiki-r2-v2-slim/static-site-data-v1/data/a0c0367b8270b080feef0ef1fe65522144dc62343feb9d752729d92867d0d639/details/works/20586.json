阿比留 壽浩","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:110395","source":"vndb"}]},"cast":[{"characterId":"char_c19108","characterName":"羽鳥 香凛","sourceIds":{"bangumi":[{"characterId":"44367","match":"exact-normalized-name-in-linked-work","subjectId":"106512"}],"egsCharacterIds":["4120"],"vndbCharacterId":"c19108"},"originalCharacterName":"羽鳥 香凛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"私立百里学院３年生。"},{"spoiler":false,"text":"１年生の時からずっと委員長を務めている、気配りができて面倒見いい、優しい女の子。"},{"spoiler":false,"text":"成績は優秀でスポーツも万能ながら、特定の部活には所属していない。"},{"spoiler":false,"text":"あまり裕福な家庭ではないため、国立大学の特待生を目指して勉強中。"},{"spoiler":false,"text":"性格上、周りの人たちから頼られて交友関係は広いが、そんな中でも、俊に対してだけは特別な想いをいだいている。"},{"spoiler":false,"text":"高校３年間、ずっと一緒のクラスだった俊とは、日々を過ごす中、気心も知れ、クラスメイトという仲から、いつしか恋愛対象に変わっていた。"},{"spoiler":false,"text":"日に日に俊への想いが強くなり、自分でも整理がつかないほど思い悩んでいた……が、一心、俊に想いを告げる事を決心する。"}],"source":"egs","sourceCharacterId":"4120","sourceWorkId":"20586","spoiler":false},{"segments":[{"spoiler":false,"text":"私立 百里学院 3年生。 1年の時からずっと委員長を務めている、面倒見の良い優しい女の子。"},{"spoiler":false,"text":"成績は優秀でスポーツも万能ながら、特定の部活には所属していない。"},{"spoiler":false,"text":"あまり裕福な家庭ではないため、国立大学の特待生を目指して勉強中。"},{"spoiler":false,"text":"高校 3年間をずっと一緒のクラスだった主人公とは気心も知れ、いつしか恋心を抱いていた。"},{"spoiler":false,"text":"さらに今後は別々の道を歩むことが決まっていることもあって、思い悩んだ末に告白を決意する。"},{"spoiler":false,"text":"当然ながら雛奈との兄妹仲は知っている。 心の奥で嫉妬しているが表には出さず、微笑みながら耐えている。"},{"spoiler":false,"text":"妹に敵意を見せることで主人公に嫌われたくないという脅迫観念から、いつも一歩引いてしまっている。"}],"source":"bangumi","sourceCharacterId":"44367"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"4120","sourceWorkId":"20586","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"4120","sourceWorkId":"20586","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"4120","sourceWorkId":"20586","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"4120","sourceWorkId":"20586","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"4120","sourceWorkId":"20586","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"47 kg","valueContext":null,"source":"egs","sourceCharacterId":"4120","sourceWorkId":"20586","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b6fc16702509036ab77de2a808093d272becb2413200eacc36268b55e8232b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/974c4929e1425b67b99811a7fdd2ec71c1029a27aba14a48fc11d43e8bd21814.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:106512:44367:10026:1","source":"bangumi"}]},{"characterId":"char_c19109","characterName":"彭城 雛奈","sourceIds":{"bangumi":[{"characterId":"44366","match":"exact-normalized-name-in-linked-work","subjectId":"106512"}],"egsCharacterIds":["4119"],"vndbCharacterId":"c19109"},"originalCharacterName":"彭城 雛奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"私立百里学院１年生。"},{"spoiler":false,"text":"可愛くて愛くるしい幼い顔立ちと、それに不釣合い過ぎる豊満な巨乳の、小さな女の子。"},{"spoiler":false,"text":"しかし、兄である俊の事が大好きなためで、小さい、幼い、子供……に見られる事が大嫌いで、今ではその小さい（低い）身長が、最大のコンプレックス。"},{"spoiler":false,"text":"彼女の前で『小さい』『低い』などのフレーズは禁句。"},{"spoiler":false,"text":"いつも明るく、天真爛漫な笑顔と人懐こい事から、男子だけでなく女子にも可愛がられているマスコット的な存在。"}],"source":"egs","sourceCharacterId":"4119","sourceWorkId":"20586","spoiler":false},{"segments":[{"spoiler":false,"text":"私立 百里学院 1年生。 かわいくて愛くるしい顔立ちと、それに不釣合い過ぎる豊満な巨乳をもつ小さな女の子。"},{"spoiler":false,"text":"天真爛漫な笑顔と人懐こさから、男子だけでなく女子にも可愛がられているマスコット的な存在。"},{"spoiler":false,"text":"時々湧き上がる感情を抑えられず、暴走してしまうような子供っぽいところもある。"},{"spoiler":false,"text":"しかし年上である兄のことが大好きなため、小さい・幼い・子供に見られることが大嫌いで、身長が低いことは最大のコンプレックス。"},{"spoiler":false,"text":"彼女のあからさまな行動から、主人公のことが大好きだというのは周知の事実。"},{"spoiler":false,"text":"さすがに他人には言えないけど、できることならお兄ちゃんと結婚したいと本気で考えているほど。"},{"spoiler":false,"text":"また、幼い見た目に反してエッチなことには興味津々で、大好きなお兄ちゃんと結ばれることを妄想し夢見ている。"}],"source":"bangumi","sourceCharacterId":"44366"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"44366","value":"料理作り（自慢は豚角煮、筑前煮、パンケーキ）"},{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"4119","sourceWorkId":"20586","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,