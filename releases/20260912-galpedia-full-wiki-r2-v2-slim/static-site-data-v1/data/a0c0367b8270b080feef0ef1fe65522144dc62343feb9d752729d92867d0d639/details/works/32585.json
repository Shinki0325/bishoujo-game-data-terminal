{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"32585","model":{"presentationWorkId":"vndb:v35328","staff":{"artwork":[{"creditedName":"ギザン","creatorId":"vndb:s20060","sourcePersonId":"egs:creator:34422","canonicalEntityId":"vndb:s20060","name":"ギザン","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:248225","source":"egs"}],"scenario":[{"creditedName":"若林浩太郎(鏃キロク)","creatorId":"vndb:s2555","sourcePersonId":"egs:creator:2257","canonicalEntityId":"vndb:s2555","name":"若林浩太郎(鏃キロク)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:248226","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c107106","characterName":"宮竹 悠那","sourceIds":{"bangumi":[{"characterId":"109931","match":"exact-normalized-name-in-linked-work","subjectId":"379307"}],"egsCharacterIds":["24003"],"vndbCharacterId":"c107106"},"originalCharacterName":"宮竹 悠那","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ユキが住むマンションの大家をしている。"},{"spoiler":false,"text":"真面目で内気な性格の薄幸グラマラス美女。"},{"spoiler":false,"text":"彩奈の幼馴染みであり、彩奈をお姉さんのように慕っている。"},{"spoiler":false,"text":"不幸な事故で伴侶を失い２年"},{"spoiler":false,"text":"ユキと出会ったことで彼女の中の時間が動き出す。"},{"spoiler":false,"text":"果たしてふたりはどんな結末を迎えるのか。"}],"source":"egs","sourceCharacterId":"24003","sourceWorkId":"32585","spoiler":false},{"segments":[{"spoiler":false,"text":"ユキが住むマンションの大家をしている。"},{"spoiler":false,"text":"規格外のプロポーションを持つグラマラス美女。"},{"spoiler":false,"text":"2年前に不幸な事故で旦那を亡くしており、それ以来他人を好きになることはないだろうと思っていた。"},{"spoiler":false,"text":"密かに亡くなった夫に似てお人好しのユキに惹かれていた、"},{"spoiler":false,"text":"そんなとき彼のマッサージを受けることになり、思わずエッチすることに。"},{"spoiler":false,"text":"自分の気持ちすらハッキリしないまま思いを募らせマッサージに通いエッチする、"},{"spoiler":false,"text":"そんな彼女が最後に出した結論とは……？"}],"source":"bangumi","sourceCharacterId":"109931"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9fe9c1bc3de63c890889838343c33496293617bde1841f7b08c7d6d697db385e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b57010098d821673a90f13ed9af535e3ca2ee11f96d4f18daf504c63974bb39.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"清水美紗","creatorId":"vndb:s1975","sourcePersonId":"vndb:s1975","canonicalEntityId":"vndb:s1975","name":"よもぎかすみ(蓬かすみ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:379307:109931:21151:1","source":"bangumi"}]},{"characterId":"char_c107107","characterName":"朝比奈 彩奈","sourceIds":{"bangumi":[{"characterId":"109932","match":"exact-normalized-name-in-linked-work","subjectId":"379307"}],"egsCharacterIds":["24004"],"vndbCharacterId":"c107107"},"originalCharacterName":"朝比奈 彩奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の師匠であり、悠那の幼馴染み。"},{"spoiler":false,"text":"朝比奈整骨院の院長を務めており、そのマッサージの腕はオンリーワンと言われ資産家の顧客を多く抱えている。"},{"spoiler":false,"text":"結婚しているのだが気に入った相手とは寝るというスタンスであり旦那は寝取られ感が楽しめると喜んでいる。"}],"source":"egs","sourceCharacterId":"24004","sourceWorkId":"32585","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の師匠であり、悠那の幼馴染み。"},{"spoiler":false,"text":"朝比奈整骨院の院長であり、主人公に本格的なマッサージの技術を教えた。"},{"spoiler":false,"text":"主人公のことは学生時代から気に入っており、いつ寝てもいいと思っている。"},{"spoiler":false,"text":"マッサージの腕はオンリーワンと言われ、人間以外の動物すら治してしまったこともあるという。"},{"spoiler":false,"text":"一般の顧客はもちろんのこと、資産家の顧客を多く抱えている。"},{"spoiler":false,"text":"結婚しているのだが気に入った相手とは寝るというスタンスであり、旦那は寝取られ感が楽しめると喜んでいる。"},