:"bangumi"}]},{"characterId":"char_c89359","characterName":"アプスー","sourceIds":{"bangumi":[{"characterId":"74694","match":"exact-normalized-name-in-linked-work","subjectId":"285787"}],"egsCharacterIds":["22537"],"vndbCharacterId":"c89359"},"originalCharacterName":"アプスー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『水のオリジン（始原体）』と呼ばれ、水を司る創神を束ねる者。創神としての姿は、巨大なクラゲ。河川の水質を管理したり、眷神を用いて治水工事も行う。"},{"spoiler":false,"text":"オリジンの人としての現身である化身体の姿では、慈愛に満ちながらも情熱的なグラマーボディの美女。間延びした口調で話し、おっとり穏やかな性格。"}],"source":"egs","sourceCharacterId":"22537","sourceWorkId":"28151","spoiler":false},{"segments":[{"spoiler":false,"text":"始原の水の創神"},{"spoiler":false,"text":"アプスー"},{"spoiler":false,"text":"『水のオリジン（始原体）』と呼ばれ、水を司る創神を束ねる者。創神としての姿は、巨大なクラゲ。河川の水質を管理したり、眷神を用いて治水工事も行う。"},{"spoiler":false,"text":"オリジンの人としての現身である化身体の姿では、慈愛に満ちながらも情熱的なグラマーボディの美女。間延びした口調で話し、おっとり穏やかな性格。"},{"spoiler":false,"text":"原画：なるみすずね"},{"spoiler":false,"text":"声優：宮森ゆう"}],"source":"bangumi","sourceCharacterId":"74694"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/9827aff2bfaa394ba79d7366db18e972ce433be965dd652b20f0367280ad3aa6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/5059490bbd9b6e4ba866a203da09b45bc92c3f4e8514c7b7506cb7f44c817d01.webp","width":210,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:285787:74694:4799:1","source":"bangumi"}]},{"characterId":"char_c89360","characterName":"シャマシュ","sourceIds":{"bangumi":[{"characterId":"74695","match":"exact-normalized-name-in-linked-work","subjectId":"285787"}],"egsCharacterIds":["22538"],"vndbCharacterId":"c89360"},"originalCharacterName":"シャマシュ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『太陽のオリジン（始原体）』と呼ばれ、光を司る創神を束ねる者。創神としての姿は、荘厳な神鳥。"},{"spoiler":false,"text":"太神鳥の紋章はメギストス王家の象徴にもなっており、人々の信仰上でも神格化されている存在。世界の危機が迫った時、王族や世界の命運を左右する人物に近付いて、予言する巫女のような役割を果たすという。審判神としての側面もあるが、実は臆病で自分の権能が重荷だったりする。"}],"source":"egs","sourceCharacterId":"22538","sourceWorkId":"28151","spoiler":false},{"segments":[{"spoiler":false,"text":"始原の太陽の創神"},{"spoiler":false,"text":"シャマシュ"},{"spoiler":false,"text":"『太陽のオリジン（始原体）』と呼ばれ、光を司る創神を束ねる者。創神としての姿は、荘厳な神鳥。"},{"spoiler":false,"text":"太神鳥の紋章はメギストス王家の象徴にもなっており、人々の信仰上でも神格化されている存在。世界の危機が迫った時、王族や世界の命運を左右する人物に近付いて、予言する巫女のような役割を果たすという。審判神としての側面もあるが、実は臆病で自分の権能が重荷だったりする。"},{"spoiler":false,"text":"原画：なるみすずね"},{"spoiler":false,"text":"声優：八尋まみ"}],"source":"bangumi","sourceCharacterId":"74695"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31e687727ca24fec65e9213d32b5d4f8f541321e6a6a49ef246b4bcdb5f0029f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/6996fcd6fac496477bca7d63920853e379eccd1c6f937f40379886eb41ed3923.webp","width":211,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間宮菜南子","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:285787:74695:15995:1","source":"bangumi"}]},{"characterId":"char_c89361","characterName":"キュベ","sourceIds":{"bangumi":[{"characterId":"74693","match":"exact-normalized-name-in-linked-work","subjectId":"285787"}],"egsCh