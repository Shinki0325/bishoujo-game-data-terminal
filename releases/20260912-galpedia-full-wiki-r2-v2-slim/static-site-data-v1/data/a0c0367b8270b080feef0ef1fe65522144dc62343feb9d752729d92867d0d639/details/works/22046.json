db","sourceCharacterId":"c34301"},{"segments":[{"spoiler":false,"text":"３年。会長兼学園の理事長。"},{"spoiler":false,"text":"日本に君臨する大財閥の娘で実質的にそれを動かしている。"},{"spoiler":false,"text":"完璧超人で妖艶。傍若無人で冷酷ドＳ。"},{"spoiler":false,"text":"だが華があり従うものには支配者として寛容でありカリスマ性があり恐れられつつ慕われる。"},{"spoiler":false,"text":"世界は自分を中心に回っていると思っているタイプ。"}],"source":"egs","sourceCharacterId":"6570","sourceWorkId":"22046","spoiler":false},{"segments":[{"spoiler":false,"text":"会長兼学園の理事長。 日本に君臨する大財閥の娘で、実質的にそれを動かしている。"},{"spoiler":false,"text":"完璧超人で妖艶。傍若無人で冷酷ドS。世界は自分を中心に回っていると思っている。"},{"spoiler":false,"text":"支配者として従う者には寛容で、カリスマ性があり、恐れられつつも慕われている。"}],"source":"bangumi","sourceCharacterId":"110835"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"110835","value":"3年"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d161e0182f2fe729f29eed162af3b18019df2bfa677001c93e6d8c30efe81f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3ae76a789c9c073459d0492ce40d125316d58721870405cc516ec956e2596d7d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南乃こと","creatorId":"vndb:s5763","sourcePersonId":"vndb:s5763","canonicalEntityId":"vndb:s5763","name":"南乃 こと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:173152:110835:19344:1","source":"bangumi"}]},{"characterId":"char_c34302","characterName":"櫻井 美奈穂","sourceIds":{"bangumi":[{"characterId":"110836","match":"exact-normalized-name-in-linked-work","subjectId":"173152"}],"egsCharacterIds":["6571"],"vndbCharacterId":"c34302"},"originalCharacterName":"櫻井 美奈穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"First year student."},{"spoiler":false,"text":"Sharp-minded and disciplined, a holier than thou but serious young lady who gives off an aloof and tsundere-like vibe."},{"spoiler":false,"text":"Hates crooked things and mistakes, and always tries to be fair following her strong sense of responsibility."},{"spoiler":false,"text":"She wants to study Law and be helpful to many people."}],"source":"vndb","sourceCharacterId":"c34302"},{"segments":[{"spoiler":false,"text":"１年。高飛車だが真面目な理想主義のお嬢様。"},{"spoiler":false,"text":"曲がったことや間違ったことが大嫌い。"},{"spoiler":false,"text":"孤高ツンデレぎみ。"},{"spoiler":false,"text":"いつも公正を心掛けており責任感が強い。"},{"spoiler":false,"text":"頭脳明晰でかつ規律正しく将来は法律の勉強をし多くの人々のためになる仕事がしたいという志の高さをもっている。"}],"source":"egs","sourceCharacterId":"6571","sourceWorkId":"22046","spoiler":false},{"segments":[{"spoiler":false,"text":"頭脳明晰で規律正しく、高飛車だがマジメなお嬢様。 孤高ツンデレ気味。"},{"spoiler":false,"text":"曲がったことや間違ったことが大嫌いで、いつも公正を心掛けており責任感が強い。"},{"spoiler":false,"text":"将来は法律の勉強をして、多くの人々のためになる仕事がしたいと思っている。"}],"source":"bangumi","sourceCharacterId":"110836"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"110836","value":"1年"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/066616b72978d3f658df4aa0b39201ee50036e7b7df84e180b700ec318083590.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c424cae3701fcf5eb45ce82debb79bf9c8368242ee4ba20f8fe79781e8882e3e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"八ッ橋きなこ","creatorId":"vndb:s353","sourcePersonId":"vndb:s353","canonicalEntityId":"vndb:s353","name":"八ッ橋きなこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:173152:110836:16170:1","source":"bangumi"}]},{"characterId":"char_c34303","characterName":"二条 麗","sourceIds":{"bangumi":[{"characterId":"110837","match":"exact-normalized-name-in-linked-work","subjectId":"173152"}],"egsCharacterIds":["6572"],"vndbCharac