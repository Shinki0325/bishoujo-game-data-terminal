c380267a1ce22c203ffaea2cc32d04b3d2f3d45f4e5356c3713c4d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:73742:62777:4832:1","source":"bangumi"}]},{"characterId":"char_c24368","characterName":"夜曹寺 愛","sourceIds":{"bangumi":[{"characterId":"62778","match":"exact-normalized-name-in-linked-work","subjectId":"73742"}],"egsCharacterIds":["1343"],"vndbCharacterId":"c24368"},"originalCharacterName":"夜曹寺 愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"二つの特異点を持つ人形少女"},{"spoiler":false,"text":"莢香同様、特異点を使いこなし戦いに身を置く同級生。"},{"spoiler":false,"text":"外見に反して極端に無表情で、何を考えているかわからず、クラスでも浮いているが本人は意に介して"},{"spoiler":false,"text":"いない。"},{"spoiler":false,"text":"通常一人に一つの特異点のはずが愛は二つを持つ極めて希な存在で、超回復能力で腕がもげても"},{"spoiler":false,"text":"数分で回復し、さらにその膂力で繰り出す拳はコンクリートを紙のごとく打ち破る。"},{"spoiler":false,"text":"「怖い……？　私にはわかりません――」"}],"source":"egs","sourceCharacterId":"1343","sourceWorkId":"19080","spoiler":false},{"segments":[{"spoiler":false,"text":"莢香同様、特異点を使いこなし戦いに身を置く同級生。"},{"spoiler":false,"text":"外見に反して極端に無表情で、何を考えているか分からず、クラスでも浮いているが本人は意に介していない。"},{"spoiler":false,"text":"通常一人に一つの特異点のはずが、愛は二つを持つ極めて希な存在。"},{"spoiler":false,"text":"超回復能力で腕がもげても数分で回復し、さらにその膂力で繰り出す拳はコンクリートを紙のごとく打ち破る。"},{"spoiler":false,"text":"「怖い……？　私にはわかりません――」"}],"source":"bangumi","sourceCharacterId":"62778"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d2b86c3f37af2f1c445ae1d62696b510ee014bf759be12e91972fb36b9acea7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b9ea1ad6d170b21190405b1c92e7bdb30b31ad9bb98143a9df8f57c3b1e09d8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"清水愛","creatorId":"vndb:s416","sourcePersonId":"vndb:s416","canonicalEntityId":"vndb:s416","name":"清水 愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:73742:62778:4064:1","source":"bangumi"}]},{"characterId":"char_c24369","characterName":"宮簀 早苗","sourceIds":{"bangumi":[{"characterId":"62779","match":"exact-normalized-name-in-linked-work","subjectId":"73742"}],"egsCharacterIds":["1344"],"vndbCharacterId":"c24369"},"originalCharacterName":"宮簀 早苗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"心優しき下級生スナイパー"},{"spoiler":false,"text":"莢香や愛同様、すでに戦いに出ている１つ下の下級生。"},{"spoiler":false,"text":"生まれつきの虚弱体質から、数年前までは入院生活を送っており、その際に特異点を持つことがわかる。"},{"spoiler":false,"text":"そしてその後退院し、戦いに参加するようになる。"},{"spoiler":false,"text":"その特異点は大気の変化を視覚でき、その情報を元に正確無比な狙撃をおこなう。"},{"spoiler":false,"text":"「理不尽で無差別な死…… 私は納得ができません。」"}],"source":"egs","sourceCharacterId":"1344","sourceWorkId":"19080","spoiler":false},{"segments":[{"spoiler":false,"text":"莢香や愛同様、すでに戦いに出ている一つ下の下級生。"},{"spoiler":false,"text":"生まれつきの虚弱体質から数年前までは入院生活を送っており、その際に特異点を持つことが分かる。"},{"spoiler":false,"text":"そしてその後退院し、戦いに参加するようになる。"},{"spoiler":false,"text":"その特異点は大気の変化を視覚でき、その情報を元に正確無比な狙撃を行う。"},{"spoiler":false,"text":"「理不尽で無差別な死…… 私は納得ができません」"}],"source":"bangumi","sourceCharacterId":"62779"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/1664ee42e98ccae13aa7e30d36b039168f2888fa7de55e975f31cf411ab02a9e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78fa3aaa4400e06c59175