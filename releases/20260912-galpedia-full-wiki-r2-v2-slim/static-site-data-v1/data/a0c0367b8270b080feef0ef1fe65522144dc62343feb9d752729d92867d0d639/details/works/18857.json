,"canonicalEntityId":"vndb:s636","name":"チーム・ちゃっちゃきロビン","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:98306","source":"vndb"},{"creditedName":"巫浄 スウ","creatorId":"vndb:s644","sourcePersonId":"vndb:s644","canonicalEntityId":"vndb:s644","name":"巫浄 スウ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:98307","source":"vndb"},{"creditedName":"巫浄 スウ","creatorId":"vndb:s644","sourcePersonId":"vndb:s644","canonicalEntityId":"vndb:s644","name":"巫浄 スウ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:98308","source":"vndb"},{"creditedName":"藤堂 みさき","creatorId":"vndb:s1030","sourcePersonId":"vndb:s1030","canonicalEntityId":"vndb:s1030","name":"柏木 美優","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:98311","source":"vndb"}]},"cast":[{"characterId":"char_c24948","characterName":"小日向 ゆず","sourceIds":{"bangumi":[{"characterId":"62280","match":"exact-normalized-name-in-linked-work","subjectId":"241533"}],"egsCharacterIds":["542"],"vndbCharacterId":"c24948"},"originalCharacterName":"小日向 ゆず","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美夏とは物心つく前からずっと一緒にいた仲。"},{"spoiler":false,"text":"健気で家族思いの頑張り屋さん。"},{"spoiler":false,"text":"特に多忙な両親に代わり、自分の世話をしてくれたお兄ちゃんの事が大好き。"},{"spoiler":false,"text":"主人公の手伝いを積極的にしようとするが、まだまだで危なっかしい部分が多い。"},{"spoiler":false,"text":"基本的にはしっかりものだが、子供っぽいせいか、思慮が浅く、危なっかしい行動を取るぽやっとした部分があり、いつも周囲をハラハラさせている。"},{"spoiler":false,"text":"自他共に認める運動音痴で、体を動かすことが苦手。"},{"spoiler":false,"text":"主人公に過保護に育てられたせいか、性の知識がほとんど無く、純真無垢。"},{"spoiler":false,"text":"「やったー！！　お兄ちゃんといっぱい遊べるね！」"}],"source":"egs","sourceCharacterId":"542","sourceWorkId":"18857","spoiler":false},{"segments":[{"spoiler":false,"text":"美夏とは物心付く前からずっと一緒だった仲。 健気で家族思いの頑張り屋さん。"},{"spoiler":false,"text":"特に、多忙な両親に代わり自分の世話をしてくれたお兄ちゃんのことが大好き。"},{"spoiler":false,"text":"主人公の手伝いを積極的にしようとするが、まだまだで危なっかしい部分が多い。"},{"spoiler":false,"text":"基本的にはしっかり者だが、子供っぽいせいか思慮が浅くぽやっとした部分があり、いつも周囲をハラハラさせている。"},{"spoiler":false,"text":"自他共に認める運動音痴で、身体を動かすことが苦手。"},{"spoiler":false,"text":"主人公に過保護に育てられたせいか性の知識がほとんど無く、純真無垢。"},{"spoiler":false,"text":"「やったー!!　お兄ちゃんといっぱい遊べるね！」"}],"source":"bangumi","sourceCharacterId":"62280"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/6999e91e3ffc4779bff3a7c89b49a6e73942fc6f0bd41b715304c6514c3c2e3e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/838d71e72d5851f04c5b0db3e85bcf70504f2af194d02b42443b7b0b8282d6e1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柏木美優","creatorId":"vndb:s1030","sourcePersonId":"vndb:s1030","canonicalEntityId":"vndb:s1030","name":"柏木 美優","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:241533:62280:6540:1","source":"bangumi"}]},{"characterId":"char_c24949","characterName":"坂下 美夏","sourceIds":{"bangumi":[{"characterId":"62281","match":"exact-normalized-name-in-linked-work","subjectId":"241533"}],"egsCharacterIds":["543"],"vndbCharacterId":"c24949"},"originalCharacterName":"坂下 美夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"昔は主人公の隣の家に住んでいたが、坂下一家が隣の県に引っ越してからは、主人公とはあまり会えなくなってしまい、久しぶりに再会することとなった。"},{"spoiler":false,"text":"主人公に対しては強気な態度をとり続け、わがままに振舞うお嬢様気質な性格。"},{"spoiler":false,"text":"ゆずとは逆に運動神経が良く、昔からやっていたダンス教室に、今でも通っている。"},{"spoiler":false,"text":"その為か、今でもゆずとは習い事帰りに遊ぶことが多く、ふたりは本当の姉妹のように仲が良い。"},{"spoiler":false,"text":"「違う、あっ、和兄が大騒ぎするから、"},{"spoiler":false,"text":"は、恥ずかしかっただけ……うう、放してよぉっ……」"}],"source":"egs","sourceCharacterId":"543","sourceWorkId":"18857","spoiler":false},{"segments":[{"spoiler":false,"text":"昔は主人公の隣の家に住んでいたが、隣の県に引っ越してしまい、今回久しぶりに再会することとなった。"},{"spoiler":false,"text":"主人公に対しては強気な態度をとり続け、わがままに振舞うお嬢様気質な性格。"},{"spoiler":false,"text":"ゆずとは逆に運動神経が良く、昔からやっていたダンス教室に今でも通っている。"},{"spoiler":false,"text":"そのためか、今でもゆずとは習い事帰りに遊ぶことが多く、ふたりは本当の姉妹のように仲が良い。"},{"spoiler":false,"text":"「違う、あっ、和兄が大騒ぎするから、は、恥ずかしかっただけ……」"}],"source":"bangumi","sourceCharacterId":"62281"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84e7b3e2cd36720d8e4f963aff1e965097366390dbc532bdeb6f3c3df6f8cfdf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f7c076017781ffab32ac6b926babba7288d12c93af3add999bddf82fa9e7d19.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:241533:62281:6409:1","source":"bangumi"}]},{"characterId":"char_c25890","characterName":"小日向 和己","sourceIds":{"bangumi":[{"characterId":"62282","match":"exact-normalized-name-in-linked-work","subjectId":"241533"}],"egsCharacterIds":["544"],"vndbCharacterId":"c25890"},"originalCharacterName":"小日向 和己","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"近所の大学に通う大学生。"},{"spoiler":false,"text":"明るく活発で、忙しい両親に代わり小さい頃から妹たちの世話をしている面倒見の良い性格。"},{"spoiler":false,"text":"家事もこなしていて料理が得意。 両親がいない間の食事は今でも主人公が作っている。"},{"spoiler":false,"text":"ゆずが出掛ける際にはお弁当を欠かさず作り、時には張り切り過ぎて食べ切れない量を作ってしまうことも。"},{"spoiler":false,"text":"ずっと妹たちの面倒を見ていたせいか、過剰なまでにシスコンの気があり、むしろ異性として大好き。"},{"spoiler":false,"text":"常々妹たちと親密になる、もとい恋人になれるようなエッチイベントを期待している。"},{"spoiler":false,"text":"だが、兄としての気持ちも十分に強いようで、妹たちが傍にいない間は 「事故に巻き込まれてないか？」 などといつも心配しており、やきもきしている。"},{"spoiler":false,"text":"「いかん、お兄ちゃんちょっとヘンタイっぽいかも！」"}],"source":"bangumi","sourceCharacterId":"62282"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p3340","sourceCompanyId":"egs:brand:3939","canonicalEntityId":"vndb:p3340","name":"LO-LILITH","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:18857:3939","source":"egs"},{"companyId":"vndb:p3340","sourceCompanyId":"vndb:p3340","canonicalEntityId":"vndb:p3340","name":"LO-LILITH","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:30603:v12362","source":"vndb"},{"companyId":"vndb:p3340","sourceCompanyId":"vndb:p3340","canonicalEntityId":"vndb:p3340","name":"LO-LILITH","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:30604:v12362","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
