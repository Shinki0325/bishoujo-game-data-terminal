b","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You know, in this world things called gods don't exist.\""},{"spoiler":false,"text":"A self styled \"Advisor of the Moschino Religion\". Even though he's a theologian he isn't actually a believer and he actually doesn't believe in gods at all."},{"spoiler":false,"text":"He very knowledgeable and even knows a lot about medicine, so he's also relied upon as a doctor."},{"spoiler":false,"text":"An avid reader and an eccentric who can remember everything in a book after only reading it once."}],"source":"vndb","sourceCharacterId":"c32654"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f59382267dd09b23a8ee07cfe29d528a288e07f2f0c9e9591916f1aa1eefccb9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c04401bd48588cc6486d8aab86b3f7f0869a9e771d12b7871e9947afaa33c58b.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"津田 健次郎","creatorId":"vndb:s739","sourcePersonId":"vndb:s739","canonicalEntityId":"vndb:s739","name":"津田 健次郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40603","source":"vndb"}]},{"characterId":"char_vndb_c32655","characterName":"ウンバラバッパー","sourceIds":{"vndbCharacterId":"c32655"},"originalCharacterName":"ウンバラバッパー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I am the princess' loyal servant, the spirit of the lamp~ Probably.\""},{"spoiler":false,"text":"A pseudo lifeform created by King Shazan in order to help Aspashia regain her magic. He was designed after Shazan in his youth."},{"spoiler":false,"text":"He holds the 'Genie Roulette' that allows Aspashia to gain magic, so without him she can't grant peoples wishes."},{"spoiler":false,"text":"By the way, he can actually grant 'any three wishes' with his own power but of course he wont use it for Aspashia's sake."}],"source":"vndb","sourceCharacterId":"c32655"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1744a2ddb877c683a720dbfa8efaacde48256c4b7d34b719d2d1588e4697467.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/094c18ff92cbf0e3b4a955c7bf79f5e280c7332f59068a810787d37ac67231e5.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"寺島 拓篤","creatorId":"vndb:s63","sourcePersonId":"vndb:s63","canonicalEntityId":"vndb:s63","name":"寺島 拓篤","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40599","source":"vndb"}]},{"characterId":"char_vndb_c32659","characterName":"シャザーヌ","sourceIds":{"vndbCharacterId":"c32659"},"originalCharacterName":"シャザーヌ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Don't complain, hurry up and go help humanity!\""},{"spoiler":false,"text":"King of the Majin Kingdom EVUU and Aspashia's Father."},{"spoiler":false,"text":"He tells her how to regain her lost magic then throws her out of EVUU and into the human world."}],"source":"vndb","sourceCharacterId":"c32659"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4cdd4a6b02c37bb114cab8992b5745e8c6d109c311a2e89eb372b010db7732e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e62c1186e2b0c1