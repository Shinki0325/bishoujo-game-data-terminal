48","sourcePersonId":"egs:creator:39848","canonicalEntityId":"egs:creator:39848","name":"内田浩輔","detail":"品質管理","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:275982","source":"egs"},{"creditedName":"柏木伸江","creatorId":"vndb:s42268","sourcePersonId":"egs:creator:38214","canonicalEntityId":"vndb:s42268","name":"柏木伸江","detail":"品質管理","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:275983","source":"egs"},{"creditedName":"レイ","creatorId":"vndb:s8058","sourcePersonId":"vndb:s8058","canonicalEntityId":"vndb:s8058","name":"レイ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:72344","source":"vndb"},{"creditedName":"原田 謙太","creatorId":"vndb:s43035","sourcePersonId":"vndb:s43035","canonicalEntityId":"vndb:s43035","name":"原田 謙太","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:72346","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c32640","characterName":"アスパシア","sourceIds":{"vndbCharacterId":"c32640"},"originalCharacterName":"アスパシア","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"That wish of yours, I'll grant it.\""},{"spoiler":false,"text":"The princess of the kingdom of 'gods' EVUU."},{"spoiler":false,"text":"A selfish princess who isn't ladylike or elegant at all, but that's her charm point."},{"spoiler":false,"text":"She's a super straightforward person who will honestly say anything that comes to mind with no hesitation."},{"spoiler":false,"text":"She's a god-like genie but because her mother was a human she has less magic power and uses it all up because she didn't know that she was actually only half genie."},{"spoiler":false,"text":"In order to become a true genie she is thrown down into the human world country 'Kingdom' to grant peoples wishes and gather magic power."},{"spoiler":false,"text":"Her full name is Aspashia Imfraya Pikkina Gindira Azdaramongs"}],"source":"vndb","sourceCharacterId":"c32640"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/734151db47e765945c0cca795048f9a460c0a350a79f3c725717d26d2c25180f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69ec233a986af0e42404a63be0d32967d3150ac859971d88d8e6b86cb59a030d.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c32641","characterName":"セラ","sourceIds":{"vndbCharacterId":"c32641"},"originalCharacterName":"セラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"height":{"reviewState":"source-only","source":"vndb","value":"183"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"64"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"If a cute girl is running by, is it wrong for a man to chase her?\""},{"spoiler":false,"text":"The main hero of this story."},{"spoiler":false,"text":"A good natured youth who runs a general store called \"ZACCA\" located in Kingdom Souk."},{"spoiler":false,"text":"He acts nice to everyone no matter their status, a very 'princely' character."},{"spoiler":false,"text":"But a few years back he was a rather rash kid, and he sometimes slips back into talking like a rough 'Yankee'."},{"spoiler":true,"text":"His real name is Ortana Genua Asran."}],"source":"vndb","sourceCharacterId":"c32641"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.