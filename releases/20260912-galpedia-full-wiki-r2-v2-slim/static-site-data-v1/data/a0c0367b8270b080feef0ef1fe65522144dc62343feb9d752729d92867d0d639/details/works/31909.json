nId":"vndb:vn-staff:165995","source":"vndb"}],"music":[{"creditedName":"SONO MAKERS","creatorId":"vndb:s15045","sourcePersonId":"egs:creator:33181","canonicalEntityId":"vndb:s15045","name":"SONO MAKERS","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:242216","source":"egs"},{"creditedName":"A-DASH","creatorId":"vndb:s12822","sourcePersonId":"vndb:s12822","canonicalEntityId":"vndb:s12822","name":"A-DASH","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:166002","source":"vndb"},{"creditedName":"しっぽり虎太郎","creatorId":"vndb:s23949","sourcePersonId":"vndb:s23949","canonicalEntityId":"vndb:s23949","name":"しっぽり虎太郎","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:166009","source":"vndb"},{"creditedName":"McKurokurosuke","creatorId":"vndb:s23951","sourcePersonId":"vndb:s23951","canonicalEntityId":"vndb:s23951","name":"渡邉 俊彦","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:166010","source":"vndb"}],"other":[{"creditedName":"PoisonPyte","creatorId":"vndb:s49748","sourcePersonId":"vndb:s49748","canonicalEntityId":"vndb:s49748","name":"PoisonPyte","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:165991","source":"vndb"},{"creditedName":"NotAWeeb","creatorId":"vndb:s49749","sourcePersonId":"vndb:s49749","canonicalEntityId":"vndb:s49749","name":"NotAWeeb","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:165992","source":"vndb"},{"creditedName":"MentalDown1396","creatorId":"vndb:s49750","sourcePersonId":"vndb:s49750","canonicalEntityId":"vndb:s49750","name":"MentalDown1396","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:165993","source":"vndb"},{"creditedName":"宅本 うと","creatorId":"vndb:s2450","sourcePersonId":"vndb:s2450","canonicalEntityId":"vndb:s2450","name":"宅本 うと","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:165997","source":"vndb"},{"creditedName":"永原 さくら","creatorId":"vndb:s4523","sourcePersonId":"vndb:s4523","canonicalEntityId":"vndb:s4523","name":"永原 さくら","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:165999","source":"vndb"},{"creditedName":"亜佐美 晶","creatorId":"vndb:s10983","sourcePersonId":"vndb:s10983","canonicalEntityId":"vndb:s10983","name":"亜佐美 晶","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:166001","source":"vndb"},{"creditedName":"ぴかいち","creatorId":"vndb:s14874","sourcePersonId":"vndb:s14874","canonicalEntityId":"vndb:s14874","name":"ぴかいち","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:166003","source":"vndb"},{"creditedName":"Yukacco","creatorId":"vndb:s23947","sourcePersonId":"vndb:s23947","canonicalEntityId":"vndb:s23947","name":"Yukacco","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:166007","source":"vndb"},{"creditedName":"うさぎ","creatorId":"vndb:s23948","sourcePersonId":"vndb:s23948","canonicalEntityId":"vndb:s23948","name":"うさぎ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:166008","source":"vndb"}]},"cast":[{"characterId":"char_c89916","characterName":"田寄 多乃実","sourceIds":{"bangumi":[{"characterId":"76940","match":"exact-normalized-name-in-linked-work","subjectId":"304326"}],"egsCharacterIds":["22609"],"vndbCharacterId":"c89916"},"originalCharacterName":"田寄 多乃実","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year transfer student who came to class on the same day as Kuzumi Kiyoshirou. With her bright and bubbly personality, she easily makes friends with everyone. However, she also values her personal space and cherishes her alone time. Kuzumi and Tanomi met the day before she transferred to the school, and ever since, he has been her go-to person for anything she needs."},{"spoiler":false,"text":"Though she may not excel in group settings, she finds solace in her love for exploration and adventure, often taking side trips during her free time to satisfy her insatiable curiosity."},{"spoiler":false,"text":"Going home style: Loves taking side trips."},{"spoiler":false,"text":"As the school bell rings, signalling the end of the day, Tanomi sets off on her journey home with a different route in mind. Her inquisitive nature leads her to explore the nooks and crannies of the town, taking detours and uncovering new sights and sounds. Suppose Kuzumi happens to cross her path on her way home. In that case, they'll join forces and embark on a leisurely stroll, sharing their latest discoveries and having private moments together."}],"source":"vndb","sourceCharacterId":"c89916"},{"segments":[{"spoiler":false,"text":"主人公と同じ日にクラスにやって来た転校生。２年生。"},{"spoiler":false,"text":"明るい性格で誰とでも仲良くなるが、ある程度の距離感を大事にしている。主人公とは、転校前日に出会い、なにかと頼りにしてくる。集団生活は苦手な方で、学園生活では下校が一番好きという変わった感性を持っている。好奇心が旺盛で日々寄り道を楽しんでいる。"}],"source":"egs","sourceCharacterId":"22609","sourceWorkId":"29457","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同じ日にクラスにやって来た転校生。２年生。"},{"spoiler":false,"text":"明るい性格で誰とでも仲良くなるが、ある程度の距離感を大事にしている。主人公とは、転校前日に出会い、なにかと頼りにしてくる。集団生活は苦手な方で、学園生活では下校が一番好きという変わった感性を持っている。好奇心が旺盛で日々寄り道を楽しんでいる。"}],"source":"bangumi","sourceCharacterId":"76940"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/581d681812df7b3a47fdf3bd1aa4b7f8bb919d93309c7deadbe353e683c6d0d1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a999cf332dafb6ac212a7ccbd4df4d2534a1449eeb6e7d6f95ff343610f7724d.webp","width":172,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ふじたまみ","creatorId":"vndb:s7951","sourcePersonId":"vndb:s7951","canonicalEntityId":"vndb:s7951","name":"ふじた まみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:304326:76940:23302:1","source":"bangumi"},{"creditedName":"八ッ橋 しなもん","creatorId":"vndb:s11591","sourcePersonId":"vndb:s11591","canonicalEntityId":"vndb:s11591","name":"八ッ橋しなもん(朔白)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84450","source":"vndb"}]},{"characterId":"char_c89918","characterName":"長南 陽佳","sourceIds":{"bangumi":[{"characterId":"76941","match":"exact-normalized-name-in-linked-work","subjectId":"304326"}],"egsCharacterIds":["22610"],"vndbCharacterId":"c89918"},"originalCharacterName":"長南 陽佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kuzumi Kiyoshirou's childhood friend, a second-year student."},{"spoiler":false,"text":"As the center of attention in the class, she exudes a bright and infectious energy that draws people to her. Youka mostly surrounded by her ever-expanding friend group. She is also consistently on top of the latest trends and gossips."},{"spoiler":false,"text":"Although distance has grown between Youka and Kuzumi, she still thinks of him fondly and cares for him deeply."},{"spoiler":false,"text":"Going home style: With friends!"},{"spoiler":false,"text":"Youka's idea of going home is never a solitary journey; she always has her friends by her side. Even if Kuzumi happens to be her companion, her friends will join in, and the group will inevitably turn it into a fun-filled adventure. It's rare for Youka and Kuzumi to have one-on-one time, so those moments are special!"}],"source":"vndb","sourceCharacterId":"c89918"},{"segments":[{"spoiler":false,"text":"クラスの中心グループにいる主人公の幼馴染。"},{"spoiler":false,"text":"２年生。"},{"spoiler":false,"text":"友達も多く誰とでも仲良くなれるぐらい明るい性格。常に友達の誰かしらと一緒に居て、流行りの話題に花を咲かせている。主人公とは、距離感が出来てしまっていて話す事は少ないが、なんやかんや気にかけてくれる。"}],"source":"egs","sourceCharacterId":"22610","sourceWorkId":"29457","spoiler":false},{"segments":[{"spoiler":false,"text":"クラスの中心グループにいる主人公の幼馴染。"},{"spoiler":false,"text":"２年生。"},{"spoiler":false,"text":"友達も多く誰とでも仲良くなれるぐらい明るい性格。常に友達の誰かしらと一緒に居て、流行りの話題に花を咲かせている。主人公とは、距離感が出来てしまっていて話す事は少ないが、なんやかんや気にかけてくれる。"}],"source":"bangumi","sourceCharacterId":"76941"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17d2a0df8a99a1cdaada81a3a5cf608962cb2f5dbf4c52a8d33ec26eb0724cb3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/7176507f98b363ee994c3369e77c953d7b5a547a908e57824b9c747d032299a1.webp","width":162,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤沢れい香","creatorId":"vndb:s14338","sourcePersonId":"vndb:s14338","canonicalEntityId":"vndb:s14338","name":"藤沢 れい香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:304326:76941:32998:1","source":"bangumi"}]},{"characterId":"char_c89919","characterName":"築島 つくし","sourceIds":{"bangumi":[{"characterId":"76943","match":"exact-normalized-name-in-linked-work","subjectId":"304326"}],"egsCharacterIds":["22611"],"vndbCharacterId":"c89919"},"originalCharacterName":"築島 つくし","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year student who attends the same school as Kuzumi Kiyoshirou."},{"spoiler":false,"text":"From the time she first laid eyes on Kuzumi, Tsukushi couldn't help but feel drawn to him. She constantly observes him from afar since her timidity prevents her from approaching him. Despite this, her desire to serve those she cares for runs deep. She is proactive in planning romantic outings and takes the initiative without hesitation."},{"spoiler":false,"text":"On a side note, she has a hearty appetite and is prone to impulsive buying."},{"spoiler":false,"text":"Going home style: Stalking from a distance...?"},{"spoiler":false,"text":"Although she is very interested in Kuzumi, she gets nervous and avoids him when she sees him, so it may be better to actively initiate a conversation with her. As she becomes more comfortable, she may approach Kuzumi on her own."}],"source":"vndb","sourceCharacterId":"c89919"},{"segments":[{"spoiler":false,"text":"主人公と同じ学園に通うひとつ年下の後輩。"},{"spoiler":false,"text":"１年生。"},{"spoiler":false,"text":"主人公をひとめ見て以来気になってしまい、いつも周囲を伺ってはまごまごしている。心を許した人間には尽くしたい願望が強く、デートプランなどは自分で積極的に考えてくれるタイプ。食欲は旺盛で買い食いの常習犯。"}],"source":"egs","sourceCharacterId":"22611","sourceWorkId":"29457","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同じ学園に通うひとつ年下の後輩。"},{"spoiler":false,"text":"１年生。"},{"spoiler":false,"text":"主人公をひとめ見て以来気になってしまい、いつも周囲を伺ってはまごまごしている。心を許した人間には尽くしたい願望が強く、デートプランなどは自分で積極的に考えてくれるタイプ。食欲は旺盛で買い食いの常習犯。"}],"source":"bangumi","sourceCharacterId":"76943"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6b75fe5209187121704752c106fd81fee68991b9790e876f833c1ed6d76a3dc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17555d1ea349be063be807906a2ef1f9010d631f049549a563e0ebe68a77bebf.webp","width":157,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みたかりん","creatorId":"vndb:s5060","sourcePersonId":"vndb:s5060","canonicalEntityId":"vndb:s5060","name":"みたか りん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:304326:76943:25596:1","source":"bangumi"}]},{"characterId":"char_c89920","characterName":"宇佐川 雪子","sourceIds":{"bangumi":[{"characterId":"76945","match":"exact-normalized-name-in-linked-work","subjectId":"304326"}],"egsCharacterIds":["22612"],"vndbCharacterId":"c89920"},"originalCharacterName":"宇佐川 雪子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yukiko is Kuzumi Kiyoshirou's senior in their high school and is a third-year student."},{"spoiler":false,"text":"Her playful nature often leads her to engage in light-hearted banter with the protagonist and dote on him excessively. A keen photographer, she has an affinity for capturing felines on film, leading to her frequent recruitment for the school newspaper. With a laid-back attitude towards life, she relishes in the present rather than ruminating on the past or future."},{"spoiler":false,"text":"Going home style: Group dynamic"},{"spoiler":false,"text":"As a regular member of her friends' extracurricular activities, it's not uncommon for Yukiko to return home with her companions. Although one-on-one time with the protagonist may be scarce, it is an enjoyable experience when they can create their own private world while going home together."}],"source":"vndb","sourceCharacterId":"c89920"},{"segments":[{"spoiler":false,"text":"主人公と同じ学園に通う先輩。３年生。"},{"spoiler":false,"text":"主人公を見かけるたびにちょっかいをかけてきたりとやたらと構ってくる。ネコの写真を撮る事が好きで、写真の腕を買われ地域新聞部の手伝いとしてよく駆り出されている。結構大雑把な性格をしており、あれこれ深く悩んだりせず楽しい事が好き。"}],"source":"egs","sourceCharacterId":"22612","sourceWorkId":"29457","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同じ学園に通う先輩。３年生。"},{"spoiler":false,"text":"主人公を見かけるたびにちょっかいをかけてきたりとやたらと構ってくる。ネコの写真を撮る事が好きで、写真の腕を買われ地域新聞部の手伝いとしてよく駆り出されている。結構大雑把な性格をしており、あれこれ深く悩んだりせず楽しい事が好き。"}],"source":"bangumi","sourceCharacterId":"76945"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29efb60e40deb248d2c1928472421c0ec7fb7f8188e9ab6a576a77318d6c0346.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb2710ff04a8e53ad15f6e8d30511aea325d5385bed6c9193d40d1c7dcd53192.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西連寺亜希","creatorId":"vndb:s14876","sourcePersonId":"vndb:s14876","canonicalEntityId":"vndb:s14876","name":"西連寺 亜希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:304326:76945:36177:1","source":"bangumi"}]},{"characterId":"char_c89921","characterName":"王城 茉莉愛","sourceIds":{"bangumi":[{"characterId":"76946","match":"exact-normalized-name-in-linked-work","subjectId":"304326"}],"egsCharacterIds":["22613"],"vndbCharacterId":"c89921"},"originalCharacterName":"王城 茉莉愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The young lady who attends a prestigious missionary school in the neighborhood as a second-year student."},{"spoiler":false,"text":"Maria's radiant and cheerful personality is contagious, and she has a smile that can charm anyone. Despite her school being off-limits to boys, her presence is well-known throughout the town. Her strong sense of service is evident in her regular participation in fundraising activities at the train station. She has yet to experience romance, but if she were to fall in love, it would be with full-hearted commitment."},{"spoiler":false,"text":"Going home style: Fate in the making?"},{"spoiler":false,"text":"Though chance encounters with Maria, a student from another school, are rare, they both reside in the same town, and thus, the opportunity to cross paths is always present. The more they encounter each other, the more it seems that fate is at play. Who knows, maybe Maria will be waiting for Kuzumi Kiyoshirou at the school gates, ready to make a romantic gesture."}],"source":"vndb","sourceCharacterId":"c89921"},{"segments":[{"spoiler":false,"text":"近隣にあるミッション系スクールに通うお嬢様。２年生。"},{"spoiler":false,"text":"いつも朗らかで明るい性格で、笑みに癒される人が多数おり、男子禁制の学園に通っていながらもその存在は学外にまで知られる存在。奉仕精神にも長けていて、駅前で募金活動をする姿を見かける事もしばしばある。恋愛経験はなく、惚れたら一直線に接してくれるかも…"}],"source":"egs","sourceCharacterId":"22613","sourceWorkId":"29457","spoiler":false},{"segments":[{"spoiler":false,"text":"近隣にあるミッション系スクールに通うお嬢様。２年生。"},{"spoiler":false,"text":"いつも朗らかで明るい性格で、笑みに癒される人が多数おり、男子禁制の学園に通っていながらもその存在は学外にまで知られる存在。奉仕精神にも長けていて、駅前で募金活動をする姿を見かける事もしばしばある。恋愛経験はなく、惚れたら一直線に接してくれるかも…"}],"source":"bangumi","sourceCharacterId":"76946"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb71d92f710d227786d11f36c5b3435cc3ff2a1558dc1d72751670ffc21cf31a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc30542a5b044d3adcc79ad3301b80443674bd4d9f3c6f4c516a522a476edfb0.webp","width":157,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柚原みう","creatorId":"vndb:s977","sourcePersonId":"vndb:s977","canonicalEntityId":"vndb:s977","name":"柚原 みう","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:304326:76946:15162:1","source":"bangumi"}]},{"characterId":"char_vndb_c112065","characterName":"王城 清麿","sourceIds":{"vndbCharacterId":"c112065"},"originalCharacterName":"王城 清麿","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler