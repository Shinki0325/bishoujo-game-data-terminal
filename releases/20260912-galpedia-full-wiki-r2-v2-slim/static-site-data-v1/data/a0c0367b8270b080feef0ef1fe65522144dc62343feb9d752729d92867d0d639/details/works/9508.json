},{"spoiler":false,"text":"主人公が義父母の元へ来た時から、色々と面倒を見てくれていた。"},{"spoiler":false,"text":"絵の才能があったが、とある理由で今は描いていない様子。"},{"spoiler":false,"text":"「そういえば、背が伸びたね」"}],"source":"egs","sourceCharacterId":"19841","sourceWorkId":"9508","spoiler":false},{"segments":[{"spoiler":false,"text":"私立花泉学园 6年生。"},{"spoiler":false,"text":"才色兼备、做事严谨的上级生。"},{"spoiler":false,"text":"由祐真从义父母家来到学校时开始就一直照顾着他的御姐。"},{"spoiler":false,"text":"尽管家里离学园很近，却仍然坚持从宿舍上学。"},{"spoiler":false,"text":"小时候发挥出绘画的才能，被别人当作神童，只是自从2年级时画了祐真以后，就没有再画过画了……"}],"source":"bangumi","sourceCharacterId":"10908"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"19841","sourceWorkId":"9508","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"19841","sourceWorkId":"9508","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"19841","sourceWorkId":"9508","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"19841","sourceWorkId":"9508","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a860c9cfdb8142743ef8d2f17a26ba7ec299d9b45db15e4088c9939a99e8ad46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/895c3552d107376a5f07254c87e3ec18e7e30e54e68eb924f249b42092d23175.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7399:10908:5890:1","source":"bangumi"}]},{"characterId":"char_c18855","characterName":"シロツメ","sourceIds":{"bangumi":[{"characterId":"14169","match":"exact-n