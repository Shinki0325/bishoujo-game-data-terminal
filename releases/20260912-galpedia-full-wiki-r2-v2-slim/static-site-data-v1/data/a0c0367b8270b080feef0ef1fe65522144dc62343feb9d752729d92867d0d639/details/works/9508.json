","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"転校早々、イメージがぴったりという理由で、劇のヒロインに抜擢された少女。"},{"spoiler":false,"text":"他人に関心を持たず、一人でいることが多かったが、劇の練習などで、次第に心を開いていき……。"},{"spoiler":false,"text":"エアクッション（気泡シート）をプチプチ潰すのが趣味。"},{"spoiler":false,"text":"「ぷちぷちも楽しいけど……みんなと一緒のほうがいい。」"}],"source":"egs","sourceCharacterId":"19839","sourceWorkId":"9508","spoiler":false},{"segments":[{"spoiler":false,"text":"学園に転入してきたばかりの後輩の女の子。イメージがピッタリという理由で、寮生で公演する劇の主役に突然抜擢される。人付き合いが苦手で、気泡シートをつぶすのが楽しいと言う。彼女も祐真と同じく両親を失い、施設で育ち、学園の寮に入ってきた。祐真と同じロケットを持っており、開けてしまうと込めた願いが叶わなくなる、という独特の認識も共通している。"}],"source":"bangumi","sourceCharacterId":"14166"}],"profileFacts":[{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"19839","sourceWorkId":"9508","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"19839","sourceWorkId":"9508","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"19839","sourceWorkId":"9508","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"19839","sourceWorkId":"9508","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b78989f28e2f8522041f0f9689a0fe9307484d602deef46f30235f23a958256.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b9a11