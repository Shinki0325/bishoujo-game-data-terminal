tyId":"vndb:s7544","name":"志水 はつみ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:154135","source":"vndb"},{"creditedName":"はねこと","creatorId":"vndb:s15065","sourcePersonId":"vndb:s15065","canonicalEntityId":"vndb:s15065","name":"はねこと","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:154136","source":"vndb"},{"creditedName":"tatsumi","creatorId":"vndb:s16880","sourcePersonId":"vndb:s16880","canonicalEntityId":"vndb:s16880","name":"tatsumi","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:154138","source":"vndb"},{"creditedName":"koro","creatorId":"vndb:s17310","sourcePersonId":"vndb:s17310","canonicalEntityId":"vndb:s17310","name":"koro","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:154139","source":"vndb"},{"creditedName":"koro","creatorId":"vndb:s17310","sourcePersonId":"vndb:s17310","canonicalEntityId":"vndb:s17310","name":"koro","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:154140","source":"vndb"},{"creditedName":"土場 二郎","creatorId":"vndb:s36307","sourcePersonId":"vndb:s36307","canonicalEntityId":"vndb:s36307","name":"土場 二郎","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:154144","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c78356","characterName":"九段 朔夜","sourceIds":{"vndbCharacterId":"c78356"},"originalCharacterName":"九段 朔夜","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"824"},"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student of Physical Education at Kudan Women's Academy."},{"spoiler":false,"text":"Sakuya is a scholarship student and star of the kendo club. Add to that stunning looks and a charming disposition, and you have yourself the most popular girl in school. She's bold and decisive, with a rigid moral compass that demands accountability, regardless of status. These personality traits can lead to her being seen as a fearsome figure, but she's actually a very kind and caring person."},{"spoiler":false,"text":"Sakuya has been best friends with Karen Azuma since elementary school, where they were on the baseball team together before she turned to kendo and Karen to softball."},{"spoiler":false,"text":"Her two older sisters got her into nerdy interests such as manga, retro gaming, and niche novels. Her unruly hair stresses her out something awful."},{"spoiler":false,"text":"\"Might be nice to have a destiny I chose for myself.\""},{"spoiler":false,"text":"From SukeraSparo"}],"source":"vndb","sourceCharacterId":"c78356"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78662fd6f62dd745059f59cf9dbdd2f0fc9f09a66dcf30b944befa77be294714.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d2dff87417cb16216d64b81749f221125cd5536adf201ef02ff0e893c13232c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"福原 綾香","creatorId":"vndb:s6836","sourcePersonId":"vndb:s6836","canonicalEntityId":"vndb:s6836","name":"野波ひなき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:79961","source":"vndb"}]},{"characterId":"char_vndb_c78357","characterName":"志摩 塔子","sourceIds":{"vndbCharacterId":"c78357"},"originalCharacterName":"志摩 塔子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1117"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"source-only","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A culinary arts teacher living in Kudan."},{"spoiler":false,"text":"Descendant of a wealthy family that earned its fortune in forestry and shipbuilding, Touko runs a culinary school out of a fancy building near the station. She's sweet and gentle, but also sharp as a tack and quick to follow a line of thinking to its logical conclusion. However, her proclivity for caution leads to indecisiveness, and she tends to keep her calculated judgments to herself. She admires Sakuya's ability to make quick decisions and take instant action, and the two become friends."},{"spoiler":false,"text":"Although she hasn't been acquainted with her personal assistant, Sawako Iwai, for too long, she hopes they can become friends one day, too."},{"spoiler":false,"text":"\"These eggs with the golden yolks are just perfect for carbonara. They'll give your sauce some real depth.\""},{"spoiler":false,"text":"From SukeraSparo"}],"source":"vndb","sourceCharacterId":"c78357"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa37d4f8998b3391b2f7bf0380a38ff5c646b2458771673be0d677b3c45311a9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/621872e2c8602e5c4a336e76b414de6f72cdb87e29e375643bacd825b4bd26d1.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石見 舞菜香","creatorId":"vndb:s17263","sourcePersonId":"vndb:s17263","canonicalEntityId":"vndb:s17263","name":"石見 舞菜香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:79963","source":"vndb"}]},{"characterId":"char_vndb_c78358","characterName":"春夏冬 小兎","sourceIds":{"vndbCharacterId":"c78358"},"originalCharacterName":"春夏冬 小兎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1201"},"bust":{"reviewState":"source-only","source":"vndb","value":"75"},"height":{"reviewState":"source-only","source":"vndb","value":"144"},"hip":{"reviewState":"source-only","source":"vndb","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year General Studies student at Kudan Women's Academy."},{"spoiler":false,"text":"Going by her fashionable style, you wouldn't expect her to be into ghosts and urban legends, but Koto is a huge occult nerd and president of the Academy's Occult Studies Club. She actively investigates those mysteries that spark her interest and publishes the results in a magazine that combines objective analysis with personal opinion. She strives to maintain the reputation of the organization; contrary to her looks, she's actually the serious, intellectual type. She knows how to act with propriety, but once you really get to know her she'll drop the polite act and speak casually."},{"spoiler":false,"text":"She knew of Sakuya already—who at the academy doesn't—but since they belong to different departments she never expected their paths to cross. However, after Sakuya rescues her from a certain incident, they become friends."},{"spoiler":false,"text":"Her hobbies are watching horror movies and drawing. She also likes to make her own accessories."},{"spoiler":false,"text":"\"Please, take a seat on the sofa. Can I get you a drink? We have tea and coffee.\""},{"spoiler":false,"text":"From SukeraSparo"}],"source":"vndb","sourceCharacterId":"c78358"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f042336081dee3878c0862cda041e06acdee247de9f65956ec9cb0daf20dd430.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc491c7409e504ee212861991d1364b1a41c557fad5629b3cc1b3a6fec1a51ee.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長縄 まりあ","creatorId":"vndb:s2653","sourcePersonId":"vndb:s2653","canonicalEntityId":"vndb:s2653","name":"長縄 まりあ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:79960","source":"vndb"}]},{"characterId":"char_vndb_c78359","characterName":"吾妻 佳恋","sourceIds":{"vndbCharacterId":"c78359"},"originalCharacterName":"吾妻 佳恋","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"910"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"hip":{"reviewState":"source-only","source":"vndb","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year Physical Education student at Kudan Women's Academy."},{"spoiler":false,"text":"Karen is on the softball team and attends the Academy on a scholarship program. While this covers her tuition and confers various other benefits, it's all dependent on her results."},{"spoiler":false,"text":"Lively and boyishly good-looking, she doesn't speak as roughly as Sakuya, but her general personality is more masculine. She has two younger brothers who are also into sports, which further encourages her not to worry too much about maintaining a ladylike manner or appearance."},{"spoiler":false,"text":"Still, she can turn on the charm when she has to. Her hobbies include dining out at her favorite curry places and being a know-it-all when it comes to movies and video games."},{"spoiler":false,"text":"\"So, what, you're trying to scare me? You do know my favorite movie genre is horror, right?\""},{"spoiler":false,"text":"From SukeraSparo"}],"source":"vndb","sourceCharacterId":"c78359"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a99ae67a2a345d9e704b7f1266ae89f848f5aacaf706c3fdbdcdd78662f5e44.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2dff913e6d806e895d4b661ca5279ac09175ead0fb3037a87abd124b74b4b1ac.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡本 理絵","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:79959","source":"vndb"}]},{"characterId":"char_vndb_c78360","characterName":"岩井 紗和子","sourceIds":{"vndbCharacterId":"c78360"},"originalCharacterName":"岩井 紗和子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"24"},"birthday":{"reviewState":"source-only","source":"vndb","value":"121"},"bust":{"reviewState":"source-only","source":"vndb","value":"81"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An assistant in the employ of the Shima family, Sawako is currently assigned as Touko's PA and takes care of everything from her secretarial work to managing the family home. She's always cool, calm, and collected."},{"spoiler":false,"text":"A woman of few words, she says only what's necessary and tends to keep her expression neutral; while she of course has emotions, they can be hard for other people to figure out."},{"spoiler":false,"text":"She previously served the Shima family matriarch, Touko's grandmother, but has now been asked to take care of Touko."},{"spoiler":false,"text":"Because of how well the family treats her, she is far more dedicated to Touko than she would be any other employer."},{"spoiler":false,"text":"Her hobbies are classical music and obtaining professional qualifications. During her free time, she's usually studying for various exams."},{"spoiler":false,"text":"\"I am in the employ of the Shima family and have been instructed to take care of the young lady.\""},{"spoiler":false,"text":"From SukeraSparo"},{"spoiler":true,"text":"Her real name is Yamagishi Niina (山岸 新名)."}],"source":"vndb","sourceCharacterId":"c78360"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42a5c2937336515550bfe0d6072e9c7edd201ace6ff5663c2c48efa4e5a4fc73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67360ae9abf3e59104d3e31d6ff8ec952bb1905afb7df9a962a042337803f2e3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森 なな子","creatorId":"vndb: