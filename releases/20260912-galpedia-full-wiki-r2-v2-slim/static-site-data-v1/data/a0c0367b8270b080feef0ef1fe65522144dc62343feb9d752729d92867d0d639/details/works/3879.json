{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"3879","model":{"presentationWorkId":"vndb:v1105","staff":{"artwork":[{"creditedName":"緋色雪","creatorId":"vndb:s2805","sourcePersonId":"egs:creator:1860","canonicalEntityId":"vndb:s2805","name":"緋色雪","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5525","source":"egs"}],"scenario":[{"creditedName":"天哀","creatorId":"vndb:s2809","sourcePersonId":"egs:creator:374","canonicalEntityId":"vndb:s2809","name":"天哀","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5838","source":"egs"},{"creditedName":"月☆姫","creatorId":"vndb:s2816","sourcePersonId":"egs:creator:1861","canonicalEntityId":"vndb:s2816","name":"月☆姫","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5839","source":"egs"}],"music":[{"creditedName":"菊池ただし","creatorId":"egs:creator:4510","sourcePersonId":"egs:creator:4510","canonicalEntityId":"egs:creator:4510","name":"菊池ただし","roleCode":"music","roleLabel":"作品音乐","identityStatus":"no-alias-hit","relationId":"egs:work-creator:16328","source":"egs"},{"creditedName":"SENTIVE","creatorId":"vndb:s1051","sourcePersonId":"vndb:s1051","canonicalEntityId":"vndb:s1051","name":"SENTIVE","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:20030","source":"vndb"}],"other":[{"creditedName":"あらまり","creatorId":"vndb:s8930","sourcePersonId":"vndb:s8930","canonicalEntityId":"vndb:s8930","name":"あらまり","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:20034","source":"vndb"}]},"cast":[{"characterId":"char_c24818","characterName":"七島 末利","sourceIds":{"bangumi":[{"characterId":"96031","match":"exact-normalized-name-in-linked-work","subjectId":"269978"},{"characterId":"96031","match":"exact-normalized-name-in-linked-work","subjectId":"269995"}],"egsCharacterIds":["17784"],"vndbCharacterId":"c24818"},"originalCharacterName":"七島 末利","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"７４"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"７６"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５８"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水着：旧タイプスクール水着"},{"spoiler":false,"text":"汐里と並ぶ水泳部のエース候補の1人。"},{"spoiler":false,"text":"普段は物静かでおとなしい性格だが、思ったことを頑固に貫く、芯の強さを持っている。"},{"spoiler":false,"text":"義兄に恋愛感情を抱いており、その大好きな義兄のことが絡むと、とたんに感情の起伏が激しくなり、大胆な行動を起こすこともしばしば。"},{"spoiler":false,"text":"キャプテンの汐里を密かにライバルとして意識しているが、同時に苦手にも思っているようだ。"}],"source":"egs","sourceCharacterId":"17784","sourceWorkId":"11108","spoiler":false},{"segments":[{"spoiler":false,"text":"今回の合宿参加メンバーの１人で、汐里と並んで水泳部のエース候補の１人。 大人しめの性格の中に、自分の想いを強固に貫く芯の強さを持っている。また汐里とは対照的に常に前向きで、試合に負けた時も落ち込む事無く明日への糧に出来る精神の持ち主でもある。 ちなみに義理の兄に対して恋愛感情を抱いており、合宿中も大好きな兄の声が聞きたい為に、持ち込み禁止なのを承知で携帯電話を使い、頻繁に連絡を取っている。 末利にとってこの兄は無くてはならない存在で、彼の事が絡むと感情を激しく起伏させて大胆な行動に出ることもある。"},{"spoiler":false,"text":"また同部屋の美乃とは水泳部に入部以来の親友で、気軽に相談事が出来る間柄。今回の合宿では彼女のお目付役を自認し、手綱取りと称してはいるが、実際には美乃をオモチャにしている傾向がある。 キャプテンの汐里に対して密かにライバル意識を持っているものの、同時に彼女からは一方的に敵対視されている為に苦手意識も同様に抱えている。"}],"source":"bangumi","sourceCharacterId":"96031"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6bd0b21f28eb81fd70468933669222f8ffc5a31424f2dacbddd25b690417b2e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2b690c60e187b0dde9cfa39e656d540f8799eb4bb1d6eab03def255c535bbb0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩居由希子","creatorId":"vndb:s1160","sourcePersonId":"vndb:s1160","canonicalEntityId":"vndb:s1160","name":"岩居 由希子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269978:96031:4163:1","source":"bangumi"},{"creditedName":"藍川千尋","creatorId":"vndb:s2825","sourcePersonId":"vndb:s2825","canonicalEntityId":"vndb:s2825","name":"藍川 千尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269995:96031:18192:1","source":"bangumi"}]},{"characterId":"char_c24819","characterName":"瀬名 汐里","sourceIds":{"bangumi":[{"characterId":"96033","match":"exact-normalized-name-in-linked-work","subjectId":"269978"},{"characterId":"96033","match":"exact-normalized-name-in-linked-work","subjectId":"269995"}],"egsCharacterIds":["17785"],"vndbCharacterId":"c24819"},"originalCharacterName":"瀬名 汐里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"７４"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"７６"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５７"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水着：旧タイプスクール水着"},{"spoiler":false,"text":"聖華学園水泳部の暫定キャプテンで、孤高の天才スイマー。"},{"spoiler":false,"text":"天才肌で完ぺき主義な性格に加えて、他人との関わりあうことを嫌っていることから、近寄りがたい雰囲気を醸し出している。"},{"spoiler":false,"text":"水泳部の顧問・渚は幼馴染で、小さい頃から憧れの存在だった。"},{"spoiler":false,"text":"渚が現役を引退し、結婚することを知ったことから、目標を失ってしまい、また渚への禁断の想いを断ち切れず、二重の悩みを抱えることになってしまった。"}],"source":"egs","sourceCharacterId":"17785","sourceWorkId":"11108","spoiler":false},{"segments":[{"spoiler":false,"text":"学園水泳部の暫定キャプテンで、一途に水泳に打ち込む孤高のスイマー。 水泳に関しては完璧主義の厳格な性格に加えて、他人と話すのが苦手で必要以上に他人と関わる事を嫌う為、周囲には近寄りがたい雰囲気を与えている。 有名な水泳選手だった両親や、天才少女と噂する周囲の期待から、いつしか水泳でしか自分を表現できないと思い込む様になり、また渚と出逢ってからは大好きな彼女との約束を守るという理由も加わって一心不乱に水泳に励んでいたが、最近はその想い人だった渚の婚約を告げられて自分の信念が崩れ始めてしまっている。"},{"spoiler":false,"text":"そんな中、渚が仕組んだ合宿中の部内王座決定戦の初戦で、今まで一度も負けた事が無かった末利に敗北してしまった事がきっかけで思い悩ませられる事になる。 更に、一度は諦めようとしたはずの渚への想いも振り切ることが出来ず、無意識のうちに渚の姿を探したり、渚を見つめてしまったりする事もしばしばと二重の悩みを抱える事になってしまう。 ちなみに自分とは対照的な性格や考えを持つ末利の事が気に食わず、最初はあからさまな敵対心を見せる。"}],"source":"bangumi","sourceCharacterId":"96033"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a4872c074805f9b6d1f7c7e1d0f34a0d89b6f57fd0282870a51de2e9f9b6746.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26247a2f50bc0fea371e38e39dd5d095db78f99c01eb93bbc074ca312231ddb5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269978:96033:5906:1","source":"bangumi"},{"creditedName":"鈴木 みやび","creatorId":"vndb:s2826","sourcePersonId":"vndb:s2826","canonicalEntityId":"vndb:s2826","name":"鈴木 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10014","source":"vndb"}]},{"characterId":"char_c24820","characterName":"神海 美乃","sourceIds":{"bangumi":[{"characterId":"96032","match":"exact-normalized-name-in-linked-work","subjectId":"269978"},{"characterId":"96032","match":"exact-normalized-name-in-linked-work","subjectId":"269995"}],"egsCharacterIds":["17786"],"vndbCharacterId":"c24820"},"originalCharacterName":"神海 美乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"７２"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"151"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"７４"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５６"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水着：旧タイプスクール水着"},{"spoiler":false,"text":"今回の合宿メンバーに選ばれた一人。末利の親友。"},{"spoiler":false,"text":"天真爛漫で明るく無邪気だが、非常に落ち着きがなく、騒がしい。"},{"spoiler":false,"text":"「誰とでも仲良くなれる」という信念を持つ、他人を拒絶している汐里にも、猛然とアタックするが玉砕している。"},{"spoiler":false,"text":"ペタンコの胸にコンプレックスを抱いており、いつかは胸の大きなレディになることを夢見て、日々、無駄な努力を続けているようだ。"}],"source":"egs","sourceCharacterId":"17786","sourceWorkId":"11108","spoiler":false},{"segments":[{"spoiler":false,"text":"今回の合宿メンバーに選ばれた１人で、末利とは入部以来の親友。 無邪気で明るく、親友の末利が落ち込んだら自分も一緒に落ち込んでしまうという友達想いの性格ながら、落ち着きというものが全くないのが欠点である。 今回の合宿中も施設内を自慢のツインテールを翻して走り回っては自爆する姿が日常茶飯事になっており、「元気がいいのはいいんだけど…」と渚の頭痛の種になっている。 また、自分の体型へのコンプレックスから深波の様な大人の女性に憧れており、「この合宿中にあたしは先輩にも負けない胸ぼーん、お尻きゅーんのナイスバディになってやる！」などと宣い、一体何の為に合宿に参加しているのか分かっているのだろうか…？と周囲を呆れさせている。"},{"spoiler":false,"text":"それでも意外なまでに研究熱心な上に努力家で、人が見ていない所で努力をしようとするものの、その方法そのものが根本的に間違っている事が多く、無駄に終わることが殆どである。 そんな彼女の信条は「人類皆兄弟」で、誰でもいつかは必ずうち解けられるはずという信念を胸に、他人を拒絶した態度を見せる汐里の心を開かせようと彼女に近付き、アタックしては返り討ちに遭っている。 ともかく、何かと意気込んでは空振りばかりの美乃なのだが、本人は常に真剣そのものなのが周囲の憐憫(れんびん)と笑いを誘っている。"}],"source":"bangumi","sourceCharacterId":"96032"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/bec36cc43386b9ed09c31acb3af79f62a4f2aa12a38ebf0fa74da23a5ba664c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/5481feac630553abbaf95f4df35b2d39cf67bb543fd28ad2df31579560a3e9a1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269978:96032:4490:1","source":"bangumi"},{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269995:96032:4810:1","source":"bangumi"}]},{"characterId":"char_c24821","characterName":"春日 渚","sourceIds":{"bangumi":[{"characterId":"96034","match":"exact-normalized-name-in-linked-work","subjectId":"269978"},{"characterId":"96034","match":"exact-normalized-name-in-linked-work","subjectId":"269995"}],"egsCharacterIds":["17787"],"vndbCharacterId":"c24821"},"originalCharacterName":"春日 渚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"７６"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"７８"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５８"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水着：競泳水着"},{"spoiler":false,"text":"聖華学園に赴任してきた体育教師で、水泳部の顧問も務めている。"},{"spoiler":false,"text":"かつては日本水泳界を背負って立つ逸材と呼ばれているが、練習中の事故が原因で日本代表を落選、そのまま選手を引退してしまった。その後、教師として、コーチとして再出発したものの、選手としての未練が燻っているようだ。"},{"spoiler":false,"text":"汐里は年下の幼馴染で、非常に仲良かったが、教師と教え子の立場になってからは、何処かギクシャクした関係になってしまっている。"},{"spoiler":false,"text":"結婚を間近に控えながら、実は誰にも云えない悩みからマリッジブルー気味。"}],"source":"egs","sourceCharacterId":"17787","sourceWorkId":"11108","spoiler":false},{"segments":[{"spoiler":false,"text":"今期から赴任してきた新任の体育教師で、水泳部の顧問を務めている。 かつて学生時代は水泳界でのホープと呼ばれていたが、練習中の事故で腰を痛めてしまった事が原因で代表候補から外れてしまう過去を持つ。 その後は選手としての道を諦め、コーチとして育成への道を歩み始めるが、現役選手への執着も何処かで捨てきれないまま現在に至っている。その現役復帰への強い希望を人前で出すことはないが、訓練は今でも人知れず続けており、合宿中も夜間に１人練習している。"},{"spoiler":false,"text":"また同時に、いつまでも引きずり続けている現役への執着を断つ為に汐里へ自分の夢を託そうとしているが、汐里から「私は先生の人形じゃない！」と反発された事で強い罪悪感を覚える様になる。 婚約者との結婚を間近に控えているのだが、同時に結婚という幸せの代償に失ってしまう物への葛藤や不安感が原因で密かにマリッジ・ブルーを感じている。結婚をきっかけに新しい人生を踏みだそうとしているのだが、同時に自由に生きている陸を羨ましく思う事もある。 ちなみにお淑やかなお嬢様の雰囲気を見せる風貌だが、実際は体育会系らしく結構大雑把で豪快。"}],"source":"bangumi","sourceCharacterId":"96034"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b95f95203fdd76ea20b4d5c15ae90433aa810ed6b8a4d9a35ff25693164b4e0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a14e616985202c8a1d6072da055053de791a4d4555573635f167d90bd6495ebf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269978:96034:5890:1","source":"bangumi"},{"creditedName":"関口 なつみ","creatorId":"vndb:s2824","sourcePersonId":"vndb:s2824","canonicalEntityId":"vndb:s2824","name":"関口 なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10011","source":"vndb"}]},{"characterId":"char_c24823","characterName":"磯崎 真結美","sourceIds":{"bangumi":[{"characterId":"96029","match":"exact-normalized-name-in-linked-work","subjectId":"269978"}],"egsCharacterIds":["17783"],"vndbCharacterId":"c24823"},"originalCharacterName":"磯崎 真結美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"６７"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"147"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"５８"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５４"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水着：新タイプスクール水着"},{"spoiler":false,"text":"末利たちの後輩で、今回の合宿メンバーの中で最年少。"},{"spoiler":false,"text":"まだまだ幼く、自分のことを「まゆたん」と呼んでいるロリッ娘。"},{"spoiler":false,"text":"小さく可愛らしい容姿と性格から、水泳部内ではマスコット的な存在。"},{"spoiler":false,"text":"特に美乃のお気に入りにされ、師弟コンビを組まされているが、実は理想のお姉さま像は深波らしく、憧れの感情を抱いている。"},{"spoiler":false,"text":"情報通を自称する彼女は、ラップトップPCを使って昼夜問わず、怪しい情報を集めているらしい。"}],"source":"egs","sourceCharacterId":"17783","sourceWorkId":"11108","spoiler":false},{"segments":[{"spoiler":false,"text":"今回の合宿参加メンバーとしては最年少で、末利達の後輩にあたる。美乃よりも更に小柄で、愛くるしい表情と言動で同性にもウケが良く、水泳部内ではマスコット的な存在になっている。特に美乃から気に入られており、真結美に自分の事を「お姉さま」と呼ばせて師弟コンビを自称している。ただし、真結美の方はと言えば美乃を師匠よりも遊び友達として見ている部分が強く、実際の真結美の「憧れのお姉さま」は深波だったりするのだが、それは美乃の前で決して口にする事はない。"},{"spoiler":false,"text":"そんな訳で、今回の合宿で深波と同部屋になった事を喜んでおり、美乃に内緒で深波にアプローチしていく事に。また事情通を自称するゴシップ好きで、美乃達に今回の合宿にもノートＰＣを持ち込んで夜な夜なネットサーフィンを楽しんでいるが、最近その事がきっかけである秘密の趣味を持つ様になったらしい。"}],"source":"bangumi","sourceCharacterId":"96029"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23f885bc493d78cfdf11ec901159a41320c5d1d2a8ef29c2d859c3a23e727454.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84b1559cda6e0ea922790bb2475a835192fa987b80a78cde5230082779ca3fb8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤村歩","creatorId":"vndb:s1703","sourcePersonId":"vndb:s1703","canonicalEntityId":"vndb:s1703","name":"藤村 歩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269978:96029:4783:1","source":"bangumi"}]},{"characterId":"char_c24825","characterName":"鷹谷 深波","sourceIds":{"bangumi":[{"characterId":"96030","match":"exact-normalized-name-in-linked-work","subjectId":"269978"}],"egsCharacterIds":["17782"],"vndbCharacterId":"c24825"},"originalCharacterName":"鷹谷 深波","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"８８"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"８６"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５９"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水着：旧タイプスクール水着（サイドライン付き）"},{"spoiler":false,"text":"先代水泳部キャプテンで、末利たちの先輩。"},{"spoiler":false,"text":"関西出身のコテコテの関西人。性格は温厚で優しく、後輩から慕われる姉御肌の女の子。"},{"spoiler":false,"text":"物静かな雰囲気とは裏腹にノリもよく、ハリセンによるツッコミには定評がある。"},{"spoiler":false,"text":"水泳の実力は高いが、生まれつき病気がちで身体が弱く、なかなかチャンスに恵まれない。"}],"source":"egs","sourceCharacterId":"17782","sourceWorkId":"11108","spoiler":false},{"segments":[{"spoiler":false,"text":"先代水泳部キャプテンで、末利達の先輩。元々は昨年の合宿メンバーに入っていたのだが、合宿間近になって病気で入院する事になってしまい、そのまま昨年起きた惨劇を何も聞かされる事無く今年参加する事になった。その実力は渚や汐里を始め水泳部全員が認める能力を秘めているものの、生まれつき病気がちで身体が弱く、その所為で大会の出場機会に恵まれない事で公式な実績が殆ど残っていない。その事に深波本人は至って謙虚な態度を見せているが、内心では次の大会が自分にとってラストチャンスになる為に、今回の合宿に賭ける熱意は誰よりも高い。"},{"spoiler":false,"text":"その為、健康面でのハンデを背負いながらも、それを決して他人に見せる事無く独りハードなトレーニングを自分に課して奮闘している。 性格は至って温厚で、誰に対しても優しく接している為に同級生、下級生を問わず慕われており、また料理が得意という家庭的な面が更に彼女の人気を高めている要因になっている。 ちなみに関西出身で、一人称を「うち」と呼んで関西弁で話してくる。また物静かな雰囲気とは裏腹にノリも良く、ハリセンを使ったツッコミを見せる事もある。"}],"source":"bangumi","sourceCharacterId":"96030"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f8b949cae0ea4004a57cc9202d2d012aad18fb88b0ebbfec459aee06a0f5039.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da01f24a235d3bd612fd3484fa1c97dc43e0ae1b2a8b8f514dfd7bfc60e88a54.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"早瀬 碧","creatorId":"vndb:s2978","sourcePersonId":"vndb:s2978","canonicalEntityId":"vndb:s2978","name":"早瀬 碧","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10015",