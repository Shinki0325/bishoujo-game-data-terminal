iewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The girl next door (23 years old) who has loved the main character as if he were her little brother. She is serious and kind, and the protagonist has always admired her."},{"spoiler":false,"text":"After graduating from college, she marries the protagonist's father and becomes his stepmother. However, their relationship is the same as before, and they treat each other like a sister and brother."},{"spoiler":false,"text":"She is a little careless, so when she runs into him in the hallway wearing a negligee, she gets a thrill. He doesn't seem to mind it too much, but it seems to make the protagonist a bit uneasy."},{"spoiler":false,"text":"From archived official site"}],"source":"vndb","sourceCharacterId":"c54006"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e0b0544e017c74e8a9e2af66dfc36c0931c63ab7da1dc429b92d6f4dc9708d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a89806e767032b54b0a917c7ffc5b577ee000f2ea19dc7b63cc7069a8eebcac.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"御苑生 メイ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55104","source":"vndb"}]},{"characterId":"char_vndb_c54007","characterName":"日向 サキ","sourceIds":{"vndbCharacterId":"c54007"},"originalCharacterName":"日向 サキ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"19"},"bust":{"reviewState":"source-only","source":"vndb","value":"96"},"height":{"reviewState":"source-only","source":"vndb","value":"161"},"hip":{"reviewState"