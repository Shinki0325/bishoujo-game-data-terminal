{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"13706","model":{"presentationWorkId":"vndb:v11758","staff":{"artwork":[{"creditedName":"にぃと","creatorId":"vndb:s9454","sourcePersonId":"egs:creator:24731","canonicalEntityId":"vndb:s9454","name":"にぃと","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:155572","source":"egs"}],"scenario":[{"creditedName":"まもも","creatorId":"vndb:s2415","sourcePersonId":"egs:creator:18068","canonicalEntityId":"vndb:s2415","name":"まもも","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:155571","source":"egs"},{"creditedName":"にぃと","creatorId":"vndb:s9454","sourcePersonId":"egs:creator:24731","canonicalEntityId":"vndb:s9454","name":"にぃと","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:155573","source":"egs"},{"creditedName":"koime","creatorId":"vndb:s9458","sourcePersonId":"vndb:s9458","canonicalEntityId":"vndb:s9458","name":"koime","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:95229","source":"vndb"}],"music":[{"creditedName":"まもも","creatorId":"vndb:s2415","sourcePersonId":"egs:creator:18068","canonicalEntityId":"vndb:s2415","name":"まもも","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:155574","source":"egs"},{"creditedName":"90","creatorId":"vndb:s9459","sourcePersonId":"vndb:s9459","canonicalEntityId":"vndb:s9459","name":"90","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:95231","source":"vndb"}],"other":[{"creditedName":"koime","creatorId":"vndb:s9458","sourcePersonId":"vndb:s9458","canonicalEntityId":"vndb:s9458","name":"koime","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:95230","source":"vndb"},{"creditedName":"Chinami","creatorId":"vndb:s50416","sourcePersonId":"vndb:s50416","canonicalEntityId":"vndb:s50416","name":"Chinami","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:95232","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c88248","characterName":"葉月 燕","sourceIds":{"vndbCharacterId":"c88248"},"originalCharacterName":"葉月 燕","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Birth year: 1990"},{"spoiler":false,"text":"Protagonist of \"Story 1 - Bottomless cave\""},{"spoiler":false,"text":"A girl who spent the summer break with her family at her grandparent's house. When Hayato invites her to go inside the jungle, she agrees to go out of boredom and curiosity."},{"spoiler":false,"text":"Protagonist of \"Story 2 - School, a close friend and me\""},{"spoiler":false,"text":"A year has passed by. It's the last semester before the beginning of summer break. Despite being hesitant because of what happened in the forest a year ago, she still came to take the test of courage, following the School Committee President's proposal."},{"spoiler":false,"text":"Main character of \"Story 3 - Crimson hair\""},{"spoiler":true,"text":"Main character of \"Story 4 - Shimaigusa\""},{"spoiler":true,"text":"After her death one year ago, Tsubame remains as an onnen-rei (怨念霊 - a grudge-originated ghost) in this world until now. Every night without changes, she would go seek revenge to those people who have pushed her into this situation."}],"source":"vndb","sourceCharacterId":"c88248"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18735d424a7985ec7007730bc403ca2d890a39447a91a2afa54a98ae10ca869a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23d5b873eaed10a79d18b2f273fae13442a2716f38069a07f598617c2aac5178.webp","width":216,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c88249","characterName":"葉月 葉","sourceIds":{"vndbCharacterId":"c88249"},"originalCharacterName":"葉月 葉","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Birth year: 1992"},{"spoiler":false,"text":"Tsubame's younger sister."},{"spoiler":false,"text":"You is 2 years younger than Tsubame. She always tags along wherever her older sister goes. Loves ice cream and lazing around at home."},{"spoiler":false,"text":"Main character of \"Story 1 - Bottomless cave\""},{"spoiler":false,"text":"Main character of \"Story 2 - School, a close friend and me\""},{"spoiler":false,"text":"Protagonist of \"Story 3 - Crimson hair\""},{"spoiler":false,"text":"A month later after Rei's incident. You and her older sister Tsubame decided to spend their last few days of summer break going on a trip to a beach villa of her mother's friend. Not long after coming there, Tsubame disappeared, and while trying to find her sister, You stumbled upon an abandoned village and met a mysterious girl."},{"spoiler":true,"text":"Protagonist of \"Story 4 - Shimaigusa\""},{"spoiler":true,"text":"Not long after her sister's death, You started seeing eerie things that she has never experienced before. Terrified of the fact, she became a shut-in, cutting every tie to the outside world. However, the quiet days living as a hikikomori are broken the moment You received a mysterious call from Sumire in the midst of an incident..."}],"source":"vndb","sourceCharacterId":"c88249"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36f3bc69195564372c8ed30e4357feddc497b872224312aa1d1e023e8e5587cb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0cc368bd5ac3f9485784b59093230322efca754904e36d2203be7431d44c2b81.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c88250","characterName":"古崎 隼人","sourceIds":{"vndbCharacterId":"c88250"},"originalCharacterName":"古崎 隼人","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Birth year: 1990"},{"spoiler":false,"text":"Main character of \"Story 1 - Bottomless cave\""},{"spoiler":false,"text":"Tsubame's childhood friend. For the purpose of collecting materials for his first horror game, Hayato is the one who comes up with the idea of going into the mysterious jungle."}],"source":"vndb","sourceCharacterId":"c88250"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ceac2a1b024f64eb87152273a85085cdc7a078d44c36972bbcdf88fe71fb8fed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0fa7a63c1f94c0606e713a2bb1d86c34a95faf6b741b6d9a6f12112ec79d817.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c92074","characterName":"射水 すみれ","sourceIds":{"vndbCharacterId":"c92074"},"originalCharacterName":"射水 すみれ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Birth year: 1992"},{"spoiler":false,"text":"Main character of \"Story 1 - Bottomless cave\"."},{"spoiler":false,"text":"A girl who loves scary stories. Upon hearing rumors about ghosts hidden deep within the town's jungle, she decided to pay a visit there to satisfy her curiosity. Later on, with the invite from Hayato, she joins Tsubame, You and him for a trip into the jungle."},{"spoiler":false,"text":"Sumire does not talk much and has a mature appearance. She always picks on You for her small body and immaturity, despite being the same age as her."},{"spoiler":true,"text":"Main character of \"Story 4 - Shimaigusa\""},{"spoiler":true,"text":"After the forest's incident, Sumire hasn't contact You ever since. Until one day, a string of fate binds them together again, as Sumire made a phone call amid You's suffering and managed to calm her down afterward."},{"spoiler":true,"text":"Later on in the story, she is revealed to possess the ability to sense \"shadows\" like You, and has decent knowledge regarding the \"other world\". After that destined phone call, Sumire came to You's house the next day with her friend in order to assist You in overcoming her trauma."},{"spoiler":true,"text":"Best known for her proactiveness. Loves sweets and parfaits, especially those from Master's coffee shop."}],"source":"vndb","sourceCharacterId":"c92074"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea8ff357362b50fb0625eb87b2749b4a6d7640a7d0958faaadc4c5c36c7c18ce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43ee35d7265757fb7c02a386c067a06d30a56bcf1e2d3a2832b1295d20dd1d0b.webp","width":214,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c92075","characterName":"お婆さん","sourceIds":{"vndbCharacterId":"c92075"},"originalCharacterName":"お婆さん","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Side character of \"Story 1 - Bottomless cave\""},{"spoiler":false,"text":"An old lady residing in a house deep within the jungle."},{"spoiler":true,"text":"She is the one taking care of Tsubame, You, Hayato and Sumire after saving them from the dangerous cave."}],"source":"vndb","sourceCharacterId":"c92075"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87136c135c6ac21b3d956384ebcb43684dc18a050250aab5ac8bd946292abc5b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbe804b8a8595f4ac27ca2646fb81555e1e59e52cdd1e244cfa10f7b6ecb5a04.webp","width":255,"height":249,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c92079","characterName":"委員長","sourceIds":{"vndbCharacterId":"c92079"},"originalCharacterName":"委員長","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Birth year: 1989"},{"spoiler":false,"text":"Side character of \"Story 2 - School, a close friend and me\""},{"spoiler":false,"text":"The school committee's president. He is the one proposing doing a test of courage inside the school before summer break."}],"source":"vndb","sourceCharacterId":"c92079"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34776910aaa36e024db188e4369bc5bb7a3fee63a33614dfdb6f211042664cf7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/703a9c79d0137133e8eba3a4ed3e71f310d296623330390adb38a83ac9bbf857.webp","width":220,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c92080","characterName":"怜","sourceIds":{"vndbCharacterId":"c92080"},"originalCharacterName":"怜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Main character of \"Story 2 - School, a close friend and me\""},{"spoiler":false,"text":"Tsubame's close friend. Rei is also one of the students agreeing to join the test of courage."},{"spoiler":false,"text":"Later on in the story,"},{"spoiler":true,"text":"the current Rei is revealed to have been dead for 10 years. She was murdered by Tsuguo, for witnessing him killing another person. However, she can still befriend people in the real world, and so far, Tsubame is the only one who could understand her situation without laughing it off as a joke."},{"spoiler":false,"text":"A mischievous girl. She is jealous of Tsubame because she always wants to have a younger sister like You."}],"source":"vndb","sourceCharacterId":"c92080"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bcc7b5e2ac8ee52285bd6a3ddc4a79b40760c6efeb51069c099d59161a15b4dd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0de8f4956cfc51862e175ed4cb8a0c439561ee8e7052b5ff886ea66e82750a6.webp","width":195,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c92081","characterName":"大森 次生","sourceIds":{"vndbCharacterId":"c92081"},"originalCharacterName":"大森 次生","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Main character of \"Story 2 - School, a close friend and me\""},{"spoiler":false,"text":"The school's current principal. For fear of others knowing about his embezzlement, Tsuguo has decided to murder everyone who got into his way, including Rei."}],"source":"vndb","sourceCharacterId":"c92081"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce3152c56479e8e1a0b51b0d8990652fdca0d49eb6da84a1201ebfedb96dd7dd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64d7a6952034acdb3fbda6fbafc9ac144e1f9497c5644b1f56167f46669d4a08.webp","width":247,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c92091","characterName":"青草 ナツ","sourceIds":{"vndbCharacterId":"c92091"},"originalCharacterName":"青草 ナツ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"height":{"reviewState":"source-only","source":"vndb","value":"152"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Birth year: 1990"},{"spoiler":false,"text":"Main character of \"Story 3 - Crimson hair\""},{"spoiler":false,"text":"Natsu is the daughter of Tsubame's mother's friend. Her family owns a villa at the beach where Tsubame and You pay a visit in the last few days of their summer holiday."},{"spoiler":false,"text":"Natsu is a second-year high school student. She has a shy personality, more or less of a hikikomori. As the story progresses, she gradually opens up to Tsubame and You when she gets to know more about them."}],"source":"vndb","sourceCharacterId":"c92091"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/9572e44f0ed0d988a83498315f2db9dba9e7b1d7f02a612b50d547df00285df0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1a6bb028de20e26e107cf1adb690dc6021eb24b63a4bbbdf796fde91e871ad0.webp","width":211,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c92092","characterName":"カンナ","sourceIds":{"vndbCharacterId":"c92092"},"originalCharacterName":"カンナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"144"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Main character of \"Story 3 - Crimson hair\""},{"spoiler":false,"text":"A mysterious girl that You befriended"},{"spoiler":true,"text":"during her investigation in the abandoned village."},{"spoiler":false,"text":"Since Kanna has always been alone, she was brimming with joy making her first friend."},{"spoiler":true,"text":"Later on in the story, it is revealed that she has already been dead for years, from the infamous \"Crimson hair\" incident. Kanna was once loved by the villagers, however, it only lasted until the spread of an unknown epidemic. The villagers, brainwashed by Shinpu, started believing that Kanna, with her conspicuous crimson hair, is the culprit of this disease. Kanna, completely ignorant of that fact, came to Shinpu's church as advised by the villagers, and ended up being tortured to death."}],"source":"vndb","sourceCharacterId":"c92092"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00e9fd3821862b801f1d7fd07a64aad858e0871ba46fcc20216f47e86415a4e8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0ee8dfb56760c6b3dc7cbec1a9f769433595816814101269b8693b8ee8c67492.webp","width":255,"height":226,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c92101","characterName":"神父","sourceIds":{"vndbCharacterId":"c92101"},"originalCharacterName":"神父","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Main character of \"Story 3 - Crimson hair\""},{"spoiler":false,"text":"A former priest."},{"spoiler":true,"text":"Due to his smuggling of contagious animals, a disastrous epidemic has spread throughout the village, killing everyone. You, along with Kanna, encountered him when gathered clues led them to a church outside of the village."}],"source":"vndb","sourceCharacterId":"c92101"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/eda73e226f0ba71f6abc88143cad6ae432a12b52dfd4a001e24dc669b8e77146.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10de46cc386db7e8b7c28a0a1a56fbc2b3a124b09651b12e566a2681aa88a987.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c92228","characterName":"大和","sourceIds":{"vndbCharacterId":"c92228"},"originalCharacterName":"大和","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Birth year: 1992"},{"spoiler":true,"text":"Main character of \"Story 4 - Shimaigusa\""},{"spoiler":true,"text":"Sumire's friend. He comes along with Sumire in order to help You overcome her fear of seeing \"shadows\"."},{"spoiler":true,"text":"Yamato also possesses the ability to sense \"shadows\", albeit weaker than Sumire. Has been hanging out with Sumire since when he is 6 years old, yet sometimes he couldn't comprehend her actions and emotions."}],"source":"vndb","sourceCharacterId":"c92228"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5ad88c5f8aa39eeb1917ee1c032aa7963bcdad51f6a30df9799850b9b5011f97.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a26bcc31f72019036a068f62fd74650d9955bec45fe225bc13d5282e948dee12.webp","width":199,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c92232","characterName":"マスター","sourceIds":{"vndbCharacterId":"c92232"},"originalCharacterName":"マスター","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Side character of \"Story 4 - Shimaigusa\""},{"spoiler":true,"text":"A man who runs a coffee shop in You's town."},{"spoiler":true,"text":"Master has a mysterious aura around him. Later on in the story, he is revealed to possess the ability to sense \"shadows\" like You."}],"source":"vndb","sourceCharacterId":"c92232"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c92233","characterName":"You's shadow","sourceIds":{"vndbCharacterId":"c92233"},"originalCharacterName":"You's shadow","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Side character of \"Story 4 - Shimaigusa\""},{"spoiler":true,"text":"A mysterious existence bound with You, emerging after her sister's death. Is said by Sumire to protect You from other \"shadows\"."}],"source":"vndb","sourceCharacterId":"c92233"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p3143","sourceCompanyId":"egs:brand:2923","canonicalEntityId":"vndb:p3143","name":"Home Security Company","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:13706:2923","source":"egs"},{"companyId":"vndb:p3143","sourceCompanyId":"vndb:p3143","canonicalEntityId":"vndb:p3143","name":"Home Security Company","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:28514:v11758","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
