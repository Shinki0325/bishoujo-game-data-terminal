1/characters/v1/images/fe/fe4e47e1030228ecddfd223648df23472737d266471c381761666e4e0b2ed8d6.webp","width":109,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_52701","characterName":"Argo","sourceIds":{"bangumi":[{"characterId":"52701","match":"source-roster","subjectId":"222871"}]},"originalCharacterName":"Argo","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"在艾恩葛朗特里少数担任情报贩子的女性，参加过封测的玩家之一。在封测时找到了学习隐藏技能“体术”的任务并亲自试验，但因没有完成任务而被教导的NPC在脸上留下类似老鼠胡须的标记，从此成为自己身为情报贩子的招牌。能力为敏捷特化型，善用的武器为拳爪。"},{"spoiler":false,"text":"在正式运营时为了维持形象故意画上一样的胡须，被通称为“鼠之亚尔戈”。号称只要价钱合适，就连关于自身的情报也能卖，唯一绝对不贩卖的情报是“原封测玩家的名单”。"},{"spoiler":false,"text":"在游戏初期曾免费发行以在封测时期得到的情报为准的“亚尔戈攻略本”来协助新手玩家。与桐人十分友好并经常交换情报，其中圣诞头目的情报就是来自于她。"},{"spoiler":false,"text":"在游戏《虚空断章》里，为了协助攻略组而跑到76层协助桐人等人。在《失落之歌》中亦有登场，种族设定为猫妖。"}],"source":"bangumi","sourceCharacterId":"52701"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67d509c126a544a51f028685a8fcbac9c558be12ef09bb5dbf86bc90dc3d3590.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38bc62957c81e95eb418cf970cd123a3917971c90b952822ff8c475a7399d9a2.webp","width":123,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_58159","characterName":"Llenn / Karen Kohiruimaki","sourceIds":{"bangumi":[{"characterId":"58159","match":"source-roster","subjectId":"222871"}]},"originalCharacterName":"Llenn / Karen Kohiruimaki","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"身長150センチに満たない小柄な女性プレイヤー。敏捷性（AGI）に優れており、スピードを活かした近距離戦を得意とする。可愛いものが大好きで、全身の装備をピンクで統一している。メインアームはP90で「ピーちゃん」と呼んでいる。"}],"source":"bangumi","sourceCharacterId":"58159"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a79a6d580f2ea12dad9f811124b70fa35e26ccab66380becd2df89ff4aabf88e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56663dbc5ccf59a8f30706ec4b696b3441a64afbabeb947669232c3db36c9af5.webp","width":89,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_58160","characterName":"Pitohui","sourceIds":{"bangumi":[{"characterId":"58160","match":"source-roster","subjectId":"222871"}]},"originalCharacterName":"Pitohui","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"レンのフレンドで、頬にタトゥーを入れた長身の美女。《GGO》のベテランプレイヤーで、プレイのたびに違う銃を使うほどのガンマニアということ以外は何もわからない謎多き人物。"}],"source":"bangumi","sourceCharacterId":"58160"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9a8b8cf4331d89aa2223fc422e9a79ad0388bf00fc1cebbc71d7f4d5590a310.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35e7cef1bc9270e06d3eb0d3ba97a13e53b890066c26b1dfbfeddf185d8c6afd.webp","width":130,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_58161","characterName":"M / Kōji Asōgi","sourceIds":{"bangumi":[{"characterId":"58161","match":"source-roster","subjectId":"222871"}]},"originalCharacterName":"M / Kōji Asōgi","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ピトフーイの知り合いの男性プレイヤー。身長190センチを超える巨漢で、中距離～遠距離戦を得意とし、特に狙撃の腕に長ける。冷静で作戦立案能力にも優れており、チームの参謀役を務めている。"}],"source":"bangumi","sourceCharacterId":"58161"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43808218e982a277c23246373c25a152aef44b544e9d705d4db75e388d5f9af6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b72e2d3334c7f0950926e551e3f28f7b2a71746865874356a5836d3de9cf13e8.webp","width":189,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_58162","characterName":"Fukajiroh / Miyu Shinohara","sourceIds":{"bangumi":[{"characterId":"58162","match":"source-roster","subjectId":"222871"}]},"originalCharacterName":"Fukajiroh / Miyu Shinohara","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"レンの知り合いで、彼女と同じくらい小柄な女性プレイヤー。VRMMORPG《ALO（アルヴヘイム・オンライン）》からキャラクターをコンバートしているためステータスが高い。その高い筋力（STR）を活かして、六連装グレネードランチャーの二丁持ちで戦う。"}],"source":"bangumi","sourceCharacterId":"58162"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1edee8c402e5beee9f424174b5fadea9a3ffac2aaf4c54bad54bf8c64bfe61d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bddc446e4386e150e817189d9ced121cbab4d50b51fb98ddd53f84bd05f0a25e.webp","width":256,"height":188,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_72658","characterName":"ガブリエル・ミラー","sourceIds":{"bangumi":[{"characterId":"72658","match":"source-roster","subjectId":"222871"}]},"originalCharacterName":"ガブリエル・ミラー","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata"