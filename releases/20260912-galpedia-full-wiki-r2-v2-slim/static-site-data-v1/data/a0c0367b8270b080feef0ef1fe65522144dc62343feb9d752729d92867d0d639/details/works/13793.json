":"source-native","relationId":"vndb:vn-staff:26086","source":"vndb"},{"creditedName":"ユリノナ","creatorId":"vndb:s4537","sourcePersonId":"vndb:s4537","canonicalEntityId":"vndb:s4537","name":"ユリノナ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26087","source":"vndb"},{"creditedName":"倉田 憲一","creatorId":"vndb:s19279","sourcePersonId":"vndb:s19279","canonicalEntityId":"vndb:s19279","name":"倉田 憲一","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26088","source":"vndb"}]},"cast":[{"characterId":"char_c13085","characterName":"月丘 彰","sourceIds":{"bangumi":[],"egsCharacterIds":["15916"],"vndbCharacterId":"c13085"},"originalCharacterName":"月丘 彰","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"75"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Grade: 2nd year, Sakura Group"},{"spoiler":false,"text":"Affiliation: The gardening club"},{"spoiler":false,"text":"Akira is a pretty average guy, with the exception of his feminine looks. He is kind, a donkan and also very hilarious, as sometimes he get’s toyed with by everyone because of his submissive demeanor."},{"spoiler":false,"text":"Akira's twin sister Akiko is sickly and is in the hospital, so she can’t go to school. The problem is that she’s been sick for too long and she may have to repeat the year, or even drop out of school. So his parents decided to send him, the splitting image of his sister, over to the all-girls prestigious school to go undercover as his sister, and live her life for a while so that when she comes back, she can take his place without dropping out of school or repeating a year."},{"spoiler":false,"text":"Since he gets easily swept away by the situation, he gave in to his parents' idea and he becomes more and more of a girl deeper in the story because of his attitude. Since Akira did go to replace Akiko without her permission, every time he makes a mistake he gets shouted at by his sister through the phone."},{"spoiler":false,"text":"Edited from Accany's review"}],"source":"vndb","sourceCharacterId":"c13085"},{"segments":[{"spoiler":false,"text":"双子の妹、月丘晶子として、乙女の園に潜り込むことになる本作の主人公。"},{"spoiler":false,"text":"女性のような容姿をしている点を除けば、普通の男子。"},{"spoiler":false,"text":"お嬢様学園では「男女」の違いと、「一般人とお嬢様」の二つの違いに苦労することになる。"},{"spoiler":false,"text":"性格は楽観的で物事をあまり深く考えない、基本的にサバサバしてる。"},{"spoiler":false,"text":"常識人だが、妹のことになると後先考えずに行動してしまうシスコン。"},{"spoiler":false,"text":"「大丈夫だよ、晶子。オレ達双子を見分けられる奴なんて、そういないって」"}],"source":"egs","sourceCharacterId":"15916","sourceWorkId":"11914","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c13085","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"15916","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"15916","value":"女性"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53a88836e6a8b6f01375b2925c7b2c2e13daf816bf42fadea9b5f01c6ab3c8b6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02eba9a018f58f336b07db76c796059ee962b5d5db24d44a8c5ad3c9c1f0d7ee.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせ なつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13436","source":"vndb"}]},{"characterId":"char_c13088","characterName":"名木城 都","sourceIds":{"bangumi":[{"characterId":"11060","match":"exact-normalized-name-in-linked-work","subjectId":"11197"},{"characterId":"11060","match":"exact-normalized-name-in-linked-work","subjectId":"11198"}],"egsCharacterIds":["15917"],"vndbCharacterId":"c13088"},"originalCharacterName":"名木城 都","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"158cm"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Grade: 2nd year, Sakura Group"},{"spoiler":false,"text":"Affiliation: The gardening club"},{"spoiler":false,"text":"Miyako is Akira and Akiko’s osananajimi and the latter's classmate. She’s a flower freak just like Akiko, and also is a member of the gardening club. Miyako is a tsundere, so she gets especially hostile towards Akira, the person she is fond of. Not so to the other people though. She’s also from a rich family."},{"spoiler":false,"text":"Edited from Accany's review"}],"source":"vndb","sourceCharacterId":"c13088"},{"segments":[{"spoiler":false,"text":"晶子と同じクラスで、唯一、晶子が男だと気付く最重要人物。"},{"spoiler":false,"text":"明朗快活でクラスの皆から慕われているが、晶子（彰）にだけは厳しい態度を取ってしまう、いわゆる「ツンデレ」。"},{"spoiler":false,"text":"晶子とは昔からの親友であり、そのため2人が入れ替わったことに早くから気付く。"},{"spoiler":false,"text":"初めは怒って学園を追い出そうとしたが、晶子の為だと説得され、仕方なく協力するようになる。"},{"spoiler":false,"text":"「明日から私が女の子らしさをみっちり教えてあげるから、しっかり学んでね。わかった？」"}],"source":"egs","sourceCharacterId":"15917","sourceWorkId":"11914","spoiler":false},{"segments":[{"spoiler":false,"text":"与晶子同班，是唯一注意到晶子是彰扮的最重要人物。"},{"spoiler":false,"text":"明朗活泼在班上是被大家爱慕着，但只对晶子（彰）采取严苛态度，所谓的『娇蛮』。"},{"spoiler":false,"text":"和晶子在很久前就是好友，也因为那样很快就发现两人替换了。"},{"spoiler":false,"text":"最初是很生气想把他赶出学园的，但为可晶子就被说服了，不得已变成要协助彰了。"}],"source":"bangumi","sourceCharacterId":"11060"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07aa76142d50211cccaee214b2304d53e81445b6ca63ea53c829cb0b0a4352df.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e74367f3fe3bc299b0327b53a3013be9d506235a48c731b8ac233236c762967a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11197:11060:4956:1","source":"bangumi"}]},{"characterId":"char_c13089","characterName":"宝生 聖佳","sourceIds":{"bangumi":[{"characterId":"11061","match":"exact-normalized-name-in-linked-work","subjectId":"11197"},{"characterId":"11061","match":"exact-normalized-name-in-linked-work","subjectId":"11198"}],"egsCharacterIds":["15918"],"vndbCharacterId":"c13089"},"originalCharacterName":"宝生 聖佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Grade: 3rd year, Tsubaki Group"},{"spoiler":false,"text":"Affiliation: Student Council President"},{"spoiler":false,"text":"The richest and most powerful ojousama in the story. She’s the head of the student council and she has set her eyes on Akira on being the next head of the student council. Needless to say she bulldozes over Akira’s rejection and somewhat forces him to join her. She’s very bad in terms of communication, taking always the logically correct route of action but logically correct doesn’t mean it doesn’t hurt people’s feelings. A loner character."},{"spoiler":false,"text":"Edited from Accany's review"}],"source":"vndb","sourceCharacterId":"c13089"},{"segments":[{"spoiler":false,"text":"晶子の一つ上の先輩。"},{"spoiler":false,"text":"同性でも圧倒されるほどの美貌の持ち主。だがそれゆえ、学園でまともに話せる人がいない。"},{"spoiler":false,"text":"事情を知らない晶子は「同性なら動揺してはいけない！」と冷静を装い、普通に接した事で気に入られる。"},{"spoiler":false,"text":"実家は旧華族、大正時代に財をなした名家。"},{"spoiler":false,"text":"たまに世間外れの行動をとるが、それを指摘すると不貞腐れてしまう子供っぽいところがある。"},{"spoiler":false,"text":"「晶子、あなた私が世間知らずだって馬鹿にしてるの？」"}],"source":"egs","sourceCharacterId":"15918","sourceWorkId":"11914","spoiler":false},{"segments":[{"spoiler":false,"text":"在同性中有着压倒性的美貌。"},{"spoiler":false,"text":"在学园中没有可以和她对等说话的人，但不知详情的彰是因 「同性的话是不会动摇的！」而装冷静，普通地对待。也因此被聖佳看上了，在很多方面都照顾他起来了。"},{"spoiler":false,"text":"本家是旧华族，在大正时代就很富有的名家。"},{"spoiler":false,"text":"偶尔会有不懂世俗的行动，但对他人的指出又会因自尊心高而不满反抗起来，有着这样孩子气的一面。"}],"source":"bangumi","sourceCharacterId":"11061"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3fcb3060d874651fbb73bb7f3bee12b02fc4010806037f11fe404444e6813d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/663e416dfa3181c89cc1ecf30b32f23b64b0c719c3ab75096ff63fc737eae113.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11197:11061:4432:1","source":"bangumi"}]},{"characterId":"char_c13090","characterName":"鹿島 志鶴","sourceIds":{"bangumi":[{"characterId":"11062","match":"exact-normalized-name-in-linked-work","subjectId":"11197"},{"characterId":"11062","match":"exact-normalized-name-in-linked-work","subjectId":"11198"}],"egsCharacterIds":["15919"],"vndbCharacterId":"c13090"},"originalCharacterName":"鹿島 志鶴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Grade: 2nd year, Sakura Group"},{"spoiler":false,"text":"Affiliation: Art Club"},{"spoiler":false,"text":"Shizuru is one of Akiko's friends as well as her classmate. She's kind of the silent and clever type, but she's a little weird sometimes and she ain't what she seems. Shizuru's an excellent artist, but that’s to artists though."},{"spoiler":false,"text":"Edited from Accany's review"}],"source":"vndb","sourceCharacterId":"c13090"},{"segments":[{"spoiler":false,"text":"晶子のクラスメイト。"},{"spoiler":false,"text":"お淑やかで上品。聖母のような癒し系お嬢様といった印象の美少女。"},{"spoiler":false,"text":"性格も見た目通り、優しく、ほがらか。"},{"spoiler":false,"text":"たまに突拍子なく意味不明な言動をとるが、それを「志鶴さんだからしょうがない」で済ませられるキャラである。"},{"spoiler":false,"text":"「あ……怒っちゃいましたか？　すみません。お詫びに私の耳たぶを舐めてください」"}],"source":"egs","sourceCharacterId":"15919","sourceWorkId":"11914","spoiler":false},{"segments":[{"spoiler":false,"text":"晶子的同学。"},{"spoiler":false,"text":"文静气质高。给人圣母般的治愈系大小姐印象的美少女。性格也如外表一样，温柔明朗。"},{"spoiler":false,"text":"偶尔会有出奇意义不明的言行，但却会以「是志鶴小姐那就没办法吧」的理由而了事的一个角色。"}],"source":"bangumi","sourceCharacterId":"11062"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c013e33e5dcfa66942bd8451bc0a764bfb08484ffa5e6d719f29488251883e62.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47f50fd4720de23a8172e4294774c5e567e8b129bca6cac5626ed4ffb323e579.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11197:11062:5052:1","source":"bangumi"}]},{"characterId":"char_c13091","characterName":"藍那 祈","sourceIds":{"bangumi":[{"characterId":"11063","match":"exact-normalized-name-in-linked-work","subjectId":"11197"},{"characterId":"11063","match":"exact-normalized-name-in-linked-work","subjectId":"11198"}],"egsCharacterIds":["15920"],"vndbCharacterId":"c13091"},"originalCharacterName":"藍那 祈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"147cm"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Grade: 1st year, Yuzuki Group"},{"spoiler":false,"text":"The cute kouhai character in the story. She’s cute, but communication-wise she isn’t exactly top class and therefore she’s a little lonely because she thinks she doesn’t have friends. She supports Akira a lot in the story."},{"spoiler":false,"text":"Edited from Accany's review"}],"source":"vndb","sourceCharacterId":"c13091"},{"segments":[{"spoiler":false,"text":"無口でおとなしく、人見知りが激しい後輩。"},{"spoiler":false,"text":"晶子とは、困っていたところを偶然助けられて仲良くなる。"},{"spoiler":false,"text":"両親は大学教授で、彼女も幼少のころから勉強ばかりしており、学業の成績はかなり良い。"},{"spoiler":false,"text":"しかし反面、コミュニケーション能力に欠け、友達がいないのを心配した両親に友人を作るためにこの学園に入学させられた。"},{"spoiler":false,"text":"「でも、私は晶子さまさえいてくれたら、それで……」"}],"source":"egs","sourceCharacterId":"15920","sourceWorkId":"11914","spoiler":false},{"segments":[{"spoiler":false,"text":"寡言老实，非常怕生害羞的后辈。"},{"spoiler":false,"text":"晶子是偶然帮助了有麻烦的她而变得关系好了。"},{"spoiler":false,"text":"不知是不是因有两个大学教授的父母，所以自小就有学习，学业成绩是相当好。"},{"spoiler":false,"text":"但是另一面缺乏在语言沟通的能力，担心她会没有朋友的双亲为了让她交到朋友而送到这学园就读。"},{"spoiler":false,"text":"祈也理解双亲的想法而想办法去交朋友，但怕生不是那么简单就能治好，不能与晶子以外的人习惯地会话。"},{"spoiler":false,"text":"一提到最喜欢的鱼贝类话题就会变得能说会道。"}],"source":"bangumi","sourceCharacterId":"11063"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d182627080203f6c3949fbc860cd9ad08652682099f86293381f083037b7156b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c73a1381eba61681718a048d5ade2f74219b59122b373c96e51ad7a9b2a6a522.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阪田佳代","creatorId":"vndb:s650","sourcePersonId":"vndb:s650","canonicalEntityId":"vndb:s650","name":"鮎川ひなた","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11197:11063:5133:1","source":"bangumi"}]},{"characterId":"char_c13092","characterName":"佐上 薫","sourceIds":{"bangumi":[{"characterId":"10598","match":"exact-normalized-name-in-linked-work","subjectId":"11197"},{"characterId":"10598","match":"exact-normalized-name-in-linked-work","subjectId":"11198"}],"egsCharacterIds":["15921"],"vndbCharacterId":"c13092"},"originalCharacterName":"佐上 薫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Grade: 3rd year, Momiji Group"},{"spoiler":false,"text":"Affiliation: Track Club, Student Council Vice President"},{"spoiler":false,"text":"The vice president of the student council who is a playgirl. She likes making fun of Akira since his reactions are always cute and amusing. Behind that playgirl mask though is quite the mysterious character."},{"spoiler":false,"text":"Edited from Accany's review"}],"source":"vndb","sourceCharacterId":"c13092"},{"segments":[{"spoiler":false,"text":"一つ年上の3年生の先輩。"},{"spoiler":false,"text":"責めるタイプのキャラクター。大人で頼りになるが、ちょっと意地悪なお姉さん。"},{"spoiler":false,"text":"一応、陸上部に所属しているが、いろんな部を掛け持ちしている。"},{"spoiler":false,"text":"スポーツ万能でサバサバした性格が後輩にうけ、かなりもてる。"},{"spoiler":false,"text":"好奇心旺盛で、面白いことに飢えているためか、晶子が何かを隠していることを見抜き、何かと絡んでくる。"},{"spoiler":false,"text":"「逃がさないよ～。晶子ちゃんは聖佳から、暇だって聞いてるんだからね」"}],"source":"egs","sourceCharacterId":"15921","sourceWorkId":"11914","spoiler":false},{"segments":[{"spoiler":false,"text":"“攻”类型的角色。虽然是成熟可靠，但却是有点坏心眼的姐姐。"},{"spoiler":false,"text":"姑且算是属于田径部的，但却又在各种社团活跃着。"},{"spoiler":false,"text":"体育万能、爽朗的性格是很受后辈的欢迎。"},{"spoiler":false,"text":"好奇心旺盛，不知是不是因渴求着有趣的事而看穿晶子有什么隐藏着，老是缠过来。"},{"spoiler":false,"text":"「你、逃、不、了、的、哟～。从聖佳那里知道了，今天是很闲呢」"}],"source":"bangumi","sourceCharacterId":"10598"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"10598","value":"3年椛组・田径部・学生会副会长"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2559f119a4be63acb84b7f4c938f5ee8c18ac7996488035439c43932c291c04.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9afc58a4d948f303929136f2ab31421191eb4ad16563816e3bb66100b5cb0bc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11197:10598:5741:1","source":"bangumi"}]},{"characterId":"char_c13093","characterName":"山本 眞弥子","sourceIds":{"bangumi":[{"characterId":"11064","match":"exact-normalized-name-in-linked-work","subjectId":"11197"},{"characterId":"11064","match":"exact-normalized-name-in-linked-work","subjectId":"11198"}],"egsCharacterIds":["15922"],"vndbCharacterId":"c13093"},"originalCharacterName":"山本 眞弥子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Grade: 1st year, Yuzuki Group"},{"spoiler":false,"text":"Mayako’s a cute little girl who is a friend and classmate of Inori’s. She’s very active and bright and a little clumsy, but that can be overlooked because she always smiles in the end."},{"spoiler":false,"text":"Edited from Accany's review"}],"source":"vndb","sourceCharacterId":"c13093"},{"segments":[{"spoiler":false,"text":"祈のクラスメイト。"},{"spoiler":false,"text":"能天気系。超ポジティブで悩みがない。"},{"spoiler":false,"text":"ノリがよく、お嬢様学園に似合わないテンションをもつが、実家は有名な茶道の家元だったりする。"},{"spoiler":false,"text":"晶子とは、祈との繋がりで出会う。"},{"spoiler":false,"text":"いつも一生懸命なのはいいが、落ち着きがなく、ドジなところがコンプレックス。"},{"spoiler":false,"text":"「えへへ、晶子様をお待たせするわけにはいかないですから！」"}],"source":"egs","sourceCharacterId":"15922","sourceWorkId":"11914","spoiler":false},{"segments":[{"spoiler":false,"text":"祈的同学。无忧无虑的。超乐观没烦恼。"},{"spoiler":false,"text":"很会附和，有着与大小姐学园不相配的情绪，家里是有名的茶道宗家。"},{"spoiler":false,"text":"与晶子是通过和祈的关系而认识。总是很拼命是好但却却不冷静，笨拙的一面是让她自卑。"},{"spoiler":false,"text":"因为很仰慕能有冷静行动的人，所以尊敬着祈。"}],"source":"bangumi","sourceCharacterId":"11064"}],"profileFacts":[],"metadataCandidateConflicts":{"bust":[{"comparisonValue":"83","source":"vndb","sourceCharacterId":"c13093","value":"83"},{"comparisonValue":"78","scope":"sourceWork","source":"egs","sourceCharacterId":"15922","sourceWorkId":"11914","value":"78"},{"comparisonValue":"78","source":"bangumi","sourceCharacterId":"11064","value":"78"}],"hip":[{"comparisonValue":"78","source":"vndb","sourceCharacterId":"c13093","value":"78"},{"comparisonValue":"83","scope":"sourceWork","source":"egs","sourceCharacterId":"15922","sourceWorkId":"11914","value":"83"},{"comparisonValue":"83","source":"bangumi","sourceCharacterId":"11064","value":"83"}],"waist":[{"comparisonValue":"52","source":"vndb","sourceCharacterId":"c13093","value":"52"},{"comparisonValue":"56","scope":"sourceWork","source":"egs","sourceCharacterId":"15922","sourceWorkId":"11914","value":"56"},{"comparisonValue":"56","source":"bangumi","sourceCharacterId":"11064","value":"56"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/672893aa1a05ec8e333264a9eadc6d8a64b8c693456db43e78775d327ea333c5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58e6e1c81508797ef8d31778d2a21a677a6932ace56cb311fa310de3b669eacb.webp","width":213,"height