role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Second-year student at Carlson Academy."},{"spoiler":false,"text":"The protagonist's best friend and vice-president of the Student Council, which manages the physical education department of the school."},{"spoiler":false,"text":"He has high physical ability and also plays the role of escort for the main character."},{"spoiler":false,"text":"He has a natural talent for hand-to-hand combat technology, and reigns as an absolute champion in the hand-to-hand combat competition of the Hermes adult division."},{"spoiler":false,"text":"Has the nickname \"Blood Prince\""},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c100813"},{"segments":[{"spoiler":false,"text":"宇宙連邦軍士官学校カールソン学園二年生。"},{"spoiler":false,"text":"主人公の親友であり、生徒会の副会長を務める。"},{"spoiler":false,"text":"副会長は生徒会の広報と部活動における体育系部を取り仕切る体育部長でもある。"},{"spoiler":false,"text":"主人公を上回る高い身体能力を持ち、主人公の護衛的な役割も務めている。"},{"spoiler":false,"text":"白兵戦技術には天性の才能があり、大人も交えたヘルメスにおける白兵戦大会において絶対王者として君臨する。〝血の貴公子”との異名を持つ。"}],"source":"egs","sourceCharacterId":"17590","sourceWorkId":"24138","spoiler":false},{"segments":[{"spoiler":false,"text":"宇宙連邦軍士官学校 カールソン学園 二年生。"},{"spoiler":false,"text":"主人公の親友であり、学園の体育系部を取り仕切る生徒会の副会長。"},{"spoiler":false,"text":"高い身体能力を持ち、主人公の護衛的な役割も務めている。"},{"spoiler":false,"text":"白兵戦技術には天性の才能があり、大人も交えたヘルメスの白兵戦大会において絶対王者として君臨する。"},{"spoiler":false,"text":"“血の貴公子” の異名を持つ。"}],"source":"bangumi","sourceCharacterId":"92592"}],"profileFacts":[{"label":"身高（本版本）","value":"180 cm","valueContext":null,"source":"egs","sourceCharacterId":"17590","sourceWorkId":"24138","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7706cd6487f962d2138a775a5e3bc7116020f9fc0ba5bcaf835d475f9dc2616.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/deebfaec5d508e9bbc114660499bf9adc9cff1816d02fbb1d9b503201dbf0f06.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c100814","characterName":"オットー・アイゼンハイム","sourceIds":{"bangumi":[{"characterId":"92593","match":"exact-normalized-name-in-linked-work","subjectId":"220322"}],"egsCharacterIds":["17591"],"vndbCharacterId":"c100814"},"originalCharacterName":"オットー・アイゼンハイム","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"First-year student at Carlson Academy. Serves as the secretary of the Student Council."},{"spoiler":false,"text":"He is also the director of the cultural department, who manages the culture in school club activities. However, he is immersed in the brainwashing lab of the underground prison and fails as a student. A crazy science youth who continues to research and improve remodeling equipment day and night."},{"spoiler":false,"text":"He has a genius brain, but has an extraordinary enthusiasm for transforming of a woman's body."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c100814"},{"segments":[{"spoiler":false,"text":"宇宙連邦軍士官学校カールソン学園一年生。"},{"spoiler":false,"text":"生徒会の書記を務める。"},{"spoiler":false,"text":"書記は生徒会発行の広報誌や書籍の責任者であり、部活動における文化系部を取り仕切る文化部長でもある。"},{"spoiler":false,"text":"地下監獄の洗脳ラボに入り浸り、日夜装置の研究・改良を続けている狂気の科学青年。"},{"spoiler":false,"text":"小太り丸顔の醜男で、師と同様に女性の体を変態改造することに異常な熱意を燃やしている。"},{"spoiler":false,"text":"天才肌で優秀な頭脳の持ち主であるが秘密ラボに入り浸り授業にほとんど出席しておらず、学生として落ちこぼれ。"}],"source":"egs","sourceCharacterId":"17591","sourceWorkId":"24138","spoiler":false},{"segments":[{"spoiler":false,"text":"宇宙連邦軍士官学校 カールソン学園 一年生。 生徒会の書記を務める。"},{"spoiler":false,"text":"学園の部活動において文化系部を取り仕切る文化部長でもある。"},{"spoiler":false,"text":"しかし地下監獄の洗脳ラボに入り浸っており、学生として落ちこぼれ。"},{"spoiler":false,"text":"日夜改造装置の研究・改良を続けている狂気の科学青年。"},{"spoiler":false,"text":"天才的な頭脳を持つが、女性の身体を変態改造することに異常な熱意を燃やしている。"}],"source":"bangumi","sourceCharacterId":"92593"}],"profileFacts":[{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"17591","sourceWorkId":"24138","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/5502f3e31723eefadb0bdd24f7dbf817622f56d42f46750486a5cd8aaf3c6530.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ece2aa5909ce630b26552032b85d63524488723146f9f87af66ed4ab7669faf3.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c100815","characterName":"ヤーコブ・ヘンゼン","sourceIds":{"bangumi":[{"characterId":"92594","match":"exact-normalized-name-in-linked-work","subjectId":"220322"}],"egsCharacterIds":["17592"],"vndbCharacterId":"c100815"},"originalCharacterName":"ヤーコブ・ヘンゼン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Second-year student at Carlson Academy. Treassurer of the Student Council."},{"spoiler":false,"text":"A childhood friend of the protagonist and Karl, they are called \"The Doctor\"."},{"spoiler":false,"text":"An expert in brain science, he demonstrates his genius in personality remodeling using a brainwashing device."},{"spoiler":false,"text":"He is a versatile genius different from Otto, and is also good at bureaucratic paperwork."},{"spoiler":false,"text":"He used to be a gentle boy who couldn't even kill insects, but"},{"spoiler":false,"text":"he became an abnormal person who suffered from mental illness due to torture when he was imprisoned and could only get pleasure by hurting people."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c100815"},{"segments":[{"spoiler":false,"text":"宇宙連邦軍官学校カールソン学園二年生。"},{"spoiler":false,"text":"生徒会の会計を務める。"},{"spoiler":false,"text":"会計は生徒会の予算を取り仕切る大蔵大臣であり、学校側との折衝の窓口でもある。"},{"spoiler":false,"text":"主人公とカールの幼馴染で二人からは〝博士”と呼ばれていた。"},{"spoiler":false,"text":"脳科学のエキスパートで、洗脳装置を利用した人格改造に天才的な腕を持つ技術者。"},{"spoiler":false,"text":"同じ科学スタッフでもオットーとは違い万能型の天才で、官僚的事務処理能力にも長けている。"},{"spoiler":false,"text":"かつては虫も殺せない優しい少年だったが、収監された際の拷問が原因で精神を病み、人を痛めつけることでしか快楽を得られない異常者となっている。"}],"source":"egs","sourceCharacterId":"17592","sourceWorkId":"24138","spoiler":false},{"segments":[{"spoiler":false,"text":"宇宙連邦軍官学校 カールソン学園 二年生。 生徒会の会計を務める。"},{"spoiler":false,"text":"主人公とカールの幼なじみで、ふたりからは “博士” と呼ばれている。"},{"spoiler":false,"text":"脳科学のエキスパートで、洗脳装置を利用した人格改造で天才的な腕を発揮する。"},{"spoiler":false,"text":"オットーとは異なる万能型の天才で、官僚的事務処理能力にも長けている。"},{"spoiler":false,"text":"かつては虫も殺せない優しい少年だったが、収監された際の拷問が原因で精神を病み、"},{"spoiler":false,"text":"人を痛めつけることでしか快楽を得られない異常者となっている。"}],"source":"bangumi","sourceCharacterId":"92594"}],"profileFacts":[{"label":"身高（本版本）","value":"175 cm","valueContext":null,"source":"egs","sourceCharacterId":"17592","sourceWorkId":"24138","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6bc0b9b4f2a8f9e095220a93ae6b415febefa887ecc8c050c0241570818b881.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e77cb5c7c9033d274e1d035a9119d858077704962fc0a004264f8b375e3e0fc2.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c100816","characterName":"アウグスト・ベクテル","sourceIds":{"bangumi":[{"characterId":"92595","match":"exact-normalized-name-in-linked-work","subjectId":"220322"}],"egsCharacterIds":["17593"],"vndbCharacterId":"c100816"},"originalCharacterName":"アウグスト・ベクテル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Carlson Academy third year student. Serves as the school military police chief."},{"spoiler":false,"text":"Even students are treated as military personnel, and the order of the school will be cracked down by their military police."},{"spoiler":false,"text":"The commander-in-chief is the student council president."},{"spoiler":false,"text":"Although inferior to Karl, he is a master of hand-to-hand combat and a master of arms."},{"spoiler":false,"text":"A giant warrior with a well-trained body."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c100816"},{"segments":[{"spoiler":false,"text":"宇宙連邦軍士官学校カールソン学園三年生。"},{"spoiler":false,"text":"生徒会の学園憲兵長を務める。"},{"spoiler":false,"text":"学園憲兵長とは通常の学校でいう風紀委員長。"},{"spoiler":false,"text":"士官学校であるカールソン学園では、生徒と言えども軍人扱いのため、学園の秩序は憲兵によって取り締まられる事となる。"},{"spoiler":false,"text":"憲兵は生徒が務め武装を許されており、学園憲兵長はその指揮官となる。"},{"spoiler":false,"text":"無論、最高指揮官は生徒会長である。"},{"spoiler":false,"text":"よく鍛えられた肉体を持つ巨漢戦士。"},{"spoiler":false,"text":"カールには劣るが白兵戦技術の達人であり、射撃の名手でもある。"}],"source":"egs","sourceCharacterId":"17593","sourceWorkId":"24138","spoiler":false},{"segments":[{"spoiler":false,"text":"宇宙連邦軍士官学校 カールソン学園 三年生。 生徒会の学園憲兵長を務める。"},{"spoiler":false,"text":"学生でも軍人扱いであり、学園の秩序は彼ら憲兵によって取り締まられることとなる。"},{"spoiler":false,"text":"最高指揮官は生徒会長。"},{"spoiler":false,"text":"カールには劣るが白兵戦技術の達人であり、射撃の名手。"},{"spoiler":false,"text":"よく鍛えられた肉体を持つ巨漢戦士。"}],"source":"bangumi","sourceCharacterId":"92595"}],"profileFacts":[{"label":"身高（本版本）","value":"185 cm","valueContext":null,"source":"egs","sourceCharacterId":"17593","sourceWorkId":"24138","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca8b99acafa5fbf96c9bd63ae1a8a92728ee8213e441594bd943e99ac928acdd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71fe15929eaa5591a0e011d4afced89da0b67393a5f13c633f23ad7b9e7cc199.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c62542","characterName":"ユーリア · ブラッドストーン","sourceIds":{"bangumi":[{"characterId":"64969","match":"exact-normalized-name-in-linked-work","subjectId":"220322"}],"egsCharacterIds":["17587"],"vndbCharacterId":"c62542"},"originalCharacterName":"ユーリア · ブラッドストーン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"28"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Colonel of the Space Federation Army belonging to the New Solar faction."},{"spoiler":false,"text":"After a great deal of success in the Hermes conflict, she gained the position of a senior officer at a young age."},{"spoiler":false,"text":"Originally a talented woman who showed outstanding results at the military academy, she has a high ability in hand-to-hand combat. Some members of the military have been trying to accuse her of even the slightest injustice."},{"spoiler":false,"text":"In addition, because of her brilliant skills, the Neo-Terrans group has feelings of strong hatred. While having a good mind and excellent operational ability, she has little knowledge about relationships."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c62542"},{"segments":[{"spoiler":false,"text":"ニュー・ソラル派に属する宇宙連邦軍大佐。"},{"spoiler":false,"text":"ヘルメス紛争で多大な戦果を上げたことにより、若くして上級将校の地位を得た。"},{"spoiler":false,"text":"もともと士官学校で抜群の成績を示していた秀才であり、白兵戦での能力も高い。"},{"spoiler":false,"text":"実際、ヘルメス紛争の際は自ら騎兵の奇襲部隊の先頭に立って働き、ニュー・ソラルの勝利に大きな貢献を果たした。"},{"spoiler":false,"text":"“英雄”としてニュー・ソラル派の市民や軍内部から尊敬と賞賛を受けながらも、慣例となっている些細な賄賂や不正も見過ごさずに告発することから、軍内部の一部の者達から煙たがられている。"},{"spoiler":false,"text":"またヘルメス紛争での華々しい活躍から、ネオ・テラーズ派の市民からは憎悪に近い感情を抱かれている。"},{"spoiler":false,"text":"優れた頭脳と卓越した作戦能力を持つ一方、性や男女関係に関わる知識はほとんどない。"},{"spoiler":false,"text":"それはユーリアが信仰する“ソラル・ギャラクシー”の潔癖な教義によるものである。"},{"spoiler":false,"text":"現在は昇進によりヘルメスを出て宇宙連邦軍司令部に所属。"},{"spoiler":false,"text":"木星周辺の宙域で中型戦艦の指揮官として任務にあたっている。"},{"spoiler":false,"text":"しかし任務により“特別教官”として物語舞台となる学園を訪れることになる。"}],"source":"egs","sourceCharacterId":"17587","sourceWorkId":"24138","spoiler":false},{"segments":[{"spoiler":false,"text":"ニュー・ソラル派に属する宇宙連邦軍 大佐。"},{"spoiler":false,"text":"ヘルメス紛争で多大な戦果を上げたことにより、若くして上級将校の地位を得た。"},{"spoiler":false,"text":"もともと士官学校で抜群の成績を示していた秀才であり、白兵戦での能力も高い。"},{"spoiler":false,"text":"些細な不正も見過ごさずに告発するため、軍の一部の者たちから煙たがられている。"},{"spoiler":false,"text":"またその華々しい活躍から、ネオ・テラーズ派からは憎悪に近い感情を抱かれている。"},{"spoiler":false,"text":"優れた頭脳と卓越した作戦能力を持つ一方、男女関係に関わる知識はほとんどない。"},{"spoiler":false,"text":"「指揮官の仕事は兵を死地に送ること。 その覚悟がない者に、一軍の将たる資格はありません」"}],"source":"bangumi","sourceCharacterId":"64969"}],"profileFacts":[{"label":"出身","source":"bangumi","sourceCharacterId":"64969","value":"ヘルメス"},{"label":"所属","source":"bangumi","sourceCharacterId":"64969","value":"ニュー・ソラル"},{"label":"年龄（本版本）","value":"28 岁","valueContext":null,"source":"egs","sourceCharacterId":"17587","sourceWorkId":"24138","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"17587","sourceWorkId":"24138","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"17587","sourceWorkId":"24138","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"17587","sourceWorkId":"24138","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"17587","sourceWorkId":"24138","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"17587","sourceWorkId":"24138","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c32b0aded3c6a65a5fc9ada73d0bd1f484118e609e5eb1a1c6b8e4b4b390cd0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53c00ae87d4250f097ef8dd1a065fce7389e06c35c6d34b98d3a1eb61d5a2c5a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤雅美","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:220322:64969:13773:1","source":"bangumi"}]},{"characterId":"char_c62543","characterName":"エリザ · パールマン","sourceIds":{"bangumi":[{"characterId":"64970","match":"exact-normalized-name-in-linked-work","subjectId":"220322"}],"egsCharacterIds":["17588"],"vndbCharacterId":"c62543"},"originalCharacterName":"エリザ · パールマン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"25"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"100"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"J"},"height":{"reviewState":"no-conflict","source":"vndb","value":"176"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Lieutenant of the Space Federation Army belonging to the New Solar faction."},{"spoiler":false,"text":"Boasted unrivaled strength in cavalry battles on the planet Hermes."},{"spoiler":false,"text":"She left Hermes with her promoted superior, Julia, and is currently working as an adjutant to a medium-sized battleship in the space around Jupiter."},{"spoiler":false,"text":"Although she is a soldier, she is actually a child of the Pearlman family, a famous family who owns multiple military companies."},{"spoiler":false,"text":"She is in loving marriage with an older male member of the unit, and now newly married for 3 months."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c62543"},{"segments":[{"spoiler":false,"text":"ニュー・ソラル派に属する宇宙連邦軍中尉。"},{"spoiler":false,"text":"かつてのヘルメス紛争の際、ユーリアの部下として奇襲作戦に参加した下士官。"},{"spoiler":false,"text":"惑星ヘルメスでの特殊な騎兵戦闘において無類の強さを誇った。"},{"spoiler":false,"text":"昇進した上官のユーリアに伴ってヘルメスを離れ、現在は木星周辺宙域にて中型戦艦の副官として勤務している。"},{"spoiler":false,"text":"見た目はヤンキー風のいかにも軍人らしいタフな美女。"},{"spoiler":false,"text":"しかしじつは太陽系全域で複数の軍事企業を所有する名家・パールマン家の子女。"},{"spoiler":false,"text":"代々政治家や財界人を輩出している家柄でありながら自ら志願して兵士となる。"},{"spoiler":false,"text":"ヘルメス紛争時にユーリアと知り合い、その激戦の中で深い信頼と絆を結ぶ。"},{"spoiler":false,"text":"体育会系らしい快活な性格から、仲間内や部隊内での人気は非常に高い。"},{"spoiler":false,"text":"部隊内の２つ年上の男性隊員と恋愛結婚をして、現在は新婚三ヶ月。"},{"spoiler":false,"text":"法律上の姓はバロー（Barrault）に変わっているが軍隊仕事の便宜上パールマン姓を名乗っている。"},{"spoiler":false,"text":"毎日メールは欠かさない、写真を持ち歩くなど、熱々ぶりを周囲に見せ付けている。"},{"spoiler":false,"text":"騎乗兵器スレイプニルの天才的な乗り手であるだけでなく、剣術と軍隊格闘の名手。"},{"spoiler":false,"text":"特に“電磁円月刀”を装備した白兵戦では１００人を相手にしても勝利するほどの腕前。"}],"source":"egs","sourceCharacterId":"17588","sourceWorkId":"24138","spoiler":false},{"segments":[{"spoiler":false,"text":"ニュー・ソラル派に属する宇宙連邦軍中尉。"},{"spoiler":false,"text":"惑星ヘルメスでの特殊な騎兵戦闘において無類の強さを誇った。"},{"spoiler":false,"text":"昇進した上官のユーリアに伴ってヘルメスを離れ、現在は木星周辺宙域にて中型戦艦の副官として勤務している。"},{"spoiler":false,"text":"いかにもな軍人だが、実は複数の軍事企業を所有する名家・パールマン家の子女。"},{"spoiler":false,"text":"部隊内の年上の男性隊員と恋愛結婚をして、現在は熱々の新婚3ヵ月。"},{"spoiler":false,"text":"「あ～あ、情けねぇなぁ。 ほら、あたしに任せてみなって！」"}],"source":"bangumi","sourceCharacterId":"64970"}],"profileFacts":[{"label":"出身","source":"bangumi","sourceCharacterId":"64970","value":"ヘルメス"},{"label":"所属","source":"bangumi","sourceCharacterId":"64970","value":"ニュー・ソラル"},{"label":"年龄（本版本）","value":"25 岁","valueContext":null,"source":"egs","sourceCharacterId":"17588","sourceWorkId":"24138","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"100 cm","valueContext":null,"source":"egs","sourceCharacterId":"17588","sourceWorkId":"24138","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"j","valueContext":null,"source":"egs","sourceCharacterId":"17588","sourceWorkId":"24138","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"176 cm","valueContext":null,"source":"egs","sourceCharacterId":"17588","sourceWorkId":"24138","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"17588","sourceWorkId":"24138","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"17588","sourceWorkId":"24138","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f138b147252f0a2c6111795a108499b831eb07143e25a59fba3ae7951276eea1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82390b3c21acc4590c018b92faa67c3e8a70a56524a8fe5044951b6f3538c43c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤原由林","creatorId":"vndb:s992","sourcePersonId":"vndb:s992","canonicalEntityId":"vndb:s992","name":"藤原 由林","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:220322:64970:25037:1","source":"bangumi"}]},{"characterId":"char_vndb_c62544","characterName":"アルベルト · パイン","sourceIds":{"vndbCharacterId":"c62544"},"originalCharacterName":"アルベルト · パイン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main character. Second-year student at Carlson Academy."},{"spoiler":false,"text":"He is the president of the Student Council, has excellent grades and is highly trusted by teachers and students. However, his true identity is the orphan of the Neo-Terran faction who was defeated in the Hermes conflict."},{"spoiler":false,"text":"On the surface, he is sociable, cheerful, friendly and loved by everyone."},{"spoiler":false,"text":"However, on the inside, he is a ruthless conspirator who use any means to reach his goal. He has strong action and leadership, and has charismatic control within the school."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c62544"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4fdaf2ce2245f5ad487ad78ec121e0d3d09968bd3e6a84b6e6a44bddd4a4ee84.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/9262640ed072e5b63780e305f502bf319006e62427614b20cbc1d6a24b1e1dca.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1412","sourceCompanyId":"egs:brand:1586","canonicalEntityId":"vndb:p1412","name":"ANIME LiLiTH","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:24138:1586","source":"egs"},{"companyId":"vndb:p20416","sourceCompanyId":"vndb:p20416","canonicalEntityId":"vndb:p20416","name":"傲月","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-pro