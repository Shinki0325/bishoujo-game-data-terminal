{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"3829","model":{"presentationWorkId":"vndb:v9853","staff":{"artwork":[{"creditedName":"江森美沙樹(えもりん)","creatorId":"vndb:s3630","sourcePersonId":"egs:creator:732","canonicalEntityId":"vndb:s3630","name":"江森美沙樹(えもりん)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:11667","source":"egs"},{"creditedName":"七尾奈留(九尾、奈留)","creatorId":"egs:creator:13","sourcePersonId":"egs:creator:13","canonicalEntityId":"egs:creator:13","name":"七尾奈留(九尾、奈留)","roleCode":"artwork","roleLabel":"原画","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:5868","source":"egs"},{"creditedName":"七尾 奈留","creatorId":"vndb:s1102","sourcePersonId":"vndb:s1102","canonicalEntityId":"vndb:s1102","name":"七尾 奈留","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:85370","source":"vndb"},{"creditedName":"倉嶋 丈康","creatorId":"vndb:s1851","sourcePersonId":"vndb:s1851","canonicalEntityId":"vndb:s1851","name":"倉嶋 丈康","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:85373","source":"vndb"},{"creditedName":"魚","creatorId":"vndb:s1863","sourcePersonId":"vndb:s1863","canonicalEntityId":"vndb:s1863","name":"魚","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:85374","source":"vndb"},{"creditedName":"ちこたむ","creatorId":"vndb:s1967","sourcePersonId":"vndb:s1967","canonicalEntityId":"vndb:s1967","name":"ちこたむ","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:85375","source":"vndb"},{"creditedName":"FC-G株式会社","creatorId":"vndb:s6418","sourcePersonId":"vndb:s6418","canonicalEntityId":"vndb:s6418","name":"FC-G株式会社","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:85378","source":"vndb"}],"scenario":[{"creditedName":"宮村優","creatorId":"vndb:s973","sourcePersonId":"egs:creator:567","canonicalEntityId":"vndb:s973","name":"宮村優","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5871","source":"egs"},{"creditedName":"田中 タクヤ","creatorId":"vndb:s1969","sourcePersonId":"vndb:s1969","canonicalEntityId":"vndb:s1969","name":"田中 タクヤ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:85376","source":"vndb"}],"music":[{"creditedName":"藤間仁","creatorId":"vndb:s1710","sourcePersonId":"egs:creator:3947","canonicalEntityId":"vndb:s1710","name":"藤間仁","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:301057","source":"egs"},{"creditedName":"上松範康","creatorId":"vndb:s2311","sourcePersonId":"egs:creator:18829","canonicalEntityId":"vndb:s2311","name":"上松範康","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:301058","source":"egs"},{"creditedName":"菊田大介","creatorId":"vndb:s1281","sourcePersonId":"egs:creator:18890","canonicalEntityId":"vndb:s1281","name":"菊田大介","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:301059","source":"egs"},{"creditedName":"Elements Garden","creatorId":"vndb:s557","sourcePersonId":"egs:creator:2307","canonicalEntityId":"vndb:s557","name":"Elements Garden","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:301060","source":"egs"}],"other":[{"creditedName":"宮村 優","creatorId":"vndb:s973","sourcePersonId":"vndb:s973","canonicalEntityId":"vndb:s973","name":"宮村 優","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:85369","source":"vndb"}]},"cast":[{"characterId":"char_c10594","characterName":"杉原 紫衣","sourceIds":{"bangumi":[{"characterId":"67051","match":"exact-normalized-name-in-linked-work","subjectId":"18255"}],"egsCharacterIds":["25201"],"vndbCharacterId":"c10594"},"originalCharacterName":"杉原 紫衣","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"23"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"604"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is Kana’s editor and is constantly pressuring her to finish within writing deadlines. She is strict but understanding of others. She is also a college friend of Kiri and gives her advice on love and how to approach Hiroki."}],"source":"vndb","sourceCharacterId":"c10594"},{"segments":[{"spoiler":false,"text":"“那珂野際（萩野可奈）”の担当編集者。"},{"spoiler":false,"text":"白英社の編集者でティーンズ向け小説誌「ロジウム」編集部の所属。"},{"spoiler":false,"text":"「ロジウム」は、過去に可奈が応募しデビューした小説誌で、可奈の作品を掲載している雑誌。"},{"spoiler":false,"text":"察しが良く、目端も利くため、編集部内では“やり手”と目されている。"},{"spoiler":false,"text":"なんとかして可奈を一人前の作家にしようと躍起になっている。"},{"spoiler":false,"text":"髪型はショート、目はツリ目がちで鋭い顔立ち。"},{"spoiler":false,"text":"スーツをビシッと着こなしている姿は“杉原女史”という形容がピッタリで、その性格も自信家で堅物。"}],"source":"egs","sourceCharacterId":"25201","sourceWorkId":"7977","spoiler":false},{"segments":[{"spoiler":false,"text":"準ヒロイン。出版社「白英社」の第三編集部（ティーンズ向け小説誌『ロジウム』編集部）勤務で、可奈の担当編集者。"},{"spoiler":false,"text":"理屈屋でもあり、不条理なことを嫌う。常に自信に満ち溢れている。酒癖が悪い。可奈には「鬼編集」と思われるほど厳しく接するが、彼女としては可奈の実力を大きく認め、自分が厳しく接したことをバネにして成長してくれることを期待している。可奈に対して庇い立てをする浩樹に対しては好意的ではない。"}],"source":"bangumi","sourceCharacterId":"67051"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb09e48eb715f525a5590c7b2ef49c2e4e913f9eacc863fe129a74e7e2f7289e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/1092d3845b2622fccfe9edcdc8cd7cd8e910eb9812700af342a9bf6e102348e8.webp","width":200,"height":200,"source":"static-detail"},"actors":[{"creditedName":"春野 かえる","creatorId":"vndb:s1014","sourcePersonId":"vndb:s1014","canonicalEntityId":"vndb:s1014","name":"鈴木 菜穂子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45190","source":"vndb"}]},{"characterId":"char_c5931","characterName":"桔梗 霧","sourceIds":{"bangumi":[{"characterId":"67046","match":"exact-normalized-name-in-linked-work","subjectId":"18255"}],"egsCharacterIds":["25199"],"vndbCharacterId":"c5931"},"originalCharacterName":"桔梗 霧","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"729"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the childhood friend of Hiroki and Yanagi, knowing them both since kindergarten. Near the beginning of the story, she is the new Physical Education teacher at Nadeshiko Academy, the same Academy that Hiroki works at."}],"source":"vndb","sourceCharacterId":"c5931"},{"segments":[{"spoiler":false,"text":"主人公の幼稚園からの幼馴染。"},{"spoiler":false,"text":"主人公に高校時代告白した経緯を持つが、主人公はその告白を断り、以降主人公が地元を出て美術大に入学以来疎遠状態であった。しかし、撫子の体育教師に欠員が出て、赴任してきたことにより主人公と再会を果たす。"},{"spoiler":false,"text":"姐御肌で喧嘩っ早いが、見かけの大雑把さとは裏腹に家事全般をこなし、料理は特に得意。"}],"source":"egs","sourceCharacterId":"25199","sourceWorkId":"7977","spoiler":false},{"segments":[{"spoiler":false,"text":"浩樹の幼稚園からの幼馴染。高校まではずっと同じ学校に通っていた。高校時代に浩樹に告白するも玉砕。浩樹が東京へ上京して以降、5年間音信不通となっていた。だが、撫子学園に体育教師の欠員がでたことで赴任し、浩樹と再会。散々文句を言ったが、過去のことは水に流し以前の関係に戻している。以後、浩樹とは学園内でも公私を付けずに友人感覚で接することが多いが、時折、心の中では未だに浩樹に対する未練を残している節を見せる事がある。実は浩樹が絵の道に挫折する決定的なきっかけとなった事件に図らずも関わっていたが本人にその自覚はなく、浩樹が画家となる夢を捨ててしまった事も再会するまで知らなかった。"},{"spoiler":false,"text":"姉御肌のさっぱりとした性格。浩樹に対しては口より手が出ることも多いが、誰よりも人のことを気を遣う優しい女性。学生時代はバスケットボール部所属、高校時代はインターハイ出場経験をもっている。高校卒業後は地元北海道の体育大学に進学している。赴任当日から女子バスケ部の顧問を任されており、指導するときは率先して指導を行っている。また、体育の授業では基礎体力をつけるためにハードな授業を行っているが、生徒に混じって運動をしている。また、家事全般、特に料理は得意としている。"},{"spoiler":false,"text":"彼女の前任者「哀川」は、『赤いCanvasシリーズ なでしこ 〜朱色のらせん〜』の主人公、哀川総司である。"}],"source":"bangumi","sourceCharacterId":"67046"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffb70ecb77504937347e9c38c86698b397cee04454283f9ecab85c48edad9c2a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f9481aa5cbc02c0787542ba468fa3d5a2d85787a8db8b4f08087ad4a33af0811.webp","width":200,"height":200,"source":"static-detail"},"actors":[{"creditedName":"澤 ゆり","creatorId":"vndb:s6344","sourcePersonId":"vndb:s6344","canonicalEntityId":"vndb:s6344","name":"澤 ゆり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45192","source":"vndb"}]},{"characterId":"char_c5933","characterName":"鷺ノ宮 紗綾","sourceIds":{"bangumi":[{"characterId":"5445","match":"exact-normalized-name-in-linked-work","subjectId":"18255"}],"egsCharacterIds":["25200"],"vndbCharacterId":"c5933"},"originalCharacterName":"鷺ノ宮 紗綾","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"817"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the acting superintendent at Nadeshiko Academy. This tall and purple-haired beauty has a well-meaning and caring personality but is surprisingly disliked by the rest of the administration at Nadeshiko Academy."}],"source":"vndb","sourceCharacterId":"c5933"},{"segments":[{"spoiler":false,"text":"現撫子学園の理事長鷺ノ宮藍の姉。"},{"spoiler":false,"text":"バイオリンのコンサート＆姉妹校との会議で不在の妹（理事長）に変わって、理事長代理を任せられている。ついでに長刀部も面倒見てあげている。"},{"spoiler":false,"text":"長刀の腕は、妹が足元にも及ばないほど超人的なもの。"},{"spoiler":false,"text":"毎日学園にいるわけではなく、会議のあるときと長刀部の特別コーチの時にのみ学園にやってくる。"}],"source":"egs","sourceCharacterId":"25200","sourceWorkId":"7977","spoiler":false},{"segments":[{"spoiler":false,"text":"撫子学園の理事長である鷺ノ宮藍の姉。世界的に有名なチェロソリスト。撫子学園の理事を務めていたが、バイオリンのコンサートと姉妹校の会議による海外出張で、多忙の妹の依頼により理事長代理になる。"},{"spoiler":false,"text":"おっとりとしており誰に対しても優しい女性。生徒達とも交流があり親しみやすく人気もある。かなりのシスコンであり、妹の話になると止まらなくなる。妹が足元にも及ばない程の長刀の達人でもあり、長刀部の特別コーチもしている。指導の時は、普段おっとりした態度とは裏腹に、圧倒的な威厳をみせている。趣味はドライブだが、無自覚のスピード狂であり、一度乗った人間は二度と乗りたくないと評されている。なお、自動車は国産には存在しないジャガーを乗り回している。"}],"source":"bangumi","sourceCharacterId":"5445"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f45cb11d59079ff323caf74ec731937d5b72a3ab4dcd22fc17949871499b367e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bcc8b730989baa7af9a6c55fd2b7b0a6407993a56c5e7b76251728053e76ec21.webp","width":180,"height":227,"source":"static-detail"},"actors":[{"creditedName":"夏野 向日葵","creatorId":"vndb:s855","sourcePersonId":"vndb:s855","canonicalEntityId":"vndb:s855","name":"瀬那 歩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45189","source":"vndb"}]},{"characterId":"char_c5934","characterName":"鳳仙 エリス","sourceIds":{"bangumi":[{"characterId":"5443","match":"exact-normalized-name-in-linked-work","subjectId":"18255"}],"egsCharacterIds":["25196"],"vndbCharacterId":"c5934"},"originalCharacterName":"鳳仙 エリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"927"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Elis is a freshman at Nadeshiko Academy. Her parents died in a tragic car accident and she was left in the foster care of her cousin, Kamikura Hiroki. Because of the accident, she was left traumatized and unable to tolerate the colour red—since it reminds her of blood—to the extent in which eating red colored food or using the colour red in her artwork can became very painful."}],"source":"vndb","sourceCharacterId":"c5934"},{"segments":[{"spoiler":false,"text":"主人公の従兄妹。日本人の父とフランス人の母を持つハーフ。"},{"spoiler":false,"text":"撫子学園に合格したことにより田舎から上京、同校の教師でもある主人公宅に居候。"},{"spoiler":false,"text":"明朗快活で、家庭的な女の子。"},{"spoiler":false,"text":"昔から主人公に懐いており、ブラコン気味な部分を持ち合わせている。"},{"spoiler":false,"text":"絵画の特待生で油絵も水彩もこなすことが出来、そのセンスは誰しも認めるところである。"}],"source":"egs","sourceCharacterId":"25196","sourceWorkId":"7977","spoiler":false},{"segments":[{"spoiler":false,"text":"浩樹の従妹。撫子学園の1年生。日本人の父親とフランス人の母親のハーフで、母親譲りの金髪碧眼美少女。絵画の特待生として入学しており、浩樹や麻巳などが認めるほど絵画に関しては天才的技術を持っている。北海道より上京した際に浩樹の家に居候している。浩樹のことを「お兄ちゃん」と呼び、浩樹からは学園内では「上倉先生」と呼ぶように注意を受けているが直そうとしない。"},{"spoiler":false,"text":"天真爛漫な表情をもち明るく元気な性格。絵に対する姿勢は真剣そのもので、絵を描くときは周りが見えないほど集中している。老若男女問わず告白されることが日常となっているが、重度のブラコンであり、浩樹以外の人間には恋愛感情は抱いておらず告白も全て断っている。現在も浩樹に対してアプローチしているが、一度も異性として受け止めてくれないため進展していない。また、浩樹が他の女のこと仲良くしているとやきもちを焼くことが多く、特に霧のことをライバル視している。"},{"spoiler":false,"text":"浩樹の家では家事を分担して行っているが、料理は非常に下手であり、調理実習でカレーを作った際には食べた人間を全員保健室送りにしたという逸話がある（漫画版では殺人級）。しかし、料理が下手だと自覚しておらず、浩樹のために料理を作りたがっているが、浩樹から理由を付けられて止められている。また、自他共に認めるほど寝起きが悪く、浩樹から叩き起こされることが日常となっている。"},{"spoiler":false,"text":"幼い頃に両親を交通事故で亡くし、自身もまた深い傷を負い心を閉ざしていた過去を持つ。浩樹の絵を通じた看病により回復して、彼女もまた絵を本格的に学び始めるきっかけとなった。そのため、浩樹のことを今でも師匠だと思っている。しかし、血まみれの両親の遺体を目にしたことがトラウマになっており赤色を嫌っている。そのため、絵画にも赤い絵の具を一切使われていない。また、自動車事故だったため、自動車に乗ることも嫌がり、浩樹が自動車に乗ることを禁止している。"}],"source":"bangumi","sourceCharacterId":"5443"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92c83c5e9ca68e08cee09f52984a9f468d38981b2aeda03ff3b4b539be4e82c8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed44417e68ec7edf9cdaeccec0d67b70efb3a09d3f63f3b06124e8ec5d2f5c30.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中家 菜穂","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45188","source":"vndb"}]},{"characterId":"char_c5936","characterName":"萩野 可奈","sourceIds":{"bangumi":[{"characterId":"67048","match":"exact-normalized-name-in-linked-work","subjectId":"18255"}],"egsCharacterIds":["25197"],"vndbCharacterId":"c5936"},"originalCharacterName":"萩野 可奈","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"426"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Despite her short stature, Kana is actually a sophomore at Nadeshiko Academy. She is a novelist that focuses mainly on romance stories. To keep her identity hidden, she writes under the pen name of Naka Nogiwa (那珂 野際). She is very interested in the relationships of the other characters in the series so that she can generate ideas for her novels."}],"source":"vndb","sourceCharacterId":"c5936"},{"segments":[{"spoiler":false,"text":"撫子学園の二年生。"},{"spoiler":false,"text":"目はクリクリしていて可愛らしく、いかにも元気で明るいといった、子犬のような女の子。"},{"spoiler":false,"text":"その幼い顔立ちと体型から、よく小学生に間違われしまう。"},{"spoiler":false,"text":"性格も子供っぽく、好奇心旺盛。"},{"spoiler":false,"text":"実はやり手の編集者が付くような売れっ子のプロ作家で、那珂野際のペンネームで活躍中。"}],"source":"egs","sourceCharacterId":"25197","sourceWorkId":"7977","spoiler":false},{"segments":[{"spoiler":false,"text":"いつも明るく元気でハイテンションな女の子。撫子学園2年生。身長や体格が幼児体型が特徴的で、本人も気にしている。美術の授業を選択しているため浩樹とも顔なじみ。浩樹には一切の敬語を使わないが、非常に懐いており軽口を叩く仲となっている。"},{"spoiler":false,"text":"売れっ子の恋愛小説家であり、ペンネームは「那珂野際（なか のぎわ）」。代表作に「どす恋ちゃんこLove」「うっちゃれ告白土俵際」などがある。彼女が小説家である事実を親しい人にしか話していない。浩樹は彼女が小説家だという事を知っており、小説を書いたら浩樹に原稿を持ってきて批評してもらうことが日常となっている。なお、小説の時だけはふざけないで真面目に取り組んでいる。"}],"source":"bangumi","sourceCharacterId":"67048"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/529b4834cf004edc4b418772363dfd7e694ad4ded32f5c8d55b237c53009327f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a8e1fd95ffed7bafc05c10181d0804fd9ba645d2d2607a413c091fe74d13e08.webp","width":200,"height":200,"source":"static-detail"},"actors":[{"creditedName":"幡宮 かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45187","source":"vndb"}]},{"characterId":"char_c5939","characterName":"美咲 菫","sourceIds":{"bangumi":[{"characterId":"5444","match":"exact-normalized-name-in-linked-work","subjectId":"18255"}],"egsCharacterIds":["25198"],"vndbCharacterId":"c5939"},"originalCharacterName":"美咲 菫","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1103"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Youngest daughter of a family of great musicians. She is always compared to her parents and older sister and thus has high expectations. She feels a lot of pressure and anxiety because of this. She cares deeply for Elis. She is part of the choir and has a soprano voice."}],"source":"vndb","sourceCharacterId":"c5939"},{"segments":[{"spoiler":false,"text":"撫子学園の三年生。前作『Canvas』のヒロイン・美咲彩の妹。"},{"spoiler":false,"text":"絵の上手い姉とは違い歌が上手く、「撫子の歌姫」と呼ばれていて人気を集めている。"},{"spoiler":false,"text":"性格は物静かで、少々引っ込み思案。"},{"spoiler":false,"text":"菫や彩の父親は、世界的に有名な画家であり、姉の彩は撫子学園を卒業後、新進の画家として世界から注目されている。"}],"source":"egs","sourceCharacterId":"25198","sourceWorkId":"7977","spoiler":false},{"segments":[{"spoiler":false,"text":"前作のヒロインである美咲彩の妹。撫子学園3年生。父親と姉は世界的に有名な画家、母は有名なフルート奏者と芸術一家で育つ。「撫子の歌姫」と評されるほどの歌声を持ち、合唱部に所属している。クリスマス公演に向けて、放課後になると屋上で歌の練習をしている。美術を選択しているため浩樹のことを知っているが、浩樹は彼女のことを認識していなかった。"},{"spoiler":false,"text":"物静かな性格で、やや引っ込み思案。だが、人前に立ったり会話をすることが苦手なだけであり、根は素直で明るい。そのため、はっきり物言いができずにうろたえる事も多い。歌の練習するのも人前で上手く歌えないからであり、合唱部で練習しないのも同様の理由である。浩樹に対しても初めは社交辞令程度に接しないが、馴れて来ると結構失礼な物言いを言うようになる。学園の屋上以外にも、近所の公園で練習していることもある。実は高所恐怖症。勉強は好きでないらしく、成績も普通程度。"},{"spoiler":false,"text":"為我井徹の小説版の小説ではゲームより人懐っこい性格である。またエリス同様クラス内や合唱部でいじめられている描写がある。"}],"source":"bangumi","sourceCharacterId":"5444"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f96765e6b12f6f653366d141980305b41075e617ab6d957a0e970c84b0c48c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da459efe966cb935687b27ff07bae83162b729a648b05cf9985e727bb1bf3365.webp","width":180,"height":227,"source":"static-detail"},"actors":[{"creditedName":"木村 美佐","creatorId":"vndb:s6345","sourcePersonId":"vndb:s6345","canonicalEntityId":"vndb:s6345","name":"木村 美佐","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45193","source":"vndb"}]},{"characterId":"char_vndb_c10595","characterName":"柳 慎一郎","sourceIds":{"vndbCharacterId":"c10595"},"originalCharacterName":"柳 慎一郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"24"},"birthday":{"reviewState":"source-only","source":"vndb","value":"526"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"177"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Childhood friend of Hiroki and Kiri. His relationship with Hiroki went sour after Yanagi had stolen Hiroki’s composition of Kiri and then went on to win a national award with the painting. They do make up with each other later thanks to Kiri and Saya."},{"spoiler":false,"text":"He has a crush on Kiri and confesses to her when they are adults but Kiri turns him down. He then supports Kiri into confessing her feelings for Hiroki."}],"source":"vndb","sourceCharacterId":"c10595"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/352f2f63527b904335feec6e394fdaaac6a82567078536bcf1c43e8a65638123.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5ceb9730507c214041c88ef7dd8e401827021807732e178db8659b9222c37bdf.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:66","sourceCompanyId":"egs:brand:66","canonicalEntityId":"egs:brand:66","name":"F&C","roleCodes":["brand"],"identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-brand:3829:66","source":"egs"},{"companyId":"vndb:p80","sourceCompanyId":"vndb:p80","canonicalEntityId":"vndb:p80","name":"F&C Co., Ltd.","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:23443:v9853","source":"vndb"},{"companyId":"vndb:p5358","sourceCompanyId":"vndb:p5358","canonicalEntityId":"vndb:p5358","name":"F&C・FC01","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:23444:v9853","source":"vndb"},{"companyId":"vndb:p80","sourceCompanyId":"vndb:p80","canonicalEntityId":"vndb:p80","name":"F&C Co., Ltd.","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:3199:v9853","source":"vndb"},{"companyId":"vndb:p1053","sourceCompanyId":"vndb:p1053","canonicalEntityId":"vndb:p1053","name":"株式会社シャルラクプラス","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:3200:v9853","source":"vndb"},{"companyId":"vndb:p5358","sourceCompanyId":"vndb:p5358","canonicalEntityId":"vndb:p5358","name":"F&C・FC01","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:3201:v9853","source":"vndb"},{"companyId":"vndb:p80","sourceCompanyId":"vndb:p80","canonicalEntityId":"vndb:p80","name":"F&C Co., Ltd.","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:36833:v9853","source":"vndb"},{"companyId":"vndb:p5358","sourceCompanyId":"vndb:p5358","canonicalEntityId":"vndb:p5358","name":"F&C・FC01","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:36834:v9853","source":"vndb"},{"companyId":"vndb:p80","sourceCompanyId":"vndb:p80","canonicalEntityId":"vndb:p80","name":"F&C Co., Ltd.","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:49413:v9853","source":"vndb"},{"companyId":"vndb:p5358","sourceCompanyId":"vndb:p5358","canonicalEntityId":"vndb:p5358","name":"F&C・FC01","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:49414:v9853","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
