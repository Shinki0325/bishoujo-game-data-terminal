e":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Liked food: Bagels"},{"spoiler":false,"text":"Disliked food: Tomatoes, carrots, bell peppers"},{"spoiler":false,"text":"A girl in the same year as the main character at his school. She’s a blonde girl who’s half-American from her father’s side. Both of her parents have already passed away, and she currently lives alone at her maternal grandmother’s house."},{"spoiler":false,"text":"She has high IQ, and is particularly skilled in regards to computers and network management. She doesn’t have much in the way of social ability due to being a shut-in that plays video games all day, and will often either say cringey things that a middle-schooler would say or speak like a highly intellectual adult."},{"spoiler":false,"text":"She’s not one to really admit it, but she’s actually quite lonely, and longs for a warm family."},{"spoiler":true,"text":"Her biological father is Paul Grey, founder and CEO of Citron company."}],"source":"vndb","sourceCharacterId":"c77878"},{"segments":[{"spoiler":false,"text":"主人公と同じ学校に通う同級生。"},{"spoiler":false,"text":"日本人の母とアメリカ人の父を持つ金髪のハーフ。"},{"spoiler":false,"text":"両親はすでに他界しており、母方の祖母の実家で一人暮らし。"},{"spoiler":false,"text":"高いＩＱを持ち、特にコンピュータ、ネットワーク関連に強い。"},{"spoiler":false,"text":"引きこもりでゲーム三昧のため対人能力が低く、中二的なイタイ言動や大人ぶった理知的なしゃべり方をすることも。"},{"spoiler":false,"text":"なかなか素直になれないが、実は寂しがり屋で、温かい家族に憧れている。"}],"source":"egs","sourceCharacterId":"21099","sourceWorkId":"27525","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同じ学校に通う同級生。"},{"spoiler":false,"text":"日本人の母とアメリカ人の父を持った金髪のハーフ。"},{"spoiler":false,"text":"両親はすでに他界しており、"},{"spoiler":false,"text":"母方の祖母の実家で一人暮らし。"},{"spoiler":false,"text":"高いＩＱを持ち、特にコンピュータ、ネットワーク関連に強い。"},{"spoiler":false,"text":"引きこもりでゲーム三味のため対人能力が低く、"},{"spoiler":false,"text":"中二的なイタイ言動や大人ぶった理知的な"},{"spoiler":false,"text":"しゃべり方をすることも。"},{"spoiler":false,"text":"なかなか素直になれないが、"},{"spoiler":false,"text":"実は寂しがり屋で、温かい家族に憧れている。"}],"source":"bangumi","sourceCharacterId":"68741"}],"profileFacts":[{"label":"好きな食べ物","source":"bangumi","sourceCharacterId":"68741","value":"べーグル"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0d2395c70fc66d57b39429e90a5656510dcd52f25775e0d38d59668c53c028c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2dc1e45e1756417f3cc4580ab97bac6a451f11e8469c033c29e7bdda0152c8ff.webp","width":84,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原舞","creatorId":"vndb:s985","sourcePersonId":"vndb:s985","canonicalEntityId":"vndb:s985","name":"石原 舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:290301:68741:13372:1","source":"bangumi"}]},{"characterId":"char_c77879","characterName":"岬 栞菜","sourceIds":{"bangumi":[{"characterId":"68750","match":"exact-normalized-name-in-linked-work","subjectId":"253621"}],"egsCharacterIds":["21101"],"vndbCharacterId":"c77879"},"originalCharacterName":"岬 栞菜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"25"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"701"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Liked food: Any kind of fish, like sashimi or soy-sauce simmered fish"},{"spoiler":false,"text":"Disliked food: Strong can shochu highballs"},{"spoiler":false,"text":"A professional shoujo manga author from Hakodate. She’s a comfy, happy, and fluffy girl who’s a bit of an airhead. She grew up going to all-girls’ schools, so she can’t speak with men particularly well, and isn’t very assertive."},{"spoiler":false,"text":"She’s got a girly, imaginative way of thinking, and often ends up embarrassed from misunderstanding things."},{"spoiler":false,"text":"She hasn’t had a popular series since her debut, and she’s troubled over how she only seems to get to do one-shots or short series."}],"source":"vndb","sourceCharacterId":"c77879"},{"segments":[{"spoiler":false,"text":"函館出身のプロ少女漫画家。"},{"spoiler":false,"text":"ちょっぴり天然でほんわか明るく、ゆるふわな女の子。"},{"spoiler":false,"text":"ずっと女子校育ちだったため、男性とは緊張して上手く話せず、自己主張も苦手。"},{"spoiler":false,"text":"夢見がちの乙女脳で、よく勘違いしては恥ずかしい思いをしている。"},{"spoiler":false,"text":"デビュー作以降ヒット作に恵まれず、読み切りや短期連載ばかりなのが悩みの種。"}],"source":"egs","sourceCharacterId":"21101","sourceWorkId":"27525","spoiler":false},{"segments":[{"spoiler":false,"text":"函館出身のプロ少女漫画家。"},{"spoiler":false,"text":"ちょっぴり天然でほんわか明るく、ゆるふわな女の子。"},{"spoiler":false,"text":"ずっと女子校育ちだっったため、"},{"spoiler":false,"text":"男性とは緊張して上手く話せず、自己主張も苦手。"},{"spoiler":false,"text":"夢見がちの乙女脳で、"},{"spoiler":false,"text":"よく勘違いしては恥ずかしい思いをしている。"},{"spoiler":false,"text":"デビュー作以降ヒット作に恵まれず、"},{"spoiler":false,"text":"読み切りや短期連載ばかりなのが悩みの種。"}],"source":"bangumi","sourceCharacterId":"68750"}],"profileFacts":[{"label":"好きな食べ物","source":"bangumi","sourceCharacterId":"68750","value":"刺身や煮付けなど魚介類全般"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/032a5bbdd29108040169f83f5902b495d20ffb83bd39e7ac095364b886abea1c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec69d6cf7b2dd8b0707a904b2383889552bc4d4d48f8c7505976577a618619b3.webp","width":110,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴谷 まや","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:82432","source":"vndb"}]},{"characterId":"char_c77880","characterName":"倉橋 聖衣良","sourceIds":{"bangumi":[{"characterId":"68742","match":"exact-normalized-name-in-linked-work","subjectId":"253621"}],"egsCharacterIds":["21100"],"vndbCharacterId":"c77880"},"originalCharacterName":"倉橋 聖衣良","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"12"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"331"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"height":{"reviewState":"no-conflict","source":"vndb","value":"142"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"B/W/H: She’s never tried measuring"},{"spoiler":false,"text":"Liked food: Coffee (sweet)"},{"spoiler":false,"text":"Disliked food: Black coffee"},{"spoiler":false,"text":"Seira who appears in the School Arc."},{"spoiler":false,"text":"Kanata's distant relative. Her father died sometime before the main story, and she currently lives with just her mother. Her thought process is mature for her age, and is knowledgeable and that’s about it. She yearns to be in love and tries to drag the main character around all over the place, calling those outings dates."}],