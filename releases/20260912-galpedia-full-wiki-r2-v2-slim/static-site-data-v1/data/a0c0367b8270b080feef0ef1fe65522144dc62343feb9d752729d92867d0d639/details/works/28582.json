egs","sourceCharacterId":"21102","sourceWorkId":"27525","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同じ出版社に勤める敏腕編集長。"},{"spoiler":false,"text":"花形である『小説よつば』をはじめ、"},{"spoiler":false,"text":"多数の人気小説の刊行に携わる。"},{"spoiler":false,"text":"スタイル抜群、大人の魅力溢れる女性。"},{"spoiler":false,"text":"人当たりもよく、憂いを帯びた"},{"spoiler":false,"text":"にこやかな笑顔が特徴的。"},{"spoiler":false,"text":"仕事に打ち込む余り、気が付けば結婚適齢期を過ぎ、"},{"spoiler":false,"text":"母親からのプレッシャーに悩まされている。"}],"source":"bangumi","sourceCharacterId":"68751"}],"profileFacts":[{"label":"好きな食べ物","source":"bangumi","sourceCharacterId":"68751","value":"ハイボール"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/032c80997631306853202dd8c4992a10d730c743bdbf4d6cb4037b6929928b26.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d2c8de3c20c8e676ada0223cb05f5eac4d2896a1a07b340cd6742681d6a4bb1.webp","width":70,"height":256,"source":"static-detail"},"actors":[{"creditedName":"猫屋敷 舞","creatorId":"vndb:s14873","sourcePersonId":"vndb:s14873","canonicalEntityId":"vndb:s14873","name":"猫屋敷舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:82433","source":"vndb"}]},{"characterId":"char_c77882","characterName":"月ヶ洞 きらり","sourceIds":{"bangumi":[{"characterId":"68752","match":"exact-normalized-name-in-linked-work","subjectId":"253621"}],"egsCharacterIds":["21103"],"vndbCharacterId":"c77882"},"originalCharacterName":"月ヶ洞 きらり","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"29"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"505"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Liked food: Sweet-glazed rice crackers"},{"spoiler":false,"text":"Disliked food: Parsley"},{"spoiler":false,"text":"A beautiful female author who made her debut as a novelist when she was a university student."},{"spoiler":false,"text":"Her maiden work, \"Processor,\" won the Novel Yotsuba Newcomer Novelist Award."},{"spoiler":false,"text":"It took the world by storm and has been made into a film, and her works after that have also all been hits."},{"spoiler":false,"text":"Selfish and uninhibited. She has a carefree, does-whatever-she-pleases personality."},{"spoiler":false,"text":"She makes a point to never sleep with the same man twice."}],"source":"vndb","sourceCharacterId":"c77882"},{"segments":[{"spoiler":false,"text":"大学在学中に小説家デビューした美人作家。"},{"spoiler":false,"text":"処女作『プロセッサー』で小説よつば新人賞を受賞。"},{"spoiler":false,"text":"映画化されるなど一世を風靡し、その後も次々とヒット作を飛ばしている。"},{"spoiler":false,"text":"わがままかつ奔放、自由気ままな性格。"},{"spoiler":false,"text":"同じ男と二度寝ないことを信条としている。"}],"source":"egs","sourceCharacterId":"21103","sourceWorkId":"27525","spoiler":false},{"segments":[{"spoiler":false,"text":"大学在学中に"},{"spoiler":false,"text":"小説家デビューした美人作家。"},{"spoiler":false,"text":"処女作『プロセッサー』で小説よつば新人賞を受賞。"},{"spoiler":false,"text":"映画化されるなど一世を風靡し、"},{"spoiler":false,"text":"その後も次々とヒット作を飛ばしている。"},{"spoiler":false,"text":"わがままかつ奔放、自由気ままな性格。"},{"spoiler":false,"text":"同じ男と二度寝ないことを信条としている。"}],"source":"bangumi","sourceCharacterId":"68752"}],"profileFacts":[{"label":"好きな食べ物","source":"bangumi","sourceCharacterId":"68752","value":"ぽたぽた焼き"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/te