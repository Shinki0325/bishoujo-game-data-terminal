wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/041275d2d07450ad4efd1ef31ab6421d145e14ab3cc6c30f4bfa069225f16b52.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6f676d77bed4c849d722c0dcddbe9003cd2102f3946721e48a976f6492ad093.webp","width":70,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤澤 梅太郎","creatorId":"vndb:s19552","sourcePersonId":"vndb:s19552","canonicalEntityId":"vndb:s19552","name":"藤澤 梅太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:82434","source":"vndb"}]},{"characterId":"char_c77884","characterName":"田島 賢斗","sourceIds":{"bangumi":[{"characterId":"68754","match":"exact-normalized-name-in-linked-work","subjectId":"253621"}],"egsCharacterIds":["21105"],"vndbCharacterId":"c77884"},"originalCharacterName":"田島 賢斗","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Kanata’s friends."},{"spoiler":false,"text":"He’s a hardcore gadgets-and-gizmos nerd whose father is an IT journalist."},{"spoiler":false,"text":"He’s proud of the scores of tech tools he has that have all been heavily customized to his own tastes, but they all have too many functions for him to be able to make use of them when he really needs to."}],"source":"vndb","sourceCharacterId":"c77884"},{"segments":[{"spoiler":false,"text":"主人公の友人。"},{"spoiler":false,"text":"ＩＴジャーナリストを父に持つ、重度のガジェットオタク。"},{"spoiler":false,"text":"自分専用にカスタマイズしまくった最新ＩＴ機器の数々が自慢だが、どれも機能過多で、いざというとき使いこなせない。"}],"source":"egs","sourceCharacterId":"21105","sourceWorkId":"27525","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の友人。"},{"spoiler":false,"text":"ＩＴジャーナリストを父に持つ、重度のガジェットオタク。"},{"spoiler":false,"text":"自分専用にカスタマイズしまくった最新ＩＴ機器の"},{"spoiler":false,"text":"数々が自慢だが、どれも機能過多で、"},{"spoiler":false,"text":"いざというと使いおなせない。"}],"source":"bangumi","sourceCharacterId":"68754"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5b4b4832cdfd4fd1a904beb2752d4f8949700a692e814940c0acf79c5440277.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31af4bf604a8f27a0e1111b89eb579c679a4af7679aaa42b67eb61dccfff88b5.webp","width":71,"height":256,"source":"static-detail"},"actors":[{"creditedName":"九財 翼","creatorId":"vndb:s19762","sourcePersonId":"vndb:s19762","canonicalEntityId":"vndb:s19762","name":"善財 達也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:82435","source":"vndb"}]},{"characterId":"char_vndb_c77885","characterName":"黒野 奏汰","sourceIds":{"vndbCharacterId":"c77885"},"originalCharacterName":"黒野 奏汰","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"School Arc:"},{"spoiler":false,"text":"The main character. A second-year high school student who’s in the literature club. He just wants to sit back and read books through school... is what he tells people, but he secretly wants to write a novel. He has lots that he’s written without telling anyone else, but he has yet to complete it. He works part-time at \"BIBLIO CAFE,\" a bookstore-cafe by the train station. He likes motorcycles, and just recently convinced his parents to let him buy one."},{"spoiler":false,"text":"After Arc:"},{"spoiler":false,"text":"Now 25 years old. A beginner editor working at the smallish publishing company, Yotsuba Publishing. He tried to apply for the newcomer novelist awards while continuing with creative writing during his university years, but after being faced with the limits of his own ability, chose to move on to the path of an editor. He’s in charge of \"Real Talk NOW,\" a weekly magazine aimed toward a blue-collar audience. He’s starting to lose zeal for his work because of the disparity between his expectations and reality, as well as the fact that he’s stuck in a rut for the novel he’s writing in his free time as a hobby."}],"source":"vndb","sourceCharacterId":"c77885"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1da0c86e7f7f81e1deacfeb3e980fee30b779febbe97e20d3f22e0db45cfa984.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0a06d9391cb79aa6cf3e764a673bb5ca586d8709cf177a6869b5dbab0c82a54.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c86906","characterName":"ベーグル大佐","sourceIds":{"vndbCharacterId":"c86906"},"originalCharacterName":"ベーグル大佐","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A high-level-learning AI that Rein developed. A low-key master who loves country music from Colorado, where he was born and raised. He's a cat-like... something... that has tons of 'back-story' given to him, with an eye-patch that seals the power of his evil eye-- when he removes it, his Nidhogg blood awakens."},{"spoiler":false,"text":"He's incredibly highly skilled, but these days he's just been Tsukiko's playmate, causing him to put himself down as a babysitter AI."}],"source":"vndb","sourceCharacterId":"c86906"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a50b323da610ec13f9ddfee3f24ec640b8a769bd46e17d54bbb067c28b70861a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/charact