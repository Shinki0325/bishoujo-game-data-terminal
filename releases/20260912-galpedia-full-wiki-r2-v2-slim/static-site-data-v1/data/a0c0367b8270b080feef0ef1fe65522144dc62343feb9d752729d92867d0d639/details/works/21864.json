scriptions":[{"segments":[{"spoiler":false,"text":"希ノ森学園２年生。"},{"spoiler":false,"text":"生まれた日も、初めてオムツが取れた日も主人公と同じな幼馴染み。"},{"spoiler":false,"text":"面倒見がよく、少し抜けた所のある主人公の側にいつもいる。"},{"spoiler":false,"text":"映画を作りたいという主人公と同じ映画研究会に入っているが、それほど映画については詳しくないらしい。"},{"spoiler":false,"text":"好きな映画のジャンルはファンタジー。"}],"source":"egs","sourceCharacterId":"7298","sourceWorkId":"21864","spoiler":false},{"segments":[{"spoiler":false,"text":"生まれた日も、初めてオムツが取れた日も主人公と同じな幼なじみ。"},{"spoiler":false,"text":"面倒見がよく、少し抜けたところのある主人公の側にいつもいる。"},{"spoiler":false,"text":"主人公と同じ映画研究会に入っているが、それほど映画については詳しくないらしい。"},{"spoiler":false,"text":"「あっ！ 寝癖付いてるよ？　も～私がいないとダメなんだから……」"}],"source":"bangumi","sourceCharacterId":"42781"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"42781","value":"希ノ森学園"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/571191c4b2e567ca1ca5ff16957a2b53367b2219437c67f5e29e5c790af49e03.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76146606a783afd9b2a52aaa8903bd347910cc2d59f8432631bdcc9d07e3e929.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:140659:42781:11646:1","source":"bangumi"}]},{"characterId":"char_c37215","characterName":"アイリ","sourceIds":{"bangumi":[{"characterId":"42783","match":"exact-normalized-name-in-linked-work","subjectId":"140659"}],"egsCharacterIds":["7300"],"vndbCharacterId":"c37215"},"originalCharacterName":"アイリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"希ノ森学園１年生。"},{"spoiler":false,"text":"女優を目指しており、映画研究会の主演女優を務めている（つもり）"},{"spoiler":false,"text":"明るく元気、常にポジティブな性格だが、演技については誰よりも真剣に考えている。"},{"spoiler":false,"text":"好きな映画のジャンルは恐竜物。"}],"source":"egs","sourceCharacterId":"7300","sourceWorkId":"21864","spoiler":false},{"segments":[{"spoiler":false,"text":"女優を目指している後輩の女の子。"},{"spoiler":false,"text":"映画研究会の主演女優を務めている（つもり）。"},{"spoiler":false,"text":"明るく元気、常にポジティブな性格で、演技について誰よりも真剣に考えている。"},{"spoiler":false,"text":"「ほ～らっ！ いくぞ先輩！　手、絶対放さないでよね !?」"}],"source":"bangumi","sourceCharacterId":"42783"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"42783","value":"希ノ森学園"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5bfded7919ce3815fe17453137d8196cb9e0404dfa215180f643d2130e1ecff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/9654225e13a8744aba7436dd9e26a20bdb0b5617be5f1d222db20d5a69c17e1e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松山紗香","creatorId":"vndb:s904","sourcePersonId":"vndb:s904","canonicalEntityId":"vndb:s904","name":"松山 紗香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:140659:42783:10662:1","source":"bangumi"}]},{"characterId":"char_c37216","characterName":"ソラ","sourceIds":{"bangumi":[{"characterId":"42782","match":"exact-normalized-name-in-linked-work","subjectId":"140659"}],"egsCharacterIds":["7299"],"vndbCharacterId":"c37216"},"originalCharacterName":"ソラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identity