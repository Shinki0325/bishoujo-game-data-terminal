iler":false,"text":"錬金術を学ぶため進学してきた、生真面目な後輩。"},{"spoiler":false,"text":"その真面目さと常識人が災いし、よく他の面子に振り回されてしまう。"},{"spoiler":false,"text":"昨今にしては珍しく自ら進んで錬金術を学んでいるのだが、"},{"spoiler":false,"text":"これまで成功したことがなく、胸のサイズと同じくらい悩んでいる。"}],"source":"bangumi","sourceCharacterId":"115495"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77a2c9555997cd8b912a9a7b65acfe0b36765b0c2d66ab39ed5d30de0fd5856a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a82d0cac08241f6e49042913e842f999230d4afc89c0ef5b2ea48f57f159af8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡本理絵","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:394763:115495:13368:1","source":"bangumi"}]},{"characterId":"char_c117561","characterName":"柳瀬 彩良","sourceIds":{"bangumi":[{"characterId":"115496","match":"exact-normalized-name-in-linked-work","subjectId":"394763"}],"egsCharacterIds":["24325"],"vndbCharacterId":"c117561"},"originalCharacterName":"柳瀬 彩良","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"94"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"B94(H)/W59/H87"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-rate alchemist whose interests begin and end with her own research."},{"spoiler":f