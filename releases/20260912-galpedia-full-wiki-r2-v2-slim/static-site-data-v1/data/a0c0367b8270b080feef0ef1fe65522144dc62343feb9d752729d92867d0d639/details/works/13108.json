rce-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【士郎の依頼人】"},{"spoiler":false,"text":"行方不明となった兄の捜索を依頼する為、探偵事務所の扉を叩く。"},{"spoiler":false,"text":"明るく物怖じしない性格で、その生来の人懐っこさも相まってか。"},{"spoiler":false,"text":"士郎とは初対面にも関わらず、互いに打ち解けるのにあまり時間は掛からない。"},{"spoiler":false,"text":"信頼の置けるパートナー＆助手役として、共に捜査に乗り出していくことに。"},{"spoiler":false,"text":"清楚でしとやかな外見とは対照的に我は強く、決めたことは頑として譲らない一面も。"},{"spoiler":false,"text":"その為、時には物事に深入りしてしまい、何かとトラブルに巻き込まれてしまうことも多い。"},{"spoiler":false,"text":"甘いものには目がなく、食欲旺盛、発育良好。"},{"spoiler":false,"text":"士郎のことを“探偵さん”と呼び、好意を抱くと共に全幅の信頼を寄せている。"}],"source":"egs","sourceCharacterId":"14334","sourceWorkId":"13108","spoiler":false},{"segments":[{"spoiler":false,"text":"行方不明となった兄の探索を依頼する為、探偵事務所の扉を叩く。"},{"spoiler":false,"text":"明るく物怖じしない性格で、その生来の人懐っこさも相まってか、士郎とは初対面にも関わらず互いに打ち解けるのにあまり時間は掛からない。"},{"spoiler":false,"text":"信頼の置けるパートナー＆助手役として、共に捜査に乗り出していくことに。"},{"spoiler":false,"text":"清楚でしとやかな外見とは対照的に我は強く、決めたことは頑として譲らない一面も。"},{"spoiler":false,"text":"その為、時には物事に深入りしてしまい、なにかとトラブルに巻き込まれてしまうことも多い。"},{"spoiler":false,"text":"甘いものには目がなく、食欲旺盛、発育良好。"},{"spoiler":false,"text":"士郎のことを 「探偵さん」 と呼び、好意を抱くと共に全幅の信頼をよせている。"},{"spoiler":false,"text":"「だって私、探偵さんの助手ですから」"}],"source":"bangumi","sourceCharacterId":"50182"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/790a83ff036c0bd46b4a5088004d633e4dac1a066c4fdc2607a3e3a3538c8417.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab4e5fdba891a06402e1409126be758adcefd249865fb3fd123dd544c3b96fd3.webp","width":156,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:25214:50182:4956:1","source":"bangumi"}]},{"characterId":"char_c44586","c