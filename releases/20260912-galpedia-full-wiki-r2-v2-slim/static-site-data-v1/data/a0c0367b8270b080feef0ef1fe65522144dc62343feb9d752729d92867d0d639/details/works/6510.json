{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"6510","model":{"presentationWorkId":"vndb:v3202","staff":{"artwork":[{"creditedName":"陽之星照(ひのほし☆)","creatorId":"vndb:s5547","sourcePersonId":"egs:creator:1921","canonicalEntityId":"vndb:s5547","name":"陽之星照(ひのほし☆)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:13953","source":"egs"}],"scenario":[{"creditedName":"阿風梨々亜","creatorId":"vndb:s805","sourcePersonId":"egs:creator:395","canonicalEntityId":"vndb:s805","name":"阿風梨々亜","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:15182","source":"egs"},{"creditedName":"平一平","creatorId":"vndb:s10079","sourcePersonId":"egs:creator:5198","canonicalEntityId":"vndb:s10079","name":"平一平","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:20834","source":"egs"},{"creditedName":"シナリオ制作チームさるさる","creatorId":"egs:creator:5656","sourcePersonId":"egs:creator:5656","canonicalEntityId":"egs:creator:5656","name":"シナリオ制作チームさるさる","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:273089","source":"egs"}],"music":[{"creditedName":"CREATIVE SOUND PROJECT SALAD","creatorId":"vndb:s5576","sourcePersonId":"egs:creator:4078","canonicalEntityId":"vndb:s5576","name":"CREATIVE SOUND PROJECT SALAD","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:228548","source":"egs"}],"other":[{"creditedName":"後藤真由実","creatorId":"vndb:s14896","sourcePersonId":"vndb:s14896","canonicalEntityId":"vndb:s14896","name":"後藤真由実","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:41413","source":"vndb"}]},"cast":[{"characterId":"char_c23603","characterName":"叢雨 あゆ","sourceIds":{"bangumi":[{"characterId":"50409","match":"exact-normalized-name-in-linked-work","subjectId":"114071"}],"egsCharacterIds":["16291"],"vndbCharacterId":"c23603"},"originalCharacterName":"叢雨 あゆ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"見た目は幼い女の子だが、その正体は妖弧。"},{"spoiler":false,"text":"彼女の母親は園子の親友で、何か理由があって彼女は、園子に預けられたらしい。"},{"spoiler":false,"text":"妖弧としての力はまだまだ未熟で、人間の姿になっていることが精一杯。"},{"spoiler":false,"text":"ちょっとした拍子で変身が解けて耳や尻尾がちょこんと現われる。"},{"spoiler":false,"text":"見た目は幼いながらも、一応、主人公の“姉”という自負が強く、何かと御姉さんぶろうとするが、そのほとんどが空回りする。"},{"spoiler":false,"text":"性格も子供っぽく、能天気。また物覚えも悪く、お使いもままならない。"}],"source":"egs","sourceCharacterId":"16291","sourceWorkId":"6510","spoiler":false},{"segments":[{"spoiler":false,"text":"正体は妖狐。叢雨家の中では見た目も中身も最も幼い。"},{"spoiler":false,"text":"あゆの母親と園子が大昔からの親友であり、園子は理由があって彼女からあゆを預かっている。"},{"spoiler":false,"text":"妖狐としての力もまだまだ未熟で、人間の姿になっているのも精一杯。ちょっとしたことで変身が解けて狐の尻尾や耳が現れたりする。"},{"spoiler":false,"text":"外見上の年齢は逆転してしまったが、今でも主人公たちの姉でいたがっていて、お姉ちゃんらしくふるまおうとしているが、そのほとんどは空回りしている。"},{"spoiler":false,"text":"子供っぽい性格で、普段から泥んこになって野山を駆けずり回っている。"},{"spoiler":false,"text":"姉妹の中では一番能天気。お使いを頼まれても玄関を出る頃には忘れてしまえるくらいの鳥頭。"}],"source":"bangumi","sourceCharacterId":"50409"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86ba20703a9b228e212de970f5f619f0123465ed682a18a4013e0e03e8867012.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8beda608d4325dd36eab7bc2ef3d57070a24b793501169f30388dc0c41cf2ddf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:114071:50409:4714:1","source":"bangumi"}]},{"characterId":"char_c23604","characterName":"叢雨 園子","sourceIds":{"bangumi":[{"characterId":"50406","match":"exact-normalized-name-in-linked-work","subjectId":"114071"}],"egsCharacterIds":["16288"],"vndbCharacterId":"c23604"},"originalCharacterName":"叢雨 園子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"叢雨家の家長で、正体は龍。"},{"spoiler":false,"text":"叢雨家が営む叢雨神社に祀られている、竜神様でもある。"},{"spoiler":false,"text":"彼女は古来からこの地方を護ってきた神で、普段は神社の巫女さんの姿になって働いている。"},{"spoiler":false,"text":"その姿はずっと昔から変わらず、主人公にとっては母のような存在（彼女自身は姉と言い張るが……）。"},{"spoiler":false,"text":"性格は、おっとりとした穏やかな雰囲気の優しいお姉さん。"},{"spoiler":false,"text":"しかし、ひとたび怒らせると、まさに龍の逆鱗に触れた如く、大雨や雷を呼ぶ。"}],"source":"egs","sourceCharacterId":"16288","sourceWorkId":"6510","spoiler":false},{"segments":[{"spoiler":false,"text":"正体は龍で、叢雨（むらさめ）神社で祀られている、ズバリ本人。"},{"spoiler":false,"text":"大昔からこの地方を守ってきた神で、普段は神社の巫女として働いている。"},{"spoiler":false,"text":"さすがに神本人が神社にいるだけあって、ご利益は抜群の神社なので、田舎のあまり知られていない小さな神社でありながら地元の人間には敬われている。"},{"spoiler":false,"text":"ずっと昔から同じ姿で、主人公にとっては母親みたいな存在だが、本人はあくまでも姉と言い張っている。"},{"spoiler":false,"text":"普段はおっとりしていて穏やかで優しい性格のお姉さんだが、時々拗ねてみたり素でボケたりと可愛らしい一面を見せる。"},{"spoiler":false,"text":"しかし、ひとたび本気で怒らせたりすると、大雨や雷を呼び起こすので、誰も怖くて逆らえない。"}],"source":"bangumi","sourceCharacterId":"50406"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c84606991c0820f9282ed69b4df402d9cd9759d27e96917cc740fe9718b36121.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/477d52e1e2486a96e9d04ead0b7338b4be509ded45288f314afc7b89c90bba99.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:114071:50406:4940:1","source":"bangumi"}]},{"characterId":"char_c23605","characterName":"叢雨 東亜子","sourceIds":{"bangumi":[{"characterId":"50407","match":"exact-normalized-name-in-linked-work","subjectId":"114071"}],"egsCharacterIds":["16289"],"vndbCharacterId":"c23605"},"originalCharacterName":"叢雨 東亜子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"白い大蛇の化身。"},{"spoiler":false,"text":"昔は他の地方で神として崇められていたが、何かの理由で叢雨神社にやってきて、居座るようになった。"},{"spoiler":false,"text":"正体通りの“うわばみ（大酒飲み）”で、常に酒を飲んでいる。"},{"spoiler":false,"text":"お色気ムンムンの巨乳が魅力のお姉さん。"},{"spoiler":false,"text":"その性格は、明るく奔放で、さばさばしている。"},{"spoiler":false,"text":"人をからかうことが大好きで、主人公もよくターゲットにされている。"}],"source":"egs","sourceCharacterId":"16289","sourceWorkId":"6510","spoiler":false},{"segments":[{"spoiler":false,"text":"白い大蛇の化身で、昔は別の地方で神として崇められていたそうだが、とある理由から叢雨神社にやってきて居座っている。"},{"spoiler":false,"text":"その正体通りウワバミで、無類の酒好きでいつもお酒を飲んでいる。"},{"spoiler":false,"text":"園子に次ぐ古参で園子とは古い付き合い。"},{"spoiler":false,"text":"ヒロイン中で最も巨乳で普段から色気を振りまいていて、明るくてサバサバした性格。"},{"spoiler":false,"text":"人をからかうのが好きで、主人公に対してもHなからかいを良く仕掛けてくる。"}],"source":"bangumi","sourceCharacterId":"50407"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac4eb0b59126de7001da2eb5813d1f2886b01541ff7c731df7afeed23c702392.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89232f716a1793f820c53530f1d8c0ed87abe2a01170bb2ffab61d206c374ecf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽吹梨里","creatorId":"vndb:s57","sourcePersonId":"vndb:s57","canonicalEntityId":"vndb:s57","name":"羽吹 梨里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:114071:50407:6547:1","source":"bangumi"}]},{"characterId":"char_c23606","characterName":"真矢","sourceIds":{"bangumi":[{"characterId":"50411","match":"exact-normalized-name-in-linked-work","subjectId":"114071"}],"egsCharacterIds":["16293"],"vndbCharacterId":"c23606"},"originalCharacterName":"真矢","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"里帰りした主人公の前に、時折、姿を現す謎の少女。"},{"spoiler":false,"text":"ツンと澄ましているが、驚くほど世間知らずで、多彩なボケをかましてくれる。"},{"spoiler":false,"text":"そんな彼女は、主人公の知る誰かとその面影が似ているようだが……。"}],"source":"egs","sourceCharacterId":"16293","sourceWorkId":"6510","spoiler":false},{"segments":[{"spoiler":false,"text":"田舎に帰ってからの主人公の前に時折姿を現す少女。"},{"spoiler":false,"text":"澄ました態度だが、実際は驚くほど世間知らずであまりのボケっぷりで主人公を困惑させることもしばしば。"}],"source":"bangumi","sourceCharacterId":"50411"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30f4505a6cab5b42b090d8bd11aac9da9e3e700975517e454999650b6b019298.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4ef0ed6758a3428dd8e73926d81ff0b7d5112d78e7d37996cf5a5d29dee0627.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永瀬江美弥","creatorId":"vndb:s61","sourcePersonId":"vndb:s61","canonicalEntityId":"vndb:s61","name":"永瀬 いくみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:114071:50411:6549:1","source":"bangumi"}]},{"characterId":"char_c23607","characterName":"叢雨 志乃","sourceIds":{"bangumi":[{"characterId":"50410","match":"exact-normalized-name-in-linked-work","subjectId":"114071"}],"egsCharacterIds":["16292"],"vndbCharacterId":"c23607"},"originalCharacterName":"叢雨 志乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の義妹。"},{"spoiler":false,"text":"彼女は姉たちとは違いに人間の女の子。"},{"spoiler":false,"text":"彼女の両親が事故で亡くなり、身寄りの無くなった彼女を園子が引き取った。"},{"spoiler":false,"text":"明朗快活な女の子で、彼女の通っている学校では陸上部に所属。"},{"spoiler":false,"text":"姉たちが人間でないことは彼女自身も知っているが、主人公と同じく、まったくそれを気にせずに、仲良く暮らしている。"}],"source":"egs","sourceCharacterId":"16292","sourceWorkId":"6510","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹。人間。"},{"spoiler":false,"text":"村の出身で、志乃の両親が交通事故で他界して身寄りがいなくなったのを、園子が引き取った。"},{"spoiler":false,"text":"明るく元気な女子校生。"},{"spoiler":false,"text":"学校では陸上部に所属しており、スポーツ好きで快活な性格。"},{"spoiler":false,"text":"主人公のことを昔は「お兄ちゃん」と呼んでいたが、最近では「アニキ」になり、時折頭に「バカ」をつけて「バカアニキ」呼ばわりすることもある。"},{"spoiler":false,"text":"園子たちが人間でないことは知っているが、主人公と同じく、全く気にしていない。"}],"source":"bangumi","sourceCharacterId":"50410"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/4804eef8bd45c56223d6677718a792aef044b38788b527d8721cce6ea839bdde.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5ceadd8a5f43dcc75266ee1ef3f60981fdfbdc50c8ba382656089cc1fce8756.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:114071:50410:6106:1","source":"bangumi"}]},{"characterId":"char_c23608","characterName":"叢雨 真名","sourceIds":{"bangumi":[{"characterId":"50408","match":"exact-normalized-name-in-linked-work","subjectId":"114071"}],"egsCharacterIds":["16290"],"vndbCharacterId":"c23608"},"originalCharacterName":"叢雨 真名","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"叢雨神社の隣にある山の神である大天狗の娘。"},{"spoiler":false,"text":"過去のトラウマから、大人しいを通り越して臆病な性格。"},{"spoiler":false,"text":"主人公に昔から好意を寄せていたが、その臆病な性格から行動に移せずにいた。"},{"spoiler":false,"text":"今回、主人公の里帰りをきっかけに、大胆にアプローチしようと思っているようだが……。"}],"source":"egs","sourceCharacterId":"16290","sourceWorkId":"6510","spoiler":false},{"segments":[{"spoiler":false,"text":"正体は天狗で、叢雨神社の隣の山の神である大天狗の娘。"},{"spoiler":false,"text":"過去に何かあったのか、大人しいを通り越して臆病な性格。"},{"spoiler":false,"text":"昔から主人公に好意を寄せていながら行動に移せずにいたが、今回のことをきっかけに大胆なアプローチをしてくることも。"}],"source":"bangumi","sourceCharacterId":"50408"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45185d4c8b98d47c904229a724827c229a34504dabb10386b93593a7bc162dfd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac05fda58b7da56b6fea3bf23dc7b7cf54824e52113b4cd6ec5bfc46c3ef8505.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹間千ノ美","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:114071:50408:19333:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p963","sourceCompanyId":"egs:brand:977","canonicalEntityId":"vndb:p963","name":"パティスリー","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:6510:977","source":"egs"},{"companyId":"vndb:p963","sourceCompanyId":"vndb:p963","canonicalEntityId":"vndb:p963","name":"パティスリー","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:34163:v3202","source":"vndb"},{"companyId":"vndb:p963","sourceCompanyId":"vndb:p963","canonicalEntityId":"vndb:p963","name":"パティスリー","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:7471:v3202","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
