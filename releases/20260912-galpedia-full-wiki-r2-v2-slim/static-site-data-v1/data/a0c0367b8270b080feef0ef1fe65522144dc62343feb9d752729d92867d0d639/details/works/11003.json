{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"11003","model":{"presentationWorkId":"vndb:v2763","staff":{"artwork":[{"creditedName":"木枯し悶次郎(一発屋太郎)","creatorId":"vndb:s14932","sourcePersonId":"egs:creator:2719","canonicalEntityId":"vndb:s14932","name":"木枯し悶次郎(一発屋太郎)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:71743","source":"egs"}],"scenario":[{"creditedName":"嘘屋 佐々木酒人","creatorId":"vndb:s4095","sourcePersonId":"egs:creator:1134","canonicalEntityId":"vndb:s4095","name":"嘘屋 佐々木酒人","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:68612","source":"egs"}],"music":[],"other":[{"creditedName":"嘘屋 佐々木 酒人","creatorId":"vndb:s4095","sourcePersonId":"vndb:s4095","canonicalEntityId":"vndb:s4095","name":"嘘屋 佐々木 酒人","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:37639","source":"vndb"}]},"cast":[{"characterId":"char_c70865","characterName":"横口 りみ","sourceIds":{"bangumi":[{"characterId":"143093","match":"exact-normalized-name-in-linked-work","subjectId":"279514"}],"egsCharacterIds":["17901"],"vndbCharacterId":"c70865"},"originalCharacterName":"横口 りみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"通称「りみ」。コスプレネームは「ミラクルりみっと」。"},{"spoiler":false,"text":"コスプレ趣味はつい最近始めて、いきなりどっぷりハマったクチ。主人公の幼なじみで、お隣どうし。彼より誕生日が半年ほど早く、これまではずっとお姉さん的な立場で彼のことを仕切っていた。二階の窓から出入りするのが常で、毎朝起こしに来てくれたりする。彼とはアソコの見せっこまでした仲だ。兄妹、姉弟以上の関係で、彼の悪癖やら恥ずかしい過去などはすべて網羅熟知している。久子のことは「泥棒猫」とか「小娘」と悪罵して警戒中。"},{"spoiler":false,"text":"いいこと？ あたしは、このお○んぽのプロなの！　お○んぽをさばく魔性の女っ！　（処女ですが）"}],"source":"egs","sourceCharacterId":"17901","sourceWorkId":"11003","spoiler":false},{"segments":[{"spoiler":false,"text":"通称「りみ」。コスプレネームは「ミラクルりみっと」。"},{"spoiler":false,"text":"お姉さんづらした幼なじみ。優しくおしとやかで主人公に惚れていて、おまけにオッパイがでかいと言うコト無しな彼女だが、たった一度のセックス失敗を理由に彼の求めを拒み中、上からっ目線のお姉さん口調で主人公を観世んに尻の下に敷く安産型処女。"}],"source":"bangumi","sourceCharacterId":"143093"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"17901","sourceWorkId":"11003","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"17901","sourceWorkId":"11003","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"17901","sourceWorkId":"11003","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"17901","sourceWorkId":"11003","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"48 kg","valueContext":null,"source":"egs","sourceCharacterId":"17901","sourceWorkId":"11003","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a89e3948178401521b7f52d1aff5b4fdd3f33947f4470ded1f81ff84eec11179.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/9214e090a8a698855b431075932f7eafc75158b64c54a5ed2f31af57a87f5026.webp","width":154,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c70866","characterName":"字野 久子","sourceIds":{"bangumi":[{"characterId":"143094","match":"exact-normalized-name-in-linked-work","subjectId":"279514"}],"egsCharacterIds":["17902"],"vndbCharacterId":"c70866"},"originalCharacterName":"字野 久子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"通称「ちゃこ」。コスプレネームは「デラきゅーちゃん」。"},{"spoiler":false,"text":"コスプレ趣味はもう十年近く続けている筋金入り。主人公の後輩で、お向かいに引っ越してきた転校生。実はずっと以前、ちょっとだけここに住んでいたことがあり、幼少時に主人公と結婚の約束を……。遅刻寸前の朝トーストをくわえて飛び出したところを主人公と衝突し、その弾みでキスなどしてしまう（ファーストキス!!）。その後、雨の中で仔猫を助ける主人公を見たり、昔の結婚の約束を思い出したりして、彼にぞっこんになる。りみのことは「古女房」とか「おばさん」と罵って牽制中。"},{"spoiler":false,"text":"ダーリン、早く出して。早く出して。恥ずかしくて死んじゃいそ……"}],"source":"egs","sourceCharacterId":"17902","sourceWorkId":"11003","spoiler":false},{"segments":[{"spoiler":false,"text":"通称「チャコ」。 コスプレネームは「デラきゅーちゃん」。"},{"spoiler":false,"text":"小悪魔家にゃんこタイプ後輩少女。明るくかわいく主人公にベタ惚れで、おまけに「アゲル」気満々と文句ナシな彼女だが、焼きもちはどんどん常軌を逸して激しくなるばかり。体を張ってダーリンの掠奪愛を目論む暴走処女。"}],"source":"bangumi","sourceCharacterId":"143094"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"17902","sourceWorkId":"11003","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"153 cm","valueContext":null,"source":"egs","sourceCharacterId":"17902","sourceWorkId":"11003","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"17902","sourceWorkId":"11003","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"17902","sourceWorkId":"11003","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"42 kg","val