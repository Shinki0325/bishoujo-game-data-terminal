{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"30845","model":{"presentationWorkId":"egs:30845","staff":{"artwork":[{"creditedName":"武内崇","creatorId":"vndb:s68","sourcePersonId":"egs:creator:467","canonicalEntityId":"vndb:s68","name":"武内崇","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:234278","source":"egs"}],"scenario":[{"creditedName":"奈須きのこ","creatorId":"vndb:s2","sourcePersonId":"egs:creator:466","canonicalEntityId":"vndb:s2","name":"奈須きのこ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:234279","source":"egs"}],"music":[],"other":[{"creditedName":"奈須きのこ","creatorId":"vndb:s2","sourcePersonId":"egs:creator:466","canonicalEntityId":"vndb:s2","name":"奈須きのこ","detail":"原作","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:234280","source":"egs"},{"creditedName":"TYPE-MOON","creatorId":"egs:creator:30788","sourcePersonId":"egs:creator:30788","canonicalEntityId":"egs:creator:30788","name":"TYPE-MOON","detail":"原作","roleCode":"other","roleLabel":"其他","identityStatus":"alias-only-review","relationId":"egs:work-creator:234281","source":"egs"}]},"cast":[{"characterId":"char_bangumi_100138","characterName":"Vlov Arkhangel","sourceIds":{"bangumi":[{"characterId":"100138","match":"source-roster","subjectId":"331486"},{"characterId":"100138","match":"source-roster","subjectId":"46874"}]},"originalCharacterName":"Vlov Arkhangel","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0514"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"188"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"79"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89ff33c83ab32ba1fae3547eb732935966ce75614ba66539693f84b9c3062fda.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2faee79c4475f9dc6a085ac61e61bb183a2078cd4641f5c56759c956b8396c59.webp","width":256,"height":254,"source":"static-detail"},"actors":[{"creditedName":"津田健次郎","creatorId":"vndb:s739","sourcePersonId":"vndb:s739","canonicalEntityId":"vndb:s739","name":"津田 健次郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331486:100138:3977:1","source":"bangumi"}]},{"characterId":"char_bangumi_11324","characterName":"猫アルク","sourceIds":{"bangumi":[{"characterId":"11324","match":"source-roster","subjectId":"12056"},{"characterId":"11324","match":"source-roster","subjectId":"331486"},{"characterId":"11324","match":"source-roster","subjectId":"3344"},{"characterId":"11324","match":"source-roster","subjectId":"503518"},{"characterId":"11324","match":"source-roster","subjectId":"96131"}]},"originalCharacterName":"猫アルク","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"ねこねこアルク猛レース"},{"spoiler":false,"text":"謎の生霊。タイプムーンのマスコットになりつつある。"},{"spoiler":false,"text":"ねこタイプ。"},{"spoiler":false,"text":"ボーナスステージで現れる謎のキャラ。試合時間はわずか十秒、閃光のように現れ、閃光のように去っていく。"},{"spoiler":false,"text":"ドット絵がマ○オペイントで描かれている為、通常技のリーチはないに等しい。が、マジックサーキットが常にマックスである為、これでもかこれでもかとゲージ技を多用してくる。ピカンピカンと頻繁に入るカットインがやかましい事この上ない。"},{"spoiler":false,"text":"全身を弾道ミサイルにみたてた突進技「うなる肉球」はガードしても画面端まで引きずられる。もっとも、削りダメージはないのでどうというコトはない。"},{"spoiler":false,"text":"厄介なのは三ゲージ技の「番長ねこ屋敷」。画面中に猫アルクが出現するのだが、恐ろしいコトに出されると止まる。（ゲームが）"},{"spoiler":false,"text":"どんなにハイスペックなマシンだろうと止まるので、猫アルクの三ゲージ技だけは使わない（使わせない）ようにしよう。"}],"source":"bangumi","sourceCharacterId":"11324"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15e74fe413c169deea78cccd1f6252389ed5bcdf3b41409891459341d9bdb3eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a7e8bb4206ac490665d97198c9d280507cbf31d85e4112df79b8d2488d1f31e.webp","width":194,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川育美","creatorId":"vndb:s14378","sourcePersonId":"vndb:s14378","canonicalEntityId":"vndb:s14378","name":"長谷川 育美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331486:11324:30858:1","source":"bangumi"}]},{"characterId":"char_bangumi_14377","characterName":"Miyako Arima","sourceIds":{"bangumi":[{"characterId":"14377","match":"source-roster","subjectId":"12056"},{"characterId":"14377","match":"source-roster","subjectId":"1908"},{"characterId":"14377","match":"source-roster","subjectId":"331486"},{"characterId":"14377","match":"source-roster","subjectId":"3344"},{"characterId":"14377","match":"source-roster","subjectId":"46874"},{"characterId":"14377","match":"source-roster","subjectId":"503518"}]},"originalCharacterName":"Miyako Arima","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0504"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"bust":{"reviewState":"source-only","source":"bangumi","value":"60"},"height":{"reviewState":"source-only","source":"bangumi","value":"131"},"hip":{"reviewState":"source-only","source":"bangumi","value":"62"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"46"},"weight":{"reviewState":"source-only","source":"bangumi","value":"35"}},"descriptions":[{"segments":[{"spoiler":false,"text":"志貴が八年間暮らしていた有間家の長女で、小学6年生。いわばもう一人の志貴の「妹」である。『月姫』以後に設定が作られ、『歌月十夜』では名前のみ登場している。"},{"spoiler":false,"text":"兄である志貴が大好きだが、まともにコミュニケーションが取れず無言でタックルして去っていくなどの奇行を繰り返している。「なんちゃって八極拳」の使い手で、技名は平仮名表記ではあるもののタタリの影響で一時的にその技が本物となる。"},{"spoiler":false,"text":"無印ストーリーモードではあるルートで知らぬ間にタタリに憑かれてしまい、珍騒動の原因かつ最終ボスとして登場する。『Re・ACT』以降では志貴と普通に会話ができるようになっているが、ネコアルクに目を付けられることになる。七夜のことは「ワイルドなお兄ちゃん」と評している。その七夜とは後に意外な関係になることが『Character material』で暗示されている。"}],"source":"bangumi","sourceCharacterId":"14377"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff25a85e4a16961ab731c62eb92ed00d912d9adf4a6d1a262b2b486fa942239e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/006f48dca4f6db3baf1e191907ad90578502ba52587c79369b2f83d3999cf64c.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金元寿子","creatorId":"vndb:s1769","sourcePersonId":"vndb:s1769","canonicalEntityId":"vndb:s1769","name":"金元 寿子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331486:14377:5941:1","source":"bangumi"}]},{"characterId":"char_bangumi_14386","characterName":"Michael Roa Valdamjong","sourceIds":{"bangumi":[{"characterId":"14386","match":"source-roster","subjectId":"1908"},{"characterId":"14386","match":"source-roster","subjectId":"2865"},{"characterId":"14386","match":"source-roster","subjectId":"331486"},{"characterId":"14386","match":"source-roster","subjectId":"46874"},{"characterId":"14386","match":"source-roster","subjectId":"96131"}]},"originalCharacterName":"Michael Roa Valdamjong","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"＝月姬＝"},{"spoiler":false,"text":"死徒27祖中的EX，另称“转生无限者”，埋葬机关的创立者。对爱尔奎特非常执著，用计让爱尔奎特吸了自己的血，取走了爱尔奎特一部分的力量，自此开始了长达八百年的转生。附身在四季身上是第18世，觉醒时会取代本人的意识和记忆。"},{"spoiler":false,"text":"经历了17次的转生后看到了代表生命的线，但不敌志贵能杀死万物的“直死之魔眼”而被消灭。"},{"spoiler":false,"text":"＝MELTY BLOOD＝"},{"spoiler":false,"text":"Actress Again中的新增角色。"},{"spoiler":false,"text":"Actress Again的时间点中原本已被消灭，不是由人而被由土地的记忆中，被TATARI所再现而登场。"},{"spoiler":false,"text":"原作中根据所选路线不同姿态与性格略有差异，本作中以表路线的姿态登场。罗亚转生的性格很大程度上会受到转生目标原本的性格所影响，因此转生到远野四季身上的本代罗亚会做出称呼尼禄·卡欧斯为“老爷（日语：ダンナ）”这种比起原本的性格显得像个不良野小子一样的行为。不过，以雷的魔术与体术战斗、胜利时的画面演出会披上类似神父的衣装等，也有显得比《月姬》中更接近原本的罗亚的一面。"},{"spoiler":false,"text":"此外，自歌月十夜以来逐渐沦为搞笑角色。虽然在各种角色的剧情中登场但总之作为“新人”遭到了集体欺负，连不幸少女五月和搞笑角色白莲都能欺负他；五月似乎根本没注意到自己是罗亚的后裔吸血鬼的样子。在五月路线中被劝诱加入后巷同盟的后辈，不过白莲表示他是“后巷同盟食物链最底层”。白莲路线中被设定为已经在五月路线中败给五月，听了白莲的话感受到“必须得拼上老命啊”般的威胁。"},{"spoiler":false,"text":"月姬人气投票中被解说为能使用使魔术能力加倍的固有结界“Over load（过载）”（日语：オーバーロード（過負荷）），作品中也有如Last Arc台词“Overload·Gematria！（日语：オーバーロード・ゲマトリア！）”等，用固有结界强化自己所使用的数秘法（Gematria）的表现。"},{"spoiler":false,"text":"以设置式及移动攻击等要求技巧性的技能为后盾，主要使用普通攻击的角色。"}],"source":"bangumi","sourceCharacterId":"14386"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17935c85ec37b9ce63b0f765b2e5b0834ed8bab8334690f31ff113d3d9ff783c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2df5c78db0783e175bbfc98937f3e9243edc7cc38cfa551cb4ad8da3ec92c484.webp","width":133,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阿座上洋平","creatorId":"vndb:s149","sourcePersonId":"vndb:s149","canonicalEntityId":"vndb:s149","name":"ライトニング金山","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331486:14386:11166:1","source":"bangumi"}]},{"characterId":"char_bangumi_14387","characterName":"きしま こうま","sourceIds":{"bangumi":[{"characterId":"14387","match":"source-roster","subjectId":"2865"},{"characterId":"14387","match":"source-roster","subjectId":"331486"},{"characterId":"14387","match":"source-roster","subjectId":"3344"},{"characterId":"14387","match":"source-roster","subjectId":"46874"}]},"originalCharacterName":"きしま こうま","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"远野家分家，轧间家当主。曾参与远野秋叶之父·远野槙久发起的消灭七夜家之战，并杀死了志贵之父·七夜黄理。流有很浓的人外之血，被称作红赤朱忌讳着。"},{"spoiler":false,"text":"被TATARI以“人们所畏惧的鬼”在三咲町具现化，但由于原版的力量太强使得TATARI没能影响而保有自我。虽然对自己只是个幻影略有察觉，但只是在消失前继续战斗而已。"},{"spoiler":false,"text":"歌月十夜中作为志贵心中“死的形象化”而重现所以像恶鬼一样狂暴，但在MELTY BLOOD中可以看出他其实在战斗外是超然如同仙人一样的性格。能够使用歌月十夜中“志贵的印象”再现版所不能使用的“灼热”能力。在青子的路线中，也有在森林中修行参悟的本人登场的情节。"},{"spoiler":false,"text":"攻击力、机动性高，虽然动作略显夸张但投技、打击技、起攻技都比较优秀，属于偏重攻击的角色。"}],"source":"bangumi","sourceCharacterId":"14387"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e21a31d3ec31469bcbf838a26e95e10cb85abef7c6234e4dc4275f9fe9fef1c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c11db2c08e56044ee9cb45a11ac6ace6f8747c7580019052ab342bfe7a0b5b6.webp","width":220,"height":256,"source":"static-detail"},"actors":[{"creditedName":"濱野大輝","creatorId":"vndb:s8320","sourcePersonId":"vndb:s8320","canonicalEntityId":"vndb:s8320","name":"濱野大輝","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331486:14387:19515:1","source":"bangumi"}]},{"characterId":"char_bangumi_273","characterName":"Altria Pendragon","sourceIds":{"bangumi":[{"characterId":"273","match":"source-roster","subjectId":"173533"},{"characterId":"273","match":"source-roster","subjectId":"214013"},{"characterId":"273","match":"source-roster","subjectId":"297634"},{"characterId":"273","match":"source-roster","subjectId":"331486"},{"characterId":"273","match":"source-roster","subjectId":"911"},{"characterId":"273","match":"source-roster","subjectId":"935"}]},"originalCharacterName":"Altria Pendragon","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"bangumi","value":"73"},"height":{"reviewState":"source-only","source":"bangumi","value":"154"},"hip":{"reviewState":"source-only","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"53"},"weight":{"reviewState":"source-only","source":"bangumi","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Fate/stay night"},{"spoiler":false,"text":"被卫宫士郎召唤的英灵。作为三骑士之一的Saber，以「最优秀的剑之骑士」闻名。她曾在第四次圣杯战争中被召唤，当时士郎的养父——卫宫切嗣是她的Master。"},{"spoiler":false,"text":"她的真实身份是英格兰传说中的英雄——亚瑟王。从石中拔出选王之剑的少女「阿尔托莉雅」，为了成为理想的君主而隐瞒了自己的性别。然而，在内乱中目睹国土荒废的她，认为自己未能胜任王者之位，因此渴望借由圣杯重新选定合格的王，以拯救祖国不列颠。"},{"spoiler":false,"text":"她拥有不负传说之名的强大力量，但由于与士郎之间缺乏魔力的“通路”，常因魔力不足而陷入苦战。性格极其刻板认真，对于自己是女性的自觉也相当淡薄，以至于一开始总与士郎意见不合。但最终，她在与士郎的相处中肯定了自己的人生，并决心摧毁寄宿着“此世全部之恶”的圣杯。对她而言，能让自己镜像一般的士郎成为Master，或许是再幸运不过的事情了。"},{"spoiler":false,"text":"Fate/Zero"},{"spoiler":false,"text":"传说中的骑士王亚瑟现界的身姿，真名是阿尔托莉雅。卫宫切嗣召唤的从者，召唤时所用的圣遗物是Excalibur的剑鞘，她在第四次圣杯战争中保护着作为代理Master的爱丽丝菲尔。"},{"spoiler":false,"text":"传说中的亚瑟王是男性，那是因为她为了统治方便而隐瞒了性别。拔出选定之剑后身体便不再成长与老化，因此一直是少女的模样。高尚而廉洁、认真而顽固，怀抱的愿望是拯救曾经走上灭亡之路的祖国不列颠。"},{"spoiler":false,"text":"Fate/Grand Order"},{"spoiler":false,"text":"不列颠传说中的王。也被誉为骑士王。阿尔托莉雅是幼名，自从当上国王之后，就开始被称为亚瑟王了。在骑士道凋零的时代，手持圣剑，给不列颠带来了短暂的和平与最后的繁荣。史实上虽为男性，但在这个世界内却似乎是男装丽人，行为举止都以男性为标准，因此很不擅长应对异性向自己表达的好感。"},{"spoiler":false,"text":"崇尚万人眼中正确生活、正确人生的理想王者之一。锄强扶弱，是个无可非议的人物。冷静沉着，无论何时都十分认真的优等生。尽管如此……虽说从不愿意开口承认，但她却有着不服输的一面。对任何需要一争高下的事都不会手下留情，一旦败北则会非常懊悔。"},{"spoiler":false,"text":"她具有指挥军团的天生才能。在团体战斗中，可令我军的能力提升。贯彻清廉正直，大公无私的王。其公正令骑士们愿意守护于她的身旁，令民众们在对贫困的忍耐中看到了希望。她的王者之路并不是为了统帅少数强者，而是为了领导更多无力之人而存在的。"},{"spoiler":false,"text":"亚瑟王传说以骑士时代的终结为结局。亚瑟王虽然击退了异民族，但却无法回避不列颠土地的毁灭。圆桌骑士之一·莫德雷德的反叛导致国家一分为二，骑士之城卡美洛也失去了其辉煌。亚瑟王在卡姆兰之丘成功讨伐了莫德雷德，自己却也因负重伤而倒下。在去世前，她将圣剑交给了最后的心腹贝德维尔，离开了这个世界。死后她被送往了理想乡——不存于此世的乐园·阿瓦隆，并打算在遥远的未来再次拯救不列颠。"}],"source":"bangumi","sourceCharacterId":"273"}],"profileFacts":[{"label":"喜欢的东西","source":"bangumi","sourceCharacterId":"273","value":"规矩精细的饮食、布娃娃（尤其是狮子的）"},{"label":"属性","source":"bangumi","sourceCharacterId":"273","value":"秩序·善·地"},{"label":"特技","source":"bangumi","sourceCharacterId":"273","value":"器械运动、秘密地精通各种赌博"},{"label":"讨厌的东西","source":"bangumi","sourceCharacterId":"273","value":"粗糙的饮食、过多装饰"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78c81176293bff59bdaef415cafbb7e043d0640cc59c570b6d815e8aa9f1f1f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e397d20052d6b229c9daa5185b5318b004b311de857ca4c1887f4324bb2a6040.webp","width":179,"height":256,"source":"static-detail"},"actors":[{"creditedName":"川澄綾子","creatorId":"vndb:s16","sourcePersonId":"vndb:s16","canonicalEntityId":"vndb:s16","name":"川澄 綾子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331486:273:740:1","source":"bangumi"}]},{"characterId":"char_bangumi_29048","characterName":"玛修·姬莉叶莱特","sourceIds":{"bangumi":[{"characterId":"29048","match":"source-roster","subjectId":"231881"},{"characterId":"29048","match":"source-roster","subjectId":"331486"}]},"originalCharacterName":"玛修·姬莉叶莱特","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"158"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"登场于Fate/Grand Order, 源于Fate/stay night最初设定的, 持有巨大盾牌的迷之少女。"},{"spoiler":false,"text":"Chaldea局的成员，玛修·基列莱特与Servant凭依融合的姿态。被称作Demi Servant。Demi Servant持有的特殊技能。能将凭依的英灵持有的技能仅仅一个继承下来，并升华为自我的流派。玛修的场合是“魔力防御”。与魔力放出同类型的技能，将魔力直接变换为防御力。如果是持有庞大魔力的英灵的话，那将会是连一个国家都能守护的神圣壁垒吧。玛修得知了凭依于自身的英灵的真名。那个骑士的名字叫加拉哈德。存在于亚瑟王传说中的圆桌骑士的一人。唯一一个入手了圣杯，随后返回了天堂的圣者。Chaldea能够用独自的方法成功完成英灵召唤，作为其基础的是作为加拉哈德召唤的触媒的“英雄们集结的场所”——也就是玛修所持有的，利用圆桌制成的盾牌。"},{"spoiler":false,"text":"宝具简介『如今仍是遥远的理想之城』"},{"spoiler":false,"text":"等级:B+++ 种类:对恶宝具"},{"spoiler":false,"text":"Lord・Camelot"},{"spoiler":false,"text":"英灵・加拉哈德持有的宝具。白亚之城卡美洛的中心，使用圆桌骑士们的圆桌为盾的究极的守护。强度根据使用者的精神程度，内心绝不屈服的话城壁绝对不会崩溃。 将之冠以Chaldea之名向来是由存在于玛修心底的祈愿，“守望人类的未来”而来吧。"}],"source":"bangumi","sourceCharacterId":"29048"}],"profileFacts":[{"label":"属性","source":"bangumi","sourceCharacterId":"29048","value":"秩序·善"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/942abd98626d769d84a5f271f547510ec98a13daee88193ac6d0c494a1960156.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e19934512d776d861cbac1c3b544ef0741fe055ac7f9ac39552f69bb0f44e02.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋李依","creatorId":"vndb:s10632","sourcePersonId":"vndb:s10632","canonicalEntityId":"vndb:s10632","name":"高橋 李依","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331486:29048:17491:1","source":"bangumi"}]},{"characterId":"char_bangumi_32238","characterName":"源義経","sourceIds":{"bangumi":[{"characterId":"32238","match":"source-roster","subjectId":"331486"}]},"originalCharacterName":"源義経","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"168"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"在日本无人不知无人不晓的著名悲剧武将。天赋异禀，有着过人的领袖气质，然而却遭到了兄长赖朝的疏远，最后与随从弁庆一起被打败。牛若丸是源义经的乳名。"},{"spoiler":false,"text":"牛若丸（源义经）足以称为日本史上最有名的武将。以知名度而言，只有织田信长可以与她媲美了吧。……然而，关于她的历史存在很多不明确的要素，尤其是起兵前的前半生完全是个谜。"},{"spoiler":false,"text":"十一岁时，被寄养在鞍马寺的牛若丸，遇到了阴阳师鬼一法眼，并因此被传授了兵法（另有说法称此人是鞍马天狗）。义经无疑是个优秀的兵法家，但也欠缺了致命的要素。那就是对战场的恐惧。她一生都与其他武将水火不容。赖朝竟会对义经心怀杀意的原因，她想必终生都没能理解吧。对天才的她而言，根本无法体会对于能力的恐惧。"}],"source":"bangumi","sourceCharacterId":"32238"}],"profileFacts":[{"label":"属性","source":"bangumi","sourceCharacterId":"32238","value":"混沌·中庸"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c1849b21140bf036cd83e390c46d6c488ee9e3ed8801c63af7030a44953a7d3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b48a0c199dc3de3b40f06428c4ed0eb0ecda0fa8d7305c9fa881e1880dc3552.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"早見沙織","creatorId":"vndb:s1871","sourcePersonId":"vndb:s1871","canonicalEntityId":"vndb:s1871","name":"早見 沙織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331486:32238:4895:1","source":"bangumi"}]},{"characterId":"char_bangumi_3235","characterName":"蒼崎 青子","sourceIds":{"bangumi":[{"characterId":"3235","match":"source-roster","subjectId":"1908"},{"characterId":"3235","match":"source-roster","subjectId":"331486"},{"characterId":"3235","match":"source-roster","subjectId":"3344"},{"characterId":"3235","match":"source-roster","subjectId":"46874"},{"characterId":"3235","match":"source-roster","subjectId":"503518"},{"characterId":"3235","match":"source-roster","subjectId":"540053"},{"characterId":"3235","match":"source-roster","subjectId":"5418"}]},"originalCharacterName":"蒼崎 青子","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0707"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"bust":{"reviewState":"source-only","source":"bangumi","value":"88"},"height":{"reviewState":"source-only","source":"bangumi","value":"163"},"hip":{"reviewState":"source-only","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"56"},"weight":{"reviewState":"source-only","source":"bangumi","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"教导志贵“即使拥有奇怪的眼睛，不要连心也变得奇怪”的价值观的人，在志贵小时候曾赠予志贵能抑制魔眼能力的眼镜“魔眼杀”，志贵称之为老师，在志贵记忆中是个有着大人魅力的女性。"},{"spoiler":false,"text":"现有的五位魔法使之一（第四魔法使）。 使用第五魔法·青。"},{"spoiler":false,"text":"魔术协会封为MISS BLUE，目前全国巡回中。个性大而化之，做事随意，喜欢自由。"},{"spoiler":false,"text":"是苍崎橙子的妹妹，但和姐姐橙子关系极恶劣，曾为了家族继承权而大打出手，从此两人绝不见面。"},{"spoiler":false,"text":"在破坏方面有着极大的天赋，能够最有效率的使用魔力，有近身战的兴趣。"}],"source":"bangumi","sourceCharacterId":"3235"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/828df9558ff00d25f6b05993571cba11e0d8cfed47c85b56bf2c3de0853480f8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5b3b94aa11fc99618e1f164135c1722116b8d3966443bbf4b018c81d955be91.webp","width":194,"height":256,"source":"static-detail"},"actors":[{"creditedName":"戸松遥","creatorId":"vndb:s5478","sourcePersonId":"vndb:s5478","canonicalEntityId":"vndb:s5478","name":"戸松 遥","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331486:3235:4856:1","source":"bangumi"}]},{"characterId":"char_bangumi_50613","characterName":"The Count of Monte Cristo／Edmond Dantès","sourceIds":{"bangumi":[{"characterId":"50613","match":"source-roster","subjectId":"331486"}]},"originalCharacterName":"The Count of Monte Cristo／Edmond Dantès","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"185"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"75"}},"descriptions":[{"segments":[{"spoiler":false,"text":"是世界上知名度最高的复仇者。以外号「岩窟王」或「基督山伯爵」广为人们所知。遭到恶毒阴谋的陷害，背上莫须有的罪名，被关进了地狱般的伊夫堡监狱。但拥有钢铁般坚强意志的他并没有绝望，最终获得了基督山小岛上的财宝，回归巴黎——将那些巴黎有权有势的人，也就是当年陷害自己的人拉向地狱。"},{"spoiler":false,"text":"其激烈的人生，隐藏真实身份的复仇剧，对遭践踏被夺走的恋人梅尔塞苔丝的爱恋与执着，以及经历了苦恼与后悔，最终悔改的过程，获得了包括法国在内的世界各地人们的喝彩，并将他作为「世界上最有名的复仇者」记在心中。"},{"spoiler":false,"text":"基督山伯爵虽然是大仲马所创作的故事，但根据现代的考证，发现被关押在伊夫堡监狱，指引爱德蒙的「法利亚神甫」是实际存在的人物……"},{"spoiler":false,"text":"真名是爱德蒙·唐泰斯，但他认为马赛的水手「爱德蒙·唐泰斯」和自己并非同一人物。因为「爱德蒙·唐泰斯」在巴黎完成激烈的复仇后，抛弃了自己的恶行……而作为从者现界的自己，将继续作为「复仇鬼的偶像」而存在。他表示既然如此，那自己就不是爱德蒙。"},{"spoiler":false,"text":"口头禅是「——等待，并心怀希望吧」。"}],"source":"bangumi","sourceCharacterId":"50613"}],"profileFacts":[{"label":"属性","source":"bangumi","sourceCharacterId":"50613","value":"混沌・悪"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd6f131ded16cc5236f044c8c292dd03d5dd9663a165b6b4b6c041015d80be76.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9c2a891944f665a20ae6d7952275c45d5cfa3effca29de30ab79e0146dc30df.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"島﨑信長","creatorId":"vndb:s1248","sourcePersonId":"vndb:s1248","canonicalEntityId":"vndb:s1248","name":"島﨑 信長","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331486:50613:7392:1","source":"bangumi"}]},{"characterId":"char_bangumi_855","characterName":"Arcueid Brunestud","sourceIds":{"bangumi":[{"characterId":"855","match":"source-roster","subjectId":"12056"},{"characterId":"855","match":"source-roster","subjectId":"1908"},{"characterId":"855","match":"source-roster","subjectId":"2865"},{"characterId":"855","match":"source-roster","subjectId":"331486"},{"characterId":"855","match":"source-roster","subjectId":"3344"},{"characterId":"855","match":"source-roster","subjectId":"46874"},{"characterId":"855","match":"source-roster","subjectId":"503518"},{"characterId":"855","match":"source-roster","subjectId":"96131"}]},"originalCharacterName":"Arcueid Brunestud","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1225"},"bust":{"reviewState":"source-only","source":"bangumi","value":"88"},"height":{"reviewState":"source-only","source":"bangumi","value":"167"},"hip":{"reviewState":"source-only","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"55"},"weight":{"reviewState":"source-only","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"生存了八百年以上的吸血鬼，真祖的公主。"},{"spoiler":false,"text":"《月姬》的故事开始时，Arcueid 来到远野志贵所住的城市，目的是消灭数百年来她不断追杀的一名吸血鬼。她在寻找目标时，偶然遇到了志贵；受退魔一族本能支配的志贵跟踪她回住处，以苏醒的杀人技巧和直死之魔眼瞬间将她分割成十七块。身为真祖的她虽然没死，却身受重创；本来想杀死志贵报仇，但在四周都是敌人及身体衰弱的情况下决定迫使志贵协助她。"}],"source":"bangumi","sourceCharacterId":"855"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da40efd006da2711f2096574b19917ec984c762985ee26e0446104bb833af826.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7cb795c2a2bed3088e89113bf48b0e16bb1b5a4791180b9dd6f4646371293c1.webp","width":179,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川育美","creatorId":"vndb:s14378","sourcePersonId":"vndb:s14378","canonicalEntityId":"vndb:s14378","name":"長谷川 育美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331486:855:30858:1","source":"bangumi"}]},{"characterId":"char_bangumi_856","characterName":"遠野 志貴","sourceIds":{"bangumi":[{"characterId":"856","match":"source-roster","subjectId":"12056"},{"characterId":"856","match":"source-roster","subjectId":"1908"},{"characterId":"856","match":"source-roster","subjectId":"2865"},{"characterId":"856","match":"source-roster","subjectId":"331486"},{"characterId":"856","match":"source-roster","subjectId":"3344"},{"characterId":"856","match":"source-roster","subjectId":"46874"},{"characterId":"856","match":"source-roster","subjectId":"503518"},{"characterId":"856","match":"source-roster","subjectId":"96131"}]},"originalCharacterName":"遠野 志貴","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1015"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作的男主角，个性上随和，因为八年前的事件而拥有可杀死万物的“直死之魔眼”。为避免带给脑部过大的负担，平常则是戴着“魔眼杀”的眼镜来抑止。"},{"spoiler":false,"text":"真实身分是退魔者七夜一族，被远野家灭族后发现，因与远野家长子四季名字同音而被收养（也是因为远野慎久想借七夜家遗孤来抑止自己的反转冲动）利用催眠窜改记忆，而当成自己的儿子收养。体能上其实相当优越，不过有偶发性的贫血，外貌看起来就像个文弱书生，和好友乾有彦有相当的深交。"}],"source":"bangumi","sourceCharacterId":"856"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bbc5bdfb535f020c6ed3fd6f5add411403fea4bfcfb392c592d2d727a96a549.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/509f5ee2df39f005aaa59d2a62235df3cf55684e16ca6ee9ffec02d51d2b8ceb.webp","width":256,"height":147,"source":"static-detail"},"actors":[{"creditedName":"金本涼輔","creatorId":"vndb:s14818","sourcePersonId":"vndb:s14818","canonicalEntityId":"vndb:s14818","name":"金本 涼輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331486:856:13529:1","source":"bangumi"}]},{"characterId":"char_bangumi_857","characterName":"遠野 秋葉","sourceIds":{"bangumi":[{"characterId":"857","match":"source-roster","subjectId":"12056"},{"characterId":"857","match":"source-roster","subjectId":"1908"},{"characterId":"857","match":"source-roster","subjectId":"2865"},{"characterId":"857","match":"source-roster","subjectId":"331486"},{"characterId":"857","match":"source-roster","subjectId":"3344"},{"characterId":"857","match":"source-roster","subjectId":"46874"},{"characterId":"857","match":"source-roster","subjectId":"503518"},{"characterId":"857","match":"source-roster","subjectId":"96131"}]},"originalCharacterName":"遠野 秋葉","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0922"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"bust":{"reviewState":"source-only","source":"bangumi","value":"73"},"height":{"reviewState":"source-only","source":"bangumi","value":"160"},"hip":{"reviewState":"source-only","source":"bangumi","value":"79"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"57"},"weight":{"reviewState":"source-only","source":"bangumi","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"远野志贵的妹妹，本作里篇的女主角之一，远野家的现任当家。无论是外表或是礼仪态度上都无懈可击，个性上十分刚强，小时候则是完全相反的柔弱性格。对志贵有相当的执著心，抱有着超越兄妹的感情，志贵回到远野家的也是秋叶的命令。"},{"spoiler":false,"text":"就读隔壁县的浅上女子学院，原本在浅上女子学院住宿，因为志贵搬回而改为通勤上课。在浅上有好友月姬苍香、三泽羽居，与具有未来视能力的学妹濑尾晶三人。"},{"spoiler":false,"text":"远野家实际上是混有鬼之血的一族，偶尔会出现像秋叶名为“红赤朱”的反转现象。红赤朱是远野家出现反转现象时所称之名，此时头发会变红，名为“槛发”，会拥有特殊能力“掠夺”，本作中秋叶用来掠夺对手的热。"}],"source":"bangumi","sourceCharacterId":"857"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e91211b4737d7ddaff8283fab6d5378c5ab0134868312fe6cdd99aaba248d0ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4ad30200d26c896cc5611448b2967731353a7ce72aeed77e0a4cc8827fc3fba.webp","width":74,"height":256,"source":"static-detail"},"actors":[{"creditedName":"下地紫野","creatorId":"vndb:s22716","sourcePersonId":"vndb:s22716","canonicalEntityId":"vndb:s22716","name":"下地紫野","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331486:857:14554:1","source":"bangumi"}]},{"characterId":"char_bangumi_858","characterName":"巫淨 翡翠","sourceIds":{"bangumi":[{"characterId":"858","match":"source-roster","subjectId":"12056"},{"characterId":"858","match":"source-roster","subjectId":"1908"},{"characterId":"858","match":"source-roster","subjectId":"2865"},{"characterId":"858","match":"source-roster","subjectId":"331486"},{"characterId":"858","match":"source-roster","subjectId":"3344"},{"characterId":"858","match":"source-roster","subjectId":"46874"},{"characterId":"858","match":"source-roster","subjectId":"503518"},{"characterId":"858","match":"source-roster","subjectId":"96131"}]},"originalCharacterName":"巫淨 翡翠","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0312"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"bust":{"reviewState":"source-only","source":"bangumi","value":"76"},"height":{"reviewState":"source-only","source":"bangumi","value":"153"},"hip":{"reviewState":"source-only","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"58"},"weight":{"reviewState":"source-only","source":"bangumi","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"远野家的女仆，双子的妹，本作里篇的女主角之一，和姊姊琥珀从小被远野家收养，个性沉默寡言，不擅于表达自己的态度或意见。有着极度的洁癖症，在远野家担任除了厨房外的一切杂务（想自杀请让翡翠做饭=v=）。自从志贵回来后也负责照顾志贵的生活起居，不过有男性恐惧症。"},{"spoiler":false,"text":"翡翠属于两仪、浅神、巫净、七夜四家退魔一族中的巫净家，巫净家的能力不像其他三家仅能透过血缘继承，而可经由知识、技术教授。但翡翠和琥珀则是因为血缘关系而继承其能力。"}],"source":"bangumi","sourceCharacterId":"858"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c990e30861548c1c82fa3c2a85098f652020d7d7dc1f01a523d6f38f2d3dce0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bfd30a2c2e9daa911044aa5df71c4ec748353fefd2e43d08e4401c6420e341c0.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"市ノ瀬加那","creatorId":"vndb:s22715","sourcePersonId":"vndb:s22715","canonicalEntityId":"vndb:s22715","name":"市ノ瀬 加那","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331486:858:31136:1","source":"bangumi"}]},{"characterId":"char_bangumi_859","characterName":"Kohaku","sourceIds":{"bangumi":[{"characterId":"859","match":"source-roster","subjectId":"12056"},{"characterId":"859","match":"source-roster","subjectId":"1908"},{"characterId":"859","match":"source-roster","subjectId":"2865"},{"characterId":"859","match":"source-roster","subjectId":"331486"},{"characterId":"859","match":"source-roster","subjectId":"3344"},{"characterId":"859","match":"source-roster","subjectId":"46874"},{"characterId":"859","match":"source-roster","subjectId":"503518"},{"characterId":"859","match":"source-roster","subjectId":"96131"}]},"originalCharacterName":"Kohaku","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0312"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"bust":{"reviewState":"source-only","source":"bangumi","value":"78"},"height":{"reviewState":"source-only","source":"bangumi","value":"156"},"hip":{"reviewState":"source-only","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"58"},"weight":{"reviewState":"source-only","source":"bangumi","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"远野家的烹饪妇，双子的姊，本作里篇的女主角之一，个性开朗明亮，和沉默的翡翠为正反的存在，但有着悲惨的过去。负责控管远野家金钱使用和健康管理，过去负责照顾远野前当家，因此现在也负责照顾秋叶的生活起居。"},{"spoiler":false,"text":"兴趣是研究药草和种植植物（有毒居多），其房间也是家里唯一有电视、监视器等电器设备的房间。"},{"spoiler":false,"text":"在远野家受害最深的人，早在慎久在生时便被迫受凌辱来抑止他的反转冲动，而现在又为秋叶提供血液抑止她的冲动。"},{"spoiler":false,"text":"琥珀也属于两仪、浅神、巫净、七夜四家退魔一族中的巫净家，巫净家的能力不像其他三家仅能透过血缘继承，而可经由知识、技术教授。但翡翠和琥珀则是因为血缘关系而继承其能力。"}],"source":"bangumi","sourceCharacterId":"859"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6c9f4e9a309a2fdb81737070c00c68af429648ee6834a5f116a02c7620f521c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe0cadccf7787cc4369baf230c194c357948255abd8bd0bd69bd322193000ca8.webp","width":215,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桑原由気","creatorId":"vndb:s14653","sourcePersonId":"vndb:s14653","canonicalEntityId":"vndb:s14653","name":"桑原 由気","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331486:859:15292:1","source":"bangumi"}]},{"characterId":"char_bangumi_861","characterName":"艾莉茜娅","sourceIds":{"bangumi":[{"characterId":"861","match":"source-roster","subjectId":"12056"},{"characterId":"861","match":"source-roster","subjectId":"1908"},{"characterId":"861","match":"source-roster","subjectId":"2865"},{"characterId":"861","match":"source-roster","subjectId":"331486"},{"characterId":"861","match":"source-roster","subjectId":"3344"},{"characterId":"861","match":"source-roster","subjectId":"46874"},{"characterId":"861","match":"source-roster","subjectId":"503518"},{"characterId":"861","match":"source-roster","subjectId":"96131"}]},"originalCharacterName":"艾莉茜娅","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0503"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"bust":{"reviewState":"source-only","source":"bangumi","value":"85"},"height":{"reviewState":"source-only","source":"bangumi","value":"165"},"hip":{"reviewState":"source-only","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"56"},"weight":{"reviewState":"source-only","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"在《月姬》故事中突然出现于远野志贵等人身旁的学姐，就读三年级。对志贵周遭的大小事都相当关心，而志贵在遇到问题时也会寻求她的协助。咖哩魔人，每天三餐吃咖哩。"},{"spoiler":false,"text":"真正身份是埋葬机关中排名第七位的代行者，手持黑键，负责歼灭吸血鬼，拥有卓越的身体能力、魔术能力、庞大知识，以及毫无感情的冷彻。和其他的代行者完全处不来，通常都是单独行动居多。因为罗亚的缘故成为了不死者，自此不断的追杀罗亚。最大武器为第七圣典，概念能力是否定轮回，基本上是对罗亚专用武器。"}],"source":"bangumi","sourceCharacterId":"861"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/2015c196a643de12763a2f5d59b0216c78c70893bffd83073bda2cef67781350.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/7598d1aa093244059643f39314b528766afbbefdbef04584024aee4793f936fa.webp","width":251,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本渡楓","creatorId":"vndb:s12944","sourcePersonId":"vndb:s12944","canonicalEntityId":"vndb:s12944","name":"本渡 楓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331486:861:19560:1","source":"bangumi"}]},{"characterId":"char_bangumi_98606","character