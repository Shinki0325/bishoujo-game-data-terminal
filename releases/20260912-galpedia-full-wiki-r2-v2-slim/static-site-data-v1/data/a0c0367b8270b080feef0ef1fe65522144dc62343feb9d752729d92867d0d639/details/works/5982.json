conflict","source":"bangumi","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美恵の娘。海難事故で父親が行方不明になっているが、母親と同じく、生きて帰ってくると未だに信じている。"},{"spoiler":false,"text":"女手一つで小料理屋を切り盛りする母親を気遣い、最近は店を手伝っている。"},{"spoiler":false,"text":"大人しい母親とは対照的に明るく活発な女の子。またグラマーな母親に似ず、胸が小さく、それがコンプレックスになっている。"}],"source":"egs","sourceCharacterId":"26527","sourceWorkId":"5982","spoiler":false},{"segments":[{"spoiler":false,"text":"美恵の娘。父を海難事故で亡くすが母親と同じく生きて帰ってくると未だに信じている。"},{"spoiler":false,"text":"女手一つで店を切り盛りしている母を気遣い、最近は店を手伝っている。"},{"spoiler":false,"text":"大人しい母とは対照的に活発で行動的な女の子。"},{"spoiler":false,"text":"性格と同じく、母と対照的にぺったんこな胸がコンプレックスになっている。"},{"spoiler":false,"text":"亡くなった父を溺愛しており、本気で「お父さんのお嫁さんになる」と夢見ていた。"},{"spoiler":false,"text":"父の葬儀後も暇さえあれば海岸に足を運んでいる。"}],"source":"bangumi","sourceCharacterId":"117213"}],"profileFacts":[{"label":"胸围（本版本）","value":"72 cm","valueContext":null,"source":"egs","sourceCharacterId":"26527","sourceWorkId":"5982","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"142 cm","valueContext":null,"source":"egs","sourceCharacterId":"26527","sourceWorkId":"5982","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"26527","sourceWorkId":"5982","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"48 cm","valueContext":null,"source":"egs","sourceCharacterId":"26527","sourceWorkId":"5982","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"39 kg","valueContext":null,"source":"egs","sourceCharacterId":"26527","sourceWorkId":"5982","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45cf035e8550868cf0a4b5154fed3494cf3306fab090f27f447982c3e7e8bc28.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10eff8a4b1f535e010e58866e22fa23084a234b02c613d12cbb264abeb9b00f8.webp","width":108,"height":256,"source":"static-detail"},"a