ler":false,"text":"兄の死についても悲しんでいる様子もなく、遺産への関心の方が強い。そのためか保奈美のことを快く思っていないらしく、事あるごとに辛くあたっている。"}],"source":"egs","sourceCharacterId":"26525","sourceWorkId":"5982","spoiler":false},{"segments":[{"spoiler":false,"text":"保奈美の亡くなった夫の妹で、保奈美の義理の妹でもある。"},{"spoiler":false,"text":"兄の死を悲しむ様子も無く、遺産への関心を強く示している。"},{"spoiler":false,"text":"保奈美のことを快く思っていないらしく、事あるごとにつらく当たる。"},{"spoiler":false,"text":"「熟れた人妻」を絵に描いたような女性で、その肉感的なフェロモンで男を骨抜きにする魔性の女。"},{"spoiler":false,"text":"当然持て余すほど巨乳。"},{"spoiler":false,"text":"兄から金をせびり取り、その金で男遊びを繰り返していた。"},{"spoiler":false,"text":"兄の死により、今までのような生活が送れなくなると危機感を覚えている。"}],"source":"bangumi","sourceCharacterId":"117211"}],"profileFacts":[{"label":"年龄（本版本）","value":"34 岁","valueContext":null,"source":"egs","sourceCharacterId":"26525","sourceWorkId":"5982","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"26525","sourceWorkId":"5982","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"26525","sourceWorkId":"5982","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"26525","sourceWorkId":"5982","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"26525","sourceWorkId":"5982","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"55 kg","valueContext":null,"source":"egs","sourceCharacterId":"26525","sourceWorkId":"5982","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd58beb5e924f9081fd96964fbfca62985a4092b5fa52cc7225dc49434bdb28e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3bfdca6bc1d12cfbaeeb2e1e654c9f32db86ec2cbd9a61cd2b8b2a8cdd3488a7.webp","width":109,"height":256,"source":"static-detail"},"actors":[{"cre