{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"9705","model":{"presentationWorkId":"vndb:v4375","staff":{"artwork":[{"creditedName":"あのにむ(bomi)","creatorId":"vndb:s6933","sourcePersonId":"egs:creator:5342","canonicalEntityId":"vndb:s6933","name":"あのにむ(bomi)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:41285","source":"egs"}],"scenario":[],"music":[],"other":[{"creditedName":"ぼみ","creatorId":"vndb:s6933","sourcePersonId":"vndb:s6933","canonicalEntityId":"vndb:s6933","name":"ぼみ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:49479","source":"vndb"}]},"cast":[{"characterId":"char_c2590","characterName":"畠中 志乃","sourceIds":{"bangumi":[{"characterId":"167254","match":"exact-normalized-name-in-linked-work","subjectId":"218186"}],"egsCharacterIds":["19451"],"vndbCharacterId":"c2590"},"originalCharacterName":"畠中 志乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"B"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"青ノ葉学園に通う二年生。主人公と同じクラス。"},{"spoiler":false,"text":"主人公の父親の再婚相手の連れ子で、主人公と同い年だが、主人公よりも一ヶ月ほど生まれが早いため、一応、義姉となる。"},{"spoiler":false,"text":"両親が新婚旅行に旅立ったため、現在は主人公と二人きり。そのため家事は彼女が担当している。"},{"spoiler":false,"text":"ほんわかとした感じの、世話好きで、家庭的な女の子。"},{"spoiler":false,"text":"低血圧なのか朝が弱く、立場上、主人公が起こす役目になっている。"},{"spoiler":false,"text":"海水浴が好きで、近くの海によく泳ぎにゆく。"},{"spoiler":false,"text":"何故か、元の姓である「畠中」を名乗っている"},{"spoiler":false,"text":"「一度でいいから「お姉ちゃん」って呼んでくれないかな？」"}],"source":"egs","sourceCharacterId":"19451","sourceWorkId":"9705","spoiler":false},{"segments":[{"spoiler":false,"text":"青ノ葉学園に通う2年生。同級生。父親の再婚相手の娘、一ヶ月違いの誕生日の差で姉とよぶことになった、同じ歳、同じクラスの女の子。父親と母親が新婚旅行に行ってしまったため、主人公の家で家事全般をやっている。"},{"spoiler":false,"text":"唯一の弱点は朝が弱いこと。立場上、主人公が起こす役目を果たす。"},{"spoiler":false,"text":"学園の教師は2人が一緒に住んでいることを承知しているが、学生たちの間で知っている者はいない。そのため、正臣と一緒に登校するが、途中で時間をズラして、別々に学園へ到着するようにしている。"},{"spoiler":false,"text":"なぜか元の姓である「畠中」のまま。女の子らしく、家庭的で穏和な性格。"},{"spoiler":false,"text":"海水浴が好きで、水着に着替えてよく海岸にいる。"}],"source":"bangumi","sourceCharacterId":"167254"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"19451","sourceWorkId":"9705","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"19451","sourceWorkId":"9705","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"19451","sourceWorkId":"9705","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"19451","sourceWorkId":"9705","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c284608136cb2145a6bae27b7a1ad34ca1e178ef0df98cc9b58dea4f1a0a82d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a243702e29b7aa5c3b78aee41c5820ed6b478772ae407032c6dadb1a55563707.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218186:167254:4463:1","source":"bangumi"},{"creditedName":"青葉 りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:27430","source":"vndb"}]},{"characterId":"char_c2591","characterName":"香坂 美憂","sourceIds":{"bangumi":[{"characterId":"167257","match":"exact-normalized-name-in-linked-work","subjectId":"218186"}],"egsCharacterIds":["19452"],"vndbCharacterId":"c2591"},"originalCharacterName":"香坂 美憂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"AB"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"青ノ葉学園に通う二年生。主人公と同じクラス。バトン部に所属。"},{"spoiler":false,"text":"主人公が東京で暮らしていたときの幼馴染で、偶然にも同じ学校、同じクラスになる。"},{"spoiler":false,"text":"明るく活発な女の子。しかしこっちの暮らしに馴染めないのか、主人公と再会した時には暗い顔をしていた。主人公が引っ越してきたことで、昔の明るさを取り戻した。"},{"spoiler":false,"text":"手よりも足が先に出るタイプで、よく主人公を思いきり蹴っ飛ばそうとするが、ヒラリとかわされる。"},{"spoiler":false,"text":"チャーハンにはこだわりがあるらしく、パラッとしていないチャーハンは許せないらしい。"},{"spoiler":false,"text":"「問答無用！　武力制裁！」"}],"source":"egs","sourceCharacterId":"19452","sourceWorkId":"9705","spoiler":false},{"segments":[{"spoiler":false,"text":"青ノ葉学園に通う2年生。同級生。正臣が東京にいたとき、幼なじみだった女の子。偶然にも同じクラスとなる。"},{"spoiler":false,"text":"活発な女の子で、バトン部に所属している。バトン部には体力が重要ということで、高低差のあるこの町中をよく走っている。正臣とはよく衝突することも多いが、本当は優しくて寂しがりや。"},{"spoiler":false,"text":"一年前に正臣と同じ都会から越してきたが、いまひとつ地元になじめず寂しい想いをしていた。しかし、正臣が引っ越してきたことで、持ち前の明るさが復活する。"},{"spoiler":false,"text":"「窓際で外を眺めては、悩ましげなため息をつく少し陰のある女の子」から「転校生を足蹴にする活発な女の子」へと変化。手より速く蹴りが出るタイプ。正臣は避けられると分かっているので、いつも手加減なしに蹴ってくる。幼なじみと言うことで、美憂の両親と正臣は知り合い。息子が欲しかったという美憂の父に正臣はかわいがられている。"}],"source":"bangumi","sourceCharacterId":"167257"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"19452","sourceWorkId":"9705","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"19452","sourceWorkId":"9705","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"19452","sourceWorkId":"9705","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"19452","sourceWorkId":"9705","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61918b04d2b4ef2bf3788bf0e12fce2a64a148e0f542d21bb4403a3c8a21a603.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00bd9594834ed085ff19f3c1be4fbd40548f63193227278bf86cf2ce0c8cd2e0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218186:167257:4432:1","source":"bangumi"}]},{"characterId":"char_c2592","characterName":"三野 稚葉","sourceIds":{"bangumi":[{"characterId":"167258","match":"exact-normalized-name-in-linked-work","subjectId":"218186"}],"egsCharacterIds":["19453"],"vndbCharacterId":"c2592"},"originalCharacterName":"三野 稚葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"A"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"青ノ葉学園に通う三年生。外見的には主人公の下級生にしか見えないが、立派（？）な上級生。"},{"spoiler":false,"text":"神社の娘で、時々、神社の手伝いをしている。"},{"spoiler":false,"text":"髪が伸び放題で、いつも目にかかっているため、ときどき片目が見える程度。両目が同時に見られることは奇跡に近い（？）。本人は美容院に行きたいと思っているらしいが、なかなか勇気が出せず、その夢は叶っていない。"},{"spoiler":false,"text":"読書が大好きで、図書館での遭遇率が高い。"},{"spoiler":false,"text":"また青ノ葉町に古くから伝わる古書を探しているらしい。"},{"spoiler":false,"text":"「何か胸がドキドキするの！　だけど、本に書いてなくて！　どうしたらいいのか、わからなくて。」"}],"source":"egs","sourceCharacterId":"19453","sourceWorkId":"9705","spoiler":false},{"segments":[{"spoiler":false,"text":"青ノ葉学園に通う3年生。下級生にしか見えない外見。髪の毛がいつも目にかかっていて、目を見ることがあまりない女の子。本人はいつか美容室に行きたいと思っているのだが、なかなか勇気を出せずにいる。"},{"spoiler":false,"text":"青ノ葉町に古くから伝わる古書の手がかりを探している。その古書に昔この神社で行われていた神楽のことが記載されているらしい。 家が神社であり、よく山の上の鳥居付近にいる。時々、神社の手伝いをしている。なお、神社は夏休みの最大のイベントである夏祭りの会場にもなっている。"},{"spoiler":false,"text":"図書館にいることが多く、いつも本を5～6冊持っている稚葉に出会うときが多い。ときどき可愛らしい片目だけ見えるが、両目を同時にみた人はいないという話！"}],"source":"bangumi","sourceCharacterId":"167258"}],"profileFacts":[{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"19453","sourceWorkId":"9705","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"148 cm","valueContext":null,"source":"egs","sourceCharacterId":"19453","sourceWorkId":"9705","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"19453","sourceWorkId":"9705","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"19453","sourceWorkId":"9705","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/275544d3337f862114b31cd7de5b02cfaae9f7dac1c8f6fe6a5f6122510035ef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11710daa8d09b150139de1fc83fe70b4d902da4261e1b5e243f0a2cd59741382.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雪野梨沙","creatorId":"vndb:s1610","sourcePersonId":"vndb:s1610","canonicalEntityId":"vndb:s1610","name":"雪野 梨沙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218186:167258:5903:1","source":"bangumi"}]},{"characterId":"char_c2593","characterName":"畠中 由莉","sourceIds":{"bangumi":[{"characterId":"167259","match":"exact-normalized-name-in-linked-work","subjectId":"218186"}],"egsCharacterIds":["19454"],"vndbCharacterId":"c2593"},"originalCharacterName":"畠中 由莉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"B"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同時期に転校してきた、青ノ葉学園に通う一年生。畠中志乃の従妹。"},{"spoiler":false,"text":"元々は全寮制のお嬢様学校に通っていたが、大好きな志乃が、何処の馬の骨かもわからない男子と一緒に暮らすと聞いて、全寮制の学校を退学し、青ノ葉学園へとやってきた。そして、適当な理由をくっ付け、主人公と志乃の家に押し掛けてくる。しかし主人公に一目惚れしてしまい、当初の目的とは正反対に猛烈なアタックを仕掛けてくる。"},{"spoiler":false,"text":"普段はお嬢様然とした態度をとっているが、それは猫っかぶりをしているだけで、本当の彼女は……。"},{"spoiler":false,"text":"「じゃあ、お兄ちゃんって呼んでいい？　一緒に水着を買いに行こうよ。」"}],"source":"egs","sourceCharacterId":"19454","sourceWorkId":"9705","spoiler":false},{"segments":[{"spoiler":false,"text":"正臣と同時期に転校してきた、青ノ葉学園に通うようになる1年生。下級生。畠中志乃の従妹。全寮制のお嬢様学校に通っていたが、猫をかぶるのに飽きていた。そんな折りに、伯母が再婚、大好きな従姉とどこかの男子が同棲という話を聞いて、勝手に全寮制学校を退学、青ノ葉学園に転入届けを出した行動力のありすぎる女の子。"},{"spoiler":false,"text":"正臣と同時期にこの町にやって来て正臣の家に転がり込んでくる。「だって、若い二人に過ちがあったらマズイでしょ」というタテマエで正臣の両親を説得した。"},{"spoiler":false,"text":"正臣を大好きな従姉に近づくロクでもないやつだろうと思ってやってきたが、出会い時のエピソードで一目惚れ。ほんわかしてる従姉と正反対で、男女の色恋沙汰には色々と詳しい。全寮制学校のお嬢様とおもいきや、色々と大胆で好奇心旺盛な女の子。"}],"source":"bangumi","sourceCharacterId":"167259"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"19454","sourceWorkId":"9705","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"19454","sourceWorkId":"9705","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"19454","sourceWorkId":"9705","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"19454","sourceWorkId":"9705","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee5fa09b85b40175683e627d10e573caa6872892a148160e010e0dee7511790b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8ffb299b419e0289f90f031d2cf02b655e94f4294ed9c218751cb70b762528e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218186:167259:5922:1","source":"bangumi"},{"creditedName":"草柳 順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:27431","source":"vndb"}]},{"characterId":"char_c2594","characterName":"江野本 まどか","sourceIds":{"bangumi":[{"characterId":"167260","match":"exact-normalized-name-in-linked-work","subjectId":"218186"}],"egsCharacterIds":["19455"],"vndbCharacterId":"c2594"},"originalCharacterName":"江野本 まどか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"A"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"青ノ葉学園の教師。日本史教師。主人公の担任。図書委員会顧問。"},{"spoiler":false,"text":"風土などの歴史などを専門とし、青ノ葉町の研究などをしている。"},{"spoiler":false,"text":"優しく美人で、巨乳なことから男子たちから女神のように慕われている。"},{"spoiler":false,"text":"意外に夢見がちな女性で、マンボウに掴まって太平洋横断をしたい、という無謀な夢を抱き、それを語る。"},{"spoiler":false,"text":"「マンボウは、なんであんなに優雅なんでしょう！　あの背びれにつかまりたいですね。」"}],"source":"egs","sourceCharacterId":"19455","sourceWorkId":"9705","spoiler":false},{"segments":[{"spoiler":false,"text":"青ノ葉学園の教師。専門は風土などの歴史（日本史教師）。青ノ葉町の研究などをしている。目は細く、線目で優しい女性だが、驚いたり感情が出たりすると、黒目が見える。"},{"spoiler":false,"text":"大きな胸を気にしているので、何とか小さい胸にしようと、ワンサイズ小さいブラや服を着ている。が、結果的に胸が○調されることとなり、男子にとって女神のような女性教師。"},{"spoiler":false,"text":"いつかマンボウにつかまって太平洋を横断したい、という無謀な夢をよく語る。だが、修士課程を修了している才媛。"},{"spoiler":false,"text":"主人公の担任。図書委員会顧問。海でのんびりと泳ぐのが好き。"}],"source":"bangumi","sourceCharacterId":"167260"}],"profileFacts":[{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"19455","sourceWorkId":"9705","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"19455","sourceWorkId":"9705","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"19455","sourceWorkId":"9705","sourceField":null,"scoped