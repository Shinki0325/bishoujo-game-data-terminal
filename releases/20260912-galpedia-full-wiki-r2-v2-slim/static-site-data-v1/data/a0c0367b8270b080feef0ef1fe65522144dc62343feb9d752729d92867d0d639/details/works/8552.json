"sourceCharacterId":"c82571"},{"segments":[{"spoiler":false,"text":"帝国発展に貢献する様々な発明をおこなった、機関科学者、数学者。"},{"spoiler":false,"text":"若年でありながら、蒸気王・バベッジの再来と噂される頭脳を持つ天才。"}],"source":"egs","sourceCharacterId":"9195","sourceWorkId":"16422","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da70ebe9827dddc0fe5bc348714bf26b235dc5ce578fe5e6ee67e48bc0db209e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/474e7355032b28482aff8df8e1e64dc404d4bde7b5d163e4ab06afc747087808.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金田 まひる","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:6085","source":"vndb"}]},{"characterId":"char_vndb_c114608","characterName":"ミュト","sourceIds":{"vndbCharacterId":"c114608"},"originalCharacterName":"ミュト","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d49739eb29890c5099c18a88b0783cf40e0df17a6fb0b799b2960dd1e93edfc0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/721040989ddb40aa6dbddf9926c8ace0a12ce64184c5c5dadbf4d1e2195d0b05.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c114622","characterName":"ルダ","sourceIds":{"vndbCharacterId":"c114622"},"originalCharacterName":"ルダ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only",