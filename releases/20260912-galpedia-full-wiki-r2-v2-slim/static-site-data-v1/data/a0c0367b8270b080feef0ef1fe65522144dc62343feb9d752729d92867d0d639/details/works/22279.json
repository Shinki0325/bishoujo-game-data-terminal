d":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:189289:28652:11646:1","source":"bangumi"}]},{"characterId":"char_c35679","characterName":"一ノ瀬 穂波","sourceIds":{"bangumi":[{"characterId":"36660","match":"exact-normalized-name-in-linked-work","subjectId":"137782"},{"characterId":"36660","match":"exact-normalized-name-in-linked-work","subjectId":"221745"}],"egsCharacterIds":["7294"],"vndbCharacterId":"c35679"},"originalCharacterName":"一ノ瀬 穂波","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"629"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class: 1-B"},{"spoiler":false,"text":"The protagonist's underclassman who transferred on the same day, she is serious and polite, not to mention an honor student. She isn't accustomed to living away from her parents, which is why she often feels very lonely. Honami is tad bit tsundere towards people because she doesn't know how to socialize with them. After spending some time with the protagonist, in her mind, he turns from her \"senpai\" into \"a man\". She has no knowledge of perverted stuff, and becomes red in the face whenever the topic is brought up."},{"spoiler":false,"text":"In Amakano ~Second Season~+:"},{"spoiler":false,"text":"Bust-Waist-Hips: 87-56-85cm"},{"spoiler":false,"text":"Cup size: F"}],"source":"vndb","sourceCharacterId":"c35679"},{"segments":[{"spoiler":false,"text":"同日に転入してきた後輩で、真面目で丁寧な優等生然とした女の子だが、両親に甘えるのを我慢してきた境遇を持つ、素直になれない寂しがり屋。"},{"spoiler":false,"text":"周りとの接し方がわからず、照れ隠しにツンツンしてしまう部分がある。"},{"spoiler":false,"text":"出会った当初は攻撃的な状態にあるものの、何度もたすけてもらったことや、一緒に過ごす楽しさから、徐々に『先輩』さらには『一人の男性』として惹かれていく。"},{"spoiler":false,"text":"付き合い始めは周りを気にして素っ気ないが、素直な気持ちになった後は家に押しかけるほどべったりな甘えん坊になる。"},{"spoiler":false,"text":"えっちな知識はほぼなく、ちょっとしたことでも真っ赤になるウブな面も。"}],"source":"egs","sourceCharacterId":"7294","sourceWorkId":"22177","spoiler":false},{"segments":[{"spoiler":false,"text":"受験勉強でのために一人暮らしを始めたあなたに、お世話をしたいと通ってくれる恋人。"},{"spoiler":false,"text":"『通い妻』という響きに表向きは意地っ張りで強がる彼女だが、心の奥では照れている。"},{"spoiler":false,"text":"甲斐甲斐しく勉強に食事にサポートしてくれつつ、甘えたくてしょうがない恋人っぷりをたっぷり発揮してくれる。"}],"source":"egs","sourceCharacterId":"7294","sourceWorkId":"23565","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同日に転入してきた後輩。 まじめで丁寧、優等生然とした女の子。"},{"spoiler":false,"text":"両親に甘えるのを我慢してきた境遇があり、なかなか素直になれない寂しがり屋。"},{"spoiler":false,"text":"人との接し方が分からず、照れ隠しについツンツンしてしまう。"},{"spoiler":false,"text":"主人公と一緒に過ごすうちに、“先輩” から “一人の男性” として意識し始める。"},{"spoiler":false,"text":"付き合い始めは周りを気にして素っ気ないが、素直になった後はべったりな甘えん坊になる。"},{"spoiler":false,"text":"エッチの知識はほぼなく、ちょっとしたことでも真っ赤になるウブな面もある。"},{"spoiler":false,"text":"「付き合ってください……じゃなくて、つ、付き合ってあげます！」"}],"source":"bangumi","sourceCharacterId":"36660"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e77e82a26ee3e538e6250fba07a465398f5caa9d8ae56275503f585fb0e0e3b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec1a283946db4fc286bf17b78133f645d25e83cbc5733b98fac8f0ca0913e9ba.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"波奈束 風景","creatorId":"vndb:s44","sourcePersonId":"vndb:s44","canonicalEntityId":"vndb:s44","name":"中島 沙樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70590","source":"vndb"}]},{"characterId":"char_c35680","characterName":"沓野 奏","sourceIds":{"bangumi":[{"characterId":"36661","match":"exact-normalized-name-in-linked-work","subjectId":"137782"},{"characterId":"36661","match":"exact-normalized-name-in-linked-work","subjectId":"221745"}],"egsCharacterIds":["7295"],"vndbCharacterId":"c35680"},"originalCharacterName":"沓野 奏","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1017"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"151"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class: 1-B"},{"spoiler":false,"text":"A girl on a wheelchair who lives at her grandparents' house which also serves as a hot springs inn. She used to be a very kind and content girl, but turned into a very mischievous little devil. Despite being bad at studying, Kanade makes up it by being a very friendly girl. Kanade is always very grateful, as she has been living her life by the help of the others due to her disability. Due to this, she often thinks asking help might burden the people around her. She calls the protagonist \"oni-sama.\""},{"spoiler":false,"text":"In Amakano ~Second Season~+:"},{"spoiler":false,"text":"Bust-Waist-Hips: 84-54-83cm"}],"source":"vndb","sourceCharacterId":"c35680"},{"segments":[{"spoiler":false,"text":"車いす少女で、湯治を兼ねて祖父母の家である旅館『縁嬉』に長期で暮らしている。"},{"spoiler":false,"text":"同居人になる後輩で、清純で物静かな深層の令嬢を思わせるが、お固い性格ではなく、冗談を言ったりイタズラしたりと、小悪魔な部分もある優しい女の子。"},{"spoiler":false,"text":"皆の手を借りて生活をしているという思いが強く、常に感謝を忘れない。勉強はできないが、人の感情を機敏に感じ取ることができる。"},{"spoiler":false,"text":"反面、迷惑がかかると思うと縮こまってしまうことが多い。"},{"spoiler":false,"text":"同居人として面倒を見ていく中で次第に「お兄さま」と慕ってくれるようになる。"},{"spoiler":false,"text":"今はリハビリの途中で、早く歩けるようになろうと努力をしている頑張り屋。"}],"source":"egs","sourceCharacterId":"7295","sourceWorkId":"22177","spoiler":false},{"segments":[{"spoiler":false,"text":"リハビリのかいあって、歩行も杖なしでも日常に支障がないほど回復。"},{"spoiler":false,"text":"小悪魔っぷりは相変わらずだが、大好きなあなたとの日々をいつも楽しんでくれている。"},{"spoiler":false,"text":"学園卒業後は結婚し、新妻な生活を満喫つつ、女将修行をしている。"},{"spoiler":false,"text":"仕事はすでにほぼ完璧にこなせるようになっているものの……？"}],"source":"egs","sourceCharacterId":"7295","sourceWorkId":"23565","spoiler":false},{"segments":[{"spoiler":false,"text":"車椅子少女で、湯治を兼ねて祖父母の家である旅館・縁嬉で暮らしている後輩。"},{"spoiler":false,"text":"清純で物静かな深窓の令嬢を思わせるが、冗談を言ったりイタズラしたりと小悪魔な部分もある。"},{"spoiler":false,"text":"勉強はできないが、人の感情を機敏に感じ取ることができる優しい女の子。"},{"spoiler":false,"text":"皆の手を借りて生活しているという思いが強く、常に感謝を忘れない。"},{"spoiler":false,"text":"しかし人に迷惑が掛かると思うと、つい縮こまってしまうことも多い。"},{"spoiler":false,"text":"同居人として面倒を見ていくうちに、「お兄さま」 と慕ってくるようになる。"},{"spoiler":false,"text":"「お兄さまに平然と甘えるぐらいは小悪魔です♪」"}],"source":"bangumi","sourceCharacterId":"36661"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efd3538539633f771eec82a9f62ab21f548d85fc54320b357e50eb251fa2866a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1d7cea817f024811603417b2f12ad18a90cacf58c047e457ec81483b447d057.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桃山 いおん","creatorId":"vndb:s1197","sourcePersonId":"vndb:s1197","canonicalEntityId":"vndb:s1197","name":"長妻 樹里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70597","source":"vndb"}]},{"characterId":"char_c35681","characterName":"図書館の座敷童","sourceIds":{"bangumi":[{"characterId":"36662","match":"exact-normalized-name-in-linked-work","subjectId":"137782"},{"characterId":"36662","match":"exact-normalized-name-in-linked-work","subjectId":"221745"}],"egsCharacterIds":["7296"],"vndbCharacterId":"c35681"},"originalCharacterName":"図書館の座敷童","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"209"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class: 2-A"},{"spoiler":false,"text":"The protagonist's classmate who is called \"the library's zashiki-warashi\". She is very shy and whenever she's in a hurry, she writes her thoughts into a notebook instead of talking. Loves both knowledge and books, and has a habit of having delusions. Yuzuka usually doesn't speak because she is almost always holed up in the library and wants to follow its rules, however, in reality, she'd like to have somebody to have leisure chats with. She is the younger daughter to the town's famous Takayashiki Temple, where she works as a shrine maiden."},{"spoiler":false,"text":"In Amakano ~Second Season~+:"},{"spoiler":false,"text":"Bust-Waist-Hips: 94-57-89cm"}],"source":"vndb","sourceCharacterId":"c35681"},{"segments":[{"spoiler":false,"text":"「図書館の座敷童」と呼ばれる図書委員の同級生。物静かで引っ込み思案。"},{"spoiler":false,"text":"恥ずかしがり屋のはにかみ屋で赤面症。焦るとカミカミになるため、焦った時は持っているノートで会話することもある。"},{"spoiler":false,"text":"無口だが、本当は感情豊かで、考えすぎて言いたいことを言えなくなっている。"},{"spoiler":false,"text":"さらに涙もろく、感情が高ぶるとすぐ泣いてしまう性格もあり、普段は図書室にこもって、人とはあまり接しないようにしている。"},{"spoiler":false,"text":"だが心の奥底では、のんびりおしゃべりしたいと思っている。"},{"spoiler":false,"text":"本が大好きで知識も多いためか、妄想が突っ走る一面もある。"},{"spoiler":false,"text":"家は、街で有名な高社神社であり、一つ上の姉がいる。"}],"source":"egs","sourceCharacterId":"7296","sourceWorkId":"22177","spoiler":false},{"segments":[{"spoiler":false,"text":"卒業後、あなたと結婚。司書の資格をとるために大学に進学。"},{"spoiler":false,"text":"二人で白鷺市内にアパートを借りて暮らしている。"},{"spoiler":false,"text":"相変わらずの本好きだが、だんなさまと一緒にする新体験はいつでもワクワクしている。"},{"spoiler":false,"text":"学生なのに新妻ということが嬉しい様子。妻としての自覚をもっているものの、少し突っ走るいつもの可愛らしさも健在。"}],"source":"egs","sourceCharacterId":"7296","sourceWorkId":"23565","spoiler":false},{"segments":[{"spoiler":false,"text":"“図書館の座敷童” と呼ばれている図書委員の同級生。"},{"spoiler":false,"text":"物静かで引っ込み思案。 恥ずかしがり屋で、焦るとカミカミになるためノートで会話することも。"},{"spoiler":false,"text":"本が大好きで知識も多いため、妄想が突っ走る一面もある。"},{"spoiler":false,"text":"普段は図書室にこもって人とあまり接しないようにしているが、"},{"spoiler":false,"text":"本当は誰かとのんびりおしゃべりしたいと思っている。"},{"spoiler":false,"text":"家は町で有名な 高社神社 で、一つ上の姉がいる。"},{"spoiler":false,"text":"「図書館では静かにして…… うぅっ、ばかぁ……」"}],"source":"bangumi","sourceCharacterId":"36662"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e6d6a9d11c82f0aa255b1a3cd08e6e193fc773acadafde885c2c411134117b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b2db1f66616393cda5ce95f714dc18f17f0ad82b37213d192886de15ae916f8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松田 理沙","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70592","source":"vndb"}]},{"characterId":"char_c35682","characterName":"硯川・e・涙香","sourceIds":{"bangumi":[{"characterId":"36663","match":"exact-normalized-name-in-linked-work","subjectId":"137782"},{"characterId":"36663","match":"exact-normalized-name-in-linked-work","subjectId":"221745"}],"egsCharacterIds":["7297"],"vndbCharacterId":"c35682"},"originalCharacterName":"硯川・e・涙香","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"414"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class: 3-B"},{"spoiler":false,"text":"The student council president who is always taking care of the whole student body and has an older sister-like personality. She loves having fun, and has a lot of charisma to match her personality. Despite missing some things, she has made them up with her hard work and wit. She is rumored to be a flashy lover, but in fact, spends her free time watching the animals in nearby lakes and even playing with them."},{"spoiler":false,"text":"In Amakano ~Second Season~+:"},{"spoiler":false,"text":"Bust-Waist-Hips: 93-59-95cm"},{"spoiler":false,"text":"Cup size: G"}],"source":"vndb","sourceCharacterId":"c35682"},{"segments":[{"spoiler":false,"text":"学生会長の先輩でいつも学生のことを考えている面倒見のいいお姉さん。"},{"spoiler":false,"text":"楽しいことが大好きで、高い行動力とカリスマで学生たちにも慕われている。"},{"spoiler":false,"text":"何かと相談に乗ってくれる頼りになる会長だが、実は見た目に反してけっこう抜けているところがあるものの、機転と努力でカバーしている。"},{"spoiler":false,"text":"派手好きと思われているが、実はちまちました作業が好き。"},{"spoiler":false,"text":"時間があると常連の『こはるびより』でみかんの皮を動物の形にして去っていく。"},{"spoiler":false,"text":"クールで可愛いお姉さんと、自信のないへっぽこお姉さんの二面性を持ち、その裏の顔を知ってしまったことから「共犯者」へとなっていくことになる"}],"source":"egs","sourceCharacterId":"7297","sourceWorkId":"22177","spoiler":false},{"segments":[{"spoiler":false,"text":"こはるびよりでバイトしつつ大学生活を楽しんでいるが、一番楽しみなのはあなたと過ごす時間。"},{"spoiler":false,"text":"そのため普段から、部屋に寝泊まりすることが以前に増して増えている。"},{"spoiler":false,"text":"元学生会長のプライドなのか、甘える時以外の日々の生活はかなりしっかりしているものの、相変わらずへっぽこなところはそれもまた魅力。"}],"source":"egs","sourceCharacterId":"7297","sourceWorkId":"23565","spoiler":false},{"segments":[{"spoiler":false,"text":"学生会長の先輩で、いつも学生のことを考えている面倒見のいいお姉さん。"},{"spoiler":false,"text":"楽しいことが大好きで、高い行動力とカリスマ性でみんなから慕われている。"},{"spoiler":false,"text":"実は結構ヌケているところもあるのだが、機転と努力でカバーしている。"},{"spoiler":false,"text":"派手好きと思われているが、実はちまちました作業が好き。"},{"spoiler":false,"text":"甘味処・こはるびより の常連で、暇な時はみかんの皮を動物の形にして遊んでいる。"},{"spoiler":false,"text":"“クールで可愛いお姉さん” と、“自信のないへっぽこお姉さん” の二面性を持ち、"},{"spoiler":false,"text":"その裏の顔を知ってしまったことから “共犯者” になっていくことになる。"},{"spoiler":false,"text":"「ふふっ、会長さんのいい考えにまかせなさい♪」"}],"source":"bangumi","sourceCharacterId":"36663"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5b44daa2279a1b1e5cafc452c34f8be6be4a57e28c09688b6b38d5ac865b9b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fe480caeaca4e8e55382206fbe8a9f2be97e9ca66060dd28cd16bc0bf3be0d4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一色 ヒカル","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70589","source":"vndb"}]},{"characterId":"char_vndb_c153982","characterName":"須賀川 ひより","sourceIds":{"vndbCharacterId":"c153982"},"originalCharacterName":"須賀川 ひより","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":