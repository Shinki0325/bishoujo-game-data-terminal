ctor","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:139636","source":"vndb"}]},"cast":[{"characterId":"char_c61943","characterName":"姫神 亜梨栖","sourceIds":{"bangumi":[{"characterId":"54587","match":"exact-normalized-name-in-linked-work","subjectId":"212413"}],"egsCharacterIds":["16837"],"vndbCharacterId":"c61943"},"originalCharacterName":"姫神 亜梨栖","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"920"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"行方不明になっている姉・静の行方を捜すため、宗司を伴って新座島の『神坐学園』へと編入してくる。世界的に名の知れた『姫神財閥』の令嬢でありながら、姉の失踪をひた隠しにする姫神家のことを良く思っていない。"},{"spoiler":false,"text":"なにをやらせても人並み以上にこなす才女で、数々のコンクールを総ナメにしてきた経歴を評価され、学園に招かれた。"},{"spoiler":false,"text":"常に冷静かつ物怖じしない性格であり頭の回転も速く、交渉事や駆け引きなど、宗司とのコンビでは頭脳担当。宗司とは子供の頃にある事件をきっかけに知り合い、それ以後は定期的に交流を重ね、夏休みには実家を離れ出雲家に長期滞在するのが定番だった。"}],"source":"egs","sourceCharacterId":"16837","sourceWorkId":"24467","spoiler":false},{"segments":[{"spoiler":false,"text":"行方不明になっている姉・静の行方を捜す大財閥の令嬢。"},{"spoiler":false,"text":"何をやらせても人並み以上にこなす才女で、数々のコンクールを総ナメにしている。"},{"spoiler":false,"text":"常に冷静かつ物怖じしない性格で頭の回転も速い。"},{"spoiler":false,"text":"主人公・宗司とは子供の頃にある事件をきっかけに知り合い、以来交流を重ねている。"},{"spoiler":false,"text":"宗司とのコンビでは交渉事や駆け引きなど頭脳担当。"},{"spoiler":false,"text":"「……よろしくお願いするわ。 あそこでは、宗司だけが頼りだから」"}],"source":"bangumi","sourceCharacterId":"54587"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"16837","sourceWorkId":"24467","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"16837","sourceWorkId":"24467","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"16837","sourceWorkId":"24467","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"16837","sourceWorkId":"24467","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d7a0b02a20366efac907b4d4d930f7eba83f5e43b270298d228bbf4bca010f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd559941e695c3d21755b37c408406c0cfe271ff4ffbf2f5eddfb5b11548c807.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:212413:54587:4956:1","source":"bangumi"}]},{"characterId":"char_c61944","characterName":"綺堂 悠里","sourceIds":{"bangumi":[{"characterId":"54588","match":"exact-normalized-name-in-linked-work","subjectId":"212413"}],"egsCharacterIds":["16838"],"vndbCharacterId":"c61944"},"originalCharacterName":"綺堂 悠里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"528"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Arisu's childhood friend."}],"source":"vndb","sourceCharacterId":"c61944"},{"segments":[{"spoiler":false,"text":"亜梨栖とは昔からお互いを知っている友人。 予科の頃に島に招待されており、神坐学園本科に編入してきた亜梨栖と再会を果たす。 宗司・亜梨栖とはクラスメイトで、島に慣れない二人の手助けをしてくれる。 箱入り娘として育てられてきたため、宗司とは違う意味でやや世間に疎い。 おっとりとしたやや消極的な性格で、亜梨栖とは対照的。 弓道を嗜んでおり、見た目からは想像つかないような強弓も軽々と引くが、 とある事情により現在は弓道部の活動には参加していない。 ユーリエとは名前が似ているという縁から仲が良く、形式上はユーリエの派閥に所属していることになっている。"}],"source":"egs","sourceCharacterId":"16838","sourceWorkId":"24467","spoiler":false},{"segments":[{"spoiler":false,"text":"亜梨栖とは既知の友人。 学園には予科から入学している。"},{"spoiler":false,"text":"宗司・亜梨栖とはクラスメイトになり、島に慣れない二人の手助けをしてくれる。"},{"spoiler":false,"text":"箱入り娘でおっとりとしたやや消極的な性格。"},{"spoiler":false,"text":"弓道を嗜んでおり強弓も軽々と引くが、 とある事情により現在は休部している。"},{"spoiler":false,"text":"ユーリエとは名前が似ているという縁から仲が良く、彼女の派閥に所属している。"},{"spoiler":false,"text":"「じゃあわたしも亜梨栖ちゃんと同じでいいよ。 そっちのほうがお友達って感じもするしね」"}],"source":"bangumi","sourceCharacterId":"54588"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"16838","sourceWorkId":"24467","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"16838","sourceWorkId":"24467","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"16838","sourceWorkId":"24467","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"16838","sourceWorkId":"24467","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f9a5fbce05560279b1cb88ace0c7f348d12cad0d893140336b21c6f830f484c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa4cfd753f170b4f01f4e63ef52ca1d9d7fd0f42ab81768b7400deff01501593.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間宮菜南子","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:212413:54588:15995:1","source":"bangumi"}]},{"characterId":"char_c61945","characterName":"ユーリエ・フォン・フェルトベルグ","sourceIds":{"bangumi":[{"characterId":"54589","match":"exact-normalized-name-in-linked-work","subjectId":"212413"}],"egsCharacterIds":["16839"],"vndbCharacterId":"c61945"},"originalCharacterName":"ユーリエ・フォン・フェルトベルグ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1116"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ドイツ貴族の末裔の令嬢。宗司・亜梨栖のクラスメイト。 ドイツ生まれのドイツ育ち。幼い頃は家柄にふさわしくないという理由で、 一般的なフィクションやサブカルチャーを徹底的に禁止されていたが、島である程度の自由を得た事と、 日本について手っ取り早くフィクションで学んだため、反動でどっぷりと浸かってしまった。日本の文化や言葉については深い造詣を持っている 一方で少し間違った日本観も身についてしまっており、日本の漫画をはじめとしたサブカルチャー文化やニンジャ・サムライという要素に過剰な興味と憧れを抱いている。 端麗な容姿や不思議な空気に惹かれ、学園ではクローデットの『派閥』に次ぐ大きなグループを形勢している。噂では『不思議な力』を持っていると言われいるが、それを実際に見たという者はほとんどいない。"}],"source":"egs","sourceCharacterId":"16839","sourceWorkId":"24467","spoiler":false},{"segments":[{"spoiler":false,"text":"ドイツ貴族の末裔の令嬢。 宗司・亜梨栖のクラスメイト。"},{"spoiler":false,"text":"厳格に育てられたが島で自由を得て、日本のサブカルチャーにどっぷり浸かってしまった。"},{"spoiler":false,"text":"少し間違った日本観も身についてしまい、ニンジャやサムライに過剰な憧れを抱いている。"},{"spoiler":false,"text":"端麗な容姿や不思議な空気に惹かれ、学園ではクローデットに次ぐ派閥を形勢している。"},{"spoiler":false,"text":"噂では“不思議な力”を持っているらしいが、実際に見たという者はほとんどいない。"},{"spoiler":false,"text":"「ソウジはさすがニンジャですね。 全然かなわなかったです」"}],"source":"bangumi","sourceCharacterId":"54589"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"16839","sourceWorkId":"24467","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"16839","sourceWorkId":"24467","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"16839","sourceWorkId":"24467","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"51 cm","valueContext":null,"source":"egs","sourceCharacterId":"16839","sourceWorkId":"24467","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/791fe238afd3d41c7c25cc79ebd73e08a34cf3cf9504c2786dbcf2de7c3a50a8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f64b5385e22f1d10e5cee8253368551657ceaae0b25906eb744260ddcb3e3ad1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡本理絵","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:212413:54589:13368:1","source":"bangumi"}]},{"characterId":"char_c61946","characterName":"クローデット・ベルフラウ","sourceIds":{"bangumi":[{"characterId":"54590","match":"exact-normalized-name-in-linked-work","subjectId":"212413"}],"egsCharacterIds":["16840"],"vndbCharacterId":"c61946"},"originalCharacterName":"クローデット・ベルフラウ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1226"},"blo