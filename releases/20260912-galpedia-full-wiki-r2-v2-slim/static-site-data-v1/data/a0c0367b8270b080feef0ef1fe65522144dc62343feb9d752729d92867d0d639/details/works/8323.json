"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:84224:93120:4956:1","source":"bangumi"}]},{"characterId":"char_c51134","characterName":"椎名 まゆ","sourceIds":{"bangumi":[{"characterId":"93121","match":"exact-normalized-name-in-linked-work","subjectId":"84224"}],"egsCharacterIds":["13832"],"vndbCharacterId":"c51134"},"originalCharacterName":"椎名 まゆ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幼い外見をしているが、沙織の一卵性双生児で、妹。"},{"spoiler":false,"text":"ゴシックロリータファッションに身を包み、清楚で無垢な少女のような雰囲気を持つも、その性は姉の沙織以上に奔放で、淫蕩。"},{"spoiler":false,"text":"魔女としても沙織に劣らず有能なのだが、享楽的、且つ刹那的な性格から、ワンランク下にみられがちで、それを不満に思っており、時折、反発の気配を見せるが……。"}],"source":"egs","sourceCharacterId":"13832","sourceWorkId":"8323","spoiler":false},{"segments":[{"spoiler":false,"text":"幼い外見をしているが、沙織とは一卵性の双子で妹にあたる。"},{"spoiler":false,"text":"西洋人形を思わせる容姿をゴシックな衣装に包み、沙織以上に奔放な性を満喫している。"},{"spoiler":false,"text":"同じ遺伝子を持つだけに天才肌の有能な魔女なのだが、享楽的で刹那的な性格ゆえか周囲からは1ランク下に見られることが多く、それを不満に思って事あるごとに反発の気配を見せる。"}],"source":"bangumi","sourceCharacterId":"93121"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81b9dcaa8aca7ced0cc62a6a1efeaa0541d56afb06767e11cfc84dcb83484f72.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/5196d91c4ab78a16482a7cc07bedf6cf70b74c4aa14d4129f8c92debf114d83f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:84224:93121:4830:1","source":"bangumi"}]},{"characterId":"char_c51135","characterName":"橘 由貴","sourceIds":{"bangumi":[{"characterId":"93122","match":"exact-normalized-name-in-linked-work","subjectId":"84224"}],"egsCharacterIds":["13833"],"vndbCharacterId":"c51135"},"originalCharacterName":"橘 由貴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公とは、生まれたときから姉弟のように育てられた幼馴染で、クラスまでも一緒の腐れ縁。"},{"spoiler":false,"text":"明朗快活で、思いやりのある優しく素直な女の子。"},{"spoiler":false,"text":"生徒だけでなく、教師からも人気があり、彼女を狙っている男子も少なくない。"},{"spoiler":false,"text":"しかし、本人はそうした恋愛沙汰に淡白で、避けているようだ。"},{"spoiler":false,"text":"チアリーディング部に所属し、レギュラーとして忙しい日々を過ごしているが、暇を見つけては主人公の世話を焼いている。"}],"source":"egs","sourceCharacterId":"13833","sourceWorkId":"8323","spoiler":false},{"segments":[{"spoiler":false,"text":"生まれた時から姉弟のように育てられた達也の幼馴染で、クラスまで同じという腐れ縁。"},{"spoiler":false,"text":"素直で思いやりのある性格をしていて、学校では教師・生徒を問わず多くの人間に慕われている。"},{"spoiler":false,"text":"狙っている者も少なくないが、本人はいたって淡白に恋愛沙汰を避けている模様。"},{"spoiler":false,"text":"チアリーディング部のレギュラーとして忙しい日々を送る中、暇を見つけては所在のない達也をかまって世話を焼いている。だが、その屈託のない明るさは達也には眩しく、時おり彼を苛立たせることにもなっている。"}],"source":"bangumi","sourceCharacterId":"93122"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/ebb4713bcdd32dd25782d3aef215a156e715b3d41b1ac668d549d01288d9ee2a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/787ccb76e98f30144bb37801d0d9744845bafb9e65ce2515cfa1f1b6d369cf2b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:84224:93122:5890:1","source":"bangumi"}]},{"characterId":"char_c51136","characterName":"橘 杏奈","sourceIds":{"bangumi":[{"characterId":"93123","match":"exact-normalized-name-in-linked-work","subjectId":"84224"}],"egsCharacterIds":["13834"],"vndbCharacterId":"c51136"},"originalCharacterName":"橘 杏奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"由貴の妹。主人公のことも実の兄のように慕っている。"},{"spoiler":false,"text":"子供っぽい外見に違わず、素直で無邪気、純朴な女の子。"},{"spoiler":false,"text":"最近になって、主人公に別の感情が芽生え始めたようで、少し背伸びした発言や行動が目立つようになった。"},{"spoiler":false,"text":"それを姉の由貴にからかわれ、むくれることも。"}],"source":"egs","sourceCharacterId":"13834","sourceWorkId":"8323","spoiler":false},{"segments":[{"spoiler":false,"text":"橘由貴の妹で、達也のことも実の兄のように慕っている。"},{"spoiler":false,"text":"まだ子供っぽい外見にふさわしく素直で純真。"},{"spoiler":false,"text":"最近、達也に対して別の感情が芽生えはじめており、少し背伸び気味になっているところを由貴にからかわれることも。"}],"source":"bangumi","sourceCharacterId":"93123"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b652d6f97999a061883a70dbb3ab32fd9752a159c3fdd3b6297e6248035a0c3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3df12fffd22da946cf22b5000ac40157952e32983766aa7d06fd0dff64e6c49.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:84224:93123:6106:1","source":"bangumi"}]},{"characterId":"char_c51137","characterName":"橘 恵梨","sourceIds":{"bangumi":[{"characterId":"93124","match":"exact-normalized-name-in-linked-work","subjectId":"84224"}],"egsCharacterIds":["13835"],"vndbCharacterId":"c51137"},"originalCharacterName":"橘 恵梨","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"由貴の母親。内科・小児科を経営している有能な女医でもある。"},{"spoiler":false,"text":"同業だった夫とは死別し、再婚することなく、ひとりで病院を切り盛りしている。"},{"spoiler":false,"text":"見た目は若く、グラマラスで娘の由貴と歳の離れた姉妹と見られることも。"},{"spoiler":false,"text":"家庭的で優しいお母さんで、主人公にとっては実母よりも頼りにしている存在。"}],"source":"egs","sourceCharacterId":"13835","sourceWorkId":"8323","spoiler":false},{"segments":[{"spoiler":false,"text":"由貴たちの母親。隣家で内科・小児科医を経営しているグラマーな未亡人。"},{"spoiler":false,"text":"達也にとってはかかりつけの医者であり、実の親より頼りにしている人物でもある。"},{"spoiler":false,"text":"有能な女医であると同時に、家庭的で優しい『お母さん』。見かけは若く、由貴とは時おり年の離れた姉妹に見られて喜んでいる。"},{"spoiler":false,"text":"同業の夫と死別してからは、再婚の話もなくひとりで病院を切り回している。"}],"source":"bangumi","sourceCharacterId":"93124"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19b9a068eca5be2b2bb3cf9b4e0224e38f3df0ad40ed04c3d109c57b15515ed0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26225235ad93eb72f8f78d24a7f9454da2e1cf60142337074914ec46b54b9331.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大垣理香","creatorId":"vndb:s2986","sourcePersonId":"vndb:s2986","canonicalEntityId":"vndb:s2986","name":"越智悠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:84224:93124:19056:1","source":"bangumi"}]},{"characterId":"char_c51138","characterName":"相沢 美里","sourceIds":{"bangumi":[{"characterId":"93125","match":"exact-normalized-name-in-linked-work","subjectId":"84224"}],"egsCharacterIds":["13836"],"vndbCharacterId":"c51138"},"originalCharacterName":"相沢 美里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラス担任。担当教科は現代文。また主人公が所属する吹奏楽部の顧問でもある。"},{"spoiler":false,"text":"育ちのいいお嬢さん、といった印象の彼女。"},{"spoiler":false,"text":"教育熱心だが、時折、経験不足から行き過ぎてしまうことも。"},{"spoiler":false,"text":"事故に遭って以来、無気力になってしまった主人公に同情し、熱心に世話を焼いている。"},{"spoiler":false,"text":"同僚の教師・香坂健司と交際中。"}],"source":"egs","sourceCharacterId":"13836","sourceWorkId":"8323","spoiler":false},{"segments":[{"spoiler":false,"text":"達也のクラスの担任であり、吹奏楽部の顧問でもある女教師。指導教科は現文。"},{"spoiler":false,"text":"育ちのいいお嬢さんで教育熱心だが、経験不足からたまに行き過ぎることがある。"},{"spoiler":false,"text":"事故に遭った達也に同情し、熱心に世話を焼いたことからほのかな恋心を抱かれているが、美里自身は同僚と交際中。"}],"source":"bangumi","sourceCharacterId":"93125"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90ca036168fe346d5b1f9f8603e0dbf185c7c89c761ad54c4cc5f3f10b0a33b6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/7823b30967df69ce5e52d4a0e301f8b12575ee69c10ffc87d3776081845bc273.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:84224:93125:4463:1","source":"bangumi"}]},{"characterId":"char_c51139","characterName":"須藤 恭子","sourceIds":{"bangumi":[{"characterId":"93126","match":"exact-normalized-name-in-linked-work","subjectId":"84224"}],"egsCharacterIds":["13837"],"vndbCharacterId":"c51139"},"originalCharacterName":"須藤 恭子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の同級生。"},{"spoiler":false,"text":"頭が良く、性格も真面目な優等生で、クラス委員長を務めている。"},{"spoiler":false,"text":"正義感も強く、何かと小うるさいところもあるが、面倒見がよく人望も厚い。"},{"spoiler":false,"text":"趣味は写真。"}],"source":"egs","sourceCharacterId":"13837","sourceWorkId":"8323","spoiler":false},{"segments":[{"spoiler":false,"text":"達也の同級生で、真面目な性格を買われてクラス委員長を務めている。"},{"spoiler":false,"text":"頭が良く口は達者。正義感も強くて煙たがれることも多いが、面倒見がよく人望は高い。写真が趣味。"}],"source":"bangumi","sourceCharacterId":"93126"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6ced9603636b365dabd0f8cc5e004b87c0827394c434664c39fb3b6580e7bb54.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/246f07b23d8f167d686cdb8c20abe4dc9c38b72621f27d8ab509ae026e6ba9a9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:84224:93126:5075:1","source":"bangumi"}]},{"characterId":"char_c51140","characterName":"楠瀬 奈留","sourceIds":{"bangumi":[{"characterId":"93127","match":"exact-normalized-name-in-linked-work","subjectId":"84224"}],"egsCharacterIds":["13838"],"vndbCharacterId":"c51140"},"originalCharacterName":"楠瀬 奈留","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の同級生。帰国子女。"},{"spoiler":false,"text":"すらりと背が高く、健康的な肢体を持つ女の子で、所属する水泳部ではエースとして活躍中。"},{"spoiler":false,"text":"アメリカ育ちながら、何故か英語の成績は悪い。"},{"spoiler":false,"text":"性格は大らかで天然、明るく元気なムードメーカー的な存在。"},{"spoiler":false,"text":"恋愛系のゴシップが大好きな今どきの女子校生。"}],"source":"egs","sourceCharacterId":"13838","sourceWorkId":"8323","spoiler":false},{"segments":[{"spoiler":false,"text":"由貴と親しい達也の同級生。"},{"spoiler":false,"text":"背が高くスポーティな肢体の持ち主で、水泳部のエースとして活躍している。"},{"spoiler":false,"text":"学園に入る前はアメリカで暮らしていたが、不思議と英語の成績は悪い。"},{"spoiler":false,"text":"天然でおおらかな性格をしていて、恋愛系のゴシップが大好き。"}],"source":"bangumi","sourceCharacterId":"93127"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/024b63b47ff0e0dace7792e144613ed9c1ff91658a7e75e262ce2d051b72913b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/9444713069a69bd51e40629623e351a8eea4d343c2f9960bf8cdb15488894b1f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽月理恵","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:84224:93127:5907:1","source":"bangumi"}]},{"characterId":"char_vndb_c168903","characterName":"榊原 達也","sourceIds":{"vndbCharacterId":"c168903"},"originalCharacterName":"榊原 達也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c51141","characterName":"香坂 健司","sourceIds":{"vndbCharacterId":"c51141"},"originalCharacterName":"香坂 健司","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e665b7892a5ff8e750fcbdc3f667a894b51594d0b130f167b2f