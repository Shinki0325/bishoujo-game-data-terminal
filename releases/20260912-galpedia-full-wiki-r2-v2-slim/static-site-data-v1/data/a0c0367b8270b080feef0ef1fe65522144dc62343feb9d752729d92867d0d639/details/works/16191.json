"auto-confirmed","relationId":"egs:work-creator:99916","source":"egs"},{"creditedName":"籐太","creatorId":"vndb:s847","sourcePersonId":"egs:creator:2155","canonicalEntityId":"vndb:s847","name":"籐太","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:99917","source":"egs"}],"music":[{"creditedName":"Elements Garden","creatorId":"vndb:s557","sourcePersonId":"egs:creator:2307","canonicalEntityId":"vndb:s557","name":"Elements Garden","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:105548","source":"egs"}],"other":[{"creditedName":"どせい","creatorId":"vndb:s4161","sourcePersonId":"egs:creator:15665","canonicalEntityId":"vndb:s4161","name":"どせい","detail":"ムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:112595","source":"egs"},{"creditedName":"下原正","creatorId":"vndb:s2184","sourcePersonId":"egs:creator:261","canonicalEntityId":"vndb:s2184","name":"下原正","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:221731","source":"egs"},{"creditedName":"椎原旬","creatorId":"vndb:s1704","sourcePersonId":"egs:creator:620","canonicalEntityId":"vndb:s1704","name":"椎原旬","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:221732","source":"egs"},{"creditedName":"椎原 旬","creatorId":"vndb:s1704","sourcePersonId":"vndb:s1704","canonicalEntityId":"vndb:s1704","name":"椎原 旬","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:76682","source":"vndb"},{"creditedName":"下原 正","creatorId":"vndb:s2184","sourcePersonId":"vndb:s2184","canonicalEntityId":"vndb:s2184","name":"下原 正","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:76686","source":"vndb"}]},"cast":[{"characterId":"char_c25721","characterName":"フレアルージュ＝リリエンソール","sourceIds":{"bangumi":[{"characterId":"12441","match":"exact-normalized-name-in-linked-work","subjectId":"14714"}],"egsCharacterIds":["427"],"vndbCharacterId":"c25721"},"originalCharacterName":"フレアルージュ＝リリエンソール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Red Flower of martial art. Strong and reliable in fighting but naive and ignorant about anything else."}],"source":"vndb","sourceCharacterId":"c25721"},{"segments":[{"spoiler":false,"text":"『アルクス』の称号を持つ赤の六花。武を司る。"},{"spoiler":false,"text":"太陽神の新生に合わせ、新たに任命された若き六花。現職の六花では最年少。"},{"spoiler":false,"text":"発展途上ながら、ミルサントでも有数の武人であり、規律を重んじる生真面目な性格。"},{"spoiler":false,"text":"一見完璧に見えるが、精神的には年相応な部分もあり、先走って失敗することもしばしば。"},{"spoiler":false,"text":"プロミアのために忠義を尽くすが、生来の不器用さ故プロミアの不興を買うこともしばしば。"},{"spoiler":false,"text":"コダマと出会った時には、力の源である大アルクスが黒禍に侵されていたことが原因でジゼルに敗れた後であり、行き倒れ同然だった。"},{"spoiler":false,"text":"現在は六花としての力を揮えないが、大イリシアに取り憑いた憑影が現れた際にはコダマの力により一時的に力を取り戻し、憑影の撃退に成功する。"},{"spoiler":false,"text":"「プロミア様は私がお護りします。"},{"spoiler":false,"text":"ミルサントの守護者、六花の名にかけて！」"}],"source":"egs","sourceCharacterId":"427","sourceWorkId":"13830","spoiler":false},{"segments":[{"spoiler":false,"text":"『アルクス』の称号を持つ赤の六花。"},{"spoiler":false,"text":"プロミアに対する忠誠心は誰にも負けないが、行き過ぎた忠誠心と生来の粗忽さから不興を買うこともしばしば。"},{"spoiler":false,"text":"武に優れ、生真面目でお堅い印象もあるが、こと恋愛に関しては紛れもなく乙女。"},{"spoiler":false,"text":"「今度は味わって食べてください。"},{"spoiler":false,"text":"はい、あ～ん」"}],"source":"egs","sourceCharacterId":"427","sourceWorkId":"16191","spoiler":false},{"segments":[{"spoiler":false,"text":"有着“アルクス” 之称的红色六花。司武。"},{"spoiler":false,"text":"随着太阳神的新生，新上任的年轻六花。现职的六花中最年轻的一位。"},{"spoiler":false,"text":"虽然还在发展途中，她已经是ミルサント屈指可数的武人，性格认真，按规矩办事。"},{"spoiler":false,"text":"看上去很完美，但是精神上也有和年龄相符合之处，猛冲直撞导致的失败也屡次发生。"},{"spoiler":false,"text":"为了プロミア尽忠职守，但是由于自己与生俱来的笨拙，经常冒犯プロミア。"}],"source":"bangumi","sourceCharacterId":"12441"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85d0573ab98b04f8105cc599695b99a6fd18e7e4b5a5ae359f4c5dffb4b71e01.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90f5dfbf299ea0d74f51655e070addf2e9ac249a164df74a5c35d07ef1ba4571.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"守田 羽糸","creatorId":"vndb:s882","sourcePersonId":"vndb:s882","canonicalEntityId":"vndb:s882","name":"松元 惠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42868","source":"vndb"}]},{"characterId":"char_c25722","characterName":"ニーナ＝オータム","sourceIds":{"bangumi":[{"characterId":"12442","match":"exact-normalized-name-in-linked-work","subjectId":"14714"}],"egsCharacterIds":["429"],"vndbCharacterId":"c25722"},"originalCharacterName":"ニーナ＝オータム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Captain of Security Guard. Although she is clumsy and makes many mistakes, she is friendly and is liked by everyone. Good at cooking and taking care of people."}],"source":"vndb","sourceCharacterId":"c25722"},{"segments":[{"spoiler":false,"text":"イリシア地区の市街警備隊の一部隊長。"},{"spoiler":false,"text":"警備兵に追われていた記憶喪失のコダマを、誘拐犯と勘違いして投げ飛ばしてしまう。"},{"spoiler":false,"text":"おっちょこちょいなところもあるが、人懐っこく皆に好かれる性格。"},{"spoiler":false,"text":"調理師志望だったはずが、生来の馬鹿力を買われて警備隊長になったという変わり種。"},{"spoiler":false,"text":"料理の腕はなかなかのもので、彼女の作るおひさま焼きはプロミアの大好物。"},{"spoiler":false,"text":"おっぱいの大きさも相まって、プロミアに一番好かれている。"},{"spoiler":false,"text":"コダマたちがミルサントを救う旅に出る際に、コック兼プロミアの世話役を仰せつかる。"},{"spoiler":false,"text":"「ミルサント名物『おひさま焼き』、美味しいですよ。"},{"spoiler":false,"text":"なんたって、神様の好物なんですから！」"}],"source":"egs","sourceCharacterId":"429","sourceWorkId":"13830","spoiler":false},{"segments":[{"spoiler":false,"text":"『リリ』の称号を持つ白の六花。"},{"spoiler":false,"text":"料理人志望のハズが神官になり、あれよあれよという間に六花にまで抜擢されてしまうという、異例の経歴を持つ。"},{"spoiler":false,"text":"『気は優しくて力持ち』を地で行くムードメーカー的な存在で、明るい笑顔が印象的。"},{"spoiler":false,"text":"彼女の豊満な胸元は、コダマの頭の上に次ぐプロミアの指定席である。"},{"spoiler":false,"text":"「せっかくの夏休みなんですから、思い切り遊ばないともったいないですよ！」"}],"source":"egs","sourceCharacterId":"429","sourceWorkId":"16191","spoiler":false},{"segments":[{"spoiler":false,"text":"イリシア地区城市警卫队的队长。"},{"spoiler":false,"text":"有着冒失的一面，但是性格和蔼可亲，备受大家喜爱。"},{"spoiler":false,"text":"志愿成为厨师，但是由于她与生俱来有一股傻力气，误打误撞成为了警卫队队长。"},{"spoiler":false,"text":"经常打躬折背，对比自己小的人也使用敬语。"},{"spoiler":false,"text":"擅长做料理，她做的おひさま焼き是プロミア最喜欢吃的食物。加上她胸部丰满，是プロミア最疼爱的人。"}],"source":"bangumi","sourceCharacterId":"12442"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef45516a6d52272417c7fdce12a00248a15a2e22af3f3743daf3bfffd0e372fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a52bb7ab1b6289c15f14dc243788b503ec133aef5236753678fcb2ecbbef2ae5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"沢田 さつき","creatorId":"vndb:s14","sourcePersonId":"vndb:s14","canonicalEntityId":"vndb:s14","name":"高野 直子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42858","source":"vndb"}]},{"characterId":"char_c25723","characterName":"アマリ＝ナ＝ベムベ＝ベルベル","sourceIds":{"bangumi":[{"characterId":"12443","match":"exact-normalized-name-in-linked-work","subjectId":"14714"}],"egsCharacterIds":["430"],"vndbCharacterId":"c25723"},"originalCharacterName":"アマリ＝ナ＝ベムベ＝ベルベル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Blue Flower of knowledge. Introvert, smart, love reading and voice of reason among the Flowers."}],"source":"vndb","sourceCharacterId":"c25723"},{"segments":[{"spoiler":false,"text":"『ランベル』の称号を持つ青の六花。知性を司る。"},{"spoiler":false,"text":"小さな身体に膨大な知識を蓄えている天才少女。"},{"spoiler":false,"text":"他人と交わりたがらない性格で、普段はランベルの水中図書館に籠もっている。"},{"spoiler":false,"text":"その一方、物語を語って聞かせるのが得意であり、プロミアも彼女の語りはお気に入り。"},{"spoiler":false,"text":"特殊な力を持った種族の生まれで、"},{"spoiler":false,"text":"水中でも地上と同じように行動が可能。"},{"spoiler":false,"text":"大ランベルが黒禍に侵されたからか、時と場所を選ばずいきなり眠りに落ちるようになる。"},{"spoiler":false,"text":"「記憶喪失？"},{"spoiler":false,"text":"ふーん、単純な頭をしているのね」"}],"source":"egs","sourceCharacterId":"430","sourceWorkId":"13830","spoiler":false},{"segments":[{"spoiler":false,"text":"『ランベル』の称号を持つ青の六花。"},{"spoiler":false,"text":"以前はランベル大図書館にこもっていることが多かったが、最近は他の六花たちとのコミュニケーションを取る機会も多くなってきた。"},{"spoiler":false,"text":"それでも本好きは相変わらずで、本を読んでいると寝食を忘れてしまうこともしばしば。"},{"spoiler":false,"text":"最近、ちょっと表情が柔らかくなったと噂されている。"},{"spoiler":false,"text":"「は、恥ずかしいから、あんまり見ないで。"},{"spoiler":false,"text":"もう見慣れているでしょう」"}],"source":"egs","sourceCharacterId":"430","sourceWorkId":"16191","spoiler":false},{"segments":[{"spoiler":false,"text":"有着“ランベル” 之称的青色六花。司知性。"},{"spoiler":false,"text":"小小的身体里蕴藏着膨大知识的天才少女。"},{"spoiler":false,"text":"由于她不善与人打交道的性格，平时总是呆在ランベル的水中图书馆。"},{"spoiler":false,"text":"擅长给人讲故事，プロミア也很喜欢听她讲的故事。"},{"spoiler":false,"text":"出生的种族拥有特殊力量，所以不论水陆都能自由行动。"}],"source":"bangumi","sourceCharacterId":"12443"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c0e27316fc27d9823ff2577630d22a4e0abee52a393f37352f99a3133ddfec7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b7eb1340d1f71797548ed5edb30f5c865958a8cc1589aa6fc0217a923746948.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水嶋 海歩","creatorId":"vndb:s777","sourcePersonId":"vndb:s777","canonicalEntityId":"vndb:s777","name":"吉住 梢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42864","source":"vndb"}]},{"characterId":"char_c25724","characterName":"エレガノ＝フォン＝クロイツェル","sourceIds":{"bangumi":[{"characterId":"12445","match":"exact-normalized-name-in-linked-work","subjectId":"14714"}],"egsCharacterIds":["431"],"vndbCharacterId":"c25724"},"originalCharacterName":"エレガノ＝フォン＝クロイツェル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yellow Flower of art and music. Always proud, composed and full of confidence in any situation."}],"source":"vndb","sourceCharacterId":"c25724"},{"segments":[{"spoiler":false,"text":"『ローゼリア』の称号を持つ黄の六花。芸術を司る。"},{"spoiler":false,"text":"かつてミルサントを救った英雄の流れを汲む名家のお嬢様。"},{"spoiler":false,"text":"自信家で尊大な物言いをするが、性格は気っ風の良い姉御肌。"},{"spoiler":false,"text":"楽器はバイオリンが基本だが、楽器も曲目も型にはこだわらない。"},{"spoiler":false,"text":"彼女が手にしたものは全てが楽器となり、彼女の奏でる音は全てが楽曲となる。"},{"spoiler":false,"text":"外見に似合わず子供の世話が好きで、子供たちと一緒に演奏するための簡単な楽器を携帯している。"},{"spoiler":false,"text":"ローゼリアの六花が黒禍に侵されたためか、困った事態がその身に生じており、現在は行方をくらましている。"},{"spoiler":false,"text":"「どんなものにも音は宿るわ。だから、私が奏でてあげるの」"}],"source":"egs","sourceCharacterId":"431","sourceWorkId":"13830","spoiler":false},{"segments":[{"spoiler":false,"text":"『ローゼリア』の称号を持つ黄の六花。"},{"spoiler":false,"text":"芸術を司る六花にふさわしく、生まれも、話し方も、立ち居振る舞いも、すべてが優雅。"},{"spoiler":false,"text":"ただ、気を許した相手には悪戯好きの一面を見せることもあり、主にフレアルージュが弄られ役になっている。"},{"spoiler":false,"text":"みんなのアイドル、ジョージちゃんが現れるとき、彼女の姿が見えなくなるのは公然の秘密。"},{"spoiler":false,"text":"「あら、泳げないわけじゃないわ。"},{"spoiler":false,"text":"まだ泳いだことがないだけよ」"}],"source":"egs","sourceCharacterId":"431","sourceWorkId":"16191","spoiler":false},{"segments":[{"spoiler":false,"text":"有着“ローゼリア”之称的黄色六花。司艺术。"},{"spoiler":false,"text":"出身于曾经拯救过ミルサント的英雄名门。"},{"spoiler":false,"text":"充满自信，措词骄傲自大，但是性格慷慨，喜欢照顾别人。"},{"spoiler":false,"text":"擅长小提琴，但是不拘泥任何乐器和曲目。"},{"spoiler":false,"text":"她所触碰的任何东西都会变为乐器，她弹奏的任何声音都会化作迷人乐章。"},{"spoiler":false,"text":"与她的外表不符，特别喜欢照顾小孩子，为了和小孩子们一起演奏，总是随身携带一些简单的乐器。"}],"source":"bangumi","sourceCharacterId":"12445"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eba0154e78ad22ed36556fe7e13528dd3fcf7912cbb98167fb1a0f59ab634626.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94cae7165908e53bc5d2a99da37493058112bdec8add04fb6cd0068303cd3ffc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白河 響","creatorId":"vndb:s81","sourcePersonId":"vndb:s81","canonicalEntityId":"vndb:s81","name":"浅川 悠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42865","source":"vndb"}]},{"characterId":"char_c25725","characterName":"ジゼル＝ジェラルダイン","sourceIds":{"bangumi":[{"characterId":"12446","match":"exact-normalized-name-in-linked-work","subjectId":"14714"}],"egsCharacterIds":["432"],"vndbCharacterId":"c25725"},"originalCharacterName":"ジゼル＝ジェラルダイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rinowahl's stoic subordinate. She has strange obsession with Kodama and occasionally takes actions with unknown motive."}],"source":"vndb","sourceCharacterId":"c25725"},{"segments":[{"spoiler":false,"text":"謎の侵略者その１。"},{"spoiler":false,"text":"『憑影（つきかげ）』という意志を持たぬ兵士達を率い、フレアルージュや主人公たちの前に立ち塞がる。"},{"spoiler":false,"text":"闇に覆われた六大樹を解放しようとする主人公たちとは敵対関係だが、ときに敵とは思えない意図不明の行動を取ることもある。"},{"spoiler":false,"text":"特に主人公のコダマに対して執着のようなものを見せており、記憶を失う前のコダマを知っているかもしれない人物。"},{"spoiler":false,"text":"幼少期は魔獣に育てられたからか、言葉遣いはややたどたどしいが、"},{"spoiler":false,"text":"なぜか礼儀作法は完璧にこなし、メイド服も着こなす。"},{"spoiler":false,"text":"しかし、一人のときはほぼ裸で過ごしたり、生肉が好物だったりするあたり、幼少期の影響は抜けていないと思われる。"},{"spoiler":false,"text":"「この街に六大樹の加護はもうない。です」"}],"source":"egs","sourceCharacterId":"432","sourceWorkId":"13830","spoiler":false},{"segments":[{"spoiler":false,"text":"『ジュエルリップ』の称号を持つ黒の六花。"},{"spoiler":false,"text":"前作では侵略者として現れたが、実はミルサントのために動いていたことが判明。"},{"spoiler":false,"text":"六花長のレノより、黒の六花に任命される。"},{"spoiler":false,"text":"礼節を司る六花だけあって礼儀作法は完璧なのだが、普段は裸に近い格好で過ごしているため、付き合いの浅い者はそのギャップに驚くことになる。"},{"spoiler":false,"text":"「アイスキャンディー、冷たくて、美味しい」"}],"source":"egs","sourceCharacterId":"432","sourceWorkId":"16191","spoiler":false},{"segments":[{"spoiler":false,"text":"谜之侵略者一号。"},{"spoiler":false,"text":"率领一群拥有“憑影（つきかげ）”这种意志的兵士，阻挡在フレアルージュ和主人公们面前的敌人。"},{"spoiler":false,"text":"和想要将六大树从黑暗中解放的主人公们是敌对关系，但是有时又会表现出与敌人身份相违和的意义不明举动。"},{"spoiler":false,"text":"不说话，无表情。"},{"spoiler":false,"text":"像机械一般完成任务，但是兴奋的时候会表现出野兽一般的表情和行动。"}],"source":"bangumi","sourceCharacterId":"12446"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5644b64640c7d71cd97139130288ba765df4162bb4e36f42445e2eba4e7c872.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/232125253fab361ba9c74b65ef9cea36e209a7850e4cd07b540e9513123adaf7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青山 ゆかり","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42862","source":"vndb"}]},{"characterId":"char_c25726","characterName":"リノワール","sourceIds":{"bangumi":[{"characterId":"12448","match":"exact-normalized-name-in-linked-work","subjectId":"14714"}],"egsCharacterIds":["433"],"vndbCharacterId":"c25726"},"originalCharacterName":"リノワール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"5.5"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Introducing herself as Demon King from 300 years ago, the elusive mysterious little girl wreaks havoc on Milsant to oppose Kodama and his friends."}],"source":"vndb","sourceCharacterId":"c25726"},{"segments":[{"spoiler":false,"text":"謎の侵略者その２。"},{"spoiler":false,"text":"あどけないその容姿とは裏腹にジゼルより上位の存在であり、ミルサント侵攻の指揮を執っている。"},{"spoiler":false,"text":"いつも悪戯っぽくニンマリ微笑んでおり、ミルサントへの侵攻も遊びだと思っている節さえある。"},{"spoiler":false,"text":"性格は、基本的に享楽的で甘えん坊。"},{"spoiler":false,"text":"ナチュラルに性的なアピールが過剰。"},{"spoiler":false,"text":"また、男女問わずスキンシップ過剰。"},{"spoiler":false,"text":"大昔ミルサントに攻め入ってきた『魔獣王リノワール』と同じ名前を名乗る。"},{"spoiler":false,"text":"髪型と服装は違うけれど、顔立ちはとてもよく似た少女が確認されている。"},{"spoiler":false,"text":"「ボクの名はリノワール。"},{"spoiler":false,"text":"この国の太陽を貰い受けに来たよ」"}],"source":"egs","sourceCharacterId":"433","sourceWorkId":"13830","spoiler":false},{"segments":[{"spoiler":false,"text":"谜之侵略者二号。"},{"spoiler":false,"text":"与天真烂漫的外表相反，她的职位比ジゼル更高，担任侵略ミルサント的指挥官。"},{"spoiler":false,"text":"总是像小恶魔般地微笑，把对ミルサント的侵略当做游戏。"},{"spoiler":false,"text":"享乐主义，爱撒娇。"},{"spoiler":false,"text":"性方面表现得特别直接。而且，不论男女，都表现出过度的亲昵。"},{"spoiler":false,"text":"和很早以前侵略ミルサント的 “魔兽王リノワール” 同名。"}],"source":"bangumi","sourceCharacterId":"12448"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/537bd57c61415e320ad3ce98bb6cf20a35fe6bc780f2af0043e670f750d581ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6429f7690d6c82a651bc2a9af8591dffc546c6e4706c5466f394a6af4c9d7b6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森島 多由","creatorId":"vndb:s131","sourcePersonId":"vndb:s131","canonicalEntityId":"vndb:s131","name":"水橋 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42866","source":"vndb"}]},{"characterId":"char_c25728","characterName":"カシェット","sourceIds":{"bangumi":[{"characterId":"12452","match":"exact-normalized-name-in-linked-work","subjectId":"14714"}],"egsCharacterIds":["439"],"vndbCharacterId":"c25728"},"originalCharacterName":"カシェット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"憑影を自由に呼び出すことの出来る謎の少女。"},{"spoiler":false,"text":"一日の大半を寝て過ごしており、リノワールとジゼルに『眠り姫』と呼ばれて傅かれている。"},{"spoiler":false,"text":"精神的には見た目以上に未成熟なお子様。"},{"spoiler":false,"text":"気に入らないことがあるとすぐにかんしゃくを起こす。"},{"spoiler":false,"text":"「ご本……好き……読む」"}],"source":"egs","sourceCharacterId":"439","sourceWorkId":"13830","spoiler":false},{"segments":[{"spoiler":false,"text":"300年間眠り続けていた『眠り姫』。"},{"spoiler":false,"text":"複雑な過去を持っているが、現在は元気いっぱいに毎日を過ごしている。"},{"spoiler":false,"text":"もともと見た目に比して精神年齢がやや幼いのだが、最近になって身体が急激に成長したため、これまで以上にそのギャップが生じてしまっている。"},{"spoiler":false,"text":"体が急激に成長した理由は、現在のところ調査中。"},{"spoiler":false,"text":"「必殺！"},{"spoiler":false,"text":"カシェット、はーーーぐ！！」"}],"source":"egs","sourceCharacterId":"439","sourceWorkId":"16191","spoiler":false},{"segments":[{"spoiler":false,"text":"能够自由召唤憑影的谜之少女。"},{"spoiler":false,"text":"一日的大半时间都在睡觉，被リノワール和ジゼル称为「睡美人」， 并受到她们的照顾。"},{"spoiler":false,"text":"精神年龄比外表还要幼小。"},{"spoiler":false,"text":"遇到不爽的事情马上就会发脾气。"}],"source":"bangumi","sourceCharacterId":"12452"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51024a1cef548010e455b5a296efbe6df29d6d12256ef1f9275ed0f55a6c7507.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f83c3967e4f8fe370caa27aa1498582cc5633fb64056dbee30436c953664186a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真中 海","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42863","source":"vndb"}]},{"characterId":"char_c26423","characterName":"サーサ","sourceIds":{"bangumi":[{"characterId":"12450","match":"exact-normalized-name-in-linked-work","subjectId":"14714"}],"egsCharacterIds":["435"],"vndbCharacterId":"c26423"},"originalCharacterName":"サーサ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"レノの補佐官その１。"},{"spoiler":false,"text":"様々な業務でレノをサポートしている。"},{"spoiler":false,"text":"ユーユとは双子の姉妹で、イリシアの神殿において「双子のおっとりした方」といえば、"},{"spoiler":false,"text":"それはサーサのことだと思って間違いない。"},{"spoiler":false,"text":"ミルサントでも稀な遠隔通信光炉を使える特殊技術者で、遠く離れた場所との通話が可能。"},{"spoiler":false,"text":"「だってぇ、みんなしゃべるの速くてぇ」"}],"source":"egs","sourceCharacterId":"435","sourceWorkId":"13830","spoiler":false},{"segments":[{"spoiler":false,"text":"レノ的補佐官之一。"},{"spoiler":false,"text":"在各种各样的业务上支援レノ。"},{"spoiler":false,"text":"和ユーユ是双胞胎姐妹，如果说起イリシア神殿中「两姐妹里稳重文静的那位」，那肯定就是サーサ。"},{"spoiler":false,"text":"能够在ミルサント操纵很少有人能使用的远距离通信光炉的特殊技术者，能够进行远距离通话。"}],"source":"bangumi","sourceCharacterId":"12450"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33e8b57700aa138066d74b4b2952757dc5452898b05870ffe7fbf21ab0f0b566.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e183e976557522f11be497ba061b7e085933c9417381bbfabea06ace37126a1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奏雨","creatorId":"vndb:s199","sourcePersonId":"vndb:s199","canonicalEntityId":"vndb:s199","name":"尾崎 真実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42859","source":"vndb"}]},{"characterId":"char_c26424","characterName":"ユーユ","sourceIds":{"bangumi":[{"characterId":"12451","match":"exact-normalized-name-in-linked-work","subjectId":"14714"}],"egsCharacterIds":["436"],"vndbCharacterId":"c26424"},"originalCharacterName":"ユーユ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"レノの補佐官その２。"},{"spoiler":false,"text":"やはり様々な業務でレノをサポートしている。"},{"spoiler":false,"text":"サーサとは双子の姉妹で、イリシアの神殿において「双子のちゃきちゃきした方」といえば、それはユーユのことだと思って間違いない。"},{"spoiler":false,"text":"ミルサントでも稀な高機能演算光炉を使える特殊技術者で、数字を扱うことに長けている。"},{"spoiler":false,"text":"「さあ、そうと決まれば善は急げ。"},{"spoiler":false,"text":"必要な物があれば揃えますので、ちゃっちゃとご準備願います」"}],"source":"egs","sourceCharacterId":"436","sourceWorkId":"13830","spoiler":false},{"segments":[{"spoiler":false,"text":"レノ的補佐官之二。"},{"spoiler":false,"text":"在各种各样的业务上支援レノ。"},{"spoiler":false,"text":"和ユーユ是双胞胎姐妹，如果说起イリシア神殿中「两姐妹里有着极大威望的那位」，那肯定就是サーサ。"},{"spoiler":false,"text":"能够在ミルサント操纵很少有人能使用的高机能演算光炉的特殊技术者，擅长运用数据。"}],"source":"bangumi","sourceCharacterId":"12451"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92d9d7286c6ea41fa4fe08b7e4f12a2e85f9b79b17887dfd0bc85f532e4660d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca3bb853e081fad081b7c4075d5277292305aac217ab888c2fd6e4ae43e222ea.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奏雨","creatorId":"vndb:s199","sourcePersonId":"vndb:s199","canonicalEntityId":"vndb:s199","name":"尾崎 真実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42860","source":"vndb"}]},{"characterId":"char_c26803","characterName":"ポッカ","sourceIds":{"bangumi":[],"egsCharacterIds":["438"],"vndbCharacterId":"c26803"},"originalCharacterName":"ポッカ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"マルゴーの娘。"},{"spoiler":false,"text":"まだ小さいのにおひさま焼き屋を手伝う利発な子。"},{"spoiler":false,"text":"ぷぅに対しては、妹が出来たみたいで嬉しいのか、やたらとお姉さんぶる。"},{"spoiler":false,"text":"太陽の女神・プロミア様に心の底から憧れている"},{"spoiler":false,"text":"（ぷぅがプロミアであることには気づいていない）。"},{"spoiler":false,"text":"将来の夢は「六花になること」。"},{"spoiler":false,"text":"「ぷろみあさまって、ほんとーにえらいのよ！」"}],"source":"egs","sourceCharacterId":"438","sourceWorkId":"13830","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e16a1104b40bc23a1387411eeb2dbef19fd459d9e152f00e19cecace43f7e62.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59dcdb14989187e87c74f19aa8308a4c235d8534d6b0258353bf5febd904da80.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"卯衣","creatorId":"vndb:s1178","sourcePersonId":"vndb:s1178","canonicalEntityId":"vndb:s1178","name":"大橋 歩夕","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42869","source":"vndb"}]},{"characterId":"char_c26804","characterName":"マルゴー","sourceIds":{"bangumi":[],"egsCharacterIds":["437"],"vndbCharacterId":"c26804"},"originalCharacterName":"マルゴー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"おひさま焼き屋の主人。"},{"spoiler":false,"text":"おひさま焼き職人としての腕はピカイチ。"},{"spoiler":false,"text":"神官になる前は調理師を目指していたニーナも、その腕前には一目置いている。"},{"spoiler":false,"text":"よく言えばおおらかで、悪く言えば大雑把な人柄。"},{"spoiler":false,"text":"とても楽天的で、細かいことは気にしない。"},{"spoiler":false,"text":"「お、美味そうに食うじゃねーか。"},{"spoiler":false,"text":"今度はもっとすごいの食わせてやるから、ちょっと待ってろ！」"}],"source":"egs","sourceCharacterId":"437","sourceWorkId":"13830","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7eef9263bdcf5b0215aad8d8078044fb128791fdf124663799775c73b6620f56.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e25cd11ac7012563fda0dcde75c8b4468fd20ec43403e0596e98299a95b399a6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"祭大!","creatorId":"vndb:s1196","sourcePersonId":"vndb:s1196","canonicalEntityId":"vndb:s1196","name":"上別府 仁資","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42870","source":"vndb"}]},{"characterId":"char_vndb_c25720","characterName":"コダマ","sourceIds":{"vndbCharacterId":"c25720"},"originalCharacterName":"コダマ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Waking up near a meteor crater, the suspicious man with amnesia finds himself connected to a mysterious infant by an unbreakable string and the only clue to his own identity is the name Kodama. Having no idea about what lies ahead of his life, the man goes on a journey to get his memory back while helping the six flowers to protect Milsant from misfortunes."}],"source":"vndb","sourceCharacterId":"c25720"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72bf6969f607c683d3837e015f57f35ec17d0961a133c0c957788a3de0fbfc2c.webp","fallbackUrl":"https://wiki-assets