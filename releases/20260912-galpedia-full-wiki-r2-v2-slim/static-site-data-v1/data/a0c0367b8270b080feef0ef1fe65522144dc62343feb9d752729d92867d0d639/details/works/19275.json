219023"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85ab7b5576a4288d099968fd233942eba895b62bcb86e68a5ac13975aa1626e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/620ef51729e356ca945b35e72b4d015e4b0424b5d891f4a4428c069eb8fc1a52.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"mahilo","creatorId":"vndb:s1492","sourcePersonId":"vndb:s1492","canonicalEntityId":"vndb:s1492","name":"眞尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:83262:219023:34633:1","source":"bangumi"}]},{"characterId":"char_c47393","characterName":"ハル","sourceIds":{"bangumi":[{"characterId":"219020","match":"exact-normalized-name-in-linked-work","subjectId":"83262"}],"egsCharacterIds":["2071"],"vndbCharacterId":"c47393"},"originalCharacterName":"ハル","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公。使い魔変身時は、ハ・リーポッ・ターロン・ダンブ・ルドアス・ネイプ・ハグ・リッドマル・フォイ（通称：ハル）と名乗る。"},{"spoiler":false,"text":"小さな女の子が好きすぎて、童貞のまま30歳を迎えて魔法使いとなった男。"},{"spoiler":false,"text":"そろそろ童貞を捨てたいと思いつつも、理想の女の子がいないので、今回の計画を思いついた。"},{"spoiler":false,"text":"そのため、異世界『リ・ロータ』からやってきた妖精ハルとして、リ・ロータを救うマジックアイテムを集めるよう、さくらに近づく。"},{"spoiler":false,"text":"魔女っ娘に仕立て上げたさくらとレイリの使う魔法は、バレないようにしながら彼が全て発動させている。"},{"spoiler":false,"text":"「ボクと契約して魔女っ娘になってよ！」"}],"source":"egs","sourceCharacterId":"2071","sourceWorkId":"19275","spoiler":false},{"segments":[{"spoiler":false,"text":"本名はハ・リーポッ・ターロン・ダンブ・ルドアス・ネイプ・ハグ・リッドマル・フォイ。 通称・ハル。"},{"spoiler":false,"text":"小さな女の子が好き過ぎて、童貞のまま30歳を迎えて魔法使いとなった男。"},{"spoiler":false,"text":"そろそろ童貞を捨てたいと思いつつも、理想の女の子がいないので今回の計画を思いついた。"},{"spoiler":false,"text":"目標は、どんな激しく犯されて感じていても、必死に堪える姿を見せる健気な正義の魔女っ娘ヒロインを作り出すこと。"},{"spoiler":false,"text":"そのため使い魔に姿を変えて、さくらに近づく。"},{"spoiler":false,"text":"魔女っ娘に仕立て上げたさくらとレイリの使う魔法は、バレないように彼がすべて発動させている。"}],"source":"bangumi","sourceCharacterId":"219020"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5dd167701b7f2d68626ec55e0046f36c3788214a9266ecab13fad482e19d90f7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e03816c60cc713928869bae1885e24f6ab7f24e3a9c8bc41f877e2b6904e923.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p384","sourceCompanyId":"egs:brand:1869","canonicalEntityId":"vndb:p384","name":"HEAT-SOFT","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:19275:1869","source":"egs"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonicalEntityId":"vndb:p384","name":"ヒートソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:32223:v12932","source":"vndb"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonicalEntityId":"vndb:p384","name":"ヒートソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:34117:v12932","source":"vndb"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonicalEntityId":"vndb:p384","name":"ヒートソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:34645:v12932","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
