staff:104238","source":"vndb"},{"creditedName":"しまさらゆめき","creatorId":"vndb:s9293","sourcePersonId":"vndb:s9293","canonicalEntityId":"vndb:s9293","name":"しまさらゆめき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:104239","source":"vndb"},{"creditedName":"aina","creatorId":"vndb:s9294","sourcePersonId":"vndb:s9294","canonicalEntityId":"vndb:s9294","name":"aina","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:104240","source":"vndb"},{"creditedName":"グランテール井上","creatorId":"vndb:s9295","sourcePersonId":"vndb:s9295","canonicalEntityId":"vndb:s9295","name":"グランテール井上","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:104241","source":"vndb"},{"creditedName":"大木 犬太郎","creatorId":"vndb:s10273","sourcePersonId":"vndb:s10273","canonicalEntityId":"vndb:s10273","name":"大木 犬太郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:104242","source":"vndb"},{"creditedName":"kobi","creatorId":"vndb:s10984","sourcePersonId":"vndb:s10984","canonicalEntityId":"vndb:s10984","name":"kobi","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:104243","source":"vndb"}]},"cast":[{"characterId":"char_c42844","characterName":"朔屋 直正","sourceIds":{"bangumi":[{"characterId":"12807","match":"exact-normalized-name-in-linked-work","subjectId":"13445"}],"egsCharacterIds":["12019"],"vndbCharacterId":"c42844"},"originalCharacterName":"朔屋 直正","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本編の主人公。航海士達の色仕掛けに引っかかり、信天翁号に二等航海士として引きずりこまれる羽目になった、他の船員に比べれば比較的常識人だが、実は躁鬱の起伏激しい困りもので、躁状態時は無敵の海の男となり（ただし全く根拠のない自信なので、結局滅茶苦茶弱い）、鬱状態時には重力にさえ耐えかねて行動不能となる、鬱陶しい芋虫男となる。"},{"spoiler":false,"text":"一言でいってしまうと、助平で、臆病で、面倒くさがりで怠惰なダメ人間。"},{"spoiler":false,"text":"性的欲望に対してはストレートなタイプで、港に着くとひゃっほうとお茶屋（隠語）のお姉ちゃんと自由恋愛しに降りていく（婉曲的表現）。"},{"spoiler":false,"text":"しかし女の子より酒が好きで、優先順位は酒＞女の子となる。"},{"spoiler":false,"text":"信天翁号に乗りこんだ経緯はなし崩しだが、漠然と面白おかしく遊んで呑んで暮らせる国にいければいいなあ、この船はいろんな国に行くようだから、きっとそう言う国もあるに違いないとか駄目人間な願望を抱いている。"}],"source":"egs","sourceCharacterId":"12019","sourceWorkId":"13785","spoiler":false},{"segments":[{"spoiler":false,"text":"航海士たちの色仕掛けに引っかかり、信天翁号に二等航海士として引きずりこまれる羽目になった、"},{"spoiler":false,"text":"他の船員に比べれば比較的常識人だが、実は躁鬱の起伏激しい困りもので、躁状態時は無敵の海の男となり （ただし全く根拠のない自信なので、結局滅茶苦茶弱い）、鬱状態時には重力にさえ耐えかねて行動不能となる、鬱陶しい芋虫男となる。"},{"spoiler":false,"text":"一言で言ってしまうと、助平で、臆病で、面倒くさがりで怠惰なダメ人間。"},{"spoiler":false,"text":"「あああ堪忍してぇっ、その銭まで巻き上げられたら、明日のお酒呑めなくなっちゃうううっ」"}],"source":"bangumi","sourceCharacterId":"12807"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/812bd26ec8f2310f510134fdce2cdc851991d8255c47e38425bd73d00012abe2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/257bf3d8132c70da8485a645ccb0467ef316ebc3b9ed3a3799933cff98e471a8.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c42862","characterName":"智里","sourceIds":{"bangumi":[{"characterId":"12803","match":"exact-normalized-name-in-linked-work","subjectId":"13445"},{"characterId":"12803","match":"exact-normalized-name-in-linked-work","subjectId":"86361"}],"egsCharacterIds":["3043"],"vndbCharacterId":"c42862"},"originalCharacterName":"智里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公を追って、女客と共に船に乗りこんでいた殺し屋。"},{"spoiler":false,"text":"金田一耕助みたいな衣装の、日本人なのになぜか蒼い眸の優男だが、人には見えないモノが見えてしまっているせいで、喋る言葉が脈絡なく、かつ意味不明で、会話がろくに成り立たない。"},{"spoiler":false,"text":"機関長や宗右衛門とウマが合うらしく、よく三者でチェスや花札を打っている。"},{"spoiler":false,"text":"藤蔓で巻いた、居合い拵えの刀をぶら下げるときもある。"}],"source":"egs","sourceCharacterId":"3043","sourceWorkId":"13785","spoiler":false},{"segments":[{"spoiler":false,"text":"白い単衣の着物に袴を着崩し、雪駄ばきという何処の書生かというなりの青年。"},{"spoiler":false,"text":"整った顔立ちをしているのだが、どこか油断のできない鋭さと、人を食った諧謔を同居させる、朔屋の悪友。"},{"spoiler":false,"text":"藤蔓で巻いた、居合い拵えの刀をぶら下げるときもあり、尋常ならざる剣腕を見せる。"},{"spoiler":false,"text":"黒髪の日本人だが蒼い眸（伝奇、武侠小説で言う破邪の眸、浄眼である）を具え、人には見えないモノが見えてしまっているせいで、ときおり言葉に脈絡をなくし、かつ意味不明で、会話が成り立たなくなる時がある。"},{"spoiler":false,"text":"女子供にも分け隔てなく、そのひねくれた言行を示すため、居合わせた女性陣からは軒並み「最低」との言葉を賜る。"}],"source":"egs","sourceCharacterId":"3043","sourceWorkId":"19696","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公を追って、女客と共に船に乗りこんでいた殺し屋。"},{"spoiler":false,"text":"金田一耕助みたいな衣装の、日本人なのになぜか蒼い眸の優男だが、人には見えないモノが見えてしまっているせいで、喋る言葉が脈絡なく、かつ意味不明で、会話がろくに成り立たない。"},{"spoiler":false,"text":"機関長や宗右衛門とウマが合うらしく、よく三者でチェスや花札を打っている。"},{"spoiler":false,"text":"「お前ね。俺が言うのもアレなんだが、お前―――見事なまでのダメ人間だなあ」"}],"source":"bangumi","sourceCharacterId":"12803"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4ec4621e4b8fa083727c6c6f61d3fff6e01b188813ea1fcede1c2f606089535.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0f1615cf6b7c0aecbea568e12fd52b0b78fc0a58f164fc1e41cacf5ca3f38d0.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c49869","characterName":"オキカゼ・B","sourceIds":{"bangumi":[{"characterId":"159252","match":"exact-normalized-name-in-linked-work","subjectId":"43559"},{"characterId":"159252","match":"exact-normalized-name-in-linked-work","subjectId":"64583"}],"egsCharacterIds":["5351"],"vndbCharacterId":"c49869"},"originalCharacterName":"オキカゼ・B","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"移動舞台の座長を自称する少年。"},{"spoiler":false,"text":"その年頃にしては色々と逞しくこすっからく、浮き世擦れしてどうにもオッさんくさい。"},{"spoiler":false,"text":"人を言いくるめるのが得意だが、基本的には詐術の底が浅い為、細々とは稼いでも総計では負けがかさんでいるタイプ。"},{"spoiler":false,"text":"ただし時には大一番を引き当てるときがある。"},{"spoiler":false,"text":"ポケットの中にはなんにもなくても、とりあえず一晩の飯と酒だけは何処かから掠め取ってくる。"},{"spoiler":false,"text":"かつて見世物女の沙流江を苦界から救い出したことがあり、それ以来の腐れ縁。"},{"spoiler":false,"text":"乗馬服風の一見小粋な衣装とハットがトレードマークだが、いずれもよくよく見ると擦り切れて貧乏くさい。"}],"source":"egs","sourceCharacterId":"5351","sourceWorkId":"17325","spoiler":false},{"segments":[{"spoiler":false,"text":"移動舞台の座長を自称する少年。"},{"spoiler":false,"text":"その年頃にしては色々とたくましくこすっからく、浮き世擦れしてどうにもオッさんくさい。"},{"spoiler":false,"text":"人を言いくるめるのが得意だが、基本的には詐術の底が浅いため、細々とは稼いでも総計では負けがかさんでいるタイプ。"},{"spoiler":false,"text":"ただし時には大一番を引き当てるときがある。"},{"spoiler":false,"text":"かつて見世物女のシャルーエを苦界から救い出したことがあり、それ以来の腐れ縁。"}],"source":"bangumi","sourceCharacterId":"159252"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c8751a0c0f9f84b5e1dea8fad08c3b363b067964b15c932341bc113279df0ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba45a2268c952b35f302ebd652428dc107983f884503b100df9d26386248d948.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c49870","characterName":"沙流江","sourceIds":{"bangumi":[{"characterId":"146571","match":"exact-normalized-name-in-linked-work","subjectId":"43559"},{"characterId":"146571","match":"exact-normalized-name-in-linked-work","subjectId":"64583"},{"characterId":"146571","match":"exact-normalized-name-in-linked-work","subjectId":"86361"}],"egsCharacterIds":["3041"],"vndbCharacterId":"c49870"},"originalCharacterName":"沙流江","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"移動舞台のただ一人の見世物女にして、座長の少年、オキカゼ・Ｂの情婦。"},{"spoiler":false,"text":"繊細な美貌の女ながら、額に三つ目の眼があるフリークス。"},{"spoiler":false,"text":"黙っていれば愁いを帯びた麗人タイプなのだが、性格的には世話焼きの姐さん女房タイプ。"},{"spoiler":false,"text":"その上、からかわれたりいじめられて泣いてしまうことが気持ちよかったりするマゾヒストでもあるので、しゃべり出すと色々台無しになってしまう残念美人でもある。"},{"spoiler":false,"text":"かつて苦界にいたところをオキカゼに救い出されて以来、彼にベタ惚れ。"}],"source":"egs","sourceCharacterId":"3041","sourceWorkId":"17325","spoiler":false},{"segments":[{"spoiler":false,"text":"駅に流れ着いてうだつの上がらない日々を送る、座長と芸子二人だけの『移動サアカス団』の、ただ一人の見世物女にして、座長の少年、オキカゼ・Ｂの情婦。"},{"spoiler":false,"text":"繊細な美貌の女ながら、額に三つ目の眼があるフリークス。"},{"spoiler":false,"text":"黙っていれば愁いを帯びた麗人タイプなのだが、性格的には世話焼きの姐さん女房タイプ。"},{"spoiler":false,"text":"その上からかわれいじめられて泣いてしまうことが気持ちよかったりするマゾヒストでもあるので、しゃべり出すと色々台無しになってしまう残念美人でもある。"},{"spoiler":false,"text":"かつて苦界にいたところをオキカゼに救い出されて以来、彼にベタ惚れ。"}],"source":"egs","sourceCharacterId":"3041","sourceWorkId":"17347","spoiler":false},{"segments":[{"spoiler":false,"text":"前々作、擾乱譚ヒロイン。"},{"spoiler":false,"text":"移動サーカス団のただ一人の見世物役。"},{"spoiler":false,"text":"繊細な美貌の女ながら、額に三つ目の眼があるフリークス。"},{"spoiler":false,"text":"黙っていれば愁いを帯びた麗人タイプなのに、性格的には世話焼きの姐さん女房タイプでアグレッシヴなマゾヒスト。"},{"spoiler":false,"text":"今回は、情夫である少年から引き離されて、気が付くと亡霊列車に乗り合わせてしまっていた。"},{"spoiler":false,"text":"おかげで心も体も色々淋しい。"}],"source":"egs","sourceCharacterId":"3041","sourceWorkId":"19696","spoiler":false},{"segments":[{"spoiler":false,"text":"移動舞台のただ一人の見世物女にして、座長の少年、オキカゼ・Ｂの情婦。"},{"spoiler":false,"text":"繊細な美貌の女ながら、額に三つ目の眼があるフリークス。"},{"spoiler":false,"text":"黙っていれば愁いを帯びた麗人タイプなのだが、"},{"spoiler":false,"text":"性格的には世話焼きの姐さん女房タイプ。"},{"spoiler":false,"text":"その上、からかわれたりいじめられて"},{"spoiler":false,"text":"泣いてしまうことが気持ちよかったりするマゾヒストでもあるので、"},{"spoiler":false,"text":"しゃべり出すと色々台無しになってしまう残念美人でもある。"},{"spoiler":false,"text":"かつて苦界にいたところをオキカゼに救い出されて以来、彼にベタ惚れ。"},{"spoiler":false,"text":"「うぅー、わたしだって、好きでこんな乳がでかくなったわけじゃあないんだ。"},{"spoiler":false,"text":"あ。やめておくれな、ぺちんってしないで、"},{"spoiler":false,"text":"よして、先ッちょひっぱらないで、痛い、痛い、痛きもちイイッ、も、もっとぉ……ッ」"}],"source":"bangumi","sourceCharacterId":"146571"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98eb98f3b25d92a74b0d0017b39b165b7385a1852f1f49ffca0596d1a8133eec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15c9ef4592959790214ca3a83d9b17b716c9596cc1670e5efe8d27928e0040ef.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野月 まひる","creatorId":"vndb:s298","sourcePersonId":"vndb:s298","canonicalEntityId":"vndb:s298","name":"野月 まひる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55734","source":"vndb"}]},{"characterId":"char_c49872","characterName":"瑛","sourceIds":{"bangumi":[{"characterId":"159249","match":"exact-normalized-name-in-linked-work","subjectId":"498468"},{"characterId":"159249","match":"exact-normalized-name-in-linked-work","subjectId":"86361"}],"egsCharacterIds":["2928"],"vndbCharacterId":"c49872"},"originalCharacterName":"瑛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"b"}},"descriptions":[{"segments":[{"spoiler":false,"text":"前作年代史現代編および未来編登場キャラクター。"},{"spoiler":false,"text":"逞しく駅の地べたを生き抜く"},{"spoiler":false,"text":"ステーションチルドレンの一人。タアミナルのＡ。女の子のような可愛らしい顔立ちをしているのだが、"},{"spoiler":false,"text":"浮浪児暮らしが長いせいで図太く、容易に他人には頼らない。"},{"spoiler":false,"text":"そして実は、『駅』の歴史に深く関わる人物でもある。"},{"spoiler":false,"text":"銀髪の双子とシラギクとは浅からぬ奇縁がある。"}],"source":"egs","sourceCharacterId":"2928","sourceWorkId":"19696","spoiler":false},{"segments":[{"spoiler":false,"text":"【駅の浮浪児】"},{"spoiler":false,"text":"現代編ヒロイン。ステーションチルドレンの一人。"},{"spoiler":false,"text":"ずっと駅で浮浪児暮らしを送っており、現在はトゥアンを相棒としている。"},{"spoiler":false,"text":"猫族の孤高と自己充足でもって生きており、基本的に他人に容易に心を開かず、優しさを示さない。"},{"spoiler":false,"text":"