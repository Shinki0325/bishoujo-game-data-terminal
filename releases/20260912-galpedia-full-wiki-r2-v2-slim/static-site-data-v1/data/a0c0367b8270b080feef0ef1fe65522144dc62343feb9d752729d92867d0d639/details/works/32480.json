},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A magical girl."},{"spoiler":false,"text":"As part of a three-member idol unit, she was sent to the Cathedral with her two friends as part of a military propaganda campaign to join the Special Warfare Trooper Corps. Her prodigious talent sets her head and shoulders above her colleagues. The hardships and cruelty of show business behind the scenes has given her a severe, cynical outlook."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c102745"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/0426fd6b9e431216bb894f544e5a82ec64a329b174ad360f749430e37d6ce4e8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f65b681f46f0697726d41cdf0b6f8fe29dd30a657f86d0202b3f72fa99653dbd.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"手塚 りょうこ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90327","source":"vndb"}]},{"characterId":"char_vndb_c102746","characterName":"飯塚 みのり","sourceIds":{"vndbCharacterId":"c102746"},"originalCharacterName":"飯塚 みのり","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"19"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A magical girl."},{"spoiler":false,"text":"Nine years ago, her home, the Mars East Canal Base, was destroyed by the C.C. invasion. Her family perished in the attack, leaving Minori alone as the sole survivor. She was rescued by Lisette, and ever since then she aspired to become a magical girl just like her savior."},{"spoiler":false,"text":"She's hard-working, serious, and sincere. Her personality tends to get her in trouble, making her an easy mark of for abuse and humiliation from senior officers."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c102746"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f49a7de1f1b8094f7140825a71e3e49832e5d13b980a8934ad5b4c5f019b9ecc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba9d6103391dd21c4a4783860487e8908bacb614f254697ab9842c24efe70641.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いねむり すやこ","creatorId":"vndb:s14338","sourcePersonId":"vndb:s14338","canonicalEntityId":"vndb:s14338","name":"藤沢 れい香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90331","source":"vndb"}]},{"characterId":"char_vndb_c102748","characterName":"ルパート・キニスン","sourceIds":{"vndbCharacterId":"c102748"},"originalCharacterName":"ルパート・キニスン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/feecfec1bd560590587960aec5b1cb8d010af8872ee7037128804db7b9e5a7ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/282ef4cc7f9eae0a8a38834bb303ca52219514629c801a9e0715fb822adfb810.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"プル斎藤","creatorId":"vndb:s25345","sourcePersonId":"vndb:s25345","canonicalEntityId":"vndb:s25345","name":"プル斎藤","roleCode":"voice-actor","roleLabel":"声优","i