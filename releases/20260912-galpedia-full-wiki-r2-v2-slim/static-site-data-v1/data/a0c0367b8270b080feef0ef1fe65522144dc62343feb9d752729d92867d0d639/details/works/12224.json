{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"12224","model":{"presentationWorkId":"vndb:v2893","staff":{"artwork":[{"creditedName":"川合正起","creatorId":"vndb:s898","sourcePersonId":"egs:creator:351","canonicalEntityId":"vndb:s898","name":"川合正起","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:75681","source":"egs"}],"scenario":[{"creditedName":"野良うさぎ","creatorId":"vndb:s9017","sourcePersonId":"egs:creator:13702","canonicalEntityId":"vndb:s9017","name":"野良うさぎ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:75682","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c26696","characterName":"脇坂 佳奈絵","sourceIds":{"bangumi":[{"characterId":"215596","match":"exact-normalized-name-in-linked-work","subjectId":"224351"}],"egsCharacterIds":["15554"],"vndbCharacterId":"c26696"},"originalCharacterName":"脇坂 佳奈絵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"22"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"98"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"68"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が性調教を依頼された人妻。"},{"spoiler":false,"text":"結婚二年目の22歳。"},{"spoiler":false,"text":"女子短大を卒業して入社した一流企業のOL時代に出会った先輩社員と結婚。"},{"spoiler":false,"text":"裕福な家庭に生まれ、親の躾が行き届いた、俗にいう“育ちの良い娘”。"},{"spoiler":false,"text":"ほんわかした雰囲気で、性格もほわわんとしている。"},{"spoiler":false,"text":"短大時代に付き合っていた恋人と数回程度のセックス経験しかなく、性に対して未成熟。"},{"spoiler":false,"text":"旦那とのセックスもほとんどマグロ状態だが、彼女自身は十分満足している。"}],"source":"egs","sourceCharacterId":"15554","sourceWorkId":"12224","spoiler":false},{"segments":[{"spoiler":false,"text":"年齢22歳。　（Ｂ：98 Ｗ：68 Ｈ：95）（Ｅカップ）"},{"spoiler":false,"text":"ほんわか、ほんわかした夢の中に生きるような女。"},{"spoiler":false,"text":"問題なく女子短大を卒業し、一流企業のＯＬとなり、"},{"spoiler":false,"text":"そのまま上司の勧めで先輩社員と結婚した。"},{"spoiler":false,"text":"子供の頃からそれなりに裕福な家庭で育ったため、親の躾が行き届いている。"},{"spoiler":false,"text":"男性経験は、短大生になってから一人だけ恋人が居たが"},{"spoiler":false,"text":"数回しかセックスはしていない。"},{"spoiler":false,"text":"結婚してからも、夫に求められるままセックスをしているが"},{"spoiler":false,"text":"基本は大の字になって遊ばれているだけのマグロ。"},{"spoiler":false,"text":"そんな性生活に、佳奈絵は十分満足しているのだった……。"}],"source":"bangumi","sourceCharacterId":"215596"}],"profileFacts":[{"label":"年龄（本版本）","value":"22 岁","valueContext":null,"source":"egs","sourceCharacterId":"15554","sourceWorkId":"12224","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"15554","sourceWorkId":"12224","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"15554","sourceWorkId":"12224","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"15554","sourceWorkId":"12224","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"68 cm","valueContext":null,"source":"egs","sourceCharacterId":"15554","sourceWorkId":"12224","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91a7cb257aa2b0b8ffb73325141697a4300905a871f0a4255a0290a70fc4cd69.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7561cb8dcd4ea17c076f07cc949c0aabd389a39a007c5f74ce79fce4725b600.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"汐風 よる","creatorId":"vndb:s4746","sourcePersonId":"vndb:s4746","canonicalEntityId":"vndb:s4746","name":"汐風 よる","roleCode":"