{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"16821","model":{"presentationWorkId":"vndb:v656","staff":{"artwork":[{"creditedName":"千葉 千夏","creatorId":"vndb:s6561","sourcePersonId":"vndb:s6561","canonicalEntityId":"vndb:s6561","name":"千葉 千夏","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:13683","source":"vndb"}],"scenario":[{"creditedName":"中本 穂積","creatorId":"vndb:s1225","sourcePersonId":"vndb:s1225","canonicalEntityId":"vndb:s1225","name":"中本 穂積","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:13679","source":"vndb"},{"creditedName":"天崎 カケル","creatorId":"vndb:s3037","sourcePersonId":"vndb:s3037","canonicalEntityId":"vndb:s3037","name":"天崎 カケル","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:13681","source":"vndb"}],"music":[{"creditedName":"ebi","creatorId":"vndb:s1052","sourcePersonId":"vndb:s1052","canonicalEntityId":"vndb:s1052","name":"ebi","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:13677","source":"vndb"},{"creditedName":"下地 和彦","creatorId":"vndb:s1105","sourcePersonId":"vndb:s1105","canonicalEntityId":"vndb:s1105","name":"下地 和彦","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:13678","source":"vndb"}],"other":[{"creditedName":"パリオ","creatorId":"vndb:s2790","sourcePersonId":"vndb:s2790","canonicalEntityId":"vndb:s2790","name":"パリオ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:13680","source":"vndb"},{"creditedName":"KIRIKO","creatorId":"vndb:s4335","sourcePersonId":"vndb:s4335","canonicalEntityId":"vndb:s4335","name":"KIRIKO/HIKO Sound","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:13682","source":"vndb"}]},"cast":[{"characterId":"char_c54977","characterName":"佐藤 彗佳","sourceIds":{"bangumi":[{"characterId":"147639","match":"exact-normalized-name-in-linked-work","subjectId":"180913"}],"egsCharacterIds":["25034"],"vndbCharacterId":"c54977"},"originalCharacterName":"佐藤 彗佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"都心にある四条院学園に通う二年生。"},{"spoiler":false,"text":"主人公の生き別れの義妹。"},{"spoiler":false,"text":"物静かで大人しい性格ながら、意外としっかりしていて責任感が強く、所属する天文部では部長を務めている。"},{"spoiler":false,"text":"和を乱す部員がいると、背後から接近し、セーラー服の上からブラのホックを外す必殺技を炸裂させる。"},{"spoiler":false,"text":"お菓子作りは抜群に巧いが、料理の腕前はからっきし。"}],"source":"egs","sourceCharacterId":"25034","sourceWorkId":"8320","spoiler":false},{"segments":[{"spoiler":false,"text":"都心の学園に通う二年生。離れ離れになって音信が途絶えていた、恋に恋する義妹。"},{"spoiler":false,"text":"星が大好きで、幼い頃は義兄（恭平）と一緒によく夜空を見上げていた。"},{"spoiler":false,"text":"○○の頃にキツネから貰った『願い星』をネックレスにして、いつも身につけている。"},{"spoiler":false,"text":"清楚で照れ屋。何事も自分より友達を優先させてしまう。運動音痴で疲れやすい。"},{"spoiler":false,"text":"二年生にして天文部の部長を務め、おとなしい性格ながらも、一生懸命にみんなをマトメあげている。お菓子作りが得意だが、料理は下手。"},{"spoiler":false,"text":"控えめで頼りなげな娘だが、みんなの和を乱す部員には、背後から急接近してセーラー服の上からブラを外すという技を断行する。"},{"spoiler":false,"text":"「ファーストキスは、お兄ちゃんじゃなきゃイヤ……」"}],"source":"bangumi","sourceCharacterId":"147639"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a3fd4aff2ccbb47ba20717dace687d5e80a2773291d15d35fbb7ca2ae9625e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11cbcb3935dc5423709fbfd46904efd095d19b08f5e4a6bb93920f5f7ca5a1b0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田佳代","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:180913:147639:6038:1","source":"bangumi"}]},{"characterId":"char_c54978","characterName":"楠木 由美","sourceIds":{"bangumi":[{"characterId":"147640","match":"exact-normalized-name-in-linked-work","subjectId":"180913"}],"egsCharacterIds":["25035"],"vndbCharacterId":"c54978"},"originalCharacterName":"楠木 由美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"都心にある四条院学園に通う二年生。天文部に所属。"},{"spoiler":false,"text":"主人公の叔母・楠木加代の娘。"},{"spoiler":false,"text":"主人公の従妹にあたり、幼馴染の関係でもある。"},{"spoiler":false,"text":"明朗快活で、非常にアクティブな性格だが、思い立ったら考えなしで即実行に移す、無鉄砲なところも。"},{"spoiler":false,"text":"宮座の血筋の娘で、学園を卒業後は巫女の修行を積む予定になっているが、女で一つで育ててくれた母親に感謝し、早く楽にさせてあげたいと、すぐにメイプル荘を継ぎたいと思っている。"},{"spoiler":false,"text":"そのため、家事全般が得意で、家庭的な面を持つ。"}],"source":"egs","sourceCharacterId":"25035","sourceWorkId":"8320","spoiler":false},{"segments":[{"spoiler":false,"text":"都心の学園の寮生で、天文部の二年生。"},{"spoiler":false,"text":"メイプル荘の看板娘。恭平とは従兄妹で幼馴染み。彗佳とは同級生で親友。"},{"spoiler":false,"text":"純朴で元気で、思い立ったが即行動の無鉄砲な性格の女の子で、結構おマヌケ。"},{"spoiler":false,"text":"幼い頃は小児喘息に苦しみ、転地療養の為に避暑地にペンションを開いてくれた両親にとても感謝しており、恩返ししたいと思っている。"},{"spoiler":false,"text":"宮座の血筋の娘であり、家訓により、卒業後は巫女の修行をする予定だが、本人はすぐにメイプル荘を継いで、お母さんを楽させたい。"},{"spoiler":false,"text":"家事全般と料理が上手で、安い食材を美味しく調理するのが得意。お菓子作りはイマイチ。"},{"spoiler":false,"text":"好きなものは、ブルーハワイのかき氷。嫌いなものはモンジャ焼き。"},{"spoiler":false,"text":"恭平に亡父の面影を見ているが、それは恋愛よりも憧憬にちかいようだ。"},{"spoiler":false,"text":"「ムキーッ！　なんで、いつまで経っても手え出してこぉへんのよ!?」"}],"source":"bangumi","sourceCharacterId":"147640"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02a660fe704cb856bd03b1cd293f511c960a6dd7f8696efdcbc3b08b7745f1e0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0eba4ca2eaf5b25bfe2183d2d5f458e0b61e737f6a8580e4f7e2e04851d267ca.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:180913:147640:5906:1","source":"bangumi"}]},{"characterId":"char_c54979","characterName":"朝比奈 一子","sourceIds":{"bangumi":[{"characterId":"147641","match":"exact-normalized-name-in-linked-work","subjectId":"180913"}],"egsCharacterIds":["25036"],"vndbCharacterId":"c54979"},"originalCharacterName":"朝比奈 一子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"都心にある四条院学園に通う一年生。天文部に所属。"},{"spoiler":false,"text":"大家族で十人姉妹の長女。"},{"spoiler":false,"text":"ほのぼのしていて、おっとりのんびりマイペースな性格。"},{"spoiler":false,"text":"天文部ではその性格と可愛らしい容姿とが相俟ってマスコット的な存在。"},{"spoiler":false,"text":"一度に二つのことを任せると混乱してパニックを状態になる不器用さを持つ。"},{"spoiler":false,"text":"なかなか伸びない背と膨らんでくれない胸にコンプレックスを抱いており、毎日の牛乳は欠かさない。"}],"source":"egs","sourceCharacterId":"25036","sourceWorkId":"8320","spoiler":false},{"segments":[{"spoiler":false,"text":"都心の学園に通う、天文部の一年生。チビッコだが十人姉妹の長女。"},{"spoiler":false,"text":"幼児期にメイプル荘に泊まった事があるリピーターだが、本人は覚えていない。"},{"spoiler":false,"text":"可愛い物を集めるのが好きで、本人の容姿もミニマムで可愛らしい。おっとりした喋り方で、のんびりマイペース。"},{"spoiler":false,"text":"ほのぼのとした性格で周囲を和ませる、色んなものがちょっとずつ足りない女の子。"},{"spoiler":false,"text":"天文部のマスコット的存在で皆の妹分だが、ワガママな○○というわけではなく、意外にも責任感があり、望遠鏡の管理を任されている。"},{"spoiler":false,"text":"だが一度の二つの事を任せると、混乱してパニック状態になってしまう。"},{"spoiler":false,"text":"三年生の茉莉絵に可愛がられており、分不相応な大人（？）の知識を持っているらしい。"},{"spoiler":false,"text":"「一子の予言は50％で当たります。今夜は晴れ時々曇り、所によっては一時雨～」"}],"source":"bangumi","sourceCharacterId":"147641"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7dd81e943f63bfa4585e595250a249930d1e29f4e35611e3a606b596e908c134.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4ac111e590158c77c5dbd4b2a6c70c132a80b97b6fa9f1ced31c49507dc3d5b8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結下みちる","creatorId":"vndb:s794","sourcePersonId":"vndb:s794","canonicalEntityId":"vndb:s794","name":"結下 みちる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:180913:147641:4705:1","source":"bangumi"}]},{"characterId":"char_c54980","characterName":"能登 茉莉絵","sourceIds":{"bangumi":[{"characterId":"147642","match":"exact-normalized-name-in-linked-work","subjectId":"180913"}],"egsCharacterIds":["25037"],"vndbCharacterId":"c54980"},"originalCharacterName":"能登 茉莉絵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"都心にある四条院学園に通う三年生。天文部兼水泳部。"},{"spoiler":false,"text":"性格は勝気で、自由奔放。"},{"spoiler":false,"text":"感情表現豊かで、ボーイッシュな女の子。"},{"spoiler":false,"text":"ちゃらんぽらんだが、部員が少ない天文部に入部し、廃部の危機を救うなど、意外にイイ人。"},{"spoiler":false,"text":"抜群に大きく育った胸（＝巨乳）にコンプレックスを抱いているようで、胸を弄られる（＝言葉）とキレる。"},{"spoiler":false,"text":"競泳水着の日焼け跡が気になるなど、女の子らしい一面も持つ。"}],"source":"egs","sourceCharacterId":"25037","sourceWorkId":"8320","spoiler":false},{"segments":[{"spoiler":false,"text":"都心の学園に通う三年生。水泳部兼天文部員。"},{"spoiler":false,"text":"メイプル荘には夏季合宿というより、レジャー気分で遊びにきている。"},{"spoiler":false,"text":"感情をストレートに表に出す、スポーツ系の勝気娘。　天文部一の巨乳ながら、一人称は「ボク」。"},{"spoiler":false,"text":"お姉さんぶって、その手の経験談を後輩に聞かせておちょくるも、実は耳年増なだけという噂も。"},{"spoiler":false,"text":"チャランポランな性格をしており、団体行動を乱しがちだが、困っている後輩を捨ておけず、部員が少なく廃止の危機がある天文部に入った。"},{"spoiler":false,"text":"大学に進学したいのだが、勉強全般が苦手で「分からないところが分からない」。"},{"spoiler":false,"text":"競泳用水着に跡に日焼けした肌が恥ずかしく、水着姿になってもパーカーで隠してしまう。"},{"spoiler":false,"text":"男勝りでありながら、そんな風に等身大の乙女の悩みを抱えている。"},{"spoiler":false,"text":"「ボクと勝負しよ！　もちろん何か賭けてさ。一日デート券とか」"}],"source":"bangumi","sourceCharacterId":"147642"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/2076c9bbbd88062cdaf4c363f3842bdfc10533979008d6f71f31c32fbfd332fb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a5e4c959dac54362ded79a0f0064381d8e89e396b0f6186fe83760af720fe1e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:180913:147642:4956:1","source":"bangumi"}]},{"characterId":"char_c54981","characterName":"桑原 詩音","sourceIds":{"bangumi":[{"characterId":"147643","match":"exact-normalized-name-in-linked-work","subjectId":"180913"}],"egsCharacterIds":["25038"],"vndbCharacterId":"c54981"},"originalCharacterName":"桑原 詩音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"都心にある四条院学園に通う三年生。"},{"spoiler":false,"text":"常に物憂げで無表情、必要以上なことは喋らない。"},{"spoiler":false,"text":"他人に干渉されることを嫌い、また周囲にも無関心。"},{"spoiler":false,"text":"そうしたことから、掴みどころがなく、エキセントリックな女の子。"},{"spoiler":false,"text":"元は音楽部に所属していたが、思うところがあって退部し、気分転換として天文部に籍を置いているらしい。"},{"spoiler":false,"text":"怒ると「腕ゾウキン」と呼ばれる絞め技を繰り出し、相手を圧殺する。"}],"source":"egs","sourceCharacterId":"25038","sourceWorkId":"8320","spoiler":false},{"segments":[{"spoiler":false,"text":"都心の学園の寮生で、天文部の三年生。暗く冷たく無表情で、他人に干渉されるのを嫌い周囲にも無関心。"},{"spoiler":false,"text":"元は音楽部に所属しプロ級の腕もつ先輩とパートナーを組んでいたが、思うところがあって退部。"},{"spoiler":false,"text":"現在は理恵にすすめられ、気分転換として天文部に在籍している。自分からは発言も行動もしないが、部の事をよく見ており、時折鋭い正論を吐く。"},{"spoiler":false,"text":"動物や植物を愛でる時は穏やかな表情を見せるも、人が近づくと顔を曇らせる。多分、甘え方をしらない不器用な娘なのだろう。"},{"spoiler":false,"text":"誰かに怒った時は「腕ゾウキン」の荒技を発揮。地味な反撃に出る。茉莉絵からは「ヌヌヌ」という変なアダ名で呼ばれ、それが面白くない。"},{"spoiler":false,"text":"「……私に構って、不幸になっても知りませんよ？」"}],"source":"bangumi","sourceCharacterId":"147643"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b5fadf1e5940af3ed542e100d705b9b9ada77956d1db27cce52e2f4870fb29b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43560aed5c9c9563186e3e34588e58d83da0b2ab50fe1f096ff3eeea1f5be540.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:180913:147643:5890:1","source":"bangumi"}]},{"characterId":"char_c54982","characterName":"楠木 加代","sourceIds":{"bangumi":[{"characterId":"147644","match":"exact-normalized-name-in-linked-work","subjectId":"180913"}],"egsCharacterIds":["25039"],"vndbCharacterId":"c54982"},"originalCharacterName":"楠木 加代","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"星稜高原にあるペンション「メイプル荘」の女オーナー。"},{"spoiler":false,"text":"主人公の叔母。娘の通う四条院学園の卒業生でもある。"},{"spoiler":false,"text":"数年前に夫に先立たれてから、女手一つで娘・由美を育て、ペンションを切り盛りしてきた。"},{"spoiler":false,"text":"そうした苦労を背負ってきたにも関わらず、若さを損なうことなく、性格も少女のように天真爛漫。"},{"spoiler":false,"text":"加えて母親らしい包容力を持ち、家事全般も容易にこなし、料理の腕前も抜群。卑怯なほどに完璧な女性。"}],"source":"egs","sourceCharacterId":"25039","sourceWorkId":"8320","spoiler":false},{"segments":[{"spoiler":false,"text":"星稜高原にあるペンション・メイプル荘の女オーナー。"},{"spoiler":false,"text":"数年前に夫と死別してからは、女手ひとつでメイプル荘を切り盛りし、娘の由美を育ててきた。"},{"spoiler":false,"text":"しかし、そんな苦労や不幸を感じさせず、常にメイド服を身に纏う天真爛漫な性格。"},{"spoiler":false,"text":"由美や恭平達を見守り導きながら、決して答えは教えずに、自分の力で幸せを掴み取らせるよく出来たお母さん。"},{"spoiler":false,"text":"そんな加代の人柄引かれやってくる、リピーターも多い。家事と料理の腕は由美を遥かに凌ぐ。"},{"spoiler":false,"text":"少女時代に、星稜高原の星巫女を務めた経験があり、神智的な隠れ識者。"},{"spoiler":false,"text":"宮座の家訓に則り、自分の血を受け継ぐ由美を、いずれ巫女として神社に仕えさせるつもりでいる。"},{"spoiler":false,"text":"「メイド服は淑女の戦闘服よ。小娘が着るのは十年はやい！」"}],"source":"bangumi","sourceCharacterId":"147644"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/9078454b13a3d29f5f6295767004b497d01f6360e705871ade6c1c4218f7f5de.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f670d622b317b0add63b5152c09648b513c21ab0a29e23c2f0cae0a5c151037.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉田愛理","creatorId":"vndb:s757","sourcePersonId":"vndb:s757","canonicalEntityId":"vndb:s757","name":"吉田 愛理","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:180913:147644:6037:1","source":"bangumi"}]},{"characterId":"char_c54983","characterName":"鯉川 理恵","sourceIds":{"bangumi":[{"characterId":"147645","match":"exact-normalized-name-in-linked-work","subjectId":"180913"}],"egsCharacterIds":["25040"],"vndbCharacterId":"c54983"},"originalCharacterName":"鯉川 理恵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"都心にある四条院学園の女教師。"},{"spoiler":false,"text":"天文部の顧問でもあり、今回、メイプル荘での合宿に引率してきた。"},{"spoiler":false,"text":"ペンションのオーナー・加代は大学時代の先輩で、まったく頭があがらない。"},{"spoiler":false,"text":"優しさのなかに厳しさを持つ女教師で、生徒たちからも慕われている。"},{"spoiler":false,"text":"天体観測よりも星にまつわる神話に興味を持つ、ロマンチスト。"},{"spoiler":false,"text":"今回の合宿でも、何かと加代に振り回され、貧乏くじばかりを引いている。"}],"source":"egs","sourceCharacterId":"25040","sourceWorkId":"8320","spoiler":false},{"segments":[{"spoiler":false,"text":"都心の学園の女教師で、皆を引率してきた天文部の顧問。"},{"spoiler":false,"text":"加代の大学時代の後輩。体育会の縦社会の延長におり、未だに頭があがらない。"},{"spoiler":false,"text":"優しく厳しい不断の態度で学生達に慕われているが、先生というよりは「気のいいお姉さん」といったところ。"},{"spoiler":false,"text":"天体観測よりも、星にまつわる神話に興味がある学者気質。"},{"spoiler":false,"text":"何かと加代に振りまわされる律儀さが祟ってか、宿命的に貧乏クジばかり引いてしまう。幸運パラメーターが異様に低い人。"},{"spoiler":false,"text":"「乙女の白星、それを追うサソリの心臓の紅い星……星の話は好きかしら？」"}],"source":"bangumi","sourceCharacterId":"147645"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94c0da689842edbb0477e5d7bbd2037b57f66b078b034a88cdd0e8319e2612a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc53ada48cfbbfdd7bc30a9338c2b4c17f55e6f21be0888a4d6aa970a03a8154.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:180913:147645:5075:1","source":"bangumi"}]},{"characterId":"char_c54984","characterName":"キツネ","sourceIds":{"bangumi":[{"characterId":"147646","match":"exact-normalized-name-in-linked-work","subjectId":"180913"}],"egsCharacterIds":["25033"],"vndbCharacterId":"c54984"},"originalCharacterName":"キツネ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"星稜高原に昔からある神社に封印されていた、謎の九尾狐。"},{"spoiler":false,"text":"神の使いを自称する彼女だが、見た目はケモノの耳とシッポ（＝九本）を生やした小さな女の子。"},{"spoiler":false,"text":"宙に浮かぶ不思議な玉に寝そべりながら、偉そうな口調と態度で主人公にあれこれアドバイス（？）する。"},{"spoiler":false,"text":"封印を解いてくれた主人公に、その恩返しと称して「縁結び」の神通力を行使するも、まったく助力にならず、様々なハプニングを引き起こすトラブルメーカー。"},{"spoiler":false,"text":"ちなみに、何故、封印されていたのか、本人はまったく覚えていない。"}],"source":"egs","sourceCharacterId":"25033","sourceWorkId":"8320","spoiler":false},{"segments":[{"spoiler":false,"text":"星稜高原に昔からある神社に封印されていた、謎の九尾狐。"},{"spoiler":false,"text":"キツネの耳と尻尾が生えたちいさな女の子で、いつも不思議な玉に寝そべり宙に浮んでいる。偉そうな性格で自称神の使い。"},{"spoiler":false,"text":"封印を解いた恭平に憑依し、「恩返し」で「縁結び」の神通力を何度も行使するが、すべて的外れなイタズラでありドタバタの元凶。"},{"spoiler":false,"text":"どうして封印されていたのかキツネ自身も覚えておらず、とりあえず力を快復させるべく、メイプル荘の冷蔵庫を勝手にあさる毎日。"}],"source":"bangumi","sourceCharacterId":"147646"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee66fad788d7fed0b60741918cedbd5caf980c3bf1c103055fd2a980320671a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/455ab1f7841e30279372f8c8d9e9d2bcea915ddcb66040cc1e881bc931ee3b78.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:180913:147646:4830:1","source":"bangumi"}]},{"characterId":"char_vndb_c54985","characterName":"戸田 恭平","sourceIds":{"vndbCharacterId":"c54985"},"originalCharacterName":"戸田 恭平","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p284","sourceCompanyId":"egs:brand:1056","canonicalEntityId":"vndb:p284","name":"SCORE【しゅこあ!】","roleCodes":["brand"],"identi