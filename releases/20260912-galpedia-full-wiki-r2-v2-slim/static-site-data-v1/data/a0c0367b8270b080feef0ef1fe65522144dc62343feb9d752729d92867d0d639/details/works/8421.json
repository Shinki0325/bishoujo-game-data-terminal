,"descriptions":[{"segments":[{"spoiler":false,"text":"The school nurse at Full Bloom Academy. He's a talented pharmacist, the likes of which even the highest ranked academics will admit their admiration of, and is currently working on a number of rather dubious medicines for the school's use. He keeps a few hidden adult videos somewhere, but he's devoted to Kio most of all."}],"source":"vndb","sourceCharacterId":"c15520"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b5b3bdf30da5553733b711c3c31f5c4af815c9a8d241a5e3ee3af6201837988.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb549fe66a684d74234c672c7cb4b534e65a380c8eb46dde94b82cfaaa500fd6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一条 和矢","creatorId":"vndb:s256","sourcePersonId":"vndb:s256","canonicalEntityId":"vndb:s256","name":"一条 和矢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24492","source":"vndb"}]},{"characterId":"char_vndb_c15521","characterName":"沢田 喜緒","sourceIds":{"vndbCharacterId":"c15521"},"originalCharacterName":"沢田 喜緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A former student, who acts as Ryougoku's helper. He grew up in an orphanage, until one day a certain pharmacist took him in to experiment on-- until Ryougoku saved him from that cruel treatment. Ever since then, he's been head-over-heels in love with Ryougoku."}],"source":"vndb","sourceCharacterId":"c15521"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d39ed6dca311a5a2be7d0cc28d5670fb3ab7b28a592b8c0cce05b6200b421481.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01c29024fd337ffbd3e376f645d5de889c9155192e100c93d02e0d97577c644f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳥海 浩輔","creatorId":"vndb:s45","sourcePersonId":"vndb:s45","canonicalEntityId":"vndb:s45","name":"鳥海浩輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24488","source":"vndb"}]},{"characterId":"char_vndb_c15522","characterName":"名神 英姿","sourceIds":{"vndbCharacterId":"c15522"},"originalCharacterName":"名神 英姿","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third-year student, a member of the Host department. Excelling at his Host duties, he's earned quite a lot of money despite only being a student. He's very devoted to Yuusu, and bought him as a Pet Maid and became his Master."}],"source":"vndb","sourceCharacterId":"c15522"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f06f2edbd2fd56955f956ad070a39fde7e82f793f2e01d8d28dac778c04f5172.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cf4edb39f681dae34f2326324e1dcfde9284827fa575e8ed5afcbb02ea5ddef.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤 健太郎","creatorId":"vndb:s89","sourcePersonId":"vndb:s89","canonicalEntityId":"vndb:s89","name":"伊藤 健太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24490","source":"vndb"}]},{"characterId":"char_vndb_c15523","characterName":"中牧 遊水","sourceIds":{"vndbCharacterId":"c15523"},"originalCharacterName":"中牧 遊水","characterNameSource":null,"role":"primar