"relationId":"vndb:vn-staff:23617","source":"vndb"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:23618","source":"vndb"},{"creditedName":"チーム・やしガニ","creatorId":"vndb:s593","sourcePersonId":"vndb:s593","canonicalEntityId":"vndb:s593","name":"チーム・やしガニ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:23619","source":"vndb"},{"creditedName":"笹＠","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:23623","source":"vndb"},{"creditedName":"笹＠","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:23624","source":"vndb"}]},"cast":[{"characterId":"char_c1972","characterName":"リエリ・ビショップ","sourceIds":{"bangumi":[{"characterId":"64965","match":"exact-normalized-name-in-linked-work","subjectId":"303916"},{"characterId":"64965","match":"exact-normalized-name-in-linked-work","subjectId":"89157"},{"characterId":"64965","match":"exact-normalized-name-in-linked-work","subjectId":"89161"}],"egsCharacterIds":["3725"],"vndbCharacterId":"c1972"},"originalCharacterName":"リエリ・ビショップ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Universal Federation Army Commander. A senior investigator belonging to the army military police investigation department. A beautiful woman commissioned officer who has a lovely, calm, cool, and collected judgment. She is a New Solar, being born on Planet Titan. She is heading an investigation regarding the unlawful activities being conducted by the Neo Terrors' politicians. Having witnessed the cesspools the Neo Terrors have covered with injustice and corruption, it is her conviction that the only way to peace in the galaxy is through getting the New Solars fired up with justice and an ideal by exposing the Neo Terrors' injustice again and again. She has become popular with the New Solars' citizens from those achievements and her lovely features, the New Solars' reasons being praised extravagantly due to her."},{"spoiler":false,"text":"From Dark Translations"}],"source":"vndb","sourceCharacterId":"c1972"},{"segments":[{"spoiler":false,"text":"ニュー・ソラル派の宇宙連邦軍中佐。"},{"spoiler":false,"text":"軍憲兵捜査部所属の上級捜査官。"},{"spoiler":false,"text":"沈着冷静な判断力と美貌の持ち主。"},{"spoiler":false,"text":"ネオ・テラーズ派を悪の巣窟であると憚らず、宇宙の恒久的な平和は健全なるニュー・ソラル派によってのみ成し遂げられると信じて疑わず、これまで数々のネオ・テラーズ派の不正を暴いてきた。"},{"spoiler":false,"text":"そのためニュー・ソラル派からは絶大な支持を得ているが、逆にネオ・テラーズ派からは憎悪の対象となっている。"}],"source":"egs","sourceCharacterId":"3725","sourceWorkId":"8826","spoiler":false},{"segments":[{"spoiler":false,"text":"宇宙連邦軍中佐。軍憲兵捜査部に所属する上級捜査官。"},{"spoiler":false,"text":"美しさと冷静沈着な判断力をもった美女将校。"},{"spoiler":false,"text":"惑星タイタン出身のニュー・ソラル派。"},{"spoiler":false,"text":"ネオ・テラーズ派の大物政治家が主導している非合法活動について調査している。"},{"spoiler":false,"text":"汚職や不正に塗れたネオ・テラーズ派を悪の巣窟と見ている。"},{"spoiler":false,"text":"理想と正義に燃えるニュー・ソラル派によってしか銀河は平和にならないとという信念のもと、数々のネオ・テラーズ派の不正を暴いてきた。"},{"spoiler":false,"text":"その実績と美しい容貌からニュー・ソラル派市民に人気が高く、ニュー・ソラルの理性と持て囃されている。"}],"source":"egs","sourceCharacterId":"3725","sourceWorkId":"11942","spoiler":false},{"segments":[{"spoiler":false,"text":"中佐。軍憲兵捜査部に所属する上級捜査官。"},{"spoiler":false,"text":"美しさと冷静沈着な判断力をもった美女仕官。"},{"spoiler":false,"text":"惑星タイタン出身のニュー・ソラル派。"},{"spoiler":false,"text":"汚職や権益、不正に塗れたネオ・テラーズ派を悪の巣窟と見ており、理想と正義に燃えるニュー・ソラル派によってしか銀河は平和にならないとという信念のもと、数々のネオ・テラーズ派の不正を暴いてきた。"},{"spoiler":false,"text":"その能力と美しい容貌からニュー・ソラル派市民に人気が高く、ニュー・ソラルの理性と持て囃されている。"},{"spoiler":false,"text":"現在はジャサント号事件で一度逮捕されるも脱走したネオ・テラーズの工作員ドニ・ボーガンを追っている。"},{"spoiler":false,"text":"「ディノ・ディラッソ……いくつか尋問したいことがあります」"}],"source":"egs","sourceCharacterId":"3725","sourceWorkId":"14022","spoiler":false},{"segments":[{"spoiler":false,"text":"中佐。軍憲兵捜査部に所属する上級捜査官。"},{"spoiler":false,"text":"美しさと冷静沈着な判断力をもった美女仕官。"},{"spoiler":false,"text":"惑星タイタン出身のニュー・ソラル派。"},{"spoiler":false,"text":"汚職や権益、不正に塗れたネオ・テラーズ派を悪の巣窟と見ており、理想と正義に燃えるニュー・ソラル派によってしか銀河は平和にならないとという信念のもと、数々のネオ・テラーズ派の不正を暴いてきた。"},{"spoiler":false,"text":"その能力と美しい容貌からニュー・ソラル派市民に人気が高く、ニュー・ソラルの理性と持て囃されている。"},{"spoiler":false,"text":"現在はジャサント号事件で一度逮捕されるも脱走したネオ・テラーズの工作員ドニ・ボーガンを追っている。"}],"source":"egs","sourceCharacterId":"3725","sourceWorkId":"19714","spoiler":false},{"segments":[{"spoiler":false,"text":"宇宙連邦軍 中佐。 美しさと冷静沈着な判断力をもった美女将校。"},{"spoiler":false,"text":"軍憲兵捜査部に所属する上級捜査官。 ニュー・ソラル派の急先鋒。"},{"spoiler":false,"text":"ネオ・テラーズ派の大物政治家が主導している非合法活動について調査している。"},{"spoiler":false,"text":"汚職や不正に塗れたネオ・テラーズ派を悪の巣窟と見ており、理想と正義に燃えるニュー・ソラル派によってしか太陽系に平和は訪れないという信念のもと、数々のネオ・テラーズ派の不正を暴いてきた。"},{"spoiler":false,"text":"その実績と美しい容貌からニュー・ソラル派市民に人気が高く、“ニュー・ソラルの理性” と持てはやされている。"}],"source":"bangumi","sourceCharacterId":"64965"}],"profileFacts":[{"label":"出身","source":"bangumi","sourceCharacterId":"64965","value":"タイタン"},{"label":"所属","source":"bangumi","sourceCharacterId":"64965","value":"ニューソラル"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e54726bf7298fd1bc0debf5163d78a003381e88d211185702abbfc885544a91.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e243bcda57d6247e785eac42ff7dc592a566f16fbabacb75b9609856e2dcb40.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:89157:64965:5890:1","source":"bangumi"}]},{"characterId":"char_c1973","characterName":"ナオミ・エヴァンス","sourceIds":{"bangumi":[{"characterId":"64964","match":"exact-normalized-name-in-linked-work","subjectId":"303916"},{"characterId":"64964","match":"exact-normalized-name-in-linked-work","subjectId":"89157"},{"characterId":"64964","match":"exact-normalized-name-in-linked-work","subjectId":"90781"}],"egsCharacterIds":["2583"],"vndbCharacterId":"c1973"},"originalCharacterName":"ナオミ・エヴァンス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Universal Federation Army Major. A New Solar born on Planet Titan. Naomi Evans is an aide to the investigators in the army military police investigation department. Learning to operate the self-propelled robot soldier called the \"Gun Turtle\" is said to be extremely difficult, but Naomi is able to operate as many as 4 at once. Excelling in close combat herself as well, she has won two championships in Titan's hand-to-hand tournaments. Originally, she was the eldest daughter of the mercantile house associating with House Bishop, but because of her time spent as a child with Lieri, she walked the path of military personnel in the steps of Lieri. Naturally, with going to the same government school as Lieri, Lieri has become more than just Naomi's senior officer, thinking of each other as true sisters. Because of Lieri's influence on her, she considers the savage, mass ideologies of the Neo Terrors, antiquated. Again, because of her superiority, she often attracts trouble from the male soldiers who look down on her as being bossy and arrogant."},{"spoiler":false,"text":"From Dark Translations"}],"source":"vndb","sourceCharacterId":"c1973"},{"segments":[{"spoiler":false,"text":"ニュー・ソラル派の宇宙連邦軍少佐。"},{"spoiler":false,"text":"軍憲兵捜査部所属の捜査官で、リエリの副官を務めている。"},{"spoiler":false,"text":"宇宙連邦軍の陸戦部隊に正式採用されている自走ロボット兵“ガンタートル”を4機同時に操れる天才。"},{"spoiler":false,"text":"また格闘術にも優れ、惑星タイタンで開催される格闘大会で二度優勝した経験を持つ。"},{"spoiler":false,"text":"幼い頃からリエリと行動を共にしていた彼女は、憧れていたリエリの後を追うように軍職に就く。"},{"spoiler":false,"text":"彼女自身、優秀であるが故に、自分よりも劣る男を蔑み、馬鹿にする傾向にある。"},{"spoiler":false,"text":"また、リエリの影響でネオ・テラーズ派を良く思っていない。"}],"source":"egs","sourceCharacterId":"2583","sourceWorkId":"8826","spoiler":false},{"segments":[{"spoiler":false,"text":"宇宙連邦軍少佐。惑星タイタン出身のニュー・ソラル派。"},{"spoiler":false,"text":"軍憲兵捜査部の捜査官で、リエリ・ビショップの副官。"},{"spoiler":false,"text":"習得が非常に困難と言われているガンタートルと呼ばれる自走ロボット兵の操作術を得意としていて、ナオミは一度に4機を操れる天才。"},{"spoiler":false,"text":"接近戦闘にも優れていて、タイタンでの格闘大会で二度優勝の経験を持つ。"},{"spoiler":false,"text":"元々はビショップ家に出入りしていた商家の長女であったが、幼い頃からリエリと行動を共にしており、リエリの後を追う様に軍人の道を歩んでいる。"},{"spoiler":false,"text":"もちろん仕官学校もリエリと同じで、ナオミにとってリエリは憧れの先輩であり、実の姉のように愛している存在。"},{"spoiler":false,"text":"リエリの影響から、ネオ・テラーズを古くて野蛮な思想集団と見なしている。"},{"spoiler":false,"text":"また優秀さ故、高圧的で男を馬鹿にする傾向があり男性兵士とのトラブルが多い。"}],"source":"egs","sourceCharacterId":"2583","sourceWorkId":"11942","spoiler":false},{"segments":[{"spoiler":false,"text":"宇宙連邦軍。少佐。"},{"spoiler":false,"text":"軍憲兵捜査部の捜査官で、リエリ・ビショップの副官。"},{"spoiler":false,"text":"習得が非常に困難と言われているガンタートルと呼ばれる自走ロボット兵の操作術を得意としていて、ナオミは一度に4機を操れる天才。"},{"spoiler":false,"text":"接近戦闘にも優れていて、タイタンでの格闘大会で二度優勝の経験を持つ。"},{"spoiler":false,"text":"元々はビショップ家に出入りしていた商家の長女であったが、幼い頃からリエリと行動を共にしており、リエリの後を追う様に軍人の道を歩んでいる。"},{"spoiler":false,"text":"もちろん仕官学校もリエリと同じで、ナオミにとってリエリは憧れの先輩であり、実の姉のように愛している存在。"},{"spoiler":false,"text":"リエリの影響から、ネオ・テラーズを古くて野蛮な思想集団と見なしている。"},{"spoiler":false,"text":"また優秀さ故、高圧的で男を馬鹿にする傾向があり男性兵士とのトラブルが多い。"},{"spoiler":false,"text":"「黙れ。私の本能がお前を問答無用で殺しておけと警告している！」"}],"source":"egs","sourceCharacterId":"2583","sourceWorkId":"19807","spoiler":false},{"segments":[{"spoiler":false,"text":"宇宙連邦軍 少佐。 軍憲兵捜査部の捜査官で、リエリ・ビショップの副官。"},{"spoiler":false,"text":"習得が非常に困難といわれている “ガンタートル” と呼ばれる自走ロボット兵の操作術を得意としていて、ナオミは一度に4機を操れる天才。"},{"spoiler":false,"text":"接近戦闘にも優れていて、タイタンでの格闘大会で二度優勝の経験を持つ。"},{"spoiler":false,"text":"元々はビショップ家に出入りしていた商家の長女であったが、幼い頃からリエリと行動を共にしており、リエリの後を追うように軍人の道を歩んでいる。"},{"spoiler":false,"text":"もちろん仕官学校もリエリと同じで、ナオミにとってリエリは憧れの先輩であり、実の姉のように愛している存在。"},{"spoiler":false,"text":"リエリの影響から、ネオ・テラーズを古くて野蛮な思想集団と見なしている。"},{"spoiler":false,"text":"また優秀さゆえ、高圧的で男を馬鹿にする傾向があり男性兵士とのトラブルが多い。"}],"source":"bangumi","sourceCharacterId":"64964"}],"profileFacts":[{"label":"出身","source":"bangumi","sourceCharacterId":"64964","value":"タイタン"},{"label":"所属","source":"bangumi","sourceCharacterId":"64964","value":"ニューソラル"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba4a8368ad4f95b2fea75fe46906180ec930cf6cd7975f6e330ea8dcf75b9007.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc8462bcc931141425f2ce0735dcc00828ef7917a11d90329a4e75230a29417e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:89157:64964:5741:1","source":"bangumi"}]},{"characterId":"char_vndb_c1974","characterName":"ドニ・ボーガン","sourceIds":{"vndbCharacterId":"c1974"},"originalCharacterName":"ドニ・ボーガン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"As a Universal Federation Army Major, he is captain of the battleship Jasant in charge of transporting key figures. However, his hidden persona is as a special spy working for the Neo Terrors and an illegal agent who accomplishes his missions through sabotage and assassination. He also has an interest in acquiring fame for himself; he has no political attachments and has no interest in the Neo Terrors and New Solars getting along, but from his point of view upon hearing the hypocrisy of the New Solars, he does have a firm attachment to the more human Neo Terrors and their corrupt ways. Donny's interest is in human brainwashing techniques by means of memory implants using brainwashing devices, that, he thinks, will be useful in propelling his rise to fame. As for his ideas, he carries out his methods like a mad man, unfearing too of god when he creates completely new and artificial personalities. In the past, he had an experience of being imprisoned upon making a mistake in his mission relating to Lieri and Naomi, and after being released from prison, he has planned a sequence of events in determined revenge against those two people by altering their personalities."},{"spoiler":false,"text":"from Dark Translations"}],"source":"vndb","sourceCharacterId":"c1974"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12137dd27e912343cdb81a4e30074da20d142c936a0bb67b88103d9646756cf2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/251e6b9bc4690fde3daf22e4ed6e50d8ba3a069a5ab1fe543bfcb70273f2c446.webp","width":113,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1412","sourceCompanyId":"egs:brand:1586","canonicalEntityId":"vndb:p1412","name":