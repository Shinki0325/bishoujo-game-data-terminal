b:s8290","canonicalEntityId":"vndb:s8290","name":"中津 真莉","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:49226","source":"vndb"}]},{"characterId":"char_vndb_c25971","characterName":"神田 空太","sourceIds":{"vndbCharacterId":"c25971"},"originalCharacterName":"神田 空太","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"509"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sorata is the male protagonist of the story. He is a second-year student of Suiko, who lives in room 101 of Sakurasou Dormitory. He was kicked out of the standard school dorm after he chose not to throw away a stray cat he picked up."},{"spoiler":false,"text":"As many of the Sakurasou Dormitory residents have outstanding grades and art skills, he often feels plain and normal among them. He is chosen by Chihiro to take care of Mashiro's daily life, although he resists at first, but he ends up getting used to it. Sorata used to play soccer in elementary and junior high, but he quit because he lost his passion for it."},{"spoiler":false,"text":"Sorata has proven to be kind-hearted to a fault. He has a habit of not being able to turn away from abandoned cats and always ends up taking them home. So far, he has picked up 7 cats; namely Hikari, Nozomi, Kodama, Tsubasa, Komachi, Aoba, Asahi. This has resulted in Sorata being kicked out of standard dorms which do not tolerate pets."}],"source":"vndb","sourceCharacterId":"c25971"}],"profileFacts":[],"metadataCandidateConflicts":{},"imag