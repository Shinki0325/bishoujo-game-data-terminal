{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"11254","model":{"presentationWorkId":"vndb:v1008","staff":{"artwork":[{"creditedName":"まあたん","creatorId":"vndb:s14735","sourcePersonId":"egs:creator:12694","canonicalEntityId":"vndb:s14735","name":"まあたん","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:71047","source":"egs"}],"scenario":[{"creditedName":"黒田如風","creatorId":"vndb:s20125","sourcePersonId":"egs:creator:3161","canonicalEntityId":"vndb:s20125","name":"黒田如風","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:71048","source":"egs"}],"music":[],"other":[{"creditedName":"まあたん","creatorId":"vndb:s14735","sourcePersonId":"vndb:s14735","canonicalEntityId":"vndb:s14735","name":"まあたん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:18620","source":"vndb"},{"creditedName":"黒田 如風","creatorId":"vndb:s20125","sourcePersonId":"vndb:s20125","canonicalEntityId":"vndb:s20125","name":"黒田 如風","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:18622","source":"vndb"}]},"cast":[{"characterId":"char_c37130","characterName":"賀茂 由喜","sourceIds":{"bangumi":[{"characterId":"147425","match":"exact-normalized-name-in-linked-work","subjectId":"184787"}],"egsCharacterIds":["17186"],"vndbCharacterId":"c37130"},"originalCharacterName":"賀茂 由喜","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"とある学園に通う女子校生。"},{"spoiler":false,"text":"両親が離婚し、現在は父親と妹の三人で暮らしている。"},{"spoiler":false,"text":"裏表のない、明るく気さくな性格から、友達も多く、クラスの中心的な存在。"},{"spoiler":false,"text":"人に頼まれると嫌とは云えないお人好しで、やや抜けたところもある。"},{"spoiler":false,"text":"誰とでもキスをしたがる、いわゆる「キス魔」。"},{"spoiler":false,"text":"人に求められたことを断ると嫌われるかもしれない、という強迫観念の持ち主。"}],"source":"egs","sourceCharacterId":"17186","sourceWorkId":"11254","spoiler":false},{"segments":[{"spoiler":false,"text":"ゲームの主人公。とある学園に通う女の子。"},{"spoiler":false,"text":"とても明るい性格で誰ともすぐに打ち解けあい、いつもクラスで輪の中心にいる。"},{"spoiler":false,"text":"裏表がない性格で、嘘を言ってもすぐにバレてしまう。多少マヌケなところも。"},{"spoiler":false,"text":"人から頼み事をされるとイヤと言えないお人好し。"},{"spoiler":false,"text":"友人、家族、だれとでもキスをしたがる『キス魔』であり、ある意味クラスの中で恐れられている。"},{"spoiler":false,"text":"現在、両親が離婚しているため父親と妹の3人で暮らしている。"},{"spoiler":false,"text":"兄がいるものの、離婚した母親と暮らしているため、普段会うことはできない。"},{"spoiler":false,"text":"人が仲良くなるには相手の要求を極力受け入れるべきだと考えていて、また、人からの頼みを断ると嫌われるかもしれないという恐怖感を常に抱えている。"}],"source":"bangumi","sourceCharacterId":"147425"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49095b928d16cfb8aa54be782996e8515179c6413e9fb628f2826f22b8c203ad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/361af0d285461a8c46b89177c2bdbe86f9086a1112acd258a065cff50a205acd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:184787:147425:6106:1","source":"bangumi"}]},{"characterId":"char_c37131","characterName":"賀茂 紫眞","sourceIds":{"bangumi":[{"characterId":"147426","match":"exact-normalized-name-in-linked-work","subjectId":"184787"}],"egsCharacterIds":["17187"],"vndbCharacterId":"c37131"},"originalCharacterName":"賀茂 紫眞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuki's younger sister."}],"source":"vndb","sourceCharacterId":"c37131"},{"segments":[{"spoiler":false,"text":"明朗快活な姉とは対照的に、物静かで引っ込み思案な性格。"},{"spoiler":false,"text":"元来、臆病で、寂しがり屋の甘えん坊だった彼女は、両親が離婚して以来、それに拍車がかかった。"},{"spoiler":false,"text":"さらに姉と父の行為を覗き見てから、疎外感が強くなり、自分も姉と同じようになりたいと思うようになり……。"}],"source":"egs","sourceCharacterId":"17187","sourceWorkId":"11254","spoiler":false},{"segments":[{"spoiler":false,"text":"由喜の妹。"},{"spoiler":false,"text":"姉とは正反対の性格で、大人しく引っ込み思案。友達もそれほど多くはない。"},{"spoiler":false,"text":"臆病者で、寂しがり屋で甘えん坊。両親が離婚して以来、父と姉にべったりの性格になった。時折ひどいワガママを言い、姉や父親を困らせる。"},{"spoiler":false,"text":"ある日、父親と姉が性行為に及んでいる場面を偶然見かけてしまい、その日以来、性行為に強い興味と関心を持つ。"},{"spoiler":false,"text":"最初は覗き見るだけだったものの、次第に疎外感を抱くようになり、我慢できなくなって姉に性行為をしたいと申し出る。"}],"source":"bangumi","sourceCharacterId":"147426"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8bac3124d7ae8dd883d39772a2b23d7e7de6c9be0a5766573370ae13fe7be41d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59bcd336fd9d1724fcdb74b65067b86460e4089e7f8783ca5b0d34fe33578c5d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本井えみ","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:184787:147426:4177:1","source":"bangumi"}]},{"characterId":"char_c37134","characterName":"河川 千絵","sourceIds":{"bangumi":[],"egsCharacterIds":["17189"],"vndbCharacterId":"c37134"},"originalCharacterName":"河川 千絵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の友人で、クラスメイト。"},{"spoiler":false,"text":"学校外でも主人公とは仲が良く、放課後は一緒に遊ぶことが多い。"},{"spoiler":false,"text":"気さくで明るい性格から、友人からの相談事を受けることもしばしば。"},{"spoiler":false,"text":"他人にはアドバイスが出来るが、自分自身の悩みは解決できず、抱え込んでしまうタイプ。"},{"spoiler":false,"text":"現在、交際中の彼氏との仲がギクシャクしていて悩んでいる。"}],"source":"egs","sourceCharacterId":"17189","sourceWorkId":"11254","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77a0377701155a61efcd6d1868ebc87d3c805547e3c8fb79bb9d381cd576cd39.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4deed85cbc7ef9e5c58a1ecbf72862956fafc9242ff2dd0cacc60824a3ff8fd0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白井 綾乃","creatorId":"vndb:s665","sourcePersonId":"vndb:s665","canonicalEntityId":"vndb:s665","name":"あらい しずか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9157","source":"vndb"}]},{"characterId":"char_c37137","characterName":"弓削 美智子","sourceIds":{"bangumi":[],"egsCharacterIds":["17188"],"vndbCharacterId":"c37137"},"originalCharacterName":"弓削 美智子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuki's mother."}],"source":"vndb","sourceCharacterId":"c37137"},{"segments":[{"spoiler":false,"text":"主人公が小学生のときに父親と離婚し、長男（主人公の兄）と二人で暮らししている。"},{"spoiler":false,"text":"かつては教師をしていたが、現在は知人と一緒に設立した会社で多忙な日々を過ごしている。"},{"spoiler":false,"text":"自分の考えに絶対の自信を持ち、男女同権を標榜する女性。"},{"spoiler":false,"text":"カリスマ性が高く、仕事場では部下からの信頼も厚い。"},{"spoiler":false,"text":"しかし、家庭ではそうした性格が災いし、結婚生活が破局してしまう。"},{"spoiler":false,"text":"キャリアウーマン風の強い女性をイメージさせる彼女だが、実は好色で淫乱。"}],"source":"egs","sourceCharacterId":"17188","sourceWorkId":"11254","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1