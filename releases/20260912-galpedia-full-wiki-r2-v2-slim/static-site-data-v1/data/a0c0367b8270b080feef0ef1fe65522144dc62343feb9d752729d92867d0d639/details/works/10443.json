"source-native","relationId":"vndb:vn-seiyuu:79379","source":"vndb"}]},{"characterId":"char_vndb_c8625","characterName":"久瀬 修一","sourceIds":{"vndbCharacterId":"c8625"},"originalCharacterName":"久瀬 修一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"215"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"177"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"”Well, I’m in cahoots with Himura.”"},{"spoiler":false,"text":"A spirited professional violinist and former student of Otowa Collegiate, though he left halfway through to study in Germany. Displays animated optimism, but is actually a realist on the inside. His selfless acts are to hide all traces of his true intentions in order to focus on what lies ahead."},{"spoiler":false,"text":"He’s like an older brother to his next-door neighbor Renji. Also a bit of a flirt towards Renji’s mother, Sumire Asou."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c8625"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3ce9e40442d69cbbd14fdfcc7c8f138f9430edcbd8e9a246b0ade512ac5c7b74.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd61059915a59df1a80d31c2d32e067e7539227d3060a6a0f35f0dbc91819c1f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安芸怜須 ケン","creatorId":"vndb:s385","sourcePersonId":"vndb:s385","canonicalEntityId":"vndb:s385","name":"浜田 賢二","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:79374","source":"vndb"}]},{"characterId":"char_vndb_c8626","characterName":"羽山 ミズキ","sourceIds":{"vndbCharacterId":"c8626"},"originalCharacterName":"羽山 ミズキ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1222"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"source-only","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"”Yes! Your dear Mizuki has arrived!”"},{"spoiler":false,"text":"An energetic girl belonging to the basketball team of Otowa Collegiate’s feeder school. Formerly Shindou Kei's junior, she is still quite a devoted fan. Mizuki has quite a few connections at Otowa Collegiate due to her relationship with Kei."},{"spoiler":false,"text":"Frank and spirited. Direct and rash. Charmed by too many things, and not wary of nearly enough, she’s a bit like a puppy. Admires her ”Kei-senpai” and aspires to be a ”cool woman”, though it’s obvious from her upbringing that it’s impossible. Loves shoujo manga."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c8626"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a00db4a523cadfc4e85e81fa9f2f40f0ffcb0dc61a1b1b898cd8dc7ab16f94a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7ea0c0ec5a591da446f6431a996783ba321c06d27deeda1f2950261e1377464.webp","width":209,"height":256,"source":"static-detail"},"actors":[{"creditedName