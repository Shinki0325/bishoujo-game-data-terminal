{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"10443","model":{"presentationWorkId":"vndb:v24372","staff":{"artwork":[{"creditedName":"七尾奈留(九尾、奈留)","creatorId":"egs:creator:13","sourcePersonId":"egs:creator:13","canonicalEntityId":"egs:creator:13","name":"七尾奈留(九尾、奈留)","roleCode":"artwork","roleLabel":"原画","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:66262","source":"egs"},{"creditedName":"2C=がろあ～(2C-GALORE)","creatorId":"vndb:s1101","sourcePersonId":"egs:creator:1698","canonicalEntityId":"vndb:s1101","name":"2C=がろあ～(2C-GALORE)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:66263","source":"egs"},{"creditedName":"七尾 奈留","creatorId":"vndb:s1102","sourcePersonId":"vndb:s1102","canonicalEntityId":"vndb:s1102","name":"七尾 奈留","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:152475","source":"vndb"}],"scenario":[{"creditedName":"御影","creatorId":"vndb:s957","sourcePersonId":"egs:creator:167","canonicalEntityId":"vndb:s957","name":"御影","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:103986","source":"egs"},{"creditedName":"鏡遊","creatorId":"vndb:s958","sourcePersonId":"egs:creator:2273","canonicalEntityId":"vndb:s958","name":"鏡遊","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:103987","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c1585","characterName":"麻生 蓮治","sourceIds":{"vndbCharacterId":"c1585"},"originalCharacterName":"麻生 蓮治","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1101"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"159"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Renji Asou who is half German, half Japanese is a protagonist of the third chapter in Ef: The Latter Tale."},{"spoiler":false,"text":"One day, when he goes to an abandoned train station where he often spends time, he meets a girl wearing an eyepatch over her left eye and sitting alone. The girl is Chihiro Shindo, the younger twin sister of Kei Shindo."},{"spoiler":false,"text":"Despite both of them being mutually shy, Renji comes back to see her at the station every day after school and quickly becomes friends with her."},{"spoiler":true,"text":"He later learns that she has a severe case of anterograde amnesia where she cannot remember anything past thirteen hours previous, aside from the events before the accident which she can recall perfectly."},{"spoiler":true,"text":"Renji also finds out that her dream is to write a fantasy novel, but due to her condition Chihiro has never been able to get far. Renji loves to read novels, and after discussing it with Chihiro, he collaborates with her to see if he can finally make her dream come true. Through the process of writing the novel, the two eventually become very close and they fall in love with each other. As the story progresses and more of the novel is written, Renji soon discovers that the novel is an allegory for Chihiro's life and how she sees the world around her due to the state of her limited memory."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c1585"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6da477a41d6dce60411f57950331c3eafef27c0bd91b4b1faf155f1c6071adc8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/7107b5e2e824e4b1ab940b68867afd9704542acd0fac99b92faf5ee7d32a9462.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊香川 椎音","creatorId":"vndb:s487","sourcePersonId":"vndb:s487","canonicalEntityId":"vndb:s487","name":"高城 元気","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:79377","source":"vndb"}]},{"characterId":"char_vndb_c1586","characterName":"新藤 千尋","sourceIds":{"vndbCharacterId":"c1586"},"originalCharacterName":"新藤 千尋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"602"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"77"},"height":{"reviewState":"source-only","source":"vndb","value":"151"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"},"weight":{"reviewState":"source-only","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"”Today, let me tell you a story about a rabbit.”"},{"spoiler":false,"text":"The younger of the identical twins. Very literary. She’s naturally quiet, the polar opposite of her sister Kei. Though she appears calm and collected, she seems childish when spoken to, and is a bit of an airhead. Due to a childhood accident, she lost her left eye and bears a unique handicap."},{"spoiler":false,"text":"She does not currently attend school, and would appear to be under recuperation. Has the habits of glancing up at people and of tilting her head."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c1586"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b1c2002ce61cbb004817c0e6441c10510991bc174c06116e615e4c8c76763e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bfc05ec2b0953af0d860a1f723d40cd8039f484a95615dfaf8bd91103170cf55.webp","width":209,"height":256,"source":"static-detail"},"actors":[{"creditedName":"まき いづみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:79373","source":"vndb"}]},{"characterId":"char_vndb_c5217","characterName":"雨宮 優子","sourceIds":{"vndbCharacterId":"c5217"},"originalCharacterName":"雨宮 優子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"621"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"”Oh my, oh my! Are you that interested in me?”"},{"spoiler":false,"text":"A woman waiting for someone at the church. She could pass as a nun, but doesn’t seem to be affiliated with the church."},{"spoiler":false,"text":"Her origins are unknown, but claims she has some sort of job to perform. Roaming Otowa’s streets, she suddenly presents herself to those who interest her, leaving deep guidance and counsel in a jovial manner."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c5217"}],"profileFacts":[],"metadataCandidateConflicts":{},"imag