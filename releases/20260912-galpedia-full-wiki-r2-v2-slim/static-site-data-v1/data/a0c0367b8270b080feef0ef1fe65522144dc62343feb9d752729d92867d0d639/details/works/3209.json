null,"source":"egs","sourceCharacterId":"27168","sourceWorkId":"3209","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"27168","sourceWorkId":"3209","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"27168","sourceWorkId":"3209","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"27168","sourceWorkId":"3209","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"27168","sourceWorkId":"3209","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1dbfe718f4a7488f9b689f1f54e64962272653ea7e9806d6b282ecc215b1ce5e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c153fcbd20959e85734ee66eafb9f10b63210543ba2c9830c2e8187edaee927a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"すずきけいこ","creatorId":"vndb:s445","sourcePersonId":"vndb:s445","canonicalEntityId":"vndb:s445","name":"涼森ちさと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:296397:147461:6275:1","source":"bangumi"}]},{"characterId":"char_c55156","characterName":"緒方 香苗","sourceIds":{"bangumi":[{"characterId":"147462","match":"exact-normalized-name-in-linked-work","subjectId":"296397"}],"egsCharacterIds":["27169"],"vndbCharacterId":"c55156"},"originalCharacterName":"緒方 香苗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"11/17"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"A"},"bust":{"reviewState":"no-conflict","source":"bangumi","va