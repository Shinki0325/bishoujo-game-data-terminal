viewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"舞台となるファミレス「フロレアール」の新人ウェイトレス。女子校生。"},{"spoiler":false,"text":"性格は大人しく、奥手で、これまでクラスの男子ともほとんど話したことがなかった。それは男子と話したりすることはいけない＝不良というイメージを持っていたからで、男子と遊ぶことすらも不純異性交遊と思っていた。"},{"spoiler":false,"text":"学園でも優等生であり、校則もきっちり守っている。"},{"spoiler":false,"text":"年齢の離れた兄がおり、その兄がとある事件に関わったとして指名手配中で、現在、姿をくらましている。そんな兄の無実を彼女は信じている。"}],"source":"egs","sourceCharacterId":"27167","sourceWorkId":"3209","spoiler":false},{"segments":[{"spoiler":false,"text":"新人ウェイトレス。友人のなつきに誘われて、バイトを始める。"},{"spoiler":false,"text":"大人しく奥手で、クラスの男子生徒ともなかなか話せない。というか男の子と話すこと＝不良という変な図式が頭の中で成立している。ついこの間まで、男の子とカラオケに行ったりすることを不純異性交遊だと思っていた。律儀な性格で、校則などは律儀に守るタイプ。歳の離れた兄がいるが、3年ほど前から消息を絶っている。とある事件に関わったとして指名手配中だが、春菜は兄の無実を信じている。"}],"source":"bangumi","sourceCharacterId":"147460"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"27167","sourceWorkId":"3209","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"27167","sourceWorkId":"3209","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"27167","sourceWorkId":"3209","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"27167","sourceWorkId":"3209","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"27167","sourceWorkId":"3209","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d36f35d558bf91e797cfc5258540acacaf9494cbd6e651157ebf4bd05b92490d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35638c8cdf96e0720fddb36d35e23