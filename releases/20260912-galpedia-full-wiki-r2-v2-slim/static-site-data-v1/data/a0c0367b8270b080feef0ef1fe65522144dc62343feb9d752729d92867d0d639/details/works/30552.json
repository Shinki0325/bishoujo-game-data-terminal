":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79a528348e5c30afe5637d7a03a75f27d85df3154727357f1a8469e99052f305.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/889c6c14f5489cbb8e4791610479b995172cfcfed9b5f570197d99902f1c54b9.webp","width":182,"height":256,"source":"static-detail"},"actors":[{"creditedName":"土岐 隼一","creatorId":"vndb:s12701","sourcePersonId":"vndb:s12701","canonicalEntityId":"vndb:s12701","name":"土岐隼一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:86348","source":"vndb"}]},{"characterId":"char_vndb_c96679","characterName":"徳川 吉宗","sourceIds":{"vndbCharacterId":"c96679"},"originalCharacterName":"徳川 吉宗","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The eighth shogun of the Tokugawa family who rules over the Edo shogunate. He reformed the financial in the Edo shogunate when they were struggling and fixed the strain and inconsistency of the shogunate system that was spread within the civilian government. He is also the one who established “Kiko” to fight Yoika. An understanding and sharp man."}],"source":"vndb","sourceCharacterId":"c96679"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6567aa31ec514a0359b7408b9faaa6420181ebeb8e222aa021ddac4ae79fcb4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d989ebd31ef2050ba14036712153a2122485370f8f718905ae522a8bc63142d5.webp","width":207,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三宅 健太","creatorId":"vndb:s2119","sourcePersonId":"vndb:s2119","canonicalEntityId":"vndb:s2119","name":"三宅 健太","roleCode":"voice-actor","roleLabel":"