538","canonicalEntityId":"vndb:s13538","name":"駒田航","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:86349","source":"vndb"}]},{"characterId":"char_vndb_c96673","characterName":"宮地 三茂","sourceIds":{"vndbCharacterId":"c96673"},"originalCharacterName":"宮地 三茂","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the chiefs who supervise the Kiko in the back side of Oniwaban along with Kyoushirou. A colleague of Kyoushirou and Kiyohito who acts as the mediator between Yoichi and Genjuurou, who has jurisdiction over Zyouka. Due to his gentle nature, he sometimes can be indecisive but is compassionate and cares about his colleagues."}],"source":"vndb","sourceCharacterId":"c96673"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83819a4aecda9f7f9be6702f209d81b4dc688df161d007deb0680e676f475b15.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8940b7ed418722433c06b664fe0459506c943cf8dafafc9197b919125aeb24c.webp","width":163,"height":256,"source":"static-detail"},"actors":[{"creditedName":"日野 聡","creatorId":"vndb:s82","sourcePersonId":"vndb:s82","canonicalEntityId":"vndb:s82","name":"日野 聡","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:86339","source":"vndb"}]},{"characterId":"char_vndb_c96674","characterName":"川村京士郎","sourceIds":{"vndbCharacterId":"c96674"},"originalCharacterName":"川村京士郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Kiko who supervises the entire Oniwaban, and mentors Kiko who just awakens their power. Acting as the mediator between Tomonari and Kunitaka, who have jurisdiction over Buke, he is a man of few words and seems hard to approach. His partner is a hawk that was given to him by Yoshimune."}],"source":"vndb","sourceCharacterId":"c96674"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00c88e51e6fa401eac8f7fa7ae0a12e212c19c58ddef57ed4fb22f22f959dc15.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c254269cfe875d9a461f136f89ecd21fae3ee28c8d188d2f42a01fdd811e5993.webp","width":195,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽多野 渉","creatorId":"vndb:s60","sourcePersonId":"vndb:s60","canonicalEntityId":"vndb:s60","name":"春野風","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:86337","source":"vndb"}]},{"characterId":"char_vndb_c96675","characterName":"三春","sourceIds":{"vndbCharacterId":"c96675"},"originalCharacterName":"三春","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A teahouse poster girl living in Edo. She is actually a Shape Person that the protagonist created from kimono sash back during childhood. A gutsy person who treats the protagonist like her real sister, and unintentionally meddles in her affair despite knowing that it will do her no good."}],"source":"vndb","sourceCharacterId":"c96675"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91ab2adfc4e81750a2e3ffb40b557764953108d76df128b6cafa1d6e0f5dc078.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/