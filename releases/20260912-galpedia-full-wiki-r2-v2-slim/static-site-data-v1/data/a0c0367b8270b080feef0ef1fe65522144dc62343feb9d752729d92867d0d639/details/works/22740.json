/f5/f5d2688a178c7d228cc435e899a9e82385e42591df749dfc8e7bb82b20e47f63.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/9961f35836071a2c39bc0a974ef268fb99f5a1aaf0d32e59ddff1cc27270135b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉田 聖子","creatorId":"vndb:s1323","sourcePersonId":"vndb:s1323","canonicalEntityId":"vndb:s1323","name":"吉田 聖子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54470","source":"vndb"}]},{"characterId":"char_vndb_c48561","characterName":"ブレインキャット","sourceIds":{"vndbCharacterId":"c48561"},"originalCharacterName":"ブレインキャット","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ripper's small cat doll. While its name is never explicitly mentioned, it's actually a character from a world-famous cartoon series."}],"source":"vndb","sourceCharacterId":"c48561"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/beed3f261a4cc763b3bedefa1441fa06a715ffb25b3770ff247f67eb924346a0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc7b4c705f0751b3518b7a36b2934c2b141b486a9dfe699a32d2372b553d5c68.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"矢作 紗友里","creatorId":"vndb:s670","sourcePersonId":"vndb:s670","canonicalEntityId":"vndb:s670","name":"矢作紗友里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54468","source":"vndb"}]},{"characterId":"char_vndb_c48563","characterName":"リッパー","sourceIds":{"vndbCharacterId":"c48563"},"originalCharacterName":"リッパー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"179"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Wanton slaughter, hunting"},{"spoiler":false,"text":"Likes: Fun"},{"spoiler":false,"text":"Dislikes: Boredom"},{"spoiler":false,"text":"The major antagonist of Code: Embryo. An insane sadistic serial killer, he has murdered a large number of people and disposed of them haphazardly and is known for being an SS-ranked criminal. More crazed and psychopathic than one could believe, Ripper is nothing short of twisted and sadistic. Despite possessing a Crystal and being utterly devoid of any positive emotion, Ripper is fully mentally capable, being clearly able to devise cunning strategies to give him an advantage in combat. Ripper only gets any real joy out of his opponents helplessness and scared emotions, and in order to help strike fear and panic into his prey's hearts, he also possesses multiple bombs that are molotov-like in their design as they ignite the area around them."}],"source":"vndb","sourceCharacterId":"c48563"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/378344b73c53b06f7b6ec5dde5c9ee941c52b31e7c692424a3bef0fe3a3982d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/992d692ae2eb5308c7054e1ee4c9ba37860ae2b46f6fcc2853d881d394e995a0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴村 健一","creatorId":"vndb:s90","sourcePersonId":"vndb:s90","canonicalEntityId":"vndb:s90","name":"鈴村 健一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54463","source":"vndb"}]},{"characterId":"char_vndb_c48565","characterName":"瓶割 晃","sourceIds":{"vndbCharacterId":"c48565"},"originalCharacterName":"瓶割 晃","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"921"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"67"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Games, manga"},{"spoiler":false,"text":"Likes: Hanging out with friends"},{"spoiler":false,"text":"Dislikes: Being lectured"},{"spoiler":false,"text":"Touya's friend who is in a different class than him. His parents live abroad and he has been living on his own since the end of junior high. He is rich and good looking, but he is easily flattered and is known for being \"unfortunately handsome\". Despite his good looks and wealth, he is a social pariah due to his personality."},{"spoiler":false,"text":"Generally acting as the comedy relief, Akira has bouts of jealously towards Touya and his ever-growing group of females. Despite this comedic personality and ability to be easily flattered, he has a serious underside, showing no fear to a gang of thugs threatening to assault him. Like Touya, he isn't a fan of violence, but he dislikes being seen as weak."}],"source":"vndb","sourceCharacterId":"c48565"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc3d37a7685035c518250a3fdc09c7a2ae885034da60c9f253ed054d9f9edd42.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdb81c4da7fb18ffe0d4198ae9f2c768fe1dd9369b0e85299fe2f07d909d6cc4.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"細谷 佳正","creatorId":"vndb:s251","sourcePersonId":"vndb:s251","canonicalEntityId":"vndb:s251","name":"細谷 佳正","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54465","source":"vndb"}]},{"characterId":"char_vndb_c48566","characterName":"ゼクス","sourceIds":{"vndbCharacterId":"c48566"},"originalCharacterName":"ゼクス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"606"},"height":{"reviewState":"source-only","source":"vndb","value":"183"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"68"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Debate, philosophy"},{"spoiler":false,"text":"Likes: Truth"},{"spoiler":false,"text":"Dislikes: Futility"},{"spoiler":false,"text":"One of the main antagonists of Code: Embryo and one of the Ten Sages. A Magician with the title of 6 in the Ten Sages, Sechs is a magical genius who was chosen to be a Saint at the mere age of 18. He has a vast amount of skills and his knowledge in the fields of magic are incredible; he is well known for being one of the first to explore magic-induced gravity fields, with not a single person being able to master the field besides him."},{"spoiler":false,"text":"Cold, mysterious, and unreadable. No one can tell what Sechs is thinking, being silent and keeping all he can to himself. He rarely speaks, even to his fellow Sages, and when he does, each word is filled with a passively strong tone that gives off a sense of wisdom and enlightenment. Sechs demonstrates a small amount of cockiness and self-worth, and finds that he is above fighting with some individuals, but doesn't wish to dirty his hands."}],"source":"vndb","sourceCharacterId":"c48566"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/667148ea325ad9b552bdc628d39dab3913fc4ddc877876428e5303936cf759c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0ddacdc73cd6dfaa35ebd742875160e81c31b563e9a21999687e6601e38fec21.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杉田 智和","creatorId":"vndb:s370","sourcePersonId":"vndb:s370","canonicalEntityId":"vndb:s370","name":"杉田 智和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54466","source":"vndb"}]},{"characterId":"char_vndb_c54371","characterName":"鵜丸 総一朗","sourceIds":{"vndbCharacterId":"c54371"},"originalCharacterName":"鵜丸 総一朗","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"320"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Observing the human condition"},{"spoiler":false,"text":"Likes: Cute things"},{"spoiler":false,"text":"Dislikes: Arguing"},{"spoiler":false,"text":"Souichirou is the director of Mitsurugi Agency Shin-Yokohama's seventh laboratory branch, and the one who gives direct orders to both Mei and Es. Eccentric and big-headed, Souichirou's real motives have always remained a mystery to everyone who knows him. After the loss of his parents, he developed a dangerous philosophy about humans and how they work, although few could tell because of his bizarre persona. He often introduces himself with an odd title, usually to do with being the 'patron Saint of children'. He is also a hypocrite of his own beliefs: while he states everything he does is for the sake of humanity, he shows a total lack of empathy for them."},{"spoiler":false,"text":"From Blazblue Wiki"}],"source":"vndb","sourceCharacterId":"c54371"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/835d8f39dda21203854cd0df50eb3a5f1ed94a48bf708d22a08f1ff5f75d4b5c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aad45a3012eb3269c8b1da0139701c0dae0379dcb126ed6774055a2787079344.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井 孝宏","creatorId":"vndb:s50","sourcePersonId":"vndb:s50","canonicalEntityId":"vndb:s50","name":"櫻井 孝宏","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54462","source":"vndb"}]},{"characterId":"char_vndb_c84053","characterName":"篝涼子","sourceIds":{"vndbCharacterId":"c84053"},"originalCharacterName":"篝涼子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the mother of Kagari Touya; she sacrificed her life for his in the Wadatsumi Incident."}],"source":"vndb","sourceCharacterId":"c84053"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1c13691ee4abc9358f6ac288502e6390854355012c449fd06dacfee24585bd6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a9a826b5260c8269df503087ab8125d64386be3227b5b9ad8da0b36105d6035.webp","width":220,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p641","sourceCompanyId":"egs:brand:624","canonicalEntityId":"vndb:p641","name":"ARC SYSTEM WORKS","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:22740:624","source":"egs"},{"companyId":"vndb:p4299","sourceCompanyId":"vndb:p4299","canonicalEntityId":"vndb:p4299","name":"蒹葭汉化组",