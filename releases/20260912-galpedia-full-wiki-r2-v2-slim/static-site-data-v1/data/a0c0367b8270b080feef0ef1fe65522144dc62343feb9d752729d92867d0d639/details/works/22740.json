{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"22740","model":{"presentationWorkId":"vndb:v13059","staff":{"artwork":[{"creditedName":"樋口 このみ","creatorId":"vndb:s11277","sourcePersonId":"vndb:s11277","canonicalEntityId":"vndb:s11277","name":"樋口 このみ","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:101969","source":"vndb"}],"scenario":[{"creditedName":"樋口 このみ","creatorId":"vndb:s11277","sourcePersonId":"vndb:s11277","canonicalEntityId":"vndb:s11277","name":"樋口 このみ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:101967","source":"vndb"},{"creditedName":"高岡 広明","creatorId":"vndb:s23913","sourcePersonId":"vndb:s23913","canonicalEntityId":"vndb:s23913","name":"高岡 広明","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:101971","source":"vndb"},{"creditedName":"増澤 寛晃","creatorId":"vndb:s38365","sourcePersonId":"vndb:s38365","canonicalEntityId":"vndb:s38365","name":"増澤 寛晃","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:101972","source":"vndb"}],"music":[{"creditedName":"菊田 大介","creatorId":"vndb:s1281","sourcePersonId":"vndb:s1281","canonicalEntityId":"vndb:s1281","name":"菊田 大介","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:101962","source":"vndb"},{"creditedName":"きくお","creatorId":"vndb:s10321","sourcePersonId":"vndb:s10321","canonicalEntityId":"vndb:s10321","name":"きくお","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:101966","source":"vndb"}],"other":[{"creditedName":"櫻川めぐ(桜川めぐ)","creatorId":"vndb:s553","sourcePersonId":"egs:creator:14487","canonicalEntityId":"vndb:s553","name":"櫻川めぐ(桜川めぐ)","detail":"OP曲「Be Oneself!」、ED曲「TRUTH」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:160854","source":"egs"},{"creditedName":"桜川 めぐ","creatorId":"vndb:s553","sourcePersonId":"vndb:s553","canonicalEntityId":"vndb:s553","name":"櫻川 めぐ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:101961","source":"vndb"},{"creditedName":"RUCCA","creatorId":"vndb:s4302","sourcePersonId":"vndb:s4302","canonicalEntityId":"vndb:s4302","name":"溝口 貴紀","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:101963","source":"vndb"},{"creditedName":"株式会社キューン・プラント","creatorId":"vndb:s7417","sourcePersonId":"vndb:s7417","canonicalEntityId":"vndb:s7417","name":"株式会社キューン・プラント(quunplant)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:101964","source":"vndb"},{"creditedName":"森 利道","creatorId":"vndb:s7807","sourcePersonId":"vndb:s7807","canonicalEntityId":"vndb:s7807","name":"森 利道","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:101965","source":"vndb"},{"creditedName":"樋口 このみ","creatorId":"vndb:s11277","sourcePersonId":"vndb:s11277","canonicalEntityId":"vndb:s11277","name":"樋口 このみ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:101968","source":"vndb"},{"creditedName":"樋口 このみ","creatorId":"vndb:s11277","sourcePersonId":"vndb:s11277","canonicalEntityId":"vndb:s11277","name":"樋口 このみ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:101970","source":"vndb"},{"creditedName":"増澤 寛晃","creatorId":"vndb:s38365","sourcePersonId":"vndb:s38365","canonicalEntityId":"vndb:s38365","name":"増澤 寛晃","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:101973","source":"vndb"},{"creditedName":"増澤 寛晃","creatorId":"vndb:s38365","sourcePersonId":"vndb:s38365","canonicalEntityId":"vndb:s38365","name":"増澤 寛晃","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:101974","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c20281","characterName":"えす","sourceIds":{"vndbCharacterId":"c20281"},"originalCharacterName":"えす","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1015"},"height":{"reviewState":"source-only","source":"vndb","value":"149"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Intelligence gathering"},{"spoiler":false,"text":"Likes: Pudding"},{"spoiler":false,"text":"Dislikes: Japanese pears"},{"spoiler":false,"text":"Es is one of the main characters in XBlaze – Code: Embryo and a playable character in the console version of Blazblue: Central Fiction. Es is a member of the Mitsurugi Agency, tasked with hunting down the Drive-Infected Patient's so they could be treated for their unfortunately terminal condition. Emotionless, steady, and objective focused."},{"spoiler":false,"text":"Es is the perfect soldier, her mission always comes first. When she first met Touya Kagari, she did not care for him or any other person, being willing to hurt and even kill others that she was 'friends' with just so she could complete a mission. If Es did not understand a term, mainly because of the informality or colloquial speech, then she would forwardly ask what said term means, leading to unique, and awkward situations. For a time, she possessed no opinions due to her little interaction with people outside of the Agency, as well as this, Es possessed a habit of taking things too literally, annoying Touya as he put up with her awkward social tendencies."},{"spoiler":true,"text":"Es is actually a Manifest Boundary Contact Prime Field Device, and her real name is Embryo Storage (エンブリオストレージ). Her actual age is only 5, and she was developed at the time of her sister units' and creator's death."},{"spoiler":true,"text":"﻿Es wields one of the legendary Legacy Weapons – Vow Crystal Seal Blade: Murakumo. Her skills with the blade are awe-inspiring, being able to deflect multitudes of shrapnel being launched at her by Akio Osafune. On top of this, Es is strong enough to survive a multitude of blows dealt by the physically impressive Drei. Adding to her physical abilities, Es has an abnormally fast reaction time, coupled with impressive speed; she was able to even catch up to Ripper. Even unarmed, she possessed enough strength to easily lift and carry Touya Kagari a considerable distance without fatigue. Because of her blank expressions and apparent lack of emotions, even Ripper's taunting could not provoke her, proving her to be incapable of panicking and losing the psychological advantage."},{"spoiler":false,"text":"Taken from Blazblue Wiki"}],"source":"vndb","sourceCharacterId":"c20281"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49462b523518da43503b4551545593ddf4b8c3a0cca89c89dc7133e85c854552.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed1c6cdba9b02187d57ba49d2b493864e6f505c27a76e8de5b7d501013a8910e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野村 真悠華","creatorId":"vndb:s6867","sourcePersonId":"vndb:s6867","canonicalEntityId":"vndb:s6867","name":"春田花音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54475","source":"vndb"}]},{"characterId":"char_vndb_c20282","characterName":"篝 橙八","sourceIds":{"vndbCharacterId":"c20282"},"originalCharacterName":"篝 橙八","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"720"},"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Touya Kagari is the protagonist of XBlaze – Code: Embryo. He is second-year student of class B. He currently resides with the Himezuru family and worked at Maha☆Raja~ Curry Shop as a part-time job until the store mysteriously closed. He has a very curious and gentle personality and goes out of his way to resolve any fights around him, even if it results in personal injury to himself (This, however, may stem from the single memory of his mother telling him to \"Protect\".). He also has a strong sense of obligation, such as the fact that he believes that his mother (and possibly he himself) was at fault for a large incident that occurred which resulted in his only survival, and is therefore responsible for \"repenting\" in some way. He eventually hardens up as time passes, and even opens up Es to an emotional perspective."}],"source":"vndb","sourceCharacterId":"c20282"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb44c160a7dd82592c6c22cd5d72694ba2cdd876683e10d6841dec0498b111ff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/0617483592198dda0a6299d2c389dfa763853733bc4cdd475c63d4e6883cd2c4.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"菊池 幸利","creatorId":"vndb:s156","sourcePersonId":"vndb:s156","canonicalEntityId":"vndb:s156","name":"菊池 幸利","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54464","source":"vndb"}]},{"characterId":"char_vndb_c28594","characterName":"久音＝グラムレッド＝シュトルハイム","sourceIds":{"vndbCharacterId":"c28594"},"originalCharacterName":"久音＝グラムレッド＝シュトルハイム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"921"},"height":{"reviewState":"source-only","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Research, reading, internet, etc."},{"spoiler":false,"text":"Likes: Libraries, curry"},{"spoiler":false,"text":"Dislikes: Shiitake mushrooms"},{"spoiler":false,"text":"Kuon is one of the main characters in XBlaze – Code: Embryo. An apprentice at the Magic Guild of the Magister's City: Ishana, Kuon is a daughter of the infamously powerful Stroheim family, it's believed that because of her potential strength in the magical arts, that she will be the first in line to earn the privilege to become one of the Ten Sages; something that has not been seen in a very long time. After the murder of her father by her brother Sechs, the elders of the Magic Guild instructed her to go to New Yokozaki City to hunt him down and bring him to justice, giving her the Legacy Weapon, Sealed Spear: Izayoi in order to do the deed."},{"spoiler":false,"text":"Kuon is a very hot-headed young woman. She has no tolerance for any form of malfeasance and will often try to become a white knight to those in need, of which often lands her in trouble. As well as this, she has a legendary temper, leading to her moniker; \"Fire Empress Stroheim\"."},{"spoiler":false,"text":"Even though she is somewhat hot-headed, Kuon is a bright young woman with an intelligent head on her shoulders. She has good classical knowledge, easily recognizing a butchered quote from Augustus Caesar, and suggesting that a quote from Caligula would have been better."},{"spoiler":false,"text":"A considerable threat in combat, Kuon's magical prowess is beyond that of the average mage, having developed considerable mastery over the element of fire. On top of her mastery of fire, Kuon can form barriers, and wards. She is also perceptively keen, being able to detect details quicker than other characters in the cast."},{"spoiler":false,"text":"From Blazblue Wiki"}],"source":"vndb","sourceCharacterId":"c28594"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbdc8cffdd73ffe986f937aee7a22af52a3ef63f587ae0e881c0b34bf7bf0be8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e76f9c8cd8e61b7bd33e0d4a0ad05f47a9a38ef772124386e76487c48bb9f49d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近藤 唯","creatorId":"vndb:s669","sourcePersonId":"vndb:s669","canonicalEntityId":"vndb:s669","name":"近藤 唯","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54467","source":"vndb"}]},{"characterId":"char_vndb_c28595","characterName":"天ノ矛坂 冥","sourceIds":{"vndbCharacterId":"c28595"},"originalCharacterName":"天ノ矛坂 冥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"218"},"height":{"reviewState":"source-only","source":"vndb","value":"159"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Bass, paranormal research"},{"spoiler":false,"text":"Likes: Music (all genres), curios"},{"spoiler":false,"text":"Dislikes: Magic Guild, anything mainstream"},{"spoiler":false,"text":"Mei Amanohokosaka is one of the characters in XBlaze – Code: Embryo and a descendant of the Azure Shrine Maiden, protecting the Wadatsumi area for generations to prevent the resurrection of the Black Beast. Her parents were present at the Wadatsumi Mass Vanish Incident, where her mother disappeared and her father had his soul drained but his body was still left intact. Mei has a huge distrust and hate for the Magic Guild after they attempted to bring down the Amanohokosaka family by making them lose money and trust."},{"spoiler":false,"text":"Personality-wise, Mei is hostile to all she meets. She is extremely hostile towards Kuon due to her being from the Magic Guild. However, this usual hostility that is presented to everyone can usually be avoided by presenting excellent manners, and treating Mei as a pampered princess. Yet, despite this hostility, she and Kuon overcome their differences bonding over their tragedies of having lost a parent. The both of them argue constantly, but they remain firm friends despite this. Like many a teenager, Mei frequently blogs, and has been known to use text speech when updating her TOi; on top of this, she is an avid anime watcher, and is critical of what others watch, suggesting that Kuon watches 'B-tier slice-of-life crap'. Underneath her hypercritical attitude, Mei is secretly quite caring of those around her, especially with family - effectively surrendering her freedom to the whims of the Mitsurugi Agency just so her family could live on. When angered, Mei has been known to swear in a colorful manner."},{"spoiler":true,"text":"In her route, she develops the Drive Blood Cain. She later rose to become the leader of the Amanohokosaka Clan."}],"source":"vndb","sourceCharacterId":"c28595"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee5aa921617f8d2b18883d5614d886a8bf824bfeec95e1241113c5965717364f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/443f44db680bdd360b2b4382ae1eab9cc931644fe34cade864e2c39ba28dde7c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水瀬 いのり","creatorId":"vndb:s5082","sourcePersonId":"vndb:s5082","canonicalEntityId":"vndb:s5082","name":"水瀬 いのり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54472","source":"vndb"}]},{"characterId":"char_vndb_c28596","characterName":"姫鶴 ひなた","sourceIds":{"vndbCharacterId":"c28596"},"originalCharacterName":"姫鶴 ひなた","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"508"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Handicrafts, cooking"},{"spoiler":false,"text":"Likes: Sweets (Especially cream puffs)"},{"spoiler":false,"text":"Dislikes: Violence, ghosts, thunder"}],"source":"vndb","sourceCharacterId":"c28596"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6f6f9fd7b932efb7fe1f34c79fcead2da55798ee9d266900e1cb19609edce09.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33623d75ab9c9cf353df2492374f5ca5088eab539f4f189ef47c46b1f9e99697.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"持月 玲依","creatorId":"vndb:s5886","sourcePersonId":"vndb:s5886","canonicalEntityId":"vndb:s5886","name":"持月 玲依","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54473","source":"vndb"}]},{"characterId":"char_vndb_c45102","characterName":"エルス＝フォン＝クラーゲン","sourceIds":{"vndbCharacterId":"c45102"},"originalCharacterName":"エルス＝フォン＝クラーゲン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"401"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Hacking, historical dramas"},{"spoiler":false,"text":"Likes: Kuon, Japanese dramas"},{"spoiler":false,"text":"Dislikes: Being separated from Kuon"},{"spoiler":false,"text":"Kuon's long-time friend and a messenger for the Magic Guild. She has a deep infatuation for her, doing anything to be next to her side, and the only person who understands Kuon's feelings and what she is going through."},{"spoiler":false,"text":"Seemingly a paragon of politeness, Elise has won the approval of even Mei, a woman who hates members of the Magic Guild. Her love for Japanese culture extends to her having a longing for travelling all around it. She is praised for her perfect grades, earnest behaviour, and hard work, being a sensible worker with impeccable manners. She does have childish quirks, however, being likely to do immature acts for Kuon's attention, even though she generally has it to begin with."},{"spoiler":false,"text":"From Blazblue Wiki"}],"source":"vndb","sourceCharacterId":"c45102"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d190d4b22a2a1ce4dfb99d40c8f218270dcbbc6f7a914d9b8da618419112bd46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8dedf4de0836680bdb614252753c98a93eb5c5836fc3ef642f81a74d13f7bd6.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山本 希望","creatorId":"vndb:s1455","sourcePersonId":"vndb:s1455","canonicalEntityId":"vndb:s1455","name":"山本 希望","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54471","source":"vndb"}]},{"characterId":"char_vndb_c45103","characterName":"姫鶴 由貴","sourceIds":{"vndbCharacterId":"c45103"},"originalCharacterName":"姫鶴 由貴","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"130"},"height":{"reviewState":"source-only","source":"vndb","value":"164"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14f383b42ed257a51bced5d3be97fe84c73dcbe8675da44f316177e06d1cb82c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37bb768f205bf1e6d05a8c8f9a224687a886d8035ff6e74823ded2b4212289eb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"磯村 知美","creatorId":"vndb:s6477","sourcePersonId":"vndb:s6477","canonicalEntityId":"vndb:s6477","name":"磯村 知美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54474","source":"vndb"}]},{"characterId":"char_vndb_c45104","characterName":"マーセリン=F=マーキュリー","sourceIds":{"vndbCharacterId":"c45104"},"originalCharacterName":"マーセリン=F=マーキュリー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1105"},"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/