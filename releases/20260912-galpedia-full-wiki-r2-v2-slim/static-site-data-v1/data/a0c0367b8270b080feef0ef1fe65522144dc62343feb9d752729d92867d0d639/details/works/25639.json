}],"source":"bangumi","sourceCharacterId":"21789"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"21789","value":"书法"},{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"21789","value":"刨冰(红豆口味)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba18616db0d273c4ac4b6c550fbc27ce31f595ecde4079f9693e52d1f7c41ddb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f1539c1dd0d8cff9c4a7a7c18d24099ca616bd40f8ca848a24d4ad95ced2c09.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"原由実","creatorId":"vndb:s3261","sourcePersonId":"vndb:s3261","canonicalEntityId":"vndb:s3261","name":"原 由実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:221228:21789:5825:1","source":"bangumi"}]},{"characterId":"char_bangumi_32074","characterName":"むらさき","sourceIds":{"bangumi":[{"characterId":"32074","match":"source-roster","subjectId":"108440"},{"characterId":"32074","match":"source-roster","subjectId":"194888"},{"characterId":"32074","match":"source-roster","subjectId":"221228"},{"characterId":"32074","match":"source-roster","subjectId":"223001"},{"characterId":"32074","match":"source-roster","subjectId":"288017"}]},"originalCharacterName":"むらさき","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1026"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"bust":{"reviewState":"source-only","source":"bangumi","value":"105"},"height":{"reviewState":"source-only","source":"bangumi","value":"161"},"hip":{"reviewState":"source-only","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"59