{"reviewState":"source-only","source":"bangumi","value":"a"},"bust":{"reviewState":"source-only","source":"bangumi","value":"90"},"height":{"reviewState":"source-only","source":"bangumi","value":"155"},"hip":{"reviewState":"source-only","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いつも元気いっぱいで、どんなことにも一生懸命。忍の道とは何か、本人なりに一生懸命に考えている。忍としての実力はまだまだだが、偉大な忍を祖父「半蔵」に持っており、潜在能力は抜群。好きな物はじっちゃん（半蔵）の太巻き。趣味は修行。秘伝忍法はガマ。属性は土。長短2本の脇差を振るう戦闘をする二刀流での斬撃が中心の戦闘スタイル。"}],"source":"bangumi","sourceCharacterId":"18546"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"18546","value":"修行"},{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"18546","value":"爷爷的太卷寿司"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cb4624300cd1a71cd50d9a202948147a3515b74ce243e7c173d4eb12f2bd3fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbde01a372743de57550d9363b53d911aae6a50c8f99b00fee6586afd9473523.webp","width":169,"height":256,"source":"static-detail"},"actors":[{"creditedName":"原田ひとみ","creatorId":"vndb:s1116","sourcePersonId":"vndb:s1116","canonicalEntityId":"vndb:s1116","name":"原田 ひとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:221228:18546:5206:1","source":"bangumi"}]},{"characterId":"char_bangumi_18555","characterName":"よみ","sourceIds":{"bangumi":[{"characterId":"18555","match":"source-roster","subjectId":"108440"},{"characterId":"18555","match":"source-roster","subjectId":"15927"},{"characterId":"18555","match":"source-roster","subjectId":"194888"},{"characterId":"18555","match":"source-roster","subjectId":"221228"},{"characterId":"18555","match":"source-roster","subjectId":"223001"},{"characterId":"18555","match":"source-roster","subjectId":"288017"},{"characterId":"18555","match":"source-roster","subjectId":"48002"},{"characterId":"18555","match":"source-roster","subjectId":"92119"}]},"originalCharacterName":"よみ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0210"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"bust":{"reviewState":"source-only","source":"bangumi","value":"95"},"height":{"reviewState":"source-only","source":"bangumi","value":"160"},"hip":{"reviewState":"source-only","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"お嬢様口調で、見た目は穏やかだが内面は憎悪が渦巻く激烈な性格。服装や見た目、喋り方はお嬢様っぽいが、実態は食べるものにも困る日々を送っていたが、本人はそれにめげずに明るく強くたくましく生きている。趣味は裁縫。好きな食べ物はもやし。重火器と大剣による距離を問わないコンビネーション攻撃に加え爆弾を使う。"}],"source":"bangumi","sourceCharacterId":"18555"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"18555","value":"裁缝"},{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"18555","value":"豆芽菜"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c3b57aa84d4eb248a49e278b7e8985015056e771a9f09e00d8cf46edc3fb9ea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36bff7201024e5cbe98060bba88a3f66473892bbe80267b1c54af57ea6e0f654.webp","width":169,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茅野愛衣","creatorId":"vndb:s630","sourcePersonId":"vndb:s630","canonicalEntityId":"vndb:s630","name":"茅野 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:221228:18555:5847:1","source":"bangumi"}]},{"characterId":"char_bangumi_18558","characterName":"はるか","sourceIds":{"bangumi":[{"characterId":"18558","match":"source-roster","subjectId":"108440"},{"characterId":"18558","match":"source-roster","subjectId":"15927"},{"characterId":"18558","match":"source-roster","subjectId":"194888"},{"characterId":"18558","match":"source-roster","subjectId":"221228"},{"characterId":"18558","match":"source-roster","subjectId":"223001"},{"characterId":"18558","match":"source-roster","subjectId":"48002"},{"characterId":"18558","match":"source-roster","subjectId":"92119"}]},"originalCharacterName":"はるか","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0720"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"bust":{"reviewState":"source-only","source":"bangumi","value":"99"},"height":{"reviewState":"source-only","source":"bangumi","value":"169"},"hip":{"reviewState":"source-only","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"弱い者いじめが大好きなサドっ気の強い女王様系。しかし脱がされると喜んでいるところを見るとマゾの気もあるらしい。トロい雲雀に目をつけている。 一見弱いものをいじめるのが大好物なサドっ気の強い女王様キャラであるが、本当は仲間のことを大切に思う気持ちが蛇女選抜メンバーの中でも誰よりも強く、常にみんなのことを気にかけている。実際、下僕と雲雀のことさえも彼女なりに気に掛けていいた。また、感情豊かな後輩と接するうちに、母性が大きく育つ。そのため、悪の道の中でも仲間の4人が不幸にならないように広い視点で見守っている。"}],"source":"bangumi","sourceCharacterId":"18558"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"18558","value":"做人偶"},{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"18558","value":"零嘴昆布"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/011ba163a24836effa846668ecbcb85672c7fb3709fe8db2584d4525f1fca178.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d2b09073ef72c23889