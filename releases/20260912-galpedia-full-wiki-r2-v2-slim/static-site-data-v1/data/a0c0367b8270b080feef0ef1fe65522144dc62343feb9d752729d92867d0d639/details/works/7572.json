bc7e61aa42a50f19adeb16ab24afc73f8bb52063b043354e765f86947a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4c3bb019c4325e2ee7a16ebc5d658f889988bf89a2eb1ed851fc2447101630e.webp","width":168,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c4946","characterName":"初姫","sourceIds":{"vndbCharacterId":"c4946"},"originalCharacterName":"初姫","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The princess of the Mochizuki clan. A bit tomboyish and prone to sneaking out of the castle at night, she frustrates her guardians. She gets caught up in a clan-succession conspiracy, one that seemingly proves fatal to her, and seems to reach out to Sayori through the mysterious green pendant that Sayori finds at the very beginning of the story."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4946"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f96dc664a821aeb12596596ad65d5c422b5c0a4b2cf638b11db16d6d8dfb109.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a32823fe63f390ae2226f58201cf92d7715891f5b6d993fc17e6a0ca34896911.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黒河 奈美","creatorId":"vndb:s1062","sourcePersonId":"vndb:s1062","canonicalEntityId":"vndb:s1062","name":"本山美奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:468","source":"vndb"}]},{"characterId":"char_vndb_c4947","characterName":"筑波 宗重","sourceIds":{"vndbCharacterId":"c4947"},"originalCharacterName":"筑波 宗重","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hatsuhime's servant, and loyal samurai and clan vassal. He has a penchant for making terrible jokes and bad impressions, which he sometimes uses to try to cheer Hatsuhime/Sayori up. Unfortunately, his impressions can get himself into trouble, as well."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4947"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d88a6a783b300bf08b252d00e621bc5d9990a755eeeb52dead45b7b9ea8a3ffd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd282e8dfeca6f185381860ecd49e204a6b4573ddb505386c30f88b7e511551c.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小杉 十郎太","creatorId":"vndb:s743","sourcePersonId":"vndb:s743","canonicalEntityId":"vndb:s743","name":"小杉 十郎太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:465","source":"vndb"}]},{"characterId":"char_vndb_c4948","characterName":"不知火 用三郎","sourceIds":{"vndbCharacterId":"c4948"},"originalCharacterName":"不知火 用三郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Usually just called Yo. He is one of the bodyguards hired to save Hatsuhime, and is the youngest of the group. He resents being treated like a child, and is from a ninja family."},{"spoiler":false,"text":"Although he looks quite young at first glance, he has a very sharp tongue."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4948"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/7169c04fc3172076a67cb57a7ec6c13825513ec574496dbda3ccc476a373ca2f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23f0adf8505c18834433b8137c7be8954d1b02c29f4c21a2e6b7bd6dc990e1e1.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森田 成一","creatorId":"vndb:s176","sourcePersonId":"vndb:s176","canonicalEntityId":"vndb:s176","name":"森田 成一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:463","source":"vndb"}]},{"characterId":"char_vndb_c4949","characterName":"村雨 心ノ介","sourceIds":{"vndbCharacterId":"c4949"},"originalCharacterName":"村雨 心ノ介","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Though Jin has neither education nor wealth, he still pursues his dream of becoming a genuine samurai."},{"spoiler":false,"text":"He's a hot-headed man who works as a bodyguard in order to polish his fighting skills. Although he tends to fall in love easily, he's not very good with women."}],"source":"vndb","sourceCharacterId":"c4949"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9eb4b00ab4c8a3fe367db0bd38a72c7db1da029ac661a1ddc625978961ea808.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e51c155c99a09c8971f046b296d3b763b7a5bf1a04b1c85975b048e7fe6f3bb6.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋 広樹","creatorId":"vndb:s67","sourcePersonId":"vndb:s67","canonicalEntityId":"vndb:s67","name":"高橋 広樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:462","source":"vndb"}]},{"characterId":"char_vndb_c4956","characterName":"椿木 泰之丞","sourceIds":{"vndbCharacterId":"c4956"},"originalCharacterName":"椿木 泰之丞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tainojou's nickname is \"Bo\", which comes from an alternate way to read \"Tsubaki\". He says it annoys him a bit, but everybody continues to call him Bo, even Sayori. He is rather androgynous and comes from a samurai family."},{"spoiler":false,"text":"He likes to dress elegant and to act the part of a knight (cape included). He complains about being a \"chick magnet\" and is very interested in the paranormal."}],"source":"vndb","sourceCharacterId":"c4956"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/839f36adb6aab232ebb4fa397182e1c83f5af9f475327eea607ff4718f98621f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/000dbf71d8d20242bf497a806fbbac7fabb631d2b16e00dc8d143d9c5540a115.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石川 英郎","creatorId":"vndb:s1533","sourcePersonId":"vndb:s1533","canonicalEntityId":"vndb:s1533","name":"石川英郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:469","source":"vndb"}]},{"characterId":"char_vndb_c4969","characterName":"辰波 一刀斎","sourceIds":{"vndbCharacterId":"c4969"},"originalCharacterName":"辰波 一刀斎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ittousai's an old acquaintance of Yo, Jin and Bo and their rival. He's also hired as a bodyguard but is seen by the others as nothing but an assassin or a sociopath."},{"spoiler":false,"text":"He's a ruthless mercenary whose life work and joy is killing, and has a body covered with scars from old sword wounds."}],"source":"vndb","sourceCharacterId":"c4969"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a025ff4add7cd4c341fda61c5a9b0c03033b8b399578bea4873e05442de1acb1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1294ef7df3c27d7fcfcac0fedf688a36a2475c36f4150e161599c6e3075814a.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"荻原 秀樹","creatorId":"vndb:s749","sourcePersonId":"vndb:s749","canonicalEntityId":"vndb:s749","name":"荻原 秀樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:466","source":"vndb"}]},{"characterId":"char_vndb_c4970","characterName":"門倉 紋山","sourceIds":{"vndbCharacterId":"c4970"},"originalCharacterName":"門倉 紋山","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Buddhist priest, who seems to like the company of women. He is very strong and knows many things and even has medical knowledge to the extent that he can stitch a wound back together perfectly. He gives himself the nickname \"Mon-Mon\", and tries to sound cute. This usually means he isn't taken seriously."},{"spoiler":false,"text":"He says Yo is like his little brother and treats him that way."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4970"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a2cb8dfb24d18f7c7