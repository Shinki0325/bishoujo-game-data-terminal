ments":[{"spoiler":false,"text":"主人公より1学年上のチアリーディング部キャプテン。"},{"spoiler":false,"text":"細やかな気遣いができ面倒見が良いものの、あまりリーダーシップを発揮せずに周りの意見に流されているので、副キャプテンである蒔帆にいつも叱られている。"},{"spoiler":false,"text":"とても真面目な性格で普段はおとなしいが、時折、他の部員が背筋を凍らせる威圧感を放つ。"},{"spoiler":false,"text":"趣味はコスプレで、自分の部屋に様々な衣装を持っている。"},{"spoiler":false,"text":"夢は自分でウェディングドレスを縫うこと。そのために、暇な時はレースを編んでいる。"},{"spoiler":false,"text":"パイズリ特訓は最初こそとまどっていたものの、主人公に悦んでもらってまんざらでもない様子。"},{"spoiler":false,"text":"「あらあら、 みんなギブアップみたいですね～？　うふふ」"}],"source":"bangumi","sourceCharacterId":"45645"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"21829","sourceWorkId":"14044","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"21829","sourceWorkId":"14044","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"21829","sourceWorkId":"14044","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"21829","sourceWorkId":"14044","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"57 kg","valueContext":null,"source":"egs","sourceCharacterId":"21829","sourceWorkId":"14044","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"hip":[{"comparisonValue":"89","source":"vndb","sourceCharacterId":"c24158","value":"89"},{"comparisonValue":"90","scope":"sourceWork","source":"egs","sourceCharacterId":"21829","sourceWorkId":"14044","value":"90"},{"comparisonValue":"90","source":"bangumi","sourceCharacterId":"45645","value":"90"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc10434e4fd899e3121c4abe12efd0e5c195a97b3243d3ba252e9e019bea27ac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c1ca693dbb7dc6fd7ddc19b72a8615f8c4d6ee74a8af7898867c5f9f0edbad7.webp","width":130,"height":