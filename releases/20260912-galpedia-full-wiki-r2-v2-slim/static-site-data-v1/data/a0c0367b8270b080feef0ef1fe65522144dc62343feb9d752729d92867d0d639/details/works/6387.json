4","sourceWorkId":"6387","spoiler":false},{"segments":[{"spoiler":false,"text":"遼のクラスの担任の女教師。"},{"spoiler":false,"text":"明るく気さくで、精神年齢は若い。スタイルも抜群。"},{"spoiler":false,"text":"悩みのある学生たちにも親身になって相談に乗ることから、学生たちの間での人気は高い。"},{"spoiler":false,"text":"紗月たちの行動に不信感を抱き、彼女たちと対立すると同時にその調査を進めている。"},{"spoiler":false,"text":"また、クラスから少し浮いている遼のことを気遣い彼にアプローチしてくる。"}],"source":"bangumi","sourceCharacterId":"93717"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/187b98272739b075de29ffb5d46236e0d724777761e349d285bbe8f0b693ac1f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50396bf44605b27bf72dc9d1d32ef4ab1c29c7c6643561b5118e62f31bcbe761.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:264228:93717:4940:1","source":"bangumi"}]},{"characterId":"char_c37535","characterName":"神崎 慶子","sourceIds":{"bangumi":[{"characterId":"93718","match":"exact-normalized-name-in-linked-work","subjectId":"264228"}],"egsCharacterIds":["26205"],"vndbCharacterId":"c37535"},"originalCharacterName":"神崎 慶子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mother of Asuka who serves as the parent-teacher association president."},{"spoiler":false,"text":"Kanzaki Asuka's mother. She serves as the President of the Tatsuryou Accademy Parent-Teacher Association."},{"spoiler":false,"text":"She is a friendly woman, but like Asuka, she has a strong sense of justice and responsibility."},{"spoiler":false,"text":"She is proud of his daughter and 