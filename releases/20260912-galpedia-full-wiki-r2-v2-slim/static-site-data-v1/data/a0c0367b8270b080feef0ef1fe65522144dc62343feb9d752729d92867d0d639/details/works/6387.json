7","name":"sevenG","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49341","source":"vndb"},{"creditedName":"輝政","creatorId":"vndb:s14905","sourcePersonId":"vndb:s14905","canonicalEntityId":"vndb:s14905","name":"佐藤 輝政","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49342","source":"vndb"}]},"cast":[{"characterId":"char_c37530","characterName":"神崎 明日香","sourceIds":{"bangumi":[{"characterId":"93714","match":"exact-normalized-name-in-linked-work","subjectId":"264228"}],"egsCharacterIds":["26201"],"vndbCharacterId":"c37530"},"originalCharacterName":"神崎 明日香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The student council president who enjoys overwhelming support from across the school"},{"spoiler":false,"text":"A third-year female student at Tatsuryou Academy."},{"spoiler":false,"text":"She serves as the president of the student council and is highly regarded by other students."},{"spoiler":false,"text":"Her grades are among the best, not only in her school but in the whole country. Although she plays a serious honor student with a strong sense of justice, she also has a rather playful side."},{"spoiler":false,"text":"Although she is at odds with Ryo's older sister, Satsuki, she highly values ​​Ryo's talent and attempts to recruit him as secretary of the student council."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c37530"},{"segments":[{"spoiler":false,"text":"辰陵学園に通う３年生の女子学生。"},{"spoiler":false,"text":"学生自治会の会長を務めており、学生たちからの信頼も厚い。"},{"spoiler":false,"text":"成績は学内のみならず、全国でもトップクラス。"},{"spoiler":false,"text":"正義感が強く真面目な優等生を演じているが、割とお茶目な一面も持ち合わせている。"},{"spoiler":false,"text":"遼の姉、紗月とは対立関係にあるが、遼の才覚については高く評価しており、彼を学生自治会の書記として招き入れようとしている。"}],"source":"egs","sourceCharacterId":"26201","sourceWorkId":"6387","spoiler":false},{"segments":[{"spoiler":false,"text":"辰陵学園に通う３年生の女子学生。学生自治会の会長を務めており、学生たちからの信頼も厚い。"},{"spoiler":false,"text":"成績は学内のみならず、全国でもトップクラス。正義感が強く生真面目、潔癖症。"},{"spoiler":false,"text":"この学園に古くから伝わるしきたりやオカルトめいた事象を蔑視しており、そのため主人公の姉、紗月とも対立関係にある。"},{"spoiler":false,"text":"明日香ははその立場上、遼に対しても否定的であるべきなのだが、彼の才覚については高く評価しており、遼を学生自治会の書記として招き入れようとしている。"}],"source":"bangumi","sourceCharacterId":"93714"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc7eb41ac4a2bb0d6a307b9c4bd5968f2e3f5ce2b2fb2918034cd271695e023e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68be2e6ed351a70d1e4777a19a5346e27f47e11714521735f4106d6ad5d660bd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:264228:93714:4832:1","source":"bangumi"}]},{"characterId":"char_c37531","characterName":"高宮 紗月","sourceIds":{"bangumi":[{"characterId":"93715","match":"exact-normalized-name-in-linked-work","subjectId":"264228"}],"egsCharacterIds":["26202"],"vndbCharacterId":"c37531"},"originalCharacterName":"高宮 紗月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's mysterious older sister who controls the dark side of the school."},{"spoiler":false,"text":"A third-year female student at Tatsuryou Academy. She is Ryo's older sister, and like Ryo, she is a descendant of the school's founder. She is a brilliant, sociable, and talented girl."},{"spoiler":false,"text":"However, she has a mysterious charisma that never ceases to attract people, and due to her lineage she is famous not only within the school but also outside of it. She is a central figure in the \"behind the scenes\" of the school, that centers around the old school building."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c37531"},{"segments":[{"spoiler":false,"text":"辰陵学園に通う３年生の女子学生。"},{"spoiler":false,"text":"遼のひとつ年上の姉で、遼と同じく学園の創始者の血を受け継いでいる。"},{"spoiler":false,"text":"頭脳明晰で人当たりが良い才女。"},{"spoiler":false,"text":"人を惹きつけてやまない不思議なカリスマ性を持っており、またその血筋のせいもあって学園内のみならず学園外でも有名人である。"},{"spoiler":false,"text":"旧校舎を中心とした「学園の裏側」の中心人物。"}],"source":"egs","sourceCharacterId":"26202","sourceWorkId":"6387","spoiler":false},{"segments":[{"spoiler":false,"text":"辰陵学園に通う３年生の女子学生。遼のひとつ年上の姉。"},{"spoiler":false,"text":"頭脳明晰で人当たりが良い才女。"},{"spoiler":false,"text":"私用で授業を抜けることも多いのだが、学園でもトップクラスの成績を誇る。"},{"spoiler":false,"text":"人を惹きつけてやまない不思議なカリスマ性を持っており、またその血筋のせいもあって学園内のみならず学園外でも有名人である。"},{"spoiler":false,"text":"旧校舎を中心とした「学園の裏側」の中心人物。"}],"source":"bangumi","sourceCharacterId":"93715"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd9396df9ee7709caa15380872706e8121ca2ce5c3b3f755187fe27213b327eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c9943a190c49ee5f2fc6f50fe708b695d219d386ed2ea7766aa031333e7e6450.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:264228:93715:6409:1","source":"bangumi"}]},{"characterId":"char_c37532","characterName":"森野 みなと","sourceIds":{"bangumi":[{"characterId":"93716","match":"exact-normalized-name-in-linked-wo