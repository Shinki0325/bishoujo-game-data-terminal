eCharacterId":"946","sourceWorkId":"15131","spoiler":false},{"segments":[{"spoiler":false,"text":"変身：神埼麗子（世を忍ぶ仮の姿）"},{"spoiler":false,"text":"職業：支部長(女幹部)【デスブランド】"},{"spoiler":false,"text":"『突怪1』のヒロイン？で、今作もまたヒロイン？"},{"spoiler":false,"text":"デスブランドの幹部の一人で、将志を怪人にした張本人。"},{"spoiler":false,"text":"将志と一緒に魔法少女を倒した事で支部長補佐に昇格していたが今作では『支部長』として地方支部の立て直しを命じられる事になる。"},{"spoiler":false,"text":"やや高飛車で男勝りな性格で、戦闘中は厳しくサド的な面が現れる。"},{"spoiler":false,"text":"だが部下思いの優しい一面もあり、またどんな状況であってもポジティブな考えが出来る素敵な人。"},{"spoiler":false,"text":"戦闘力は中の上程度。鞭を自由自在に操り、若干ではあるが魔法も使える。"},{"spoiler":false,"text":"「お前達、やっておしまい!!」"}],"source":"egs","sourceCharacterId":"946","sourceWorkId":"17694","spoiler":false},{"segments":[{"spoiler":false,"text":"デスブランドの幹部の一人で、将志を怪人にした張本人。"},{"spoiler":false,"text":"戦闘中はやや高飛車でサド的な面が強く出てくるが、本来は部下思いで優しい性格の持ち主。"},{"spoiler":false,"text":"またどんな状況であってもポジティブな考えが出来る素敵な人。"},{"spoiler":false,"text":"「お前達、やっておしまい !!」"}],"source":"bangumi","sourceCharacterId":"49711"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/613e35b77b67f9e1b0af3703dcfbb03502171ac8af5cdcd465431b2885614aec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9cf87a788c73b7a86849bc2cb8f8d94969be7653b22831fdf2c2e2cf83c94b3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥川久美子","creatorId":"vndb:s861","sourcePersonId":"vndb:s861","canonicalEntityId":"vndb:s861","name":"奥川 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217807:49711:22331:1","source":"bangumi"}]},{"characterId":"char_c71508","characterName":"立川 将志","sourceIds":{"bangumi":[{"characterId":"219028","match":"exact-normalized-name-in-linked-work","subjectId":"217807"},{"characterId":"219028","match":"exact-normalized-name-in-linked-work","subjectId":"66299"}],"egsCharacterIds":["950"],"vndbCharacterId":"c71508"},"originalCharacterName":"立川 将志","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本編の主人公。"},{"spoiler":false,"text":"デスブランドで働いている事務員。"},{"spoiler":false,"text":"業務課に属し、書類関係等の非戦闘業務をこなす。"},{"spoiler":false,"text":"大人しく真面目な性格で、一度決めた事は貫き通す芯の強さを持っている。"},{"spoiler":false,"text":"細かい所にも気が利くと評判が良いが、事務員（非戦闘員）のため、組織内での立場は低い。"},{"spoiler":false,"text":"ある日、勝手に怪人にされる。"}],"source":"egs","sourceCharacterId":"950","sourceWorkId":"15131","spoiler":false},{"segments":[{"spoiler":false,"text":"職業：怪人兼事務員【デスブランド】"},{"spoiler":false,"text":"『突怪1』の主人公で、本編でも主人公。"},{"spoiler":false,"text":"デスブランドで働いている事務員で、書類関係等の非戦闘業務を担当していたが、『経費削減(予算がない)&怪人になる素質がある』という理由から、勝手に改造されて事務員兼怪人として働く事になった、可哀想な人。"},{"spoiler":false,"text":"今作では中間管理職的な位置となり、より大変な目に合う。"},{"spoiler":false,"text":"大人しく真面目な性格で、一度決めた事は貫き通す芯の強さを持っており、戦闘を経験した事で男として磨きがかかった。"},{"spoiler":false,"text":"基本的には両腕(と男性器)が触手の『触手怪人ショクシュンガー』ではあるが、怪人になるための素質がずば抜けて高く、どんな怪人に改造されても耐えられる。"},{"spoiler":false,"text":"事務員としての能力は高く、怪人としての能力も高い。"},{"spoiler":false,"text":"怪人として出撃せず、事務員としての仕事を残業もせず定時までに終わり、これ以上余計な肩書きや仕事が増えて欲しくない……というのが最近の願い。"},{"spoiler":false,"text":"「俺は触手怪人ショクシュンガー!　……しかし本当は事務員だ!!」"}],"source":"egs","sourceCharacterId":"950","sourceWorkId":"17694","spoiler":false},{"segments":[{"spoiler":false,"text":"変身：触手怪人ショクシュンガー、その他怪人全般（改造手術の必要アリ）"},{"spoiler":false,"text":"職業：怪人兼事務員【デスブランド所属】"},{"spoiler":false,"text":"『突怪1』の主人公で、本編でも主人公。"},{"spoiler":false,"text":"デスブランドで働いている事務員で、書類関係等の非戦闘業務を担当していたが、"},{"spoiler":false,"text":"『経費削減（予算がない）＆怪人になる素質がある』という理由から、"},{"spoiler":false,"text":"勝手に改造されて事務員兼怪人として働く事になった、可哀想な人。"},{"spoiler":false,"text":"今作では中間管理職的な位置となり、より大変な目に合う。"},{"spoiler":false,"text":"大人しく真面目な性格で、一度決めた事は貫き通す芯の強さを持っており、"},{"spoiler":false,"text":"戦闘を経験した事で男として磨きがかかった。"},{"spoiler":false,"text":"基本的には両腕（と男性器）が触手の『触手怪人ショクシュンガー』ではあるが、"},{"spoiler":false,"text":"怪人になるための素質がずば抜けて高く、どんな怪人に改造されても耐えられる。"},{"spoiler":false,"text":"事務員としての能力は高く、怪人としての能力も高い。"},{"spoiler":false,"text":"怪人として出撃せず、事務員としての仕事を残業もせず定時までに終わり、"},{"spoiler":false,"text":"これ以上余計な肩書きや仕事が増えて欲しくない……というのが最近の願い。"},{"spoiler":false,"text":"「俺は触手怪人ショクシュンガー!　……しかし本当は事務員だ！！」"}],"source":"bangumi","sourceCharacterId":"219028"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a49aee9c4dd006a761774976231c41494f960b79f333ba7a58dec138d94b0152.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/950d881024ce99342abf23f3810dafd2df3b842c62d4c63a2b9441e95724816a.webp","width":192,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p384","sourceCompanyId":"egs:brand:1869","canonicalEntityId":"vndb:p384","name":"HEAT-SOFT","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:15131:1869","source":"egs"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonicalEntityId":"vndb:p384","name":"ヒートソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:156139:v7011","source":"vndb"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonicalEntityId":"vndb:p384","name":"ヒートソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:16466:v7011","source":"vndb"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonicalEntityId":"vndb:p384","name":"ヒートソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:29288:v7011","source":"vndb"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonicalEntityId":"vndb:p384","name":"ヒートソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:65162:v7011","source":"vndb"}],"missingStates":["