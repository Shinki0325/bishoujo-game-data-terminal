17","sourcePersonId":"vndb:s7417","canonicalEntityId":"vndb:s7417","name":"株式会社キューン・プラント(quunplant)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:112267","source":"vndb"},{"creditedName":"たのま すずめ","creatorId":"vndb:s11815","sourcePersonId":"vndb:s11815","canonicalEntityId":"vndb:s11815","name":"たのますずめ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:112270","source":"vndb"},{"creditedName":"ねこねこソフト","creatorId":"vndb:s11959","sourcePersonId":"vndb:s11959","canonicalEntityId":"vndb:s11959","name":"ねこねこソフト","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:112271","source":"vndb"},{"creditedName":"むねこちん","creatorId":"vndb:s15898","sourcePersonId":"vndb:s15898","canonicalEntityId":"vndb:s15898","name":"むねこちん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:112273","source":"vndb"},{"creditedName":"いろは","creatorId":"vndb:s16882","sourcePersonId":"vndb:s16882","canonicalEntityId":"vndb:s16882","name":"いろは","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:112274","source":"vndb"},{"creditedName":"rezi","creatorId":"vndb:s22640","sourcePersonId":"vndb:s22640","canonicalEntityId":"vndb:s22640","name":"rezi","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:112275","source":"vndb"},{"creditedName":"つゑふ","creatorId":"vndb:s23462","sourcePersonId":"vndb:s23462","canonicalEntityId":"vndb:s23462","name":"つゑふ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:112276","source":"vndb"},{"creditedName":"草薙","creatorId":"vndb:s13199","sourcePersonId":"vndb:s13199","canonicalEntityId":"vndb:s13199","name":"株式会社草薙","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:112277","source":"vndb"},{"creditedName":"燗","creatorId":"vndb:s25502","sourcePersonId":"vndb:s25502","canonicalEntityId":"vndb:s25502","name":"燗","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:112278","source":"vndb"},{"creditedName":"越畑 声太","creatorId":"vndb:s30362","sourcePersonId":"vndb:s30362","canonicalEntityId":"vndb:s30362","name":"越畑 声太","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:112279","source":"vndb"}]},"cast":[{"characterId":"char_c56201","characterName":"ナツキ","sourceIds":{"bangumi":[{"characterId":"25217","match":"exact-normalized-name-in-linked-work","subjectId":"167007"}],"egsCharacterIds":["4637"],"vndbCharacterId":"c56201"},"originalCharacterName":"ナツキ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"一年前の事件後、降下部隊ライトバニラに正式入隊。"},{"spoiler":false,"text":"現在は隊長の地位にいる。"}],"source":"egs","sourceCharacterId":"4637","sourceWorkId":"20826","spoiler":false},{"segments":[{"spoiler":false,"text":"ゲーム版の主人公。魔法の国から「種」を取り戻すためにやって来た。ちはやの魔法戦士としての資質を見出し、パートナーに選ぶ。普段は人間の少年の姿をしているが、魔力が不足すると本来の小動物の姿になってしまう。非常にスケベ。"}],"source":"bangumi","sourceCharacterId":"25217"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39e97a25d88244a48a389c6010aa8c86a924d6673f3cf124fd0feee6f7f41e8b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0d12256529c06bf2eda1a17b55dbf1e92807ae4caaa80a0754ea43301030943.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c56202","characterName":"君塚 みさき","sourceIds":{"bangumi":[{"characterId":"60431","match":"exact-normalized-name-in-linked-work","subjectId":"167007"}],"egsCharacterIds":["4636"],"vndbCharacterId":"c56202"},"originalCharacterName":"君塚 みさき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"銘鳳学園の1年生。"},{"spoiler":false,"text":"偶然にもナツキとキスをして魔法戦士になったが、変身の解き方がわからず、ナツキとのセックスで解除するしかない。"},{"spoiler":false,"text":"可愛いものに目がなく、ナツキ動物形態を異常に可愛がる。"},{"spoiler":false,"text":"体型は至って普通で胸もそこそこある。ちはやよりも女性らしい。"},{"spoiler":false,"text":"運動音痴で体育がダメダメ。みさきの変身はそのときの心情を強く反映するため、思い込んだ姿へとコスチュームが変わる。"}],"source":"egs","sourceCharacterId":"4636","sourceWorkId":"20826","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の新ヒロイン。 銘鳳学園の 1年生。"},{"spoiler":false,"text":"偶然にもナツキとキスをして、魔法戦士マーカライト になってしまう。"},{"spoiler":false,"text":"ナツキとエッチをしないと変身を解くことが出来ない。"},{"spoiler":false,"text":"可愛いものに目がなく、ナツキ動物形態を異常に可愛がる。"},{"spoiler":false,"text":"運動音痴で体育が苦手。 感情の波が激しく、妄想癖がありオーバーリアクション。"},{"spoiler":false,"text":"先入観で決めつけてしまうことが多くそそっかしい。 意外とワガママな性格である。"}],"source":"bangumi","sourceCharacterId":"60431"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edc2b5f00d1abb85333bebd440dca0e90b2904630280b93eecb993d4ff003c97.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6cdd8cbc0bcffea17919df0fc7ac0444c79cac20adba49ab4e80bcfeef8b9b3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤さくら","creatorId":"vndb:s947","sourcePersonId":"vndb:s947","canonicalEntityId":"vndb:s947","name":"花澤 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:167007:60431:17075:1","source":"bangumi"}]},{"characterId":"char_c56204","characterName":"柊 ちはや","sourceIds":{"bangumi":[{"characterId":"14646","match":"exact-normalized-name-in-linked-work","subjectId":"167007"}],"egsCharacterIds":["4635"],"vndbCharacterId":"c56204"},"originalCharacterName":"柊 ちはや","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"銘鳳学園の2年生。"},{"spoiler":false,"text":"ナツキとともに一年前を戦い抜いた魔法戦士。"},{"spoiler":false,"text":"買出しの途中、学園にいく途中でベルガモットの樹によく寄る。"},{"spoiler":false,"text":"母親の絵美が魔法に関する病気に犯されて入院中。"},{"spoiler":false,"text":"一年経っても体のほうはあまり成長していない。"}],"source":"egs","sourceCharacterId":"4635","sourceWorkId":"20826","spoiler":false},{"segments":[{"spoiler":false,"text":"故事的女主角，身份复杂，母亲是人类，而父亲却是拥有魔法受人 尊敬和爱戴的强大战士贝尔加莫特。"},{"spoiler":false,"text":"偶然的机会成为魔法战士卡麦茵，帮助那津树寻找丢失的种子。由于身份的特殊被敌人芬涅尔利用，移植种子后变得充满破坏力，那津树为挽回其生命，拼死相救，最终卡麦茵进化成梦幻级魔法战士——加奈，赢得光明，拯救了世界。"}],"source":"bangumi","sourceCharacterId":"14646"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e5c7727fa1d9eba77e690606ce395aa7f9089645c1246778decc07d0602a338.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f68356df4be15167593cf0627ff9049b6bd30ff06330c3c6594321675fce17a.webp","width":116,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:167007:14646:5900:1","source":"bangumi"}]},{"characterId":"char_c56206","characterName":"ワカハ","sourceIds":{"bangumi":[{"characterId":"60433","match":"exact-normalized-name-in-linked-work","subjectId":"167007"}],"egsCharacterIds":["4638"],"vndbCharacterId":"c56206"},"originalCharacterName":"ワカハ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"降下部隊ライトバニラの見習い。"},{"spoiler":false,"text":"ナツキの妹にあたり、恋人の座を狙うみさきを敵視している。"},{"spoiler":false,"text":"兄にはふさわしくないとみさきを口撃する。"},{"spoiler":false,"text":"ナツキに好意を抱いている。公園に作ったダンボールハウスに住んでいる。"},{"spoiler":false,"text":"ちはやにも対抗心を燃やしてナツキのそばにいようとする。"},{"spoiler":false,"text":"ナツキを思ってオナニーに走ることもある。"}],"source":"egs","sourceCharacterId":"4638","sourceWorkId":"20826","spoiler":false},{"segments":[{"spoiler":false,"text":"降下部隊 ライトバニラ の見習い。"},{"spoiler":false,"text":"ナツキの妹にあたり、恋人の座を狙う（？） みさき を敵視している。"},{"spoiler":false,"text":"ちはやに対抗心を燃やして、いつもナツキのそばに居ようとする。"},{"spoiler":false,"text":"公園に作ったダンボールハウスに住んでいる。"}],"source":"bangumi","sourceCharacterId":"60433"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9cd2c1302ab752d13b422a7cfbc990d262b73d920f9e97c0ed4c35fe4cce46d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d018b540be632c09a8f3df5aef837a842648592b7482bb33afee16399ae72a76.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"設楽麻美","creatorId":"vndb:s869","sourcePersonId":"vndb:s869","canonicalEntityId":"vndb:s869","name":"設楽 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:167007:60433:7904:1","source":"bangumi"}]},{"characterId":"char_c56207","characterName":"クリムゾン","sourceIds":{"bangumi":[{"characterId":"99240","match":"exact-normalized-name-in-linked-work","subjectId":"167007"}],"egsCharacterIds":["4647"],"vndbCharacterId":"c56207"},"originalCharacterName":"クリムゾン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ガランガルによってある力から作り出された生命体。"},{"spoiler":false,"text":"仮面をつけて素顔を隠している。"},{"spoiler":false,"text":"戦闘能力は高いが、魔力をあまり貯蔵できず、回復もしにくい。"},{"spoiler":false,"text":"子供のように好奇心が旺盛で目に付いたものに興味を示す。"},{"spoiler":false,"text":"それに気を取られて本来の目的を忘れることも。"}],"source":"egs","sourceCharacterId":"4647","sourceWorkId":"20826","spoiler":false},{"segments":[{"spoiler":false,"text":"ガランガルによって作り出された、ちはやの遺伝子を組み込まれたホムンクルス。"},{"spoiler":false,"text":"ガランガルの魔力とちはやの力を合わせて最強を目指したが、期待した能力は現れなかった。"},{"spoiler":false,"text":"戦闘力は高いが、魔力をあまり貯蔵できず回復もしにくい。"},{"spoiler":false,"text":"魔力を奪う仕事を与えられ、プリムとペアを組んで行動している。"},{"spoiler":false,"text":"感情は表に出ないが子供のように好奇心が旺盛で、目に付いたものに興味を示す。"},{"spoiler":false,"text":"それに気を取られて本来の目的を忘れることも。"}],"source":"bangumi","sourceCharacterId":"99240"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b10c7154f41246e370200d88e902031750040d1aa270fb2456a09f5d17f0dc1e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/142509c5878d593faa8e79d9dbb71f9cc3f1a3b8e7c53fd3ec939745d9d24eac.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いろは","creatorId":"vndb:s16882","sourcePersonId":"vndb:s16882","canonicalEntityId":"vndb:s16882","name":"いろは","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59984","source":"vndb"}]},{"characterId":"char_c56208","characterName":"プリム","sourceIds":{"bangumi":[{"characterId":"99241","match":"exact-normalized-name-in-linked-work","subjectId":"167007"}],"egsCharacterIds":["4648"],"vndbCharacterId":"c56208"},"originalCharacterName":"プリム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"力を溜めこむことに特化した存在。"},{"spoiler":false,"text":"魔法は軽い肉体操作が使え、"},{"spoiler":false,"text":"触手を行使したり、怪人を使ったりする。"},{"spoiler":false,"text":"触手や直接交わることで人やエヴァーグリーン人から魔力を吸う"}],"source":"egs","sourceCharacterId":"4648","sourceWorkId":"20826","spoiler":false},{"segments":[{"spoiler":false,"text":"クリムゾンの部下であり、魔力集め担当。"},{"spoiler":false,"text":"エッチが大好きで、魔力を溜め込める量が多い。"},{"spoiler":false,"text":"しかし溜めた魔力を自らの力に変換できず、戦闘は弱くてほとんど逃げる。"},{"spoiler":false,"text":"行き倒れていたところをガランガルに拾われ、クリムゾンを姉のように慕っている。"},{"spoiler":false,"text":"元々は愛玩用に作られたホムンクルスで、触手を使役できる。"},{"spoiler":false,"text":"無邪気で元気なムードメーカー。"}],"source":"bangumi","sourceCharacterId":"99241"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/5268fe876b318669727ff540228af4855ea074e650ea7feb4ee6a19eb384d960.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c96df2e84477eb0efba8778c873ed957e591fcc6daeaf375e32e0c545dbdbaa.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c56212","characterName":"小嶋 絵美","sourceIds":{"bangumi":[{"characterId":"25218","match":"exact-normalized-name-in-linked-work","subjectId":"167007"}],"egsCharacterIds":["4640"],"vndbCharacterId":"c56212"},"originalCharacterName":"小嶋 絵美","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"伝説の魔法戦士 スカーレット である 柊絵美 に似せて作られた、ちはやに倒されるための存在。"},{"spoiler":false,"text":"1年前にそれらの記憶を無くして、転校生として戻ってきた。"},{"spoiler":false,"text":"ベルガモットの樹に触れ記憶を多少取り戻し、セプティムになれる。"}],"source":"egs","sourceCharacterId":"4640","sourceWorkId":"20826","spoiler":false},{"segments":[{"spoiler":false,"text":"銘鳳学園の2年生。"},{"spoiler":false,"text":"魔法戦士：セプティム。"},{"spoiler":false,"text":"柊絵美に似せて作られたちはやに倒されるための存在。"},{"spoiler":false,"text":"一年前にそれらの記憶をなくして転校生として戻ってきた。"},{"spoiler":false,"text":"ベルガモットの樹に触れ、記憶を多少取り戻し、セプティムになれる。"},{"spoiler":false,"text":"絶対的にちはやの味方であろうとする。"}],"source":"bangu