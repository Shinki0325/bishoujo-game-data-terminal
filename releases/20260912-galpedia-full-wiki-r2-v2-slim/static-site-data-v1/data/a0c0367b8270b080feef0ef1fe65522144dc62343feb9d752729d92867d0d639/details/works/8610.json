{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"8610","model":{"presentationWorkId":"vndb:v2753","staff":{"artwork":[{"creditedName":"置弓枷","creatorId":"vndb:s3561","sourcePersonId":"egs:creator:3501","canonicalEntityId":"vndb:s3561","name":"置弓枷","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:38172","source":"egs"}],"scenario":[{"creditedName":"天城悠理","creatorId":"vndb:s2413","sourcePersonId":"egs:creator:5090","canonicalEntityId":"vndb:s2413","name":"天城悠理","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:38173","source":"egs"}],"music":[{"creditedName":"浅野彰","creatorId":"vndb:s1696","sourcePersonId":"egs:creator:3736","canonicalEntityId":"vndb:s1696","name":"浅野彰","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:42298","source":"egs"}],"other":[{"creditedName":"天城 悠理","creatorId":"vndb:s2413","sourcePersonId":"vndb:s2413","canonicalEntityId":"vndb:s2413","name":"天城 悠理","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:37555","source":"vndb"},{"creditedName":"置弓 枷","creatorId":"vndb:s3561","sourcePersonId":"vndb:s3561","canonicalEntityId":"vndb:s3561","name":"置弓 枷","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:37556","source":"vndb"}]},"cast":[{"characterId":"char_c6462","characterName":"山田 修二郎","sourceIds":{"bangumi":[{"characterId":"126440","match":"exact-normalized-name-in-linked-work","subjectId":"61404"}],"egsCharacterIds":["26214"],"vndbCharacterId":"c6462"},"originalCharacterName":"山田 修二郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"気のよさそうな、上品な老人。"},{"spoiler":false,"text":"館の執事をしており、"},{"spoiler":false,"text":"テキパキと仕事をこなす姿はまさに職人技。"},{"spoiler":false,"text":"屋敷に迷い込んだ主人公を利用して、お嬢様たちを調教させる張本人。"}],"source":"egs","sourceCharacterId":"26214","sourceWorkId":"6374","spoiler":false},{"segments":[{"spoiler":false,"text":"【愛玩隷嬢】"},{"spoiler":false,"text":"看上去性情温和的高雅老任。货真价实的执事。"},{"spoiler":false,"text":"担任洋馆的执事，干净利落地执行工作的样子完全就是专家级别。"},{"spoiler":false,"text":"【麗佳牝犬調教】"},{"spoiler":false,"text":"洋馆的执事兼负责人。"},{"spoiler":false,"text":"以前是调教过数个DOLL的调教师。"},{"spoiler":false,"text":"他亲自负责的DOLL因为同时具有好色及高贵的气质而受到很高评价。"},{"spoiler":false,"text":"如今从调教师中引退，背负着执事这一头衔管理整个洋馆。"},{"spoiler":false,"text":"和温和的表情相反，面对工作时冷淡且毫不留情。"}],"source":"bangumi","sourceCharacterId":"126440"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3ffda7e6e592041462be638c5aa437d9a1211931c79fd64a7ebf403b73494ec2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5fe3760d4dd737374ed9bc5c5cbb5d4c12f9788a0c113a753b80bd255074b264.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c6463","characterName":"宮内 玲","sourceIds":{"bangumi":[{"characterId":"126439","match":"exact-normalized-name-in-linked-work","subjectId":"61404"}],"egsCharacterIds":["26213"],"vndbCharacterId":"c6463"},"originalCharacterName":"宮内 玲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"舞台となる館でメイドをしている少女。"},{"spoiler":false,"text":"無口で冷たい印象。"},{"spoiler":false,"text":"無口、無愛想、無関心、冷淡、とにかく人間的な雰囲気がしない、冷たい性格のメイド。"},{"spoiler":false,"text":"言われたことだけを忠実に行うが、なぜか主人公の言うことには動こうとしない。"},{"spoiler":false,"text":"しかし、夜になると豹変し、自分から快楽を貪るようにして声を上げ、腰を振り、肉棒をねだる。"},{"spoiler":false,"text":"実は、昔に調教された元お嬢様で、調教を中断した為、心を閉ざし、人を信用しようとしない・・・との情報も・・・"}],"source":"egs","sourceCharacterId":"26213","sourceWorkId":"6374","spoiler":false},{"segments":[{"spoiler":false,"text":"【愛玩隷嬢】"},{"spoiler":false,"text":"在本作的舞台——洋馆担任女仆的少女。"},{"spoiler":false,"text":"寡言、冷淡、无感情、无表情，总之完全感受不到人情味的性格冷酷的女仆。"},{"spoiler":false,"text":"【麗佳牝犬調教】"},{"spoiler":false,"text":"在洋馆工作的女仆。无口无表情的冷淡女仆。"},{"spoiler":false,"text":"忠实地执行被下达地命令，这以外的事情都无动于衷。"},{"spoiler":false,"text":"但是一开始啪啪啪后性格就会突变，娇喘着主动寻求快乐，扭着腰部要求大炮。"},{"spoiler":false,"text":"而对这次的调教师『羽山』则是无比畏惧及厌恶，讨厌和他啪啪啪。天敌般的存在。"}],"source":"bangumi","sourceCharacterId":"126439"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15635bc309e5afe053293ce981d85a0245028daada16bf8e08cd1259db22ad11.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4c23ce8fe96a28d8e7e5f1849801ecdac109e2a74f6b0de7191b6525acaa3c8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"愛野 鈴","creatorId":"vndb:s11779","sourcePersonId":"vndb:s11779","canonicalEntityId":"vndb:s11779","name":"愛野 鈴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20167","source":"vndb"}]},{"characterId":"char_c6464","characterName":"二階堂 麗佳","sourceIds":{"bangumi":[{"characterId":"18544","match":"exact-normalized-name-in-linked-work","subjectId":"61404"}],"egsCharacterIds":["26211"],"vndbCharacterId":"c6464"},"originalCharacterName":"二階堂 麗佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大手ゼネコンの総裁の孫。"},{"spoiler":false,"text":"祖父に甘やかされて育ったワガママ娘。"},{"spoiler":false,"text":"母親はアメリカ人で、父親が駆け落ちして生まれた子供。"},{"spoiler":false,"text":"帰国子女。その両親は事故死し、幼い頃に祖父に引き取られて大事に育てられた。"},{"spoiler":false,"text":"祖父の会社は、バブル崩壊に加え、身内の裏切りに会い、"},{"spoiler":false,"text":"外資に乗っ取られて負債だけを押し付けられて破綻した。"},{"spoiler":false,"text":"その精神的ショックから祖父は倒れ、そして他界。"},{"spoiler":false,"text":"叔父が麗香の後見人となった。"},{"spoiler":false,"text":"身の回りに起こった出来事、唯一の理解者である祖父の死…。周りはすべて敵。"},{"spoiler":false,"text":"敵意を剥き出しにし、誰にも心を許さない状態のまま、館にくることになった。"},{"spoiler":false,"text":"館にきた麗佳は、刺々しく人を信用しない状態だった。"},{"spoiler":false,"text":"皮肉にも、主人公が***する事がキッカケとなり、孤独だった彼女の心を癒す結果となっていく。"}],"source":"egs","sourceCharacterId":"26211","sourceWorkId":"6374","spoiler":false},{"segments":[{"spoiler":false,"text":"【愛玩隷嬢】"},{"spoiler":false,"text":"大手承包商的总裁的孙女。"},{"spoiler":false,"text":"在祖父的娇纵下长大的任性女孩。"},{"spoiler":false,"text":"母亲是美国人，父亲私奔时生下的孩子。"},{"spoiler":false,"text":"归国子女。"},{"spoiler":false,"text":"父母因为事故去世，小时候被祖父领养走，被众星捧月地养大。"},{"spoiler":false,"text":"【麗佳牝犬調教】"},{"spoiler":false,"text":"前作中被光一调教，在拍卖会中中标被富豪领走，但因为「想再见到光一」的理由而好几次企图从宅邸中逃走但失败，最后以再调教的名义被送回洋馆。"},{"spoiler":false,"text":"性格极为任性且蛮横。"},{"spoiler":false,"text":"毫无协调性，不懂得忍耐。"},{"spoiler":false,"text":"但本性只是个爱撒娇的小孩，只是喜欢摆架子和虚张声势而已。"},{"spoiler":false,"text":"同时脾气也很别扭，做事三分钟热度，性情易变等，性格上有着种种问题的大小姐。"},{"spoiler":false,"text":"羽山一说光一的坏话就会激怒并反抗。"},{"spoiler":false,"text":"但是在羽山执拗的调教下慢慢地沉沦于快乐中。"},{"spoiler":false,"text":"【麗佳Final】"},{"spoiler":false,"text":"居住在洋馆式的宅邸·安田邸的大小姐。"},{"spoiler":false,"text":"没有父母，和“爷爷”两人在宅邸里生活。"},{"spoiler":false,"text":"性格高傲，说话毒辣，外表上很任性。"},{"spoiler":false,"text":"但其实很害羞，任性只是害羞的一面的反作用，本性温柔的少女。"},{"spoiler":false,"text":"时不时会变得很胆小，但本人也不明白理由。"},{"spoiler":false,"text":"过去似乎发生过什么……"},{"spoiler":false,"text":"「那从下次起我就叫你凉好了」"}],"source":"bangumi","sourceCharacterId":"18544"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4aeae2f640d4e3af66f7663544c46052779e37d4e4b6b08e07474b6f047e3fa4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d51d591c71f9828086cbb5785c8cc806c059e1182de97e86ce472fe64f423f0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"なかせひな","creatorId":"vndb:s926","sourcePersonId":"vndb:s926","canonicalEntityId":"vndb:s926","name":"なかせ ひな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61399:18544:12719:1","source":"bangumi"}]},{"characterId":"char_vndb_c46071","characterName":"羽山 卓","sourceIds":{"vndbCharacterId":"c46071"},"originalCharacterName":"羽山 卓","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p863","sourceCompanyId":"egs:brand:1465","canonicalEntityId":"vndb:p863","name":"Delta","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:8610:1465","source":"egs"},{"companyId":"vndb:p863","sourceCompanyId":"vndb:p863","canonicalEntityId":"vndb:p863","name":"Delta","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:11971:v2753","source":"vndb"},{"companyId":"vndb:p5004","sourceCompanyId":"vndb:p5004","canonicalEntityId":"vndb:p5004","name":"Drei","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:11972:v2753","source":"vndb"},{"companyId":"vndb:p24847","sourceCompanyId":"vndb:p24847","canonicalEntityId":"vndb:p24847","name":"Violette Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:148483:v2753","source":"vndb"},{"companyId":"vndb:p176","sourceCompanyId":"vndb:p176","canonicalEntityId":"vndb:p176","name":"N43 Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:148491:v2753","source":"vndb"},{"companyId":"vndb:p863","sourceCompanyId":"vndb:p863","canonicalEntityId":"vnd