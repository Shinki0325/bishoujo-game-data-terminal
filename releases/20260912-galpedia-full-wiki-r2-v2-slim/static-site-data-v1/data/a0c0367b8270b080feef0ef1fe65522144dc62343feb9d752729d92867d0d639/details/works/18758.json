ource":"vndb"},{"creditedName":"獏プロダクション","creatorId":"vndb:s4261","sourcePersonId":"vndb:s4261","canonicalEntityId":"vndb:s4261","name":"有限会社獏プロダクション","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:69054","source":"vndb"},{"creditedName":"chiki-co","creatorId":"vndb:s5743","sourcePersonId":"vndb:s5743","canonicalEntityId":"vndb:s5743","name":"chiki-co","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:69055","source":"vndb"},{"creditedName":"桐生 タツヒコ","creatorId":"vndb:s5507","sourcePersonId":"vndb:s5507","canonicalEntityId":"vndb:s5507","name":"桐生 たつひこ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:69056","source":"vndb"},{"creditedName":"徳川 信長","creatorId":"vndb:s13674","sourcePersonId":"vndb:s13674","canonicalEntityId":"vndb:s13674","name":"徳川 信長","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:69057","source":"vndb"},{"creditedName":"sevenG","creatorId":"vndb:s24267","sourcePersonId":"vndb:s24267","canonicalEntityId":"vndb:s24267","name":"sevenG","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:69058","source":"vndb"}]},"cast":[{"characterId":"char_c32029","characterName":"甘原 出雲","sourceIds":{"bangumi":[{"characterId":"38718","match":"exact-normalized-name-in-linked-work","subjectId":"23570"},{"characterId":"38718","match":"exact-normalized-name-in-linked-work","subjectId":"23605"}],"egsCharacterIds":["9953"],"vndbCharacterId":"c32029"},"originalCharacterName":"甘原 出雲","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"サブキャラ。星乃鷲学園第III学部北校3年生。"},{"spoiler":false,"text":"琴子の友達であり、部活仲間であり、演劇部部長でもある。"},{"spoiler":false,"text":"外見がクールで近寄りがたい印象があるが、普段は落ち着いた面倒見のいい女性。"},{"spoiler":false,"text":"だが、意外に子供っぽい一面もあり、かなり悪戯好きで、琴子も晴貴もまれに被害を受けることがある。"},{"spoiler":false,"text":"学園内で唯一琴子と晴貴の恋人関係を知っており、何かと手助けをしてくれる。"}],"source":"egs","sourceCharacterId":"9953","sourceWorkId":"15352","spoiler":false},{"segments":[{"spoiler":false,"text":"星乃鷲学園第III学部北校3年生。"},{"spoiler":false,"text":"朝霧琴子（前作ヒロイン）の友達であり、部活仲間であり、演劇部部長でもある。"},{"spoiler":false,"text":"外見がクールで近寄りがたい印象があるが、普段は落ち着いた面倒見のいい女性。"},{"spoiler":false,"text":"だが、意外に子供っぽい一面もあり、かなり悪戯好きで、琴子も朝霧晴貴（前作主人公）も稀に被害を受けることがある。"},{"spoiler":false,"text":"学園内で唯一琴子と晴貴の恋人関係を知っており、何かと手助けをしてくれる。"}],"source":"egs","sourceCharacterId":"9953","sourceWorkId":"15592","spoiler":false},{"segments":[{"spoiler":false,"text":"-朝霧姉妹編-："},{"spoiler":false,"text":"星乃鷲学園第III学部北校3年生。"},{"spoiler":false,"text":"琴子の友達であり、部活仲間であり、演劇部部長でもある。"},{"spoiler":false,"text":"外見がクールで近寄りがたい印象を感じさせるが、普段は落ち着いた面倒見のいい女性。"},{"spoiler":false,"text":"意外に子供っぽい一面もあり、かなり悪戯好きで、琴子も晴貴もまれに被害を受けることがある。"},{"spoiler":false,"text":"学園内で唯一琴子と晴貴の恋人関係を知っており、なにかと手助けをしてくれる。"},{"spoiler":false,"text":"星乃鷲学園第III学部北校3年生。"},{"spoiler":false,"text":"琴子的朋友和部里的伙伴，演剧部部长。外表给人一种冷酷令人难以接近的印象，但平时是一个温柔的喜欢照顾人的女性。"},{"spoiler":false,"text":"意外地有着孩子般的一面，喜欢恶作剧，琴子和晴貴都经常被捉弄。"},{"spoiler":false,"text":"学园里唯一一个知道琴子和晴貴的恋人关系的人，经常帮助他们。"},{"spoiler":false,"text":"-甘原出雲編-："},{"spoiler":false,"text":"星乃鷲学園 第III学部北校 3年生。 演劇部部長。"},{"spoiler":false,"text":"前作 ヒロイン・琴子の友達であり、部活仲間でもある。"},{"spoiler":false,"text":"外見がクールで近寄りがたい印象はあるが、普段は落ち着いた面倒見のいい女性。"},{"spoiler":false,"text":"だが意外に子供っぽい一面もあり、かなり悪戯好きで、仲の良い友人たちもまれに被害を受けることがある。"},{"spoiler":false,"text":"星乃鷲学园 第III学部北校 3年生。演剧部部长。"},{"spoiler":false,"text":"前作女主人公・琴子的好友，也是社团的队友。"},{"spoiler":false,"text":"给人以外表冰冷而难于接近的印象，不过实际上平时是个稳重体贴的善良女性。"},{"spoiler":false,"text":"但是也有着意外孩子气的一面，相当地喜欢恶作剧，连关系不错地同学也会偶尔成为其恶作剧的目标。"}],"source":"bangumi","sourceCharacterId":"38718"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48045f5ddab6c8f2a71279167c9e82ec9332bdcecbd449dac7127c1b94d14122.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60c1e42738e0ac1f413e1bd444b3a9e9120a3679207ce41db3ce4844c78b1c09.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:23570:38718:6469:1","source":"bangumi"}]},{"characterId":"char_c41526","characterName":"朝霧 琴子","sourceIds":{"bangumi":[{"characterId":"38716","match":"exact-normalized-name-in-linked-work","subjectId":"23570"}],"egsCharacterIds":["10173"],"vndbCharacterId":"c41526"},"originalCharacterName":"朝霧 琴子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Non-blood Related Sister to Haruki"},{"spoiler":false,"text":"Blood-Related Sister to Miyu"}],"source":"vndb","sourceCharacterId":"c41526"},{"segments":[{"spoiler":false,"text":"ヒロイン。星乃鷲学園第III学部北校3年生。旧姓：桐生琴子。"},{"spoiler":false,"text":"彼女が2年の頃に晴貴に出会い、恋をして、1年後自分から告白して念願叶って恋人同士になることが出来た。"},{"spoiler":false,"text":"しかし、その数日後に母親が晴貴の父親と再婚してしまい、姉弟になってしまったことに絶望的な気分になってしまう。"},{"spoiler":false,"text":"ただ、一緒に暮らせることだけは喜んでいる。"},{"spoiler":false,"text":"両親がハネムーンから帰ってくれば、本当の姉弟となってしまい結婚はおろか恋人同士でもいられなくなってしまう為、意を決して晴貴に子作りを提案してくる。"}],"source":"egs","sourceCharacterId":"10173","sourceWorkId":"15352","spoiler":false},{"segments":[{"spoiler":false,"text":"星乃鷲学園第III学部北校3年生。旧姓：桐生琴子（きりゅう ことこ）。"},{"spoiler":false,"text":"彼女が2年の頃に晴貴に出会い、恋をして、1年後自分から告白して念願叶って恋人同士になることが出来た。"},{"spoiler":false,"text":"しかし、その数日後に母親が晴貴の父親と再婚してしまい、姉弟になってしまったことで絶望的な気分になってしまう。"},{"spoiler":false,"text":"ただ、一緒に暮らせることだけは喜んでいる。"},{"spoiler":false,"text":"両親がハネムーンから帰ってくれば、本当の姉弟となってしまい結婚はおろか恋人同士でもいられなくなってしまうため、意を決して晴貴に子作りを提案してくる。"},{"spoiler":false,"text":"星乃鷲学園第III学部北校3年生。旧姓：桐生琴子（きりゅう ことこ）。"},{"spoiler":false,"text":"两年级的时候遇见晴贵，然后陷入爱河，1年后告白，成功地成为了恋人。"},{"spoiler":false,"text":"但是几天后母亲便和晴贵的父亲再婚，成为了姐弟，一度陷入绝望。"},{"spoiler":false,"text":"只是，能够在一起生活还是很高兴。"},{"spoiler":false,"text":"父亲如果蜜月结束返回，成为了真的姐弟后别说结婚连成为恋人都办不到，于是决定向晴贵提出生孩子的决定。"}],"source":"bangumi","sourceCharacterId":"38716"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9479cfe368611214961518175698d520ff0722ed291220c18c00a020ecda152.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/108326cad99a94032451849d3c8027dd08eaa7cdcca976e727cc6ccac14b676c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:23570:38716:6359:1","source":"bangumi"}]},{"characterId":"char_c41527","characterName":"朝霧 深結","sourceIds":{"bangumi":[{"characterId":"38717","match":"exact-normalized-name-in-linked-work","subjectId":"23570"}],"egsCharacterIds":["10174"],"vndbCharacterId":"c41527"},"originalCharacterName":"朝霧 深結","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Non-blood Related Sister to Haruki"},{"spoiler":false,"text":"Blood-Related Sister to Kotoko"}],"source":"vndb","sourceCharacterId":"c41527"},{"segments":[{"spoiler":false,"text":"サブヒロイン。星乃鷲学園第III学部北校1年生。旧姓：桐生深結。"},{"spoiler":false,"text":"琴子の実妹で晴貴の義妹。"},{"spoiler":false,"text":"素っ気なくサディスティックで皮肉屋だが根は甘えたがりで寂しがり屋である。"},{"spoiler":false,"text":"表には出さないが、兄が出来たことを凄く喜んでいる。"},{"spoiler":false,"text":"ただ、最近の姉と晴貴の関係には疑いと不信感を持っている。"}],"source":"egs","sourceCharacterId":"10174","sourceWorkId":"15352","spoiler":false},{"segments":[{"spoiler":false,"text":"星乃鷲学園第III学部北校1年生。旧姓：桐生深結（きりゅう みゆ）。"},{"spoiler":false,"text":"琴子の実妹で晴貴の義妹。素っ気なくサディスティックで皮肉屋だが、根は甘えたがりで寂しがり屋である。"},{"spoiler":false,"text":"表には出さないが、兄ができたことを凄く喜んでいる。"},{"spoiler":false,"text":"ただ、最近の姉と晴貴の関係には疑いと不信感を持っている。"},{"spoiler":false,"text":"星乃鷲学園第III学部北校1年生。旧姓：桐生深結（きりゅう みゆ）。"},{"spoiler":false,"text":"琴子的实妹，晴贵的义妹。"},{"spoiler":false,"text":"虽然是一个腹黑的毒舌S系，但本性是一个喜欢撒娇和容易寂寞的人。"},{"spoiler":false,"text":"虽然不表露出来，但对有了哥哥一事感到很高兴。"},{"spoiler":false,"text":"只是，最近对姐姐和晴贵间的关系抱有疑问和不信任感。"}],"source":"bangumi","sourceCharacterId":"38717"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4f20b0bf8567248ae966e05d9cb67ba69e82c4d6590922cc9980f0ede41de92.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/2695b5c1c5e0579f293da852f2365e87c1e945659c4741388a390e292166d002.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤葵","creatorId":"vndb:s12817","sourcePersonId":"vndb:s12817","canonicalEntityId":"vndb:s12817","name":"浜崎恵梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:23570:38717:21427:1","source":"bangumi"}]},{"characterId":"char_vndb_c41525","characterName":"朝霧 晴貴","sourceIds":{"vndbCharacterId":"c41525"},"originalCharacterName":"朝霧 晴貴","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p171","sourceCompanyId":"egs:brand:413","canonicalEntityId":"vndb:p171","name":"アトリエかぐや","roleCodes":["brand"],"identityStatus":"