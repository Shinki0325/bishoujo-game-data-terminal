ate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yoshijirou Saku is the unlikely protagonist of the series. A recent second-year transfer student, his life takes an unexpected turn when he is blamed for fighting and threatened with expulsion, along with fellow classmate Mirai Aoi. Given the chance to redress his actions, Yoshijirou is assigned to recruit his entire class, a notorious group of disobedient misfits, to perform in a play lest having to leave school permanently with them."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c1831"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/2751f73b41ea7f9e16c1f3a266d7d011cb61cec1d5637c8e0236bb301547e276.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/540aa7b50ee09f73d5acd2c3fc9994dcf57a24268174530472249e6a7daf315b.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:102","sourceCompanyId":"egs:brand:102","canonicalEntityId":"egs:brand:102","name":"CROSS NET","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:3256:102","source":"egs"},{"companyId":"vndb:p83","sourceCompanyId":"vndb:p83","canonicalEntityId":"vndb:p83","name":"クロスネット","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:52881:v189","source":"vndb"},{"companyId":"vndb:p548","sourceCompanyId":"vndb:p548","canonicalEntityId":"vndb:p548","name":"ApRicoT","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:52882:v189","source":"vndb"},{"companyId":"vndb:p83","sourceCompanyId":"vndb:p83","canonicalEntityId":"vndb:p83","name":"クロスネット","roleCodes":["publisher"],"identityStatus":"source-