","relationId":"egs:work-creator:4786","source":"egs"}],"music":[{"creditedName":"Lip on Hip","creatorId":"vndb:s1083","sourcePersonId":"egs:creator:2553","canonicalEntityId":"vndb:s1083","name":"Lip on Hip","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:7571","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c1755","characterName":"卯月 あむ","sourceIds":{"bangumi":[{"characterId":"54265","match":"exact-normalized-name-in-linked-work","subjectId":"16696"}],"egsCharacterIds":["1428"],"vndbCharacterId":"c1755"},"originalCharacterName":"卯月 あむ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"72"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"source-only","source":"vndb","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Amu Uzuki is an adolescent entertainer, actress and celebrity, widely known and recognized across Japan for her acting, affluence, and looks. She visits Kouka Academy in response to the play being arranged and offers to participate in it; taking a fondness for Yoshijirou. In spite of the fame and fortune she commands, her classist family, constant traveling, few friends and nonexistent love life take a toll on her."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c1755"},{"segments":[{"spoiler":false,"text":"【出席番号22 / 芸能人】"},{"spoiler":false,"text":"天才子役の呼び声も高い芸能人。"},{"spoiler":false,"text":"芸能活動を中心に行ってきたが、突然、休養宣言を発表。"},{"spoiler":false,"text":"学園に通い出すがそこでも芸能人という特殊な目で見られがち。"},{"spoiler":false,"text":"常に演じることを余儀なくされているため、誰かに本当の自分を見てほしいと思っている。"},{"spoiler":false,"text":"「みんな、私の事、芸能人としてしか見てないの」"}],"source":"egs","sourceCharacterId":"1428","sourceWorkId":"2898","spoiler":false},{"segments":[{"spoiler":false,"text":"天才子役の呼び声も高い芸能人。"},{"spoiler":false,"text":"芸能活動を中心に行ってきたが、突然、休養宣言を発表。学校に通い出すがそこでも芸能人という特殊な目で見られがち。常に演じることを余儀なくされているため、誰かに本当の自分を見てほしいと思っている。2年B組の演劇発表では、大道具を担当。"},{"spoiler":false,"text":"「みんな、私の事、芸能人としてしか見てないの」"}],"source":"bangumi","sourceCharacterId":"54265"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05cef5310550aae2255e971f95b76a70c1b7a94af7f5754361b83751c1d0da34.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3fccdf4e4c994fa93efcf7ce4fb82d9a51b5bacbbd4c5a3edf996afd8357d267.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三五美奈子","creatorId":"vndb:s2139","sourcePersonId":"vndb:s2139","canonicalEntityId":"vndb:s2139","name":"三五 美奈子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:133379:54265:6103:1","source":"bangumi"}]},{"characterId":"char_c1756","characterName":"鈴原 空","sourceIds":{"bangumi":[{"characterId":"54266","match":"exact-normalized-name-in-linked-work","subjectId":"16696"}],"egsCharacterIds":["1427"],"vndbCharacterId":"c1756"},"originalCharacterName":"鈴原 空","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Distant and reserved, Sora Suzuhara is a second-year student who is also on the swim team. With a preference for solitude and disinterest in others, Sora is antisocial, nihilistic, mysterious, and deadpan. Through her acquaintance with Yoshijirou however, Sora becomes emotional, open and appreciative."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c1756"},{"segments":[{"spoiler":false,"text":"【出席番号28 / 水泳部】"},{"spoiler":false,"text":"虚無的で何事に対しても冷めた雰囲気、他人に合わせようという意思がなく、好んで独りでいることが多い。"},{"spoiler":false,"text":"冷静に現実を見つめる目には、フィクションの類は受け入れられないようで、どこか蔑んでいる様子。"},{"spoiler":false,"text":"「漫画なんて、子供の読むものでしょ。バカバカしい」"}],"source":"egs","sourceCharacterId":"1427","sourceWorkId":"2898","spoiler":false},{"segments":[{"spoiler":false,"text":"水泳部の選手候補。"},{"spoiler":false,"text":"虚無的で何事に対しても冷めた雰囲気、他人に合わせようという意思がなく、好んで独りでいることが多い。冷静に現実を見つめる目には、フィクションの類は受け入れられないようで、どこか蔑んでいる様子。ある事件をきっかけに、密かに主人公に想いを寄せている。2年B組の演劇発表では、役者を担当。"},{"spoiler":false,"text":"「漫画なんて、子供の読むものでしょ。バカバカしい」"}],"source":"bangumi","sourceCharacterId":"54266"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77e4ebe7f0b7cd11319a503d933c11718b9ea65d817051e02cf00b08f3221a1e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfec5273442289ca15abedcc7f998723ab3db94e90a40302d44c3286d67cfe4d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:133379:54266:4432:1","source":"bangumi"}]},{"characterId":"char_c1757","characterName":"キャプテン","sourceIds":{"bangumi":[{"characterId":"54263","match":"exact-normalized-name-in-linked-work","subjectId":"16696"}],"egsCharacterIds":["1425"],"vndbCharacterId":"c1757"},"originalCharacterName":"キャプテン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Loud and headstrong, Mirai Aoi is a second-year student and the most iconic character of the series. Known among her class by the nickname \"Captain\", Mirai is a temperamental, fastidious leader, determined to combat the ridicule and undermining she and her group regularly receive from the rest of the school. An accomplice by association, Mirai is required to assist Yoshijirou in appropriating their class for the play; a task she grows to respect and admire him for."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c1757"},{"segments":[{"spoiler":false,"text":"【出席番号21/ 元演劇部】"},{"spoiler":false,"text":"2年B組の参謀的な役割を務め、「キャプテン」と呼ばれ恐れられる危険な女の子。"},{"spoiler":false,"text":"演劇部に所属していたが、色々とあって退部している。"},{"spoiler":false,"text":"演劇部との演劇勝負に勝利するために、悪知恵と呼ばれる類の才能を駆使して2年B組を扇動する。"},{"spoiler":false,"text":"「バカ！　ほんと、バカ!!　何にも分かってない！」"}],"source":"egs","sourceCharacterId":"1425","sourceWorkId":"2898","spoiler":false},{"segments":[{"spoiler":false,"text":"2年B組の参謀的な役割を務め、「キャプテン」と呼ばれ恐れられる危険な女の子。"},{"spoiler":false,"text":"演劇部に所属していたが、顧問とのいざこざが原因で除名された。演劇部との演劇勝負に勝利するために、悪知恵と呼ばれる類の才能を駆使して2年B組を扇動する。主人公の事が気になるらしく、何かと世話を焼く。2年B組の演劇発表では、脚本を担当している。"},{"spoiler":false,"text":"「バカ！　ほんと、バカ！！　何にも分かってない！」"}],"source":"bangumi","sourceCharacterId":"54263"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b052132e4051abbd43c6da577eb3286c17b0038dab3d04e9632a68bca75d9a01.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d56bf954de79acd89d621b8466357e40530f09a4ff186d5ce164c3320a88c742.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:133379:54263:4675:1","source":"bangumi"}]},{"characterId":"char_c1829","characterName":"咲守 素子","sourceIds":{"bangumi":[{"characterId":"54267","match":"exact-normalized-name-in-linked-work","subjectId":"16696"}],"egsCharacterIds":["1429"],"vndbCharacterId":"c1829"},"originalCharacterName":"咲守 素子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"169"},"hip":{"reviewState":"source-only","source":"vndb","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Direct and quiet, Motoko Sakimori is a second-year student who doubles as the local Shinto shrine maiden. She is recognized for donning her robes in place of a school uniform, serious, tough-love attitude, nage-waza martial arts and purple hair. In a fashion similar to Sora, Motoko opens up around Yoshijirou, showing a less seen, tender side of her; one including an affection for anything cute."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c1829"},{"segments":[{"spoiler":false,"text":"【出席番号25 / 合気道部】"},{"spoiler":false,"text":"神社の娘で、延々と受け継がれている古武術の担い手。"},{"spoiler":false,"text":"心技体を完璧に会得し、毅然とした立居振舞いで、融通が利かない程に真面目。"},{"spoiler":false,"text":"だが実は、可愛いものに目がない一面も。"},{"spoiler":false,"text":"「男子は苦手・・・女の子の方がいい・・・・」"}],"source":"egs","sourceCharacterId":"1429","sourceWorkId":"2898","spoiler":false},{"segments":[{"spoiler":false,"text":"合気道部所属。神社の娘で、延々と受け継がれている古武術の担い手。"},{"spoiler":false,"text":"心技体を完璧に会得し、毅然とした立居振舞いで、融通が利かない程に真面目。実は可愛いものに目がなく、可愛い女の子にも目がない。そのため主人公のことなど眼中になさげ。2年B組の演劇発表では、役者を担当。"},{"spoiler":false,"text":"「男子は苦手・・・女の子の方がいい・・・・」"}],"source":"bangumi","sourceCharacterId":"54267"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e6cdcfeb4bf6a526995493020c881ee8575c07befdd63021652108173afe617.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6b6c594456275e78584b522be1e2eecc5f4bbbcbd8105184cfb89558f33ba2a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"笹島かほる","creatorId":"vndb:s1017","sourcePersonId":"vndb:s1017","canonicalEntityId":"vndb:s1017","name":"笹島 かほる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:133379:54267:3944:1","source":"bangumi"}]},{"characterId":"char_vndb_c10177","characterName":"桜井　まこと","sourceIds":{"vndbCharacterId":"c10177"},"originalCharacterName":"桜井　まこと","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Another strange member of class 2-B."},{"spoiler":false,"text":"Makoto is a member of the school's Athletics club."},{"spoiler":false,"text":"She is always full of energy, and because of that she is a very fast runner. Makoto often behaves foolishly, people even say that she has a loose screw in her head, which is seems to be stuck in another part of her body..."},{"spoiler":false,"text":"Makoto also tends to call people nicknames without permission. Generally, Makoto is 2-B's trouble-maker; she's always busy with annoying and taunting people."}],"source":"vndb","sourceCharacterId":"c10177"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0aa07efed6fdfa7e7e6d9c26a5d1f069af2ef00aab36ebd9ba49c316f834a61.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20320cbbede055e861b6b23872794a9163a5ef0cba14d0a75ac8b0c0fa7b2198.webp","width":140,"height":233,"source":"static-detail"},"actors":[{"creditedName":"福元 コヒロ","creatorId":"vndb:s806","sourcePersonId":"vndb:s806","canonicalEntityId":"vndb:s806","name":"KOHIRO(福元コヒロ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1984","source":"vndb"}]},{"characterId":"char_vndb_c10179","characterName":"高野　聖","sourceIds":{"vndbCharacterId":"c10179"},"originalCharacterName":"高野　聖","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Another strange member of class 2-B."},{"spoiler":false,"text":"Hijiri is a member of the school's Library committee."},{"spoiler":false,"text":"She is weak at communicating with others, or talking to people in general. It seems she does not know how to deal with this, and she thinks she is not liked because of this."}],"source":"vndb","sourceCharacterId":"c10179"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/daba6410e3f34d011e53b1063ac33123984e5c9cdd6b027b76416c1215c9a9dd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1107e76eb5a16f8e3b095a622a20a7dae0fbed3f9