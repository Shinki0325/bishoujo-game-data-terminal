961","spoiler":false},{"segments":[{"spoiler":false,"text":"明るい性格。主人公が泊まりに来ても割と気にしていない。"},{"spoiler":false,"text":"主人公が来てから、少しずつ男として意識するようになる。両親は海外で働いてて、家の管理などは水口の叔父・叔母と相談して行っている。主人公の両親から『嫁捜し』の事は聞いているが、特に意識はしていない。"}],"source":"bangumi","sourceCharacterId":"145396"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fdb529c3c0b5a26f11bab74e0052f0f8568dd46c8da38511842eabc3a7f52eb7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/699cde4fe60cf17eba3e8df94f7a6ab51e13108c6ccafcb50ba42fe6aeb08c29.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友咲 美紅","creatorId":"vndb:s6719","sourcePersonId":"vndb:s6719","canonicalEntityId":"vndb:s6719","name":"友咲 美紅","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:25905","source":"vndb"}]},{"characterId":"char_c79400","characterName":"水口 浩子","sourceIds":{"bangumi":[{"characterId":"145397","match":"exact-normalized-name-in-linked-work","subjectId":"152356"}],"egsCharacterIds":["13491"],"vndbCharacterId":"c79400"},"originalCharacterName":"水口 浩子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美奈子の妹。"},{"spoiler":false,"text":"恥ずかしがり屋の女の子。"},{"spoiler":false,"text":"とある事が切っ掛けになって、"},{"spoiler":false,"text":"ますます主人公を意識する。"}],"source":"egs","sourceCharacterId":"13491","sourceWorkId":"2961","spoiler":false},{"segments":[{"spoiler":false,"text":"恥ずかしがり屋。姉が親戚の男を泊めると言うのを聞いて仰天する。"},{"spoiler":false,"text":"泊めてはダメとも言えず、宿泊を承知する。自分から言いたいことを言えず、周りに流されるタイプ。不平不満があっても、あまり深く考えないようにしている。自分が買った缶ジュースが、おなかいっぱいになって飲みきれなくなったとき、主人公が残りを飲んでくれた。間接キスに浩子は主人公をますます意識してしまう。現在、短大で心理学を勉強中。"}],"source":"bangumi","sourceCharacterId":"145397"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be5216e940abd946f9bb5f5378daf2edf90f9934d19ebb9d8fe744963c0b7e70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bfe3ff5cfa9910dc806e31936170ff9580bd0e08b92ac3d765a4b43a4f57bc6.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c79401","characterName":"水口 ゆうき","sourceIds":{"bangumi":[{"characterId":"145398","match":"exact-normalized-name-in-linked-work","subjectId":"152356"}],"egsCharacterIds":["13492"],"vndbCharacterId":"c79401"},"originalCharacterName":"水口 ゆうき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の伯母。"},{"spoiler":false,"text":"おせっかい焼のOL。"},{"spoiler":false,"text":"自分の抜けている部分をフォローしてくれる主人公を、"},{"spoiler":false,"text":"とっても気に入っている。"}],"source":"egs","sourceCharacterId":"13492","sourceWorkId":"2961","spoiler":false},{"segments":[{"spoiler":false,"text":"編集部に勤めるＯＬ。"},{"spoiler":false,"text":"常に飛び回っていて忙しい。おせっかい焼き。家に帰ると翌日までぐったりとしている。おおざっぱな一面があるので、こまめに気がつく主人公を気に入る。実は数年前の、主人公の初体験の相手。"}],"source":"bangumi","sourceCharacterId":"145398"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3fa96efbe67091c65914ad0c61129d72f8bdfade2190caedcc87d0551469931.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87ee3a46ebfe9967234655831ff2fd3f0740532dfd95537d6525e7646b4c17b6.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c79402","characterName":"中里 今日子","sourceIds":{"bangumi":[{"characterId":"145399","match":"exact-normalized-name-in-linked-work","subjectId":"152356"}],"egsCharacterIds":["13493"],"vndbCharacterId":"c79402"},"originalCharacterName":"中里 今日子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"浩子の友達で、主人公とも顔なじみ。"},{"spoiler":false,"text":"楽しい事とおしゃれに積極的な女の子。"},{"spoiler":false,"text":"目下、主人公をからかうのが一番の楽しみで、家に遊びに来る。"},{"spoiler":false,"text":"でも、主人公に「男らしさ」を感じた瞬間から、"},{"spoiler":false,"text":"主人公への意識はどんどん変わっていく。"}],"source":"egs","sourceCharacterId":"13493","sourceWorkId":"2961","spoiler":false},{"segments":[{"spoiler":false,"text":"川城の分家の娘。遊びまわっていて親の手を焼かせている。"},{"spoiler":false,"text":"浩子と違って積極的な性格。浩子の家に泊まっている主人公に興味深々。積極的なのに、興味を引く男の子に出会ったことがなく、男の子とつきあったことはない。流行に敏感で、髪の毛を染めたり新しい小物・香水などに目が無い。"}],"source":"bangumi","sourceCharacterId":"145399"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c6bc089afd06852b3f2813dc7f9d0c39dc969d3673657a7b203e507a96f7e45.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c9bb6cf08d0025763120d6e38b6cd366ebecbcde3ce7d23fbbb6bede554d8038.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c79403","characterName":"川城 理恵","sourceIds":{"bangumi":[{"characterId":"145400","match":"exact-normalized-name-in-linked-work","subjectId":"152356"}],"egsCharacterIds":["13494"],"vndbCharacterId":"c79403"},"originalCharacterName":"川城 理恵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"浩子の友達で、主人公とも顔なじみ。"},{"spoiler":false,"text":"物静かだが積極的な所がある女の子。"},{"spoiler":false,"text":"主人公が「嫁捜し」で泊まりに来るという情報を美奈子から得て、"},{"spoiler":false,"text":"どんな人間になったのか。少し気になっている。"}],"source":"egs","sourceCharacterId":"13494","sourceWorkId":"2961","spoiler":false},{"segments":[{"spoiler":false,"text":"水口家の本家の娘。通常は狐耳としっぽは隠れている。"},{"spoiler":false,"text":"川城の娘たちがあちこちに嫁いで水口家や中里家ができた。物静かな性格。美奈子の家に遊びに来て主人公に出会う。主人公の両親から『嫁捜し』の事は聞いていて、主人公に少し興味がある。実家は先祖代々の神社の家系。おとなしい面を持つ中、一度好きになると一途な面を持ち、静かながら積極的な行動を取る。"}],"source":"bangumi","sourceCharacterId":"145400"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c79e4f3874d695fce1ba7d76d6765f3eed28c98fb382927960572872c738f82.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb1117ca74999462003f32167812663a2478d21ce899bf63da16f4dadc3c7434.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雪の森 雫","creatorId":"vndb:s6768","sourcePersonId":"vndb:s6768","canonicalEntityId":"vndb:s6768","name":"雪の森 雫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:25906","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:22","sourceCompanyId":"egs:brand:22","canonicalEntityId":"egs:brand:22","name":"ACTRESS","roleCodes":["brand"],"identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-brand:2961:22","source":"egs"},{"companyId":"vndb:p34","sourceCompanyId":"vndb:p34","canonicalEntityId":"vndb:p34","name":"アクトレス","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:152499:v4018","source":"vndb"},{"companyId":"vndb:p2261","sourceCompanyId":"vndb:p2261","canonicalEntityId":"vndb:p2261","name":"美少女☆クオリティ","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:167852:v4018","source":"vndb"},{"companyId":"vndb:p34","sourceCompanyId":"vndb:p34","canonicalEntityId":"vndb:p34","name":"アクトレス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:32596:v4018","source":"vndb"}