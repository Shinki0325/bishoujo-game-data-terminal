ative","relationId":"vndb:vn-staff:101943","source":"vndb"},{"creditedName":"ハセボ","creatorId":"vndb:s3976","sourcePersonId":"vndb:s3976","canonicalEntityId":"vndb:s3976","name":"ハセボ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:101947","source":"vndb"},{"creditedName":"さえきそれなり","creatorId":"vndb:s3979","sourcePersonId":"vndb:s3979","canonicalEntityId":"vndb:s3979","name":"さえきそれなり(冴木其成)","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:101948","source":"vndb"},{"creditedName":"さえきそれなり","creatorId":"vndb:s3979","sourcePersonId":"vndb:s3979","canonicalEntityId":"vndb:s3979","name":"さえきそれなり(冴木其成)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:101949","source":"vndb"},{"creditedName":"Rけん","creatorId":"vndb:s4014","sourcePersonId":"vndb:s4014","canonicalEntityId":"vndb:s4014","name":"Rけん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:101950","source":"vndb"},{"creditedName":"はらだ","creatorId":"vndb:s4015","sourcePersonId":"vndb:s4015","canonicalEntityId":"vndb:s4015","name":"はらだ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:101951","source":"vndb"},{"creditedName":"遠山 遼","creatorId":"vndb:s4021","sourcePersonId":"vndb:s4021","canonicalEntityId":"vndb:s4021","name":"遠山 遼","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:101952","source":"vndb"},{"creditedName":"マゲ","creatorId":"vndb:s4263","sourcePersonId":"vndb:s4263","canonicalEntityId":"vndb:s4263","name":"マゲ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:101953","source":"vndb"}]},"cast":[{"characterId":"char_c14219","characterName":"幸崎 羽海","sourceIds":{"bangumi":[{"characterId":"23933","match":"exact-normalized-name-in-linked-work","subjectId":"79838"}],"egsCharacterIds":["2182"],"vndbCharacterId":"c14219"},"originalCharacterName":"幸崎 羽海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Soutarou's junior at the university. She talks in a stern, but polite way, and she gives off an aura which makes her difficult to approach. Thus she doesn't really have friends. She doesn't particularly like talking to other people either, but finds Soutarou to be easy to talk with since he's cut from the same cloth. She is usually calm and determined, but tends to jump into wrong conclusions. Sometimes she can become childishly stubborn. When other girls get close to Soutarou, she acts jealously as girls of her age usually do."}],"source":"vndb","sourceCharacterId":"c14219"},{"segments":[{"spoiler":false,"text":"主人公（宗太郎）が通う大学の後輩。"},{"spoiler":false,"text":"宗太郎をバイトに誘い、一緒にコテージのある南の島を訪れる。"},{"spoiler":false,"text":"凛とした丁寧な口ぶりでしゃべる、美人な後輩。"},{"spoiler":false,"text":"冷静沈着かつ毅然とした近寄り難い雰囲気を発してはいるが、早とちりしたり真面目だけどドジっ子だったりと、どこか抜けている一面を持っている。"},{"spoiler":false,"text":"不可抗力（？）により羽海の胸を触ってしまった宗太郎の「責任を取る」発言に対し、その責任の取り方を監視するという名目で接しているうち、次第に宗太郎の言動が気になっていく。"},{"spoiler":false,"text":"大人びた言動をとるが基本的には意地っ張りで子供っぽいところも多く、宗太郎に近づく女子にヤキモチを焼く姿は年相応のもの。"}],"source":"egs","sourceCharacterId":"2182","sourceWorkId":"19367","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・宗太郎が通う大学の後輩。"},{"spoiler":false,"text":"宗太郎をバイトに誘い、一緒にコテージのある南の島を訪れる。"},{"spoiler":false,"text":"凛とした丁寧な口調でしゃべる美人。"},{"spoiler":false,"text":"冷静沈着かつ毅然とした近寄り難い雰囲気を発してはいるが、早とちりしたり、まじめだけどドジっ子だったりと、どこか抜けている一面を持っている。"},{"spoiler":false,"text":"不可抗力（？）により羽海の胸を触ってしまった宗太郎の 「責任を取る」 発言に対し、その責任の取り方を監視するという名目で接しているうち、次第に宗太郎の言動が気になっていく。"},{"spoiler":false,"text":"大人びた言動をとるが基本的には意地っ張りで子供っぽいところも多く、宗太郎に近づく女子にヤキモチを焼く姿は年相応のもの。"},{"spoiler":false,"text":"「……そういうことなら、ぜ、善処してあげてもいいと思いました」"}],"source":"bangumi","sourceCharacterId":"23933"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/304e844a3f87f0712a3b4a539f525e5bba0cab1014c8a0d952c975f0e03cb0c6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/689fd8a2455d84315c2d65fcc1da049af6605c8608b77f4b277ae42dd1a9fb2f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中島沙樹","creatorId":"vndb:s44","sourcePersonId":"vndb:s44","canonicalEntityId":"vndb:s44","name":"中島 沙樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79838:23933:4500:1","source":"bangumi"}]},{"characterId":"char_c14220","characterName":"津久見 さんご","sourceIds":{"bangumi":[{"characterId":"23934","match":"exact-normalized-name-in-linked-work","subjectId":"79838"}],"egsCharacterIds":["2183"],"vndbCharacterId":"c14220"},"originalCharacterName":"津久見 さんご","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She came to the island together with her friend Konami during the summer vacation to work for cold hard cash. A cheerful girl, she looks at everything positively and is a mood maker. Because everyone around her is older, she planned to use honorifics but failed massively. She has a very straightforward personality and can speak with Soutarou normally, and she also lovingly refers to Umi as \"Umi-oneechan\". She is very good friends with Konami and is always worried about her, but at the same time she works really hard."}],"source":"vndb","sourceCharacterId":"c14220"},{"segments":[{"spoiler":false,"text":"夏休みを利用して友人の小波と一緒に南の島へバイトに来ている。"},{"spoiler":false,"text":"絵に描いたような元気っ娘。明るく何事にも積極的で、みんなのムードメーカー。"},{"spoiler":false,"text":"周りがほとんど年上なので、本人は敬語を使っているつもりだが、まったくもってくだけている様子。"},{"spoiler":false,"text":"人見知りせず、男である宗太郎にも気さくに話しかたり「羽海姉」など、親しみを込めて呼んだりと、とてもフランクな性格をしている。"},{"spoiler":false,"text":"小波とは現在通っている学園では同じクラスで、大の仲良し。いつも小波を気遣って、バイトに励んでいる。"}],"source":"egs","sourceCharacterId":"2183","sourceWorkId":"19367","spoiler":false},{"segments":[{"spoiler":false,"text":"夏休みを利用して、友人の小波と一緒に南の島へバイトに来ている。"},{"spoiler":false,"text":"絵に描いたような元気っ娘。 明るく何事にも積極的で、みんなのムードメーカー。"},{"spoiler":false,"text":"周りがほとんど年上なので本人は敬語を使っているつもりだが、まったくもって砕けている様子。"},{"spoiler":false,"text":"人見知りせず、男である宗太郎にも気さくに話し掛けたり、羽海を “羽海姉” などと親しみを込めて呼んだりと、とてもフランクな性格をしている。"},{"spoiler":false,"text":"小波とは現在通っている学園のクラスメイトで、大の仲良し。"},{"spoiler":false,"text":"いつも小波を気遣いつつ、バイトに励んでいる。"},{"spoiler":false,"text":"「せっかくのお休みなんですから、みんなで楽しみましょうよ～」"}],"source":"bangumi","sourceCharacterId":"23934"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b2ce13e682aecd449c2ed168b4acc235571947593fbbc162364a950e237d43b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c717502dd20849e1e399ddc7e9835e478fbddab79fbd6c424cde349dbc35669.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜咲千依","creatorId":"vndb:s608","sourcePersonId":"vndb:s608","canonicalEntityId":"vndb:s608","name":"藤咲ウサ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79838:23934:8990:1","source":"bangumi"}]},{"characterId":"char_c14221","characterName":"杵築 莉帆","sourceIds":{"bangumi":[{"characterId":"23935","match":"exact-normalized-name-in-linked-work","subjectId":"79838"}],"egsCharacterIds":["2184"],"vndbCharacterId":"c14221"},"originalCharacterName":"杵築 莉帆","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Gentle, easy to get along with others and an attentive girl. She speaks with the \"desu wa\" or \"desu no\" and other typical ojou-sama speech patterns. She is a bit off her knockers sometimes, relaxed and happily invades other people's personal areas. She feels there is no concept between men and women, so she is constantly hugging Soutarou. She has a clumsy side and sometimes falls down in plain areas, but during work she is more focused than anyone else, after work she will look for other things to do. She came to the island to experience what the society is like as she is from a wealthy family."}],"source":"vndb","sourceCharacterId":"c14221"},{"segments":[{"spoiler":false,"text":"「ですわ」「ですの」等の典型的なお嬢様言葉でしゃべり、人懐っこく素直で一途な性格。"},{"spoiler":false,"text":"すこし抜けていて天然系であり、ほわほわしていて他人との距離感がとても近い。"},{"spoiler":false,"text":"宗太郎に対しても男女という概念が無いと思えるほどに無防備で、普通に抱きついてくる。"},{"spoiler":false,"text":"何もないところでつまづいたりもして、ドジな面もみせるが、仕事に関しては人一倍真面目で、仕事が終わると次の仕事を自ら探しに行く。"},{"spoiler":false,"text":"実際家がお金持ちで本当のお嬢様らしいのだが、世間を知るためにアルバイトに来ているとのこと。"}],"source":"egs","sourceCharacterId":"2184","sourceWorkId":"19367","spoiler":false},{"segments":[{"spoiler":false,"text":"「ですわ」「ですの」 などの典型的なお嬢様言葉でしゃべり、人懐っこく素直で一途な性格。"},{"spoiler":false,"text":"少し抜けていて天然系であり、ほわほわしていて他人との距離感がとても近い。"},{"spoiler":false,"text":"宗太郎に対しても男女という概念が無いと思えるほどに無防備で、普通に抱きついてくる。"},{"spoiler":false,"text":"何もない所でつまづいたりしてドジな面も見せるが、仕事に関しては人一倍まじめで、仕事が終わると次の仕事を自ら探しに行く。"},{"spoiler":false,"text":"家はお金持ちで本当のお嬢様らしいのだが、世間を知るためにアルバイトに来ているとのこと。"},{"spoiler":false,"text":"「うふふっ。 宗太郎さんには、いろいろと教えていただきますわ」"}],"source":"bangumi","sourceCharacterId":"23935"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d277e39de692d1c779ebe2994f107e2b2d1c2912e7d0157488d6bf985f4cc0d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/925bb7ab997d51bd0337dd0782011730884650618af4f007c3c5bf2b5bccbf86.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79838:23935:5020:1","source":"bangumi"}]},{"characterId":"char_c14222","characterName":"牧 汐璃","sourceIds":{"bangumi":[{"characterId":"23936","match":"exact-normalized-name-in-linked-work","subjectId":"79838"}],"egsCharacterIds":["2185"],"vndbCharacterId":"c14222"},"originalCharacterName":"牧 汐璃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the staff working at the resort. Shiori is a shy girl of few words. Occasionally, to the surprise of her listeners, she blurts out phrases unbecoming of her cute exterior. At a glance she might look surly, but if you look closer, you might notice her blushing. She places a great deal of trust in Nagisa, and treats her like a family. Often, Shiori spends her days off painting, but she doesn't confine herself to indoors and assertively participates in activities with everyone."}],"source":"vndb","sourceCharacterId":"c14222"},{"segments":[{"spoiler":false,"text":"コテージで働く従業員。"},{"spoiler":false,"text":"恥ずかしがり屋で口数少なく黙々と仕事をこなしている。"},{"spoiler":false,"text":"たまに可愛い外見からは似ても似つかないエッジの効いた発言をして相手を驚かせるが、本人はいたって真面目である。"},{"spoiler":false,"text":"一見無愛想に見えるが良く見ると赤面している。管理人の渚の事を信頼しており、家族のように慕っている。"},{"spoiler":false,"text":"絵を描くことが趣味で、休みの日は絵を描いて過ごすことが多い。ただし引きこもったりはせず、みんなの輪にも普通に入ってくる積極性も持っている。"}],"source":"egs","sourceCharacterId":"2185","sourceWorkId":"19367","spoiler":false},{"segments":[{"spoiler":false,"text":"コテージで働く従業員。 恥ずかしがり屋で口数少なく、黙々と仕事をこなしている。"},{"spoiler":false,"text":"たまに可愛い外見からは思いもよらないエッジの効いた発言をして相手を驚かせるが、本人はいたってまじめである。"},{"spoiler":false,"text":"一見無愛想に見えるが、よく見ると赤面している。"},{"spoiler":false,"text":"管理人の渚のことを信頼しており、家族のように慕っている。"},{"spoiler":false,"text":"絵を描くことが趣味で、休みの日は絵を描いて過ごすことが多い。"},{"spoiler":false,"text":"ただし引きこもったりはせず、みんなの輪にも普通に入ってくる積極性も持っている。"},{"spoiler":false,"text":"「宗太郎は……変態さんです。死なないと治らない類の人です」"}],"source":"bangumi","sourceCharacterId":"23936"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eae32a1e73d69e88c181f56622ff5c8dbfaecac285d1d9f8797bd174607f01bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9b927256fa151b70f17eca86a4c4f78c3d521d1ace51ed9248640fbb85a777e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩﨑春奈","creatorId":"vndb:s878","sourcePersonId":"vndb:s878","canonicalEntityId":"vndb:s878","name":"岩﨑 春奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79838:23936:11648:1","source":"bangumi"}]},{"characterId":"char_c14223","characterName":"狩生 渚","sourceIds":{"bangumi":[{"characterId":"23937","match":"exact-normalized-name-in-linked-work","subjectId":"79838"}],"egsCharacterIds":["2186"],"vndbCharacterId":"c14223"},"originalCharacterName":"狩生 渚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Umi's childhood friend and the resort manager. Her duties as a manager is perfect, no matter what problem she comes across, she solves them very neatly. For people that make a mistake or break the rules, she will calmly ask for the reason and will not harshly blame them and will try to understand them. Because of her intellectual side her words might seem stern, but she is very kind and cares a lot about her workers. She fell in love with Soutarou at first sight, and always tries to separate the work from her feelings."}],"source":"vndb","sourceCharacterId":"c14223"},{"segments":[{"spoiler":false,"text":"羽海の幼馴染みでありコテージの管理人を務める。"},{"spoiler":false,"text":"管理人としての仕事は完璧で、指示出しからなにから、テキパキとこなす。"},{"spoiler":false,"text":"ミスをした人や、ルールをやぶった人には淡々と原因について問いただすが、厳しくしかりつけるわけではなく、相応の理解も示す柔軟な面を見せる。"},{"spoiler":false,"text":"知性溢れるストレートな言葉遣いなのでやわらかさはあまり感じないものの、気遣いと優しさは節々に感じることが出来る。"},{"spoiler":false,"text":"羽海だけではなく、バイトメンバー全員のことを優しく見守っているが、時折見せる鋭い目つきは一部の人間にとっては大好物となるはず。"}],"source":"egs","sourceCharacterId":"2186","sourceWorkId":"19367","spoiler":false},{"segments":[{"spoiler":false,"text":"羽海の幼なじみであり、コテージの管理人を務める。"},{"spoiler":false,"text":"管理人としての仕事は完璧で、指示出しから何からテキパキとこなす。"},{"spoiler":false,"text":"ミスをした人やルールを破った人には淡々と原因について問いただすが、厳しく叱りつけるわけではなく、相応の理解も示す柔軟な面を見せる。"},{"spoiler":false,"text":"知性あふれるストレートな言葉遣いなので柔らかさはあまり感じないものの、気遣いと優しさは節々に感じることができる。"},{"spoiler":false,"text":"羽海だけでなくバイトメンバー全員のことを優しく見守っているが、時折見せる鋭い目つきは一部の人間にとっては大好物となるはず。"},{"spoiler":false,"text":"「早く仕事を覚えて、此処での生活になれて頂戴。 いいわね」"}],"source":"bangumi","sourceCharacterId":"23937"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/643a3b7d29caab9d0513a445698b0db7fc0323205c4e65648833fa4190da2369.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/0941c98ab4fa2cd76fbe3b6db8d81de4b06ce04e1dccaf8c15e78266ac55190a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79838:23937:5741:1","source":"bangumi"}]},{"characterId":"char_c14224","characterName":"大在 宗太郎","sourceIds":{"bangumi":[{"characterId":"205029","match":"exact-normalized-name-in-linked-work","subjectId":"180946"},{"characterId":"205029","match":"exact-normalized-name-in-linked-work","subjectId":"79838"}],"egsCharacterIds":["2187"],"vndbCharacterId":"c14224"},"originalCharacterName":"大在 宗太郎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist. He lives an independent life so he is a very poor student."}],"source":"vndb","sourceCharacterId":"c14224"},{"segments":[{"spoiler":false,"text":"親に頼らず生活しているので万年金欠の苦学生。"},{"spoiler":false,"text":"なるようになる、しなければどうにもならない――と、背水の陣的に生きているが、見方によっては、真面目で努力家、決断が早く、落ち着いているようにも見える。"},{"spoiler":false,"text":"いろいろあって彼女と一緒に南の島でバイトをすることになったのだが、現地で突然「彼氏として過ごして下さい」と言われ、前途多難な運命に巻き込まれていく。"}],"source":"egs","sourceCharacterId":"2187","sourceWorkId":"19367","spoiler":false},{"segments":[{"spoiler":false,"text":"親に頼らず生活しているので万年金欠の苦学生。"},{"spoiler":false,"text":"なるようになる、しなければどうにもならない――と、背水の陣的に生きているが、見方によってはまじめで努力家、決断が早く、落ち着いているようにも見える。"},{"spoiler":false,"text":"あまり世間の流行などに興味はなく、一般的・常識的なものに沿って生きる。"},{"spoiler":false,"text":"不可抗力（？）で後輩の羽海の胸を触ってしまい、そこから羽海と接することになる。"},{"spoiler":false,"text":"いろいろあって彼女と一緒に南の島でバイトをすることになったのだが、現地で突然 「彼氏として過ごして下さい」 と言われ、前途多難な運命に巻き込まれていく。"},{"spoiler":false,"text":"「俺くらいは、俺を好きでいてあげたいなって、そう思っているんだ」"}],"source":"bangumi","sourceCharacterId":"205029"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf42c7338d5d50f1f7b61204a76c4175854caf3fe45882522d2516f8b04955f4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/595c8f82a6a9184de3397ba4e36c6f84c824981ea50ea1d33c926953d2c527c6.webp","width":146,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c14225","characterName":"夜明 夕陽","sourceIds":{"bangumi":[{"characterId":"23938","match":"exact-normalized-name-in-linked-work","subjectId":"79838"}],"egsCharacterIds":["2188"],"vndbCharacterId":"c14225"},"originalCharacterName":"夜明 夕陽","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"94"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Another part time worker. Her job is to carry food and materials into the resort facilities. She talks like a boy, is not the least bit modest and gets confident very easily. To put it bluntly, she is just a stupid kid. Very arrogant and has a lot of pride, she thinks her head is very smart. When she is silent she is very cute, her body is also outstanding, but in the end she is still an idiot. Despite all this she has a lot of respect for Nagisa and looks up to her very much."}],"source":"vndb","sourceCharacterId":"c14225"},{"segments":[{"spoiler":false,"text":"夏休みの間、リゾート施設に食品等の資材を納入するバイトをしている。"},{"spoiler":false,"text":"健康的でボーイッシュ。"},{"spoiler":false,"text":"言葉遣いに遠慮はなく、よく言えば自信に満ち溢れ、負けず嫌いな子。"},{"spoiler":false,"text":"わるく言えば自覚のないただのアホの子。"},{"spoiler":false,"text":"常に小生意気に勝ち誇っていて、自分では頭が良いと思っている。黙っていれば可愛いし、スタイルも抜群なのだが、やっぱりアホの子。"},{"spoiler":false,"text":"渚に憧れており、尊敬の念を込めて『御姉様』と呼んで慕っている。"}],"source":"egs","sourceCharacterId":"2188","sourceWorkId":"19367","spoiler":false},{"segments":[{"spoiler":false,"text":"夏休みの間、リゾート施設に食品などの資材を納入するバイトをしている。"},{"spoiler":false,"text":"健康的でボーイッシュ。 言葉遣いに遠慮はなく、良く言えば自信に満ちあふれ、負けず嫌いな子。"},{"spoiler":false,"text":"悪く言えば、自覚のないただのアホな子。"},{"spoiler":false,"text":"常に小生意気に勝ち誇っていて、自分では頭が良いと思っている。"},{"spoiler":false,"text":"黙っていれば可愛いしスタイルも抜群なのだが、やっぱりアホな子。"},{"spoiler":false,"text":"渚に憧れており、尊敬の念を込めて “お姉様” と呼んで慕っている。"},{"spoiler":false,"text":"「お姉様に気安く話しかけるなんて、百万光年早いわ！」"}],"source":"bangumi","sourceCharacterId":"23938"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3578140138a178082057fc7a51f666ba6c3a7bd655239d013d755c92be6c6d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e298541f63f0548f12d2e075b30920045e5f99c8d2bae01e6a572fab7435b28.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林桂子","creatorId":"vndb:s443","sourcePersonId":"vndb:s443","canonicalEntityId":"vndb:s443","name":"美月(声優)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79838:23938:16180:1","source":"bangumi"}]},{"characterId":"char_c14226","characterName":"賀来 小波","sourceIds":{"bangumi":[{"characterId":"23939","match":"exact-normalized-name-in-linked-work","subjectId":"79838"}],"egsCharacterIds":["2189"],"vndbCharacterId":"c14226"},"originalCharacterName":"賀来 小波","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sango's classmate and friend. They came to the island together in order to find a part-time job. She takes her work seriously and is very focused, but she is a shy girl and finds it difficult to talk to other people. Sometimes she spaces out and gazes into a distance but doesn't reject human contact. Has little self-confidence, and sometimes imagines everything as negative, but she gets her motivation from Sango and they have a very reassuring relationship."}],"source":"vndb","sourceCharacterId":"c14226"},{"segments":[{"spoiler":false,"text":"さんごのクラスメイトで親友。"},{"spoiler":false,"text":"さんごに誘われて島で一緒にバイトをするためやってきた。"},{"spoiler":false,"text":"仕事には積極的で真面目にこなすが、会話にはなかなか入れない"},{"spoiler":false,"text":"恥ずかしがり屋。ただし、さんごに対してならそれなりに意見ができる。"},{"spoiler":false,"text":"時折どこか遠くを見つめる仕草をしたりと、はかなげな雰囲気を出しているが、人との接点を拒んでいるような素振りはない。"},{"spoiler":false,"text":"自分に自信がないのか、少々ネガティブな発言も見うけられるが、その度にさんごから突っ込まれ励まされるなど、二人は微笑ましい関係である。"}],"source":"egs","sourceCharacterId":"2189","sourceWorkId":"19367","spoiler":false},{"segments":[{"spoiler":false,"text":"さんごのクラスメイトで親友。 島で一緒にバイトをするためにやって来た。"},{"spoiler":false,"text":"仕事には積極的でまじめにこなすが、会話にはなかなか入れない恥ずかしがり屋。"},{"spoiler":false,"text":"ただし、さんごに対してならそれなりに意見が出来る。"},{"spoiler":false,"text":"時折どこか遠くを見つめる仕草をしたりと儚げな雰囲気を出しているが、人との接点を拒んでいるような素振りはない。"},{"spoiler":false,"text":"自分に自信がないのか、少々ネガティブな発言も見受けられるが