人员","identityStatus":"source-native","relationId":"vndb:vn-staff:124877","source":"vndb"},{"creditedName":"RUNA","creatorId":"vndb:s3057","sourcePersonId":"vndb:s3057","canonicalEntityId":"vndb:s3057","name":"SATOMI","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:124878","source":"vndb"}]},"cast":[{"characterId":"char_c37785","characterName":"猪上 秀","sourceIds":{"bangumi":[{"characterId":"37532","match":"exact-normalized-name-in-linked-work","subjectId":"148674"},{"characterId":"37532","match":"exact-normalized-name-in-linked-work","subjectId":"167689"}],"egsCharacterIds":["7121"],"vndbCharacterId":"c37785"},"originalCharacterName":"猪上 秀","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【主人公】"},{"spoiler":false,"text":"頭が良く、まじめな学生として扱われている優等生。"},{"spoiler":false,"text":"期待されるのは好きで、期待されたら応えようと努力する。"},{"spoiler":false,"text":"何か熱中できるものが欲しいと考えている。"},{"spoiler":false,"text":"「これは僕が望んでいることなんだ！」"}],"source":"egs","sourceCharacterId":"7121","sourceWorkId":"22393","spoiler":false},{"segments":[{"spoiler":false,"text":"荊の1歳上の幼馴染であり、恋人。"},{"spoiler":false,"text":"ある日 荊から余命半年であることを告げられ、彼女の頼みで荊のことを忘れようとしていた少年。"},{"spoiler":false,"text":"そして、無機質な毎日を過ごしていた秀だったが、荊が自殺する寸前、再び彼女に寄り添うことを決意する。"}],"source":"egs","sourceCharacterId":"7121","sourceWorkId":"22899","spoiler":false},{"segments":[{"spoiler":false,"text":"头脑很好，被视为是认真的学生的优等生。"},{"spoiler":false,"text":"喜欢被期待，被期待的话会为了回应而努力。"},{"spoiler":false,"text":"希望找到能让自己投入其中的事物。"},{"spoiler":false,"text":"「这是我的期望！」"}],"source":"bangumi","sourceCharacterId":"37532"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1ea4328f978bca2a905cc9959b28a999856641aae48795e58d2fe994754c11e7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eeab35054a7db7fa5127eaa41f323ba18bdcdedb8b2881e3ef03f851110834ea.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c37786","characterName":"美濃町 叶","sourceIds":{"bangumi":[{"characterId":"37529","match":"exact-normalized-name-in-linked-work","subjectId":"148674"}],"egsCharacterIds":["7122"],"vndbCharacterId":"c37786"},"originalCharacterName":"美濃町 叶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"あまり勉強ができない女の子。"},{"spoiler":false,"text":"勉強ができる主人公のことを最初は妬ましく思っていたが、話をしていくうちに惹かれていき、恋心を抱くようになる。"},{"spoiler":false,"text":"「生えてくるんでしょ？」"}],"source":"egs","sourceCharacterId":"7122","sourceWorkId":"22393","spoiler":false},{"segments":[{"spoiler":false,"text":"学习不怎么好的女孩子。"},{"spoiler":false,"text":"虽然一开始嫉妒成绩优秀的主人公，但在交流的时候被吸引，开始对他产生好感。"},{"spoiler":false,"text":"「长出来了吧？」"}],"source":"bangumi","sourceCharacterId":"37529"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d28151a0b9680675b7cf5ba1366f46f76a7c33b5823c4c5bfe290eae146c687.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6fd1c1d9d1aa46ee915e6c85395c666f26db7f5decedd03fdf40b66782daf7e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平松真奈実","creatorId":"vndb:s857","sourcePersonId":"vndb:s857","canonicalEntityId":"vndb:s857","name":"平松 真奈実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:148674:37529:19253:1","source":"bangumi"}]},{"characterId":"char_c37787","characterName":"和泉 真菜香","sourceIds":{"bangumi":[{"characterId":"37531","match":"exact-normalized-name-in-linked-work","subjectId":"14