b"},{"creditedName":"大沢 圭一","creatorId":"vndb:s9130","sourcePersonId":"vndb:s9130","canonicalEntityId":"vndb:s9130","name":"大沢 圭一","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:102198","source":"vndb"},{"creditedName":"野沢 絵里","creatorId":"vndb:s19015","sourcePersonId":"vndb:s19015","canonicalEntityId":"vndb:s19015","name":"野沢 絵里","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:102200","source":"vndb"},{"creditedName":"峰岸 彩","creatorId":"vndb:s19016","sourcePersonId":"vndb:s19016","canonicalEntityId":"vndb:s19016","name":"峰岸 彩","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:102201","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c21355","characterName":"桜庭 アスカ","sourceIds":{"vndbCharacterId":"c21355"},"originalCharacterName":"桜庭 アスカ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Asuka is an ordinary high school student who's bored with her mundane life, and wonders if her uneventful days is what \"happiness\" truly is. She wishes for stimulation, as well as for her ordinary existence to be more important. Her wish comes true when a mysterious voice tells her to come to Wonderland, an exciting world where she's considered \"the ultimate, delicious meal\"."},{"spoiler":false,"text":"Though negative and lacking in self-esteem, her boredom fuels her curious nature and compels her to enjoy Wonderland to the fullest. Easily swept away when amused, Asuka finds herself changing, as well as changing those around her. She loves to shop and her favourite food is cheesecake."}],"source":"vndb","sourceCharacterId":"c21355"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc8f4bfa4878e3c46f2fa5d023a42d92d1c7a6868d125a7a15b6ad9fa2d049a8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9e4912be765891cf45af52ea97925202c57353ba2530530aaf31aef0adb6695.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c21411","characterName":"黒うさぎ","sourceIds":{"vndbCharacterId":"c21411"},"originalCharacterName":"黒うさぎ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"68"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A black rabbit with white ears. Kuro can frequently be seen carrying his pocket watch, rushing around and agonising over the time. He has a terrible personality and regularly berates or insults those around him. As a result, Kuro doesn't have any friends. When he's irritated or stressed, he has a habit of biting his nails. He was once a completely white rabbit, but stress caused his fur to turn black. Unpleased with his black fur, his constant rushing around has warped him and left him desiring death."},{"spoiler":false,"text":"Based on the official website's character profile."}],"source":"vndb","sourceCharacterId":"c21411"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e5bdcf3268a3b4f919d17b60faa9a6e8f0daccdfbb23e41bd1825063732c014.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd7472398