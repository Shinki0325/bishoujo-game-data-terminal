"roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:122840","source":"vndb"},{"creditedName":"SION","creatorId":"vndb:s4166","sourcePersonId":"vndb:s4166","canonicalEntityId":"vndb:s4166","name":"SION","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:122841","source":"vndb"},{"creditedName":"つゑふ","creatorId":"vndb:s23462","sourcePersonId":"vndb:s23462","canonicalEntityId":"vndb:s23462","name":"つゑふ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:122844","source":"vndb"}]},"cast":[{"characterId":"char_c38295","characterName":"天見 美佐子","sourceIds":{"bangumi":[{"characterId":"91722","match":"exact-normalized-name-in-linked-work","subjectId":"229690"}],"egsCharacterIds":["7187"],"vndbCharacterId":"c38295"},"originalCharacterName":"天見 美佐子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"29"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She was confessed to by Taito's father while she's working at the swimming school, which led to their marriage. She was also the instructor of Taito. Soon after, Taito's father died, and so right now, Misako and Taito lives together. Serious and gentle, she loves Taito as if he was her own child, but she's a bit overprotective."},{"spoiler":false,"text":"Since Taito doesn't call her \"mom\", shes worried that he doesn't see her as his mother. When Taito told her that he wants to work part-time, she was against it at first, but thought that it's fine if she can watch over him, so she offered him a job at her swimming school."},{"spoiler":false,"text":"Is it really strange for a mother and son to take baths together?"},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c38295"},{"segments":[{"spoiler":false,"text":"太斗が幼い頃に通っていたスイミングスクールで働いていた事がきっかけで、太斗の父に告白され結婚。"},{"spoiler":false,"text":"その後、太斗の父も亡くなっていしまい今は太斗と二人暮らし。"},{"spoiler":false,"text":"真面目で優しく、太斗の事を実の子のように愛してるがやや過保護な面がある。"},{"spoiler":false,"text":"太斗がアルバイトをしたいという希望に対し当初は反対していたものの、自分の目の届く所でならと自分が働くスイミングスクールでのアルバイトを紹介する。"},{"spoiler":false,"text":"太斗から「お母さん」と呼んでもらえず母親として認められてないのかと心配している。"}],"source":"egs","sourceCharacterId":"7187","sourceWorkId":"22386","spoiler":false},{"segments":[{"spoiler":false,"text":"スイミングスクールで働いていたところ、教え子である太斗の父に告白され結婚。"},{"spoiler":false,"text":"その後 太斗の父が亡くなってしまい、今は太斗と二人暮らし。"},{"spoiler":false,"text":"まじめで優しく、太斗のことを実の子のように愛してるが、やや過保護な面がある。"},{"spoiler":false,"text":"太斗から 「お母さん」 と呼んでもらえず、母親として認められていないのかと心配している。"},{"spoiler":false,"text":"また太斗がアルバイトしたいと言うが反対し、それなら自分の目の届く所でと、自分が働くスイミングスクールでのアルバイトを紹介する。"},{"spoiler":false,"text":"「やっぱり親子で一緒にお風呂って変かしら？」"}],"source":"bangumi","sourceCharacterId":"91722"}],"profileFacts":[{"label":"年龄（本版本）","value":"29 岁","valueContext":null,"source":"egs","sourceCharacterId":"7187","sourceWorkId":"22386","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"7187","sourceWorkId":"22386","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"7187","sourceWorkId":"22386","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"7187","sourceWorkId":"22386","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"7187","sourceWorkId":"22386","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"7187","sourceWorkId":"22386","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"52 kg","valueContext":null,"source":"egs","sourceCharacterId":"7187","sourceWorkId":"22386","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8aa0e8dfcfa8a0803dd967d253c93e66d03f838067f6c96b0000864fece73c7f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16d3292a8f08736a96ff42c39726c172601385d27783b58f5d926a31a044dee4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"霧島はるな","creatorId":"vndb:s2698","sourcePersonId":"vndb:s2698","canonicalEntityId":"vndb:s2698","name":"霧島はるな(水無月じゅん)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229690:91722:13771:1","source":"bangumi"}]},{"characterId":"char_c38296","characterName":"瀧谷 智江 (Takitani Tomoe)","sourceIds":{"bangumi":[{"characterId":"91723","match":"exact-normalized-name-in-linked-work","subjectId":"229690"}],"egsCharacterIds":["7188"],"vndbCharacterId":"c38296"},"originalCharacterName":"瀧谷 智江 (Takitani Tomoe)","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Age: Secret."},{"spoiler":false,"text":"1 year ago, she resigned as a teacher and got married. Currently, she's a newbie wife. Her husband is working overseas, and to kill some time, she works part time as an instructor. For Taito, she was a very understanding woman, and he has opened his heart to her long ago."},{"spoiler":false,"text":"A bit childish, and loves messing around. Because of that, she was always very popular with children. When Taito was in elementary school, he told her that he's gonna marry her once he grows up. At the moment, she's frustrated."},{"spoiler":false,"text":"My husband's working overseas for a year now, of course I'll be frustrated!"},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c38296"},{"segments":[{"spoiler":false,"text":"一年前に教師を辞めて結婚。今は新米人妻。"},{"spoiler":false,"text":"旦那は現在、海外に長期の単身赴任中。"},{"spoiler":false,"text":"暇つぶしにとインストラクターのパート中。"},{"spoiler":false,"text":"やや子供っぽい性格で悪戯好き。"},{"spoiler":false,"text":"その所為か、教師だった頃から子供には大人気。"},{"spoiler":false,"text":"太斗の良き理解者で、太斗自身も心を開いている。"},{"spoiler":false,"text":"幼い太斗に「大きくなったら先生と結婚するー」と言われた経験有り。"},{"spoiler":false,"text":"旦那が長期の単身赴任で欲求不満気味。"}],"source":"egs","sourceCharacterId":"7188","sourceWorkId":"22386","spoiler":false},{"segments":[{"spoiler":false,"text":"一年前に教職を辞めて結婚。 今は新米人妻。"},{"spoiler":false,"text":"旦那は海外に単身赴任中で、暇潰しにとインストラクターのパートをしている。"},{"spoiler":false,"text":"太斗にとっては良き理解者で、昔から心を開いていた。"},{"spoiler":false,"text":"やや子供っぽい性格でイタズラ好き。 そのせいか、昔から子供には大人気。"},{"spoiler":false,"text":"幼い太斗に 「大きくったら先生と結婚するー」 と言われた経験あり。"},{"spoiler":false,"text":"そして現在は欲求不満気味。"},{"spoiler":false,"text":"「旦那が一年も海外出張してるんだもの！　欲求不満にぐらいなるわよ！」"}],"source":"bangumi","sourceCharacterId":"91723"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"7188","sourceWorkId":"22386","sourceField":null,"scoped":true},{"label"