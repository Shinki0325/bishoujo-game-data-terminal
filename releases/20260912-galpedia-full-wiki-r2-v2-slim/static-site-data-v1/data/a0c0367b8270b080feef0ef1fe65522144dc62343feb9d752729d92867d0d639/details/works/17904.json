ahilo","creatorId":"vndb:s1492","sourcePersonId":"vndb:s1492","canonicalEntityId":"vndb:s1492","name":"眞尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:101011:208633:34633:1","source":"bangumi"}]},{"characterId":"char_c17767","characterName":"雪奈","sourceIds":{"bangumi":[{"characterId":"208634","match":"exact-normalized-name-in-linked-work","subjectId":"101011"}],"egsCharacterIds":["207"],"vndbCharacterId":"c17767"},"originalCharacterName":"雪奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the secondary heroine and daughter of Saeko. She is intelligent and good-looking."},{"spoiler":false,"text":"She is bright, kind, cheerful, and loved by everyone at school. In order to save Saeko, she gives herself up to a delinquent and is humiliated. And then, ......?"},{"spoiler":false,"text":"She is a Virgin and has a chubby belly."},{"spoiler":false,"text":"\"I will take my mother's place...\""}],"source":"vndb","sourceCharacterId":"c17767"},{"segments":[{"spoiler":false,"text":"【学園のアイドル】"},{"spoiler":false,"text":"本作のサブヒロイン。"},{"spoiler":false,"text":"冴子の娘。"},{"spoiler":false,"text":"頭脳明晰、容姿端麗。"},{"spoiler":false,"text":"明るく優しく朗らかで、皆に愛される学園のアイドル。"},{"spoiler":false,"text":"冴子を救う為、不良にその身を差し出し、恥辱の限りを尽くされる。"},{"spoiler":false,"text":"そして……？"},{"spoiler":false,"text":"「わたしが、母さんの身代わりになります……」"}],"source":"egs","sourceCharacterId":"207","sourceWorkId":"17904","spoiler":false},{"segments":[{"spoiler":false,"text":"冴子の娘。"},{"spoiler":false,"text":"明るく優しく朗らかで、皆に愛される学園のアイドル。"},{"spoiler":false,"text":"冴子を救うため、不良にその身を差し出し、恥辱の限りを尽くされる。"}],"source":"bangumi","sourceCharacterId":"208634"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50928ffafd4933e0c4061ca829914818c9b06de9f923b2516333ef26dab03385.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3956f48822cb711e167c81e102a2be812ed384cc42913ce5e0c761049224679.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水神楓","creatorId":"vndb:s1493","sourcePersonId":"vndb:s1493","canonicalEntityId":"vndb:s1493","name":"水神 楓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:101011:208634:22644:1","source":"bangumi"}]},{"characterId":"char_c17768","characterName":"シン","sourceIds":{"bangumi":[{"characterId":"90192","match":"exact-normalized-name-in-linked-work","subjectId":"101011"}],"egsCharacterIds":["208"],"vndbCharacterId":"c17768"},"originalCharacterName":"シン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this game. A delinquent who lurks in the darkness of the school. He is powerful and violent, and satisfies his desires as he pleases."},{"spoiler":false,"text":"He takes advantage of Saeko and Yukina's affection for each other and tears their bodies and hearts to shreds."},{"spoiler":false,"text":"With his strange charisma, he attracts not only students but also teachers, bringing destruction and chaos to the peaceful school building."}],"source":"vndb","sourceCharacterId":"c17768"},{"segments":[{"spoiler":false,"text":"【狡猾な不良】"},{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"学園の闇に潜む不良。"},{"spoiler":false,"text":"強大な権力と暴力を有し、思うが侭に欲望を満たす。"},{"spoiler":false,"text":"互いに庇いあう冴子と雪奈の情愛を利用し、その身と心をズタズタに引き裂いてゆく。"},{"spoiler":false,"text":"奇妙なカリスマ性によって、生徒のみならず教師までをも惹き込み、平和だった学び舎に破壊と混乱をもたらす。"},{"spoiler":false,"text":"非童貞。"},{"spoiler":false,"text":"「どうするも、テメェの自由さ♪」"}],"source":"egs","sourc