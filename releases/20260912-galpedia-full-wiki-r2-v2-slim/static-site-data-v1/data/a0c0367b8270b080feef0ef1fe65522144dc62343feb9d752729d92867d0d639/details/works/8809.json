,"text":"時々公園で子供達と遊んでいる姿が目撃されるらしい。"},{"spoiler":false,"text":"「…………」"}],"source":"bangumi","sourceCharacterId":"50288"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/643aaa1c4fbc5afc2ede8979a7d235984468b744683f123f2e1f4ba41a096b50.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec95f52dcd3dff7df4410e7486ece07db1e9dd861266ce3fe1ae56e527337580.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21312:50288:4432:1","source":"bangumi"}]},{"characterId":"char_c34273","characterName":"大道寺 涼子","sourceIds":{"bangumi":[{"characterId":"50287","match":"exact-normalized-name-in-linked-work","subjectId":"21312"}],"egsCharacterIds":["22461"],"vndbCharacterId":"c34273"},"originalCharacterName":"大道寺 涼子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"911"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"77"},"height":{"reviewState":"no-conflict","source":"vndb","value":"151"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、委員長を務める内気な女の子。"},{"spoiler":false,"text":"七音、ともえと親友らしく、よく3人で一緒にいる姿が見受けられる。"},{"spoiler":false,"text":"暴走寸前のともえを抑えるのは彼女の役目らしいが、暴走後はさすがに止められない様子。"},{"spoiler":false,"text":"時折、主人公を熱心に見つめる事があるらしいのだが……。"}],"source":"egs","sourceCharacterId":"22461","sourceWorkId":"8809","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、七音の親友。性格は内気で、いつもどことなく自信なさげに喋る。"},{"spoiler":false,"text":"七音、ともえとよく3人でいる事が多く、暴走寸前のともえを制御するのがいつもの役目（暴走後は流石に止められないらしい） クラス委員長と生徒会書記の兼任でいつも大変そうにしているが、本人は好きでやっているようだ。"},{"spoiler":false,"text":"時折、主人公を熱心に見つめている事があるらしいが……？"},{"spoiler":false,"text":"「い、いえ、好きでやってる事ですから」"}],"source":"bangumi","sourceCharacterId":"50287"}],"profileFacts":[{"label":"胸围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"22461","sourceWorkId":"8809","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"151 cm","valueContext":null,"source":"egs","sourceCharacterId":"22461","sourceWorkId":"8809","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"22461","sourceWorkId":"8809","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"22461","sourceWorkId":"8809","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7ccc0e0a2c3ec3d7787cb6fa149abc06c422bd8b78868af905375120e8c57fa3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a14167520d51f4e11de70ca7ebb5949b0e9d5b5f563888e1f16519ca539f5d62.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上みゆ","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21312:50287:6558:1","source":"bangumi"}]},{"characterId":"char_c34274","characterName":"萩原 ともえ","sourceIds":{"bangumi":[{"characterId":"50286","match":"exact-normalized-name-in-linked-work","subjectId":"21312"}],"egsCharacterIds":["22460"],"vndbCharacterId":"c34274"},"originalCharacterName":"萩原 ともえ","characterNa