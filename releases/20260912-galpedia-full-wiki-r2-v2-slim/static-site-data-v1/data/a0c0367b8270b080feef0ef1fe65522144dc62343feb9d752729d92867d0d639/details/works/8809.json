","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染かつ、天敵のような少女。"},{"spoiler":false,"text":"幼い頃、ガキ大将的な存在だったため、主人公は未だに頭が上がらない。"},{"spoiler":false,"text":"本人は極力、女の子らしく振舞おうとするのだが、結局最後は力技に持っていってしまう。"},{"spoiler":false,"text":"スポーツ万能、細かいことは気にしない性格で、学園内の人気は高い。"}],"source":"egs","sourceCharacterId":"22456","sourceWorkId":"8809","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼馴染でかつ、天敵（？）のような存在。子供の頃はガキ大将的存在で、そのせいか主人公はいまだに頭が上がらない。"},{"spoiler":false,"text":"もっとも七音自身はその事を恥じていて、極力女の子らしく振舞おうと努力するが、結局最後は得意技のコブラツイストを主人公に見舞うことになってしまう。"},{"spoiler":false,"text":"無所属ながら部活の助っ人を頼まれる事が多い、活動的なスポーツ少女。"},{"spoiler":false,"text":"真っ直ぐかつ細かい事は気にしない性格と相まって、学園内での人気は高い。"},{"spoiler":false,"text":"「うっ!?　さ、さっきのはつい手が出ちゃっただけで……」"}],"source":"bangumi","sourceCharacterId":"50284"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"22456","sourceWorkId":"8809","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"22456","sourceWorkId":"8809","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"858 cm","valueContext":null,"source":"egs","sourceCharacterId":"22456","sourceWorkId":"8809","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"22456","sourceWorkId":"8809","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57df963e90ab02ea9055aa9694a3d98f3877c5cd89bfc8d6fb91f931fe946ff2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f9da634ce0ab4decb24dfd101f86ca40b74ffb8aff83688214cdb34097c8b2c5.webp","wid