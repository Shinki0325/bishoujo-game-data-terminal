{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"10739","model":{"presentationWorkId":"vndb:v7906","staff":{"artwork":[],"scenario":[{"creditedName":"上遠乃 きつぐ","creatorId":"vndb:s4043","sourcePersonId":"vndb:s4043","canonicalEntityId":"vndb:s4043","name":"上遠乃 きつぐ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:74589","source":"vndb"},{"creditedName":"亮精 類","creatorId":"vndb:s4582","sourcePersonId":"vndb:s4582","canonicalEntityId":"vndb:s4582","name":"亮精 類","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:74590","source":"vndb"},{"creditedName":"影花","creatorId":"vndb:s6488","sourcePersonId":"vndb:s6488","canonicalEntityId":"vndb:s6488","name":"影花","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:74591","source":"vndb"}],"music":[],"other":[]},"cast":[{"characterId":"char_c70917","characterName":"香坂 由南","sourceIds":{"bangumi":[{"characterId":"219089","match":"exact-normalized-name-in-linked-work","subjectId":"217796"}],"egsCharacterIds":["18317"],"vndbCharacterId":"c70917"},"originalCharacterName":"香坂 由南","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"25"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"トラウマ：「拉致監禁」"},{"spoiler":false,"text":"主人公が丸め込まれた自己啓発セミナーの講師。"},{"spoiler":false,"text":"乗り込んできた主人公をその豊満な肉体を使って誘惑し、籠絡する。"},{"spoiler":false,"text":"主人公を陥れたセミナー側の人間だが、彼女にも辛い過去が……。"}],"source":"egs","sourceCharacterId":"18317","sourceWorkId":"8713","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のカウンセリングの助手。"},{"spoiler":false,"text":"学生時代に複数の男たちにレイプされ、心に大きな傷を負っていたが、主人公の洗脳術によって立ち直り、主人公の忠実な助手として働くようになった。"},{"spoiler":false,"text":"しかし、最近になって、不穏な動きが目立つようになってきて……。"}],"source":"egs","sourceCharacterId":"18317","sourceWorkId":"10739","spoiler":false},{"segments":[{"spoiler":false,"text":"常に余裕のある微笑みを浮かべている、啓発セミナーの講師。"},{"spoiler":false,"text":"理知的な話し方をするが、優しいお姉さんといった感じで、冷たい感じは受けない。"},{"spoiler":false,"text":"ただし、彼女の本心は全く見えない。"}],"source":"bangumi","sourceCharacterId":"219089"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08d35494475f9274cae436eb4cf9a942300108abda872b0e8501d8ae2a925671.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d9af00a0734bff55fa4ddcaae04a4d98316c516e80f5f109da0e39455ef86a6.webp","width":159,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c70918","characterName":"綾瀬 沙紀","sourceIds":{"bangumi":[{"characterId":"219092","match":"exact-normalized-name-in-linked-work","subjectId":"217796"}],"egsCharacterIds":["18318"],"vndbCharacterId":"c70918"},"originalCharacterName":"綾瀬 沙紀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"トラウマ：「メッキ」"},{"spoiler":false,"text":"舞台となる学園に通う女子学生。"},{"spoiler":false,"text":"全てにおいてソツなくこなす、天才肌の少女。"},{"spoiler":false,"text":"全力を出さなくとも、そこそこ成果が上がってしまい、努力してきた人間にさえも優ってしまうことから、気付けば、自分よりも能力のない人間を見下すような人間になってしまったいた。"},{"spoiler":false,"text":"そんな彼女の心の底では、本気になったときの限界を知ることへの恐怖が隠されている。"}],"source":"egs","sourceCharacterId":"18318","sourceWorkId":"8713","spoiler":false},{"segments":[{"spoiler":false,"text":"大抵のことは努力しないでも簡単に極められる器用さを持つ天才少女。"},{"spoiler":false,"text":"主人公のカウンセリングを受けた学友がおかしくなっていることから、その原因がカウンセリングにあると踏んで、主人公のセミナーに乗り込んでくる。"},{"spoiler":false,"text":"しかし、主人公の策略に嵌ってしまい、あえなく彼女自身も淫乱なカウンセリングの餌食に……。"}],"source":"egs","sourceCharacterId":"18318","sourceWorkId":"10739","spoiler":false},{"segments":[{"spoiler":false,"text":"少し力を入れるだけで、何事も人より上手くこなすことができる天才少女。"},{"spoiler":false,"text":"それ故に何事にも本気で取り組むことができず、無気力・無感動な人間になってしまった。"},{"spoiler":false,"text":"授業中なども真面目に聞いてはいないが、才能に一目置かれているため教師達は放置している。"}],"source":"bangumi","sourceCharacterId":"219092"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c63a0647d294bb2a0633fd9212abd9378874ead3a1420d146f936cd52b758e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/259c3891e52a444363536485f0aca5d6b34078454622c4396d128d3082a020ab.webp","width":159,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c70919","characterName":"糸島 戒四","sourceIds":{"vndbCharacterId":"c70919"},"originalCharacterName":"糸島 戒四","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p826","sourceCompanyId":"egs:brand:1885","canonicalEntityId":"vndb:p826","name":"Eroro","roleCo