s2829","name":"癸乙夜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:145316","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c16290","characterName":"ナァラ","sourceIds":{"vndbCharacterId":"c16290"},"originalCharacterName":"ナァラ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Although she is treated like the stepsister of Oori, the king of Rusu, Naala doesn't have a \"holier than thou\" atmosphere that is typical of somebody in her position. Since her father passed away when she was 5, and her widowed mother was abducted by the forces of the northern kingdom of Nasura, Naala has been robbed of her blood relatives from a young age. She was meant to wed Oori without any issues, however, Naala gets attacked by the Nasura army..."},{"spoiler":false,"text":"Based on the official website profile."}],"source":"vndb","sourceCharacterId":"c16290"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/4290fbfa6c4d209e57411a09b48b3acd9c4bc97fdf7d5bc0569264d8b1b7f86c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/063caacbb1d70ad64fca855dc958c5626a3c5425a81a31a6dec7f5431db71317.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"手塚 りょうこ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76339","source":"vndb"}]},{"characterId":"char_vndb_c16291","characterName":"トーヤ","sourceIds":{"vndbCharacterId":"c16291"},"originalCharacterName":"トーヤ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The king of Nasla, who ascended to the throne just one year ago."},{"spoiler":false,"text":"In accordance with a law that his father, the previous king established, he kidnaps many women from Rus (including the heroines) in order to prevent their bloodlines from dying out."},{"spoiler":false,"text":"However, he also established the Nasla Selection Law, preventing things such as violence against women. With policies that differ from the previous king, he spends his days thinking about ways to protect women's feelings."},{"spoiler":false,"text":"From official website profile."},{"spoiler":true,"text":"He had an older brother, who was Bayar, the child in Naala's memories."}],"source":"vndb","sourceCharacterId":"c16291"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71cde29c650248a6d0321d3600b536c2f51049cdf4abc342006e4f484eff0935.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f5870e21416fa48e153b53d3fdb0cbe7183c13a075dd8a5257ada2ce64663ad.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"皇 帝","creatorId":"vndb:s55","sourcePersonId":"vndb:s55","canonicalEntityId":"vndb:s55","name":"立花 慎之介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76336","source":"vndb"}]},{"characterId":"char_vndb_c16292","characterName":"ノール","sourceIds":{"vndbCharacterId":"c16292"},"originalCharacterName":"ノール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"28"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The king's most trusted vassal, in the political arena his influence is second only to the king's."},{"spoiler":false,"text":"While he may seem kind and agreeable, sometimes his cold-blooded side can be seen in his stance of putting the country above all else."},{"spoiler":false,"text":"He doesn't seem to have any interest in romance, dodging the issue with a smile even if a woman asks him about it."},{"spoiler":false,"text":"From official website profile."}],"source":"vndb","sourceCharacterId":"c16292"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21bebf7e9980b23ba1041b8be65ff8744feb2323c9985a20365e85189582bf81.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf1222b85648d739e71c4f1509928918cd835e66f419a2231c5282d8d52ae4f5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紫原 遥","creatorId":"vndb:s182","sourcePersonId":"vndb:s182","canonicalEntityId":"vndb:s182","name":"鈴木 千尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76338","source":"vndb"}]},{"characterId":"char_vndb_c16295","characterName":"スレン","sourceIds":{"vndbCharacterId":"c16295"},"originalCharacterName":"スレン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"26"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The general of the Nasura army, Slen holds the most authority on the battlefield, second only to the king. Since he treats women with a brash and forceful attitude, the Rusu women are afraid of him. However, his subordinates place their absolute trust in him. Despite his \"wild\" appearance, Slen is actually quite quick-witted and observant."},{"spoiler":false,"text":"Based on the official website profile."}],"source":"vndb","sourceCharacterId":"c16295"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b94d4ee9e08fd9d6a548efa0b0996f8ddc5eb3f400964335d31a9409dab20bdf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c06077ca0f145bb1e514dbdd6949a9569e2098b9c842ac0d7f3b1b1d95d2061.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"堀川 忍","creatorId":"vndb:s392","sourcePersonId":"vndb:s392","canonicalEntityId":"vndb:s392","name":"宮下 栄治","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76337","source":"vndb"}]},{"characterId":"char_vndb_c16297","characterName":"ナラン","sourceIds":{"vndbCharacterId":"c16297"},"originalCharacterName":"ナラン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A lively guy who thinks of Suren as an older brother, and is always following him around."},{"spoiler":false,"text":"His personality is straightforward and pure, but this sometimes makes him clumsy emotionally."},{"spoiler":false,"text":"On a certain route, he provides emotional support for the troubled heroine."},{"spoiler":false,"text":"From official website profile."}],"source":"vndb","sourceCharacterId":"c16297"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e92f8a82c67a5a781ca2eb9805bcb5528ff1a6ade4253107dd052d2ad172e7b5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35ef3f59ec975bc33ed98bfee8d86d7865110baccbc4893473230a57b94bb6d7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紀之","creatorId":"vndb:s15","sourcePersonId":"vndb:s15","canonicalEntityId":"vndb:s15","name":"杉山 紀彰","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76335","source":"vndb"}]},{"characterId":"char_vndb_c16316","characterName":"ルジ","sourceIds":{"vndbCharacterId":"c16316"},"originalCharacterName":"ルジ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young man that the heroine comes into contact with normally as everyone around him is embroiled in competition to find their bride."},{"spoiler":false,"text":"He is a pacifist with a relaxed nature, who does not anger easily."},{"spoiler":false,"text":"Through his profession as a doctor, he is extremely popular among both men and women, and often acts as an arbitrator."},{"spoiler":false,"text":"On a certain rule, he will work together towards the same goal."},{"spoiler":false,"text":"From official website profile."}],"source":"vndb","sourceCharacterId":"c16316"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0861b7922557648d15d37e5c997e70a99915781d76436990e9bea667fc3ed04.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90f2015e2d75f761bed02559fb710cda86ecb50ec6b99d4495967102c9d45f9c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐和 真中","creatorId":"vndb:s864","sourcePersonId":"vndb:s864","canonicalEn