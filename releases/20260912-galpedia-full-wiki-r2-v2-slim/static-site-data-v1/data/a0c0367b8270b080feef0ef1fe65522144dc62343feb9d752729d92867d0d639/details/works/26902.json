"},{"spoiler":false,"text":"Based on the official website profile."}],"source":"vndb","sourceCharacterId":"c16323"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e856471fd6c439c97936b599b68b3ab0e50082be2988a674cce55073a6fd7981.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9dc2db5251836f5167f5d021ece4b10a9f6e153111ace96c787ffd27c970b1c0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雪ノ彩 シロ","creatorId":"vndb:s1400","sourcePersonId":"vndb:s1400","canonicalEntityId":"vndb:s1400","name":"雪代 綾乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76343","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p2696","sourceCompanyId":"egs:brand:3738","canonicalEntityId":"vndb:p2696","name":"Operetta Due","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:26902:3738","source":"egs"},{"companyId":"vndb:p2696","sourceCompanyId":"vndb:p2696","canonicalEntityId":"vndb:p2696","name":"Operetta Due","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:106963:v22192","source":"vndb"},{"companyId":"vndb:p2696","sourceCompanyId":"vndb:p2696","canonicalEntityId":"vndb:p2696","name":"Operetta Due","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:62356:v22192","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
