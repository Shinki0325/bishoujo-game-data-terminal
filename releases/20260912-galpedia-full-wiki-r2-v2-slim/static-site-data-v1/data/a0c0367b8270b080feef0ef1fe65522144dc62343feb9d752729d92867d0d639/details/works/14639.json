linked-work","subjectId":"107497"}],"egsCharacterIds":["10897"],"vndbCharacterId":"c29896"},"originalCharacterName":"高平原 ナナホ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作のヒロイン。魔を討つ定めを負った少女。"},{"spoiler":false,"text":"”光魔法一族”の血を引き、高エネルギーの電撃を操る。"},{"spoiler":false,"text":"それをリボンに乗せ、異形のものどもをなぎ払う。"},{"spoiler":false,"text":"異形を前にした彼女は冷酷な殺戮者と化す。"},{"spoiler":false,"text":"プライベートでは勉強・スポーツともに万能の優等生だが、異形を滅ぼすことが第一で無関心なことはとことん無視する。"},{"spoiler":false,"text":"友達を作ろうともせず、たいていは一人で本を読んでいる。"},{"spoiler":false,"text":"常に張り詰めたような精神状態にあり、それゆえに脆い。"},{"spoiler":false,"text":"エッチな願望は少ないが、その容姿から、男性のいやらしい視線を常に浴びているため、意識せざるをえない。"},{"spoiler":false,"text":"露出度が高く、ピッチリとした服を好む。"},{"spoiler":false,"text":"隠すと負けを認めることになるから、らしい。すべてオーダーメイド。"},{"spoiler":false,"text":"異形の血で汚れた手を隠すためか、あらゆる他人を拒絶するためか、常に真っ白な手袋を付けている。"}],"source":"egs","sourceCharacterId":"10897","sourceWorkId":"14639","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のヒロイン。魔を討つ定めをおびた少女。"},{"spoiler":false,"text":"“光魔法一族” の血を引き、高エネルギーの電撃を操る。それをリボンに乗せ、異形の者どもをなぎ払う。"},{"spoiler":false,"text":"異形を前にした彼女は冷酷な殺戮者と化す。"},{"spoiler":false,"text":"プライベートでは勉強・スポーツともに万能の優等生だが、異形を滅ぼすことが第一で、無関心なことはとことん無視する。"},{"spoiler":false,"text":"友達を作ろうともせず、たいていは一人で本を読んでいる。常に張り詰めたような精神状態にあり、それゆえに脆い。"},{"spoiler":false,"text":"エッチな願望は少ないが、その容姿から男性のいやらしい視線を常に浴びているため、意識せざるをえない。"},{"spoiler":false,"text":"露出度が高く、ピッチリとした服を好む。隠すと負けを認めることになるから、らしい。すべてオーダーメイド。"},{"spoiler":false,"text":"異形の血で汚れた手を隠すためか、あらゆる他人を拒絶するためか、常に真っ白な手袋を付けている。"},{"spoiler":false,"text":"「動物は好きよ。人間と違って嘘をつかないし」"}],"source":"bangumi","sourceCharacterId":"25651"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2ceded7ad5d7d64fe9bb01efbe7b0861ce7792a3f651c0abaf67c92a3f9b189.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4cd800d277d5881f1617a09d566e9885484bc9fc5e59d39b08bd4f603c7cbfda.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柏木美優","creatorId":"vndb:s1030","sourcePersonId":"vndb:s1030","canonicalEntityId":"vndb:s1030","name":"柏木 美優","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:107497:25651:6540:1","source":"bangumi"}]},{"characterId":"char_c29897","characterName":"ミレイ・レティシア・ハヤミ","sourceIds":{"bangumi":[{"characterId":"25652","match":"exact-normalized-name-in-linked-work","subjectId":"107497"}],"egsCharacterIds":["10898"],"vndbCharacterId":"c29897"},"originalCharacterName":"ミレイ・レティシア・ハヤミ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"”黒豹”の異名を持つ、凄腕の女刑事。"},{"spoiler":false,"text":"日米クォーターで、褐色の肌に銀色の髪、肉感あるプロポーションの持ち主。"},{"spoiler":false,"text":"強靱な意志と、男顔負けの体力を持ち、アメリカ仕込みの格闘術と射撃にも秀でている。"},{"spoiler":false,"text":"唯一の悩みの種は方向音痴であること。"},{"spoiler":false,"text":"沈着冷静さと大胆さが同居した性格のため独断専行して上司から睨まれることも多いが、それを補って余りある実績を上げそれを黙らせている。"},{"spoiler":false,"text":"プライベートではざっくばらんな性格で、ひそかに可愛いもの好き。"},{"spoiler":false,"text":"イメージに合ってないのは自覚しているので、こっそり楽しんでいる。"},{"spoiler":false,"text":"男性経験は豊富そうだが、そう見えるだけ。処女。"},{"spoiler":false,"text":"乳首が陥没しているのが密かなコンプレックス。"},{"spoiler":false,"text":"世間を騒がしている”神隠し事件”の極秘捜査のために、閉鎖された町、綿山町に教師としてやってくる。"}],"source":"egs","sourceCharacterId":"10898","sourceWorkId":"14639","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公。“黒豹” の異名を持つ、凄腕の女刑事。"},{"spoiler":false,"text":"日米クォーターで、褐色の肌に銀色の髪、肉感あるプロポーションの持ち主。"},{"spoiler":false,"text":"強靱な意志と、男顔負けの体力を持ち、アメリカ仕込みの格闘術と射撃にも秀でている。唯一の悩みの種は方向音痴であること。"},{"spoiler":false,"text":"沈着冷静と大胆さが同居しており、それゆえ独断専行して上司から睨まれることも多いが、それを補って余りある実績を上げ黙らせている。"},{"spoiler":false,"text":"プライベートではざっくばらんな性格で、密かに可愛いもの好き。イメージに合ってないのは自覚しているので、こっそり楽しんでいる。"},{"spoiler":false,"text":"男性経験は豊富そうだが、そう見えるだけ。処女。乳首が陥没しているのが密かなコンプレックス。"},{"spoiler":false,"text":"世間を騒がしている 『神隠し事件』 の極秘捜査のために、閉鎖された町・綿山町に教師としてやってくる。"},{"spoiler":false,"text":"「私の前で勝手なことはさせないわ！　その男から離れなさい!!」"}],"source":"bangumi","sourceCharacterId":"25652"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c588f4ff79ae6024d16442049d2dbe36b55232767d1c322c56a6c2f9f41895d3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/9791bb5b3f68a1c157cf7a68c6c32c5d62461c3127abac162d147c37398d5d15.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田紗記子","creatorId":"vndb:s1658","sourcePersonId":"vndb:s1658","canonicalEntityId":"vndb:s1658","name":"葵時緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:107497:25652:17079:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p1413","sourceCompanyId":"egs:brand:1023","canonicalEntityId":"vndb:p1413","name":"Black Lilith","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:14639:1023","source":"egs"},{"companyId":"vndb:p1413","sourceCompanyId":"vndb:p1413","canonicalEntityId":"vndb:p1413","name":"Black Lilith","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:12940:v5654","source":"vndb"},{"companyId":"vndb:p1413","sourceCompanyId":"vndb:p1413","canonicalEntityId":"vndb:p1413","name":"Black Lilith","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:12941:v5654","source":"vndb"},{"companyId":"vndb:p149","sourceCompanyId":"vndb:p149","canonicalEntityId":"vndb:p149","name":"LILITH｜リリス","roleCodes":["publisher"],"identityStatus":"source-native","re