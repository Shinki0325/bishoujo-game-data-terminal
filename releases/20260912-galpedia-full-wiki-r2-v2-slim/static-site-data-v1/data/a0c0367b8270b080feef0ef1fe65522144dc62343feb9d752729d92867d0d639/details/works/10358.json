{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"10358","model":{"presentationWorkId":"vndb:v932","staff":{"artwork":[{"creditedName":"綾瀬はづき","creatorId":"vndb:s580","sourcePersonId":"egs:creator:5019","canonicalEntityId":"vndb:s580","name":"綾瀬はづき","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:59759","source":"egs"}],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c27283","characterName":"シェーラ","sourceIds":{"bangumi":[{"characterId":"205566","match":"exact-normalized-name-in-linked-work","subjectId":"223733"}],"egsCharacterIds":["14088"],"vndbCharacterId":"c27283"},"originalCharacterName":"シェーラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人間たちの環境破壊によって故郷の森を追われ、日本の山林に住むようになったエルフ族の王の娘。姉妹の姉。"},{"spoiler":false,"text":"人間嫌いのエルフ族の中にあって、賑やかな人間界に憧れを持ち、かなり好意的。"},{"spoiler":false,"text":"性格は大らかで母性本能が強く、困っている人がいると放っておけない。"},{"spoiler":false,"text":"知性、魔力ともに優れ、その性格とも相俟ってエルフの民からも慕われている。"},{"spoiler":false,"text":"今回、ひょんなことから主人公との結婚、子作りすることになり、彼女本人はやるき満々。"},{"spoiler":false,"text":"おっとりしたお姉さんタイプながら、エッチに関しては積極的でリードしてくれる。"},{"spoiler":false,"text":"存外、エロい。"}],"source":"egs","sourceCharacterId":"14088","sourceWorkId":"10358","spoiler":false},{"segments":[{"spoiler":false,"text":"『孕嫁さんはエルフ姫～押しかけ子づくり新婚生活～』登場のヒロイン。"},{"spoiler":false,"text":"人間たちの環境破壊によって故郷の森を追われ、日本の山林に住むようになったエルフ族の王の娘。姉妹の姉。"},{"spoiler":false,"text":"人間嫌いのエルフ族の中にあって、賑やかな人間界に憧れを持ち、かなり好意的。"},{"spoiler":false,"text":"性格は大らかで母性本能が強く、困っている人がいると放っておけない。"},{"spoiler":false,"text":"知性、魔力ともに優れ、その性格とも相俟ってエルフの民からも慕われている。"},{"spoiler":false,"text":"今回、ひょんなことから主人公との結婚、子作りすることになり、彼女本人はやるき満々。"},{"spoiler":false,"text":"おっとりしたお姉さんタイプながら、エッチに関しては積極的でリードしてくれる。存外、エロい。"}],"source":"egs","sourceCharacterId":"14088","sourceWorkId":"13401","spoiler":false},{"segments":[{"spoiler":false,"text":"エルフの国の長女姫。環境破壊のため住めなくなった故郷の森を捨てて、日本の山林に住まうようになったエルフの一族たちの王の娘。"},{"spoiler":false,"text":"おおらかな性格で、人間嫌いが多いエルフの中でも、かなり人間に好意的。また人間たちのにぎやかな世界に憧れている面もある。母性的な面が強く困っている者を見ると放っておけない性質。知性、魔力は高く、エルフの民からも慕われている。何でも人（並みのエルフ）以上にこなせる完璧なお姉さん。"},{"spoiler":false,"text":"おっとりしつつも、かなりエロイ。"}],"source":"bangumi","sourceCharacterId":"205566"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/122582bc145e40fd99163197dc69ba6afd308553ba6fd2a8ba85a0162843e44f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a39265ec95b010c265e1f68cd2fce95e6edbeb0d50fb769a8a698549b9824d4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さくらなつみ","creatorId":"vndb:s666","sourcePersonId":"vndb:s666","canonicalEntityId":"vndb:s666","name":"岩泉まい(樋口まゆら、樋口まゆ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223733:205566:6279:1","source":"bangumi"}]},{"characterId":"char_c27284","characterName":"アイラ","sourceIds":{"bangumi":[{"characterId":"205568","match":"exact-normalized-name-in-linked-work","subjectId":"223733"}],"egsCharacterIds":["18828"],"vndbCharacterId":"c27284"},"originalCharacterName":"アイラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"エルフ族の王女。シェーラの妹。"},{"spoiler":false,"text":"凛とした美しさを持つ、気高く、古風な女性。"},{"spoiler":false,"text":"他人にも自分にも厳しく、周囲から尊敬されながらも、同時に畏怖されている。"},{"spoiler":false,"text":"人間を毛嫌いしていないが、その文明社会には否定的な意見を持つ。"},{"spoiler":false,"text":"大らかで器の大きさを感じさせる姉にコンプレックスを抱いており、姉よりも武の面では優ろうと努めている。"},{"spoiler":false,"text":"ゆえに武人のような朴とつさがあり、極めて女性らしさが欠如してる。"},{"spoiler":false,"text":"父王より姉とともに主人公の子を成すよう命じられ、表面的には反発しながらも、内心では……。"}],"source":"egs","sourceCharacterId":"18828","sourceWorkId":"10358","spoiler":false},{"segments":[{"spoiler":false,"text":"『孕嫁さんはエルフ姫～』登場のヒロイン。"},{"spoiler":false,"text":"エルフ族の王女。凛とした美しさを持つ、気高く、古風な女性。"},{"spoiler":false,"text":"他人にも自分にも厳しく、周囲から尊敬されながらも、同時に畏怖されている。"},{"spoiler":false,"text":"人間を毛嫌いしていないが、その文明社会には否定的な意見を持つ。"},{"spoiler":false,"text":"大らかで器の大きさを感じさせる姉にコンプレックスを抱いており、姉よりも武の面では優ろうと努めている。故に武人のような朴とつさがあり、極めて女性らしさが欠如してる。"},{"spoiler":false,"text":"父王より姉とともに主人公の子を成すよう命じられ、表面的には反発しながらも内心では……。"}],"source":"egs","sourceCharacterId":"18828","sourceWorkId":"16003","spoiler":false},{"segments":[{"spoiler":false,"text":"エルフの国の次女姫。環境破壊のため住めなくなった故郷の森を捨てて、日本の山林に住まうようになったエルフの一族たちの王の娘。"},{"spoiler":false,"text":"気高く言動共に古風で無口。負けず嫌い。他人にも自分にも厳しいところが禍いしてか、周囲には尊敬されるも恐れられてもおり、孤独な面がある。魔力よりも武技の才能に秀でている。自分の大切なものは何があっても守り抜こうというような強い信念を持つ。人間を特に嫌っている訳ではないが、文明生活には否定的。"},{"spoiler":false,"text":"器の大きな姉には多少、コンプレックスを抱いている。姉よりせめて戦闘では強くあろうとするあまり、武人っぽい口調態度が目立つ。"}],"source":"bangumi","sourceCharacterId":"205568"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/0573b367154c9ab767e3f54701f62bf3f532d45f2287a0157f93624cf0e86b10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51cc89b86e2c03f618479a547b355d60e8f27476074e6442d9d80d78e02cd685.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井ありす","creatorId":"vndb:s1626","sourcePersonId":"vndb:s1626","canonicalEntityId":"vndb:s1626","name":"櫻井 ありす","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223733:205568:19213:1","source":"bangumi"}]},{"characterId":"char_c27285","characterName":"クレア","sourceIds":{"bangumi":[{"characterId":"205569","match":"exact-normalized-name-in-linked-work","subjectId":"223733"}],"egsCharacterIds":["18829"],"vndbCharacterId":"c27285"},"originalCharacterName":"クレア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"エルフの王女姉妹に仕える世話係。"},{"spoiler":false,"text":"人間たちの横暴によって故郷の森を追われた幼少の記憶がトラウマとなり、人間嫌いになっている。"},{"spoiler":false,"text":"そうしたことから、結界の森に足を踏み入れた主人公に矢を放ち、怪我を負わせる。"},{"spoiler":false,"text":"純粋で思い込みが激しい性格。"},{"spoiler":false,"text":"「お姉さま」と呼んで強く慕う王女姉妹が、嫌いな人間と一緒になることにあからさまに不満な態度を示し、王女姉妹から主人公を引き離そうと色々と策を講じるが、それが裏目になってしまう。"}],"source":"egs","sourceCharacterId":"18829","sourceWorkId":"10358","spoiler":false},{"segments":[{"spoiler":false,"text":"シェーラ、アイラの側に仕える少女。"},{"spoiler":false,"text":"幼い頃に故郷を追われた記憶が鮮明なため、人間嫌いになっている。そのため、結界の森に足を踏み入れた温を攻撃、怪我を負わせる。"},{"spoiler":false,"text":"シェーラ、アイラの事をお姉様と呼び、強く慕っている。特にアイラからは武芸を学び、特に親しい。"},{"spoiler":false,"text":"純粋で思い込みの激しい性格。嫉妬からシェーラ達と温を引き離そうとし、彼を脅しつけて森から逃亡させるも、結果、彼の家での同居生活というさらに思惑から外れる結果を招いてしまう。"}],"source":"bangumi","sourceCharacterId":"205569"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd9a1e49cc8d0a6927385388af7a6d4b97844a1f7fa38dc2efabae6a3e07236b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39658d8b13d64f42225bac51d236125092adbf182d8792588661ef7d08712df4.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c27286","characterName":"父王","sourceIds":{"vndbCharacterId":"c27286"},"originalCharacterName":"父王","characterNameSource":null,"role":"side","status":"source-only-can