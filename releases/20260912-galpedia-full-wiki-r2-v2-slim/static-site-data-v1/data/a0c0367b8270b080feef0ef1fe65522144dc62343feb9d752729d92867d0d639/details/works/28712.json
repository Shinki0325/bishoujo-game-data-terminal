:"static-detail"},"actors":[{"creditedName":"井口裕香","creatorId":"vndb:s3971","sourcePersonId":"vndb:s3971","canonicalEntityId":"vndb:s3971","name":"井口 裕香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:274531:86990:4851:1","source":"bangumi"}]},{"characterId":"char_bangumi_86991","characterName":"Cecile","sourceIds":{"bangumi":[{"characterId":"86991","match":"source-roster","subjectId":"274531"}]},"originalCharacterName":"Cecile","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"马丁的弟弟，十分憧憬侦探，是个天真无邪的少年。"},{"spoiler":false,"text":"由于丰富的妄想力和旺盛的好奇心，他总是会将任何事情都看做案件。和主角很合得来。"},{"spoiler":false,"text":"随着年纪渐长，和哥哥谈话的机会也越来越少，因此猜想着对方是不是想和自己拉开距离。不过他其实非常喜欢哥哥。"},{"spoiler":false,"text":"想亲自找到下落不明的双亲，所以才希望能成为侦探。"}],"source":"bangumi","sourceCharacterId":"86991"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d3cf482338c312af9f711b2c4ae1d9d3c59a3bfcdcb6676556e47f6b6d2afbc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/4226b05aa652d4b4afd5fb6a6a622cb39851b658d305ac8f6f350babf974b89d.webp","width":163,"height":256,"source":"static-detail"},"actors":[{"creditedName":"村瀬歩","creatorId":"vndb:s86","sourcePersonId":"vndb:s86","canonicalEntityId":"vndb:s86","name":"村瀬 歩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:274531:86991:8253:1","source":"bangumi"}]},{"characterId":"char_bangumi_95720","characterName":"Fuqua","sourceIds":{"bangumi":[{"characterId":"95720","match":"source-roster","subjectId":"274531"}]},"originalCharacterName":"Fuqua","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStat