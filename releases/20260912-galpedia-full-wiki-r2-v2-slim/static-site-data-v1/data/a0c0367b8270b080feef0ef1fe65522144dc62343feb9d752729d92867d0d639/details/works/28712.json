bf9053775b8eee1913db36b5c52cec9ebe9df.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f87ca06922becd07e75e009f129df13362cc52177fdbc73dd97fba7a302e95d.webp","width":169,"height":256,"source":"static-detail"},"actors":[{"creditedName":"武内駿輔","creatorId":"vndb:s10963","sourcePersonId":"vndb:s10963","canonicalEntityId":"vndb:s10963","name":"武内 駿輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:274531:95721:16361:1","source":"bangumi"}]},{"characterId":"char_bangumi_95722","characterName":"Ludmila","sourceIds":{"bangumi":[{"characterId":"95722","match":"source-roster","subjectId":"274531"}]},"originalCharacterName":"Ludmila","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"为爱而活的梦魔女孩。"},{"spoiler":false,"text":"喜欢极限状况下的快感。总之就是非常迷恋主角。"},{"spoiler":false,"text":"虽然看起来随心所欲又任性，但其实很有原则，本质相当认真。"},{"spoiler":false,"text":"曾因为身为梦魔而带给他人不幸，所以和周遭的人们相处时，总是会保持着一定的距离。"}],"source":"bangumi","sourceCharacterId":"95722"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/840b896513f3c535dcb1511da28bb5f102d6c2d1ba10d8e8e963342594405af2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0c25179086b601bb10c04e0eef4f7a329b214eab6af20f493081c109e2d3bf7.webp","width":193,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_95723","characterName":"Lucas","sourceIds":{"bangumi":[{"characterId":"95723","match":"source-roster","subjectId":"274531"}]},"originalCharacterName":"Lucas","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"作为神祕旅人出现在镇上的、丧失记忆的绅士。"},{"spoiler":false,"text":"对任何事情都很有兴趣，且会积极地付出行动。"},{"spoiler":false,"text":"只要看到有兴趣的东西就会记录在笔记本上，所以有可能是为了进行某种调查才会来到这个小镇。"},{"spoiler":false,"text":"虽然丧失了记忆，但他拥有渊博的知识，也能够完美地鉴定矿石等物品。"}],"source":"bangumi","sourceCharacterId":"95723"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a00816b721977a948a42d8c8ba21a01de20ab86bec14e728d35aba56d9dfe008.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fdcdf4e873bef4ecd1cef7b999c7e66188963f61b7986b0f2d9ed8ee44ffcd0b.webp","width":82,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森久保祥太郎","creatorId":"vndb:s381","sourcePersonId":"vndb:s381","canonicalEntityId":"vndb:s381","name":"森久保 祥太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:274531:95723:4166:1","source":"bangumi"}]},{"characterId":"char_bangumi_95724","characterName":"Beatrice","sourceIds":{"bangumi":[{"characterId":"95724","match":"source-roster","subjectId":"274531"}]},"originalCharacterName":"Beatrice","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"诺鲁德王国的关系人士，隐藏真实身分的大小姐。"},{"spoiler":false,"text":"虽然不食人间烟火，但责任感非常强。不只能够演奏乐器，也很擅长驾驭魔物的骑术，在各方面都有着出色的才能。"},{"spoiler":false,"text":"本来并不打算与居民深入交流，只想在完成使命后尽速踏上归途，但在与主角相遇后，开始感受到居民们的温柔，心境也因此渐渐有所改变。"}],"source":"bangumi","sourceCharacterId":"95724"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c47cb115ad952a59ff630286f0717d947913e85cfa9b4e1a801d63e23fd70e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69f3fda98c1bfad6d1cd023d1f284190baabbd3c79d31c36d67d3ede4f714a34.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黒沢ともよ","creatorId":"vndb:s10496","sourcePersonId":"vndb:s10496","canonicalEntityId":"vndb:s10496","name":"黒沢 ともよ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:274531:95724:9560:1","source":"bangumi"}]},{"characterId":"char_bangumi_95725","characterName":"Lyka","sourceIds":{"bangumi":[{"characterId":"95725","match":"source-roster","subjectId":"274531"}]},"originalCharacterName":"Lyka","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"没办法反抗师傅的见习工匠。"},{"spoiler":false,"text":"手指灵巧且反应也很快，不过和马丁合不来。"},{"spoiler":false,"text":"经常被长辈说教，且很容易被年龄小的孩子视作对等的朋友。"},{"spoiler":false,"text":"虽然白天时总是看起来没什么精神，但到了夜晚就会展现出帅气的一面。"}],"source":"bangumi","sourceCharacterId":"95725"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/898704e1e8989f72635e19af3ef3dbffdb5763b336e183e348d305c88d762ec4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8caf2188918959df6a5c0e370f67e2705a42605e833a4daa193774d375b54655.webp","width":127,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松岡禎丞","creatorId":"vndb:s748","sourcePersonId":"vndb:s748","canonicalEntityId":"vndb:s748","name":"松岡 禎丞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:274531:95725:5764:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:966","sourceCompanyId":"egs:brand:966","canonicalEntityId":"egs:brand:966","name":"マーベラス(マーベラスエンターテイメント、マーベラスAQL)"