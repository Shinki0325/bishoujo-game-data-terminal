40428","name":"小山 愛加","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:177705","source":"vndb"},{"creditedName":"湊 貴大","creatorId":"vndb:s40980","sourcePersonId":"vndb:s40980","canonicalEntityId":"vndb:s40980","name":"湊 貴大","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:177707","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c122154","characterName":"藤原 泰衡","sourceIds":{"vndbCharacterId":"c122154"},"originalCharacterName":"藤原 泰衡","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Son of Fujiwara Hidehira, head of the Oshu Fujiwara clan."},{"spoiler":false,"text":"He considers the life of his father Hidehira, the head of the Fujiwara clan, to be absolute."},{"spoiler":false,"text":"However, in contrast to his father, who welcomes him to Hiraizumi, he casts a cold eye on Shanao, whom he regards as a nuisance."},{"spoiler":false,"text":"His honest nature makes him a difficult person to deal with."}],"source":"vndb","sourceCharacterId":"c122154"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/413c65f53a58c37ede957b97ce740d364dc63098f3c55d616fa272234c30862f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4aa9fc0ce58ef8fbf658a000d289c476c2485a0501e1035462aaa6de6ab0157.webp","width":220,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c122155","characterName":"藤原秀衡","sourceIds":{"vndbCharacterId":"c122155"},"originalCharacterName":"藤原秀衡","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Third head of the Oshu Fujiwara clan."},{"spoiler":false,"text":"He governs Oshu, which is far from the capital, and has a huge power of his own that is beyond the reach of the Heike clan."},{"spoiler":false,"text":"He is a man of character with a deep Buddhist faith, a calm atmosphere and a bold personality, and is always devoted to the good of his clan."},{"spoiler":false,"text":"He wants to welcome Shanao, the orphaned son of the Minamoto clan, to Oshu, but he also wants him to live as he wishes."}],"source":"vndb","sourceCharacterId":"c122155"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/3027df7ae21b81fc86c3a8f6f8d866c6a342ab4a9d8706fe87910ddd29379ef5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/053572f8a2fcc57579ec108a522ac231d339f3c6c641e300956ac5f49993966e.webp","width":220,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c74607","characterName":"源 頼朝","sourceIds":{"vndbCharacterId":"c74607"},"originalCharacterName":"源 頼朝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"29"},"height":{"reviewState":"source-only","source":"vndb","value":"183"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Born the youngest son of Yoshitomo Minamoto, Yoritomo's father and older brothers were all killed by the Heike in the Heiji Rebellion. Just fourteen at the time, Yoritomo's life was spared from execution by Kiyomori Taira's step-mother, Lady Ikenozeni."},{"spoiler":false,"text":"Instead, Yoritomo was forced to live the hard life of an exile in the land of Izu. After many lonely years, Yoritomo's heart became cold and isolated. Now he lives with only a single mission, a mission for which he will risk his life: to restore the Genji Clan with himself as its leader."}],"source":"vndb","sourceCharacterId":"c74607"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/2399fe77d165e902b787b5dcf3045b8c70d6c3b049dfd6536f0a3c5fbb57bfbf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7eb41abe98e4efc96ab82b957806eaba055059714de5546d8d0bc97ee04dda2b.webp","width":220,"height":256,"source":"static-detail"},"actors":[{"creditedName":"古川 慎","creatorId":"vndb:s7848","sourcePersonId":"vndb:s7848","canonicalEntityId":"vndb:s7848","name":"古川 慎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89210","source":"vndb"}]},{"characterId":"char_vndb_c74608","characterName":"武蔵坊 弁慶","sourceIds":{"vndbCharacterId":"c74608"},"originalCharacterName":"武蔵坊 弁慶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"30"},"height":{"reviewState":"source-only","source":"vndb","value":"189"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Previously a monk at Mount Hiei, Benkei was expelled from that temple after an incident with the Heike. Since then, he has been stealing the swords of Heike officials in response. After being defeated by Shanao, he pledged to become Shanao's vassal."},{"spoiler":false,"text":"Kind, gentle, and good-natured, Benkei and Shanao both share a history of growing up in temples and a dissatisfaction with the brutal rule of the Heike."}],"source":"vndb","sourceCharacterId":"c74608"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed333f54609a41caca6582828ccabc78bf5bfde907122ee649786ccbe7afd9a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b04056dbc5c22e7134644eefad7945c542db9d488eac65bbfd3b8d0bc38fe5e7.webp","width":219,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梅原 裕一郎","creatorId":"vndb:s8034","sourcePersonId":"vndb:s8034","canonicalEntityId":"vndb:s8034","name":"梅原 裕一郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89211","source":"vndb"}]},{"characterId":"char_vndb_c74609","characterName":"平 知盛","sourceIds":{"vndbCharacterId":"c74609"},"originalCharacterName":"平 知盛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"23"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Fourth son of Kiyomori Taira, and graceful in both words and appearances. From the outside he would appear to have little use for war, however, he has time and time again demonstrated himself to be a fierce warrior, a superb general, and a trusted advisor to Kiyomori."},{"spoiler":false,"text":"Though the Heike appear to be at the height of their power, Tomomori senses a change in the wind, and knows that all things in this world are one day bound to perish."}],"source":"vndb","sourceCharacterId":"c74609"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fdb44b818fac2520e88478021633e998df65c89b91571cd5bc68f662d30dd9ea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/929210e754b527e0457244723dd56498b6989e0178ad1c66684b011cc494edca.webp","width":219,"height":256,"source":"static-detail"},"actors":[{"creditedName":"福山 潤","creatorId":"vndb:s393","sourcePersonId":"vndb:s393","canonicalEntityId":"vndb:s393","name":"福山潤","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89207","source":"vndb"}]},{"characterId":"char_vndb_c74610","characterName":"平 教経","sourceIds":{"vndbCharacterId":"c74610"},"originalCharacterName":"平 教経","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"height":{"reviewState":"source-only","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nephew of Kiyomori Taira, and son of Norimori Taira, Noritsune holds nothing but contempt for the soft, decadent clan the Heike has become. Though he may not like the present aristocratic nature of his clan, he takes deep pride in his role as a samurai and is said to be one of the clan's finest warriors. Unlike Tomomori, Noritsune does not see the gathering storm on the horizon for the Heike."},{"spoiler":false,"text":"Being the same age as Shanao, he feels a deep sense of competition with her."}],"source":"vndb","sourceCharacterId":"c74610"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61b113f1dbdc370afd991e08f3f119f10e2c3e69ec4007095bc0a8038544a65b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/4590e7c4930506d63cff0dca8d92747ef7f20b3a2d1ce381b882fe6e890f4392.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"河西 健吾","creatorId":"vndb:s5932","sourcePersonId":"vndb:s5932","canonicalEntityId":"vndb:s5932","name":"河西健吾","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89209","source":"vndb"}]},{"characterId":"char_vndb_c74611","characterName":"春玄","sourceIds":{"vndbCharacterId":"c74611"},"originalCharacterName":"春玄","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Born a child of Shigenari Minamoto, a vassal of Shanao's father, Yoshitomo Minamoto, Shungen was brought to Kurama Temple upon the death of his father at the same time as Shanao. Because the two have been together since they were very young, Shungen is aware that Shanao is a woman."},{"spoiler":false,"text":"Like Shanao, Shungen was raised at Kurama Temple by Kakunichi. While not as skilled with a sword as Shanao, Shungen is extremely bright and well-read. Despite his small stature and kind appearances, Shungen is extremely brave and protective of Shanao."}],"source":"vndb","sourceCharacterId":"c74611"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9bdc38b387f9b3fdb9b8788328012e8436631b3d86d2bcb09e88b6240ee3dc8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b127e3101747f4785e024674cd0bf4d6c556bb0fb24f1ff0e797bb3a4fb3e149.webp","width":207,"height":256,"source":"static-detail"},"actors":[{"creditedName":"斉藤 壮馬","creatorId":"vndb:s5499","sourcePersonId":"vndb:s5499","canonicalEntityId":"vndb:s5499","name":"斉藤 壮馬","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89208","source":"vndb"}]},{"characterId":"char_vndb_c74612","characterName":"遮那王","sourceIds":{"vndbCharacterId":"c74612"},"originalCharacterName":"遮那王","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"height":{"reviewState":"source-only","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Born the youngest daughter of Yoshitomo Minamoto, Shanao was brought to Kurama Temple upon the death of her father in the Heiji Rebellion. There, the monks were instructed to raise her as a boy who could one day grow strong enough to overthrow the Heike."},{"spoiler":false,"text":"Trained and raised by Kakunichi, Shanao exceled in matters of military strategy and in combat."},{"spoiler":false,"text":"Despite the expectations of those around her, Shanao has always dreamed of a quiet, peaceful life. Having been torn away from her family at a very young age, she yearns for the love of a family."}],"source":"vndb","sourceCharacterId":"c74612"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60a0ab9baadf853a82bdca54dd8b0db769d8e88e5928ada23ada2cb1ec48ec57.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5db9105152036f35975ae5315418f33e5e1fdd2c4314b4f8b8c9577b42fff05d.webp","width":219,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c90012","characterName":"平 重衡","sourceIds":{"vndbCharacterId":"c90012"},"originalCharacterName":"平 重衡","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Fifth child of Kiyomori Taira and brother of Tomomori. Despite his regal appearances and renowned abilities in the arts, Shigehira has a sinister side as well, particularly on the battlefield. Concerned less with victory and more with the blood he spills, Shigehira has a reputation for taking delight in carnage."},{"spoiler":false,"text":"Not much concerned with the future, Shigehira instead sets his sights on enjoying the present as much as possible. Despite his savage reputation, his love and respect for his brother Tomomori is well known."}],"source":"vndb","sourceCharacterId":"c90012"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8747090b10aecff914fced7c4a4bd69f2c78beae77ec40d274773a59d07e60f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04467521176ff57ca5b6fcc68c72abae7585a7c52466e1bc7e1bb0105e36fb00.webp","width":219,"height":256,"source":"static-detail"},"actors":[{"creditedName":"逢坂 良太","creatorId":"vndb:s248","sourcePersonId":"vndb:s248","canonicalEntityId":"vndb:s248","name":"逢坂 良太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89206","source":"vndb"}]},{"characterId":"char_vndb_c90013","characterName":"佐藤 継信","sourceIds":{"vndbCharacterId":"c90013"},"originalCharacterName":"佐藤 継信","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsugunobu is a highly regarded samurai in service of the Fujiwara clan of Oshu. Upon orders from Lord Hidehira Fujiwara, Tsugunobu joins Shanao on her journey and vows to serve with his life."},{"spoiler":false,"text":"His loyalty to Shanao comes not only from his vow to serve her, but also from his personal attachment to Shanao. Soft-spoken and wise, he also has a dark side, especially when it comes to his younger brother."}],"source":"vndb","sourceCharacterId":"c90013"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae084112ab570d98eb533482325995bba35fca4c0e22ba6e448fd31701b26c87.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/911256f35ccfc8f641b9ec7beca909e1ebb8b972b1d5cab14815078274598dfd.webp","width":219,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近藤 隆","creatorId":"vndb:s72","sourcePersonId":"vndb:s72","canonicalEntityId":"vndb:s72","name":"近藤 隆","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89205","source":"vndb"}]},{"characterId":"char_vndb_c90014","characterName":"佐藤 忠信","sourceIds":{"vndbCharacterId":"c90014"},"originalCharacterName":"佐藤 忠信","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsugunobu's younger brother and fellow vassal of first Lord Hidehira Fujiwara and later, Shanao. Brave to a fault, his presence on the battlefield always leaves his enemies defeated and his allies inspired."},{"spoiler":false,"text":"Though not the sharpest tool in the shed, Tadanobu has a bright, charming personality, one that occasionally leads him to speak too plainly to Lord Shanao."}],"source":"vndb","sourceCharacterId":"c90014"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9f226baef7334c8c173980f126a03f02e391c079903cc6992e2c9f4cfe7650e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87dac76b2ef18156224109317eaff43ef066d15385d5449134258963f5413e74.webp","width":215,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小西 克幸","creatorId":"vndb:s65","sourcePersonId":"vndb:s65","canonicalEntityId":"vndb:s65","name":"小西 克幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89204","source":"vndb"}]},{"characterId":"char_vndb_c90015","characterName":"佐々木 高綱","sourceIds":{"vndbCharacterId":"c90015"},"originalCharacterName":"佐々木 高綱","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Son of Hideyoshi Sasaki, who once served under Yoritomo and Shanao's father, Takatsuna was ordered to follow in his father's footsteps and serve as a vassal to Lord Yoritomo."},{"spoiler":false,"text":"Despite his young age, he has shown a strong ability to serve the Genji on and off the battlefield. His bright and innocent smile is known to bring joy to all those who see it."}],"source":"vndb","sourceCharacterId":"c90015"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/538718ce50dd09ed066176b7ab0a82ceb6c1b43442d2f0f5deb88bb01aed381e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a26cf60de40cb9df783a689952d33621cbadbd924da5a9c9596ea973e11633b8.webp","width":220,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天月","creatorId":"vndb:s20953","sourcePersonId":"vndb:s20953","canonicalEntityId":"vndb:s20953","name":"天月","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89212","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p589","sourceCompanyId":"egs:brand:2924","canonicalEntityId":"vndb:p589","name":"オトメイト","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:31857:2924","source":"egs"},{"companyId":"vndb:p352","sourceCompanyId":"vndb:p352","canonicalEntityId":"vndb:p352","name":"アイディアファクトリー株式会社","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:106096:v32229","source":"vndb"},{"companyId":"vndb:p589","sourceCompanyId":"vndb:p589","canonicalEntityId":"vndb:p589","name":"オトメイト","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:106097:v32229","source":"vndb"},{"companyId":"vndb:p1078","sourceCompanyId":"vndb:p1078","canonicalEntityId":"vndb:p1078","name":"株式会社レッド・エンタテインメント","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:106098:v32229","source":"vndb"},{"companyId":"vndb:p352","sourceCompanyId":"vndb:p352","canonicalEntityId":"vndb:p352","name":"アイディアファクトリー株式会社","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:106099:v32229","source":"vndb"},{"companyId":"vndb:p589","sourceCompanyId":"vndb:p589","canonicalEntityId":"vndb:p589","name":"オトメイト","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:106100:v32229","source":"vndb"},{"companyId":"vndb:p1078","sourceCompanyId":"vndb:p1078","canonicalEntityId":"vndb:p1078","name":"株式会社レッド・エンタテインメント","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:106101:v32229","source":"vndb"},{"companyId":"vndb:p9333","sourceCompanyId":"vndb:p9333","canonicalEntityId":"vndb:p9333","name":"傑仕登","roleCodes":["publisher"],"identityStatus":"source-native","relationId":