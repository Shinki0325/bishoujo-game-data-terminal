{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"31850","model":{"presentationWorkId":"vndb:v28792","staff":{"artwork":[{"creditedName":"Wanaca","creatorId":"vndb:s5464","sourcePersonId":"egs:creator:29612","canonicalEntityId":"vndb:s5464","name":"Wanaca","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:241542","source":"egs"},{"creditedName":"フェイトリネ-アルファ","creatorId":"vndb:s11936","sourcePersonId":"vndb:s11936","canonicalEntityId":"vndb:s11936","name":"フェイトリネ-アルファ","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:167792","source":"vndb"}],"scenario":[{"creditedName":"Waffle","creatorId":"vndb:s29887","sourcePersonId":"egs:creator:37441","canonicalEntityId":"vndb:s29887","name":"Waffle","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:241543","source":"egs"}],"music":[{"creditedName":"Zack Parrish","creatorId":"vndb:s12287","sourcePersonId":"vndb:s12287","canonicalEntityId":"vndb:s12287","name":"Zack Parrish","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:167793","source":"vndb"}],"other":[{"creditedName":"Marcel Weyers","creatorId":"vndb:s3735","sourcePersonId":"vndb:s3735","canonicalEntityId":"vndb:s3735","name":"Marcel Weyers","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:167788","source":"vndb"},{"creditedName":"Steven Korkowsky","creatorId":"vndb:s28603","sourcePersonId":"vndb:s28603","canonicalEntityId":"vndb:s28603","name":"Steven Korkowsky","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:167789","source":"vndb"},{"creditedName":"Wanaca","creatorId":"vndb:s5464","sourcePersonId":"vndb:s5464","canonicalEntityId":"vndb:s5464","name":"Wanaca","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:167790","source":"vndb"},{"creditedName":"Waffle","creatorId":"vndb:s29887","sourcePersonId":"vndb:s29887","canonicalEntityId":"vndb:s29887","name":"Waffle","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:167794","source":"vndb"},{"creditedName":"Exilim","creatorId":"vndb:s29888","sourcePersonId":"vndb:s29888","canonicalEntityId":"vndb:s29888","name":"Exilim","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:167795","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c106183","characterName":"Youyi","sourceIds":{"vndbCharacterId":"c106183"},"originalCharacterName":"Youyi","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yue is the queen of the succubus realm, and she certainly acts like it. Aloof, haughty, and dignified, Yue simply oozes feminine grace and poise that some of the other succubi can only dream of."},{"spoiler":false,"text":"Yue might be young, but she is a force to be reckoned with, and she knows just how to get what she wants: Hiroki included."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c106183"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/129885d89b44ecf96630b65a2fdff263a311fc8d8667972c40fe5e23367c26b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77bed978dbde0565cde1aa0e3afb375156b65af435919b2ed84eb3a9bfca6291.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c90098","characterName":"Ikue Ayu","sourceIds":{"vndbCharacterId":"c90098"},"originalCharacterName":"Ikue Ayu","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ayu is a super famous idol whose name is known across Japan. She’s revered for her cute stage persona and her seemingly humble nature. During her concerts, she never fails to thank her fans, and her enthusiasm is contagious!"},{"spoiler":false,"text":"...That’s just how it appears, however. Deep down, Ayu is a scheming vixen who regards her fans as mere stepping stones, and values money above all else. She’s so avaricious, she claims to be ‘moneysexual’, and she spurns the advances of men…"},{"spoiler":false,"text":"At least, she did, until she met Hiroki."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c90098"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61621fd06beeeac8d9d0ed5536a8c927d4273bd46758c111aa9f9c920d8b5b05.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b67918e9ac2455057bac1c05962e8972684b8e8f928f4b4ac59ae50ed81d6e79.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c90099","characterName":"Cosmos Moretti","sourceIds":{"vndbCharacterId":"c90099"},"originalCharacterName":"Cosmos Moretti","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Cosmos is a popular social media star, with over three million followers on RapidPound. Cosmos shot to stardom after posting a series of semi-nude photos of herself online, which went viral. Since then, she’s been revered as the sexiest, most daring RapidPounder of all time."},{"spoiler":false,"text":"Though Cosmos dresses and acts in a provocative manner, this isn’t entirely intentional. At heart, she’s a naïve girl, with no genuine understanding of the effect her half-naked body elicits in the opposite (and, in some cases, same) sex. This often gets her in trouble, though she can’t fathom why."},{"spoiler":false,"text":"Cosmos is known for lewd photos, but she’s a sweetheart who believes in true love. She dreams of one day meeting a handsome prince who’ll sweep her off her feet."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c90099"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6c4550a50bbaa33b942a01a7cdf61f3c51904e40c25e78f9ce038fb6fbecf2d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac5db4dc89b81d445dfa38107cecba907004b2d6dcd4591ada673d10fa1a998d.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c90100","characterName":"Wakatsuki Marina","sourceIds":{"vndbCharacterId":"c90100"},"originalCharacterName":"Wakatsuki Marina","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"31"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Marina is a wealthy businesswoman who owns a well-known clothing company. Though she’s only thirty-one, she’s one of the richest women in Japan, and she’s respected by men and woman more than twice her age."},{"spoiler":false,"text":"Marina is a coolly confident beauty. She isn’t the sort to fluster easily, and she has no qualms about taking whatever she wants. She’s domineering, with a sadistic streak, but she has a motherly side, and she’s good at dispensing advice."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c90100"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23db076815a74a5c79715214294ee18ac3b1cefdf33dc453ebf363ed9f4d67da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3df50db9b0e57b0b77a07cb6f7493428eccdb0332640c4f8c54f0bff9df776ff.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c91913","characterName":"Yamamoto Hifumi","sourceIds":{"vndbCharacterId":"c91913"},"originalCharacterName":"Yamamoto Hifumi","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hifumi is an actress who has been a staple of the Japanese movie industry since the tender age of eighteen. Now a veteran, with many years on the silver screen under her belt, her name is a household one, and she has legions of fans across the globe."},{"spoiler":false,"text":"Hifumi is a refined, elegant woman who loves all things quintessentially Japanese. The very definition of a ‘Yamato Nadeshiko’, Hifumi is diligent, caring, and incredibly good at cooking…"},{"spoiler":false,"text":"But, for some reason, Ayu and Cosmos seem to distrust her. Perhaps there’s more behind her sweet smile than she lets on?"},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c91913"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d70c802cc19d34dc1548de78317925da0300889b9744c0fe7d7b54e388b761c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12a25a251fee00b1bdb792e211975f298f374b68f4dfe6601b05c7a9b44da736.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c91914","characterName":"Hazel Williams","sourceIds":{"vndbCharacterId":"c91914"},"originalCharacterName":"Hazel Williams","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hazel is an up-and-coming tennis star born from a Japanese mother and an American father. A cheerful and energetic girl, Hazel approaches life with nothing less than 110%, and she’s almost always seen with a blinding smile."},{"spoiler":false,"text":"Though relatively young, she demands a captive audience during every match, and has quite the fanbase. She’s so bubbly, it really is impossible to hate her!"},{"spoiler":false,"text":"There are several curious rumors circulating about her online, however, which catch Hiroki’s interest. Hazel’s hiding far more than her wide grin suggests!"},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c91914"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12a3ca8d9ae900e34a756062b719afd27f52a6a336b2a98e38af060fb4c57090.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6b8e575d6258c0ddb3916bc3f07853dda5eea798ea5415bc61016f7e38fe3ee.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c92024","characterName":"Ogasawara Hiroki","sourceIds":{"vndbCharacterId":"c92024"},"originalCharacterName":"Ogasawara Hiroki","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"29"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3fb64689a895a0c83f5dec6f8b759f21064d917537e8541db8c40a7b4b223fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96437350b6e22fe48afaff1e55057b0dc824b20661608b57df48d08f5049bac5.webp","width":256,"height":172,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p4019","sourceCompanyId":"egs:brand:4611","canonicalEntityId":"vndb:p4019","name":"Winged Cloud","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:31850:4611","source":"egs"},{"companyId":"vndb:p4019","sourceCompanyId":"vndb:p4019","canonicalEntityId":"vndb:p4019","name":"Winged Cloud","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:114388:v28792","source":"vndb"},{"companyId":"vndb:p18672","sourceCompanyId":"vndb:p18672","canonicalEntityId":"vndb:p18672","name":"iqdhk8t0hxww","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:132295:v28792","source":"vndb"},{"companyId":"vndb:p4019","sourceCompanyId":"vndb:p4019","canonicalEntityId":"vndb:p4019","name":"Winged Cloud","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:81971:v28792","source":"vndb"},{"companyId":"vndb:p4019","sourceCompanyId":"vndb:p4019","canonicalEntityId":"vndb:p4019","name":"Winged Cloud","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:82064:v28792","source":"vndb"},{"companyId":"vndb:p10846","sourceCompanyId":"vndb:p10846","canonicalEntityId":"vndb:p10846","name":"Eromangá","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:85981:v28792","source":"vndb"},{"companyId":"vndb:p11862","sourceCompanyId":"vndb:p11862","canonicalEntityId":"vndb:p11862","name":"Gamuzumi","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:89190:v28792","source":"vndb"},{"companyId":"vndb:p11862","sourceCompanyId":"vndb:p11862","canonicalEntityId":"vndb:p11862","name":"Gamuzumi","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:89261:v28792","source":"vndb"},{"companyId":"vndb:p13609","sourceCompanyId":"vndb:p13609","canonicalEntityId":"vndb:p13609","name":"SilverCrow41","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:98996:v28792","source":"vndb"},{"companyId":"vndb:p13609","sourceCompanyId":"vndb:p13609","canonicalEntityId":"vndb:p13609","name":"SilverCrow41","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:99115:v28792","source":"vndb"}],"missingStates":["confirmed-character-relation-missing"],"source":"terminal-wiki-full-runtime-v7"}}
