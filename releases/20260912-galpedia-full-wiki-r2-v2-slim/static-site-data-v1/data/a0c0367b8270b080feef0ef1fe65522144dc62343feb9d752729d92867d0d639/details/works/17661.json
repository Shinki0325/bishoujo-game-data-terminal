":"vndb:vn-staff:10897","source":"vndb"},{"creditedName":"内野 ぽち","creatorId":"vndb:s1172","sourcePersonId":"vndb:s1172","canonicalEntityId":"vndb:s1172","name":"岩村 琴美","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:10898","source":"vndb"}]},"cast":[{"characterId":"char_c11191","characterName":"飯井原 なお","sourceIds":{"bangumi":[{"characterId":"44423","match":"exact-normalized-name-in-linked-work","subjectId":"87626"}],"egsCharacterIds":["22654"],"vndbCharacterId":"c11191"},"originalCharacterName":"飯井原 なお","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"O"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"108"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"165cm"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"65"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"58kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female student at the school."},{"spoiler":false,"text":"She is a cousin of the main character and Toruko. When she was a child, she was weak, she was in and out of the hospital where the main character's parents lived. She is healthy now. The protagonist used to take good care of her."},{"spoiler":false,"text":"She has had feelings for the protagonist since then, and still adores him. Although she is always fidgety, she has a positive and kind-hearted personality."},{"spoiler":false,"text":"She is a stubborn person who goes at her own pace. She is also a clumsy girl."},{"spoiler":false,"text":"She is more worried about her own pace than herself. In reality, however, Mitsugu follows her when she tends to go out of control."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c11191"},{"segments":[{"spoiler":false,"text":"【胸の大きさと元気のよさなら誰にも負けない！】"},{"spoiler":false,"text":"身長:167cm　体重:58kg　血液型:O型"},{"spoiler":false,"text":"スリーサイズ:B108/W65/H93"},{"spoiler":false,"text":"デカメロン型。Ｊカップ。"},{"spoiler":false,"text":"奄那土島で偶然イトコのなおに再会した大介。"},{"spoiler":false,"text":"以前から大介ラヴ！　ななおは、ここぞとばかりに猛アタックを開始。"},{"spoiler":false,"text":"大介に想いを寄せる、なおの親友みつぐも絡んできて、恋のさやあてもかなりエッチにヒートアップ！"},{"spoiler":false,"text":"なおの能天気なテンションに押され、セックス三昧の日々を送る大介は、"},{"spoiler":false,"text":"――「こんなんでいいのだろうか……」と自嘲の溜息。"}],"source":"egs","sourceCharacterId":"22654"},{"segments":[{"spoiler":false,"text":"学園の女学生。主人公や透子とは従妹にあたる。"},{"spoiler":false,"text":"子供の頃は体が弱く、主人公の実家である病院へ入退院を繰り返していた。"},{"spoiler":false,"text":"当時からよく面倒を見てくれた主人公に想いを寄せており、現在もその気持ちは変わりない。"},{"spoiler":false,"text":"何かとそそっかしくはあるが、前向きで心優しい性格。"},{"spoiler":false,"text":"マイペースで頑固な一面も。"},{"spoiler":false,"text":"だが自分以上にマイペースなみつぐのことを心配している。"},{"spoiler":false,"text":"しかし結果的には実際には暴走しがちな彼女をみつぐがフォローしている状況。"}],"source":"egs","sourceCharacterId":"22654","sourceWorkId":"3945","spoiler":false},{"segments":[{"spoiler":false,"text":"【胸の大きさと元気のよさなら誰にも負けない！】"},{"spoiler":false,"text":"身長:167cm　体重:58kg　血液型:O型"},{"spoiler":false,"text":"スリーサイズ:B108/W65/H93"},{"spoiler":false,"text":"デカメロン型。Ｊカップ。"},{"spoiler":false,"text":"奄那土島で偶然イトコのなおに再会した大介。"},{"spoiler":false,"text":"以前から大介ラヴ！　ななおは、ここぞとばかりに猛アタックを開始。"},{"spoiler":false,"text":"大介に想いを寄せる、なおの親友みつぐも絡んできて、恋のさやあてもかなりエッチにヒートアップ！"},{"spoiler":false,"text":"なおの能天気なテンションに押され、セックス三昧の日々を送る大介は、"},{"spoiler":false,"text":"――「こんなんでいいのだろうか……」と自嘲の溜息。"}],"source":"egs","sourceCharacterId":"22654","sourceWorkId":"7172","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の女学生。"},{"spoiler":false,"text":"主人公や透子とはいとこにあたる。 子供の頃は体が弱く、"},{"spoiler":false,"text":"主人公の実家である病院へ入退院を繰り返していた。"},{"spoiler":false,"text":"今は健康。主人公には、よく面倒を見てもらっていた。"},{"spoiler":false,"text":"当時から主人公に思いを寄せ、今も慕っている。"},{"spoiler":false,"text":"何かとそそっかしくはあるが、前向きで心優しい性格。"},{"spoiler":false,"text":"マイペースで、頑固者。そしてドジっ子。"},{"spoiler":false,"text":"自分以上にマイペースなみつぐのことを心配している。"},{"spoiler":false,"text":"しかし実際には暴走しがちな彼女をみつぐがフォローしている。"}],"source":"bangumi","sourceCharacterId":"44423"}],"profileFacts":[],"metadataCandidateConflicts":{"bust":[{"comparisonValue":"102","source":"vndb","sourceCharacterId":"c11191","value":"102"},{"comparisonValue":"102","scope":"sourceWork","source":"egs","sourceCharacterId":"22654","sourceWorkId":"3945","value":"102"},{"comparisonValue":"108","scope":"sourceWork","source":"egs","sourceCharacterId":"22654","sourceWorkId":"7172","value":"108"},{"comparisonValue":"108","source":"bangumi","sourceCharacterId":"44423","value":"108"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90e6594d0abaf1b8a23ca45defbcb89eda8146431374b349df1334800fd72e38.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8ffe27738164dcbb7b49ece2f501b9df20667bb3a1e9421e7096aaabc4b6da71.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:87626:44423:6106:1","source":"bangumi"}]},{"characterId":"char_c11193","characterName":"筑紫野 みつぐ","sourceIds":{"bangumi":[{"characterId":"44425","match":"exact-normalized-name-in-linked-work","subjectId":"87626"}],"egsCharacterIds":["22702"],"vndbCharacterId":"c11193"},"originalCharacterName":"筑紫野 みつぐ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"AB"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"155cm"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"47kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female student at the school. She is Nao's classmate and best friend. She loves fortune-telling. For some reason, she believes that the main character is her destined one. She approaches him modestly and aggressively with her wealth. She is naive and has a natural air of stupidity. She is the daughter of a big conglomerate."},{"spoiler":false,"text":"She is concerned about superstitions and jinxes. Her favorite book is a certain magazine from Gakken. She collects good luck items and accessories from mail-order stores. She has a strong sense of belief. She is easily heated and easily cooled."},{"spoiler":false,"text":"She is estranged from her parents and family, who are busy with their work, and she is a lonely person."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c11193"},{"segments":[{"spoiler":false,"text":"学園の女学生。なおのクラスメートで大の親友。"},{"spoiler":false,"text":"占い好き。何故か主人公を運命の人と信じ、財力に物を言わせ控えかつ過激にアプローチしてくる。"},{"spoiler":false,"text":"世間知らずで天然ボケ気味。迷信やジンクスを気にしている。"},{"spoiler":false,"text":"愛読書は学研の某雑誌。また、通販の開運グッズやらアクセサリーを収集している。"},{"spoiler":false,"text":"思い込みが激しいが、熱しやすく冷めやすい性格でもある。"},{"spoiler":false,"text":"仕事に忙殺されている両親や家族とは疎遠で、さびしい思いをしている。"}],"source":"egs","sourceCharacterId":"22702","sourceWorkId":"3945","spoiler":false},{"segments":[{"spoiler":false,"text":"【深窓の令乳、お騒がせ財閥娘】"},{"spoiler":false,"text":"肉まん型。Ｆカップ。"},{"spoiler":false,"text":"オカルト大好き御令嬢・みつぐの周りでは、ＵＦＯ・怪物・怪しい黒服の男達が入り乱れて、毎日がてんやわんやの大騒ぎ。"},{"spoiler":false,"text":"脱いでもすごいお嬢様は、なおを交えた３ＰやコスプレＨで大介を翻弄！"},{"spoiler":false,"text":"エキセントリックなみつぐに振り回されつつも、自分への真剣な気持ちを知り、戸惑う大介……。"},{"spoiler":false,"text":"そんな時、みつぐが大切にしていた御守りを失くした事で、暗雲が……。"}],"source":"egs","sourceCharacterId":"22702","sourceWorkId":"7172","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の女学生。なおのクラスメートで大の親友。"},{"spoiler":false,"text":"占い好き。何故か主人公を運命の人と信じ、"},{"spoiler":false,"text":"財力に物を言わせ控えかつ過激にアプローチしてくる。"},{"spoiler":false,"text":"世間知らずで天然ボケ気味。"},{"spoiler":false,"text":"財力に物を言わせ控えめかつ過激にアプローチしてくる。"},{"spoiler":false,"text":"世間知らずで天然ボケ気味。大財閥の令嬢。"},{"spoiler":false,"text":"迷信やジンクスを気にする。愛読書は学研の某雑誌。"},{"spoiler":false,"text":"通販の開運グッズやらアクセサリーを収集している。"},{"spoiler":false,"text":"思い込みが激しい。熱しやすく冷めやすい性格。"},{"spoiler":false,"text":"仕事に忙殺されている両親や家族とは疎遠で、さびしがり屋。"}],"source":"bangumi","sourceCharacterId":"44425"}],"profileFacts":[],"metadataCandidateConflicts":{"bust":[{"comparisonValue":"89","source":"vndb","sourceCharacterId":"c11193","value":"89"},{"comparisonValue":"89","scope":"sourceWork","source":"egs","sourceCharacterId":"22702","sourceWorkId":"3945","value":"89"},{"comparisonValue":"86","scope":"sourceWork","source":"egs","sourceCharacterId":"22702","sourceWorkId":"7172","value":"86"},{"comparisonValue":"86","source":"bangumi","sourceCharacterId":"44425","value":"86"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2cc6f4e61c60bb92c6b0de21faf0e6497079218f5102dd7755a1057f1608eb67.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c9ff56adb0575666a3b1558bab4b8e4caa6d3d7f493d13af0a8f274621dffba2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:87626:44425:4810:1","source":"bangumi"}]},{"characterId":"char_vndb_c11192","characterName":"衣更 透子","sourceIds":{"vndbCharacterId":"c11192"},"originalCharacterName":"衣更 透子","characterNameSource":null,"role":"prima