s":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the story who \"deserves ten thousand deaths\"."}],"source":"vndb","sourceCharacterId":"c46830"},{"segments":[{"spoiler":false,"text":"上位種族の男によって、館に連れて来られた少女。"},{"spoiler":false,"text":"彼を傷付けた罰として、何度も過激陵辱を受けることとなる。"},{"spoiler":false,"text":"美亜の部屋では体の傷が治る仕掛けが施されているため、死ぬような目に遭っても、死なずに済んでしまう。"}],"source":"egs","sourceCharacterId":"8633","sourceWorkId":"23562","spoiler":false},{"segments":[{"spoiler":false,"text":"本作的女主角，因攻擊上位種族失敗而被帶回上位種族所住的館，"},{"spoiler":false,"text":"作為攻擊自己的懲罰，每天都被過激凌辱著甚至致死，"},{"spoiler":false,"text":"但是因為上位種族所設的機關，所以不會死。"}],"source":"bangumi","sourceCharacterId":"51134"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/449a58d008a488fc7fd9cc722d9cdb1b45d9a46a126acfa9e1ad5c85bce2be40.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa7b02ab29d74ddf5991784e571ffd671bc5a0178b6ed6f57c61f5fa9fc21bb0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178431:51134:8055:1","source":"bangumi"}]},{"characterId":"char_c46831","characterName":"メイド","sourceIds":{"bangumi":[{"characterId":"51135","match":"exact-normalized-name-in-linked-work","subjectId":"178431"}],"egsCharacterIds":["8634"],"vndbCharacterId":"c46831"},"originalCharacterName":"メイド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A maid working at the mansion."},{"spoiler":false,"text":"She goes about her work calmly and doesn't even tell Mia her name."},{"spoiler":false,"text":"She is devoted to the Superior Man."}],"source":"vndb","sourceCharacterId":"c46831"},{"segments":[{"spoiler":false,"text":"館で働くメイド。"},{"spoiler":false,"text":"淡々と仕事をこなす性格で、美亜には名前すら教えてくれない。"},{"spoiler":false,"text":"上位種族の男に尽くしている。"}],"source":"egs","sourceCharacterId":"8634","sourceWorkId":"23562","spoiler":false},{"segments":[{"spoiler":false,"text":"住在公館很久的女僕，"},{"spoiler":false,"text":"總是冷靜思考並處理很多雜物，"},{"spoiler":false,"text":"對上位種族盡心盡力，不輕易告訴別人自己的名字。"}],"source":"bangumi","sourceCharacterId":"51135"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c558625dd7cd1624eecd6be6a0546a5d592015a9adbaa19b5d12535734748365.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7ee16ec81c3bdb93507ebe762c36d62f6031f2c8bc36c1d80a37a51c3f86c3bd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和泉忍","creatorId":"vndb:s1623","sourcePersonId":"vndb:s1623","canonicalEntityId":"vndb:s1623","name":"伊藤 葉純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178431:51135:6379:1","source":"bangumi"}]},{"characterId":"char_c47673","characterName":"上位種族の男","sourceIds":{"bangumi":[{"characterId":"51136","match":"exact-normalized-name-in-linked-work","subjectId":"178431"}],"egsCharacterIds":["8635"],"vndbCharacterId":"c47673"},"originalCharacterName":"上位種族の男","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An organism comes from different world. His appearance is really similar to human beings, but his abilities are beyond humans."},{"spoiler":false,"text":"He eats (kills) every single organism in the world, which is his purpose of coming to human world."}],"source":"vndb","sourceCharacterId":"c47673"},{"segments":[{"spoiler":false,"text":"別の世界からやって来た生物。"},{"spoiler":false,"text":"外見は人間と酷似しているが、人間にはない能力を多く持っている。"},{"spoiler":false,"text":"上位種族は世界の生物を食い尽くし（殺し尽くし）、次の世界へ飛ぶ、という生活を繰り返しており、人間の世界にも同様の目的でやって来た。"}],"source":"egs","sourceCharacterId":"8635","sourceWorkId":"23562","spoiler":false},{"segments":[{"spoiler":false,"text":"凌辱殘虐美亞的罪魁禍首，屬於來自其他世界的上位種族，"},{"spoiler":false,"text":"上位種族是一種會將一個星球吃光殺光後，"},{"spoiler":false,"text":"再去下一個星球繼續殺的種族，而這也是他們的生存意義。"}],"source":"bangumi","sourceCharacterId":"51136"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/728140c47d8a139cdac9d954707c0e7b55d67001c0d3654010b9f8ea47fa6867.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb0ee13cbe6e2ab60867c0c34ace3cd5ed48a416ffb9c5366ab3e3a851f6811b.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c47674","characterName":"夏花","sourceIds":{"bangumi":[{"characterId":"51137","match":"exact-normalized-name-in-linked-work","subjectId":"178431"}],"egsCharacterIds":["8636"],"vndbCharacterId":"c47674"},"originalCharacterName":"夏花","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who can be met at the mansion. Like Mia, she becomes the superior man's toy."},{"spoiler":false,"text":"She hopes to team up with Mia in order to escape from the mansion."}],"source":"vndb","sourceCharacterId":"c47674"},{"segments":[{"spoiler":false,"text":"館の中で出会う少女。"},{"spoiler":false,"text":"美亜同様、上位種族の男から玩具のように扱われている。"},{"spoiler":false,"text":"館から逃げるために、美亜と手を組むことを望んでいる。"}],"source":"egs","sourceCharacterId":"8636","sourceWorkId":"23562","spoiler":false},{"segments":[{"spoiler":false,"text":"美亚在馆中碰到的女生之一，"},{"spoiler":false,"text":"因为处境相同的关系，渐渐跟美亚变得很要好，"},{"spoiler":false,"text":"于是他们决定协力想办法一起逃出去。"}],"source":"bangumi","sourceCharacterId":"51137"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cdb3933729430b66ce6de1114262bda55aeff2813334e5723789ce4ce88da2b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76442cc0689299c6515fd98e8730e414c9f2b1319b858c97f54e70851a08a210.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松平美波穂","creatorId":"vndb:s601","sourcePersonId":"vndb:s601","canonicalEntityId":"vndb:s601","name":"松平 美波穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178431:51137:15488:1","source":"bangumi"}]},{"characterId":"char_c47675","characterName":"腐る男","sourceIds":{"bangumi":[{"characterId":"109429","match":"exact-normalized-name-in-linked-work","subjectId":"178431"}],"egsCharacterIds":["8637"],"vndbCharacterId":"c47675"},"originalCharacterName":"腐る男","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man working in the mansion. He had the appearance of normal man, but was turned into his current ugly look by the superior man. He can no longer speak."}],"source":"vndb","sourceCharacterId":"c47675"},{"segments":[{"spoiler":false,"text":"館で働く男だが、これでも元は人間。"},{"spoiler":false,"text":"上位種族の男の呪いによって、現在のような醜い外見になってしまい、満足に喋ることもできなくなってしまっている。"}],"source":"egs","sourceCharacterId":"8637","sourceWorkId":"23562","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.