ePersonId":"vndb:s3804","canonicalEntityId":"vndb:s3804","name":"にっし～","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:141573","source":"vndb"},{"creditedName":"茉宮 祈芹","creatorId":"vndb:s4253","sourcePersonId":"vndb:s4253","canonicalEntityId":"vndb:s4253","name":"茉宮 祈芹","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:141574","source":"vndb"},{"creditedName":"ぴこぴこぐらむ","creatorId":"vndb:s7936","sourcePersonId":"vndb:s7936","canonicalEntityId":"vndb:s7936","name":"ぴこぴこぐらむ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:141576","source":"vndb"},{"creditedName":"浅葱 純","creatorId":"vndb:s10669","sourcePersonId":"vndb:s10669","canonicalEntityId":"vndb:s10669","name":"浅葱 純","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:141578","source":"vndb"},{"creditedName":"鈴木屋16号店","creatorId":"vndb:s10675","sourcePersonId":"vndb:s10675","canonicalEntityId":"vndb:s10675","name":"鈴木屋16号店","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:141579","source":"vndb"},{"creditedName":"株式会社フロンティアワン","creatorId":"vndb:s18477","sourcePersonId":"vndb:s18477","canonicalEntityId":"vndb:s18477","name":"株式会社フロンティアワン","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:141580","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c84399","characterName":"服部 霧","sourceIds":{"vndbCharacterId":"c84399"},"originalCharacterName":"服部 霧","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kiri is a member of the Hattori, a clan of ninjas that traces back to ancient times. She has been receiving ninja training ever since she was a child, having their techniques drilled into her as part of her upbringing. Both her skills and her mental constitutional are exceptional. She is a peerless hunter of Dark Beings."},{"spoiler":false,"text":"Though she had been living in Japan, she has come to America with a certain goal in mind. She spends her days running a Japanese cafe in the suburbs while fighting to protect the town's peace from monsters."},{"spoiler":false,"text":"She enjoys a good binding—that is, with rope, and doing it to someone else—from time to time, which seems to suggest she has a slightly sadistic side. She also finds pleasure in teasing her partner, Mary. Whenever Mary makes a mistake, the whip-like crack of Kiri's rope sends a shiver down her spine."}],"source":"vndb","sourceCharacterId":"c84399"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c53ea5930544b7bfed00c06a1d763e8d1e049c2709f7c76050ddd329d392eca1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9d795973c7e53fd202bee0cd16fdbf1f69957cf5aaa852a6f162943e94fcf09.webp","width":176,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川 育美","creatorId":"vndb:s14378","sourcePersonId":"vndb:s14378","canonicalEntityId":"vndb:s14378","name":"長谷川 育美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74647","source":"vndb"}]},{"characterId":"char_vndb_c84400","characterName":"メアリー","sourceIds":{"vndbCharacterId":"c84400"},"originalCharacterName":"メアリー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Three hundred years ago, Mary was wrongfully accused of being a witch and executed. As the sole bearer of her entire family's vengeful rage, she turned into a vicious ghost that terrorized all those around her until she was saved by Kiri. She has made Kiri the center of her existence ever since."},{"spoiler":false,"text":"She commands fire at will, and can send them lashing out at her enemies. Though the intensity of the flames is usually under her control, when her emotions run high, she can go berserk. For a berserk Mary, the line between medium and well-done can be particularly thin."},{"spoiler":false,"text":"When the sun is up, she works as a waitress in the Japanese cafe. During the night, in true ghost-like fashion, she lives in a mirror in Kiri's room."},{"spoiler":false,"text":"Her favorite food is cold pizza, and anyone who dares tease her about it will surely have a taste of her fiery temper."}],"source":"vndb","sourceCharacterId":"c84400"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5b96581f15e86a70fe30d3f2e2d50f23a5fba2499fa77db0d38836d42ac6b4b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89bef0654e0fa12d1e4141107046043942b7f3fd165e29bd7cb6478b785a1c9a.webp","width":135,"height":256,"source":"static-detail"},"actors":[{"creditedName":"原田 彩楓","creatorId":"vndb:s18795","sourcePersonId":"vndb:s18795","canonicalEntityId":"vndb:s18795","name":"原田 彩楓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74650","source":"vndb"}]},{"characterId":"char_vndb_c84401","characterName":"リリィ","sourceIds":{"vndbCharacterId":"c84401"},"originalCharacterName":"リリィ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One stormy night, Kiri finds her collapsed in front of her store. Different from Kiri’s, she uses wind-style ninjutsu."},{"spoiler":false,"text":"She has partial amnesia, having lostpart of her memories, and is now a live-in employee at Kiri’s café causing a bit of trouble."},{"spoiler":false,"text":"Eventually, she opens up to Kiri and Mary, who also learn to trust her. She has a certain goal: what could it be...?"}],"source":"vndb","sourceCharacterId":"c84401"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5dc110cf7e8845510634f6c40f2452a8fc62542cfd41e684290ae4302846c0d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/9089aea95d3a4b4fba4f7b5cfe7fdaf3e9bba2e92baf89f3b3b8a9e5ae12dc7b.webp","width":110,"height":256,"source":"static-detail"},"actors":[{"creditedName":"村上 奈津実","creatorId":"vndb:s18794","sourcePersonId":"vndb:s18794","canonicalEntityId":"vndb:s18794","name":"村上 奈津実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74649","source":"vndb"}]},{"characterId":"char_vndb_c84402","characterName":"首無し騎士","sourceIds":{"vndbCharacterId":"c84402"},"originalCharacterName":"首無し騎士","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A towering, powerful being of the darkness that can easily swing his two-meter long zweihänder, he has enough magical strength to easily regenerate any minor damage immediately."},{"spoiler":false,"text":"Lost his head hundreds of years ago from one of Kiri’s ancestors. His intense, deep-seated grudge keeps him alive as a being of the darkness."},{"spoiler":false,"text":"It seems that he also has some kind of connection with Mary..."}],"source":"vndb","sourceCharacterId":"c84402"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de6080e58518b399ba724c17f20e0ea9eb2d7d1d31c8f0491e89841422900dfe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/603644f7ba442b1df3516ec15784e30db3d556ca036895fc90c62016482152dd.webp","width":230,"height":256,"source":"static-detail"},"actors":[{"creditedName":"望月 英","creatorId":"vndb:s8865","sourcePersonId":"vndb:s8865","canonicalEntityId":"vndb:s8865","name":"望月 英","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74648","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p6513","sourceCompanyId":"egs:brand:5483","canonicalEntityId":"vndb:p6513","name":"Code:jp","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:25543:5483","source":"egs"},{"companyId":"vndb:p162","sourceCompanyId":"vndb:p162","canonicalEntityId":"vndb:p162","name":"Sekai Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:59729:v21435","source":"vndb"},{"companyId":"vndb:p6513","sourceCompanyId":"vndb:p6513","canonicalEntityId":"vndb:p6513","name":"code:jp","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:59730:v21435","source":"vndb"},{"companyId":"vndb:p6513","sourceCompanyId":"vndb:p6513","canonicalEntityId":"vndb:p6513","name":"code:jp","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:71948:v21435","source":"vndb"},{"companyId":"vndb:p162","sourceCompanyId":"vndb:p162","canonicalEntityId":"vndb:p162","name":"Sekai Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:72550:v21435","source":"vndb"},{"companyId":"vndb:p6513","sourceCompanyId":"vndb:p6513","canonicalEntityId":"vndb:p6513","name":"code:jp","roleCodes":["developer"],"identityStatus":"source-native","relationId":"