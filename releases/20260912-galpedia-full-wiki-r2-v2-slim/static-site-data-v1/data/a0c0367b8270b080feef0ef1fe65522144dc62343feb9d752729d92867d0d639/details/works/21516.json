identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"最近、見栄を張って『お兄ちゃん』と呼ばなくなってしまった上の妹。"},{"spoiler":false,"text":"しかし、兄に優しくされるとまんざらでもない様子。"},{"spoiler":false,"text":"本来であれば、友達と遊びに出かけるような年頃なのだが、幼い頃から通っているスイミングに熱心に打ち込んでいる。"},{"spoiler":false,"text":"とはいえ、決して友達が少ないわけでな無く、クラスでは中心的な存在。"},{"spoiler":false,"text":"行動力、発言力共にあるため、何かと人気者。"},{"spoiler":false,"text":"家に帰るともっぱらスマホをいじっている。"},{"spoiler":false,"text":"SNSを見たり、ショッピングサイトで気になるアイテムを見たりと、テレビよりも携帯から情報を得ている。"},{"spoiler":false,"text":"時折、好きな芸人などが出ていると携帯そっちのけでテレビに食い入ることもあり、そんなお気に入りの芸人が出演している『はたらくおねえさん』という番組で“声優”が取り上げられた事をきっかけに興味を持つ。"}],"source":"egs","sourceCharacterId":"5850","sourceWorkId":"21516","spoiler":false},{"segments":[{"spoiler":false,"text":"ぷち反抗期真っ盛りな上の妹"},{"spoiler":false,"text":"最近、見栄を張って 「お兄ちゃん」 と呼ばなくなってしまった上の妹。"},{"spoiler":false,"text":"しかし、兄に優しくされるとまんざらでもない様子。"},{"spoiler":false,"text":"本来であれば友達と遊びたがる年頃だが、幼い頃から通っているスイミングに打ち込んでいる。"},{"spoiler":false,"text":"しかし決して友達が少ないわけではなく、行動力があるためクラスでは中心的な存在で人気者。"},{"spoiler":false,"text":"家に帰るともっぱらスマホをいじっていて、SNSやショッピングサイトを覗いている。"},{"spoiler":false,"text":"時折 好きな芸人が出ているとテレビに食い入ることもあり、『はたらくおねえさん』 という番組で声優を知り、興味を持つ。"}],"source":"bangumi","sourceCharacterId":"34982"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"34982","value":"辛いもの、スポーツ"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"34982","value":"虫、家事、ちまちましたもの"},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"5850","sourceWorkId":"21516","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"43 kg","valueContext":null,"source":"egs","sourceCharacterId":"5850","sourceWorkId":"21516","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9af033d32f394e95a817340789259945e59ff872bbe9920bd417b99986f6b841.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4f99cfa5aa22dc8a3f77f652d9808cc1447c8e75621e3a89b18ca855eaed65b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瀬戸千晴","creatorId":"vndb:s3220","sourcePersonId":"vndb:s3220","canonicalEntityId":"vndb:s3220","name":"春山色葉","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:128902:34982:19142:1","source":"bangumi"}]},{"characterId":"char_c29873","characterName":"朝倉 冬華","sourceIds":{"bangumi":[{"characterId":"34983","match":"exact-normalized-name-in-linked-work","subjectId":"128902"}],"egsCharacterIds":["5851"],"vndbCharacterId":"c29873"},"originalCharacterName":"朝倉 冬華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いつも兄が家事をしていることを知っているため、部活にも所属せず、家に帰っては洗濯、夕飯と家の手伝いをしてくれるしっかり者。"},{"spoiler":false,"text":"しかし、しっとりとした雰囲気とどこか可憐な様子も相まって、よく面倒を見られてしまう末っ子気質の持ち主。"},{"spoiler":false,"text":"内気でマイペースな性格をしており、友達は少数の趣味の合うもの同士でいつも昼休みを満喫している様子。"},{"spoiler":false,"text":"メールで友達とやり取りするものの、流行のSNSなどには興味が無く、家事を終えると携帯よりもテレビを見て時間を潰すか、勉強をしているか、インドアで一人遊びが好き。"},{"spoiler":false,"text":"そんなある日、姉の見ていた番組、『はたらくおねえさん』で“声優”が取り上げられた事をきっかけに昔から興味があった声優により一層興味を持つ。"}],"source":"egs","sourceCharacterId":"5851","sourceWorkId":"21516","spoiler":false},{"segments":[{"spoiler":false,"text":"少し大人びている下の妹"},{"spoiler":false,"text":"いつも面倒を見てくれている兄を手伝おうと、部活にも入らず家事を手伝ってくれるしっかり者。"},{"spoiler":false,"text":"しかし、しっとりと可憐な雰囲気も相まって、よく面倒を見られてしまう末っ子気質の持ち主でもある。"},{"spoiler":false,"text":"内気でマイペースな性格をしており、友達は少数。趣味の合う者同士でいつも昼休みを満喫している様子。"},{"spoiler":false,"text":"家事を終えるとテレビを見て時間を潰したり、勉強をしたり、インドアでの一人遊びが好き。"},{"spoiler":false,"text":"ある日、姉の見ていた番組をキッカケに、昔から気になっていた声優という職業により一層興味を持つ。"}],"source":"bangumi","sourceCharacterId":"34983"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"34983","value":"甘いもの、読書、勉強、家事"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"34983","value":"うるさいもの"},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"5851","sourceWorkId":"21516","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"45 kg","valueContext":null,"source":"egs","sourceCharacterId":"5851","sourceWorkId":"21516","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d77b9a20ca5045a0441b875d1400edfc39bc17f73c68a5c351b3820100d76fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f0ccd93f59aa8efb1c481f2eef00f2b78fefca25a573757723a8becc6eaa292.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"蓬 かすみ","creatorId":"vndb:s1975","sourcePersonId":"vndb:s1975","canonicalEntityId":"vndb:s1975","name":"よもぎかすみ(蓬かすみ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62842","source":"vndb"}]},{"characterId":"char_vndb_c108122","characterName":"朝倉 春樹","sourceIds":{"vndbCharacterId":"c108122"},"originalCharacterName":"朝倉 春樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p5971","sourceCompanyId":"egs:brand:5050","canonicalEntityId":"vndb:p5971","name":"INTERHEART Cute","roleCodes":["brand"],"identityStatus":"