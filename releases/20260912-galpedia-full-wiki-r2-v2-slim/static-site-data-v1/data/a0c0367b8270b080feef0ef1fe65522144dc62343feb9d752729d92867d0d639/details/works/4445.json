{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"4445","model":{"presentationWorkId":"vndb:v4293","staff":{"artwork":[{"creditedName":"舛舘俊秀","creatorId":"vndb:s5041","sourcePersonId":"egs:creator:1145","canonicalEntityId":"vndb:s5041","name":"舛舘俊秀","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:7997","source":"egs"}],"scenario":[{"creditedName":"さぷりめんと","creatorId":"egs:creator:2645","sourcePersonId":"egs:creator:2645","canonicalEntityId":"egs:creator:2645","name":"さぷりめんと","roleCode":"scenario","roleLabel":"剧本","identityStatus":"alias-only-review","relationId":"egs:work-creator:7998","source":"egs"},{"creditedName":"御倉たな","creatorId":"vndb:s6937","sourcePersonId":"egs:creator:186","canonicalEntityId":"vndb:s6937","name":"御倉たな","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:7999","source":"egs"},{"creditedName":"海路 本田","creatorId":"vndb:s6939","sourcePersonId":"vndb:s6939","canonicalEntityId":"vndb:s6939","name":"海路 本田","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:48928","source":"vndb"}],"music":[{"creditedName":"せんたろ","creatorId":"vndb:s2779","sourcePersonId":"egs:creator:1869","canonicalEntityId":"vndb:s2779","name":"せんたろ","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:12527","source":"egs"}],"other":[{"creditedName":"平野 響子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"藤本 教子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:48922","source":"vndb"},{"creditedName":"海苔 餅太","creatorId":"vndb:s4086","sourcePersonId":"vndb:s4086","canonicalEntityId":"vndb:s4086","name":"海苔 餅太","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:48924","source":"vndb"},{"creditedName":"伊藤 爆雲堂","creatorId":"vndb:s5393","sourcePersonId":"vndb:s5393","canonicalEntityId":"vndb:s5393","name":"伊藤 爆雲堂","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:48926","source":"vndb"},{"creditedName":"御倉 たな","creatorId":"vndb:s6937","sourcePersonId":"vndb:s6937","canonicalEntityId":"vndb:s6937","name":"御倉 たな","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:48927","source":"vndb"},{"creditedName":"一本馬場 南山","creatorId":"vndb:s7253","sourcePersonId":"vndb:s7253","canonicalEntityId":"vndb:s7253","name":"一本馬場 南山","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:48929","source":"vndb"},{"creditedName":"湖山 真奈美","creatorId":"vndb:s20275","sourcePersonId":"vndb:s20275","canonicalEntityId":"vndb:s20275","name":"湖山 真奈美","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:48930","source":"vndb"},{"creditedName":"藤井 梓麻","creatorId":"vndb:s20941","sourcePersonId":"vndb:s20941","canonicalEntityId":"vndb:s20941","name":"藤井 梓麻","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:48931","source":"vndb"},{"creditedName":"おさわり先生","creatorId":"vndb:s20945","sourcePersonId":"vndb:s20945","canonicalEntityId":"vndb:s20945","name":"おさわり先生","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:48932","source":"vndb"},{"creditedName":"おちんさま","creatorId":"vndb:s25518","sourcePersonId":"vndb:s25518","canonicalEntityId":"vndb:s25518","name":"おちんさま","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:48933","source":"vndb"},{"creditedName":"とみぃ","creatorId":"vndb:s32479","sourcePersonId":"vndb:s32479","canonicalEntityId":"vndb:s32479","name":"とみぃ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:48934","source":"vndb"}]},"cast":[{"characterId":"char_c104078","characterName":"雲根 菖蒲","sourceIds":{"bangumi":[{"characterId":"144805","match":"exact-normalized-name-in-linked-work","subjectId":"467350"},{"characterId":"144805","match":"exact-normalized-name-in-linked-work","subjectId":"98969"}],"egsCharacterIds":["25329"],"vndbCharacterId":"c104078"},"originalCharacterName":"雲根 菖蒲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Leader of the black-haired girl corps. She has excellent grades and is good at both literary and military arts. She plays the role of escort by welcoming the main character, Kaoru, as a member of the black-haired girl corps."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c104078"},{"segments":[{"spoiler":false,"text":"黒髪少女隊のリーダー「御小姓様」と呼ばれ、華麗で奥ゆかしく、かつ女子生徒から尊敬と憧れの眼差しを向けられる学園の華。"},{"spoiler":false,"text":"しかしその実、天然ボケなのか本気なのか良くわからない少しズレたセンスと思考と味覚（これが一番問題）を持つ困った人物。"},{"spoiler":false,"text":"特に極度の味覚オンチだということは黒髪少女隊のトップシークレットのようだ。"},{"spoiler":false,"text":"「気念」という自らのオーラを高める技を持ち、それをある目的から薫に伝授する。"},{"spoiler":false,"text":"どうやら彼女には他の隊員たちにも明かしていないことがあるようで、学園長の催馬楽と秘密を共有しているようだが……。"}],"source":"egs","sourceCharacterId":"25329","sourceWorkId":"6210","spoiler":false},{"segments":[{"spoiler":false,"text":"逢諒学園の最上級生（六年生）で黒髪少女隊の御小姓様（リーダー）。"},{"spoiler":false,"text":"可憐で物静か、日本女性の奥ゆかしさを具現化したかのような佇まいでその一身に女学園生たちからの尊敬と憧れを集める学園の華。"},{"spoiler":false,"text":"逢諒学園で「お姉さま」といえば彼女を指す。"},{"spoiler":false,"text":"成績優秀、文武両道に長けた彼女は、主人公・薫を黒髪少女隊の一員として迎えることで、護衛の役目をなそうとするが……どうもそれだけではないらしい。"},{"spoiler":false,"text":"本人は意識していないようだが、ナチュラルに黒い台詞を吐いて周囲を困らせる。"},{"spoiler":false,"text":"他の黒髪少女隊の面々が知らないようなことにも関わっているようなのだが…。"},{"spoiler":false,"text":"また、本人は気づいていない（？）ようだが、極度の味音痴だということは黒髪少女隊のトップシークレットになっている。"},{"spoiler":false,"text":"「気念」という自分のオーラを高める技を駆使し、他人を癒すことが出来る。"}],"source":"egs","sourceCharacterId":"25329","sourceWorkId":"8032","spoiler":false},{"segments":[{"spoiler":false,"text":"逢諒学園の最上級生（六年生）で黒髪少女隊の御小姓様（リーダー）。華麗で物静か、日本女性の奥ゆかしさを具現化したかのような佇まいでその一身に女学園生たちからの尊敬と憧れを集める学園の華。逢諒学園で「お姉さま」といえば彼女を指す。成績優秀、文武両道に長けた彼女は、主人公・薫を黒髪少女隊の一員として迎えることで、護衛の役目をなそうとするが……どうもそれだけではないらしい。"},{"spoiler":false,"text":"本人は意識していないようだが、ナチュラルに黒い台詞を吐いて周囲を困らせる。他の黒髪少女隊の面々が知らないようなことにも関わっているようなのだが…。また、本人は気づいていない（？）ようだが、極度の味音痴だということは黒髪少女隊のトップシークレットになっている。"},{"spoiler":false,"text":"「気念」という自分のオーラを高める技を駆使し、他人を癒すことが出来る。なお気念は自らの肉体を操る技でもあり、薫に教えることで女性っぽい体型を維持させようと考えて、厳しい（？）修行をさせることになる。"}],"source":"bangumi","sourceCharacterId":"144805"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14af52d176de677049ae1e07a9c51126d0500e777e820200b4b98e9815c9cf00.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07c32b8fbb34e6c697d8683a66f31270b103236ed5513e3359d7f608bd841644.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北条明日香","creatorId":"vndb:s1016","sourcePersonId":"vndb:s1016","canonicalEntityId":"vndb:s1016","name":"北条 明日香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:98969:144805:32486:1","source":"bangumi"}]},{"characterId":"char_c118673","characterName":"三瀬院 蘭子","sourceIds":{"bangumi":[{"characterId":"144809","match":"exact-normalized-name-in-linked-work","subjectId":"467350"},{"characterId":"144809","match":"exact-normalized-name-in-linked-work","subjectId":"98969"}],"egsCharacterIds":["25330"],"vndbCharacterId":"c118673"},"originalCharacterName":"三瀬院 蘭子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"逢諒学園の生徒会にあたる「紅牡丹会」の華麗なる会長にして菖蒲の生涯のライバルを自認する金髪縦ロールの美少女。"},{"spoiler":false,"text":"黒髪少女隊の一人「律掌」であることは学園の生徒には秘密にされている。"},{"spoiler":false,"text":"（知っている生徒はほとんど卒業してしまっている）"},{"spoiler":false,"text":"高飛車に見えるが本当はちょっとシャイで寂しがり屋で、ずっと逢諒学園（女子高）に通っていたこともあり男性恐怖症。"},{"spoiler":false,"text":"優しさに触れたことで薫に惚れてしまうも、男性だということを知って茫然自失となる。"}],"source":"egs","sourceCharacterId":"25330","sourceWorkId":"6210","spoiler":false},{"segments":[{"spoiler":false,"text":"逢諒学園六年生で学園生代表の紅牡丹会会長。（紅牡丹会はいわゆる生徒会）"},{"spoiler":false,"text":"菖蒲をライバル視していて、何かにつけて黒髪少女隊にチョッカイを出す。"},{"spoiler":false,"text":"だがそのたびに逆襲を喰らうのが日課のようになっている。（しかし懲りない）"},{"spoiler":false,"text":"菖蒲の恐ろしい御技を知る数少ない人物の一人。"},{"spoiler":false,"text":"そんなどうしようもないことを計画したりする女の子ではあるが、それなりに学園生からは尊敬されているし、愛着（？）をもたれている。"}],"source":"egs","sourceCharacterId":"25330","sourceWorkId":"8032","spoiler":false},{"segments":[{"spoiler":false,"text":"逢諒学園六年生で学園生代表の紅牡丹会会長。（紅牡丹会はいわゆる生徒会）"},{"spoiler":false,"text":"菖蒲をライバル視していて、何かにつけて黒髪少女隊にチョッカイを出す。だがそのたびに逆襲を喰らうのが日課のようになっている。（しかし懲りない）菖蒲の恐ろしい御技を知る数少ない人物の一人。そんなどうしようもないことを計画したりする女の子ではあるが、それなりに学園生からは尊敬されているし、愛着（？）をもたれている。"}],"source":"bangumi","sourceCharacterId":"144809"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07fc4738ce22d3410fbaa9d8af2f8bc3c0c96f01beb91b2777c5dc38a700fd7e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f75ac25ac55a3f4787ad2159cfba261077547f1f5ec82943a00060bc0e7cabd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"横手 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:98969:144809:4937:1","source":"bangumi"}]},{"characterId":"char_c118674","characterName":"天津袖 紫苑","sourceIds":{"bangumi":[{"characterId":"144806","match":"exact-normalized-name-in-linked-work","subjectId":"467350"},{"characterId":"144806","match":"exact-normalized-name-in-linked-work","subjectId":"98969"}],"egsCharacterIds":["25328"],"vndbCharacterId":"c118674"},"originalCharacterName":"天津袖 紫苑","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"黒髪少女隊で「護身刀」と呼ばれ、「まつろわぬ者」を斬る神刀を扱うことができる天才剣士。"},{"spoiler":false,"text":"天津袖流の「落葉一閃」や神技「神楽五神舞」といった奥義を若年で修めた希有な人物として一部で名が知れ渡っている。"},{"spoiler":false,"text":"だがその本質は「まつろわぬ者」に体を奪われた巫女を浄化（絶命）するという宿命を背負っている。"},{"spoiler":false,"text":"過去に情によって撫子を浄化できなかったことが心に様々な傷を残した。"},{"spoiler":false,"text":"凛とした風貌と雰囲気から学園最高のアイドル。"},{"spoiler":false,"text":"いくつものファンクラブが存在しているという。"}],"source":"egs","sourceCharacterId":"25328","sourceWorkId":"6210","spoiler":false},{"segments":[{"spoiler":false,"text":"逢諒学園の五年生で黒髪少女隊「護身刀」。"},{"spoiler":false,"text":"その手には刀を握らせれば右に出るものはいないといわれる天才剣士。"},{"spoiler":false,"text":"竹刀や木刀でさえ危険な凶器と化してしまうために、実家の方針で剣道部等の武道系部活に入部を禁じられている。"},{"spoiler":false,"text":"黒く長い髪を棚引かせ目を細めつつ無言で空でも見上げた日には周囲の女学園生たちは嬌声とともに失神してしまうのではないかというほど艶かしい「男役」っぷりを発揮する。"},{"spoiler":false,"text":"学内にファンクラブが20とも30とも言われ、ファン同士での諍いも絶えないと言われるほどの学園のスター。"},{"spoiler":false,"text":"主人公を襲う外敵からその身を守る最前衛を勤める。"}],"source":"egs","sourceCharacterId":"25328","sourceWorkId":"8032","spoiler":false},{"segments":[{"spoiler":false,"text":"逢諒学園の五年生で黒髪少女隊「護身刀」。その手には刀を握らせれば右に出るものはいないといわれる天才剣士。竹刀や木刀でさえ危険な凶器と化してしまうために、実家の方針で剣道部等の武道系部活に入部を禁じられている。黒く長い髪を棚引かせつつ目を細めつつ無言で空でも見上げた日には周囲の女学園生たちは嬌声とともに失神してしまうのではないかというほど艶かしい「男役」っぷりを発揮する。"},{"spoiler":false,"text":"学内にファンクラブが20とも30とも言われ、ファン同士での諍いも絶えないと言われるほどの学園のスター。主人公を襲う外敵からその身を守る最前衛を勤める。"}],"source":"bangumi","sourceCharacterId":"144806"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14d1b15a60bc44461d04e0da2e9faf23d7296c9b25bbef9df934aecd62951d22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e5f2d89e14d51babaae4272285ecfaa000c7ec091ff032df9c70a628a17cf7e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"嶋崎はるか","creatorId":"vndb:s1013","sourcePersonId":"vndb:s1013","canonicalEntityId":"vndb:s1013","name":"嶋崎 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:98969:144806:6302:1","source":"bangumi"}]},{"characterId":"char_c118675","characterName":"中御門 雅","sourceIds":{"bangumi":[{"characterId":"144807","match":"exact-normalized-name-in-linked-work","subjectId":"467350"},{"characterId":"144807","match":"exact-normalized-name-in-linked-work","subjectId":"98969"}],"egsCharacterIds":["25326"],"vndbCharacterId":"c118675"},"originalCharacterName":"中御門 雅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いまや大財閥となった中御門グループ総帥の庶子。"},{"spoiler":false,"text":"いにしえの昔から一族に、「人型（ひとがた、からくり人形のようなもの）」を操る技を持ち、黒髪少女隊の中で「傀儡舞」と呼ばれている。"},{"spoiler":false,"text":"本人いわく中御門家は「メイドの名家（？）」らしく、普段からメイドの格好をして薫の身の回りの世話をするが、それらは自らが製作した様々なアイテムを薫の体で実験するための口実だということに気づかれ警戒されてしまい、思うように実験できずにいる。"},{"spoiler":false,"text":"「人型」を操ることが起因しているのか、特にロボット工学に関連する技術開発は天才の領域すら越えており、とりわけ現在開発中の中御門百二十式支援型外骨格、通称「スゴ」シリーズは中御門インダストリアル株式会社にて商品化が進んでいる。"}],"source":"egs","sourceCharacterId":"25326","sourceWorkId":"6210","spoiler":false},{"segments":[{"spoiler":false,"text":"逢諒学園四年生。"},{"spoiler":false,"text":"編入してきた薫と一番接する機会が多い黒髪少女隊の一人。"},{"spoiler":false,"text":"別称「傀儡舞」。"},{"spoiler":false,"text":"メイドの名家（？）出身で、行儀作法の修行もかねて学園寮に入っている。"},{"spoiler":false,"text":"とはいえ家事一般が得意というわけでなく、彼女が得意としているのはロボットや特殊素材、そしてそれを使った情報収集といった技術開発・諜報だったりする。"},{"spoiler":false,"text":"とりわけ現在開発中の中御門百二十式改支援型調理外骨格、通称「スゴ」シリーズのテスト運用のため、幾度となく薫を実験台にしては暴走し、自らが犠牲になる羽目に会う。"},{"spoiler":false,"text":"特に男性関係に関しては知識先行で耳年増なところがある。"},{"spoiler":false,"text":"黒髪少女隊としては、等身大の人形（ひとがた）、「市松さん」を操る技を持ち、広範囲に渡った敵に対する殲滅力は隊員随一である。"},{"spoiler":false,"text":"ただし、市松さんを操るには彼女の「とあるもの」が必要となるため、危険を伴う。"}],"source":"egs","sourceCharacterId":"25326","sourceWorkId":"8032","spoiler":false},{"segments":[{"spoiler":false,"text":"逢諒学園四年生で、編入してきた薫と一番接する機会が多い黒髪少女隊の一人。別称「傀儡舞」。メイドの名家（？）出身で、行儀作法の修行もかねて学園寮に入っている。とはいえ家事一般が得意というわけでなく、彼女が得意としているのはロボットや特殊素材、そしてそれを使った情報収集といった技術開発・諜報だったりする。"},{"spoiler":false,"text":"とりわけ現在開発中の中御門百二十式改支援型調理外骨格、通称「スゴ」シリーズのテスト運用のため、幾度となく薫を実験台にしては暴走し、自らが犠牲になる羽目に会う。特に男性関係に関しては知識先行で耳年増なところがある。黒髪少女隊としては、等身大の人形（ひとがた）、「市松さん」を操る技を持ち、広範囲に渡った敵に対する殲滅力は隊員随一である。ただし、市松さんを操るには彼女の「とあるもの」が必要となるため、危険を伴う。"}],"source":"bangumi","sourceCharacterId":"144807"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e721229e33064ceb70683aa172c467fd1726c65eb5bbc813634edd8f3daf07e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f623cd141de5a3a60485f7a1eb5e86459e31935ab7d0dbae656f7a8342e9b7e2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:98969:144807:4675:1","source":"bangumi"}]},{"characterId":"char_c118676","characterName":"妹背 撫子","sourceIds":{"bangumi":[{"characterId":"144808","match":"exact-normalized-name-in-linked-work","subjectId":"467350"},{"characterId":"144808","match":"exact-normalized-name-in-linked-work","subjectId":"98969"}],"egsCharacterIds":["25327"],"vndbCharacterId":"c118676"},"originalCharacterName":"妹背 撫子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"何かにつけて薫に絡む一つ年下の少女。"},{"spoiler":false,"text":"これでも黒髪少女隊の一員で、"},{"spoiler":false,"text":"「まつろわぬ者」と呼ばれる魔族と戦うことを宿命づけられた運命の巫女。"},{"spoiler":false,"text":"「蛟（みずち）」という精霊を呼び出して使役させることができる。"}],"source":"egs","sourceCharacterId":"25327","sourceWorkId":"6210","spoiler":false},{"segments":[{"spoiler":false,"text":"逢諒学園三年生。黒髪少女隊「神乙女」。"},{"spoiler":false,"text":"学園一のやんちゃっ子といわれているが、逆に上級生からはマスコット的人気を誇っている。"},{"spoiler":false,"text":"行儀作法を身に付けさせようと寮に入れられたのだが、逆に家族の目が届かなくなったのこいいことに好き勝手暴れている。"},{"spoiler":false,"text":"薫のことを何かにつけて揶揄る役目で、ちょっとしたことでもチョッカイをだしてくる。"},{"spoiler":false,"text":"実家は逢諒家の神事を司っていて、その家系には霊的な力が発現し、撫子も方術を使い、水の神獣「蛟（みずち）」を使役することが出来る。"}],"source":"egs","sourceCharacterId":"25327","sourceWorkId":"8032","spoiler":false},{"segments":[{"spoiler":false,"text":"逢諒学園三年生。黒髪少女隊「神乙女」。学園一のやんちゃっ子といわれているが、逆に上級生からはマスコット的人気を誇っている。行儀作法を身に付けさせようと寮に入れられたのだが、逆に家族の目が届かなくなったのこいいことに好き勝手暴れている。薫のことを何かにつけて揶揄る役目で、ちょっとしたことでもチョッカイをだしてくる。"},{"spoiler":false,"text":"実家は逢諒家の神事を司っていて、その家系には霊的な力が発現し、撫子も方術を使い、水の神獣「蛟（みずち）」を使役することが出来る。しかし才能に恵まれながらも修行をおろそかにしていたため、時に力が暴走して自らを傷つけることもあり、そんな彼女を冷笑する姉たちとは歳も離れていることもあって若干の隔意がある。ちなみに、上の二人の姉は既婚で家を離れているため、一番年齢が近い姉美津子が実家の神社を取りまとめている。"}],"source":"bangumi","sourceCharacterId":"144808"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e145626f27c625b977e2ae689bfafdba1e3395bd4b6fb735f5d1297bde88b5aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f2fc3c541f416f8550128652e32c3792194ba666ae1cf01ba93b4794e185b64.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"藤本 教子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:98969:144808:5669:1","source":"bangumi"}]},{"characterId":"char_c52481","characterName":"久世 愛歌","sourceIds":{"bangumi":[],"egsCharacterIds":["26302"],"vndbCharacterId":"c52481"},"originalCharacterName":"久世 愛歌","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"薫が初めて友達になったクラスメイト。"},{"spoiler":false,"text":"無口で地味、さらに身分が低い「下家」の出身ということもあってクラスでも浮いた存在になっていたが他のクラスメイトともめたことをきっかけに薫と親友になる。"},{"spoiler":false,"text":"ただマイナス思考が強く、内向的な性格であることが後に学園を巻き込んだ大事件に発展する。"},{"spoiler":false,"text":"過去の歴史において裏切り者として名前を抹消された黒髪少女隊「嘉躍」の末裔で、強力な「まつろわぬ者」の一人、眞女兒によって体を乗っ取られてしまう。"}],"source":"egs","sourceCharacterId":"26302","sourceWorkId":"6210","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4c3ef7fafd2c0e28893323fcf64a141aec379a46968ad9cd84171783314b8d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fee38495ed3ba6a5a0539f93a4942f8247baeae2fe6e49068b01dcd09b749d4e.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"海原 エレナ","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"横手 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:27121","source":"vndb"}]},{"characterId":"char_c52482","characterName":"催馬楽","sourceIds":{"bangumi":[],"egsCharacterIds":["26303"],"vndbCharacterId":"c52482"},"originalCharacterName":"催馬楽","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"薫を逢諒学園に招いた張本人で学園長。"},{"spoiler":false,"text":"黒髪少女隊の面々に薫の面倒を見るように指示したのは彼女だが、菖蒲となにやら企んでいた節がある。"},{"spoiler":false,"text":"黒髪少女隊の面々も一目を置く存在だが、実は黒髪少女隊の宿敵「まつろわぬ者」の一人で、「赤吸」と呼ばれた強力な魔族。"},{"spoiler":false,"text":"自由を奪う結界を打ち破った彼女は、主であった菖蒲も裏切り学園を去るが、覚醒後の久世愛歌に接触するなど不穏な動きを見せつつある。"}],"source":"egs","sourceCharacterId":"26303","sourceWorkId":"6210","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/617a7c1682a3f7d3f31485fc524fb647182d41397eeee8c0f7510b9a0b13dadf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f721ec8b687a2f513833f19dac948b28617ddef38e65b83341b6c652bc071613.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平野 響子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"藤本 教子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:27123","source":"vndb"}]},{"characterId":"char_vndb_c52475","characterName":"緒図 薫","sourceIds":{"vndbCharacterId":"c52475"},"originalCharacterName":"緒図 薫","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79830f95174b05aaff3877b3dd334a48f8736bb65c25c779c6add2a2fa3cc6fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/086ef3e224a81dcd43639997dee6540a83b037f8437153320414b399610f90ad.webp","width":183,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c59110","characterName":"山本 静","sourceIds":{"vndbCharacterId":"c59110"},"originalCharacterName":"山本 静","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewSta