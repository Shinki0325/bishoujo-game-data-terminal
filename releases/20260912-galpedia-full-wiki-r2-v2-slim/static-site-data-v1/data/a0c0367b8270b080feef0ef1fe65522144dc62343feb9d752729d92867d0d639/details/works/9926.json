didate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A childhood friend of Tsukasa’s, from long before they met Nami. She used to be close with both Tsukasa and Nami, but eventually drifted apart and grew noticeably colder."}],"source":"vndb","sourceCharacterId":"c49636"},{"segments":[{"spoiler":false,"text":"主人公の幼馴染。"},{"spoiler":false,"text":"同級生。がさつでボーイッシュな性格。"},{"spoiler":false,"text":"バレー部に所属している。"},{"spoiler":false,"text":"以前は仲が良かった……筈なのだが、最近は司を避けている様子。"},{"spoiler":false,"text":"それは今年の春からのこと。"},{"spoiler":false,"text":"実家が神社で、街の七夕祭りは奏の家が行っている。"},{"spoiler":false,"text":"手伝いで巫女さんになる事もあるとか……。"},{"spoiler":false,"text":"気が強いが、実はお化けが苦手という意外な一面もあったりする。"},{"spoiler":false,"text":"料理が得意で、少女漫画が大好き。"}],"source":"egs","sourceCharacterId":"25729","sourceWorkId":"7316","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼馴染。同級生。"},{"spoiler":false,"text":"がさつでボーイッシュな性格。バレー部に所属している。 仲が良かった……筈なのだが、最近は司を避けている様子。"},{"spoiler":false,"text":"実家が神社で、街の七夕祭りは奏の家が行っている。 手伝いで巫女さんになる事もあり。 気が強いが、実はお化けが苦手という意外な一面もあり。 料理が得意で、少女漫画が大好き。"}],"source":"bangumi","sourceCharacterId":"67012"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd2476c27a60dcb47c953082315fc76aed76a1dfc9648f6ef8f2222a9ee3c68b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/203480c2c80d60596b0342c4e90bd1db9537f0d434aae7cdb071a517faabc360.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1024:67012:4956:1","source":"bangumi"}]},{"characterId":"char_c49637","characterName":"夢原 飛鳥","sourceIds":{"bangumi":[{"characterId":"67013","match":"exact-normalized-name-in-linked-work","subjectId":"1024"}],"egsCharacterIds":["25730"],"vndbCharacterId":"c49637"},"originalCharacterName":"夢原 飛鳥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsukasa's dirt-poor classmate, permitted by the school to work part time. Very tired from working late hours along with studying, she is usually spotted sleep-walking to school and then sleeping through the lessons. Despite this, she has exceptionally good grades and a cheerful demeanor."}],"source":"vndb","sourceCharacterId":"c49637"},{"segments":[{"spoiler":false,"text":"司のクラスメイト。ドジで天然。"},{"spoiler":false,"text":"本人はいたってポジティブな思考で、いつでも笑顔を絶やさない。"},{"spoiler":false,"text":"趣味は使用済みテレカ集めとふぁみこん（？）。"},{"spoiler":false,"text":"数年前に地方からこの街へと引っ越してきたため、"},{"spoiler":false,"text":"訛りが多少（？）残っており、おかしな日本語を喋る。"},{"spoiler":false,"text":"成績は優秀。"},{"spoiler":false,"text":"放課後は貧乏な家計を助けるため、ラーメン屋で毎日のようにアルバイトをしている。"},{"spoiler":false,"text":"その所為か、授業中疲れて眠っている事が多い。"}],"source":"egs","sourceCharacterId":"25730","sourceWorkId":"7316","spoiler":false},{"segments":[{"spoiler":false,"text":"司のクラスメイト。ドジで天然な女の子。"},{"spoiler":false,"text":"しかし本人はいたってポジティブな思考で、いつでも笑顔を絶やさない。 使用済みテレカ集めとふぁみこん（？）。 数年前に地方からこの街へと引っ越してきたため、訛りが多少（？）残っており、おかしな日本語を喋る。 成績はなかなか優秀なのだが、その性格からか周囲には驚かれる。"},{"spoiler":false,"text":"放課後は貧乏な家計を助けるため、ラーメン屋でほぼ毎日のようにアルバイトをしている。その所為か、授業中疲れて眠っている事が多い。"}],"source":"bangumi","sourceCharacterId":"67013"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53aff2374123ae9826d71a8caf02fa99b2f954c64a9bb0094ada0d43fd4073af.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c62f2e71c32b8c405eb36a2b98ac84634ed027662149efaa3a104d9d7043048.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1024:67013:4830:1","source":"bangumi"}]},{"characterId":"char_c49638","characterName":"神崎 蓬","sourceIds":{"bangumi":[{"characterId":"67014","match":"exact-normalized-name-in-linked-work","subjectId":"1024"}],"egsCharacterIds":["25731"],"vndbCharacterId":"c49638"},"originalCharacterName":"神崎 蓬","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A top student and member of the school library committee. She has relationship problems, and is often \"lost\"—even when returning home from school."}],"source":"vndb","sourceCharacterId":"c49638"},{"segments":[{"spoiler":false,"text":"隣のクラスの図書委員長。司とは委員会で知り合う。"},{"spoiler":false,"text":"成績優秀で真面目だが、時々不思議な言動をして周囲を困惑させる。"},{"spoiler":false,"text":"両親は科学館の館長と副館長を務め、本人は何不自由なく育ったお嬢様。"},{"spoiler":false,"text":"超が付くほどの方向音痴。"},{"spoiler":false,"text":"趣味は幅広く、しかし熱中できる物は無い。"},{"spoiler":false,"text":"何をやっても中途半端だが、何をやってもそれなりにこなす。"},{"spoiler":false,"text":"昔ピアノを習っていたらしい。"}],"source":"egs","sourceCharacterId":"25731","sourceWorkId":"7316","spoiler":false},{"segments":[{"spoiler":false,"text":"同級生で隣のクラスの図書委員長。司とは委員会で知り合う。"},{"spoiler":false,"text":"成績優秀で真面目だが、時々不思議な言動をして周囲を困惑させる。いいトコのお嬢様。 超が付くほどの方向音痴。"},{"spoiler":false,"text":"趣味は幅広く、しかし熱中できる物は無い。 何をやっても中途半端だが、何をやってもそれなりにこなす。 昔ピアノを習っていたらしい。"}],"source":"bangumi","sourceCharacterId":"67014"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bbb4abc80a5197906a29bdd87e19bf449096ed299f897693eb9a59ebc91428f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/6354f44486584e236f9faaa1b2510cb2e9679fda2fb38e49c04893c0b129bfc5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長瀬桃花","creatorId":"vndb:s24672","sourcePersonId":"vndb:s24672","canonicalEntityId":"vndb:s24672","name":"長瀬桃花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9327","source":"vndb"}]},{"characterId":"char_c49639","characterName":"藍田 奈美","sourceIds":{"bangumi":[{"characterId":"67015","match":"exact-normalized-name-in-linked-work","subjectId":"1024"}],"egsCharacterIds":["25728"],"vndbCharacterId":"c49639"},"originalCharacterName":"藍田 奈美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsukasa's girlfriend and senpai, often found gazing out the window of the clubroom and reminiscing about the club's past."}],"source":"vndb","sourceCharacterId":"c49639"},{"segments":[{"spoiler":false,"text":"司、奏とは家が近所で幼馴染。"},{"spoiler":false,"text":"2つ年上の学園の先輩。幼少の頃この街へ引っ越してきた。"},{"spoiler":false,"text":"成績優秀で司の勉強を見てやることも多い。"},{"spoiler":false,"text":"軽音楽部部長で、ギターを少々たしなむ。"},{"spoiler":false,"text":"いつも部室の窓から空を眺めていることが多い。"},{"spoiler":false,"text":"また図書委員会の委員長も務める。"},{"spoiler":false,"text":"神崎蓬とは顔見知り。"},{"spoiler":false,"text":"好きなものは甘いもので、自身でクッキーなどを作って学園に持ってくることもしばしば。"},{"spoiler":false,"text":"しっかり者で、司に対してお姉さん風をふかせる。"}],"source":"egs","sourceCharacterId":"25728","sourceWorkId":"7316","spoiler":false},{"segments":[{"spoiler":false,"text":"司と奏の幼馴染で、2つ年上の先輩。"},{"spoiler":false,"text":"幼少の頃この街へ引っ越してきた。"},{"spoiler":false,"text":"成績優秀で司の勉強を見てやることも多い。 軽音楽部部長で、ギターを少々たしなむ。いつも部室の窓から空を眺めていることが多い。また図書委員会の委員長も務め、神崎蓬とは顔見知り。好きなものは甘いもので、自身でクッキーなどを作って学園に持ってくることもしばしば。"},{"spoiler":false,"text":"しっかり者で、司に対してお姉さん風をふかせる。"}],"sou