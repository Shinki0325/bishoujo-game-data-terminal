8700185ff5e6193f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf1266ea708d28ffff4eb8872525494e6cbb7033abebd0c4389821e8c5232b32.webp","width":140,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_17310","characterName":"斯波 纯一","sourceIds":{"bangumi":[{"characterId":"17310","match":"source-roster","subjectId":"18203"},{"characterId":"17310","match":"source-roster","subjectId":"36354"}]},"originalCharacterName":"斯波 纯一","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"28"},"birthday":{"reviewState":"source-only","source":"bangumi","value":"0825"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"177"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"成り上がりで大金持ちの貿易商。28歳。"},{"spoiler":false,"text":"なぜかヒロインを気に入っており財力を盾に強引に結婚しようとする。"},{"spoiler":false,"text":"性格は俺様で強引。型破りな性格。"},{"spoiler":false,"text":"暴发户，对女主角的执着心很强，执着地向女主角求婚，并愿意借此帮野宫家还债。"}],"source":"bangumi","sourceCharacterId":"17310"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e02b655cec14cd9e8fbe0fb8cccb74f8e298f94936bb4f77980f222954e449b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49bf34d4daf8f2ee1536dfb33a7383c6991ff95016c10d81a3927cf33db1ee29.webp","width":106,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤将之","creatorId":"vndb:s501","sourcePersonId":"vndb:s501","canonicalEntityId":"vndb:s501","name":"加藤 将之","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18203:17310:4875:1","source":"bangumi"}]},{"characterId":"char_bangumi_17311","characterName":"のみや みずひと","sourceIds":{"bangumi":[{"characterId":"17311","match":"source-roster","subjectId":"18203"},{"characterId":"17311","match":"source-roster","subjectId":"36354"}]},"originalCharacterName":"のみや みずひと","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"22"},"birthday":{"reviewState":"source-only","source":"bangumi","value":"0315"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"height":{"reviewState":"source-only","source":"bangumi","value":"168"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヒロインの兄。22 歳。"},{"spoiler":false,"text":"子爵家長男で華道の家元だが、かなり浮世離れしており厭世的。"},{"spoiler":false,"text":"絵画を好み女遊びも盛んという道楽者だが、妹のことは花のように愛でている。"},{"spoiler":false,"text":"平时一副流连花丛的样子，但瑞人却只是一个渴望温暖的孩子，带着文艺青年的纤细与敏感，关键时候意外的可靠。正如瑞人自己所说的：“我想要被爱，想被温柔而柔软的感情包围。即使是虚假的也好，只要在那个瞬间，能让我被骗就好。”"},{"spoiler":false,"text":"因为不是亲生的关系，瑞人从小就没有被母亲爱过，是女佣们将他抚养长大，所以瑞人也近乎执拗的追寻着这种被女人温柔包围的感觉，这让他感觉到了自己仍是被爱着的。在知道自己和这个家甚至连血缘关系也不存在时，瑞人连自己的存在意义都感到迷茫，也许只有在花街女人们身边流连时，他才能感觉到自己仍是被需要的吧。"}],"source":"bangumi","sourceCharacterId":"17311"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d98d36953871e5f20dbab5edd87c60d49258b0030574a48173d869b24078ccb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/7331d0d2b890fdefe585c1320c40b5537a5813130e4727824d5a1f1c27ba5ef4.webp","width":91,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平川大輔","creatorId":"vndb:s133","sourcePersonId":"vndb:s133","canonicalEntityId":"vndb:s133","name":"平川 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18203:17311:4452:1","source":"bangumi"}]},{"characterId