{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"21242","model":{"presentationWorkId":"vndb:v16242","staff":{"artwork":[{"creditedName":"なとり海","creatorId":"vndb:s2468","sourcePersonId":"egs:creator:22197","canonicalEntityId":"vndb:s2468","name":"なとり海","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:140544","source":"egs"}],"scenario":[{"creditedName":"咲草琴音","creatorId":"vndb:s30254","sourcePersonId":"egs:creator:22198","canonicalEntityId":"vndb:s30254","name":"咲草琴音","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:140545","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c23110","characterName":"貝森 伊鈴","sourceIds":{"bangumi":[{"characterId":"136489","match":"exact-normalized-name-in-linked-work","subjectId":"451802"}],"egsCharacterIds":["5699"],"vndbCharacterId":"c23110"},"originalCharacterName":"貝森 伊鈴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作のヒロイン。"},{"spoiler":false,"text":"謝り癖があり、引っ込み思案の恥ずかしがり屋。"},{"spoiler":false,"text":"思っている事を素直に話せない、控えめで大人しい女の子。"},{"spoiler":false,"text":"しかし、決めた事はやり通す方。ちょっと天然で抜けている所がある。"},{"spoiler":false,"text":"テンパると思考回路がショートして真っ白になってしまう。"},{"spoiler":false,"text":"緊張すると汗まみれになり、服が透けてしまう。近くにいると湿気が凄い。"},{"spoiler":false,"text":"すぐに汗でグチャグチャに濡れてしまうため、水分補給用のペットボトルと着替えを常備している。"},{"spoiler":false,"text":"主人公とは幼馴染で、幼少の時はよくバドミントンをして遊んでいた。"},{"spoiler":false,"text":"しかし、思春期頃から男女で遊んでいる事に抵抗を感じ疎遠になっていった。"},{"spoiler":false,"text":"幼少時、伊鈴なので“いっくん”というあだ名にしたら太一君が“いっくん”なので駄目だと言っていた。"},{"spoiler":false,"text":"両親は共働きであまり家にいない。そのおかげで家事スキルはかなり高い。"},{"spoiler":false,"text":"下着の趣味はフリルや水玉、ボーダー等可愛い系が多い。"},{"spoiler":false,"text":"「ご、ごめんなさい私のせいで…」"}],"source":"egs","sourceCharacterId":"5699","sourceWorkId":"21242","spoiler":false},{"segments":[{"spoiler":false,"text":"引っ込み思案で恥ずかしがり屋な幼なじみ。"},{"spoiler":false,"text":"緊張すると汗が大量に流れ出し、すぐに服が透けてしまう。"},{"spoiler":false,"text":"そのため水分補給用のペットボトルと着替えを常備している。"}],"source":"bangumi","sourceCharacterId":"136489"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"5699","sourceWorkId":"21242","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"5699","sourceWorkId":"21242","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"5699","sourceWorkId":"21242","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"5699","sourceWorkId":"21242","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"5699","sourceWorkId":"21242","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"48 kg","valueContext":null,"source":"egs","sourceCharacterId":"5699","sourceWorkId":"21242","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f5cb3d1a3ee5808b7201f6b292df2691d8640003638015154eda0fbaa47afc9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f2b354de3f7897b56ae9187bc37f2b5048f03a942dc202463090