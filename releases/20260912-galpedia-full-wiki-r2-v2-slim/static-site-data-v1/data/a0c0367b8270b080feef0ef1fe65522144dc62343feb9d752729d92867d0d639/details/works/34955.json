{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"34955","model":{"presentationWorkId":"egs:34955","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_160835","characterName":"テテュス・メディウム","sourceIds":{"bangumi":[{"characterId":"160835","match":"source-roster","subjectId":"480959"}]},"originalCharacterName":"テテュス・メディウム","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"■テテュス・メディウム"},{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"本世界において、『魔女』 とは 『ある偉業を達成した魔動学者』 に"},{"spoiler":false,"text":"授けられる称号です。"},{"spoiler":false,"text":"歴史上12人しか存在しない彼ら彼女らのうち、"},{"spoiler":false,"text":"もっとも初めに『その偉業に到達した者』が女性だったことが"},{"spoiler":false,"text":"『魔女』 という称号名の由来となっています。"},{"spoiler":false,"text":"『碧海より深き魔女』と呼ばれ、街の人々からも親しまれていた彼女だが"},{"spoiler":false,"text":"ある日自身の発明品の事故により莫大な借金を負ってしまい……？"},{"spoiler":false,"text":"ピトスの街の郊外、静謐な森に住む\"当代の魔女\"。"},{"spoiler":false,"text":"魔女とは魔動学をおさめ、なおかつ【高次存在の海】と呼ばれる領域に到達した、歴史上十二人のみ存在する偉大な賢人に送られる称号である。"},{"spoiler":false,"text":"『碧海より深き魔女』と呼ばれ、街の人々からも親しまれていた彼女だがある日自身の発明品の事故により莫大な借金を負ってしまい……。"}],"source":"bangumi","sourceCharacterId":"160835"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67e82fa787dcb765528428e4265a4a08b7b7b969f767df0ffa8effcd73894996.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a3cb1525cddc905aeb624ca56b0b2997dfcd9b4dd5097c1de488f178427b396.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_160836","characterName":"サキュバス","sourceIds":{"bangumi":[{"characterId":"160836","match":"source-roster","subjectId":"480959"}]},"originalCharacterName":"サキュバス","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"街の外に眠る遺跡【パンドールの大坑道】にてテテュスが出会うことになるエルフ。"},{"spoiler":false,"text":"この世界ではエルフと言えば、\"ところかまわずセックスする恥知らずの種族\"として知れ渡っているが……?"},{"spoiler":false,"text":"■エルフ"},{"spoiler":false,"text":"この世界において、エルフは別名 『サキュバス』 とも呼ばれ軽蔑されています。"},{"spoiler":false,"text":"サキュバスとは、古の時代に存在し精気をむさぼったという伝説の種族のこと。"},{"spoiler":false,"text":"エルフがその名を受け継いだのは 『常に発情しところかまわず盛ろうとする』"},{"spoiler":false,"text":"習性をもつ亜人種だからです。"},{"spoiler":false,"text":"かろうじて言葉は通じるものの、常に性交のことしか頭にない彼女たちと"},{"spoiler":false,"text":"まともに会話をすることは不可能でしょう。"},{"spoiler":false,"text":"※このキャラのエロシーンはありま……スピンオフで描きたいと思ってます。"}],"source":"bangumi","sourceCharacterId":"160836"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c672a78f64b9232992cbe802975546baab03b3d6012120450f675a2cfc3f9093.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f5504a4c08c82118a7ae09f101a4f6ab36e4f4fcf50367f1ab6d262c2c83dff.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_160837","characterName":"???","sourceIds":{"bangumi":[{"characterId":"160837","match":"source-roster","subjectId":"480959"}]},"originalCharacterName":"???","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【パンドールの大坑道】遺跡、その奥深くにてたたずむ謎の人物。"},{"spoiler":false,"text":"彼女はこの世界にまつわる重大な秘密を握っている。"}],"source":"bangumi","sourceCharacterId":"160837"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36aa6ee037a58ab8be5d8cf3274604f20e45d591a4892876ebde2142a275cb4f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5ce3c5f6afe059c6f1c65f1e703333b078bb73fa62b6c895fffc0579d41eb8a6.webp","width":236,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_160838","characterName":"ルトゥ","sourceIds":{"bangumi":[{"characterId":"160838","match":"source-roster","subjectId":"480959"}]},"originalCharacterName":"ルトゥ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ピトスの街に居を構える『ラバルトゥグループ』の代表。"},{"spoiler":false,"text":"【彼女】が保有する企業はアハズ・シッピング・カンパニー、ラバルトゥ債権回収会社、ラバルトゥプロジェクトなど多岐に渡り、その権力ははかりしれない。"},{"spoiler":false,"text":"【彼】は【その温厚そうなひげを蓄えた紳士面】に似合わずきわめて冷酷、非情な性格でも知られており、部下からは【マダム】と呼びおそれられている。"},{"spoiler":false,"text":"■ルトゥ"},{"spoiler":false,"text":"ピトスの街に居を構える 『ラバルトゥグループ』 の代表。"},{"spoiler":false,"text":"莫大な借金を背負った主人公に、親切にも返済手段を提示してくれる"},{"spoiler":false,"text":"魔女の協力者 です。"},{"spoiler":false,"text":"まずはルトゥの言葉に従い、行動してみましょう。"},{"spoiler":false,"text":"※このキャラのエロシーンはありません"}],"source":"bangumi","sourceCharacterId":"160838"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/258d6f5b373d3fc11ee376fd9eec798060c5adfb04893b02fafe4761a3b3bad8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f5451698ab9b9892ad086312182b92f24a1069acc6179eeb555ae089caae700.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_160840","characterName":"スピンオフ","sourceIds":{"bangumi":[{"characterId":"160840","match":"source-roster","subjectId":"480959"}]},"originalCharacterName":"スピンオフ","characterNameSource":null,"role":"配角","status":"s