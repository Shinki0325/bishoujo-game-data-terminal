tyStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"O"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"},"weight":{"reviewState":"source-only","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ゲームのメインヒロイン。"},{"spoiler":false,"text":"中流家庭で何不自由なく幸せに育った優等生で、学園のアイドル的存在。"},{"spoiler":false,"text":"学園生の代表で組織する自治委員会の委員長でもある。"},{"spoiler":false,"text":"清純で、誰にでも優しく、困っている人を見ると放っておけない。"},{"spoiler":false,"text":"頭脳明晰、母性的で潔癖症。正義感が強く、"},{"spoiler":false,"text":"スイートナイツとなって学園を守る ことに強い使命感を持っている。"},{"spoiler":false,"text":"将来は外交官を目指しており、難民を救うために尽くしたいと考えている。"},{"spoiler":false,"text":"国際上級官僚を育成する総合部国際科に属している。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"2055","spoiler":false},{"segments":[{"spoiler":false,"text":"『魔法戦士スイートナイツ』のヒロイン。"},{"spoiler":false,"text":"清楚で正義感の強いスイートナイツの中心的存在。"},{"spoiler":false,"text":"メッツァーに対して敵同士以上の想いがある。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"10418","spoiler":false},{"segments":[{"spoiler":false,"text":"第一世代魔法戦士のリーダー格。"},{"spoiler":false,"text":"現在はかつての学び舎である国際教導学園に復学し、外交官となるための勉強を続けながら、特別講師として時折後輩たちのために教鞭を執っている。"},{"spoiler":false,"text":"明るく積極的な性格で、誰からも好かれる優等生。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"17330","spoiler":false},{"segments":[{"spoiler":false,"text":"メッツァーの宿敵。"},{"spoiler":false,"text":"清純な容姿と純真な正義の心に、淫らな肉体を併せ持つ美しい戦士。"},{"spoiler":false,"text":"一度覚えてしまった被虐の悦びからは二度と逃げられない……。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"18638","spoiler":false},{"segments":[{"spoiler":false,"text":"「こんな自分にはもう、魔法戦士の資格なんてないのかも……」"},{"spoiler":false,"text":"スイートナイツの一人。"},{"spoiler":false,"text":"現在地上で活動している魔法戦士たちのリーダー格。"},{"spoiler":false,"text":"明るく積極的な性格で、誰からも好かれる優等生。"},{"spoiler":false,"text":"国際教導学園で特別講師を務めていたが、講師退任後行方が分からなくなっている。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士スイートナイツ」ほか"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士のリーダー格の一人。"},{"spoiler":false,"text":"明るく積極的な性格で、誰からも好かれる優等生。"},{"spoiler":false,"text":"以前の戦いで、悪の野望を防ぐためにゲートに飛び込み、取り込まれたままいまだ帰還していない。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"26584","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士スイートナイツのリーダー、スイートリップ。本名は七瀬凛々子。"},{"spoiler":false,"text":"世界の支配を企む悪と戦い続けてきた歴戦の魔法戦士。その優しさと悪に屈することない強さで他の魔法戦士たちからも慕われている。"},{"spoiler":false,"text":"以前の戦いでゲートと呼ばれる魔導演算装置に取り込まれ、しばらくの間消息不明となっていたが、仲間たちによって無事救出される。"},{"spoiler":false,"text":"しかし、異空間に長期間囚われたことで、彼女は戦うための力を失ってしまう。 現在は国際教導学園の学生として、自身の次の道を模索している。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"スイートナイツの一人、魔法戦士スイートリップ。"},{"spoiler":false,"text":"現在は特別魔法外交官として活躍している。"},{"spoiler":false,"text":"かつて倒した悪の組織の残党が暗躍しているという情報を聞き、調査へと赴く。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"37809","spoiler":false},{"segments":[{"spoiler":false,"text":"ゲームのメインヒロイン。"},{"spoiler":false,"text":"中流家庭で何不自由なく幸せに育った優等生で、 学園のアイドル的存在。学園生の代表で組織する 自治委員会の委員長でもある。"},{"spoiler":false,"text":"清純で、誰にでも優しく、困っている人を見ると 放っておけない。頭脳明晰、母性的で潔癖症。正義感が強く、スイートナイツとなって学園を守る ことに強い使命感を持っている。"},{"spoiler":false,"text":"将来は外交官を目指しており、難民を救うために 尽くしたいと考えている。国際上級官僚を育成す る総合部国際科に属している。"}],"source":"bangumi","sourceCharacterId":"96131"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a55f22b1500af098caa60ce65d63437402b9533e4ccf14fd5f2b6885b1dece56.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93e929f8899aaac84d2e6c72f4e17d6fda8fad73948c4bd180803979c036d637.webp","width":154,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c47590","characterName":"エリクシル・ローズ","sourceIds":{"bangumi":[{"characterId":"96146","match":"exact-normalized-name-in-linked-work","subjectId":"222233"}],"egsCharacterIds":["2315"],"vndbCharacterId":"c47590"},"originalCharacterName":"エリクシル・ローズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"理知的で強い意志を持つエリクシルナイツの一人。"},{"spoiler":false,"text":"対ファルケ・シルヴァ抵抗組織『白薔薇』のメンバーとして"},{"spoiler":false,"text":"エリクシルライムを取り戻そうと、アマギスにてシルヴァと戦い続けている。"}],"source":"egs","sourceCharacterId":"2315","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"優しく丁寧な言葉づかいのお嬢様だが、やはり正義のためには熱いハートを剥き出しにする。"},{"spoiler":false,"text":"年長者の責任重圧の中、正義と性欲の葛藤に苦しむ。"}],"source":"egs","sourceCharacterId":"2315","sourceWorkId":"19685","spoiler":false},{"segments":[{"spoiler":false,"text":"「今回の事件……シルヴァが関係しているに違いありませんわ」"},{"spoiler":false,"text":"エリクシルナイツの一人。"},{"spoiler":false,"text":"成績優秀、理知的で強い意志を持ち、一見クールで近寄りがたい印象を与えるが、亜梨子がシルヴァに下っていたときも彼女を信じ続けるという友情に厚い一面も併せ持つ。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士エリクシルナイツ」ほか"}],"source":"egs","sourceCharacterId":"2315","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士エリクシルナイツの一人、エリクシルローズ。本名は鏡島樹。"},{"spoiler":false,"text":"エリクシルライムこと立花亜梨子とともに、国際教導学園の魔法科で教師として働いている。担当は座学。"},{"spoiler":false,"text":"鞭のように形状を変化させる剣で近距離戦から中距離戦までマルチにこなす万能型。"},{"spoiler":false,"text":"その冷静な判断力で仲間たちの危機を何度も救っている。"}],"source":"egs","sourceCharacterId":"2315","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"『次世代総合研究学園ネクスト』でもトップクラスの成績を誇る聡明な少女。"},{"spoiler":false,"text":"普段の物腰はやわらかいが、己の正しいと思ったことは、例え意見がぶつかり 合っても押し通す激しさも持っている。"},{"spoiler":false,"text":"エリクシルライムとシルヴァの戦いに巻き込まれ、この世界を侵略する者の存在を知り、エリクシルライムに憧れを抱く。"},{"spoiler":false,"text":"そして再びシルヴァと相まみえた時、変容魔法の素質に開花し、 エリクシルローズに変身する。"}],"source":"bangumi","sourceCharacterId":"96146"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7f78ae7e5f7ae0dafc81bd670d7a33bea81f18239e2f97cb087b8165ae83ea0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f33251a4ec7a044b4b87d92102ee08907490d977e77ce43952d98a7e3cccdc94.webp","width":114,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c49827","characterName":"立花 亜梨子","sourceIds":{"bangumi":[{"characterId":"96145","match":"exact-normalized-name-in-linked-work","subjectId":"218634"},{"characterId":"96145","match":"exact-normalized-name-in-linked-work","subjectId":"222234"}],"egsCharacterIds":["15748"],"vndbCharacterId":"c49827"},"originalCharacterName":"立花 亜梨子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"優秀な人材を教育・研究する「次世代総合研究学園ネクスト」に通う、元気で明るい少女。"},{"spoiler":false,"text":"ネクストに誘致されただけのことはあり、勉強はできるが、少々、天然ボケな面も垣間見れる。"},{"spoiler":false,"text":"偶然、主人公の空間変容に居合わせた時、彼女の魔法素質が開花し、「エリクシルナイツ」へと変身する。"}],"source":"egs","sourceCharacterId":"15748","sourceWorkId":"9763","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士エリクシルライム"},{"spoiler":false,"text":"がさつでぶっきらぼうだが涙もろい。"},{"spoiler":false,"text":"文武両道に長け、何処のクラブにも所属してない事から助っ人として様々な分野で活躍している。"},{"spoiler":false,"text":"クラス委員長も務めているが本人が好きでなった訳ではなく菜々芭の推薦。"},{"spoiler":false,"text":"彼女とはよく口げんかをするがよくつるんで行動してもいる"},{"spoiler":false,"text":"神志麻姉妹と同じクラス"}],"source":"egs","sourceCharacterId":"15748","sourceWorkId":"12050","spoiler":false},{"segments":[{"spoiler":false,"text":"国際教導学園の教師。"},{"spoiler":false,"text":"魔法科で実技系の授業を担当している。"},{"spoiler":false,"text":"明るくさっぱりした性格で、生徒からの人気も高い。"},{"spoiler":false,"text":"エリクシルナイツの一人、エリクシルライムでもある彼女は、エメロードナイツやイクシードナイツを時に厳しく、時に優しく指導する。"}],"source":"egs","sourceCharacterId":"15748","sourceWorkId":"27830","spoiler":false},{"segments":[{"spoiler":false,"text":"明るく元気が取り柄の少女。"},{"spoiler":false,"text":"優秀な人材を引き入れて教育・研究をしている『次世代総合研究学園ネクスト』に 誘致されて来ているだけのことはあり、勉強は出来る。"},{"spoiler":false,"text":"だが、少し天然なところもある。"},{"spoiler":false,"text":"偶然シルヴァの空間変容の現場に立ち会い、亜梨子の中に眠る変容魔法 『メタモライズ』の素質が開花してしまう。"},{"spoiler":false,"text":"シルヴァから奪ったエリクシルブレスを手に、亜梨子は変容魔法でエリクシルライムに 変身して、彼の野望に立ち向かう。"}],"source":"bangumi","sourceCharacterId":"96145"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/747dbeb6d79b7fc217c6a1b48d4c9b553e0592fa5e051bdd8ccfe6499e419d5a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b1851f076012f46e6b68d4ab7755bd8d3bebf561ffc8a85acbf3fbd9fea085e.webp","width":114,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c125387","characterName":"ダークネスティア","sourceIds":{"vndbCharacterId":"c125387"},"originalCharacterName":"ダークネスティア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/090eabc32c158cad3931c82b86f939d904958e665d15e00a51fe1120d1f35b25.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/8130d8d6e80e501f41917dbd56a53eebb4c31b541862d6f6c11a887e61843d2f.webp","width":205,"height":2