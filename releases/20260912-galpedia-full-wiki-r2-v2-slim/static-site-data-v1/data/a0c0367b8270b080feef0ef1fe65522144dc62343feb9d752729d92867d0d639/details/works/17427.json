bel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:91214","source":"vndb"}]},"cast":[{"characterId":"char_c11520","characterName":"妹尾 睦土美","sourceIds":{"bangumi":[{"characterId":"21554","match":"exact-normalized-name-in-linked-work","subjectId":"49517"}],"egsCharacterIds":["1742"],"vndbCharacterId":"c11520"},"originalCharacterName":"妹尾 睦土美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"思いやりがあって家庭的、明るく前向きな女の子。"},{"spoiler":false,"text":"いつの日かお兄ちゃんに食べてもらう為に、ずっと努力していたので料理が上手。"},{"spoiler":false,"text":"非常識な世界からやって来た妹たちには振り回されっぱなしであるが、妹たちの中では数少ない常識人で、ややつっこみに回ることが多い。"}],"source":"egs","sourceCharacterId":"1742","sourceWorkId":"17427","spoiler":false},{"segments":[{"spoiler":false,"text":"思いやりがあって家庭的、明るく前向きな女の子。"},{"spoiler":false,"text":"いつの日かお兄ちゃんに食べてもらうために、ずっと努力していたので料理が上手。"},{"spoiler":false,"text":"非常識な世界からやって来た妹たちには振り回されっぱなしであるが、妹たちの中では数少ない常識人で、ややツッコミに回ることが多い。"},{"spoiler":false,"text":"「お兄ちゃんとまたいっしょに暮らせるんだね」"}],"source":"bangumi","sourceCharacterId":"21554"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5ca6f843ff9e9ed053094932b37e19252485d477e3ae2fcc05fb7dbde31fd248.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/157189c14802121b6faf42549f4af9c93f41b68c7228043703a1063371c49113.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:49517:21554:6016:1","source":"bangumi"}]},{"characterId":"char_c11521","characterName":"リンカ・シスターテール","sourceIds":{"bangumi":[{"characterId":"21555","match":"exact-normalized-name-in-linked-work","subjectId":"49517"}],"egsCharacterIds":["1743"],"vndbCharacterId":"c11521"},"originalCharacterName":"リンカ・シスターテール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ファンタジー世界からやって来た、職業魔法使いの妹。性格は気弱で大人しく、守ってあげたくなるような女の子。お兄ちゃんに会いに来たら、すでにいろいろな世界の妹がいて、かなりおされ気味の様子。事件が起こった際に正確な事象を言い当てたりするが、気弱な性格が災いして発言できないまま流されてしまう。"}],"source":"egs","sourceCharacterId":"1743","sourceWorkId":"17427","spoiler":false},{"segments":[{"spoiler":false,"text":"ファンタジー世界からやって来た、職業・魔法使いの妹。"},{"spoiler":false,"text":"性格は気弱でおとなしく、守ってあげたくなるような女の子。"},{"spoiler":false,"text":"お兄ちゃんに会いに来たら、すでに色々な世界の妹がいて、かなり押され気味の様子。"},{"spoiler":false,"text":"事件が起こった際に正確な事象を言い当てたりするが、気弱な性格が災いして発言できないまま流されてしまう。"},{"spoiler":false,"text":"「あぅあぅあぅ、お兄ちゃんたすけて～～～」"}],"source":"bangumi","sourceCharacterId":"21555"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d1448fcc3cefbb622a5bc9f5e53e69a25c5bd448a3b1265606ec59c8f0618af.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99d542c97681ad4e91198e89acf81faa56a75c508b8972f561bb38f051e3ed63.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:49517:21555:5052:1","source":"bangumi"}]},{"characterId":"char_c11522","characterName":"妹尾・L・霞空","sourceIds":{"bangumi":[{"characterId":"21556","match":"exact-normalized-name-in-linked-work","subjectId":"49517"}],"egsCharacterIds":["1744"],"vndbCharacterId":"c11522"},"originalCharacterName":"妹尾・L・霞空","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"超能力世界からやって来た、スーパーサイキック少女。"},{"spoiler":false,"text":"その気になれば超絶パワーで地球を逆回転させたりできるのだが、めんどくさいのでそんなことはしない。"},{"spoiler":false,"text":"他の妹たちと結託して、おかしなことをやったりするが、全く懲りない悪びれない。そして、お兄ちゃんに怒られてしまうのであった。"}],"source":"egs","sourceCharacterId":"1744","sourceWorkId":"17427","spoiler":false},{"segments":[{"spoiler":false,"text":"超能力世界からやって来た、スーパーサイキック少女。"},{"spoiler":false,"text":"その気になれば超絶パワーで地球を逆回転させたり出来るのだが、めんどくさいのでそんなことはしない。"},{"spoiler":false,"text":"他の妹たちと結託しておかしなことをやったりするが、まったく懲りない悪びれない。"},{"spoiler":false,"text":"そして、お兄ちゃんに怒られてしまうのであった。"},{"spoiler":false,"text":"「バカっていうな！　バカって！」"}],"source":"bangumi","sourceCharacterId":"21556"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2c72bd7168734632562dc70731659768b75e589001cfb1160ed7840c84932f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53f67aea87633bfef293f7be1b3e20b05200e08d89995d1a139d6c12b50836d9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"来海 ぼたん","creatorId":"vndb:s263","sourcePersonId":"vndb:s263","canonicalEntityId":"vndb:s263","name":"儀武 ゆう子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:48445","source":"vndb"}]},{"characterId":"char_c11523","characterName":"妹尾 千風悠","sourceIds":{"bangumi":[{"characterId":"21557","match":"exact-normalized-name-in-linked-work","subjectId":"49517"}],"egsCharacterIds":["1745"],"vndbCharacterId":"c11523"},"originalCharacterName":"妹尾 千風悠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"宇宙からやって来た、お兄ちゃんの“妹”として生み出された有機ヒューマノイド・シスタノイド。"},{"spoiler":false,"text":"性格は、クールでボケタイプ。 そして妙な冗談が好き。"},{"spoiler":false,"text":"壮大な宇宙の話をするのだが、大体は冗談な為、本気で聞いていると損をする。だが、たまーに本当のことを話すので、いろんな意味で質が悪い。"},{"spoiler":false,"text":"こう見えて、ゲームが好きだったりする。"}],"source":"egs","sourceCharacterId":"1745","sourceWorkId":"17427","spoiler":false},{"segments":[{"spoiler":false,"text":"宇宙からやって来た、お兄ちゃんの “妹” として生み出された有機ヒューマノイド “シスタノイド”。"},{"spoiler":false,"text":"性格はクールでボケタイプ。 そして妙な冗談が好き。"},{"spoiler":false,"text":"壮大な宇宙の話をするのだが、大体は冗談なため、本気で聞いていると損をする。"},{"spoiler":false,"text":"だが、たまーに本当のことを話すのでいろんな意味でタチが悪い。"},{"spoiler":false,"text":"こう見えてゲームが好きだったりする。"},{"spoiler":false,"text":"「宇宙では普通ですよ、普通」"}],"source":"bangumi","sourceCharacterId":"21557"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06cc2fe82e10fcfc421980c7e5d70d8a1dda77389fd9417929ad23dd0f47b20e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44a2f19094b93425628de95aff78b386f73e824849e030e54934ae7d705fdd8a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:49517:21557:4810:1","source":"bangumi"}]},{"characterId":"char_c11524","characterName":"ミナ・セノオ","sourceIds":{"bangumi":[{"characterId":"21558","match":"exact-normalized-name-in-linked-work","subjectId":"49517"}],"egsCharacterIds":["1746"],"vndbCharacterId":"c11524"},"originalCharacterName":"ミナ・セノオ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"現代よりも科学文明が進んだ世界からやって来た女の子。"},{"spoiler":false,"text":"妹たちの中では彼女は1つ上のお姉さん。"},{"spoiler":false,"text":"何かあるとまとめ役になることが多い。背伸びしている部分もあるので、そこはお兄ちゃんがフォローしている。"},{"spoiler":false,"text":"未来科学の満載の秘密道具を使って事件を解決したり、逆にトラブルに巻き込まれたりするのであった。"}],"source":"egs","sourceCharacterId":"1746","sourceWorkId":"17427","spoiler":false},{"segments":[{"spoiler":false,"text":"現代よりも科学文明が進んだ世界からやって来た女の子。"},{"spoiler":false,"text":"妹たちの中では彼女は1つ上のお姉さん。 何かあるとまとめ役になることが多い。"},{"spoiler":false,"text":"背伸びしている部分もあるので、そこはお兄ちゃんがフォローしている。"},{"spoiler":false,"text":"未来科学を満載した秘密道具を使って事件を解決したり、逆にトラブルに巻き込まれたりするのであった。"},{"spoiler":false,"text":"「貴方たち、いい加減にしなさい！」"}],"source":"bangumi","sourceCharacterId":"21558"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81146ff0a0b659ac4ef992937f820080f85f26bc6a7aad15fe5122ea431685a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1edd2cc1f78c39eaf9f26b39405af0c3f91a40391e2f30f03f448da876536c7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:49517:21558:4646:1","source":"bangumi"}]},{"characterId":"char_c11525","characterName":"ココロ","sourceIds":{"bangumi":[{"characterId":"21559","match":"exact-normalized-name-in-linked-work","subjectId":"49517"}],"egsCharacterIds":["1747"],"vndbCharacterId":"c11525"},"originalCharacterName":"ココロ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ファンタジー世界から、凛火といっしょにやって来た、わがままフェアリーな女の子。"},{"spoiler":false,"text":"以前からこっちの世界に来ていたので、現代社会の情報は普通に持っている。妹たちとの間柄は、主につっ