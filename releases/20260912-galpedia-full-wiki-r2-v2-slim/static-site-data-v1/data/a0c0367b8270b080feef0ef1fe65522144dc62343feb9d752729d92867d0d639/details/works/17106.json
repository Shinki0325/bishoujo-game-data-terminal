{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"17106","model":{"presentationWorkId":"vndb:v10357","staff":{"artwork":[{"creditedName":"石井彰","creatorId":"vndb:s2469","sourcePersonId":"egs:creator:1754","canonicalEntityId":"vndb:s2469","name":"石井彰","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:105827","source":"egs"}],"scenario":[{"creditedName":"佐野一馬","creatorId":"vndb:s1802","sourcePersonId":"egs:creator:718","canonicalEntityId":"vndb:s1802","name":"佐野一馬","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:105828","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c29119","characterName":"矢田 奈緒","sourceIds":{"bangumi":[{"characterId":"205371","match":"exact-normalized-name-in-linked-work","subjectId":"223589"},{"characterId":"205371","match":"exact-normalized-name-in-linked-work","subjectId":"223917"}],"egsCharacterIds":["5409"],"vndbCharacterId":"c29119"},"originalCharacterName":"矢田 奈緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A gal cheerleader. She is cheerful and trendsetting, with many girls trying to copy her style. Many boys come to the cheerleader to ogle her sexy body. Nao is usually flirty, but has no mercy for lower-class people like the protagonist."}],"source":"vndb","sourceCharacterId":"c29119"},{"segments":[{"spoiler":false,"text":"チア部の中でも一番の人気を誇る今風のギャル娘。"},{"spoiler":false,"text":"明るい性格と均整のとれたエロボディを持ち、チア活動のため、部活をしている男子から神聖視されている。"},{"spoiler":false,"text":"流行に敏感で、ファッションセンスも抜群なため、学園のファッションリーダーでもあり、彼女に憧れ真似をする女子も多い。"}],"source":"egs","sourceCharacterId":"5409","sourceWorkId":"17106","spoiler":false},{"segments":[{"spoiler":false,"text":"美人でチア部に所属している。"},{"spoiler":false,"text":"明るく女子、男子から共に人気がある。"},{"spoiler":false,"text":"一方で文化系や最下層扱いの男子には容赦がない。"},{"spoiler":false,"text":"直紀の巨チンにハマってからは性欲旺盛なラブラブ変態カップルになっている。"},{"spoiler":false,"text":"意外に嫉妬深い面もある。"}],"source":"egs","sourceCharacterId":"5409","sourceWorkId":"17417","spoiler":false},{"segments":[{"spoiler":false,"text":"チア部に所属している美人で今風のギャル。"},{"spoiler":false,"text":"明るく流行に敏感で、彼女のスタイルをマネる女子は多い。"},{"spoiler":false,"text":"男子たちはこぞってチア部を覗きに来て、そのエロい身体つきをオナネタにしている。"},{"spoiler":false,"text":"まさにリア充といった奈緒は、一方で主人公のような文化系や最下層扱いの男子には容赦がない。"}],"source":"bangumi","sourceCharacterId":"205371"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/476587207039be080bc6d6143b94e23a9b36ac707e2161ac2cfe5f7425a0aa3c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a17e4eec9d7f4e291fc0699572eaec5f1a668dbe51eb3660082c3de2936ea266.webp","width":102,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223589:205371:15684:1","source":"bangumi"}]},{"characterId":"char_c29120","characterName":"菊地 美紀","sourceIds":{"bangumi":[{"characterId":"205373","match":"exact-normalized-name-in-linked-work","subjectId":"223589"},{"characterId":"205373","match":"exact-normalized-name-in-linked-work","subjectId":"223917"}],"egsCharacterIds":["5410"],"vndbCharacterId":"c29120"},"originalCharacterName":"菊地 美紀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The ace of the track and field team and an all-around superb athlete. She is stoic and doesn't talk much. She doesn't know much about relationship between men and women and her friends insist that's a waste. Her tanned skin has earned her many admirers and she even has a fan club."}],"source":"vndb","sourceCharacterId":"c29120"},{"segments":[{"spoiler":false,"text":"陸上部に所属するクールなエース部員。"},{"spoiler":false,"text":"さっぱりとした性格とすらりとして無駄のない健康的な肉体美を持ち、彼女を応援するファンクラブがあるほどの人気。"},{"spoiler":false,"text":"美しすぎる学生アスリートしてマスコミの取材も受けており、日本中から将来を期待されている。"}],"source":"egs","sourceCharacterId":"5410","sourceWorkId":"17106","spoiler":false},{"segments":[{"spoiler":false,"text":"陸上部のエース。運動は万能。"},{"spoiler":false,"text":"無表情で口数が少ない。男女関係や女子高生的な遊びには疎い。"},{"spoiler":false,"text":"直紀との巨根セックスにハマって、スポーツ感覚でのがっつりしたセックス、激しいセックスが好みの淫乱肉食系になっている。"}],"source":"egs","sourceCharacterId":"5410","sourceWorkId":"17417","spoiler":false},{"segments":[{"spoiler":false,"text":"陸上部のエースで運動は万能。 無表情で口数が少ない。"},{"spoiler":false,"text":"男女関係や女子校生的な遊びには疎く、奈緒やるいからは素材がいいのにもったいないと、よくぼやかれている。"},{"spoiler":false,"text":"しかし、ユニフォームから覗く健康的な肌が密かに男子に人気であり、ファンクラブまである始末。"}],"source":"bangumi","sourceCharacterId":"205373"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93ada71546f38241624af3c39eb9e3b735b0b5aadd3b5bfce7572897cb0ecfe3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b50d3eab1effb0dea2d014dc5572ba3bf0b0bf4355d3fd17892b46aba84434de.webp","width":95,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひうらまさこ","creatorId":"vndb:s916","sourcePersonId":"vndb:s916","canonicalEntityId":"vndb:s916","name":"ひうら まさこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223589:205373:26251:1","source":"bangumi"}]},{"characterId":"char_c29121","characterName":"椎名 るい","sourceIds":{"bangumi":[{"characterId":"205375","match":"exact-normalized-name-in-linked-work","subjectId":"223589"},{"characterId"