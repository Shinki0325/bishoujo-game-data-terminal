{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"19694","model":{"presentationWorkId":"vndb:v13789","staff":{"artwork":[{"creditedName":"あいざわひろし","creatorId":"vndb:s9177","sourcePersonId":"egs:creator:20337","canonicalEntityId":"vndb:s9177","name":"あいざわひろし","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:125805","source":"egs"}],"scenario":[{"creditedName":"鷹羽シン","creatorId":"vndb:s6494","sourcePersonId":"egs:creator:14332","canonicalEntityId":"vndb:s6494","name":"鷹羽シン","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:125806","source":"egs"}],"music":[],"other":[{"creditedName":"鷹羽シン","creatorId":"vndb:s6494","sourcePersonId":"egs:creator:14332","canonicalEntityId":"vndb:s6494","name":"鷹羽シン","detail":"原作","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:126954","source":"egs"},{"creditedName":"鷹羽 シン","creatorId":"vndb:s6494","sourcePersonId":"vndb:s6494","canonicalEntityId":"vndb:s6494","name":"鷹羽 シン","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:104189","source":"vndb"}]},"cast":[{"characterId":"char_c22912","characterName":"氷堂 伊吹","sourceIds":{"bangumi":[{"characterId":"53396","match":"exact-normalized-name-in-linked-work","subjectId":"90777"}],"egsCharacterIds":["3171"],"vndbCharacterId":"c22912"},"originalCharacterName":"氷堂 伊吹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"氷王学園2年生で生徒会長。容姿端麗頭脳明晰の完璧美少女。"},{"spoiler":false,"text":"生徒会長として他の生徒の見本となるべく徹底した校則遵守でストイックに自身を律して隙の無い完璧さ。"},{"spoiler":false,"text":"その怜悧な容貌と纏うクールな雰囲気で「高速のアイスクイーン」という異名で呼ばれている。その完璧さ故に周囲に人が集まり辛いのも怜悧さを際立たせているところもあり。"},{"spoiler":false,"text":"というのが表向きで"},{"spoiler":false,"text":"自分の部屋に戻ると、気が引き締まるからという言い訳とともにボンテージタイプのエナメルレオタードでむっちりとした肢体をぴっちりと包み込み、その拘束感に体を火照らせ、一人えっちをしてしまうという性癖有り。最近ではそれもモノ足りず、ひそかに制服の下にエナメルレオタードを着込んだまま学園へ行く程に。"},{"spoiler":false,"text":"しかし、ある日、生徒会の作業中、悪戯な風がスカートを翻し"},{"spoiler":false,"text":"一緒に作業していた主人公に思わず見られてしまうというアクシデント。"},{"spoiler":false,"text":"それ以来、何も言ってこない主人公を逆に気にしてしまっている"}],"source":"egs","sourceCharacterId":"3171","sourceWorkId":"19694","spoiler":false},{"segments":[{"spoiler":false,"text":"氷王学園2年生で生徒会長。 容姿端麗、頭脳明晰の完璧美少女。"},{"spoiler":false,"text":"生徒会長として他の学生の見本となるべく、徹底した校則遵守でストイックに自身を律する隙の無い完璧さ。"},{"spoiler":false,"text":"その完璧さ故に周囲に人が集まり辛いのも、さらに怜悧さを際立たせることになっている。"},{"spoiler":false,"text":"というのが表向きで、自分の部屋に戻るとボンテージタイプのエナメルレオタードでむっちりとした肢体をぴっちりと包み込み、その拘束感に身体を火照らせひとりエッチをしてしまう性癖持ち。"},{"spoiler":false,"text":"最近はそれでも物足りず、密かに制服の下にエナメルレオタードを着込んで学園へ通うほどに。"},{"spoiler":false,"text":"しかしある日、生徒会の作業中に主人公にそれを見られてしまうアクシデントに遭遇。"},{"spoiler":false,"text":"それ以来、何も言ってこない主人公を逆に気にしてしまっている。"}],"source":"bangumi","sourceCharacterId":"53396"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c9caf7da286156883994285c76e6de18b15e8d374fe4c544954587925cb0f9c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61592ca6f59f572222911043f524761e5b4cfff03b29f51af64c12845ee7b0b6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"冬原 透木","creatorId":"vndb:s15296","sourcePersonId":"vndb:s15296","canonicalEntityId":"vndb:s15296","name":"冬原 透木","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55696","source":"vndb"}]},{"characterId":"char_vndb_c47646","characterName":"糸野 博人","sourceIds":{"vndbCharacterId":"c47646"},"originalCharacterName":"糸野 博人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authorita