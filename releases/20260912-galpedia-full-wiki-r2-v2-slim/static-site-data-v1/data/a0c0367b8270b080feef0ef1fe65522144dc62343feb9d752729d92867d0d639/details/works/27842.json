aracters/v1/images/9b/9b5831a14e9b4dca24efd9670d712afcea353a56266bd77dac4198e1fcc6113f.webp","width":186,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c81595","characterName":"大河内 理人","sourceIds":{"vndbCharacterId":"c81595"},"originalCharacterName":"大河内 理人","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1225"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I need you. If saying it isn't enough... I'll show you.\""},{"spoiler":false,"text":"The all-too sexy prince, born from a miracle"},{"spoiler":false,"text":"Cool x Sexy x Prince"},{"spoiler":false,"text":"Member of HEARTiS and the complete opposite of Akira. He can put on a show so hot it's said to make women pregnant just by watching. Off the stage, he's rather calm and collected, and has never been involved in a scandal. He's also smart; while working as an idol, he graduated at the top of the class from a reputable private university. His parents are in charge of a major hospital, which is an open secret."},{"spoiler":false,"text":"Hobby: horse riding, playing the cello"},{"spoiler":false,"text":"Likes: sushi"},{"spoiler":false,"text":"Hates: bodybuilding sports"},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c81595"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/9062883e7f9e4f08149befa2a4e1a28c9542c17f6c4150d679c58fee3530b8c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd540e1a819aadce205fc3dd87897d2c2e5aa58a912e23422558ce05bc06076