{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"30336","model":{"presentationWorkId":"egs:30336","staff":{"artwork":[{"creditedName":"梅鳥うりり(福永ユミ、福永由美)","creatorId":"vndb:s1081","sourcePersonId":"egs:creator:15748","canonicalEntityId":"vndb:s1081","name":"梅鳥うりり(福永ユミ、福永由美)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:242842","source":"egs"}],"scenario":[],"music":[{"creditedName":"Shade","creatorId":"vndb:s511","sourcePersonId":"egs:creator:957","canonicalEntityId":"vndb:s511","name":"Shade","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:279709","source":"egs"}],"other":[]},"cast":[{"characterId":"char_bangumi_155757","characterName":"村長の娘コルローネ","sourceIds":{"bangumi":[{"characterId":"155757","match":"source-roster","subjectId":"386269"}]},"originalCharacterName":"村長の娘コルローネ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ゲームの舞台「セグルメットの村」の村長の娘。心優しいお人好し。典型的な田舎娘で、高圧的な村長によって世間を知らされないまま育ったために他人を疑うことが苦手。最近になって急速に肉体が成熟しており、精神年齢が身体の成長に追いついていない。そのため知らないうちに村民を誘惑してしまうい、性的な視線によく晒される「魔性」があり、主人公によって「審問」の対象となる。"}],"source":"bangumi","sourceCharacterId":"155757"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a42ab31d611a32d7578482d874cf2c9e0081be83f2d596f1676b63dce7a5933.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df7ec39fdd2bf531d469eda922875261e4b4ee07dec00d50c759698bdad01274.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さいとうよしえ","creatorId":"vndb:s1545","sourcePersonId":"vndb:s1545","canonicalEntityId":"vndb:s1545","name":"さいとう よしえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:386269:155757:20696:1","source":"bangumi"}]},{"characterId":"char_bangumi_156179","characterName":"女司祭ヴェネディア","sourceIds":{"bangumi":[{"characterId":"156179","match":"source-roster","subjectId":"386269"}]},"originalCharacterName":"女司祭ヴェネディア","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔力と頭の良さと家柄と性格の良さ全てを兼ね備え、教会を異例のスピードで出世してきた天才司祭（ビショップ）。きわめて強い能力を持つが、聖女の資格はない。急速に力をつけてきた教団を監視の名目で派遣される。簡単な任務のはずだったが……。優等生で基本的な能力は高いが、性格にちょっとポンコツな所もあり、夢見がちな部分も強い。とくに主人公を、彼女が信奉する『聖人』であるという確信を持つと……。司祭長の息子アレクとは姉弟のように育ってきたており、彼からは婚約者として認識されている。"}],"source":"bangumi","sourceCharacterId":"156179"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/887f6c22017c455baaef478205405a7b89104384ae20f705ec1e10e04d7278dd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bcb9e271102da55ef49c7764e949775de0f78c7f6b0236bc90222bd81ebfcc3f.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"稲荷結","creatorId":"vndb:s18344","sourcePersonId":"vndb:s18344","canonicalEntityId":"vndb:s18344","name":"稲荷 結","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:386269:156179:58865:1","source":"bangumi"}]},{"characterId":"char_bangumi_156180","characterName":"神官令嬢ロゼット","sourceIds":{"bangumi":[{"characterId":"156180","match":"source-roster","subjectId":"386269"}]},"originalCharacterName":"神官令嬢ロゼット","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"女司祭ヴェネディアの後を追ってやってくる、神学校を卒業したばかりの若手神官。優秀な神学生であったヴェネディアに追いつくために努力を重ねており、ハイプリーストクラスの魔術を使用することもできると自称しているが……。気が強く、さらには豪商である親譲りの頭の良さを持っている。主人公がヴェネディアを騙していると疑惑を持ち、周囲を調べ始める……。同じく神学生のアレクという幼馴染がおり、許嫁の関係。彼はその気ではないが、彼女の方は憎からず想っている。"}],"source":"bangumi","sourceCharacterId":"156180"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b28c87abd96ebfdeb43b57e9b04f5b0ba1bcc8c9c4d851c85e1263663557245d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30b86070da1cd9ea9cd16ba0df910ac2da7a83ea29a4145fe2a51449fd16ffbc.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鹿瀬紫卯","creatorId":"vndb:s8642","sourcePersonId":"vndb:s8642","canonicalEntityId":"vndb:s8642","name":"鹿瀬紫卯","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:386269:156180:56841:1","source":"bangumi"}]},{"characterId":"char_bangumi_156184","characterName":"聖騎士ルシィーア","sourceIds":{"bangumi":[{"characterId":"156184","match":"source-roster","subjectId":"386269"}]},"originalCharacterName":"聖騎士ルシィーア","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヒエペリオ教会が誇る聖堂に所属する聖騎士で、神官令嬢ロゼットやヴェネディアと親しい仲。背が低め(低…め？)で可愛らしい外見であるが非常に血の気が濃く、自称聖剣グレイテッドリリムを振り回し、悪を叩き割る武闘派として恐れられている。とくに、背の低さを侮った小さいと言った相手は血だるまになっても殴るのをやめないことがまれによくある。いちおう、生まれは良いところのお嬢様。背が高くなるおまじないもしているが、その効果は全て胸に行ってしまっている。"}],"source":"bangumi","sourceCharacterId":"156184"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09d2c01f4c2cd216efc197c2277b139cd4b4b85b13d1c6ef0002760b665fca41.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7af7e6dcb381ead1aa9f2ff6bd5f45707050940f98382b6f424e0f2a3e166801.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高木遥香","creatorId":"vndb:s18362","sourcePersonId":"vndb:s18362","canonicalEntityId":"vndb:s18362","name":"梅木ちはる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:386269:156184:38844:1","source":"bangumi"}]},{"characterId":"char_bangumi_156209","characterName":"聖女レスタリア","sourceIds":{"bangumi":[{"characterId":"156209","match":"source-roster","subjectId":"386269"}]},"originalCharacterName":"聖女レスタリア","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"神の声を聞ける、聖女の力を持つ少女。線の細い美少女なのだが、「変人」と称しても差し支えない奇妙な言動をする。聖女の力を持っているのは確かなようなのだが、本人は信仰心がさっぱりなく働くのが大嫌い。もともとはただの下級シスターで、聖女になったのは主人公の過去の行いが関係している。それをネタにして教団に居座り、日中部屋に引きこもってぐーたらな生活を満喫する駄目聖女。"}],"source":"bangumi","sourceCharacterId":"156209"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc9bdf4de15df1d28238076b7a946d3de1a26169943047d5e8ac5e0f79f007e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf8ad5f10ba61d9e14e6f100351c2d94ce3b10c562d4bc7a29d2a6e2fb73a861.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:386269:156209:11646:1","source":"bangumi"}]},{"characterId":"char_bangumi_156210","characterName":"上位神官マルグレッテ","sourceIds":{"bangumi":[{"characterId":"156210","match":"source-roster","subjectId":"386269"}]},"originalCharacterName":"上位神官マルグレッテ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"癒しの魔術が得意なハイプリースト。敬虔な教徒であり、怪我人や病人にも分け隔てなく接する女性。性格は真面目なのだが、性的なことに関してはオープンらしく、男性を必要以上に魅了してしまう。そのため、『淫魔』ではないかという疑惑を持たれている。また、ハイプリーストであるのにもかかわらず、あまり術を使わないため、不審がられている。性的なトラブルを除けば、穏やかな性格をした、優しい女性。"}],"source":"bangumi","sourceCharacterId":"156210"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/646f936503c88286bd903569814f96118d3a7b6c796534b4f5e572f9a4cb4208.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02234e3404ee04c1a66fa476090436bc48e6da89a131654e947196bf3f7a6a8a.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:386269:156210:8055:1","source":"bangumi"}]},{"characterId":"char_bangumi_156218","characterName":"地方領主の娘ラシェンヌ","sourceIds":{"bangumi":[{"characterId":"156218","match":"source-roster","subjectId":"386269"}]},"originalCharacterName":"地方領主の娘ラシェンヌ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ゲームの舞台中心にある「セグルメット」村の領主の娘。無能な父に代わって地域をコントロールして村を維持している才媛。村に居るには不釣り合いな高貴さと知恵を持っており、彼女の血筋を感じさせる。貴人であり、ゲーム開始時点では主人公や『教団』と接する機会はありえなさそうだが……。"}],"source":"bangumi","sourceCharacterId":"156218"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b402e1f844acef745db12c4eebc12436de79e2368af1b344a4108744b3cad11.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/9758657638bac5a79103a4b9c0d5e71dffbb91cd387acbcf50b6135284a89a33.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:386269:156218:5075:1","source":"bangumi"}]},{"characterId":"char_bangumi_156220","characterName":"メイドのエネーリア","sourceIds":{"bangumi":[{"characterId":"156220","match":"source-roster","subjectId":"386269"}]},"originalCharacterName":"メイドのエネーリア","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"教団に現れた商人によって献上された亜人奴隷の娘。希少種族エルフィードの血を引いているとされ、ミミが尖っている。家事や性欲処理を目的として売買される奴隷出身だが買われた際に、それなりの教育を受けたらしく、一般市民より学力があるが、メイドらしい雰囲気はない。謎の多いメイド。"}],"source":"bangumi","sourceCharacterId":"156220"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff841cca251bce3366522b38d0c34826962a7ae50b405f73c0bfa1cfa93fabe9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8edca3e3086a025555efd389db842505daa4b17a9ff720bdb22fa24ae95ce68f.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深雪ゆあ","creatorId":"vndb:s26","sourcePersonId":"vndb:s26","canonicalEntityId":"vndb:s26","name":"深雪 ゆあ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:386269:156220:20776:1","source":"bangumi"}]},{"characterId":"char_bangumi_156222","characterName":"魔女キュライア・ウィルチ","sourceIds":{"bangumi":[{"characterId":"156222","match":"source-roster","subjectId":"386269"}]},"originalCharacterName":"魔女キュライア・ウィルチ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"森に隠匿している賢者にして、きわめて高い効能を持つ薬品を調合させる天才薬師。しかしただの天才とは区別して、本人は大天才を自称している。なにかとマイペースな女性で、一応は聖なる教えを広める『教団』の中でも躊躇無く怪しい研究や儀式を進めてしまう。"},{"spoiler":false,"text":"奉仕活動でも大活躍、すべての仕事に良適性を持つ「万能」属性を持ち、通常キャラクターでは発生できない「PHANTASTIC」という結果を出すことが可能。「PHANTASTIC」は「EXCELLENT」が発生した際に再判定されて発生する可能性があり、「SUCCESS」の3倍近い上昇値を得る。ただし大天才なので通常の結果は納得できず、「SUCCESS」になると強制的に「FAILURE」にしてしまう。"}],"source":"bangumi","sourceCharacterId":"156222"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1aecf00e479ff65b122710ee6cf4ea717108798866df45cdddbd7ec2c3080881.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/606095dac764d374095eff8e8acf470e29aecfe84231f2b61892add02b59815a.webp","width":145,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田原なおみ","creatorId":"egs:creator:12290","sourcePersonId":"egs:creator:12290","canonicalEntityId":"egs:creator:12290","name":"田原なおみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:386269:156222:56630:1","source":"bangumi"}]},{"characterId":"char_bangumi_156223","characterName":"狂信者ヤンディエラ","sourceIds":{"bangumi":[{"characterId":"156223","match":"source-roster","subjectId":"386269"}]},"originalCharacterName":"狂信者ヤンディエラ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"穏やかな性格をした、主人公を崇拝する普通のシスター。ヴェールが不自然に盛り上がっていたり、もふもふしたものがお尻に見える気がするが、主人公以外がそれを気にすることはない。主人公自体を信仰している、主人公の妻（自称）。そのため、主人公が身も心も捧げている「神」に明確に敵意を持っている。主人公はたとえ神に相容れないものでも受け入れようとするので、当然彼女も受け入れてしまう。"},{"spoiler":false,"text":"穏やかで優しい性格をしているが……？"}],"source":"bangumi","sourceCharacterId":"156223"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/3783b9f506060f0e359002b920f849c6aaab11b630255396bbd9050aea443692.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df714eb0825d3f4a2dfa8b9623d9c8462057f3bf5baf22583653d46effb357f6.webp","width":145,"height":256,"source":"static-detail"},"actors":[{"creditedName":"坂田有希","creatorId":"vndb:s1595","sourcePersonId":"vndb:s1595","canonicalEntityId":"vndb:s1595","name":"坂田 有希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:386269:156223:15687:1","source":"bangumi"}]},{"characterId":"char_bangumi_156225","characterName":"司祭長イペリドーラ","sourceIds":{"bangumi":[{"characterId":"156225","match":"source-roster","subjectId":"386269"}]},"originalCharacterName":"司祭長イペリドーラ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヒエペリオ教会における最大権力者である『司祭長(アークビショップ)』。彼女の一族は代々教会の司祭長の位を独占しており、『司祭長』は男性が世襲している。本来は弟のアレクが後を継ぐはずだったが、弟がよくわからない教団に出向している隙に父親を追放し、立場を簒奪した。その後、迅速に立場を固めた彼女は、『教団』として勢力を伸ばしてきた主人公とコンタクトを取ってくる。"},{"spoiler":false,"text":"主人公とは『司祭』として共に教会に仕えていた過去があり、主人公が追放された原因を作った女性でもある。"},{"spoiler":false,"text":"ちなみに『司祭長(アークビショップ)』というのは人間の世界での最高権力者であり、天の世界での上位地位として『司教(エンジェル)』がある。『司教(エンジェル)』たちは人間の世界にやってくるが、特別な資質を持つものにしか見ることができない。"}],"source":"bangumi","sourceCharacterId":"156225"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef97e696fbd643254142f8683b4baa929535535f095c125a25157291658cef60.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94a0d57e6134ec7c31aa11551ea1d68850f72d19e0d81cbabd97ac775d2d5f50.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:386269:156225:5741:1","source":"bangumi"}]},{"characterId":"char_bangumi_75912","characterName":"お金大好きな女主人","sourceIds":{"bangumi":[{"characterId":"75912","match":"source-roster","subjectId":"301467"},{"characterId":"75912","match":"source-roster","subjectId":"386269"},{"characterId":"75912","match":"source-roster","subjectId":"386270"}]},"originalCharacterName":"お金大好きな女主人","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"死神の少女。死にやすい運命を持つ主人公の素質に目を付け、自分の力を分け与えて『死神代行』にした張本人。"},{"spoiler":false,"text":"素っ気ない口調だが、主人公を嫌ってるわけではない。本来は冥界に住んでいるらしい。"},{"spoiler":false,"text":"とってもお金大好きだが、商才はゼロ。嫌いな動物はネズミ。"}],"source":"bangumi","sourceCharacterId":"75912"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee00bc65c88ad505baa7b20e210bab050434840dcfb5e5d00fdb18f1fd62f718.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30ec7bd16e69ee8943295adeae4dce81fcf2943421430aabe1d9f08546da88f5.webp","width":153,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:386269:75912:4830:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p10289","sourceCompanyId":"egs:brand:5233","canonicalEntityId":"vndb:p10289","name":"サークル冥魅亭","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:30336:5233","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
