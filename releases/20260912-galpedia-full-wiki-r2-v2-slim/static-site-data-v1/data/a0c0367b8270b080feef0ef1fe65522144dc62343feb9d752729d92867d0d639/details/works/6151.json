{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"6151","model":{"presentationWorkId":"vndb:v633","staff":{"artwork":[{"creditedName":"亜方逸樹","creatorId":"vndb:s5543","sourcePersonId":"egs:creator:205","canonicalEntityId":"vndb:s5543","name":"亜方逸樹","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:11330","source":"egs"}],"scenario":[{"creditedName":"茉森晶","creatorId":"vndb:s5544","sourcePersonId":"egs:creator:206","canonicalEntityId":"vndb:s5544","name":"茉森晶","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:11329","source":"egs"}],"music":[{"creditedName":"溝口哲也","creatorId":"vndb:s628","sourcePersonId":"egs:creator:3375","canonicalEntityId":"vndb:s628","name":"溝口哲也","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:11331","source":"egs"}],"other":[{"creditedName":"藤野哩","creatorId":"vndb:s12831","sourcePersonId":"egs:creator:12574","canonicalEntityId":"vndb:s12831","name":"藤野哩","detail":"OP曲「姫さま羽ばたく!」、ED曲「輝く世界、幸せの国」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:66495","source":"egs"},{"creditedName":"RMG(Rainbow-Motion-Graphics)","creatorId":"vndb:s2828","sourcePersonId":"egs:creator:12859","canonicalEntityId":"vndb:s2828","name":"RMG(Rainbow-Motion-Graphics)","detail":"OPムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:68191","source":"egs"},{"creditedName":"亜方 逸樹","creatorId":"vndb:s5543","sourcePersonId":"vndb:s5543","canonicalEntityId":"vndb:s5543","name":"亜方 逸樹","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:13327","source":"vndb"},{"creditedName":"茉森 晶","creatorId":"vndb:s5544","sourcePersonId":"vndb:s5544","canonicalEntityId":"vndb:s5544","name":"茉森 晶","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:13330","source":"vndb"},{"creditedName":"茉森 晶","creatorId":"vndb:s5544","sourcePersonId":"vndb:s5544","canonicalEntityId":"vndb:s5544","name":"茉森 晶","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:13331","source":"vndb"},{"creditedName":"茉森 晶","creatorId":"vndb:s5544","sourcePersonId":"vndb:s5544","canonicalEntityId":"vndb:s5544","name":"茉森 晶","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:13332","source":"vndb"},{"creditedName":"藤野哩","creatorId":"vndb:s12831","sourcePersonId":"vndb:s12831","canonicalEntityId":"vndb:s12831","name":"藤野哩","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:13333","source":"vndb"}]},"cast":[{"characterId":"char_c82528","characterName":"最美 千名希","sourceIds":{"bangumi":[{"characterId":"144192","match":"exact-normalized-name-in-linked-work","subjectId":"131744"}],"egsCharacterIds":["26410"],"vndbCharacterId":"c82528"},"originalCharacterName":"最美 千名希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"森で行き倒れているところをテュロウに助けられる、異世界から来た少女。"},{"spoiler":false,"text":"喜怒哀楽がハッキリ表れる活発な性格で、よく喋る。"},{"spoiler":false,"text":"といっても、図々しい訳ではなく良い意味で普通の女の子。"},{"spoiler":false,"text":"王子の身分を気にすることなく、テュロウにツッコミを入れる。"},{"spoiler":false,"text":"知らない世界で不安も多いはずながら、割と順応が早い。"},{"spoiler":false,"text":"アニメ好きだったらしく、ヒロイン願望が強いのか、ついつい事件に巻き込まれてしまう。"},{"spoiler":false,"text":"幼い頃から続けていた剣道の技で、自分の身を守ろうと考えている。"},{"spoiler":false,"text":"常に元の世界へ戻ることを考えているが、この世界の人間がのんびりした者ばかりで頼りにならないのが悩みの種。"}],"source":"egs","sourceCharacterId":"26410","sourceWorkId":"6151","spoiler":false},{"segments":[{"spoiler":false,"text":"森で行き倒れているところをテュロウに助けられる、異世界から来た少女。喜怒哀楽がハッキリ表れる活発な性格で、よく喋る。が、反面、消極的なところも見せる。"},{"spoiler":false,"text":"初対面の時、胸を触られた事で「セクハラ王子」とテュロウを嫌っている。"},{"spoiler":false,"text":"知らない世界で不安も多いはずながら、割と順応が早い。アニメ好きだったらしく、ヒロイン願望が強い。そのため、ついつい事件に巻き込まれてしまう。幼い頃から続けていた剣道の技で、自分の身を守ろうと考えている。"},{"spoiler":false,"text":"常に元の世界へ戻ることを考えているが、この世界の人間がのんびりした者ばかりで頼りにならないのが悩みの種。"},{"spoiler":false,"text":"「ちょっと見直したつもりだったのに！　この…プリンス・オブ・ワイセツ！！」"}],"source":"bangumi","sourceCharacterId":"144192"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea2d5db9dcd8f38b9d4af1c28ca3fd7ee05a934b4315d9ae05804393675d84b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82752cf28270b45d60fcacf8940685e29c6d1f9aefd59e59d3c575577365c752.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"嶋崎はるか","creatorId":"vndb:s1013","sourcePersonId":"vndb:s1013","canonicalEntityId":"vndb:s1013","name":"嶋崎 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:131744:144192:6302:1","source":"bangumi"}]},{"characterId":"char_c82530","characterName":"みさら","sourceIds":{"bangumi":[{"characterId":"144193","match":"exact-normalized-name-in-linked-work","subjectId":"131744"}],"egsCharacterIds":["26411"],"vndbCharacterId":"c82530"},"originalCharacterName":"みさら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ルナリーディの東隣、アスバの王女。"},{"spoiler":false,"text":"スラリと細い体型と、切れ長の目が特徴のクールビューティ。"},{"spoiler":false,"text":"気が強く、上からものを言うような態度だが、権力を振りかざす事はない。"},{"spoiler":false,"text":"冷静に見えて、心の中では熱い性格。"},{"spoiler":false,"text":"国を思う気持ちが、かなり強い。"},{"spoiler":false,"text":"テュロウとは、父親同士が喧嘩するそばで馴染んだ、という変則幼なじみ。"},{"spoiler":false,"text":"国同士の仲が悪いことを案じている。"},{"spoiler":false,"text":"学内でも構わず帯剣していて、事あるごとにテュロウに突きつけてくる。"},{"spoiler":false,"text":"その剣に秘密があるからなのか、一定時間鞘から出していると酔っぱらってしまうという危険な癖(?)がある。"},{"spoiler":false,"text":"みさらの持つ血鳴は、その剣に関係のある力らしい。"}],"source":"egs","sourceCharacterId":"26411","sourceWorkId":"6151","spoiler":false},{"segments":[{"spoiler":false,"text":"ルナリーディの東隣、アスバ国の王女。スラリと細い体型と、すぐ閉じてしまう細い目が特徴のクールビューティ。"},{"spoiler":false,"text":"態度はキツいが、王女である事を鼻に掛ける訳ではなく、話してみると意外にまとも。テュロウとは幼い頃から馴染んだ仲で、いつもだらしない所を指摘してくる。自国に誇りを持っているが、国同士の仲が悪いことを案じている。学校内でも構わず帯剣しており、事あるごとにテュロウに突きつけてくる。その剣には何か特別な秘密があるらしく、一定時間剣を抜いていると酔っぱらってしまうという危険な癖を持っている。みさらの持つ血鳴は、その剣に関係のある力らしい。"},{"spoiler":false,"text":"「ふふ…みさらを愚弄するとどうなるか、思い知らせてくれよう」"}],"source":"bangumi","sourceCharacterId":"144193"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa62b4b8e8767bda408c535660f253bbca76a8bae220b8901d5df17007d60cc8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1c63e07bd992f8b1c3f9ead26a641760905e52f26976a09ce6811a5f375498d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤静","creatorId":"vndb:s516","sourcePersonId":"vndb:s516","canonicalEntityId":"vndb:s516","name":"伊藤 静","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:131744:144193:4272:1","source":"bangumi"}]},{"characterId":"char_c82532","characterName":"マナフィーゼ","sourceIds":{"bangumi":[{"characterId":"144194","match":"exact-normalized-name-in-linked-work","subjectId":"131744"}],"egsCharacterIds":["26412"],"vndbCharacterId":"c82532"},"originalCharacterName":"マナフィーゼ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ルナリーディの第二子で、テュロウの姉。"},{"spoiler":false,"text":"美しい金髪と赤い瞳を持つ。"},{"spoiler":false,"text":"その姿は年齢不相応に幼く、記憶の曖昧なテュロウは「妹じゃないのか」と疑う。"},{"spoiler":false,"text":"過去の出来事に原因があるらしいが…。"},{"spoiler":false,"text":"国の未来はもちろん、家族の事を大事に思う優しい性格。"},{"spoiler":false,"text":"押しが弱そうに見えて芯は強く、だらしない弟をいつもたしなめている。"},{"spoiler":false,"text":"体調がいつも不安定で、たびたび吐血…ではなく、鼻血を出してしまう。"},{"spoiler":false,"text":"体にハンデを抱えているため、王位継承に関しては一歩退いたところがあり、"},{"spoiler":false,"text":"テュロウを立派な指導者になるよう教育中。"}],"source":"egs","sourceCharacterId":"26412","sourceWorkId":"6151","spoiler":false},{"segments":[{"spoiler":false,"text":"ルナリーディの第二子で、テュロウの姉。美しい金髪と赤い瞳を持つ。その姿は年齢不相応に幼く、記憶の曖昧なテュロウが「妹じゃないのか？」と感想を漏らすほど。その原因は、過去に受けた傷により、見た目年齢が少しずつ逆行しているため。体調がいつも不安定で、すぐに吐血…ではなく鼻血を出してしまう。"},{"spoiler":false,"text":"国の未来を常に案ずる、兄弟のなかで一番王位継承者らしい性格だが、ハンデを持つ自分はふさわしくないと思っている。母親以上にテュロウを気に掛けていて、立派な指導者になるよう口を出してくる。"},{"spoiler":false,"text":"「お姉様とお呼びなさい…と、言っているでしょう？」"}],"source":"bangumi","sourceCharacterId":"144194"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b7e4273720bcd64220e3230250aeef2421023fa85605122eacdc23094bf4ee5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d557103ec9e00f618d1cfa685c6df1a9c8b5a7a69ebb39c2a44b513d6253c019.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本井えみ","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:131744:144194:4177:1","source":"bangumi"}]},{"characterId":"char_c82533","characterName":"シャンレナ","sourceIds":{"bangumi":[{"characterId":"144196","match":"exact-normalized-name-in-linked-work","subjectId":"131744"}],"egsCharacterIds":["26413"],"vndbCharacterId":"c82533"},"originalCharacterName":"シャンレナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"国を持たない種族『グルミウ』の少女。"},{"spoiler":false,"text":"四つの国とは違う血の色と特殊な身体部位を持つグルミウは、他の人間から否定され続けてきた。"},{"spoiler":false,"text":"そんな人間達に抗議するため、ルナリーディ家の屋敷にある霊樹ミルビの枝の上に現れる。"},{"spoiler":false,"text":"無口で無愛想。"},{"spoiler":false,"text":"どんな時でも警戒を忘れず、信用できるのは、仲間だけだと思っていた。"},{"spoiler":false,"text":"が、他の人間とは違う価値観を持ったテュロウに興味を持ち、距離をとりながらも少しずつ近寄ってくる。"},{"spoiler":false,"text":"性の知識が間違っていたり偏っていたりで、色々といじられる事も？"}],"source":"egs","sourceCharacterId":"26413","sourceWorkId":"6151","spoiler":false},{"segments":[{"spoiler":false,"text":"国を持たない種族『グルミウ』の少女。ルナリーディ家の屋敷にそびえ立つ霊樹ミルビと関係があるらしく、たびたび木の上に現れる。"},{"spoiler":false,"text":"普通とは違う血の色と、動物のような身体部位を持つグルミウは、他の人間から否定され続けてきた。どんな時でも警戒を忘れず、周りの人間はすべて敵のように思っているらしい。"},{"spoiler":false,"text":"身分も何も関係なく憎まれ口を叩く彼女に、テュロウは興味をそそられる。「同じ人間を差別するなど馬鹿げている」と考えるテュロウは、なんとか彼女と会話を成立させたいと考える。"},{"spoiler":false,"text":"「アタシのこと、○○だと思ってバカにしてるみぅ。これでも…グルミウの重要人物みぅ」"}],"source":"bangumi","sourceCharacterId":"144196"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bf922e4c9614c3af15ab4639b6f0865ba65e49bbe2caac45960dc2cb0adfb0a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80535c59b2878edfba3d22be6404612ccd760cd0ee505148f0713b2f34bc7e35.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:131744:144196:4714:1","source":"bangumi"}]},{"characterId":"char_c82534","characterName":"ハナ","sourceIds":{"bangumi":[],"egsCharacterIds":["26415"],"vndbCharacterId":"c82534"},"originalCharacterName":"ハナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"テュロウと千名希が果無の森で出会う小さな妖精。"},{"spoiler":false,"text":"その姿は、森へ入った者にしか見えないらしい。"},{"spoiler":false,"text":"幼い外見に似合わず年増な喋り方で、テュロウや千名希に色々なことを教える情報屋のような存在。"},{"spoiler":false,"text":"何か重要な事を隠しているようにも見えるが、常にあっけらかんとした楽観的な性格。"},{"spoiler":false,"text":"常に千名希の側にいる事から、彼女を監視しているようにも見える？"}],"source":"egs","sourceCharacterId":"26415","sourceWorkId":"6151","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c0b948b4bc172b251110d058192f0aba76ce4f38e1fe261f918feb3b85c735e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3ba6e69b6694e3b4feebe741e8b2478983419162288b906d2976d2e5732a26ad.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c82535","characterName":"ゆちや","sourceIds":{"bangumi":[{"characterId":"144198","match":"exact-normalized-name-in-linked-work","subjectId":"131744"}],"egsCharacterIds":["26416"],"vndbCharacterId":"c82535"},"originalCharacterName":"ゆちや","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アスバとの国交が盛んなマヤカヤ国の王女。"},{"spoiler":false,"text":"みさらの凛々しい姿に心底憧れていて、「あれこそが王女のあるべき姿だ」と考えている。"},{"spoiler":false,"text":"みさらに楯突く千名希や、みさらと縁の強いテュロウを面白く思っていないが、基本的に人前では猫を被っているため、あまり強く言えないでいる。"},{"spoiler":false,"text":"一応、クラスの委員長。"},{"spoiler":false,"text":"ぽっちゃり気味な体型を、ちょっと気にしているらしい。"}],"source":"egs","sourceCharacterId":"26416","sourceWorkId":"6151","spoiler":false},{"segments":[{"spoiler":false,"text":"アスバとの国交が盛んなマヤカヤ国の王女。みさらの凛々しい姿に心底憧れていて「あれこそが王女のあるべき姿だ」と考えている。"},{"spoiler":false,"text":"みさらに楯突く千名希や、みさらと縁の強いテュロウを面白く思っていないが、基本的に人前では猫を被っているため、あまり強く言えないでいる。"},{"spoiler":false,"text":"「あ、あ、みさら姫、待って下さい～」"}],"source":"bangumi","sourceCharacterId":"144198"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/571cd1915443c48649e638eb839a2c33d96c7245a263a82fa3d7172c7e0634b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c67085f3e366db2bf71cc4d2ddf6a86d2e673ba816fd4930439714ac75b5ab06.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:131744:144198:4646:1","source":"bangumi"}]},{"characterId":"char_c82536","characterName":"アティリーン","sourceIds":{"bangumi":[{"characterId":"144197","match":"exact-normalized-name-in-linked-work","subjectId":"131744"}],"egsCharacterIds":["26414"],"vndbCharacterId":"c82536"},"originalCharacterName":"アティリーン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ルナリーディ王家に仕えるテュロウ付きのロイヤルメイド。"},{"spoiler":false,"text":"豊かな胸と丸みを帯びたボディラインの母性的な出で立ちで、テュロウが心身共に預けられる数少ない人物の一人。"},{"spoiler":false,"text":"テュロウが幼い頃から世話をしており、二人きりの時は本当の家族のように接する事も。"},{"spoiler":false,"text":"場合によってテュロウに抱かれることもあるが、決して隷属的な行為ではなく、面倒を見るという一貫した考えの延長。"}],"source":"egs","sourceCharacterId":"26414","sourceWorkId":"6151","spoiler":false},{"segments":[{"spoiler":false,"text":"ルナリーディ王家に仕えるロイヤルメイド。テュロウが小さい頃から側に付いているため、家族のような接し方をする。"},{"spoiler":false,"text":"豊かな胸と丸みを帯びたボディラインの母性的な出で立ちで、テュロウが心身共に預けられる数少ない人物の一人。場合によってテュロウに抱かれる事もあるが、決して隷属的な行為ではなく、テュロウの面倒を見るという一貫した考えの延長のようだ。"},{"spoiler":false,"text":"「テュロウ様が恋心を理解される日まで、私の体はあなた様の物です」"}],"source":"bangumi","sourceCharacterId":"14419