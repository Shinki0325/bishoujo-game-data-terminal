nfirmed","relationId":"bangumi:character-voice:44934:64074:11646:1","source":"bangumi"}]},{"characterId":"char_c31250","characterName":"天翔 羽衣佳","sourceIds":{"bangumi":[{"characterId":"64071","match":"exact-normalized-name-in-linked-work","subjectId":"44934"}],"egsCharacterIds":["980"],"vndbCharacterId":"c31250"},"originalCharacterName":"天翔 羽衣佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【総天然毒舌娘】"},{"spoiler":false,"text":"主人公の幼馴染。何かと面倒見のいい性格で、料理が得意な事もあり、主人公の世話を焼く。"},{"spoiler":false,"text":"基本的に天真爛漫で嘘をついたり誤魔化すのが苦手。"},{"spoiler":false,"text":"何もかもあけすけに言ってしまう性格のおかげで、一刀両断に真実の刀を突き立てる天然毒舌。"},{"spoiler":false,"text":"卓球は初心者だが、素直さと持ち前の運動神経でめきめきと上達していく。"},{"spoiler":false,"text":"主人公に恋心を抱いているものの、なかなか言い出せない乙女な一面も……。"},{"spoiler":false,"text":"「スイマセン、たっくんは人として最低なだけなんです、気にしないで下さい」"}],"source":"egs","sourceCharacterId":"980","sourceWorkId":"17393","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼なじみ。"},{"spoiler":false,"text":"なにかと面倒見のいい性格で、料理が得意なこともあり、主人公の世話を焼く。"},{"spoiler":false,"text":"基本的に天真爛漫で、嘘をついたりごまかすのが苦手。"},{"spoiler":false,"text":"何もかもあけすけに言ってしまう性格のおかげで、一刀両断に真実の刀を突き立てる天然毒舌。"},{"spoiler":false,"text":"卓球は初心者だが、素直さと持ち前の運動神経でめきめきと上達していく。"},{"spoiler":false,"text":"主人公に恋心を抱いているものの、なかなか言い出せない乙女な一面も……。"},{"spoiler":false,"text":"「スイマセン、たっくんは人として最低なだけなんです、気にしないで下さい」"}],"source":"bangumi","sourceCharacterId":"64071"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e52ffe1803093edf8232876e281889b695f4204c9ce754665572c31439b45e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18644af9626babfc0665d8688acf94aef6f861af347aef54dffe2e20234d9c8b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"早瀬弥生",