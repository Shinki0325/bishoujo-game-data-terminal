s/v1/images/de/dea106ee578977a4b26dc393cfaa68400d1a4588366b6e3ab0ba936b3247b1c3.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c27206","characterName":"天川 湊月","sourceIds":{"bangumi":[{"characterId":"27476","match":"exact-normalized-name-in-linked-work","subjectId":"114270"}],"egsCharacterIds":["5657"],"vndbCharacterId":"c27206"},"originalCharacterName":"天川 湊月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student and Yuuma's classmate. Mitsuki comes from a traditional miko family which has served the whale god for centuries; she is very proud of her role and position in the family."}],"source":"vndb","sourceCharacterId":"c27206"},{"segments":[{"spoiler":false,"text":"天洲学園に通う２年生で主人公のクラスメート。"},{"spoiler":false,"text":"性格は真面目で大人びた雰囲気があり、人付き合いが上手く誰からでも好かれるタイプ。"},{"spoiler":false,"text":"おまけに正義感が強く行動力もあり、優等生の風格を漂わせている。"},{"spoiler":false,"text":"しかしフリーダムな主人公の予想できない言動に惑わされることが多く、照れたり恥じらうといった可愛らしい一面を晒してしまう。"},{"spoiler":false,"text":"豊満なバストの持ち主であり、いつも周囲から集まる視線が悩みどころ。"},{"spoiler":false,"text":"代々鯨神に使える家系であり、鯨神の御使いとして神事などを担当する。"},{"spoiler":false,"text":"現在鯨神はいないとされているので形骸化しているが、彼女はその役割に対して強いプライドを持っている。"}],"source":"egs","sourceCharacterId":"5657","sourceWorkId":"21118","spoiler":false},{"segments":[{"spoiler":false,"text":"天洲学園に通う2年生で、主人公のクラスメイト。"},{"spoiler":false,"text":"性格はまじめで大人びた雰囲気があり、人付き合いが上手く誰からでも好かれるタイプ。"},{"spoiler":false,"text":"おまけに正義感が強く行動力もあり、優等生の風格を漂わせている。"},{"spoiler":false,"text":"しかしフリーダムな主人公の予想できない言動に惑わされることが多く、照れたり恥じらうといった可愛らしい一面を晒してしまう。"},{"spoiler":false,"text":"豊満なバストの持ち主であり、いつも周囲から集まる視線が悩みどころ。"},{"spoiler":false,"text":"代々 “鯨神” に仕える家系であり、鯨神の御使いとして神事などを担当する。"},{"spoiler":false,"text":"現在鯨神はいないとされているので形骸化しているが、彼女はその役割に対して強いプライドを持っている。"}],"source":"bangumi","sourceCharacterId":"27476"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5fce6f39fb0183a03fac94305d9746c97d60547ed2b465a741099cdd9df98cbf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/3138beb085693d58002291b0c6e039cd796092562addb027e287254e672c97e9.webp","width":84,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原舞","creatorId":"vndb:s985","sourcePersonId":"vndb:s985","canonicalEntityId":"vndb:s985","name":"石原 舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:114270:27476:13372:1","source":"bangumi"}]},{"characterId":"char_c27207","characterName":"成海 真莉音","sourceIds":{"bangumi":[{"characterId":"27477","match":"exact-normalized-name-in-linked-work","subjectId":"114270"}],"egsCharacterIds":["5658"],"vndbCharacterId":"c27207"},"originalCharacterName":"成海 真莉音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year student and Yuuma's non-blood-related sister. She loves her brother very much. She came to Amanoshima island in order to research \"condensed energy water\" for some totally \"pure and innocent\" purposes. Marine is also the one who kidnapped Yuuma and brought him to Amanoshima Island."}],"source":"vndb","sourceCharacterId":"c27207"},{"segments":[{"spoiler":false,"text":"天洲学園の１年生で主人公の義妹。"},{"spoiler":false,"text":"何事も全て兄を基準に考えて行動し、その常軌を逸した溺愛っぷりは周囲の状況に関係なく盛大に発揮される。"},{"spoiler":false,"text":"行き過ぎた愛ゆえに主人公を島へ拉致した張本人。"},{"spoiler":false,"text":"妹という関係に一切の憂いはなく、むしろ他人より近い存在として誇りに思っている。"},{"spoiler":false,"text":"もちろん将来の夢は、お兄ちゃんのお嫁さんになること。"},{"spoiler":false,"text":"常に主人公を誘惑しようと色気アタックを仕掛けるが、まだ一度も成功していない。"},{"spoiler":false,"text":"『願いが叶う水』の伝承を信じ込み、天洲学園に入学した。"},{"spoiler":false,"text":"学園から専用の研究室を与えられるほど、本格的にエネルギー水に関して日夜研究を行っている。"}],"source":"egs","sourceCharacterId":"5658","sourceWorkId":"21118","spoiler":false},{"segments":[{"spoiler":false,"text":"天洲学園の1年生で、主人公の義妹。"},{"spoiler":false,"text":"何事もすべて兄を基準に考えて行動し、その常軌を逸した溺愛っぷりは周囲の状況に関係なく盛大に発揮される。"},{"spoiler":false,"text":"行き過ぎた愛ゆえに主人公を島へ拉致した張本人。"},{"spoiler":false,"text":"妹という関係に一切の憂いはなく、むしろ他人より近い存在として誇りに思っている。"},{"spoiler":false,"text":"もちろん将来の夢は、お兄ちゃんのお嫁さんになること。"},{"spoiler":false,"text":"常に主人公を誘惑しようと色気アタックを仕掛けるが、まだ一度も成功していない。"},{"spoiler":false,"text":"“願いが叶う水” の伝承を信じ込み、天洲学園に入学した。"},{"spoiler":false,"text":"学園から専用の研究室を与えられるほど本格的に、エネルギー水に関して日夜研究を行っている。"}],"source":"bangumi","sourceCharacterId":"27477"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/3213eaa9ecfa4263c7ae91ed312508edb0940eddbaa2e9f46998efd378a33b70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a7ab2bdc60dcb16c8de63f2ca824c49bdbdcb9a823c0232779a716312f5fab6.webp","width":100,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:114270:27477:5075:1","source":"bangumi"}]},{"characterId":"char_c27208","characterName":"上遠野 恵那","sourceIds":{"bangumi":[{"characterId":"27478","match":"exact-normalized-name-in-linked-work","subjectId":"114270"}],"egsCharacterIds":["5