ndb","sourceCharacterId":"c27209"},{"segments":[{"spoiler":false,"text":"天洲アイランドを守護する鯨神様（らしい）。"},{"spoiler":false,"text":"自由奔放で無邪気。その言動は子供そのもの。"},{"spoiler":false,"text":"自分が神様であることを自慢してきたりするが、幼い見た目のせいもあってなかなか信じてもらえない。"},{"spoiler":false,"text":"神様と言う割には世間知らずで、見たことや聞いたことのない物に対してはものすごい興味を示してくる。"},{"spoiler":false,"text":"現在は神としての能力がほとんど発揮できないらしく、御使いに任命した主人公をはじめ、ヒロインたちと共に本来の力を取り戻すための方法を探していく。"}],"source":"egs","sourceCharacterId":"5660","sourceWorkId":"21118","spoiler":false},{"segments":[{"spoiler":false,"text":"天洲アイランドを守護する鯨神様（らしい）。"},{"spoiler":false,"text":"自由奔放で無邪気。 その言動は子供そのもの。"},{"spoiler":false,"text":"自分が神様であることを自慢してきたりするが、幼い見た目のせいもあってなかなか信じてもらえない。"},{"spoiler":false,"text":"神様と言うわりには世間知らずで、見たことや聞いたことのない物に対してはものすごい興味を示してくる。"},{"spoiler":false,"text":"現在は神としての能力がほとんど発揮できないらしく、御使いに任命した主人公をはじめ、ヒロインたちと共に本来の力を取り戻すための方法を探していく。"}],"source":"bangumi","sourceCharacterId":"27479"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/534311aea9214b14450bac4cb5c56bdff4a4c009df831535738966617e393477.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20689c675e39bc05bb45a5a8c2d3f2144dfc369ae1991a4e0b94cc8daa02356e.webp","width":153,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:114270:27479:11646:1","source":"bangumi"}]},{"characterId":"char_c27210","characterName":"仙堂 桜子","sourceIds":{"bangumi":[{"characterId":"30066","match":"exact-normalized-name-in-linked-work","subjectId":"114270"}],"egsCharacterIds":["5661"],"vndbCharacterId":"c27210"},"originalCharacterName":"仙堂 桜子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"re