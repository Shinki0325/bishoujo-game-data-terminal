":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/feb69ad00448b6309ac80b5e5f4e6c12aebbaa1a6b578716a0c6c7b36d784491.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50535fbb47dda4884cccb044e7b8ecbcb8a122661c5efe261b63a0c2d4048b48.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野 早稀","creatorId":"vndb:s21346","sourcePersonId":"vndb:s21346","canonicalEntityId":"vndb:s21346","name":"小野 早稀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92082","source":"vndb"}]},{"characterId":"char_vndb_c112895","characterName":"朝霧 楓乃","sourceIds":{"vndbCharacterId":"c112895"},"originalCharacterName":"朝霧 楓乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A track and field runner who attends a university known for their top-class runners, Kaeno was aiming to run on a global stage, but an injury has left her in need of rehabilitation. Hearing rumors of a masterful massage therapist, she heads to Relaxation Yubihara for treatment. However, it seems that her injury is already healed when she arrives."},{"spoiler":false,"text":"From Gematsu"}],"source":"vndb","sourceCharacterId":"c112895"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/326d034bd7fda7b6315f9713b2a942cfca990aa9b8674e888ff00279402462c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b02263a5256a60effae8907f507e8961d1bb6e75f83839fa050ad7e6ec8776e4.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白石 晴香","creatorId":"vndb:s7593","sourcePersonId":"vndb:s7593","canonicalEntityId":"vndb:s7593","name":"白石 晴香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92078","source":"vndb"}]},{"characterId":"char_vndb_c112896","characterName":"雨宮 夢結","sourceIds":{"vndbCharacterId":"c112896"},"originalCharacterName":"雨宮 夢結","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mei’s metal band is still just an indie act, but they’re amazingly famous among those in the know. Excessive headbanging has left her with a neck injury that, according to doctors, could even endanger her life! Still, she can’t stop giving her all to the music. She visits Relaxation Yubihara to have her neck fixed. While she’s usually withdrawn and awkward, get her excited and her personality makes a 180 and she goes on the attack!"},{"spoiler":false,"text":"From Gematsu"}],"source":"vndb","sourceCharacterId":"c112896"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c64995d9e8f0fa5f1394b6b10eef0f7daa81042c9f5f6638470c9a5338637569.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b64fc108ad56f1a728ea16e3c1f16a4d76f635fff72ba060b1645d7d98b53be.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西 明日香","creatorId":"vndb:s11043","sourcePersonId":"vndb:s11043","canonicalEntityId":"vndb:s11043","name":"西明日香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92079","source":"vndb"}]},{"characterId":"char_vndb_c112897","characterName":"南雲 椿","sourceIds":{"vndbCharacterId":"c112897"},"originalCharacterName":"南雲 椿","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A newly-appointed high school teacher. Because she’s new and a woman, she takes on a firm attitude at work to make sure her students and coworkers don’t take her lightly. However, in pursuit of her identity as the ideal teacher, she ends up driving herself into a corner. Putting on a front and hiding her true self have left her mentally and physically exhausted and in need of help at Relaxation Yubihara."},{"spoiler":false,"text":"From Gematsu"}],"source":"vndb","sourceCharacterId":"c112897"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5fa582374fabcf7170cc05aacec058fc969dcdb48d233014ca59d6d42dc8544b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd4334a2da77ee762cd4f7ca22749cc87744f6851e8cda3d28ec719b9b0bf65f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真野 あゆみ","creatorId":"vndb:s18145","sourcePersonId":"vndb:s18145","canonicalEntityId":"vndb:s18145","name":"真野 あゆみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92081","source":"vndb"}]},{"characterId":"char_vndb_c112898","characterName":"雪白 千鶴","sourceIds":{"vndbCharacterId":"c112898"},"originalCharacterName":"雪白 千鶴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The manager of Atsushi’s apartment building. A few years ago, she lost her husband to an accident. Her thoughtful nature and kindness lead her to make food for Atsushi, whose nutritional intake is all over the place, and help him out with his life. She has Atsushi give her massages in exchange for letting him keep Momiji. After the first massage, she takes a liking to receiving them and begins to regularly visit Relaxation Yubihara."},{"spoiler":false,"text":"From Gematsu"}],"source":"vndb","sourceCharacterId":"c112898"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/814cb0f0e38d5ffd6b8c79ac976740fb6eeddf05d768039000563e12b548576e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/4384b6a5528794e246abd42112f6609d0fa8a3f0fee8ff1f32fc2f7886d7619d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅倉 杏美","creatorId":"vndb:s1089","sourcePersonId":"vndb:s1089","canonicalEntityId":"vndb:s1089","name":"浅倉 杏美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92076","source":"vndb"}]},{"characterId":"char_vndb_c112899","characterName":"指原 圧志","sourceIds":{"vndbCharacterId":"c112899"},"originalCharacterName":"指原 圧志","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c112900","characterName":"嵐城 花蓮","sourceIds":{"vndbCharacterId":"c112900"},"originalCharacterName":"嵐城 花蓮","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A woman of many mysteries appears to collect the debt left behind by Atsushi’s grandfather, the previous owner. She gives him a month-long grace period to complete the repayment. However, she also seems to have some deep connections to the previous owner…"},{"spoiler":false,"text":"From Gematsu"}],"source":"vndb","sourceCharacterId":"c112900"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8bae2684198be7f848d0bc78388903e6d4fc2203364f16cb5b8ded05602357fe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22972ebdc292109044aba651748511442418e28144d88f27c8670d100646fb95.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中 理恵","creatorId":"vndb:s1665","sourcePersonId":"vndb:s1665","canonicalEntityId":"vndb:s1665","name":"田中理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92077","source":"vndb"}]},{"characterId":"char_vndb_c112901","characterName":"もみじ","sourceIds":{"vndbCharacterId":"c112901"},"originalCharacterName":"もみじ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A fairy-like being that lives in the massage parlor, having been a good friend to the previous owner. A strange-looking cat, he’s here to guide the protagonist from a fumbling beginner to a dexterous master. He passes on the secret technique, Mystic Art: Pleasure Rush along with the Ultimate: Celestial Wolf Fang Gloves, an item meant to improve its efficacy, to Atsushi."},{"spoiler":false,"text":"From Gematsu"}],"source":"vndb","sourceCharacterId":"c112901"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c464e60c19d1df1f90e502c8d8bb55d15743dd501c6090ef219f1c82b1560564.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5f105e41f9f9cf5e3dbb1c423e343cdb86579c716acaa249ef3d7cd2894f8c7.webp","width":218,"height":256,"source":"static-detail"},"act