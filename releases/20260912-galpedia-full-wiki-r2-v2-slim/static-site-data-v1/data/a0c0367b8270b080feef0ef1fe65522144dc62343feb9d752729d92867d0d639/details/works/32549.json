source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A game-obsessed shut-in, having had his heart broken over his childhood friend during middle school. After dying from acute stress reaction, he is sent to the parallel reality where he becomes a role-playing game character. As an Adventurer class, he learns basic skills such as stealing, archery, monster detection, and magic."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c61496"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5f19643f23b95f218c2a72f1d7cead56732a90856605a0d6f6d6e574e214bf5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed7cdc8077eafb5310f5307bc44616d48b74aeb89cc68fab713b1f57d293619c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"福島 潤","creatorId":"vndb:s395","sourcePersonId":"vndb:s395","canonicalEntityId":"vndb:s395","name":"福島 潤","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85160","source":"vndb"}]},{"characterId":"char_vndb_c61497","characterName":"アクア","sourceIds":{"vndbCharacterId":"c61497"},"originalCharacterName":"アクア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"source-only","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aqua is the goddess of water who judged humans to send to the RPG world, up until Kazuma dragged her along with him. She is an energetic and inattentive girl who likes to receive reverence for her status and gets upset easily. As an Archpriest and a goddess, she is powerful against demons and the undead, and is able to resurrect recently deceased people as well as purify water supplies. Rather than learning skills which would benefit her party, she spends most of her skill points learning party tricks."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c61497"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1ea51a529a279721300902a789a1dff6da6fdfb6a2521644dd75bdfb5acfe99.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9afaf823a993ca4a432b3f4e10ab3011211e18aa275e26c065aff9ba9b16864d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮 天","creatorId":"vndb:s7409","sourcePersonId":"vndb:s7409","canonicalEntityId":"vndb:s7409","name":"雨宮 天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85164","source":"vndb"}]},{"characterId":"char_vndb_c61498","characterName":"めぐみん","sourceIds":{"vndbCharacterId":"c61498"},"originalCharacterName":"めぐみん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"13"},"height":{"reviewState":"source-only","source":"vndb","value":"149"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Megumin is a 13-year-old (14 and 15 later on), archwizard who is part of the crimson demons race; powerful humanoids who possess black hair, red eyes, and chuunibyou characteristics. Megumin only knows a single spell, an incredibly powerful Explosion spell that immediately incapacitates her for the rest of the day when cast, and refuses to learn any other skills."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c61498"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f20ac46c0c0d2b8c8ada34afe779fe38f9de4747041ca4d115611a9c88f0ddaf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15229a13a7825fb6cedfeea12ffa9c5d3012053ca1547f70a5c0c426d65deb00.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋 李依","creatorId":"vndb:s10632","sourcePersonId":"vndb:s10632","canonicalEntityId":"vndb:s10632","name":"高橋 李依","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85165","source":"vndb"}]},{"characterId":"char_vndb_c61499","characterName":"ダスティネス・フォード・ララティーナ","sourceIds":{"vndbCharacterId":"c61499"},"originalCharacterName":"ダスティネス・フォード・ララティーナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"height":{"reviewState":"source-only","source":"vndb","value":"171"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Darkness is a 18-year-old crusader who possesses powerful offense and defense, but lacks the accuracy to deliver her attacks. She is a masochist who dreams of being ravaged by monsters or married to an abusive husband; regardless, she becomes serious with issues involving her friends. She is a noble from the influential Dustiness family, who became a crusader against her father's wishes."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c61499"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/chara