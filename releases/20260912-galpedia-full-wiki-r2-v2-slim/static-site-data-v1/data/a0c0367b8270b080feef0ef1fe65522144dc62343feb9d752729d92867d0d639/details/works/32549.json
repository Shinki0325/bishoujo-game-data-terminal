ndb"}]},{"characterId":"char_vndb_c61501","characterName":"ウィズ","sourceIds":{"vndbCharacterId":"c61501"},"originalCharacterName":"ウィズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Wiz is a powerful lich wizard who, despite being one of the Devil King's generals, is a timid and kind woman who uses her powers to assist civilians and lead lost spirits to the afterlife. She runs an unsuccessful magic shop which is later managed by Vanir, in which she is treated like a slave worker."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c61501"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/9047fbcb2dd5e4c0f4cbc9998bfde6df8e5e4b4b6028269386648b97f0ab37df.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b82536ae8803f4e83cb8ff056c2b77b37005bcffd9a62bbd8b78b37a928fae33.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"堀江 由衣","creatorId":"vndb:s46","sourcePersonId":"vndb:s46","canonicalEntityId":"vndb:s46","name":"堀江 由衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85158","source":"vndb"}]},{"characterId":"char_vndb_c61502","characterName":"クリス","sourceIds":{"vndbCharacterId":"c61502"},"originalCharacterName":"クリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chris is Darkness's friend and a thief who teaches Kazuma the Steal skill."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c61502"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37af160cb2dd72d2179ed88a09505720d4aa1c6c4aeb9e8020b65405f114f25d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b9376f0675219f2fcf794a84b516ac4d1bb177e5521af0338499bf59a8f3fe3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"諏訪 彩花","creatorId":"vndb:s13437","sourcePersonId":"vndb:s13437","canonicalEntityId":"vndb:s13437","name":"諏訪彩花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85166","source":"vndb"}]},{"characterId":"char_vndb_c61503","characterName":"バニル","sourceIds":{"vndbCharacterId":"c61503"},"originalCharacterName":"バニル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Vanir is one of the Devil King's generals who ends up taking over the management of Wiz's magic shop. He is the devil of foresight and one of the dukes of hell and his ability is to read everything about anybody, but he cannot read anything about people that are as powerful as he is (the Devil King's generals and other dukes), people stronger than him (Aqua and other gods), and people who are a little weaker than him. These people have their readings clouded and incomplete. An exception to this is Kazuma, whose cunning nature makes him hard to read. He also has very powerful combat skills that he refuses to use on humans."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c61503"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71359a3678ee3ee574ea4c72506f99a15977073b11b385088541c2b79349a94b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7e870d907318a1eff021115b7d7cff8de15f7c115706ca82965c2e1cb60f174.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西田 雅一","creatorId":"vndb:s2655","sourcePersonId":"vndb:s2655","canonicalEntityId":"vndb:s2655","name":"西田雅一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85162","source":"vndb"}]},{"characterId":"char_vndb_c91709","characterName":"セナ","sourceIds":{"vndbCharacterId":"c91709"},"originalCharacterName":"セナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sena is the special prosecutor of the Kingdom of Belzerg in charge of serious crimes, such as treason and conspiring with the Devil King. She was sent to arrest and investigate Kazuma when the teleported Destroyer core blew up Alderp's mansion. Despite Kazuma's innocence, she remains suspicious of his activities and summons him to solve various situations, including the confrontation with Vanir."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c91709"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6ba888a81bd05084800be4831aec5165633f2d864d6f221aab8881f0988b0d40.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/400447fc343f0526ebcdd521813f1c5b756117fe8c7a94b2bad050524bd6981e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"生天目 仁美",