ewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“霹靂乃舞姫”の二つ（アダ）名を持つ少女。"},{"spoiler":false,"text":"真摯な態度で人と接する、さっぱりした性格の女の子。"},{"spoiler":false,"text":"家事全般が得意で、趣味は料理と他の普通の女の子とまるで変わらない。"},{"spoiler":false,"text":"しかし、自分と同じ魔法少女――ナユタとの出会いによって、彼女の“魔女”としての資質が覚醒する。"}],"source":"egs","sourceCharacterId":"24970","sourceWorkId":"8342","spoiler":false},{"segments":[{"spoiler":false,"text":"基本的にサッパリとした性格で、誰に対しても真摯に接することができる以外は、いたって普通の女のコ。 しかし、魔法少女であるナユタや、ナユタの戦いに関わる様々な事象で“魔女”として覚醒することになる。"},{"spoiler":false,"text":"「キミの恐怖も絶望も、全部ボクが受け止めてあげる」"}],"source":"bangumi","sourceCharacterId":"70309"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dff5487ca0357f82d2b1a02678ffb8fbb0b6340d35a6cf2b1e1d3a5692d03736.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19d70846e5bdebfe81c74f0fe5ded46a078763643f99ec21bd1d403cfd296661.webp","width":139,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:283237:70309:5900:1","source":"bangumi"}]},{"characterId":"char_c59356","characterName":"大塚 伊織","sourceIds":{"bangumi":[],"egsCharacterIds":["24972"],"vndbCharacterId":"c59356"},"originalCharacterName":"大塚 伊織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"イソラのクラスメイト。"},{"spoiler":false,"text":"“ソラくん”“オリちゃん”と言い合える親友の間柄。"},{"spoiler":false,"text":"おっとりした感じのやや天然気味の女の子で、そのお人好しぶりはイソラ以上。"}],"source":"egs","sourceCharacterId":"24972","sourceWorkId":"8342","spoiler":false}],"profileFacts":[