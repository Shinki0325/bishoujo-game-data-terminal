{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"581","model":{"presentationWorkId":"vndb:v5326","staff":{"artwork":[{"creditedName":"零点","creatorId":"vndb:s2804","sourcePersonId":"egs:creator:577","canonicalEntityId":"vndb:s2804","name":"零点","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:1364","source":"egs"}],"scenario":[{"creditedName":"サンドとゆかいな仲間たち","creatorId":"egs:creator:927","sourcePersonId":"egs:creator:927","canonicalEntityId":"egs:creator:927","name":"サンドとゆかいな仲間たち","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:1365","source":"egs"},{"creditedName":"鬼人肉","creatorId":"egs:creator:4628","sourcePersonId":"egs:creator:4628","canonicalEntityId":"egs:creator:4628","name":"鬼人肉","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:16908","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c24810","characterName":"磯崎 真奈","sourceIds":{"vndbCharacterId":"c24810"},"originalCharacterName":"磯崎 真奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mana is the older daughter of the former manager of \"Hotaru Sou\" apartment building. Her father used to live mostly in the United States for work and had recently died in a traffic accident. Mana's mother was also lost in a car accident... While her mother's death was quite manageable for them, losing their father as well was too much. Now Mana has to support her sister Emi all by herself. No wonder Mana's been feeling so lonely, she's been doing a lot of work all by herself. Whilst attends school, she also does all the housework, and as a bonus, her exams are coming up. As a result Mana is quite tired mentally and physically. She suffered a great deal of trauma... Recently she hasn't laughed so much. (Although sometimes she makes quite the smirk...)"},{"spoiler":false,"text":"Translated from Getchu."}],"source":"vndb","sourceCharacterId":"c24810"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca92e2673e3ab37dd27b7bb733e2142293f7fc170141a527e7fd5b1057094675.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f2ec9e228b1ccc547421c4fdc1b5a9444babb3425cbd0cde33557dc1be5baa8.webp","width":150,"height":195,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c24811","characterName":"磯崎 絵美","sourceIds":{"vndbCharacterId":"c24811"},"originalCharacterName":"磯崎 絵美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Emi is the younger daughter of the former manager of \"Hotaru Sou\" apartment building, who recently died in a car accident. She is quite worried about her older sister Mana. Although Emi is still young, she helps to reduce the burden on her sister as much as possible. Emi is waiting for someone to appear, a person who will support and help them cope with their hardship."},{"spoiler":false,"text":"Translated from Getchu."}],"source":"vndb","sourceCharacterId":"c24811"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55232600b02f14db83077b6b3dbaf524f4d95051f186d3900bbc6e81ffdf845c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb9d7a13855218eee27038d2c63e9069b98df9218d7b21407d0da00e97590d28.webp","width":150,"height":199,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c24812","characterName":"姐丹 智香","sourceIds":{"vndbCharacterId":"c24812"},"originalCharacterName":"姐丹 智香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80342451f3ff63e7a8fb73869c2410d4bf60f470958a3ea842d6badb031823bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62922dffa1bbfef8d6cf56cfb3855053ca3dc5dba435fa0e3c9fb4d036ac8f39.webp","width":150,"height":205,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c24813","characterName":"瀬賀 つばめ","sourceIds":{"vndbCharacterId":"c24813"},"originalCharacterName":"瀬賀 つばめ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl from the Kansai region with a booming and characteristic Kansai accent. Tsubame's mother passed on when she was young, and because of it her father became a gambler. Tsubame has been affected by having a gambler father, as a result she became one herself. Since she can remember herself, Tsubame's dream has been of gambling to follow her father to Las Vegas. Aiming to realize her dream, she spends all her time in gambling business day and night. She also is extremely reluctant to rely on people."},{"spoiler":false,"text":"Translated from Getchu."}],"source":"vndb","sourceCharacterId":"c24813"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/080edb6ffeca71beb2941239226f1eddfaf6012b79356e0925c52c962c0b3bce.webp","f