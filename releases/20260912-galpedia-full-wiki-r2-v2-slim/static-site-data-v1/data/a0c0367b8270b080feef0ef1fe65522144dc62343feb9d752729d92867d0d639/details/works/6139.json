db:vn-staff:58495","source":"vndb"},{"creditedName":"egu","creatorId":"vndb:s27218","sourcePersonId":"vndb:s27218","canonicalEntityId":"vndb:s27218","name":"E.G.U","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:58496","source":"vndb"},{"creditedName":"有限会社獏プロダクション","creatorId":"vndb:s4261","sourcePersonId":"vndb:s4261","canonicalEntityId":"vndb:s4261","name":"有限会社獏プロダクション","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:58497","source":"vndb"},{"creditedName":"KTO","creatorId":"vndb:s43473","sourcePersonId":"vndb:s43473","canonicalEntityId":"vndb:s43473","name":"KTOK(KTO)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:58498","source":"vndb"},{"creditedName":"3:16","creatorId":"vndb:s23731","sourcePersonId":"vndb:s23731","canonicalEntityId":"vndb:s23731","name":"ODO 3:16","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:58499","source":"vndb"},{"creditedName":"宮前 光春","creatorId":"vndb:s52273","sourcePersonId":"vndb:s52273","canonicalEntityId":"vndb:s52273","name":"宮前 光春","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:58500","source":"vndb"},{"creditedName":"武蔵野組","creatorId":"vndb:s53249","sourcePersonId":"vndb:s53249","canonicalEntityId":"vndb:s53249","name":"武蔵野組","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:58502","source":"vndb"}]},"cast":[{"characterId":"char_c43006","characterName":"飛鳥 響子","sourceIds":{"bangumi":[{"characterId":"149007","match":"exact-normalized-name-in-linked-work","subjectId":"230373"}],"egsCharacterIds":["26474"],"vndbCharacterId":"c43006"},"originalCharacterName":"飛鳥 響子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"20"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アメリカの大学を飛び級で卒業したほどの才媛。"},{"spoiler":false,"text":"心理学を研究していて、その一環でこのセミナーの講師を担当。勝気で理屈っぽく、向上心のない男が大嫌い。ファザコンの気があり、男の強引さに弱い一面がある。"}],"source":"egs","sourceCharacterId":"26474","sourceWorkId":"6139","spoiler":false},{"segments":[{"spoiler":false,"text":"主任講師"},{"spoiler":false,"text":"米国生まれで米国籍を持つ。父親の仕事の関係で、幼年期より日本と米国を行き来していた。母親は彼女が３歳のとき離婚による離別。男手だけでも愛情一杯に育ててくれた父親を尊敬している。飛び級で米コロムビア大学を卒業。現在、丘山大学心理学研究室で、引きこもりやニートに関しての研究を行っている。このセミナーも研究の一環。カレッジ時代に付き合っていた彼氏と初体験。しかしその男は、彼女の家の金銭目当ての依存人間で、向上心も低い事が判り、２週間で別れる。これがきっかけで心理学へ傾倒していく。"},{"spoiler":false,"text":"愛犬ファルケンハインは一人暮らしのボディーガードとして父親が与えた。名前の由来は「ドイツの犬だから」らしい。（かなりの短絡思考）"},{"spoiler":false,"text":"男は嫌いではないが、ファザコンが災いして理想が高すぎて現在フリー。欲求不満にならない程度、適当にセックスだけの関係はあるようだ。"}],"source":"bangumi","sourceCharacterId":"149007"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8d313e7a63483f0b2e9ad6ada7ea8e1706b79d07c32d452799bc6079dcd2b60.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f9be4942731233a377e82bfdb4f0fc148250c002f95a5ccbb3441667ca16255f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さとう実琴","creatorId":"vndb:s117","sourcePersonId":"vndb:s117","canonicalEntityId":"vndb:s117","name":"真宮鈴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230373:149007:18740:1","source":"bangumi"}]},{"characterId":"char_c43007","characterName":"穴井 優希","sourceIds":{"bangumi":[{"characterId":"149008","match":"exact-normalized-name-in-linked-work","subjectId":"230373"}],"egsCharacterIds":["26475"],"vndbCharacterId":"c43007"},"originalCharacterName":"穴井 優希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"21"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"106"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"178"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"過去にボディービルアジア大会で3位の経歴を持つマッシヴな女のコ。"},{"spoiler":false,"text":"見かけによらず、感動家で、家事全般にも通じている。セックスにはストイックだが、実は一度火がついたら天井知らずの激しさ。セミナーで健康管理を担当。"}],"source":"egs","sourceCharacterId":"26475","sourceWorkId":"6139","spoiler":false},{"segments":[{"spoiler":false,"text":"体力教師"},{"spoiler":false,"text":"丘山大学で運動生理学を学ぶ学生。心理学研究室の韮山助教授の紹介で飛鳥と知り合い、片親同士の環境がきっかけで意気投合。研究を手伝う事になる。セミナー受講生の体調管理・健康管理を全般的にみている。"},{"spoiler":false,"text":"専攻科目の興味から始めたボディービルは、アジア大会３位になるほど"},{"spoiler":false,"text":"一時は夢中になっていたが、２年付き合っていた彼氏にふられたことで、学業専念を理由に休業している。（それでも基礎トレーニングは欠かさない）。セックスはその気になるまで時間が掛かるが、一度火がつくと止まらなくなるほどに激しく底なし。（彼氏がふった原因は、実はこっち）"}],"source":"bangumi","sourceCharacterId":"149008"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/816ba9d5b89d4712192415872eb4decc00cef7bf3f199bad1bc33849b8744638.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb21b2b6736ca17002f5bdf192d0732502fddbcfc6c2c0fe1ac5c62d3c7ca695.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230373:149008:6409:1","source":"bangumi"}]},{"characterId":"char_c43008","characterName":"仲田　乙姫","sourceIds":{"bangumi":[{"characterId":"149009","match":"exact-normalized-name-in-linked-work","subjectId":"230373"}],"egsCharacterIds":["26476"],"vndbCharacterId":"c43008"},"originalCharacterName":"仲田　乙姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"26"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"101"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"I"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"男受けしそうな容姿、母性をムンムンと漂わせているが、実は家事が大の苦手。趣味はセックス（特技：パイズリフェラ）と、貞操観念も相当ゆるい。天然系なのに金勘定に細かく、一級簿記習得。バイセクシャルとの噂も……。事務担当。"}],"source":"egs","sourceCharacterId":"26476","sourceWorkId":"6139","spoiler":false},{"segments":[{"spoiler":false,"text":"天然キャラ"},{"spoiler":false,"text":"男好きのする見掛けとは違い、家事全般が苦手。数字には強く、一級簿記を持っているが、要領が悪いため良い職に就けず丘山大学で教授付きのパート事務をしている。食べ物の好き嫌いも激しく、穴井にとって天敵のようなキャラで、受講生達は彼女が家事全般をやっていると思い込んでいる。（否定もしない）家の事を語らないため真相はナゾ。良家のお嬢様との噂もあるが、貞操観念の低さを考え合わせると……。男性からの誘いは断らないが、特定のステディはいない。"}],"source":"bangumi","sourceCharacterId":"149009"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d760550229063f5de02729a6b8a84d10ad687fa04c1e6430de08cf2757a1387c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3637e7059a98493f09a07cc01f7592f3b4841b384ce0795fdc42248a0372453.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"猫原 ひるね","creatorId":"vndb:s35771","sourcePersonId":"vndb:s35771","canonicalEntityId":"vndb:s35771","name":"猫原 ひるね","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:32696","source":"vndb"}]},{"characterId":"char_c43009","characterName":"荻原 舞花","sourceIds":{"bangumi":[{"characterId":"149010","match":"exact-normalized-name-in-linked-work","subjectId":"230373"}],"egsCharacterIds":["26477"],"vndbCharacterId":"c43009"},"originalCharacterName":"荻原 舞花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"清楚な容貌とゴスロリファッションから、セミナーでアイドル的存在の女のコ。"},{"spoiler":false,"text":"まだ、処女だという噂が人気に拍車をかけているが、実は性格の悪さは講師陣一。ゴスロリインナーで男を足コキする性癖から、懲罰担当。本当の自分の性格を知られるのを極度に恐れている。"}],"source":"egs","sourceCharacterId":"26477","sourceWorkId":"6139","spoiler":false},{"segments":[{"spoiler":false,"text":"清純ゴスロリ少女"},{"spoiler":false,"text":"乙姫が連れてきたアルバイト。詳細プロフィールは不明だが、腹に一物を感じさせる丁寧な言葉遣いが気に入り、飛鳥が採用した。（既に研究対象）見た目とギャップのある懲罰担当。（ゴスロリインナーで、男を陵辱する）その本性を知る受講者（懲罰経験者）は、再懲罰を恐れ、黙して語らず。結果、清純なお嬢様として、セミナー内でアイドル視されている。"}],"source":"bangumi","sourceCharacterId":"149010"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d760788c70490f831f53a3c6338d4c5d6806a8caaf57309b07ccafc1a578b65.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d149a35b85d2b7ecb7351c355906965faf81203bcbf76f9116b8069824b8bb8a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ルーシー","creatorId":"vndb:s15640","sourcePersonId":"vndb:s15640","canonicalEntityId":"vndb:s15640","name":"ルーシー","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:32695","source":"vndb"}]},{"characterId":"char_c43010","characterName":"橘 彩","sourceIds":{"bangumi":[{"characterId":"149011","match":"exact-normalized-name-in-linked-work","subjectId":"230373"}],"egsCharacterIds":["26478"],"vndbCharacterId":"c43010"},"originalCharacterName":"橘 彩","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"物事を冷静に見つめ、洞察力の高い少女。"},{"spoiler":false,"text":"事情があって親の愛情を受けていないため、精神と心がアンバランスで、感情表現が乏しい。本質を見抜く力があるので、講師陣では強烈なつっこみ役。恋愛経験はない"}],"source":"egs","sourceCharacterId":"26478","sourceWorkId":"6139","spoiler":false},{"segments":[{"spoiler":false,"text":"毒舌キャラ"},{"spoiler":false,"text":"両親が障害のある双子の姉に掛かりきりになっていたため、元教師の祖父母のもとで育った。親の愛情を良く知らない。我儘の言えない環境が、彼女に合理的な生き方を選択させた。韮山助教授は母方の叔父にあたり、大学訪問の時にこの話を聞き、夏休み中の研究対象として参加を決める。（ちなみに大学での専攻は心理学）読書好きで、彼女の幅広い知識は読書の賜物。精神と身体とがアンバランスで、異性との恋愛経験は皆無。知識として知ってはいても、現実感が無い。"}],"source":"bangumi","sourceCharacterId":"149011"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73eec2050e72bdfe8685553588d095d961c93816ef25ca14ad7a64732969ff79.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50fb3d796a1b321b56dec03d29c05cc1729304d1c2676231fac94b7911c9dcc4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230373:149011:6409:1","source":"bangumi"},{"creditedName":"萌原 ぶり","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"藤咲 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:32692","source":"vndb"}]},{"characterId":"char_vndb_c133783","characterName":"平原 秀一","sourceIds":{"vndbCharacterId":"c133783"},"originalCharacterName":"平原 秀一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p339","sourceCompanyId":"egs:brand:557","canonicalEntityId":"vndb:p339","name":"West Vision","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:6139:557","source":"egs"},{"companyId":"vndb:p339","sourceCompanyId":"vndb:p339","canonicalEntityId":"vndb:p339","name":"ウェストビジョン","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:12842:v5614","source":"vndb"},{"companyId":"vndb:p339","sourceCompanyId":"vndb:p339","canonicalEntityId":"vndb:p339","name":"ウェストビジョン","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:12843:v5614","source":"vndb"},{"companyId":"vndb:p339","sourceCompanyId":"vndb:p339","canonicalEntityId":"vndb:p339","name":"ウェストビジョン","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:36569:v5614","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
