spoiler":false,"text":"強い信念を持ち突き進む性格をしており、それゆえ他人と衝突することも少なくない。"},{"spoiler":false,"text":"レオとは剣と盾に似た関係。"},{"spoiler":false,"text":"「もっと、レオはわがままでいいと思う。我々を駒として使うぐらいでなくては、共にこの世界の覇者にはなれぬぞ？」"}],"source":"bangumi","sourceCharacterId":"62707"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"62707","value":"ワクワクする事、剣の修行、温泉"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"62707","value":"理不尽な事、寒い地方"},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"13164","sourceWorkId":"11925","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"52 kg","valueContext":null,"source":"egs","sourceCharacterId":"13164","sourceWorkId":"11925","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3dc5cf5ca1a539e3774e8dd57c2c5dcc8a1959cf27a0087f70db89435ab0637c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c34e81ffd53d271a83511594731d2d2b4255c515d70465b65b7a17290c34f84f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"椎名るぅ","creatorId":"vndb:s571","sourcePersonId":"vndb:s571","canonicalEntityId":"vndb:s571","name":"椎名 るぅ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15964:62707:56631:1","source":"bangumi"}]},{"characterId":"char_c16751","characterName":"キリエ・レイソン","sourceIds":{"bangumi":[{"characterId":"62704","match":"exact-normalized-name-in-linked-work","subjectId":"15964"}],"egsCharacterIds":["13161"],"vndbCharacterId":"c16751"},"originalCharacterName":"キリエ・レイソン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false