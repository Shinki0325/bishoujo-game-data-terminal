"sourceCharacterId":"6460","sourceWorkId":"21642","spoiler":false},{"segments":[{"spoiler":false,"text":"中東の国・マリニスタンのお姫様。 日本には語学留学のためにやってきた。"},{"spoiler":false,"text":"いつもニコニコしていて、誰に対しても優しい穏やかな癒し系タイプ。"},{"spoiler":false,"text":"立場の違いから周りが遠慮してしまい、本当に心を開いて話のできる友達がいない。"},{"spoiler":false,"text":"日本に弟がいることを知り、一度会ってみたいとの好奇心から八尋の家を訪れる。"},{"spoiler":false,"text":"「私、日本に来てからひとりでいることが多かったので、あまり優しい言葉をかけられたことがなくて……」"}],"source":"bangumi","sourceCharacterId":"34165"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"34165","value":"甘辛団子、ナン、犬"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"34165","value":"お金、辛いもの"},{"label":"特技","source":"bangumi","sourceCharacterId":"34165","value":"バイオリン、日舞、日本文化の知識"},{"label":"趣味","source":"bangumi","sourceCharacterId":"34165","value":"妄想、読書（BL小説）、コスプレ"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24de98cb6d090933cb91db2ddcfeede32e1f9a34efd9f02e37d25b7a108b8001.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0afa19ae67ea865ab3c0bcfe1ded01c3a7b63119ec811af336852a1e2b71d4f4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:206815:34165:5075:1","source":"bangumi"}]},{"characterId":"char_c32691","characterName":"王 舞華","sourceIds":{"bangumi":[{"characterId":"34166","match":"exact-normalized-name-in-linked-work","subjectId":"126468"}],"egsCharacterIds":["6461"],"vndbCharacterId":"c32691"},"originalCharacterName":"王 舞華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"803"},"bloodType":{"reviewState":"no-co