h":"source-roster","subjectId":"5965"}]},"originalCharacterName":"Prinny","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1ed478436471c5858f408b8af7fa4d66e1fae10abe5dbd06f9168cf677d1ec51.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95638cada8e1978a9ac4116b95273b1cfa93eaa87d82afde18cf7c8521891194.webp","width":226,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間島淳司","creatorId":"vndb:s756","sourcePersonId":"vndb:s756","canonicalEntityId":"vndb:s756","name":"間島 淳司","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:28454:6564:4264:1","source":"bangumi"}]},{"characterId":"char_bangumi_71539","characterName":"Etna","sourceIds":{"bangumi":[{"characterId":"71539","match":"source-roster","subjectId":"28454"},{"characterId":"71539","match":"source-roster","subjectId":"5965"}]},"originalCharacterName":"Etna","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ラハールの家来。年齢は1470歳。フロンよりもマスコット的な要素が強い。一行のツッコミ役。ラハールを凌ぐ野心家で、何よりも自由を愛し、それを邪魔しようとする者には容赦しない。隠し部屋では彼女の過去や心境が書かれた日記を見ることができる。ツルペタ体型を気にしており、特にバストサイズの話題はタブーである。"}],"source":"bangumi","sourceCharacterId":"71539"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfcfc1b2cd68c6414f2cc4449b908f05c4596bae4c8b38017b65411b701e8780.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/161a6c59323069e5492d3c80ef098a52fba51fafe16b946315c02c0765b87e11.webp","width":190,"height":256,"source":"static-detail"},"actors":[{"creditedName":"半場友恵","creatorId":"vndb:s2163","sourcePersonId":"vndb:s2163","canonicalEntityId":"vndb:s2163","name":"半場友恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:28454:71539:4020:1","source":"bangumi"}]},{"characterId":"char_bangumi_86551","characterName":"法尔巴特杰","sourceIds":{"bangumi":[{"characterId":"86551","match":"source-roster","subjectId":"28454"}]},"originalCharacterName":"法尔巴特杰","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公。かつて『暴君』と称され名を馳せた吸血鬼であったが、400年以上前に人間界で出会った人間の少女と交わした約束を守り、吸血鬼でありながら魔力の源である血を吸うことを止めた結果、魔力を失って姿も以前と変わり地獄へと追いやられ、魔界でなりたくない職業No1であるプリニー教育係に就く羽目になった。持ち前のポジティブシンキングでプリニー教育係としての使命にも目覚め、フェンリッヒと共にイワシを主食に地獄で機嫌よく暮らしていたが、政腐が下した「プリニー処分」をきっかけに政腐への反逆を決意。堕落した魔界を再教育するという目的で、政拳奪取を目論む。"},{"spoiler":false,"text":"性格は純粋で前向き。チカラだけでなく知力や統率力も優れるが、長い間地獄に住んでいたために最近の情勢や流行に関しては非常に疎い。契約(約束)の厳守、チカラこそが正義、恐怖による人間への訓戒といった、悪魔本来の生き方・有り方・使命を重要視し、情報操作や人間との取引といった政腐の堕落しきった政策を真っ向から批判するなど、悪魔としての強い責任感とプライドを持つ。一方で、交わした約束を(相手が誰であろうと)意地でも守ろうとしたり、仲間との絆を誰よりも重んじるなど、彼の発想や価値観は悪魔らしからぬところも多く、他の悪魔から異端視されることもある。"},{"spoiler":false,"text":"プリニー教育係は安月給であったため魚の「イワシ」を毎日食しているうちに大のイワシ好きになり、自身の力の源はイワシであると豪語し、至る場面でその素晴らしさを語る。イワシに関する知識も豊富であり、次回予告では次のストーリー紹介そっちのけでその知識を（無理やりにでも）披露する。"},{"spoiler":false,"text":"アルティナに出会う以前の彼は「誇り高き悪魔として、人間を恐怖で戒める」事を責務とし、魔界の権力争いには無関心だった。「仲間や絆を大事にする」という悪魔らしからぬ考えは、時として自分を追い詰める人間の強さの理由とその対策を彼なりに考えた結果たどり着いた考えであった。なお、この暴君時代の彼の力は、毒を盛られても平然としている上にその事に全く気づかない、銀の弾丸を4発撃ち込まれても平静を装える、魔王クラスの力に耐えられる建物の屋根を結界ごと拳でぶち破る、など、暴君と呼ばれるにふさわしい実力の持ち主だった。これほどの力を持ちながら権力欲を持たないため、彼を快く思わないものが多かった。"}],"source":"bangumi","sourceCharacterId":"86551"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/399e46f755ab336af78dd5bf9f327d8fa4093372cce37ed510a1f0d51cb107c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45bb394a8310def78440f8d8271adeb7c4a16b80e7f4ca45a47dfabbf9050c51.webp","width":137,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴木達央","creatorId":"vndb:s376","sourcePersonId":"vndb:s376","canonicalEntityId":"vndb:s376","name":"鈴木 達央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:28454:86551:5031:1","source":"bangumi"}]},{"characterId":"char_bangumi_86552","characterName":"芬利希","sourceIds":{"bangumi":[{"characterId":"86552","match":"source-roster","subjectId":"28454"}]},"originalCharacterName":"芬利希","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヴァルバトーゼに仕える人狼族の青年。"},{"spoiler":false,"text":"主の地位を高めるため様々な画策を行っている。"},{"spoiler":false,"text":"「すべては我が主のために」が口ぐせ。"}],"source":"bangumi","sourceCharacterId":"86552"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d7e551416959a932a960f7fe6ec4ef6030c71141c3a0a07c0a0c2f580225aa1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6dd12ae6bdee947198b893af03aeb05b1b73630199ad9b6036f11304fcf6566e.webp","width":127,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽多野渉","creatorId":"vndb:s60","sourcePersonId":"vndb:s60","canonicalEntityId":"vndb:s60","name":"春野風","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:28454:86552:4620:1","source":"bangumi"}]},{"characterId":"char_bangumi_86553","characterName":"ルーク","sourceIds":{"bangumi":[{"characterId":"86553","