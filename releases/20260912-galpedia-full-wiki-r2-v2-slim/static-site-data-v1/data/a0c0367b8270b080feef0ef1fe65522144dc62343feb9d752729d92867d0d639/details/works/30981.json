ight":{"reviewState":"source-only","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Arcane Card: Rosepink of WANDs"},{"spoiler":false,"text":"A second-year student popular among her peers for being beautiful and fashionable."},{"spoiler":false,"text":"She has a cheerful and lively personality, has many friends, and is the mood maker of the Twilight Club. She's also very athletic and often been asked to help out in the athletic clubs. One of her few flaw is that she's a bit wicked."},{"spoiler":false,"text":"She gets along well with the protagonist, Tomori, and respect him as her senpai. Blessed with great health and a body too well-developed for her own good, it's unknown whether the abundance of her unconscious skinships with Tomori is a sly act or because it was just part of her natural personality."},{"spoiler":false,"text":"She loves to talk about love, and when people talk about it, she can't help but listen to them. She wonders if that kind of intrusion will help her someday. As if impatient for love, nowadays she's reading romance novels and indulging herself in fleeting delusions."},{"spoiler":false,"text":"\"You see, I'm a beautiful and reliable junior, but sometimes I can be a bit ditzy, can't I?\""},{"spoiler":false,"text":"Edited from Official Website"}],"source":"vndb","sourceCharacterId":"c96959"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfe889b3f00f26c404feddbb39116199212877000669ba6b75a19fe879586b2f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87dbbf443affd734efc9ee1d4b806200b34978218f22e9c0f4cf5d091786df34.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"歩 サラ","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87482","source":"vndb"}]},{"characterId":"char_vndb_c97518","characterName":"後代 灯","sourceIds":{"vndbCharacterId":"c97518"},"originalCharacterName":"後代 灯","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"64"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86b8f6dee2bce0e9af006e8e228da1e08d5250d11cab78da60c1e70b90e209a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53b559c635288a4fa96247ae28a3d6af18e86d7df31ef5ccabf31856da5eb3f1.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c98245","characterName":"花ノ香 澄玲","sourceIds":{"vndbCharacterId":"c98245"},"originalCharacterName":"花ノ香 澄玲","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"H"},"height":{"reviewState":"source-only","source":"vndb","value":"149"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Arcane Card: Paleturquoise of CUPS"},{"spoiler":false,"text":"The youngest member of Twilight Club, a junior who is acting as the club's secretary."},{"spoiler":false,"text":"Sumire has a ladylike and quiet personality, and in addition to being the secretary, she serves the club like a maid and does miscellaneous work for all of the members. She has younger siblings at home and is a family-oriented person who takes good care of them while doing all the housework and cooking. She's like a mascot who is loved by everyone."},{"spoiler":false,"text":"The protagonist, Tomori, is no exception. She's very considerate and helped him from time to time even when he messed up or did some questionable behaviors. However, she is a little too conscientious and always puts herself after everyone else, all the while keeping her feelings bottled up deep inside..."},{"spoiler":false,"text":"According to the other girls, she has the biggest cup size in the club despite her petite size."},{"spoiler":false,"text":"\"Ufufu... then let's have a cup of tea. Or maybe, would chocolate have been better?\""},{"spoiler":false,"text":"Edited from Official Website"}],"source":"vndb","sourceCharacterId":"c98245"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77d68653993b15a852b9ab7229d36975a6f941648cfba12b7ceb4755fa90e1b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/240282eb978053d196a0158816e992e17eecf70bad4b8b61566cab8cd29255c6.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤崎 紗矢香","creatorId":"vndb:s6866","sourcePersonId":"vndb:s6866","canonicalEntityId":"vndb:s6866","name":"藤崎 紗矢香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87485","source":"vndb"}]},{"characterId":"char_vndb_c98246","characterName":"星泉 コトナ","sourceIds":{"vndbCharacterId":"c98246"},"originalCharacterName":"星泉 コトナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"G"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"49"}},"descriptions":[],"profileFact