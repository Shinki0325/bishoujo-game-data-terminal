b"},{"creditedName":"中村カンナ","creatorId":"vndb:s21092","sourcePersonId":"vndb:s21092","canonicalEntityId":"vndb:s21092","name":"中村カンナ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:154540","source":"vndb"},{"creditedName":"David Evelyn","creatorId":"vndb:s27805","sourcePersonId":"vndb:s27805","canonicalEntityId":"vndb:s27805","name":"David Evelyn","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:154541","source":"vndb"},{"creditedName":"김 하루","creatorId":"vndb:s21097","sourcePersonId":"vndb:s21097","canonicalEntityId":"vndb:s21097","name":"김 하루","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:154542","source":"vndb"},{"creditedName":"냐미아빠","creatorId":"vndb:s30265","sourcePersonId":"vndb:s30265","canonicalEntityId":"vndb:s30265","name":"냐미아빠","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:154544","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c84250","characterName":"Sua","sourceIds":{"vndbCharacterId":"c84250"},"originalCharacterName":"Sua","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"314"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A fox girl who tirelessly awaits her master."},{"spoiler":false,"text":"Originally cast out from her tribe, she has now since matured beyond anyone's wildest imagination."},{"spoiler":false,"text":"Brash and always seemingly full of confidence, she is actually quite shy in nature."},{"spoiler":false,"text":"She utilizes her hair in order to perform clone spells and sorcery, but she always has a bushy head of hair for some reason."},{"spoiler":false,"text":"Capable of controlling both fire and water, but her unconscious preference is controlling water."},{"spoiler":false,"text":"She casts her spells on people by locking eyes with them. Uses a bevy of spells, some that seduce and some that scare, but she personally likes using the ones that seduce."},{"spoiler":false,"text":"In-game profile"}],"source":"vndb","sourceCharacterId":"c84250"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/5433ace59486257d862d94d7574e467501eda2004f5b6ebf0939d168eb86b6d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f183ef37cb0887ba3a3b7663baf59ce85214e33029ab5ea5597d802d982066eb.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮崎 珠子","creatorId":"vndb:s18757","sourcePersonId":"vndb:s18757","canonicalEntityId":"vndb:s18757","name":"宮崎 珠子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80130","source":"vndb"},{"creditedName":"이 새아","creatorId":"vndb:s18758","sourcePersonId":"vndb:s18758","canonicalEntityId":"vndb:s18758","name":"이 새아","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80131","source":"vndb"}]},{"characterId":"char_vndb_c90363","characterName":"Alin","sourceIds":{"vndbCharacterId":"c90363"},"originalCharacterName":"Alin","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"501"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mentally-fragile reaper who is not only shy but a scaredy-cat."},{"spoiler":false,"text":"While she is fantastically diligent in her duties, that's perhaps the reason why she demands to be teased and demands to be treated with care."},{"spoiler":false,"text":"Her basic skills as a reaper are below average, but she shows extraordinary talent in her specialties."},{"spoiler":false,"text":"Since she doesn't place much value in herself, she tends to let chances for her to display her strength pass her by."},{"spoiler":false,"text":"The type of girl that is intelligent, but lacks the ability to stand up on her own in the world."},{"spoiler":false,"text":"Currently working for Mimiru on various odd jobs."},{"spoiler":false,"text":"In-game profile"}],"source":"vndb","sourceCharacterId":"c90363"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a89c466ce4fad363501b4c7a4750bcbfcfa490ff699d512e2ce60fb63f692ac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7edeef1100ea272f188e489a389ff2f7bf59cb14e073f92f93a3b9575677ac65.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"景山 梨彩","creatorId":"vndb:s16885","sourcePersonId":"vndb:s16885","canonicalEntityId":"vndb:s16885","name":"景山 梨彩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80129","source":"vndb"},{"creditedName":"유보라","creatorId":"vndb:s21093","sourcePersonId":"vndb:s21093","canonicalEntityId":"vndb:s21093","name":"유보라","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80134","source":"vndb"}]},{"characterId":"char_vndb_c90364","characterName":"Mimileu","sourceIds":{"vndbCharacterId":"c90364"},"originalCharacterName":"Mimileu","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"222"},"height":{"reviewState":"source-only","source":"vndb","value":"138"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The mountain deity that governs these parts."},{"spoiler":false,"text":"Complains about how things are annoying a lot, but she's actually the hardest worker around."},{"spoiler":false,"text":"An elite who quit being a reaper to take up being a mountain deity."},{"spoiler":false,"text":"According to herself, she can apparently turn metal axes into gold ones, but it is still unknown if there is any truth to that."},{"spoiler":false,"text":"She has perfect control of the flow of water and can cause huge waves at will, but is apparently limited in her movements in places devoid of water."},{"spoiler":false,"text":"A number of her water-based techniques utilize her own power, not her power as a mountain deity."},{"spoiler":false,"text":"In-game profile"}],"source":"vndb","sourceCharacterId":"c90364"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c57104ade5c3f6607730113259a6ac918d2ec53742761b76186400af91e74d39.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/534a4c56228fb71c8d8d059d73c34d211c2fbb96eb857a0a723fb3132c9a565f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"박신희","creatorId":"vndb:s21091","sourcePersonId":"vndb:s21091","canonicalEntityId":"vndb:s21091","name":"박신희","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80132","source":"vndb"},{"creditedName":"中村カンナ","creatorId":"vndb:s21092","sourcePersonId":"vndb:s21092","canonicalEntityId":"vndb:s21092","name":"中村カンナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80133","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p5802","sourceCompanyId":"egs:brand:5931","canonicalEntityId":