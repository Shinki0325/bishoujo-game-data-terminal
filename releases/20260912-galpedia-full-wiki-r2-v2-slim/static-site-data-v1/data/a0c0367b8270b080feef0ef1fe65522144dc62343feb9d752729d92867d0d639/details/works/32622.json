gments":[{"spoiler":false,"text":"The game’s main heroine."},{"spoiler":false,"text":"A skilled healer and Souya’s wife."},{"spoiler":false,"text":"She is the popular beauty of the village, equally loved by everyone."},{"spoiler":false,"text":"Cheerful and kind, she greatly respects her husband."},{"spoiler":false,"text":"Rui always dreamed of having a child, and Shion’s arrival granted her the perfect chance to finally channel all of her motherly love towards someone."},{"spoiler":false,"text":"As the village healer, Rui is a skilled user of restorative magic… although she lacks a partner who can appropriately replenish her mana."},{"spoiler":false,"text":"From DLsite"}],"source":"vndb","sourceCharacterId":"c107240"},{"segments":[{"spoiler":false,"text":"本作のヒロイン。"},{"spoiler":false,"text":"蒼夜の妻で、治癒術師。"},{"spoiler":false,"text":"村でも評判の美人で、性格も良く、老若男女問わず、好かれている。"},{"spoiler":false,"text":"明るくやさしく献身的で、夫との関係も良好。"},{"spoiler":false,"text":"子供が欲しかったところに獅音がやってきたことで、自分の息子のように可愛がる。"},{"spoiler":false,"text":"治癒術師としての能力は優秀だが、夫が病弱なこともあり、魔力の回復が十分にできず、その力を発揮できていない。"}],"source":"egs","sourceCharacterId":"24065","sourceWorkId":"32621","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のヒロイン。"},{"spoiler":false,"text":"蒼夜の妻で、治癒術師。"},{"spoiler":false,"text":"村でも評判の美人で、性格も良く、老若男女問わず、好かれている。"},{"spoiler":false,"text":"明るくやさしく献身的で、夫との関係も良好。"},{"spoiler":false,"text":"子供が欲しかったところに獅音がやってきたことで、自分の息子のように可愛がる。"},{"spoiler":false,"text":"治癒術師としての能力は優秀だが、夫が病弱なこともあり、魔力の回復が十分にできず、その力を発揮できていない。"}],"source":"egs","sourceCharacterId":"24065","sourceWorkId":"32622","spoiler":false},{"segments":[{"spoiler":false,"text":"本作中的女主角。"},{"spoiler":false,"text":"苍夜的妻子，治愈师。"},{"spoiler":false,"text":"在村里是大家公认的美人，性格也很好，"},{"spoiler":false,"text":"无论男女老幼，都很喜欢她。夫妻二人恩恩爱爱，性格开朗、心地善良。"},{"spoiler":false,"text":"当他们十分想要个孩子时，狮音到来了。二人像对待自己的孩子一样疼爱他。"},{"spoiler":false,"text":"虽然作为治愈师的能力十分出众，但由于丈夫体弱多病，导致魔力无法完全恢复，无法使出全部能力。"}],"source":"bangumi","sourceCharacterId":"110085"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/4848a0f89d03a59334d473fe791b3e3d806c1b34b6d79eb5a41419eb74f3619b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0f854edc2ce0037c558fd5ac0ca2538dfe35ce358e425f1aa5090fd4b5e0958.webp","width":107,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:379640:110085:6469:1","source":"bangumi"}]},{"characterId":"char_c107241","characterName":"獅音","sourceIds":{"bangumi":[{"characterId":"110086","match":"exact-normalized-name-in-linked-work","subjectId":"379640"}],"egsCharacterIds":["24067"],"vndbCharacterId":"c107241"},"originalCharacterName":"獅音","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the Pure Love Route."},{"spoiler":false,"text":"Shion is a straightforward and simple-minded young man."},{"spoiler":false,"text":"After he didn’t manifest any magical power during his coming of age, his parents decided to leave him in the care of a family that specializes in magical research."},{"spoiler":false,"text":"Shion boasts incredible physical fitness even without being able to use his magical power."},{"spoiler":false,"text":"He has feelings for Rui, who always takes care of his health and often pampers him."},{"spoiler":false,"text":"From DLsite"}],"source":"vndb","sourceCharacterId":"c107241"},{"segments":[{"spoiler":false,"text":"純愛編の主人公。"},{"spoiler":false,"text":"真っ直ぐで純朴な、心優しい青年。"},{"spoiler":false,"text":"成人しても魔力が発現せず、将来を案じた両親が一縷の望みを託し、魔法の知識に長けている村の若夫婦へ預けることに。"},{"spoiler":false,"text":"魔法が使えない状態でも、身体能力が極めて高い。"},{"spoiler":false,"text":"自分の治療を担当している瑠衣に、想いを寄せている。"}],"source":"egs","sourceCharacterId":"24067","sourceWorkId":"32621","spoiler":false},{"segments":[{"spoiler":false,"text":"纯爱篇中的男主。"},{"spoiler":false,"text":"纯粹、直率、善良的青年。"},{"spoiler":false,"text":"即使成人之后仍然无法使用魔力，担心他的未来的父母将一丝希望寄托在了魔法知识丰富的年轻夫妇上。"},{"spoiler":false,"text":"虽然无法使用魔法，但身体素质非常优秀。"},{"spoiler":false,"text":"对负责治疗自己的女主抱有好感。"}],"source":"bangumi","sourceCharacterId":"110086"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db9c7203063b0a59cd784026a6f16c7a06975c329b1096313aa270f44d9f7097.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79433731adbc07486bc8e9a2009258867e25993f03a0b1b094f28e93bced118e.webp","width":97,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c107242","characterName":"蒼夜","sourceIds":{"bangumi":[{"characterId":"110087","match":"exact-normalized-name-in-linked-work","subjectId":"379684"}],"egsCharacterIds":["24066"],"vndbCharacterId":"c107242"},"originalCharacterName":"蒼夜","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the NTR route."},{"spoiler":false,"text":"Rui’s husband and a skilled alchemist."},{"spoiler":false,"text":"Souya is a man of good character and gentle nature, deeply in love with his wife."},{"spoiler":false,"text":"Although he’s always suffered from a frail and sickly constitution, he makes up for it with his vast wealth of knowledge."},{"spoiler":false,"text":"Souya spends most of his days in a basement working on his craft."},{"spoiler":false,"text":"From DLsite"}],"source":"vndb","sourceCharacterId":"c107242"},{"segments":[{"spoiler":false,"text":"寝取られ編の主人公。"},{"spoiler":false,"text":"瑠衣の夫で、錬金術師。"},{"spoiler":false,"text":"人当たりが良く、穏やかな性格で、妻である瑠衣を、こよなく愛している。"},{"spoiler":false,"text":"病弱で魔力が低いが、豊富な知識で補っている。"},{"spoiler":false,"text":"地下の工房に籠り、一日中、研究に没頭している。"}],"source":"egs","sourceCharacterId":"24066","sourceWorkId":"32622","spoiler":false},{"segments":[{"spoiler":false,"text":"夺爱篇章的男主。"},{"spoiler":false,"text":"瑠衣的丈夫，炼金术师。"},{"spoiler":false,"text":"待人友善，性格稳重。十分喜爱自己的妻子。"},{"spoiler":false,"text":"体弱多病导致魔力低下，但是知识非常渊博。"},{"spoiler":false,"text":"时常将自己关在地下的工房中，一整日都沉迷于研究。"}],"source":"bangumi","sourceCharacterId":"110087"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56e3e669a2bdc5f466781e88f631da42d3217d5a4f7ccf24abef689086b9fc45.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/6452d6b99faadd6d288243b1f89ce1d2266f7be90e8f0d0f3c86391970130ab9.webp","width":92,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c107243","characterName":"轟","sourceIds":{"vndbCharacterId":"c107243"},"originalCharacterName":"轟","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Souya’s father and the village’s head."},{"spoiler":false,"text":"His beastly strength and imposing presence are entirely unmatched within the village."},{"spoiler":false,"text":"Gou is headstrong and stubborn, and yet he’s strangely weak in front of Rui’s requests."},{"spoiler":false,"text":"He seems to harbor strong feelings for his son’s wife."},{"spoiler":false,"text":"From DLsite"}],"source":"vndb","sourceCharacterId":"c107243"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b489afcba1c47e1c081d4e4fbc5fb2c4aeaa00f8cee1c0c9d