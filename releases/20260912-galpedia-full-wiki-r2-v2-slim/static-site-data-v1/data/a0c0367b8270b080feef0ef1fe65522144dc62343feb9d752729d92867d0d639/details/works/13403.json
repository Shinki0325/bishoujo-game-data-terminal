lEntityId":"vndb:s31130","name":"横田 憲一郎","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:39720","source":"vndb"}]},"cast":[{"characterId":"char_c45381","characterName":"大島 穂乃香","sourceIds":{"bangumi":[{"characterId":"143106","match":"exact-normalized-name-in-linked-work","subjectId":"279510"}],"egsCharacterIds":["14083"],"vndbCharacterId":"c45381"},"originalCharacterName":"大島 穂乃香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"21"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a young wife who married upon graduation from junior college."},{"spoiler":false,"text":"She is cheerful and upbeat, but also naive because she got married without finding a job. Her husband, Takatoshi Ooshima, is her first partner, but lately she has been unsatisfied, and although she is curious to see what other people are like, she has yet to make a move."},{"spoiler":false,"text":"Takatoshi is a major banker who spends most of his time at work, and their conversations as a couple are dwindling. She loves her sister-in-law, Miyako, as if she were his own sister, and she listens to her complaints."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c45381"},{"segments":[{"spoiler":false,"text":"主人公の兄・隆俊の妻。21歳。"},{"spoiler":false,"text":"短大卒業後、すぐに結婚。社会経験がなく、やや世間知らずだが、明るく朗らかな女性。"},{"spoiler":false,"text":"大手銀行に勤める夫は、最近忙しく、あまりかまって貰えず、夫婦の営みも減少し、物足りない日々を過ごしている。"},{"spoiler":false,"text":"美弥子を実の姉のように慕っており、いつも愚痴などを聞いて貰っているが、溜め込んでしまう性格もあって、あまり突っ込んだ話はできていない。"}],"source":"egs","sourceCharacterId":"14083","sourceWorkId":"13403","spoiler":false},{"segments":[{"spoiler":false,"text":"夫：大島隆俊(おおしまたかとし)"},{"spoiler":false,"text":"年齢：21"},{"spoiler":false,"text":"スリーサイズ：T154/B89/W56/H82/Dカップ"},{"spoiler":false,"text":"短大卒業と共に結婚した若妻。"},{"spoiler":false,"text":"明るく朗らかだが、就職せずに結婚したので世間知らずな部分も。"},{"spoiler":false,"text":"夫『大島隆俊(おおしまたかとし)』が始めての相手だが、最近物足りず、他の人はどんなものなのか興味を抱きつつも行動に移せていない。"},{"spoiler":false,"text":"『隆俊』は、大手銀行マンで、仕事の日々を送り夫婦間の会話も減少している。"},{"spoiler":false,"text":"『美弥子』のことは、実の姉のように慕って、愚痴なども聞いてもらったりしているが、基本的にはあまり言えないタイプ。"}],"source":"bangumi","sourceCharacterId":"143106"}],"profileFacts":[{"label":"年龄（本版本）","value":"21 岁","valueContext":null,"source":"egs","sourceCharacterId":"14083","sourceWorkId":"13403","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"14083","sourceWorkId":"13403","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"14083","sourceWorkId":"13403","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"14083","sourceWorkId":"13403","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"14083","sourceWorkId":"13403","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"14083","sourceWorkId":"13403","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef77e88ecfb9a4790ce4b984a624ba012a40830a32153f0cac7c249a37c5bbdc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec74874e8cc4bea184adebcd91b8efe785a1e59d8d9a173adfef70f62a36fa96.webp","width":118,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:279510:143106:5890:1","source":"bangumi"}]},{"characterId":"char_c45382","characterName":"大島 美弥子","sourceIds":{"bangumi":[{"characterId":"143107","match":"exact-normalized-name-in-linked-work","subjectId":"279510"}],"egsCharacterIds":["14084"],"vndbCharacterId":"c45382"},"originalCharacterName":"大島 美弥子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"32"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has a pleasant and assertive personality, and is disgusted with Yuuki, who is always teasing her."},{"spoiler":false,"text":"She and her husband have not been married for a long time, and she secretly relieves her sexual desires through live chat work. Her husband, Takayuki Ooshima, is a major trading company employee who is often away from home on overseas business trips."},{"spoiler":false,"text":"She and her sister-in-law Honoka are quite a few years apart in age, so she often takes care of her. Since their husbands are rarely present, the wives inevitably get along well with each other."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c45382"},{"segments":[{"spoiler":false,"text":"主人公の兄・孝之の妻。32歳。"},{"spoiler":false,"text":"気が強く、はっきりした性格。いつもイジイジと男らしくない主人公を嫌悪している。"},{"spoiler":false,"text":"夫とは結婚八年目を迎え、倦怠期に入っている。また夫は海外出張が多く、子供もいないため、彼女が一人で過ごすことが多くなっている。"},{"spoiler":false,"text":"夫婦の営みもまったくなく、ライブチャットの仕事で性欲を解消している。"},{"spoiler":false,"text":"義妹となる穂乃香とは年齢もずいぶんと離れているため、よく面倒を見ており、仲が良い。"}],"source":"egs","sourceCharacterId":"14084","sourceWorkId":"13403","spoiler":false},{"segments":[{"spoiler":false,"text":"夫：大島孝之（おおしまたかゆき）"},{"spoiler":false,"text":"年齢：32"},{"spoiler":false,"text":"スリーサイズ：T167/B93/W60/H86/Fカップ"},{"spoiler":false,"text":"結婚8年目の倦怠期夫婦。"},{"spoiler":false,"text":"気が強く、ハキハキとした性格で、いつもイジイジしている『雄貴』に対して嫌悪感をもっている。夫とは、随分と夫婦生活がなく、こっそりとライブチャットの仕事で性欲解消している。夫の『大島孝之(おおしまたかゆき)』は、大手商社マンで、海外出張も多く家をあけがち。"},{"spoiler":false,"text":"義妹『穂乃香』とは、随分と年が離れているので、良く面倒を見ている。"},{"spoiler":false,"text":"お互い夫がいることが少なく必然的に、嫁同士で仲良くなっている。"}],"source":"bangumi","sourceCharacterId":"143107"}],"profileFacts":[{"label":"年龄（本版本）","value":"32 岁","valueContext":null,"source":"egs","sourceCharacterId":"14084","sourceWorkId":"13403","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"14084","sourceWorkId":"13403","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"14084","sourceWorkId":"13403","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"14084","sourceWorkId":"13403","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"14084","sourceWorkId":"13403","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"14084","sourceWorkId":"13403","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7aadca7fdc712e4171eab823d964ae07bf2bdce7c9637d7a443faf04c13186ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/7219912c7aceacc6d7ab65739703b1b27ed4c880b3899367872bde86a9d3148c.webp","width":118,"height":256,"source":"static-detail"},"actors":[{"creditedName":"若泉絵子","creatorId":"vndb:s1099","sourcePersonId":"vndb:s1099","canonicalEntityId":"vndb:s1099","name":"若泉 絵子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:279510:143107:25167:1","source":"bangumi"}]},{"characterId":"char_vndb_c50305","characterName":"大島 雄貴","sourceIds":{"vndbCharacterId":"c50305"},"originalCharacterName":"大島 雄貴","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"30"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is 30 years old with a dull appearance."},{"spoiler":false,"text":"Insidious and obsessive. He is a little bit intuitive. Although he dreams of a normal love life, he is still an amateur virgin due to his mean personality. He has a complex about the fact that he has never had a girlfriend, let alone getting married."},{"spoiler":false,"text":"The husbands of both Miyako and Honoka are Yuuki's older brothers. Both of them are working and are active in their respective fields. Yuki, who still does not have a regular job, has no choice but to spend his time as a manager of the condominium owned by his parents."},{"spoiler":false,"text":"The older brothers also live in the same condominium because it does not cost them rent and they do not live together."},{"spoiler":false,"text":"From getchu"}],"source":"vndb","sourceCharacterId":"c50305"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p707","sourceCompanyId":"egs:brand:2696","canonicalEntityI