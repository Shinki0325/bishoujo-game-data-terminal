t":"与桔梗关系不好。"}],"source":"bangumi","sourceCharacterId":"126290"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb2b39ae653f3018d7338a38b57f2147eff838f850f1411099e121413e0680fe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdd966ffb0f6462ff1fd7a44955bd3f729cb7681759904d42798f33c2905fced.webp","width":147,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤宮菜穂","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:364960:126290:6019:1","source":"bangumi"}]},{"characterId":"char_c107304","characterName":"山家 淡墨","sourceIds":{"bangumi":[{"characterId":"126291","match":"exact-normalized-name-in-linked-work","subjectId":"364960"}],"egsCharacterIds":["24678"],"vndbCharacterId":"c107304"},"originalCharacterName":"山家 淡墨","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"How many times do I need to tell you for you to understand?\""},{"spoiler":false,"text":"A suspicious man, covered in bandages. Speaks in a little old-fashioned way. Unexpectedly, could have a domestic side too?.. He gets along well with Tsukishiro."},{"spoiler":false,"text":"Kikyou's partner. Takes good care of her."},{"spoiler":false,"text":"Edited from the official site"}],"source":"vndb","sourceCharacterId":"c107304"},{"segments":[{"spoiler":false,"text":"包帯だらけの怪しい男。"},{"spoiler":false,"text":"少し古臭い喋り方をする。"},{"spoiler":false,"text":"意外と家庭的な一面も‥‥？"},{"spoiler":false,"text":"月白と仲が良い。"}],"source":"egs","sourceCharacterId":"24678","sourceWorkId":"32117","spoiler":false},{"segments":[{"spoiler":false,"text":"「要讲多少次，你才听得懂？」"},{"spoiler":false,"text":"浑身缠满绷带的可疑男子。"},{"spoiler":false,"text":"说话的口吻有些古风。"},{"spoiler":false,"text":"令人意外的是，他也有非常居家的一面……？"},{"spoiler":false,"text":"与月白相交甚笃。"}],"source":"bangumi","sourceCharacterId":"126291"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/8795cd544ff64e1415eee8937928b1d0619a060f58e6425e654ab77df6dd8b0c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00e8c81b35d13e6c153d32b9424242b50fb70bb62c8ce7b94dd30be789033980.webp","width":111,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杉田智和","creatorId":"vndb:s370","sourcePersonId":"vndb:s370","canonicalEntityId":"vndb:s370","name":"杉田 智和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:364960:126291:4513:1","source":"bangumi"}]},{"characterId":"char_c107305","characterName":"月城 月白","sourceIds":{"bangumi":[{"characterId":"126292","match":"exact-normalized-name-in-linked-work","subjectId":"364960"}],"egsCharacterIds":["24679"],"vndbCharacterId":"c107305"},"originalCharacterName":"月城 月白","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Suuure. I would like for us to become more friendly.\""},{"spoiler":false,"text":"A suspicious person with long hair. Works at night. Seems to be bad with domestic chores...? He gets along well with Awasumi."},{"spoiler":false,"text":"Shinku's partner. Likes to show off."},{"spoiler":false,"text":"Edited from the official site"}],"source":"vndb","sourceCharacterId":"c107305"},{"segments":[{"spoiler":false,"text":"長髪の怪しい男。"},{"spoiler":false,"text":"夜に働いている。"},{"spoiler":false,"text":"家事は苦手なようだが‥‥？"},{"spoiler":false,"text":"淡墨と仲が良い。"}],"source":"egs","sourceCharacterId":"24679","sourceWorkId":"32117","spoiler":false},{"segments":[{"spoiler":false,"text":"「是啊～希望咱们可以相处得和睦一些哦～」"},{"spoiler":false,"text":"有着一头长发的可疑男子。"},{"spoiler":false,"text":"从事夜间工作。"},{"spoiler":false,"text":"似乎不太会做家务……?"},{"spoiler":false,"text":"与淡墨相交甚笃。"}],"source":"bangumi","sourceCharacterId":"126292"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d1a1f1c0ca2d05e92df63fb1a1fd85734baa8fd27861ca1fb921381853532aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6c667f873d13dc7ee9676b296dfe2fc5fcc775a6e130ff4ae41e1b286cf580c.webp","width":120,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立花慎之介","creatorId":"vndb:s55","sourcePersonId":"vndb:s55","canonicalEntityId":"vndb:s55","name":"立花 慎之介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:364960:126292:4645:1","source":"bangumi"}]},{"characterId":"char_vndb_c155086","characterName":"廣杣 紫","sourceIds":{"vndbCharacterId":"c155086"},"originalCharacterName":"廣杣 紫","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kikyou's and Shinku's loving mother, who was always kind, beautiful and gave everything to her children because she loved them dearly."},{"spoiler":true,"text":"Later, it is revealed that Kikyou saw her through rose-coloured glasses. Murasaki was tired of her life and felt that her children weighed her down. Her hatred of Rokushou and the growing disdain for her children made her want to run away, abandoning them."}],"source":"vndb","sourceCharacterId":"c155086"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/