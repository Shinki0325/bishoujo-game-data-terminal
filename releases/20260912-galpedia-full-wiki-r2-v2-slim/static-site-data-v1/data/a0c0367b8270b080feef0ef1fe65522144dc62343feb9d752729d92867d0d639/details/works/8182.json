{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"8182","model":{"presentationWorkId":"vndb:v1681","staff":{"artwork":[{"creditedName":"水原優","creatorId":"vndb:s5166","sourcePersonId":"egs:creator:3387","canonicalEntityId":"vndb:s5166","name":"水原優","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:20101","source":"egs"}],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c57161","characterName":"宮崎 美央","sourceIds":{"bangumi":[{"characterId":"192560","match":"exact-normalized-name-in-linked-work","subjectId":"612706"}],"egsCharacterIds":["25056"],"vndbCharacterId":"c57161"},"originalCharacterName":"宮崎 美央","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"康平の義理の姉。"},{"spoiler":false,"text":"聡明で運動神経もよく、その上美人とあって男女問わず学園内での人気が高い。"},{"spoiler":false,"text":"一見しっかりしているようだが、康平の前では女の子らしい一面も見せる。"},{"spoiler":false,"text":"文武両道だが料理は苦手。"},{"spoiler":false,"text":"優しく、自分にない素直さを持つ康平に強く惹かれているが、両親からの信頼を裏切ることや、姉弟の一線を越えることへの背徳感から自分の気持ちを押し殺す。"},{"spoiler":false,"text":"そのため康平の友人で、以前から何度も告白してきていた倉田祐介と付き合うことにする。"},{"spoiler":false,"text":"実は康平とは血が繋がっておらず、康平だけがその事実を知らない。"}],"source":"egs","sourceCharacterId":"25056","sourceWorkId":"8182","spoiler":false},{"segments":[{"spoiler":false,"text":"康平の義理の姉。"},{"spoiler":false,"text":"聡明で運動神経もよく、その上、美人とあって男子女子問わず学園内での人気は高い。"},{"spoiler":false,"text":"康平にとっても、憧れの存在であり、頼りになるお姉さん。"},{"spoiler":false,"text":"康平の頼りになるお姉ちゃんになろうという意識が強く、彼の前では無理をする事もある。"},{"spoiler":false,"text":"しっかりしているように見られがちだが、密かに男性としても見ている弟の前では"},{"spoiler":false,"text":"女の子らしい一面や可愛い一面も見せる。"},{"spoiler":false,"text":"康平は美央の父の弟の子で、彼が両親を失った際に彼女の家に引き取られる事になった。"},{"spoiler":false,"text":"以来、康平にのみ、その事を伏せて本当の姉弟として生活している。"},{"spoiler":false,"text":"文武両道といっていいが、料理は苦手。両親が海外出張にいっている間は、洗濯ものなどを担当している。"},{"spoiler":false,"text":"優しく、自分にない素直さを持っている康平に強く惹かれているが、"},{"spoiler":false,"text":"両親からの信頼、そして、幼い頃から、彼が自分を姉として慕ってくれていると思っている事から、"},{"spoiler":false,"text":"その気持ちを押し殺そうとしている。"},{"spoiler":false,"text":"康平への思いを断ち切るため、以前から、何度も告白して来ていた祐介と付き合ってみる事にする。"}],"source":"bangumi","sourceCharacterId":"192560"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f92c19947f91917710ec9499545f6adb0cc93b1642216c19f303b5aa309c53af.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84edd5402b87bb20173267f20322e43043a0e741c675e30692cbd4cd89f2060f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七生 みこと","creatorId":"vndb:s1697","sourcePersonId":"vndb:s1697","canonicalEntityId":"vndb:s1697","name":"七生みこと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14267","source":"vndb"}]},{"characterId":"char_vndb_c123736","characterName":"宮崎 康平","sourceIds":{"vndbCharacterId":"c123736"},"originalCharacterName":"宮崎 康平","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:1453","sourceCompanyId":"egs:brand:1453","canonicalEntityId":"egs:brand:1453","name":"Cybele(黒姫)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:8182:1453","source":"egs"},{"companyId":"vndb:p677","sourceCompanyId":"vndb:p677","canonicalEntityId":"vndb:p677","name":"黒姫","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:153638:v1681","source":"vndb"},{"companyId":"vndb:p1500","sourceCompanyId":"vndb:p1500","ca