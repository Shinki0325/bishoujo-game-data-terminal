egsCharacterIds":["26916"],"vndbCharacterId":"c90861"},"originalCharacterName":"本庄 秦乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"pending-conflict","source":"vndb","value":"149"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本庄家の三女。"},{"spoiler":false,"text":"年の割には落ち着いたものの考え方をする女の子だが、かといって頭が良いということもない。"},{"spoiler":false,"text":"他人と関わることを嫌い、また気に入らないことがあると、誰彼構わず殴ってしまう。"}],"source":"egs","sourceCharacterId":"26916","sourceWorkId":"4231","spoiler":false},{"segments":[{"spoiler":false,"text":"趣味・特技：パンダのぬいぐるみを集めること・他人の苦い経験をいつまでも覚えていること"},{"spoiler":false,"text":"学園の中年部（中等部）に通うが、学校の人間とは誰ともなじめていない。 彼女のとっつきにくい性格のせいもあるが、 秦乃自信が人とあまり関わりを持ちたくないようだ。 本庄の屋敷の中では、一番落ち着いたものの考え方をするが、 自分の意見は全く言わないためよく誤解される。 他人とはあまり関わりたくないらしく、誰が話し掛けても適当な返事をするだけ。 年の割には落ち着いたものの考え方をするが、 あんまり彼女自身頭はいいほうではない。口より手が先に出るタイプで、 気に入らないことがあると、だれかれ構わず殴りつける。"}],"source":"bangumi","sourceCharacterId":"144605"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4677f82bbc69d2f8506ea8ee5511d0db744765f436b856780eaed6315432cbe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/6319a224fcf906656faffce15581572857a9c0e11afe9639c7950bb9cd651f9e.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c90862","characterName":"本庄 範子","sourceIds":{"bangumi":[{"characterId":"144607","match":"exact-normalized-name-in-linked-work","subjectId":"43323"}],"egsCharacterIds":["26917"],"vndbCharacterId":"c90862"},"originalCharacterName":"本庄 範子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"pending-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本庄家の次女にしてメイド。"},{"spoiler":false,"text":"何事にも動じない、どっしり性格。"},{"spoiler":false,"text":"頼りない有紗さんの母代わりとして、本庄家の中心的な存在。"}],"source":"egs","sourceCharacterId":"26917","sourceWorkId":"4231","spoiler":false},{"segments":[{"spoiler":false,"text":"趣味・特技：家事全般"},{"spoiler":false,"text":"何事にも動じない落ち着いた性格をしている。"},{"spoiler":false,"text":"言葉遣いもしっかりしており、いかにもメイドらしい所作を備えている。"},{"spoiler":false,"text":"本庄家の中心的存在であり、頼りない有紗さんの母代わりでもある。"},{"spoiler":false,"text":"彼女自身、本庄家の人間の役に立てることに喜びを感じている。"},{"spoiler":false,"text":"本庄家とアニマの関係を一番知っている人物であり、"},{"spoiler":false,"text":"智也たちのためというより、本庄家のために、色々と裏で動いている。"},{"spoiler":false,"text":"決して自分の裏を見せない、したたかな一面もある。"}],"source":"bangumi","sourceCharacterId":"144607"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/9463487b5bbe7b248972dd2badda820fe6bb0ef06c63922843f21828c4a848ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/880f9724915ec0a36a810aa7f796cea4ceafd37479dc5a5f4811ac28300ba426.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c90863","characterName":"本庄 伊織","sourceIds":{"bangumi":[{"characterId":"144606","match":"exact-normalized-name-in-linked-work","subjectId":"43323"}],"egsCharacterIds":["26918"],"vndbCharacterId":"c90863"},"originalCharacterName":"本庄 伊織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"pending-conflict","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本庄家の長女。"},{"spoiler":false,"text":"性格は軽く、重度な天然ボケで、いつも失敗ばかりで、最年少の岬からよく怒られている。"},{"spoiler":false,"text":"彼女の収入が本庄家の唯一の収入源であるため、彼女がクビになりはしないかと、家族全員心配しているようだ。"}],"source":"egs","sourceCharacterId":"26918","sourceWorkId":"4231","spoiler":false},{"segments":[{"spoiler":false,"text":"屋敷から三時間かけて仕事場まで通っている。なんの仕事をしているのかは謎。"},{"spoiler":false,"text":"自分が本庄家の大黒柱であるという自覚がないために、"},{"spoiler":false,"text":"仕事に対する情熱が全くない。彼女の収入が本庄家の唯一の収入源であるため、"},{"spoiler":false,"text":"智也たちは、いつ伊織が仕事をクビになるか、はらはらして見守っている。"},{"spoiler":false,"text":"屋敷の中で、一番の年長者。社会人で、本庄家の当主であるはずなのだが、"},{"spoiler":false,"text":"軽い性格のため、本人には当主の自覚はあまりない。重度の天然ボケで、"},{"spoiler":false,"text":"失敗ばかりしている。最年少の岬によく怒られている。"},{"spoiler":false,"text":"屋敷の中の雰囲気が暗いと、無理にでも明るく盛り上げようと頑張る。"},{"spoiler":false,"text":"智也が小さい頃からの憧れの存在だが、酒に酔って抱きつかれたり、"},{"spoiler":false,"text":"だらしない格好で屋敷の中をうろつかれたりと、なにかと幻滅させられることが多い。"}],"source":"bangumi","sourceCharacterId":"144606"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/6339c1c6000883ba5224bd4db550c20aee02a88caffa787ae92353066eb449f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a6fe48d6fe3bbecd9de13c222a48183e1635be54b2f987485f85f05f68cdb3f.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c90864","characterName":"本庄 有紗","sourceIds":{"bangumi":[],"egsCharacterIds":["26919"],"vndbCharacterId":"c90864"},"originalCharacterName":"本庄 有紗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公らを拾い、育ててくれた義理の母。"},{"spoiler":false,"text":"明るく裏表のない性格。"},{"spoiler":false,"text":"子供達のためなら、どんな苦心も厭わない彼女に、主人公らは、絶大な信頼を寄せている。"}],"source":"egs","sourceCharacterId":"26919","sourceWorkId":"4231","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07c1940f1d76e1ad7254df21f8773afde43228e2b6c32a282e973e371e122f29.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8c2db680856ae5892fd19549cd3fc84e0840a10c69a63626d38e03e6ee3d897.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c90865","characterName":"西宮 秋月","sourceIds":{"bangumi":[{"characterId":"144608","match":"exact-normalized-name-in-linked-work","subjectId":"43323"}],"egsCharacterIds":["26914"],"vndbCharacterId":"c90865"},"originalCharacterName":"西宮 秋月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"pending-conflict","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスに転校してきた少女。"},{"spoiler":false,"text":"凛としていて、良家のお嬢様といった彼女だが、高飛車な言動が多い。"},{"spoiler":false,"text":"性格は、単純なところがあり、ちょっとしたことで怒ることも。"}],"source":"egs","sourceCharacterId":"26914","sourceWorkId":"4231","spoiler":false},{"segments":[{"spoiler":false,"text":"趣味・特技：インテリア"},{"spoiler":false,"text":"智也の教室に転校してきた謎の少女。常に凛とした立ち振る舞いと、"},{"spoiler":false,"text":"高飛車な言動から、いい所のお嬢様であることは確か。"},{"spoiler":false,"text":"その尊大な性格から、よくクラスメイトといざこざが起きる。"},{"spoiler":false,"text":"友達は全くいないようで、智也の姿を見かけると、"},{"spoiler":false,"text":"静かに側に近寄ってきて減らず口を叩く。"},{"spoiler":false,"text":"彼女に悪気はなく、人との接し方がわからないだけ。学校では、浮いた存在だが、"},{"spoiler":false,"text":"鏡家の人間に狙われている智也たちにとっては心強い味方となってくれる。"},{"spoiler":false,"text":"アニマの存在を社会に知られないために、秋月は日夜苦心している。"},{"spoiler":false,"text":"プライドが高く、いつも人を上から見下しているような話し方をする。"},{"spoiler":false,"text":"感情をあまりあらわにすることはないが、案外単純な性格で、"},{"spoiler":false,"text":"ちょっとした軽口で怒り出したりする。努力家で、常に学校の成績は一番上。"},{"spoiler":false,"text":"しかし、そんな彼女と友達となる人間は少なく、そのことを気に病んでいる。"},{"spoiler":false,"text":"寂しがり屋で甘えん坊である本来の性格を押し隠すために、"},{"spoiler":false,"text":"無理に高圧的な自分を作り上げている。智也だけには徐々に心を開いていく。"}],"source":"bangumi","sourceCharacterId":"144608"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/301b7a2d4f5420bb7d5806f8350310299fc57db3059015cd84432eba7ad64d6a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3d74e89194105e9a3fe5ac11530a222b8857ced133eceadbca0645c2f05cb82.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c154923","characterName":"鏡 隆二","sourceIds":{"vndbCharacterId":"c154923"},"originalCharacterName":"鏡 隆二","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34147140a58036bf7b1c5a60c527e99f19e00f83fe983b944f1148fa943e3de3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b91ff69ed5f89b74ef97faeef2ef15045a1fff5aee6a8dfac880695ea972abb.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c90859","characterName":"本庄 智也","sourceIds":{"vndbCharacterId":"c90859"},"originalCharacterName":"本庄 智也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"174"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"61"}},"description