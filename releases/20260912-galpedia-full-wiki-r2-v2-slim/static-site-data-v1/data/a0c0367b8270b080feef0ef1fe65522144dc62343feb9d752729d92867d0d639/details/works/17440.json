subjectId":"523724"}],"egsCharacterIds":["9258"],"vndbCharacterId":"c26440"},"originalCharacterName":"朧","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1024"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"172"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"朧忍軍と称し、魑魅魍魎と結託する多国籍複合企業体・ノマドに与するくノ一。"},{"spoiler":false,"text":"アサギによって殺されるが、魑魅魍魎の肉体を借りて復活を遂げる。"},{"spoiler":false,"text":"そして、自分を殺したアサギへ復讐するべく、巧妙な罠を張り巡らすが……。"}],"source":"egs","sourceCharacterId":"9258","sourceWorkId":"7257","spoiler":false},{"segments":[{"spoiler":false,"text":"朧忍軍と称し、魑魅魍魎と結託する多国籍複合企業体・ノマドに与するくノ一。"},{"spoiler":false,"text":"アサギによって殺されるが、魑魅魍魎の肉体を借りて復活を遂げる。"},{"spoiler":false,"text":"そして、自分を殺したアサギへ復讐するべく、巧妙な罠を張り巡らすが……。"}],"source":"egs","sourceCharacterId":"9258","sourceWorkId":"8187","spoiler":false},{"segments":[{"spoiler":false,"text":"傭兵を集めて朧忍軍と称し、魑魅魍魎と結託する多国籍複合企業体・ノマドに与するくノ一。"},{"spoiler":false,"text":"アサギによって一度は殺されるが、魑魅魍魎の肉体を借り、闇の闘技場＜カオス・アリーナ＞の館長として復活するが、復讐の燃える朧はアサギとその妹を姦計に陥れる。"}],"source":"egs","sourceCharacterId":"9258","sourceWorkId":"11375","spoiler":false},{"segments":[{"spoiler":false,"text":"傭兵を集めて朧忍軍と称し、魑魅魍魎と結託する多国籍複合企業体・ノマドに与するくノ一。"},{"spoiler":false,"text":"アサギによって一度は殺されるが、魑魅魍魎の肉体を借り、闇の闘技場＜カオス・アリーナ＞の館長として復活する。"},{"spoiler":false,"text":"復讐の燃える朧はアサギとその妹を姦計に陥れるが、アサギの逆襲に再び撃ち滅ぼされる。"}],"source":"egs","sourceCharacterId":"9258","sourceWorkId":"16312","spoiler":false},{"segments":[{"spoiler":false,"text":"魑魅魍魎と結託する多国籍複合企業体「ノマド」に与し東京キングダムで「マダム」と呼ばれる姫カットの髪型をした元対魔忍。手甲から伸びる片刃の刀身状の鉤爪を得物とし、施されると肌に黒いハートマークの入れ墨のように刻まれる強力な呪術系忍法「催眠刻印」の使い手。フロントジッパー式の赤いレオタードと網柄のボディストッキングが合わさったような忍装束43と、赤ずくめのスリップドレス（英語版）×ハイヒールサンダルを着分けている。3年前41にアサギによって一度は殺されるが、醜い肉腫のような姿の下等妖魔に身を宿して生き延びており、復讐のため恭介に寄生したのち肉体そのものを奪ってかつての姿を取り戻し、恭介の肉体ごと命を人質にする。なお、当項の朧は厳密には肉体がオリジナルだっただけで、元々の朧とはエドウィン・ブラックに滅ぼされた甲河一族のもう1人の生き残り（のちの仮面の対魔忍）のことで、空蝉の術で精神（魂）が離れ空っぽになっていた肉体に邪悪な魂（人格）を入れられて誕生したのが成り立ち注釈 35。デザイナー本人のカガミがお気に入りと述べている44。声は児玉さとみ、榎津まお（『the Nightmare』注釈 37）。"},{"spoiler":false,"text":"『カオス・アリーナ編』"},{"spoiler":false,"text":"素肌にまとった赤ずくめのジャケット×ミニスカート×逆三角形レンズのリムレス眼鏡（英語版）×ハイヒール×茶色系のストッキング姿でアサギを電車に連れ込み、宿主である恭介の性器を実体化させて犯しつつ、スネークレディや多数の男たちと痴漢&SMプレイで凌辱した。"},{"spoiler":false,"text":"『the Nightmare』"},{"spoiler":false,"text":"前半（1作目ごろの過去話）に登場。籠手や脚などがリニューアルされた忍装束45注釈 38姿と、Gストリングの下着だけ穿いての45黒のフロントジッパー式ストラップレスドレス×紫色系のイブニンググローブ×ガーター付き45の茶色系ストッキング姿を着分けており、後者では隠しもった4本のくないを得物に用いた。"},{"spoiler":false,"text":"『アサギ2』"},{"spoiler":false,"text":"朧クローンとは別人であり、1作目と同じ忍装束注釈 39で登場。エドウィン・ブラックの力で“吸血鬼の朧”と化して復活を果たしており、アサギに深手を負わされ逃れてきた朧クローンを自らの手で始末した。"},{"spoiler":false,"text":"『恥虐の暗黒遊戯』"},{"spoiler":false,"text":"スネークレディと組んでアサギとさくらを拘束しノマドの基地やビル内のショーなどで調教するが、最終的には血液を利用したアサギの反撃で首だけになり、スネークレディに回収され撤退した。"},{"spoiler":false,"text":"『アサギ3』"},{"spoiler":false,"text":"仮面の対魔忍とは別人。結城炎美に近付いたさいは両サイドを三つ編みにした髪型の五車学園の女生徒に化けた。分身の術「朧分身」などを駆使して倒したイングリッドを嬲り者にした一方で、組んでいた魔科医フュルストには裏切られて淫獣によって凌辱されるが返り討ちにした。その後は石山兄弟を使って囚えていた甲河アスカの手でアサギを殺させようと画策するが、アスカの策略で人間爆弾にされた石山拓斗の爆発に巻き込まれるという末路を辿った。"},{"spoiler":false,"text":"『決戦アリーナ』"},{"spoiler":false,"text":"原作とほぼ同じくノマド幹部かつブラックの側近で、すでに『アサギ2』以降の“吸血鬼の朧”であり46、姿は『アサギ3』での忍装束や1作目でのスリップドレスの2通りで登場。"}],"source":"bangumi","sourceCharacterId":"52201"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f095c7915a9eae4911b98f4740e84e92776e989a60a9703ba28cdd34c5344a80.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5c5ed2c6148e51c2832