s":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/4300697a4cecc8c0136422cfc4f6126c7cee4bae73d515a750b0ac44609bcb07.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b5621829599c97dd95420d6a2fe21d5ddf71b07e63bc488956b0e820117f0fa.webp","width":154,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_160847","characterName":"ヒノキ","sourceIds":{"bangumi":[{"characterId":"160847","match":"source-roster","subjectId":"225260"},{"characterId":"160847","match":"source-roster","subjectId":"503032"}]},"originalCharacterName":"ヒノキ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"最凶の仲間キャラクターのヒノキちゃんです。"},{"spoiler":false,"text":"レイチェルに匹敵する大胆さと型破りっぷりは"},{"spoiler":false,"text":"時々、フォトネどころか、レイチェルすら唖然とさせる。"},{"spoiler":false,"text":"でも、意外と常識人。"},{"spoiler":false,"text":"ガチレズだそうです。（本人曰く、違うとのこと）"}],"source":"bangumi","sourceCharacterId":"160847"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d59bb4e313b7483b2f503c61c056e72e131d47e55f2df37cf283e9ecd83dc4ce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/409a312fbadd0a1d4a4fb1174abfacc0e4c082c0341559b39dc2cfe3e5d94a40.webp","width":180,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_160848","characterName":"マイン","sourceIds":{"bangumi":[{"characterId":"160848","match":"source-roster","subjectId":"225260"}]},"originalCharacterName":"マイン","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"お嬢様に仕えるメイド、つまりフォトネの同僚。"},{"spoiler":false,"text":"メイドのくせに掃除も洗濯も料理もできないので、"},{"spoiler":false,"text":"いつクビになってもおかしくない。"},{"spoiler":false,"text":"胸が大きい。フォトネの髪の毛の色は「おしっこの色」と評している。"}],"source":"bangumi","sourceCharacterId":"160848"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cc2a34c573df561c56988211f65df6837bca9f90707a191b89043fd36cdf0d9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce44405b2eb0f6d6300b21b673e14191bbaceb7335b7fedce0874f73410b0d4b.webp","width":180,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_160849","characterName":"カルサ","sourceIds":{"bangumi":[{"characterId":"160849","match":"source-roster","subjectId":"225258"},{"characterId":"160849","match":"source-roster","subjectId":"225260"}]},"originalCharacterName":"カルサ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"2番目の街、ラナルナに住む男の子、性格ちょっと暗めの子。"},{"spoiler":false,"text":"お嬢様がラナルナの街に侵攻した際に捕まり、"},{"spoiler":false,"text":"そのまま家来にされてしまった気の毒な少年。"},{"spoiler":false,"text":"お嬢様の家来にされてしまった理由は"},{"spoiler":false,"text":"カルサの必殺技が便利そうだという短絡的な理由だった。"},{"spoiler":false,"text":"ポケット★ソーサリー主人公（男の子を選んだ場合）"},{"spoiler":false,"text":"主人公の性別を男の子にすると"},{"spoiler":false,"text":"この少年が主人公となります。"},{"spoiler":false,"text":"男の子を選んだ場合、"},{"spoiler":false,"text":"下記の女の子はライバルキャラクターとなります。"},{"spoiler":false,"text":"名前は4種類のデフォルトネームが用意されていますが"},{"spoiler":false,"text":"もちろん自分で決めることも可能です。"},{"spoiler":false,"text":"デフォルトネーム："},{"spoiler":false,"text":"カルサ ゴーグル ミリタリ かるぽん"}],"source":"bangumi","sourceCharacterId":"160849"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed891f99811038a64168b38ed91153dc039c1f7d31b3b185c36d542747099ed1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98b68a7d939599d6c48e976bbaeb511143f91aa9d19c2a7d26496d70d02af746.webp","width":154,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_160850","characterName":"メアリ","sourceIds":{"bangumi":[{"characterId":"160850","match":"source-roster","subjectId":"225260"}]},"originalCharacterName":"メアリ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"街の発展協会に住む女の子。"},{"spoiler":false,"text":"街の発展に命をかけている。"},{"spoiler":false,"text":"隣にいる緑色のイキモノのセクハラに毎日困っている。"},{"spoiler":false,"text":"というか、その域はもはやセクハラではなくレイプである。"},{"spoiler":false,"text":"テトリスが好きな普通の女の子。"}],"source":"bangumi","sourceCharacterId":"160850"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b69c0d508e1ca3212ee3af6be92ea39e60bff695a113eb1a305f1dce15876f62.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/566275e60d7398de8a1a9a95a708fb8ed786a2efdd4f029443cd32b69a0d26c4.webp","width":180,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_160851","characterName":"メイ","sourceIds":{"bangumi":[{"characterId":"160851","match":"source-roster","subjectId":"225260"},{"characterId":"160851","match":"source-roster","subjectId":"503032"}]},"originalCharacterName":"メイ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"メリルの街にて娼婦の引退牧場という、怪しげな施設で働かされる女の子。"},{"spoiler":false,"text":"以前は声優を目指していたが、「なんとなくなれたら良いな」と思ってたくらいで、"},{"spoiler":false,"text":"今は絵を描いているという、よくある女の子。"},{"spoiler":false,"text":"その絵はフォトネには（残念ながら）ラクガキと言われるものの、"},{"spoiler":false,"text":"お嬢様と2人一緒にいる姿を描かれた絵はフォトネの宝物となるのであった…。"}],"source":"bangumi","sourceCharacterId":"160851"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57f834c52e71406af82471130a03768feae195a0ab066f59bc5f258539e6a540.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2ea2446ac7b09d85456740e580d8b024f79cd3ffec6e811a111b6b247a563660.webp","width":180,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_160852","characterName":"ソフィ","sourceIds":{"bangumi":[{"characterId":"160852","match":"source-roster","subjectId":"225260"}]},"originalCharacterName":"ソフィ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ピンクタルトに仕える秘書のおねーさん。"},{"spoiler":false,"text":"頭が良いことになっていて、ピンクタルトからの信頼も厚いが……。"},{"spoiler":false,"text":"彼女の知力については一切が不明。"},{"spoiler":false,"text":"本当は頭が悪いのではないかという噂も流れている。"}],"source":"bangumi","sourceCharacterId":"160852"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34926fc91263c34abcf559c1786e5bba2ffd636d10d35791b3b5e6ca26962227.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88780856a184eea7899a4effe8fcb45c608d88725a3508bbc0e3b59936b6db09.webp","width":180,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_160853","characterName":"ピンクタルト","sourceIds":{"bangumi":[{"characterId":"160853","match":"source-roster","subjectId":"225260"}]},"originalCharacterN