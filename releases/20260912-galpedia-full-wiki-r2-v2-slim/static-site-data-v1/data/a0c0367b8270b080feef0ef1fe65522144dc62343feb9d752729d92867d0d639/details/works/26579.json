,"relationId":"vndb:vn-staff:127984","source":"vndb"}]},"cast":[{"characterId":"char_c45355","characterName":"織部 こころ","sourceIds":{"bangumi":[{"characterId":"39703","match":"exact-normalized-name-in-linked-work","subjectId":"165894"}],"egsCharacterIds":["8604"],"vndbCharacterId":"c45355"},"originalCharacterName":"織部 こころ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Nii-san, I'm your place to come home to! ♪\""},{"spoiler":false,"text":"A pretty girl who draws in the customers at her mother's cafe, Origami. She takes good care of her friends and has a cheerful and straightforward personality, but her cooking is truly catastrophic. She might have inherited some of her mother's airheadness. Few know that she has a more adventurous side -- she's even finding herself attracted to her new \"brother\"."},{"spoiler":false,"text":"Special skills: Being considerate"},{"spoiler":false,"text":"Hobbies: Reading books (often borrows them from the library)"},{"spoiler":false,"text":"Likes: Relaxing, texting, her \"brother\"(it's a secret)"},{"spoiler":false,"text":"Dislikes: C*ckr**ches, high places, silence"},{"spoiler":false,"text":"Based on translation from the Developer's Site"}],"source":"vndb","sourceCharacterId":"c45355"},{"segments":[{"spoiler":false,"text":"母が営む喫茶店『折り紙』の看板娘、面倒見が良く健気で素直な性格だが料理の腕だけは壊滅的でやや天然気味。"},{"spoiler":false,"text":"\"兄\"となる主人公に心をときめかせてしまうちょっと危険な一面も……。"}],"source":"egs","sourceCharacterId":"8604","sourceWorkId":"23116","spoiler":false},{"segments":[{"spoiler":false,"text":"特技：気遣い"},{"spoiler":false,"text":"趣味：読書（図書室でよく借りてくる）"},{"spoiler":false,"text":"好き：のんびり、メール、こっそりと兄"},{"spoiler":false,"text":"嫌い：G、高いところ、静けさ"},{"spoiler":false,"text":"明るく気立ての良い、少し天然気味な少女。"},{"spoiler":false,"text":"母が営む喫茶店の看板娘だが、料理の腕は残念ながら……。"},{"spoiler":false,"text":"兄となる主人公・誠を慕い、禁断の関係を妄想してときめいている"}],"source":"bangumi","sourceCharacterId":"39703"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a9ac1d29849bdd323edbbbb4bee4393ed46941f95245a9ebc90b58d6e0646f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f24afffbf378d101937bce01069974e6d91a5f81e8b8c6e5ac301cfb13bc7dd.webp","width":150,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:165894:39703:11646:1","source":"bangumi"}]},{"characterId":"char_c45356","characterName":"朝比奈 響子","sourceIds":{"bangumi":[{"characterId":"39704","match":"exact-normalized-name-in-linked-work","subjectId":"165894"}],"egsCharacterIds":["8605"],"vndbCharacterId":"c45356"},"originalCharacterName":"朝比奈 響子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I have one foot in the grave, you see.\""},{"spoiler":false,"text":"Makoto's classmate, and a shrine maiden at the town's shrine. She has a sixth sense and can see ghosts, but this has made her develop a complex towards interacting with living humans. Makoto's arrival has given her an opportunity to try to improve her poor social skills."},{"spoiler":false,"text":"Special skills: Conveniently pretending she didn't hear things"},{"spoiler":false,"text":"Hobbies: Spacing out"},{"spoiler":false,"text":"Likes: Blue skies, her few friends, cute stationery"},{"spoiler":false,"text":"Dislikes: Ghosts, conversation (she's bad at it), the cold"},{"spoiler":false,"text":"Based on translation from the Developer's Site"}],"source":"vndb","sourceCharacterId":"c45356"},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトであり、神社の娘。霊感があり、いわゆる幽霊を見ることができるのだが、その影響で人と付き合うのに苦手意識がある。転入してきた主人公をきっかけに、コミュ障を克服しようと目下奮闘中。"}],"source":"egs","sourceCharacterId":"8605","sourceWorkId":"23116","spoiler":false},{"segments":[{"spoiler":false,"text":"特技：都合の悪いことは聞き流す"},{"spoiler":false,"text":"趣味：ぼんやりすること"},{"spoiler":false,"text":"好き：青空、数少ない友達、可愛い文房具"},{"spoiler":false,"text":"嫌い：お化け、おしゃべり（苦手）、寒さ"},{"spoiler":false,"text":"町の神社の一人娘で、霊感持ち。"},{"spoiler":false,"text":"人見知りのコミュ障だが、克服しようと普段は明るく振る舞っている。"},{"spoiler":false,"text":"誰とでも気軽に接することができる誠に憧れを抱いている。"}],"source":"bangumi","sourceCharacterId":"39704"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cdb27f4db7b4d71539f4feb1490238a00a4fd4517503cce4e890ca38f667f1b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb1c39be486e5ba63239ab35224abd33453bc51260fd44b40eabed7846f6b06a.webp","width":180,"height":256,"source":"static-detail"},"actors":[{"creditedName":"喜多かりん","creatorId":"vndb:s3110","sourcePersonId":"vndb:s3110","canonicalEntityId":"vndb:s3110","name":"喜多 かりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:165894:39704:18474:1","source":"bangumi"}]},{"characterId":"char_c45357","characterName":"恋塚 愛","sourceIds":{"bangumi":[{"characterId":"39705","match":"exact-normalized-name-in-linked-work","subjectId":"165894"}],"egsCharacterIds":["8603"],"vndbCharacterId":"c45357"},"originalCharacterName":"恋塚 愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I belong to you. And you belong to me.\""},{"spoiler":false,"text":"Makoto's fiancée, who grew up in the same village as him. Her Kotodama power is among the strongest in the tribe. She loves Makoto dearly, but deep down she's a little sadistic -- making Makoto squirm is one of her favorite things."},{"spoiler":false,"text":"Special skills: Messing with Makoto"},{"spoiler":false,"text":"Hobbies: Seducing Makoto, reading shoujo manga (in silence)"},{"spoiler":false,"text":"Likes: Makoto, birds, conversation (not good at speaking but likes to listen)"},{"spoiler":false,"text":"Dislikes: People from outside the village, noise, cars"},{"spoiler":false,"text":"Based on translation from the Developer's Site"}],"source":"vndb","sourceCharacterId":"c45357"},{"segments":[{"spoiler":false,"text":"主人公とは同郷の幼馴染みであり、許嫁。\"言霊\"一族の末裔で、その中でもかなり強い力を持っている。主人公のことを非常に好いているが、根っこがSで主人公の困った顔がなによりの好物。"}],"source":"egs","sourceCharacterId":"8603","sourceWorkId":"23116","spoiler":false},{"segments":[{"spoiler":false,"text":"特技：誠いじり"},{"spoiler":false,"text":"趣味：誠を誘惑、少女マンガ"},{"spoiler":false,"text":"好き：誠、鳥、おしゃべり（聞き専門）"},{"spoiler":false,"text":"嫌い：外の人間、騒音、車"},{"spoiler":false,"text":"誠と同じ言霊一族の娘で、誠以上の力を持っている。"},{"spoiler":false,"text":"クールな毒舌キャラで、常識のなさでも誠を上回るトラブルメーカー。"},{"spoiler":false,"text":"誠とは幼なじみで許嫁。 彼にだけはデレデレの Sクーデレ。"}],"source":"bangumi","sourceCharacterId":"39705"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4df7d27a5007c206228cda1aa30db22b21f35f86ec5c7f785c56cb825faa6361.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43305e54f74df6d167c76d29699a50d55982c8cfd7dde1f91a681834070d8880.webp","width":148,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中島裕美子","creatorId":"vndb:s1119","sourcePersonId":"vndb:s1119","canonicalEntityId":"vndb:s1119","name":"中島 裕美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:165894:39705:5019:1","source":"bangumi"}]},{"characterId":"char_c45358","characterName":"水無月 ほたる","sourceIds":{"bangumi":[{"characterId":"39706","match":"exact-normalized-name-in-linked-work","subjectId":"165894"}],"egsCharacterIds":["8606"],"vndbCharacterId":"c45358"},"originalCharacterName":"水無月 ほたる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"height":{"reviewState":"no-conflict","source":"vndb","value":"146"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I see you aren't any color, yet.\""},{"spoiler":false,"text":"A girl who gets along well with everyone and has a very expressive face. She speaks and acts like an uninhibited and free spirit, but she's intelligent and often helps Makoto by giving him advice. For some reason, Kotodama doesn't work on her."},{"spoiler":false,"text":"Special skills: Telling bawdy stories"},{"spoiler":false,"text":"Hobbies: Photography (likes collecting memories)"},{"spoiler":false,"text":"Likes: Fireworks, shopping, the beach"},{"spoiler":false,"text":"Dislikes: Medicine, smartphones, noise"},{"spoiler":false,"text":"Based on translation from the Developer's Site"}],"source":"vndb","sourceCharacterId":"c45358"},{"segments":[{"spoiler":false,"text":"表情豊かなムードメーカーで、誰とでも仲よくできるコミュ力の持ち主。普段の言動から奔放な性格のようにみえるが、理性的な一面もあり主人公の相談役にもなってくれる。彼女にだけは、なぜか\"言霊\"の力が通じない。"}],"source":"egs","sourceCharacterId":"8606","sourceWorkId":"23116","spoiler":false},{"segments":[{"spoiler":false,"text":"特技：猥談"},{"spoiler":false,"text":"趣味：写真撮影（思い出集め）"},{"spoiler":false,"text":"好き：花火、買い物、海"},{"spoiler":false,"text":"嫌い：薬、スマホ、騒音"},{"spoiler":false,"text":"コロコロと表情が変わる、とにかく明るい こころの親友。"},{"spoiler":false,"text":"誰とでも仲良くなれるムードメーカーで、脅威的なコミュ力の持ち主。"},{"spoiler":false,"text":"実はお嬢様だが、堅苦しさや取っ付きにくさは感じさせない。"},{"spoiler":false,"text":"なぜか彼女には、誠の言霊の力が通じない。"}],"source":"bangumi","sourceCharacterId":"39706"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e397c16cb5ae35c1c0ecf84b7ecdc81741a335b2650b3e88d1ae900319856399.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fe492c91eec19d65915b7a87932f338b90ace92d344e2d70deea4977c63a207.webp","width":121,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:165894:39706:5936:1","source":"bangumi"}]},{"characterId":"char_vndb_c137516","characterName":"水無月 ほたる","sourceIds":{"vndbCharacterId":"c137516"},"originalCharacterName":"水無月 ほたる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"74"},"height":{"reviewState":"source-only","source":"vndb","value":"146"},"hip":{"reviewState":"source-only","source":"vndb","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The original terminally ill Hotaru who inadvertently created the clones with a dying wish to get well."}],"source":"vndb","sourceCharacterId":"c137516"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/269b1c92de9cd32cee9fcbffd5420c76db78caf4c781769ff954046354a8e661.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95d020af507f1d2791ca8d76312b98ace7b06b9b33758581f36c9c1b59718196.webp","width":212,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c45359","characterName":"織部 誠","sourceIds":{"vndbCharacterId":"c45359"},"originalCharacterName":"織部 誠","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young man from a tribe who hold the special power of Kotodama. He is naturally curious about everything and a bit lacking in common sense, but at heart he's kind and pleasant person. Since he grew up providing for himself, he's well-versed in how to keep a household running."},{"spoiler":false,"text":"Special skills: Cooking, gathering edible plants"},{"spoiler":false,"text":"Hobbies: Shopping at convenience stores"},{"spoiler":false,"text":"Likes: Convenience stores, TV, people's smiling faces"},{"spoiler":false,"text":"Dislikes: Noise, ill-intentioned people, people being in trouble"},{"spoiler":false,"text":"Based on translation from the Developer's Site"}],"source":"vndb","sourceCharacterId":"c45359"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/7873ba2f9f093b17addbe03efec4f3b331ab4b4f8f437ebf3949dedaa212476a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fe4a5cafe3b00f7c04414e6b96f69b19394b32c42166604430ad143fecdc66a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c49964","characterName":"織部 あずき","sourceIds":{"vndbCharacterId":"c49964"},"originalCharacterName":"織部 あずき","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kokoro's mother, and the owner-operator of Cafe Origami, where Makoto is staying. She's a laid back and kind woman, but some say she's a bit of an airhead too. Many of the cafe's customers have become regulars thanks to the combination of her pleasant personality and her first-rate cooking skills."},{"spoiler":false,"text":"Special skills: Smiling cheerily"},{"spoiler":false,"text":"Hobbies: Chess, crossword puzzles (knows the weirdest trivia)"},{"spoiler":false,"text":"Likes: Her daughter, texting, shopping for clothes"},{"spoiler":false,"text":"Dislikes: Ghosts, tough math, hot drinks"},{"spoiler":false,"text":"Based on translation from the Developer's Site"}],"source":"vndb","sourceCharacterId":"c49964"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/aff68157e828ef4ad126a826f6f3c67b35ff08cf7b4edde92e37fba39d1721ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b895735beaef80c9244403adcce3c3f6d6133ae84f4f5a8f8be00eb912317d2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風音","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68172","source":"vndb"}]},{"characterId":"char_vndb_c63338","characterName":"浅川 光一","sourceIds":{"vndbCharacterId":"c63338"},"originalCharacterName":"浅川 光一","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Makoto's classmate, and the first friend he makes. He's easy to talk to, and seems especially considerate of Makoto. He moved out here from the city a few years ago along with his parents."},{"spoiler":false,"text":"Special skills: Isn't afraid of new things (gained out of necessity as he adapted to country life)"},{"spoiler":false,"text":"Hobbies: Video games, texting (he's written a lot of drafts to his childhood friend, but can't bring himself to send them)"},{"spoiler":false,"text":"Likes: His childhood friend, cute girls, gossip"},{"spoiler":false,"text":"Dislikes: Bugs, summer heat, countryside"},{"spoiler":false,"text":"Based on translation from the Developer's Site"}],"source":"vndb","sourceCharacterId":"c63338"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d9edd83159bc94bfd0fde932396300d552dd12b614969a5929adffd2f7660db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e797ba761ba57d9432783b9295d95b56c448813d300a987d65f16b3c2a448b56.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小池 竹蔵","creatorId":"vndb:s749","sourcePersonId":"vndb:s749","canonicalEntityId":"vndb:s