{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"23872","model":{"presentationWorkId":"vndb:v19192","staff":{"artwork":[{"creditedName":"のりざね(二階堂紫乃)","creatorId":"vndb:s6023","sourcePersonId":"egs:creator:24918","canonicalEntityId":"vndb:s6023","name":"のりざね(二階堂紫乃)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:230924","source":"egs"}],"scenario":[{"creditedName":"沢柾機","creatorId":"vndb:s2190","sourcePersonId":"egs:creator:2137","canonicalEntityId":"vndb:s2190","name":"沢柾機","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:168090","source":"egs"}],"music":[],"other":[{"creditedName":"雨宮充","creatorId":"vndb:s464","sourcePersonId":"egs:creator:20669","canonicalEntityId":"vndb:s464","name":"雨宮充","detail":"企画・脚本・監督、WEBコーディング、WEB広報","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:173019","source":"egs"},{"creditedName":"Joshua \"Ryechu\" Renner","creatorId":"vndb:s10391","sourcePersonId":"vndb:s10391","canonicalEntityId":"vndb:s10391","name":"Joshua \"Ryechu\" Renner","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:129722","source":"vndb"},{"creditedName":"Mary Borsellino","creatorId":"vndb:s20767","sourcePersonId":"vndb:s20767","canonicalEntityId":"vndb:s20767","name":"Mary Borsellino","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:129723","source":"vndb"},{"creditedName":"Good Haro","creatorId":"vndb:s27755","sourcePersonId":"vndb:s27755","canonicalEntityId":"vndb:s27755","name":"T. Emerson","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:129724","source":"vndb"},{"creditedName":"Good Haro","creatorId":"vndb:s27755","sourcePersonId":"vndb:s27755","canonicalEntityId":"vndb:s27755","name":"T. Emerson","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:129725","source":"vndb"},{"creditedName":"雨宮 充","creatorId":"vndb:s464","sourcePersonId":"vndb:s464","canonicalEntityId":"vndb:s464","name":"雨宮 充","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:129726","source":"vndb"},{"creditedName":"雨宮 充","creatorId":"vndb:s464","sourcePersonId":"vndb:s464","canonicalEntityId":"vndb:s464","name":"雨宮 充","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:129727","source":"vndb"},{"creditedName":"二階堂 紫乃","creatorId":"vndb:s6023","sourcePersonId":"vndb:s6023","canonicalEntityId":"vndb:s6023","name":"のりざね","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:129729","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c48256","characterName":"小林 大地","sourceIds":{"vndbCharacterId":"c48256"},"originalCharacterName":"小林 大地","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“I can survive minus an arm after all. You know that, right?”"},{"spoiler":false,"text":"A cheerful, kind and carefree young man. Also the protagonist of the story. Some people might consider him a loser, but when the going gets tough he can step up to the plate."},{"spoiler":false,"text":"He’s not a very fussy person in general."},{"spoiler":false,"text":"He’s in his senior year of college at a public university on a scholarship. He wants to become an elementary school teacher."},{"spoiler":false,"text":"He has no family or relatives to speak of."},{"spoiler":false,"text":"He’s heterosexual and rather uninhibited sexually. He’s quick to fall in love. He has a tendency to get himself involved with rather unkind women and with his girlfriend just having two-timed him and then left, he decided to go on a vacation with Seiji with some tickets he won."},{"spoiler":false,"text":"He’d never admit it, but he thinks of Seiji as his dearest friend and he believes Seiji feels the same way about him."},{"spoiler":false,"text":"From 19.04s"}],"source":"vndb","sourceCharacterId":"c48256"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e736e7c49b1999064f74630c2743e88943b0bad2fd1990ae215b414ae5921e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c777ed1ba40a961b73879349862d0f2ee99b2aa2e19339aab2e756c4565a9909.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天然 才","creatorId":"vndb:s10227","sourcePersonId":"vndb:s10227","canonicalEntityId":"vndb:s10227","name":"久保田 健介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:69075","source":"vndb"}]},{"characterId":"char_vndb_c48257","characterName":"安曇 誠二","sourceIds":{"vndbCharacterId":"c48257"},"originalCharacterName":"安曇 誠二","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“If neither option is going to be pleasant, I’d much rather chose the option that won’t leave permanent damage.”"},{"spoiler":false,"text":"A calm and intelligent young man. The second son of a government official and member of an upper class family. He’s a senior at a fairly prestigious private university. He’s an honest, kind-hearted and well-mannered person, but he isn’t one to actively seek out other people."},{"spoiler":false,"text":"He’s heterosexual and while it goes without saying that he’s popular with members of the opposite sex, being such a catch with no perceptible flaws, he’s rather uptight and hasn’t had very many partners."},{"spoiler":false,"text":"Daichi has been his best friend since middle school. He’d never admit it, but he thinks of Daichi as his dearest friend and he believes Daichi feels the same way about him."},{"spoiler":false,"text":"From 19.04s"}],"source":"vndb","sourceCharacterId":"c48257"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18428ba5e5e88d40fdf6a7c7abb7772afb38f16bebda008084411bfc66c9b8ce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d56e5563b6268c82a560f74864967cdf6abb93238f7af8a530a801ec8cea95e3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"刺草 ネトル","creatorId":"vndb:s5570","sourcePersonId":"vndb:s5570","canonicalEntityId":"vndb:s5570","name":"北山 恭祐","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:69076","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:4116","sourceCompanyId":"egs:brand:4116","canonicalEntityId":"egs:brand:4116","name":"parade.","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:23872:4116","source":"egs"},{"companyId":"vndb:p9166","sourceCompanyId":"vndb:p9166","canonicalEntityId":"vndb:p9166","name":"三辉汉化组","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:122758:v19192","source":"vndb"},{"companyId":"vndb