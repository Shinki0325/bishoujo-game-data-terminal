ts":[{"spoiler":false,"text":"魔族の王。強大な力を持つがゆえに勝気で傲慢。"},{"spoiler":false,"text":"魔族たちには恐れ慕われている。"},{"spoiler":false,"text":"夫と娘のロアのことは愛している。"},{"spoiler":false,"text":"ロアには厳しく接する面もあるが、娘も強く育って欲しいという愛情ゆえ。"}],"source":"bangumi","sourceCharacterId":"110752"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/784a5832f8435548afdb13193866ca578d2c55355ebec93e61bf667a6d1f1b50.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae3a598e6c74f1ac558e72c45e7630aae9eef124b98fc38346a131daee9bb922.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"波野夏花","creatorId":"vndb:s3225","sourcePersonId":"vndb:s3225","canonicalEntityId":"vndb:s3225","name":"波野夏花(夏花)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:375255:110752:16169:1","source":"bangumi"}]},{"characterId":"char_c105401","characterName":"ロア","sourceIds":{"bangumi":[{"characterId":"110753","match":"exact-normalized-name-in-linked-work","subjectId":"375255"}],"egsCharacterIds":["24031"],"vndbCharacterId":"c105401"},"originalCharacterName":"ロア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daughter of Lavis. A senior officer in the demon king's army. She is a strong-willed and noble person."},{"spoiler":false,"text":"As the child of a respected mother, she puts forth no effort to humiliate herself. Because of this, she is strict with others."},{"spoiler":false,"text":"She is in love with a demon man who is close to her and wants to improve herself as a woman in order to become his wife."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c105401"},{"segments":[{"spoiler":false,"text":"ラビスの娘。魔王軍幹部。"},{"spoiler":false,"text":"勝気で気位が高い。尊敬する母の子として恥じぬように努力を惜しまない。その分、他人にも厳しい。"},{"spoiler":false,"text":"側近の魔族の男と恋人で、彼の妻となるべく女としても研鑽を積んでいこうと考えている。"}],"source":"egs","sourceCharacterId":"24031","sourceWorkId":"32373","spoiler":false},{"segments":[{"spoiler":false,"text":"ラビスの娘。魔王軍幹部。勝気で気位が高い。"},{"spoiler":false,"text":"尊敬する母の子として恥じぬように努力を惜しまない。その分、他人にも厳しい。"},{"spoiler":false,"text":"側近の魔族の男と恋人で、彼の妻となるべく女としても研鑽を積んでいこうと考えている。"}],"source":"bangumi","sourceCharacterId":"110753"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fbfcbd1e5e6aba20a826cb1e76529f431338a22210ac1c64d54d066d338301a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe8f0c80a074ab731e3d5d267e0e1df5b120352063ef92a2a6df688753abadf2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"姫嶋 ことみ","creatorId":"vndb:s24978","sourcePersonId":"vndb:s24978","canonicalEntityId":"vndb:s24978","name":"姫嶋 ことみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90760","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p918","sourceCompanyId":"egs:brand:2797","canonicalEntityId":"vndb:p918","name":"Miel","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:32373:2797","source":"egs"},{"companyId":"vndb:p918","sourceCompanyId":"vndb:p918","canonicalEntityId":"vndb:p918","name":"Miel","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:100392:v34256","source":"vndb"},{"companyId":"vndb:p918","sourceCompanyId":"vndb:p918","canonicalEntityId":"vndb:p918","name":"Miel","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:98140:v34256","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-w