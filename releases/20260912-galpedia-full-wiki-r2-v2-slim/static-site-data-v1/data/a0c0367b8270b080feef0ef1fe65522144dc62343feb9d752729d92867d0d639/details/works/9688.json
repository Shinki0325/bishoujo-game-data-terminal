"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"熟れた豊満な肢体と、艶美な雰囲気を持つ社長婦人。"},{"spoiler":false,"text":"表向きは貞淑にして清楚な佇まいだが、裏では夫の性欲を満たすため、様々な変態プレイを強いられている性奴隷。"},{"spoiler":false,"text":"従順に隷属しているが、物足りなった社長によって主人公に預けられ、本格的な性奴隷調教を受けることになる。"}],"source":"egs","sourceCharacterId":"19465","sourceWorkId":"9688","spoiler":false},{"segments":[{"spoiler":false,"text":"外資系一流商社の取締役・姫宮大樹の妻。"},{"spoiler":false,"text":"貞淑にして神秘、清楚にして艶美な美熟女。"},{"spoiler":false,"text":"しかしそれは表向きで、裏では大樹の異常な性癖を満たすためにさまざまな変態的嗜好を強いらている性奴隷。"},{"spoiler":false,"text":"海外で大樹に、見初められ結婚をする。"},{"spoiler":false,"text":"日常生活ではビザールなどの淫靡なコスチュームを大樹に強制され着用している。"},{"spoiler":false,"text":"だが、従順に隷従しているものの、元来の性格から性奴隷としていまひとつ物足りなく思っていた大樹により、本格的な性奴調教をほどこすべく主人公Kに身柄を預けることになる。"}],"source":"bangumi","sourceCharacterId":"143069"}],"profileFacts":[{"label":"年龄（本版本）","value":"38 岁","valueContext":null,"source":"egs","sourceCharacterId":"19465","sourceWorkId":"9688","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"19465","sourceWorkId":"9688","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"19465","sourceWorkId":"9688","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"19465","sourceWorkId":"9688","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab1eed2d077d184a7c5ef2e8fdcdeb2292043b25338425574227d929ca2d2e4f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/076d45c31dd5aa418207a5176c9c9bf2baa00b307c471c9b141b5f6f8c8c9cae.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"上田真紗子","creatorId":"vndb:s6147","sourcePersonId":"vndb:s6147","canonicalEntityId":"vndb:s6147","name":"上田 真紗子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:464902:143069:15252:1","source":"bangumi"}]},{"characterId":"char_c49441","characterName":"姫宮 美緒","sourceIds":{"bangumi":[{"characterId":"143070","match":"exact-normalized-name-in-linked-work","subjectId":"464902"}],"egsCharacterIds":["19466"],"vndbCharacterId":"c49441"},"originalCharacterName":"姫宮 美緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"19"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ミッション系の学園に通う、姫宮家のお嬢様。"},{"spoiler":false,"text":"実は父母との実子ではなく、近縁から養子に貰われた少女で、本人も、そのことにうすうす気づいている。"},{"spoiler":false,"text":"母親ゆずりの美貌と、発育の良いボディに注がれる男たちの視線に、身体が疼いてしまうのが悩みの種。"},{"spoiler":false,"text":"たまた知り合った主人公に密かな恋心を抱くが……。"}],"source":"egs","sourceCharacterId":"19466","sourceWorkId":"9688","spoiler":false},{"segments":[{"spoiler":false,"text":"姫宮家のひとり娘。"},{"spoiler":false,"text":"ミッション系の学校に通う敬虔純朴なお嬢様。"},{"spoiler":false,"text":"オーケストラ部でビオラを担当している。"},{"spoiler":false,"text":"たまたま知り合った主人公に密かに恋焦がれるようになるが、それが悪魔の罠だとはついぞ知る由もない。"},{"spoiler":false,"text":"美緒は、姫宮大樹および葉月との実子ではなく、近縁から養子にもらわれた娘である。その事を本人もうすうす気づいているが、若い身空で政財界の機微を感じ取り、抗わずに身を任せている。"},{"spoiler":false,"text":"むしろ本人の悩みは、母親譲りの美貌と身体に注がれる男たちの視線に自分の血が熱くなることである。"},{"spoiler":false,"text":"抑えがたい官能の乾きに思い悩む無垢なる魂。"},{"spoiler":false,"text":"葉月に勝るとも劣らない肉感的なボディの中で、その思いは張り詰めた糸のように解き放たれる時を待ち焦がれている。"}],"source":"bangumi","sourceCharacterId":"143070"}],"profileFacts":[{"label":"年龄（本版本）","value":"19 岁","valueContext":null,"source":"egs","sourceCharacterId":"19466","sourceWorkId":"9688","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"19466","sourceWorkId":"9688","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"19466","sourceWorkId":"9688","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"19466","sourceWorkId":"9688","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/8136dd7af5c742eed1ed8a38999b5ec1be8377b39f7c1094d58460459a39280e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d710c900439719e9a302c5c00ee5308213d9ffba13d54dcc75aa5bf00b779813.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"葉月","creatorId":"vndb:s17844","sourcePersonId":"vndb:s17844","canonicalEntityId":"vndb:s17844","name":"葉月","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:464902:143070:25418:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p789","sourceCompanyId":"egs:brand:2081","canonicalEntityId":"vndb:p789","name":"もーにんぐ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:9688:2081","source":"egs"},{"companyId":"vndb:p789","sourceCompanyId":"vndb:p789","canonicalEntityId":"vndb:p789","name":"もーにんぐ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:5692:v2431","source":"vndb"},{"companyId":"vndb:p789","sourceCompanyId":"vndb:p789","canonicalEntityId":"vndb:p789","name":"もーにんぐ","roleCodes":["develo