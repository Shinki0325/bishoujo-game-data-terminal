":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Former high school classmate of Takurou and a friend of Asuka. She is currently working as a signboard girl at Kumano, a grocery store."},{"spoiler":false,"text":"She has a carefree personality that does not consider other people's feelings. She used to torment Takurou about Asuka's rejection of him. Kaori often speaks without thinking, bringing up memories of her school days end up hurting Takurou."},{"spoiler":false,"text":"Translated from Official site"}],"source":"vndb","sourceCharacterId":"c106985"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f64b6ffbae074c7f6448cd904a8557862cef2e06c9967c0d79beda521a1829d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e1e92e6a350f8753e0e43b267eb05660a8c312989f0b2451005816f8881af08.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴音 華月","creatorId":"vndb:s931","sourcePersonId":"vndb:s931","canonicalEntityId":"vndb:s931","name":"飯野 ユウ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55653","source":"vndb"}]},{"characterId":"char_vndb_c106987","characterName":"麻宮 美涼","sourceIds":{"vndbCharacterId":"c106987"},"originalCharacterName":"麻宮 美涼","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She talks like a Yankee because she acts like a yankee. She was Takurou's senpai in high school and treated him as an errand boy. She has a strong temperament and can come off as unreasonable."},{"spoiler":false,"text":"She t