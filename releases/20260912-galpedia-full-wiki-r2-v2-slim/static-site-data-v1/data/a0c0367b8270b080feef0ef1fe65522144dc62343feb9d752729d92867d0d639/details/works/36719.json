":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"因家人被Dusk所杀，为了复仇而志愿成为GrowDoll。"},{"spoiler":false,"text":"成为Doll后失去了人类时期的记忆。"},{"spoiler":false,"text":"在百年的时间里与伊兹搭档消灭Dusk，相当仰慕伊兹。在伊兹被同伴偷袭受伤后，带上她逃离了部队。"}],"source":"bangumi","sourceCharacterId":"178176"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20a16d0d21390a06216af7c1451a675fabbf8e1797c6bf2d727634134d4d3c2c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/912cab34cf325cd4aa622c2dce588a97f90fbe5d2da1cc8ec73e016e507417dd.webp","width":190,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_180608","characterName":"イズ","sourceIds":{"bangumi":[{"characterId":"180608","match":"source-roster","subjectId":"491258"}]},"originalCharacterName":"イズ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"艾失忆后所产生的新人格。"},{"spoiler":false,"text":"实力强大，是相当有名的Doll，与科妮娅搭档。"},{"spoiler":false,"text":"不过后来被部队偷袭重创了她，在逃跑的过程中该人格下线，人格重新变回艾。"}],"source":"bangumi","sourceCharacterId":"180608"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6221f09e810652a06d0690df479eb98e4efeb4866691f4b291d3e70c8373f75.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e03cf16075f7345d80345f08969f722aa2f11e1b79cd81199abe5748547fb41c.webp","width":157,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_180609","characterName":"アイリス","sourceIds":{"bangumi":[{"characterId":"180609","match":"source-roster","subjectId":"491258"}]},"originalCharacterName":"アイリス","characterNameSource":null,"role":"配角","status":"source-only-candida