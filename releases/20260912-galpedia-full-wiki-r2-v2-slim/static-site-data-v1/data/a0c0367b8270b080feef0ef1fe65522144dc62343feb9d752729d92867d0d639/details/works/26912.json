3","source":"vndb"}]},"cast":[{"characterId":"char_c73963","characterName":"茂庭 有華","sourceIds":{"bangumi":[{"characterId":"66761","match":"exact-normalized-name-in-linked-work","subjectId":"249810"}],"egsCharacterIds":["20547"],"vndbCharacterId":"c73963"},"originalCharacterName":"茂庭 有華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Present"},{"spoiler":false,"text":"A junior of Shou in his part time job place. Because of her behavior and attitude, her atmosphere is similar to Yuuna's. Because of this, Shou's a bit not good with her, but becomes her trainer anyway."},{"spoiler":false,"text":"She's aiming to become a model in future, and spares some effort everyday just to get a \"like\" on social media."}],"source":"vndb","sourceCharacterId":"c73963"},{"segments":[{"spoiler":false,"text":"翔(主人公)のバイト先の後輩。"},{"spoiler":false,"text":"言動や行動から、雰囲気が優奈と似ている事もあって、翔は苦手としているが、彼女の研修のパートナーになってしまう。"},{"spoiler":false,"text":"将来はモデルを目指していて、SNSのいいねを獲得するべく日々努力を惜しまない。"}],"source":"egs","sourceCharacterId":"20547","sourceWorkId":"26912","spoiler":false},{"segments":[{"spoiler":false,"text":"翔のバイト先の後輩。"},{"spoiler":false,"text":"言動や行動から、雰囲気が優奈と似ている事もあって、翔は苦手としているが、彼女の研修トレーナーになってしまう。"},{"spoiler":false,"text":"将来はモデルを目指していて、SNSの「いいね」を獲得するべく日々努力を惜しまない。"},{"spoiler":false,"text":"「先輩、これイイネ付くと思いますか？」"}],"source":"bangumi","sourceCharacterId":"66761"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/2936e951f3b9fcc0680e12d37faca720d4bf9b65fdf522544f0c3986ad960b6c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d967bfee40cb3eb0df1d71904a889f846559fc47fad08d6bf699e08016c72d6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:249810:66761:11646:1","source":"bangumi"}]},{"characterId":"char_c73966","characterName":"芋沢 えりな","sourceIds":{"bangumi":[{"characterId":"66760","match":"exact-normalized-name-in-linked-work","subjectId":"249810"}],"egsCharacterIds":["20546"],"vndbCharacterId":"c73966"},"originalCharacterName":"芋沢 えりな","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shou's kouhai and Yuuna's best friend. After Yuuna's disappearance she stopped talking to Shou and Rie."}],"source":"vndb","sourceCharacterId":"c73966"},{"segments":[{"spoiler":false,"text":"翔の実家の近所に住んでいて、小さい頃は理恵と共によく遊んだ幼馴染。"},{"spoiler":false,"text":"3年生になり久々に同じ学校に通う事になったが、その姿は学校デビューに失敗して髪が想定外の明るさに。"},{"spoiler":false,"text":"それでも持ち前の明るさを武器にその事をネタにしている。"},{"spoiler":false,"text":"そんな見た目と行動とは裏腹にこれといった特技もなく、将来の夢もないのが悩み。 歌う事は好きらしい。"}],"source":"egs","sourceCharacterId":"20546","sourceWorkId":"26912","spoiler":false},{"segments":[{"spoiler":false,"text":"翔の実家の近所に住んでいて、小さい頃は理恵と共によく遊んだ幼馴染。"},{"spoiler":false,"text":"3年生になり久々に同じ学校に通う事になったが、その姿は学校デビューに失敗して髪が想定外の明るさに。"},{"spoiler":false,"text":"それでも持ち前の明るさを武器にその事をネタにしている。"},{"spoiler":false,"text":"そんな見た目と行動とは裏腹に、これといった特技もなく、将来の夢もないのが悩み。歌う事は好きらしい。"},{"spoiler":false,"text":"「ちょっ、先輩～～～ぃ。芋って言うなし～～～。まじ」"},{"spoiler":false,"text":"優奈失踪後、親友をなくしたショックからか持ち前の明るさを失ってしまい、大学に入ってもロクに授業に参加せず、何故かバイトに明け暮れているらしい。"},{"spoiler":false,"text":"唯一の趣味である歌の活動をしている最中に翔と再会し、徐々に自分の夢を思い出していく。"},{"spoiler":false,"text":"「夢持って頑張ってもさ、無意味だったら寂しいじゃん」"}],"source":"bangumi","sourceCharacterId":"66760"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f4cb904eb060f44b0a7091e5b2e3d5574b3d0441adb263505436d000eb3bc5b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9d25b6c5f56a4c821ba1bb618d3acf85b9b487e79378dd323c6cd21cacb8195.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:249810:66760:6351:1","source":"bangumi"}]},{"characterId":"char_c73967","characterName":"五橋 紗江子","sourceIds":{"bangumi":[{"characterId":"66759","match":"exact-normalized-name-in-linked-work","subjectId":"249810"}],"egsCharacterIds":["20545"],"vndbCharacterId":"c73967"},"originalCharacterName":"五橋 紗江子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"地元では誰もが知る名家の娘。"},{"spoiler":false,"text":"お嬢様ではあるが、本人はそんな素ぶりを一切せず、誰にでも明るく接していて男女からも人気。"},{"spoiler":false,"text":"家の事情で婚約者がいるらしく、それが原因で過去に翔(主人公)とはいい感じの仲だったが……。"}],"source":"egs","sourceCharacterId":"20545","sourceWorkId":"26912","spoiler":false},{"segments":[{"spoiler":false,"text":"地元では誰もが知る名家の娘。"},{"spoiler":false,"text":"お嬢様ではあるが、本人はそんな素ぶりを一切せず、誰にでも明るく接していて男女からも人気。"},{"spoiler":false,"text":"家の事情で婚約者がいるらしく、それが原因で過去に翔とはいい感じの仲だったが……。"},{"spoiler":false,"text":"「きっと、恋をしても損するだけだから」"},{"spoiler":false,"text":"大学進学後も成績がよく、アルバイトやサールク活動も頑張っていて誰もが憧れる存在。"},{"spoiler":false,"text":"モデルやタレントにスカウトされる程だが、彼氏がいる気配は全くない。"},{"spoiler":false,"text":"大学卒業後は地元に戻る事が決まっているため、何のために頑張っているんだろうかと日々疑問に思っていた所、偶然東京で翔と再会する。"},{"spoiler":false,"text":"「私は決められたレールの上を歩くしかない人生だから」"}],"source":"bangumi","sourceCharacterId":"66759"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af05090c9eae044b8a20d34257ac392a9593c27d780f33f084bfee2b228d8223.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60493cd98e7968da57f81ed78c9a64478dae8f27233c744a30b9a24d97d65e6a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原舞","creatorId":"vndb:s985","sourcePersonId":"vndb:s985","canonicalEntityId":"vndb:s985","name":"石原 舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:249810:66759:13372:1","source":"bangumi"}]},{"characterId":"char_c73968","characterName":"上杉 理恵","sourceIds":{"bangumi":[{"characterId":"66758","match":"exact-normalized-name-in-linked-work","subjectId":"249810"}],"egsCharacterIds":["20544"],"vndbCharacterId":"c73968"},"originalCharacterName":"上杉 理恵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shou's childhood friend and present girlfriend."}],"source":"vndb","sourceCharacterId":"c73968"},{"segments":[{"spoiler":false,"text":"成績優秀、THE理系女子で本人曰く、恋愛には向いていないらしいが、卒業を機に自然と翔と付き合う事に。"},{"spoiler":false,"text":"翔とは小さい頃からの幼馴染で、子供の頃はよく一緒に遊んで、学生になってからはよくお互いの家で一緒に勉強をしている。"},{"spoiler":false,"text":"父親は有名な学者らしく、翔が理恵の家に遊びに行くとよく研究や発明品を見せてくれたが、中学生のある時期に突然何も残さずに失踪してしまう。"}],"source":"egs","sourceCharacterId":"20544","sourceWorkId":"26912","spoiler":false},{"segments":[{"spoiler":false,"text":"成績優秀、THE理系女子で本人曰く、恋愛には向いていないらしいが、卒業を機に自然と翔と付き合う事に。"},{"spoiler":false,"text":"翔とは小さい頃からの幼馴染で、子供の頃はよく一緒に遊んで、学生になってからはよくお互いの家で一緒に勉強をしている。"},{"spoiler":false,"text":"父親は有名な学者らしく、翔が理恵の家に遊びに行くとよく研究や発明品を見せてくれたが、中学生のある時期に突然何も残さず失踪してしまう。"},{"spoiler":false,"text":"「あんたと私が付き合ってるなんて信じられない。確率で言えば1％未満のはずなのに」"},{"spoiler":false,"text":"優奈失踪後、まるで魂が抜けてしまった翔を側で支え、志波浦学校を卒業直前に翔と付き合う事に。"},{"spoiler":false,"text":"同じ大学に進学し、一緒の授業をとるほど仲が良かったが、以前と比べてどこか変わってしまった翔に疑問を抱いている。"},{"spoiler":false,"text":"「ねぇ、私は誰？ 私は……あんたの彼女なんだよ？」"}],"source":"bangumi","sourceCharacterId":"66758"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b8c6602da12e5676b3b477a757a373ff148b8769aa078b8e5ff238550f6c0f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9fe59737fdd8a65fa1b35efa8615bf478eac33e5938689a192f2a41026085e5e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:249810:66758:10026:1","source":"bangumi"}]},{"characterId":"char_c76134","characterName":"片平 優奈","sourceIds":{"bangumi":[{"characterId":"66757","match":"exact-normalized-name-in-linked-work","subjectId":"249810"}],"egsCharacterIds":["20543"],"vndbCharacterId":"c76134"},"originalCharacterName":"片平 優奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shou's girlfriend in the past who suddenly disappeared after the festival."}],"source":"vndb","sourceCharacterId":"c76134"},{"segments":[{"spoiler":false,"text":"その見た目の可愛さから入学当時は男子から人気だったが、突拍子もない行動を取るため、一年生では浮いた存在に。"},{"spoiler":false,"text":"よく授業を途中から堂々とサボる。"},{"spoiler":false,"text":"が、その時校舎裏で翔(主人公)と出会いいつしか仲良くなり付き合う事に。"},{"spoiler":false,"text":"あまり友達はいないが芋沢えりなとは波長が合うらしい。"},{"spoiler":false,"text":"趣味は変身ヒーロー物のグッズ集め。"}],"source":"egs","sourceCharacterId":"20543","sourceWorkId":"26912","spoiler":false},{"segments":[{"spoiler":false,"text":"その見た目の可愛さから入学当時は男子から人気だったが、突拍子もない行動を取るため、一年生では浮いた存在に。"},{"spoiler":false,"text":"よく授業を途中から堂々とサボる。"},{"spoiler":false,"text":"が、その時校舎裏で翔と出会い、いつしか仲良くなり付き合う事に。"},{"spoiler":false,"text":"あまり友達はいないが芋沢えりなとは波長が合うらしい。"},{"spoiler":false,"text":"趣味は変身ヒーローのグッズ集め。"},{"spoiler":false,"text":"「任せて、先輩の卒業式には夜の内に校舎の窓ガラス壊してまわるから」」"}],"source":"bangumi","sourceCharacterId":"66757"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59cb5d6c20c7dafded70d0243dcfa45866e8cf2d0eec13a2b9e5fd78442f03f9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/115276c455865ef250fce6b5517da933ba6b62a1e35320a0e6a6418da2646145.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:249810:66757:5936:1","source":"bangumi"}]},{"characterId":"char_vndb_c73969","characterName":"葉山 架純","sourceIds":{"vndbCharacterId":"c73969"},"originalCharacterName":"葉山 架純","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6df94a52b62250c6b0db2f18b4dbb1e8a3a3a052b7704791a6e347167e729617.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c5699e40326b711d8d13079e52dc2209060c9bfa6ab42213c1ede395f3a0616.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"歩 サラ","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"