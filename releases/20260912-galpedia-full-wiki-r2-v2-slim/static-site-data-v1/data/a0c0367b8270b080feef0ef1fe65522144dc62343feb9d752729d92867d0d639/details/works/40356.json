":false,"text":"go together?"},{"spoiler":false,"text":"She's, like, uber feminine, so I'm guessing she's into knitting, embroidery, gardening— you know."},{"spoiler":false,"text":"Those kinds of things."},{"spoiler":false,"text":"From Digital Artwork book"}],"source":"vndb","sourceCharacterId":"c156184"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/790998609bf222c6d9147d1a0cb418ec0744e930fa18c96eb27e3e89f8658c0d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/8160b4f2ffdb02bbe56bcc5471eaf5f70e85d63ca8ad9fe82eb902443a34b35d.webp","width":143,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c156185","characterName":"サピルス・ハニーサックル","sourceIds":{"vndbCharacterId":"c156185"},"originalCharacterName":"サピルス・ハニーサックル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"622"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"159"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Police Corps Captain that serves the Crown Prince."},{"spoiler":false,"text":"I hear he's a cold-hearted machine with unwavering loyalty to his duties and the Imperial Family!"},{"spoiler":false,"text":"The Prince's orders are absolute! That's the kind of guy he is. Apparently, he can go a little overboard trying to get things done. Seriously, the military is scary!"},{"spoiler":false,"text":"From Digital Artwork book"}],"source":"vndb","sourceCharacterId":"c156185"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v