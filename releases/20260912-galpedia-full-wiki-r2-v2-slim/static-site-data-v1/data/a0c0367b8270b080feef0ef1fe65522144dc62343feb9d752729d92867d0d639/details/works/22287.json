tate":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kenta's upperclassman and acquaintance from his former academy's student council."},{"spoiler":false,"text":"They later became friends, and continue to maintain a relationship of that of an older sister and a younger brother. It wasn't until recently that they started seeing each other as members of the opposite sex, but have yet to express those feelings outright."},{"spoiler":false,"text":"Korone is an assertive and positive young woman, but can oftentimes come off as being too rough due to her go-getter attitude. She's incredibly awkward when it comes to romance, and isn’t the type to bargain or compromise. Deep down, she’s a maiden at heart and will do nothing but blush and stutter when put into a compromising situation."},{"spoiler":false,"text":"\"I said so, so it must be true! Or maybe you don’t trust me? Everything will be all right! You've got me on your side, so believe in me!\""},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c36077"},{"segments":[{"spoiler":false,"text":"以前の学園で主人公と委員会で一緒だった1年上の先輩。"},{"spoiler":false,"text":"それを機に話すようになり、姉弟のような関係を続けてきた。"},{"spoiler":false,"text":"普段は積極的でグイグイくる行動派、そして姉貴肌のせいか少々荒々しい、だが根が乙女であり、いざとなったら赤面してしまいなにも出来ない。"},{"spoiler":false,"text":"恋愛については不器用で、駆け引きは超ニガテ。"}],"source":"egs","sourceCharacterId":"7404","sourceWorkId":"22287","spoiler":false},{"segments":[{"spoiler":false,"text":"身長：162cm　 スリーサイズ：B85（E）/ W54/ H84"},{"spoiler":false,"text":"所属：猫カフェ にゃん花亭　　誕生日：5月16日　　出身地：東京"},{"spoiler":false,"text":"主人公・健太が以前の学園で同じ委員会だった 1年上の先輩。"},{"spoiler":false,"text":"それを機に話すようになり、姉弟のような関係を続けてきた。"},{"spoiler":false,"text":"いつしか双方共に異性として意識し始めるが、告白するには至っていない。"},{"spoiler":false,"text":"普段は積極的でグイグイくる行動派、そして姉貴肌のせいか少々荒々しい。"},{"spoiler":false,"text":"恋愛については不器用で、駆け引きなど出来るタイプではない。"},{"spoiler":false,"text":"根が乙女なので、いざという時に赤面してしまい何もできなくなる。"},{"spoiler":false,"text":"「私が言うんだから間違いないって！ それとも信じられない？　大丈夫、一緒にやってあげるから私を信じて！」"}],"source":"bangumi","sourceCharacterId":"35297"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"7404","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"7404","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"7404","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"7404","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"7404","sourceWorkId":"22287","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78b09dd8016daa697796c85e466ddaf76d59b46cba1d146c05e12ed6892140cb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfd2f2fa800dbb6a895de088309295861127c3b10735461e7b30f57778cfc540.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:145393:35297:10026:1","source":"bangumi"}]},{"characterId":"char_c36078","characterName":"犬甲斐 しのの","sourceIds":{"bangumi":[{"characterId":"35296","match":"exact-normalized-name-in-linked-work","subjectId":"145393"}],"egsCharacterIds":["7403"],"vndbCharacterId":"c36078"},"originalCharacterName":"犬甲斐 しのの","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1201"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kenta's paternal cousin."},{"spoiler":false,"text":"Shinono currently lives in Paris and is a pâtissière-in-training at PochiTama's France branch. She returns to Japan after being selected to participate in the exam, but becomes aloof when she learns that Kenta has forgotten all about their childhood promise. Contrary to her words, she's quite happy at their reunion and always seems ecstatic to be around him."},{"spoiler":false,"text":"She is an earnest girl who refines her skills by using love as her driving force!"},{"spoiler":false,"text":"\"Jeez, you should be a little more self-aware, Onii-chan! You have no idea how much grief you have put me through...\""},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c36078"},{"segments":[{"spoiler":false,"text":"パリに住む主人公の従妹。"},{"spoiler":false,"text":"数年ぶりに日本へ帰ってきたものの、幼い頃に交わした約束を覚えていない主人公に腹を立て、ツンツンした態度を取ってしまう。"},{"spoiler":false,"text":"でも、それ以上に久しぶりに主人公と居られることが嬉しくて、言動とは裏腹に顔は終始 嬉しそう。"},{"spoiler":false,"text":"恋を原動力に、パティシエとしてのスキルを磨いてきた一途な少女。"}],"source":"egs","sourceCharacterId":"7403","sourceWorkId":"22287","spoiler":false},{"segments":[{"spoiler":false,"text":"身長：155cm　 スリーサイズ：B85（F）/ W52/ H82"},{"spoiler":false,"text":"所属：犬カフェ びーんずぱぴー　　誕生日：12月1日　　出身地：パリ"},{"spoiler":false,"text":"健太の父方の従妹。"},{"spoiler":false,"text":"PochiTamaパティシエール学園 フランス校・パティシエ科に所属。"},{"spoiler":false,"text":"パリ在住だが選抜に選ばれ、数年ぶりに日本へ帰ってきた。"},{"spoiler":false,"text":"幼い頃の約束を覚えていない健太に腹を立て、ツンツンした態度を取ってしまうが、"},{"spoiler":false,"text":"それ以上に久しぶりの再会が嬉しくて、その言動とは裏腹に顔は終始 嬉しそう。"},{"spoiler":false,"text":"恋を原動力に、パティシエとしてのスキルを磨いてきた一途な少女。"},{"spoiler":false,"text":"「もぉもぉ、お兄ちゃんはちょっとは自覚を持つこと！　本当にいつもいつも苦労をかけて……」"}],"source":"bangumi","sourceCharacterId":"35296"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"7403","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"7403","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"7403","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"7403","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"7403","sourceWorkId":"22287","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fcc2fdd1af6d49b3cab20719e62dc390ed47fd9021a65f2d593e172a44b8e800.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/4291873b5ad2bedaa3dd20b99dff3cb4f0ffe4b36d6517471ab484895a079d4b.webp","width":158,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤邑鈴香","creatorId":"vndb:s2309","sourcePersonId":"vndb:s2309","canonicalEntityId":"vndb:s2309","name":"藤邑鈴香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:145393:35296:16173:1","source":"bangumi"}]},{"characterId":"char_c38284","characterName":"猫泊 真琴","sourceIds":{"bangumi":[{"characterId":"38913","match":"exact-normalized-name-in-linked-work","subjectId":"145393"}],"egsCharacterIds":["7406"],"vndbCharacterId":"c38284"},"originalCharacterName":"猫泊 真琴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"422"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student at PochiTama's Kyoto branch, where she specializes in western confections."},{"spoiler":false,"text":"Makoto is a flexible, yet vigilant young woman who always observes each situation from an outside perspective before shifting into action. Her family owns a long-standing Japanese-style pâtisserie, Nekonoya, that’s famous enough to receive occasional media coverage."},{"spoiler":false,"text":"Being familiar with the art of Japanese confectionery since childhood, Makoto's breathtaking talent and ingenuity made her the top pâtissière at her family's store. She enrolled at PochiTama to experiment with different types of confections and develop new recipes to improve upon existing Japanese sweets. Makoto currently works at a western-style pâtisserie where her seemingly endless potential seems to shine through."},{"spoiler":false,"text":"\"If we team up, Kenta, then we'll be able to push each other to even greater heights. Don't you think we'll make great partners who support one another?\""},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c38284"},{"segments":[{"spoiler":false,"text":"PochiTamaパティシエール学園京都校、西洋菓子科に所属。"},{"spoiler":false,"text":"実家はメディアでも度々紹介される老舗の和菓子屋『猫乃屋』。"},{"spoiler":false,"text":"和菓子の可能性を広げるため様々なジャンルのお菓子を勉強したいと思い学園に入った。現在は洋菓子科に所属しているが、そこでも生まれ持った才能を遺憾なく発揮している。"}],"source":"egs","sourceCharacterId":"7406","sourceWorkId":"22287","spoiler":false},{"segments":[{"spoiler":false,"text":"PochiTamaパティシエール学園 京都校・西洋菓子科に所属。"},{"spoiler":false,"text":"物事を俯瞰的に捉え、自分の立ち位置を瞬時に判断して行動に移す柔軟性を持つ。"},{"spoiler":false,"text":"実家はメディアでも度々紹介される老舗の和菓子屋・猫乃屋。"},{"spoiler":false,"text":"幼い頃から和菓子に慣れ親しんでおり、天才的な能力も相まって技術はすでに店一番。"},{"spoiler":false,"text":"和菓子の可能性を広げるため、様々なジャンルのお菓子を勉強したいと思い学園へ入学。"},{"spoiler":false,"text":"洋菓子科に所属しているが、そこでも生まれ持った才能を遺憾なく発揮している。"},{"spoiler":false,"text":"「健太、私と組めば今よりももっと上を目指せるわ。 私たちはお互いを高め合える、素敵なパートナーになれると思わない？」"},{"spoiler":false,"text":"PochiTama糕点师学园京都分校・西点科所属。"},{"spoiler":false,"text":"有着能从大局上俯瞰局势，从而瞬间判断自己立场而行动的柔软性。"},{"spoiler":false,"text":"老家是媒体也不断介绍过的老字号日式点心屋・猫乃屋。"},{"spoiler":false,"text":"因自幼便接触熟悉日式点心，在天才的能力与手艺的配合下已经成为了店里最好的点心师。"},{"spoiler":false,"text":"想要扩大日式点心的可能性，于是为了学习各种各样的点心而入学。"},{"spoiler":false,"text":"虽然目前所属西点科，但在那里仍旧能毫无保留地发挥着自己的才能。"},{"spoiler":false,"text":"「健太，如果和我组队的话便能朝着比现在更高的目标前进呢。我们互相让彼此进步，会成为非常棒的搭档不是吗？」"}],"source":"bangumi","sourceCharacterId":"38913"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"7406","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"7406","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"7406","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"7406","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"7406","sourceWorkId":"22287","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b4a69c1bd50a54b100062c23ff2f5d7f34056ff2bf0df1daa40ec3d05e7d5c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca554edbfb4fa78fd8451a75b62b078648e5fbd4de06d265c1da24875d63dbc8.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間宮菜南子","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:145393:38913:15995:1","source":"bangumi"}]},{"characterId":"char_c38285","characterName":"犬多 華","sourceIds":{"bangumi":[{"characterId":"38914","match":"exact-normalized-name-in-linked-work","subjectId":"145393"}],"egsCharacterIds":["7405"],"vndbCharacterId":"c38285"},"originalCharacterName":"犬多 華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"pending-conflict","source":"vndb","value":"630"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hana specializes in western confections and is a student at PochiTama's Kyoto branch."},{"spoiler":false,"text":"At first glance, she's a confident young woman who gives off a very strong-willed impression. Her family owns a popular western-styled pâtisserie. She and Makoto are childhood friends, who live across the street from one another."},{"spoiler":false,"text":"To Hana’s dismay, Makoto's skills as a pâtissière quickly surpassed her own. Seeing Makoto as her eternal rival, Hana works hard so her childhood friend will acknowledge her efforts."},{"spoiler":false,"text":"\"Losing is quite unbecoming! I'll have Makoto apologizing on her hands and knees before too long!\""},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c38285"},{"segments":[{"spoiler":false,"text":"PochiTamaパティシエール学園京都校、西洋菓子科に所属。"},{"spoiler":false,"text":"実家は近所から愛される洋菓子店。"},{"spoiler":false,"text":"真向かいにある和菓子屋の一人娘・真琴とは物心をついたときからの付き合い。どんなことでも完璧にこなしてしまう真琴に劣等感を持ち、ライバル意識を燃やしている。"},{"spoiler":false,"text":"必ず真琴に自分のことを認めさせる!"},{"spoiler":false,"text":"それをスローガンに今日も張り切る女の子。"}],"source":"egs","sourceCharacterId":"7405","sourceWorkId":"22287","spoiler":false},{"segments":[{"spoiler":false,"text":"PochiTamaパティシエール学園 京都校・西洋菓子科に所属。"},{"spoiler":false,"text":"見るからに自信家と思わせる気の強そうな顔立ちの女の子。"},{"spoiler":false,"text":"実家は近所から愛される洋菓子店で、真向かいの和菓子屋の娘・真琴とは幼なじみ。"},{"spoiler":false,"text":"あろうことか真琴が洋菓子科に入ってきて、自分をアッサリと追い抜いてしまう。"},{"spoiler":false,"text":"そんな真琴をライバル視し、彼女に自分のことを認めさせようと張り切っている。"},{"spoiler":false,"text":"「わたくしに敗北は似合いませんわ。 いつしか必ず真琴さんをこの足下にひれ伏してみせますわ」"},{"spoiler":false,"text":"PochiTama糕点师学园京都分校・西点科所属。"},{"spoiler":false,"text":"光看外表就会让人觉得是自信家的强气少女。"},{"spoiler":false,"text":"老家是被街坊爱戴的西点铺，和正对面的日式点心铺的女儿・真琴是自懂事起就相识的青梅竹马。"},{"spoiler":false,"text":"各种原因下进入西点科的真琴，因其无论在何处都能无懈可击的才能，竟然轻易地就超过了自己。"},{"spoiler":false,"text":"为此抱有劣等感而把那样的真琴看作对手，今日的少女也在为了能让对手承认自己而努力奋斗。"},{"spoiler":false,"text":"「我和败北可不相配呢。终有一日定要让真琴拜倒在我的脚下」"}],"source":"bangumi","sourceCharacterId":"38914"}],"profileFacts":[{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"7405","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"7405","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"7405","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"7405","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"7405","sourceWorkId":"22287","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"birthday":[{"comparisonValue":"0630","source":"vndb","sourceCharacterId":"c38285","value":"630"},{"comparisonValue":"0422","source":"egs","sourceCharacterId":"7405","value":"4/22"},{"comparisonValue":"0630","source":"bangumi","sourceCharacterId":"38914","value":"6月30日"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/236404acdd90652896c4078d85493f3af6b7aa166d075341b773de9650024895.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2ee36f0f494f32e05afc94d33e8867940940c02748bb42acb73817a53be4264.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風花ましろ","creatorId":"vndb:s5762","sourcePersonId":"vndb:s5762","canonicalEntityId":"vndb:s5762","name":"中野 純花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:145393:38914:20833:1","source":"bangumi"}]},{"characterId":"char_c38286","characterName":"猫条 ひなな","sourceIds":{"bangumi":[{"characterId":"38915","match":"exact-normalized-name-in-linked-work","subjectId":"145393"}],"egsCharacterIds":["7408"],"vndbCharacterId":"c38286"},"originalCharacterName":"猫条 ひなな","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"906"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"98"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student at PochiTama’s Sapporo branch, where she is a pâtissière-in-training. Hinana is a gentle young lady, who can be a bit of an airhead and oddball at times."},{"spoiler":false,"text":"She loves eating above all else, and can usually be found munching on something. She believed choosing such a profession would mean she would always have a full belly. Hinana's parents taught her how to cook at a very young age, and her skills as a pâtissière are that of a professional. After tasting a cake Kenta made, Hinana fell in love with the flavor and struggles day and night to replicate it."},{"spoiler":false,"text":"She has an assertive and open-minded attitude when it comes to sex, and will partake in just about anything."},{"spoiler":false,"text":"\"Oh my, what a tasty-looking cake...! Just looking at it is making me drool. No need to slice the thing up. We can eat it whole, right?\""},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c38286"},{"segments":[{"spoiler":false,"text":"PochiTamaパティシエール学園札幌校、パティシエ科に所属。"},{"spoiler":false,"text":"なにより食べることが大好きで、常に何かしら食べている。"},{"spoiler":false,"text":"食べることが好きすぎて、自分で美味しい物を作れば、いつも満腹で幸せになれると考えてしまい学園に入学している。"},{"spoiler":false,"text":"普段はおっとりしたお嬢様系な女の子。でも、少々ズレているところのがあり天然タイプ。"}],"source":"egs","sourceCharacterId":"7408","sourceWorkId":"22287","spoiler":false},{"segments":[{"spoiler":false,"text":"PochiTamaパティシエール学園 札幌校・パティシエ科に所属。"},{"spoiler":false,"text":"おっとりしたお嬢様で、少々ズレているところのある天然な女の子。"},{"spoiler":false,"text":"何より食べることが大好きで、常に何かしら食べている。"},{"spoiler":false,"text":"自分で美味しい物を作ればいつも満腹で幸せになれると考えて料理の道を選んだ。"},{"spoiler":false,"text":"幼少期より親に料理を叩き込まれ、すでに料理の腕前はプロレベル。"},{"spoiler":false,"text":"健太の作ったケーキに魅了され、自分もそれを作りたいと日々ケーキ作りに奮闘中。"},{"spoiler":false,"text":"性に対しては積極的で、どんなことでも受け入れる柔軟性を持っている。"},{"spoiler":false,"text":"「まあ、なんて美味しそうなガトーショコラなんでしょう。 見ているだけでヨダレが垂れてしまいます。 切り分けなくてもいいですよ。 そのままワンホールいただけますか？」"},{"spoiler":false,"text":"PochiTama糕点师学园札幌分校・糕点师科所属。"},{"spoiler":false,"text":"落落大方的富家千金，稍微少根筋的天然女孩子。"},{"spoiler":false,"text":"对吃的热爱远超其它事物，无论何时都在吃着东西。"},{"spoiler":false,"text":"在想到能自己亲手制作美味的食物从而天天能够填饱肚子的幸福后，便选择了料理的道路。"},{"spoiler":false,"text":"从年幼起就被双亲灌输了料理的知识和技艺，料理的能力早已是专业级别。"},{"spoiler":false,"text":"被健太制作的蛋糕魅了，自己也想制作那种蛋糕而每天奋斗。"},{"spoiler":false,"text":"对性的事情非常积极，有着无论怎样的行为都能接受的柔软性。"},{"spoiler":false,"text":"「嘛，这看起来是多么美味的巧克力蛋糕啊。仅仅是看着口水都快滴下来了。即使不切了分开也没关系哦。让我就那样一口吃下可以吗？」"}],"source":"bangumi","sourceCharacterId":"38915"}],"profileFacts":[{"label":"胸围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"7408","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"7408","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"7408","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"7408","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"7408","sourceWorkId":"22287","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fd1ae6c371009936700856c9ba1b50127eff67ccd7ae533474fd23a2d9c810b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2bff28be7235b6b8b32922c5ba032e0cef98bf6a1fcc5612d5150094311fc192.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤さくら","creatorId":"vndb:s947","sourcePersonId":"vndb:s947","canonicalEntityId":"vndb:s947","name":"花澤 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:145393:38915:17075:1","source":"bangumi"}]},{"characterId":"char_c38287","characterName":"犬山 道代","sourceIds":{"bangumi":[{"characterId":"38916","match":"exact-normalized-name-in-linked-work","subjectId":"145393"}],"egsCharacterIds":["7407"],"vndbCharacterId":"c38287"},"originalCharacterName":"犬山 道代","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"301"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"172"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student and pâtissière-in-training at PochiTama’s Hakata-ku branch. Michiyo is a serious and earnest girl with a samurai-like disposition, one which never wavers after she's made up her mind."},{"spoiler":false,"text":"Her father once took her to a temple festival at a very young age, where she first encountered Amezaiku, or Japanese candy art, which is often made in the shape of animals or people. Enthralled by the delicate process, Michiyo stubbornly insisted that she, too, would someday create such intricate confections."},{"spoiler":false,"text":"She works hard to create a confection that would entrance anyone who lays eyes on it, and toils day and night to further hone her skills as a pâtissière."},{"spoiler":false,"text":"\"Fashioned candy reflects the heart of its creator. I've still got a long way to go, and that peak of serenity is still out of my reach...\""},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c38287"},{"segments":[{"spoiler":false,"text":"PochiTamaパティシエール学園博多校、パティシエ科に所属。"},{"spoiler":false,"text":"幼い頃父親に連れて行かれた祭りの縁日で飴細工と出会い、その繊細な仕事ぶりに感銘を受け、自分の進むべき道はこれだと幼い頃から決めてしまった頑固一徹な女の子。"},{"spoiler":false,"text":"見る者全てを魅了する作品を目指し、日々の鍛錬を怠らない。"},{"spoiler":false,"text":"生真面目で頑な、融通の利かない程、これだと決めたことには、妥協しない真摯な心の持ち主。"}],"source":"egs","sourceCharacterId":"7407","sourceWorkId":"22287","spoiler":false},{"segments":[{"spoiler":false,"text":"PochiTamaパティシエール学園 博多校・パティシエ科に所属。"},{"spoiler":false,"text":"生真面目な性格で、一度決めたら妥協しない真摯な心を持った侍のような女の子。"},{"spoiler":false,"text":"幼い頃に父親と行った祭りの縁日で飴細工と出会い、その繊細な仕事ぶりに感銘を受ける。"},{"spoiler":false,"text":"そして、それだけで若くして自分の進むべき道を決めた頑固一徹。"},{"spoiler":false,"text":"見る者すべてを魅了する作品を目指し、日々の鍛錬を怠らない。"},{"spoiler":false,"text":"「飴細工は、作り手の心を写す。 私はまだまだ未熟だ、明鏡止水の高みは遙かに遠い」"},{"spoiler":false,"text":"PochiTama糕点师学园博多分校・糕点师科所属。"},{"spoiler":false,"text":"顽固正经的性格，一言既出驷马难追，真挚之心下隐藏着武士之魂的女孩子。"},{"spoiler":false,"text":"年幼时在和父亲参加的祭典缘日里看到做糖工艺，被它的那份纤细手法感动。"},{"spoiler":false,"text":"于是，就只是因为这个契机而决定了其将成为自己应走的道路从此一往无前。"},{"spoiler":false,"text":"为了创作出让所有人看了都会入迷的作品而每天不懈锻炼。"},{"spoiler":false,"text":"「做糖，能将制作者的心表达出来。我还远远没有成熟，那明镜止水的高度对我来说还遥不可见」"}],"source":"bangumi","sourceCharacterId":"38916"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"7407","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"7407","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"172 cm","valueContext":null,"source":"egs","sourceCharacterId":"7407","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"7407","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"7407","sourceWorkId":"22287","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c637bf25a793448afe0a57a3179797eb231f32eda9b6b1306058a9ed894f36da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e305e00b7c61091479a4502c08d01094f16708506148448307ec77059e959ee3.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏野虹花","creatorId":"vndb:s3218","sourcePersonId":"vndb:s3218","canonicalEntityId":"vndb:s3218","name":"夏野虹花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:145393:38916:15736:1","source":"bangumi"}]},{"characterId":"char_c38288","characterName":"猫玉 瑠偉","sourceIds":{"bangumi":[{"characterId":"38917","match":"exact-normalized-name-in-linked-work","subjectId":"145393"}],"egsCharacterIds":["7410"],"vndbCharacterId":"c38288"},"originalCharacterName":"猫玉 瑠偉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1214"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The \"good-for-nothing\" principal of the school. Both her and Fumiko are the same age and graduated together from Pochitama. Always surrounded by her three cats Kaia, Oruteka, and Morta, she does nothing but lazying around in the principals office, eating fast food, and being scolded by Fumiko. The only thing she dislikes more than working is being treated like a child."}],"source":"vndb","sourceCharacterId":"c38288"},{"segments":[{"spoiler":false,"text":"先代理事長の実の娘で、現PochiTamaパティシエール学園理事長。"},{"spoiler":false,"text":"理事長とは、ただ椅子に座って偉そうにしているだけでお金のもらえる楽な仕事だと信じ就いてみれば、むしろ忙しくてゲンナリしているダメな大人。"},{"spoiler":false,"text":"モットーは、しなくていいことは絶対にしない、しなければいけないことは誰かがやってくれる！　である。"}],"source":"egs","sourceCharacterId":"7410","sourceWorkId":"22287","spoiler":false},{"segments":[{"spoiler":false,"text":"先代理事長の実の娘で、現PochiTamaパティシエール学園理事長。"},{"spoiler":false,"text":"理事長は椅子に座って偉そうにしているだけでお金のもらえる楽な仕事だと信じていた。"},{"spoiler":false,"text":"だが実際に就いてみると、むしろ忙しくてゲンナリしているダメな大人。"},{"spoiler":false,"text":"モットーは、“しなくていいことは絶対にしない、しなければいけないことは誰かがやってくれる！”。"},{"spoiler":false,"text":"素材は美少女そのものだが、本人にやる気がないので全体的に野暮ったい。"},{"spoiler":false,"text":"やる気のない眼差しに、適当にまとめた髪の毛。 完全な干物女。"},{"spoiler":false,"text":"「え～、めんどーだからヤダ。代わりにやっといてぇ～、理事長命令ね。 逆らったら死刑だかんね？」"},{"spoiler":false,"text":"前代理事长的亲生女儿，现PochiTama糕点师学园的理事长。曾相信理事长就是坐在椅子上装出一副了不起的样子便能赚到钱的轻松工作。"},{"spoiler":false,"text":"但是实际就任后，因忙得不可开交而开始泄气的废柴大人。"},{"spoiler":false,"text":"座右铭是，“能不做的事就绝对不做，必须要做的事就推给别人！”。"},{"spoiler":false,"text":"虽然本身是美少女素质，但因本人完全没干劲打扮而暴殄天物。"},{"spoiler":false,"text":"缺乏干劲的眼神，搭配着随意整理的发型。完全的干物女。"},{"spoiler":false,"text":"「哎～、因为麻烦所以不要。代替我搞定它吧～理事长的命令哦。违抗的话就判死刑哦？」"}],"source":"bangumi","sourceCharacterId":"38917"}],"profileFacts":[{"label":"胸围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"7410","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"7410","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"148 cm","valueContext":null,"source":"egs","sourceCharacterId":"7410","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"7410","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"7410","sourceWorkId":"22287","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fca6cf389b0abc766e8a4b7dc0ee6a8af68f9f7d18060db203822ab78b87dd5b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53b68e94f18c237f6506e194a63d97d9cdd6047b7bca712514cdbe85e9e4b599.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大野まりな","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:145393:38917:4434:1","source":"bangumi"}]},{"characterId":"char_c38289","characterName":"文子・豆柴・シェパード","sourceIds":{"bangumi":[{"characterId":"38918","match":"exact-normalized-name-in-linked-work","subjectId":"145393"}],"egsCharacterIds":["7409"],"vndbCharacterId":"c38289"},"originalCharacterName":"文子・豆柴・シェパード","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"906"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kenta's maternal cousin."}],"source":"vndb","sourceCharacterId":"c38289"},{"segments":[{"spoiler":false,"text":"PochiTamaパティシエール学園本校パティシエ科の講師にして主人公のいとこ。"},{"spoiler":false,"text":"文子は主人公の母親の姉の娘であり、実の姉のような存在。"},{"spoiler":false,"text":"生まれたときから主人公を知り、おむつも替えたことがある。"},{"spoiler":false,"text":"そのため、主人公にとっては頭の上がらない存在。"},{"spoiler":false,"text":"この度、「びーんずぱぴー」の監督役として研修に参加する。"}],"source":"egs","sourceCharacterId":"7409","sourceWorkId":"22287","spoiler":false},{"segments":[{"spoiler":false,"text":"PochiTamaパティシエール学園 本校・パティシエ科の講師。 健太の母方の従姉。"},{"spoiler":false,"text":"生まれた時から健太を知る実姉のような存在で、オムツも替えたことがある。"},{"spoiler":false,"text":"そのため、健太にとっては頭の上がらない存在。"},{"spoiler":false,"text":"わんカフェ『びーんずぱぴー』の監督役として研修に参加する。"},{"spoiler":false,"text":"「当学園で学ぶ者としての自覚を持ち、日々精進に励め！　怠惰な態度は、私の目が黒いうちはけして許さん！　肝に銘じておけ！」"},{"spoiler":false,"text":"PochiTama糕点师学园本校・糕点师科的讲师。健太的母方表姐。"},{"spoiler":false,"text":"自健太出生便在身边如同亲姐姐般的存在，甚至还帮忙换过尿布。"},{"spoiler":false,"text":"因此对于健太来说是个不可能驾驭的存在。"},{"spoiler":false,"text":"作为汪咖啡厅『BeansPuppy』的监督参加了这次进修。"},{"spoiler":false,"text":"「时刻保持自己是本学园学生的自觉，每天都致力于精进技艺！懒惰的态度，在我的双眼被蒙蔽之前绝对不允许！好好铭记于心！」"}],"source":"bangumi","sourceCharacterId":"38918"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"7409","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"7409","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"7409","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"7409","sourceWorkId":"22287","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"7409","sourceWorkId":"22287","sourceField":null,"scoped":tru