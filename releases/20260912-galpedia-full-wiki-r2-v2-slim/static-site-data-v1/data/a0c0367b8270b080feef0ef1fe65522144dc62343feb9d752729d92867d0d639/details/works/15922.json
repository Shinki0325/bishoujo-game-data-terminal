{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"15922","model":{"presentationWorkId":"vndb:v12718","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_110104","characterName":"中村蛍","sourceIds":{"bangumi":[{"characterId":"110104","match":"source-roster","subjectId":"99179"}]},"originalCharacterName":"中村蛍","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"近隣の町に住む、ある商家の一人娘。"},{"spoiler":false,"text":"友人である『かな』に会いに来た帰り道、すれ違っただけの男に求婚をされてしまう。"},{"spoiler":false,"text":"頭脳明晰、容姿端麗、気立ても良しと三拍子揃った評判を持つが、反面、理屈で外面を取り繕っている自分自身を小賢しいと嫌悪もしている。"},{"spoiler":false,"text":"父親とは何かしら反りの合わないところがあった様子。"}],"source":"bangumi","sourceCharacterId":"110104"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9dacd8639b3ccc181c19701833c872704088cd9bede7e8614669fd120139f7c8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0ace0a70dadfeeb2b9ca30172b19b6dad3c92c3f86660e3020e302c8a72cd2a1.webp","width":114,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_110105","characterName":"片倉重蔵","sourceIds":{"bangumi":[{"characterId":"110105","match":"source-roster","subjectId":"99179"}]},"originalCharacterName":"片倉重蔵","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"とある小藩の末端の家に生まれた、血気盛んな若侍。"},{"spoiler":false,"text":"ずけずけと相手の懐に入っていく無神経さを疎ましく思われることもあるが、生来の無邪気さと、裏表のない真っ直ぐさがそれ以上に人を惹きつける。"},{"spoiler":false,"text":"また、幼少から続けている剣術の腕は相当なもので、"},{"spoiler":false,"text":"若くして名瀬道場師範を務めている。"},{"spoiler":false,"text":"境遇に流されるまま生きていく事に疑問を抱き、"},{"spoiler":false,"text":"己の身の振りを考えている。"}],"source":"bangumi","sourceCharacterId":"110105"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e7c04f4d62048d4ffbe4c6aaeb9d0bb5bc5c422d2b47ce1e9f2993b668e2608.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/335b3510a5ed99d0890f399eefaceabdf6c0cfbbdb2afb13e87e80c73dfa5c75.webp","width":114,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p3427","sourceCompanyId":"egs:brand:2727","canonicalEntityId":"vndb:p3427","name":"影法師","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:15922:2727","source":"egs"},{"companyId":"vndb:p3427","sourceCompanyId":"vndb:p3427","canonicalEntityId":"vndb:p3427","name":"影法師","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:31647:v12718","source":"vndb"},{"companyId":"vndb:p3427","sourceCompanyId":"vndb:p3427","canonicalEntityId":"vndb:p3427","name":"影法師","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:96670:v12718","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","egs-creator-credit-missing"],"source":"terminal-wiki-full-runtime-v7"}}
