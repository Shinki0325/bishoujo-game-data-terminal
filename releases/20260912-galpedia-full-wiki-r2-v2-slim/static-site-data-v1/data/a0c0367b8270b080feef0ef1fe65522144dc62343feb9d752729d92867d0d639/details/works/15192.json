{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"15192","model":{"presentationWorkId":"vndb:v6764","staff":{"artwork":[{"creditedName":"草上明","creatorId":"vndb:s5985","sourcePersonId":"egs:creator:15142","canonicalEntityId":"vndb:s5985","name":"草上明","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:95632","source":"egs"},{"creditedName":"笹井さじ","creatorId":"vndb:s1776","sourcePersonId":"egs:creator:5489","canonicalEntityId":"vndb:s1776","name":"笹井さじ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:95633","source":"egs"},{"creditedName":"犬洞 あん","creatorId":"vndb:s2480","sourcePersonId":"vndb:s2480","canonicalEntityId":"vndb:s2480","name":"犬洞 あん","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:66909","source":"vndb"}],"scenario":[{"creditedName":"藤原休樹(藤島晃)","creatorId":"vndb:s2553","sourcePersonId":"egs:creator:2059","canonicalEntityId":"vndb:s2553","name":"藤原休樹(藤島晃)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:95630","source":"egs"},{"creditedName":"企画屋","creatorId":"vndb:s1025","sourcePersonId":"egs:creator:188","canonicalEntityId":"vndb:s1025","name":"企画屋","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:95631","source":"egs"}],"music":[{"creditedName":"TOY","creatorId":"vndb:s1966","sourcePersonId":"egs:creator:17834","canonicalEntityId":"vndb:s1966","name":"TOY","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:137372","source":"egs"}],"other":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"egs:creator:5968","canonicalEntityId":"vndb:s295","name":"青葉りんご","detail":"OP曲「はだしのままで」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:145994","source":"egs"},{"creditedName":"青葉 りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:66904","source":"vndb"},{"creditedName":"宮沢 ゆあな","creatorId":"vndb:s830","sourcePersonId":"vndb:s830","canonicalEntityId":"vndb:s830","name":"宮沢ゆあな","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66905","source":"vndb"},{"creditedName":"水鼠","creatorId":"vndb:s5004","sourcePersonId":"vndb:s5004","canonicalEntityId":"vndb:s5004","name":"水鼠","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66911","source":"vndb"}]},"cast":[{"characterId":"char_c9321","characterName":"阿月 七夕","sourceIds":{"bangumi":[{"characterId":"11104","match":"exact-normalized-name-in-linked-work","subjectId":"11261"},{"characterId":"11104","match":"exact-normalized-name-in-linked-work","subjectId":"17358"},{"characterId":"11104","match":"exact-normalized-name-in-linked-work","subjectId":"81868"}],"egsCharacterIds":["3058"],"vndbCharacterId":"c9321"},"originalCharacterName":"阿月 七夕","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"807"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"落ち着きの無さは健在だが、昔と比べて成長している……らしい。"},{"spoiler":false,"text":"朝の弱さを克服しようと邁進するものの、手を繋ぐ登校は健在中。"},{"spoiler":false,"text":"真悠人と結ばれた後は気合いが空回りしている状態。"},{"spoiler":false,"text":"目指すはヒーローだけど、今は恋する乙女になっている。"}],"source":"egs","sourceCharacterId":"3058","sourceWorkId":"15192","spoiler":false},{"segments":[{"spoiler":false,"text":"【天然癒し系クラスメイト】"},{"spoiler":false,"text":"とっくに成長期が過ぎているにも関わらず、未だに12時間睡眠が必須な女の子。"},{"spoiler":false,"text":"目覚めてしばらくは寝ぼけて、夜もすぐに眠たくなってしまう。"},{"spoiler":false,"text":"その甲斐があってか、すっかり天然さんに育ってしまい、今日もまたみんなを和ませる。"},{"spoiler":false,"text":"ルーキーながらも将来有望な魔砲使いなのだが、落ち着きのなさが最大の欠点。"},{"spoiler":false,"text":"そこに眠気が加わったらレッドゾーンで、決まって魔砲を暴走させてしまう。"},{"spoiler":false,"text":"魔砲の制約がなければ、魔砲都市のビル群はとうの昔に消滅しているというのは有名な話。"},{"spoiler":false,"text":"「わたしの方が先輩さんなんだよ。だから分からないことは何でも聞いてね。えっへん」"}],"source":"egs","sourceCharacterId":"3058","sourceWorkId":"19499","spoiler":false},{"segments":[{"spoiler":false,"text":"尽管早已过了成长期，到现在每天还必须睡上12小时的女孩子。"},{"spoiler":false,"text":"醒来之后有段时间是迷迷糊糊的，晚上也很快就会犯困。"},{"spoiler":false,"text":"谢天谢地，完全长成了一个天然呆，今天也继续治愈着大伙。"},{"spoiler":false,"text":"身为将来有望的新人魔炮使，不够安分是最大的缺点。"},{"spoiler":false,"text":"如果再加上睡意那就是危险地带，必定会使魔炮暴走。"},{"spoiler":false,"text":"如果没有魔炮的限制的话，魔炮都市的大厦群早就消灭了。这是个很有名的传闻。"},{"spoiler":false,"text":"魔炮器：ファイアバード（Fire Bird）　属性：炎"},{"spoiler":false,"text":"象征着七夕隐藏在内心深处的熊熊燃烧的热情。"},{"spoiler":false,"text":"射程距离为近距离至远距离的万能型。"},{"spoiler":false,"text":"虽然也能展开屏障进行高速突击，但在没加速时只能当当盾牌用。"},{"spoiler":false,"text":"本人的运动能力很强，格斗战也没问题。"}],"source":"bangumi","sourceCharacterId":"11104"}],"profileFacts":[{"label":"胸围（本版本）","value":"秘密","valueContext":"原文","source":"egs","sourceCharacterId":"3058","sourceWorkId":"15192","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"もうちょっと伸びてほしい","valueContext":"原文","source":"egs","sourceCharacterId":"3058","sourceWorkId":"15192","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"満足","valueContext":"原文","source":"egs","sourceCharacterId":"3058","sourceWorkId":"15192","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"もう一息","valueContext":"原文","source":"egs","sourceCharacterId":"3058","sourceWorkId":"15192","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"普通だと思うな","valueContext":"原文","source":"egs","sourceCharacterId":"3058","sourceWorkId":"15192","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97fd2e53a203de548e3d931c8a7faefe718386a2a3a0b9be46c145b439fa0e1a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f26a6467660338da0d755a4c9fe66145f0a8f05ee527a5b3ce25a5bf99633fc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴田 美夜子","creatorId":"vndb:s446","sourcePersonId":"vndb:s446","canonicalEntityId":"vndb:s446","name":"若林 直美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:37571","source":"vndb"}]},{"characterId":"char_c9322","characterName":"万代 爽夏","sourceIds":{"bangumi":[{"characterId":"11105","match":"exact-normalized-name-in-linked-work","subjectId":"11261"},{"characterId":"11105","match":"exact-normalized-name-in-linked-work","subjectId":"17358"},{"characterId":"11105","match":"exact-normalized-name-in-linked-work","subjectId":"81868"}],"egsCharacterIds":["3059"],"vndbCharacterId":"c9322"},"originalCharacterName":"万代 爽夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"911"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"立てば芍薬、座れば牡丹、歩く姿は百合の花。"},{"spoiler":false,"text":"その言葉に相応しい女性になろうと、だらしなさを矯正している。"},{"spoiler":false,"text":"暇さえあれば、真悠人にプレゼントされた指輪を見つめる毎日。"},{"spoiler":false,"text":"そんな彼女にも人並みの悩みが生まれているようで……"}],"source":"egs","sourceCharacterId":"3059","sourceWorkId":"15192","spoiler":false},{"segments":[{"spoiler":false,"text":"【黙っていれば完璧な小悪魔お姉さん】"},{"spoiler":false,"text":"立てば芍薬、座れば牡丹、歩く姿は百合の花。"},{"spoiler":false,"text":"これで口を開かなければ完璧だが、そうならないのが世の常。"},{"spoiler":false,"text":"そんな花を一撫でで枯らしてしまうほどのぐうたら人間で、信用した相手には小悪魔の尻尾を出して、毎日のように弄ぶとか弄ばないとか。"},{"spoiler":false,"text":"一応、魔砲器隊では年長者で中心人物らしい。"},{"spoiler":false,"text":"「次、私に同じことしたら……ふふっ、分かるわよね？」"}],"source":"egs","sourceCharacterId":"3059","sourceWorkId":"19499","spoiler":false},{"segments":[{"spoiler":false,"text":"站如芍药，坐如牡丹，步姿有如百合花。"},{"spoiler":false,"text":"要是还能闭嘴的话就完美了，然而不能尽如人意正是世间常理。"},{"spoiler":false,"text":"是个只要摸一摸就能让啥芍药牡丹百合枯萎的懒婆娘，对信任的人则露出小恶魔的尾巴，日复一日地戏弄之·又好像没这回事。"},{"spoiler":false,"text":"姑且在魔炮器队中属于年长者，貌似是中心人物。"},{"spoiler":false,"text":"魔炮器：ガイア（Gaea）　属性：土"},{"spoiler":false,"text":"名副其实地表示着地球，象征着自己的母性。"},{"spoiler":false,"text":"射程距离为长距离，还兼具防御系保护。起到了固定炮台的作用。"},{"spoiler":false,"text":"单发，而且射出时必然会产生巨大的硬直，但相对地威力高到了他人望尘莫及的程度。"}],"source":"bangumi","sourceCharacterId":"11105"}],"profileFacts":[{"label":"胸围（本版本）","value":"ヒ","valueContext":"原文","source":"egs","sourceCharacterId":"3059","sourceWorkId":"15192","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"もう必要ないわね","valueContext":"原文","source":"egs","sourceCharacterId":"3059","sourceWorkId":"15192","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"ツ","valueContext":"原文","source":"egs","sourceCharacterId":"3059","sourceWorkId":"15192","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"モ","valueContext":"原文","source":"egs","sourceCharacterId":"3059","sourceWorkId":"15192","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"マナー違反よ","valueContext":"原文","source":"egs","sourceCharacterId":"3059","sourceWorkId":"15192","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/224d7c4bf1f19781082489899b7b9f66f204cf2ebda2dae2de25e60ae7c1b177.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bc26a26c79365887663f5275cd911f547fb8cbebb93989aca646ca9b178ade4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"葛西 優美","creatorId":"vndb:s240","sourcePersonId":"vndb:s240","canonicalEntityId":"vndb:s240","name":"今井 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:37575","source":"vndb"}]},{"characterId":"char_c9323","characterName":"天田 真姫","sourceIds":{"bangumi":[{"characterId":"11106","match":"exact-normalized-name-in-linked-work","subjectId":"11261"},{"characterId":"11106","match":"exact-normalized-name-in-linked-work","subjectId":"17358"},{"characterId":"11106","match":"exact-normalized-name-in-linked-work","subjectId":"81868"}],"egsCharacterIds":["3060"],"vndbCharacterId":"c9323"},"originalCharacterName":"天田 真姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"321"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"つい最近復帰したばかりの超人気美少女アイドル。"},{"spoiler":false,"text":"全国ツアーのスケジュールを見事に果たし、健在をアピールした。"},{"spoiler":false,"text":"真悠人との時間も取れるようになり、思う存分に甘えようとする。"},{"spoiler":false,"text":"その矢先に判明した事実が彼女を悩ませたりもして……"}],"source":"egs","sourceCharacterId":"3060","sourceWorkId":"15192","spoiler":false},{"segments":[{"spoiler":false,"text":"【世話焼きツンデレアリドル】"},{"spoiler":false,"text":"現在休業中の超人気美少女アイドル。"},{"spoiler":false,"text":"歌って踊って、さらに魔砲も使えるアイドルを目指して修行中らしい。"},{"spoiler":false,"text":"しかし、ダメ人間の集団である魔砲器隊に放り込まれたのが運の尽き。"},{"spoiler":false,"text":"持ち前の人の良さを発揮してしまい、一番磨かれた技術は家事だと言う。"},{"spoiler":false,"text":"今では彼女なしでは生活できず、寮の大黒柱になっているとか。"},{"spoiler":false,"text":"「下僕の分際で隠し事なんて１０年早いのよ、バカ」"}],"source":"egs","sourceCharacterId":"3060","sourceWorkId":"19499","spoiler":false},{"segments":[{"spoiler":false,"text":"现在休业中的超人气美少女偶像。"},{"spoiler":false,"text":"貌似正在以成为载歌载舞还能使用魔炮的偶像为目标修行中。"},{"spoiler":false,"text":"然而，被扔进废人集团的魔炮器队标志着她的好运走到了尽头。"},{"spoiler":false,"text":"发挥出了天生的烂好人性格，据说进步最大的技术是家务。"},{"spoiler":false,"text":"还据说现在要是没了她大伙都活不成，已经成为了宿舍里的顶梁柱。"},{"spoiler":false,"text":"魔炮器：ベーチェル（Betep）　属性：风"},{"spoiler":false,"text":"不会被任何人改变形状、掌握实态的自由的象征。"},{"spoiler":false,"text":"靠弹奏魔炮器或者歌唱发出冲击波。音波兵器。射程距离为中距离，支援系。"},{"spoiler":false,"text":"能够独自攻击很广的范围，但一被接近就很不妙。虽然能飞，但移动很慢。"}],"source":"bangumi","sourceCharacterId":"11106"}],"profileFacts":[{"label":"胸围（本版本）","value":"もう少し","valueContext":"原文","source":"egs","sourceCharacterId":"3060","sourceWorkId":"15192","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"普通じゃない？","valueContext":"原文","source":"egs","sourceCharacterId":"3060","sourceWorkId":"15192","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"悩みの種","valueContext":"原文","source":"egs","sourceCharacterId":"3060","sourceWorkId":"15192","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"努力の成果","valueContext":"原文","source":"egs","sourceCharacterId":"3060","sourceWorkId":"15192","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"トップシークレットよ。","valueContext":"原文","source":"egs","sourceCharacterId":"3060","sourceWorkId":"15192","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e394c9dd9a6d6ef173abb3ca917496784d1921021f4a5691bf936920c766982.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d2850cc95b51c0ccc134705195a844c39487571350a2b434667d60a7595b8ed.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉 りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:37569","source":"vndb"}]},{"characterId":"char_c9324","characterName":"来島 リリィ","sourceIds":{"bangumi":[{"characterId":"11107","match":"exact-normalized-name-in-linked-work","subjectId":"11261"},{"characterId":"11107","match":"exact-normalized-name-in-linked-work","subjectId":"17358"},{"characterId":"11107","match":"exact-normalized-name-in-linked-work","subjectId":"81868"}],"egsCharacterIds":["3061"],"vndbCharacterId":"c9324"},"originalCharacterName":"来島 リリィ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"601"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"まずは自分にできることを探していこう。"},{"spoiler":false,"text":"世界一周旅行から帰った後、リリィは身近な目標を立てた。"},{"spoiler":false,"text":"要領の悪さは変わらないけど、今日も誰かのために努力し続ける。"},{"spoiler":false,"text":"その成果が現れる日がいつになるかは分からないものの。"}],"source":"egs","sourceCharacterId":"3061","sourceWorkId":"15192","spoiler":false},{"segments":[{"spoiler":false,"text":"【いろいろと残念なちっちゃな先輩】"},{"spoiler":false,"text":"帰国子女でハーフなのが運の尽き。"},{"spoiler":false,"text":"英語ペラペラで成績優秀だと勘違いされることがしばしばだが、本人は至って論外。"},{"spoiler":false,"text":"勉強ダメ、運動ダメ、プロポーション壊滅的の三重苦を背負っている。"},{"spoiler":false,"text":"担任の印象を少しでも良くするため、礼儀正しく接していたものの、そのギャップが自分自身に齟齬をきたしてしまい、すっかりやさぐれてしまう。"},{"spoiler":false,"text":"今では2つの顔を使い分ける二重人格者として、アカデミーの卒業を目指していると言う。"},{"spoiler":false,"text":"「おいこら、あたしを無視して話を進めるな。ちっちゃくて見えなかったとか言ったら叩く」"}],"source":"egs","sourceCharacterId":"3061","sourceWorkId":"19499","spoiler":false},{"segments":[{"spoiler":false,"text":"身为混血儿的归国子女标志着她噩运的开始。"},{"spoiler":false,"text":"虽然经常被误解英语流利成绩优秀，但对本人来说根本没这回事。"},{"spoiler":false,"text":"肩负着学习不行、运动不行、身材不堪入目的三重痛苦。"},{"spoiler":false,"text":"为了尽量给班主任一个好印象，曾经表现得很有礼貌，但其间落差反而使自我产生了龃龉，如今已经完全自暴自弃了。"},{"spoiler":false,"text":"据说现在作为灵活使用两张面孔的二重人格者，以从学园毕业为目标。"},{"spoiler":false,"text":"魔炮器：ウルザブルン（Urtharbrunnr）　属性：水"},{"spoiler":false,"text":"由来于主掌着过去的ウルズ（Urthr）的泉水的象征。"},{"spoiler":false,"text":"长于索敌能力，使被称为“目”的魔炮阵大量出现，绝不放过目标。"},{"spoiler":false,"text":"还能散布在一定程度上会自动追踪敌人而去的无数圆形跟踪弹。"}],"source":"bangumi","sourceCharacterId":"11107"}],"profileFacts":[{"label":"胸围（本版本）","value":"夢と希望","valueContext":