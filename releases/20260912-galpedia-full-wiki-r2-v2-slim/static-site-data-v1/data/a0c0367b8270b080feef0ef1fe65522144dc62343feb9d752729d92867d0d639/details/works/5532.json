tionId":"vndb:vn-staff:139851","source":"vndb"},{"creditedName":"秋山 奈津","creatorId":"vndb:s44616","sourcePersonId":"vndb:s44616","canonicalEntityId":"vndb:s44616","name":"秋山 奈津","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:139856","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c1001","characterName":"藤崎 詩織","sourceIds":{"vndbCharacterId":"c1001"},"originalCharacterName":"藤崎 詩織","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The player's childhood friend. Once you two were really good friends, but you seemed to have drifted apart. Both intelligent and beautiful, Shiori is one of the most popular girls in her school. To win her heart, the player needs very good stats all-around, as well as get into a first-class university. She is never seen without her trademark yellow headband. Shiori is one of the first three phone numbers the player obtains early in the game."}],"source":"vndb","sourceCharacterId":"c1001"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a5b8affd8d2f7d8650cb94e13f08cbaf9beabbdfafbcc1c2327e97a12935248.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e6b3e87773d31fb54dfff1363c69e925055b0042bbc8bc00ef3a1ae43f997b0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金月 真美","creatorId":"vndb:s3629","sourcePersonId":"vndb:s3629","canonicalEntityId":"vndb:s3629","name":"金月 真美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73934","source":"vndb"}]},{"characterId":"char_vndb_c1002","characterName":"早乙女 好雄","sourceIds":{"vndbCharacterId":"c1002"},"originalCharacterName":"早乙女 好雄","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Often seen around school usually with other girls, Yoshio provides the player with information on the available girls, including their phone numbers, blood type, and various things they like earning him the nickname \"Info Otaku\". Yoshio's phone number is one of the three phone numbers you receive in the beginning of the game."},{"spoiler":false,"text":"If certain conditions are met, he will become a rival to the player at the end of the third year, attempting to win the heart of one of the girls. The girl he ends up with are limited only to those the player has met and will depend on the player's own success with the girl he has chosen; however, he does not directly fight for any girl the player has chosen."},{"spoiler":false,"text":"In the spin-off game Tokimeki no Houkago ~Ne Quiz Shiyo~, Yoshio is a winnable character although the player does not actually end up with him; instead, the player and Yoshio make a pact to both find girlfriends. This makes him the only male character (not counting Tokimeki Memorial Girl's Side, the female-oriented branch of the franchise) the main character can end up with."},{"spoiler":false,"text":"Edited from the PlayStation DataCenter"}],"source":"vndb","sourceCharacterId":"c1002"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd8b7080efef4e2ab4a946b58d22a479c832c6755ae0fd10ee385c6c3a496f73.webp","fallbackUrl":"https://wiki-assets.bi