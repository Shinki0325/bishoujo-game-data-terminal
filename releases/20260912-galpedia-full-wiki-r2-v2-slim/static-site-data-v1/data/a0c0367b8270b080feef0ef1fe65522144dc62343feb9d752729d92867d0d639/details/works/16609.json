ame":"エチゴヤ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:86528","source":"vndb"},{"creditedName":"佐藤 輝政","creatorId":"vndb:s14905","sourcePersonId":"vndb:s14905","canonicalEntityId":"vndb:s14905","name":"佐藤 輝政","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:86529","source":"vndb"},{"creditedName":"佐藤 輝政","creatorId":"vndb:s14905","sourcePersonId":"vndb:s14905","canonicalEntityId":"vndb:s14905","name":"佐藤 輝政","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:86530","source":"vndb"},{"creditedName":"向日葵","creatorId":"vndb:s1193","sourcePersonId":"vndb:s1193","canonicalEntityId":"vndb:s1193","name":"高梁 碧","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:86531","source":"vndb"}]},"cast":[{"characterId":"char_c10668","characterName":"ルナスティア・アスティール","sourceIds":{"bangumi":[{"characterId":"36147","match":"exact-normalized-name-in-linked-work","subjectId":"37793"}],"egsCharacterIds":["9017"],"vndbCharacterId":"c10668"},"originalCharacterName":"ルナスティア・アスティール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daughter of a royal family of succubi. Due to her condition she spent most of her childhood secluded in her room, therefore she doesn't know much about outside world. Thanks to her bloodline she posseses immense magical power."}],"source":"vndb","sourceCharacterId":"c10668"},{"segments":[{"spoiler":false,"text":"健人を襲ってしまった張本人であり、現代に生きるサキュバスたちの『姫』としても尊敬されている少女。"},{"spoiler":false,"text":"由緒正しい血筋に加えて、理由あって幼い頃から体調を崩しており、長く運動からは縁遠い生活を送っている、まさに「深窓の令嬢」。"}],"source":"egs","sourceCharacterId":"9017","sourceWorkId":"16609","spoiler":false},{"segments":[{"spoiler":false,"text":"サキュバスの世界でも由緒ある血筋を持つ名家の女の子。"},{"spoiler":false,"text":"ワケあって幼い頃から身体が弱く、ろくに外に出たこともない、まさに深窓の令嬢。"},{"spoiler":false,"text":"サキュバスではあるがどこまでもおとなしく、性格はひかえめ。"},{"spoiler":false,"text":"さらには健気で照れ屋と、どこまでもサキュバスらしくない性格をしている。"},{"spoiler":false,"text":"「私は、こうして眺めているだけで十分ですから……」"}],"source":"bangumi","sourceCharacterId":"36147"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/1163fc4b8cfc559c53d615b3e01005b048cfd327138bbc72c4bb153e0d6c3428.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbf82599748c77f1ee21c0f895963abf1ac652000669629c5105b7ef86d2793f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤美佳子","creatorId":"vndb:s1137","sourcePersonId":"vndb:s1137","canonicalEntityId":"vndb:s1137","name":"佐藤美佳子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37793:36147:6122:1","source":"bangumi"}]},{"characterId":"char_c10669","characterName":"リリエラ・チューラック","sourceIds":{"bangumi":[{"characterId":"36148","match":"exact-normalized-name-in-linked-work","subjectId":"37793"}],"egsCharacterIds":["9018"],"vndbCharacterId":"c10669"},"originalCharacterName":"リリエラ・チューラック","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Luna's best friend, personal maid and bodyguard. She visits Kento's flower shop regularly to buy flowers for Luna. Comes from a family of warriors and martial artists. Noel's sister."}],"source":"vndb","sourceCharacterId":"c10669"},{"segments":[{"spoiler":false,"text":"健人が事件に巻き込まれる前から面識のあった女の子で、健人が現在唯一抱えているお得意様。"},{"spoiler":false,"text":"非常にあっけらかんとした性格で、知らない人ともすぐに仲良くなれてしまう雰囲気を持っている明るい女の子。"}],"source":"egs","sourceCharacterId":"9018","sourceWorkId":"16609","spoiler":false},{"segments":[{"spoiler":false,"text":"健人との付き合いは一番長い、ポニーテールが目印の元気娘。"},{"spoiler":false,"text":"誰とでもすぐに仲良くなれる雰囲気を持っており、性格も非常にあっけらかんとしている。"},{"spoiler":false,"text":"昔からルナに付いている従者であり、彼女とはもっとも親しい関係にある。"},{"spoiler":false,"text":"従者として──そして親友として彼女のことを誰よりも心配している心優しい女の子。"},{"spoiler":false,"text":"「おっはよー♪　今日もイキのいいの入ってる？」"}],"source":"bangumi","sourceCharacterId":"36148"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/381cf5583568339e68019bbfcead0970884041b4dae23ea0d5df603302cf5d4c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52bc1ded759322572fa3992d942cc08d162c2047b428a4df036fce4b45c83b92.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平山ゆかり","creatorId":"vndb:s285","sourcePersonId":"vndb:s285","canonicalEntityId":"vndb:s285","name":"東かりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37793:36148:5905:1","source":"bangumi"}]},{"characterId":"char_c10728","characterName":"ティアナ・ジル・リリスティア","sourceIds":{"bangumi":[{"characterId":"36149","match":"exact-normalized-name-in-linked-work","subjectId":"37793"}],"egsCharacterIds":["9019"],"vndbCharacterId":"c10728"},"originalCharacterName":"ティアナ・ジル・リリスティア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Comes from the family that has managed Lilithtia Academy for many generations. Knowing that she will eventually inherit this position, she strives to be the perfect student and manager. She sees Luna as a rival and wants to beat her on every field."}],"source":"vndb","sourceCharacterId":"c10728"},{"segments":[{"spoiler":false,"text":"自分がサキュバスであるということに誇りを持つ、ルナとならんでサキュバス界では有名な銘家の一人。"},{"spoiler":false,"text":"その名前からも分かるようにリリスティア国際学園を運営しているのは彼女の家であり、その娘である彼女もまた学園の執行部（生徒会のようなもの）の長を務めている。"}],"source":"egs","sourceCharacterId":"9019","sourceWorkId":"16609","spoiler":false},{"segments":[{"spoiler":false,"text":"サキュバスの世界ではルナに並んで有名な名家のお嬢様。"},{"spoiler":false,"text":"リリスティア学園を運営している一族の娘であり、彼女もまた学園の学生会の長を務めているなど、精力的に活動している。"},{"spoiler":false,"text":"プライドが高く自分に厳しいが、性格が悪いわけではない。"},{"spoiler":false,"text":"長年休学していたルナに密かなライバル心を抱いており、その流れで健人にも興味を持つことになる。"},{"spoiler":false,"text":"「当たり前よ。私を誰だと思ってるのかしら？」"}],"source":"bangumi","sourceCharacterId":"36149"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c25f962a0243f354cde1c65a1d5fdeb2c1a97198c5644495654160f04c5a5c06.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1d4b2dbcd248a3d162680c203adcf4cfa4e0ea023921fdb412e8fbdd7ac3071.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉田愛理","creatorId":"vndb:s757","sourcePersonId":"vndb:s757","canonicalEntityId":"vndb:s757","name":"吉田 愛理","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37793:36149:6037:1","source":"bangumi"}]},{"characterId":"char_vndb_c10729","characterName":"ユーフォリア・トリニティ","sourceIds":{"vndbCharacterId":"c10729"},"originalCharacterName":"ユーフォリア・トリニティ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daughter of Trinity family that runs Trinity Hospital, she works there as a nurse and wants to be a doctor. Can use healing magic."}],"source":"vndb","sourceCharacterId":"c10729"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/0112af3