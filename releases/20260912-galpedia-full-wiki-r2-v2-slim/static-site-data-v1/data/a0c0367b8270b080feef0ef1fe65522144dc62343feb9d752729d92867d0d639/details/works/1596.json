"subjectId":"23561"}],"egsCharacterIds":["23919"],"vndbCharacterId":"c705"},"originalCharacterName":"橘 天音","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"222"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"同級生で幼なじみの少女。"},{"spoiler":false,"text":"純粋、素直、正直な性格のため、やや世間知らずな部分も。"},{"spoiler":false,"text":"面倒を見てあげたくなる妹っぽい女の子。"}],"source":"egs","sourceCharacterId":"23919","sourceWorkId":"218","spoiler":false},{"segments":[{"spoiler":false,"text":"Canvas的女主角，与主人公相识9年的青梅竹马，性格非常单纯同时也是个爱哭鬼。爱赖床，每天大辅的日课就是来叫她起床（青梅竹马+邻居）喜欢动物，特别是猫狗什么的。一直诺守着约定喜欢着大辅，无论何时何地都大辅身边行动以至学园的人公认是一对夫妻（悠说的）其实天音更像一种妹妹般存在的女孩。"}],"source":"bangumi","sourceCharacterId":"70029"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30afd31856ddcdcd4d3e7aa768a310ab4a6335c9fff61b25d573ea8e0754fd69.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18ff1b2aa28a0784ef70f4188f3778ba11dc1f7ce64ca6edf5ae4107c47bc365.webp","width":200,"height":200,"source":"static-detail"},"actors":[{"creditedName":"倖月美和","creatorId":"vndb:s1637","sourcePersonId":"vndb:s1637","canonicalEntityId":"vndb:s1637","name":"倖月 美和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224722:70029:11300:1","source":"bangumi"}]},{"characterId":"char_c708","characterName":"桜塚 恋","sourceIds":{"bangumi":[{"characterId":"70033","match":"exact-normalized-name-in-linked-work","subjectId":"23561"}],"egsCharacterIds":["23922"],"vndbCharacterId":"c708"},"originalCharacterName":"桜塚 恋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1014"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"父親の再婚相手の娘。後輩で、義理の妹。"},{"spoiler":false,"text":"いつも主人公に冷たくあたるが、心憎からず想っていることも……。"},{"spoiler":false,"text":"学園の男子に人気が高く、言い寄る男が後をたたない。"},{"spoiler":false,"text":"ツンデレ属性全開で、主人公を翻弄する。"}],"source":"egs","sourceCharacterId":"23922","sourceWorkId":"218","spoiler":false},{"segments":[{"spoiler":false,"text":"父亲再婚带过来的女孩，通称“義妹”。Canvas中唯一一个有暴力倾向，常常对大辅拳脚相加，每次都是以充满魄力的飞踢登场，汗...深入了解她之后才发现她是个可爱的女孩。"}],"source":"bangumi","sourceCharacterId":"70033"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16ce4755f3d609e031024920e437352a4fcaa63414bb849dd0f49b7df2dd50e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f342d85164c5e1321f948ea598364bb0e5097f4acc054ae0ac65453e2cef924.webp","width":200,"height":200,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"au