e,"text":"成績優秀ですがきつい性格で、敵妖怪に対してはも情け容赦ない。"},{"spoiler":false,"text":"低い身長とスレンダー（？）な体型がコンプレックス。"},{"spoiler":false,"text":"「背が低いから何よ。経験はあたしの方が上なんだからね。"},{"spoiler":false,"text":"この業界は年功序列じゃなくて実力主義なの。分かる？"},{"spoiler":false,"text":"だからそんな上から見下すような目線はやめてよね！」"}],"source":"egs","sourceCharacterId":"4516","sourceWorkId":"12486","spoiler":false},{"segments":[{"spoiler":false,"text":"霞ノ杜神社に所属する退魔巫女。二学期からの転入生。"},{"spoiler":false,"text":"本来の目的は以前担当していた事件の後始末だったのだが、そのまま弓橋市に滞在中。"},{"spoiler":false,"text":"妖怪を敵視する割りに、ペットとして胸元にカマイタチを飼っている。"}],"source":"egs","sourceCharacterId":"4516","sourceWorkId":"13179","spoiler":false},{"segments":[{"spoiler":false,"text":"妖怪殲滅派の霞ノ杜神社出身の新米巫女。"},{"spoiler":false,"text":"きつい性格で、妖怪に対しても情け容赦ありません。"}],"source":"egs","sourceCharacterId":"4516","sourceWorkId":"20960","spoiler":false},{"segments":[{"spoiler":false,"text":"霞ノ杜神社に所属する退魔巫女。"},{"spoiler":false,"text":"きつい性格で敵妖怪に対しては情け容赦しないが、いぶき達との交流や鎌鼬「ポチ」との出会いを通じて随分と物腰は柔らかくなった。"},{"spoiler":false,"text":"低い身長とスレンダー(?)な体型がコンプレックス。"}],"source":"egs","sourceCharacterId":"4516","sourceWorkId":"26775","spoiler":false},{"segments":[{"spoiler":false,"text":"妖怪殲滅派の霞ノ杜神社出身の新米巫女。"},{"spoiler":false,"text":"きつい性格で、妖怪に対しても情け容赦ありません。"},{"spoiler":false,"text":"「背が低いから何よ。経験はあたしの方が上なんだからね。」"}],"source":"bangumi","sourceCharacterId":"34864"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb6ebb26e26ae9f9276d046ba5be3729cef11ea63eb87e1b0d5142d22309e5d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0deee1c3612c792291640808fb83e9433b26bd7d62e35ec186f2fe018c9227b6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:143840:34864:4675:1","so