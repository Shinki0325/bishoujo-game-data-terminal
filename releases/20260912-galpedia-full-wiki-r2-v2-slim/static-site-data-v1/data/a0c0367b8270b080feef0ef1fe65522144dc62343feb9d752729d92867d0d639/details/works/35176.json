rce":"egs"},{"creditedName":"天翔 狗","creatorId":"vndb:s5399","sourcePersonId":"vndb:s5399","canonicalEntityId":"vndb:s5399","name":"天翔 狗","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:199981","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c133987","characterName":"アンジェリカ","sourceIds":{"vndbCharacterId":"c133987"},"originalCharacterName":"アンジェリカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Grad Duke's daughter. Doted since she was born since he had her in old age. Magnanimous despite being a princess, and often secretly goes to the village to play. Is paying the price for her father stealing from the forest in his place."},{"spoiler":false,"text":"While her noble father's hobby is to dress her in dazzling clothes, she is, at her core, a big-hearted, rambunctious wild child who disguises herself in plain clothes so she can sneak into the city and play. She does not about differences in social standing and other such things, but others do and resent her for it."}],"source":"vndb","sourceCharacterId":"c133987"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf4b0c782f2d419ccb732cbb0c23f376c1c0fd9ee32e30d8ac1151ec245786e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f79ee2300681d97b5f9484332281a206a5dba6e3f4d14a2567b375a5682c2ca5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥山 歩","creatorId":"vndb:s857","sourcePersonId":"vndb:s857","canonicalEntityId":"vndb:s857","name":"平松 真奈実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:96116","source":"vndb"}]},{"characterId":"char_vndb_c133996","characterName":"ティルディア","sourceIds":{"vndbCharacterId":"c133996"},"originalCharacterName":"ティルディア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A shrine maiden of a polytheistic state religion. As a maiden, she is even able to communicate with bugs."}],"source":"vndb","sourceCharacterId":"c133996"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80a1400d3545c8bfff9653271491838d4f9a2d6e23809b200925a4419fafea3b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/ccede461c723c64a8c3e1522367d2cf17a14565eb0adae0012ac5cc61e8fe62a.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"灰音","creatorId":"vndb:s14443","sourcePersonId":"vndb:s14443","canonicalEntityId":"vndb:s14443","name":"灰音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:96118","source":"vndb"}]},{"characterId":"char_vndb_c133997","characterName":"ミ・ウ","sourceIds":{"vndbCharacterId":"c133997"},"originalCharacterName":"ミ・ウ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl of the forest people. She is poor at speaking but is very expressive. Lives a modest life while coexisting with the bugs in the forest. She harbors a strong wariness towards humans intruding in the forest, and will growl at them like a wild animal to threaten them. She is very innocent in the sense that once she believes something, she will never question it."}],"source":"vndb","sourceCharacterId":"c133997"}],"