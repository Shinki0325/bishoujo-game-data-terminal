8","sourcePersonId":"vndb:s23148","canonicalEntityId":"vndb:s23148","name":"くぅす","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:73236","source":"vndb"},{"creditedName":"DAISUKE","creatorId":"vndb:s23149","sourcePersonId":"vndb:s23149","canonicalEntityId":"vndb:s23149","name":"DAISUKE","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:73237","source":"vndb"},{"creditedName":"株式会社天沼矛","creatorId":"vndb:s23292","sourcePersonId":"vndb:s23292","canonicalEntityId":"vndb:s23292","name":"株式会社天沼矛","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:73238","source":"vndb"}]},"cast":[{"characterId":"char_c18866","characterName":"風祭 衣","sourceIds":{"bangumi":[{"characterId":"13674","match":"exact-normalized-name-in-linked-work","subjectId":"21704"}],"egsCharacterIds":["9895"],"vndbCharacterId":"c18866"},"originalCharacterName":"風祭 衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's cousin and the elder of the two sisters. Quiet and elegant girl, but is actually a daredevil. Because she has the characteristic of being interested in everything, she is very good at researching and investigating supernatural things. Although her brain reacts very quick, her body can't keep up due to lack of exercise. Since she can experience a lot of interesting things when she is with the protagonist, she always sticks to him and research those things."}],"source":"vndb","sourceCharacterId":"c18866"},{"segments":[{"spoiler":false,"text":"一見優雅でお淑やかな性格だが、実はドドドS。"},{"spoiler":false,"text":"夕也と共にいればオカルト事件に出会えるので楽しんで行動を共にする。"},{"spoiler":false,"text":"妹とは違う意味でのいやらしボディ。"}],"source":"egs","sourceCharacterId":"9895","sourceWorkId":"15852","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・夕也の従姉妹で、二人姉妹の姉。"},{"spoiler":false,"text":"優雅でお淑やかな性格だが、実はドドドSなのを隠している。"},{"spoiler":false,"text":"物事をなんでも楽しむ気質で、オカルトを検証したり考えたりするのが得意。"},{"spoiler":false,"text":"頭の回転は速いのだが、運動神経は壊滅的。"},{"spoiler":false,"text":"夕也と一緒にいるとおもしろい事件に出会えるので、付いて回って解決したがる。"},{"spoiler":false,"text":"「このままずっと一緒にいたら、私までおかしくなってしまいそう。ふふっ、おかしくなってしまうのも楽しそうだけどね？」"}],"source":"bangumi","sourceCharacterId":"13674"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"9895","sourceWorkId":"15852","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"9895","sourceWorkId":"15852","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"9895","sourceWorkId":"15852","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"9895","sourceWorkId":"15852","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a971026649b5cc3221f1d31d196761b0352fda6aea41a7f268ee49a4082aa685.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cc354ff8f9076335994f3dc43fe372ea9bc84e796be51db7e35ff4ecd0554b1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤邑子","creatorId":"vndb:s833","sourcePersonId":"vndb:s833","canonicalEntityId":"vndb:s833","name":"後藤邑子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21704:13674:4514:1","source":"bangumi"}]},{"characterId":"char_c18867","characterName":"風祭 愛奈","sourceIds":{"bangumi":[{"characterId":"13673","match":"exact-normalized-name-in-linked-work","subjectId":"21704"}],"egsCharacterIds":["9894"],"vndbCharacterId":"c18867"},"originalCharacterName":"風祭 愛奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's cousin and the younger of the two sisters. On the surface she appears to be a calm and stable girl, but she is actually hiding her irrational side. She has very good physical abilities. Because of the fact that the protagonist has albino like white hair and rude manners, she has personally taken on the role of his caretaker. The reason she ties her hair up is because the protagonist complimented her when they were young."}],"source":"vndb","sourceCharacterId":"c18867"},{"segments":[{"spoiler":false,"text":"クールな性格をしているが、実は感情的な面もある。"},{"spoiler":false,"text":"ヤンチャな外見の夕也を見てグレたと思い込み、お目付け役を買って出る。"},{"spoiler":false,"text":"出るべきところは出て、引っ込むべきところは引っ込んでいる、いやらしボディの持ち主。"}],"source":"egs","sourceCharacterId":"9894","sourceWorkId":"15852","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・夕也の従姉妹で、二人姉妹の妹。"},{"spoiler":false,"text":"落ち着いたクールな性格をしているが、実は感情的な面を隠している。"},{"spoiler":false,"text":"運動神経も抜群だが、思い込んだら一直線なタイプで、よく道に迷うことも……。"},{"spoiler":false,"text":"銀髪でラフな格好の夕也を見てグレたと思い込み、お目付役を買って出る。"},{"spoiler":false,"text":"髪を結っているのは、幼い頃に夕也に褒められたからだったり。"},{"spoiler":false,"text":"「私は兄さんをちゃんと見守る義務があるんです。だからあんまりヤンチャはさせませんよ？」"}],"source":"bangumi","sourceCharacterId":"13673"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"9894","sourceWorkId":"15852","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"9894","sourceWorkId":"15852","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"9894","sourceWorkId":"15852","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"9894","sourceWorkId":"15852","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fdcc48f36070f95eb696cab76ce0a4f864aecc2a98b47b57dddf28692d49b6da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d9f6fe427e1660cfd9f0abb4b0391567c5954c948bc9429e50093ab0d325b6e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21704:13673:4646:1","source":"bangumi"}]},{"characterId":"char_c18868","characterName":"秋ヶ瀬 希美","sourceIds":{"bangumi":[{"characterId":"13678","match":"exact-normalized-name-in-linked-work","subjectId":"21704"}],"egsCharacterIds":["9896"],"vndbCharacterId":"c18868"},"originalCharacterName":"秋ヶ瀬 希美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's classmate and the discipline committee chairman. Forthright and serious, and as the chairman, she also has natural arrogance. But despite all that, she still has an interest in love as with all girls her age. Once she decides on the guy she wants, she will wholeheartedly try to win him over. She will not listen to the protagonist as she sees him as an eyesore."}],"source":"vndb","sourceCharacterId":"c18868"},{"segments":[{"spoiler":false,"text":"学園の風紀を乱す輩を許さない、生真面目ツンツン風紀委員。"},{"spoiler":false,"text":"夕也の銀髪を不良の証として、染め直すよう注意しまくる。"},{"spoiler":false,"text":"実は恋愛に憧れており、一度ときめいたらとことん一途に。"}],"source":"egs","sourceCharacterId":"9896","sourceWorkId":"15852","spoiler":false},{"segments":[{"spoiler":false,"text":"風紀委員に命をかけるツンツン娘。"},{"spoiler":false,"text":"きびきびとした生真面目な性格で、風紀委員長としてなめられないように偉そうな態度をとっている。"},{"spoiler":false,"text":"しかし、年相応に恋に憧れる乙女でもあり、一度ときめいたらとことん一途なタイプ。"},{"spoiler":false,"text":"ヤンチャな外見の夕也を目の敵にしている。"},{"spoiler":false,"text":"地毛と知っても、学園の風紀を乱す輩は許さない！ と、まだ注意する。"},{"spoiler":false,"text":"「その髪の色は校則違反です！　風祭君、すぐに染め直しなさい！」"}],"source":"bangumi","sourceCharacterId":"13678"}],"profileFacts":[{"label":"胸围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"9896","sourceWorkId":"15852","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"9896","sourceWorkId":"15852","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"9896","sourceWorkId":"15852","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":