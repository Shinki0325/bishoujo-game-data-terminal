."}],"source":"vndb","sourceCharacterId":"c18869"},{"segments":[{"spoiler":false,"text":"夕也と同じ銀色の髪を持つ少女。"},{"spoiler":false,"text":"夕也の嫁を自称する。"},{"spoiler":false,"text":"口数は少ないが、好きなものは好き、嫌いなものは嫌いと意思表示をハッキリ言う。"},{"spoiler":false,"text":"時折、不思議なボケをする。"}],"source":"egs","sourceCharacterId":"9897","sourceWorkId":"15852","spoiler":false},{"segments":[{"spoiler":false,"text":"夕方の学園でだけ出会う不思議少女。"},{"spoiler":false,"text":"常にマイペース、無口・無表情で、何を考えているのか分からない。"},{"spoiler":false,"text":"時折、不思議なボケをすることも。"},{"spoiler":false,"text":"意思表示はハッキリしており、好きなものは好き、嫌いなものは嫌い。"},{"spoiler":false,"text":"なぜか出会った時から好感度が高く、夕也の嫁を自称する。"},{"spoiler":false,"text":"「……わたくしは、あなた様の嫁です。」"}],"source":"bangumi","sourceCharacterId":"13675"}],"profileFacts":[{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"9897","sourceWorkId":"15852","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"9897","sourceWorkId":"15852","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"9897","sourceWorkId":"15852","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"582 cm","valueContext":null,"source":"egs","sourceCharacterId":"9897","sourceWorkId":"15852","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb95d54d3c69ec77b14066d31d1792e7201a9ace3107a7f82fd36184c38b7cfc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02108fd522e26d8163bca46243ba7006fb552a8945dfe99c1dc0c3cb473043d2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田愛衣","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21704: