","sourceCharacterId":"92454"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4d40bd94ba3a05365ad425d92b71a3d2dbf4e4eedf4450e8d9a2a8410bf54eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c717f43710ea037dfbb9ccba0e785e0ec1008962ae18e9c443bc188b474aaccb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"楠 鈴音","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47827","source":"vndb"}]},{"characterId":"char_c32870","characterName":"織部 愛那","sourceIds":{"bangumi":[],"egsCharacterIds":["5507"],"vndbCharacterId":"c32870"},"originalCharacterName":"織部 愛那","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"聖マルティウス学園の一年生。テニス部所属。"},{"spoiler":false,"text":"天真爛漫な性格で、男女ともに友人多数。"},{"spoiler":false,"text":"年齢の割には言動が幼いので、周囲からは少し子供扱いされている。"},{"spoiler":false,"text":"恋愛経験はなしだが、同じクラスの隼に気がある。"}],"source":"egs","sourceCharacterId":"5507","sourceWorkId":"17259","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3ea66e2a1b6ae690b8f0d7f61e560e7d2477e7adaadfa0aa8f67c2988ecc372.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35392e1eac2b8deeb305b9b5368b9d86b68edeffdc95026ae7a2c00c8fb0a8b3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"このは","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identit