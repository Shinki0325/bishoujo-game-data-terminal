iewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The older of the two Hatoba twins. Sakura is physically frail and spent years in the hospital when she was younger, which is why she’s a year below her sister as a freshman."},{"spoiler":false,"text":"Nonetheless, she is unfailingly polite and treats everyone to her gentle smiles—so she’s quickly building a fanbase among the student body."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c12856"},{"segments":[{"spoiler":false,"text":"舞台となる「聖マルティウス学園」に通う女子学生。一年生。"},{"spoiler":false,"text":"藤音の双子の姉。"},{"spoiler":false,"text":"幼い頃から身体が弱く、長く入院生活を送っていたため、妹よりも一学年下になっている。"},{"spoiler":false,"text":"おっとりとしていて清らかな雰囲気を持った女の子。"},{"spoiler":false,"text":"礼儀正しく、誰にでも優しく接する模範的な優等生。"}],"source":"egs","sourceCharacterId":"13741","sourceWorkId":"7399","spoiler":false},{"segments":[{"spoiler":false,"text":"鳩羽藤音の双子の姉。一年生。"},{"spoiler":false,"text":"病弱で小さい頃から長く入院生活を送っていたのが原因で、一学年ずれている。その為、藤音とは『姉』なのに『後輩』という変わった関係に。"},{"spoiler":false,"text":"礼儀正しく、誰にでも笑顔で優しく接するため、生徒にファンは多い。おっとりとしていて優等生なので、教師の受けもいい。"}],"source":"bangumi","sourceCharacterId":"92450"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d902e785bbec33c6d252fe2febca907bbd14080f6941321dc1fb06d518eb0ce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bf0fc07bb13c582e3ab8687748e776dc264dabdd0951a8bd7f0e83e80298502.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"片倉 ひな","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47830","source":"vndb"}]},{"characterId":"char_c12857","characterName":"鳩羽 藤音","sourceIds":{"bangumi":[{"characterId":"92451","match":"exact-normalized-name-in-linked-work","subjectId":"268528"}],"egsCharacterIds":["13827"],"vndbCharacterId":"c12857"},"originalCharacterName":"鳩羽 藤音","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The younger Hatoba twin and a second-year student, Fujine adores her sister Sakura so much that she sticks to her like glue whenever they go. Excelling at sports, she’s also in the lacrosse club."},{"spoiler":false,"text":"Easygoing and cheerful almost to the point of idiocy, but also naturally beautiful, she’s uninterested in romance despite the number of students with crushes on her. She would much rather focus on sports and, of course, her big sister."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c12857"},{"segments":[{"spoiler":false,"text":"舞台となる「聖マルティウス学園」に通う女子学生。二年生。"},{"spoiler":false,"text":"桜花の双子の妹。"},{"spoiler":false,"text":"能天気なほど明るく、さばさばしていて、活発な女の子。"},{"spoiler":false,"text":"スポーツが大好きで、ラクロス部に所属している。"},{"spoiler":false,"text":"美人双子姉妹として学園でも有名で、彼女自身も密かに人気があるものの、まるで色恋沙汰には関心がない。"}],"source":"egs","sourceCharacterId":"13827","sourceWorkId":"7399","spoiler":false},{"segments":[{"spoiler":false,"text":"鳩羽桜花の双子の妹。二年生。"},{"spoiler":false,"text":"姉である桜花が大好きで、いつもべったりとくっついている。"},{"spoiler":false,"text":"スポーツが得意で、ラクロス部に所属している。さばさばしていて、能天気なほど明るい。"},{"spoiler":false,"text":"美人なので密かに人気はあるが本人はそういった色恋沙汰に、まるで関心がない。恋愛よりも、部活よりも、お姉ちゃんが一番大切。"}],"source":"bangumi","sourceCharacterId":"92451"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b70812a226adbc327cfdf8c43b9f11494e80812894b7e917a354cb8cfb78ae8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d5b8153a5774c4eb2aec1c2b8b840dcd0277263e79e45aa4ed60549055d6c7d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"芹園 みや","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47829","source":"vndb"}]},{"characterId":"char_c12858","characterName":"周防 和歌子","sourceIds":{"bangumi":[{"characterId":"92452","match":"exact-normalized-name-in-linked-work","subjectId":"268528"},{"characterId":"92452","match":"exact-normalized-name-in-linked-work","subjectId":"61846"}],"egsCharacterIds":["5506"],"vndbCharacterId":"c12858"},"originalCharacterName":"周防 和歌子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third-year student and Miyu’s childhood friend. Having recently arrived as a transfer student, this rich princess’s pride is high; her will, unflinching."},{"spoiler":false,"text":"She’s a quick study but not so good at exercise. The younger girls hold her in the highest esteem."},{"spoiler":false,"text":"From Official Steam Page"}],"source":"vndb","sourceCharacterId":"c12858"},{"segments":[{"spoiler":false,"text":"舞台となる「聖マルティウス学園」に通う女子学生。三年生。"},{"spoiler":false,"text":"常盤未優の幼馴染。"},{"spoiler":false,"text":"同学園には数か月ばかり前に転校してきた新顔。"},{"spoiler":false,"text":"家がお金持ちのお嬢様。プライドが高く、勝気な性格。"},{"spoiler":false,"text":"後輩の女子たちから人気が高く、「お姉さま」と慕われている。"},{"spoiler":false,"text":"勉強は出来る方だがスポーツは苦手のようだ。"}],"source":"egs","sourceCharacterId":"5506","sourceWorkId":"7399","spoiler":false},{"segments":[{"spoiler":false,"text":"聖マルティウス学園の三年生。"},{"spoiler":false,"text":"プライドが高く気が強い、お金持ちのお嬢様。"},{"spoiler":false,"text":"勉強は得意。運動は苦手。女の子の後輩からは、お姉様と慕われている。"},{"spoiler":false,"text":"性奴隷陥落済みだが、心は折れていない。"},{"spoiler":false,"text":"今回岸家に買われ、その息子二人に調教されることとなる。"}],"source":"egs","sourceCharacterId":"5506","sourceWorkId":"17259","spoiler":false},{"segments":[{"spoiler":false,"text":"常盤未優の幼なじみ。三年生。"},{"spoiler":false,"text":"学園には数ヶ月前に転校してきたばかり。"},{"spoiler":false,"text":"プライドが高く気が強い、お金持ちのお嬢様。"},{"spoiler":false,"text":"勉強は得意だが、運動は苦手。女の子の後輩から、お姉様と慕われている。"}],"source":"bangumi","sourceCharacterId":"92452"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/722575aea436ca37d1c3622f30be6c48970c152f705f205aeb037797a3a8ac4d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79258df1c58ee80ffc0966e14827e91a6c0e4b51bef129b543ee1010d51e5d1d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"亜城めぐ","creatorId":"vndb:s454","sourcePersonId":"vndb:s454","canonicalEntityId":"vndb:s454","name":"亜城 めぐ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61846:92452:4833:1","source":"bangumi"},{"creditedName":"野宮 香央里","creatorId":"vndb:s830","sourcePersonId":"vndb:s830","canonicalEntityId":"vndb:s830","name":"宮沢ゆあな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47831","source":"vndb"}]},{"characterId":"char_c12860","characterName":"森 ヘンリッカ","sourceIds":{