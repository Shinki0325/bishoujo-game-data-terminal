:[{"spoiler":false,"text":"One of two men who breaks Marika’s fall when she drops from the sky, Kaoru invites this otherworldly princess to live with him."},{"spoiler":false,"text":"He then invites this otherworldly princess to live with him."},{"spoiler":false,"text":"He's level-headed and a bit of a worrywart, but he has his ditzy moments now and then."},{"spoiler":false,"text":"Unlike most modern men, Kaoru is incredibly strait-laced. After Marika kisses him, he becomes convinced that his only option is to marry her."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c64521"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44ad2e6a200697e3f896de7401c6a5da4b633f06c7a799cac702fc63711f7c34.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29b6aa674fd492fef75a29a3a433e03b6a1f2ee872c796c974011fc774e536e9.webp","width":126,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一夜愛","creatorId":"vndb:s8349","sourcePersonId":"vndb:s8349","canonicalEntityId":"vndb:s8349","name":"大下 孝太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:75672","source":"vndb"}]},{"characterId":"char_vndb_c64522","characterName":"鷹井流星","sourceIds":{"vndbCharacterId":"c64522"},"originalCharacterName":"鷹井流星","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1228"},"height":{"reviewState":"source-only","source":"vndb","value":"174"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The other man who breaks Marika’s fall, Ryuusei is a thoughtful, considerate guy who has no problem talking to women."},{"spoiler":false,"text":"\"He can tell dirty jokes witho