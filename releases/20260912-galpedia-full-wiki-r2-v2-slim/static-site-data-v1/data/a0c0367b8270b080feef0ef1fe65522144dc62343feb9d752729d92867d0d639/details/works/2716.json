firmed","relationId":"bangumi:character-voice:332260:93964:4689:1","source":"bangumi"}]},{"characterId":"char_c20711","characterName":"楠木 菜結花","sourceIds":{"bangumi":[{"characterId":"93967","match":"exact-normalized-name-in-linked-work","subjectId":"332260"}],"egsCharacterIds":["27412"],"vndbCharacterId":"c20711"},"originalCharacterName":"楠木 菜結花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"私立柳英学園の女教師。"},{"spoiler":false,"text":"学園の裏の顔を知っており、調教師となった主人公のサポート役になっている。"},{"spoiler":false,"text":"慣れない調教に四苦八苦する主人公を手助けしてくれる。"}],"source":"egs","sourceCharacterId":"27412","sourceWorkId":"2716","spoiler":false},{"segments":[{"spoiler":false,"text":"全ての事情は知っていて、サポート役を仰せつかっている。"},{"spoiler":false,"text":"頼りない主人公を一喝する立場。しかし、その役自身も本人が"},{"spoiler":false,"text":"納得しきっている訳ではない。煮え切らない主人公に対して"},{"spoiler":false,"text":"微妙な感情（主に苛立ち）を覚える。"}],"source":"bangumi","sourceCharacterId":"93967"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c55faffd7d4d2fce48df99fc4c1ba0b797b1c08f9e9154d919b58c7bc2f95fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0bcf7cfba3bbd3c9a27eb9fea8630177efe74a383ce186f427e485d21ec5fc8e.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤森 りお","creatorId":"vndb:s143","sourcePersonId":"vndb:s143","canonicalEntityId":"vndb:s143","name":"笠井 律子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36279","source":"vndb"}]},{"characterId":"char_c20712","characterName":"仁藤 遊美子","sourceIds":{"bangumi":[{"characterId":"93966","match":"exact-normalized-name-in-linked-work","subjectId":"332260"}],"egsCharacterIds":["27411"],"vndbCharacterId":"c20712"},"originalCharacterName":"仁藤 遊美子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"私立柳英学園に通う学生。"},{"spoiler":false,"text":"気弱で大人しい眼鏡ッ娘。"},{"spoiler":false,"text":"偶然、学園の裏の顔を知ってしまった彼女は、何故か、自ら調教に志願してきた。"},{"spoiler":false,"text":"自分の殻を破れず、微妙な反応しかできない彼女には、もっと強い刺激を与えるのが良いだろう。"}],"source":"egs","sourceCharacterId":"27411","sourceWorkId":"2716","spoiler":false},{"segments":[{"spoiler":false,"text":"遊美子はある日、学園の秘密をふと覗き見てしまった。"},{"spoiler":false,"text":"それは、正に学生が調教されている瞬間。"},{"spoiler":false,"text":"学園側は、口封じの為に巻き込むことを目論んだが"},{"spoiler":false,"text":"不思議と遊美子は調教を嫌がらなかった。"}],"source":"bangumi","sourceCharacterId":"93966"}],"profileFacts":[{"label":"性格","source":"bangumi","sourceCharacterId":"93966","value":"真面目な子、芯は強い"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f2c138b4dc99d16df85df28d955b603512e5217a1c583c48513541541e72fb5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/776bc97093f0d8660dadd8670b068694a3be36374b3bc9d16bdd287ce537f2cd.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜庭わかな","creatorId":"vndb:s807","sourcePersonId":"vndb:s807","canonicalEntityId":"vndb:s807","name":"桜庭 わかな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:332260:93966:11261:1","source":"bangumi"}]},{"characterId":"char_c20713","characterName":"長里 朋","sourceIds":{"bangumi":[{"characterId":"93965","match":"exact-normalized-name-in-linked-work","subjectId":"332260"}],"egsCharacterIds":["27410"],"vndbCharacterId":"c20713"},"originalCharacterName":"長里 朋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"