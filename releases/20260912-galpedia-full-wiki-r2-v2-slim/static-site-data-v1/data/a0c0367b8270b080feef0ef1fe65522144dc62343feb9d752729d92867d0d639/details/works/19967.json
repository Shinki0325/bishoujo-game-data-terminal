","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"８２"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"８５"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５７"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A bright, beautiful, and polite clerk who works at a convenience store near the main character's home."},{"spoiler":false,"text":"She is a college student and good at sports. She is especially fond of swimming, and her thighs, which have been toned by her hobby, are her charm point."},{"spoiler":false,"text":"She is Saori's younger sister, and the two sisters still go shopping together."},{"spoiler":false,"text":"Since the protagonist uses the convenience store where she works regularly, they have become acquainted to the extent that they make small talk, and the protagonist is thrilled when she touches him with her hand when she gives him change."}],"source":"vndb","sourceCharacterId":"c18780"},{"segments":[{"spoiler":false,"text":"主人公の家の近くにあるコンビニで働く、明るく美人で礼儀正しい店員。"},{"spoiler":false,"text":"女子大生で、スポーツが得意。特に水泳が好きで、その趣味で鍛えられた太ももがチャームポイント。沙織の妹で、今も姉妹仲良く買い物にいったりしている。"},{"spoiler":false,"text":"彼女が働いているコンビニは主人公が常用するため、世間話をする程度の顔見知りになっており、主人公は彼女がおつりを渡してくれるときに手を添えて触れてくれるのでドキドキしている。"}],"source":"egs","sourceCharacterId":"2792","sourceWorkId":"19967","spoiler":false},{"segments":[{"spoiler":false,"text":"はい、ではこちらがお釣りです。いつもご利用、ありがとうございます……また、来てくださいね！"},{"spoiler":false,"text":"主人公の家の近くにあるコンビニで働く、明るく美人で礼儀正しい店員。"},{"spoiler":false,"text":"女子大生でスポーツが得意。特に水泳が好きで、その趣味で鍛えられた太ももがチャームポイント。"},{"spoiler":false,"text":"沙織の妹で、今も姉妹仲良く買い物にいったりしている。"},{"spoiler":false,"text":"主人公が常用するコンビニで働いており、世間話をする程度の顔見知りである。"},{"spoiler":false,"text":"彼女はおつりを渡してくれるときに手を添えて触れてくれるのでドキドキしてしまう。"}],"source":"bangumi","sourceCharacterId":"202581"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"2792","sourceWorkId":"19967","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"2792","sourceWorkId":"19967","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"2792","sourceWorkId":"19967","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"2792","sourceWorkId":"19967","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"2792","sourceWorkId":"19967","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/463176681574e54d2bfaeeee0c46579eca54c79396daba9aad873f86e7a67156.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/0243279eeea141501f9ce18588f4551d3516744ace586c204f3107ff729e2e9c.webp","width":96,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219596:202581:6349:1","source":"bangumi"}]},{"characterId":"char_c68425","characterName":"杉田 悠真","sourceIds":{"bangumi":[{"characterId":"202583","match":"exact-normalized-name-in-linked-work","subjectId":"219596"}],"egsCharacterIds":["2793"],"vndbCharacterId":"c68425"},"originalCharacterName":"杉田 悠真","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"pending-conflict","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"74"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園２年生。見た目は小太りで暗く、クラスの中では目立たない存在。"},{"spoiler":false,"text":"だが手先が器用で、物作りが得意だったおかげで美術・技術関係の成績がよく、学園祭などのイベントで頼られることになり、目立たずともクラスに溶け込めている。特に同じクラスメイトの【神武寺美結】は学園祭の委員を一緒にやった時から、距離が縮まったようで、彼女のことを密かに想っている。"},{"spoiler":false,"text":"また週末の趣味として「アイドル」のおっかけをやっており、そこでは学校の中とはかわって積極的でイキイキとした姿をみせる。"},{"spoiler":false,"text":"今や売れっこになっている【新町モモ】を昔から応援していて、アイドルのブーム以前から非公式ファンクラブのページを運営し応援。"},{"spoiler":false,"text":"ライブイベントでは学園祭同様に自作グッズでもりあげ、アイドルへのアクセサリーなどもプレゼントして、名前を覚えてもらっており、同じファン仲間からも一目置かれている。"},{"spoiler":false,"text":"主人公自身、それを自慢するようなことはないが密かなプライドになっている。"}],"source":"egs","sourceCharacterId":"2793","sourceWorkId":"19967","spoiler":false},{"segments":[{"spoiler":false,"text":"う、うそだ……僕が……こんなにみんなから嫌われてるなんて……！"},{"spoiler":false,"text":"学園２年生。見た目は小太りで暗く、クラスの中では目立たない存在。"},{"spoiler":false,"text":"だが手先が器用で、学園祭などのイベントで頼られることが多い。"},{"spoiler":false,"text":"趣味は「アイドル」のおっかけで、【新町モモ】を売れない頃から非公式ファンクラブのページを運営し応援。"},{"spoiler":false,"text":"モモに名前を覚えてもらっており、同じファン仲間からも一目置かれている。"},{"spoiler":false,"text":"主人公自身、それを自慢するようなことはないが密かなプライドになっている。"}],"source":"bangumi","sourceCharacterId":"202583"}],"profileFacts":[{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"2793","sourceWorkId":"19967","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"74 kg","valueContext":null,"source":"egs","sourceCharacterId":"2793","sourceWorkId":"19967","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c18781","characterName":"ミストレス","sourceIds":{"vndbCharacterId":"c18781"},"originalCharacterName":"ミストレス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"F"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious woman with a bewitching atmosphere."},{"spoiler":false,"text":"She claims to be the one who abducted the protagonist, Miyu, and the others to the basement, and calls herself \"Mistress\"."},{"spoiler":false,"text":"Her manner and tone of voice are polite and gentle, but she will not tolerate refusal of instructions or disobedience to orders."},{"spoiler":false,"text":"If you disobey her, she will punish you severely and without mercy."},{"spoiler":false,"text":"She puts the hero and heroines through unreasonable \"ordeals,\" and seems to enjoy watching them on her monitor."},{"spoiler":false,"text":"Why does she do it and why were the hero and heroines brought to the basement? The purpose is unknown."}],"source":"vndb","sourceCharacterId":"c18781"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6df410a42400b76b5213341f1a8fd91df02e8c97a76137e2ac9ab2f6de89e0de.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19a4c0a9328ee2cf8197ae0da34f88874457bd339023eef9f5557a5efe97cd39.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊東 サラ","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:56729","source":"vndb"}]},{"characterId":"char_vndb_c18782","characterName":"シュリ","sourceIds":{"vndbCharacterId":"c18782"},"originalCharacterName":"シュリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"height":{"reviewState":"source-only","source":"vndb","value":"176"},"hip":{"reviewState":"source-only","source":"vndb","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has a graceful manner and behaves politely to everyone."},{"spoiler":false,"text":"However, she will not hesitate to put the hero or heroines through any ordeal or humiliation if her mistress commands it."},{"spoiler":false,"text":"The mistress seems to place her complete trust in her, and she often moves with just one word, \"Shuri."},{"spoiler":false,"text":"She has also been trained by her master in the art of service, and her \"punishment\" of the hero, who is a man, is carried out without mercy, making full use of her advanced skills."}],"source":"vndb","sourceCharacterId":"c18782"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/fff153c1db3a20461d7dd7c3a468a0bf12a6fc24a10dd81c62a1e62c702dac59.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/778f56c6a22749fc8650947fb7b11c0eb44e4378ae2ad9e4ea18670e9c052607.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ももぞの 薫","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:56730","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p490","sourceCompanyId":"egs:brand:328","canonicalEntityId":"vndb:p490","name":"ルネ","roleCodes":["brand"],"identityStatus":"au