,"characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「にょーっほっほっほ！この賀当れんげが、お前たちを”穴あきチーズ”にしてやりますわ！」"},{"spoiler":false,"text":"暗黒ニンジャ四人衆の一人、ガトリングニンジャ。いずみの持つ「水の奥義書」を奪った。エキセントリックかつトリガーハッピーな性格で、何かにつけて銃を乱射したがる使用武器は二丁ガトリングガン。"},{"spoiler":false,"text":"背中のドラム型弾倉に大量の弾薬を保有している。"},{"spoiler":false,"text":"ガトリングガンによる射撃の他にも、銃身を二刀流のごとく振り回して撲殺しようとしてくる。"},{"spoiler":false,"text":"追い詰められると「ガトリング忍法・ミンチメーカー」を使用。"},{"spoiler":false,"text":"凄まじい弾幕でこちらを攻撃してくる。"}],"source":"egs","sourceCharacterId":"2562","sourceWorkId":"19689","spoiler":false},{"segments":[{"spoiler":false,"text":"暗黒ニンジャ四人衆の一人。"},{"spoiler":false,"text":"いずみの持つ 『水の奥義書』 を奪った。"},{"spoiler":false,"text":"エキセントリックかつトリガーハッピーな性格で、なにかにつけて銃を乱射したがる。"},{"spoiler":false,"text":"【使用武器】二丁ガトリングガン"},{"spoiler":false,"text":"背中のドラム型弾倉に大量の弾薬を保有している。"},{"spoiler":false,"text":"ガトリングガンによる射撃の他にも、銃身を二刀流の如く振り回して撲殺しようとしてくる。"},{"spoiler":false,"text":"追い詰められると “ガトリング忍法・ミンチメーカー” を使用し、凄まじい弾幕でこちらを攻撃してくる。"},{"spoiler":false,"text":"「にょーっほっほっほ！　この賀当れんげが、お前たちを “穴あきチーズ” にしてやりますわ！」"}],"source":"bangumi","sourceCharacterId":"49885"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27940f249bc6ab8259a8a7b3d451f70eda69bdcdfb6c4e73a758f7c32789a26e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26d9770fb5b24079629d863d59acf013b2907e69d1af5df31f57fb46e3f1f70f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松山紗香","creatorId":"vndb:s904","sourcePersonId":"vndb:s904","canonicalEntityId":"vndb:s904","name":"松山 紗香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:205194:49885:10662:1","source":"bangumi"}]},{"characterId":"char_c126326","ch