oice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:205194:49884:17075:1","source":"bangumi"}]},{"characterId":"char_c126327","characterName":"ハヤテ","sourceIds":{"bangumi":[],"egsCharacterIds":["2560"],"vndbCharacterId":"c126327"},"originalCharacterName":"ハヤテ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"葉隠忍術学園教諭。生徒たちに葉隠正統忍術を教える。"},{"spoiler":false,"text":"昔は生徒たちと同じ忍者だったが、膝に手裏剣を受けてしまって引退。"},{"spoiler":false,"text":"生徒たちに忍術を教える立場となった。"},{"spoiler":false,"text":"「変化の術」を使い、忍犬「ハヤテ丸」に変身することができる。"},{"spoiler":false,"text":"立場上、戦いに赴く生徒たちを直接助けるわけにはいかないため彼はハヤテ丸に変身して生徒たちをサポートする。"},{"spoiler":false,"text":"本人は正体を隠しているつもりだが、生徒たちにはバレバレである。"},{"spoiler":false,"text":"ハヤテ丸・・・一体何ハヤテ先生なんだ・・・？"},{"spoiler":false,"text":"ハヤテ丸は背中に万能カラクリ箱を背負っており、生徒たちに対してさまざまなサポートを行う。"}],"source":"egs","sourceCharacterId":"2560","sourceWorkId":"19689","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e92026df29bfb2a360a5545d175eb639b713ce58c4804fc6da1ef48c078fd5f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab697496a86d551782c8fff80c8cb13a4a8535f27875c1e05394fdcf3a360bd1.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c91039","characterName":"赤月 ひかり","sourceIds":{"bangumi":[{"characterId":"49880","match":"exact-normalized-name-in-linked-work","subjectId":"205194"}],"egsCharacterIds":["2556"],"vndbCharacterId":"c91039"},"originalCharacterName":"赤月 ひかり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segment