{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"13400","model":{"presentationWorkId":"vndb:v3005","staff":{"artwork":[{"creditedName":"さっぽろももこ(RIKA)","creatorId":"vndb:s972","sourcePersonId":"egs:creator:502","canonicalEntityId":"vndb:s972","name":"さっぽろももこ(RIKA)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:82971","source":"egs"}],"scenario":[{"creditedName":"森ジムソン","creatorId":"vndb:s972","sourcePersonId":"egs:creator:18660","canonicalEntityId":"vndb:s972","name":"森ジムソン","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:242445","source":"egs"}],"music":[{"creditedName":"さっぽろももこ(RIKA)","creatorId":"vndb:s972","sourcePersonId":"egs:creator:502","canonicalEntityId":"vndb:s972","name":"さっぽろももこ(RIKA)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:116095","source":"egs"},{"creditedName":"山本忍","creatorId":"vndb:s7306","sourcePersonId":"egs:creator:1071","canonicalEntityId":"vndb:s7306","name":"山本忍","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:88315","source":"egs"}],"other":[{"creditedName":"ブッチー・リラックモア","creatorId":"vndb:s17610","sourcePersonId":"vndb:s17610","canonicalEntityId":"vndb:s17610","name":"ブッチー・リラックモア","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:39713","source":"vndb"},{"creditedName":"ブッチー・リラックモア","creatorId":"vndb:s17610","sourcePersonId":"vndb:s17610","canonicalEntityId":"vndb:s17610","name":"ブッチー・リラックモア","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:39714","source":"vndb"}]},"cast":[{"characterId":"char_c7826","characterName":"諌山 ルキ","sourceIds":{"bangumi":[{"characterId":"46106","match":"exact-normalized-name-in-linked-work","subjectId":"81252"}],"egsCharacterIds":["14095"],"vndbCharacterId":"c7826"},"originalCharacterName":"諌山 ルキ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"小中高とずっと一緒だった、近所に住む一つ年上の主人公の幼馴染。"},{"spoiler":false,"text":"主人公の母親とも親しく、一人暮らしになった主人公の自家に、ちょくちょく世話を焼きにやってくる。"},{"spoiler":false,"text":"性格はクールで、ややシニカル。口は悪いが情に脆い。戦略家だと思っているが、そのほとんどが失敗し、空回りする。主人公の前ではお姉さんぶって、上から目線でものを言ったりもする。"},{"spoiler":false,"text":"主人公のことを昔から大好きだったが、素直になれない性格から何も行動できないでいた。しかし、雨弓の登場によってのんびりしてはいられなくなり、主人公の自家に押し掛けてくる。"}],"source":"egs","sourceCharacterId":"14095","sourceWorkId":"13400","spoiler":false},{"segments":[{"spoiler":false,"text":"近所に住むひとつ年上の幼馴染。学校も小・中・高と一緒で、健二の母親とも仲が良い。"},{"spoiler":false,"text":"性格はクールでちょっぴりシニカル。口は悪いが情にもろい。"},{"spoiler":false,"text":"自分を戦略家だと思っているが、空回りして玉砕するタイプ。"},{"spoiler":false,"text":"健二に対しては、背伸びしてお姉さんぶろうとする。"},{"spoiler":false,"text":"小さな頃からずっと健二のことが好きだったが、負けず嫌いな性格で素直になれず、なにも行動を起こせないでいた。"},{"spoiler":false,"text":"しかし、雨弓の登場でのんびりしてはいられなくなり、あの手この手でアプローチを試みるように……。"}],"source":"bangumi","sourceCharacterId":"46106"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/5891f0d0a0746f328de7f71eb6ef2f1c7752b1f5f8616d7e69571911b81e088a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7f9f684ae70f2f06f309219e75b02ca677fb0c5a668d3f10f7931059fa12f73.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永井ちひろ","creatorId":"vndb:s530","sourcePersonId":"vndb:s530","canonicalEntityId":"vndb:s530","name":"逢川奈々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:81252:46106:18652:1","source":"bangumi"}]},{"characterId":"char_c7827","characterName":"夏目 雨弓","sourceIds":{"bangumi":[{"characterId":"46104","match":"exact-normalized-name-in-linked-work","subjectId":"81252"}],"egsCharacterIds":["14094"],"vndbCharacterId":"c7827"},"originalCharacterName":"夏目 雨弓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が雨の日に出会った謎の女性。"},{"spoiler":false,"text":"実は主人公が、小さい頃に一緒に暮らしていたお姉さん。"},{"spoiler":false,"text":"当時、高校生だった彼女は、極度のブラコンで主人公のことが大好きだった。家庭の事情で主人公とは離れ離れになって暮らすようになった彼女だが、主人公への想いが消えることはなかった。"},{"spoiler":false,"text":"そうしたなか見合い話が持ち上がり、彼女は主人公を忘れるために一度は承諾するが、結婚するその日が近付くに連れて、主人公への想いが強くなり、正体を隠して主人公の元へと……。"}],"source":"egs","sourceCharacterId":"14094","sourceWorkId":"13400","spoiler":false},{"segments":[{"spoiler":false,"text":"雨の日にめぐり合った謎の女性。しかし実は、小さい頃に健二と暮らしていたユキ姉その人だった。"},{"spoiler":false,"text":"当時高校生だった雨弓は、極度のブラコンで健二のことが好きだった。"},{"spoiler":false,"text":"家庭の事情で遠くで暮らすようになってからも、その気持ちは消えず、どうしても他の人を好きになれない。"},{"spoiler":false,"text":"そんなある日、世話になった養父母から見合い話を持ちかけられる。"},{"spoiler":false,"text":"弟のことを忘れるためにも一旦はOkするが、その日が近づいてくるにつれ、健二を思う気持ちがますます強くなる。"},{"spoiler":false,"text":"結婚が決まる前に、どうしてももう一度健二に会いたくなり、正体を隠して健二のもとにやって来た。"}],"source":"bangumi","sourceCharacterId":"46104"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b10d4baad15c2721d331325131164280318ab0f123c56b95cbe0bd8dceb518da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee34c9703fa44d9d085b8e6a25489f332e9ee40bc920d0e11212fd02d86c5b9a.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花園朱実","creatorId":"vndb:s4769","sourcePersonId":"vndb:s4769","canonicalEntityId":"vndb:s4769","name":"花園 朱実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:81252:46104:20979:1","sou