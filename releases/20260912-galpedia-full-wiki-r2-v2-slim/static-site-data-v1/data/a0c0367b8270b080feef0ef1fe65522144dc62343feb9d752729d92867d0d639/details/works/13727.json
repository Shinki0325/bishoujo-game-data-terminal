{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"13727","model":{"presentationWorkId":"vndb:v4143","staff":{"artwork":[{"creditedName":"雛祭桃子","creatorId":"vndb:s1791","sourcePersonId":"egs:creator:10005","canonicalEntityId":"vndb:s1791","name":"雛祭桃子","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:85574","source":"egs"}],"scenario":[{"creditedName":"尾之上咲太","creatorId":"vndb:s1807","sourcePersonId":"egs:creator:2255","canonicalEntityId":"vndb:s1807","name":"尾之上咲太","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:85575","source":"egs"},{"creditedName":"鯉川こい","creatorId":"vndb:s1793","sourcePersonId":"egs:creator:9300","canonicalEntityId":"vndb:s1793","name":"鯉川こい","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:85576","source":"egs"}],"music":[{"creditedName":"土谷知幸","creatorId":"vndb:s1957","sourcePersonId":"egs:creator:7083","canonicalEntityId":"vndb:s1957","name":"土谷知幸","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:128737","source":"egs"},{"creditedName":"東 タカゴー","creatorId":"vndb:s4318","sourcePersonId":"vndb:s4318","canonicalEntityId":"vndb:s4318","name":"東 隆行","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:47884","source":"vndb"}],"other":[{"creditedName":"橋本みゆき","creatorId":"vndb:s390","sourcePersonId":"egs:creator:4503","canonicalEntityId":"vndb:s390","name":"橋本みゆき","detail":"主題歌「Trick and Treat～いたずらなキッス～」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:119668","source":"egs"},{"creditedName":"橋本 みゆき","creatorId":"vndb:s390","sourcePersonId":"vndb:s390","canonicalEntityId":"vndb:s390","name":"橋本 みゆき","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:47878","source":"vndb"},{"creditedName":"雛祭 桃子","creatorId":"vndb:s1791","sourcePersonId":"vndb:s1791","canonicalEntityId":"vndb:s1791","name":"雛祭 桃子","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:47879","source":"vndb"}]},"cast":[{"characterId":"char_c45628","characterName":"藍草 茉莉","sourceIds":{"bangumi":[{"characterId":"50335","match":"exact-normalized-name-in-linked-work","subjectId":"14522"}],"egsCharacterIds":["12561"],"vndbCharacterId":"c45628"},"originalCharacterName":"藍草 茉莉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"プリムの天敵と言うべきポジションの魔法少女。"},{"spoiler":false,"text":"主人公とは子供の頃、ちょっとだけ会っているが覚えていない。"},{"spoiler":false,"text":"同じ街で育ったので彼とは子供の頃から同じ学園、たまに同じクラス。"},{"spoiler":false,"text":"明るく誰にでも優しくて（少々天然系）可愛らしく、いつも物事の中心にいるタイプ。"},{"spoiler":false,"text":"学園のアイドル的存在であり、主人公に漠然と好意を寄せていた一人。"},{"spoiler":false,"text":"あふれる魔女っ娘パワーの反動のせいか、何もないところで転んだり、上から植木鉢が落ちてきたり、何故か蜂の大群が襲いかかってきたりする。"},{"spoiler":false,"text":"それも周囲の保護欲を掻き立て、人気上昇する要因になっている。"},{"spoiler":false,"text":"苦手なものは虫らしい。"},{"spoiler":false,"text":"変身後の姿は無敵の魔女少女ミスティマリー。"},{"spoiler":false,"text":"ミスティステッキで変身する。"},{"spoiler":false,"text":"実は茉莉自身、魔法少女に変身することにちょっぴり照れがあるようだ。"}],"source":"egs","sourceCharacterId":"12561","sourceWorkId":"13727","spoiler":false},{"segments":[{"spoiler":false,"text":"メインヒロイン。"},{"spoiler":false,"text":"プリムの天敵と言うべきポジションの、いい年した魔法少女。バレー部（ブルマ）。"},{"spoiler":false,"text":"変身後の姿は、ミスティマリー。ミスティステッキで変身する無敵の魔女っ子。"},{"spoiler":false,"text":"魔法少女に変身することには、少し照れがある。"},{"spoiler":false,"text":"主人公とは子供の頃、ちょっとだけ会っているが覚えていない。 同じ街で育ったので彼とは小・中・高校で同じ学園、たまに同じクラスだった。"},{"spoiler":false,"text":"宿敵である（？）魔女を懲らしめるために主人公と行動を共にする。"},{"spoiler":false,"text":"一方、普段の彼女は明るく誰にでも優しくて （少し天然の傾向はあるが） 可愛らしい、いつも物事の中心にいるタイプ。"},{"spoiler":false,"text":"好意を寄せている男（たまに女も）は多い。主人公も漠然とした好意を抱いていた。"},{"spoiler":false,"text":"なにも無いところで転んだり、上から植木鉢が落ちてきたり、なぜか蜂の大群が襲いかかってきたりするのも、周りはかえって保護欲を掻きたてられている。"}],"source":"bangumi","sourceCharacterId":"50335"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/392202d063832d7635fb627a08cb92171607ddd84469c39f1dcf2d2775dbd899.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dccf08c56a71f964cfe15cd88dcb1ce7282ae65d3891c3b60ed5f1196f7ee75f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14522:50335:5052:1","source":"bangumi"}]},{"characterId":"char_c45629","characterName":"豊姫 みのり","sourceIds":{"bangumi":[{"characterId":"50336","match":"exact-normalized-name-in-linked-work","subjectId":"14522"}],"egsCharacterIds":["12563"],"vndbCharacterId":"c45629"},"originalCharacterName":"豊姫 みのり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"理事長の娘（主人公の従姉にあたる）。"},{"spoiler":false,"text":"第二調理部部長にして学生会の副会長も兼任していて、対外的には立派でかっこいい先輩を装っている。"},{"spoiler":false,"text":"特権を堂々と行使して勝手に学園内にカフェを開いており、スペースをほとんど一人で独占している。"},{"spoiler":false,"text":"素のみのりは、コスプレや可愛い女の子、可愛い男の子とかが好きな、ちょっと痛い系のお姉さんキャラ。"},{"spoiler":false,"text":"オタクというわけではなく、単に色々倒錯しているだけという話も……。"},{"spoiler":false,"text":"主人公にとっては多少の苦手意識はありながらも、嫌いになれない “お姉ちゃん”。"},{"spoiler":false,"text":"昔から主人公をべたべたに甘やかしていて世話を焼きたがり、あまりに露骨なので、主人公はかえって異性として認識できていない。"}],"source":"egs","sourceCharacterId":"12563","sourceWorkId":"13727","spoiler":false},{"segments":[{"spoiler":false,"text":"理事長の娘（主人公の従姉妹）。"},{"spoiler":false,"text":"ほとんど一人で独占している、第二調理部部長。特権を堂々と行使して、勝手に学園内にカフェを開いている。"},{"spoiler":false,"text":"学生会の副会長も兼任していて、対外的には立派でかっこいい先輩といった風。"},{"spoiler":false,"text":"本人も理事長の娘としてそういう振る舞いを意識している。 が、素の彼女はコスプレとか可愛い女の子とか可愛い男の子とかが好きな、ちょっと痛い系のお姉さん。"},{"spoiler":false,"text":"オタクというわけではなく、単に色々倒錯しているだけ（でもオタクには寛容）。"},{"spoiler":false,"text":"主人公にとっては多少の苦手意識はありながらも、嫌いになれない “お姉ちゃん”。"},{"spoiler":false,"text":"彼にだけは異常に優しく、世話を焼きたがり、なんだったら毎朝パンツを履くところから手伝ってあげたいと思っているらしい。"},{"spoiler":false,"text":"そういうものが滲み出ているから、主人公は強烈に苦手視しているのだが気にしない。曰く 「照れ屋なところも可愛い」 とのこと。"}],"source":"bangumi","sourceCharacterId":"50336"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e21428ddd9c05e247239c946f41ec0cd456c31dd0f17d162a2c27b48126fd691.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a4c69e6a0e620cabe24ed1c0dc2c5375e1a9bf04dd639ff5576725fad6aead0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14522:50336:4646:1","source":"bangumi"}]},{"characterId":"char_c45630","characterName":"葡波 夜子","sourceIds":{"bangumi":[{"characterId":"50337","match":"exact-normalized-name-in-linked-work","subjectId":"14522"}],"egsCharacterIds":["12562"],"vndbCharacterId":"c45630"},"originalCharacterName":"葡波 夜子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"基本的には他者を寄せつけない、刺々しいオーラをまとっているような女の子。"},{"spoiler":false,"text":"プリムを見た時に「どこかで見た気がしたと思ったのよ」と、みのりが手を打つほど、彼女とプリムはそっくりである。"},{"spoiler":false,"text":"だが実はプリムとはなんの関係もない。"},{"spoiler":false,"text":"主人公達に絡まれてとんだとばっちりにあい、誤解を晴らすため行動を共にするようになる。"},{"spoiler":false,"text":"口数は少ないが、言いたいことはずばずば言う。"},{"spoiler":false,"text":"その性格もあってか友達には恵まれなかった。"},{"spoiler":false,"text":"本当は乙女チックな性格で、特に猫好き。"},{"spoiler":false,"text":"野良猫に餌をあげたり、猫の写真集をこっそり買っていたりする。"},{"spoiler":false,"text":"子供の頃から体が弱く、入院生活が長かったため、友達がいない。"},{"spoiler":false,"text":"特技はプリムを見つけること。"},{"spoiler":false,"text":"この辺にいるんじゃない？　といえば、大抵見つけることができる。"}],"source":"egs","sourceCharacterId":"12562","sourceWorkId":"13727","spoiler":false},{"segments":[{"spoiler":false,"text":"基本的には他者を寄せつけない、刺々しいオーラをまとっているような女の子。"},{"spoiler":false,"text":"学年的には主人公の後輩。ぱっと見てヒクくらい、プリムにそっくり。"},{"spoiler":false,"text":"魔女を見た時に 「どこかで見た気がしたと思ったのよ」 と、みのりが手を打つほど、彼女と魔女はそっくりである。"},{"spoiler":false,"text":"主人公たちに絡まれて、とんだとばっちり。誤解を晴らすため、彼らと行動を共にするようになる。"},{"spoiler":false,"text":"口数は少ないが、ズバズバ言う。その性格もあってか友達には恵まれなかった。"},{"spoiler":false,"text":"主人公はそういったものを気にせずまとわりついてくるので、鬱陶しがりつつも満更でもなさそうな感じ。"},{"spoiler":false,"text":"本当はかなり乙女チックで、特に猫好き。野良猫には餌をあげるし、猫の写真集が売っていれば買う。"},{"spoiler":false,"text":"特技はプリムを見つけること。「この辺にいるんじゃない？」 と言えば、大抵いる。"},{"spoiler":false,"text":"的中率が高すぎて、いつまで経っても周り周囲の誤解がとけない。"}],"source":"bangumi","sourceCharacterId":"50337"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46bb26051501df09090e113fb60d3f802579d02233e42905fccac44d9931bc75.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de71cf9e5f68c37cc16e0759d11f42add2ed39f5aac51c9adc28e1d69d440fb3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井清己","creatorId":"vndb:s771","sourcePersonId":"vndb:s771","canonicalEntityId":"vndb:s771","name":"浅井 清己","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14522:50337:4336:1","source":"bangumi"}]},{"characterId":"char_c45631","characterName":"景近 帆希","sourceIds":{"bangumi":[{"characterId":"50338","match":"exact-normalized-name-in-linked-work","subjectId":"14522"}],"egsCharacterIds":["12564"],"vndbCharacterId":"c45631"},"originalCharacterName":"景近 帆希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学生会長。"},{"spoiler":false,"text":"みのりとは、同じ学生会所属なので一緒にいることが多い。"},{"spoiler":false,"text":"学生会長なのに、みのりの存在感が強すぎるので影が薄く、一部の学生からは、みのりが会長だと思われているらしい。"},{"spoiler":false,"text":"魔女プリム出現騒動では学園中が大騒ぎになった為、中心人物である主人公やみのりになにかとつっかかってくる。"},{"spoiler":false,"text":"みのりが第二調理部と兼部しているのと同様、彼女も華道部の部長（家は華道の家元。）。"},{"spoiler":false,"text":"みのりと一緒にいない時は、楚々とした面倒見のいい先輩。"},{"spoiler":false,"text":"なんだかんだで、根底の部分ではみのりに友情を感じており、本人もわかっている。"},{"spoiler":false,"text":"しかし日常的にはみのりにはよくからかわれたり、オモチャにされている（いじり甲斐のある性格のため）。"},{"spoiler":false,"text":"現在、プリムが猫に変身して、帆希の家に潜伏している。"}],"source":"egs","sourceCharacterId":"12564","sourceWorkId":"13727","spoiler":false},{"segments":[{"spoiler":false,"text":"学生会長。"},{"spoiler":false,"text":"みのりとは、同じ学生会所属なので一緒にいることは多い。。"},{"spoiler":false,"text":"学生会長なのに、みのりの存在感が強すぎるので影が薄い。一部の学生からは、みのり が会長だと思われているらしい。"},{"spoiler":false,"text":"魔女騒動では学園中が大騒ぎになったため、中心人物である主人公やみのりになにかとつっかかってくる。"},{"spoiler":false,"text":"家は華道の家元。みのりが調理部と兼部しているのと同様、彼女も華道部の部長。"},{"spoiler":false,"text":"みのりと一緒にいない時は、楚々とした面倒見のいい先輩。"},{"spoiler":false,"text":"なんだかんだで、根底の部分ではみのりに友情を感じており、本人もわかっている。でも、よくオモチャにされている。"}],"source":"bangumi","sourceCharacterId":"50338"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d73753d7d04eedd5b7adbe2faf5ed02cf8aceeb7ede2354b1b6e740acbc5ae5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0d9bc5634b6b461ca0eeb16ee2df0e9f54d16e89b1703c501b85bde783bb1d8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ミルノ純","creatorId":"vndb:s564","sourcePersonId":"vndb:s564","canonicalEntityId":"vndb:s564","name":"ミルノ 純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14522:50338:6167:1","source":"bangumi"}]},{"characterId":"char_c45632","characterName":"プリム","sourceIds":{"bangumi":[{"characterId":"50339","match":"exact-normalized-name-in-linked-work","subjectId":"14522"}],"egsCharacterIds":["12565"],"vndbCharacterId":"c45632"},"originalCharacterName":"プリム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"夜子とうりふたつの魔女っ娘。"},{"spoiler":false,"text":"イタズラ魔法を使い学園をパニックにおとしいれる……。"},{"spoiler":false,"text":"昔、痛めつけられた時に記憶の大半を失っており、漠然と「何かやることがある」ような気がしている程度。"},{"spoiler":false,"text":"それを思い出すのが目的なのだが、本人はイタズラが楽しいので好き勝手にやっている。"},{"spoiler":false,"text":"しかし、怖いものとか痛いものとか、苦いものは嫌い。"},{"spoiler":false,"text":"基本的にはお子ちゃまな性格。"},{"spoiler":false,"text":"普段は力の消耗をおさえるために、小さくなったり、猫に変身していたりする。"},{"spoiler":false,"text":"帆希の家に居候している。"}],"source":"egs","sourceCharacterId":"12565","sourceWorkId":"13727","spoiler":false},{"segments":[{"spoiler":false,"text":"魔女。夜子とうりふたつ。"},{"spoiler":false,"text":"イタズラ魔法を使い、学園をパニックに陥れてしまう。"},{"spoiler":false,"text":"昔、魔法少女に痛めつけられた時に記憶の大半を失っており、漠然と “何かやることがある” ような気がしている。"},{"spoiler":false,"text":"それを思い出すのが目的なのだが、本人はイタズラが楽しいので好き勝手にやっている。"},{"spoiler":false,"text":"口調は 「～なのだわ！」 など。偉そう。"},{"spoiler":false,"text":"でも、怖いものとか痛いものとか苦いものは嫌い。基本的には子供。"},{"spoiler":false,"text":"普段は力の消耗をおさえるために、小さくなっている。"}],"source":"bangumi","sourceCharacterId":"50339"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fcd0f5ff9af457e10480b434d0752529940514b37a96727cf350ff665713043.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c2036bb79bfe37de35f82465257b545e9b27ad4174a8f62eda8a71c68ca687e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14522:50339:5890:1","source":"bangumi"}]},{"characterId":"char_c45633","characterName":"藍草 悠里","sourceIds":{"bangumi":[],"egsCharacterIds":["12566"],"vndbCharacterId":"c45633"},"originalCharacterName":"藍草 悠里","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"茉莉のお母さんで、先代の魔法少女。"},{"spoiler":false,"text":"外見は年齢よりは若く見え、本人曰く茉莉のお姉さんに良く間違われるとか。"},{"spoiler":false,"text":"今も現役で活躍しており、いまだ自分のことを『魔法少女』と言い張っている辺り、この人の恐ろしさがうかがえる。"},{"spoiler":false,"text":"娘の茉莉とはほとんど友達のようなノリで仲がいい。"},{"spoiler":false,"text":"「これで（魔法少女に）変身さえしなければ……」とは、茉莉。"},{"spoiler":false,"text":"自分の結婚が早かった（学生結婚）ので、「普通はそういうもの」と考え、茉莉の奥手ぶりが気になって仕方ない。"},{"spoiler":false,"text":"なので、やっと彼（もちろん主人公のこと）ができたと（決め付けて）喜んでいる。"}],"source":"egs","sourceCharacterId":"12566","sourceWorkId":"13727","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d8a6732e90d06b6d16d9b4431322de49281c4179fd58003a4bb2cd259d699b5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a062c93afae1ac1b539c3955d26c6c5e15beb6c6ff2ed55d3da6000de7ff9e4f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柚木 かなめ","creatorId":"vndb:s13","sourcePersonId":"vndb:s13","canonicalEntityId":"vndb:s13","name":"河原木 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26496","source":"vndb"}]},{"characterId":"char_vndb_c91755","characterName":"黒江 仁","sourceIds":{"vndbCharacterId":"c91755"},"originalCharacterName":"黒江 仁","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1354","sourceCompanyId":"egs:brand:2929","canonicalEntityId":"vndb:p1354","name":"ぱんぷきんソフト","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:13727:2929","source":"egs"},{"companyId":"vndb:p1354","sourceCompanyId":"vndb:p1354","canonicalEntityId":"vndb:p1354","name":"ぱんぷきんソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:51091:v4143","source":"vndb"},{"companyId":"vndb:p1354","sourceCompanyId":"vndb:p1354","canonicalEntityId":"vndb:p1354","name":"ぱんぷきんソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:9422:v4143","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
