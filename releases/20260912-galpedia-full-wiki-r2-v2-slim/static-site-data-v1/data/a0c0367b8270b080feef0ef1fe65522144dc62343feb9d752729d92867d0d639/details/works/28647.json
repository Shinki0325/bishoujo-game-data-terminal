-review","relationId":"egs:work-creator:254088","source":"egs"},{"creditedName":"やよ","creatorId":"vndb:s32384","sourcePersonId":"egs:creator:19881","canonicalEntityId":"vndb:s32384","name":"やよ","detail":"ロゴデザイン、システムグラフィック、パッケージデザイン","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:254089","source":"egs"},{"creditedName":"ティータ・J","creatorId":"vndb:s1835","sourcePersonId":"vndb:s1835","canonicalEntityId":"vndb:s1835","name":"ティータ・J","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:160465","source":"vndb"},{"creditedName":"K.TAKA","creatorId":"vndb:s19254","sourcePersonId":"vndb:s19254","canonicalEntityId":"vndb:s19254","name":"K.TAKA","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:160472","source":"vndb"},{"creditedName":"かま みざき","creatorId":"vndb:s20374","sourcePersonId":"vndb:s20374","canonicalEntityId":"vndb:s20374","name":"かま みざき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:160473","source":"vndb"},{"creditedName":"名井阿河羅","creatorId":"vndb:s20375","sourcePersonId":"vndb:s20375","canonicalEntityId":"vndb:s20375","name":"名井阿河羅","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:160474","source":"vndb"},{"creditedName":"ホームラン","creatorId":"vndb:s34453","sourcePersonId":"vndb:s34453","canonicalEntityId":"vndb:s34453","name":"ホームラン","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:160476","source":"vndb"}]},"cast":[{"characterId":"char_c85621","characterName":"月守 愛実","sourceIds":{"bangumi":[{"characterId":"76898","match":"exact-normalized-name-in-linked-work","subjectId":"292075"}],"egsCharacterIds":["21879"],"vndbCharacterId":"c85621"},"originalCharacterName":"月守 愛実","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second year high school girl and Astronomy Club's vice-president. She has a quiet personality and when you become friends with her she usually acts as the listener. However, when you ask her for an opinion, she will read the mood and answer seriously which makes her friends rely on her often."},{"spoiler":false,"text":"She prepares for lessons well, has great grades and is much trusted by teachers. Aimi loves reading and on the days off she spends time in home or library, reading books."},{"spoiler":false,"text":"Aimi comes from a far-away village and currently she lives with her older sister Yumeno, just the two of them. They split household chores between the two of them and Aimi is in charge of cleaning (since isn't too good of a cook)."},{"spoiler":false,"text":"Influenced by a book she read when she was young, she grew interested in stars and in the future, wants to work in astronomy-related field."}],"source":"vndb","sourceCharacterId":"c85621"},{"segments":[{"spoiler":false,"text":"物静かな性格で、友達といるときは基本的に聞き役。"},{"spoiler":false,"text":"しかし、意見を求められるときちんと答え、真面目でありつつも空気の読める性格で、友達からは何かと頼りにされている。"},{"spoiler":false,"text":"何事も予習復習をしっかりこなし、成績も良く、教師からの信頼も厚い。"},{"spoiler":false,"text":"読書が好きで、休日などは自宅や図書館で本を読んで過ごすことが多い。"},{"spoiler":false,"text":"出身は遠く離れた田舎で、今は姉の夢乃と二人暮らしをしている。"},{"spoiler":false,"text":"家事は二人で分担していて、愛実は掃除と洗濯を担当している。"},{"spoiler":false,"text":"（料理はやや苦手）"},{"spoiler":false,"text":"幼い頃に読んだ本の影響で星に興味を持った。"},{"spoiler":false,"text":"将来は天文関係の職に就きたいと考えている。"}],"source":"egs","sourceCharacterId":"21879","sourceWorkId":"28647","spoiler":false},{"segments":[{"spoiler":false,"text":"物静かな性格で、友達といるときは基本的に聞き役。"},{"spoiler":false,"text":"しかし、意見を求められるときちんと答え、真面目でありつつも空気の読める性格で、友達からは何かと頼りにされている。"},{"spoiler":false,"text":"何事も予習復習をしっかりこなし、成績も良く、教師からの信頼も厚い。"},{"spoiler":false,"text":"読書が好きで、休日などは自宅や図書館で本を読んで過ごすことが多い。"},{"spoiler":false,"text":"出身は遠く離れた田舎で、今は姉の夢乃と二人暮らしをしている。"},{"spoiler":false,"text":"家事は二人で分担していて、愛実は掃除と洗濯を担当している。"},{"spoiler":false,"text":"（料理はやや苦手）"},{"spoiler":false,"text":"幼い頃に読んだ本の影響で星に興味を持った。"},{"spoiler":false,"text":"将来は天文関係の職に就きたいと考えている。"}],"source":"bangumi","sourceCharacterId":"76898"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7b1e4ec7a786a9ec398474eefcc549e6b9e34c08c7d375c77560e6ed325af6a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/3192d8914adc2417dfc8a0c896866ec3d4811dc0b3f4c0dcd55a1e43d2cb245c.webp","width":92,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野村真悠華","creatorId":"vndb:s6867","sourcePersonId":"vndb:s6867","canonicalEntityId":"vndb:s6867","name":"春田花音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:292075:76898:18395:1","source":"bangumi"}]},{"characterId":"char_c85622","characterName":"月守 夢乃","sourceIds":{"bangumi":[{"characterId":"76899","match":"exact-normalized-name-in-linked-work","subjectId":"292075"}],"egsCharacterIds":["21880"],"vndbCharacterId":"c85622"},"originalCharacterName":"月守 夢乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Third year in high school and Astronomy Club's president. Aimi's older sister. Yumeno has a cheerful and informal personality, thanks to which she boasts of great interpersonal skills, being able to get along with anyone. Although her appearance is very flashy, she is serious and speaks in polite manner. She also takes studies seriously and has good grades."},{"spoiler":false,"text":"While she often has bold physical contact with both girls and boys, she doesn't cross a certain line and strictly guards herself from any sexual contact."},{"spoiler":false,"text":"She is very good at cooking and in home, she is in charge of cooking (she makes Aimi's boxed lunches, too). On the other hand, she is bad at cleaning and before Aimi joined her, her room was a real mess."},{"spoiler":false,"text":"Currently she has no particular dream for the future and feels vaguely insecure about it, but she makes sure not to show this part of her to others."}],"source":"vndb","sourceCharacterId":"c85622"},{"segments":[{"spoiler":false,"text":"愛実の姉。"},{"spoiler":false,"text":"明るく砕けた性格をしていて、大抵の相手とならすぐに打ち解けられるコミュ力の持ち主。"},{"spoiler":false,"text":"見た目は派手目だけれども、真面目で言葉使いなども丁寧だったりする。"},{"spoiler":false,"text":"授業もきちんと受けていて成績も良い。"},{"spoiler":false,"text":"普段は男女問わずスキンシップ多めだが、身持ちは固く、邪なスキンシップは確実にガードする。"},{"spoiler":false,"text":"料理が得意で、自宅では料理担当。"},{"spoiler":false,"text":"（愛実の弁当も夢乃が作っている）"},{"spoiler":false,"text":"反面、片付けなどは苦手で、愛実が来るまで部屋はだいぶ散らかっていた。"},{"spoiler":false,"text":"現状、特に将来の夢などはなく、漠然とした不安を抱えているが、そう言った面は人に見せないようにしている。"}],"source":"egs","sourceCharacterId":"21880","sourceWorkId":"28647","spoiler":false},{"segments":[{"spoiler":false,"text":"愛実の姉。"},{"spoiler":false,"text":"明るく砕けた性格をしていて、大抵の相手とならすぐに打ち解けられるコミュ力の持ち主。"},{"spoiler":false,"text":"見た目は派手目だけれども、真面目で言葉使いなども丁寧だったりする。"},{"spoiler":false,"text":"授業もきちんと受けていて成績も良い。"},{"spoiler":false,"text":"普段は男女問わずスキンシップ多めだが、身持ちは固く、邪なスキンシップは確実にガードする。"},{"spoiler":false,"text":"料理が得意で、自宅では料理担当。"},{"spoiler":false,"text":"（愛実の弁当も夢乃が作っている）"},{"spoiler":false,"text":"反面、片付けなどは苦手で、愛実が来るまで部屋はだいぶ散らかっていた。"},{"spoiler":false,"text":"現状、特に将来の夢などはなく、漠然とした不安を抱えているが、そう言った面は人に見せないようにしている。"}],"source":"bangumi","sourceCharacterId":"76899"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c45eacb56f01149a7550b66c82fa81eddcc5542d1ef577e269e72b9c1d2235bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/4763d733f6cede3b847ec3a163ed8256c06070197c4859007674f88bc9ac56cc.webp","width":92,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桐村まり","creatorId":"vndb:s1549","sourcePersonId":"vndb:s1549","canonicalEntityId":"vndb:s1549","name":"桐村 まり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:292075:76899:23768:1","source":"bangumi"}]},{"characterId":"char_c85623","characterName":"新名 咲","sourceIds":{"bangumi":[{"characterId":"76599","match":"exact-normalized-name-in-linked-work","subjectId":"292075"}],"egsCharacterIds":["21881"],"vndbCharacterId":"c85623"},"originalCharacterName":"新名 咲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first year in university, children nursing course."},{"spoiler":false,"text":"Saki is Aimi and Yumeno's cousin and is currently attending university far away from the village. From the sisters' perspective she is like a big sister to them, and when they were in the village they very often played together."},{"spoiler":false,"text":"At first glance she gives off a cool impression, but that's because her expression doesn't show her feelings much and she herself is quite bothered by it. Saki isn't too good at talking with men and ends up acting very stiff, which ends up adding even more cool impression to her."},{"spoiler":false,"text":"She has a caring side to her and can't leave a troubled person without help."},{"spoiler":false,"text":"Saki loves children and wants to become a kindergarten teacher, but secretly, she is afraid that she would scare the children..."}],"source":"vndb","sourceCharacterId":"c85623"},{"segments":[{"spoiler":false,"text":"愛実・夢乃の従姉妹。"},{"spoiler":false,"text":"現在は村を離れて大学に通っている。"},{"spoiler":false,"text":"愛実たちからすると姉のような存在で、村にいたころはよく一緒に遊んでいた。"},{"spoiler":false,"text":"一見クールな印象を与えがちだが、表情が表に出づらいだけで、本人も割と気にしていたりする。"},{"spoiler":false,"text":"男性と話すのがあまり得意ではなく、ついぎこちなくなってしまい、よりクールな印象を与えてしまう事が多い。"},{"spoiler":false,"text":"世話好きな面があり、困っている人をほおっておけない性格。"},{"spoiler":false,"text":"子供好きで、保育士になろうとしているのだが、自分では子供を怖がらせてしまうのでは……と、密かに気にしている。"}],"source":"egs","sourceCharacterId":"21881","sourceWorkId":"28647","spoiler":false},{"segments":[{"spoiler":false,"text":"私立大学"},{"spoiler":false,"text":"保育学部1年生"},{"spoiler":false,"text":"愛実・夢乃の従姉妹。"},{"spoiler":false,"text":"現在は村を離れて大学に通っている。"},{"spoiler":false,"text":"愛実たちからすると姉のような存在で、村にいたころはよく一緒に遊んでいた。"},{"spoiler":false,"text":"一見クールな印象を与えがちだが、表情が表に出づらいだけで、本人も割と気にしていたりする。"},{"spoiler":false,"text":"男性と話すのがあまり得意ではなく、ついぎこちなくなってしまい、よりクールな印象を与えてしまう事が多い。"},{"spoiler":false,"text":"世話好きな面があり、困っている人をほおっておけない性格。"},{"spoiler":false,"text":"子供好きで、保育士になろうとしているのだが、自分では子供を怖がらせてしまうのでは……と、密かに気にしている。"}],"source":"bangumi","sourceCharacterId":"76599"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9cb0e27d19b8b9fd35f9499ba659340124e10a9ef4a0ba6c59f9a27a14be04bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72e27b51258a432423db7b52aa9409633adc55843d6b2b867b6f4b34a8698246.webp","width":92,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:292075:76599:5936:1","source":"bangumi"}]},{"characterId":"char_c85624","characterName":"遊佐 千絵梨","sourceIds":{"bangumi":[{"characterId":"76900","match":"exact-normalized-name-in-linked-work","subjectId":"292075"}],"egsCharacterIds":["21882"],"vndbCharacterId":"c85624"},"originalCharacterName":"遊佐 千絵梨","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first year in high school cousin of Aimi, Yumeno and Saki. She lives in Tsukimori Village and attends the school in nearby town."},{"spoiler":false,"text":"Chieri has a very extroverted personality and immediately gets attached to Taiki. Although she is just a year younger than Aimi, she is often mistaken for being much younger. Since she is a single daughter, in the village she stuck to Aimi and others at all times."},{"spoiler":false,"text":"She easily gets lonely and acts very spoiled towards others. However, when Saki, Yumeno and Aimi left the village she respected their will and quietly saw them off."},{"spoiler":false,"text":"Although she doesn't think of what she wants to do in future, she loves the life in the village and won't even think about leaving it."}],"source":"vndb","sourceCharacterId":"c85624"},{"segments":[{"spoiler":false,"text":"愛実・夢乃・咲とは従姉妹同士。"},{"spoiler":false,"text":"月守村在住で、近隣の町の学園に通っている。"},{"spoiler":false,"text":"人見知りしない性格で、大樹にもすぐ懐いてくる。"},{"spoiler":false,"text":"愛実とは一学年しか違わないけれども、もっと下に見られることが多い。"},{"spoiler":false,"text":"一人っ子で、愛実たちが村にいたころは何時も一緒にくっついていた。"},{"spoiler":false,"text":"さみしがり屋で甘えん坊な性格。"},{"spoiler":false,"text":"しかし、咲や夢乃、愛実が村を出るときは、彼女たちの意思を尊重して、素直に送り出した。"},{"spoiler":false,"text":"将来の事は具体的には考えていないけれども、村の生活は好きで、村を出ることは考えていない。"}],"source":"egs","sourceCharacterId":"21882","sourceWorkId":"28647","spoiler":false},{"segments":[{"spoiler":false,"text":"愛実・夢乃・咲とは従姉妹同士。"},{"spoiler":false,"text":"月守村在住で、近隣の町の学園に通っている。"},{"spoiler":false,"text":"人見知りしない性格で、大樹にもすぐ懐いてくる。"},{"spoiler":false,"text":"愛実とは一学年しか違わないけれども、もっと下に見られることが多い。"},{"spoiler":false,"text":"一人っ子で、愛実たちが村にいたころは何時も一緒にくっついていた。"},{"spoiler":false,"text":"さみしがり屋で甘えん坊な性格。"},{"spoiler":false,"text":"しかし、咲や夢乃、愛実が村を出るときは、彼女たちの意思を尊重して、素直に送り出した。"},{"spoiler":false,"text":"将来の事は具体的には考えていないけれども、村の生活は好きで、村を出ることは考えていない。"}],"source":"bangumi","sourceCharacterId":"76900"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f545a208c1b3d01209a06ffc8f90140626d81d6f480aedde810242d7761fcb75.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94a2bbe493bfe94f7a77b759c37020db014c4c7567114797cae3df7b55c64adc.webp","width":92,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤崎紗矢香","creatorId":"vndb:s6866","sourcePersonId":"vndb:s6866","canonicalEntityId":"vndb:s6866","name":"藤崎 紗矢香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:292075:76900:30075:1","source":"bangumi"}]},{"characterId":"char_vndb_c85625","characterName":"綾野 大樹","sourceIds":{"vndbCharacterId":"c85625"},"originalCharacterName":"綾野 大樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A physics teacher and the Astronomy Club's advisor."},{"spoiler":false,"text":"Taiki lost his parents in an accident when he was young, and since he had no relatives that could be contacted, he was raised in an orphanage."},{"spoiler":false,"text":"He was perfectly satisfied with his life in the orphanage and made a lot of happy memories in the facility, but he does somewhat long for his family and his birthplace."},{"spoiler":false,"text":"Since he heard that his parents were splendid teachers, Taiki decided to become a teacher himself and aimed to become one that would guide his students well."},{"spoiler":false,"text":"He has a gentle personality and almost never let's himself be carried away by emotions. Taiki is polite and has gentle demeanor. He has a good reputation among students as a \"teacher who get's it\"."},{"spoiler":false,"text":"Taiki's dream for the future is to have a warm and happy family."}],"source":"vndb","sourceCharacterId":"c85625"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efc154991e6d4268db325fa775cb4e4d4da1ececf740083b109590b1a60ee651.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5b6af4e40ad8afa8daa06b9a316bcbeeb54fdc994078156e828da04a68a8ef2.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c85908","characterName":"月守 昌子","sourceIds":{"vndbCharacterId":"c85908"},"originalCharacterName":"月守 昌子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The current head of Tsukimori household and grandmother of Aimi and Yumeno."},{"spoiler":false,"text":"Masako substantially reigns as the village's chief, she is calm and cold-hearted at all times. For the sake of the village she won't hesitate to sacrifice her own relatives."},{"spoiler":false,"text":"She becomes sixty next year."}],"source":"vndb","sourceCharacterId":"c85908"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79029a7ca2abbe5f0dc52b64b37e2b16d0f6b71b74c888811c1c85d115cbb040.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cae73875df202f04a62bfd2da918eb41f99e20705a9c2a5b74ed156f2d6628e.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:91","sourceCompanyId":"egs:brand:91","canonicalEntityId":"egs:brand:91","name":"Guilty","roleCodes":["brand"],"identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-brand:28647:91","source":"egs"},{"companyId":"v