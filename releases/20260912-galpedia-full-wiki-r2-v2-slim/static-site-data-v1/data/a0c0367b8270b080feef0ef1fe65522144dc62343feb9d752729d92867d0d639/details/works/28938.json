ウラ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"148"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the angels who carries out the \"apocalypse.\""},{"spoiler":false,"text":"An angel who announces the end of the world."},{"spoiler":false,"text":"Although she has emotions within, she will never show them on her face. Without changing her expression, she speaks harsh words without hesitation."},{"spoiler":false,"text":"She is someone who could normally be reasoned with, but when it comes to carrying out the \"apocalypse,\" she disregards everything else and faithfully executes her master's orders.\""}],"source":"vndb","sourceCharacterId":"c144550"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f99bec963a128c8fc1063b4da6128c09786233f4ff9c76bdfa6545d79036a47.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/1168c82b7f8b889e52ff7725d414eee664c17b8f86c7e0d96c04bfb97cde9dbc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風鈴 みすず","creatorId":"vndb:s12799","sourcePersonId":"vndb:s12799","canonicalEntityId":"vndb:s12799","name":"日向 結希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:83618","source":"vndb"}]},{"characterId":"char_vndb_c144551","characterName":"ディア","sourceIds":{"vndbCharacterId":"c144551"},"originalCharacterName":"ディア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"C"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the angels who carries out the \"apocalypse.\""},{"spoiler":false,"text":"An angel who brings down judgment upon the guilty."},{"spoiler":false,"text":"With a cheerful, kind-hearted, and duty-bound personality, she strives to repay any kindness shown to her."},{"spoiler":false,"text":"She faithfully fulfills her duty as an angel of the \"apocalypse,\" and when it comes to carrying out her master's command, she will cast aside all personal beliefs and follow through without hesitation."}],"source":"vndb","sourceCharacterId":"c144551"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/6933de5337a63e699864f9c704883507aa3063b7565632feb4585af8680f67d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56b1c5d24a1df8e2922b3074573e3c201cee2d0fb4d8bd4847b9dd7389d5abf5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎津 まお","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:83612","source":"vndb"}]},{"characterId":"char_vndb_c144554","characterName":"イオン","sourceIds":{"vndbCharacterId":"c144554"},"originalCharacterName":"イオン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"F"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the angels who carries out the \"apocalypse.\""},{"spoiler":false,"text":"\"An angel who prune