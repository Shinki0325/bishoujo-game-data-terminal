{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"17666","model":{"presentationWorkId":"vndb:v11419","staff":{"artwork":[{"creditedName":"椎咲雛樹","creatorId":"vndb:s1999","sourcePersonId":"egs:creator:1780","canonicalEntityId":"vndb:s1999","name":"椎咲雛樹","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:110409","source":"egs"}],"scenario":[{"creditedName":"嘘屋 佐々木酒人","creatorId":"vndb:s4095","sourcePersonId":"egs:creator:1134","canonicalEntityId":"vndb:s4095","name":"嘘屋 佐々木酒人","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:110410","source":"egs"}],"music":[],"other":[{"creditedName":"灰墨イノリ","creatorId":"vndb:s4545","sourcePersonId":"egs:creator:21178","canonicalEntityId":"vndb:s4545","name":"灰墨イノリ","detail":"OP曲「REVERSE」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:153259","source":"egs"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:93589","source":"vndb"},{"creditedName":"嘘屋 佐々木 酒人","creatorId":"vndb:s4095","sourcePersonId":"vndb:s4095","canonicalEntityId":"vndb:s4095","name":"嘘屋 佐々木 酒人","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:93592","source":"vndb"},{"creditedName":"灰墨 イノリ","creatorId":"vndb:s4545","sourcePersonId":"vndb:s4545","canonicalEntityId":"vndb:s4545","name":"灰墨 イノリ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:93593","source":"vndb"},{"creditedName":"灰墨 イノリ","creatorId":"vndb:s4545","sourcePersonId":"vndb:s4545","canonicalEntityId":"vndb:s4545","name":"灰墨 イノリ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:93594","source":"vndb"}]},"cast":[{"characterId":"char_c32443","characterName":"二階堂 勅子","sourceIds":{"bangumi":[{"characterId":"144609","match":"exact-normalized-name-in-linked-work","subjectId":"49319"}],"egsCharacterIds":["5006"],"vndbCharacterId":"c32443"},"originalCharacterName":"二階堂 勅子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"伝統的な大金持ち一族のお嬢様。"},{"spoiler":false,"text":"家族をはじめ一族の者皆それぞれ好き放題に生活しているので、いわゆる親に育てられていない。"},{"spoiler":false,"text":"祖父の代も、さらにまた上も、先祖代々没交渉。"},{"spoiler":false,"text":"大金持ちの宿命なのか？"},{"spoiler":false,"text":"家族としては完璧に破綻している一家で育つ。"},{"spoiler":false,"text":"もともとが名家なので財産や社会的地位にはさらなる興味を持てず、そのかわりに彼女は「男の人生を完全に支配してから、壊す」という”遊び”にのめりこむように……。"},{"spoiler":false,"text":"その”遊び”とは、婚約と称して奴隷男を捕まえ、ぼろぼろになるまでいたぶってからゴミのように捨てる、という遊び。"},{"spoiler":false,"text":"エリート男ほど選ばれやすいこの遊びの、主人公は三人目の犠牲者。"},{"spoiler":false,"text":"「やっぱりあんた、当たりだわ。自己中な男ほど屈服させるのが楽しいし（悪笑）」"}],"source":"egs","sourceCharacterId":"5006","sourceWorkId":"17666","spoiler":false},{"segments":[{"spoiler":false,"text":"伝統的な大金持ち一族のお嬢様。"},{"spoiler":false,"text":"家族をはじめ一族は皆がそれぞれ好き放題に生活しているので、いわゆる親に育てられていない。"},{"spoiler":false,"text":"財産や社会的地位などに興味がなく、“男の人生を完全に支配してから壊す” という遊びにのめり込んでいる。"},{"spoiler":false,"text":"婚約と称してエリートを○○男として捕まえ、ぼろぼろになるまでいたぶってからゴミのように捨てる。 主人公は三人目の犠牲者。"},{"spoiler":false,"text":"絶対的上位から命令を下す側で生きてきたので、誰かに甘えたり媚びたりするのがすごく苦手。"},{"spoiler":false,"text":"なので、そういったツボを攻められるとすぐに打たれ弱い面が露呈してしまうことも……。"},{"spoiler":false,"text":"誰かに愛されたことがなく、とても不器用。 “自分が処女” なことは絶対にバラしたくない一生の秘密。"},{"spoiler":false,"text":"「やっぱあんた、当たりだわ。自己中な男ほど屈伏させるのが楽しいし （悪笑）」"}],"source":"bangumi","sourceCharacterId":"144609"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3ea87e5af0a04527b36225ff3453d11018c2bad0473387bfa0e890da38e4060e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76a0a35bc876d9d694de003a7bfe87123442f68c0b7ced47c2466724785edb83.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"平野響子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:49319:144609:5669:1","source":"bangumi"}]},{"characterId":"char_c32444","characterName":"二階堂 祈子","sourceIds":{"bangumi":[{"characterId":"78899","match":"exact-normalized-name-in-linked-work","subjectId":"49319"}],"egsCharacterIds":["5007"],"vndbCharacterId":"c32444"},"originalCharacterName":"二階堂 祈子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"伝統的な大金持ち一族のお嬢様。勅子の妹。"},{"spoiler":false,"text":"家族をはじめ一族の者皆それぞれ好き放題に生活しているので、いわゆる親に育てられていない。"},{"spoiler":false,"text":"この歳にして自分というものが完全に出来上がってる少女。"},{"spoiler":false,"text":"誰かに甘えたり媚びたりするのが大の得意で、自分の意見は絶対に曲げない。"},{"spoiler":false,"text":"しかも彼女のおねだりはどんな無理難題であってもたいがいそのまま通ってしまうという……。"},{"spoiler":false,"text":"姉である勅子のことが大好き。"},{"spoiler":false,"text":"同時に姉の性格を完全に把握していて、彼女をからかうのも大好き。"},{"spoiler":false,"text":"座の雰囲気を読むことに長けていて、その場その場で自分の好きなほうに味方する。"},{"spoiler":false,"text":"「みんなでお兄ちゃまのこと、ヒーヒー泣かせちゃおうよ」"}],"source":"egs","sourceCharacterId":"5007","sourceWorkId":"17666","spoiler":false},{"segments":[{"spoiler":false,"text":"伝統的な大金持ち一族のお嬢様。 勅子の妹。"},{"spoiler":false,"text":"この歳にして自分というものが完全に出来上がってる少女。"},{"spoiler":false,"text":"誰かに甘えたり媚びたりするのが大の得意で、自分の意見は絶対に曲げない。"},{"spoiler":false,"text":"しかも彼女のおねだりはどんな無理難題であっても大概そのまま通ってしまうという……。"},{"spoiler":false,"text":"姉である勅子のことが大好きで、同時に姉の性格を完全に把握していて、彼女をからかうのも大好き。"},{"spoiler":false,"text":"場の雰囲気を読むことに長けていて、その場その場で自分の好きなほうに味方する。"},{"spoiler":false,"text":"そんな妹に味方されると、勅子は急に強気を盛り返すらしい。"},{"spoiler":false,"text":"逆に主人公の味方をする時は、完璧にふたりのおもちゃと化す勅子が見られるとかなんとか……。"},{"spoiler":false,"text":"「みんなでお兄ちゃまのこと、ヒーヒー泣かせちゃおうよ」"}],"source":"bangumi","sourceCharacterId":"78899"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5fd75fb51e7a8db143b09488f9eea42bd71ad15baeb10569ca0a113e66504483.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e783bf2af534305e936bbf5f9dc3f7e59a587a0180e2c89da9c7f9244ddc2d32.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"儀武ゆう子","creatorId":"vndb:s263","sourcePersonId":"vndb:s263","canonicalEntityId":"vndb:s263","name":"儀武 ゆう子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:49319:78899:4744:1","source":"bangumi"}]},{"characterId":"char_c32445","characterName":"リスカ","sourceIds":{"bangumi":[{"characterId":"144610","match":"exact-normalized-name-in-linked-work","subjectId":"49319"}],"egsCharacterIds":["5008"],"vndbCharacterId":"c32445"},"originalCharacterName":"リスカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"二階堂のお嬢様方に付き従う、住み込みの寡黙なメイド。"},{"spoiler":false,"text":"武道の心得もあり、主人公程度であれば軽く制圧できる。"},{"spoiler":false,"text":"家事や各種手続など、現実の面倒な部分はすべて担当してくれる万能裏方。"},{"spoiler":false,"text":"家事一切を有能にこなし、令状姉妹の命令には心の底から従順である。"},{"spoiler":false,"text":"最近の日本語だと「リストカット」を連想させる名前は、彼女の本名。日本人ではない。"},{"spoiler":false,"text":"彼女は自分の運命を諦め切っているふしがある。"},{"spoiler":false,"text":"二階堂家に金で買われてきた彼女は、それまでさんざんな目に遭ってきたらしい。"},{"spoiler":false,"text":"それに比べれば令嬢のわがままやメイド業の苦労など、たかが知れているくらいだという。"},{"spoiler":false,"text":"そんな彼女が恐れているのは「売りに出される（＝お払い箱になる）」ことだけ。"},{"spoiler":false,"text":"「見せつけられるだけだなんてあんまりですぅ……！」"}],"source":"egs","sourceCharacterId":"5008","sourceWorkId":"17666","spoiler":false},{"segments":[{"spoiler":false,"text":"二階堂家の姉妹に付き従う寡黙なメイド。23歳。"},{"spoiler":false,"text":"屋敷の家事を取り仕切る。"},{"spoiler":false,"text":"普段はおとなしく、何を考えているか読み取れないが、主人公の登場により微妙に心情の変化が現れる。"},{"spoiler":false,"text":"姉妹の篭絡のために、主人公の最初のターゲットにされるが……？"},{"spoiler":false,"text":"「見せ付けられるだけだなんて、あんまりですぅ……！」"}],"source":"bangumi","sourceCharacterId":"144610"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6e18af5863c583641d01b8da0be5782af237beafc937fd0dc714ca6adc08029.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40e45a296d9ed7a6f4e3df811aa811ac38e434a0bc02bda5489b3755381acb67.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:49319:144610:4799:1","source":"bangumi"}]},{"characterId":"char_c32446","characterName":"百目鬼 零一","sourceIds":{"bangumi":[],"egsCharacterIds":["5009"],"vndbCharacterId":"c32446"},"originalCharacterName":"百目鬼 零一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"27"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man with handsome features and great in communication. Although look like gentleman at glance, he has gained wealth through several questionable tactics. Always burning with psychopathic ambition."},{"spoiler":false,"text":"\"Oh man! I'm in big trouble now!\""}],"source":"vndb","sourceCharacterId":"c32446"},{"segments":[{"spoiler":false,"text":"本作の主人公。野心に燃える美青年。"},{"spoiler":false,"text":"27歳。辣腕且つやり口のダーティーな投資マネージャーであるが、物語開始早々に職を辞し、二階堂家で同居を始める。"},{"spoiler":false,"text":"両親は父親のＤＶが原因で離婚し、自堕落な母親はネグレクトぎみ、母方の祖父母は冷淡な人間だった。"},{"spoiler":false,"text":"高校進学と同時に家族のもとを離れ、成人直後には法的にも絶縁したので、天涯孤独の身。"},{"spoiler":false,"text":"珍しい姓「百目鬼」は母方の姓。母方の実家は片田舎にあるという…。"},{"spoiler":false,"text":"彼はこの姓と実家を嫌悪している。"},{"spoiler":false,"text":"誰からも愛されず、逆に周囲すべてと争うようにして育ったため、ネイティブアメリカンのことわざ"},{"spoiler":false,"text":"「敵意に満ちた中で育った子は誰とでも戦う」どおりの人格に育つ。"},{"spoiler":false,"text":"「小娘が……！　むちゃくちゃにしてやるよ！」"}],"source":"egs","sourceCharacterId":"5009","sourceWorkId":"17666","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11962d7d44511a192743187488988dc8ac088a9ad6d7c83a4daebe77147f46af.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e39e3772f849620ba3d9d25f0b8b3522822ec674d7a13be6d781ad2424a1974.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p3078","sourceCompanyId":"egs:brand:3733","canonicalEntityId":"vndb:p3078","name":"BlackLUNA","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:17666:3733","source":"egs"},{"companyId":"vndb:p3078","sourceCompanyId":"vndb:p3078","canonicalEntityId":"vndb:p3078","name":"ブラックルナ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:109466:v11419","source":"vndb"},{"companyId":"vndb:p3078","sourceCompanyId":"vndb:p3078","canonicalEntityId":"vndb:p3078","name":"ブラックルナ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:27477:v11419","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
