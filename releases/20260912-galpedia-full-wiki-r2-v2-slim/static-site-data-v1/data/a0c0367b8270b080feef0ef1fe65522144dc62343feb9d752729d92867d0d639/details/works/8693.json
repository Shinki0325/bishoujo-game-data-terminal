urce":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":true,"text":"The servant of Matou Shinji."},{"spoiler":false,"text":"Rider is silent, sultry, and vigilant, never hesitating to shield her Master from harm."},{"spoiler":false,"text":"With her Master incapable of lending Mana to her, she is forced to seek alternative means to augment her abilities. To compensate for her weakness, Rider employs covert battle tactics and takes full advantage of territory around her."},{"spoiler":false,"text":"Her weapon of choice is a pair of long iron nails fastened to opposite ends of a single chain, which she effectively thrusts from distances."},{"spoiler":true,"text":"Rider's most notable ability is her mystic eyes of petrification, which can literally petrify ones with weak magic resistance and hamper others. Using her mystic eyes, Rider can fight much more efficiently. However, she almost always keeps them covered to hide her identity and to avoid harming her allies."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c37817"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c27ea13256e7477e98d6038ad8b1b670c604c7fe663728ba7626d5291b449c1a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fd85516618ad01e28b8e3f5324d2e88415cfd5cf2c763b9beced2501e06f882.webp","width":121,"height":256,"source":"static-detail"},"actors