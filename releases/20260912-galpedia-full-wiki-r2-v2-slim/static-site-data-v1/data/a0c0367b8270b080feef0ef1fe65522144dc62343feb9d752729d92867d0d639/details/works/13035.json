4","source":"vndb"},{"creditedName":"Ｔカップ","creatorId":"vndb:s7057","sourcePersonId":"vndb:s7057","canonicalEntityId":"vndb:s7057","name":"Ｔカップ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:36275","source":"vndb"}]},"cast":[{"characterId":"char_c36014","characterName":"蛯原 うらら","sourceIds":{"bangumi":[{"characterId":"46230","match":"exact-normalized-name-in-linked-work","subjectId":"80926"}],"egsCharacterIds":["14416"],"vndbCharacterId":"c36014"},"originalCharacterName":"蛯原 うらら","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"24"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She grew up in a relatively wealthy family and is a somewhat naive and unworldly young lady."},{"spoiler":false,"text":"She will be transferring to Kurodo Academy from the second semester to pay off the debts of her fiancé, for whom she was a guarantor."},{"spoiler":false,"text":"She has an unconventional idea that \"your first time should be given to your future spouse on the wedding night.\""},{"spoiler":false,"text":"For a long time, she has had the urge to urinate when she gets nervous or excited, and in some situations she wets herself."}],"source":"vndb","sourceCharacterId":"c36014"},{"segments":[{"spoiler":false,"text":"比較的裕福な家庭環境で育ち、少し世間知らずの世間擦れしていないお嬢さん。"},{"spoiler":false,"text":"連帯保証人になっていたフィアンセの借金のカタに黒銅学園へ2学期から赴任することになる。"},{"spoiler":false,"text":"「初めては結婚する相手に初夜に捧げる」という今時ズレた考えの持ち主。"},{"spoiler":false,"text":"昔から緊張したり、興奮したりすると尿意を催し、状況によってはおもらしをしてしまう失禁癖がある。"},{"spoiler":false,"text":"「い、陰唇を英語で言うと…。えっと…おま○…やだ、わたし…なにを言って…いやぁっ」"}],"source":"egs","sourceCharacterId":"14416","sourceWorkId":"13035","spoiler":false},{"segments":[{"spoiler":false,"text":"連帯保証人になっていたフィアンセの借金のカタに黒銅学園へ2学期から赴任することになる。"},{"spoiler":false,"text":"不良の巣窟と呼ばれる黒銅学園において、比較的裕福な家庭環境で育ち、少し世間知らずの世間擦れしていないお嬢さん風の彼女の存在はまさに「掃き溜めに鶴」"},{"spoiler":false,"text":"「初めては結婚する相手に初夜に捧げる」という今時ずれた考えの持ち主で婚約したフィアンセとも未だにセックスをしたことがない処女。"},{"spoiler":false,"text":"昔から緊張したり、興奮したりすると尿意を催し、状況によってはおもらしをしてしまう失禁癖がある。"},{"spoiler":false,"text":"趣味は『ホットヨガ』。結婚式でウェディングドレスを着こなすために2年ほど前からホットヨガを始める。"},{"spoiler":false,"text":"また、血行改善することで失禁癖を治すという秘密の目的もある。"},{"spoiler":false,"text":"「い、陰唇を英語で言うと…。えっと…おま○こ？ やだ…わたし…なにを言って…いやぁっ」"}],"source":"bangumi","sourceCharacterId":"46230"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"46230","value":"英語教諭"},{"label":"年龄（本版本）","value":"24 岁","valueContext":null,"source":"egs","sourceCharacterId":"14416","sourceWorkId":"13035","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"14416","sourceWorkId":"13035","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"14416","sourceWorkId":"13035","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"14416","sourceWorkId":"13035","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"14416","sourceWorkId":"13035","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"14416","sourceWorkId":"13035","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/013ef36e66c7443573f84de89c73323a0886448f4e21cb26afce5abe412928ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d01b4b27ff1ff71d59f535b5f4e47139298b79bc9ac6fb3f8008615ccb0cb1e6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80926:46230:5052:1","source":"bangumi"}]},{"characterId":"char_c36015","characterName":"沖田 明日香","sourceIds":{"bangumi":[{"characterId":"46232","match":"exact-normalized-name-in-linked-work","subjectId":"80926"}],"egsCharacterIds":["14417"],"vndbCharacterId":"c36015"},"originalCharacterName":"沖田 明日香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"31"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has a tomboyish and straightforward personality, which was her downfall and led to her divorce from her husband about a year ago."},{"spoiler":false,"text":"She is a passionate PE teacher who was assigned to Kurodou Academy in order to reform the students."},{"spoiler":false,"text":"She serves as a guidance counselor, a role that other teachers are reluctant to take, and also founded a karate club with the aim of reforming the delinquents."},{"spoiler":false,"text":"Since her divorce, she has awakened to an embarrassing sexual tendency: whenever she thinks of her ex-husband, she is seduced by the urge to masturbate, regardless of the place."}],"source":"vndb","sourceCharacterId":"c36015"},{"segments":[{"spoiler":false,"text":"男勝りのサバサバした性格で、それがが災いして1年ほど前に夫と離婚。"},{"spoiler":false,"text":"学園生を更正させるため黒銅学園へ赴任を決めた熱血体育教師。"},{"spoiler":false,"text":"他の先生たちがやりたがらない生活指導教諭を務め、不良たちを更正させる目的で空手部も創設した。"},{"spoiler":false,"text":"離婚以来、元夫のことを想ってしまうと所構わずオナニー衝動に駆られる恥ずかしい性癖に目覚めている。"},{"spoiler":false,"text":"「どこをどうしたら、お前たちから真面目って言葉が出るんだ!?」"}],"source":"egs","sourceCharacterId":"14417","sourceWorkId":"13035","spoiler":false},{"segments":[{"spoiler":false,"text":"体育大学卒業後、学園生を更正させる目的のため、自らの意志で黒銅学園へ赴任を決めた熱血体育教師。"},{"spoiler":false,"text":"他の先生たちがやりたがらない生活指導教諭を務め、不良たちを更正させる目的で自分の特技を生かした空手部も創設した。"},{"spoiler":false,"text":"黒銅生は彼女に一目置いているが、それは彼女が空手の使い手であるからで、黒銅生たちからの信望は残念ながら薄い。"},{"spoiler":false,"text":"明るくて負けず嫌い、男勝りのサバサバした性格だが、じつはその性格が災いして1年ほど前に夫の方から別れ話を切り出され、離婚。"},{"spoiler":false,"text":"未だに彼女は未練たらたらで、離婚以来、寂しいとか辛いとかの感情が芽生えたり、元夫のことを想ってしまうと所構わずオナニー衝動に駆られる恥ずかしい性癖の持ち主になってしまっている。もちろん非処女だが、アナルは未開発のまま離婚している。"},{"spoiler":false,"text":"趣味は『空手』。物心ついたときから習っていて、有段者。"},{"spoiler":false,"text":"父親がフルコンタクト系空手の有段者で、弟とともに幼い頃から稽古をさせられていた。弟は気が弱くて大人しい性格のため途中で断念したが、負けず嫌いの明日香はめきめきと腕を上げていった。"},{"spoiler":false,"text":"「どこをどうしたら、お前たちから真面目って言葉が出るんだ!?」"}],"source":"bangumi","sourceCharacterId":"46232"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"46232","value":"体育教師（生活指導教諭、空手部顧問）"},{"label":"年龄（本版本）","value":"31 岁","valueContext":null,"source":"egs","sourceCharacterId":"14417","sourceWorkId":"13035","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"14417","sourceWorkId":"13035","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"14417"