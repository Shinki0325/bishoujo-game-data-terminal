icalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:25901","source":"vndb"}]},"cast":[{"characterId":"char_c19512","characterName":"東雲 かりん","sourceIds":{"bangumi":[{"characterId":"147240","match":"exact-normalized-name-in-linked-work","subjectId":"284174"}],"egsCharacterIds":["26498"],"vndbCharacterId":"c19512"},"originalCharacterName":"東雲 かりん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"pending-conflict","source":"vndb","value":"148"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"物覚えがよく、学力優秀な女の子。"},{"spoiler":false,"text":"男性と接するのが苦手で、それを克服したいと思っている。"},{"spoiler":false,"text":"性格は、芯が強く負けず嫌い。"},{"spoiler":false,"text":"抜群な記憶力でエッチなこともバッチリ。"},{"spoiler":false,"text":"主人公に気に入られたいため、エッチをよく覚え、主人公に尽くせる幸せを感じていく……。"}],"source":"egs","sourceCharacterId":"26498","sourceWorkId":"6011","spoiler":false},{"segments":[{"spoiler":false,"text":"＜性格＞"},{"spoiler":false,"text":"負けず嫌い。でも優しくて芯は強い。"},{"spoiler":false,"text":"＜口調＞"},{"spoiler":false,"text":"「てへ」「負けないもん！」「良いんだもん」"},{"spoiler":false,"text":"主人公と出会って、苦手な男性との恋を勉強したいと、密かに思うようになっていきます。主人公を好きになったけど思い切って言えないまま、ずるずると肉体関係が続いていきます。記憶力が抜群なので、何をさせてもすぐに覚えます。特に夜の方面のことなど・・・。かりんは主人公に気に入られたいため、エッチをよく覚えていきます。 えっちなことを覚えることで、主人公に尽くせる幸せを感じていきます。"}],"source":"bangumi","sourceCharacterId":"147240"}],"profileFacts":[{"label":"身高（本版本）","value":"148 cm","valueContext":null,"source":"egs","sourceCharacterId":"26498","sourceWorkId":"6011","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"39 kg","valueContext":null,"source":"egs","sourceCharacterId":"26498","sourceWorkId":"6011","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae05ca4cfdaa2ce109cb89f65703e2fe74d937cde3413205c4e09167380f4b7c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59662d69b720b444872af5b054bff02dc0445c0ee0df06bea512bd1a2e2f8634.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大野まりな","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:284174:147240:4434:1","source":"bangumi"}]},{"characterId":"char_c19513","characterName":"深田 さつき","sourceIds":{"bangumi":[{"characterId":"147241","match":"exact-normalized-name-in-linked-work","subjectId":"284174"}],"egsCharacterIds":["26499"],"vndbCharacterId":"c19513"},"originalCharacterName":"深田 さつき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"pending-conflict","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"運動神経抜群の元気いっぱいな女の子。"},{"spoiler":false,"text":"人付き合いが苦手で、他人と仲良くなりたいと思っているものの、強気な性格が邪魔してなかなかうまくいかない。"},{"spoiler":false,"text":"また挑発的な性格で、好きになってしまった主人公にかまって欲しくて、何かと突っかかってくる彼女は、キツイことを言いながらも、色々、ご奉仕してくれるが……。"}],"source":"egs","sourceCharacterId":"26499","sourceWorkId":"6011","spoiler":false},{"segments":[{"spoiler":false,"text":"＜性格＞"},{"spoiler":false,"text":"強気で挑発的。他人のあら捜しが得意。好きになったら一途。"},{"spoiler":false,"text":"＜口調＞"},{"spoiler":false,"text":"「ほんとにもう！」「先生ったら！いっつも甘やかしすぎよ！」"},{"spoiler":false,"text":"運動神経が他人より優れています。主人公に対して挑発的なことをしていたのは、好意の裏返し。好きだと思ったから、かまって欲しくて、主人公の気を引きたくて、主人公につっかかっていました。そのことが、さつきがひとりで独走していると回りに印象付けてしまいます。さつきは本当は、他人と仲良くなりたい、主人公と仲良くなりたいと考えています。きついことを言いながら、懸命に主人公にご奉仕していく、愛情の表れです。"}],"source":"bangumi","sourceCharacterId":"147241"}],"profileFacts":[{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"26499","sourceWorkId":"6011","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"40 kg","valueContext":null,"source":"egs","sourceCharacterId":"26499","sourceWorkId":"6011","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/876c47eae3fb3d4a97cce15cb5971bc973c61371acedf1a1ab55c94bf0b91732.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67d1c7adfc4d58833883d2161f0515a925b6b89593f10464668db91dbd3a321a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:284174:147241:6106:1","source":"bangumi"}]},{"characterId":"char_c19576","characterName":"松島 すみれ","sourceIds":{"bangumi":[{"characterId":"147242","match":"exact-normalized-name-in-linked-work","subjectId":"284174"}],"egsCharacterIds":["26500"],"vndbCharacterId":"c19576"},"originalCharacterName":"松島 すみれ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"pending-conflict","source":"vndb","value":"145"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いつもボーっとしている天然おっとり系の女の子。"},{"spoiler":false,"text":"常に無表情だが、それは内に秘める情熱を隠しているから。"},{"spoiler":false,"text":"計算力が優れており、大型コンピューターを凌ぐ場合もしばしば。"},{"spoiler":false,"text":"寂しがり屋で人見知りする彼女は、他人とのコミュニケーションが苦手なことから、友人も少ない。"},{"spoiler":false,"text":"そんな自分に興味を持ってくれた主人公を好きになってしまうが……。"}],"source":"egs","sourceCharacterId":"26500","sourceWorkId":"6011","spoiler":false},{"segments":[{"spoiler":false,"text":"＜性格＞"},{"spoiler":false,"text":"天然の、おっとり系。いつもぼおっとしています。たまに他人へ鋭い突っ込みをします。"},{"spoiler":false,"text":"＜口調＞"},{"spoiler":false,"text":"「えーっと………」「それでいいの」「わたしもそれでいいわ」"},{"spoiler":false,"text":"普段、おっとりしているのは情熱を無意識に隠すため。強い思いを持った女の子。計算能力に優れていて、時には大型コンピュータより早く計算を終わらせることが可能です。計算能力がずば抜けている反面、人に接触する事が苦手な人見知りをする性格です。人見知りをする中で、さつきと仲がよく、心を開いています。すみれは一人になる寂しさを嫌って、自分に興味を持ってくれる主人公をすぐに好きになります。でも、人見知りするので言い出せません。"}],"source":"bangumi","sourceCharacterId":"147242"}],"profileFacts":[{"label":"身高（本版本）","value":"145 cm","valueContext":null,"source":"egs","sourceCharacterId":"26500","sourceWorkId":"6011","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"40 kg","valueContext":null,"source":"egs","sourceCharacterId":"26500","sourceWorkId":"6011","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a336984c522cd5b22b8a70bfee0c762ef5acb9ed33ac2ac50a9228a9dfd2c471.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31effaabddc2a8e2535312500c02b617d7c99fb914e1feeacb9dea2ff01ef571.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日 アン","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:284174:147242:6480:1","source":"bangumi"}]},{"characterId":"char_vndb_c19575","characterName":"西村 臣","sourceIds":{"vndbCharacterId":"c19575"},"originalCharacterName":"西村 臣","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c19577","charact