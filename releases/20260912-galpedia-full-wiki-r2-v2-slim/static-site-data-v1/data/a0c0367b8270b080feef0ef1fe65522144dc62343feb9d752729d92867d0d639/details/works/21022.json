{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"21022","model":{"presentationWorkId":"vndb:v18991","staff":{"artwork":[{"creditedName":"真弓","creatorId":"vndb:s15855","sourcePersonId":"egs:creator:37117","canonicalEntityId":"vndb:s15855","name":"真弓","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:238421","source":"egs"}],"scenario":[{"creditedName":"縹けいか","creatorId":"vndb:s6859","sourcePersonId":"egs:creator:18013","canonicalEntityId":"vndb:s6859","name":"縹けいか","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:238422","source":"egs"}],"music":[{"creditedName":"Aikawa Razuna(アイカワラズナ)","creatorId":"vndb:s8901","sourcePersonId":"egs:creator:28335","canonicalEntityId":"vndb:s8901","name":"Aikawa Razuna(アイカワラズナ)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:238423","source":"egs"}],"other":[{"creditedName":"がお(tetem.)","creatorId":"vndb:s8902","sourcePersonId":"egs:creator:24226","canonicalEntityId":"vndb:s8902","name":"がお(tetem.)","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:238424","source":"egs"},{"creditedName":"縹けいか","creatorId":"vndb:s6859","sourcePersonId":"egs:creator:18013","canonicalEntityId":"vndb:s6859","name":"縹けいか","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:238425","source":"egs"},{"creditedName":"街田竹生","creatorId":"egs:creator:26737","sourcePersonId":"egs:creator:26737","canonicalEntityId":"egs:creator:26737","name":"街田竹生","detail":"パッケージデザイン","roleCode":"other","roleLabel":"其他","identityStatus":"alias-only-review","relationId":"egs:work-creator:238426","source":"egs"},{"creditedName":"楢村匠","creatorId":"egs:creator:37118","sourcePersonId":"egs:creator:37118","canonicalEntityId":"egs:creator:37118","name":"楢村匠","detail":"編集","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:238427","source":"egs"},{"creditedName":"縹 けいか","creatorId":"vndb:s6859","sourcePersonId":"vndb:s6859","canonicalEntityId":"vndb:s6859","name":"縹 けいか","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:128753","source":"vndb"},{"creditedName":"がお","creatorId":"vndb:s8902","sourcePersonId":"vndb:s8902","canonicalEntityId":"vndb:s8902","name":"tetem.","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:128755","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c45457","characterName":"館の女中","sourceIds":{"vndbCharacterId":"c45457"},"originalCharacterName":"館の女中","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"503"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"From year: ???"},{"spoiler":false,"text":"Her age and place of birth are unknown."},{"spoiler":false,"text":"She has long, black hair and jade eyes, and it is she who greets You when You first awaken in the mansion."},{"spoiler":false,"text":"The Maid calls You the \"Master\" of the house, and at her invitation, together You bear witness to a variety of events that took place within these walls."},{"spoiler":false,"text":"Shadows of her presence are visible in each of the tales. At times, she is there, and others... nowhere to be found."},{"spoiler":false,"text":"Though she treats You kindly, her hands are cold as ice, seemingly devoid of life."},{"spoiler":false,"text":"How, then, is she here now, with You?"},{"spoiler":false,"text":"\"No matter what happens, you mustn't let go of my hand.\""},{"spoiler":false,"text":"From the English official site"},{"spoiler":true,"text":"Her real name is Giselle (ジゼル)."}],"source":"vndb","sourceCharacterId":"c45457"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e24fcb6943a5b3feecf274c4d0558b17d40f82bd41299b4a975f462918d83255.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d8ce58ff51f3f62d286374d5c43e4c78dae8d975e3a448148a89d0fac173ae7.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c45459","characterName":"白い髪の娘","sourceIds":{"vndbCharacterId":"c45459"},"originalCharacterName":"白い髪の娘","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"107"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Presumed to be somewhere between fourteen and sixteen years old. Her birthplace is unknown."},{"spoiler":false,"text":"She has snow-white hair, ruby-red eyes, and abnormally pale skin, giving her an otherworldly beauty that many find disturbing. She is also hypersensitive to sunlight, which forces her to remain indoors much of the time—much to her dismay."},{"spoiler":false,"text":"Though reticent and passive, she also has an air of femininity about her."},{"spoiler":false,"text":"One stormy night, the White-Haired Girl shows up unannounced at the Rhodes household. She is taken in as a servant, but it appears she may have come for more than just work."},{"spoiler":false,"text":"\"This rose... This rose was white. Until I took it in my hand...\""},{"spoiler":false,"text":"\"Then see for yourself... feel for yourself... that there is but one difference between us.\""},{"spoiler":false,"text":"\"Those memories give me the will to wait... for the day things go back to the way they were.\""},{"spoiler":false,"text":"From the English official site"},{"spoiler":true,"text":"Her real name is Michelle (ミシェル); sixteen years old (Chapter 1), eighteen years old (Chapter 2), twenty years old (Chapter 3)."}],"source":"vndb","sourceCharacterId":"c45459"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d91394aec1e247c8db00386a6a194812fe93bffe84f188f5639b0759280ae783.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/762c6b2542b46a9afd6eeda585d116cfa24f0020224ab15e0fb111d887620fcc.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c45461","characterName":"ネリー・ローズ","sourceIds":{"vndbCharacterId":"c45461"},"originalCharacterName":"ネリー・ローズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"birthday":{"reviewState":"source-only","source":"vndb","value":"404"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"148"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"From year: 1603"},{"spoiler":false,"text":"The second child of the Rhodes family."},{"spoiler":false,"text":"An energetic girl with flaxen hair who—while she can be pushy and self-centered—is also sweetly charming. Nellie has a wide variety of hobbies: from card games to dressing up, foreign sweets to theatre, and—of course—talking. She is also quite the impressionable young girl."},{"spoiler":false,"text":"Nellie is very close to her older brother, Mell, whom she calls her prince—a holdover from the make-believe games they played when they were younger. However, she's at the age where her family is beginning to plan her marriage, which has Nellie feeling rather melancholic."},{"spoiler":false,"text":"And then, one day, something happens to taint the girl's once pure, childlike cheer."},{"spoiler":false,"text":"\"Now, attend to your princess—as a proper prince should!\""},{"spoiler":false,"text":"From the English official site"}],"source":"vndb","sourceCharacterId":"c45461"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eed47e7324843004162a8ff741a7a6e3b0fcd0802735f93869c95cce745c3b13.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2dd99aaa79220565cce64251618e0c2db54676bb5a3a83097ec94d55689f1ce8.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c45463","characterName":"ポーリーン","sourceIds":{"vndbCharacterId":"c45463"},"originalCharacterName":"ポーリーン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"birthday":{"reviewState":"source-only","source":"vndb","value":"828"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"From year: 1707"},{"spoiler":false,"text":"The daughter of a trader who, predictably, fell in love with a foreign merchant."},{"spoiler":false,"text":"She and her beloved are lucky to see each other more than once a year, but the bonds between them are unbreakable. Though separated by the vast seas, their relationship lives on."},{"spoiler":false,"text":"And then, one fateful day, she receives heartbreaking news: the Merchant has been involved in a fatal shipwreck. Pauline, however, refuses to believe he is dead, so she sets off on a journey in search of him."},{"spoiler":false,"text":"\"I have faith in him. He would never break a promise to me.\""},{"spoiler":false,"text":"From the English official site"},{"spoiler":true,"text":"Her full name is Asama Pauline (浅間・ポーリーン)."}],"source":"vndb","sourceCharacterId":"c45463"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/533eeef75680d4ad57b86f195a9f897cb78caf94c0838b19af00044d09c2725b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d5cead8a9c8e0fe6eeb250013a88911110f4408f5d5f9ccb00c71c1d815a23f.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c45465","characterName":"マリーア・カンパネッラ","sourceIds":{"vndbCharacterId":"c45465"},"originalCharacterName":"マリーア・カンパネッラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"24"},"birthday":{"reviewState":"source-only","source":"vndb","value":"714"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"From year: 1869"},{"spoiler":false,"text":"A maid who works in the mansion."},{"spoiler":false,"text":"She's affable and frank, cheerful and lackadaisical—but she never slacks on the job."},{"spoiler":false,"text":"Maria is the only one in the mansion willing to get involved with Jacopo's neglected, mistreated wife, with whom she's begun to form a friendship. She's also the only person who doesn't seem to fear Jacopo, though no one's quite sure why."},{"spoiler":false,"text":"\"If you're having a good time, what does it matter what's between your legs?\""},{"spoiler":false,"text":"From the English official site"},{"spoiler":true,"text":"In Fata morgana no Yakata -Another Episodes-:"},{"spoiler":true,"text":"A caring, supportive young woman."},{"spoiler":true,"text":"She can come off as somewhat detached and impassive, but once you’ve won Maria’s trust, she treats you like family."},{"spoiler":true,"text":"And if you betray that trust, you’ll never get it back."},{"spoiler":true,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c45465"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a33331666cbe943ac0d386b94c7daa388febb81589a9d5ecfca1204986e8092a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5b18921664336e5bf0b3e3461b0bfbbf02d7e6117228d450632c828d4fe4abc.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c48420","characterName":"モルガーナ","sourceIds":{"vndbCharacterId":"c48420"},"originalCharacterName":"モルガーナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"107"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The victim of unimaginable torture at the hands of the lord."},{"spoiler":false,"text":"She prefers to keep her face hidden so people can’t see the strange marks that cover it."},{"spoiler":false,"text":"Morgana is a doggedly aloof young girl who rarely acts her age."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c48420"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48534112ed4d91641bc014aa215c493a0987222363a8259717ff1e106c4b2f59.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1da3269bd04f007c57863ab56207dd9b87c79f64838eb570fb75e63479715781.webp","width":192,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:3292","sourceCompanyId":"egs:brand:3292","canonicalEntityId":"egs:brand:3292","name":"Novect(Novectacle)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:21022:3292","source":"egs"},{"companyId":"vndb:p3354","sourceCompanyId":"vndb:p3354","canonicalEntityId":"vndb:p3354","name":"NOVECT","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:51666:v18991","source":"vndb"},{"companyId":"vndb:p9061","sourceCompanyId":"vndb:p9061","canonicalEntityId":"vndb:p9061","name":"NIGORO","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:51667:v18991","source":"vndb"},{"companyId":"vndb:p3354","sourceCompanyId":"vndb:p3354","canonicalEntityId":"vndb:p3354","name":"NOVECT","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:71528:v18991","source":"vndb"},{"companyId":"vndb:p9061","sourceCompanyId":"vndb:p9061","canonicalEntityId":"vndb:p9061","name":"NIGORO","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:71529:v18991","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
