","relationId":"vndb:vn-staff:166230","source":"vndb"},{"creditedName":"七星 電灯","creatorId":"vndb:s14322","sourcePersonId":"vndb:s14322","canonicalEntityId":"vndb:s14322","name":"七星 電灯","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:166232","source":"vndb"}]},"cast":[{"characterId":"char_c76167","characterName":"夜鷹 一蔵","sourceIds":{"bangumi":[{"characterId":"77143","match":"exact-normalized-name-in-linked-work","subjectId":"263799"},{"characterId":"81347","match":"exact-normalized-name-in-linked-work","subjectId":"306850"}],"egsCharacterIds":["20704"],"vndbCharacterId":"c76167"},"originalCharacterName":"夜鷹 一蔵","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Am I a human, or am I Consuelo? I’m just as in the dark about myself as you...\""},{"spoiler":false,"text":"Former military and elite Blue Star pilot."},{"spoiler":false,"text":"Menacing at first, but caring when least expected."},{"spoiler":false,"text":"Second to none at engaging with vast sel energy."},{"spoiler":false,"text":"Despite once leading his own elite pilot unit, he later deserted for reasons unknown. Now a fugitive escapee based in the Red Zone, he fights on to protect residents from Consuelo"},{"spoiler":false,"text":"with Sura, his \"intergalactic pruning\" Battle-SHEEP."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c76167"},{"segments":[{"spoiler":false,"text":"《ブルースター》と呼ばれた元軍人。"},{"spoiler":false,"text":"頬は裂け、顔は赤黒く爛れている。"},{"spoiler":false,"text":"一見乱暴者だが変なところで面倒見が良い。"},{"spoiler":false,"text":"膨大なセルエネルギーを持つエンゲージの天才。"},{"spoiler":false,"text":"かつてSTX軍のエースパイロットとして精鋭部隊の指揮をしていたが、とある事情から軍を脱走した。"},{"spoiler":false,"text":"《封鎖区域》に逃げ込んでからは、そこに住む人々をコンスエロから守るため、愛機のバトルシープである《修羅》を駆り、戦い続ける。"}],"source":"egs","sourceCharacterId":"20704","sourceWorkId":"27101","spoiler":false},{"segments":[{"spoiler":false,"text":"精鋭指揮官。階級は大佐。スターラベルはブルースター。"},{"spoiler":false,"text":"アントワーヌ・ド・サガンの上官であり、同期のレグルスと仲が良い。"},{"spoiler":false,"text":"顔に似合わず甘いものが大好き。"},{"spoiler":false,"text":"主人公である箱根羊介の祖父にあたる人物。"}],"source":"egs","sourceCharacterId":"20704","sourceWorkId":"29088","spoiler":false},{"segments":[{"spoiler":false,"text":"《ブルースター》と呼ばれた元軍人。"},{"spoiler":false,"text":"頬は裂け、顔は赤黒く爛れている。"},{"spoiler":false,"text":"一見乱暴者だが変なところで面倒見が良い。"},{"spoiler":false,"text":"膨大なセルエネルギーを持つエンゲージの天才。"},{"spoiler":false,"text":"かつてSTX軍のエースパイロットとして精鋭部隊の指揮をしていたが、"},{"spoiler":false,"text":"とある事情から軍を脱走した。"},{"spoiler":false,"text":"《封鎖区域》に逃げ込んでからは、そこに住む人々をコンスエロから守るため、"},{"spoiler":false,"text":"愛機のバトルシープである《修羅》を駆り、戦い続ける。"},{"spoiler":false,"text":"「俺ですら、自分が何者かわからないんだ。人間なのか、薔薇なのか……」"}],"source":"bangumi","sourceCharacterId":"77143"},{"segments":[{"spoiler":false,"text":"精鋭指揮官。階級は大佐。スターラベルはブルースター。"},{"spoiler":false,"text":"アントワーヌ・ド・サガンの上官であり、同期のレグルスと仲が良い。"},{"spoiler":false,"text":"顔に似合わず甘いものが大好き。"},{"spoiler":false,"text":"主人公である箱根羊介の祖父にあたる人物。"}],"source":"bangumi","sourceCharacterId":"81347"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62cd181166658e569b4fe7ac6e7e0cc8ce4933d55bd075a2f90d67834f22e4dc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e24c113f493ea44e8550418e680c94f803baad8278bbd20b8e513bc8b0b8f29.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"須藤翔","creatorId":"vndb:s4816","sourcePersonId":"vndb:s4816","canonicalEntityId":"vndb:s4816","name":"やじまのぼる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:306850:81347:19281:1","source":"bangumi"}]},{"characterId":"char_c76169","characterName":"ナユタ","sourceIds":{"bangumi":[{"characterId":"77145","match":"exact-normalized-name-in-linked-work","subjectId":"263799"}],"egsCharacterIds":["20706"],"vndbCharacterId":"c76169"},"originalCharacterName":"ナユタ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"That’s right, you don’t wanna go there! The Battleship is a bad, bad place! It’s much better here!\""},{"spoiler":false,"text":"Neo-fennec no. 888. Gluttonous, spontaneous, and foul-mouthed to a fault."},{"spoiler":false,"text":"Seldevice of choice: Handy Chainsaw."},{"spoiler":false,"text":"Fled Battleship Baobab to be a slum boss in the Red Zone. After Ichizo befriends her, she relocates to Lost Eden, though she has yet to mend her rough-and-tumble ways."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c76169"},{"segments":[{"spoiler":false,"text":"個体番号はＮＦ888。"},{"spoiler":false,"text":"小麦畑色の髪と、青い瞳を持つ少女。"},{"spoiler":false,"text":"大食いで絶倫で口が悪い。"},{"spoiler":false,"text":"セーラー巫女服は《アサクサ》で買った。"},{"spoiler":false,"text":"《戦艦バオバブ》から逃げ出し、《封鎖区域》ではスラムのボスを務めていた。"},{"spoiler":false,"text":"夜鷹と出会ってからは《廃楽園》の長女として、相変わらず破天荒に暮らしている。"},{"spoiler":false,"text":"使用する《セルデバイス》はハンディチェーンソー。"},{"spoiler":false,"text":"欲望に忠実で我儘。"}],"source":"egs","sourceCharacterId":"20706","sourceWorkId":"27101","spoiler":false},{"segments":[{"spoiler":false,"text":"個体番号はNF888。"},{"spoiler":false,"text":"小麦畑色の髪と、青い瞳を持つ少女。"},{"spoiler":false,"text":"大食いで絶倫で口が悪い。"},{"spoiler":false,"text":"セーラー巫女服は《アサクサ》で買った。"},{"spoiler":false,"text":"《戦艦バオバブ》から逃げ出し、"},{"spoiler":false,"text":"《封鎖区域》ではスラムのボスを務めていた。"},{"spoiler":false,"text":"夜鷹と出会ってからは《廃楽園》の長女として、"},{"spoiler":false,"text":"相変わらず破天荒に暮らしている。"},{"spoiler":false,"text":"使用する《セルデバイス》はハンディチェーンソー。"},{"spoiler":false,"text":"欲望に忠実で我儘。"},{"spoiler":false,"text":"「人類の大地だって？全くおこがましいったら無いね！」"}],"source":"bangumi","sourceCharacterId":"77145"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/2702c988f5fe09d3e36e0d5f405dd0e2d56f69b7fd01087cb828a77eac9339b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a953ad8071a5ea89ab17d3ad6a9fed4eba1e757a8a51383a8841ecf048bdfd8.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c76172","characterName":"ジャン・レグルス","sourceIds":{"bangumi":[{"characterId":"77149","match":"exact-normalized-name-in-linked-work","subjectId":"263799"}],"egsCharacterIds":["20710"],"vndbCharacterId":"c76172"},"originalCharacterName":"ジャン・レグルス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I heard you haven’t been eating. Here, it’s a surprise present, just for you...\""},{"spoiler":false,"text":"A researcher at the STX Space Force’s R&D Center, he is the creator and father figure to all of neo-fennec kind. He is friendly from a distance, but given to icy stares, hence the moniker \"Hatred-Digesting Boa Constrictor.\""},{"spoiler":false,"text":"Hates Ichizo for nominating a certain young pilot for the \"Honorable Interstellar Plan\" of 339 UBE."},{"spoiler":false,"text":"He ostensibly oversees neo-fennec population control, but in secret, he is investigating a 5th-dimensional ghost on Battleship Baobab said to drift through the library of time."},{"spoiler":false,"text":"Edited from Steam"}],"source":"vndb","sourceCharacterId":"c76172"},{"segments":[{"spoiler":false,"text":"《STX軍》の開発センターに所属する科学者。"},{"spoiler":false,"text":"《ネオフェネック》の生みの親。"},{"spoiler":false,"text":"一見人当りの良さそうな顔をしているが《憎悪飲み込むウワバミ》と呼ばれ、恐れられている。"},{"spoiler":false,"text":"《名誉のインターステラー計画》に参加する精鋭を推薦した夜鷹一蔵を憎んでおり、"},{"spoiler":false,"text":"ネオフェネックの数を管理しながら、裏で《戦艦バオバブ》を駆け巡る《五次元オバケ》を追っている。"}],"source":"egs","sourceCharacterId":"20710","sourceWorkId":"27101","spoiler":false},{"segments":[{"spoiler":false,"text":"とても気さくで心優しい科学者。"},{"spoiler":false,"text":"モノリス研究の片手間、遺伝子工学に手を出しているらしい。"},{"spoiler":false,"text":"アントワーヌ・ド・サガンとは幼馴染みで兄代わり。"},{"spoiler":false,"text":"同期の夜鷹一蔵と仲が良い。"}],"source":"egs","sourceCharacterId":"20710","sourceWorkId":"29088","spoiler":false},{"segments":[{"spoiler":false,"text":"《STX軍》の開発センターに所属する科学者。"},{"spoiler":false,"text":"《ネオフェネック》の生みの親。"},{"spoiler":false,"text":"一見人当りの良さそうな顔をしているが、"},{"spoiler":false,"text":"《憎悪飲み込むウワバミ》と呼ばれ、恐れられている。"},{"spoiler":false,"text":"《名誉のインターステラー計画》に参加する精鋭を推薦した夜鷹一蔵を憎んでおり、"},{"spoiler":false,"text":"ネオフェネックの数を管理しながら、"},{"spoiler":false,"text":"裏で《戦艦バオバブ》を駆け巡る《五次元オバケ》を追っている。"},{"spoiler":false,"text":"「俺からキミに贈る、とっておきのサプライズだ」"}],"source":"bangumi","sourceCharacterId":"77149"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc3b15f1590e7046d281e66dd60d33b44465e8898069ca3d77e0d1e68e390ce0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5ca5bdd92fe72970ba32b5badd97109e44a43076aa62d1d0eec997d14cf046aa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"古河 徹人","creatorId":"vndb:s299","sourcePersonId":"vndb:s299","canonicalEntityId":"vndb:s299","name":"古河 徹人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84511","source":"vndb"}]},{"characterId":"char_c76173","characterName":"オリジン","sourceIds":{"bangumi":[],"egsCharacterIds":["20711","22580"],"vndbCharacterId":"c76173"},"originalCharacterName":"オリジン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Understood. Now searching with the Black Canvas...\""},{"spoiler":false,"text":"Neo-fennec no. ???"},{"spoiler":false,"text":"A mysterious lady indeed and Regulus’s personal secretary who can remains calm and composed, no matter her situation."},{"spoiler":false,"text":"Immaculate yet approachable, with the kindest of smiles, she is never seen without her Black Canvas seldevice, which was given to her by Regulus himself."},{"spoiler":false,"text":"A sucker for cheese and salty blue boudin sausages."},{"spoiler":false,"text":"Edited from ALPHA-NIGHTHAWK and BETA-SIXDOUZE Steam's pages"}],"source":"vndb","sourceCharacterId":"c76173"},{"segments":[{"spoiler":false,"text":"他のネオフェネックと違って個体番号が無い。"},{"spoiler":false,"text":"レグルスの秘書をしている清楚なお姉さん。"},{"spoiler":false,"text":"レグルスから《ブラックキャンバス》を与えられ、肌身離さず持ち歩いている。"},{"spoiler":false,"text":"優しそうな微笑みを浮かべ、いつも冷静な面持ち。"}],"source":"egs","sourceCharacterId":"20711","sourceWorkId":"27101","spoiler":false},{"segments":[{"spoiler":false,"text":"サガンが大切にしているフェネック。"},{"spoiler":false,"text":"開発センターで飼われている。"},{"spoiler":false,"text":"チーズや塩辛いブルーブーダンソーセージが大好き。"}],"source":"egs","sourceCharacterId":"20711","sourceWorkId":"29088","spoiler":false},{"segments":[{"spoiler":false,"text":"ミステリアスなアパートの管理人さん。"},{"spoiler":false,"text":"ニックネームは持たない主義。個体番号はヒミツ。ついでに年齢も秘密。"},{"spoiler":false,"text":"謎の黒い板をタブレット型デバイスと言い張る。"}],"source":"egs","sourceCharacterId":"22580","sourceWorkId":"29088","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61568ee53b0a3004e43e9c583be9a43327fb6ff56548e82e9b1539a25483baed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5964cbc2b324d1a59e50c4c36001ed3f4c1a3eb179bf650f8e018197deca60e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥川 久美子","creatorId":"vndb:s861","sourcePersonId":"vndb:s861","canonicalEntityId":"vndb:s861","name":"奥川 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84512","source":"vndb"}]},{"characterId":"char_c76177","characterName":"チリン","sourceIds":{"bangumi":[],"egsCharacterIds":["20715"],"vndbCharacterId":"c76177"},"originalCharacterName":"チリン","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"コンスエロに親を殺された男の子。"},{"spoiler":false,"text":"羊の毛皮に身を包み、チリンと鳴る鈴をつけている。"},{"spoiler":false,"text":"オムツはまだ取れていない。"},{"spoiler":false,"text":"手袋で作られた粗末な人形をいつも引き摺っている。"}],"source":"egs","sourceCharacterId":"20715","sourceWorkId":"27101","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09b45bf21a85955540baf2b07db02d7202b1c4e9f33f1c7712146f5e01721a2a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a273d5e54701fd4f77b9d23a5049d006dcfc3834fb3d68a820a6b13fb5d964c0.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c91918","characterName":"箱根 羊介","sourceIds":{"bangumi":[{"characterId":"81334","match":"exact-normalized-name-in-linked-work","subjectId":"306850"}],"egsCharacterIds":["22574"],"vndbCharacterId":"c91918"},"originalCharacterName":"箱根 羊介","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The STX Space Force’s newest captain. Rank: Silver Star. Promoted to Battle-SHEEP pilot due to his selfless nature, he’s ready to lay down his life for the mission–and humankind."},{"spoiler":false,"text":"However, as the grandson of a notorious war criminal, his morality often stems from misplaced shame and guilt. Thanks to Hanaco, he learns to face his demons for the first time…"},{"spoiler":false,"text":"“You and me together make 612! You got that, Hanaco?!”"},{"spoiler":false,"text":"From Shiravune"}],"source":"vndb","sourceCharacterId":"c91918"},{"segments":[{"spoiler":false,"text":"バトルシープの操縦をする操縦士。"},{"spoiler":false,"text":"階級は大尉。スターラベルはシルバースター。"},{"spoiler":false,"text":"面倒見の良さを買われて精鋭としてバトルシープに乗ることに。"},{"spoiler":false,"text":"自分の使命は人々の為にこの命を懸けることと豪語しているが、その信念は戦犯の孫という強迫観念から生じた烏滸がましいものである。"},{"spoiler":false,"text":"ハナコと出会いバディを組むことで、初めて自分自身の心と向き合うこととなる。"}],"source":"egs","sourceCharacterId":"22574","sourceWorkId":"29088","spoiler":false},{"segments":[{"spoiler":false,"text":"バトルシープの操縦をする操縦士。"},{"spoiler":false,"text":"階級は大尉。スターラベルはシルバースター。"},{"spoiler":false,"text":"面倒見の良さを買われて精鋭としてバトルシープに乗ることに。"},{"spoiler":false,"text":"自分の使命は人々の為にこの命を懸けることと豪語しているが、"},{"spoiler":false,"text":"その信念は戦犯の孫という強迫観念から生じた烏滸がましいものである。"},{"spoiler":false,"text":"ハナコと出会いバディを組むことで、初めて自分自身の心と向き合うこととなる。"}],"source":"bangumi","sourceCharacterId":"81334"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33acc7f1f0eb0f274c7bfe2d92f10137b652b684814dfe84db2ea910dfb759a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6e7108d868e263850d5746cdb751c3faba7742a79e5297f77f8315c52fe71d8.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"須藤翔","creatorId":"vndb:s4816","sourcePersonId":"vndb:s4816","canonicalEntityId":"vndb:s4816","name":"やじまのぼる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:306850:81334:19281:1","source":"bangumi"}]},{"characterId":"char_c91919","characterName":"ハナコ","sourceIds":{"bangumi":[{"characterId":"81335","match":"exact-normalized-name-in-linked-work","subjectId":"306850"}],"egsCharacterIds":["22575"],"vndbCharacterId":"c91919"},"originalCharacterName":"ハナコ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yosuke’s mysterious new copilot, a bona-fide Blue Star, and a wunderkind at channeling vast amounts of pure sel."},{"spoiler":false,"text":"This girl’s all at once honest, simple, and the purest of heart. Though no fault of her own, she often fails to read the room. Tends to take conversations and social cues at face value."},{"spoiler":false,"text":"“Got it. I’ll fight with you, Yosuke!”"},{"spoiler":false,"text":"From Shiravune"}],"source":"vndb","sourceCharacterId":"c91919"},{"segments":[{"spoiler":false,"text":"バトルシープの四肢を操るセル乗員。"},{"spoiler":false,"text":"エンゲージの天才。スターラベルはブルースター。"},{"spoiler":false,"text":"善意も悪意も全て真正面から受け止めてしまう不思議な少女。"},{"spoiler":false,"text":"純粋無垢な彼女にとって、言葉は誤解の元。"},{"spoiler":false,"text":"大人が使いがちな言葉のオブラートや空気、遠慮といったものは彼女に一切通用しない"}],"source":"egs","sourceCharacterId":"22575","sourceWorkId":"29088","spoiler":false},{"segments":[{"spoiler":false,"text":"バトルシープの四肢を操るセル乗員。"},{"spoiler":false,"text":"エンゲージの天才。スターラベルはブルースター。"},{"spoiler":false,"text":"善意も悪意も全て真正面から受け止めてしまう不思議な少女。"},{"spoiler":false,"text":"純粋無垢な彼女にとって、言葉は誤解の元。"},{"spoiler":false,"text":"大人が使いがちな言葉のオブラートや空気、遠慮といったものは彼女に一切通用しない。"}],"source":"bangumi","sourceCharacterId":"81335"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/969d402cc39624b96e2bbf028c8de22a5cd20a0dd396d20df0a77784e60b1c2c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edb52f5a89882ead03ef9765e0a46ccfed0525291b636a6893d12577bbaab3ce.webp","width":163,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤沢れい香","creatorId":"vndb:s14338","sourcePersonId":"vndb:s14338","canonicalEntityId":"vndb:s14338","name":"藤沢 れい香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:306850:81335:32998:1","source":"bangumi"}]},{"characterId":"char_c91920","characterName":"アントワーヌ・ド・サガン","sourceIds":{"bangumi":[{"characterId":"81336","match":"exact-normalized-name-in-linked-work","subjectId":"306850"}],"egsCharacterIds":["22576"],"vndbCharacterId":"c91920"},"originalCharacterName":"アントワーヌ・ド・サガン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A ’39 survivor and ex-STX-SF commander and pilot. Sports honey-wheat hair and sapphire eyes. Prefers the more manly “Sagan” over “Antoine”… Originally from France."},{"spoiler":false,"text":"“I think I could have fun living in a place like this, even on my own.”"},{"spoiler":false,"text":"From Shiravune"}],"source":"vndb","sourceCharacterId":"c91920"},{"segments":[{"spoiler":false,"text":"３９作戦の生還者。元操縦士で階級は中佐。"},{"spoiler":false,"text":"小麦畑色の髪に蒼い目が特徴。訳あって男のような名を名乗っている。"},{"spoiler":false,"text":"実年齢１８歳のフランス人。"}],"source":"egs","sourceCharacterId":"22576","sourceWorkId":"29088","spoiler":false},{"segments":[{"spoiler":false,"text":"３９作戦の生還者。元操縦士で階級は中佐。"},{"spoiler":false,"text":"小麦畑色の髪に蒼い目が特徴。訳あって男のような名を名乗っている。"},{"spoiler":false,"text":"実年齢１８歳のフランス人。"}],"source":"bangumi","sourceCharacterId":"81336"}],"profileFacts":[{"label":"年龄（本版本）","value":"18 岁","valueContext":null,"source":"egs","sourceCharacterId":"22576","sourceWorkId":"29088","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/371d0607d483c242aef0b3627eaff0f2d68923d3846df1cf5357dbaca23289df.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/6464b857c4d84c4a58