roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:88443","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c40665","characterName":"楊栴","sourceIds":{"vndbCharacterId":"c40665"},"originalCharacterName":"楊栴","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yousen is the daughter of a god, the emperor who rules the mountains in the sky Kun Lun (aka Tibet.) Yousen’s mother died soon as she was born so she didn’t know much about her and spent most of her childhood with her father. She ran away from home to discover the beauty of the world, and was adopted by an old man who acted as her teacher."},{"spoiler":false,"text":"Edited from Hinano's Game Babble's"}],"source":"vndb","sourceCharacterId":"c40665"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8b6b8af65689cfdae467a8d2b4e47969731cf64af1aba1e75697518ec7be0e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc6792f65b990f598fd67f0cf06da31fffe2e91ed76a58d4d85b2a276f3c1da3.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c40666","characterName":"黄天化","sourceIds":{"vndbCharacterId":"c40666"},"originalCharacterName":"黄天化","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tenka is an older brother type that is loved by both Nata and his younger brother, Kou Tenshou. He hates his father, Kou Hiko and the reasons are buried deep within his story. He is straight forward when talking to the others, and have a strong respect for Yousen, Taikoubou and GyokutenShinjin."},{"spoiler":false,"text":"Tenka is a studying Taoist under one of the Great Twelve Celestials in Konlon mountain. He is pretty new at this Taoist celestial thing, making him a pretty weak individual compared to the other celestials. However, his expertise seems to lie in sword fighting and can practically do no magic at all. He enjoys spending time sparring with Yousen and learning tips from her fighting, as well as watching over the kids Nata and Tenshou."},{"spoiler":false,"text":"from Sapphire Wings Tumblr"}],"source":"vndb","sourceCharacterId":"c40666"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd2725cad60558d6e3c1e61206503daafb6f5d0f0ffc031e0d170ebef9c07afd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8fa13688e2ea42f064dc6b6da175fcc6f1b49ece066acc3f3d7a0b8e428e322.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"日野 聡","creatorId":"vndb:s82","sourcePersonId":"vndb:s82","canonicalEntityId":"vndb:s82","name":"日野 聡","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46957","source":"vndb"}]},{"characterId":"char_vndb_c40667","characterName":"太公望","sourceIds":{"vndbCharacterId":"c40667"},"originalCharacterName":"太公望","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Taikoubou is a great strategist, sent by his master, GenshiTenjun-sama to complete the Houshin Plan and defeat SoDakki. He was given the list of demon names to seal (Houshin Shou), and leads the battle between Kihatsu and Chuuou. He is highly impatient when it comes to ordering others around and having them respond to his wishes, but is level headed when it comes to battles. Oddly, he cannot fight- being one of the weakest members of the group- but his fighting abilities lie in his brain as he easily is able to trick others during fights. However, his magical abilities are astounding… he possesses the ability to one shot Dakki, but the casting takes a long time."},{"spoiler":false,"text":"Taikoubou is greedy for money and enjoys counting coins and money stacks late into the night. He also has a rude mouth, yelling at Kihatsu and calling him an idiot. He is proud and likes to tease Yousen… their personalities often clashing, creating battles through witty words between the two…."},{"spoiler":false,"text":"from Sapphire Dreams Tumblr"}],"source":"vndb","sourceCharacterId":"c40667"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab3a79ad587909b7c0466a3000260ba9999323e72643011f04409e61819ba460.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/567b6cc93ddc1ecf7f0245ed8fe1e8ac0055211c432b8a572b06577c624a9ea9.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶 裕貴","creatorId":"vndb:s84","sourcePersonId":"vndb:s84","canonicalEntityId":"vndb:s84","name":"梶 裕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46958","source":"vndb"}]},{"characterId":"char_vndb_c40668","characterName":"蘇妲己","sourceIds":{"vndbCharacterId":"c40668"},"originalCharacterName":"蘇妲己","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Dakki is playful, teasing Yousen and asking her to be his ‘doll’. Of course, the strong minded Yousen would never fall under Dakki’s spells and resisted him in every advance… This only fuels Dakki’s desires greater as he tries over and over again to take Yousen for his own… Is this only for his twisted desires, or is there more to this story…?"},{"spoiler":false,"text":"From Sapphire Dreams Tumblr"}],"source":"vndb","sourceCharacterId":"c40668"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba8a2c02b4902617e0cb92004d9164041f2b9263af003f1f531c5b0bae1bc272.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f4dbaa4a75494171cbe6f6528033574ce0a2b03407436143dcd5c2e5cf5bc11.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"諏訪部 順一","creatorId":"vndb:s66","sourcePersonId":"vndb:s66","canonicalEntityId":"vndb:s66","name":"諏訪部 順一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46956","source":"vndb"}]},{"characterId":"char_vndb_c40669","characterName":"姫発","sourceIds":{"vndbCharacterId":"c40669"},"originalCharacterName":"姫発","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kihatsu is a sweet, party-loving, hyper active and positive prince. He is always festive and tries to cheer everyone up with his positive glow. He is the most charismatic of the group and pulls everyone through the hard times with his positive attitude and smile. However, due to his straight forward nature and positive outlook, Taikoubou is always calling him an idiot prince."},{"spoiler":false,"text":"Despite his happy go lucky nature, he is a very strong individual. Although he can't fight, he's still very strong mentally and physhically."},{"spoiler":false,"text":"from Sapphire Dreams Tumblr"}],"source":"vndb","sourceCharacterId":"c40669"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9ffba6d756334f79428ed6410a929aea045b2c0cadcdfc858bfb3e7d46a97522.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfc1059f6767c85758499df9999250a4d8fb6270201ff7c37ddd0a1bccc56638.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村 良平","creatorId":"vndb:s382","sourcePersonId":"vndb:s382","canonicalEntityId":"vndb:s382","name":"木村 良平","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46959","source":"vndb"}]},{"characterId":"char_vndb_c40670","characterName":"玉鼎真人","sourceIds":{"vndbCharacterId":"c40670"},"originalCharacterName":"玉鼎真人","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Gyokutei Shinjin was the first to find Yousen after she was banished to the human realm, and gave out an offering hand to help her when she was at her worst. He truly loved her like his own child and raised her, teaching her everything he knew so she could defend herself. Even before Yousen, Gyokutei was known to be a very loving master who would do anything for his disciples. He seemed almost overboard, caring so deeply for his disciple- Yousen- that he would do anything for her safety."},{"spoiler":false,"text":"Gyokutei also seems to be cursed with bad luck, making the worst possible things happen around him."},{"spoiler":false,"text":"from Sapphire Dreams Tumblr"}],"source":"vndb","sourceCharacterId":"c40670"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/715e898058e3b3e89f027b68f70852efd2b0485a70c0b9db356d3082189d7a20.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98f02a53aab9ce22c456dda5188468be796e6f414a1df4a3c229db4a29b986da.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"関 俊彦","creatorId":"vndb:s741","sourcePersonId":"vndb:s741","canonicalEntityId":"vndb:s741","name":"関 俊彦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46961","source":"vndb"}]},{"characterId":"char_vndb_c40673","characterName":"聞仲","sourceIds":{"vndbCharacterId":"c40673"},"originalCharacterName":"聞仲","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mountain hermit who doesn't want to interfere in human lives, but he is still quite influenced by the human world."}],"source":"vndb","sourceCharacterId":"c40673"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49aead769cbb5e6344bbc399dc7e95f6438c3fd34326e7f13c6a9d82b46247b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/362d7899390b5c5a563efe521c5dbab87b50231b79cb72ad31db9fdc4df35bbc.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"髙階 俊嗣","creatorId":"vndb:s16682","sourcePersonId":"vndb:s16682","canonicalEntityId":"vndb:s16682","name":"髙階 俊嗣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46971","source":"vndb"}]},{"characterId":"char_vndb_c40674","characterName":"紂王","sourceIds":{"vndbCharacterId":"c40674"},"originalCharacterName":"紂王","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb",