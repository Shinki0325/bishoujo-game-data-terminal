{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"8165","model":{"presentationWorkId":"vndb:v7346","staff":{"artwork":[{"creditedName":"マサぷく","creatorId":"egs:creator:5048","sourcePersonId":"egs:creator:5048","canonicalEntityId":"egs:creator:5048","name":"マサぷく","roleCode":"artwork","roleLabel":"原画","identityStatus":"no-alias-hit","relationId":"egs:work-creator:20040","source":"egs"}],"scenario":[{"creditedName":"津之深りょーじ","creatorId":"egs:creator:5049","sourcePersonId":"egs:creator:5049","canonicalEntityId":"egs:creator:5049","name":"津之深りょーじ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:20041","source":"egs"},{"creditedName":"三頭獣","creatorId":"vndb:s15039","sourcePersonId":"egs:creator:2105","canonicalEntityId":"vndb:s15039","name":"三頭獣","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:22017","source":"egs"}],"music":[{"creditedName":"a2c","creatorId":"vndb:s5192","sourcePersonId":"vndb:s5192","canonicalEntityId":"vndb:s5192","name":"a2c","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:70414","source":"vndb"},{"creditedName":"MintJam","creatorId":"vndb:s5193","sourcePersonId":"vndb:s5193","canonicalEntityId":"vndb:s5193","name":"MintJam","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:70415","source":"vndb"},{"creditedName":"せっつぁ~","creatorId":"vndb:s8842","sourcePersonId":"vndb:s8842","canonicalEntityId":"vndb:s8842","name":"門間 淳","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:70416","source":"vndb"}],"other":[{"creditedName":"三頭獣","creatorId":"vndb:s15039","sourcePersonId":"vndb:s15039","canonicalEntityId":"vndb:s15039","name":"三頭獣","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:70418","source":"vndb"}]},"cast":[{"characterId":"char_c65558","characterName":"御坂 ゆかり","sourceIds":{"bangumi":[{"characterId":"130516","match":"exact-normalized-name-in-linked-work","subjectId":"437917"}],"egsCharacterIds":["24360"],"vndbCharacterId":"c65558"},"originalCharacterName":"御坂 ゆかり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"巧巳の婚約者で、半年後に結婚が決まっている。巧巳とは高校時代からの知り合いで、相思相愛の仲。現在、佐伯総合病院の看護師として勤務している。"},{"spoiler":false,"text":"“白衣の天使”を体現したような、優しく温かく、清純な女性。男性職員や男性患者の中にもファンは多い。"},{"spoiler":false,"text":"やや古風なくらいの貞操観念を持っており、結婚するまでは巧巳にも身体を許さず、性的な話題はタブー。よって処女。"}],"source":"egs","sourceCharacterId":"24360","sourceWorkId":"8165","spoiler":false},{"segments":[{"spoiler":false,"text":"巧巳の婚約者で、半年後に結婚することが決まっている。巧巳とは高校時代から既に知り合っており、相思相愛。"},{"spoiler":false,"text":"現在、佐伯総合病院の看護師として勤務している。"},{"spoiler":false,"text":"“白衣の天使”という言葉がそのまま人の形を成したような、優しくあたたかく、清純な女性で、男性職員や男性患者の中でもファンは多い。"},{"spoiler":false,"text":"やや古風とも云えるほどの、しっかりとした貞操観念を持っており、結婚するまでは巧巳にも身体を許さず、性的な話題は断固としてはねつける。"}],"source":"bangumi","sourceCharacterId":"130516"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/036f14d5b5ad8e15992f0e027b39ba6b11e67c1ca1cb14e3f7552e2eb776ea12.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69a5000ebb3e623429e1bf42c3a50eb081077d9f8afff837cc9caf46725fe5ee.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"カンザキカナリ","creatorId":"vndb:s1000","sourcePersonId":"vndb:s1000","canonicalEntityId":"vndb:s1000","name":"カンザキ カナリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:437917:130516:24747:1","source":"bangumi"}]},{"characterId":"char_c65559","characterName":"佐伯 響香","sourceIds":{"bangumi":[{"characterId":"130517","match":"exact-normalized-name-in-linked-work","subjectId":"437917"}],"egsCharacterIds":["24361"],"vndbCharacterId":"c65559"},"originalCharacterName":"佐伯 響香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"巧巳の実の姉で、佐伯総合病院の看護士長。"},{"spoiler":false,"text":"優しさに裏付けられた厳しさを持つ女性で、鋭い言葉の裏にはいつも、人を見守る温かさがある。そのうえ、仕事ぶりはとても優秀で、部下のナースにも医師にも頼られている。弟の巧巳には特に厳しく当たるが、実際は人一倍の弟思い。"},{"spoiler":false,"text":"巧巳を家族として深く愛しており、巧巳が一人前の院長になるまで未婚を貫く予定。"},{"spoiler":false,"text":"特定の男性と付き合った経験が無く、処女。"}],"source":"egs","sourceCharacterId":"24361","sourceWorkId":"8165","spoiler":false},{"segments":[{"spoiler":false,"text":"佐伯総合病院の看護師長にして、巧巳の実の姉。"},{"spoiler":false,"text":"優しさに裏付けられた厳しさを持つ女性で、鋭い言葉の裏にはいつも、人を見守るあたたかさが在る。そのうえ、仕事ぶりはとても優秀で、部下のナースにも医師たちにも頼られている。"},{"spoiler":false,"text":"弟である巧巳には特に厳しくあたるが、実際は人一倍の弟煩悩。巧巳を家族として深く愛しており、巧巳が病院をひとりで背負って立てるようになるまで、結婚もしないつもり。"}],"source":"bangumi","sourceCharacterId":"130517"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/811a5e1ab5a719063f783bb991972f8fcabb0f8a099a45460076e018a9f43fcc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc2e6cd9993370945a922f36bd9396a9e459f36ed0f3c8626c6c9b116012993b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"富山あかり","creatorId":"vndb:s891","sourcePersonId":"vndb:s891","canonicalEntityId":"vndb:s891","name":"歌織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:437917:130517:12717:1","source":"bangumi"}]},{"characterId":"char_c65560","characterName":"佐伯 比奈","sourceIds":{"bangumi":[{"characterId":"130518","match":"exact-normalized-name-in-linked-work","subjectId":"437917"}],"egsCharacterIds":["24362"],"vndbCharacterId":"c65560"},"originalCharacterName":"佐伯 比奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"巧巳の実の妹で、佐伯総合病院に配属したての新米ナース。巧巳は兄でありながら、医療従事者としても男性としても彼女の理想。"},{"spoiler":false,"text":"一時期は本気で兄に恋していたが、尊敬するゆかりが婚約者となってからは吹っ切れている。"},{"spoiler":false,"text":"直情的で看護師としてはかなり騒がしいが、病院のムードメーカーとして周囲の人気は高い（その分いつも響香に怒られている）。処女。"}],"source":"egs","sourceCharacterId":"24362","sourceWorkId":"8165","spoiler":false},{"segments":[{"spoiler":false,"text":"巧巳の実の妹で、看護学校を卒業後に佐伯総合病院へ配属されて間無しの、新人ナース。"},{"spoiler":false,"text":"巧巳は兄でありながら、医療従事者として、男性として、彼女の理想となっている。"},{"spoiler":false,"text":"一時期は本気で恋慕の情を抱いてもいたが、学生時代に尊敬していたゆかりが巧巳の婚約者となってからは、いつも近くにいられるのなら…と、彼女の中では一応吹っ切れている。"},{"spoiler":false,"text":"直情的でいつも一直線、看護師としてはかなり騒がしいが、病院の雰囲気を明るくする元気なムードメーカーとして周囲の人気は高い。"}],"source":"bangumi","sourceCharacterId":"130518"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43c26f53a0be78d253ff2acdc97f34cf60881b6d69aecfa04aa78bbcc3856e09.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25bd74668fb5a078c72ce07afd17b8554926ea7a5f28e897cc4201b1bd40bc86.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永見はるか","creatorId":"vndb:s452","sourcePersonId":"vndb:s452","canonicalEntityId":"vndb:s452","name":"永見 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:437917:130518:4674:1","source":"bangumi"}]},{"characterId":"char_c65561","characterName":"一之瀬 真由","sourceIds":{"bangumi":[{"characterId":"130519","match":"exact-normalized-name-in-linked-work","subjectId":"437917"}],"egsCharacterIds":["24363"],"vndbCharacterId":"c65561"},"originalCharacterName":"一之瀬 真由","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"gender":{"reviewState":"source-only","source":"vndb","value":"f"},"sex":{"reviewState":"source-only","source":"vndb","value":"b"}},"descriptions":[{"segments":[{"spoiler":false,"text":"比奈と同じく、佐伯総合病院の新米ナース（准看護師）。"},{"spoiler":false,"text":"生まれつき男女両方の性器を持ち（ふたなり）、それを苦に自殺を図り、佐伯総合病院に入院した経験がある。そこで巧巳と響香に出会ったことで、人生を前向きに見られるようになった。同時に、医療の道を志す。それ以来二人を深く敬愛している（そして巧巳もそのときの経験が今の自分を形成した……、と真由に特別な感情を抱いている）。"},{"spoiler":false,"text":"気が弱く、恥ずかしがりな性分で、物事を真に受けやすい（騙されやすい）。処女。"}],"source":"egs","sourceCharacterId":"24363","sourceWorkId":"8165","spoiler":false},{"segments":[{"spoiler":false,"text":"看護学校を経て准看護師として佐伯総合病院に配属された新人。"},{"spoiler":false,"text":"気が弱く、恥ずかしがりな性分で、物事を真に受けやすい。"},{"spoiler":false,"text":"生まれながらに、男女両方の性器を持っていて、数年前にそれを苦に思ったことから自殺を図り、佐伯総合病院に入院したことが有る。"},{"spoiler":false,"text":"そこでの（院長になったばかりの）巧巳と響香との触れ合いを経て、前向きに人生を見られるようになると同時に、医療の道を志すようになった。それ以来、巧巳と響香を深く敬愛する。"}],"source":"bangumi","sourceCharacterId":"130519"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"b","source":"vndb","sourceCharacterId":"c65561","value":"b"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"24363","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"24363","value":"女性"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc026291891148f442aed8c7a1d7845eee77cea9730149e24e501c68f3b21fd1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a8e5f04ea1a8b8abb1880d6908f055d2356ff0d8d84dfd95286b6083f4a4c88.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽月理恵","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","rel