fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7bed9831ba028ad0d4c26170e0be9b8d5ec7ed5985c7e5caa1287861d71c989.webp","width":108,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:73416:92492:4714:1","source":"bangumi"}]},{"characterId":"char_c18068","characterName":"加納 りょう","sourceIds":{"bangumi":[{"characterId":"92495","match":"exact-normalized-name-in-linked-work","subjectId":"73416"}],"egsCharacterIds":["17990"],"vndbCharacterId":"c18068"},"originalCharacterName":"加納 りょう","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"24"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"出産後、奇跡の復活を遂げた、日本を代表するママさん柔道家。"},{"spoiler":false,"text":"試合後に授乳している姿も見られる。"},{"spoiler":false,"text":"明るくおおざっぱだが、エッチの時は照れてしまうタイプ。"},{"spoiler":false,"text":"「大丈夫、大丈夫！　このぐらいすぐ治るっしょ！　あっははははっ！」"}],"source":"egs","sourceCharacterId":"17990","sourceWorkId":"10982","spoiler":false},{"segments":[{"spoiler":false,"text":"日本が誇る女子柔道選手。"},{"spoiler":false,"text":"結婚と出産で一時は引退説も流れたが、負けじと大会に出場し勝ち続ける。その後、国内では無敗記録を更新中。"},{"spoiler":false,"text":"その傍らで育児にも奮闘している。そのせいか、最近ちょっと女としての自分を意識し始めたのだが、夫は自分を女と思ってくれないと悩んでいた。"},{"spoiler":false,"text":"ある時、伝説のマッサージ師の噂を聞いて事務にやってくる。マッサージによる絶頂と潮噴きに感動。もっと感じさせてほしくて主人公を求めてくるようになる。"}],"source":"bangumi","sourceCharacterId":"92495"}],"profileFacts":[{"label":"体型","source":"bangumi","sourceCharacterId":"92495","value":"がっしりしつつもグラマー。出産で胸がおおきくなった。"},{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"17990","sourceWorkId":"10982","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"17990","sourceWorkId":"10982","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"17990","sourceWorkId":"10982","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"waist":[{"comparisonValue":"79","source":"vndb","sourceCharacterId":"c18068","value":"79"},{"comparisonValue":"59","scope":"sourceWork","source":"egs","sourceCharacterId":"17990","sourceWorkId":"10982","value":"59"},{"comparisonValue":"59","source":"bangumi","sourceCharacterId":"92495","value":"59"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/abe44ec920833200998263560f9eae34caa030569f956c831fa3dc97e801baf0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/8917e240f21f3be5737803d2bed97d4ad2be49a67aa53511513c9402030f1f2a.webp","width":107,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:73416:92495:5741:1","source":"bangumi"}]},{"characterId":"char_c18069","characterName":"鞠谷 沙羅","sourceIds":{"bangumi":[{"characterId":"92493","match":"exact-normalized-name-in-linked-work","subjectId":"73416"}],"egsCharacterIds":["17989"],"vndbCharacterId":"c18069"},"originalCharacterName":"鞠谷 沙羅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"高慢で生意気な、ロシアンハーフのプロテニスプレイヤー。"},{"spoiler":false,"text":"ムッチリしなやかな肉体と、高い技量で世界が注目している選手。"},{"spoiler":false,"text":"しかし最近は壁に当たっているようで……。"},{"spoiler":false,"text":"「応援にこいって、命令したかしら？　まあいいわ……そこに座っておとなしく、わたしのテニスを観ていなさい」"}],"source":"egs","sourceCharacterId":"17989","sourceWorkId":"10982","spoiler":false},{"segments":[{"spoiler":false,"text":"ジュニアでは負けなしの天才的テニスプレーヤーで、プロに転向してから常勝とはいかないまでも、キャリアに比して好調な成績。世界ランキングも順調に昇りつつあったが最近は絶不調の真っ只中。"},{"spoiler":false,"text":"そんな折に朝香から主人公の話を聞きつけ、彼のマッサージで潮を噴いてしまうが身体の調子がよくなって自分でもびっくり。"},{"spoiler":false,"text":"性感と体調の改善というメリットを認めつつも、たかがジムのマッサージ師ごときを対等なパートナーとして扱うことができない性格なので、自分を正当化するため主人公を\"有能な部下\"と勝手に決めつけ、そう扱う。"}],"source":"bangumi","sourceCharacterId":"92493"}],"profileFacts":[{"label":"体型","source":"bangumi","sourceCharacterId":"92493","value":"白人的バインバインなボディ。"},{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"17989","sourceWorkId":"10982","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"17989","sourceWorkId":"10982","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"17989","sourceWorkId":"10982","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"hip":[{"comparisonValue":"85","source":"vndb","sourceCharacterId":"c18069","value":"85"},{"comparisonValue":"89","scope":"sourceWork","source":"egs","sourceCharacterId":"17989","sourceWorkId":"10982","value":"89"},{"comparisonValue":"89","source":"bangumi","sourceCharacterId":"92493","value":"89"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/203a5902ae23a9f871c57e12dc886483438c6a766aefd61ecf86cab900248902.webp","fallbackUrl":"https://wiki