:false,"text":"TVなどで人気沸騰中のビーチバレー選手。"},{"spoiler":false,"text":"マスコミなどからチヤホヤされるものの、試合に集中できなくて良い結果が出せず、周りから実力のない選手だと叩かれ、そのせいか身体も思うように動かず悪循環に陥っている。"},{"spoiler":false,"text":"そこに伝説のマッサージ師の噂を聞きつけ、主人公のジムにやってくる。"}],"source":"bangumi","sourceCharacterId":"92488"}],"profileFacts":[{"label":"体型","source":"bangumi","sourceCharacterId":"92488","value":"長身で引き締まった身体"},{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"17984","sourceWorkId":"10982","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"17984","sourceWorkId":"10982","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"17984","sourceWorkId":"10982","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e879839c97306edb84985b976ba2c592981fcc291a963c9a82aae6134c1b664.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5d3e61da160eef69236a4d6b1d1234993bc00d1a0dd607e03491a901441c89f.webp","width":101,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:73416:92488:4832:1","source":"bangumi"}]},{"characterId":"char_c18063","characterName":"西原 文子","sourceIds":{"bangumi":[{"characterId":"92496","match":"exact-normalized-name-in-linked-work","subjectId":"73416"}],"egsCharacterIds":["17992"],"vndbCharacterId":"c18063"},"originalCharacterName":"西原 文子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"25"},"bust":{"reviewState":"no-conflict","sou