vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"恵と同じく、日本代表の女子バレー選手。"},{"spoiler":false,"text":"生真面目で小心者、ネガティブすぎる面があり、恵と仲が良いが、比べられることを内心気にしている。"},{"spoiler":false,"text":"「勝てなくてもいいんです。ただ……負けたくないんです！」"}],"source":"egs","sourceCharacterId":"17986","sourceWorkId":"10982","spoiler":false},{"segments":[{"spoiler":false,"text":"少女時代のすべてをバレー中心に過ごし、恵と同じく日本代表の女子バレー選手に選ばれた。"},{"spoiler":false,"text":"ポジションはリベロ。世界大会での結果を期待されているが、ルームメイトでもある恵を意識しすぎて調子を崩し、コーチにたびたび相談していた。"},{"spoiler":false,"text":"そんな折、真菜はシャワールームで交わる主人公と恵の声を聞いてしまう。驚き慌てふためいて主人公の元に怒鳴り込んでくる真菜だが、逆に主人公のマッサージによって返り討ちにあってしまう。"}],"source":"bangumi","sourceCharacterId":"92490"}],"profileFacts":[{"label":"体型","source":"bangumi","sourceCharacterId":"92490","value":"なかなかのグラマー"},{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"17986","sourceWorkId":"10982","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"17986","sourceWorkId":"10982","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"17986","sourceWorkId":"10982","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/1319611ee6810b0df4e83f94730bd18e08c1537de513bb469ed943b7a2d354d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/828523de47ce77bf60efb98c8dc0156553bec2621a1916d89209c5085de6ff31.webp","width":104,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:73416:92490:8055:1","source":"bangumi"}]},{"characterId":"cha