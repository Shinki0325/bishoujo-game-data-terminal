b:vn-staff:67614","source":"vndb"},{"creditedName":"神代 あみ","creatorId":"vndb:s2886","sourcePersonId":"vndb:s2886","canonicalEntityId":"vndb:s2886","name":"神代 あみ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:67616","source":"vndb"},{"creditedName":"ぼみ","creatorId":"vndb:s6933","sourcePersonId":"vndb:s6933","canonicalEntityId":"vndb:s6933","name":"ぼみ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:67618","source":"vndb"},{"creditedName":"梺乃 命","creatorId":"vndb:s7332","sourcePersonId":"vndb:s7332","canonicalEntityId":"vndb:s7332","name":"梺乃 みこと","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:67620","source":"vndb"},{"creditedName":"梺乃 命","creatorId":"vndb:s7332","sourcePersonId":"vndb:s7332","canonicalEntityId":"vndb:s7332","name":"梺乃 みこと","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:67623","source":"vndb"}]},"cast":[{"characterId":"char_c42519","characterName":"桐宮 乃愛","sourceIds":{"bangumi":[{"characterId":"48004","match":"exact-normalized-name-in-linked-work","subjectId":"197203"}],"egsCharacterIds":["19556"],"vndbCharacterId":"c42519"},"originalCharacterName":"桐宮 乃愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"剣術は達人、反射神経も抜群という万能美少女。"},{"spoiler":false,"text":"異世界から逃がされ、主人公とは幼馴染の関係で育った。"},{"spoiler":false,"text":"恋愛に関しては“超”がつくほどの奥手で、キスどころか、オナニー経験すらない。"},{"spoiler":false,"text":"主人公に少なからず好意を寄せているが、その性格から、どうしても素直になれない様子。"},{"spoiler":false,"text":"しかし、積極的に迫るフィリアに対し、その対抗心から……。"}],"source":"egs","sourceCharacterId":"19556","sourceWorkId":"9630","spoiler":false},{"segments":[{"spoiler":false,"text":"かつて魔王を倒した勇者と聖女を始祖に持つ、異世界ラインフォースの聖なる王族――その生き残りで地球に逃がされていた現勇者。"},{"spoiler":false,"text":"理想的体型を持ち、剣術をこなし反射神経も抜群の万能美少女。だが、恋愛に関しては奥手で「超」がつくほどの恥ずかしがり屋。"},{"spoiler":false,"text":"そのせいからか表情が引き締まり、周りを寄せ付けないオーラを出してしまっている。"},{"spoiler":false,"text":"唯一、幼馴染の春都とはまともに話しができ、好意を寄せてはいるが、性格からかどうしても素直になれないでいる。"},{"spoiler":false,"text":"ちなみに「処女」でありオナニー経験はおろかまともにキスしたこともない。"},{"spoiler":false,"text":"普段は春都を奴隷扱いしているが、Hとなるととたんに受身になる。ただし春都にせまるフィリア達に対しては照れながらも対抗心を剥き出しに。"}],"source":"bangumi","sourceCharacterId":"48004"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/acd66c24d22cdfb041fa5508564fbfcd0db2429bad85977573011468907c06eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2878e4d06469eca29cc9f7d12b69393c27dfb028498fe75217b63a5f11cbdda.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197203:48004:5906:1","source":"bangumi"}]},{"characterId":"char_c42522","characterName":"サーラン","sourceIds":{"bangumi":[{"characterId":"48006","match":"exact-normalized-name-in-linked-work","subjectId":"197203"}],"egsCharacterIds":["19558"],"vndbCharacterId":"c42522"},"originalCharacterName":"サーラン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人間と魔族のハーフで、異世界“ラインフォース”の大魔導師。"},{"spoiler":false,"text":"常に沈着冷静で、ノアたちにとっては頼れるお姉さん的存在。"},{"spoiler":false,"text":"道しるべとなるヒントをよくくれるのだが、恋愛に関しては、とんでもないことをノアたちに吹き込む、イタズラ好きな一面も見せる。"},{"spoiler":false,"text":"普段はマイペースの彼女だが、ひと度“お肌”の話題に触れると……。"}],"source":"egs","sourceCharacterId":"19558","sourceWorkId":"9630","spoiler":false},{"segments":[{"spoiler":false,"text":"人間と魔族のハーフで異世界ラインフォースの大魔導士。"},{"spoiler":false,"text":"「困った時のサーラン頼み」と言われるほど頼れる相談役のお姉さん。"},{"spoiler":false,"text":"春都達が困難にぶつかった際に、直接答えを出してはくれないが道しるべとなるヒントを出してくれる。"}],"source":"bangumi","sourceCharacterId":"48006"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16f08d174552c978726a8905bf260e1519f591b611362561f259efcdaab7ed98.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86d8b067ca956db8a3c933763e56d64582ace659841190e3d711ae5f8e25f053.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197203:48006:4956:1","source":"bangumi"}]},{"characterId":"char_c42523","characterName":"メルフィス","sourceIds":{"bangumi":[{"characterId":"48007","match":"exact-normalized-name-in-linked-work","subjectId":"197203"}],"egsCharacterIds":["19559"],"vndbCharacterId":"c42523"},"originalCharacterName":"メルフィス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔王側の人物で「魔将」と呼ばれる将軍。"},{"spoiler":false,"text":"魔王ギルの最後を見届けるために、こちらの世界にやってきた。"},{"spoiler":false,"text":"真面目で規律、約束を重んじる義理堅い武人で、やや癖はあるものの、敵意や悪意は感じさせない高潔な人物。"},{"spoiler":false,"text":"主人公が元に戻るために魔王の力を得る際、ノアたちと対峙することに……？"}],"source":"egs","sourceCharacterId":"19559","sourceWorkId":"9630","spoiler":false},{"segments":[{"spoiler":false,"text":"ギルウィンドの本来の性格や心を知る、魔将と呼ばれる将軍の一人。"},{"spoiler":false,"text":"謎はあるが、敵意や悪意を感じない高潔な人物。"},{"spoiler":false,"text":"とても真面目で、規律や約束を重んじ義理堅い「武人」のような性格をしている。"},{"spoiler":false,"text":"ギルの最期を見届けるために異世界よりやってくる。"}],"source":"bangumi","sourceCharacterId":"48007"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/054112cef701a40a04e12d904877a2e12f91660248fc9b53d4016931348b1ec0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99b9a4148a02c88ce5edb94d71c1da882c76afbb4748bfc778bc7e2e7d63a039.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197203:48007:5741:1","source":"bangumi"}]},{"characterId":"char_c42524","characterName":"クレア","sourceIds":{"bangumi":[{"characterId":"48008","match":"exact-normalized-name-in-linked-work","subjectId":"197203"}],"egsCharacterIds":["19560"],"vndbCharacterId":"c42524"},"originalCharacterName":"クレア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"かつて魔王に保護され、その恩義からお付きのメイドとして仕えていたエルフの少女。"},{"spoiler":false,"text":"面倒見の良い保母さんタイプだが、実は、魔王が所有していた“エッチな道具”の管理を任されたエロエロ姉さんな一面も。"},{"spoiler":false,"text":"メルフィス同様、魔王の最後を見届けるためやってきたのだが……？"}],"source":"egs","sourceCharacterId":"19560","sourceWorkId":"9630","spoiler":false},{"segments":[{"spoiler":false,"text":"かつてのギルウィンドに保護されたというエルフの少女。"},{"spoiler":false,"text":"そのことに恩義を感じてお付のメイドとして遣えていた。"},{"spoiler":false,"text":"（実際はギルのかっこよさに惹かれているところもあったとか。）"},{"spoiler":false,"text":"面倒見の良い保母さんのような性格だが、実はものすごいSっ気を持っていたり。"},{"spoiler":false,"text":"春都を追って来た理由はメルフィス同様、ギルの最期を見届けるためだということだが…。"}],"source":"bangumi","sourceCharacterId":"48008"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/