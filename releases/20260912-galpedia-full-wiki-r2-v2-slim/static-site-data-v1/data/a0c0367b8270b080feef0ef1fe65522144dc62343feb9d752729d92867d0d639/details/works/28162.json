{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"28162","model":{"presentationWorkId":"egs:28162","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_76751","characterName":"ラビィ・アルナー","sourceIds":{"bangumi":[{"characterId":"76751","match":"source-roster","subjectId":"240473"},{"characterId":"76751","match":"source-roster","subjectId":"299412"}]},"originalCharacterName":"ラビィ・アルナー","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ラビィ・アルナーはSEQUEL blightのもう一人の主人公的な存在です。"},{"spoiler":false,"text":"ラビィは人当たりのいい性格であり、主人公に対しても友好的です。"},{"spoiler":false,"text":"惚けたようなことも言いますが、基本的にはしっかりしたキャラクターです。"},{"spoiler":false,"text":"しかし残念ながら少々学が浅いところがあり、"},{"spoiler":false,"text":"特に何かを説明するとき、彼女の言葉では不十分なことが多々あります。"}],"source":"bangumi","sourceCharacterId":"76751"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef812ca22bc001d62aa1bd62b69a31cff22fca53cf491efc67f0b0da427bfda2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23a028caf39051bc79d8b3623f0b881ea3af6d971864f0f1bb6173eb331289ff.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_76755","characterName":"偽ラビィ","sourceIds":{"bangumi":[{"characterId":"76755","match":"source-roster","subjectId":"240473"},{"characterId":"76755","match":"source-roster","subjectId":"299412"}]},"originalCharacterName":"偽ラビィ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa1df6b96e8e02dfae76fcf071ec9b05ae14b8b219dfa4e1a0c982d23cc6a07e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00b7992e129d71669d0add1f7ec79da4f3d5d6fa4ee95674d8b7a37111cbed20.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_78171","characterName":"王国の騎士","sourceIds":{"bangumi":[{"characterId":"78171","match":"source-roster","subjectId":"299412"}]},"originalCharacterName":"王国の騎士","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"オーリス・オルデインはアルツェットという国の騎士の女性です。"},{"spoiler":false,"text":"『SEQUEL colony』のシナリオにおいてはシスマを調査するという目的を持ち、それに従ってシスマにやってきています。"},{"spoiler":false,"text":"同じくシスマにやってきている主人公のあなたは現地でオーリスと出会い、共に行動します。"},{"spoiler":false,"text":"あなたへの姿勢"},{"spoiler":false,"text":"オーリスは真面目な人物で、性に消極的です。"},{"spoiler":false,"text":"男性であるあなたを発見してもマナ搾りどうこうよりもまず先に保護することを考えます。"},{"spoiler":false,"text":"故に、ゲーム的な話をすると、今回はゲーム開始早々にシーンが発生しません。"},{"spoiler":false,"text":"シーンの発生に関するお話はまた後日に行いますが、ともあれ、"},{"spoiler":false,"text":"オーリスは過去のメインヒロインと比較すると身持ちが固いです。"},{"spoiler":false,"text":"シーンの傾向"},{"spoiler":false,"text":"そんな堅物のオーリスですので、シーンも嫌々やっているという雰囲気が強いです。"},{"spoiler":false,"text":"……が、そんなものは最初だけです。"},{"spoiler":false,"text":"オーリスのシーンはある種の下品さが特徴となります。"},{"spoiler":false,"text":"全体の流れで見ても、一つ一つのシーンを見ても、"},{"spoiler":false,"text":"最初の内は何やら真面目なことを言って性行為を嫌がりますが、"},{"spoiler":false,"text":"気分が乗ってくると他のキャラクターよりもがっついてくるタイプです。"}],"source":"bangumi","sourceCharacterId":"78171"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/315aadfe0cc95c84e5394247b038a1ba3f698dc13b78ea2324adc98a7badceea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac1687093430266a8213b1fdbb645df07f7bd5a955855c7855e39e0ce3dba31d.webp","width":181,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_78172","characterName":"夜魔の修道女","sourceIds":{"bangumi":[{"characterId":"78172","match":"source-roster","subjectId":"299412"}]},"originalCharacterName":"夜魔の修道女","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"エメルリューラはアルツェットという国に存在する教会に所属する修道女です。"},{"spoiler":false,"text":"エメラはオーリスと同じく何らかの目的を持ちシスマにやってきたようですが、物語の序盤において、その真意を測ることはできません。"},{"spoiler":false,"text":"故に少し謎めいた存在ではありますが、人当たりはよく友好的な人物です。"}],"source":"bangumi","sourceCharacterId":"78172"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/542b9c56eef753e5fa80b8c580c459ff8e71788789095d7e0430d2356d21e6d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea85b63f2d8445d6be9426c886b2c8b878af296bdee05b0a25d3b5797473034d.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_78173","characterName":"盲目の旅人","sourceIds":{"bangumi":[{"characterId":"78173","match":"source-roster","subjectId":"299412"}]},"originalCharacterName":"盲目の旅人","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"レステア・フリエヴェンはオルドワルドを旅する冒険者です。"},{"spoiler":false,"text":"『SEQUEL colony』のシナリオにおいてはシスマの冒険をしていたようで、オーリスと出会った後は彼女の調査の協力を申し出ます。"},{"spoiler":false,"text":"レステアは他の仲間とは異なり、特に目的を持っていません。"},{"spoiler":false,"text":"あくまで冒険の一環として同行することになります。"}],"source":"bangumi","sourceCharacterId":"78173"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9a249d71c809d28a1d4d9b283c6ef729cc5edc80a5ecaf38038cebe0049242d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3110052c205e9613475d909a0f7a064889e7c076e045ac60287bc8560c04ab1.webp","width":192,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:5393","sourceCompanyId":"egs:brand:5393","canonicalEntityId":"egs:brand:5393","name":"リーフジオメトリ","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:28162:5393","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
