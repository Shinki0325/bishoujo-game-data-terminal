e","relationId":"vndb:vn-seiyuu:40145","source":"vndb"}]},{"characterId":"char_vndb_c12924","characterName":"アルサル","sourceIds":{"vndbCharacterId":"c12924"},"originalCharacterName":"アルサル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Arthur is Riannon's older brother and he's very good at sewing, a fact that astonished the House Elves in Avalon Castle. He has the honor as the First Warrior of the Gael Tribe. He is a direct descendant of Elf-King Pwyll, and resembles him in his appearance as well although Limwris the House Elf has some trouble recognizing him as King Pwyll's descendant due to the sudden shock of Arawn coming back to the castle."},{"spoiler":false,"text":"He was led by Arawn to walk the Way of the King. He was also known as the 'small king'. He was Arawn's friend and stayed with him until the war ends."},{"spoiler":false,"text":"The Japanese pronunciation of his name is based on the Welsh name of King Arthur even though his name in English remains the same."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c12924"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c76acc965c7af09b9da3840f9130441892c1ab1d16b3b2f956d6173194afd71.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c68916a1637dc358beb524cfb154a63c650c859a5a99f43296b646185a5d4f7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石井 真","creatorId":"vndb:s1883","sourcePersonId":"vndb:s1883","canonicalEntityId":"vndb:s1883","name":"石井 真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40148","source":"vndb"}]},{"characterId":"char_vndb_c12925"