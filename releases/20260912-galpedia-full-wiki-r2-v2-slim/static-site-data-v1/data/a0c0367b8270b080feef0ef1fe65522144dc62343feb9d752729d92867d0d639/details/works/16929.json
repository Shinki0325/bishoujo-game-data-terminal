"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"憧れのお姉さん。"}],"source":"egs","sourceCharacterId":"8746","sourceWorkId":"16929","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・明人の従姉であり、初恋の相手でもある女性。"},{"spoiler":false,"text":"ひと周り年上で、ずっと昔から主人公のことを 「あっくん」 と呼んで可愛がってくれていた。"},{"spoiler":false,"text":"かなりの美人で、男の本能をくすぐらずにはいられない色気を閉じ込めた肉体の持ち主。"},{"spoiler":false,"text":"4年前に夫を交通事故で亡くしてからもずっと薬指の指輪は外さず、夫に操を立て続けている。"},{"spoiler":false,"text":"美人で優しくて、清純で恥ずかしがりやな未亡人。 ……だけど意外にもお酒が大好物。"},{"spoiler":false,"text":"ただ、酔いが回り過ぎるとえっちな気分が盛り上がってしまう性質なので、普段は家でしかお酒を飲まないようにしている。"},{"spoiler":false,"text":"一応、今までにお酒で失敗したことはない。"},{"spoiler":false,"text":"「あっくんが来るんだからお酒には気をつけないと。 でもやっぱり、誰かと一緒に飲むお酒のほうが美味しいのよね。」"}],"source":"bangumi","sourceCharacterId":"46756"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/892e25e639b33c6584e3235f1f7d24701adddbc86ed5acb9d0fa508c5c9da4b9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3bfd5e7e53a24db9473a8a4fec7a40cf080753b56a7a22e10696fdbbc7ed3fb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:65825:46756:6359:1","source":"bangumi"}]},{"characterId":"char_vndb_c37068","characterName":"楢崎 明人","sourceIds":{"vndbCharacterId":"c37068"},"originalCharacterName":"楢崎 明人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metad