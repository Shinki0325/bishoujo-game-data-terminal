ce":"vndb","sourceCharacterId":"c140020"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85577ad99e3d355321a4655f014018ec0ab1ed3cf6d4e8a7deb195aabafee125.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f50644172f07a2f28e3a03bf256d60b79bce12390190d0c6c37e1b077db4fe8d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金田 まひる","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:34182","source":"vndb"}]},{"characterId":"char_vndb_c140021","characterName":"えりか","sourceIds":{"vndbCharacterId":"c140021"},"originalCharacterName":"えりか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She always enjoys making costumes for her sister Ririka. Like Ririka, she’s a trainee witch who came from the magical world of Clarice. In contrast to Ririka, she has a quiet personality. She’s not good at sports and is the typical indoor type. Of course, she’s about the same age too, around 600 years old. She’s good at household chores and sewing, very domestic. Her dream is to become human and be a cute bride. She kindly supports Ririka’s dream of becoming a magical girl by making her costumes."}],"source":"vndb","sourceCharacterId":"c140021"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa41fa70acb0ae8a6b6c35780a25bae34d75870a089abe7da294c680d9f0671b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05b67226a5519c223d05bed30f6f59fa7fff8ab45ea689522bd9d77a3d033ebd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩泉 まい","creatorId":"vndb:s666","sourcePersonId":"vndb:s666","canonicalEntityId":"vndb:s666","name":"岩泉まい(樋口まゆら、樋口まゆ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:34184","source":"vndb"}]},{"characterId":"char_vndb_c140022","characterName":"ありす","sourceIds":{"vndbCharacterId":"c140022"},"originalCharacterName":"ありす","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A prototype created at the Akinose Group’s Android Research Lab by Souji’s father. Currently, she's in the testing phase, living with Souji to collect experiential data. Her codename was difficult to read and understand (Akinose-android type \"LI\" 2nd), so they decided to call her “Alice”. Despite being an android, she’s scatterbrained and clumsy, and she speaks in a slow, drawn-out manner."}],"source":"vndb","sourceCharacterId":"c140022"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46964ed97d65964364cd592dc4f5e51333905fd626681abe507bc7fc3f723247.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/cea2e278f597eb070ffe3d7f292b683db493ca1513100a2b79d602782e99af53.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金田 まひる","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:34183","source":"vndb"}]},{"characterId":"char_vndb_c140023","characterName":"メル","sourceIds":{"vndbCharacterId":"c140023"},"originalCharacterName":"メル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has been dispatched from the Akinose Group's staffing department to serve as Souji's maid. Half American and half German, this mix is reflected in her manner of speaking. Her personality is bright and cheerful. She somewhat gives off a troublemaker vibe, but she excels not only in her role as a maid but also in maintaining Alice. She prefers to be called \"Mel\", and therefore, Souji addresses her that way while she calls him \"Master\" in a maid-like manner."}],"source":"vndb","sourceCharacterId":"c140023"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e60a7ceed761283fb3100fa805b1a7e175a86a42d66c6d458b93f5f35edef85c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0ea2ea0d836bff31cfe3cb0bffc739ae637a06d61d454009396ad046e15f5aa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬 未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:34181","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:701","sourceCompanyId":"egs:brand:701","canonicalEntityId":"egs:brand:701","name":"萌。","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:4809:701","source":"egs"},{"companyId":"vndb:p1632","sourceCompanyId":"vndb:p1632","canonicalEntityId":"vndb:p1632","name":"萌。","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:13784:v5959","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-r