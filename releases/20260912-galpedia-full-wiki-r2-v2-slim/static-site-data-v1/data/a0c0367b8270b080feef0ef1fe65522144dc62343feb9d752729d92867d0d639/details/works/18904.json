":false,"text":"行動は粗暴で荒いが根は箱入り娘で初心な乙女。"},{"spoiler":false,"text":"ただし柄でもないと自身でそれを否定、押し殺そうとしている。"}],"source":"egs","sourceCharacterId":"547","sourceWorkId":"18904","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の誰もが恐れる勝気なヤンキー娘。"},{"spoiler":false,"text":"その美貌は誰もが認めるものの、告白などしようものなら殺されると畏怖されている。"},{"spoiler":false,"text":"元はお嬢様だったが、家族の不和に反発しヤンキーになった。"},{"spoiler":false,"text":"ただヤンキーといっても硬派であり、男気・誠実さを大切にし、ヤンキー仲間からも慕われている。"},{"spoiler":false,"text":"行動は粗暴で荒いが、根は箱入り娘で初心な乙女。 ただし柄でもないと自身でそれを否定し、押し殺そうとしている。"}],"source":"bangumi","sourceCharacterId":"205287"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b61723bbf807b863583edf819204cced73872cb906c6f076963b9b63a0d36b3d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/2565a6772990826e64dd936e81854ca577e9568365d7a1c053ea0ba18ee79783.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c19697","characterName":"清水 潤","sourceIds":{"vndbCharacterId":"c19697"},"originalCharacterName":"清水 潤","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p314","sourceCompanyId":"egs:brand:2093","canonicalEntityId":"vndb:p314","name":"Norn","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:18904:2093","source":"egs"},{"companyId":"vndb:p314","sourceCompanyId":"vndb:p314","canonicalEntityId":"vndb:p314","name":"Norn","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:30976:v12493","source":"vndb"},{"companyId":"vndb:p314","sourceCompanyId":"vndb:p314","canonicalEntityId":"vndb:p314","name":"Norn","roleCodes":