s":"source-native","relationId":"vndb:vn-staff:9337","source":"vndb"}]},"cast":[{"characterId":"char_c36424","characterName":"九門 克綺","sourceIds":{"bangumi":[{"characterId":"10619","match":"exact-normalized-name-in-linked-work","subjectId":"2075"}],"egsCharacterIds":["12219"],"vndbCharacterId":"c36424"},"originalCharacterName":"九門 克綺","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本編の主人公。"},{"spoiler":false,"text":"他人への共感能力を持っていない少年。"},{"spoiler":false,"text":"他人がどう思うかがよくわからず、また、あまり気にすることがない。"},{"spoiler":false,"text":"思ったことをそのまま言う。"},{"spoiler":false,"text":"いわゆる「空気を読む」ことが全くできない人間。"},{"spoiler":false,"text":"平凡な日常を送っていたが、イグニスをはじめとする闇の領域に棲まう者たちとの出会いをきっかけに、人外の世界に足を踏み入れることになる。"}],"source":"egs","sourceCharacterId":"12219","sourceWorkId":"5116","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/7617be28d2ce032ada72f7956e706ae58febf8eaf8507121f0ce9b35050e2f47.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e187eb9c2f0564c941e8a1233281b77f8bbbf364371ab78ec9c01f9bd7605332.webp","width":212,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水島大宙","creatorId":"vndb:s52","sourcePersonId":"vndb:s52","canonicalEntityId":"vndb:s52","name":"水島 大宙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2075:10619:4260:1","source":"bangumi"}]},{"characterId":"char_c36425","characterName":"風のうしろを歩むもの","sourceIds":{"bangumi":[{"characterId":"10622","match":"exact-normalized-name-in-linked-work","subjectId":"2075"}],"egsCharacterIds":["26637"],"vndbCharacterId":"c36425"},"originalCharacterName":"風のうしろを歩むもの","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"信濃山中に棲まう人狼の一族【草原の民】の少女。"},{"spoiler":false,"text":"天然ボケでお人好し。"},{"spoiler":false,"text":"他人を疑わず自分が裏切られても気にしない。"},{"spoiler":false,"text":"命を大切にするが、仲間のためならば自分の命を失うことも厭わない強い心を持つ優しいサムライ。"},{"spoiler":false,"text":"ただし、普段はただの怠け者に見える。"},{"spoiler":false,"text":"風を操る能力を持ち、名前の通り風を全く乱さずに移動・攻撃することができる。"}],"source":"egs","sourceCharacterId":"26637","sourceWorkId":"5116","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94fbf073af4a77d59dd889d6dfc0932672405e6e6e7bb1e33585f57ae2d31749.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbd322edfa7770f2a5a081ba3c96a707cf43d6c2755cf5d27b4379f0583eebcf.webp","width":222,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2075:10622:5020:1","source":"bangumi"}]},{"characterId":"char_c36426","characterName":"イグニス","sourceIds":{"bangumi":[{"characterId":"10620","match":"exact-normalized-name-in-linked-work","subjectId":"2075"}],"egsCharacterIds":["26636"],"vndbCharacterId":"c36426"},"originalCharacterName":"イグニス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公・克綺の前に現れ、"},{"spoiler":false,"text":"闇の世界の理を教える魔物狩りの女。"},{"spoiler":false,"text":"「人類の守護者」を名乗る。"},{"spoiler":false,"text":"魔力を持たぬ人間の身でありながら、"},{"spoiler":false,"text":"その機知と腕前で「固陋（ころう）な伝統主義者」と軽蔑する魔物たちを次々と狩る。"},{"spoiler":false,"text":"自分の能力と立場を自覚していない克綺に接近し、他の魔物から彼を守り、鍛え上げようとする。"}],"source":"egs","sourceCharacterId":"26636","sourceWorkId":"5116","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c0fd8f5486cee694344f479e1e5fe442f2fe2eab4063f6cd339f70527c36d38.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/1838dee448bb75176c2fffd649b1c011d5d6de48bc626e7d51e368f3c2744ba7.webp","width":145,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤静","creatorId":"vndb:s516","sourcePersonId":"vndb:s516","canonicalEntityId":"vndb:s516","name":"伊藤 静","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:2075:10620:4272:1","source":"bangumi"}]},{"characterId":"char_c36427","characterName":"最も古い祈り","sourceIds":{"bangumi":[{"characterId":"10623","match":"exact-normalized-name-in-linked-work","subjectId":"2075"},{"characterId":"119428","match":"exact-normalized-name-in-linked-work","subjectId":"392451"}],"egsCharacterIds":["24221","26638"],"vndbCharacterId":"c36427"},"originalCharacterName":"最も古い祈り","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"平均くらい"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"夕凪荘の管理人さん。"},{"spoiler":false,"text":"本人によると「S級の管理力」を持つらしい。"},{"spoiler":false,"text":"夕凪荘は建物自体は古いものの、管理人さんのS級の管理力によって、庭も含めて隅々まで管理されている。"},{"spoiler":false,"text":"彼女としては、そうして、自分のアパートを管理するだけでも、充分満足だったのだが…。"},{"spoiler":false,"text":"──男性を管理したい。そんな密かな願望があることも、否定できなかった。"},{"spoiler":false,"text":"アパートを探しにやって来た、主人公の顔を一目見たとき──その密かな願望を、いつになく刺激される。"},{"spoiler":false,"text":"なお、本名は「蜷川さくら」というが、本人は管理人さんと呼ばれるほうを好む。"}],"source":"egs","sourceCharacterId":"24221","sourceWorkId":"329