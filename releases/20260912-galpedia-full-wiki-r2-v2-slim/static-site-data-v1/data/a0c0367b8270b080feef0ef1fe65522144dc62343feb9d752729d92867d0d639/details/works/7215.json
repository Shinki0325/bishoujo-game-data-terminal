ments":[{"spoiler":false,"text":"She is always a calm and easy-going schoolgirl. She has been working part-time as a waitress at a coffee shop called “Lamp Eye.\""},{"spoiler":false,"text":"She is a bit naive, easily fooled by lies, and often takes them seriously. She always receives confessions of love but turns them down easily because she's an airhead."},{"spoiler":false,"text":"She is best friends with Nagisa who is worried about her naivete, but it seems that she takes care of Nagisa much more often than not."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c67782"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98d004af8d5eaf6609943531fc56ab09b55c4fc513f8b13bd66f1438236591cd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d48eb8354442b4aead9b6020a17a22c8928b074de8747b61d8555830ce171f62.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"秋月 まい","creatorId":"vndb:s657","sourcePersonId":"vndb:s657","canonicalEntityId":"vndb:s657","name":"谷井 あすか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15788","source":"vndb"}]},{"characterId":"char_vndb_c67783","characterName":"五島 雫","sourceIds":{"vndbCharacterId":"c67783"},"originalCharacterName":"五島 雫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a university student who attends the same university as the main character. Since they have known each other since childhood, she is like a caretaker to the main character."},{"spoiler":false,"text":"She is always a cool beauty with a keen eye. She used to have a complex about her small breasts, but now she is often admired for her big breasts."},{"spoiler":false,"text":"She has a firm tone of voice like a female commander and a very coercive tone towards the main character. She also isn't afraid of getting physical if need be."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c67783"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af6aa9db4843efaadb6316f30b1add948c33694dfb59d75163f0375e71f791d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/525f0c17ec0cd0506c0a1776389ead6788b63a259524769964bd63bdbee0423d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"五行 なずな","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15787","source":"vndb"}]},{"characterId":"char_vndb_c67784","characterName":"深田 律子","sourceIds":{"vndbCharacterId":"c67784"},"originalCharacterName":"深田 律子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main character's female friend, a mad pharmacist who frequents the university's lab. She is the developer of the hypnotic drug."},{"spoiler":false,"text":"She works as a waitress to help out her friend and offers up her own body to better understand the effects of the drug she created."},{"spoiler":false,"text":"Although Ritsuko is a beautiful woman, she has no interest in anything other than her research and has seemingly discarded her"},{"spoiler":false,"text":"Of course, this lead to her having no sense of shame when around the main character. It's also difficult to discern what is she is thinking as she always has something else on her mind."},{"spoiler":false,"text":"However, when she's lucid, she can become a very seductive woman who exudes pheromones."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c67784"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87fb8f89ef2dbc024c689c3e1e71f0e9784d983ca1d29a0a01389b267dff3e3d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d515ae035fc6ace8cd563e9ff754bd2ba2ab25d7110c927854f45a27b326c21.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春奈 有美","creatorId":"vndb:s1634","sourcePersonId":"vndb:s1634","canonicalEntityId":"vndb:s1634","name":"木川 絵理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15789","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p339","sourceCompanyId":"egs:brand:557","canonicalEntityId":"vndb:p339","name":"West Vision","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:7215:557","source":"egs"},{"companyId":"vndb:p339","sourceCompanyId":"vndb:p339","canonicalEntityId":"vndb:p339","name":"ウェストビジョン","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:4515:v1943","source":"vndb"},{"companyId":"vndb:p339","sourceCompanyId":"vndb:p339","canonicalEntityId":"vndb:p339","name":"ウェストビジョン","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:4516:v1943","source":"vndb"},{"companyId":"vndb:p339","sourceCompanyId":"vndb:p339","canonicalEntityId":"vndb:p339","name":"ウェストビジョン","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:52805:v1943","source":"vndb"},{"companyId":"vndb:p339","sourceCompanyId":"vndb:p339","canonicalEntityId":"vndb:p339","name":"ウェストビジョン","roleCodes":["