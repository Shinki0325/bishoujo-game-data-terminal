e,"text":"主人公が母親のことを好きなのではないかと感付いて、いじらしくアタックしてくる。"}],"source":"bangumi","sourceCharacterId":"52083"}],"profileFacts":[{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"1413","sourceWorkId":"17202","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"1413","sourceWorkId":"17202","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"1413","sourceWorkId":"17202","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"1413","sourceWorkId":"17202","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"48 kg","valueContext":null,"source":"egs","sourceCharacterId":"1413","sourceWorkId":"17202","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e6f6b77ffbd1b3a5516c4952bbcc721290ce9a1326b8a431b4eff3e0ba5391d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60e2bfad0d5b13006a97385f0f7a671d20369ccbf71e6edfd001e6d587d17a01.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石松千恵美","creatorId":"vndb:s1164","sourcePersonId":"vndb:s1164","canonicalEntityId":"vndb:s1164","name":"石松 千恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:89717:52083:4273:1","source":"bangumi"},{"creditedName":"星 りん","creatorId":"vndb:s15423","sourcePersonId":"vndb:s15423","canonicalEntityId":"vndb:s15423","name":"星 りん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:48860","source":"vndb"}]},{"characterId":"char_c33599","characterName":"仁志井 明子","sourceIds":{"bangumi":[{"characterId":"52082","match":"exact-normalized-name-in-linked-work","subject