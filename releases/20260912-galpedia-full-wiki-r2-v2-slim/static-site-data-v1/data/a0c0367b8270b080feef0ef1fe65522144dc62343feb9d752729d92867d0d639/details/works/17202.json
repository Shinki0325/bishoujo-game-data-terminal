d":"1412","sourceWorkId":"17202","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"1412","sourceWorkId":"17202","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"55 kg","valueContext":null,"source":"egs","sourceCharacterId":"1412","sourceWorkId":"17202","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/8910bfdf7d9b2f6cd96e523bc9af771ac298d5be939627a60e5f48debe175b36.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bff61ab64538d77fefa76d8d668772b710c4918898d1fd707be9cc026f790f1f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"平野響子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:89717:52082:5669:1","source":"bangumi"}]},{"characterId":"char_c33600","characterName":"杜屋 希美","sourceIds":{"bangumi":[{"characterId":"52081","match":"exact-normalized-name-in-linked-work","subjectId":"89717"}],"egsCharacterIds":["1411"],"vndbCharacterId":"c33600"},"originalCharacterName":"杜屋 希美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"103"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"61"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"女手一つで主人公を育ててきた優しい母。"},{"spoiler":false,"text":"主人公に性の対象として見られる事で、自身の性欲と主人公への深い愛情に気づいてしまう。"},{"spoiler":false,"text":"元々は家柄の良いお嬢様。財産は多少あるものの、生活費や養育費は自分で稼いだお金から出している。"},{"spoiler":false,"text":"息子が大きくなりようやく一息つけそうだと思っているが、さびしくも感じている。"},{"spoiler":false,"text":"むっちりした大人の身体にまだ若々しい外見から言い寄られることが多いが、息子を理由に断り続けている。"},{"spoiler":false,"text":"※苗字はユーザー任意で変更可能です。"}],"source":"egs","sourceCharacterId":"1411","sourceWorkId":"17202","spoiler":false},{"segments":[{"spoiler":false,"text":"女手ひとつで主人公を育ててきた優しい母親。"},{"spoiler":false,"text":"大きな病気や事故もなく息子を育ててきたことを少し誇りに思っていて、そのまま何事もなく幸せになることを一番に望んでいる。"},{"spoiler":false,"text":"元々は家柄の良いお嬢様で、姿勢が良く健康的な身体をしている。"},{"spoiler":false,"text":"貯蓄は多少あるのだがそれには手を付けず、生活費や養育費は自分で稼いだお金から出している。"},{"spoiler":false,"text":"息子に性の対象として見られることで、自身の性欲と主人公へのより深い愛情に気付き始め、少しずつ主人公に身体を許していってしまう。"}],"source":"bangumi","sourceCharacterId":"52081"}],"profileFacts":[{"label":"胸围（本版本）","value":"103 cm","valueContext":null,"source":"egs","sourceCharacterId":"1411","sourceWorkId":"17202","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"1411","sourceWorkId":"17202","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"1411","sourceWorkId":"17202","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"1411","sourceWorkId":"17202","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"57 kg","valueContext":null,"source":"egs","sourceCharacterId":"1411","sourceWorkId":"17202","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88784be776b141ee21d770070f1b86f56c3fda75be81654552f936cb5655acc2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e300eeb970ca6078e403a52b2c24cbb525312b418bcb31466e68ab220306a92e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか