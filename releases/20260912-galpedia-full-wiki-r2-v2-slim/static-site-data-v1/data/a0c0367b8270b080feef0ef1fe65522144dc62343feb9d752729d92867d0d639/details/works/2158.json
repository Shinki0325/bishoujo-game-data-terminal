p":{"reviewState":"source-only","source":"vndb","value":"73"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園生御用達の洋食店「branch road」を父親と２人で切り盛りする看板娘。性格は明るくて人見知りせず、礼儀正しいが少々あわてんぼう。学園でも店でも妹のような存在として親しまれている。トレードマークである帽子の耳が弱点らしい。"},{"spoiler":false,"text":"店の常連客でときどき手伝いもしてもくれる主人公のことを兄のように慕っている。"}],"source":"egs","sourceCharacterId":"27524","sourceWorkId":"2158","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公達がたまり場として使っているレストラン『branch road』の一人娘。"},{"spoiler":false,"text":"明るく元気、少々慌てん坊。みんなからは世話を焼かせる妹のような存在で見られている。"}],"source":"bangumi","sourceCharacterId":"144997"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef76f3097cd597836ec2164723ba648b63b9a9294bee046d27dc9ed1973aa8cb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/3722c2a72fec813f3d4246dcf085aceeb4e10666538abaecc7e07d85e8ccaead.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"嶋崎はるか","creatorId":"vndb:s1013","sourcePersonId":"vndb:s1013","canonicalEntityId":"vndb:s1013","name":"嶋崎 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99072:144997:6302:1","source":"bangumi"}]},{"characterId":"char_c11633","characterName":"霧島 水帆","sourceIds":{"bangumi":[{"characterId":"144995","match":"exact-normalized-name-in-linked-work","subjectId":"99072"}],"egsCharacterIds":["27520"],"vndbCharacterId":"c11633"},"originalCharacterName":"霧島 水帆","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A sports fan, honor student, and all-around seemingly perfect girl. She transferred from a school in Tokyo."}],"source":"vndb","sourceCharacterId":"c11633"},{"segments":[{"spoiler":false,"text":"都会から転入してきた、容姿端麗・頭脳明晰・スポーツ万能の優等生。美術部に所属。人当たりも良く、またたく間にクラスに溶けこんでしまう。"},{"spoiler":false,"text":"趣味はスポーツ観戦で、特にバスケットボールは雑誌を定期購読しているほど大好きらしい。ただ格闘技だけは好きになれないようだ。"}],"source":"egs","sourceCharacterId":"27520","sourceWorkId":"2158","spoiler":false},{"segments":[{"spoiler":false,"text":"都会から転入してきた少女。本来ならば馴染みがたい都会からの余所者だというのにも関わらず、数日の間にクラスメイトと打ち解けてしまった。"},{"spoiler":false,"text":"文武両道にして才色兼備と、非の打ち所のない。優秀な生徒、自慢できる友達がもっぱらの評判。"}],"source":"bangumi","sourceCharacterId":"144995"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99748622e3008bd73f947a3fe2dd444912cbd6ce165368936ad7c034c12a7158.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efa74fa27546fdf2fcc95e3596e2845f298f776f2cc809bda5ffc6212c3d4092.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"萩原えみこ","creatorId":"vndb:s867","sourcePersonId":"vndb:s867","canonicalEntityId":"vndb:s867","name":"萩原 えみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99072:144995:4854:1","source":"bangumi"}]},{"characterId":"char_c11638","characterName":"河原崎 春","sourceIds":{"bangumi":[{"characterId":"144996","match":"exact-normalized-name-in-linked-work","subjectId":"99072"}],"egsCharacterIds":["27521"],"vndbCharacterId":"c11638"},"originalCharacterName":"河原崎 春","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A tomboy who plays on the girl's basketball team."}],"source":"vndb","sourceCharacterId":"c11638"},{"segments":[{"spoiler":false,"text":"運動神経が抜群で、女子バスケットボール部のキャプテンを務める。中学のころから主人公たちとつるんできた悪友にして親友で、バスケを失った主人公に気を遣いながらもいつもと変わらない態度で接してくれる。友だち思いの良い子。"},{"spoiler":false,"text":"ただ勉強は苦手で、彼女がモットーとする「努力・根性・鍛錬」も通じないらしい。"}],"source":"egs","sourceCharacterId":"27521","sourceWorkId":"2158","spoiler":false},{"segments":[{"spoiler":false,"text":"元気、ガサツ、○○的――、とボーイッシュな要件をほぼ満たしている少女。主人公の同級生で、部活は女子バスケットボール部に所属。"},{"spoiler":false,"text":"強豪チームの要として活躍。さらに、父親の影響から中国拳法を身につけている。その腕は師範代クラスとか。努力・根性・鍛錬で何とかなるのだという、生粋の根性論者。"}],"source":"bangumi","sourceCharacterId":"144996"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/573aac0ab758793f3f4a8bc82b0a8942e45a94e63ac0bb6384404fcb36f56c57.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3bc5c28c28e577009f59bc9d264a5b54988c4da7c2d4374caa2ed9e35e09fc56.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"笹島かほる","creatorId":"vndb:s1017","sourcePersonId":"vndb:s1017","canonicalEntityId":"vndb:s1017","name":"笹島 かほる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99072:144996:3944:1","source":"bangumi"}]},{"characterId":"char_c11639","characterName":"朝凪 鈴子","sourceIds":{"bangumi":[{"characterId":"144998","match":"exact-normalized-name-in-linked-work","subjectId":"99072"}],"egsCharacterIds":["27522"],"vndbCharacterId":"c11639"},"originalCharacterName":"朝凪 鈴子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼なじみで学園のひとつ先輩。性格は温厚すぎるほど温厚でマイペース過ぎるほどマイペース。他人の言うことを素直に信じてしまうので、年上なのに手のかかる妹のような存在。"},{"spoiler":false,"text":"弓道部に所属しており、物心ついたときからたしなんできた弓の腕はすでに達人の域に達しているらしい。"}],"source":"egs","sourceCharacterId":"27522","sourceWorkId":"2158","spoiler":false},{"segments":[{"spoiler":false,"text":"お淑やか過ぎるほどお淑やかで、おっとりし過ぎるほどおっとりした性格の大和撫子。"},{"spoiler":false,"text":"弓道部に所属しその腕前は相当なもの。が、弓道以外の運動神経はないに等しい。見た目、学力も優秀に見られるが意外なまでに普通の成績。"},{"spoiler":false,"text":"日向家(主人公の家)と朝凪家とは十年来家族ぐるみの付き合いをしている仲。年齢的にお姉さんのような存在であるはずが、その持ち前の性格から、立場が逆転してしまっている。"}],"source":"bangumi","sourceCharacterId":"144998"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b7e0733298a3c4e121b3cdeacdcae4228ebd4edf55e764a870a44bb988bf060.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc4b8af91eb59aa4aad13cbbfa0fdd7e73723d50228fbc4ea58f6297d11748a9.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"如月美琴","creatorId":"vndb:s1012","sourcePersonId":"vndb:s1012","canonicalEntityId":"vndb:s1012","name":"如月 美琴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99072:144998:6217:1","source":"bangumi"}]},{"characterId":"char_c11647","characterName":"日向 なずな","sourceIds":{"bangumi":[{"characterId":"144999","match":"exact-normalized-name-in-linked-work","subjectId":"99072"}],"egsCharacterIds":["27523"],"vndbCharacterId":"c11647"},"originalCharacterName":"日向 なずな","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"76"},"hip":{"reviewState":"source-only","source":"vndb","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"両親を交通事故で失い、遠縁にあたる主人公の家に引き取られてきた義妹。口数は少なく、冷たい印象を与えるためか友人は少ない。学園での成績はトップクラスで、法曹関係の職業を目指しているらしい。"},{"spoiler":false,"text":"事故直後は心を閉ざしていたが、過去のある事件から主人公を慕うようになっていた。だが、主人公がバスケを止めた後からは、再び関係に亀裂が生じている。"}],"source":"egs","sourceCharacterId":"27523","sourceWorkId":"2158","spoiler":false},{"segments":[{"spoiler":false,"text":"8年前、交通事故によって両親を亡くすも彼女だけは軽傷で済んだ。その後、遠縁にあたる日向家に引き取られ、養子となる。"},{"spoiler":false,"text":"引き取られた当初は部屋の中で独り、家の誰ともうち解けようとはしなかった。彼女が初めて少女らしい笑顔を見せたのは、日向家に引き取られた数ヶ月後の夏休み。旅行先での“事故”の際、主人公に命を助けられた（と彼女自身は大袈裟に考えている）彼女は閉ざしていた心を融解させ、主人公と新しい家族を心から信頼できるようになる。本来の彼女は、明るく活発な少女だったのだ。"}],"source":"bangumi","sourceCharacterId":"144999"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/754dff00a23bb5809c5f7282a5a72f99b674c8902943df0fc31463f2a6ef605e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d30f1ce60e262039acca8efd07df3a7c6ce17f34841f15661858a323d2b7e60.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99072:144999:4937:1","source":"bangumi"}]},{"characterId":"char_c11656","characterName":"葉月 みりあ","sourceIds":{"bangumi":[],"egsCharacterIds":["27525"],"vndbCharacterId":"c11656"},"originalCharacterName":"葉月 みりあ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"27"},"bust":{"reviewState":"source-only","source":"vndb","value":"67"},"hip":{"reviewState":"source-only","source":"vndb","value":"68"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A teacher of World History who appears much younger. She hates being treated like a child."}],"source":"vndb","sourceCharacterId":"c11656"},{"segments":[{"spoiler":false,"text":"外見はロリっ娘だが、御年２７歳になる主人公たちの担任教師。担当は世界史。愛らしい容姿に加え、わかりやすい授業内容、わけへだてない態度で、学生からは「みりあ先生」と慕われている。"},{"spoiler":false,"text":"自分の幼い容姿を気にしており、教師の威厳を示そうといつも努力しているが…好きなことは頭をなでられること。"}],"source":"egs","sourceCharacterId":"27525","sourceWorkId":"2158","spoiler":false}],"profileFacts":[{"label":"年龄（本版本）","value":"27 岁","valueContext":null,"source":"egs","sourceCharacterId":"27525","sourceWorkId":"2158","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe1df19da15176568a6fe19606670af560b3c588ac67ee4002604a0645ac407d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/652d81ab559c681507e01ef3f7fcd4d8569aae14805933d46dba3a24ab82e845.webp","width":231,"height":256,"source":"static-detail"},"actors":[{"creditedName":"芹園 みや","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5476","source":"vndb"}]},{"characterId":"char_vndb_c11640","characterName":"日向 和真","sourceIds":{"vndbCharacterId":"c11640"},"originalCharacterName":"日向 和真","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-