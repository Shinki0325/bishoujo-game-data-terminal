{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"35627","model":{"presentationWorkId":"vndb:v46867","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c133293","characterName":"Inari Kon","sourceIds":{"vndbCharacterId":"c133293"},"originalCharacterName":"Inari Kon","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kon puts up a prideful appearance to mask her naïve and clumsy nature. She lacks any sexual knowledge so she’s often stunned by your… unique kinks."},{"spoiler":false,"text":"After splitting from the Nine-Tailed Fox Spirit, she drifted here and there before arriving in Japan."},{"spoiler":false,"text":"Kon feeds on human”energy”. She does so by signing pacts with humans, fulfilling their wishes, and taking their “energy” in return. Sexual intercourse is not a requirement for energy transmission so she has remained a virgin."},{"spoiler":false,"text":"After breaking out from under the “Killing Stone”, Kon appears before you, ready to sign a pact. What’s your next move?"}],"source":"vndb","sourceCharacterId":"c133293"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f9d13a9b048b9e12784e7697e67d542b90ad576992e3be5f740086cadd36ddd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/2386320c586aea7dcdf9ececae8e63c4279bf868d12767af25352f1fa40d256b.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏和小","creatorId":"vndb:s8737","sourcePersonId":"vndb:s8737","canonicalEntityId":"vndb:s8737","name":"藤田 茜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source