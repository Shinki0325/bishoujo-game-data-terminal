{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"19044","model":{"presentationWorkId":"vndb:v10835","staff":{"artwork":[{"creditedName":"トラノタヌキ","creatorId":"vndb:s12260","sourcePersonId":"egs:creator:3619","canonicalEntityId":"vndb:s12260","name":"トラノタヌキ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:119660","source":"egs"}],"scenario":[{"creditedName":"真月光","creatorId":"egs:creator:19129","sourcePersonId":"egs:creator:19129","canonicalEntityId":"egs:creator:19129","name":"真月光","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:119661","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c137717","characterName":"乙音わたる","sourceIds":{"vndbCharacterId":"c137717"},"originalCharacterName":"乙音わたる","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main character. Mihoto, his mother regularly travels overseas for work. Wataru decides not to join his mother and chooses to live with his aunt in a secluded village."},{"spoiler":false,"text":"It has been 4 years since he last saw his aunt. She is his first love and he wishes to prove that he has become more manlier to her. Much to his dismay, his aunt still treats him like an innocent child."},{"spoiler":false,"text":"During his stay he plans to make his aunt acknowledge him as a man. The village traditions will play a large role in redefining his relationship with his aunt, in good and bad ways."},{"spoiler":false,"text":"His family is made up of just his mother and him, he has no father."}],"source":"vndb","sourceCharacterId":"c137717"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6792b2332843dd8872ad0355bb78d0b217b907f45e29ac63799650ef8105c46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a9b29269ccf04a20e3d3e65a3b64dc50a5fdd95915933b0be0f9036db4eeb51.webp","width":256,"height":246,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c137718","characterName":"小山一恵","sourceIds":{"vndbCharacterId":"c137718"},"originalCharacterName":"小山一恵","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the residents of Mekagemura village. Like others, she also carries out the traditional customs of the village. She has a preference for young virgin boys and strikes fear into all the boys of the village because of her aggressive and harsh training."},{"spoiler":false,"text":"She likes to push her duties onto others, especially Hogami, if training involves boys who are not virgins or boys she does not find attractive. She is particularly interested in Wataru for his virgin status and beautiful looks."},{"spoiler":false,"text":"She has secrets that no one in the village knows and is someone that village superstitions warn against."}],"source":"vndb","sourceCharacterId":"c137718"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c38a8ed35de8c27661736aeb9ebb725950391d194ec3a785bf47ed4506bff3b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57e49dfa90ecc32b39cee56549b9def641232946d75a238c2aca0f568bd0756e.webp","width":256,"height":238,"source":"static-detail"},"actors":[{"creditedName":"佐倉 あり","creatorId":"vndb:s6353","sourcePersonId":"vndb:s6353","canonicalEntityId":"vndb:s6353","name":"佐倉 あり","roleCo