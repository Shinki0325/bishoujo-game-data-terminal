474","name":"中村歩","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:134319","source":"vndb"}]},"cast":[{"characterId":"char_c54347","characterName":"ロイ","sourceIds":{"bangumi":[{"characterId":"51319","match":"exact-normalized-name-in-linked-work","subjectId":"194003"}],"egsCharacterIds":["11764"],"vndbCharacterId":"c54347"},"originalCharacterName":"ロイ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A herbalist who is on a journey. A good person who can't say \"no\" if asked. He doesn't stay long in one place."}],"source":"vndb","sourceCharacterId":"c54347"},{"segments":[{"spoiler":false,"text":"物語の主人公。"},{"spoiler":false,"text":"薬草師を生業としており放浪の旅をしている。"},{"spoiler":false,"text":"人が良く、頼まれれば断ることはないが、つかみ所のない飄々とした性格。"},{"spoiler":false,"text":"一所に留まることのない生活を送っており、薬草採取を目的とした旅の途中でヴィルディルンを訪れる。"}],"source":"egs","sourceCharacterId":"11764","sourceWorkId":"22619","spoiler":false},{"segments":[{"spoiler":false,"text":"元は平和な村で育った、明るく元気な少年。"},{"spoiler":false,"text":"しかし理不尽に大切なものを奪われたことから、冷酷な復讐者となる。"},{"spoiler":false,"text":"どのような相手でも、確実に命を奪う若き修羅として、仇である存在の首を虎視眈々と狙う。"}],"source":"egs","sourceCharacterId":"11764","sourceWorkId":"24346","spoiler":false},{"segments":[{"spoiler":false,"text":"薬草師を生業として放浪の旅をしている。"},{"spoiler":false,"text":"人が良く、頼まれれば断ることはないが、掴み所のない飄々とした性格。"},{"spoiler":false,"text":"一所に留まることのない生活を送っており、"},{"spoiler":false,"text":"薬草採取を目的とした旅の途中でヴィルディルンを訪れる。"},{"spoiler":false,"text":"「一人旅をしてれば、荒事の切り抜け方とか、魔物の避け方なんかは身に付くからな」"}],"source":"bangumi","sourceCharacterId":"51319"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50aff13eb2595085bbc6ef8ae2ad93183908da859716c5f6a0c327f14f167f06.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7adadc2039afcb47ac3ce75190b018f39ec3eb3a84b7b76cd47af91539a1f766.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"笹沼晃","creatorId":"vndb:s755","sourcePersonId":"vndb:s755","canonicalEntityId":"vndb:s755","name":"笹沼 尭羅","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:194003:51319:4731:1","source":"bangumi"}]},{"characterId":"char_c55818","characterName":"サリア ブランス","sourceIds":{"bangumi":[{"characterId":"47397","match":"exact-normalized-name-in-linked-work","subjectId":"194003"}],"egsCharacterIds":["11774"],"vndbCharacterId":"c55818"},"originalCharacterName":"サリア ブランス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヴィルディルンの騎士の一人。"},{"spoiler":false,"text":"火竜の襲撃で、何かを失い悲しむ人を少しでも減らせれば、たとえほんの少しでも誰かを守れるようになりたいという想いから騎士になった。"},{"spoiler":false,"text":"大らかで心優しい性格で、物腰も柔らかく人当たりが良い。"},{"spoiler":false,"text":"本来は争いごとを好まないが、守るためならば、剣を抜き、戦うことを厭わない。"},{"spoiler":false,"text":"寂しがり屋で、人恋しがりな一面がある。"}],"source":"egs","sourceCharacterId":"11774","sourceWorkId":"22619","spoiler":false},{"segments":[{"spoiler":false,"text":"ヴィルディルンの騎士の一人。"},{"spoiler":false,"text":"火竜の襲撃で何かを失い悲しむ人を少しでも減らせれば、"},{"spoiler":false,"text":"たとえほんの少しでも誰かを護りたいという思いから騎士になった。"},{"spoiler":false,"text":"大らかで心優しい性格をしており、物腰が柔らかく人当たりも良い。"},{"spoiler":false,"text":"本来は争い事を好まないが、守るためならば剣を抜き、戦うことを厭わない。"},{"spoiler":false,"text":"実は寂しがり屋で、人恋しがりな一面がある。"},{"spoiler":false,"text":"「誰かが傷つくところなんて、見たくないから」"}],"source":"bangumi","sourceCharacterId":"47397"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/246e2bf52417d63ff53892e8bd59a4feb4f625c10a45ab0bd1fddfbebb7e92f4.webp","fallbackUrl":"https://wik