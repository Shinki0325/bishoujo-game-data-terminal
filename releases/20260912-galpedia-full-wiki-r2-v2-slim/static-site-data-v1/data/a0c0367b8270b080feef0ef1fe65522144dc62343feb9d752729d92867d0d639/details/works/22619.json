al-wiki/v1/characters/v1/images/36/366ae1ebc4e69a412d4da9f1b0c4d276f2193f0946fc3cc3687d985b027a0157.webp","width":134,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:194003:47398:4727:1","source":"bangumi"}]},{"characterId":"char_c55820","characterName":"メア ハートレーン","sourceIds":{"bangumi":[{"characterId":"47399","match":"exact-normalized-name-in-linked-work","subjectId":"194003"}],"egsCharacterIds":["11776"],"vndbCharacterId":"c55820"},"originalCharacterName":"メア ハートレーン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヴィルディルンの騎士の一人。"},{"spoiler":false,"text":"物心ついた頃から孤児院で育ち、自分に出来ることで、家族同然の孤児院の子供達を守り、育ててもらった恩を返そうと騎士を志した。"},{"spoiler":false,"text":"幼い容姿とは裏腹に大人びた性格で、物腰も丁寧。"},{"spoiler":false,"text":"孤児院で子供達の世話をしていたため面倒見が良い。"},{"spoiler":false,"text":"人から甘えられる分には良いが、逆に誰かに甘えることが苦手。"}],"source":"egs","sourceCharacterId":"11776","sourceWorkId":"22619","spoiler":false},{"segments":[{"spoiler":false,"text":"ヴィルディルンの騎士の一人。"},{"spoiler":false,"text":"物心ついた頃から孤児院で育ち、自分にできることで"},{"spoiler":false,"text":"家族同然の孤児院の子供たちを守り、育ててもらった恩を返そうと騎士を志した。"},{"spoiler":false,"text":"幼い容姿とは裏腹に大人びた性格で、物腰も丁寧。"},{"spoiler":false,"text":"孤児院で子供たちの世話をしていたためか面倒見が良い。"},{"spoiler":false,"text":"人から甘えられる分には良いが、誰かに甘えることが苦手。"},{"spoiler":false,"text":"「子供たちが少しでも過ごしやすくなれば、私も嬉しいですから」"}],"source":"bangumi","sourceCharacterId":"47399"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3ec5d306b3d1cacf27b6fd90f386f3493b4b9a221d42a866019c2fc80f18e444.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92f71414c6d935bab16ffc4ebdb9f1f0e2f8cb7345bdab7285a2169f00297ccd.webp","width":134,"height":256,"source":"static-detail"},"actors":[{"creditedName":"又吉愛","creatorId":"vndb:s1646","sourcePersonId":"vndb:s1646","canonicalEntityId":"vndb:s1646","name":"又吉 愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:194003:47399:5013:1","source":"bangumi"}]},{"characterId":"char_c55821","characterName":"アレーナ アルセイフ","sourceIds":{"bangumi":[{"characterId":"47400","match":"exact-normalized-name-in-linked-work","subjectId":"194003"}],"egsCharacterIds":["11777"],"vndbCharacterId":"c55821"},"originalCharacterName":"アレーナ アルセイフ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヴィルディルンの騎士の一人。"},{"spoiler":false,"text":"代々優秀な騎士を輩出している名家の出であり、幼い頃から騎士を目指し鍛錬を積みかさねていた。"},{"spoiler":false,"text":"腕前も確かであり、騎士であることに誇りを感じている。"},{"spoiler":false,"text":"さっぱりとして落ち着いた性格。"},{"spoiler":false,"text":"凛とした立ち振る舞いから固い印象を持たれることが多いが、実際には誰が相手でも分け隔てなく接するなど物腰は柔らかい。"},{"spoiler":false,"text":"騎士修行に明け暮れていたため、世間知らずなところがある。"}],"source":"egs","sourceCharacterId":"11777","sourceWorkId":"22619","spoiler":false},{"segments":[{"spoiler":false,"text":"ヴィルディルンの騎士の一人。"},{"spoiler":false,"text":"代々優秀な騎士を輩出している名家の出であり、幼い頃から騎士を目指し鍛錬を積み重ねていた。"},{"spoiler":false,"text":"腕前も確かであり、騎士であることに誇りを感じている。"},{"spoiler":false,"text":"さっぱりとして落ち着いた性格。"},{"spoiler":false,"text":"凛とした立ち振る舞いから固い印象を持たれることが多いが、"},{"spoiler":false,"text":"実際には誰が相手でも分け隔てなく接するなど物腰は柔らかい。"},{"spoiler":false,"text":"騎士修行に明け暮れていたため、世間知らずなところがある。"},{"spoiler":false,"text":"「鍛錬を積み重ね、より強くなり、一人でも多くの民を守ることが私の目標だ」"}],"source":"bangumi","sourceCharacterId":"47400"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/termin