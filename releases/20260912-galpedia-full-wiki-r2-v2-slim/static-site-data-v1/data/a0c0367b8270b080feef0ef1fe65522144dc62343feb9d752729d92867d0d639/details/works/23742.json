Ids":["8681"],"vndbCharacterId":"c49508"},"originalCharacterName":"緒嶋 朱美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"100"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"99"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"68"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Age: 40's"}],"source":"vndb","sourceCharacterId":"c49508"},{"segments":[{"spoiler":false,"text":"小百合の母。"},{"spoiler":false,"text":"『女』の生臭いところをすべてまとめたような、美熟女。"},{"spoiler":false,"text":"理性より感情で動いて、感情に流されて身持ちが緩い、それでいてタフで図太い。"},{"spoiler":false,"text":"温厚で控えめな人柄、相手の話に合わせて聞き役に回り、落ち着いた語り口で相づちうつタイプの女性。"},{"spoiler":false,"text":"おっとりと包容力豊かな雰囲気醸し出しつつ、女の色気を利用することは厭わないし、色気で男を動かすことを悪い事だと思っていない。"},{"spoiler":false,"text":"必要なら枕営業も厭わない、リアリスト。"},{"spoiler":false,"text":"ただし、喜怒哀楽のスイッチが入りやすく、感情に流されやすく、計算ずくで動くのは苦手。"},{"spoiler":false,"text":"自分の嘘に自分でのめり込んでいくタイプ、涙脆く、すぐ相手に同情して、人生流れ流れて苦労するけど、へこたれない。"},{"spoiler":false,"text":"若くしてさゆりを出産。"},{"spoiler":false,"text":"結婚。"},{"spoiler":false,"text":"その後、夫婦生活が破綻してすぐ離婚。"},{"spoiler":false,"text":"以降、ひとりで小百合を育てるために、夜の世界に入り、今は、町外れのスナックのオーナー兼ママ。"},{"spoiler":false,"text":"開業時に、匠磨からかなりのまとまったお金を借りている。"},{"spoiler":false,"text":"そのために、主人公の策謀に巻き込まれていく。"}],"source":"egs","sourceCharacterId":"8681","sourceWorkId":"23742","spoiler":false},{"segments":[{"spoiler":false,"text":"小百合の母。 温厚で控えめな人柄だが、芯の太い女性。"},{"spoiler":false,"text":"若くして出産・離婚を経験し、一人で娘を育てるために夜の世界に入った。"},{"spoiler":false,"text":"女の色気を利用することを厭わず、スナックのオーナー兼ママとして働いている。"},{"spoiler":false,"text":"リアリストだが感情に流されやすく、計算ずくで動くのは苦手。"},{"spoiler":false,"text":"開業時に匠磨から かなりのまとまったお金を借りている。"}],"source":"bangumi","sourceCharacterId":"149306"}],"profileFacts":[{"label":"胸围（本版本）","value":"100 cm","valueContext":null,"source":"egs","sourceCharacterId":"8681","sourceWorkId":"23742","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"8681","sourceWorkId":"23742","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"99 cm","valueContext":null,"source":"egs","sourceCharacterId":"8681","sourceWorkId":"23742","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"68 cm","valueContext":null,"source":"egs","sourceCharacterId":"8681","sourceWorkId":"23742","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67dfc40b582fdba8fe2f14f67ed7997e1324334c493217240fbf3d93c0c1a793.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4aaf38a968a3c869e484843fbdc20070032e0eda8781bdfe51457be3c2633957.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183172:149306:6131:1","source":"bangumi"}]},{"characterId":"char_c49509","characterName":"八崎 小百合","sourceIds":{"bangumi":[{"characterId":"149305","match":"exact-normalized-name-in-linked-work","subjectId":"183172"}],"egsCharacterIds":["8680"],"vndbCharacterId":"c49509"},"originalCharacterName":"八崎 小百合","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"62"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Age: 30's"}],"source":"vndb","sourceCharacterId":"c49509"},{"segments":[{"spoiler":false,"text":"このゲームのヒロイン。"},{"spoiler":false,"text":"厳しさと優しさを兼ね備えた、真面目タイプ。"},{"spoiler":false,"text":"自立した『出来る』女性。"},{"spoiler":false,"text":"勝ち気で意志が強い。"},{"spoiler":false,"text":"自分で考え行動し、どんどん前に進んでいくタイプ。"},{"spoiler":false,"text":"反面、悩みを他人に相談することは苦手。"},{"spoiler":false,"text":"主人公から見ると、優しいお姉さん。"},{"spoiler":false,"text":"大学を卒業して教師に就職後、次の目標として『結婚』を目指し、婚活に励み、主人公の兄・匠磨と結婚紹介所の婚活パーティーで出会い、およそ２年に渡る交際の後、そのまま結婚（２５歳のとき）。今にいたる。"},{"spoiler":false,"text":"子供は欲しいと思っているが、いない。"},{"spoiler":false,"text":"主人公とは、"},{"spoiler":false,"text":"結婚前、交際時から八崎家に兄・匠磨が連れ込んでいたので、その時からの顔見知り。"}],"source":"egs","sourceCharacterId":"8680","sourceWorkId":"23742","spoiler":false},{"segments":[{"spoiler":false,"text":"兄嫁である 厳しさと優しさを兼ね備えた “デキる” 女性。"},{"spoiler":false,"text":"主人公にとっては、引きこもりを心配してくれた優しいお姉さん。"},{"spoiler":false,"text":"勝ち気で意志が強く、どんどん前に進んでいくタイプ。"},{"spoiler":false,"text":"反面、悩みを他人に相談することは苦手。"},{"spoiler":false,"text":"大学を卒業して教職に就き、婚活パーティーで夫に出会い 2年に渡る交際の後に結婚。"},{"spoiler":false,"text":"子供は欲しいと思っているが、まだいない。"}],"source":"bangumi","sourceCharacterId":"149305"}],"profileFacts":[{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"8680","sourceWorkId":"23742","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"8680","sourceWorkId":"23742","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"8680","sourceWorkId":"23742","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"86