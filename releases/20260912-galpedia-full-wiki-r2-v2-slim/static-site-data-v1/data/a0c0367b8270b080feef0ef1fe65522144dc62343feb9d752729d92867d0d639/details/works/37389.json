e":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"158"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"13岁"},{"spoiler":false,"text":"あなたの守るべきもの"},{"spoiler":false,"text":"母親の代理でやって来た少年。"},{"spoiler":false,"text":"心に患いがあるようで"},{"spoiler":false,"text":"思った事を口に出せない。"},{"spoiler":false,"text":"突然足が動かなくなることもあり、"},{"spoiler":false,"text":"大崎は何かと気にかけている。"},{"spoiler":false,"text":"そもそも三回忌の主 大江杏が"},{"spoiler":false,"text":"どのような人物かも知らない。"},{"spoiler":false,"text":"困窮を極めていく孤島生活に"},{"spoiler":false,"text":"塞ぎ込みがちだが、"},{"spoiler":false,"text":"決して誰かのせいにしたりしない。"}],"source":"bangumi","sourceCharacterId":"110368"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13bb985c77a221139e110b98ba928f2bea70beb0a196387702b0803cbbd536ba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eacb0907c29285d823ca240da8153c45c216d2657148ba6db3ec79ffd62ced47.webp","width":62,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_110369","characterName":"たけしば","sourceIds":{"bangumi":[{"characterId":"110369","match":"source-roster","subjectId":"332995"},{"characterId":"110369","match":"source-roster","subjectId":"522285"}]},"originalCharacterName":"たけしば","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"173"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"33岁"},{"spoiler":false,"text":"あなたの相方立候補"},{"spoiler":false,"text":"はんなり関西弁の売れっ子手品師。"},{"spoiler":false,"text":"私服も白スーツに赤ネクタイと、"},{"spoiler":false,"text":"かなりの派手好き。"},{"spoiler":false,"text":"白けた空気