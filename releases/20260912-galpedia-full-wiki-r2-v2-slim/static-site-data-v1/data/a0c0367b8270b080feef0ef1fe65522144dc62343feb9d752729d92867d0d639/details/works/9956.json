can see you again」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:83727","source":"egs"},{"creditedName":"榊原 ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:13793","source":"vndb"},{"creditedName":"金松 由花","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:13794","source":"vndb"},{"creditedName":"織澤 明史","creatorId":"vndb:s3203","sourcePersonId":"vndb:s3203","canonicalEntityId":"vndb:s3203","name":"織澤明史(織澤あきふみ)","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:13798","source":"vndb"},{"creditedName":"どせい","creatorId":"vndb:s4161","sourcePersonId":"vndb:s4161","canonicalEntityId":"vndb:s4161","name":"どせい","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:13800","source":"vndb"}]},"cast":[{"characterId":"char_c38140","characterName":"チュチュ・アストラム","sourceIds":{"bangumi":[{"characterId":"109114","match":"exact-normalized-name-in-linked-work","subjectId":"1409"},{"characterId":"109114","match":"exact-normalized-name-in-linked-work","subjectId":"20766"}],"egsCharacterIds":["9483"],"vndbCharacterId":"c38140"},"originalCharacterName":"チュチュ・アストラム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"昔、離れ離れになった母親を探すべく、知由と合体してアイドルをしている、エロくてかわいい吸血鬼。"},{"spoiler":false,"text":"天才肌でプライドも高いが、好きな人に対しては甘えん坊で寂しがり屋な一面を見せる。"},{"spoiler":false,"text":"健介のことが非常にお気に入り。"},{"spoiler":false,"text":"実は処女。"},{"spoiler":false,"text":"「あなたはチュチュの、最初のド・レ・イ☆」"}],"source":"egs","sourceCharacterId":"9483","sourceWorkId":"8721","spoiler":false},{"segments":[{"spoiler":false,"text":"『Chu×Chuアイドる』 のヒロインで吸血鬼。"},{"spoiler":false,"text":"仲内知由とキスして合体、吸血合体アイドル 「チューア・チュラム」 として芸能界で活躍する毎日。"},{"spoiler":false,"text":"自由奔放で、イタズラ好きでエッチが大好き。"},{"spoiler":false,"text":"だが、アイドルとしての仕事だけは手を抜くことが無い。"},{"spoiler":false,"text":"しかし、今回はその歌に呪いをかけられ、どんな歌も周りに被害が出るほど音痴になってしまった。"},{"spoiler":false,"text":"絶対にライブまでに歌を取り戻してやると息巻いている。"}],"source":"egs","sourceCharacterId":"9483","sourceWorkId":"15517","spoiler":false},{"segments":[{"spoiler":false,"text":"知由とキスして合体しトップアイドル「チューア・チュラム」として活動中の吸血鬼の女の子。"},{"spoiler":false,"text":"昼寝中に謎の光に囲まれて見知らぬ世界に飛ばされることになる。"},{"spoiler":false,"text":"持ち前の行動力とプライドを掛け、みんなでアイドルグループを作ることを提案。"}],"source":"egs","sourceCharacterId":"9483","sourceWorkId":"16176","spoiler":false},{"segments":[{"spoiler":false,"text":"知由とキスすることで合体し、アイドルとして活動中の吸血鬼の女の子。"},{"spoiler":false,"text":"最初は有名になって母親に見つけてもらうのが目標だったが、母親が見つかったので、今は純粋にアイドルとして上を目指している。"},{"spoiler":false,"text":"性格は、プライドの高いわがまま娘。しかし、実は大変なあまえたがりでやきもち妬き。人見知りな所も。"},{"spoiler":false,"text":"知由とキスして合体する所を見られたという理由で初めての吸血の相手に健介を選ぶ。"},{"spoiler":false,"text":"昼間はダウンしている事が多いが、夜になると健介をからかって遊ぶ。"},{"spoiler":false,"text":"リップやキッス、そして健介と一緒に一つ屋根の下で暮らしている今を、とても幸せに思っている。"}],"source":"bangumi","sourceCharacterId":"109114"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c9314c79608acff70aa8bb049b501e0e02b912a34bfb7aad40df8f398b693d3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8b2d23dba426e19224abd287a1908e9e375fbe19ea36271ba5d20cbd6288f62.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊原ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150332:109114:4916:1","source":"bangumi"}]},{"characterId":"char_c38141","characterName":"仲内 知由","sourceIds":{"bangumi":[{"characterId":"109115","match":"exact-normalized-name-in-linked-work","subjectId":"1409"},{"characterId":"109115","match":"exact-normalized-name-in-linked-work","subjectId":"20766"}],"egsCharacterIds":["9484"],"vndbCharacterId":"c38141"},"originalCharacterName":"仲内 知由","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"健介の隣のクラスにいるアイドル。"},{"spoiler":false,"text":"チュチュと合体してアイドルをしている割に庶民的。"},{"spoiler":false,"text":"性格もよく、社交的なのだが健介に対しては攻撃的。"},{"spoiler":false,"text":"しかし、同棲後は健介のためにしぶしぶお弁当を作ってあげたりと、何かと世話を焼いてくれる。"},{"spoiler":false,"text":"「健介もだよ。もうエッチなことは厳禁なんだからねっ」"}],"source":"egs","sourceCharacterId":"9484","sourceWorkId":"8721","spoiler":false},{"segments":[{"spoiler":false,"text":"『Chu×Chuアイドる』 のヒロインで学生。チュチュの相棒。"},{"spoiler":false,"text":"マジメで明るく優しい活発な娘だが、照れると怒ってきたりする。"},{"spoiler":false,"text":"チュチュに巻き込まれて健介ともエッチなことをしてしまったりするが、彼女自身も二人のことを拒むことができない。"},{"spoiler":false,"text":"彼女も呪いを受けてしまったので、歌が音痴になってしまっている。"}],"source":"egs","sourceCharacterId":"9484","sourceWorkId":"15517","spoiler":false},{"segments":[{"spoiler":false,"text":"チュチュとキスして合体しトップアイドル「チューア・チュラム」として活動中の女の子。"},{"spoiler":false,"text":"相変わらずの貧乏性だけど、とてもしっかりした女の子。"},{"spoiler":false,"text":"彼女はチュチュと一緒には飛ばされていないらしい。"}],"source":"egs","sourceCharacterId":"9484","sourceWorkId":"16176","spoiler":false},{"segments":[{"spoiler":false,"text":"健介の隣のクラスにいる人気急上昇中のアイドル。チュチュとキスする事で合体し、アイドル「チューア・チュラム」として活動中。"},{"spoiler":false,"text":"性格は明るく、社交的。アイドルをしている割には、買い物上手だったり節約術を沢山知っていたりと、庶民的な一面も。"},{"spoiler":false,"text":"母親が元気になった今は、お金にはそんなに困っていない。だが、貧乏時代の癖はまるでぬけておらず、節約の鬼。"},{"spoiler":false,"text":"健介の事は苦楽を共にしてきたパートナーとして、とても信頼している。"},{"spoiler":false,"text":"健介はチュチュと付き合い始めたが、いまだに健介の事がちょっと好き。"}],"source":"bangumi","sourceCharacterId":"109115"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7c9c0d72cd72cc0c41085883fc817a33afa49ba7f5bfe3abf69d797b351ed8b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9dbbfa5f622cc89f7ee6f75d853439a779b9c3c7ff1ef05940447d7f965057a1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊原ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150332:109115:4916:1","source":"bangumi"}]},{"characterId":"char_c38142","characterName":"チューア・チュラム","sourceIds":{"bangumi":[{"characterId":"109123","match":"exact-normalized-name-in-linked-work","subjectId":"1409"},{"characterId":"109123","match":"exact-normalized-name-in-linked-work","subjectId":"20766"}],"egsCharacterIds":["10033"],"vndbCharacterId":"c38142"},"originalCharacterName":"チューア・チュラム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The idol who is currently the talk of the town...but in fact, she is the combined fusion of a human girl, Chiyu, and a vampire, Chuchu."},{"spoiler":false,"text":"Chuchu is in control of the body and handles the singing, while Chiyu is in charge of talk shows and other activities."}],"source":"vndb","sourceCharacterId":"c38142"},{"segments":[{"spoiler":false,"text":"ただいま話題沸騰中のアイドル…だが、実は人間の少女・知由と吸血鬼・チュチュが合体した姿。"},{"spoiler":false,"text":"合体時の主導権はチュチュが握っており、表に現れる言動はチュチュそのもの。"},{"spoiler":false,"text":"歌はチュチュが担当、トーク番組などは知由が担当して仕事をこなしている。"},{"spoiler":false,"text":"「今日もお仕事頑張ろうね！　知由」"},{"spoiler":false,"text":"「任せといて！　チュチュ」"}],"source":"egs","sourceCharacterId":"10033","sourceWorkId":"8721","spoiler":false},{"segments":[{"spoiler":false,"text":"『Chu×Chuアイドる』 『Chu×Chuぱらだいす～』 で、幾多の困難を乗り越えて成長し、そのエネルギッシュなライブシーンとTVやラジオで魅せる軽妙なトークで、いまや国民的大人気となりつつある超大型アイドル。"},{"spoiler":false,"text":"チュチュと知由が合体した姿ということはココだけのナイショの話。"},{"spoiler":false,"text":"次の大きなライブのためにリハーサルをこなしている最中、謎の来訪者に襲われ歌を奪われてしまう。"}],"source":"egs","sourceCharacterId":"10033","sourceWorkId":"15517","spoiler":false},{"segments":[{"spoiler":false,"text":"ただいま話題沸騰中のアイドル…だか、実は人間の少女・知由と吸血鬼・チュチュが合体した姿。"},{"spoiler":false,"text":"合体後の主導権はチュチュが握っており、表に表れる言動はチュチュそのもの。"},{"spoiler":false,"text":"歌はチュチュが担当、トーク番組などは知由が担当して仕事をこなしている。"},{"spoiler":false,"text":"「今日もお仕事、かんばろうね！知由」"},{"spoiler":false,"text":"「任せといて！チュチュ」"}],"source":"bangumi","sourceCharacterId":"109123"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c02067f96dde4595b5f52ae21516a475d123a58bf1d69a9d8f0f3261df4c717.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5ef2d6226ea54aafed47c7ca4170f0c3e33131bb075870e368a878ab705fa22f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊原ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150332:109123:4916:1","source":"bangumi"}]},{"characterId":"char_c38144","characterName":"ヒヨリ・ピクシー","sourceIds":{"bangumi":[{"characterId":"109116","match":"exact-normalized-name-in-linked-work","subjectId":"1409"},{"characterId":"109116","match":"exact-normalized-name-in-linked-work","subjectId":"20766"}],"egsCharacterIds":["10040"],"vndbCharacterId":"c38144"},"originalCharacterName":"ヒヨリ・ピクシー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"チュチュとうたのマネージャーを務める優しいお姉さん。"},{"spoiler":false,"text":"実は魔族で、チュチュのお母さん探しの最大の理解者。"},{"spoiler":false,"text":"非常に有能なのだが、恋愛ごとが絡んでくると、途端にあたふたしてしまう。"},{"spoiler":false,"text":"「痛みが取れるまで、わたしの膝枕でゆっくり休んでくださいね」"}],"source":"egs","sourceCharacterId":"10040","sourceWorkId":"8721","spoiler":false},{"segments":[{"spoiler":false,"text":"チューアのマネージャーを務める、どくろラビットの頼れる良心。"},{"spoiler":false,"text":"魔界の貴族出身であり、強い魔力を持つピクシーの家系。"},{"spoiler":false,"text":"不甲斐ないアルバートに代わって会社を切り廻すほどの有能な女性なのだが、私生活に戻ると恋愛下手だったりと、いろいろ可愛らしい弱点が。"},{"spoiler":false,"text":"実は結構な年齢のようで（？）、周囲からも嫁き遅れを心配され始めている。"}],"source":"egs","sourceCharacterId":"10040","sourceWorkId":"15517","spoiler":false},{"segments":[{"spoiler":false,"text":"Chu×Chuアイドるユニゾンシフト・アクセント"},{"spoiler":false,"text":"「どくろラビット」のプロデューサーでチューア・チュラムのマネージャー。"},{"spoiler":false,"text":"アイドルグループのプロデュースに力を注ごうとするが、自分もそのメンバーになる羽目に。"},{"spoiler":false,"text":"魔界の貴族出身で有能な女性だが頑張りすぎて婚期を逃してるという噂。酔うと面倒。"}],"source":"egs","sourceCharacterId":"10040","sourceWorkId":"16176","spoiler":false},{"segments":[{"spoiler":false,"text":"どくろラビットに勤める先輩マネージャー。その正体は、魔界の貴族のお嬢様。チュチュの親友で、最大の理解者。"},{"spoiler":false,"text":"仕事をバリバリこなすので出来る人と思われているが私生活に戻ると恋愛下手だったりと、いろいろ弱点が。"},{"spoiler":false,"text":"いい人が現れないかなぁ…と思いながら仕事に励む毎日。子供が大好きで、すこし頼りない健介を子供扱いする反面、たまに見せるシッカリしている所に少しドキドキしてる。"},{"spoiler":false,"text":"チュチュにまで先を越されて、嫁き遅れ感が増した。"}],"source":"bangumi","sourceCharacterId":"109116"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84a650a483f715b83dd24b226a3d0c74604083ed769de7e408ec7e11d730dbfd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6aef79641d463ac79f990c5c44f49a5bafcb5e94a7bf0179e65c48d7cc3f32fe.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150332:109116:4490:1","source":"bangumi"}]},{"characterId":"char_c43655","characterName":"アルバート・ティム","sourceIds":{"bangumi":[{"characterId":"109120","match":"exact-normalized-name-in-linked-work","subjectId":"1409"},{"characterId":"109120","match":"exact-normalized-name-in-linked-work","subjectId":"20766"}],"egsCharacterIds":["10044"],"vndbCharacterId":"c43655"},"originalCharacterName":"アルバート・ティム","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The president of \"Dokuro Rabbit\", the management company that supports Chuchu."}],"source":"vndb","sourceCharacterId":"c43655"},{"segments":[{"spoiler":false,"text":"チュチュとうたの所属事務所『どくろラビット』の社長。"},{"spoiler":false,"text":"実は魔族の貴族。"},{"spoiler":false,"text":"威風堂々とした容姿で、黙っていれば見た目は文句なしなのだが、非常に調子に乗りやすく、少し持ち上げれ大概の頼みは聞いてくれる。"},{"spoiler":false,"text":"単純な男。"},{"spoiler":false,"text":"「魔族でも人間でも、最終的にモノを言うのはお金、マネーだよ、うん」"}],"source":"egs","sourceCharacterId":"10044","sourceWorkId":"8721","spoiler":false},{"segments":[{"spoiler":false,"text":"チューアとうたの所属する事務所・どくろラビットの社長。"},{"spoiler":false,"text":"ヒヨリ同様に魔界貴族の出身…もとい、典型的なボンボンである。"},{"spoiler":false,"text":"“金持ち喧嘩せず” をモットーに掲げるお調子者だが、その愛嬌もあってどこか憎めない。"},{"spoiler":false,"text":"会社ではトラブルメーカー的存在で、ロクに仕事もさせてもらえないお飾り社長。"}],"source":"egs","sourceCharacterId":"10044","sourceWorkId":"15517","spoiler":false},{"segments":[{"spoiler":false,"text":"知由とうたの所属事務所「どくろラビット」の社長。"},{"spoiler":false,"text":"性格は昔は高慢だったのだが、今ではずいぶん丸くなったようだ。元々根がよい人なのでさらに周りの受けはよくなっている。"},{"spoiler":false,"text":"意外に小心者らしく、モットーは『金持ち喧嘩せず』。"},{"spoiler":false,"text":"どくろラビットの会長であるエミルから人間界支部をまかされているのだが、業績不信と元々の性格のせいでまったく頭が上がらない。"},{"spoiler":false,"text":"現魔王のメリッサとは、元婚約者の間柄。"}],"source":"bangumi","sourceCharacterId":"109120"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33fc91447bd51066a03e1af866eaaf5dc1ab682c2ddd33325a85e9626e694d73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a82a7f4c59826f7672b9aef1d1a56bf7deaa4e9ed3d790f6fd372e243ca05fe1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近藤孝行","creatorId":"vndb:s2121","sourcePersonId":"vndb:s2121","canonicalEntityId":"vndb:s2121","name":"近藤 孝行","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150332:109120:3980:1","source":"bangumi"}]},{"characterId":"char_vndb_c38139","characterName":"藤木 健介","sourceIds":{"vndbCharacterId":"c38139"},"originalCharacterName":"藤木 健介","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07770a25c5a85069d0759be6dd4d95153b914a2ce38e2b787fbbb08161bbf27e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2ec10049749d5099ac99b7a00bf77ad77b54de1d1b2c440b08c9f23a79576a27.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c38143","characterName":"上杉 うた","sourceIds":{"vndbCharacterId":"c38143"},"originalCharacterName":"上杉 うた","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"AA"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.