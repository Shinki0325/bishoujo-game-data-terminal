nId":"vndb:s14905","canonicalEntityId":"vndb:s14905","name":"佐藤 輝政","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:23923","source":"vndb"},{"creditedName":"佐藤 輝政","creatorId":"vndb:s14905","sourcePersonId":"vndb:s14905","canonicalEntityId":"vndb:s14905","name":"佐藤 輝政","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:23924","source":"vndb"},{"creditedName":"桜田 衣咲","creatorId":"vndb:s24265","sourcePersonId":"vndb:s24265","canonicalEntityId":"vndb:s24265","name":"桜田 衣咲","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:23926","source":"vndb"},{"creditedName":"sevenG","creatorId":"vndb:s24267","sourcePersonId":"vndb:s24267","canonicalEntityId":"vndb:s24267","name":"sevenG","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:23927","source":"vndb"},{"creditedName":"横山 浩","creatorId":"vndb:s44121","sourcePersonId":"vndb:s44121","canonicalEntityId":"vndb:s44121","name":"横山浩","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:23928","source":"vndb"}]},"cast":[{"characterId":"char_c1294","characterName":"天戸 沙織","sourceIds":{"bangumi":[{"characterId":"44217","match":"exact-normalized-name-in-linked-work","subjectId":"189583"}],"egsCharacterIds":["15890"],"vndbCharacterId":"c1294"},"originalCharacterName":"天戸 沙織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"元気ハツラツ、その言葉がピッタリとくる元気印の巫女のお姉さん。"},{"spoiler":false,"text":"歴史ある神社「巳各務神社」に古くから仕えてきた家系の娘であり、現代の当主をしている。"},{"spoiler":false,"text":"何かにつけて自分のことよりも他人のことを優先してしまうような、自己犠牲をいとわない博愛者。"},{"spoiler":false,"text":"そこに何の計算や宗教的な意思はなく、ただ純粋に彼女がそうしたいからしているだけ。"},{"spoiler":false,"text":"手助けを求められれば、それこそ山を越えて野を越えて……。"},{"spoiler":false,"text":"日常的に野山を駆け回っているため、その体力は都会人の祐毅からは想像できないほどタフである。"},{"spoiler":false,"text":"この村のことが大好きで、今の巳各務村の形が変わってしまうかもしれない再開発計画については否定的な立場にある。"},{"spoiler":false,"text":"だが、自分が大好きな巳各務という場所に人がたくさん来て、村の皆が喜ぶのは嬉しいことで……その狭間で沙織の気持ちは常に揺れている。"}],"source":"egs","sourceCharacterId":"15890","sourceWorkId":"11930","spoiler":false},{"segments":[{"spoiler":false,"text":"元気ハツラツ、その言葉がピッタリとくる巫女のお姉さん。"},{"spoiler":false,"text":"歴史ある神社 『巳各務神社』に古くから仕えてきた家系の娘であり、現代の当主をしている。"},{"spoiler":false,"text":"何かにつけて自分のことよりも他人のことを優先してしまうような、自己犠牲をいとわない博愛者。"},{"spoiler":false,"text":"そこに何の計算や宗教的な意思はなく、ただ純粋に彼女がそうしたいからしているだけ。"},{"spoiler":false,"text":"手助けを求められれば野を越え山を越え、どこまでも。日常的に野山を駆け回っているため、その体力は都会人の祐毅が想像できないほどタフである。"},{"spoiler":false,"text":"地元である巳各務村が大好きで、今の村の形が変わってしまうかもしれない再開発計画については否定的な立場にいる。だが、巳各務という場所に人がたくさん来て、村の皆が喜ぶのは嬉しいことで……、その狭間で沙織の気持ちは常に揺れている。"}],"source":"bangumi","sourceCharacterId":"44217"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc9597f60422bcdd84309018bff64d1a2313a1bd914ab2fe7053007d36614106.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd4885f113a84db898864d7ade72b10d5d3cfe9f60e686fd82ca603202ba3505.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:189583:44217:6409:1","source":"bangumi"}]},{"characterId":"char_c1295","characterName":"白妙 亜弥","sourceIds":{"bangumi":[{"characterId":"44218","match":"exact-normalized-name-in-linked-work","subjectId":"189583"}],"egsCharacterIds":["15009"],"vndbCharacterId":"c1295"},"originalCharacterName":"白妙 亜弥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"A"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"生れつき体が弱く心臓に先天的な欠陥がある薄幸の女性。"},{"spoiler":false,"text":"沙織とは幼馴染の関係で、一緒に神社で暮らしている。"},{"spoiler":false,"text":"激しい運動ができず、それが影響して体力もないため、いつも部屋で大人しくしている。"},{"spoiler":false,"text":"あまり外出ができない分、人の機微を感じ取ったりする能力や感受性が優れている、繊細な女性。"},{"spoiler":false,"text":"いつも人に迷惑をかけてばかりだということを気にしているところがあり、ときおり、過度にもとれる献身的な態度を見せることがある。"},{"spoiler":false,"text":"だがそれは決して自虐的なものではなく、彼女なりの「なんとかして役に立ちたい」という前向きな気持ちの表れである。"}],"source":"egs","sourceCharacterId":"15009","sourceWorkId":"11930","spoiler":false},{"segments":[{"spoiler":false,"text":"生まれつき身体が弱く、心臓に先天的な欠陥がある薄幸の女性。"},{"spoiler":false,"text":"沙織とは幼なじみの関係にあり、村唯一の診療所が神社の中にあるということもあり、神社の一室を借りてそこで暮らしている。"},{"spoiler":false,"text":"激しい運動ができず、それが影響して体力もないため、いつも部屋で大人しくしている。"},{"spoiler":false,"text":"村人たちから気遣われることも多いが、本人にとってみれば身体が弱いことも体力がないことも生まれつきであるため、あまり気にはしていない。"},{"spoiler":false,"text":"あまり外出ができない分、人の機微を感じ取ったりする能力や感受性に優れている、繊細な女性。"},{"spoiler":false,"text":"いつも人に迷惑をかけてばかりだということを気にしており、時に過度にもとれる献身的な態度を見せることも。"},{"spoiler":false,"text":"それは決して自虐的なものではなく、彼女なりの 「なんとかして役に立ちたい」という前向きな気持ちの表れである。"}],"source":"bangumi","sourceCharacterId":"44218"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7ca0e0864577e213ecd749b3d2ba1c2f8a475fec8a26280a0c8dc12c4f98239.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/760e42fad530e0d7d244928dfbfd044923a90311284f0d9e2aa1e93a879b7fc5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:189583:44218:4646:1","source":"bangumi"}]},{"characterId":"char_c1296","characterName":"各務 月巳","sourceIds":{"bangumi":[{"characterId":"44219","match":"exact-normalized-name-in-linked-work","subjectId":"189583"}],"egsCharacterIds":["15891"],"vndbCharacterId":"c1296"},"originalCharacterName":"各務 月巳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"古くからこの土地――今では巳各務村と呼ばれているこの場所を住処としてきた蛇の大妖怪。"},{"spoiler":false,"text":"大昔、この地にやってきた偉大な法師によって打ち倒されて以来、封印されている。"},{"spoiler":false,"text":"昔はその法師や人間達を恨みもしたが、今では「神」としての自覚もあって、そのような物騒な考えはなくなっている。"},{"spoiler":false,"text":"今はこの地……自分の名がそのまま地名となった『巳各務』の地を守護する土地神として存在し、そこに住まうすべての生命を守る、偉大な神となっている。"},{"spoiler":false,"text":"現在、巳各務村の人口減少に伴う『信仰心』の低下と地力の乱れにより、その存在を維持できなくなりかけている。"},{"spoiler":false,"text":"そのため、霊的な波長の合う祐毅に彼女は助けを求め、ともに協力していくことになる。"},{"spoiler":false,"text":"人の姿をとっているときは、数百という年を重ねてきているせいか、態度はデカいし人の言うことはきかない困ったお姉様となる。"},{"spoiler":false,"text":"そういう意味ではしっかり「妖怪」している月巳だが、そこはさすが神様。"},{"spoiler":false,"text":"本当に人の迷惑になるようなことは決してしない、聡い頭脳を持った「神様」である。"}],"source":"egs","sourceCharacterId":"15891","sourceWorkId":"11930","spoiler":false},{"segments":[{"spoiler":false,"text":"古くからこの土地――今では巳各務村と呼ばれている場所を住処としてきた蛇の大妖怪。"},{"spoiler":false,"text":"大昔、大蛇として恐れられていた彼女だが、この地にやってきた偉大な法師によって打ち倒され、以来この地に封印されている。"},{"spoiler":false,"text":"昔はその法師や人間たちを恨みもしたが、今では 『神』としての自覚もあり、そのような物騒な考えはない。"},{"spoiler":false,"text":"現在では、自分の名がそのまま地名となった 『巳各務』の地を守護する土地神として存在し、そこに住まうすべての生命を守る偉大な神となっている。"},{"spoiler":false,"text":"しかし、巳各務村の人口減少に伴う信仰心の低下と地力の乱れにより、その存在を維持できなくなりつつある。"},{"spoiler":false,"text":"そのため、霊的な波長の合う祐毅に助けを求め、ともに協力していくことに。"},{"spoiler":false,"text":"人の姿をとっている時は、数千という年を重ねてきているせいか、態度はでかく人の言うことはきかない困ったお姉様。"},{"spoiler":false,"text":"そういう意味ではしっかり 『妖怪』をしているが、本当に人の迷惑になるようなことは決してしない、聡い頭脳を持った 『神様』である。"}],"source":"bangumi","sourceCharacterId":"44219"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url