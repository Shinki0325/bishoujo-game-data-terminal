//wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc218453a60d0509bb902c395c77d4ffe04ce061d286506cc561190c58973096.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f62c61292721e3445ddbdbdf01aa2a8885e442f822df236ec67d6fa0a98b75d8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:189583:44222:5741:1","source":"bangumi"}]},{"characterId":"char_c1430","characterName":"白妙 まひる","sourceIds":{"bangumi":[{"characterId":"44221","match":"exact-normalized-name-in-linked-work","subjectId":"189583"}],"egsCharacterIds":["15892"],"vndbCharacterId":"c1430"},"originalCharacterName":"白妙 まひる","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"亜弥と同じく白妙家の娘で、亜弥の妹にあたるしっかり者の女性。"},{"spoiler":false,"text":"高校を卒業してすぐに実家の仕事につき、以後、村唯一の宿泊施設「翠楼館」（すいろうかん）の若女将として働いている。"},{"spoiler":false,"text":"身体の弱い姉を何よりも大切に思っており、亜弥のためならなんでもする、といっても過言ではないほど。ある意味過保護なほどの勢いを持つが、それもすべては姉への家族愛ゆえである。"},{"spoiler":false,"text":"しっかり者ゆえ、ときに口調が厳しくなることもあるが、それもすべては相手を思ってのこと。"},{"spoiler":false,"text":"少しばかり気負いすぎているところもあるが、それだけ日ごろから全力で頑張ろうとしている前向きな人間でもある。"}],"source":"egs","sourceCharacterId":"15892","sourceWorkId":"11930","spoiler":false},{"segments":[{"spoiler":false,"text":"亜弥と同じく白妙家の娘で、亜弥の妹にあたるしっかり者の女性。"},{"spoiler":false,"text":"高校を卒業してすぐ実家の仕事につき、以後、村唯一の宿泊施設 『翠楼館』（すいろうかん）の若女将として働いている。"},{"spoiler":false,"text":"身体の弱い姉を何よりも大切に思っており、亜弥のためならなんでもする、と言っても過言ではないほど。"},{"spoiler":false,"text":"ある意味 過保護なほどの勢いを持つが、すべては姉への家族愛ゆえ。"},{"spoiler":false,"text":"しっかり者の性格が災いして時に口調が厳しくなることもあるが、それも相手を思ってのこと。"},{"spoiler":false,"text":"少しばかり気負いすぎているところもあるが、それだけ日頃から全力で頑張ろうとしている前向きな人間である。"}],"source":"bangumi","sourceCharacterId":"44221"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/5435648d3bfaf5cb6508fd10186d4d7d56a65d3890abaad807c2e4f5e325018c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a4f231129989d8b50e6a3f815f83c85038a0ddf77f1ef91fbf1cad987899a89.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤雅美","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:189583:44221:13773:1","source":"bangumi"}]},{"characterId":"char_vndb_c106763","characterName":"加賀見 月","sourceIds":{"vndbCharacterId":"c106763"},"originalCharacterName":"加賀見 月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsuki too obviously pretends to be Hiroki's junior from his university, while actually being a temporarily incarnated figure of goddess Kagami Tsukimi to preserve her powers."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c106763"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd7ad0169df879a39f064a418b2a5357a9033e232eb5218ceaf3087ce9411950.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7cc69af4c795de17ed657a61d9d0abadd37234760a06616afadc8ad48034754.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩田 由貴","creatorId":"vndb:s1160","sourcePersonId":"vndb:s1160","canonicalEntityId":"vndb: