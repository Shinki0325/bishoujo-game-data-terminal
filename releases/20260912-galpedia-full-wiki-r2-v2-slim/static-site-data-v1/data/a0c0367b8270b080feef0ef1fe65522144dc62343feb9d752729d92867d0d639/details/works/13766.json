ce-native","relationId":"vndb:vn-staff:46789","source":"vndb"},{"creditedName":"谷上 純三","creatorId":"vndb:s3956","sourcePersonId":"vndb:s3956","canonicalEntityId":"vndb:s3956","name":"谷上 純三","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:46790","source":"vndb"}],"other":[{"creditedName":"RUNA(歌手)","creatorId":"vndb:s3057","sourcePersonId":"egs:creator:16476","canonicalEntityId":"vndb:s3057","name":"RUNA(歌手)","detail":"OP曲 「まるで愛しあう二人のように」、ED曲 「冬のMojitoにはSwingくらいちょうどいい」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:101064","source":"egs"},{"creditedName":"MA・TANKI","creatorId":"egs:creator:19614","sourcePersonId":"egs:creator:19614","canonicalEntityId":"egs:creator:19614","name":"MA・TANKI","detail":"エグゼクティブプロデューサー","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:133251","source":"egs"},{"creditedName":"723カン","creatorId":"vndb:s10571","sourcePersonId":"egs:creator:19612","canonicalEntityId":"vndb:s10571","name":"723カン","detail":"企画・ディレクション","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:133252","source":"egs"},{"creditedName":"谷上 純三","creatorId":"vndb:s3956","sourcePersonId":"vndb:s3956","canonicalEntityId":"vndb:s3956","name":"谷上 純三","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:46791","source":"vndb"},{"creditedName":"723カン","creatorId":"vndb:s10571","sourcePersonId":"vndb:s10571","canonicalEntityId":"vndb:s10571","name":"723カン","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:46793","source":"vndb"},{"creditedName":"RUNA","creatorId":"vndb:s3057","sourcePersonId":"vndb:s3057","canonicalEntityId":"vndb:s3057","name":"SATOMI","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:46795","source":"vndb"}]},"cast":[{"characterId":"char_c52304","characterName":"ヒルド","sourceIds":{"bangumi":[{"characterId":"59041","match":"exact-normalized-name-in-linked-work","subjectId":"229723"}],"egsCharacterIds":["12030"],"vndbCharacterId":"c52304"},"originalCharacterName":"ヒルド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has a calm demeanor, but is also a composed commander. She secretly has feelings for Thor, the God of thunder. This feeling is expressed in her loyalty to Thor on a daily basis."},{"spoiler":false,"text":"She wants to raise Thrud to be a great Valkyrie, for the secret purpose of attracting Thor's interest. On the other hand, she is jealous of Sif, Thor's wife. When she sees Sif's influence on Thrud's words and actions, she becomes somewhat harsh towards her."},{"spoiler":false,"text":"She trusts Rota as her competent subordinate. She sometimes gets a little irritated when Rota oversteps the boundary between superior and subordinate."},{"spoiler":false,"text":"From archived official site"}],"source":"vndb","sourceCharacterId":"c52304"},{"segments":[{"spoiler":false,"text":"おっとりとした物腰だが、冷静な司令官でもある。"},{"spoiler":false,"text":"ひそかに雷神トールに想いを寄せている。"},{"spoiler":false,"text":"その想いは日ごろ、トールへの忠誠として現れる。"},{"spoiler":false,"text":"スルーズを立派なワルキューレに育てたい、という好意が表立っているが、その裏にはトールの興味を引きたい思いがある。"},{"spoiler":false,"text":"一方で、トールの妻・シヴへの嫉妬心から、スルーズの言動にシヴの面影を見ると、やや辛く当たってしまうこともある。"},{"spoiler":false,"text":"ロッタを有能な部下として信頼しているが、まれに上司と部下の垣根を越えて甘えられ、少々イラつくこともある。"}],"source":"egs","sourceCharacterId":"12030","sourceWorkId":"13766","spoiler":false},{"segments":[{"spoiler":false,"text":"おっとりとした物腰だが、冷静な司令官でもある。"},{"spoiler":false,"text":"ひそかに雷神トールに想いを寄せている。その想いは日ごろ、トールへの忠誠として現れる。"},{"spoiler":false,"text":"スルーズを立派なワルキューレに育てたい、という好意が表立っているが、その裏にはトールの興味を引きたい思いがある。"},{"spoiler":false,"text":"一方で、トールの妻・シヴへの嫉妬心から、スルーズの言動にシヴの面影を見ると、やや辛く当たってしまうこともある。"},{"spoiler":false,"text":"ロッタを有能な部下として信頼しているが、まれに上司と部下の垣根を越えて甘えられ、少々イラつくこともある。"}],"source":"bangumi","sourceCharacterId":"59041"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05cd82a020bf7366cf8aa139834148b617ec8a7772c485d6bc44d2264aced42b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32970090744310cfa844dc88d350c2b9afd8a44cd0a97a31d72eb9d1932fc1aa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村恵子","creatorId":"vndb:s282","sourcePersonId":"vndb:s282","canonicalEntityId":"vndb:s282","name":"中村 恵子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229723:59041:6020:1","source":"bangumi"}]},{"characterId":"char_c52305","characterName":"ロッタ","sourceIds":{"bangumi":[{"characterId":"59042","match":"exact-normalized-name-in-linked-work","subjectId":"229723"}],"egsCharacterIds":["12031"],"vndbCharacterId":"c52305"},"originalCharacterName":"ロッタ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A veteran Valkyrie, trusted by Hildr. Although she is an elf of light, she has became a Valkyrie. She is a practical person who doesn't know unless she tries."},{"spoiler":false,"text":"She deeply respects Hildr as a senior Valkyrie and as a commander, She is willing to die if Hildr would command it."},{"spoiler":false,"text":"He wants to train Thrud as a new Valkyrie, because she would like to give her a hard time. But since she is the daughter of Thor, the God of thunder, she is conflicted between giving her a hard time and respecting her due to who she is."},{"spoiler":false,"text":"From archived official site"}],"source":"vndb","sourceCharacterId":"c52305"},{"segments":[{"spoiler":false,"text":"ヒルドの信頼も厚い、ベテランワルキューレ。"},{"spoiler":false,"text":"光のエルフでありながらワルキューレとなった。"},{"spoiler":false,"text":"実践派で、やってみなければ分からないタイプ。"},{"spoiler":false,"text":"ヒルドを先輩ワルキューレとして、そして指揮官として、深く尊敬している。"},{"spoiler":false,"text":"ヒルドの命令であれば自分は死んでも構わないと思っている。"},{"spoiler":false,"text":"スルーズを新人ワルキューレとしてビシビシしごきたいところなのだが、なにぶん相手は雷神トールの娘なので、どう扱っていいか戸惑っている。"}],"source":"egs","sourceCharacterId":"12031","sourceWorkId":"13766","spoiler":false},{"segments":[{"spoiler":false,"text":"ヒルドの信頼も厚い、ベテランワルキューレ。"},{"spoiler":false,"text":"光のエルフでありながらワルキューレとなった。"},{"spoiler":false,"text":"実践派で、やってみなければ分からないタイプ。"},{"spoiler":false,"text":"ヒルドを先輩ワルキューレとして、そして指揮官として、深く尊敬している。"},{"spoiler":false,"text":"ヒルドの命令であれば自分は死んでも構わないと思っている。"},{"spoiler":false,"text":"スルーズを新人ワルキューレとしてビシビシしごきたいところなのだが、なにぶん相手は雷神トールの娘なので、どう扱っていいか戸惑っている。"}],"source":"bangumi","sourceCharacterId":"59042"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9c176594f5993e9c3a65f3d6bd7fcb6c62cc8ba5a1b7665b2f74d2de891cafb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b2952979cd752cab6516feeb6b9db3c0a16cc08deaf56ce42ca302e585e0072.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"飯野ユウ","creatorId":"vndb:s931","sourcePersonId":"vndb:s931","canonicalEntityId":"vndb:s931","name":"飯野 ユウ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229723:59042:6377:1","source":"bangumi"}]},{"characterId":"char_c52306","characterName":"スルーズ","sourceIds":{"bangumi":[{"characterId":"59043","match":"exact-normalized-name-in-linked-work","subjectId":"229723"}],"egsCharacterIds":["12032"],"vndbCharacterId":"c52306"},"originalCharacterName":"スルーズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A new Valkyrie. Daughter of Thor, the God of thunder. She became a Valkyrie at the behest of her reluctant father, Thor. She was born a god, but she is still unable to wield her power fully."},{"spoiler":false,"text":"She is always full of energy, She says, “I'll do my best,” but then screws up. Hildr is her commander, she looks at Hildr with honest admiration."},{"spoiler":false,"text":"Rota is the closest to her ideal Valkyrie, she blindly respects and admires her. Deep down, she wants to like herself."},{"spoiler":false,"text":"From archived official site"}],"source":"vndb","sourceCharacterId":"c52306"},{"segments":[{"spoiler":false,"text":"新人ワルキューレ。雷神トールの娘。"},{"spoiler":false,"text":"渋る父・トールにせがんで、ワルキューレになった。"},{"spoiler":false,"text":"生まれとしてはゴッドだが、まだ充分には力を振るえない。"},{"spoiler":false,"text":"常にいっぱいいっぱいで、「がんばります」 と言いながらドジをする。"},{"spoiler":false,"text":"ヒルドを指揮官として、素直な尊敬のまなざしで見つめている。"},{"spoiler":false,"text":"ロッタは自分の中の理想のワルキューレに近く、盲目的な憧れと尊敬の念を抱いていて、心の底で自己との同一化を図りたがっている。"}],"source":"egs","sourceCharacterId":"12032","sourceWorkId":"13766","spoiler":false},{"segments":[{"spoiler":false,"text":"新人ワルキューレ。雷神トールの娘。"},{"spoiler":false,"text":"渋る父・トールにせがんで、ワルキューレになった。"},{"spoiler":false,"text":"生まれとしてはゴッドだが、まだ充分には力を振るえない。"},{"spoiler":false,"text":"常にいっぱいいっぱいで、「がんばります」 と言いながらドジをする。"},{"spoiler":false,"text":"ヒルドを指揮官として、素直な尊敬のまなざしで見つめている。"},{"spoiler":false,"text":"ロッタは自分の中の理想のワルキューレに近く、盲目的な憧れと尊敬の念を抱いていて、心の底で自己との同一化を図りたがっている。"}],"source":"bangumi","sourceCharacterId":"59043"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffd400ce0516fa25b33661e084c3f2a232bbd9836c2d052fdb723a0e2325e3da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20ea46f3783a3847a691d4e24f87a0774010246803fd8a275ae77fd607862702.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘志穂","creatorId":"vndb:s738","sourcePersonId":"vndb:s738","canonicalEntityId":"vndb:s738","name":"橘 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229723:59043:7169:1","source":"bangumi"}]},{"characterId":"char_vndb_c125462","characterName":"ユングヴィ","sourceIds":{"vndbCharacterId":"c125462"},"originalCharacterName":"ユングヴィ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Svartalfar (dark elf) civilian with a shaggy head, slightly upturned ears, and tan-like deep brown skin. He abandoned the land of his birth and lived by traveling, cheating and stealing, until Loki approached him and made him his servant."},{"spoiler":false,"text":"In order to entangle the Valkyries, he blends in with the Elves of Light and approaches Hildr's army. In public, he acts the part of a good-natured, handsome young man, but in reality, he is a despicable man."},{"spoiler":false,"text":"Believing Loki's words that he will be given the power of a demigod if he can win over the Valkyries, he aims to enter the world of the gods."},{"spoiler":false,"text":"From archived official site"}],"source":"vndb","sourceCharacterId":"c125462"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c68046","characterName":"ロキ","sourceIds":{"vndbCharacterId":"c68046"},"originalCharacterName":"ロキ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A beautiful boy with silver hair. He looks very young on the outside, but since he is a god, his actual age is thousands of years."},{"spoiler":false,"text":"He is mischievous and brings pleasant surprises to the world. Although he and Thor are on opposite sides, they are not enemies, and he has little interest in Thrymr's army. As long as he is happy, he is fine."},{"spoiler":false,"text":"He is amused by the protagonist's strong inferiority complex toward the Valkyries, and offers to make a deal with him by giving them the bracelets of transformation and turning him into demigods if they are entrapped."},{"spoiler":false,"text":"From archived official site"}],"source":"vndb","sourceCharacterId":"c68046"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f809c3f6e796baf0816ed4c681cd4ff4ad4b6d320a77fb94ccf0f885ef20021.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b2e53e23e50fcce273dfbe62315453856356a1f816270da8e8681ded5b75569.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榛名 れん","creatorId":"vndb:s455","sourcePersonId":"vndb:s455","canonicalEntityId":"vndb:s455","name":"神保 巴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:25871","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p724","sourceCompanyId":"egs:brand:1009","canonicalEntityId":"vndb:p724","name":"祭企画","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:13766:1009","source":"egs"},{"companyId":"vndb:p176","sourceCompanyId":"vndb:p176","canonicalEntityId":"vndb:p176","name":"N43 Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:15460:v4010","source":"vndb"},{"companyId":"vndb:p724","sourceCompanyId":"vndb:p724","canonicalEntityId":"vndb:p724","name":"祭企画","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:15461:v4010","source":"vndb"},{"companyId":"vndb:p724","sourceCompanyId":"vndb:p724","canonicalEntityId":"vndb:p724","name":"祭企画","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:42070:v4010","source":"vndb"},{"companyId":"vndb:p724","sourceCompanyId":"vndb:p724","canonicalEntityId":"vndb:p724","name":"祭企画","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:9112:v4010","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
