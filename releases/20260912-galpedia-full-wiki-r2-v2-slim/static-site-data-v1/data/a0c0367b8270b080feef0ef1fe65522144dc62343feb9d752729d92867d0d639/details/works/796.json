{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"796","model":{"presentationWorkId":"vndb:v10445","staff":{"artwork":[{"creditedName":"藤原秋久","creatorId":"vndb:s4051","sourcePersonId":"egs:creator:861","canonicalEntityId":"vndb:s4051","name":"藤原秋久","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:1789","source":"egs"}],"scenario":[{"creditedName":"三波雄","creatorId":"vndb:s4059","sourcePersonId":"egs:creator:246","canonicalEntityId":"vndb:s4059","name":"三波雄","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:1790","source":"egs"}],"music":[{"creditedName":"ミリオンバンブー(有限会社バンブー)","creatorId":"vndb:s1435","sourcePersonId":"egs:creator:2670","canonicalEntityId":"vndb:s1435","name":"ミリオンバンブー(有限会社バンブー)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:11826","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c102186","characterName":"綾瀬 絵里香","sourceIds":{"bangumi":[{"characterId":"220361","match":"exact-normalized-name-in-linked-work","subjectId":"260849"}],"egsCharacterIds":["17097"],"vndbCharacterId":"c102186"},"originalCharacterName":"綾瀬 絵里香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"友達想いで、周囲から慕われる優等生。"},{"spoiler":false,"text":"性格は明朗快活。"},{"spoiler":false,"text":"そうした周囲の評価に、やや違和感を感じているようだ。"},{"spoiler":false,"text":"親友の美奈を可愛い妹のように感じている。"}],"source":"egs","sourceCharacterId":"17097","sourceWorkId":"796","spoiler":false},{"segments":[{"spoiler":false,"text":"明るく活発な、みんなに慕われる健康的美少女。美奈と親友だったために、主人公から狙われることになる。友達想いで、保護意識を刺激する美奈のことを可愛い妹のように思っている。そこのところを主人公につけこまれる。実は「明るく、みんなに慕われる」自分の虚像に、やや違和感を感じている。主人公に犯され、自分の虚像を打ち壊す主人公の行動、言動を聞いているうちに……。"}],"source":"bangumi","sourceCharacterId":"220361"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05ac7b793c0558eab5b667a2929c91d81a178f02ed90a14dc2feb64ab4499b53.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed81a68672079af4c9a399a38e632adda58bfe0d0d27a81d8cf11de14234121d.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c102187","characterName":"大崎 ひとみ","sourceIds":{"bangumi":[{"characterId":"220364","match":"exact-normalized-name-in-linked-work","subjectId":"260849"}],"egsCharacterIds":["17098"],"vndbCharacterId":"c102187"},"originalCharacterName":"大崎 ひとみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"聖華学院の教師兼シスター。"},{"spoiler":false,"text":"主人公よりも若干年下。"},{"spoiler":false,"text":"性格は優しく母性的で、物腰も柔らかくその口調も丁寧。"},{"spoiler":false,"text":"敬虔なクリスチャンで、人を疑うことを知らないことから、主人公の毒牙に……。"}],"source":"egs","sourceCharacterId":"17098","sourceWorkId":"796","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公より１つ２つ年下。主人公の同僚にして、学園の教師兼シスター。敬虔なクリスチャンで、主人公をシスターとして信用するが、そのことが裏目に出て…。性格は優しく、母性的。口調も丁寧で、まさにシスターの鑑と言えるが、やや堅苦しい一面がある。また、盲目的とも言えるぐらいの信仰心のために、無意識のうちにストレスを溜めやすく、内心では「今の自分をメチャメチャにしたい」と密かに思っている。さらに、女性として成熟した身体を持つがゆえに、肉欲と信仰との板挟みとなってますますストレスを溜めてしまう。"}],"source":"bangumi","sourceCharacterId":"220364"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0cb5dd9386f1b654493ff225c10e1bbcf931069f41b706c22762eb5ff141735a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b419a8c809c703653cdccebd0e44d7013f2333dfb907fe1e730c80be5d03aaf.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c102189","characterName":"桜井 恭子","sourceIds":{"bangumi":[{"characterId":"220362","match":"exact-normalized-name-in-linked-work","subjectId":"260849"}],"egsCharacterIds":["17099"],"vndbCharacterId":"c102189"},"originalCharacterName":"桜井 恭子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"下級生に人気のあるボーイッシュでお姉さま系の女の子。"},{"spoiler":false,"text":"気が強く、思ったことはズバズバいうタイプ。"},{"spoiler":false,"text":"実は男嫌いで、しかもレズな傾向があり、密かに想っていた絵里香に近付く主人公に対して敵対心を露わにするが……。"}],"source":"egs","sourceCharacterId":"17099","sourceWorkId":"796","spoiler":false},{"segments":[{"spoiler":false,"text":"ボーイッシュで、ひとみより更に活発な、下級生に人気のある「お姉様」系の少女。ひとみの友人で、ひとみに近づく主人公のことを探ろうとして返り討ちに遭い、以後、そのことで脅迫され、弄ばれる。"},{"spoiler":false,"text":"実は男嫌いでレズの気があり、密かにひとみのことを想っている。そのため、ひとみに近づく主人公に対して敵対心があった。"},{"spoiler":false,"text":"気が強く、ハキハキした口調でズケズケ物を言う。主人公に容易に屈しようとしない。"}],"source":"bangumi","sourceCharacterId":"220362"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0853a0c30535815620ec061e6e22c5f2af280f6a0eea5f73ecb211f5b5ab37f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b7cc735c8bbf9dd06fdc1a32450d6846db5974dda525064774410ed9179b156.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c102190","characterName":"坂木 美奈","sourceIds":{"bangumi":[{"characterId":"220363","match":"exact-normalized-name-in-linked-work","subjectId":"260849"}],"egsCharacterIds":["17100"],"vndbCharacterId":"c102190"},"originalCharacterName":"坂木 美奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"外見も性格も子供っぽい女の子。"},{"spoiler":false,"text":"純真無垢というよりも、何も考えていないといった感じ。"},{"spoiler":false,"text":"甘えん坊さんで、男性に完全に依存するタイプ。"},{"spoiler":false,"text":"主人公に言葉巧みに言い包められ、肉体関係を結んでしまい、以来、主人公の従順な肉奴隷と化す。"}],"source":"egs","sourceCharacterId":"17100","sourceWorkId":"796","spoiler":false},{"segments":[{"spoiler":false,"text":"外見は子供っぽいが、さらに中身は子供っぽい。ひとみとは親友だが、どちらかといえば、保護者とその子供といった関係。"},{"spoiler":false,"text":"当初から主人公と肉体関係があり、主人公の言うことには何でも従う。"},{"spoiler":false,"text":"性格は、まさにお子様。純真というより、単なる考えなしと言ったほうが近い。口調も語尾を伸ばしたり、甘えたような感じ。男に甘え、依存するタイプ。主人公の言葉に簡単に言いくるめられる。難しいことを考えることが大の苦手。"}],"source":"bangumi","sourceCharacterId":"220363"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/2551a0d721e467dc2843ae2268003b454f6718c1ee2dbd47e4f32bd451882bc0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f393d7122c0af266c626988defcae2daf62cb01b6af86869cf01096fc8b6c96a.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c102188","characterName":"藤沢 孝弘","sourceIds":{"vndbCharacterId":"c102188"},"originalCharacterName":"藤沢 孝弘","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1953","sourceCompanyId":"egs:brand:1773","canonicalEntityId":"vndb:p1953","name":"BLACK PACKAGE TRY","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:796:1773","source":"egs"},{"companyId":"vndb:p1953","sourceCompanyId":"vndb:p1953","canonicalEntityId":"vndb:p1953","name":"Black Package Try","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-prod