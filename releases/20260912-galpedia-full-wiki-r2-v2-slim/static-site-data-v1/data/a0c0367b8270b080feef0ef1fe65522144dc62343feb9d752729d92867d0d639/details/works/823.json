flicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07e3e1ec5328c35e316b4b31a11e319363db07154724f8bcf9eddc78ffddba84.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a0471139f68145909e19d4cb6a857afdf6675f62a8570f812de75d2b859016f.webp","width":130,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79615:97943:4675:1","source":"bangumi"}]},{"characterId":"char_c28743","characterName":"桧山 葉子","sourceIds":{"bangumi":[{"characterId":"97944","match":"exact-normalized-name-in-linked-work","subjectId":"79615"}],"egsCharacterIds":["14256"],"vndbCharacterId":"c28743"},"originalCharacterName":"桧山 葉子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"葵の親友。"},{"spoiler":false,"text":"佐伯に恋心を抱いているものの、控えめな性格から葵のアタックの前に影が薄い。"},{"spoiler":false,"text":"北海道から上京し、学校の裏に一人暮らしをしているが、"},{"spoiler":false,"text":"あまり故郷のことは語りたがらない。"}],"source":"egs","sourceCharacterId":"14256","sourceWorkId":"823","spoiler":false},{"segments":[{"spoiler":false,"text":"葵の親友。やはり来年春から大学院に進むことが決まっている。"},{"spoiler":false,"text":"北海道から一人で上京し、生活している。彼女もまた主人公に恋愛感情を抱いているようなのだが、控えめな性格のため葵のアプローチに比べると目立たない。"}],"source":"bangumi","sourceCharacterId":"97944"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aaad2dfef554f30bfe82a00f6c45320c14905f1af7a6aafa1d4e07fbcf78ddd2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b17e84a3f20916dd4b273c785e4c67a29e88a24363bb3205a75053a126935995.webp","width":130,"height":256,"source":"static-detail"},"actors":[{"creditedName":"栗原みきこ","creatorId":"vndb:s4553","sourcePersonId":"vndb:s4553","canonicalEntityId":"vndb:s4553","name":"栗原 みきこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79615:97944:30251:1","source":"bangumi"}]},{"characterId":"char_c28744","characterName":"草薙 香乃","sourceIds":{"bangumi":[{"characterId":"97946","match":"exact-normalized-name-in-linked-work","subjectId":"79615"}],"egsCharacterIds":["14257"],"vndbCharacterId":"c28744"},"originalCharacterName":"草薙 香乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"佐伯と同じ大学で講師をしている。"},{"spoiler":false,"text":"ぶっきらぼうな性格なので、あまり友人はいないが、"},{"spoiler":false,"text":"佐伯とは性別を超えて「親友」同士である。"},{"spoiler":false,"text":"酒とタバコが大好きで、そのヘビースモーカーぶりは、"},{"spoiler":false,"text":"火を消してから５分ともたない…といわれている。"}],"source":"egs","sourceCharacterId":"14257","sourceWorkId":"823","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の同僚。"},{"spoiler":false,"text":"まるで女性を感じさせない風貌、言葉遣い。主人公とは妙に気が合い、彼にとっては数少ない親友としての付き合いが続いている。"},{"spoiler":false,"text":"相当なヘビースモーカーで、彼女がタバコを咥えていないところを見るほうが少ない。"}],"source":"bangumi","sourceCharacterId":"97946"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9ac3b3a040572be8e2b7e3e2c5ea2e10f55c8ec9604dd2f2dfaee8d319d011ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/928a21d26a7d25ab7ecce7ce14205d3f30d6384677d581dc510a3d6e3a7ef6ca.webp","width":130,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"横手 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79615:97946:4937:1","source":"bangumi"}]},{"characterId":"char_c28745","characterName":"日比野 照子","sourceIds":{"bangumi":[{"characterId":"97945","match":"exact-normalized-name-in-linked-work","subjectId":"79615"}],"egsCharacterIds":["14258"],"vndbCharacterId":"c28745"},"originalCharacterName":"日比野 照子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いつでも露出度の高い服を着て、見た目もノリも軽薄。"},{"spoiler":false,"text":"そのため、「淫乱」というイメージをもたれ、男となら誰とでも寝ると言われている。"},{"spoiler":false,"text":"但し、その真偽は不明。"},{"spoiler":false,"text":"佐伯にアプローチをかけてくる。"}],"source":"egs","sourceCharacterId":"14258","sourceWorkId":"823","spoiler":false},{"segments":[{"spoiler":false,"text":"大学院生。"},{"spoiler":false,"text":"いわゆるイケイケで、男と見ればすぐに色目を使う。"},{"spoiler":false,"text":"同じ大学院生で軽薄な天野宙とは馬が合わず、お互いを軽蔑しあっている。"},{"spoiler":false,"text":"彼女の目には、主人公はクールな男に映っているようで、機会を見つけては主人公に擦り寄ってくる。"}],"source":"bangumi","sourceCharacterId":"97945"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95800be05eff17a25d76895186db549949b8be6f93077777a7d33819184a3247.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f90aa3f3c6ea934eebc2f1dcc8027503e5f601e1fd58a9da37f6092a056428ff.webp","width":130,"height":256,"source":"static-detail"},"actors":[{"creditedName":"嶋崎はるか","creatorId":"vndb:s1013","sourcePersonId":"vndb:s1013","canonicalEntityId":"vndb:s1013","name":"嶋崎 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79615:97945:6302:1","source":"bangumi"}]},{"characterId":"char_c28746","characterName":"天野 宙","sourceIds":{"bangumi":[],"egsCharacterIds":["14259