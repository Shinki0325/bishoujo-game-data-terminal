{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"6838","model":{"presentationWorkId":"vndb:v812","staff":{"artwork":[{"creditedName":"みづきことら(あかつきまお)","creatorId":"vndb:s1700","sourcePersonId":"egs:creator:1665","canonicalEntityId":"vndb:s1700","name":"みづきことら(あかつきまお)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:13522","source":"egs"}],"scenario":[{"creditedName":"都築真紀","creatorId":"vndb:s5509","sourcePersonId":"egs:creator:300","canonicalEntityId":"vndb:s5509","name":"都築真紀","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:13521","source":"egs"},{"creditedName":"大澤ユキヲ","creatorId":"vndb:s45043","sourcePersonId":"egs:creator:5235","canonicalEntityId":"vndb:s45043","name":"大澤ユキヲ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:20859","source":"egs"}],"music":[{"creditedName":"アメディオ","creatorId":"vndb:s1300","sourcePersonId":"egs:creator:2993","canonicalEntityId":"vndb:s1300","name":"アメディオ","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:15778","source":"egs"}],"other":[{"creditedName":"REIKA","creatorId":"egs:creator:6393","sourcePersonId":"egs:creator:6393","canonicalEntityId":"egs:creator:6393","name":"REIKA","detail":"OP曲「キミとボクのセカイ」、ED曲「ひなたの路」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:111047","source":"egs"},{"creditedName":"都築真紀","creatorId":"vndb:s5509","sourcePersonId":"egs:creator:300","canonicalEntityId":"vndb:s5509","name":"都築真紀","detail":"企画、スクリプト","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:228381","source":"egs"},{"creditedName":"RMG(Rainbow-Motion-Graphics)","creatorId":"vndb:s2828","sourcePersonId":"egs:creator:12859","canonicalEntityId":"vndb:s2828","name":"RMG(Rainbow-Motion-Graphics)","detail":"ムービー制作","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:68197","source":"egs"},{"creditedName":"TakaJun","creatorId":"vndb:s27648","sourcePersonId":"vndb:s27648","canonicalEntityId":"vndb:s27648","name":"TakaJun","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:16000","source":"vndb"},{"creditedName":"Balcerzak","creatorId":"vndb:s27693","sourcePersonId":"vndb:s27693","canonicalEntityId":"vndb:s27693","name":"Balcerzak","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:16001","source":"vndb"},{"creditedName":"ArchDemon","creatorId":"vndb:s27826","sourcePersonId":"vndb:s27826","canonicalEntityId":"vndb:s27826","name":"ArchDemon","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:16002","source":"vndb"},{"creditedName":"SlashZero","creatorId":"vndb:s27837","sourcePersonId":"vndb:s27837","canonicalEntityId":"vndb:s27837","name":"SlashZero","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:16003","source":"vndb"},{"creditedName":"Zalas","creatorId":"vndb:s28317","sourcePersonId":"vndb:s28317","canonicalEntityId":"vndb:s28317","name":"Zalas","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:16004","source":"vndb"},{"creditedName":"Kjoery","creatorId":"vndb:s36016","sourcePersonId":"vndb:s36016","canonicalEntityId":"vndb:s36016","name":"Kjoery","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:16005","source":"vndb"},{"creditedName":"Vivio","creatorId":"vndb:s36017","sourcePersonId":"vndb:s36017","canonicalEntityId":"vndb:s36017","name":"Vivio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:16006","source":"vndb"},{"creditedName":"TRA","creatorId":"vndb:s38337","sourcePersonId":"vndb:s38337","canonicalEntityId":"vndb:s38337","name":"TRA","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:16007","source":"vndb"},{"creditedName":"Dirkkun","creatorId":"vndb:s39075","sourcePersonId":"vndb:s39075","canonicalEntityId":"vndb:s39075","name":"Dirkkun","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:16008","source":"vndb"},{"creditedName":"Olaf Vaterman","creatorId":"vndb:s41769","sourcePersonId":"vndb:s41769","canonicalEntityId":"vndb:s41769","name":"Olaf Vaterman","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:16009","source":"vndb"},{"creditedName":"bsed","creatorId":"vndb:s41770","sourcePersonId":"vndb:s41770","canonicalEntityId":"vndb:s41770","name":"bsed","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:16010","source":"vndb"},{"creditedName":"Gilmor","creatorId":"vndb:s41771","sourcePersonId":"vndb:s41771","canonicalEntityId":"vndb:s41771","name":"Gilmor","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:16011","source":"vndb"},{"creditedName":"KKagerou","creatorId":"vndb:s41772","sourcePersonId":"vndb:s41772","canonicalEntityId":"vndb:s41772","name":"KKagerou","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:16012","source":"vndb"},{"creditedName":"stars9","creatorId":"vndb:s41773","sourcePersonId":"vndb:s41773","canonicalEntityId":"vndb:s41773","name":"stars9","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:16013","source":"vndb"},{"creditedName":"あかつき まお","creatorId":"vndb:s1700","sourcePersonId":"vndb:s1700","canonicalEntityId":"vndb:s1700","name":"みづき ことら","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:16014","source":"vndb"},{"creditedName":"REIKA","creatorId":"vndb:s1701","sourcePersonId":"vndb:s1701","canonicalEntityId":"vndb:s1701","name":"REIKA","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:16016","source":"vndb"},{"creditedName":"A-ko","creatorId":"vndb:s55022","sourcePersonId":"vndb:s55022","canonicalEntityId":"vndb:s55022","name":"A-ko","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:16018","source":"vndb"}]},"cast":[{"characterId":"char_c4645","characterName":"みかん","sourceIds":{"bangumi":[{"characterId":"20799","match":"exact-normalized-name-in-linked-work","subjectId":"16966"}],"egsCharacterIds":["25982"],"vndbCharacterId":"c4645"},"originalCharacterName":"みかん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"618"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An abandoned anthropoid dog. Yuuichi finds her unconscious in the rain one night while walking home, unable to let her just die, he takes her up to his apartment and treats her. Even though he told her she can only stay until the rain ends, she stays in fear and worry. She was the pet dog of a girl called Misa, who recently died. She is initially very shy and detached, due to her being unable to accept the death of her master, and thus Yuuichi assumes that she lacks the proper ability to speak. She is eventually taken in by Yuuichi and, after some time, opens up and proves herself to be exceptionally intelligent."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4645"},{"segments":[{"spoiler":false,"text":"野良としてさまよっていた所を主人公に拾われる。"},{"spoiler":false,"text":"中型犬の子犬で、どうやらかなり高級な犬種らしい。"},{"spoiler":false,"text":"放浪生活で体調を崩していたことに加え、過去になにか心に傷を負ったらしく、初めはひどく臆病で大人しい子。"},{"spoiler":false,"text":"主人公に心を開くにつれ、だんだんと明るく甘え好きな性格になっていく。"},{"spoiler":false,"text":"少し内気な所もあるが、一度主人と認めた人のことは決して裏切らず、忠実に飼い犬としての責務（よいこでいること、かわいがられること）をこなそうとする。"},{"spoiler":false,"text":"趣味は散歩だが、一人で行くと非常に高い確率で迷子になるので、「ご主人様」に連れて行ってもらうのが好き。"}],"source":"egs","sourceCharacterId":"25982","sourceWorkId":"6838","spoiler":false},{"segments":[{"spoiler":false,"text":"人形犬，6月18日出生，性别为雌性，就如其名，全身为蜜柑【橙】色。"},{"spoiler":false,"text":"特别喜欢呆在装蜜柑的箱子里，喜欢狭窄的地方"},{"spoiler":false,"text":"人型の犬。6月18日生まれ。女の子で、名の通りのみかん色のショートヘア。頭頂部に、長いアホ毛が1束ある。また、耳の横だけは長く伸ばしている。瞳はライムグリーン。犬種はアイリッシュ・クラウン。ヨーロッパでは人気が高いが、日本では珍しい種類の中型の高級犬で、国内ではほんの数匹しか飼われていない。"},{"spoiler":false,"text":"みかん箱や隅っこなどの、狭いところが好き（落ち着くらしい）。"}],"source":"bangumi","sourceCharacterId":"20799"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52cb41598f3409378d93431c0e0a8d898b016670535dadf3100a352b1bfc8e08.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/ebb691314516df2967c3fbc25af1dbc0b2fe9dfb3872013e8a48f7362ec3a885.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16966:20799:4490:1","source":"bangumi"}]},{"characterId":"char_c4646","characterName":"桜海 里沙","sourceIds":{"bangumi":[{"characterId":"133056","match":"exact-normalized-name-in-linked-work","subjectId":"16966"}],"egsCharacterIds":["25983"],"vndbCharacterId":"c4646"},"originalCharacterName":"桜海 里沙","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The younger sister to the late owner of Mikan. She was meant to take care of Mikan, but Mikan was unwilling to accept this arrangement."},{"spoiler":false,"text":"Risa eventually begins staying at Yuuichi's house for extended periods of time. She is, despite being a virgin, quite open with Yuuichi about her sexuality."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4646"},{"segments":[{"spoiler":false,"text":"明朗で快活な性格の少女。"},{"spoiler":false,"text":"みかんのかつての主人、桜海美沙の妹で、いなくなったみかんを探して、主人公と出会う。"},{"spoiler":false,"text":"その後は遊佐家に入り浸り、半ば居候状態となる。"},{"spoiler":false,"text":"料理が趣味なのだが、栄養価重視の傾向にあり、そのメニューはかなり独創的。"},{"spoiler":false,"text":"とある出来事をきっかけに、シルヴィアーナの飼い主となる。"},{"spoiler":false,"text":"実は人並み以上に「エッチなこと」に興味津々なのだが、"},{"spoiler":false,"text":"それを他人に相談するわけにもいかず、苦心して集めたエログッズとともに悶々として毎日を送っている。"}],"source":"egs","sourceCharacterId":"25983","sourceWorkId":"6838","spoiler":false},{"segments":[{"spoiler":false,"text":"人間の少女。みかんの飼い主であった美沙の妹。朱茶色のロングヘア。青いリボンでツインテールにしている。頭頂部から長いアホ毛が2束、昆虫の触角のように出ている。瞳はマリンブルー。"},{"spoiler":false,"text":"行方不明になっていたみかんを捜していて、祐一と出会う。みかんが祐一と住むことになったため、何かと祐一の家に入り浸るようになる。後に、シルヴィの飼い主となる。"},{"spoiler":false,"text":"体育会系の元気娘で、口調も「～っス」が多い。思考はポジティブで、自称「100の取り柄がある」。女子校通い。初恋は小学校の先輩で、図書委員の人だった。実は小学校5年生の時、学級委員をやったことがある。掃除以外の家事全般が得意（部屋はよく散らかしている）。特に料理に関しては、小学生の頃からクラブは料理関係ひとすじで、見かけはともかく栄養満点のレシピを多数持っている上、新レシピの開発も熱心（ハズレは7%ほど）。その作品は「味の想像がつかない」ものが多い。"},{"spoiler":false,"text":"Hなことには興味が強く、苦労してアダルトグッズを集めたりアダルトビデオを借りたりしていた。"},{"spoiler":false,"text":"部屋の片づけをしている時、誤ってアダルトグッズを祐一の前でぶちまけてしまう。落ち着いて話し合った後は何かが吹っ切れ、祐一を「エロ師匠」と仰ぐ（“エロい師匠”ではなく“エロスの師匠”なので、「エ」にアクセントを置いて発音しなければならないらしい）。"},{"spoiler":false,"text":"祐一の家に入り浸るようになってからは、祐一に名前を借りてアダルトグッズを堂々と買ったり、アダルトビデオを借りるようになった。アダルトビデオは陵辱系と百合系が、本はボーイズラブ系が好み。"},{"spoiler":false,"text":"普段からよくエロいことを考えているせいか、フェロモンの発散が多め。祐一によると「青りんご系の甘酸っぱい匂い」らしい。みかんも正しく嗅ぎ分けている。祐一曰く「一緒にいたら普通の男なら発情している」との事"},{"spoiler":false,"text":"里沙ルートへ進むと、最終的には祐一と結婚する。また、結婚後は髪型がツインテールから姉の美沙に似た後ろで1束にまとめる形に変わる（アホ毛が2束なのは変わらない）。"},{"spoiler":false,"text":"とある権利を650万で祐一に貸しているがいずれのルートでも返済している様子は無いが、おそらくは地道に返済していると思われる(祐一自身も数十万～数百万程度戻ったら御の字と思っている)。"}],"source":"bangumi","sourceCharacterId":"133056"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c28a097d9a36b582cd16a145c415b0c62006af7490095e92d27f44a10ae3d8c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c25eea5c9c6139c6db9ee674154b969794f41d6319944797a74fd479a5b79425.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16966:133056:5020:1","source":"bangumi"}]},{"characterId":"char_c4647","characterName":"望月 撫子","sourceIds":{"bangumi":[{"characterId":"133057","match":"exact-normalized-name-in-linked-work","subjectId":"16966"}],"egsCharacterIds":["25985"],"vndbCharacterId":"c4647"},"originalCharacterName":"望月 撫子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The owner of a local pet store."},{"spoiler":false,"text":"Despite her incredibly young appearance, she is actually older than Yuuichi, which has made lots of people confused about her, Yuuichi included."},{"spoiler":false,"text":"Initially helps Yuuichi with Mikan and Silvie."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4647"},{"segments":[{"spoiler":false,"text":"主人公宅の近所にある大きなペットショップの店長。"},{"spoiler":false,"text":"大の動物好きで、優しくかわいらしい雰囲気の女性。"},{"spoiler":false,"text":"外見は少女のようだが、考えた方や物腰は立派な30代である。"},{"spoiler":false,"text":"人型動物を飼うのが初めての主人公に、いろいろとアドバイスをくれたりする。"},{"spoiler":false,"text":"かつて商品として入荷したものの、あまりの凶暴性に引き取り手がなかった虎太郎の里親となり、大事に育てている飼い主でもある。"},{"spoiler":false,"text":"仕事以外での男性との交流には不得手で、少々赤面症の気がある。"}],"source":"egs","sourceCharacterId":"25985","sourceWorkId":"6838","spoiler":false},{"segments":[{"spoiler":false,"text":"祐一の近所のペットショップ「望月」の店主。一見、中学生のような幼い外見の女性だが、実は32歳。しかも独身。栗色のショートヘア。瞳は橙色。おでこが少し広く、やや赤面症。"},{"spoiler":false,"text":"人型ペットの飼い主としては初心者である祐一のよきアドバイザーであり、相談相手でもある。"},{"spoiler":false,"text":"虎太郎の飼い主で、自宅では他にも多数の犬（人型ではない）をはじめとする多くの動物を飼っている。昔、凶暴だった虎太郎を厳しくしつけ、その際に腕などに多くの傷を受けている。"},{"spoiler":false,"text":"仕事の疲れが溜まり、身体中が凝っていた（祐一によると「皮膚のすぐ下にアスファルトが入っているみたい」）。65分をかけた祐一のマッサージで溶けてしまい、虎太郎が心配するほどだった。酒を飲むとからみ、泣き、時に暴れる。酒自体にはあまり強くなく、少し多めに飲むと寝てしまう。"},{"spoiler":false,"text":"店は、前の店主だった祖父が入院した時に継いだ。大学（経営学部）卒業の直前で、卒業後は店の経理担当として入る予定だった。"},{"spoiler":false,"text":"仕事柄、嗅覚はあまり鋭くはなく、そのためニンニク味噌で強化された祐一のフェロモンにも反応しなかった。"},{"spoiler":false,"text":"独身であることに関する話題はタブー。初恋は小学校の頃の担任の先生だった。恋愛経験は数多くあるが、ことごとくダメだったらしい。"},{"spoiler":false,"text":"撫子ルートへ進んでも祐一と結婚はしないが、別の男性（祐一より年下の、ペットショップの短期アルバイト）と結婚して2児をもうける。"}],"source":"bangumi","sourceCharacterId":"133057"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3a077873b0efaf2c1aef27c5553daa7e32829f18a529dce8e6b329757647e6b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/bec80fd4de39f1f871f291b52203ba069d69d17913ea9330458272a4bca96dc9.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"ももぞの薫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16966:133057:6131:1","source":"bangumi"}]},{"characterId":"char_c4648","characterName":"シルヴィアーナ","sourceIds":{"bangumi":[{"characterId":"133058","match":"exact-normalized-name-in-linked-work","subjectId":"16966"}],"egsCharacterIds":["25984"],"vndbCharacterId":"c4648"},"originalCharacterName":"シルヴィアーナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"130"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The pet dog of Risa. Initially the pet of a cruel breeder, she is rescued by Risa and Yuuichi. She is quiet and shy throughout the game, partially due to her relatively low intelligence."},{"spoiler":false,"text":"She is part of a rare and valuable breed of dog, and thus it was necessary for Yuuichi to spend a lot of money to free her."},{"spoiler":false,"text":"From Wikipedia"},{"spoiler":false,"text":"Her breed is a golden shih tzu."}],"source":"vndb","sourceCharacterId":"c4648"},{"segments":[{"spoiler":false,"text":"上品で幼い雰囲気の小型犬種。"},{"spoiler":false,"text":"ある富豪の夫人に買い取られるが、その心のない飼い方の影響で、無口無表情、作り笑いすらも、命令されないと出せなくなってしまう。"},{"spoiler":false,"text":"やがて出会った理沙に引き取られることとなり、彼女や主人公、みかんや虎太郎との「なんでもない普通の日常」を通じて、徐々に心を取り戻してゆく。"},{"spoiler":false,"text":"ショードッグとして飼育されることが多い種で、躾けられたことはよく聞き、守るが、知能そのものはそれほど高くなく、人語を使用することなどは苦手である。"}],"source":"egs","sourceCharacterId":"25984","sourceWorkId":"6838","spoiler":false},{"segments":[{"spoiler":false,"text":"人型の犬。1月30日生まれ。愛称は「シルヴィ」。女の子で、金桃色のロングヘア。リボンで細かくまとめている。瞳は明るいマリンブルー。犬種はゴールデンシーズのパストラルシンフォニー血統で、ショードッグとして超人気の小型犬。"},{"spoiler":false,"text":"口数が少なく物静か。知能があまり高くなく、人語はカタコトで漢字も読めない。表情の変化も少なく一見やや冷たい印象を受けるが、実は感受性は非常に豊かで、みかん以上の優しさを持つ。"},{"spoiler":false,"text":"みかん以上に猫っぽいところがあり、しばしば「にゃー」と鳴いたりもする。近所の猫たちとも仲よし。飼い主は里沙だが、みかんが祐一を「ご主人様」と呼ぶので、シルヴィも祐一を「ごしゅじんさま」と呼び、里沙のことは「りさちゃん」と呼んでいる。祐一が理由を聞いたところ「わたしのごしゅじんさまはりさちゃんだけど、りさちゃんのごじゅじんさまはごじゅじんさま」という事なのでシルヴィの中では「祐一＜里沙＜みかん＜里沙や祐一の友人たち＜自分」という位置づけの模様(ある意味正しい関係とも言える)"},{"spoiler":false,"text":"ショードッグコンテスト向きの犬種だけに、何を着せても合うが、色白で上品な雰囲気のため、特にゴスロリ系の服が似合う。里沙ルートではみかんと一緒にメイド服姿を披露する。"},{"spoiler":false,"text":"ペットショップ望月から、豪田夫人という成金オバサンにコンテスト用として売られた。その時の代価はワクチン代込みで343万7230円（ただしこれは格安で、通常は500万円を超える）。"},{"spoiler":false,"text":"コンテストでの成績が振るわなかったため、無理矢理“子作り用”にされかけ、心も壊れかけていたが、この扱いを問題と考えた祐一・里沙・クゥたちにより救い出され、里沙のペットとなる。里沙のペットとなってからは、知り合いの人やペットたちに囲まれ、少しずつ健康な心を取り戻していった。壊れかけている状態でも里沙が自分の為に泣いている事を理解していた。"},{"spoiler":false,"text":"試しにコンテストに参加させたら好成績を残したが本人や里沙共々本職にする気は無い。"}],"source":"bangumi","sourceCharacterId":"133058"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/359a59c6cc1c5f7484ea1d114013493a20411492cf73b653f8dd71bcbc85113e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffe3b71ab866e7e576915b25dd874e4097bb2a5ae2b754de832ca75e65d04cde.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤村歩","creatorId":"vndb:s1703","sourcePersonId":"vndb:s1703","canonicalEntityId":"vndb:s1703","name":"藤村 歩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16966:133058:4783:1","source":"bangumi"}]},{"characterId":"char_c4649","characterName":"虎太郎","sourceIds":{"bangumi":[{"characterId":"133059","match":"exact-normalized-name-in-linked-work","subjectId":"16966"}],"egsCharacterIds":["25986"],"vndbCharacterId":"c4649"},"originalCharacterName":"虎太郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"514"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The pet dog of Nadeshiko. Despite her average intelligence, she is a highly respected police dog, due to her excellent pedigree resulting in high capabilities."},{"spoiler":false,"text":"She was extremely violent and aggressive when younger, seriously injuring Nadeshiko. Now that she is more mature, she regrets behaving like she did, and has a very good relationship with Nadeshiko."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4649"},{"segments":[{"spoiler":false,"text":"撫子宅で飼われている数多い動物の中でもただ一匹の「人型」。"},{"spoiler":false,"text":"言葉は片言だが、風格とりりしさの漂う大型犬。"},{"spoiler":false,"text":"過去に、あまりの凶暴性に「商品」としての買い手がつかず、誰からも見放されていた自分を献身的に育ててくれた撫子に強い恩義を感じでおり、母親として慕う。"},{"spoiler":false,"text":"そのため、撫子に対しては「おかーさん」と呼び甘える。"},{"spoiler":false,"text":"数年前から警察犬訓練を受けており、現在は資格も保有。"},{"spoiler":false,"text":"普段は撫子の店の手伝いをしながら、時折警察犬としての業務に出かけている。"},{"spoiler":false,"text":"みかんにとっては犬社会についての知識などをいろいろと教えてくれる先輩的存在。"}],"source":"egs","sourceCharacterId":"25986","sourceWorkId":"6838","spoiler":false},{"segments":[{"spoiler":false,"text":"人型の犬。5月14日生まれで、作品中で唯一、誕生日パーティを開いてもらえる。女の子で、青色のロングヘア。髪はまとめずのばしている。一人称は「虎太」。瞳はゴールド。犬種はハイランドウルフハウンドで狩猟用の大型犬。"},{"spoiler":false,"text":"撫子の飼い犬で、撫子を「おかーさん」と呼んで慕っている。撫子が「いじめられた」と感じると、すぐに出現して注意する。また、撫子のペットとしては、唯一の人型。"},{"spoiler":false,"text":"ふだんは撫子の店を手伝い、売り物の動物の散歩や重い商品の運搬などをしているが、時々警察犬の仕事もしている。地図を読むことができ、車のナビゲータもできる。特に年下や目下には、素直であることを求めることが多い。"},{"spoiler":false,"text":"犬種的にあまり知能は高くなく、人語は苦手でカタコト。文字も、漢字はほとんど読めない。面倒見がよく、みかんやシルヴィには、犬社会の様々な知識を教えた。特にみかんには姉のように慕われている。元々が狩猟犬なので握力は400kgもあり、本気で戦うと相手が熊や虎でも負けることはない。祐一からマッサージのテクニックを教わり、撫子の凝りをほぐしたりもしている。"},{"spoiler":false,"text":"幼い頃から凶暴で、初めて売られた先から脱走、その後に入れられた訓練所も脱走し、頭がおかしいと思われて薬殺されそうになったところを、撫子に引き取られた。虎太郎という男前な名前は、あまりの凶暴さのため撫子が男の子と思い込んでつけたもの。撫子のもとで、優しくまた厳しくしつけられ、落ち着いた性格になった。"},{"spoiler":false,"text":"警察犬訓練所に2年通い、様々な訓練を受けた。その甲斐あって卓越した追跡・捕獲能力を備え、一級警察犬の資格を持っている。カイエの実親であるクリーエンVI世の指導を受けたこともある。弟分であるカイエの教育をしたが、警察犬の階級を追い抜かれた上、カイエ自身がやや慇懃になってしまい、虎太郎に甘えることがなくなったので、カイエとはあまり仲がよくない。"}],"source":"bangumi","sourceCharacterId":"133059"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/971420f88fad9bbfb617743b138b5c195baf4f5f6dc0ee3733af6be9fa2c84e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/936697fb223299dc41011cc25ab1c726109204d1a6be0a14f3f352a6231e273e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"悠","creatorId":"vndb:s1702","sourcePersonId":"vndb:s1702","canonicalEntityId":"vndb:s1702","name":"悠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7874","source":"vndb"}]},{"characterId":"char_c4650","characterName":"睦月 かな","sourceIds":{"bangumi":[{"characterId":"133060","match":"exact-normalized-name-in-linked-work","subjectId":"16966"}],"egsCharacterIds":["25987"],"vndbCharacterId":"c4650"},"originalCharacterName":"睦月 かな","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student in Yuuichi's cram school."},{"spoiler":false,"text":"Is very friendly to Yuuichi, helps him a lot, and often visits for food."},{"spoiler":false,"text":"She owns Kuu, an exceptionally intelligent anthropoid cat."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4650"},{"segments":[{"spoiler":false,"text":"天真爛漫を絵に描いたような、ごくごく普通の明るい女の子。"},{"spoiler":false,"text":"主人公がバイトしている熟＆家庭教師の教え子で、なおかつ主人公の借りている部屋の大家の娘でもある。"},{"spoiler":false,"text":"飼い猫の“クゥ”から日々人生や世間についての知識を教わっており、年よりだいぶ大人びたものの見方をする傾向にある。"},{"spoiler":false,"text":"クゥが例外的な知能の高さを有するためか、主従が逆転しているかのように感じられる場面もあるが、本人たちは極めて良好な信頼関係を築いている。"},{"spoiler":false,"text":"ジャンクフードグルメを自称しており、新作お菓子類については知識豊富。"},{"spoiler":false,"text":"理沙とも仲良し。"}],"source":"egs","sourceCharacterId":"25987","sourceWorkId":"6838","spoiler":false},{"segments":[{"spoiler":false,"text":"小学生の少女。祐一にとっては、大家の娘であり、塾の生徒であり、家庭教師の教え子である。クゥの飼い主。祐一がみかんの飼い主となってからは、人型ペットの飼い主どうしという関係もある。ピンク色のショートヘア。頭頂部の左右で、黄色のリボンで結んで小さな房を2つ作っている。瞳は赤。口元に光る八重歯がチャームポイント。基本的に明るく素直な元気娘で、いつも動きやすい服装をしている。"},{"spoiler":false,"text":"自称「ジャンクフードグルメ」。特に、新作のお菓子類の情報に詳しい。"},{"spoiler":false,"text":"大家の娘だからというわけではないが、祐一の部屋には出入り自由。留守であっても、鍵がある場所を知っているので、気にせず入っている。クゥとともに、以前から祐一にペットを飼うように勧めていた。また、シルヴィと出会う前の里沙にもペット飼育を勧めている。"},{"spoiler":false,"text":"ペットの飼い主としての経験が長く、祐一の相談を受けることもある。クゥをとても大切にしているが、まだクゥの発情期の処理ができるほどではない。"},{"spoiler":false,"text":"耳がよく、同じ室内にいれば、小声での会話もだいたい聞き取れる。他人の心情をかなり正確に読み取ることができ、祐一に「あと数年もすれば男を手玉に取りまくるだろうな」と思わせた、ある意味末恐ろしいお子さまでもある。"},{"spoiler":false,"text":"星華には、ちょっと苦手意識を持っているが、最終的には友達になる。"},{"spoiler":false,"text":"里沙ルートでは、祐一の心情を読み取り、クゥともども里沙との結婚を勧めた。"}],"source":"bangumi","sourceCharacterId":"133060"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f6b61c405b470eca4b2c59f39bd4ea10cdc0861c1e3b4f66b3f9fc763c808bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18ca0f82fb38c6d0a6f95199f5d39431c7dee531083bf44e550dbfd5625102d2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16966:133060:4830:1","source":"bangumi"}]},{"characterId":"char_c4651","characterName":"クゥ","sourceIds":{"bangumi":[{"characterId":"133061","match":"exact-normalized-name-in-linked-work","subjectId":"16966"}],"egsCharacterIds":["25988"],"vndbCharacterId":"c4651"},"originalCharacterName":"クゥ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The pet cat of Kana."},{"spoiler":false,"text":"Rarely for cats, she is extremely intelligent. This intelligence results in her having conversations with Yuuichi about the psyche of anthropoid animals, due to her knowledge of them."},{"spoiler":false,"text":"She helps Yuuichi and Risa free Silvie by discovering that Silvie's previous owner was mistreating her."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4651"},{"segments":[{"spoiler":false,"text":"猫種の人型動物で、それなりに高級な種。"},{"spoiler":false,"text":"猫らしくおっとりお気楽な性格。"},{"spoiler":false,"text":"本来、猫種の人型は犬より知能が劣る場合が多いのだが、クゥは文字を教わって以来、かなの父親が持つ膨大な書籍を読みあさり、さらには図書館に連れて行ってもらい、人型動物としては驚異的なレベルの知能を身につけた。"},{"spoiler":false,"text":"その知能の高さゆえ、主人であるかなに色々なことを教授することも多いが、「飼い猫」としてかなのことをとても大切に思っている。"},{"spoiler":false,"text":"また、主人公にとっては撫子と共に人型動物の生態についてアドバイザー的な存在である。"}],"source":"egs","sourceCharacterId":"25988","sourceWorkId":"6838","spoiler":false},{"segments":[{"spoiler":false,"text":"人型の猫で、かなの飼い猫。女の子で、やや青みを帯びた黒いサラサラのロングヘア。瞳は金色。"},{"spoiler":false,"text":"自他ともに健康には気を遣い、祐一が外食で適当なものを食べたりすると「またそんな栄養の偏ったものを」と、やんわり注意することもある。クゥ自身は、健康なことの証明であるビロードのような毛づやが自慢。服は、体毛に合った黒系が好み。赤いリボンタイを愛用する。種類はベルクトノワールという高級種。"},{"spoiler":false,"text":"猫としてはもちろん、人型ペットとして驚異的な知能を持ち、人間と同等以上の優れた知性と知識を持つ天才猫。人語を完璧にあやつり、難しい本でも読むことができ、実際に数々の本を読んで知識を増やしている（単に天才なだけでなく努力もしている）。"},{"spoiler":false,"text":"かなに対しては、知識を伝える先生役になることもあるが、基本的には「飼い主と飼い猫」という関係をわきまえ、かなを大切なご主人と慕っている。"},{"spoiler":false,"text":"祐一や里沙には、主に「人型ペットの立場から」様々なアドバイスを与える。真面目な話をする時以外は、猫らしい「のんびり、おっとり」な言動が多い。また、猫の特性を使って、他のペットたちの状況をのぞき見することもある。"},{"spoiler":false,"text":"猫としては非常に珍しい、軽作業犬資格を持っている（猫はほとんど作業資格を取得しないため、犬と同じ資格になっている）。また、国内に数匹しかいないという「警察猫」になれるだけの高い能力があるが、「いつも飼い主のそばにいて、愛らしいしぐさで飼い主をなごませること」が重要と考えていて、警察猫になる気はまったくない。"},{"spoiler":false,"text":"公園が好きで、のんびりしたい時や発情期のもやもやがある時は、公園でふだんは見せないような猫っぽい姿をさらしていたりする。飼い主どうしよりも、カイエとは仲がいい。"}],"source":"bangumi","sourceCharacterId":"133061"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a593116a4dda9f156120bb34b283ed7a4c27c32bef50b39af3195c5766464270.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a012257a2f32bbb9abdf9cdd796026b867384275456c641edd945c0d9e1d867.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永瀬江美弥","creatorId":"vndb:s61","sourcePersonId":"vndb:s61","canonicalEntityId":"vndb:s61","name":"永瀬 いくみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16966:133061:6549:1","source":"bangumi"}]},{"characterId":"char_c4652","characterName":"天堂寺 星華","sourceIds":{"bangumi":[{"characterId":"133062","match":"exact-normalized-name-in-linked-work","subjectId":"16966"}],"egsCharacterIds":["25989"],"vndbCharacterId":"c4652"},"originalCharacterName":"天堂寺 星華","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Kana's classmates who helps Yuuichi out on finding Mikan's owner. She has a crush on Yuuichi since she first met him, and later becomes one of his tutoring students just to spend time with him. She is a self-proclaimed expert on dogs and can be pretty hyper at times. She is the owner of Kaie, her anthropoid dog."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4652"},{"segments":[{"spoiler":false,"text":"かなの同級生。"},{"spoiler":false,"text":"父は警察官僚で、かなりのお嬢様。"},{"spoiler":false,"text":"主人公に一目ぼれしてしまい、必要ないのに彼に家庭教師を依頼したり、主人公宅に入り浸る理沙を勝手にライバル視する。"},{"spoiler":false,"text":"性格自体は素直で、良い子。"},{"spoiler":false,"text":"ドッグブリーダーとしても優秀で、人型犬“カイエ”の他に2匹の大型犬（普通の方）を可愛がる愛犬家。"},{"spoiler":false,"text":"そのカイエには、ボディーガード兼パートナーとして絶対の信頼をおいている。"}],"source":"egs","sourceCharacterId":"25989","sourceWorkId":"6838","spoiler":false},{"segments":[{"spoiler":false,"text":"かなの同級生でカイエの飼い主。ゆるくウェーブのかかった金髪のロングヘア。頭頂部の少し後ろで、赤いリボンでまとめている。瞳は明るい紫色。"},{"spoiler":false,"text":"父親は警察の官僚で、お嬢様。みかんの飼い主捜しに、警察関係者として力を貸したことが祐一との最初の出会い。まだ子どもだが、嗅覚が鋭く、祐一のフェロモンを敏感に感じ取り、祐一に一目惚れした。"},{"spoiler":false,"text":"お嬢様らしいところもあるが、決して嫌味なところはなく、素直な性格。生魚が苦手。"},{"spoiler":false,"text":"成績は優秀だが、祐一が好きなので、必要もないのにかなと同様の塾通いと、祐一の家庭教師（週2回）を受けている。祐一の部屋に入り浸っている里沙に、ライバル心を燃やしている。"}],"source":"bangumi","sourceCharacterId":"133062"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54c362d3362c46031b8cc7b30e70690b70e22843ca4e74a6ff3ebfe9b2de5068.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4726ac3323f0e0fffdae27123ff5f77e524782afc20f721c6d4e4500f6d7be8.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16966:133062:4956:1","source":"bangumi"}]},{"characterId":"char_c4653","characterName":"カイエ","sourceIds":{"bangumi":[{"characterId":"133063","match":"exact-normalized-name-in-linked-work","subjectId":"16966"}],"egsCharacterIds":["25990"],"vndbCharacterId":"c4653"},"originalCharacterName":"カイエ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The pet dog of Seika. He is just as intelligent as Kuu, is kind and polite, and behaves to his owner as if he is her butler of sorts, addressing Seika as \"milady\"."},{"spoiler":false,"text":"He was away to do advanced studies in the beginning of the game, but later returned."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4653"},{"segments":[{"spoiler":false,"text":"星華の愛犬（♂）。"},{"spoiler":false,"text":"犬種は中型の「スコティッシュシェパード」。"},{"spoiler":false,"text":"外見通り落ち着いた物腰だが「冷たい」というようなことはなく、みかんたちと仲良し。"},{"spoiler":false,"text":"ただ、虎太郎に対しては邪険な態度を取ることが多い。"},{"spoiler":false,"text":"警察犬としてもきわめて優秀で、主である星華に絶対の忠誠を誓っている。"},{"spoiler":false,"text":"しかし、星華にはどこか犬としての忠誠を超えた思慕を寄せているようにも見えるのだが…。"}],"source":"egs","sourceCharacterId":"25990","sourceWorkId":"6838","spoiler":false},{"segments":[{"spoiler":false,"text":"人型の犬。男の子で、青みを帯びた白銀色の髪。瞳はライトパープル。色白で、上品さを漂わせている。犬種はスコティッシュシェパード。作業犬向きの中型犬種。"},{"spoiler":false,"text":"賢く、また冷静な性格で、飼い主の星華を深く慕っている。それは単なる優しい飼い主というだけではなく、愛情を感じているほど。犬としては、みかんにも愛情を感じている。"},{"spoiler":false,"text":"特級警察犬の資格を持ち、自身が警察犬として働くだけでなく、後進の指導にも当たっている。クリーエンという名犬（約80年前に活躍したウルフハウンド）の、ほぼ直系の血筋。親はクリーエンVI世と呼ばれ、カイエ自身はクリーエンVII世の有力な候補。"},{"spoiler":false,"text":"小さい頃は、虎太郎に教育された。しかし、今は虎太郎とは少し距離を置いていて、あまり仲はよくない。"}],"source":"bangumi","sourceCharacterId":"133063"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cdde4b0aba7a16a94efe5b1e74ecfc5d4b4555a77117d9845a540380e2c92fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/551183183ecb9d42973015ba47ff72a9796c04577f0a1dd2df0cc2dcada48dd4.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽吹梨里","creatorId":"vndb:s57","sourcePersonId":"vndb:s57","canonicalEntityId":"vndb:s57","name":"羽吹 梨里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16966:133063:6547:1","source":"bangumi"}]},{"characterId":"char_vndb_c4654","characterName":"遊佐 祐一","sourceIds":{"vndbCharacterId":"c4654"},"originalCharacterName":"遊佐 祐一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the story. He appears as friendly and helpful, but detaches himself from others, cynically denying the existence of true love."},{"spoiler":false,"text":"His cold personality is a result of his upbringing, which took place in a brothel. Over many years, he came to associate love with material gain and sexual gratification, and thus does not hold any stock in it."},{"spoiler":false,"text":"Yuuichi lives alone in an apartment, attends a nearby college and earns money by teaching a junior cram-school."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4654"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae46f16c37d624ad2b753f28bb29705d5173f6bb19bd1cd6ad3ee69994d226b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63dec94440375af2a1b6ac76a9bc62a49a3a92fc54bbd21f5fcb497b78b5ebee.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p394","sourceCompanyId":"egs:brand:9","canonicalEntityId":"vndb:p394","name":"ivory","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:6838:9","source":"egs"},{"companyId":"vndb:p16171","sourceCompanyId":"vndb:p16171","canonicalEntityId":"vndb:p16171","name":"VienDesu! Porting Team","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:134463:v812","source":"vndb"},{"companyId":"vndb:p28776","sourceCompanyId":"vndb:p28776","canonicalEntityId":"vndb:p28776","name":"FlowerCat","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:164579:v812","source":"vndb"},{"companyId":"vndb:p394","sourceCompanyId":"vndb:p394","canonicalEntityId":"vndb:p394","name":"ivory","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:1905:v812","source":"vndb"},{"companyId":"vndb:p2531","sourceCompanyId":"vndb:p2531","canonicalEntityId":"vndb:p2531","name":"Lolicon Team","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:22356:v812","source":"vndb"},{"companyId":"vndb:p541","sourceCompanyId":"vndb:p541","canonicalEntityId":"vndb:p541","name":"Yandere Translations","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:2318:v812","source":"vndb"},{"companyId":"vndb:p541","sourceCompanyId":"vndb:p541","canonicalEntityId":"vndb:p541","name":"Yandere Translations","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:3777:v812","source":"vndb"},{"companyId":"vndb:p394","sourceCompanyId":"vndb:p394","canonicalEntityId":"vndb:p394","name":"ivory","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:38175:v812","source":"vndb"},{"companyId":"vndb:p11621","sourceCompanyId":"vndb:p11621","canonicalEntityId":"vndb:p11621","name":"ShinseiTom","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:47433:v812","source":"vndb"},{"companyId":"vndb:p394","sourceCompanyId":"vndb:p394","canonicalEntityId":"vndb:p394","name":"ivory","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:8696:v812","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
