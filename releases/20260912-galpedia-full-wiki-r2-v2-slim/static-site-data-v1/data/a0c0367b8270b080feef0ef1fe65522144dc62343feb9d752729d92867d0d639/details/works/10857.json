ve","relationId":"vndb:vn-staff:14144","source":"vndb"}],"other":[{"creditedName":"癸乙夜","creatorId":"vndb:s2829","sourcePersonId":"egs:creator:12718","canonicalEntityId":"vndb:s2829","name":"癸乙夜","detail":"ムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:68660","source":"egs"},{"creditedName":"橋本みゆき","creatorId":"vndb:s390","sourcePersonId":"egs:creator:4503","canonicalEntityId":"vndb:s390","name":"橋本みゆき","detail":"主題歌 「glitter」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:70629","source":"egs"},{"creditedName":"橋本 みゆき","creatorId":"vndb:s390","sourcePersonId":"vndb:s390","canonicalEntityId":"vndb:s390","name":"橋本 みゆき","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:14145","source":"vndb"},{"creditedName":"癸 乙夜","creatorId":"vndb:s2829","sourcePersonId":"vndb:s2829","canonicalEntityId":"vndb:s2829","name":"癸乙夜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:14152","source":"vndb"},{"creditedName":"鈴木 マサキ","creatorId":"vndb:s11327","sourcePersonId":"vndb:s11327","canonicalEntityId":"vndb:s11327","name":"鈴木 マサキ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:14153","source":"vndb"}]},"cast":[{"characterId":"char_c12398","characterName":"レナ＝ジェミニス","sourceIds":{"bangumi":[{"characterId":"21231","match":"exact-normalized-name-in-linked-work","subjectId":"17851"}],"egsCharacterIds":["19267"],"vndbCharacterId":"c12398"},"originalCharacterName":"レナ＝ジェミニス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"双子の姉で活発でおしゃべり、元気印の女の子。"},{"spoiler":false,"text":"魔法使いの家系で、魔法発動には長けているが、妹・ニナと協力することで、一人前の力を発揮する。"},{"spoiler":false,"text":"そのため、学園内では基本的に二人一組で行動している様子。"},{"spoiler":false,"text":"時折、魔法が暴走するが、天真爛漫なため、あっけらかんとしている事が多い。"},{"spoiler":false,"text":"「大丈夫、わたしは本番強いんだから」"}],"source":"egs","sourceCharacterId":"19267","sourceWorkId":"9832","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法使いの家系で学園の後輩にあたる一年生。ニナという双子の妹がいる。ニナと対照的で性格は元気系。活発でおしゃべり。"},{"spoiler":false,"text":"魔法の発動には長けているが、髪飾りのラピス・アクセサリは二ナのものとあわせることで、一人前の力を発揮するため、学園内では基本的に二人一組で行動する。"},{"spoiler":false,"text":"入学試験ではその素質を買われて入学したものの、それぞれ単体ではまったくダメ。"},{"spoiler":false,"text":"天真爛漫で魔法が暴走しても、あっけらかんとしている面もあり。"},{"spoiler":false,"text":"「大丈夫。あたしは本番強いんだから」"}],"source":"bangumi","sourceCharacterId":"21231"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54c597f4ccb5474c8274433097740bf4a931762fe4ea42cd3b6184ae4e752275.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/997ad3b7bea428acff2669ef2bcec2ffb06812abc41afb23710ec5a39eead634.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:82405:21231:4810:1","source":"bangumi"}]},{"characterId":"char_c12399","characterName":"セーラ＝フィニス＝ヴィクトリア","sourceIds":{"bangumi":[{"characterId":"21229","match":"exact-normalized-name-in-linked-work","subjectId":"17851"}],"egsCharacterIds":["19265"],"vndbCharacterId":"c12399"},"originalCharacterName":"セーラ＝フィニス＝ヴィクトリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Seera is a Fourth-Tier magician and the daughter of Elda. She is a genius at magic and at times, very arrogant."},{"spoiler":false,"text":"She is also a cousin of Karen from 77."}],"source":"vndb","sourceCharacterId":"c12399"},{"segments":[{"spoiler":false,"text":"学園長の娘で、生粋の魔法使いの血筋を持つ少女。"},{"spoiler":false,"text":"学園でもエリート中のエリートでプライドも高い。"},{"spoiler":false,"text":"才能にあぐらをかかない努力家で、実力もトップクラスなのだが、“魔法使いの血筋”を気負いすぎる面があり、周囲から浮いてしまうこともしばしば。"},{"spoiler":false,"text":"大樹に特殊な能力があると信じ、正体を掴もうとするが……。"},{"spoiler":false,"text":"「あなたたちには、絶対に負けませんから」"}],"source":"egs","sourceCharacterId":"19265","sourceWorkId":"9832","spoiler":false},{"segments":[{"spoiler":false,"text":"異世界からやってきた魔法使いの血筋。大樹やアリシアと同じ二年生で学園長の娘。"},{"spoiler":false,"text":"魔法使いの中でもエリート中のエリートなので、プライドが高い。"},{"spoiler":false,"text":"当然、魔法の実力はトップクラスだが、血筋のこともあり『高名な魔法使いになろう』という上昇意識がとても強い。"},{"spoiler":false,"text":"そのため、努力は惜しまないのだが、逆に周囲から浮いてしまうことも多々あり。"},{"spoiler":false,"text":"とある理由から、大樹に特殊な能力があるのではないかと信じ込み、その正体をつかもうとしている。"},{"spoiler":false,"text":"「あなたたちには、絶対負けませんから」"}],"source":"bangumi","sourceCharacterId":"21229"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1f76daf5bc27d1d909905b79880fffa73947e462ce4dfde1d445849addd870d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/0934b02324d8393ab3f6558ec845540fa4842f3b8de29e230ac481760fe6c7c6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:82405:21229:4432:1","source":"bangumi"}]},{"characterId":"char_c12400","characterName":"ニナ＝ジェミニス","sourceIds":{"bangumi":[{"characterId":"21232","match":"exact-normalized-name-in-linked-work","subjectId":"17851"}],"egsCharacterIds":["19268"],"vndbCharacterId":"c12400"},"originalCharacterName":"ニナ＝ジェミニス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"双子の妹で真面目で誠実、姉の世話役。"},{"spoiler":false,"text":"レナが発動させた魔法を制御する担当で、二人で一人前なため、学園では姉といつも一緒。"},{"spoiler":false,"text":"手のかかる上を持っていることから、同じ境遇の小雪と共感していて仲がいい。"},{"spoiler":false,"text":"「ご迷惑でなければ、ですけれど」"}],"source":"egs","sourceCharacterId":"19268","sourceWorkId":"9832","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法使いの家系。学園の後輩で一年生。レナという双子の姉がいる。レナと対照的で性格はおちついていて、誠心誠意まじめ。暴走気味な姉の世話にいつも奔走している。"},{"spoiler":false,"text":"魔法の制御には長けているが、髪飾りのラピス・アクセサリはレナのものとあわせることで、一人前の力を発揮するため、学園内では基本的に二人一組で行動する。"},{"spoiler":false,"text":"入学試験ではその素質を買われて入学したものの、それぞれ単体ではやはりまったくダメ。"},{"spoiler":false,"text":"手のかかる姉（兄）を持ってしまったことから、同じ境遇の小雪と共感していて仲がいい。"},{"spoiler":false,"text":"「ご迷惑でなければ、ですけれど」"}],"source":"bangumi","sourceCharacterId":"21232"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3ef5a0c9b88c3675fa6769b640124e6d483fd678d01cef8183c74bb59da3b9d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/faafa0a11933ea879209111451a4e90aa96cc1e3b332b7477962d6582c684122.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:82405:21232:4956:1","source":"bangumi"}]},{"characterId":"char_c12403","characterName":"アリシア＝インファンス","sourceIds":{"bangumi":[{"characterId":"21227","match":"exact-normalized-name-in-linked-work","subjectId":"17851"}],"egsCharacterIds":["19263"],"vndbCharacterId":"c12403"},"originalCharacterName":"アリシア＝インファンス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Alicia is the main heroine of Magus Tale. She is a magician who fell from the sky and is suffering from amnesia."}],"source":"vndb","sourceCharacterId":"c12403"},{"segments":[{"spoiler":false,"text":"大樹が島で最初に出会った記憶喪失の女の子。"},{"spoiler":false,"text":"思いやりがあり、心優しく慎み深い性格。"},{"spoiler":false,"text":"ひょんなことから魔法の才能を買われ、身元不明のまま魔法学園に入学するが、生まれたてのヒヨコのように、大樹の後をついて回ることが多い。"},{"spoiler":false,"text":"「ここはどこなんでしょう？　わたしは誰なんでしょう？」"}],"source":"egs","sourceCharacterId":"19263","sourceWorkId":"9832","spoiler":false},{"segments":[{"spoiler":false,"text":"大樹が島に流れ着いた際に気を失い、隣に倒れていた少女。"},{"spoiler":false,"text":"性格は思いやりがあり、基本的に心優しい慎み深い性格。言葉遣いも丁寧。"},{"spoiler":false,"text":"記憶喪失で、その殆どが謎に包まれている。（自分の名前や生い立ち以外は覚えている）"},{"spoiler":false,"text":"不法侵入者として、学園関係者から大樹と共に追われる最中、ラピス・アクセサリの力なしで、魔法を使い、大樹を助ける。"},{"spoiler":false,"text":"ラピス・アクセサリなしで、魔法を操れる素質を買われ、身元不明のままフォーティア魔法学園に入学。大樹と同学年。"},{"spoiler":false,"text":"最初の出会いのためか、大樹の後をついて回ることが多い。"},{"spoiler":false,"text":"「ここはどこなんでしょう？　わたしは誰なんでしょう？」"}],"source":"bangumi","sourceCharacterId":"21227"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83ee2f63ab788cb9042b3af8a8c7e264e1925285b8b9ee7e4e652bc584ae42c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/129576de53f89a4d1fefd5abcc29652db96350ba57d9f9618d35b0ddfa4fe5e5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結下みちる","creatorId":"vndb:s794","sourcePersonId":"vndb:s794","canonicalEntityId":"vndb:s794","name":"結下 みちる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:82405:21227:4705:1","source":"bangumi"}]},{"characterId":"char_c12404","characterName":"天ヶ瀬 小雪","sourceIds":{"bangumi":[{"characterId":"21228","match":"exact-normalized-name-in-linked-work","subjectId":"17851"}],"egsCharacterIds":["19264"],"vndbCharacterId":"c12404"},"originalCharacterName":"天ヶ瀬 小雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daiki's adopted sister who was taken into their home after she had lost her parents. She is also a classmate of Lena and Nina, and has a good relationship with them."}],"source":"vndb","sourceCharacterId":"c12404"},{"segments":[{"spoiler":false,"text":"一つ下の大樹の義妹。"},{"spoiler":false,"text":"明るく人当たりも良いため、学園内では人気者だが、大樹の事になると、世話焼きモードに突入する。"},{"spoiler":false,"text":"大樹の学園への転入で、また一緒に過ごせること大喜びするが、浮かれた気持ちからポカミスを連発するという可愛らしい一面も見せる。"},{"spoiler":false,"text":"「……わたしも、お兄ちゃんがいてくれると嬉しいな」"}],"source":"egs","sourceCharacterId":"19264","sourceWorkId":"9832","spoiler":false},{"segments":[{"spoiler":false,"text":"大樹の義理の妹。学年は一級下。幼い頃、両親をなくし大樹の家に引き取られた。"},{"spoiler":false,"text":"性格は明るく、人当たりも良い人気者。だが、大樹限定でお節介焼き。言葉遣いはフレンドリー。"},{"spoiler":false,"text":"生来魔法の素養が高く、交換留学生に選ばれ、フォーティア魔法学園で魔法を学んでいる。"},{"spoiler":false,"text":"魔法世界の住人の負けない程、優秀な魔法使いとしての成績を残している。"},{"spoiler":false,"text":"大樹が学園に転入することになり、また一緒に過ごせることになり、大喜び。その喜びから、ポカミスが増えてしまったりする、可愛らしい面もあり。"},{"spoiler":false,"text":"「……わたしも、お兄ちゃんが居てくれると嬉しいな」"}],"source":"bangumi","sourceCharacterId":"21228"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4f5a8283be4db4bf8d57d5a6df706149b74208673cf43b3cedefb7a9ddd45e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/027372645512c125ad620bbbe674c0d20c86fee8dcf0388e5be3e19eac956bf3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:82405:21228:4809:1","source":"bangumi"}]},{"characterId":"char_c12405","characterName":"九条 優花","sourceIds":{"bangumi":[{"characterId":"21230","match":"exact-normalized-name-in-linked-work","subjectId":"17851"}],"egsCharacterIds":["19266"],"vndbCharacterId":"c12405"},"originalCharacterName":"九条 優花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daiki's senpai who has a very weak body and is often hospitalized. Yuuka traveled from the humans' world in order to study magic."}],"source":"vndb","sourceCharacterId":"c12405"},{"segments":[{"spoiler":false,"text":"学園の先輩で三年生。"},{"spoiler":false,"text":"……なのだが、身長など全てにおいてミニマム。"},{"spoiler":false,"text":"実家は超お金持ちのお嬢様だが、気さくな性格でよく冗談を言ったり、大樹をからかったりしている。"},{"spoiler":false,"text":"学園入学後、病に倒れ授業は休みがちに。"},{"spoiler":false,"text":"現在も病弱である。"},{"spoiler":false,"text":"「大樹君、ダメだよ、そんなことしちゃ」"}],"source":"egs","sourceCharacterId":"19266","sourceWorkId":"9832","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の先輩。三年生。大樹達の先輩にあたるのだが、身長等全てにおいてミニマム。"},{"spoiler":false,"text":"九条家（前作いな☆こい！で登場した大財閥）の人間で実家は超お金持ちではあるが、それを感じさせない気さくな性格。"},{"spoiler":false,"text":"冗談を言ったりするのが好きで、大樹をかわいらしくからかう。口調は親しみやすい、だよもん。"},{"spoiler":false,"text":"『高い魔力がある』と期待され、二年前島に留学生として渡ったが、入学してしばらくしてから病に倒れ、授業は休みがち。現在も病弱である。"},{"spoiler":false,"text":"そのせいか、植物を育てるのが好きなため、学園の中庭にある花壇の世話に精を出している。"},{"spoiler":false,"text":"「大樹君、ダメだよ、そんなことしちゃ」"}],"source":"bangumi","sourceCharacterId":"21230"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61d1d1bf490e2c81855e347169c7e55fcbebedd0c507b6e60c7a0975b7a5f611.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14284df0b1463545065ea5ab4de4f4494715667f1040388a7930cb0353656361.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:82405:21230:4490:1","source":"bangumi"}]},{"characterId":"char_vndb_c12406","characterName":"ミレーヌ＝サーヴィス","sourceIds":{"vndbCharacterId":"c12406"},"originalCharacterName":"ミレーヌ＝サーヴィス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/814ccdd70bbb96a2361802d9d68253a06fa7e3a8da053cae12c81db623b78733.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/charact