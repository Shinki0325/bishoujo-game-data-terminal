yStatus":"auto-confirmed","relationId":"egs:work-creator:219575","source":"egs"},{"creditedName":"tororo(tororo団長、松村和俊)","creatorId":"egs:creator:2582","sourcePersonId":"egs:creator:2582","canonicalEntityId":"egs:creator:2582","name":"tororo(tororo団長、松村和俊)","detail":"プロデューサー","roleCode":"other","roleLabel":"其他","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:70839","source":"egs"},{"creditedName":"tororo","creatorId":"vndb:s1216","sourcePersonId":"vndb:s1216","canonicalEntityId":"vndb:s1216","name":"松村 和俊","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:8180","source":"vndb"},{"creditedName":"恋純 ほたる","creatorId":"vndb:s1908","sourcePersonId":"vndb:s1908","canonicalEntityId":"vndb:s1908","name":"恋純 ほたる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:8182","source":"vndb"},{"creditedName":"タカノリ","creatorId":"vndb:s14476","sourcePersonId":"vndb:s14476","canonicalEntityId":"vndb:s14476","name":"タカノリ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:8183","source":"vndb"}]},"cast":[{"characterId":"char_c4012","characterName":"朝倉 音夢","sourceIds":{"bangumi":[{"characterId":"20250","match":"exact-normalized-name-in-linked-work","subjectId":"19078"},{"characterId":"20250","match":"exact-normalized-name-in-linked-work","subjectId":"4044"}],"egsCharacterIds":["18098"],"vndbCharacterId":"c4012"},"originalCharacterName":"朝倉 音夢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1228"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"37"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nemu is Jun'ichi's adopted sister. She is actually in love with Jun'ichi and becomes mad when any other girl shows affection to him and uses \"accidental\" violence to stop the affection between him and another person. She wears a bell as an accessory, given to her by Jun'ichi when they were young. When her mood turns sour, she becomes excessively polite and antisocial, a condition that Jun'ichi calls \"hidden Nemu\". Her cooking is described as lethal, to the point that Jun'ichi quietly calls her the \"Murderous Chef\"."}],"source":"vndb","sourceCharacterId":"c4012"},{"segments":[{"spoiler":false,"text":"主人公と同じ誕生日、同い年の双子のクラスメイトと、ありえないような話だが……、実際のところは血が繋がっていない、子供のころに朝倉家に引き取られた少女。"},{"spoiler":false,"text":"家事万能にみせかけて、食事を作ると殺し屋が通販を申し込んできそうなまずい物を生み出す特殊な才能を持つ。"},{"spoiler":false,"text":"ちなみに、兄のずぼらさに頭を悩ませているが、そのずぼらさに胸をときめかせている節もある、多感なお年頃。"}],"source":"egs","sourceCharacterId":"18098","sourceWorkId":"2112","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の義理の妹。"},{"spoiler":false,"text":"兄さんの世話を焼くのが大好きなのだが、実は兄さんを頼りにしている世話のかかる妹。"},{"spoiler":false,"text":"二人とも、その掛け合いを楽しんでいる節も。"}],"source":"egs","sourceCharacterId":"18098","sourceWorkId":"2445","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・朝倉の義妹。"},{"spoiler":false,"text":"世話焼きだが、ヤキモチ焼きでもある。"},{"spoiler":false,"text":"現在は看護士を目指し、本島の看護学校へ通っている。"},{"spoiler":false,"text":"「兄さん……なんだか違う人みたい」"}],"source":"egs","sourceCharacterId":"18098","sourceWorkId":"10905","spoiler":false},{"segments":[{"spoiler":false,"text":"父母早年因车祸丧生，之后被朝仓家收养。"},{"spoiler":false,"text":"与纯一同一天出生，但称纯一为兄（「兄さん」）。因为身体虚弱，经常发热，所以纯一经常帮她检查体温。"},{"spoiler":false,"text":"在学校担任风纪委员，成绩优秀，性格活泼可爱，所以在学校很受欢迎。其料理水平实在不敢恭维，甚至连纯一也畏惧，因此多以便当与外卖解决，很少下厨。"},{"spoiler":false,"text":"非常在意纯一，对纯一抱有超越兄妹的感情，见到纯一跟其他女生一起会动用暴力镇压。也嫉妒纯一跟樱的关系，将樱在美国写给纯一的信全部丢掉。后前往护理学校实习。"},{"spoiler":false,"text":"几经波折,在D.C.S.S中的结局,因为纯一和她各自的情侣表而想起一切,后与纯一结婚.D.C II的故事以音梦与纯一结婚为基础，二代女主角朝仓音姬和朝仓由梦为纯一和音梦的孙女。"}],"source":"bangumi","sourceCharacterId":"20250"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d33d0dbab5448e7891e3f7f4e1bdf2cd4d0ed5f25adc5bed2e442acd330f939.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0d1a6849235bf1decc5d17800a93de798d521fce1741c22ac95d36a9edbec50.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳥居 花音","creatorId":"vndb:s563","sourcePersonId":"vndb:s563","canonicalEntityId":"vndb:s563","name":"森山 理来","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:3343","source":"vndb"}]},{"characterId":"char_c4013","characterName":"さくらんぼ","sourceIds":{"bangumi":[{"characterId":"10717","match":"exact-normalized-name-in-linked-work","subjectId":"19078"},{"characterId":"10717","match":"exact-normalized-name-in-linked-work","subjectId":"4044"}],"egsCharacterIds":["17877"],"vndbCharacterId":"c4013"},"originalCharacterName":"さくらんぼ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"904"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"68"},"height":{"reviewState":"no-conflict","source":"vndb","value":"140"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"51"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"31"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Jun'ichi's cousin and first love. She is a very lively girl who shows great affection towards Jun'ichi, much to Nemu's dismay. She is sometimes seen with Utamaru, a white cat. Actually older than Jun'ichi. She inherited her grandmother's magical ability, and despite the passing of several years, her appearance remains largely unchanged from what Jun'ichi and Nemu remember. Has an IQ of 180."}],"source":"vndb","sourceCharacterId":"c4013"},{"segments":[{"spoiler":false,"text":"主人公と音夢の幼馴染で、従姉で、隣の家に住んでいた女の子。"},{"spoiler":false,"text":"六年前の春に海外に引っ越してしまったきり音信不通だったのだが、最近よく夢に現れては騒いでいなくなる迷惑極まりない存在……、夢だけど。"},{"spoiler":false,"text":"生来から甘えん坊で、お気楽極楽トンボな性格で、マスコットか珍獣のように可愛がられる。"},{"spoiler":false,"text":"主人公にベタ惚れしていて、義理の妹となった音夢に対抗して、主人公を「お兄ちゃん」と呼んでは 足や腰にへばりつく癖をもつ。"},{"spoiler":false,"text":"どのような成長を遂げたにしろ、再び出会う時に 主人公に訪れるのは、すごい迷惑か、ものすごい迷惑かのどちらかであろう……。"}],"source":"egs","sourceCharacterId":"17877","sourceWorkId":"2112","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の従姉にして、幼馴染でお兄ちゃん子。"},{"spoiler":false,"text":"甘えん坊でお気楽極楽な性格をしている。"},{"spoiler":false,"text":"珍獣かマスコット的な存在。"}],"source":"egs","sourceCharacterId":"17877","sourceWorkId":"2445","spoiler":false},{"segments":[{"spoiler":false,"text":"風見学園で講師を勤める天才少女。"},{"spoiler":false,"text":"朝倉のいとこで、感情表現が豊か。"},{"spoiler":false,"text":"IQ180を誇り、何でも完璧にこなすが、アメリカ帰りのためか、漢字の読み書きは苦手な様子。"},{"spoiler":false,"text":"「最初からボクのせいだったんだ！　ボクのせいでみんないなくなっちゃったんだよ!!」"}],"source":"egs","sourceCharacterId":"17877","sourceWorkId":"10905","spoiler":false},{"segments":[{"spoiler":false,"text":"立夏や清隆と深い縁で結ばれた女性。初音島や魔法について詳しい。"}],"source":"egs","sourceCharacterId":"17877","sourceWorkId":"25266","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と音夢の幼馴染。また従姉でもあり、隣の家に住んでいた女の子でもある。"},{"spoiler":false,"text":"６年前の春に海外に引っ越してしまったのだが、最近よく夢に現れては騒いでいなくなる迷惑極まりない存在……夢だけど。"},{"spoiler":false,"text":"生来から、甘えん坊でお気楽極楽トンボな性格で、 マスコットか珍獣のように可愛がられる。"},{"spoiler":false,"text":"主人公にベタ惚れしていて、義理の妹となった音夢に対抗して、主人公を「お兄ちゃん」と呼んでは 足や腰にへばりつく癖をもつ。"},{"spoiler":false,"text":"どのような成長を遂げたにしろ、再び出会う時に 主人公に訪れるのは、すごい迷惑か、ものすごい迷惑かのどちらかであろう……。"}],"source":"bangumi","sourceCharacterId":"10717"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa80b7cb2d81a368b947bacf33f67787c30200f990d114d29a8d5cf3c07c753a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96d37bf8817f06516a7ecaba62fe698b836b4db3ac7c64d9819721e08f3d4b52.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北都 南","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:3340","source":"vndb"}]},{"characterId":"char_c4014","characterName":"白河 ことり","sourceIds":{"bangumi":[{"characterId":"2497","match":"exact-normalized-name-in-linked-work","subjectId":"19078"},{"characterId":"2497","match":"exact-normalized-name-in-linked-work","subjectId":"4044"}],"egsCharacterIds":["18095"],"vndbCharacterId":"c4014"},"originalCharacterName":"白河 ことり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"620"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"41"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kotori is the school's idol and star singer."},{"spoiler":true,"text":"Although she can hear other people's thoughts, she carefully hides this ability."},{"spoiler":false,"text":"She became close to Jun'ichi because he was the only one in the male student body that didn't try to idolize her. She has a habit of using cute greetings to people she feels especially close to."}],"source":"vndb","sourceCharacterId":"c4014"},{"segments":[{"spoiler":false,"text":"誰にでもやさしく、容姿も美しく、高いカリスマ性を持つ学園のアイドル。"},{"spoiler":false,"text":"風見学園付属と本校の両方の学生に人気があり、実は非公認のファンクラブまであるとかないとか……。"},{"spoiler":false,"text":"立場的には高嶺の華のようだが、話をすると意外と茶目っ気のある笑顔を振り撒いてくれる、ミネラルウォーターのように清々しい少女なのだ。"},{"spoiler":false,"text":"帽子がチャームポイントで、趣味で集めてもいるらしい。"},{"spoiler":false,"text":"どこぞの田舎に、似たような趣味をもつ従姉の絵描きがいるようだが、にんともかんとも……。"}],"source":"egs","sourceCharacterId":"18095","sourceWorkId":"2112","spoiler":false},{"segments":[{"spoiler":false,"text":"美人で成績優秀、誰にでもやさしいという、絵に描いたような学園のアイドル。"},{"spoiler":false,"text":"意外と茶目っ気に溢れていて、話をすると面食らいながらも心が安らぐ不思議な少女。"}],"source":"egs","sourceCharacterId":"18095","sourceWorkId":"2445","spoiler":false},{"segments":[{"spoiler":false,"text":"風見学園本校2年生。"},{"spoiler":false,"text":"品行方正で成績優秀、容姿端麗で歌もうまく、学園ではアイドル的な扱いを受けている。"},{"spoiler":false,"text":"でも、本人はちょっぴりお茶目な普通の女の子。"}],"source":"egs","sourceCharacterId":"18095","sourceWorkId":"8352","spoiler":false},{"segments":[{"spoiler":false,"text":"品行方正、成績優秀、容姿端麗、歌唱力抜群で、学園のアイドル的存在。"},{"spoiler":false,"text":"しかしその正体は、ちょっぴりお茶目な普通の女の子だったりする。"},{"spoiler":false,"text":"「本当の恋人は、私なんだから…」"}],"source":"egs","sourceCharacterId":"18095","sourceWorkId":"10905","spoiler":false},{"segments":[{"spoiler":false,"text":"誰にでも優しく歌が上手くその上美人で成績も優秀な学園のアイドル。風見学園付属と本校の両方の学生から人気があり、非公式ファンクラブの存在さえ仄めかされる。近づきにくいように見えて話して見ると実は初対面の相手にも気さくに接するさわやかな少女である。チャームポイントである帽子は親からの薦めで所属している聖歌隊のものであり、帽子集めが趣味である。好きなものは甘い物全般、桜の花、オレンジジュース。人混み、犬、辛い物全般が苦手である。4人家族であり、純一のクラス3年1組の担任白河暦は義姉。"}],"source":"bangumi","sourceCharacterId":"2497"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/fff2fe81c096ff49c88ed07256059d4fb7f48de621e35e765e12690b6be94ffb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/112b81129d59584fd49b31a01aa97f542e5aed4fbb00287546bdcd6909270da8.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"日向 裕羅","creatorId":"vndb:s562","sourcePersonId":"vndb:s562","canonicalEntityId":"vndb:s562","name":"日向 裕羅","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:3342","source":"vndb"}]},{"characterId":"char_c4015","characterName":"水越 萌","sourceIds":{"bangumi":[{"characterId":"54840","match":"exact-normalized-name-in-linked-work","subjectId":"19078"},{"characterId":"54840","match":"exact-normalized-name-in-linked-work","subjectId":"4044"}],"egsCharacterIds":["18102"],"vndbCharacterId":"c4015"},"originalCharacterName":"水越 萌","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1009"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"41"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Moe is a gentle girl who is often seen throughout the series sitting on the roof at lunchtime cooking and eating nabe with her younger sister, Mako. She is very polite, but can be dim-witted at times, and can fall asleep anywhere at any time, even when she's walking. Sometimes she carries a small xylophone, although it's not because she wants to be a good player of said instrument. She is very knowledgeable about nabe, and can talk for hours about said subject."},{"spoiler":true,"text":"In reality, the reason why she sleeps so often is due to her taking sleeping pills to see her deceased childhood friend, Keiichi, in her dreams."}],"source":"vndb","sourceCharacterId":"c4015"},{"segments":[{"spoiler":false,"text":"風見学園本校生で、主人公や音夢たちの先輩にあたる少女。"},{"spoiler":false,"text":"ぼけぼけというか、ぽや～っとした天然色のお嬢様で、寝るのが好きというか、歩いている最中にもに寝てしまうこともしばしば……、ただしお裁縫などは、作業が遅いけど意外と得意。"},{"spoiler":false,"text":"鍋に一家言があるらしい。"},{"spoiler":false,"text":"音楽部に所属していて木琴を担当していたりと（腕はともかく）、朗らかな先輩。"},{"spoiler":false,"text":"あまりにも朗らかで、遅刻してしまい、誰もいない桜並木を木琴を叩きながら歩いているという不思議な姿も目撃 されている。"},{"spoiler":false,"text":"実は、彼女を知らない学生には学園七不思議に間違えられている節もあるとかないとか……。"},{"spoiler":false,"text":"彼女の妹である眞子は、全く逆の性格で、主人公のクラスメイトだとか。"}],"source":"egs","sourceCharacterId":"18102","sourceWorkId":"2112","spoiler":false},{"segments":[{"spoiler":false,"text":"学園七不思議に登録されているほど、寝ながら生活している先輩。"},{"spoiler":false,"text":"目を覚ましていても寝言のようなことしか言わないボケっぷりを発揮する。"}],"source":"egs","sourceCharacterId":"18102","sourceWorkId":"2445","spoiler":false},{"segments":[{"spoiler":false,"text":"おっとりポケポケした性格で、どこででも寝てしまう。"},{"spoiler":false,"text":"音楽部に所属しており、いつも携帯している木琴で、不思議な音色を奏でるのが得意。"},{"spoiler":false,"text":"「――大切な人を失った辛さ、私もよくわかりますから」"}],"source":"egs","sourceCharacterId":"18102","sourceWorkId":"10905","spoiler":false},{"segments":[{"spoiler":false,"text":"風見学園本校生で、主人公や音夢たちの先輩にあたる。"},{"spoiler":false,"text":"ぼけぼけというか、ぽや～っとした天然色のお嬢様で、寝るのが好き。というか、歩いている最中に寝てしまうこともしばしば……。ただしお裁縫などは、作業が遅いけど意外と得意。"},{"spoiler":false,"text":"音楽部で木琴を担当。しかし腕前は…？マーク。　あまりにもマイペースで、遅刻しているというのに、桜並木を木琴を叩きながら歩いているという不思議な姿も目撃されている。"},{"spoiler":false,"text":"彼女の妹水越眞子が主人公のクラスメイトにいるが、眞子はまったく逆の性格で、姉をフォローしている。"},{"spoiler":false,"text":"昼休みには妹と一緒に屋上でお鍋をつついているが、お鍋には一家言があるらしい。"}],"source":"bangumi","sourceCharacterId":"54840"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eeffa963a9a81690463f5759439315c5fad357c8d91795557ddf85b698f9fcd9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b410b5bf9d9aa72e7aac76b723e64bd13f1f6565849090294225c3ec37ca04c.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏野 向日葵","creatorId":"vndb:s855","sourcePersonId":"vndb:s855","canonicalEntityId":"vndb:s855","name":"瀬那 歩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:3344","source":"vndb"}]},{"characterId":"char_vndb_c12871","characterName":"三柴 亮介","sourceIds":{"vndbCharacterId":"c12871"},"originalCharacterName":"三柴 亮介","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mishiba Ryousuke is an ill young guy suffering from severe psychological problems who escaped from his house confinement in search for freedom. On the night of his escape, he met a strange young woman at one of the cliffs of a neighbouring Tokiwa village. Very soon, they developed a certain relationship and neither of them will be happy to part away from each other."}],"source":"vndb","sourceCharacterId":"c12871"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48c091523620c1ceca1f8b67fce4e7b4a1a9db929ed2804c10acc98e8a6e98e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c2ce160dd0f8677cd90264ba46e4a6819db75fbdcc29bf1c1b72f058cd4190c.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c12873","characterName":"小沼 桐子","sourceIds":{"vndbCharacterId":"c12873"},"originalCharacterName":"小沼 桐子","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kiriko is a hostess of the \"Naruto\" inn. Hiroshi and Oujo are staying at her inn. She is always making sure that her guests are feeling like at home when they are staying in her inn. She is a very kind, funny and... forgetful woman."}],"source":"vndb","sourceCharacterId":"c12873"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/833dacf66bb67032380c7b3b8e66c5b6e268cd629607e4269e46628ee60d7202.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/580e7f98714a5202c6e0e24dc6a7403e887ea8f00b51710cf28d64aad625ef56.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"関 和美","creatorId":"vndb:s1314","sourcePersonId":"vndb:s1314","canonicalEntityId":"vndb:s1314","name":"小倉 文江","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:3347","source":"vndb"}]},{"characterId":"char_vndb_c12874","characterName":"名無しの少女","sourceIds":{"vndbCharacterId":"c12874"},"originalCharacterName":"名無しの少女","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She came to Tokiwa Village several weeks earlier than Oujo and like her,"},{"spoiler":true,"text":"she is also a nameless eccentric shinigami girl"},{"spoiler":false,"text":". Unlike Oujo, she doesn't have a stuffed toy to carry around in her arms but she has a nice small pet bird that she carries on her shoulder and uses it for her ventriloquism. She had met Ryousuke one night while she was minding her own business at the so-called \"suicide\" cliff of Tokiwa village. In the nature of love on first sight, they immediately got very attached to each other, due to certain circumstances related to both of theirs psyches."},{"spoiler":false,"text":"Edited from neo-X-saga's Walkthrough"}],"source":"vndb","sourceCharacterId":"c12874"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14f6c927d90f1c635179932c0d17e10e697183e9300ad91e8d4f3e5117e65463.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/3728ba60ccb7116fc207cd953cde88e28a2bf5d61850fa40c213e8c1198112b9.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"歌織","creatorId":"vndb:s891","sourcePersonId":"vndb:s891","canonicalEntityId":"vndb:s891","name":"富山 あかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:3345","source":"vndb"}]},{"characterId":"char_vndb_c12875","characterName":"上代 萌","sourceIds":{"vndbCharacterId":"c12875"},"originalCharacterName":"上代 萌","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A soft-spoken girl who politely addresses her older brother as Nii-sama. But that is just her outside appearance. Inside, she is just as dangerous as Kako with her sharp tongue. She also dislikes Sayaka to the point of calling her \"otenko\" (\"Great Airheaded Girl\")."},{"spoiler":false,"text":"Edited from neo-X-saga's Walkthrough"}],"source":"vndb","sourceCharacterId":"c12875"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a9c96e97c5baced0f821a815f8cad6a289d08b1caad6604b6b340e68675d0b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a70ff4c8d3c6df91b8b25cd8ca24b295e10441d3816bc9df94bbaf48b0cb1b9.webp","width":171,"h