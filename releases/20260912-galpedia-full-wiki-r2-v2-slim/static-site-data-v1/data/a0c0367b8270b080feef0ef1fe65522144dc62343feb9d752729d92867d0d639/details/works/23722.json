{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"23722","model":{"presentationWorkId":"vndb:v15602","staff":{"artwork":[{"creditedName":"ひなたもも","creatorId":"vndb:s716","sourcePersonId":"egs:creator:12801","canonicalEntityId":"vndb:s716","name":"ひなたもも","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:179687","source":"egs"},{"creditedName":"REI(原画)","creatorId":"vndb:s2152","sourcePersonId":"egs:creator:12817","canonicalEntityId":"vndb:s2152","name":"REI(原画)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:179688","source":"egs"},{"creditedName":"あめとゆき","creatorId":"vndb:s2723","sourcePersonId":"egs:creator:14893","canonicalEntityId":"vndb:s2723","name":"あめとゆき","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:179689","source":"egs"}],"scenario":[{"creditedName":"早瀬ゆう","creatorId":"vndb:s3034","sourcePersonId":"egs:creator:14059","canonicalEntityId":"vndb:s3034","name":"早瀬ゆう","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:179690","source":"egs"}],"music":[],"other":[{"creditedName":"株式会社ブリコ","creatorId":"vndb:s47103","sourcePersonId":"egs:creator:21829","canonicalEntityId":"vndb:s47103","name":"株式会社ブリコ","detail":"ADVエンジン Ethornell","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:179691","source":"egs"},{"creditedName":"akerou","creatorId":"vndb:s27470","sourcePersonId":"vndb:s27470","canonicalEntityId":"vndb:s27470","name":"Christian Ehrmanntraut","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:112027","source":"vndb"},{"creditedName":"TBAC","creatorId":"vndb:s27471","sourcePersonId":"vndb:s27471","canonicalEntityId":"vndb:s27471","name":"TBAC","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:112028","source":"vndb"},{"creditedName":"KiriyaAoi","creatorId":"vndb:s27615","sourcePersonId":"vndb:s27615","canonicalEntityId":"vndb:s27615","name":"KiriyaAoi","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:112029","source":"vndb"},{"creditedName":"SSparks","creatorId":"vndb:s27616","sourcePersonId":"vndb:s27616","canonicalEntityId":"vndb:s27616","name":"Caroline Favero","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:112030","source":"vndb"},{"creditedName":"Haerts","creatorId":"vndb:s27597","sourcePersonId":"vndb:s27597","canonicalEntityId":"vndb:s27597","name":"Victoria Vetter","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:112031","source":"vndb"},{"creditedName":"Chuee","creatorId":"vndb:s27621","sourcePersonId":"vndb:s27621","canonicalEntityId":"vndb:s27621","name":"Chuee","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:112032","source":"vndb"}]},"cast":[{"characterId":"char_c16555","characterName":"望月 理奈","sourceIds":{"bangumi":[{"characterId":"23569","match":"exact-normalized-name-in-linked-work","subjectId":"491519"},{"characterId":"23569","match":"exact-normalized-name-in-linked-work","subjectId":"58584"}],"egsCharacterIds":["293"],"vndbCharacterId":"c16555"},"originalCharacterName":"望月 理奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the protagonist's few female friends. Anything goes between these two, be it puns or dirty jokes. She is the girl who replaced Himari in the protagonist's life once he moved away."},{"spoiler":false,"text":"Rina is gifted both intellectually and physically, and boasts a lot of confidence. Mentally speaking, she is more mature than her peers, and she has an open-minded, frank personality, never expecting anything in return for an act of kindness. She is well-aware of her good looks, but always remains modest."},{"spoiler":false,"text":"Being such a perfect girl naturally earns her the affection of many guys, and makes her a role-model for girls as well. But you would never guess that she actually has a lot of surprisingly feminine weaknesses..."},{"spoiler":false,"text":"From NekoNyan"}],"source":"vndb","sourceCharacterId":"c16555"},{"segments":[{"spoiler":false,"text":"ギャグ、下ネタ、何でも言い合える主人公の女友達。"},{"spoiler":false,"text":"引っ越し後、陽茉莉と入れ替わるように毎日主人公と同じクラスで生活してきた腐れ縁。"},{"spoiler":false,"text":"容姿端麗、才色兼備。 女としてのプライドは人一倍。"},{"spoiler":false,"text":"周囲の学生たちより精神的に大人で、他人を助ける際にも見返りは一切求めないさっぱりとした性格。"},{"spoiler":false,"text":"自分の容姿に自信を持っているが、それを鼻にかけないのが彼女の特徴。"},{"spoiler":false,"text":"なので人望も人一倍厚く、同性にも人気のある女の子。"},{"spoiler":false,"text":"しかし意外にも女子らしい弱点も多い。"}],"source":"egs","sourceCharacterId":"293","sourceWorkId":"18018","spoiler":false},{"segments":[{"spoiler":false,"text":"冷笑话、低级笑话，无论什么都能畅所欲言的主人公的女性朋友。"},{"spoiler":false,"text":"自从搬家后，像是代替陽茉莉似的，每天与主人公在同一间教室共同生活。"},{"spoiler":false,"text":"外表秀丽，才色兼备。女性尊严要超于常人。"},{"spoiler":false,"text":"在精神层面上要比周围的学生成熟，在帮助别人时不寻求任何回报的豪爽性格。"},{"spoiler":false,"text":"对自己的外貌拥有自信，但不会因此而自满是她的特征。"},{"spoiler":false,"text":"因此人望也要超于常人，在同性中也会拥有人气的女孩子。"},{"spoiler":false,"text":"但是意外地也有很多女孩子的弱点。"},{"spoiler":false,"text":"「啊哈哈！不，这不可能吧。在你我之间发生恋爱什么的」"}],"source":"bangumi","sourceCharacterId":"23569"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23ae90d9926b8eae6e76d3379e59fabf7579b62b8ebd85f9ef3e9ef1726c3c21.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a009d514cc5b83204ff0393f835cee9e1cf900f30a7dad6ac0e0df2564e308fd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:132549:23569:8580:1","source":"bangumi"}]},{"characterId":"char_c16556","characterName":"柊 ゆずゆ","sourceIds":{"bangumi":[{"characterId":"23570","match":"exact-normalized-name-in-linked-work","subjectId":"491519"},{"characterId":"23570","match":"exact-normalized-name-in-linked-work","subjectId":"58584"}],"egsCharacterIds":["294"],"vndbCharacterId":"c16556"},"originalCharacterName":"柊 ゆずゆ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuzuyu is one of the protagonist's classmates. Her mood swings are like a pendulum, and her foul mouth never ceases to get her in heaps of trouble. Her relationship with her classmates is anything but good, as one could guess from her snappy attitude, and as a result, she's rather isolated from her peers."},{"spoiler":false,"text":"Many of her opinions aren't quite 'wrong' per se, but since she has such little respect for people's feelings, and rarely thinks about time and place before speaking her mind, she earns a lot of scorn. She herself doesn't understand why people react that way to her, and just brushes it off."},{"spoiler":false,"text":"She has a complex in regards to the size of her breasts, and tends to not take kindly to stares from men. Because of that, her views and actions towards men can often be somewhat sexist. She's extremely athletic, and her signature sport is swimming, where she is unbeatable."},{"spoiler":false,"text":"From NekoNyan"}],"source":"vndb","sourceCharacterId":"c16556"},{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。"},{"spoiler":false,"text":"感情の起伏が荒く、ストレートな物言いが度々対人トラブルを巻き起こすので、周囲の心象も悪くクラスから孤立してしまっている。"},{"spoiler":false,"text":"言っていることは案外正論なのだが、相手の気持ちやタイミングをまったく考慮せず、そこを疎ましがられている。"},{"spoiler":false,"text":"本人としても何故自分が非難されるのかは理解せず、「ウザい」 の一言で片付けてしまう。"},{"spoiler":false,"text":"大きな胸にコンプレックスを持ち、男の目を気にする傾向がある。"},{"spoiler":false,"text":"それゆえ男に対してネガティブな偏見を持っている。"},{"spoiler":false,"text":"運動神経が抜群で、中でも水泳だけは誰にも負けない（負けたくない）。"},{"spoiler":false,"text":"「ウザ。どういう経緯があって私があんたに惚れんのよ」"}],"source":"egs","sourceCharacterId":"294","sourceWorkId":"18018","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的同班同学。"},{"spoiler":false,"text":"感情起伏极大，直言不讳的话语屡次在人际相处中给自己惹麻烦，周围也对她没有好的印象，被班里的人所孤立。"},{"spoiler":false,"text":"说的话虽然意外地都是些大道理，但因为完全没有考虑对方的心情与时机，因此不被对方所接受。"},{"spoiler":false,"text":"对本人来说，不明白为什么自己反而会被谴责，用一句「你很烦」来收场。"},{"spoiler":false,"text":"对大胸部持有自卑感，有着在意男生目光的倾向。"},{"spoiler":false,"text":"因此而对男生抱有否定性的偏见。"},{"spoiler":false,"text":"运动能力出类拔萃，尤其是游泳，绝对不会输给任何人（不想输）。"},{"spoiler":false,"text":"「你烦够了。究竟是什么前因后果能够让我看上你呀」"}],"source":"bangumi","sourceCharacterId":"23570"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/683dd4cc6569f8af0d5e03263485e46edb81d0b1608028fa150ab104483b43ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/963113728e31e0ce5d6669b98a46f122f5ecc1910e7dbe886ad933782c07b314.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:132549:23570:11646:1","source":"bangumi"}]},{"characterId":"char_c16557","characterName":"ひまひま","sourceIds":{"bangumi":[{"characterId":"23568","match":"exact-normalized-name-in-linked-work","subjectId":"491519"},{"characterId":"23568","match":"exact-normalized-name-in-linked-work","subjectId":"58584"}],"egsCharacterIds":["292"],"vndbCharacterId":"c16557"},"originalCharacterName":"ひまひま","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Her mother is good friends with the protagonist's, and this led to them playing together often when they were younger. Due to various reasons, mainly the protagonist moving, their relationship became estranged, but now, several years later, they find each other at the same high school, and in the same class this year."},{"spoiler":false,"text":"Personality-wise, she has a big heart, and can put a smile on your face just by being around you, but truthfully she can be quite stubborn if you get to know her. Himari is never one to go to others when she has a problem, be it guy or girl, but if she sees someone in need of help, she will always be the first one there. Contrary to her cutesy, child-like appearance, she is rather strong-willed."},{"spoiler":false,"text":"Both she and the protagonist have matured a great deal since their time playing together as kids, so she can't quite figure out what to say to him now, or how to act around him. Also make sure you never tell a bad joke around her, because she'll make you know that it was bad, often entirely unintentionally."},{"spoiler":false,"text":"From NekoNyan"}],"source":"vndb","sourceCharacterId":"c16557"},{"segments":[{"spoiler":false,"text":"親同士の仲も良い、主人公の幼なじみ。"},{"spoiler":false,"text":"引っ越しなどの関係でしばらく疎遠になっていたが、数年後に城彩学園で再会を果たす。"},{"spoiler":false,"text":"性格は極めて温厚で癒し系オーラを振りまくが、実は頑固な一面も。"},{"spoiler":false,"text":"男女問わず自ら進んで甘えることはなく、困った人がいるとそっと助けてあげるタイプ。"},{"spoiler":false,"text":"ほんわかした見た目とは裏腹に、メンタルは人一倍強い。"},{"spoiler":false,"text":"疎遠の時期にお互い成長してしまったため、主人公に対して距離感が測れなくなっている。"},{"spoiler":false,"text":"また、悪気はないのにスベったギャグに追い打ちをかけてしまうのが特徴。"},{"spoiler":false,"text":"「え？　今のギャグだったの!?　ご、ごめん！　笑うからもう一回言って？」"}],"source":"egs","sourceCharacterId":"292","sourceWorkId":"18018","spoiler":false},{"segments":[{"spoiler":false,"text":"双方父母关系融洽的、主人公的青梅竹马。"},{"spoiler":false,"text":"因为搬家等缘故暂且疏远了一段时间，数年后在城彩学園再度相遇。"},{"spoiler":false,"text":"性格极度温驯，散发着治愈系的氛围，其实也有顽固的一面。"},{"spoiler":false,"text":"不论对方是男是女，都不会主动依赖对方，反而别人有困难的话就会马上出手帮忙。"},{"spoiler":false,"text":"与呆呆的外表相反，精神层面要强于常人。"},{"spoiler":false,"text":"因为在疏远期间互相成长，无法测量到与主人公究竟拉开了多少距离。"},{"spoiler":false,"text":"另外，虽然没有恶意，但却会对着不好笑的冷笑话穷追猛打是其特征。"},{"spoiler":false,"text":"「呃？刚才那个是笑话啊！？对、对不起！我会笑的，再说一次吧？」"}],"source":"bangumi","sourceCharacterId":"23568"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/561e77cc9aea664884893dd293d450679b8f5205f71588101bf56ca7b23ef19a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0bd3e3f1597b9f4373f35d53c265af8236c35e49bd4fd815d7795a6a0a13d5e2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平山ゆかり","creatorId":"vndb:s285","sourcePersonId":"vndb:s285","canonicalEntityId":"vndb:s285","name":"東かりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:132549:23568:5905:1","source":"bangumi"}]},{"characterId":"char_c16558","characterName":"沢渡 岬","sourceIds":{"bangumi":[{"characterId":"23571","match":"exact-normalized-name-in-linked-work","subjectId":"491519"},{"characterId":"23571","match":"exact-normalized-name-in-linked-work","subjectId":"58584"}],"egsCharacterIds":["295"],"vndbCharacterId":"c16558"},"originalCharacterName":"沢渡 岬","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"There is no small number of people who have become infatuated with her simply from the smell of her hair as she passes by."},{"spoiler":false,"text":"She's very soft-spoken, and doesn't seem to like drawing attention, but because of her raw, natural beauty, she often draws attention to herself whether she likes it or not. In a sense, she's almost treated like a princess at school."},{"spoiler":false,"text":"For that reason, the fellow third-years have an unspoken rule: strangers are not allowed to talk to her without good reason. Those who break that rule became the target of censure."},{"spoiler":false,"text":"The protagonist has tried many times to talk to her, but due to poor luck he's only ever seen her profile from behind."},{"spoiler":false,"text":"From NekoNyan"}],"source":"vndb","sourceCharacterId":"c16558"},{"segments":[{"spoiler":false,"text":"彼女が通り過ぎる際、風になびいた髪からの香りに魅了される人も多数。"},{"spoiler":false,"text":"物静かで人目につくことが苦手らしいのだが、佇まいが画になってしまうため、逆に多くの人から注目されてしまっている。"},{"spoiler":false,"text":"ゆえに、学園のお嬢様。"},{"spoiler":false,"text":"彼女には安易に近付いてはいけないという暗黙のルールが彼女の学年内に存在し、破る者は非難の対象になる。"},{"spoiler":false,"text":"主人公はタイミングが悪く、いつも彼女の後ろ姿しか見ることができていない。"},{"spoiler":false,"text":"「……？　それ、普通……」"}],"source":"egs","sourceCharacterId":"295","sourceWorkId":"18018","spoiler":false},{"segments":[{"spoiler":false,"text":"在她经过的时候，被她那由风所带起的头发里的香气所吸引的人有很多。"},{"spoiler":false,"text":"文静，不喜欢被人注视，但因为她驻足的模样就仿如画卷，反过来更吸引了很多人的注视。"},{"spoiler":false,"text":"因此，成了学校里的大小姐。"},{"spoiler":false,"text":"不要轻易接近她成了她所在年级的不成文的规则，不遵守规则的人将会成为非议的对象。"},{"spoiler":false,"text":"而主人公则是时机不合，每次看到的都只是她的背影。"},{"spoiler":false,"text":"「……？这个，平常……」"}],"source":"bangumi","sourceCharacterId":"23571"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a5a6bec6bf7696e76dd118eeb2833e5ad80dd317ce3b96af5347a2a8f767da6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db3dc19e55cb37035c23064ca8526861d567be3ce6527d05f1f83bcc6ba843b8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井ありす","creatorId":"vndb:s1626","sourcePersonId":"vndb:s1626","canonicalEntityId":"vndb:s1626","name":"櫻井 ありす","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:132549:23571:19213:1","source":"bangumi"}]},{"characterId":"char_vndb_c21354","characterName":"青葉 恭介","sourceIds":{"vndbCharacterId":"c21354"},"originalCharacterName":"青葉 恭介","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e6cb00122d09d33144e718cf5011ce402cd32fde466a676fd77233ad0979679.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4fa6defb328418d9a8031f1aaebe15ea91df7a654e1fca2419984371546c9dc.webp","width":214,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p328","sourceCompanyId":"egs:brand:1937","canonicalEntityId":"vndb:p328","name":"SMEE","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:23722:1937","source":"egs"},{"companyId":"vndb:p328","sourceCompanyId":"vndb:p328","canonicalEntityId":"vndb:p328","name":"SMEE","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:107837:v15602","source":"vndb"},{"companyId":"vndb:p24514","sourceCompanyId":"vndb:p24514","canonicalEntityId":"vndb:p24514","name":"Kuroneko Hashimoto","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:150131:v15602","source":"vndb"},{"companyId":"vndb:p328","sourceCompanyId":"vndb:p328","canonicalEntityId":"vndb:p328","name":"SMEE","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:40602:v15602","source":"vndb"},{"companyId":"vndb:p6880","sourceCompanyId":"vndb:p6880","canonicalEntityId":"vndb:p6880","name":"给屌丝带来春天汉化委员会","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:46175:v15602","source":"vndb"},{"companyId":"vndb:p328","sourceCompanyId":"vndb:p328","canonicalEntityId":"vndb:p328","name":"SMEE","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:50188:v15602","source":"vndb"},{"companyId":"vndb:p328","sourceCompanyId":"vndb:p328","canonicalEntityId":"vndb:p328","name":"SMEE","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:55900:v15602","source":"vndb"},{"companyId":"vndb:p7496","sourceCompanyId":"vndb:p7496","canonicalEntityId":"vndb:p7496","name":"NekoNyan","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:63573:v15602","source":"vndb"},{"companyId":"vndb:p7496","sourceCompanyId":"vndb:p7496","canonicalEntityId":"vndb:p7496","name":"NekoNyan","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:65498:v15602","source":"vndb"},{"companyId":"vndb:p7496","sourceCompanyId":"vndb:p7496","canonicalEntityId":"vndb:p7496","name":"NekoNyan","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:77732:v15602","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
