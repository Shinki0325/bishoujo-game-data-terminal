的にやる気が無いのが玉にキズ。"},{"spoiler":false,"text":"生徒全般からは全幅の信頼を受けており、個人的に相談に応じたりもしている。"},{"spoiler":false,"text":"コミュニケーション研究会のメンバーには顧問というだけの関係でなく、個人的に興味を持っているようだ。"}],"source":"bangumi","sourceCharacterId":"202997"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8d9ec7a0fefb49ae31e7ff8659b934917fd77b2941387c0629626f2676f5cfe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7481ef142237e7b47e4ec6d594d9e5cb1c2049dabdd6317cd7cd42b3774f4d0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217879:202997:4956:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:262","sourceCompanyId":"egs:brand:262","canonicalEntityId":"egs:brand:262","name":"FlyingShine","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:7641:262","source":"egs"},{"companyId":"vndb:p85","sourceCompanyId":"vndb:p85","canonicalEntityId":"vndb:p85","name":"フライングシャイン","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:2409:v1064","source":"vndb"},{"companyId":"vndb:p859","sourceCompanyId":"vndb:p859","canonicalEntityId":"vndb:p859","name":"smart","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:2410:v1064","source":"vndb"},{"companyId":"vndb:p85","sourceCompanyId":"vndb:p85","canonicalEntityId":"vndb:p85","name":"フライングシャイン","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:87354:v1064","source":"vndb"},{"companyId":"vndb:p237","sourceCompanyId":"vndb:p237","canonicalEntityId":"vndb:p237","name":"アベリア","roleCodes":["publisher"],"