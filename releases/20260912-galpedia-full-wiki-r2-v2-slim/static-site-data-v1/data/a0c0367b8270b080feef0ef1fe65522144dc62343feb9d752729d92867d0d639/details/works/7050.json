{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"7050","model":{"presentationWorkId":"vndb:v6314","staff":{"artwork":[],"scenario":[{"creditedName":"火々野未完","creatorId":"vndb:s2388","sourcePersonId":"egs:creator:2165","canonicalEntityId":"vndb:s2388","name":"火々野未完","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:14904","source":"egs"},{"creditedName":"高橋ひで麿","creatorId":"vndb:s11742","sourcePersonId":"egs:creator:4688","canonicalEntityId":"vndb:s11742","name":"高橋ひで麿","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:17380","source":"egs"}],"music":[{"creditedName":"電気式華憐音楽集団","creatorId":"vndb:s606","sourcePersonId":"egs:creator:2564","canonicalEntityId":"vndb:s606","name":"電気式華憐音楽集団","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:17381","source":"egs"}],"other":[{"creditedName":"遠藤汐","creatorId":"vndb:s2389","sourcePersonId":"egs:creator:775","canonicalEntityId":"vndb:s2389","name":"遠藤汐","detail":"ディレクター","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:100328","source":"egs"},{"creditedName":"牧だいきち","creatorId":"vndb:s1901","sourcePersonId":"egs:creator:3839","canonicalEntityId":"vndb:s1901","name":"牧だいきち","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"auto-confirmed","relationId":"egs:work-creator:14903","source":"egs"},{"creditedName":"遠藤 汐","creatorId":"vndb:s2389","sourcePersonId":"vndb:s2389","canonicalEntityId":"vndb:s2389","name":"遠藤 汐","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:63390","source":"vndb"}]},"cast":[{"characterId":"char_c28752","characterName":"ハリエル・ファル・ファニール・メ・クルル・イ・ヤープローニ","sourceIds":{"bangumi":[{"characterId":"24787","match":"exact-normalized-name-in-linked-work","subjectId":"633584"},{"characterId":"24787","match":"exact-normalized-name-in-linked-work","subjectId":"633591"}],"egsCharacterIds":["25708"],"vndbCharacterId":"c28752"},"originalCharacterName":"ハリエル・ファル・ファニール・メ・クルル・イ・ヤープローニ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の家に居候している魔法少女。"},{"spoiler":false,"text":"メイがやってきてからは、エッチな事件の連続。"},{"spoiler":false,"text":"今回、「男のアレを握ると落ち付く」というデマを流した張本人。"},{"spoiler":false,"text":"しかも魔法を使って美希に主人公のアレを手コキさせることに……。"}],"source":"egs","sourceCharacterId":"25708","sourceWorkId":"7053","spoiler":false},{"segments":[{"spoiler":false,"text":"どこぞの僻地からやってきた自称魔法使い。"},{"spoiler":false,"text":"今回、正規の魔法使いでないことが判明して大騒動に。"}],"source":"egs","sourceCharacterId":"25708","sourceWorkId":"7319","spoiler":false},{"segments":[{"spoiler":false,"text":"（CV:木村あやか）"},{"spoiler":false,"text":"どこぞの僻地から山を越え谷を越え僕らの町にやってきた自称魔法使いのメイ。"},{"spoiler":false,"text":"洋二（主人公）の父親を助けたことを理由にある日から唐突に居座ることに。"},{"spoiler":false,"text":"しかしせっかくの一人暮らしライフを満喫していた我らが洋二にとって、"},{"spoiler":false,"text":"突然の同居人が嬉しいわけもなく。"},{"spoiler":false,"text":"必死に追い返そうとするが、そもそも魔法使いってものを信用することができない。そこでメイがとった行動とは……。"}],"source":"bangumi","sourceCharacterId":"24787"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/caab2146fb1b43a84aad2a53c0ae4e6e3cb35fedb622fe133b845debf28b0ba1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b03300ab795f79f52125c5b7366981cbf87a023fd566aa1b0158b3599dac30d0.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:633586:24787:4490:1","source":"bangumi"}]},{"characterId":"char_c28753","characterName":"柊 真子","sourceIds":{"bangumi":[{"characterId":"24788","match":"exact-normalized-name-in-linked-work","subjectId":"633584"},{"characterId":"24788","match":"exact-normalized-name-in-linked-work","subjectId":"633586"}],"egsCharacterIds":["25709"],"vndbCharacterId":"c28753"},"originalCharacterName":"柊 真子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染にしてクラスメイト。"},{"spoiler":false,"text":"しばらく主人公に相手にされず、恋する乙女の起爆スイッチが入ったのか、突然の***フェラで主人公の下半身をトロトロに……。"}],"source":"egs","sourceCharacterId":"25709","sourceWorkId":"7050","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼馴染にしてクラスメイト。"},{"spoiler":false,"text":"どこか頭のネジが緩んでいるのか、一人暮らしの主人公のお世話をしても、逆に世話を焼かれちゃうような女の子。"}],"source":"egs","sourceCharacterId":"25709","sourceWorkId":"7319","spoiler":false},{"segments":[{"spoiler":false,"text":"（CV:九段綾奈）"},{"spoiler":false,"text":"洋二（主人公）の幼馴染にしてクラスメイト。"},{"spoiler":false,"text":"今ひとつどこかネジが一本足りないような情けなさを醸し出しているけれど、本人にとってはいたってマジメ……のつもり。"},{"spoiler":false,"text":"一人暮らしをしている洋二君の世話を焼こうとするのだけど、"},{"spoiler":false,"text":"お世話しているのかされているのか……。"},{"spoiler":false,"text":"唐突に現れたメイの言動もなにからなにまで真に受けて、"},{"spoiler":false,"text":"やれ魔法がすごいだのなんだのと関心しきり。"},{"spoiler":false,"text":"はたと気付いた時にはすでにメイ時空にとらわれているのだった……哀れ。"}],"source":"bangumi","sourceCharacterId":"24788"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6448b28c1167ab34223ae7b6b5ca691878169f91309c36d07e93c7ff73962ef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fa4da7943abb98556ee49659b84e646c723da549c49bb7cb6eca16ef66ed001.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:633586:24788:5020:1","source":"bangumi"}]},{"characterId":"char_c28755","characterName":"片瀬 美希","sourceIds":{"bangumi":[{"characterId":"204315","match":"exact-normalized-name-in-linked-work","subjectId":"633584"},{"characterId":"204315","match":"exact-normalized-name-in-linked-work","subjectId":"633589"},{"characterId":"204315","match":"exact-normalized-name-in-linked-work","subjectId":"633591"}],"egsCharacterIds":["25710"],"vndbCharacterId":"c28755"},"originalCharacterName":"片瀬 美希","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染。"},{"spoiler":false,"text":"見事なくらい素直になれないツンデレ少女。"},{"spoiler":false,"text":"主人公をどきまぎさせるさくやに対抗意識を燃やし、恥ずかしがりながらも自らの美乳で大サービス。"}],"source":"egs","sourceCharacterId":"25710","sourceWorkId":"7051","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼馴染。"},{"spoiler":false,"text":"もう一人の幼馴染“真子”よりも、先に主人公と親しくなったらしい。"},{"spoiler":false,"text":"ちなみに人知れず主人公のことを好いてはいるものの、真子の“洋ちゃん好き好き光線”におされて一歩引き気味。"},{"spoiler":false,"text":"そのうえ口を開けばすぐ言い合いになってしまうわけで、チャンスになかなか巡り会えず。"},{"spoiler":false,"text":"言い合いになるってことは、本人同士は包み隠さず"},{"spoiler":false,"text":"本音で渡り合えるという証しでもあるわけだが……。"}],"source":"egs","sourceCharacterId":"25710","sourceWorkId":"7053","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼馴染。"},{"spoiler":false,"text":"素直になれないツンデレガール。"}],"source":"egs","sourceCharacterId":"25710","sourceWorkId":"7319","spoiler":false},{"segments":[{"spoiler":false,"text":"美希もまた真子と同じく洋二（主人公）の幼なじみ。実際は真子よりも美希のほうが先に仲良しさんになっていたとか。"},{"spoiler":false,"text":"ちなみに人知れず洋二君のことを好いてはいるものの、真子の洋ちゃん好き好き光線におされて一歩引き気味。"},{"spoiler":false,"text":"そのうえ口を開けばすぐ言い合いになってしまうわけでして、チャンスになかなか巡り会えず。"},{"spoiler":false,"text":"言い合いになるってことは、本人同士は包み隠さず本音で渡り合えるという証しでもあるわけですが……。"}],"source":"bangumi","sourceCharacterId":"204315"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65583f490405ca3ca43ac13589a5befe476a04e68a699c1b9c6fa4f36bbd06ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c8bb129d82c35174ac39740a87f0529779989a1252dad92566bf022b304367a.webp","width":100,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:633586:204315:6359:1","source":"bangumi"}]},{"characterId":"char_c28756","characterName":"櫻木 ちさ","sourceIds":{"bangumi":[{"characterId":"204316","match":"exact-normalized-name-in-linked-work","subjectId":"633584"},{"characterId":"204316","match":"exact-normalized-name-in-linked-work","subjectId":"633586"},{"characterId":"204316","match":"exact-normalized-name-in-linked-work","subjectId":"633588"}],"egsCharacterIds":["25711"],"vndbCharacterId":"c28756"},"originalCharacterName":"櫻木 ちさ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"マジメが取り柄の学級委員長。"},{"spoiler":false,"text":"主人公のアレが毒蛇に噛まれたとあっては黙っておけない彼女。"},{"spoiler":false,"text":"委員長の風格を見せつつ知的に毒抜き……。"}],"source":"egs","sourceCharacterId":"25711","sourceWorkId":"7050","spoiler":false},{"segments":[{"spoiler":false,"text":"マジメだけが取り柄の学級委員長。"},{"spoiler":false,"text":"背も小さければ、どことはなしに仕草もかわいくまるで年下に仕切られてるような錯覚をクラスメイトは感じている。"},{"spoiler":false,"text":"ひたむきでマジメな彼女は、毎日のように遅刻し、だらしのない主人公が気になってしかたがない。"},{"spoiler":false,"text":"一念発起して主人公と接触してみれば、マジメッ子だったハズの委員長もいわずものがな、魔女ッ子ワールドに巻き込まれ、空回りを始めるのだった……。"}],"source":"egs","sourceCharacterId":"25711","sourceWorkId":"7052","spoiler":false},{"segments":[{"spoiler":false,"text":"マジメが取り柄の学級委員長。"},{"spoiler":false,"text":"だらしない主人公のことが気がかりでならない。"}],"source":"egs","sourceCharacterId":"25711","sourceWorkId":"7319","spoiler":false},{"segments":[{"spoiler":false,"text":"さてはてマジメだけが取り柄のハズの学級委員長ですが、背も小さければどことはなしに仕草もかわいくまるで年下に仕切られてるような錯覚をクラスメイトは感じていたわけです。というかからかわれているわけですが、とりあえずひたむきなわけです。"},{"spoiler":false,"text":"ひたむきマジメなので毎日のように遅刻はするはだらしのない洋二君が気になってしかたがありません。しかし！　しかしですよ！？　一念発起して洋二君と接触してみれば、哀れメイ、哀れさくや、哀れ真子、なんかの独自ワールドにどうして巻き込まずにいられましょう。否、最マジメッ子だったハズの委員長もいわずものがな、魔女ッ子ワールドで空回りを始めるのでした。あわれ。"}],"source":"bangumi","sourceCharacterId":"204316"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cf05bf63bb504e9ab68fac48452390a710e807475f20de95dd12ab55da56241.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0c73a27815ccab3f2f44f96790e78da75f8967004bcc949be3d4c42282fd66f.webp","width":100,"height":256,"source":"static-detail"},"actors":[{"creditedName":"蓮香","creatorId":"vndb:s1682","sourcePersonId":"vndb:s1682","canonicalEntityId":"vndb:s1682","name":"蓮香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:633586:204316:21086:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p351","sourceCompanyId":"egs:brand:1079","canonicalEntityId":"vndb:p351","name":"Erogos","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:7050:1079","source":"egs"},{"companyId":"vndb:p351","sourceCompanyId":"vndb:p351","canonicalEntityId":"vndb:p351","name":"Erogos","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:14691:v6314","source":"vndb"},{"companyId":"vndb:p351