{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"7479","model":{"presentationWorkId":"vndb:v5920","staff":{"artwork":[{"creditedName":"KEN+(KEN)(原画)","creatorId":"vndb:s7318","sourcePersonId":"egs:creator:1380","canonicalEntityId":"vndb:s7318","name":"KEN+(KEN)(原画)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:15547","source":"egs"},{"creditedName":"けつし","creatorId":"vndb:s47407","sourcePersonId":"vndb:s47407","canonicalEntityId":"vndb:s47407","name":"けつし","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:60753","source":"vndb"}],"scenario":[{"creditedName":"朝凪軽(GM、夕凪)","creatorId":"vndb:s3018","sourcePersonId":"egs:creator:784","canonicalEntityId":"vndb:s3018","name":"朝凪軽(GM、夕凪)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:15656","source":"egs"}],"music":[{"creditedName":"PANDA","creatorId":"vndb:s1251","sourcePersonId":"egs:creator:4842","canonicalEntityId":"vndb:s1251","name":"PANDA","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:201118","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c25408","characterName":"御影　沙也","sourceIds":{"bangumi":[{"characterId":"147015","match":"exact-normalized-name-in-linked-work","subjectId":"279483"}],"egsCharacterIds":["25639"],"vndbCharacterId":"c25408"},"originalCharacterName":"御影　沙也","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"生徒会長。"},{"spoiler":false,"text":"気が強くて、高圧的な態度をとる。主人公にもキツくあたる。"},{"spoiler":false,"text":"田中の「マンガ」を読んで凌辱地獄へ。"},{"spoiler":false,"text":"簡単には快楽に屈せず、彼女への被虐はより凄惨さを極める。"}],"source":"egs","sourceCharacterId":"25639","sourceWorkId":"7479","spoiler":false},{"segments":[{"spoiler":false,"text":"生徒会会長。生徒会長らしく口やかましい存在。強気、高圧的。"},{"spoiler":false,"text":"生徒会の一員でありながら、あまりやる気のない主人公を何度となく叱る。"},{"spoiler":false,"text":"主人公にとってはあまり顔を合わせたくない存在。他の生徒たちからも煙たがられている。"},{"spoiler":false,"text":"沙也に一泡吹かせてやろうと、彼女の痴態を隠し撮りしようと狙っている輩もいる。"},{"spoiler":false,"text":"沙也はそんな事にも動じず毅然とした態度で立ち向かう。"},{"spoiler":false,"text":"しかし彼女もまた田中のエロマンガを目にした事で感化されてしまい、優美同様に「その世界」に迷い込む。"}],"source":"bangumi","sourceCharacterId":"147015"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fa9ee2ac907454a691b2aad812f8783e9626cecccee165a138ef2383b5320ff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/189be9e883dc8ec862d2bda0ff2220ca48564260e6e9ebf375a5e1ba93ce65d5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"嶋崎はるか","creatorId":"vndb:s1013","sourcePersonId":"vndb:s1013","canonicalEntityId":"vndb:s1013","name":"嶋崎 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:279483:147015:6302:1","source":"bangumi"}]},{"characterId":"char_c25409","characterName":"柊 ケイコ","sourceIds":{"bangumi":[{"characterId":"147017","match":"exact-normalized-name-in-linked-work","subjectId":"279483"}],"egsCharacterIds":["25641"],"vndbCharacterId":"c25409"},"originalCharacterName":"柊 ケイコ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"クラスの担任。"},{"spoiler":false,"text":"田中の「マンガ」を焼却するも、こっそりとっておいたコピーがあだとなり、激しい凌辱を受けることに。"},{"spoiler":false,"text":"お節介なお姉さん的性格。"}],"source":"egs","sourceCharacterId":"25641","sourceWorkId":"7479","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスの担任。既婚。"},{"spoiler":false,"text":"やや、お節介な所があるお姉さん的性格。"},{"spoiler":false,"text":"エロマンガを焼却してしまった為に主人公に怨まれる。"},{"spoiler":false,"text":"しかしその一方、こっそりそれをコピーしていた事で「その世界」の住人となり、他のヒロインたち同様に○○される。"}],"source":"bangumi","sourceCharacterId":"147017"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f132f21a77a2ff7c61f62c92044d2a8eb8962310a3978359385a61e9f28c7ec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef0303277cbc3ed4bc61c7c606de20681d28250cabf26a3df4c0c5c7d61dd376.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あらいしずか","creatorId":"vndb:s665","sourcePersonId":"vndb:s665","canonicalEntityId":"vndb:s665","name":"あらい しずか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:279483:147017:4647:1","source":"bangumi"}]},{"characterId":"char_c25411","characterName":"南　アイ","sourceIds":{"bangumi":[{"characterId":"147016","match":"exact-normalized-name-in-linked-work","subjectId":"279483"}],"egsCharacterIds":["25640"],"vndbCharacterId":"c25411"},"originalCharacterName":"南　アイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の後輩。"},{"spoiler":false,"text":"いじめを受けているところを助けたことにより、主人公に懐いている。"},{"spoiler":false,"text":"主人公のキスを拒んだので、最近はちょっとウザがられいるところも。"},{"spoiler":false,"text":"性的なことは未経験で、まったくの無知。"},{"spoiler":false,"text":"田中の「マンガ」に触れて、一気にめくるめく性の快楽に目覚させられることに。"}],"source":"egs","sourceCharacterId":"25640","sourceWorkId":"7479","spoiler":false},{"segments":[{"spoiler":false,"text":"下級生。天真爛漫。屈託のない無垢な性格。ちょっとドジ。"},{"spoiler":false,"text":"騙されやすく何の疑いもなく言われるがままにしてしまう。"},{"spoiler":false,"text":"物語の始まる以前に、あるきっかけで主人公になつくようになった。"},{"spoiler":false,"text":"当初は自分を慕ってくるアイに悪い気はせず、下心から思わずキスを迫ったこともあったが、アイが拒んだため結局、指一本触れられないままの状態が続いている。"},{"spoiler":false,"text":"性に関しては未経験・無知だったが、優美や沙也同様に田中のエロマンガに触れた事で一気に性に目覚めてしまい、そのまま「その世界」に迷い込んでしまう。"}],"source":"bangumi","sourceCharacterId":"147016"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/6002c517ad3810f3567ed41335f6f28ecdec497211b2e8c555d7fe764c845c5e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/151caa8aa3266e8e91abcdfde255fa6d331ce8a3db03383bcb5f0e499c3fcef0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:279483:147016:6106:1","source":"bangumi"}]},{"characterId":"char_c25412","characterName":"水無月　優美","sourceIds":{"bangumi":[{"characterId":"147014","match":"exact-normalized-name-in-linked-work","subjectId":"279483"}],"egsCharacterIds":["25638"],"vndbCharacterId":"c25412"},"originalCharacterName":"水無月　優美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"クラスの人気者。主人公のオナペット。"},{"spoiler":false,"text":"「凌辱されたい」という願望をひそかに持っていて、田中の「マンガ」を読むことで、願望通りの運命に。"},{"spoiler":false,"text":"テニス部に所属していて、同じ部に彼氏あり。セックスも経験済み（1～2度）。"}],"source":"egs","sourceCharacterId":"25638","sourceWorkId":"7479","spoiler":false},{"segments":[{"spoiler":false,"text":"最初に○○される女子。主人公のクラスメート。"},{"spoiler":false,"text":"優等生でクラスの代表を務める。明るく活発。テニス部に所属。クラスの人気者。"},{"spoiler":false,"text":"クラスの男子生徒たちは密かに彼女をオナペットにしている。主人公の片思いの相手。"},{"spoiler":false,"text":"主人公と同じくクラスの代表としてたまに生徒会の仕事に参加している。"},{"spoiler":false,"text":"田中の描いたエロマンガを読んだが為に「その世界」に迷い込み、心の隅にあった「○○されたい」という願望通りの運命をたどる。"}],"source":"bangumi","sourceCharacterId":"147014"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c236354d985e8be8026d7616f44f70690f6050f020d0330c100c673fcde5377.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/896b60b4901e12c6b0b03a83c63a38cd90462d168c66475ad7c0a66ee87fa07d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本井えみ","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:279483:147014:4177:1","source":"bangumi"}]},{"characterId":"char_vndb_c25410","characterName":"滝川　はるか","sourceIds":{"vndbCharacterId":"c25410"},"originalCharacterName":"滝川　はるか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48821ca853a716e92ff6ad441613fa1deff00a572e35e09285bbee34f99c0824.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/0292b1b671ba86394f858e220b270a57031537a05a4f40810f078c5b884a0c75.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あいはら めぐみ","creatorId":"vndb:s2716","sourcePersonId":"vndb:s2716","canonicalEntityId":"vndb:s2716","name":"あいはら めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33950","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p873","sourceCompanyId":"egs:brand:1784","canonicalEntityId":"vndb:p873","name":"SUKARADOG","roleCodes":["brand"],"identityStatus":"aut