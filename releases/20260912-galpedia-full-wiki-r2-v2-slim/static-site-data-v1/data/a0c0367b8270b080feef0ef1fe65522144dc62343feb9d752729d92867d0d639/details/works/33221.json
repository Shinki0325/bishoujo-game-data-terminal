03","source":"vndb"}]},{"characterId":"char_vndb_c132790","characterName":"スピネル","sourceIds":{"vndbCharacterId":"c132790"},"originalCharacterName":"スピネル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"818"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A woman that suddenly appeared in the commoner's district, Coene."}],"source":"vndb","sourceCharacterId":"c132790"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/877e1266a4c3266d61b4834ead66874d6d76fc219099dd746c26ac6ad752cfd0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e496ea0a58d4e3530b6cfde219b4428790a4eb0c1d675b2895a785447616acbd.webp","width":170,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近藤 唯","creatorId":"vndb:s669","sourcePersonId":"vndb:s669","canonicalEntityId":"vndb:s669","name":"近藤 唯","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92394","source":"vndb"}]},{"characterId":"char_vndb_c94428","characterName":"イヴ","sourceIds":{"vndbCharacterId":"c94428"},"originalCharacterName":"イヴ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"617"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"177"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Even if no one ends up loving me, I'll still love everyone no matter what.\""},{"spoiler":false,"text":"Embracing his fate to love"},{"spoiler":false,"text":"A member of the Corps who also runs a handyman business called Courrune. He is well-known in Coene, and highly trusted for his earnest and sincere nature. His innate benevolence allows him to forgive even those who have committed evil deeds. He was disowned by his parents after an accident that caused his face to become scarred from burns. He believes that, as long as he continues to love and help others, he will someday meet a person who will love him in return."},{"spoiler":false,"text":"Occupation: Courrune handyman, Corps member"},{"spoiler":false,"text":"From Aksys Games"}],"source":"vndb","sourceCharacterId":"c94428"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6415adb40ccf9a9e2b50f2bab6eac96a96ab1e02b2679c5dd5bb1d51b85a393.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d925d99c33e2defad36d6544ed7deb2d9f7052f336aa255efdea863c44b20eeb.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"斉藤 壮馬","creatorId":"vndb:s5499","sourcePersonId":"vndb:s5499","canonicalEntityId":"vndb:s5499","name":"斉藤 壮馬","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92397","source":"vndb"}]},{"characterId":"char_vndb_c94429","characterName":"リュカ・プルースト","sourceIds":{"vndbCharacterId":"c94429"},"originalCharacterName":"リュカ・プルースト","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"birthday":{"reviewState":"source-only","source":"vndb","value":"216"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I believe teaching is my soul's vocation, given to me by God.\""},{"spoiler":false,"text":"Believing in his fate to lead."},{"spoiler":false,"text":"A teacher who travels to orphanages and other institutions to educate children. He often holds classes at the facility where the heroine lives. He is very polite and thoughtful, with a strong sense of justice. He regularly visits his younger sister at the hospital where she receives treatment for a serious illness. As a devout follower of God. he considers children to be precious gifts."},{"spoiler":false,"text":"Occupation: Teacher"},{"spoiler":false,"text":"From Aksys Games"}],"source":"vndb","sourceCharacterId":"c94429"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be7b04780e91cf5e079f47a49a5556f90ed5681e19a760fa5f5da0c7cf90202d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4a94c9eca80fa559149a3e4578b7be69fae07894ab2daa32f292fb43ae3fb22.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平川 大輔","creatorId":"vndb:s133","sourcePersonId":"vndb:s133","canonicalEntityId":"vndb:s133","name":"平川 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92391","source":"vndb"}]},{"characterId":"char_vndb_c94430","characterName":"マティス・クロード","sourceIds":{"vndbCharacterId":"c94430"},"originalCharacterName":"マティス・クロード","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"409"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"167"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"That monster... I want to kill that monster with my own hands...!\""},{"spoiler":false,"text":"Spurning his fate to forgive."},{"spoiler":false,"text":"A young man who lives in Chedis. He loves reading, and his room is always filled with books. As he is extremely timid and shy, he struggles with eye contact and conversations with others. His brother was killed by \"Bourreau,\" so he is searching for the killer in order to mete out vengeance."},{"spoiler":false,"text":"Occupation: Head of the Claude Family"},{"spoiler":false,"text":"From Aksys Games"}],"source":"vndb","sourceCharacterId":"c94430"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a6f6d50d044f8b133b60d28819631973c4b559fc683f204921c8284c5e86ff1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21d9cd5b0b6cae069f119f756eeee03566569fe63b90891d02dd3b8b08f448c7.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天﨑 滉平","creatorId":"vndb:s8316","sourcePersonId":"vndb:s8316","canonicalEntityId":"vndb:s8316","name":"天﨑 滉平","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92399","source":"vndb"}]},{"characterId":"char_vndb_c94431","characterName":"シアン・ブロフィワーズ","sourceIds":{"vndbCharacterId":"c94431"},"originalCharacterName":"シアン・ブロフィワーズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"23"},"birthday":{"reviewState":"source-only","source":"vndb","value":"725"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"A body is merely a vessel that houses a brain and a heart.\""},{"spoiler":false,"text":"Unwavering in his fate to preserve."},{"spoiler":false,"text":"A talented scientist who is the director of the National Research Institute and creator of Reliver technology. He has lived for many years through his memory download system. He treats humans as expendable, and considers emotions to be bugs. His focus is on survival efficiency, for which he will not hesitate to use others or himself as test subjects in his research efforts."},{"spoiler":false,"text":"Occupation: Researcher, Director of the National Research Institute"},{"spoiler":false,"text":"From Aksys Games"}],"source":"vndb","sourceCharacterId":"c94431"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33f0538fbc66cc08ce4294032d8c167dadb6e5453bdf879f4e555e5fe54ca583.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec110d64e5d7b2c7910d0c08c007927006afcb78e7c2afb65d07d8bb7b823766.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"細谷 佳正","creatorId":"vndb:s251","sourcePersonId":"vndb:s251","canonicalEntityId":"vndb:s251","name":"細谷 佳正","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92393","source":"vndb"}]},{"characterId":"char_vndb_c94432","characterName":"アドルフ","sourceIds":{"vndbCharacterId":"c94432"},"originalCharacterName":"アドルフ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1201"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"It's disappointing to see that the nature of humans hasn't changed.\""},{"spoiler":false,"text":"Affirming his fate to pursue."},{"spoiler":false,"text":"The leader of the Corps who was raised alongside the heroine at the orphanage. He currently lives alone on the outskirts of town. He can be brusque at times, but is a kind soul deep down who won't turn his back on anyone in need. He is seen as a reliable brother to the heroine."},{"spoiler":false,"text":"Occupation: Leader of the Corps"},{"spoiler":false,"text":"From Aksys Games"}],"source":"vndb","sourceCharacterId":"c94432"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e55ecc369e8bf907e85e1629851dcb8be0ed48c8f8f560b86462333ed88f46ab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2df300a1c236e5e91dfa3e4aab67d78bdf6154e9033d302d1c873c761f1f6b3c.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"八代 拓","creatorId":"vndb:s159","sourcePersonId":"vndb:s159","canonicalEntityId":"vndb:s159","name":"八代 拓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92392","source":"vndb"}]},{"characterId":"char_vndb_c94433","characterName":"アンクゥ","sourceIds":{"vndbCharacterId":"c94433"},"originalCharacterName":"アンクゥ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"If you satisfy my terms... I will make sure that you are reborn as a normal girl.\""},{"spoiler":false,"text":"Toying with his fate to keep watch."},{"spoiler":false,"text":"A mysterious existence who calls himself the \"Watchman of Death.\" He stops the heroine from committing suicide, and offers her an option of uncovering the truth behind the deaths that plague Arpéchéle. He often speaks cryptically, making it very difficult to grasp his true intentions."},{"spoiler":false,"text":"From Aksys Games"}],"source":"vndb","sourceCharacterId":"c94433"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1bf6f4ab4212c01b778275652e13715714c8ae39adb3597b18a9db7a3f46dd6c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c8acb51eab3893d59a57ac2a1c182ae2ff59ca88cd50414b8cfe1a603f17637.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"興津 和幸","creatorId":"vndb:s85","sourcePersonId":"vndb:s85","canonicalEntityId":"vndb:s85","name":"興津 和幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92390","source":"vndb"}]},{"characterId":"char_vndb_c94434","characterName":"セレス","sourceIds":{"vndbCharacterId":"c94434"},"originalCharacterName":"セレス","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1226"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Dear God... I... I have killed so many people...\""},{"spoiler":false,"text":"Parting from her fate to kill."},{"spoiler":false,"text":"The game's heroine. She has been an orphan for as long as she can remember. Those around her tend to experience sudden accidents or death, so she is shunned by everyone as \"Death.\" After a life of misery, she attempts suicide just before encountering Ankou, who leads her to face the mysterious deaths she has sought to avoid."},{"spoiler":false,"text":"Occupation: Orphanage helper"},{"spoiler":false,"text":"From Aksys Games"}],"source":"vndb","sourceCharacterId":"c94434"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/913a53d28f1062c2f18377cc2549deed05b68a2d3a4e385d35f62640340b54c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e248271a964cb7ed80a5cac74f6d158e4766a49b4314a4acdf767d06c28a91de.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c97364","characterName":"サロメ","sourceIds":{"vndbCharacterId":"c97364"},"originalCharacterName":"サロメ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1118"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"From the very first day she arrived at this orphanage... Not once have I seen misfortune occur because of her.\""},{"spoiler":false,"text":"A Reliver and mother to many at the orphanage. She is very wise and has some knowledge of medicine, which she uses to suppress the symptoms of illness caused by the heroine's \"misfortune.\""},{"spoiler":false,"text":"Occupation: Orphanage matron"},{"spoiler":false,"text":"From Aksys Games"},{"spoiler":true,"text":"Her real name is Christine Rêvepoir (クリスティーヌ・レーヴポワール)."}],"source":"vndb","sourceCharacterId":"c97364"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/346889aa2c8608348ab776749e600e30259d2969f2077d9b01feba4662d7a14c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71a94b2ba9bf177237133c332c768fb36011fff1bbc185262e5b7ae50f562043.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桑島 法子","creatorId":"vndb:s1186","sourcePersonId":"vndb:s1186","canonicalEntityId":"vndb:s1186","name":"桑島 法子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92395","source":"vndb"}]},{"characterId":"char_vndb_c97365","characterName":"ヒューゴ","sourceIds":{"vndbCharacterId":"c97365"},"originalCharacterName":"ヒューゴ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"birthday":{"reviewState":"source-only","source":"vndb","value":"706"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I don't want some petty squabble getting in the way of work that needs doing.\""},{"spoiler":false,"text":"Yves's friend and partner at Courrune. He is also a member of the Corps. He is cheerful, caring, and highly trusted by those around him. While generally positive, he also has a thoughtful approach to things because of the life experience he's accumulated as a Reliver."},{"spoiler":false,"text":"Occupation: Courrune handyman, Corps member"},{"spoiler":false,"text":"From Aksys Games"}],"source":"vndb","sourceCharacterId":"c97365"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0ecf957c5a9db91247fc9eb5b6f17663e4de1c0d1430e533030e9c8e0b7e499.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c716a48ef3d5e7a44d94edd3eb5c191f60b528ba7e140f98de84563f47317f9.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山下 誠一郎","creatorId":"vndb:s4901","sourcePersonId":"vndb:s4901","canonicalEntityId":"vndb:s4901","name":"山下 誠一郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92396","source":"vndb"}]},{"characterId":"char_vndb_c97366","characterName":"ダハト","sourceIds":{"vndbCharacterId":"c97366"},"originalCharacterName":"ダハト","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"birthday":{"reviewState":"source-only","source":"vndb","value":"831"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I'II leave the rest to the young ones and our not-so-young one! ★\""},{"spoiler":false,"text":"A boy who serves as deputy director of the National Research Institute, and is known to be a genius second only to Scien. Scien's lack of interest in life forces Dahut to take care of Scien's daily chores, despite which he is still somewhat mistreated by Scien. He is extremely friendly and loves baking."},{"spoiler":false,"text":"Occupation: Researcher, Deputy Director of the National Research Institute"},{"spoiler":false,"text":"From Aksys Games"},{"spoiler":true,"text":"His real name is Liam Rêvepoir (リアム・レーヴポワール)."}],"source":"vndb","sourceCharacterId":"c97366"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb2a9fb82751e0b5a159a8336c0be29fbffdd2d01297f85b2843f0720e6774d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7ecc10e87b5dcf95106c524c95eb2917946657e612bf391a28375c3ef483a536.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"土岐 隼一","creatorId":"vndb:s12701","sourcePersonId":"vndb:s12701","canonicalEntityId":"vndb:s12701","name":"土岐隼一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92401","source":"vndb"}]},{"characterId":"char_vndb_c97367","characterName":"ナディア・プルースト","sourceIds":{"vndbCharacterId":"c97367"},"originalCharacterName":"ナディア・プルースト","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"12"},"birthday":{"reviewState":"source-only","source":"vndb","value":"107"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Brother... Isn't this the kind of thing you'd call 'fate'?\""},{"spoiler":false,"text":"Lucas's younger sister. She is cheerful and loves talking about romance. She has been living in the hospital for treatment of an unknown physical ailment, which makes it impossible for her to walk on her own. Her current concern is that her brother hasn't shown much interest in romantic relationships."},{"spoiler":false,"text":"From Aksys Games"}],"source":"vndb","sourceCharacterId":"c97367"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/181fb206eba35de5f8210c64f85c50e7b94e61d02d39c61760a688fb24365729.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02e55f5279f5daa76fa206f7594cf2cecc853b9d9af17c4da93d95e807559ec3.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"久保田 梨沙","creatorId":"vndb:s20485","sourcePersonId":"vndb:s20485","canonicalEntityId":"vndb:s20485","name":"久保田 梨沙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92402","source":"vndb"}]},{"characterId":"char_vndb_c97368","characterName":"カプシーヌ","sourceIds":{"vndbCharacterId":"c97368"},"originalCharacterName":"カプシーヌ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStat