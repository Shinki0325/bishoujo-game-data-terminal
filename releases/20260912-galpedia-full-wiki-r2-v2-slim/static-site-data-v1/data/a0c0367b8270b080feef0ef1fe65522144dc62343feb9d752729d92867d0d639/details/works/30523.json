{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"30523","model":{"presentationWorkId":"egs:30523","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_101199","characterName":"やがみ たかゆき","sourceIds":{"bangumi":[{"characterId":"101199","match":"source-roster","subjectId":"260301"},{"characterId":"101199","match":"source-roster","subjectId":"335206"}]},"originalCharacterName":"やがみ たかゆき","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"＜主人公・元弁護士の探偵＞"},{"spoiler":false,"text":"出演：木村拓哉"},{"spoiler":false,"text":"かつて殺人の容疑者を弁護し、無罪を勝ち取ることに成功したが、その人物が再び殺人事件を犯したことで弁護士を続ける気力を失い、探偵業を始めた過去を持つ。"},{"spoiler":false,"text":"八神曾经为杀人事件的嫌疑犯・大久保新平担当辩护人，并成功赢得了无罪判决。然而大久保却在之后再次犯下杀人事件，八神也因此备受打击放弃了律师的职业转而成为一名侦探。"}],"source":"bangumi","sourceCharacterId":"101199"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9608178c625faa311142c2f3ab48f310bdd63d24836da7d6f6c85b730e12469.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/3709547c157e722d02318820587f86431ed2706bfbc48895c58fc4f64519548b.webp","width":160,"height":240,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_101200","characterName":"かいとう まさはる","sourceIds":{"bangumi":[{"characterId":"101200","match":"source-roster","subjectId":"260301"},{"characterId":"101200","match":"source-roster","subjectId":"335206"}]},"originalCharacterName":"かいとう まさはる","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segmen