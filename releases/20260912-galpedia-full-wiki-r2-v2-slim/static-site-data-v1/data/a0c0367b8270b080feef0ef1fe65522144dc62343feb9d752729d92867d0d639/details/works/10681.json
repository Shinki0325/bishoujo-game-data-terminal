ー、裕樹くん元気してるー？」"}],"source":"bangumi","sourceCharacterId":"37983"}],"profileFacts":[{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"18528","sourceWorkId":"10681","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"18528","sourceWorkId":"10681","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"18528","sourceWorkId":"10681","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"18528","sourceWorkId":"10681","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"53 kg","valueContext":null,"source":"egs","sourceCharacterId":"18528","sourceWorkId":"10681","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e13898b17ab6ca3aab2cb785c067396d3580a19444e8989135358f73630cd22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09b4ca26dbb4f2a5970d75a1fd867201f9f0c327cefa7501909224e76bb41357.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:152372:37983:5906:1","source":"bangumi"}]},{"characterId":"char_c47415","characterName":"東條 紫苑","sourceIds":{"bangumi":[{"characterId":"37985","match":"exact-normalized-name-in-linked-work","subjectId":"152372"}],"egsCharacterIds":["18530"],"vndbCharacterId":"c47415"},"originalCharacterName":"東條 紫苑","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","valu