":false,"text":"Now employed by a reputable magazine company, Mikage remains unwavering in her belief in Sousuke's innocence. Determined to right the wrong, she embarks on a personal quest to unravel the tangled threads of the murder case and vindicate her cherished friend."}],"source":"vndb","sourceCharacterId":"c28762"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53dea3c1139707dc1751834e027366589f4771c280fb8afa635c23249a10d387.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29d08a0e6a8e014ab29db7fc9d1fdc5f79405d0ef90ea2ba898f5ad0d456adf4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"うえおか あい","creatorId":"vndb:s13","sourcePersonId":"vndb:s13","canonicalEntityId":"vndb:s13","name":"河原木 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5742","source":"vndb"}]},{"characterId":"char_vndb_c28763","characterName":"韮崎 璃宝","sourceIds":{"vndbCharacterId":"c28763"},"originalCharacterName":"韮崎 璃宝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Riho is Sosuke's jazz singer buddy and a coworker at CADENZA. She is a hardworker who came to Japan after fleeing the Shanghai incident."}],"source":"vndb","sourceCharacterId":"c28763"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fdb30f7859fc847c2f46400de9ba591652a3da7985377794f35074901327385.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04cf3ff006cbba11fce80b6cd63acd8fdcccd969be3ae1d7af6af35c9b1eb98a.webp","width":186,"height":256,"source":"static-detail"},"a