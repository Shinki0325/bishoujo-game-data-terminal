、"},{"spoiler":false,"text":"周りからも一歩引いた扱いをされるようになる。"},{"spoiler":false,"text":"夏休みの退屈しのぎに刺激を求めて『Sucre』のメイド募集に応募する。"},{"spoiler":false,"text":"持ち前の器用さを生かし、客によって態度を変化させるという接客を武器にしている。"}],"source":"bangumi","sourceCharacterId":"167413"}],"profileFacts":[{"label":"特技","source":"bangumi","sourceCharacterId":"167413","value":"演技"},{"label":"趣味","source":"bangumi","sourceCharacterId":"167413","value":"映画鑑賞"},{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"20773","sourceWorkId":"9139","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"20773","sourceWorkId":"9139","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"20773","sourceWorkId":"9139","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"20773","sourceWorkId":"9139","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"bloodType":[{"comparisonValue":"ab","source":"vndb","sourceCharacterId":"c1112","value":"ab"},{"comparisonValue":"a","source":"egs","sourceCharacterId":"20773","value":"A"},{"comparisonValue":"ab","source":"bangumi","sourceCharacterId":"167413","value":"AB"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c32210c4f1a7a6efd39c81125ade318b7ac0fb45256ee7494d76032232fe0f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d25c739fd2d01b9de416ca2ed3f25fcd5945f35640a88c108febc4e290f9a058.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:525705:167413:4432:1","source":"bangumi"}]},{"characterId":"char_c111