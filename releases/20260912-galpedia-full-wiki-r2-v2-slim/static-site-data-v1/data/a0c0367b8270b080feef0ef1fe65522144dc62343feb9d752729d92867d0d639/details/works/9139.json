ments":[{"spoiler":false,"text":"夏休みを利用してメイド喫茶「Sucre」でバイトすることになった女の子。"},{"spoiler":false,"text":"真面目で素直、人当たりもよく、誰からも好かれる性格。"},{"spoiler":false,"text":"マンガ大好き少女で、その守備範囲は少年誌から耽美系コミックまで幅広い。"},{"spoiler":false,"text":"そうした話を始めると、周囲を置き去りにして暴走し、妄想の世界へと旅立っていく。"}],"source":"egs","sourceCharacterId":"20772","sourceWorkId":"9139","spoiler":false},{"segments":[{"spoiler":false,"text":"基本的には真面目で素直な性格。"},{"spoiler":false,"text":"人当たりが良く誰からも好かれ、敵を作らない。"},{"spoiler":false,"text":"無類のマンガ好きで、少年誌から耽美系コミックまで守備範囲は幅広い。"},{"spoiler":false,"text":"気に入った作品と出会うと、数日間は作品世界にハマり続け、語りに入ろうものなら"},{"spoiler":false,"text":"一通り話し終えるまでは勢いが止まらず、周りの人間（お客さん含む）を置き去りに"},{"spoiler":false,"text":"することもしばしばあり、本人も気にしている。"},{"spoiler":false,"text":"ヒートアップすると、妄想全開の世界へと突入し手がつけられなくなることも。"},{"spoiler":false,"text":"夏休みを利用して「Sucre」で働くことになる。"}],"source":"bangumi","sourceCharacterId":"167412"}],"profileFacts":[{"label":"特技","source":"bangumi","sourceCharacterId":"167412","value":"本の内容を忘れない"},{"label":"趣味","source":"bangumi","sourceCharacterId":"167412","value":"読書(マンガ)、書籍収集"},{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"20772","sourceWorkId":"9139","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"20772","sourceWorkId":"9139","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"20772","sourceWorkId":"9139","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"20772","sourceWorkId":"9139","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/232df73e60c66dbc269ab2e45960a22dd9605070610ca4c41a6f873fae5eec7b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18a8660d6b6202c75abcc9f56597788770d0ecae750ec74f1ecd8c265c7b