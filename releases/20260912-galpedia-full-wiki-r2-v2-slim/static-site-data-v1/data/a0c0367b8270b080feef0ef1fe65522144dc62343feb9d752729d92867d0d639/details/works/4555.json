egments":[{"spoiler":false,"text":"鐘ノ音学園の一年生。"},{"spoiler":false,"text":"双子の姉妹の妹。"},{"spoiler":false,"text":"常に姉・葉月と一緒におり、葉月のやることに便乗して大騒ぎしていることが多い。"},{"spoiler":false,"text":"力任せな姉とは対照的に、頭の回転がはやく、鋭い洞察力を持ち、気配り上手で家庭的な面もあり、まるで隙がない女の子。"}],"source":"egs","sourceCharacterId":"13543","sourceWorkId":"4555","spoiler":false},{"segments":[{"spoiler":false,"text":"学年：１年生"},{"spoiler":false,"text":"誕生花：あざみ (花言葉：独立)"},{"spoiler":false,"text":"星座：てんびん座"},{"spoiler":false,"text":"１年生の双子姉妹の妹。"},{"spoiler":false,"text":"姉の葉月と常に一緒にいて、大抵は葉月のやることに便乗して大騒ぎしている事が多い。"},{"spoiler":false,"text":"実際は気配り上手で頭も良く、鋭い洞察力を見せることもしばしば。"},{"spoiler":false,"text":"頭の回転は速く、家庭科も得意という隙のない女の子。"},{"spoiler":false,"text":"でも寝るときにはマイ寝袋が手放せない。"},{"spoiler":false,"text":"葉月の暴走を止めるのはいつも花月。"},{"spoiler":false,"text":"一撃必殺のサブミッションで音もなく仕留める。"}],"source":"bangumi","sourceCharacterId":"141984"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76ca38716ae8685c9f20342767c720192655be498e706717987d1fd222733e7b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/8559c3c9249b87c881a20dd84936f6ea76618dc4ded6de76e0155dd94a9dcb41.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西原久美子","creatorId":"vndb:s1474","sourcePersonId":"vndb:s1474","canonicalEntityId":"vndb:s1474","name":"西原 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99057:141984:5242:1","source":"bangumi"}]},{"characterId":"char_c4475","characterName":"美杉　舞","sourceIds":{"bangumi":[{"characterId":"141982","match":"exact-normalized-name-in-linked-work","subjectId":"99057"}],"egsCharacterIds":["13541"],"vndbCharacterId":"c4475"},"originalCharacterName":"美杉　舞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","sourc