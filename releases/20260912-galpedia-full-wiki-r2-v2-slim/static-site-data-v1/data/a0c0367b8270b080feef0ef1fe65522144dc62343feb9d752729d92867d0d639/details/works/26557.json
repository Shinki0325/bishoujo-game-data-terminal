rder to find out..."}],"source":"vndb","sourceCharacterId":"c70333"},{"segments":[{"spoiler":false,"text":"深谷商業南学校在籍の2年生。"},{"spoiler":false,"text":"男兄弟の中で育ってきた彼女は、砕けた言葉遣いやバレー部のエースだということも相まって女子から好意を寄せられることも多かった。実は女性らしく振る舞いたいと感じており、小柄で女の子らしいまつりに憧れている。"},{"spoiler":false,"text":"ある日、まつりが援交している現場を目撃してしまった亜季。"},{"spoiler":false,"text":"入り乱れる感情を処理しきれない彼女は、まつりを理解するために同じ世界へ踏み入ることに。"}],"source":"egs","sourceCharacterId":"19769","sourceWorkId":"26557","spoiler":false},{"segments":[{"spoiler":false,"text":"深谷商業南学校在籍の2年生。"},{"spoiler":false,"text":"男兄弟の中で育ってきた彼女は、砕けた言葉遣いやバレー部のエースだということも相まって女子から好意を寄せられることも多かった。"},{"spoiler":false,"text":"実は女性らしく振る舞いたいと感じており、小柄で女の子らしいまつりに憧れている。"},{"spoiler":false,"text":"ある日、まつりが援交している現場を目撃してしまった亜季。"},{"spoiler":false,"text":"入り乱れる感情を処理しきれない彼女は、まつりを理解するために同じ世界へ踏み入ることに。"}],"source":"bangumi","sourceCharacterId":"62666"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/3084fee6305afe336ecd51e4f4486c5dc37d55ba098067923bb0e703126234ef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49f22e691e8f466e5c813e2ff4bd7ed5b5ce7e6186fe7667465136eb4d86a989.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹立幾美","creatorId":"vndb:s15460","sourcePersonId":"vndb:s15460","canonicalEntityId":"vndb:s15460","name":"祭場あかね","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:237932:62666:64225:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:5336","sourceCompanyId":"egs:brand:5336","canonicalEntityId":"egs:brand:5336","name":"DOLCE","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:26557:5336","source":"egs"},{"companyId":"vndb:p6705","sourceCompanyId":"vndb:p6705","canonicalEntityId":"vndb:p6705","name":"Dolce","roleCodes":["developer","publisher"],"identityStatus":"source-nativ