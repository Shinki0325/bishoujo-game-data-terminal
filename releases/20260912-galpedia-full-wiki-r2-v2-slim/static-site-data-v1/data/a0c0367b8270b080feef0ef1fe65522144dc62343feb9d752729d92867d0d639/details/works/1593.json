{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"1593","model":{"presentationWorkId":"egs:1593","staff":{"artwork":[{"creditedName":"THE SEIJI(青空みどり)","creatorId":"vndb:s6401","sourcePersonId":"egs:creator:542","canonicalEntityId":"vndb:s6401","name":"THE SEIJI(青空みどり)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:8615","source":"egs"}],"scenario":[{"creditedName":"THE SEIJI(青空みどり)","creatorId":"vndb:s6401","sourcePersonId":"egs:creator:542","canonicalEntityId":"vndb:s6401","name":"THE SEIJI(青空みどり)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:8616","source":"egs"}],"music":[{"creditedName":"SOUND DEKICHI","creatorId":"vndb:s7183","sourcePersonId":"egs:creator:3131","canonicalEntityId":"vndb:s7183","name":"SOUND DEKICHI","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:67154","source":"egs"}],"other":[]},"cast":[{"characterId":"char_bangumi_147666","characterName":"安堂麗奈","sourceIds":{"bangumi":[{"characterId":"147666","match":"source-roster","subjectId":"268659"}]},"originalCharacterName":"安堂麗奈","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"スタイルも良くて笑顔も素敵で、間違いなく可愛いです。男子の理想の容姿を備えている。"},{"spoiler":false,"text":"しかし、内心は極度の嫉妬心と強い独占欲の持ち主。その一方で、非常にうるさい一面も持つ。恋人のあらゆる行動をコントロールできなければ、彼女は満足できません。"},{"spoiler":false,"text":"上品と言えば真面目な一面もあるが、恋人の心を掴むためなら後先を選ばず何でもする一面もある。"},{"spoiler":false,"text":"正当な理由があれば、恥知らずな行為も拒否しない。そのため、人に騙されやすいのです。"},{"spoiler":false,"text":"趣味も熱意も何もなく、ただ恋人のことだけがすべてです。学力は良くも悪くもありません。"}],"source":"bangumi","sourceCharacterId":"147666"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94a826c27f0a3edf4fc50563a82bbf3337ae8960377514f166871c5708f2d271.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/0243f2df01696cc3b45ca42819889fccca8381a9ff688575a37a4f55e4ae5ecd.webp","width":105,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長崎みなみ","creatorId":"vndb:s1073","sourcePersonId":"vndb:s1073","canonicalEntityId":"vndb:s1073","name":"長崎 みなみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268659:147666:19411:1","source":"bangumi"}]},{"characterId":"char_bangumi_147667","characterName":"東丸彩","sourceIds":{"bangumi":[{"characterId":"147667","match":"source-roster","subjectId":"268659"}]},"originalCharacterName":"東丸彩","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"あまり目立ちませんが、かなり可愛い印象を与えます。やる気のない性格で存在感はあまりないが、よく見るとレイナより可愛いかも。"},{"spoiler":false,"text":"彼女はいつも本を読んでいます。いつも考え事に夢中なので、今何を考えているのかわかりにくい。見た目だけだと騙されやすそうだが、実はかなり手強い人物。"},{"spoiler":false,"text":"性的には発展していないが、相手を狙えば確実に堕とす。非常に粘り強い性格の持ち主。"},{"spoiler":false,"text":"さらに彼女は賢く、将棋でも一歩一歩相手を追い詰めることができる。"},{"spoiler":false,"text":"趣味には知的好奇心を満たすことができるものすべてが含まれます。特に将棋と囲碁。成績順位は3位以下。"}],"source":"bangumi","sourceCharacterId":"147667"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8de216c4ba1164dffcb5f53188787472b69118c10944c280c795b3a865560943.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/265a15cac82c6c40dc632ac1539746252bd5c41c7ca7b349887616c67761c8d0.webp","width":105,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩居由希子","creatorId":"vndb:s1160","sourcePersonId":"vndb:s1160","canonicalEntityId":"vndb:s1160","name":"岩居 由希子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268659:147667:4163:1","source":"bangumi"}]},{"characterId":"char_bangumi_147668","characterName":"榊原美穂","sourceIds":{"bangumi":[{"characterId":"147668","match":"source-roster","subjectId":"268659"}]},"originalCharacterName":"榊原美穂","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"レイナよりもセクシーで大人っぽい雰囲気を醸し出しています。"},{"spoiler":false,"text":"学生とは思えない大人びた気質の持ち主。非常に理解のある性格で、嫉妬することを不快に感じ、男女間の面倒な関係を嫌います。"},{"spoiler":false,"text":"性的好奇心は非常に無制限であり、そのためテクニックはかなり磨かれています。"},{"spoiler":false,"text":"何事も儚いと感じ、コツコツと何かを続けるのが苦手。"},{"spoiler":false,"text":"普通の男子生徒からは敬遠されるが、セックスに自信のある男性には向いている。彼女自身もそのスリルを楽しんでいます。"},{"spoiler":false,"text":"趣味にはスポーツ全般が含まれます。特に彼女はスノーボードに夢中です。ダンスも大好きです。彼女は勉強がとても苦手です。"}],"source":"bangumi","sourceCharacterId":"147668"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb4ada0f9c8d3c6890a73c862ed5c51790fe004e3d5bc6172ee7badbdb5e63b5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/581380fa106f5d079693a05f0a42697dffaefea5541ede63d1181a950fbaf747.webp","width":105,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南雲涼","creatorId":"vndb:s2416","sourcePersonId":"vndb:s2416","canonicalEntityId":"vndb:s2416","name":"南雲 涼","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268659:147668:41840:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p1502","sourceCompanyId":"egs:brand:191","canonicalEntityId":"vndb:p1502","name":"DEEP ZONE","roleCodes":["brand"],"identityStat