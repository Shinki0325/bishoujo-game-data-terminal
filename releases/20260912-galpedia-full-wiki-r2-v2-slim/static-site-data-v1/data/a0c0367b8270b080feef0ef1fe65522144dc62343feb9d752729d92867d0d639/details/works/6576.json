月 悠","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:38183","source":"vndb"},{"creditedName":"柚木 まき","creatorId":"vndb:s1631","sourcePersonId":"vndb:s1631","canonicalEntityId":"vndb:s1631","name":"柚木 まき","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:38186","source":"vndb"},{"creditedName":"柚木 まき","creatorId":"vndb:s1631","sourcePersonId":"vndb:s1631","canonicalEntityId":"vndb:s1631","name":"柚木 まき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:38187","source":"vndb"}]},"cast":[{"characterId":"char_c5133","characterName":"成瀬 南","sourceIds":{"bangumi":[{"characterId":"130070","match":"exact-normalized-name-in-linked-work","subjectId":"99096"}],"egsCharacterIds":["26119"],"vndbCharacterId":"c5133"},"originalCharacterName":"成瀬 南","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"神谷家のメイドとしてやってきた女子学生。"},{"spoiler":false,"text":"明朗快活で、誰とでもすぐに仲良くなれる気さくな女の子。"},{"spoiler":false,"text":"学園でも男女問わず人気がある。"},{"spoiler":false,"text":"仕事はスピードが命と、テキパキこなすが、仕上がりがやや雑。"}],"source":"egs","sourceCharacterId":"26119","sourceWorkId":"6576","spoiler":false},{"segments":[{"spoiler":false,"text":"欧介に雇われたメイドの1人。性格は明るく活発で、現役学園生であり神谷家から直接学園に通う。欧介の喧嘩相手。家事はテキパキとこなすが、多少荒っぽい。学園では、男女共に人気があり告白もされているが、仕事が多忙の為、誰とも付き合った事はない。欧介の年齢を知って、驚愕していた。"}],"source":"bangumi","sourceCharacterId":"130070"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1ce4d5311e17c86ac7faabe40fe54b0c2ea756ba02eb43bc6c8fdb63dc4ccb24.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1acab5bb8bd2663604755442beb994203d097226d512e89e411690c11576d643.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99096:130070:5020:1","source":"bangumi"}]},{"characterId":"char_c5134","characterName":"丘野 かなた","sourceIds":{"bangumi":[{"characterId":"130074","match":"exact-normalized-name-in-linked-work","subjectId":"99096"}],"egsCharacterIds":["26123"],"vndbCharacterId":"c5134"},"originalCharacterName":"丘野 かなた","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"神谷家執事見習いの男（？）の子。"},{"spoiler":false,"text":"爽やかな笑顔をふりまく、元気いっぱいの働き者。"},{"spoiler":false,"text":"仕事ぶりも有能で、人の何十倍も動き回り、テキパキ仕事をこなす。"},{"spoiler":false,"text":"そんな彼には誰にも知られてはならない秘密があるようだが……。"}],"source":"egs","sourceCharacterId":"26123","sourceWorkId":"6576","spoiler":false},{"segments":[{"spoiler":false,"text":"欧介に雇われた執事見習い。欧介に「これで女だったら、理想的なメイドじゃないか」と思わせる程爽やかな性格で、自分の思った事を口に出さず、我慢強い性格。どんな事があっても、ニッコリと笑って見せる程爽やかである。欧介いわく、「炭酸飲料のコマーシャルに出てくるタレントのようなさわやかな笑顔」。毎朝、小鳥に餌を与えている。他に男がいなくなった為、欧介の友達になりたいと願っている。実は、かなたにはある秘密が････。"}],"source":"bangumi","sourceCharacterId":"130074"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"f","source":"vndb","sourceCharacterId":"c5134","value":"f"},{"comparisonValue":"m","source":"egs","sourceCharacterId":"26123","value":"男性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"26123","value":"女性"},{"comparisonValue":"f","source":"bangumi","sourceCharacterId":"130074","value":"女"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb70f9343bcd1d9f9b5d8a317cd2b4432f9cfdefd3da95dbe33f45742fde1c0d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/6717b899e17565d3f3ed45253603ec83235a63d707f2e7ac5f3eb55c4c25a1d5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"すずきけいこ","creatorId":"vndb:s445","sourcePersonId":"vndb:s445","canonicalEntityId":"vndb:s445","name":"すずき けいこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99096:130074:6275:1","source":"bangumi"}]},{"characterId":"char_c5135","characterName":"雲宮 姫子","sourceIds":{"bangumi":[{"characterId":"130072","match":"exact-normalized-name-in-linked-work","subjectId":"99096"}],"egsCharacterIds":["26120"],"vndbCharacterId":"c5135"},"originalCharacterName":"雲宮 姫子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"神谷家のメイドとしてやってきた主人公の幼馴染にして、大金持ちのお嬢様。"},{"spoiler":false,"text":"幼馴染の関係だが、一度しか会ったことがなく、それでも主人公を「お兄さま」と呼んで慕い、お嫁さんになりたいと思っている。"},{"spoiler":false,"text":"ほのぼのおっとりお淑やかな性格。また夢見がちで、ハニカミ屋さん。"},{"spoiler":false,"text":"メイドの仕事を頑張ろうとするが、お嬢様なので家事能力は皆無。"}],"source":"egs","sourceCharacterId":"26120","sourceWorkId":"6576","spoiler":false},{"segments":[{"spoiler":false,"text":"欧介に雇われたメイドの1人。大富豪の令嬢。欧介とは幼馴染で、彼の事を「お兄さま」と慕う。子供の頃から欧介に想いを寄せており、将来は彼と結婚しようと思っていたが、欧介自身は彼女の事を覚えてはいなかった為、落胆する。しかし、意地らしい性格の為、それでも彼のそばにいたいが為にメイドになる事を決意するが、お嬢様の為家事能力は皆無に等しい。乙女チックで、一度妄想をすると止まらない。"}],"source":"bangumi","sourceCharacterId":"130072"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d94cc7088b919bf5f96c7a41abc9a47101f8d8419d58e2f2852d531bcb60e0c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20c2a3bcca8c1456057838b253a3b774bb5e22a2fdf02c24c3fe57131a252eac.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99096:130072:4689:1","source":"bangumi"}]},{"characterId":"char_c5136","characterName":"秋山 夕絵","sourceIds":{"bangumi":[{"characterId":"130071","match":"exact-normalized-name-in-linked-work","subjectId":"99096"}],"egsCharacterIds":["26121"],"vndbCharacterId":"c5136"},"originalCharacterName":"秋山 夕絵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"神谷家のメイド長。"},{"spoiler":false,"text":"優しく穏やかで、母性本能と慈愛に満ち溢れた女性。"},{"spoiler":false,"text":"家事能力は抜群で、丁寧確実にして気配り上手。"},{"spoiler":false,"text":"これまで多くの屋敷を私歩き、極悪非道、冷酷非情、***上等の主人達を“いいひと”に変えたと云われる伝説を持つ。"}],"source":"egs","sourceCharacterId":"26121","sourceWorkId":"6576","spoiler":false},{"segments":[{"spoiler":false,"text":"欧介に雇われたメイドの1人。メイド長を務める。優しい性格で、欧介に対して常に気遣っている。家事については、丁寧で非の打ち所が無く、料理も申し分無い様である。過去に多くの主人に雇われた様だが、どの主人もどんな悪人であろうと、必ずと言ってよい程「いいひと」になっている。"}],"source":"bangumi","sourceCharacterId":"130071"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/643a5b0e4c3c0d1ddf0ee967bfd9da99e85ad8b2498530299e5a41e2b99210a8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27cc956863170aabfec09d5a1a1edc4f33983582fda23868d79eef58a1ea8c96.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99096:130071:4832:1","source":"bangumi"}]},{"characterId":"char_c5137","characterName":"白木 藍理","sourceIds":{"bangumi":[{"characterId":"130073","match":"exact-normalized-name-in-linked-work","subjectId":"99096"}],"egsCharacterIds":["26122"],"vndbCharacterId":"c5137"},"originalCharacterName":"白木 藍理","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"神谷家のメイド。"},{"spoiler":false,"text":"西洋のお人形のような美少女だが、性格は無口で無愛想。"},{"spoiler":false,"text":"何を考えているのかわからなければ、掴みどころもないエキセントリックな少女。"},{"spoiler":false,"text":"スケッチブックを常に持ち歩き、ことあるごとに絵を描いている。"},{"spoiler":false,"text":"メイドでありながら仕事はまったくせず、させようとすると寝てしまう。"}],"source":"egs","sourceCharacterId":"26122","sourceWorkId":"6576","spoiler":false},{"segments":[{"spoiler":false,"text":"欧介に雇われたメイドの1人。西洋人形の様な容姿をした超美少女。しかし家事はせず無口で無愛想で、スケッチブックを常に持ち歩いている。しょっちゅう、このスケッチブックに絵を描いているが、ゲームの冒頭で南に追われ走って来た欧介に描いていた絵を踏まれてしまい、見事な足形が付く。姫子同様家事能力は皆無に等しく、家事をさせようとしても眠ってしまう。欧介は何か反応を示さないかアプローチをするが、何も反応しない。"}],"source":"bangumi","sourceCharacterId":"130073"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/3627ed724bd2b87d17dc9e6d1545c05f6e4c0f1d7f053b3010df64d4db9030f4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a93fe7071dfe16fb3e5c52415c2dd9c414c3559d7d4e10934a4150fc6c4c6c4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99096:130073:4830:1","source":"bangumi"}]},{"characterId":"char_c5138","characterName":"桜井 野乃花","sourceIds":{"bangumi":[{"characterId":"130075","match":"exact-normalized-name-in-linked-work","subjectId":"99096"}],"egsCharacterIds":["26124"],"vndbCharacterId":"c5138"},"originalCharacterName":"桜井 野乃花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An illegitimate child of Ousuke's. She calls him \"Papa\". She's happy when he's happy, and sad when he's sad."},{"spoiler":false,"text":"from Getchu"}],"source":"vndb","sourceCharacterId":"c5138"},{"segments":[{"spoiler":false,"text":"主人公を「パパさま」と呼ぶ、謎の少女。"},{"spoiler":false,"text":"主人公の隠し子（？）。"}],"source":"egs","sourceCharacterId":"26124","sourceWorkId":"6576","spoiler":false},{"segments":[{"spoiler":false,"text":"欧介の隠し子(?)。欧介の事を「パパさま」と呼び、慕う。家族から、自分自身と既に鬼籍に入っている母親の里湖の事を白眼視されるのに耐えられなくなり、家を飛び出し、父親（？）の欧介の許へとやって来た。欧介と一緒に寝る時に「七つの子」を歌うが、この歌は里湖に教えて貰った歌。"}],"source":"bangumi","sourceCharacterId":"130075"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/5638bb80f7edd8879b53d30cad11e83b6264226227a31259a95ad2cbb2a3baa2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2f46c7a9f3362823a0a4540e79b67ac10d79d13e5bd614e4bda57678f39a0ba.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99096:130075:4714:1","source":"bangumi"}]},{"characterId":"char_vndb_c5132","characterName":"神谷 欧介","sourceIds":{"vndbCharacterId":"c5132"},"originalCharacterName":"神谷 欧介","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"President of a major company. A conceited rich man with no family or friends."}],"source":"vndb","sourceCharacterId":"c5132"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a3e8313c53a1cd5da9c1bdf82278ae4ed9f25bc61fbea97558b6500f5fec45a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/047d9dfff28619d0d35d48993071faceb68a392ae439619b200804ebc78f4ff5.webp","width":144,"height":163,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c5139","characterName":"麗奈","sourceIds":{"vndbCharacterId":"c5139"},"originalCharacterName":"麗奈","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44aa3fb7afc11b85c0253d2e2756abee8e7b465d03a617eb89b3f013448ff5ef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/2203ae2b78f755706ba505500c7dc1de237fa09393bd3acacc43bcaf8e74e439.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一色 ヒカル","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20566","source":"vndb"}]},{"characterId":"char_vndb_c5140","characterName":"桜井 野乃花","sourceIds":{"vndbCharacterId":"c5140"},"originalCharacterName":"桜井 野乃花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image