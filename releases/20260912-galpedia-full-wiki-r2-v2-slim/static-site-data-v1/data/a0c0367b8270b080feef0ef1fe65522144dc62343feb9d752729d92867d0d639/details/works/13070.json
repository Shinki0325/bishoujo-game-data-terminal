ataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a1ec06c6c4fa68184c92e1f96bf708b3411b32e5ad8025c160a0d940487e567.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/6917eabb8e8c7f86b256c423a2cfb07ec847a32ae3cdfdf616a171482d8fad71.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16472:147265:5936:1","source":"bangumi"}]},{"characterId":"char_c26330","characterName":"広瀬 歩","sourceIds":{"bangumi":[{"characterId":"147266","match":"exact-normalized-name-in-linked-work","subjectId":"16472"}],"egsCharacterIds":["14395"],"vndbCharacterId":"c26330"},"originalCharacterName":"広瀬 歩","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【自信が足りないアスリート】"},{"spoiler":false,"text":"スポーツ推薦で奨学金をもらっている水泳部所属の同級生。"},{"spoiler":false,"text":"実力は十分あるのだが、本番に弱いという欠点があり、大会での成績は散々。"},{"spoiler":false,"text":"明るい性格だが、競技で結果を残さなければならないという事情に、ちょっと悩みを抱えている。"},{"spoiler":false,"text":"主人公が妙に未来のことを知っているので不審に思うようになるが‥‥"},{"spoiler":false,"text":"女たらしのコーチに狙われているという噂も!?"},{"spoiler":false,"text":"隠れた少女趣味で、フリフリのピンク色の服が好き。"}],"source":"egs","sourceCharacterId":"14395","sourceWorkId":"13070","spoiler":false},{"segments":[{"spoiler":false,"text":"同級生。スポーツ推薦で奨学金をもらっている水泳部所属。"},{"spoiler":false,"text":"明るい性格だが、競技で結果を残さなければならないという事情に、ちょっと悩みを抱えている。"},{"spoiler":false,"text":"実力は十分あるのだが、本番に弱いという欠点があり、大会での成績は散々。"},{"spoiler":false,"text":"次の大きな大会で成績を残さなければ、退部（＝退学）させられるという状況なので、一人居残りで練習している。"},{"spoiler":false,"text":"隠れた少女趣味で、フリフリのピンク色の服が好き。"},{"spoiler":false,"tex