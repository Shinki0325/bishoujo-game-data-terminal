viewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の妹。実家の人間からは姫様と呼ばれる。生まれつき左目がなく、閉じている。そちらは髪の毛で隠している。未来予知の力があり、その力を使う時だけ無いはずの左目が開く。その時の光彩が猫のような目になっていて、赤く染まっている。観測した未来を確定する力があるが、体力を非常に消耗する。"},{"spoiler":false,"text":"八重垣家は幾重にも広がる未来を予知してきた家系であり、未来予知の力を持つ瑠璃が次期後継者となっている。"},{"spoiler":false,"text":"双子として生まれ、片方は能力を得て、もう片方は代償として神への供物とされるが、悟は右腕だけを代償として生き残ってしまった。そのため出来損ないとされ、未来予知を持つ瑠璃を次期後継者としている。"},{"spoiler":false,"text":"実家ではそのような扱いだったため、人前では兄と一線を引いた態度を取り「兄さん」と呼ぶが、二人きりの時では態度が変わる。"},{"spoiler":false,"text":"その変化っぷりは二重人格を疑われる程。"},{"spoiler":false,"text":"また、双子だが悟と瑠璃では誕生日が数日違う。悟を出産した後に陣痛が収まってしまったため母体に多大な負荷が掛かり、瑠璃を生んだ後に亡くなってしまった。"}],"source":"bangumi","sourceCharacterId":"71596"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"21456","sourceWorkId":"25637","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"21456","sourceWorkId":"25637","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"21456","sourceWorkId":"25637","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"21456","sourceWorkId":"25637","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a394aa48ff311fba0ccd2661ef246f445744bb139c045df07ac90bab8d2d9b34.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/aba1002f19073845d1bb4ab8c63d48328e5149d6a806a24377bf8f48f7416ec6.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原舞","creatorId":"vndb:s985","sourcePersonId":"vndb:s985","canonicalEntityId":"vndb:s985","name":"石原 舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:254126:71596:13372:1","source":"bangumi"}]},{"characterId":"char_c65247","characterName":"稲田 鏡花","sourceIds":{"bangumi":[{"characterId":"71597","match":"exact-normalized-name-in-linked-work","subjectId":"254126"}],"egsCharacterIds":["21457"],"vndbCharacterId":"c65247"},"originalCharacterName":"稲田 鏡花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"瑠璃に仕えるメイド。二人の同級生で幼馴染。稲田家は古くから八重垣家に仕える家柄で、彼女も瑠璃の事を「姫様」と呼ぶ。"},{"spoiler":false,"text":"瑠璃と一緒に行動している時は、従者としての態度を崩さずにメイドとして徹しているが、職務から離れている時は一人の幼馴染としての顔を見せる。"}],"source":"bangumi","sourceCharacterId":"71597"}],"profileFacts":[{"label":"胸围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"21457","sourceWorkId":"25637","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"21457","sourceWorkId":"25637","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"21457","sourceWorkId":"25637","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"21457","sourceWorkId":"25637","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aaee265c2948017f9ca3cff8aac813f645275caaa366762e4f19f7a1c3f6c0fa.webp","fallbackUrl":"https://wiki-assets.bishojo