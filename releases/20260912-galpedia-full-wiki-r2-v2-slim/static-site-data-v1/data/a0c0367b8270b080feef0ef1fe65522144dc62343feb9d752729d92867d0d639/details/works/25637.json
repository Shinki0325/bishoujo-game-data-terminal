aracterId":"31056","value":"他人に絡んでくる連中"},{"label":"特技","source":"bangumi","sourceCharacterId":"31056","value":"修理、手品"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8ef97d85e7475be6fb92ea0fc1e90e15e7264b91132eeee32c94042a2869be55.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01f01d96c047a941bad4fc9d2f2b32b8a3fdc0a953f8abb3fa749e09a5c6de23.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c1377","characterName":"神凪 莉都","sourceIds":{"bangumi":[{"characterId":"31057","match":"exact-normalized-name-in-linked-work","subjectId":"15909"}],"egsCharacterIds":["18652"],"vndbCharacterId":"c1377"},"originalCharacterName":"神凪 莉都","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"111"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kannagi Rito, the chairman of Amatsuhara Private Academy. She inherited the title from Seika’s grandfather which acts as her guardian after she broke her relationship with the Kannagi family. Ever since a little girl, she is very wise and calculative in her every action. But meeting Shin'ya has changed something within her heart."},{"spoiler":false,"text":"Edited from Kresnik's review."}],"source":"vndb","sourceCharacterId":"c1377"},{"segments":[{"spoiler":false,"text":"●特技：頭脳労働　●好き：進矢達のいる今の生活　●嫌い：神凪の実家"},{"spoiler":false,"text":"主人公が10年ぶりに再会した「幼馴染」で「相棒」。"},{"spoiler":false,"text":"真面目で正義感が強く冷静沈着。さらには容姿端麗、頭脳明晰、運動神経抜群！"},{"spoiler":false,"text":"完璧を絵に描いたような彼女だが、極度の口下手で、特に同世代との会話が苦手。"},{"spoiler":false,"text":"財閥のお嬢様だったが、現在は出奔中。「天都原学園」は彼女の所有物らしい。"},{"spoiler":false,"text":"「タマの言うシステムは理解したが、どこまでが本当の事だか。進矢の意見を聞かせてくれ」"}],"source":"egs","sourceCharacterId":"18652","sourceWorkId":"10520","spoiler":false},{"segments":[{"spoiler":false,"text":"10年ぶりに再会した幼なじみで相棒。"},{"spoiler":false,"text":"彼女の提案で進矢は学園に戻ってくることになった。"},{"spoiler":false,"text":"性格は沈着冷静。生真面目で正義感が強い。"},{"spoiler":false,"text":"容姿端麗、頭脳明晰、運動神経抜群と天は二物も三物も与えているが、口下手で同年代との付き合いは極端に苦手で周囲から敬遠され友達も少ない。"},{"spoiler":false,"text":"よく和奏に『常識的な女子学生の習慣』とやらを吹き込まれて騙されている。"},{"spoiler":false,"text":"実家は有数の財閥だが、現在は出奔している。天都原学園は彼女の所有物。"},{"spoiler":false,"text":"「タマの言うシステムは理解したが、どこまでが本当のことだか。進矢の意見を聞かせてくれ」"}],"source":"bangumi","sourceCharacterId":"31057"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"31057","value":"進矢たちのいる今の生活"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"31057","value":"神凪の実家"},{"label":"特技","source":"bangumi","sourceCharacterId":"31057","value":"頭脳労働"},{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"18652","sourceWorkId":"25637","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"166 cm","valueContext":null,"source":"egs","sourceCharacterId":"18652","sourceWorkId":"25637","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"18652","sourceWorkId":"25637","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"18652","sourceWorkId":"25637","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a1ea3464a9c25f9bce1098556db21f6a0cb74f799153d956c68ae65d6ca83e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/char