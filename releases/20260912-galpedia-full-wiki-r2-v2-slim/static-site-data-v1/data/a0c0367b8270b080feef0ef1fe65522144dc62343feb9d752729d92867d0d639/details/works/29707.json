d":"vndb:vn-staff:117559","source":"vndb"},{"creditedName":"aina","creatorId":"vndb:s9294","sourcePersonId":"vndb:s9294","canonicalEntityId":"vndb:s9294","name":"aina","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:117560","source":"vndb"},{"creditedName":"グランテール井上","creatorId":"vndb:s9295","sourcePersonId":"vndb:s9295","canonicalEntityId":"vndb:s9295","name":"グランテール井上","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:117561","source":"vndb"},{"creditedName":"大木 犬太郎","creatorId":"vndb:s10273","sourcePersonId":"vndb:s10273","canonicalEntityId":"vndb:s10273","name":"大木 犬太郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:117562","source":"vndb"},{"creditedName":"kobi","creatorId":"vndb:s10984","sourcePersonId":"vndb:s10984","canonicalEntityId":"vndb:s10984","name":"kobi","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:117563","source":"vndb"}]},"cast":[{"characterId":"char_c42268","characterName":"主人公","sourceIds":{"bangumi":[],"egsCharacterIds":["6639"],"vndbCharacterId":"c42268"},"originalCharacterName":"主人公","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this story."},{"spoiler":false,"text":"He was admitted as a case of \"Fairytale Syndrome,\" but he doesn't remember anything, nor does he know his name, or even the role he'd swamped himself in."},{"spoiler":false,"text":"As he befriends the girls of Paradise, he becomes entangled in various mysteries, tragedies, and adventures."},{"spoiler":false,"text":"translated from official website"}],"source":"vndb","sourceCharacterId":"c42268"},{"segments":[{"spoiler":false,"text":"この物語の主人公。"},{"spoiler":false,"text":"「フェアリーテイル・シンドローム」の患者として運び込まれてきたらしいが、一切の記憶を失っており、溺れていた役割どころか、自分の名前すらわからない。"},{"spoiler":false,"text":"「楽園」の少女たちと親交を深めるうちに、様々な謎、悲劇、冒険といったものに巻き込まれることになる。"}],"source":"egs","sourceCharacterId":"6639","sourceWorkId":"21746","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e7d393a89e45c98f935bbe8039422fc8433b199e8d2d99b08fc60a36d104ed2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/853f89ac1beaa98a83285dcc2f7f140ca7300f2ec319a5c571dcb2ee6b9bceee.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c42269","characterName":"アリス","sourceIds":{"bangumi":[{"characterId":"64912","match":"exact-normalized-name-in-linked-work","subjectId":"128761"}],"egsCharacterIds":["6640"],"vndbCharacterId":"c42269"},"originalCharacterName":"アリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She's the most curious, innocent, and emotionally driven one of the girls. She can be a bit selfish and quite capricious, but she is kind and lachrymose when receiving affection. She's trying to act like a \"full-fledged lady,\" but she is simply too immature to define what it means to be a lady."},{"spoiler":false,"text":"Her ignorance, innocence, and naïve sensibilities result in elusive dialogues that are frustrating at turns, yet can also sometimes strike at one's very core."},{"spoiler":false,"text":"translated from official website"}],"source":"vndb","sourceCharacterId":"c42269"},{"segments":[{"spoiler":false,"text":"好奇心旺盛で無邪気、感性で動く少女の中の少女。ちょっとだけわがままで、かなり気まぐれで、でも与えられた愛の分だけ優しく涙もろい。「一人前のレディ」的振る舞いを意識して背伸びをするが、いかんせん幼すぎてレディの定義がずれている。"},{"spoiler":false,"text":"無知、無垢、無邪気な幼い感性から繰り出される捉えどころのない会話は、苛々させられる一方で時折核心を突かれる印象。"}],"source":"egs","sourceCharacterId":"6640","sourceWorkId":"21746","spoiler":false},{"segments":[{"spoiler":false,"text":"好奇心旺盛で無邪気、感性で動く少女の中の少女。"},{"spoiler":false,"text":"ちょっとだけわがままで、かなり気まぐれで、でも与えられた愛の分だけ優しく涙もろい。"},{"spoiler":false,"text":"“楽園” に来たばかりで、最初は自分というものを見失っている様子。"},{"spoiler":false,"text":"ぼーっとした捉えどころのない挙動で奇行を繰り返す。"}],"source":"bangumi","sourceCharacterId":"64912"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d9879c327389ac77d308bb786d9eeaad5c53eed77d6990ead9c52ac3a40ff4e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c26a9cfa73351df57fac1ea06fc43c97bce000bc9698812ab9cb92005dea3b7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ミルノ純","creatorId":"vndb:s564","sourcePersonId":"vndb:s564","canonicalEntityId":"vndb:s564","name":"ミルノ 純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:128761:64912:6167:1","source":"bangumi"}]},{"characterId":"char_c42270","characterName":"グレーテル","sourceIds":{"bangumi":[{"characterId":"64913","match":"exact-normalized-name-in-linked-work","subjectId":"128761"}],"egsCharacterIds":["6641"],"vndbCharacterId":"c42270"},"originalCharacterName":"グレーテル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A timid, withdrawn, and weepy girl akin to a small animal, who tries to convey her feelings through her eyes, facial expressions, and cries. Unable to carry on her story alone, she is looking for her brother \"Hansel\"."},{"spoiler":false,"text":"Despite her slender frame, she is a gluttonous, voracious eater. She is often underestimated, but shows bold behaviour when under pressure."},{"spoiler":false,"text":"translated from official website"}],"source":"vndb","sourceCharacterId":"c42270"},{"segments":[{"spoiler":false,"text":"臆病で引っ込み思案で泣き虫、瞳と表情と悲鳴で気持ちを伝えようとする、小動物のような女の子。ひとりでは物語を進めることができないので、兄の「ヘンゼル」を探している。"},{"spoiler":false,"text":"細っこい体のわりに食い意地が張っていて大食らい。見くびられがちだが、追いつめられると大胆な行動に出る。"}],"source":"egs","sourceCharacterId":"6641","sourceWorkId":"21746","spoiler":false},{"segments":[{"spoiler":false,"text":"臆病で引っ込み思案で泣き虫、瞳と表情と悲鳴で気持ちを伝えようとする、小動物のような女の子。"},{"spoiler":false,"text":"“楽園” においてはアリスと同様、新参。"},{"spoiler":false,"text":"丁寧ながら距離を置いた対応をし、お菓子ではなく真っ当な薬を処方するイケノに不審をつのらせるが、やがて笑顔の増えた彼に心を開く。"}],"source":"bangumi","sourceCharacterId":"64913"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63ef562e4cfc54e499b3602ae189a165db2f41ec8c65f617c365017bdac290d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/811e1d7fad26f2c45fd86180ba8d0fdb972a13226137fa6f1ac326c801ccb782.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:128761:64913:4463:1","source":"bangumi"}]},{"characterId":"char_c42271","characterName":"オデット","sourceIds":{"bangumi":[{"characterId":"64914","match":"exact-normalized-name-in-linked-work","subjectId":"128761"}],"egsCharacterIds":["6642"],"vndbCharacterId":"c42271"},"originalCharacterName":"オデット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Odette: innocent, pure and foolish. Odile: clever but fragile at heart. The two are similar in their beauty."},{"spoiler":false,"text":"Odile, who is quick-witted and to the point, mocks, taunts, and oppresses the quiet, weak-minded Odette."},{"spoiler":false,"text":"After being cursed to turn into a swan, Odette alights by the lake only during the night, which is when the power of her curse wanes."},{"spoiler":false,"text":"translated from official website"}],"source":"vndb","sourceCharacterId":"c42271"},{"segments":[{"spoiler":false,"text":"無垢で清らかで愚かなオデットと、賢いけれどささくれ立った心を持つオディール。相似の美貌を持つふたり。頭の回転が速く要領のいいオディールが、おっとりとしていて頭の弱いオデットを馬鹿にし、嘲り、虐げている、そんな関係性。"},{"spoiler":false,"text":"白鳥に変わる呪いをかけられてしまったオデットは、呪いの力の薄まる夜にのみ、湖の畔に降り立つ。"}],"source":"egs","sourceCharacterId":"6642","sourceWorkId":"21746","spoiler":false},{"segments":[{"spoiler":false,"text":"無垢で清らかで愚かなオデットと、賢いけれどささくれ立った心を持つオディール。 相似の美貌を持つふたり。"},{"spoiler":false,"text":"頭の回転が速く要領のいいオディールが、おっとりとしていて頭の弱いオデットを馬鹿にし、嘲り、虐げている。"},{"spoiler":false,"text":"原因不明の失明をしたオデットに対し、悪態をつきながらも面倒を見るオディールだが──"}],"source":"bangumi","sourceCharacterId":"64914"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6be086bf56bab64bae04316097f908bed0fea5191a6f410358077b6c1c98ef29.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1cef24a2df43599a15d4fda77121294d3abce833d443d62cdbc2fb6b39906acd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:128761:64914:5741:1","source":"bangumi"}]},{"characterId":"char_c42272","characterName":"オディール","sourceIds":{"bangumi":[{"characterId":"64915","match":"exact-normalized-name-in-linked-work","subjectId":"128761"}],"egsCharacterIds":["6643"],"vndbCharacterId":"c42272"},"originalCharacterName":"オディール","characterNameSource":null,"role":"primary","status":"sour