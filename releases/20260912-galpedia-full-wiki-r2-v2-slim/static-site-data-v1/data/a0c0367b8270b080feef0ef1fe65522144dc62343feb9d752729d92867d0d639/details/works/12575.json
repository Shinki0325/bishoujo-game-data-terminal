{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"12575","model":{"presentationWorkId":"vndb:v5259","staff":{"artwork":[{"creditedName":"辰波要徳","creatorId":"vndb:s3732","sourcePersonId":"egs:creator:1113","canonicalEntityId":"vndb:s3732","name":"辰波要徳","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:78209","source":"egs"}],"scenario":[{"creditedName":"西崎秒弥","creatorId":"vndb:s3728","sourcePersonId":"egs:creator:371","canonicalEntityId":"vndb:s3728","name":"西崎秒弥","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:78348","source":"egs"}],"music":[],"other":[{"creditedName":"スタジオLadybug(Studio LadyBug、スタジオレディバグ)","creatorId":"vndb:s32377","sourcePersonId":"egs:creator:19879","canonicalEntityId":"vndb:s32377","name":"スタジオLadybug(Studio LadyBug、スタジオレディバグ)","detail":"音響","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:137387","source":"egs"},{"creditedName":"辰波要徳","creatorId":"vndb:s3732","sourcePersonId":"egs:creator:1113","canonicalEntityId":"vndb:s3732","name":"辰波要徳","detail":"CG彩色","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:137388","source":"egs"},{"creditedName":"辰波 要徳","creatorId":"vndb:s3732","sourcePersonId":"vndb:s3732","canonicalEntityId":"vndb:s3732","name":"辰波 要徳","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:56281","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c103867","characterName":"日泉 早人","sourceIds":{"vndbCharacterId":"c103867"},"originalCharacterName":"日泉 早人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main character of this story."},{"spoiler":false,"text":"He is a college student attending a second-rate private university starting this spring. He has just started living alone due to a somewhat cold family situation."},{"spoiler":false,"text":"He is not particularly fond of older people."},{"spoiler":false,"text":"from official site"}],"source":"vndb","sourceCharacterId":"c103867"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c61011","characterName":"北野 多香子","sourceIds":{"vndbCharacterId":"c61011"},"originalCharacterName":"北野 多香子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"41"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mother of Kojirou and wife of Kenji."},{"spoiler":false,"text":"She is a cheerful, vivacious, and refreshing woman who works as a store keeper at “Toy no Kitano” (now “Hobby Shop Kitano”) on the way to Haiyori Elementary School. She is frightening when she gets angry. Every elementary school boy baptized her front store with candy trash and empty capsules."},{"spoiler":false,"text":"Her favorite dish is curry filled with vegetables from her family's farm. However, his son and his friends do not like it, saying, “It tastes good, but there are too many vegetables."},{"spoiler":false,"text":"from official site"}],"source":"vndb","sourceCharacterId":"c61011"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/677f45a0b5d5ac06a3bb12dc1c90f12e51d6fbfab45f37ecc914a289ddbe5c2a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e54bd65d4c9c9e2ce4e365c603cfd5605791450ad70b72244276976da8c3827.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨津 さえ","creatorId":"vndb:s1653","sourcePersonId":"vndb:s1653","canonicalEntityId":"vndb:s1653","name":"雨津 さえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31193","source":"vndb"}]},{"characterId":"char_vndb_c61012","characterName":"北野 小次郎","sourceIds":{"vndbCharacterId":"c61012"},"originalCharacterName":"北野 小次郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He and the main character are best and worst friends. They have been friends for 12 years since first grade elementary school."},{"spoiler":false,"text":"He is an only son. He pretends to be a student at a film school and often hangs out in the main character's room. He used to be part of a bad boy duo with the main character, called \"The Rocket brothers\". Nowadays he's a playboy who combined smooth talking and comedy."},{"spoiler":false,"text":"He always wears tinted glasses, but he has no sister. The fake fur he wears around his neck seems to be popular at parties, and costs 6,980 yen at “Tokyo Autobahn,” where you can find everything."},{"spoiler":false,"text":"from official site"}],"source":"vndb","sourceCharacterId":"c61012"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3e0c558d9b4dfaa22d8d973dc33130728e114fc73faeef30c530fd047415ec9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b2a74b1afe943470dd4ee998cc62681a7a8ee1bffac6ff80e875626de951b37.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c61013","characterName":"北野 憲次","sourceIds":{"vndbCharacterId":"c61013"},"originalCharacterName":"北野 憲次","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Currently the famous manager of Hobby Shop Kitano. He is a warm and friendly person. He renovated “Toys no Kitano” three years ago, and is a hardworking manager trying to survive the recession through online shopping."},{"spoiler":false,"text":"He is the “master of plastic model making” for many elementary school students, including the main character, and his skills are still legendary, but he laments the fact that children these days have no interest in plastic models."},{"spoiler":false,"text":"He married his wife, Takako, when he was over 30, so he is already 50 years old. He and his wife get along well. His chronic illnesses are back pain and presbyopia. He loves to drink. Drinking at a tavern “Kumakiri Izo” in the shopping arcade is his way of taking a break from life."},{"spoiler":false,"text":"from official site"}],"source":"vndb","sourceCharacterId":"c61013"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef45fae9b1e0954e1920224d5dfc49dd78a720da73f6d573c48c39f19d4cba33.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb7fdbed804f567050ee05d7a93725741cdaeda7ed8dce98560fbab74b24ee56.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:981","sourceCompanyId":"egs:brand:981","canonicalEntityId":"egs:brand:981","name":"Autobahn","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:12575:981","source":"egs"},{"companyId":"vndb:p1617","sourceCompanyId":"vndb:p1617","canonicalEntityId":"vndb:p1617","name":"Autobahn","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:11800:v5259","source":"vndb"},{"companyId":"vndb:p1617","sourceCompanyId":"vndb:p1617","canonicalEntityId":"vndb:p1617","name":"Autobahn","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:20274:v5259","source":"vndb"}],"missingStates":["confirmed-character-relation-missing"],"source":"terminal-wiki-full-runtime-v7"}}
