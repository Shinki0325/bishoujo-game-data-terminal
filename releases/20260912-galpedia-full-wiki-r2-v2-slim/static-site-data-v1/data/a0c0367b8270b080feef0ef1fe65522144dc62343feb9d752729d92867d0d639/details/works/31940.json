tyStatus":"source-native","relationId":"vndb:vn-staff:179823","source":"vndb"},{"creditedName":"rapiecage","creatorId":"vndb:s16605","sourcePersonId":"vndb:s16605","canonicalEntityId":"vndb:s16605","name":"rapiecage","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:179824","source":"vndb"},{"creditedName":"KIT","creatorId":"vndb:s17303","sourcePersonId":"vndb:s17303","canonicalEntityId":"vndb:s17303","name":"KIT","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:179825","source":"vndb"},{"creditedName":"望月 侑","creatorId":"vndb:s17887","sourcePersonId":"vndb:s17887","canonicalEntityId":"vndb:s17887","name":"望月侑","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:179826","source":"vndb"},{"creditedName":"薄迷","creatorId":"vndb:s23592","sourcePersonId":"vndb:s23592","canonicalEntityId":"vndb:s23592","name":"薄迷","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:179828","source":"vndb"},{"creditedName":"アーサー石井","creatorId":"vndb:s24218","sourcePersonId":"vndb:s24218","canonicalEntityId":"vndb:s24218","name":"アーサー石井","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:179829","source":"vndb"}]},"cast":[{"characterId":"char_c103439","characterName":"シルフィア・ルミナ・ウィンストル","sourceIds":{"bangumi":[{"characterId":"103486","match":"exact-normalized-name-in-linked-work","subjectId":"360764"}],"egsCharacterIds":["24182"],"vndbCharacterId":"c103439"},"originalCharacterName":"シルフィア・ルミナ・ウィンストル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A kind princess bound by a curse."},{"spoiler":false,"text":"\"I must be a condemned soul. The curse on me will surely bring you down as well.\""},{"spoiler":false,"text":"Princess of the Kingdom of Winstoll."},{"spoiler":false,"text":"She's demure and shy but has a tender heart that cares deeply for nature and all living things, constantly praying for the well-being of her subjects."},{"spoiler":false,"text":"Because of a particular curse she carries, she was raised in seclusion within the castle walls. Summoned to the castle as Gran's betrothed due to a pact between him and King Winstoll, she is groomed as the sacrificial lamb for a mysterious ritual."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c103439"},{"segments":[{"spoiler":false,"text":"ウィンストル王国の王女。"},{"spoiler":false,"text":"控えめで気弱だが、自然や生き物を慈しみ、いつも国民の幸せを願っている、心優しい性格。"},{"spoiler":false,"text":"ある呪いを身に宿していることから、城の中で、人から遠ざけて育てられた。"},{"spoiler":false,"text":"ウィンストル王とグランの間に交わされた約束により、彼の婚約者として城に招かれるが、"},{"spoiler":false,"text":"とある儀式の生贄として調教されることになる。"}],"source":"egs","sourceCharacterId":"24182","sourceWorkId":"31940","spoiler":false},{"segments":[{"spoiler":false,"text":"ウィンストル王国の王女。"},{"spoiler":false,"text":"控えめで気弱だが、自然や生き物を慈しみ、いつも国民の幸せを願っている、心優しい性格。"},{"spoiler":false,"text":"ある呪いを身に宿していることから、城の中で、人から遠ざけて育てられた。"},{"spoiler":false,"text":"ウィンストル王とグランの間に交わされた約束により、彼の婚約者として城に招かれるが、 とある儀式の生贄として調教されることになる。"}],"source":"bangumi","sourceCharacterId":"103486"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63e218684cfc178c20736ade4d73da250bb5dace141760fb1168ada283e0cb1f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b57091b8db22d44a64e21b3b30d03c533c1babda8fcf312426c59208c42bfc25.webp","width":134,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水野七海","creatorId":"vndb:s2524","sourcePersonId":"vndb:s2524","canonicalEntityId":"vndb:s2524","name":"星野七海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:360764:103486:17078:1","source":"bangumi"}]},{"characterId":"char_c103463","characterName":"エリザ","sourceIds":{"bangumi":[{"characterId":"103487","match":"exact-normalized-name-in-linked-work","subjectId":"360764"}],"egsCharacterIds":["24183"],"vndbCharacterId":"c103463"},"originalCharacterName":"エリザ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An arrogant, intelligent vampire."},{"spoiler":false,"text":"\"It's foolish to be trapped in the same regret forever. For both you and I...\""},{"spoiler":false,"text":"An intelligent woman who cooperates with Gran to perform the princess's training ritual."},{"spoiler":false,"text":"A \"Vampire\" who possesses the power of a curse that lived for a hundred years by drinking on people's blood. Her captivating body exudes demonic allure, and she is confident with it."},{"spoiler":false,"text":"She is a cool but arrogant character. She enjoys inciting others with her sarcasm. She possesses the power of \"mental manipulation\", allowing her to charm others and control their bodies."},{"spoiler":false,"text":"She seems to have some other objective behind the scenes for cooperating with the ritual..."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c103463"},{"segments":[{"spoiler":false,"text":"グランに協力し姫の調教儀式を行う、頭脳明晰な女性。"},{"spoiler":false,"text":"呪いの力を身に宿し、人の生き血を啜って数百年以上を生きる『吸血鬼』。"},{"spoiler":false,"text":"魔性の色香を醸す魅惑的な身体をしており、本人もそれに自信を持っている。"},{"spoiler":false,"text":"クールだが傲慢な性格をしており、皮肉で他人を煽るのを愉しむことも。"},{"spoiler":false,"text":"他人を魅了し身体を支配することもできる、「精神操作」の力を持つ。"},{"spoiler":false,"text":"儀式に協力する裏で、何か別の『目的』を持っているようだが……。"}],"source":"egs","sourceCharacterId":"24183","sourceWorkId":"31940","spoiler":false},{"segments":[{"spoiler":false,"text":"グランに協力し姫の調教儀式を行う、頭脳明晰な女性。"},{"spoiler":false,"text":"呪いの力を身に宿し、人の生き血を啜って数百年以上を生きる『吸血鬼』。"},{"spoiler":false,"text":"魔性の色香を醸す魅惑的な身体をしており、本人もそれに自信を持っている。"},{"spoiler":false,"text":"クールだが傲慢な性格をしており、皮肉で他人を煽るのを愉しむことも。"},{"spoiler":false,"text":"他人を魅了し身体を支配することもできる、「精神操作」の力を持つ。"},{"spoiler":false,"text":"儀式に協力する裏で、何か別の『目的』を持っているようだが……。"}],"source":"bangumi","sourceCharacterId":"103487"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a04d58b3b3374e1a8cfdb97f4dbcb268538491fffb341529c2d7b5aa08e1c3d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f5ffedc40c9933983bf8c35a7ceba976d68d4305b1f2c1207d09dcf31e96a74.webp","width":134,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤邑鈴香","creatorId":"vndb:s2309","sourcePersonId":"vndb:s2309","canonicalEntityId":"vndb:s2309","name":"藤邑鈴香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:360764:103487:16173:1","source":"bangumi"}]},{"characterId":"char_c103464","characterName":"ミズベット","sourceIds":{"bangumi":[{"characterId":"103488","match":"exact-normalized-name-in-linked-work","subjectId":"360764"}],"egsCharacterIds":["24184"],"vndbCharacterId":"c103464"},"originalCharacterName":"ミズベット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An elegant warcat with a beastly heart."},{"spoiler":false,"text":"\"Ah... Why am I always like this...?\""},{"spoiler":false,"text":"A bright and lovely girl in cooperation with Gran, who will perform the princess's training ritual."},{"spoiler":false,"text":"She tries to act ladylike, but her genuine personality appears whenever she gets flustered. She will show her cold side to her prey, like a hunter."},{"spoiler":false,"text":"She possesses the power of \"Physical Manipulation\" which sharpens her senses and transforms her body into a beast. Her curse changed her from a lady to a \"Warcat\" beast, and she hated it because her looks became unladylike when it came to her identity."},{"spoiler":false,"text":"She is searching for \"something\" she has lost in the past while cooperating with the ritual."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c103464"},{"segments":[{"spoiler":false,"text":"グランに協力し姫の調教儀式を行う、明るく愛くるしい少女。"},{"spoiler":false,"text":"淑女らしく振る舞おうとするが、慌てると素の性格が出てしまう。"},{"spoiler":false,"text":"獲物に対しては狩人のように冷酷な一面も見せることも。"},{"spoiler":false,"text":"呪いによって獣から人に変化した『ワーキャット』だが、"},{"spoiler":false,"text":"自分の正体については、淑女らしくないと見せることを嫌う。"},{"spoiler":false,"text":"感覚を鋭く敏感にしたり、身体を魔獣に変貌させる、「肉体操作」の力を持つ。"},{"spoiler":false,"text":"儀式に協力しながら、過去に無くしてしまった『何か』を探し求めている。"}],"source":"egs","sourceCharacterId":"24184","sourceWorkId":"31940","spoiler":false},{"segments":[{"spoiler":false,"text":"グランに協力し姫の調教儀式を行う、明るく愛くるしい少女。"},{"spoiler":false,"text":"淑女らしく振る舞おうとするが、慌てると素の性格が出てしまう。"},{"spoiler":false,"text":"獲物に対しては狩人のように冷酷な一面も見せることも。"},{"spoiler":false,"text":"呪いによって獣から人に変化した『ワーキャット』だが、 自分の正体については、淑女らしくないと見せることを嫌う。"},{"spoiler":false,"text":"感覚を鋭く敏感にしたり、身体を魔獣に変貌させる、「肉体操作」の力を持つ。"},{"spoiler":false,"text":"儀式に協力しながら、過去に無くしてしまった『何か』を探し求めている。"}],"source":"bangumi","sourceCharacterId":"103488"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/316ae440affb0f324169fa8a5eaa510cd250ad23bc9dc3673beb9f8782c7e30d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cf14c35863bc8c2a64ad67dd13977c06e7e77affb55760b2b2369e6e6f9d68a.webp","width":134,"height":256,"source":"static-detail"},"actors":[{"creditedName":"君島りさ","creatorId":"vndb:s2310","sourcePersonId":"vndb:s2310","canonicalEntityId":"vndb:s2310","name":"君島 りさ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:360764:103488:17675:1","source":"bangumi"}]},{"characterId":"char_c103465","characterName":"ノート","sourceIds":{"bangumi":[{"characterId":"103489","match":"exact-normalized-name-in-linked-work","subjectId":"360764"}],"egsCharacterIds":["24185"],"vndbCharacterId":"c103465"},"originalCharacterName":"ノート","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A beautiful, expressionless homunculus."},{"spoiler":false,"text":"\"I don't know... There is no mistake about my objective, so why do I feel so lost?\""},{"spoiler":false,"text":"A doll-like girl who cooperates with Gran in performing the princess's training ritual. A \"Homunculus\" powered by a curse. She is indifferent and lacked the ability to express her emotions, but she wanted to talk about them in detail or pursue them when it came to things that interest her."},{"spoiler":false,"text":"She possesses the power \"Tool Creation.\" Allowing her to create and manipulate various tools with magical power."},{"spoiler":false,"text":"Her main purpose is to fulfil the ritual, but \"memories\" other than the name and the ceremony were missing. The truth is shrouded in mystery..."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c103465"},{"segments":[{"spoiler":false,"text":"グランに協力し姫の調教儀式を行う、作り物のような少女。"},{"spoiler":false,"text":"その正体は呪いによって稼働する『ホムンクルス』。"},{"spoiler":false,"text":"淡々として感情表現に乏しいが、興味を持ったものに関しては、詳しく喋りたがったり、追求したがる性格。"},{"spoiler":false,"text":"呪力によりさまざまな道具を作り操る、「道具創造」の力を持つ。"},{"spoiler":false,"text":"儀式の成就を最大の目的としているが、名前と儀式以外の『記憶』が欠けており、真実は謎に包まれている。"}],"source":"egs","sourceCharacterId":"24185","sourceWorkId":"31940","spoiler":false},{"segments":[{"spoiler":false,"text":"グランに協力し姫の調教儀式を行う、作り物のような少女。"},{"spoiler":false,"text":"その正体は呪いによって稼働する『ホムンクルス』。"},{"spoiler":false,"text":"淡々として感情表現に乏しいが、興味を持ったものに関しては、 詳しく喋りたがったり、追求したがる性格。"},{"spoiler":false,"text":"呪力によりさまざまな道具を作り操る、「道具創造」の力を持つ。"},{"spoiler":false,"text":"儀式の成就を最大の目的としているが、名前と儀式以外の『記憶』が欠けており、 真実は謎に包まれている。"}],"source":"bangumi","sourceCharacterId":"103489"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/531bfd8bacc096fe4462e54ca0ce6f29ae33709e24eeef246393f1911c9871f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89ed2e4ffa61451bc2a97e3602f0d33159c657b98a738e2491bd2fc313833a25.webp","width":134,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北村彩","creatorId":"vndb:s912","sourcePersonId":"vndb:s912","canonicalEntityId":"vndb:s912","name":"北村 彩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:360764:103489:6046:1","source":"bangumi"}]},{"characterId":"char_vndb_c107598","characterName":"ヘンリエッタ・ガレット","sourceIds":{"vndbCharacterId":"c107598"},"originalCharacterName":"ヘンリエッタ・ガレット","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d507294c4e148f5d13c8da497f9d8fd43200fa851f163ef280d08cc086a9b0f9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1ce3c2c1830a1055e2ac393af3bbc097a7bdf32d0e94489284b285dd3aafa680.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梅宮 ここ","creatorId":"vndb:s8768","sourcePersonId":"vndb:s8768","canonicalEntityId":"vndb:s8