,"relationId":"vndb:vn-staff:26381","source":"vndb"},{"creditedName":"安藤 夏","creatorId":"vndb:s8220","sourcePersonId":"vndb:s8220","canonicalEntityId":"vndb:s8220","name":"安藤 夏","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:26385","source":"vndb"},{"creditedName":"くるぶし","creatorId":"vndb:s10570","sourcePersonId":"vndb:s10570","canonicalEntityId":"vndb:s10570","name":"くるぶし","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:26387","source":"vndb"}]},"cast":[{"characterId":"char_c79766","characterName":"エア","sourceIds":{"bangumi":[{"characterId":"136736","match":"exact-normalized-name-in-linked-work","subjectId":"218149"},{"characterId":"136736","match":"exact-normalized-name-in-linked-work","subjectId":"218150"}],"egsCharacterIds":["18373"],"vndbCharacterId":"c79766"},"originalCharacterName":"エア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"素敵な王子さまとのラブロマンスに憧れる、おっとりほんわかした、アースト王国のお姫さま。"},{"spoiler":false,"text":"芸術全般に造詣が深く、美しいものに見とれ、月や星にうっとりした表情を浮かべるなど、日々、健やかに暮らしている。"},{"spoiler":false,"text":"そんな政治にあまり興味のないエアではあるが、彼女の何気ない一言で、飢饉に苦しむ村に寄付が集まったり、反乱が未然に防がれたりと、国民の受けは、むしろかなり良好だったりする。"}],"source":"egs","sourceCharacterId":"18373","sourceWorkId":"9710","spoiler":false},{"segments":[{"spoiler":false,"text":"シンと恋に落ち、ジャンヌ、トトと共にシンと結婚したお姫様。"},{"spoiler":false,"text":"現在は、人材不足なサプルで内政を担当している。"},{"spoiler":false,"text":"シンと結婚し、幾度も身体を重ね「女の悦び」「男女の営み」の経験を積んだエアだが、生来の「妄想癖」は収まることなく、むしろ拡大した様子。"},{"spoiler":false,"text":"今では、イメクラに近い「なりきりエッチ」がほとんどだが、そんな妄想プレイに、どこまでも着いてきてくれるシンを、心から愛している。"},{"spoiler":false,"text":"今回、幼馴染のビィがやってきたことに喜ぶ一方で、今一番大切なもの「夫＝シン」が奪われるのではないかと戦々恐々としている。"}],"source":"egs","sourceCharacterId":"18373","sourceWorkId":"10724","spoiler":false},{"segments":[{"spoiler":false,"text":"歴史あるアースト王国のおっとりほんわかとしたお姫さま。"},{"spoiler":false,"text":"素敵な王子さまとのラブロマンスに憧れている。"},{"spoiler":false,"text":"穏やかで優しくてやわらかく微笑むけれど、ちょっぴりわがまま。"},{"spoiler":false,"text":"芸術全般に造詣が深く、ウィットに富んだ会話に惹かれてしまう。"},{"spoiler":false,"text":"ややドジ。"},{"spoiler":false,"text":"父王はエアの政略結婚の相手を誰にするかで頭を悩ませているが、"},{"spoiler":false,"text":"そんなことはお構いなしに、エアは楽しい時間をはしゃぎ、美しいものに見とれ、"},{"spoiler":false,"text":"月や星を見上げてうっとりして日々健やかに暮らしている。"},{"spoiler":false,"text":"姫としての勤めももちろん果たしているが、エアの興味はむしろ、美しいものに向けられている。"},{"spoiler":false,"text":"政治にあまり興味のないエアであるが、そんなエアの何気ない一言で、"},{"spoiler":false,"text":"飢饉にあえぐ村に寄付が集まったり、反乱が未然に防がれたりと、国民の受けはむしろかなり良好である。"},{"spoiler":false,"text":"もしかするとそれは、気取らず強がらず、一国のお姫さまとして自然体でいられるエアの、"},{"spoiler":false,"text":"姫としての才能なのかもしれない。"}],"source":"bangumi","sourceCharacterId":"136736"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/1384a472246eccb2ae39f8e7bb597bd35a321937ac78d7b801368e9444d2806f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28414928a736b42b7ec1811e3251246d3db2ab28fa0af0045df4bce0ade2d5b1.webp","width":129,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西中 光","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13641","source":"vndb"}]},{"characterId":"char_c79774","characterName":"リーナ","sourceIds":{"bangumi":[{"characterId":"136739","match":"exact-normalized-name-in-linked-work","subjectId":"218149"},{"characterId":"136739","match":"exact-normalized-name-in-linked-work","subjectId":"218150"},{"characterId":"136739","match":"exact-normalized-name-in-linked-work","subjectId":"218151"},{"characterId":"136739","match":"exact-normalized-name-in-linked-work","subjectId":"218154"}],"egsCharacterIds":["15445","17281","18374"],"vndbCharacterId":"c79774"},"originalCharacterName":"リーナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"遺跡を探す途中で立ち寄った、とある町の酒場で出会った少女。"},{"spoiler":false,"text":"その時から、なぜか主人公にずっとついてくる。"},{"spoiler":false,"text":"卓越したメイドの身のこなしを持っており、その技術で、頼みもしないのに身の回りの世話に勤しむ。"},{"spoiler":false,"text":"謎の多い女の子だが、常に主人公を気にかけており、そのにっこり笑顔は、彼のやる気を何倍にもしちゃったりする。"}],"source":"egs","sourceCharacterId":"15445","sourceWorkId":"9710","spoiler":false},{"segments":[{"spoiler":false,"text":"完全無欠のポジティブシンキングを持ち、シン王子を甲斐甲斐しく世話するメイド。"},{"spoiler":false,"text":"かつての古サプル王国がそうであったように、新生サプルもまた、いずれ大陸全土を平和にすると信じている。"},{"spoiler":false,"text":"新生サプル建国以前から、主人公の言葉を信じ、共に旅をしてきた。"},{"spoiler":false,"text":"王子の世話を一手に引き受け、サプル城のメイド長となった今でも変わらず王子を支えている。"},{"spoiler":false,"text":"忙しなく過ぎていく毎日だが、疲れたときに限って王子がかわいがってくれるので、本人にとっては充実した日々である。"},{"spoiler":false,"text":"感じやすい身体なので、仕事中でもいじられちゃうともうたまらなくなってしまう。"},{"spoiler":false,"text":"サプル完全再建も目前の今日この頃だが、さすがのリーナも一人でのお城の切り盛りには少々バテ気味！？"}],"source":"egs","sourceCharacterId":"15445","sourceWorkId":"12350","spoiler":false},{"segments":[{"spoiler":false,"text":"新生サプル建国以前から、シンと共に旅をしてきたメイド。"},{"spoiler":false,"text":"現在は、シンの世話を一手に引き受けるメイド長となって忙しい日々を送っているが、疲れた時には、シンが必ず可愛がってくれるので、本人にとってはとても充実している。"},{"spoiler":false,"text":"感じやすく、仕事中でも弄られると堪らなくなってしまう身体を持つ。"},{"spoiler":false,"text":"ちなみに、完全無欠のスーパーポジティブシンキングは、本作でも健在。"}],"source":"egs","sourceCharacterId":"17281","sourceWorkId":"11241","spoiler":false},{"segments":[{"spoiler":false,"text":"新生サプル建国以前から、シンと共に旅をしてきたメイド。"},{"spoiler":false,"text":"現在は、シンの世話を一手に引き受けるメイド長となって忙しい日々を送っているが、疲れた時にはシンが可愛がってくれるので、とても充実している。"},{"spoiler":false,"text":"感じやすく、仕事中でも弄られると堪らなくなってしまう身体を持つ。"},{"spoiler":false,"text":"ちなみに、完全無欠のスーパーポジティブシンキングは、本作でも健在。"}],"source":"egs","sourceCharacterId":"18374","sourceWorkId":"10724","spoiler":false},{"segments":[{"spoiler":false,"text":"サプルの遺跡を探す途上、とある町の酒場で出会った女の子。"},{"spoiler":false,"text":"その時から、なぜだかずっと付いて来ている。"},{"spoiler":false,"text":"なぜだか、頼まれもしないのに王子の身の回りの世話をし、"},{"spoiler":false,"text":"なぜだかエプロンドレスを着ている。"},{"spoiler":false,"text":"卓越したメイドの身のこなしを見せる、謎の多い女の子。"},{"spoiler":false,"text":"にっこり笑顔は、王子のやる気を何倍にもする。"},{"spoiler":false,"text":"完全無欠のポジティブシンキングを持ち、常に王子を気遣う。"}],"source":"bangumi","sourceCharacterId":"136739"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88020e2aeba0cfd72c5ade0d44732dec850c91553a4a9e855af40792bbecd38d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e05ebe1d3fd33c981f33080192df48e772daa037273dbd03cba9872d72aefbf.webp","width":127,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森 藍子","creatorId":"vndb:s2308","sourcePersonId":"vndb:s2308","canonicalEntityId":"vndb:s2308","name":"南川 のりこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13642","source":"vndb"}]},{"characterId":"char_c91177","characterName":"ビィ","sourceIds":{"bangumi":[{"characterId":"136770","match":"exact-normalized-name-in-linked-work","subjectId":"218150"}],"egsCharacterIds":["18372"],"vndbCharacterId":"c91177"},"originalCharacterName":"ビィ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"歴史と伝統のある「ダルシア王国」の王女。"},{"spoiler":false,"text":"エアとは従姉妹同士で、住まいも歳も近かったことから、幼い頃、一緒によく遊んでいた。"},{"spoiler":false,"text":"「お姫様らしい」お姫様だったエアに対し、お転婆だったビィは、よくエアを引き合いに出されて叱られていたため、姫として、女としてエアにコンプレックスが生まれてしまい、度々、エアが大事にしている物を奪い取ったことあった。"},{"spoiler":false,"text":"今回のサプルへの訪問は、結婚したエアにアドバイスしようと遊びに来たのが目的だが……？"}],"source":"egs","sourceCharacterId":"18372","sourceWorkId":"10724","spoiler":false},{"segments":[{"spoiler":false,"text":"アーストほどではないにしろ、歴史と伝統のある王国ダルシアの姫。"},{"spoiler":false,"text":"母親がアースト王妃の姉であり、エアとは従姉妹同士。住まいも歳も近いので、エアとはよく一緒に遊んでいた。"},{"spoiler":false,"text":"幼い頃からお転婆だったビィは、母にそのことを諌められるとき、たびたびエアが引き合いにだされたことから、ビィの心の底に、姫として、女として、自分よりエアのほうが勝っているのだ、というコンプレックスが生まれた。ただ黙って座っているだけで、周囲の感心と尊敬を集め、思い通りのプレゼントをもらえるエアを妬み、それを自分のものにしようとエアから奪い取ることもたびたび。"},{"spoiler":false,"text":"女としてすっかり成長した今のビィは、すっかり落ち着き、子どもの頃のようなケンカはもうしない。"},{"spoiler":false,"text":"でもやっぱり、ビィの心の奥底深くには、まだ“女としてエアに勝てない”というコンプレックスが潜んでいる。"},{"spoiler":false,"text":"今回のサプルへの訪問は、エアの大切な旦那様なのだから、エアが幸せになるよう、自分がアドバイスしてあげないと、と思い、幼馴染の新居へ遊びに来たというのが目的。"},{"spoiler":false,"text":"だけどその心の底には、エアの大切なものを自分のものにして、自分が女として、エアより勝る部分があるのだということを証明したい、という願望が横たわっているのかもしれない。"}],"source":"bangumi","sourceCharacterId":"136770"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27d05161ae8cf13220d776bfd5ffb1a88dbd1f429aa9352be15d08e22de87eaf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad83b1aa2480cc1c5c72d7c64c8d9797092780d40ad65186bdbccba00fbf366e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"〆野潤子","creatorId":"vndb:s5676","sourcePersonId":"vndb:s5676","canonicalEntityId":"vndb:s5676","name":"〆野 潤子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218150:136770:5080:1","source":"bangumi"},{"creditedName":"神谷 奈央","creatorId":"vndb:s4070","sourcePersonId":"vndb:s4070","canonicalEntityId":"vndb:s4070","name":"神谷 奈央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13643","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p340","sourceCompanyId":"egs:brand:1013","canonicalEntityId":"vndb:p340","name":"ビタミン","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:10724:1013","source":"egs"},{"companyId":"vndb:p340","sourceCompanyId":"vndb:p340","canonicalEntityId":"vndb:p340"