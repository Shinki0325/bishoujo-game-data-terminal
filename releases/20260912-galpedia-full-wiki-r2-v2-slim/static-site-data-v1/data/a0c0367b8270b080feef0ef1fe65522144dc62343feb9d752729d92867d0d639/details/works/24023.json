 英一朗","creatorId":"vndb:s1114","sourcePersonId":"vndb:s1114","canonicalEntityId":"vndb:s1114","name":"柳 英一朗","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:126449","source":"vndb"},{"creditedName":"クサノ ユウキ","creatorId":"vndb:s11387","sourcePersonId":"vndb:s11387","canonicalEntityId":"vndb:s11387","name":"クサノ ユウキ","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:126457","source":"vndb"},{"creditedName":"Emotional Union","creatorId":"vndb:s11579","sourcePersonId":"vndb:s11579","canonicalEntityId":"vndb:s11579","name":"Emotional Union","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:126465","source":"vndb"}],"other":[{"creditedName":"鳩月 つみき","creatorId":"vndb:s1466","sourcePersonId":"vndb:s1466","canonicalEntityId":"vndb:s1466","name":"鳩月 つみき","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:126450","source":"vndb"},{"creditedName":"marina","creatorId":"vndb:s1976","sourcePersonId":"vndb:s1976","canonicalEntityId":"vndb:s1976","name":"marina","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:126451","source":"vndb"},{"creditedName":"やくり","creatorId":"vndb:s2802","sourcePersonId":"vndb:s2802","canonicalEntityId":"vndb:s2802","name":"やくり","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:126452","source":"vndb"},{"creditedName":"Ayumi.","creatorId":"vndb:s1282","sourcePersonId":"vndb:s1282","canonicalEntityId":"vndb:s1282","name":"Ayumi.","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:126454","source":"vndb"},{"creditedName":"与呼太","creatorId":"vndb:s4680","sourcePersonId":"vndb:s4680","canonicalEntityId":"vndb:s4680","name":"与呼太","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-s