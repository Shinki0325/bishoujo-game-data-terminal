":"34400","match":"exact-normalized-name-in-linked-work","subjectId":"926"}],"egsCharacterIds":["14041"],"vndbCharacterId":"c30623"},"originalCharacterName":"魔神アムドシアス","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Duke of Hell, one of Solomon's Demons, the 67th of them."}],"source":"vndb","sourceCharacterId":"c30623"},{"segments":[{"spoiler":false,"text":"芸術と音楽を愛する、ソロモン72柱の一柱にして、魔神・ハイシェラと対立する古神時代の魔神。"},{"spoiler":false,"text":"彼女は、ハイシェラを芸術をわからない乱暴者と卑下し、ハイシェラは彼女を嫌味な軟弱者と罵り、互いに相容れず、妙なライバル意識を持っている。"}],"source":"egs","sourceCharacterId":"14041","sourceWorkId":"6134","spoiler":false},{"segments":[{"spoiler":false,"text":"芸術と音楽を愛する古神時代の魔神。"}],"source":"egs","sourceCharacterId":"14041","sourceWorkId":"11748","spoiler":false},{"segments":[{"spoiler":false,"text":"芸術と音楽を愛する、ソロモン72柱が一柱。"},{"spoiler":false,"text":"『戦女神ZERO』 の「狭間の宮殿」での戦いにおいて、セリカたちを庇って神の墓場へと落ちていた。"},{"spoiler":false,"text":"魔神ハイシェラと対立しており、最初の出会いから気が合わないらしく、何かにつけて競い合っていた節がある。"},{"spoiler":false,"text":"『戦女神ZERO』 ではケレース地方（アヴァタール地方の北隣）の中央部を勢力下に治め、マーズテリア神殿を含む辺境の人間国やハイシェラ軍と勢力争いを繰り広げていた。"}],"source":"bangumi","sourceCharacterId":"34400"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1aa2dc46bced6e7ea2192b57e493600b97ffd8c5b37676dde6bbf7b292adef3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/9648810b9371f4440460f94142e4da9f62fd783b07e5ea34f741526605128e85.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c45419","characterName":"アリツ・グラナドス","sourceIds":{"bangumi":[{"characterId":"37481","match":"exact-normalized-name-in-linked-work","subjectId":"155708"}],"egsCharacterIds":["8122"],"vndbCharacterId":"c45419"},"originalCharacterName":"アリツ・グラナドス","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A trainee pirate in the Water Valley pirate gang; his life changes when the ring which his deceased mother Carlin bequeathed to him as a keepsake was chosen as one of the rings required to unlock passage to the Coral Sea King. Given temporary command of the pirate gang until he assembles all of the rings and is acknowledged by Barmilo as a fully-fledged member, he agonises over the wish he wants the King to grant."}],"source":"vndb","sourceCharacterId":"c45419"},{"segments":[{"spoiler":false,"text":"ルノーシュ地域で活動している水の谷海賊団の見習い船員。"},{"spoiler":false,"text":"母のお腹にいる頃から船に乗っていたという、生粋の海賊。自分の欲望に素直な面があり、また思っていることがすぐ顔に出る感情豊かな青年。"},{"spoiler":false,"text":"難しい事を考えることが苦手であり、感性に従って直感的な行動をとる。明るい性格でノリがよく、面倒見のいい気質から他者と打ち解けるのが上手い。"},{"spoiler":false,"text":"幼少時に死に別れた母親の形見の指輪が光を帯びたことで、幽霊船騒動が終わるまでの期間限定頭領として担ぎ上げられる。一人前の海賊として認められたいという思いから、また、いち海賊としてお祭り騒ぎにはじっとしていられず、指輪の争奪戦に身を投じていく。"}],"source":"egs","sourceCharacterId":"8122","sourceWorkId":"22865","spoiler":false},{"segments":[{"spoiler":false,"text":"所属：水の谷海賊団"},{"spoiler":false,"text":"保有船名：ディベード・コンパニロ　　保有円環：フォルディスの環"},{"spoiler":false,"text":"ルノーシュ地域で活動している水の谷海賊団の見習い船員。"},{"spoiler":false,"text":"母のお腹にいる頃から船に乗っていたという、生粋の海賊。"},{"spoiler":false,"text":"自分の欲望に素直な面があり、また思っていることがすぐ顔に出る感情豊かな青年。"},{"spoiler":false,"text":"難しいことを考えるのが苦手であり、感性に従って直感的な行動をとる。"},{"spoiler":false,"text":"明るい性格でノリがよく、面倒見の良い気質から他者と打ち解けるのが上手い。"},{"spoiler":false,"text":"幼少時に死に別れた母親の形見の円環が光を帯びたことで、"},{"spoiler":false,"text":"幽霊船騒動が終わるまでの 期間限定頭領 として担ぎ上げられる。"},{"spoiler":false,"text":"一人前の海賊として認められたいという思いから、また、いち海賊として"},{"spoiler":false,"text":"お祭り騒ぎにはじっとしていられず、円環の争奪戦に身を投じていく。"},{"spoiler":false,"text":"「よっしゃーっ！ 数百年に一度のお祭り騒ぎだ、水の谷海賊団が旗ふり役として盛り上げていくぜぇー！」"}],"source":"bangumi","sourceCharacterId":"37481"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c048a6b727e6a4259811a99cd9a79bc5ed0a45cc0b2fac8ad895666da02ffe68.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95a0aa0ac7f9fb710711e6b524fb4d27e98cec007297eeb28f78d1d413da79c8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴木千尋","creatorId":"vndb:s182","sourcePersonId":"vndb:s182","canonicalEntityId":"vndb:s182","name":"鈴木 千尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155708:37481:3903:1","source":"bangumi"}]},{"characterId":"char_c45420","characterName":"カーリン・グラナドス","sourceIds":{"bangumi":[{"characterId":"37484","match":"exact-normalized-name-in-linked-work","subjectId":"155708"}],"egsCharacterIds":["8128"],"vndbCharacterId":"c45420"},"originalCharacterName":"カーリン・グラナドス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aritz's mother who died giving birth to him. The ring she bequeathed to him as a keepsake is selected by chance to be one of the rings required to unlock passage to the King. The magic inherent in the ring allows Karin to revive as an incorporeal spirit bound to the ring's power."},{"spoiler":false,"text":"Her reunion with her grown-up son is a source of great joy to Karin, who wants nothing more than to see her son become a fine pirate."}],"source":"vndb","sourceCharacterId":"c45420"},{"segments":[{"spoiler":false,"text":"ルノーシュ地域で活動している水の谷海賊団の女船員。"},{"spoiler":false,"text":"アリツ・グラナドスの母であり、アリツが幼少時に死別していた。自身の形見として『珊海王の円環』を残し、円環が光を帯びた際、呼応するように霊体として具現化し、再会を果たす。"},{"spoiler":false,"text":"女海賊らしい剛気な性格をしているが、人の気持ちを察することが上手な面も持ち合わせており、また他人の世話をやくことを好いている。"},{"spoiler":false,"text":"息子のことを常に慮っており、立派な海賊になるよう導こうという意識で行動していく。"}],"source":"egs","sourceCharacterId":"8128","sourceWorkId":"22865","spoiler":false},{"segments":[{"spoiler":false,"text":"所属：水の谷海賊団"},{"spoiler":false,"text":"ルノーシュ地域で活動している水の谷海賊団の女船員。"},{"spoiler":false,"text":"アリツの母であり、彼が幼少時に死別。 形見として “珊海王の円環” を遺していた。"},{"spoiler":false,"text":"その円環が光を帯びた際、呼応するように霊体として具現化し、アリツと再会を果たす。"},{"spoiler":false,"text":"女海賊らしい剛気な性格だが、人の気持ちを察することが上手く、面倒見が良い。"},{"spoiler":false,"text":"息子のことを常に慮っており、立派な海賊になれるように導いていく。"},{"spoiler":false,"text":"「男なら大望の一つや二つ持っておくもんだよ。 あたいの子なら、このくらい軽くやってみせな！」"}],"source":"bangumi","sourceCharacterId":"37484"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2ce23848f2eaaf8f4ded31161f7919c28d8803231b83f03995070473c7931bb7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/363f5f8d4b7d172264f7cfba53a9fafcf59cd4109cb447f0831ac221ac00352e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水口まつり","creatorId":"vndb:s879","sourcePersonId":"vndb:s879","canonicalEntityId":"vndb:s879","name":"水口 まつり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155708:37484:6380:1","source":"bangumi"}]},{"characterId":"char_c45421","characterName":"バルミロ・アナヤ","sourceIds":{"bangumi":[],"egsCharacterIds":["8129"],"vndbCharacterId":"c45421"},"originalCharacterName":"バルミロ・アナヤ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The leader of the Water Valley pirate gang and effectively Aritz's foster father. He knew Carlin when she was still alive and doesn't hesitate in ceding his position as pirate chief to Aritz and assisting him in his quest to assemble the rings."}],"source":"vndb","sourceCharacterId":"c45421"},{"segments":[{"spoiler":false,"text":"ルノーシュ地域で活動している水の谷海賊団の頭領。海賊団の面々にとっては頼れる大黒柱であり、また父親のような存在である。"},{"spoiler":false,"text":"珊海王の伝説を追うことを生かして、見事、珊海王に謁見することが叶ったら一人前として認めるという条件でアリツに期間限定の仮頭領としてその座を託す。"},{"spoiler":false,"text":"強面だが意外とノリが良く、海賊としての理想を愛する夢追い人。自身の武器として扱う大きな錨は、海賊団の象徴でもある。"}],"source":"egs","sourceCharacterId":"8129","sourceWorkId":"22865","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bb0454f84dadb960dd3e500981a68899f24949a26832c6a4ed0348b67e186c5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/bedd70adaacf28bf242c28f0a4c633c9529aacd86c7ca4dbc416f2e38c088359.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"玉 天我","creatorId":"vndb:s15922","sourcePersonId":"vndb:s15922","canonicalEntityId":"vndb:s15922","name":"玉天我","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67469","source":"vndb"}]},{"characterId":"char_c45422","characterName":"ソーニャ","sourceIds":{"bangumi":[{"characterId":"37478","match":"exact-normalized-name-in-linked-work","subjectId":"155708"}],"egsCharacterIds":["8123"],"vndbCharacterId":"c45422"},"originalCharacterName":"ソーニャ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A genius magician brought up by the Elinun magician's guild, Sonya is dispatched to the Lunoush archipelago with orders to secure the rings. She encounters Damon's pirate gang and easily hijacks and seizes command of his ship, casting a spell on Damon transforming him into a pink organism to serve as her guide and to prevent him from escaping (she also likes his cute appearance)."},{"spoiler":false,"text":"Although she generally speaks with a monotone, offence is taken when she is treated like a child because of her build and appearance. She also has a sharp tongue and is indifferent to the fate of her defeated foes."}],"source":"vndb","sourceCharacterId":"c45422"},{"segments":[{"spoiler":false,"text":"エリヌヌ魔術匠合に育てられ、円環を集める使命を帯びてルノーシュ地域に派遣された天才魔術師。"},{"spoiler":false,"text":"魔術師としての格は神格位級であるが、得意としている魔法は攻撃が多く回復や支援は苦手としている。他人にあまり興味がなく、ときには自分のことさえ無頓着。他人と話すことに慣れておず、ぽそぽそとした喋りで心をえぐるような毒舌が得意。円環を集めることにしか興味がないので、敗残兵には機械的に処刑を実行しようとする。"},{"spoiler":false,"text":"ダモンが所有していた円環と船を奪うと共に、便利な小間使いとして逃げられないよう呪いをかけ、戦闘の後処理を任せる等我が物顔で使役していく。"}],"source":"egs","sourceCharacterId":"8123","sourceWorkId":"22865","spoiler":false},{"segments":[{"spoiler":false,"text":"所属：ダモン海賊団"},{"spoiler":false,"text":"保有船名：シレナ・ファーシル　　保有円環：コメーテースの環"},{"spoiler":false,"text":"エリヌヌ魔術匠合に育てられ、円環を集める使命を受け派遣された天才魔術師。"},{"spoiler":false,"text":"魔術師としての格は神格位級で、攻撃魔法を得意としているが、回復や支援は苦手。"},{"spoiler":false,"text":"他人にあまり興味がなく、時には自分のことさえ無頓着。"},{"spoiler":false,"text":"他人と話すことに慣れておらず、ポソポソとしたしゃべりで心を抉るような毒舌が特徴。"},{"spoiler":false,"text":"円環を集めることにしか興味がないので、敗残兵は機械的に処刑しようとする。"},{"spoiler":false,"text":"元船長だったダモンが所有していた円環と船を奪うと共に呪いをかけ、"},{"spoiler":false,"text":"便利な小間使いとして戦闘の後処理を任せるなど、我が物顔で使役していく。"},{"spoiler":false,"text":"「ギルドからの命令は絶対。 円環を集めて届ける…… それにしか興味ない」"}],"source":"bangumi","sourceCharacterId":"37478"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1bd7c021259c05bb5d4e174ef95e2ef3cd67e20fd1c6d3be8e104de0e36ccf93.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44c22ba5d28b3a0748d71ab7f5cef030471b8f9f3f3842b8afe8b9762c5dce16.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155708:37478:8580:1","source":"bangumi"}]},{"characterId":"char_c45423","characterName":"ダモン・ホセチョ","sourceIds":{"bangumi":[{"characterId":"37485","match":"exact-normalized-name-in-linked-work","subjectId":"155708"}],"egsCharacterIds":["8130"],"vndbCharacterId":"c45423"},"originalCharacterName":"ダモン・ホセチョ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The chief of a minor pirate gang operating in the Laroush region, his joy at discovering one of the rings is short-lived when Sonja appears and hijacks his ship and crew. He is transformed into a pink organism by Sonja to serve as her guide to the locality and to prevent his escape; his only hope of regaining his human form is for Sonja to assemble all of the rings whence she will release him from his enchantment."},{"spoiler":false,"text":"Damon is a womaniser and is faithful to his desire for female companionship; this remains unchanged despite his enchantment. When the red moon is full, Sonja temporarily releases the enchantment changing his appearance which temporarily restores him to human form until daylight."}],"source":"vndb","sourceCharacterId":"c45423"},{"segments":[{"spoiler":false,"text":"ルノーシュ地域で活動するダモン海賊団のお頭役。"},{"spoiler":false,"text":"運良く珊海王の円環を手に入れその力を使い猛威をふるっていたところ、ソーニャに目をつけられ海賊団ごと円環を奪われる。"},{"spoiler":false,"text":"その際に小間使いとして逃げられないよう呪いをかけられ、ピンク色の謎の生物として堪え忍ぶ生活を強いられることとなった。"},{"spoiler":false,"text":"非常に軽い性格をしており、性に対しては隠すことすらしないほど興味津々。ある条件下で呪いの効果が弱まるとき、その真価を発揮することとなる。"},{"spoiler":false,"text":"不遇な状況にも負けず、この地域の出身ではないソーニャの案内役として側で支えていく。"}],"source":"egs","sourceCharacterId":"8130","sourceWorkId":"22865","spoiler":false},{"segments":[{"spoiler":false,"text":"所属：ダモン海賊団"},{"spoiler":false,"text":"ルノーシュ地域で活動するダモン海賊団のお頭役。"},{"spoiler":false,"text":"運良く “珊海王の円環” を手に入れたが、ソーニャに海賊団ごと奪われてしまう。"},{"spoiler":false,"text":"またその際に呪いをかけられ、ピンク色の謎の生物として堪え忍ぶ生活を強いられる。"},{"spoiler":false,"text":"だが不遇な状況にも負けず、土地勘のないソーニャの案内役として支えていくことに。"},{"spoiler":false,"text":"非常に軽い性格をしており、性に対しては隠そうとすらせず興味津々。"},{"spoiler":false,"text":"ある条件下で呪いの効果が弱まる時、その真価を発揮することになる。"},{"spoiler":false,"text":"「この日を待って待って待ちまくったぞ。 さぁ～て、捕まえた女の子といっぱい楽しんじゃおーっと」"}],"source":"bangumi","sourceCharacterId":"37485"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bbb54707708d9e694ccb2616b9ee11102614e6006083a846af64e83444467c0c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e45b59c4d639e668a04aba4aa08cb8e69013d3b413917816997950e4d1429d77.webp","width":256,"height":244,"source":"static-detail"},"actors":[{"creditedName":"小西克幸","creatorId":"vndb:s65","sourcePersonId":"vndb:s65","canonicalEntityId":"vndb:s65","name":"小西 克幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155708:37485:3861:1","source":"bangumi"}]},{"characterId":"char_c45424","characterName":"アニエス","sourceIds":{"bangumi":[{"characterId":"37479","match":"exact-normalized-name-in-linked-work","subjectId":"155708"}],"egsCharacterIds":["8124"],"vndbCharacterId":"c45424"},"originalCharacterName":"アニエス","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An 8th-rank Apsael angel long tasked with the governance of the Lunoush archipelago, she is afflicted by a curse which brings misfortune to herself and to all around her. Agnes believes the source of her curse is a direct result of a previous appearance of the Coral Sea King and the struggle accompanying the quest to assemble the rings. She joins the ring hunt in hopes of dispelling her curse and to ensure no one else is made to suffer the same fate she did."},{"spoiler":false,"text":"Agnes runs an orphanage she established shortly after she was afflicted with her curse. Due to the effects of the curse, she is financially constrained by the demands of the orphanage's upkeep and the occasional redemption of slave children from cooperating merchants."}],"source":"vndb","sourceCharacterId":"c45424"},{"segments":[{"spoiler":false,"text":"遥か以前からルノーシュ地域を管理している階級第八位のアプサエル型天使。自身だけではなく周囲に被害が及ぶ呪いに苛まれている。"},{"spoiler":false,"text":"実直かつ真面目であり、他者の幸福を何よりも重んじる性格をしているが、その一方で思い込みが激しく、相手の言葉を聞かずにお節介を焼いては後でそのことを思い返して反省することが多い。"},{"spoiler":false,"text":"とある孤児院を運営していて、普段は様々な種族の子供の世話に勤しんでいるが、不幸な体質で起こる被害金や子供たちの食料確保で常にお金の工面に苦労している面もある。"},{"spoiler":false,"text":"不幸体質は過去に行われた円環の奪い合いの影響だと考えており、自身にかけられた呪いを解くため、そして自分のような者を今後出さないため騒動を収めようと行動していく。"}],"source":"egs","sourceCharacterId":"8124","sourceWorkId":"22865","spoiler":false},{"segments":[{"spoiler":false,"text":"所属：碧を奏でる調停者"},{"spoiler":false,"text":"保有船名：エスペランサ　　保有円環：テンプルムの環"},{"spoiler":false,"text":"遥か以前からルノーシュ地域を管理している、階級第八位のアプサエル型天使。"},{"spoiler":false,"text":"実直かつまじめであり、他者の幸福を何よりも重んじる性格をしているが、"},{"spoiler":false,"text":"思い込みが激しく、相手の言葉を聞かずにお節介を焼いては反省することが多い。"},{"spoiler":false,"text":"自身だけでなく周囲にも被害が及ぶ呪いに苛まれている。"},{"spoiler":false,"text":"とある孤児院を運営していて、普段は様々な種族の子供の世話に勤しんでいるが、"},{"spoiler":false,"text":"不幸体質のせいで被害金や子供たちの食料確保に手いっぱい、常に金銭面で苦労している。"},{"spoiler":false,"text":"この不幸体質は過去に行われた円環の奪い合いの影響だと考えており、"},{"spoiler":false,"text":"自身の呪いを解くため、そして自分のような者を出さないため騒動を収めようとする。"},{"spoiler":false,"text":"「呪いを解くため、そして子供たちが健やかに過ごせるように、今から正義を為しに行きます！」"}],"source":"bangumi","sourceCharacterId":"37479"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/128ab62e2587d4c1ca05a006ee88e957e19adb75b3f8c25723eeb65dc78d2d13.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d1749ba37d0a401021ae410b88cc54b87ee3451082173ed4d019c46e6c76774.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"尾崎未來","creatorId":"vndb:s986","sourcePersonId":"vndb:s986","canonicalEntityId":"vndb:s986","name":"尾崎 未來","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155708:37479:13776:1","source":"bangumi"}]},{"characterId":"char_c45425","characterName":"ラファエラ","sourceIds":{"bangumi":[{"characterId":"37480","match":"exact-normalized-name-in-linked-work","subjectId":"155708"}],"egsCharacterIds":["8125"],"vndbCharacterId":"c45425"},"originalCharacterName":"ラファエラ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The offspring of a demon and succubus, Rafaela is the leader of the largest and most notorious pirate gang in the vicinity. A hedonist who indulges her whims and desires to the extreme, she is sceptical of the legend of the Coral Sea King and does not have a wish she wants fulfilled. Instead she derives pleasure from seeking out and crushing the other factions carrying the rings which she covets for their beauty."}],"source":"vndb","sourceCharacterId":"c45425"},{"segments":[{"spoiler":false,"text":"魔族と睡魔の間に生まれた魔人であり、悪辣な人間や凶暴な魔物が多く乗り込んでいる巨大な海賊船を率いる女船長。元から様々な魔法が使用可能であり、円環の魔力でさらに強力な魔法が行使できるようになった。"},{"spoiler":false,"text":"自身が楽しむためだけに行動する快楽主義者であり、粗野な部下の態度にも面白ければそれでいいという感性を持っているが、人並み以上に美意識が高く、気に入らない言動には容赦のない処罰を実行する二面性を持つ。"},{"spoiler":false,"text":"日々刺激を求めて海賊業に勤しんでいたときに、幽霊船が現われたことを知る。珊海王に叶えてもらいたい願いという目的で動くのではなく、蒐集の際に巻き起こる騒動を楽しむために円環を求めて動いていく。"}],"source":"egs","sourceCharacterId":"8125","sourceWorkId":"22865","spoiler":false},{"segments":[{"spoiler":false,"text":"所属：紅き火輪の暁闇一味"},{"spoiler":false,"text":"保有船名：グラーシア・インスティ　　保有円環：ムンドゥムの環"},{"spoiler":false,"text":"魔族と睡魔の間に生まれた魔人。"},{"spoiler":false,"text":"悪辣な人間や凶暴な魔物が多く乗り込んでいる巨大な海賊船を率いる女船長。"},{"spoiler":false,"text":"元より様々な魔法が使え、円環の力でさらに強力な魔法も行使できるようになった。"},{"spoiler":false,"text":"自身が楽しむためだけに行動する快楽主義者であり、"},{"spoiler":false,"text":"部下の粗野な態度も面白ければそれでいいと許容するが、美意識が非常に高く、"},{"spoiler":false,"text":"気に入らない言動があれば容赦なく処罰を実行する二面性を持つ。"},{"spoiler":false,"text":"日々刺激を求めて海賊業に勤しんでいた時に、幽霊船が現われたことを知る。"},{"spoiler":false,"text":"叶えてもらいたい願いはなく、円環蒐集の際に巻き起こる騒動を楽しむために行動する。"},{"spoiler":false,"text":"「退屈だねぇ、日々に刺激が足りなさすぎる。 あたしを満足させられる奴はどこかにいないのかい？」"}],"source":"bangumi","sourceCharacterId":"37480"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a075e09869a1f777e83cd34812ca467f79382c45b4bffee0df705a60ad8ad21.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab9f070b9c96cea3f6fca1279dd632463b50d19b624431c2710ff502a00d6014.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天乙准花","creatorId":"vndb:s339","sourcePersonId":"vndb:s339","canonicalEntityId":"vndb:s339","name":"椎那 天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155708:37480:7890:1","source":"bangumi"}]},{"characterId":"char_c45426","characterName":"アルヴィド・グロス","sourceIds":{"bangumi":[{"characterId":"37483","match":"exact-normalized-name-in-linked-work","subjectId":"155708"}],"egsCharacterIds":["8126"],"vndbCharacterId":"c45426"},"originalCharacterName":"アルヴィド・グロス","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Feared as the monster who prowls the region transforming and enslaving all who oppose him into pliant vampire thralls, Arvid has waited centuries for the reappearance of the Coral Sea King. He has a contract with the sentient enchanted scythe he wields which bestowed the gift of undeath allowing him to survive beyond the years of his initial mortal frame."},{"spoiler":false,"text":"Arvid gathers the rings in hopes of restoring the skeletal spirit which constantly hovers around him in complete silence."}],"source":"vndb","sourceCharacterId":"c45426"},{"segments":[{"spoiler":false,"text":"愛用の武器でもあり相棒でもある魔鎌「ヴィート」と契約し、長き刻を生きているヴァンパイア。円環からもたらされる魔力の影響を受け、闇の眷属が用いる強力な暗黒魔法の使い手となった。"},{"spoiler":false,"text":"無口かつ目的以外のことには興味を示さない性格で、他者に対しては冷徹で残忍な行動をとり、降した相手をヴァンパイア化させて、死を恐れない軍勢として強制的に操っていく。"},{"spoiler":false,"text":"かつて珊海王が現われた時期に共に暮らしていた女性と死に別れており、その際なにか起こったのかという真相を探るため円環を求めて彷徨い始める。"}],"source":"egs","sourceCharacterId":"8126","sourceWorkId":"22865","spoiler":false},{"segments":[{"spoiler":false,"text":"所属：闇夜を纏いし帳"},{"spoiler":false,"text":"保有船名：ルペート・クレシェンテ　　保有円環：ゲミヌスの環"},{"spoiler":false,"text":"愛用の武器であり相棒の魔鎌・ヴィートと契約し、長き刻を生きているヴァンパイア。"},{"spoiler":false,"text":"円環の魔力を受け、闇の眷属が用いる強力な暗黒魔法の使い手となった。"},{"spoiler":false,"text":"無口で目的以外のことに興味を示さず、他者に対しては冷徹で残忍な行動をとる。"},{"spoiler":false,"text":"降した相手は吸血鬼化させて、死を恐れない軍勢として強制的に操っていく。"},{"spoiler":false,"text":"かつて珊海王が現われた時期に共に暮らしていた女性と死に別れており、"},{"spoiler":false,"text":"その際に何が起こっていたのか真相を探るため、円環を求めて彷徨い始める。"},{"spoiler":false,"text":"「運命を呪うがいい、貴様の命は既に私のものとなった」"}],"source":"bangumi","sourceCharacterId":"37483"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4bcfd1d8febea83d28371f2697ece902c9ba03b49239510371a68b5b7b34527.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5e52d2faf0d0587f75ca7cd6304c82adfb51e4bb2110dfff77227f957f51982.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤拓也","creatorId":"vndb:s683","sourcePersonId":"vndb:s683","canonicalEntityId":"vndb:s683","name":"佐藤 拓也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155708:37483:5151:1","source":"bangumi"}]},{"characterId":"char_c45428","characterName":"ボルハ・ロヘル","sourceIds":{"bangumi":[{"characterId":"37482","match":"exact-normalized-name-in-linked-work","subjectId":"155708"}],"egsCharacterIds":["8127"],"vndbCharacterId":"c45428"},"originalCharacterName":"ボルハ・ロヘル","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The lord of the Laroush region and a merchant in his own right, Borja Roger has fought a long and losing battle against the various pirate gangs who plague his demesne."},{"spoiler":false,"text":"Borja's ancestor once succeeded in assembling the rings years before and was granted sufficient wealth by the king to buy him and his descendants power and privilege. Borja hopes to emulate his great ancestor and restore the failing fortunes of his household with the help of the assembled rings."}],"source":"vndb","sourceCharacterId":"c45428"},{"segments":[{"spoiler":false,"text":"エリヌヌ都市国家連合の一領地を統治する領主であり、海商業を営む大商人。領地を荒らす海賊に辟易しており、その影響も相まって地位や権力は年々低下している。"},{"spoiler":false,"text":"代々領主となる家系に生まれ、なにかを望めばすぐにそれが叶う環境で育ったため、欲望に素直であり我慢を知らない傲慢さが目立つ。話術や人に取り入ることが上手く、賄賂や女をあてがう等、さらには財力を用いた暴力で物事を推し進めていくことが多い。"},{"spoiler":false,"text":"自身の戦闘力は皆無だが、膨大な財力で傭兵を雇いながら円環がもたらす魔法を使い戦闘に望む。領地の治安強化と下降気味な地位の向上のため円環集めを配下に命じる。"}],"source":"egs","sourceCharacterId":"8127","sourceWorkId":"22865","spoiler":false},{"segments":[{"spoiler":false,"text":"所属：ロヘル海軍"},{"spoiler":false,"text":"保有船名：イデル・グローリア　　保有円環名：レクスの環"},{"spoiler":false,"text":"エリヌヌ都市国家連合の一領地を統治する領主であり、海商業を営む大商人。"},{"spoiler":false,"text":"領地を荒らす海賊に辟易しており、またその影響で地位や権力が年々低下している。"},{"spoiler":false,"text":"代々領主となる家系に生まれ、何かを望めばすぐにそれが叶う環境で育ったため、"},{"spoiler":false,"text":"欲望に素直であり、我慢を知らない傲慢さが目立つ。"},{"spoiler":false,"text":"話術や人に取り入ることが上手く、賄賂や女をあてがうなど、金の暴力で物事を推し進めることが多い。"},{"spoiler":false,"text":"領地の治安強化と下降気味な地位の向上のため、円環集めを配下に命じる。"},{"spoiler":false,"text":"自身の戦闘力は皆無だが、膨大な財力で傭兵を雇い、円環の魔法を使って戦闘に臨む。"},{"spoiler":false,"text":"「先祖が立てた栄光を、儂の代で取り戻すのだ！　さあ、金の力を海賊どもに教えに行くぞ！」"}],"source":"bangumi","sourceCharacterId":"37482"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/210e033ba2ddafb8661fdf1faf231ac7ecf2b496b68930fc49af385070871766.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/5455523e137ab6d4d9dc6899d5fa6b80ca46c1c5004ad6a42b9e8f22586070c3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北山恭祐","creatorId":"vndb:s5570","sourcePersonId":"vndb:s5570","canonicalEntityId":"vndb:s5570","name":"北山 恭祐","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155708:37482:20510:1","source":"bangumi"}]},{"characterId":"char_c45431","characterName":"レラージェ","sourceIds":{"bangumi":[],"egsCharacterIds":["8131"],"vndbCharacterId":"c45431"},"originalCharacterName":"レラージェ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the 72 pillars of Solomon nicknamed \"Chaotic Hunter\", his many arms wield crossbows and other weapons which unleash blows which fester on his unfortunate victims."},{"spoiler":false,"text":"Despite his appearance, he is respectful to those who resist his aura face-to-face and is not fond of indiscriminate and meaningless killing."}],"source":"vndb","sourceCharacterId":"c45431"},{"segments":[{"spoiler":false,"text":"『乱塵の狩人』とも呼ばれる、ソロモン七十二柱が一柱とされる魔神。"},{"spoiler":false,"text":"強靱な力を有する複数の腕と、自身が最も得意としている弩を始め、幾つもの武器を以って戦いと論争を引き起こす。大型の弩から放たれる矢は、対象に壊疽傷を与え必ず死に至らしめると文献に記されている。"},{"spoiler":false,"text":"物事を静かに観察し、冷静沈着かつ落ち着いた物腰で言葉を発するが、ひとたび戦いに発展すると形相を変え、相手が絶命するまで矛を収めることはない。その姿はさながら殺人鬼のようだと対峙したものは口を揃えて言う。"}],"source":"egs","sourceCharacterId":"8131","sourceWorkId":"22865","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a5d20f54af85832b53b4ba9d17f3c11f2e8f7fd5a2de5fa1621215226eb69b0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a21e79f4ab2d5bd1135ee126b64c642943f0de9bc4ac37c9f33f5a28555480f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風見 トーリ","creatorId":"vndb:s9559","sourcePersonId":"vndb:s9559","canonicalEntityId":"vndb:s9559","name":"風見トーリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67467","source":"vndb"}]},{"characterId":"char_vndb_c4542","characterName":"アナスタシア","sourceIds":{"vndbCharacterId":"c4542"},"originalCharacterName":"アナスタシア","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A hidden character only available in the second playthrough. She calls herself an angel maid though she looks more like a demon. She has the ability to change into a bat-like creature."},{"spoiler":false,"text":"She's one of the Eushully sisters"}],"source":"vndb","sourceCharacterId":"c4542"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/3515c35b403a5a1afcf1369fd351e55ea624fa8481d150b2138fad2fc8bd1e19.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb0a8638c3cbc731bad4a26e543fdd6a4a738baede4b95f6ea47e25e65e03131.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c45427","characterName":"ヴィート","sourceIds":{"vndbCharacterId":"c45427"},"originalCharacterName":"ヴィート","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"A sentient enchanted scythe who communicates via telepathic speech. Vito is capable of contracting with humans, giving them undeath and immortality."},{"spoiler":false,"text":"He was once part of the treasures collected by Gauterio Bonetti when he was still alive, hence he is a reliable source of information for Arvid regarding the true nature of the Coral Sea King and the mechanism behind the wish-granting. Vito derives great pleasure observing Arvid's actions and never hesitates to throw in snarky comments on occasion."}],"source":"vndb","sourceCharacterId":"c45427"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34bbcad707dd39c617e9f65731ee91a59ae856b9c28d96ff2419e80dcf20d3a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/509ca837d401fda56b811b740442963399f4ca9f71dda23b462823ed0eec9320.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c45429","characterName":"ルェアイ","sourceIds":{"vndbCharacterId":"c45429"},"originalCharacterName":"ルェアイ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A merchant plying the seas around the archipelago and trades with pirates and lords alike without prejudice, she is very capable of defending herself against any pirate who wishes to take advantage of her."},{"spoiler":false,"text":"Her connections with the Marsteria navy give her formidable backing even if a pirate were to best her and her crew in combat."}],"source":"vndb","sourceCharacterId":"c45429"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a2dee999aeaaa3241dbe221085b7c4e8e3c301a37acbff4ee1383a5c3a9592f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25b09ff904ab9fdb15845503e45228b88e017fea1db3319ac45250e8d93c9b6c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"陽月 ひおり","creatorId":"vndb:s654","sourcePersonId":"vndb:s654","canonicalEntityId":"vndb:s654","name":"小暮 英麻","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67466","source":"vndb"}]},{"characterId":"char_vndb_c45430","characterName":"イルヤナ・ヒュル","sourceIds":{"vndbCharacterId":"c45430"},"originalCharacterName":"イルヤナ・ヒュル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A dark elf who stalks a specific island in the archipelago, Iruyana indiscriminately attacks any who stray into his territory. When he finds his prey, he falls into a berserk frenzy and derives sadistic pleasure from the dismemberment of his unfortunate victims."}],"source":"vndb","sourceCharacterId":"c45430"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/2971a9d08af140405502b3efd0a6f5ff6cd0cf76535e28062e417e23a03266d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1bb19d67044fc0ce2e7d29db9068040c0987e30263160f56bdf7dca1ed0410f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"古河 徹人","creatorId":"vndb:s299","sourcePersonId":"vndb:s299","canonicalEntityId":"vndb:s299","name":"古河 徹人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67458","source":"vndb"}]},{"characterId":"char_vndb_c45432","characterName":"ヴェパルー","sourceIds":{"vndbCharacterId":"c45432"},"originalCharacterName":"ヴェパルー","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the 72 pillars of Solomon, nicknamed the \"Ocean Lord\" for her command over the seas and storms. Her reputation for fickleness combined with her feared destructive powers mean any sighting of her is treated with trepidation by surrounding dominions."}],"source":"vndb","sourceCharacterId":"c45432"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/738e75e782e647f99814a3dcc3657e54145b329030ec9d0a2334410301b4971c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30cff3e91220a345ca5a836e59c6f31ef3510d45fed7d24df183567bb8a7babe.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽鳥 空","creatorId":"vndb:s1486","sourcePersonId":"vndb:s1486","canonicalEntityId":"vndb:s1486","name":"中村 知子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67464","source":"vndb"}]},{"characterId":"char_vndb_c49417","characterName":"エウクレイアさん","sourceIds":{"vndbCharacterId":"c49417"},"originalCharacterName":"エウクレイアさん","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mascot character."}],"source":"vndb","sourceCharacterId":"c49417"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/816062828e3d11e9b74eea62fb492a56648fc54cd326a5b6e63de3f90dc128af.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86eb2e2e8d5a4886a97ed2168bdf6873067afed1463b5e5bf60597f719ec4cb9.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p268","sourceCompanyId":"egs:brand:55","canonicalEntityId":"vndb:p268","name":"エウシュリー","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:24023:55","source":"egs"},{"companyId":"vndb:p19058","sourceCompanyId":"vndb:p19058","canonicalEntityId":"vndb:p19058","name":"starik222","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:164943:v18683","source":"vndb"},{"companyId":"vndb:p268","sourceCompanyId":"vndb:p268","canonicalEntityId":"vndb:p268","name":"エウシュリー","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:50513:v18683","source":"vndb"},{"companyId":"vndb:p268","sourceCompanyId":"vndb:p268","canonicalEntityId":"vndb:p268","name":"エウシュリー","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:50514:v18683","source":"vndb"},{"companyId":"vndb:p268","sourceCompanyId":"vndb:p268","canonicalEntityId":"vndb:p268","name":"エウシュリー","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:55693:v18683","source":"vndb"},{"companyId":"vndb:p520","sourceCompanyId":"vndb:p520","canonicalEntityId":"vndb:p520","name":"エンターブレイン","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:55694:v18683","source":"vndb"},{"companyId":"vndb:p268","sourceCompanyId":"vndb:p268","canonicalEntityId":"vndb:p268","name":"エウシュリー","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:63621:v18683","source":"vndb"},{"compan