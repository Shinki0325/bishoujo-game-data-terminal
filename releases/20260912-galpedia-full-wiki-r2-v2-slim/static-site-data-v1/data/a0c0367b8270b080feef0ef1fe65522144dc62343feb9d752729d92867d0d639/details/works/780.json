 ?"},{"spoiler":false,"text":"She possesses skills so exceptional that she's been called a legendary hunter, and her true identity is that of the guild master who leads the hunters. She may give off a cold impression at first glace, but she is a very kind woman on the inside."},{"spoiler":false,"text":"She goes to the protagonist seeking his cooperation for a certain purpose."},{"spoiler":false,"text":"From Studio e.go!"}],"source":"vndb","sourceCharacterId":"c17402"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/335f91e38e830727385f3eb63f32137be0366b42456c85da11ae01bd60492084.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e59318273fbcd34a7cda93f2fa7eb29f489c727bafbccd6b267eb040e6a5636d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c17403","characterName":"ミスティ・シトロン","sourceIds":{"vndbCharacterId":"c17403"},"originalCharacterName":"ミスティ・シトロン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"source-only","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Occupation: Maid"},{"spoiler":false,"text":"Hobbies: Making delicious coffee"},{"spoiler":false,"text":"Works as a maid in a mansion on the outskirts of town. Was originally an orphan till her current Master took her in and now she leads a very busy and fulfilling life."},{"spoiler":false,"text":"To cure her Master's incurable illness, she ventures out into the night