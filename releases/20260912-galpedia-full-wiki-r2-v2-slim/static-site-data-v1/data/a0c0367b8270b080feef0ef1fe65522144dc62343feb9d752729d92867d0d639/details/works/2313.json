ized-name-in-linked-work","subjectId":"218643"}],"egsCharacterIds":["27668"],"vndbCharacterId":"c4330"},"originalCharacterName":"小笠原 ももこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"21"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の営む医院の新米看護婦にしてメインヒロイン。"},{"spoiler":false,"text":"前作で主人公の恋人になった。"},{"spoiler":false,"text":"そそっかしく、ドジでノロマでおっとこちょいだけど、明るく健気で献身的な女の子。"},{"spoiler":false,"text":"お調子者で節操のない主人公に悩まされながらも、ポジティブシンキングで頑張っているぞ。"},{"spoiler":false,"text":"恋人の主人公とは同棲しており、当然、仕事場も一緒。"},{"spoiler":false,"text":"そのため、エッチに持ち込める回数も……♪"}],"source":"egs","sourceCharacterId":"27668","sourceWorkId":"2313","spoiler":false},{"segments":[{"spoiler":false,"text":"本編のメインヒロイン。新米看護婦。"},{"spoiler":false,"text":"ちょっとドジでノロマでおっちょこちょいなところはあるものの、献身的でよく気のつく女の子。"},{"spoiler":false,"text":"前作で恭司と恋人同士になり、現在は同棲中。"},{"spoiler":false,"text":"彼のおバカさ加減と節操のなさに悩まされる毎日ですが、持ち前のガッツと明るさで何とか乗り切っています。"},{"spoiler":false,"text":"ゲーム開始当初から主人公と同棲しており、しかも職場も一緒とあって、プライベートと仕事を問わずいっしょにいる時間が多くなります。"},{"spoiler":false,"text":"したがって、Hに持ち込める回数も多くなっています。"},{"spoiler":false,"text":"基本的にはメインヒロインなので、他の女の子に目移りせずに進めていけば、無事にエンディングを迎えられるでしょう（ただし、結婚できるかどうかはまた別問題ですが）。"}],"source":"bangumi","sourceCharacterId":"145637"}],"profileFacts":[{"label":"年龄（本版本）","value":"21 岁","valueContext":null,"source":"egs","sourceCharacterId":"27668","sourceWorkId":"2313","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":