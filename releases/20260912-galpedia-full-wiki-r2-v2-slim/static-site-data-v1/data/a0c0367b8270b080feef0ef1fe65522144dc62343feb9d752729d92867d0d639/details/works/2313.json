ource":"vndb","value":"81"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染。"},{"spoiler":false,"text":"ほんわかした雰囲気の、おっとりマイペースな女の子。"},{"spoiler":false,"text":"趣味は絵を描くことで、美大の助手を務めていた。"},{"spoiler":false,"text":"主人公に告白したことがあるが、そのとき既に“ももこ”と交際していたために、あえなく玉砕。"},{"spoiler":false,"text":"傷心のまま絵画の修行のため海外留学していたが、このほど帰国し、主人公との久々の再会で、恋の炎が再燃してしまうのだが……。"}],"source":"egs","sourceCharacterId":"27671","sourceWorkId":"2313","spoiler":false},{"segments":[{"spoiler":false,"text":"ヒロインのひとり。恭司の幼なじみ。いつもマイペースなのんびりした娘。"},{"spoiler":false,"text":"絵を描くのが何より好きで、美大助手を務めていました。"},{"spoiler":false,"text":"かつて恭司に告白しましたが、彼はすでにももこと付き合っていたため、フラレてしまいました。"},{"spoiler":false,"text":"傷心をかかえて絵画修行のため海外へと留学していましたが、『R外伝』開始時に帰国します。"},{"spoiler":false,"text":"かつて断ち切ったはずの彼への想いが、再会したことでまた蘇ってくることに。"},{"spoiler":false,"text":"幼なじみということで、ごく自然に買い物に付き合ったり、相談を受けたり……といったイベントが起こります。"},{"spoiler":false,"text":"何より絵が好きで、生きがいにしている彼女。そのことを尊重してあげる必要があるでしょう。"},{"spoiler":false,"text":"そして、想いを抑えきれなくなったさよりの、二度目の告白。"},{"spoiler":false,"text":"それを受け容れて彼女と付き合うのか、それともももことの愛を貫くのか？という厳しい選択を迫られます（これは他のヒロインも同じですが）。"}],"source":"bangumi","sourceCharacterId":"145640"}],"profileFacts":[{"label":"年龄（本版本）","value":"24 岁","valueContext":null,"source":"egs","sourceCharacterId":"27671","sourceWorkId":"2313","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"27671","sourceWorkId":"2313","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"27671","sourceWorkId":"2313","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"sourc