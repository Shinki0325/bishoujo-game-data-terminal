db","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同じ内科医。"},{"spoiler":false,"text":"内科のチーフを務めていたほど、医者としての腕は非常に高く、確かなもの。"},{"spoiler":false,"text":"しかし、私生活では妻子ある患者と不倫してしまうなど、男関係は薄幸そうだ。"},{"spoiler":false,"text":"今回も、色々と悩んでいる様子で、またも不倫しているのではないかとの噂も……。"}],"source":"egs","sourceCharacterId":"27670","sourceWorkId":"2313","spoiler":false},{"segments":[{"spoiler":false,"text":"ヒロインのひとり。恭司と同じ内科医です。"},{"spoiler":false,"text":"以前いた病院では内科チーフを勤めるなど、医者として高い手腕を持っています。"},{"spoiler":false,"text":"しかし私生活では、妻子ある患者と不倫関係をもつなど、何かと苦労の絶えない人生です。"},{"spoiler":false,"text":"最近何やらお疲れの模様……そしてちらつく男の影。"},{"spoiler":false,"text":"「もしや、また不倫をしているのでは？」という疑惑を抱きつつ、同業者として相談を受けたり、資料を貸したり、といったコミュニケーションを取っていくことになります。"},{"spoiler":false,"text":"苦悩する彼女を支えてあげようとしているうちに、やがては愛情を感じ始める恭司。"},{"spoiler":false,"text":"そして、ももことの二者択一を迫られることに……"}],"source":"bangumi","sourceCharacterId":"145639"}],"profileFacts":[{"label":"年龄（本版本）","value":"28 岁","valueContext":null,"source":"egs","sourceCharacterId":"27670","sourceWorkId":"2313","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"27670","sourceWorkId":"2313","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"27670","sourceWorkId":"2313","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"27670","sourceWorkId":"2313","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"27670","sourceWorkId":"2313","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"53 kg","valueContext":null,"source":"egs","sourceCharacterId":"27670","sourceWorkId":"2313","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/638ef4d860210fb2789bccfc6a09f6ac34f66fdafa6e9dcdf1839132a6f1202f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca2d5a44d1744a10361d5a39724ac265c68091188c0d04b0b6afc2d4f028aa31.webp","width":231,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茉雪千鶴","creatorId":"vndb:s801","sourcePersonId":"vndb:s801","canonicalEntityId":"vndb:s801","name":"茉雪 千鶴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218643:145639:6304:1","source":"bangumi"}]},{"characterId":"char_c4333","characterName":"山口 美依子","sourceIds":{"bangumi":[{"characterId":"145638","match":"exact-normalized-name-in-linked-work","subjectId":"218643"}],"egsCharacterIds":["27669"],"vndbCharacterId":"c4333"},"originalCharacterName":"山口 美依子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"24"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"昼はキャリアウーマン、夜はホステスというふたつの顔を持つ女性。"},{"spoiler":false,"text":"性格は、明るく元気で、それでいて積極的。"},{"spoiler":false,"text":"主人公は、前作で彼女と知り合い、その彼女の強引さに負けて浮気したことから、ももことの関係が危うくなりそうになった苦い経験を持つ。"},{"spoiler":false,"text":"それ以来、主人公と彼女は気まずい関係になっていたが、とあることがきっかけで仲直りをするのだが……。"}],"source":"egs","sourceCharacterId":"27669","sourceWorkId":"2313","spoiler":false},{"segments":[{"spoiler":false,"text":"ヒロインのひとり。昼はＯＬ、夜はホステスと二つの顔をもつ美女。"},{"spoiler":false,"text":"明朗快活、とても積極的な女性です。"},{"spoiler":false,"text":"前作ではその軽いノリにつられた恭司がついつい浮気してしまい、ももこにバレてひどい目にあうという一件がありました。"},{"spoiler":false,"text":"以来、美依子と恭司は当然気まずいままでしたが……"},{"spoiler":false,"text":"ふとしたことから仲直りした恭司と美依子。"},{"spoiler":false,"text":"そんなおり、美依子が夜のバイトで何かとトラブルに巻き込まれていることを知った恭司は、彼女のために一肌脱ぐことにします。"},{"spoiler":false,"text":"最初はほんの親切心だったのですが、やがてそれは激しい感情へと変わってゆき、ふたりはふたたび関係をもってしまいます。"},{"spoiler":false,"text":"彼女とももこ、どちらを選べばいいのか……そんな決断が待っています。"}],"source":"bangumi","sourceCharacterId":"145638"}],"profileFacts":[{"label":"年龄（本版本）","value":"24 岁","valueContext":null,"source":"egs","sourceCharacterId":"27669","sourceWorkId":"2313","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"27669","sourceWorkId":"2313","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"27669","sourceWorkId":"2313","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"27669","sourceWorkId":"2313","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"27669","sourceWorkId":"2313","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"46 kg","valueContext":null,"source":"egs","sourceCharacterId":"27669","sourceWorkId":"2313","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d6a1900b61ca40c97e50946000c5cd9556d388e8b6b3292d9485cab7019b0e0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfc209663106a58155912cf21dc1eae769ed30b54254774a680b80d1e9ec715c.webp","width":231,"height":256,"source":"static-detail"},"actors":[{"creditedName":"萩原えみこ","creatorId":"vndb:s867","sourcePersonId":"vndb:s867","canonicalEntityId":"vndb:s867","name":"萩原 えみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:characte