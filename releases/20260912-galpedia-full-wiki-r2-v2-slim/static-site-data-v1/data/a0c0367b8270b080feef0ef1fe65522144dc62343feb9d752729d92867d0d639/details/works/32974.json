"match":"exact-normalized-name-in-linked-work","subjectId":"392451"}],"egsCharacterIds":["24218"],"vndbCharacterId":"c112362"},"originalCharacterName":"宍戸 愛香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"やや高い方"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"S-Class Bombshell"},{"spoiler":false,"text":"Occupation: Erotica Novelist"},{"spoiler":false,"text":"Height: On the Taller Side"},{"spoiler":false,"text":"Breast Size: Ridiculously Stacked"},{"spoiler":false,"text":"One of the residents at Yunagi-so, Manaka, is what the manager describes as an \"S-Class Erotic Physique\". Manaka was well aware of her slammin' figure but had never found a guy who really revved her engine before. Honestly, her premium assets were going to waste."},{"spoiler":false,"text":"Given her racy profession, Manaka was super eager to get down and dirty. But the right opportunity had never quite come knockin'...until a certain protagonist walked through the door. For the first time, Manaka felt possessed by the urge to flaunt and indulge her \"S-Class Assets\"."},{"spoiler":false,"text":"「Having a figure like this, it's hard not to feel like they're going to waste....」"}],"source":"vndb","sourceCharacterId":"c112362"},{"segments":[{"spoiler":false,"text":"夕凪荘の住人。"},{"spoiler":false,"text":"管理人さんによると「S級のエロい身体」を持つ女性。"},{"spoiler":false,"text":"愛香本人も自分のスタイルについては自覚していたが、これまで気になる男ができたこともないし、正直なところ、少々持てあまし気味だった。"},{"spoiler":false,"text":"職業的な興味もあって、エロいことをしてみたい気持ちは、大いにあったのだが…。"},{"spoiler":false,"text":"そんなとき、主人公と出会って、初めて、自分の「S級の身体」を使ってみたい気持ちになるのだった。"}],"source":"egs","sourceCharacterId":"24218","sourceWorkId":"32974","spoiler":false},{"segments":[{"spoiler":false,"text":"夕凪荘の住人。"},{"spoiler":false,"text":"管理人さんによると「S級のエロい身体」を持つ女性。"},{"spoiler":false,"text":"愛香本人も自分のスタイルについては自覚していたが、"},{"spoiler":false,"text":"これまで気になる男ができたこともないし、正直なところ、少々持てあまし気味だった。"},{"spoiler":false,"text":"職業的な興味もあって、エロいことをしてみたい気持ちは、大いにあったのだが…。"},{"spoiler":false,"text":"そんなとき、主人公と出会って、初めて、自分の「S級の身体」を使ってみたい気持ちになるのだった。"}],"source":"bangumi","sourceCharacterId":"119425"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"119425","value":"官能小説家"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10298d0929c642dfeacb2a803cf23e1a2dcc6e5f6edf3eaceb63533fb767cbc7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0a33c0ce5e0b34c7a542a6caac4290383c0b1df093601f664fbe70c56012a52.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井ノ上奈々","creatorId":"vndb:s1808","sourcePersonId":"vndb:s1808","canonicalEntityId":"vndb:s1808","name":"井ノ上奈々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:392451:119425:4745:1","source":"bangumi"}]},{"characterId":"char_c112363","characterName":"平良 水咲","sourceIds":{"bangumi":[{"characterId":"119426","match":"exact-normalized-name-in-linked-work","subjectId":"392451"}],"egsCharacterIds":["24219"],"vndbCharacterId":"c112363"},"originalCharacterName":"平良 水咲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"平均くらい"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"S-Class Doting Damsel"},{"spoiler":false,"text":"Occupation: Kindergarten Teacher"},{"spoiler":false,"text":"Height: Average"},{"spoiler":false,"text":"Breast Size: Large"},{"spoiler":false,"text":"According to the inn manager, resident Misaki is deemed the \"S-Class Indulger\" - her own words."},{"spoiler":false,"text":"This warm-natured beauty was practically made to nurture children. While her daily routine was fulfilling, Misaki harbored a secret longing - to pamper not a child but a romantic partner. Upon meeting the protagonist for the first time, she immediately thought, \"I want to dote on this one rotten.\""},{"spoiler":false,"text":"「Don't be shy ♥ It makes me happy when you get all needy and spoiled around me ♥」"}],"source":"vndb","sourceCharacterId":"c112363"},{"segments":[{"spoiler":false,"text":"夕凪荘の住人。"},{"spoiler":false,"text":"管理人さんによると「S級の甘やかし」を持つ女性。"},{"spoiler":false,"text":"人当たりの柔らかい、優しい女性で、こどもの相手をする幼稚園の先生は、まさに天職とも言えた。"},{"spoiler":false,"text":"充実した毎日を送っていたが、心の奥底では、こどもではなく彼氏を甘やかせてあげたい…という気持ちを抱えていた。"},{"spoiler":false,"text":"水咲は主人公と出会って、初めて「この人を甘やかせてあげたい」と心から思うのだった。"}],"source":"egs","sourceCharacterId":"24219","sourceWorkId":"32974","spoiler":false},{"segments":[{"spoiler":false,"text":"夕凪荘の住人。"},{"spoiler":false,"text":"管理人さんによると「S級の甘やかし」を持つ女性。"},{"spoiler":false,"text":"人当たりの柔らかい、優しい女性で、"},{"spoiler":false,"text":"こどもの相手をする幼稚園の先生は、まさに天職とも言えた。"},{"spoiler":false,"text":"充実した毎日を送っていたが、心の奥底では、"},{"spoiler":false,"text":"こどもではなく彼氏を甘やかせてあげたい…という気持ちを抱えていた。"},{"spoiler":false,"text":"水咲は主人公と出会って、初めて「この人を甘やかせてあげたい」と心から思うのだった。"}],"source":"bangumi","sourceCharacterId":"119426"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"119426","value":"幼稚園の先生"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94d8ddc3d97e69130d973d4a578f02da504ba799ad7396324055c8d146f02ba5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07f45420c7fadeb8f8a3a01aa9faf0ac95a0e05e8e992738f06f18160624a38c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"末柄里恵","creatorId":"vndb:s6837","sourcePersonId":"vndb:s6837","canonicalEntityId":"vndb:s6837","name":"実羽ゆうき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:392451:119426:12356:1","source":"bangumi"}]},{"characterId":"char_c112364","characterName":"車谷 暢","sourceIds":{"bangumi":[{"characterId":"119427","match":"exact-normalized-name-in-linked-work","subjectId":"392451"}],"egsCharacterIds":["24220"],"vndbCharacterId":"c112364"},"originalCharacterName":"車谷 暢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"小さい"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"S-class Slacker"},{"spoiler":false,"text":"Occupation: College student/Consultant"},{"spoiler":false,"text":"Height: Short"},{"spoiler":false,"text":"Breast Size: Big"},{"spoiler":false,"text":"A resident at Yuunagi-sou, Non cuts an unlikely figure - the landlady deems her an \"S-Rank Slacker.\" Though only a sophomore, her stratospheric intellect sees her moonlighting as a consultant to the global political and financial elite."},{"spoiler":false,"text":"Yet, for all her razor-sharp insights, Non is hopelessly languid regarding anything requiring focused effort or discipline in her daily life. She couldn't help but wish for someone to manage the mundane essentials on her behalf. Not just anyone would do, of course. That's when she crossed paths with our protagonist."},{"spoiler":false,"text":"「Need someone to look after me, or I'll inevitably crumble」"}],"source":"vndb","sourceCharacterId":"c112364"},{"segments":[{"spoiler":false,"text":"夕凪荘の住人。"},{"spoiler":false,"text":"管理人さんによると「S級のぐうたら」な女の子。"},{"spoiler":false,"text":"普段は都内の大学に通っている2年生だが、その天才的な頭脳でもって、世界の政財界を相手に、コンサルタント業をやっている……らしい。"},{"spoiler":false,"text":"頭脳の良さとは裏腹に、ぐうたら過ぎて生活能力に欠けている。"},{"spoiler":false,"text":"暢としては、そんな自分を誰かに世話して欲しいと考えていた。"},{"spoiler":false,"text":"誰か…といっても、もちろん誰でもいいわけではなくて。"},{"spoiler":false,"text":"そんなとき、主人公と出会うのだった。"}],"source":"egs","sourceCharacterId":"24220","sourceWorkId":"32974","spoiler":false},{"segments":[{"spoiler":false,"text":"夕凪荘の住人。"},{"spoiler":false,"text":"管理人さんによると「S級のぐうたら」な女の子。"},{"spoiler":false,"text":"普段は都内の大学に通っている2年生だが、その天才的な頭脳でもって、"},{"spoiler":false,"text":"世界の政財界を相手に、コンサルタント業をやっている……らしい。"},{"spoiler":false,"text":"頭脳の良さとは裏腹に、ぐうたら過ぎて生活能力に欠けている。"},{"spoiler":false,"text":"暢としては、そんな自分を誰かに世話して欲しいと考えていた。"},{"spoiler":false,"text":"誰か…といっても、もちろん誰でもいいわけではなくて。"},{"spoiler":false,"text":"そんなとき、主人公と出会うのだった。"}],"source":"bangumi","sourceCharacterId":"119427"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"119427","value":"学生/コンサルタント"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44e90f657556748283f6098397ddb3846ebb4a62acd422ab486ebdd42b2088e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1d2829536ddad4ec7fbd2f409a402682bc46e22b9962d34864ca13506864406.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐々木未来","creatorId":"vndb:s3660","sourcePersonId":"vndb:s3660","canonicalEntityId":"vndb:s3660","name":"佐々木 未来","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:392451:119427:7277:1","source":"bangumi"}]},{"characterId":"char_vndb_c112365","characterName":"蜷川 さくら","sourceIds":{"vndbCharacterId":"c112365"},"originalCharacterName":"蜷川 さくら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"S-Rank Landlady"},{"spoiler":false,"text":"Occupation: Dormitory Manager"},{"spoiler":false,"text":"Height: Average"},{"spoiler":false,"text":"Breast Size: Slightly smaller than others but still large"},{"spoiler":false,"text":"The landlady of Yuunagi-sou boasts \"S-Rank Management Skills,\" according to her own claims. Although the building itself is pretty aged, her peerless organizational prowess keeps every nook and cranny, garden included, in impeccable condition."},{"spoiler":false,"text":"Initially content with simply maintaining her inn, the manager could not deny harboring a secret yearning... to apply her managerial talents to a man."},{"spoiler":false,"text":"When the protagonist arrived seeking lodgings, laying eyes on him stoked those clandestine desires as never before."},{"spoiler":false,"text":"「 The truth is, I want to manage...you (a man).」"}],"source":"vndb","sourceCharacterId":"c112365"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/798779b8ab57d246bab2ab0f2f4404874eabcb5c760f57b2cf515cf57777b4db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c872411b5dba29e121167dc3e08a7270774b73edd4314021b6f51d2afd543fa.webp","width":195,"height":256,"source":"static-detail"},"actors":[{"creditedName":"葵 時緒","creatorId":"vndb:s1658","sourcePersonId":"vndb:s1658","canonicalEntityId":"vndb:s1658","name":"葵時緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91925","source":"vndb"}]},{"characterId":"char_vndb_c112508","characterName":"犀川 綸","sourceIds":{"vndbCharacterId":"c112508"},"originalCharacterName":"犀川 綸","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c59d9822088e16970ef8ad7795b2176feed19b4d5c4f69de4a28644d794d162.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e6b605499809a4dfa6d9496df8cb5929743549978dc