"roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:219526","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c158416","characterName":"桃井 ひかり","sourceIds":{"vndbCharacterId":"c158416"},"originalCharacterName":"桃井 ひかり","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"19"},"birthday":{"reviewState":"source-only","source":"vndb","value":"516"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I don't know how far we'll get in this thing, but I'll do my best not to hold you back.\""},{"spoiler":false,"text":"An average university student who moved out of her family home less than a year ago."},{"spoiler":false,"text":"Has an unassuming appearance, but her friends know she's not to be underestimated. Possesses keen social intelligence and acts with conviction."},{"spoiler":false,"text":"A bright and confident person, she is also exceptionally patient and understanding. However, this means that she is inclined to bottle it up inside when something is bothering her, occasionally resulting in outbursts of emotion with serious repercussions..."},{"spoiler":false,"text":"From Primula"}],"source":"vndb","sourceCharacterId":"c158416"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c9ee2eb94250548d8d7812e8cb268c103677782fb23f0a3802d381f15b1c7fdb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f187e1e1c66648e312aa9f9eaf7cdaf1698f76d7ce7516034d53dae9cf442e4e.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c158417","characterName":"夏秋冬 実果","sourceIds":{"vndbCharacterId":"c158417"},"originalCharacterName":"夏秋冬 実果","characterNameSource":null,"role":"primary","sta