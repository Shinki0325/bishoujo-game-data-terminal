{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"25120","model":{"presentationWorkId":"egs:25120","staff":{"artwork":[{"creditedName":"はきか","creatorId":"vndb:s24205","sourcePersonId":"egs:creator:31860","canonicalEntityId":"vndb:s24205","name":"はきか","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:202041","source":"egs"}],"scenario":[{"creditedName":"はきか","creatorId":"vndb:s24205","sourcePersonId":"egs:creator:31860","canonicalEntityId":"vndb:s24205","name":"はきか","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:202042","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_76751","characterName":"ラビィ・アルナー","sourceIds":{"bangumi":[{"characterId":"76751","match":"source-roster","subjectId":"240473"},{"characterId":"76751","match":"source-roster","subjectId":"299412"}]},"originalCharacterName":"ラビィ・アルナー","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ラビィ・アルナーはSEQUEL blightのもう一人の主人公的な存在です。"},{"spoiler":false,"text":"ラビィは人当たりのいい性格であり、主人公に対しても友好的です。"},{"spoiler":false,"text":"惚けたようなことも言いますが、基本的にはしっかりしたキャラクターです。"},{"spoiler":false,"text":"しかし残念ながら少々学が浅いところがあり、"},{"spoiler":false,"text":"特に何かを説明するとき、彼女の言葉では不十分なことが多々あります。"}],"source":"bangumi","sourceCharacterId":"76751"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef812ca22bc001d62aa1bd62b69a31cff22fca53cf491efc67f0b0da427bfda2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23a028caf39051bc79d8b3623f0b881ea3af6d971864f0f1bb6173eb331289ff.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_76752","characterName":"商会の使い走り","sourceIds":{"bangumi":[{"characterId":"76752","match":"source-roster","subjectId":"240473"},{"characterId":"76752","match":"source-roster","subjectId":"464643"}]},"originalCharacterName":"商会の使い走り","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ウーラ・ジェラートはSEQUEL blightにおけるパーティメンバーです。"},{"spoiler":false,"text":"ウーラは幼い見た目に似合わずそれなりに利口なキャラクターです。"},{"spoiler":false,"text":"普段はアウラム商会という組織に所属し働く商人でもあります。"},{"spoiler":false,"text":"ウーラは旅先においてその地の歴史などに興味を示しますが、"},{"spoiler":false,"text":"残念ながらラビィはその手の話についていけません。"},{"spoiler":false,"text":"---"},{"spoiler":false,"text":"アウラム商会の一員として働く下っ端。"},{"spoiler":false,"text":"販路開拓のためベーレテリアを発つこととなる。"},{"spoiler":false,"text":"ウーラ・ジェラートはアウラム商会という組織に所属する雇われ商人です。日々の業務の成果が報われることがあまりない苦労人と言える人物ですが、商会の上層部からは密やかに一定以上の評価を受けており、この度は海外出張を任されることとなりました。"},{"spoiler":false,"text":"ウーラはシリーズ1作目『SEQUEL blight』のメインキャラクターの内の1人ですので、彼女の人柄をより詳しく知りたい方はそちらをプレイしていただければと思います。"},{"spoiler":false,"text":"シーンでの一面"},{"spoiler":false,"text":"ウーラは性的なことを否定している雰囲気を出してはいますが、実際のところは興味の尽きないむっつりです。過去作において主人公と最も早く性交した実績もあるように、今回も普段のストレスから湧き出す欲望を主人公にぶつけてくるに違いありません……"}],"source":"bangumi","sourceCharacterId":"76752"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c15e41c33bdd8d4f9de4d72593a8f8a0236340bbe912192b0ec06fa069dea51.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55b798d8b924bf9608c938768966caaf91a4b8f8a2218486c80963fe45606889.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_76753","characterName":"ニクス","sourceIds":{"bangumi":[{"characterId":"76753","match":"source-roster","subjectId":"240473"}]},"originalCharacterName":"ニクス","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ニクスリューナはSEQUEL blightにおけるパーティメンバーです。"},{"spoiler":false,"text":"彼女は夜魔（サキュバス）であり、つまり人間ではなく魔物ですが、"},{"spoiler":false,"text":"人懐っこい性格ゆえにラビィたちともすぐに打ち解けます。"},{"spoiler":false,"text":"仲間からはニクスと縮めて呼ばれています。"},{"spoiler":false,"text":"ニクスはぼんやりとしているような雰囲気で、"},{"spoiler":false,"text":"一見掴みどころがないような印象を受けます。"},{"spoiler":false,"text":"しかし彼女は彼女なりに物事をいろいろと考えており、"},{"spoiler":false,"text":"例えば、魔物である自分が人間たちにどう思われているかなどを気にしていたりします。"}],"source":"bangumi","sourceCharacterId":"76753"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcac36428ebcb28a5e52d61425ea19f92fa952b199b9ea2b5fe448fee2b2b651.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/7922584e3410966cd53cc4a0dab8381515086fc1452c755b41b08887999e1e71.webp","width":181,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_76754","characterName":"ティレマ・リエマ","sourceIds":{"bangumi":[{"characterId":"76754","match":"source-roster","subjectId":"240473"}]},"originalCharacterName":"ティレマ・リエマ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ティレマ・リエマはSEQUEL blightにおけるパーティメンバーです。"},{"spoiler":false,"text":"ティレマはミルエス軍という組織に所属する戦士であり、"},{"spoiler":false,"text":"自由奔放なラビィとは相反するような立ち位置にいますが、"},{"spoiler":false,"text":"しかし両者は幼馴染であり、仲良しです。"},{"spoiler":false,"text":"ティレマは文武両道で頼りになる存在で、常にそうあろうとしています。"},{"spoiler":false,"text":"しかし、だからこそ彼女が頼れるものは少ないです。"}],"source":"bangumi","sourceCharacterId":"76754"}],"profi