Field":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"12423","sourceWorkId":"13743","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"12423","sourceWorkId":"13743","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3dc1913a125e3b798d495a64bf2b550ae141d4849e280d812ee5318c1c146780.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7a1179b179e1885d8a9e9062ec61e0df8283b7991cc350cb49e75bb2e8b145b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14494:12862:5936:1","source":"bangumi"}]},{"characterId":"char_c6522","characterName":"西園寺","sourceIds":{"bangumi":[{"characterId":"12863","match":"exact-normalized-name-in-linked-work","subjectId":"14494"}],"egsCharacterIds":["12424"],"vndbCharacterId":"c6522"},"originalCharacterName":"西園寺","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"2/20"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"クロに宿る “変若水” を付け狙う妖の一人。"},{"spoiler":false,"text":"もう一人の妖・クニミツと行動を共にしていることが多く、司令塔的な役割を担っている。"},{"spoiler":false,"text":"飄々とした態度と妙に丁寧な言葉遣いで接してくる、どうにも食えなさそうな男。"}],"source":"egs","sourceCharacterId":"12424","sourceWorkId":"13743","spoiler":false},{"segments":[{"spoiler":false,"text":"瞄准九郎身体内寄宿的“变若水”的妖怪。"},{"spoiler":false,"text":"经常和另一个妖怪・クニミツ在一起行动，发挥着司令官的作用。"},{"spoiler":false,"text":"性格虽然轻浮，但言辞用语都很认真，完全和外表不符的男人。"},{"spoiler":false,"text":"【人类这种东西是不会明白自己的底线的。特别是对自己的欲望。】"}],"source":"bangumi","sourceCharacterId":"12863"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34ca2f0f23d17e3afcaf221ff91e39ec91e3e690f0831f5088cba5bce0711f30.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e43987a0238cc518bea8b0a4211b961b5d36d536930d936510e5f568e05800f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一条和矢","creatorId":"vndb:s256","sourcePersonId":"vndb:s256","canonicalEntityId":"vndb:s256","name":"一条 和矢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14494:12863:4612:1","source":"bangumi"}]},{"characterId":"char_c6523","characterName":"クニミツ","sourceIds":{"bangumi":[{"characterId":"12864","match":"exact-normalized-name-in-linked-work","subjectId":"14494"}],"egsCharacterIds":["12425"],"vndbCharacterId":"c6523"},"originalCharacterName":"クニミツ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"2/2"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"浅黒い肌のため、周囲からは 「クロ」 と呼ばれている。"},{"spoiler":false,"text":"行動・言動がぶっきらぼうなので、初対面では近づきがたい印象を与えがちだが、実際は天然なだけで他意はない。"},{"spoiler":false,"text":"眠ることと読書が趣味。身長が姉・静よりも低いのがコンプレックス。"},{"spoiler":false,"text":"生まれながらに “変若水” と呼ばれる霊薬を体内に宿していたため、妖に命を狙われていくことに……。"}],"source":"egs","sourceCharacterId":"12425","sourceWorkId":"13743","spoiler":false},{"segments":[{"spoiler":false,"text":"瞄准九郎身体内寄宿的“变若水”的妖怪。"},{"spoiler":false,"text":"血气方刚，大大咧咧的性格和言行是特征。"},{"spoiler":false,"text":"经常在西园寺的指挥下行动，有时候也会不听从意见而行动。"},{"spoiler":false,"text":"以顽强的性格和尖锐的眼力制压着对手。"},{"spoiler":false,"text":"【对那种丝毫没有迷惑的刀法一见钟情了】"}],"source":