ce":"vndb"},{"creditedName":"Riv","creatorId":"vndb:s4172","sourcePersonId":"vndb:s4172","canonicalEntityId":"vndb:s4172","name":"Riv","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:45333","source":"vndb"},{"creditedName":"船亀 由真人","creatorId":"vndb:s4241","sourcePersonId":"vndb:s4241","canonicalEntityId":"vndb:s4241","name":"船亀 由真人","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:45335","source":"vndb"},{"creditedName":"船亀 由真人","creatorId":"vndb:s4241","sourcePersonId":"vndb:s4241","canonicalEntityId":"vndb:s4241","name":"船亀 由真人","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:45336","source":"vndb"}]},"cast":[{"characterId":"char_c6517","characterName":"三原 静","sourceIds":{"bangumi":[{"characterId":"12859","match":"exact-normalized-name-in-linked-work","subjectId":"14494"}],"egsCharacterIds":["12420"],"vndbCharacterId":"c6517"},"originalCharacterName":"三原 静","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"9/8"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"クロの一歳違いの姉。何故かクロの事は『ヨッくん』と呼ぶ。"},{"spoiler":false,"text":"温和で物腰が柔らかく、包容力も胸も大きい。"},{"spoiler":false,"text":"二人暮しの為かブラコン傾向が強く、クロに悪い虫がつかないかと悩むこともしばしば。"},{"spoiler":false,"text":"その割には姉の特権と称してクロをからかって困らせる事を楽しんでいるが、クロを妖から守る為に誰よりも先陣を切って敵に立ち向かう。"}],"source":"egs","sourceCharacterId":"12420","sourceWorkId":"13743","spoiler":false},{"segments":[{"spoiler":false,"text":"大九郎一岁的姐姐。称呼九郎为「优君」。"},{"spoiler":false,"text":"举止温柔，包容力和胸部都很大。"},{"spoiler":false,"text":"也许是两人一起生活，弟控倾向很强，经常为了防止坏人接近九郎而伤脑筋。"},{"spoiler":false,"text":"使用身为姐姐的特权以捉弄九郎为乐，但为了守护九郎会比谁都勇于面对敌人。"},{"spoiler":false,"text":"【不用担心。我可是优君的姐姐哦？】"}],"source":"bangumi","sourceCharacterId":"12859"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"12420","sourceWorkId":"13743","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"12420","sourceWorkId":"13743","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"12420","sourceWorkId":"13743","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/deafb5519c058548e2cc77e9fc8de85a494f372e352e27a869a9d6761c2f3dde.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d705045436bce2db362b6949c4a7b88365549fe2252a80f789d432195af16762.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14494:12859:4714:1","source":"bangumi"}]},{"characterId":"char_c6519","characterName":"河野 瑠璃","sourceIds":{"bangumi":[{"characterId":"12860","match":"exact-normalized-name-in-linked-work","subjectId":"14494"}],"egsCharacterIds":["12421"],"vndbCharacterId":"c6519"},"originalCharacterName":"河野 瑠璃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"4/19"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"クロと静の幼なじみ。"},{"spoiler":false,"text":"明るく活発で真っ直ぐな性格。"},{"spoiler":false,"text":"クロと同い年ではあるが、生まれた月がクロより早かったので、姉ぶった態度をとっている。"},{"spoiler":false,"text":"学園では学年トップの成績を維持しており、クロの宿題等の面倒をよくみている。"},{"spoiler":false,"text":"幼少の頃から薙刀をたしなんでいて、今では相当の実力者。"},{"spoiler":false,"text":"その力をクロのために遺憾無く発揮する。"}],"source":"egs","sourceCharacterId":"12421","sourceWorkId":"13743","spoiler":false},{"segments":[{"spoiler":false,"text":"九郎和静的青梅竹马。"},{"spoiler":false,"text":"性格开朗活泼。"},{"spoiler":false,"text":"和九郎同岁，但因为出生月比九郎早而摆出一副姐姐的架子。"},{"spoiler":false,"text":"在学园时的成绩是学年第一，经常帮助九郎的作业。"},{"spoiler":false,"text":"从小时候就喜欢舞动薙刀，现在是一个相当的实力者。"},{"spoiler":false,"text":"【因为你乱来才害得我跟着乱来的！】"}],"source":"bangumi","sourceCharacterId":"12860"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"12421","sourceWorkId":"13743","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"12421","sourceWorkId":"13743","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"12421","sourceWorkId":"13743","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1ed834da82f60968b6017bcd527169d7d665637229acb0602cbaaf30cfd4c996.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/380f4672db359a5fc507ce4a6e42766b23508bc14a007c9aeff78f14bf19ab71.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"倉田まりや","creatorId":"vndb:s789","sourcePersonId":"vndb:s789","canonicalEntityId":"vndb:s789","name":"澄田 まりや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14494:12860:6018:1","source":"bangumi"}]},{"characterId":"char_c6520","characterName":"姫","sourceIds":{"bangumi":[{"characterId":"12861","match":"exact-normalized-name-in-linked-work","subjectId":"14494"}],"egsCharacterIds":["12422"],"vndbCharacterId":"c6520"},"originalCharacterName":"姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"11/21"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ふらりとクロの前に現れる謎の少女。"},{"spoiler":false,"text":"洋風の身なりだが、日本的な古めかしい言葉遣いで話す。"},{"spoiler":false,"text":"どんな人物にも威厳ある態度で接する姿は、その名の通りお姫様。"}],"source":"egs","sourceCharacterId":"12422","sourceWorkId":"13743","spoiler":false},{"segments":[{"spoiler":false,"text":"出现在九郎面前的神秘少女。"},{"spoiler":false,"text":"身穿洋装，不过言辞用语却是古老的日本风。"},{"spoiler":false,"text":"因为对任何人都是一副威严的态度，因此她的名字就是公主（姫）。"},{"spoiler":false,"text":"【汝，说了期待，吧。】"}],"source":"bangumi","sourceCharacterId":"12861"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"12422","sourceWorkId":"13743","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"12422","sourceWorkId":"13743","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"12422","sourceWorkId":"13743","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da9be1957f393d6e33584fd3f657ba78925c15e08e554fe710030ad3d80fc4bb.webp","fallbackUrl":"https://wiki-assets.bis