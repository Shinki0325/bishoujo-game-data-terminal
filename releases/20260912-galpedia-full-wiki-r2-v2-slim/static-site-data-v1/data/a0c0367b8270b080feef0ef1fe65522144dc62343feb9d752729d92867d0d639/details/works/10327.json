{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"10327","model":{"presentationWorkId":"vndb:v6462","staff":{"artwork":[{"creditedName":"遊月ことな","creatorId":"vndb:s5692","sourcePersonId":"egs:creator:4890","canonicalEntityId":"vndb:s5692","name":"遊月ことな","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:58808","source":"egs"},{"creditedName":"Ayumu","creatorId":"vndb:s39319","sourcePersonId":"egs:creator:11537","canonicalEntityId":"vndb:s39319","name":"Ayumu","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:58809","source":"egs"}],"scenario":[{"creditedName":"ポルノソムリエ","creatorId":"vndb:s30451","sourcePersonId":"egs:creator:5420","canonicalEntityId":"vndb:s30451","name":"ポルノソムリエ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:58810","source":"egs"}],"music":[{"creditedName":"谷上 純三","creatorId":"vndb:s3956","sourcePersonId":"vndb:s3956","canonicalEntityId":"vndb:s3956","name":"谷上 純三","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:64602","source":"vndb"}],"other":[{"creditedName":"遊女(YuNa)","creatorId":"vndb:s2022","sourcePersonId":"egs:creator:10271","canonicalEntityId":"vndb:s2022","name":"遊女(YuNa)","detail":"主題歌 「燃えるようなウソならば」、ED曲 「今はもう雲の下」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:102872","source":"egs"},{"creditedName":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","creatorId":"vndb:s592","sourcePersonId":"egs:creator:13068","canonicalEntityId":"vndb:s592","name":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","detail":"デモムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:74069","source":"egs"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:64600","source":"vndb"},{"creditedName":"遊女","creatorId":"vndb:s2022","sourcePersonId":"vndb:s2022","canonicalEntityId":"vndb:s2022","name":"遊女","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:64601","source":"vndb"}]},"cast":[{"characterId":"char_c14364","characterName":"アルテミス","sourceIds":{"bangumi":[{"characterId":"136767","match":"exact-normalized-name-in-linked-work","subjectId":"217686"}],"egsCharacterIds":["18876"],"vndbCharacterId":"c14364"},"originalCharacterName":"アルテミス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"森の動物たちを守護する「月と狩猟の女神」。"},{"spoiler":false,"text":"調和と純潔を非常に重んじる彼女は、心優しく身持ちも堅い。"},{"spoiler":false,"text":"兄のように慕っていた英雄「オリオン」を、自分のせいで死なせてしまったと思いこんでいて、そのことが、彼女の心に深いキズとなって、今でも苦しめている。"},{"spoiler":false,"text":"「あなたは、立ちあがろうとしているのですね……。わたし以上の、悲しい境遇から……」"}],"source":"egs","sourceCharacterId":"18876","sourceWorkId":"10327","spoiler":false},{"segments":[{"spoiler":false,"text":"森の動物を守護する、月と狩猟の女神。太陽神アポロンの双子の妹。"},{"spoiler":false,"text":"とても優しく、和と純潔を非常に重んじる。"},{"spoiler":false,"text":"かつて兄のように慕っていた英雄オリオンを、自分の過失で死なせてしまったと思いこんでおり、そのことが根深いトラウマとなっている。"},{"spoiler":false,"text":"魔法の杖「セレーネ・スタッフ」を持つ。有名な必殺技「必中の矢（ヴォロス・アクリヴォス／百発百中の弓の魔法」を持つが、トラウマを抱えているため、当たらなくなっている。"}],"source":"bangumi","sourceCharacterId":"136767"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe29dda573c5b6de426d64dc237eee26319b09f1f84f60d3c879b9ccb8db29c6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/4300b167cff4e2152f66519e10d43995ad323e4770bdd1318af562a07544d5ef.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田依子","creatorId":"vndb:s797","sourcePersonId":"vndb:s797","canonicalEntityId":"vndb:s797","name":"永田依子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217686:136767:5104:1","source":"bangumi"}]},{"characterId":"char_c14366","characterName":"アテナ","sourceIds":{"bangumi":[{"characterId":"136766","match":"exact-normalized-name-in-linked-work","subjectId":"217686"}],"egsCharacterIds":["18877"],"vndbCharacterId":"c14366"},"originalCharacterName":"アテナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"知恵と戦略を司り、純潔を重んじる処女神としても名高い戦女神。"},{"spoiler":false,"text":"気高く凛々しく美しい容姿と、猛々しい気性を併せ持ち、堅牢無比を誇る「イージスの楯」で並みいる敵を寄せ付けない。"},{"spoiler":false,"text":"昔、鍛冶神ヘパイストスに手籠めにされかけたことがあり、その出来事から、精液が非常に苦手な様子。"},{"spoiler":false,"text":"「貴様ごとき、道理のわからぬ者に、私は屈したりはしない！」"}],"source":"egs","sourceCharacterId":"18877","sourceWorkId":"10327","spoiler":false},{"segments":[{"spoiler":false,"text":"知恵と戦略を司る戦女神。最高神ゼウスと、知恵の女神メティスの娘。"},{"spoiler":false,"text":"輝かしい美貌と、猛々しい戦士の気性をあわせ持つ。純潔を重んじる処女神としても名高い。"},{"spoiler":false,"text":"昔からペルセウスと親しく、メデューサ退治のときには彼女の「イージスの盾」を貸した。"},{"spoiler":false,"text":"ペルセウスはこの盾に、退治したメデューサの首を貼りつけてアテナに返した。この首の効果によって、敵を石に変えることができる。"}],"source":"bangumi","sourceCharacterId":"136766"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/272a092a164f49c802e19f8c75df5cf99b7082873c27eba661b4d3f6f23b1bed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf290de07d102f37bcab77d963c1996173d7fe2ed68688225cdebd5c561cd172.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石松千恵美","creatorId":"vndb:s1164","sourcePersonId":"vndb:s1164","canonicalEntityId":"vndb:s1164","name":"石松 千恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217686:136766:4273:1","source":"bangumi"}]},{"characterId":"char_c14367","characterName":"アンドロメダ","sourceIds":{"bangumi":[{"characterId":"136769","match":"exact-normalized-name-in-linked-work","subjectId":"217686"}],"egsCharacterIds":["18879"],"vndbCharacterId":"c14367"},"originalCharacterName":"アンドロメダ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アルゴス王国の女王で、勇者ペルセウスの人妻女神。"},{"spoiler":false,"text":"包容力溢れる母性的と、凛々しく厳格な女王の顔を持つ。"},{"spoiler":false,"text":"主人公の幼馴染で、彼の唯一の理解者であり、また、主人公のことが大好きだったため、かつては肉体関係も持っていた。"},{"spoiler":false,"text":"しかし、ある日突然、海辺の岩場で鎖に繋がれ、それをペルセウスに救われたことから、結婚し女王となってしまったのだが……？"},{"spoiler":false,"text":"「その黒髪が、あなたの心の中で長所になったとき……メデューサは本当に救われるのよ」"}],"source":"egs","sourceCharacterId":"18879","sourceWorkId":"10327","spoiler":false},{"segments":[{"spoiler":false,"text":"アルゴス王国の女王。勇者ペルセウスの妻。人間ではなく女神。"},{"spoiler":false,"text":"凛々しく厳めしい女王の顔と、包容力のあふれる母性的な顔をあわせもつ。"},{"spoiler":false,"text":"主人公の昔なじみであり、唯一の理解者。主人公のことが好きで、かつては肉体関係を持っていた。"},{"spoiler":false,"text":"しかし、ある日突然姿をくらまし、なぜか海辺の岩場に鎖でつながれていたところをペルセウスに救われ、結婚して女王になってしまった。"}],"source":"bangumi","sourceCharacterId":"136769"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05d4c5628c57c31fa1187f25b02dfee9a2a8c5c896384a9e9bfbd03269a555bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c40380e5b75c47f2a9e4d67352c160b48f507938271436f85e8cfca72aee5053.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"咲良さく","creator