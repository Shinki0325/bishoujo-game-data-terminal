ionId":"vndb:vn-staff:51805","source":"vndb"}]},"cast":[{"characterId":"char_c36041","characterName":"一ノ瀬 莉子","sourceIds":{"bangumi":[{"characterId":"46234","match":"exact-normalized-name-in-linked-work","subjectId":"81174"}],"egsCharacterIds":["11653"],"vndbCharacterId":"c36041"},"originalCharacterName":"一ノ瀬 莉子","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"26"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"172"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"元ファッションモデルの人妻。"},{"spoiler":false,"text":"東京の大学に在学中、友人が雑誌に応募したのをきっかけに、ファッションモデルとして活躍する。"},{"spoiler":false,"text":"クールな雰囲気で人気となったが、大学を卒業して人気絶頂の23歳のときに航平と結婚と同時に引退。"},{"spoiler":false,"text":"実父が妹の杏奈が生まれたあとに、交通事故で他界。"},{"spoiler":false,"text":"実母も現在の義父と再婚後に病死。"},{"spoiler":false,"text":"義父は海外家具を中心に輸入品を取り扱う会社の社長をしており、血の繋がった肉親は妹のみになっている。"},{"spoiler":false,"text":"その妹が自己啓発セミナー「ビリーブズ・ラボ」に嵌ってしまい、連れ戻すため「性欲が強く困っている人妻」と偽ってセミナーに潜入することになる。"}],"source":"egs","sourceCharacterId":"11653","sourceWorkId":"14020","spoiler":false},{"segments":[{"spoiler":false,"text":"結婚を機に電撃引退した元カリスマファッションモデル。"},{"spoiler":false,"text":"今の父親は母親が再婚した義父であり、その母が他界したため妹の杏奈が世間でたったひとりの血の繋がった家族。母親を亡くした後は姉として、時には母親代わりとして妹の面倒を見てきた。"},{"spoiler":false,"text":"若くして人に頼らず自分の力でトップモデルにまで昇りつめた彼女には、「壁は自分の力で乗り越えるもの。人格は自分で作っていくもの」 という信念がある。"},{"spoiler":false,"text":"妹を取り戻すために潜入したラボの 「性欲抑制クラス」 で、彼女にとっては屈辱的、恥辱的な爛れたセックス講習を受け続けることになる。"},{"spoiler":false,"text":"貫通暦はイタリア赴任中の夫。航平しかいない。莉子があまりセックスに対して積極的ではないのは、彼女が精液の臭いが嫌いだということにも起因している。"},{"spoiler":false,"text":"ときに妹の杏奈から 「完璧超人」 と揶揄される莉子にも人には言えない恥部がある。"},{"spoiler":false,"text":"それは趣味の乗馬のせいで大陰唇が厚くなり、メラニン色素が沈着して黒ずんでしまっていること。そのため、バスタイムには必ず局部のお手入れを欠かさない。"},{"spoiler":false,"text":"「杏奈。壁にぶつかっても自分の力で乗り越えなさい。あなは私の妹でしょ？」"}],"source":"bangumi","sourceCharacterId":"46234"}],"profileFacts":[{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"46234","value":"身だしなみなどの自己管理が出来ていない人間、精液の臭い"},{"label":"趣味","source":"bangumi","sourceCharacterId":"46234","value":"乗馬"},{"label":"年龄（本版本）","value":"26 岁","valueContext":null,"source":"egs","sourceCharacterId":"11653","sourceWorkId":"14020","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"11653","sourceWorkId":"14020","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"11653","sourceWorkId":"14020","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"172 cm","valueContext":null,"source":"egs","sourceCharacterId":"11653","sourceWorkId":"14020","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"11653","sourceWorkId":"14020","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"11653","sourceWorkId":"14020","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5aeed2525d43d12c1981e6841da4e2951a492f7f6cb381f4da8ff305ca411e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/590742a4748df2aa42e1b8b58ad7b310782f37adae4204715f2ca5ce6216b8e5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:81174:46234:4832:1","source":"bangumi"}]},{"characterId":"char_c36042","characterName":"葛木 尚美","sourceIds":{"bangumi":[{"characterId":"46237","match":"exact-normalized-name-in-linked-work","subjectId":"81174"}],"egsCharacterIds":["11654"],"vndbCharacterId":"c36042"},"originalCharacterName":"葛木 尚美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"29"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is looking for her long lost fiancée. She believed her fiancee is still in Believe laboratory."}],"source":"vndb","sourceCharacterId":"c36042"},{"segments":[{"spoiler":false,"text":"主人公・莉子とともに「ビリーブズ・ラボ」に潜入するフリールポライター。"},{"spoiler":false,"text":"仕事柄ラボの情報を莉子よりも持っているが、今回はビジネスとして潜入するのではなく、ラボに嵌ったと思われる婚約者を取り戻すために入会する。"},{"spoiler":false,"text":"未婚だが既婚者を装い「性欲が強い上に浮気性で夫に離婚されそう」と偽って、莉子と同じ「性欲抑制クラス」を受講するが、講習はラボのモットーである「自己解放」に則ったもので、持っている性欲をすべて開放し、強い性欲をリセットするためのセックス講習をすることだった。"},{"spoiler":false,"text":"その破廉恥な講習にプライドの高さからラボ側とたびたび衝突する莉子を、目的の為に真っ直ぐ進むようサジェスチョンし、莉子を支える。"}],"source":"egs","sourceCharacterId":"11654","sourceWorkId":"14020","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・莉子と共に 『ビリーブズ・ラボ』 に潜入するフリールポライター。"},{"spoiler":false,"text":"仕事柄ラボの情報を莉子よりも持っているが、今回はビジネスとして潜入するのではなく、ラボにハマったと思われる婚約者を取り戻すために入会する。偽造免許証は彼女の知人の手配で入手したもの。"},{"spoiler":false,"text":"未婚だが既婚者を装い、「性欲が強いうえに浮気性で夫に離婚されそう」 と偽って莉子と同じ 「性欲抑制クラス」 を受講する。"},{"spoiler":false,"text":"破廉恥な講習にプライドの高さからラボ側とたびたび衝突する莉子を、目的のために真っ直ぐ進むようサジェスチョンし支える。"},{"spoiler":false,"text":"だが、ラボ内で “導き手” と呼ばれる男性講師の梶朋之とは時々折り合いが悪くなり、露骨に舌打ちすることもある。"},{"spoiler":false,"text":"その様子を梶に見咎められ、たびたび講習から外されてしまうことも。"},{"spoiler":false,"text":"「私、彼に会うためだったら、どんなことでもするわ。ねえ、莉子さん。あなたなら私の気持ち、わかるでしょう？」"}],"source":"bangumi","sourceCharacterId":"46237"}],"profileFacts":[{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"46237","value":"一人称が"},{"label":"趣味","source":"bangumi","sourceCharacterId":"46237","value":"乗馬"},{"label":"年龄（本版本）","value":"29 岁","valueContext":null,"source":"egs","sourceCharacterId":"11654","sourceWorkId":"14020","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"11654","sourceWorkId":"14020","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"11654","sourceWorkId":"14020","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"11654","sourceWorkId":"14020","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"11654","sourceWorkId":"14020","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"11654","sourceWorkId":"14020","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4a32bafd1a5b9b5072f421d1337a9f839e5c5d964c0328400fbb28279bf8842.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22473a9009214b6c690b2ea899bf3f2e5753f130ca0689c4385b7b33537326fa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽吹梨里","creatorId":"vndb:s57","sourcePersonId":"vndb:s57","canonicalEnt