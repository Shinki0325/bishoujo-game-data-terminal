災いして仕事がうまくいった試しがない。"},{"spoiler":false,"text":"そのことに思い悩んでいる時、自己啓発セミナー 『ビリーブズ・ラボ』 に出会い、入会に強く反対した姉に嘘を吐いて入会。通い続けるうちに家に帰らなくなってしまう。"},{"spoiler":false,"text":"ラボでは最初 「自己解放クラス」 に入っていたが、なぜかクラス替えされ現在では 「性欲抑制クラス」 になっている。"},{"spoiler":false,"text":"実は姉へのあまりのコンプレックスのために、秘かに姉を穢す意味でオナニーの時のネタは義理の兄である航平だった。"},{"spoiler":false,"text":"「お姉ちゃん……自分のこと、みにくいアヒルの子だって信じ続けるのって、つらいんだよ」"}],"source":"bangumi","sourceCharacterId":"46236"}],"profileFacts":[{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"46236","value":"自分の大きな胸、自身のない自分"},{"label":"趣味","source":"bangumi","sourceCharacterId":"46236","value":"絵本作り"},{"label":"年龄（本版本）","value":"18 岁","valueContext":null,"source":"egs","sourceCharacterId":"11664","sourceWorkId":"14020","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"11664","sourceWorkId":"14020","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"11664","sourceWorkId":"14020","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"11664","sourceWorkId":"14020","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"11664","sourceWorkId":"14020","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"11664","sourceWorkId":"14020","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1146ea646b11be71a1a7d2831590500c446697a53095acc0a669f9799d48510.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02dd33921a91e7fead85e58255d6c23731ffc1641dabd0762003193f2d7fc6c3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePerso