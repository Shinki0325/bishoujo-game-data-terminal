{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"15379","model":{"presentationWorkId":"vndb:v6353","staff":{"artwork":[{"creditedName":"紅葉-K","creatorId":"vndb:s2458","sourcePersonId":"vndb:s2458","canonicalEntityId":"vndb:s2458","name":"紅葉 蛍","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:63656","source":"vndb"}],"scenario":[{"creditedName":"庵乃 音人","creatorId":"vndb:s595","sourcePersonId":"vndb:s595","canonicalEntityId":"vndb:s595","name":"庵乃 音人","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:63652","source":"vndb"}],"music":[{"creditedName":"Funczion SOUNDS","creatorId":"vndb:s1071","sourcePersonId":"vndb:s1071","canonicalEntityId":"vndb:s1071","name":"Funczion SOUNDS","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:63654","source":"vndb"}],"other":[{"creditedName":"瀧川 遼一","creatorId":"vndb:s1026","sourcePersonId":"vndb:s1026","canonicalEntityId":"vndb:s1026","name":"瀧川 遼一","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:63653","source":"vndb"},{"creditedName":"紅葉-K","creatorId":"vndb:s2458","sourcePersonId":"vndb:s2458","canonicalEntityId":"vndb:s2458","name":"紅葉 蛍","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:63655","source":"vndb"},{"creditedName":"ＧＯＮＤＲＡ","creatorId":"vndb:s7056","sourcePersonId":"vndb:s7056","canonicalEntityId":"vndb:s7056","name":"ＧＯＮＤＲＡ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:63657","source":"vndb"},{"creditedName":"Ｔカップ","creatorId":"vndb:s7057","sourcePersonId":"vndb:s7057","canonicalEntityId":"vndb:s7057","name":"Ｔカップ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:63658","source":"vndb"}]},"cast":[{"characterId":"char_c29592","characterName":"折原 菜々子","sourceIds":{"bangumi":[{"characterId":"174222","match":"exact-normalized-name-in-linked-work","subjectId":"80906"}],"egsCharacterIds":["11008"],"vndbCharacterId":"c29592"},"originalCharacterName":"折原 菜々子","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"19"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"今時珍しい、品行方正で利発な女子大生。"},{"spoiler":false,"text":"民俗学の勉強のため東北の大学へ進学。"},{"spoiler":false,"text":"しかも大学には、全国的にも著名な民俗学研究サークルがあったため、そのサークルに入ることも目的で進学した。"},{"spoiler":false,"text":"今は割りと女性らしい身体になってきたが、高校ぐらいまで胸も小さく、男ボディとイジメられていた。"},{"spoiler":false,"text":"今もマッサージを怠らないほどコンプレックスになっている。"},{"spoiler":false,"text":"自分より大きな胸の女性を見ると、萎縮してしまう。"}],"source":"egs","sourceCharacterId":"11008","sourceWorkId":"14549","spoiler":false},{"segments":[{"spoiler":false,"text":"今時珍しい、品行方正で利発な女子大生。"},{"spoiler":false,"text":"大好きだった祖父の影響で民族学的なことに興味を持ち、全国的に著名な民族学研究サークルのある仙石大学に進学する。"},{"spoiler":false,"text":"その民族学研究サークルで出会った先輩・猪狩義彦に淡い恋心を抱いていたが、ストーカーに襲われそうになったところを助けてもらったこともあり、菜々子の想いはさらに○くなっていった。"},{"spoiler":false,"text":"今はわりと女性らしい身体になっているが、大学に入学する前ぐらいまでは胸が小さく、髪も短かったため 「男ボディ」 「男原菜々夫」 などと呼ばれてイジメられていた。"},{"spoiler":false,"text":"お風呂などで一生懸命マッサージして女性らしい身体を手に入れたが、今でもそのマッサージを怠っていないほどコンプレックスになっている。"},{"spoiler":false,"text":"自分より胸の大きい女性を見ると萎縮するクセが抜けない。"},{"spoiler":false,"text":"「わたし、行きたい……義彦先輩の古里に……。そして、先輩に会いたい……！」"}],"source":"bangumi","sourceCharacterId":"174222"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"174222","value":"ひとり旅、神社仏閣巡り"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c468dd3ecf891d7a4b418f9f64cc3df94efd1fff4fb0ecdbe0ec065f3286a8b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2bd678e24c76e7d9479e31dd6eb2b834230eb592f2afddc39804ce9e4bf3b6d8.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80906:174222:5052:1","source":"bangumi"}]},{"characterId":"char_c29594","characterName":"小森 リカ","sourceIds":{"bangumi":[{"characterId":"174223","match":"exact-normalized-name-in-linked-work","subjectId":"80906"}],"egsCharacterIds":["11009"],"vndbCharacterId":"c29594"},"originalCharacterName":"小森 リカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"22"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"若くして成功した女社長。"},{"spoiler":false,"text":"渋谷で遊んでいた素行不良のギャルだったが、ギャル仲間を募ってモデルの会社を立ち上げる。"},{"spoiler":false,"text":"それが大成功し、カリスマギャル社長として雑誌のインタビューなどに度々登場している。"},{"spoiler":false,"text":"極度のブラコンで結ばれることのなかった兄への屈折した思いをズリネタにオナニーすることが多く、大人のオモチャを愛用し、いつも密かに隠し持っている。"}],"source":"egs","sourceCharacterId":"11009","sourceWorkId":"14549","spoiler":false},{"segments":[{"spoiler":false,"text":"元々は渋谷で遊んでいた素行不良のギャルだったが、ふとしたきっかけでギャル仲間を募ってモデルの会社を立ち上げる。"},{"spoiler":false,"text":"それが大成功し、カリスマギャル社長として雑誌のインタビューなどに度々登場している。"},{"spoiler":false,"text":"しかし、このところ会社の資金繰りが苦しく、借金が焦げついて首が回らなくなりはじめている。"},{"spoiler":false,"text":"六本木で知り合った男・猪狩哮と同居しているが、お互いにアクセサリー感覚で恋愛感情は皆無。"},{"spoiler":false,"text":"哮の言う埋蔵金の話に乗り、多田根村へ行くことに。"},{"spoiler":false,"text":"極度のブラコンで、結ばれることのなかった兄への屈折した思いをズリネタにオナニーすることが多い。 兄に○され、変態的に嬲られるストーリーが得意。"},{"spoiler":false,"text":"大人のオモチャを愛用し、いつも密かに隠し持っている。"},{"spoiler":false,"text":"「だ～か～ら～。アタシ嫌いなんだよ、田舎とか田舎モン。キモい虫とか、ヘビとか、畑の匂いもNGだしさ。ったく、なんべん言わせんのよ」"}],"source":"bangumi","sourceCharacterId":"174223"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"174223","value":"パチンコ、競馬、エステ、ネイルアート、クラブ"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8ca2b288e8b421ea60b022f8f680af5e86f2f30f2ac8c3c86cc776c6a743e52c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2c510ded50481d4d9ca29bb7f48e73aa101e42a60d3f428e5d5b5b4494787e7.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80906:174223:6409:1","source":"bangumi"}]},{"characterId":"char_c29595","characterName":"猪狩 美里","sourceIds":{"bangumi":[{"characterId":"174224","match":"exact-normalized-name-in-linked-work","subjectId":"80906"}],"egsCharacterIds":["11010"],"vndbCharacterId":"c29595"},"originalCharacterName":"猪狩 美里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"32"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"健康食品販売会社の社長を務めている猪狩孝介の妻。"},{"spoiler":false,"text":"実は、他の男性と不倫をしており、借金まみれの夫の世話に疲れていたとき昔の男と再会し焼けぼっくいに火がついた。"},{"spoiler":false,"text":"小便の「トイレで用を足すという行為」に敏感で、お店などでも、いちいち他に誰か居ないか確かめてからでないと用を足せず、誰かが居るときは我慢したりしている。"}],"source":"egs","sourceCharacterId":"11010","sourceWorkId":"14549","spoiler":false},{"segments":[{"spoiler":false,"text":"健康食品販売会社の社長を務めている猪狩孝介の妻。"},{"spoiler":false,"text":"夫の会社の内情は火の車で、数少ない従業員を一人、また一人と解雇しながら延命するような、心細い綱渡りの日々を続けている。"},{"spoiler":false,"text":"実は現在、他の男性と不倫中。借金まみれの夫の世話に疲れていた時、学生時代に付き合っていた男とふとしたきっかけで再会し、焼けぼっくいに火がついた。"},{"spoiler":false,"text":"そのため、夫との離婚を考えるようになっている。"},{"spoiler":false,"text":"そんな時、多田根村出身の夫に頼まれ、祭事に参加するために村へ同行することに。"},{"spoiler":false,"text":"離婚を切り出そうとしていた美里だったが、これが夫への最後の奉仕だと考えている。"},{"spoiler":false,"text":"小便等の “トイレで用を足すという行為” に敏感で、お店などでもいちいち他に誰か居ないか確かめてからでないと用を足せず、誰かが居る時は他のトイレを探したり、我慢したりする。"},{"spoiler":false,"text":"「私、借金のない生活がしたいんです……」"}],"source":"bangumi","sourceCharacterId":"174224"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"174224","value":"TVドラマ鑑賞（韓流ドラマ好き）、ちぎり絵、韓国語会話、手話"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb819c13536f5e0221f40df63afde9bf9451e62a837a21ce253b41cf9f3bc413.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0eb974b31ab99d2705299b60f9d6a91ba09a55eee01b22ed4e1806a2c627e95.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐倉ゆき","creatorId":"vndb:s839","sourcePersonId":"vndb:s839","canonicalEntityId":"vndb:s839","name":"佐倉 ゆき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80906:174224:15997:1","source":"bangumi"}]},{"characterId":"char_c29598","characterName":"猪狩 摩耶","sourceIds":{"bangumi":[{"characterId":"174225","match":"exact-normalized-name-in-linked-work","subjectId":"80906"}],"egsCharacterIds":["10148"],"vndbCharacterId":"c29598"},"originalCharacterName":"猪狩 摩耶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"18"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"村で生まれ育ち、ほとんど村から出たことのない娘。"},{"spoiler":false,"text":"なかなか祭事に戻ってこない義彦に痺れをきらした村長が祭事で重要な役割のオババの補助をしている摩耶を使いに出す。"},{"spoiler":false,"text":"多田根村の女性にはある程度の年齢になると村の男性の精液を飲まなければならない因習があり摩耶もその因習に倣い村長や村民男性に奉仕し、飲んでいる。"}],"source":"egs","sourceCharacterId":"10148","sourceWorkId":"14549","spoiler":false},{"segments":[{"spoiler":false,"text":"村で生まれ育ち、ほとんど村から出たことのない下猪狩の娘。"},{"spoiler":false,"text":"普段は村の近くの分校に通っている。"},{"spoiler":false,"text":"分校一の巨乳の持ち主で、同級生の男子たちからいつも熱い視線を受けている。"},{"spoiler":false,"text":"多田根村の風習に倣い、村の男たちに毎日手や口などで奉仕し、精液を飲んでいたが、祭事の手伝いを続けているうちに村や風習への疑問が膨らんでいく。"},{"spoiler":false,"text":"はじめは菜々子のことをライバル視してきつく当たっていたが、世話をしている間に徐々に打ち解け、菜々子のことを認めるようになる。"},{"spoiler":false,"text":"その後、多根憑祭事の儀式を盗み見て、祭事の異常さに気づき、ついには菜々子たちを村から逃がしてしまう。"},{"spoiler":false,"text":"うちがみ様・そとがみ様を逃がした犯人だとわかっても、村娘の自分にはそんなに酷いことは出来ないだろうとたかをくくっていたのだが……。"}],"source":"egs","sourceCharacterId":"10148","sourceWorkId":"15378","spoiler":false},{"segments":[{"spoiler":false,"text":"村で生まれ育ち、ほとんど村から出たことのない下猪狩の娘。"},{"spoiler":false,"text":"そして、今や村では数少ない若い女性。"},{"spoiler":false,"text":"上猪狩の義彦の幼なじみで、彼のことを 「おにい」 と呼んでいる。"},{"spoiler":false,"text":"赤ん坊の頃に両親を事故で失っているため、村長宅の下女としてオババの手伝いをしている。"},{"spoiler":false,"text":"祭事の開始日が近づいてもなかなか村に戻ってこない義彦を連れ戻すため、村長からの使いとして義彦の元に現れた。"},{"spoiler":false,"text":"義彦に小さな頃から （密かに熱烈な） 好意を寄せている。"},{"spoiler":false,"text":"多田根村の風習に倣い、村長や村民男性に毎日手や口などで奉仕し、精液を飲んでいる。"},{"spoiler":false,"text":"内心快く思っていない風習だが、村の決まり事だからと諦めている。"},{"spoiler":false,"text":"胸にコンプレックスを持つ菜々子が、自虐的になるほどのトランジスタグラマー。"},{"spoiler":false,"text":"「おれ、あの女社長のビビる顔がおもしろくてたまんねぇんだわ」"}],"source":"bangumi","sourceCharacterId":"174225"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cde7d8f858e61c44cf6f60d98d78b7c3bd1d28f215978ac9632d7277e7852b10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b06d1930f5998cbf4981c8bdfc52dd00e4791bf38f20ab53f8a096fe8bd0a6a8.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日アン(春乃うらら)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80906:174225:6480:1","source":"bangumi"}]},{"characterId":"char_c29600","characterName":"お告げ様","sourceIds":{"bangumi":[{"characterId":"174227","match":"exact-normalized-name-in-linked-work","subjectId":"80906"}],"egsCharacterIds":["10145","11011"],"vndbCharacterId":"c29600"},"originalCharacterName":"お告げ様","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"多田根村の神官「お告げ様」として、村の政や今回の多根憑祭事の進行を取り仕切っていた。"},{"spoiler":false,"text":"しかし、うちがみ様・かえがみ様を逃がし、祭事を失敗させてしまったため神官の地位を剥奪されてしまう。"},{"spoiler":false,"text":"下猪狩の村人たちの怒りを鎮めるため、下猪狩の中心に立っている長二郎へ奉仕をさせられることになる。"}],"source":"egs","sourceCharacterId":"10145","sourceWorkId":"15379","spoiler":false},{"segments":[{"spoiler":false,"text":"「お告げ様」と呼ばれているミステリアスな女性。"},{"spoiler":false,"text":"種憑け神社に住み、村で行われる各種の祭事を取り仕切る最高の神官。"},{"spoiler":false,"text":"多田根村では何か問題や決定事項があると、必ずお告げ様に報告し、お告げ様の意見をもとに事を進めることになっている。"},{"spoiler":false,"text":"氷のように冷たい印象で、感情をほとんど表にださない。"}],"source":"egs","sourceCharacterId":"11011","sourceWorkId":"14549","spoiler":false},{"segments":[{"spoiler":false,"text":"村人たちから 「お告げ様」 と呼ばれ、敬われている女性。"},{"spoiler":false,"text":"種憑神社に住み、村の政を仕切る神官。多田根村では何か問題や決定事項があると、必ずお告げ様に報告し、お告げ様の意見をもとに事を進めることになっている。"},{"spoiler":false,"text":"多根憑祭事の進行も神官が取り仕切る。"},{"spoiler":false,"text":"氷のように冷たい印象で、感情をほとんど表に出さない。"},{"spoiler":false,"text":"しかし、なぜか猪狩義彦については感情的になる時がある。"},{"spoiler":false,"text":"多田根村神官はどういう経緯で就くことになるのかも不明だが、村の言葉を使わないことから、この村出身の女性ではないらしい。"},{"spoiler":false,"text":"「……何と穢らわしい。山神様も、さぞお喜びであらせられましょう……」"},{"spoiler":false,"text":"mask"},{"spoiler":false,"text":"多田根村の出身ではないのだが、あるきっかけにより村にやってきて「お告げ様」となった。"},{"spoiler":false,"text":"/mask"}],"source":"bangumi","sourceCharacterId":"174227"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/2985257870465091e163bd4a5e85d3842d0570c0322fd940961e4af1b998ef54.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/4049195d4c94053eca48660d833126ebf5949b86a172cdcf413661d27e7e469b.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MARIO","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80906:174227:4918:1","source":"bangumi"}]},{"characterId":"char_c59658","characterName":"猪狩 義彦","sourceIds":{"bangumi":[{"characterId":"210274","match":"exact-normalized-name-in-linked-work","subjectId":"80906"}],"egsCharacterIds":["11012"],"vndbCharacterId":"c59658"},"originalCharacterName":"猪狩 義彦","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"O"},"height":{"reviewState":"no-conflict","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"多田根村の現村長の息子。"},{"spoiler":false,"text":"このままいくと次期村長になる予定だが、子供の頃から自分の生まれ育った村に違和感を持ち、閉鎖的なむらから出たいと願っていた。"},{"spoiler":false,"text":"苦学しながら法律を学ぶ法学徒。"},{"spoiler":false,"text":"司法試験を目指してがんばっている。"},{"spoiler":false,"text":"温厚で生真面目な性格で、他人を思いやる気持ちを持っている。"}],"source":"egs","sourceCharacterId":"11012","sourceWorkId":"14549","spoiler":false},{"segments":[{"spoiler":false,"text":"年齢：21歳"},{"spoiler":false,"text":"多田根村の現村長の息子。"},{"spoiler":false,"text":"このままいくと次期村長になる予定だが、子供の頃から自分の生まれ育った村に違和感を持ち、閉鎖的な村から出たいと願っていた。"},{"spoiler":false,"text":"ゆえに現村長である父親とは確執状態にあり、ついに行われることになった多根憑祭事の呼び子としての務めも放棄しようとしていた。"},{"spoiler":false,"text":"司法試験を目指して法律を学ぶ法学徒。菜々子と同じ民族学サークルに入っている。"},{"spoiler":false,"text":"母親は居ない。"},{"spoiler":false,"text":"温厚で生真面目な性格で、他人を思いやる気持ちを持っている。"},{"spoiler":false,"text":"しかし祭事中のとあることをキッカケに、自分に好意を寄せている菜々子に対し、鬼のような儀式を繰り返すことになる。"},{"spoiler":false,"text":"「ならないよ……僕は、この村の村長になんか」"}],"source":"bangumi","sourceCharacterId":"210274"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/ccacc15821b7c9a2c2822decde281c4c61fc45b83277b4995a36dd24243cf6eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/6673b3272dd4b3a91adce8f66588413b5886aa3b21ed99aab9b9979e25f2a12a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c59659","characterName":"猪狩 義允","sourceIds":{"bangumi":[{"characterId":"210275","match":"exact-normalized-name-in-linked-work","subjectId":"80906"}],"egsCharacterIds":["11013"],"vndbCharacterId":"c59659"},"originalCharacterName":"猪狩 義允","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"多田根村の現村長。"},{"spoiler":false,"text":"若い頃は息子の義彦同様、苦悩する生真面目な青年だったが、今は多田根村そのものが生き物のように持つ遺伝子を後世に伝えることを使命と考える、ある種の狂気に憑かれている。"},{"spoiler":false,"text":"温厚そうに見える性格の背後で邪悪な奸計を巡らせることも厭わない。"}],"source":"egs","sourceCharacterId":"11013","sourceWorkId":"14549","spoiler":false},{"segments":[{"spoiler":false,"text":"年齢：50歳　多田根村の現村長。先祖代々の務めとして、種憑神社の管理をしている。"},{"spoiler":false,"text":"通常、次期村長は村長家の長男が継ぐ決まりだが、多根憑祭事が行われた場合は、祭事で一番重要な役割を果たした呼び子が次期村長になる権利を得る。"},{"spoiler":false,"text":"村の長として呼び子衆には公平に接しようとするが、内心では実の息子である義彦に村長を継いでもらいたいと願っている。"},{"spoiler":false,"text":"若い頃は義彦と同じように村に疑問を持っていた時期があったようだが、あることをキッカケに村のために生きることを決意をする。"},{"spoiler":false,"text":"お告げ様のことは村へ来る前から知っていたらしい。"},{"spoiler":false,"text":"祭事の進行とは別に、甥の妻の美里へ個人的に興味を示し、孝介の知らないところで美里へ近づいていく。"},{"spoiler":false,"text":"「みなさん美人揃いで、今回の祭事は賑やかになりそうですな。ワハハッ！」"}],"source":"bangumi","sourceCharacterId":"210275"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/7345d47a722a5972e577e53b66a66112832d51993421ad4137a67e4fdc09d096.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9adb23f47218f67d404db358d1738c171bcf94021ba783d166dcc7833d5c567f.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c59660","characterName":"猪狩 孝介","sourceIds":{"bangumi":[{"characterId":"210276","match":"exact-normalized-name-in-linked-work","subjectId":"80906"}],"egsCharacterIds":["11014"],"vndbCharacterId":"c59660"},"originalCharacterName":"猪狩 孝介","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"義彦の従兄。"},{"spoiler":false,"text":"東京に出て独立し、年上の妻までもらったが、事業にたびたび失敗。"},{"spoiler":false,"text":"その都度、叔父である村長に金を無心に来て金を借りていた。"},{"spoiler":false,"text":"年上の美人妻、美里が唯一の逃避場。"},{"spoiler":false,"text":"彼女につらい思いはさせたくないと頑張るが、借金が借金を生み悶々とする毎日を過ごしている。"}],"source":"egs","sourceCharacterId":"11014","sourceWorkId":"14549","spoiler":false},{"segments":[{"spoiler":false,"text":"年齢：29歳"},{"spoiler":false,"text":"多田根村村長の甥で、義彦と哮の従兄。"},{"spoiler":false,"text":"東京に出て独立し、年上の妻までもらったが、事業はうまく行っておらず生活は苦しい。"},{"spoiler":false,"text":"何かある度に、叔父である村長にお金を無心している。"},{"spoiler":false,"text":"マジメでおとなしいが、うまくいかない自分の人生に鬱屈したものを持っている。"},{"spoiler":false,"text":"美人な妻・美里が唯一の逃避場。相思相愛 （と信じている） の彼女につらい思いはさせたくないと頑張るが、借金が借金を生み、悶々とする毎日を過ごしている。"},{"spoiler":false,"text":"呼び子として祭事に連れて行ける女性のアテがないことから、自分の妻を “そとがみ様” として帰郷する。"},{"spoiler":false,"text":"村のためだとはいえ、自分の妻が他の男の相手をさせられることに大きく心を乱されるが、あることをキッカケに、自ら扇動して妻を地獄に叩き落す。"},{"spoiler":false,"text":"「小森さんはお若いのにスゴイ。僕なんか、事業の才能はそこそこあるつもりなんですが、銀行もなかなか渋くて……アハハ……」"}],"source":"bangumi","sourceCharacterId":"210276"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/850eefe6e3e3ad56fc3daaf3c78d4a1066cb90b8eac462059a7486c057cb4d09.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b5f9e92dac4307d0a8ee0370c3ba2672a08f75abc7ff9b5486cd1e9f21ff95c.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c59661","characterName":"猪狩 哮","sourceIds":{"bangumi":[{"characterId":"210277","match":"exact-normalized-name-in-linked-work","subjectId":"80906"}],"egsCharacterIds":["10149"],"vndbCharacterId":"c59661"},"originalCharacterName":"猪狩 哮","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"村長の養子縁組した息子。"},{"spoiler":false,"text":"村で生まれたが赤ん坊の頃、両親を事故で失い、それを村長が引き取った。"},{"spoiler":false,"text":"幼い頃に片目を失い、眼帯をしている。"},{"spoiler":false,"text":"義彦とはそりが合わず、俺が村長になるから村を出るならとっとと出ろと思っている。"}],"source":"egs","sourceCharacterId":"10149","sourceWorkId":"14549","spoiler":false},{"segments":[{"spoiler":false,"text":"多田根村村長の養子縁組した息子。"},{"spoiler":false,"text":"摩耶とは幼い頃から犬猿の仲で、顔を合わせる度に喧嘩ばかりしている。"},{"spoiler":false,"text":"村長やオババから禁止されているため、摩耶とは風習をしたことがない。"},{"spoiler":false,"text":"普段は東京で暮らしているが、多根憑祭事のために村に戻ってきている。"},{"spoiler":false,"text":"菜々子たちが村から逃げだして多根憑祭事が中止になってしまったため、激しい欲求不満を覚えている。"},{"spoiler":false,"text":"その不満を晴らすため、喜び勇んで鬼ごっこに参加しようとするが……。"}],"source":"egs","sourceCharacterId":"10149","sourceWorkId":"15378","spoiler":false},{"segments":[{"spoiler":false,"text":"年齢：19歳"},{"spoiler":false,"text":"多田根村村長の養子縁組した息子。"},{"spoiler":false,"text":"村で生まれたが、赤ん坊の頃に両親を事故で失い、それを村長が引き取った。"},{"spoiler":false,"text":"幼い頃に片目を失い、眼帯をしている。"},{"spoiler":false,"text":"仕事は特にしておらず、主に六本木界隈を根城にしている遊び人。そこで出会ったリカのマンションに転がり込み、一緒に暮らしている。"},{"spoiler":false,"text":"祭事の呼び子として、嫌がるリカを騙して村へ連れて行く。"},{"spoiler":false,"text":"村に対してなんの執着も持っていなかったが、祭事が進むにつれ考えが変わっていき、義兄の義彦から次期村長の座を奪おうとする。"},{"spoiler":false,"text":"凄惨さを増していく祭事の儀式にも、嬉々として参加していく。"},{"spoiler":false,"text":"「オレの子種飲め。今日はまだ誰にも飲ませてねーんだ。うちの村じゃフツーだぞ」"}],"source":"bangumi","sourceCharacterId":"210277"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/018e421f2af219ced9bcf58ef0b9ce2d364d0c0bf5b561a000317cb1f855f5a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d1bafa49d7aef3a2b9dcd2df14e7307b257db4a3521fce5d6656f25608fcf7d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c59663","characterName":"猪狩 二郎","sourceIds":{"bangumi":[],"egsCharacterIds":["10150"],"vndbCharacterId":"c59663"},"originalCharacterName":"猪狩 二郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"O"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"下猪狩に住んでいる摩耶の同級生。"},{"spoiler":false,"text":"普段から摩耶の身体に興味津々で、分校ではいつもねっとりした視線で摩耶を見つめている。"},{"spoiler":false,"text":"都会に憧れていて、分校を出たら村を出ようと考えている。"},{"spoiler":false,"text":"哮を「哮兄ぃ」と呼び、慕っている。"},{"spoiler":false,"text":"憧れの摩耶に好きなことを出来るチャンスだと思い、鼻息を荒くして鬼ごっこに参加する。"}],"source":"egs","sourceCharacterId":"10150","sourceWorkId":"15378","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5eeb678ac7c9293f1ee5d4c5d7b13781065e68993e3761709e227feabe0dc34f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cf838b684e974b74f5b0a125fe2e65346a47c7c0d8df604aabfa9bbf95a90f3.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c59664","characterName":"猪狩 達造","sourceIds":{"bangumi":[],"egsCharacterIds":["10151"],"vndbCharacterId":"c59664"},"originalCharacterName":"猪狩 達造","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"b