ionId":"bangumi:character-voice:271625:124653:6558:1","source":"bangumi"}]},{"characterId":"char_c8215","characterName":"檜前　稟","sourceIds":{"bangumi":[{"characterId":"124654","match":"exact-normalized-name-in-linked-work","subjectId":"271625"}],"egsCharacterIds":["19883"],"vndbCharacterId":"c8215"},"originalCharacterName":"檜前　稟","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"伝説の釣り師の孫として、その名を継ごうと頑張っている美少女釣り師。"},{"spoiler":false,"text":"クールな言動が多いが、「くまりん」と呼ばれるとキレる。"},{"spoiler":false,"text":"褒められるのは嫌いじゃないが、子供扱いされるのは大嫌いな気難しい女の子。"},{"spoiler":false,"text":"祖父が引き分けたという伝説の川の主を求め、主人公を助手として鍛えようと目論んでいるようだ。"}],"source":"egs","sourceCharacterId":"19883","sourceWorkId":"9404","spoiler":false},{"segments":[{"spoiler":false,"text":"伝説の釣り師の孫で、その名を継ごうと頑張る美少女釣り師。"},{"spoiler":false,"text":"神秘的で、クールな物言い。『くまりん』というと、殺される。"},{"spoiler":false,"text":"祖父が引き分けたという伝説の川の主を釣り上げるため日々研鑚を重ねる。主人公を助手として鍛え上げようと企む。"}],"source":"bangumi","sourceCharacterId":"124654"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e25ac8ab2bef959c407b716af073b6cb61b48d2bc4bfeec9c381936ab59a12c3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/7854764afe392a325885c08700517c5070543dc1cbcf96721993a81eaa6bc051.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七生 みこと","creatorId":"vndb:s1697","sourcePersonId":"vndb:s1697","canonicalEntityId":"vndb:s1697","name":"七生みこと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9971","source":"vndb"}]},{"characterId":"char_c8216","characterName":"野乃瀬　ちはや","sourceIds":{"bangumi":[{"characterId":"124655","match":"exact-normalized-name-in-linked-work","subjectId":"271625"}],"egsCharacterIds":["19884"],"vndbCharacterId":"c8216"},"originalCharacterName":"野乃瀬　ちはや","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"おバカで真っ直ぐなトラブルメーカー。"},{"spoiler":false,"text":"元気ハツラツで、山を庭のように駆け回る自然大好き少女。"},{"spoiler":false,"text":"人見知りしない性格で、主人公とも瞬時に仲良くなった。"},{"spoiler":false,"text":"かなりの巨乳の持ち主だが、あまりセクシーに見えない。"}],"source":"egs","sourceCharacterId":"19884","sourceWorkId":"9404","spoiler":false},{"segments":[{"spoiler":false,"text":"お馬鹿で真っ直ぐで、どこまでもお馬鹿なトラブルメーカー。"},{"spoiler":false,"text":"人見知りしない性格。アウトドアが大好きで、山は庭のようなものだと言う。"},{"spoiler":false,"text":"遥佳、凛とは仲良しで、いつも一緒に遊んでいる。"}],"source":"bangumi","sourceCharacterId":"124655"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c39385317ac10285a94de72f94749040f86b34153c976a978c73743621df50e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09ab29c22a9d375065a2930b4aaeafae3c5e5a5205d25eb8a5fd9d353b539056.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井ありす","creatorId":"vndb:s1626","sourcePersonId":"vndb:s1626","canonicalEntityId":"vndb:s1626","name":"櫻井 ありす","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271625:124655:19213:1","source":"bangumi"}]},{"characterId":"char_c8218","characterName":"滝畑　玲","sourceIds":{"bangumi":[{"characterId":"124656","match":"exact-normalized-name-in-linked-work","subjectId":"271625"}],"egsCharacterIds":["19885"],"vndbCharacterId":"c8218"},"originalCharacterName":"滝畑　玲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同じく、都会からやってきたお姉さん気質のOL。"},{"spoiler":false,"text":"ノリがよく、明るく気さくな性格から何かと頼られる。"},{"spoiler":false,"text":"玲は“アキラ”と読むが、ほとんどの人が“レイ”と呼ぶため、面倒だから訂正しない。"},{"spoiler":false,"text":"好きな人には“アキラ”と呼んで欲しいらしく、乙女チックなところも"}],"source":"egs","sourceCharacterId":"19885","sourceWorkId":"9404","spoiler":false},{"segments":[{"spoiler":false,"text":"都会からやってきた元気なOL。ノリがよく明るい性格で、何かと頼られる。"},{"spoiler":false,"text":"名前をレイと呼ばれ、アキラと訂正するのも面倒だからそのままにしている。でも好きな人には、男っぽくてもアキラと呼んで欲しいと思っている。割りと乙女チック。"}],"source":"bangumi","sourceCharacterId":"124656"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1d36a63a8ed9b4d94807005a0e2685b9f607cf78c70c86054ff858977d0db8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf539b948bbf368aeec8cc0717ad9f6697a44ed2322335ba52c0f28bc93b155e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永井ちひろ","creatorId":"vndb:s530","sourcePersonId":"vndb:s530","canonicalEntityId":"vndb:s530","name":"永井 ちひろ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271625:124656:18652:1","source":"bangumi"}]},{"characterId":"char_c8219","characterName":"紫苑坂　鈴音","sourceIds":{"bangumi":[{"characterId":"124657","match":"exact-normalized-name-in-linked-work","subjectId":"271625"}],"egsCharacterIds":["19886"],"vndbCharacterId":"c8219"},"originalCharacterName":"紫苑坂　鈴音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"別荘への避暑も兼ね、ホテルの建設予定地に父親と一緒に下見に訪れたお嬢様。"},{"spoiler":false,"text":"身体がよくなく、性格も内気。"},{"spoiler":false,"text":"自己主張はあまり出来ないが、一度決めると譲らない頑固者。"},{"spoiler":false,"text":"ひょんなことから主人公らと仲良くなり、釣りを通して自然の素晴らしさを知ることに……。"}],"source":"egs","sourceCharacterId":"19886","sourceWorkId":"9404","spoiler":false},{"segments":[{"spoiler":false,"text":"病弱な深窓の令嬢。ホテル建設の下見に訪れた父親と共に、別荘である洋館に避暑に来ている。"},{"spoiler":false,"text":"自分の意見はあまり言えないが、一度決めるととことん頑固者。"},{"spoiler":false,"text":"ひょんなきっかけで主人公たちと仲良くなり、釣りを通して自然の素晴らしさを知る。"}],"source":"bangumi","sourceCharacterId":"124657"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/adf22816ad1b6da382fbbfcf7128810d20bd2af30065d1823d632c2af44278cf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a73226a36c2c2de6fd4daef273c33aa5e3b76e34ef7baff64b8b8b555892f3c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さくらなつみ","creatorId":"vndb:s666","sourcePersonId":"vndb:s666","canonicalEntityId":"vndb:s666","name":"岩泉まい(樋口まゆら、樋口まゆ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271625:124657:6279:1","source":"bangumi"}]},{"characterId":"char_vndb_c8217","characterName":"天川　太一","sourceIds":{"vndbCharacterId":"c8217"},"originalCharacterName":"天川　太一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p497","sourceCompanyId":"egs:brand:2164","canonicalEntityId":"vndb:p497","name":"げーせん18","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:9404:2164","source":"egs"},{"companyId":"vndb:p496","sourceCompanyId":"vndb:p496","canonicalEntityId":"vndb:p496","name":"ユニコーンエー","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:2472:v1100","source":"vndb"},{"companyId":"vndb:p497","sourceCompanyId"