te/terminal-wiki/v1/characters/v1/images/c5/c52e590d2b627de33b6547c479a42f1a0539e050da50555dc9b24e16bb1a1674.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2eb5085e0f54ed4d09d75d9c625b8521226bc12fec4e8f83f4d1a8f5ae94a186.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永瀬江美弥","creatorId":"vndb:s61","sourcePersonId":"vndb:s61","canonicalEntityId":"vndb:s61","name":"永瀬 いくみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:461044:140147:6549:1","source":"bangumi"}]},{"characterId":"char_c108920","characterName":"ミシェル","sourceIds":{"bangumi":[{"characterId":"140148","match":"exact-normalized-name-in-linked-work","subjectId":"461044"}],"egsCharacterIds":["13375"],"vndbCharacterId":"c108920"},"originalCharacterName":"ミシェル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"架空都市「ガウンズシティ」唯一の教会に住む若いシスター。"},{"spoiler":false,"text":"失踪した師の意志を受け継ぎ、悪・即・殺と過激なまでのパフォーマンスで、街の全ての悪を浄化と教会の維持存続のために、日夜戦っている。"},{"spoiler":false,"text":"霊力をエネルギーとする巨大な重火器を武器とし、そのエネルギーの塊を打ちまくる。"},{"spoiler":false,"text":"主人公の体内に宿る悪魔を浄化しようと襲い掛かってくるが……。"}],"source":"egs","sourceCharacterId":"13375","sourceWorkId":"9983","spoiler":false},{"segments":[{"spoiler":false,"text":"ガウンズシティ唯一の教会に住む若いシスター。街の全ての悪を浄化するために戦う超聖女。"},{"spoiler":false,"text":"失踪した師の意志を受け継いで、街の浄化と教会の管理に力を注いでいる。"},{"spoiler":false,"text":"悪・即・殺の過激派。レックスの体内に宿る悪魔を浄化するべく襲い掛かってくる。"},{"spoiler":false,"text":"霊力をエネルギーとする巨大な重火器を使い、エネルギーの塊を無反動で撃ちまくる。"}],"source":"bangumi","sourceCharacterId":"140148"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/494bae7c6c2c68e4fb532ba240ccd3e811d0944ec2628337b5294be910f6de3e.webp","fallba