r_c1519","characterName":"北嶋 楓","sourceIds":{"bangumi":[{"characterId":"16345","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16345","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["557"],"vndbCharacterId":"c1519"},"originalCharacterName":"北嶋 楓","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1021"},"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An extremely shy and fairly nerdish girl. She is also Sara's cousin and is very protective of her. Second year student of St. Michael's Girl's Academy. She has been elected as class president two years in a row."}],"source":"vndb","sourceCharacterId":"c1519"},{"segments":[{"spoiler":false,"text":"ミカ女の2年生で、クラス委員長を務める才女。"},{"spoiler":false,"text":"眼鏡に三つ編みという比較的地味なイメージ。"},{"spoiler":false,"text":"性格はおとなしめで地味だが、責任感がありクラスの信頼も高い。"},{"spoiler":false,"text":"背も高く胸も大きいナイスバディの持ち主。"},{"spoiler":false,"text":"眼鏡＆三つ編み無しの姿が実は美少女であることが発覚し、現在は有名人に。"},{"spoiler":false,"text":"従妹の紗良とは校内の公認カップルで、楓からも積極的に愛情表現をする関係に。"}],"source":"egs","sourceCharacterId":"557","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"ミカ女の３年生で、クラス委員長を務める才女。眼鏡に三つ編みという比較的地味なイメージ。"},{"spoiler":false,"text":"性格はおとなしめで地味だが、責任感がありクラスの信頼も高い。背も高く胸も大きいナイスバディの持ち主。"},{"spoiler":false,"text":"従妹の紗良とは校内の公認カップルで、楓からも積極的に愛情表現をする関係に。"},{"spoiler":false,"text":"現在は紗良とペアで芸能活動をするハメになり、テレビにも出演する多忙な日々を送っている模様。"}],"source":"egs","sourceCharacterId":"557","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"二年级学生，性格内向，是个传统意义上的好孩子，也因此而朋友不多。每个学期都会被高票选为班长，但自己却不喜欢引人注目，又反而因自认为过于平庸而自卑，实际上相当受欢迎。一直很细心照顾堂妹纱良。另外，与松原优菜关系良好。"},{"spoiler":false,"text":"声：五行なずな(=小野涼子)"}],"source":"bangumi","sourceCharacterId":"16345"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b2e81feffc951b839f4a720908c3478783ac619fc43ca6f866fec23a137be2f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf5bc87f114ac07c93eb837dc484b9a3e67866b896f7fe3c736045680c9b093d.webp","width":86,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5359:16345:4727:1","source":"bangumi"}]},{"characterId":"char_c1520","characterName":"北嶋 紗良","sourceIds":{"bangumi":[{"characterId":"16649","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16649","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["558"],"vndbCharacterId":"c1520"},"originalCharacterName":"北嶋 紗良","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1124"},"bust":{"reviewState":"source-only","source":"vndb","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A popular teen model who has return from overseas to attend St. Michael's to be with her cousin Kaede. Sara has harbored feelings for Kaede ever since childhood."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c1520"},{"segments":[{"spoiler":false,"text":"ミカ女の1年生で、楓の年下の従妹。"},{"spoiler":false,"text":"ファッション誌などの人気学生モデルで、母は女優というサラブレッド。"},{"spoiler":false,"text":"性格は極めて明るく社交的。その人柄と容姿もあり、無意識に人を惹きつけるカリスマ体質の持ち主。"},{"spoiler":false,"text":"いわゆる裏表のない性格と物言いで、ある意味天然体質。"},{"spoiler":false,"text":"特に楓に対する好意は公私ともに全開状態。"},{"spoiler":false,"text":"人目があろうが真顔で楓に抱き付いて愛情表現しては、その仲の良さを生徒達に羨ましがられている模様。"}],"source":"egs","sourceCharacterId":"558","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"ミカ女の２年生で、楓の年下の従妹。学生モデルを経て現在はＴＶタレント、母は女優というサラブレッド。"},{"spoiler":false,"text":"性格は極めて明るく社交的。その人柄と容姿もあり、無意識に人を惹きつけるカリスマ体質の持ち主。"},{"spoiler":false,"text":"いわゆる裏表のない性格と物言いで、ある意味天然体質。特に楓に対する好意は公私ともに全開状態。"},{"spoiler":false,"text":"現在は恋人の楓とペアでタレント活動を行う、ある意味校内で有名なカップルでもある。"}],"source":"egs","sourceCharacterId":"558","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"枫的堂妹，性格开朗，很有社交天分。小时候二人十分亲密，因为纱良搬家而分离。后来当上了模特，并取得了超高的人气。很喜欢枫，梦想是与堂姐一起穿上婚纱，于是为了追随她而进入了米卡女校，并且搬入了枫的住所与其同住。"},{"spoiler":false,"text":"声：羽里さつき (bgm.tv查不到…)"}],"source":"bangumi","sourceCharacterId":"16649"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee2fd8d45f087d05c8c5d8fc1bf8086166f8bee58cd300edf67f498739fb0e5a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db6c23b7e66e9079d69b220008b326f1794ae495568584280dd8dfb77b415303.webp","width":87,"height":256,"source":"static-detail"},"actors":[{"creditedName":"椿理沙","creatorId":"vndb:s3863","sourcePersonId":"vndb:s3863","canonicalEntityId":"vndb:s3863","name":"椿 理沙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5359:16649:20162:1","source":"bangumi"}]},{"characterId":"char_c5858","characterName":"沢口 麻衣","sourceIds":{"bangumi":[{"characterId":"16343","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16343","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["559"],"vndbCharacterId":"c5858"},"originalCharacterName":"沢口 麻衣","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"918"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A very responsible second year high school student who has some tomboy tendencies. She falls in love with Reo after getting to know a different side of her."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c5858"},{"segments":[{"spoiler":false,"text":"2年生で、幼稚舎からミカ女に通っている生粋のミカ女育ちだが、両親はフツーの共働き夫婦。"},{"spoiler":false,"text":"特にクラス委員というわけではないものの、面倒見のいい姉御的性格のせいか、頼りにされる事が多い模様。"},{"spoiler":false,"text":"当人的には「自分は庶民」と自覚。"},{"spoiler":false,"text":"ミカ女暮らしが長いので、天然お嬢様達の扱いは手慣れている。"},{"spoiler":false,"text":"そんな物怖じしない性格と行動的なところが人気で、下級生や上級生からラブレターをもらうことも珍しくない。"}],"source":"egs","sourceCharacterId":"559","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"３年生で、幼稚舎からミカ女に通っている生粋のミカ女育ちだが、両親はフツーの共働き夫婦。"},{"spoiler":false,"text":"特にクラス委員というわけではないものの、面倒見のいい姉御的性格のせいか、頼りにされる事が多い模様。"},{"spoiler":false,"text":"そんな物怖じしない性格と行動的なところが人気で、下級生や上級生からラブレターをもらうことも珍しくない。"},{"spoiler":false,"text":"クラスメイトの玲緒とは恋人同士で、現在は玲緒の部屋にほぼ毎日通っている、いわゆる通い妻状態。"}],"source":"egs","sourceCharacterId":"559","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"二年级学生，学习成绩和运动神经都相当不错，也擅长做家务，不是学生委员却非常有号召力，成为被大家像大姐姐一样依靠的人气焦点，连身为会长的松原优菜也很重视她，但她总是以生活在普通家庭中的“庶民”自嘲。因为帮助难以适应班级生活的玲绪而与她日渐亲密。"}],"source":"bangumi","sourceCharacterId":"16343"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36a115cb6928b81254e5e0f9fe3d62942c928937e54307e0a1f3d4c05184559c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98c508a246ceb26b4e4091f8d731c6e973717574f3bdb7ac2eb0cef40dc83f77.webp","width":87,"height":256,"source":"static-detail"},"actors":[{"creditedName":"峯香織","creatorId":"vndb:s20187","sourcePersonId