ntityStatus":"source-native","relationId":"vndb:vn-staff:96026","source":"vndb"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:96028","source":"vndb"},{"creditedName":"手塚 りょうこ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:96030","source":"vndb"},{"creditedName":"玄野 トモアキ","creatorId":"vndb:s713","sourcePersonId":"vndb:s713","canonicalEntityId":"vndb:s713","name":"玄野 トモアキ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:96031","source":"vndb"}]},"cast":[{"characterId":"char_c17897","characterName":"姫川 由梨香","sourceIds":{"bangumi":[{"characterId":"60777","match":"exact-normalized-name-in-linked-work","subjectId":"73446"}],"egsCharacterIds":["3446"],"vndbCharacterId":"c17897"},"originalCharacterName":"姫川 由梨香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A bright, energetic young lady with a strong sense of justice, she is innocent because she grew up in a sheltered environment."},{"spoiler":false,"text":"She is not world savvy, therefore she is fearless and curious. It's easy to influence her because she takes most things in stride."},{"spoiler":false,"text":"Inspired by dramas and anime, she took a teaching job and is in charge of counseling."},{"spoiler":false,"text":"Yurika is a person full of energy and always moves before thinking things through. Her compassion as a teacher is genuine and she's always looking out for them. The problem is, she was spoiled when she was young, and she has trouble scolding student who did the wrong thing. Nevertheless, she is diligent in helping her students as much as she can."}],"source":"vndb","sourceCharacterId":"c17897"},{"segments":[{"spoiler":false,"text":"現国教科担当教師、生活指導担当。"},{"spoiler":false,"text":"明るく元気で正義感の強いお嬢様。"},{"spoiler":false,"text":"箱入りの環境で育ったために純真で世間ずれしておらず、怖いもの知らずで好奇心旺盛。"},{"spoiler":false,"text":"何でも素直に受け止めてしまうため、いろいろな事柄に影響されやすい。"},{"spoiler":false,"text":"ドラマや漫画に感化されて教職に就き、自ら立候補して生活指導を担当している。"},{"spoiler":false,"text":"バイタリティに溢れ、考えるより先に体が動く行動派だが、その行動の端々には育ちの良さがうかがえ、学生に対しても常に丁寧語で話す。"},{"spoiler":false,"text":"教師としての思いやりは本物で、不器用ながらもいつも学生のために行動し、身を挺して学生をかばうことができる。"},{"spoiler":false,"text":"一方で、人から叱られた経験がほとんどないため、間違ったことをした学生を説教するのが苦手である。"},{"spoiler":false,"text":"それでも、真摯に更生への道筋を学生と一緒に考えようとする。"}],"source":"egs","sourceCharacterId":"3446","sourceWorkId":"18049","spoiler":false},{"segments":[{"spoiler":false,"text":"明るく元気で正義感の強いお嬢様。 箱入りの環境で育ったために純真。"},{"spoiler":false,"text":"世間擦れしておらず、それゆえに怖いもの知らずで好奇心旺盛。"},{"spoiler":false,"text":"なんでも素直に受け止めてしまうため、いろいろな事柄に影響されやすい。"},{"spoiler":false,"text":"ドラマや漫画に感化されて教職に就き、自ら立候補した生活指導を担当している。"},{"spoiler":false,"text":"バイタリティにあふれ、考えるより先に身体が動く行動派だが、所作の端々には育ちのよさが窺え、学生に対しても常に丁寧語で話す。"},{"spoiler":false,"text":"教師としての思いやりは本物で、不器用ながらもいつも学生のために行動し、身を挺して学生をかばうことができる。"},{"spoiler":false,"text":"一方で、箱入りゆえに人から叱られた経験がほとんどないため、間違ったことをした学生を説教をするのが苦手。"},{"spoiler":false,"text":"それでも、真摯に更正への道筋を学生と一緒に考えようとする一生懸命さを持つ。"}],"source":"bangumi","sourceCharacterId":"60777"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"60777","value":"現国教科担当教師、生活指導担当"},{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"3446","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"3446","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"3446","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"3446","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"3446","sourceWorkId":"18049","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e94603fa3358e9fe70efea35973f72ffd411fae3a43b6a3259c3a9f053c1f180.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d670989964f2c2dbd4374979fb290a5d32062506ac007a96e46517758223e37.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:73446:60777:10027:1","source":"bangumi"}]},{"characterId":"char_c17899","characterName":"吉井 灯子","sourceIds":{"bangumi":[{"characterId":"60778","match":"exact-normalized-name-in-linked-work","subjectId":"73446"}],"egsCharacterIds":["3447"],"vndbCharacterId":"c17899"},"originalCharacterName":"吉井 灯子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"127"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The homeroom teacher of the protagonist."},{"spoiler":false,"text":"A dependable and calm consultant for her students."},{"spoiler":false,"text":"Because of how much her students depends on her, and her willingness to help them as much as she can, she stresses and lashes out."},{"spoiler":false,"text":"She does not like to show this weakness to others."},{"spoiler":false,"text":"Since her willpower is not that strong, her hearts crumbles as soon as her patience is exceeded and she shows a mean side. She takes care of the amnesiac protagonist, but is having trouble dealing with a student who is have a difficult time."}],"source":"vndb","sourceCharacterId":"c17899"},{"segments":[{"spoiler":false,"text":"数学教科担当の教師、主人公の担任。"},{"spoiler":false,"text":"少し取っつきにくそうに見える外見とは裏腹に、物腰は穏やかで、学生の相談によく乗っている。"},{"spoiler":false,"text":"そういった普段の振る舞いにより、周りからは実力を超えた過度の期待をされることが多く、真面目すぎる性格のため、その期待に応えようと無理をして、ストレスを溜めてしまう損な気質。"},{"spoiler":false,"text":"他人に弱みを見せるのを嫌い、窮地に追い込まれても強がる。"},{"spoiler":false,"text":"だが、芯がそれほど強いわけではないため、限界を超えるとすぐに心が折れてしまう。"},{"spoiler":false,"text":"端的に言ってしまえば、見栄っ張りで、意地っ張り。"},{"spoiler":false,"text":"記憶喪失になった主人公を、担任として面倒を見ているが、本心では厄介な事情を抱えている主人公をどう扱っていいか悩んでいる。"}],"source":"egs","sourceCharacterId":"3447","sourceWorkId":"18049","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラス担任を務めている女教師。"},{"spoiler":false,"text":"少し取っつきにくそうに見える外見とは裏腹に、物腰は穏やかで、学生の相談によく乗っている。"},{"spoiler":false,"text":"そういった普段の振る舞いにより、周りからは実力を超えた過度の期待をされることが多く、まじめすぎる性格のためその期待に応えようと無理をして、ストレスを溜めてしまう損な気質。"},{"spoiler":false,"text":"他人に弱味を見せるのを嫌い、窮地に追い込まれても強がる。"},{"spoiler":false,"text":"だが、芯がそれほど強いわけではないため、我慢の限界を超えるとすぐに心が折れてしまう。"},{"spoiler":false,"text":"端的に言ってしまえば、見栄っ張りで意地っ張り。"},{"spoiler":false,"text":"記憶喪失になった主人公を担任として面倒を見ているが、本心では厄介な事情を抱えている主人公をどう扱っていいか悩んでいる。"}],"source":"bangumi","sourceCharacterId":"60778"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"60778","value":"数学教科担当教師、主人公の担任"},{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"3447","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"3447","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"3447","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"3447","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"3447","sourceWorkId":"18049","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d6ba7827bc4d5efaefe65ceee4cde102fddd824cbb4e50dfa01f8f0b59b8a40.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d8320680356494512f1edf19b56bb216b776626f950f2e6809a7fe4453a55b5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:73446:60778:5890:1","source":"bangumi"}]},{"characterId":"char_c17900","characterName":"水沢 千里","sourceIds":{"bangumi":[{"characterId":"60779","match":"exact-normalized-name-in-linked-work","subjectId":"73446"}],"egsCharacterIds":["3448"],"vndbCharacterId":"c17900"},"originalCharacterName":"水沢 千里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The cheerful gym teacher of the school blessed with athleticism and swimming ability."},{"spoiler":false,"text":"A beautiful woman with an active aura but with the sex appeal of a mature woman."},{"spoiler":false,"text":"She gets along better with the students than with the other teachers. She also treats the protagonist neutrally."},{"spoiler":false,"text":"Despite her sensual appearance, she's not good at anything sexual, and is clearly embarrassed when exposed to such things."},{"spoiler":false,"text":"Chisato loves to gossip about the love lives of others, but her own is lacking considerably."}],"source":"vndb","sourceCharacterId":"c17900"},{"segments":[{"spoiler":false,"text":"体育教科担当教師、競泳部顧問。"},{"spoiler":false,"text":"運動神経に優れ、競泳部の顧問を務める、明るく気さくな性格の女教師。"},{"spoiler":false,"text":"活動的な雰囲気ながら、大人の女性としてのしなやかな品や色気を併せ持つ美女。"},{"spoiler":false,"text":"一般学生にも不良学生にも分け隔てなく接する人当たりの良さで、教師連中より学生たちとの方が仲がよい。"},{"spoiler":false,"text":"主人公に対しても必要に上に構えず、自然体で接している。"}],"source":"egs","sourceCharacterId":"3448","sourceWorkId":"18049","spoiler":false},{"segments":[{"spoiler":false,"text":"運動神経に恵まれた、競泳部の顧問を務める明るく気さくな女教師。"},{"spoiler":false,"text":"活動的な雰囲気ながら、大人の女性としてのしなやかな品や色気を併せ持つ美女。"},{"spoiler":false,"text":"一般学生にも不良学生にも分け隔てなく接する人当たりの良さで、教師連中より学生たちとのほうが仲が良い。"},{"spoiler":false,"text":"主人公に対しても必要以上に構えず、自然体で接している。"},{"spoiler":false,"text":"開けっぴろげに見えるが、エッチなことがとことん苦手で、そうした事柄に接すると明からさまに取り乱してしまう。"},{"spoiler":false,"text":"男女交際についても、他人の色恋の話を聞くのは好きだが、自分のこととなるとてんでダメで、異性からモテるわりに男性経験は皆無。"}],"source":"bangumi","sourceCharacterId":"60779"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"60779","value":"体育教科担当教師、競泳部顧問"},{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"3448","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"3448","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"3448","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"3448","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"3448","sourceWorkId":"18049","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f22b97c9c9b89cc5fe4cf0d7d202295e3148602c1d5e9d4d0fb45b3cfa6690b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/1276c37889249b2a6e8c0b3a3e73a96da7becc828d91de7e0e3bbfe8b38d7d04.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"平野響子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:73446:60779:5669:1","source":"bangumi"}]},{"characterId":"char_c17901","characterName":"Saeki Liana (佐伯 里亜奈)","sourceIds":{"bangumi":[],"egsCharacterIds":["3449"],"vndbCharacterId":"c17901"},"originalCharacterName":"Saeki Liana (佐伯 里亜奈)","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Born a pure-blooded Russian, nationalized in Japan, and the school English teacher."},{"spoiler":false,"text":"Her mature appearance gives off the grace of an antique doll. A calm demeanor, she is dignified in her speech."},{"spoiler":false,"text":"She always stands tall and show a gallant demeanor, which makes her simultaneously look like a princess and a knight."},{"spoiler":false,"text":"Lina speaks fluent Japanese, loves ninja and samurai, and somewhat of a Japanese otaku."},{"spoiler":false,"text":"Because of this culture gap, she has a goofy side that the other students love to she."},{"spoiler":false,"text":"She hates any rule-breaking because of her longing for ideals like bushido and the samurai spirit. A proud teacher who is strict, but cares about her student. She's especially harsh on those who did the wrong things."}],"source":"vndb","sourceCharacterId":"c17901"},{"segments":[{"spoiler":false,"text":"世界史教科担当教師、演劇部顧問。"},{"spoiler":false,"text":"純潔のロシア人で、日本に帰化して教師をしている女性。"},{"spoiler":false,"text":"学生たちには自分を『リーナ』という愛称で呼ばせている。"},{"spoiler":false,"text":"大人びた容姿の中にアンティークドールのような気品とミステリアスさを持つ。"},{"spoiler":false,"text":"物静かで落ち着いた物腰で凛とした物言いをするが心優しい。"},{"spoiler":false,"text":"いつでも背筋を伸ばし、キリッとした態度を見せているため、高貴な姫のようでもあり、高潔な騎士のようでもある。"},{"spoiler":false,"text":"流暢な日本語を話し、忍者や侍などを愛する、多少偏りがある日本文化マニア。"},{"spoiler":false,"text":"そんなカルチャーギャップから、少しとぼけた行動を見せることもあり、そんな一面が学生に愛されている。"},{"spoiler":false,"text":"武士道や侍魂といったものへの憧れから、曲がったことが大嫌い。"},{"spoiler":false,"text":"教師としての誇りを持っており、学生のことも大事に思っているため、指導は厳しめ。"},{"spoiler":false,"text":"間違ったことをする学生には毅然とした態度で、特に厳しく接する。"}],"source":"egs","sourceCharacterId":"3449","sourceWorkId":"18049","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"3449","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"3449","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"3449","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"3449","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"3449","sourceWorkId":"18049","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f340636aa2d31b5920e5643b31bcda5d30717e413fedcaabc16eaa07f91c6532.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0719a92919eb3bfa56aa9965e3cc3ceb1de98f70621be3a3846d8510e090e32.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ヒマリ","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50998","source":"vndb"}]},{"characterId":"char_c17902","characterName":"高科 くるみ","sourceIds":{"bangumi":[{"characterId":"60781","match":"exact-normalized-name-in-linked-work","subjectId":"73446"}],"egsCharacterIds":["3450"],"vndbCharacterId":"c17902"},"originalCharacterName":"高科 くるみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Eat well and sleep well! A nurse who looks and acts like a child."},{"spoiler":false,"text":"She is adored by everyone as the school's mascot, and is often fed with her favorite sweets by her students."},{"spoiler":false,"text":"She's embarrassed about her childishness, and tries to act like an adult, but that doesn't work. In reality, she is a dependable nurse who rarely makes a mistake."},{"spoiler":false,"text":"As the nurse, she shows a more mature side when dealing with students in a more serious manner. She is a good-hearted person who has the belief that there is no such thing as a bad person."},{"spoiler":false,"text":"Even after being raped, her willpower remains strong and she does not shy away from trying to rehabilitate the protagonist."}],"source":"vndb","sourceCharacterId":"c17902"},{"segments":[{"spoiler":false,"text":"養護教諭。よく食べ、よく眠る。"},{"spoiler":false,"text":"喜怒哀楽の激しい、外見も中身も子供のような養護教諭。"},{"spoiler":false,"text":"袖余りのぶかぶかな白衣を羽織った姿が愛らしく、学園のマスコットsとしてみんなから可愛がられ、学生から大好きな甘いお菓子をもらって餌付けされている場面が頻繁に見られる。"},{"spoiler":false,"text":"自分でも子供っぽいことは気にしていて、大人っぽく振る舞おうと心がけているが上手くいかない。"},{"spoiler":false,"text":"実際は、よく気が付くししっかりした性格で、仕事のミスはめったにしない。"},{"spoiler":false,"text":"養護教諭として真面目に学生と接する時は、包容力のあるお姉さんとして頼れる面を見せる。"},{"spoiler":false,"text":"心優しいお人好しで「根っから悪い人なんていない」と性善説を信条としている。"},{"spoiler":false,"text":"主人公に犯された後も、必ず主人公を更生させると誓ってへこたれない芯の強さを見せる。"}],"source":"egs","sourceCharacterId":"3450","sourceWorkId":"18049","spoiler":false},{"segments":[{"spoiler":false,"text":"よく食べ、よく眠る。 喜怒哀楽の激しい、外見も中身も子供のような養護教諭。"},{"spoiler":false,"text":"袖余りのぶかぶかな白衣を羽織った姿が愛らしく、学園のマスコットとしてみんなから可愛がられ、学生から大好きな甘いお菓子をもらって餌付けされている場面が頻繁に見られる。"},{"spoiler":false,"text":"自分でも子供っぽいことは気にしていて、大人っぽく振る舞おうと心がけてはいるが上手くいかない。"},{"spoiler":false,"text":"実際は、よく気がつくしっかりした性格で、仕事でのミスはめったにしない。"},{"spoiler":false,"text":"養護教諭としてまじめに学生と接する時は、包容力のあるお姉さんとして頼れる面を見せる。"},{"spoiler":false,"text":"心優しいお人好しで、「根っから悪い人なんていない」 と性善説を信条としている。"},{"spoiler":false,"text":"凌辱された後も、必ず主人公を更生させると誓ってへこたれない芯の強さを見せる。"}],"source":"bangumi","sourceCharacterId":"60781"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"60781","value":"養護教諭"},{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"3450","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"3450","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"147 cm","valueContext":null,"source":"egs","sourceCharacterId":"3450","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"3450","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"3450","sourceWorkId":"18049","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fecf6d8919137eedc65c6ee0f2721364a3dd40556c698f0e1cea6a2b66ec289.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33856c179cb2c4109bf7ff8a45018d4113b9eca6793057ffd4981647a7e039c3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:73446:60781:15684:1","source":"bangumi"}]},{"characterId":"char_c17903","characterName":"小松崎 志乃","sourceIds":{"bangumi":[{"characterId":"60782","match":"exact-normalized-name-in-linked-work","subjectId":"73446"}],"egsCharacterIds":["3451"],"vndbCharacterId":"c17903"},"originalCharacterName":"小松崎 志乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"64"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The young principal of the school who has recently replaced her uncle for the position."},{"spoiler":false,"text":"Shino is a bit timid, but she has an easy-going personality that cares about the student."},{"spoiler":false,"text":"She used to be a secretary for the previous principal, so she knows how to do her job. However, her lack of experience makes her feel inadequate"},{"spoiler":false,"text":"Due to her new arrival, the students don't know here very well, and she isn't relied upon by the other teachers."},{"spoiler":false,"text":"She knows about the incident the protagonist was involved with, though only partially, and therefore cares for him."}],"source":"vndb","sourceCharacterId":"c17903"},{"segments":[{"spoiler":false,"text":"新任学園長。叔父である先代学園長から代替わりをしたばかりの、歳若い学園長。"},{"spoiler":false,"text":"少々気が弱いが、おおらかでほんわかした優しい性格であり、学生達の事を心底大事に思っている。"},{"spoiler":false,"text":"以前は先代学園長の秘書を務めていたため、仕事のノウハウはあるものの、経験がまるで足りていないため、はまだほとんどお飾りの学園長となっている。"},{"spoiler":false,"text":"まだ着任したばかりのため、学生にもあまり顔を覚えられておらず、教師からも頼りなく思われている。"},{"spoiler":false,"text":"主人公が巻き込まれた事件のことを断片的ながら知っており、そのため主人公のことを気にかけている。"}],"source":"egs","sourceCharacterId":"3451","sourceWorkId":"18049","spoiler":false},{"segments":[{"spoiler":false,"text":"叔父である先代学園長から代替わりをしたばかりの、歳若い学園長。"},{"spoiler":false,"text":"少々気が弱いが、おおらかでほんわかとした優しい性格であり、学生たちのことを心底大事に思っている。"},{"spoiler":false,"text":"運動神経は鈍い。"},{"spoiler":false,"text":"以前は先代学園長の秘書を務めていたため、仕事のノウハウはある。"},{"spoiler":false,"text":"しかし経験がまるで足りていないため、今はまだほとんどお飾りの学園長となっている。"},{"spoiler":false,"text":"まだ着任したばかりのため、学生にもあまり顔を覚えられておらず、教師からも頼りなく思われている。"},{"spoiler":false,"text":"主人公が巻き込まれた事件のことを断片的ながら知っており、そのため主人公のことを気に掛けている。"}],"source":"bangumi","sourceCharacterId":"60782"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"60782","value":"新任学園長"},{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"3451","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"3451","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"3451","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"3451","sourceWorkId":"18049","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"64 cm","valueContext":null,"source":"egs","sourceCharacterId":"3451","sourceWorkId":"18049","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/757286291ca2a8e6d66730f8a9db93ea8b2a822f7ef6abc19f2b3f97c5c4bf86.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/4258f67299c4c5c1ac5ea07ff32efb5d07e841726081573ce0c0a9c91754c51f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confi