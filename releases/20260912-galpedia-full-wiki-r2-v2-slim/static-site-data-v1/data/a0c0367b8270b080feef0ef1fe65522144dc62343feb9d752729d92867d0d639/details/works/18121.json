{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"18121","model":{"presentationWorkId":"vndb:v12272","staff":{"artwork":[{"creditedName":"空想(空想科学青年)","creatorId":"vndb:s6487","sourcePersonId":"egs:creator:14168","canonicalEntityId":"vndb:s6487","name":"空想(空想科学青年)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:113856","source":"egs"}],"scenario":[{"creditedName":"DEカモ","creatorId":"vndb:s7479","sourcePersonId":"egs:creator:15078","canonicalEntityId":"vndb:s7479","name":"DEカモ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:113857","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c25129","characterName":"そら姉","sourceIds":{"bangumi":[{"characterId":"57893","match":"exact-normalized-name-in-linked-work","subjectId":"72668"}],"egsCharacterIds":["203"],"vndbCharacterId":"c25129"},"originalCharacterName":"そら姉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Isora is the older sister. Her gimmick is this: she hates herself. She hates herself so deeply that it’s ingrained in her. She compares herself to things like gum stuck on the sidewalk and pigs in pens. She legitimately thinks that anything good that happens to her must have an ulterior motive, and that she deserves everything bad that happens to her."},{"spoiler":false,"text":"From Dark Eye Translations"}],"source":"vndb","sourceCharacterId":"c25129"},{"segments":[{"spoiler":false,"text":"【自虐型的な長女】"},{"spoiler":false,"text":"ひんやりと冷気をまとった、ミステリアスな姉。"},{"spoiler":false,"text":"文武両道家事看護、やることなすことパーフェクトな完璧超人……"},{"spoiler":false,"text":"だったはずなのに。"},{"spoiler":false,"text":"クールな仮面の下に隠していたのは弟と視線をあわせるだけで身悶え、表情は固まり、息の止まる"},{"spoiler":false,"text":"極めつけのブラコンの顔だった。"},{"spoiler":false,"text":"弟を（性的に）好きな自分を『人間失格の雌豚以下のミジンコより下等なクズ虫』と呼んではばからないネガティブさん。"},{"spoiler":false,"text":"趣味はぬいぐるみ（※腹話術）を使ったセルフ自虐。"},{"spoiler":false,"text":"ちなみに職業はナース。"},{"spoiler":false,"text":"あだ名は『霊安室の白い天使』。"},{"spoiler":false,"text":"「弟のことが性的に好きだなんて。"},{"spoiler":false,"text":"私って本当に、恥知らずで汚れた、最低の姉だわ……！」"}],"source":"egs","sourceCharacterId":"203","sourceWorkId":"18121","spoiler":false},{"segments":[{"spoiler":false,"text":"自虐的すぎる（元）クールビューティな長女"},{"spoiler":false,"text":"ひんやりと冷気をまとった、ミステリアスな姉。 妹の咲耶とは双子の姉妹。"},{"spoiler":false,"text":"文武両道家事看護、やることなすことパーフェクトな完璧超人…… だったはずなのに。"},{"spoiler":false,"text":"クールな仮面の下に隠していたのは、弟と視線を合わせるだけで身悶え、表情は固まり息の止まる、極めつけのブラコンの顔だった。"},{"spoiler":false,"text":"弟を （性的に） 好きな自分を “人間失格の雌豚以下のミジンコより下等なクズ虫” と呼んではばからないネガティブさん。"},{"spoiler":false,"text":"趣味はぬいぐるみ （※腹話術） を使ったセルフ自虐。"},{"spoiler":false,"text":"ちなみに職業はナース。 あだ名は “霊安室の白い天使”。"},{"spoiler":false,"text":"「弟のことが性的に好きだなんて。"},{"spoiler":false,"text":"私って本当に、恥知らずで汚れた、最低の姉だわ……！」"}],"source":"bangumi","sourceCharacterId":"57893"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a69a6eaa197dae8ee1b78097d0aefcc573c8b83d179043316f509aa9138c73f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/7561296b5b383846247586948b7bd175d6a9153ef63503752170b73350e691da.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浜田夏樹","creatorId":"vndb:s20635","sourcePersonId":"vndb:s20635","canonicalEntityId":"vndb:s20635","name":"浜田夏樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:72668:57893:25250:1","source":"bangumi"},{"creditedName":"木野原 さやか","creatorId":"vndb:s1452","sourcePersonId":"vndb:s1452","canonicalEntityId":"vndb:s1452","name":"木野原 さやか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:52121","source":"vndb"}]},{"characterId":"char_c25130","characterName":"さく姉","sourceIds":{"bangumi":[{"characterId":"57894","match":"exact-normalized-name-in-linked-work","subjectId":"72668"}],"egsCharacterIds":["204"],"vndbCharacterId":"c25130"},"originalCharacterName":"さく姉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sakuya is the other sister. Her schtick is that she’s a very naïve person: she doesn’t know much about the world, but she knows a hell of a lot about flower-arrangement and being a good wife."},{"spoiler":false,"text":"From Dark Eye Translation"}],"source":"vndb","sourceCharacterId":"c25130"},{"segments":[{"spoiler":false,"text":"【献身的すぎる次女】"},{"spoiler":false,"text":"しっとりと大和撫子めいた、優しげな姉。"},{"spoiler":false,"text":"微笑みひとつで貢物が山となる、現代のかぐや姫。"},{"spoiler":false,"text":"が、実は弟以外のことがほぼ全てどうでもいい「only you」を地でゆく、愛がダダ漏れのお人。"},{"spoiler":false,"text":"弟の世話をすることが生きがいで、"},{"spoiler":false,"text":"“主人公が自分なしでは生きていけない体になること”を常日頃から夢見ているロマンチストさん。"},{"spoiler":false,"text":"『どんな形であっても』弟が自分を必要とし、その心に自分がいることが喜び。"},{"spoiler":false,"text":"ひっそりと、弟に話しかけられた回数を懐のメモ帳でいちいちカウントしている。それは幸せの数"},{"spoiler":false,"text":"「愛ってそういうものですよね？"},{"spoiler":false,"text":"互いがいなければ、呼吸さえままならない……ふふっ」"}],"source":"egs","sourceCharacterId":"204","sourceWorkId":"18121","spoiler":false},{"segments":[{"spoiler":false,"text":"あふれだす愛を止める気のない、困った次女"},{"spoiler":false,"text":"しっとりと大和撫子めいた、優しげな姉。 双子姉妹の妹。"},{"spoiler":false,"text":"微笑みひとつで貢物が山となる、現代のかぐや姫。"},{"spoiler":false,"text":"が、実は弟以外のことはどうでもいい “only you” を地で行く、愛がダダ漏れのお人。"},{"spoiler":false,"text":"弟の世話をすることが生き甲斐で、“弟が自分なしでは生きていけない身体になること” を常日頃から夢見ているロマンチストさん。"},{"spoiler":false,"text":"“どんな形であっても” 弟が自分を必要とし、その心に自分が居ることが喜び。"},{"spoiler":false,"text":"ひっそりと、弟に話しかけられた回数を懐のメモ帳でいちいちカウントしている。 それは幸せの数。"},{"spoiler":false,"text":"「愛ってそういうものですよね？"},{"spoiler":false,"text":"互いがいなければ、呼吸さえままならない……ふふっ」"}],"source":"bangumi","sourceCharacterId":"57894"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d3a9a32b0924744667378567bfa28b9b69b085c6c63ce8bb1e4db54a01b79e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d9f4e6fad2bca0856efd551c9d67af01969b79994652ab2eba56852c5567061.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"mahilo","creatorId":"vndb:s1492","sourcePersonId":"vndb:s1492","canonicalEntityId":"vndb:s1492","name":"眞尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:72668:57894:34633:1","source":"bangumi"}]},{"characterId":"char_c64301","characterName":"たっくん","sourceIds":{"bangumi":[{"characterId":"219027","match":"exact-normalized-name-in-linked-work","subjectId":"72668"}],"egsCharacterIds":["205"],"vndbCharacterId":"c64301"},"originalCharacterName":"たっくん","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"姉に愛され過ぎて、檻から出られない学園生。"},{"spoiler":false,"text":"姉たちにちょっと、少し、だいぶ深めの愛情を抱いていて、“姉弟の一線を越えてしまう前に” と家を出て一人暮らししようとした……のはいいが、それが、ふたりの姉を “異常な行動” に出させることに……。"},{"spoiler":false,"text":"姉たちのことを心から好いているため、「大好きな姉を自分の手で汚したくない」 と、文字通り死ぬ気で姉との関係改善を目指す。"}],"source":"bangumi","sourceCharacterId":"219027"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/363b5016c3fc2880c2a3051ec80255b79b9ccc410c5e89a4b085e077feee7e32.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab9731aacd6cc3822667df7d3cc4c52ded2c75120af9d0f8ba50059d9e18693c.webp","width":188,"heig