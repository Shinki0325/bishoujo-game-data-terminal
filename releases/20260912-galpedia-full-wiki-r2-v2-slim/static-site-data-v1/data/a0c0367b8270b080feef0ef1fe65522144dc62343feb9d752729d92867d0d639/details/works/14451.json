:{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1140e698776f84cf3492dcb73923e32ca7a1f45f1afac1343b2d386e3f46e6b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d665d9af4179ec624e2f7f3ce80e63b5d1bf23afed065e7637336ce651a212a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みる","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31321","source":"vndb"}]},{"characterId":"char_vndb_c22085","characterName":"鷹司 薫子","sourceIds":{"vndbCharacterId":"c22085"},"originalCharacterName":"鷹司 薫子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Second year student and the protagonist's classmate. She doesn't live in the apartment because she is an ojou-sama living in a high grade place. No one knows why but she is always concerned about the protagonist, but does not display the slightest bit of gentleness, but rather sarcastic, and once she begins the shout there will be no end, she is constantly in disagreements with him. She considers herself Natsuki's rival. However, the related person does not take the rivalry seriously."}],"source":"vndb","sourceCharacterId":"c22085"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df59f3283c723c90ceafd439d12c9ca3f41c1a60811c96f364b12819ce53e052.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d03abd795aacd1dc854cf5fd00a791ed996ab73e4d254d5a334983a44764a8d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"韮井 叶","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"韮井叶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31324","source":"vndb"}]},{"characterId":"char_vndb_c22086","characterName":"藤乃 なつき","sourceIds":{"vndbCharacterId":"c22086"},"originalCharacterName":"藤乃 なつき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's classmate and one of the apartment tenants. Doesn't show much emotions, therefore she is considered a cold girl. She came very far to attend this school so she lives in the apartment. She can do everything beautifully, but if not requested she will not do anything, so in short, she has zero motivation. In truth she doesn't actually hate helping other people, and when requested she is actually happy. Kauruko considers herself her rival. However, Natsuki does not take the rivalry seriously."}],"source":"vndb","sourceCharacterId":"c22086"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4db