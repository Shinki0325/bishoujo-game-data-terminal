{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"3342","model":{"presentationWorkId":"vndb:v3329","staff":{"artwork":[{"creditedName":"光姫満太郎","creatorId":"vndb:s3205","sourcePersonId":"egs:creator:1115","canonicalEntityId":"vndb:s3205","name":"光姫満太郎","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:4960","source":"egs"}],"scenario":[{"creditedName":"籐太","creatorId":"vndb:s847","sourcePersonId":"egs:creator:2155","canonicalEntityId":"vndb:s847","name":"籐太","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:4961","source":"egs"}],"music":[{"creditedName":"ron","creatorId":"vndb:s6304","sourcePersonId":"egs:creator:4534","canonicalEntityId":"vndb:s6304","name":"ron","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:16422","source":"egs"},{"creditedName":"Angel Note","creatorId":"vndb:s758","sourcePersonId":"egs:creator:2558","canonicalEntityId":"vndb:s758","name":"Angel Note","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:7420","source":"egs"}],"other":[{"creditedName":"籐太","creatorId":"vndb:s847","sourcePersonId":"egs:creator:2155","canonicalEntityId":"vndb:s847","name":"籐太","detail":"企画・原案","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:109811","source":"egs"},{"creditedName":"中山マミ(中山♡マミ)","creatorId":"vndb:s1609","sourcePersonId":"egs:creator:12569","canonicalEntityId":"vndb:s1609","name":"中山マミ(中山♡マミ)","detail":"OP曲「INNOCENT」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:150544","source":"egs"},{"creditedName":"Riryka(みるくくるみ)","creatorId":"vndb:s1847","sourcePersonId":"egs:creator:7436","canonicalEntityId":"vndb:s1847","name":"Riryka(みるくくるみ)","detail":"OP曲「INNOCENT」、ED曲「DESPERADO」、挿入歌「Call On Me」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:64278","source":"egs"},{"creditedName":"籐太","creatorId":"vndb:s847","sourcePersonId":"vndb:s847","canonicalEntityId":"vndb:s847","name":"籐太","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:42380","source":"vndb"},{"creditedName":"中山♥マミ","creatorId":"vndb:s1609","sourcePersonId":"vndb:s1609","canonicalEntityId":"vndb:s1609","name":"中山♡マミ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:42381","source":"vndb"},{"creditedName":"みるく くるみ","creatorId":"vndb:s1847","sourcePersonId":"vndb:s1847","canonicalEntityId":"vndb:s1847","name":"Riryka","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:42382","source":"vndb"}]},"cast":[{"characterId":"char_c59509","characterName":"花月 洸","sourceIds":{"bangumi":[{"characterId":"197275","match":"exact-normalized-name-in-linked-work","subjectId":"1119"}],"egsCharacterIds":["16961"],"vndbCharacterId":"c59509"},"originalCharacterName":"花月 洸","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公（葦原武流＝スター・オブ・シェラレオーネの金剛）が居候することになった家の一人娘。"},{"spoiler":false,"text":"家はかなり裕福で、庭には日本庭園、お手伝いさんも完備。"},{"spoiler":false,"text":"やや夢見がちな少女だが、自分の意見をはっきりと述べられるしっかり者。"},{"spoiler":false,"text":"学校の成績も優秀で、家事全般も得意。"},{"spoiler":false,"text":"お嬢様として扱われることを嫌い、普通の女の子のように振る舞っているが、時折、お嬢様っぽい仕草がちらほらと。"}],"source":"egs","sourceCharacterId":"16961","sourceWorkId":"3342","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が居候することになる家の一人娘。"},{"spoiler":false,"text":"彼女の父はとある会社の社長で、家の庭は日本庭園だったり、"},{"spoiler":false,"text":"お手伝いさんがいたりする、お嬢様。"},{"spoiler":false,"text":"性格はハキハキしゃべり、"},{"spoiler":false,"text":"自分の意見をちゃんと言えるしっかり者で、人情家でもある。"},{"spoiler":false,"text":"家事全般も得意で、学校の成績も悪くない。"},{"spoiler":false,"text":"だが、少し夢見る乙女的なところがある。"},{"spoiler":false,"text":"本人は周囲にお嬢様として扱われるのを嫌っているため、"},{"spoiler":false,"text":"そう見られないように普通の女の子らしく振舞おうするが、"},{"spoiler":false,"text":"ところどころで身についた礼儀作法が出てしまったり、"},{"spoiler":false,"text":"お嬢様らしい勘違いをしていたりであまりうまくいっていない。"},{"spoiler":false,"text":"それ以外では、普通の女の子といえる。"},{"spoiler":false,"text":"それが偶然、魔物が宿っている宝石（オパール）を拾い、"},{"spoiler":false,"text":"不思議な力を手に入れてしまい…"}],"source":"bangumi","sourceCharacterId":"197275"}],"profileFacts":[{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"16961","sourceWorkId":"3342","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"16961","sourceWorkId":"3342","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/362ccd9a74a5bf3a912fa4404d453bad4c45e2108a940c33ee588bda2e53fe4b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b34f4f01d315565a0fe70c9561748b216a6a09768de7ebcd1c03588fd726a743.webp","width":123,"height":256,"source":"static-detail"},"actors":[{"creditedName":"すずきけいこ","creatorId":"vndb:s445","sourcePersonId":"vndb:s445","canonicalEntityId":"vndb:s445","name":"涼森ちさと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1119:197275:6275:1","source":"bangumi"}]},{"characterId":"char_c59510","characterName":"天原 すせり","sourceIds":{"bangumi":[{"characterId":"197280","match":"exact-normalized-name-in-linked-work","subjectId":"1119"}],"egsCharacterIds":["16966"],"vndbCharacterId":"c59510"},"originalCharacterName":"天原 すせり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の義妹。"},{"spoiler":false,"text":"幼い見た目に反して、ジェムマスターとしての実力は主人公に匹敵する。"},{"spoiler":false,"text":"言葉遣いは非常に丁寧で、良家のお嬢様を感じさせるが、その性格は凶悪。"},{"spoiler":false,"text":"飄々としていて掴みどころがなく、冷静沈着なようで子供っぽいときもあり、何を考えているかわからない、そんな女の子。"},{"spoiler":false,"text":"敬愛する主人公の言葉には素直に従う。"}],"source":"egs","sourceCharacterId":"16966","sourceWorkId":"3342","spoiler":false},{"segments":[{"spoiler":false,"text":"見た目は幼いが、ジェムマスター（召喚者）としての実力は"},{"spoiler":false,"text":"主人公にも匹敵する。"},{"spoiler":false,"text":"自分のことを『私（わたくし）』と言い、"},{"spoiler":false,"text":"良家の子女のような言葉遣いで話すが、その性格は凶悪。"},{"spoiler":false,"text":"他人から受けた恨みはなにがあっても忘れず、"},{"spoiler":false,"text":"また相手がどんなに怒っていようとも「ほほほっ」と笑って取り合わない。"},{"spoiler":false,"text":"飄々としていて捕らえどころがなく、なにを考えているのかわからない。"},{"spoiler":false,"text":"しかしいつも冷静沈着であるように見えて、"},{"spoiler":false,"text":"意外と子供っぽいところもある。"},{"spoiler":false,"text":"また、敬愛する義兄にだけは心を開いているのか、"},{"spoiler":false,"text":"彼の言うことだけは素直に聞く。"},{"spoiler":false,"text":"キャッツアイ・ムーンストーンより月花鳥・白鳳、"},{"spoiler":false,"text":"キャッツアイ・ダイオプサイドより破邪鬼・絶影を喚び操る。"}],"source":"bangumi","sourceCharacterId":"197280"}],"profileFacts":[{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCharacterId":"16966","sourceWorkId":"3342","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"145 cm","valueContext":null,"source":"egs","sourceCharacterId":"16966","sourceWorkId":"3342","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/520d54d2e02a7712f2634b92fb19123d84d9df30971f3f2720410838a8b328f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e4a1a592c7ed8a41a6550bce2b8ddad19493a8ccd08fa68ba0d0be2574c2ecb.webp","width":120,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天天","creatorId":"vndb:s2922","sourcePersonId":"vndb:s2922","canonicalEntityId":"vndb:s2922","name":"天天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1119:197280:18086:1","source":"bangumi"}]},{"characterId":"char_c59511","characterName":"草壁 真珠","sourceIds":{"bangumi":[{"characterId":"197276","match":"exact-normalized-name-in-linked-work","subjectId":"1119"}],"egsCharacterIds":["16962"],"vndbCharacterId":"c59511"},"originalCharacterName":"草壁 真珠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"花月洸の友人。"},{"spoiler":false,"text":"内気で引っ込み思案、クラスでも目立たない女の子。"},{"spoiler":false,"text":"両親は成績以外のことに無関心であり、弟も姉と話せば、イライラしっ放しと、あまり家庭環境は良くないようだ。"},{"spoiler":false,"text":"また進級後のクラス替えによって、あるグループからいじめを受けるようにもなり、家でも学園でも悩みを抱えている。"},{"spoiler":false,"text":"主人公に対して、密かな想いを抱いているようだが……。"}],"source":"egs","sourceCharacterId":"16962","sourceWorkId":"3342","spoiler":false},{"segments":[{"spoiler":false,"text":"洸の友達のメガネっ子。"},{"spoiler":false,"text":"密かに主人公に憧れているが、洸の存在が気になって、"},{"spoiler":false,"text":"ただでさえ引っ込み思案な彼女は、はっきりとした態度が取れずにいる。"},{"spoiler":false,"text":"そんな彼女は当然、クラスでもあまり目立たない存在。"},{"spoiler":false,"text":"両親は成績以外のことには無関心、"},{"spoiler":false,"text":"弟はいつも彼女にイライラした口調で話す。"},{"spoiler":false,"text":"と、結局は一般的な中流家庭であり、"},{"spoiler":false,"text":"密かに豪邸に住む洸にコンプレックスを感じている。"},{"spoiler":false,"text":"そんな彼女は進級後のクラス替えをきっかけに"},{"spoiler":false,"text":"あるグループからイジメを受けるようになっていた。"},{"spoiler":false,"text":"それを友人である洸（別のクラス）にも、当然、両親にも話せずに悩んでいる。"}],"source":"bangumi","sourceCharacterId":"197276"}],"profileFacts":[{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"16962","sourceWorkId":"3342","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"16962","sourceWorkId":"3342","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"height":[{"comparisonValue":"165","source":"vndb","sourceCharacterId":"c59511","value":"165"},{"comparisonValue":"155","scope":"sourceWork","source":"egs","sourceCharacterId":"16962","sourceWorkId":"3342","value":"155"},{"comparisonValue":"155","source":"bangumi","sourceCharacterId":"197276","value":"155cm"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d31b3ce34f16a9da4ab909bb3ad5cf0cb1633f594eaf5c85b6fc8df0ef63112.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1a48cf9da6d5da01fe7959dbbcf0629b81cc378a45d98c60a6bc57d872a8da0.webp","width":96,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Rita","creatorId":"vndb:s102","sourcePersonId":"vndb:s102","canonicalEntityId":"vndb:s102","name":"平井 理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1119:197276:5742:1","source":"bangumi"}]},{"characterId":"char_c59512","characterName":"武原 こはく","sourceIds":{"bangumi":[{"characterId":"197278","match":"exact-normalized-name-in-linked-work","subjectId":"1119"}],"egsCharacterIds":["16964"],"vndbCharacterId":"c59512"},"originalCharacterName":"武原 こはく","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"心臓病のため病院に長期入院している少女。"},{"spoiler":false,"text":"普段は元気に明るく振る舞って、病気であることを感じさせないが、時折、発作が起こり、苦しそうなその姿から病状が重いことをうかがわせる。"},{"spoiler":false,"text":"ややブラコンの気があり、いつも傍にいてくれる兄・亮一に兄妹以上の感情を抱いているようだ。"}],"source":"egs","sourceCharacterId":"16964","sourceWorkId":"3342","spoiler":false},{"segments":[{"spoiler":false,"text":"心臓の病気で病院に長期入院している少女。"},{"spoiler":false,"text":"しかし、普段の彼女は健気で明るく"},{"spoiler":false,"text":"表面上は病気を感じさせることはない。"},{"spoiler":false,"text":"ただ、時折起こる発作から、"},{"spoiler":false,"text":"彼女の抱える病気の重大さがうかがい知れる。"},{"spoiler":false,"text":"また多少、ブラコンの気があり、いつも傍にいてくれる兄・亮一に"},{"spoiler":false,"text":"普通の兄妹以上の感情を抱いている。"},{"spoiler":false,"text":"最近、兄の様子がおかしいことに気づいており、心配している。"}],"source":"bangumi","sourceCharacterId":"197278"}],"profileFacts":[{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCharacterId":"16964","sourceWorkId":"3342","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"147 cm","valueContext":null,"source":"egs","sourceCharacterId":"16964","sourceWorkId":"3342","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c9908ccbf0876967e0c599122fa6863a43e6165fba04eab3fa93080d8b0fd025.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c92480b613886da775d31dcbe40393a1dff2fa14fdaf22bd36aa6a5e34caddb0.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"比未子","creatorId":"vndb:s1499","sourcePersonId":"vndb:s1499","canonicalEntityId":"vndb:s1499","name":"比未子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1119:197278:18171:1","source":"bangumi"}]},{"characterId":"char_c59513","characterName":"八坂野 るり","sourceIds":{"bangumi":[{"characterId":"197277","match":"exact-normalized-name-in-linked-work","subjectId":"1119"}],"egsCharacterIds":["16963"],"vndbCharacterId":"c59513"},"originalCharacterName":"八坂野 るり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"街外れの神社に住む天然ボケな巫女さん。22歳。"},{"spoiler":false,"text":"神社は小高い山の上にあり、神社まで長い階段をのぼらねばならないため、なかなか参拝客が来ない。"},{"spoiler":false,"text":"幼い頃からずっと修行していたため、神社の外に出ることがほとんどなく、世事に疎く、かなり浮世離れしている。"}],"source":"egs","sourceCharacterId":"16963","sourceWorkId":"3342","spoiler":false},{"segments":[{"spoiler":false,"text":"天然ボケな巫女さん。"},{"spoiler":false,"text":"大都会の外れに聳え立つ小高い山の上、"},{"spoiler":false,"text":"そこだけ時間の流れから切り取られたかのような"},{"spoiler":false,"text":"その場所に彼女が住む神社がある。"},{"spoiler":false,"text":"神社に来るまでにかなり長い階段を登らなくてはならない上、"},{"spoiler":false,"text":"特に有名なわけでもないので立ち寄る人間は少ない。"},{"spoiler":false,"text":"彼女自身もまたあまり神社の外に出ることがなかったため、"},{"spoiler":false,"text":"かなり浮世離れした性格をしている。"},{"spoiler":false,"text":"賽銭箱を破壊して金を盗み出そうとしている主人公を見て、"},{"spoiler":false,"text":"住むところのないかわいそうな人だと勘違いしている。"},{"spoiler":false,"text":"空から降ってきた宝石（ガーネット）が胸に刺さってしまい、"},{"spoiler":false,"text":"それ以来、本人の意思と関係なく周囲で怪異が絶えなくなる。"}],"source":"bangumi","sourceCharacterId":"197277"}],"profileFacts":[{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"16963","sourceWorkId":"3342","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"16963","sourceWorkId":"3342","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2edf0a1d2a4ccc8c1a5104ab855c1f67685bb341bf303731bbc91b035151cee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/407820ee29693a51e3363ef0988e561c7359040b62ff4c8897adb0503ad6e8f5.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"及川ひとみ","creatorId":"vndb:s110","sourcePersonId":"vndb:s110","canonicalEntityId":"vndb:s110","name":"鳩野比奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1119:197277:13696:1","source":"bangumi"}]},{"characterId":"char_c59531","characterName":"琴代 キラ","sourceIds":{"bangumi":[{"characterId":"197279","match":"exact-normalized-name-in-linked-work","subjectId":"1119"}],"egsCharacterIds":["16965"],"vndbCharacterId":"c59531"},"originalCharacterName":"琴代 キラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"花月洸のクラスメイト。"},{"spoiler":false,"text":"美しい見た目とは裏腹に、実は不良グループのリーダー的存在。"},{"spoiler":false,"text":"クールで口数も少なく、学校では取り巻き連中とに囲まれているが、ほとんど口を開くことはない。"},{"spoiler":false,"text":"学校側からも不良のレッテルを貼られ、目を付けられているが、学業成績は優秀で、運動神経も抜群に良い。"}],"source":"egs","sourceCharacterId":"16965","sourceWorkId":"3342","spoiler":false},{"segments":[{"spoiler":false,"text":"真っ黒な長い髪に切れ長の妖しい瞳。"},{"spoiler":false,"text":"特に胸やおしりが大きいというわけではないが、"},{"spoiler":false,"text":"きゅっと締まったウエストから伸びるスラリと長い足、"},{"spoiler":false,"text":"形よく盛り上がった胸に、"},{"spoiler":false,"text":"どこかなまめかしいうなじから顎のラインと、"},{"spoiler":false,"text":"まるで胡蝶のように美しい少女。"},{"spoiler":false,"text":"だが、見た目の美しさとは裏腹、"},{"spoiler":false,"text":"実は校舎裏にたむろする不良グループのリーダー的存在で、"},{"spoiler":false,"text":"しかも常に木刀を携帯している。"},{"spoiler":false,"text":"当然、喧嘩に強く、"},{"spoiler":false,"text":"運動神経も同年代の少女たちの間ではズバ抜けている。"},{"spoiler":false,"text":"また、意外にも学校の成績も"},{"spoiler":false,"text":"カンニングの疑いがかけられるほどよい。"},{"spoiler":false,"text":"学校にいるときは常に取り巻きに囲まれているが、"},{"spoiler":false,"text":"彼女は誰にも心を開かず、孤独である。"},{"spoiler":false,"text":"彼女の私生活を知る者はいないのだ。"},{"spoiler":false,"text":"主人公に興味を持っているようだが、"},{"spoiler":false,"text":"敵か味方か…それは謎である。"}],"source":"bangumi","sourceCharacterId":"197279"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/003085e073bb2de9fe4f2ef36f86fde79b171078e715ba7b8be3e441433f3faf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5f57f74550e3905df57643e938a182c362c4ef9810c43a1b9343443ad9dd99b.webp","width":127,"height":256,"source":"static-detail"},"actors":[{"creditedName":"児玉さとみ","creatorId":"vndb:s115","sourcePersonId":"vndb:s115","canonicalEntityId":"vndb:s115","name":"児玉 さとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1119:197279:15954:1","source":"bangumi"}]},{"characterId":"char_vndb_c59508","characterName":"葦原 武流","sourceIds":{"vndbCharacterId":"c59508"},"originalCharacterName":"葦原 武流","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/3341c00b825cdec97c6c175017af1f38f43371b75e809f6298c8187a864bc641.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4dcb6ed1ab8be10c781db297acc74d06d953e2bb8d5583fbde9eda95325ae14b.webp","width":156,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p403","sourceCompanyId":"egs:brand:63","canonicalEntityId":"vndb:p403","name":"Escu:de","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:3342:63","source":"egs"},{"companyId":"vndb:p138","sourceCompanyId":"vndb:p138","canoni