{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"29247","model":{"presentationWorkId":"vndb:v28065","staff":{"artwork":[{"creditedName":"かん奈(岩本幸子、如月かん奈)","creatorId":"vndb:s4821","sourcePersonId":"egs:creator:232","canonicalEntityId":"vndb:s4821","name":"かん奈(岩本幸子、如月かん奈)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:216827","source":"egs"}],"scenario":[{"creditedName":"づか","creatorId":"vndb:s9838","sourcePersonId":"egs:creator:27056","canonicalEntityId":"vndb:s9838","name":"づか","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:216828","source":"egs"}],"music":[],"other":[{"creditedName":"かん奈","creatorId":"vndb:s4821","sourcePersonId":"vndb:s4821","canonicalEntityId":"vndb:s4821","name":"如月 かん奈","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:165193","source":"vndb"}]},"cast":[{"characterId":"char_c89632","characterName":"三住 唯織","sourceIds":{"bangumi":[{"characterId":"205782","match":"exact-normalized-name-in-linked-work","subjectId":"303922"}],"egsCharacterIds":["22603"],"vndbCharacterId":"c89632"},"originalCharacterName":"三住 唯織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Iori is the wife of the protagonist, Yuki, and is the same age as him. She has a gentle and kind personality, always supporting her husband and excelling in household chores. She is the epitome of an ideal wife, envied by those around her."},{"spoiler":false,"text":"However, having been raised with great care and affection by her parents, Iori has a slight tendency to be a sheltered princess. This has led to a certain naivety about the world's ways and a weakness when it comes to asserting herself."},{"spoiler":false,"text":"Translated and edited from Getchu"}],"source":"vndb","sourceCharacterId":"c89632"},{"segments":[{"spoiler":false,"text":"主人公・裕紀の妻。裕紀と同い年。"},{"spoiler":false,"text":"穏やかで優しい性格をしており、夫をよく立て家事も万能と、周りから羨まれる程の出来た妻。"},{"spoiler":false,"text":"ただ両親から大切に育てられてきたため、若干箱入り娘のきらいがあり、世間知らずで押しに弱いという側面もある。"}],"source":"egs","sourceCharacterId":"22603","sourceWorkId":"29247","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・裕紀の妻。裕紀と同い年。"},{"spoiler":false,"text":"穏やかで優しい性格をしており、夫をよく立て家事も万能と、周りから羨まれる程の出来た妻。"},{"spoiler":false,"text":"ただ両親から大切に育てられてきたため、若干箱入り娘のきらいがあり、世間知らずで押しに弱いという側面もある。"}],"source":"bangumi","sourceCharacterId":"205782"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57ecdebabc73bb33929bfbaa378304941587f9ac18178d88733dda51654b3974.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2e4a5c92bd8793f2b02f08d272aa81e0803dac60f15545986933c4b7722aa6d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤さくら","creatorId":"vndb:s947","sourcePersonId":"vndb:s947","canonicalEntityId":"vndb:s947","name":"花澤 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:303922:205782:17075:1","source":"bangumi"}]},{"characterId":"char_vndb_c109728","characterName":"桐山 遼","sourceIds":{"vndbCharacterId":"c109728"},"originalCharacterName":"桐山 遼","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A senior colleague at the company where the protagonist, Yuki, works. Ryou is one year older than Yuki and his peers."},{"spoiler":false,"text":"He has a bold and caring personality, which makes him popular among his juniors, including the protagonist. He is also competent at his job. While serving as Yuki's mentor, he consistently delivers excellent results himself."},{"spoiler":false,"text":"During Ryou's student years, he was heavily involved in sports. Even now, he maintains a well-built physique through regular exercise."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c109728"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9c1e0176244ec408de52d1757d606b990b3bdd0be2cc8bec2dd6880da0b23ac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7dbd4d118d6a06f94d1406cd8aa8d3352060ae2d11302b58e1516c44a2df765.webp","width":225,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c109729","characterName":"三住 裕紀","sourceIds":{"vndbCharacterId":"c109729"},"originalCharacterName":"三住 裕紀","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuki has been married for five years. He met his wife, Iori, through an arranged marriage and subsequently tied the knot."},{"spoiler":false,"text":"Currently, he works for a company owned by Iori's father, who is now his father-in-law."}],"source":"vndb","sourceCharacterId":"c109729"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88ee60db6df022e8f39b7f61a153894790d59cd79e5f11e1233148a96a4325b9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90996a1851bcc894766993339e3c0eed669584fa4959aed52382ca2c3984150c.webp","width":256,"height":144,"source":"static-detail"},"actors":[]}],"so