{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"14742","model":{"presentationWorkId":"vndb:v5744","staff":{"artwork":[{"creditedName":"ぺこ(かにビーム)","creatorId":"vndb:s1235","sourcePersonId":"egs:creator:1886","canonicalEntityId":"vndb:s1235","name":"ぺこ(かにビーム)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:92001","source":"egs"}],"scenario":[{"creditedName":"シナリオ制作チームさるさる","creatorId":"egs:creator:5656","sourcePersonId":"egs:creator:5656","canonicalEntityId":"egs:creator:5656","name":"シナリオ制作チームさるさる","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:273101","source":"egs"},{"creditedName":"佐野晋一郎","creatorId":"vndb:s1134","sourcePersonId":"egs:creator:2445","canonicalEntityId":"vndb:s1134","name":"佐野晋一郎","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:92002","source":"egs"}],"music":[{"creditedName":"RoundBoosterArchitexture","creatorId":"vndb:s34246","sourcePersonId":"egs:creator:16495","canonicalEntityId":"vndb:s34246","name":"RoundBoosterArchitexture","detail":"ED曲","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:101258","source":"egs"}],"other":[{"creditedName":"ぺこ","creatorId":"vndb:s1235","sourcePersonId":"vndb:s1235","canonicalEntityId":"vndb:s1235","name":"かにビーム","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:59364","source":"vndb"},{"creditedName":"本木 咲黒","creatorId":"vndb:s10077","sourcePersonId":"vndb:s10077","canonicalEntityId":"vndb:s10077","name":"本木 咲黒","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:59366","source":"vndb"}]},"cast":[{"characterId":"char_c3034","characterName":"蓬莱泉 瑠奈","sourceIds":{"bangumi":[{"characterId":"16615","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16615","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["564"],"vndbCharacterId":"c3034"},"originalCharacterName":"蓬莱泉 瑠奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"819"},"bust":{"reviewState":"source-only","source":"vndb","value":"70"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A fifth/sixth grade primary school student and recent transfer at St. Michael's. Smart, mature and highly charismatic for her age, Runa has won many fans in her class but she is very interested with her teacher Takako and declares she belongs to her."},{"spoiler":true,"text":"Runa harbors resentment over her older sister Rena, yet unseen in the story, who frequently leaves her alone while she goes out on business trips. Runa's older sister is Takako's former crush, which leads to the relationship between Runa and Takako once they meet for the first time in St. Michael's."},{"spoiler":false,"text":"Edit from Wikipedia"}],"source":"vndb","sourceCharacterId":"c3034"},{"segments":[{"spoiler":false,"text":"ミカ女初等部にやって来た転校生で貴子の恋人。"},{"spoiler":false,"text":"高圧的で高飛車な女王様タイプで、大人びた態度と物言いで、周囲を振り回す。"},{"spoiler":false,"text":"「せんせいはわたしのモノ」と公言してはばからず、そのくせ人の意見は聞かない自己中心的性格。"},{"spoiler":false,"text":"こと貴子に関してはかなりの嫉妬深さだが、直情的に激高するのではなく、静かに脅し文句を言う感じ。"},{"spoiler":false,"text":"基本的にサドっぽく、なにかと自分の都合の良い様に解釈しては、Ｓっぽく婉然と微笑む。"}],"source":"egs","sourceCharacterId":"564","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"ミカ女附属の中等部１年生で貴子の恋人。高圧的で高飛車な女王様タイプで、大人びた態度と物言いで周囲を振り回す。"},{"spoiler":false,"text":"「せんせいはわたしのモノ」と公言してはばからず、そのくせ人の意見は聞かない自己中心的性格。"},{"spoiler":false,"text":"基本的にドエスで、なにかと自分の都合の良い様に解釈しては、婉然と微笑む女王様体質。"},{"spoiler":false,"text":"中等部に進学するも、相変わらずのリーダーシップとカリスマで、クラスに君臨している模様。"}],"source":"egs","sourceCharacterId":"564","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"初等部六年级学生（网络小说版为五年级），得知贵子是姊姊唯一保持柏拉图关系的学妹后，为接近她而回到日本转读米卡女校。表面上是高傲任性而嗜虐的女王型性格，面对身分和年龄差极大的贵子仍公然宣布“老师属于我的”…游戏版设定上回日本和贵子同居前处于独居状态，某程度是全主角中家庭环境最恶劣的一人。就连有如遗传的天才级学力、领导才能及待人处事方式也是她努力学会，精神年龄和外表相反地非常成熟，只有和贵子独处时生活习惯才会像一名约10岁的小孩。"},{"spoiler":false,"text":"对贵子的称呼是“老师”，但文字上有如为了显出年龄和性格特征而用平假名的“せんせい”。身材数值全是比玲绪略高。"},{"spoiler":false,"text":"声：上田幸姫 (bgm.tv查不到…)"}],"source":"bangumi","sourceCharacterId":"16615"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/3098e41418d49626603a9853cb34ab3521017294614dbb76d66addd1e2e303c9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/eceb8ec46ed1ba1ac5df106f24be44f18d28e81f712dc0b36566ff2abbec9b9c.webp","width":90,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:45069:16615:5052:1","source":"bangumi"}]},{"characterId":"char_c3035","characterName":"墨廼江 貴子","sourceIds":{"bangumi":[{"characterId":"16614","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16614","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["563"],"vndbCharacterId":"c3035"},"originalCharacterName":"墨廼江 貴子","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"316"},"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A former graduate of St. Michael's who is now a teacher at the school's primary division. Takako is very embarrassed that Runa can easily dominate her while stealing her first kiss."},{"spoiler":true,"text":"She was once in love with Runa's older sister, Rena."},{"spoiler":false,"text":"Edit from Wikipedia"}],"source":"vndb","sourceCharacterId":"c3035"},{"segments":[{"spoiler":false,"text":"「聖ミカエル女子学園、初等部の教師。"},{"spoiler":false,"text":"キャリア数年目にして初担任を持ち、教え子の瑠奈とは恋人同士。"},{"spoiler":false,"text":"現在瑠奈とは同棲中で、大人としてあれこれ子供らしい振る舞いを教えようとするも、逆に振り回されっぱなし。"},{"spoiler":false,"text":"とはいえ押しの強い瑠奈に迫られ悪い気はせず、瑠奈の外見、高貴な立ち振る舞いに見惚れる事しばし。"},{"spoiler":false,"text":"むしろカミングアウトしたい気持ちを「あの娘は私の教え子なのよ～っ!?」と必死に堪えている。"}],"source":"egs","sourceCharacterId":"563","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"「聖ミカエル女子学園、附属部の教師。かつての教え子の瑠奈とは恋人同士。"},{"spoiler":false,"text":"今も瑠奈とは同棲中で、大人としてあれこれ子供らしい振る舞いを教えようとするも、逆に振り回されっぱなし。"},{"spoiler":false,"text":"とはいえ押しの強い瑠奈に迫られ悪い気はせず、瑠奈の外見、高貴な立ち振る舞いに見惚れる事しばし。"},{"spoiler":false,"text":"瑠奈の進学に伴い担任から外れてしまったが、その分私生活でべったりになってしまっている模様。"}],"source":"egs","sourceCharacterId":"563","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"曾是米卡女校旧生的初等部教师，初时性格懦弱而冒失。被神秘转校生琉奈突然吻过后，虽被她玩弄于鼓掌中，但又对她一见钟情。后来得知琉奈就是贵子学生时代单恋的学姊的妹妹…二人关系有进展以后，贵子对琉奈的称呼视乎场合为“蓬莱泉同学”或“琉奈”，不过对琉奈愈来愈着迷的贵子于第九作课堂剧情中时常差点直说名字。"},{"spoiler":false,"text":"声：あずまゆい (bgm.tv查不到…)"}],"source":"bangumi","sourceCharacterId":"16614"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8fa62f56161dd3b6ad88731dbf167c850d53479fa990761298540be1b8d56c8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/3621ac91c48ecd6970279b9ca5b821e8197b1df663aa508d0dd1451136d02322.webp","width":87,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阿久津加菜","creatorId":"vndb:s75","sourcePersonId":"vndb:s75","canonicalEntityId":"vndb:s75","name":"阿久津 加菜","roleCode":"voi