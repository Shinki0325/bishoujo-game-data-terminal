rId":"2040","sourceWorkId":"19131","spoiler":false},{"segments":[{"spoiler":false,"text":"やや掴み所のない 『桜花会』 前書記。"},{"spoiler":false,"text":"何でもそつなくこなす、すべてにおいて10点満点中8点を取るタイプ。"},{"spoiler":false,"text":"たまたま落し物を拾ってくれた祐里に目を付け、自分の後釜として 『桜花会』 に入会させる。"},{"spoiler":false,"text":"当の祐里も最初こそ驚いたものの、珠音の性格の良さもあって完璧に丸め込まれている。"},{"spoiler":false,"text":"聖曰く 「油断できないクラゲ」。"},{"spoiler":false,"text":"引退後もよく 『桜花館』 に出没してお茶をすすっている。"},{"spoiler":false,"text":"「だました訳じゃないわよ？　ひらめいただけなの」"}],"source":"bangumi","sourceCharacterId":"139956"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e19b0908a2fcd7f286ddb706dd88197e33b51a5d5c713aaa6f1fce89b8ff80b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0dbb5cd6930d04e707b0d54894c6dfad236398cd3648775a54837a93a261ae23.webp","width":95,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩﨑春奈","creatorId":"vndb:s878","sourcePersonId":"vndb:s878","canonicalEntityId":"vndb:s878","name":"岩﨑 春奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:77214:139956:11648:1","source":"bangumi"}]},{"characterId":"char_c15092","characterName":"堺 浩一","sourceIds":{"bangumi":[{"characterId":"139957","match":"exact-normalized-name-in-linked-work","subjectId":"77214"}],"egsCharacterIds":["2041"],"vndbCharacterId":"c15092"},"originalCharacterName":"堺 浩一","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"葵の菊花学園でのクラスメイト。"},{"spoiler":false,"text":"転入したての葵にも気さくに声を掛けてくれて何かと親切にしてくれる。"},{"spoiler":false,"text":"勉強、運動共に平均的。"},{"spoiler":false,"text":"性格はお調子者で割とバカだけどとにかくノリがよく、ムードメーカーでみんなから「あいつはいいヤツだ」と"},{"spoiler":false,"text":"認識されている。"},{"spoiler":false,"text":"なので、まわりが「浩一だから仕方ない」と助けてくれる。"},{"spoiler":false,"text":"女の子が大好きで桜花の女子とお近づきになりたい！"},{"spoiler":false,"text":"と思っているが、実現できていない。"},{"spoiler":false,"text":"「隣になったのも何かの縁だし、"},{"spoiler":false,"text":"分からないことがあったら聞いてくれ。"},{"spoiler":false,"text":"これからよろしくな！」"}],"source":"egs","sourceCharacterId":"2041","sourceWorkId":"19131","spoiler":false},{"segments":[{"spoiler":false,"text":"葵の菊花学園でのクラスメイト。"},{"spoiler":false,"text":"転入したての葵にも気さくに声を掛けてくれて、なにかと親切にしてくれる。"},{"spoiler":false,"text":"勉強・運動共に平均的。"},{"spoiler":false,"text":"性格はお調子者でわりとバカだけど、とにかくノリが良いムードメーカーで、みんなから 「あいつはいいヤツだ」 と認識されている。"},{"spoiler":false,"text":"なので、周りが 「浩一だから仕方ない」 と助けてくれる。"},{"spoiler":false,"text":"女の子が大好きで、桜花の女子とお近づきになりたい！ と思っているが、実現できていない。"},{"spoiler":false,"text":"「隣になったのも何かの縁だし、分からないことがあったら聞いてくれ。これからよろしくな！」"}],"source":"bangumi","sourceCharacterId":"139957"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca71f6bedbeb25a1610871422008b173d5c2128e9dbd9a0355a524bcd6821a6a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21f8e96c65064f7d3236c39145bbabd586ba8bc04a1c11a8481a9ddf003fc7f4.webp","width":82,"height":256,"source":"static-detail"},"actors":[{"creditedName":"葵 海人","creatorId":"vndb:s4264","sourcePersonId":"vndb:s4264","canonicalEntityId":"vndb:s4264","name":"葵 海人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53965","source":"vndb"}]},{"characterId":"char_c15093","characterName":"佐々原 亮子","sourceIds":{"bangumi":[{"characterId":"139958","match":"exact-normalized-name-in-linked-work","subjectId":"77214"}],"egsCharacterIds":["2042"],"vndbCharacterId":"c15093"},"originalCharacterName":"佐々原 亮子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"桜花女子が暮らす『桜花寮』の寮母さん。"},{"spoiler":false,"text":"みんなの相談にも乗ってくれたり、食事の世話などもやってくれるので、寮生からは「お母さん」のように慕われている。"},{"spoiler":false,"text":"元々は桜花の卒業生で、そう言った所で葵や祐里に桜花のことを教えてくれる頼れる存在。"},{"spoiler":false,"text":"料理が上手い。"},{"spoiler":false,"text":"年齢は聞いてはいけない。"},{"spoiler":false,"text":"「祐里ちゃんと葵ちゃんね。はい、覚えました」"}],"source":"egs","sourceCharacterId":"2042","sourceWorkId":"19131","spoiler":false},{"segments":[{"spoiler":false,"text":"桜花女子が暮らす 『桜花寮』 の寮母さん。"},{"spoiler":false,"text":"食事の世話や、みんなの相談にも乗ってくれるので、寮生からは “お母さん” のように慕われている。"},{"spoiler":false,"text":"元々は桜花の卒業生で、葵や祐里に桜花のことを教えてくれる頼れる存在。"},{"spoiler":false,"text":"料理が上手い。"},{"spoiler":false,"text":"年齢は聞いてはいけない。"},{"spoiler":false,"text":"「祐里ちゃんと葵ちゃんね。 はい、覚えました」"}],"source":"bangumi","sourceCharacterId":"139958"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1eeb32d8de5f6af0620f84132507f448058d3e9ea6c4949a58cdbb758492e5f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08b609198a83e3637df6c64872aa2ac02196977861a637647846fc5d27427125.webp","width":78,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:77214:139958:4646:1","source":"bangumi"}]},{"characterId":"char_vndb_c15094","characterName":"双葉 沙那子","sourceIds":{"vndbCharacterId":"c15094"},"originalCharacterName":"双葉 沙那子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d555919c4ede0499371f9068d362a7bac1bf0c4ccd