ityStatus":"source-native","relationId":"vndb:vn-staff:153234","source":"vndb"}],"other":[{"creditedName":"黒井弘騎","creatorId":"vndb:s6852","sourcePersonId":"egs:creator:5442","canonicalEntityId":"vndb:s6852","name":"黒井弘騎","detail":"原作","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:209678","source":"egs"},{"creditedName":"黒井 弘騎","creatorId":"vndb:s6852","sourcePersonId":"vndb:s6852","canonicalEntityId":"vndb:s6852","name":"黒井 弘騎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:153231","source":"vndb"},{"creditedName":"うし子","creatorId":"vndb:s2810","sourcePersonId":"vndb:s2810","canonicalEntityId":"vndb:s2810","name":"ウシ子","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:153233","source":"vndb"}]},"cast":[{"characterId":"char_c59203","characterName":"エデンズリッター・ルシフェル","sourceIds":{"bangumi":[{"characterId":"51857","match":"exact-normalized-name-in-linked-work","subjectId":"210493"}],"egsCharacterIds":["13221"],"vndbCharacterId":"c59203"},"originalCharacterName":"エデンズリッター・ルシフェル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"105"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"M"},"hip":{"reviewState":"source-only","source":"vndb","value":"96"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"As heir to the throne and royal priestess of the Elleraldian faith, Cecily is a well-loved and well-endowed figurehead of her kingdom. Though she cares deeply for her people and wishes to help them in any way she can, she secretly resents her own weakness and envies the brave warrior Noein. Seizing the chance to gain power and defend her subjects, she becomes Eden’s Ritter Lucifel, a powerful magic-wielding warrior. But due to the forbidden nature of her new abilities, she must keep her identity a secret from the people she has sworn to protect."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c59203"},{"segments":[{"spoiler":false,"text":"生まれながらにして大いなる神の加護を受けた聖女であり、数々の奇跡を起こしてきた。"},{"spoiler":false,"text":"特に癒やしの奇跡に長けていて、身分に関係なく人々を救っているが、奇跡の行使は肉体にも大きな負担をかけるため、一日に使える回数が決まっている。"},{"spoiler":false,"text":"おっとりとして優しい性格で、若干世間知らずで天然気味なところもある。"},{"spoiler":false,"text":"一見気が弱そうだが正義感が強く、正しいと思ったことは決して曲げない。"},{"spoiler":false,"text":"姫として優雅な気品を持ちながら、身分に関係なく分け隔てなく接する性格と美しい外見から、国民全員から愛されている。"}],"source":"egs","sourceCharacterId":"13221","sourceWorkId":"24422","spoiler":false},{"segments":[{"spoiler":false,"text":"エルアラド聖王国の第一王女。善良な性格とその外見から、全国民より愛されている。"},{"spoiler":false,"text":"また生まれながらに神の加護を受けた聖女であり、数々の癒やしの奇跡を施してきた。"},{"spoiler":false,"text":"ただ奇跡は一日に使える回数が決まっているため、彼女はこれを歯がゆく感じている。"},{"spoiler":false,"text":"神樹セフィロトから力を授かり、エデンズリッター・ルシフェルに変身する。"},{"spoiler":false,"text":"禁断の知識による強力な攻撃魔法を自在に行使し、槍での接近戦も可能となる。"},{"spoiler":false,"text":"弱点となる聖痕はその巨乳に刻まれ、感度が何倍にもなっている。"}],"source":"bangumi","sourceCharacterId":"51857"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/486d4d08eda2d465e74f26d516a8b67021e243c9bf214f0a961b1b9ff6d00417.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5af228d7bd6a7b1e8a241870d9134158cb28594646b7053b2c3ebf228773f55c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:289905:51857:6359:1","source":"bangumi"}]},{"characterId":"char_c59204","characterName":"エデンズリッター・アシュタロス","sourceIds":{"bangumi":[{"characterId":"51858","match":"exact-normalized-name-in-linked-work","subjectId":"210493"}],"egsCharacterIds":["13222"],"vndbCharacterId":"c59204"},"originalCharacterName":"エデンズリッター・アシュタロス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"99"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"hip":{"reviewState":"source-only","source":"vndb","value":"101"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"64"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The leader of the Holy Guard, Noein is a hardened war veteran, adored by people far and wide. Not only has she devoted her blade to Princess Cecily, but the two have been close friends since childhood; to this day, to this knight, no sacrifice is too great to protect her princess. As the bulwark and buttress of the capital's defenses, her reluctant absence has left a gaping hole. How long can the city stand until she makes her return? And will her sword alone suffice for her to safeguard what she loves?"},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c59204"},{"segments":[{"spoiler":false,"text":"セシリィの従者である神聖騎士。"},{"spoiler":false,"text":"堅物で生真面目な性格で、騎士道を重んじる。"},{"spoiler":false,"text":"自他ともに厳しく、凜々しい性格だが、姫だけにはベタ甘な一面がある。セシリィが幼少の頃からともにあり、セシリィにとっては実の姉のような存在。剣の腕は王国一とも言われ、人間でありながら淫魔と同等以上に戦う力を持つ。"},{"spoiler":false,"text":"魔法の才に恵まれず魔法は使えないが、それでも淫魔に通用する剣の腕を持つ。"},{"spoiler":false,"text":"おっとりとしたセシリィと対極的な、凜々しくクールな外見の美少女。"},{"spoiler":false,"text":"凜とした佇まいは男女問わず人気が高い。"}],"source":"egs","sourceCharacterId":"13222","sourceWorkId":"24422","spoiler":false},{"segments":[{"spoiler":false,"text":"セシリィの従者である神聖騎士。 セシリィにとっては実の姉のような存在。"},{"spoiler":false,"text":"騎士道を重んじる生真面目な性格で、自他ともに厳しいが、セシリィだけにはベタ甘。"},{"spoiler":false,"text":"剣の腕は王国一とも言われ、魔法は使えないが淫魔と同等以上に戦う力を持つ。"},{"spoiler":false,"text":"セシリィの事情を知り、彼女も力を分け与えられて変身できるようになる。"},{"spoiler":false,"text":"魔法による攻撃はできないが、魔力を剣に乗せた魔法剣で戦う。"},{"spoiler":false,"text":"聖痕は性器以外の穴が性器以上の感度になってしまうというもので普段の生活にも影響を及ぼすが、必死に耐え忍び周囲には気取らせない。"}],"source":"bangumi","sourceCharacterId":"51858"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57d7f3582f68fab4a6933546909850eb56c17c896f0559fcd4a5d87045323568.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb48c2fc2bd1a396bc1b3e578065d634456a36cc551053ccbeefb1a5f16ddb62.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:289905:51858:8580:1","source":"bangumi"}]},{"characterId":"char_c85122","characterName":"ヒルデガルド","sourceIds":{"bangumi":[],"egsCharacterIds":["22618"],"vndbCharacterId":"c85122"},"originalCharacterName":"ヒルデガルド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"66"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"hip":{"reviewState":"source-only","source":"vndb","value":"71"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Adult Bust Size: 99 (K cup)"},{"spoiler":false,"text":"Adult Waist Size: 61"},{"spoiler":false,"text":"Adult Hip Size: 95"}],"source":"vndb","sourceCharacterId":"c85122"},{"segments":[{"spoiler":false,"text":"「竜皇女」の異名を持つ、神聖ガルベリア皇国の女皇帝。"},{"spoiler":false,"text":"ゼノバイド教団との戦いで国民全てと最愛の女性ミレイユを失うも、憎悪と狂気に裏打ちされた強靭な意志力で皇国を再建。"},{"spoiler":false,"text":"もはや屍兵と淫魔の巣窟と化した皇国の帝として、全世界に宣戦を布告する。"},{"spoiler":false,"text":"魔王と化したかつての英雄が歩むのは高潔なる覇道ではなく、狂気に彩られた魔道。その目的は世界の支配ではなく、破壊である。"}],"source":"egs","sourceCharacterId":"22618","sourceWorkId":"29415","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8ae9b73d85c2ae74ba22d87537a97130338be135aac9f99f02dd312a6d2e75ce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33c91ebc954169176ecbd011c7cbf7794da9ea7a8e433ff4a0d9e94cd6cb0c0b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"千歳 百合花","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:79639","source":"vndb"}]},{"characterId":"char_c85123","characterName":"ルーティア","sourceIds":{"bangumi":[],"egsCharacterIds":["22620"],"vndbCharacterId":"c85123"},"originalCharacterName":"ルーティア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"98"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"I"},"hip":{"reviewState":"source-only","source":"vndb","value":"98"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"エルフの王国シルマリルの王女にして、楽園の騎士エデンズリッターの一人。"},{"spoiler":false,"text":"かつてヒルデガルドと共に戦った戦友であり、お互いに認めあい理解しあえる、数少ない対等な親友同士であった。"},{"spoiler":false,"text":"現在シルマリルはガルベリアの侵略を受けており、ルーティアは最前線に立ち徹底抗戦を続けている。"},{"spoiler":false,"text":"魔王に堕ち果てたかつての盟友ヒルデガルドに対し「お前が道を誤った時には、わたしがお前を止める」という約束を果たすべく、決死の覚悟で戦いを挑む。"}],"source":"egs","sourceCharacterId":"22620","sourceWorkId":"29415","spoiler":false}],"profileFacts":[],"metadataCandidateConfl