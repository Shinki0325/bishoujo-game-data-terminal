te":"no-conflict","source":"egs","value":"10/3"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"神魔界と呼ばれる異世界のお姫様。主人公とは同い年、2年E組。"},{"spoiler":false,"text":"“神魔界の至宝”と謳われる絶世の美少女で、プロポーションも完璧。非の打ち所のないレディ。"},{"spoiler":false,"text":"主人公とは幼い頃に一度だけ会ったことがあり、その時の思い出を大切にしている。"},{"spoiler":false,"text":"主人公と再会したくて、こちらの世界へやって来た。"},{"spoiler":false,"text":"黙っていても高貴な気品が漂うが、人当たりはとても柔らかい。"},{"spoiler":false,"text":"「いつか、また、会えると信じていました。いつか……きっと」"}],"source":"egs","sourceCharacterId":"16264","sourceWorkId":"11557","spoiler":false},{"segments":[{"spoiler":false,"text":"被称为神魔界的异世界的公主殿下。"},{"spoiler":false,"text":"与主人公同年，励学馆学园2年E组。"},{"spoiler":false,"text":"被讴歌赞美为“神魔界的至宝”的绝世美少女，身材也很完美。毫无缺点的淑女。"},{"spoiler":false,"text":"与主人公在幼时曾经见过一次面，将当时的回忆当作珍宝一般珍藏着。"},{"spoiler":false,"text":"想要与主人公再会，来到了这个世界。"},{"spoiler":false,"text":"即使默不作声也洋溢着高贵的气质，待人接物十分柔和。"}],"source":"bangumi","sourceCharacterId":"12145"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"16264","sourceWorkId":"11557","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"16264","sourceWorkId":"11557","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"16264","sourceWorkId":"11557","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"16264","sourceWorkId":"11557","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"16264","sourceWorkId":"11557","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b37ac489b793750d9228f273a76f72f304e64dc0c7bbe7e45b50c19a5e77dbd9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e2fa9e9ff7e47785151a27083a10543cac9c98cbee8c15144dda2838e473ec5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結下みちる","creatorId":"vndb:s794","sourcePersonId":"vndb:s794","canonicalEntityId":"vndb:s794","name":"結下 みちる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:4068:12145:4705:1","source":"bangumi"}]},{"characterId":"char_c34279","characterName":"ニースライト・ヒースラヴァー","sourceIds":{"bangumi":[{"characterId":"12146","match":"exact-normalized-name-in-linked-work","subjectId":"4068"}],"egsCharacterIds":["16265"],"vndbCharacterId":"c34279"},"originalCharacterName":"ニースライト・ヒースラヴァー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"1/22"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"シェーラの実の妹で一つ年下、1年B組。"},{"spoiler":false,"text":"やや憂いを帯びた表情が儚げな印象を与えるが、見目麗しさでは姉に勝るとも劣らない。"},{"spoiler":false,"text":"主人公と幼い頃に交流を持ったことがあるが、彼女はそれを否定する。"},{"spoiler":false,"text":"よそよそしい態度を取っているが、無意識のうちに視線はいつも主人公の姿を追っている。"},{"spoiler":false,"text":"他の女の子と仲良くしているときなど、目に見えてプンプンしている。"},{"spoiler":false,"text":"「知りません。……あなたのことなんか」"}],"source":"egs","sourceCharacterId":"16265","sourceWorkId":"11557","spoiler":false},{"segments":[{"spoiler":false,"text":"比シェーラ小一岁的亲妹妹，励学馆学园1年B组。"},{"spoiler":false,"text":"略带忧郁的表情给人如梦如幻的印象，但在容貌美丽方面与姐姐不相伯仲。"},{"spoiler":false,"text":"与主人公在幼时曾经有过交流，但她却否定了那段往事，采取了疏远的态度。"},{"spoiler":false,"text":"然而视线却在无意识之间追寻着主人公的身姿，主人公一与其他女孩子交好，就很显然有些恼怒。"}],"source":"bangumi","sourceCharacterId":"12146"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"16265","sourceWorkId":"11557","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"16265","sourceWorkId":"11557","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"16265","sourceWorkId":"11557","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"16265","sourceWorkId":"11557","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"16265","sourceWorkId":"11557","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/046bbd238650f2e23e2002363fb9100c31b447f412ccfcaa61c05ea78323ce40.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c96a30400ae03be653dec7fd88bc3e8ade41a435d8e6e7ccfd1fcb4a4d3b9e3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:4068:12146:4432:1","source":"bangumi"}]},{"characterId":"char_c34280","characterName":"宮崎 由紀菜","sourceIds":{"bangumi":[{"characterId":"12147","match":"exact-normalized-name-in-linked-work","subjectId":"4068"}],"egsCharacterIds":["16266"],"vndbCharacterId":"c34280"},"originalCharacterName":"宮崎 由紀菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"3/16"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼なじみ。2年E組。"},{"spoiler":false,"text":"歳も同じということで、これまで主人公の一番身近にいたが、シェーラやニースの登場によってヤキモキさせられているとか。"},{"spoiler":false,"text":"持ち前の明るい気性がそんなことを窺わせないが、両親に捨てられたという暗い過去を持つ。"},{"spoiler":false,"text":"そんな由紀菜にとって、主人公の存在は何より大切なものだった。"},{"spoiler":false,"text":"「命の恩人って、どれだけの存在なんだろうねぇ？……恋人以上だったりして！」"}],"source":"egs","sourceCharacterId":"16266","sourceWorkId":"11557","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的青梅竹马，励学馆学园2年E組。"},{"spoiler":false,"text":"而且还是同岁，至今为止离主人公最近的一个人，但因为シェーラ与ニース的登场而吃了不少干醋。"},{"spoiler":false,"text":"在咖啡店『Ravage・de・Cool』里打工，穿着制服时的可爱姿态得到了附近人们的好评。"},{"spoiler":false,"text":"虽然从她天生的开朗性情中看不出来，有着被双亲抛弃的黑暗过去。"},{"spoiler":false,"text":"对这样的由紀菜来说，主人公的存在是无比重要的。"}],"source":"bangumi","sourceCharacterId":"12147"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"16266","sourceWorkId":"11557","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"16266","sourceWorkId":"11557","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"1626