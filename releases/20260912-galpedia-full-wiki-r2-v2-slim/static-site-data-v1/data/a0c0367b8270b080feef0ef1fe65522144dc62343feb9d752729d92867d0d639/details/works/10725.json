":[{"characterId":"char_vndb_c114790","characterName":"結城","sourceIds":{"vndbCharacterId":"c114790"},"originalCharacterName":"結城","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mysterious and beautiful girl? Self-proclaimed eternal 17 year old"},{"spoiler":false,"text":"She is a part-time teacher at Ginka Daiichi Gakuen, where Yuichi attends."},{"spoiler":false,"text":"She appears to be a girl of her generation dressed in a gothic lolita fashion, but the details are not clear."},{"spoiler":false,"text":"She says that her job is to provide \"shallow and narrow\" explanations about consumer dolls, from their origins to their mechanisms, and even about their existence from a global perspective,\" which is actually appropriate."},{"spoiler":false,"text":"However, every word she says is meaningful, and it seems that she is not just saying and doing meaningless things."},{"spoiler":false,"text":"For Yuuichi and his classmates, her thinking is too sophisticated for them to follow."},{"spoiler":false,"text":"From Pikopiko's official website"},{"spoiler":false,"text":"Voiced by: 海野砂夜 (Unno Sunaya/ Umino Sunayo?)"}],"source":"vndb","sourceCharacterId":"c114790"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b545fe05d264019e33e40fc3019d85c445d0c487da2bd119042601989703598a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f20f7b8891719bf0f6f599c0ab460e05b8097a745a4153584c5c0323a270981b.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c120224","characterName":"Seven","sourceIds":{"vndbCharacterId":"c120224"},"originalCharacterName":"Seven","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nana's alter ego. She is the villain of Nana's route."}],"source":"vndb","sourceCharacterId":"c120224"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3aa17632b3f85a03a054df51a946f647af7d43c3a44357e997fa56406584afb3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71df45f5d2c4c6a049031b575c73d7b4b81df3a0fa3772d3442f70104e80400c.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c33018","characterName":"獅堂 勇一","sourceIds":{"vndbCharacterId":"c33018"},"originalCharacterName":"獅堂 勇一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"614"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main character of this work."},{"spoiler":false,"text":"His parents died when he was young, and he was raised by his grandparents."},{"spoiler":false,"text":"His father was an engineer at a video game manufacturer, and he is trying to follow in his father's footsteps."},{"spoiler":false,"text":"Compared to his classmates, he is a bit childish, and is quick to say or do what he thinks."},{"spoiler":false,"text":"He is also prone to emotional outbursts."},{"spoiler":false,"text":"However, he has a strong sense of duty and humanity, and his strong desire to take care of his fellow students attracts many friends around him."},{"spoiler":false,"text":"He is passionate about doll battles, so much so that he accidentally destroyed his favorite doll, \"Yukiko,\" by modifying it. He is also quite skilled, but his fighting style is quite aggressive."},{"spoiler":false,"text":"He puts priority on what he wants to do at the moment rather than winning solidly, which often leads to him being easily cornered and rushing out to win."},{"spoiler":false,"text":"From Pikopiko's official website"}],"source":"vndb","sourceCharacterId":"c33018"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30ec293d84ce7619911731bacb8484c084ccdb6d377cb0c34609ed31062606f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/933f2bbedad16c22721913e3d972484d33cf1775acae9075ad5268e4e6a18809.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"星川 未流来","creatorId":"vndb:s1116","sourcePersonId":"vndb:s1116","canonicalEntityId":"vndb:s1116","name":"原田 ひとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7989","source":"vndb"}]},{"characterId":"char_vndb_c33019","characterName":"ミコ","sourceIds":{"vndbCharacterId":"c33019"},"originalCharacterName":"ミコ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"715"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The world's first humanoid home video game machine (consumer doll) created by \"Ninkyodo\"!"},{"spoiler":false,"text":"Ninkyodora"},{"spoiler":false,"text":"Family Game-Noid\" created by Ninkyodo Co."},{"spoiler":false,"text":"The world's first humanoid home video game console, \"Family GameNoid,\" was marketed by Ninkyodo Co. Along with the male \"Family Gameroid,\" it has several common names, including \"Fami-Robo\" and \"Fami-Gero,\" but the most established is \"Biko-Biko."},{"spoiler":false,"text":"Miko was brought home by Yuuichi's late father when he was a child, and he had taken care of it for a while."},{"spoiler":false,"text":"However, after his father's death, Miko had been kept in the back of the closet for more than ten years, and Yuuichi had forgotten about its existence."},{"spoiler":false,"text":"She is a positive, hardworking person, but her motivation often goes awry."},{"spoiler":false,"text":"She may be too old and out of shape, or she may say or do things that are not right even though she is a Gamebot."},{"spoiler":false,"text":"From Pikopiko's official website"}],"source":"vndb","sourceCharacterId":"c33019"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/ddacffcb4c0601d5d0e80256808121a4565fe9db09238d96535b5747b12f7e00.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/551e5ea041745ee71943b681a434bf015292e1827db03e3062d39ad3f76c3969.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安玖深 音","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7983","source":"vndb"}]},{"characterId":"char_vndb_c33020","characterName":"ユキコ","sourceIds":{"vndbCharacterId":"c33020"},"originalCharacterName":"ユキコ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1202"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The quintessence of maid's game machine is here!"},{"spoiler":false,"text":"The latest consumer doll released by Ninkendo Co."},{"spoiler":false,"text":"YUU\" is a coined word. The etymology of the word \"YUU\" is \"You,\" \"Yu,\" \"You,\" and \"The letter U represents the smile of a family."},{"spoiler":false,"text":"The concept is \"We take care of your family's health! the YUU is designed not only to be a game console, but also to provide a full range of functions to help with cooking, cleaning, laundry, and other tasks."},{"spoiler":false,"text":"Of course, YUU is just as professional as a professional in taking care of health, including nutritional management and house dust control, and many households even let her manage the household finances."},{"spoiler":false,"text":"These features have been a big hit for YUU."},{"spoiler":false,"text":"Rival machine Presta 7 is on the offensive, but it seems unlikely that it will be able to keep up with the competition."},{"spoiler":false,"text":"From Pikopiko's official website"}],"source":"vndb","sourceCharacterId":"c33020"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/700908aa8dc9127b4aad61211576ef6f4931d220510c4c35a2f2512336a36015.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3658b506cd7c918d2f0d7bd8cdf6a7a339a5f20f906dfc2dbc4246da73a95fe.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西野 みく","creatorId":"vndb:s797","sourcePersonId":"vndb:s797","canonicalEntityId":"vndb:s797","name":"永田依子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7986","source":"vndb"}]},{"characterId":"char_vndb_c33022","characterName":"高見沢 翔","sourceIds":{"vndbCharacterId":"c33022"},"originalCharacterName":"高見沢 翔","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1228"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuichi and him are good rivals. However, one day..."},{"spoiler":false,"text":"A classmate and battle rival who picks on Yuichi in any way he can."},{"spoiler":false,"text":"They are somewhat at odds with each other and bicker about everything, but they don't seem to really dislike each other because they are always on the same page."},{"spoiler":false,"text":"His father is a renowned engineer genius, and was involved in the development of the AI for Shou's beloved machine \"Nana\"."},{"spoiler":false,"text":"Perhaps it is because he grew up in a family environment with a father who was devoted to research and had no regard for his family, and a mother who suffered from mental illness, that he unknowingly becomes harsh towards Nana, the product of his father's research."},{"spoiler":false,"text":"He has a younger sister whom he loves dearly and must protect."},{"spoiler":false,"text":"From Pikopiko's official website"}],"source":"vndb","sourceCharacterId":"c33022"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60d38c1042fd37371d8b121d5451e92fa4854a5fe56af7199adf72842c4dd3b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05661e9224c329f8ba87ac61b17e8e26f6d0192462691f81c5b3052c39ec0ec7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紀之","creatorId":"vndb:s15","sourcePersonId":"vndb:s15","canonicalEntityId":"vndb:s15","name":"杉山 紀彰","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7981","source":"vndb"}]},{"characterId":"char_vndb_c33024","characterName":"ナナ","sourceIds":{"vndbCharacterId":"c33024"},"originalCharacterName":"ナナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1203"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Potential is unquestionable! The latest model with ultra-high specs"},{"spoiler":false,"text":"The latest and seventh generation of the \"PLAYSTALLION\" series of consumer dolls released by NCE."},{"spoiler":false,"text":"It uses a newly developed high-performance processor for its CPU, and its potential is unrivaled."},{"spoiler":false,"text":"Thanks to this processor, \"Presta 7\" can be customized in detail, even in terms of AI personality settings."},{"spoiler":false,"text":"The Presta 7 is also a luxurious product, with state-of-the-art technology used throughout, but it is also very expensive."},{"spoiler":false,"text":"The name \"Nana\" was given by the master, Shou, who was unintentionally harsh to Nana because her father, who was involved in the development of Nana's AI, was devoted to research and did not care about his family."},{"spoiler":false,"text":"Even though Nana knows that Shou hates her, she does not know how to be sad, and since her raison d'etre is to serve others, she follows orders calmly and precisely."},{"spoiler":false,"text":"From Pikopiko's official website"}],"source":"vndb","sourceCharacterId":"c33024"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb1c834e4c1f3995f482cdd6a3aab1a4696b71b43e6bac3da341f2c641f32e3c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a17cae4deb37ccba5a22a0907303f72a1a58d6e55a150874d85d7bca3c47f7d7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村 あやか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7984","source":"vndb"}]},{"characterId":"char_vndb_c33026","characterName":"有川 蓮","sourceIds":{"vndbCharacterId":"c33026"},"originalCharacterName":"有川 蓮","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"609"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Unidentified beautiful girl (?) character"},{"spoiler":false,"text":"He is one year younger than Yuuichi and is also a distant relative."},{"spoiler":false,"text":"He looks like a girl, but she is a proper boy, with a calm personality, homely and single-minded."},{"spoiler":false,"text":"His family runs a game shop where Yuuichi and Shou go to."},{"spoiler":false,"text":"From Pikopiko's official website"}],"source":"vndb","sourceCharacterId":"c33026"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f2f8d999849892fdc2ebfbcc9d1160c556cea7018843a10025bd6776a34ff46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df3fafa46afa63bfa5b712cc0887d26260d7b43f7dd0553880dd23e636febbff.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みる","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7982","source":"vndb"}]},{"characterId":"char_vndb_c33027","characterName":"ピピ","sourceIds":{"vndbCharacterId":"c33027"},"originalCharacterName":"ピピ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"421"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ninkendo's portable type"},{"spoiler":false,"text":"The latest type of consumer doll!"},{"spoiler":false,"text":"It is the latest model of portable consumer doll made by Ninkendo Co., Ltd. and released by 'Portable Consumer Doll.'"},{"spoiler":false,"text":"The software lineup includes an electronic dictionary, cooking guide, brain training, and learning software. The AI's thinking is basically that of a genius or a doctor with the personality of a little sassy girl who likes to talk a lot of nonsense."},{"spoiler":false,"text":"From Pikopiko's official website"}],"source":"vndb","sourceCharacterId":"c33027"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f75a1de34aa210bc8a4684670f5496636543afd45f3f2ec49f8b249e1884980.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc507d93f60a980bf59156d39da621cfa81dbd4ca39ca1a952bc529df1374a99.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青井 美海","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7987","source":"vndb"}]},{"characterId":"char_vndb_c33029","characterName":"桐山 香里","sourceIds":{"vndbCharacterId":"c33029"},"originalCharacterName":"桐山 香里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"629"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nee-San Who Wants to be an idiot"},{"spoiler":false,"text":"Yuichi's childhood friend and a year older nee-san."},{"spoiler":false,"text":"She has an image of being a strong woman because of her sisterly behavior, but in fact she is quite a clumsy girl. She is always blabbing about various things without people's knowledge."},{"spoiler":false,"text":"She moved far away from Yuuichi for family reasons, but she wanted to be with him so much that she transferred to the same school."},{"spoiler":false,"text":"Despite this, she is tense in front of Yuuichi and is unable to express her feelings well."},{"spoiler":false,"text":"As a result, she is upset when Yuichi looks at her with a bad attitude, which is contrary to her feelings."},{"spoiler":false,"text":"From Pikopiko's official website"}],"source":"vndb","sourceCharacterId":"c33029"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7639d815ff04e81dbca373e850bc60cb9214f32f8d36fca14267e734c1acaaf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd93752bc8c36a93231a0385f7775d140e623ae903151871aaf730c060e908bd.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一色 ヒカル","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7980","source":"vndb"}]},{"characterId":"char_vndb_c33030","characterName":"デューイ","sourceIds":{"vndbCharacterId":"c33030"},"originalCharacterName":"デューイ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1127"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"SAGA's next-generation machine that defined the \"eternal second best.\""},{"spoiler":false,"text":"Dewey was Dreamcost's last consumer doll released by SAGA Corporation, and it has already been 8 years since its production ended."},{"spoiler":false,"text":"Kaori bought it several years ago when it was being sold at a clearance sale."},{"spoiler":false,"text":"It is equipped with an AI that is set up to be a \"clueless character,\" with few words, no clear emotions, and always seems to be in a state of confusion."},{"spoiler":false,"text":"The most distinctive feature of this character is the unit attached to its back."},{"spoiler":false,"text":"Inside this unit is a bellows-type arm, which can be freely manipulated in conjunction with Dewey's AI."},{"spoiler":false,"text":"This unit is an original part that Kaori, its master, made herself."},{"spoiler":false,"text":"The name \"Dewey\" was given by Kaori after the violent driving sound it makes when reading the ROM."},{"spoiler":false,"text":"By the way, she has two more units of the same type."},{"spoiler":false,"text":"From Pikopiko's official website"}],"source":"vndb","sourceCharacterId":"c33030"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4fc2b998c2f5309db44840b82a5b134b765f012fba57840d4bd9bb2194a6cf64.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aab93282c2788511b04c6052f2b741c3f21eee44221853d2d3bf9a26407d8367.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本山 美奈","creatorId":"vndb:s1062","sourcePersonId":"vndb:s1062","canonicalEntityId":"vndb:s1062","name":"黒河 奈美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7988","source":"vndb"}]},{"characterId":"char_vndb_c33032","characterName":"高見沢 舞","sourceIds":{"vndbCharacterId":"c33032"},"originalCharacterName":"高見沢 舞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"305"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A devoted sister who connects family ties"},{"spoiler":false,"text":"The younger sister of Shou Takamizawa. One year younger than Yuuichi, Ren Arikawa's classmate and friend."},{"spoiler":false,"text":"Her body is not very strong, so she always observe physical education."},{"spoiler":false,"text":"Personality is quiet, but not dark."},{"spoiler":false,"text":"Although she understands that her brother hates her father, she always wants to get along with her family. She devotedly takes care of her mentally ill mother, and is an indispensable member of the Takamizawa family."},{"spoiler":false,"text":"Nana is also included in the \"family\" she refers to, and she is worried about her brother's attitude towards Nana."},{"spoiler":false,"text":"She meets Yuuichi and begins to fall in love with him, but she keeps quiet so her brother doesn't know."},{"spoiler":false,"text":"From Pikopiko's official website"}],"source":"vndb","sourceCharacterId":"c33032"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d3023edc39b2f89d45c90338eefb8063f993da833b3afb397f87298ee2e46a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/423061198b7ba35b697adbc96665d7146e3a2a17159509eb17245e98a760474b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐本 二厘","creatorId":"vndb:s794","sourcePersonId":"vndb:s794","canonicalEntityId":"vndb:s794","name":"結下 みちる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7985","source":"vndb"}]},{"characterId":"char_vndb_c33034","characterName":"神崎 公一郎","sourceIds":{"vndbCharacterId":"c33034"},"originalCharacterName":"神崎 公一郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"190"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Best friend at his own pace."},{"spoiler":false,"text":"Yuuichi has been his close friend since entering school."},{"spoiler":false,"text":"He's always smiling at his own pace, unfazed by his surroundings."},{"spoiler":false,"text":"For that reason, he should be in the best position to play the role of reprimanding Yuiichi, who tends to get emotional, but because of his own pace, the timing of his tsukkomi is often off, and in fact he is not very useful."},{"spoiler":false,"text":"However, He is not to be taken it lightly because he is sometimes very sharp."},{"spoiler":false,"text":"Standing over 190cm tall, he often bumps his head against the lintel at the entrance."},{"spoiler":false,"text":"From Pikopiko's website"}],"source":"vndb","sourceCharacterId":"c33034"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89b54c9e1e64b704d1c23be13d1d8e60e9e1b96064f823c1935be67c891d8555.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/7248423558ccfadde7c8714118844355512ec75fb557fa7f678fcb6591b15190.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いちご みるく","creatorId":"vndb:s1447","sourcePersonId":"vndb:s1447","canonicalEntityId":"vndb:s1447","name":"白石 稔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7990","source":"vndb"}]},{"characterId":"char_vndb_c33036","characterName":"エヌエー","sourceIds":{"vndbCharacterId":"c33036"},"originalCharacterName":"エヌエー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1029"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Unidentified Consumer Doll"},{"spoiler":false,"text":"???? Vega Braves manufactured by SAGA Corporation."},{"spoiler":false,"text":"A consumer doll Yuichi happened to meet on the street. It seems to be a semi-scratched doll based on an old machine \"Vega Brave\" manufactured by Saga Enterprises Co."},{"spoiler":false,"text":"Since no manufacturer, model number, or serial number is registered, it seems to have been privately created by someone who enjoys making robots."},{"spoiler":false,"text":"She is said to roam the streets from time to time without any particular purpose under the orders of her master, but she has no memory of her past and does not even remember her own name."},{"spoiler":false,"text":"This is thought to be because all the memories she has acquired have been sucked out and analyzed."},{"spoiler":false,"text":"This is a common story in the case of self-made machines, but even so, she doesn't seem to be treated very well."},{"spoiler":false,"text":"From Pikopiko's official webite"}],"source":"vndb","sourceCharacterId":"c33036"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7fcf2d5377214aa3a84c52fd693f627c7da7b193da44cb6017440efa69d752e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ecaedfaf7cf1aa72b350b00eb2cfc81e6b7c04237c08706dce504801a17a040a.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真宮 ゆず","creatorId":"vndb:s1030","sourcePersonId":"vndb:s1030","canonicalEntityId":"vndb:s1030","name":"柏木 美優","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7991","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p400","sourceCompanyId":"egs:brand:2409","canonicalEntityId":"vndb:p400","name":"φâge","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:10725:2409","source":"egs"},{"companyId":"vndb:p4","sourc