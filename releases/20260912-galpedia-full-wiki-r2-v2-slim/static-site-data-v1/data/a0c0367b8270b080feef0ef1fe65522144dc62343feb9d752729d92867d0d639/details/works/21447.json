nalCharacterName":"高坂 瑞穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"103"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"97"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"66"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作のヒロインで、主人公の母親。"},{"spoiler":false,"text":"たぐいまれな美貌とＨカップの豊乳、それに熟れきった腰つきの未亡人。"},{"spoiler":false,"text":"亡き夫から受け継いだ小料理屋『粋（すい）』を、息子とともに切り盛りしている。"},{"spoiler":false,"text":"店の常連は彼女を目当てにやってくる男性客がほとんどだが、本人にはその自覚がなく隙だらけ。"},{"spoiler":false,"text":"そのため、主人公は好色な視線にさらされる母の姿にいつもヤキモキさせられている。"},{"spoiler":false,"text":"おっとりとした穏やかな性格で、人前では常に笑顔を絶やさない。"},{"spoiler":false,"text":"人の世話をやくことが大好きな反面、自分のことはいつも後回しにしがちな所がある。"},{"spoiler":false,"text":"料理、裁縫、掃除など家事全般が得意。"},{"spoiler":false,"text":"ただし運動だけは昔からめっぽう苦手で、いまだに自転車すら乗りこなせたことがない。"},{"spoiler":false,"text":"ひとり息子である主人公とは、半年ほど前から男女の関係にある。"},{"spoiler":false,"text":"彼のことは誰よりも大切に想っているが、母親として、このままではいけないと内心で思い悩んでいる。"}],"source":"egs","sourceCharacterId":"6425","sourceWorkId":"21447","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のヒロインで、主人公の母親。"},{"spoiler":false,"text":"たぐいまれな美貌と Hカップの豊乳、それに熟れきった腰つきの未亡人。"},{"spoiler":false,"text":"亡き夫から受け継いだ小料理屋・粋（すい）を息子とともに切り盛りしている。"},{"spoiler":false,"text":"店の常連は彼女を目当てにやってくる男性客がほとんどだが、本人にはその自覚がなく隙だらけ。"},{"spoiler":false,"text":"そのため、主人公は好色な視線にさらされる母の姿にいつもヤキモキさせられている。"},{"spoiler":false,"text":"おっとりとした穏やかな性格で、人前では常に笑顔を絶やさない。"},{"spoiler":false,"text":"人の世話をやくことが大好きな反面、自分のことはいつも後回しにしがちな所がある。"},{"spoiler":false,"text":"料理・裁縫・掃除など家事全般が得意。 ただし運動だけは昔からめっぽう苦手で、いまだに自転車すら乗りこなせたことがない。"},{"spoiler":false,"text":"一人息子である主人公とは、半年ほど前から男女の関係にある。"},{"spoiler":false,"text":"彼のことは誰よりも大切に想っているが、母親としてこのままではいけないと内心で思い悩んでいる。"}],"source":"bangumi","sourceCharacterId":"64288"}],"profileFacts":[{"label":"胸围（本版本）","value":"103 cm","valueContext":null,"source":"egs","sourceCharacterId":"6425","sourceWorkId":"21447","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"6425","sourceWorkId":"21447","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"6425","sourceWorkId":"21447","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"97 cm","valueContext":null,"source":"egs","sourceCharacterId":"6425","sourceWorkId":"21447","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"66 cm","valueContext":null,"source":"egs","sourceCharacterId":"6425","sourceWorkId":"21447","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50d8fcf0c90a667d6a559c13456869aac751d69a986c7cbc36dcaf9fc561b2b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b07767152c1d36e38a347a27fdd5b7687f2fdb84d195fa41ae7de8e9f0fb5ca0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126544:64288:6469:1","source":"bangumi"}]},{"characterId":"char_c53657","characterName":"鬼沢 重彦","sourceIds":{"bangumi":[],"egsCharacterIds":["6426"],"vndbCharacterId":"c53657"},"originalCharacterName":"鬼沢 重彦","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"瑞穂の体を狙う中年男。"},{"spoiler":false,"text":"構成員５００人程度の“組”の一員で、主人公の父親が残した借金の返済を迫り、以前からたびたび母子のもとを訪れていた。"},{"spoiler":false,"text":"プロレスラーのような体格と、野獣のような凄みのある風貌の持ち主。"},{"spoiler":false,"text":"年齢的には瑞穂よりも歳上だが、並外れた体力と精力の持ち主で、その気になれば１日中でも女を抱いていられる。"},{"spoiler":false,"text":"また、一度欲しいと思ったモノはどんな手を使ってでも手に入れないと気が済まない、欲深い性格をしている。"},{"spoiler":false,"text":"いままで抱いてきた女性は数知れず。"},{"spoiler":false,"text":"真珠入りの極端に大きな男性器が自慢だが、セックスの際はそれに頼らず、じわじわと女を堕とすことを好む。"}],"source":"egs","sourceCharacterId":"6426","sourceWorkId":"21447","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cf65f140ddbea7fdfcad672e80245f8e401e4e69ed08cbbaa3ae713e7508990.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/915f2cbeb4e759e1444fa9a407319ee6ddaf975ce36598f40ad30522e6204aff.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c91505","characterName":"高坂 慎一","sourceIds":{"vndbCharacterId":"c91505"},"originalCharacterName":"高坂 慎一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p3450","sourceCompanyId":"egs:brand:3994","canonicalEntityId":"vndb:p3450","name":"エロイット","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:21447:3994","source":"egs"},{"companyId":"vndb:p176","sourceCompanyId":"vndb:p176","canonicalEntityId":"vndb:p176","name":"N43 Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:163740:v16720","source":"vndb"},{"companyId":"vndb:p176","sourceCompanyId":"vndb:p176","canonicalEntityId":"vndb:p176","name":"N43 Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-pr