rect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"40"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A president of a small apparel wholesale company. Formerly a well known AV actor."}],"source":"vndb","sourceCharacterId":"c68170"},{"segments":[{"spoiler":false,"text":"アパレル系の零細企業を経営している中年男性。"},{"spoiler":false,"text":"朗らかで明るく、誰からも好かれる性格だが、AV男優をしていた過去があり、様々な作品に登場していた。"},{"spoiler":false,"text":"その為、セックスの時はまるで別人のように豹変し、パートナーの女性を猛烈に責め続ける。"},{"spoiler":false,"text":"女子校生やOLや人妻など、様々な女性を汗だくで絶叫させるほどにイキ狂わせてきたセックスのプロである。"}],"source":"egs","sourceCharacterId":"5716","sourceWorkId":"20727","spoiler":false},{"segments":[{"spoiler":false,"text":"アパレル系の零細企業を経営している中年男性。"},{"spoiler":false,"text":"朗らかで明るく、誰からも好かれる性格だが、AV男優をしていた過去があり、様々な作品に登場していた。"},{"spoiler":false,"text":"昨年、満里奈を貸し出した際にはその才能を遺憾なく発揮させ、満里奈を文字通りイキ狂わせた。"},{"spoiler":false,"text":"現在は東健二の良き友人として、時々呑みに出かけたりする仲となっている。"}],"source":"bangumi","sourceCharacterId":"213092"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb9795e5bfac86da329a607285d589285f869d2b268848fae8760bada487b245.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e4592e8f8aa4f4fd43fe9d70305adf68782a1b8e50a1e91975bcac8a8c07264.webp","width":256,"height":249,"source":"static-detail"},"actors":[]},{"characterId":"char_c95666","characterName":"三郷 由佳菜","sourceIds":{"bangumi":[{"characterId":"212713","match":"exact-normalized-name-in-linked-work","subjectId":"323349"}],"egsCharacterIds":["23275"],"vndbCharacterId":"c95666"},"originalCharacterName":"三郷 由佳菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An office worker who doesn't talk about anything unrelated to work, known for her straitlaced personality. She is the team leader of the marketing department, and is famous in her company for being highly skilled."},{"spoiler":false,"text":"Recently, she has been worried that the only person she could reliably assign work to is Seiji. Because of that, she unintentionally burdened him with more work."},{"spoiler":false,"text":"She may be unsociable, but her beauty made her low-key popular with the male employees."},{"spoiler":false,"text":"She is married to a civil servant. Her sexual experience is with her husband only."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c95666"},{"segments":[{"spoiler":false,"text":"仕事以外の話を全くしないカタブツ女として有名な女性社員。"},{"spoiler":false,"text":"マーケティング部門内のチームリーダーで、やり手として職場内では有名。"},{"spoiler":false,"text":"チーム内で信頼して仕事を割り振れる人材が誠司のみであることが最近の悩み。"},{"spoiler":false,"text":"その為、つい彼にばかり負担をかけてしまっている。"},{"spoiler":false,"text":"愛想は悪いが美人な為、男性社員からは密かに人気がある。"},{"spoiler":false,"text":"既婚。公務員の旦那がいる。"},{"spoiler":false,"text":"男性経験は旦那のみ。"}],"source":"egs","sourceCharacterId":"23275","sourceWorkId":"30358","spoiler":false},{"segments":[{"spoiler":false,"text":"仕事以外の話を全くしないカタブツ女として有名な女性社員。"},{"spoiler":false,"text":"マーケティング部門内のチームリーダーで、やり手として職場内では有名。"},{"spoiler":false,"text":"チーム内で信頼して仕事を割り振れる人材が誠司のみであることが最近の悩み。"},{"spoiler":false,"text":"その為、つい彼にばかり負担をかけてしまっている。"},{"spoiler":false,"text":"愛想は悪いが美人な為、男性社員からは密かに人気がある。"},{"spoiler":false,"text":"既婚。公務員の旦那がいる。"},{"spoiler":false,"text":"男性経験は旦那のみ。"}],"source":"bangumi","sourceCharacterId":"212713"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/7447d6c2b7989fe5dfca339fca1c24a543e00b91f6222b78645dbb740c26dd26.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b12fba8584c18a9601b9d8d64a386657aa28d5d05e5a87b22aadd5ae852977f.webp","width":213,"height":256,"