ate/terminal-wiki/v1/characters/v1/images/35/3567bbf563f28bf2f82a11addf226a54bcb3a3600d09d1a2564e7c05bd017b59.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e72bfdc5e8a170417af0da3c241f26053dde7c26477574e72f03c69368ca3e58.webp","width":240,"height":250,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c100835","characterName":"海猫沢 めろん","sourceIds":{"vndbCharacterId":"c100835"},"originalCharacterName":"海猫沢 めろん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"1st year student. Like Soremi, she is the protagonist's childhood friend, as well as his first love. She has common sense, but also a passionate side, which led her to enroll to the same school as the protagonist for the purpose of being with him. The writer of Death Girl."},{"spoiler":false,"text":"She shares her name with Uminekozawa Melon, the writer of the visual novel."}],"source":"vndb","sourceCharacterId":"c100835"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e73068b86f1c34b7f5ebabb84fb2a628e985ada6370d20775e8756c2121d524.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/622d14319f69051ad343fb6b956fa9ffc5ba6532d86d2c10b40fbb04eccc6997.webp","width":240,"height":250,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c100850","characterName":"るみ","sourceIds":{"vndbCharacterId":"c100850"},"originalCharacterName":"るみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A robot daughter that Akagi Genjuurou bought from Germany. She's originally meant to be a military weapon, but acts as a member of the Futon Committee and a mediator who manages the power balance of the school."}],"source":"vndb","sourceCharacterId":"c100850"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/0152e73e3b4cfe78a5668b33c4f0129356a203a553a4e307129fab7967f915ac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7faad5bc5bf40979d965ca0f1e6ada0d197eed9d01f893aad76fc843721ee994.webp","width":240,"height":250,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c100851","characterName":"羽鳥 ひよこ","sourceIds":{"vndbCharacterId":"c100851"},"originalCharacterName":"羽鳥 ひよこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"1st year student. A mysterious magical girl who is always in the bathroom. She has a straightforward personality and will believe anything she's told. Apparently, she's looking for the demon in the school by order of the queen."}],"source":"vndb","sourceCharacterId":"c100851"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6ee11d3e07fc03df89fe00f110fbe9ed9be86cfabc35f96890f05ae80147d2bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/046baed817f84ea8e1e6c7a7ad26944f3bf567604a3b77e48fb4cf415b6b85f0.webp","width":240,"height":250,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c100852","characterName":"ぎーこ","sourceIds":{"vndbCharacterId":"c100852"},"originalCharacterName":"ぎーこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritativ