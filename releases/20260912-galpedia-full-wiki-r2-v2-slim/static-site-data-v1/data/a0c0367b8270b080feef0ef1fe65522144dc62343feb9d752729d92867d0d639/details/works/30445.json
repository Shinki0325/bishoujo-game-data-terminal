)"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大昔の日本の寒村の村長の娘。"},{"spoiler":false,"text":"幼少時は、ルーや主人公にべったりの甘えん坊。"},{"spoiler":false,"text":"最初は頼りない感じだったが、少しずつ成長していく。"},{"spoiler":false,"text":"でもサツキにとってルーは、 いつまで経ってもお姉ちゃん。"}],"source":"egs","sourceCharacterId":"23831","sourceWorkId":"30445","spoiler":false},{"segments":[{"spoiler":false,"text":"日本古代小村庄的村长家女儿。"},{"spoiler":false,"text":"小时候总朝露露和男主角撒娇，是一只粘人精。"},{"spoiler":false,"text":"随着年纪增长变得越来越懂事，但是露露对她来说永远都是姐姐。"},{"spoiler":false,"text":"「我是实习魔法师皋月喵~"},{"spoiler":false,"text":"呃，她说这种说话风格是实习期规定…」"}],"source":"bangumi","sourceCharacterId":"104368"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a852c843e2450b889bc7b265fbe850fd2f5812876be7dad4a73eeb22ff3ef20.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45edefcb2cbf8235167df8f4e73655019bb43bd029037aeda75e6264fab2343d.webp","width":249,"height":256,"source":"static-detail"},"actors":[{"creditedName":"能登麻美子","creatorId":"vndb:s468","sourcePersonId":"vndb:s468","canonicalEntityId":"vndb:s468","name":"能登麻美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:323987:104368:3827:1","source":"bangumi"}]},{"characterId":"char_c100195","characterName":"シャー・ホイ","sourceIds":{"bangumi":[{"characterId":"104369","match":"exact-normalized-name-in-linked-work","subjectId":"323987"}],"egsCharacterIds":["23832"],"vndbCharacterId":"c100195"},"originalCharacterName":"シャー・ホイ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"25"},"sex":{"reviewS