[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a5f6b9f732babf51db39d1b7b74731e47229d83e613e51a8bf2c61b72d41ad1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d052ee7a431b02e87812a714a825d251d4123f47e910147d256c94f783ce02b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:237623:60943:6359:1","source":"bangumi"}]},{"characterId":"char_c65182","characterName":"黄道寺 天音","sourceIds":{"bangumi":[{"characterId":"60944","match":"exact-normalized-name-in-linked-work","subjectId":"237623"}],"egsCharacterIds":["17489"],"vndbCharacterId":"c65182"},"originalCharacterName":"黄道寺 天音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"バベルの生徒会長で非公認ランキングは不動の一位。真面目で責任感が強く、困っている生徒には親身になって手助けをするため、人望も厚い。"},{"spoiler":false,"text":"とはいえ真面目一辺倒というわけではなく、悪戯好きだったりとユーモアな一面もあり、そんなところもまた彼女の人望を高める要因になっている。"},{"spoiler":false,"text":"名家の一粒種であり、理事長の娘という立場もあってか、芝居がかったような男口調で喋る癖があり、そのために浮世離れした印象を与える。"},{"spoiler":false,"text":"実際、時折一般常識がポッカリと欠落していたりもして、その辺りは箱入りのお嬢様といったところ。"},{"spoiler":false,"text":"主人公の正体を知り、他の生徒たちに害をなす前に何とかしなければと思い、主人公の封印するために接触してくる。"},{"spoiler":false,"text":"黄道寺家は現在の魔法界の中枢を担っており、バベルも黄道寺家が設立したことで知られている。"}],"source":"egs","sourceCharacterId":"17489","sourceWorkId":"25828","spoiler":false},{"segments":[{"spoiler":false,"text":"バベルの生徒会長で非公認ランキングは不動の一位。"},{"spoiler":false,"text":"真面目で責任感が強く、困っている生徒には親身になって手助けをするため、人望も厚い。"},{"spoiler":false,"text":"とはいえ真面目一辺倒というわけではなく、悪戯好きだったりとユーモアな一面もあり、そんなところもまた彼女の人望を高める要因になっている。"},