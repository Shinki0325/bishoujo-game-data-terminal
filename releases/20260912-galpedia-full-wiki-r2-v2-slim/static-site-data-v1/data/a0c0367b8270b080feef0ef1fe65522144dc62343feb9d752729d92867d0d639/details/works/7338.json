"vndbCharacterId":"c44832"},"originalCharacterName":"ノエル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"戦乱の中で主人公に助けられた女の子。"},{"spoiler":false,"text":"以後、身寄りのなかった彼女は、主人公の出資しているメイド学院に引き取られ、そこで何処に出しても恥ずかしくないメイドに成長する。"},{"spoiler":false,"text":"常に明るい笑顔を絶やさない、心優しい性格で、周囲に安らぎを与えてくれる。"},{"spoiler":false,"text":"アナル拡張、腸拡張、脱肛など、彼女への調教はアナルがメインとなる。"}],"source":"egs","sourceCharacterId":"17354","sourceWorkId":"7338","spoiler":false},{"segments":[{"spoiler":false,"text":"昔、戦時中に主人公が助けた女性。"},{"spoiler":false,"text":"主人公が出資しているメイド学園に引き取られた。"},{"spoiler":false,"text":"現在は、どこに出しても恥ずかしくないメイドとして成長している。"},{"spoiler":false,"text":"性格："},{"spoiler":false,"text":"とても明るくて優しい。常に笑顔を絶やさず、周りの人々に安らぎを与えることが出来る女性。"},{"spoiler":false,"text":"主な調教内容："},{"spoiler":false,"text":"肛門を広げる肛門拡張、腸を広げて排泄物を大量にため込めるようにする腸拡張調教、肛門を引き延ばして外側から刺激できるようする脱肛調教など、肛門への調教がメイン。"},{"spoiler":false,"text":"備考："},{"spoiler":false,"text":"処女"}],"source":"bangumi","sourceCharacterId":"148531"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/2589afe8d456983a6bc70a7b58196515ef54000219d390bac75a436f9a3b36ff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b691ad185138179875a7c852ac6372a5bc17c2e7f5ab9c85e42dc2de274b4b8.webp","width":109,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c44833","characterName":"サーシャ","sourceIds":{"bangumi":[{"characterId":"148532","match":"exact-normalized-name-in-linked-work","subjectId":"265741"}],"egsCharacterIds":["17355"],"vndbCharacterId":"c44833"},"originalCharacterName":"サーシャ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"114"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が出資しているメイド学院の学院長。"},{"spoiler":false,"text":"物腰柔らかで優しく、落ち着きのある大人の女性。"},{"spoiler":false,"text":"メイドを教育する立場から、学生たちに厳しい態度を取ることもある。"},{"spoiler":false,"text":"爆乳化、乳腺拡張、母乳製造化など、彼女の調教は乳房がメインになる。"}],"source":"egs","sourceCharacterId":"17355","sourceWorkId":"7338","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の出資しているメイド学園の学園長を務め、メイドの育成をしている女性。"},{"spoiler":false,"text":"性格："},{"spoiler":false,"text":"落ち着きがあり、思いやりのある性格をしている。"},{"spoiler":false,"text":"だが、メイドを教育する立場からか、厳しい態度をとることもしばしば。"},{"spoiler":false,"text":"主な調教内容："},{"spoiler":false,"text":"胸を大きくする爆乳化調教、乳首で性行為ができるようにする乳腺拡張調教、母乳が出せるようにする母乳製造化調教など、乳房への調教がメイン。"},{"spoiler":false,"text":"備考："},{"spoiler":false,"text":"非処女"}],"source":"bangumi","sourceCharacterId":"148532"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/dea3487ae31d7aa0a45b6b5cf2dbccce919fc171062c756eefeb931577d7c6f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a08fadace287a516e7343a05b6412e0f5ae00c5a2a62b2780bc235723f26072.webp","width":120,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MARIO","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:265741:148532:4918:1","source":"bangumi"}]},{"characterId":"char_c44834","characterName":"ミア","sourceIds":{"bangumi":[{"characterId":"148533","match":"exact-normalized-name-in-linked-work","subjectId":"265741"}],"egsCharacterIds":["17356"],"vndbCharacterId":"c44834"},"originalCharacterName":"ミア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"69"},"height":{"reviewState":"no-conflict","source":"vndb","value":"151"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が出資しているメイド学院の院生。"},{"spoiler":false,"text":"路頭に迷っているところを、メイド学院に引き取られ、そこで暮らすようになった素性のわからない少女。"},{"spoiler":false,"text":"人懐っこく、天真爛漫、甘えん坊な性格。"},{"spoiler":false,"text":"陰核肥大化、陰核陰茎化など、彼女への調教はクリトリスがメインとなる。"}],"source":"egs","sourceCharacterId":"17356","sourceWorkId":"7338","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の出資しているメイド学園に、数ヶ月前に引きとられた、素性の分からない少女。"},{"spoiler":false,"text":"性格："},{"spoiler":false,"text":"甘えたがりで、人なつっこい性格をしている。"},{"spoiler":false,"text":"少しいたずら好きでもある。"},{"spoiler":false,"text":"主な調教内容："},{"spoiler":false,"text":"肉芽を大きくする肉芽肥大調教、肉芽を男根化する肉芽男根化調教など、肉芽への調教がメイン。"},{"spoiler":false,"text":"備考："},{"spoiler":false,"text":"処女"}],"source":"bangumi","sourceCharacterId":"148533"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/441d34cfd18f5a82b06c05befb6199b9558568366f7775f95f5fab241f5b62c9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb5ca1907a8add6b80dc55bd69e119bbd791d6f8ae5602d213aaa5bef3166bd2.webp","width":123,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c44835","characterName":"メリア","sourceIds":{"bangumi":[{"characterId":"148534","match":"exact-normalized-name-in-linked-work","subjectId":"265741"}],"egsCharacterIds":["17357"],"vndbCharacterId":"c44835"},"originalCharacterName":"メリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の屋敷で働くメイドにして、主人公が所有する淫具奴隷の最高傑作。"},{"spoiler":false,"text":"主人公を盲目的に信仰している女性。"},{"spoiler":false,"text":"主人公に最も愛されている淫具奴隷を自負が強く、他の奴隷の調教に没頭していると途端に機嫌が悪くなる。"},{"spoiler":false,"text":"普段は従順な彼女だが、実は独占欲が強く、気性が荒い。"}],"source":"egs","sourceCharacterId":"17357","sourceWorkId":"7338","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の屋敷で働くメイド。"},{"spoiler":false,"text":"そして、主人公が所有する淫具奴隷の中で最高傑作。"},{"spoiler":false,"text":"性格："},{"spoiler":false,"text":"主人公の言葉は無条件で信じる性格をしている。"},{"spoiler":false,"text":"独占欲が強く、また気性は荒い。"},{"spoiler":false,"text":"主人公に一番愛されている淫具奴隷は自分であると自負しているため、主人公が他の淫具奴隷の調教に没頭すると、機嫌が悪くなることがある。"},{"spoiler":false,"text":"備考："},{"spoiler":false,"text":"非処女"}],"source":"bangumi","sourceCharacterId":"148534"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a591835d502835fb5dbabede5aab586da56c4f3a6b3db690aa8707e3ba4fdcbd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98bb26cb41df4caa0103854d484a88fa918d51217e245c9e34fb28ddb43d4aa5.webp","width":93,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c44836","charac