お灸を据える”姉妹コミュニケーションはもはや名物レベル。"},{"spoiler":false,"text":"小さな頃から姉の遊び相手だったため隠れゲーマー。 サターン派。"},{"spoiler":false,"text":"「私はあの姉の下で育ったので、甘えさせてくれるお兄ちゃんっていいなーって憧れてたんです」"}],"source":"bangumi","sourceCharacterId":"24294"}],"profileFacts":[{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"3146","sourceWorkId":"19866","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"3146","sourceWorkId":"19866","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"3146","sourceWorkId":"19866","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"3146","sourceWorkId":"19866","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4fabb0997e00c44525a400cd293424bd9b990aa41aa1b272180455c4e9eda4e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c9b27c301c49cf7239138d19fc82fbb2046fc80050bcfe1085376cc5b3b9dc89.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:101460:24294:4810:1","source":"bangumi"}]},{"characterId":"char_c17515","characterName":"星那 ヒメ","sourceIds":{"bangumi":[{"characterId":"24302","match":"exact-normalized-name-in-linked-work","subjectId":"101460"}],"egsCharacterIds":["3147"],"vndbCharacterId":"c17515"},"originalCharacterName":"星那 ヒメ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"73"},"height":{