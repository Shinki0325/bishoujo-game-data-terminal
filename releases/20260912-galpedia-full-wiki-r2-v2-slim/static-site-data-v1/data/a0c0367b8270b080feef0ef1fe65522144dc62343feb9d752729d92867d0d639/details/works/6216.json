e},{"segments":[{"spoiler":false,"text":"姉妹校の遊華総合学園の生徒でいつも明るく元気なドジっ子落ちこぼれ死神候補生。"},{"spoiler":false,"text":"繚蘭祭に招待され同じ候補生のナギとともに遊びに来る。"},{"spoiler":false,"text":"本人に自覚は無いが料理の腕は天下一品。"}],"source":"egs","sourceCharacterId":"10863","sourceWorkId":"14670","spoiler":false},{"segments":[{"spoiler":false,"text":"百瀬ヒカル（CV：安玖深音）"},{"spoiler":false,"text":"Peace＠Piecesユニゾンシフト：ブロッサム"},{"spoiler":false,"text":"いつも明るい元気なドジっこ死神候補生。何も無いところで転んだり、"},{"spoiler":false,"text":"とんでもない方向音痴だが、料理の腕前だけは天下一品。"},{"spoiler":false,"text":"宇宙船「パラダイス号」にのって飛ばされてくる。"}],"source":"egs","sourceCharacterId":"10863","sourceWorkId":"16176","spoiler":false},{"segments":[{"spoiler":false,"text":"いつでも明るく笑顔の絶えないメインヒロイン。本人は何事にも力いっぱい真面目に頑張っているつもり。物語のはじめに、主人公のクラスに転入してくる。死神候補生としての仕事の最中に、ドジで主人公に流れ弾を当ててしまい、申し訳ない気持ち＆経過観察のため同居することになる。"}],"source":"bangumi","sourceCharacterId":"141504"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7ffb2c530ad47f5ac1356503484641814ed18ec6896960c22f973a910999c818.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc66a39d8538fee2df20a28f37ad9298cc21445ceea04d93e13d7c3771069271.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150322:141504:4809:1","source":"bangumi"}]},{"characterId":"char_c11670","characterName":"ナギ","sourceIds":{"bangumi":[{"characterId":"141505","match":"exact-normalized-name-in-linked-work","subjectId":"65391"}],"egsCharacterIds":["10864"],"vndbCharacterId":"c11670"},"originalCharacterName":"ナギ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1223"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Another shinigami trainee, however her personality is the polar opposite of Hikaru's."},{"spoiler":false,"text":"Nagi is a member of the Mechanical Club and she is good at robot building."},{"spoiler":false,"text":"She works part-time in a bakery."}],"source":"vndb","sourceCharacterId":"c11670"},{"segments":[{"spoiler":false,"text":"【おとぼけメカフェチ候補生】"},{"spoiler":false,"text":"メインヒロインその2でおとぼけキャラ。"},{"spoiler":false,"text":"ヒカルとは逆に感情が頻繁に顔に出ないが、"},{"spoiler":false,"text":"楽しいときは楽しいと思っている。"},{"spoiler":false,"text":"学内の物置のような場所にある「メカ部」の部長で、"},{"spoiler":false,"text":"役に立つものから意味不明なものまで、いろんなあやしいメカを作る。"},{"spoiler":false,"text":"メカを作っているときはメガネ着用。"},{"spoiler":false,"text":"ケーキショップ「ライムライト」で住み込みのバイトをしつつ、学園に通っている。"},{"spoiler":false,"text":"「一緒にケーキ食べよう？」"}],"source":"egs","sourceCharacterId":"10864","sourceWorkId":"4096","spoiler":false},{"segments":[{"spoiler":false,"text":"姉妹校の遊華総合学園の生徒でちょっとおとぼけなメカフェチ死神候補生。"},{"spoiler":false,"text":"繚蘭祭にメカ部部長として招待される。くるりにとっては憧れの存在？"}],"source":"egs","sourceCharacterId":"10864","sourceWorkId":"14670","spoiler":false},{"segments":[{"spoiler":false,"text":"Peace＠Piecesユニゾンシフト：ブロッサム"},{"spoiler":false,"text":"九条くるりも一目置くメカフェチ死神候補生。"},{"spoiler":false,"text":"ちょっとおとぼけでおっとりしているように見えるが、意外と考えていることは過激気味。"},{"spoiler":false,"text":"くるりと共に「仲間レーダー」を開発し、他の別世界から飛ばされてきた女の子を捜す。"}],"source":"egs","sourceCharacterId":"10864","sourceWorkId":"16176","spoiler":false},{"segments":[{"spoiler":false,"text":"メインヒロインその2でおとぼけキャラ。ヒカルとは逆に感情が頻繁に顔に出ないが、楽しいときは楽しいと思っている。学内の物置のような場所にある「メカ部」の部長で、役に立つものから意味不明なものまで、いろんなあやしいメカを作る。メカを作っているときはメガネ着用。ケーキショップ「ライムライト」で住み込みのバイトをしつつ、学園に通っている。"}],"source":"bangumi","sourceCharacterId":"141505"}],"profileFac