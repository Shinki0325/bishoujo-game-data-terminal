.date/terminal-wiki/v1/characters/v1/images/fa/fa681bcb2567de0f8d09ceceaa3b8b5b0b53a752637b5ae7efcee91a447d6d00.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c81138","characterName":"片岡 律子","sourceIds":{"vndbCharacterId":"c81138"},"originalCharacterName":"片岡 律子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"36"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mariko's biological younger sister, 36. Ryuichi's aunt, though she gets angry if you call her that."},{"spoiler":false,"text":"Recently divorced, she shrewdly squeezed a hefty settlement out of her ex and used it to go on an overseas trip—a crafty woman."},{"spoiler":false,"text":"Rents an apartment near the Iwamoto family, enjoying a carefree single life. She drops by casually, teasing Ryuichi for fun."},{"spoiler":false,"text":"Unlike the reserved Mariko, she has a flashy taste, which often leads to arguments between the sisters."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c81138"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11cee967842b926211cdf83b3d63934986c6dcafb916e25dd1df14b3fb1b7588.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe0380e7b72dec0f5a95f0b1f79d64734a8f6661f3e140d55e36fa3c386f8a67.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c81139","characterName":"井手 佑里子","sourceIds":{"vndbCharacterId":"c81139"},"originalCharacterName":"井手 佑里子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"29"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The young wife next door, 29 years old. She lives with her husband, and they don't have children yet."},{"spoiler":false,"text":"She's cheerful and gets along well with the neighbors, including Mariko, of course. She acts very casually around Ryuichi. She speaks Kansai dialect, by the way."},{"spoiler":false,"text":"Her husband, who works for a major trading company, is away on a long business trip. Because of this, she feels a bit restless with her young body. She sets her sights on a young man in the neighborhood, Ryuichi, to be precise."},{"spoiler":false,"text":"Playing around or maybe just messing around with Ryuichi is her main way of relieving her pent-up frustration."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c81139"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/687b3eafbe71847c13b78681fc01a80e415fcde4c5ee7156cb53dbaf83eaeb0e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8e065feeccc3eb1bfb98d8712f723b8fd561bf22cbbd97e339d5e33ab4fdf7c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北都 南","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36466","source":"vndb"}]},{"characterId":"char_vndb_c81140","characterName":"五十嵐 春香","sourceIds":{"vndbCharacterId":"c81140"},"originalCharacterName":"五十嵐 春香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ryuichi's senior at school, a delinquent. Believe it or not, she's dating Mr. Nomoto, the PE teacher."},{"spoiler":false,"text":"After Ryuichi caught them having a secret rendezvous, she dragged him into her sex circle to keep him quiet. Nomoto seems unhappy about it, though..."},{"spoiler":false,"text":"She calls Nomoto by his first name, “Takaaki.” Nomoto seems to be under Haruka's thumb. However, it seems she always makes him go “bareback & cum inside” except on her dangerous days."},{"spoiler":false,"text":"She's actually the type of “good woman” who devotes herself to men."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c81140"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c42873be4f08661092c4a3e91a765788aaf9e33d32dd02c4d9c3f161b8f7f773.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45c0cf1c4a2c129be87de1a1a40fa9659c0b19855c0186c4bdc6c3a834899d9a.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c81141","characterName":"吉崎 雪江","sourceIds":{"vndbCharacterId":"c81141"},"originalCharacterName":"吉崎 雪江","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97e9be8e16de80e8bcc00579e96b5cb3df0142ba7309fef7d8d507bfc8465095.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5bbd53c38aa44968b859d410d04121f4cd5fe79755fe4ff8d18abde418669385.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p210","sourceCompanyId":"egs:brand:369","canonicalEntityId":"vndb:p210","name":"