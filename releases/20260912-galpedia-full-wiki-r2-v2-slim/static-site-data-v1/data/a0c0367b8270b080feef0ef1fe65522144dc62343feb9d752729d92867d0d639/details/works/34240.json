ast":[{"characterId":"char_vndb_c10490","characterName":"羽藤 桂","sourceIds":{"vndbCharacterId":"c10490"},"originalCharacterName":"羽藤 桂","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Protagonist of the story."},{"spoiler":false,"text":"Because she's a nice and carefree person, people who get to know her often wind up having the urge to take care of her. Although her favorite phrase is \"always be prepared,\" she tends to be rather careless and forgetful."},{"spoiler":false,"text":"She lost her father in a fire as a child, and this summer, she lost the only other person she could call \"family\": her mother. Having learned of her father's house being left to her by inheritence, she uses the summer break to visit Hemidzuka."},{"spoiler":false,"text":"She is particularly fond of Japanese cuisine, samurai dramas and adages."},{"spoiler":false,"text":"Taken from Zohar's site."}],"source":"vndb","sourceCharacterId":"c10490"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32992cce8e306b772c87033a5e692721d2a6225eb64572a6703e4d6340f1f17e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80779fbd5e46147cc211ec5787f54743e5b0fc5f7c76c62be806c67bbd47c593.webp","width":194,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松来 未祐","creatorId":"vndb:s1667","sourcePersonId":"vndb:s1667","canonicalEntityId":"vndb:s1667","name":"松来未祐(松木美愛子)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1191","source":"vndb"}]},{"characterId":"char_vndb_c10497","charac