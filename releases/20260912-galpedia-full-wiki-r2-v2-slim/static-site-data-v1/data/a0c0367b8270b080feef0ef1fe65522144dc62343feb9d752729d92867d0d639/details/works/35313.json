{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"35313","model":{"presentationWorkId":"egs:35313","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_95170","characterName":"Laura Vanderboom","sourceIds":{"bangumi":[{"characterId":"95170","match":"source-roster","subjectId":"294629"}]},"originalCharacterName":"Laura Vanderboom","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Woman, or Laura Vanderboom, is a main character who is featured prominently in the Cube Escape games. She is the reincarnation of William and the daughter of Rose, and a member of the Vanderboom clan."},{"spoiler":false,"text":"She is voiced by Bob Rafferty in Cube Escape: Paradox, and Iris Muller in The White Door. She is played by Elena Kejvalová in the short film."}],"source":"bangumi","sourceCharacterId":"95170"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d45bd98c74ad7d3f88243db3a13c6afa1a2e06aa859043655c29fdea145ab25.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5ca4dcf8068bc1f6c99f9a0ea6327617b47143951684036d45c2adf06389019.webp","width":246,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_95176","characterName":"William Vanderboom","sourceIds":{"bangumi":[{"characterId":"95176","match":"source-roster","subjectId":"205124"},{"characterId":"95176","match":"source-roster","subjectId":"294629"}]},"originalCharacterName":"William Vanderboom","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"William Vanderboom is a member of the Vanderboom clan. He is an alchemist and worked alongside his brother Aldous. After his death, James, his nephew and sole heir inherits his house at Rusty Lake. He is eventually reborn as a woman named Laura."}],"source":"bangumi","sourceCharacterId":"95176"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e10c8ba3156bb43f3c58e768b0e529a17c6146734f6af08aeb69214c2daaa28.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/3782e556007fea6782ea314b9bbfb8913c04ba42b7a9e47871a2194365ccf155.webp","width":226,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_95177","characterName":"小黑","sourceIds":{"bangumi":[{"characterId":"95177","match":"source-roster","subjectId":"205124"},{"characterId":"95177","match":"source-roster","subjectId":"294629"}]},"originalCharacterName":"小黑","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"Corrupted Souls are beings that roam around Rusty Lake. They are shown as shadowy phantoms with white glowing eyes. The Souls are tied to the black cubes; the process of extracting negative memories into black cubes corrupts the body if the victim learns about it."},{"spoiler":false,"text":"The Corrupted Soul is played by Robin Ras in the short film."}],"source":"bangumi","sourceCharacterId":"95177"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/0609e21975179b5058ac8df8b7cbd622d9c51b65130a8d12c08c28d70cb1b4aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4adafdff98f9031a48d95ab070d24