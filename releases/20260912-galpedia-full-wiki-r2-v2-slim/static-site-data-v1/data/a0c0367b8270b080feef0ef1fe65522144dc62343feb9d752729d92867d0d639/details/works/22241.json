{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"22241","model":{"presentationWorkId":"vndb:v18824","staff":{"artwork":[{"creditedName":"秋月つかさ","creatorId":"vndb:s3983","sourcePersonId":"egs:creator:12623","canonicalEntityId":"vndb:s3983","name":"秋月つかさ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:156070","source":"egs"},{"creditedName":"腹ペ娘","creatorId":"vndb:s3985","sourcePersonId":"egs:creator:16095","canonicalEntityId":"vndb:s3985","name":"腹ペ娘","detail":"SD原画","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:156071","source":"egs"}],"scenario":[{"creditedName":"ポチくん","creatorId":"vndb:s3986","sourcePersonId":"egs:creator:12624","canonicalEntityId":"vndb:s3986","name":"ポチくん","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:156072","source":"egs"}],"music":[{"creditedName":"ALNEAR(琉姫アルナ)","creatorId":"vndb:s3175","sourcePersonId":"egs:creator:15325","canonicalEntityId":"vndb:s3175","name":"ALNEAR(琉姫アルナ)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:156073","source":"egs"}],"other":[]},"cast":[{"characterId":"char_bangumi_132152","characterName":"風音 蒼","sourceIds":{"bangumi":[{"characterId":"132152","match":"source-roster","subjectId":"278888"}]},"originalCharacterName":"風音 蒼","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0723"},"height":{"reviewState":"source-only","source":"bangumi","value":"156"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「空」「小鳥」「なずな」といったスットボケ風音家を唯一纏めることが出来る、保護者的存在。"},{"spoiler":false,"text":"（残念ながら、シルフィではスットボケを纏めるだけのカリスマは持っていない）"},{"spoiler":false,"text":"家事全般が得意で、シルフィと一緒に家事を行っている（シルフィと違って文句タラタラだが）。"},{"spoiler":false,"text":"料理の腕前もプロレベルで、居候が増えると空の（激マズ）料理に取って代わって料理長となる。"},{"spoiler":false,"text":"（蒼は空の料理も好きだが、その他大勢が許さない。小咲父にうちで働いてくれとせがまれる）"},{"spoiler":false,"text":"「ユーノ」と思われる明確な記憶があり、その記憶は本当だったのか戸惑いがある。"},{"spoiler":false,"text":"そこで蒼は、二度と空は死なせないと誓う。"},{"spoiler":false,"text":"mask"},{"spoiler":false,"text":"空の双子ではあるが、小鳥の兄のクローンでもある。"},{"spoiler":false,"text":"（ただし、性別は違う。ミッシングの2年前、つまり12年しか生まれてから経っていない。空も同じ）"},{"spoiler":false,"text":"双子であるが故に、空とのアリス共鳴は完全にシンクロし、マルチプロセッサを形成できる。"},{"spoiler":false,"text":"それによって、より強力なアリス体質を持つことが出来る（空+蒼=AIを操作できる唯一の存在）。"},{"spoiler":false,"text":"そのため、まるで「ご都合主義」的な展開が起こる（物語開始時の空と蒼の出会いなど）。"},{"spoiler":false,"text":"つまり、空と蒼は無意識の中で引き付け合っている。"},{"spoiler":false,"text":"5年前にユーノからやってきた。"},{"spoiler":false,"text":"そして5年間、この世界で旅をして月ヶ浜に辿り着いた。"},{"spoiler":false,"text":"空と同じくらいのアリス体質を持ち、アクアを操作するための力を持つ。"},{"spoiler":false,"text":"/mask"}],"source":"bangumi","sourceCharacterId":"132152"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"132152","value":"美浜学園後期2年"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36501996aecfd99fa9e54f6f94ceb6244806d069be8c035174d1d56f7d1b287d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/7758e94e09f911a361108ac894992d4d87b1c63fe318019580b82ad3eefd5dfa.webp","width":80,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_183803","characterName":"風音 空","sourceIds":{"bangumi":[{"characterId":"183803","match":"source-roster","subjectId":"278888"}]},"originalCharacterName":"風音 空","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0723"},"height":{"reviewState":"source-only","source":"bangumi","value":"156"},"sex":{"rev