-native","relationId":"vndb:vn-staff:18448","source":"vndb"},{"creditedName":"チーム・ちゃっちゃきロビン","creatorId":"vndb:s636","sourcePersonId":"vndb:s636","canonicalEntityId":"vndb:s636","name":"チーム・ちゃっちゃきロビン","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:18450","source":"vndb"},{"creditedName":"巫浄 スウ","creatorId":"vndb:s644","sourcePersonId":"vndb:s644","canonicalEntityId":"vndb:s644","name":"巫浄 スウ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:18451","source":"vndb"},{"creditedName":"笹＠","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:18453","source":"vndb"},{"creditedName":"RMG Rainbow-Motion-Graphics","creatorId":"vndb:s2828","sourcePersonId":"vndb:s2828","canonicalEntityId":"vndb:s2828","name":"RMG(Rainbow-Motion-Graphics)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:18454","source":"vndb"}]},"cast":[{"characterId":"char_c29609","characterName":"エーファ","sourceIds":{"bangumi":[{"characterId":"92618","match":"exact-normalized-name-in-linked-work","subjectId":"197414"}],"egsCharacterIds":["18609"],"vndbCharacterId":"c29609"},"originalCharacterName":"エーファ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"王国の元王女で、アロンスの妹。"},{"spoiler":false,"text":"容姿、武勇に優れた兄に、妹以上の感情を寄せ、継母にそそのかされ、兄の寝室に侵入、男女の関係を結んでしまい、太陽が沈んでいる間だけ元に戻れる呪いをかけられてしまう。"},{"spoiler":false,"text":"心優しく、穏やかな姫だが、兄のことになると一変、強烈な恋慕と性衝動、兄に近づく女性への強烈な嫉妬を露にする。"},{"spoiler":false,"text":"体を戻す代償として、魔女ヨランダの弟子となる。"},{"spoiler":false,"text":"「魔女になります……アロイス兄様と元に戻るためなら、どんなことだってしてみせます」"}],"source":"egs","sourceCharacterId":"18609","sourceWorkId":"10557","spoiler":false},{"segments":[{"spoiler":false,"text":"イーズレーンの元王女。アロイスの妹。"},{"spoiler":false,"text":"容姿、武勇ともに優れた兄・アロイスに、妹として以上の愛情を抱いており、自らアロイスの寝所に忍び込んで関係を結んでしまう。"},{"spoiler":false,"text":"元の姿に戻れるのは、太陽が沈んでいる夜の間だけ。"},{"spoiler":false,"text":"普段は心優しく穏やかなお姫様であるが、アロイスとの愛を貫くためならば、どんなことも辞さない。"},{"spoiler":false,"text":"アロイスに対する強烈な恋慕と性衝動、アロイスに近づく他の女性への強烈な嫉妬心をその心に秘めている。"},{"spoiler":false,"text":"元の身体に戻してもらう代償として、魔女ヨランデの弟子として自らも魔女となる。"}],"source":"bangumi","sourceCharacterId":"92618"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a45ee2294873dc04a6b9ebfdc8d5b872eee85d5873322efdf1243318dc12d72.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e558f3a78b736d8aa6bdb8a550adc724f8c3793ce74985e38b98048edb61279.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197414:92618:4646:1","source":"bangumi"}]},{"characterId":"char_c29610","characterName":"ヨランデ","sourceIds":{"bangumi":[{"characterId":"92619","match":"exact-normalized-name-in-linked-work","subjectId":"197414"}],"egsCharacterIds":["18610"],"vndbCharacterId":"c29610"},"originalCharacterName":"ヨランデ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"王国の外れにある森で暮らしている魔女。"},{"spoiler":false,"text":"自らの欲望に忠実で好悪の別が激しく、逆らう者には容赦しない。"},{"spoiler":false,"text":"興味の無い人間は、道端の雑草くらいにしか思っていない様子。"},{"spoiler":false,"text":"アロイスとエーファを元に戻す代償として、アロイスは魔力を蓄える「欲望奴隷」に、エーファは手足となる魔女に仕立て上げようとしている。"},{"spoiler":false,"text":"「願いを叶えて欲しかったら、あたしの言うことを全てききなさい」"}],"source":"egs","sourceCharacterId":"18610","sourceWorkId":"10557","spoiler":false},{"segments":[{"spoiler":false,"text":"王国の外れにある森に、ひとり暮らしている魔女。"},{"spoiler":false,"text":"数百年の時を生きているとも言われている。"},{"spoiler":false,"text":"彼女に気に入られれば、どんな願いでも叶えてもらえると言われているが、それには大きな代償が必要。"},{"spoiler":false,"text":"アロイスとエーファを元に戻してやる代償として、アロイスを自らの魔力を蓄えるための欲望奴隷とし、エーファを自分の手足とするための魔女に仕立て上げようとする。"},{"spoiler":false,"text":"欲望にひたすら忠実で、好悪の別が激しく、自分に逆らうものに対しては容赦しない。"},{"spoiler":false,"text":"興味のない人間の命など、道ばたの雑草程度にしか思っておらず、邪悪な魔術の実験材料にすることもしばしば。"}],"source":"bangumi","sourceCharacterId":"92619"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f14c9aaebbc6541115228b64aed9eb9ccad8d76a1ae67caa3fd0eb0c5081af4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/665c1566fdf6e9746d61020d7719057f136974734f2132d55461bb7e38df6d71.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阿久野 真帆","creatorId":"vndb:s3282","sourcePersonId":"vndb:s3282","canonicalEntityId":"vndb:s3282","name":"阿久野 真帆","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9035","source":"vndb"}]},{"characterId":"char_c29611","characterName":"ノイ","sourceIds":{"bangumi":[{"characterId":"92620","match":"exact-normalized-name-in-linked-work","subjectId":"197414"}],"egsCharacterIds":["18611"],"vndbCharacterId":"c29611"},"originalCharacterName":"ノイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヨランデの館にある、入口のない塔に住んでいる少女。"},{"spoiler":false,"text":"ヨランデ以外の人間を知らず、世の中のことをほとんど知らない。"},{"spoiler":false,"text":"無邪気で素直な性格だが、ヨランデに育てられたせいで、基本的な善悪もよくわかっていないが、毎晩のように、ヨランデに性の指導を受けているため、男を知らないにも関わらず、その性技は巧みである。"},{"spoiler":false,"text":"「ノイは楽しいこと大好き、イヤらしいことも大好き。みんなでいっしょに気持ち良くなりたいな」"}],"source":"egs","sourceCharacterId":"18611","sourceWorkId":"10557","spoiler":false},{"segments":[{"spoiler":false,"text":"ヨランデの館にある、入り口のない高い塔にひとりぼっちで住んでいる少女。"},{"spoiler":false,"text":"ヨランデの娘とも、ヨランデにさらわれた子供とも言われているが、その真偽は不明。"},{"spoiler":false,"text":"ヨランデ以外の人間と会ったことがないので、世の中のことをほとんど知らない。"},{"spoiler":false,"text":"無邪気で素直な性格だが、ヨ基本的な善悪もよく分かっていない。"},{"spoiler":false,"text":"ヨランデから毎晩のように性の指導を受けており、男を見たことがないにも関わらず、その性技は巧み。"}],"source":"bangumi","sourceCharacterId":"92620"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"f","source":"vndb","sourceCharacterId":"c29611","value":"f"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"18611","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"18611","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"92620","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42687c52c5be16f89b0f88ec4b963de66429fbc686abeb8bb0faa25b5f8ca17a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86c8e4e598828d315ceb851fc338a4eff6dfa3542973d608ce35fc7e222cf455.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197414:92620:6409:1","source":"bangumi"}]},{"characterId":"char_vndb_c132477","characterName":"黒い獣人","sourceIds":{"vndbCharacterId":"c132477"},"originalCharacterName":"黒い獣人","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.dat