{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"11368","model":{"presentationWorkId":"vndb:v1154","staff":{"artwork":[{"creditedName":"あらきまき","creatorId":"vndb:s2830","sourcePersonId":"egs:creator:1457","canonicalEntityId":"vndb:s2830","name":"あらきまき","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:71235","source":"egs"}],"scenario":[{"creditedName":"藤原将(藤原たすく)","creatorId":"vndb:s8572","sourcePersonId":"egs:creator:1399","canonicalEntityId":"vndb:s8572","name":"藤原将(藤原たすく)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:71236","source":"egs"}],"music":[{"creditedName":"yan@trinitei(鳥煮亭)","creatorId":"vndb:s1262","sourcePersonId":"egs:creator:3130","canonicalEntityId":"vndb:s1262","name":"yan@trinitei(鳥煮亭)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:81736","source":"egs"},{"creditedName":"片霧 烈火","creatorId":"vndb:s419","sourcePersonId":"vndb:s419","canonicalEntityId":"vndb:s419","name":"片霧 烈火","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:20820","source":"vndb"},{"creditedName":"HIR","creatorId":"vndb:s4847","sourcePersonId":"vndb:s4847","canonicalEntityId":"vndb:s4847","name":"HIR","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:20825","source":"vndb"}],"other":[{"creditedName":"片霧烈火","creatorId":"vndb:s419","sourcePersonId":"egs:creator:4521","canonicalEntityId":"vndb:s419","name":"片霧烈火","detail":"OP曲「ちぇいすと☆ちぇいすっ！」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:83854","source":"egs"},{"creditedName":"茶太","creatorId":"vndb:s203","sourcePersonId":"egs:creator:12879","canonicalEntityId":"vndb:s203","name":"茶太","detail":"OP曲「ちぇいすと☆ちぇいすっ！」、ED曲「愛のゆくえ」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:83872","source":"egs"},{"creditedName":"茶太","creatorId":"vndb:s203","sourcePersonId":"vndb:s203","canonicalEntityId":"vndb:s203","name":"茶太","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:20819","source":"vndb"},{"creditedName":"片霧 烈火","creatorId":"vndb:s419","sourcePersonId":"vndb:s419","canonicalEntityId":"vndb:s419","name":"片霧 烈火","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:20821","source":"vndb"},{"creditedName":"あらき まき","creatorId":"vndb:s2830","sourcePersonId":"vndb:s2830","canonicalEntityId":"vndb:s2830","name":"あらき まき","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:20823","source":"vndb"},{"creditedName":"藤原 将","creatorId":"vndb:s8572","sourcePersonId":"vndb:s8572","canonicalEntityId":"vndb:s8572","name":"藤原 たすく","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:20827","source":"vndb"},{"creditedName":"藤原 将","creatorId":"vndb:s8572","sourcePersonId":"vndb:s8572","canonicalEntityId":"vndb:s8572","name":"藤原 たすく","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:20828","source":"vndb"}]},"cast":[{"characterId":"char_c51414","characterName":"朝香 真名","sourceIds":{"bangumi":[{"characterId":"22943","match":"exact-normalized-name-in-linked-work","subjectId":"41514"}],"egsCharacterIds":["16600"],"vndbCharacterId":"c51414"},"originalCharacterName":"朝香 真名","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染。明るく朗らかな少女。"},{"spoiler":false,"text":"純真無垢だが、砕けた感じの口調で話し、誰とでも仲良くなれる。"},{"spoiler":false,"text":"その性格から、学園でも人気者。"},{"spoiler":false,"text":"将来の夢は人の役に立つ国際ボランティアや介護師、看護師。"},{"spoiler":false,"text":"性的なことは疎く、恥じらいも強い。"},{"spoiler":false,"text":"しかし彼女に取り憑くのは、古めかしい言葉を使う、エッチが大好きな姫神。"},{"spoiler":false,"text":"「相手が姫神でも誰でも一緒だよ。"},{"spoiler":false,"text":"困ってる人がいて、あたしの手で足りることならお手伝いしてあげたいもん」"}],"source":"egs","sourceCharacterId":"16600","sourceWorkId":"11368","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の隣家に住んでる幼なじみ。"},{"spoiler":false,"text":"明るく朗らかで無邪気、穢れを知らない無垢な少女。"},{"spoiler":false,"text":"だれに対しても砕けたしゃべり方をしていて、すぐにだれとでも仲良くなれる。"},{"spoiler":false,"text":"男子からの人気も高く、教師や先輩などからも可愛がられていて、世の中をうまく渡っていける。"},{"spoiler":false,"text":"ラブアンドピース、人類皆兄弟説信者でボランティア活動が趣味。将来は人の役に立つ国際ボランティアや介護師、看護師をやりたいと思っている。"},{"spoiler":false,"text":"能天気なのだが、性的なことにはやや疎く恥じらいも強い。"},{"spoiler":false,"text":"そんな真名に取り憑くのは、古めかしい言葉を使う、エッチが大好きな土地神様。"},{"spoiler":false,"text":"「相手が土地神様でも誰でも一緒だよ。困ってる人がいて、あたしの手で足りることならお手伝いしてあげたいもん」"}],"source":"bangumi","sourceCharacterId":"22943"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d9a0b9a76a08debd25a9c700f12b10f4fa4ce5419ee41e14529e0e2df00b3f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18a496368d2e47b41f333b3d4a8c75b6be242fbc3e97e6292e7334368f29d219.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中島沙樹","creatorId":"vndb:s44","sourcePersonId":"vndb:s44","canonicalEntityId":"vndb:s44","name":"中島 沙樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41514:22943:4500:1","source":"bangumi"}]},{"characterId":"char_c51415","characterName":"桐 にしき","sourceIds":{"bangumi":[{"characterId":"22945","match":"exact-normalized-name-in-linked-work","subjectId":"41514"}],"egsCharacterIds":["16601"],"vndbCharacterId":"c51415"},"originalCharacterName":"桐 にしき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と真名のクラスの学級委員長。"},{"spoiler":false,"text":"規律に厳しく、融通の利かない典型的委員長タイプ。クラスでもちょっとウザがられ気味。"},{"spoiler":false,"text":"しかし、容姿はモデル並で隠れたファンも多い。"},{"spoiler":false,"text":"勉強が得意な主人公をライバル視している。"},{"spoiler":false,"text":"家が古めかしい洋食屋だが、手伝いをするのがあまり好きではない。"},{"spoiler":false,"text":"生真面目なことが取り得のにしきに憑依するのは、泣き虫で感動屋のアマツ。"},{"spoiler":false,"text":"きびきびした話し方が幼児言葉になってしまう。"},{"spoiler":false,"text":"「ちょっと朝香さん？　あなた今日は日直でしょう、どうしてもう少し早くに登校できないの？」"}],"source":"egs","sourceCharacterId":"16601","sourceWorkId":"11368","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と真名のクラスの学級委員長。"},{"spoiler":false,"text":"規律正しすぎる性格で融通が利かず、クラスメイトからちょっとウザがられている。しかし黙っていればモデル並の美人なので、男子からは隠れた人気がある。"},{"spoiler":false,"text":"学業において主人公をライバル視していて、文武両道の完璧超人なのに万年2位な人。"},{"spoiler":false,"text":"家は両親だけで切り盛りしている古びた洋食屋。あまり裕福ではないのでにしきも時々手伝いをするが、正直あまり好きな仕事ではない。"},{"spoiler":false,"text":"生真面目が取り得のにしきに憑依するのは、泣き虫で感動屋のアマツ。きびきびとした話し方が幼児言葉になってしまう。"},{"spoiler":false,"text":"「ちょっと朝香さん？　あなた今日は日直でしょう、どうしてもう少し早くに登校できないの？」"}],"source":"bangumi","sourceCharacterId":"22945"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e520b7501945b903783cf52b3b06f4a589a3a8d58c6bcd241b0d4fe2b0e9cb89.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/5607900142236e1f0614c2733d0ef2b200a28f6e67965fc8b6184073066ece10.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊原ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41514:22945:4916:1","source":"bangumi"}]},{"characterId":"char_c51416","characterName":"瀬部 エレン","sourceIds":{"bangumi":[{"characterId":"22946","match":"exact-normalized-name-in-linked-work","subjectId":"41514"}],"egsCharacterIds":["16602"],"vndbCharacterId":"c51416"},"originalCharacterName":"瀬部 エレン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同じ文芸部員。裕福な家庭に育ったお嬢様。"},{"spoiler":false,"text":"母親がアメリカ人のハーフだが、英語はあまり話せない。"},{"spoiler":false,"text":"そればかりか日本語もあまり話さない寡黙な少女。いつも読書ばかりしている。"},{"spoiler":false,"text":"他人に興味がなさそうだが、何故か主人公のことは気になっている。"},{"spoiler":false,"text":"両親の仕事の都合で、家は老執事、家政婦と過ごすことがほとんど。"},{"spoiler":false,"text":"しかし、一人っ子なので両親は彼女を溺愛している。"},{"spoiler":false,"text":"まったく喋らないエレンに取り憑くのは、おしゃべり大好きなカナデ。"},{"spoiler":false,"text":"病弱で儚そうなエレンがカナデに取り憑かれて喋りまくりになる。"},{"spoiler":false,"text":"「……知らない」"}],"source":"egs","sourceCharacterId":"16602","sourceWorkId":"11368","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同じ文芸部員。母親がアメリカ人のハーフ。"},{"spoiler":false,"text":"でも英語はあまり話せない。そして日本語もあまり話さない。"},{"spoiler":false,"text":"寡黙で表情に乏しく、いつも読書ばかりしている。"},{"spoiler":false,"text":"基本的に他人には興味を抱かないが、主人公のことはなぜか気になっている様子。"},{"spoiler":false,"text":"家は裕福だが両親は仕事で家を空けていることが多く、老執事や家政婦と共に暮らしてきた。ひとりっ子のため両親はエレンを溺愛していて、箱入りで育てられる。"},{"spoiler":false,"text":"まったく喋らないエレンに取り憑くのは、おしゃべり大好きなカナデ。"},{"spoiler":false,"text":"病弱で儚そうなエレンが、カナデに取り憑かれると口が止まらなくなる。"},{"spoiler":false,"text":"「……知らない」"}],"source":"bangumi","sourceCharacterId":"22946"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13fa3e2b8f797b99cfbba77c63f7144e948d90d52985c17ab3a4951a5c75adee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44163fb7e08a18bcd7e95653a08adfde3923ebae2e436ef823f4625c4574c2bf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41514:22946:4646:1","source":"bangumi"}]},{"characterId":"char_c51417","characterName":"諸音 野乃子","sourceIds":{"bangumi":[{"characterId":"22947","match":"exact-normalized-name-in-linked-work","subjectId":"41514"}],"egsCharacterIds":["16603"],"vndbCharacterId":"c51417"},"originalCharacterName":"諸音 野乃子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真名の親友。"},{"spoiler":false,"text":"気弱で人見知りが激しく、いつも真名の後ろに隠れている。男性は特に苦手。"},{"spoiler":false,"text":"主人公と彼の親友“みつを”だけがかろうじて話せる男性。"},{"spoiler":false,"text":"幼少のころに関西圏にいたため、焦ると方言が出る。"},{"spoiler":false,"text":"双子のやんちゃな弟妹の世話を焼くのに大変な日々。でも二人とも大好き。ピアノのたしなみがあり、腕前もなかなか。"},{"spoiler":false,"text":"人見知りが激しく、男性が苦手な野乃子に取り憑くのは姫神並かそれ以上にエッチが好きな万年発情のシズク。"},{"spoiler":false,"text":"男性が苦手なのに男たちを誘惑していくことになる。"},{"spoiler":false,"text":"「あたしは手芸部です！　保健委員もやらせてもらっています！趣味はピアノです！　それから、それからっ……っ」"}],"source":"egs","sourceCharacterId":"16603","sourceWorkId":"11368","spoiler":false},{"segments":[{"spoiler":false,"text":"真名の親友。すぐに真名の後ろに隠れてしまうほど気弱で人見知りが激しく、男性が苦手。"},{"spoiler":false,"text":"勇は数少ない“かろうじて話すことのできる”男性。"},{"spoiler":false,"text":"幼い頃は関西圏に住んでいて、焦ると方言が出てしまう。"},{"spoiler":false,"text":"小学生になる双子の弟妹がおり、やんちゃで手を焼いているが凄く好き。"},{"spoiler":false,"text":"家にグランドピアノがあり、ピアノを弾くことが好きで腕前もなかなかのもの。"},{"spoiler":false,"text":"人見知りが激しく男性が苦手な野乃子に取り憑くのは、姫神以上にエッチが好きな万年発情のシズク。"},{"spoiler":false,"text":"男性が苦手なのに男たちを誘惑していくことになる。"},{"spoiler":false,"text":"「あたしは手芸部です！　保健委員もやらせてもらっています！　趣味はピアノです！　それから、それからっ……っ」"}],"source":"bangumi","sourceCharacterId":"22947"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3764a60653c179ba71f8edd48251749761c624266d5da8b958e4d2ae1bcc9ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/998782346f7d30ab247f259bf61631735108b25c4732352fbc1a3e232af91f6e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41514:22947:4727:1","source":"bangumi"}]},{"characterId":"char_c51418","characterName":"姫神","sourceIds":{"bangumi":[{"characterId":"22944","match":"exact-normalized-name-in-linked-work","subjectId":"41514"}],"egsCharacterIds":["16604"],"vndbCharacterId":"c51418"},"originalCharacterName":"姫神","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真名に取り憑く姫ノ宮の土地神様。名前はない(人間には言えない)。"},{"spoiler":false,"text":"昔話で登場する“神追い”の神からは数代目。"},{"spoiler":false,"text":"若い神ではあるが、土地とそこに住む人々、そして近侍たちを愛している。"},{"spoiler":false,"text":"ただし、ちょっとエロい。"},{"spoiler":false,"text":"「ふっふっふっ。聞かれて名乗るもおこがましいが、"},{"spoiler":false,"text":"わしこそは恐れ多くも姫ノ宮の地神にして美岳の主たる姫神ぞ！」"}],"source":"egs","sourceCharacterId":"16604","sourceWorkId":"11368","spoiler":false},{"segments":[{"spoiler":false,"text":"真名に取り憑く姫ノ宮の土地神様。名前はない（人間には言えない）。"},{"spoiler":false,"text":"昔話にある神追いの神様からはすでに数代の世代交代をしている。"},{"spoiler":false,"text":"神様だけあってやや尊大な物言いだが、人柄は悪くない。素直で子供っぽくもあり、ひどく老獪な感もある。神様としては、まだ若い部類。"},{"spoiler":false,"text":"この土地と人々、そして近侍たちを愛しており、すべてを見守る目線を持っている。ただ、ちょっとエロい。エッチな時は、やたらと濃厚な熟女っぽくなる。"},{"spoiler":false,"text":"ちなみに、神様や近侍たちは総じて性に対する抑圧が薄いが、それは倫理観が人間と違うからであって、決して淫乱であったり快楽主義者であったりということではない。"},{"spoiler":false,"text":"「ふっふっふっ。聞かれて名乗るもおこがましいが、わしこそは恐れ多くも姫ノ宮の地神にして美岳の主たる姫神ぞ！」"}],"source":"bangumi","sourceCharacterId":"22944"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/208977786dfca5fa020646f3f67da2aca5a96f07b6a16215a47540018a55c4cb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11a74f043e75625d90d850d7b4841aea96845ece7bc8c4419e88f5d2cfb16d46.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"萩原えみこ","creatorId":"vndb:s867","sourcePersonId":"vndb:s867","canonicalEntityId":"vndb:s867","name":"萩原 えみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41514:22944:4854:1","source":"bangumi"}]},{"characterId":"char_c51419","characterName":"アマツ","sourceIds":{"bangumi":[],"egsCharacterIds":["16605"],"vndbCharacterId":"c51419"},"originalCharacterName":"アマツ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"姫神の近侍。"},{"spoiler":false,"text":"泣き虫で気弱なキツネの精。凛として気丈なにしきに取り憑く。"},{"spoiler":false,"text":"近侍の中では一番弱い立場だが、だからこそ一生懸命逃げる、妙な律儀さがある。"},{"spoiler":false,"text":"感極まるとキツネの耳や尻尾が生える。"},{"spoiler":false,"text":"(霊的なものなので他人には見えない)"},{"spoiler":false,"text":"「んく？　ふえ？　　あ……ごごごめんなしゃい、ごめんなしゃいでしゅっ！」"}],"source":"egs","sourceCharacterId":"16605","sourceWorkId":"11368","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4ab138ebc22bb9848bb1e3c6fb972cb74f860a1fb842d54e8071ef21d300ca60.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3be5aa08a30bb45111a5d08c4835a34d61920369b493247f0eb2695c48130d4a.webp","width":256,"height":200,"source":"static-detail"},"actors":[{"creditedName":"真中 まりも","creatorId":"vndb:s131","sourcePersonId":"vndb:s131","canonicalEntityId":"vndb:s131","name":"水橋 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10501","source":"vndb"}]},{"characterId":"char_c51420","characterName":"カナデ","sourceIds":{"bangumi":[],"egsCharacterIds":["16606"],"vndbCharacterId":"c51420"},"originalCharacterName":"カナデ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"姫神の近侍。"},{"spoiler":false,"text":"派手で明るい山鳥の精。寡黙で無表情なエレンに取り憑く。"},{"spoiler":false,"text":"祭りの前に街に下りようと提案する張本人。"},{"spoiler":false,"text":"猪突猛進で明るく楽しいことが大好き。"},{"spoiler":false,"text":"興奮するとトリの翼が生えて飛べる。"},{"spoiler":false,"text":"(霊的なものなので他人には見えない)"},{"spoiler":false,"text":"「そうですそうですっ、カナデたちがやらねばならぬのですますっ、お祭りまでに、里をきれいきれいするのですー！」"}],"source":"egs","sourceCharacterId":"16606","sourceWorkId":"11368","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1cfd7899c678e5a8f3492bd028a180ced0faf087470200a45025a42fe28c13f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e700fca4d9dd513f7e635d7da68d8b571fabe2b2cf27cfeee3d60fd21a05c792.webp","width":256,"height":200,"source":"static-detail"},"actors":[{"creditedName":"榊 るな","creatorId":"vndb:s654","sourcePersonId":"vndb:s654","canonicalEntityId":"vndb:s654","name":"小暮 英麻","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10499","source":"vndb"}]},{"characterId":"char_c51421","characterName":"シズク","sourceIds":{"bangumi":[],"egsCharacterIds":["16607"],"vndbCharacterId":"c51421"},"originalCharacterName":"シズク","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"姫神の近侍。"},{"spoiler":false,"text":"万年発情気味なウサギの精。気弱で男子が苦手な野乃子に取り憑く。"},{"spoiler":false,"text":"いたずら