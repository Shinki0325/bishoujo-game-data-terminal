{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"31721","model":{"presentationWorkId":"vndb:v29040","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c113913","characterName":"ルシフェル・Ｃ・サンレイズ","sourceIds":{"vndbCharacterId":"c113913"},"originalCharacterName":"ルシフェル・Ｃ・サンレイズ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Although she lost her memories of her past life, and she was taken to Hell without knowing anything."},{"spoiler":false,"text":"She has a blunt and honest personality, and isn't even frightened by the presence of an angel."},{"spoiler":false,"text":"Using throwing knives and moving with wires, she prefers close-quarters combat. A meat-loving glutton."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c113913"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af114ea37dcca26aa339dde54733e071db29e8bc7a1817c35fdb4920150df21f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/828fd2bd3f95dfdd9c1bdd04c8d8b32a325c7bdddbb03b52e75ae9a7a98cb7c6.webp","width":183,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c113914","characterName":"ナルガ・Ｎ・ネビロス","sourceIds":{"vndbCharacterId":"c113914"},"originalCharacterName":"ナルガ・Ｎ・ネビロス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Royale participant who proposed that Lucy should assassinate an angel."},{"spoiler":false,"text":"He claims to be a former killer, but he's still very secretive. Even his name is only a pseudonym."},{"spoiler":false,"text":"He's ruthless and out of control, yet always remains calm. Compared to Lucy he's bad at close combat, but he outwits his opponents with his high shooting abilities and clever tricks."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c113914"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aec1587eb58e72dc4b98e4963d504dc09664e93014b4fac8070e5ef70083891c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7d92fd1b96a62b961428f604f32bbbcd7298bd6a77bf6dbeeea0abdc870cb9c.webp","width":131,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c113916","characterName":"ラビ・Ｌ・アスタロト","sourceIds":{"vndbCharacterId":"c113916"},"originalCharacterName":"ラビ・Ｌ・アスタロト","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Royale participant who claims to have known Lucy when she was alive but couldn't even remember her name."},{"spoiler":false,"text":"She has murderous intent for people who stand in her way. It's easy to read her emotions and she often stutters."},{"spoiler":false,"text":"However, contrary to her personality, she is highly skilled in combat and can wield knives."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c113916"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8d39fbe600e657ee39f35e5bc07ebabe10e83b5781e7fbfc96742650be9ef17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22c285973cd85018019d78a42dfc7dbf6724e5175a28915f050ba1190a9acbbf.webp","width":131,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c113917","characterName":"アザゼル","sourceIds":{"vndbCharacterId":"c113917"},"originalCharacterName":"アザゼル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An archangel with a sword."},{"spoiler":false,"text":"He is the chief angel who protects the Heavenly Order, but he has a self-centered and negligent personality. He is overconfident and likes beautiful girls."},{"spoiler":false,"text":"He's interested in the winner of the Royale, and is not interested in the information and battles of each participant."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c113917"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b49946462cdd3068349c1761282ed7ac99543ebb8b4ff162ea5e706d4cb81495.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/129960a19216a7a65252e347de0f659e54ecddbe4ddb277256349b269576bce8.webp","width":157,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c113918","characterName":"レミエル","sourceIds":{"vndbCharacterId":"c113918"},"originalCharacterName":"レミエル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A senior angel who wields a bow. Rumored to be the strongest female angel."},{"spoiler":false,"text":"She has a cute appearance, but her personality is problematic."},{"spoiler":false,"text":"She is also an idol who captivates the inhabitants of heaven, and is affectionately nicknamed \"Remi-tan\" by her fans."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c113918"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e3bb95f42b53d3b96c4bba1946f4d0184229db6482ca24c00a4cbf6628f75f4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc37f12680cde52e357b50d4059644ae261e826f81c145d2123e9157e1429ca1.webp","width":157,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c113919","characterName":"べリアル","sourceIds":{"vndbCharacterId":"c113919"},"originalCharacterName":"べリアル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A senior angel who wields a spear. Possessing strength second only to Azazel, he holds a long spear with ease."},{"spoiler":false,"text":"Strangely for an angel, he has a serious personality and pledges allegiance to Azazel. He likes to work out."},{"spoiler":false,"text":"A self-proclaimed gentleman who swears he won't lay a hand on a woman. He won't forgive anyone who uses cowardly means."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c113919"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef81ee6cf5e21bb292a1c48975def2861b952222ae5303d98098cf04b11ac826.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/202fe133f87a7c76bfff72f056d592e851ce6cc2b2124303b07c64d46dbd267b.webp","width":157,"height":256,"source":"s