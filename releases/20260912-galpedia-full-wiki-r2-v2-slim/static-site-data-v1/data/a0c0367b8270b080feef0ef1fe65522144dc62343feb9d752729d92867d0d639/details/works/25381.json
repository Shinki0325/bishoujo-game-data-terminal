.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a6f1844cde2c641b91aa84c0c7440306e269a4d7d9ea0d52dc6135907329143.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c4829","characterName":"一十木 音也","sourceIds":{"vndbCharacterId":"c4829"},"originalCharacterName":"一十木 音也","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"411"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Otoya is an energetic, cheerful and kind boy. He is a positive and friendly person who enjoys singing and playing sports."},{"spoiler":false,"text":"Despite his age, he acts like a child and is always straightforward and honest."},{"spoiler":false,"text":"He is afraid of heights and plays the guitar."},{"spoiler":false,"text":"He shares a room with Tokiya from Class S and is in Class A."}],"source":"vndb","sourceCharacterId":"c4829"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b761207fa8ab0d6ccea671597f7567e64c41ce7c35f27b7c833d13db66dc6e11.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/193a6e1e8ccf2b665dcd9baa3f20ce503ef6eb0b5282ffd228e14c0f7862515a.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"寺島 拓篤","creatorId":"vndb:s63","sourcePersonId":"vndb:s63","canonicalEntityId":"vndb:s63","name":"寺島 拓篤","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:32212","source":