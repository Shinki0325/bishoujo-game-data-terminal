reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She lived near the protagonist´s house."},{"spoiler":false,"text":"Their mothers are very close and good friends."},{"spoiler":false,"text":"The protagonist was affectionate with her since they were children."},{"spoiler":false,"text":"That is why she tries to be kind to younger people and aims to become a nursery teacher."},{"spoiler":false,"text":"Although she lived in the suburbs, life in the big city wasn't a bad influence for her."},{"spoiler":false,"text":"She knows a little about sexual relationships since she heard stories of her friends' experiences."},{"spoiler":false,"text":"She's a good cook, her strong point is at simple stews and Japanese-style food."},{"spoiler":false,"text":"Back at home she had a lot of contact with the neighborhood children, but this is her first time practising at a real nursery."},{"spoiler":false,"text":"She is well received by the nursery children and quickly became popular with them."},{"spoiler":false,"text":"She is called \"Akane-chan\"."}],"source":"vndb","sourceCharacterId":"c87525"},{"segments":[{"spoiler":false,"text":"主人公の実家の近くに住んでいる。"},{"spoiler":false,"text":"家族ぐるみのお付き合い。母親同士、すごく仲がいい。"},{"spoiler":false,"text":"幼い頃から主人公に可愛がられていた。"},{"spoiler":false,"text":"その事もあり自分も年下には優しくしなきゃ、と心がけ、地元の子供と接する内に子供好きになり、保育科を志す。"},{"spoiler":false,"text":"郊外住みで都会の悪影響を受けておらず、純朴そのものだが、"},{"spoiler":false,"text":"友人の体験談を聞かされてるため、多少、耳年増。"},{"spoiler":false,"text":"料理上手で素朴な煮物や、和食が得意。"},{"spoiler":false,"text":"地元の子供たちとはよく触れ合っていたが、幼稚園での実習は今回が初。"},{"spoiler":false,"text":"園児たちの受けは良く、一瞬で人気者に。"},{"spoiler":false,"text":"『あかねーちゃん』と呼ばれている。"}],"source":"egs","sourceCharacterId":"22114","sourceWorkId":"28793","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の実家の近くに住んでいる。"},{"spoiler":false,"text":"家族ぐるみのお付き合い。母親同士、すごく仲がいい。"},{"spoiler":false,"text":"幼い頃から主人公に可愛がられていた。"},{"spoiler":false,"text":"その事もあり自分も年下には優しくしなきゃ、と心がけ、地元の子供と接する内に子供好きになり、保育科を志す。"},{"spoiler":false,"text":"郊外住みで都会の悪影響を受けておらず、純朴そのもの。"},{"spoiler":false,"text":"友人の体験談を聞かされてるため、多少、耳年増。"},{"spoiler":false,"text":"料理上手で、素朴な煮物や和食が得意。"},{"spoiler":false,"text":"地元の子供たちとはよく触れ合っていたが、幼稚園での実習は今回が初。"},{"spoiler":false,"text":"園児たちの受けは良く、一瞬で人気者に。"},{"spoiler":false,"text":"『あかねーちゃん』と呼ばれる。"}],"source":"bangumi","sourceCharacterId":"87110"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"87110","value":"2年生"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/befd6163270506fc4c3c766efb1d7580f03ed9d5fefd8900745a63d27faf4d70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db418ac269735d7c37e38ae93c915493475c1e612e138e037eec3eb9b5da33d4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山本希望","creatorId":"vndb:s1455","sourcePersonId":"vndb:s1455","canonicalEntityId":"vndb:s1455","name":"山本 希望","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:293400:87110:7147:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p6066","sourceCompanyId":"egs:brand:781","canonicalEntityId":"vndb:p6066","name":"エンターグラム","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:30819:781","source":"egs"},{"companyId":"vndb:p6978","sourceCompanyId":"vndb:p6978","canonicalEntityId":"vndb:p6978","name":"プレカノ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relation