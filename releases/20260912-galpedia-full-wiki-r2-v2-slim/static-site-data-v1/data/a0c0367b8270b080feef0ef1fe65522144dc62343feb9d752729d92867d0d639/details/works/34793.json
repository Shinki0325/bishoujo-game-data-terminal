{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"34793","model":{"presentationWorkId":"vndb:v22450","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c101302","characterName":"雪田 風太","sourceIds":{"vndbCharacterId":"c101302"},"originalCharacterName":"雪田 風太","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"810"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man with a bad personality, who lacks expression and is deadly popular for some reason. From women he receives unconditional love; from men, in turn, antipathy, so he has no friends. Even the fact that he is constantly starting relationships is merely a pretext for making a substitute for a friend."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c101302"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0cac161161d44d6ee03ceb70519a7235293a6b58c83e6480315cdf36068b0bb0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d7b77455640005640a5a4a32f04eea9ae6235cfd37eaf425693341c6cb6353d.webp","width":104,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c101303","characterName":"天羽 花","sourceIds":{"vndbCharacterId":"c101303"},"originalCharacterName":"天羽 花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"423"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Fuuta's classmate and his childhood friends from before he entered kindergarten. At school, she does not speak with him much, yet, as her house is next door, every day she comes to greet him when he returns from school. An honor student who excels in both academics and sports. She has a calm personality."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c101303"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52036031223078760ccabc5c1c7a127e5605b7895c270aa1cf574c6645d6be90.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a65b48926775dab50185b707535b1ca21f087732ecdaf6c77e517f06dfa3df1.webp","width":122,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c101304","characterName":"鳥野 月子","sourceIds":{"vndbCharacterId":"c101304"},"originalCharacterName":"鳥野 月子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1031"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a kouhai, who confessed to Fuuta and became his girlfriend. Her bright personality, coupled with her small constitution, makes an impressive combination. She is still very young. She told Fuuta about her feelings directly and was happy due to longing for him for so long."},{"spoiler":false,"text":"Translated from the official site."}],"source":"vndb","sourceCharacterId":"c101304"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e50551eb65a0afa6c7ca2c884357579b7774c9c0e48e2b3ab9f92af96c10e8f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/i