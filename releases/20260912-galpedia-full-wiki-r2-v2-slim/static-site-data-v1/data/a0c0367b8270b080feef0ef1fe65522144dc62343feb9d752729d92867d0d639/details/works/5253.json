ationId":"vndb:vn-staff:87098","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c5276","characterName":"パルフェ・シュクレール","sourceIds":{"vndbCharacterId":"c5276"},"originalCharacterName":"パルフェ・シュクレール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A witch apprentice who inherited the \"Black Cat Magic Shop\" from her deceased mother. She is a third-year high school student at Flor Hermos Magic Academy, but she is taking a leave of absence to concentrate on running the store. Parfait's father was a court mage, but her died when Parfait was just one year old. Despite that, Parfait has a cheerful disposition. She is clumsy and prefers to do things at her own pace. Her catchphrase is \"Hamyu\"."},{"spoiler":false,"text":"Translated from Wikipedia."}],"source":"vndb","sourceCharacterId":"c5276"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/498b7bc27173bc970732099772a3e5e952936da6795923f90bd3e50b10896312.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b5a7916b13b8d5363dd4dcb154430b898c55f0741252b886cedfe9c50ac33ea.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"古山 きみこ","creatorId":"vndb:s1596","sourcePersonId":"vndb:s1596","canonicalEntityId":"vndb:s1596","name":"こやま きみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46194","source":"vndb"},{"creditedName":"김 수경","creatorId":"vndb:s25630","sourcePersonId":"vndb:s25630","canonicalEntityId":"vndb:s25630","name":"김 수경","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46198","source":"vndb"}]},{"characterId":"char_vndb_c5283","characterName":"サケマス","sourceIds":{"vndbCharacterId":"c5283"},"originalCharacterName":"サケマス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A male black cat who acts as a familiar of Parfait. He can understand and speak human language, but he can be rude sometimes. Sakemasu's hair is tinged with magic, so from time to time it is used as a material of the store's products."},{"spoiler":false,"text":"Translated from Wikipedia."}],"source":"vndb","sourceCharacterId":"c5283"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cd20e1ad7c0caacd42b73f98c1f8cc0f5f45a277606e0f008bb939cde75a987.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d79ff5019be7560de3de61faf2f7593a503e467e69dadca01bd2a711de8e5027.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三田 ゆう子","creatorId":"vndb:s11949","sourcePersonId":"vndb:s11949","canonicalEntityId":"vndb:s11949","name":"三田 ゆう子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46196","source":"vndb"}]},{"characterId":"char_vndb_c5284","characterName":"フローレ・ミルフィア","sourceIds":{"vndbCharacterId":"c5284"},"originalCharacterName":"フローレ・ミルフィア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Parfait and Reinette's classmate, though Flore is a best friends with Parfait."},{"spoiler":false,"text":"Flore has a gentle personality with a strong core. Her body is naturally weak, but she possesses a mysterious ability to talk to plants. Her dream is to run a flower shop in the future."},{"spoiler":false,"text":"Translated from Wikipedia"}],"source":"vndb","sourceCharacterId":"c5284"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49d6c7fd5b9a94767772bd498e02949eb2b5ae6df3a2cc7ebcef200d5ef477df.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40a2889e1ebe83e74cca9a10305e31c3b4ebc3418a6e7beaf2d18b31cdf0edb5.webp","width":198,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三五 美奈子","creatorId":"vndb:s2139","sourcePersonId":"vndb:s2139","canonicalEntityId":"vndb:s2139","name":"三五 美奈子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46195","source":"vndb"}]},{"characterId":"char_vndb_c56343","characterName":"ココット＝キルシュ","sourceIds":{"vndbCharacterId":"c56343"},"originalCharacterName":"ココット＝キルシュ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"12"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Reinette's younger sister, a high school freshman in the Magic Academy. She runs the Smile magic store on behalf of her sister, when the latter is busy collecting and blending ingredients. Unlike her sister, Cocotte has a cheerful and straightforward personality, and she seems to have more emotions towards Parfait than to her sister's friends. Cocotte's hobby is reading shoujo manga."},{"spoiler":false,"text":"Translated from Wikipedia"}],"source":"vndb","sourceCharacterId":"c56343"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/