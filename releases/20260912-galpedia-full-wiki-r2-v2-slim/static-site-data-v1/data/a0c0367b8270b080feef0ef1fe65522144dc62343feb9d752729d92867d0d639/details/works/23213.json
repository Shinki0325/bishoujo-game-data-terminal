s living in the same apartment complex as the protagonist. Loves gossip and interesting stories. She finds out about the protagonist's affair with Yukari, and offered to introduce more women to him who wants to have children, if he will accept her one condition."}],"source":"vndb","sourceCharacterId":"c46469"},{"segments":[{"spoiler":false,"text":"マンション事情に精通した噂好きの主婦。"},{"spoiler":false,"text":"他の住人同様、自身もセックスレスの夫婦仲に悩みを抱えている一人。"},{"spoiler":false,"text":"旦那のためにジムに通って体型維持を努めてはいるものの、なかなか相手にしてもらえず、ストレスが溜まっている。"},{"spoiler":false,"text":"特別、子供が欲しいというわけではないが、他の住人と主人公の関係を知り、密かにうらやましいと思っているとかいないとか‥‥。"}],"source":"egs","sourceCharacterId":"8055","sourceWorkId":"23213","spoiler":false},{"segments":[{"spoiler":false,"text":"マンション事情に精通した噂好きの主婦。"},{"spoiler":false,"text":"他の住人同様、自身もセックスレスな夫婦仲に悩みを抱えている一人。"},{"spoiler":false,"text":"旦那のためにジムに通って体型維持に努めてはいるものの、"},{"spoiler":false,"text":"なかなか相手にしてもらえず、ストレスが溜まっている。"},{"spoiler":false,"text":"特別 子供が欲しいというわけではないが、他の住人と主人公の関係を知り、"},{"spoiler":false,"text":"密かにうらやましいと思っているとかいないとか……。"},{"spoiler":false,"text":"「それでどうなの？　ふたりは浮気しちゃってるの？」"}],"source":"bangumi","sourceCharacterId":"44303"}],"profileFacts":[{"label":"年龄（本版本）","value":"27 岁","valueContext":null,"source":"egs","sourceCharacterId":"8055","sourceWorkId":"23213","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"8055","sourceWorkId":"23213","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"8055","sourceWorkId":"23213","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"8055","sourceWorkId":"23213","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"8055","sourceWorkId":"23213","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/