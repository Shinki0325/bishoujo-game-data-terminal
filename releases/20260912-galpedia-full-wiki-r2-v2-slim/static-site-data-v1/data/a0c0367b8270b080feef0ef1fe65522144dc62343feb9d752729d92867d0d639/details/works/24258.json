value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"天真爛漫な性格でとことん前向き、人間の善意と正義を信じる少女。そこに居るだけで、周囲が癒やされる優しい心を持っている。"},{"spoiler":false,"text":"変身能力を得たプリンスに敗れ、マルクジェネに囚われの身となるが、悪の組織の人間だと分かっていてもプリンスを説得出来ないか？と思っている。"}],"source":"egs","sourceCharacterId":"8620","sourceWorkId":"23453","spoiler":false},{"segments":[{"spoiler":false,"text":"元気で明るい女の子。月の力を司るプリマヴェール・セレネに変身する。"},{"spoiler":false,"text":"マルクジェネが居なくなったことで、望んでいた平和が手に入ったが引き換えに親友の橘ひかりを失ってしまう。 今もどこかにいると信じている反面、ひかりが居なくなったショックのためかいつもの元気に陰りが見え隠れしている。 ある日、学園に赴任してきた若い教師と出会い目的を見失っていた葵も前を見て歩みだそうとする。"}],"source":"egs","sourceCharacterId":"8620","sourceWorkId":"24258","spoiler":false},{"segments":[{"spoiler":false,"text":"好き：友達、平和、猫　　嫌い：虫"},{"spoiler":false,"text":"天真爛漫な性格でとことん前向き、人間の善意と正義を信じる少女。"},{"spoiler":false,"text":"そこに居るだけで周囲が癒やされる優しい心を持っている。"},{"spoiler":false,"text":"新たな力に目覚めたプリンスに敗れ、マルクジェネに囚われの身となるが、悪の組織の人間だと分かっていても彼を説得できないかと思っている。"},{"spoiler":false,"text":"「地球の愛と平和を護るため遊聖天使プリマヴェール、勅命光臨ただいま参上！」"}],"source":"bangumi","sourceCharacterId":"188268"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"8620","sourceWorkId":"24258","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"8620","sourceWorkId":"24258","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"8620","sourceWorkId":"24258","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"8620","sourceWorkId":"24258","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"8620","sourceWorkId":"24258","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2ad66ae9775a8ab7b474b2e374432107869bf0275b2ff724696d8b01e7810fe3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd4969b58584e22d2302bd7e050746a140782869e65d538cc242f35dc4590959.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266315:188268:5936:1","source":"bangumi"}]},{"characterId":"char_c45614","characterName":"プリマヴェール・プラージュ","sourceIds":{"bangumi":[{"characterId":"188269","match":"exact-normalized-name-in-linked-work","subjectId":"188237"},{"characterId":"188269","match":"exact-normalized-name-in-linked-work","subjectId":"266315"}],"egsCharacterIds":["8621"],"vndbCharacterId":"c45614"},"originalCharacterName":"プリマヴェール・プラージュ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"少々引っ込み思案な性格で、争い事は苦手だが地球の平和となによりも、葵のため頑張りたい一心で、プリマヴェール・プラージュに変身し、戦っている。"},{"spoiler":false,"text":"葵がマルクジェネに捕われていることを知らないまま、葵に化けたプリンスと接していくことになる。"}],"source":"egs","sourceCharacterId":"8621","sourceWorkId":"23453","spoiler":false},{"segments":[{"spoiler":false,"text":"内気な性格だが、いつか葵のような素晴らしい人間になりたいと思っている。"},{"spoiler":false,"text":"太陽の力を司るプリマヴェール・プラ－ジュに変身する。戦闘には不慣れだが、セレネを目標にして挫けず戦ってきた。 ある日のマルクジェネとの対決により、ダーククリスタルを埋め込まれる。そのせいで体調に異変が起こり、捕獲されてしまう。逃げることが出来なくなり、マルクジェネの実験を受けることになる。"}],"source":"egs","sourceCharacterId":"8621","sourceWorkId":"24258","spoiler":false},{"segments":[{"spoiler":false,"text":"好き：葵ちゃん……（ポソリと）、髪留め（葵から貰った）　　嫌い：ケンカ、争い"},{"spoiler":false,"text":"争い事は苦手で、少々引っ込み思案な性格をした大人しい少女。"},{"spoiler":false,"text":"普段は戦いなどとは無縁の生活をしているが、いざとなれば聖なる太陽の力を振るうプリマヴェール「プラージュ」として戦う。"},{"spoiler":false,"text":"もう一人のプリマヴェール、セレネこと葵とは大の仲良しで、戦いの中に身を置くのも「彼女の力になりたい」という気持ちが何より○い。弱い自分を自覚しつつも少し無理をしながら正義のヒロインとして頑張っている。"},{"spoiler":false,"text":"新たな力を手に入れたプリンスにセレネが負けてしまい、一人で戦うことを余儀なくされてしまうが、セレネを……葵を助けるためと勇気を振り絞り、何度もマルクジェネに戦いを挑んでくる。"},{"spoiler":false,"text":"「わ、私だってプリマヴェールなんだから、頑張らなきゃっ！」"}],"source":"bangumi","sourceCharacterId":"188269"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"8621","sourceWorkId":"24258","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"8621","sourceWorkId":"24258","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"8621","sourceWorkId":"24258","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"8621","sourceWorkId":"24258","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"8621","sourceWorkId":"24258","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d114a99b19fcff8857b8f32456d6e7e28731dec11c3f874eba398f4a1282b888.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1b3671904ef4f71b1943d509a9282b8388a2004035367cd0fe9fd9ae1dbc58c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘志穂","creatorId":"vndb:s738","sourcePersonId":"vndb:s738","canonicalEntityId":"vndb:s738","name":"橘 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266315:188269:7169:1","source":"bangumi"}]},{"characterId":"char_c45616","characterName":"スフィカ","sourceIds":{"bangumi":[{"characterId":"188270","match":"exact-normalized-name-in-linked-work","subjectId":"266315"}],"egsCharacterIds":["11806"],"vndbCharacterId":"c45616"},"originalCharacterName":"スフィカ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"仕事はそつなくこなすものの、相変わらず自堕落なプリンスの補佐官。"},{"spoiler":false,"text":"毒舌も相変わらずで、プリンスにも容赦がない。また、今回はスフィカの隠された顔も……？"}],"source":"egs","sourceCharacterId":"11806","sourceWorkId":"24258","spoiler":false},{"segments":[{"spoiler":false,"text":"好き：休暇、地上の食べ物　　嫌い：労働"},{"spoiler":false,"text":"プリンスがマルクジェネで本格的に活躍しだしてから、ずっと補佐官をしている女性。"},{"spoiler":false,"text":"プリンスにとっては親族であるフォルクハルトを除けばもっとも親しい関係にある。"},{"spoiler":false,"text":"仕事はなんでもそつなくこなすが、それ以外はとことん自堕落。仕事を早く終わらすのもより余暇を楽しむ為だったりする、良く言えばマイペースな女性。"},{"spoiler":false,"text":"毒舌な性格で、皇帝の息子であるプリンスにも容赦ない言葉を叩き付けてくるが、プリンス自身は気兼ねなく会話ができる存在と思って（馴れて）いる。が、そのやりとりは周囲から見ると妙でしかない。"},{"spoiler":false,"text":"「起きて下さいプリンス様、早く起きて下さらないと、私がソコ（ベッド）で眠れません」"}],"source":"bangumi","sourceCharacterId":"188270"}],"profileFacts":[{"lab