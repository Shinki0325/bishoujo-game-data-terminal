"match":"source-roster","subjectId":"237891"}]},"originalCharacterName":"ネズミ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0602"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"bust":{"reviewState":"source-only","source":"bangumi","value":"75"},"height":{"reviewState":"source-only","source":"bangumi","value":"170"},"hip":{"reviewState":"source-only","source":"bangumi","value":"79"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"53"},"weight":{"reviewState":"source-only","source":"bangumi","value":"49.5"}},"descriptions":[{"segments":[{"spoiler":false,"text":"死の際に立つ、美麗な伏し目の少女。"},{"spoiler":false,"text":"沈魚落雁、閉月羞花とはよく言ったもので、思わず目を逸らしてしまうような、"},{"spoiler":false,"text":"近寄り難くも蠱惑的な美しさを持つ貞女。"},{"spoiler":false,"text":"その眼差しはどこか見透かすような冷たさを持っている。"},{"spoiler":false,"text":"死を望みながら『尊厳維持装置』を忌諱しており、首吊り自殺、焼身自殺、飛び込み自殺、"},{"spoiler":false,"text":"頓服自殺といった所謂“旧来”の自殺方法の中から自分のもっとも望む理想の死を模索している。"},{"spoiler":false,"text":"彼女にとって、死とは夜闇を照らす月のようなものだ。輪郭すら不確かな世界で、死だけは揺ぎ無く存在している。"},{"spoiler":false,"text":"夢想家のようでいて、徹底したリアリストのようでもある。死を語る言葉は楽天的なようでいて、シニカルだ。死に臨むが故に、死を望む彼女は、その姿を変えるかのように輝く。彼女は、月の光に咲いた硝子の花のように美しい。"}],"source":"bangumi","sourceCharacterId":"66510"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d96de5c49460580c9ccebc360509d9b37ab6d36c12a3dbf39d4f92da16d8835e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25c3dbca4d98e02e85fff07550640d86534195e4141cb8bc9ae0afda3f306567.webp","width":80,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_66511","characterName":"和泉冬伽","sourceIds":{"bangumi":[{"characterId":"66511","match":"source-roster","subjectId":"237891"}]},"originalCharacterName":"和泉冬伽","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0202"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"bust":{"reviewState":"source-only","source":"bangumi","value":"98"},"height":{"reviewState":"source-only","source":"bangumi","value":"159"},"hip":{"reviewState":"source-only","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"59"},"weight":{"reviewState":"source-only","source":"bangumi","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ひょんな事から反尊厳維持装置集団〝組織〟に関わっていく事になる天然少女（いろんな意味で）。"},{"spoiler":false,"text":"一見して穏やかで大人しい少女だが、根は頑固で決して挫けない強く気高い意志を持っている。"},{"spoiler":false,"text":"天然ボケと天然ツッコミを兼ね備えた天然少女で、どこか放っておけないあざとさも持っているが無自覚。"},{"spoiler":false,"text":"高校一年生の時に私立金剛寺学園に転校してきた。"},{"spoiler":false,"text":"クラスではある一件から波風が立たない様に過ごしているが……"},{"spoiler":false,"text":"尊厳維持装置に対しては洗い物の時に邪魔だなあ程度の認識しかもっていない。"},{"spoiler":false,"text":"ちなみにお母さん超大好きっ娘でもある。"},{"spoiler":false,"text":"母の幸せこそ自身の幸せであると心から思っている程に。"}],"source":"bangumi","sourceCharacterId":"66511"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5358830a79cdd091bdeb7d73dc4e27ba65e2a0b34e93c3089eddb917553a2a0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b5ecc7d62ead07e9b54b763d8ee63555fe64fcdb02caf1e6e9bb289ae92ec1f.webp","width":59,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_66512","characterName":"日野原矜次","sourceIds":{"bangumi":[{"characterId":"66512","match":"source-roster","subjectId":"237891"}]},"originalCharacterName":"日野原矜次","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1020"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"186"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"78"}},"descriptions":[{"segments":[{"spoiler":false,"text":"反尊厳維持装置集団〝組織〟の若き工作員。組織では実働三課に所属、アタッカーを務める。"},{"spoiler":false,"text":"十代半ばで軍へと志願し、ＴＯＦ（テクニカルオペレーションフォース）という特殊部隊で多くの実践を積んできた元たたき上げ軍人。"},{"spoiler":false,"text":"ある経緯から軍を抜け、尊厳維持装置撲滅を掲げる〝組織〟のテロリストにスカウトされた。この経緯から公安に身元を追われている。"},{"spoiler":false,"text":"尚残念ながら軟派野郎である。"},{"spoiler":false,"text":"たまに行き過ぎてセクハラまがいの発言をして叱られる事も。戦地においても軽口を忘れず、ウィットに富んだ言い回しをする事が多い。これは過去の暗い戦場で得た士気維持の為の悪癖であるらしい。おちゃらけた言動とは対照的に、任務であればそれを忠実かつ冷酷に熟す兵士然とした側面も持ち、命令に反した事は一度もない。"},{"spoiler":false,"text":"根は真面目で使命感、責任感が強く、臆病で優しいどこにでもいる青年。親しい周りの人間にはそれがバレている。"},{"spoiler":false,"text":"趣味は模索中で結果として『趣味を作る事が趣味』となっており、今では２００１個の趣味が確認されている。"}],"source":"bangumi","sourceCharacterId":"66512"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c3edf465bc2d0879af7ba340517532c736b33010e4422e25ea4d223a3cbf309.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfb88befb2dedf9cc81539b4ed7f49ede949fea8ca00d823b7adc5660c06d4ed.webp","width":66,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_66513","characterName":"但馬すみれ","sourceIds":{"bangumi":[{"characterId":"66513","match":"source-roster","subjectId":"237891"}]},"originalCharacterName":"但馬すみれ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0330"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"bust":{"reviewState":"source-only","source":"bangumi","value":"82"},"height":{"reviewState":"source-only","source":"bangumi","value":"162"},"hip":{"reviewState":"source-only","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"56"},"weight":{"reviewState":"source-only","source":"bangumi","value":"78"}},"descriptions":[{"segments":[{"spoiler":false,"text":"私立金剛寺学園高等部２年生。片親の父とわだかまりを抱え、悩み続ける思春期真っ只中の少女。"},{"spoiler":false,"text":"成績は良いが授業をサボりがちで、教師や近所の人からは不良少女と疎まれている────のが昼の顔である。"},{"spoiler":false,"text":"夜の顔は、マフラーで顔を隠し、裏路地に潜む不良や不埒な輩を退治して回っているという阿賀野区の都市伝説、「マフラー小僧」その人である。"},{"spoiler":false,"text":"不平と横暴を許さず、弱きを助け強きを挫く正義の味方。マフラー小僧の名前は、一方では阿賀野区のヒーローとして、一方では恐怖の対象として噂になっている。"}],"source":"bangumi","sourceCharacterId":"66513"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58be2255573e4ee572a90a685da7590719cd3468185f11d1795126c51a48a4fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/3439493f5c8d79df181f0ac0a87ecd047cad130dfecd7c0ede2ba4efd28110ae.webp","width":68,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_66514","characterName":"秘書美","sourceIds":{"bangumi":[{"characterId":"66514","match":"source-roster","subjectId":"237891"}]},"originalCharacterName":"秘書美","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"おはようからおやすみまで、食事の口移しから下の世話まで（自称）"},{"spoiler":false,"text":"なんでもござれのスーパー秘書。"},{"spoiler":false,"text":"一切働かない阿賀野エンタープライズの社長、金剛寺春人の秘書として公私共に世話をしている。"},{"spoiler":false,"text":"基本頼めばなんでしてくれる優秀な秘書だが毒舌がすごい。"},{"spoiler":false,"text":"阿賀野エンタープライズの最上階に泊まり込みで働いている。"},{"spoiler":false,"text":"なにが彼女にそこまでさせているのかは本当に誰も知らない。"}],"source":"bangumi","sourceCharacterId":"66514"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/8601bb095bc58063ea5b127e43459854f790f7444a6f35e7c211f88dd5294436.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1defe11e148a7918cc13768adc9949917947734c156517b4e7c74a5743cc44a4.webp","width":57,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_66515","characterName":"モミー・ザ・ハイエソド","sourceIds":{"bangumi":[{"characterId":"66515","match":"source-roster","subjectId":"237891"}]},"originalCharacterName":"モミー・ザ・ハイエソド","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"bangumi","value":"100"},"hip":{"reviewState":"source-only","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"waist":{"reviewState":"source-only","source":"bangumi","value":"69"}},"descriptions":[{"segments":[{"spoiler":false,"text":"長い金のモミアゲにサングラス。白衣の下からでもわかる隆起した筋肉。"},{"spoiler":false,"text":"例えるなら──────金色の戦車。暴力的なまでのナンセンスを詰め込んだ破壊の化身。"},{"spoiler":false,"text":"ナンセンスの塊でありながら嫌悪感は抱けない。"},{"spoiler":false,"text":"その堂々たる異常さがいっそ爽快感すら胸中へ宿らせる。存在そのものが研ぎ澄まされた美への反逆でありながら、威風堂々。とどのつまり────"},{"spoiler":false,"text":"アイアムキューーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーーティスト！！"},{"spoiler":false,"text":"自らのモミアゲの艶を、キューティクルを超越した存在、〝キューティカル〟としてこよなく愛する変人。"},{"spoiler":false,"text":"見た目に反さず圧倒的な戦闘技術と卓越したフィジカルを合わせ持つ。力と技のモミアゲ。肩書上は国合お抱えの研究所の所長であり、実のところ頭脳もすごい。"},{"spoiler":false,"text":"なんだあれ、とか言わない。"}],"source":"bangumi","sourceCharacterId":"66515"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5aaf264103bf89b144a28e5cdfcac11f7895927c351bb250b216cf4e54f9305a.webp","fallbackUrl":"