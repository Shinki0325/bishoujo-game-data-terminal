41","canonicalEntityId":"vndb:s141","name":"蒼井 翔太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:60620","source":"vndb"}]},{"characterId":"char_vndb_c28306","characterName":"魔法使い","sourceIds":{"vndbCharacterId":"c28306"},"originalCharacterName":"魔法使い","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"430"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"64"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious young man who invariably appears in every tale. For some reason, he gives off a different impression at each encounter; his personality is difficult to grasp. He seems to have some sort of goal, yet..."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c28306"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99b888a353dffc34aa1ae6f4beb97ba5459be38fc91debc5cb49e7497cda0ec5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e234196fef49de9a2279cd3556620a5c572a9507530086235846db9d5c999dbc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽多野 渉","creatorId":"vndb:s60","sourcePersonId":"vndb:s60","canonicalEntityId":"vndb:s60","name":"春野風","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:60617","source":"vndb"}]},{"characterId":"char_vndb_c28307","characterName":"アリス","sourceIds":{"vndbCharacterId":"c28307"},"originalCharacterName":"アリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authorit