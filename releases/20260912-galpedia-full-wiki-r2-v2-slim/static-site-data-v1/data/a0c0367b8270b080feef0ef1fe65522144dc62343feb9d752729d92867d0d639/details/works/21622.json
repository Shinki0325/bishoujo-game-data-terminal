terNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c28299","characterName":"有栖 百合花","sourceIds":{"vndbCharacterId":"c28299"},"originalCharacterName":"有栖 百合花","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"504"},"height":{"reviewState":"source-only","source":"vndb","value":"164"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A cheerful, energetic girl. She has a quick wit and conducts herself well. A fairy-tale-like love will bloom between her and the men she meets in the Looking-Glass Country."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c28299"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/900fc5163937195d73b74e3815948aa911ce3ee32eec9b521ca35cc3dd76a950.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/ebed60a315d5f86c283f5a807f803d0fb6d867b2c9b5b62c415ebde82da9b721.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c28300","characterName":"シンデレラ","sourceIds":{"vndbCharacterId":"c28300"},"originalCharacterName":"シンデレラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"23"},"birthday":{"reviewState":"source-only","source":"vndb","value":"601"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The lazy son of a nouveau riche family. He has a haughty attitude and believes everything can be settled with the power of money. Though he's the owner of a cafe (which is also his home), he leaves the shop entirely up to his younger brothers while he loafs around all day long. However, on the inside, he's actually as delicate as glass."},{"spoiler":true,"text":"His family was once extremely wealthy, however, his father's business dealings went bad and they became neck-deep in debt. Cinderella is a co-signee of a loan his father took from a loan shark. Having grown up rich, Cinderella has a poor concept of managing money, made worse by his going on shopping sprees as an escape and front to pretend that his family is still well-off instead of repaying the massive loan."},{"spoiler":false,"text":"Based on Otome Jikan's translated profile of him."}],"source":"vndb","sourceCharacterId":"c28300"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f86076beb5e7c1a8033fa3e87ffa786ce026bce8de1a951cb6b5c6ab2568d1e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb6182ccc77e5468e0da780230ff59cc2a1d9ab8b24193c1488daf425a396996.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平川 大輔","creatorId":"vndb:s133","sourcePersonId":"vndb:s133","canonicalEntityId":"vndb:s133","name":"平川 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:60619","source":"vndb"},{"creditedName":"Shion Francois","creatorId":"vndb:s13923","sourcePersonId":"vndb:s13923","canonicalEntityId":"vndb:s13923","name":"Shion Francois","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:60630","source":"vndb"}]},{"characterId":"char_vndb_c28302","characterName":"赤ずきん","sourceIds":{"vndbCharacterId":"c28302"},"originalCharacterName":"赤ずきん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"birthday":{"reviewState":"source-only","source":"vndb","value":"214"},"height":{"reviewState":"source-only","source":"vndb","value":"183"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"70"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A police officer with a constantly stern face. He is usually covered by his trademark red hood. Though he tends to be calm, cool, and collected, there are also times where he unexpectedly breaks down. According to the person himself, he has a dislike of women."},{"spoiler":true,"text":"Akazukin is actually the wolf of Taishou x Alice's Little Red Riding Hood-themed story. Under his hood are a pair of wolven ears. His mother raised him to believe everyone around him are \"wolves\" and to not interact or to trust them, however, this is implied to be a way for his mother to keep her \"different\" son away from public view. He is childhood friends with Ookami until an incident involving Ookami's grandmother caused him to leave and never contact Ookami again."},{"spoiler":false,"text":"Based on Otome Jikan's translated profile of him."}],"source":"vndb","sourceCharacterId":"c28302"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b453e317b75456597c22b9471e8ae63a6546fc8691b06a0d82e490a02011b851.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0bb52080d4