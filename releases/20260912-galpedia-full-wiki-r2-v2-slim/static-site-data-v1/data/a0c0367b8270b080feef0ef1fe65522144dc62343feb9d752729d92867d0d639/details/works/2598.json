w"}],"source":"vndb","sourceCharacterId":"c44061"},{"segments":[{"spoiler":false,"text":"内閣直属特殊事態特別対策室所属のエキスパートの一人。A班所属。"},{"spoiler":false,"text":"主に物理的な障害の排除等を担当。"},{"spoiler":false,"text":"とにかく真面目で実直、口数も少ない。"},{"spoiler":false,"text":"聡美ほど電脳機器に通じているわけではないが頭も良く、頭脳労働も肉体労働もこなす。"},{"spoiler":false,"text":"仲間の信頼も厚い。元陸自で、階級はニ曹。"}],"source":"egs","sourceCharacterId":"17053","sourceWorkId":"1986","spoiler":false},{"segments":[{"spoiler":false,"text":"職業：内閣直属特殊事態特別対策室所属の所員で、A班班長"},{"spoiler":false,"text":"趣味：特になし、あえて言えば武器類の手入れ"},{"spoiler":false,"text":"特技：射撃"},{"spoiler":false,"text":"好きなもの：キムチ"},{"spoiler":false,"text":"嫌いなもの：テロリスト"},{"spoiler":false,"text":"通称『特対室』A班のリーダー。主に物理的な障害の排除等を担当。"},{"spoiler":false,"text":"とにかく真面目で実直、口数も少ない。聡美ほど電脳機器に通じて"},{"spoiler":false,"text":"いるわけではないが頭もよく、頭脳労働も肉体労働もこなす。仲間"},{"spoiler":false,"text":"の信頼も厚い。元陸自で、階級はニ曹。"}],"source":"bangumi","sourceCharacterId":"123183"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53ec19214117ba8ead1bfac95111641afaf1ec4d6fd35f65c0b7262e4530e844.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edec7b17dc9e69bd4599ef49da0244e19ba40eceb0f9c9c2668bb5726475853f.webp","width":111,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c44065","characterName":"各務　純","sourceIds":{"bangumi":[{"characterId":"123180","match":"exact-normalized-name-in-linked-work","subjectId":"68254"}],"egsCharacterIds":["17055"],"vndbCharacterId":"c44065"},"originalCharacterName":"各務　純","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Jun is an accomplished Shinto shrine maiden, and accordingly, is normally found performing religious duties within temples. She wields tremendous spiritual energies, and can directly combat demonic creatures with little fear of retribution. Shun is her cherished younger sister."},{"spoiler":false,"text":"Hobby: Cooking"},{"spoiler":false,"text":"Talent: Making Tea"},{"spoiler":false,"text":"Likes: Green Tea"},{"spoiler":false,"text":"Dislikes: Impure Souls"},{"spoiler":false,"text":"From Nargrakhan's review"}],"source":"vndb","sourceCharacterId":"c44065"},{"segments":[{"spoiler":false,"text":"内閣直属特殊事態特別対策室所属のエキスパートの一人。A班所属。"},{"spoiler":false,"text":"普段は神社の巫女をしながら、大和川学院に通う女子校生。"},{"spoiler":false,"text":"舜とは仲の良い姉妹。"},{"spoiler":false,"text":"少々天然なところもあるが、物静かで優しげな印象とは裏腹に芯が強く、頑固。"},{"spoiler":false,"text":"対策室では主に心霊現象等を担当し、妹と行動を共にすることが多い。"},{"spoiler":false,"text":"強力な神通力を持つ。"}],"source":"egs","sourceCharacterId":"17055","sourceWorkId":"1986","spoiler":false},{"segments":[{"spoiler":false,"text":"職業：大和川学院三年、巫女を務め、特対室A班所属の所員でもある"},{"spoiler":false,"text":"所属部：弓道部"},{"spoiler":false,"text":"趣味：料理"},{"spoiler":false,"text":"特技：おいしいお茶を入れること"},{"spoiler":false,"text":"好きなもの：日本茶"},{"spoiler":false,"text":"嫌いなもの：不潔なもの"},{"spoiler":false,"text":"『特対室』A班のメンバーで、少し離れた大和川学院に通っている。"},{"spoiler":false,"text":"普段は神社で巫女としての務めを果たしている。舜とは仲の良い姉妹。"},{"spoiler":false,"text":"少々天然なところもあるが、物静かで優しげな印象とは裏腹に芯が強く、頑固。"},{"spoiler":false,"text":"対策室では主に心霊現象等を担当し、妹と行動を共にすることが多い。強力な神通力を持つ。"}],"source":"bangumi","sourceCharacterId":"123180"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56eae3c92d03763ec7efd06e2ab6fbf79708c5e1b90d494820da63ecfa8b1350.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df21680343edb5be9f76a8131e95def33d86622b5dc973b70f81eafd9fcd8ada.webp","width":114,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c44066","characterName":"各務　舜","sourceIds":{"bangumi":[{"characterId":"123181","match":"exact-normalized-name-in-linked-work","subjectId":"68254"}],"egsCharacterIds":["17056"],"vndbCharacterId":"c44066"},"originalCharacterName":"各務　舜","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shun failed the process to become a Shinto shrine maiden, but discovered she possessed an unparallel talent for exorcist sorcery. She has a natural rebellion against authority, and tends to speak her mind without concern for other’s feelings. Absolutely worships her elder sister."},{"spoiler":false,"text":"Hobby: Sleeping"},{"spoiler":false,"text":"Talent: Origami"},{"spoiler":false,"text":"Likes: Sister’s green tea"},{"spoiler":false,"text":"Dislikes: Scaly creatures"},{"spoiler":false,"text":"From Nargrakhan's review"}],"source":"vndb","sourceCharacterId":"c44066"},{"segments":[{"spoiler":false,"text":"内閣直属特殊事態特別対策室所属のエキスパートの一人。A班所属。"},{"spoiler":false,"text":"神社の生まれだが巫女は継がず、知り合いの陰陽師のところに弟子として転がり込み、修行を積んだ結果、師をはるかに越える力を身に付けた。"},{"spoiler":false,"text":"形式的で、実際に物理的影響を引き起こすことができない師と違い、式神を呼ぶこともできる。"},{"spoiler":false,"text":"少々天の邪鬼なところがあり、皮肉めいた口調が口癖。"},{"spoiler":false,"text":"態度にはあまり出さないが、姉のことは両親以上に大事に思っている（別に変な意味で）。"}],"source":"egs","sourceCharacterId":"17056","sourceWorkId":"1986","spoiler":false},{"segments":[{"spoiler":false,"text":"職業：大和川学院二年、特対室A班所属"},{"spoiler":false,"text":"所属部：陸上部"},{"spoiler":false,"text":"趣味：昼寝"},{"spoiler":false,"text":"特技：紙細工"},{"spoiler":false,"text":"好きなもの：姉の入れたお茶"},{"spoiler":false,"text":"嫌いなもの：鱗のある生き物（魚類・爬虫類など）"},{"spoiler":false,"text":"姉の純と同じく『特対室』Ａ班のメンバー。神社の生まれだが巫女は継がず、"},{"spoiler":false,"text":"知り合いの陰陽師のところに弟子として転がり込み、修行を積んだ結果、"},{"spoiler":false,"text":"師をはるかに越える力を身に付けた。形式的で、実際に物理的影響を引き起こすことができない師と違い、"},{"spoiler":false,"text":"式神を呼ぶこともできる。少々あまのじゃくなところがあり、皮肉めいた口調が口癖。"},{"spoiler":false,"text":"態度にはあまり出さないが、姉のことは両親以上に大事に思っている（別に変な意味で）。"}],"source":"bangumi","sourceCharacterId":"123181"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14b1775855fb8e3dd3119f12717bcbeb80d9d4b2557e6f0c6eaf639e758d46f4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0e17ce7dd88e6465997f0dcfdb895a5660f2382ba35405ee60c0dbe91b6c60f.webp","width":115,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c147791","characterName":"立川 竜馬","sourceIds":{"vndbCharacterId":"c147791"},"originalCharacterName":"立川 竜馬","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d26fcff9291e68f5b374fba97e72abab279966a9857138a3116584bd9211a09.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f369a8d1ed74e41b4954c414fb9d7211e43094675e7b754c8159f992a70234d3.webp","width":153,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c163539","characterName":"風間 勝利","sourceIds":{"vndbCharacterId":"c163539"},"originalCharacterName":"風間 勝利","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3df4db7e86159b48e329963e1c10e53f6676b796fca82402a24198f3978b712a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/termin