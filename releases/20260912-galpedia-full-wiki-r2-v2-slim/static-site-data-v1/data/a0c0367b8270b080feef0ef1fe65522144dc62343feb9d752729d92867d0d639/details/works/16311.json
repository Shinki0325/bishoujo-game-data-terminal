:false,"text":"何不自由なく育った為に、四十路を越えた今でも傲慢。"},{"spoiler":false,"text":"金に物を言わせ、欲しい物は確実に手に入れる。"},{"spoiler":false,"text":"自ら経営するフィットネスクラブでエクササイズに余念がない。"},{"spoiler":false,"text":"「これがわたくしの携帯番号よ。ちゃんと控えておきなさい」"}],"source":"egs","sourceCharacterId":"17961","sourceWorkId":"10983","spoiler":false},{"segments":[{"spoiler":false,"text":"登場作品：『人妻喰い』"},{"spoiler":false,"text":"高慢な金持ちマダム"}],"source":"egs","sourceCharacterId":"17961","sourceWorkId":"16429","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b963c2db6a7891fbf69dcd4e92143248bf68f65608bbe34998be95a073c7fe88.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4617cfe1a09d1c45ebf925afdf71eb07aabf106d98925fc7742a92c30d7f253.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"この かなみ","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20943","source":"vndb"}]},{"characterId":"char_vndb_c102299","characterName":"桐山 祐一","sourceIds":{"vndbCharacterId":"c102299"},"originalCharacterName":"桐山 祐一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Down on this luck from losing his job due to sleeping with the secretary of his boss, he meets his estranged uncle by chance."},{"spoiler":false,"text":"His uncle, who is similar to him, offers him the job of security guard at the local supermarket."}],"source":"vndb","sourceCharacterId":"c102299"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/543cb36fe61f3d1b1f3efed5bb0893