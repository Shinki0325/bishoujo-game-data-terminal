{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"17053","model":{"presentationWorkId":"egs:17053","staff":{"artwork":[],"scenario":[],"music":[],"other":[{"creditedName":"左","creatorId":"vndb:s6653","sourcePersonId":"egs:creator:1124","canonicalEntityId":"vndb:s6653","name":"左","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"auto-confirmed","relationId":"egs:work-creator:111247","source":"egs"},{"creditedName":"柳麻美(MAMI)","creatorId":"vndb:s4008","sourcePersonId":"egs:creator:14622","canonicalEntityId":"vndb:s4008","name":"柳麻美(MAMI)","detail":"劇中歌「FJ:パナすぺしゃる」、戦闘曲「Promised Gemini」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:185374","source":"egs"}]},"cast":[{"characterId":"char_bangumi_23962","characterName":"Wilbell Voll-Ersleid","sourceIds":{"bangumi":[{"characterId":"23962","match":"source-roster","subjectId":"158006"},{"characterId":"23962","match":"source-roster","subjectId":"37563"},{"characterId":"23962","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"Wilbell Voll-Ersleid","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A14　　14歳"},{"spoiler":false,"text":"未来の大魔法使いを目指す女の子"},{"spoiler":false,"text":"魔法使いの一族に生まれた女の子。大婆様のような偉大な魔法使いを目指すため魔法の修行を続けている。元気で活発な性格だが色々な知識があるせいか多少尊大になることも。"},{"spoiler":false,"text":"ちゃっかりしておりアーシャに修行の手伝いをさせたりもするがその豊富な知識と魔法でアーシャに助言をすることもある。"},{"spoiler":false,"text":"A15　　18歳"},{"spoiler":false,"text":"修行中の大魔法使い見習い"},{"spoiler":false,"text":"辺境から辺境へと渡り歩き、武者修行を続けている魔法使いの少女。"},{"spoiler":false,"text":"以前に友人たちの協力を経て風の精霊と契約を結んでからは、世界の様々な精霊に逢うことを修行の目的として放浪している。"},{"spoiler":false,"text":"魔法使いとしての素養は非常に高く、その若さに見合わない高い能力を持っている。"},{"spoiler":false,"text":"A16　　24歳"},{"spoiler":false,"text":"大きな試練に直面する、偉大なる魔法使い"},{"spoiler":false,"text":"各地の精霊と契約する修業中の魔法使い。"},{"spoiler":false,"text":"これまで契約した精霊の力を借りて、強力な魔法を行使できる。"},{"spoiler":false,"text":"偶然助けたシャルロッテに錬金術士と間違われ、憧れの対象となったことからシャルロッテのよき師匠になる。"},{"spoiler":false,"text":"年齢に見合わない幼い外見をしており、「大人になる」手がかりを求めている。"},{"spoiler":false,"text":"面倒くさがりでちゃっかりしているところは相変わらずだが、自分の子供っぽさにコンプレックスを抱いている。"},{"spoiler":false,"text":"そのため、無理に大人振ろうとして厄介ごとを招くこともしばしば。"}],"source":"bangumi","sourceCharacterId":"23962"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"23962","value":"旅行的魔法师(A16)"},{"label":"职业","source":"bangumi","sourceCharacterId":"23962","value":"魔法师(A14/A15)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90a9d58ba27701320c1028ea8bea6278a13fb61066dbddadd720774b9e299546.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f5e7655a562de786adc5fbabaef3708acecee7e6ad7a7392b7663bfa507e399.webp","width":210,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瀬戸麻沙美","creatorId":"vndb:s1433","sourcePersonId":"vndb:s1433","canonicalEntityId":"vndb:s1433","name":"瀬戸 麻沙美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37563:23962:5766:1","source":"bangumi"}]},{"characterId":"char_bangumi_23963","characterName":"Linca","sourceIds":{"bangumi":[{"characterId":"23963","match":"source-roster","subjectId":"37563"},{"characterId":"23963","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"Linca","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"160"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A14　　20歳"},{"spoiler":false,"text":"純粋すぎる、美しき護衛乙女"},{"spoiler":false,"text":"幼少より戦闘の訓練を受けて育った、護衛のスペシャリスト。華奢な体格からは想像できない戦闘技術を誇るが一般教養、生活能力は皆無でマリオンに心配されている。"},{"spoiler":false,"text":"とても純粋で忠義心も厚くマリオンの護衛を務めている。反面、勝負に対するこだわりが強く友達が出来ないことを気にしている。"},{"spoiler":false,"text":"A15　　24歳"},{"spoiler":false,"text":"悩み多き、武闘派の天然剣士"},{"spoiler":false,"text":"班長補佐としてマリオンを支え続ける、戦闘のスペシャリスト。"},{"spoiler":false,"text":"多くの出張先で磨かれた剣の腕は一流だが、純粋で素直な性格ゆえに勘違いも多く、それが原因でトラブルを引き起こしてしまうこともしばしば。"},{"spoiler":false,"text":"エスカたちという部下を初めて持つが、分からないなりに上司として振る舞おうと努力する。"}],"source":"bangumi","sourceCharacterId":"23963"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"23963","value":"开发班的副班长(A15)"},{"label":"职业","source":"bangumi","sourceCharacterId":"23963","value":"护卫(A14)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62840be3c4f07b21d21e5092abcbac53119e4c727a674329ad72909df4ccd492.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b1b7f4a77d18a5c05f28abdeb1f4c847e3bd930125ea66921b2ade713651c46.webp","width":157,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小清水亜美","creatorId":"vndb:s622","sourcePersonId":"vndb:s622","canonicalEntityId":"vndb:s622","name":"小清水 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37563:23963:4474:1","source":"bangumi"}]},{"characterId":"char_bangumi_23964","characterName":"Marion Quin","sourceIds":{"bangumi":[{"characterId":"23964","match":"source-roster","subjectId":"37563"},{"characterId":"23964","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"Marion Quin","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"150"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A14　　22歳"},{"spoiler":false,"text":"小さな体に大きなガッツを秘めた駐在員"},{"spoiler":false,"text":"はるか遠方よりリンカと共に派遣されてきた調査員。"},{"spoiler":false,"text":"この地方の遺跡と資源の調査が主な任務となっている。"},{"spoiler":false,"text":"上司からの無理難題がくると文句を言いつつも遂行するスゴ腕の調査員で、アーシャの事情を知ると立場を顧みず協力を申し出る優しさも兼ね備えるスーパーキャリアウーマン。"},{"spoiler":false,"text":"A15　　26歳"},{"spoiler":false,"text":"開発班の活動を支える、燃える中間管理職"},{"spoiler":false,"text":"辺境の地での任務を終え、中央に戻ってきた矢先に別の辺境の地へと飛ばされたベテラン役人。"},{"spoiler":false,"text":"前回の調査任務の功績が認められてついに昇格し、そこでコルセイト支部の「開発班」の班長として就任することになる。"},{"spoiler":false,"text":"しかし、人手不足の開発班はほとんど実績が上げられていなかったようで、赴任したときには既にマリオンと相棒のリンカしか残っていない状態になっていた。"}],"source":"bangumi","sourceCharacterId":"23964"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"23964","value":"开发班的班长(A15)"},{"label":"职业","source":"bangumi","sourceCharacterId":"23964","value":"来自远方的驻外官(A14)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c89bc85e5398683cda8fa31bd9cecb2148b7c6e6b62241ae383336feba27ce91.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e828691c5a631e4ea1af46f871a8e318fc16a5ec593c418ecfd43f981e3477d.webp","width":162,"height":256,"source":"static-detail"},"actors":[{"creditedName":"植田佳奈","creatorId":"vndb:s17","sourcePersonId":"vndb:s17","canonicalEntityId":"vndb:s17","name":"植田 佳奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37563:23964:4263:1","source":"bangumi"}]},{"characterId":"char_bangumi_23965","characterName":"Nio Altugle","sourceIds":{"bangumi":[{"characterId":"23965","match":"source-roster","subjectId":"37563"},{"characterId":"23965","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"Nio Altugle","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A14　　13歳"},{"spoiler":false,"text":"黄昏に消えた少女"},{"spoiler":false,"text":"アーシャの妹。数年前に、アトリエの近くの遺跡で行方不明となる。姉想いの妹で仲も良く、毎日のように薬の材料の採取を手伝っていた。行方不明になりアーシャ達の懸命な捜査にも関わらず、見つけることが出来なかった。"},{"spoiler":false,"text":"その後何の手がかりもなく時間だけが過ぎて行ったころに、ニオが消えたとされる遺跡でアーシャは再びニオと出会い、世界のどこかで生きていることが判明する。"},{"spoiler":false,"text":"A15　　15歳"},{"spoiler":false,"text":"黄昏を語り継ぐ少女"},{"spoiler":false,"text":"旅の途中で街に立ち寄り、そのままリンゴ園に下宿するようになった異国の薬士の少女。"},{"spoiler":false,"text":"コルセイトでは、エスカの家に居候させてもらっている。"},{"spoiler":false,"text":"とある事情でウィルベルの世話になっているが、あまりウィルベルの迷惑にならないようにと、生活費は自分で稼ぎ、ちゃんと自立しようとしているしっかり者。"},{"spoiler":false,"text":"見た目に合わず大人びていて博識であり、街に伝わる何かを調査しているらしい。"}],"source":"bangumi","sourceCharacterId":"23965"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"23965","value":"帮忙做家务(A14)"},{"label":"职业","source":"bangumi","sourceCharacterId":"23965","value":"旅行的药师(A15)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54c8aa2cd8bd977a964568c16928495282a00d2bbed6181c54fe9a0da906aed6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5efe784ba0a3e6278413e74e9e09ab859b635d513d8d0c101a6d23d7187e68f6.webp","width":175,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊瀬茉莉也","creatorId":"vndb:s4898","sourcePersonId":"vndb:s4898","canonicalEntityId":"vndb:s4898","name":"伊瀬 茉莉也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37563:23965:4769:1","source":"bangumi"}]},{"characterId":"char_bangumi_26056","characterName":"Keithgrif Hazeldine","sourceIds":{"bangumi":[{"characterId":"26056","match":"source-roster","subjectId":"158006"},{"characterId":"26056","match":"source-roster","subjectId":"249447"},{"characterId":"26056","match":"source-roster","subjectId":"37563"}]},"originalCharacterName":"Keithgrif Hazeldine","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"height":{"reviewState":"source-only","source":"bangumi","value":"180"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A14　　45歳"},{"spoiler":false,"text":"真理を求め旅を続ける、放浪の錬金術士"},{"spoiler":false,"text":"遠い土地からやってきた錬金術士。落ち着いた物腰で紳士的に人と接するが古代の知識を得ることになるとどん欲で周囲を顧みずに行動し、問題を起こしている。"},{"spoiler":false,"text":"アーシャと出会い妹を助ける為の助言を与えた張本人であり、次第に核心に迫っていくアーシャに対し、親身になって手を貸してくれることになるが本人には全くその意識は無い。"},{"spoiler":false,"text":"A16　　55歳"},{"spoiler":false,"text":"黄昏に抗う探究者"},{"spoiler":false,"text":"真理を追い求める錬金術士。"},{"spoiler":false,"text":"付き人のオートマタと共に、前時代の錬金術の痕跡を探しながら、「黄昏」について調べている。"},{"spoiler":false,"text":"お気に入りの薬用パイプを持っていて、何があっても決してそれを手放そうとしない。"}],"source":"bangumi","sourceCharacterId":"26056"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"26056","value":"异国的炼金术士(A14)"},{"label":"职业","source":"bangumi","sourceCharacterId":"26056","value":"杰出的炼金术士(A16)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17198388cd27ea2eabcf64b3f9c91b1588c0a64d030a7a981a4952156bd84862.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e993949d293a7f16c6d0d0c321c02488b2136dbac3ecda187ee91f22c4484e3c.webp","width":115,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田譲治","creatorId":"vndb:s9","sourcePersonId":"vndb:s9","canonicalEntityId":"vndb:s9","name":"中田 譲治","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37563:26056:3971:1","source":"bangumi"}]},{"characterId":"char_bangumi_26331","characterName":"愛夏·阿圖爾","sourceIds":{"bangumi":[{"characterId":"26331","match":"source-roster","subjectId":"158006"},{"characterId":"26331","match":"source-roster","subjectId":"249447"},{"characterId":"26331","match":"source-roster","subjectId":"37563"}]},"originalCharacterName":"愛夏·阿圖爾","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"157"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A14　　17歳"},{"spoiler":false,"text":"黄昏の大地で、一人生きる少女"},{"spoiler":false,"text":"人里離れた平原にぽつんと建ったアトリエに、一人で住んでいる女の子。"},{"spoiler":false,"text":"平原に生えた薬草や珍しい植物を採り、薬を作って生計を立てている。"},{"spoiler":false,"text":"妹のニオが生きていることを知り、ペットの牛のパナと共に旅に出る。"},{"spoiler":false,"text":"性格はとても人当りがよく、誰とでも仲良くなれるが天然な面があり、周囲をよく巻き込んでいる。"},{"spoiler":false,"text":"A16　　27歳"},{"spoiler":false,"text":"”黄昏”に新たな可能性を示す錬金術士"},{"spoiler":false,"text":"知識と経験を兼ね備えた、非常に優秀な錬金術士。"},{"spoiler":false,"text":"かつては腕利きの薬師として、人里離れたアトリエで一人暮らしていたが、行方不明だった妹を捜すために旅に出る。"},{"spoiler":false,"text":"その後妹と再会できたものの、錬金術、そして”黄昏”の真実を知るべく師匠であるキースグリフとともに今も旅を続けている。"},{"spoiler":false,"text":"常に探究心を持っており、様々な遺跡を自ら訪れて調査している。現在その遺跡のうち一つを崩壊させた罪で、中央から指名手配されている。"}],"source":"bangumi","sourceCharacterId":"26331"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"26331","value":"流浪炼金术士(A16)"},{"label":"职业","source":"bangumi","sourceCharacterId":"26331","value":"药师，之后成为炼金术士(A14)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/def3ce2869311f3c6b995a24bf8e82bf503517a6d2db05d9d1568370ccdbc716.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb8d9d702e373c344d603b0c88947391e6574330556438a497511fdfbb02ab83.webp","width":108,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上麻里奈","creatorId":"vndb:s1774","sourcePersonId":"vndb:s1774","canonicalEntityId":"vndb:s1774","name":"井上 麻里奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37563:26331:4382:1","source":"bangumi"}]},{"characterId":"char_bangumi_44470","characterName":"Regina Curtis","sourceIds":{"bangumi":[{"characterId":"44470","match":"source-roster","subjectId":"37563"}]},"originalCharacterName":"Regina Curtis","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"163"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"23歳"},{"spoiler":false,"text":"細腕一つで家族を養う気丈な女性"},{"spoiler":false,"text":"リーゼンガングに住む腕利きの発掘屋。アーシャとは数年前に知り合い、とても親しい間柄。"},{"spoiler":false,"text":"前時代の遺物を掘り出し生計を立てながら家族に仕送りをしているほどのしっかり者である。"},{"spoiler":false,"text":"家族が多いせいか面倒見がよく旅に出たアーシャに対しても遠くの町まで案内するなど、色々と手助けをしてくれる。"}],"source":"bangumi","sourceCharacterId":"44470"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"44470","value":"挖掘遗迹"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/6690703503acd4a4802e7da187bb2f7f104440d6123f88bbdcabb58b9286743d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2e12a15628095b44c76a5175cef163dfe65972afa4e303ab13ce7371cdbb232.webp","width":144,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水沢史絵","creatorId":"vndb:s888","sourcePersonId":"vndb:s888","canonicalEntityId":"vndb:s888","name":"水沢史絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37563:44470:4455:1","source":"bangumi"}]},{"characterId":"char_bangumi_44471","characterName":"Juris Grunden","sourceIds":{"bangumi":[{"characterId":"44471","match":"source-roster","subjectId":"249447"},{"characterId":"44471","match":"source-roster","subjectId":"37563"}]},"originalCharacterName":"Juris Grunden","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"182"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"20歳"},{"spoiler":false,"text":"誇りを胸に生きる若きハンター"},{"spoiler":false,"text":"狩りで生計を立てている青年。古の竜を倒しそのウロコを身につけることで一人前の猟師として認められるという一族のしきたりを信じ、日々精進している。"},{"spoiler":false,"text":"表情が硬く無口だが性格は優しく家族想い。牛飼いをしている妹のナナカの身を案じ、彼女に同行しながら狩猟生活を営んでいる。"}],"source":"bangumi","sourceCharacterId":"44471"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"44471","value":"猎人"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d18553d0a2887d3495120bddf60e9e24a43aee18cacc0e4710eca522f96a582.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39bb7ab14298831f5adcd766e062bc1fbb24768b6ad2470aca34d09a8670b811.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳥海浩輔","creatorId":"vndb:s45","sourcePersonId":"vndb:s45","canonicalEntityId":"vndb:s45","name":"鳥海 浩輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37563:44471:4147:1","source":"bangumi"}]},{"characterId":"char_bangumi_44472","characterName":"Odileia","sourceIds":{"bangumi":[{"characterId":"44472","match":"source-roster","subjectId":"158006"},{"characterId":"44472","match":"source-roster","subjectId":"37563"}]},"originalCharacterName":"Odileia","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"157"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A14"},{"spoiler":false,"text":"世界の知識を守る図書館の女主人"},{"spoiler":false,"text":"古の時代の錬金術の技術で造られたオートマタ（機械人形）。"},{"spoiler":false,"text":"錬金術の知識を収めた図書館「弐番館」で司書をしており、錬金術の知識を求めた訪れたアーシャに蔵書の一部を譲ってくれたり本を探してくれたり付き合っていくうちに徐々に人間らしい仕草をするようになる。"},{"spoiler":false,"text":"甘いものに目が無く、虫歯にもなることがある。"},{"spoiler":false,"text":"A16"},{"spoiler":false,"text":"遥か昔の時代に作られた、非常に高度な性能を持つオートマタ。"},{"spoiler":false,"text":"とある図書館の司書をしていたが、現在はキースグリフの助手として同行している。"},{"spoiler":false,"text":"過去の時代の膨大な知識を持っているが、記憶が一部破損しているらしい。"},{"spoiler":false,"text":"本と甘いものが好きで、暇をみては探し歩いている。"}],"source":"bangumi","sourceCharacterId":"44472"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"44472","value":"二号馆图书管理员(A14)"},{"label":"职业","source":"bangumi","sourceCharacterId":"44472","value":"奇斯葛里夫的助手(A16)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/658c94244a09537d33de99543844380bab17baee808fbfd7ed4ca30fe95bfe32.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82b345cb2d594d3ec5a30da30063adf525816c75bf351cf809363cd3d7dc89b1.webp","width":182,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐土原かおり","creatorId":"vndb:s4970","sourcePersonId":"vndb:s4970","canonicalEntityId":"vndb:s4970","name":"佐土原 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37563:44472:6869:1","source":"bangumi"}]},{"characterId":"char_bangumi_44485","characterName":"Harry Olson","sourceIds":{"bangumi":[{"characterId":"44485","match":"source-roster","subjectId":"158006"},{"characterId":"44485","match":"source-roster","subjectId":"37563"},{"characterId":"44485","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"Harry Olson","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"175"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A14　　36歳"},{"spoiler":false,"text":"街の有力者にして稀代の好事家"},{"spoiler":false,"text":"フィルツベルクの自治会に大きな影響力を持つ商会の現経営者。"},{"spoiler":false,"text":"前時代に対して多大なる興味と感心と収集癖を持つ。"},{"spoiler":false,"text":"様々な前時代に関するトンデモ知識を独学で学習しており、その内容は嘘か真か判断がつかないものばかりだが、湯水のように湧き出る言葉が彼の「特定の知識に関する」造詣の深さを物語る。"},{"spoiler":false,"text":"金銀財宝には目もくれず、前時代の遺物をはじめとして、普通の人には何の価値も無いガラクタばかりに傾倒して収集している。"},{"spoiler":false,"text":"性格は温厚で典型的なとっちゃん坊やだが、育ちの環境も手伝ってか基本的にどんな人に対しても好意的で、アーシャにも助言や手助けを申し出てくれる。"},{"spoiler":false,"text":"A15　　40歳"},{"spoiler":false,"text":"奇妙なものが大好きな、器の大きい冒険家"},{"spoiler":false,"text":"謎の自称冒険家、珍しい物好きで、様々な場所に出没する変わり者。"},{"spoiler":false,"text":"遠方で大きな商会を運営していたようだが、しっかり者の後任に預け、私財を注ぎ込んで「学術的探求の旅」に出ている。"},{"spoiler":false,"text":"しかし探検家としてはまだまだ素人であり、冒険の度にトラブルに逢うこともしばしば。"},{"spoiler":false,"text":"金銀財宝の類には興味がなく、誰の目にもガラクタとしか思えないものを集めている。"},{"spoiler":false,"text":"A16　　46歳"},{"spoiler":false,"text":"まだ見ぬ秘宝を追い求める、風変わりな冒険家"},{"spoiler":false,"text":"謎の自称冒険家。珍しい物好きで、様々な場所に出没する変わり者。"},{"spoiler":false,"text":"相棒のレイファーと共に、学術的探求のために世界各地を巡っていて、今は黄昏の海を中心に活動している。"},{"spoiler":false,"text":"交易投資家としても成功しており、最近はステラードとフィルツベルクを結ぶ交易ルートの設置にも注力しているらしい。"}],"source":"bangumi","sourceCharacterId":"44485"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"44485","value":"哈利商会经营者兼好事玩家(A14)"},{"label":"职业","source":"bangumi","sourceCharacterId":"44485","value":"自称能干的冒险家(A16)"},{"label":"职业","source":"bangumi","sourceCharacterId":"44485","value":"谜一般的冒险家(A15)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/148a85ae5dfc4853c35ee007fb011b072882221c14e43aae965333f23f6f82eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdd6bfe4f002d47e053b0010a3e8a793b95211f606e3221f023dbc67f4867541.webp","width":135,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真殿光昭","creatorId":"vndb:s887","sourcePersonId":"vndb:s887","canonicalEntityId":"vndb:s887","name":"真殿 光昭","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37563:44485:4313:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p910","sourceCompanyId":"egs:brand:766","canonicalEntityId":"vndb:p910","name":"ガスト","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:17053:766","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
