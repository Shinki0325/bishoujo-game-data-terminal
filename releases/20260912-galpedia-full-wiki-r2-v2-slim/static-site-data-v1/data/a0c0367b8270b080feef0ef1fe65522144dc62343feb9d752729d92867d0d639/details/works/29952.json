:creator:34312","canonicalEntityId":"egs:creator:34312","name":"ウキヨライフ","detail":"DTP","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:226088","source":"egs"},{"creditedName":"Kitty-tama","creatorId":"vndb:s24005","sourcePersonId":"vndb:s24005","canonicalEntityId":"vndb:s24005","name":"Kitty-tama","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:169919","source":"vndb"},{"creditedName":"DS55","creatorId":"vndb:s27612","sourcePersonId":"vndb:s27612","canonicalEntityId":"vndb:s27612","name":"Roman Stuart","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:169920","source":"vndb"},{"creditedName":"Eleventacle","creatorId":"vndb:s29602","sourcePersonId":"vndb:s29602","canonicalEntityId":"vndb:s29602","name":"Eleventacle","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:169921","source":"vndb"},{"creditedName":"Dr.Octopus","creatorId":"vndb:s52105","sourcePersonId":"vndb:s52105","canonicalEntityId":"vndb:s52105","name":"Dr.Octopus","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:169922","source":"vndb"},{"creditedName":"tomsan","creatorId":"vndb:s6343","sourcePersonId":"vndb:s6343","canonicalEntityId":"vndb:s6343","name":"tomsan","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:169926","source":"vndb"},{"creditedName":"樋舘 誠","creatorId":"vndb:s7774","sourcePersonId":"vndb:s7774","canonicalEntityId":"vndb:s7774","name":"樋舘 誠","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:169927","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c31434","characterName":"オーディン","sourceIds":{"vndbCharacterId":"c31434"},"originalCharacterName":"オーディン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protector of the Holy Sanctuary Valhalla situated in the middle of the Floating Continent of Yggdrasil, and watches over humanity from above."},{"spoiler":false,"text":"Leaving the protection of Yggdrasil to the 4 goddesses she created, she only descends onto Yggdrasil whenever there is an emergency or something is in urgent need of her attention. In many ways, she can be said to be the arbitrator who eradicates any and all problems with her overwhelming power."},{"spoiler":false,"text":"She was originally a god with the body of an adult and had overwhelming divinity that is often said to be equal in power to Surtr. After the 『Ragnarok War』, and the creation of the Floating Continent of Yggdrasil as well as the creation of the 4 goddesses, she has exhausted her powers. It is because of the loss in power that she has now reverted to a more youthful form, and has lost some of her memories of yore."},{"spoiler":false,"text":"She is a very rational and valorous god. If she deems something or someone to be evil, she will pass judgement onto them without mercy."},{"spoiler":false,"text":"「Ahaha! Good, I shall allow it! It has been awhile since I have last seen a reckless fool like you. I am the Absolute God Odin! Bear witness to my power!」"},{"spoiler":false,"text":"Weapon names: Gungnir (spear); Huginn, Muninn, Geri, Freki (blades)"},{"spoiler":false,"text":"From Ninetail"}],"source":"vndb","sourceCharacterId":"c31434"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/428699e27d8550195144878d1488d6f078e084767d359d88f37c4ef71335fd05.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b54256d56b6df9c172d7efa0063a92817b6c8a29a3f28e18d8b4affa2ba62f75.webp","width":212,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c51977","characterName":"ロキ＝ムスペルヘイム","sourceIds":{"vndbCharacterId":"c51977"},"originalCharacterName":"ロキ＝ムスペルヘイム","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The current head of Muspellzheimr, a tributary house to the imperial nobility which once held significant influence within the demon realm."},{"spoiler":false,"text":"He lived his early life peacefully with his parents. However, one day his father was branded a rebel without cause, and was executed for his suspected crimes while his mother was incarcerated."},{"spoiler":false,"text":"Loki was not executed, but was instead forced to give up his demonic armament which is considered a proof of inheritance to the throne."},{"spoiler":false,"text":"After that, Loki was forced to live in the castle, ostracised and branded as the child of a rebel. However, Loki has now decided to participate in the feud for the throne."},{"spoiler":false,"text":"Armed with his skill with the spear and tactical mind left behind by his deceased father, with the knowledge of magic and how to handle women taught to him by his maid, Fena..."},{"spoiler":false,"text":"And finally, primed with his ace in the hole, the power of the 『God of Armageddon』, he fights to win the feud for the throne."},{"spoiler":false,"text":"「I will become the ruler of the demon realm. To that end, I'm willing to destroy every obstacle in my path!」"}],"source":"vndb","sourceCharacterId":"c51977"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a6d44ff04c1155a94cd4dd868f3c2d419d5fce2214428b12d4c4819acdc9f3d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdac979ed26f2adff3880adf03c48798ef2d6a3c44b06b66abfb55878debd5b5.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:2058","sourceCompanyId":"egs:brand:2058","canonicalEntityId":"egs:brand:2058","name":"DualTail(DualMage)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:29952:2058","source":"egs"},{"companyId":"vndb:p507","sourceCompanyId":"vndb:p507","canonicalEntityId":"vndb:p507","name":"dualtail","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:84483:v29474","source":"vndb"},{"companyId":"vndb:p102","sourceCompanyId":"vndb:p102","canonicalEntityId":"vndb:p102","name":"JAST USA","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:94154:v29474","source":"vndb"},{"companyId":"vndb:p507","sourceCompanyId":"vndb:p507","canonicalEntityId":"vndb:p507","name":"dualtail","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:94155:v29474","source":"vndb"},{"companyId":"vndb:p507","sourceCompanyId":"vndb:p507","canonicalEntityId":"vndb:p507","name":"dualtail","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:98625:v29474","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
