e,"text":"少しまだ幼さが残るが、端整な顔立ちの青年。"},{"spoiler":false,"text":"幼い頃から、帝王学を学んでいるが、まだレティーシアの補佐なしでは、何事も決定できない。"},{"spoiler":false,"text":"皇女達とも仲はいいが、特に姉のレティーシアに甘えている。"}],"source":"bangumi","sourceCharacterId":"130493"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c63555","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"26405","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"26405","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"130493","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d73883ba7feec89a3314055cf755586584f2f18cd8891804a6bffa0bda14433b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17a54e1acaee4772576c6a354519fde8e1cc71d5e40ea97cc68a69a7851d7a2e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:437825:130493:5906:1","source":"bangumi"}]},{"characterId":"char_c63557","characterName":"ユリエル","sourceIds":{"bangumi":[{"characterId":"130494","match":"exact-normalized-name-in-linked-work","subjectId":"437825"}],"egsCharacterIds":["26402"],"vndbCharacterId":"c63557"},"originalCharacterName":"ユリエル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"b"}},"descriptions":[{"segments":[{"spoiler":false,"text":"皇宮で下働きしているメイドの一人。"},{"spoiler":false,"text":"常に無表情で、無感情な彼女。"},{"spoiler":false,"text":"そんな彼女の正体は、闇の世界で生きる暗殺集団のメンバー。"},{"spoiler":false,"text":"有能な殺し屋で、***に対して悦楽を感じているが、その所作は冷静にして理性的。"},{"spoiler":false,"text":"主人公に「皇位を奪い取れ」と言葉巧みに誘導した張本人。"}],"source":"egs","sourceCharacterId":"26402","sourceWorkId":"6153","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公に、皇位簒奪を提案してきた女性。"},{"spoiler":false,"text":"普段は王宮付きのメイドとして働いているが、その正体は暗殺を請け負う組織の一員。"},{"spoiler":false,"text":"顔に似合わず、快楽主義的、愉快犯的な言動を繰り返す。"},{"spoiler":false,"text":"手際がよく有能だが、得体の知れないところがある。"}],"source":"bangumi","sourceCharacterId":"130494"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"b","source":"vndb","sourceCharacterId":"c63557","value":"b"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"26402","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"26402","value":"女性"},{"comparisonValue":"f","source":"bangumi","sourceCharacterId":"130494","value":"女"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7ad1091cb6dd55edb0f8c6436dc38fab66b27267f56fbe3bcc653c426a1821c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75d6d3c2d5d5b33211b813f716489cef660b3f1b7a0df5e0c98b39ca88352a2e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:437825:130494:5741:1","source":"bangumi"}]},{"characterId":"char_c63560","characterName":"シャーリーン","sourceIds":{"bangumi":[{"characterId":"130495","match":"exact-normalized-name-in-linked-work","subjectId":"437825"}],"egsCharacterIds":["26403"],"vndbCharacterId":"c63560"},"originalCharacterName":"シャーリーン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「フェニキア皇国」の司祭長兼女官長。"},{"spoiler":false,"text":"レティーシアら皇女たちの教育係でもあり、母のように姉のような立場で皇女たちの成長を見守ってきた。"},{"spoiler":false,"text":"頭脳は明晰だが、考え方が型にハマりやすく、融通が利かないところも。"},{"spoiler":false,"text":"既婚者だが、その夫は隣国「エストゥール」との戦で命を落としている。"}],"source":"egs","sourceCharacterId":"26403","sourceWorkId":"6153","spoiler":false},{"segments":[{"spoiler":false,"text":"皇女達の側に侍り、司祭長と女官長を同時に務める人物。"},{"spoiler":false,"text":"幼い頃から皇女達を、母として、姉として、教育係として暖かく厳しく見守ってきた。"},{"spoiler":false,"text":"頭は切れるが、少し杓子定規なところがある。"},{"spoiler":false,"text":"夫をエストゥールとの戦いで亡くしている。"}],"source":"bangumi","sourceCharacterId":"130495"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa4f41b775521bfd8986673b2037b129077b010681f2fc77dab0c71cf3b4ef50.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/760af9542e955e37642b075114d3940ee25c2be2e39a595cc0a2d98f59d99ddf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:437825:130495:4489:1","source":"bangumi"}]},{"characterId":"char_c63561","characterName":"マルティナ","sourceIds":{"bangumi":[{"characterId":"130497","match":"exact-normalized-name-in-linked-work","subjectId":"437825"}],"egsCharacterIds":["26404"],"vndbCharacterId":"c63561"},"originalCharacterName":"マルティナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「フェニキア皇国」の大司祭の娘。"},{"spoiler":false,"text":"麗しくも美しい容姿だが、親の威を借りて権力を振りかざす、高飛車かつ、傲慢な性格を持つ。"},{"spoiler":false,"text":"そのため、あまり彼女に良い感情を抱く者は少なく、近寄りたがらない。"}],"source":"egs","sourceCharacterId":"26404","sourceWorkId":"6153","spoiler":false},{"segments":[{"spoiler":false,"text":"大司祭の娘。高飛車でキツネ目の女