:{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Connor is an RK800 android and one of the protagonists in Detroit: Become Human. Built as an advanced prototype, he is designed to assist human law enforcement; specifically in investigating cases involving deviant androids."},{"spoiler":false,"text":"Sent to the Detroit City Police Department, Connor is partnered with Lt. Hank Anderson. Throughout the course of their investigation, Connor may make discoveries about cases, himself, and become a deciding agent in tipping the coming events."}],"source":"bangumi","sourceCharacterId":"63802"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da9277c768b5ce0bb6a0665fd191a3aba5a534ae4f979adba63d2d42488f3861.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f9c2c3e6032357bcec0c0bc0e670b7b9a5878ed3a7f0e1946e133f4993b4986.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花輪英司","creatorId":"vndb:s12816","sourcePersonId":"vndb:s12816","canonicalEntityId":"vndb:s12816","name":"花輪 英司","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:151187:63802:4354:1","source":"bangumi"}]},{"characterId":"char_bangumi_63803","characterName":"カーラ","sourceIds":{"bangumi":[{"characterId":"63803","match":"source-roster","subjectId":"151187"}]},"originalCharacterName":"カーラ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"163"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kara is a AX400 android and one of the protagonists in Detroit: Become Human. She is a common housemaid android serving in the home of her owner Todd Williams and caring for his daughter Alice."},{"spoiler":false,"text":"Kara's connection to her young charge may trigger an upheaval that breaks Kara from her repetitive existence and starts her on a journey out into the world."}],"source":"bangumi","sourceCharacterId":"63803"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/923e739efbfd5702d2fe0d7d98637a5dda0d9034db98461e0bc016aa165e6e0e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b746c1926390d53d6278f0c9db60e4170c3ce6d8363e09808125b861d9a0f798.webp","width":175,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_63804","characterName":"マーカス","sourceIds":{"bangumi":[{"characterId":"63804","match":"source-roster","subjectId":"151187"}]},"originalCharacterName":"マーカス","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"185"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Markus is an RK200 android and one of the protagonists of Detroit: Become Human. He is the domestic android of painter Carl Manfred."},{"spoiler":false,"text":"Events catapult him out of his familiar life and lead him on to freedom and rebellion. During the game he becomes a leader of androids and may direct them in a violent or peaceful revolt against human oppression."}],"source":"bangumi","sourceCharacterId":"63804"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d2140823a1152126d151fb0334481e73887631a085603730218df9da3fdd598.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d56a44fd0805dad9faff58b952f959105fb4e1c7e7d21a35657e0a51230c0277.webp","width":256,"height":144,"source":"static-detail"},"actors":[{"creditedName":"内田夕夜","creatorId":"vndb:s5989","sourcePersonId":"vndb:s5989","canonicalEntityId":"vndb:s5989","name":"内田 夕夜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:151187:63804:4977:1","source":"bangumi"}]},{"characterId":"char_bangumi_63805","characterName":"ハンク・アンダーソン","sourceIds":{"bangumi":[{"characterId":"63805","match":"source-roster","subjectId":"151187"}]},"originalCharacterName":"ハンク・アンダーソン","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"192"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"209"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Lieutenant Hank Anderson is a human in Detroit: Become Human. He is a grizzled and alcoholic detective in the Detroit City Police Department who hates androids."},{"spoiler":false,"text":"Tasked with investigating cases involving deviant androids, he is assigned android Connor to assist him."}],"source":"bangumi","sourceCharacterId":"63805"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81ee148684b4dfe4fdd42df349d992bbbb6e3bdbe818d7b710f2a9025fafec9c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6883d8a2ac79e655a5c056a672704154fd57bde1e25c005aba6e22e2e4e4192.webp","width":256,"height":214,"source":"static-detail"},"actors":[{"creditedName":"岩崎ひろし","creatorId":"vndb:s17315","sourcePersonId":"vndb:s17315","canonicalEntityId":"vndb:s17315","name":"岩崎 ひろし","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:151187:63805:5331:1","source":"bangumi"}]},{"characterId":"char_bangumi_7103","characterName":"FBI","sourceIds":{"bangumi":[{"characterId":"7103","match":"source-roster","subjectId":"151187"}]},"originalCharacterName":"FBI","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"联邦调查局，简称FBI，是美国司法部的主要执法及调查单位，也是美国联邦政府最大的反间谍机构。根据《美国法典》第28条533款，授权司法部长“委任官员侦测反美国的罪行”，另外其它联邦的法令给予FBI权力和职责调查特定的罪行。FBI现有的调查司法权已经超过200种联邦罪行。十大通缉要犯清单从1930年起公布于众。"},{"spoiler":false,"text":"联邦调查局的任务是调查违反联邦犯罪法，支持法律。保护美国调查来自于外国的情报和恐怖活动，在领导阶层和法律执行方面对联邦、州、当地和国际机构提供帮助，同时在响应公众需要和忠实于美国宪法前提下履行职责。"},{"spoiler":false,"text":"联邦调查局在每次调查的情报资料后，递交适当的美国律师或者美国司法部官员，由他们决定是否批准起诉或其它行动。其中五大影响社会的方面享有最高优先权：反暴行、毒品／组织犯罪、外国反间谍活动、暴力犯罪和白领阶层犯罪。"}],"source":"bangumi","sourceCharacterId":"7103"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94017dc2a118f85ef3d356396e2ebd8d432518801406c294846c33cb9d51db0e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0a63145d0644f1b831d97e4e494754759acd7f7d24445eb46cbe6e874da5cbc.webp","width":243,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_77682","characterName":"North","sourceIds":{"bangumi":[{"characterId":"77682","match":"source-roster","subjectId":"151187"}]},"originalCharacterName":"North","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"North is a WR400 android in Detroit: Become Human. She is a deviant and she accompanies Markus on his journey in the game."},{"spoiler":false,"text":"诺斯原为 CyberLife 公司旗下所贩售的 WR400 型彷生人，商品名称为翠西。"},{"spoiler":false,"text":"为了彷生人的大义，诺斯已做好牺牲性命的觉悟。由于过往的遭遇，让她对人类抱持强烈的憎恶，为了解放彷生人同胞，愿意付出任何代价。同为彷生人解放组织的成员，跟随马库斯参加底特律市中心的同胞解放运动。"}],"source":"bangumi","sourceCharacterId":"77682"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d13b3c48b674b4e6b65d350f0d46b88373264b02848590e3ad9007578e4a92d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/2991d75e6a76c56c18cbb06eee001b5e34776059357f4a0af3b96b90cc3bbb9c.webp","width":256,"height":211,"source":"static-detail"},"actors":[{"creditedName":"恒松あゆみ","creatorId":"egs:creator:38986","sourcePersonId":"egs:creator:38986","canonicalEntityId":"egs:creator:38986","name":"恒松あゆみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:151187:77682:4725:1","source":"bangumi"}]},{"characterId":"char_bangumi_77683","characterName":"Alice Williams","sourceIds":{"bangumi":[{"characterId":"77683","match":"source-roster","subjectId":"151187"}]},"originalCharacterName":"Alice Williams","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"陶德·威廉的女儿。9 岁时母亲离家出走，和父亲相依为命。"},{"spoiler":false,"text":"个性内向不愿对他人敞开心房，畏惧家中的父亲，尽可能不让自己太出头惹父亲生气。沉默寡言，神情经常带着哀伤，书中世界是她最好的避难所。手上总是抱着狐狸玩偶「提摩西」。"}],"source":"bangumi","sourceCharacterId":"77683"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c64c5e07d2486f93940ea8606507fe0cd567e6130f77074c57831f4ef39791db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07c5898a536800b6afc97e8372d6968d230c353538a57b490fc0d7e0e27d6088.webp","width":232,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:6469","sourceCompanyId":"egs:brand:6469","canonicalEntityId":"egs:brand:6469","name":"Quantic Dream","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:28849:6469","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
