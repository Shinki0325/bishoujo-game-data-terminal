elationId":"vndb:vn-staff:23943","source":"vndb"},{"creditedName":"新堂 真弓","creatorId":"vndb:s1427","sourcePersonId":"vndb:s1427","canonicalEntityId":"vndb:s1427","name":"新堂 真弓","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:23944","source":"vndb"},{"creditedName":"雛祭 桃子","creatorId":"vndb:s1791","sourcePersonId":"vndb:s1791","canonicalEntityId":"vndb:s1791","name":"雛祭 桃子","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:23945","source":"vndb"},{"creditedName":"MOKA","creatorId":"vndb:s8200","sourcePersonId":"vndb:s8200","canonicalEntityId":"vndb:s8200","name":"MOKA","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:23949","source":"vndb"},{"creditedName":"キリマンジャロ","creatorId":"vndb:s10531","sourcePersonId":"vndb:s10531","canonicalEntityId":"vndb:s10531","name":"キリマンジャロ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:23950","source":"vndb"},{"creditedName":"星くず集積所","creatorId":"vndb:s30916","sourcePersonId":"vndb:s30916","canonicalEntityId":"vndb:s30916","name":"星くず集積所","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:23951","source":"vndb"}]},"cast":[{"characterId":"char_c27528","characterName":"蒼衣 心菜","sourceIds":{"bangumi":[{"characterId":"63094","match":"exact-normalized-name-in-linked-work","subjectId":"15746"}],"egsCharacterIds":["16009"],"vndbCharacterId":"c27528"},"originalCharacterName":"蒼衣 心菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園裏の山にある神社の娘。当然、巫女さん。"},{"spoiler":false,"text":"清楚で可愛らしく、頑張り屋さん。人の良さも抜群。しかしとことんさっぱり運がなく、さらにはドジッ娘でよく転び、よくモノを失くし、あらゆるドジを踏む。"},{"spoiler":false,"text":"隣に住む幼馴染の主人公の激運のおかげで不運は相殺されているため、命に関わるまでには至っていない（？）。"},{"spoiler":false,"text":"ひょんなことから巫女神の有資格者となった彼女。その巫女神の選定者はほのかな恋心を抱く主人公。はたして、彼女の想いは叶うのか？"}],"source":"egs","sourceCharacterId":"16009","sourceWorkId":"11749","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のお隣に住む、幼なじみの巫女さん。"},{"spoiler":false,"text":"正統派の巫女さんらしく清楚っぽくて、可愛らしさだけは天下一品。"},{"spoiler":false,"text":"だけどドジな娘。というか運がない。ひたすらない。とにかくない、不運な娘。"}],"source":"bangumi","sourceCharacterId":"63094"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b653c9e8f7f39ccd22fceb5c31851c6f7778df7385867ac6ef4c3ac9e9ffaf2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1bbdbb91627765e0e90e9269b8cbfc4a7910cfec21c5449e0946f1152485f451.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15746:63094:5020:1","source":"bangumi"}]},{"characterId":"char_c27529","characterName":"白神 暖音","sourceIds":{"bangumi":[{"characterId":"63095","match":"exact-normalized-name-in-linked-work","subjectId":"15746"}],"egsCharacterIds":["16011"],"vndbCharacterId":"c27529"},"originalCharacterName":"白神 暖音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"白神神社の巫女さん。主人公の先輩で、お姉ちゃん的な存在。"},{"spoiler":false,"text":"強気で押しが強く、世話好きで周囲を引っ張っていく、頼りになる女の子。"},{"spoiler":false,"text":"何でも簡単にこなしてしまう天才肌。"},{"spoiler":false,"text":"主人公とは旧知の仲で、子供の頃はガキ大将よろしく、主人公たちを引き連れ、遊びまわっていた。"},{"spoiler":false,"text":"主人公とエッチするのはあくまでも義務と公言していたが、後半は……!?"},{"spoiler":false,"text":"妹の陽菜乃を大切に思っているが、あのオッパイは許せん、と思っている。"}],"source":"egs","sourceCharacterId":"16011","sourceWorkId":"11749","spoiler":false},{"segments":[{"spoiler":false,"text":"白神神社の巫女さんであり、主人公の先輩であり、お姉ちゃん的な存在。"},{"spoiler":false,"text":"強気で押しが強く、世話好きの姉御肌なため周りからの人望は厚い。"},{"spoiler":false,"text":"セクハラっぽい発言で主人公をからかうこともある。"},{"spoiler":false,"text":"妹の陽菜乃には優しい姉だが、あのおっぱいだけは許せんと思っている。"}],"source":"bangumi","sourceCharacterId":"63095"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/cab732fb2608e14eb52dcadf3cf4452a9432ce2f32e5fd4d13b878b7339132d3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8308202ccc381ed7a248f4d0c8a5fcaad3901da6422701596553112af96ddd8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"たかはし智秋","creatorId":"vndb:s287","sourcePersonId":"vndb:s287","canonicalEntityId":"vndb:s287","name":"たかはし 智秋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15746:63095:4604:1","source":"bangumi"}]},{"characterId":"char_c27530","characterName":"白神 陽菜乃","sourceIds":{"bangumi":[{"characterId":"63096","match":"exact-normalized-name-in-linked-work","subjectId":"15746"}],"egsCharacterIds":["16012"],"vndbCharacterId":"c27530"},"originalCharacterName":"白神 陽菜乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"白神神社の巫女さん。曖音の妹。"},{"spoiler":false,"text":"明朗快活なポジティブ娘。天真爛漫で明るく、周囲に元気を与えてくれる。"},{"spoiler":false,"text":"天才肌で何でもこなす姉とは対照的にやや不器用だが、それを努力で精一杯カバー。"},{"spoiler":false,"text":"過去に命を救ってくれた主人公ラブ。ベタ惚れ状態で、主人公の恋人になりたくて色々とアタック。"},{"spoiler":false,"text":"大きなオッパイに少しコンプレックスを持っているが、主人公が巨乳好きと聞いてラッキーと思っている。"}],"source":"egs","sourceCharacterId":"16012","sourceWorkId":"11749","spoiler":false},{"segments":[{"spoiler":false,"text":"白神神社の巫女さんで、暖音の妹。"},{"spoiler":false,"text":"元気系で、いつもポジティブ、そして巨乳。"},{"spoiler":false,"text":"前向きで努力家、周りにパワーを与えてくれるような “お日様”みたいな娘。"},{"spoiler":false,"text":"大好きな主人公に振り向いてほしいと想う、乙女チックな一面もある。"}],"source":"bangumi","sourceCharacterId":"63096"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7ac1315b6a829759f5d75cf772784e449a35ea06f0058fbc71941a14ee8d44c9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f260d222bd3576a36530bc274d0c54bb90df0d663951fed35956f0fda0bad657.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新堂真弓","creatorId":"vndb:s1427","sourcePersonId":"vndb:s1427","canonicalEntityId":"vndb:s1427","name":"新堂 真弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15746:63096:6166:1","source":"bangumi"}]},{"characterId":"char_c27531","characterName":"朱雀野 華蓮","sourceIds":{"bangumi":[{"characterId":"63097","match":"exact-normalized-name-in-linked-work","subjectId":"15746"}],"egsCharacterIds":["16010"],"vndbCharacterId":"c27531"},"originalCharacterName":"朱雀野 華蓮","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"町で最も小さく貧乏な神社の娘。やはり巫女さん。"},{"spoiler":false,"text":"主人公とは憎まれ口を叩き合える親友と言える間柄。"},{"spoiler":false,"text":"直情型でよく怒り、よく爆発する。主人公とはあくまでも悪友としての関係だったが、恋愛を意識してから勝手が変わって、落ち着きがなくなった。これまで通り主人公と接することが出来ず、なんとなくツンツンした態度になりがちで、他の娘に遠慮して身を引こうと思っても、主人公が取られると思うとイライラと……。"},{"spoiler":false,"text":"目下の悩みは実家の神社とパイズリ出来ないちっちゃなおっぱい。"},{"spoiler":false,"text":"将来の夢（野望？）はオンボロ神社を日本一にすることらしく、神社再興の変な企画を実行しては失敗を繰り返している。"}],"source":"egs","sourceCharacterId":"16010","sourceWorkId":"11749","spoiler":false},{"segments":[{"spoiler":false,"text":"朱雀野神社の巫女さん。"},{"spoiler":false,"text":"仲の良い女友達で、ケンカをしても決して崩れることのない関係。よく心菜を加えた3人でつるんでいる。"},{"spoiler":false,"text":"趣味は金儲けだが、実家の神社は町で一番小さい貧乏神社。"},{"spoiler":false,"text":"時折みんなを集めて、神社再興の変な金儲け企画をやっては失敗している。"}],"source":"bangumi","sourceCharacterId":"63097"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab97cce6774e0ad7f59ad6fcb8b3f368b5ed82de3e1e4d0c15f709841621c2e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afa75320c921f7284d0118f769979fb99cc92fda08f7d19c8df5ecaf9779716b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15746:63097:4956:1","source":"bangumi"}]},{"characterId":"char_c27532","characterName":"武上 小夜","sourceIds":{"bangumi":[{"characterId":"63098","match":"exact-normalized-name-in-linked-work","subjectId":"15746"}],"egsCharacterIds":["16013"],"vndbCharacterId":"c27532"},"originalCharacterName":"武上 小夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の元に謎の生物（コマイヌ？）・タマと一緒に巫女神選別の役目を告げにきた女の子。"},{"spoiler":false,"text":"クールで寡黙。全てが謎に包まれ、まさにミステリアス。"},{"spoiler":false,"text":"はたして、彼女の正体は？"}],"source":"egs","sourceCharacterId":"16013","sourceWorkId":"11749","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のもとにやって来た謎の転校生。"},{"spoiler":false,"text":"新たな巫女神を選定する役目を主人公に告げる。"},{"spoiler":false,"text":"長い黒髪がトレードマーク。"}],"source":"bangumi","sourceCharacterId":"63098"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/