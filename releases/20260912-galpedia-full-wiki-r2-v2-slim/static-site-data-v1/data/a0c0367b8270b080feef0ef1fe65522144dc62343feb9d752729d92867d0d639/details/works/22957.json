{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"22957","model":{"presentationWorkId":"egs:22957","staff":{"artwork":[],"scenario":[],"music":[],"other":[{"creditedName":"橋本英樹","creatorId":"egs:creator:25892","sourcePersonId":"egs:creator:25892","canonicalEntityId":"egs:creator:25892","name":"橋本英樹","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"no-alias-hit","relationId":"egs:work-creator:160289","source":"egs"}]},"cast":[{"characterId":"char_bangumi_10591","characterName":"宇佐美哈尔","sourceIds":{"bangumi":[{"characterId":"10591","match":"source-roster","subjectId":"1385"},{"characterId":"10591","match":"source-roster","subjectId":"18333"}]},"originalCharacterName":"宇佐美哈尔","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"唯一的青梅竹马。做事冷静且深思熟虑，意志异常的坚强。"},{"spoiler":false,"text":"以她破格的想法和大胆的行动，在幼年拯救了孤独的主人公。"},{"spoiler":false,"text":"就在魔王出没的同时，转入了主人公的学校。带有一种神秘而难以靠近的气氛。"},{"spoiler":false,"text":"特长是小提琴。硬说是北极出身，不过估计也是骗人的。特别喜欢企鹅。"}],"source":"bangumi","sourceCharacterId":"10591"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44eda8eac09e81d5b54e401f7c279033173cf5425f105522c7ef5ebdccd627a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f9604e94f8e82c1cda0afe48f460753439f95a19c66b8c163f35d71d765c42ca.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_12168","characterName":"あざい かのん","sourceIds":{"bangumi":[{"characterId":"12168","match":"source-roster","subjectId":"1385"},{"characterId":"12168","match":"source-roster","subjectId":"18333"}]},"originalCharacterName":"あざい かのん","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"京介的同年义妹，读同一所学校但非同居。花式溜冰的实力是全国级水平。对溜冰以外的事情并不关心。"}],"source":"bangumi","sourceCharacterId":"12168"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4ec196af641f0e18824d312ca712e93ead4f6617376fd2f23d3cffb8d285a331.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed1a6d851193edb01b8ebd933c19a8365fe613173700a016536a0e3388de65b8.webp","width":200,"height":240,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_12310","characterName":"時田 ユキ","sourceIds":{"bangumi":[{"characterId":"12310","match":"source-roster","subjectId":"1385"},{"characterId":"12310","match":"source-roster","subjectId":"18333"}]},"originalCharacterName":"時田 ユキ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"春的朋友，因和春一样的原因而入读学校，头脑和沟通能力非常高。"}],"source":"bangumi","sourceCharacterId":"12310"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94ac97b174ee4e8c900acf3ad86ac5db4992368719aec248949ec25345b1554b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3dc34e0d7ace74a821f88d795ebce73d0ecd86a10c9fda4ef2c5ff0456cd37f0.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c1562","characterName":"泉戸 ましろ","sourceIds":{"bangumi":[{"characterId":"1801","match":"source-roster","subjectId":"114064"},{"characterId":"1801","match":"source-roster","subjectId":"131917"},{"characterId":"1801","match":"source-roster","subjectId":"18333"},{"characterId":"1801","match":"source-roster","subjectId":"198439"},{"characterId":"1801","match":"exact-normalized-name-in-linked-work","subjectId":"3177"},{"characterId":"1801","match":"source-roster","subjectId":"3177"}],"egsCharacterIds":["8239"],"vndbCharacterId":"c1562"},"originalCharacterName":"泉戸 ましろ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"403"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She calls Yuuri her husband. Pretty obvious from her cute ears that she isn’t a human. She has considerable power even among the tayutama and hopes for the union of humans and tayutama. She doesn’t get the current technology so it’s pretty funny to see her fumble around with it. She has a pretty optimistic and cute personality. Florence student."},{"spoiler":false,"text":"From Accany's review"}],"source":"vndb","sourceCharacterId":"c1562"},{"segments":[{"spoiler":false,"text":"創聖学院女子学部（フローレス）カリキュラムＳ受講生（最上級生）。"},{"spoiler":false,"text":"裕理を「夫」と呼び、積極的にアタックしてくる太転依（たゆたい）の娘。"},{"spoiler":false,"text":"その姿勢は何かを覚悟しているように見え、なし崩し的に泉戸家に住むことに。"},{"spoiler":false,"text":"知識が全体的に古く、能天気で寛容的だが、怒ると恐ろしい。"},{"spoiler":false,"text":"アメリとは裕理と巡った恋のライバル。"},{"spoiler":false,"text":"「私はいつでも、どんな時でも、裕理さんの味方ですから」"}],"source":"egs","sourceCharacterId":"8239","sourceWorkId":"10100","spoiler":false},{"segments":[{"spoiler":false,"text":"最強の力を持った太転依、綺久羅美守毘売の化成した姿。"},{"spoiler":false,"text":"人と太転依との共存を志し、芦原町での事件の後、夫である裕理と共に全国を精力的に巡っていた。"},{"spoiler":false,"text":"鷹千帆が国内でも特に濃い神気の集まる土地であることが発覚し、矢古民町に八衢神社が建立されてからは、泉戸こはくと共にと2人で暮らしている。"},{"spoiler":false,"text":"礼節正しい大人の女性だが、自分の意見を曲げない頑固なところがあったり、子供のようにはしゃいでしまったり、娘のように可愛がっているこはくに対して親バカっぷりを発揮したりすることもある。"},{"spoiler":false,"text":"裕理とは精神的に繋がっており、いつでも言葉を交わせるため、そういう意味で寂しさは感じることは無いのだが、こはくと空のやり取りなどを見ていると、つい羨ましくなって、裕理に泣き付くこともある。"},{"spoiler":false,"text":"好きな物はましゅまろ。"},{"spoiler":false,"text":"最近、恋愛小説を読み始め、夢中になってしまっているらしい。"}],"source":"egs","sourceCharacterId":"8239","sourceWorkId":"21942","spoiler":false},{"segments":[{"spoiler":false,"text":"开学日突然出现的少女，创圣学院女子学部S课程学生（最上级生）。其真正身分是以前绮久罗美守毗卖“化成”的太转依，懂得使用咒术，“真白”是裕理取的名称。外表和人类分表不大，但有狐耳和尾。知识非常古老，不懂得操作电器。对裕理在恋爱上积极展开攻势，之后更住在泉户家。保持着绮久罗美守毗卖的思想和记忆，要和裕理创造“人类和太转依共存的世界”。"}],"source":"bangumi","sourceCharacterId":"1801"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/5549be002b3b6a27ab520da7fe6dd389c0e8888428aeb5c7ee8e0de857ad79d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee11443c5c871897273d9d33cd90fe64f24fcfe3f47aa19b7e0f9c781dd5572e.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18333:1801:4689:1","source":"bangumi"}]},{"characterId":"char_c1564","characterName":"如月 美冬","sourceIds":{"bangumi":[{"characterId":"1804","match":"source-roster","subjectId":"114064"},{"characterId":"1804","match":"source-roster","subjectId":"131917"},{"characterId":"1804","match":"source-roster","subjectId":"18333"},{"characterId":"1804","match":"source-roster","subjectId":"198439"},{"characterId":"1804","match":"exact-normalized-name-in-linked-work","subjectId":"3177"},{"characterId":"1804","match":"source-roster","subjectId":"3177"}],"egsCharacterIds":["8242"],"vndbCharacterId":"c1564"},"originalCharacterName":"如月 美冬","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"301"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"169"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mifuyu is a refined girl part of the curriculum S in Florence (S for Special); she is very clever but has trouble understanding how to maintain and form relationships. She is the daughter of Kisaragi Kazuhiko. Her family is old and very rich, not to mention Mifuyu knows how to handle a sword. She cares about Yumina quite a lot."},{"spoiler":true,"text":"She becomes Nue's mother figure after they overcome their differences."},{"spoiler":true,"text":"Edited from Accany's review"}],"source":"vndb","sourceCharacterId":"c1564"},{"segments":[{"spoiler":false,"text":"創聖学院女子学部（フローレス）カリキュラムＳ受講生（最上級生）。"},{"spoiler":false,"text":"名家“如月家”出身の才女で、常に冷静で思慮深い人格者。"},{"spoiler":false,"text":"周囲の信頼も厚く、選ばれるべくして選ばれた「ミレディ（女子学部総代）」。"},{"spoiler":false,"text":"後輩であるゆみなのことを、何かと気にかけている様子。"},{"spoiler":false,"text":"「あの夜、学校の側に住んでいた生徒が、バイクの音を聞いたとかでな……」"}],"source":"egs","sourceCharacterId":"8242","sourceWorkId":"10100","spoiler":false},{"segments":[{"spoiler":false,"text":"由緒正しき名家、政財界に大きな影響力を持つ如月家の中心的存在。"},{"spoiler":false,"text":"泉戸ましろの『人と太転依の共存』に理解を示し、さの実現に向け政治的な面から押し進める親太転依派の代表的な人物である。"},{"spoiler":false,"text":"泉戸裕理、ましろ夫妻とは学生時代に知り合い、最も早い時期から太転依との交流を持ってきた。"},{"spoiler":false,"text":"生真面目な性格から誤解を招かれることも多いが、常に周りの皆のために最善を考える優しい心の持ち主である。"}],"source":"egs","sourceCharacterId":"8242","sourceWorkId":"21942","spoiler":false},{"segments":[{"spoiler":false,"text":"创圣学院女子学部S课程学生（最上级生）兼贵妇（总代理）。“贵妇”是女子学部中特别优秀的监督生的领导生，需要得到全校学生和教师八成以上的支持才能被选出。美冬生于名家如月家，幼时开始已接受严谨的教育。擅长各种武艺，特别是剑术。冷静沉稳而深思熟虑，虽然性格严肃但实际心中想逃离这种束缚。兴趣是读书，特别是以“自由恋爱”为题材的故事。意识到由美奈对自己的憧憬。另外，据自己各种推理，认为阻止扩充工程的人是裕理，但其实并无关系。"}],"source":"bangumi","sourceCharacterId":"1804"}],"profileFacts":[],"metadataCandidateConflicts":{"waist":[{"comparisonValue":"59","source":"vndb","sourceCharacterId":"c1564","value":"59"},{"comparisonValue":"59","scope":"sourceWork","source":"egs","sourceCharacterId":"8242","sourceWorkId":"10100","value":"59"},{"comparisonValue":"58","source":"bangumi","sourceCharacterId":"1804","value":"58"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47b4fd7cd23b44a3f1be9421d4588ea0034882e3dc323c93d1cdf1dd8c32a145.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8ca868c79d95f96ce781a0dbbd56a5efccf867a928ee5ad513a26cdc98e675d.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤静","creatorId":"vndb:s516","sourcePersonId":"vndb:s516","canonicalEntityId":"vndb:s516","name":"伊藤 静","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18333:1804:4272:1","source":"bangumi"}]},{"characterId":"char_c1565","characterName":"河合 アメリ","sourceIds":{"bangumi":[{"characterId":"1802","match":"source-roster","subjectId":"114064"},{"characterId":"1802","match":"source-roster","subjectId":"131917"},{"characterId":"1802","match":"source-roster","subjectId":"18333"},{"characterId":"1802","match":"source-roster","subjectId":"198439"},{"characterId":"1802","match":"exact-normalized-name-in-linked-work","subjectId":"3177"},{"characterId":"1802","match":"source-roster","subjectId":"3177"}],"egsCharacterIds":["8240"],"vndbCharacterId":"c1565"},"originalCharacterName":"河合 アメリ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"809"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuri' childhood friend. She’s really active and fun but probably the character with the most mood swings in the story. Obvious that she holds a thing or two for Yuuri. Her family is also pretty rich. Her father is the headmaster of Suraitory and also good friends with Yuuri’s father, Kawai Genzou."},{"spoiler":false,"text":"From Accany's review"}],"source":"vndb","sourceCharacterId":"c1565"},{"segments":[{"spoiler":false,"text":"創聖学院一般学部（スライトリー）カリキュラムＳ受講生（最上級生）。"},{"spoiler":false,"text":"裕理の同級生であり、幼い頃から一緒に遊んでいた幼馴染でもある。"},{"spoiler":false,"text":"他人を巻き込む「ゴーイングマイウェイ」な性格だが、恋愛に関しては臆病な面があり、裕理との仲もあまり進展する気配がない。"},{"spoiler":false,"text":"しかし、積極的な恋のライバル・ましろの登場により……？"},{"spoiler":false,"text":"「全部あたしのおかげでしょ？　死ぬほど感謝しなさいよね？」"}],"source":"egs","sourceCharacterId":"8240","sourceWorkId":"10100","spoiler":false},{"segments":[{"spoiler":false,"text":"大手企業グループ『河合ホールディングズ』の女会長として名を馳せる人物。"},{"spoiler":false,"text":"空たちの通う、私立鷹千帆学院の学院長も務めている。"},{"spoiler":false,"text":"ましろの夫、泉戸裕理とは幼馴染であり、一時は裕理を巡ってましろとぎこちなくなることもあったが、今では良き協力者であり、長年の友人となっている。"},{"spoiler":false,"text":"好物はアメで、ポケットやカバンにはいつも大量のアメを忍ばせている。"}],"source":"egs","sourceCharacterId":"8240","sourceWorkId":"21942","spoiler":false},{"segments":[{"spoiler":false,"text":"裕理的青梅竹马兼同学，和裕理如家人般的亲近。创圣学院一般学部S课程学生（最上级生），父亲是一般学部的理事，母亲是大企业建筑公司的会长。做事有自己的一套，但不会有特别的计划。对裕理有一些好感，然而自己对恋爱不擅长，一直都只是朋友，视真白为对手。另外，虽然名字像是西方人但实际无关。"}],"source":"bangumi","sourceCharacterId":"1802"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b83639d0489cfa78bd0de2280594c45542202cb3b80debfa2314ad457a0ac79.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d33113ade8803f77718f0e18cd4695d0c42d5a1183adbf3628332eaccd49a475.webp","width":136,"height":256,"source":"static-detail"},"actors":[{"creditedName":"下田麻美","creatorId":"vndb:s1597","sourcePersonId":"vndb:s1597","canonicalEntityId":"vndb:s1597","name":"下田 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18333:1802:4990:1","source":"bangumi"}]},{"characterId":"char_c25791","characterName":"劉備 玄徳","sourceIds":{"bangumi":[{"characterId":"1625","match":"source-roster","subjectId":"129020"},{"characterId":"1625","match":"source-roster","subjectId":"135172"},{"characterId":"1625","match":"source-roster","subjectId":"144422"},{"characterId":"1625","match":"exact-normalized-name-in-linked-work","subjectId":"14463"},{"characterId":"1625","match":"source-roster","subjectId":"14463"},{"characterId":"1625","match":"source-roster","subjectId":"162447"},{"characterId":"1625","match":"source-roster","subjectId":"18333"},{"characterId":"1625","match":"source-roster","subjectId":"214099"},{"characterId":"1625","match":"source-roster","subjectId":"216765"},{"characterId":"1625","match":"source-roster","subjectId":"216766"},{"characterId":"1625","match":"exact-normalized-name-in-linked-work","subjectId":"2409"},{"characterId":"1625","match":"source-roster","subjectId":"2409"},{"characterId":"1625","match":"source-roster","subjectId":"364764"},{"characterId":"1625","match":"source-roster","subjectId":"375912"},{"characterId":"1625","match":"source-roster","subjectId":"409322"},{"characterId":"1625","match":"source-roster","subjectId":"430332"},{"characterId":"1625","match":"source-roster","subjectId":"450504"},{"characterId":"1625","match":"source-roster","subjectId":"520555"}],"egsCharacterIds":["12026"],"vndbCharacterId":"c25791"},"originalCharacterName":"劉備 玄徳","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the main female protagonists and main heroines in the Koihime†Musou series and first introduced in Shin Koihime†Musou, she is the young queen of Shoku Kingdom. Being quite young she is naive, often reluctant to go to war, and hates paperwork (much to the chagrin of Kan'u who as a result often scolds the young queen and reminds her of her duties), but has a lot of confidence on her subordinates. She falls in love with Kazuto, causing Kan'u to feel a bit of jealousy."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c25791"},{"segments":[{"spoiler":false,"text":"関羽と張飛を引き連れて、動乱に怯える庶人たちの暮らしを守ろうと各地を旅していた。"},{"spoiler":false,"text":"限りない優しさと懐の大きさを持つが、極彩色の天然ボケタイプ。"}],"source":"egs","sourceCharacterId":"12026","sourceWorkId":"11334","spoiler":false},{"segments":[{"spoiler":false,"text":"蜀の君主にして、『真・恋姫†無双』 のメイン級ヒロインの一人。"},{"spoiler":false,"text":"天然ボケッとした雰囲気だが、案外強かな一面を持つ。"},{"spoiler":false,"text":"今作では蜀本国の運営は若手に任せ、他の仲間たちと共に、都の運営に四苦八苦している一刀の補佐をしている。"},{"spoiler":false,"text":"ただいま華琳の下で料理の修業中。"}],"source":"egs","sourceCharacterId":"12026","sourceWorkId":"13835","spoiler":false},{"segments":[{"spoiler":false,"text":"字玄德（げんとく）。"},{"spoiler":false,"text":"蜀路线中一刀的主要同伴。"},{"spoiler":false,"text":"带领着关羽与张飞，为了守护惧怕战争的庶人们的生活，旅行于各地。正当其时，眼前忽现白光，回过神时就看到了眼前失去意识的一刀的身影。"},{"spoiler":false,"text":"相信突然出现的一刀就是上天的使者，奉一刀为主人，登上了乱世的舞台。"},{"spoiler":false,"text":"拥有无限的温柔与宽大的胸怀，色彩缤纷的天然呆类型。"},{"spoiler":false,"text":"作为关羽与张飞的义姐，爱摆大姐的架子，提醒注意她们的不检点，施展吐槽绝技。可惜无一例外吐错了槽令人对其无可奈何或是受到无情的反击，结果到头来自挖墓穴在墙角画圈。"}],"source":"bangumi","sourceCharacterId":"1625"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"1625","value":"北乡军(蜀军)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5aff8e8e467527bdab29092b14edb582e1e2d68a0d6f93ab70158260e33f122a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd0bfdb7d94ad4b2c9f42a4a6817fcc9b2ac4540aef5e1eda17a47b6fc66abe0.webp","width":153,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18333:1625:4809:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:2504","sourceCompanyId":"egs:brand:2504","canonicalEntityId":"egs:brand:2504","name":"マイルストーン","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:22957:2504","source":"egs"}],"missingStates":["current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
