{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"13760","model":{"presentationWorkId":"vndb:v3886","staff":{"artwork":[{"creditedName":"鋼丸(鋼丸R、鋼丸S、鋼丸SS)","creatorId":"vndb:s6952","sourcePersonId":"egs:creator:444","canonicalEntityId":"vndb:s6952","name":"鋼丸(鋼丸R、鋼丸S、鋼丸SS)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:85697","source":"egs"}],"scenario":[{"creditedName":"渡部雅弘(鉄砲犬、渡部マサヒロ、渡部金魚)","creatorId":"vndb:s11711","sourcePersonId":"egs:creator:453","canonicalEntityId":"vndb:s11711","name":"渡部雅弘(鉄砲犬、渡部マサヒロ、渡部金魚)","detail":"パートシナリオ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:175888","source":"egs"},{"creditedName":"JUN","creatorId":"egs:creator:240","sourcePersonId":"egs:creator:240","canonicalEntityId":"egs:creator:240","name":"JUN","roleCode":"scenario","roleLabel":"剧本","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:85698","source":"egs"},{"creditedName":"七瀬流","creatorId":"vndb:s7377","sourcePersonId":"egs:creator:5542","canonicalEntityId":"vndb:s7377","name":"七瀬流","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:85699","source":"egs"},{"creditedName":"松本わん子","creatorId":"vndb:s47788","sourcePersonId":"egs:creator:14657","canonicalEntityId":"vndb:s47788","name":"松本わん子","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:85700","source":"egs"},{"creditedName":"JUN","creatorId":"vndb:s1628","sourcePersonId":"vndb:s1628","canonicalEntityId":"vndb:s1628","name":"JUN","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:45765","source":"vndb"}],"music":[{"creditedName":"奏森 愛","creatorId":"vndb:s3801","sourcePersonId":"vndb:s3801","canonicalEntityId":"vndb:s3801","name":"盛合 千鶴子","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:45769","source":"vndb"}],"other":[]},"cast":[{"characterId":"char_c20888","characterName":"杉本 陽菜","sourceIds":{"bangumi":[{"characterId":"90526","match":"exact-normalized-name-in-linked-work","subjectId":"220718"}],"egsCharacterIds":["12260"],"vndbCharacterId":"c20888"},"originalCharacterName":"杉本 陽菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が教鞭を執る学園の女子生徒。一年生。"},{"spoiler":false,"text":"微笑むとうっすらとえくぼが浮かぶ、清楚で可愛らしい女の子。"},{"spoiler":false,"text":"根は明るいが、人見知りするタイプ。"},{"spoiler":false,"text":"最近、母親が再婚したが、義理の父親と馴染めず、自宅に自分の居場所がない。そのため、自宅に戻らず、たまたま外をぶらぶらしていたところを教師に見つかり、保護された。クラスに友達は居るが、まだ泊まらせて貰えるような深い関係の友人は居ない。"},{"spoiler":false,"text":"男子から交際を申し込まれたことはあるが、それで付き合ったことはない。"},{"spoiler":false,"text":"そのため、オナニー経験はあるが、男性経験はなく、処女。"}],"source":"egs","sourceCharacterId":"12260","sourceWorkId":"13760","spoiler":false},{"segments":[{"spoiler":false,"text":"学園1年生。成績は中の上。"},{"spoiler":false,"text":"クラス内での友達との交流はあるが、同じ学区からやってきた人がいないので、泊まり合うような仲にはまだなっていない。"},{"spoiler":false,"text":"根は明るいが、人見知りするタイプ。 清楚で可愛らしい顔立ちが特徴。微笑むとうっすらと片えくぼが出る。"},{"spoiler":false,"text":"告白してくる男子もいるが、今は付き合う気が無い。"},{"spoiler":false,"text":"最近、母親が再婚し義理の父の家に住んでいるが、馴染めていない。"},{"spoiler":false,"text":"初潮は小学6年生。中学生の頃オナニーを覚える。もっぱら布団の中でうつぶせでクリトリスいじり。おっぱい大きめで、乳首をいじられると弱い。アンダーヘアは薄目。"},{"spoiler":false,"text":"主人公のことは教科担任の先生だ……くらいの認識。クラス内女子の間ではキモイという意見が多いが、別に好きでも嫌いでもない。"},{"spoiler":false,"text":"以前通学中に偶然、犬に吠えられてビクッとしている主人公を見かけた事があり、その時はちょっとかわいいと思ってしまった。"}],"source":"bangumi","sourceCharacterId":"90526"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e83b6b0cf9fc86c9c6e948febb9e783da1d62e926c7fd6dba3e3c6a6f37f15d8.webp","fallbackUrl"