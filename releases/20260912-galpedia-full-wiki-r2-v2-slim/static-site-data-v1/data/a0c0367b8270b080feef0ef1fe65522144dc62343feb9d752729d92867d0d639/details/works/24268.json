{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"24268","model":{"presentationWorkId":"egs:24268","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c34050","characterName":"皇城 一花","sourceIds":{"bangumi":[{"characterId":"33671","match":"exact-normalized-name-in-linked-work","subjectId":"134488"},{"characterId":"33671","match":"source-roster","subjectId":"134488"},{"characterId":"33671","match":"source-roster","subjectId":"172774"},{"characterId":"33671","match":"source-roster","subjectId":"197438"}],"egsCharacterIds":["7165"],"vndbCharacterId":"c34050"},"originalCharacterName":"皇城 一花","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ren and Rin's younger stepsister. Their mother's (Ren's father's second marriage partner)'s child from another spouse. The kids met when they were in elementary school after their parents remarried."},{"spoiler":false,"text":"A reliable person who handles all of the household chores. She is also an excellent honors student. She is shy, and has a hard time talking to the opposite gender. When she's just with Ren she likes to call him \"Onii-chan\" and fawn on him."}],"source":"vndb","sourceCharacterId":"c34050"},{"segments":[{"spoiler":false,"text":"蓮と凛の義理の妹。母親（蓮の父親の再婚相手）の連れ子。"},{"spoiler":false,"text":"小学生の頃に、互いの両親が再婚し知り合う。"},{"spoiler":false,"text":"家では家事全般をこなすしっかり者。"},{"spoiler":false,"text":"学校では成績優秀な優等生。"},{"spoiler":false,"text":"内気な性格で、異性と話すのは少々苦手。"},{"spoiler":false,"text":"蓮と二人っきりの時は「お兄ちゃん」と呼んで、甘えてくることも。"}],"source":"egs","sourceCharacterId":"7165","sourceWorkId":"22063","spoiler":false},{"segments":[{"spoiler":false,"text":"蓮と凛の義理の妹。 母親（蓮たちの父の再婚相手）の連れ子。"},{"spoiler":false,"text":"小学生の頃に互いの両親が再婚して知り合った。"},{"spoiler":false,"text":"家では家事全般をこなすしっかり者。 学園では成績優秀な優等生。"},{"spoiler":false,"text":"内気な性格なので、異性と話すのは少し苦手。"},{"spoiler":false,"text":"蓮とふたりっきりの時は 「お兄ちゃん」 と呼んで、甘えてくることも。"},{"spoiler":false,"text":"「兄さんはわたし一筋ですもんね？」"}],"source":"bangumi","sourceCharacterId":"33671"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e25fcd81f7314c13b3d565e19544e89a38eb3696882205e23a9577d734a76e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cad1a5185bff3d741b8e31a0fb57902dab28cd307a6ffc17343610c6c987317.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松山紗香","creatorId":"vndb:s904","sourcePersonId":"vndb:s904","canonicalEntityId":"vndb:s904","name":"松山 紗香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197438:33671:10662:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:2612","sourceCompanyId":"egs:brand:2612","canonicalEntityId":"egs:brand:2612","name":"ensemble","roleCodes":["brand"],"identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-brand:24268:2612","source":"egs"}],"missingStates":["current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
