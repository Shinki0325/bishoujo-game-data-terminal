alse,"text":"「東の大陸が大変興味深いので要調査」という中央からの指令を受け、その思惑を図りかねるなか、ステラードにやってきた。"},{"spoiler":false,"text":"いつも目が離せない、よく知る彼女のいる街へーー"}],"source":"bangumi","sourceCharacterId":"23961"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"23961","value":"中央的炼金术士(A15)"},{"label":"职业","source":"bangumi","sourceCharacterId":"23961","value":"柯尔先特的职员(A16)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09e48d67055dd39f55d424f815e75b463a9d27133891ef980a3fbfd7f7612405.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/5847c2dde724cdb4d394039251b423137591b2e1d130508261471e8594a0ec78.webp","width":173,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石川界人","creatorId":"vndb:s4435","sourcePersonId":"vndb:s4435","canonicalEntityId":"vndb:s4435","name":"石川 界人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:158006:23961:9953:1","source":"bangumi"}]},{"characterId":"char_bangumi_23962","characterName":"Wilbell Voll-Ersleid","sourceIds":{"bangumi":[{"characterId":"23962","match":"source-roster","subjectId":"158006"},{"characterId":"23962","match":"source-roster","subjectId":"37563"},{"characterId":"23962","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"Wilbell Voll-Ersleid","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A14　　14歳"},{"spoiler":false,"text":"未来の大魔法使いを目指す女の子"},{"spoiler":false,"text":"魔法使いの一族に生まれた女の子。大婆様のような偉大な魔法使いを目指すため魔法の修行を続けている。元気で活発な性格だが色々な知識があるせいか多少尊大になることも。"},{"spoiler":false,"text":"ちゃっかりしておりアーシャに修行の手伝いをさせたりもするがその豊富な知識と魔法でアーシャに助言をすることもある。"},{"spoiler":false,"text":"A15　　18歳"},{"spoiler":false,"text":"修行中の大魔法使い見習い"},{"spoiler":false,"text":"辺境から辺境へと渡り歩き、武者修行を続けている魔法使いの少女。"},{"spoiler":false,"text":"以前に友人たちの協力を経て風の精霊と契約を結んでからは、世界の様々な精霊に逢うことを修行の目的として放浪している。"},{"spoiler":false,"text":"魔法使いとしての素養は非常に高く、その若さに見合わない高い能力を持っている。"},{"spoiler":false,"text":"A16　　24歳"},{"spoiler":false,"text":"大きな試練に直面する、偉大なる魔法使い"},{"spoiler":false,"text":"各地の精霊と契約する修業中の魔法使い。"},{"spoiler":false,"text":"これまで契約した精霊の力を借りて、強力な魔法を行使できる。"},{"spoiler":false,"text":"偶然助けたシャルロッテに錬金術士と間違われ、憧れの対象となったことからシャルロッテのよき師匠になる。"},{"spoiler":false,"text":"年齢に見合わない幼い外見をしており、「大人になる」手がかりを求めている。"},{"spoiler":false,"text":"面倒くさがりでちゃっかりしているところは相変わらずだが、自分の子供っぽさにコンプレックスを抱いている。"},{"spoiler":false,"text":"そのため、無理に大人振ろうとして厄介ごとを招くこともしばしば。"}],"source":"bangumi","sourceCharacterId":"23962"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"23962","value":"旅行的魔法师(A16)"},{"label":"职业","source":"bangumi","sourceCharacterId":"23962","value":"魔法师(A14/A15)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90a9d58ba27701320c1028ea8bea6278a13fb61066dbddadd720774b9e299546.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f5e7655a562de786adc5fbabaef3708acecee7e6ad7a7392b7663bfa507e399.webp","width":210,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瀬戸麻沙美","creatorId":"vndb:s1433","sourcePersonId":"vndb:s1433","canonicalEntityId":"vndb:s1433","name":"瀬戸 麻沙美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:158006:23962:5766:1","source":"bangumi"}]},{"characterId":"char_bangumi_23967","characterName":"Katla Larchica","sourceIds":{"bangumi":[{"characterId":"23967","match":"source-roster","subjectId":"158006"},{"characterId":"23967","match":"source-roster","subjectId":"69146"}]},"originalCharacterName":"Katla Larchica","characterNameSource":null,"role":"配角","status":"source-only-ca