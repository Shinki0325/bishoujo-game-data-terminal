{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"14701","model":{"presentationWorkId":"egs:14701","staff":{"artwork":[],"scenario":[],"music":[],"other":[{"creditedName":"鈴平ひろ(一条ジョニー)","creatorId":"vndb:s1348","sourcePersonId":"egs:creator:648","canonicalEntityId":"vndb:s1348","name":"鈴平ひろ(一条ジョニー)","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"auto-confirmed","relationId":"egs:work-creator:91482","source":"egs"}]},"cast":[{"characterId":"char_bangumi_12393","characterName":"Chris Makise","sourceIds":{"bangumi":[{"characterId":"12393","match":"source-roster","subjectId":"129820"},{"characterId":"12393","match":"source-roster","subjectId":"129822"},{"characterId":"12393","match":"source-roster","subjectId":"18708"},{"characterId":"12393","match":"source-roster","subjectId":"19060"},{"characterId":"12393","match":"source-roster","subjectId":"20544"},{"characterId":"12393","match":"source-roster","subjectId":"20825"},{"characterId":"12393","match":"source-roster","subjectId":"216031"},{"characterId":"12393","match":"source-roster","subjectId":"216107"},{"characterId":"12393","match":"source-roster","subjectId":"3154"},{"characterId":"12393","match":"source-roster","subjectId":"63973"}]},"originalCharacterName":"Chris Makise","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"bust":{"reviewState":"source-only","source":"bangumi","value":"79"},"height":{"reviewState":"source-only","source":"bangumi","value":"160"},"hip":{"reviewState":"source-only","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"56"},"weight":{"reviewState":"source-only","source":"bangumi","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"维克多·孔多利亚（原型为哥伦比亚大学）大学脑科学研究所的研究员，18 岁即从大学毕业(因为美国的跳级制度，所以实际年龄跟高三学生相当)，在美国著名的学术杂志上刊登论文而受到瞩目。"},{"spoiler":false,"text":"或许是因为饱尝周围人们充满羡慕与嫉妒的目光，面对他人时从来不会露出半点破绽。"},{"spoiler":false,"text":"然而作为研究者，其本质还是个难以掩藏旺盛的好奇心、对感兴趣的事物一头扎进去的女孩。"},{"spoiler":false,"text":"其言行让人感觉比起一般世间的常识更加注重研究的成果，而因此也被冈部评为“相当程度的科学狂人“，然而本人却并不这么认为。"},{"spoiler":false,"text":"外表是个美人，纤细的双腿充满魅力。"},{"spoiler":false,"text":"平时穿着按照自己的风格所改造的高中制服，虽然严格来说已经不是高中生了，不过常用“因为可爱”这样的理由进行辩解。"},{"spoiler":false,"text":"是个典型的傲娇，而且是一旦关系变好后就用情很深的类型。"},{"spoiler":false,"text":"平时经常引用动画『10之使魔』女主角“露易丝”的台词，但这似乎只是受到大型论坛2ch的影响而在不知出处的情况下使用。"},{"spoiler":false,"text":"想做一名匿名的 2cher，不过却反而暴露出来。"},{"spoiler":false,"text":"因为天才的个性使然，所以对冈伦的厨二病发言毫不留情。"}],"source":"bangumi","sourceCharacterId":"12393"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"12393","value":"做实验，上@Channel"},{"label":"喜欢的东西","source":"bangumi","sourceCharacterId":"12393","value":"SF 小说，拉面(包括杯面)，白大褂"},{"label":"讨厌的东西","source":"bangumi","sourceCharacterId":"12393","value":"笨蛋，牛排肉，蟑螂，环保运动"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65e7e65039f7e912cf5fc67ac1209e3a3bdaece99e04a120443a55ce60293cde.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86e3625f4eda523afe7eed7f84701c0600806e174a7b556c61234ad6a57efabd.webp","width":91,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c4656","characterName":"咲畑 梨深","sourceIds":{"bangumi":[{"characterId":"4833","match":"source-roster","subjectId":"13166"},{"characterId":"4833","match":"exact-normalized-name-in-linked-work","subjectId":"1410"},{"characterId":"4833","match":"source-roster","subjectId":"1410"},{"characterId":"4833","match":"source-roster","subjectId":"18708"},{"characterId":"4833","match":"source-roster","subjectId":"3243"},{"characterId":"4833","match":"source-roster","subjectId":"637651"}],"egsCharacterIds":["16994"],"vndb