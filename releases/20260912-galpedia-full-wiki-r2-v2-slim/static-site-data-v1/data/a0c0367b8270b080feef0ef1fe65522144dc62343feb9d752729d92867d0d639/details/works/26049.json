orId":"vndb:s41235","sourcePersonId":"vndb:s41235","canonicalEntityId":"vndb:s41235","name":"藤井 健人","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:145291","source":"vndb"},{"creditedName":"杉本 善徳","creatorId":"vndb:s41761","sourcePersonId":"vndb:s41761","canonicalEntityId":"vndb:s41761","name":"杉本 善徳","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:145293","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c69031","characterName":"楠瀬 舞美","sourceIds":{"vndbCharacterId":"c69031"},"originalCharacterName":"楠瀬 舞美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"831"},"height":{"reviewState":"source-only","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She lives in the mansion and attends Mihate High School. Maimi is strong-willed and doesn't like to give up. She gets high grades and is good at sports, being the top athlete in the tennis club after joining it two years ago. She is sloppy and tomboyish despite her looks. Kensuke calls her an \"unfortunate woman\" and \"cute if she shuts up.\" She has a very low tolerance for alcohol, and gets drunk off the smallest amount from a piece of fancy chocolate candy. Because her birthday is August 31st (the last day of summer break), she has never had any friends celebrate her birthday, and she has always resented this fact."}],"source":"vndb","sourceCharacterId":"c69031"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98f7a2d80811320c8e60792de2673e037ecbd8120641b4523a28925a2a79ef00.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0f6b11dfd6c959838fa0a765aef4a0f6d4224f502259540eb9b1683af5199d0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"東城 日沙子","creatorId":"vndb:s10072","sourcePersonId":"vndb:s10072","canonicalEntityId":"vndb:s10072","name":"東城日沙子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76320","source":"vndb"}]},{"characterId":"char_vndb_c69032","characterName":"音無 雪乃","sourceIds":{"vndbCharacterId":"c69032"},"originalCharacterName":"音無 雪乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"height":{"reviewState":"source-only","source":"vndb","value":"167"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She works for a publishing company, and is visiting Mihate Town for research. She has a bright attitude and is always optimistic. She recently made her authorial debut after her first article was published in a magazine. She s curious about the mysteries occurring in Mihate Town, and has been running around town looking for clues. She is also an honorary member of the Mystery Club."}],"source":"vndb","sourceCharacterId":"c69032"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce2c9bad777bfb347f4326b3ccfed4cb55104cfc1e756cb5f4b50da8239dd7bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51ddcf596db4924d19f6ce8352d3340f406907d3cc973acb8cc72e39ad7307bf.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤 静","creatorId":"vndb:s516","sourcePersonId":"vndb:s516","canonicalEntityId":"vndb:s516","name":"伊藤 静","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76310","source":"vndb"}]},{"characterId":"char_vndb_c69033","characterName":"神代 沙也","sourceIds":{"vndbCharacterId":"c69033"},"originalCharacterName":"神代 沙也","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"height":{"reviewState":"source-only","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the only daughter of the owner of the world-renowned snack food manufacturer, Kamishiro-dou. Her grades are always at the top of her class. She's a decent athlete, and even competed in national tennis tournaments during her junior high school days. She is strong-willed and quite prideful, but respects Maimi and Miu's seniority. She speaks her mind and so is constantly arguing with the equally strong-willed Kensuke. She always travels by car with her driver, the elusive Hattori, always at her side."}],"source":"vndb","sourceCharacterId":"c69033"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9cb07dcedea18c7e45d2836bd1aab9b203f86e17327f433203911063a759523b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/373fed29cfd757dc40443e49c99925751152c62d93ab9f9757a4450f9a6dfdcf.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中恵 光城","creatorId":"vndb:s2786","sourcePersonId":"vndb:s2786","canonicalEntityId":"vndb:s2786","name":"中恵 光城","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76311","source":"vndb"}]},{"characterId":"char_vndb_c69034","characterName":"甘奈 未海","sourceIds":{"vndbCharacterId":"c69034"},"originalCharacterName":"甘奈 未海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"height":{"reviewState":"source-only","source":"vndb","value":"159"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is one of the main character's classmates. She has a part-time job at her brother's cafe. She does not express emotions outwardly, which makes her classmates find her unapproachable. She is always at the top of her class in terms of grades. She is the student body president as well as the manager of the Mystery Club. Conversely, she isn't good at sports and has bad rhythm, and can't even perform a simple festival dance. She lost her beloved grandmother last year."}],"source":"vndb","sourceCharacterId":"c69034"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e6cd6a2a288a4c395b91a35a3d15a2728c6138dba0b386dc76a566f5b7e6027.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/557f022ff77d35ef5e72eded21d6540b45813e3a36fb8cd2a56694d6dffbbe83.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井澤 詩織","creatorId":"vndb:s7962","sourcePersonId":"vndb:s7962","canonicalEntityId":"vndb:s7962","name":"井澤 詩織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76315","source":"vndb"}]},{"characterId":"char_vndb_c69035","characterName":"山田 花子","sourceIds":{"vndbCharacterId":"c69035"},"originalCharacterName":"山田 花子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A nerdy girl with thick glasses, she claims to live in a neighboring town. She's always wandering around town wearing a tracksuit. She is a tad ditzy, and tends to stutter when she speaks. When she gets nervous or excited, she has a strange way of speaking. She loves ice cream, but can't eat it as much as she'd like it, for some reason. She never takes off her glasses."}],"source":"vndb","sourceCharacterId":"c69035"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f87fcb8b190311378442c68667516775474d6cff2975735ea509c8f993895f20.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e00fc093fc2d79c113efed7b3d12265d8753059e7bd7db5fc68986ee1375093.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木戸 衣吹","creatorId":"vndb:s9797","sourcePersonId":"vndb:s9797","canonicalEntityId":"vndb:s9797","name":"木戸衣吹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76318","source":"vndb"}]},{"characterId":"char_vndb_c69036","characterName":"二階堂 玲衣","sourceIds":{"vndbCharacterId":"c69036"},"originalCharacterName":"二階堂 玲衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the lead singer in the nationally acclaimed idol group, Zettai Zetsumei Panda, and her nickname is Nikarei. After having expanded her career into acting, her stardom has skyrocketed, with a recent casting in the lead role of a movie. She is visiting Mihate Town for the summer while a movie is being filmed there."}],"source":"vndb","sourceCharacterId":"c69036"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/3926718d95a1cb4786bca760e4c410b3647da7e93a90434ab4557c9dae6a87c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/5268a6781e5b6a3897dc75b69292a60797e215ffc3b8d33b5bd902f4027065e2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木戸 衣吹","creatorId":"vndb:s9797","sourcePersonId":"vndb:s9797","canonicalEntityId":"vndb:s9797","name":"木戸衣吹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76319","source":"vndb"}]},{"characterId":"char_vndb_c69038","characterName":"山城 香織","sourceIds":{"vndbCharacterId":"c69038"},"originalCharacterName":"山城 香織","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She teaches social studies at Mihate High School, and her beauty attracts the gaze of all the male members of the student body. Kensuke calls her a succubus, given her blatant displays of adult charm. She established the Mystery Club, officially known as the Tribal Studies Research Club, to uncover the mysteries of the world. With membership applications pouring in, she hand-picked a limited number of students as a trial run. Her young adult romance novel, \"Worldend\", is based on Mihate Town's Yomibito legend, and it became a nationwide best-seller. The book is now being adapted into a motion picture."}],"source":"vndb","sourceCharacterId":"c69038"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https: