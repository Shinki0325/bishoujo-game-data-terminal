抹茶亭 小枝","creatorId":"vndb:s28512","sourcePersonId":"vndb:s28512","canonicalEntityId":"vndb:s28512","name":"抹茶亭 小枝","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:38976","source":"vndb"},{"creditedName":"MeeK","creatorId":"vndb:s35139","sourcePersonId":"vndb:s35139","canonicalEntityId":"vndb:s35139","name":"MeeK","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:38977","source":"vndb"},{"creditedName":"加藤 義治","creatorId":"vndb:s5412","sourcePersonId":"vndb:s5412","canonicalEntityId":"vndb:s5412","name":"加藤 義治","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:38978","source":"vndb"},{"creditedName":"モリト ミキト","creatorId":"vndb:s39323","sourcePersonId":"vndb:s39323","canonicalEntityId":"vndb:s39323","name":"モリト ミキト","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:38981","source":"vndb"},{"creditedName":"岸誠二","creatorId":"vndb:s42739","sourcePersonId":"vndb:s42739","canonicalEntityId":"vndb:s42739","name":"岸誠二","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:38982","source":"vndb"}]},"cast":[{"characterId":"char_c18303","characterName":"クロエ・リンドグレーン","sourceIds":{"bangumi":[{"characterId":"11796","match":"exact-normalized-name-in-linked-work","subjectId":"12479"}],"egsCharacterIds":["16246"],"vndbCharacterId":"c18303"},"originalCharacterName":"クロエ・リンドグレーン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【凛々しい騎士候補生】"},{"spoiler":false,"text":"マリーの親友でルリタニア王立学院の騎士科に所属する女の子。"},{"spoiler":false,"text":"家は傭兵上がりの新興貴族で、そのため剣の腕前は学内でもトップクラス。"},{"spoiler":false,"text":"中性的な面立ちも相まって下級生女子からは絶大な人気を誇る。"},{"spoiler":false,"text":"何者をも寄せ付けない孤高な雰囲気とは裏腹に、可愛い女の子が大好きで、珠姫や自分を崇拝する女の子たちを心の中で愛でている変態さん。"},{"spoiler":false,"text":"「手を出すわけないだろう？　触れることができないからこそ美しいんじゃないか」"}],"source":"egs","sourceCharacterId":"16246","sourceWorkId":"11589","spoiler":false},{"segments":[{"spoiler":false,"text":"マリー的好友，所属于ルリタニア王立学院骑士科的女孩子。"},{"spoiler":false,"text":"家里是佣兵出身的新兴贵族，也因此剑技能力是校内最高级别的。"},{"spoiler":false,"text":"加上那中性的打扮在下级女生里有着自豪的绝大人气。"},{"spoiler":false,"text":"内心与她散发着谁也不好接近的孤高气氛相反，最喜欢可爱的女孩子，是将珠姫和崇拜自己的女孩子们在心里宠爱着的变态小姐。"}],"source":"bangumi","sourceCharacterId":"11796"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f15cfa8582d60e222b3e091937e4b40e05849466a86b0aa57b4adc57580dd31b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22a1d9d2cf97b2369ed1f8988f7a10c154fb50d2327d128df4b0b6c11afa5512.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12479:11796:4937:1","source":"bangumi"}]},{"characterId":"char_c18305","characterName":"マキナ","sourceIds":{"bangumi":[{"characterId":"11800","match":"exact-normalized-name-in-linked-work","subjectId":"12479"}],"egsCharacterIds":["16248"],"vndbCharacterId":"c18305"},"originalCharacterName":"マキナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"珠姫付きの侍女。"},{"spoiler":false,"text":"凰国語では「蒔奈」と書く。"},{"spoiler":false,"text":"元は珠姫の母に仕えていたこともあり、まだ幼い姫殿下に職務以上の思い入れを抱いている。"},{"spoiler":false,"text":"常に笑顔を絶やさない大人の女性だが、そのにこやかな表情のまま主人公に対して無理難題を押し付けてくる困った人。"},{"spoiler":false,"text":"メイドの格好をしているが、ルリタニア王家や教会との交渉もこなす。"},{"spoiler":false,"text":"官吏としての一面も持つ。"}],"source":"egs","sourceCharacterId":"16248","sourceWorkId":"11589","spoiler":false},{"segments":[{"spoiler":false,"text":"珠姫的随身侍女。凰国语是写作「蒔奈」。"},{"spoiler":false,"text":"原本是曾侍奉珠姫的母亲，对还年幼的公主殿下有着职务以上的感情。"},{"spoiler":false,"text":"总是笑容不绝的成熟女性，但是她却老是用着那微笑的表情塞给主人公一些过分的难题，是个让人烦恼的人。"},{"spoiler":false,"text":"虽然身穿着女仆服装，但同时也处理着和ルリタニア王家以及教会的交涉。也有着作为官吏的身份。"}],"source":"bangumi","sourceCharacterId":"11800"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c0cb6a8a503f2753c579f228c80da0dc102bb40bd25eb745b58cafd448a5e3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/2256a461514457570d0771e3ef2139e3fca76be71aa1b9e407c2aabf0487a633.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12479:11800:4727:1","source":"bangumi"}]},{"characterId":"char_c18306","characterName":"ジノ・グランシルト・ルリタニア","sourceIds":{"bangumi":[{"characterId":"11799","match":"exact-normalized-name-in-linked-work","subjectId":"12479"}],"egsCharacterIds":["16247"],"vndbCharacterId":"c18306"},"originalCharacterName":"ジノ・グランシルト・ルリタニア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ジルの兄。自称「ハルの親友」。"},{"spoiler":false,"text":"王位継承権を持つ王子だが、本人にその自覚はほとんどないらしく、いつも気ままに遊びまわっている。"}],"source":"egs","sourceCharacterId":"16247","sourceWorkId":"11589","spoiler":false},{"segments":[{"spoiler":false,"text":"ジル的兄长。自称「主人公的好友」。"},{"spoiler":false,"text":"虽然是拥有王位继承权的王子，但其本人似乎是完全没那种自觉，总是游手好闲的。"}],"source":"bangumi","sourceCharacterId":"11799"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13b18ddc3ced7d78b4aa626526df0ed68010a1abd4ced91190497160d777946b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40841549dab2145b71f91361163575b57a5c7a493425e2c9607b4537c75eafac.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間島淳司","creatorId":"vndb:s756","sourcePersonId":"vndb:s756","canonicalEntityId":"vndb:s756","name":"間島 淳司","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12479:11799:4264:1","source":"bangumi"}]},{"characterId":"char_c18308","characterName":"おかみさん","sourceIds":{"bangumi":[{"characterId":"11801","match":"exact-normalized-name-in-linked-work","subjectId":"12479"}],"egsCharacterIds":["16249"],"vndbCharacterId":"c18308"},"originalCharacterName":"おかみさん","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が住む下宿兼カフェ『猫舌亭』の女主人。"},{"spoiler":false,"text":"気風が良く人好きのする性格だが、年齢の話題だけは禁句。"}],"source":"egs","sourceCharacterId":"16249","sourceWorkId":"11589","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公所租住兼是咖啡店『猫舌亭』的女主人。"},{"spoiler":false,"text":"很有气质，让人喜欢的性格，但唯独年龄的话题是禁句。"},{"spoiler":false,"text":"以有良心的价格和美味的料理，让咖啡店每天满是学院生热闹着。"}],"source":"bangumi","sourceCharacterId":"11801"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7e0a84273d4311d18416a23cd4b4dbd4c6026b423b13f610c6ab5944075e343.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39e0df48ca91dc4bac7edcba90857d279f0df8314c8f7702e7726b9b4a28f63b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12479:11801:5906:1","source":"bangumi"}]},{"characterId":"char_c9267","characterName":"珠姫","sourceIds":{"bangumi":[{"characterId":"11792","match":"exact-normalized-name-in-linked-work","subjectId":"12479"}],"egsCharacterIds":["16242"],"vndbCharacterId":"c9267"},"originalCharacterName":"珠姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【異国から来たちっちゃな姫巫女】"},{"spoiler":false,"text":"東の果ての国・凰国（おうこく）から、その能力を請われルリタニアに招かれた姫巫女様。"},{"spoiler":false,"text":"憧れていた庶民の生活を体験しようと、ルリタニア王立学院に身分を隠して転入してくる。"},{"spoiler":false,"text":"学院では同じ凰国出身の主人公・ハルの妹として振舞うものの、皇族育ちなため社会性が皆無。"},{"spoiler":false,"text":"様々なトラブルを引き起こしては、ハルがフォローに廻る羽目に。"},{"spoiler":false,"text":"「ん……兄さま、ごはんはまだだろうか？」"}],"source":"egs","sourceCharacterId":"16242","sourceWorkId":"11589","spoiler":false},{"segments":[{"spoiler":false,"text":"从东方尽头国家・凰国（おうこく）而来，因其能力接到请求，被招请到ルリタニア的姫巫女殿下。"},{"spoiler":false,"text":"想要体验一直而来憧憬的庶民生活，隐藏身份转学到ルリタニア王立学院。"},{"spoiler":false,"text":"在学院扮作是同样是凰国出身主人公・ハル的妹妹，但因是皇族长大的没有任何社会性知识。"},{"spoiler":false,"text":"引起各种各样的麻烦，都是要由ハル负责收拾残局。"}],"source":"bangumi","sourceCharacterId":"11792"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b122ce996fd0bb6019576b3404741edaf3a2dcf6abc3b321f1f425bbed7f2a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fec8535d6e97ff32b4cade641cb0cc2ccc61ce0e0b3a674663f1a04de6aeb2bb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12479:11792:4956:1","source":"bangumi"}]},{"characterId":"char_c9268","characterName":"ジル・グランシルト・ルリタニア","sourceIds":{"bangumi":[{"characterId":"11793","match":"exact-normalized-name-in-linked-work","subjectId":"12479"}],"egsCharacterIds":["16243"],"vndbCharacterId":"c9268"},"originalCharacterName":"ジル・グランシルト・ルリタニア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【がんばり屋さんなツンデレ王女】"},{"spoiler":false,"text":"物語の舞台となるルリタニア王国の王女様。"},{"spoiler":false,"text":"主人公と同じ学院に通う下級生でもある。"},{"spoiler":false,"text":"プライドが高く、自身が王族であることをとても意識してる。"},{"spoiler":false,"text":"一生懸命王女らしく振舞おうとするのだが、幼い外見のせいか空回りしていることが多い。"},{"spoiler":false,"text":"そんな自分にも優しくしてくれる主人公に、本当は感謝しているが素直になれずにいる。"},{"spoiler":false,"text":"「わ、私はこの国の王女なのっ！　だからもっと敬ってくれないとダメなんだから！！」"}],"source":"egs","sourceCharacterId":"16243","sourceWorkId":"11589","spoiler":false},{"segments":[{"spoiler":false,"text":"故事的舞台ルリタニア王国的王女殿下。"},{"spoiler":false,"text":"与主人公同一学院的下级生。"},{"spoiler":false,"text":"自尊心高，对于自己是皇族一事非常意识着。"},{"spoiler":false,"text":"想要表现出像是个努力的王女，但却因那幼小的外表而多是白费心机。"},{"spoiler":false,"text":"对这样的自己依然温柔体贴的主人公是真的很感谢，但就是不会坦率。"}],"source":"bangumi","sourceCharacterId":"11793"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd8ade24b92d63e517d3bc10fb6a84c13826e0b8bb28f93be134d6f413d90878.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/633eb7a50c51585ae8b00fcd05dcb889e8118a4f4d317c82a20018fad77de352.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12479:11793:4675:1","source":"bangumi"}]},{"characterId":"char_c9270","characterName":"マリー・ロウランド","sourceIds":{"bangumi":[{"characterId":"11794","match":"exact-normalized-name-in-linked-work","subjectId":"12479"}],"egsCharacterIds":["16244"],"vndbCharacterId":"c9270"},"originalCharacterName":"マリー・ロウランド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【成績優秀な貴族の元お嬢様】"},{"spoiler":false,"text":"ルリタニア貴族の娘で学士会のリーダーを務める主人公の同級生。"},{"spoiler":false,"text":"元気で面倒見がよく、身分を問わず誰とでも仲良くなれる女の子。"},{"spoiler":false,"text":"本来はおてんばで茶目っ気のある性格をしているが、大人の前では楚々とした令嬢として振舞うなど、猫っかぶりな優等生でもある。"},{"spoiler":false,"text":"「ハルくん、わたしのお願い……聞いてくれる？」"}],"source":"egs","sourceCharacterId":"16244","sourceWorkId":"11589","spoiler":false},{"segments":[{"spoiler":false,"text":"ルリタニア的女儿，担任着学士会领袖的主人公的同级生。"},{"spoiler":false,"text":"活泼又会照顾人，不论身份对谁都很亲切的女孩子。"},{"spoiler":false,"text":"本来的性格是淘气调皮的，但在大人面前表现得像是楚楚可怜的千金小姐，也就是个装乖乖的优等生。"}],"source":"bangumi","sourceCharacterId":"11794"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/020d389f8c5940726a8bc180232d59a2f90612a1e853cd46189d71347c74a56f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fdf633b89c6215f3b62530748aa018e0f0efb43577f8dc8df7d3fa153ef14c7f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"たかはし智秋","creatorId":"vndb:s287","sourcePersonId":"vndb:s287","canonicalEntityId":"vndb:s287","name":"たかはし 智秋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12479:11794:4604:1","source":"bangumi"}]},{"characterId":"char_c9271","characterName":"レン","sourceIds":{"bangumi":[{"characterId":"11795","match":"exact-normalized-name-in-linked-work","subjectId":"12479"}],"egsCharacterIds":["16245"],"vndbCharacterId":"c9271"},"originalCharacterName":"レン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【天然系な聖堂騎士】"},{"spoiler":false,"text":"珠姫の護衛として教会から派遣されてきた聖堂騎士の女の子。"},{"spoiler":false,"text":"非凡な身体能力を持っているのだが、かなり抜けているところがあるためいまいち有能そうに見えない。"},{"spoiler":false,"text":"そのため周囲の人たちをいつもハラハラさせることに。"},{"spoiler":false,"text":"素直で純真な性格で、世の中はうれしいこと、おいしいこと、たのしいことでいっぱいだと思っている。"},{"spoiler":false,"text":"「すすす、すみません！！　ボク、こういうの慣れてなくって！」"}],"source":"egs","sourceCharacterId":"16245","sourceWorkId":"11589","spoiler":false},{"segments":[{"spoiler":false,"text":"作为珠姫的护卫由教会派遣而来的女圣堂骑士。"},{"spoiler":false,"text":"拥有非凡的身体能力，但却因非常冒失而看上去不怎么有能似的。"},{"spoiler":false,"text":"也因此总是让周围的人为他捏一把汗。"},{"spoiler":false,"text":"性格率直纯真，认为世上充满高兴、美好、愉快的事。"}],"source":"bangumi","sourceCharacterId":"11795"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93a9196f16885c4b1e2bb2caa5f1b77e4639d2c527929afb614f0b8cdeb742c9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fce5138995ee9061463988b07402fd49bc507b3666a22d275a4bebff75f7cf7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水橋かおり","creatorId":"vndb:s131","sourcePersonId":"vndb:s131","canonicalEntityId":"vndb:s131","name":"水橋 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12479:11795:3851:1","source":"bangumi"}]},{"characterId":"char_vndb_c18304","ch