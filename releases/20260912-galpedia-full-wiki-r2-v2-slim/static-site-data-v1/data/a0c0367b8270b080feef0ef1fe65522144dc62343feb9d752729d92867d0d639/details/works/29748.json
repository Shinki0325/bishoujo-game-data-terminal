vndb:s2651","name":"株式会社キューブ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:167302","source":"vndb"},{"creditedName":"白恵 りえ","creatorId":"vndb:s16134","sourcePersonId":"vndb:s16134","canonicalEntityId":"vndb:s16134","name":"白恵 りえ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:167305","source":"vndb"}]},"cast":[{"characterId":"char_c91344","characterName":"小春","sourceIds":{"bangumi":[{"characterId":"77924","match":"exact-normalized-name-in-linked-work","subjectId":"309330"}],"egsCharacterIds":["22814"],"vndbCharacterId":"c91344"},"originalCharacterName":"小春","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Meek and timid, she'd always follow behind her brother."},{"spoiler":false,"text":"Back then, she was picked on by some brats, but her brother would always come running to her aid. He was the reason she could barely hold back her tears."},{"spoiler":false,"text":"When he praised her for not crying, she would regain her spirits."},{"spoiler":false,"text":"When she was picked on, when they separated, when they reunited, when the confession happened, she'd always be prone to crying a lot."},{"spoiler":false,"text":"Thinking about her brother, her heart would throb while her mind would be in a feverish state."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c91344"},{"segments":[{"spoiler":false,"text":"大人しくいつもおどおどしていていつも兄の後ろをついて回る。"},{"spoiler":false,"text":"別に無口って言うわけではないので普通に話たりするし冗談も言うし感情豊かな子。"},{"spoiler":false,"text":"よく近所のがきんちょにいじめられるけど兄が助けに来てくれると信じてギリギリ泣かずに耐える。"},{"spoiler":false,"text":"泣かずに耐えて兄に頑張ったなと言われるのがうれしい。"},{"spoiler":false,"text":"いじめられた時、別れ際、再開、告白時にめっちゃ泣く。"},{"spoiler":false,"text":"お兄ちゃんのことを考えるとドキドキ微熱状態に。"}],"source":"egs","sourceCharacterId":"22814","sourceWorkId":"29748","spoiler":false},{"segments":[{"spoiler":false,"text":"大人しくいつもおどおどしていていつも兄の後ろをついて回る。"},{"spoiler":false,"text":"幼い頃、悪ガキからいじめられる事もあったが、"},{"spoiler":false,"text":"いつも兄が助けに来てくれると信じてギリギリ泣かずに耐える。"},{"spoiler":false,"text":"泣かずに耐えて兄に頑張ったなと言われるのがうれしい。"},{"spoiler":false,"text":"いじめられた時、別れ際、再開、告白時にすごく泣いちゃう。"},{"spoiler":false,"text":"お兄ちゃんのことを考えるとドキドキ微熱状態に。"}],"source":"bangumi","sourceCharacterId":"77924"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41ddeca8a2ba0c9e5818ab33a04c3dfc0982bb7925eac162057f99470a028b34.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4d4654178b1b1305db69351a729015788d1b8e4c9d0389fe81c9fac4919fdf6.webp","width":256,"height":200,"source":"static-detail"},"actors":[{"creditedName":"藤沢れい香","creatorId":"vndb:s14338","sourcePersonId":"vndb:s14338","canonicalEntityId":"vndb:s14338","name":"藤沢 れい香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:309330:77924:32998:1","source":"bangumi"}]},{"characterId":"char_vndb_c92551","characterName":"兄","sourceIds":{"vndbCharacterId":"c92551"},"originalCharacterName":"兄","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p7805","sourceCompanyId":"egs:brand:5790","canonicalEntityId":"vndb:p7805","name":"milimili:AMUSE CRAFT EROTICA","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:29748:5790","source":"egs"},{"companyId":"vndb:p7805","sourceCompanyId":"vndb:p7805","canonicalEntityId":"vndb:p7805","name":"milimili:AMUSE CRAFT EROTICA","roleCo