{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"37845","model":{"presentationWorkId":"vndb:v31881","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c100879","characterName":"小鳥遊 乙羽","sourceIds":{"vndbCharacterId":"c100879"},"originalCharacterName":"小鳥遊 乙羽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who returned to her hometown after her parents' divorce. From an early age, she has carried her parents' expectations on her shoulders and has spent her days studying hard. Because of this, she is not familiar with most things other than her studies and has few friends. During the summer vacation, she attends make-up classes to fill in the gaps between her studies and those of her previous school. She loves her childhood friend Rino like a best friend and an older sister, and has been in love with the main character since she was a child. She has a single-minded personality."},{"spoiler":false,"text":"From Miconisomi"}],"source":"vndb","sourceCharacterId":"c100879"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9d3ee2f94f971bd4e54e4235d1398ccf4ab17bac8ed3d89b71eca6c760b602f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/445d0f40a1990a9ce82dfd6db9e4b7b3436d2c0f762b44c6886d3ad626e22dcc.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"陽向葵ゅか","creatorId":"vndb:s15712","sourcePersonId":"vndb:s15712","canonicalEntityId":"vndb:s15712","name":"陽向葵ゅか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89007","source":"vndb"}]},{"characterId":"char_vndb_c100880","characterName":"暁 莉乃","sourceIds":{"vndbCharacterId":"c100880"},"originalCharacterName":"暁 莉乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who belongs to the gymnastics club at an integrated school and is the head of the club. She is well-liked by the club members and has many friends. She also has a boyfriend and leads a fulfilling school life. She and Otoha have known each other for a long time, but because she is older than her, she often acts like an older sister. When she learns that Otoha has returned to her hometown, she is worried, but also happy to see her again. For some reason, she has an indifferent attitude toward the main character when they meet again..."},{"spoiler":false,"text":"From Miconisomi"}],"source":"vndb","sourceCharacterId":"c100880"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/244da8c97b8cea78c52a929bddf15334dcb6ef0284de791fc923d89e357897e7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af016e0bfc6824c92726fa70ba90d0b15f5274c842d6f90e436a288ee56bda94.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水野 七海","creatorId":"vndb:s2524","sourcePersonId":"vndb:s2524","canonicalEntityId":"vndb:s2524","name":"星野七海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89005","source":"vndb"}]},{"characterId":"char_vndb_c100881","characterName":"小鳥遊 麗子","sourceIds":{"vndbCharacterId":"c100881"},"originalCharacterName":"小鳥遊 麗子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the daughter of a prominent local businessman and the president of the PTA. Because of this, she has a high sense of pride and is always aware of the fact that she is a Takanashi. She strictly educates her daughter, Otoha, and encourages her to study hard every day. She has divorced her husband and returned to her parents' home in the countryside with Otoha. She is the protagonist's older sister and considers him to be a disgrace to the family."},{"spoiler":false,"text":"From Miconisomi"}],"source":"vndb","sourceCharacterId":"c100881"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74906fa535b2298e53ea7b99a3441faaf57a93ff54d8016338b511b7a70d473b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50cff189273177bdf4479a472968d30e5d654943dd7276f4bd1eb415fac231e1.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"秋山 はるる","creatorId":"vndb:s339","sourcePersonId":"vndb:s339","canonicalEntityId":"vndb:s339","name":"椎那 天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89006","source":"vndb"}]},{"characterId":"char_vndb_c100882","characterName":"田中 心々愛","sourceIds":{"vndbCharacterId":"c100882"},"originalCharacterName":"田中 心々愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rino's junior who joined the gymnastics club for the impure reason that she is popular with men. She is a good friend of Rino and they often discuss love stories. She is a fun-loving person, and basically just goes with the flow. She has a boyfriend, but she is open-minded about her sexuality and engages in paid dating. She's a slutty bitch who will fuck anyone as long as she can enjoy it!"},{"spoiler":false,"text":"From Miconisomi"}],"source":"vndb","sourceCharacterId":"c100882"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2edfad64008e18fd360d82cdb8342380aa14757e4a8035871450f9402765679e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0ecc802c26f60d6c05d74381f1c30aae91e27eb3c380f35efa9bfb6d8bbc8b6a.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山田 じぇみ子","creatorId":"vndb:s8416","sourcePersonId":"vndb:s8416","canonicalEntityId":"vndb:s8416","name":"山田 じぇみ子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89004","source":"vndb"}]},{"characterId":"char_vndb_c100883","characterName":"主人公","sourceIds":{"vndbCharacterId":"c100883"},"originalCharacterName":"主人公","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"His former job didn't last long, but he was fortunate enough to get a job as a temporary janitor. He is acquainted with Otoha and Rino. Reiko is his older sister."},{"spoiler":false,"text":"From Miconisomi"}],"source":"vndb","sourceCharacterId":"c100883"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d2a637e81d3f4de0b18b7b9aae569ac384f21db429a9ae325460bcf27cec129.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e30458b492770b1370195806c9773efb1a92cb6acf30e079057741ee03a1f9b9.webp","width":168,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_