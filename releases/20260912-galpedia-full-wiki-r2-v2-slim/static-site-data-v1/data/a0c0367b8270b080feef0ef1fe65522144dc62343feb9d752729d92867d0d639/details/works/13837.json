d":"vndb:s226","name":"いとうかなこ","detail":"OP曲「ラグナロク」、ED曲「蒼穹のソレイユ」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:87541","source":"egs"},{"creditedName":"いとう かなこ","creatorId":"vndb:s226","sourcePersonId":"vndb:s226","canonicalEntityId":"vndb:s226","name":"いとう かなこ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:54083","source":"vndb"},{"creditedName":"永月 到","creatorId":"vndb:s4009","sourcePersonId":"vndb:s4009","canonicalEntityId":"vndb:s4009","name":"永月 到","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:54087","source":"vndb"}]},"cast":[{"characterId":"char_c39362","characterName":"オデット・ディズ・オルトリンデ","sourceIds":{"bangumi":[{"characterId":"12889","match":"exact-normalized-name-in-linked-work","subjectId":"12771"}],"egsCharacterIds":["13593"],"vndbCharacterId":"c39362"},"originalCharacterName":"オデット・ディズ・オルトリンデ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と契約を交わした戦乙女。"},{"spoiler":false,"text":"現在神の魔法記号“ベルダンディコード”を持つ。"},{"spoiler":false,"text":"守護系や回復系の術が得意。"},{"spoiler":false,"text":"また、ヴァルハラが渇望していた、次元の扉を開く力を持つ。"},{"spoiler":false,"text":"主人公のパートナーでもあり、正妻的なポジション？"}],"source":"egs","sourceCharacterId":"13593","sourceWorkId":"13837","spoiler":false},{"segments":[{"spoiler":false,"text":"特技：野外生存……不太习惯普通女孩子会做的事。"},{"spoiler":false,"text":"和穹交换了契约的戦乙女，持有现在神的魔法记号“Verdandi Code”。"},{"spoiler":false,"text":"擅长守护系和回复系的魔法，拥有ヴァルハラ所渴望的打开次元之门的才能。"},{"spoiler":false,"text":"也许是因为自双亲逝世以来，几乎完全没有和活生生的人交往过的关系，对亲肤关系很没辙，老向穹撒娇。"},{"spoiler":false,"text":"不过还要更喜欢被人撒娇或是被人依赖，深爱着同伴与家人之类的关系。"},{"spoiler":false,"text":"因为本在地上长大，和在ヴァルハラ长大的人们持有的常识存在差别，因此而发生冲突的事也时有发生。"},{"spoiler":false,"text":"「所以说你们这些ヴァルハラ的人啊！　不过你倒是可以原谅。很合我的口味的说」"}],"source":"bangumi","sourceCharacterId":"12889"}],"profileFacts":[{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"13593","sourceWorkId":"13837","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54ac36abf01dec943ab251afa3c0d800306fd788e31bad76a7a4353b5cc44be4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d43d39c61a4d798d2d8577add78da228529b92aa920cdde3a6013e098036088.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12771:12889:5928:1","source":"bangumi"}]},{"characterId":"char_vndb_c44289","characterName":"フィルギア・ランドグリーズ","sourceIds":{"vndbCharacterId":"c44289"},"originalCharacterName":"フィルギア・ランドグリーズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"77"},"height":{"reviewState":"source-only","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"49"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/4103b93cb548d2a09d8e0ea50500cc076ca8c140961f48a3af5