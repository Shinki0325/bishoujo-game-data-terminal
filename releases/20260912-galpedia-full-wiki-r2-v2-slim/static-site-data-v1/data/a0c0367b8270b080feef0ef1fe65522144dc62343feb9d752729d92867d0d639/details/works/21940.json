:null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"34"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"98"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"サバサバ系母。"},{"spoiler":false,"text":"黙っていれば美人タイプで、プロポーションも崩れていない。"},{"spoiler":false,"text":"しかし、口を開けば主人公をからかってみたり、ガサツだったりと色々台無し。"},{"spoiler":false,"text":"料理上手で面倒見がいいが、おせっかいで少々口うるさい。"},{"spoiler":false,"text":"息子の事は目に入れても痛くないくらい愛している。"},{"spoiler":false,"text":"今の息子と同じくらいの歳に、夫と知り合い学生結婚。"},{"spoiler":false,"text":"性経験は夫とのみ。基本的に奉仕欲が強いため知識は豊富。"},{"spoiler":false,"text":"息子が産まれてからは徐々に回数が減り、もうそういう歳でもないだろう、と自然と性生活が無くなる。"},{"spoiler":false,"text":"そんなものだろうと思っていて、特に欲求不満でもない。"},{"spoiler":false,"text":"数年家を離れていた息子が帰ってきて喜んでいる。"},{"spoiler":false,"text":"構いたいが故に、からかったり余計な事を言って怒らせてしてしまう。"},{"spoiler":false,"text":"家族の繋がりを大切にしている。隠してはいるが、実は寂しがり屋。"}],"source":"egs","sourceCharacterId":"6387","sourceWorkId":"21940","spoiler":false},{"segments":[{"spoiler":false,"text":"サバサバとした性格で、ちょっとガサツなのが玉にキズな母親。"},{"spoiler":false,"text":"口を開けば息子である主人公をからかってしまう。"},{"spoiler":false,"text":"料理上手で面倒見が良く、息子を目に入れても痛くないほど愛している。"},{"spoiler":false,"text":"実は寂しがり屋で、数年ぶりに息子が家に帰ってきて内心喜んでいる。"},{"spoiler":false,"text":"とにかく息子を構いたくて、つい余計なことをして怒らせてしまうことも。"},{"spoiler":false,"text":"性経験は夫だけだが、奉仕欲が強いため知識は豊富。"},{"spoiler":false,"text":"「うんうん、自分でお部屋を綺麗に出来るなんてえらいえらいっ♪」"}],"source":"bangumi","sourceCharacterId":"45871"}],"profileFacts":[{"label":"年龄（本版本）","value":"34 岁","valueContext":null,"source":"egs","sourceCharacterId":"6387","sourceWorkId":"21940","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"98 cm","valueContext":null,"source":"egs",