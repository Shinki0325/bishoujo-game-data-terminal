rk","subjectId":"296186"}],"egsCharacterIds":["20580"],"vndbCharacterId":"c48817"},"originalCharacterName":"ワルキューレ アイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"コードネーム：ワルキューレ アイン"},{"spoiler":false,"text":"特殊諜報機関「ワルキューレ」のチームリーダー。"},{"spoiler":false,"text":"気が強く、任務優先で生真面目。"},{"spoiler":false,"text":"「悪には決して屈しない」という正義感を持ち、「実験」に対しても、なかなか折れない。"},{"spoiler":false,"text":"上層部の裏切りで、チームごと主人公の「素材」になった後は、ほどよく引き締まった「お尻」「アナル」に目をつけられて……。"}],"source":"egs","sourceCharacterId":"20580","sourceWorkId":"10953","spoiler":false},{"segments":[{"spoiler":false,"text":"特殊諜報機関所属のチーム「ワルキューレ」のリーダー。"},{"spoiler":false,"text":"優秀な潜入捜査官だが、今回、上層部の裏切りによりチームごと罠にはまり、主人公の『実験』材料となる。"},{"spoiler":false,"text":"性格はとにかく任務優先で生真面目。気が強く、悪には決して屈さないという正義感の持ち主で主人公の『実験』にも容易に屈することも無い。"},{"spoiler":false,"text":"また、任務のためなら私情に流されずあえて仲間を切り捨てることも厭わない。やや男っぽい口調が特徴。"}],"source":"bangumi","sourceCharacterId":"220025"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2aab43c9a70403b3c2c1f7420ac93ee3be8e8031291bd25f4120b59528282207.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e08f2c253453c2a903473d983431aab0414e8eefd26d32834478dd1061de399.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:296186:220025:5741:1","source":"bangumi"}]},{"characterId":"char_c48818","characterName":"ソフィア・クレーメル","sourceIds":{"bangumi":[{"characterId":"220026","match":"exact-normalized-name-in-linked-work","subjectId":"296186"}],"egsCharacterIds":["20581"],"vndbCharacterId":"c48818"},"originalCharacterName":"ソフィア・クレーメル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"コードネーム：ワルキューレ ツヴァイ"},{"spoiler":false,"text":"「ワルキューレ」の一員で、経験の豊富さから参謀的なポジションにいる諜報員。"},{"spoiler":false,"text":"物静かで落ち着きのある女性で、心が強く任務にも忠実。"},{"spoiler":false,"text":"しかし、刹那より融通の効く性格で、他メンバーの調整役にもなっている。"},{"spoiler":false,"text":"ムチムチに育った巨乳が目を引くプロポーションで、「実験」の際には、その見事な「巨乳」、そして敏感な「乳首」を徹底的に責めるのが有効なようだ。"}],"source":"egs","sourceCharacterId":"20581","sourceWorkId":"10953","spoiler":false},{"segments":[{"spoiler":false,"text":"チーム「ワルキューレ」の一員で、その経験の豊富さからチームの参謀的ポジション。"},{"spoiler":false,"text":"物静かで落ち着いた性格だが芯は強い。任務に忠実だが刹那よりは性格的に融通が利き、チームの調整役といった感じ。"},{"spoiler":false,"text":"他の二人より年上のためか自ら二人を守ろうとする傾向があり、本当の意味で非情になりきれない部分が欠点と言える。"}],"source":"bangumi","sourceCharacterId":"220026"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eee7b9ae1d0faf12892fe96c0e229f153ba1805d761a91a7096b4fecb1b0d056.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15b0d048ac96546e35b965589e50278d7fb2109627397a6c22740daa0d60cfd0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:296186:220026:4940:1","source":"bangumi"}]},{"characterId":"char_c48819","characterName":"エリーゼ・フォイエルバッハ","sourceIds":{"bangumi":[{"characterId":"220027","match":"exact-normalized-name-in-linked-work","subjectId":"296186"}],"egsCharacterIds":["20582"],"vndbCharacterId":"c48819"},"originalCharacterName":"エリーゼ・フォイエルバッハ","characterNameSource":n