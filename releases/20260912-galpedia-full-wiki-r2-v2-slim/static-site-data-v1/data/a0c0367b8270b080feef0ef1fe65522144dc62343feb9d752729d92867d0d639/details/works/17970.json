{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"17970","model":{"presentationWorkId":"vndb:v12273","staff":{"artwork":[{"creditedName":"あおぎりぺんた","creatorId":"vndb:s4034","sourcePersonId":"egs:creator:5520","canonicalEntityId":"vndb:s4034","name":"あおぎりぺんた","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:112979","source":"egs"}],"scenario":[{"creditedName":"西田一","creatorId":"vndb:s2954","sourcePersonId":"egs:creator:2890","canonicalEntityId":"vndb:s2954","name":"西田一","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:112980","source":"egs"},{"creditedName":"芳井一","creatorId":"vndb:s4035","sourcePersonId":"egs:creator:15069","canonicalEntityId":"vndb:s4035","name":"芳井一","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:112981","source":"egs"}],"music":[{"creditedName":"磯村 カイ","creatorId":"vndb:s3183","sourcePersonId":"vndb:s3183","canonicalEntityId":"vndb:s3183","name":"磯村カイ(TONAKAI sound works)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:97793","source":"vndb"}],"other":[{"creditedName":"editoranon","creatorId":"vndb:s34083","sourcePersonId":"vndb:s34083","canonicalEntityId":"vndb:s34083","name":"JR","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:97789","source":"vndb"},{"creditedName":"西田 一","creatorId":"vndb:s2954","sourcePersonId":"vndb:s2954","canonicalEntityId":"vndb:s2954","name":"西田 一","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:97791","source":"vndb"},{"creditedName":"蒼夜","creatorId":"vndb:s3044","sourcePersonId":"vndb:s3044","canonicalEntityId":"vndb:s3044","name":"蒼夜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:97792","source":"vndb"},{"creditedName":"ryouzou","creatorId":"vndb:s37729","sourcePersonId":"vndb:s37729","canonicalEntityId":"vndb:s37729","name":"ryouzou","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:97796","source":"vndb"}]},"cast":[{"characterId":"char_c32184","characterName":"宗形 巡","sourceIds":{"bangumi":[{"characterId":"19645","match":"exact-normalized-name-in-linked-work","subjectId":"54842"}],"egsCharacterIds":["854"],"vndbCharacterId":"c32184"},"originalCharacterName":"宗形 巡","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hibiki's nephew who is often causing trouble for him, usually with pranks. Blessed with the gift to see into the future; some people on the island treat him like a god because of it. He's a stoic person that doesn't show much emotion often just going with the flow."}],"source":"vndb","sourceCharacterId":"c32184"},{"segments":[{"spoiler":false,"text":"【ダウナー系男の娘巫女】"},{"spoiler":false,"text":"隠津島神社の男の娘巫女。"},{"spoiler":false,"text":"独特のダウナーな雰囲気を持ち、その空気がカリスマとして箔を与えている。"},{"spoiler":false,"text":"勘が非常に鋭く、神をおろす憑巫としての能力がある。"},{"spoiler":false,"text":"明日の天気や魚群の到来を当てることができるため、村民からは神性の巫女としてかなり重宝されている。"},{"spoiler":false,"text":"その一方で、自分の能力にはあまり好意を抱いてない。"},{"spoiler":false,"text":"巫女としての立場を自分に押し付けてくる村の伝承や神話に価値を見出せずにいる。"},{"spoiler":false,"text":"時々、神としての人格が入れ替わる。"},{"spoiler":false,"text":"そのため、神の代理人として島の連中から崇められるのは自分でも諦めている。"},{"spoiler":false,"text":"島の雑事に構わず、一人で出て行った響のことがちょっと羨ましい。"},{"spoiler":false,"text":"響にとっては姪に当たる存在、家の関係でちょっとしこりが残っているため素直になれない。"}],"source":"egs","sourceCharacterId":"854","sourceWorkId":"17970","spoiler":false},{"segments":[{"spoiler":false,"text":"隠津島神社の男の娘巫女。"},{"spoiler":false,"text":"独特のダウナーな雰囲気を持ち、その空気がカリスマとして箔を与えている。"},{"spoiler":false,"text":"勘が非常に鋭く、神を降ろす憑巫としての能力がある。"},{"spoiler":false,"text":"明日の天気や魚群の到来を当てることが出来るため、村民からは神性の巫女としてかなり重宝されている。"},{"spoiler":false,"text":"その一方で、本人は自分の能力にあまり好意を抱いてない。"},{"spoiler":false,"text":"巫女としての立場を自分に押し付けてくる村の伝承や神話に価値を見出せずにいる。"},{"spoiler":false,"text":"時々、神としての人格が入れ替わる。"},{"spoiler":false,"text":"そのため、神の代理人として島の連中から崇められるのは自分でも諦めている。"},{"spoiler":false,"text":"島の雑事に構わず一人で出て行った響のことがちょっと羨ましい。"},{"spoiler":false,"text":"響とは親戚だが、家の関係で少ししこりが残っているため素直になれない。"}],"source":"bangumi","sourceCharacterId":"19645"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c32184","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"854","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"854","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"19645","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dce211483f033166f86272e8713753fc1a9d2441da1abf31be4ae58a823fb9a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f4fe59ab768273e5d801074fa20316302ca4de6fe6abc60ba44585c973e7459.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:54842:19645:10026:1","source":"bangumi"}]},{"characterId":"char_c32245","characterName":"厳島 響","sourceIds":{"bangumi":[{"characterId":"19646","match":"exact-normalized-name-in-linked-work","subjectId":"54842"}],"egsCharacterIds":["855"],"vndbCharacterId":"c32245"},"originalCharacterName":"厳島 響","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The only one to ever leave the island to study law. He is not fond of crossdressing and only wears female clothing when he's home. Constantly quarrels with Meguru, who is his nephew. Despite this Meguru always calls him obaa-san (aunty) because of his hatred towards crossdressing. He likes to fish and has some knowledge towards repairing ship engines. He is an underclassmen of Yukito, whom he invites to the island to study the local flora."}],"source":"vndb","sourceCharacterId":"c32245"},{"segments":[{"spoiler":false,"text":"【生意気で毒舌系男の娘】"},{"spoiler":false,"text":"生意気な男の娘。主人公の後輩。"},{"spoiler":false,"text":"よく巡にいじられては仕返ししようと躍起になるがその度にやり返され、やられ返されと終わりの無い追いかけっこを演じている。"},{"spoiler":false,"text":"七生のことを姉のように慕っており、七生も出来の悪い妹として響を可愛がっている。"},{"spoiler":false,"text":"巡に対しては血縁ということもありなかなか素直に仲直りできない様子。"},{"spoiler":false,"text":"一年ほど前に進学のために島を出る。"},{"spoiler":false,"text":"主人公の後輩。学部は違うが同じ大学であり、推薦枠で入学した成績優秀者。"},{"spoiler":false,"text":"弁護士を目指して勉強をしている。"},{"spoiler":false,"text":"法学部に在籍し周囲からも将来を嘱望されている。"},{"spoiler":false,"text":"案内役として一緒に隠津島に赴くことに。"}],"source":"egs","sourceCharacterId":"855","sourceWorkId":"17970","spoiler":false},{"segments":[{"spoiler":false,"text":"生意気な男の娘。 主人公の後輩。"},{"spoiler":false,"text":"よく巡にいじられては仕返ししようと躍起になるが、その度にやり返され、やられ返しと、終わりのないやり取りを演じている。"},{"spoiler":false,"text":"七生のことを姉のように慕っており、七生も出来の悪い妹として響を可愛がっている。"},{"spoiler":false,"text":"巡に対しては血縁ということもあり、なかなか素直に仲直りできない様子。"},{"spoiler":false,"text":"一年ほど前に進学のために島を出る。"},{"spoiler":false,"text":"主人公とは学部は違うが同じ大学であり、推薦枠で入学した成績優秀者。"},{"spoiler":false,"text":"弁護士を目指して勉強をしており、法学部に在籍し周囲からも将来を嘱望されている。"},{"spoiler":false,"text":"案内役として、主人公と一緒に隠津島に赴くことに。"}],"source":"bangumi","sourceCharacterId":"19646"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c32245","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"855","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"855","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"19646","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fcd28bef17e8ebfd5bf90a9217a00d892c6bc0bf5647cc1cbb42fe4b8132202.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00ab702dc1c66f5547362984a4d528a4141273f8ceab1a4d45374de7869e953b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:54842:19646:5906:1","source":"bangumi"}]},{"characterId":"char_c32246","characterName":"藤切 七生","sourceIds":{"bangumi":[{"characterId":"19647","match":"exact-normalized-name-in-linked-work","subjectId":"54842"}],"egsCharacterIds":["856"],"vndbCharacterId":"c32246"},"originalCharacterName":"藤切 七生","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The oldest member of the group. He takes care of Meguru and Hibiki and acts like an older sister to them. He is always kind and sincere towards them, but if they manage to upset him, he can be quite frightening and starts speaking in a Kansai dialect. He does cooking, cleaning and other household chores."}],"source":"vndb","sourceCharacterId":"c32246"},{"segments":[{"spoiler":false,"text":"【女装お姉ちゃん】"},{"spoiler":false,"text":"ふわふわ髪が印象的なおっとりで癒し系なお姉さん"},{"spoiler":false,"text":"ロシア人の血を引くスラブ系の美人。"},{"spoiler":false,"text":"島長の家に生まれるがよそからの血が入っているため排他的な島では敬遠の対象になっている。"},{"spoiler":false,"text":"本人は持ち前の明るい性格で人間関係を円滑に保っている。"},{"spoiler":false,"text":"過疎化が進み、島の年寄り連中が諦めている姿を"},{"spoiler":false,"text":"はがゆく思い、ＮＧＯを立ち上げ海産物を売り込んだり島の自然を利用したエコツアーを催したり、日々村のために働いている。"}],"source":"egs","sourceCharacterId":"856","sourceWorkId":"17970","spoiler":false},{"segments":[{"spoiler":false,"text":"ふわふわ髪が印象的な、おっとりで癒し系なお姉さん。 ロシア人の血を引く美人。"},{"spoiler":false,"text":"島長の家に生まれるがよそからの血が入っているため、排他的な島では敬遠の対象になっている。"},{"spoiler":false,"text":"しかし、本人は持ち前の明るい性格で人間関係を円滑に保っている。"},{"spoiler":false,"text":"過疎化が進み、島の年寄り連中が諦めている姿をはがゆく思い、NGOを立ち上げ海産物を売り込んだり島の自然を利用したエコツアーを催したり、日々村のために働いている。"},{"spoiler":false,"text":"普段は面倒見の良い優しいお姉さんキャラだが、感情が昂ぶると九州弁になり拳での制裁も辞さない。"},{"spoiler":false,"text":"太古の儀式を再現するために巡と島を渡ってから消息を絶つ。"}],"source":"bangumi","sourceCharacterId":"19647"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c32246","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"856","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"856","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"19647","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cd02fa4b5976615ca91d29321e73815cff41d6c1f13b876e17d0fc1a38f0bc3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f633eb3cd45c51069528e7a2373e641b50fad52d5ab574037507a918a186dada.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:54842:19647:10027:1","source":"bangumi"}]},{"characterId":"char_vndb_c32247","characterName":"田島 幸人","sourceIds":{"vndbCharacterId":"c32247"},"originalCharacterName":"田島 幸人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"meta