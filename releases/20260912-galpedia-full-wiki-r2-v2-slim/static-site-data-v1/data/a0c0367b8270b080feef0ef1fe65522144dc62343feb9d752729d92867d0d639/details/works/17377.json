","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:90296","source":"vndb"},{"creditedName":"おんたま","creatorId":"vndb:s14645","sourcePersonId":"vndb:s14645","canonicalEntityId":"vndb:s14645","name":"takai(フリー音楽素材 音楽の卵、おんたま)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:90298","source":"vndb"},{"creditedName":"まよ吉","creatorId":"vndb:s47614","sourcePersonId":"vndb:s47614","canonicalEntityId":"vndb:s47614","name":"まよ吉","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:90299","source":"vndb"},{"creditedName":"kennel","creatorId":"vndb:s49942","sourcePersonId":"vndb:s49942","canonicalEntityId":"vndb:s49942","name":"kennel","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:90300","source":"vndb"},{"creditedName":"杜若","creatorId":"vndb:s49943","sourcePersonId":"vndb:s49943","canonicalEntityId":"vndb:s49943","name":"杜若","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:90301","source":"vndb"}]},"cast":[{"characterId":"char_c32571","characterName":"兵藤 エリカ","sourceIds":{"bangumi":[{"characterId":"42233","match":"exact-normalized-name-in-linked-work","subjectId":"44935"}],"egsCharacterIds":["5464"],"vndbCharacterId":"c32571"},"originalCharacterName":"兵藤 エリカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『主人公を付け狙う、秘密好きな転校生』"},{"spoiler":false,"text":"・一人称：わたし"},{"spoiler":false,"text":"・ALICE（童話の力）：赤ずきん"},{"spoiler":false,"text":"・戦闘スタイル：大鋏による斬撃"},{"spoiler":false,"text":"秘密ごとが多く、よく他人を煙に巻く少女。"},{"spoiler":false,"text":"お茶会をが好きで、生徒会メンバーを部屋に呼び自分が入れた紅茶を振舞う。"},{"spoiler":false,"text":"ALICEやおおかみの秘密を何かしら知っているようだが、何も教えてくれない。"},{"spoiler":false,"text":"「ふふっ、やはり君は面白いな……、だからわたしは君の力を欲するんだよ」"}],"source":"egs","sourceCharacterId":"5464","sourceWorkId":"17377","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の後を追うように、学園に転校してくる少女。"},{"spoiler":false,"text":"隠し事が多く、よく他人を煙に巻く行動を取る。"},{"spoiler":false,"text":"ALICEやおおかみの秘密を何か知っているらしい。"},{"spoiler":false,"text":"「さぁ、おおかみ退治の時間だ。赤ずきんの鋏からは誰も逃れられないよ」"}],"source":"bangumi","sourceCharacterId":"42233"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"5464","sourceWorkId":"17377","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"5464","sourceWorkId":"17377","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"5464","sourceWorkId":"17377","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1ec34e3da9dee6284058ebca09b3791382ef01cb60214c6b3e76088781e0fbf2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce706d920ecbd515d938fbf04e4750c1fdb871c0e7aee82710d18fa89612551e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"味里","creatorId":"vndb:s11254","sourcePersonId":"vndb:s11254","canonicalEntityId":"vndb:s11254","name":"味里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:44935:42233:10781:1","source":"bangumi"},{"creditedName":"衣央里 全","creatorId":"vndb:s2988","sourcePersonId":"vndb:s2988","canonicalEntityId":"vndb:s2988","name":"衣央里 全","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47906","source":"vndb"}]},{"characterId":"char_c32572","characterName":"姫宮 ゆり","sourceIds":{"bangumi":[{"characterId":"42234","match":"exact-normalized-name-in-linked-work","subjectId":"44935"}],"egsCharacterIds":["5465"],"vndbCharacterId":"c32572"},"originalCharacterName":"姫宮 ゆり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『勇猛果敢な、体育系生徒会長』"},{"spoiler":false,"text":"・一人称：わたし"},{"spoiler":false,"text":"・ALICE（童話の力）：シンデレラ"},{"spoiler":false,"text":"・戦闘スタイル：ガラスの槍による突貫攻撃"},{"spoiler":false,"text":"公正性で体育会系の性格、拳が言語な先輩。"},{"spoiler":false,"text":"汗が非常に似合い、気持ちのいい少女。"},{"spoiler":false,"text":"だが、空気が読めない時が多く、場違いなことを言ってしまうこともしばしば。"},{"spoiler":false,"text":"エリカには弄ばれて、よく喧嘩を吹っかける。"},{"spoiler":false,"text":"「バッカもーーーん!!訓練を疎かにするんじゃない!!」"}],"source":"egs","sourceCharacterId":"5465","sourceWorkId":"17377","spoiler":false},{"segments":[{"spoiler":false,"text":"拳が言語の体育会系で、公正的な性格の先輩。"},{"spoiler":false,"text":"成績優秀・容姿端麗であるため、皆の憧れでもある。"},{"spoiler":false,"text":"空気を読めないことが多いのが、唯一の欠点。"},{"spoiler":false,"text":"「我がシンデレラの槍は砕けえぬ槍！　すべての道は私が突き開く！　ついて来い！」"}],"source":"bangumi","sourceCharacterId":"42234"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"5465","sourceWorkId":"17377","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"5465","sourceWorkId":"17377","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"5465","sourceWorkId":"17377","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a40eda78ff7da06afe6033b1f3de8f75e08956128230a8cf3fcf064e250a2ce0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69300494c5b58e370e0c26ed641f4f9cfbde46c1af8999d50f1cfa0e3e7a3b24.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:44935:42234:4727:1","source":"bangumi"}]},{"characterId":"char_c32573","characterName":"塔ノ沢 芙美","sourceIds":{"bangumi":[{"characterId":"42235","match":"exact-normalized-name-in-linked-work","subjectId":"44935"}],"egsCharacterIds":["5466"],"vndbCharacterId":"c32573"},"originalCharacterName":"塔ノ沢 芙美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『毒舌眼鏡で参謀役の先輩』"},{"spoiler":false,"text":"・一人称：私"},{"spoiler":false,"text":"・ALICE（童話の力）：人魚姫"},{"spoiler":false,"text":"・戦闘スタイル：水を操り味方の援護"},{"spoiler":false,"text":"なぜか、主人公に対して、毒舌を振りまき敵視してくる先輩。"},{"spoiler":false,"text":"頭脳派で皆の参謀役を務める。"},{"spoiler":false,"text":"昔から姫宮ゆりのことを補佐しており、彼女に付いていく事を信条としている。"},{"spoiler":false,"text":"「こんなことも理解できていないんですね。一度前世からやり直すことをお勧めします」"}],"source":"egs","sourceCharacterId":"5466","sourceWorkId":"17377","spoiler":false},{"segments":[{"spoiler":false,"text":"なぜか、主人公にのみ毒舌を振りまいてくる先輩。"},{"spoiler":false,"text":"頭脳派で、昔から姫宮ゆりの補佐役に徹しており、機関でも参謀役を務めるほどの策士である。"},{"spoiler":false,"tex