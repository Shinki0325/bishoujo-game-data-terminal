poiler":false,"text":"・一人称：ボク"},{"spoiler":false,"text":"・ALICE（童話の力）：かぐや姫"},{"spoiler":false,"text":"・戦闘スタイル：刀での斬撃"},{"spoiler":false,"text":"普段は冷静、沈着、低温、無言の四拍子クラスメイト。"},{"spoiler":false,"text":"だが、やおいが絡むと暴走して語り続けるの腐女子。"},{"spoiler":false,"text":"山王丸芳香とは、犬猿の仲で、よく喧嘩している。"},{"spoiler":false,"text":"「ボクに関わらないでくれ、それはきっと君を不幸にする」"}],"source":"egs","sourceCharacterId":"5467","sourceWorkId":"17377","spoiler":false},{"segments":[{"spoiler":false,"text":"普段は冷静沈着、低温、無言のクラスメイト。"},{"spoiler":false,"text":"だが、やおいが絡むと暴走して語り続ける腐女子。"},{"spoiler":false,"text":"芳香とは犬猿の仲で、よく喧嘩している。"},{"spoiler":false,"text":"「天女の羽衣を纏い、剣とりて、月光輝く限り、赫映姫として踊り舞う――」"}],"source":"bangumi","sourceCharacterId":"42236"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"5467","sourceWorkId":"17377","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"5467","sourceWorkId":"17377","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"49 cm","valueContext":null,"source":"egs","sourceCharacterId":"5467","sourceWorkId":"17377","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb6fff82887085180924fabea827a6812f415696a2ffb098e8c7d59b9e75b286.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/4616318544bcffac4f559f2cab6af4d762d49b669534c0d098d0e89f53b953cd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:44935:42236:5075:1","source":"bangumi"}]},{"characterId":"char_c32576","characterName":"山王丸 芳香","sourceIds":{"bangumi":[{"characterId":"42237","match":"exact-normalized-name-in-linked