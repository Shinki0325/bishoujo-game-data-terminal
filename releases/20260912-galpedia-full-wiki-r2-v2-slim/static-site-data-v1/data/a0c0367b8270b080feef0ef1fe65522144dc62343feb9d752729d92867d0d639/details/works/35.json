static-detail"},"actors":[]},{"characterId":"char_vndb_c37454","characterName":"アニマート","sourceIds":{"vndbCharacterId":"c37454"},"originalCharacterName":"アニマート","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A pretty young peasant woman Caprese meets in his travels. A band of brigands is running a protection racket against her village and her parents are forced to send her to them as the village's tribute to them for the year. Her Arcana is The Sun."}],"source":"vndb","sourceCharacterId":"c37454"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20d93379fa53d2c0dd4f771028174d1f30fb0429d3c5023ee4187c3e2d68d6b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97e88ccaf3c2d162cf7380ebce2315b5c7738c03f809a855d61e22174d12c389.webp","width":180,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c37455","characterName":"アモローソ","sourceIds":{"vndbCharacterId":"c37455"},"originalCharacterName":"アモローソ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young and wealthy noblewoman distantly related to the Hierophant's family who rules a prosperous city that is a hub of trade. Orphaned at a young age she was raised by her family retainers to become a great noble lady, but she is bored with her life. She possesses one of the Four Great Icons, and her Arcana is the Empress."}],"source":"vndb","sourceCharacterId":"c37455"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8fbdbd36f247b11084f8a57a9825815228091777e9a17b843422db415136e47.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fa554851f96ea7c5ddb8fa7f463423d8c1963989544e35e0edf5eb7435c1678.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c37456","characterName":"イムヌス","sourceIds":{"vndbCharacterId":"c37456"},"originalCharacterName":"イムヌス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Hierophant of Mithras, and father of Harp. In addition to being head of the Mithraic religion he is also the sovereign monarch ruling the lands where most of the story takes place. He is deeply concerned with Caprese's progress and tries to see to it that he is directed toward the path of the Light. His Arcana is obviously the Hierophant."}],"source":"vndb","sourceCharacterId":"c37456"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eae6edd4148f73d2f9ca958ee57db5c2df613b55f47217176abe1d708dbf3804.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f3c854c04ae48a7ff8489fc8bc2627c666fb699bac548016e38c5305fe6fbf6.webp","width":195,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c37749","characterName":"シターン","sourceIds":{"vndbCharacterId":"c37749"},"originalCharacterName":"シターン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Grand Master of the Holy Order of Knights. In addition to defending the borders of the Hierophant's lands, she and her knights are also tasked with enforcing the rule of law in the land, and she is very strict when it comes to the Commandments of the god Mithras. Her Arcana is Justice."}],"source":"vndb","sourceCharacterId":"c37749"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80fab033099ca32fc66ccc59ae99b8dd1e177c9c99384504d72692a348e48deb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdc2f667b746477cd737c6b337515507b7d9a2d89951a56cc82a531d0c637bfb.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c37751","characterName":"団長","sourceIds":{"vndbCharacterId":"c37751"},"originalCharacterName":"団長","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Caprese's former master, who is a wealthy man whose business interests include overseas trade and a circus. He enslaved Caprese at one point, and captured Vivace from the savannah, and tricked Silvia's parents into selling her to him so he could use her as an idol."}],"source":"vndb","sourceCharacterId":"c37751"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfe11527ff45a460c1eb6b7b2ee100b2f38fc56d58f5f855fd86241f6d0525ba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c535c88a954411e0aa22c737dabf3b6e8264d7d48a1371be22f74afa4642ae9e.webp","width":175,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c37943","characterName":"シルビア","sourceIds":{"vndbCharacterId":"c37943"},"originalCharacterName":"シルビア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young singer, made into something of an idol by Danchou. Her Arcana is The Star, and she possesses one of the four Great Icons."}],"source":"vndb","sourceCharacterId":"c37943"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/1925544fcef11a11aee60bf41c3273deaba3bbf10b3a699901e2c28f0ecc40a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/118893562125f633c3f1e5410f0706c0aa289d898467885a123cdc5cabc79f24.webp","width":149,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c37957","characterName":"アナリーゼ","sourceIds":{"vndbCharacterId":"c37957"},"originalCharacterName":"アナリーゼ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The niece of the Hierophant Hymnus, who is a lady ruling a major town. Since her late father was the elder brother of Hymnus, she should have become Hierophant instead, but she willingly gave up claims to the position to her uncle and confined herself to her town and library. She is a great intellectual and is one of the few who knows of the ancient lore of the Icons. Her Arcana is The High Priestess."}],"source":"vndb","sourceCharacterId":"c37957"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/022fdd958e26b99c4d4c0e82a9ce28d0e0a865821a1f3e4b8b93cf7fa6fd0393.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95ce65cd3dc9caa193226a7991417ce7d7feb3a92c3010b173865be43781dd83.webp","width":128,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c37958","characterName":"トンボー","sourceIds":{"vndbCharacterId":"c37958"},"originalCharacterName":"トンボー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A treacherous man who constantly crosses Caprese's path, and says that they are like two sides of a mirror. Appears to be in league with the Meister. His Arcana is The Hanged Man."},{"spoiler":true,"text":"He is actually Caprese's twin brother."}],"source":"vndb","sourceCharacterId":"c37958"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba5ae5283cfb9644bd2de8461e8c16d65337e1d8cec2d29bfb6ac90b1f281493.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/733fee384e68d1ef79f615416f8bcb3773a8bc8d8785901d11e439e8ad9e1a4f.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c37959","characterName":"マイスター","sourceIds":{"vndbCharacterId":"c37959"},"originalCharacterName":"マイスター","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious old man who tells Caprese of the Icons. He appears to be in league with Tombeau. His Arcana is the Magician."}],"source":"vndb","sourceCharacterId":"c37959"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/563e4cba81ceb1f8e58139c81e1e6a79280bacbf2bd700615ee7f7b0924f8d77.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cce2f530f5d93d2d4e3176c1c3e4a83ae38bb918a94d39705bbdfdc6f2827aa2.webp","width":194,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c38090","characterName":"グランディ","sourceIds":{"vndbCharacterId":"c38090"},"originalCharacterName":"グランディ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The commander of the armies in the north, fighting against the infidel army with a rag-tag band of mercenaries and former brigands. She is a harsh commander and considers no tactic underhanded against what she considers the forces of Darkness. Her Arcana is the Chariot."}],"source":"vndb","sourceCharacterId":"c38090"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f9dad0fd41997487c45d5e3722d11d24db442d22822ad3e50188c88d363cf2b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b9344a1c58bad80da30a649853ac8428bc1807e76ecd4996cbfeecb7cdba70d.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c38091","characterName":"マルカート","sourceIds":{"vndbCharacterId":"c38091"},"originalCharacterName":"マルカート","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The commander of the army of darkness. His arcana is the Emperor."}],"source":"vndb","sourceCharacterId":"c38091"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49c7afb5c481d5c22052cf0ce22df81d6dbe473c0f8510c14ffa32fc33703795.webp","fallbackUrl":"htt