9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03df633dc61450bb1be08046ad7800f3989eda75dbf3d8219ac0a1b2cf1448f6.webp","width":256,"height":182,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c39088","characterName":"パスピエ","sourceIds":{"vndbCharacterId":"c39088"},"originalCharacterName":"パスピエ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A strange woman who takes Caprese into her home. Her Arcana is The Moon."},{"spoiler":true,"text":"It turns out that she is long dead, and her ghost, tormented by being unable to accept the death of her husband in a long-ago war, is being manipulated by Tombeau and Dominante to drive Caprese into despair so they can take the Icons he has gathered so far."}],"source":"vndb","sourceCharacterId":"c39088"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01ce84c831e1ad0e8e775d03ed8e5be4c65feb39db07c1d01f074986b5863bcc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c66ec09ec959e7239bd4fe04dd9571b0688cb63018be6fa9dd3144bebe35bdcf.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c39094","characterName":"山賊","sourceIds":{"vndbCharacterId":"c39094"},"originalCharacterName":"山賊","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The leader of a gang of brigands that ran a protection racket against Animato's village. Later he was forced into the army under Grandi's command."}],"source":"vndb","sourceCharac