ers/v1/images/54/54fff9d8ddd88a099fab2083d538ea4360f9a3f46fcb61b3b16a7b4ca302d0be.webp","width":232,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c113575","characterName":"くーこ","sourceIds":{"vndbCharacterId":"c113575"},"originalCharacterName":"くーこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"71"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"145"},"hip":{"reviewState":"source-only","source":"vndb","value":"73"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Kuu. This person,\"is\", frightening.\""},{"spoiler":false,"text":"Likes: Fish dishes"},{"spoiler":false,"text":"A mysterious quiet and expressionless girl."},{"spoiler":false,"text":"Due to her often adding the word \"Kuu\" when speaking which sounds like an animal sound, she was named \"Kuuko\", and she is staying at the same beach house where Kyouhei lives."},{"spoiler":false,"text":"She is usually in a daze and can only speak in a faltering tone."},{"spoiler":false,"text":"Also, for some reason, she seems to be attached to Kyouhei, and often sits on his lap immediately when he is at home."},{"spoiler":false,"text":"She has a habit of always needing to bite something to compose herself, especially Kyouhei's head and arms which are her favorite things to bite."},{"spoiler":false,"text":"Translated and edited from the official website"}],"source":"vndb","sourceCharacterId":"c113575"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24c0dfae84f6a0a0501a4270c7d47cd65aafdbaca1679fe522088742574493fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8bdb64e77425776ac3dbed3bf65aca5dbae27e33021b3a7c699356663323f72.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏和小","creatorId":"vndb:s8737","sourcePersonId":"vndb:s8737","canonicalEntityId":"vndb:s8737","name":"藤田 茜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92208","source":"vndb"}]},{"characterId":"char_vndb_c113576","characterName":"天竺 天音","sourceIds":{"vndbCharacterId":"c113576"},"originalCharacterName":"天竺 天音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"915"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"If I catch an octopus...... Takoyaki, can you make it?\""},{"spoiler":false,"text":"Likes: Military, muscle"},{"spoiler":false,"text":"A tourist girl who comes from the city."},{"spoiler":false,"text":"Due to certain circumstances, she was banned from entering the shopping district and restaurant​s. Unable to endure her hunger, she went looking for food at Kyouhei's house. She got caught and was mistaken for a burglar."},{"spoiler":false,"text":"After that, the misunderstanding was cleared, and since then, the two of them got acquainted and go sightseeing in the town together. She is very fond of B-grade gourmet food, especially, yakisoba, takoyaki, etc."},{"spoiler":false,"text":"A narcissistic, prideful, and go her own way type, often treats Kyouhei with her high-handed attitude as well, but on the other hand, she also has a surprising​ side, such as becoming weak when she feels pressured."},{"spoiler":false,"text":"Translated and edited from the Official website"}],"source":"vndb","sourceCharacterId":"c113576"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fc3d3d4b695d819bc53c8759a781d568628478211f605cedf43f4a870959d5b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bc084a095ecae20bf324c1c0f1b07318c462e87f02c756d2454e4759add7fb5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"百瀬 百環","creatorId":"vndb:s29086","sourcePersonId":"vndb:s29086","canonicalEntityId":"vndb:s29086","name":"木村 千咲","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92211","source":"vndb"}]},{"characterId":"char_vndb_c113577","characterName":"保城 麗水","sourceIds":{"vndbCharacterId":"c113577"},"originalCharacterName":"保城 麗水","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"810"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Hey, hey, in this situation, could it be...... We are, Papa and Mama!?\""},{"spoiler":false,"text":"Likes: Ice cream, swimming"},{"spoiler":false,"text":"Kyouhei's childhood friend and classmate. She is a member of the school's swimming club and also serves as it's captain."},{"spoiler":false,"text":"A bright and lively girl with excellent motor skills. In addition, she has a cute smile and is a popular person in her class as well."},{"spoiler":false,"text":"She is considered to be a manly type as she likes to act before thinking, but on the inside, she is more of a lady than anyone else."},{"spoiler":false,"text":"Even with her conspicuous foolish behavior which has often amazed Kyouhei, there is also another side of her which shows an unusually keen insight and a sixth sense."},{"spoiler":false,"text":"She lives in the same beach house as Kyouhei. She is also a good cook, and Kyouhei's meals are basically prepared by her."},{"spoiler":false,"text":"Translated and edited from the Official website"}],"source":"vndb","sourceCharacterId":"c113577"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/6944402ffed37e81e546492f71efd270257e9676140f456e188b13646c2d671f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce9ae4277277af08482455b65d032ffdc656029c0dd74c4514294d144498ea2d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨天 ひなた","creatorId":"vndb:s17075","sourcePersonId":"vndb:s17075","canonicalEntityId":"vndb:s17075","name":"星谷 美緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92210","source":"vndb"}]},{"characterId":"char_vndb_c113578","characterName":"吉切 遠花","sourceIds":{"vndbCharacterId":"c113578"},"originalCharacterName":"吉切 遠花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"407"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Is having a conversation with Fukami-kun worth more than 2 math questions?\""},{"spoiler":false,"text":"Likes: City topics, city fashion"},{"spoiler":false,"text":"Kyouhei's classmate, a second-year student, and an honor student who is studying hard to become a doctor."},{"spoiler":false,"text":"A girl with a model-like figure and an immensely beautiful face, she thinks that she can't waste a single second of her study time in order to leave the small island and become a doctor in the city. Because of this, she decides that having a conversation or interacting with the people of the same age are pointless, building a wall around her."},{"spoiler":false,"text":"Basically, she is a calm, collected, clear-headed, cool, and beautiful girl. However, since her longing for the city is so strong, when topics about the city are brought up, she becomes useless......"},{"spoiler":false,"text":"As a reaction to her living a life that always feels stressed, she dresses openly when she is at her house to relieve it. In other words, she gets naked."},{"spoiler":false,"text":"Translated and edited from the Official website"}],"source":"vndb","sourceCharacterId":"c113578"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1981e177e071b7bd4108c478b4942eb9c3ec97bee9453cf48c3c21890c1410d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20dfba40dc20866a35eb252ec43e46ceba53ed8d79868e141aac2256bb1a0395.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"明羽 杏子","creatorId":"vndb:s14378","sourcePersonId":"vndb:s14378","canonicalEntityId":"vndb:s14378","name":"長谷川 育美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92209","source":"vndb"}]},{"characterId":"char_vndb_c113579","characterName":"眼深 真瑠璃","sourceIds":{"vndbCharacterId":"c113579"},"originalCharacterName":"眼深 真瑠璃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1228"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"......More, I want to get along. With you, I want to talk more and more.\""},{"spoiler":false,"text":"Likes: Anime, manga, B movie (splatter film, etc.)"},{"spoiler":false,"text":"Kyouhei's classmate, a gloomy girl, and a second-year student who doesn't belong to any club."},{"spoiler":false,"text":"A timid and introverted girl with negative thoughts and poor communication skills. Unable to fit in with her classmates, she is always alone in the class, reading books or pretending to sleep to get by."},{"spoiler":false,"text":"She speaks in low and quiet voice, befitting her personalities, and has a hard time looking the other person in the eyes during a conversation. However, once she gets along with someone, she sometimes become a braggart."},{"spoiler":false,"text":"She likes anime, manga, B movie, etc., and has vast knowledge of the occult. She is also familiar with the island belief in the octopus god."},{"spoiler":false,"text":"Translated and edited from the Official website"}],"source":"vndb","sourceCharacterId":"c113579"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8bc16a4282830215757d863528c683fa6ee4ad6be573f2e20adde6ffc5f816a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3bc7b58eeb97e3da0e9bd43c412e09f45e3ac684436a87b5eb5ea56996f8d2b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春乃 いろは","creatorId":"vndb:s2258","sourcePersonId":"vndb:s2258","canonicalEntityId":"vndb:s2258","name":"三宅 麻理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92207","source":"vndb"}]},{"characterId":"char_vndb_c113580","characterName":"船堀お姉さん","sourceIds":{"vndbCharacterId":"c113580"},"originalCharacterName":"船堀お姉さん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"407"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"94"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"G"},"height":{"reviewState":"source-only","source":"vndb","value":"166"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Because it's a festival, as long as it's fun, then anything is fine. It's been that way for a long time.\""},{"spoiler":false,"text":"Likes: Radio, photograph"},{"spoiler":false,"text":"Self-proclaimed \"Funabori Onee-san Sensei\", no one knows her real name."},{"spoiler":false,"text":"Usually, she works as a teacher at the school where Kyouhei and Remi attend. But sometimes, she is also a police officer, a convenience store clerk, an insurance doctor, and so on. A mysterious woman who often appears in various places and various appearances."},{"spoiler":false,"text":"Although she has a variety of looks, she doesn't have a close relationship with anyone and her private life remains a mystery."},{"spoiler":false,"text":"At first glance, she doesn't seem to be thinking about anything, and with her happy-go-lucky personality, she likes to tease Kyouhei in funny and humorous ways."},{"spoiler":false,"text":"She gives off a carefree vibe, but on the other hand, her motto is to perform her work perfectly. In fact, she can handles any task flawlessly as a competent adult."},{"spoiler":false,"text":"Translated and edited from the Official website"}],"source":"vndb","sourceCharacterId":"c113580"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20b5f2061ea5f03521d823b3096e69d787d77e880bda3af40883bf7009e78802.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/5280088fe4fcc33b613539052577ae15432909f966df074a7a16305b4d20d9f6.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神代 岬","creatorId":"vndb:s81","sourcePersonId":"vndb:s81","canonicalEntityId":"vndb:s81","name":"浅川 悠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:92206","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p735","sourceCompanyId":"egs:brand:2715","canonicalEntityId":"vndb:p735","name":"CUBE","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs