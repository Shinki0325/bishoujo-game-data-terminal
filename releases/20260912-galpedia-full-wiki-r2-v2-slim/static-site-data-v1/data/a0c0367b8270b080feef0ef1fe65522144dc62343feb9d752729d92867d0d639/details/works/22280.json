tityStatus":"source-native","relationId":"vndb:vn-staff:49712","source":"vndb"},{"creditedName":"まえだ 絵馬","creatorId":"vndb:s9783","sourcePersonId":"vndb:s9783","canonicalEntityId":"vndb:s9783","name":"まえだ 絵馬","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49716","source":"vndb"},{"creditedName":"阪本 海老人","creatorId":"vndb:s15636","sourcePersonId":"vndb:s15636","canonicalEntityId":"vndb:s15636","name":"阪本 海老人","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49717","source":"vndb"}]},"cast":[{"characterId":"char_c12856","characterName":"鳩羽 桜花","sourceIds":{"bangumi":[{"characterId":"92450","match":"exact-normalized-name-in-linked-work","subjectId":"268528"}],"egsCharacterIds":["13741"],"vndbCharacterId":"c12856"},"originalCharacterName":"鳩羽 桜花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The older of the two Hatoba twins. Sakura is physically frail and spent years in the hospital when she was younger, which is why she’s a year below her sister as a freshman."},{"spoiler":false,"text":"Nonetheless, she is unfailingly polite and treats everyone to her gentle smiles—so she’s quickly building a fanbase among the student body."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c12856"},{"segments":[{"spoiler":false,"text":"舞台となる「聖マルティウス学園」に通う女子学生。一年生。"},{"spoiler":false,"text":"藤音の双子の姉。"},{"spoiler":false,"text":"幼い頃から身体が弱く、長く入院生活を送っていたため、妹よりも一学年下になっている。"},{"spoiler":false,"text":"おっとりとしていて清らかな雰囲気を持った女の子。"},{"spoiler":false,"text":"礼儀正しく、誰にでも優しく接する模範的な優等生。"}],"source":"egs","sourceCharacterId":"13741","sourceWorkId":"7399","spoiler":false},{"segments":[{"spoiler":false,"text":"鳩羽藤音の双子の姉。一年生。"},{"spoiler":false,"text":"病弱で小さい頃から長く入院生活を送っていたのが原因で、一学年ずれている。その為、藤音とは『姉』なのに『後輩』という変わった関係に。"},{"spoiler":false,"text":"礼儀正しく、誰にでも笑顔で優しく接するため、生徒にファンは多い。おっとりとしていて優等生なので、教師の受けもいい。"}],"source":"bangumi","sourceCharacterId":"92450"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d902e785bbec33c6d252fe2febca907bbd14080f6941321dc1fb06d518eb0ce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bf0fc07bb13c582e3ab8687748e776dc264dabdd0951a8bd7f0e83e80298502.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268528:92450:4956:1","source":"bangumi"}]},{"characterId":"char_c12857","characterName":"鳩羽 藤音","sourceIds":{"bangumi":[{"characterId":"92451","match":"exact-normalized-name-in-linked-work","subjectId":"268528"}],"egsCharacterIds":["13827"],"vndbCharacterId":"c12857"},"originalCharacterName":"鳩羽 藤音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The younger Hatoba twin and a second-year student, Fujine adores her sister Sakura so much that she sticks to her like glue whenever they go. Excelling at sports, she’s also in the lacrosse club."},{"spoiler":false,"text":"Easygoing and cheerful almost to the point of idiocy, but also naturally beautiful, she’s uninterested in romance despite the number of students with crushes on her. She would much rather focus on sports and, of course, her big sister."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c12857"},{"segments":[{"spoiler":false,"text":"舞台となる「聖マルティウス学園」に通う女子学生。二年生。"},{"spoiler":false,"text":"桜花の双子の妹。"},{"spoiler":false,"text":"能天気なほど明るく、さばさばしていて、活発な女の子。"},{"spoiler":false,"text":"スポーツが大好きで、ラクロス部に所属している。"},{"spoiler":false,"text":"美人双子姉妹として学園でも有名で、彼女自身も密かに人気があるものの、まるで色恋沙汰には関心がない。"}],"source":"egs","sourceCharacterId":"13827","sourceWorkId":"7399","spoiler":false},{"segments":[{"spoiler":false,"text":"鳩羽桜花の双子の妹。二年生。"},{"spoiler":false,"text":"姉である桜花が大好きで、いつもべったりとくっついている。"},{"spoiler":false,"text":"スポーツが得意で、ラクロス部に所属している。さばさばしていて、能天気なほど明るい。"},{"spoiler":false,"text":"美人なので密かに人気はあるが本人はそういった色恋沙汰に、まるで関心がない。恋愛よりも、部活よりも、お姉ちゃんが一番大切。"}],"source":"bangumi","sourceCharacterId":"92451"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b70812a226adbc327cfdf8c43b9f11494e80812894b7e917a354cb8cfb78ae8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d5b8153a5774c4eb2aec1c2b8b840dcd0277263e79e45aa4ed60549055d6c7d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268528:92451:5890:1","source":"bangumi"}]},{"characterId":"char_c12858","characterName":"周防 和歌子","sourceIds":{"bangumi":[{"characterId":"92452","match":"exact-normalized-name-in-linked-work","subjectId":"268528"},{"characterId":"92452","match":"exact-normalized-name-in-linked-work","subjectId":"61846"}],"egsCharacterIds":["5506"],"vndbCharacterId":"c12858"},"originalCharacterName":"周防 和歌子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third-year student and Miyu’s childhood friend. Having recently arrived as a transfer student, this rich princess’s pride is high; her will, unflinching."},{"spoiler":false,"text":"She’s a quick study but not so good at exercise. The younger girls hold her in the highest esteem."},{"spoiler":false,"text":"From Official Steam Page"}],"source":"vndb","sourceCharacterId":"c12858"},{"segments":[{"spoiler":false,"text":"舞台となる「聖マルティウス学園」に通う女子学生。三年生。"},{"spoiler":false,"text":"常盤未優の幼馴染。"},{"spoiler":false,"text":"同学園には数か月ばかり前に転校してきた新顔。"},{"spoiler":false,"text":"家がお金持ちのお嬢様。プライドが高く、勝気な性格。"},{"spoiler":false,"text":"後輩の女子たちから人気が高く、「お姉さま」と慕われている。"},{"spoiler":false,"text":"勉強は出来る方だがスポーツは苦手のようだ。"}],"source":"egs","sourceCharacterId":"5506","sourceWorkId":"7399","spoiler":false},{"segments":[{"spoiler":false,"text":"聖マルティウス学園の三年生。"},{"spoiler":false,"text":"プライドが高く気が強い、お金持ちのお嬢様。"},{"spoiler":false,"text":"勉強は得意。運動は苦手。女の子の後輩からは、お姉様と慕われている。"},{"spoiler":false,"text":"性奴隷陥落済みだが、心は折れていない。"},{"spoiler":false,"text":"今回岸家に買われ、その息子二人に調教されることとなる。"}],"source":"egs","sourceCharacterId":"5506","sourceWorkId":"17259","spoiler":false},{"segments":[{"spoiler":false,"text":"常盤未優の幼なじみ。三年生。"},{"spoiler":false,"text":"学園には数ヶ月前に転校してきたばかり。"},{"spoiler":false,"text":"プライドが高く気が強い、お金持ちのお嬢様。"},{"spoiler":false,"text":"勉強は得意だが、運動は苦手。女の子の後輩から、お姉様と慕われている。"}],"source":"bangumi","sourceCharacterId":"92452"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/722575aea436ca37d1c3622f30be6c48970c152f705f205aeb037797a3a8ac4d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79258df1c58ee80ffc0966e14827e91a6c0e4b51bef129b543ee1010d51e5d1d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"亜城めぐ","creatorId":"vndb:s454","sourcePersonId":"vndb:s454","canonicalEntityId":"vndb:s454","name":"亜城 めぐ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268528:92452:4833:1","source":"bangumi"}]},{"characterId":"char_c12859","characterName":"常盤 未優","sourceIds":{"bangumi":[{"characterId":"92453","match":"exact-normalized-name-in-linked-work","subjectId":"268528"}],"egsCharacterIds":["13828"],"vndbCharacterId":"c12859"},"originalCharacterName":"常盤 未優","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"71"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AA"},"height":{"reviewState":"no-conflict","source":"vndb","value":"146"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Miyu, a first-year student, seems cute but can come off as cold and aloof. Her family sold her to the Nishikis’ service after submitting to their power, so she attends St. Martius to learn the maidly arts."},{"spoiler":false,"text":"She distances herself from those around her—even Wakako—but only because she’s afraid that she’ll drag them down with her if they learn of her circumstances."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c12859"},{"segments":[{"spoiler":false,"text":"舞台となる「聖マルティウス学園」に通う女子学生。一年生。"},{"spoiler":false,"text":"幼く可愛らしい少女だが、両親が娘である彼女を西紀家に売ったため、性奴隷生徒として生きる定めを背負わされ、同学園に通っている。"},{"spoiler":false,"text":"彼女は現在、理事長の性奴隷にされ、彼の性欲の捌け口として使われている。"},{"spoiler":false,"text":"自分の境遇を諦め、受け入れてしまっており、心を閉ざし、あまり感情を表に出さない。"}],"source":"egs","sourceCharacterId":"13828","sourceWorkId":"7399","spoiler":false},{"segments":[{"spoiler":false,"text":"一年生。"},{"spoiler":false,"text":"幼く可愛らしい風貌とは裏腹に、どこか冷めていて感情をあまり表に出さない。"},{"spoiler":false,"text":"実家が西紀家に屈従し未優を売った為、奴隷生徒として学園に通っていて、龍之介が学園に来る前から理事長に性奴隷として扱われている。"},{"spoiler":false,"text":"幼なじみの周防和歌子を含む他人と、自ら距離を置いているが、それは自分の境遇を知られることと、それにより周りを巻き込むのを恐れるためである。"},{"spoiler":false,"text":"性奴隷という自分の境遇を諦め、受け入れてしまっている。"}],"source":"bangumi","sourceCharacterId":"92453"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aeebce1daf5c5610753407e9313d6d086c7f7cc0c88b330ee0c001edbf60df58.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20ab669405d8cd3f013f75d7d8465cb2c1c55dc25702515ef210cfa196991795.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹間千ノ美","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268528:92453:19333:1","source":"bangumi"}]},{"characterId":"char_c12860","characterName":"森 ヘンリッカ","sourceIds":{"bangumi":[{"characterId":"92454","match":"exact-normalized-name-in-linked-work","subjectId":"268528"}],"egsCharacterIds":["13829"],"vndbCharacterId":"c12860"},"originalCharacterName":"森 ヘンリッカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"99"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hailing from Scandinavia, Henrika is Rin’s mother and the wife of Chairman Mori. Still, in her late twenties, she appears younger than she is, making it hard to believe that she’s already a mom. She works as her husband’s assistant and provides foreign language classes to the students part-time."},{"spoiler":false,"text":"From Official Steam Page"}],"source":"vndb","sourceCharacterId":"c12860"},{"segments":[{"spoiler":false,"text":"舞台となる「聖マルティウス学園」の理事長・森良男の妻で、その秘書も務めている。"},{"spoiler":false,"text":"北欧出身の外国人女性で、日本人離れした豊満な肉体を持つ。"},{"spoiler":false,"text":"非常勤の講師として、外国語を教えている。"},{"spoiler":false,"text":"彼女はかつて、西紀家の姓奴隷だったが、その経緯で森に宛がわれ、結婚に至る。"},{"spoiler":false,"text":"夫との間に、凛という名の娘がいる。"},{"spoiler":false,"text":"秘書としては有名で、またドジでお茶目なところがあり、親しみやすい。"}],"source":"egs","sourceCharacterId":"13829","sourceWorkId":"7399","spoiler":false},{"segments":[{"spoiler":false,"text":"北欧出身の外国人で、森理事長の妻。娘が1人いる。"},{"spoiler":false,"text":"若々しく、性格も可愛らしいので子供がいるようには見えない。"},{"spoiler":false,"text":"理事長の秘書、兼、非常勤で学園の外国語の教師も務めている。"},{"spoiler":false,"text":"美人で有能だが、ドジでおちゃめな面もあるので親しみやすい。"},{"spoiler":false,"text":"かつては西紀家の姓奴隷だった。その経緯で森にあてがわれ、結婚に至る。"},{"spoiler":false,"text":"夫婦仲は冷めているが、ヘンリッカの方はまだ夫に寄り添おうと努力している。"}],"source":"bangumi","sourceCharacterId":"92454"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4d40bd94ba3a05365ad425d92b71a3d2dbf4e4eedf4450e8d9a2a8410bf54eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c717f43710ea037dfbb9ccba0e785e0ec1008962ae18e9c443bc188b474aaccb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"如月美琴","creatorId":"vndb:s1012","sourcePersonId":"vndb:s1012","canonicalEntityId":"vndb:s1012","name":"如月 美琴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268528:92454:6217:1","source":"bangumi"}]},{"characterId":"char_c12861","characterName":"森 凛","sourceIds":{"bangumi":[{"characterId":"92455","match":"exact-normalized-name-in-linked-work","subjectId":"268528"}],"egsCharacterIds":["7422"],"vndbCharacterId":"c12861"},"originalCharacterName":"森 凛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"70"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"138"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The half-Japanese daughter of Chairman Mori and Henrika. She’s the complete opposite of her father—tiny, innocent, and as cute as a button."},{"spoiler":false,"text":"From Official Steam Page"}],"source":"vndb","sourceCharacterId":"c12861"},{"segments":[{"spoiler":false,"text":"舞台となる「聖マルティウス学園」の理事長とヘンリッカの間に生まれたハーフの娘。"},{"spoiler":false,"text":"その容姿は、母に似て整った顔立ちを持った可愛らしい少女。"},{"spoiler":false,"text":"まだまだ幼く、無邪気で天真爛漫。"}],"source":"egs","sourceCharacterId":"7422","sourceWorkId":"7399","spoiler":false},{"segments":[{"spoiler":false,"text":"【天真爛漫少女】"},{"spoiler":false,"text":"いくつもの学園を経営する、世の寵児の娘。"},{"spoiler":false,"text":"アイドル的な広告塔にもなっている。"},{"spoiler":false,"text":"物怖じしない快活な性格。"},{"spoiler":false,"text":"エッチなことには憧れているものの、まだよくわかっていないところある。"},{"spoiler":false,"text":"「あ、いたいた。あのね凛ね、パフェ食べたいの。作って欲しいなー」"}],"source":"egs","sourceCharacterId":"7422","sourceWorkId":"21767","spoiler":false},{"segments":[{"spoiler":false,"text":"森理事長とヘンリッカの間に生まれたハーフの娘。"},{"spoiler":false,"text":"父親には似ても似つかない可愛らしい容姿。とてもちいさく、無邪気で愛らしい。"}],"source":"bangumi","sourceCharacterId":"92455"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a969b9db4e7fdfe2da22a225652d5b4c478dda0fc17782282409c627525860c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/7962a9e7f31cbf1d35af4c263bcdfd0935a9168dcae8921dd7c62fa803eef96c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268528:92455:4646:1","source":"bangumi"}]},{"characterId":"char_vndb_c12862","characterName":"哭東 龍之介","sourceIds":{"vndbCharacterId":"c12862"},"originalCharacterName":"哭東 龍之介","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/743934708adba2b77c8f09b020671397855a29431caab7d8d360a828fbe1473e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d2668136008b08dc61db0f9641c3c7d7cf2b