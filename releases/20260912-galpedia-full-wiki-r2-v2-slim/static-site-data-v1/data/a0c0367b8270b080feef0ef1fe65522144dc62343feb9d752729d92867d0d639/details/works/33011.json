rs/v1/images/38/380748cbb509e2016ca1f35296223bb7cd49539d405d5c18aa479c3f0059e0cc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1e4b9ebf5492778c93c7e62b98366aa5bf3eeae2f18dbf9c8cdfa8ecfdb9750.webp","width":214,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大島哲","creatorId":"vndb:s25910","sourcePersonId":"vndb:s25910","canonicalEntityId":"vndb:s25910","name":"大島哲","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90659","source":"vndb"}]},{"characterId":"char_vndb_c105203","characterName":"Kuya","sourceIds":{"vndbCharacterId":"c105203"},"originalCharacterName":"Kuya","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"522"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Revered by the beasts of the forest, Kuya is a magical fox who through years and years of exposure to essence gradually gained a human form. A lover of all things new and exciting, he loathes nothing more than being bored. Specialized in creating illusions, he utilizes them to toy with others for his own personal pleasure."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c105203"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a5ed4f1b5567883a6405f92f2718c7d1a7083edd263539567209597042b4674.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0238d5be5e0559e22960edd4be9a28a505bad82d8df59e37c5f12c0fb09121f.webp","width":214,"height":256,"source":"static-detail"},"actors":[{"creditedName":"四ツ谷 サイダー","creatorId":"vndb:s85","sourc