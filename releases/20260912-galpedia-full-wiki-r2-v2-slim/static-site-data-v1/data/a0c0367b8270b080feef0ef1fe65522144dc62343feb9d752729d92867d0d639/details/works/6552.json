{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"6552","model":{"presentationWorkId":"vndb:v43243","staff":{"artwork":[{"creditedName":"今掛 勇","creatorId":"vndb:s6031","sourcePersonId":"vndb:s6031","canonicalEntityId":"vndb:s6031","name":"今掛 勇","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:194877","source":"vndb"},{"creditedName":"うたたね ひろゆき","creatorId":"vndb:s13109","sourcePersonId":"vndb:s13109","canonicalEntityId":"vndb:s13109","name":"うたたね ひろゆき","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:194879","source":"vndb"},{"creditedName":"鈴木 俊二","creatorId":"vndb:s13510","sourcePersonId":"vndb:s13510","canonicalEntityId":"vndb:s13510","name":"鈴木 俊二","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:194881","source":"vndb"},{"creditedName":"高村 和宏","creatorId":"vndb:s17285","sourcePersonId":"vndb:s17285","canonicalEntityId":"vndb:s17285","name":"高村 和宏","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:194882","source":"vndb"}],"scenario":[],"music":[],"other":[{"creditedName":"美樹本 晴彦","creatorId":"vndb:s6028","sourcePersonId":"vndb:s6028","canonicalEntityId":"vndb:s6028","name":"美樹本 晴彦","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:194876","source":"vndb"},{"creditedName":"貞本 義行","creatorId":"vndb:s6055","sourcePersonId":"vndb:s6055","canonicalEntityId":"vndb:s6055","name":"貞本 義行","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:194878","source":"vndb"},{"creditedName":"菅 真理子","creatorId":"vndb:s13499","sourcePersonId":"vndb:s13499","canonicalEntityId":"vndb:s13499","name":"菅 真理子","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:194880","source":"vndb"},{"creditedName":"佐々木 洋","creatorId":"vndb:s24263","sourcePersonId":"vndb:s24263","canonicalEntityId":"vndb:s24263","name":"佐々木 洋","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:194883","source":"vndb"}]},"cast":[{"characterId":"char_bangumi_3174","characterName":"タカヤ・ノリコ","sourceIds":{"bangumi":[{"characterId":"3174","match":"source-roster","subjectId":"121193"}]},"originalCharacterName":"タカヤ・ノリコ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"帝国宇宙軍付属沖縄女子宇宙高等学校・通称「沖女（オキジョ）」生徒。帝国宇宙軍提督タカヤ・ユウゾウの娘。宇宙怪獣の襲撃により消息不明となった父との再会を願い、宇宙へ行くことを夢見ている。"},{"spoiler":false,"text":"身体能力は非常に高く、グラウンドを50周するほどのずば抜けた体力とスタミナの持ち主。反面、臆病かつ泣き虫な性格で、マシーン兵器も満足に動かせない落ちこぼれであった。宇宙提督の娘という出自ゆえに周囲から白い目で見られており、父の率いていたるくしおん艦隊が宇宙怪獣の襲撃により全滅させられたことから全滅娘と呼ばれ中傷されていた。更にトップ部隊のパイロット候補生として女子部代表に選抜されたことで全校生から嫉妬されて孤立し、陰湿ないじめを受けるようになる。"},{"spoiler":false,"text":"そんな自分に劣等感を抱いていたが、持ち前の努力と人並外れた根性をコーチ（コウイチロウ）に見出され、猛特訓により徐々に実力を身に着けていく。そして晴れて帝国宇宙軍少尉に任官して念願の宇宙へ上がり、父の死という現実、宇宙怪獣との戦闘、思い人であるスミスとの死別、トラウマの克服など様々な経験を経て心身ともに飛躍的に成長する。数々の苦難を乗り越え、雲の上の存在だったカズミを逆に叱咤激励するまでに至る。"},{"spoiler":false,"text":"終盤の「カルネアデス計画」にて、ガンバスターの縮退炉を利用するという捨て身の作戦によって、機能停止したバスターマシン3号（ブラックホール爆弾）を再起動させ、1万2000年後への時間的跳躍という代償を経て作戦を成功に導いた。"},{"spoiler":false,"text":"搭乗機はRX-7（愛称：ナウシカ）とガンバスター（バスターマシン1号）。"},{"spoiler":false,"text":"2006年9月12日生まれ。血液型はO型。中学は大阪市立三陵中学校を卒業している。"},{"spoiler":false,"text":"無類のアニメ・特撮好きで、自分の部屋に『風の谷のナウシカ』『宇宙戦艦ヤマト』（沖女）『惑星大戦争』『サンダーバード』（ヱルトリウム）などのポスターを貼っている。初めて宇宙に出るとき、カズミ、コウイチロウともに1964年東京オリンピック開会式での日本選手団風の赤いブレザーを着用していた。"},{"spoiler":false,"text":"本編では終始標準語で喋っているが、庵野執筆のコミックでは南大阪出身という注釈つきで少しだけ関西弁を披露している。"},{"spoiler":false,"text":"名前は先述のとおり樋口真嗣の夫人で、スタジオジブリ作品においてハーモニー処理を手掛ける高屋法子から。"}],"source":"bangumi","sourceCharacterId":"3174"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5de66861751b95095b56421d2040f7b9e878a67162aa95dded447ca54a4457d1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c282d48e37e7ac46648910f419691d94c154451ccd68ff61ac89a2782be3f81.webp","width":154,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p292","sourceCompanyId":"egs:brand:447","canonicalEntityId":"vndb:p292","name":"GAINAX","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:6552:447","source":"egs"},{"companyId":"vndb:p292","sourceCompanyId":"vndb:p292","canonicalEntityId":"vndb:p292","name":"株式会社ガイナックス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:115466:v43243","source":"vndb"},{"companyId":"vndb:p292","sourceCompanyId":"vndb:p292","canonicalEntityId":"vndb:p292","name":"株式会社ガイナックス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:115467:v43243","source":"vndb"},{"companyId":"vndb:p292","sourceCompanyId":"vndb:p292","canonicalEntityId":"vndb:p292","name":"株式会社ガイナックス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:115468:v43243","source":"vndb"},{"companyId":"vndb:p292","sourceCompanyId":"vndb:p292","canonicalEntityId":"vndb:p292","name":"株式会社ガイナックス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:115469:v43243","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing"],"source":"terminal-wiki-full-runtime-v7"}}
