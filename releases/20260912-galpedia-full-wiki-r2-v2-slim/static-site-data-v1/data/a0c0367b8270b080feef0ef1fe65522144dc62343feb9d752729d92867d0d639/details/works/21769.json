main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【元、陸上部のエース】"},{"spoiler":false,"text":"本名、河原木悠希（かわらぎ・ゆうき）"},{"spoiler":false,"text":"埼玉県の学校に通う女子校生。"},{"spoiler":false,"text":"陸上部のエースだが、大会前に大きな怪我をしてしまい、将来への不安を抱えている。"},{"spoiler":false,"text":"さっぱりした強気な性格で、正義感が強い。"},{"spoiler":false,"text":"「…ごめん、そういうの無理。　援交とか、ほんと考えられない」"}],"source":"egs","sourceCharacterId":"6580","sourceWorkId":"21769","spoiler":false},{"segments":[{"spoiler":false,"text":"河原木 悠希 （かわらぎ ゆうき）　CV：くすはらゆい"},{"spoiler":false,"text":"性格爽朗刚强，有着强烈正义感的女孩。"},{"spoiler":false,"text":"虽然是田径部的王牌，但由于在大赛前意外受伤而变得对将来的生涯感到不安。"}],"source":"bangumi","sourceCharacterId":"33282"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0ed7942274294b77bffcfe18c7ca83c25be7859313861560012ff47a90ba699a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/1363e550274c623fb112705385703edddc390d6376f7ff6b12ec4b521bfc8eac.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原舞","creatorId":"vndb:s985","sourcePersonId":"vndb:s985","canonicalEntityId":"vndb:s985","name":"石原 舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:129662:33282:13372:1","source":"bangumi"}]},{"characterId":"char_c32141","characterName":"Pako (パコ)","sourceIds":{"bangumi":[{"characterId":"33281","match":"exact-normalized-name-in-linked-work","subjectId":"129662"}],"egsCharacterIds":["6581"],"vndbCharacterId":"c32141"},"originalCharacterName":"Pako (パコ)","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【援交で生活する女の子】"},{"spoiler":false,"text":"本名、美月真子（みづき・まこ）"},{"spoiler":false,"text":"悠希の中学生の頃の同級生。"},{"spoiler":false,"text":"学校を中退し、渋谷を拠点に、援交で日々暮らしている女の子。"},{"spoiler":false,"text":"通称「ヤリマン・パコちゃん」"},{"spoiler":false,"text":"要領の悪さから、幼い頃からいじめられていた。"},{"spoiler":false,"text":"唯一の親友である悠希によく庇ってもらっており、そのことをいまでも深く感謝している。"},{"spoiler":false,"text":"「わたし、住所ふてーだし。　それにバカだから、普通のお仕事できないんだよね…」"}],"source":"egs","sourceCharacterId":"6581","sourceWorkId":"21769","spoiler":false},{"segments":[{"spoiler":false,"text":"美月 真子 （みつき まこ）　CV：鶴屋春人"},{"spoiler":false,"text":"和悠希是中学时的同级生。 以涉谷为据点生活的女孩子。"},{"spoiler":false,"text":"对于庇护着笨手笨脚的自己的悠希，至今都在心里深深地感谢着。"}],"source":"bangumi","sourceCharacterId":"33281"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1e4e5de455bfd18b146a2db248646ef997c447149071d5979d90ac07149715d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0f3640467f6bd36df4c3288b55d1a5555d37a8de102abf5319b7233517e4687.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"尾崎未來","creatorId":"vndb:s986","sourcePersonId":"vndb:s986","canonicalEntityId":"vndb:s986","name":"尾崎 未來","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:129662:33281:13776:1","source":"bangumi"}]},{"characterId":"char_c47655","characterName":"桐生 レイド","sourceIds":{"bangumi":[{"characterId":"33284","match":"exact-normalized-name-in-linked-work","subjectId":"129662"}],"egsCharacterIds":["6582"],"vndbCharacterId":"c47655"},"originalCharacterName":"桐生 レイド","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},