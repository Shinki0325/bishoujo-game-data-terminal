{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"15578","model":{"presentationWorkId":"vndb:v7616","staff":{"artwork":[{"creditedName":"SASAYUKi(ささゆき)","creatorId":"vndb:s3211","sourcePersonId":"egs:creator:13170","canonicalEntityId":"vndb:s3211","name":"SASAYUKi(ささゆき)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:97873","source":"egs"},{"creditedName":"ZOL","creatorId":"vndb:s711","sourcePersonId":"egs:creator:2285","canonicalEntityId":"vndb:s711","name":"ZOL","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:97874","source":"egs"},{"creditedName":"すめらぎ琥珀","creatorId":"vndb:s619","sourcePersonId":"egs:creator:1901","canonicalEntityId":"vndb:s619","name":"すめらぎ琥珀","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:97875","source":"egs"}],"scenario":[{"creditedName":"ZEQU(壱里塚不空、睦月弓弦、ののじ)","creatorId":"vndb:s641","sourcePersonId":"egs:creator:2033","canonicalEntityId":"vndb:s641","name":"ZEQU(壱里塚不空、睦月弓弦、ののじ)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:97884","source":"egs"},{"creditedName":"フレーム","creatorId":"vndb:s621","sourcePersonId":"egs:creator:1565","canonicalEntityId":"vndb:s621","name":"フレーム","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:97885","source":"egs"},{"creditedName":"栗栖","creatorId":"vndb:s720","sourcePersonId":"egs:creator:2594","canonicalEntityId":"vndb:s720","name":"栗栖","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:97886","source":"egs"}],"music":[],"other":[{"creditedName":"EDEN","creatorId":"vndb:s536","sourcePersonId":"egs:creator:15521","canonicalEntityId":"vndb:s536","name":"EDEN","detail":"監督、企画、原作、演出","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:97883","source":"egs"},{"creditedName":"EDEN","creatorId":"vndb:s536","sourcePersonId":"vndb:s536","canonicalEntityId":"vndb:s536","name":"EDEN","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:72102","source":"vndb"},{"creditedName":"EDEN","creatorId":"vndb:s536","sourcePersonId":"vndb:s536","canonicalEntityId":"vndb:s536","name":"EDEN","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:72103","source":"vndb"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:72104","source":"vndb"},{"creditedName":"ZEQU","creatorId":"vndb:s641","sourcePersonId":"vndb:s641","canonicalEntityId":"vndb:s641","name":"ZEQU","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:72108","source":"vndb"},{"creditedName":"巫浄 スウ","creatorId":"vndb:s644","sourcePersonId":"vndb:s644","canonicalEntityId":"vndb:s644","name":"巫浄 スウ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:72109","source":"vndb"}]},"cast":[{"characterId":"char_c28815","characterName":"黄龍","sourceIds":{"bangumi":[{"characterId":"92026","match":"exact-normalized-name-in-linked-work","subjectId":"266101"},{"characterId":"92026","match":"exact-normalized-name-in-linked-work","subjectId":"303919"}],"egsCharacterIds":["9965"],"vndbCharacterId":"c28815"},"originalCharacterName":"黄龍","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"透き通るような白い肌に、美しい銀髪の少女ながら、東京に強大な勢力を誇る麻薬組織「12天使」の女ボス。"},{"spoiler":false,"text":"「12天使」のボスだった父親に幼い頃から暗殺術を仕込まれ、六歳のときに敵対する組織の幹部の暗殺に成功し、以後、数々の修羅場を潜り抜けてきた。"},{"spoiler":false,"text":"自分の父親さえも10歳のときに暗殺して組織を乗っ取ると、優れた手腕を発揮し、飛躍的に組織を成長させた。"}],"source":"egs","sourceCharacterId":"9965","sourceWorkId":"4842","spoiler":false},{"segments":[{"spoiler":false,"text":"東京に強大な勢力を持つ「12天使」と呼ばれる麻薬組織のボス。"},{"spoiler":false,"text":"透き通るような白い肌に銀髪のエキゾチックな美少女。"},{"spoiler":false,"text":"暗器の達人。"},{"spoiler":false,"text":"「12天使」のボスであった父親に、幼い頃からあらゆる暗殺術を叩き込まれており、6歳の時に敵対する組織の幹部を暗殺したのを始めに数え切れない修羅場を生きてきた。"},{"spoiler":false,"text":"10歳の時に父親を殺して組織を乗っ取ると、飛躍的に組織を成長させて現在の勢力まで育てあげた。"},{"spoiler":false,"text":"特務捜査官であったレイと風子を捕らえ、触手調教を施し十二天使の恐怖を特捜課に解らせようと思っていたが最後の締めの調教を施そうとした最中に、特捜課に強襲され彼女達を奪還されてしまう。"},{"spoiler":false,"text":"また片腕であった趙紫煙は黄龍を庇い瀕死の重傷をおうも彼女を逃がす。"},{"spoiler":false,"text":"命辛々逃げ切ることが出来た黄龍だったが、部下の反乱にあい十二天使のボスの座を追われる。"}],"source":"egs","sourceCharacterId":"9965","sourceWorkId":"15578","spoiler":false},{"segments":[{"spoiler":false,"text":"東京に強大な勢力を持つ 『12天使』 と呼ばれる麻薬組織のボス。"},{"spoiler":false,"text":"透き通るような白い肌に銀髪の、エキゾチックな美少女。"},{"spoiler":false,"text":"暗器の達人。『12天使』 のボスであった父親に、幼い頃からあらゆる暗殺術を叩き込まれており、6歳の時に敵対する組織の幹部を暗殺したのを始めに、数え切れないほどの修羅場をくぐってきた。"},{"spoiler":false,"text":"10歳の時に父親を殺して組織を乗っ取ると、飛躍的に組織を成長させて現在の勢力まで育てあげた。"},{"spoiler":false,"text":"特務捜査官であったレイと風子を捕らえ、触手調教を施し 『12天使』 の恐怖を特捜課に分からせようと思っていたが、最後の締めの調教を施そうとした最中に特捜課に強襲され、彼女たちを奪還されてしまう。"},{"spoiler":false,"text":"また片腕であった趙紫煙は黄龍を庇い、瀕死の重傷を負うも彼女を逃がす。"},{"spoiler":false,"text":"命からがら逃げ切ることが出来た黄龍だったが、部下の反乱にあい 『12天使』 のボスの座を追われる。"}],"source":"bangumi","sourceCharacterId":"92026"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c80de0096f65d61b8c5f921988e764bdad0cc49b22da91089d39be4f0b8dc1fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6df1e085b7694a23b5585771479115fdd450a307ee04fd92a2866dacf133c96.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:303919:92026:6409:1","source":"bangumi"}]},{"characterId":"char_c29711","characterName":"イスカ","sourceIds":{"bangumi":[{"characterId":"14648","match":"exact-normalized-name-in-linked-work","subjectId":"259337"},{"characterId":"14648","match":"exact-normalized-name-in-linked-work","subjectId":"303919"}],"egsCharacterIds":["9962"],"vndbCharacterId":"c29711"},"originalCharacterName":"イスカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『魔法少女イスカ 外伝』に登場のヒロイン。"},{"spoiler":false,"text":"異世界フィオルシカアジルの魔法使いにより生み出された人工生命＝魔法少女。"},{"spoiler":false,"text":"その体内に埋め込まれた魔王の魔力のカケラ＝魔石の力と魔導機関サテュルメ・マグネシアを用い変身する。"},{"spoiler":false,"text":"この世界に訪れたのは最近のことで、その情報や生活習慣については疎い。"},{"spoiler":false,"text":"魔族から魔石を守るために他者を寄せ付けない頑なな態度をとっているが、偶然であった少女、柏木つみきとの生活を続ける間に徐々にこの世界に興味を示し、やがてそれはひとつの決意へ繋がることになる。"},{"spoiler":false,"text":"最近になってできた好物はオニギリ。"}],"source":"egs","sourceCharacterId":"9962","sourceWorkId":"13200","spoiler":false},{"segments":[{"spoiler":false,"text":"魔女の中でもイレギュラーである風と炎の2種類の魔力を宿した最強の魔女。"},{"spoiler":false,"text":"以前は人間として希薄であったが、様々な出会いと離別を、そして約束を経て一人の”人間”に成長を果たす。"},{"spoiler":false,"text":"大事な”姉”と”友達”との約束を果たすため、人間に仇なす魔女狩りを狩る魔女、”魔女狩り殺し”となって、人類を守護する事を誓う。"},{"spoiler":false,"text":"この度、風の噂で聞いた自分とは別の意味で”特異な”魔女の存在を知り、単独で逢うために街を後にする。"},{"spoiler":false,"text":"その僅かな間隙で幕間劇が始まる事になる。"}],"source":"egs","sourceCharacterId":"9962","sourceWorkId":"15578","spoiler":false},{"segments":[{"spoiler":false,"text":"異世界フィオルシカアジルの魔法使いにより生み出された人工生命＝魔法少女。"},{"spoiler":false,"text":"その体内に埋め込まれた魔王の魔力のカケラ＝魔石の力と魔導機関サテュルメ・マグネシアを用い変身する。"},{"spoiler":false,"text":"この世界に訪れたのは最近のことで、その情報や生活習慣については疎い。"},{"spoiler":false,"text":"魔族から魔石を守るために他者を寄せ付けない頑なな態度をとっているが偶然であった少女、柏木つみきとの生活を続ける間に徐々にこの世界に興味を示し、やがてそれはひとつの決意へ繋がることになる。"},{"spoiler":false,"text":"最近になってできた好物はオニギリ。"}],"source":"bangumi","sourceCharacterId":"14648"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16c23954f61605163c48372b3dbda3b85333ac6c8df61906c36f6c30d1463465.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de690b8635eeae6d0928fa358c687fab3909580662862a981dca34e684df4744.webp","width":126,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澄白 キヨカ","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40478","source":"vndb"}]},{"characterId":"char_c29921","characterName":"國東 清華・エクィテス","sourceIds":{"bangumi":[{"characterId":"44626","match":"exact-normalized-name-in-linked-work","subjectId":"303919"}],"egsCharacterIds":["9966"],"vndbCharacterId":"c29921"},"originalCharacterName":"國東 清華・エクィテス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The dark-skinned heroine of this work, who attends Santo Academy."},{"spoiler":false,"text":"She is a young lady from a good family who lives in a large mansion with maids and butlers."},{"spoiler":false,"text":"Kunisaki has the blood of an excellent exorcist (demon exorcist) in her veins, so much so that an Indian aristocrat was once bought by the British royal family and welcomed into the aristocracy. The family has a long line of demon exorcisers who have exorcised demons in Japan for generations. Seika is the most powerful of her family. She used her powers to leave Japan and become an exorcist based in England. She uses the Misericorde dagger, a sword blessed by the cathedral, as her weapon."},{"spoiler":false,"text":"She is older than Ryusuke and is a returnee."},{"spoiler":false,"text":"She was born in Japan, but spent a long time as an aristocrat there, so she is quite selfish, arrogant, and proud. She behaves condescendingly, especially towards Ryusuke, because they are in a master-servant relationship. She doesn't mind her servants seeing her skin, and often makes Ryusuke help her get changed and take a bath."},{"spoiler":false,"text":"Her good looks make her popular with the boys at school. Many people like being treated harshly by beautiful women, and as the granddaughter of the Yamato Academy's owner, she is nicknamed Seika-sama."},{"spoiler":false,"text":"Although she would normally choose a partner when she gets her first period, known as the Fertilizer who will replenish her spiritual power, she has yet to decide on one, and it seems her grandfather, the head of the family, is trying to decide for her without her permission."},{"spoiler":false,"text":"She does not like the master-servant relationship between Ryusuke and Umihime, and has been growing increasingly irritated since Umihime appeared."}],"source":"vndb","sourceCharacterId":"c29921"},{"segments":[{"spoiler":false,"text":"山都学園に通う本作の褐色ヒロイン。"},{"spoiler":false,"text":"メイドや執事がいるような大きな館に住む良家のお嬢様。"},{"spoiler":false,"text":"古くから日本でも代々鬼を駆逐してきた鬼やらいの家系。"},{"spoiler":false,"text":"清華は一族の中でも飛び抜けて強い力の持ち主。その実力を生かして日本を離れ、イギリスを拠点にエクソシストとして活躍していた。"},{"spoiler":false,"text":"聖堂で祝福を受けた短剣ミセリコルデを武器とする。"},{"spoiler":false,"text":"龍介より年上の先輩で、帰国子女。"},{"spoiler":false,"text":"日本生まれだが向こうでの貴族生活が長かったためか、かなり我が儘で高飛車、プライドも高い。"},{"spoiler":false,"text":"特に龍介など主従の関係なので見下した態度を取る。"},{"spoiler":false,"text":"従者には肌を見られても平気ならしく、着替えや風呂に入るのを龍介に手伝わせたりする。"},{"spoiler":false,"text":"容姿端麗なので学校では男子に人気あり。"},{"spoiler":false,"text":"美人にきつい態度で接されるのがいいという輩も多く、山都学園の経営者の孫ということもあって清華様と呼ばれている。"}],"source":"egs","sourceCharacterId":"9966","sourceWorkId":"15578","spoiler":false},{"segments":[{"spoiler":false,"text":"山都学園に通う少女。メイドや執事がいるような大きな館に住む良家のお嬢様。"},{"spoiler":false,"text":"國東には、昔インドの貴族がその腕をイギリス王室に買われ貴族として迎え入れられたほどの優秀なエクソシスト （鬼やらい＝退魔師） の血が入っている。古くから日本でも代々鬼を駆逐してきた鬼やらいの家系。"},{"spoiler":false,"text":"清華は一族の中でも飛び抜けて強い力の持ち主。その実力を活かして日本を離れ、イギリスを拠点にエクソシストとして活躍していた。"},{"spoiler":false,"text":"聖堂で祝福を受けた短剣ミセリコルデを武器とする。"},{"spoiler":false,"text":"主人公・龍介より年上の先輩で、帰国子女。日本生まれだが向こうでの貴族生活が長かったためか、かなりワガママで高飛車、プライドも高い。特に龍介など主従の関係なので見下した態度を取る。"},{"spoiler":false,"text":"従者には肌を見られても平気らしく、着替えや風呂に入るのを龍介に手伝わせたりする。"},{"spoiler":false,"text":"容姿端麗なので学園では男子に人気あり。美人にきつい態度で接されるのがいいという輩も多く、山都学園の経営者の孫ということもあって清華様と呼ばれている。"},{"spoiler":false,"text":"本来なら初潮を迎える頃に選ぶはずの、自身に霊力を補給してくれる “精授の者” と呼ばれるパートナーを未だ決めておらず、当主である祖父に勝手に決められそうになっている。"},{"spoiler":false,"text":"龍介と海姫が主従関係であることをよく思っておらず、海姫が現れてからはイライラが募っている様子。"}],"source":"bangumi","sourceCharacterId":"44626"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/3902f56efad4417484774f0e086fc8aa6877657c881480d2a82ea3cc885d1154.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7616794f54003a67d5df56300b8bfd98b5ff5d1ab3c94a9607ccf934dc8d899.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤 遼佳","creatorId":"vndb:s564","sourcePersonId":"vndb:s564","canonicalEntityId":"vndb:s564","name":"ミルノ 純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40480","source":"vndb"}]},{"characterId":"char_c29922","characterName":"海姫","sourceIds":{"bangumi":[{"characterId":"44627","match":"exact-normalized-name-in-linked-work","subjectId":"303919"}],"egsCharacterIds":["9967"],"vndbCharacterId":"c29922"},"originalCharacterName":"海姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作のサブヒロイン。"},{"spoiler":false,"text":"美女の姿をしているが高位の鬼。生き物の血を糧とする吸血種。"},{"spoiler":false,"text":"旧南風家の蔵に封印されていたのを解き放たれる。"},{"spoiler":false,"text":"封印を解いて貰ったせいか、龍介を主と呼び従う。"},{"spoiler":false,"text":"龍介が清華と主従の関係にあるのが不満。"},{"spoiler":false,"text":"龍介の傍いるのは自分だと思っていて、いつか清華を食ってやろうと密かに企んでいる。"},{"spoiler":false,"text":"普段はあまり口数の多い方ではないが、龍介に危険が及ぶと高位の鬼としての力を解放して仲間である鬼を蹴散らす。"},{"spoiler":false,"text":"龍介を守るためなら自身の消滅すらいとわない、強い思いを持つ鬼。"},{"spoiler":false,"text":"龍介に触れて貰うのを最上の悦びとする。"},{"spoiler":false,"text":"龍介を助けはするがその対価を必要とし、龍介の精液を求める。"},{"spoiler":false,"text":"拒むと鋭い爪を突き付けて殺すと脅しながら、強制的に精液を奪い取る。"}],"source":"egs","sourceCharacterId":"9967","sourceWorkId":"15578","spoiler":false},{"segments":[{"spoiler":false,"text":"美女の姿をしているが高位の鬼。生き物の血を糧とする吸血種。"},{"spoiler":false,"text":"旧南風家の蔵に封印されていたのを解き放たれる。封印を解いてもらったせいか、龍介を主と呼び従う。"},{"spoiler":false,"text":"龍介が清華と主従の関係にあるのが不満。龍介の傍らにいるのは自分だと思っていて、いつか清華を食ってやろうと密かに企んでいる。"},{"spoiler":false,"text":"普段はあまり口数の多いほうではないが、龍介に危険が及ぶと高位の鬼としての力を解放して仲間である鬼を蹴散らす。龍介を守るためなら自身の消滅すらいとわない、強い思いを持つ鬼。"},{"spoiler":false,"text":"龍介に触れてもらうのを最上の悦びとする。"},{"spoiler":false,"text":"龍介を助けはするがその対価を必要とし、龍介の精液を求める。"},{"spoiler":false,"text":"拒むと鋭い爪を突き付けて殺すと脅しながら、強制的に精液を奪い取る。"}],"source":"bangumi","sourceCharacterId":"44627"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38f433ac04df61c94762b60da40a2b01d25457a2fc25f18c762de64c77ea114e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef7e699f906c05f9aea216e8ba1f8553dc8a594cc28b4add46b5664b82d097a1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊木 春乃","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"sour