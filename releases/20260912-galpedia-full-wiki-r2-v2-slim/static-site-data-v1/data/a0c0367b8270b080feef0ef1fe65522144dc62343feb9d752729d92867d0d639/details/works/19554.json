tyStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【ハゲタカを気取る者】"},{"spoiler":false,"text":"投資ファンド【ワールド・クリエイティブ・パートナーズ】代表。"},{"spoiler":false,"text":"幸人とは顔なじみで、かつて同じ職場にいたこともある。"},{"spoiler":false,"text":"現在はライバル的関係。"},{"spoiler":false,"text":"巳浦銀行退職後一時期職を転々としていたが紆余曲折を経て【ワールド・クリエイティブ】およびその資産運用会社である【ワールド・クリエイティブ・パートナーズ】を立ち上げ、いわゆる二次バルクを買い漁って90年代の外資系ファンドのようにハゲタカのごとき振る舞いを見せる。"},{"spoiler":false,"text":"金の力で他人を屈服させるのが大好きな男。"}],"source":"egs","sourceCharacterId":"2128","sourceWorkId":"19554","spoiler":false},{"segments":[{"spoiler":false,"text":"投資ファンド・ ワールド・クリエイティブ・パートナーズ代表。"},{"spoiler":false,"text":"幸人とは顔なじみで、かつて同じ職場にいたこともある。現在はライバル的関係。"},{"spoiler":false,"text":"巳浦銀行退職後一時期職を転々としていたが、紆余曲折を経てワールド・クリエイティブ、およびその資産運用会社であるワールド・クリエイティブ・パートナーズを立ち上げ、いわゆる二次バルクを買い漁って90年代の外資系ファンドのようにハゲタカのごとき振る舞いを見せる。"},{"spoiler":false,"text":"金の力で他人を屈服させるのが大好きな男。"}],"source":"bangumi","sourceCharacterId":"91136"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/622cf444f0ae7199c0b8aa8b5d3c5e9120496e94d37d4e05eb92aa95a7fe4086.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d3df3fda64db2db3f491c056d3c0082d72a6da7e07f9c09b2f2307f80b00a07.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c112945","characterName":"ケイン＝ポートタウン","sourceIds":{"bangumi":[{"characterId":"91137","match":"exact-normalized-name-in-linked-work","subjectId":"223384"},{"characterId":"91137","match":"exact-normalized-name-in-linked-work","subjectId":"83266"}],"egsCharacterIds":["2129"],"vndbCharacterId":"c112945"},"originalCharacterName":"ケイン＝ポートタウン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【城島の右腕】"},{"spoiler":false,"text":"外資ファンド【M&Cカンパニー・ジャパン】の元代表で、現在は【ワールド・クリエイティブ・パートナーズ】取締役員の一人。"},{"spoiler":false,"text":"城島の右腕的存在の男。"},{"spoiler":false,"text":"【M&C】が日本からの撤退を決め、ケインもニューヨーク本社へと呼び戻されることになったが、日本に住んでいた期間が長く、すっかり日本人として成長している娘のためにもニューヨークへ戻ることを躊躇していた矢先、日本語が流暢な点やその能力を買われて城島の補佐を努めることに。"},{"spoiler":false,"text":"家族想いで、休日はなるべく娘と過ごしたいと思っているが忙しくて時間が取れず、頭を悩ませている。"}],"source":"egs","sourceCharacterId":"2129","sourceWorkId":"19554","spoiler":false},{"segments":[{"spoiler":false,"text":"外資ファンド・M＆Cカンパニー・ジャパンの元代表で、現在はワールド・クリエイティブ・パートナーズ取締役員の一人。城島の右腕的存在の男。"},{"spoiler":false,"text":"M＆Cが日本からの撤退を決め、ケインもニューヨーク本社へと呼び戻されることになったが、日本に住んでいた期間が長く、すっかり日本人として成長している娘のためにもニューヨークへ戻ることを躊躇していた。"},{"spoiler":false,"text":"その矢先、日本語が流暢な点やその能力を買われて城島の補佐を努めることに。"},{"spoiler":false,"text":"家族想いで、休日はなるべく娘と過ごしたいと思っているが忙しくて時間が取れず、頭を悩ませている。"}],"source":"bangumi","sourceCharacterId":"91137"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4ec973860266db1cff0f187d0820f4204e71388bf4e9210ff3475ed988f702a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fef64ec28afe2907efd0a293ff063d7aa4fc533d26969df12ad3c52c9feffda0.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c112946","characterName":"高槻 正造","sourceIds":{"bangumi":[{"characterId":"91138","match":"exact-normalized-name-in-linked-work","subjectId":"223384"},{"characterId":"91138","match":"exact-normalized-name-in-linked-work","subjectId":"83266"}],"egsCharacterIds":["2130"],"vndbCharacterId":"c112946"},"originalCharacterName":"高槻 正造","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【巳浦銀行常務取締役】"},{"spoiler":false,"text":"巳浦銀行常務取締役で、