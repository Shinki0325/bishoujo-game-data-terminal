{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"7574","model":{"presentationWorkId":"vndb:v327","staff":{"artwork":[{"creditedName":"皇裕介(皇祐介)","creatorId":"vndb:s1982","sourcePersonId":"egs:creator:217","canonicalEntityId":"vndb:s1982","name":"皇裕介(皇祐介)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:17298","source":"egs"}],"scenario":[{"creditedName":"NATORI烏賊","creatorId":"vndb:s1983","sourcePersonId":"egs:creator:1201","canonicalEntityId":"vndb:s1983","name":"NATORI烏賊","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:17299","source":"egs"},{"creditedName":"シャア専用◎","creatorId":"vndb:s2261","sourcePersonId":"vndb:s2261","canonicalEntityId":"vndb:s2261","name":"シャア専用◎","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:8312","source":"vndb"}],"music":[{"creditedName":"武礼堂","creatorId":"vndb:s11707","sourcePersonId":"egs:creator:4049","canonicalEntityId":"vndb:s11707","name":"武礼堂","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:17323","source":"egs"}],"other":[{"creditedName":"皇 裕介","creatorId":"vndb:s1982","sourcePersonId":"vndb:s1982","canonicalEntityId":"vndb:s1982","name":"皇 裕介","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:8307","source":"vndb"},{"creditedName":"NATORI 烏賊","creatorId":"vndb:s1983","sourcePersonId":"vndb:s1983","canonicalEntityId":"vndb:s1983","name":"NATORI 烏賊","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:8310","source":"vndb"},{"creditedName":"NATORI 烏賊","creatorId":"vndb:s1983","sourcePersonId":"vndb:s1983","canonicalEntityId":"vndb:s1983","name":"NATORI 烏賊","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:8311","source":"vndb"}]},"cast":[{"characterId":"char_c41158","characterName":"駒形 里美","sourceIds":{"bangumi":[{"characterId":"12613","match":"exact-normalized-name-in-linked-work","subjectId":"20160"}],"egsCharacterIds":["25545"],"vndbCharacterId":"c41158"},"originalCharacterName":"駒形 里美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染で同級生の女の子。"},{"spoiler":false,"text":"明朗快活でありながら、思慮深い面も。"},{"spoiler":false,"text":"また、父親を早くに亡くし、母親とふたりきりで生きてきたこともあって、しっかりしている。"},{"spoiler":false,"text":"優しい性格と、可愛らしい容姿から学園の男子生徒から人気。"}],"source":"egs","sourceCharacterId":"25545","sourceWorkId":"7574","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼馴染であり、同級生の女の子。"},{"spoiler":false,"text":"とても明るく快活であると同時に思慮深さも持った性格。早くに父親を亡くして母親と二人だけで生きてきたので、苦労というものを知っているしっかり者。何かと主人公のことを気にかけている。"},{"spoiler":false,"text":"母親は『駒』という小料理屋をやっていて、彼女も手伝いをしている。学校では、水泳部に所属。その容貌と性格から、多くの男子生徒の憧れの的となっている。"}],"source":"bangumi","sourceCharacterId":"12613"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2cd04435cdfa9e93b1e9372bf2bd64156e0ecbec958c1776e2deb96098a9d92.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e932c2e89fb255b176fe5835624f7e4376a3540a993af205ab5381d6967b73a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20160:12613:4432:1","source":"bangumi"}]},{"characterId":"char_c41159","characterName":"及川 梨奈","sourceIds":{"bangumi":[{"characterId":"93567","match":"exact-normalized-name-in-linked-work","subjectId":"20160"}],"egsCharacterIds":["25546"],"vndbCharacterId":"c41159"},"originalCharacterName":"及川 梨奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の妹。"},{"spoiler":false,"text":"性格は勝気だが、面倒見が良い。"},{"spoiler":false,"text":"主人公にほのかな恋心を抱いており、少々焼きもちやき。"},{"spoiler":false,"text":"子供の頃に大好きな兄を苛めていた大宮弘道を嫌悪し、それは今でも変わらない。"}],"source":"egs","sourceCharacterId":"25546","sourceWorkId":"7574","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹で、負けん気の強い性格。"},{"spoiler":false,"text":"ずっと一緒にいて世話をしてもらっていたためか、恋愛感情に近いほどの気持ちで、兄のことを慕っていおり、少々焼もちやき。 子供の頃、兄をいじめていた大宮弘道のことをみんなの前で引っ叩いたことがあり、彼のことは今でも露骨に嫌っている。 家事手伝いは、主に彼女がおこなっており、世話好きで、兄の世話は全部自分がしたいと思っていますが…。"},{"spoiler":false,"text":"大人の女性である倉田加奈子に少しばかりコンプレックスをもっている。"}],"source":"bangumi","sourceCharacterId":"93567"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/987d3d5ef10d9d60d871e9fccb556b1431fe7da4f5aea6cd78f7c8fd6d1061c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15f3da7621f4fa29cb43f98a007268797f7994a41ae0e13f9e857b8ad2e74b40.webp","width":104,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20160:93567:4463:1","source":"bangumi"}]},{"characterId":"char_c41161","characterName":"倉田 加奈子","sourceIds":{"bangumi":[{"characterId":"93568","match":"exact-normalized-name-in-linked-work","subjectId":"20160"}],"egsCharacterIds":["25547"],"vndbCharacterId":"c41161"},"originalCharacterName":"倉田 加奈子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の家の診療所に勤めるナース。"},{"spoiler":false,"text":"美人で心優しく包容力があるることから、近所での評判も上々。"},{"spoiler":false,"text":"彼女を目当てに通院するオヤジもいるほど。"},{"spoiler":false,"text":"診療所の近くで暮らし、主人公らの姉代わりとなって、親身になって世話をしてくれる。"}],"source":"egs","sourceCharacterId":"25547","sourceWorkId":"7574","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の家の診療所に勤める、唯一の看護婦。"},{"spoiler":false,"text":"いつも他人を気にかけている優しいお姉さんで、包容力のある女性。 近所での評判も高く、彼女目当てで通院する親父たちもいるほど。 看護婦としての能力も高く、色々な意味で診療所になくてはならない人。"},{"spoiler":false,"text":"主人公たちの姉がわりとなって、よく世話をしてくれており、しばしば夕食も共にし、家族の一員のようになっている。 彼女自身は、近くのアパートで一人暮らし。"}],"source":"bangumi","sourceCharacterId":"93568"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f77dfda6259d333caace5582db0583b6d4783739968fd3985213ec7733e0d17a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c9eb14f4c1d28605883d88f12ebc717c05149f7a4005dbef74922e8cc13e465.webp","width":122,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20160:93568:4940:1","source":"bangumi"}]},{"characterId":"char_vndb_c41154","characterName":"及川 保","sourceIds":{"vndbCharacterId":"c41154"},"originalCharacterName":"及川 保","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/character