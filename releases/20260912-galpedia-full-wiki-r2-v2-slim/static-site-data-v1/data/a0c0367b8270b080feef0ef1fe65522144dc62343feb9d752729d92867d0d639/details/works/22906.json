:"exact-normalized-name-in-linked-work","subjectId":"149249"},{"characterId":"48209","match":"exact-normalized-name-in-linked-work","subjectId":"611389"}],"egsCharacterIds":["6199"],"vndbCharacterId":"c32433"},"originalCharacterName":"葛城 真理奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A talented girl and the protagonist's childhood friend. Has a sense of justice and strives to protect everyone from danger."},{"spoiler":false,"text":"In Kouyoku Senki ExS-Tia 2, she become the protagonist's girlfriend."}],"source":"vndb","sourceCharacterId":"c32433"},{"segments":[{"spoiler":false,"text":"本作のメインヒロイン。"},{"spoiler":false,"text":"黒髪ロングの才女で、心優しく人あたりもいいので同性異性問わず人気が高い。"},{"spoiler":false,"text":"健気かつ強い正義感を持っており、困っている人を放っておけない。"},{"spoiler":false,"text":"潜在能力の高さ故、エクスティアに変身して皆を守って戦うことになる。"}],"source":"egs","sourceCharacterId":"6199","sourceWorkId":"21403","spoiler":false},{"segments":[{"spoiler":false,"text":"前作でエクスティアへと変身して侵略者と闘い、退けた真理奈。"},{"spoiler":false,"text":"しかし新たな侵略者の罠に嵌ってしまい変身できなくなってしまう。"},{"spoiler":false,"text":"果たして再び戦えるようになるのか。"}],"source":"egs","sourceCharacterId":"6199","sourceWorkId":"22701","spoiler":false},{"segments":[{"spoiler":false,"text":"エクスティアとして異世界からの侵略に対して戦ってきたヒロイン。"},{"spoiler":false,"text":"心優しく、皆の為に戦う芯の強さをもっている。"},{"spoiler":false,"text":"少々やきもち焼きでもある。"},{"spoiler":false,"text":"主人公である創真の恋人であり、一緒の大学に通っている。"},{"spoiler":false,"text":"そろそろ将来のことについて考えたりしている。"}],"source":"egs","sourceCharacterId":"6199","sourceWorkId":"39845","spoiler":false},{"segments":[{"spoiler":false,"text":"黒髪ロングの才女で、主人公とは幼なじみ。"},{"spoiler":false,"text":"心優しく人当たりも良いので、同性異性問わず人気が高い。"},{"spoiler":false,"text":"健気で強い正義感を持っており、困っている人を放っておけない性分。"},{"spoiler":false,"text":"潜在能力の高さゆえ、エクスティアに変身して皆を守って戦うことになる。"}],"source":"bangumi","sourceCharacterId":"48209"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f950e3f5d15be4cb8786ea122557bf9dddd27913ed97fa36c0a83424eea149b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33ac0632a89226f5e3a040eca06da380b00f91d96abd64454caf330ba070553b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西口有香","creatorId":"vndb:s24","sourcePersonId":"vndb:s24","canonicalEntityId":"vndb:s24","name":"西口 有香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126145:48209:6592:1","source":"bangumi"}]},{"characterId":"char_c32435","characterName":"天久保 百合","sourceIds":{"bangumi":[{"characterId":"48211","match":"exact-normalized-name-in-linked-work","subjectId":"126145"},{"characterId":"48211","match":"exact-normalized-name-in-linked-work","subjectId":"149249"},{"characterId":"48211","match":"exact-normalized-name-in-linked-work","subjectId":"211904"}],"egsCharacterIds":["6200"],"vndbCharacterId":"c32435"},"originalCharacterName":"天久保 百合","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female scientist who developed the ExS-Tia System. Disguised as school nurse in Marina's school."}],"source":"vndb","sourceCharacterId":"c32435"},{"segments":[{"spoiler":false,"text":"容姿的には真理奈達より若く見えるが、実際は20代の若き天才科学者。"},{"spoiler":false,"text":"人間の持つ潜在的な能力を研究しており、異世界からの魔導帝国の侵攻に対抗する為にエクスティアシステムを完成させる。"},{"spoiler":false,"text":"適応者を探す為に保険医として学園に侵入しており、そこで真理奈達を見出す。"}],"source":"egs","sourceCharacterId":"6200","sourceWorkId":"21403","spoiler":false},{"segments":[{"spoiler":false,"text":"エクスティアシステムを開発した女科学者。"},{"spoiler":false,"text":"変身できなくなった真理奈の原因調査をしつつ、今回もリースとの戦いを始め、色々サポートする"}],"source":"egs","sourceCharacterId":"6200","sourceWorkId":"22701","spoiler":false},{"segments":[{"spoiler":false,"text":"エクスティアシステムを開発した女科学者。"},{"spoiler":false,"text":"マイペースながら、時折鋭い分析を見せる。毒舌家ではないが、基本的に人前なら躊躇するような言葉も平然と使う。エクスデバイスの調整や、敵の出現情報、学園内での保険の先生など、サポートに余念がない。"}],"source":"egs","sourceCharacterId":"6200","sourceWorkId":"25030","spoiler":false},{"segments":[{"spoiler":false,"text":"人間の持つ潜在的な能力を研究している天才科学者。"},{"spoiler":false,"text":"容姿的には真理奈たちよりも若く見えるが、実際は20代。"},{"spoiler":false,"text":"異世界より現れる魔導帝国の侵攻に対抗するため、エクスティアシステム を完成させた。"},{"spoiler":false,"text":"適応者を探すために保険医として学園に侵入しており、そこで真理奈を見い出す。"}],"source":"bangumi","sourceCharacterId":"48211"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/092da3195e792a92622ae1182d25d55eb3e6e43f3e3e64468ac14c245ae04f26.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eea041d78cd86428a28655425f8be12c6467758d271e1b6d23a26974df8db945.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126145:48211:10027:1","source":"bangumi"}]},{"characterId":"char_c52923","characterName":"創ちゃん","sourceIds":{"bangumi":[{"characterId":"146850","match":"exact-normalized-name-in-linked-work","subjectId":"611389"}],"egsCharacterIds":["28301"],"vndbCharacterId":"c52923"},"originalCharacterName":"創ちゃん","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Childhood friend of Katsuragi Marina, also attending the same school. A bit pervert and almost didn't having any purpose in live, but having kind of hot-blooded personality. Play role as Marina's supporter during battle."},{"spoiler":false,"text":"Translation from official site"}],"source":"vndb","sourceCharacterId":"c52923"},{"segments":[{"spoiler":false,"text":"主人公。"},{"spoiler":false,"text":"真理奈とは幼馴染で、侵略に対しては真理奈へのサポートを担当していた。"},{"spoiler":false,"text":"真理奈とはＨによってＰＰと呼ばれるエネルギー回復をすることができる。"},{"spoiler":false,"text":"恋人である真理奈と同じ大学に通っている。"}],"source":"egs","sourceCharacterId":"28301","sourceWorkId":"39845","spoiler":false},{"segments":[{"spoiler":false,"text":"ExS-TIAシステム発動後、ソーマも戦えるようになりました。しかしシステムのフィードバックにより、彼は女性になってしまう。"}],"source":"bangumi","sourceCharacterId":"146850"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2720201c3d4a4af8d3a1698cac994b3c898a7884f95a2997510492e882e8f2a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bd4c310046acb211e6d5fea0b0945601007e49f72d4babfeb408f8501b21b9b.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c52931","characterName":"アザリン","sourceIds":{"bangumi":[],"egsCharacterIds":["7519"],"vndbCharacterId":"c52931"},"originalCharacterName":"アザリン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daughter of Logilg (ローギルグ), Emperor of the Magic Empire \"Logia\". Inherit huge magical power."},{"spoiler":false,"text":"Translation from official site"}],"source":"vndb","sourceCharacterId":"c52931"},{"segments":[{"spoiler":false,"text":"魔導帝国皇帝の娘で、強大な魔力を持つ実力者。"},{"spoiler":false,"text":"基本的に我がままかつ楽しいことが好きという自由な性格で、"},{"spoiler":false,"text":"先遣隊の荷物に紛れて現代世界にやってきた。"},{"spoiler":false,"text":"侵攻の前に立ちふさがるエクスティアをライバル視し、"},{"spoiler":false,"text":"戦いを楽しみにする。"}],"source":"egs","sourceCharacterId":"7519","sourceWorkId":"21403","spoiler":false},{"segments":[{"spoiler":false,"text":"魔導帝国皇帝の娘ではあるが、現在は出奔し現代社会を色々愉しんでいる。"},{"spoiler":false,"text":"エクスティアを倒すという目的はあるが、明確な敵対をしてくるわけではない。"}],"source":"egs","sourceCharacterId":"7519","sourceWorkId":"22701","spoiler":false},{"segments":[{"spoiler":false,"text":"魔道帝国ロギアの皇帝の娘にして高い魔力を持つ魔導師。エクスティアとの戦いに敗れた後、皇帝の考えを知り帝国から離反。しかしエクスティアとの闘いを諦めたわけではなく常に復讐の機会を伺っている。"},{"spoiler":false,"text":"意外に生活順応力が高く、現代社会での正解においても溶け込みすっかり馴染んでいる。"},{"spoiler":false,"text":"そんな折に新たな敵が現れ、真理奈もリースも不在の中アザリンが戦うことになる"}],"source":"egs","sourceCharacterId":"7519","sourceWorkId":"25030","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/657fbc0755204359f07ba7483c6ccb8a291ccb42f0507fe21616bd1bc8410869.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/722030d6f9ff41b4f681410fdbac9db008d1892934e7f76848a5b1f72df16289.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤 さくら","creatorId":"vndb:s947","sourcePersonId":"vndb:s947","canonicalEntityId":"vndb:s947","name":"花澤 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:63565","source":"vndb"}]},{"characterId":"char_vndb_c32434","characterName":"エクスティア","sourceIds":{"vndbCharacterId":"c32434"},"originalCharacterName":"エクスティア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The form of Marina when she uses the PP (Physical Photon) Device to transform. Her physical abilities have been increased by tenfold, and she has the ability to destroy magical barriers and fight against the invaders from another world. Her weapon, Gunblade ExS-Saber, can also alternate forms between a sword and a gun."},{"spoiler":false,"text":"Special move: Photon Punisher."}],"source":"vndb","sourceCharacterId":"c32434"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/9851a94ac163d711108f4f597a9372725a523d6d6d616062b1ed08902b156522.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48b4b8f2e859223587702a257877fa80439c128522371c065f34ee044b9a3b3b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"葉村 夏緒","creatorId":"vndb:s24","sourcePersonId":"vndb:s24","canonicalEntityId":"vndb:s24","name":"西口 有香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:63563","source":"vndb"}]},{"characterId":"char_vndb_c53054","characterName":"ジネーヴラ・グレコ","sourceIds":{"vndbCharacterId":"c53054"},"originalCharacterName":"ジネーヴラ・グレコ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the Four General (四天王) of Magic Empire \"Logia\". Come from another world \"Carlon\" through \"Gate\", he leads the Empire Advance Team and start the invasion on Hojo City."},{"spoiler":false,"text":"Translation from official site"}],"source":"vndb","sourceCharacterId":"c53054"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5f76aa7cd94a1a10f6bf94199a34f85f32724b869f8fff3e0e9cfbdc9e7a43f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/915dadbd0905ad2a165e8329f3960ddd1b598d2fdb3873f8e5fa186ffd9c40b8.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p927","sourceCompanyId":"egs:brand:829","canonicalEntityId":"vndb:p927","name":"Lusterise","roleCo