bCharacterId":"c13710"},"originalCharacterName":"鳴風 みなも","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"721"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"source-only","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has practiced playing her harmonica for four years hoping for Makoto to return and keep his promise. Unlike Makoto, she takes their childhood promise seriously and wants to marry now that they are older. Throughout the game she is straightforward and assertive about her love for Makoto."},{"spoiler":false,"text":"From Wikipedia"},{"spoiler":true,"text":"Is the real sister of Hinata and Wakaba."}],"source":"vndb","sourceCharacterId":"c13710"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b8aab07c17a0c99817b6846d28fe11ee26fc7ef28a564633f30f4daa7a7965f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6be240e6c696eab691fcc43479e7bd1ae4fe272e9a4e4c17474ba58c45ebc80.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春野 日和","creatorId":"vndb:s1637","sourcePersonId":"vndb:s1637","canonicalEntityId":"vndb:s1637","name":"倖月 美和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:505","source":"vndb"}]},{"characterId":"char_vndb_c13711","characterName":"藤宮 望","sourceIds":{"vndbCharac