"name":"恋純 ほたる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:10387","source":"vndb"},{"creditedName":"永原 さくら","creatorId":"vndb:s4523","sourcePersonId":"vndb:s4523","canonicalEntityId":"vndb:s4523","name":"永原 さくら","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:10394","source":"vndb"},{"creditedName":"こだま さおり","creatorId":"vndb:s7729","sourcePersonId":"vndb:s7729","canonicalEntityId":"vndb:s7729","name":"こだま さおり","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:10395","source":"vndb"},{"creditedName":"くみはし 佑","creatorId":"vndb:s34397","sourcePersonId":"vndb:s34397","canonicalEntityId":"vndb:s34397","name":"くみはし 佑","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:10399","source":"vndb"}]},"cast":[{"characterId":"char_c33511","characterName":"深峰 莉子","sourceIds":{"bangumi":[{"characterId":"4279","match":"exact-normalized-name-in-linked-work","subjectId":"20705"}],"egsCharacterIds":["26687"],"vndbCharacterId":"c33511"},"originalCharacterName":"深峰 莉子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"16"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"607"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Riko is Haruhiko's younger sister in name, although they are the same age and are in the same class together in school after she enrolls. In third grade, she joined Haruhiko's family due to family circumstances and Haruhiko immediately treated her as if she really were his little sister. When they were younger, she left for several years, only to appear again one day out of the blue years later. The reason she returned was to be with Haruhiko as he is her first love and has continued to be in love with him. She is currently a second-year at Shimano Academy and shares the same class as Haruhiko."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c33511"},{"segments":[{"spoiler":false,"text":"主人公の同い年の妹。志摩野学園2年生。"},{"spoiler":false,"text":"同い年なのに主人公の事を“お兄ちゃん”と呼ぶ。"},{"spoiler":false,"text":"その理由は、幼い頃、莉子の事を子分扱いしたため。"},{"spoiler":false,"text":"主人公の母親の親戚に当たり、両親が共に亡くなってしまったため、主人公の家へと引き取られた。"},{"spoiler":false,"text":"一時期は離ればなれになっていたが、このほど晴れて、再び同居する事になった。"},{"spoiler":false,"text":"性格的には強気系で世話焼き型。素直じゃなく、主人公への好意（というか、好きという感情）はかたくなに隠そうとする。"},{"spoiler":false,"text":"ただ、主人公以外に対しては、愛想のいい人柄。"},{"spoiler":false,"text":"また、自身が置かれた境遇から、微妙に下手に出たり、相手の機嫌を窺ったりする態度を取ってしまう。"},{"spoiler":false,"text":"自分でも気にしているのだが、なかなか直らない。"}],"source":"egs","sourceCharacterId":"26687","sourceWorkId":"4570","spoiler":false},{"segments":[{"spoiler":false,"text":"春彦母方亲戚的女儿，小时候被托付给天海家，从那时开始就称春彦成为“哥哥”。后因春彦爸爸的事业失败而离开，几年后回到了现在的天海家，成为楢崎町志摩野学园的二年级学生。性格要强懂得关心人，不过很不坦率，把自己对主人公的好意埋藏在心中。"}],"source":"bangumi","sourceCharacterId":"4279"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"26687","sourceWorkId":"4570","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"26687","sourceWorkId":"4570","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"26687","sourceWorkId":"4570","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"26687","sourceWorkId":"4570","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"45 kg","valueContext":null,"source":"egs","sourceCharacterId":"26687","sourceWorkId":"4570","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5981ff93f6be3badeccb616f3442923c3715b5459fa28f620f604e9e33af0b3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/2913e6511e83dda8e4761d761c9500c28cde9f94e4ed9aed94836865e9cadecd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"清水愛","creatorId":"vndb:s416","sourcePersonId":"vndb:s416","canonicalEntityId":"vndb:s416","name":"清水 愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20705:4279:4064:1","source":"bangumi"},{"creditedName":"さくらりの","creatorId":"vndb:s18165","sourcePersonId":"vndb:s18165","canonicalEntityId":"vndb:s18165","name":"さくらりの","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:4505","source":"vndb"}]},{"characterId":"char_c33512","characterName":"木之坂 霧乃","sourceIds":{"bangumi":[{"characterId":"21991","match":"exact-normalized-name-in-linked-work","subjectId":"20705"}],"egsCharacterIds":["26688"],"vndbCharacterId":"c33512"},"originalCharacterName":"木之坂 霧乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"14"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1015"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kirino is Haruhiko's childhood friend and next door neighbor. They are such good friends that she often comes over to his house in the mornings before school to not only wake him up, but also to make him breakfast. She tends to be the unfortunate receiver of much of Haruhiko's teasing due to her timid nature, though she does not mind it much, as she is in love with Haruhiko. She is one year younger than Haruhiko and is a first-year student at Shimano Academy."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c33512"},{"segments":[{"spoiler":false,"text":"主人公の幼なじみ。志摩野学園1年生。"},{"spoiler":false,"text":"主人公より一つ年下である。"},{"spoiler":false,"text":"幼なじみという事で、ずっと一緒に居た。"},{"spoiler":false,"text":"だが、二人の間に莉子が登場した事によって、三角関係のような形となる。"},{"spoiler":false,"text":"主人公の事がとっても大好きで、主人公以外の異性は苦手だ。"},{"spoiler":false,"text":"やや引っ込み思案なところがあり、おしとやかな性格をしている。"},{"spoiler":false,"text":"霧乃にとって、かつて莉子が主人公の家に引き取られた事は、それまで独り占めにしていた主人公を失ってしまった事を意味していた。"},{"spoiler":false,"text":"そして再び莉子がやって来て、霧乃の心中は穏やかではなくなるが……。"},{"spoiler":false,"text":"ピアノが趣味で、千紗とは大の仲良しである。"}],"source":"egs","sourceCharacterId":"26688","sourceWorkId":"4570","spoiler":false},{"segments":[{"spoiler":false,"text":"木之坂 霧乃 （このさか きりの）　CV：榊原ゆい"},{"spoiler":false,"text":"主人公の幼なじみ。志摩野学園１年生。"},{"spoiler":false,"text":"主人公より一つ年下である。幼なじみという事で、ずっと一緒に居た。だが、二人の間に莉子が登場した事によって、三角関係のような形となる。主人公の事がとっても大好きで、主人公以外の異性は苦手だ。やや引っ込み思案なところがあり、おしとやかな性格をしている。"},{"spoiler":false,"text":"霧乃にとって、かつて莉子が主人公の家に引き取られた事は、それまで独り占めにしていた主人公を失ってしまった事を意味していた。そして再び莉子がやって来て、霧乃の心中は穏やかではなくなるが……。 ピアノが趣味で、千紗とは大の仲良しである。"},{"spoiler":false,"text":"「いつまでも……一緒だよ」"}],"source":"bangumi","sourceCharacterId":"21991"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"26688","sourceWorkId":"4570","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"26688","sourceWorkId":"4570","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"26688","sourceWorkId":"4570","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"26688","sourceWorkId":"4570","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"40 kg","valueContext":null,"source":"egs","sourceCharacterId":"26688","sourceWorkId":"4570","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13c336858eb62aa6a9e2ef806098aa6d78b7a61b83ce18c47608d6f402e5a331.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b54b94b0d5280c1ad408a7aa618f6bdfc0e948bd5a3a50ca9739ef68ed629b50.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊原ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20705:21991:4916:1","source":"bangumi"},{"creditedName":"宮崎 羽衣","creatorId":"vndb:s273","sourcePersonId":"vndb:s273","canonicalEntityId":"vndb:s273","name":"宮崎 羽衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:4494","source":"vndb"}]},{"characterId":"char_c33513","characterName":"藤宮 千紗","sourceIds":{"bangumi":[{"characterId":"21993","match":"exact-normalized-name-in-linked-work","subjectId":"20705"}],"egsCharacterIds":["26690"],"vndbCharacterId":"c33513"},"originalCharacterName":"藤宮 千紗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"15"},"birt