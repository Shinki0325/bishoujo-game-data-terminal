をしているくらいだ。"},{"spoiler":false,"text":"「そ。わたしってお嬢様だったんだよ」"}],"source":"bangumi","sourceCharacterId":"21993"}],"profileFacts":[{"label":"胸围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"26690","sourceWorkId":"4570","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"153 cm","valueContext":null,"source":"egs","sourceCharacterId":"26690","sourceWorkId":"4570","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"26690","sourceWorkId":"4570","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"26690","sourceWorkId":"4570","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"40 kg","valueContext":null,"source":"egs","sourceCharacterId":"26690","sourceWorkId":"4570","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d78e1aec9b4f0a062e420392b671773ba30efcdcf973f07e91fbfa1ada69141a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da3edbfaad6d56beb6dd50257fdc0f6a21359fca03b9ed608f4781966eabac93.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20705:21993:4490:1","source":"bangumi"},{"creditedName":"新谷 良子","creatorId":"vndb:s3626","sourcePersonId":"vndb:s3626","canonicalEntityId":"vndb:s3626","name":"新谷 良子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:4503","source":"vndb"}]},{"characterId":"char_c33514","characterName":"外薗 綸花","sourceIds":{"bangumi":[{"characterId":"4280","match":"exact-normalized-name-in-linked-work","subje