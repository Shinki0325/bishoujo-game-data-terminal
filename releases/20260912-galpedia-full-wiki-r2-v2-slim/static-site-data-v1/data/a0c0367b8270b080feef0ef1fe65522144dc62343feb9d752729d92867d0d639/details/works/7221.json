08","sourcePersonId":"vndb:s41208","canonicalEntityId":"vndb:s41208","name":"中里一","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:38014","source":"vndb"},{"creditedName":"感電注意","creatorId":"vndb:s43602","sourcePersonId":"vndb:s43602","canonicalEntityId":"vndb:s43602","name":"感電注意","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:38017","source":"vndb"},{"creditedName":"神楽つかさ","creatorId":"vndb:s44071","sourcePersonId":"vndb:s44071","canonicalEntityId":"vndb:s44071","name":"神楽つかさ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:38019","source":"vndb"},{"creditedName":"AZstudio","creatorId":"vndb:s44072","sourcePersonId":"vndb:s44072","canonicalEntityId":"vndb:s44072","name":"AZstudio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:38020","source":"vndb"}]},"cast":[{"characterId":"char_c26113","characterName":"帆村 淡雪","sourceIds":{"bangumi":[{"characterId":"115251","match":"exact-normalized-name-in-linked-work","subjectId":"139080"}],"egsCharacterIds":["25784"],"vndbCharacterId":"c26113"},"originalCharacterName":"帆村 淡雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染。沙緒の親友。"},{"spoiler":false,"text":"勝気な性格で、常に上から目線で話すお姉さん気取りの女の子。"},{"spoiler":false,"text":"この春から地元の大学に通うことになっているが、彼女自身、田舎暮らしが嫌いで、***卒業後は、上京したいと思っていた。そのため、すっきりしない気持で今の季節を過ごしている。"},{"spoiler":false,"text":"実家は商店を経営しており、時間があれば店の手伝いをしている。"}],"source":"egs","sourceCharacterId":"25784","sourceWorkId":"7221","spoiler":false},{"segments":[{"spoiler":false,"text":"通明の幼馴染で、沙緒とは親友。思わせぶりな事を言うがどこまで本気なのかわからない。この春、札幌の帝大に入学が決まっている。田舎が嫌いで、学園を卒業したら東京へ出るつもりだったが、札幌で妥協してしまった事に心中密に忸怩たる思いを抱えている。"}],"source":"bangumi","sourceCharacterId":"115251"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"25784","sourceWorkId":"7221","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"25784","sourceWorkId":"7221","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"25784","sourceWorkId":"7221","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"25784","sourceWorkId":"7221","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2ecb7153b90f225e2b23ada8923e4e6cde16db1d8766f1964d0792b5ab55e136.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27a4fa61ed7ae49e0e30b186ba67212322011a803675c56d687003737b3ddfbc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田佳代","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:139080:115251:6038:1","source":"bangumi"}]},{"characterId":"char_c26114","characterName":"藤川 りるけ","sourceIds":{"bangumi":[{"characterId":"115250","match":"exact-normalized-name-in-linked-work","subjectId":"139080"}],"egsCharacterIds":["25783"],"vndbCharacterId":"c26114"},"originalCharacterName":"藤川 りるけ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Protagonist's cousin who is two years younger than him, and Fujikawa Haine's daughter."}],"source":"vndb","sourceCharacterId":"c26114"},{"segments":[{"spoiler":false,"text":"主人公の二つ年下の従妹。"},{"spoiler":false,"text":"能天気で明るく元気な田舎娘。"},{"spoiler":false,"text":"主人公を「お兄ちゃん」と呼んで、慕っている。"},{"spoiler":false,"text":"今回、主人公が自宅に短期滞在（居候）することになって喜んでいる。"},{"spoiler":false,"text":"母親に似て非常に容姿端麗で、将来が期待される。また栄養の全てが胸に吸い取られたと噂されるほどの巨乳の持ち主。"},{"spoiler":false,"text":"料理が得意。しかし、ネギが大好きな彼女の料理には、必ずネギが入っている。"}],"source":"egs","sourceCharacterId":"25783","sourceWorkId":"7221","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の2つ下の後輩であり従兄弟の妹。通明をお兄ちゃんと呼び慕う。祭りが終わるまでりるけの家に居候することになり現在同居中。学園の成績は中の下だが、それはそうととにかく能天気。おっぱいに栄養を吸い取られてしまったのではないかと心配されてしまう。"}],"source":"bangumi","sourceCharacterId":"115250"}],"profileFacts":[{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"25783","sourceWorkId":"7221","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"153 cm","valueContext":null,"source":"egs","sourceCharacterId":"25783","sourceWorkId":"7221","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"25783","sourceWorkId":"7221","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"25783","sourceWorkId":"7221","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/875b81c84771b875674a218fb1739d10048360944de5d4654d3a0000ba4705d1.web