{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"27891","model":{"presentationWorkId":"vndb:v25294","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c4049","characterName":"月島 小恋","sourceIds":{"bangumi":[{"characterId":"1210","match":"exact-normalized-name-in-linked-work","subjectId":"3903"}],"egsCharacterIds":["15645"],"vndbCharacterId":"c4049"},"originalCharacterName":"月島 小恋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1111"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Fashion magazines, good fortune telling results"},{"spoiler":false,"text":"Dislikes: Arguing and fighting, bad fortune telling results"},{"spoiler":false,"text":"Koko is Yoshiyuki's childhood friend who is in love with him. But what prevents her to confess her feelings is just her own shyness. Using this trait of hers, her best friends Akane and Anzu love to tease Koko and try to make her look like a pervert. Koko is also a member of the band, along with Nanaka and Wataru. She can play the bass guitar, synthesizer and piano, and has even tried her hand at composing music."}],"source":"vndb","sourceCharacterId":"c4049"},{"segments":[{"spoiler":false,"text":"好きなもの：ファッション雑誌、良い時の占い"},{"spoiler":false,"text":"嫌いなもの：争いごと、悪い時の占い"},{"spoiler":false,"text":"クラス：風見学園付属3年3組"},{"spoiler":false,"text":"「ちょ、ちょっと待って～！　そんなの無理、無理ー～！」"}],"source":"egs","sourceCharacterId":"15645","sourceWorkId":"6353","spoiler":false},{"segments":[{"spoiler":false,"text":"ななかの幼馴染で、義之とも小学校以来同じクラス。"},{"spoiler":false,"text":"軽音楽部に所属。ベースを担当するほか作曲もこなす。"},{"spoiler":false,"text":"「さっさと」という言葉は、小恋流だと「たったと」になる。"},{"spoiler":false,"text":"「ちょ、ちょっと待って～！　そんなの無理、無理ー～！」"}],"source":"egs","sourceCharacterId":"15645","sourceWorkId":"11556","spoiler":false},{"segments":[{"spoiler":false,"text":"【雪月花】"},{"spoiler":false,"text":"義之の幼なじみで恋心をよせるちょっと内気な女の子。"},{"spoiler":false,"text":"軽音楽部に所属している。"},{"spoiler":false,"text":"クラスメイトの杏、茜の様子が気になっているご様子。"},{"spoiler":false,"text":"「そんなことないよ。わたし、ふたりのこと信用してるもん！」"}],"source":"egs","sourceCharacterId":"15645","sourceWorkId":"12105","spoiler":false},{"segments":[{"spoiler":false,"text":"学生時代からの杏の親友で『雪月花三人娘』の月。癒し系。"}],"source":"egs","sourceCharacterId":"15645","sourceWorkId":"25266","spoiler":false},{"segments":[{"spoiler":false,"text":"风见学园附属中学三年三班学生，与义之同班，对义之有好感，为轻音乐社的社员，贝斯手，是把义之暂时拉入轻音乐社的元凶，不坦率，有点胆小，对于义之太过帮助其他女性非常烦恼，不善于表达自己的意见，所以一直跟义之原地踏步。在游戏中除攻略方向外最后选择与涉交往。"}],"source":"bangumi","sourceCharacterId":"1210"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22c2f74794d76a0625bc86191a99a15cb976db98a289377307b501835a16e7bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfa03fa2724b414d41ff5a23691c7514749bad7153ab1b59d0de83324bace48b.webp","width":105,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南條愛乃","creatorId":"vndb:s62","sourcePersonId":"vndb:s62","canonicalEntityId":"vndb:s62","name":"南條 愛乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:533630:1210:4792:1","source":"bangumi"}]},{"characterId":"char_vndb_c4059","characterName":"桜内 義之","sourceIds":{"vndbCharacterId":"c4059"},"originalCharac