-detail"},"actors":[{"creditedName":"雨宮 瞭","creatorId":"vndb:s52129","sourcePersonId":"vndb:s52129","canonicalEntityId":"vndb:s52129","name":"雨宮 瞭","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84907","source":"vndb"}]},{"characterId":"char_vndb_c98434","characterName":"森近 春樹","sourceIds":{"vndbCharacterId":"c98434"},"originalCharacterName":"森近 春樹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"birthday":{"reviewState":"source-only","source":"vndb","value":"415"},"height":{"reviewState":"source-only","source":"vndb","value":"181"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young man who always wears a mod coat and smokes cigarettes. He's a self-confident person who spends his days gambling and being sloppy in life and sexuality."},{"spoiler":false,"text":"His hobbies include riding motorcycles and, surprisingly, reading. With the sweet scent of vanilla, he roams the homes of many women who are much wealthier than he is."},{"spoiler":false,"text":"He has an older brother who he hasn't communicated with in a long time."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c98434"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/bab1faf69fbc5e8aa0afbf476231c4a35187778d08912d871a31c95e826a836b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a286036a13efb955c13376c07294447a5cf55c2a424859c6d99aef4ecf87be99.webp","width":169,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮下 栄治","creatorId":"vndb:s392","sourcePersonId":"vndb:s392","canonicalEntityId":"vndb:s392","name":"宮下 栄治","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84898","source":"vndb"}]},{"characterId":"char_vndb_c98435","characterName":"周防 景人","sourceIds":{"vndbCharacterId":"c98435"},"originalCharacterName":"周防 景人","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"birthday":{"reviewState":"source-only","source":"vndb","value":"229"},"height":{"reviewState":"source-only","source":"vndb","value":"190"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Born into a warm family consisting of a gentle mother and a police officer father. He's popular in school because of his youthful facial features and bright, refreshing personality."},{"spoiler":false,"text":"He's polite and is always kind to the weak. Although his attitude is typically humble, he sometimes says some selfish things unconsciously."},{"spoiler":false,"text":"He spends his days longing to live an extraordinary life. He's a member of the lacrosse club and has a dream diary."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c98435"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fccfff856cc7666fa59bf520c6328711e9ed9f3c1271bb6678714cc4c52bb94.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c70d353b900758bb898e7baabc8a7d4ccb34421145b16b25afa89a7793aacef0.webp","width":169,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村 颯","creatorId":"vndb:s52127","sourcePersonId":"vndb:s52127","canonicalEntityId":"vndb:s52127","name":"木村 颯","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84905","source":"vndb"}]},{"character