db"}]},{"characterId":"char_vndb_c151172","characterName":"東雲 れい","sourceIds":{"vndbCharacterId":"c151172"},"originalCharacterName":"東雲 れい","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"birthday":{"reviewState":"source-only","source":"vndb","value":"310"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The head of the occult research department on the verge of closure. She is not good at communicating with people and is usually intimidating, but when it comes to the occult, she becomes aloof and curious, as if she has changed. I am investigating the urban legend \"Tanaka Yui Incident\" that is said to have occurred at Keiyo University attached Fujikawa High School."},{"spoiler":true,"text":"In fact, \"Shinonome Rei\" is a pseudonym that borrows the name of a friend, and it is also a lie to say that she is the director of the Oka Lab. Her real name is \"Tanaka Yui\", the same as the schoolgirl who is said to have died in an urban legend."},{"spoiler":false,"text":"translated from digital setting materials"}],"source":"vndb","sourceCharacterId":"c151172"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28d12b6c6b1091d0298695b7b5f2747f88acb66d9b53a8f23f876b345cbaef66.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb59d2ab8d979ac88f48c2b8c0ecf7cd437a2f2120dce398d2154227a20d6480.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永牟田 萌","creatorId":"vndb:s44252","sourcePersonId":"vndb:s44252","canonicalEntityId":"vndb:s44252","name":"永牟田 萌","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","re