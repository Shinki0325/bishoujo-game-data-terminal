-work","subjectId":"116859"}],"egsCharacterIds":["5090"],"vndbCharacterId":"c23101"},"originalCharacterName":"上条 栞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いつもニコニコしているが、腹の中では数多の計算を巡らせるタイプ。"},{"spoiler":false,"text":"男たちに気に入られる、虜にするために仕草や身だしなみにとても気を使っている。"},{"spoiler":false,"text":"智樹のことだけを考えてこれまで過ごしてきたため、智樹に対してものすごい執着がある。"}],"source":"egs","sourceCharacterId":"5090","sourceWorkId":"20856","spoiler":false},{"segments":[{"spoiler":false,"text":"いつもニコニコしているが、腹の中では数多の計算を巡らせるタイプ。"},{"spoiler":false,"text":"男に気に入られる・虜にするために、仕草や身だしなみにとても気を使っている。"},{"spoiler":false,"text":"智樹のことだけを考えてこれまで過ごしてきたため、彼に対して凄まじい執着がある。"},{"spoiler":false,"text":"「私、ずっと待ってます。 約束ですよ」"}],"source":"bangumi","sourceCharacterId":"27774"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e359429a659c1d55409f80283bcc22777c6f982d4f01493013bdd046e90d53e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da7aea498b92bf553760b002c0fffa03a867f92525b2b47ad5eec003303f1e49.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川知子","creatorId":"vndb:s694","sourcePersonId":"vndb:s694","canonicalEntityId":"vndb:s694","name":"ひむろゆり(氷室百合)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:116859:27774:5924:1","source":"bangumi"}]},{"characterId":"char_c23102","characterName":"川中 萌香","sourceIds":{"bangumi":[{"characterId":"27775","match":"exact-normalized-name-in-linked-work","subjectId":"116859"}],"egsCharacterIds":["5091"],"vndbCharacterId":"c23102"},"originalCharacterName":"川中 萌香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-re