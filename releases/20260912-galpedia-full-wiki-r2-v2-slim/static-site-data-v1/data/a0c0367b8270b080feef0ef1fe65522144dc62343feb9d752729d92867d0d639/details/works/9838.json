{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"9838","model":{"presentationWorkId":"vndb:v5945","staff":{"artwork":[{"creditedName":"玉姫金魚","creatorId":"vndb:s1082","sourcePersonId":"egs:creator:2333","canonicalEntityId":"vndb:s1082","name":"玉姫金魚","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:44677","source":"egs"}],"scenario":[{"creditedName":"西矢沙広","creatorId":"vndb:s2600","sourcePersonId":"egs:creator:1902","canonicalEntityId":"vndb:s2600","name":"西矢沙広","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:44678","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c64756","characterName":"アナ","sourceIds":{"bangumi":[{"characterId":"88304","match":"exact-normalized-name-in-linked-work","subjectId":"230386"}],"egsCharacterIds":["19250"],"vndbCharacterId":"c64756"},"originalCharacterName":"アナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"62"},"height":{"reviewState":"no-conflict","source":"vndb","value":"136"},"hip":{"reviewState":"source-only","source":"vndb","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"イギリス人の母親とアメリカ人の父親を持つハーフの女の子。"},{"spoiler":false,"text":"日本暮らしが長く、日本語はペラペラだが、英語はからっきし。"},{"spoiler":false,"text":"外人特有の白い肌を持ち、日焼けすると真っ赤になるので気を使っている。"},{"spoiler":false,"text":"しかし、そうした外人の容姿に誇りを持ちながら、コンプレックスを抱いている。"},{"spoiler":false,"text":"その勝気な外見に違わず、性格もそのまんまだが、相手によっては態度を使い分ける分別は持っているようだ。"},{"spoiler":false,"text":"奈津とは幼い頃から姉妹のように育った親友で、いつも一緒に行動している。"},{"spoiler":false,"text":"サディスティックに見えて実はマゾだったり……。"}],"source":"egs","sourceCharacterId":"19250","sourceWorkId":"9838","spoiler":false},{"segments":[{"spoiler":false,"text":"愛称はアナ。イギリス人の母親とアメリカ人の父親が日本で出会い彼女が生まれる。"},{"spoiler":false,"text":"日本暮らしの方が長いくらいで、日本語はペラペラ。むしろ、英語の方がからっきしなくらい。"},{"spoiler":false,"text":"ふわふわしたウェービーな金髪を、肩よりちょっと下まで伸ばしている。ちょっとツリ目で猫っぽい。"},{"spoiler":false,"text":"手足は真っ白であり、焼けると赤くなる事が多いため気を使う。外国人のような外見に誇りと同時にややコンプレックスを持っている。"},{"spoiler":false,"text":"奈津と行動を共にし、彼女を引っ張っているように見えるが、何かしら反対されるとできなくなる。自分の弱い部分を知っているが、治す事ができない。"},{"spoiler":false,"text":"サディストっぽく振舞うが、実際はそれをされている自分を想像して楽しんでいる隠れマゾ。奈津とは幼い頃から姉妹のように育った。"}],"source":"bangumi","sourceCharacterId":"88304"}],"profileFacts":[{"label":"胸围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"19250","sourceWorkId":"9838","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"136 cm","valueContext":null,"source":"egs","sourceCharacterId":"19250","sourceWorkId":"9838","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"72 cm","valueContext":null,"source":"egs","sourceCharacterId":"19250","sourceWorkId":"9838","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"47 cm","valueContext":null,"source":"egs","sourceCharacterId":"19250","sourceWorkId":"9838","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5067cdfe95ea898377daeb5e5081ca315cd366a26c54d377e07357251fe8a26.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d64b5f5f2305c310e90610ec9fac73aad00dade9b91a8263790c5ecbe2e67c5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩村琴美","creatorId":"vndb:s1172","sourcePersonId":"vndb:s1172","canonicalEntityId":"vndb:s1172","name":"岩村 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230386:88304:4813:1","source":"bangumi"}]},{"characterId":"char_c64757","characterName":"藤乃宮 奈津","sourceIds":{"bangumi":[{"characterId":"88305","match":"exact-normalized-name-in-linked-work","subjectId":"230386"}],"egsCharacterIds":["19251"],"vndbCharacterId":"c64757"},"originalCharacterName":"藤乃宮 奈津","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"65"},"height":{"reviewState":"no-conflict","source":"vndb","value":"139"},"hip":{"reviewState":"source-only","source":"vndb","value":"70"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"この土地に古くからある家のお嬢様。"},{"spoiler":false,"text":"大人しく、おしとやかに見えて、意外に外を出歩いたりするのが好き。"},{"spoiler":false,"text":"自分が可愛いことを自覚し、それを利用する術を知っている、そんな腹黒い一面も。"},{"spoiler":false,"text":"親友のアナに友人以上の感情を抱いており、いつか自分のモノにしようと画策している。"},{"spoiler":false,"text":"そうしたことからサディスティックな性格であることがわかるものの、普段の穏やかな雰囲気がそれを巧妙に隠している。"}],"source":"egs","sourceCharacterId":"19251","sourceWorkId":"9838","spoiler":false},{"segments":[{"spoiler":false,"text":"この地方に割と古くからある家のお嬢様。黒目がちで真っ直ぐなロングヘアなため、まるで人形のように見える。"},{"spoiler":false,"text":"性格もおしとやかそうに見えるが、意外と外を出歩いたりするのが好きで、アナにも良く付き合っている。"},{"spoiler":false,"text":"自分の外見を利用するすべを知っており、大人を手玉に取るような腹黒い部分もある。普段の様子が穏やかなので気付かれにくいが、実は隠れサディスト。"},{"spoiler":false,"text":"アナに対して友人以上の想いを覚えている部分があり、彼女を時間をかけて自分のものにしようと画策している。"}],"source":"bangumi","sourceCharacterId":"88305"}],"profileFacts":[{"label":"胸围（本版本）","value":"65 cm","valueContext":null,"source":"egs","sourceCharacterId":"19251","sourceWorkId":"9838","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"139 cm","valueContext":null,"source":"egs","sourceCharacterId":"19251","sourceWorkId":"9838","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"19251","sourceWorkId":"9838","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"48 cm","valueContext":null,"source":"egs","sourceCharacterId":"19251","sourceWorkId":"9838","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/910dc766b2effe1f0349b4f23d451bb0d71eca30e5d7866d370227fb54ae8367.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a76743dda024a36d0663cdeef7a3f0207c2d2db0a5b9c87b533e4a5616c77c99.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘志穂","creatorId":"vndb:s738","sourcePersonId":"vndb:s738","canonicalEntityId":"vndb:s738","name":"橘 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230386:88305:7169:1","source":"bangumi"}]},{"characterId":"char_c64758","characterName":"大森 日奈子","sourceIds":{"bangumi":[{"characterId":"148932","match":"exact-normalized-name-in-linked-work","subjectId":"230386"}],"egsCharacterIds":["19252"],"vndbCharacterId":"c64758"},"originalCharacterName":"大森 日奈子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"27"},"bust":{"reviewState":"source-only","source":"vndb","value":"74"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の叔父の娘で、舞台となる学園の講師。"},{"spoiler":false,"text":"自分の父親の代理を引き受けてくれた主人公に色々と手助けしてくれる。"},{"spoiler":false,"text":"年齢は主人公よりも上で、お姉さん的な存在だが、背が低く、童顔のため、幼く見られがち。"},{"spoiler":false,"text":"そのため、なるべくスーツを着込んで、大人っぽくしようと思っているが、あまり似合っていない。"},{"spoiler":false,"text":"しかし、その幼い外見にコンプレックスを抱いているものの、それを冗談として扱える精神的な強さを持つ。"},{"spoiler":false,"text":"生徒からは良い先生であり、おせっかいで心配性。"}],"source":"egs","sourceCharacterId":"19252","sourceWorkId":"9838","spoiler":false},{"segments":[{"spoiler":false,"text":"年齢は27歳だが、何の冗談か13～4歳くらいにしか見えない外見のため、愛称……というかからかわれて『ひな』と呼ばれることがある。"},{"spoiler":false,"text":"主人公の叔父の娘であり、学園の講師でもある。父の代理を務めることになった主人公を、色々と助けてくれ、主人公にとっては姉のような存在である。"},{"spoiler":false,"text":"外見はともかく、講師としても幼い。外見にコンプレックスはあるものの、冗談として扱える位の精神の強さはあるらしい。"},{"spoiler":false,"text":"良き先生であり、おせっかいで心配性な所があり、用事を言いつけられると喜々としてこなす。誰にも恋愛感情は無いが結婚願望があるようだ。"}],"source":"bangumi","sourceCharacterId":"148932"}],"profileFacts":[{"label":"胸围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"19252","sourceWorkId":"9838","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"147 cm","valueContext":null,"source":"egs","sourceCharacterId":"19252","sourceWorkId":"9838","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"19252","sourceWorkId":"9838","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"19252","sourceWorkId":"9838","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/781b701c3eec609c2be5e67f76e7981c56e411212ee8093f0648852ea5bda4b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c61b16f756d0e8efc8a82d90366c5f32d9e0d35a227532e3c619cfcbaf09b74.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鶴岡 さくら","creatorId":"vndb:s11723","sourcePersonId":"vndb:s11723","canonicalEntityId":"vndb:s11723","name":"鶴岡 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:34110","source":"vndb"}]},{"characterId":"char_vndb_c64759","characterName":"大森 大穀","sourceIds":{"vndbCharacterId":"c64759"},"originalCharacterName":"大森 大穀","characterNameSource":null,"role":"appears","status":"source-only-cand