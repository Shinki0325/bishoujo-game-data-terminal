{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"19249","model":{"presentationWorkId":"vndb:v12702","staff":{"artwork":[],"scenario":[{"creditedName":"新井隆","creatorId":"egs:creator:21381","sourcePersonId":"egs:creator:21381","canonicalEntityId":"egs:creator:21381","name":"新井隆","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:134710","source":"egs"},{"creditedName":"河西宏","creatorId":"egs:creator:21382","sourcePersonId":"egs:creator:21382","canonicalEntityId":"egs:creator:21382","name":"河西宏","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:134711","source":"egs"}],"music":[{"creditedName":"坂部 剛","creatorId":"vndb:s9598","sourcePersonId":"vndb:s9598","canonicalEntityId":"vndb:s9598","name":"坂部 剛","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:100256","source":"vndb"}],"other":[{"creditedName":"つなこ","creatorId":"vndb:s4946","sourcePersonId":"egs:creator:17779","canonicalEntityId":"vndb:s4946","name":"つなこ","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"auto-confirmed","relationId":"egs:work-creator:134709","source":"egs"},{"creditedName":"sweet ARMS","creatorId":"vndb:s4969","sourcePersonId":"egs:creator:23357","canonicalEntityId":"vndb:s4969","name":"sweet ARMS","detail":"OP曲「デート・イン・ユートピア」、ED曲「きっと ずっと」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:148103","source":"egs"},{"creditedName":"つなこ","creatorId":"vndb:s4946","sourcePersonId":"vndb:s4946","canonicalEntityId":"vndb:s4946","name":"つなこ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:100254","source":"vndb"},{"creditedName":"sweet ARMS","creatorId":"vndb:s4969","sourcePersonId":"vndb:s4969","canonicalEntityId":"vndb:s4969","name":"sweet ARMS","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:100255","source":"vndb"},{"creditedName":"渡部 紫緒","creatorId":"vndb:s9599","sourcePersonId":"vndb:s9599","canonicalEntityId":"vndb:s9599","name":"渡部 紫緒","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:100257","source":"vndb"},{"creditedName":"橘 公司","creatorId":"vndb:s11255","sourcePersonId":"vndb:s11255","canonicalEntityId":"vndb:s11255","name":"橘 公司","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:100258","source":"vndb"},{"creditedName":"横山 一希","creatorId":"vndb:s53852","sourcePersonId":"vndb:s53852","canonicalEntityId":"vndb:s53852","name":"横山 一希","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:100259","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c14291","characterName":"時崎 狂三","sourceIds":{"vndbCharacterId":"c14291"},"originalCharacterName":"時崎 狂三","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Code name: \"Nightmare\""},{"spoiler":false,"text":"Angel: Zafkiel"},{"spoiler":false,"text":"Astral Dress: Elohim"},{"spoiler":false,"text":"Kurumi is the third spirit who appeared after Tohka and Yoshino, and the most brutal so far. She has a split personality: that of a gentle, mysterous highschool girl with a slow talking pattern, and that of a psychopathic killer. She is very aggressive in her actions which makes it harder for Shidou to capture her."},{"spoiler":true,"text":"Kurumi has the archangel Zafkiel, and has the power to control over time. The reason why she keeps appearing after being killed by Mana countless times was because of her powers. For example, she can heal herself by turning back the time. She uses a gunblade as her weapon. The twelve Roman numerals on the clock in her left eye have different powers that only the original Kurumi can use, but by using their powers, it will cause her life to be eaten away. In order to avoid this, she kills people to obtain 'time'."},{"spoiler":false,"text":"Taken from MyAnimeList"}],"source":"vndb","sourceCharacterId":"c14291"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f651f2d5c6490c2483be44e81034a798b97a5e1252ca56c1bd9446522a43f808.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d77c80cb528368eb97840481445bedaa4bde4f5ab7bae8be35e03b3a13bf69d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真田 アサミ","creatorId":"vndb:s1712","sourcePersonId":"vndb:s1712","canonicalEntityId":"vndb:s1712","name":"真田 アサミ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53518","source":"vndb"}]},{"characterId":"char_vndb_c14341","characterName":"五河 士道","sourceIds":{"vndbCharacterId":"c14341"},"originalCharacterName":"五河 士道","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Itsuka Shidou is a student of Raizen High School. He was adopted into the Itsuka family when he was \"abandoned\" by his mother."},{"spoiler":false,"text":"Shidou has the ability to seal a spirit's power. However, the reason why he possesses it is shrouded in mystery. Due to this power which was already known by Itsuka Kotori he was recruited -- or rather forced -- to join \"Ratatoskr\" to help and save Spirits. Instead of killing Spirits to prevent spacequake from happening, he has to seal the Spirit's powers with a kiss in order for them to co-exist with humans. Once the power of a Spirit is sealed within Shidou, he has the ability to use some portion of it, thus his resurrection power is from Kotori's abilities when he sealed Kotori's Spirit 5 years ago."},{"spoiler":false,"text":"From MyAnimeList"}],"source":"vndb","sourceCharacterId":"c14341"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21a7de4b4740aeb8d17439f519e8196ecef4c02983a878ca94b0cadd72567986.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6ec98147f356b1cc164ac14f114242f9e2f5558162ea0b5df978fe512a91b694.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"島﨑 信長","creatorId":"vndb:s1248","sourcePersonId":"vndb:s1248","canonicalEntityId":"vndb:s1248","name":"島﨑 信長","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53517","source":"vndb"}]},{"characterId":"char_vndb_c14344","characterName":"園神 凜祢","sourceIds":{"vndbCharacterId":"c14344"},"originalCharacterName":"園神 凜祢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A new character in the PS3 game, Date A Live: Rinne Utopia. Rinne is introduced as Shido's childhood friend, although he does not remember her. Rinne is a calm and gentle girl who acts like a traditional childhood friend who goes every morning to the Itsuka House to wake Shido up and prepare his lunch."},{"spoiler":true,"text":"Code name: Ruler"},{"spoiler":true,"text":"The truth is, Rinne (or Ruler) was never Shido's childhood friend, nor was she a human. She was born as a result of a large amount of spirit energy suddenly forming a consciousness of its own. One day, Shido's massive amount of stress caused by his dangerous life made the powers of the sealed spirits return to their owners, and on the school's rooftop, Tohka's power went berserk and accidentally killed him. At this moment, Rinne activated the Eden in order to save him. Her Eden engulfed the entire Tengu City and she slipped inside Shido's life as his childhood friend. Her objective was to continue this Eden forever and hoped that Shido would never discover the truth of Eden and have a happy life with his chosen partner."}],"source":"vndb","sourceCharacterId":"c14344"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91a80b8229053a76b6952c3d42615bbef510e9077e9bddd1121761e8663b3470.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5cc9ace6cc4ae27096c8633adba9142717b990b3a9b3c6e7c75cce4b8fce32ad.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤 香菜","creatorId":"vndb:s237","sourcePersonId":"vndb:s237","canonicalEntityId":"vndb:s237","name":"花澤香菜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53516","source":"vndb"}]},{"characterId":"char_vndb_c14357","characterName":"夜刀神 十香","sourceIds":{"vndbCharacterId":"c14357"},"originalCharacterName":"夜刀神 十香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Code name: \"Princess\""},{"spoiler":false,"text":"Angel: Sandalphon"},{"spoiler":false,"text":"Astral Dress: Adonai Melek"},{"spoiler":false,"text":"Yatogami Tooka's name is given by Shidou when they first met. Due to being a spirit, she is always being targeted by the AST and is aiming for the kill, because of that she hated humans for always shunning her and thinking that she wasn't allowed to live in this world, but her whole life changed when she met Shidou."},{"spoiler":false,"text":"Even with that high and cool presence, Tooka lacks some common sense and loves food very much."},{"spoiler":false,"text":"Taken from MyAnimeList"}],"source":"vndb","sourceCharacterId":"c14357"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/191f25b31d942bf6b4705ca231b87f0cf42b7bcf33e98997c487b9d4e6de5e70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97fe3b02c1b3dd16943e18ef0b175a46db4fb9d69373f85cd46c6785aef7f31b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上 麻里奈","creatorId":"vndb:s1774","sourcePersonId":"vndb:s1774","canonicalEntityId":"vndb:s1774","name":"井上 麻里奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53520","source":"vndb"}]},{"characterId":"char_vndb_c14371","characterName":"鳶一 折紙","sourceIds":{"vndbCharacterId":"c14371"},"originalCharacterName":"鳶一 折紙","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1111"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"75"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tobiichi Origami is a student of Raizen High School. She is known for having the highest grades in school, including P.E. She is also a member of AST (Anti-Spirit Team) as one of the most skilled members."},{"spoiler":false,"text":"Origami has a great hatred towards Spirits. This is because five years ago when the first great spacequake happened,"},{"spoiler":true,"text":"her parents died in a fire caused by an unknown Spirit. She joined the AST for a chance for revenge."},{"spoiler":false,"text":"Origami is in love with Shidou, so much so that she frequently stalks him."},{"spoiler":true,"text":"Origami originally met Shidou five years ago when the first great spacequake happened. However, Shidou does not remember this."},{"spoiler":false,"text":"From MyAnimeList"}],"source":"vndb","sourceCharacterId":"c14371"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99a74cff9a0c02fd5cb20f091a28245aef6bc189ae3edee6926b51ebf2678e46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/389ba6bead6190f0df3c20122e6a57a2e8fbad9c22ca112c32fed970b8ec8bab.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"富樫 美鈴","creatorId":"vndb:s3947","sourcePersonId":"vndb:s3947","canonicalEntityId":"vndb:s3947","name":"富樫 美鈴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53522","source":"vndb"}]},{"characterId":"char_vndb_c14372","characterName":"五河 琴里","sourceIds":{"vndbCharacterId":"c14372"},"originalCharacterName":"五河 琴里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"803"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"72"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"145"},"hip":{"reviewState":"source-only","source":"vndb","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Code name: \"Efreet\""},{"spoiler":false,"text":"Angel: Camael"},{"spoiler":false,"text":"Astral Dress: Elohim Gibor"},{"spoiler":false,"text":"Kotori is Shido's foster sister and the head commander of Ratatoskr."},{"spoiler":false,"text":"Kotori's character changes according to the color of the ribbons she's wearing. While wearing white ribbons she is that of her \"weak self\", a delicate little sister who is very dependent upon her big brother; and when wearing black ribbons, she becomes her \"strong self\", a charismatic and sometimes cynical leader able to successfully command the airship, Fraxinus. In her Spirit form, Kotori acts the same as her ribbons' current color indicates. But if she stays in her spirit form for too long, her third, \"Spirit personality,\" takes over and she becomes an aggressive and merciless killing machine, who only cares about battling enemies to death."},{"spoiler":false,"text":"In all three cases, Kotori seems to have a sadistic side. Her deep feelings for Shidou are always present, regardless of her current personality and help her remember who she truly is. No matter what the situation is, she will always be Shido's little sister."},{"spoiler":false,"text":"Kotori is a Fire Spirit and she became one 5 years prior to the main events after being turned into one by Phantom. Her powers are centered on the manipulation of flames that erupt from her body and can be used in close or ranged combat. Her angel Camael comes in the form of a large red halberd but can be dismantled into Megiddo, a cannon powered by Kotori's own flames. Megiddo fires powerful energy beams that can overwhelm even the defenses of other Spirits. Kotori also has a powerful regeneration ability, which Shidou uses/borrows on many occasions when he is trying to make spirits fall for him."},{"spoiler":false,"text":"From Date A Live Wiki"}],"source":"vndb","sourceCharacterId":"c14372"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b05e8c45da01607e8b4a30c942b705588ddbac9404d617cc25eeb19a81598ee6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da0b0327f45fec76beccda9b1a99b346356160097d093e37d805df1f5d3996cf.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹達 彩奈","creatorId":"vndb:s1767","sourcePersonId":"vndb:s1767","canonicalEntityId":"vndb:s1767","name":"竹達 彩奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53519","source":"vndb"}]},{"characterId":"char_vndb_c14373","characterName":"氷芽川 四糸乃","sourceIds":{"vndbCharacterId":"c14373"},"originalCharacterName":"氷芽川 四糸乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"73"},"height":{"reviewState":"source-only","source":"vndb","value":"144"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Code name: \"Hermit\""},{"spoiler":false,"text":"Angel: Zadkiel"},{"spoiler":false,"text":"Astral Dress: El"},{"spoiler":false,"text":"Second Spirit to appear, and the kindest spirit up to date. She's very shy and relies on her Hand Puppet Yoshinon to communicate with others. She causes rain to fall whenever she appears, which is part of her ability to control the three states of water. Mainly uses ice attacks though."},{"spoiler":false,"text":"Taken from TVTropes"}],"source":"vndb","sourceCharacterId":"c14373"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/508b845562949e81b7866c8c27d727c80a3dafedc4a290cd249400f2019f57d5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d523965a1c2da49c6dc215d1745b9f8a31cb632c2807d97f4f4da4ea44e9f2e5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野水 伊織","creatorId":"vndb:s1775","sourcePersonId":"vndb:s1775","canonicalEntityId":"vndb:s1775","name":"野水 伊織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53521","source":"vndb"}]},{"characterId":"char_vndb_c14376","characterName":"村雨 令音","sourceIds":{"vndbCharacterId":"c14376"},"originalCharacterName":"村雨 令音","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"95"},"height":{"reviewState":"source-only","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Reine is highly intelligent and the Analysis Officer of Ratatosk's Fraxinus Crew."},{"spoiler":false,"text":"She can be ranked the Vice-Commander of the crew rather than Kannazuki Kyouhei, as it is usually her at Kotori's side, managing things around the crew. She transferred to Raizen Highschool as a Physics teacher and an assistant homeroom teacher at Shidou's class. She has big eyebags which are a result of her not having had enough sleep. In fact, Reine stated at one point that \"for the last 30 years, she hasn't been able to sleep properly.\""},{"spoiler":false,"text":"At some points, she can be reliable and take Command of the directions which Shidou needs to do when dating a spirit. She acts like the \"mother\" of Shidou and the other Spirits to help them with their troubles and such."},{"spoiler":false,"text":"Reine has a habit of calling Shido \"Shin\", because she can never pronounce his name right."},{"spoiler":false,"text":"Taken from MyAnimeList"}],"source":"vndb","sourceCharacterId":"c14376"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f18538974bb0796fa3911b70a7b8ced0760a109186b072a140a48abf80719a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06e0389df0ede32cc78b6a872e8b22c182fee177af5422cf326369a65ab130aa.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"遠藤 綾","creatorId":"vndb:s5699","sourcePersonId":"vndb:s5699","canonicalEntityId":"vndb:s5699","name":"遠藤 綾","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53525","source":"vndb"}]},{"characterId":"char_vndb_c81467","characterName":"殿町 宏人","sourceIds":{"vndbCharacterId":"c81467"},"originalCharacterName":"殿町 宏人","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shido's classmate."}],"source":"vndb","sourceCharacterId":"c81467"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6a0e9db4e554ef78e4fc2d99ece6f60ec21f5310e39315f51d5c188e2c9697a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7da78125d4b38408e31f15f7beada8876ea9093db7d2f60d0281496f8675e6e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"勝 杏里","creatorId":"vndb:s4899","sourcePersonId":"vndb:s4899","canonicalEntityId":"vndb:s4899","name":"勝 杏里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53523","source":"vndb"}]},{"characterId":"char_vndb_c81468","characterName":"神無月 恭平","sourceIds":{"vndbCharacterId":"c81468"},"originalCharacterName":"神無月 恭平","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"181"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kyouhei is the vice-commander of Ratatoskr crewing the Fraxinus, a ship located 15,000 meters above Tengu City. Kyouhei is described to be a nice individual with elegant manners. However, he is also a masochist and often let his masochistic antics make his coworkers question his authority and reliability. He constantly likes angering Kotori who always punishes him over these actions, which he satisfies his masochistic tendencies. Despite his fetishes, when in danger or when the situation truly calls for it, Kyouhei has shown to be highly perceptive and analytical in various situations and i