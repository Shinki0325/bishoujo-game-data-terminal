5abe8ecdb0a3e6eb0979a2cbd8315f6b9553bbf4af776192aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f57389563998c8bcb3835d9bf36a78ea221719d2a48a45a83e63949cc909eb3e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹間千ノ美","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225091:90074:19333:1","source":"bangumi"}]},{"characterId":"char_c13432","characterName":"アルフィア・フラックス","sourceIds":{"bangumi":[{"characterId":"90075","match":"exact-normalized-name-in-linked-work","subjectId":"225091"}],"egsCharacterIds":["13859"],"vndbCharacterId":"c13432"},"originalCharacterName":"アルフィア・フラックス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Alfia is one of many military commanders serving Eclipse."},{"spoiler":false,"text":"An excellent strategist, she’s extremely knowledgeable and intelligent."},{"spoiler":false,"text":"Her nickname is ’Fia."},{"spoiler":false,"text":"Typically takes charge of Eclipse’s supply lines and rarely appears on the front lines of battle."},{"spoiler":false,"text":"A reserved, cautious person, Alfia likes to maintain a low profile."},{"spoiler":false,"text":"Her tall, slender body and exotic looks turn heads all across the nation of Eclipse."},{"spoiler":false,"text":"From mangagamer.com"}],"source":"vndb","sourceCharacterId":"c13432"},{"segments":[{"spoiler":false,"text":"エクリプスの指揮官のひとり。"},{"spoiler":false,"text":"戦略に長けた参謀タイプ、知的で繊細な女性。通称フィア。"},{"spoiler":false,"text":"普段はエクリプスの補給部隊の指揮を執っており、自ら前線に立つことは稀。控え目かつ慎重な性格で、表立った行動を嫌う。"},{"spoiler":false,"text":"長身でスレンダーな体型。かつオリエンタルな風貌でエクリプス内でも人目を引く。"}],"source":"egs","sourceCharacterId":"13859","sourceWorkId":"3783","spoiler":false},{"segments":[{"spoiler":false,"text":"エクリプスの指揮官のひとり。"},{"spoiler":false,"text":"戦略に長けた参謀タイプ、知的で繊細な女性。通称フィア。"},{"spoiler":false,"text":"普段はエクリプスの補給部隊の指揮を執っており、自ら前線に立つことは稀。"},{"spoiler":false,"text":"控え目かつ慎重な性格で、表立った行動を嫌う。"},{"spoiler":false,"text":"カトゥーシャとの戦闘の際、補給線の分断を狙った主人公部隊の奇襲を受けて敗北。"},{"spoiler":false,"text":"捕虜となった後、凄惨な凌辱を受ける。"},{"spoiler":false,"text":"長髪に長身、切れ長な冷たい瞳が特徴的。細身だが出るところは出ている。"}],"source":"bangumi","sourceCharacterId":"90075"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b292fd5cd3c804fe7c9c1b6b7dfe2817f68848d714ac7d3314db6c3bce63c07e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0fffa96bb79ae981c31cedf744f75324b6d738ad38aa8b2549668163d4c4f396.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"児玉さとみ","creatorId":"vndb:s115","sourcePersonId":"vndb:s115","canonicalEntityId":"vndb:s115","name":"児玉 さとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225091:90075:15954:1","source":"bangumi"}]},{"characterId":"char_c13433","characterName":"レイチェル・クローブ","sourceIds":{"bangumi":[{"characterId":"90076","match":"exact-normalized-name-in-linked-work","subjectId":"225091"}],"egsCharacterIds":["13860"],"vndbCharacterId":"c13433"},"originalCharacterName":"レイチェル・クローブ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rachel is an expert in the dark arts; she belongs to Eclipse’s assassination squad."},{"spoiler":false,"text":"She possesses strong magical powers, but her clumsiness often causes her to screw up."},{"spoiler":false,"text":"She managed to sneak into Katusha Castle to murder the King, but her idiocy coupled with Vincent’s intervention caused her plans to go hopelessly awry."},{"spoiler":false,"text":"Her mental and physical ages seem to be the inverse of what they actually are."},{"spoiler":false,"text":"She’s flat as a board and hopelessly unattractive, but some men in Eclipse still adore her figure."},{"spoiler":false,"text":"From mangagamer.com"}],"source":"vndb","sourceCharacterId":"c13433"},{"segments":[{"spoiler":false,"text":"エクリプスの暗部に属する、黒魔術の使い手。"},{"spoiler":false,"text":"高い魔力を持つが少々そそっかしい面があり、失敗が絶えない。"},{"spoiler":false,"text":"カトゥーシャ国主暗殺のため王城に忍び込むが、生まれついてのマヌケ具合とヴィンセントの妨害により、やはり失敗してしまう。"},{"spoiler":false,"text":"精神年齢と肉体年齢が反比例しているかのようで、絶望的に起伏のない体型をしている。一部の好事家から支持を得ている。"}],"source":"egs","sourceCharacterId":"13860","sourceWorkId":"3783","spoiler":false},{"segments":[{"spoiler":false,"text":"エクリプスの暗部に属する、黒魔術の使い手。"},{"spoiler":false,"text":"高い魔力を持つが少々そそっかしい面があり、失敗が絶えない。"},{"spoiler":false,"text":"カトゥーシャ国王暗殺のため城に忍び込むが、持ち前のドジと主人公の妨害により、やっぱり失敗してしまう。"},{"spoiler":false,"text":"戦場ではアルフィアの配下につき、補給部隊の指揮を助けている。"},{"spoiler":false,"text":"妖艶な魔女を目指しているものの、現実には童顔で幼児体型。"},{"spoiler":false,"text":"濃紺のローブに愛用のステッキという出で立ち。"}],"source":"bangumi","sourceCharacterId":"90076"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f9040d094723e66fdc2d27bde9fb8aa36d2563135fb47741fea22e16722bb149.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/418228f63a28f7a3570f3430b5c284985edc82ba6bf87a889f65a6c655caa741.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225091:90076:4832:1","source":"bangumi"}]},{"characterId":"char_vndb_c103149","characterName":"Ed Cashew","sourceIds":{"vndbC