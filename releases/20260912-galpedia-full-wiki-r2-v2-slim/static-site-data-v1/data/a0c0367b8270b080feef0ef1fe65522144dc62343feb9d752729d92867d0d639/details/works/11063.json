xt":"今どきの女の子らしく、バイトに買い物にと毎日を忙しく過ごしている。"}],"source":"bangumi","sourceCharacterId":"94023"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/9326308f3b4147ec202e8be0fbd9c044a1c06084f22e8e8bd774c042dab9555a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20ffefb82adae118e148c9e6d100952a568a0734d77569b6b572d299446396ac.webp","width":244,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長瀬ゆずは","creatorId":"vndb:s2287","sourcePersonId":"vndb:s2287","canonicalEntityId":"vndb:s2287","name":"長瀬ゆずは","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:81883:94023:24238:1","source":"bangumi"}]},{"characterId":"char_c34402","characterName":"里中 美和","sourceIds":{"bangumi":[{"characterId":"94025","match":"exact-normalized-name-in-linked-work","subjectId":"81883"}],"egsCharacterIds":["13298"],"vndbCharacterId":"c34402"},"originalCharacterName":"里中 美和","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"響の友人・里中秀平の妹で、元気で可愛い女の子。"},{"spoiler":false,"text":"密かに響に想いを寄せているが、"},{"spoiler":false,"text":"好きというより憧れに近く、"},{"spoiler":false,"text":"今は見ているだけで満足らしい。"}],"source":"egs","sourceCharacterId":"13298","sourceWorkId":"11063","spoiler":false},{"segments":[{"spoiler":false,"text":"響の友人・里中秀平の妹。"},{"spoiler":false,"text":"元気でかわいい女の子。専門学校に通っている。"},{"spoiler":false,"text":"響に密かに憧れていて、秀平の部屋に響が遊びに来ると、いつも乱入して話やゲームに参加。"},{"spoiler":false,"text":"響のことは好きというより憧れで、見ているだけで満足。"}],"source":"bangumi","sourceCharacterId":"94025"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0bfcedfcad6b9916e27cb6590b6273d045b