alse,"text":"幽体離脱が可能で専ら偵察任務を得意としてたが、体内に神様を宿らせれられたことがきっかけで一転、武闘派に。"},{"spoiler":false,"text":"とは言え極度の恐がりなので、あまり戦いは好まない。"}],"source":"egs","sourceCharacterId":"11618","sourceWorkId":"14053","spoiler":false},{"segments":[{"spoiler":false,"text":"元々は身体が弱く入院生活を送っていた少女。"},{"spoiler":false,"text":"いぶきやなずなと共に事件解決のため、得意の幽体離脱を使って偵察任務などを行っていましたが、神様の力を宿らせたことがきっかけで前線でも活躍することが出来るようになった。しかし、極度の恐がりのため、本人はあまり戦いを好んでいません。"},{"spoiler":false,"text":"「大賀温泉郷」での事件が解決して以降は巫女として神社の手伝いをしています。ゲームではいぶき達のように武器は持ちませんが、高い精神力を活かした特殊攻撃で妖怪たちと対峙していきます。"}],"source":"egs","sourceCharacterId":"11618","sourceWorkId":"26633","spoiler":false},{"segments":[{"spoiler":false,"text":"考太のクラスメイト。"},{"spoiler":false,"text":"地味で目立たなく、友人も少なめ。"},{"spoiler":false,"text":"身体が弱く、長い入院生活中に幽体離脱能力を身につけましたが、その事は誰にも内緒にしています。"}],"source":"bangumi","sourceCharacterId":"140925"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3a8243949eed6f96f7bf4e8514248209c4fc8e98a79665ce377a36e9da34d0b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a240cb48e957739a5ea50b1f5fd1061f57a5c8f7ca41040e809276851f629d0.webp","width":104,"height":256,"source":"static-detail"},"actors":[{"creditedName":"峰岸由香里","creatorId":"vndb:s925","sourcePersonId":"vndb:s925","canonicalEntityId":"vndb:s925","name":"峰岸 由香里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:240601:140925:5939:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:2720","sourceCompanyId":"egs:brand:2720","canonicalEntityId":"egs:brand:2720","name":"でぼの巣製作所","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:26633:2720","source":"egs"},{"companyId":"vndb:p709","sourceCompanyId":"vndb:p709","canonicalEntityId":"vndb:p709","name":"でぼの巣製作所","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:rele