-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"小学校のときの同級生だったが、今回も編入した璃遠と同級生に。"},{"spoiler":false,"text":"クラス委員長。璃遠の前に出るとすぐにツンツンしてしまうが、実は好きでしようがないツンデレキャラ。"},{"spoiler":false,"text":"胸が少し小さめなのを気にしていて、いつもミルクを飲んでいる。"},{"spoiler":false,"text":"小学校の頃、絵が抜群に上手かった璃遠に憧れ、現在美術部所属。"},{"spoiler":false,"text":"璃遠が転校してきた事により、自分の気持ちを再確認、乙女心が萌えあがる。"},{"spoiler":false,"text":"だいぶ前、まだ小さい子供だった頃……彼に一枚の絵を描いてもらったことがある。"}],"source":"egs","sourceCharacterId":"26472","sourceWorkId":"6085","spoiler":false},{"segments":[{"spoiler":false,"text":"小学校のときの同級生だったが、今回も編入した璃遠と同級生に。クラス委員長。璃遠の前に出るとすぐにツンツンしてしまうが、実は好きでしょうがないツンデレキャラ。胸が少し小さめなのを気にしていて、いつもミルクを飲んでいる。"},{"spoiler":false,"text":"小学校の頃、絵が抜群に上手かった璃遠に憧れ、現在芸術部所属。璃遠が転校してきた事により、自分の気持ちを再確認、乙女心が萌えあがる。"}],"source":"bangumi","sourceCharacterId":"147250"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89f7a26914a711430dbf5840c9944ead044555d95d2cd0be3bf35afcfa55c9a9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a43b12a62e253f3d84348d20cb5e886ed0dd9b3cd1b80530be2a0f94fed0059f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"芹園 みや","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14134","source":"vndb"}]},{"characterId":"char_c43365","characterName":"夢咲 ほのか","sourceIds":{"bangumi":[{"characterId":"147253","match":"exact-normalized-name-in-linked-work","subjectId":"267822"}],"egsCharacterIds":["26473"],"vndbCharacterId":"c43365"},"originalCharacterName":"夢咲 ほのか","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"hip":{"reviewState":"source-only","sou