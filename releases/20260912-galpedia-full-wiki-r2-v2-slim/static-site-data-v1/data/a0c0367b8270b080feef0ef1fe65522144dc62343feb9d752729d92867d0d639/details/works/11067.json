poiler":false,"text":"勘が鋭く、主人公のいやらしい妄想をズバリ言い当てたり、触れて欲しくないところを容赦なくえぐたっりと主人公を困らせる奔放な彼女だが、本当は、優しく思いやりがあり、主人公との接し方がわからず、意地悪している。"}],"source":"egs","sourceCharacterId":"17798","sourceWorkId":"11067","spoiler":false},{"segments":[{"spoiler":false,"text":"機関銃のように喋りまくる、奔放でイタズラ好きな女の子。"},{"spoiler":false,"text":"「変態にぃ～ちゃん」と言って、主人公になにかとちょっかいを出してくる。"},{"spoiler":false,"text":"勘がよく、主人公の妄想を言い当てたり、急所を容赦なくえぐる発言をして主人公には意地悪な娘と誤解される。いじけたり、すねたり、怒ったりと感情表現が豊か。"},{"spoiler":false,"text":"性根は優しく頑張り屋で、本当は意地悪を言うこと以外に主人公との関わり方が分からず悩んでる。"}],"source":"bangumi","sourceCharacterId":"210620"}],"profileFacts":[{"label":"胸围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"17798","sourceWorkId":"11067","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"17798","sourceWorkId":"11067","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"17798","sourceWorkId":"11067","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"65 cm","valueContext":null,"source":"egs","sourceCharacterId":"17798","sourceWorkId":"11067","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46f4ef3fb0d11220072d90326d7f2a665538dfa13540774fb254f4166ea23634.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00c09ec694c4dd87f23cebb7c155879b0a7f47c83794c17462f60c97d9890c5a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮沢ゆあな","creatorId":"vndb:s830","sourcePersonId":"vndb:s830","canonicalEntityId":"vndb:s830","name":"宮沢ゆあな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230206:210620:5915:1","source":"bangumi"}]},{"characterId":"char_c19058","characterName":"琴浦 桜","sourceIds":{"bangumi":[{"characterId":"21061