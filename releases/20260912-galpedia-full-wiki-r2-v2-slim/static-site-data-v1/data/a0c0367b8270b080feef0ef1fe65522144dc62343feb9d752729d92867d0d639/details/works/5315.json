ue":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"159"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shion is an average girl who lives with her parents and older sister, who is a teacher at her highschool. She plays a little piano and likes to compose songs and sing, a hobby she keeps to herself. One day by chance a piece of her music is discovered by Touya, and she is prompted to help recruit members and compose for the school band."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c28921"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d9396c96ebfcbaf070dbf55a272ed7f33a1e523e48b09e3e1c94572bd8a3a71.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf63357ba8964c3feaf0d3862b869b4584d5b5d33da1bb7a3f6ec56349be2633.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c28922","characterName":"黒崎 冬弥","sourceIds":{"vndbCharacterId":"c28922"},"originalCharacterName":"黒崎 冬弥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"116"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Touya is a friend of Shion's from childhood, and a transfer student at her high school. He is a bit unfriendly and snappish, somewhat of an \"outlaw\" at the school. However, underneath his tough appearance he is actually a bit introverted and softhearted, who likes helping weak people, cooking, and cats. He is the vocalist in the band."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c28922"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b2988415c30b30f1aca933404937e5c6f9e94edd337b5e1a44f48003519fd6c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67d02ffdda2330800b8f7c4cbff9f1bd4825a0ab1bad055a73c6e8e13f12197d.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c28923","characterName":"二階堂 要","sourceIds":{"vndbCharacterId":"c28923"},"originalCharacterName":"二階堂 要","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1102"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"64"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kaname is the student council president of the high school, who commutes to school. He is very intellectual and cool, and keeps a calm demeanor and a clear head, even though he has problems at home with his father, who is a busy doctor. He likes to do crossword puzzles as a hobby. He is the guitarist in the band."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c28923"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c9c81c1b5b1808aa42fd71a102f37c177dd83d0fdbef637fecdfae087797d7e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c5ffef2b5b507815635b06a94f3387817ae4e03d4ac8b33dcca5ab01c77b330.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c28924","characterName":"カイル・マクティアナン","sourceIds":{"vndbCharacterId":"c28924"},"originalCharacterName":"カイル・マクティアナン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"611"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"68"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kyle is an international exchange student from Britain. He has a very bright and gentle personality, and he treats everyone friendly without discrimination, making him very popular at the school: especially with the girls. He enjoys studying flowers and constellations. He plays the bass in the band."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c28924"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8eb2780bb2624eac6ecd10c764d276af93660d112e2223f690fe8658ed134b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/635a70c54085ec59f9da314788a79a5c53b3a32df8b403d0046beeba7dfc13d6.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c28925","characterName":"住吉 平太","sourceIds":{"vn