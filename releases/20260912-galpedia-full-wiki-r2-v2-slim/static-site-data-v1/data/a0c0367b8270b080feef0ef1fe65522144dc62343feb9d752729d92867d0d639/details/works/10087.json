iler":false,"text":"「くんくん……あなたから諭吉くんや英世くんの臭いがするわ！」"}],"source":"egs","sourceCharacterId":"19104","sourceWorkId":"10087","spoiler":false},{"segments":[{"spoiler":false,"text":"普段の飲食店にコスプレ要素を取り入れて、急成長をさせた手腕を認められ、百貨店へのテナント出店の際にパートから店長へ抜擢された。"},{"spoiler":false,"text":"可憐とのがめついテナント料の交渉で、破格の条件を引き出した。"},{"spoiler":false,"text":"競争相手になりそうな、乳々飯店の店主を色仕掛けで篭絡しようとあの手この手で迫ってくる。"},{"spoiler":false,"text":"主人公は可憐に弱みを握られているので、那奈美の頼みを断るしかないのだが、しつこく言い寄ってくる。"},{"spoiler":false,"text":"「くんくん……あなたから諭吉くんや漱石くんの臭いがするわ！」"}],"source":"bangumi","sourceCharacterId":"54388"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"19104","sourceWorkId":"10087","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"19104","sourceWorkId":"10087","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"19104","sourceWorkId":"10087","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2a73231d0e65428c139c6af4e0dbd5953af5e1b4f31d97505bcdfaf82833496.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06568537e5e849aa9a80e33d8506d0a573469ec4cce34c207e8d0eb1dc1e29ce.webp","width":124,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:215933:54388:8055:1","source":"bangumi"}]},{"characterId":"char_c41888","characterName":"大原 さゆり","sourceIds":{"bangumi":[{"characterId":"54389","match":"exact-normalized-name-in-linked-work","subjectId":"215933"}],"egsCharacterIds":["19105"],"vndbCharacterId":"c41888"},"originalCharacterName":"大原 さゆり","characterNa