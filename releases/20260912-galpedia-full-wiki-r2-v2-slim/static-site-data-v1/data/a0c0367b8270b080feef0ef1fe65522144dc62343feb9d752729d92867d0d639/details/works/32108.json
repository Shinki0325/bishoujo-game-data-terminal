text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c87456"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b9732992eee6d51756ce816f4069b57a035fd779e916cc207493875cb3a78e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e59077ace334c129431315d68eb0a49ef076adf75e2bf55dd78fc601341ce2e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茶介","creatorId":"vndb:s501","sourcePersonId":"vndb:s501","canonicalEntityId":"vndb:s501","name":"加藤 将之","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81289","source":"vndb"}]},{"characterId":"char_vndb_c87457","characterName":"我妻 タイガ","sourceIds":{"vndbCharacterId":"c87457"},"originalCharacterName":"我妻 タイガ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"26"},"birthday":{"reviewState":"source-only","source":"vndb","value":"701"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"188"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Entered the police force straight from high school by passing the police academy exam, joining the Public Security Bureau as a non-career-track officer."},{"spoiler":false,"text":"After the incident, he is assigned to Sonogi’s security detail. Quiet and composed, but extraordinarily skilled."},{"spoiler":false,"text":"Rather than stepping into the spotlight himself, he prefers to devote his loyalty to someone he deems worthy."},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c87457"}],"profileFacts":[],"me