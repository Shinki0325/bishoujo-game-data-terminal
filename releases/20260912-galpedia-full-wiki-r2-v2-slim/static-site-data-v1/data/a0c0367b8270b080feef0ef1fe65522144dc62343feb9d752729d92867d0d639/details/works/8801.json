cast":[{"characterId":"char_c16799","characterName":"上月 和菜","sourceIds":{"bangumi":[{"characterId":"11346","match":"exact-normalized-name-in-linked-work","subjectId":"1129"},{"characterId":"11346","match":"exact-normalized-name-in-linked-work","subjectId":"410409"}],"egsCharacterIds":["24524"],"vndbCharacterId":"c16799"},"originalCharacterName":"上月 和菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"21"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"319"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl pursuing her dreams of acting in Tokyo."},{"spoiler":false,"text":"She can’t forget about her sister, who went missing five years ago. When she receives information about someone sighting her sister, she asks Shuugo to look for her, to her parents’ opposition."},{"spoiler":false,"text":"Contrary to her dignified appearance, she possesses a bright and cheerful personality, and tends to cause chaos with her actions."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c16799"},{"segments":[{"spoiler":false,"text":"「それでも、わたしは諦めたりしませんっ！」"},{"spoiler":false,"text":"舞台女優を目指し、東京で活動をしている少女。"},{"spoiler":false,"text":"五年前に失踪した姉を忘れられず、ある目撃情報をきっかけに、両親の反対を押し切って秋五に姉の捜索を依頼する。"},{"spoiler":false,"text":"楚々とした外見とは裏腹に活発で明るい性格を持ち、その行動が周囲に混乱を引き起こすこともある。"}],"source":"egs","sourceCharacterId":"24524","sourceWorkId":"33654","spoiler":false},{"segments":[{"spoiler":false,"text":"想要成为舞台女优，在东京进行着活动的少女。老家是逗子有权有势的有钱人家，也就是所谓的不知世事的深闺小姐。"},{"spoiler":false,"text":"没法忘记五年前失踪的姐姐，以某个目击情报为契机，不顾双亲的反对，委托秋五找寻姐姐的下落。"},{"spoiler":false,"text":"和楚楚可怜的外貌相反，性格活泼开朗，她的行动有时也会给周围人带来混乱。"},{"spoiler":false,"text":"此外，还积极地接触回避着人际交往的主人公，渐渐地溶化了他那顽固不化的心灵。"}],"source":"bangumi","sourceCharacterId":"11346"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7df05304d1c7720f855d990b60abf4b59d791a29352b622ea4c0ecac8106047a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d5f323e72fafb6d532a3f343b65e571f711a47581a955e46f08a822bfdfa482.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安田未央","creatorId":"vndb:s25","sourcePersonId":"vndb:s25","canonicalEntityId":"vndb:s25","name":"安田 未央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:6629:11346:4957:1","source":"bangumi"}]},{"characterId":"char_c16800","characterName":"高城 七七","sourceIds":{"bangumi":[{"characterId":"11348","match":"exact-normalized-name-in-linked-work","subjectId":"1129"},{"characterId":"11348","match":"exact-normalized-name-in-linked-work","subjectId":"410409"}],"egsCharacterIds":["24526"],"vndbCharacterId":"c16800"},"originalCharacterName":"高城 七七","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"405"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"67"},"height":{"reviewState":"no-conflict","source":"vndb","value":"143"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"70"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"47"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"34"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The younger sister of Natsume and Shuugo. Currently enrolled in Kayou Private Academy, located in Ueno."},{"spoiler":false,"text":"A genius girl, with encyclopedic knowledge and a strong memory. Her eccentric words and deeds worry her brother, though she pays that no mind."},{"spoiler":false,"text":"Incredibly interested in the bizarre serial murders in Ueno, she begins her own investigation despite Shuugo's attempts to dissuade her."},{"spoiler":false,"text":"Edited from MangaGamer"}],"source":"vndb","sourceCharacterId":"c16800"},{"segments":[{"spoiler":false,"text":"「真実は無数にあるんだ。ボクとキミの見える世界が違うようにね」"},{"spoiler":false,"text":"秋五の妹。現在、上野にある私立華陽学園に通っている。"},{"spoiler":false,"text":"兄の心配をよそにエキセントリックな言動を繰り返す、博覧強記の天才少女。"},{"spoiler":false,"text":"上野の連続猟奇事件に並々ならぬ興味を持ち、秋五の静止を無視して独自の捜査を開始する。"}],"source":"egs","sourceCharacterId":"24526","sourceWorkId":"33654","spoiler":false},{"segments":[{"spoiler":false,"text":"秋五的妹妹。目前就读于坐落于上野的私立华阳学园。不顾兄长的担心，反复作出些古怪的言行，是个博闻强记的天才少女。"},{"spoiler":false,"text":"对世间的一般常识嗤之以鼻，仅遵循本人的价值观而行动。由于性格如此，朋友之类的很少，过着孤高的学生生活，但本人看似毫不在意。"},{"spoiler":false,"text":"对上野的连续猎奇事件有着非同一般的兴趣，无视秋五的制止，开始了单独搜查。"}],"source":"bangumi","sourceCharacterId":"11348"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c72360931d43f57593fda8cc45c54b5b7222dd7752d93996435c1ccb0e5b05f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/4120208be77f16d154e31726ae6d6b5bced97ff223305f645a3d37c8cab599e2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:6629:11348:4832:1","source":"bangumi"}]},{"characterId":"char_c22459","characterName":"蒼木 冬史","sourceIds":{"bangumi":[{"characterId":"11349","match":"exact-normalized-name-in-linked-work","subjectId":"1129"},{"characterId":"11349","match":"exact-normalized-name-in-linked-work","subjectId":"410409"}],"egsCharacterIds":["24527"],"vndbCharacterId":"c22459"},"originalCharacterName":"蒼木 冬史","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"176"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A woman in an executive position of an organization called the ”Hand of Death” that’s based in Ueno."},{"spoiler":false,"text":"She’s an old acquaintance of Shuugo’s from his days as a police detective, and the two of them are good friends, who let their guard down around each other."},{"spoiler":false,"text":"Her physical capabilities are extraordinary, and she possesses a strength that makes her one-armed handicap trivial."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c22459"},{"segments":[{"spoiler":false,"text":"上野界隈を拠点とする組織『死の腕』の幹部を努める女性。"},{"spoiler":false,"text":"秋五とは警察官時代からの古い付き合いで、互いに気を許した親友同士。"},{"spoiler":false,"text":"その運動能力は凄まじく、隻腕と言うハンデを感じさせない強さを誇っている。"}],"source":"egs","sourceCharacterId":"24527","sourceWorkId":"33654","spoiler":false},{"segments":[{"spoiler":false,"text":"现在作为自由记者而活动者，过去是以上野为中心活动的组织“死之腕”（黑道）的干部。"},{"spoiler":false,"text":"其运动能力极其惊人，夸耀着让人感觉不到独臂这个缺陷的强大。"},{"spoiler":false,"text":"经过“千里教事件之后”，作为记者的灵魂觉醒了，现在独自从事着调查社会问题的工作。"},{"spoiler":false,"text":"尽管各自的立场与所应守护之物不同，但却是彼此信赖的好友。"},{"spoiler":false,"text":"和伶俐的外貌不相称，性格木讷笃于仁义，屡次向陷入绝境的主人公伸出援手。"},{"spoiler":false,"text":"“……你真是坏呀，比秋五还会麻烦人。”"}],"source":"bangumi","sourceCharacterId":"11349"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7b035b2c25c1de342c09dd390595a083ee10b592443d7bbf6535ffdc57ce6ff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26373fcb9b071f316bed7beb8534d8cc54383b93bd525ffeea1125c7b3cce771.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森井 花音","creatorId":"vndb:s49","sourcePersonId":"vndb:s49","canonicalEntityId":"vndb:s49","name":"森井 花音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8687","source":"vndb"}]},{"characterId":"char_c25665","characterName":"凛","sourceIds":{"bangumi":[{"characterId":"11350","match":"exact-normalized-name-in-linked-work","subjectId":"1129"},{"characterId":"11350","match":"exact-normalized-name-in-linked-work","subjectId":"410409"}],"egsCharacterIds":["24529"],"vndbCharacterId":"c25665"},"originalCharacterName":"凛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1202"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A woman working at the brothel ”Yukishiro.”"},{"spoiler":false,"text":"She has such a bright, carefree personality that it’s hard to imagine her earning her living as a prostitute, and she’s especially close to Shuugo."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c25665"},{"segments":[{"spoiler":false,"text":"遊郭『雪白』で働く女性。"},{"spoiler":false,"text":"娼婦の身の上のを感じさせない明るく屈託のない性格で、秋五とは特に仲がよい。"}],"source":"egs","sourceCharacterId":"24529","sourceWorkId":"33654","spoiler":false},{"segments":[{"spoiler":false,"text":"在妓院『雪白』工作的女性。"},{"spoiler":false,"text":"性格开朗无忧无虑，让人完全感觉不到妓女这个身份，和秋五的关系特别好。"}],"source":"bangumi","sourceCharacterId":"11350"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c5c54fa3058a204aa95d0867b32c232d647cfea63c8e695f55344445ed9d20a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f96381ea77d95da25456eb61d66ee15b25f6c7e7f8ed022e9d794fc0bb6e9f2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"河原木志穂","creatorId":"vndb:s13","sourcePersonId":"vndb:s13","canonicalEntityId":"vndb:s13","name":"河原木 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:6629:11350:4422:1","source":"bangumi"}]},{"characterId":"char_c27169","characterName":"綾崎 楼子","sourceIds":{"bangumi":[{"characterId":"11351","match":"exact-normalized-name-in-linked-work","subjectId":"1129"},{"characterId":"11351","match":"exact-normalized-name-in-linked-work","subjectId":"410409"}],"egsCharacterIds":["24530"],"vndbCharacterId":"c27169"},"originalCharacterName":"綾崎 楼子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"813"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who attends Kayou Private Academy. Nana’s classmate."},{"spoiler":false,"text":"Her great grandmother was a Caucasian, so her hair is almost blonde."},{"spoiler":false,"text":"She fell in love at first sight with Shuugo when they met back when he was a police officer, and even now still holds onto those pure feelings."},{"spoiler":false,"text":"Edited from MangaGamer"}],"source":"vndb","sourceCharacterId":"c27169"},{"segments":[{"spoiler":false,"text":"私立華陽学園に通う少女。七七の同級生。"},{"spoiler":false,"text":"曾祖母が白人だったため、髪の毛がブロンドがかっている。"},{"spoiler":false,"text":"秋五の警察時代のある事件で知り合い、一目惚れ、その想いを今も健気に持ち続けている。"}],"source":"egs","sourceCharacterId":"24530","sourceWorkId":"33654","spoiler":false},{"segments":[{"spoiler":false,"text":"就读于私立华阳学园的少女。七七的同级生。"},{"spoiler":false,"text":"因为曾祖母是白人的关系，头发带了点金黄色。"},{"spoiler":false,"text":"在秋五警察时代的某个事件中结识，对其一见钟情，至今仍然对他一往情深。"},{"spoiler":false,"text":"慢性子的天然呆少女。没啥常识，不会在意他人的眼光和意见。"}],"source":"bangumi","sourceCharacterId":"11351"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33f24a5f7ba632f93261a73128b867d956c37c821f22e3bf113aee9b3ae2ff78.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a083cf7a1769e3cafd27af76f36bb787913173a607bed708031aeb0e923eff4f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"萩原えみこ","creatorId":"vndb:s867","sourcePersonId":"vndb:s867","canonicalEntityId":"vndb:s867","name":"萩原 えみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:6629:11351:4854:1","source":"bangumi"}]},{"characterId":"char_c4086","characterName":"高城 秋五","sourceIds":{"bangumi":[{"characterId":"11544","match":"exact-normalized-name-in-linked-work","subjectId":"1129"},{"characterId":"11544","match":"exact-normalized-name-in-linked-work","subjectId":"1130"},{"characterId":"11544","match":"exact-normalized-name-in-linked-work","subjectId":"410409"}],"egsCharacterIds":["12269"],"vndbCharacterId":"c4086"},"originalCharacterName":"高城 秋五","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"220"},"bloodType":{"reviewState":"no-conflict","source":"bangumi","value":"4"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"70"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A private detective based in Ueno. Used to work with Reiji and Uozumi and still helps out his friends when needed."},{"spoiler":true,"text":"Married to Kazuna, a former client with whom he shares a lot of history. Since she's currently pregnant, Shugo focuses on less dangerous tasks like investigating cheating spouses and searching for people in order to worry her less."},{"spoiler":false,"text":"From MangaGamer"},{"spoiler":false,"text":"He is the younger brother of Natsume, and older brother of Nana."}],"source":"vndb","sourceCharacterId":"c4086"},{"segments":[{"spoiler":false,"text":"職業：私立探偵"},{"spoiler":false,"text":"趣味：なし"},{"spoiler":false,"text":"『カルタグラ～ツキ狂イノ病～』の主人公。"},{"spoiler":false,"text":"玲人、魚住とは元同僚同士で、必要であれば今でも協力しあう間柄。"},{"spoiler":false,"text":"現在は、過去の出来事を振り切り和菜と結婚。"},{"spoiler":false,"text":"身重のため、実家に帰っている和菜を心配させないように、"},{"spoiler":false,"text":"浮気調査や人探しの依頼を中心に、物騒な依頼は受けないようにしている。"}],"source":"egs","sourceCharacterId":"12269","sourceWorkId":"10082","spoiler":false},{"segments":[{"spoiler":false,"text":"「大切なもの、オレは守り切れるだろうか」"},{"spoiler":false,"text":"本作の主人公。遊郭『雪白』に間借りして日々を過ごす成年。"},{"spoiler":false,"text":"元警察官という経歴を持ち、探偵業の真似事をして食い扶持を得ている。"},{"spoiler":false,"text":"かつての上司・有島警部より彼に人探しの依頼が持ち込まれた時、本作の物語は幕を開ける。"}],"source":"egs","sourceCharacterId":"12269","sourceWorkId":"33654","spoiler":false},{"segments":[{"spoiler":false,"text":"在上野当侦探。‘カルタグラ’（恋狱）的主人公。"},{"spoiler":false,"text":"在过去的事件之后与和菜结婚。现在由于和菜因身孕回娘家修养而处于独自工作的状态。"},{"spoiler":false,"text":"为了不让心爱的妻子担心，主要接受调查外遇、寻人之类的委托，拒绝了一些比较危险的委托。"},{"spoiler":false,"text":"和本作的主人公·时坂以及鱼住在参军时代、警察时代隶属同一上司麾下，现在有必要的话也会协助他们。"}],"source":"bangumi","sourceCharacterId":"11544"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/988b9afed214af4546d05bb6c154a94dd6d9ef706f8867667be614d54407d479.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e05774bf08f8227610ee476841d2698a4053d7cf1b5f6fa0e88beda18a89ebd6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡崎雅紘","creatorId":"vndb:s35","sourcePersonId":"vndb:s35","canonicalEntityId":"vndb:s35","name":"岡崎雅紘","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:6629:11544:16143:1","source":"bangumi"}]},{"characterId":"char_vndb_c16801","characterName":"上月 由良","sourceIds":{"vndbCharacterId":"c16801"},"originalCharacterName":"上月 由良","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"319"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"They met just before the war, in Zushi. Could an act of kindness turn into a lifetime of obsession? It's been 7 years since..."},{"spoiler":true,"text":"Shuugo's former lover, daughter of Kouzuki Keiichirou and a sister to Kazuna."}],"source":"vndb","sourceCharacterId":"c16801"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4476b3e02db15b35d0493c30aab4a22abbb6ae4292d43c9fa0e80b88888d5f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48e2d19aecb273f54d77778af34f53cf894724afa0b6d228b515b103496bc294.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"秋城 柚月","creatorId":"vndb:s25","sourcePersonId":"vndb:s25","canonicalEntityId":"vndb:s25","name":"安田 未央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8684","source":"vndb"}]},{"characterId":"char_vndb_c28760","characterName":"白河 綾音","sourceIds":{"vndbCharacterId":"c28760"},"originalCharacterName":"白河 綾音","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ayane, a runaway girl Sousuke encounters, hails from a well-to-do agribusiness family. Faced with an unsavory arranged marriage, she slipped away from her family and sought refuge in Tokyo."},{"spoiler":false,"text":"Sousuke once rescued Ayane just in the nick of time from a group of menacing street thugs, sparking a friendship as thick as thieves between them. Now residing in a dorm, Ayane stands as a steadfast friend and ally to Sousuke in his time of need."}],"source":"vndb","sourceCharacterId":"c28760"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4f2a34f08134e9b88d72244ff31e1956bb54dae57618be3bc5cd8a77a50e540.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36358dd2dceb0b17b31330b5d6c6739a12c29fc6d0a287bd8cad6634ca5544a8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風音","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8688","source":"vndb"}]},{"characterId":"char_vndb_c28762","characterName":"橘 美華夏","sourceIds":{"vndbCharacterId":"c28762"},"originalCharacterName":"橘 美華夏","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mikage, Sousuke's steadfast childhood friend, faced the tragic loss of her parents in the devastating Great Kanto Earthquake. From then on, she and the Kudou siblings forged an unbreakable bond, becoming a close-knit family in all but name."},{"spoiler":false,"text":"Now employed by a reputable magazine company, Mikage remains unwavering in her belief in Sousuke's innocence. Determined to right the wrong, she embarks on a personal quest to unravel the tangled threads of the murder case and vindicate her cherished friend."}],"source":"vndb","sourceCharacterId":"c28762"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53dea3c1139707dc1751834e027366589f4771c280fb8afa635c23249a10d387.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29d08a0e6a8e014ab29db7fc9d1fdc5f79405d0ef90ea2ba898f5ad0d456adf4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"うえおか あい","creatorId":"vndb:s13","sourcePersonId":"vndb:s13","canonicalEntityId":"vndb:s13","name":"河原木 志穂","roleCode":"voi