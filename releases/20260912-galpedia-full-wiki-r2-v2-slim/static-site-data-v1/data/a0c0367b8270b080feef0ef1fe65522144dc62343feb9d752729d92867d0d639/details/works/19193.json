tic-detail"},"actors":[{"creditedName":"阿澄 佳奈","creatorId":"vndb:s1189","sourcePersonId":"vndb:s1189","canonicalEntityId":"vndb:s1189","name":"阿澄 佳奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51753","source":"vndb"}]},{"characterId":"char_vndb_c77956","characterName":"八坂 真尋","sourceIds":{"vndbCharacterId":"c77956"},"originalCharacterName":"八坂 真尋","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A human boy who reluctantly finds himself under the protection of Nyaruko. He tends to attack aliens by stabbing or throwing forks whenever they make him angry. He appears to attack so fast that currently no alien has been able to dodge yet. At first he dislikes aliens and wants to kick them out, but as the story progresses he starts to become more tolerant toward their actions. He is attracted to Nyaruko (in her human form), but is put off by her aggressive advances at the same time. He has also kissed her a few times, the most prominent being their on-screen kiss during the events of the final OVA, Nyaruko F. According to Nyaruko and Kuuko, Mahiro's appearance is strangely attractive to aliens, which explains why Nyaruko falls in love with him after only looking at his profile, as well as why alien criminals wanted to kidnap him."}],"source":"vndb","sourceCharacterId":"c77956"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/366c12fd408af51280a56205bca50e3e19046558eb6b6bb08a5831157a8b34f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b450f2682cbf5287302a9aa05dadeb32c3a8a035a10c54b411d7e2151c33861.webp","width":133,"height":256,"source":"static-detail"},"actors":[{"creditedName":"喜多村 英梨","creatorId":"vndb:s269","sourcePersonId":"vndb:s269","canonicalEntityId":"vndb:s269","name":"喜多村 英梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51751","source":"vndb"}]},{"characterId":"char_vndb_c77957","characterName":"暮井 珠緒","sourceIds":{"vndbCharacterId":"c77957"},"originalCharacterName":"暮井 珠緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mahiro, Nyaruko, Kuuko, and Hasuta's classmate. Nicknamed \"Walking Speaker\". Very talkative, likes to gather and spread gossip among the class. She became a close friend to Nyaruko and often gives advise for her to pursue Mahiro, despite often feeling depressed as her plans fail. She actually has feelings toward Mahiro, but decided to give up and support Nyaruko since she feels that she is no match for her."}],"source":"vndb","sourceCharacterId":"c77957"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a5d50e2f8f489e90c90eac0a9ef345c6db6128058a89043f9f0190288838b35.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91d310621fcd6b3b1be1b047fdd682a06a814f3eb322917ae6e60b6965ed085c.webp","width":174,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大坪 由佳","creatorId":"vndb:s6133","sourcePersonId":"vndb:s6133","canonicalEntityId":"vndb:s6133","name":"大坪 由佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51756","source":"vndb"}]},{"characterId":"char_vndb_c77958","characterName":"ルーヒー・ジストーン","sourceIds":{"vndbCharacterId":"c77958"},"originalCharacterName":"ルーヒー・ジストーン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Luhy Distone is a Cthulhi, also known as the star-spawn of Cthulhu, who was working at Cthulhu Corp., a space company that produces video games and other entertainment that rivals that of CCE. Like Hasuta, she tried to get intel of Earth's entertainment from Yoriko, while preparing to show the new developed video game platform. The video game platform turns out to be a disaster, being too high-end to ever be affordable to consumers, and is destroyed by Kuuko. Luhy was then fired by Cthulhu Corp. and become a vendor selling Takoyaki. She starts to have feelings toward Hasuta in the latter part of the story and declares to Mahiro that she will become his opponent."}],"source":"vndb","sourceCharacterId":"c77958"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1ff67fbebf4b2fa9acbb295d931f8701113eae22f98471b1e2c98f72c3b1b7a0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19283bbe3c644bb9885873659dc889f46157618f829dd6c0503aaf5482e804eb.webp","width":179,"height":256,"source":"static-detail"},"actors":[{"creditedName":"國府田 マリ子","creatorId":"vndb:s5173","sourcePersonId":"vndb:s5173","canonicalEntityId":"vndb:s5173","name":"國府田 マリ子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51755","source":"vndb"}]},{"characterId":"char_vndb_c77959","characterName":"グタタン","sourceIds":{"vndbCharacterId":"c77959"},"originalCharacterName":"グタタン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Only appears in the 2012 anime, Ghutatan comes to Earth from the planet Ghatanothoa for Mahiro to take care of her as if he were babysitting her. She is kind of childish for an alien, as seen in episode 11 when the Nyarlathotepian trio chases Mahiro for her. She has a butler named Roy Fooger the Lloigor. It was revealed that in episode 12 that Lloigor has been using Mahiro so he can bring all of Earth's adult games into space, as Ghutatan has completed her purpose on Earth. After Lloigor is destroyed, Mahiro and the Nyarlathotepian trio wish Ghutatan goodbye as she departs for Ghatanothoa."}],"source":"vndb","sourceCharacterId":"c77959"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/2131214413c429fc50ac9ad6d543a691267aa9bbd8714e21fd0d90bdab514657.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/7964bdccc8efdbd68a5eddba3cd574241f97e37577521127aec2db14a9655807.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三上 枝織","creatorId":"vndb:s7957","sourcePersonId":"vndb:s7957","canonicalEntityId":"vndb:s7957","name":"三上 枝織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51757","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:2282","sourceCompanyId":"egs:brand:2282","canonicalEntityId":"egs:brand:2282","name":"MAGES.(5pb.)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:19193:2282","source":"egs"},{"companyId":"vndb:p146","sourceCompanyId":"vndb:p146","canonicalEntityId":"vndb:p146","name":"MAGES.","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:30069:v12178","source":"vndb"},{"companyId":"vndb:p146","sourceCompanyId":"vndb:p146","canonicalEntityId":"vndb:p146","name":"MAGES.","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:32035:v121