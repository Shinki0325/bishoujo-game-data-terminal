oiler":false,"text":"早くに母を病で失い、歳の離れた弟を我が子同然に育ててきた。"},{"spoiler":false,"text":"祖母から教わった料理の腕前は職人レベル。"},{"spoiler":false,"text":"個人病院を経営していた父が事故で亡くなり、親類たちに家財全てを奪われてしまう。"},{"spoiler":false,"text":"そして膨大な借金を押し付けられ、弟と一緒に路頭へ迷うところで かおりと出会う。"}],"source":"bangumi","sourceCharacterId":"54221"}],"profileFacts":[{"label":"特技","source":"bangumi","sourceCharacterId":"54221","value":"家事全般"},{"label":"趣味","source":"bangumi","sourceCharacterId":"54221","value":"料理、弟の世話"},{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"14932","sourceWorkId":"24591","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"14932","sourceWorkId":"24591","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"14932","sourceWorkId":"24591","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"14932","sourceWorkId":"24591","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"14932","sourceWorkId":"24591","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"48 kg","valueContext":null,"source":"egs","sourceCharacterId":"14932","sourceWorkId":"24591","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f7270316d5b11bd38c43b29977ebb37ad458c3cec98556b16601fb27d05fb64.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/393f6716f33f1f2b268f7b259909dcd83c47b36e3671fa9772ce49436bd62358.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c58412","characterName":"成宮 志郎","sourceIds":{"bangumi":[{"characterId":"54222","match":"exact-normalized-name-in-linked-work","subjectId":"211806"}],"egsCharacterIds":["14934"],"vndbCharacterId":"c58412"},"originalCharacterName":"成宮 志郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『成宮 京子』の弟。母の忘れ形見であり、優しい女顔の美少年。華奢で童顔、実年齢よりも下に見られがち。"},{"spoiler":false,"text":"素直でいい子だが、流されやすい性格。"},{"spoiler":false,"text":"誕生と同時に母を亡くした為、姉の京子に育てられて、姉には甘えん坊な一面を見せる。第二次性徴期に入ってからは、そんな姉の事を『女』として強く意識する様になる。そして、かおりとの衝撃の出会いにより『女』を知り、一気に快楽に目覚めていく……"}],"source":"egs","sourceCharacterId":"14934","sourceWorkId":"24591","spoiler":false},{"segments":[{"spoiler":false,"text":"京子の弟。 母の忘れ形見である女顔の美少年。"},{"spoiler":false,"text":"素直で良い子だが、流されやすい性格をしている。"},{"spoiler":false,"text":"姉に育てられたため甘えん坊な面が目立つが、"},{"spoiler":false,"text":"第二次性徴期に入って 姉に強く“女”を意識するようになる。"},{"spoiler":false,"text":"そしてかおりとの出会いによって女を知り、一気に快楽に目覚めていく。"}],"source":"bangumi","sourceCharacterId":"54222"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36c515ce4dd0821c59f49187595e3e00dee3b5aefeb9343be959fa0be189234e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16ace28a3275460d4916546296e46ffa196b1ecefce7dcd82cb525639ebe84f2.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:296","sourceCompanyId":"egs:brand:296","canonicalEntityId":"egs:brand:296","name":"Mink","roleCodes":["brand"],"identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-brand:24591:296","source":"egs"},{"companyId":"vndb:p306","sourceCompanyId":"vndb:p306","canonicalEntityId":"vndb:p306","name":"ミンク","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:57476:v20790","source":"vndb"},{"companyId":"vndb:p6854","sourceCompanyId":"vndb:p6854","canonicalEntityId":"vndb:p6854","name":"株式会社ミンク","role