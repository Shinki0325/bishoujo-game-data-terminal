{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"13726","model":{"presentationWorkId":"vndb:v5032","staff":{"artwork":[{"creditedName":"相川亜利砂(あいかわ亜利砂)","creatorId":"vndb:s2040","sourcePersonId":"egs:creator:142","canonicalEntityId":"vndb:s2040","name":"相川亜利砂(あいかわ亜利砂)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:88174","source":"egs"}],"scenario":[{"creditedName":"若林浩太郎(鏃キロク)","creatorId":"vndb:s2555","sourcePersonId":"egs:creator:2257","canonicalEntityId":"vndb:s2555","name":"若林浩太郎(鏃キロク)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:88175","source":"egs"}],"music":[{"creditedName":"どんまる","creatorId":"vndb:s1454","sourcePersonId":"egs:creator:6872","canonicalEntityId":"vndb:s1454","name":"どんまる","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:127229","source":"egs"}],"other":[{"creditedName":"馬場隆博(BABA.DOS)","creatorId":"vndb:s6956","sourcePersonId":"egs:creator:4576","canonicalEntityId":"vndb:s6956","name":"馬場隆博(BABA.DOS)","detail":"エグゼクティブプロデューサー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:127230","source":"egs"},{"creditedName":"丘野塔也(天雲玄樹)","creatorId":"vndb:s3805","sourcePersonId":"egs:creator:1627","canonicalEntityId":"vndb:s3805","name":"丘野塔也(天雲玄樹)","detail":"ディレクター","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:127231","source":"egs"},{"creditedName":"丘野 塔也","creatorId":"vndb:s3805","sourcePersonId":"vndb:s3805","canonicalEntityId":"vndb:s3805","name":"天雲 玄樹","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:54727","source":"vndb"},{"creditedName":"馬場 隆博","creatorId":"vndb:s6956","sourcePersonId":"vndb:s6956","canonicalEntityId":"vndb:s6956","name":"馬場 隆博","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:54728","source":"vndb"}]},"cast":[{"characterId":"char_c67056","characterName":"ユーリ","sourceIds":{"bangumi":[{"characterId":"151253","match":"exact-normalized-name-in-linked-work","subjectId":"82162"}],"egsCharacterIds":["17342"],"vndbCharacterId":"c67056"},"originalCharacterName":"ユーリ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Main character. Also known as Yuri."},{"spoiler":false,"text":"He has been prejudiced from an early age, and his character is completely distorted, extremely self-centered, and selfish. He will do whatever it takes to fulfill his desires, but he is not always thorough and often makes mistakes."},{"spoiler":false,"text":"He is also a petty person, and when he makes a mistake, he is unusually quick to run away from it."},{"spoiler":false,"text":"He became tired of life in the royal family and left the country as soon as he came of age at the age of 15. He was a carefree adventurer, relying on his swordsmanship, when he heard that the king was to be elected, he returned home."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c67056"},{"segments":[{"spoiler":false,"text":"「キングダム」王家第二王子で、本作の主人公。"},{"spoiler":false,"text":"通称“ユーリ”。"},{"spoiler":false,"text":"妾の子として生まれたため、幼少から王族で不遇を強いられ、すっかり性格が歪む。"},{"spoiler":false,"text":"極めて自己中心的でワガママ。計算高く、欲望に正直で手段を選ばない。"},{"spoiler":false,"text":"反面、非常に心根が弱く、小物風情を漂わせる。逃げ足が異常に早い。"},{"spoiler":false,"text":"王家の生活に嫌気がさし、15歳で成人すると同時に出奔。"},{"spoiler":false,"text":"気ままな冒険家業を生きていたが、次期国王選出の話を聞いて舞い戻る。"}],"source":"egs","sourceCharacterId":"17342","sourceWorkId":"11214","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公。通称・ユーリ。"},{"spoiler":false,"text":"妾の子として生まれ、幼い頃から偏見を受けて育ったため人間性はすっかり歪み、極めて自己中心的でワガママな性格になってしまった。"},{"spoiler":false,"text":"計算高く、己の欲望を満たすためには手段を選ばないが、詰めが甘く失敗することも多い。"},{"spoiler":false,"text":"小心者で小物的な所もあり、失敗した時の逃げ足は異常に早い。"},{"spoiler":false,"text":"王家での生活に嫌気がさし、15歳で成人すると同時に出奔。"},{"spoiler":false,"text":"剣の腕を頼りに気ままな冒険者稼業をしていたが、次期国王選出の話を聞きつけ、帰還する。"}],"source":"bangumi","sourceCharacterId":"151253"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c67056","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"17342","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"17342","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"151253","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2c682c10aa73be4d605f780b1dd546330baffa8a177c45b50c3532c4b6ab1b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/2467d9672a8dd4f8cf861930f76e5be29b48f2cc7ba2a6380d1d0fdf45ec9daa.webp","width":109,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c67062","characterName":"ロコ","sourceIds":{"bangumi":[{"characterId":"144774","match":"exact-normalized-name-in-linked-work","subjectId":"82162"},{"characterId":"144774","match":"exact-normalized-name-in-linked-work","subjectId":"82168"}],"egsCharacterIds":["12570"],"vndbCharacterId":"c67062"},"originalCharacterName":"ロコ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An elven boy who has strayed from the forest."},{"spoiler":false,"text":"He is Yuri's brother in arms from when Yuri was an adventurer, and now remains a loyal follower."},{"spoiler":false,"text":"He used to be a bandit and has a variety of skills, including picking and archery."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c67062"},{"segments":[{"spoiler":false,"text":"ユーリの相棒。エルフの少年。"},{"spoiler":false,"text":"森からはぐれて盗賊で命をつないでいたときユーリと出会う。"},{"spoiler":false,"text":"剣の腕が確かなので、性格は目をつぶって一緒に旅に出る。"},{"spoiler":false,"text":"ユーリを「アニキ」と慕う。"}],"source":"egs","sourceCharacterId":"12570","sourceWorkId":"11214","spoiler":false},{"segments":[{"spoiler":false,"text":"【ユーリの従者】"},{"spoiler":false,"text":"森からはぐれたエルフの少年。"},{"spoiler":false,"text":"ユーリが冒険者をしていた頃からの弟分で、今では従者としてコキ使われている。"},{"spoiler":false,"text":"かつては盗賊をしており、ピッキングや弓術など多彩な技能を持つ。"}],"source":"egs","sourceCharacterId":"12570","sourceWorkId":"13726","spoiler":false},{"segments":[{"spoiler":false,"text":"森からはぐれたエルフの少年で、盗賊として人里で生きるうちにユーリと出会い、一緒に旅をするようになる。"},{"spoiler":false,"text":"性格はともかく剣の実力は確かなユーリを、アニキと慕っている。"},{"spoiler":false,"text":"故郷へ帰還するユーリにくっついて、王国へとやってくる。"},{"spoiler":false,"text":"「～ッス」「オイラは～」といった口調が特徴的な、元気で明るい性格。"}],"source":"bangumi","sourceCharacterId":"144774"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c67062","value":"m"},{"comparisonValue":"m","source":"egs","sourceCharacterId":"12570","value":"男性"},{"comparisonValue":"m","source":"egs","sourceCharacterId":"12570","value":"男性"},{"comparisonValue":"f","source":"bangumi","sourceCharacterId":"144774","value":"女"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c26cb229be9cc829747d4d1c1e43a49db997dd2cce23d46fad1595736e79b95d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35d0827d63b611732c8d961879a6ae223fa11f8c9ad1953c090ca5ada7984a99.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由宇翼","creatorId":"vndb:s1420","sourcePersonId":"vndb:s1420","canonicalEntityId":"vndb:s1420","name":"あさり☆","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:82168:144774:18193:1","source":"bangumi"}]},{"characterId":"char_c67197","characterName":"エステル＝アルフヘイム","sourceIds":{"bangumi":[{"characterId":"148182","match":"exact-normalized-name-in-linked-work","subjectId":"82168"}],"egsCharacterIds":["12567"],"vndbCharacterId":"c67197"},"originalCharacterName":"エステル＝アルフヘイム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Princess of Alfheim, a kingdom of elves. She is a skilled swordswoman who wields dual mithril-silver swords with deadly proficiency."},{"spoiler":false,"text":"She has a brusque personality and is inflexible and stubborn. Despite her manly personality, her appearance is breathtakingly beautiful and captivates all who see her."},{"spoiler":false,"text":"She has flowing golden hair, breasts so full that it is hard to believe that she is an elf, and a toned, supple body line."},{"spoiler":false,"text":"She is worried about the invasion from the north, and travels in the surrounding areas of Alfheim requesting reinforcements. She is asked by the King of a Kingdom to offer her body in exchange for reinforcements."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c67197"},{"segments":[{"spoiler":false,"text":"【亡国に瀕する、エルフたちの女王】"},{"spoiler":false,"text":"エルフの王国・アルフヘイムの王女。"},{"spoiler":false,"text":"ミスリル銀の双刀の使い手で、風のような太刀筋をした凄腕の剣士。"},{"spoiler":false,"text":"性格は無愛想で、融通の利かない頑固者。"},{"spoiler":false,"text":"そんな男勝りの性格とは裏腹に、その容姿は息を飲むほど美しく、見た者すべてを虜にするほど。"},{"spoiler":false,"text":"流れるような金色の髪に、エルフとは思えないほど豊かな乳房、引き締まったしなやかなボディラインを持つ。"},{"spoiler":false,"text":"北方より侵略を受けるアルフヘイムを憂い、援軍を乞うために諸国を巡っている。"},{"spoiler":false,"text":"キングダム国王より、援軍と引き換えにその肉体を捧げるように求められる。"}],"source":"egs","sourceCharacterId":"12567","sourceWorkId":"13726","spoiler":false},{"segments":[{"spoiler":false,"text":"エルフの王国・アルフヘイムの王女。"},{"spoiler":false,"text":"ミスリル銀の双刀の使い手で、風のような太刀筋をした凄腕の剣士。"},{"spoiler":false,"text":"性格は無愛想で、融通の利かない頑固者。"},{"spoiler":false,"text":"そんな男勝りの性格とは裏腹に、その容姿は息を飲むほど美しく、見た者すべてを虜にするほど。"},{"spoiler":false,"text":"流れるような金色の髪に、エルフとは思えないほど豊かな乳房、引き締まったしなやかなボディラインを持つ。"},{"spoiler":false,"text":"北方より侵略を受けるアルフヘイムを憂い、援軍を乞うために諸国を巡っている。"},{"spoiler":false,"text":"キングダム国王より、援軍と引き換えにその肉体を捧げるように求められる。"}],"source":"bangumi","sourceCharacterId":"148182"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb0145ffd5b3ebb3a6ad64dc4dd442f0f8fc1535bcc74519be41f096ebebccbb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c1559512bde5ccea8ff716bee0fa1149cfac594354ca3850ce7057a6b4a42d2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:82168:148182:10027:1","source":"bangumi"}]},{"characterId":"char_vndb_c67198","characterName":"レイラ・アレクセイ・ウラジミール＝ドルガル","sourceIds":{"vndbCharacterId":"c67198"},"originalCharacterName":"レイラ・アレクセイ・ウラジミール＝ドルガル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the commander of the Western Front Army of the Dorgal Empire, a northern power. She is the youngest daughter of Emperor Hyodor and is known as the “Ice Princess\"."},{"spoiler":false,"text":"She possesses a keen tactical eye, command ability, and charisma, and has subjugated neighboring countries one after another."},{"spoiler":false,"text":"She is a beautiful woman with icy-white skin and eyes as red as flames. She is tall enough to be tower over soldiers when in their company and boasts sculpted proportions."},{"spoiler":false,"text":"She is determined to expand the Dorgal Empire's reach, and she has turned her blade against the elven kingdoms."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c67198"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b53f53dc28280ad3c961b2e1ccfab63300478c381cb9cf9966ebae8da15c9ac4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/454a1820e911061aaf1d01ec5ce6601b3c87ee043d9eb32376be2f2cc909b02b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥川 久美子","creatorId":"vndb:s861","sourcePersonId":"vndb:s861","canonicalEntityId":"vndb:s861","name":"奥川 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:30399","source":"vndb"}]},{"characterId":"char_vndb_c67199","characterName":"ファフナー","sourceIds":{"vndbCharacterId":"c67199"},"originalCharacterName":"ファフナー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl with a supernatural atmosphere and wizened eyes. Her true identity is that of a powerful dragon. By the power of magic, she can take human form depending on the situation."},{"spoiler":false,"text":"The dragon population is extremely small, and there are few dragons of royal blood left. Fafner is one of the few survivors, and although she is still young as a dragon, she has inherited the position of Dragon King. She has accepted her doom and lives a quiet life in the mountainous region known as “Dragon's Nest\"."},{"spoiler":false,"text":"She is a philosophical thinker, unperturbed by trivial matters, and has an enlightened outlook on everything. She is oblivious to the conflict between humans and elves, and takes on the role of bystander for their affairs."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c67199"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3da20a765eedbfc5db38eefa87230ceb49910551fcfd0c0c4ab1cd97c06add9d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a2f7cc5238b77fbb254ee86d1b626f44c484ea13b80afc6145dc0ee96fb23ad.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中 美智","creatorId":"vndb:s796","sourcePersonId":"vndb:s796","canonicalEntityId":"vndb:s796","name":"田中美智(多田美智)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:30398","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p503","sourceCompanyId":"egs:brand:2141","canonicalEntityId":"vndb:p503","name":"Frill","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:13726:2141","source":"egs"},{"companyId":"vndb:p503","sourceCompanyId":"vndb:p503","canonicalEntityId":"vndb:p503","name":"Frill","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:11216:v5032","source":"vndb"},{"companyId":"vndb:p503","sourceCompanyId":"vndb:p503","canonicalEntityId":"vndb:p503","name":"Frill","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:81000:v5032","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
