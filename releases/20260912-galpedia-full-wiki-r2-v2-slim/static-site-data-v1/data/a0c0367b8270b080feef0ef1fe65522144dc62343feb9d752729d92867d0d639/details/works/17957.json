s":[{"spoiler":false,"text":"Kaori is a tsundere who can’t be honest about her deep love for Amane. She lives next door to Amane and goes to Saint Michael Girls’ School together. Very responsible and straightforward. She fulfills the tsukkomi role very well. However, when Amane’s repeated loving advances breaks down her tsundere wall, she becomes very cute and doting. She’s not that good at cooking, but at least it’s better than Amane."},{"spoiler":false,"text":"Taken from Micchi's review"}],"source":"vndb","sourceCharacterId":"c11014"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19b874536169aac00c83bc5a674dc0cd4152008e642964994d476dfe723bd59d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35a4f80fa4d5745b13df1f510a6091bf035c9e8bdb7b5e2bf533ff1a7b4a8b36.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"喜多村 英梨","creatorId":"vndb:s269","sourcePersonId":"vndb:s269","canonicalEntityId":"vndb:s269","name":"喜多村 英梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31101","source":"vndb"}]},{"characterId":"char_vndb_c11015","characterName":"結城 あまね","sourceIds":{"vndbCharacterId":"c11015"},"originalCharacterName":"結城 あまね","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Amane is basically the opposite of Kaori. She’s airheaded, very lively, glomps Kaori at every opportunity and generally lazy. She fails at studying and cooking, and would rather stay up playing games than anything else."},{"spoiler":false,"text":"Taken from Micchi's review"}],"source":"vndb","sourceCharacterId":"c11015"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa3c8d2c74c11d2dc35fc94bea8cf081880bfd29dea7190ee0cb494f37db4eda.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db450efb94b42f44ee5bb238c4049609f98f040e0fab781a7f8a2438194929c4.webp","width":219,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊原 ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31102","source":"vndb"}]},{"characterId":"char_vndb_c11016","characterName":"魚住 小春","sourceIds":{"vndbCharacterId":"c11016"},"originalCharacterName":"魚住 小春","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Koharu is the mascot character among the four friends. Soft-spoken and pure, she emits an iyashi-kei charm that captures Makoto’s heart. She thinks she is too childish and hence, greatly admires Makoto since she is so much more mature than her. She is a wonderful cook (especially sweets) and very handy around the house, so she would be a great housewife. Very hardworking."},{"spoiler":false,"text":"Taken from Micchi's review"}],"source":"vndb","sourceCharacterId":"c11016"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1aa03a8234aa8f3813d8eee6c62640a0c9addb258af878a0ea850664a1d4f453.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d4e28546204a7a6cbe08ee92323a52e4eac5f4d0b3a15d7f0874a8160785890.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"徳島 未彩","creatorId":"vndb:s2281","sourcePersonId":"vndb:s2281","canonicalEntityId":"vndb:s2281","name":"桜木 アミサ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31104","source":"vndb"}]},{"characterId":"char_vndb_c11017","characterName":"藤堂 真琴","sourceIds":{"vndbCharacterId":"c11017"},"originalCharacterName":"藤堂 真琴","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The most mature of the group, Makoto is normally very cool and reserved. However, she is a girl after all and is weak for cute things, like Koharu. Dreams about being with Koharu a lot."},{"spoiler":false,"text":"Taken from Micchi's review"}],"source":"vndb","sourceCharacterId":"c11017"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b60a5395ab8dc7fed4fef6ae021ea8800213aa4f3a0a79472a8c6e846337c3e0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c0a6c8c84b0c4e0f472cca3a9672cf6622773e1a0c27a4f538038a2f2bcd648.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"内田 愛美","creatorId":"vndb:s810","sourcePersonId":"vndb:s810","canonicalEntityId":"vndb:s810","name":"内田 愛美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31103","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p2879","sourceCompanyId":"egs:brand:3657","canonicalEntityId":"vndb:p2879","name":"ゆりんゆりん","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:17957:3657","source":"egs"},{"companyId":"vndb:p437","sourceCompanyId":"vndb:p437","canonicalEntityId":"vndb:p437","name":"ふぐり屋","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:11774:v5244","source":"v