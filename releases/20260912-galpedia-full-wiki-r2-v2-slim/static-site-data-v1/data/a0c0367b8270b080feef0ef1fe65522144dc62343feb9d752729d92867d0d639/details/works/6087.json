:"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"14"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A small, fairy-like creature no taller than 14 cm and possessing tiny, translucent, fluttering wings. But, even though she is so small, she can sing and speak at a normal person's volume. Despite having wings, she cannot rise above a certain height."},{"spoiler":false,"text":"Phorni is the self-declared, 'fairy of music' who shares the room with Chris ever since he moved in. Apart from Chris, no one is able to hear her, see her, or touch her."},{"spoiler":false,"text":"She enjoys singing (which she is very good at), and would pester Chris into playing the Fortelle so that she can sing along. She has a habit of saying \"miyah\" when she is surprised."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c1"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52364771db2dd70aa4b649a65288e18b9db98c6d82e5034d48e59ac5ef4c8767.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/495fafe7cd6ff1d73e415b57baf50aaaef429d044b5b42a251785186bec1262d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"笠原 弘子","creatorId":"vndb:s566","sourcePersonId":"vndb:s566","canonicalEntityId":"vndb:s566","name":"笠原 弘子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:532","source":"vndb"}]},{"characterId":"char_vndb_c16","characterName":"アリエッタ・フィーネ","sourceIds":{"vndbCharacterId":"c16"},"originalCharacterName":"アリエッタ・フィーネ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The elder twin sister of Tortinita. She stayed in her hometown while her sister and Chris went to attend the music school, because she lacked the ability and talent."},{"spoiler":false,"text":"A quiet girl who's good at cooking and domestic work, she is Chris' girlfriend, and they communicate every week by sending letters to each other. Her nickname is Arie."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c16"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb18bafcffd0995dce1a02714927648a0b77872c8ebf9c4b062e68a91a03d6c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/0770cfa569f4bc9f346969561253b87e3fbed39ca0e74c1b7fb823b167956b1d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中原 麻衣","creatorId":"vndb:s444","sourcePersonId":"vndb:s444","canonicalEntityId":"vndb:s444","name":"中原 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:530","source":"vndb"}]},{"characterId":"char_vndb_c17","characterName":"トルティニタ・フィーネ","sourceIds":{"vndbCharacterId":"c17"},"originalCharacterName":"トルティニタ・フィーネ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A childhood friend of Chris who is likewise attending the music school."},{"spoiler":false,"text":"The younger twin of Arietta, she is an active girl with a strong personality. Tortinita is a third year vocalist student of the school, and as such has the option of being able to give a solo performance for her graduation performance. She eats lunch together with Chris in the school cafeteria almost everyday. Her nickname is Toruta."},{"spoiler":true,"text":"She has liked Chris ever since they were young, but since Chris chose Arietta, she decided to hide her feelings even though she started liking Chris before her sister did."},{"spoiler":true,"text":"After the accident, Chris and Torta's families decided to send them to music school in order to help Chris recuperate."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c17"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2edf47df583359f945b6043c388efde330992c46d740302ef8b316c753f56dda.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f208112423a03779e40b1f70858a3d8ebc544c6ec66c16c388fc3e369a7e4e7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中原 麻衣","creatorId":"vndb:s444","sourcePersonId":"vndb:s444","canonicalEntityId":"vndb:s444","name":"中原 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:531","source":"vndb"}]},{"characterId":"char_vndb_c18","characterName":"クリス・ヴェルティン","sourceIds":{"vndbCharacterId":"c18"},"originalCharacterName":"クリス・ヴェルティン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A seventeen-year-old who came to the town with his childhood friend Tortinita to attend the music school. He is a third-year student of the keyboard-like instrument Fortelle, and dreams to become an accomplished musician."},{"spoiler":false,"text":"Apart from Tortinita and Asino, he virtually has no other friends at the school. A laid-back person, he is very talented at music."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c18"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b51041f42fba362e2683483ba96f53925fb5d67887a5c9e4141045321d7fc24.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e17fde956289cdf39403fc6acc4b7fd2c2c337dfb68905930bce3164c3f3f1c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮下 道央","creatorId":"vndb:s1677","sourcePersonId":"vndb:s1677","canonicalEntityId":"vndb:s1677","name":"宮下 道央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:535","source":"vndb"}]},{"characterId":"char_vndb_c19","characterName":"ファルシータ・フォーセット","sourceIds":{"vndbCharacterId":"c19"},"originalCharacterName":"ファルシータ・フォーセット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The former student council president, Falsita is a talented third year vocalist student who's searching for a Fortelle-playing partner for her graduation concert at the end of the year."},{"spoiler":true,"text":"She appears to be a gentle and graceful girl, but is known to be highly calculative and demanding, and is popular with the students of the school."},{"spoiler":false,"text":"She often does favors for people (such as writing a speech for the teacher), and works part-time at a restaurant, making her very busy. Her nickname is Fal."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c19"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01974a5e6429