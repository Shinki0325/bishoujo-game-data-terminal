db","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chris' best and only male friend, he supports Chris from the side and seems to be very popular with girls."},{"spoiler":true,"text":"He had originally planned to partner with Falsita, but it is later revealed that she was only using him to obtain information about Chris and dumped him soon after."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c21"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e49d57a1dc20b69422ef16466a09bf4826729b746038a265d7b67a09a7a7b3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e21e439eb80375c42a587f02ef4f87c8f158336fc62d9ffc3417e4f4eb951437.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"渡辺 隼人","creatorId":"vndb:s13419","sourcePersonId":"vndb:s13419","canonicalEntityId":"vndb:s13419","name":"渡辺 隼人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:537","source":"vndb"}]},{"characterId":"char_vndb_c22","characterName":"コーデル","sourceIds":{"vndbCharacterId":"c22"},"originalCharacterName":"コーデル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A teacher at Piova music school, she is also a personal lecturer for Chris and Asino."},{"spoiler":false,"text":"Cordell is very strict but also has a gentle, caring side. At school she is among one of the highest rated teachers and many students like her."},{"spoiler":false,"text":"From Review by Ruwi"}],"source":"vndb","sourceCharacterId":"c22"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/im