{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"20445","model":{"presentationWorkId":"vndb:v15007","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c4036","characterName":"上月 里香子","sourceIds":{"bangumi":[{"characterId":"30982","match":"exact-normalized-name-in-linked-work","subjectId":"128057"}],"egsCharacterIds":["19281"],"vndbCharacterId":"c4036"},"originalCharacterName":"上月 里香子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学級委員を務める真面目な学生。"},{"spoiler":false,"text":"男嫌いな上、清潔感があり、近寄りがたい雰囲気を出している。"},{"spoiler":false,"text":"――痴漢待ち"},{"spoiler":false,"text":"電車の中での痴漢行為に反応してしまう。"},{"spoiler":false,"text":"以来、痴漢行為で感じてしまうようになった。"}],"source":"egs","sourceCharacterId":"19281","sourceWorkId":"7742","spoiler":false},{"segments":[{"spoiler":false,"text":"『痴漢好き』のヒロイン。"},{"spoiler":false,"text":"真面目な優等生。"},{"spoiler":false,"text":"通学途中の電車の中で女性に痴漢されて以来、電車に乗るたびに身体が疼くようになってしまった。"}],"source":"egs","sourceCharacterId":"19281","sourceWorkId":"9802","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の痴漢のターゲットとなった女の子。"},{"spoiler":false,"text":"主人公と学園が違い女学園に通っている。"},{"spoiler":false,"text":"男が大嫌いというわけではないが苦手意識はかなり強い。"},{"spoiler":false,"text":"主人公に痴漢されて初めて感じてしまう。"},{"spoiler":false,"text":"自分の性癖をかなり嫌悪している。"},{"spoiler":false,"text":"性格はおとなしいが、男と話すときは"},{"spoiler":false,"text":"少し口調がこわばってしまう。"}],"source":"egs","sourceCharacterId":"19281","sourceWorkId":"20445","spoiler":false},{"segments":[{"spoiler":false,"text":"学級委員で真面目な眼鏡っ子。清潔感があり、近寄りがたい雰囲気。 校則にはとても厳しく、特に男女交際は対応がキツイ。"},{"spoiler":false,"text":"元々男嫌いだったが、実は痴漢行為に興奮する。身体を触られたが、痴漢ではなくて痴女だった。 そのとき、男でないとわかって、安心してしまう。結果、男でも女でも痴漢で感じる性癖になる。"}],"source":"bangumi","sourceCharacterId":"30982"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/249d94df7cd8c8824311d16ff469b64a6cff987bff68a9ce8a11cab07ad9d59d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bfb99cc03d60258d028666b0e41af42c72aedfa7f25cb4544116f2c41bdb468.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"八ッ橋 きなこ","creatorId":"vndb:s353","sourcePersonId":"vndb:s353","canonicalEntityId":"vndb:s353","name":"八ッ橋きなこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:58483","source":"vndb"}]},{"characterId":"char_vndb_c111823","characterName":"五反田 昭文","sourceIds":{"vndbCharacterId":"c111823"},"originalCharacterName":"五反田 昭文","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:4251","sourceCompanyId":"egs:brand:4251","canonicalEntityId":"egs:brand:4251","name":"roroE","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:20445:4251","source":"egs"},{"companyId":"vndb:p826","sourceCompanyId":"vndb:p826","canonicalEntityId":"vndb:p826","name":"Eroro","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:155514:v15007","source":"vndb"},{"companyId":"vndb:p826","sourceCompanyId":"vndb:p826","canonicalEntityId":"vndb:p826","