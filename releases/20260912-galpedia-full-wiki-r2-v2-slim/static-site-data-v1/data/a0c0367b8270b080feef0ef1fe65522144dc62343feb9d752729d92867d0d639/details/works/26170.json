{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"26170","model":{"presentationWorkId":"egs:26170","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_29048","characterName":"玛修·姬莉叶莱特","sourceIds":{"bangumi":[{"characterId":"29048","match":"source-roster","subjectId":"231881"},{"characterId":"29048","match":"source-roster","subjectId":"331486"}]},"originalCharacterName":"玛修·姬莉叶莱特","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"158"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"登场于Fate/Grand Order, 源于Fate/stay night最初设定的, 持有巨大盾牌的迷之少女。"},{"spoiler":false,"text":"Chaldea局的成员，玛修·基列莱特与Servant凭依融合的姿态。被称作Demi Servant。Demi Servant持有的特殊技能。能将凭依的英灵持有的技能仅仅一个继承下来，并升华为自我的流派。玛修的场合是“魔力防御”。与魔力放出同类型的技能，将魔力直接变换为防御力。如果是持有庞大魔力的英灵的话，那将会是连一个国家都能守护的神圣壁垒吧。玛修得知了凭依于自身的英灵的真名。那个骑士的名字叫加拉哈德。存在于亚瑟王传说中的圆桌骑士的一人。唯一一个入手了圣杯，随后返回了天堂的圣者。Chaldea能够用独自的方法成功完成英灵召唤，作为其基础的是作为加拉哈德召唤的触媒的“英雄们集结的场所”——也就是玛修所持有的，利用圆桌制成的盾牌。"},{"spoiler":false,"text":"宝具简介『如今仍是遥远的理想之城』"},{"spoiler":false,"text":"等级:B+++ 种类:对恶宝具"},{"spoiler":false,"text":"Lord・Camelot"},{"spoiler":false,"text":"英灵・加拉哈德持有的宝具。白亚之城卡美洛的中心，使用圆桌骑士们的圆桌为盾的究极的守护。强度根据使用者的精神程度，内心绝不屈服的话城壁绝对不会崩溃。 将之冠以Chaldea之名向来是由存在于玛修心底的祈愿，“守望人类的未来”而来吧。"}],"source":"bangumi","sourceCharacterId":"29048"}],"profileFacts":[{"label":"属性","source":"bangumi","sourceCharacterId":"29048","value":"秩序·善"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/942abd98626d769d84a5f271f547510ec98a13daee88193ac6d0c494a1960156.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e19934512d776d861cbac1c3b544ef0741fe055ac7f9ac39552f69bb0f44e02.webp","width":181,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:5590","sourceCompanyId":"egs:brand:5590","canonicalEntityId":"egs:brand:5590","name":"ディライトワークス","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:26170:5590","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
