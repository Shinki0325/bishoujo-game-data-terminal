{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"27081","model":{"presentationWorkId":"vndb:v23464","staff":{"artwork":[{"creditedName":"日陰影次","creatorId":"vndb:s2045","sourcePersonId":"egs:creator:1363","canonicalEntityId":"vndb:s2045","name":"日陰影次","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:202008","source":"egs"}],"scenario":[{"creditedName":"和泉万夜","creatorId":"vndb:s217","sourcePersonId":"egs:creator:1614","canonicalEntityId":"vndb:s217","name":"和泉万夜","detail":"エッチシーン","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:202009","source":"egs"},{"creditedName":"大熊陣八","creatorId":"vndb:s2773","sourcePersonId":"egs:creator:2417","canonicalEntityId":"vndb:s2773","name":"大熊陣八","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:202010","source":"egs"},{"creditedName":"上田ながの","creatorId":"vndb:s4881","sourcePersonId":"egs:creator:17604","canonicalEntityId":"vndb:s4881","name":"上田ながの","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:202011","source":"egs"},{"creditedName":"屋島 狸","creatorId":"vndb:s29165","sourcePersonId":"vndb:s29165","canonicalEntityId":"vndb:s29165","name":"屋島 狸","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:149942","source":"vndb"},{"creditedName":"小沢 裕樹","creatorId":"vndb:s919","sourcePersonId":"vndb:s919","canonicalEntityId":"vndb:s919","name":"小沢 裕樹","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:149950","source":"vndb"},{"creditedName":"遊真 一希","creatorId":"vndb:s2601","sourcePersonId":"vndb:s2601","canonicalEntityId":"vndb:s2601","name":"遊真 一希","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:149952","source":"vndb"}],"music":[{"creditedName":"上原 一之龍","creatorId":"vndb:s277","sourcePersonId":"vndb:s277","canonicalEntityId":"vndb:s277","name":"上原 一之龍","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:149948","source":"vndb"}],"other":[{"creditedName":"深生是人","creatorId":"vndb:s9898","sourcePersonId":"egs:creator:25763","canonicalEntityId":"vndb:s9898","name":"深生是人","detail":"原案/設定協力","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:202012","source":"egs"},{"creditedName":"叶一華","creatorId":"vndb:s16232","sourcePersonId":"egs:creator:32381","canonicalEntityId":"vndb:s16232","name":"叶一華","detail":"領主の娘","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:290339","source":"egs"},{"creditedName":"Robert K","creatorId":"vndb:s27546","sourcePersonId":"vndb:s27546","canonicalEntityId":"vndb:s27546","name":"Robert Kleinhenz","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:149943","source":"vndb"},{"creditedName":"Arisa Okazaki","creatorId":"vndb:s27998","sourcePersonId":"vndb:s27998","canonicalEntityId":"vndb:s27998","name":"Arisa Okazaki","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:149944","source":"vndb"},{"creditedName":"Lapin, inc.","creatorId":"vndb:s30936","sourcePersonId":"vndb:s30936","canonicalEntityId":"vndb:s30936","name":"Lapin, inc.","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:149945","source":"vndb"},{"creditedName":"KSh1o","creatorId":"vndb:s27552","sourcePersonId":"vndb:s27552","canonicalEntityId":"vndb:s27552","name":"黑桐 潮","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:149946","source":"vndb"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:149949","source":"vndb"},{"creditedName":"アトリエ ピーチ","creatorId":"vndb:s5430","sourcePersonId":"vndb:s5430","canonicalEntityId":"vndb:s5430","name":"アトリエ ピーチ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:149955","source":"vndb"},{"creditedName":"深生 是人","creatorId":"vndb:s9898","sourcePersonId":"vndb:s9898","canonicalEntityId":"vndb:s9898","name":"深生 是人","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:149956","source":"vndb"},{"creditedName":"buntan","creatorId":"vndb:s11374","sourcePersonId":"vndb:s11374","canonicalEntityId":"vndb:s11374","name":"buntan","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:149957","source":"vndb"}]},"cast":[{"characterId":"char_c78423","characterName":"イリス・アルケーディア","sourceIds":{"bangumi":[{"characterId":"67375","match":"exact-normalized-name-in-linked-work","subjectId":"256515"}],"egsCharacterIds":["20415"],"vndbCharacterId":"c78423"},"originalCharacterName":"イリス・アルケーディア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Princess General of the Kingdom of Aurelia, known as the Sacred Kingdom. She is a peerless general, whether she is wielding a sword or leading an army. Never conceited, she is a compassionate woman who is devoted to the well-being of her people. Therefore, she is strongly opposed to the country of service."},{"spoiler":false,"text":"She has a strong bond with Serafina, the symbol of the Holy Kingdom, and although Iris is usually wise beyond her years, she can be honest in front of her."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c78423"},{"segments":[{"spoiler":false,"text":"神聖王国と呼ばれるアウレリア王国の姫将軍。"},{"spoiler":false,"text":"剣を取っても軍を率いても、比類なき名将。"},{"spoiler":false,"text":"決して驕り高ぶることのない、民の安寧のために心を砕く、情に満ちた人物。"},{"spoiler":false,"text":"それ故、奉仕国家のあり方に強い反発心を抱いている。"},{"spoiler":false,"text":"神聖王国の象徴であるセラフィーナとは、強い絆で結ばれており、普段は年不相応に厳格なイリスだが、彼女の前では素直になれる。"}],"source":"egs","sourceCharacterId":"20415","sourceWorkId":"27081","spoiler":false},{"segments":[{"spoiler":false,"text":"神圣王国奥雷利亚的姬将军。"},{"spoiler":false,"text":"她的武力和统率力都一骑绝尘，到达了名将的级别。"},{"spoiler":false,"text":"她深仁厚泽，不骄不矜，为了民众的安宁呕心沥血。"},{"spoiler":false,"text":"正是因为如此，她才会对侍奉之国的国情抱有强烈的反感。"},{"spoiler":false,"text":"她与神圣王国的象征——瑟拉菲娜交往颇深，"},{"spoiler":false,"text":"平时，她的严厉会给人过度老成的感觉，但在瑟拉菲娜面前，她却能坦率地做自己。"}],"source":"bangumi","sourceCharacterId":"67375"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2aa50edb71cb5fa3af30e3ffbae0a0da9f8907a317faafe4a20dfaa7ce633b4e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfbf437a8097e06752dcda9ffd020b02c03967ef78f548f80a51fbf1dda7c18e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:256515:67375:6351:1","source":"bangumi"}]},{"characterId":"char_c78424","characterName":"セラフィーナ・レナトゥス","sourceIds":{"bangumi":[{"characterId":"67376","match":"exact-normalized-name-in-linked-work","subjectId":"256515"}],"egsCharacterIds":["20416"],"vndbCharacterId":"c78424"},"originalCharacterName":"セラフィーナ・レナトゥス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An ancient High Elf who lies in the temple of the Holy Kingdom. She is believed to be the reincarnation of the goddess Laurendeau, who is believed to awaken when the world is in danger and save the people of Eos. She is modest and graceful, with an alluring charm that even evokes a sense of fragility."},{"spoiler":false,"text":"Although she has never been a stranger to conflict, she sees the expanding service state as a threat to the world and decides to fight. She and Iris share a friendship that transcends race and ethnicity."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c78424"},{"segments":[{"spoiler":false,"text":"神聖王国の神殿に眠る古代＜エンシェント＞ハイエルフ。 世界が危機を迎えた時に目覚め、人々を救うという伝承があるエオスで信仰される女神ラーレンティアの生まれ変わりとされる一人。"},{"spoiler":false,"text":"慎み深く、佇まいもたおやかで、どこか儚ささえ感じさせる魅力がある。"},{"spoiler":false,"text":"元来、争いごとは好まないが、膨張する奉仕国家を世界の危機と捉え、戦うことを決意する。"},{"spoiler":false,"text":"志を共にするイリスとは、種族を超えた友情で結ばれている。"}],"source":"egs","sourceCharacterId":"20416","sourceWorkId":"27081","spoiler":false},{"segments":[{"spoiler":false,"text":"沉眠于神圣王国神殿之中的远古高等精灵。"},{"spoiler":false,"text":"只要世界陷入危机，她便会觉醒。艾奥斯地区信仰能拯救苍生的菈莲缇雅女神，而瑟拉菲娜则被认为是女神的转世。"},{"spoiler":false,"text":"她谨言慎行，举手投足间尽显优雅气质，有一种超脱尘俗的魅力。"},{"spoiler":false,"text":"虽然不喜欢争斗，但她认为不断扩大势力的侍奉之国将成为世界的危机，于是决心站出来与之对抗。"},{"spoiler":false,"text":"与志同道合的伊莉斯结下了超越种族的深厚友谊。"},{"spoiler":false,"text":"“我也会尽我所能……守护这个国家。”"}],"source":"bangumi","sourceCharacterId":"67376"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/119b82d2aa9f1e8daa19ea6eb732102f169dc91ef236e8aba572305544d97712.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/267a54f397d28362a332cc440ace41e271b8f2f5ccb5bad37b9ace87cd14b8d5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:256515:67376:6349:1","source":"bangumi"}]},{"characterId":"char_c78425","characterName":"ルカ","sourceIds":{"bangumi":[{"characterId":"67377","match":"exact-normalized-name-in-linked-work","subjectId":"256515"}],"egsCharacterIds":["20417"],"vndbCharacterId":"c78425"},"originalCharacterName":"ルカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A half-human and half-dark elf, a member of Direc's order. She was bought by Direc when she was a child. She has been trained not only as a swordswoman but also as a woman, and thus she is capable of serving as a first-class prostitute. She is happy to serve Direk who showed her the way and she is willing to do any dirty work for him."}],"source":"vndb","sourceCharacterId":"c78425"},{"segments":[{"spoiler":false,"text":"ディレクに仕える騎士団員のひとり、人間とダークエルフのハーフ。"},{"spoiler":false,"text":"幼い頃、奴隷であったところをディレクに買い取られ、生きる術を叩き込まれた。"},{"spoiler":false,"text":"剣技だけでなく、女としても鍛え上げられているため、一流の娼婦としても通用するほどの奉仕の腕前。"},{"spoiler":false,"text":"自分に道を示してくれたディレクに仕えることを喜びとし、主であるディレクのためならどんな汚れ仕事も進んで引き受ける。"}],"source":"egs","sourceCharacterId":"20417","sourceWorkId":"27081","spoiler":false},{"segments":[{"spoiler":false,"text":"侍奉德里克的骑士团成员，是人类与暗精灵的混血儿。"},{"spoiler":false,"text":"对她来说，侍奉为自己指明道路的德里克是至高无上的喜悦，为了主人德里克，无论多么肮脏的工作她都甘之如饴。"},{"spoiler":false,"text":"“为了德里克大人的霸业……我将不择手段。”"}],"source":"bangumi","sourceCharacterId":"67377"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b1dcc52bf656531aa61ae3a47ff1d2d8a10e966ea4e8839e2dce2863dfcad80.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94c56f2f085250aa1bf6186d7f303a138a2c34e8c1aa615d024758971986a494.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田紗記子","creatorId":"vndb:s1658","sourcePersonId":"vndb:s1658","canonicalEntityId":"vndb:s1658","name":"葵時緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:256515:67377:17079:1","source":"bangumi"}]},{"characterId":"char_c78426","characterName":"ミスティオラ・アーテー","sourceIds":{"bangumi":[{"characterId":"67378","match":"exact-normalized-name-in-linked-work","subjectId":"256515"}],"egsCharacterIds":["20418"],"vndbCharacterId":"c78426"},"originalCharacterName":"ミスティオラ・アーテー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A pure-blooded Dark Elf and a high class prostitute who rarely appears in human countries. She is a person of exceptional beauty, high intelligence, culture, and grace. She is cursed with the ability that attracts men, so there is no end to the number of men who want to take possession of Mistiora for themselves. After moving from one country to another, she is now serving as a mistress in the desert kingdom of Eldonia."}],"source":"vndb","sourceCharacterId":"c78426"},{"segments":[{"spoiler":false,"text":"人間の国には滅多に姿を見せることのない、純血のダークエルフ。"},{"spoiler":false,"text":"類まれな美貌の持ち主であり、高い知性と教養、気品を兼ね備えている。"},{"spoiler":false,"text":"加えて“男を惹き付ける”呪いを掛けられているため、ミスティオラを我が物にしようと思う男は後を絶たず、それが国と国の争いにまで発展することから傾城の美女と呼ばれている。"},{"spoiler":false,"text":"様々な国を転々とした末、現在は砂漠に存在するエルドニア王国の寵姫として囲われている。"}],"source":"egs","sourceCharacterId":"20418","sourceWorkId":"27081","spoiler":false},{"segments":[{"spoiler":false,"text":"她是纯种暗精灵，很少在人类的国家抛头露面。"},{"spoiler":false,"text":"拥有沉鱼落雁的美貌，集过人的智慧、教养和品格于一体。"},{"spoiler":false,"text":"想要将蜜思娣欧拉占为己有的男人络绎不绝，围绕她的纷争甚至一度发展成国家与国家间的战争。"},{"spoiler":false,"text":"因此，她被人称为“倾城美女”。"},{"spoiler":false,"text":"如今，经过几番辗转流离，她成为了伊尔东王国的宠妃。"}],"source":"bangumi","sourceCharacterId":"67378"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/8789bd2f857c640bce6fa8ed451b7db6665594d00892dd1f3270bfb99c05dc2d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b93bd6646715067d0a8f1d94d6287f56f2f04adeb70c206fa4a118333ac44eb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:256515:67378:10027:1","source":"bangumi"}]},{"characterId":"char_c78427","characterName":"コハク","sourceIds":{"bangumi":[{"characterId":"67379","match":"exact-normalized-name-in-linked-work","subjectId":"256515"}],"egsCharacterIds":["20419"],"vndbCharacterId":"c78427"},"originalCharacterName":"コハク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the leader of a tribe of foxes who came from far to the east and now have a country of their own. She is also the head of a secret spy organization called \"kunoichi\". Normally, she exudes an air of mystery that makes it difficult to tell her true nature."},{"spoiler":false,"text":"In reality, she is a compassionate woman, willing to make any sacrifice for the sake of the one she loves. She has a younger brother named Menou, who is currently a prisoner in the service state."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c78427"},{"segments":[{"spoiler":false,"text":"かつて遥か東方より流れてきて、現在は一国を構えるに至った 狐人族を率いる長であり、“くノ一”と呼ばれる密偵組織の長でもある。"},{"spoiler":false,"text":"普段は、どこか心根を悟らせない妖艶さを漂わせている。 実際には情に厚く、惚れ込んだ相手のためならどんな犠牲も厭わない。"},{"spoiler":false,"text":"メノウという弟がいるが、現在、奉仕国家に囚われている。"}],"source":"egs","sourceCharacterId":"20419","sourceWorkId":"27081","spoiler":false},{"segments":[{"spoiler":false,"text":"かつて遥か東方より流れてきて、現在は一国を構えるに至った狐人族を率いる長であり、"},{"spoiler":false,"text":"“くノ一”と呼ばれる密偵組織の長でもある。普段は、どこか心根を悟らせない妖艶さを漂わせている。"},{"spoiler":false,"text":"実際には情に厚く、惚れ込んだ相手のためならどんな犠牲も厭わない。"},{"spoiler":false,"text":"メノウという弟がいるが、現在、奉仕国家に囚われている。"},{"spoiler":false,"text":"「メノウ……今度こそ必ず助ける。どんな犠牲を払ってでも必ず」"}],"source":"bangumi","sourceCharacterId":"67379"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a0d8278d57bddc106a225f1bc661fae4a3c3557f54401073c534e8079399ae5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb3c3a0a65a83d4de9a1993e570e62e181962c571290fdf8806cce2526624cf3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:256515:67379:6359:1","source":"bangumi"}]},{"characterId":"char_c78428","characterName":"アストリット・フラメル","sourceIds":{"bangumi":[{"characterId":"67380","match":"exact-normalized-name-in-linked-work","subjectId":"256515"}],"egsCharacterIds":["20420"],"vndbCharacterId":"c78428"},"originalCharacterName":"アストリット・フラメル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the next Grand Master of Kimia, a township composed entirely of magicians. She specializes in alchemy, including the creation of golems."},{"spoiler":false,"text":"In addition to her own research, she is passionate about training apprentices. Currently, she has three girls with rich personalities as her apprentices. Sh is somewhat a bit of a nag, but that is only out of consideration for her students. She is well-liked and respected by her students."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c78428"},{"segments":[{"spoiler":false,"text":"魔術師だけで構成された郷「キミア」の次期グランドマスター。"},{"spoiler":false,"text":"ゴーレム創造を始めとした、錬金術を得意とする。"},{"spoiler":false,"text":"自身の研究だけでなく、弟子の育成にも熱心。"},{"spoiler":false,"text":"現在は個性豊かな３人の女の子たちを弟子にしている。"},{"spoiler":false,"text":"口うるさい時もあるが、それも相手を思ってこそ。"},{"spoiler":false,"text":"面倒見がよくサッパリとした気質で、弟子たちからも敬愛されている。"}],"source":"egs","sourceCharacterId":"20420","sourceWorkId":"27081","spoiler":false},{"segments":[{"spoiler":false,"text":"法师之乡——“奇美亚”的下一任大法师。"},{"spoiler":false,"text":"她擅长以召唤魔像为首的各种炼金术。"},{"spoiler":false,"text":"除了研究之外，她也在培育徒弟上倾注了大量心血。"},{"spoiler":false,"text":"目前，她收了三位个性鲜明的女性为徒。"},{"spoiler":false,"text":"虽然有时很唠叨，但那也是为了对方着想。"},{"spoiler":false,"text":"她性格直爽，很会照顾人，因此深受徒弟的爱戴。"},{"spoiler":false,"text":"“一位魔法师可抵千军万马。您领教到了吗？”"}],"source":"bangumi","sourceCharacterId":"67380"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd88fcaa929af63b1a2a2e3e7dd780597644bcde810a8720841e34626a2ae8d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47fd7d3c74ca5a988d34b922a6289f5399bb955b886126ca6e4ebccfb2751636.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水野七海","creatorId":"vndb:s2524","sourcePersonId":"vndb:s2524","canonicalEntityId":"vndb:s2524","name":"星野七海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:256515:67380:17078:1","source":"bangumi"}]},{"characterId":"char_c78429","characterName":"メル・メル","sourceIds":{"bangumi":[{"characterId":"67381","match":"exact-normalized-name-in-linked-work","subjectId":"256515"}],"egsCharacterIds":["20421"],"vndbCharacterId":"c78429"},"originalCharacterName":"メル・メル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a halfling girl who serves as acting general of Tulle, a federation of commercial cities. She is an excellent merchant, but she is far from calm and collected, and her likes, dislikes, and feelings of anger, sorrow, and joy are quite clear."},{"spoiler":false,"text":"In times of war, she is able to lead a large number of mercenaries and artillery units, using her ample financial resources."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c78429"},{"segments":[{"spoiler":false,"text":"商業都市連合国家テュルルの総帥代行を務めるハーフリング族の少女。"},{"spoiler":false,"text":"商人として非常に優秀であるが、冷静沈着からは程遠く、喜怒哀楽や好き嫌いはかなりハッキリしている。"},{"spoiler":false,"text":"戦争の際には潤沢な資金力に物を言わせて、大量の傭兵団と虎の子の砲兵部隊を率いて活躍する。"}],"source":"egs","sourceCharacterId":"20421","sourceWorkId":"27081","spoiler":false},{"segments":[{"spoiler":false,"text":"担任商业城邦联盟特露鲁的代理宗主的半身人少女。"},{"spoiler":false,"text":"作为一名商人，她的优秀是毋庸置疑的，"},{"spoiler":false,"text":"但她极其情绪化，性情多变，而且好恶过于分明。"},{"spoiler":false,"text":"战争时期，她凭借雄厚的财力，率领多支佣兵团和王牌炮兵部队在战场上大展身手。"},{"spoiler":false,"text":"“炮弹数量充足得很，给我尽情发射！”"}],"source":"bangumi","sourceCharacterId":"67381"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8e52bfff9f6e312a9f17c230424e3181e21ad515cb93a7814ee3ed408e37e65.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58fec00d1c33b8215668edaa510cb13ada85b2c1ae688a196ba0492e5502831c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:256515:67381:6409:1","source":"bangumi"}]},{"characterId":"char_c78430","characterName":"エレオノーラ・ベルン","sourceIds":{"bangumi":[{"characterId":"67382","match":"exact-normalized-name-in-linked-work","subjectId":"256515"}],"egsCharacterIds":["20422"],"vndbCharacterId":"c78430"},"originalCharacterName":"エレオノーラ・ベルン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a female bishop who is concerned about the corruption and decay of the church in the service state and aims for its reform. Even though she has risen to the position of bishop through her steady and sincere activities, she still struggles to help the elderly, women, and children who are oppressed in her country of service."},{"spoiler":false,"text":"Because of this, she often clashes with the upper echelons of the church and the state. Even so, she is a woman of compassion and faith who is never intimidated or frustrated."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c78430"},{"segments":[{"spoiler":false,"text":"奉仕国家における教会の堕落と腐敗を憂い、その改革を目指す女司教。"},{"spoiler":false,"text":"地道かつ誠実な活動で司教の地位にまで上った今も、奉仕国家で虐げられている老人や女子供を救うため奔走している。"},{"spoiler":false,"text":"そのため、教会や国の上層部と衝突することも多い。"},{"spoiler":false,"text":"それでも一向に怯まず、挫けることのない慈愛と信念の人。"}],"source":"egs","sourceCharacterId":"20422","sourceWorkId":"27081","spoiler":false},{"segments":[{"spoiler":false,"text":"她是一名女主教，对侍奉之国教会的堕落和腐败忧心忡忡，誓要对其进行改革。"},{"spoiler":false,"text":"凭借踏实而真诚的努力，她获得了主教的地位。"},{"spoiler":false,"text":"尽管如此，她也没有放弃侍奉之国中遭受虐待的老人妇孺，时刻为拯救他们而奔走着。"},{"spoiler":false,"text":"因此，她常常与教会和国家的高层官员发生冲突。"},{"spoiler":false,"text":"但她拥有坚定的慈爱之心和信念，所以从不退缩。"},{"spoiler":false,"text":"“……神绝不会对这个悖德的地方弃之不顾。”"}],"source":"bangumi","sourceCharacterId":"67382"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/079729d9d4d0374b7264bbc52c8992a5d4458dd4b06db203db64782c29110d03.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69760b90934503bd9ef34993d4f8984b98e9a16c5be0898de655e71755dd48d7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"霧島はるな","creatorId":"vndb:s2698","sourcePersonId":"vndb:s2698","canonicalEntityId":"vndb:s2698","name":"霧島はるな(水無月じゅん)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:256515:67382:13771:1","source":"bangumi"}]},{"characterId":"char_c78431","characterName":"ラドミラ","sourceIds":{"bangumi":[{"characterId":"67383","match":"exact-normalized-name-in-linked-work","subjectId":"256515"}],"egsCharacterIds":["20423"],"vndbCharacterId":"c78431"},"originalCharacterName":"ラドミラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A former prostitute, she quickly became the king's favorite mistress and gained the throne through her beauty and sexual skills. She is from a succubus race known as Tiefling. She has completely tamed the people around her with her powerful charm. She is arrogant and selfish and it is not unusual for her to change her orders at a whim. She doesn't care about others, and lives her life with enjoyment and pleasure in mind."}],"source":"vndb","sourceCharacterId":"c78431"},{"segments":[{"spoiler":false,"text":"元は一介の娼婦ながら、その美貌と性技で王の寵姫にまで昇りつめ、篭絡によって玉座を得た。"},{"spoiler":false,"text":"その正体は“ティーフリング”と呼ばれる淫魔であり、強力な“魅了”の力で周囲を完全に手懐けている。"},{"spoiler":false,"text":"傲岸不遜で、わがまま。気まぐれで命令が二転三転することも珍しくない。"},{"spoiler":false,"text":"他人の苦労には一切頓着せず、自分の楽しみが、快楽が一番という生き方を貫いている。"}],"source":"egs","sourceCharacterId":"20423","sourceWorkId":"27081","spoiler":false},{"segments":[{"spoiler":false,"text":"她凭借美貌成为国王的宠妃，随后笼络人心，得到了王位。"},{"spoiler":false,"text":"真实身份是“魔人”，利用强大的“魅惑之力”让周围的人对自己俯首帖耳。"},{"spoiler":false,"text":"她生性傲慢，且任性无比，时常会因心血来潮而随意改变命令。"},{"spoiler":false,"text":"蕊蜜拉从不把他人的辛苦放在眼里，对她来说，唯有自己的欢愉才是重中之重。"}],"source":"bangumi","sourceCharacterId":"67383"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e835a6ae2da89f735a00c54be1c75072848b25072d3d639f129f6053e5394c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/432f758119fb0a5da2e08368fc5e95cc0ea0a37fd6c2e008c3510830874d3bd6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:256515:67383:5741:1","source":"bangumi"}]},{"characterId":"char_c78432","characterName":"メノウ","sourceIds":{"bangumi":[{"characterId":"102775","match":"exact-normalized-name-in-linked-work","subjectId":"256515"}],"egsCharacterIds":["20429"],"vndbCharacterId":"c78432"},"originalCharacterName":"メノウ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The younger brother of the foxfolk leader Kohaku."},{"spoiler":false,"text":"Despite his time in the Nation, his kind and peaceful heart has not been tarnished."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c78432"},{"segments":[{"spoiler":false,"text":"「人狩り」によって奉仕国家に売られた狐人族の少年で、狐人族の長であるコハクの弟。"},{"spoiler":false,"text":"ラドミラのお気に入りとして寵愛され、今も折に触れて相手を務めている。"},{"spoiler":false,"text":"悪徳のはびこる奉仕国家にあって、今なお穏やかさと善良さを失わない心の優しい少年。"},{"spoiler":false,"text":"しかし肉体はラドミラに開発し尽くされ、常識も一部、いびつに歪んでしまっている。"}],"source":"egs","sourceCharacterId":"20429","sourceWorkId":"27081","spoiler":false},{"segments":[{"spoiler":false,"text":"在“狩猎”中惨遭俘虏的狐人族少年。狐人族首领琥珀的弟弟。"},{"spoiler":false,"text":"他生性纯良，即使身处风气败坏的侍奉之国，也依旧保持着善良与温和。"},{"spoiler":false,"text":"----"},{"spoiler":false,"text":"「人狩り」によって奉仕国家に売られた狐人族の少年で、狐人族の長であるコハクの弟。"},{"spoiler":false,"text":"ラドミラのお気に入りとして寵愛され、今も折に触れて相手を務めている。"},{"spoiler":false,"text":"悪徳のはびこる奉仕国家にあって今なお穏やかさと善良さを失わない心の優しい少年。"},{"spoiler":false,"text":"しかし肉体はラドミラに開発し尽くされ、常識も一部、いびつに歪んでしまっている。"},{"spoiler":false,"text":"「はい、奉仕国家は素晴らしい国ですよ？」"}],"source":"bangumi","sourceCharacterId":"102775"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/394985b70c48d91227cdd3f896465abbd2afc8f6548acaf3bdab7efedd511cdc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a83a5a1df4c0b539fae1c645d517f3634fd71f3674de8621bb6bd39417ceca74.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柚原みう","creatorId":"vndb:s977","sourcePersonId":"vndb:s977","canonicalEntityId":"vndb:s977","name":"柚原 みう","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:256515:102775:15162:1","source":"bangumi"},{"creditedName":"南十字 いっせい","creatorId":"vndb:s14234","sourcePersonId":"vndb:s14234","canonicalEntityId":"vndb:s14234","name":"南十字 いっせい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:78229","source":"vndb"}]},{"characterId":"char_c78433","characterName":"ディレク・ロンド","sourceIds":{"bangumi":[{"characterId":"102770","match":"exact-normalized-name-in-linked-work","subjectId":"256515"}],"egsCharacterIds":["20424"],"vndbCharacterId":"c78433"},"originalCharacterName":"ディレク・ロンド","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is the leader of the 6th Kingsguard of the Service State, known as the \"Black Dog Knights\". Formerly a mercenary, he has recently risen to prominence in the military service of the nation. Because of his ability and career, he is called the second coming of the mercenary king Volt."},{"spoiler":false,"text":"He is a fierce general with great ambition to usurp the throne, and the violence and wisdom to match. He is willing to use any means to achieve his goal."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c78433"},{"segments":[{"spoiler":false,"text":"奉仕国家の第６近衛騎士団、通称“黒犬騎士団”の団長。"},{"spoiler":false,"text":"元は流れの傭兵だったが、近年、奉仕国家軍において頭角を現すに至った。"},{"spoiler":false,"text":"その実力と経歴から、傭兵王ヴォルトの再来と称される。"},{"spoiler":false,"text":"王位簒奪という大きな野心を持ち、それに見合うだけの暴力と智力を兼ね備えた猛将。"},{"spoiler":false,"text":"目的のためなら、どんな手段も厭わない。"}],"source":"egs","sourceCharacterId":"20424","sourceWorkId":"27081","spoiler":false},{"segments":[{"spoiler":false,"text":"侍奉之国的第六近卫骑士团——“黑犬骑士团”的团长。"},{"spoiler":false,"text":"他原本是一名流浪佣兵，近年来开始在侍奉之国的军队中崭露锋芒。"},{"spoiler":false,"text":"由于拥有高超的实力，并立下了累累战功，他被人誉为“佣兵王沃尔特再世”。"},{"spoiler":false,"text":"他野心勃勃，誓要篡夺王位，也拥有能使其实现的武力和智慧。"},{"spoiler":false,"text":"为达目的，他可以不择手段。"}],"source":"bangumi","sourceCharacterId":"102770"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e3f2c4b595488761cd488940ec80eef06c06dd6bda006ff931d1a807023ceaa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a8d3b0157983a0329ead8a017b79d3a0bd7c29fc3b8a11eba3b8a46cb5f295d.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c78434","characterName":"リュカオン","sourceIds":{"bangumi":[{"characterId":"102771","match":"exact-normalized-name-in-linked-work","subjectId":"256515"}],"egsCharacterIds":["20425"],"vndbCharacterId":"c78434"},"originalCharacterName":"リュカオン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A wolfman warrior under Derek’s command."},{"spoiler":false,"text":"The oldest member of his order, this wolfman uses his distinctly powerful body to lay waste to the battlefield."},{"spoiler":false,"text":"Believing that might is right, he has no pity for the weak or the defeated."},{"spoiler":false,"text":"His kind have a long-running conflict with the foxfolk species led by Kohaku."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c78434"},{"segments":[{"spoiler":false,"text":"ディレクに仕える餓狼族の戦士。"},{"spoiler":false,"text":"騎士団では最古参の一人で、獣人特有の強靭な肉体を駆使し、戦場を縦横に駆け巡る。"},{"spoiler":false,"text":"強さこそが正義であり、弱者や敗者への哀れみは持ち合わせていない。"},{"spoiler":false,"text":"コハクの率いる狐人族とは、種族として長い対立関係にある。"}],"source":"egs","sourceCharacterId":"20425","sourceWorkId":"27081","spoiler":false},{"segments":[{"spoiler":false,"text":"德里克麾下的饿狼族战士。"},{"spoiler":false,"text":"他是骑士团的老兵，驱使兽人特有的精壮肉体纵横沙场。"},{"spoiler":false,"text":"在他看来，强大就是硬道理。因此，他从不同情败者与弱者。"},{"spoiler":false,"text":"身为饿狼族的一员，他与琥珀统领的狐人族之间的关系不共戴天，这种对立关系已经维持了很长时间。"},{"spoiler":false,"text":"“小事一桩！我会向你献上上等的狐狸！”"}],"source":"bangumi","sourceCharacterId":"102771"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe71d0592c5db067d36dad3764a92e60654e0b6a46ced152762e1c6ba506fd2d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78fe9ed4b9b46879da1099286d507200f7335db7260be8f4bb53564a70afe725.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c78435","characterName":"ニコラ・ノイバウ","sourceIds":{"bangumi":[],"egsCharacterIds":["20426"],"vndbCharacterId":"c78435"},"originalCharacterName":"ニコラ・ノイバウ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Member of the Black Dog Knights."},{"spoiler":false,"text":"He was formerly a magician from Kimia, but his research into the forbidden arts led him to being exiled by Astrid."},{"spoiler":false,"text":"He is often looked down on for his stutter and his scrawny appearance, which has led to him becoming stubborn and resentful to others."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c78435"},{"segments":[{"spoiler":false,"text":"黒犬騎士団の団員。"},{"spoiler":false,"text":"もとはキミア出身の魔術師で、禁呪である“淫紋”の研究に手を出しアストリットに追放された過去を持つ。"},{"spoiler":false,"text":"ドモりがちな口調や貧相な外見から侮られることが多いが、その性根は頑固で逆恨みしやすいという厄介なもの。"}],"source":"egs","sourceCharacterId":"20426","sourceWorkId":"27081","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/518b1d9de4aeee02fff90474873c26e10a448fd466ba794f07b77c64705ae8d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e85f7ba37b3a454b05ae30c3151bc4690f93c7ba5e8d608fb90b70c35c362918.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c78436","characterName":"ケイル・ゲイル・ディンブル","sourceIds":{"bangumi":[{"characterId":"102773","match":"exact-normalized-name-in-linked-work","subjectId":"256515"}],"egsCharacterIds":["20427"],"vndbCharacterId":"c78436"},"originalCharacterName":"ケイル・ゲイル・ディンブル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A merchant that primarily operates in the United Mercantile States of Tull."},{"spoiler":false,"text":"Tempted by profits, he dealt in forbidden commodities, which brought him under harsh condemnation from Mel Mel, who believes in honest trading, and was expelled from the merchant guild."},{"spoiler":false,"text":"He always wears a gentle smile on his face, but behind that smile lurks a sly and scheming mind."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c78436"},{"segments":[{"spoiler":false,"text":"商業連合国家テュルルを主な活動の場としている商人。"},{"spoiler":false,"text":"儲けのために人身売買、麻薬の取引など禁止されている商行為を行ったため、真っ当な商売が信念のメル・メルと衝突し、商会組合を除籍されている。"},{"spoiler":false,"text":"柔和な笑顔を崩すことはないが、表に出さない腹黒さは格別。"}],"source":"egs","sourceCharacterId":"20427","sourceWorkId":"27081","spoiler":false},{"segments":[{"spoiler":false,"text":"以商业城邦联盟特露鲁为主要活动范围的商人。"},{"spoiler":false,"text":"为了利益，他染指了不法生意，"},{"spoiler":false,"text":"因此与诚信经商的玫露·梅鲁发生冲突，被商业联盟除名。"},{"spoiler":false,"text":"虽然脸上总是挂着温和的笑容，但其实满腹坏水。"},{"spoiler":false,"text":"“对商人来说，一枚铜币的价值等同于一滴鲜血……”"}],"source":"bangumi","sourceCharacterId":"102773"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92a8e33ea2b297eab1577ebe8027959f9822961d7331fb3897764666851a986c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01995842ed08cec891d86f95083792a3f80e6e021e116d615d29cf33b368d16f.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c78437","characterName":"レイモンドゥス・ルルス","sourceIds":{"bangumi":[{"characterId":"102774","match":"exact-normalized-name-in-linked-work","subjectId":"256515"}],"egsCharacterIds":["20428"],"vndbCharacterId":"c78437"},"originalCharacterName":"レイモンドゥス・ルルス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Formerly a devout priest of the Holy Kingdom, he heard the voice of god and was awakened to his teachings."},{"spoiler":false,"text":"Doing what the voice told him, he sought Seraphina, but the church branded him as a heretic and banished him from the Holy Kingdom."},{"spoiler":false,"text":"Yet Raymond still follows his divine inspiration and continues his search."},{"spoiler":false,"text":"No one else is able to hear the voice of this god he speaks of, nor can he prove to anybody that this god is real."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c78437"},{"segments":[{"spoiler":false,"text":"神聖王国出身の敬虔な神官だったが、ある時“神”の声を聞き真実の教えに目覚めてしまう。"},{"spoiler":false,"text":"その声に従いセラフィーナを求め、それ故に神聖王国から邪教徒の烙印を押されて追放されている。"},{"spoiler":false,"text":"だがレイモンドゥスは今も、“神”の声の導くままにセラフィーナを求めている。"},{"spoiler":false,"text":"ただし、彼の語る“神”の声は他の誰にも聞こえず、それが本物の神であるという証明も誰にもできない。"}],"source":"egs","sourceCharacterId":"20428","sourceWorkId":"27081","spoiler":false},{"segments":[{"spoiler":false,"text":"他出生于神圣王国，原本是一名虔诚的神官，但某一天，他听到了“神”之声，从此便领悟了真正的教诲。"},{"spoiler":false,"text":"由于遵从那个声音追寻瑟拉菲娜，他被神圣王国打上邪教徒的烙印，遭到了流放。"},{"spoiler":false,"text":"直到现在，雷孟杜司依旧遵循“神”之声，寻求着瑟拉菲娜。"},{"spoiler":false,"text":"除了他本人之外，没有人能听到所谓的“神”之声，因此也就没有人能证明那是真正的神。"},{"spoiler":false,"text":"“啊，神啊！我一定、一定会将瑟拉菲娜大人带到您的面前！ ”"}],"source":"bangumi","sourceCharacterId":"102774"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/dafa370b8ac432d7a62a1078f282b735ac2222ee1a0c02e618522bf18b374748.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9de82b7c750e234ee3599e3e6d6d7d7965271a2884a7891ddd0d03a014afb272.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c78438","characterName":"エルドニア王","sourceIds":{"bangumi":[{"characterId":"102776","match":"exact-normalized-name-in-linked-work","subjectId":"256515"}],"egsCharacterIds":["20430"],"vndbCharacterId":"c78438"},"originalCharacterName":"エルドニア王","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ruler of the vast desert kingdom of Eldonia."},{"spoiler":false,"text":"A greedy, arrogant king whose haughtiness cannot be broken by anybody."},{"spoiler":false,"text":"But recently, he confines himself within his palace and shows not even the slightest interest in politics or world affairs."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c78438"},{"segments":[{"spoiler":false,"text":"広大な砂漠を領土とする大国エルドニアの国王。"},{"spoiler":false,"text":"強欲かつ、傲慢な性格で、誰に対しても不遜な態度を崩さない。"},{"spoiler":false,"text":"だが、“伝説の娼姫”ミスティオラを手にして以来、王の関心は彼女にだけ注がれている。"},{"spoiler":false,"text":"今ではほとんど後宮に籠もり、政治にも世界情勢にもロクに興味を示さなくなっている。"}],"source":"egs","sourceCharacterId":"20430","sourceWorkId":"27081","spoiler":false},{"segments":[{"spoiler":false,"text":"以辽阔沙漠为疆土的大国伊尔东的国王。"},{"spoiler":false,"text":"他生性贪婪，为人傲慢，傲睨万物。"},{"spoiler":false,"text":"但是，自从得到了蜜思娣欧拉之后，他的注意力便完全倾注到了她身上。"},{"spoiler":false,"text":"如今，他几乎从不迈出后宫一步，对政治和世界局势都失去了兴趣。"},{"spoiler":false,"text":"「お主さえいれば、他に女はいらん。いや、何もいらん」"}],"source":"bangumi","sourceCharacterId":"102776"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b25c3c9e6120eb585239e554da013ac5b56bbe7aec34d5b4a6068f3e2046ca5b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/5302a79fb8f7f43e16b032941def7bf8395a365b6aea4fc54370eb190f24bbe7.webp","width":256,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p430","sourceCompanyId":"egs:brand:831","canonicalEntityId":"vndb:p430","name":"Liquid","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:27081:831","source":"egs"},{"companyId":"vndb:p430","sourceCompanyId":"vndb:p430","canonicalEntityId":"vndb:p430","name":"リキッド","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:106660:v23464","source":"vndb"},{"companyId":"vndb:p9483","sourceCompanyId":"vndb:p9483","canonicalEntityId":"vndb:p9483","name":"Shiravune","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:122189:v23464","source":"vndb"},{"companyId":"vndb:p9483","sourceCompanyId":"vndb:p9483","canonicalEntityId":"vndb:p9483","name":"Shiravune","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:122190:v23464","source":"vndb"},{"companyId":"vndb:p9483","sourceCompanyId":"vndb:p9483","canonicalEntityId":"vndb:p9483","name":"Shiravune","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:125582:v23464","source":"vndb"},{"companyId":"vndb:p18672","sourceCompanyId":"vndb:p18672","canonicalEntityId":"vndb:p18672","name":"iqdhk8t0hxww","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:132222:v23464","source":"vndb"},{"companyId":"vndb:p187","sourceCompanyId":"vndb:p187","canonicalEntityId":"vndb:p187","name":"アイチェリー","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:155727:v23464","source":"vndb"},{"companyId":"vndb:p430","sourceCompanyId":"vndb:p430","canonicalEntityId":"vndb:p430","name":"リキッド","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:65912:v23464","source":"vndb"},{"companyId":"vndb:p430","sourceCompanyId":"vndb:p430","canonicalEntityId":"vndb:p430","name":"リキッド","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:68707:v23464","source":"vndb"},{"companyId":"vndb:p430","sourceCompanyId":"vndb:p430","canonicalEntityId":"vndb:p430","name":"リキッド","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:69182:v23464","source":"vndb"},{"companyId":"vndb:p430","sourceCompanyId":"vndb:p430","canonicalEntityId":"vndb:p430","name":"リキッド","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:90399:v23464","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
