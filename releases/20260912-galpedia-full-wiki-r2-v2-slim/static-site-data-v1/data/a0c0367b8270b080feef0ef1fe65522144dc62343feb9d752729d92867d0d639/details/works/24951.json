eLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:181822","source":"egs"},{"creditedName":"林タロウ","creatorId":"egs:creator:29990","sourcePersonId":"egs:creator:29990","canonicalEntityId":"egs:creator:29990","name":"林タロウ","detail":"SD立ち絵・背景","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:288119","source":"egs"},{"creditedName":"那菜風誌","creatorId":"egs:creator:29989","sourcePersonId":"egs:creator:29989","canonicalEntityId":"egs:creator:29989","name":"那菜風誌","detail":"SDイベントグラフィック","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:288120","source":"egs"},{"creditedName":"六弦 アリス","creatorId":"vndb:s5347","sourcePersonId":"vndb:s5347","canonicalEntityId":"vndb:s5347","name":"六弦 アリス","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:115781","source":"vndb"},{"creditedName":"御雄 幸路","creatorId":"vndb:s9677","sourcePersonId":"vndb:s9677","canonicalEntityId":"vndb:s9677","name":"御雄 幸路","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:115783","source":"vndb"},{"creditedName":"御雄 幸路","creatorId":"vndb:s9677","sourcePersonId":"vndb:s9677","canonicalEntityId":"vndb:s9677","name":"御雄 幸路","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:115784","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c18372","characterName":"柊 京一郎","sourceIds":{"vndbCharacterId":"c18372"},"originalCharacterName":"柊 京一郎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"103"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this novel. A young man who came to Tokyo from his home village of Momoki to enroll in the Imperial University. Born into a family of landowners, he is the eldest son and heir. He has loving parents and a bright younger sister."},{"spoiler":false,"text":"He is kind, but having been taught \"nobility obligates\" by his parents, he has an inflexible streak that doesn't allow him to turn a blind eye to injustice."},{"spoiler":false,"text":"He excels at Itto-ryu swordsmanship, and for self-defense he brought with him a katana that has been passed down in his family for generations."},{"spoiler":false,"text":"He suffered a serious illness as a child, and upon recovery, he gained the ability to see spirits. Soon after his arrival in Tokyo, this ability of his was discovered by the military, and he is now being pressured into cooperation with them."},{"spoiler":false,"text":"\"Even so, it doesn't mean that I can run away. What you are doing is wrong. If you insist on keeping this up, I will become your opponent!\""}],"source":"vndb","sourceCharacterId":"c18372"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5a1f8d0e8007a8a78a4db00b8c21fa756b3ea11dcd43f331d5db3f7dd99be6b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22a0c92b8324b32e113744432185283a7a19988cace436d52c1223661891c9b0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鯱矛 太郎","creatorId":"vndb:s2364","sourcePersonId":"vndb:s2364","canonicalEntityId":"vndb:s2364","name":"内匠 靖明","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:61969","source":"vndb"}]},{"characterId":"char_vndb_c18373","characterName":"ミサキ","sourceIds":{"vndbCharacterId":"c18373"},"originalCharacterName":"ミサキ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"188"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"80"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young man who appears whenever Kyouichirou is in trouble."},{"spoiler":false,"text":"Just as Kyouichirou, he possesses supernatural abilities, and for that reason he warns him to stay away from the military."},{"spoiler":false,"text":"He is gruff, forceful, and somewhat enigmatic, but he becomes someone Kyouichirou can rely on when it matters."},{"spoiler":false,"text":"\"It's better not to get involved. Both for you and for me.\""}],"source":"vndb","sourceCharacterId":"c18373"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f25791b9d0ff5faa23b5c1299aa47add3a31fae544b6e02e5b119f0555ee79a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7f9a3fb0c324d507c41747728e01471cd69e395f6d0277182c4a39547e86fe6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"オイリーはな","creatorId":"vndb:s2027","sourcePersonId":"vndb:s2027","canonicalEntityId":"vndb:s2027","name":"オイリーはな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:61968","source":"vndb"}]},{"characterId":"char_vndb_c18374","characterName":"館林 開","sourceIds":{"vndbCharacterId":"c18374"},"originalCharacterName":"館林 開","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"816"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"80"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A military man who commands a reserve unit of the Imperial Japanese Army and possesses supernatural abilities such as summoning the dead."},{"spoiler":false,"text":"He has sworn loyalty to the Emperor who rules over Japan and is well-liked, but for certain reasons he has now relinquished his rank."},{"spoiler":false,"text":"Due to his conscientious and uncompromising personality, he is regarded as a hindrance by the military authorities."},{"spoiler":false,"text":"He is of noble birth."},{"spoiler":false,"text":"\"It's fine if you don't understand. Once you do, you won't be able to get away unscathed. That's why, forget about it, will you?\""}],"source":"vndb","sourceCharacterId":"c18374"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10813cf32ceb145f3e2f64c714338c0afc9f3802e11aac818fa58a4395aefd37.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84cbcfd086a773eb9e19384b25e13b573c4575017d0992765ff95d03e06d7e76.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"十利須我里","creatorId":"vndb:s82","sourcePersonId":"vndb:s82","canonicalEntityId":"vndb:s82","name":"日野 聡","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:61966","source":"vndb"}]},{"characterId":"char_vndb_c18375","characterName":"時雨","sourceIds":{"vndbCharacterId":"c18375"},"originalCharacterName":"時雨","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"611"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"68"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young leader of the Gohongatana Clan (lit., \"Five Swords Clan\" or \"Five Katanas Clan\"), a group of shamans who, since ancient times, have been in charge of the Emperors' burials and other religious ceremonies, unbeknownst to the general public. They possess secret arts and mystic tools that they use to perform sacred rites, exorcism and divination, and can also utilize for fighting and self-defense. However, due to certain circumstances, the Gohongatana Clan clashed with the military, and was removed from the government affairs."},{"spoiler":false,"text":"Currently, Shigure opposes the military's plans and is in direct conflict with them, which puts his life in danger."},{"spoiler":false,"text":"\"Kyouichirou, so you are happy to pamper such a handsome man as me? That's great, I'll borrow your lap as a pillow or whatever again, so look forward to it.\" — Shigure"},{"spoiler":false,"text":"\"Don't worry, I will stop your blow without fail.\" — Shigure"}],"source":"vndb","sourceCharacterId":"c18375"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c151d74c6906e0eef427297a4242d7c5610bccfac9eacc2fad65ce44592a4b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/8720bdeb05786d062df8359308ea8ea5f96c58b036921596b1339435a44d1688.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"泉 菊之介","creatorId":"vndb:s399","sourcePersonId":"vndb:s399","canonicalEntityId":"vndb:s399","name":"三浦 祥朗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:61965","source":"vndb"}]},{"characterId":"char_vndb_c18376","characterName":"千家 伊織","sourceIds":{"vndbCharacterId":"c18376"},"originalCharacterName":"千家 伊織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1128"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"183"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"78"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A radical within the military authorities who formulates and promotes the undead troops plan. However, all of these actions are for the sake of the Great Japanese Empire, and not for personal gain."},{"spoiler":false,"text":"He leads fourteen families of Shinto priests and possesses very strong supernatural abilities himself."},{"spoiler":false,"text":"A member of the new aristocracy."},{"spoiler":false,"text":"\"No matter how much you think about the country, what can you achieve in your current position? ...Nothing. That's why I will choose you for your own sake.\""}],"source":"vndb","sourceCharacterId":"c18376"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4e554aef6d025351e62ea2a1ef1d79e2155fab198896f1008298cf4faf3f4d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c3028af1abe0b43b1e293496d0b317a889467bc151c11e87e7ff6365c9d8484.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"四ツ谷 サイダー","creatorId":"vndb:s85","sourcePersonId":"vndb:s85","canonicalEntityId":"vndb:s85","name":"興津 和幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:61967","source":"vndb"}]},{"characterId":"char_vndb_c62001","characterName":"伊勢 薫","sourceIds":{"vndbCharacterId":"c62001"},"originalCharacterName":"伊勢 薫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"209"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the twins under Tatebayashi's command. His personality is more impulsive and fierce than his brother's."},{"spoiler":false,"text":"He suffered serious injuries in a recent accident and is still undergoing treatment."},{"spoiler":false,"text":"He belongs to one of the fourteen families of Shinto priests who can see and control spirits, but because he serves Tatebayashi, he is treated poorly by his fellow families of Shinto priests."},{"spoiler":false,"text":"\"Open, gates of the Underworld! Come forth, Number Eight, and kill our enemies!\""}],"source":"vndb","sourceCharacterId":"c62001"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d17d006da804b22e000c42f974917adcf024649face35c176692f447e3410f49.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c950299d488a1a8bc0a8a6129064d04bc7fc1e1500be3225698f3b958f3b297.webp","width":235,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤城和真","creatorId":"vndb:s1381","sourcePersonId":"vndb:s1381","canonicalEntityId":"vndb:s1381","name":"赤羽根 健治","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:61970","source":"vndb"}]},{"characterId":"char_vndb_c62002","characterName":"伊勢 馨","sourceIds":{"vndbCharacterId":"c62002"},"originalCharacterName":"伊勢 馨","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"209"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the twins under Tatebayashi's command. He is composed and intelligent."},{"spoiler":false,"text":"His younger brother, Kaoru, suffered serious injuries in a recent accident and is still undergoing treatment. For this reason, Kahoru is always worried about Kaoru's health."},{"spoiler":false,"text":"During combat operations, he often forms a joint front with his brother."},{"spoiler":false,"text":"He belongs to one of the fourteen families of Shinto priests who can see and control spirits, but because he serves Tatebayashi, he is treated poorly by his fellow families of Shinto priests."},{"spoiler":false,"text":"\"This is indeed a sound argument. However, citizen, it's very impudent to express your opinion without knowing the reality. I'll teach the reality to you.\""}],"source":"vndb","sourceCharacterId":"c62002"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1ca5a2576d759bf9183b7c2552f1111e005a23c090b6719e5537bf234e0014cf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/460c5c953b28aa82932028bee785c05ad920b5f329e03cb5dd0058b93373432c.webp","width":230,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤城和真","creatorId":"vndb:s1381","sourcePersonId":"vndb:s1381","canonicalEntityId":"vndb:s1381","name":"赤羽根 健治","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:61971","source":"vndb"}]},{"characterId":"char_vndb_c62003","characterName":"雄真","sourceIds":{"vndbCharacterId":"c62003"},"originalCharacterName":"雄真","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"703"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An individual under Tatebayashi's command who possesses supernatural powers."},{"spoiler":false,"text":"He is not originally a military man, but has become Tatebayashi's subordinate for a certain purpose. He is a man of few words, but he is the most skilled swordsman in the Tatebayashi's squad."},{"spoiler":false,"text":"He saved many lives during the explosion accident that occurred a year ago."},{"spoiler":false,"text":"Shigure has a deep-seated grudge against him and attacks him at every opportunity."},{"spoiler":false,"text":"\"I don't have time to deal with you... There is someone waiting for me.\""}],"source":"vndb","sourceCharacterId":"c62003"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8302185352b71e3a3091879ad5d3aea8e8c93e38eefcdbce91b6f07916bcf41f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc65cca0f9482069af4f96dca28ef8cda4bc7e3a60ed50f557c444b79f59cc4e.webp","width":227,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62004","characterName":"時任 灯子","sourceIds":{"vndbCharacterId":"c62004"},"originalCharacterName":"時任 灯子","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"404"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An individual under Tatebayashi's command who possesses supernatural powers. She can control spirits with her whip."},{"spoiler":false,"text":"A woman with a kind, dignified personality and strong will. She became a soldier for a certain purpose."},{"spoiler":false,"text":"She mainly provides rear support."},{"spoiler":false,"text":"\"I can put it more simply for you. I'm telling you to bring it on!\" — Tokitou Touko."},{"spoiler":false,"text":"\"Tatebayashi-sama. I'll take my leave now.\" — Tokitou Touko."}],"source":"vndb","sourceCharacterId":"c62004"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/0021abd7f73d31529d491efa4ec310acf86a5a42506b1d650451341ce1872afb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f23280579a5502c4ed508513125d39551cc39e6c267399d7b7add4c57e1ce1b.webp","width":229,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62005","characterName":"臣","sourceIds":{"vndbCharacterId":"c62005"},"originalCharacterName":"臣","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An old-timer of the Gohongatana Clan, he is Shigure's right-hand man and participates in planning, managing clan members, and leading military operations."},{"spoiler":false,"text":"Although he is wary of outsiders and it's not easy to win his trust, he can be described as a giant with a gentle heart and is easily moved to tears, which makes him a target of Shigure's teasing every time. He is a stable presence who provides invaluable moral support to Shigure and is deeply trusted by him in return."},{"spoiler":false,"text":"He maintains discipline within the organization and can often be heard lecturing Shigure as one would an unruly kid."},{"spoiler":false,"text":"\"You'd be setting a bad example as a leader. I hate to say it, but it seems that you still haven't outgrown your childhood habit of relying on Yuuma. I'd spank you if you were my son.\""}],"source":"vndb","sourceCharacterId":"c62005"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/012f9af69d1c3850a68b116a787aaff38c4f1ded489596779a49493e4ba4a7c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95a31fa50230d0e2fdfba020777e1dc5cd7243f9bfa68fdd0bfacbb5cffb8d49.webp","width":204,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62006","characterName":"天司","sourceIds":{"vndbCharacterId":"c62006"},"originalCharacterName":"天司","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The young heir to the imperial throne and a descendant of an ancient line said to trace its origins back to the Gods."},{"spoiler":false,"text":"Despite his young age, he is wise, capable and takes his responsibilities very seriously. The people of the Japanese Empire have high hopes for his future rule."}],"source":"vndb","sourceCharacterId":"c62006"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bbd1c5c7d141343781992c5caf8ac367edbab7ffa65665384f1fb1c433f00e97.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35c48daa8b4ad9e79c2cf804a4a85bd1c027ea7818fd89ce330c29e69f007bbe.webp","width":228,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐倉 七","creatorId":"vndb:s7956","sourcePersonId":"vndb:s7956","canonicalEntityId":"vndb:s7956","name":"照井 春佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:61972","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p3638","sourceCompanyId":"egs:brand:4199","canonicalEntityId":"vndb:p3638","name":"dramatic create","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:2495