b:vn-staff:131252","source":"vndb"},{"creditedName":"Y.Isoco","creatorId":"vndb:s9512","sourcePersonId":"vndb:s9512","canonicalEntityId":"vndb:s9512","name":"Y.Isoco","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:131254","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c92501","characterName":"白洲 権兵衛","sourceIds":{"vndbCharacterId":"c92501"},"originalCharacterName":"白洲 権兵衛","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this story. Born and raised in Kawaguchi, 21 years old."},{"spoiler":false,"text":"A young man who wants to live and enjoy life while avoiding troublesome things as much as possible."},{"spoiler":false,"text":"Possess an inferiority complex, but also the absolute groundless confidence that he can do anything."},{"spoiler":false,"text":"Dropped out during university. Refusing to inherit his father's foundry business, however, he did not get a full-time job after that, and is now a freeter."},{"spoiler":false,"text":"He is a little reluctant to be called Gonbee, and insisted on \"Gonnohyoue\" when it comes to addressing himself."},{"spoiler":false,"text":"Love poetry in general."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c92501"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46f9d781b459c0dfbb283c2b51cfc29d17be789ddeccdeb087c9da7e1d43b5ea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa9021e55a2816727d0d95641e0ff942eea8e2b9995c1cd674c9e0ff89726025.webp","width":116,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c92502","characterName":"黒川 さやか","sourceIds":{"vndbCharacterId":"c92502"},"originalCharacterName":"黒川 さやか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Born in Atsugi City, Kanagawa Prefecture. Moved to Akabane, Kita-ku, Tokyo when she entered university."},{"spoiler":false,"text":"In order to pay tuition fees, Sayaka got a part-time job at a drug store. After that, she dropped out of university and became a full-time employee."},{"spoiler":false,"text":"Managing warehouse operations and ordering operations for 5 stores in the second area all by herself and currently holding the title of Deputy General Manager of Product Materials Department at the age of 21, she is well-known for her workaholic personality."},{"spoiler":false,"text":"Sayaka has over 100 hours as monthly overtime, even though the company does not pay overtime for its employees."},{"spoiler":false,"text":"Like painting, especially oil paintings."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c92502"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0cf0dc57b23dbe041fd8ecf98fdd14f98f37b4d3ce086112bdefdb67be08a9f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f41afc10f60f6cbbe54cea3246542d6e745f9fd0918d579b01b7dc5379c5063.webp","width":173,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c92589","characterName":"青木 利雄","sourceIds":{"vndbCharacterId":"c92589"},"originalCharacterName":"青木 利雄","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"43"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Gonbee's direct boss. Single."},{"spoiler":false,"text":"Following the transfer notice, Aoki takes him to the Material Department to meet Sayaka."},{"spoiler":true,"text":"Later on in the story, the true purpose of this transfer is revealed to alleviate Sayaka's workaholic personality, since it results in her being alienated from other colleagues in the company."}],"source":"vndb","sourceCharacterId":"c92589"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c92596","characterName":"吉田 真魚","sourceIds":{"vndbCharacterId":"c92596"},"originalCharacterName":"吉田 真魚","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A colleague working with Gonbee during his first week of the part-time job."}],"source":"vndb","sourceCharacterId":"c92596"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c92597","characterName":"飛沢 剛","sourceIds":{"vndbCharacterId":"c92597"},"originalCharacterName":"飛沢 剛","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Takeshi was sent to the Material Department"},{"spoiler":true,"text":"as a substitution for Sayaka when she was sick."},{"spoiler":false,"text":"A hardworking man with a small physique. He possesses the \"I can do it!\" aura from the first impression."}],"source":"vndb","sourceCharacterId":"c92597"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId"