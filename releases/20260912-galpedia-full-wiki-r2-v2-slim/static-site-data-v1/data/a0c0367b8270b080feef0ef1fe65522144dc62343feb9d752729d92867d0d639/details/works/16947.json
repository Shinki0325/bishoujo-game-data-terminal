{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"16947","model":{"presentationWorkId":"vndb:v10326","staff":{"artwork":[{"creditedName":"アマクラ","creatorId":"vndb:s6647","sourcePersonId":"egs:creator:8763","canonicalEntityId":"vndb:s6647","name":"アマクラ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:104425","source":"egs"}],"scenario":[{"creditedName":"真砂あつき","creatorId":"vndb:s9705","sourcePersonId":"egs:creator:16816","canonicalEntityId":"vndb:s9705","name":"真砂あつき","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:104426","source":"egs"},{"creditedName":"はちみつくん","creatorId":"vndb:s9702","sourcePersonId":"vndb:s9702","canonicalEntityId":"vndb:s9702","name":"はちみつくん","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:87995","source":"vndb"},{"creditedName":"川石 幸宏","creatorId":"vndb:s10403","sourcePersonId":"vndb:s10403","canonicalEntityId":"vndb:s10403","name":"川石 幸宏","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:87999","source":"vndb"}],"music":[{"creditedName":"Jun-z","creatorId":"vndb:s9706","sourcePersonId":"egs:creator:17144","canonicalEntityId":"vndb:s9706","name":"Jun-z","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:107224","source":"egs"}],"other":[{"creditedName":"夕燈 とび","creatorId":"vndb:s1911","sourcePersonId":"vndb:s1911","canonicalEntityId":"vndb:s1911","name":"夕燈 とび","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:87990","source":"vndb"},{"creditedName":"癸 乙夜","creatorId":"vndb:s2829","sourcePersonId":"vndb:s2829","canonicalEntityId":"vndb:s2829","name":"癸乙夜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:87991","source":"vndb"},{"creditedName":"路","creatorId":"vndb:s4002","sourcePersonId":"vndb:s4002","canonicalEntityId":"vndb:s4002","name":"路","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:87992","source":"vndb"},{"creditedName":"アマクラ","creatorId":"vndb:s6647","sourcePersonId":"vndb:s6647","canonicalEntityId":"vndb:s6647","name":"アマクラ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:87993","source":"vndb"},{"creditedName":"真砂 あつき","creatorId":"vndb:s9705","sourcePersonId":"vndb:s9705","canonicalEntityId":"vndb:s9705","name":"真砂 あつき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:87997","source":"vndb"},{"creditedName":"天乃 アト","creatorId":"vndb:s39464","sourcePersonId":"vndb:s39464","canonicalEntityId":"vndb:s39464","name":"天乃 アト","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:88000","source":"vndb"}]},"cast":[{"characterId":"char_c24056","characterName":"姫川 絢美","sourceIds":{"bangumi":[{"characterId":"22513","match":"exact-normalized-name-in-linked-work","subjectId":"42849"}],"egsCharacterIds":["249"],"vndbCharacterId":"c24056"},"originalCharacterName":"姫川 絢美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a popular, cheerful, and beautiful girl in her class. She is very popular with both boys and girls, especially with boys, who frequently confess their feelings to her, but the rejection rate is 100%."},{"spoiler":false,"text":"According to her, she is “not good at troublesome relationships.\" She and the main character have had a close relationship since their junior high school days, and they like to talk foolishly with each other."},{"spoiler":false,"text":"In junior high school, she was the ace of the swimming team and showed great promise for the future, but now she is a member of the “Intellectual and Cultural Studies Club,” which the protagonist established for fun."},{"spoiler":false,"text":"She says she is “tired of working so hard every day.\" She seems to be the only sensible person in the group, and is often seen as a follower."},{"spoiler":false,"text":"She has a deep interest in sexual matters, but she keeps this to herself."},{"spoiler":false,"text":"As a side note: she's the youngest of the three Himekawa sisters."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c24056"},{"segments":[{"spoiler":false,"text":"【腐れ縁で人気者のクラスメイト】"},{"spoiler":false,"text":"クラスでも人気の明朗快活な美少女。"},{"spoiler":false,"text":"男女ともに特に男子からの人気はとても高く、頻繁に告白なども行なわれているが撃沈率100％。"},{"spoiler":false,"text":"本人曰く「面倒な関係ごとが苦手」との事だが。"},{"spoiler":false,"text":"主人公とは中学時代からの腐れ縁で、互いに馬鹿話などが出来る関係を気に入っている。"},{"spoiler":false,"text":"中学時代は水泳部のエースとして将来を期待されていたが、現在は主人公が戯れに設立した【知的文化学研究同好会】に在籍。"},{"spoiler":false,"text":"「日々気を張って頑張るのに疲れた」との話だが。"},{"spoiler":false,"text":"【知的文化学研究同好会】では唯一の常識人らしく、フォローに周り気味のポジション。"},{"spoiler":false,"text":"気づけば中心にいるコトが多い絢美にとっては、そういうトコロを含め心地良いらしい。"},{"spoiler":false,"text":"……実は耳年増でＨな事への興味も深々だが、そんな態度はおくびにも出さず一人胸の中へ閉まっている。"},{"spoiler":false,"text":"「ねえ……、あたしとえっちなコト……試してみない？」"}],"source":"egs","sourceCharacterId":"249","sourceWorkId":"16947","spoiler":false},{"segments":[{"spoiler":false,"text":"クラスでも人気の明朗快活な美少女。"},{"spoiler":false,"text":"男女ともに、特に男子からの人気はとても高く、頻繁に告白なども行なわれているが撃沈率100％。"},{"spoiler":false,"text":"本人曰く 「面倒な関係ごとが苦手」 とのことだが。"},{"spoiler":false,"text":"主人公とは中学時代からの腐れ縁で、互いに馬鹿話などができる関係を気に入っている。"},{"spoiler":false,"text":"中学時代は水泳部のエースとして将来を期待されていたが、現在は主人公が戯れに設立した 『知的文化学研究同好会』 に在籍。 「日々気を張って頑張るのに疲れた」 とのこと。"},{"spoiler":false,"text":"『知的文化学研究同好会』 では唯一の常識人らしく、フォローに回り気味のポジション。"},{"spoiler":false,"text":"気づけば中心にいるコトが多い絢美にとっては、そういうトコロを含め心地良いらしい。"},{"spoiler":false,"text":"……実は耳年増でエッチなことへの興味も深々だが、そんな態度はおくびにも出さず、一人胸の中へ閉まっている。"},{"spoiler":false,"text":"「ねえ……、あたしとえっちなコト……試してみない？」"}],"source":"bangumi","sourceCharacterId":"22513"}],"profileFacts":[{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"249","sourceWorkId":"16947","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"249","sourceWorkId":"16947","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"249","sourceWorkId":"16947","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"249","sourceWorkId":"16947","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3206c915101aad1c08f7bd31d341e258a46076e0187fd88f76025066a51ca8d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c9f5a107cd7ffae35f85f2c2c34e158b9158723e370e0fbc762238745ecfced.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平山ゆかり","creatorId":"vndb:s285","sourcePersonId":"vndb:s285","canonicalEntityId":"vndb:s285","name":"東かりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:42849:22513:5905:1","source":"bangumi"}]},{"characterId":"char_c24057","characterName":"楠木 末梨","sourceIds":{"bangumi":[{"characterId":"22515","match":"exact-normalized-name-in-linked-work","subjectId":"42849"}],"egsCharacterIds":["250"],"vndbCharacterId":"c24057"},"originalCharacterName":"楠木 末梨","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"73"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a beautiful loli girl one year below the main character."},{"spoiler":false,"text":"She is a promising newcomer to the Intellectual and Cultural Studies Club, the same club as the main character. She is basically quiet and has an elusive personality, but when she opens her mouth..."},{"spoiler":false,"text":"Even in the circle, she is always facing her computer screen and rarely participates in conversations. Her hobby is Western video games. Especially in FPS games, she is so skilled that she ranks high in the online ranking. She uses expensive headphones when she plays FPS games, and of course she brings her own gaming mouse."},{"spoiler":false,"text":"She often eats squid. Whenever she shows up at the club, she usually buys something from the store. She eats it in the club room with the PC on her other hand. She is addicted to squid buns sold at a certain convenience store."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c24057"},{"segments":[{"spoiler":false,"text":"【洋ゲー好きで無口で実は毒舌なロリ美少女】"},{"spoiler":false,"text":"１学年下のロリ美少女。"},{"spoiler":false,"text":"主人公と同じ【知的文化学研究同好会】に今年入ってきた期待の新人。"},{"spoiler":false,"text":"基本無口で捉えどころの無い性格なのだが、口を開くと……。"},{"spoiler":false,"text":"サークルでも常に自分のＰＣ画面と向かい合い、会話に参加する事はあまり無い。"},{"spoiler":false,"text":"趣味は洋ゲー。"},{"spoiler":false,"text":"特にＦＰＳ系ゲームでは、オンラインランキングでも上位に入る程の腕前を持つ。"},{"spoiler":false,"text":"（FPS時は高そうなヘッドフォンを使用している、マウスはもちろん持参の所謂ゲーミングマウス）"},{"spoiler":false,"text":"よくイカを口にしている。同好会に顔を出す時は大抵購買で何か買ってきてる。"},{"spoiler":false,"text":"何故購買でそんなモノが？的なイカ料理（？）を部室でＰＣ片手に食べている。"},{"spoiler":false,"text":"某コンビニで売り出しているイカまんにハマっている。"},{"spoiler":false,"text":"「……触らないでください。素人童貞がうつります」"}],"source":"egs","sourceCharacterId":"250","sourceWorkId":"16947","spoiler":false},{"segments":[{"spoiler":false,"text":"1学年下のロリ美少女。 『知的文化学研究同好会』 に今年入ってきた期待の新人。"},{"spoiler":false,"text":"基本無口で捉えどころのない性格なのだが、口を開くと……。"},{"spoiler":false,"text":"サークルでも常に自分のPCの画面と向かい合い、会話に参加することはあまり無い。"},{"spoiler":false,"text":"趣味は洋ゲー。特にFPS系ゲームでは、オンラインランキングでも上位に入る程の腕前を持つ。"},{"spoiler":false,"text":"（FPS時は高そうなヘッドフォンを使用している。マウスはもちろん持参のゲーミングマウス。）"},{"spoiler":false,"text":"よくイカを口にしている。同好会に顔を出す時は大抵購買で何か買ってきている。"},{"spoiler":false,"text":"なぜ購買でそんなモノが？ 的なイカ料理（？）を、部室でPC片手に食べている。"},{"spoiler":false,"text":"某コンビニで売り出しているイカまんにハマっている。"},{"spoiler":false,"text":"「……触らないでください。素人童貞がうつります」"}],"source":"bangumi","sourceCharacterId":"22515"}],"profileFacts":[{"label":"胸围（本版本）","value":"73 cm","valueContext":null,"source":"egs","sourceCharacterId":"250","sourceWorkId":"16947","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"145 cm","valueContext":null,"source":"egs","sourceCharacterId":"250","sourceWorkId":"16947","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"250","sourceWorkId":"16947","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"250","sourceWorkId":"16947","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a68a6cde3081003bc969f59d77e33b3c867972fceb679d55d14a643c9a0679eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/869fcbab10b6a948ed67f47f6913033a8461319ea3c5df677474556b673f44c3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:42849:22515:5922:1","source":"bangumi"}]},{"characterId":"char_c24058","characterName":"響 七瀬","sourceIds":{"bangumi":[{"characterId":"22514","match":"exact-normalized-name-in-linked-work","subjectId":"42849"}],"egsCharacterIds":["251"],"vndbCharacterId":"c24058"},"originalCharacterName":"響 七瀬","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"102"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a beautiful older sister-type girl who is one year older than the main character."},{"spoiler":false,"text":"She belongs to the same “Intellectual and Cultural Studies Club” as the main character. She established this club at the instigation of the main character and forced the main character to become the head of the club as it is. According to her, “This is my harem.\""},{"spoiler":false,"text":"With her aloof personality, she plays with the main character by making numerous comments whose true meaning is hard to gauge. She has a large number of fans in the school because of her bewitching beauty and outstanding style, but according to her, “I'm only interested in younger girls.\""},{"spoiler":false,"text":"Although she plays around with the main character, she is like an older sister who cares about him in some way."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c24058"},{"segments":[{"spoiler":false,"text":"【妖艶な美貌と抜群のスタイル持つ『知的文化学研究同好会』影の実権者】"},{"spoiler":false,"text":"１学年上のお姉さんタイプの美女。"},{"spoiler":false,"text":"主人公と同じ【知的文化学研究同好会】に所属。"},{"spoiler":false,"text":"同サークルを主人公を唆して設立し、主人公にそのまま部長職も押しつけた。"},{"spoiler":false,"text":"本人曰く「ここは私のハーレムなのよ」"},{"spoiler":false,"text":"飄々とした性格で、真意を計りかねる発言の数々で主人公を弄り倒している。"},{"spoiler":false,"text":"その妖艶な美貌と抜群のスタイルから学園内に大量のファンが存在しているが、本人曰く「年下以外興味が無い」らしい。"},{"spoiler":false,"text":"主人公の事を弄り回してはいるが、何かと気に掛けてくれているお姉さん的存在。"},{"spoiler":false,"text":"「私に勝つコトができたら脱いであげる、その代わり、私が勝ったらヒロにはブリーフを履いてもらうわ」"}],"source":"egs","sourceCharacterId":"251","sourceWorkId":"16947","spoiler":false},{"segments":[{"spoiler":false,"text":"1学年上のお姉さんタイプの美女。 『知的文化学研究同好会』 に所属。"},{"spoiler":false,"text":"同サークルを主人公を唆して設立し、主人公にそのまま部長職も押しつけた。"},{"spoiler":false,"text":"本人曰く 「ここは私のハーレムなのよ」。"},{"spoiler":false,"text":"飄々とした性格と、真意を計りかねる発言の数々で主人公をいじり倒している。"},{"spoiler":false,"text":"その妖艶な美貌と抜群のスタイルから学園内に大量のファンが存在しているが、本人曰く 「年下以外興味が無い」 らしい。"},{"spoiler":false,"text":"主人公のことをいじり回してはいるが、なにかと気に掛けてくれているお姉さん的存在。"},{"spoiler":false,"text":"「私に勝つコトができたら脱いであげる、その代わり、私が勝ったらヒロにはブリーフを履いてもらうわ」"}],"source":"bangumi","sourceCharacterId":"22514"}],"profileFacts":[{"label":"胸围（本版本）","value":"102 cm","valueContext":null,"source":"egs","sourceCharacterId":"251","sourceWorkId":"16947","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"251","sourceWorkId":"16947","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"251","sourceWorkId":"16947","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"251","sourceWorkId":"16947","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7621499ab34905bc4205a602f3f441ad57bb28dc16b