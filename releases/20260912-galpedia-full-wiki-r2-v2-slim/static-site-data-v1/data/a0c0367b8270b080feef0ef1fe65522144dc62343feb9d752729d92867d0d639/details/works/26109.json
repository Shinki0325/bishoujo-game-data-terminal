{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"26109","model":{"presentationWorkId":"vndb:v26525","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_100197","characterName":"たかみや　なつき","sourceIds":{"bangumi":[{"characterId":"100197","match":"source-roster","subjectId":"325165"}]},"originalCharacterName":"たかみや　なつき","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"123"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いつも本を持ち歩いている少女。"},{"spoiler":false,"text":"落ち着いた性格をしているが、主人公のことを「大人」と認識していないフシがある。"},{"spoiler":false,"text":"「おとなの人にはないしょですよ」"},{"spoiler":false,"text":"ときおり、同年代の友達のように接してくるのはそのせいだろうか。"},{"spoiler":false,"text":"愛読書は「走馬燈探偵」シリーズ。"}],"source":"bangumi","sourceCharacterId":"100197"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87d057150f6bb04e56c853bf2ed73a689cd6a810b6ab2ee56eea5845a9e6885e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a0d9ed73e0c04fa37435090ac1ee5c56082547fb76683fccb020942b2b119e4.webp","width":146,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_100198","characterName":"からすま　ひなこ","sourceIds":{"bangumi":[{"characterId":"100198","match":"source-roster","subjectId":"325165"}]},"originalCharacterName":"からすま　ひなこ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"112"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水たまりを飛び越えることすら怖がる少女。"},{"spoiler":false,"text":"しきりに身震いをしているせいか、すぐに疲れて眠ってしまう。"},{"spoiler":false,"text":"「すぅ……すぅ……」"},{"spoiler":false,"text":"自分を守ってくれる存在には敏感で、いつの間にか主人公からくっついて離れないように……。"},{"spoiler":false,"text":"トイレにもついてくる。"}],"source":"bangumi","sourceCharacterId":"100198"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc797e013eb7e1edb3d28afc22668ac461d9faa980a5f801dc351fe2a400e1e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1db2b99e65d71103e575b88aab29dd2dd97604110f69db4debb24dc45ac97515.webp","width":146,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_100199","characterName":"あきの　もみじ","sourceIds":{"bangumi":[{"characterId":"100199","match":"source-roster","subjectId":"325165"}]},"originalCharacterName":"あきの　もみじ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"123"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"秋野かえでの姉である少女。"},{"spoiler":false,"text":"なぜか「大人」を敵視しているため、しばしば主人公にちょっかいをかけてくる。"},{"spoiler":false,"text":"「ちびっこポルノばくだんってなに」"},{"spoiler":false,"text":"あの手この手で振り回してくるが、打ち解ける日がやってくるかは不明。"},{"spoiler":false,"text":"物怖じしない性格のせいか、薄着のときでも距離が近い。"}],"source":"bangumi","sourceCharacterId":"100199"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d536e0b42ef37a938e56e1ae12cac899e0434c944bee459edca44c657f72ded.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb54ef49e30cbb89688bdd60cbc4b7296e872dcd0d92aa073f039247686bbdee.webp","width":146,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藍沢夏癒","creatorId":"vndb:s3233