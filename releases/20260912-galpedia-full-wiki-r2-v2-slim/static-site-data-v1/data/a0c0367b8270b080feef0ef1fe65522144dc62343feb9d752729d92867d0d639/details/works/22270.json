ue":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"天木学園の２年生で、恵海や晴斗のクラスメイトであるメガネっ子。"},{"spoiler":false,"text":"明るく人なつっこい性格をしているため、男女問わず仲良く喋る。"},{"spoiler":false,"text":"晴斗もそんな中の１人で、お互いに席が近いのもあり、それなりに会話をしている関係。"},{"spoiler":false,"text":"オシャレ好きで容姿も良いため、性格の良さもあいまってこっそり男性人気が高かったりするが、本人はまったく気づいていない。"},{"spoiler":false,"text":"特別仲の良い友人はいないが、同じクラスの本庄さんや下村さんとは、よく行動を共にしている。"},{"spoiler":false,"text":"他の女子と同じく、恵海を憧れの対象として少し遠巻きに見ていたが、とある事件が切っ掛けとなり、その距離感が一気に詰まることとなる。"}],"source":"egs","sourceCharacterId":"7321","sourceWorkId":"22270","spoiler":false},{"segments":[{"spoiler":false,"text":"天木学園の2年生で、恵海や晴斗のクラスメイトであるメガネっ子。"},{"spoiler":false,"text":"明るく人なつっこい性格をしているため、男女問わず仲良くしゃべる。"},{"spoiler":false,"text":"晴斗ともお互いに席が近いのもあり、それなりに会話をしている関係。"},{"spoiler":false,"text":"オシャレ好きで容姿・性格ともに良いため、密かに男子人気が高かったりする。"},{"spoiler":false,"text":"特別に仲の良い友人はいないが、同じクラスの本庄さんや下村さんとよく一緒にいる。"},{"spoiler":false,"text":"恵海を憧れの対象として遠巻きに見ていたが、ある事件で一気に距離が縮まることに。"},{"spoiler":false,"text":"「えーみちゃーんっ！　今からお昼？ 一緒に食べよっ？」"}],"source":"bangumi","sourceCharacterId":"35822"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fbf3aca2cb2447c71973bd25420f62ca29a74061b5ebbd9181d4b7aac88a6a4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bbdb2c118a0870e2088b37a19b0d7bb8ab1f807d66b0cca9a76485b3e93caca1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:147662:35822:6349:1","source":"bangumi"}]},{"characterId":"char_c38147","characterName":"篠塚 恵海","sourceIds":{"bangumi":[{"characterId":"35823","match":"exact-normalized-name-in-linked-work","subjectId":"147662"}],"egsCharacterIds":["7322"],"vndbCharacterId":"c38147"},"originalCharacterName":"篠塚 恵海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"天木学園に通う２年生で、晴斗や陽砂と同じクラスに所属している。"},{"spoiler":false,"text":"常に学年トップの成績を維持し、身体能力抜群で誰とも群れないクールビューティなため、男女問わず高い人気を誇っている。"},{"spoiler":false,"text":"が、その実体は、単に他人とのコミュニケーションが苦手と言うだけだったりする。"},{"spoiler":false,"text":"学園生と言うのは世を忍ぶ仮の姿で、本業は天野家の、それも晴斗専属の使用人であり、メイド長だ。"},{"spoiler":false,"text":"ちなみに成人済ではあるが、それを隠して学園に通い、晴斗の身辺警護をしている。"},{"spoiler":false,"text":"晴斗以外とまともに喋らないため、現在までに友達と呼べる人間はいたことがない……はず、だったのだが。"}],"source":"egs","sourceCharacterId":"7322","sourceWorkId":"22270","spoiler":false},{"segments":[{"spoiler":false,"text":"天木学園に通う 2年生で、晴斗や陽砂と同じクラスに所属している。"},{"spoiler":false,"text":"常に学年トップの成績を維持し、身体能力抜群で男女問わず高い人気を誇っている。"},{"spoiler":false,"text":"誰とも群れないクールビューティーだが、実際はコミュニケーションが苦手なだけ。"},{"spoiler":false,"text":"本業は天野家の、晴斗専属の使用人であり、メイド長。"},{"spoiler":false,"text":"ちなみに成人しているが、それを隠して学園に通って晴斗の身辺警護をしている。"},{"spoiler":false,"text":"晴斗以外とまともに話さないため、今まで友達と呼べる人間はいなかったのだが……。"},{"spoiler":false,"text":"「いえ、自作のクロスワードパズルを解読するため、遠慮させていただきます」"}],"source":"bangumi","sourceCharacterId":"35823"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd375b919c96cbde433c3cc206f5f2d0c7bc5c5f989cb37ba8c63b6972021c9d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83af79c99a7566103a16c378d517d1bfbc3c14b1579e3e68fa1a9aec541af63e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩﨑春奈","creatorId":"vndb:s878","sourcePersonId":"vndb:s878","canonicalEntityId":"vndb:s878","name":"岩﨑 春奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:147662:35823:11648:1","source":"bangumi"}]},{"characterId":"char_c38149","characterName":"藤崎 恭平","sourceIds":{"bangumi":[{"characterId":"35826","match":"exact-normalized-name-in-linked-work","subjectId":"147662"}],"egsCharacterIds":["7324"],"vndbCharacterId":"c38149"},"originalCharacterName":"藤崎 恭平","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"容姿端麗、頭脳明晰、そのうえ物腰柔らかで男女分け隔て無く優しいと言う、天木学園の人気社会科教師。"},{"spoiler":false,"text":"一部の女子学生からはもちろん、同性に興味津々な男子学生からもキャーキャー言われている。"},{"spoiler":false,"text":"とは言え、婚約者もいるため、本人はあくまで教師として学生達と接しており、縦横無尽に襲い来るアプローチを全て笑顔でかわしている。"},{"spoiler":false,"text":"しかしてその実体は、晴斗の面倒を見るために送り込まれた、天野家の関係者だった。"},{"spoiler":false,"text":"そもそも大学生の頃、晴斗の家庭教師をしていた過去があり、実の兄のように慕われていると言う経緯もあったりする。"}],"source":"egs","sourceCharacterId":"7324","sourceWorkId":"22270","spoiler":false},{"segments":[{"spoiler":false,"text":"容姿端麗・頭脳明晰、物腰柔らかで男女分け隔てなく接する天木学園の社会科教師。"},{"spoiler":false,"text":"一部の女子学生、さらに同性に興味津々な男子学生からキャーキャー言われている。"},{"spoiler":false,"text":"とはいえ婚約者もいるため、本人はあくまで教師として教え子と接しており、"},{"spoiler":false,"text":"縦横無尽に襲い来るアプローチをすべて笑顔でかわしている。"},{"spoiler":false,"text":"その実体は、晴斗の面倒を見るために送り込まれた天野家の関係者。"},{"spoiler":false,"text":"大学生の頃に晴斗の家庭教師をしていた過去があり、実兄のように慕われている。"},{"spoiler":false,"text":"「天野くん、クロスワードは自分で作って解く遊びでしたでしょうか」"}],"source":"bangumi","sourceCharacterId":"35826"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b3c447c0cccad5fcb0bdc10e6bc610d1def615de16a2a44d9844609e7cd9407.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c71cc3426a4151b5fc5b6126035f0d3e55461f9896b7a052d3ff7f3eaeb9d57.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"古河徹人","creatorId":"vndb:s299","sourcePersonId":"vndb:s299","canonicalEntityId":"vndb:s299","name":"古河 徹人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:147662:35826:6265:1","source":"bangumi"}]},{"characterId":"char_c38150","characterName":"天野 晴斗","sourceIds":{"bangumi":[{"characterId":"35825","match":"exact-normalized-name-in-linked-work","subjectId":"147662"}],"egsCharacterIds":["7325"],"vndbCharacterId":"c38150"},"originalCharacterName":"天野 晴斗","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公であり、国内でも有数の資産家『天野家』当主の１人息子。"},{"spoiler":false,"text":"ある出来事を切っ掛けとして、同じクラスの瀬里沢陽砂に恋をする。"},{"spoiler":false,"text":"現在は天木学園の２年生として、陽砂や恵海と同じクラスで勉学に励んでいる。"},{"spoiler":false,"text":"お金持ちで、その事に関して鼻に掛けるようなことは無いのだが、両親からとある非常識な教えを受けているため、ある程度非常識な男の子として絶賛活躍中である。"},{"spoiler":false,"text":"一見すると喋り方もあいまって優男に見えるが、実は日頃からそれなりに鍛えているため、運動は割と得意。"}],"source":"egs","sourceCharacterId":"7325","sourceWorkId":"22270","spoiler":false},{"segments":[{"spoiler":false,"text":"国内でも有数の資産家・天野家当主の一人息子。"},{"spoiler":false,"text":"現在は天木学園の 2年生として、陽砂や恵海と同じクラスで勉学に励んでいる。"},{"spoiler":false,"text":"お金持ちであることを鼻に掛けるようなことはないが、"},{"spoiler":false,"text":"両親の非常識な教えを受けているため、ある程度 非常識な男子 として絶賛活躍中。"},{"spoiler":false,"text":"容姿としゃべり方から優男に見えるが、実はそれなりに鍛えているため運動はわりと得意。"},{"spoiler":false,"text":"ある出来事をキッカケとして、同じクラスの瀬里沢陽砂に恋をする。"},{"spoiler":false,"text":"「もしもし？ クロスワードがなに？ ……あれ、言ってない？」"}],"source":"bangumi","sourceCharacterId":"35825"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/0331e9c5adcae1f165e3ce32f5f7c1becbd28e71907b3621f12848922c1e8aaf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdee863d5a72d5580cef897e13c219e156d119b1fdb1757c426934d70e0c70ad.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c38148",