malized-name-in-linked-work","subjectId":"181507"}],"egsCharacterIds":["8266"],"vndbCharacterId":"c45566"},"originalCharacterName":"天条 舞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Fetish: Likes to be dominated."}],"source":"vndb","sourceCharacterId":"c45566"},{"segments":[{"spoiler":false,"text":"誰にでも優しい委員長タイプの学生会会長。"},{"spoiler":false,"text":"清廉とした雰囲気と美貌を持ち合わせているが、人当たりはよく、話しやすいため男女問わず人気高い、学業優秀、運動神経抜群、さらに、仕草に美を兼ね備えている理想的な大和撫子だが、機械には弱いため、その部分では主人公を頼りにしている。"},{"spoiler":false,"text":"主人公が自分に気があるのは知っており、満更でもないが、弟のように接する。"},{"spoiler":false,"text":"躾に厳しい家で育ったため、幼い頃から自分の本心を抑えて生きてきたが、本当の彼女はもっと活発で、お転婆。"},{"spoiler":false,"text":"心の中では自由に振る舞いたいと思っている。"}],"source":"egs","sourceCharacterId":"8266","sourceWorkId":"22980","spoiler":false},{"segments":[{"spoiler":false,"text":"学生会の会長を務める少女。 誰にでも優しい委員長タイプ。"},{"spoiler":false,"text":"学業優秀、運動神経抜群、さらに仕草に美を兼ね備えている理想的な大和撫子。"},{"spoiler":false,"text":"人当たりが良く話しやすいため男女問わず人気が高い。"},{"spoiler":false,"text":"主人公が自分に気があるのは知っており、満更でもないが、"},{"spoiler":false,"text":"躾に厳しい家で育ったため、幼い頃から自分の本心を抑えて生きてきた。"},{"spoiler":false,"text":"本来の彼女はもっと活発でお転婆。 心の中では自由に振る舞いたいと思っている。"},{"spoiler":false,"text":"“清廉であれ” という親の教えを頑なに守っているが、"},{"spoiler":false,"text":"友人のエッチな会話を聞くだけで興奮して濡れてしまうなど、淫乱性を秘めている。"},{"spoiler":false,"text":"主人公との行為で眠っていた性欲が解放され、言葉責めされることの喜びを感じるようになる。"},{"spoiler":false,"text":"固い意志で快楽に堕ちることに抗うが、感じやすい体質で、絶頂が近くなるとアヘアヘになる。"},{"spoiler":false,"text":"「ぐっ、ひ、卑怯者っ！　絶対に負けないっ…… あなたなんかに、絶対にっ……！」"}],"source":"bangumi","sourceCharacterId":"41098"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/dab620a125832bc4b8960c3e4b8304b4eb970c9f9ce593780471c6628cdab819.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c7f31fe57f2