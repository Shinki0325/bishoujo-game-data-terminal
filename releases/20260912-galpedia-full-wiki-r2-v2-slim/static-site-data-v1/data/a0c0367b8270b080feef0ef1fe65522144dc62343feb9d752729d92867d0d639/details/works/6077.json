tityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"商社に勤めるクールビューティなOL。"},{"spoiler":false,"text":"オフ会にもよく顔を出し、知的でクールな雰囲気の彼女は、メンバーのまとめ役として一目置かれている。"},{"spoiler":false,"text":"彼女の“ケン”像と、響の“ケン”像があまりにもかけ離れていることが、物語のカギを握っているように見えるが……？"}],"source":"egs","sourceCharacterId":"26445","sourceWorkId":"6077","spoiler":false},{"segments":[{"spoiler":false,"text":"商社に勤めるＯＬで、クールビューティの異名を持つ女性。"},{"spoiler":false,"text":"彼女が聞いていた「ケン」の像と、主人公の聞いていた「ケン」の像が"},{"spoiler":false,"text":"まったく一致しない所から、物語の発端となっていく。"},{"spoiler":false,"text":"オフ会にもよく顔を出し、知的でクールな雰囲気を持つ彼女は、"},{"spoiler":false,"text":"メンバーたちの知恵袋兼まとめ役として、一目置かれている。"}],"source":"bangumi","sourceCharacterId":"140355"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab86ed674bb616beea010c67b4f5e1eadaf4d46e6a23be3fdf19f81cf2e8a086.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec6719ac6df092c494e52ad2c056c1663ba27ab6471be7291882ad3ece737a0a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北条明日香","creatorId":"vndb:s1016","sourcePersonId":"vndb:s1016","canonicalEntityId":"vndb:s1016","name":"北条 明日香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:153652:140355:32486:1","source":"bangumi"}]},{"characterId":"char_c52541","characterName":"桝沢　玲子","sourceIds":{"bangumi":[{"characterId":"140356","match":"exact-normalized-name-in-linked-work","subjectId":"153652"}],"egsCharacterIds":["26446"],"vndbCharacterId":"c52541"},"originalCharacterName":"桝沢　玲子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美貌のネットアイドルにして、コスプレイヤー。"},{"spoiler":false,"text":"裏表のない性格で、突拍子もない事をしでかすが、彼女の言動には、全く悪意がない。"},{"spoiler":false,"text":"ゲームには大して熱心でなく、キャラもあまり育てずに、響の真面目なプレイスタイルを茶化している方が、好きな様子。"},{"spoiler":false,"text":"“ケン”探索の際には、よき相談相手として色々と協力してくれる。"}],"source":"egs","sourceCharacterId":"26446","sourceWorkId":"6077","spoiler":false},{"segments":[{"spoiler":false,"text":"美貌のネットアイドルにしてコスプレイヤーの趣味を持つ女性。"},{"spoiler":false,"text":"ゲームには大して熱心ではないらしくキャラは強くないし、"},{"spoiler":false,"text":"響のまじめなプレイスタイルをからかってばかりいる。"},{"spoiler":false,"text":"裏表のない性格で、ぶっちゃけバカとしか思えない。"},{"spoiler":false,"text":"が、実際の彼女の言動には悪意が全くない。"},{"spoiler":false,"text":"響のよき相談相手となっていき、いろいろな面で力を貸してくれる。"}],"source":"bangumi","sourceCharacterId":"140356"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55e3ebc9134a76da44a9f3deb5fcecc2baccb4d4dfdb8b3b2f59a05dd6d5365b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed0305c668ab67e22cf100b493d7daad62e9df08e4ed803a40cb188e10e6ba15.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田佳代","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:153652:140356:6038:1","source":"bangumi"}]},{"characterId":"char_c52542","characterName":"樋渡　東子","sourceIds":{"bangumi":[{"characterId":"140352","match":"exact-normalized-name-in-linked-work","subjectId":"153652"}],"egsCharacterIds":["26447"],"vndbCharacterId":"c52542"},"originalCharacterName":"樋渡　東子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ゲーム情報誌のライター兼編集者をしている女性ゲーマー。"},{"spoiler":false,"text":"古今東西、あらゆるジャンルのゲームに精通しており、家