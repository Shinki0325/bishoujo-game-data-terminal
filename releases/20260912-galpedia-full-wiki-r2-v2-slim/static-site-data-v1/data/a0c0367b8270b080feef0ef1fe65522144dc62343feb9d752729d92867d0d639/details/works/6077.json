iler":false,"text":"姉とは対照的に明るく朗らかで、機械にも強く、"},{"spoiler":false,"text":"周囲からの人気も高いネットアイドル。"},{"spoiler":false,"text":"最近はＭＭＯＲＰＧに目覚めたらしく、"},{"spoiler":false,"text":"自身のブログに感想やプレイ日記を載せている。"},{"spoiler":false,"text":"ふとした事で、ヒビキの「ケン」探しを耳して、"},{"spoiler":false,"text":"それをネット上で実況しちゃうなど、お茶目な面を持っている。"}],"source":"bangumi","sourceCharacterId":"140358"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3f0ad345c302977ba484601dddb05312768b9c91fdf4264d6fc9501da99d35f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/328caebf1e659492944717013eb627cf8584b344729f0f6c95a86cea111c25a5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:153652:140358:6106:1","source":"bangumi"}]},{"characterId":"char_vndb_c52545","characterName":"門田　一","sourceIds":{"vndbCharacterId":"c52545"},"originalCharacterName":"門田　一","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa1370d0c4f657a16011fe40d368b4ff4de56234e149372aeacb01a6e292cca7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/5274f431ad36d7da7ba820305fde6ff09a8d013b45df165752488c96eca1653f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一条 和矢","creatorId":"vndb:s256","sourcePersonId":"vndb:s256","canonicalEntityId":"vndb:s256","name":"一条 和矢","roleCode":"voice-actor","roleLabel":"声优","ident