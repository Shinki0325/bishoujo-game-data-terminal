ndbCharacterId":"c65378"},"originalCharacterName":"御木元 元","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4ea802ffed9a2d38c6b252589f93f98aeb3123a125b884e87489b4c11bd01170.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa9340ce758c9c5f95bfec31b8192f2b8d88015aa085273a7e87e23f1f4248e8.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c65379","characterName":"初瀬 しのぶ","sourceIds":{"vndbCharacterId":"c65379"},"originalCharacterName":"初瀬 しのぶ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A widow living in the neighborhood housing complex. A chaste woman with a touch of airheadedness. Her husband passed away about 15 years ago, but she never remarried, raising her daughter single-handedly."},{"spoiler":false,"text":"However, as her daughter grew to the point of leaving home, she realized her own body had fully matured as a woman..."},{"spoiler":false,"text":"To shake off temptations of infidelity through sports, she joins a volleyball team... but perhaps due to her innate clumsiness, she's treated as “useless” within the team."},{"spoiler":false,"text":"Her encounter with a young, attractive coach (the protagonist) will cause her ‘womanhood’ to blossom... or will it?"},{"spoiler":false,"text":"From archived official site"}],"source":"vndb","sourceCharacterId":"c65379"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe2afe28701b95be24ebbd137b256bd48ae01f1d7cf32dac742fab744f14b582.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f829b0a33d527520670bb6b8648c2bef23ce54ca003a973981d2acd40ef7f91.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白井 綾乃","creatorId":"vndb:s665","sourcePersonId":"vndb:s665","canonicalEntityId":"vndb:s665","name":"あらい しずか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:34558","source":"vndb"}]},{"characterId":"char_vndb_c65380","characterName":"初瀬 ちはる","sourceIds":{"vndbCharacterId":"c65380"},"originalCharacterName":"初瀬 ちはる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A junior two years below the protagonist at the academy he attended. A lively, inventive girl with bouncy, shoulder-length hair."},{"spoiler":false,"text":"Watching her parents passionately play volleyball when she was young, she aspired to follow the same path and resolved to enter an academy known for its strong volleyball program."},{"spoiler":false,"text":"At the academy, she admired the protagonist, who led her club as captain despite the boys' and girls' teams being separate, and developed feelings for him."},{"spoiler":false,"text":"She has since retired as a third-year student but occasionally drops by the club activities. She has secured a recommendation for admission to a junior college."},{"spoiler":false,"text":"As a student, she's not officially part of the moms' volleyball team. However, when they were short on players for a match, she was urgently drafted as a temporary helper."},{"spoiler":false,"text":"Perhaps due to losing her father at a young age, she has a slight father complex. She seems to see something of her father in the protagonist, who plays (or played) for a work team just like her father did."},{"spoiler":false,"text":"From archived official site"}],"source":"vndb","sourceCharacterId":"c65380"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c0681066eecfd558aefc65618321609ab7fbdd047529b27753f8ab41cbca9b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d6002ff99093d404cd6c8fc77520a1ca02f4cd8621124bd85f1d4131c889db1.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桃華ちゃん","creatorId":"vndb:s25","sourcePersonId":"vndb:s25","canonicalEntityId":"vndb:s25","name":"安田 未央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:34552","source":"vndb"}]},{"characterId":"char_vndb_c65381","characterName":"江戸川 じゅん","sourceIds":{"vndbCharacterId":"c65381"},"originalCharacterName":"江戸川 じゅん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ubuse Shinobu's younger sister. That is, Chiharu's aunt. A cool-type beauty with wavy long hair. She works as an insurance sales representative."},{"spoiler":false,"text":"Her husband has been out on a tuna fishing boat for offshore fishing for about half a year now, trying to repay a large, risky debt."},{"spoiler":false,"text":"She's bursting with pent-up sexual energy from her ripe body, but she vents her daily desires by speeding around in her husband's car, an RX-8. She has a bit of a speed freak streak."},{"spoiler":false,"text":"She belonged to the track team in her student days, so unlike her sister, she's athletically gifted. She also has a six-month-old infant."},{"spoiler":false,"text":"From archived official site"}],"s