{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"8548","model":{"presentationWorkId":"vndb:v5239","staff":{"artwork":[{"creditedName":"羽津樹","creatorId":"vndb:s1007","sourcePersonId":"egs:creator:2526","canonicalEntityId":"vndb:s1007","name":"羽津樹","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:21750","source":"egs"}],"scenario":[{"creditedName":"リープ","creatorId":"vndb:s5238","sourcePersonId":"egs:creator:3969","canonicalEntityId":"vndb:s5238","name":"リープ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:21751","source":"egs"},{"creditedName":"企画屋","creatorId":"vndb:s1025","sourcePersonId":"egs:creator:188","canonicalEntityId":"vndb:s1025","name":"企画屋","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:21752","source":"egs"}],"music":[{"creditedName":"WanCo","creatorId":"vndb:s2783","sourcePersonId":"egs:creator:3907","canonicalEntityId":"vndb:s2783","name":"WanCo","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:22001","source":"egs"}],"other":[{"creditedName":"羽津樹","creatorId":"vndb:s1007","sourcePersonId":"vndb:s1007","canonicalEntityId":"vndb:s1007","name":"羽津樹","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:56001","source":"vndb"}]},"cast":[{"characterId":"char_c129907","characterName":"火凪久","sourceIds":{"bangumi":[{"characterId":"212757","match":"exact-normalized-name-in-linked-work","subjectId":"656366"}],"egsCharacterIds":["24390"],"vndbCharacterId":"c129907"},"originalCharacterName":"火凪久","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の勝気な元教え子。"},{"spoiler":false,"text":"主人公にほのかな恋心を抱いていたが、主人公があるトラブルから城を抜けたことで、彼女は「抜け忍の弟子」のレッテルを貼られたことで、恨みの対象となっている。"},{"spoiler":false,"text":"さらに、任務が上手くいかないのは主人公が修行途中で中途半端に終わらせたためだと思い込んでいるようだ。"},{"spoiler":false,"text":"血系忍法「淫毛死花」によって、陰毛が毒針になっていることから、彼女とまぐわおうとするとその毒で男は死に絶える。故に処女。"}],"source":"egs","sourceCharacterId":"24390","sourceWorkId":"8548","spoiler":false},{"segments":[{"spoiler":false,"text":"涼香と共に山風郎のもとで修行していた忍。"},{"spoiler":false,"text":"山風郎にほのかな憧れを持っていたが、山風郎が阿加松の里を抜け出してからは抜け忍を師匠にもったことで周りから冷たく扱われ、山風郎に恨みを持つようになる。"},{"spoiler":false,"text":"また、涼香は共に修行してきたので姉同然に思っている。"},{"spoiler":false,"text":"体質として血系忍法・淫毛死花（いんもうしか）により、陰毛が即効性の毒針となっており、彼女を襲うものは皆挿入前に死んでいる。ゆえに処女。"}],"source":"bangumi","sourceCharacterId":"212757"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c095206b5a2ebc6546c96390acc1fc26e04fbd721e636b12dd5b535960690fb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4c4fc4e823a63ae9d7ba11c7c1f235d26480dd1624b5b3d9e8de1a35208d935.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"町田 あみ","creatorId":"vndb:s117","sourcePersonId":"vndb:s117","canonicalEntityId":"vndb:s117","name":"真宮鈴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31075","source":"vndb"}]},{"characterId":"char_c129908","characterName":"涼香","sourceIds":{"bangumi":[{"characterId":"212756","match":"exact-normalized-name-in-linked-work","subjectId":"656366"}],"egsCharacterIds":["24389"],"vndbCharacterId":"c129908"},"originalCharacterName":"涼香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の元教え子。"},{"spoiler":false,"text":"物静かでのんびりした性格。"},{"spoiler":false,"text":"素直で笑顔を絶やさない彼女だが、自分の体質である血系忍法によって嫉妬と猜疑心に溢れている。"},{"spoiler":false,"text":"以前は、主人公と恋人関係にあったようだが、現在は主人公の前主君・阿加松義英の妾。"},{"spoiler":false,"text":"火凪久を本当の妹のように可愛がっている。"}],"source":"egs","sourceCharacterId":"24389","sourceWorkId":"8548","spoiler":false},{"segments":[{"spoiler":false,"text":"山風郎の元教え子の一人で火凪久と共に修行をしていた。"},{"spoiler":false,"text":"性格は表面上、大人しくてのんびり。素直で優等生タイプ。周りを和ませ、普段は笑顔を絶やさない人。しかし、自分の体質である血系忍法のせいで心の奥底では嫉妬と猜疑心に溢れている。"},{"spoiler":false,"text":"現在は阿加松義英の妾でもあるので、忍者としての厳しい任務には付かなかったが、今回男の巻を奪還するという任務を自らかってでた。"},{"spoiler":false,"text":"以前、山風郎とは房術の修行を進めるごとに恋愛関係に発展していった仲である。しかし、阿加松義英の妾となるにつれて山風郎との仲が悪くなり、彼が国を抜けることで二人の関係は終わってしまう。"}],"source":"bangumi","sourceCharacterId":"212756"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/5036b393993eeff77df96d31ab7f826d4f30fad7088ae633a50828c8effbf23c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cce4435d502dc81cc585877c65575d0763dd3408367bc0add8bb3e4d7ff27782.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"如月 葵","creatorId":"vndb:s757","sourcePersonId":"vndb:s757","canonicalEntityId":"vndb:s757","name":"如月葵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31073","source":"vndb"}]},{"characterId":"char_c129909","characterName":"暮乃","sourceIds":{"bangumi":[{"characterId":"212758","match":"exact-normalized-name-in-linked-work","subjectId":"656366"}],"egsCharacterIds":["24391"],"vndbCharacterId":"c129909"},"originalCharacterName":"暮乃","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同じく地方小大名・浮田直秀に仕えるくノ一。"},{"spoiler":false,"text":"捨て子が拾われ、忍者として育てられたため、遺伝的な忍術を持ち合わせていないが、薬の調合にかけてはかなりの腕前を持つ。"},{"spoiler":false,"text":"自分を拾ってくれた直秀に盲目的なまでに従順で、直秀に命じられれば死すらも厭わない。"}],"source":"egs","sourceCharacterId":"24391","sourceWorkId":"8548","spoiler":false},{"segments":[{"spoiler":false,"text":"直秀に仕える忍者。捨て子だった自分を助けてくれた恩を感じ、直秀のためなら死をも恐れない。彼と共に尋問の一部始終を見守る。幼い頃、捨て子だった暮乃を直秀が助けたのが出会い。そのまままだ幼かった直秀の遊び相手を務めることになった。遊び相手を勤める傍ら、直秀を守るために自ら忍者の修行を行なう。しかし、自己流なので自信がない。そのために○の勉○を始め自らの技をあみ出した。"}],"source":"bangumi","sourceCharacterId":"212758"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92526e3293ab64f34f8269729ea1dc0a52796c6d1cf05b5a206c23c0185a3917.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d5e335287502e7fb0e630ab387754ae92b5d8b00976ed33710d58f3549dcfd9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松田 理沙","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31072","source":"vndb"}]},{"characterId":"char_vndb_c129910","characterName":"浮田 直秀","sourceIds":{"vndbCharacterId":"c129910"},"originalCharacterName":"浮田 直秀","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8a7da2d7eb464eb138aad63217f5846b42d75b18ce4e2931e693a5a4a7f5c4e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5071fd73b44e65c7888fdaf5b7710722391130f2fd39c3511cfb7b0e7906f33.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"城崎 彦太","creatorId":"vndb:s865","sourcePersonId":"vndb:s865","canonicalEntityId":"vn