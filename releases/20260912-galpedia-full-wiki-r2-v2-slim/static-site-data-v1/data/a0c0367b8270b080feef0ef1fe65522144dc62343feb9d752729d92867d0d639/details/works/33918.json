y-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公、綾世理玖の幼馴染。"},{"spoiler":false,"text":"七々緒姉妹の「妹」"},{"spoiler":false,"text":"ダウナーかつ内向的な性格。"},{"spoiler":false,"text":"身内とそれ以外の線引きが激しく、"},{"spoiler":false,"text":"ゆえに身内に依存しがち。"},{"spoiler":false,"text":"碧海のように自ら進んで歩くのではなく、"},{"spoiler":false,"text":"その後ろをついていくタイプ。"},{"spoiler":false,"text":"勉強と運動は得意ではないが、"},{"spoiler":false,"text":"唯一、『絵を描くこと』に関しては、"},{"spoiler":false,"text":"誰よりも抜きん出た才能を持つ。"},{"spoiler":false,"text":"姉の碧海のことが大好きで、"},{"spoiler":false,"text":"幼馴染である理玖のことも大切に想っている。"},{"spoiler":false,"text":"しかし蒼空には、将来に関して"},{"spoiler":false,"text":"誰にも言えない悩みがあって……"}],"source":"bangumi","sourceCharacterId":"136984"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/063b2a6d4fb18458349b5029071cdaa2e21a111764811d934c4a33b83a500c68.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5af3b6b61c58d92a3cdb89daafba17c60befdaab97e8809cfd12a6256a8c23c.webp","width":141,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p16865","sourceCompanyId":"egs:brand:6803","canonicalEntityId":"vndb:p16865","name":"OverFlowers","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:33918:6803","source":"egs"},{"companyId":"vndb:p16865","sourceCompanyId":"vndb:p16865","canonicalEntityId":"vndb:p16865","name":"オーバーフロウ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:123111:v46944","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing"],"source":"terminal-wiki-full-runtime-v7"}}
