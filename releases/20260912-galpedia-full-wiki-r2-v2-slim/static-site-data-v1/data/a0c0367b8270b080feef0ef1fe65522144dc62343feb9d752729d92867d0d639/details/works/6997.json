b:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:136770:69707:4918:1","source":"bangumi"}]},{"characterId":"char_bangumi_69857","characterName":"Irina Marcillen","sourceIds":{"bangumi":[{"characterId":"69857","match":"source-roster","subjectId":"119075"},{"characterId":"69857","match":"source-roster","subjectId":"12119"},{"characterId":"69857","match":"source-roster","subjectId":"136770"},{"characterId":"69857","match":"source-roster","subjectId":"28426"},{"characterId":"69857","match":"source-roster","subjectId":"39384"},{"characterId":"69857","match":"source-roster","subjectId":"86757"}]},"originalCharacterName":"Irina Marcillen","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"旧名イリーナ・テシュオス。カルッシャの第三王女で、エクリア の妹。リウイの最愛の妻として彼を支えながら共に戦っていたが､幻燐戦争の終盤､呪いの影響下にあった姉ｴｸﾘｱがﾌｪﾐﾘﾝｽの力を解放するための鍵として同族の血を欲し､また姉妹で唯一幸せを得たことを妬まれたことにより､ﾘｳｲの目の前で姉自身の手により斬殺された｡その亡骸はﾒﾝﾌｨﾙ王国の王都ﾐﾙｽの墓地に葬られたが､その魂は戦争による多くの死者や深凌の契魔復活による歪みで､｢冥き途｣に還えることなくこの世に留まっていた｡しかし､不運にもﾌﾞﾚｱｰﾄﾞがﾘｳｲに傷つけられた身体を修復するための秘術に巻き込まれて彼の神核に捕らえられてしまう｡"}],"source":"bangumi","sourceCharacterId":"69857"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06109decc06739f2abbdc35b3558d113b37ee8331447eda85fc5cd66c10e589e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f65b234625ddfee50be7bead022608dde16f4e8f72c15ac58aaf0175d861a0ed.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幡宮かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:136770:69857:5940:1","source":"bangumi"}]},{"characterId":"char_bangumi_69861","characterName":"Tifana Luxembur","sourceIds":{"bangumi":[{"characterId":"69861","match":"source-roster","subjectId":"119075"},{"characterId":"69861","match":"source-roster","subjectId":"12119"},{"characterId":"69861","match":"source-roster","subjectId":"136770"},{"characterId":"69861","match":"source-roster","subjectId":"39384"},{"characterId":"69861","match":"source-roster","subjectId":"86757"}]},"originalCharacterName":"Tifana Luxembur","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"元ミレティア保護領領主｡ 2つの大鎌を背負い、飛竜を駆って戦場を舞う。幻燐戦争後カルッシャ宰相サイモフ共に巡礼の旅をしていた｡"}],"source":"bangumi","sourceCharacterId":"69861"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df28879439bc82e4b16d4d27d7c4f3f6c8b8b4972ff7f785b213d064cf6dfa51.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6e181cba78682aa2089e7f3f2bbb84d2324bfcdb4b772c5c4a1898dea0f34b6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大野まりな","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:136770:69861:4434:1","source":"bangumi"}]},{"characterId":"char_bangumi_69892","characterName":"Chiki Indis","sourceIds":{"bangumi":[{"characterId":"69892","match":"source-roster","subjectId":"12119"},{"characterId":"69892","match":"source-roster","subjectId":"136770"},{"characterId":"69892","match":"source-roster","subjectId":"249705"},{"characterId":"69892","match":"source-roster","subjectId":"28426"},{"characterId":"69892","match":"source-roster","subjectId":"39384"}]},"originalCharacterName":"Chiki Indis","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ラギールの店で働く奴隷の少女。"},{"spoiler":false,"text":"奴隷だが店を任されているだけはあり、目利きや商売の才能は確かなもの。"},{"spoiler":false,"text":"いつもおどおどしているが、品揃えや仕事振りを誉められると喜ぶ。"},{"spoiler":false,"text":"奴隷である自分にも優しいリウイに好意を持っている。"},{"spoiler":false,"text":"後にリウイに身請けされた事で奴隷の身分から解放されたが、その後も彼の助けとなる為にラギールの店の店員を続けている。"}],"source":"bangumi","sourceCharacterId":"69892"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/119675ec4be32be382c6ddb77a70ad84d31198623e5ebc35f292eba4a9963397.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a58b73509026157e888c5b9a0080df1c179ccb587e37117213213cf60b5b6ce2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上みゆ","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:136770:69892:6558:1","source":"bangumi"}]},{"characterId":"char_c30523","characterName":"ラピス・サウリン","sourceIds":{"bangumi":[{"characterId":"69860","match":"source-roster","subjectId":"119075"},{"characterId":"69860","match":"exact-normalized-name-in-linked-work","subjectId":"12119"},{"characterId":"69860","match":"source-roster","subjectId":"12119"},{"characterId":"69860","match":"source-roster","subjectId":"136770"},{"characterId":"69860","match":"source-roster","subjectId":"39384"}],"egsCharacterIds":["14062"],"vndbCharacterId":"c30523"},"originalCharacterName":"ラピス・サウリン","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"リウイと共に幻燐戦争を戦った、セルノ王国の王女。"},{"spoiler":false,"text":"国元ではセルノ王である兄を支える良き妹でありながら、"},{"spoiler":false,"text":"遠征時は前しか見えないリンをフォローする良き姉でもある。"}],"source":"egs","sourceCharacterId":"14062","sourceWorkId":"11748","spoiler":false},{"segments":[{"spoiler":false,"text":"セルノ王国の王女で、現国王イオーノの妹。"},{"spoiler":false,"text":"自立した考えを持つ、落ち着きのある女性。"},{"spoiler":false,"text":"国の軍事を担っており、警備隊全軍を指揮する権限を持っているが、兄と同様に基本的には争いを好まず、和平をもって周辺国との同盟を進めたいと考えている。"},{"spoiler":false,"text":"長く戦いの続く隣国のバルジア王国とも個人的には和平を結ぶ事を望んでいるが、大臣達の気持ちを変える事は出来ずにいた。"},{"spoiler":false,"text":"リウイの父である魔神グラザとも交流があった事を誇りにしており、またグラザの性格を知るが故に魔神が必ずしも敵対的な存在では考えており、"},{"spoiler":false,"text":"リウイとは面識が無かったものの、テネイラ事件に対するカルッシャ王国の言い分を頭から信じはしなかった。"},{"spoiler":false,"text":"バルジアのセルノ再侵攻時には自国の民を救う為に自らリウイに救援を要請し、これを受け入れられた。"},{"spoiler":false,"text":"メンフィル軍の救援を受けて王都レティカを防衛した後はセルノとメンフィル間で同盟が結ばれ、以降はリウイに協力して彼等と共に戦った。"},{"spoiler":false,"text":"その後のバルジア侵攻時では、リウイに対してバルジア王女リンの助命を再三に渡って願い、本来は敵であるはずの彼女の命を救った。"},{"spoiler":false,"text":"当初はリンには敵国の王女に情けを掛けられたと反発されていたが、共に行動して交流を深めた事で彼女から実の姉の様に慕われる事となった。"},{"spoiler":false,"text":"幻燐戦争後はこれまで通りにイオーノを支えつつ、リンと協力してセルノとバルジアの融和に尽力しており、また深凌の楔魔との戦いではベルゼビュード宮殿攻略戦にも参戦した。"}],"source":"bangumi","sourceCharacterId":"69860"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f019164b6d682425d4a2fcf939aa84ff78282db0a5f5119838f082f0be37dda.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71d80d2d517959375ee9370f9d1f0f0b761dd77c6523ec9d5ac1dffaa901332e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永井ちひろ","creatorId":"vndb:s530","sourcePersonId":"vndb:s530","canonicalEntityId":"vndb:s530","name":"永井 ちひろ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:136770:69860:18652:1","source":"bangumi"}]},{"characterId":"char_c30524","characterName":"リン・ファラ＝バルジアーナ","sourceIds":{"bangumi":[{"characterId":"69859","match":"source-roster","subjectId":"119075"},{"characterId":"69859","match":"exact-normalized-name-in-linked-work","subjectId":"12119"},{"characterId":"69859","match":"source-roster","subjectId":"12119"},{"characterId":"69859","match":"source-roster","subjectId":"136770"},{"characterId":"69859","match":"source-roster","subjectId":"39384"}],"egsCharacterIds":["14063"],"vndbCharacterId":"c30524"},"originalCharacterName":"リン・ファラ＝バルジアーナ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"リウイと共に幻燐戦争を戦った、バルジア王国の王女。"},{"spoiler":false,"text":"思い立った瞬間に行動するため周りをひやひやさせるのは相変わらずだが、"},{"spoiler":false,"text":"徐々に実力も身についてきたらしい……。"}],"source":"egs","sourceCharacterId":"14063","sourceWorkId":"11748","spoiler":false},{"segments":[{"spoiler":false,"text":"バルジア王国の王女。"},{"spoiler":false,"text":"正当な王家を主張する意味を持つファラの名を持つ。"},{"spoiler":false,"text":"元々は内気な性格だったが、隣国であるセルノ王国のラピス王女と比較され続けた事からライバル意識を持ち、自ら剣を取るようになった。"},{"spoiler":false,"text":"大人の様な態度を取ろうとして王族である事を誇張するような未熟な面や直情的なところはあるが、努力家ではあり戦場では一流の戦士として大きな力を持つ。"},{"spoiler":false,"text":"その直情径行な性格をエクリアやリオーネに利用されてセルノへ侵攻したが、メンフィル王国がセルノに加勢した為に敗北、逆にバルジア本国に攻め入られる窮地を招いてしまった。"},{"spoiler":false,"text":"王城防衛戦では戦場に出たものの敗れて捕虜となったが、敵であるはずのラピスに庇われて命を救われた。"},{"spoiler":false,"text":"その後は自らの目でリウイを見定める為に彼等に協力して共に戦う事となった。"},{"spoiler":false,"text":"当初はリウイやラピスに対して敵意を失っていなかったが、共に行動して交流を深めていく中で次第に打ち解け、"},{"spoiler":false,"text":"特にラピスを実の姉の様に慕う事となり、また彼女からも妹の様に愛される事となった。"},{"spoiler":false,"text":"幻燐戦争後はラピスと協力してセルノとバルジアの融和に尽力しており、また深凌の楔魔との戦いではベルゼビュード宮殿攻略戦にも参加した。"}],"source":"bangumi","sourceCharacterId":"69859"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/069d6c17f9d6cdcce2d467cf833d62979ca1db3769423a97538e39b529579d1f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1bfbb866d4bc38ecc118e4193e699ffdc0ae0db1daf56015bc540de99c01780d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さくらなつみ","creatorId":"vndb:s666","sourcePersonId":"vndb:s666","canonicalEntityId":"vndb:s666","name":"岩泉まい(樋口まゆら、樋口まゆ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:136770:69859:6279:1","source":"bangumi"}]},{"characterId":"char_c31108","characterName":"ファーミシルス","sourceIds":{"bangumi":[{"characterId":"69862","match":"source-roster","subjectId":"119075"},{"characterId":"69862","match":"exact-normalized-name-in-linked-work","subjectId":"12119"},{"characterId":"69862","match":"source-roster","subjectId":"12119"},{"characterId":"69862","match":"source-roster","subjectId":"136770"},{"characterId":"69862","match":"source-roster","subjectId":"28426"},{"characterId":"69862","match":"source-roster","subjectId":"39384"}],"egsCharacterIds":["14058"],"vndbCharacterId":"c31108"},"originalCharacterName":"ファーミシルス","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"より強い者に従うことを誉れとする誇り高き飛天魔族の戦士。"},{"spoiler":false,"text":"リウイと戦い敗れるまでは、多くの主人のもとを転々としていた。"},{"spoiler":false,"text":"現在はメンフィル王国の大将軍として、"},{"spoiler":false,"text":"王としての責務に追われるリウイに代わり前線で指揮を執る。"}],"source":"egs","sourceCharacterId":"14058","sourceWorkId":"11748","spoiler":false},{"segments":[{"spoiler":false,"text":"飛天魔族として誇り高い彼女は、よほどのことが無い限りリウイ以外の命令を聞くことは無い。"}],"source":"bangumi","sourceCharacterId":"69862"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/im