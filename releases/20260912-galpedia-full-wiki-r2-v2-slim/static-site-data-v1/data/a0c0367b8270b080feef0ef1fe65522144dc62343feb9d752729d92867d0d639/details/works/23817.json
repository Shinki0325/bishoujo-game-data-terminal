{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"23817","model":{"presentationWorkId":"vndb:v19623","staff":{"artwork":[{"creditedName":"りゅうき夕海","creatorId":"vndb:s2962","sourcePersonId":"egs:creator:1186","canonicalEntityId":"vndb:s2962","name":"りゅうき夕海","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:167012","source":"egs"}],"scenario":[{"creditedName":"須々木鮎尾","creatorId":"vndb:s2319","sourcePersonId":"egs:creator:13991","canonicalEntityId":"vndb:s2319","name":"須々木鮎尾","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:167013","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c49794","characterName":"犬養 知実","sourceIds":{"bangumi":[{"characterId":"45237","match":"exact-normalized-name-in-linked-work","subjectId":"191410"}],"egsCharacterIds":["10063"],"vndbCharacterId":"c49794"},"originalCharacterName":"犬養 知実","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Protagonist's cousin who works as a researcher. She visited the village with the protagonist in order to analyze the village's spring water and it's effect to the villager's infertility problem."},{"spoiler":true,"text":"She is actually the protagonist's sister, their mother acted as a surrogate for her older sister who is infertile and thus Tomomi was raised by their aunt as her own child."},{"spoiler":true,"text":"The cause of the spring water's pollution was due to a blockage caused by natural disaster, after the problem was solved with protagonist's help, she decided to conduct an experiment of spring's water with fertility by purposely make some of the young female resident of the village pregnant. The test subject was three maidens from the village and herself."}],"source":"vndb","sourceCharacterId":"c49794"},{"segments":[{"spoiler":false,"text":"主人公の従姉で大学院生、大学院の研究室で不妊による少子化についての研究を行っている研究員。"},{"spoiler":false,"text":"国の子化対策事業から研究資金を得ているのですが、成果を出す必要に迫られた為、かつて村にある温泉が「子宝の湯」としてもてはやされていたけれど、その効能が失われてしまった事で寂れてしまった舞台となる村、『地足村（ちだるむら）』に、研究の糸口になる何かがあればとやって来ます。"}],"source":"egs","sourceCharacterId":"10063"},{"segments":[{"spoiler":false,"text":"主人公の従姉で大学院生、大学院の研究室で不妊による少子化についての研究を行っている研究員。"},{"spoiler":false,"text":"この研究室は、小子化対策事業から研究資金を得ているのですが、成果を出す必要に迫られた為、かつて村にある温泉が「子宝の湯」としてもてはやされていたが、その効能が失われてしまった事で寂れてしまった村、『地足村（ちだるむら）』に、研究の糸口になる何かがあればと考え、調査の為にやって来ます。"}],"source":"egs","sourceCharacterId":"10063","sourceWorkId":"23817","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の従姉で大学院生。 研究室で不妊による少子化について研究を行っている。"},{"spoiler":false,"text":"国の小子化対策事業として研究資金を得ているが、成果を求められてしまい、"},{"spoiler":false,"text":"かつて子宝の湯で有名になった地足村（ちだるむら）へと調査に向かう。"}],"source":"bangumi","sourceCharacterId":"45237"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f14d0d174bd0cc54a8cb65dbb6b8ef6dc28181a4d82d6ab81342b9711228a3e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b4951b62e2aefb75e2c3cca0f1f4ada8fa7bfeaafb87daa9db450784b78c06e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:191410:45237:6351:1","source":"bangumi"}]},{"characterId":"char_c49795","characterName":"鹿島 志津","sourceIds":{"bangumi":[{"characterId":"45238","match":"exact-normalized-name-in-linked-work","subjectId":"191410"}],"egsCharacterIds":["10062"],"vndbCharacterId":"c49795"},"originalCharacterName":"鹿島 志津","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Proprietress of the traditional inn where the protagonist along with his sister is staying during their research in the village."}],"source":"vndb","sourceCharacterId":"c49795"},{"segments":[{"spoiler":false,"text":"舞台となる村、『地足村（ちだるむら）』で、両親が営む温泉宿で若女将をしている女性。"},{"spoiler":false,"text":"この宿の温泉は、かつて「子宝の湯」として盛況でしたが、その効能が失われたという評判が立ち、現在では来客が激減してしまっています。"},{"spoiler":false,"text":"女将としての仕事はそつなくこなしていますが、厨房などは両親任せの所があるので、料理の腕などは普通。"},{"spoiler":false,"text":"面倒見が良く、村の娘達の中ではお姉さん的な立場になる事が多いです。"},{"spoiler":false,"text":"旅館は好きで手伝っていて、それを継ぐ事については不満を持ったり、都会に出たいという願望を持ったりはしていません。"},{"spoiler":false,"text":"ただ、村の先行き、旅館の先行きについて、不安を感じてはいます。"}],"source":"egs","sourceCharacterId":"10062"},{"segments":[{"spoiler":false,"text":"舞台となる村、『地足村（ちだるむら）』で、両親が営む温泉宿『鹿島庵（かしまあん）』の若女将をしている女性。"},{"spoiler":false,"text":"地足村の温泉は、かつて「子宝の湯」として盛況であったが、その効能が失われたという評判が立ち、現在では鹿島庵も来客が激減してしまっています。"},{"spoiler":false,"text":"女将としての仕事をそつなくこなし、面倒見が良い為に、村に残った若いの娘達の中ではお姉さん的な立場になる事が多いです。"},{"spoiler":false,"text":"村の先行き、鹿島庵の先行きについて、しばしば不安を感じています。"}],"source":"egs","sourceCharacterId":"10062","sourceWorkId":"23817","spoiler":false},{"segments":[{"spoiler":false,"text":"地足村で両親が営む温泉宿『鹿島庵』の若女将をしている女性。"},{"spoiler":false,"text":"面倒見が良く、村に残った若い娘たちのお姉さん的な存在。"},{"spoiler":false,"text":"村の、鹿島庵の将来について不安を感じている。"}],"source":"bangumi","sourceCharacterId":"45238"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6630b3fc2eb170ff6b161229e4750e1b7e16790469b4b874d1d45757cfc1aa6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/666ed565c273931bf096156fac5f992085eb1ad644fdda86ff8b21236fd58287.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:191410:45238:10027:1","source":"bangumi"}]},{"characterId":"char_c49796","characterName":"志鷹 羽月","sourceIds":{"bangumi":[{"characterId":"45239","match":"exact-normalized-name-in-linked-work","subjectId":"191410"}],"egsCharacterIds":["10060"],"vndbCharacterId":"c49796"},"originalCharacterName":"志鷹 羽月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Granddaughter of the village's elder. Also working as a miko who guard the source of spring water."}],"source":"vndb","sourceCharacterId":"c49796"},{"segments":[{"spoiler":false,"text":"舞台となる村、『地足村（ちだるむら）』で、子宝に恵まれず滅びかけていた村を救ってくれた女神を祭る神社、『地足神社（ちだるじんじゃ）』の巫女をしている女性。"},{"spoiler":false,"text":"神社の神主は祖母、『志鷹　キヌエ』で、村の村長は代々神社の神主が兼ねています。"},{"spoiler":false,"text":"古来より「子宝の泉」を守護してきた実戦的な神社で、幼い頃から修行を積んできているので、剣道、武道の有段者です。"}],"source":"egs","sourceCharacterId":"10060"},{"segments":[{"spoiler":false,"text":"舞台となる村、『地足村（ちだるむら）』で、子宝に恵まれず滅びかけていた村を救ってくれた女神を祭る神社、『地足神社（ちだるじんじゃ）』の巫女をしている女性。"},{"spoiler":false,"text":"神社の神主である祖母、『志鷹　キヌエ』は村の村長を兼ねています。"},{"spoiler":false,"text":"村に残った若いの娘達の中では最年少ですが、古来より「子宝の泉」を守護してきた神社で、幼い頃から実戦的な修行を積んできているので、剣術、武道の有段者です。"}],"source":"egs","sourceCharacterId":"10060","sourceWorkId":"23817","spoiler":false},{"segments":[{"spoiler":false,"text":"地足村を救ってくれた女神を祭る、地足神社の巫女。"},{"spoiler":false,"text":"神主である祖母・キヌエが村長を兼ねている。"},{"spoiler":false,"text":"幼い頃から実戦的な修行を積んでおり、剣道・武道の有段者。"}],"source":"bangumi","sourceCharacterId":"45239"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/4948e02c5db8b9c43bb01f400aaacf8b5d3be11e534b2e1801a584c0a3805926.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82d42507798b897f8acb234b17939f1a5a4a77e7975527d91c5986e2834ee89f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:191410:45239:15637:1","source":"bangumi"}]},{"characterId":"char_c49797","characterName":"牛木 優菜","sourceIds":{"bangumi":[{"characterId":"45240","match":"exact-normalized-name-in-linked-work","subjectId":"191410"}],"egsCharacterIds":["10059"],"vndbCharacterId":"c49797"},"originalCharacterName":"牛木 優菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the local residents of the village. She is working a a farmer while also manage a local grocery store."}],"source":"vndb","sourceCharacterId":"c49797"},{"segments":[{"spoiler":false,"text":"舞台となる村で、親から継いだ農家と雑貨屋を営んでいるの女性。"},{"spoiler":false,"text":"農業が好きで、生計を立てるには厳しい野菜作り（村の人に売ったりあげたり自分で食べる程度の量）を、雑貨屋を経営するかたわら行っています。"},{"spoiler":false,"text":"手入れを怠らず、丹精込めて育てている野菜は周囲から好評なのですが、都会に出荷できるぐらいの規模に手を広げる事は考えていません。（今のやり方で、一人で作れるのは現状が精一杯なので）"},{"spoiler":false,"text":"おっとり、のんびりとした性格ですが、しっかり者で几帳面でもあり、それは野菜作りの結果に結びついています。"}],"source":"egs","sourceCharacterId":"10059"},{"segments":[{"spoiler":false,"text":"舞台となる村、『地足村（ちだるむら）』で、親から継いだ農家と雑貨屋を営んでいるの女性。"},{"spoiler":false,"text":"農業が好きで、生計を立てるには厳しい野菜作り（村内に卸したり、自分で食べる程度の量）を、雑貨屋を経営するかたわら行っています。"},{"spoiler":false,"text":"手入れを怠らず、丹精込めて育てている野菜は周囲から好評なのですが、都会に出荷できるぐらいの規模に手を広げる事は考えていません。"},{"spoiler":false,"text":"（今のやり方では、現状が精一杯なので）"},{"spoiler":false,"text":"おっとり、のんびりとした性格ですが、しっかり者で几帳面でもあり、それは野菜作りの結果に結びついています。"}],"source":"egs","sourceCharacterId":"10059","sourceWorkId":"23817","spoiler":false},{"segments":[{"spoiler":false,"text":"親から継いだ農業と雑貨屋を営んでいる女性。"},{"spoiler":false,"text":"農業が好きで、丹精込めて育てている野菜は村でも好評。"},{"spoiler":false,"text":"おっとりのんびりとした性格だけど、しっかり者で几帳面。"}],"source":"bangumi","sourceCharacterId":"45240"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64ff420422bf68145fcc001a080b1fa13f81cb1e822f8c36819f28acf6a09f24.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b40f9c399ea0cc84deaeb6baf10aaa4c658d65ed8f9c2d3f69a9ff3568bd45d0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:191410:45240:10026:1","source":"bangumi"}]},{"characterId":"char_vndb_c49798","characterName":"犬養 雅彦","sourceIds":{"vndbCharacterId":"c49798"},"originalCharacterName":"犬養 雅彦","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1079","sourceCompanyId":"egs:brand:2272","canonicalEntityId":"vndb:p1079","name":"オーバードーズ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:23817:2272","source":"egs"},{"companyId":"vndb:p15756","sourceCompanyId":"vndb:p15756","canonicalEntityId":"vndb:p15756","name":"SVN","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:126736:v19623","source":"vndb"},{"companyId":"vndb:p176","sourceCompanyId":"vndb:p176","canonicalEntityId":"vndb:p176","name":"N43 Project","role