5"},"originalCharacterName":"神崎 紗耶香","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本編主人公。"},{"spoiler":false,"text":"小さいながらも会社を経営する両親を持つ、それなりに裕福な家庭に育ったお嬢様。"},{"spoiler":false,"text":"品行方正で、成績優秀な優等生で、通っていた学園でも男子学生らに人気だった。"},{"spoiler":false,"text":"ただし、世間知らずで騙されやすい、危うさを持つ。"}],"source":"egs","sourceCharacterId":"13772","sourceWorkId":"3453","spoiler":false},{"segments":[{"spoiler":false,"text":"ヒロイン。"},{"spoiler":false,"text":"両親の借金を返すために、学校を辞めて黒木のファミレスで働いている。"},{"spoiler":false,"text":"家族思いの真面目な性格で、学園に通っていたころは優等生だった。"},{"spoiler":false,"text":"世間知らずで、騙されやすいところがある。"},{"spoiler":false,"text":"裕福な家庭のお嬢様として、満ち足りた暮らしを送っていたが、"},{"spoiler":false,"text":"両親の失踪により、一転して悲惨な境遇に突き落とされてしまう。"},{"spoiler":false,"text":"どんな過酷な状況にあっても健気にがんばろうとするが、"},{"spoiler":false,"text":"深夜のファミレスで繰り返される凌辱によって、"},{"spoiler":false,"text":"次第に心身ともに変化していく。"}],"source":"bangumi","sourceCharacterId":"37377"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d620ca74d977296795d364b2f2c0c19224a9f84f3e08d0422183358dbacf0ff9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c71c428ba3e7651470df09372e54ec480105e4ea20da4d9d4a60b4172d310939.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天天","creatorId":"vndb:s2922","sourcePersonId":"vndb:s2922","canonicalEntityId":"vndb:s2922","name":"天天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:160616:37377:18086:1","source":"bangumi"}]},{"characterId":"char_c38756","characterName":"倉崎 柚子","sourceIds":{"bangumi":[{"characterId":"37813","match":"exact-normalized-name-in-linked-work","subjectId":"160616"}],"egsCharacterIds":["13773"],"vndbCharacterId":"c38756"},"originalCharacterName":"倉崎 柚子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"96"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"紗耶香のクラスメイト。"},{"spoiler":false,"text":"表向きは、おっとりとして物静かで人当たりの良い女の子だが、その内面は歪んでおり、優等生だった紗耶香に嫉妬し、ファミレスのバイトに引き込んだ。"},{"spoiler":false,"text":"凌辱される紗耶香を見て、良い気分に浸っていたが……。"}],"source":"egs","sourceCharacterId":"13773","sourceWorkId":"3453","spoiler":false},{"segments":[{"spoiler":false,"text":"紗耶香が学園に通っていたころのクラスメイトで、友人。"},{"spoiler":false,"text":"表向きは控え目で人当たりもいいが、その実、けっこう歪んだ性格をしている。"},{"spoiler":false,"text":"優等生の紗耶香にコンプレックスに近いライバル意識を持っており、"},{"spoiler":false,"text":"彼女を陥れるために、ファミレスのバイトに引き込む。"},{"spoiler":false,"text":"そこで凌辱される紗耶香を見て溜飲を下げるが、"},{"spoiler":false,"text":"黒木の寵愛を受ける彼女を見て、さらに陰湿ないじめを繰り返す。"}],"source":"bangumi","sourceCharacterId":"37813"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a358c227ab21a358c9772fe5a34a2a8c91b3459d59c177fa647ee9450617cc8e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/5082fec8b4d6f8c50add1888aab4e701e66a99ec77c1a7767e49dbf155027d09.webp","wid