","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【人との共存を望むヴァンパイア】"},{"spoiler":false,"text":"魔物や同族に追われ、主人公が住む街に再びやってきたヴァンパイア。"},{"spoiler":false,"text":"フランは人間になりたいと願うヴァンパイアで、人間を滅ぼそうとするヴァンパイア、アレクサンドル・ドゥミトレスク（アレク）に脅威と認識され、排除されそうになる。"},{"spoiler":false,"text":"運悪くその場に遭遇してしまった永遠が殺されかけ、助けるために永遠と契約しヴァンパイアにしてしまう。"},{"spoiler":false,"text":"唯一の方法だったとはいえ、永遠をヴァンパイアにしてしまったことに深く傷つくも、永遠の恨みの対象になることを選び、弱みを見せることはない。"},{"spoiler":false,"text":"自分に非がなくても自分に非があるように見せたりする優しさを見せ、人がいるところでは絶対に泣かない。"},{"spoiler":false,"text":"貴族の出身であり、高貴な精神の持ち主である。"}],"source":"egs","sourceCharacterId":"849","sourceWorkId":"18188","spoiler":false},{"segments":[{"spoiler":false,"text":"魔物や同族に終われ、主人公が住む街に再びやってきたヴァンパイア。フランは人間になりたいと願うヴァンパイアで、人間を滅ぼそうとするヴァンパイア、アレクサンドル・ドゥミトレスク（アレク）に脅威と認識され、排除されそうになる。"},{"spoiler":false,"text":"自分に非がなくても自分に非があるように見せたりする優しさを見せ、人がいるところでは絶対に泣かない。貴族の出身であり、高貴な精神の持ち主である。"}],"source":"bangumi","sourceCharacterId":"17640"}],"profileFacts":[],"metadataCandidateConflicts":{"height":[{"comparisonValue":"161","source":"vndb","sourceCharacterId":"c76259","value":"161"},{"comparisonValue":"161","scope":"sourceWork","source":"egs","sourceCharacterId":"849","sourceWorkId":"18188","value":"161"},{"comparisonValue":"160","source":"bangumi","sourceCharacterId":"17640","value":"160cm"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51ca9bf8d961a153027d0a1006a1cd45e143c570489a0c490a3da7e523eeeb37.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76f0c930df1d79dce7138a9f9ceafd5d0c2e791a1754cf0304aa854eb3e0050d.webp","width":189,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本城亜夜","creatorId":"vndb:s2999","sourcePersonId":"vndb:s2999","canonicalEntityId":"vndb:s2999","name":"本城亜夜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:52408:17640:25169:1","source":"bangumi"}]},{"characterId":"char_c76260","characterName":"久永 久遠","sourceIds":{"bangumi":[{"characterId":"17641","match":"exact-normalized-name-in-linked-work","subjectId":"52408"},{"characterId":"17641","match":"exact-normalized-name-in-linked-work","subjectId":"64582"}],"egsCharacterIds":["850"],"vndbCharacterId":"c76260"},"originalCharacterName":"久永 久遠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"603"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"67"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"65"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"47"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"37"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の妹。"},{"spoiler":false,"text":"見た目も心も幼く、生まれながらにして病弱な体質である。"},{"spoiler":false,"text":"そのため、小さいころから病院とは切っても切り離せない生活を強いられている。"},{"spoiler":false,"text":"そして現在は余命が後わずかと宣告されており、久遠自身はその運命を受け入れているため、生や死などに関しては達観した一面があったりもする。"},{"spoiler":false,"text":"けれど基本的には素直で純粋な性格で、ときどき頑固。"},{"spoiler":false,"text":"主人公と血の繋がった、たったひとりの家族であることと、病弱であることから主人公に大切にされてきた。"},{"spoiler":false,"text":"主人公は久遠のためなら何でもするが、久遠はあまり人を頼ることはない。"},{"spoiler":false,"text":"そういう面において、久遠は強い子だと主人公たちから評されている。"}],"source":"egs","sourceCharacterId":"850","sourceWorkId":"18188","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹。"},{"spoiler":false,"text":"見た目も心も幼く、生まれながらにして病弱な体質である。そのため、小さいころから病院とは切っても切り離せない生活を強いられている。現在は余命が後わずかと宣告されており、久遠自身はその運命を受け入れているため、生や死などに関しては達観した一面があったりもする。けれど基本的には素直で純粋な性格で、ときどき頑固。主人公と血の繋がった、たったひとりの家族であることと、病弱であることから主人公に大切にされてきた。"},{"spoiler":false,"text":"主人公は久遠のためなら何でもするが、久遠はあまり人を頼ることはない。そういう面において、久遠は強い子だと主人公たちから評されている。"}],"source":"bangumi","sourceCharacterId":"17641"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a559f93c1cafa852ce2c534ffbcc0511e2a5de102442d3dde34200648dcbd079.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69fbc9fb66caef295543b78d9d0ffa0acdfb1b827f71545902487c08a137889f.webp","width":184,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤乃 理香","creatorId":"vndb:s945","sourcePersonId":"vndb:s945","canonicalEntityId":"vndb:s945","name":"藤乃 理香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47246","source":"vndb"}]},{"characterId":"char_c76261","characterName":"常盤 千香","sourceIds":{"bangumi":[{"characterId":"17642","match":"exact-normalized-name-in-linked-work","subjectId":"52408"},{"characterId":"17642","match":"exact-normalized-name-in-linked-work","subjectId":"64582"}],"egsCharacterIds":["851"],"vndbCharacterId":"c76261"},"originalCharacterName":"常盤 千香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"820"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【天衣無縫の矛盾少女】"},{"spoiler":false,"text":"学園では、授業中、休み時間をふくめて、とにかくよく眠っているクラスメイト。"},{"spoiler":false,"text":"明るく人懐こい性格をしていて、性別を気にせず軽い口調で話す。"},{"spoiler":false,"text":"遅刻も多いが、行事や交友関係には熱心で、クラスでは少々不真面目なムードメーカー程度に思われていた。"},{"spoiler":false,"text":"彼女が常に寝不足なのには理由がある。"},{"spoiler":false,"text":"それは、夜間に魔物から人を守る退魔士として活動しているからであった。"},{"spoiler":false,"text":"しかし、それは自らの持つ特別な能力から選んだ道であって、むしろ、大人しい魔物などは積極的に保護している。"},{"spoiler":false,"text":"主人公とは１年のころからの付き合いであり、教室では軽口を叩きあうような関係。"},{"spoiler":false,"text":"学園では仲は良いものの、それ以上の関係になるつもりはお互いになかったため、主人公に決定的な瞬間を見られるまでは、自分が退魔士として活動していることを明かすつもりもなかった。"}],"source":"egs","sourceCharacterId":"851","sourceWorkId":"18188","spoiler":false},{"segments":[{"spoiler":false,"text":"とにかくよく寝ているクラスメイト。性格は明るく、眠気のないときは天真爛漫を絵に描いたような少女。誰とでも親しくなれるタイプ。授業を寝潰すことが多いので成績は良くないが、頭の回転自体はかなり早い。性別を超えた友達のように接しているために、主人公のことをどう思っているかは不明。"},{"spoiler":false,"text":"学園外での付き合いが主人公とは今のところないため、プライベートは謎に包まれていることも多い。謎は多いが、それを本人に問うと適当に流してしまうので、誰も彼女の本心を知ることは出来ないでいる。"}],"source":"bangumi","sourceCharacterId":"17642"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b8b2b8b3bd6bdfdc551b0501d67d2a58bbfc254e6c4aee3c0652a6df23b1dfe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4ed9fc153240a46c6ba6b8d89e012735312e3f31ccf2e9f97308bec1604401a7.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"種﨑敦美","creatorId":"vndb:s196","sourcePersonId":"vndb:s196","canonicalEntityId":"vndb:s196","name":"種﨑 敦美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:52408:17642:7575:1","source":"bangumi"}]},{"characterId":"char_c76262","characterName":"霧島 沙希","sourceIds":{"bangumi":[{"characterId":"17643","match":"exact-normalized-name-in-linked-work","subjectId":"52408"},{"characterId":"17643","match":"exact-normalized-name-in-linked-work","subjectId":"64582"}],"egsCharacterIds":["852"],"vndbCharacterId":"c76262"},"originalCharacterName":"霧島 沙希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1010"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のひとつ年上で隣の家に住む幼馴染み。"},{"spoiler":false,"text":"面倒見のいい性格で、お姉さん的存在。"},{"spoiler":false,"text":"明るく優しい性格で人当たりがいいので、誰にでも好かれやすい。"},{"spoiler":false,"text":"お姉さん的、と言っても全面に押し出すわけではなく、同年代感覚で主人公と接している。"},{"spoiler":false,"text":"主人公のことが好きでとても献身的だが、それがいきすぎて空回りする、なんてこともしばしば。"},{"spoiler":false,"text":"毎朝主人公のことを起こしに来るというのは最早日課になっている。"},{"spoiler":false,"text":"しかしそのせいで自分のことを後回しにしてドジを踏むことも。"},{"spoiler":false,"text":"主人公に対しては独占欲が強く嫉妬しやすい。"}],"source":"egs","sourceCharacterId":"852","sourceWorkId":"18188","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のひとつ年上で隣の家に住む幼馴染み。面倒見のいい性格で、お姉さん的存在。明るく優しい性格で人当たりがいいので、誰にでも好かれやすい。"},{"spoiler":false,"text":"料理を主人公に作る機会が多く、毎度量が多い。そのおかげで主人公も大食いとなり、沙希自信もよく食べるほうである。甘い物が好きで、よく行く喫茶店では毎回パフェを食べている。"},{"spoiler":false,"text":"非常に恵まれたスタイルではあるが、本人にその自覚はさほどない。運動が苦手なのはその豊満な胸のせいなのかもしれない。"}],"source":"bangumi","sourceCharacterId":"17643"}],"profileFacts":[],"metadataCandidateConflicts":{"hip":[{"comparisonValue":"88","source":"vndb","sourceCharacterId":"c76262","value":"88"},{"comparisonValue":"88","scope":"sourceWork","source":"egs","sourceCharacterId":"852","sourceWorkId":"18188","value":"88"},{"comparisonValue":"82","source":"bangumi","sourceCharacterId":"17643","value":"82"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/5574d4b7b6910ea0db378bad918711686234b79c78bfe291296b0c379dca0da6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/4777ddce93a9d7b6506ec5a9b64e04b6c010f5dff0681c9d69d0dd2e0346cc38.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高村優里","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:52408:17643:13512:1","source":"bangumi"}]},{"characterId":"char_c76263","characterName":"エリシュカ・マンデュラ","sourceIds":{"bangumi":[{"characterId":"18983","match":"exact-normalized-name-in-linked-work","subjectId":"64582"}],"egsCharacterIds":["853"],"vndbCharacterId":"c76263"},"originalCharacterName":"エリシュカ・マンデュラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【何を考えているかわからない不思議で寡黙な美少女】"},{"spoiler":false,"text":"寡黙な帰国子女。"},{"spoiler":false,"text":"あまり感情や意志を表に出すことはない、傍から見たらおとなしい性格。"},{"spoiler":false,"text":"しかし猫を前にすると表情が崩れたりと、お茶目な一面もちらほら。"},{"spoiler":false,"text":"他者への興味が希薄だが、ある出来事がきっかけで永遠に関心を示すようになる。"}],"source":"egs","sourceCharacterId":"853","sourceWorkId":"18188","spoiler":false},{"segments":[{"spoiler":false,"text":"寡黙な帰国子女。あまり感情や意志を表に出すことはない、傍から見たらおとなしい性格。しかし猫を前にすると表情が崩れたりと、お茶目な一面もちらほら。他者への興味が希薄だが、ある出来事がきっかけで永遠に関心を示すようになる。"}],"source":"bangumi","sourceCharacterId":"18983"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/4584b8038015f9c73b96b120c234ed5d8ee417a61fabd6fb569ddc014b6fd11a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b73deaabe7f2a2aa2ad9ea2a6795ffcbf9b46d59fd823ef4229439368476620.webp","width":174,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上みゆ","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:64582:18983:6558:1","source":"bangumi"}]},{"characterId":"char_vndb_c106570","characterName":"アレクサンドル・ドゥミトレスク","sourceIds":{"vndbCharacterId":"c106570"},"originalCharacterName":"アレクサンドル・ドゥミトレスク","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"190"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"100"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51c969fb760006a901e30673da41438b646598503d0f64e6f17bd6f5948991fe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa86221d63962617898e1ff7d07a88cba36c501c02d0ee8b6dc8aaff5d7a5a78.webp","widt