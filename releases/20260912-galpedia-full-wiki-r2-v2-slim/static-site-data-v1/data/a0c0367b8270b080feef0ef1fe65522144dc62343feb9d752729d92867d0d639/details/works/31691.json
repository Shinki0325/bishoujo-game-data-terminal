ndb"},{"creditedName":"カズマサ","creatorId":"vndb:s7745","sourcePersonId":"vndb:s7745","canonicalEntityId":"vndb:s7745","name":"カズマサ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:23245","source":"vndb"},{"creditedName":"田山 みにも","creatorId":"vndb:s10719","sourcePersonId":"vndb:s10719","canonicalEntityId":"vndb:s10719","name":"田山 みにも","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:23246","source":"vndb"}]},"cast":[{"characterId":"char_c907","characterName":"卯花之佐久夜姫","sourceIds":{"bangumi":[{"characterId":"19887","match":"exact-normalized-name-in-linked-work","subjectId":"10119"},{"characterId":"19887","match":"exact-normalized-name-in-linked-work","subjectId":"34107"}],"egsCharacterIds":["13477"],"vndbCharacterId":"c907"},"originalCharacterName":"卯花之佐久夜姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"This mischievous deity has been watching over the city for centuries, and now she's set her sights on Chitose Haruki. Determined to banish his bad luck, Sakuya made herself comfortable in his home, but her love for stirring the pot often turned her into a troublemaker. Her latest hobby? Poking and prodding people with loaded statements just to see how they'll squirm."},{"spoiler":false,"text":"While she maintains a carefree detachment from most things, a spark of possessiveness ignites within her when it comes to those who capture her interest, revealing a surprisingly jealous side to this otherwise whimsical goddess."},{"spoiler":false,"text":"Translated and edited from the official site"}],"source":"vndb","sourceCharacterId":"c907"},{"segments":[{"spoiler":false,"text":"数百年もの間、真日羽市を守る土地神として存在してきた神様。"},{"spoiler":false,"text":"千歳春樹の不幸を拭うために彼の家に居座る事になるのだが、"},{"spoiler":false,"text":"面白い事が好きな性格のせいかトラブルメーカーになってしまうことも多い。"},{"spoiler":false,"text":"人を試すような事を言って反応を見るのが最近のマイブーム。"},{"spoiler":false,"text":"何事に対しても執着心は薄いが、気になる人間にはヤキモチを焼く一面も。"}],"source":"egs","sourceCharacterId":"13477","sourceWorkId":"11947","spoiler":false},{"segments":[{"spoiler":false,"text":"数百年もの間、真日羽市を守る土地神として存在してきた神様。"},{"spoiler":false,"text":"千歳春樹の不幸を拭うために彼の家に居座る事になるのだが、面白い事が好きな性格のせいかトラブルメーカーになってしまうことも多い。"},{"spoiler":false,"text":"人を試すような事を言って反応を見るのが最近のマイブーム。"},{"spoiler":false,"text":"何事に対しても執着心は薄いが、気になる人間にはヤキモチを焼く一面も。"}],"source":"bangumi","sourceCharacterId":"19887"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c920d446ccd6422c68088908febc869402ec434aef737c4fd82bb327c5d7879e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91d6b14ddf2b0d78f152690a26185ce25dea2073601722e4265a31fc92329d19.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤静","creatorId":"vndb:s516","sourcePersonId":"vndb:s516","canonicalEntityId":"vndb:s516","name":"伊藤 静","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10119:19887:4272:1","source":"bangumi"}]},{"characterId":"char_c910","characterName":"千歳 佐奈","sourceIds":{"bangumi":[{"characterId":"19886","match":"exact-normalized-name-in-linked-work","subjectId":"10119"},{"characterId":"19886","match":"exact-normalized-name-in-linked-work","subjectId":"34107"}],"egsCharacterIds":["13479"],"vndbCharacterId":"c910"},"originalCharacterName":"千歳 佐奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"608"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haruki's younger sister, kind to everyone, good at housework, whether it’s cooking or laundry, she can handle it all. She has a big brother complex, and is always panicking whenever she says embarrassing things in front of Haruki, and is scared of ghost stories. She also knows a lot of otaku memes."},{"spoiler":false,"text":"Edited from Mayoi's review"}],"source":"vndb","sourceCharacterId":"c910"},{"segments":[{"spoiler":false,"text":"兄の事が大好きな主人公の妹。"},{"spoiler":false,"text":"水薙学園に通う一年生で、炊事や洗濯等、千歳家の家事全般をこなしている。"},{"spoiler":false,"text":"趣味は兄観察・兄の世話を焼く事。普段は誰にでも優しくおとなしい性格なのだが、"},{"spoiler":false,"text":"兄が絡むと意外な行動力を発揮したりする。"},{"spoiler":false,"text":"恋に関しては奥手で、兄と二人きりになると暴走気味になってしまう女の子。"}],"source":"egs","sourceCharacterId":"13479","sourceWorkId":"11947","spoiler":false},{"segments":[{"spoiler":false,"text":"兄の事が大好きな主人公の妹。"},{"spoiler":false,"text":"水薙学園に通う一年生で、炊事や洗濯等、千歳家の家事全般をこなしている。"},{"spoiler":false,"text":"趣味は兄観察・兄の世話を焼く事。普段は誰にでも優しくおとなしい性格なのだが、兄が絡むと意外な行動力を発揮したりする。"},{"spoiler":false,"text":"恋に関しては奥手で、兄と二人きりになると暴走気味になってしまう女の子。"}],"source":"bangumi","sourceCharacterId":"19886"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b6867fb918bc79c9701e337636549fb1374a8e1ded69615f8554ff902e48a01.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/3960f1c7f63d03e50aa56894d661dd9ab077883c63848413eeb807257efcdf49.webp","width":104,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10119:19886:4809:1","source":"bangumi"}]},{"characterId":"char_c911","characterName":"山吹 葵","sourceIds":{"bangumi":[{"characterId":"19889","match":"exact-normalized-name-in-linked-work","subjectId":"10119"},{"characterId":"19889","match":"exact-normalized-name-in-linked-work","subjectId":"34107"}],"egsCharacterIds":["13480"],"vndbCharacterId":"c911"},"originalCharacterName":"山吹 葵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haruki's childhood friend and Wataru's younger sister. Due to her looks and outgoing personality, she's really popular at school. She has been confessed to a lot, but she turns them all down, not to mention she doesn't completely realize what love is. Aoi always put others first and is not really honest with herself. She often hands out all kinds of charms to Haruki in order to protect him from his misfortunes."},{"spoiler":false,"text":"Edited from Mayoi's review"}],"source":"vndb","sourceCharacterId":"c911"},{"segments":[{"spoiler":false,"text":"細かい事は気にしない、竹を割ったような性格の主人公の幼馴染。"},{"spoiler":false,"text":"明るい性格でルックスも良く、誰にでも平等に接するので、男女ともに人気がある。"},{"spoiler":false,"text":"だが、恋愛に関してはかなり鈍感で、周囲を呆れさせてしまう事も。"},{"spoiler":false,"text":"いつも不運な主人公を心配し、様々なお守りを集めてはプレゼントしているのだが、"},{"spoiler":false,"text":"未だに効果はみられないようだ。"}],"source":"egs","sourceCharacterId":"13480","sourceWorkId":"11947","spoiler":false},{"segments":[{"spoiler":false,"text":"細かい事は気にしない、竹を割ったような性格の主人公の幼馴染。"},{"spoiler":false,"text":"明るい性格でルックスも良く、誰にでも平等に接するので、男女ともに人気がある。"},{"spoiler":false,"text":"だが、恋愛に関してはかなり鈍感で、周囲を呆れさせてしまう事も。"},{"spoiler":false,"text":"いつも不運な主人公を心配し、様々なお守りを集めてはプレゼントしているのだが、未だに効果はみられないようだ。"}],"source":"bangumi","sourceCharacterId":"19889"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e432898c3270db428f926a458301daaab9d9da7c516416f08e9263ad3242887.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/705b09617f1c6906da29330d9df2a9f9c57bc51cf3853722c367fa02dd6d1146.webp","width":115,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結下みちる","creatorId":"vndb:s794","sourcePersonId":"vndb:s794","canonicalEntityId":"vndb:s794","name":"結下 みちる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10119:19889:4705:1","source":"bangumi"}]},{"characterId":"char_c912","characterName":"竜胆 ルリ","sourceIds":{"bangumi":[{"characterId":"19888","match":"exact-normalized-name-in-linked-work","subjectId":"10119"},{"characterId":"19888","match":"exact-normalized-name-in-linked-work","subjectId":"34107"}],"egsCharacterIds":["13478"],"vndbCharacterId":"c912"},"originalCharacterName":"竜胆 ルリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young girl who serves Unohana."},{"spoiler":false,"text":"While she appears as a little girl in a kimono, she’s actually a fox spirit that can still take the form of a white fox. Even in her human form, she can hide her fox ears and tail at will. She admired her master Unohana deeply and pursued her when she left. She blames Haruki for separating them and holds a grudge against him."},{"spoiler":false,"text":"Ruri is quite animal-like in her behavior, showing love for grooming her tail, sniffing or licking things that pique her curiosity, and giving small prey to those she cares for. She also uses quirky onomatopoeic expressions like \"ujuru-ujuru\" in conversation."},{"spoiler":false,"text":"Unlike Unohana, she's naive about the world and often speaks from her sheltered forest perspective, seeing romance between men and women as simply \"a natural part of making babies,\" and thinking that \"fevers don't cool down unless you die.\" Her kimono suggests she's not wearing underwear, although this isn't confirmed. She ends up attending the same academy as Unohana (in Sana's class) but skips class often."},{"spoiler":false,"text":"Translated and edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c912"},{"segments":[{"spoiler":false,"text":"神様を追いかけてやってきた、狐耳の女の子。"},{"spoiler":false,"text":"暖かいところとお菓子が大好きで、趣味はしっぽの手入れ。"},{"spoiler":false,"text":"神様が苦労しているのは主人公のせいだと思い込み、一方的に敵視している。"},{"spoiler":false,"text":"興味をひかれるものがあると、匂いをかいだり舐めてみたりする癖がある。"},{"spoiler":false,"text":"好意を持つ相手には捕獲した小動物をプレゼントすることも!?"}],"source":"egs","sourceCharacterId":"13478","sourceWorkId":"11947","spoiler":false},{"segments":[{"spoiler":false,"text":"神様を追いかけてやってきた、狐耳の女の子。"},{"spoiler":false,"text":"暖かいところとお菓子が大好きで、趣味はしっぽの手入れ。"},{"spoiler":false,"text":"神様が苦労しているのは主人公のせいだと思い込み、一方的に敵視している。"},{"spoiler":false,"text":"興味をひかれるものがあると、匂いをかいだり舐めてみたりする癖がある。"},{"spoiler":false,"text":"好意を持つ相手には捕獲した小動物をプレゼントすることも！？"}],"source":"bangumi","sourceCharacterId":"19888"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c169ddff5b8e4c72851267d8fe3f6e76adb52bb68a86d2782754b992070c51e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f3387dd26ef55653f1988e9a1549596f83288f604472e58b6dff139fde4328c.webp","width":178,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10119:19888:4810:1","source":"bangumi"}]},{"characterId":"char_vndb_c78183","characterName":"市杵宍姫命","sourceIds":{"vndbCharacterId":"c78183"},"originalCharacterName":"市杵宍姫命","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Itsuki is a divine being who was roused from her lengthy slumber by Haruki's shenanigans. Unlike Unohana, the land-governing deity, Itsuki's role is to maintain order by cleansing \"impurities\" as the \"Goddess of Purification\"."},{"spoiler":false,"text":"This laid-back goddess has an optimistic outlook and tends to shy away from hassles, but she's no slouch when it comes to fulfilling her sacred duties. Oh, and she's got a bit of a masochistic streak, though she'll be quick to correct you that she's not just an M, but a super-M!"},{"spoiler":false,"text":"Itsuki's a gamer at heart, but her taste in games is a bit... retro. When she starts living among humans, she frets over whether Pyuuta (an early console from 1982) is sold out and gets her gaming fix with the Virtual Boy (from 1995). Talk about being behind the times!"},{"spoiler":false,"text":"Translated and edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c78183"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c35f37a011e879ff5817ed6c2d9822df10ed114818f17c72d30dcd9096c9178.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/943bc5ee2397730d963e8f0d3c7c312d9a4842a019b48afb8b8f587d5a0534a8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ゆかな","creatorId":"vndb:s51","sourcePersonId":"vndb:s51","canonicalEntityId":"vndb:s51","name":"ゆかな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11877","source":"vndb"}]},{"characterId":"char_vndb_c78184","characterName":"蘇芳","sourceIds":{"vndbCharacterId":"c78184"},"originalCharacterName":"蘇芳","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/7433fa7d5bfc037914918cd387d4a31ef6d3a5e298fc8f773baa46ec023fdca8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26742865165ff7986243616e5e0d58896aab09c56696684884fc7f8f13ea6265.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阿澄 佳奈","creatorId":"vndb:s1189","sourcePersonId":"vndb:s1189","canonicalEntityId":"vndb:s1189","name":"阿澄 佳奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11891","source":"vndb"}]},{"characterId":"char_vndb_c908","characterName":"千歳 春樹","sourceIds":{"vndbCharacterId":"c908"},"originalCharacterName":"千歳 春樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Our unlucky protagonist, he already treats his misfortunes as a part of his daily life. A tsundere, and unbelievably good at fighting. He shows his soft personality from time to time, and deeply cares about his companions. You can rely on him when the time counts."},{"spoiler":false,"text":"Edited from Mayoi's review"}],"source":"vndb","sourceCharacterId":"c908"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86a7a2df61131d164e22b02f70670e23a1754170eed47aefa9ff4bb6fef765d1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61091eedd2e013870198f08d655d390e1195123fa8665cea739a827cec0c3ef7.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c913","characterName":"常盤 まひろ","sourceIds":{"vndbCharacterId":"c913"},"originalCharacterName":"常盤 まひろ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the two sub-heroines and the student council president of Mizunagi Academy. Excellent grades, good looks, kind to everyone, the students really admire her. She also loves curry."},{"spoiler":false,"text":"Edited from Mayoi's review"}],"source":"vndb","sourceCharacterId":"c913"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bfe40a9bf087914c78bee1c02bdfb7376f8cb0354fffe60649447c59fbcbf6f8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00edfb18aa17970e47a88f738bb2c8b89d542682f65606c2872b9d88796a825e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋 妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11879","source":"vndb"}]},{"characterId":"char_vndb_c914","characterName":"山吹 渉","sourceIds":{"vndbCharacterId":"c914"},"originalCharacterName":"山吹 渉","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aoi's older sister who works at the coffee shop \"Robin\" run by Haruki's grandfather. She's also Yukari's friend from her school days. Good at making tea, but bad at making coffee."},{"spoiler":false,"text":"Edited from Mayoi's review"}],"source":"vndb","sourceCharacterId":"c914"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f19afdb3d3b61dc2b7c327fe4b172bc1e0941f1247da53d4922389385f6b2de7.webp","fallbackUrl":"https://wiki-as