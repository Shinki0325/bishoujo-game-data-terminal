{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"7534","model":{"presentationWorkId":"vndb:v6222","staff":{"artwork":[{"creditedName":"CARNELIAN","creatorId":"vndb:s961","sourcePersonId":"egs:creator:155","canonicalEntityId":"vndb:s961","name":"CARNELIAN","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:294272","source":"egs"}],"scenario":[{"creditedName":"菅野ひろゆき(菅野洋之、妃路雪≠卿、剣乃ゆきひろ)","creatorId":"vndb:s812","sourcePersonId":"egs:creator:138","canonicalEntityId":"vndb:s812","name":"菅野ひろゆき(菅野洋之、妃路雪≠卿、剣乃ゆきひろ)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:16534","source":"egs"}],"music":[],"other":[{"creditedName":"CARNELIAN","creatorId":"vndb:s961","sourcePersonId":"vndb:s961","canonicalEntityId":"vndb:s961","name":"CARNELIAN","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:62814","source":"vndb"}]},"cast":[{"characterId":"char_c3825","characterName":"南条 深雪","sourceIds":{"bangumi":[{"characterId":"48378","match":"exact-normalized-name-in-linked-work","subjectId":"16693"}],"egsCharacterIds":["15998"],"vndbCharacterId":"c3825"},"originalCharacterName":"南条 深雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"22"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"悪行が開業する「しあわせ探偵事務所」に勤める。"},{"spoiler":false,"text":"アイドラーライセンス・クラスCを取得したばかり。"},{"spoiler":false,"text":"今回は声のみのアシストだが、「ミステリート」ではメインキャラクターとして活躍する。"},{"spoiler":false,"text":"深雪と話したい場合は「しあわせ探偵事務所」へ電話"},{"spoiler":false,"text":"（000-2232-0001）すると話すことが出来る。"}],"source":"egs","sourceCharacterId":"15998","sourceWorkId":"11773","spoiler":false},{"segments":[{"spoiler":false,"text":"『しあわせ探偵事務所』の元所員。頭は切れるし行動力もある。"},{"spoiler":false,"text":"前所長・悪行双麻が行方不明になったのをキッカケに、南条探偵事務所を設立し現在に至る。が、古巣とは犬猿の仲……。"},{"spoiler":false,"text":"八十神かおるの保護者を自認し、クラスAディテクティブをちゃっかり自分の探偵事務所に引き入れた実は抜け目のない女性。"}],"source":"bangumi","sourceCharacterId":"48378"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e45a9131a906607e4289ca3ccd4a11fcf2bc2fedff685a0b95f1ab7a832c4b9b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb2dd980362ada349adcc5cec6203fdf67df008215c38b408ac840b3adfb0d44.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"根谷 美智子","creatorId":"vndb:s1086","sourcePersonId":"vndb:s1086","canonicalEntityId":"vndb:s1086","name":"根谷 美智子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35086","source":"vndb"}]},{"characterId":"char_c4119","characterName":"悪行 双麻","sourceIds":{"bangumi":[{"characterId":"48380","match":"exact-normalized-name-in-linked-work","subjectId":"16693"}],"egsCharacterIds":["15992"],"vndbCharacterId":"c4119"},"originalCharacterName":"悪行 双麻","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a Class A detective. He is very good at deducing the situation of the case, even with little bit of information. He doesn't smoke, but he keeps the best cigarette in his pocket and plans to smoke it when he is about to die."},{"spoiler":false,"text":"taken from GameFAQs review"}],"source":"vndb","sourceCharacterId":"c4119"},{"segments":[{"spoiler":false,"text":"「クズ通り」と呼ばれる場末の裏通りに事務所を構える探偵。"},{"spoiler":false,"text":"事務所には名前すらなく、依頼人も寄り付かないように見えるが、本当は世界でも30人しかいないという、クラスAディティクティブの腕を持つ名探偵。"},{"spoiler":false,"text":"もはや「超能力」とすら呼べるほどの、トラブルを呼び寄せる「悪運」を持っており、腕も名前も隠しているにも関わらず事件のほうから周囲に群がってくる。"},{"spoiler":false,"text":"本来一流の腕を持つ探偵でもあるため、寄ってくる事件を解決していくだけの、常識的なレベルを遥かに上回る解決数を稼ぎだしてしまう。"}],"source":"egs","sourceCharacterId":"15992","sourceWorkId":"11773","spoiler":false},{"segments":[{"spoiler":false,"text":"『不確定世界の探偵紳士』の主人公。"},{"spoiler":false,"text":"運は極悪、腕は超一流。日本にふたりしかいない、数少ないクラスAディテクティブ。"}],"source":"bangumi","sourceCharacterId":"48380"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/6567802c3a299eba691a64736e1c6c668ac9647abf2f9d55c3d68d65a48019e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0bc04bb986fa6c41660954c1ee8e03b5166344a8ee14542f312bae10435c1b20.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"子安 武人","creatorId":"vndb:s10","sourcePersonId":"vndb:s10","canonicalEntityId":"vndb:s10","name":"子安 武人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35083","source":"vndb"}]},{"characterId":"char_vndb_c3818","characterName":"八十神 かおる","sourceIds":{"vndbCharacterId":"c3818"},"originalCharacterName":"八十神 かおる","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A highly skilled detective who is of british nationality. He has already graduated from Oxford University with advanced placement."}],"source":"vndb","sourceCharacterId":"c3818"}],"profi