tus":"auto-confirmed","relationId":"egs:work-creator:112147","source":"egs"},{"creditedName":"シャア専用◎","creatorId":"vndb:s2261","sourcePersonId":"egs:creator:2171","canonicalEntityId":"vndb:s2261","name":"シャア専用◎","detail":"シナリオ協力","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:112148","source":"egs"},{"creditedName":"夢野Q作","creatorId":"vndb:s2202","sourcePersonId":"egs:creator:2423","canonicalEntityId":"vndb:s2202","name":"夢野Q作","detail":"シナリオ協力","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:112149","source":"egs"},{"creditedName":"NATORI 烏賊","creatorId":"vndb:s1983","sourcePersonId":"vndb:s1983","canonicalEntityId":"vndb:s1983","name":"NATORI 烏賊","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:26548","source":"vndb"},{"creditedName":"NATORI 烏賊","creatorId":"vndb:s1983","sourcePersonId":"vndb:s1983","canonicalEntityId":"vndb:s1983","name":"NATORI 烏賊","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26549","source":"vndb"},{"creditedName":"吉野 恵子","creatorId":"vndb:s2157","sourcePersonId":"vndb:s2157","canonicalEntityId":"vndb:s2157","name":"吉野 恵子","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:26550","source":"vndb"}]},"cast":[{"characterId":"char_c13263","characterName":"桜井 佐和","sourceIds":{"bangumi":[{"characterId":"92723","match":"exact-normalized-name-in-linked-work","subjectId":"20155"},{"characterId":"92723","match":"exact-normalized-name-in-linked-work","subjectId":"20157"}],"egsCharacterIds":["18676"],"vndbCharacterId":"c13263"},"originalCharacterName":"桜井 佐和","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the mother of the main character, a 36-year-old career woman."},{"spoiler":false,"text":"After the death of her husband, she has been struggling to hold down a job and raise her son on her own."},{"spoiler":false,"text":"She is always busy and has a hard time finding time for her son."},{"spoiler":false,"text":"Although she loves her son very much, she is extremely serious and tends to nag him."},{"spoiler":false,"text":"Although she has received many invitations because of her beauty, she has refused all of them and has never thought about dating a man."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c13263"},{"segments":[{"spoiler":false,"text":"主人公との関係：実母"},{"spoiler":false,"text":"キャリアウーマンの主人公の母親。"},{"spoiler":false,"text":"夫との死別後、一人で息子を育ててきた。"},{"spoiler":false,"text":"息子への愛情はとても深いが、仕事が忙しく時間がとれない、かつ、気真面目な性格から、つい口やかましくしてしまう。"},{"spoiler":false,"text":"自分より母親らしい面を見せる志乃に、ちょっとした嫉妬を抱いているようだが……。"}],"source":"egs","sourceCharacterId":"18676","sourceWorkId":"9494","spoiler":false},{"segments":[{"spoiler":false,"text":"キャリアウーマンの本編主人公（＝桜井進）の実母。"},{"spoiler":false,"text":"夫との死別後、一人で息子を育ててきた。"},{"spoiler":false,"text":"息子への愛情はとても深いが、仕事が忙しく時間がとれない、かつ生真面目な性格から、つい口やかましくしてしまう。"}],"source":"egs","sourceCharacterId":"18676","sourceWorkId":"10498","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の母親で、36歳のキャリアウーマン。夫との死別後、仕事を持ち一人で必死に息子を育ててきた。いつも忙しく、なかなか息子との時間をつくれないでいる。"},{"spoiler":false,"text":"息子への愛情はとても深いものの、極めて真面目な性格で、ついつい息子に口やかましくしてしまう。"},{"spoiler":false,"text":"美人ゆえに誘いは多いものの、一切○っていて、男性と付き合うことなど考えたことがない。"}],"source":"bangumi","sourceCharacterId":"92723"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/6101c67dcefa7f710e8d1ed92357c1e179ef86d01837090e7eeed89c7bb7dacf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00fab02868da19dda282a3d22aaab9c3e99869a1797ad7aada85972c72512120.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20155:92723:4937:1","source":"bangumi"}]},{"characterId":"char_c13264","characterName":"高瀬 志乃","sourceIds":{"bangumi":[{"characterId":"92724","match":"exact-normalized-name-in-linked-work","subjectId":"20155"},{"characterId":"92724","match":"exact-normalized-name-in-linked-work","subjectId":"20157"}],"egsCharacterIds":["18677"],"vndbCharacterId":"c13264"},"originalCharacterName":"高瀬 志乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sawa's younger sister and the main character's aunt."},{"spoiler":false,"text":"She is a 34-year-old housewife with a family of three, including her husband and daughter."},{"spoiler":false,"text":"Unlike her serious sister Sawa, she is a family-oriented person with a friendly personality."},{"spoiler":false,"text":"While she understands her sister's situation, she is sympathetic to the protagonist who stays home alone and always invites him to dinner."},{"spoiler":false,"text":"She teaches piano at home to neighborhood children."},{"spoiler":false,"text":"The house is relatively wealthy and has a piano lesson room."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c13264"},{"segments":[{"spoiler":false,"text":"主人公との関係：叔母"},{"spoiler":false,"text":"佐和の妹で、三人家族をもつ主婦。"},{"spoiler":false,"text":"家庭的で親しみやすい人格者で、一人で家にいることが多い主人公を、いつも夕食に招待している。"},{"spoiler":false,"text":"近所の子供を相手に、よくピアノのレッスンをしていて、主人公も同じレッスンをすることになるが……。"}],"source":"egs","sourceCharacterId":"18677","sourceWorkId":"9494","spoiler":false},{"segments":[{"spoiler":false,"text":"本編主人公（＝桜井進）の叔母。"},{"spoiler":false,"text":"佐和の妹で、三人家族を持つ主婦。"},{"spoiler":false,"text":"家庭的で親しみやすい人格者で、一人で家にいることが多い主人公を、いつも夕食に招待している。"},{"spoiler":false,"text":"近所の子供を相手に、よくピアノのレッスンをしていてる。"}],"source":"egs","sourceCharacterId":"18677","sourceWorkId":"10498","spoiler":false},{"segments":[{"spoiler":false,"text":"佐和の妹で主人公の叔母。34歳の主婦で、夫と娘との三人家族。生真面目な姉の佐和とは違って家庭的で、親しみやすい性格。"},{"spoiler":false,"text":"姉の事情を理解しつつも、一人で家にいる主人公に対して同情的で、いつも夕食に招待してくれる。"},{"spoiler":false,"text":"近所の子供を相手に、家でピアノを教えている。比較的裕福な一軒家で、ピアノのレッスン室がある。"}],"source":"bangumi","sourceCharacterId":"92724"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc3582e7f084dafae66636ddc3ddbc8f3d3b86e9370f95c8ccefd381a4b06656.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc43ee2bdda2b252f091be9041fa194a933970a6cadee8ee2ef531807d6c1554.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20155:92724:4940:1","source":"bangumi"}]},{"characterId":"char_c13265","characterName":"高瀬 則子","sourceIds":{"bangumi":[{"characterId":"92725","match":"exact-normalized-name-in-linked-work","subjectId":"20155"},{"characterId":"92725","match":"exact-normalized-name-in-linked-work","subjectId":"20157"}],"egsCharacterIds":["18678"],"vndbCharacterId":"c13265"},"originalCharacterName":"高瀬 則子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is Shino's daughter and the protagonist's cousin."},{"spoiler":false,"text":"She is a first-year student at Shirosakura Jogakuen."},{"spoiler":false,"text":"Like her mother, she is a cheerful and sociable girl who always has a smile on her face."},{"spoiler":false,"text":"She cheerfully encourages the introverted protagonist by pushing him along."},{"spoiler":false,"text":"She does not recognize the main character as the opposite sex,"},{"spoiler":false,"text":"and treats the protagonist as if they were brother and sister."},{"spoiler":false,"text":"Noriko is also taught piano by her mother and is quite skilled."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c13265"},{"segments":[{"spoiler":false,"text":"主人公との関係：従妹"},{"spoiler":false,"text":"志乃の娘で、女学院に通う一年生。"},{"spoiler":false,"text":"明るく社交的で、笑顔の眩しい彼女は、主人公の背中を押すように、いつも励ましてくれる。"},{"spoiler":false,"text":"しかし、そこに恋愛感情はなく、兄妹のように思っている様子。"},{"spoiler":false,"text":"年頃の少女並に、恋愛に対しては興味を持っているようで、そこに付け込んだ主人公は、彼女に対し……。"}],"source":"egs","sourceCharacterId":"18678","sourceWorkId":"9494","spoiler":false},{"segments":[{"spoiler":false,"text":"本編主人公（＝桜井進）の従妹。"},{"spoiler":false,"text":"志乃の娘で、女学院に通う一年生。"},{"spoiler":false,"text":"明るく社交的で、笑顔の眩しい彼女は、主人公の背中を押すように、いつも励ましてくれる。"},{"spoiler":false,"text":"しかし、そこに恋愛感情はなく、兄妹のように思っている様子。"},{"spoiler":false,"text":"しかし、年頃の女の子と変わらず、恋愛に対しては興味を持っているようだ。"}],"source":"egs","sourceCharacterId":"18678","sourceWorkId":"10498","spoiler":false},{"segments":[{"spoiler":false,"text":"志乃の娘で、主人公のイトコ。白櫻女学院の1年生。母親に似て明るく社交的で、いつも笑顔の女の子。内向的な主人公の背中を押すように、元気に励ましてくれる。"},{"spoiler":false,"text":"主人公のことを異性として認識はしておらず、兄妹のように 接してくる。 則子も母親にピアノを教わっていて、かなりの腕前。"}],"source":"bangumi","sourceCharacterId":"92725"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3948d75aec5569f7ba69c9eee3d10f646828e60ea22d8ece1b0145b33d7b064.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cf7ebb4f69568603c94af9e232cd98fd85a645ff0bee6f3b69627e185dceb8b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20155:92725:4463:1","source":"bangumi"}]},{"characterId":"char_c13266","characterName":"笠谷 理枝","sourceIds":{"bangumi":[{"characterId":"92726","match":"exact-normalized-name-in-linked-work","subjectId":"20155"},{"characterId":"92726","match":"exact-normalized-name-in-linked-work","subjectId":"20157"}],"egsCharacterIds":["18679"],"vndbCharacterId":"c13266"},"originalCharacterName":"笠谷 理枝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a neighbor of the main character and his classmate."},{"spoiler":false,"text":"Although they have known each other since childhood, they are not close, and she hates to hear gossip about him."},{"spoiler":false,"text":"She is a vivacious sports girl who belongs to the track club, and inwardly makes fun of the protagonist, who is not very athletic and is dull."},{"spoiler":false,"text":"The fact that the main character is bullied but does not rebel is another reason for her irritation with the hero."},{"spoiler":false,"text":"Translated from the the official site"}],"source":"vndb","sourceCharacterId":"c13266"},{"segments":[{"spoiler":false,"text":"主人公との関係：幼馴染"},{"spoiler":false,"text":"同じマンションの隣に住む同級生。"},{"spoiler":false,"text":"陸上部に所属し、快活なスポーツ少女である彼女は、運動音痴で冴えなく、イジメにも反抗しない主人公を内心バカにしている様子。"},{"spoiler":false,"text":"催眠術を会得した主人公は彼女に対し、いままでの冷たい仕打ちへの復讐とばかりに……。"}],"source":"egs","sourceCharacterId":"18679","sourceWorkId":"9494","spoiler":false},{"segments":[{"spoiler":false,"text":"本編主人公（＝桜井進）の幼馴染。"},{"spoiler":false,"text":"同じマンションの隣に住む同級生。"},{"spoiler":false,"text":"陸上部に所属し、快活なスポーツ少女である彼女は、運動音痴で冴えなく、イジメにも反抗しない主人公を内心バカにしているが……。"}],"source":"egs","sourceCharacterId":"18679","sourceWorkId":"10498","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の住むマンションのお隣さんで、同級生。"},{"spoiler":false,"text":"幼馴染ではあるのだが、それほど仲が良いわけではなく、むしろそういうコトで色々と噂されるのがイヤで、彼女は主人公を嫌っている。"},{"spoiler":false,"text":"陸上部に所属する快活なスポーツ少女で、運動音痴で冴えない主人公を内心バカにしている。"},{"spoiler":false,"text":"イジメにあっているのに反抗しないことも彼女が主人公に対しイラつく原因。"}],"source":"bangumi","sourceCharacterId":"92726"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d629f962a01be77b4998d3c45b8dc0c1fb185d887be61bf49b5c5b01ff0f9ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b2f970e53e7b157fe14b219c3fdcc3192b66c9a440ffaae7935c9ce7e62d9b7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あらいしずか","creatorId":"vndb:s665","sourcePersonId":"vndb:s665","canonicalEntityId":"vndb:s665","name":"あらい しずか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20155:92726:4647:1","source":"bangumi"}]},{"characterId":"char_c13267","characterName":"笠谷 葉子","sourceIds":{"bangumi":[{"characterId":"92727","match":"exact-normalized-name-in-linked-work","subjectId":"20155"},{"characterId":"92727","match":"exact-normalized-name-in-linked-work","subjectId":"20157"}],"egsCharacterIds":["18680"],"vndbCharacterId":"c13267"},"originalCharacterName":"笠谷 葉子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is Rie's older sister and a 22-year-old female college student."},{"spoiler":false,"text":"She takes care of Rie in place of her parents who live abroad for work."},{"spoiler":false,"text":"She has a calm personality and is always temperate and kind."},{"spoiler":false,"text":"Unlike her sister Rie, she is fond of the main character and treats him like a younger brother."},{"spoiler":false,"text":"The main character also admires her and looks up to her like an older sister."},{"spoiler":false,"text":"Translated from the the official site"}],"source":"vndb","sourceCharacterId":"c13267"},{"segments":[{"spoiler":false,"text":"主人公との関係：憧れのお姉さん"},{"spoiler":false,"text":"大学生の理枝の姉。"},{"spoiler":false,"text":"いつも優しく、温和でおっとりしていて、主人公にも弟のように接してくれる。"},{"spoiler":false,"text":"憧れのお姉さん的存在だった彼女に対しても、主人公は、ある催眠術で葉子の肉体を弄び、犯していく。"}],"source":"egs","sourceCharacterId":"18680","sourceWorkId":"9494","spoiler":false},{"segments":[{"spoiler":false,"text":"女子大生の理枝の姉。"},{"spoiler":false,"text":"本編主人公（＝桜井進）の憧れのお姉さん。"},{"spoiler":false,"text":"いつも優しく、温和でおっとりしていて、主人公にも弟のように接してくれる。"}],"source":"egs","sourceCharacterId":"18680","sourceWorkId":"10498","spoiler":false},{"segments":[{"spoiler":false,"text":"理枝の姉で、22歳の女子大生。仕事で海外生活をしている両親の代わりに理枝の面倒をみてくれる。"},{"spoiler":false,"text":"おっとりした性格で、いつも温和で優しい女性。妹の理枝とは違い主人公に好意的で、弟のように思って接してくれている。主人公も憧れの存在として、彼女を姉のように慕っている。"}],"source":"bangumi","sourceCharacterId":"92727"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5dbe4ba99cc28067304e6924917511054b1574364df58a3aa0493abd2d89cf0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d96c043c782b7aa29ef32c9295ebf0cb87bba7efb5e86472ae49cf9c3454258e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20155:92727:5741:1","source":"bangumi"}]},{"characterId":"char_c13548","charact