ki/v1/characters/v1/images/ae/ae1332bb43e21fc5aee82f1b271d93c17da05b854bd828b26d552e61fe820d10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e93e767ec314b1c6c797002daf624c27aa4bac9479ab0c183f0453147eeddf45.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平山ゆかり","creatorId":"vndb:s285","sourcePersonId":"vndb:s285","canonicalEntityId":"vndb:s285","name":"東かりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20155:92715:5905:1","source":"bangumi"}]},{"characterId":"char_vndb_c13268","characterName":"桜井 進","sourceIds":{"vndbCharacterId":"c13268"},"originalCharacterName":"桜井 進","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this work. A second-year student at Seishin Academy."},{"spoiler":false,"text":"He lives with his mother in a single-parent household."},{"spoiler":false,"text":"He's not good at sports and has an introverted personality."},{"spoiler":false,"text":"And because of his personality, he is the target of bullying at the academy."},{"spoiler":false,"text":"At home, his earnest, respectable mother puts a lot of pressure on him, but he doesn't rebel and lives an empty life."},{"spoiler":false,"text":"The only time he finds peace is during dinner at his aunt's house."},{"spoiler":false,"text":"By chance, he meets a man named Murakoshi who has moved into the same apartment building, and the two become friends."},{"spoiler":false,"text":"This marks a major turning point in his life..."},{"spoiler":false,"text":"Translated from the the official site"}],"source":"vndb","sourceCharacterId":"c13268"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/termina