:"vndb:s48079","sourcePersonId":"egs:creator:27703","canonicalEntityId":"vndb:s48079","name":"Encyclorecorder","detail":"背景","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:288051","source":"egs"},{"creditedName":"EnsiLumi","creatorId":"vndb:s25843","sourcePersonId":"egs:creator:29278","canonicalEntityId":"vndb:s25843","name":"EnsiLumi","detail":"背景","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:288052","source":"egs"}]},"cast":[{"characterId":"char_vndb_c166406","characterName":"C・ライナス・ キャヴェンディッシュ","sourceIds":{"vndbCharacterId":"c166406"},"originalCharacterName":"C・ライナス・ キャヴェンディッシュ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Favorite Tea: Darjeeling"},{"spoiler":false,"text":"The young head of the prestigious Cavendish family. Though he comes from an ancient lineage, he dislikes conservative thinking. With his outspoken personality and firm belief in meritocracy, he has many enemies among the aristocracy, who place class above all else. However, he is also well-liked because he takes good care of those he favors. When it comes to tea, he prefers it simple and served straight."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c166406"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/6392cbbe83db4ca141ecd8fdc328d724aca93e4b67bca2fb2571d0d117a576fb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae0782e2f0cfbace974412481441aa2314472568f1f9782803b435ed98df0f0a.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c168554","characterName":"アリス・シャロット・キャヴェンディッシュ","sourceIds":{"vndbCharacterId":"c168554"},"originalCharacterName":"アリス・シャロット・キャヴェンディッシュ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“Poor Alice Evelyn...”"},{"spoiler":false,"text":"The eldest daughter of the Earl of Cavendish. Believed by her father to be his illegitimate child, she is treated with contempt. It pains her to see her twin sister being the only one subjected to abuse. Despite her difficult circumstances, she remains kind-hearted, yet there is something slightly twisted about that kindness..."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c168554"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1bf7422a2f23c831ef911c920e7f11bddf57a1866876eb6064620ea19ab03476.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd089361bc2c49f7ef3a1bc9a9982e1d962aa79533bfda8f13c756719ac7f37c.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c168555","characterName":"アリス・イヴリン・キャヴェンディッシュ","sourceIds":{"vndbCharacterId":"c168555"},"originalCharacterName":"アリス・イヴリン・キャヴェンディッシュ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“A bird in a cage will not know what to do even after it's set free.”"},{"spoiler":false,"text":"Alice Charlotte’s twin sister. She trusts only her older sister and rejects everyone else to an extreme degree. Her personality is the complete opposite of her sister’s, and her words and actions constantly cause her sister trouble, though she occasionally confuses her with mysterious remarks. According to her, she apparently wants to help. Alice Charlotte believes she is being abused, but it seems that other people cannot see Alice Evelyn..."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c168555"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c5c93ae1dabd337391f2278e8b6b65c66b48f7574494e75154669ade0c4c115.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/1209ad671521fd813b308f956e7b2f9c6340ca19daa73748bfc5b751b63dcad6.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c168636","characterName":"アルバート・キーツ","sourceIds":{"vndbCharacterId":"c168636"},"originalCharacterName":"アルバート・キーツ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“Did you know? There are times when you simply do not have to endure.”"},{"spoiler":false,"text":"The young butler of the Cavendish family. For generations, the Keats family has served as stewards and butlers to the Earl’s household. He is currently taking over his uncle’s duties while the uncle is bedridden. It seems he knows some major secret about the Cavendish family."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c168636"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e426603a5f0fe9dd17de44633210cae4743b18abfdb5377e45e142cf71b93fc3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82a00dc664af985ae355364068ed833949a50860257512d456657bc4693bbf1b.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c168638","characterName":"クリストファー・アーネスト・キャヴェンディッシュ","sourceIds":{"vndbCharacterId":"c168638"},"originalCharacterName":"クリストファー・アーネスト・キャヴェンディッシュ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“Maybe falling in love and going crazy are one and the same...”"},{"spoiler":false,"text":"Alice Charlotte's older brother. He is the heir to the Cavendish family. He excels at everything and is considered a promising young man. Because his parents neglect his sister, he dotes on her and cares for her more than anyone else. He is a kind-hearted young man who worries about his sister more than anyone else."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c168638"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1946dd98f68ed9df7c50e6309a9f2088c2db1b13281c27cf6504e948f31df9d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/7446b0346a602396c8b75fe82d8e4b7b6f38c430366523c15feb432203fd0cfd.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c168639","characterName":"クライド・レッドフォード","sourceIds":{"vndbCharacterId":"c168639"},"originalCharacterName":"クライド・レッドフォード","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“Because making that person happy is my own happiness.”"},{"spoiler":false,"text":"He lost his parents at a young age and lived in an orphanage, but the Earl of Cavendish recognized his talent for the piano and took him in. He currently attends the Royal Academy of Music, where he tells Alice Charlotte—who is not allowed to leave—about the world outside. He harbors a faint crush on Alice Charlotte, but so far there is absolutely no sign that she has noticed."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c168639"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7ff9152c7409c3e0f022206f2b5afc230b00e01f8689d5ca5502713472ae0ae7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27ae953bd93f3c5a87818f85a9bfd63ce1f319fd3bb81ff26b137435dc2af10c.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c168640","characterName":"オスカー・フォン・ジルベール","sourceIds":{"vndbCharacterId":"c168640"},"originalCharacterName":"オスカー・フォン・ジルベール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“If you could leave Britain and go to another country, would you want to?”"},{"spoiler":false,"text":"The Cavendish family’s personal physician and Alice Charotte’s tutor. He lives on the estate to treat the countess’s illness. His family is a fairly prominent one that has produced several skilled military doctors and physicians, but he moved from his native Germany to Britain after being involved in a certain incident in the past."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c168640"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a0d99557e43ec4db0473c0b0725038c3ddaeaea7d4dfa2c072ee31888f52a5a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/149bfd98af60fd7d53d050f026d26ed239094c37da763c976fc401fa7a9b954f.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p10645","sourceCompanyId":"egs:brand:3668","canonicalEntityId":"vndb:p10645","name":".aihen","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:17362:3668","source":"egs"},{"companyId":"vndb:p10645","sourceCompanyId":"vndb:p10645","canonicalEntityId":"vndb:p10645","name":".aihen","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:81645:v28706","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
