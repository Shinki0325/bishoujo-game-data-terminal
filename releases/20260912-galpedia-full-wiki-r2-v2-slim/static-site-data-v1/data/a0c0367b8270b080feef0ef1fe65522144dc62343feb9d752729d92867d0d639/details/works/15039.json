3150a87225c487aebbc180ce7ce060f973d86f41d8eca.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:303918:43041:5922:1","source":"bangumi"}]},{"characterId":"char_c28715","characterName":"リリア エーベルヴァイン","sourceIds":{"bangumi":[{"characterId":"94373","match":"exact-normalized-name-in-linked-work","subjectId":"80604"}],"egsCharacterIds":["26125"],"vndbCharacterId":"c28715"},"originalCharacterName":"リリア エーベルヴァイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公である“ディルク”の義妹にして、北部の辺境国ルーフェン王国の王女。"},{"spoiler":false,"text":"母親譲りの気品のある凛とした美しさと、武人としての強さも兼ね備え、近年、隣国から侵略を受けたクローヴィス戦役では勝利のきっかけとなる活躍を演じ、その美しい白衣の衣装と容姿から「白の姫騎士」と呼ばれ、先祖、聖人クリストフ・エーベルヴァインの血を最も受け継いだ聖姫とまで賞賛される稀代のお姫様。"}],"source":"egs","sourceCharacterId":"26125","sourceWorkId":"6574","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公ディルクの義妹。ルーフェンの王女。凛とした美しさと、涼やかな顔立ちの誇り高い美少女。"},{"spoiler":false,"text":"美しいその白衣の衣裳と容姿から「白の姫騎士」と謳われている。"},{"spoiler":false,"text":"戦場を駆け抜けてきたためか、男勝りなところがあり、少女に思えないくらいしっかりしている。"},{"spoiler":false,"text":"ディルクの悪い噂を知っている彼女は、彼を軽蔑しており、言い争うこともしばしばあった。"}],"source":"bangumi","sourceCharacterId":"94373"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8eab149ac898ae161d53ba834f546786e0249c76dafc67c275e3b924e10df61b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be276eafbbad7e3271c44ecfb27c6e79fd1da7efd6c2e886aa76f388284fea38.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c28716","characterName":"レイラ エーベルヴァイン","sourceIds":{"bangumi":[{"characterId":"94374","match":"exact-normalized-name-in-linked-work","subjectId":"80604"}],"egsCharacterIds":["26126"],"vndbCharacterId":"c28716"},"originalCharacterName":"レイラ エーベルヴァイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公である“ディルク”の義母にして、ルーフェンの王妃（後妻）。"},{"spoiler":false,"text":"社交界では「辺境の至宝」と絶賛されるほどの抜群のプロポーションと美貌の持ち主。"},{"spoiler":false,"text":"一見、その容姿と柔和な笑顔から、おっとりとした女性に見られがちだが、その実、芯の通った聡明な女性である。"}],"source":"egs","sourceCharacterId":"26126","sourceWorkId":"6574","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公ディルクの義母。ルーフェンの王妃（後妻）。"},{"spoiler":false,"text":"抜群のプロモーションと美しく長い金髪の持ち主で、社交界では「辺境の至宝」と謳われている。"},{"spoiler":false,"text":"容姿からはおっとりとした印象を受けるが、実は芯のとおった聡明な人である。性善説を強く信じており、悪い噂が絶えないディルクにも誠意を持って接している。"}],"source":"bangumi","sourceCharacterId":"94374"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30af8644d32dd0a9def98cf012d19fdf842103c9cbd31e31dd06f72e9c94e8e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3d0696ea4dfe9d3ce5c00c5678fa3ae5aace31266a01b607681e06f512f2173.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紫苑 みやび","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36292","source":"vndb"}]},{"characterId":"char_c5639","characterName":"アリシア・ビューストレーム","sourceIds":{"bangumi":[{"characterId":"64966","match":"exact-normalized-name-in-linked-work","subjectId":"303918"},{"characterId":"64966","match":"exact-normalized-name-in-linked-work","subjectId":"89161"}],"egsCharacterIds":["3722"],"vndbCharacterId":"c5639"},"originalCharacterName":"アリシア・ビューストレーム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Commander of the Cordelia army. Regent and Duchess of Cordelia."},{"spoiler":false,"text":"A talented woman with the beauty and charisma of a champion."},{"spoiler":false,"text":"After the assassination the Archduke and the Marquis (her father and uncle), she became the guardian of her successor and cousin, Maya Cordelia, and has since led Cordelia to become a military power with great influence on the Neo-Terras and New Solars."},{"spoiler":false,"text":"As the hero of Cordelia, she is immensely popular with her subjects, and is revered as a true warrior who is loyal to Maya, despite practically ruling the country."},{"spoiler":false,"text":"As a soldier, she serves as the Captain of Cordelia's own invented forces, the Armored Cavalry Force, and is a known as a brave general who takes command of the front line herself."},{"spoiler":false,"text":"She dotes on Maya, and supports her every way to make her a worthy Archduke. She more of a mother than a cousin."},{"spoiler":false,"text":"As a result of the battle between the Neo-Terras and the New Solar, she decided to ally with the latter. Due to this, the aura of Donny Bohgan soon comes."}],"source":"vndb","sourceCharacterId":"c5639"},{"segments":[{"spoiler":false,"text":"本作のヒロイン。"},{"spoiler":false,"text":"コーデリア軍司令長官。コーデリア公国摂政。"},{"spoiler":false,"text":"先代、イェルド・コーデリア大公の弟レイフ・ビューストレーム伯爵の娘。"},{"spoiler":false,"text":"持って生まれた王者の威風と華麗な美しさを持つ才女。"},{"spoiler":false,"text":"政治・軍事に優れ、科学技術にも造詣が深く、イェルド大公とレイフ侯爵が相次いで暗殺されると幼い後継者マヤ・コーデリアの後見人として摂政となり、それまで辺境の小国に過ぎなかったコーデリアを、ネオ・テラーズやニュー・ソラルに大きな影響を及ぼす軍事強国に導く。"},{"spoiler":false,"text":"マヤ・コーデリアを溺愛しており、彼女を立派な大公にすべくあらゆる面でサポートしている。"},{"spoiler":false,"text":"「マヤ、お前にはあまり危ないことはさせたくないのだ」"}],"source":"egs","sourceCharacterId":"3722","sourceWorkId":"14022","spoiler":false},{"segments":[{"spoiler":false,"text":"【監獄戦艦2 the-Anime】"},{"spoiler":false,"text":"コーデリア軍司令長官。コーデリア公国摂政。"},{"spoiler":false,"text":"先代、イェルド・コーデリア大公の弟レイフ・ビューストレーム伯爵の娘。"},{"spoiler":false,"text":"持って生まれた王者の威風と華麗な美しさを持つ才女。"},{"spoiler":false,"text":"政治・軍事に優れ、科学技術にも造詣が深く、イェルド大公とレイフ侯爵が相次いで暗殺されると"},{"spoiler":false,"text":"幼い後継者マヤ・コーデリアの後見人として摂政となり、"},{"spoiler":false,"text":"それまで辺境の小国に過ぎなかったコーデリアを"},{"spoiler":false,"text":"ネオ・テラーズやニュー・ソラルに大きな影響を及ぼす軍事強国に導く。"},{"spoiler":false,"text":"コーデリア勃興の英雄として臣下や国民の人気絶大で、"},{"spoiler":false,"text":"同時に実質的に国を治めながらも後継者マヤに忠義を尽くす真の武人として畏敬の念を集めている。"},{"spoiler":false,"text":"また、武人の面といえば、コーデリア独自の発明物である装甲騎部隊の隊長も務めていて、"},{"spoiler":false,"text":"自ら危険な前線に立ち指揮をふるう勇将としても知られている。"},{"spoiler":false,"text":"マヤ・コーデリアを溺愛しており、彼女を立派な大公にすべくあらゆる面でサポートしている。"},{"spoiler":false,"text":"従姉妹の姉というよりは、保護者、母親に近い風。"},{"spoiler":false,"text":"マヤが公爵位を継ぐまではと、亡き父の爵位である伯爵号を継いでいない。"}],"source":"egs","sourceCharacterId":"3722","sourceWorkId":"15039","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のヒロイン。"},{"spoiler":false,"text":"コーデリア軍司令長官。コーデリア公国摂政。"},{"spoiler":false,"text":"先代、イェルド・コーデリア大公の弟レイフ・ビューストレーム伯爵の娘。"},{"spoiler":false,"text":"持って生まれた王者の威風と華麗な美しさを持つ才女。"},{"spoiler":false,"text":"政治・軍事に優れ、科学技術にも造詣が深く、イェルド大公とレイフ侯爵が相次いで暗殺されると幼い後継者マヤ・コーデリアの後見人として摂政となり、それまで辺境の小国に過ぎなかったコーデリアをネオ・テラーズやニュー・ソラルに大きな影響を及ぼす軍事強国に導く。"},{"spoiler":false,"text":"コーデリア勃興の英雄として臣下や国民の人気絶大で、同時に実質的に国を治めながらも後継者マヤに忠義を尽くす真の武人として畏敬の念を集めている。"},{"spoiler":false,"text":"また、武人の面といえば、コーデリア独自の発明物である装甲騎部隊の隊長も務めていて、自ら危険な前線に立ち指揮をふるう勇将としても知られている。"},{"spoiler":false,"text":"マヤ・コーデリアを溺愛しており、彼女を立派な大公にすべくあらゆる面でサポートしている。"},{"spoiler":false,"text":"「マヤ、お前にはあまり危ないことはさせたくないのだ」"}],"source":"egs","sourceCharacterId":"3722","sourceWorkId":"19714","spoiler":false},{"segments":[{"spoiler":false,"text":"コーデリア軍司令長官。コーデリア公国摂政。"},{"spoiler":false,"text":"先代 イェルド・コーデリア大公の弟 レイフ・ビューストレーム伯爵の娘。"},{"spoiler":false,"text":"持って生まれた王者の威風と華麗な美しさを持つ才女。政治・軍事に優れ、科学技術にも造詣が深く、イェルド大公とレイフ侯爵が相次いで暗殺されると幼い後継者 マヤ・コーデリアの後見人として摂政となり、それまで辺境の小国に過ぎなかったコーデリアをネオ・テラーズやニュー・ソラルに大きな影響を及ぼす軍事強国に導く。"},{"spoiler":false,"text":"コーデリア勃興の英雄として臣下や国民の人気は絶大で、同時に実質的に国を治めながらも後継者マヤに忠義を尽くす真の武人として畏敬の念を集めている。"},{"spoiler":false,"text":"また武人としての面では、コーデリア独自の発明兵器である装甲騎部隊の隊長も務めていて、自ら危険な前線に立ち指揮を執る勇将としても知られている。"},{"spoiler":false,"text":"マヤ・コーデリアを溺愛しており、彼女を立派な大公にすべくあらゆる面でサポートしている。従姉妹の姉というよりは、保護者、母親に近い風。"},{"spoiler":false,"text":"マヤが公爵位を継ぐまではと、亡き父の爵位である伯爵号を継いでいない。"},{"spoiler":false,"text":"ネオ・テラーズとニュー・ソラルの苛烈な勧誘合戦の結果、ニュー・ソラルにつくことを決意、ニュー・ソラルとの同盟を進める中で、ディノ・ディラッソの魔の手が迫る。"},{"spoiler":false,"text":"「ネオ・テラーズの俗物どもめ。 コーデリアがニュー・ソラルにつくと見て強硬な手段にでたのであろうが……装甲騎の準備は出来ているか？」"}],"source":"bangumi","sourceCharacterId":"64966"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59c3d9b22e6b997416ca8d8b7bb8617ad9658b95c7422ea5e9af134d9e91a87c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53d67aee64cd001350e5df658660955413008c9d01e61679b9c89fa8bcffbeff.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ももぞの 薫","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:36290","source":"vndb"}]},{"characterId":"char_c5680","characterName":"マヤ・コーデリア","sourceIds":{"bangumi":[{"characterId":"64967","match":"exact-normalized-name-in-linked-work","subjectId":"303918"},{"characterId":"64967","match":"exact-normalized-name-in-linked-work","subjectId":"89161"}],"egsCharacterIds":["3723"],"vndbCharacterId":"c5680"},"originalCharacterName":"マヤ・コーデリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daughter of the former Archduke of Cordelia, as her fathers only child, she will become the new leader one day."},{"spoiler":false,"text":"Like Alicia, she is popular among her subjects. Protected by Alicia, she learns less about the empire then her cousin does."},{"spoiler":false,"text":"A genius and hard-worker, Alicia is dependent on her in the future."},{"spoiler":false,"text":"Due to being spoiled by Alicia, she seems to be naive, and lacks the general knowledge of the commoners."},{"spoiler":false,"text":"She is sometimes compared to Alicia, but doesn't feel envious due to how kind Alicia is to her."},{"spoiler":false,"text":"In fact, she tries her hardest to please her in order to be recognized as something to her idol."},{"spoiler":false,"text":"A beautiful girl, thought not as much as Alicia, but nevertheless full of charisma, intelligence and youth."}],"source":"vndb","sourceCharacterId":"c5680"},{"segments":[{"spoiler":false,"text":"本作のヒロイン。"},{"spoiler":false,"text":"先代、イェルド・コーデリア大公の娘。イェルドにはマヤしか子がなく、成人すればコーデリア大公を継ぐことになる。"},{"spoiler":false,"text":"アリシア同様、臣下国民に絶大な人気のある姫君。"},{"spoiler":false,"text":"後見人となったアリシアに守られながら、彼女より帝王学を学んでいる。"},{"spoiler":false,"text":"天才肌で努力家、アリシアからその将来を嘱望されている。"},{"spoiler":false,"text":"ややアリシアの溺愛のせいで箱入り娘の感があり、所謂、庶民の常識に欠ける部分がある。"},{"spoiler":false,"text":"アリシアと何かと比べられる事があるが、アリシアがあまりに優秀すぎるので本人はプレッシャーとは感じていない。"},{"spoiler":false,"text":"それよりも尊敬するアリシアに一つでも何かを認められたいと何事にも一生懸命努力している。"},{"spoiler":false,"text":"アリシアほどではないが王者の威風と、知性と若いエネルギーに満ちた美少女。"},{"spoiler":false,"text":"「大げさですよ。瞼を斬っただけです。ですが次は眼球を切り裂きますよ」"}],"source":"egs","sourceCharacterId":"3723","sourceWorkId":"14022","spoiler":false},{"segments":[{"spoiler":false,"text":"【監獄戦艦2 the-Anime】"},{"spoiler":false,"text":"先代、イェルド・コーデリア大公の娘。"},{"spoiler":false,"text":"イェルドにはマヤしか子がなく、成人すればコーデリア大公を継ぐことになる。"},{"spoiler":false,"text":"アリシア同様、臣下国民に絶大な人気のある姫君。"},{"spoiler":false,"text":"後見人となったアリシアに守られながら、彼女より帝王学を学んでいる。"},{"spoiler"