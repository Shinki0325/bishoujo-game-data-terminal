tatus":"auto-confirmed","relationId":"egs:work-creator:19607","source":"egs"},{"creditedName":"yozuca*","creatorId":"vndb:s612","sourcePersonId":"vndb:s612","canonicalEntityId":"vndb:s612","name":"yozuca*","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:148569","source":"vndb"},{"creditedName":"meg rock","creatorId":"vndb:s16348","sourcePersonId":"vndb:s16348","canonicalEntityId":"vndb:s16348","name":"日向 めぐみ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:148574","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c73416","characterName":"高橋 絵里子","sourceIds":{"vndbCharacterId":"c73416"},"originalCharacterName":"高橋 絵里子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The happy-go-lucky main character of the story, Eriko gets good grades but is nevertheless quite clumsy and not at all athletically coordinated (unless it is to escape the many perverts who often cross her path). She tends to be the main victim of the perverted actions (accidental or not) of Odagiri, though she occasionally uses this to blackmail him. Described a few times as \"A nosy busybody\", Eriko tends to go out of her way to find out people's problems. She's also quite fickle. Eriko is frightened of injections."}],"source":"vndb","sourceCharacterId":"c73416"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3bd5863d614fcde7116717cf3f9427613c4860c8fb4ef36b620bdece2c30c907.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90445f160bc48543ec099526af599e7ae194c2b19008e7bfe17891bd44053908.webp","width":212,"height":256,"source":"static-detail"},"actors":[{"creditedName":"生天目 仁美","creatorId":"vndb:s270","sourcePersonId":"vndb:s270","canonicalEntityId":"vndb:s270","name":"生天目 仁美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:77641","source":"vndb"}]},{"characterId":"char_vndb_c73417","characterName":"鈴木 由真","sourceIds":{"vndbCharacterId":"c73417"},"originalCharacterName":"鈴木 由真","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Eriko's friend since middle-school. The two got off to a bad start, but found they had interests in common. Yuma has dyed blonde hair. Yuma has made a career of being the school's best cheater, although she still gets bad grades. She has a younger sister, Momoka. Yuma often pairs up with Eriko, such as in Episode 2 and Episode 7. She is the most short-tempered of the group. Her bunches are something of a trademark, as Odagiri didn't recognize her from behind when she wore it in a bun. She tends to lack in prudence, and ever willing to have fun."}],"source":"vndb","sourceCharacterId":"c73417"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/5324792292cac4afb07e4b5a7fee36318f2c1da3a15b4f724a2242594c86740e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90140a42babe65a33d8aab8ef686a49c73d847e69b50274093694183a61c8056.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅野 真澄","creatorId":"vndb:s1146","sourcePersonId":"vndb:s1146","canonicalEntityId":"vndb:s1146","name":"浅野 真澄","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:77644","source":"vndb"}]},{"characterId":"char_vndb_c73418","characterName":"佐藤 綾乃","sourceIds":{"vndbCharacterId":"c73418"},"originalCharacterName":"佐藤 綾乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuma's life-long friend. They are very close. Ayano is the ingenue of the group. She wears glasses and her hair in plaits, implying an innocent personality, though she has a vivid imagination which often leads to perverted fantasies (as hinted in her eyecatch). By far the most dim-witted of the group, but out of all the main characters, she is the only one with a steady boyfriend (Takanori Shimotakatani). She often is victim to getting hit by the others for PDA's."}],"source":"vndb","sourceCharacterId":"c73418"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2ef8aaa69fdae8dfc64974d5446b67b68e5ab9e477cc27326885f53452d978ea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/147753e606c25d199841e39a9495aac0dbceea53545224ae3fe8d7a5ed541972.webp","width":212,"height":256,"source":"static-detail"},"actors":[{"creditedName":"能登 麻美子","creatorId":"vndb:s468","sourcePersonId":"vndb:s468","canonicalEntityId":"vndb:s468","name":"能登 麻美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:77642","source":"vndb"}]},{"characterId":"char_vndb_c73419","characterName":"香田 あかり","sourceIds":{"vndbCharacterId":"c73419"},"originalCharacterName":"香田 あかり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A very rich girl (as seen in her designer accessories from Gucci, Cartier and Prada), Akari is at first a rival to Eriko's group, but she quickly becomes friends with them after they brag about going to school with boys. An \"insider\" (a girl who transfers from the junior high branch of the private school rather than passing an entrance exam, like Eriko and friends did, to get in) who uses her knowledge of the school ways to show the others the ropes. Kouda aspires to become a famous actress, using all of her energy to be as outrageous as possible, so as to leave a lasting impression. She has the habit of dressing in completely bizarre outfits to gain attention, only to change into more normal clothes a split second later."}],"source":"vndb","sourceCharacterId":"c73419"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/655eb9ae79423847b141059849d52f519f158c46c5657555c417f69aa36f134f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/66bb911b22c6aa462f85cc25fdaf525dc6f0c0a703422ecbdcdd4bf6cca3ea30.webp","width":219,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雪野 五月","creatorId":"vndb:s474","sourcePersonId":"vndb:s474","canonicalEntityId":"vndb:s474","name":"ゆきの さつき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:77643","source":"vndb"}]},{"characterId":"char_vndb_c73420","characterName":"姫路 京子","sourceIds":{"vndbCharacterId":"c73420"},"originalCharacterName":"姫路 京子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A friend of Akari's who is the first person that the girls know in their age group who loses her virginity. She is assumed part of Eriko's \"Moron Group\" much to her chagrin. Himeji is often flippant in her sex life, letting guys get the better of her, since she is easily tempted. She used to be overweight, but her crush on Odagiri gave her the incentive to lose weight. She is the most protective of Ogawa, and has the largest breasts, much to Kouda's chagrin."}],"source":"vndb","sourceCharacterId":"c73420"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c96ffc464c6340b4f49f5bee8f6f31ef101e4c1dad77cf88e60a6e2e5058c85d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8048f642a06a744c2b81ae93ac6e3cf08fb57ce919e2376a5898e4b725e29dc.webp","width":225,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷上 恭子","creatorId":"vndb:s1590","sourcePersonId":"vndb:s1590","canonicalEntityId":"vndb:s1590","name":"氷上 恭子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:77645","source":"vndb"}]},{"characterId":"char_vndb_c73421","characterName":"小川 育恵","sourceIds":{"vndbCharacterId":"c73421"},"originalCharacterName":"小川 育恵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A close friend of Kyoko's, which makes her a member of the group by default. She is the cute, petite girl of the group who acts as young as she looks. ikue usually comes up with the stupidest, almost Mr. Bean-ish solutions (giving Eriko a \"mini sleeping pill\" to help her relax because she had been up all night watching Doraemon videos) and games (spilling floor wax and using the cloth to slide on). She loves candy and is very fond of sleeping. She calls Kyoko 'Hime-chan' and appears fond of her. Ikue is the daughter of a drugstore's owner."}],"source":"vndb","sourceCharacterId":"c73421"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.d