ン","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:161051:v2310","source":"vndb"},{"companyId":"vndb:p430","sourceCompanyId":"vndb:p430","canonicalEntityId":"vndb:p430","name":"リキッド","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:161052:v2310","source":"vndb"},{"companyId":"vndb:p430","sourceCompanyId":"vndb:p430","canonicalEntityId":"vndb:p430","name":"リキッド","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:25448:v2310","source":"vndb"},{"companyId":"vndb:p430","sourceCompanyId":"vndb:p430","canonicalEntityId":"vndb:p430","name":"リキッド","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:25695:v2310","source":"vndb"},{"companyId":"vndb:p430","sourceCompanyId":"vndb:p430","canonicalEntityId":"vndb:p430","name":"リキッド","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:5415:v2310","source":"vndb"},{"companyId":"vndb:p430","sourceCompanyId":"vndb:p430","canonicalEntityId":"vndb:p430","name":"リキッド","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:5416:v2310","source":"vndb"},{"companyId":"vndb:p840","sourceCompanyId":"vndb:p840","canonicalEntityId":"vndb:p840","name":"My Treasure","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:5417:v2310","source":"vndb"},{"companyId":"vndb:p840","sourceCompanyId":"vndb:p840","canonicalEntityId":"vndb:p840","name":"My Treasure","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:5418:v2310","source":"vndb"},{"companyId":"vndb:p430","sourceCompanyId":"vndb:p430","canonicalEntityId":"vndb:p430","name":"リキッド","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:70752:v2310","source":"vndb"}],"missingStates":[],"source":"terminal-w