力","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:280628","source":"egs"},{"creditedName":"森金","creatorId":"egs:creator:41086","sourcePersonId":"egs:creator:41086","canonicalEntityId":"egs:creator:41086","name":"森金","detail":"CG協力","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:280629","source":"egs"},{"creditedName":"Liquid","creatorId":"egs:creator:40794","sourcePersonId":"egs:creator:40794","canonicalEntityId":"egs:creator:40794","name":"Liquid","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:280630","source":"egs"},{"creditedName":"栗栖","creatorId":"vndb:s720","sourcePersonId":"egs:creator:2594","canonicalEntityId":"vndb:s720","name":"栗栖","detail":"スペシャルサンクス","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:280631","source":"egs"},{"creditedName":"二ノ舞ひかり","creatorId":"egs:creator:41090","sourcePersonId":"egs:creator:41090","canonicalEntityId":"egs:creator:41090","name":"二ノ舞ひかり","detail":"スペシャルサンクス","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:280632","source":"egs"},{"creditedName":"シュタイナー･篠塚","creatorId":"egs:creator:41089","sourcePersonId":"egs:creator:41089","canonicalEntityId":"egs:creator:41089","name":"シュタイナー･篠塚","detail":"スペシャルサンクス","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:280633","source":"egs"},{"creditedName":"パットン軍曹","creatorId":"egs:creator:27543","sourcePersonId":"egs:creator:27543","canonicalEntityId":"egs:creator:27543","name":"パットン軍曹","detail":"スペシャルサンクス","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:280634","source":"egs"},{"creditedName":"阪本海老人","creatorId":"vndb:s15636","sourcePersonId":"egs:creator:19273","canonicalEntityId":"vndb:s15636","name":"阪本海老人","detail":"スペシャルサンクス","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:280635","source":"egs"}]},"cast":[{"characterId":"char_c71270","characterName":"ニーナ・マクネリ","sourceIds":{"bangumi":[{"characterId":"92976","match":"exact-normalized-name-in-linked-work","subjectId":"225088"}],"egsCharacterIds":["13839"],"vndbCharacterId":"c71270"},"originalCharacterName":"ニーナ・マクネリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"反政府ゲリラの一員として、政府と戦い続ける少女。"},{"spoiler":false,"text":"貧困に喘ぐ国民を蔑ろにする政府を憎み、正義感が強いがため、ゲリラに加担。"},{"spoiler":false,"text":"強硬派であり、政府軍に対して積極的な攻勢を主張する。"},{"spoiler":false,"text":"性格は男勝りで、口より先に手が出るタイプ。"}],"source":"egs","sourceCharacterId":"13839","sourceWorkId":"4208","spoiler":false},{"segments":[{"spoiler":false,"text":"頭の回転がよくすばしこいので、伝令をすることが多い。キツい性格で、主人公のことを見下している。"},{"spoiler":false,"text":"銃火器は一通り扱えてゲリラ戦では突撃隊長のような役割を果たす。正義感に燃えていて国軍の悪と闘うのだと心に決めている。主人公は女への目つきが嫌らしいので毛嫌いしている。本人はテキパキと動いてまわりへの面倒見もいい姉御肌、勇敢で、仲間からの信頼も厚い人物。ただし汚れたタイプの人間が嫌いで主人公に対しても嫌悪感を持っている。"}],"source":"bangumi","sourceCharacterId":"92976"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efc4fefe686b1989834468fe05b369aab446a45776b69a6f3aff93c895bbf982.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/2048a379f7e222be8b05643eab36259c46bc6f8c18a525e4fff3173d5ce5b847.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225088:92976:6409:1","source":"bangumi"}]},{"characterId":"char_c71271","characterName":"グレイス・オクリョ","sourceIds":{"bangumi":[{"characterId":"92977","match":"exact-normalized-name-in-linked-work","subjectId":"225088"}],"egsCharacterIds":["13840"],"vndbCharacterId":"c71271"},"originalCharacterName":"グレイス・オクリョ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"父親の後を継いで反政府ゲリラの指導者となった少女。"},{"spoiler":false,"text":"しかしながら、彼女自身は温厚な理想主義者。"},{"spoiler":false,"text":"目的のためなら手段を選ばず、汚いことでもなんでもやる、といった貪欲さもなければ、冷酷な判断も下させない。"},{"spoiler":false,"text":"あくまでも殉死した父親の威光があったがために、周囲から祀り上げられただけで、本人は純朴で庶民的な感覚の持ち主。"},{"spoiler":false,"text":"現在の地位に就いてしまったことに、今も尚、戸惑いを感じている。"}],"source":"egs","sourceCharacterId":"13840","sourceWorkId":"4208","spoiler":false},{"segments":[{"spoiler":false,"text":"戦死したゲリラの指導者の娘で、現在はゲリラのシンボル的存在。根は平和的で純真な性格。"},{"spoiler":false,"text":"温厚な理想主義者で冷酷な判断ができない。また汚職や賄賂などの工作もできない。平和を誠実に求める気持ちはあり、ゲリラの理想を体現しようとすることに努力もしているので指導者として部下からのある程度の信望を得ているのではあるが、悪いことをしてでも力を得て自らの目的を達成しようとはしないし、目的があったとしてもそれに至る手段を選んでしまうタイプなので、今ひとつ迫力のある指導者にはなれない。そもそも本人が指導者的役割についているのは戦死した父の威光があったため、周囲からまつりあげられたというのが実情で、本人は指導者になりたかったわけでもなく、きわめて純朴で庶民的な感覚を有しており、いつの間にか今の地位に就いてしまったことに戸惑いも感じている。"}],"source":"bangumi","sourceCharacterId":"92977"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a75f201d1dd922af693fe3738efa739da0914ce75d90dd3d046251c7cc57702.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/669e11ae667ad41f457f4273b739140aa8cf198d9556164685150e26d3b523e4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉田愛理","creatorId":"vndb:s757","sourcePersonId":"vndb:s757","canonicalEntityId":"vndb:s757","name":"如月葵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225088:92977:6037:1","source":"bangumi"}]},{"characterId":"char_c71272","characterName":"マティルダ・マンリーク","sourceIds":{"bangumi":[{"characterId":"92981","match":"exact-normalized-name-in-linked-work","subjectId":"225088"}],"egsCharacterIds":["13842"],"vndbCharacterId":"c71272"},"originalCharacterName":"マティルダ・マンリーク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"政府軍に属する女性将校。"},{"spoiler":false,"text":"生真面目な性格で、任務に忠実であり、規律にも厳しい。"},{"spoiler":false,"text":"彼女自身も時の政府の腐敗を肌で感じており、内部から国政を立て直そうと自分の権限をフルに活用し、法と秩序を広めようと奔走している。"},{"spoiler":false,"text":"ゲリラの主張に対しても共感できる部分はあるものの、政府の責任だからといって無差別な破壊工作や殺人等を犯す行為を許すわけにはいかない、と思っている。"}],"source":"egs","sourceCharacterId":"13842","sourceWorkId":"4208","spoiler":false},{"segments":[{"spoiler":false,"text":"生真面目な軍人で、軍なりの正義というものを尊重している。"},{"spoiler":false,"text":"国政が乱れきっていて、国軍も職務を外れて利権を漁る人間達がうようよしていることも承知しているが、このような国情だからこそ自分が範を示して市民を守り、国政を立て直さなければならないと考えている。ゲリラ達が国政の枠組みから外れたところで国を立て直そうと反政府闘争を繰り広げているとすれば、彼女は内部から国軍を立ち直らせようとしている。他の役人や軍人達が、賄賂を渡してくる人間から順番に優遇し、賄賂を渡さない人間には法令と武力を後ろ盾に圧力をかけるようなやり方をして自分の懐を暖めているのに対し、彼女は公正無私の態度で、自分の権限を使い、法と秩序を広めようとしている。反政府ゲリラに対しては、政府は腐敗しているという彼らの主張に対しては同感ではあるのだが、それにしても破壊工作や殺人などの反秩序の行動を取ることが正当化されるわけではないと考えている。"}],"source":"bangumi","sourceCharacterId":"92981"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6ba4320f4d8e829bc1fa7823efa073dfd476b0052772c7f3569e58b68459e35.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/206d85511d22d1f8b80ddb282e66aa23392334d928d988ae1cfa2e50046198e7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤雅美","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225088:92981:13773:1","source":"bangumi"}]},{"characterId":"char_c71273","characterName":"イリス・マーチン","sourceIds":{"bangumi":[{"characterId":"92979","match":"exact-normalized-name-in-linked-work","subjectId":"225088"}],"egsCharacterIds":["13843"],"vndbCharacterId":"c71273"},"originalCharacterName":"イリス・マーチン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公がゲリラを裏切り加担することになる会社の社長令嬢にして社長秘書。"},{"spoiler":false,"text":"計算高く、有能、知的だが、目的のためなら情け容赦なく、手段も選ばない冷酷な性格。"},{"spoiler":false,"text":"利益第一主義で、権力志向も強く、プライドも高い。"},{"spoiler":false,"text":"人間関係の損得勘定のみで構築し、人間味も薄い。"},{"spoiler":false,"text":"この政府と反政府ゲリラとの内戦についても、利益を得るための一つの材料としか思っていない。"}],"source":"egs","sourceCharacterId":"13843","sourceWorkId":"4208","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の所属する会社の社長秘書。"},{"spoiler":false,"text":"理知的というか怜悧というか、冷たい性格。主人公のことも直轄でない部下として評価。あまり人情があるわけでなく、人を能力だけで見つめる感じ。人間関係も損得勘定だけ計算して構築していく。同情などは一切しない。自分の利益を最大限確保する方策を考える。かなりの権力志向者。所属する会社に対しては忠実に職務を遂行しているが、それについても会社や社長に対して絶対的な忠誠を誓っているからではなく、そのように行動している方が自分の利得を確保できるため。そのために大規模な利権を奪える機会があれば、躊躇無く会社を裏切り、今までの上司や同僚を裏切って巨額の財産を手中に収める。かなり計算高く度胸やプライドもあり、有能で知的だが冷酷で、手段を選ばずいざという時は情け容赦ない行動を平気で取る。そんな彼女から見て国軍とゲリラの戦いは思想などの価値は一切なく、ただ利益を最大限に得るためにこの混乱した国内の情勢をどう利用するかという材料にしかなっていない。"}],"source":"bangumi","sourceCharacterId":"92979"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fd800fcf09709fa7653428cf1098518f77438d916bb3c566e3426469800e9e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/320777d518fdd4c54f9321df2f30e4ed682c900c0129661b129d19a1a6dbf84f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"カンザキカナリ","creatorId":"vndb:s1000","sourcePersonId":"vndb:s1000","canonicalEntityId":"vndb:s1000","name":"カンザキ カナリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225088:92979:24747:1","source":"bangumi"},{"creditedName":"東十条 明日香","creatorId":"vndb:s1016","sourcePersonId":"vndb:s1016","canonicalEntityId":"vndb:s1016","name":"北条 明日香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:17909","source":"vndb"}]},{"characterId":"char_c71277","characterName":"アリシア・トレドス","sourceIds":{"bangumi":[{"characterId":"92980","match":"exact-normalized-name-in-linked-work","subjectId":"225088"}],"egsCharacterIds":["13841"],"vndbCharacterId":"c71277"},"originalCharacterName":"アリシア・トレドス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ゲリラ活動の拠点の一つとして利用している教会のシスター。"},{"spoiler":false,"text":"ゲリラの兵士達の精神的な支柱。"},{"spoiler":false,"text":"政治的な情勢も、またゲリラ内部の事情についても、それなりに熟知しているが、そうしたことについて自ら言及し、意見表明することはなく、あくまでも神の教えの代弁者として、愛と忍耐について兵士達に説いている。"},{"spoiler":false,"text":"脅迫、金銭の搾取、無差別な破壊工作、無関係の市民を巻き込むこと等、大義を失うようなゲリラ活動を好ましく思ってなく、強硬に抵抗する。"}],"source":"egs","sourceCharacterId":"13841","sourceWorkId":"4208","spoiler":false},{"segments":[{"spoiler":false,"text":"教会のシスター。愛と忍耐について説く、ゲリラの兵士達の精神的支柱。"},{"spoiler":false,"text":"内面での宗教的な理想はかなり高く持っているのだが、あまりそれを表には出さず、表面的には穏やかに周囲の人々に教えを説く。政治的な情勢についてはある程度承知していて、ゲリラ内部の派閥争いの事情についてはもしかするとグレイスよりも鋭敏に察しているかもしれないが、そのようなことに関わったり意見を表明することは避けている。自分の使命は組織の末端にいる兵士や協力者達に理念の道を指し示すことだと考えている。神を信じて正義をおこなえば、必ず報われると。ただし理想の道を言葉にして説教することは少なく、あくまでもその信念は自分の心の中に固く秘めている。周囲の人間に対しては、平和と正義と仲間を愛すること、自分のおこないを正しくすること、どのような苦難にもくじけないことを、穏やかに諭し、励ますのみである。大義を失うようなゲリラ活動には反対で、脅迫、金銭の搾取、無差別な破壊工作、無関係の市民を巻き込むことなどには強く抵抗を示す。"}],"source":"bangumi","sourceCharacterId":"92980"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07d37e52cee67d7d390e2a748dbd3eb51f436fb5742f9d2da67c379a561c8185.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87df2a1cc5fba94fd1f0f698f180ebe8bfc759125eb5ccc7ef100c3f0a32df2d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田佳代","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225088:92980:6038:1","source":"bangumi"}]},{"characterId":"char_c71278","characterName":"アンナ・テレーズ","sourceIds":{"bangumi":[{"characterId":"92982","match":"exact-normalized-name-in-linked-work","subjectId":"225088"}],"egsCharacterIds":["13844"],"vndbCharacterId":"c71278"},"originalCharacterName":"アンナ・テレーズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"料理屋を一人で切り盛りする、明るい笑顔が魅力的な少女。"},{"spoiler":false,"text":"父親を内戦で失っており、現政府をあまり快く思っていない。"},{"spoiler":false,"text":"そのため、ゲリラの正式なメンバーではないが、連絡員としてゲリラに協力している。"},{"spoiler":false,"text":"それ故、彼女には悲惨な運命が……。"}],"source":"egs","sourceCharacterId":"13844","sourceWorkId":"4208","spoiler":false},{"segments":[{"spoiler":false,"text":"真っ先に凌辱対象になるかわいそーな娘。 明るい性格で料理屋に来店する客に対して愛想良く対応する看板娘。"},{"spoiler":false,"text":"ウェイトレスらしいかわいらしい制服を着ている。笑顔で応対。だが主人公からはストーカー的につきまとわれているので毛嫌いしている。一応ゲリラの仲間で、主人公との連絡員になるよう命令されているので任務上の話はするが、それ以外の話は一切したがらない。"}],"source":"bangumi","sourceCharacterId":"92982"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd11566f8b372affbec661e552f54e45c6b7bf92fe1aba466cdcd9fd75552b51.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/8296d08b915d923babf21c2179655811d0176aa256a701c73510e067d3854ccf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"カンザキカナリ","creatorId":"vndb:s1000","sourcePersonId":"vndb:s1000","canonicalEntityId":"vndb:s1000","name":"カンザキ カナリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225088:92982:24747:1","source":"bangumi"}]},{"characterId":"char_c71279","characterName":"ミスティ・オニール","sourceIds":{"bangumi":[{"characterId":"92978","match":"exact-normalized-name-in-linked-work","subjectId":"225088"}],"egsCharacterIds":["13845"],"vndbCharacterId":"c71279"},"originalCharacterName":"ミスティ・オニール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"政府側の従軍看護婦。"},{"spoiler":false,"text":"しかし、政府軍の横暴な実態を目の当たりにしたことから、ゲリラ側に寝返り、政府軍の内情を伝えるスパイとして暗躍している。"},{"spoiler":false,"text":"彼女自身は政治情勢を熟知しているわけではなく、またゲリラ側の権力闘争にもまるで関心がないため、ただ自分のやるべきことをやっている。"},{"spoiler":false,"text":"しかし、それが本当に正しいかどうかも彼女自身も漠然としており、わかっていない。"}],"source":"egs","sourceCharacterId":"13845","sourceWorkId":"4208","spoiler":false},{"segments":[{"spoiler":false,"text":"温厚な性格で、人を疑うことをよしとしないため、騙されやすい。 あまり政治的な事情を承知しないまま国軍に入隊し、医官になったが、その後国軍の横暴な内面を見てその実態に疑問を抱くようになり、ゲリラの仲間になる。ゲリラのネットワークにつながるようになっても国軍を退役したわけではないので、ゲリラのスパイとして国軍の内情を伝えるスパイとなる。その他、国軍の物資の横流しもしている。医療技術もあり、物資の供給源や国軍の情報源として、ゲリラの仲間の中では比較的重要な働きをしているのではあるが、彼女自身は国内の政治情勢を熟知しているわけでもなく、ゲリラの派閥の内情や国軍内部の権力闘争などにも関心がなく、極めてのほほんと自分自身の職務を遂行している。主体的にゲリラ活動での戦略を立案しようとか、そういうことは一切やらずに、ただ協力を求められた時にそれに応じているだけ。本人自身も、今の国のあり方は間違っているとは思っているが、それならばそれをどうやって正しい方向に持って行こうかというプランは全く持っていない。"}],"source":"bangumi","sourceCharacterId":"92978"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cdd2ad427525a5380b3ec2ee59e8f8c66ce9bbe00f2ce2eef0035ece05b7faee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52192c7083457c597b066b92fb7fe5f5baf86d5aba54ac40b432ceee3f1fb090.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞希早苗","creatorId":"vndb:s3359","sourcePersonId":"vndb:s3359","canonicalEntityId":"vndb:s3359","name":"瑞希早苗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225088:92978:86410:1","source":"bangumi"}]},{"characterId":"char_vndb_c71274","characterName":"ハリス・マクネリ","sourceIds":{"vndbCharacterId":"c71274"},"originalCharacterName":"ハリス・マクネリ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e07558741ccbb408d4d9588a01232fbd19a5fb4e769de683040f7b8438c39f53.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f36e4dd236b7beb75ee57cfbb85918db6f2de1b1406242e18553314d112279f.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c71275","characterName":"ギリルモ・ロレンゾ","sourceIds":{"vndbCharacterId":"c71275"},"originalCharacterName":"ギリルモ・ロレンゾ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d4947cac2fe4ab054dbd84de9d4d28cede150892819dcd1be84113d1494c0ab.webp","fallbackUrl":"https://wiki-ass