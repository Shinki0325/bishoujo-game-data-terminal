、性質の悪いことにそれを利用して主人公をこき使って いる。女子学生相手に、性の悩みの秘密の相談を受け持っているらしい。"}],"source":"bangumi","sourceCharacterId":"149086"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3bf3ed3d6cba47a5102b51a5e524504ccb4dbc04f864af5b2033005dd5a8f28f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/5056ebd941f0c2fef51aa610d8a4f4bdf3cd77c22f4a54ab7df09ca0279903d9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"悠","creatorId":"vndb:s1702","sourcePersonId":"vndb:s1702","canonicalEntityId":"vndb:s1702","name":"悠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43367","source":"vndb"}]},{"characterId":"char_c2651","characterName":"星川 千里","sourceIds":{"bangumi":[{"characterId":"149084","match":"exact-normalized-name-in-linked-work","subjectId":"230353"}],"egsCharacterIds":["27238"],"vndbCharacterId":"c2651"},"originalCharacterName":"星川 千里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の友人で、かつてのクラスメイト。"},{"spoiler":false,"text":"背も低く、童顔で子供っぽく、クラスのマスコット的な存在。"},{"spoiler":false,"text":"無邪気で明るく、人懐っこい性格で、大の世話好きだが、おっちょこちょいで不器用なところがあり、失敗することもしばしば。"},{"spoiler":false,"text":"天文部に所属し、部室では部活そっちのけで大好きなお菓子を食べている。"}],"source":"egs","sourceCharacterId":"27238","sourceWorkId":"2946","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の友人。以前のクラスメート。"},{"spoiler":false,"text":"背の高さも体つきも顔だちも幼いが、本人はかなり、それを気にしている。それでも明るく人懐っこく、あちこちのクラスに行っては、友達と笑顔で話しこんでい る。天文部に所属しており、部室でお菓子を食べていることが多い。"}],"source":"bangumi","sourceCharacterId":"149084"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75d467b8c75ae786f01fed73527a379598b6e11cdb7c50422f94e154ee7e91cd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3ac25c6498604adb6afc6398b0e80759df9134d98df7d46f075a3a112da7533a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤邑子","creatorId":"vndb:s833","sourcePersonId":"vndb:s833","canonicalEntityId":"vndb:s833","name":"後藤邑子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230353:149084:4514:1","source":"bangumi"},{"creditedName":"こむら 菜々","creatorId":"vndb:s4822","sourcePersonId":"vndb:s4822","canonicalEntityId":"vndb:s4822","name":"こむら 菜々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43370","source":"vndb"}]},{"characterId":"char_c2652","characterName":"高岡 椿","sourceIds":{"bangumi":[{"characterId":"149083","match":"exact-normalized-name-in-linked-work","subjectId":"230353"}],"egsCharacterIds":["27237"],"vndbCharacterId":"c2652"},"originalCharacterName":"高岡 椿","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。"},{"spoiler":false,"text":"明朗快活で、男勝りな性格。"},{"spoiler":false,"text":"粗暴なところがあり、口より先に手が出るタイプだが、気さくで面倒見がよく、クラスメイトから信頼されており、クラス委員長を務めている。"},{"spoiler":false,"text":"あまり恋愛沙汰には疎いようで、彼女の浮いた話は聞かない。"},{"spoiler":false,"text":"所属する剣道部では、かなり期待されているようだ。"}],"source":"egs","sourceCharacterId":"27237","sourceWorkId":"2946","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメートで委員長をしている。"},{"spoiler":false,"text":"快活な性格で面倒見もよく、所属している剣道部では期待されている。"},{"spoiler":false,"text":"恋愛沙汰には疎いようで、そんな噂が流れたこともない。竹刀を持ち歩いており、口と同時に手が出ることで有名。"}],"source":"bangumi","sourceCharacterId":"149083"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b665c580698d3e2fda26b156acc54d8d377d2c3c7f67442882078d213c006da7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3facafda8d2cd4cb5f4e8febb7fb098700a3901cd916cbfd7f3f3c95a05ec26a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"坂田有希","creatorId":"vndb:s1595","sourcePersonId":"vndb:s1595","canonicalEntityId":"vndb:s1595","name":"坂田 有希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230353:149083:15687:1","source":"bangumi"}]},{"characterId":"char_c2653","characterName":"鳴海 さやか","sourceIds":{"bangumi":[{"characterId":"149082","match":"exact-normalized-name-in-linked-work","subjectId":"230353"}],"egsCharacterIds":["27236"],"vndbCharacterId":"c2653"},"originalCharacterName":"鳴海 さやか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。良家のお嬢様。"},{"spoiler":false,"text":"物静かで優しく、何処か他人を安心させるような温か味のある女の子。"},{"spoiler":false,"text":"容姿端麗で成績優秀の優等生で、男女問わず人気がある。"},{"spoiler":false,"text":"男子から高根の花と思われていることから、交際中の男性はいないらしい。"},{"spoiler":false,"text":"運動はあまり得意ではないが、水泳部に所属し、頑張っている。"}],"source":"egs","sourceCharacterId":"27236","sourceWorkId":"2946","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメートで男女ともに人気のある女の子。"},{"spoiler":false,"text":"どこか他人を安心させる雰囲気をもつ美少女で、生まれも育ちもお嬢様。高嶺の花と思 っている男子学生は多く、付き合ってる男はいないようだ。運動はあまり得意ではないが、一応、水泳部に所属している。"}],"source":"bangumi","sourceCharacterId":"149082"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbffca7e4e92c5ab93e35fd5859c5d25f9765460be07650065053cd097603246.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4ffb8972c7807fe9760cdf75e2302144eade634aace40d0f8b06bd10efc656e1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230353:149082:4956:1","source":"bangumi"}]},{"characterId":"char_c2654","characterName":"沢木 泉美","sourceIds":{"bangumi":[{"characterId":"149085","match":"exact-normalized-name-in-linked-work","subjectId":"230353"}],"egsCharacterIds":["27239"],"vndbCharacterId":"c2654"},"originalCharacterName":"沢木 泉美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"風見学園に教育実習生としてやってきた女子大生。"},{"spoiler":false,"text":"主人公の年上の幼馴染で、小さい頃は本当の姉弟のように育った。"},{"spoiler":false,"text":"物腰が柔らかく、落ち着いた雰囲気の女性だが、極度の上がり症で、実習ではドキドキしっ放し。そのため、失敗も多く、内気なお姉さんと学生からは誤解されている。"},{"spoiler":false,"text":"主人公に対してはお姉さん口調になってしまう。"}],"source":"egs","sourceCharacterId":"27239","sourceWorkId":"2946","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼馴染で、小さい頃は本当の姉弟のように育っていた。"},{"spoiler":false,"text":"今回、実習生として主人公のいる学校にやってきたが、子供の頃からの性癖である極度のアガリ症のために、常に失敗を繰り返している。"}],"source":"bangumi","sourceCharacterId":"149085"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4cb03f34ef16336175524608e35f9f01bb36741597b1ada231f264b3ff5252de.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f32e1145ee8cbc19c111f196c74d92eadd32a62f8d87f4b40a8b029e216bce7c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夕城粧子","creatorId":"vndb:s4220","sourcePersonId":"vndb:s4220","canonicalEntityId":"vndb:s4220","