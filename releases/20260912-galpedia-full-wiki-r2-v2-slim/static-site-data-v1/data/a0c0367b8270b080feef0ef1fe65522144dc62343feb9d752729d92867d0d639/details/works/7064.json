alue":"20"},"birthday":{"reviewState":"source-only","source":"vndb","value":"104"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Memories Off ~Sorekara~:"},{"spoiler":false,"text":"A frequenter of the café Narazu-ya and a freeter. He lives on the first floor of the apartment \"Higurashi-sou\"; the same apartment as Isshu. He works part-time at the chain restaurant \"Ressac\" where he continually gets accolades; It's rumored he's due for a big promotion. He's saving up money for his next journey abroad."},{"spoiler":false,"text":"Memories Off #5 Togireta Film; Memories Off #5 encore:"},{"spoiler":false,"text":"Haruto's neighbor at the apartment \"Higurashi-sou.\" After returning from Nepal, Shin returned to working part-time at the chain restaurant \"Ressac\" where he becomes co-workers with Mahiro."}],"source":"vndb","sourceCharacterId":"c11644"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f3608118ae9d7ad78a124cf7ab3ff089e41d485b8c20c3b75c0600c35b89268.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/067eae24bff43abb4635076e57a7f725a53ca762d72b7b2c2f1fed4e925488f9.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間島 淳司","creatorId":"vndb:s756","sourcePersonId":"vndb:s756","canonicalEntityId":"vndb:s756","name":"間島 淳司","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10636","source":"vndb"}]},{"characterId":"char_vndb_c11649","characterName":"陵 いのり","sourceIds":{"vndbCharacterId":"c11649"},"originalCharacterName":"陵 いのり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authorita