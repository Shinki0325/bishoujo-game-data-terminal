ス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"40"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Liked things: Sake, cocktails, beer, all kinds of liquor"},{"spoiler":false,"text":"Hobby: Home gardening"},{"spoiler":false,"text":"She's Yukito and Sasha's mother. Although powerful, she has retired from active duty as a witch. She is called the \"strongest\" witch alive. Despite of her young look, she is 40 years old."}],"source":"vndb","sourceCharacterId":"c46828"},{"segments":[{"spoiler":false,"text":"物語の発端であり、幸人と早紗の母親であり、ラスボス。"},{"spoiler":false,"text":"元は歴代最高と認められた魔女だが、今は現役を引退。"},{"spoiler":false,"text":"村の役場でお年寄りたちの生活相談役として働いている。"},{"spoiler":false,"text":"実年齢は40代であるがずっと若く見え、本人も自覚している。"},{"spoiler":false,"text":"世界中が彼女に恩義を感じていると言っても過言ではないレベルで働いていたため、いまだにお中元がきたりする。"},{"spoiler":false,"text":"胸が大きい(若い頃の張りが維持されている)"}],"source":"egs","sourceCharacterId":"9672","sourceWorkId":"23037","spoiler":false},{"segments":[{"spoiler":false,"text":"物語の発端であり、幸人と早紗の母親であり、ラスボス。"},{"spoiler":false,"text":"元は歴代最高と認められた魔女だが、今は現役を引退している。"},{"spoiler":false,"text":"仕事はもっぱら、村役場でのお年寄りたちの生活相談係。"},{"spoiler":false,"text":"実年齢は40代だがずっと若く見え、本人も自覚している。"},{"spoiler":false,"text":"世界中が彼女に恩義を感じていると言っても過言ではないレベルで働いていたため、いまだにお中元が届くことがある。"},{"spoiler":false,"text":"胸は若い頃の張りが維持されていて大きい。"}],"source":"bangumi","sourceCharacterId":"42704"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"42704","value":"日本酒、カクテル、ビールなど酒全般"},{"label":