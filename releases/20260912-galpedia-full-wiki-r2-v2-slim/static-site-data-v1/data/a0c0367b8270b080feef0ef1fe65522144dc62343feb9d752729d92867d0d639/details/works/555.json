urce":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Seela is Fauthen's only child. She grew up idolizing her father's work and when Raika started her own detective firm, the perfect opportunity to help defend the law without the requirement of to becoming a policewoman presented itself. She is dedicated to Raika's business and wants to see it succeed. When Raika has doubts that it will, Seela's there to set her straight."},{"spoiler":false,"text":"Seela has a weak heart and is advised by her doctor to avoid stressful situations. This leads to her death when she is kidnapped and raped by the criminals Lilia and Raika are tracking."},{"spoiler":false,"text":"Seela is a Libra (September 23 - October 22.)"}],"source":"vndb","sourceCharacterId":"c5535"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b6639ef2a8531bb169f0ee7e1440de349d79cff165b09663bbf80121ea691bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e522dfd79484245427ad195af734ea2c032b3a047dce7533fb197bafb55016f5.webp","width":160,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c5536","characterName":"リリア・ミルクレーブ","sourceIds":{"vndbCharacterId":"c5536"},"originalCharacterName":"リリア・ミルクレーブ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Lilia works for the local police department's special investigation unit headed by Fauthen. Raika is a close friend who shares a lot of the same duties in their respective jobs. In F40, she is tasked with finding three missing persons. When her search leads nowhere, she turns to Raika for help. Raika, with no case to work on at the moment agrees to help."},{"spoiler":false,"text":"Compromising situations easily embarrass Lilia. She's been trying to keep her relationship to Mark a secret and does so successfully until Raika bumps into them while they are on a date. She's ashamed to introduce her boyfriend to Raika, although both she and Seela agree they make a cute couple."},{"spoiler":false,"text":"Although she works for Seela's father, Lilia had never met Seela before Raika introduced them to each other."},{"spoiler":false,"text":"She is an Aquarius (January 20 - February 18)."}],"source":"vndb","sourceCharacterId":"c5536"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75473026f76fe25b37e05e8a9b4ab5c5bced5084171abddcb165c3c06a7ea54c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a84656b9ff50691dbeb3c66272e0653eb6229e8adf907a6eaf6ef72c52634d78.webp","width":160,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c5537","characterName":"ライカ・グレース","sourceIds":{"vndbCharacterId":"c5537"},"originalCharacterName":"ライカ・グレース","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"23"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Raika has just opened her own private investigation firm. Seela is her administrative assistant. She loves her new job but business is slow. She thinks it may have been a mistake to leave the police department but Seela convinces her a little advertising may be the spark they need. Her former coworker Lilia manages to break the spell of boredom with a case of unexplained abductions occurring throughout the city. Following Seela's abduction and Lilia's rape, Raika takes over the case as her own."},{"spoiler":false,"text":"Raika was born under the sign of Taurus (April 20 - May 20.)"}],"source":"vndb","sourceCharacterId":"c5537"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed2fbeef1bb8a3e1f9d5826a126937ad2ba0e96897d9ab26070cf9f7b8fcbacc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/892e681ba1726709b0849741423b92ea765ec9534e8e5d950f8908a05338da87.webp","width":160,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p461","sourceCompanyId":"egs:brand:174","canonicalEntityId":"vndb:p461","name":"SOGNA","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:555:174","source":"egs"},{"companyId":"vndb:p461","sourceCompanyId":"vndb:p461","canonicalEntityId":"vndb:p461","name":"ソニア","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:2257:v977","source":"vndb"},{"companyId":"vndb:p461","sourceCompanyId":"vndb:p461","canonicalEntityId":"vndb:p461","name":"ソニア","roleCodes":["developer","publisher"],"identityStatus"