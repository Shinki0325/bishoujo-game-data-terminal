{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"21222","model":{"presentationWorkId":"vndb:v16251","staff":{"artwork":[{"creditedName":"なお","creatorId":"vndb:s13613","sourcePersonId":"egs:creator:19516","canonicalEntityId":"vndb:s13613","name":"なお","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:176948","source":"egs"}],"scenario":[{"creditedName":"なお","creatorId":"vndb:s13613","sourcePersonId":"egs:creator:19516","canonicalEntityId":"vndb:s13613","name":"なお","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:176949","source":"egs"}],"music":[],"other":[{"creditedName":"なお","creatorId":"vndb:s13613","sourcePersonId":"vndb:s13613","canonicalEntityId":"vndb:s13613","name":"なお","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:115047","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c81452","characterName":"北上 耕史","sourceIds":{"vndbCharacterId":"c81452"},"originalCharacterName":"北上 耕史","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"42"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A middle-aged bachelor pushing forty. Preoccupied with work, his daily life consists of waking up, going to work, coming back home and going to sleep. Even on his days off he just idles away without doing anything... Possibly due to his serious and diligent attitude, he only lives to work. He is well aware that he will remain a virgin bachelor if things continue the way they are."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c81452"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c81453","characterName":"藤島 奏子","sourceIds":{"vndbCharacterId":"c81453"},"originalCharacterName":"藤島 奏子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A runaway female student in search of a person willing to let her stay for the night. She goes after middle-aged bachelors with whom she has great success. She is the cheerful and affectionate type who is devoted to those she trusts. She has an open mind even when it comes to sex, stating that she loves sexual acts herself. She may sound like someone who goes along with men without much of a thought, but there are things she will protect no matter what, and has made it a rule to only spend one night with any one person. There seems to be a reason why she would go to such lengths to not return home..."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c81453"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a80058ad55081bdbf60c4363031cbbe88ec09c32cd22207455a2a968dca8e865.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c7406c9d74160d873f174fc8a95b2bc728ca94b33bc6acbb169a8644fe76267.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朝月 文","creatorId":"vndb:s3215","sourcePersonId":"vndb:s3215","canonicalEntityId":"vndb:s3215","name":"朝月 文","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:61465","source":"vndb"}]},{"characterId":"char_vndb_c81454","characterName":"天田 二郎","sourceIds":{"vndbCharacterId":"c81454"},"originalCharacterName":"天田 二郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Private manager of the Chinese restaurant where Kanako works as a part-timer. The story goes that he promptly hired Kanako without conducting a proper interview. He has high opinion of Kanako's culinary skills and lets her take care of many of the restaurant's functions. He tends to act on a whim, taking days off and closing up shop ahead of schedule, but the customers keep on coming since the food there is so delicious."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c81454"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd59c8c8d7121e20b88cd4f68d98b27cebe5157ff62f536860833a2a50b3b213.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04b4675047b709cba491bd4d89cab31c51b1501bded3719d440e4f399d862b89.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:2999","sourceCompanyId":"egs:brand:2999","canonicalEntityId":"egs:brand:2999","name":"VENUS","roleCodes":["brand"],"identityStatus":"alias-only-review","relationId":"egs:work-brand:21222:2999","source":"egs"},{"companyId":"vndb:p3894","sourceCompanyId":"vndb:p3894","canonicalEntityId":"vndb:p3894","name":"VENUS","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:42866:v16251","source":"vndb"},{"companyId":"vndb:p3894","sourceCompanyId":"vndb:p3894","canonicalEntityId":"vndb:p3894","name":"VENUS","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:70765:v16251","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime