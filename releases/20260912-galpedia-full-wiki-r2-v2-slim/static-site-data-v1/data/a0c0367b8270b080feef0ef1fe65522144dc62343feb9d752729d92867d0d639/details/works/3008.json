th":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大波 こなみ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:27848","source":"vndb"}]},{"characterId":"char_vndb_c74617","characterName":"フィオーレ","sourceIds":{"vndbCharacterId":"c74617"},"originalCharacterName":"フィオーレ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the 3 ladies working at Pub Chambertin, she is skilled in cooking and is like the head chef among the employees. She is also a young widow, and her late husband's demeanor is similar to the protagonist's."}],"source":"vndb","sourceCharacterId":"c74617"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4a95bcd0ae4472ad86815633d9736973864167a01428d31735d8317743afc53.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93d9334c9607294604d08f6d4ca6a17c42cbee5d2841814dafb4b1e402c514f3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長崎 みなみ","creatorId":"vndb:s1073","sourcePersonId":"vndb:s1073","canonicalEntityId":"vndb:s1073","name":"長崎 みなみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:27849","source":"vndb"}]},{"characterId":"char_vndb_c74618","characterName":"フェタ","sourceIds":{"vndbCharacterId":"c74618"},"originalCharacterName":"フェタ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the 3 ladies working at Pub Chambertin, she is persistent and the kind of woman who doesn't exactly sugarcoat things. For that reason she often seems reckless."},{"spoiler":false,"text":"Although she says that she \"hates guys who are hesitant,\" in reality she's just the type of person who wants to bother men like that."}],"source":"vndb","sourceCharacterId":"c74618"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85777effc6a1329dda0817d9274c5b29af6993dadc6b77ab62407a565e2b607f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c8db9a2a4d9acaeb324dd1bb2638e8f4587dc740a34ae77d1940d4fbc51b35c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三木本 彩響","creatorId":"vndb:s1987","sourcePersonId":"vndb:s1987","canonicalEntityId":"vndb:s1987","name":"三木本 彩響","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:27850","source":"vndb"}]},{"characterId":"char_vndb_c74619","characterName":"クーロミエ","sourceIds":{"vndbCharacterId":"c74619"},"originalCharacterName":"クーロミエ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the 3 ladies working at Pub Chambertin. She usually butts into conversations, but sometimes you can't blame her."},{"spoiler":false,"text":"As a hedonist and a fuckbuddy, she is a little exhausting. Is her no-strings-attached personality the secret behind her popularity?"}],"source":"vndb","sourceCharacterId":"c74619"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3a69611945faf971124ad7fddab51499036173d755b7b8077aa630cd4f39