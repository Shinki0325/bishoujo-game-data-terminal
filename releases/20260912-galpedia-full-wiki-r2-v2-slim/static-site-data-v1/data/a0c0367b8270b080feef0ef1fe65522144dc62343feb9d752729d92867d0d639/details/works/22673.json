leCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:158203","source":"egs"},{"creditedName":"大下菜摘","creatorId":"vndb:s6946","sourcePersonId":"egs:creator:25606","canonicalEntityId":"vndb:s6946","name":"大下菜摘","detail":"ED曲「ピカデリィ・ジュエル」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:158204","source":"egs"},{"creditedName":"菜摘かんな","creatorId":"vndb:s3257","sourcePersonId":"egs:creator:2928","canonicalEntityId":"vndb:s3257","name":"菜摘かんな","detail":"ディレクター","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:158208","source":"egs"},{"creditedName":"風之宮そのえ","creatorId":"vndb:s5019","sourcePersonId":"egs:creator:15696","canonicalEntityId":"vndb:s5019","name":"風之宮そのえ","detail":"企画原案・プロデューサー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:158209","source":"egs"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:76706","source":"vndb"},{"creditedName":"鈴葉 ユミ","creatorId":"vndb:s2523","sourcePersonId":"vndb:s2523","canonicalEntityId":"vndb:s2523","name":"鈴葉 ユミ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:76708","source":"vndb"},{"creditedName":"菜摘 かんな","creatorId":"vndb:s3257","sourcePersonId":"vndb:s3257","canonicalEntityId":"vndb:s3257","name":"菜摘 かんな","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:76710","source":"vndb"},{"creditedName":"風之宮 そのえ","creatorId":"vndb:s5019","sourcePersonId":"vndb:s5019","canonicalEntityId":"vndb:s5019","name":"風之宮 そのえ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:76711","source":"vndb"},{"creditedName":"明坂 聡美","creatorId":"vndb:s5177","sourcePersonId":"vndb:s5177","canonicalEntityId":"vndb:s5177","name":"明坂 聡美","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:76712","source":"vndb"},{"creditedName":"寺崎 裕香","creatorId":"vndb:s5179","sourcePersonId":"vndb:s5179","canonicalEntityId":"vndb:s5179","name":"寺崎 裕香","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:76713","source":"vndb"},{"creditedName":"大下 菜摘","creatorId":"vndb:s6946","sourcePersonId":"vndb:s6946","canonicalEntityId":"vndb:s6946","name":"大下 菜摘","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:76716","source":"vndb"},{"creditedName":"三村ナツ","creatorId":"vndb:s8492","sourcePersonId":"vndb:s8492","canonicalEntityId":"vndb:s8492","name":"三村ナツ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:76717","source":"vndb"}]},"cast":[{"characterId":"char_c34187","characterName":"モラン 大佐","sourceIds":{"bangumi":[{"characterId":"18832","match":"exact-normalized-name-in-linked-work","subjectId":"1023"}],"egsCharacterIds":["9161"],"vndbCharacterId":"c34187"},"originalCharacterName":"モラン 大佐","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"703"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The right hand man of Professor Moriarty."}],"source":"vndb","sourceCharacterId":"c34187"},{"segments":[{"spoiler":false,"text":"外見年齢は20代に見える、恐らくは女。年齢不詳。"},{"spoiler":false,"text":"背が高く、襟元までぴっちりと閉じた陸軍服を常に身に纏っている。"},{"spoiler":false,"text":"秘密結社《西インド会社》によって肉体を改造された機関人間であり、『M』の直属の部下。影のように彼に付き従う。"},{"spoiler":false,"text":"寡黙で、『M』にのみ従順。彼の命令すべてを確実に遂行する。"},{"spoiler":false,"text":"身体のほぼすべてを機関機械に置き換えており、驚異的な戦闘能力を備えている。素手で大岩を持ち上げ、鉄扉をこじ開けることが可能。警官や軍人の一団であれば木っ端のように蹴散らすこともできるだろうが、『M』の敵となる《怪異》に対しては数分しか戦闘状態を維持することはできない。"},{"spoiler":false,"text":"常にドイツ製拳銃を携行しており、弾丸には《緑の石》の破片が込められている。"}],"source":"egs","sourceCharacterId":"9161","sourceWorkId":"16423","spoiler":false},{"segments":[{"spoiler":false,"text":"外表看来年龄是20世代，大概是女人。年龄不详。"},{"spoiler":false,"text":"高个子，经常身穿着到领子边紧紧扣实的陆军装。"},{"spoiler":false,"text":"被秘密结社《西印度会社》进行肉体改造而成的机关人类，『M』的直属部下。像影子一样跟着他。"},{"spoiler":false,"text":"沉默寡言，只服从于『M』。对他的全部命令准确地执行。"},{"spoiler":false,"text":"身体几乎都被换成机关机械，拥有惊人的战斗能力。可以赤手举起大岩石、将铁门撬开。"},{"spoiler":false,"text":"虽然是应该可以把一队警察或军人像木屑一样踢散，但对于『M』的敌人《怪異》仅可以维持数分钟的战斗状态。"},{"spoiler":false,"text":"常带着德制手枪，子弹里装有《绿之石》的碎片。"}],"source":"bangumi","sourceCharacterId":"18832"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c34187","value":"m"},{"comparisonValue":"m","source":"egs","sourceCharacterId":"9161","value":"男性"},{"comparisonValue":"m","source":"egs","sourceCharacterId":"9161","value":"男性"},{"comparisonValue":"f","source":"bangumi","sourceCharacterId":"18832","value":"女"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb3a323285148e0cdc26765af0110f4d4e77f0e5a212a6cec1ba7474f78e6dd3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11ee896396ef95fc8813428047f3624387d5463c49a2b0b64b387b00b9a4e5de.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮下雄也","creatorId":"vndb:s18726","sourcePersonId":"vndb:s18726","canonicalEntityId":"vndb:s18726","name":"宮下雄也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42916","source":"vndb"}]},{"characterId":"char_vndb_c34174","characterName":"エミリー・ホワイトリー","sourceIds":{"vndbCharacterId":"c34174"},"originalCharacterName":"エミリー・ホワイトリー","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Listening to music"},{"spoiler":false,"text":"Adores: Custard tarts"},{"spoiler":false,"text":"A young heiress who has been raised by her dearest butler since she was a small girl. Upon her debut into high society, she receives a letter of recommendation from the Queen of England to a famed school for detectives. Her moments of brilliance are paired with a rare depth of sincerity, and she uses both in her new life at Harrington Academy, working at a relentless pace towards the truth behind her mother and father's peculiar deaths."},{"spoiler":false,"text":"From XSEED Games"}],"source":"vndb","sourceCharacterId":"c34174"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0eba8dd1d3e86ef7802067b95edbb5b77b8b4bf60dd4ec8e8229cd2a51d2c232.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47b6aed9c043e8d98440924d89ce6c060b8f7bc1293e2788be4e88665c3300b4.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"明坂 聡美","creatorId":"vndb:s5177","sourcePersonId":"vndb:s5177","canonicalEntityId":"vndb:s5177","name":"明坂 聡美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42907","source":"vndb"},{"creditedName":"大下 菜摘","creatorId":"vndb:s6946","sourcePersonId":"vndb:s6946","canonicalEntityId":"vndb:s6946","name":"大下 菜摘","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42911","source":"vndb"}]},{"characterId":"char_vndb_c34175","characterName":"エルロック・ホームズ","sourceIds":{"vndbCharacterId":"c34175"},"originalCharacterName":"エルロック・ホームズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"125"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"174"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Talents: Boxing"},{"spoiler":false,"text":"Adores: Tea (Prince of Wales)"},{"spoiler":false,"text":"The son of London's most legendary detective. He takes after his father in many ways—his superior intellect being one, and his stubbornness being another. Herlock's proclivity for getting in the last word and mockery of others can grate on those around him, and though he is quite clever, he himself is unaware of the extent of his behaviour."},{"spoiler":false,"text":"As he is a man of logic and reason, he disapproves of Lady Whiteley's more intuition-based approach, and he has no issue voicing as much."},{"spoiler":false,"text":"From XSEED Games"}],"source":"vndb","sourceCharacterId":"c34175"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1dcad9a8f38a3f75eb4c8994822153411001821a0b3ad420866aad66c348b594.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d8d952e0f0e337c5f660be71114c18976e0571eb63770843124eb32627853e0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴木 千尋","creatorId":"vndb:s182","sourcePersonId":"vndb:s182","canonicalEntityId":"vndb:s182","name":"鈴木 千尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42896","source":"vndb"}]},{"characterId":"char_vndb_c34176","characterName":"ウィリアム・H・ワトソン","sourceIds":{"vndbCharacterId":"c34176"},"originalCharacterName":"ウィリアム・H・ワトソン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"710"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Horseback-riding"},{"spoiler":false,"text":"Adores: Welsh rarebit"},{"spoiler":false,"text":"The son of Doctor John Watson. Watson is a man of action, often jumping headfirst into a situation no matter the danger. This would normally be a cause for concern, but his reputable physical strength helps to counterbalance any difficulties that might come his way. He's also quite experienced in playing the sweetener to Holmes's bitterness, and because they have a nigh-unbreakable bond of trust, that's just fine by him."},{"spoiler":false,"text":"He takes a liking to the heroine from the day they first meet, and he's always more than happy to help her."},{"spoiler":false,"text":"From XSEED Games"}],"source":"vndb","sourceCharacterId":"c34176"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0ded5b3c1339bc0e8d800dd0472f08dde4a04a7e1fb1deaf5875d692b37c2d2f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22acb648227d60b6f4cfcb3962a26f536fa8b987ad56b1b138242ad1bc391ce5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村 良平","creatorId":"vndb:s382","sourcePersonId":"vndb:s382","canonicalEntityId":"vndb:s382","name":"木村 良平","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42899","source":"vndb"},{"creditedName":"白井 悠介","creatorId":"vndb:s6948","sourcePersonId":"vndb:s6948","canonicalEntityId":"vndb:s6948","name":"白井悠介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42912","source":"vndb"}]},{"characterId":"char_vndb_c34177","characterName":"ジャン・ルパン","sourceIds":{"vndbCharacterId":"c34177"},"originalCharacterName":"ジャン・ルパン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"608"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"174"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Chess"},{"spoiler":false,"text":"Adores: Flapjacks"},{"spoiler":false,"text":"By day he's a meek, dangerously clumsy student by the name John Lupine, but by night, he assumes his true identity: Jean Lupin, Gentleman Thief. He revels in stealing countless treasures and has done well to live up to the master that his father is and more. Though pretentious once the sun goes down and the mask comes off, he does seem to be a man of good character at heart."},{"spoiler":false,"text":"He also enjoys toying with Lady Whiteley as much as he enjoys thievery, and she has yet to decide if the pretty words he spouts upon their meetings ring false or true."},{"spoiler":false,"text":"From XSEED Games"}],"source":"vndb","sourceCharacterId":"c34177"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2229e4aae1c9d0d1e2423341b2903d2ef045cabf8781be36b53b7b9e636b61c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/746478a59f5dc1df04d2b0a43ef02788a5e9cbe141e1445f95a581822b38621a.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松風 雅也","creatorId":"vndb:s615","sourcePersonId":"vndb:s615","canonicalEntityId":"vndb:s615","name":"松風 雅也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42901","source":"vndb"}]},{"characterId":"char_vndb_c34178","characterName":"ジャック・ミラーズ","sourceIds":{"vndbCharacterId":"c34178"},"originalCharacterName":"ジャック・ミラーズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1024"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"181"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Hunting"},{"spoiler":false,"text":"Adores: Blackberry Fool"},{"spoiler":false,"text":"A man of two sides like Lupin Jr., and yet not a man of two faces, for he remains withdrawn no matter the situation. His mannerisms and background as an East Ender have created a natural barrier with his schoolmates, who all perceive him as different—unfortunate, as there could be those nearby who would sooner think him misunderstood."},{"spoiler":false,"text":"Or it could be he isn't misunderstood at all; though his identity remains unknown, he is none other than the Ripper who terrorises London's streets. What brings him to commit these atrocities? Curiosity may grant answers, but it may also lead to Lady Whiteley's downfall."},{"spoiler":false,"text":"From XSEED Games"}],"source":"vndb","sourceCharacterId":"c34178"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19326e1da8274f8ae9c8dfdd7932be712efa12ebc015653f30c600939d4d7ab3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79b1152107aae4c5f35021a9d8890b43d7e3a2c658f1e337b6a38fdef3f263d9.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤原 祐規","creatorId":"vndb:s239","sourcePersonId":"vndb:s239","canonicalEntityId":"vndb:s239","name":"藤原 祐規","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42897","source":"vndb"},{"creditedName":"中澤 まさとも","creatorId":"vndb:s864","sourcePersonId":"vndb:s864","canonicalEntityId":"vndb:s864","name":"佐和真中","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42902","source":"vndb"}]},{"characterId":"char_vndb_c34179","characterName":"明智 健一郎","sourceIds":{"vndbCharacterId":"c34179"},"originalCharacterName":"明智 健一郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"115"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Calligraphy"},{"spoiler":false,"text":"Adores: Sushi and Matcha Tea"},{"spoiler":false,"text":"An exchange student and a brilliant detective in his own right, even if he has yet to reach the same heights as Holmes Jr. Though he is strict towards others, he is no-less strict towards himself, immediately taking up the position of class representative to further his studies whilst keeping a watchful eye over his schoolmates' behaviour."},{"spoiler":false,"text":"To strive for betterment in both body and mind is the ultimate goal for him; yet he has still lived a sheltered life, having had no significant experience with women, and as such is oftentimes at a loss when interacting with them."},{"spoiler":false,"text":"From XSEED Games"}],"source":"vndb","sourceCharacterId":"c34179"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4a067c7116f9a8569ed9e9aa3db714a5b5fbb089b2d2bd7ae6ad234a215cb8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e562f2cb07728a72056ac0f497ddd78f33a0ba7e78c1fb4737acfa4cd8b08e2b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三浦 祥朗","creatorId":"vndb:s399","sourcePersonId":"vndb:s399","canonicalEntityId":"vndb:s399","name":"三浦 祥朗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42900","source":"vndb"}]},{"characterId":"char_vndb_c34180","characterName":"小林 誠司","sourceIds":{"vndbCharacterId":"c34180"},"originalCharacterName":"小林 誠司","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1212"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Reading (Detective Fiction)"},{"spoiler":false,"text":"Adores: Monaka"},{"spoiler":false,"text":"A government-sponsored exchange student and assistant to Akechi. Kobayashi's a doer before he is a thinker, though this does not mean he is lacking academically. He is fascinated by the endless wonders of London, studying its technology and culture with a hungry energy. Thankfully, his friendly nature allows him to adapt well to any situation this new world presents him."},{"spoiler":false,"text":"As his name implies, he is connected to a certain well-known boy detective."},{"spoiler":false,"text":"From XSEED Games"}],"source":"vndb","sourceCharacterId":"c34180"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35c48988d30f9f744e9269bffd37c21785dc4a536a33d4162bef74c26116b973.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9ce574aed163413820c47ece237d84a26ca98625d5d6c72c5893d77a4e2bd46.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"豊永 利行","creatorId":"vndb:s3247","sourcePersonId":"vndb:s3247","canonicalEntityId":"vndb:s3247","name":"豊永 利行","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42903","source":"vndb"},{"creditedName":"山谷 祥生","creatorId":"vndb:s8331","sourcePersonId":"vndb:s8331","canonicalEntityId":"vndb:s8331","name":"山谷 祥生","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42913","source":"vndb"}]},{"characterId":"char_vndb_c34181","characterName":"セーラ・マープル","sourceIds":{"vndbCharacterId":"c34181"},"originalCharacterName":"セーラ・マープル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1111"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Making clothes"},{"spoiler":false,"text":"Adores: Maids of Honour"},{"spoiler":false,"text":"A fellow schoolmate who attends Harrington Academy with Lady Whiteley. Marple carries an air of dollish refinement upon first sight—and upon second, an air of someone completely unaware of how odd she is to the people around her. She is blunt with grace, helpful as she is critical, and worldly in intelligence yet constantly off in her own world. There is no questioning her passion for tea and snacks, however. To her, nothing ever good comes from being hungry, and a fellow appreciator of a fine lunch is a friend for life."},{"spoiler":false,"text":"She adores her grandmother, a well-known detective in her own right, and often speaks of their life together in the countryside."},{"spoiler":false,"text":"From XSEED Games"}],"source":"vndb","sourceCharacterId":"c34181"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/321efd173c2d584de55845df5995fccec102e569a0787d251eaa2cb68a3cdaf8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d971ea297818b80885d217843e55fab148b26a044adc37ec3c96294e7c149454.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本多 真梨子","creatorId":"vndb:s5178","sourcePersonId":"vndb:s5178","canonicalEntityId":"vndb:s5178","name":"本多真梨子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42908","source":"vndb"},{"creditedName":"吉岡 麻耶","creatorId":"vndb:s5512","sourcePersonId":"vndb:s5512","canonicalEntityId":"vndb:s5512","name":"吉岡 麻耶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42910","source":"vndb"}]},{"characterId":"char_vndb_c34182","characterName":"アビゲイル・ハドソン","sourceIds":{"vndbCharacterId":"c34182"},"originalCharacterName":"アビゲイル・ハドソン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"birthday":{"reviewState":"source-only","source":"vndb","value":"228"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"142"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Cleaning"},{"spoiler":false,"text":"Adores: Eton Mes"},{"spoiler":false,"text":"The official loud-and-proud landlady of a series of flats along Baker Street, including Holmes Jr. and Watson Jr.’s shared flat. Her unusually young age in conjunction with her role may leave some sceptical, but their worries would be short-lived after meeting her; she takes all her duties seriously, happily cleaning, cooking meals, and handling the accounts for her tenants daily. She also treats them like family—particularly the boy detectives, to whom she feels an almost motherly affection towards."},{"spoiler":false,"text":"She admires those in the investigative field so much that she volunteers to become Lady Whiteley’s assistant, boasting her capabilities from the rooftops to ensure she is the one and only candidate for the position."},{"spoiler":false,"text":"From XSEED Games"}],"source":"vndb","sourceCharacterId":"c34182"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22fe823b55424a176098807d05abea01742bb7027d8cdd530c1af2c5b8de10d5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1cc6599fa525836eec9ec71b8c1787a870ff452eb7b092b34f3de6c144b65eb7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"寺崎 裕香","creatorId":"vndb:s5179","sourcePersonId":"vndb:s5179","canonicalEntityId":"vndb:s5179","name":"寺崎 裕香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42909","source":"vndb"}]},{"characterId":"char_vndb_c34183