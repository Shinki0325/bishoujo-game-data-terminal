"},{"creditedName":"夏華 瑠璃","creatorId":"vndb:s12033","sourcePersonId":"vndb:s12033","canonicalEntityId":"vndb:s12033","name":"夏華 瑠璃","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:22420","source":"vndb"},{"creditedName":"手塚 忍","creatorId":"vndb:s12540","sourcePersonId":"vndb:s12540","canonicalEntityId":"vndb:s12540","name":"手塚 忍","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:22421","source":"vndb"},{"creditedName":"十五夜","creatorId":"vndb:s13155","sourcePersonId":"vndb:s13155","canonicalEntityId":"vndb:s13155","name":"十五夜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:22422","source":"vndb"},{"creditedName":"おみ","creatorId":"vndb:s13856","sourcePersonId":"vndb:s13856","canonicalEntityId":"vndb:s13856","name":"おみ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:22423","source":"vndb"},{"creditedName":"久神 仁","creatorId":"vndb:s38118","sourcePersonId":"vndb:s38118","canonicalEntityId":"vndb:s38118","name":"久神 仁","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:22424","source":"vndb"},{"creditedName":"ひろりん","creatorId":"vndb:s47094","sourcePersonId":"vndb:s47094","canonicalEntityId":"vndb:s47094","name":"ひろりん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:22426","source":"vndb"},{"creditedName":"BAKU","creatorId":"vndb:s48239","sourcePersonId":"vndb:s48239","canonicalEntityId":"vndb:s48239","name":"BAKU","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:22427","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c157363","characterName":"フランシスθ","sourceIds":{"vndbCharacterId":"c157363"},"originalCharacterName":"フランシスθ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Member of the facility. She was once hated by a younger Shinobu after she forcibly pushed her affection onto him out of curiosity, but now after growing up they presently have a good relationship."}],"source":"vndb","sourceCharacterId":"c157363"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad28c8aa602a4be8a98679ff21375fb10b3629fab697b029a0a32ba33883c9b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43924751062e098945dd5ce51c8c4ed1eccad7e0a356e834d4ae9514938387b9.webp","width":135,"height":173,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c42503","characterName":"貴宮 忍","sourceIds":{"vndbCharacterId":"c42503"},"originalCharacterName":"貴宮 忍","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist. He grew up in an institution, having lost both of his parents at a young age. He remembers almost nothing from before he became self-aware, but that doesn’t bother him in the slightest. At times he acts like an innocent, carefree boy; at others, he speaks and behaves with an odd, almost seasoned maturity. There’s something hard to pin down about him."},{"spoiler":false,"text":"He places great value on friendship-especially the bond shared by the group of seven-and his sense of loyalty to his companions runs deep. The seven of them have known each other since childhood, close enough to be called lifelong friends. Shinobu also possesses a certain unusual ability, and it is through this “key” that the story begins to unfold."},{"spoiler":false,"text":"[From the site."}],"source":"vndb","sourceCharacterId":"c42503"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62c3cdf4c68d5007fd608110132cd05daae79fed7f3de24f79c138414be125a4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e7bf082b3c13532dd568b8d9f5d6db57cd2ad986cd1f6d178d266030d499a3a.webp","width":222,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c42504","characterName":"貴宮 千鳥","sourceIds":{"vndbCharacterId":"c42504"},"originalCharacterName":"貴宮 千鳥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67144b6c176d8c5243210f3cf55f7bc3e216c62eb3051bcb8a359c7f8cb2e824.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/759f4c1d9afabfefade43054071a6ab2f4dd58088658b00db0a9852a8d415f59.webp","width":225,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松永 雪希","creatorId":"vndb:s452","sourcePersonId":"vndb:s452","canonicalEntityId":"vndb:s452","name":"永見 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11420","source":"vndb"}]},{"characterId":"char_vndb_c42505","characterName":"紅緒 あずさ","sourceIds":{"vndbCharacterId":"c42505"},"originalCharacterName":"紅緒 あずさ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"When she was little, Shinobu once saved her life. She’s been attached to him ever since, always hovering somewhere nearby. Having grown up so close to him, she’s picked up a lot of his habits and attitudes, though lately she’s started pushing back a bit-something like a late-onset rebellious phase. She wears her emotions on her sleeve and doesn’t bother skirting around taboos. There’s a strong tomboy streak to her, but even so, she’s trying-earnestly, even if a little awkwardly-to be a girl. As for Shouji, the two of them are sworn enemies whenever Shinobu is involved."},{"spoiler":false,"text":"[From the site."}],"source":"vndb","sourceCharacterId":"c42505"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b56044e34db9b578b025bb7d8b18ca751e6e9d14c834e68f7927a5a85a8fb938.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8ca21eb00c8bdfc1b2ae5f56e10191945843046d488881506c93c7275a0c6a06.webp","width":221,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みる","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11415","source":"vndb"}]},{"characterId":"char_vndb_c42506","characterName":"本堂 沙也加","sourceIds":{"vndbCharacterId":"c42506"},"originalCharacterName":"本堂 沙也加","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The gifted type who can handle just about anything with quiet competence, though she rarely pushes herself to the forefront. Because of that, she naturally falls into the role of the “older sister” within the group of seven. She comes across as gentle and reserved, but her thinking can be surprisingly sharp and uncompromising. Physically, however, she’s on the frail side. She isn’t a vegetarian, but she has little taste for meat. A refined yamato nadeshiko, she practices the tea ceremony and aikidou."},{"spoiler":false,"text":"[From the site."}],"source":"vndb","sourceCharacterId":"c42506"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/7572aadafec218634f7c956d31306c61f12de19fa77b9de3a76d23de5d1e3e57.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b33b2591e6ed81a5da469eba8cb0f732ecc5dd1ed2f413571665d841f7f1fd09.webp","width":221,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風音","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11419","source":"vndb"}]},{"characterId":"char_vndb_c42507","characterName":"塚本 葉子","sourceIds":{"vndbCharacterId":"c42507"},"originalCharacterName":"塚本 葉子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An airheaded and unhurried, she takes life at her own pace and almost nothing ever seems to rattle her. She’s intelligent, but laid-back to the point of drowsiness, with half-lidded eyes that always make her look like she’s on the verge of falling asleep. When she’s actually thinking hard, her expression sharpens-but most of the time she isn’t thinking about anything particularly worthwhile. She’s the type who fiercely cherishes only what matters to her and cleanly cuts away the rest. She doesn’t smile often, though now and then, among the group, a soft, natural smile slips out."},{"spoiler":false,"text":"[From the site."}],"source":"vndb","sourceCharacterId":"c42507"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a55d7b2870761b78129941d0cd3e8e50dfb246add0292f768704e26fe956c64e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b21267b6af9d8ab670ee34658de8700681d3d59f896e03ea541f85a04faa07c.webp","width":219,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏野 向日葵","creatorId":"vndb:s855","sourcePersonId":"vndb:s855","canonicalEntityId":"vndb:s855","name":"瀬那 歩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11423","source":"vndb"}]},{"characterId":"char_vndb_c42508","characterName":"塚本 斎","sourceIds":{"vndbCharacterId":"c42508"},"originalCharacterName":"塚本 斎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Youko’s older brother. Quiet to an almost unnatural degree. Only Shinobu, Youko, and a handful of others can really understand what he’s saying when he speaks. He’s stoic by nature and places great importance on honor and righteousness. There’s an air of old maturity about him, along with a tendency to give up quickly-but among close friends, a surprisingly childlike side sometimes slips through. He holds ranks in kendo and also studies iaido. Raised in a strict household where he never knew freedom, meeting Shinobu gave him a place where he could finally spread his wings."},{"spoiler":false,"text":"[From the site."}],"source":"vndb","sourceCharacterId":"c42508"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb95aaa245492090db190029219b56fba3c7df1b4b93570c8ad4e11a9acb3537.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8c7a0ac8ca36f24cb86d6f05e503404b7e48d0724f5cdbe5a2fa2a84d787835.webp","width":222,"height":256,"source":"static-detail"},"actors":[{"creditedName":"薔薇 珈琲","creatorId":"vndb:s8212","sourcePersonId":"vndb:s8212","canonicalEntityId":"vndb:s8212","name":"薔薇 珈琲","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11429","source":"vndb"}]},{"characterId":"char_vndb_c42509","characterName":"伊月 笛子","sourceIds":{"vndbCharacterId":"c42509"},"originalCharacterName":"伊月 笛子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A serious, strong-willed girl who attends a different elite prep school than Shinobu and the others. She has a kind of cleanliness obsession and can’t stop herself from pointing out other people’s mistakes. Despite that, she’s deeply lonely at heart and hates being on her own. Emotionally fragile, she also has a self-sacrificing streak. She’s dismissive of anything flashy and is almost pathologically frightened by disorder, broken rules, or rough, aggressive behavior."},{"spoiler":false,"text":"[From the site."}],"source":"vndb","sourceCharacterId":"c42509"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c6081dd03336d79fc2a8cba59125e714578c10f1c74428631edb1895aa1ab60.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a81c439d86780e4f084a3a6bb055831a51c053bfc7de4ae2798706c1f96ed5d0.webp","width":220,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大花 どん","creatorId":"vndb:s771","sourcePersonId":"vndb:s771","canonicalEntityId":"vndb:s771","name":"浅井 清己","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11422","source":"vndb"}]},{"characterId":"char_vndb_c42510","characterName":"樋口 章二","sourceIds":{"vndbCharacterId":"c42510"},"originalCharacterName":"樋口 章二","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shinobu’s best friend. He’s sharp-tongued, but his personality is straightforward and driven by impulse. He’s well known around town and has a knack for picking up information. Having grown up with few friends and distant family ties, he treats the circle of seven as something almost sacred. He places especially deep trust and loyalty in Shinobu, but he genuinely cares about every one of them. If anyone were to threaten that bond, Shoji has both the will and the strength to remove them without hesitation. Loves meat. A true carnivore."},{"spoiler":false,"text":"[From the site."}],"source":"vndb","sourceCharacterId":"c42510"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/1454660f7f20cbd2a2198a8460c5b38c4f1ec272e7f221f9cd763a8d318de182.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8f37389e2f9a895e71e5fcc2a09c93a81c115cce61fa2fa0225fc95a14f8028.webp","width":221,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柏木 誉","creatorId":"vndb:s379","sourcePersonId":"vndb:s379","canonicalEntityId":"vndb:s379","name":"野島 裕史","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11417","source":"vndb"}]},{"characterId":"char_vndb_c42511","characterName":"イマ","sourceIds":{"vndbCharacterId":"c42511"},"originalCharacterName":"イマ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"sour