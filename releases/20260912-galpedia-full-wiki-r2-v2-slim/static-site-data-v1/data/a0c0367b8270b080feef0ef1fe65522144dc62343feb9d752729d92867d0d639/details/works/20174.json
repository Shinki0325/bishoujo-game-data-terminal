bCharacterId":"c23658"},"originalCharacterName":"鷺宮 由良","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"99"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ritsu's neighbor she's been married for 18 years and has a son named Masaki. She calls Ritsu 'Rikkun'."}],"source":"vndb","sourceCharacterId":"c23658"},{"segments":[{"spoiler":false,"text":"本作品のヒロイン。"},{"spoiler":false,"text":"主人公の親友、昌樹の実の母親で、結婚18年目の専業主婦。"},{"spoiler":false,"text":"20代前半に見える美貌と整った体型、それに驚くほどの巨乳の持ち主で、近所では有名な美人妻。"},{"spoiler":false,"text":"おおらかで人当たりが良く、誰にでも好かれる性格の持ち主。"},{"spoiler":false,"text":"他人のために尽くすことに喜びを感じる性質で、いつも自分を後回しにするその性格を、息子に心配されている。"},{"spoiler":false,"text":"おっぱいの形は、張りのある、ボリュームたっぷりの釣り鐘型。"},{"spoiler":false,"text":"下半身もムッチリ。とくにお尻は安産型で大きく、本人もそのことを気にしている。"},{"spoiler":false,"text":"ひとり息子である昌樹と、実の子同然に接してきた主人公を、同じくらい大切に想っている。"},{"spoiler":false,"text":"夫に対しては良き妻でいたいと考え、その通りに尽くしてはいるものの、女としての自分に興味を持ってもらえないことを寂しく感じている。"},{"spoiler":false,"text":"学生時代は水泳部に所属しており、県大会に出場するほどの実力を持っていた。"},{"spoiler":false,"text":"家事が好きで、主人公よりもはるかに上手にこなすものの、なぜか料理の腕前だけは壊滅的だったりする。"}],"source":"egs","sourceCharacterId":"3228","sourceWorkId":"20174","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の親友・昌樹の実の母親で、結婚18年目の専業主婦。"},{"spoiler":false,"text":"20代前半に見える美貌と整った体型、それに驚くほどの巨乳の持ち主で、近所では有名な美人妻。"},{"spoiler":false,"text":"おおらかで人当たりが良く、誰にでも好かれる性格の持ち主。"},{"spoiler":false,"text":"他人のために尽くすことに喜びを感じる性質で、いつも自分を後回しにするその性格を息子に心配されている。"},{"spoiler":false,"text":"実の子同然に接してきた主人公を、一人息子である昌樹と同じくらい大切に想っている。"},{"spoiler":false,"text":"夫に対しては良き妻でいたいと考え、その通りに尽くしてはいるものの、女としての自分に興味を持ってもらえないことを寂しく感じている。"},{"spoiler":false,"text":"家事が好きで上手にこなすものの、なぜか料理の腕前だけは壊滅的だったりする。"}],"source":"bangumi","sourceCharacterId":"43085"}],"profileFacts":[{"label":"胸围（本版本）","value":"99 cm","valueContext":null,"source":"egs","sourceCharacterId":"3228","sourceWorkId":"20174","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"3228","sourceWorkId":"20174","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"3228","sourceWorkId":"20174","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"63 cm","valueContext":null,"source":"egs","sourceCharacterId":"3228","sourceWorkId":"20174","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/587e86cea2c28877c7c2c18def4499703fa43467564261e16f764ab68aeb46df.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09acee2b80b8201d2eeeeaa46693dc362d2a192a241ba0661ae7d2eed6584fc8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:186411:43085:6351:1","source":"bangumi"}]},{"characterId":"char_c47180","characterName":"鷺宮 昌樹","sourceIds":{"bangumi":[],"egsCharacterIds":["3229"],"vndbCharacterId":"c47180"},"originalCharacterName":"鷺宮 昌樹","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ritsu friend and Yura's only son."}],"source":"vndb","sourceCharacterId":"c47180"},{"segments":[{"spoiler":false,"text":"主人公の親友。"},{"spoiler":false,"text":"彼と同じ篠宮学園に通う2年生の男子学生で、ヒロイン・由良のひとり息子である。"},{"spoiler":false,"text":"勉強はあまり得意でないものの、持って生まれた身体能力と運動センスを活かして、どんなスポーツでも軽々とこなす。"},{"spoiler":false,"text":"現在は水泳部に所属、男子水泳部のホープとして期待されており、大会でも優秀な成績を残している。"},{"spoiler":false,"text":"偉丈夫な外見とは裏腹に、自他共に認めるマザコン。"},{"spoiler":false,"text":"しかし恥ずかしがり屋のため、素直に母親に甘えられないでいる。"},{"spoiler":false,"text":"主人公とは正反対の性格をしており、感情的でノリがよく、表情がコロコロと変わる。"},{"spoiler":false,"text":"交友関係は広く浅く、友人や知人は多いものの、本人が親友と考えている相手は主人公だけである。"}],"source":"egs","sourceCharacterId":"3229","sourceWorkId":"20174","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86ebdc354d4d54ab4ab2ead455133e2c1ce0dc0e71fa5889823afb5fdecff846.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0c6bc1790d05e746917fc58903bebdbba74dcb591eddbc1a54feff4e2a0dd0c.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c47181","characterName":"高階 律","sourceIds":{"bangumi":[],"egsCharacterIds":["3230"],"vndbCharacterId":"c47181"},"originalCharacterName":"高階 律","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作品の主人公。 地方都市の進学校・篠宮学園に通う2年生の男子学生。"},{"spoiler":false,"text":"勉強やスポーツの成績はそこそこで、控えめな性格のため、クラスでは特に目立つことのない存在。"},{"spoiler":false,"text":"しかし中性的なその容姿と家事スキルの高さ、温厚な人柄が相まって、女子には密かに人気がある。"},{"spoiler":false,"text":"幼い頃に母親を亡くし父子家庭で育ってきたため、料理などの家事が一通り出来る。"},{"spoiler":false,"text":"母親という存在に対して、子供の頃から強い憧れがある。"},{"spoiler":false,"text":"親友である昌樹の母親・由良に対しては、出会った当初から憧れと恋心を抱いてきた。"}],"source":"egs","sourceCharacterId":"3230","sourceWorkId":"20174","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38ef315c334cc8b757a7a062cfda45cf33c7c