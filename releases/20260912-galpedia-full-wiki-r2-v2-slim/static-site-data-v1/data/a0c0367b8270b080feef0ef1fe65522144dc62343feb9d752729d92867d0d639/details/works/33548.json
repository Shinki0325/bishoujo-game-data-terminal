ataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/695d87a38e953cbbbce632dd7c57121f87911823b327b42d76e806941ed33b6d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4dc0c1adf0ae40011ae04d78a04a9415da434c63ac645bd01e318209ad95dd0e.webp","width":120,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤沢れい香","creatorId":"vndb:s14338","sourcePersonId":"vndb:s14338","canonicalEntityId":"vndb:s14338","name":"藤沢 れい香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:407711:120343:32998:1","source":"bangumi"}]},{"characterId":"char_c119036","characterName":"天枝 千羽","sourceIds":{"bangumi":[{"characterId":"120344","match":"exact-normalized-name-in-linked-work","subjectId":"407711"}],"egsCharacterIds":["24461"],"vndbCharacterId":"c119036"},"originalCharacterName":"天枝 千羽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"151"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl whom Kento meets on his school trip and also his cousin's best friend. One year later, because of their parents' remarriage, they reunite and become step-siblings. Because of her petite appearance and cheerful personality, she is adored by everyone around her. She is in love with Kento due to his \"kindness\", and tries to win him over, no matter the cost."},{"spoiler":false,"text":"Translated and edited from Getchu"}],"source":"vndb","sourceCharacterId":"c119036"},{"segments":[{"spoiler":false,"text":"修学旅行先で出会った一年後、親の再婚相手の連れ子として再会し義妹という関係に。"},{"spoiler":false,"text":"過保護な主人公の“厚意”を“好意”と受け取ってしまった結果、お兄ちゃん大好き状態で何としてでも主人公を振り向かせようと奔走する。"}],"source":"egs","sourceCharacterId":"24461","sourceWorkId":"33548","spoiler":false},{"segments":[{"spoiler":false,"text":"修学旅行で出会った一年後、"},{"spoiler":false,"text":"親の再婚相手の連れ子として再会し義妹という関係に。"},{"spoiler":false,"text":"過保護な主人公の\"好意\"を\"厚意\"と受け取ってしまった結果、"},{"spoiler":false,"text":"お兄ちゃん大好き状態で何としてでも主人公を振り向かせようと奔走する。"},{"spoiler":false,"text":"小柄かつ明るいキャラもあり、"},{"spoiler":false,"text":"周囲からはマスコット的な愛されキャラとして可愛がられている。"},{"spoiler":false,"text":"時には自身の好意が兄の負担になっていないかと気にかける場面も。"}],"source":"bangumi","sourceCharacterId":"120344"}],"profileFacts":[{"label":"身高（本版本）","value":"151 cm","valueContext":null,"source":"egs","sourceCharacterId":"24461","sourceWorkId":"33548","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99e6798befe50d5cade5a64086d449d97bf90ed505881f30fb0aa8c34a6d0f01.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/508bae05d152089a3d5cbde43d16c7835a62b7d1032193b073ac06a21c1d1790.webp","width":120,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七種結花","creatorId":"vndb:s22881","sourcePersonId":"vndb:s22881","canonicalEntityId":"vndb:s22881","name":"佐藤 詩乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:407711:120344:56606:1","source":"bangumi"}]},{"characterId":"char_c119108","characterName":"唐朽 氷華","sourceIds":{"bangumi":[{"characterId":"120345","match":"exact-normalized-name-in-linked-work","subjectId":"407711"}],"egsCharacterIds":["24462"],"vndbCharacterId":"c119108"},"originalCharacterName":"唐朽 氷華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl whom Kento helps out on his school trip and later becomes acquainted with each other. Attending a prestigious all-girls school and is admired by the students there due to her personality, she has a strong sense of justice, but can sometime be too honest. Even though she does not know much about it, she longs to experience romance."},{"spoiler":false,"text":"Translated and edited from Getchu"}],"source":"vndb","sourceCharacterId":"c119108"},{"segments":[{"spoiler":false,"text":"修学旅行先で偶然ピンチを助けることになり、それをきっかけに仲を深めていく。"},{"spoiler":false,"text":"とにかく真面目で他人にも身内にも正論を振りかざし、融通がきかないところがある。"},{"spoiler":false,"text":"その一方で夢見がちな一面があり、恋愛に対してはロマンチックな願望を抱いている。"}],"source":"egs","sourceCharacterId":"24462","sourceWorkId":"33548","spoiler":false},{"segments":[{"spoiler":false,"text":"修学旅行先で偶然ピンチを助けることになり、"},{"spoiler":false,"text":"それをきっかけに仲を深めていくことになったお嬢様。"},{"spoiler":false,"text":"超お嬢様校として知られている織音女学園に通っており、"},{"spoiler":false,"text":"本人の人柄と気品のある佇まいで学院の生徒達からも慕われている。"},{"spoiler":false,"text":"とにかく真面目で正義感が強く、時には融通がきかないところがある。"},{"spoiler":false,"text":"その一方で夢見がちな一面があり、"},{"spoiler":false,"text":"恋愛に対してはロマンチックな願望を抱いている。"},{"spoiler":false,"text":"本人にあまり恋愛の知識がなく、"},{"spoiler":false,"text":"異性を意識する場面では初々しい反応をみせることも。"}],"source":"bangumi","sourceCharacterId":"120345"}],"profileFacts":[{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"24462","sourceWorkId":"33548","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec0c0241289f19fba7605dbf32e8334d605835b08da8bc16378258a9a390426e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08d159c3a9725770c05bdc45dcef506785c324f0c7accae6afb418e1ed0bb692.webp","width":120,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さいとうよしえ","creatorId":"vndb:s1545","sourcePersonId":"vndb:s1545","canonicalEntityId":"vndb:s1545","name":"さいとう よしえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:charact