match":"exact-normalized-name-in-linked-work","subjectId":"297024"},{"characterId":"39432","match":"exact-normalized-name-in-linked-work","subjectId":"320895"}],"egsCharacterIds":["4425"],"vndbCharacterId":"c23981"},"originalCharacterName":"白鳥 深琴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"雷系の術を得意とし、大振りの日本刀を妖魔退治に使う退魔師。"},{"spoiler":false,"text":"気が強く、明るく元気な性格。"},{"spoiler":false,"text":"容姿端麗、スタイル抜群の彼女だが、ドジでおっちょこちょい、さらに大雑把な面も。"},{"spoiler":false,"text":"主人公とはケンカ友達だが、家族に近い関係でもある。"}],"source":"egs","sourceCharacterId":"4425","sourceWorkId":"6379","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公兼メインヒロイン。"},{"spoiler":false,"text":"気が強く、明朗快活な美少女で、雷系の術と、日本刀を扱う能力だけは最強の、ドジっ娘退魔師。"},{"spoiler":false,"text":"仕事とはいえ、夏休みの海に行けると旅行感覚でウキウキしている。"}],"source":"egs","sourceCharacterId":"4425","sourceWorkId":"7719","spoiler":false},{"segments":[{"spoiler":false,"text":"気が強く明朗快活な美少女。"},{"spoiler":false,"text":"雷系の術と退魔刀を扱う、若き退魔師。"},{"spoiler":false,"text":"道を歩けば誰もが振り返るほど完璧な顔とスタイルを持っているが、"},{"spoiler":false,"text":"結構ドジでおっちょこちょい。"},{"spoiler":false,"text":"ヤマトとは、いいケンカ友達だが、"},{"spoiler":false,"text":"その胸の奥には別の想いが育っているようだ……。"}],"source":"egs","sourceCharacterId":"4425","sourceWorkId":"12924","spoiler":false},{"segments":[{"spoiler":false,"text":"妹の武とは二卵性の双子。"},{"spoiler":false,"text":"巨乳でポニーテールが特徴。"},{"spoiler":false,"text":"明るく活発で、誰とでも友だちになるようなクラス委員長タイプ。"},{"spoiler":false,"text":"しっかりしているようでドジっ娘な一面も。"},{"spoiler":false,"text":"喜怒哀楽がハッキリしている。"},{"spoiler":false,"text":"胸が大きい事がコンプレックス。"},{"spoiler":false,"text":"ヤマトの事とが好きだが思いをハッキリ伝えた事はない。"},{"spoiler":false,"text":"普段は強気だが、陵辱し墜ちると、子供っぽい雰囲気になってしまう。"},{"spoiler":false,"text":"実は実態が無いオバケが大の苦手。"}],"source":"egs","sourceCharacterId":"4425","sourceWorkId":"20723","spoiler":false},{"segments":[{"spoiler":false,"text":"妹の武とは二卵性の双子。"},{"spoiler":false,"text":"日本刀を召喚して戦う攻撃担当で、黒猫支店では1番活躍している。"},{"spoiler":false,"text":"実は実態が無いオバケが大の苦手。"},{"spoiler":false,"text":"巨乳でポニーテールが特徴。"},{"spoiler":false,"text":"最近の悩み事は胸がさらに大きくなったことと、"},{"spoiler":false,"text":"水依がヤマトに対して積極的になっていること。"},{"spoiler":false,"text":"ヤマトのことが好きだが想いをハッキリ伝えたことはなく、"},{"spoiler":false,"text":"意識し合っているためかついつい喧嘩をしてしまう。"}],"source":"egs","sourceCharacterId":"4425","sourceWorkId":"21343","spoiler":false},{"segments":[{"spoiler":false,"text":"退魔屋本舗黒猫支店の看板退魔師、だった"},{"spoiler":false,"text":"生まれ持って才能のある退魔師だった深琴はスランプなど経験が無く、人生で初めての挫折と屈辱を味わい看板退魔師の座を水依に譲るどころか退魔師としての地位も危うくなり焦っている"},{"spoiler":false,"text":"明るく活発で誰にでも好かれる性格だったが最近はすっかりいじけた性格になってしまった"},{"spoiler":false,"text":"退魔刀「雷光」の正当継承者"},{"spoiler":false,"text":"武とは双子の姉妹で姉"},{"spoiler":false,"text":"かなりの巨乳でスタイル抜群だったがストレスで少し太った事を気にしている"}],"source":"egs","sourceCharacterId":"4425","sourceWorkId":"23117","spoiler":false},{"segments":[{"spoiler":false,"text":"気が強いけど明朗快活な美少女"},{"spoiler":false,"text":"退魔では雷系の攻撃術式を得意とする"},{"spoiler":false,"text":"道を歩けば誰もが振り返るほどの大きな胸と可愛い顔をしているがドジでおっちょこちょいな面がある"},{"spoiler":false,"text":"大雑把な所はヤマトと似た者同士"},{"spoiler":false,"text":"大振りの日本刀『雷光』を退魔に使う"},{"spoiler":false,"text":"ヤマトとは幼馴染でケンカ友達のような関係"}],"source":"egs","sourceCharacterId":"4425","sourceWorkId":"24241","spoiler":false},{"segments":[{"spoiler":false,"text":"退魔屋本舗黒猫支店の看板退魔師。"},{"spoiler":false,"text":"明るく活発で誰にでも好かれる性格だが、水依という強力なライバルの存在のため、近頃では負の部分が顔を出すことも……"},{"spoiler":false,"text":"退魔刀「雷光」の正当継承者。"},{"spoiler":false,"text":"武とは双子の姉妹で姉。"}],"source":"egs","sourceCharacterId":"4425","sourceWorkId":"29034","spoiler":false},{"segments":[{"spoiler":false,"text":"退魔屋本舗黒猫支店の看板退魔師。"},{"spoiler":false,"text":"明るく活発で誰にでも好かれる性格だが、水依という強力なライバルの存在のため、近頃では負の部分が顔を出すことも……"},{"spoiler":false,"text":"退魔刀「雷光」の正当継承者。"},{"spoiler":false,"text":"武とは双子の姉妹で姉。"}],"source":"egs","sourceCharacterId":"4425","sourceWorkId":"30262","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のメインヒロイン 兼 主人公。"},{"spoiler":false,"text":"気が強く、明朗快活な美少女で、雷系の術と、日本刀を扱う能力だけは最強のドジっ娘退魔師。"},{"spoiler":false,"text":"仕事とはいえ、夏休みの海に行けると旅行感覚でウキウキしている。"}],"source":"bangumi","sourceCharacterId":"39432"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe5dbf042178579277ec4fb7898fb2eaed0e4cb042cca88cb705d9a375c46331.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06a84ecd58f4cf47e84bfa6662068843f8004f706bfe5b80f0011beeac6d3c81.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320895:39432:8580:1","source":"bangumi"}]},{"characterId":"char_c23982","characterName":"白鳥 武","sourceIds":{"bangumi":[{"characterId":"39438","match":"exact-normalized-name-in-linked-work","subjectId":"109754"},{"characterId":"39438","match":"exact-normalized-name-in-linked-work","subjectId":"12014"},{"characterId":"39438","match":"exact-normalized-name-in-linked-work","subjectId":"12581"},{"characterId":"39438","match":"exact-normalized-name-in-linked-work","subjectId":"12582"},{"characterId":"39438","match":"exact-normalized-name-in-linked-work","subjectId":"183218"},{"characterId":"39438","match":"exact-normalized-name-in-linked-work","subjectId":"208775"},{"characterId":"39438","match":"exact-normalized-name-in-linked-work","subjectId":"297024"},{"characterId":"39438","match":"exact-normalized-name-in-linked-work","subjectId":"320895"}],"egsCharacterIds":["4424"],"vndbCharacterId":"c23982"},"originalCharacterName":"白鳥 武","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"結界を中心とする補助系の術を得意とする退魔師。"},{"spoiler":false,"text":"顔も正確もスタイルさえも、まったく似てないが深琴の双子の妹。"},{"spoiler":false,"text":"冷静沈着で参謀タイプの彼女。"},{"spoiler":false,"text":"天才肌の深琴にコンプレックスを抱いているようだ。"}],"source":"egs","sourceCharacterId":"4424","sourceWorkId":"6379","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のサブヒロイン。"},{"spoiler":false,"text":"深琴の双子の妹で、参謀タイプの冷静沈着な、男装の麗人。"},{"spoiler":false,"text":"風系の術や、結界が得意。調教され、敵になった過去がある。"},{"spoiler":false,"text":"現在は術で封印しているが、実は触手に調教された後遺症が残っている。"}],"source":"egs","sourceCharacterId":"4424","sourceWorkId":"7719","spoiler":false},{"segments":[{"spoiler":false,"text":"深琴の双子の妹で、参謀タイプの冷静沈着な少女。"},{"spoiler":false,"text":"風系の術や結界を得意とする、将来有望な退魔師。"},{"spoiler":false,"text":"以前一度、妖魔に捕らえられ、その後遺症を引きずっているものの、"},{"spoiler":false,"text":"普段はそんな悲壮感を表情に浮かべることはない。"}],"source":"egs","sourceCharacterId":"4424","sourceWorkId":"12924","spoiler":false},{"segments":[{"spoiler":false,"text":"メガネが似合うクールで、頭脳明晰な黒猫支店の司令塔。"},{"spoiler":false,"text":"黒猫支店の経理などもこなす。"},{"spoiler":false,"text":"性格は基本は無口だが、姉の事となると饒舌になる"},{"spoiler":false,"text":"男嫌いという程ではないが男性は苦手。"},{"spoiler":false,"text":"病的に姉を慕っていて、ヤマトの事はそういう意味で、あまり良く思っていない。"},{"spoiler":false,"text":"黒猫支店では身も心も1番病んでいる。"},{"spoiler":false,"text":"胸の大きさは普通。"}],"source":"egs","sourceCharacterId":"4424","sourceWorkId":"20723","spoiler":false},{"segments":[{"spoiler":false,"text":"メガネが似合うクールな黒猫支店の司令塔。"},{"spoiler":false,"text":"会社の経理などもこなしている。"},{"spoiler":false,"text":"基本は無口だが、姉のこととなると饒舌になる。"},{"spoiler":false,"text":"実は病的に姉を慕っていて、ヤマトのことはそういう意味であまり良く思っていない。"},{"spoiler":false,"text":"妖魔に捕まり凌辱され、それ以来 御札で防護しなければ常に発情状態になってしまう。"},{"spoiler":false,"text":"普段はとても強気で絶対に屈しないように見えるが、"},{"spoiler":false,"text":"堕ちると途端に弱気になって泣きだしてしまうことも。"}],"source":"egs","sourceCharacterId":"4424","sourceWorkId":"21343","spoiler":false},{"segments":[{"spoiler":false,"text":"黒猫支店の主に経理担当で退魔師"},{"spoiler":false,"text":"冷静沈着で頭脳派、凛とした性格ではあるが何度も敵に捕まり激しい陵辱を受け女性としての生殖機能を失っている"},{"spoiler":false,"text":"今も札による補助が無ければ正気を保てない程の強い後遺症に苦しんでいる"},{"spoiler":false,"text":"姉の事を姉妹の関係以上に愛しているが、元々は万能な姉に強いコンプレックスを抱いていた"},{"spoiler":false,"text":"今は退魔師としての力は後遺症のせいで弱まっている"},{"spoiler":false,"text":"以前は深琴への気持ちは隠していたが、最近は開き直って接している"},{"spoiler":false,"text":"怒ると怖いが恋愛ベタな為、異性からの押しに弱い。"}],"source":"egs","sourceCharacterId":"4424","sourceWorkId":"23117","spoiler":false},{"segments":[{"spoiler":false,"text":"顔も性格もスタイルもまったく似ていないが深琴の双子の妹で、参謀タイプの冷静沈着な男装の麗人。"},{"spoiler":false,"text":"結界を中心とした防御など補助系の術式を得意とする。"},{"spoiler":false,"text":"努力家だが、天才肌の深琴にコンプレックスを抱いている"},{"spoiler":false,"text":"怒ると怖いが、実は気が弱い一面も"}],"source":"egs","sourceCharacterId":"4424","sourceWorkId":"24241","spoiler":false},{"segments":[{"spoiler":false,"text":"黒猫支店の主に経理担当で退魔師。"},{"spoiler":false,"text":"冷静沈着で頭脳派、凛とした性格ではあるが、何度も敵に捕まり激しい陵辱を受け女性としての生殖機能を失っている。"},{"spoiler":false,"text":"今も札による補助がなければ正気を保てない程の強い後遺症に苦しんでいる。"},{"spoiler":false,"text":"姉のことを姉妹の関係以上に愛しているが、元々は万能な姉に強いコンプレックスを抱いていた。"},{"spoiler":false,"text":"今は退魔師としての力は後遺症のせいで弱まっている。"},{"spoiler":false,"text":"以前は深琴への気持ちは隠していたが、最近は開き直って接している。"},{"spoiler":false,"text":"怒ると怖いが恋愛ベタな為、異性からの押しに弱い。"}],"source":"egs","sourceCharacterId":"4424","sourceWorkId":"29034","spoiler":false},{"segments":[{"spoiler":false,"text":"黒猫支店の退魔師。"},{"spoiler":false,"text":"冷静沈着で頭脳派、凛とした性格。"},{"spoiler":false,"text":"敵から受けた激しい陵辱の後遺症に今も悩まされ続けている。"},{"spoiler":false,"text":"その傷のため、現在は後方支援が主。"},{"spoiler":false,"text":"後遺症を抑える札を常に体に貼っており、それがないと性欲が暴走してしまう。"}],"source":"egs","sourceCharacterId":"4424","sourceWorkId":"30262","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のサブヒロイン。"},{"spoiler":false,"text":"深琴の双子の妹で、参謀タイプの冷静沈着な、男装の麗人。風系の術や、結界が得意。"},{"spoiler":false,"text":"凌辱調教され、敵になった過去がある。現在は術で封印しているが、実は触手に調教された後遺症が残っている。"}],"source":"bangumi","sourceCharacterId":"39438"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b84bdc07f96c361e547335114eec9e99d0d64e4224db380e8fce11107de44229.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/cha