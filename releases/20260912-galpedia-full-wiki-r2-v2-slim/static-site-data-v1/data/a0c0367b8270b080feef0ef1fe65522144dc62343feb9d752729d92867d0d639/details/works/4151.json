kId":"4151","spoiler":false},{"segments":[{"spoiler":false,"text":"エルが結衣に乗り移ってすこし後、突如屋敷にやってきたメイド。"},{"spoiler":false,"text":"倫敦にいる際に時雄の父・柾時に雇われ、日本にやってきたことを告げる。"},{"spoiler":false,"text":"非常に明るく前向きな性格で、人見知りをしない。"},{"spoiler":false,"text":"得意というだけあり料理の腕は確かだが、その他の家事は全く不得手。"},{"spoiler":false,"text":"お茶をこぼさず運ぶのも一苦労である。"},{"spoiler":false,"text":"そしてどうやら、エルとは何か関係があるらしい。"},{"spoiler":false,"text":"「あ～～、あの、ご主人様？"},{"spoiler":false,"text":"ナタルはこちらでお世話になってもよろしいですか？」"}],"source":"bangumi","sourceCharacterId":"90848"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/171bd7fed0cccc1997524e3dff68790bb90eedc1974d0fd6562fa6bc21657d30.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13d970c57c7851a24b5a1d614d647667134dd36aefc4d8556e7149b23df5571b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本井えみ","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150726:90848:4177:1","source":"bangumi"}]},{"characterId":"char_c19090","characterName":"茅乃","sourceIds":{"bangumi":[{"characterId":"90849","match":"exact-normalized-name-in-linked-work","subjectId":"150726"}],"egsCharacterIds":["12240"],"vndbCharacterId":"c19090"},"originalCharacterName":"茅乃","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"和泉家所有の遊郭「葵屋」にて、一番人気の花魁。"},{"spoiler":false,"text":"美しく艶びやかで、顧客も多い。性格はサバサバとしていて、気風が良い。しかし本人は浮き世のことにあまり興味がないようで、どこか冷めているようにも見える。"},{"spoiler":false,"text":"主人公には「和泉家の若旦那」としていろいろな面で期待しているらしく、最近では女を教えたくて積極的に誘惑してくる。"}],"source":"egs","sourceCharacterId":"12240","sourceWorkId":"4151","spoiler":false},{"segments":[{"spoiler":false,"text":"和泉家所有の遊敦「葵屋」にて、"},{"spoiler":false,"text":"一番人気の花魅。美しく艶やかで、顧客も多い。"},{"spoiler":false,"text":"性格はさばさばとしていて、きっぷがよい。"},{"spoiler":false,"text":"しかし本人は浮き世のことにあまり興味がないようで、"},{"spoiler":false,"text":"どこか冷めているようにも見える。"},{"spoiler":false,"text":"時雄には「和泉家の若旦那」として"},{"spoiler":false,"text":"いろいろな面で期待しているらしく、"},{"spoiler":false,"text":"最近では女を教えたくて積極的に誘惑している。"},{"spoiler":false,"text":"「若旦那だったら商売抜きでいいんだけどね・・・・・・"},{"spoiler":false,"text":"せっかくだから、どうだい今夜？」"}],"source":"bangumi","sourceCharacterId":"90849"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a948d2d1707934fac4770d4576af8269b7c8dc34d82c9582036312b369d577ab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92c5cddca39eacc3211108377c8d2932c7de8c8fa39d9c6fd7b98d1b70a7decb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あらいしずか","creatorId":"vndb:s665","sourcePersonId":"vndb:s665","canonicalEntityId":"vndb:s665","name":"あらい しずか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150726:90849:4647:1","source":"bangumi"}]},{"characterId":"char_c19092","characterName":"和泉 結衣","sourceIds":{"bangumi":[{"characterId":"90846","match":"exact-normalized-name-in-linked-work","subjectId":"150726"}],"egsCharacterIds":["12237"],"vndbCharacterId":"c19092"},"originalCharacterName":"和泉 結衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の妹。赤ん坊の頃に和泉家の前に捨てられており、そのまま引き取られた。"},{"spoiler":false,"text":"性格はおとなしくて引っ込み思案。エルとは正反対である。"},{"spoiler":false,"text":"エルと兄の度重なる行為にしらずと身体は開発され敏感になっているが、本人に性の知識はほとんどなく、とまどっている。"},{"spoiler":false,"text":"エルが表に出ている間の記憶は無く、本人は眠っていると思っているようだ。"}],"source":"egs","sourceCharacterId":"12237","sourceWorkId":"4151","spoiler":false},{"segments":[{"spoiler":false,"text":"時雄の妹。赤ん坊の頃に和泉家の前に捨てられており、"},{"spoiler":false,"text":"そのまま引き取られた。性格はおとなしく引っ込み思案。"},{"spoiler":false,"text":"エルとは正反対である。エルと兄の度重なる行為にしらずと"},{"spoiler":false,"text":"身体は開発され敏感になっているが、"},{"spoiler":false,"text":"本人に性の知識はほとんどなく、とまどっている。"},{"spoiler":false,"text":"エルが表に出ている間の記憶は無く、"},{"spoiler":false,"text":"本人は眠っていると思っているようだ。"},{"spoiler":false,"text":"「兄様、意地悪です・・・・・・"},{"spoiler":false,"text":"わたしだって、いつまでも子供じゃないんですよ」"}],"source":"bangumi","sourceCharacterId":"90846"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/367d55b16565fbf210dd5d04414b368a81ac8e870b5bb997741d326c8c6ea3bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc5e81cea53fd15eb25cd3785359709ffc39727a50b2c66ad537e3dc3cb56263.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150726:90846:4689:1","source":"bangumi"}]},{"characterId":"char_c19093","characterName":"エル","sourceIds":{"bangumi":[{"characterId":"90845","match":"exact-normalized-name-in-linked-work","subjectId":"150726"}],"egsCharacterIds":["12236"],"vndbCharacterId":"c19093"},"originalCharacterName":"エル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"結衣の身体をのっとった、自称「高貴なる吸血姫」。"},{"spoiler":false,"text":"性格は尊大でわがまま。"},{"spoiler":false,"text":"相当長く生きているらしく、時雄や他の人間を子供扱いし、言葉扱いは古めかしい。"},{"spoiler":false,"text":"基本的には夜になると結衣と入れ替わり表に出てくるの