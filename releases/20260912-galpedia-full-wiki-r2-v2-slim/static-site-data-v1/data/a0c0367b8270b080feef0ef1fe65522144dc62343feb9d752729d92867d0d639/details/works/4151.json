],"source":"egs","sourceCharacterId":"12238","sourceWorkId":"4151","spoiler":false},{"segments":[{"spoiler":false,"text":"氷上神社の一人娘。"},{"spoiler":false,"text":"しかし、家が神社であるにもかかわらず看護婦に憧れ、"},{"spoiler":false,"text":"今はクラウスのところに出入りしている。"},{"spoiler":false,"text":"時雄とは幼なじみで小さい頃から密かに想いを寄せているが、"},{"spoiler":false,"text":"それを表には出そうとしない。そのためか、"},{"spoiler":false,"text":"時雄と会えば常に言い合いがたえないようである。"},{"spoiler":false,"text":"一方結衣に対しては実の妹のように接し、良き姉として慕われている。"},{"spoiler":false,"text":"「何言ってるのよ。"},{"spoiler":false,"text":"わたし、君のおさんどんじゃないんだからね。」"}],"source":"bangumi","sourceCharacterId":"90847"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1cc9e1ac2ac987c67cb2f932f8d6607390024060119ef94be3f1a188d6c2ad6f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c22d28a5f581c37347355410e76e20db5bf36723e47fe0de42f8f3bbb00eea96.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150726:90847:4432:1","source":"bangumi"}]},{"characterId":"char_vndb_c19091","characterName":"クラウス・榎田","sourceIds":{"vndbCharacterId":"c19091"},"originalCharacterName":"クラウス・榎田","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc1f09ac6307f0d08f8e5f4687195807e663f4732a0da3786bdb40f2188ac08d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b663b20ca6adc7abc9f51f7af4d7f303178eead97afa00ddda6ac3b536f3f