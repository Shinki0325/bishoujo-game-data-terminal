ts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/259b31fd9c54478bcb1c2de3224ba237c37d9e7046c23a69e894368aa239b522.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88a7255adba42958c56e39db8bd46fda684f4039125a963f90520e042438195e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"斉藤 愛子","creatorId":"vndb:s858","sourcePersonId":"vndb:s858","canonicalEntityId":"vndb:s858","name":"神田 理江","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5916","source":"vndb"}]},{"characterId":"char_c31271","characterName":"リオ","sourceIds":{"bangumi":[{"characterId":"138972","match":"exact-normalized-name-in-linked-work","subjectId":"121629"}],"egsCharacterIds":["25369"],"vndbCharacterId":"c31271"},"originalCharacterName":"リオ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"923"},"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人狼の一族の娘。"},{"spoiler":false,"text":"一応、狼少女なので、普通（？）の狼に変身することが出来るが、人狼としては、まだまだ子供なことから、腕で抱けるくらいの仔犬になってしまう。"},{"spoiler":false,"text":"満月だけでなく、ちょっと気を抜くと丸いものを見ただけで変身してしまう。"},{"spoiler":false,"text":"とにかく元気いっぱいで人懐っこく無邪気な女の子。"},{"spoiler":false,"text":"そろそろお年頃なので発情期に……♪"}],"source":"egs","sourceCharacterId":"25369","sourceWorkId":"7838","spoiler":false},{"segments":[{"spoiler":false,"text":"人狼の一族の娘。"},{"spoiler":false,"text":"狼に変身することができるが、人狼としてはまだまだ○○なので、変身すると子犬のような状態になってしまう。満月だけでなく、ちょっと気を抜くと丸いものを見ただけで変身してしまう。"},{"spoiler":false,"text":"子犬（子狼？）の状態で弱っていたところを、主人公に道端で拾われる。"},{"spoiler":false,"text":"拾ってくれた主人公にとてもよく懐き、甘えてくる。"},{"spoiler":false,"text":"とにかく元気で無邪気な女の子。"},{"spoiler":false,"text":"そろそろお年頃なので発情期がやってくる。"}],"source":"bangumi","sourceCharacterId":"138972"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d800aff8063611cc8b94a90c8f78d274c89f31e733c8aadca01a944e3bd92b14.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac35b6b44d325143f4ebc941c4eb1dc9460f8fc4e4e7f70da2aaa89efa14ea7b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:121629:138972:5900:1","source":"bangumi"}]},{"characterId":"char_c31272","characterName":"徳川院 操","sourceIds":{"bangumi":[{"characterId":"138974","match":"exact-normalized-name-in-linked-work","subjectId":"121629"}],"egsCharacterIds":["25372"],"vndbCharacterId":"c31272"},"originalCharacterName":"徳川院 操","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"現代の天界（尼貝市役所）から派遣された魔物ハンターの見習い。"},{"spoiler":false,"text":"思い込みと勘違い、早とちりが非常に多い女の子。"},{"spoiler":false,"text":"魔王クラスを狩ることに成功すれば正式にハンターとして昇格するとあって張り切っているが、当の魔王である主人公が、まるでショボイので、魔王として認めていない。"},{"spoiler":false,"text":"予算が下りなかったことから、橋の下にテントを張って自給自足の生活をしている。"}],"source":"egs","sourceCharacterId":"25372","sourceWorkId":"7838","spoiler":false},{"segments":[{"spoiler":false,"text":"現代の天界（尼貝市役所）から派遣された魔物ハンター見習い。"},{"spoiler":false,"text":"新たな魔王の誕生に際して、派遣されてきた。"},{"spoiler":false,"text":"魔王クラスを狩れば晴れて正式にハンターに昇格できるため、張り切っている。しかし、主人公があまりにショボいため、魔王だということを信用しない。"},{"spoiler":false,"text":"むしろ同居しているバンパイアたちを危険と思い込み、主人公を魔物の巣窟から助け出そうと悪戦苦闘する。"},{"spoiler":false,"text":"予算が下りなかったので部屋を借りることができず、橋の下でテントを張って生活している。川でいろんなものを取って食べている。（ザリガニ!?）早とちりや勘違いが非常に多い。また、独特のセンスを持っている。"}],"source":"bangumi","sourceCharacterId":"138974"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a1d2d14a4619d4112cbf5f2682260fd69788676b80348ceae73a2015f52dd13.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7b27352e9a746b5bf2c155123563aac29ffc04e5cb041fb82953f252acb2bff.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"入広瀬巴","creatorId":"vndb:s6020","sourcePersonId":"vndb:s6020","canonicalEntityId":"vndb:s6020","name":"入広瀬巴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5918","source":"vndb"}]},{"characterId":"char_c31273","characterName":"天宮 香菜","sourceIds":{"bangumi":[{"characterId":"138973","match":"exact-normalized-name-in-linked-work","subjectId":"121629"}],"egsCharacterIds":["25371"],"vndbCharacterId":"c31273"},"originalCharacterName":"天宮 香菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kana lives next door to the protagonist. She's messy, and has trouble with mathematics. She tends to take care of the protagonist and comes in through his bedroom window to cook for him. She makes curry very well. She gets along with everyone. She has no sexual knowledge."}],"source":"vndb","sourceCharacterId":"c31273"},{"segments":[{"spoiler":false,"text":"主人公の隣の家に住んでいる幼馴染。"},{"spoiler":false,"text":"ドジでおっちょこちょいで、ノーテンキ。"},{"spoiler":false,"text":"ちょっと頭が弱い女の子。ちなみに九九の七の段が言えない。"},{"spoiler":false,"text":"けっこう世話好き。"},{"spoiler":false,"text":"誰とでもすぐに仲良くなれる特技を持つ。"},{"spoiler":false,"text":"性的な知識はまるっきりない。"}],"source":"egs","sourceCharacterId":"25371","sourceWorkId":"7838","spoiler":false},{"segments":[{"spoiler":false,"text":"隣の家に住んでいる幼なじみ。"},{"spoiler":false,"text":"どじでおっちょこちょいで、ノーテンキ。一言でいうと、バカ。"},{"spoiler":false,"text":"九九の七の段が言えない。"},{"spoiler":false,"text":"主人公が比較的しっかりしているのは、彼女があまりにもダメなせいかもしれない。"},{"spoiler":false,"text":"その割には世話焼きで、いつも屋根を伝って窓から主人公の部屋に入ってきては、"},{"spoiler":false,"text":"手料理を食べさせようとする。（カレーは得意）"},{"spoiler":false,"text":"誰とでもすぐに仲良くなれるという特技を持っている。"},{"spoiler":false,"text":"性的な知識はまるでなし。"}],"source":"bangumi","sourceCharacterId":"138973"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/2554713bee09e5c48645757e206fe5f18587c05cb5606aedbe6f3754e4a87bd7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d79e7d069f0595c3f6478c5b36c0878e9e9fe8ea5133f0efc8e602bf3e0a6581.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひびきりん","creatorId":"vndb:s3640","sourcePersonId":"vndb:s3640","canonicalEntityId":"vndb:s3640","name":"ひびき りん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:121629:138973:40661:1","source":"bangumi"}]},{"characterId":"char_vndb_c117396","characterName":"化野 洋一","sourceIds":{"vndbCharacterId":"c117396"},"originalCharacterName":"化野 洋一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/0507ba8ac96fb9ce5ed403dd4ec04f9a09505bd83f890d7d7583df83108fdf32.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/