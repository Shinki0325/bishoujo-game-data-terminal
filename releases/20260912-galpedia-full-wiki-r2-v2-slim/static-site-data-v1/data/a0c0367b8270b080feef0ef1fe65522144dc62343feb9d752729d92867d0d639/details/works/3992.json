bishojo.date/terminal-wiki/v1/characters/v1/images/26/26c9d218dc083214cb59fe0ce9e11bce805d232631c6f6541b86391acb33d22f.webp","width":128,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c4579","characterName":"ライディ","sourceIds":{"bangumi":[{"characterId":"27030","match":"exact-normalized-name-in-linked-work","subjectId":"114486"},{"characterId":"27030","match":"exact-normalized-name-in-linked-work","subjectId":"54716"}],"egsCharacterIds":["25686"],"vndbCharacterId":"c4579"},"originalCharacterName":"ライディ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female warrior who controls the power of lightning. She is strong-willed and hates losing, but has a gentle side as well. Constantly in good spirits, when she has a goal in mind she's the type who pursues it straight to the end. Her ultimate attack is the Thunder Slash, and she considers the yellow bandana she wears to be her trademark style. She seeks to discover why she was given her strange power over lightning in the first place..."},{"spoiler":false,"text":"From JAST USA"}],"source":"vndb","sourceCharacterId":"c4579"},{"segments":[{"spoiler":false,"text":"雷の加護を持つ戦士。"},{"spoiler":false,"text":"気が強く負けず嫌いの反面、優しい面も持っている。"},{"spoiler":false,"text":"明るく健気、思い込んだら一直線というタイプ。"},{"spoiler":false,"text":"雷の加護を持つ戦士で、雷を自由に呼び寄せる事ができ、それを利用した必殺技「サンダー・スラッシュ」を使用。"},{"spoiler":false,"text":"トレードマークは黄色いバンダナ。"}],"source":"egs","sourceCharacterId":"25686","sourceWorkId":"6248","spoiler":false},{"segments":[{"spoiler":false,"text":"雷の加護を持つ戦士。"},{"spoiler":false,"text":"気が強く負けず嫌いの反面、優しい面も持つ。"},{"spoiler":false,"text":"明るく健気、思い込んだら一直線というタイプ。"},{"spoiler":false,"text":"雷の加護を持つことから、雷を自由に呼び寄せることができ、それを利用したサンダー・スラッシュが必殺技。"},{"spoiler":false,"text":"トレードマークは黄色いバンダナ。"}],"source":"egs","sourceCharacterId":"25686","sourceWorkId":"7397","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公。気が強く負けず嫌いの反面、優しい面も持つ美女戦士。雷の力を自由に操り、その力を利用した必殺技「サンダースラッシュ」を武器にエルス大陸を放浪している。並の戦士では太刀打ちできないほどの技量の持ち主でもある。トレードマークは赤い髪と黄色いバンダナ。"},{"spoiler":false,"text":"秩序の神クティーブによって雷の精霊の加護を受けており、混沌神ケイオスの復活阻止が彼女の宿命である。が、『2』の中盤までそのことを知らない。信仰心のない彼女に何故加護があるのかは不明である。"},{"spoiler":false,"text":"どうにも微妙にマゾの気がある。相手からの淫らな行為（無理やりでも）に対して嫌だといいながらも身体は感じてしまうようである（普通の人よりも感じやすい?）。"},{"spoiler":false,"text":"敵に対する『お仕置き』は相手がやっていたことをそのまま味わわせるという因果応報を地でいく成敗だが、時々それに夢中になって我を忘れるあたりサドの素質もあるように見える。ちなみに大抵の場合、お仕置きした後はそのまま放置する。"},{"spoiler":false,"text":"ウィンという名の恋人の存在がほのめかされており、彼を探し出すことと自身の雷を操る力の謎を解明することが彼女の旅の本来の目的である。"},{"spoiler":false,"text":"なお、Windows95版までの設定では19歳。身長は165センチ。後述のキャラクター達も含めて、リメイク版でもこの設定が残っているのかは不明。"},{"spoiler":false,"text":"2の能力値を見る限り、右利きのようである（同じ武器でも右手に持った方が攻撃力・命中率が高い）。"},{"spoiler":false,"text":"ちなみに服装は1と2以降を比較すると2以降のほうが露出度が高く、3では下記のフォレスに露出狂一歩手前とまで言われてしまった。"}],"source":"bangumi","sourceCharacterId":"27030"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a985eef24148c5b811af69dc86c75a1608361affc275c367427699d3a38f88fa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d37c7ef0fbce6be9b19ba56aa123b1c51d79761650c3756a2cd2779c696340e.webp","width":251,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c84134","characterName":"セティア","sourceIds":{"bangumi":[{"characterId":"150920","match":"exact-normalized-name-in-linked-work","subjectId":"114486"}],"egsCharacterIds":["25687"],"vndbCharacterId":"c84134"},"originalCharacterName":"セティア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The beautiful proprietress of the Lake Blue Inn, Setia is a sociable girl who takes an immediate liking