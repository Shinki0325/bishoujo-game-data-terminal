{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"4246","model":{"presentationWorkId":"vndb:v3455","staff":{"artwork":[{"creditedName":"あるて","creatorId":"vndb:s2663","sourcePersonId":"egs:creator:2284","canonicalEntityId":"vndb:s2663","name":"あるて","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5480","source":"egs"}],"scenario":[{"creditedName":"そのだまさき","creatorId":"vndb:s596","sourcePersonId":"egs:creator:900","canonicalEntityId":"vndb:s596","name":"そのだまさき","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5479","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c28764","characterName":"佐藤　沙耶香","sourceIds":{"bangumi":[{"characterId":"94357","match":"exact-normalized-name-in-linked-work","subjectId":"266106"}],"egsCharacterIds":["26921"],"vndbCharacterId":"c28764"},"originalCharacterName":"佐藤　沙耶香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"舞台となる学園に通う女子学生の一人。"},{"spoiler":false,"text":"綺麗な顔立ちの美少女ながら、クールで勝気、人を寄せ付けない雰囲気を持つ。"},{"spoiler":false,"text":"学園には水泳の特待生として入学し、将来を期待される水泳選手。"},{"spoiler":false,"text":"絵梨菜とは気が合うらしく、よく一緒にいるところを見かける。"}],"source":"egs","sourceCharacterId":"26921","sourceWorkId":"4246","spoiler":false},{"segments":[{"spoiler":false,"text":"冷たさを感じさせる美貌をもった少女。今年、水泳の特待生として入学してきた。"},{"spoiler":false,"text":"周囲との関わり合いは拒絶しているふしがある。にも関わらず、主人公には強い関心を示している。とはいえ、それは、他の生徒のような憧れではなく、探るといった感じのものである。"},{"spoiler":false,"text":"勝気でつんっとしたところがあり、同級生たちには敬遠されるが、温和で世話焼きな絵梨奈とは気が合うようで、唯一、友達と呼べるような存在。"}],"source":"bangumi","sourceCharacterId":"94357"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/616d097d9a66924f97a53bec085c34ee785f9d9ff4c09c4ccc4af17ed2b0b00e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fb3c8c99d82b5e07f5e080c8c6ff905b34309514c36c9864f7a0c5d3b3a37f6.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"しまだかおり","creatorId":"vndb:s2665","sourcePersonId":"vndb:s2665","canonicalEntityId":"vndb:s2665","name":"しまだ かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266106:94357:18664:1","source":"bangumi"}]},{"characterId":"char_c28765","characterName":"細川　絵梨菜","sourceIds":{"bangumi":[{"characterId":"94358","match":"exact-normalized-name-in-linked-work","subjectId":"266106"}],"egsCharacterIds":["26920"],"vndbCharacterId":"c28765"},"originalCharacterName":"細川　絵梨菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"舞台となる学園の理事長の孫娘にして、主人公の教え子。"},{"spoiler":false,"text":"温室育ちの生粋のお嬢様で、おっとり優しく、清らかな雰囲気の少女。"},{"spoiler":false,"text":"祖父である理事長から、女子学生から絶大な人気があり、将来を嘱望される主人公と婚約を命じられるが、彼女自身は婚約者になる前から主人公を慕っていた。"}],"source":"egs","sourceCharacterId":"26920","sourceWorkId":"4246","spoiler":false},{"segments":[{"spoiler":false,"text":"柔和な雰囲気を漂わせる優しい美貌の少女。温室育ちの生粋のお嬢様で、学園の理事長の娘。表の顔として将来を嘱望されている主人公の婚約者である。"},{"spoiler":false,"text":"世間ずれしたところもなく、おっとりとした挙措と、悪意というものを知らぬような言動は、周囲から天使と称されるほど。世話を焼くのが好きで、それが迷惑になることはない。周囲とあまり交わろうとしない沙耶香も彼女にだけは打ち解けている。"},{"spoiler":false,"text":"主人公とは以前から面識があり、親が決めた婚約者という以上の感情を抱いてる。"}],"source":"bangumi","sourceCharacterId":"94358"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb9850971bf5baf28b78186721c689e872d9e7671ebeb0ef33f503c65960e999.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f775ccd0c9770c656f5ef915d4d91b8a981304bd1f4e6deea47e4cbedb9bc5af.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c28767","characterName":"秋川 美保","sourceIds":{"bangumi":[{"characterId":"94359","match":"exact-normalized-name-in-linked-work","subjectId":"266106"}],"egsCharacterIds":["26922"],"vndbCharacterId":"c28767"},"originalCharacterName":"秋川 美保","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"舞台となる学園に通う女子学生の一人。"},{"spoiler":false,"text":"あどけなさを残す顔立ちと、愛嬌のある明るく、やや間の抜けた性格から、所属する新体操部の先輩から可愛がられ、マスコット的な存在になっている。"},{"spoiler":false,"text":"身体つきはまだまだ少女っぽいが、新体操部ならではの柔軟でしなやかな肉体を持つ。"}],"source":"egs","sourceCharacterId":"26922","sourceWorkId":"4246","spoiler":false},{"segments":[{"spoiler":false,"text":"舞台となる学園に通う女子学生の一人。"},{"spoiler":false,"text":"あどけなさを残す顔立ちと、愛嬌のある明るく、やや間の抜けた性格から、所属する新体操部の先輩から可愛がられ、マスコット的な存在になっている。"},{"spoiler":false,"text":"身体つきはまだまだ少女っぽいが、新体操部ならではの柔軟でしなやかな肉体を持つ。"}],"source":"bangumi","sourceCharacterId":"94359"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/678a35aa53774196bf9162c6e9bf5817896360c5aa65d9cb2e9fc82f695dbd9f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b622aaf33bfbedf1004280ad34d620df0507d398d6c9dfb02b458fa50bcacb56.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c28768","characterName":"倉田 詩子","sourceIds":{"bangumi":[{"characterId":"94360","match":"exact-normalized-name-in-linked-work","subjectId":"266106"}],"egsCharacterIds":["26923"],"vndbCharacterId":"c28768"},"originalCharacterName":"倉田 詩子","characterNameSource":null,"role":"side","status":"source-only-candidate",