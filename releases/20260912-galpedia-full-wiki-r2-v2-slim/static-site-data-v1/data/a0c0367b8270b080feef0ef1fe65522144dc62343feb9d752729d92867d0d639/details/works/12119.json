ourceCharacterId":"15591","sourceWorkId":"12119","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30e63468acdda1e0658d7e200c82e99d06037891480f34dba59aed8187cc6bc3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca3ecf088fb2fde39f9b9735f60271054650610a3cfb64d89b2867510d21c3f3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15894:166293:4810:1","source":"bangumi"}]},{"characterId":"char_c64259","characterName":"咲那","sourceIds":{"bangumi":[{"characterId":"166294","match":"exact-normalized-name-in-linked-work","subjectId":"15894"}],"egsCharacterIds":["15592"],"vndbCharacterId":"c64259"},"originalCharacterName":"咲那","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と荻乃の中学時代からの幼馴染で、親友。19歳。"},{"spoiler":false,"text":"主人公と同じ弓道部に所属し、荻乃と一緒に副部長を務めている。"},{"spoiler":false,"text":"性格は明るく、ややボーイッシュ。気も強いが、女の子らしい面もしっかり持っている。"},{"spoiler":false,"text":"行動力もあるが、エッチに関しては、やや奥手気味。"},{"spoiler":false,"text":"主人公と荻乃がエッチしているところを目撃してしまい、自分が主人公のことを好きだったことに気付いてしまう。"},{"spoiler":false,"text":"「まぁた男どもがくだらないこと考えてるんでしょ」"}],"source":"egs","sourceCharacterId":"15592","sourceWorkId":"12119","spoiler":false},{"segments":[{"spoiler":false,"text":"優麻と荻乃の幼なじみで親友。もうひとりの弓道部副部長。"},{"spoiler":false,"text":"明るく行動力があり気は○いが、女の子らしい優しさも持っている。また、エッチな行為に関して、過敏に反応する。"},{"spoiler":false,"text":"優麻とは悪友でいたいと思っているのだが、優麻と荻野のエッチを偶然目撃し、そのことが原因で本当の自分の気持ちに気づいてしまう。"},{"spoiler":false,"text":"「ゆうまっ！　こんのぉ～～スケベ！　変態 !!　ゆうまにはおぎのがいるでしょうがっ !!」"}],"source":"bangumi","sourceCharacterId":"166294"}],"profileFacts":[{"label":"年龄（本版本）","value":"19 岁","valueContext":null,"source":"egs","sourceCharacterId":"15592","sourceWorkId":"12119","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44372defa71fd58b702071f79b0fac17a4c2b5d7affc51e499f637937aa5fefd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c9c4f1efe80b61787aed4ba5fcfd730155181d8529675d162f6192ca44f8f06.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日アン(春乃うらら)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15894:166294:6480:1","source":"bangumi"}]},{"characterId":"char_c64260","characterName":"綾華","sourceIds":{"bangumi":[{"characterId":"166295","match":"exact-normalized-name-in-linked-work","subjectId":"15894"}],"egsCharacterIds":["15593"],"vndbCharacterId":"c64260"},"originalCharacterName":"綾華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が部長を務める弓道部に所属する後輩の女の子。部のマスコット的な存在。18歳。"},{"spoiler":false,"text":"主人公の親友で、部員である尊の恋人。"},{"spoiler":false,"text":"性格は大人しいが、天然気味で何かとトロく、ドジッ娘。しかし、意外に芯が強く、頑固な一面も。"},{"spoiler":false,"text":"弓道歴は部員の中では一番長く、実力もあるが、本番に弱く、大会ではあまり良い成績をあげられない。"},{"spoiler":false,"text":"神社の家系に生まれ、巫女として育ったためか、霊感が強い。"},{"spoiler":false,"text":"「嫌な霧……なんだか、ずっとこっち見てるみたい」"}],"source":"egs","sourceCharacterId":"15593","sourceWorkId":"12119","spoiler":false},{"segments":[{"spoiler":false,"text":"弓道部部員。荻乃と咲那の後輩で、団体選手のひとり。尊とは恋人同士。"},{"spoiler":false,"text":"おとなしい性格の天然ドジっ娘だが、芯は○く頑固なところもある。"},{"spoiler":false,"text":"家が神社のせいか、弓道暦は部員の中で一番長く実力もあるが、本番に弱いタイプ。また、巫女として育ったため、霊感が○いものの幽霊は苦手。"},{"spoiler":false,"text":"「あぅぅ～～。ダ、ダメですよぉ～～。おぎの先輩もさくな先輩も……あやかのこと……からかわないでくださぃ……」"}],"source":"bangumi","sourceCharacterId":"166295"}],"profileFacts":[{"label":"年龄（本版本）","value":"18 岁","valueContext":null,"source":"egs","sourceCharacterId":"15593","sourceWorkId":"12119","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/bee67f4ff064c01d3c835e4ae4ccd60e1cacab12cd318210b0229170aacb20a0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58569da420db1fc2274757cd5e5050e341c53993601ef48f9cd35e9f2c718030.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c64261","characterName":"椿","sourceIds":{"vndbCharacterId":"c64261"},"originalCharacterName":"椿","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4655b8d36e14c7c7973b976f9c6a147925f2ae3902503ff4cd4b6d946381c0b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80930e1f2a61cc9ef6c9286911e2a941234014f7d17bdbc2ee85ea84ecde049a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c64262","characterName":"尊","sourceIds":{"vndbCharacterId":"c64262"},"originalCharacterName":"尊","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishoj