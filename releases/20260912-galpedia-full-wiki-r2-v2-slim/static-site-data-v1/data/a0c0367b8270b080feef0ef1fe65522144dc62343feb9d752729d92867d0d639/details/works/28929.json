ource-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"セント・テレジア学院一年生。"},{"spoiler":false,"text":"誰からも可愛がられる学園のマスコット的な存在だが、実は小悪魔的な策略家。"},{"spoiler":false,"text":"理事長の孫娘であることから、イタズラしたり、からかったりとやりたい放題だが、それは両親が居ない寂しさを紛らわそうとしているだけ。"},{"spoiler":false,"text":"主人公をからかいやすい田舎少女だと、何かと構ってくる。"}],"source":"egs","sourceCharacterId":"21134","sourceWorkId":"8974","spoiler":false},{"segments":[{"spoiler":false,"text":"学园的吉祥物。"},{"spoiler":false,"text":"虽然招人喜爱但其实隐藏了本性，真正的她是一个小恶魔般的策略家。"},{"spoiler":false,"text":"知道她本性的，只有很少一部分人。"},{"spoiler":false,"text":"想到各种各样的恶作剧后就会戏弄周围的人来作乐。"},{"spoiler":false,"text":"凭着是理事长的孙女而为所欲为，但其实这是为了转移自己因双亲不在而产生的寂寞感。"},{"spoiler":false,"text":"把主人公看作是容易戏弄的乡下少女，而打算用各种方法来戏弄他。"},{"spoiler":false,"text":"兴趣是上网和园艺。"}],"source":"bangumi","sourceCharacterId":"11483"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/635db864c31ff0ee8ab7ada147406538b159f7799ea1c54faf406fef49742aa6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00dafb65ff262e021b0e58a2051cf74d05ff3ee649dfff0bbd7942c4c5b0ca64.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:294999:11483:4675:1","source":"bangumi"}]},{"characterId":"char_c5611","characterName":"椿原 蓮","sourceIds":{"bangumi":[{"characterId":"11482","match":"exact-normalized-name-in-linked-work","subjectId":"10952"}],"egsCharacterIds":["21133"],"vndbCharacterId":"c5611"},"originalCharacterName":"椿原 蓮","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"8月16日"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"セント・テレジア学院二年生。"},{"spoiler":false,"text":"国家議員の一人娘。主人公のクラスメイト。"},{"spoiler":false,"text":"全校の運動部を一手に引き受ける運動神経抜群の少女。"},{"spoiler":false,"text":"学園の“オスカル”的存在。"},{"spoiler":false,"text":"正義感の強い、さっぱりとしていて真っ直ぐな性格。"}],"source":"egs","sourceCharacterId":"21133","sourceWorkId":"8974","spoiler":false},{"segments":[{"spoiler":false,"text":"一手包揽全校运动部的超级运动神经少女。"},{"spoiler":false,"text":"学园的奥斯卡大人指的就是她。与修史在同一班级。"},{"spoiler":false,"text":"在老师面面前扮演着淑女，但一旦只有知道自己根底的人在的时候，瞬间就会变得碎碎念。"},{"spoiler":false,"text":"性格正直，注重正义不会饶恕恶的存在。锄强扶弱的类型。"},{"spoiler":false,"text":"国家议员的独生女。兴趣是篮球、吃大量甜品。"}],"source":"bangumi","sourceCharacterId":"11482"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/839fb6b40a9dbff716b708cceb8e7773517ea8b7488b78fa6b2dfb7175f4550f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da8dc241a289ce806ca8aa3ba973093a8ef748cd8fca4998a6ac1dabee51ad1e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:294999:11482:4956:1","source":"bangumi"}]},{"characterId":"char_c5613","characterName":"桜庭 優","sourceIds":{"bangumi":[{"characterId":"197732","match":"exact-normalized-name-in-linked-work","subjectId":"10952"}],"egsCharacterIds":["21137"],"vndbCharacterId":"c5613"},"originalCharacterName":"桜庭 優","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Like Shuuji, Yuu is also a crossdresser but in reality he is an assassin sent by the organization to kidnap Marina. His real name is Liu Xiao Yan."}],"source":"vndb","sourceCharacterId":"c5613"},{"segments":[{"spoiler":false,"text":"セント・テレジア学院一年生。"},{"spoiler":false,"text":"主人公を“お姉さま”と慕って、懐いてくる少女。"},{"spoiler":false,"text":"明るい性格と、可愛らしい容姿から上級生からの人気も上々。"},{"spoiler":false,"text":"そんな彼女だが、運動神経が抜群。"}],"source":"egs","sourceCharacterId":"21137","sourceWorkId":"8974","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公を「お姉さま」と慕い、寄り添ってくる一年生。"},{"spoiler":false,"text":"背が小さく可愛いため、まるで妖精のよう……と上級生に大人気。"},{"spoiler":false,"text":"鞠奈とは同じクラスで、その明るい性格から皆に好かれている。"},{"spoiler":false,"text":"実は運動神経抜群で、時折、周囲を驚かせることがある。"}],"source":"bangumi","sourceCharacterId":"197732"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d4e77d326c43f6b51b60a470db260480780cfa8d8dcda7b5537a58b9cc47e77.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/ebb0846613fed8ce75132c58fcbe23cfe9f392a93b652efab36bcb2257e221de.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田佳代","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:294999:197732:6038:1","source":"bangumi"}]},{"characterId":"char_c5614","characterName":"春日崎 雪乃","sourceIds":{"bangumi":[{"characterId":"11481","match":"exact-normalized-name-in-linked-work","subjectId":"10952"}],"egsCharacterIds":["21132"],"vndbCharacterId":"c5614"},"originalCharacterName":"春日崎 雪乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"12月1日"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"セント・テレジア学院三年生。学園の学生会長。"},{"spoiler":false,"text":"春日崎財閥の令嬢。"},{"spoiler":false,"text":"全校女学生の憧れの的で、“お姉さま”といえば彼女のこと。"},{"spoiler":false,"text":"性格は面倒見がよく、責任感が強いものの、自信家で、高飛車な上に高圧的。"},{"spoiler":false,"text":"主人公を田舎出身の少女と思い込み、この学園から巣立つレディに相応しい人物に育てるのが義務だと勝手に考えているようだ。"}],"source":"egs","sourceCharacterId":"21132","sourceWorkId":"8974","spoiler":false},{"segments":[{"spoiler":false,"text":"作为学园的学生会长被全校女生憧憬着。说到姐姐大人指的就是她。"},{"spoiler":false,"text":"虽然生着很会照顾人、责任感的性格，但非常高傲又高压。时常充满着自信。"},{"spoiler":false,"text":"把主人公当作什么都不懂的乡下少女来看待，因而以把他培养成名副其实的能从该学园毕业的女士作为赋予自己的义务，擅自如此考虑着。"},{"spoiler":false,"text":"春日崎财阀的大小姐。兴趣是红茶和读书。"}],"source":"bangumi","sourceCharacterId":"11481"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afa2b4bcb413c8b803ab83808bc311bda0dee01c375cd99a1be6122d99fab401.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f318ca981a9e0f0ab46fd06a3bb87f8c4adedc8e7987660fcfae830fd8172d66.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:294999:11481:4432:1","source":"bangumi"}]},{"characterId":"char_c5616","characterName":"穂村 有里","sourceIds":{"bangumi":[{"characterId":"11484","match":"exact-normalized-name-in-linked-work","subjectId":"10952"}],"egsCharacterIds":["21136"],"vndbCharacterId":"c5616"},"originalCharacterName":"穂村 有里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"10月10日"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"セント・テレジア学院二年生。"},{"spoiler":false,"text":"主人公とは違う組織から送り込まれてきたエージェント。"},{"spoiler":false,"text":"戦闘能力はあまり高くないが、潜入能力と情報収集能力に優れ、連絡員的な役割を担うことが多い。"},{"spoiler":false,"text":"人懐っこい性格ながら、キレると手が付けれないほど恐ろしい。"},{"spoiler":false,"text":"主人公の正体を知っており、主人公にコンプレックスを抱いているようだ。"}],"source":"egs","sourceCharacterId":"21136","sourceWorkId":"8974","spoiler":false},{"segments":[{"spoiler":false,"text":"与主人公不同的、从别处组织送来的精英。"},{"spoiler":false,"text":"战斗能力・护卫能力完全不高，但潜入能力和情报收集能力优秀，因而经常作为联络员而活跃。"},{"spoiler":false,"text":"主人公的真实身份，也已在事前入手的情报中得知。"},{"spoiler":false,"text":"待人友善的性格和表里如一的言行使得其深受周围喜爱，但大脑断线后比谁都可怕。"},{"spoiler":false,"text":"内心对主人公怀着自卑感，偶尔与主人公对抗时也……"},{"spoiler":false,"text":"没有兴趣爱好，但最近陷入减肥困扰之中。"}],"source":"bangumi","sourceCharacterId":"11484"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff56e2b863b7f05a8f6aa9ef9b07614333e7ef6078d27a7d61dce9e24744841a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d5403a96a4c6c30d241dd6f90ca74abf1a36d4b9e7a475eb154951567d7ad5c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"有賀友利恵","creatorId":"vndb:s14873","sourcePersonId":"vndb:s14873","canonicalEntityId":"vndb:s14873","name":"猫屋敷舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:294999:11484:36266:1","source":"bangumi"}]},{"characterId":"char_c5618","characterName":"真田 設子","sourceIds":{"bangumi":[{"characterId":"11485","match":"exact-normalized-name-in-linked-work","subjectId