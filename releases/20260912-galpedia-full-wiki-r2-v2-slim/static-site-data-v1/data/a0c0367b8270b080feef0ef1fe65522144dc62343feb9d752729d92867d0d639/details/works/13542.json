tityStatus":"source-native","relationId":"vndb:vn-staff:42767","source":"vndb"},{"creditedName":"有限会社フルール","creatorId":"vndb:s22158","sourcePersonId":"vndb:s22158","canonicalEntityId":"vndb:s22158","name":"有限会社フルール","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:42768","source":"vndb"},{"creditedName":"フェイバリット","creatorId":"vndb:s22159","sourcePersonId":"vndb:s22159","canonicalEntityId":"vndb:s22159","name":"フェイバリット","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:42769","source":"vndb"}]},"cast":[{"characterId":"char_c6887","characterName":"楠 美雨","sourceIds":{"bangumi":[{"characterId":"12720","match":"exact-normalized-name-in-linked-work","subjectId":"14413"}],"egsCharacterIds":["12953"],"vndbCharacterId":"c6887"},"originalCharacterName":"楠 美雨","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"50"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"セレブ学園に通う庶民娘。 特待生として零のクラスメイトになる。"},{"spoiler":false,"text":"ピンチを救ってくれた零に好意を抱くも、自分では身分違いのような気がして言い出せない。"},{"spoiler":false,"text":"学業優秀で性格も良いのに何故か自分に自信が持てず、いつも落ち込んでばかりいて零に励まされている。"},{"spoiler":false,"text":"料理や裁縫など女の子らしいこと全般が得意で、将来の夢はデザイナー。"},{"spoiler":false,"text":"可憐な美少女なので、男子に非常に人気がある。"},{"spoiler":false,"text":"いじめられっ子体質。"}],"source":"egs","sourceCharacterId":"12953","sourceWorkId":"13542","spoiler":false},{"segments":[{"spoiler":false,"text":"在セレブ学園上学的平民女孩子。"},{"spoiler":false,"text":"零的同班同学，也是免费生。"},{"spoiler":false,"text":"曾经在危机时刻被零所救，从那之后就对他抱有好感，然而因为在意两人之间的身份差距而不敢表白。"},{"spoiler":false,"text":"成绩优秀加之性格很好，不知为何却有点欠缺自信，总是很容易就变得消沉，每次都是零来鼓励她。"},{"spoiler":false,"text":"像料理、裁缝之类女孩子应该会的手艺，她都样样精通，梦想是将来成为一名设计师。"},{"spoiler":false,"text":"由于是个惹人怜爱的美少女，很受男孩子们欢迎。"},{"spoiler":false,"text":"附带一提，是个很容易被人欺负的人。"}],"source":"bangumi","sourceCharacterId":"12720"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"12953","sourceWorkId":"13542","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"12953","sourceWorkId":"13542","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"12953","sourceWorkId":"13542","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"12953","sourceWorkId":"13542","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"40 kg","valueContext":null,"source":"egs","sourceCharacterId":"12953","sourceWorkId":"13542","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25701d78964673065b9c4e2956ea16c285d807080c428a83c68aa5ecd60b9698.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b7d9034a98352ca63ec3e03040bc8821bbb2c2600fd4839b7d55581419c6bff.webp","width":120,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永瀬江美弥","creatorId":"vndb:s61","sourcePersonId":"vndb:s61","canonicalEntityId":"vndb:s61","name":"永瀬 いくみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14413:12720:6549:1","source":"bangumi"}]},{"characterId":"char_c6888","characterName":"本多 世枝瑠","sourceIds":{"bangumi":[{"characterId":"12721","match":"exact-normalized-name-in-linked-work","subjectId":"14413"}],"egsCharacterIds":["12954"],"vndbCharacterId":"c6888"},"originalCharacterName":"本多 世枝瑠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"77"},"height":{"reviewState":"no-conflict","source":"vndb","value":"143"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"43"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"零の義妹。"},{"spoiler":false,"text":"零と世枝瑠の親は再婚同士で、世枝瑠は父の連れ子なので零と血は繋がっていない。"},{"spoiler":false,"text":"兄である零に密かな好意を抱いているが、素直になれずついそっけない態度を取ってしまう。"},{"spoiler":false,"text":"零に何か言われると、すぐ否定したり正反対のことを言い返したりする。"},{"spoiler":false,"text":"甘いものが好きで、甘いものを食べている時はとても素直。"},{"spoiler":false,"text":"零が作るキャラメルハニーパンケーキが大好物。"}],"source":"egs","sourceCharacterId":"12954","sourceWorkId":"13542","spoiler":false},{"segments":[{"spoiler":false,"text":"零没有血缘关系的妹妹。"},{"spoiler":false,"text":"零的母亲和世枝瑠的父亲是再婚的，而世枝瑠则是父亲与前妻的孩子，所以她跟零其实并没有血缘关系。"},{"spoiler":false,"text":"对于身为哥哥的零，她其实抱持着深深的爱意，但并没让那份感情表露出来，反倒向来冷淡相待。"},{"spoiler":false,"text":"无论零对她说什么，她总是立马否定，刻意跟他唱反调。"},{"spoiler":false,"text":"很喜欢吃甜食，也只有在吃甜食的时候才会变得坦率。"},{"spoiler":false,"text":"最喜欢吃的是零特制的奶糖蜂蜜薄煎饼。"}],"source":"bangumi","sourceCharacterId":"12721"}],"profileFacts":[{"label":"胸围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"12954","sourceWorkId":"13542","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"143 cm","valueContext":null,"source":"egs","sourceCharacterId":"12954","sourceWorkId":"13542","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"12954","sourceWorkId":"13542","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"43 cm","valueContext":null,"source":"egs","sourceCharacterId":"12954","sourceWorkId":"13542","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"38 kg","valueContext":null,"source":"egs","sourceCharacterId":"12954","sourceWorkId":"13542","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c427f3a944a7fcc78c2081c8250f8cf0d1903e25a94e56d9ece6f857b617a982.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd0435237772542c6084f78a35bcca01a01213c5f650a8bed806c6e072c267c2.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14413:12721:5890:1","source":"bangumi"}]},{"characterId":"char_c6889","characterName":"花山院 紫子","sourceIds":{"bangumi":[{"characterId":"12722","match":"exact-normalized-name-in-linked-work","subjectId":"14413"}],"egsCharacterIds":["12955"],"vndbCharacterId":"c6889"},"originalCharacterName":"花山院 紫子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本多家の隣家に住むお嬢様で、零の幼なじみ。"},{"spoiler":false,"text":"その家柄は平安時代の貴族にまで遡れるほど由緒正しく、どんな時にも常に上品さを失わない THE・お嬢様。"},{"spoiler":false,"text":"勉強も運動も得意、おまけに超美人な彼女には欠点と呼べるほどの欠点は見当たらず、本人もそれを自覚しているのでプライドは高い。"},{"spoiler":false,"text":"だからといって高慢に振舞うわけではなく、人当たりは良い。"},{"spoiler":false,"text":"馬術部所属。"},{"spoiler":false,"text":"その典雅な生まれと美貌から、学園では “紫子様” と呼ばれている。"},{"spoiler":false,"text":"広く浅く友達付き合いをしている彼女が本当に心を開けるのは、零にだけだったりする。"}],"source":"egs","sourceCharacterId":"12955","sourceWorkId":"13542","spoiler":false},{"segments":[{"spoiler":false,"text":"住在本多家附近的千金大小姐，也是零的青梅竹马。"},{"spoiler":false,"text":"是个有着可追溯到平安时代的贵族家系的名门世家，也因此无论何时她总是不失高贵，名符其实的千金大小姐。"},{"spoiler":false,"text":"学习也好，运动也罢，她都很擅长，再加上天生就是超级美女，根本就找不到可称之为缺点的地方，本人也认识到了这点，因此自尊也很高。"},{"spoiler":false,"text":"虽说如此，但也全然没有高傲的生活态度，待人接物更是温柔敦厚。"},{"spoiler":false,"text":"由于她那温文典雅的作风以及那美貌姿态，在学校里总被称呼为「紫子大人」。"},{"spoiler":false,"text":"交友圈虽然很广，但并没多少深交的朋友，真正能让她敞开心灵相待的，也就只有零而已了。"},{"spoiler":false,"text":"隶属于马术部。"}],"source":"bangumi","sourceCharacterId":"12722"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"12955","sourceWorkId":"13542","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"12955","sourceWorkId":"13542","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"12955","sourceWorkId":"13542","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"12955","sourceWorkId":"13542","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"45 kg","valueContext":null,"source":"egs","sourceCharacterId":"12955","sourceWorkId":"13542","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6efcde8db19c7b00699c9046676edbfc0e8e5f9b3dfde58aac0a6d0014653df.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af312457669a67e0a2868afc4d008d921ce45f2dab5e5c6f854bad32505a1e17.webp","width":119,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14413:12722:4937:1","source":"bangumi"}]},{"characterId":"char_c6890","characterName":"尾瀬 杏夏","sourceIds":{"bangumi":[{"characterId":"12724","match":"exact-normalized-name-in-linked-work","subjectId":"14413"}],"egsCharacterIds":["12957"],"vndbCharacterId":"c6890"},"originalCharacterName":"尾瀬 杏夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"120"},"height":{"reviewState":"no-conflict","source":"vndb","value":"169"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"零の母の優秀な助手。"},{"spoiler":false,"text":"まだ大学生だがほとんど大学には行かず、本多家の研究室で研究に明け暮れている。"},{"spoiler":false,"text":"（零の両親が不在の間、本多家に留守番役として同居している）。"},{"spoiler":false,"text":"超巨乳で大人っぽい雰囲気だが、実は夢見る乙女的なところがあり、まだ処女。"},{"spoiler":false,"text":"内心それをすごく気に病んでいるが、表には出さない。"},{"spoiler":false,"text":"巨乳を誇示するようなファッションで家の中をうろうろするので、目のやり場に困ってしまうことも。"}],"source":"egs","sourceCharacterId":"12957","sourceWorkId":"13542","spoiler":false},{"segments":[{"spoiler":false,"text":"零的母亲的助手，很是优秀。"},{"spoiler":false,"text":"其实目前还是大学生，虽说基本上不去上学，只是成天在本多家的研究室里做自己的研究（零的双亲不在的时候，她也就以看家人的身份和零他们同居）。"},{"spoiler":false,"text":"超级巨乳，总给人一种成熟女性的气息，实际上还是有着爱做梦的少女情怀，还是处女。"},{"spoiler":false,"text":"内心对这一点很是在意，只是不表露出来罢了。"},{"spoiler":false,"text":"经常会穿着仿佛为了炫耀她那火爆身材的服装，在家里游荡，让人不知该往哪看。"}],"source":"bangumi","sourceCharacterId":"12724"}],"profileFacts":[{"label":"胸围（本版本）","value":"120 cm","valueContext":null,"source":"egs","sourceCharacterId":"12957","sourceWorkId":"13542","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"169 cm","