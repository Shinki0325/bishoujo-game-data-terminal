:false,"text":"The protagonist's Japanese history teacher."},{"spoiler":false,"text":"Because he intends to quit his job he's always buying lottery tickets and other such things, but he never scratches them off."},{"spoiler":false,"text":"He doesn't advise for any clubs so instead he looks after the courtyard garden."}],"source":"vndb","sourceCharacterId":"c70120"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/abda4314cc5c5ef8d4c547278dd58cfd9e20edc84e2fb602524d9d7cb5eb5f49.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/352fe77eab9d8a17cc9b50beccd8bf22a213aae07e8e15c93e28940955b789e2.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳥海 浩輔","creatorId":"vndb:s45","sourcePersonId":"vndb:s45","canonicalEntityId":"vndb:s45","name":"鳥海 浩輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:75436","source":"vndb"}]},{"characterId":"char_vndb_c70121","characterName":"楡居 凪","sourceIds":{"vndbCharacterId":"c70121"},"originalCharacterName":"楡居 凪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A transfer student who comes into the protagonist's class."},{"spoiler":false,"text":"He's a blunt realist who seems to hate women, but when he talks to other guys he seems a little friendlier."},{"spoiler":false,"text":"Because of some misunderstanding between him and the protagonist on the day he transferred in their relationship is like cats and dogs."},{"spoiler":false,"text":"He's always listening to music on his earphones."}],"source":"vndb","sourceCharacterId":"c70121"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bi