r":false,"text":"主人公、未緒、刹那のクラスメイトであり、4人グループでよく遊ぶ仲。"},{"spoiler":false,"text":"率先して色々な世話を焼いてくれる、グループの “母親”っぽい存在、ムードメーカーでもある。"},{"spoiler":false,"text":"美術部員の彼女はデザインなどを得意とし、チラシやプリント類、卒業文集等のヘルプを頼まれている。"},{"spoiler":false,"text":"また、叔父が経営する喫茶店でたまにバイトをしている。"}],"source":"bangumi","sourceCharacterId":"45342"}],"profileFacts":[{"label":"性格","source":"bangumi","sourceCharacterId":"45342","value":"世話焼きのムードメーカー"},{"label":"星座","source":"bangumi","sourceCharacterId":"45342","value":"蟹座"},{"label":"職業","source":"bangumi","sourceCharacterId":"45342","value":"茜坂学園2年生"},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"11444","sourceWorkId":"15102","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81b620bccc6f1e75b601097c542a4327816e752bd4890b28ef5056564b3f01e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d2e2fd1f9883ecf0bca46c88458f28802c9a6a61a105443fbe834c2776e6ce2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14141:45342:4463:1","source":"bangumi"}]},{"characterId":"char_c18213","characterName":"浅葉 ののか","sourceIds":{"bangumi":[{"characterId":"12339","match":"exact-normalized-name-in-linked-work","subjectId":"14141"}],"egsCharacterIds":["11443"],"vndbCharacterId":"c18213"},"originalCharacterName":"浅葉 ののか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"305"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が所属するサッカー部のマネージャー。"},{"spoiler":false,"text":"主人公より一年下の後輩にあたるが、主人公達のグループに交じって遊んだりするなど、なついている。"},{"spoiler":false,"text":"主人公達のパシリを買って出るなど、気が利く部分もあるがちょっと落ち着きがない。"},{"spoiler":false,"text":"実家が経営するコンビニの手伝いをしており、余った品を差し入れとして持ってくる。猫舌で熱い物が苦手。"}],"source":"egs","sourceCharacterId":"11443","sourceWorkId":"15102","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公所属的足球部的经理人。"},{"spoiler":false,"text":"是比主人公小一岁的后辈，和主人公们一伙一起玩等，很熟。"},{"spoiler":false,"text":"有着会主动帮人当跑腿等很细心的一面，只是有点不够沉着稳重。"},{"spoiler":false,"text":"在家里经营的便利店帮手，经常把卖剩不要的东西送来当慰劳品。"},{"spoiler":false,"text":"猫舌怕吃热。"}],"source":"bangumi","sourceCharacterId":"12339"}],"profileFacts":[{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"11443","sourceWorkId":"15102","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50cf7aeef2b64884a2454cab678634d137740cb9f5a6bd86b2af3c2f16819fec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5331bc7ce327b33170563537d359f152e52246648342d241b3aabfd071f997d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14141:12339:5741:1","source":"bangumi"}]},{"characterId":"char_c18214","characterName":"遠峰　凪沙","sourceIds":{"bangumi":[{"characterId":"12340","match":"exact-normalized-name-in-linked-work","subjectId":"14141"}],"egsCharacterIds":["11445"],"vndbCharacterId":"c18214"},"originalCharacterName":"遠峰　凪沙","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"913"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の従姉であり、現在浪人生。"},{"spoiler":false,"text":"主人公の父親が長期出張しているので、家事などの世話をする為に主人公宅に居候している。"},{"spoiler":false,"text":"面倒見がよく、お姉さんというイメージがまさにぴったりの落ち着いた女性。"},{"spoiler":false,"text":"主人公とは幼少の頃から交流があり、弟のように思っている。時にはからかうお茶目さも。"}],"source":"egs","sourceCharacterId":"11445","sourceWorkId":"15102","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的表姐，现在是重考生。"},{"spoiler":false,"text":"因为主人公的父亲长期出差中，为了照顾主人公的起居而在寄居在主人公家里。"},{"spoiler":false,"text":"很会照顾人，和“姐姐”这一印象很合适的稳重女性。"},{"spoiler":false,"text":"和主人公在年幼时也有交流，将他当作是弟弟般。有时也爱开点玩笑。"}],"source":"bangumi","sourceCharacterId":"12340"}],"profileFacts":[{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"11445","sourceWorkId":"15102","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36d9a28dea2bb19bee995bd8ccf553fd6380b78052f538c6b92e544f68aae4f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d22e29f89e4eeed8b6e1598fa1d871cc62b23a41cca78bbaac8c04491049f946.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14141:12340:4832:1","source":"bangumi"}]},{"characterId":"char_c18216","characterName":"柊　歩","sourceIds":{"bangumi":[{"characterId":"12341","match":"exact-normalized-name-in-linked-work","subjectId":"14141"}],"egsCharacterIds":["11446"],"vndbCharacterId":"c18216"},"originalCharacterName":"柊　歩","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"517"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"違う学園の学生であり、主人公にとって、学園の仲良しグループやお姉さん的存在である凪沙とはイメージの異なる存在。"},{"spoiler":false,"text":"主人公と同年代ながら、言動がスマートで颯爽としており、また自分に厳しい面を持つ、大人のような存在。"},{"spoiler":false,"text":"ふとしたことから主人公と知り合いになる。"},{"spoiler":false,"text":"アルバイトをしており、いつも忙しそうにしている。"}],"source":"egs","sourceCharacterId":"11446","sourceWorkId":"15102","spoiler":false},{"segments":[{"spoiler":false,"text":"不同学校的学生，对主人公来说是与自己的一众好友中以及凪沙是有着一样感觉的存在。"},{"spoiler":false,"text":"虽然是和主人公同龄，但言行举止都很洒脱飒爽，而且有时也露出对自身严厉的一面，成熟大人般的存在。"},{"spoiler":false,"text":"因偶然的机缘何认识了主人公。"},{"spoiler":false,"text":"做着兼职，总是很忙似的。"}],"source":"bangumi","sourceCharacterId":"12341"}],"profileFacts":[{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"11446","sourceWorkId":"15102","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f42e2c669eb9a5b29937e419d3d003806aaa2d9bf7d76ca61f2c8d7e7cf6bec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/beefda5f391398658f3473f85d853f7ceabcfbc9a2da9bc9789e350756ce63d3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14141:12341:4956:1","source":"bangumi"}]},{"characterId":"char_c95520","character