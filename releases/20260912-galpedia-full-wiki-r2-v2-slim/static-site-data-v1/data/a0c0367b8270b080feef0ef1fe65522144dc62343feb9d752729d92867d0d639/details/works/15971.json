{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"15971","model":{"presentationWorkId":"vndb:v6748","staff":{"artwork":[{"creditedName":"桜ロマ子(桜島サロマ子)","creatorId":"vndb:s2746","sourcePersonId":"egs:creator:1811","canonicalEntityId":"vndb:s2746","name":"桜ロマ子(桜島サロマ子)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:98474","source":"egs"}],"scenario":[{"creditedName":"まこっちゃ","creatorId":"vndb:s4497","sourcePersonId":"egs:creator:1343","canonicalEntityId":"vndb:s4497","name":"まこっちゃ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:110374","source":"egs"},{"creditedName":"チャック雅","creatorId":"vndb:s4496","sourcePersonId":"egs:creator:433","canonicalEntityId":"vndb:s4496","name":"チャック雅","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:98475","source":"egs"},{"creditedName":"タスク(タスク父者)","creatorId":"vndb:s4499","sourcePersonId":"egs:creator:15590","canonicalEntityId":"vndb:s4499","name":"タスク(タスク父者)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:98477","source":"egs"}],"music":[{"creditedName":"IKUYA SOUND","creatorId":"vndb:s11187","sourcePersonId":"egs:creator:14428","canonicalEntityId":"vndb:s11187","name":"IKUYA SOUND","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:110802","source":"egs"},{"creditedName":"Tatsh","creatorId":"vndb:s6095","sourcePersonId":"vndb:s6095","canonicalEntityId":"vndb:s6095","name":"Tatsh","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:66764","source":"vndb"}],"other":[{"creditedName":"きこうでん みさ","creatorId":"vndb:s14755","sourcePersonId":"vndb:s14755","canonicalEntityId":"vndb:s14755","name":"きこうでん みさ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:66765","source":"vndb"}]},"cast":[{"characterId":"char_c23035","characterName":"守口 忍","sourceIds":{"bangumi":[{"characterId":"54230","match":"exact-normalized-name-in-linked-work","subjectId":"171969"}],"egsCharacterIds":["2748"],"vndbCharacterId":"c23035"},"originalCharacterName":"守口 忍","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「再開発事務局」の活動内容について調査を行うため、権力犯罪取締捜査室から派遣された捜査事務官。"},{"spoiler":false,"text":"最初から蓮司を疑っており、尾行してくる。"},{"spoiler":false,"text":"生真面目で職務に忠実。"},{"spoiler":false,"text":"一見根暗で冷徹に見えるため、近づきがたい雰囲気を持っているが、実際にはお笑い番組が大好きだったりする。"},{"spoiler":false,"text":"ただし忍自身にはギャグのセンスなど皆無である。"},{"spoiler":false,"text":"他人に誤解されやすいことは自覚しているが、仕事が仕事なので仕方がないと割り切っている。"},{"spoiler":false,"text":"職業柄、かなり腕の立つ女性で、比較的動きやすいスーツをいつも着ている。"},{"spoiler":false,"text":"忍を気に入った蓮司は、手駒として使うために仕込もうとする。"}],"source":"egs","sourceCharacterId":"2748","sourceWorkId":"12055","spoiler":false},{"segments":[{"spoiler":false,"text":"「再開発事務局」の活動内容について調査を行うため、権力犯罪取締捜査室から派遣された捜査事務官。"},{"spoiler":false,"text":"最初から蓮司を疑っており、尾行してくる。"},{"spoiler":false,"text":"生真面目で職務に忠実。"},{"spoiler":false,"text":"一見根暗で冷徹に見えるため、近づきがたい雰囲気を持っているが、実際にはお笑い番組が大好きだったりする。"},{"spoiler":false,"text":"ただし忍自身にはギャグのセンスなど皆無である。"},{"spoiler":false,"text":"他人に誤解されやすいことは自覚しているが、仕事が仕事なので仕方がないと割り切っている。"},{"spoiler":false,"text":"職業柄、かなり腕の立つ女性で、比較的動きやすいスーツをいつも着ている。"},{"spoiler":false,"text":"忍を気に入った蓮司は、手駒として使うために仕込もうとする。"}],"source":"egs","sourceCharacterId":"2748","sourceWorkId":"15971","spoiler":false},{"segments":[{"spoiler":false,"text":"能力：【真紅の着装（スカーレットヒーロー）】"},{"spoiler":false,"text":"英理と同じく法令省傘下【権力犯罪取締捜査室】に所属する捜査官。"},{"spoiler":false,"text":"先輩捜査官で上司でもある英理と合同捜査を行うよう命令を受けたため元々の自身の担当地区である【ネオ・オオサカシティ】に英理が現地入りした際、合流する直前に【神の鉄槌】に遭い、同じく能力者として覚醒した。"},{"spoiler":false,"text":"英理とは結局会えずじまいであり、忍は英理のように電磁場突破能力を持たず、権取との連絡手段を持たないため英理が覚醒していることを知らない。"},{"spoiler":false,"text":"行方不明（と思っている）英理を捜しながら、一人で自身の集落の人間達を守りつつ戦い続けている。"},{"spoiler":false,"text":"生真面目な性格であり、常に捜査官としての自覚を持つよう己を律している。"},{"spoiler":false,"text":"そのためか普段は比較的寡黙で冷静さを保とうとして冷たく見えるゆえに近づきがたい雰囲気を持ってしまっているが、実際は陽気な関西人であり、誤解を受けやすいことも自覚しているものの職業柄諦めてもいる。"}],"source":"egs","sourceCharacterId":"2748","sourceWorkId":"19639","spoiler":false},{"segments":[{"spoiler":false,"text":"かつて【権力犯罪取締捜査室】に所属していた、元捜査事務官。"},{"spoiler":false,"text":"蓮司を疑って捜査していたところを捕らえられ、調教を受けて忠実な下僕と化した。"},{"spoiler":false,"text":"一見すると冷たく知的な美女だが、その中身は案外脳筋肉で体育会系。"},{"spoiler":false,"text":"腕が立つため、よく蓮司の身辺警護を任かされている。"}],"source":"egs","sourceCharacterId":"2748","sourceWorkId":"24199","spoiler":false},{"segments":[{"spoiler":false,"text":"かつて権力犯罪取締捜査室に所属していた、元捜査事務官。"},{"spoiler":false,"text":"蓮司を捜査していたところ捕らえられ、調教を受けて忠実な下僕と化した。"},{"spoiler":false,"text":"一見すると冷たく知的な美女だが、その中身は意外と体育会系。"},{"spoiler":false,"text":"腕が立つため、よく蓮司の身辺警護を任されている。"}],"source":"bangumi","sourceCharacterId":"54230"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ecbdd676914fbd221db1731692435b7a426f668247baafe2edfd0a20ef5b465c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5029142022b9575a531bd6fd692e1c14199dc9eb4512cff08bc8326a3f800be.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梅田未央","creatorId":"vndb:s940","sourcePersonId":"vndb:s940","canonicalEntityId":"vndb:s940","name":"梅田 未央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:171952:54230:25056:1","source":"bangumi"}]},{"characterId":"char_c54987","characterName":"倉嶋 蓮司","sourceIds":{"bangumi":[{"characterId":"54228","match":"exact-normalized-name-in-linked-work","subjectId":"211794"}],"egsCharacterIds":["17254"],"vndbCharacterId":"c54987"},"originalCharacterName":"倉嶋 蓮司","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【大阪再建プロジェクト】を成し遂げた、影の主役にして主人公。"},{"spoiler":false,"text":"【大阪再開発事業局】───。"},{"spoiler":false,"text":"通称【再開発局】の局長としてチームを率いており、大阪の表の顔である代表『柿本　透』の代わりに裏の汚れ仕事を一手に引き受けている。"},{"spoiler":false,"text":"海外での傭兵生活やその他の様々な経験から、高い智謀と戦闘力を有しており、裏社会では一目置かれる存在。"},{"spoiler":false,"text":"かつてタレントだった柿本を大阪代表にまでのし上げた立役者。"},{"spoiler":false,"text":"柿本とは利害が一致しており、互いに協力関係にある。"},{"spoiler":false,"text":"その凶悪さとは裏腹に部下からも慕われる高いカリスマを持ち合わせているが、普段は煩わしい業務を相棒の高槻に任せて気ままな生活を送っている自由人。"}],"source":"egs","sourceCharacterId":"17254","sourceWorkId":"24199","spoiler":false},{"segments":[{"spoiler":false,"text":"大阪再建プロジェクトを成し遂げた影の主役にして主人公。"},{"spoiler":false,"text":"大阪再開発事業局の局長としてチームを率いており、"},{"spoiler":false,"text":"大阪の表の顔である柿本の代わりに汚れ仕事を一手に引き受けている。"},{"spoiler":false,"text":"傭兵や様々な経験から高い智謀と戦闘力を有し、裏社会では一目置かれる存在。"},{"spoiler":false,"text":"その凶悪さとは裏腹に部下からも慕われる高いカリスマを持ち合わせているが、"},{"spoiler":false,"text":"普段は煩わしい業務を相棒の高槻に任せて気ままな生活を送っている自由人。"}],"source":"bangumi","sourceCharacterId":"54228"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9dc55a1f9a3efe75baf51384e8364516de7e6e0b662470c0afeca0ab0243341.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7ca20eb357d79efb93a54b24f52fe97ac2cc6bfb218e5e63b7f5b908571dda6e.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c54988","characterName":"滝井 千鶴","sourceIds":{"bangumi":[{"characterId":"54229","match":"exact-normalized-name-in-linked-work","subjectId":"171952"},{"characterId":"54229","match":"exact-normalized-name-in-linked-work","subjectId":"223379"}],"egsCharacterIds":["9703"],"vndbCharacterId":"c54988"},"originalCharacterName":"滝井 千鶴","charact