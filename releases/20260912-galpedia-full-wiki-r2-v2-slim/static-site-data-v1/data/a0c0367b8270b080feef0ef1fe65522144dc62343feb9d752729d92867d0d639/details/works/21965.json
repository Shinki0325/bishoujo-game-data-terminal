","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"102"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の母親。美人でグラマラスな、近所でも評判のお母さん。"},{"spoiler":false,"text":"早くに夫を亡くし、一人息子の主人公を女手ひとつで育ててきた。"},{"spoiler":false,"text":"愛情深く、面倒見のいい女性。"},{"spoiler":false,"text":"普段は商店街にあるお惣菜屋さんでパートとして働いている。"},{"spoiler":false,"text":"手先が不器用なため家事は苦手だったが、息子が生まれてからは必死で覚え、いまでは炊事洗濯から裁縫まで完璧にこなせるようになった。"},{"spoiler":false,"text":"とくに、息子が喜んでくれる料理の腕前はプロも顔負けである。"},{"spoiler":false,"text":"前向きで行動的な性格をしており、考えるよりもまず実行してみるタイプ。"},{"spoiler":false,"text":"結果的に失敗することもあるが、そこは息子がよくフォローしていた。"},{"spoiler":false,"text":"好きなことは息子に甘えてもらうこと。"},{"spoiler":false,"text":"ただ、息子は人一倍しっかり者に育ってしまい、寂しい思いをしている。"},{"spoiler":false,"text":"スキンシップは過剰なほうで、昔は息子と一緒によくお風呂に入っていた。"},{"spoiler":false,"text":"最近、下半身にお肉が付いてきているのを気にしている。"},{"spoiler":false,"text":"母乳の出が良く、自分の母乳だけで息子を育てたことがひそかな自慢。"},{"spoiler":false,"text":"数年前、自分のブラに息子の精液が付いているのを発見してしまってから、彼を異性として強く意識するようになる。"},{"spoiler":false,"text":"それ以来、息子の目を盗んでは彼をオカズにたびたび自慰をするようになった。"}],"source":"egs","sourceCharacterId":"7153","sourceWorkId":"21965","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の母親。 美人でグラマラスな、近所でも評判のお母さん。"},{"spoiler":false,"text":"早くに夫を亡くし、一人息子を女手ひとつで育ててきた。"},{"spoiler":false,"text":"手先が不器用で家事は苦手だったが、息子のために必至で覚え今では完璧。"},{"spoiler":false,"text":"特に息子が喜んでくれる料理の腕前はプロ顔負け。"},{"spoiler":false,"text":"前向きな性格で、考えるよりもまず実行してみるタイプ。"},{"spoiler":false,"text":"好きなことは息子に甘えてもらうこと。"},{"spoiler":false,"text":"しかし息子はしっかり者に育ってしまい、寂しい思いをしている。"},{"spoiler":false,"text":"数年前、自分のブラに息子の精液が付いているのを発見し、異性として強く意識するようになる。"},{"spoiler":false,"text":"それ以来、息子の目を盗んでは彼をオカズにたびたび自慰をするようになった。"},{"spoiler":false,"text":"主人公的母亲。美丽且富有个人魅力，有口皆碑的好母亲。"},{"spoiler":false,"text":"早年亡夫，自己一个女人把儿子养育成人。"},{"spoiler":false,"text":"原本双手并不灵巧，因此不擅长处理家务，不过为了照顾儿子而全力学习如今已是家务达人。"},{"spoiler":false,"text":"特别是能让儿子高兴的厨艺甚至不输给专业厨师。"},{"spoiler":false,"text":"积极的性格，比起思考先会去行动的类型。"},{"spoiler":false,"text":"喜欢的事情是疼爱儿子。"},{"spoiler":false,"text":"不过在儿子出色地长大后，反而感到了寂寞。"},{"spoiler":false,"text":"数年前，在发现了自己的胸罩里沾上了儿子的精液后，就对他觉醒了强大的异性意识。"},{"spoiler":false,"text":"在那之后，经常会在儿子没发现的地方用他当妄想材料来自慰。、"}],"source":"bangumi","sourceCharacterId":"38671"}],"profileFacts":[{"label":"胸围（本版本）","value":"102 cm","valueContext":null,"source":"egs","sourceCharacterId":"7153","sourceWorkId":"21965","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"7153","sourceWorkId":"21965","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"7153","sourceWorkId":"21965","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"7153","sourceWorkId":"21965","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"63 cm","valueContext":null,"source":"egs","sourceCharacterId":"7153","sourceWorkId":"21965","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"55 kg","valueContext":null,"source":"egs","sourceCharacterId":"7153","sourceWorkId":"21965","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f26da26b9601d655e74e3b6b2335b2bdacad550d9f96cffd844bec5452080a13.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/adfc97d19898aabc654f93b79c795b33d29d6c522cabbaae27c927e321e35954.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","cr