el":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:26601","source":"vndb"},{"creditedName":"古謝 友紀乃","creatorId":"vndb:s14107","sourcePersonId":"vndb:s14107","canonicalEntityId":"vndb:s14107","name":"古謝 友紀乃","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:26603","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c113774","characterName":"ミンミ・ザミテス・アカハーテ","sourceIds":{"vndbCharacterId":"c113774"},"originalCharacterName":"ミンミ・ザミテス・アカハーテ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"120"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"It's dangerous to go out at night like this, Uluca.\""},{"spoiler":false,"text":"\"If you hang around in the middle of the night like this, you'll be eaten.\""},{"spoiler":false,"text":"Mysterious twins with the same name. They are characterized by a cold tone and a cheeky attitude. Mainly at night, they suddenly appear in front of Rufen and utter disturbing words."},{"spoiler":false,"text":"They are enrolled in the elementary school, and their parents are said to be employees of the academy, but the truth is unknown."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c113774"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfe56749cc645aa5e0ef2871cdbae2e72f75d71853c36bf36eb03a2fdbe0a0b9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9faea5c3ced965618d7df46afa142ac176a1b57e81c7cee546d7a5d8a78cea17.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"斎賀 みつき","creatorId":"vndb:s293","sourcePersonId":"vndb:s293","canonicalEntityId":"vndb:s293","name":"斎賀 みつき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13791","source":"vndb"}]},{"characterId":"char_vndb_c26062","characterName":"ベナ・トール・クルサフォンティア","sourceIds":{"vndbCharacterId":"c26062"},"originalCharacterName":"ベナ・トール・クルサフォンティア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"147"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Hey, you look so pissed off...! You're a good young man in the middle of the day!\""},{"spoiler":false,"text":"Rufen's senpai."},{"spoiler":false,"text":"Despite her small stature, she's always in high spirits. When she sees Rufen, she hits him as a conditional reflex."},{"spoiler":false,"text":"She's always with her roommate, Pit."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c26062"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69e87eb31ad8cdd48dc7133aacb2b5f0ebcdad59e6452ace461a8fcc8fb70656.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79aeababb46c4700e492526ec59e432ab06e98aad964b27311190412aaa6d98b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"川上 とも子","creatorId":"vndb:s477","sourcePersonId":"vndb:s477","canonicalEntityId":"vndb:s477","name":"川上 とも子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13793","source":"vndb"}]},{"characterId":"char_vndb_c43555","characterName":"メイオラニア・ウィリアム・ソニエラ","sourceIds":{"vndbCharacterId":"c43555"},"originalCharacterName":"メイオラニア・ウィリアム・ソニエラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You haven't forgotten that I've already bought you three lunches, have you?\""},{"spoiler":false,"text":"Rufen's classmate and the grandson of the principal of the academy."},{"spoiler":false,"text":"He's very curious, and when he's interested in something, he rushes forward. His various senses are out of sync with those around him, but it is unknown whether it is because he grew up being doted on by his grandfather, or if it is just a bad trait."},{"spoiler":false,"text":"He believes most problems can be solved with undersleeves. He is the person who pulled Rufen into the Seven Wonders Expedition."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c43555"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cd43046061bd0d05e76f58e7f8f921a208f43958afe0a0349742e53bc5200b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31bdc11e732d3327aec8b4a6eafbcd19b34d1c3405dedd39170c82f9d1988f37.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬 誠","creatorId":"vndb:s1673","sourcePersonId":"vndb:s1673","canonicalEntityId":"vndb:s1673","name":"成瀬 誠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13796","source":"vndb"}]},{"characterId":"char_vndb_c43556","characterName":"???","sourceIds":{"vndbCharacterId":"c43556"},"originalCharacterName":"???","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"...Uluca is really stupid. Did you forget about me again?\""},{"spoiler":false,"text":"A tall young man with odd eyes and long hair who suddenly showed up in front of Rufen. He wears the Academy's uniform, but doesn't seem to be a student there."},{"spoiler":false,"text":"He approached Rufen to \"teach him how to make a contract,\" which Rufen knew nothing about. What is his purpose for being here...?"},{"spoiler":false,"text":"Translate from official website"}],"source":"vndb","sourceCharacterId":"c43556"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05ac7d11ccfeeb9502b73405e7aff495de8e877ed75a9add22070182162a9b4c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/481e847c0ba8f4cc85a21772a45bf7a9b6b5805cf708e19c849dcbc961102a9f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"諏訪部 順一","creatorId":"vndb:s66","sourcePersonId":"vndb:s66","canonicalEntityId":"vndb:s66","name":"諏訪部 順一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13788","source":"vndb"}]},{"characterId":"char_vndb_c43557","characterName":"ウルカ・ルーフェン","sourceIds":{"vndbCharacterId":"c43557"},"originalCharacterName":"ウルカ・ルーフェン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"169"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Hey, if you're going to wake me up, wake me up sooner!!\""},{"spoiler":false,"text":"An unhappy boy who was forced to move early on in the semester due to a leak in his room. Even at this year's Falling Night Festival, he was unlucky enough to be given the troublesome role of the Morning Messenger. Before he knew it, he was caught up in a vortex."},{"spoiler":false,"text":"He has a stubborn and distrustful side that makes him only believe things he has seen and experienced."},{"spoiler":false,"text":"He has a typical temperament, which is rare in the academy, and his current concern is the content of the school cafeteria's avant-garde menu."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c43557"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2ce793f484a6798bb0f8c9ec1038e0d9aa899c37ea665d63aafddafe9bc497f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/8277e5909873dac3e128d586f77d231a5a571a3cc848a330657993ce54c16f1c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近藤 孝行","creatorId":"vndb:s2121","sourcePersonId":"vndb:s2121","canonicalEntityId":"vndb:s2121","name":"近藤 孝行","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13797","source":"vndb"}]},{"characterId":"char_vndb_c43558","characterName":"バージェシア・ランフォリンクス","sourceIds":{"vndbCharacterId":"c43558"},"originalCharacterName":"バージェシア・ランフォリンクス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"192"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"What do you want? Dismantling? Surgery? Or remodeling?\""},{"spoiler":false,"text":"He came to the academy this fall. He doubles as a biology teacher and a substitute school nurse because the regular nurse is on maternity leave."},{"spoiler":false,"text":"Although he has long hair and speaks like a woman, he's a true man in both body and soul. He is sarcastic and prideful, but is on bad terms with Phor."},{"spoiler":false,"text":"He uses his role as a substitute nurse to bring various tools to work with him. At night, he devotes himself to his research hobby."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c43558"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f81f8a2adfec498a30864d664d31db369ebe295fdb14d8e5d009493250d66293.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/339571c77f23d2b0f7bbde3aedb5b13f4e3135ffc5a77fd5abaddf5a77612907.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"置鮎 龍太郎","creatorId":"vndb:s747","sourcePersonId":"vndb:s747","canonicalEntityId":"vndb:s747","name":"置鮎 龍太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13794","source":"vndb"}]},{"characterId":"char_vndb_c43559","characterName":"フォルスラコス・レ・ヴェルトラプトル","sourceIds":{"vndbCharacterId":"c43559"},"originalCharacterName":"フォルスラコス・レ・ヴェルトラプトル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"187"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"O-ni-san, it seems like you're being crushed with one hand...\""},{"spoiler":false,"text":"The cafeteria chef at the academy. He is very popular with students because of his friendly demeanor and cheerfulness."},{"spoiler":false,"text":"He's a top-notch cook, but he has a bad habit of making strange dishes all of a sudden and using dormitory students as test subjects. Even if you open your mouth, you'll say too much. If you don't understand the TPO, you'll be called a sexual harasser by female students."},{"spoiler":false,"text":"He's not on good terms with Gessy."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c43559"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/435b74dc52533af9853b3159b539393f75e15f8b19616d06004525411e092c0e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3176970bd41f67fde679e9381d879b301e30c9d3ccbdd986bcc55428ef41768.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大塚 明夫","creatorId":"vndb:s1085","sourcePersonId":"vndb:s1085","canonicalEntityId":"vndb:s1085","name":"大塚 明夫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13795","source":"vndb"}]},{"characterId":"char_vndb_c43560","characterName":"ピカイア・トゥルカナ","sourceIds":{"vndbCharacterId":"c43560"},"originalCharacterName":"ピカイア・トゥルカナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"At lunchtime, there was a corner where new students gathered.. I think the level will be higher this year.\""},{"spoiler":false,"text":"Rufen's classmate. She's a tall and fair-skinned beautiful girl."},{"spoiler":false,"text":"Contrary to her calm demeanor, she occasionally utters sharp words, but he does not have any malice in him. She comes from a good family."},{"spoiler":false,"text":"She spends most of her time with her roommate, Vena. She's a childhood friend of Mei."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c43560"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/3335ec40a03d85a44eb673a8d2cb26b56b41f93cbf9437ac547f5e221ee17bf0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef23fd3a392a14f00731ace0e3eb77e651d403de9e0a6316e7c9971db30a4b4e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中原 麻衣","creatorId":"vndb:s444","sourcePersonId":"vndb:s444","canonicalEntityId":"vndb:s444","name":"中原 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13792","source":"vndb"}]},{"characterId":"char_vndb_c43561","characterName":"ネクト","sourceIds":{"vndbCharacterId":"c43561"},"originalCharacterName":"ネクト","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"It's all just fiction. It's like an old tale from Chernia.\""},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c43561"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5bade06bda093d109c28b449032340eac6436d648af3b276cfa28f52ef4d708.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/471eb18703225f99965a3c498a1cd7f75d9cb37e565aed441b4f051ed183768d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"豊永 利行","creatorId":"vndb:s3247","sourcePersonId":"vndb:s3247","canonicalEntityId":"vndb:s3247","name":"豊永 利行","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13798","source":"vndb"}]},{"characterId":"char_vndb_c43562","characterName":"アクセル","sourceIds":{"vndbCharacterId":"c43562"},"originalCharacterName":"アクセル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"It's the reason for the fight, Fight! I'm the only one who looks like a hub. Don't you feel sick!\""},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c43562"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43f07e3541e3c048d81831e442a182513d1c840e6384eb11e2d20098e44f69f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/6909a4512f36574db8c34f2e521c48233ed3c5b9a57005efea54015c5271650c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤 健太郎","creatorId":"vndb:s89","sourcePersonId":"vndb:s89","canonicalEntityId":"vndb:s89","name":"伊藤健太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13790","source":"vndb"}]},{"characterId":"char_vndb_c43563","characterName":"ユースミルス・C・R・ウィンタテリウム","sourceIds":{"vndbCharacterId":"c43563"},"originalCharacterName":"ユースミルス・C・R・ウィンタテリウム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"...The walls and floor are cold here. Perfect for sleeping.\""},{"spoiler":false,"text":"Rufen's first-class roommate."},{"spoiler":false,"text":"His expression is always blank and he's constantly sleepy. Communication with him is difficult because conversations with him are always brief, lack explanation, and don't last long."},{"spoiler":false,"text":"He seems to think a lot of things, but it's hard to tell what he's thinking from a glance. He always complains about being hungry or tired. Somehow, he seems to be popular within the school...?"},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c43563"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fed289d00e77e28b722d17caf1ae24e288ff6ab59e43f3328e654a0b61d00835.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be9ea0012bb744be7b5350bc0497c7e7dc22f79123c8fc701b79bdadd941b79a.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石田 彰","creatorId":"vndb:s74","sourcePersonId":"vndb:s74","canonicalEntityId":"vndb:s74","name":"石田 彰","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13789","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p653","sourceCompanyId":"egs:brand:2424","canonicalEntityId":"vndb:p653","name":"Senz","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:10835:2424","source":"egs"},{"companyId":"vndb:p653","sourceCompanyId":"vndb:p653","canonicalEntityId":"vndb:p653","name":"Senz","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:104576:v1614","source":"vndb"},{"companyId":"vndb:p1665","sourceCompanyId":"vndb:p1665","canonicalEntityId":"vndb:p1665","name":"ホビボックス株式会社","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:104577:v1614","source":"vndb"},{"companyId":"vndb:p653","sourceCompanyId":"vndb:p653","canonicalEntityId":"vndb:p653","name":"Senz","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:3755:v1614","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
