leLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:96354","source":"vndb"}]},"cast":[{"characterId":"char_c26706","characterName":"希美子・マイザール","sourceIds":{"bangumi":[{"characterId":"62762","match":"exact-normalized-name-in-linked-work","subjectId":"66264"}],"egsCharacterIds":["906"],"vndbCharacterId":"c26706"},"originalCharacterName":"希美子・マイザール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"38"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"height":{"reviewState":"no-conflict","source":"vndb","value":"169"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mother of Ami Maizar."}],"source":"vndb","sourceCharacterId":"c26706"},{"segments":[{"spoiler":false,"text":"超豪華プライべート船『パールヴァティ号』の船長である美しい女性。"},{"spoiler":false,"text":"大金持ちの「マイザールファミリー」として宇宙にその噂は轟いている。"},{"spoiler":false,"text":"変態性癖の持ち主で若さと美貌を保つ為に若い男とのセックスを心がけている。若い男性に触れることで心身ともにリフレッシュして、若さを保とうと考えている。"},{"spoiler":false,"text":"その際に、精液を欠かさず飲む。"},{"spoiler":false,"text":"火照っている際は、精液を飲みたくなってしまう。"},{"spoiler":false,"text":"精液を飲むと火照りは収まるので、普段から新鮮な精液を口にしている。"},{"spoiler":false,"text":"また希少宇宙人の愛液も美貌のために飲む。"},{"spoiler":false,"text":"そのために、一見すると落ち着いた温厚そうな雰囲気の女性だが、頭が切れ、あくどいことも平気でやる。"},{"spoiler":false,"text":"自分自身が世間の常識とずれているという自覚も無く、いたって普通の感覚で、変態プレイを楽しんでいる。巨乳で肉感的な身体の持ち主。"}],"source":"egs","sourceCharacterId":"906","sourceWorkId":"18154","spoiler":false},{"segments":[{"spoiler":false,"text":"超豪華プライベート船 『パールバティー』 の船長であり、亜美の母親でもある。"},{"spoiler":false,"text":"ふたりは “大金持ちのマイザールファミリー” として、宇宙にその名を轟かせているらしい。"},{"spoiler":false,"text":"その家業は、御法度とされている希少な宇宙人や生物を捕まえ売り飛ばす奴隷商。"},{"spoiler":false,"text":"さらに付加価値を増すために、その奴隷を裏社会の様々な趣向に合わせて調教・人体改造なども行っている。"},{"spoiler":false,"text":"見た目は妙齢の女性で、若さと美貌を保つために若い男とのセックスを心がけ、若い男性の “精液” を欠かさず飲むことにしている。"},{"spoiler":false,"text":"コールドスリープの影響で、実年齢は見た目よりもかなり高め。"},{"spoiler":false,"text":"一見すると落ち着いた温厚そうな雰囲気の女性だが、頭が切れ、あくどいことも平気で、躊躇無くド変態行為を強要したりもする。"},{"spoiler":false,"text":"「それともわたくしが、慈悲深いマリア様にでも見えるのかしら？」"}],"source":"bangumi","sourceCharacterId":"62762"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"62762","value":"マイザール家当主、船長、希少宇宙生物売買"},{"label":"趣味","source":"bangumi","sourceCharacterId":"62762","value":"美と若さの追求"},{"label":"年龄（本版本）","value":"38?","valueContext":"原文","source":"egs","sourceCharacterId":"906","sourceWorkId":"18154","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"906","sourceWorkId":"18154","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"169 cm","valueContext":null,"source":"egs","sourceCharacterId":"906","sourceWorkId":"18154","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"906","sourceWorkId":"18154","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"906","sourceWorkId":"18154","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89b35741d903dffb1d22d7d4de3879c2c7a5a19641645827171ff5bff7f9cda0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61fb6aba8b1db581f8a4d23c896809fa4767834f9c85801bd6d141b773acca5c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤雅美","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:66264:62762:13773:1","source":"bangumi"}]},{"characterId":"char_c26707","characterName":"亜美・マイザール","sourceIds":{"bangumi":[{"characterId":"62763","match":"exact-normalized-name-in-linked-work","subjectId":"66264"}],"egsCharacterIds":["907"],"vndbCharacterId":"c26707"},"originalCharacterName":"亜美・マイザール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daughter of Kimiko Maizar."}],"source":"vndb","sourceCharacterId":"c26707"},{"segments":[{"spoiler":false,"text":"希美子の娘。母に負けず劣らずのドＳのド変態。"},{"spoiler":false,"text":"普段はおっとりしていておとなしめだが、スイッチが入ったときの攻撃性は母を越える。"},{"spoiler":false,"text":"二重人格かと疑われるほどの性格の変化がある。"},{"spoiler":false,"text":"沸き上がる性への追究を止められず暴走する。口調も乱暴なものに変わってしまう。"},{"spoiler":false,"text":"自分が変態だという自覚はなく、相手の痛みを考慮すると言うことも知らない。"},{"spoiler":false,"text":"趣味は低出力のレーザー猟銃を使った宇宙人ハンティング。"},{"spoiler":false,"text":"精液を飲まないと身体が尋常じゃないほど火照るようになってしまう。"}],"source":"egs","sourceCharacterId":"907","sourceWorkId":"18154","spoiler":false},{"segments":[{"spoiler":false,"text":"希美子の娘であり、母に負けず劣らずのドSのド変態。"},{"spoiler":false,"text":"普段から攻撃的な性格をしているが、スイッチが入ると母を越えるほどのドSっぷりを発揮する。"},{"spoiler":false,"text":"ヴァギナよりも先にアナルに目覚めてしまい、また自分が変態だという自覚が無いうえに、相手の痛みを考慮するということも知らない。"},{"spoiler":false,"text":"趣味はオナグッズの自作や狩り用の罠作り。"},{"spoiler":false,"text":"そのせいで自室は片付けられておらず、服や工具が散乱していて汚い。"},{"spoiler":false,"text":"「はぁ？　誰が喋っていいって言ったの？」"}],"source":"bangumi","sourceCharacterId":"62763"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"62763","value":"マイザール家次期当主"},{"label":"趣味","source":"bangumi","sourceCharacterId":"62763","value":"オナグッズや罠の作製、奴隷調教"},{"label":"年龄（本版本）","value":"18 岁","valueContext":null,"source":"egs","sourceCharacterId":"907","sourceWorkId":"18154","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"907","sourceWorkId":"18154","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"907","sourceWorkId":"18154","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"907","sourceWorkId":"18154","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"907","sourceWorkId":"18154","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/4916f0bb02debfbceedcffa325840987f401eea60da14eb8d057c491fb2d94b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/caf7283f3108453e53ea9c25dfa1b7ea79f6407c0e22d03f1ce2b37b6858fd36.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷部 雪奈","creatorId":"vndb:s1021","sourcePersonId":"vndb:s1021","canonicalEntityId":"vndb:s1021","name":"長谷部雪奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51179","source":"vndb"}]},{"characterId":"char_c26709","characterName":"イリーザ","sourceIds":{"bangumi":[{"characterId":"62764","match":"exact-normalized-name-in-linked-work","subjectId":"66264"}],"egsCharacterIds":["908"],"vndbCharacterId":"c26709"},"originalCharacterName":"イリーザ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"gender":{"reviewState":"source-only","source":"vndb","value":"f"},"height":{"reviewState":"no-conflict","source":"vndb","value":"171"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"b"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"マイザール家がハンティングに出かけた惑星で連れてきた希少宇宙人。"},{"spoiler":false,"text":"主人公よりもずっと昔からこの船に乗っており、愛玩具として飼われている。"},{"spoiler":false,"text":"闇市場での取引価格は数億円。"},{"spoiler":false,"text":"しかしマイザール母は、自分の美貌を維持するために売らずに愛玩具として船に囲われている。"},{"spoiler":false,"text":"髪の毛も透き通るような綺麗な銀色であり高く取引されている。"},{"spoiler":false,"text":"伸びた髪を売るだけで一財産になるが髪の毛は神経の集合体と言われており、"},{"spoiler":false,"text":"切ることによる苦痛に耐えられないと言われている。"},{"spoiler":false,"text":"彼女は容姿は女性であるもののその性器に関しては変幻自在となっている。"}],"source":"egs","sourceCharacterId":"908","sourceWorkId":"18154","spoiler":false},{"segments":[{"spoiler":false,"text":"希少な宇宙人とされているファーゼライト星人。"},{"spoiler":false,"text":"主人公よりもずっと前から 『パールバティー』 に乗っており、愛玩具として飼われている。"},{"spoiler":false,"text":"そんな境遇の中、なぜマイザール親子のもとに居続けているのかは不明。"},{"spoiler":false,"text":"ファーゼライト星人の特徴として、自分の姿を様々に変えられる “特殊能力” があると言われており、人間の姿以外にも変化出来るらしい。"},{"spoiler":false,"text":"そして、最も特徴的なのはその髪の毛。 七色から銀色に緩く神々しく光るその髪の毛を素材とした物は、元の性能の数十倍以上のポテンシャルを持たせることが出来るらしい。"},{"spoiler":false,"text":"そのため、闇市場での価値は数百兆円以上あるとも言われている。"},{"spoiler":false,"text":"しかし、この髪の毛は神経の集合体であり、切ってしまうとその本体がショック死してしまうという諸刃の剣でもある。"},{"spoiler":false,"text":"「この世界での認証コードは、イリーザ」"}],"source":"bangumi","sourceCharacterId":"62764"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"62764","value":"宇宙人"},{"label":"趣味","source":"bangumi","sourceCharacterId":"62764","value":"入浴、掃除、ウシブタの飼育"},{"label":"年龄（本版本）","value":"???","valueContext":"原文","source":"egs","sourceCharacterId":"908","sourceWorkId":"18154","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"83 cm