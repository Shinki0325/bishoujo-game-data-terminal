tus":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1007"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"星藤学園人気NO.1の生徒会長。主人公の従姉で先輩。"},{"spoiler":false,"text":"真面目で責任感が強く、気立ても良ければ、明るく気さくな女の子。"},{"spoiler":false,"text":"学業も優秀で、主人公が星藤学園に進学できたのは彼女の家庭教師の成果である。"},{"spoiler":false,"text":"大の「天文」好きが高じて「天文同好会」を設立。"},{"spoiler":false,"text":"将来は街に丘にある天文台の所長になって、毎日、望遠鏡で星を眺めること。"}],"source":"egs","sourceCharacterId":"22419","sourceWorkId":"9016","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の従姉にして、学園の先輩。星藤学園人気NO.1の生徒会長であり、気立ても良く明るい笑顔の持ち主。"},{"spoiler":false,"text":"学園の成績は良く、主人公が星藤学園へ進学できたのは彼女の家庭教師のおかげである。"},{"spoiler":false,"text":"自ら「天文同好会」を作るくらい星を見る事が好きで、星空に包まれるのが何よりも好き。将来の夢は、街の丘にある天文台の所長になって日がな望遠鏡を磨きながら、星を見る事。"},{"spoiler":false,"text":"主人公はこの学園生活を謳歌している琴音に対して、憧れのような感覚を持っている。"},{"spoiler":false,"text":"「元家庭教師として、同じ学園にいる教え子は気になっちゃうよ」"}],"source":"bangumi","sourceCharacterId":"173564"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/1837fb78b0286bef5fb3bd23490172706906fdcd4949e2ebc321a5f5f506db4b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a27257aef26743270b99e7832f54dc14d5e7f91fa06d0d616134a3ff520cb606.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c81923","characterName":"高塚 水季","sourceIds":{"bangumi":[{"characterId":"173565","match":"exact-normalized-name-in-linked-work","subjectId":"98964"}],"egsCharacterIds":["22420"],"vndbCharacterId":"c81923"},"originalCharacterName":"高塚 水季","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"704"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。進学前からの同級生。"},{"spoiler":false,"text":"リアクションが激しく、感情表現豊かな健康優良スポーツ少女。"},{"spoiler":false,"text":"常にハイテンション＆ハイパワーで、明るくノリが良い。"},{"spoiler":false,"text":"ラクロス部に所属し、将来のエースストライカーとして期待されている。"},{"spoiler":false,"text":"主人公と同じ学園に進学するために、必死に勉強勉強した経緯を持つ。"}],"source":"egs","sourceCharacterId":"22420","sourceWorkId":"9016","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。進学前からの同級生。"},{"spoiler":false,"text":"健康優良スポーツっ娘であり、進学前から始めたラクロスを続けている。"},{"spoiler":false,"text":"体格に恵まれている訳ではないが、素早い動きで相手を翻弄できるため、ラクロス部のエースストライカーとして期待されている。背番号12。"},{"spoiler":false,"text":"主人公と同じ学園（星藤学園）に進学するため、志望校をいきなり上げた主人公に追いつこうと、必死に勉○していた。"},{"spoiler":false,"text":"休日の趣味は、愛車の手入れとサイクリング。"},{"spoiler":false,"text":"「ねーねー、あっちゃんは惑が誰を好きかとか、知らない？」"}],"source":"bangumi","sourceCharacterId":"173565"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b8150ff71caa35c374aa7b120b85947e82497c1ad0f6c9ba9e056b2d7ae7d9e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e33ee774189025d499d84e0176bc1d14a6817ffdd0f9353a6ba7456d09eb503.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c81924","characterName":"星川 瑠歌","sourceIds":{"bangumi":[{"characterId":"173566","match":"exact-normalized-name-in-linked-work","subjectId":"98964"}],"egsCharacterIds":["22421"],"vndbCharacterId":"c81924"},"originalCharacterName":"星川 瑠歌","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1018"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"75"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"hip":{"reviewState":"source-only","source":"vndb","value":"75"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスに転入してきた女の子。"},{"spoiler":false,"text":"性格は、勝気で気が強く、素直になれない典型的なツンデレ。"},{"spoiler":false,"text":"両親も一緒に引っ越してくるはずだったが、諸事情から教会に一人で住んでいる。"},{"spoiler":false,"text":"教会には高齢の司祭が住んでいたが、現在、ぎっくり腰で入院中のため、彼の代理をするべく瑠歌達がやってきた。"}],"source":"egs","sourceCharacterId":"22421","sourceWorkId":"9016","spoiler":false},{"segments":[{"spoiler":false,"text":"転校生。主人公のクラスに編入してくる。"},{"spoiler":false,"text":"両親も一緒に引っ越してくるはずだったが、今は教会に1人で住んでいる。"},{"spoiler":false,"text":"教会には元々高齢の司祭様が1人で住んでいたが、ギックリ腰で入院してしまったため、瑠歌たちは彼の代理として急遽やってくることになった。相手が正しいと思っても、従うと負け、だと思ってしまって、「うん」と言えない性格の持ち主。素直になれない事がコンプレックスになって、 さらに素直になれない悪循環に陥っている。"},{"spoiler":false,"text":"「神を信じないオロカモノには、神罰を下すわよ」"}],"source":"bangumi","sourceCharacterId":"173566"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8e29f33df5bf3c358d7a9881b12369258d174561201edf5f6e4979f942dca90.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83260c62bf632c21dada92fa7b31783e354cdf32848f8ff17bd6a9bef763d85c.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c81925","characterName":"鈴木 流史","sourceIds":{"bangumi":[{"characterId":"173568","match":"exact-normalized-name-in-linked-work","subjectId":"98964"}],"egsCharacterIds":["22423"],"vndbCharacterId":"c81925"},"originalCharacterName":"鈴木 流史","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"326"},"bloodType":{"reviewState":"pending-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"生徒会と、天文同好会の会計士。"},{"spoiler":false,"text":"基本的に真面目でしっかり者。"},{"spoiler":false,"text":"普段は、大人しく引っ込み思案な性格だが、ひとたび怒らせると、方言でまくし立て、手が付けられなくなる。"},{"spoiler":false,"text":"問題児揃いの「天文同好会」で、いつもトラブルに巻き込まれる哀しい役どころ。"}],"source":"egs","sourceCharacterId":"22423","sourceWorkId":"9016","spoiler":false},{"segments":[{"spoiler":false,"text":"生徒会の会計にして、天文同好会の会計も兼ねている会計の鬼。"},{"spoiler":false,"text":"普段は引っ込み思案で大人しい先輩だが、ひとたびその逆鱗に触れると、泣く子も逆らえないほど、方言で怒鳴り始める。周りは彼女の怒りが収まるまで、ただ「はい、はい」と頷いているしかない。"},{"spoiler":false,"text":"問題児である「天文同好会」の部員達に振り回される哀れな役どころ。"},{"spoiler":false,"text":"平凡な苗字と、変わった名前のギャップに悩んでいるとか。"},{"spoiler":false,"text":"「そ、そんな…わ、私はただ…澪木先輩のお役に立ちたいって、だけで…」"}],"source":"bangumi","sourceCharacterId":"173568"}],"profileFacts":[],"metadataCandidateConflicts":{"bloodType":[{"comparisonValue":"ab","source":"vndb","sourceCharacterId":"c81925","value":"ab"},{"comparisonValue":"a","source":"egs","sourceCharacterId":"22423","value":"A"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d96a1b6e5028d8950b01a53acfd411acd7