oriously forceful, he is well known in the political world and his skills have earned him many followers."},{"spoiler":false,"text":"Translated from the Official Website"}],"source":"vndb","sourceCharacterId":"c99309"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edf794cd04fab20fa22978c72f6959464bb810ba036d1e4ef1f5c4e3b40718a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a080c5596b6eb6c530ffb778fb6289efdb8f620beb30e4e820e5e69ba8c4dc6a.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c99310","characterName":"秋月 鷹仁","sourceIds":{"vndbCharacterId":"c99310"},"originalCharacterName":"秋月 鷹仁","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"President of Glaðsheimr Japan. The person who calls Kuze, claiming to be Kizu, an Euphoria executive."}],"source":"vndb","sourceCharacterId":"c99310"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7574faa88d3c8a98e10c910f20dbf6b44bf73a00c117bb715570f7f9129f8b9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/465fe18978c9c42d82e34eae283922599577bcdb4e7c9e50377305a9e0fa81e7.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:5000","sourceCompanyId":"egs:brand:5000","canonicalEntityId":"egs:brand:5000","name":"BLobby","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:23569:5000","source":"egs"},{"companyId":"vndb:p6390","sourceCompanyId":"vndb:p6390","canonicalEntityId":"vndb:p6390","name":"株式会社ビジュアルワークス","roleCodes":["d