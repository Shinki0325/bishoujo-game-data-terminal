"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"67"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A newcomer in the Sales Department at Glaðsheimr Japan. He was a member of the rowing club at the same university as Kuze, and joined Glaðsheimr because of his admiration for Kuze. He is a good worker and has a friendly personality, which makes him an idol and a mascot in the Sales Department. In fact, he is very popular with the opposite sex, but he doesn't realize it."},{"spoiler":false,"text":"Translated from the Official Website"}],"source":"vndb","sourceCharacterId":"c99306"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57072a49699674e3c4d6e3496c154e13322c9496d8068e85c8ddb1f59a3930db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/672e74ef5e74b91d37bce93de9ba8cb2029cca4411226e67434bfbf199609cf3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"烏丸 葉月","creatorId":"vndb:s1402","sourcePersonId":"vndb:s1402","canonicalEntityId":"vndb:s1402","name":"烏丸 葉月","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:69725","source":"vndb"}]},{"characterId":"char_vndb_c99307","characterName":"佐々木 陣","sourceIds":{"vndbCharacterId":"c99307"},"originalCharacterName":"佐々木 陣","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"27"},"birthday":{"reviewState":"source-only","source":"vndb","value":"119"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-onl