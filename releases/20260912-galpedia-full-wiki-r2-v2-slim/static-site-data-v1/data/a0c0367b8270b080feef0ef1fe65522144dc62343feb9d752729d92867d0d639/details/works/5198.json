"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"７６"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"７７"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５５"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公・ミルディンの義妹。"},{"spoiler":false,"text":"本来は優しい性格なのだが、人見知りが激しく、少ない口数と警戒心の強さから、あらぬ誤解を与えてしまうこともしばしば。"},{"spoiler":false,"text":"洗濯や掃除、勉学などは得意だが、料理や裁縫など、指先の器用さを求められるものは総じて苦手。"}],"source":"egs","sourceCharacterId":"27058","sourceWorkId":"3524","spoiler":false},{"segments":[{"spoiler":false,"text":"ミルディンの義妹。人見知りが強く、やや内向的。本来は優しい少女ではあるが、少ない口数と警戒心の強さから、あらぬ誤解を与えてしまうことも多々ある。性格にも口調にも曖昧さがなく、そのことも他人を遠ざける一因となっているようだ。勉学は得意。しかし魔術は不得手。掃除や洗濯はそつ無くこなすものの、料理や裁縫などといった指先の動きを求められるものには持ち前の不器用さを発揮する。"}],"source":"bangumi","sourceCharacterId":"140332"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/119c9725417b5caec41f66459d2c5e4fcacc372846b52ed69d5cf2304a9080a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8beeaaa08045ff5ca29a8e3c5d19b5f3d5d06a42ce4c104694495fff56436734.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あおきさやか","creatorId":"vndb:s194","sourcePersonId":"vndb:s194","canonicalEntityId":"vndb:s194","name":"あおきさやか(青木静香)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:461392:140332:4869:1","source":"bangumi"}]},{"characterId":"char_c51716","characterName":"サラ・メッケイン","sourceIds":{"bangumi":[{"characterId":"140334","match":"exact-normalized-name-in-linked-work","subjectId":"99023"}],"egsCharacterIds":["27061"],"vndbCharacterId":"c51716"},"originalCharacterName":"サラ・メッケイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"８７"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"８９"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５６"}},"descriptions":[{"segments":[{"spoiler":false,"text":"名門貴族“メッケイン”家の息女。"},{"spoiler":false,"text":"成績優秀、容姿端麗、品行方正で生徒会長も務める、どこへ出しても申し分のない優等生。"},{"spoiler":false,"text":"ただ、上流階級の生活が身に染みているため、牧歌的なマグランでは、時折、微笑ましい非常識をやってしまうことも。"}],"source":"egs","sourceCharacterId":"27061","sourceWorkId":"3524","spoiler":false},{"segments":[{"spoiler":false,"text":"ハイランド名門貴族メッケイン家の長女。成績優秀、容姿端麗と、どこを切り出しても申し分のない器量を持った優等生で、学園内では生徒会長を務めるなど周囲の信頼は篤い。性格にしても社交的で人当たりが良く、まさに非の打ち所のない少女と言える。しかし上流階級の生活が身体に染みついてしまっているため、牧歌的な風土のマグランにおいての彼女の常識は、時折、微笑ましい非常識を生み出してしまうようだ。"}],"source":"bangumi","sourceCharacterId":"140334"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3a80822e8a073f68303b10640e88a75b4b3b4291a25b24807761b4e4d04896d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efaa2247040aa077d9be7c43bf89344273456a32a9729accd645b15a3aab9085.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"海原 エレナ","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"横手 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5498","source":"vndb"}]},{"characterId":"char_c51717","characterName":"スノゥ・フラン","sourceIds":{"bangumi":[{"characterId":"140335","match":"exact-normalized-name-in-linked-work","subjectId":"99023"}],"egsCharacterIds":["27062"],"vndbCharacterId":"c51717"},"originalCharacterName":"スノゥ・フラン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"８３"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"８０"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５７"}},"descriptions":[{"segments":[{"spoiler":false,"text":"運動神経の良さと天性の動体視力を持つ、武術剣術専攻の少女。"},{"spoiler":false,"text":"その成績は、学園内トップクラスだが、反面、魔術への適性の低さは、学園内ワーストクラス。"},{"spoiler":false,"text":"真っすぐな性格と爽やかな笑顔で、男女問わず人気があるが、彼女自身は、異性との会話を最も不得手としている。"}],"source":"egs","sourceCharacterId":"27062","sourceWorkId":"3524","spoiler":false},{"segments":[{"spoiler":false,"text":"学園では少数派の、武術剣術を専攻する少女。運動神経の良さと、天性の動体視力で成績は常に上位を保っている。その反面、魔術適性は学園全体でも下から数えられるほど低く、自他共に適性は皆無と認知されているようだ。少年のような顔立ちと素直な性格、清々しい笑顔で、学園内では同性にも異性にも人気が高い。性格は穏やかで心優しく、やや内向気質。異性との会話は彼女が最も不得手としている分野だ。"}],"source":"bangumi","sourceCharacterId":"140335"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d71796233d7ef7f42c25fbde3dd92b0bdf8eec7d3f91d9ce059dd48e435a899.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1270e4aa280b24643a3b0f44852ddde971d261bc92b133442c5eeb95b54d539.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤美佳子","creatorId":"vndb:s1137","sourcePersonId":"vndb:s1137","canonicalEntityId":"vndb:s1137","name":"佐藤 美佳子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:461392:140335:6122:1","source":"bangumi"}]},{"characterId":"char_vndb_c51577","characterName":"水島 瞳","sourceIds":{"vndbCharacterId":"c51577"},"originalCharacterName":"水島 瞳","characterNameSource":null,"role":"primary","status":"so