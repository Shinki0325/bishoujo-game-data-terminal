8"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52d9e83b3412affc16da7ad85acb766f42df1ba3e8d38376273d21030da5363a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9c98db37d7312af6a9958054c7bce512b35518af394584d3b3a9dc5c5e79d5c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏野 こおり","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73612","source":"vndb"}]},{"characterId":"char_vndb_c43579","characterName":"ルーシャ・ヘインズ","sourceIds":{"vndbCharacterId":"c43579"},"originalCharacterName":"ルーシャ・ヘインズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a young girl who manages the diner with the main character. While capable and reliable, she is inept with relationships, often finding it difficult to be forthright with her affections. She trusts the main character like family, and when the two of them are alone, she will sometimes show her childish side."},{"spoiler":false,"text":"\"Personally, I think it would be a lot of fun if more people were to come and bring some life to this place.\""}],"source":"vndb","sourceCharacterId":"c43579"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cba9cffff6ae71eb734aeaa5b4ec10f16c28ba711405d27e5a71f9f60c3693ef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b97ad8cb53c8196ea6542a42f61f1c5cc8657d0828bc4044d9e9bd1500e0b164.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"かわしま りの","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73613","source":"vndb"}]},{"characterId":"char_vndb_c43582","characterName":"カレン・ランカスター","sourceIds":{"vndbCharacterId":"c43582"},"originalCharacterName":"カレン・ランカスター","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A lady belonging to the town's vigilante corps. Teasing the main character is one of her favorite pastimes. She has been taking care of the main character since a long time ago, and continues to act as everyone's older sister. She is also researching the \"disaster\" that occurred at some point in the past, and continues to investigate the mystery of the vampires that terrorized the world."},{"spoiler":false,"text":"\"That might mean a lonely battle. Can you do this?\""}],"source":"vndb","sourceCharacterId":"c43582"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a09e6ed28f4defa54a800ebf61c7a1541d4c52df39e471cab52284267348795.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/897d02c837be101ead8af5578d29312eb66beb598bc08e9e8c23b067f8cd25fd.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風音","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73614","source":"vndb"}]},{"characterId":"char_vndb_c51872","characterName":"レオン・レアード","sourceIds":{"vndbCharacterId":"c51872"},"originalCharacterName":"レオン・レアード","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/2043708e1d237af0937d11c5475f8f816e04881bfdbec8807b9c9104492e9df1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec87f4caa497edba5012a5584e1a8f490b307ae5f60da4148eab5d69c4407547.webp","width":191,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62752","characterName":"レベッカ・バレンタイン","sourceIds":{"vndbCharacterId":"c62752"},"originalCharacterName":"レベッカ・バレンタイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One day, she visits Leon's diner. With a gentle, tender personality and the disposition of an older sister, she handles any and all household chores flawlessly, and has excellent skills in horticulture -- rare in this \"Age of Dusk\". But the truth is, she is under certain \"circumstances\"..."},{"spoiler":false,"text":"\"After all... I didn't come here for the store. I came here to see you, Leon.\""}],"source":"vndb","sourceCharacterId":"c62752"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/6440c3153986efe509eb8dcb276f8fd53b438cbfd6befdf1b425366aa9310e03.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/206363487d3514d06b0a5ed1a34c76e2116dcd549e9a92de1870ac3465dd624e.webp","width":256,"height":255,"source":"static-detail"},"actors":[{"creditedName":"春山 色葉","creatorId":"vndb:s3220","sourcePersonId":"vndb:s3220","canonicalEntityId":"vndb:s3220","name":"春山色葉","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73616","source":"vndb"}]},{"characterId":"char_vndb_c62753","characterName":"マリ・ミズノ","sourceIds":{"vndbCharacterId":"c62753"},"originalCharacterName":"マリ・ミズノ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Holding ninjas in great esteem, this girl trains day and night. Leon finds her on the brink of starvation and comes to her aid, leading her to respect him greatly. She never slacks on her training, leading her to possess great physical prowess -- she makes full use of this, volunteering to guard the diner."},{"spoiler":false,"text":"\"Though I am a ninja, I remain but an apprentice, so I spend my days doing little more than training.\""}],"source":"vndb","sourceCharacterId":"c62753"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13712520fa77321afdb9908a521d4383fd768347a90bb8b865b8a3789b6dce84.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06b9c5b1140b32f49cd2100c71e2ff025c586d542d6bcaed5c78846ae02bda85.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"星鹿 りえ","creatorId":"vndb:s6525","sourcePersonId":"vndb:s6525","canonicalEntityId":"vndb:s6525","name":"櫻井 菜々絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73617","source":"vndb"}]},{"characterId":"char_vndb_c69697","characterName":"Sandy","sourceIds":{"vndbCharacterId":"c69697"},"originalCharacterName":"Sandy","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewS