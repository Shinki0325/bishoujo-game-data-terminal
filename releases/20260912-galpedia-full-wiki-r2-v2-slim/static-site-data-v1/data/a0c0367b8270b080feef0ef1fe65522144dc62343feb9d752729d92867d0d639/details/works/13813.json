{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"13813","model":{"presentationWorkId":"vndb:v195","staff":{"artwork":[{"creditedName":"のり太","creatorId":"vndb:s1161","sourcePersonId":"egs:creator:1462","canonicalEntityId":"vndb:s1161","name":"のり太","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:85947","source":"egs"},{"creditedName":"ヨダ","creatorId":"vndb:s7018","sourcePersonId":"vndb:s7018","canonicalEntityId":"vndb:s7018","name":"ヨダ","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:5775","source":"vndb"}],"scenario":[{"creditedName":"嵩夜あや(由比雅雪)","creatorId":"vndb:s1162","sourcePersonId":"egs:creator:1181","canonicalEntityId":"vndb:s1162","name":"嵩夜あや(由比雅雪)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:85956","source":"egs"},{"creditedName":"叶 希一","creatorId":"vndb:s1815","sourcePersonId":"vndb:s1815","canonicalEntityId":"vndb:s1815","name":"叶 希一","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:5771","source":"vndb"}],"music":[{"creditedName":"ジズスタジオ","creatorId":"vndb:s167","sourcePersonId":"vndb:s167","canonicalEntityId":"vndb:s167","name":"ジズスタジオ","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:5762","source":"vndb"},{"creditedName":"磯江 俊道","creatorId":"vndb:s3664","sourcePersonId":"vndb:s3664","canonicalEntityId":"vndb:s3664","name":"磯江 俊道","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:5772","source":"vndb"},{"creditedName":"大山 曜","creatorId":"vndb:s5448","sourcePersonId":"vndb:s5448","canonicalEntityId":"vndb:s5448","name":"大山 曜","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:5773","source":"vndb"},{"creditedName":"立花 泰彦","creatorId":"vndb:s6572","sourcePersonId":"vndb:s6572","canonicalEntityId":"vndb:s6572","name":"立花 泰彦","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:5774","source":"vndb"},{"creditedName":"川越 好博","creatorId":"vndb:s8342","sourcePersonId":"vndb:s8342","canonicalEntityId":"vndb:s8342","name":"川越 好博","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:5778","source":"vndb"},{"creditedName":"菅谷 豊","creatorId":"vndb:s8343","sourcePersonId":"vndb:s8343","canonicalEntityId":"vndb:s8343","name":"菅谷 豊","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:5779","source":"vndb"}],"other":[{"creditedName":"RaptorFB","creatorId":"vndb:s27699","sourcePersonId":"vndb:s27699","canonicalEntityId":"vndb:s27699","name":"RaptorFB","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:5759","source":"vndb"},{"creditedName":"Neko","creatorId":"vndb:s27714","sourcePersonId":"vndb:s27714","canonicalEntityId":"vndb:s27714","name":"Neko","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:5760","source":"vndb"},{"creditedName":"Kou","creatorId":"vndb:s27743","sourcePersonId":"vndb:s27743","canonicalEntityId":"vndb:s27743","name":"Kou","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:5761","source":"vndb"},{"creditedName":"榊原 ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:5763","source":"vndb"},{"creditedName":"有里亜","creatorId":"vndb:s983","sourcePersonId":"vndb:s983","canonicalEntityId":"vndb:s983","name":"有里亜","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:5764","source":"vndb"},{"creditedName":"のり太","creatorId":"vndb:s1161","sourcePersonId":"vndb:s1161","canonicalEntityId":"vndb:s1161","name":"のり太","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:5765","source":"vndb"},{"creditedName":"のり太","creatorId":"vndb:s1161","sourcePersonId":"vndb:s1161","canonicalEntityId":"vndb:s1161","name":"のり太","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:5767","source":"vndb"},{"creditedName":"嵩夜 あや","creatorId":"vndb:s1162","sourcePersonId":"vndb:s1162","canonicalEntityId":"vndb:s1162","name":"嵩夜 あや","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:5769","source":"vndb"},{"creditedName":"でじたろう","creatorId":"vndb:s1250","sourcePersonId":"vndb:s1250","canonicalEntityId":"vndb:s1250","name":"小坂 崇氣","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:5770","source":"vndb"},{"creditedName":"ヨダ","creatorId":"vndb:s7018","sourcePersonId":"vndb:s7018","canonicalEntityId":"vndb:s7018","name":"ヨダ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:5776","source":"vndb"},{"creditedName":"渡邊 憲博","creatorId":"vndb:s7868","sourcePersonId":"vndb:s7868","canonicalEntityId":"vndb:s7868","name":"渡邊 憲博","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:5777","source":"vndb"},{"creditedName":"エノモト","creatorId":"vndb:s10358","sourcePersonId":"vndb:s10358","canonicalEntityId":"vndb:s10358","name":"エノモト","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:5780","source":"vndb"},{"creditedName":"エノモト","creatorId":"vndb:s10358","sourcePersonId":"vndb:s10358","canonicalEntityId":"vndb:s10358","name":"エノモト","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:5781","source":"vndb"},{"creditedName":"株式会社ニトロプラス","creatorId":"vndb:s11900","sourcePersonId":"vndb:s11900","canonicalEntityId":"vndb:s11900","name":"株式会社ニトロプラス","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:5782","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c10778","characterName":"鏑木 瑞穂","sourceIds":{"vndbCharacterId":"c10778"},"originalCharacterName":"鏑木 瑞穂","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"512"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mizuho is a male protagonist who transfers to an all-girls school per his grandfather's will and must crossdress in order to attend. He already looks very androgynous, so the change thankfully isn't obvious to the other members of the school. However, Mizuho is always nervous about being found out and constantly worries that it will happen. In spite of this, he was well received on his first day at school and has already become very popular among the students. At first he was shocked when he found out about the will, but with the help of his childhood friend Mariya Mikado, who also attends the school, he was able to resign himself to transferring to the school. Despite making the change, he still uses language which is usually only used by males in Japan such as boku (僕), meaning \"I\". He is generally depicted in his school uniform wearing breast prostheses underneath."},{"spoiler":false,"text":"Mizuho had to use the surname Miyanokouji, his mother's maiden name, in order to enter into the school; his actual surname is Kaburagi (鏑木). The Kaburagi family's biggest rival is the Itsukushima family, both of which are very well-endowed in terms of money and power. Mizuho didn't realize it at first, but Takako is a member of that Itsukushima family. Despite this, Mizuho doesn't see her as a rival and enjoys her company very much. In fact, they share world history class together and sit next to each other. They often talk to each other during class by either whispering or passing notes."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c10778"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e834461c198583418527b3613f9c4e37323c13afad460919a574ddb606297af1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/4889043d4c33066399eff8c1127af2e2d7f1bd6b68216385d27db76a8b04ac4b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神村 ひな","creatorId":"vndb:s1137","sourcePersonId":"vndb:s1137","canonicalEntityId":"vndb:s1137","name":"佐藤美佳子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2065","source":"vndb"}]},{"characterId":"char_vndb_c10779","characterName":"十条 紫苑","sourceIds":{"vndbCharacterId":"c10779"},"originalCharacterName":"十条 紫苑","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"321"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shion is one of Mizuho's classmates who figures out that he is a boy almost immediately, after their second meeting, but tells him that she will keep it a secret from anyone else. She tends to have a silent demeanor and voice which helps to give her an appealing appearance to the rest of the students. The previous year, she actually had to leave school for a time soon after she was elected as the Elder due to an illness and had to spend her time in the hospital. In effect, she has come back this year in order to repeat her last year, though she still isn't fully recovered, as she will pass out if she exerts herself too much. She becomes an adviser and a female role-model for Mizuho."},{"spoiler":false,"text":"She has been engaged to Kazutaka Itsukushima who is Takako's older brother in Shion's path; Itsukushima family is upstart, and so Takako's father made Kazutaka to be engaged to Shion in order to get Juujou family status because the Juujou family is a former aristocratic (Kōshaku (侯爵)) family. Takako asks Mizuho to rescue Shion from the Itsukushima family."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c10779"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/9709acef7a929d066af395260992542dfcc1f5248d9f21e1a853ce2b972ec104.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e67979b0969a66c386b94628babb1287cff01fabe093344479e1eb584d0e6f4.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木原 泉","creatorId":"vndb:s777","sourcePersonId":"vndb:s777","canonicalEntityId":"vndb:s777","name":"吉住 梢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2062","source":"vndb"}]},{"characterId":"char_vndb_c10796","characterName":"御門 まりや","sourceIds":{"vndbCharacterId":"c10796"},"originalCharacterName":"御門 まりや","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"608"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mariya is Mizuho's first cousin and childhood friend who knows him very well. When it was decided that Mizuho would transfer to the all-girls school she also attends, she took it upon herself to transform him into a beautiful girl by use of makeup and seemed to have a lot of fun dressing him up."},{"spoiler":false,"text":"Mariya has a very spirited personality which she uses often to make sure Mizuho is acting feminine in every way: appearance, mannerisms, and even speech. This often includes using mild violence. Also, she has a temper, of which she has little control and which sometimes causes her to do unadvisable things or carry grudges to an extreme - such as her grudge against Takako. During most of the time that Mariya has known Mizuho, she has always been there as his support whenever he needed her, though later on in the series she finds that without her even realizing it, he has already managed to stand on his own in terms of self-confidence and maturity. Initially, she is very uneasy about this change and is unsure on how to act towards Mizuho after this revelation. Also, she discovers herself to be harboring some romantic feelings for Mizuho, of which she had been unaware herself. Mariya is in the track and field club and she has another name \"Matsurika no Kimi\" at Seio Girls' Academy. She also is Yukari's onee-sama."},{"spoiler":true,"text":"She goes to study abroad in United States after her graduation."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c10796"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e81611264709b5a69393e5a30d3a6f10928edcb3d927a640671b3d3e462e63d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a73a00546edb08c6233ad2b9f4a6e15bb3e24a0cc94a776947cbced776411d0b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あおい ひとみ","creatorId":"vndb:s1160","sourcePersonId":"vndb:s1160","canonicalEntityId":"vndb:s1160","name":"岩居 由希子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2068","source":"vndb"}]},{"characterId":"char_vndb_c10797","characterName":"周防院 奏","sourceIds":{"vndbCharacterId":"c10797"},"originalCharacterName":"周防院 奏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"826"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"140"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kana is another one of the girls who lives in the same dormitory building as Mizuho, who becomes her onee-sama (お姉さま, meaning \"Older sister\"). Kana is more than happy to serve Mizuho any way she can, since she admires him immensely. Kana, who like Yukari is a first-year student, has been waiting for the chance to have an onee-sama as she has always been envious of Yukari having Mariya to fill that role. One of the defining features about her is that she often ends sentences with the phrase ~na no desu yo (roughly, \"it's the case that...\")."},{"spoiler":false,"text":"Kana wears a large pink ribbon in her hair which was given to her by the director of the orphanage she lived at for much of her life. Ultimately, the director, who loved Kana in place of her missing parents, died right after giving her the ribbon and due to this, she almost never takes the ribbon off. Kana has never seen her mother's or father's faces. But she goes to the school on a scholarship by her effort because the ribbon gives the strength of mind to Kana."},{"spoiler":false,"text":"Kana is in the drama club. She easily gets nervous on the stage, but she is selected for the leading role at the school festival by Kei who is the president of the club. The stage is favorably received. She plays the main role on the stage after that, and she is called \"Shiragiku no Kimi\" at Seio Girls' Academy."},{"spoiler":true,"text":"Later in the game Kana becomes the president of the club and the seventy-fourth elder sister. She enters an university and joins a theatrical company after her graduation."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c10797"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/024016a2cffce73b3b481f1f4778da3701599e103213add7c1df18509203d810.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d73c384edea355d6c40ced4ace44917efa52baaac0a8c9a90dccf643924e5cb.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村 あやか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2059","source":"vndb"}]},{"characterId":"char_vndb_c10798","characterName":"上岡 由佳里","sourceIds":{"vndbCharacterId":"c10798"},"originalCharacterName":"上岡 由佳里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"218"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"152"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yukari is one of the first year students at the school who lives in the same dormitory building as Mizuho and Mariya, who also is her onee-sama; it is a tradition for the underclassmen to serve their respective senpai any way they can. Much like Kana and Mariya, she is a very energetic girl, although unlike them, she is deathly afraid of ghost stories and anything scary - a fact which Mariya has often used for her own amusement and which initially caused some trouble when Yukari met Ichiko."},{"spoiler":false,"text":"Yukari is on the track and field team along with Mariya, though her main reason for joining was due to her older sister-in-law who had urged her to come to this school and who was also in track and field. However, Yukari soon comes to discover that she really does have a liking for track and field and continues activities in the club even after a time of losing much of her self-confidence."},{"spoiler":false,"text":"Her another name is \"Kohaku no Kimi\" at Seio Girls' Academy."},{"spoiler":true,"text":"She became the student council president and the captain of the track and field club."},{"spoiler":true,"text":"Incidentally, she retires from the club just before Mizuho's graduation and she begins to study in earnest so that she will enter Mizuho's university in her path."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c10798"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f585faef613ec16077de07c0ed6906bd7f20c5039497984332423dceae8718f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b65f8a8f5ba73774064c1073ff33ab87ea9fead826db1b07420c6bf6b9c94b28.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松永 雪希","creatorId":"vndb:s452","sourcePersonId":"vndb:s452","canonicalEntityId":"vndb:s452","name":"永見 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2055","source":"vndb"}]},{"characterId":"char_vndb_c10799","characterName":"厳島 貴子","sourceIds":{"vndbCharacterId":"c10799"},"originalCharacterName":"厳島 貴子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1116"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Takako is the student council president of the all-girls school where the story takes place. She tends to have a serious personality which compliments that of a student council president. As the president, she knows that she must be very decisive in her actions and thus cannot often hesitate with her decisions, since she knows the students would have trouble following her if she didn't act as such. As it is, Takako herself has stated how she almost never has confidence in herself."},{"spoiler":false,"text":"In contrast to her usual attitude, she has shown herself to have a more gentle side to her character. Eventually, she begins to form feelings for Mizuho, though while still under the belief that Mizuho is a girl, she is at first confused about what she has been feeling. She also has a high fear of ghosts."},{"spoiler":false,"text":"A few years back, Takako was invited to join the track and field team during the same time that the election for new student council members was being held. It was not that she didn't want to join track and field, but ultimately she declined their offer and was able to get elected to the student council. After this incident, Mariya, who is also in the Track and Field Club, thought that her response was unforgivable and thus has carried a grudge against Takako ever since. The truth of the matter was that Takako couldn't handle both the track and field and student council activities simultaneously, though Mariya could never accept this as the truth. She also falls in love with Mizuho even before she finds out his secret."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c10799"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fd81b9193edc75de02db270a932dec9aed43123b4f5165398c40b55ee262778.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a66b0d4fa2a9e03e7b7ce7a433027b3cb21ca43019624d35aef76fd39e8e189.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐本 二厘","creatorId":"vndb:s794","sourcePersonId":"vndb:s794","canonicalEntityId":"vndb:s794","name":"結下 みちる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2063","source":"vndb"}]},{"characterId":"char_vndb_c10800","characterName":"高島 一子","sourceIds":{"vndbCharacterId":"c10800"},"originalCharacterName":"高島 一子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1124"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"154"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ichiko is, in fact, a ghost. Her story begins 22 years ago: a previous Elder (actually Mizuho's mother) had a close relationship with an underclassmen who had a weak body. When that underclassman was in hospital, she could not wait to see the Elder. The underclassman got away from the hospital, went to the Elder's room, and waited, but she died before she had the chance to talk with the Elder. That room has been deemed the \"closed room\" ever since, until Mizuho arrived and started living in it, according to his grandfather's will."},{"spoiler":false,"text":"She is very energetic and hyperactive, often talking very fast. She took some time to understand that she is a ghost, and by that, dead. She says that Mizuho looks very much like her previous Elder love interest. Although she can touch people, she cannot pick up objects and she slips through walls. Invisible barriers prevent her from leaving the dorm, but her movable range has extended to the school site after a certain event. Also, she has a capacity for spirit possession and this helps Mizuho in a critical phase once."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c10800"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91b28433df6f5b7d78e26bce2d91455d18960fcb70b8d86e5e605fc10adfb5bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b0a5492e5b5118e76c240602dea6395c9a5c786e5cba70edf7605e9cf88530a.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"草柳 順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2060","source":"vndb"}]},{"characterId":"char_vndb_c10801","characterName":"梶浦 緋紗子","sourceIds":{"vndbCharacterId":"c10801"},"originalCharacterName":"梶浦 緋紗子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"108"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hisako is Mizuho's homeroom teacher of his class (3-A) and is one of the few people in the entire school who knows that Mizuho is in fact a boy, other than Mariya, the headmistress, the deputy head teacher and later Shion and Ichiko. She has a helping personality and even told Mizuho to come to her if anything was bothering him. She often gives out candy to her students."},{"spoiler":false,"text":"She was a student of Seio Girls' Academy several years ago, but she had to transfer to another school because of her father's job. She became a sister and a teacher at the school because of Shiori's death after her changing school."},{"spoiler":true,"text":"Later, she resigns from the teacher, becomes a novelist and wrote a novel filled with memories about Shiori under the pen name Hisa Kamimura. Therefore she is a novelist, she is Chitose's homeroom teacher and the acting principal at the school because and Sawe (a sister at the academy and its principal) asked her the reappointment and the deputy of Sawe while Sawe is under medical treatment."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c10801"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a1d422447ecb88f40d7acf7c09924d17c5fc01f12637ae1991747013d402a4f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c47b12af441c81b8e007ae447047f791e94712dd9678bacd0194cac9b8525149.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一色 ヒカル","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2052","source":"vndb"}]},{"characterId":"char_vndb_c10802","characterName":"小鳥遊 圭","sourceIds":{"vndbCharacterId":"c10802"},"originalCharacterName":"小鳥遊 圭","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kei is a strange girl in Mizuho's class who usually has a quiet voice and doesn't show much emotion which often gives her a creepy visage. She is the director of the drama club and during times on stage she has to be very forceful in order to get a good response out of her actors."},{"spoiler":false,"text":"A character with the same name and similar appearance,Takanashi Kei, appears in Alicematic, a game made by Caramel Box (the same studio that created Otoboku)."}],"source":"vndb","sourceCharacterId":"c10802"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/676b4e0340cbab18cbdcf1308569ec5011917ced4f00e3ceaf5a40983958e44d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e5175be5381f6440278b303bdb0ae6681e06fb3168eca182dc905ad4e5cd971.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一色 ヒカル","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2053","source":"vndb"},{"creditedName":"釘宮 理恵","creatorId":"vndb:s500","sourcePersonId":"vndb:s500","canonicalEntityId":"vndb:s500","name":"釘宮理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2058","source":"vndb"}]},{"characterId":"char_vndb_c10804","characterName":"高根 美智子","sourceIds":{"vndbCharacterId":"c10804"},"originalCharacterName":"高根 美智子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Michiko is also in Mizuho's class and is a good friend of Kei's as they are constantly seen hanging out together. Unlike Kei, Michiko usually has a smile on her face and is a fairly social person."},{"spoiler":false,"text":"Voiced by: Hina Kamimura (PC), Yukari Fukui (PS2/PSP)"},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c10804"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da8abbafc8eec01442da4b6c91a4854039f4a7f081398d6398d350ca24cb016d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/631cc28be16fa4726f1139e25d92364f49f7d3fd6dfb7cddc5048720dfc833c6.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神村 ひな","creatorId":"vndb:s1137","sourcePersonId":"vndb:s1137","canonicalEntityId":"vndb:s1137","name":"佐藤美佳子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2066","source":"vndb"},{"creditedName":"福井 裕佳梨","creatorId":"vndb:s10439","sourcePersonId":"vndb:s10439","canonicalEntityId":"vndb:s10439","name":"福井 裕佳梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2070","source":"vndb"}]},{"characterId":"char_vndb_c10805","characterName":"長谷川 詩織","sourceIds":{"vndbCharacterId":"c10805"},"originalCharacterName":"長谷川 詩織","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shiori was Hisako's kouhai at Seio Girls' Academy in her school days. She was good at the piano and was a scholarship student of the music class at the school."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c10805"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a52287eb83fdfcdd40a83b463c365f77d51b51de6535470b8e208a616a68f2bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22720c0da5ec3a810e1255d0d87c99b10418f8f21ac7780efd85898166e7dd03.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柚木 涼香","creatorId":"vndb:s495","sourcePersonId":"vndb:s495","canonicalEntityId":"vndb:s495","name":"柚木 涼香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2057","source":"vndb"},{"creditedName":"佐本 二厘","creatorId":"vndb:s794","sourcePersonId":"vndb:s794","canonicalEntityId":"vndb:s794","name":"結下 みちる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2064","source":"vndb"}]},{"characterId":"char_vndb_c10806","characterName":"菅原 君枝","sourceIds":{"vndbCharacterId":"c10806"},"originalCharacterName":"菅原 君枝","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kimie is a treasurer of the student council and as such, she follows Takako around almost all the time. When they are not together, Kimie will go around investigating various matters and report back to Takako. Much like Takako, she has a very serious personality and would not stop at sticking up for Takako when need be."},{"spoiler":true,"text":"She becomes the student council president for the next term in Takako's path. She is the seventy-third elder sister and her another name is Kaguya no Kimi."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c10806"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/ddb5783f1fa4989063ca661e6c179ad23545bd3ea2de41ac612d8b12614db015.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a27917b675a0fa3f7bdbd75ad20c12a843aaee3b5c4a3baa261b2240b567b675.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"草柳 順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2061","source":"vndb"},{"creditedName":"日笠山 亜美","creatorId":"vndb:s13096","sourcePersonId":"vndb:s13096","canonicalEntityId":"vndb:s13096","name":"日笠山 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2071","source":"vndb"}]},{"characterId":"char_vndb_c10807","characterName":"美倉 サヱ","sourceIds":{"vndbCharacterId":"c10807"},"originalCharacterName":"美倉 サヱ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sawe is a sister and a principal at Seio Girls' Academy. She admitted Mizuho to the school, which makes her one of the few people who knew that Mizuho is a boy from the beginning."},{"spoiler":false,"text":"Voiced by: Hitomi Aoi"}],"source":"vndb","sourceCharacterId":"c10807"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9def1ffe7e44eceb1f14908438e09bf4683b097411e4d6ab8ced7b551115ade6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/8424c9aa6428d478ad29c1ab5f1c399e0badd9c091fe761277fb64ef0c1d8ecb.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c10908","characterName":"烏橘 可奈子","sourceIds":{"vndbCharacterId":"c10908"},"originalCharacterName":"烏橘 可奈子","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kanako, is same grade with Yukari and Kana, is a secretary of student council in the first and second grades, and the vice-president in the third grade. She speaks in a slow tone."},{"spoiler":false,"text":"She has a younger sister named Sayoko, who appears in Otoboku's sequel, Futari no Elder."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c10908"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a108d524f60e9eb15017dff389200bb5b4e5fee4128e93b7492c4c669da92df5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be3311891fc6d9705811b94e050c5c7e7d10bf691c13d429cef26e5a3795f535.webp","width":197,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c10909","characterName":"門倉 葉子","sourceIds":{"vndbCharacterId":"c10909"},"originalCharacterName":"門倉 葉子","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Youko is in the same grade as Kimie, she the student council's vice-president at the school and has a cool personality."},{"spoiler":false,"text":"She becomes the student council vice-president, or the president, depends on the route. She is called \"Mikado no Kimi\" in the third grade."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c10909"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68fd5e1cbd42844fe0fb9b316f1b2c9d77802a3ffc568dd692dba54c00b8b566.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/bacd480fb5dbc2220bd8e6a5b7aacfeaca8a10020023d2ca58e65f861926b9be.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松永 雪希","creatorId":"vndb:s452","sourcePersonId":"vndb:s452","canonicalEntityId":"vndb:s452","name":"永見 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2056","source":"vndb"}]},{"characterId":"char_vndb_c10910","characterName":"香原 茅乃","sourceIds":{"vndbCharacterId":"c10910"},"originalCharacterName":"香原 茅乃","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kayano is the head of the flower arrangement club. She is Mariya's flower arrangement tutor, and she is personally acquainted with Shion."},{"spoiler":false,"text":"Taken from Wikipedia."}],"source":"vndb","sourceCharacterId":"c10910"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c582e43bbeb8676decac8edeb3d34d6a45611ffabe83064fb246112841cae80f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b14d0ec6038f163e9a332ecddefe6f5a8991bc091a0510c77ede9cc4a595fc8.webp","width":195,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一色 ヒカル","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2054","source":"vndb"}]},{"characterId":"char_vndb_c10911","characterNa