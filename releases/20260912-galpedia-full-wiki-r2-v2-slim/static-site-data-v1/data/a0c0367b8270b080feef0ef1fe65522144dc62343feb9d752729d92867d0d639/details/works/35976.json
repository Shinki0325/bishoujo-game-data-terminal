}]},"cast":[{"characterId":"char_c134972","characterName":"周防 美由里","sourceIds":{"bangumi":[{"characterId":"152849","match":"exact-normalized-name-in-linked-work","subjectId":"478672"}],"egsCharacterIds":["25431"],"vndbCharacterId":"c134972"},"originalCharacterName":"周防 美由里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mature, beautiful, queen-like girl who has tremendous confidence in herself."},{"spoiler":false,"text":"However, she has a soft demeanor towards others and acts with ease and grace."},{"spoiler":false,"text":"Because her parents are also investors in the school, her status within the school is extremely high, and she is respected by everyone, both teachers and students."},{"spoiler":false,"text":"However, she does not hide her hostility toward the main character, and shows a side where she acts harshly, trying to use her influence to drive him out of the school."},{"spoiler":false,"text":"Translated from"}],"source":"vndb","sourceCharacterId":"c134972"},{"segments":[{"spoiler":false,"text":"自分に絶大な自信を持つ、大人びた美貌の女王様系女子。"},{"spoiler":false,"text":"それでいて他人への物腰は柔らかく、余裕に満ちた優雅な振る舞いをする上、親が学園への出資者でもあるために学園内での地位は極めて高く、教師・学生問わず誰からも一目置かれている。"},{"spoiler":false,"text":"だが、主人公に対してだけは敵意を隠さず、自分の影響力を利用して学園から追い出そうとするような苛烈な行動をする一面を見せる。"}],"source":"egs","sourceCharacterId":"25431","sourceWorkId":"35976","spoiler":false},{"segments":[{"spoiler":false,"text":"这位女王般自信满满、成熟美貌的女生。"},{"spoiler":false,"text":"尽管如此，她对他人非常温柔，举止优雅充满从容，不仅如此，由于她的父母是学校的资助者，因此在学校内地位非常高，受到教师和学生的尊敬。"},{"spoiler":false,"text":"然而，唯独对主人公，她毫不掩饰地露出敌意，展现出利用自己的影响力，试图将主人公从学校赶出去的残酷一面。"},{"spoiler":false,"text":"自分に絶大な自信を持つ、大人びた美貌の女王様系女子。"},{"spoiler":false,"text":"それでいて他人への物腰は柔らかく、余裕に満ちた優雅な振る舞いをする上、"},{"spoiler":false,"text":"親が学園への出資者でもあるために学園内での地位は極めて高く、教師・学生問わず誰からも一目置かれている。"},{"spoiler":false,"text":"だが、主人公に対してだけは敵意を隠さず、自分の影響力を利用して学園から追い出そうとするような苛烈な行動をする一面を見せる。"}],"source":"bangumi","sourceCharacterId":"152849"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"152849","value":"3年生"},{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"25431","sourceWorkId":"35976","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"25431","sourceWorkId":"35976","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"25431","sourceWorkId":"35976","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"25431","sourceWorkId":"35976","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"25431","sourceWorkId":"35976","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7beccfb83d041d8bdda07cb5e9897ea366ade3880f0679bdbdbf317a756373a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59c65e35d001a391c62df4d3bff3dd301d92b12264dea864fe94f0adb5d126d3.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:478672:152849:10027:1","source":"bangumi"}]},{"characterId":"char_c134973","characterName":"香坂 更紗","sourceIds":{"bangumi":[{"characterId":"152850","match":"exact-normalized-name-in-linked-work","subjectId":"478672"}],"egsCharacterIds":["25432"],"vndbCharacterId":"c134973"},"originalCharacterName":"香坂 更紗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A little devilish girl who charms men with her bewitching beauty that belies her age."},{"spoiler":false,"text":"Although she has a slender model body, she has curves that shows off her body, and a beauty that combines loveliness and luster, making her equally popular among the boys in the school."},{"spoiler":false,"text":"She is aware that she has good looks and is used to being admired by men, so she is fundamentally attracted to the opposite sex."},{"spoiler":false,"text":"In addition, she is a genius who can do most things better than most people, and because she doesn't really put in any effort, she has little interest in anything and has a lazy side."},{"spoiler":false,"text":"On the other hand, she also has an honest side that devotes herself wholeheartedly to things that interest her."},{"spoiler":false,"text":"Translated from"}],"source":"vndb","sourceCharacterId":"c134973"},{"segments":[{"spoiler":false,"text":"年齢に見合わない妖艶さで男を魅了する小悪魔少女。"},{"spoiler":false,"text":"すらっとしたモデル体型でいながら出るところは出ているコケティッシュなボディーラインに愛らしさと艶っぽさを兼ね備えた美貌で、学園中の男子からの人気を美由里と二分している。"},{"spoiler":false,"text":"自分の容姿が優れていることを自覚しており、男からちやほやされることに慣れているため根本的に異性を舐めてかかっている。"},{"spoiler":false,"text":"加えて大抵のことは人並み以上にこなせる天才肌な性質があり、特に努力することもなかったせいで何事にも関心が薄く、怠惰な面がある。"},{"spoiler":false,"text":"一方で、興味を持ったものには一途に打ち込む素直な一面も持っている。"}],"source":"egs","sourceCharacterId":"25432","sourceWorkId":"35976","spoiler":false},{"segments":[{"spoiler":false,"text":"年龄不相称的妖艳迷人的小恶魔少女。"},{"spoiler":false,"text":"她身材苗条如模特，却又展现出撩人心魂的俏皮身材线条，兼具可爱与妖艳之美，因此在学园里备受男生们的喜爱，与美由里齐名。"},{"spoiler":false,"text":"她意识到自己的容貌出众，习惯了男生的奉承，因此根本不将异性放在眼里。"},{"spoiler":false,"text":"此外，她具有超过常人的天才特质，大多数事情都能够轻松应对，特别是因为从未努力过，所以对任何事情都不太感兴趣，有些懒散的一面。"},{"spoiler":false,"text":"另一方面，对感兴趣的事物却有着坦诚投入的一面。"},{"spoiler":false,"text":"年齢に見合わない妖艶さで男を魅了する小悪魔少女。"},{"spoiler":false,"text":"すらっとしたモデル体型でいながら出るところは出ているコケティッシュなボディーラインに愛らしさと艶っぽさを兼ね備えた美貌で、学園中の男子からの人気を美由里と二分している。"},{"spoiler":false,"text":"自分の容姿が優れていることを自覚しており、男からちやほやされることに慣れているため根本的に異性を舐めてかかっている。"},{"spoiler":false,"text":"加えて大抵のことは人並み以上にこなせる天才肌な性質があり、特に努力することもなかったせいで何事にも関心が薄く、怠惰な面がある。"},{"spoiler":false,"text":"一方で、興味を持ったものには一途に打ち込む素直な一面も持っている。"}],"source":"bangumi","sourceCharacterId":"152850"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"152850","value":"1年生"},{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"25432","sourceWorkId":"35976","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"25432","sourceWorkId":"35976","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"25432","sourceWorkId":"35976","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"25432","sourceWorkId":"35976","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"25432","sourceWorkId":"35976","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4ce99a95c140fe1b344f01a137b7a8b46c862b671b9c05c4d56e3ea33ebe2aa7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c7e5126cedc7ba07a32758f43c8b86662e2b7b5da7135c964fbf13a31908eb2.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"清水美紗","creatorId":"vndb:s1975","sourcePersonId":"vndb:s1975","canonicalEntityId":"vndb:s1975","name":"よもぎかすみ(蓬かすみ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:478672:152850:21151:1","source":"bangumi"}]},{"characterId":"char_c134974","characterName":"神野 いおり","sourceIds":{"bangumi":[{"characterId":"152851","match":"exact-normalized-name-in-linked-work","subjectId":"478672"}],"egsCharacterIds":["25433"],"vndbCharacterId":"c134974"},"originalCharacterName":"神野 いおり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The student council president who is quite innocent despite her appearance."},{"spoiler":false,"text":"She is energetic and full of energy in everything she does."},{"spoiler":false,"text":"Since taking office as president, three changes have been made to the school regulations through her efforts."},{"spoiler":false,"text":"She often rushes and does reckless things, but she gets through it with her good nature and momentum."},{"spoiler":false,"text":"For better or for worse, she is a slave to her desires, s