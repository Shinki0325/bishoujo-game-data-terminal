"value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's true mother."},{"spoiler":false,"text":"She ran away from the family when her son was hospitalized and got remarried."}],"source":"vndb","sourceCharacterId":"c66400"},{"segments":[{"spoiler":false,"text":"主人公の実母。36歳。"},{"spoiler":false,"text":"茶道の家元（飾守家）の箱入り娘。"},{"spoiler":false,"text":"おっとりした雰囲気の優しい性格の女性。"},{"spoiler":false,"text":"十数年前、病気の主人公を置いて姿を消したが、主人公の父親と再婚し、一緒に住むようになる。"},{"spoiler":false,"text":"久しぶりに再会した息子が自分を憎んでいることを感じながらも、それは自分のでせいだと受け入れている。"}],"source":"egs","sourceCharacterId":"25438","sourceWorkId":"7841","spoiler":false},{"segments":[{"spoiler":false,"text":"優慈の実母。茶道の家元（飾守家）の箱入り娘。"},{"spoiler":false,"text":"十数年前、病気の主人公を置いて姿を消した。"},{"spoiler":false,"text":"父親の再婚相手として主人公の元に還ってくる。"},{"spoiler":false,"text":"久しぶりに会った息子は皐月のことを憎んでいた。しかし皐月は、自分のせいだからとそれを受け入れる。"}],"source":"bangumi","sourceCharacterId":"148516"}],"profileFacts":[{"label":"年龄（本版本）","value":"36 岁","valueContext":null,"source":"egs","sourceCharacterId":"25438","sourceWorkId":"7841","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c65fbdbc141bfd1cab43289a8f3f45a7415cc8c2f94438fb9facfcc28ccd0a2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8df2f4d05efe86265a629b1498015c2c71095eac00aa9383d8366e9c0602bf8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79361:148516:6036:1","source":"bangumi"}]},{"characterId":"char_c66401","characterName":"速水 静華","sourceIds":{"bangumi":[{"characterId":"148517","match":"exact-normalized-name-in-linked-work","subjectId":"79361"}],"egsCharacterIds":["25439"],"vndbCharacterId":"c66401"},"originalCharacterName":"速水 静華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公一家が暮らすマンションの部屋の隣に住む女性。38歳。"},{"spoiler":false,"text":"ギャンブルに溺れDVだった夫と別れ、現在は一人娘、夏と二人暮らし。"},{"spoiler":false,"text":"仕事が出来るキャリアウーマンで、凛とした雰囲気を持つも、物腰は優しく、柔らかい。"},{"spoiler":false,"text":"主人公一家とは、同じ境遇な面もあって家族ぐるみの付き合いがある。"},{"spoiler":false,"text":"母親の居なかった主人公にとって彼女は、母親代わりのような存在。"}],"source":"egs","sourceCharacterId":"25439","sourceWorkId":"7841","spoiler":false},{"segments":[{"spoiler":false,"text":"マンション暮らしの主人公一家の、隣の部屋に住んでいる女性。"},{"spoiler":false,"text":"夫とは早くに別れているが、別れた原因は、夫がギャンブルにおぼれ、静華や夏に暴力を振るっていたため。"},{"spoiler":false,"text":"離婚して以来、女手一つで一人娘の夏を育てた。主人公一家とは、隣に住んでいて、同じ母子家庭ということもあって付き合いが深い。"},{"spoiler":false,"text":"母親の居ない優慈の母親代わりだった女性。優慈の父親（秀一）の相談相手でもあった。娘の夏が大学の寮で一人暮らしを始めた為、現在は 一人暮らしをしている。"}],"source":"bangumi","sourceCharacterId":"148517"}],"profileFacts":[{"label":"年龄（本版本）","value":"38 岁","valueContext":null,"source":"egs","sourceCharacterId":"25439","sourceWorkId":"7841","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a543221dc51e05149e6bb425923e50be3337ea226f4b22cfc856b09c0a0b0c01.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d854e0a49187367639faad12f153a81cc2261e74183caf77c7d74be1074c6913.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由倉奈於","creatorId":"vndb:s923","sourcePersonId":"vndb:s923","canonicalEntityId":"vndb:s923","name":"由倉 奈於","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79361:148517:6083:1","source":"bangumi"}]},{"characterId":"char_c66402","characterName":"朝日奈 ステラ","sourceIds":{"bangumi":[{"characterId":"148520","match":"exact-normalized-name-in-linked-work","subjectId":"79361"}],"egsCharacterIds":["25441"],"vndbCharacterId":"c66402"},"originalCharacterName":"朝日奈 ステラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"高級住宅街の屋敷に住むイギリス人の有閑マダム。34歳。"},{"spoiler":false,"text":"ブロンドの髪と碧眼、巨乳の美貌の女性。"},{"spoiler":false,"text":"夫は優良企業、朝日奈グループの社長だが、その夫婦間は冷め切っている。"},{"spoiler":false,"text":"日本語はペラペラ。乗馬が趣味で、広大な敷地内にある馬場でその乗馬を楽しんでいる。"}],"source":"egs","sourceCharacterId":"25441","sourceWorkId":"7841","spoiler":false},{"segments":[{"spoiler":false,"text":"高級住宅街の屋敷に住むイギリス人のセレブ人妻。"},{"spoiler":false,"text":"夫は優良企業、朝日奈グループの社長だが、夫婦間は冷め切っている。"},{"spoiler":false,"text":"彼女の乗っていたリムジンが水たまりの水をはねて、優慈にかけてしまった事で、優慈と知り合う。"}],"source":"bangumi","sourceCharacterId":"148520"}],"profileFacts":[{"label":"年龄（本版本）","value":"34 岁","valueContext":null,"source":"egs","sourceCharacterId":"25441","sourceWorkId":"7841","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1dd03a8510c5698bd1007726978e32d25be37736f4baa0e7a53858837a9694c6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7ec00d2fd49aee6c009906ccc24d879bdf62f725048f835244f5c7912a32b01.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79361:148520:4675:1","source":"bangumi"}]},{"characterId":"char_c66403","characterName":"速水 夏","sourceIds":{"bangumi":[{"characterId":"148518","match":"exact-normalized-name-in-linked-work","subjectId":"79361"}],"egsCharacterIds":["25442"],"vndbCharacterId":"c66403"},"originalCharacterName":"速水 夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"静華の一人娘。主人公の幼馴染。女子大生。19歳。"},{"spoiler":false,"text":"母親譲りの美貌を持つ女の子で、性格は勝気でボーイッシュ。"},{"spoiler":false,"text":"父親と別れて以来、女手一つで育ててくれた母親を尊敬しており、女としての幸せを掴んで欲しいと願っている。"},{"spoiler":false,"text":"主人公に片想いしているが、告白はまだしていない。"},{"spoiler":false,"text":"現在、大学の寮で一人暮らし中。"}],"source":"egs","sourceCharacterId":"25442","sourceWorkId":"7841","spoiler":false},{"segments":[{"spoiler":false,"text":"静華の一人娘で優慈の幼なじみ。"},{"spoiler":false,"text":"女手一つで自分を育てた母親を母として、女性として尊敬している。"},{"spoiler":false,"text":"母親には幸せになってほしいと願っている。"},{"spoiler":false,"text":"優慈とは片親という共通点が有る為、悩みの共有者として、仲良く過ごしてきた。"},{"spoiler":false,"text":"優慈に対して恋心を抱いているが、うち明けてはいない。"},{"spoiler":false,"text":"将来の夢は学校の先生で、現在、教職を取るために大学に通っている。"},{"spoiler":false,"text":"大学の寮で一人暮らし中。"}],"source":"bangumi","sourceCharacterId":"148518"}],"profileFacts":[{"label":"年龄（本版本）","value":"19 岁","valueContext":null,"source":"egs","sourceCharacterId":"25442","sourceWorkId":"7841","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53678cccab0dae263e912dfa3775d5586fd10df155a16eb22eaa2c6e7609570f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e7f1f764ab687f147a310f3f0367d751dd672140921ec35b33ec213ecd1b3de.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井ありす","creatorId":"vndb:s1626","sourcePersonId":"vndb:s1626","canonicalEntityId":"vndb:s1626","name":"櫻井 ありす","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79361:148518:19213:1","source":"bangumi"}]},{"characterId":"char_c66404","characterName":"新倉 茜","sourceIds":{"bangumi":[{"characterId":"148519","match":"exact-normalized-name-in-linked-work","subjectId":"79361"}],"egsCharacterIds":["25440"],"vndbCharacterId":"c66404"},"originalCharacterName":"新倉 茜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公一家の隣の部屋に越してきた新婚さんの若奥様。25歳。"},{"spoiler":false,"text":"大阪出身で、関西弁を話す。性格は天真爛漫で自由奔放。"},{"spoiler":false,"text":"夫が出張で家を空けることが多く、新婚生活はあまり上手くいっていないようだ。"},{"spoiler":false,"text":"ご近所の皐月や静華とは良い関係を築いているようで、良い話し相手になっている。"},{"spoiler":false,"text":"お酒が好きで、何かがあると飲んで憂さを晴らしている。"}],"source":"egs","sourceCharacterId":"25440","sourceWorkId":"7841","spoiler":false},{"segments":[{"spoiler":false,"text":"最近、主人公一家の隣（静華とは反対側） に越してきた、新婚ほやほやの若奥さん。"},{"spoiler":false,"text":"大阪出身で、関西弁で話し、優慈を弟のように扱っている。"},{"spoiler":false,"text":"皐月と静華とは近所と言うこともあり、良い話し相手になっている。"},{"spoiler":false,"text":"夫が出張で家を空けていることが多く、新婚生活はあまり上手くいっていない。"},{"spoiler":false,"text":"お酒好きでなにかあると飲んで憂さ晴らしをしている。"}],"source":"bangumi","sourceCharacterId":"148519"}],"profileFacts":[{"label":"年龄（本版本）","value":"25 岁","valueContext":null,"source":"egs","sourceCharacterId":"25440","sourceWorkId":"7841","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71765360b18014ff4e14a9a809e7f3ce2741beadbd5c1566728e998af76433b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/1691ed122c1cfaa4364c12d223b171d125c2d6bbb778b0708e42181f6dbd3acc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茂呂田かおる","creatorId":"vndb:s662","sourcePersonId":"vndb:s662","canonicalEntityId":"vndb:s662","name":"茂呂田 かおる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7