urce":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『淫魔』"},{"spoiler":false,"text":"Hな事に関して知識、経験に乏しく、未だに人間を魅了できた事がない 落ちこぼれの淫魔。"},{"spoiler":false,"text":"性格は良い意味で明るく、悪い意味では短絡的なタイプ。"},{"spoiler":false,"text":"偶然発見した勇者を単独で襲ってしまうが……"},{"spoiler":false,"text":"エロい意味でオウラを師匠と崇め、一人前の淫魔を目指す。"}],"source":"egs","sourceCharacterId":"7395","sourceWorkId":"22535","spoiler":false},{"segments":[{"spoiler":false,"text":"エッチな知識·経験に乏しく、未だ人間を魅了できたことが無い 落ちこぼれの淫魔。"},{"spoiler":false,"text":"性格は良い意味で明るく、悪い意味では短絡的なタイプ。"},{"spoiler":false,"text":"偶然発見した勇者·オウラを単独で襲ってしまうが……"},{"spoiler":false,"text":"それ以後はエロい意味でオウラを師匠と崇め、一人前の淫魔を目指す。"},{"spoiler":false,"text":"「おお、ししょーが燃えてます！　やる気のオーラが、ごうごうと燃えてますよ！」"}],"source":"bangumi","sourceCharacterId":"37736"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"37736","value":"淫魔"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c60111d84149619688a4cff0ce63a42fdb7356edb9796f27328845154d395fa0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6ff067f7c2c664a1956b1d562c371495d95eb543941d9ae9956c70b367297bf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朝比奈幸","creatorId":"vndb:s21648","sourcePersonId":"vndb:s21648","canonicalEntityId":"vndb:s21648","name":"朝比奈 幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:146978:37736:17080:1","source":"bangumi"},{"creditedName":"綾音 まこ","creatorId":"vndb:s2581","sourcePersonId":"vndb:s2581","canonicalEntityId":"vndb:s2581","name":"綾音 まこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66284","source":"vndb"}]},{"characterId":"char_c38291","characterName":"フレア","sourceIds":{"bangumi":[{"characterId":"37737","match":"exact-normalized-name-in-linked-work","subjectId":"146978"}],"egsCharacterIds":["7396"],"vndbCharacterId":"c38291"},"originalCharacterName":"フレア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『治癒術士』"},{"spoiler":false,"text":"オウラの幼馴染で元パーティーメンバー。"},{"spoiler":false,"text":"オウラの事がずっと好きだけど、上手く伝えられない奥手なタイプ。"},{"spoiler":false,"text":"危険な勇者任務の際に置いていかれショックを受けていたが、古城を拠点にすると聞き、押しかけ復帰。再会に心を弾ませるも、オウラの隣には馴れ馴れしく懐く女の姿が……"},{"spoiler":false,"text":"ライバルの出現に火がついた彼女を止められる人間はもういない。"}],"source":"egs","sourceCharacterId":"7396","sourceWorkId":"22535","spoiler":false},{"segments":[{"spoiler":false,"text":"オウラの幼なじみで、元パーティーメンバー。"},{"spoiler":false,"text":"オウラのことがずっと好きだけど、上手く伝えられない奥手なタイプ。"},{"spoiler":false,"text":"危険な勇者任務の際に置いて行かれショックを受けていたが、拠点を置くと聞き押しかけ復帰を果たす。"},{"spoiler":false,"text":"オウラとの再会に心を弾ませるも、彼の隣には馴れ馴れしく懐く女の姿が……。"},{"spoiler":false,"text":"ライバルの出現に火がついた彼女を止められる人間はもういない。"},{"spoiler":false,"text":"「この人はこれで大丈夫。 オウラ、他にケガした人、いない？」"}],"source":"bangumi","sourceCharacterId":"37737"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"37737","value":"回復術士"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48c62f5229fa469af789aeea19e3f08fedcadff4887b6be323f1019427ec153e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad6df2ff2bf5594d552b4e187ac2b712d144aeec4306c1841b23f1f1fa35b117.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"霧島はるな","creatorId":"vndb:s2698","sourcePersonId":"vndb:s2698","canonicalEntityId":"vndb:s2698","name":"霧島はるな(水無月じゅん)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:146978:37737:13771:1","source":"bangumi"}]},{"characterId":"char_c38292","characterName":"ミラ","sourceIds":{"bangumi":[{"characterId":"37738","match":"exact-normalized-name-in-linked-work","subjectId":"146978"}],"egsCharacterIds":["7397"],"vndbCharacterId":"c38292"},"originalCharacterName":"ミラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『王国騎士』"},{"spoiler":false,"text":"王国から勇者のサポート（と監視）に派遣された女騎士。"},{"spoiler":false,"text":"真面目が鎧を着て歩いているような常識人タイプで協力的な人物。"},{"spoiler":false,"text":"一方、ざっくばらんとしたオウラの性格に戸惑い、さらに個性的なメンバーに振り回されていく苦労人。"},{"spoiler":false,"text":"常識の最終防衛線が突破される日は近い。"}],"source":"egs","sourceCharacterId":"7397","sourceWorkId":"22535","spoiler":false},{"segments":[{"spoiler":false,"text":"王国から勇者のサポート（と監視）に派遣された女騎士。"},{"spoiler":false,"text":"まじめが鎧を着て歩いているような常識人タイプで、協力的な人物。"},{"spoiler":false,"text":"ざっくばらんとした性格のオウラや、他の個性的なメンバーに振り回されていく苦労人。"},{"spoiler":false,"text":"彼女の “常識” の最終防衛線が突破される日は近い。"},{"spoiler":false,"text":"「うむ。 身勝手この上ない理屈ですが、貴重な遺跡を発見した勇者殿の功績は、認められてよいでしょう」"}],"source":"bangumi","sourceCharacterId":"37738"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"37738","value":"王国骑士"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88e90710a1137c54c0edeef70e640921871441ad9a559d97c9fbb2ce053cc295.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/833594a7910d7f00a35b8cebb5471b8296709d18d7875cfb9cdc02db8496a09b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:146978:37738:10026:1","source":"bangumi"}]},{"characterId":"char_c38293","characterName":"エクリ","sourceIds":{"bangumi":[{"characterId":"37739","match":"exact-normalized-name-in-linked-work","subjectId":"146978"}],"egsCharacterIds":["7398"],"vndbCharacterId":"c38293"},"originalCharacterName":"エクリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『魔法使い』"},{"spoiler":false,"text":"魔王軍に所属する魔法使い。"},{"spoiler":false,"text":"実戦派というよりは黙々と研究をするマッドサイエンティストタイプ。"},{"spoiler":false,"text":"能力としては優秀な為、魔王軍前線拠点の一つでリーダーをしている。"},{"spoiler":false,"text":"そんな時、勇者が貴重な古代の兵器を稼働させたと聞きつけ我が物にせんと襲い掛かってくる。"},{"spoiler":false,"text":"彼女にとって、興味があるものは正義も悪も関係がないのだ。"}],"source":"egs","sourceCharacterId":"7398","sourceWorkId":"22535","spoiler":false},{"segments":[{"spoiler":false,"text":"魔王軍に所属する魔法使い。"},{"spoiler":false,"text":"実戦派ではなく、黙々と研究をするマッドサイエンティストタイプ。"},{"spoiler":false,"text":"能力としては優秀なため、魔王軍前線拠点の一つでリーダーをしている。"},{"spoiler":false,"text":"勇者が貴重な古代の兵器を稼働させたと聞きつけ、我が物にせんと襲い掛かってくる。"},{"spoiler":false,"text":"彼女にとって、興味があるものには正義も悪も関係がないのだ。"},{"spoiler":false,"text":"「今後も要調整。 凹と凸がせめぎあう。 ほとばしる命のエナジー」"}],"source":"bangumi","sourceCharacterId":"37739"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"37739","value":"魔法使い"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8dbbd5470028fd2009214be1f6b2acd6a1cffa3f603ceedbcf2427c6955b7281.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16548b6b25be786c6e91b0abeb6bad5c2597c34a1f9b57a3c45952bb82bd0594.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間宮菜南子","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:146978:37739:15995:1","source":"bangumi"}]},{"characterId":"char_c41391","chara