f60474d48fcbd2113e6f2d6007e8fcd59a82fd5e1d5ffd294585b6b01c090f.webp","width":173,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浜田 賢二","creatorId":"vndb:s385","sourcePersonId":"vndb:s385","canonicalEntityId":"vndb:s385","name":"浜田 賢二","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2217","source":"vndb"}]},{"characterId":"char_c319","characterName":"朽木 双葉","sourceIds":{"bangumi":[{"characterId":"22002","match":"exact-normalized-name-in-linked-work","subjectId":"99057"}],"egsCharacterIds":["13539"],"vndbCharacterId":"c319"},"originalCharacterName":"朽木 双葉","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"828"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The tomboyish man-hater. Futaba is brought to Kanenone against her will, and does everything she can to cause trouble. This includes talking back to teachers and giving all males the cold shoulder. Because of her strong personality, other girls tend to see Futaba as their leader. She has no tolerance for perversion, which makes her the natural enemy of Bacchiguu, Tenjin and Ichibanboshi."}],"source":"vndb","sourceCharacterId":"c319"},{"segments":[{"spoiler":false,"text":"舞台となる学園に編入してきた女性学生の一人。"},{"spoiler":false,"text":"クラスの女子のリーダー的存在で、何かと男子と対立し、特に天神と仲が悪い。"},{"spoiler":false,"text":"性格は短気な上に負けん気が強く、縛られることや枠にはまった考えを嫌う。"},{"spoiler":false,"text":"平安時代に「植物を操る」と云われた陰陽師の家系に生まれ、そんな格式ばった家系を“古臭い”とバカにしている。"},{"spoiler":false,"text":"この学校にやってきたのは、陰陽師である父親に反発してのことらしい。"},{"spoiler":false,"text":"小さな胸に、いささかコンプレックスを抱いている。"}],"source":"egs","sourceCharacterId":"13539","sourceWorkId":"1988","spoiler":false},{"segments":[{"spoiler":false,"text":"鐘ノ音学園の三年生。"},{"spoiler":false,"text":"女子のリーダー的存在。"},{"spoiler":false,"text":"男嫌いな面があり、特にバッチグーとは仲が悪い。"},{"spoiler":false,"text":"しかし、祐介と付き合いだして多少丸くなり、暴力行為に及ぶ回数は一応減ってはいる。"},{"spoiler":false,"text":"こっそり「家庭的な女になる努力」をしているが"},{"spoiler":false,"text":"まったく実を結んでいない。胸が小さいのが悩み。"},{"spoiler":false,"text":"ずっとケンカ別れとなっていた祐介と、"},{"spoiler":false,"text":"やっと仲直り出来たのも束の間、今度は女子寮爆破事件が……!?"}],"source":"egs","sourceCharacterId":"13539","sourceWorkId":"4555","spoiler":false},{"segments":[{"spoiler":false,"text":"勝気で気が短い。 しばられたり、枠にハマった考えが嫌い。"},{"spoiler":false,"text":"クラスの女子のリーダー的存在で、男子、特に天神とは仲が悪い。"},{"spoiler":false,"text":"生家は平安時代より “植物を操る” といわれる陰陽師の家系。"},{"spoiler":false,"text":"そんな家系を古臭いとバカにしていて、父への反発からこの学園へやって来た。"},{"spoiler":false,"text":"胸が小さいのが密かな悩み。"}],"source":"bangumi","sourceCharacterId":"22002"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0ddd66da0baf2f377cfa9f93d97c5d44df724fcf20e7edc8e763e25adc789a0f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6ec70babca03acd6f16abb00a8d0712d445c980c76dfe79930b51fd70be5d58.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤巻 恵理子","creatorId":"vndb:s10405","sourcePersonId":"vndb:s10405","canonicalEntityId":"vndb:s10405","name":"藤巻 恵理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2225","source":"vndb"}]},{"characterId":"char_c321","characterName":"バッチグー","sourceIds":{"bangumi":[],"egsCharacterIds":["13544"],"vndbCharacterId":"c321"},"originalCharacterName":"バッチグー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Leader of the quartet that includes Ichibanboshi, Tenjin and Yuusuke. Though he is a pervert, his intentions are not bad, so long as sex isn’t involved. Tends to rush into things without thinking, and is quick to let Yuusuke take the blame for his antics. Originally infatuated with Chigusa, but later starts dating Arisa Haruno."}],"source":"vndb","sourceCharacterId":"c321"},{"segments":[{"spoiler":false,"text":"鐘ノ音学園3年生。3バカの一人。自称総長補佐で、天神をうまく使い傀儡政権を行っている。"}],"source":"egs","sourceCharacterId":"13544","sourceWorkId":"4555","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f5ff789ca3bc8752494b83eb6dfef681ae15834d60f3d8ecbbb8909d4d9d73f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e7c99300b60fd214889ddb77a916fd1eb0cc849db15705a3778af8b5bdc7b43.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中 一成","creatorId":"vndb:s1731","sourcePersonId":"vndb:s1731","canonicalEntityId":"vndb:s1731","name":"田中 一成","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2220","source":"vndb"}]},{"characterId":"char_c323","characterName":"一番星 光","sourceIds":{"bangumi":[],"egsCharacterIds":["13546"],"vndbCharacterId":"c323"},"originalCharacterName":"一番星 光","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The yes man of the group. Ichibanboshi mostly follows whatever the group does, though has his own ideas on how to win the girls over. Is a bit more down to earth than Bacchiguu, but not by much. His weak character lures him to Futaba Kutsuki. On the side, he’s a rock & roll guitarist with a band of his own."}],"source":"vndb","sourceCharacterId":"c323"},{"segments":[{"spoiler":false,"text":"鐘ノ音学園3年生。3バカの一人。鐘ノ音学園では一応イケメンらしい。クールな男を気取っているが、すぐにボロが出る。"},{"spoiler":false,"text":"3年になってからは、3バカの中では一歩引いた立場におり、馬鹿げた行動を起こすのは天神とバッチグーのペアになっていることが多い。"},{"spoiler":false,"text":"ギターの腕はものすごく、音楽をやるために鐘ノ音学園の卒業を待たずして自主退学する。"}],"source":"egs","sourceCharacterId":"13546","sourceWorkId":"4555","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b09f80abbca667f20131824c2d6e3651a82887538ed27fe2d3c04a52766cb3f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c0a7c508efc93bbdfb5ac029f883e9c8ef34be81025158d6baf06ac9a3dd784.webp","width":167,"height":256,"source":"static-detail"},"actors":[{"creditedName":"土門 仁","creatorId":"vndb:s1537","sourcePersonId":"vndb:s1537","canonicalEntityId":"vndb:s1537","name":"土門 仁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2224","source":"vndb"}]},{"characterId":"char_c4468","characterName":"川瀬 真菜","sourceIds":{"bangumi":[{"characterId":"54743","match":"exact-normalized-name-in-linked-work","subjectId":"99053"}],"egsCharacterIds":["13547"],"vndbCharacterId":"c4468"},"originalCharacterName":"川瀬 真菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"鐘ノ音学園の新一年生で、主人公のクラスメイト。"},{"spoiler":false,"text":"能天気なほどに明るく前向きな性格。"},{"spoiler":false,"text":"何事にも一生懸命だが、基本的にドジッ娘で、物をよく壊す。"},{"spoiler":false,"text":"趣味はカメラでずっと続けているらしいが、まったく上手くなく、ピントすら合わせられない。"}],"source":"egs","sourceCharacterId":"13547","sourceWorkId":"4132","spoiler":false},{"segments":[{"spoiler":false,"text":"いろんなことに一生懸命な女の子。主人公と同じクラスの新一年生。"},{"spoiler":false,"text":"基本的にドジでよく物を壊すがそれでもめげない。"},{"spoiler":false,"text":"ある意味能天気ともいえる位の前向きで明るいキャラクタは"},{"spoiler":false,"text":"周囲に人を集める魅力がある。"},{"spoiler":false,"text":"趣味のカメラだけはずっと続けているのだが、"},{"spoiler":false,"text":"まさしく下手の横好きで一向に上手くなる気配がないのが悩み。"},{"spoiler":false,"text":"そもそもピントが合わせられない。"}],"source":"bangumi","sourceCharacterId":"54743"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25d97b3477640ef86529d57e6582b6888c7c6433127896727e6cd8c21a149003.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/765529c18d60b939467476eebac219fc8421e5bf1f12b019457871ba8288deb7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"塩山由佳","creatorId":"vndb:s11671","sourcePersonId":"vndb:s11671","canonicalEntityId":"vndb:s11671","name":"塩山 由佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99053:54743:5235:1","source":"bangumi"}]},{"characterId":"char_c4469","characterName":"丘野 ひまわり","sourceIds":{"bangumi":[{"characterId":"54745","match":"exact-normalized-name-in-linked-work","subjectId":"99053"}],"egsCharacterIds":["13549"],"vndbCharacterId":"c4469"},"originalCharacterName":"丘野 ひまわり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"142"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"35"}},"descriptions":[{"segments":[{"spoiler":false,"text":"鐘ノ音学園の新一年生。"},{"spoiler":false,"text":"性格は天真爛漫で子供っぽく、わりと天然。"},{"spoiler":false,"text":"自然いっぱいの鐘ノ音学園は彼女にとっては、かなりお気に入りの様子。"},{"spoiler":false,"text":"そうしたことから、野山を駆け回り、蝶を追いかけたり、野花を眺めたりと自然をめいっぱい楽しんでいる。"},{"spoiler":false,"text":"とある事件をきっかけに主人公を「お兄ちゃん」と呼んで、懐いてくるようになる。"}],"source":"egs","sourceCharacterId":"13549","sourceWorkId":"4132","spoiler":false},{"segments":[{"spoiler":false,"text":"天真爛漫でちょっと子供っぽい女の子。性格もわりと子供っぽい。"},{"spoiler":false,"text":"自然がいっぱいの鐘ノ音学園はかなりお気に入りの様子で蝶を追いかけたり花を眺めたりしている。"},{"spoiler":false,"text":"母親の勧めで鐘ノ音学園にやってきた。"},{"spoiler":false,"text":"とある事件をきっかけに主人公を「お兄ちゃん」と呼びなついてくるようになる。"}],"source":"bangumi","sourceCharacterId":"54745"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b02ddadfffcf813a5c997e4402e7feb2baa245821e36e0f9cf110aaaf70953f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60368c2c3a926c74bf6552f324e4525015093352da6281df82336965ec2ae2ee.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新千恵子","creatorId":"vndb:s11664","sourcePersonId":"vndb:s11664","canonicalEntityId":"vndb:s11664","name":"新 千恵子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99053:54745:5266:1","source":"bangumi"}]},{"characterId":"char_c4470","characterName":"柊 麻理亜","sourceIds":{"bangumi":[],"egsCharacterIds":["13548"],"vndbCharacterId":"c4470"},"originalCharacterName":"柊 麻理亜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"鐘ノ音学園の新一年生。"},{"spoiler":false,"text":"名家のお嬢様と噂される女の子。"},{"spoiler":false,"text":"立ち居振る舞いが上品で凛々しく、高飛車、上級生にも物怖じせず、自分の意見をしっかりと通す、まっすぐな性格。"},{"spoiler":false,"text":"一部の学生の間では彼女の熱狂的な信者が存在する。"},{"spoiler":false,"text":"鐘ノ音学園の前時代的な野蛮さに辟易し、その校風を改善したいと思っているようだ。"}],"source":"egs","sourceCharacterId":"13548","sourceWorkId":"4132","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed6a8b75c5712945a3b78b4cedc70fb72e7e20bb10d6da6d8b78d10a5299aef7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/247d9f55913ba4f8fcf5304b2f960ed005b707b8d1f6ebfc6c3942c0ab05bd12.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"観村 咲子","creatorId":"vndb:s858","sourcePersonId":"vndb:s858","canonicalEntityId":"vndb:s858","name":"神田 理江","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2219","source":"vndb"}]},{"characterId":"char_c4471","characterName":"松浦・ルーシー・美夏","sourceIds":{"bangumi":[{"characterId":"54746","match":"exact-normalized-name-in-linked-work","subjectId":"99053"}],"egsCharacterIds":["13550"],"vndbCharacterId":"c4471"},"originalCharacterName":"松浦・ルーシー・美夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"鐘ノ音学園の新一年生。"},{"spoiler":false,"text":"鐘ノ音学園の卒業生である父親の強い勧めでやってきたハーフの帰国子女。"},{"spoiler":false,"text":"日本人離れした豊満なボディを持ち、外国での生活が長かったことから、挨拶や感謝のときには気軽にキスをしてしまい、何かと騒動が巻き起こる。"},{"spoiler":false,"text":"そうしたスキンシップが毎度なことから、周囲からは尻軽と思われているが、実際は年相応に恥じらいを持っており、セクハラにも敏感。"}],"source":"egs","sourceCharacterId":"13550","sourceWorkId":"4132","spoiler":false},{"segments":[{"spoiler":false,"text":"ハーフの帰国子女。鐘ノ音学園の卒業生である父親の強い勧めでやってきた。"},{"spoiler":false,"text":"海外産の豊満なボディに鐘ノ音の男子の目は釘付け。"},{"spoiler":false,"text":"外国での生活が長かったので挨拶や感謝のキスが気軽に出てしまい、その結果よく騒動が巻き起こる。"},{"spoiler":false,"text":"ただ年相応の恥じらいは持っているし、セクハラにも敏感。逆に鐘ノ音の特殊な生活はギャップがありすぎてなかなかついていけてない。というか自分を「異邦人」だと考えているためそもそも慣れるつもりがない。"},{"spoiler":false,"text":"なので「松浦さん」とか「美夏ちゃん」と呼ばれるのを嫌がる。"}],"source":"bangumi","sourceCharacterId":"54746"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/4418b051f84bc50d559032821f0108d7f086af7f492caaa60e29f97de4256807.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86428e7e26ecf87e5da2c152b8b0e3314601924299bbea596829cfcc888793ce.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青山 美帆","creatorId":"vndb:s16698","sourcePersonId":"vndb:s16698","canonicalEntityId":"vndb:s16698","name":"青山 美帆","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2228","source":"vndb"}]},{"characterId":"char_vndb_c130921","characterName":"緑河 豊","sourceIds":{"vndbCharacterId":"c130921"},"originalCharacterName":"緑河 豊","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main protagonist of this game ! He woke up in a forest with amnesia and went to the opening ceremony naked =))"}],"source":"vndb","sourceCharacterId":"c130921"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60e68c97547265b1e4fea89107e524e97e57215b46cc236e014fe9118c92f0b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/207e7e53ffdd4a24a4b2efa0cb97bdb2efc99de99e13e6f4c90226f89e13d3f4.webp","width":217,"height":243,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c311","characterName":"高崎 祐介","sourceIds":{"vndbCharacterId":"c311"},"originalCharacterName":"高崎 祐介","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","m