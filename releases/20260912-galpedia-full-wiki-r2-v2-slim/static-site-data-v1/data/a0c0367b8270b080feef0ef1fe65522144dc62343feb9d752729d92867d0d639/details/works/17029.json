e":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公“檜山雄太”の担当ナースで義理の妹（妻の妹）。処女。"},{"spoiler":false,"text":"髪の毛を金髪に染め、勤務態度はいい加減。"},{"spoiler":false,"text":"しばしば婦長である生真面目な姉“檜山真希”に叱られている。"},{"spoiler":false,"text":"性格は明るく、誰にでも分け隔てなく親しく接する人気者。"},{"spoiler":false,"text":"また、ここぞという時（急患への対応など）では、普段とうって変って的確に対応する「能ある鷹が爪を隠した」典型。"},{"spoiler":false,"text":"“真希”の婚約時に“雄太”を紹介され、一目で気に入る。"},{"spoiler":false,"text":"以後、隙あらばと“雄太”にモーションをかけている。"},{"spoiler":false,"text":"忙しい“真希”に代わり入院した“雄太”の担当を志願。"},{"spoiler":false,"text":"この機会に自分のものにしてしまおうと無邪気に考えている（悪意はない）。"},{"spoiler":false,"text":"一人称は“由梨”。"},{"spoiler":false,"text":"言葉づかいは「～だよ？」「～だと思うの」「～だと思うな？」"}],"source":"egs","sourceCharacterId":"8558","sourceWorkId":"17029","spoiler":false},{"segments":[{"spoiler":false,"text":"髪の毛を金髪に染め、勤務態度はいい加減。"},{"spoiler":false,"text":"しばしば婦長である姉・檜山真希に叱られている。"},{"spoiler":false,"text":"明るく、誰にでも分け隔てなく親しく接する人気者。"},{"spoiler":false,"text":"また、ここぞという時には、普段と打って変わって的確に対応する “能ある鷹が爪を隠した” 典型。"}],"source":"bangumi","sourceCharacterId":"200556"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"8558","sourceWorkId":"17029","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"8558","sourceWorkId":"17029","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"8558","sourceWorkId":"17029","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"8558","sourceWorkId":"17029","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"8558","sourceWorkId":"17029","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e482047fabd26c6c7eb27845bd5e617fd6088d58cb73ceb9183d7ed9a8944e18.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1a3ab352da92a341f8a051c9f412ac46d6414f0729fa2faf9140ffa1cb175fb.webp","width":102,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南沙耶","creatorId":"vndb:s2585","sourcePersonId":"vndb:s2585","canonicalEntityId":"vndb:s2585","name":"南 沙耶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218336:200556:58328:1","source":"bangumi"}]},{"characterId":"char_c41262","characterName":"檜山 真希","sourceIds":{"bangumi":[{"characterId":"200557","match":"exact-normalized-name-in-linked-work","subjectId":"218336"}],"egsCharacterIds":["8559"],"vndbCharacterId":"c41262"},"originalCharacterName":"檜山 真希","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公“檜山雄太”の妻。"},{"spoiler":false,"text":"非常に生真面目な性格で、勤務態度も優秀。"},{"spoiler":false,"text":"入院先の病院では若くして婦長を務める。"},{"spoiler":false,"text":"生真面目すぎるがゆえに小言も多く“雄太”に対してもしばしばきつく当たる。"},{"spoiler":false,"text":"しかし、それもこれも相手を思っての不器用な対応であり、そのことを理解して受け入れてくれる夫“雄太”を愛している。"},{"spoiler":false,"text":"姉妹仲は決して不和ではないが、良好とも言い難く小言を並べ立てる"},{"spoiler":false,"text":"それを気だるそうに聞き流す妹“由梨”の間でよく口喧嘩になっている。"},{"spoiler":false,"text":"一方で真反対の性格の妹“由梨”（だらけているようで、それでいて人当たりがよく自然に他人を惹きつける部分）を、どこか羨んでいる節がある。"},{"spoiler":false,"text":"目立たないが妹“由梨”に負けず劣らずのスタイル。"},{"spoiler":false,"text":"仕事に一区切りつくまでは、と“雄太”と話合い子供ができないように避妊している。"}],"source":"egs","sourceCharacterId":"8559","sourceWo