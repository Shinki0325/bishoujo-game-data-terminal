urcePersonId":"vndb:s11946","canonicalEntityId":"vndb:s11946","name":"あおきゅん","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:153374","source":"vndb"}]},"cast":[{"characterId":"char_c77587","characterName":"イヴ","sourceIds":{"bangumi":[{"characterId":"68137","match":"exact-normalized-name-in-linked-work","subjectId":"267514"}],"egsCharacterIds":["20682"],"vndbCharacterId":"c77587"},"originalCharacterName":"イヴ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Eve is a young woman who was found unconscious by Yuuma outside his home on a snowy January day. After being taken in and cared for by Yuuma, Eve told him that she would now be at his service as his maid to thank him for his kindness and to finally stop him from living a life full of loneliness and bitterness."},{"spoiler":false,"text":"Eve is a very serious young woman and takes her job very much to heart by doing all the domestic chores, shopping and cooking. Having a rather maternal character, she even manages to be already on the doorstep when Yuuma comes home late at night from work to give her a warm welcome, which makes Yuuma melt with happiness."}],"source":"vndb","sourceCharacterId":"c77587"},{"segments":[{"spoiler":false,"text":"主人公・北見佑馬の下にやってきたメイドさん。"},{"spoiler":false,"text":"日々の暮らしに疲れていた佑馬に『癒し』を与えたいと、佑馬の家で住み込みで仕事をし始める。"},{"spoiler":false,"text":"自分を住まわせてくれた佑馬に恩義を感じていて、精一杯尽そうとしている。"},{"spoiler":false,"text":"見た目に反して知識不足なことが多く、特に自分の感情のことはよくわかっていない。"},{"spoiler":false,"text":"容姿も性格もまさに『理想のメイドさん』だが、実は本人も知らない大きな秘密を抱えている。"}],"source":"egs","sourceCharacterId":"20682","sourceWorkId":"27427","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・北見佑馬の下にやってきたメイドさん。"},{"spoiler":false,"text":"日々の暮らしに疲れていた佑馬に『癒し』を与えたいと、"},{"spoiler":false,"text":"佑馬の家で住み込みで仕事をし始める。"},{"spoiler":false,"text":"自分を住まわせてくれた佑馬に恩義を感じていて、"},{"spoiler":false,"text":"精一杯尽そうとしている。"},{"spoiler":false,"text":"見た目に反して知識不足なことが多く、"},{"spoiler":false,"text":"特に自分の感情のことはよくわかっていない。"},{"spoiler":false,"text":"容姿も性格もまさに『理想のメイドさん』だが、"},{"spoiler":false,"text":"実は本人も知らない大きな秘密を抱えている。"},{"spoiler":false,"text":"「これからも、ご主人様を癒やして差し上げたいと思います。ぜひ、ご遠慮なく、どんなことでもお申し付けくださいませ」"}],"source":"bangumi","sourceCharacterId":"68137"}],"profileFacts":[{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"20682","sourceWorkId":"27427","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"20682","sourceWorkId":"27427","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"20682","sourceWorkId":"27427","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"20682","sourceWorkId":"27427","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f60f863b2c23ef2a084b13384fc4a39531c57ada2ea0198bcbc8eebe58ded989.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9bad3dc36551d9c5f8333dddbbf1546f71cfed9d8fe7fe8c807fd25bdc926a5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:267514:68137:4