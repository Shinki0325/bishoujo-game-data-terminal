vndb:s14338","canonicalEntityId":"vndb:s14338","name":"藤沢 れい香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:412935:81335:32998:1","source":"bangumi"}]},{"characterId":"char_c91920","characterName":"アントワーヌ・ド・サガン","sourceIds":{"bangumi":[{"characterId":"81336","match":"exact-normalized-name-in-linked-work","subjectId":"306850"}],"egsCharacterIds":["22576"],"vndbCharacterId":"c91920"},"originalCharacterName":"アントワーヌ・ド・サガン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A ’39 survivor and ex-STX-SF commander and pilot. Sports honey-wheat hair and sapphire eyes. Prefers the more manly “Sagan” over “Antoine”… Originally from France."},{"spoiler":false,"text":"“I think I could have fun living in a place like this, even on my own.”"},{"spoiler":false,"text":"From Shiravune"}],"source":"vndb","sourceCharacterId":"c91920"},{"segments":[{"spoiler":false,"text":"３９作戦の生還者。元操縦士で階級は中佐。"},{"spoiler":false,"text":"小麦畑色の髪に蒼い目が特徴。訳あって男のような名を名乗っている。"},{"spoiler":false,"text":"実年齢１８歳のフランス人。"}],"source":"egs","sourceCharacterId":"22576","sourceWorkId":"29088","spoiler":false},{"segments":[{"spoiler":false,"text":"３９作戦の生還者。元操縦士で階級は中佐。"},{"spoiler":false,"text":"小麦畑色の髪に蒼い目が特徴。訳あって男のような名を名乗っている。"},{"spoiler":false,"text":"実年齢１８歳のフランス人。"}],"source":"bangumi","sourceCharacterId":"81336"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/371d0607d483c242aef0b3627eaff0f2d68923d3846df1cf5357dbaca23289df.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/6464b857c4d84c4a581786f0863eccc5acdfc17206c2608650178bebd08980ea.webp","width":167,"height":256,"source":"static-detail"},"actors":[{"creditedName":"空賀花","creatorId":"vndb:s15476","sourcePersonId":"vndb:s15476","canonicalEntityId":"vndb:s15476","name":"空賀 花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:412935:81336:34089:1","source":"bangumi"}]},{"characterId":"char_c91921","characterName":"ジャン・バルジャン","sourceIds":{"bangumi":[{"characterId":"81337","match":"exact-normalized-name-in-linked-work","subjectId":"306850"}],"egsCharacterIds":["22577"],"vndbCharacterId":"c91921"},"originalCharacterName":"ジャン・バルジャン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Neo-fennec no. 24601. Nickname: Jean Valjean. Yosuke’s personal SHEEP mechanic and closest pal. A jokester and the life of the party, but always first to lend an ear. Has a criminal record. Like many neos, he’s also a devout animist."},{"spoiler":false,"text":"“I know that face. You can’t help but fall in love, can you?”"},{"spoiler":false,"text":"From Shiravune"}],"source":"vndb","sourceCharacterId":"c91921"},{"segments":[{"spoiler":false,"text":"ＮＦ２４６０１。ニックネームはジャン・バルジャン。"},{"spoiler":false,"text":"羊介専属の機体整備士であり、同時に彼の親友でもある。"},{"spoiler":false,"text":"陽気な性格で仲間を和ませるムードメーカー。"},{"spoiler":false,"text":"前科一犯の自然崇拝者。"}],"source":"egs","sourceCharacterId":"22577","sourceWorkId":"29088","spoiler":false},{"segments":[{"spoiler":false,"text":"ＮＦ２４６０１。ニックネームはジャン・バルジャン。"},{"spoiler":false,"text":"羊介専属の機体整備士であり、同時に彼の親友でもある。"},{"spoiler":false,"text":"陽気な性格で仲間を和ませるムードメーカー。"},{"spoiler":false,"text":"前科一犯の自然崇拝者アニミズム。"}],"source":"bangumi","sourceCharacterId":"81337"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c98e6157e72bd7b759667a346a481ab9b0a90454a058b3788047e4cf8e2bfa77.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07302c44d76fb7c72233b7dd2b8c1b0869426f2abfe4c4766940f1f906f01a59.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"六本木天人","creatorId":"vndb:s21652","sourcePersonId":"vndb:s21652","canonicalEntityId":"vndb:s21652","name":"六本木天人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:412935:81337:62752:1","source":"bangumi"}]},{"characterId":"char_c91922","characterName":"ウォー","sourceIds":{"bangumi":[{"characterId":"81338","match":"exact-normalized-name-in-linked-work","subjectId":"306850"}],"egsCharacterIds":["22578"],"vndbCharacterId":"c91922"},"originalCharacterName":"ウォー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Not only is he an STX Space Force general and Blue Star military hero, but he also holds the record for most Consuelos defeated. Has currently pulled back from the front lines to organize his Elites… Date and place of birth unknown. Eliza’s closest confidant."},{"spoiler":false,"text":"“Yes, so I can remain human to the very end. That’s all there is to it.”"},{"spoiler":false,"text":"From Shiravune"}],"source":"vndb","sourceCharacterId":"c91922"},{"segments":[{"spoiler":false,"text":"階級は将軍。スターラベルはブルースター。"},{"spoiler":false,"text":"コンスエロ撃破数最多の記録を持っている軍の英雄。"},{"spoiler":false,"text":"現在は前線から引いて精鋭たちをまとめている。"},{"spoiler":false,"text":"出生などの情報は一切不明。イライザと懇意の仲。"}],"source":"egs","sourceCharacterId":"22578","sourceWorkId":"29088","spoiler":false},{"segments":[{"spoiler":false,"text":"階級は将軍。スターラベルはブルースター。"},{"spoiler":false,"text":"コンスエロ撃破数最多の記録を持っている軍の英雄。"},{"spoiler":false,"text":"現在は前線から引いて精鋭たちをまとめている。"},{"spoiler":false,"text":"出生などの情報は一切不明。イライザと懇意の仲。"}],"source":"bangumi","sourceCharacterId":"81338"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa4677d53f8c1e5028bcb30e3380d450cdf8206bd5a4a7b81b07c114e4ab784e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03e0d3eb416900d780ff0873aadfe3f4e571486448118714a11f383b48252677.webp","width":204,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大羽武士","creatorId":"vndb:s927","sourcePersonId":"vndb:s927","canonicalEntityId":"vndb:s927","name":"大羽 武士","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:412935:81338:16165:1","source":"bangumi"}]},{"characterId":"char_c91923","characterName":"イライザ","sourceIds":{"bangumi":[{"characterId":"81339","match":"exact-normalized-name-in-linked-work","subjectId":"306850"}],"egsCharacterIds":["22579"],"vndbCharacterId":"c91923"},"originalCharacterName":"イライザ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An “artificial goddess” android created by the scientist Jean Regulus. Her mind was uploaded from autonomous will first discovered in SHEEP."},{"spoiler":false,"text":"Since she excels at loving conversations, she oversees the online mental care of Battleship Baobab’s residents as their foremost psychiatrist."},{"spoiler":false,"text":"Her ageless, eternal beauty is an inspiration to many a Baobabian woman. She and Wolf are close companions. Literally doesn’t have a heart."},{"spoiler":false,"text":"“You’re right… All I can do is learn from humans’ conversations and repeat the most apt words.”"},{"spoiler":false,"text":"From Shiravune"}],"source":"vndb","sourceCharacterId":"c91923"},{"segments":[{"spoiler":false,"text":"科学者レグルスが