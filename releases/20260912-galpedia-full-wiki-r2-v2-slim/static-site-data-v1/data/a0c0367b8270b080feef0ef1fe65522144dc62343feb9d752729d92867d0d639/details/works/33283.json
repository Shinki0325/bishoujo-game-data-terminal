{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"33283","model":{"presentationWorkId":"egs:33283","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_112798","characterName":"レイモンド・ローレンス","sourceIds":{"bangumi":[{"characterId":"112798","match":"source-roster","subjectId":"354664"}]},"originalCharacterName":"レイモンド・ローレンス","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"銀河連邦に属さない惑星ベグアルド出身の青年。一族が経営するローレンス・ロジスティクス社で輸送艦イーダスの艦長を務める。"},{"spoiler":false,"text":"「なんとかなる」が口癖で仲間と仕事のためには無謀な挑戦をすることもあり、イーダスのクルーにはいつも心配されている。おおらかな性格で人当たりが良く、同時に商人としての嗅覚が鋭い。"},{"spoiler":false,"text":"銀河連邦に所属していないが故に、未開惑星保護条約にも縛られず、また良くも悪くも相手との身分差に拘泥しないため、レティシアからはその性格を歓迎されているが、アベラルドからは警戒されている。"}],"source":"bangumi","sourceCharacterId":"112798"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e85cb508fbecd88667d40f6e5a22fa5a1060ef301289ee71cec86b82f13599b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd5bac2c48e478d4080aa28f0116a65f75328174a566b5eff979ae4cb9b4b69d.webp","width":129,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村昴","creatorId":"vndb:s8109","sourcePersonId":"vndb:s8109","canonicalEntityId":"vndb:s8109","name":"木村 昴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:354664:112798:6787:1","source":"bangumi"}]},{"characterId":"char_bangumi_112800","characterName":"レティシア・オーシディス","sourceIds":{"bangumi":[{"characterId":"112800","match":"source-roster","subjectId":"354664"}]},"originalCharacterName":"レティシア・オーシディス","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"未開惑星「アスター星系第4惑星」に大きな版図を持つオーシディアス王国の王女。"},{"spoiler":false,"text":"明るく思い切りの良い性格で、王族の身でありながら鎧をまとい、双剣を操り、民のために駆ける姿は多くの国民から慕われている。"},{"spoiler":false,"text":"近年、軍事的な緊張が続く隣国との状況を覆すべく、とある人物を探してお忍びの旅に出発したレティシアは、その旅路でアスター星系第4惑星に漂着したレイモンドと出会い、互いの目的のため、共に旅をすることとなった。"}],"source":"bangumi","sourceCharacterId":"112800"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e10eff44ef711e14eb470a14ede4c4902afc2bfdbe8caae4e6776b58ee7846b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa1c475e6b7ac423f586ee9a933952c2d76672448193ade1e3ace026d9d51c28.webp","width":139,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水瀬いのり","creatorId":"vndb:s5082","sourcePersonId":"vndb:s5082","canonicalEntityId":"vndb:s5082","name":"水瀬 いのり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:354664:112800:10868:1","source":"bangumi"}]},{"characterId":"char_bangumi_112801","characterName":"エレナ","sourceIds":{"bangumi":[{"characterId":"112801","match":"source-roster","subjectId":"354664"}]},"originalCharacterName":"エレナ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"輸送艦イーダスのクルーで、レイモンドの副官。"},{"spoiler":false,"text":"艦のほぼ全域にわたる運用を管理しており、その膨大な知識と、冷静沈着な佇まいからクルーとレイモンドからの信頼は厚い。"},{"spoiler":false,"text":"何事にも正直で、ともすれば無茶をするレイモンドには驚かされることも多いが、彼のリーダーとしての資質を高く評価している。"}],"source":"bangumi","sourceCharacterId":"112801"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2af1516562240cd722dead39a405ffd6b0769ee934bf50b06853d2c533eb6b27.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c85745d817d39d48da6617b7970fcba1a8df6b5222dc48dee37838076d2c157f.webp","width":100,"height":256,"source":"static-detail"},"actors":[{"creditedName":"種﨑敦美","creatorId":"vndb:s196","sourcePersonId":"vndb:s196","canonicalEntityId":"vndb:s196","name":"種﨑 敦美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:354664:112801:7575:1","source":"bangumi"}]},{"characterId":"char_bangumi_112802","characterName":"アベラルド・ベルグホルム","sourceIds":{"bangumi":[{"characterId":"112802","match":"source-roster","subjectId":"354664"}]},"originalCharacterName":"アベラルド・ベルグホルム","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"オーシディアス王国でレティシアに仕える騎士であり、一緒に育った幼馴染でもある。"},{"spoiler":false,"text":"理術とチャクラムを操る体術の双方に優れ、強い忠誠心によりレティシアの身辺に常に目を光らせている。左腕を指先まで覆っており、時折腕を庇うような仕草をみせる。"},{"spoiler":false,"text":"お忍びの旅の途中で出会ったレイモンドを強く警戒しているが、レティシアの意向には逆らえず、渋々同行を許している。"}],"source":"bangumi","sourceCharacterId":"112802"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/155465f9a288a9243cfd4456243dcb37ebaa6a93036e4f547a900d05e0272833.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04e541fb89c6359e0551ced3a80beb2bc81ead0425d6c66418648cc9dbf603ec.webp","width":120,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花江夏樹","creatorId":"vndb:s2180","sourcePersonId":"vndb:s2180","canonicalEntityId":"vndb:s2180","name":"ペロペロンチーノ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:354664:112802:7772:1","source":"bangumi"}]},{"characterId":"char_bangumi_112804","characterName":"ニーナ・デフォルジュ","sourceIds":{"bangumi":[{"characterId":"112804","match":"source-roster","subjectId":"354664"}]},"originalCharacterName":"ニーナ・デフォルジュ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"オーシディアス王国の理術士で、数少ない人を癒す力「施療理術」を操る少女。"},{"spoiler":false,"text":"父を亡くす原因となった病気の治療を人生の目標としており、街の施療理術士の元で助手をしながら独自の研究を続けている。"},{"spoiler":false,"text":"性格は明るく天真爛漫。持ち前の強い好奇心で研究に邁進するが、勢い余って失敗することも。"},{"spoiler":false,"text":"しかし、眼の前の患者のためにはどんな苦労もいとわない強い意志と行動力の持ち主。"}],"source":"bangumi","sourceCharacterId":"112804"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f778a40365ff185bc4487aebca323c776d22a405a487a2cdcf7747f012ac299.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19eb99549656a4a9df93176edea30a0149e814e4557abac70ef75d128c73c478.webp","width":153,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋李依","creatorId":"vndb:s10632","sourcePersonId":"vndb:s10632","canonicalEntityId":"vndb:s10632","name":"高橋 李依","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:354664:112804:17491:1","source":"bangumi"}]},{"characterId":"char_bangumi_112806","characterName":"ミダス・フレグリード","sourceIds":{"bangumi":[{"characterId":"112806","match":"source-roster","subjectId":"354664"}]},"originalCharacterName":"ミダス・フレグリード","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"オーシディアス王国の屈指の理術士であり技術者。"},{"spoiler":false,"text":"偏屈で好奇心が強く、その知識欲は時に法や倫理も忘れさせる。"},{"spoiler":false,"text":"しかし、引き受けた仕事は決して投げ出さないという強い矜持も持ち合わせた人物である。"},{"spoiler":false,"text":"かつて王国で高い地位にあったが、とある事件をきっかけに下野し、現在、所在生死ともに不明となっている。"}],"source":"bangumi","sourceCharacterId":"112806"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c724d446ce670aa019554df2935d1060c87d6743e937eaa54f05bc1b6de74cc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/8264fb0324f501a180dc27452e52d0358f70914e940657b31574c80f0d137a8f.webp","width":177,"height":256,"source":"static-detail"},"actors":[{"creditedName":"東地宏樹","creatorId":"vndb:s1365","sourcePersonId":"vndb:s1365","canonicalEntityId":"vndb:s1365","name":"東地 宏樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:354664:112806:4658:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p1455","sourceCompanyId":"egs:brand:1015","canonicalEntityId":"vndb:p1455","name":"スクウェア・エニックス(SQUARE ENIX)","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:33283:1015","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
