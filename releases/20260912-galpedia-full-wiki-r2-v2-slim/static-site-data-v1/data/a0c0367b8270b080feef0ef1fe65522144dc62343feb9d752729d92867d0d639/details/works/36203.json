eIds":{"bangumi":[{"characterId":"154288","match":"exact-normalized-name-in-linked-work","subjectId":"482850"}],"egsCharacterIds":["26332"],"vndbCharacterId":"c136403"},"originalCharacterName":"エリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Marigold at your service. Dear guest. Please feel free to ask me for anything. I will do my best to fulfill any request within my reach. ...Oh, did I say \"anything\"? Yes, that's right. Anything, indeed.\""},{"spoiler":false,"text":"Marigold, a blonde room maid in the mansion, possesses a gentle and polite personality."},{"spoiler":false,"text":"She finds genuine joy in pleasing others. However, in a mansion devoid of guests, Marigold had no choice but to go about her work silently, feeling unfulfilled."},{"spoiler":false,"text":"The arrival of Akira and his work has piqued Marigold's interest. Intrigued by his writing, she has begun to explore novels she wouldn't typically read."},{"spoiler":false,"text":"Akira's Memo"},{"spoiler":false,"text":"This girl has a vibe of an ojousama from a respectable family written all over her. Being a room maid, she's right there to cater to my every need. While having maids around can be nerve-wracking, her presence puts me at ease. She's all ears, ready to listen to whatever I say. But that's precisely why I need to watch my mouth and avoid inappropriate remarks..."},{"spoiler":false,"text":"Translated and edited from the official website"}],"source":"vndb","sourceCharacterId":"c136403"},{"segments":[{"spoiler":false,"text":"館で出会う金髪のメイド。"},{"spoiler":false,"text":"役割は客室メイド。"},{"spoiler":false,"text":"温和で礼儀正しい性格。"},{"spoiler":false,"text":"人に喜んでもらう事に喜びを感じているが、 客が訪れない館では黙々と仕事をするしかなかった。"},{"spoiler":false,"text":"主人公の仕事に興味を持っており、普段読まない小説を 読み始めたりしている。"}],"source":"egs","sourceCharacterId":"26332","sourceWorkId":"36203","spoiler":false},{"segments":[{"spoiler":false,"text":"「マリーゴールドと申します。お客様。なんでもお申し付けください。"},{"spoiler":false,"text":"私で叶えられる事であれば、何なりと叶えさせていただきます。"},{"spoiler":false,"text":"……え、なんでも、ですか？ええ、はい。なんでも、です」"},{"spoiler":false,"text":"館で出会う金髪のメイド。"},{"spoiler":false,"text":"役割は客室メイド。"},{"spoiler":false,"text":"温和で礼儀正しい性格。"},{"spoiler":false,"text":"人に喜んでもらう事に喜びを感じているが、 客が訪れない館では黙々と仕事をするしかなかった。"},{"spoiler":false,"text":"主人公の仕事に興味を持っており、普段読まない小説を 読み始めたりしている。"}],"source":"bangumi","sourceCharacterId":"154288"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"26332","sourceWorkId":"36203","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"26332","sourceWorkId":"36203","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"26332","sourceWorkId":"36203","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"26332","sourceWorkId":"36203","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"65 cm","valueContext":null,"source":"egs","sourceCharacterId":"26332","sourceWorkId":"36203","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0b44720429de299cc20fcb33c82e3f7b6f12b16479632e4623a707eb8a61515.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8bc1028b19c0eaf8b69955f6499222e5fc71d130da2a6b73e4b10ec3794ba183.webp","width":120,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花月さや","creatorId":"vndb:s23345","sourcePersonId":"vndb:s23345","canonicalEntityId":"vndb:s23345","name":"花月さや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:482850:154288:40638:1","source":"bangumi"}]},{"characterId":"char_c136404","characterName":"フィリエル","sourceIds":{"bangumi":[{"characterId":"154289","match":"exact-normalized-name-in-linked-work","subjectId":"482850"}],"egsCharacterIds":["26333"],"vndbCharacterId":"c136404"},"originalCharacterName":"フィリエル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"71"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"151"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"68"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Dear guest, how is your experience at Kouyoukan? In the absence of our master, we are committed to ensuring your stay is nothing short of exceptional.\""},{"spoiler":false,"text":"Rosemary, the head maid at the mansion, is a social butterfly with a knack for making everyone feel at ease. Yet, she's no pushover—she always keeps it professional, knowing exactly where to draw the line. She's known to crack a joke or two that might not always hit the mark, but you can trust her to keep things straight."},{"spoiler":false,"text":"When she's not running the show, Rosemary is hands-on, helping wherever needed. From cooking and laundry to paperwork, the head maid got it all covered. Yet, she humbly acknowledges that these capabilities are expected of every maid in the mansion."},{"spoiler":false,"text":"Akira's memo"},{"spoiler":false,"text":"At first glance, this girl seemed a bit high and mighty, but it turns out she's cool—though she does enjoy a bit of leg-pulling. And despite her youthful looks, she's got a knack for nailing contract negotiations like a pro. Ever wonder where she learned all that? She's on point when it matters, every inch the capable head maid you’d expect."},{"spoiler":false,"text":"Translated and edited from the official website"}],"source":"vndb","sourceCharacterId":"c136404"},{"segments":[{"spoiler":false,"text":"館のメイド長。"},{"spoiler":false,"text":"明るく社交的。誰とでも仲良くなれるが自らの立場を意識しており一線を引いている。"},{"spoiler":false,"text":"ときおり冗談ともつかない言葉を口にするが、基本的に嘘はつかない。"},{"spoiler":false,"text":"館の仕事全般に通じており、メイド長としての仕事が無い時や朝の配膳など人手が必要な場では一緒に働いている。"},{"spoiler":false,"text":"掃除洗濯料理から書類仕事まで何でもこなすが、館のメイドならば全員同じことが出来るとは本人の弁"}],"source":"egs","sourceCharacterId":"26333","sourceWorkId":"36203","spoiler":false},{"segments":[{"spoiler":false,"text":"「お客様、紅葉館はいかがでしょう。"},{"spoiler":false,"text":"不在のご当主様の代わりに、誠心誠意おもてなしをさせて頂きますわ」"},{"spoiler":false,"text":"館のメイド長。"},{"spoiler":false,"text":"明るく社交的。誰とでも仲良くなれるが自らの立場を意識しており一線を引いている。"},{"spoiler":false,"text":"ときおり冗談ともつかない言葉を口にするが、基本的に嘘はつかない。"},{"spoiler":false,"text":"館の仕事全般に通じており、メイド長としての仕事が無い時や朝の配膳など人手が必要な場では一緒に働いている。"},{"spoiler":false,"text":"掃除洗濯料理から書類仕事まで何でもこなすが、"},{"spoiler":false,"text":"館のメイドならば全員同じことが出来るとは本人の弁"}],"source":"bangumi","sourceCharacterId":"154289"}],"profileFacts":[{"label":"胸围（本版本）","value":"71 cm","valueContext":null,"source":"egs","sourceCharacterId":"26333","sourceWorkId":"36203","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"26333","sourceWorkId":"36203","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"151 cm","valueContext":null,"source":"egs","sourceCharacterId":"26333","sourceWorkId":"36203","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"68 cm","valueContext":null,"sour