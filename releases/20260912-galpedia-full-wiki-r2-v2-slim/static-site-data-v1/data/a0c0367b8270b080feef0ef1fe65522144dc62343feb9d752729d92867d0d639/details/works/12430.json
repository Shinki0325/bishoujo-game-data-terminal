"creatorId":"vndb:s665","sourcePersonId":"vndb:s665","canonicalEntityId":"vndb:s665","name":"あらい しずか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:475750:210290:4647:1","source":"bangumi"}]},{"characterId":"char_c35967","characterName":"叶野 結衣","sourceIds":{"bangumi":[{"characterId":"210291","match":"exact-normalized-name-in-linked-work","subjectId":"475750"},{"characterId":"210291","match":"exact-normalized-name-in-linked-work","subjectId":"646372"}],"egsCharacterIds":["15218"],"vndbCharacterId":"c35967"},"originalCharacterName":"叶野 結衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"19"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同じ大学の経済学部に通う二年生。19歳。"},{"spoiler":false,"text":"内気で大人しく、人見知りする性格。"},{"spoiler":false,"text":"異性に対しては余計に意識してしまい、極度の緊張から会話もままならない。"},{"spoiler":false,"text":"主人公はあまり緊張せずに話せる数少ない男友達。"},{"spoiler":false,"text":"大きい胸にコンプレックスを持ち、故に痴漢に遭うことも多く、痴漢に対して悪いイメージしか持っていない。"},{"spoiler":false,"text":"痴漢から守ってもらおうと主人公に護衛をお願いするが……。"}],"source":"egs","sourceCharacterId":"15218","sourceWorkId":"12430","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同じ大学に通う女子大生。19歳。"},{"spoiler":false,"text":"内気で人見知りするタイプの女の子だったが、主人公に痴漢の真髄を肉体に刻まれ、自らも痴漢サークルに入会。すっかり痴漢の快感にはまってしまい、主人公と痴漢ライフを満喫している。"},{"spoiler":false,"text":"普通のイイトコのお嬢様風だが、サークル活動中だけその内に秘めるいやらしい本性を見せる。"},{"spoiler":false,"text":"基本はマゾだが、サド的な面も持っている。"}],"source":"egs","sourceCharacterId":"15218","sourceWorkId":"12558","spoiler":false},{"segments":[{"spoiler":false,"text":"私立大学経済学部2年生"},{"spoiler":false,"text":"純一と同じ大学の同じ学部に通う女子大生。内気で人見知りな性格で、特に男性相手だと余計に緊張し、会話もままならなくなってしまうが、純一は唯一話せる数少ない男友達。"},{"spoiler":false,"text":"大きな胸にコンプレックスを持っている割りに、無頓着な部分があり、体のラインが 分かりやすい服を着て、図らずも周囲の注目を集めてしまうことあったりする。"},{"spoiler":false,"text":"胸の大きさと大人しそうな印象のせいか、痴漢に遭遇することも少なくないが、その性格のため助けを求めたりすることができず、痴漢には悪いイメージしか持っていない。"},{"spoiler":false,"text":"痴漢から身を守ってもらおうと、純一に護衛をお願いするのだが…。"}],"source":"bangumi","sourceCharacterId":"210291"}],"profileFacts":[{"label":"年龄（本版本）","value":"19 岁","valueContext":null,"source":"egs","sourceCharacterId":"15218","sourceWorkId":"12430","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"15218","sourceWorkId":"12430","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"15218","sourceWorkId":"12430","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"15218","sourceWorkId":"12430","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"15218","sourceWorkId":"12430","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64a91c36cae53e7de80d463d6c32aa6865c3c6590672afc2cf6b3490c57f03db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/257402ba85b748f1e46f4f615d9acd788f02d85dbb58466183f233b02739ed88.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:475750:210291:4714:1","source":"bangumi"}]},{"characterId":"char_c35968","characterName":"坪内 彩花","sourceIds":{"bangumi":[{"characterId":"210292","match":"exact-normalized-name-in-linked-work","subjectId":"475750"}],"egsCharacterIds":["15295"],"vndbCharacterId":"c35968"},"originalCharacterName":"坪内 彩花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"22"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が利用している路線の沿線にある会社に勤めるOL。22歳。"},{"spoiler":false,"text":"地味な格好をしていて目立たないが、美人である。"},{"spoiler":false,"text":"母親は鉄道風紀委員の副委員長を務め、痴漢撲滅に尽力しているが、彼女自身はあまり興味を持っていなかった。"},{"spoiler":false,"text":"しかし、主人公の痴漢行為を目撃し、その痴漢という淫らな行為に強く惹きつけられるようになる。"},{"spoiler":false,"text":"以来、主人公を見つけてはその行為を覗き見するようになる。"},{"spoiler":false,"text":"しかし、現場に居合わせては、ただ痴漢現場を覗いているだけ、という不可解な行動をするため、痴漢サークルのメンバー達に目を付けられることに……。"}],"source":"egs","sourceCharacterId":"15295","sourceWorkId":"12430","spoiler":false},{"segments":[{"spoiler":false,"text":"純一が利用している路線の沿線にある会社に勤めるOL。美人だが、普段は地味な格好を していてあまり目立たない。"},{"spoiler":false,"text":"母親は鉄道風紀委員の副委員長を務め、痴漢撲滅を目指しているが、あまり興味は持っていなかった。"},{"spoiler":false,"text":"しかしある日、純一が痴漢をしている現場を 目撃し、その行為に強く惹きつけられてしまう。"},{"spoiler":false,"text":"その日以来、純一の姿を見つけては痴漢行為を覗き見するようになるが、阻止するでもなく、誰かに訴えるでもなく、ただ痴漢 現場を覗いているだけ、という不可解な行動をするため、痴漢サークルのメンバー達に目を付けられることに…。"}],"source":"bangumi","sourceCharacterId":"210292"}],"profileFacts":[{"label":"年龄（本版本）","value":"22 岁","valueContext":null,"source":"egs","sourceCharacterId":"15295","sourceWorkId":"12430","sourceField":null,"sco