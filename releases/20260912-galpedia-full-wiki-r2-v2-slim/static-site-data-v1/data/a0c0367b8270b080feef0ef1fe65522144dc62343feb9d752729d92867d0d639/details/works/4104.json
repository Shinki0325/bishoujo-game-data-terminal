":"89"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The fifth sister."},{"spoiler":false,"text":"She is a kind, mild-mannered and beautiful older sister. She sometimes gives men around her the wrong impression. She is extremely affectionate with her younger brother, she wants to take care of him in any way possible."},{"spoiler":false,"text":"She also has a tendency to make up her mind on anything making it hard to persuade her. She also has a very poor sense of taste and often makes the mistake of eating the wrong food or messing up anything she cooks."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c9286"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f6fe191ef4fcc1e7a6cf3a5e3805abf4b38b6f10754793233d840138c2f7ee2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/5297b50676df04b2433a1da2e9b41a8782e934fb75127536a4277863f53a6f2d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西田 こむぎ","creatorId":"vndb:s570","sourcePersonId":"vndb:s570","canonicalEntityId":"vndb:s570","name":"西田こむぎ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8873","source":"vndb"}]},{"characterId":"char_vndb_c9287","characterName":"花丸 りんご","sourceIds":{"vndbCharacterId":"c9287"},"originalCharacterName":"花丸 りんご","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"94"},"height":{"reviewState":"source-only","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"},"weight":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The third sister."},{"spoiler":false,"text":"On the outside, she is an easy-going college girl who can be found anywhere. On the inside, she is a bitchy older sister who plays pranks on her younger brother. She doesn't interfere with anyone else in the family."},{"spoiler":false,"text":"She will try wrestling moves on him, take off his pants when he gets excited, or get him into near death experiences or any kind of malicious prank for the sake of it being \"underground and funny\""},{"spoiler":false,"text":"She has an interest with the underground, that is, anything that is abnormal or subversive. She has a hobby of visiting pornographic sites."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c9287"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef7abbf855e2e84bacbb4875c05e2fefe41f8aa17a659a8620f13601b6ada1c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a37c0a66fe20c6a56212a090ca7aba344b4256cd1db9b2ef882727a036a75fc6.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北都 南","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8871","source":"vndb"}]},{"characterId":"char_vndb_c9288","characterName":"花丸 みかん","sourceIds":{"vndbCharacterId":"c9288"},"originalCharacterName":"花丸 みかん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"source-only","source":"vndb","value":"151"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"},"weight":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The eighth sister."},{"spoiler":false,"text":"She is a very childish older sister who's more like a younger sister. She is concerned about it and tries to act like an adult and fails. She may look harmless, but can be very moody."},{"spoiler":false,"text":"When she is in a good mood, she'll spoil her brother, even going so far as seducing him. When she's in a bad mood she takes it out on him. She's recently learned how to mimic a heart-wrenching cry to garner sympathy."},{"spoiler":false,"text":"She has a habit of always wearing pajamas at home."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c9288"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8f956d419cd636a0bb4602c45e2ad598c480c077e30672633ccb2da8ce42e2e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fe7fa3264e3439cd5a403167e4ee15e238bd0fe81adfcfc3dc0441247173470.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"芹園 みや","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8875","source":"vndb"}]},{"characterId":"char_vndb_c9289","characterName":"花丸 ももこ","sourceIds":{"vndbCharacterId":"c9289"},"originalCharacterName":"花丸 ももこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"98"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"},"weight":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The eldest sister."},{"spoiler":false,"text":"She is married and has children but moved back home to her parents' home. She is mainly in charge of cooking and laundry, and is regarded as the most level headed person in the house."},{"spoiler":false,"text":"The reason she returned home due to \"poor health\" is a ruse. There are rumors that she is having difficulties with her \"night life\" with her husband. She still tries to be amicable and caring when the possibility of divorce is running through her mind."},{"spoiler":false,"text":"Not too long ago, her daughter was born. Her name is Natsume."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c9289"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a30a2126f5949ce6914feedde17b9a123b4313169894fdc50c02391bbb40b8d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9eb0559114d9e20a98cc826b5471df1523bc9eb6bf78494514cb0023fa3fd204.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長崎 みなみ","creatorId":"vndb:s1073","sourcePersonId":"vndb:s1073","canonicalEntityId":"vndb:s1073","name":"長崎 みなみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8877","source":"vndb"}]},{"characterId":"char_vndb_c9290","characterName":"花丸 びわ","sourceIds":{"vndbCharacterId":"c9290"},"originalCharacterName":"花丸 びわ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"},"weight":{"reviewState":"source-only","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The tenth sister."},{"spoiler":false,"text":"Clean, proper, beautiful, reserved, and modest. She is an anachronistic elder sister who lives up to the Yamato Nadeshiko image. She loves old culture and her tone of voice is like that of a period drama."},{"spoiler":false,"text":"She is a martial arts expert, with dozens of martial arts skills mastered. However, she is a strict and merciless older sister to her younger brother. Like a nagging grandmother, she worries for the brother but easily goes overboard into \"severe scolding mode\", even using force. She always justifies herself by saying \"It's training!\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c9290"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fcd2d14c77e725178dacfc0fd3acd263d73262f55324124cc6c251da1189064.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1854dd366dd9eb4c32c61db1b0d4dd003c81cca209cdd4404c6626c3ea009b0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中島 千春","creatorId":"vndb:s7993","sourcePersonId":"vndb:s7993","canonicalEntityId":"vndb:s7993","name":"中島 千春","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8879","source":"vndb"}]},{"characterId":"char_vndb_c9298","characterName":"花丸 餡禰","sourceIds":{"vndbCharacterId":"c9298"},"originalCharacterName":"花丸 餡禰","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The seventh sister."},{"spoiler":false,"text":"Speaks using the Kansai dialect. She always wears no bra. She grew up in a space full of women, so she has a bit of a lesbian streak going on, hating men may play a role in that. She detests the protagonist because of his sex."},{"spoiler":false,"text":"She is not good with stories of the occult, but loves to talk about it a lot. She's had a sixth sense for it even since she was a child."},{"spoiler":false,"text":"She is fond of saying \"Let's eat a banana\"."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c9298"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/303aaf67b5fb0ce1a8d54c3cd7a8261c8ad60aa4a166fc1d11ed26a171e450d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af3e2fcc2b42d3e100d464909f91517418319666ff57867535723ffb0928abc0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北都 南","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8872","source":"vndb"}]},{"characterId":"char_vndb_c9299","characterName":"花丸 薫子","sourceIds":{"vndbCharacterId":"c9299"},"originalCharacterName":"花丸 薫子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"95"},"height":{"reviewState":"source-only","source":"vndb","value":"169"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The second sister."},{"spoiler":false,"text":"She is a beautiful, intelligent, experienced, calm and collected woman. She is the secretary to an executive at a prestigious company, and is a super sister who is perfect in every way. She is always inundated with love calls from male employees."},{"spoiler":false,"text":"But there is a stark difference between her public and private life. At home, she is very overbearing, perhaps to release the stress of her work. She is one of the sisters the protagonist fears the most."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c9299"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9dfe752cc8ad27574120cbb70fe7c08d2774942c7e6f24cf07d11623e674f9a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b111b99e1f5147604c7d8b461e9379844e84ee3dcce84554e10e0da517a5cdf.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中島 千春","creatorId":"vndb:s7993","sourcePersonId":"vndb:s7993","canonicalEntityId":"vndb:s7993","name":"中島 千春","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8880","source":"vndb"}]},{"characterId":"char_vndb_c9300","characterName":"花丸 琴菜","sourceIds":{"vndbCharacterId":"c9300"},"originalCharacterName":"花丸 琴菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"source-only","source":"vndb","value":"154"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"},"weight":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The ninth sister."},{"spoiler":false,"text":"An earnest girl, she is the type who always has a reference book in one hand. She is happy to spend her time studying, making her special amongst the sisters."},{"spoiler":false,"text":"She has a rather quiet personality and doesn't talk much. Some think she has a communication disorder or it's possible that she just doesn't pay attention to anything other than her studies."},{"spoiler":false,"text":"She doesn't communicate much with her younger brother, nor does she even bother trying,"},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c9300"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bce65d08c4b6075e4f46f0769069ba83085494c23225cc9e6cf9eb6470522498.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fedd719ed4e0e26065b707c62b12038de4b1e6bee5a3f48db1db29d7debc9d77.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"芹園 みや","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":