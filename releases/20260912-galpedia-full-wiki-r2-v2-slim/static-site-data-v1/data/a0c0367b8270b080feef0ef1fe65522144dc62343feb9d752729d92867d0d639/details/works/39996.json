ctor","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:210118","source":"vndb"}]},"cast":[{"characterId":"char_c60023","characterName":"ソフィ","sourceIds":{"bangumi":[{"characterId":"56994","match":"exact-normalized-name-in-linked-work","subjectId":"189739"}],"egsCharacterIds":["16280"],"vndbCharacterId":"c60023"},"originalCharacterName":"ソフィ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"？？？"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You're overthinking it. There is no good or evil when it comes to the Artifacts' powers.\""},{"spoiler":false,"text":"An unknown life form who sought out the protagonist."},{"spoiler":false,"text":"Sophie looks like a creepy plushie, but she insists that it’s only her temporary form while in the protagonist's world and that she's a beautiful girl."},{"spoiler":false,"text":"She claims to be a member of Sephirot, an organization that manages the Artifacts and says she was sent to the protagonist's world to begin collecting the lost Artifacts which escaped after the destruction of the shrine’s sacred relic."},{"spoiler":false,"text":"On discovering that Kakeru and Miyako are Users, she enlists their help to gather the Artifacts and restore normalcy to the world."},{"spoiler":false,"text":"From Steam"},{"spoiler":true,"text":"A version of Iris that was successful in fending off her insanity and path to ruin due to her Artifacts, she established the organization Sephirot to manage the use of Artifacts and to prevent any loss of life due to their use. She subsequently changes her name to Sophitia, believing it to be a more suitable name for someone who was so unlike the holy maiden that Kakeru's world believes her to be."},{"spoiler":true,"text":"Her creepy plushie body is a phantom existence created by an Artifact to make contact with Miyako, Kakeru, and the others. Notably, she is assuming direct control of her phantom, unlike the usual use of such an ability that results in existences like Ghost."},{"spoiler":true,"text":"She is aware of Nine's existence and has been attempting to contact them in a bid to stop her evil counterpart."}],"source":"vndb","sourceCharacterId":"c60023"},{"segments":[{"spoiler":false,"text":"主人公の前に現れた異世界の謎生物。"}],"source":"egs","sourceCharacterId":"16280","sourceWorkId":"24022","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の前に現れた異世界の謎生物。"},{"spoiler":false,"text":"どこから見てもちょっと不気味なぬいぐるみなのだが、これは主人公の世界での仮の姿で、自分の世界では美少女の姿をしているのだと言い張っている。"},{"spoiler":false,"text":"本人曰くアーティファクトを管理している組織「セフィロト」の一員らしく、神器の破損をきっかけに主人公の世界へ流出してしまったアーティファクトの回収を都や翔に手伝わせる。"},{"spoiler":false,"text":"「......あなた、なにを言っているの?」"}],"source":"bangumi","sourceCharacterId":"56994"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cf04b58ce77715f9c979fe73f45767712e66644d0df101f1ed4570376989659.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c5b36de4a81a977752f3f3795d41de9ff4662fff4fe24c00ffabf1ff80108a4.webp","width":234,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c162097","characterName":"如月 結那","sourceIds":{"vndbCharacterId":"c162097"},"originalCharacterName":"如月 結那","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1115"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"151"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student who just transferred to Hakusen Academy."},{"spoiler":false,"text":"She loves jokes and is easy to get along with, but partly because she just moved here, she doesn't have any friends to hang out with. She lives alone in a magnificent apartment that is out of place for her age, spending her time freely doing whatever she pleases."},{"spoiler":false,"text":"Her grandfather is the head of a school of ancient swordsmanship, and having spent all her time there since she was little, she is a skilled swordswoman serving as the acting instructor of the Kisaragi Style."},{"spoiler":false,"text":"Meeting Theodore, who was collapsed on the road, and revealing the true reason she came to this city sets Yuna's in motion."}],"source":"vndb","sourceCharacterId":"c162097"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/842f2af8ba41bfdc5c9bc13249c31a0a5a90b7d4b1d58948edb672541763e146.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/801f01fc402066b2be3e542a27945409c71d2095a54e6b66ea4a570b82772fcb.webp","width":207,"height":256,"source":"static-detail"},"actors":[{"creditedName":"悠木 碧","creatorId":"vndb:s1321","sourcePersonId":"vndb:s1321","canonicalEntityId":"vndb:s1321","name":"悠木 碧","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:98812","source":"vndb"}]},{"characterId":"char_vndb_c162098","characterName":"テオドール･ストラトス","sourceIds":{"vndbCharacterId":"c162098"},"originalCharacterName":"テオドール･ストラトス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"808"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"181"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoile