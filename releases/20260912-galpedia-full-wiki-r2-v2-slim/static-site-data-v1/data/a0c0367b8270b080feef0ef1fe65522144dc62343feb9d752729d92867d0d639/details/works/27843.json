canonicalEntityId":"vndb:s12940","name":"林 亮介","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:148810","source":"vndb"},{"creditedName":"Ma-ki","creatorId":"vndb:s15373","sourcePersonId":"vndb:s15373","canonicalEntityId":"vndb:s15373","name":"牧野真児","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:148812","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c71975","characterName":"天道 陽華","sourceIds":{"vndbCharacterId":"c71975"},"originalCharacterName":"天道 陽華","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Greenwich Academy Second Year."},{"spoiler":false,"text":"An intelligent young man and avid reader, with a particular fondness for mystery stories."},{"spoiler":false,"text":"Haruka has a calm, rational personality and prefers to think think things through before acting. In spite of this, Luna finds him an easy target to manipulate."},{"spoiler":false,"text":"He challenges Luna, despite knowing how reckless it is, because he wants to discover the truth of a certain incident and get someone back."},{"spoiler":false,"text":"Specialist Writing Genre: Mystery"},{"spoiler":false,"text":"\"So we have a mystery starring a detective who's a bit lacking in the humanity department. One who solves the puzzle through logic alone, ignoring motive. Not bad. Not bad at all.\""},{"spoiler":false,"text":"From Twitter"}],"source":"vndb","sourceCharacterId":"c71975"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cce294d0d3caeed728f32783eee87081e528d58c46877d49417bcefcd78f6265.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d61e07cfa481b44871349b4bd93a9bf3cc4b0c6bbaa380de36e6a8e3364ca6c.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c71976","characterName":"生時雨 澪","sourceIds":{"vndbCharacterId":"c71976"},"originalCharacterName":"生時雨 澪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Greenwich Academy Second Year."},{"spoiler":false,"text":"A model student and diligent club chairman, wrestling with her inner demons."},{"spoiler":false,"text":"Mio is a responsible, self-confident girl, but because of her firm conviction in her beliefs, people tend to call her stubborn. Her club members have been heard to joke that she's no fun."},{"spoiler":false,"text":"She loves reading mystery stories and frequently discusses then with Haruka, who shares her taste in novels."},{"spoiler":false,"text":"Specialist Writing Genre: Mystery"},{"spoiler":false,"text":"\"I do love everyone. So, how should I put this? I don't really mind being there to support everyone, even if nobody notices.\""},{"spoiler":false,"text":"From Twitter"}],"source":"vndb","sourceCharacterId":"c71976"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0fb4900ff3949648e0f7c1909f7f5eef469d0159528400aa4ee1bcb1ec94fca8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a19aa537698dfc1766dd63dba597eea5040a27ccc4f186007648123d929c29a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大和 桜","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:77723","source":"vndb"}]},{"characterId":"char_vndb_c71977","characterName":"坂佐 結仁","sourceIds":{"vndbCharacterId":"c71977"},"originalCharacterName":"坂佐 結仁","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Greenwich Academy Second Year."},{"spoiler":false,"text":"A slender, baby-faced classmate of Haruka with a complex about his height."},{"spoiler":false,"text":"Yuni is an incredibly hard worker who exudes sincerity, but unfortunately for him, his adorably young looks often lead people to treat him as a child. His juvenile appearance and actions inspire everyone around to protect him, which sometimes causes trouble."},{"spoiler":false,"text":"Doggedly persistent, he forces himself to drink milk every day in hopes of growing taller."},{"spoiler":false,"text":"Specialist Writing Genre: Action / Adventure"},{"spoiler":false,"text":"\"One of these days, I'm gonna be even taller than you, Haruka! I'm gonna shoooot up, and then you'll be the one looking up at me!\""},{"spoiler":false,"text":"From Twitter"}],"source":"vndb","sourceCharacterId":"c71977"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9eb4cb0f40bdc371568911f807b3f979f9093f3ab171e83ecc8c392cad36fd9e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bf9060a5d5430d6834ae83ffc023d3bc3ac934b47c710a2d80370fb65ad4a11.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"赤井 リア","creatorId":"vndb:s3891","sourcePersonId":"vndb:s3891","canonicalEntityId":"vndb:s3891","name":"赤井リア(赤井いちご)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:77724","source":"vndb"}]},{"characterId":"char_vndb_c71978","characterName":"金毘羅 蝶","sourceIds":{"vndbCharacterId":"c71978"},"originalCharacterName":"金毘羅 蝶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"148"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Greenwich Academy First Year."},{"spoiler":false,"text":"An outgoing younger student, always ready with a smile."},{"spoiler":false,"text":"What you see with Chiyo is exactly what you get: a happy, cheerful girl. She can get along with anyone, even fitting naturally into her older classmates' social circles at school. Her fellow club members have given her the pet name \"Pichon.\""},{"spoiler":false,"text":"Chiyo isn't much of a reader by nature, so she struggles with writing."},{"spoiler":false,"text":"Specialist Writing Genre: School Life"},{"spoiler":false,"text":"\"Hey! Are you laughing at me, Haruka?! You cut that out right now! A girl's hair is a matter of life and death!\""},{"spoiler":false,"text":"From Twitter"}],"source":"vndb","sourceCharacterId":"c71978"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e12bc49c051dcd0de2524ae9011d01187c0ee5bf29415a2ff75df3c46311367f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9cbfb0e01b4568fc9f9fb5b1e97edbbb0cd0b2863c8eb4b4c30aaa9f0c27d7f4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和光 雪華","creatorId":"vndb:s16068","sourcePersonId":"vndb:s16068","canonicalEntityId":"vndb:s16068","name":"和光 雪華","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:77727","source":"vndb"}]},{"characterId":"char_vndb_c71979","characterName":"嵐 真樹志","sourceIds":{"vndbCharacterId":"c71979"},"originalCharacterName":"嵐 真樹志","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Greenwich Academy Second Year. Haruka's Classmate."},{"spoiler":false,"text":"A hot-blooded young man with a great love of sports."},{"spoiler":false,"text":"Makishi's preference to act, rather than risk over-thinking things, makes him a perfect compliment for the ever-cautious Haruka."},{"spoiler":false,"text":"Though he can sometimes accidentally saw conflict with his simple honest, he's an easy-to-manage guy with an empathetic side, so the girls in his club think highly of him."},{"spoiler":false,"text":"He's not the sharpest tool in the shed, which gives him grief when he's trying to proofread, let alone write."},{"spoiler":false,"text":"Specialist Writing Genre: Sports"},{"spoiler":false,"text":"\"To take a trip with my buddies, I'd go anywhere, even to the ends of the earth! You're with me on this, right Haru?\""},{"spoiler":false,"text":"From Twitter"}],"source":"vndb","sourceCharacterId":"c71979"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/157262ffc98c3e66891e22358187f1e5eac0b2d28fa0782c5a1f01a3a606a88b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea0647b47f36416160456d66fb168272494cb4e130456f2192f001a99219dabe.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"どっこい しょーいち","creatorId":"vndb:s16066","sourcePersonId":"vndb:s16066","canonicalEntityId":"vndb:s16066","name":"どっこいしょーいち","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:77725","source":"vndb"}]},{"characterId":"char_vndb_c71980","characterName":"ルナ","sourceIds":{"vndbCharacterId":"c71980"},"originalCharacterName":"ルナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"145"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The devil? The grim reaper? A phantom? A vampire?"},{"spoiler":false,"text":"All that's known for sure is that she doesn't mean to play fair, and she goes by the pseudonym \"Queen of the Night.\""},{"spoiler":false,"text":"Luna's lust drips from her every word and smile. Arrogant and prideful, she has dubbed herself the Grand Duke, and she takes great joy in in chattering childishly with all those she deems beneath her lofty status."},{"spoiler":false,"text":"Endowed with great knowledge and foresight, she is far more mature than her appearance would lead one to believe."},{"spoiler":false,"text":"She lies in wait for Haruka with her bunny servants in her mysterious palace, Eclipse, which manifests only on weekends."},{"spoiler":false,"text":"Favorite Things: Flesh of Young Humans, Blood, Souls, Despair, Being Called by Her Name, Chatting"},{"spoiler":false,"text":"Least Favorite Things: Unworthy Opponents, Boring Games, Silence"},{"spoiler":false,"text":"Special Skills: Monologuing, Provocation"},{"spoiler":false,"text":"\"Now begin! Tell us a story drenched in blood! A mystery filled with lies, hypocrisy, and deception! A tale where all hope is lost, where every wish is dashed! Remember, and reason, and expose the truth behind the human race!\""},{"spoiler":false,"text":"From Twitter"}],"source":"vndb","sourceCharacterId":"c71980"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9912933cd6481a03a7aa0fd98fbf7f9acc214a91e2012d1630dd80e1e6f1650.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/8850085b8ed82a4dcd89486e5534df35557d75475ce13d30388defc7618164cb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"蒼依 ハル","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:77722","source":"vndb"}]},{"characterId":"char_vndb_c71981","characterName":"ウサギ","sourceIds":{"vndbCharacterId":"c71981"},"originalCharacterName":"ウサギ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Luna's servants who reside in Eclipse."},{"spoiler":false,"text":"The Bunnies have no individual names, but have different personalities depending on their color. However, no matter the Bunny, they obey Luna's orders absolutely. If Luna ordered a Bunny to die, they would do so without a second thought, showing both how strongly they are devoted to Luna and also how little they value life."},{"spoiler":false,"text":"Red is the symbol of fanaticism. A faithful servant with blind loyalty and devotion to her mistress."},{"spoiler":false,"text":"\"The Grand Duke will see you now. Do make sure to be polite.\""},{"spoiler":false,"text":"From Twitter"}],"source":"vndb","sourceCharacterId":"c71981"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47fb83c4c43a4754ecabbd44c480e5437c42cd870eb7344df09fccbca929238a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1