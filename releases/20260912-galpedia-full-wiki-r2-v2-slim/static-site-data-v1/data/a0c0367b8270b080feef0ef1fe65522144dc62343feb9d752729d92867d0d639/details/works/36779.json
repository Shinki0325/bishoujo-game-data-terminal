ceCharacterId":"c90584"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/932bed51c232fe81d435fb1ffa98f816f17d406a40bcaa8086a139bab3899a02.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b87cad779f56c63dede2818ac497f31447dbccf462cfcb2b240e5e16d7bb83ed.webp","width":256,"height":246,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c90585","characterName":"天堂 聡","sourceIds":{"vndbCharacterId":"c90585"},"originalCharacterName":"天堂 聡","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A male teacher who was transferred to the school when Tendo Motoya became acting principal."},{"spoiler":false,"text":"Motoya's biological son."},{"spoiler":false,"text":"He was spoiled growing up and grew up with a selfish personality."},{"spoiler":false,"text":"With his parents' help, he managed to go on to higher education and even obtained a teaching license."},{"spoiler":false,"text":"He's a lecherous man who, as parents, is what makes a man."},{"spoiler":false,"text":"He has made advances on his students and caused trouble on several occasions, but has resolved the issues with his parents' help and money."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c90585"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b368688a0cf25030f169eef1bf917bc0dfc087b4f4219ac0bd1105d4801b4f31.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4267b9f83e9de7f991a430292164ea47cf344b0297eb7c6660500ec3de1e412.webp","width":256,"height":246,"source":"static-detail"},"actors":[]},