icalEntityId":"vndb:s32384","name":"やよ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:165926","source":"vndb"},{"creditedName":"ホームラン","creatorId":"vndb:s34453","sourcePersonId":"vndb:s34453","canonicalEntityId":"vndb:s34453","name":"ホームラン","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:165927","source":"vndb"},{"creditedName":"鶏さん","creatorId":"vndb:s35096","sourcePersonId":"vndb:s35096","canonicalEntityId":"vndb:s35096","name":"鶏さん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:165928","source":"vndb"},{"creditedName":"かキせん","creatorId":"vndb:s5816","sourcePersonId":"vndb:s5816","canonicalEntityId":"vndb:s5816","name":"武井 英彦","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:165929","source":"vndb"},{"creditedName":"藤 生中","creatorId":"vndb:s49778","sourcePersonId":"vndb:s49778","canonicalEntityId":"vndb:s49778","name":"藤 生中","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:165931","source":"vndb"}]},"cast":[{"characterId":"char_c90579","characterName":"日ノ宮 舞果","sourceIds":{"bangumi":[{"characterId":"77121","match":"exact-normalized-name-in-linked-work","subjectId":"303900"}],"egsCharacterIds":["22558"],"vndbCharacterId":"c90579"},"originalCharacterName":"日ノ宮 舞果","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student at St. Ruri Girls Academy, she is the student council president as well as a member of the swimming club"},{"spoiler":false,"text":"Although she is the granddaughter of the principal she goes by her maternal surname"},{"spoiler":false,"text":"As a kid she had poor health and couldn't go outside her house very often so she spent most of the time reading books, maybe that's why she gained a lot of knowledge. That is shown on her grades which are excellent and so she is always on the top."},{"spoiler":false,"text":"She is currently taking aikido lessons for self-defense and to build physical and spiritual strength. In addition, she is also a member of the swimming club due to Youko influence. Recently she finally has been able to participate in PE classes normally."},{"spoiler":false,"text":"She has a calm personality and is often mistaken as a senior student. In the conversations with her friends, she often takes the listener role."},{"spoiler":false,"text":"She doesn't understand anything about love even when she hears other people talking about their love affairs."}],"source":"vndb","sourceCharacterId":"c90579"},{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"学園長の実の孫なのだが、それは公表せずに母方の姓を名乗っている。"},{"spoiler":false,"text":"（父方の姓では桜小路舞果（さくらこうじ まいか））"},{"spoiler":false,"text":"幼い頃は病弱であまり外に出られず、本を読んで過ごすことが多かった。"},{"spoiler":false,"text":"それもあってか、何かと知識は豊富。"},{"spoiler":false,"text":"成績も優秀でテスト成績は常に学園の上位。"},{"spoiler":false,"text":"体力作りと護身・精神の鍛錬のために合気道を習っている。"},{"spoiler":false,"text":"また、陽子の影響もあり水泳部にも所属している。"},{"spoiler":false,"text":"最近はようやく人並みに体育の授業にも参加できるようになった。"},{"spoiler":false,"text":"落ち着いた性格をしていて、第一印象では年上に思われることが多い。"},{"spoiler":false,"text":"友達との会話は聞き役になることが多く、いろいろな相談を受けたりすることも多い。"},{"spoiler":false,"text":"恋愛感情には疎く、人の恋愛事情を聞いてもあまりピンと来ない。"}],"source":"egs","sourceCharacterId":"22558","sourceWorkId":"29447","spoiler":false},{"segments":[{"spoiler":false,"text":"聖瑠璃女学園2年生。"},{"spoiler":false,"text":"学生会長。水泳部員。"},{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"学園長の実の孫なのだが、それは公表せずに母方の姓を名乗っている。"},{"spoiler":false,"text":"幼い頃は病弱であまり外に出られず、本を読んで過ごすことが多かった。"},{"spoiler":false,"text":"それもあってか、何かと知識は豊富。"},{"spoiler":false,"text":"成績も優秀でテスト成績は常に学園の上位。"},{"spoiler":false,"text":"体力作りと護身・精神の鍛錬のために合気道を習っている。"},{"spoiler":false,"text":"また、陽子の影響もあり水泳部にも所属している。"},{"spoiler":false,"text":"最近はようやく人並みに体育の授業にも参加できるようになった。"},{"spoiler":false,"text":"落ち着いた性格をしていて、第一印象では年上に思われることが多い。"},{"spoiler":false,"text":"友達との会話は聞き役になることが多く、いろいろな相談を受けたりすることも多い。"},{"spoiler":false,"text":"恋愛感情には疎く、人の恋愛事情を聞いてもあまりピンと来ない。"}],"source":"bangumi","sourceCharacterId":"77121"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3de614b2fa6705c427a08d3ccf2516bc5ccd2cc8428b1aefe2ea7bf67aa0a603.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46443f795b5597b8bc2ebd131ae1c67517fae96793f3be197fa59991dc06a114.webp","width":79,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間宮菜南子","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:303900:77121:15995:1","source":"bangumi"}]},{"characterId":"char_c90580","characterName":"二階堂 梨枝","sourceIds":{"bangumi":[{"characterId":"77122","match":"exact-normalized-name-in-linked-work","subjectId":"303900"}],"egsCharacterIds":["22559"],"vndbCharacterId":"c90580"},"originalCharacterName":"二階堂 梨枝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Second-grade student at St. Ruri and President of the karate club. She's Maika's childhood friend as well as her best friend and one of the few people who know Maika's secret."},{"spoiler":false,"text":"Since their grandparents were friends, the two of them used to play together when they were little."},{"spoiler":false,"text":"Since she was little she has always been very active so she cannot stay still for long. Despite being the complete opposite of Maika, for some strange reason they got along very well since they met."},{"spoiler":false,"text":"At first she began to learn Karate in order to protect Maika, but became addicted to it until she got the black belt."},{"spoiler":false,"text":"Despite being cheerful and giving the impression of being a person of strong character, she cries easily when listening to sad stories. Also, people tend to rely on her because they see her as someone gentle and kind."},{"spoiler":false,"text":"She likes cute and beautiful things like accessories and stuffed animals, however she believes that this does not go with her so she keeps it a secret."}],"source":"vndb","sourceCharacterId":"c90580"},{"segments":[{"spoiler":false,"text":"舞果とは幼なじみで親友。"},{"spoiler":false,"text":"舞果の事情（学園長の孫ということ）を知っている数少ない人物。"},{"spoiler":false,"text":"舞果とは祖父同士が友人で、幼い頃からよく一緒に遊んでいた。"},{"spoiler":false,"text":"子供の頃から活発で、じっとしているのは苦手なタイプ。"},{"spoiler":false,"text":"舞果とはわりと正反対のタイプなのだが、妙に気が合い、出会った頃から何かと一緒にいる。"},{"spoiler":false,"text":"病弱な舞果を守りたいという気持ちから空手を習い始めたところ、ハマってしまい段を取るまでになった。"},{"spoiler":false,"text":"快活で男勝りな印象が強いけれども、涙もろい性格で、悲しい話を聞いたり感動したりするとすぐに涙が零れてしまう。"},{"spoiler":false,"text":"また、情に厚く、面倒見がいいため、何かと周りから頼りにされる存在。"},{"spoiler":false,"text":"綺麗なもの・可愛いものが好きで、小物やぬいぐるみを見るのも好きなのだが、自分には似合ってないと思っていて、周りには言ってない。"}],"source":"egs","sourceCharacterId":"22559","sourceWorkId":"29447","spoiler":false},{"segments":[{"spoiler":false,"text":"聖瑠璃女学園2年生。"},{"spoiler":false,"text":"空手部部長。"},{"spoiler":false,"text":"舞果とは幼なじみで親友。"},{"spoiler":false,"text":"舞果の事情（学園長の孫ということ）を知っている数少ない人物。"},{"spoiler":false,"text":"舞果とは祖父同士が友人で、幼い頃からよく一緒に遊んでいた。"},{"spoiler":false,"text":"子供の頃から活発で、じっとしているのは苦手なタイプ。"},{"spoiler":false,"text":"舞果とはわりと正反対のタイプなのだが、妙に気が合い、出会った頃から何かと一緒にいる。"},{"spoiler":false,"text":"病弱な舞果を守りたいという気持ちから空手を習い始めたところ、ハマってしまい段を取るまでになった。"},{"spoiler":false,"text":"快活で男勝りな印象が強いけれども、涙もろい性格で、悲しい話を聞いたり感動したりするとすぐに涙が零れてしまう。"},{"spoiler":false,"text":"また、情に厚く、面倒見がいいため、何かと周りから頼りにされる存在。"},{"spoiler":false,"text":"綺麗なもの・可愛いものが好きで、小物やぬいぐるみを見るのも好きなのだが、"},{"spoiler":false,"text":"自分には似合ってないと思っていて、周りには言ってない。"}],"source":"bangumi","sourceCharacterId":"77122"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d02f454acbb768aae57914f57e6c1c3f104086ffb039cccc9abd4b5d80083fdb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a70f4ce1c5f7e41ceaa2f0caf9310f625319855dcc02c92d184314858526e305.webp","width":112,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:303900:77122:11646:1","source":"bangumi"}]},{"characterId":"char_c90581","characterName":"衣織 紗來","sourceIds":{"bangumi":[{"characterId":"77123","match":"exact-normalized-name-in-linked-work","subjectId":"303900"}],"egsCharacterIds":["22560"],"vndbCharacterId":"c90581"},"originalCharacterName":"衣織 紗來","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Second-grade student, president of the Mechanical Engineering club and Rie's cousin."},{"spoiler":false,"text":"As a kid she often went to Rie's place to play, around that time she met Maika and strangely she became attached to her, for that reason she decided to enroll at St. Ruri. Also, there's a part of her that sees Rie as a rival when it comes to Maika and thanks to that there's always small quarrels between them."},{"spoiler":false,"text":"Sara has a mischievous personality and takes pride at his abilities at mechanics and handicraft, being naturally good at remodeling mac