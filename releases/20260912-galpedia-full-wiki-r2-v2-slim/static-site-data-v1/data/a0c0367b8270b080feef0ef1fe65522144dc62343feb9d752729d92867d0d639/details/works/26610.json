:{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24cab6af5ad8e4653bb2023e0352ffd0ee69b3fbc2444a9ca31bef6b299c3775.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa6d350661316084eeb955998ba7116fa7924b91e114326cee8f3fcc61bb0eb3.webp","width":225,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山本希望","creatorId":"vndb:s1455","sourcePersonId":"vndb:s1455","canonicalEntityId":"vndb:s1455","name":"山本 希望","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:239990:61540:7147:1","source":"bangumi"}]},{"characterId":"char_vndb_c68619","characterName":"橘木 啓輔","sourceIds":{"vndbCharacterId":"c68619"},"originalCharacterName":"橘木 啓輔","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Keisuke is a young man who has just entered the working world. Recently, he joined a company that sells liquors by mail order to foreign countries such as Canada, the United States and especially all of Latin America. To do this, he developed a certain fluency in English and Spanish. He is satisfied with his life as an office employee, even if he is sexually harassed by his voluptuous manager."},{"spoiler":false,"text":"He has not had much contact with people since he has lived alone in his own apartment (not having even seen his childhood friend Ayame for a long time), apart from his colleagues and the boss of the café he frequents regularly, only his younger sister Riho will visit him often to see if he is doing well."}],"source":"vndb","sourceCharacterId":"c68619"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/576c1fcc75be081de95e05a911f30e626214db1af579f55c9892801d1c07007a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0056c0b70de39bf41217ea9565ee745d6ca54730502d38091941f4aa133dbc9.webp","width":211,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c85082","characterName":"マスター","sourceIds":{"vndbCharacterId":"c85082"},"originalCharacterName":"マスター","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Master is the boss of the \"Café River Moon\" in which Keisuke is used to going most of his lunches and they both consider themselves friends. Seeing that his Café was not popular and having his credit in the red, he decided to transform his Café into a ''Maid Café'' in order to attract customers and fill his coffers."},{"spoiler":false,"text":"He was once married and he describes this period of his life as very happy but his wife eventually left him."},{"spoiler":true,"text":"Despite his divorce, it is said that he still keeps in touch with his ex-wife and that they see each other regularly. According to him, she forbids him to see other girls. It is suggested that they are still in love with each other."}],"source":"vndb","sourceCharacterId":"c85082"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eeb20569d8bb5e907a62c74e209f1cbc4c19441622802625326b87fb6e50d379.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e646f69cc8915f3de95c670e0fcf7500c6d592fdc05aaf2e294b5e4fd5d583b.webp","width":189,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c85083","characterName":"社長","sourceIds":{"vndbCharacterId":"c85083"},"originalCharacterName":"社長","characterNameSource":null,"role":"side",