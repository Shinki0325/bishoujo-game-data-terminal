88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"潜在的な痴漢願望を持つ男女を集めて痴漢・痴女サークルを作って活動する謎の美女。28歳。"},{"spoiler":false,"text":"主人公の中に秘める痴漢願望を見抜いて、サークルへ入るよう勧誘する。"},{"spoiler":false,"text":"行き帰りの電車の中で主人公に近づき、痴漢をする快感・される快感を教え込んでいく。"}],"source":"egs","sourceCharacterId":"15294","sourceWorkId":"12430","spoiler":false},{"segments":[{"spoiler":false,"text":"大胆な格好で電車に乗り込み、痴女行為を行っている謎の美女。痴漢をしたがっている・ 潜在的に痴漢願望を持っている男女を集めて、痴漢・痴女サークルを作り、活動している。"},{"spoiler":false,"text":"純一の内に秘めている痴漢願望を見抜き、サークルに入るよう勧誘してくる。"},{"spoiler":false,"text":"行き帰りの電車の中で純一に近づき、痴漢をする快感・される快感を教えこんでいく。"}],"source":"bangumi","sourceCharacterId":"210290"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8dd9c845ef506b31345b7b6a0dfcd4763feafe010dfe1c523aa6969681679fe6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f724d50851e964e7dfdd413974eb7959bf52bf0792723431baceb5149cc82e0.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白井 綾乃","creatorId":"vndb:s665","sourcePersonId":"vndb:s665","canonicalEntityId":"vndb:s665","name":"あらい しずか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18602","source":"vndb"}]},{"characterId":"char_c35968","characterName":"坪内 彩花","sourceIds":{"bangumi":[{"characterId":"210292","match":"exact-normalized-name-in-linked-work","subjectId":"475750"}],"egsCharacterIds":["15295"],"vndbCharacterId":"c35968"},"originalCharacterName":"坪内 彩花","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"22"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","