age":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fa8d39f043fda21afd4e6d10e34dfa157b540a1de6cc0988ba07d0e50bf0507.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d52076d8637eec2591fbf1330ce883e969971a793c644200249783071a77c9dd.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c73978","characterName":"古雅 たつき","sourceIds":{"vndbCharacterId":"c73978"},"originalCharacterName":"古雅 たつき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A classmate of the protagonist. A member of the track and field club. She respects Akira, who was her senior in the club. She is always checking to make sure the protagonist doesn't hurt Akira. The protagonist and he have been best friends since elementary school, and they were quite close, but at some point, she started to look down on the protagonist. She is quite stubborn."}],"source":"vndb","sourceCharacterId":"c73978"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/817169a22117d62a6593b07eacb42fef5b08aba8caba24476fbd2f45212e32b3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e7a2870b37ea334a216ddf2380c0b0c1580cce4dfdc83c3008e6b64608577ab.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c73979","characterName":"杉浦 真尋","sourceIds":{"vndbCharacterId":"c73979"},"originalCharacterName":"杉浦 真尋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's cousin. She is good at all kinds of housework, especially cooking. She is selfish and self-centered. She is true to her own feelings and ideas. She has a sharp tongue. She hangs out at the protagonist's house when he starts living alone, and acts like she owns the place."}],"source":"vndb","sourceCharacterId":"c73979"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/975411675ea17b665635636feef089791d0bb29357349bf65eed4d25c86640be.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e0c324bf9e48111345ff56cc2aa25c43e227955dd9efd154ad5d373dd007df2.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c73980","characterName":"八坂 悠","sourceIds":{"vndbCharacterId":"c73980"},"originalCharacterName":"八坂 悠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a classmate of the protagonist, but they have no connection. She always looks sleepy and spaced out. She doesn't say much, and is apathetic, dismissing everything with \"somehow.\" However, she is surprisingly sulky, as seen in his case when she underlines obscene words in the dictionary. She likes the sunny benches on the rooftop, and the two get to know each other after she hits the protagonist in the solar plexus while she is sleeping there. Strangely, they are on the same wavelength, and the two become good friends, spending time spaced out together on the rooftop or in the park."}],"source":"vndb","sourceCharacterId":"c73980"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/257e05479c75b0f15168067a9b47f7ecc7db907d62f36b747f711d41250d5f2b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2bdedacfbd6dc2e7c87c9179899b1e66af00597c0763acc630492d03b184f0a6.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c73981","characterName":"天ヶ瀬 琳子","sourceIds":{"vndbCharacterId":"c73981"},"originalCharacterName":"天ヶ瀬 琳子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A new teacher in her first year of working life. Clumsy and foolish. When she makes a mistake, she just gets flustered and is always apologizing repeatedly. She has a baby face and is short, so he is often mistaken for someone else, which bothers him a lot. She goes home as soon as he finishes work."}],"source":"vndb","sourceCharacterId":"c73981"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0899e15d235884df95a1af6bc401387b7b451fdf0ae589f4629197f82aad5f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93b9af26b98ff9b9d3ff941f68a0222db5750a70c2ab9c993d9f79a9a9107231.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c73982","characterName":"神無月 さつき","sourceIds":{"vndbCharacterId":"c73982"},"originalCharacterName":"神無月 さつき","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20df0285d253b36dd682164656b64596370c2ea7269489a2c8857b8b59826b89.webp","fallbackUrl":"https://wiki-assets.bi