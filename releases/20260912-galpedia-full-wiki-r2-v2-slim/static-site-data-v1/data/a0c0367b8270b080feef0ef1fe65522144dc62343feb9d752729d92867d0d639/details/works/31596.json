es and behavior are disgusting."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c100179"},{"segments":[{"spoiler":false,"text":"リディアの娘で、優秀なオペレーター。"},{"spoiler":false,"text":"母親譲りの才能を持っているのか、よく気が利くし感も鋭い。"},{"spoiler":false,"text":"周囲の人からは優秀な士官と評されており、自分も母親みたいな立派な軍人になることを目標にして、日々努力をしている。"},{"spoiler":false,"text":"主人公のことはあまり信用しておらず、更に目つきや言動がいやらしいと思っており、毛嫌いしている。"}],"source":"egs","sourceCharacterId":"23736","sourceWorkId":"31596","spoiler":false},{"segments":[{"spoiler":false,"text":"リディアの娘で、優秀なオペレーター。"},{"spoiler":false,"text":"母親譲りの才能を持っているのか、よく気が利くし感も鋭い。"},{"spoiler":false,"text":"周囲の人からは優秀な士官と評されており、"},{"spoiler":false,"text":"自分も母親みたいな立派な軍人になることを目標にして、日々努力をしている。"},{"spoiler":false,"text":"主人公のことはあまり信用しておらず、更に目つきや言動がいやらしいと思っており、毛嫌いしている。"}],"source":"bangumi","sourceCharacterId":"134213"}],"profileFacts":[{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"23736","sourceWorkId":"31596","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"23736","sourceWorkId":"31596","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"166 cm","valueContext":null,"source":"egs","sourceCharacterId":"23736","sourceWorkId":"31596","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"23736","sourceWorkId":"31596","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"23736","sourceWorkId":"31596","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73c7017521c767f3fefe7b4c7facbcdd053e2d8feed80faccb3e0423e40cfbb5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/0511ef3c52c9fd55208db01817516e4400308b602d074a3d9864c9977eff0c7b.webp","