"vndb:s44975","canonicalEntityId":"vndb:s44975","name":"ほつみ真琴","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:22365","source":"vndb"},{"creditedName":"林 ゆみこ","creatorId":"vndb:s46455","sourcePersonId":"vndb:s46455","canonicalEntityId":"vndb:s46455","name":"林 ゆみこ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:22366","source":"vndb"},{"creditedName":"立花 みづき","creatorId":"vndb:s53978","sourcePersonId":"vndb:s53978","canonicalEntityId":"vndb:s53978","name":"立花 みづき","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:22367","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c11549","characterName":"ひなた","sourceIds":{"vndbCharacterId":"c11549"},"originalCharacterName":"ひなた","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A dog Mimikko. Sachi's younger sister. She is the same breed of Mimikko as Sachi, with the only difference being their hair colors. \"Pure energy\" is the only way to describe her. Hinata is frequently seen around Sachi or attaching herself to Jun's face. She commonly causes trouble for Jun with her energetic behavior. She also calls Jun \"Master\", but her reason for calling him such is due to her sister's influence. At the beginning of the game, she is \"Young Hinata\", the smaller and childish version. During the course of the game, she grows up into \"Hinata\"."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c11549"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44bb047cd03c40f56f889a71f0ab242a21569128e64f1dd10577dcef7f1d2e70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a889c14bf541895e9a4770fda6fffb4aa37e5bf9e756459580a0b5e380ee0c96.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金松 由花","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11382","source":"vndb"}]},{"characterId":"char_vndb_c11550","characterName":"さち","sourceIds":{"vndbCharacterId":"c11550"},"originalCharacterName":"さち","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A dog Mimikko. Hinata's older sister. Sachi is Jun's love interest early in the game. She is very soft-spoken and acts humbly, often refusing to accept praise. She calls Jun \"Master\" because of his behavior. She speaks highly of Jun, so much that it influenced her younger sister, Hinata, to copy her and call Jun \"Master\" as well."},{"spoiler":true,"text":"At the end of Chapter one (relatively early in the game), she is killed by a fatal illness."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c11550"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37a3c35aa583b6c8b3432ce3eacafd64f874c29435ca864b556ca2e1c816a614.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/384978356015c58633ea31b8d0a28d33b0786d93873a49f0591fda5373d951f0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大野 まりな","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11385","source":"vndb"}]},{"characterId":"char_vndb_c11551","characterName":"とばり","sourceIds":{"vndbCharacterId":"c11551"},"originalCharacterName":"とばり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A cat Mimikko that Jun helps while he is downtown. Tobari is overly-serious and tries to maintain her cool at all times. She becomes a bit attached to Jun after he helps her. The typical tsundere character, her background is unknown, so she is mysterious to the characters."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c11551"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6a97366ab12566a7780443403855cf6e2f5b7fbb413d0ad51b10390d79378ff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf5bbccec7c68fbd18f973e2751f13ae36ea0560e91386e3c0a0fbedc5077d82.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大波 こなみ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11380","source":"vndb"}]},{"characterId":"char_vndb_c11552","characterName":"結城 潤","sourceIds":{"vndbCharacterId":"c11552"},"originalCharacterName":"結城 潤","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist. While training to become a Trimmer, he begins to realize his latent feelings for Sachi. He ultimately joins Midou at the 'FRIENDS' pet store. He is called \"Master\" by Sachi and Hinata at the beginning of the game."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c11552"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cc7abb29b003081078f08766ceec605c6123e38fb6a21a9db60ff9a3c6084d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e94daa24b3f2cebdc2966af0813eb0b2ee139f3fd0edef72327a869a5e88331.webp","width":191,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c11553","characterName":"御堂 拓也","sourceIds":{"vndbCharacterId":"c11553"},"originalCharacterName":"御堂 拓也","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Jun's Kansai-accented sardonic best friend. Although he uses Kansai dialect, he wasn't born in Kansai. He tends to be bullied a lot by Jun. Midou helps Jun to become a qualified Trimmer. He takes the same course as Jun, but his goal isn't to become a Trimmer."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c11553"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/6113f41dc5702a0cd1bef3dcb9869012ed8bf3ecf107c0a780ea412f9efd8704.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c1713e72d66f413737028c98d244b18b2a236faa77e988956ba1013bef56e6d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野島 健児","creatorId":"vndb:s380","sourcePersonId":"vndb:s380","canonicalEntityId":"vndb:s380","name":"野島 健児","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11381","source":"vndb"}]},{"characterId":"char_vndb_c11554","characterName":"結城 美和","sourceIds":{"vndbCharacterId":"c11554"},"originalCharacterName":"結城 美和","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Jun's sister. She frequently helps Jun by preparing meals. She is also a tomboy. Midou may even have a crush on her."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c11554"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/2615b80ef498de77ab660edd568257cff50dcd9ef70a1775c5ca0d19fa600d8b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6db56b3ce59c9666e02f5c37fb23cd928ee8f2040fde692e2baf3bdfa44dc13b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MARIO","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11384","source":"vndb"}]},{"characterId":"char_vndb_c11555","characterName":"ひなた (幼い頃)","sourceIds":{"vndbCharacterId":"c11555"},"originalCharacterName":"ひなた (幼い頃)","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A dog Mimikko. Sachi's younger sister. She is the same breed of Mimikko as Sachi, with the only difference being their hair colors. \"Pure energy\" is the only way to describe her. Hinata is frequently seen around Sachi or attaching herself to Jun's face. She commonly causes trouble for Jun with her energetic behavior. She also calls Jun \"Master\", but her reason for calling him such is due to her sister's influence. At the beginning of the game, she is \"Young Hinata\", the smaller and childish version. During the course of the game, she grows up into \"Hinata\"."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c11555"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c9f5f3c39c45e71297b27b31c9d4b1dad7e2696db7731b4853eea89f39757bdb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a78ae013a1315b57d228728b98958ef463142d40f3c1133a800d0061fc15724b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金松 由花","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11383","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:828","sourceCompanyId":"egs:brand:828","canonicalEntityId":"egs:brand:828","name":"KLEIN","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:3532:828","source":"egs"},{"companyId":"vndb:p479","sourceCompanyId":"vndb:p479","canonicalEntityId":"vndb:p479","name":"クライン","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:2776:v1272","source":"vndb"},{"companyId":"vndb:p63","sourceCompanyId":"vndb:p63","canonicalEntityId":"vndb:p63","name":"データムポリスター株式会社","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:2777:v1272","source":"vndb"},{"companyId":"vndb:p479","sourceCompanyId":"vndb:p479","canonicalEntityId":"vndb:p479","name":"クライン","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:2778:v1272","source":"vndb"},{"companyId":"vndb:p479","sour