source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"普段はアミリの愛称で呼ばれる。"},{"spoiler":false,"text":"首からぶら下げた懐中時計がトレードマークでいつも肌身離さず携帯している。"},{"spoiler":false,"text":"主人公がその時計に手を付けたことが原因で、"},{"spoiler":false,"text":"外見年齢が何かの拍子にコロコロと変化するようになってしまう。"},{"spoiler":false,"text":"『時間の異常』を察知し異常箇所を修復できる能力を持っているが、"},{"spoiler":false,"text":"なぜなのかは記憶喪失のため本人にもわからない。"},{"spoiler":false,"text":"これはアミリが小さくなったときの姿。"},{"spoiler":false,"text":"この形態のときが最も感情の露出が激しく、"},{"spoiler":false,"text":"思ったままのことをすぐに口にする。"},{"spoiler":false,"text":"また自己中心的な面が肥大化しわがままな態度をとりやすくなり、"},{"spoiler":false,"text":"かまってほしがって甘えてくることも。"},{"spoiler":false,"text":"子ども扱いされることを極度に嫌う。"}],"source":"egs","sourceCharacterId":"16981","sourceWorkId":"9972","spoiler":false},{"segments":[{"spoiler":false,"text":"本来の姿のアミリ。"},{"spoiler":false,"text":"性格自体に変わりはないが、本音を胸中に隠したり、"},{"spoiler":false,"text":"自分に向けられた言葉を素直に受け止められなかったりといった面が出てくる。"},{"spoiler":false,"text":"主人公と大体同年齢の形態ということもあり、"},{"spoiler":false,"text":"接し方もクラスメイトの女の子のように対等でくだけたものになる。"}],"source":"egs","sourceCharacterId":"16982","sourceWorkId":"9972","spoiler":false},{"segments":[{"spoiler":false,"text":"時間が進み、大人になったときの姿。"},{"spoiler":false,"text":"分別と思慮深さが身につき、精神的に余裕を持った雰囲気を漂わせる。"},{"spoiler":false,"text":"とはいっても持ち前の性分が変わるわけではないので、"},{"spoiler":false,"text":"やっぱりいろんなことに首を突っ込んでいく。"},{"spoiler":false,"text":"見た目が萩介より大人なことに気を良くし、"},{"spoiler":false,"text":"子ども扱いやお色気攻撃などでからかってきたりするようになる。"}],"source":"egs","sourceCharacterId":"16983","sourceWorkId":"9972","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02f77b340f347a73dcba8476d3a736c23ef24c18af5af6fc4b56db737963e52b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd479363bb254953bacf759fb9608338f6dc33310396b24d4950dc5f2844241c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"まき いづみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11247","source":"vndb"}]},{"characterId":"char_c41680","characterName":"鹿神 ゆずな","sourceIds":{"bangumi":[{"characterId":"65551","match":"exact-normalized-name-in-linked-work","subjectId":"16990"}],"egsCharacterIds":["16984"],"vndbCharacterId":"c41680"},"originalCharacterName":"鹿神 ゆずな","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"萩介の幼馴染。"},{"spoiler":false,"text":"萩介のことを憎からず思っているが、女友達以上に見られてはいない。"},{"spoiler":false,"text":"何気なく借りたギャルゲーをプレイして以来、"},{"spoiler":false,"text":"自身の持つ幼馴染属性に気づき、理想の幼馴染キャラになろうと奮戦している。"},{"spoiler":false,"text":"見た目は努力の甲斐あってか家庭的な少女に見えるが、実際は豪快で非常に大雑把な姉御肌。"},{"spoiler":false,"text":"受けた借りは必ず返すし、大切な人たちのためなら体を張ることも厭わない漢らしい魂の持ち主である。"},{"spoiler":false,"text":"その荒い気質のせいか、リトル形態のアミリと本気で口ゲンカしたりと大人気ない部分がある。"},{"spoiler":false,"text":"意外にも家事は一通りこなせるが、やはり大雑把。（四角い部屋を丸く掃く、を体現している）"},{"spoiler":false,"text":"幼馴染らしさを演出するためリボンをつけているが、あまり似合ってはいない。"}],"source":"egs","sourceCharacterId":"16984","sourceWorkId":"9972","spoiler":false},{"segments":[{"spoiler":false,"text":"萩介の幼馴染。萩介のことを憎からず思っているが、女友達以上に見られてはいない。"},{"spoiler":false,"text":"何気なく借りたギャルゲーをプレイして以来、自身の持つ幼馴染属性に気づき、理想の幼馴染キャラになろうと奮戦している。"},{"spoiler":false,"text":"見た目は努力の甲斐あってか家庭的な少女に見えるが、実際は豪快で非常に大雑把な姉御肌。"},{"spoiler":false,"text":"受けた借りは必ず返すし、大切な人たちのためなら体を張ることも厭わない漢らしい魂の持ち主である。"},{"spoiler":false,"text":"その荒い気質のせいか、リトル形態のアミリと本気で口ゲン力したり大人気ない部分がある。"},{"spoiler":false,"text":"意外にも家事は一通りこなせるが、やはり大雑把。"},{"spoiler":false,"text":"（四角い部屋を丸く掃く、を体現している）"},{"spoiler":false,"text":"幼馴染らしさを演出するためリボンをつけているが、あまり似合ってはいない。"}],"source":"bangumi","sourceCharacterId":"65551"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"ur