didate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『アルコバレーノ号』からの刺客として、ジェシカの前に立ちはだかる少女。"},{"spoiler":false,"text":"幼いころ親に捨てられ、野垂れ死にそうな所をノワールに拾われた経歴を持つ。"},{"spoiler":false,"text":"そのためか、ノワールに強い忠節を尽くす。"},{"spoiler":false,"text":"必死の努力の末にギャンブル知識や、ギャンブル客船内庶務知識、礼儀作法知識、性知識その他諸々を独学で身に付け、今やその若さでノワールの右腕（運営の補佐や使い走り）のような立場にいる。"},{"spoiler":false,"text":"しかし、基本的な義務教育を受けていないために、若干知性や常識に欠ける所があり、全ての判断基準が「ノワールの役に立てるか」のため、一般人から見ればおかしく見える行動も平気で取る。"},{"spoiler":false,"text":"ノワールが彼女を単なる手駒としてしか見ていないのか、あるいは右腕、それともそれ以上の存在としてみているのかは不明。"},{"spoiler":false,"text":"ノワールにつけてもらった「ヴィオレッタ」という名前を気に入っており、特別視している。本名は不明。"},{"spoiler":false,"text":"「ヴィオレッタ」の名前はノワールにしか呼ばせず、他の者には「ヴィオ」と呼ばせている程。"}],"source":"egs","sourceCharacterId":"3000","sourceWorkId":"19986","spoiler":false},{"segments":[{"spoiler":false,"text":"ギャンブル客船・アルコバレーノ号からの刺客としてジェシカの前に立ちはだかる少女。"},{"spoiler":false,"text":"幼いころ親に捨てられ、野垂れ死にそうなところをノワールに拾われた経歴を持つ。"},{"spoiler":false,"text":"そのためか、ノワールに強い忠節を尽くす。"},{"spoiler":false,"text":"必死の努力の末にギャンブル知識や客船内庶務知識、礼儀作法、性知識その他諸々を独学で身に付け、今やその若さでノワールの右腕 （運営の補佐や使い走り） のような立場にいる。"},{"spoiler":false,"text":"しかし、基本的な義務教育を受けていないために、若干知性や常識に欠けるところがあり、すべての判断基準が “ノワールの役に立てるか” のため、一般人から見ればおかしく見える行動も平気で取る。"},{"spoiler":false,"text":"ノワールが彼女を単なる手駒として見ているのか、あるいは右腕、それともそれ以上の存在として見ているのかは不明。"},{"spoiler":false,"text":"ノワールにつけてもらった “ヴィオレッタ” という名前を気に入っており、特別視している。 本名は不明。"},{"spoiler":false,"text":"“ヴィオレッタ” の名前はノワールにしか呼ばせず、他の者には “ヴィオ” と呼ばせているほど。"}],"source":"bangumi","sourceCharacterId":"173342"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eebfd7bbee45c7174d3db9cf13be3e428375da938509dfceeb2e930c1a32279f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a6b3df6e12ed7dcf34501b001a5bfe160b863ffd7241708d299139c790add15.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:181312:173342:6351:1","source":"bangumi"}]},{"characterId":"char_c23526","characterName":"ミリア＝フェリーチェ","sourceIds":{"bangumi":[{"characterId":"173343","match":"exact-normalized-name-in-linked-work","subjectId":"181312"}],"egsCharacterIds":["3001"],"vndbCharacterId":"c23526"},"originalCharacterName":"ミリア＝フェリーチェ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"105"},"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"行方不明のジェシカの母親。"},{"spoiler":false,"text":"ギャンブルの神に見初められたとしか思えない程の超幸運を持ち、それを御しきる腕を持つ、伝説級のギャンブラーとして名が知られていた。"},{"spoiler":false,"text":"そのためか、彼女を手に入れる事ができれば、『永遠の幸運』を得られるという噂までまことしやかに流れていた。"},{"spoiler":false,"text":"その噂が流れるようになってからは、パートナーとなって欲しいという声は後を絶たなかった。"},{"spoiler":false,"text":"それは年々エスカレートしていき、とうとうギャンブラー同士の間で、彼女を取り合っての血なまぐさい事件まで起こるようになっていくようになる。"},{"spoiler":false,"text":"人死にまで出かねない状況を懸念したミリアは、自らギャンブル界を去った。"},{"spoiler":false,"text":"そしてその後に出会った男性と結婚して子どもをもうけ、ひっそりと暮らしていた……はずであった。"},{"spoiler":false,"text":"数年後。彼女は再びギャンブルの世界へと戻ってきた。"},{"spoiler":false,"text":"……アルコバレーノ号にて開かれるギャンブル大会の『賞品』となって。"},{"spoiler":false,"text":"もともとの性格は若くして貫禄のある、落ち着いた女性。"},{"spoiler":false,"text":"ギャンブルに対しては楽しむ事を一番の目標としている。"},{"spoiler":false,"text":"もちろん、勝ちを目指す事がギャンブルの面白さなので、楽しければ負けても良いなどというのとは別。"},{"spoiler":false,"text":"『勝った上で楽しむ』これが彼女の信条。"}],"source":"egs","sourceCharacterId":"3001","sourceWorkId":"19986","spoiler":false},{"segments":[{"spoiler":false,"text":"行方不明のジェシカの母親。"},{"spoiler":false,"text":"ギャンブルの神に見初められたとしか思えないほどの超幸運を持ち、それを御しきる腕を持つ伝説級のギャンブラーとして名が知られていた。"},{"spoiler":false,"text":"そのためか、彼女を手に入れることができれば “永遠の幸運” を得られるという噂まで、まことしやかに流れていた。"},{"spoiler":false,"text":"その噂からパートナーになってほしいという声は後を絶たず、次第に彼女を取り合って血なまぐさい事件まで起きるようになる。"},{"spoiler":false,"text":"人死にまで出かねない状況を懸念したミリアは、自らギャンブル界を去った。"},{"spoiler":false,"text":"そしてその後に出会った男性と結婚して子供をもうけ、ひっそりと暮らしていた……はずであった。"},{"spoiler":false,"text":"数年後。 彼女は再びギャンブルの世界へと戻ってきた。"},{"spoiler":false,"text":"……アルコバレーノ号にて開かれるギャンブル大会の “賞品” となって。"},{"spoiler":false,"text":"もともとの性格は若くして貫禄のある、落ち着いた女性。"},{"spoiler":false,"text":"ギャンブルに対しては楽しむことを一番の目標としている。"},{"spoiler":false,"text":"もちろん、勝ちを目指すことがギャンブルの面白さなので、楽しければ負けても良いなどということはない。"},{"spoiler":false,"text":"“勝った上で楽しむ” これが彼女の信条。"}],"source":"bangumi","sourceCharacterId":"173343"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c7c2c37e0a33bb92f18f75565ba915775b5b7fc76ff7f1cad99a560e9eb084a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6de7ed9dac060f536ae18988d3dbba711dc0b399c1f9eff20ad7c59dba7a4aee.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:181312:173343:10027:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p765","sourceCompanyId":"egs:brand:1121","canonicalEntityId":"vndb:p765","name":"わるきゅ～れ","roleCod