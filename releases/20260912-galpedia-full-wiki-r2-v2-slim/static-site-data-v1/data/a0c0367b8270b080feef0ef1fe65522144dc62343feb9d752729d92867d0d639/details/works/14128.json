reatorId":"vndb:s27497","sourcePersonId":"vndb:s27497","canonicalEntityId":"vndb:s27497","name":"Doddler","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:53540","source":"vndb"},{"creditedName":"Iri","creatorId":"vndb:s29102","sourcePersonId":"vndb:s29102","canonicalEntityId":"vndb:s29102","name":"Iri","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:53541","source":"vndb"},{"creditedName":"産蝶","creatorId":"vndb:s4941","sourcePersonId":"vndb:s4941","canonicalEntityId":"vndb:s4941","name":"産蝶","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:53543","source":"vndb"},{"creditedName":"doubleeleven UpperCut","creatorId":"vndb:s4942","sourcePersonId":"vndb:s4942","canonicalEntityId":"vndb:s4942","name":"doubleeleven UpperCut","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:53544","source":"vndb"}]},"cast":[{"characterId":"char_c8871","characterName":"ミルク・エリオット","sourceIds":{"bangumi":[{"characterId":"62226","match":"exact-normalized-name-in-linked-work","subjectId":"22244"}],"egsCharacterIds":["11586"],"vndbCharacterId":"c8871"},"originalCharacterName":"ミルク・エリオット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Queen of the Big Breasts Tribe."},{"spoiler":false,"text":"Has a calm personality and cries at the slightest thing."},{"spoiler":false,"text":"Her personality is not really suited to being a ruler, but she inherited the role via her royal bloodline."},{"spoiler":false,"text":"In the palace, she's treated less like a queen and more like a mascot by those around her. All of the ministers are loyal to Milk, as by gathering around her and holding true power over the kingdom, they are able to maintain equal footing with the Flat Chests Tribe."},{"spoiler":false,"text":"Milk herself believes she is unfit to be queen, so she does her best to try to help, but is always making ditzy mistakes and has never managed to be helpful."},{"spoiler":false,"text":"However, by consuming alcohol, her true Queen's power and personality are revealed."},{"spoiler":false,"text":"From Mangagamer"}],"source":"vndb","sourceCharacterId":"c8871"},{"segments":[{"spoiler":false,"text":"巨乳族の女王。"},{"spoiler":false,"text":"大人しい性格で、ちょっとした事で、すぐ泣いてしまう。"},{"spoiler":false,"text":"およそ女王に適した性格ではないが前の女王の唯一の血縁のため女王に仕立て上げられた。"},{"spoiler":false,"text":"宮廷では女王というより、犬や猫のように周りから可愛がられている。"},{"spoiler":false,"text":"大臣などみんなミルクのことが好きで、ミルクのために一丸となって政治などをしているため、貧乳族と互角に渡り合っている。"},{"spoiler":false,"text":"ミルク自身自分が女王にふさわしくないと思っているので、頑張ってお手伝いしようとするが、ドジっ子的な失敗ばかりして、まともに手伝えたことがない。"},{"spoiler":false,"text":"しかし、アルコールを摂取すると、性格が変わってしまい、違う意味で本当の女王様になる。"}],"source":"egs","sourceCharacterId":"11586","sourceWorkId":"14128","spoiler":false},{"segments":[{"spoiler":false,"text":"大人しい性格で、ちょっとしたことですぐ泣いてしまう。"},{"spoiler":false,"text":"およそ女王に適した性格ではないが、前の女王の唯一の血縁であるため女王に仕立て上げられた。"},{"spoiler":false,"text":"宮廷では女王というより、犬や猫のように周りから可愛がられている。"},{"spoiler":false,"text":"みんなミルクのことが好きで、ミルクのために一丸となり、強力な貧乳族と互角に渡り合っている。"},{"spoiler":false,"text":"ミルク自身、自分が女王にふさわしくないと思っているので頑張ってはいるが、ドジっ子的な失敗ばかりして、仕事を増やしてしまっている。"}],"source":"bangumi","sourceCharacterId":"62226"}],"profileFacts":[{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"11586","sourceWorkId":"14128","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"11586","sourceWorkId":"14128","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":