11946","name":"あおきゅん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:153336","source":"vndb"},{"creditedName":"まろたろ","creatorId":"vndb:s13626","sourcePersonId":"vndb:s13626","canonicalEntityId":"vndb:s13626","name":"まろたろ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:153338","source":"vndb"},{"creditedName":"＃エロティック大島","creatorId":"vndb:s18616","sourcePersonId":"vndb:s18616","canonicalEntityId":"vndb:s18616","name":"＃エロティック大島","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:153341","source":"vndb"},{"creditedName":"Studio Fuji","creatorId":"vndb:s18775","sourcePersonId":"vndb:s18775","canonicalEntityId":"vndb:s18775","name":"Studio Fuji","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:153342","source":"vndb"},{"creditedName":"らくしー","creatorId":"vndb:s19192","sourcePersonId":"vndb:s19192","canonicalEntityId":"vndb:s19192","name":"らくしー","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:153343","source":"vndb"},{"creditedName":"NK","creatorId":"vndb:s19201","sourcePersonId":"vndb:s19201","canonicalEntityId":"vndb:s19201","name":"NK","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:153344","source":"vndb"},{"creditedName":"背景刑事","creatorId":"vndb:s19202","sourcePersonId":"vndb:s19202","canonicalEntityId":"vndb:s19202","name":"背景刑事","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:153345","source":"vndb"},{"creditedName":"玄米爺","creatorId":"vndb:s19203","sourcePersonId":"vndb:s19203","canonicalEntityId":"vndb:s19203","name":"玄米爺","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:153346","source":"vndb"}]},"cast":[{"characterId":"char_c77624","characterName":"皇 綾乃","sourceIds":{"bangumi":[{"characterId":"69137","match":"exact-normalized-name-in-linked-work","subjectId":"267515"}],"egsCharacterIds":["20805"],"vndbCharacterId":"c77624"},"originalCharacterName":"皇 綾乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ayano is Satoru's childhood friend. They have been very close to each other for years but they see each other much less in the last five years because they have not been in the same class since. Having become an otaku/gamer/NEET at a time when she was no longer seeing much of Satoru, her passion for this world worsened when she began to live by herself. Since the beginning of the new school year, Ayano has been sharing her class with Satoru again but she doesn't know it yet because her passion for an online game has made her forget the notion of time and she has been missing classes since the beginning of the school year."},{"spoiler":false,"text":"It is therefore with surprise and joy that she learns from her childhood friend that they are together again, but her joy is short-lived because her long absence from school has attracted the anger of her mother who gives her an ultimatum if she wants to continue living alone..."},{"spoiler":true,"text":"Ayano hides the fact that she is an otaku/gamer/NEET from everyone, only Satoru knows her like that. So in the eyes of others, Ayano is like a pretty princess."},{"spoiler":true,"text":"Ayano is actually an ultra popular girl and has already been confessed many times by an incredible number of boys."}],"source":"vndb","sourceCharacterId":"c77624"},{"segments":[{"spoiler":false,"text":"主人公の幼馴染で、残念なオタク。"},{"spoiler":false,"text":"可愛い女の子が好き。ただし二次元に限る。"},{"spoiler":false,"text":"学園ではオタクであることを隠し、周囲にはごく普通の女の子のように振る舞っている。"},{"spoiler":false,"text":"一応親しい友人たちにはバレていない様子。"},{"spoiler":false,"text":"学園では猫を被っているが、その反動からか自宅では自堕落そのもの。"},{"spoiler":false,"text":"ダボッとしたＴシャツ1枚で過ごすことも日常茶飯事。寒いとどてらは羽織る。"}],"source":"egs","sourceCharacterId":"20805","sourceWorkId":"27428","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼馴染で、残念なオタク。"},{"spoiler":false,"text":"可愛い女の子が好き。ただし二次元に限る。"},{"spoiler":false,"text":"学園ではオタクであることを隠し、"},{"spoiler":false,"text":"周囲にはごく普通の女の子のように振る舞っている。"},{"spoiler":false,"text":"一応親しい友人たちにはバレていない様子。"},{"spoiler":false,"text":"学園では猫を被っているが、その反動からか自宅では自堕落そのもの。"},{"spoiler":false,"text":"ダボッとしたＴシャツ1枚で過ごすことも日常茶飯事。寒いとどてらは羽織る。"},{"spoiler":false,"text":"進学を機に一人暮らしを始めたのだが、"},{"spoiler":false,"text":"自堕落に過ごしすぎたために入学式を忘れており、"},{"spoiler":false,"text":"母親に出された一人暮らしを続けるための条件を達成するために、"},{"spoiler":false,"text":"主人公にしばらく一緒に暮らしてほしいと頼む事になる。"},{"spoiler":false,"text":"「私やるな～さすが私だな～♪」"}],"source":"bangumi","sourceCharacterId":"69137"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37ce7a8ea9070ade65682c51abcbe0d13fe77a2b2d250cc9d1833e59585676ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02a045f4e48d49261abd8153731a31a47efc4220c078e6627fdfe2368cfdd72e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"仙台エリ","creatorId":"vndb:s195","sourcePersonId":"vndb:s195","canonicalEntityId":"vndb:s195","name":"仙台 エリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:267515:69137:4749:1","source":"bangumi"}]},{"characterId":"char_vndb_c82594","characterName":"天戸 悟","sourceIds":{"vndbCharacterId":"c82594"},"originalCharacterName":"天戸 悟","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Satoru is Ayano's childhood friend. As a young man, he was very close to Ayano until they were no longer in the same class for the last five years. An involved and serious student, he is quite appreciated by teachers, even if he is not among the best students in the school. Since the beginning of the new school year, Satoru is back in the same class as Ayano. Only, this one hasn't come to class yet.... It is for this reason, in addition to the proximity of their accommodation, that his teacher asks him to bring his lessons to Ayano as well as to check in on him."},{"spoiler":false,"text":"Arriving in front of her house, Satoru rings the bell and discovers that her friend has become a severe otaku who spends her days playing and watching anime. One thing leads to another, Satoru finds himself becoming Ayano's guardian as well as his cook and housekeeper in order to help his friend achieve her goals..."},{"spoiler":true,"text":"Satoru sometimes works part-time at his father's restaurant where he helps in the kitchen, a place he and Ayano used to frequent a lot when they were children."}],"source":"vndb","sourceCharacterId":"c82594"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95ae7f73b7e7ea91f690853cad2dd3ef0e2154872dc18f718279f2bd218671fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cdd74566f1eaf77167db3162f3559fa7dc12f46c0f4ed0bb627f83f7cc2cd323.webp","width":194,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82595","characterName":"みなと","sourceIds":{"vndbCharacterId":"c82595"},"originalCharacterName":"みなと","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Minato is a classmate of Satoru and Ayano. She is one of the first people in the class to meet Ayano when she returns to class. The two girls quickly became friends with many common interests, such as a game on smartphone."},{"spoiler":false,"text":"Like many, Minato thinks that Ayano is an \"ojousama\" and therefore addresses her with respect."}],"source":"vndb","sourceCharacterId":"c82595"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fbc2e7ebf74e71732fd88d6240c9b966d1d8df0fdfa1dbc15ee9c7971bc8ebf8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c680bf1dcc7905e41028ed8677b1816f66288ae277640cd0e5c7271e92068ff.webp","width":184,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82597","characterName":"五十嵐","sourceIds":{"vndbCharacterId":"c82597"},"originalCharacterName":"五十嵐","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Igarashi is a classmate of Satoru and Ayano. He is quite close to Satoru and are therefore good friends. They often go out with their friends at the arcade game centre."},{"spoiler":false,"text":"Like many, Igarashi thinks that Ayano is an \"ojousama\" and therefore addresses her with respect."}],"source":"vndb","sourceCharacterId":"c82597"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p6066","sourceCompanyId":"egs:brand:781","canonicalEntityId":"vndb:p6066","name":"エンターグラム","roleCodes"