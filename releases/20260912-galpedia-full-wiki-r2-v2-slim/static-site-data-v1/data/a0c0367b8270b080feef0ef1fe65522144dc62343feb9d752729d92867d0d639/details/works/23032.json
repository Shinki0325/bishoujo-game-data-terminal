冷漠个性。"},{"spoiler":false,"text":"虽然本人认为自己是个普通的女子高中生，实际上，那锐利凶狠的目光在不自觉中散发着难以让人靠近的气息。"},{"spoiler":false,"text":"周围的人都将她当成难以相处的人，因此完全没有半个能称为朋友的人。"}],"source":"bangumi","sourceCharacterId":"115991"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"8216","sourceWorkId":"23032","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"8216","sourceWorkId":"23032","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"8216","sourceWorkId":"23032","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c797d054d6f2bf0ebce40e6e5937b12f1fedbdae6cc21819fe322c5736cf524.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/0951b12ed24398ae07fc87ea57f797e9bb3c7ca52d97110db68a515defcda888.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高村優里","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:174559:115991:13512:1","source":"bangumi"}]},{"characterId":"char_vndb_c46248","characterName":"先生","sourceIds":{"vndbCharacterId":"c46248"},"originalCharacterName":"先生","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/699f0da915aa5feac76aa3bfa0c061a3233e44d108910c9d768b622f3c32c700.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/image