acterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"浩助のクラスの担任で、浩助の親友（悪友!?）である政義の姉である女性。"},{"spoiler":false,"text":"西園寺家に並ぶ、藤倉家の分家である柊家の長女で、私立藤乃宮学園数学科担当教員。"},{"spoiler":false,"text":"明るく愛嬌のある女性で、授業の教え方は分かりやすく、また気さくに相談に乗ってくれる為に学生の人気は全教員で筆頭。"},{"spoiler":false,"text":"実家を出て教師になるなど、慌ただしい人生を歩んでいる為、現在彼氏募集中。"}],"source":"egs","sourceCharacterId":"11942","sourceWorkId":"13890","spoiler":false},{"segments":[{"spoiler":false,"text":"浩助のクラスの担任で、浩助の親友 （悪友!?） である政義のお姉さん。"},{"spoiler":false,"text":"西園寺家に並ぶ藤倉家の分家である柊家の長女で、私立藤乃宮学園 数学科担当教員。"},{"spoiler":false,"text":"明るく愛嬌のある女性で、授業の教え方は分かりやすく、また気さくに相談に乗ってくれるために学生の人気は全教員で筆頭。"},{"spoiler":false,"text":"実家を出て教師になるなど慌ただしい人生を歩んでいるためか、現在彼氏募集中。"}],"source":"bangumi","sourceCharacterId":"56131"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c18df4f282b016520dac62bf493f474f1f3a69f2554b83ddc53914f701cc82d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aaf52c06938553ccbd3cf47241e36af1320b3c303f4aaaddafbf022bc00a6a49.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七生 みこと","creatorId":"vndb:s1697","sourcePersonId":"vndb:s1697","canonicalEntityId":"vndb:s1697","name":"七生 みこと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26850","source":"vndb"}]},{"characterId":"char_vndb_c23509","characterName":"西園寺 誠一郎","sourceIds":{"vndbCharacterId":"c23509"},"originalCharacterName":"西園寺 誠一郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflict