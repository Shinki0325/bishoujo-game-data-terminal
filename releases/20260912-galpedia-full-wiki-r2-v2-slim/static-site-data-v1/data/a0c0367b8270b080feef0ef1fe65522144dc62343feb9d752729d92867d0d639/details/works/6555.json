aracterName":"藍沢 小百合","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"皐の双子の姉。"},{"spoiler":false,"text":"気弱で引っ込み思案な性格ゆえに、山吹栖華を中心としたグループのイジメの対象になっているようだ。"},{"spoiler":false,"text":"性格が似ている薫とは非常に仲が良い。"},{"spoiler":false,"text":"妹の所属する水泳部に所属するが、スポーツ万能な妹とは対照的に運動が苦手なため補欠。"}],"source":"egs","sourceCharacterId":"26142","sourceWorkId":"6555","spoiler":false},{"segments":[{"spoiler":false,"text":"藍沢皐とは双子の姉の関係。"},{"spoiler":false,"text":"山吹栖華を中心としたグループから、陰湿な虐めを受けている。"},{"spoiler":false,"text":"頼まれるとイヤとは言えない性格で、それゆえ虐めの対象になってしまっている。"},{"spoiler":false,"text":"薫とは性格的に近く、友人の関係。"},{"spoiler":false,"text":"妹と共に水泳部に所属するが補欠。"}],"source":"bangumi","sourceCharacterId":"93348"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f706e0a83b7cdbf08ce19550897447a05e92114ce9ce3bbde082b1aea1c6ce3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad07746d263d59a07bf7b8e29007e985a8075e51681cc0e1361420342b85bd21.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平松真奈実","creatorId":"vndb:s857","sourcePersonId":"vndb:s857","canonicalEntityId":"vndb:s857","name":"平松 真奈実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197706:93348:19253:1","source":"bangumi"}]},{"characterId":"char_c67211","characterName":"山吹 栖華","sourceIds":{"bangumi":[{"characterId":"93349","match":"exact-normalized-name-in-linked-work","subjectId":"197706"}],"egsCharacterIds":["26143"],"vndbCharacterId":"c67211"},"originalCharacterName":"山吹 栖華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の妹。"},{"spoiler":false,"text":"学生会会長の主人公と、理事長の父親の威光を借りて、傍若無人に振舞う。"},{"spoiler":false,"text":"性格は、非常にきつく、自己中心的でワガママ。"},{"spoiler":false,"text":"いつもはサディスティックで強気な自分を演じているが……。"}],"source":"egs","sourceCharacterId":"26143","sourceWorkId":"6555","spoiler":false},{"segments":[{"spoiler":false,"text":"理事長を父に、学生会会長を兄に持つお嬢様。"},{"spoiler":false,"text":"性格はきつく、自己中心的。藍沢皐を虐めているグループの中心人物。"},{"spoiler":false,"text":"元来の性向はサディストだが、一度貶められると、ずるずる深みにはまっていく。"},{"spoiler":false,"text":"それを理解しているからこそ、強気な自分を演出している。"}],"source":"bangumi","sourceCharacterId":"93349"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a403212d59325db04d4d5385066a36683388008cc34b0abf433d6a4317fbb636.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f373a7cbd7b107794daa2700053545eb02ba38a8e81e8ef5672f343825e062ba.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Rita","creatorId":"vndb:s102","sourcePersonId":"vndb:s102","canonicalEntityId":"vndb:s102","name":"平井 理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197706:93349:5742:1","source":"bangumi"}]},{"characterId":"char_c67212","characterName":"水岸 翠子","sourceIds":{"bangumi":[{"characterId":"93350","match":"exact-normalized-name-in-linked-work","subjectId":"197706"}],"egsCharacterIds":["26144"],"vndbCharacterId":"c67212"},"originalCharacterName":"水岸 翠子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水泳部の顧問を務める校医。"},{"spoiler":false,"text":"表向きは明るく社交的で学生からも人気の高い女性だが、実はマゾ的な性癖を持ち、「犯されたい願望」を抱いているようだ。"},{"spoiler":false,"text":"保健室でオナニーに耽っていたところを、薫に目撃されたことから、ふたりは……。"}],"source":"egs","sourceCharacterId":"26144","sourceWorkId":"6555","spoiler":false},{"segments":[{"spoiler":false,"text":"水泳部の顧問を務める校医。"},{"spoiler":false,"text":"元インターハイ出場経験を持つ実力の持ち主だが、怪我が原因で現役を退くこととなる。"},{"spoiler":false,"text":"表面的な性格は社交的で人気も高い教諭だが、その内側は「犯されたい願望」が疼いている。"},{"spoiler":false,"text":"保健室でオナニーをしているところを、薫に見られるところから、二人は教師と教え子の境界線を越えることとなる。"}],"source":"bangumi","sourceCharacterId":"93350"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47d83f6ffd7fa7e578ee860b130e07eca119da28e5e87b1c7bc0da5232f85e2d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da8c50e1ee3fd8f9e241a50058069fadbd11e455eb9311c011825233f2626ae4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林 和実","creatorId":"vndb:s2892","sourcePersonId":"vndb:s2892","canonicalEntityId":"vndb:s2892","name":"小林 和実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:37189","source":"vndb"}]},{"characterId":"char_vndb_c67207","characterName":"山吹 良治","sourceIds":{"vndbCharacterId":"c67207"},"originalCharacterName":"山吹 良治","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17be1c9788e5435bb8a097a0a0d68ee61b8c009e69660754725c84e0d2cd20d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e311eedad971691a996c0024665ae6e308e5bc6a16bfba42933d6c092a243620.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c67213","characterName":"相澤 相馬","sourceIds":{"vndbCharacterId":"c67213"},"originalCha