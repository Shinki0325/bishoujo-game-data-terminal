ode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:114338","source":"egs"}],"other":[{"creditedName":"姫野珠世","creatorId":"egs:creator:18075","sourcePersonId":"egs:creator:18075","canonicalEntityId":"egs:creator:18075","name":"姫野珠世","detail":"主題歌「Can Know Two Close」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"no-alias-hit","relationId":"egs:work-creator:114337","source":"egs"}]},"cast":[{"characterId":"char_c108274","characterName":"カスタムヒロイン プロフィールタイプ1","sourceIds":{"bangumi":[{"characterId":"145268","match":"exact-normalized-name-in-linked-work","subjectId":"29476"}],"egsCharacterIds":["9113"],"vndbCharacterId":"c108274"},"originalCharacterName":"カスタムヒロイン プロフィールタイプ1","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is an honest and gentle girl with a pure side, longing to be lover-like."},{"spoiler":false,"text":"She is shy, but tries her best to act like a girlfriend."},{"spoiler":false,"text":"Because of her honesty, her words and actions are easily influenced by her emotions, making her an interesting girl who changes her facial expression from time to time."},{"spoiler":false,"text":"When she transfers to a new school, she meets the protagonist, a childhood friend, and confesses her long-time feelings for him, and they become lovers."},{"spoiler":false,"text":"She tries her best to make the protagonist like her more, acting in a healthy manner and striving for a closer romantic relationship."},{"spoiler":false,"text":"translated from DLSite"}],"source":"vndb","sourceCharacterId":"c108274"},{"segments":[{"spoiler":false,"text":"【プロフィールタイプ：明るくて積極的な性格】"},{"spoiler":false,"text":"素直で優しく初々しさが残る彼女。"},{"spoiler":false,"text":"恋人っぽいコトに恥ずかしがりながらも、凄く好きで自ら積極的に雰囲気を作る。"}],"source":"egs","sourceCharacterId":"9113","sourceWorkId":"16520","spoiler":false},{"segments":[{"spoiler":false,"text":"【プロフィールタイプ：明るくて積極的な性格】"},{"spoiler":false,"text":"素直で優しく初々しさが残る彼女。"},{"spoiler":false,"text":"恋人っぽいコトに恥ずかしがりながらも、凄く好きで自ら積極的に雰囲気を作る。"}],"source":"bangumi","sourceCharacterId":"145268"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e4bc44ea027c858c7245da9f1455f0b2e74fa724d171ad47f9f490910e52a29.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08ab0ffa7cbcedb6ed617009d506fd63bda68a7c27391b46ce0937a0b9e4d1c0.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:29476:145268:5936:1","source":"bangumi"}]},{"characterId":"char_c108275","characterName":"カスタムヒロイン プロフィールタイプ2","sourceIds":{"bangumi":[{"characterId":"145269","match":"exact-normalized-name-in-linked-work","subjectId":"29476"}],"egsCharacterIds":["9114"],"vndbCharacterId":"c108275"},"originalCharacterName":"カスタムヒロイン プロフィールタイプ2","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Although generally calm and unaffected, her tone of voice is piercing."},{"spoiler":false,"text":"Her tone is often cold and detached toward those she is not interested in, but when she is talking to the protagonist, she seems to be enjoying his reactions."},{"spoiler":false,"text":"She is not averse to the sweet, romantic atmosphere, but she is a little uncomfortable with it. When she gets into that kind of mood, she runs away to hide her shyness, and ends up coming on to him with a strong attitude."},{"spoiler":false,"text":"At a new school, she reunites with the protagonist, a childhood friend, and confesses her long-time feelings for him. However, during the confession, she flees to hide her embarrassment, and the relationship ends up being a delicate \"lover's demo version\". She is frustrated by her inability to be honest with him, but she really wants to be his actual girlfriend."},{"spoiler":false,"text":"translated from DLSite"}],"source":"vndb","sourceCharacterId":"c108275"},{"segments":[{"spoiler":false,"text":"【プロフィールタイプ：クールで物静かな性格】"},{"spoiler":false,"text":"クールで歳の割に大人びている彼女。"},{"spoiler":false,"text":"恋人っぽい空気は嫌いじゃないが少し苦手、露骨に照れても中々認めようとしない。"}],"source":"egs","sourceCharacterId":"9114","sourceWorkId":"16520","spoiler":false},{"segments":[{"spoiler":false,"text":"【プロフィールタイプ：クールで物静かな性格】"},{"spoiler":false,"text":"クールで歳の割に大人びている彼女。"},{"spoiler":false,"text":"恋人っぽい空気は嫌いじゃないが少し苦手、露骨に照れても中々認めようとしない。"}],"source":"bangumi","sourceCharacterId":"145269"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7bbeea9056b9a13ef13e54c2942339f04a249d87e0f3c02eeb9734a15d239ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc8c811334c52e02de78ecfc45386c338822a799c38ea83174ee34293dbf1f8c.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:29476:145269:6016:1","source":"bangumi"}]},{"characterId":"char_c108276","characterName":"二階堂 優","sourceIds":{"bangumi":[{"characterId":"29766","match":"exact-normalized-name-in-linked-work","subjectId":"29476"}],"egsCharacterIds":["9115"],"vndbCharacterId":"c108276"},"originalCharacterName":"二階堂 優","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a sensible wife and wise mother figure who is smart enough to play the adult game. She is a good mother and teacher, although she sometimes has a strong sense of self. She is trusted by the school and students, both male and female."},{"spoiler":false,"text":"She and Sae are sisters, but they are very different in age."},{"spoiler":false,"text":"translated from DLSite"}],"source":"vndb","sourceCharacterId":"c108276"},{"segments":[{"spoiler":false,"text":"大人の駆け引きが出来る頭の良さがある良妻賢母タイプ。"},{"spoiler":false,"text":"思い込みが強い一面もあったりするが、基本的には良い母親であり、良き教師。"},{"spoiler":false,"text":"学園からも学生からも男女問わず信頼が厚い。"},{"spoiler":false,"text":"紗恵とは歳の離れた姉妹。"}],"source":"egs","sourceCharacterId":"9115","sourceWorkId":"16520","spoiler":false},{"segments":[{"spoiler":false,"text":"大人の駆け引きができる頭の良さがある良妻賢母タイプ。"},{"spoiler":false,"text":"思い込みが強い一面もあったりするが、基本的には良い母親であり、良き教師。"},{"spoiler":false,"text":"学園からも学生からも男女問わず信頼が厚い。"},{"spoiler":false,"text":"しかし実はM性癖で、エッチに対しては積極的。"},{"spoiler":false,"text":"主人公を含めた男子学生とは恋愛禁止の校則と立場のこともあり、理性で行動している。"},{"spoiler":false,"text":"紗恵とは歳の離れた姉妹。 ちなみに、同じ学園に勤める教師の夫がいる。"}],"source":"bangumi","sourceCharacterId":"29766"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f514de8655bf131bd26724460c804b6b718062e2db9e03921575d99ddb9754bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b06f9ef67d8ddd87beee8cc9c1ea06b70d03aa5df8aea7756bc394d3ce26d26.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:29476:29766:6131:1","source":"bangumi"}]},{"characterId":"char_c108281","characterName":"二階堂 紗恵","sourceIds":{"bangumi":[{"characterId":"29767","match":"exact-normalized-name-in-linked-work","subjectId":"29476"}],"egsCharacterIds":["9116"],"vndbCharacterId":"c108281"},"originalCharacterName":"二階堂 紗恵","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is basically cheerful and proactive towards everyone. She is caring and friendly, likes to say and do sensational and provocative things, and finds pleasure in toying with people."},{"spoiler":false,"text":"She and Yuu are sisters, but they are very different in age."},{"spoiler":false,"text":"translated from DLSite"}],"source":"vndb","sourceCharacterId":"c108281"},{"segments":[{"spoiler":false,"text":"基本的には誰に対しても明るく積極的。"},{"spoiler":false,"text":"面倒見が良く、人当たりも悪くない、扇情的で挑発的な言動を好み、人を弄ることに楽しさを見出す小悪魔タイプ。"},{"spoiler":false,"text":"優とは歳の離れた姉妹。"}],"source":"egs","sourceCharacterId":"9116","sourceWorkId":"16520","spoiler":false},{"segments":[{"spoiler":false,"text":"基本的には誰に対しても明るく積極的。"},{"spoiler":false,"text":"面倒見が良く、人当たりも悪くない。扇情的で挑発的な言動を好み、人をいじることに楽しさを見出す小悪魔タイプ。"},{"spoiler":false,"text":"今は教育実習生として学園におり、少しふざけた面があるものの、何事も楽しもうとするところや飾らない感じが功を奏して、周囲からの人気は高く、妙にエロチズムを感じる言動から特に男子の人気がある。"},{"spoiler":false,"text":"エロに対しては非常に貪欲、遊び慣れていない相手を責めたがるサド気質で、要は年下キラー。"},{"spoiler":false,"text":"優とは歳の離れた姉妹。 実は彼氏持ちであるという噂も。"}],"source":"bangumi","sourceCharacterId":"29767"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d29cde5ac26b709ab98dde4b04dab2d57c2a329380fb9a703a56c7226e6ed135.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/3854f7319d1af80847982d7b7680a56e9a23fddf4cf03132c58b12a76fad67a4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:29476:29767:6359:1","source":"bangumi"}]},{"characterId":"char_c108282","characterName":"小松菜","sourceIds":{"bangumi":[{"characterId":"29768","match":"exact-normalized-name-in-linked-work","subjectId":"29476"}],"egsCharacterIds":["9117"],"vndbCharacterId":"c108282"},"originalCharacterName":"小松菜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the head of the \"Love Club\" that the main character belongs to, and her nickname is \"Komatsuna,\" although she gets angry when you call her that. She is usually a cheerful, normal girl, with the exception of her cat-like appearance and slightly masculine tone of voice, but in reality she is rough and belligerent."},{"spoiler":false,"text":"She has a complex about her short stature and breasts, so if she is played with or spoken to cheekily, she will resort to violence. She is not very fond of the stiff-necked Chidori."},{"spoiler":false,"text":"translated from DLSite"}],"source":"vndb","sourceCharacterId":"c108282"},{"segments":[{"spoiler":false,"text":"主人公が所属している『恋愛部』の部長呼ぶと怒るがあだ名は「小松菜」。"},{"spoiler":false,"text":"普段は猫をかぶっていて口調が少し男っぽい以外は明るい普通の女の子なのだが、実際は粗暴で且つ好戦的。"},{"spoiler":false,"text":"小さい背丈や胸にコンプレックスがあり、そこを弄られたり生意気な口を聞くと暴力に訴えてくる。"},{"spoiler":false,"text":"堅物な千鳥に苦手意識がある。"}],"source":"egs","sourceCharacterId":"9117","sourceWorkId":"16520","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が所属している “恋愛部” の部長。 呼ぶと怒るが、あだ名は “小松菜”。"},{"spoiler":false,"text":"普段は猫をかぶっていて、口調が少し男っぽい以外は明るい普通の女の子なのだが、実際は粗暴かつ好戦的。"},{"spoiler":false,"text":"小さい背丈や胸にコンプレックスがあり、そこをいじられたり生意気な口をきくと暴力に訴えてくる。"},{"spoiler":false,"text":"カタブツな千鳥に苦手意識がある。"}],"source":"bangumi","sourceCharacterId":"29768"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2253624d5d368c9fca9e31114327b7c6eebcddbc77ec16f49255cd15d264702.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03f26d4440d315e90953c3b8b7176dae13c7201d30d4aaeaeb761d2d90319e27.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:29476:29768:5922:1","source":"bangumi"}]},{"characterId":"char_c108283","characterName":"小鳥遊 千鳥","sourceIds":{"bangumi":[{"characterId":"29769","match":"exact-normalized-name-in-linked-work","subjectId":"29476"}],"egsCharacterIds":["9118"],"vndbCharacterId":"c108283"},"originalCharacterName":"小鳥遊 千鳥","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the chairperson of the class committee. She is a hard-headed, inflexible, and serious person who cannot tolerate anything that is crooked or weak. She has a firm tone of voice and a seamless warrior-like demeanor, but she loves cute things and is very fond of Nanako."},{"spoiler":false,"text":"translated from DLSite"}],"source":"vndb","sourceCharacterId":"c108283"},{"segments":[{"spoiler":false,"text":"クラス委員長。"},{"spoiler":false,"text":"堅物で曲がったこと軟弱なものが許せない融通が利かない『ド真面目』な性格。"},{"spoiler":false,"text":"口調も堅く武士っぽい隙の無い立ち振る舞いをしている。"},{"spoiler":false,"text":"可愛いものが大好きで菜々子のことを非常に可愛がっている。"}],"source":"egs","sourceCharacterId":"9118","sourceWorkId":"16520","spoiler":false},{"segments":[{"spoiler":false,"text":"クラス委員長。"},{"spoiler":false,"text":"カタブツで、曲がったことと軟弱なものが許せない、融通が利かない “ド真面目” な性格。"},{"spoiler":false,"text":"口調も硬く、武士っぽい隙の無い立ち振る舞いをしている。"},{"spoiler":false,"text":"かわいいものが大好きで、菜々子のことを非常に可愛がっている。"}],"source":"bangumi","sourceCharacterId":"29769"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb135b8c0bb45698cfeff6b322558664749e932ebcbde7c6fbe7a185891ab631.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7ee45641265d10e9230956fd28d943abf5039df0faf35b258906080d5eb93a4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水口まつり","creatorId":"vndb:s879","sourcePersonId":"vndb:s879","canonicalEntityId":"vndb:s879","name":"水口 まつり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:29476:29769:6380:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p499","sourceCompanyId":"egs:brand:85","canonicalEntityId":"vndb:p499","name":"KISS","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:16520:85","source":"egs"},{"companyId":"vndb:p499","sourceCompanyId":"vndb:p499","canonicalEntityId":"vndb:p499","name":"KISS","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:23216:v9768","source":"vndb"},{"companyId":"vndb:p499","sourceCompanyId":"vndb:p499","canonicalEntityId":"vndb:p499","name":"KISS","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:25754:v9768","source":"vndb"},{"companyId":"vndb:p499","sourceCompanyId":"vndb:p499","canonicalEntityId":"vndb:p499","name":"KISS","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:26378:v9768","source":"vndb"},{"companyI