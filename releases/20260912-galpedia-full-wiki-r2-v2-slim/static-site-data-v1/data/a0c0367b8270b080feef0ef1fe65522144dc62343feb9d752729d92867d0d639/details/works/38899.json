ct","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"24"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The daughter of the general manager who oversees the hotel complex Souseikan. She usually works at the front desk, serving as the hotel’s welcoming face, and her gentle demeanor attracts guests who visit just for her. For certain reasons, her work schedule differs from others, and she’s occasionally tasked with room service or serving as a dedicated room attendant for specific guests."}],"source":"vndb","sourceCharacterId":"c154054"},{"segments":[{"spoiler":false,"text":"ホテル総支配人の一人娘。"},{"spoiler":false,"text":"秀麗な美貌に、優美かつ華やかで、清楚な雰囲気を纏う深窓の令嬢。"},{"spoiler":false,"text":"優しく柔らかな包容力がありながらも、正すところはしっかりと正す厳格さも併せ持つ女性。"},{"spoiler":false,"text":"丁寧な接客によりホテルの顔役となっており、彼女目当ての利用客もいるほど。"},{"spoiler":false,"text":"基本的にはホテルのフロント業務担当となっているが、とある理由から他の従業員と就労形態が異なり、ルームサービスの対応や、ＶＩＰへの専属客室係を任されたりと、こなす仕事を多く持っている。"},{"spoiler":false,"text":"親の跡を継ぐことを自分の夢としており、仕事には真摯に誇りを持って向き合っている。"}],"source":"egs","sourceCharacterId":"28133","sourceWorkId":"38899","spoiler":false},{"segments":[{"spoiler":false,"text":"总经理的女儿，负责管理“奏誠館”酒店综合体。她通常在前台工作，作为酒店的看板娘，她温柔的举止吸引了专程前来光顾的客人。由于某些原因，她的工作安排与其他人不同，她偶尔还会负责送餐服务或担任特定客人的专属房间服务员。"}],"source":"bangumi","sourceCharacterId":"186213"}],"profileFacts":[{"label":"年龄（本版本）","value":"24 岁","valueContext":null,"source":"egs","sourceCharacterId":"28133","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"28133","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"28133","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"28133","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"28133","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"28133","sourceWorkId":"38899","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/886fba20387937125ad71a2335308574cb9dceb9e585fe0ed14a8de537d41e27.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28d194056b088fea6ee634b7b60d47131428120d159bbd877ee348983d7a36f6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:567071:186213:6351:1","source":"bangumi"}]},{"characterId":"char_c154055","characterName":"風岡 愛来","sourceIds":{"bangumi":[{"characterId":"186214","match":"exact-normalized-name-in-linked-work","subjectId":"567071"}],"egsCharacterIds":["28134"],"vndbCharacterId":"c154055"},"originalCharacterName":"風岡 愛来","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"25"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young female president who founded a travel agency with women her age. She collaborates with the hotel to plan various tours, often making personal appearances. With a sharp, charismatic beauty, she has a workaholic streak that keeps her distant from romance, leaving her surprisingly unaccustomed to being treated as a woman."}],"source":"vndb","sourceCharacterId":"c154055"},{"segments":[{"spoiler":false,"text":"同年代の女性達と一緒に旅行会社を立ち上げた若き女社長。"},{"spoiler":false,"text":"ホテルと提携してツアー企画を実施しており、本人もよく顔を出している。"},{"spoiler":false,"text":"真面目で優しくて面倒見が良く、曲がったことが嫌いなイケメン女子で、社員達から頼りにされている。"},{"spoiler":false,"text":"シャープな雰囲気の美人だが仕事が恋人と豪語するワーカホリックで、社長でありながら積極的に営業に飛び回っているため色恋とは縁が遠く女性として扱われることに対して免疫がない一面を持つ。"}],"source":"egs","sourceCharacterId":"28134","sourceWorkId":"38899","spoiler":false},{"segments":[{"spoiler":false,"text":"一位年轻的女性总裁，她和同龄女性一起创办了一家旅行社。她与酒店合作策划各种旅行项目，经常亲自参与。她拥有敏锐且有魅力的美貌，同时有着工作狂的性格，这让她对浪漫保持距离，因此对被当作女性对待感到异常陌生。"}],"source":"bangumi","sourceCharacterId":"186214"}],"profileFacts":[{"label":"年龄（本版本）","value":"25 岁","valueContext":null,"source":"egs","sourceCharacterId":"28134","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"28134","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"28134","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"28134","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"28134","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"28134","sourceWorkId":"38899","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d8d43526618db1b215dd6288201e7ca9b62e358ef9174e9608277b08c45f509.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfa6048ae2376d692aa73adea084a5cfae70d292a48922cbf1c04668d9d3b341.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"設楽麻美","creatorId":"vndb:s869","sourcePersonId":"vndb:s869","canonicalEntityId":"vndb:s869","name":"設楽 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:567071:186214:7904:1","source":"bangumi"}]},{"characterId":"char_c154056","characterName":"東雲 紗夜子","sourceIds":{"bangumi":[{"characterId":"186216","match":"exact-normalized-name-in-linked-work","subjectId":"567071"}],"egsCharacterIds":["28135"],"vndbCharacterId":"c154056"},"originalCharacterName":"東雲 紗夜子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"26"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An esthetician working at the hotel’s in-house spa. Her gentle and nurturing demeanor makes her especially popular with male clients, ensuring a steady stream of customers. Due to the nature of her job, which involves frequent physical contact, she often unintentionally captivates men. However, she strives to maintain professional boundaries, subtly keeping interactions from crossing the line."}],"source":"vndb","sourceCharacterId":"c154056"},{"segments":[{"spoiler":false,"text":"ホテル内のエステサロンで働くエステティシャン。"},{"spoiler":false,"text":"優しく朗らかで包容力のある雰囲気が人気の美女で特に男性の客が絶えない。"},{"spoiler":false,"text":"職業柄、人の身体に触れることに抵抗がない上に他人との距離感が近くボディータッチも多めなせいでよく男を惑わせてしまう。"},{"spoiler":false,"text":"しかし、そう見えて必要以上の接触は避けてそれとなく一線を保っている素振りも見えるため主人公は彼女に対し、見た目通りではないしたたかな面があると感じている。"}],"source":"egs","sourceCharacterId":"28135","sourceWorkId":"38899","spoiler":false},{"segments":[{"spoiler":false,"text":"在酒店内部水疗中心工作的美容师。她温柔而细心的性格使她在男性客户中非常受欢迎，确保了源源不断的顾客。由于她的工作性质涉及频繁的身体接触，她经常会无意中吸引男性。然而，她努力保持专业界限，巧妙地避免互动越界。"}],"source":"bangumi","sourceCharacterId":"186216"}],"profileFacts":[{"label":"年龄（本版本）","value":"26 岁","valueContext":null,"source":"egs","sourceCharacterId":"28135","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"28135","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"28135","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"28135","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"28135","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"28135","sourceWorkId":"38899","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0ba4772f6095cb30eba1a88a70857e58e6f36c584410503541e1b75319d88c8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14fb40ac9425f5f44b37cb4230f91bad72e4c878530eb4566fb63aba71f6de6f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花月さや","creatorId":"vndb:s23345","sourcePersonId":"vndb:s23345","canonicalEntityId":"vndb:s23345","name":"花月さや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:567071:186216:40638:1","source":"bangumi"}]},{"characterId":"char_c154057","characterName":"紅林 蛍","sourceIds":{"bangumi":[{"characterId":"186215","match":"exact-normalized-name-in-linked-work","subjectId":"567071"}],"egsCharacterIds":["28136"],"vndbCharacterId":"c154057"},"originalCharacterName":"紅林 蛍","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"22"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Once a promising tennis player in her student days, she was forced to retire due to injury. Now, she works as an instructor at the hotel’s fitness gym. Her cool beauty and polite demeanor make her highly popular. With a reserved, quiet aura and few words, she can come across as unapproachable."}],"source":"vndb","sourceCharacterId":"c154057"},{"segments":[{"spoiler":false,"text":"ホテル内のフィットネスジムでインストラクターを務めている女性。"},{"spoiler":false,"text":"クール系の美貌と口数少なめながらも丁寧な対応で人気を得ている。"},{"spoiler":false,"text":"寡黙な雰囲気のせいでとっつきづらく見られがちだが、実は思ったことはそのまま口に出す素直な性格。"},{"spoiler":false,"text":"学生の頃に将来を有望視されていたテニスプレイヤーだったが、怪我により選手生命を絶たれてしまった過去を持っている。"}],"source":"egs","sourceCharacterId":"28136","sourceWorkId":"38899","spoiler":false},{"segments":[{"spoiler":false,"text":"她在学生时代曾是一名前途光明的网球运动员，但因伤被迫退役。现在，她在酒店的健身房担任教练。她冷艳的美貌和彬彬有礼的举止使她非常受欢迎。她性格内敛、话语不多，给人一种难以接近的感觉。"}],"source":"bangumi","sourceCharacterId":"186215"}],"profileFacts":[{"label":"年龄（本版本）","value":"22 岁","valueContext":null,"source":"egs","sourceCharacterId":"28136","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"28136","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"28136","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"28136","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"28136","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"28136","sourceWorkId":"38899","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18598f24a8d2c60d1208d0a54db120d5763b2d866027eaf8ff257999971bb36c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0e4fa5847ffb0bf306314f3a26115389aa361521c48fb9f9b5e22d92ba35fbd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"叶一華","creatorId":"vndb:s16232","sourcePersonId":"vndb:s16232","canonicalEntityId":"vndb:s16232","name":"叶一華","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:567071:186215:33030:1","source":"bangumi"}]},{"characterId":"char_c154059","characterName":"蓮実 恋鈴","sourceIds":{"bangumi":[{"characterId":"186212","match":"exact-normalized-name-in-linked-work","subjectId":"567071"}],"egsCharacterIds":["28137"],"vndbCharacterId":"c154059"},"originalCharacterName":"蓮実 恋鈴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"20"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"151"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A woman who claims she was a slave to the protagonist in a past life. She boldly showed up at his doorstep and now works as an employee at his love hotel while also freelancing as a web writer. Despite her indoor-loving appearance, she’s outgoing and skilled at connecting with others. However, she shows little interest in anyone besides the protagonist and ruthlessly seeks to eliminate those who pose a threat to him. She also eagerly assists in the domination and training of other women."}],"source":"vndb","sourceCharacterId":"c154059"},{"segments":[{"spoiler":false,"text":"前世で主人公に隷属していたと豪語し、押しかけてきた電波娘。"},{"spoiler":false,"text":"現在は主人公の元に押しかけてラブホテルの従業員として働く傍ら、ＷＥＢライターとしても活動している。"},{"spoiler":false,"text":"大人しそうなインドア系の見た目に反して社交的で、他人の懐に潜り込むのが得意。"},{"spoiler":false,"text":"誰とでもすぐに仲良くなれるが、実際は主人公以外の人間に対しては関心が薄く、主人公の害になる相手なら手段を選ばず排除しようとする危険な面を持つ。"},{"spoiler":false,"text":"主人公のことを「ご主人様」と崇めて行動のすべてを肯定し、他の女性達を凌虐・調教することにも積極的に協力する。"}],"source":"egs","sourceCharacterId":"28137","sourceWorkId":"38899","spoiler":false},{"segments":[{"spoiler":false,"text":"一位声称自己在前世是主角的奴隶的女性。她大胆地出现在他的家门口，现在在他的爱情酒店工作，同时也以自由撰稿人的身份从事网络写作工作。尽管她看起来喜爱宅在家，但她性格外向，善于与他人建立联系。然而，除了主角，她对其他人几乎没有兴趣，并无情地寻求消除对主角构成威胁的人。她还积极协助对其他女性进行支配和训练。"}],"source":"bangumi","sourceCharacterId":"186212"}],"profileFacts":[{"label":"年龄（本版本）","value":"20 岁","valueContext":null,"source":"egs","sourceCharacterId":"28137","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"28137","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"28137","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"151 cm","valueContext":null,"source":"egs","sourceCharacterId":"28137","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"28137","sourceWorkId":"38899","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"28137","sourceWorkId":"38899","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea23b048eb0496994278e293768d772d4eb71af3142fe51020ced60144091406.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a0a495f1ea393e882f19461852d94db88fb42fa5abf807cadcbe0706d78072f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"赤月ゆむ","creatorId":"vndb:s8643","sourcePersonId":"vndb:s8643","canonicalEntityId":"vndb:s8643","name":"赤月 ゆむ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:567071:186212:28581:1","source":"bangumi"},{"creditedName":"アイネ・A・ロメロ","creatorId":"vndb:s21253","sourcePersonId":"vndb:s21253","canonicalEntityId":"vndb:s21253","name":"アイネ・A・ロメロ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:100878","source":"vndb"}]},{"characterId":"char_vndb_c157255","characterName":"三原隆也","sourceIds":{"vndbCharacterId":"c157255"},"originalCharacterName":"三原隆也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man who took over from his father at a young age and now owns several love hotels."},{"spoiler":false,"text":"Since he was working in the sex industry, he had always been a womanizer, After meeting Kosozu, he discovers the joy of treating a woman as a slave, and he is plotting to get hold of Rion, who he has had his eye on for some time."},{"spoiler":false,"text":"He frequently uses hotels to make contact with his prey, when contacting his prey, he hides his true identity and pretends to be a reporter."},{"spoiler":false,"text":"He was once reluctant to follow in his father's footsteps, and out of resentment, he got a job as an employee at the hotel where Rion currently works. however, in the end, the service industry didn't suit me."},{"spoiler":false,"text":"After his father passed away suddenly, he returned home and settled into his current position. in the end, he was devastated that he had no choice but to live in the sex industry,"},{"spoiler":false,"text":"After meeting Kosozu, he was able to get over it, and now he is making full use of his power as a love hotel owner to get his hands on prey."}],"source":"vndb","sourceCharacterId":"c157255"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd55559585d0774a12a3dcee2280685673d032717aad980d494cadbb8085c393.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8352e49b7589e9b92e5588e0c8147ddc2b22bebc0054b195d1a44f7157f0e503.webp","width":158,"height":256,"source":"static-detail"},"actors":[