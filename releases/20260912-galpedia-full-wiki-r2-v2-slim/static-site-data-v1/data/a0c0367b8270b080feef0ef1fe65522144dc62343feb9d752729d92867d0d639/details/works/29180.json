ite"}],"source":"vndb","sourceCharacterId":"c89260"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c89264","characterName":"村田 雄次郎","sourceIds":{"vndbCharacterId":"c89264"},"originalCharacterName":"村田 雄次郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man who runs an advertising and showbiz company."},{"spoiler":false,"text":"He is a frivolous character with no integrity, whose thinking is directed by ulterior motives and his crotch."},{"spoiler":false,"text":"Truth is, his current position at the company was gained by recruiting young women to service influential persons of the business world, not because of any work related success."},{"spoiler":false,"text":"In the past, Minori, who used to live stream on the net caught his attention so he contacted her. She then ended up being utilized for \"commercial activities\"."},{"spoiler":false,"text":"Although his relationship with Minori had already ended, she contacted him thoughtlessly while she was searching for a job, and so they met once again."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c89264"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd1f52520e6f77241032d817f81b20fa2b8de69f61367ff199571969083a6b2d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b107c07870d928513c37807bf659239b066f72da70ced70d11f47398ce8bac79.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"對馬 芳哲","creatorId":"vndb:s11330","sourcePersonId":"vndb:s11330","canonicalEntityId":"vndb:s11330","name":"對馬 芳哲","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-nativ