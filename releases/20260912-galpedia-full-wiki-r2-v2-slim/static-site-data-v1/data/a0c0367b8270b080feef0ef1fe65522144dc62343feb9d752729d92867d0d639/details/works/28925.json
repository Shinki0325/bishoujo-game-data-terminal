515","source":"vndb"}]},"cast":[{"characterId":"char_c88147","characterName":"黄坂 ルイ","sourceIds":{"bangumi":[{"characterId":"11102","match":"exact-normalized-name-in-linked-work","subjectId":"294938"},{"characterId":"11102","match":"exact-normalized-name-in-linked-work","subjectId":"397069"}],"egsCharacterIds":["22227"],"vndbCharacterId":"c88147"},"originalCharacterName":"黄坂 ルイ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"1977年10月13日"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"134cm(11歳時)，142cm(14歳時)"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"31kg(11歳時)，36kg(14歳時)"}},"descriptions":[{"segments":[{"spoiler":false,"text":"クールな性格の操主（ジンキパイロット）。"},{"spoiler":false,"text":"プライドが高く、そっけないので付き合いにくいように見えるが、わかりづらいだけで仲間を思いやる心はちゃんとある。"},{"spoiler":false,"text":"たまに洒落にならないイタズラを仕掛けては騒動を引き起こしている。"}],"source":"egs","sourceCharacterId":"22227","sourceWorkId":"28925","spoiler":false},{"segments":[{"spoiler":false,"text":"元々は南米に住んでいた少女で、人機は身近な存在だった。"},{"spoiler":false,"text":"青葉とはライバル的な関係だったこともあったが、現在は心を許せる親友関係になっている。"},{"spoiler":false,"text":"日本には一年前から滞在しており、仲間達とともに暗躍するキョムに対抗していた。"}],"source":"egs","sourceCharacterId":"22227","sourceWorkId":"33133","spoiler":false},{"segments":[{"spoiler":false,"text":"黄坂 露依是《人机（ジンキ）》系列作品中的主要角色之一，她在多个作品中均有登场。特征是“蟹钳”型发夹的美少女。"},{"spoiler":false,"text":"本名为ルイ・ウィンドウ，父亲是Heavens的前任队长コール・ウィンドウ。在她还是婴儿时，父亲コール失踪，由其部下黄坂南作为养母收养并抚养长大。"},{"spoiler":false,"text":"她拥有出色的运动神经，擅长作为血续者操纵人机。性格高傲而冷静，但有时也会展现出顽皮或害羞等孩子气的一面。平时表现有些冷淡，看上去难以相处，但实际上是最重视朋友、掩饰自己的内心的类型。"},{"spoiler":false,"text":"从小就饲养着作为宠物的九带犰狳“步间二郎”（アルマジロウ）。"},{"spoiler":false,"text":"她所驾驶的人机「ナナツーマイルド」（NANA-TWO MILD）是为了降低成本而开发的女性型机体，原本设计时考虑与同型机「ナナツーライト」（NANA-TWO LIGHT）协同作战，主要负责攻击任务。其最大武器是用于近战的双剑「メッサーシュレイヴXZ」，剑刃上附有反弹电子，据说具有能够切断世间所有金属的强大切割力。"},{"spoiler":false,"text":"《人机（ジンキ）篇》：11岁。一直生活在南美，未曾出国，也未上过学，因此对外界了解甚少。"},{"spoiler":false,"text":"最初对同龄的操主青叶不以为意，认为她是爱哭鬼。但在青叶击败古代人机后，开始将她视为竞争对手。尽管在争夺守人（モリビト）2号下操主的位置时败给了青叶，但两人逐渐建立了深厚的友谊。在与黑将及守人1号的战斗中，她代替成为上操主的青叶，担任守人2号的下操主，并与青叶一同对抗黑将。"},{"spoiler":false,"text":"对両兵有异性情感，在这方面也常与青叶竞争。在安赫尔（アンヘル）的操主中，唯独未曾与両兵共同驾驶人机，这让她感到在意。"},{"spoiler":false,"text":"《旧extend（エクステンド）》篇：14岁。为了对抗虚无组织（キョム）而来到日本。尽管一度被卡利斯（カリス・ノウマン）击败且性侵（疑似），但后来驾驶专用机ナナツーマイルド成功复仇。之后与柊赤緒等人一同对抗虚无和八将阵。"},{"spoiler":false,"text":"《relation（リレイション）》篇： 14岁。在与虚无组织的全面战争中失踪。出现了一个戴着面具、外貌与露依相似的角色，但两者之间的关系尚不明确。"},{"spoiler":false,"text":"黄坂 露依是《人机》系列中备受喜爱的角色之一，她的成长历程和复杂的情感关系为作品增添了丰富的层次。无论是在漫画还是游戏中，她都以坚强与柔情并存的形象，给观众留下了深刻的印象。"}],"source":"bangumi","sourceCharacterId":"11102"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a0e8e65d2c2f620bbecdc46cc70a67d916d4429aa9e4a38bb0abcb238d90e47.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9dad326de00bf234e0a3e027ea63d472509dc60f3a74cad7dc4f28ddc69a35ad.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山口瑞樹","creatorId":"vndb:s338","sourcePersonId":"vndb:s338","canonicalEntityId":"vndb:s338","name":"山口 瑞樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:294938:11102:16462:1","source":"bangumi"}]},{"characterId":"char_c88148","characterName":"津崎 青葉","sourceIds":{"bangumi":[{"characterId":"25194","match":"exact-normalized-name-in-linked-work","subjectId":"294938"},{"characterId":"25194","match":"exact-normalized-name-in-linked-work","subjectId":"397069"}],"egsCharacterIds":["22224"],"vndbCharacterId":"c88148"},"originalCharacterName":"津崎 青葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明るく前向きな性格の少女。"},{"spoiler":false,"text":"南米で人機のパイロットとして活動していたが、両兵の窮状を知って急遽日本へ帰国した。"},{"spoiler":false,"text":"両兵に対してストレートに好意を表して困惑させている。"},{"spoiler":false,"text":"とにかくロボットが大好きで休日はプラモデル作りに集中し、人機への愛情、こだわりも人一倍強い。"}],"source":"egs","sourceCharacterId":"22224","sourceWorkId":"28925","spoiler":false},{"segments":[{"spoiler":false,"text":"人機を心から愛する少女。"},{"spoiler":false,"text":"４年前、南米での戦いでは、人機・モリビト２号に搭乗して敵の首魁・黒将を倒す戦果を上げている。"},{"spoiler":false,"text":"キョムの総攻撃の直前に来日し、仲間達とともに奮戦。"},{"spoiler":false,"text":"しかし、その戦いの中で行方不明になってしまっている。"}],"source":"egs","sourceCharacterId":"22224","sourceWorkId":"33133","spoiler":false},{"segments":[{"spoiler":false,"text":"搭乗機：モリビト2号（下操主だったが、後に単独操主になる）→モリビト2号エクステンド"},{"spoiler":false,"text":"1988年での主人公。プラモデル作りが大好きな少女。13歳。髪型は黒髪のロングストレート。血続である。"},{"spoiler":false,"text":"ある日突然ベネズエラへ連れて行かれ、人機・モリビト2号と出会う。その後アンヘルに加わり、操主としてテーブルマウンテンから現れる古代人機と戦うことになる。人機を操る天性の才能を持っておりその技術は戦いのなか開花していく。また超能力のような感性の鋭さも持ち合わせていて、隠されたものを見つけ出すのが得意。小河原両兵（後述）とは幼馴染（漫画版のみ）。"},{"spoiler":false,"text":"負傷した小河原現太（後述）の代わりにモリビト2号の下操主を務めることとなり、最初は戦闘に怯えもしたが、戦いを経験するうちに高度な操縦技術「ファントム」をも会得するようになる。やがて最大の敵、モリビト1号を操る黒将（後述）を最初の戦いでは退け、八将陣の人機五体がかりの攻撃すら撃退するほどの強さを持つに至り、両兵と共に黒将との最終決戦に挑んで真機・モリビト2号エクステンドの力で勝利した。"},{"spoiler":false,"text":"少々引っ込み思案なところもあったが、ラ・グラン・サバナにてモリビト2号や仲間たちに出会ったことでその運命は大きく変わり、強く大きな心を育ませていく。"},{"spoiler":false,"text":"1991年（旧・エクステンド）"},{"spoiler":false,"text":"搭乗機：ナナツーウェイ青葉カスタム"},{"spoiler":false,"text":"黒髪のロングストレートはそのままに、美しく成長している。"},{"spoiler":false,"text":"日本にいる八将陣を黄坂ルイ（後述）たちに任せモリビト2号を託し、自身は行方不明の母・津崎静花（後述）を探すために南米に残った。"},{"spoiler":false,"text":"レジスタンスからは「黒髪のヴァルキリー」と呼ばれシンボル的存在となっており、「キョム」と戦い続けている。空中ファントムもすでに会得しており、その卓越した人機操縦能力とラ・グラン・サバナ、そして人機を愛する心に全く翳りはない。"},{"spoiler":false,"text":"専用にカスタマイズされたナナツーウェイに搭乗する。なお、『旧・エクステンド』1話には青葉らしき少女とその背後に屈んでいる謎のモリビトタイプが描かれているが、その詳細は明らかでない。"},{"spoiler":false,"text":"テレビアニメ版では赤緒が暗黒面に取り込まれる事態が発生した事を知らされ、急遽日本に帰国。再びモリビト2号のパイロットに復帰し、赤緒の操縦するキリビト・ザイと熾烈な戦いを繰り広げた。"},{"spoiler":false,"text":"Re:VISION"},{"spoiler":false,"text":"搭乗機：マサムネ"},{"spoiler":false,"text":"たびたび名前は出てくるが、彼女自身の登場は最終決戦までない。マサムネを駆り、宇宙での戦闘に介入する。"}],"source":"bangumi","sourceCharacterId":"25194"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4ceb09f42cd31862d9c9956cac9aca620b36a24bc35506eec2991795adf4f126.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/805e8c4a9691726dc09e28945c88afcd638c9be3c6f05dd12c4f3a3b9db99057.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:294938:25194:4432:1","source":"bangumi"}]},{"characterId":"char_c88149","characterName":"柊 赤緒","sourceIds":{"bangumi":[{"characterId":"11101","match":"exact-normalized-name-in-linked-work","subjectId":"294938"},{"characterId":"11101","match":"exact-normalized-name-in-linked-work","subjectId":"397069"}],"egsCharacterIds":["22225"],"vndbCharacterId":"c88149"},"originalCharacterName":"柊 赤緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"157cm"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"世界一有名な人機のパイロット。"},{"spoiler":false,"text":"人機・モリビト２号に搭乗して世界を救ったことから救世主や女神と呼ばれている。"},{"spoiler":false,"text":"ただし本人はどこか抜けているのほほんとした性格で、まったく戦いには向いていない。"},{"spoiler":false,"text":"訊けば何でも答えてくれるが、両兵が記憶喪失になった原因についてのみ、 口が重くなってしまう。"}],"source":"egs","sourceCharacterId":"22225","sourceWorkId":"28925","spoiler":false},{"segments":[{"spoiler":false,"text":"日本にいるキョムと、度々戦いを繰り広げていた少女。"},{"spoiler":false,"text":"青葉が使っていた人機・モリビト２号を受け継ぎ、多くの敵を倒してきた。"},{"spoiler":false,"text":"キョムの総攻撃では前線に立って戦っていたが、そのまま基地には帰らず行方不明となっている。"}],"source":"egs","sourceCharacterId":"22225","sourceWorkId":"33133","spoiler":false},{"segments":[{"spoiler":false,"text":"柊木台学园二年级学生，住在附近的柊神社里打工的巫女。"},{"spoiler":false,"text":"没有3年前的所有记忆，有时会梦见自己奇怪的过去。"},{"spoiler":false,"text":"主人公·氷野顕初恋的女孩。"}],"source":"bangumi","sourceCharacterId":"11101"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39d08ce48ffdca102065ea272567caba256d25e569aef160d9f731a0bfa5fcec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5fbe44156e8790c5f64ccd8cf06ff412f7fd36f3a99adaaa625bff765562e89f.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"清水愛","creatorId":"vndb:s416","sourcePersonId":"vndb:s416","canonicalEntityId":"vndb:s416","name":"清水 愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:294938:11101:4064:1","source":"bangumi"}]},{"characterId":"char_c88150","characterName":"三宮 金枝","sourceIds":{"bangumi":[{"characterId":"73276","match":"exact-normalized-name-in-linked-work","subjectId":"294938"}],"egsCharacterIds":["22226"],"vndbCharacterId":"c88150"},"originalCharacterName":"三宮 金枝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler"