8152","sourceWorkId":"39072","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"28152","sourceWorkId":"39072","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"28152","sourceWorkId":"39072","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"28152","sourceWorkId":"39072","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29a12cbd07da31337310350228711d2d2b3f03f24ecb96df10d3c562e52260e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48d6151c69525771105185eac71a072329de66700e7aa7d12ea9017185bc5306.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松岡侑里","creatorId":"vndb:s18478","sourcePersonId":"vndb:s18478","canonicalEntityId":"vndb:s18478","name":"松岡侑里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:569713:180363:38326:1","source":"bangumi"}]},{"characterId":"char_c156318","characterName":"ハヤテ キサラギ","sourceIds":{"bangumi":[{"characterId":"180364","match":"exact-normalized-name-in-linked-work","subjectId":"569713"}],"egsCharacterIds":["28153"],"vndbCharacterId":"c156318"},"originalCharacterName":"ハヤテ キサラギ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"After graduating at the top of his class from the special educational institution, the Academy, which has produced many outstanding talents,"},{"spoiler":false,"text":"he inherited his late grandfather’s trade and became a detective."},{"spoiler":false,"text":"Although his classmates lamented it as a waste of talent, he himself drifts through each day without concern."},{"spoiler":false,"text":"“No way. Give it up. We’re forever just second-rate, shabby detectives on the outskirts.”"},{"spoiler":false,"text":"Translate from Getchu"}],"source":"vndb","sourceCharacterId":"c156318"},{"segments":[{"spoiler":false,"text":"数々の優秀な人材を輩出している特別な教育機関【アカデミー】を首席で卒業後、亡き祖父の家業を継ぎ探偵となった。"},{"spoiler":false,"text":"才能の無駄遣いと級友たちには惜しまれたものの、本人は飄々と毎日を過ごしている。"}],"source":"egs","sourceCharacterId":"28153","sourceWorkId":"39072","spoiler":false},{"segments":[{"spoiler":false,"text":"数々の優秀な人材を輩出している特別な教育機関【アカデミー】を首席で卒業後、"},{"spoiler":false,"text":"亡き祖父の家業を継ぎ探偵となった。"},{"spoiler":false,"text":"才能の無駄遣いと級友たちには惜しまれたものの、本人は飄々と毎日を過ごしている。"},{"spoiler":false,"text":"「ないない。諦めろ。俺たちは万年、場末の冴えない探偵だよ。」"},{"spoiler":false,"text":"▽固有機能 #ユニーク"},{"spoiler":false,"text":"オーバークロック"},{"spoiler":false,"text":"脳機能を強化し五感を極限まで研ぎ澄ませる。"},{"spoiler":false,"text":"副次的な効果として、周囲の時間がゆっくりに感じられる。"}],"source":"bangumi","sourceCharacterId":"180364"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2acc7f8c803c4476a9ff6ab26ad230189d5e926453a02fe026541a26594587a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aaac6f40599d5fc33cda058a8d6421c99f5f0f9f51f47c9f2bc584a8b779f307.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梯篤司","creatorId":"vndb:s734","sourcePersonId":"vndb:s734","canonicalEntityId":"vndb:s734","name":"梯篤司","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:569713:180364:5603:1","source":"bangumi"}]},{"characterId":"char_c156320","characterName":"アデーレ フォルガン","sourceIds":{"bangumi":[{"characterId":"180365","match":"exact-normalized-name-in-linked-work","subjectId":"569713"}],"egsCharacterIds":["28154"],"vndbCharacterId":"c156320"},"ori