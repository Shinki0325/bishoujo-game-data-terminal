vndb","sourceCharacterId":"c28258"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/663cf78a5aa3b516e3d55aceabf0c1d51289bc256ae8f98ac3b254e848324c49.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa4f5161ec1a63b1eda93a1f30b8f066cb53adff6a567858014cf09cc1734096.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新垣 樽助","creatorId":"vndb:s1378","sourcePersonId":"vndb:s1378","canonicalEntityId":"vndb:s1378","name":"新垣 樽助","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41597","source":"vndb"}]},{"characterId":"char_vndb_c28259","characterName":"キリエ","sourceIds":{"vndbCharacterId":"c28259"},"originalCharacterName":"キリエ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"208"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Sly Scarecrow"},{"spoiler":false,"text":"The consigliere of famiglia Oz. Don't let his gentle demeanor fool you; he's a calculating man with a heart black as soot. He is universally recognized as a sadist. While he’s a crack shot with anything he puts his hands to, he prefers not to dirty his own hands if at all possible, especially when others are so easily manipulated."},{"spoiler":false,"text":"Taken from the English official website."}],"source":"vndb","sourceCharacterId":"c28259"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2125c42f78f01a72c824bbce6164b696bf26022729c36734fbd855d5433771e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/term