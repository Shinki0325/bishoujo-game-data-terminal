b","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。"},{"spoiler":false,"text":"自分に自信を持てないため、目立った行動が苦手なタイプ。"},{"spoiler":false,"text":"それでも、一応、クラスの委員長を務めている。"},{"spoiler":false,"text":"大きな胸にコンプレックスを持っており、それが原因となって異性と接することに躊躇してしまう。"},{"spoiler":false,"text":"しかし、不思議と主人公には、それほど苦手意識を感じていない。"},{"spoiler":false,"text":"隣のクラスの藤野さつきとは幼馴染で、仲が良い。"},{"spoiler":false,"text":"学校でオナニーしているところを主人公に知られ、それがきっかけで親しくなっていく。"}],"source":"egs","sourceCharacterId":"16115","sourceWorkId":"11668","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで委員長。"},{"spoiler":false,"text":"自分に自信がないため、目立つ行動は基本的に苦手。"},{"spoiler":false,"text":"大きな胸にコンプレックスをもっており、異性と接するときは少し壁を作るが、"},{"spoiler":false,"text":"主人公にはそれほど苦手意識がない。隣のクラスの藤野さつきとは幼なじみ。"},{"spoiler":false,"text":"学校でオナニーをしていた事実を主人公に知られてしまうが、"},{"spoiler":false,"text":"それが切っ掛けで主人公と親密になっていく。"}],"source":"bangumi","sourceCharacterId":"200933"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50672922ec7cfb65d5f2c0943a183aa56bdb44a2443ac7b691b0302cc63cdafb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/735835975e47c7ac15cc20918f8255a311f1fd530a1b2ed22bb5cc1dba45865b.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤野 藍","creatorId":"vndb:s52270","sourcePersonId":"vndb:s52270","canonicalEntityId":"vndb:s52270","name":"藤野 藍","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31845","source":"vndb"}]},{"characterId":"char_c4195","characterName":"藤野 さつき","sourceIds":{"bangumi":[{"characterId":"200934","match":"exact-normalized-name-in-linked-work","subjectId":"224402"}],"egsCharacterIds":["16116"],"vndbCharacterId":"c4195"},"originalCharacterName":"藤野 さつき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の隣のクラスに在籍する女子学生。"},{"spoiler":false,"text":"隣のクラスの木之下晃子とは幼馴染。"},{"spoiler":false,"text":"幾つかの運動部を掛け持ちするほどの活発なスポーツ少女。"},{"spoiler":false,"text":"好奇心旺盛で、興味を持ったものは自分で確かめないと気が済まないタイプ。"},{"spoiler":false,"text":"また、ちょっぴりドジッ娘属性を持つ。"},{"spoiler":false,"text":"小さな胸や女の子らしくない性格をやや気に病んでいる。"},{"spoiler":false,"text":"全てにおいて完璧な綾崎梨衣に憧れ、その想いを告白するが、そんな梨衣と急速に親しくなった主人公に敵対心を燃やす。"}],"source":"egs","sourceCharacterId":"16116","sourceWorkId":"11668","spoiler":false},{"segments":[{"spoiler":false,"text":"いくつかの運動部を掛け持ちしている、活発なポニーテールの少女。"},{"spoiler":false,"text":"何事も形から入るほうで、興味や関心、疑問をもつと自分で確かめようとする"},{"spoiler":false,"text":"行動派だが、少々ドジな部分もある。晃子とは対照的に、小さな胸や女らしくない"},{"spoiler":false,"text":"自分の性格を少しだけ気にしている部分がある。綾崎梨衣に憧れ、その想いを本人に"},{"spoiler":false,"text":"告白する一方、そんな梨衣と急速に親しくなっていく主人公を敵視する。"}],"source":"bangumi","sourceCharacterId":"200934"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80f30de3c645e8252951f483788e26344a558bffe1113a4aa3baa4df2c0e746a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f54e013ec911b1e672933a73322e55d8877e5377018fa325f88200670fad09f2.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"五色 比奈","creatorId":"vndb:s52269","sourcePersonId":"vndb:s52269","canonicalEntityId":"vndb:s52269","name":"五色 比奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31844","source":"vndb"}]},{"characterId":"char_c4196","characterName":"綾崎 梨衣","sourceIds":{"bangumi":[{"characterId":"200935","match":"exact-normalized-name-in-linked-work","subjectId":"224402"}],"egsCharacterIds":["16117"],"vndbCharacterId":"c4196"},"originalCharacterName":"綾崎 梨衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公たちの上級生で、学生会長。"},{"spoiler":false,"text":"スポーツ万能、学業優秀、品行方正、容姿端麗と非の打ちどころのない少女。"},{"spoiler":false,"text":"男女問わず人気があり、教師からの信頼も厚い。"},{"spoiler":false,"text":"自分の視点から一歩引いたところから客観的に物事を見ているため、自分の感情を素直に表現することができず、周囲にはクールな印象を与える。"},{"spoiler":false,"text":"しかし主人公の前では、時折、普段の彼女とは違った、茶目っ気のある一面を披露してくれる。"}],"source":"egs","sourceCharacterId":"16117","sourceWorkId":"11668","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公たちの上級生で、学生会長。"},{"spoiler":false,"text":"運動、勉学ともに優秀な成績で、男女問わず人気があり、教師からの信頼も厚い。"},{"spoiler":false,"text":"自分の視点から一歩引いたところで客観的に物事を見ているため、自分の感情を"},{"spoiler":false,"text":"素直に表すことが苦手。普段は素っ気ないクールな印象も、主人公に対しては"},{"spoiler":false,"text":"茶目っ気のある一面を見せ、悪戯っぽく笑うことも多い。"},{"spoiler":false,"text":"主人公の弱味を握り、学生会の仕事を手伝わせる。"}],"source":"bangumi","sourceCharacterId":"200935"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e8fe27c6691d790e97f957f26842a0e51587dfeed8382b0fd241164fd3bfead.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14af11671341f83f5a8ca91136fcc133505af26526ec2a7669cf65fc1660c7f7.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みたか 亜矢","creatorId":"vndb:s52268","sourcePersonId":"vndb:s52268","canonicalEntityId":"vndb:s52268","name":"みたか 亜矢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31843","source":"vndb"}]},{"characterId":"char_vndb_c110054","characterName":"座馬 信也","sourceIds":{"vndbCharacterId":"c110054"},"originalCharacterName":"座馬 信也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflic