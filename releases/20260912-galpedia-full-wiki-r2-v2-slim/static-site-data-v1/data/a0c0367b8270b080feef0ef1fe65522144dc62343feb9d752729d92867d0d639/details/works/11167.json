loodType":{"reviewState":"no-conflict","source":"egs","value":"AB"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"height":{"reviewState":"no-conflict","source":"vndb","value":"146"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"48"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A distant relative of Itaru's, who calls herself his fiancee."},{"spoiler":false,"text":"She has a very youthful appearance, and a childish disposition to match."},{"spoiler":false,"text":"But her true nature is the exact opposide of that image. Due to her father's past illegal deeds, she was brought up in total chaos from a young age."},{"spoiler":false,"text":"Because of that, she has a brutally realistic way of thinking."},{"spoiler":false,"text":"Moreover, she always carries guns with her, and has a dangerous outlook on life."}],"source":"vndb","sourceCharacterId":"c9751"},{"segments":[{"spoiler":false,"text":"主人公の遠縁の親戚で、自称婚約者。"},{"spoiler":false,"text":"外見は幼く、子供っぽい口調。"},{"spoiler":false,"text":"しかしその本質は、家庭の事情で相当な修羅場を潜り抜けてきたシビアな少女。"},{"spoiler":false,"text":"全身に銃器を隠し、「殺られる前に殺れ」の精神で身構えている。"},{"spoiler":false,"text":"「抱っこっ！　……え～、だめなのぉ？"},{"spoiler":false,"text":"パクってしたげても、だめぇ？」"}],"source":"egs","sourceCharacterId":"17697","sourceWorkId":"11167","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の遠縁の親戚であり、自称婚約者。"},{"spoiler":false,"text":"幼く見える外見のとおり、子どもっぽいおっとりとした口調で喋る。"},{"spoiler":false,"text":"しかし実態はイメージとは逆。 彼女の父が手を染めてきた非合法の事業により、幼い頃から相当な修羅場をくぐり抜けてきた。"},{"spoiler":false,"text":"そのせいか、ひどく現実的な思考の持ち主。"},{"spoiler":false,"text":"また、全身に銃器を携えたりと、かなり危険な思想を持っている。"},{"spoiler":false,"text":"「抱っこっ！……え～、だめなのぉ？　パクってしたげても、だめぇ？」"}],"source":"bangumi","sourceCharacterId":"77688"}],"profileFacts":[{"label":"胸围（本版本）","value":"72 cm","valueContext":null,"source":"egs","sourceCharacterId":"17697","sourceWorkId":"11167","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"aa","valueContext":null,"source":"egs","sourceCharacterId":"17697","sourceWorkId":"11167","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"146 cm","valueContext":null,"source":"egs","sourceCharacterId":"17697","sourceWorkId":"11167","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"17697","sourceWorkId":"11167","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"48 cm","valueContext":null,"source":"egs","sourceCharacterId":"17697","sourceWorkId":"11167","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"38 kg","valueContext":null,"source":"egs","sourceCharacterId":"17697","sourceWorkId":"11167","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f7009bd2d8bf2deb033045106ba2b9f1311b0bf4a10c741b368c8e7d9e24633.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58fec167e3c029c9fd38dad634aa131552dc99cfd2a0a21f010005680ecfc7fa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田愛衣","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:98998:77688:6509:1","source":"bangumi"}]},{"characterId":"char_c9756","characterName":"弟切 かごめ","sourceIds":{"bangumi":[{"characterId":"146680","match":"exact-normalized-name-in-linked-work","subjectId":"98998"}],"egsCharacterIds":["17698"],"vndbCharacterId":"c9756"},"originalCharacterName":"弟切 かごめ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"229"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"65"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Itaru's classmate."},{"spoiler":false,"text":"But because she doesn't stand out at all in class, Itaru never noticed Kagome even exists."},{"spoiler":false,"text":"She's very quiet, painfully shy, always walks slouched over staring at the ground, and wears super-thick glasses. This all adds up to her being very plain."},{"spoiler":false,"text":"During conversation, she cowers as a submissive smile floats across her face and she stutters. Nobody really talks to her, so she might as well not even be there."},{"spoiler":false,"text":"Through a strange twist of fate, Itaru gets to know her better, and sees a much deeper side of her."}],"source":"vndb","sourceCharacterId":"c9756"},{"segments":[{"spoiler":false,"text":"主人公の同級生。"},{"spoiler":false,"text":"人見知りが激しく、猫背、眼鏡、無口……と、地味が服を着て歩いているような少女。"},{"spoiler":false,"text":"地味すぎて彼女の存在すら、主人公は知らなかった。"},{"spoiler":false,"text":"しかし奇妙な縁から、彼女のディープな趣味を知ることになる。"},{"spoiler":false,"text":"「う、うちの弟はそんなことしないんだから！」"}],"source":"egs","sourceCharacterId":"17698","sourceWorkId":"11167","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の同級生。"},{"spoiler":false,"text":"だがクラスでもかなり地味な存在であるため、主人公はかごめの存在に気づいていなかった。"},{"spoiler":false,"text":"無口で人見知りが激しく常に猫背で顔を伏せ、ぶ厚い眼鏡をかけたりと、その容姿も性格同様ひどく地味。"},{"spoiler":false,"text":"話しかけられてもオドオドと卑屈な笑みを浮かべ、どもりがちであるため、次第に近づく者は誰もいなくなり、そして空気のような存在になってしまった。"},{"spoiler":false,"text":"そんなかごめと奇妙な縁で知り合った主人公は、彼女の極めてディープな一面を知ることになる。"},{"spoiler":false,"text":"「う、うちの弟はそんなことしないんだから！」"}],"source":"bangumi","sourceCharacterId":"146680"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"17698","sourceWorkId":"11167","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"17698","sourceWorkId":"11167","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"17698","sourceWorkId":"11167","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"17698","sourceWorkId":"11167","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"65 cm","valueContext":null,"source":"egs","sourceCharacterId":"17698","sourceWorkId":"11167","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"50 kg","valueContext":null,"source":"egs","sourceCharacterId":"17698","sourceWorkId":"11167","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec090cdced8e357e1c55eaee406246409c142aaaf4c2da904c75a6a59cf30b10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38050fb6bab7e7d5177fcc909e6a1d9f5e105c0e3e23c5d2084c35f700edce46.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:98998:146680:4689:1","source":"bangumi"}]},{"characterId":"char_c9757","characterName":"ファヌル","sourceIds":{"bangumi":[{"characterId":"146681","match":"exact-normalized-name-in-linked-work","subjectId":"98998"}],"egsCharacterIds":["17699"],"vndbCharacterId":"c9757"},"originalCharacterName":"ファヌル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The angel of death who revived Itaru at the beginning of the game."},{"spoiler":false,"text":"She has an androgynous look, with a cuteness that's neither entirely masculine or feminine. But her speech and behavior are downright awful."},{"spoiler":false,"text":"Most of what comes out of her mouth is abuse or sarcasm, and she seems to look down on everyone."},{"spoiler":false,"text":"Implanting a memory of herself as a distant relative of Itaru, she lives as a freeloader in his house."}],"source":"vndb","sourceCharacterId":"c9757"},{"segments":[{"spoiler":false,"text":"主人公を生き返らせた「死」を司る天使。"},{"spoiler":false,"text":"少年とも少女ともつかぬ中性的な容姿と、両方に通じる可愛らしさも持つ。"},{"spoiler":false,"text":"性格は皮肉屋。嫌味を撒き散らし、相手を見下す。"},{"spoiler":false,"text":"他のヒロインたちに偽の記憶を植え付け、主人公宅に居候している。"},{"spoiler":false,"text":"「ま、どうせ何もできないだろうけど、足掻いてみるかい？」"}],"source":"egs","sourceCharacterId":"17699","sourceWorkId":"11167","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公を生き返らせた、死を司る天使。"},{"spoiler":false,"text":"その容姿は中性的であり、少年とも少女ともつかぬ可愛さを備えている。"},{"spoiler":false,"text":"しかし、その言動は憎たらしいの一言。"},{"spoiler":false,"text":"口を開けば悪態か皮肉、そして常に相手を見下した嫌味なもの。"},{"spoiler":false,"text":"現在、遠縁の親戚という記憶をわずかたちに植え付け、主人公の家に居候している。"},{"spoiler":false,"text":"「ま、どうせ何もできないだろうけど足掻いてみるかい？」"}],"source":"bangumi","sourceCharacterId":"146681"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"17699","sourceWorkId":"11167","sourc