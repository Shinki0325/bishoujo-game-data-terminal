ource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"329"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Itaru's childhood friend, who's one year older than he is."},{"spoiler":false,"text":"Though very beautiful, she's quiet to a fault and doesn't show any outward emotion."},{"spoiler":false,"text":"Despite that, on the inside she's very impulsive, not to mention stubborn and dedicated to whatever she decides to do."},{"spoiler":false,"text":"Itaru saved her life when she was a child, and she's loved him ever since."}],"source":"vndb","sourceCharacterId":"c9743"},{"segments":[{"spoiler":false,"text":"主人公の一つ年上の幼馴染。"},{"spoiler":false,"text":"Gカップを誇る巨乳美人。しかし始終無口、無表情。"},{"spoiler":false,"text":"内面は極めて直情的で頑固。決めたらテコでも揺るがない。"},{"spoiler":false,"text":"幼い頃、主人公に命を救われて以来、彼を慕う。"},{"spoiler":false,"text":"「……気にしないで。好きでやってることだから」"}],"source":"egs","sourceCharacterId":"17696","sourceWorkId":"11167","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼なじみであり、1つ年上の少女。"},{"spoiler":false,"text":"かなりの美貌の持ち主だが、ひどく無口で、その顔に感情を表すことはなかなかない。"},{"spoiler":false,"text":"しかし本当はかなり直情的な気質の持ち主であり、それと決めたら必ず実行する頑固で強引な性格をしている。"},{"spoiler":false,"text":"幼い頃、主人公に命を助けられたことがあり、それ以来ずっと彼を慕っている。"},{"spoiler":false,"text":"「……気にしないで。好きでやってることだから」"}],"source":"bangumi","sourceCharacterId":"146679"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharact