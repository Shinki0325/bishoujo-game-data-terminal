{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"36808","model":{"presentationWorkId":"vndb:v51932","staff":{"artwork":[{"creditedName":"八樹ひより","creatorId":"vndb:s20311","sourcePersonId":"egs:creator:34485","canonicalEntityId":"vndb:s20311","name":"八樹ひより","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:282150","source":"egs"}],"scenario":[{"creditedName":"ORU","creatorId":"vndb:s2260","sourcePersonId":"egs:creator:2043","canonicalEntityId":"vndb:s2260","name":"ORU","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:282151","source":"egs"}],"music":[],"other":[{"creditedName":"ゆあタン","creatorId":"vndb:s24706","sourcePersonId":"vndb:s24706","canonicalEntityId":"vndb:s24706","name":"ゆあタン","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:209208","source":"vndb"}]},"cast":[{"characterId":"char_c141889","characterName":"久住 伊月","sourceIds":{"bangumi":[{"characterId":"168275","match":"exact-normalized-name-in-linked-work","subjectId":"509757"}],"egsCharacterIds":["26592"],"vndbCharacterId":"c141889"},"originalCharacterName":"久住 伊月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"101"},"height":{"reviewState":"no-conflict","source":"vndb","value":"174"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The busty club president who brings together the quirky female members"},{"spoiler":false,"text":"The basketball club president and Shiori's younger sister. She is what you would call an honor student, a bright and kind person who brings everyone together."},{"spoiler":false,"text":"However, in reality, she is extremely concerned about how others perceive her, and is indecisive and cannot make any decisions on her own."},{"spoiler":false,"text":"Mimura, the robber, calls her a hypocrite who just wants to be seen as a good person by others. She likes Hiroko a bit too much."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c141889"},{"segments":[{"spoiler":false,"text":"バスケ部部長で詩織の妹。いわゆる優等生タイプで、明るく優しいみんなのまとめ役。しかし本性は他人からの評価を極端に気にする性格で、自分一人では何も決められない優柔不断さを持つ。強盗犯の三村からは、他の人から良い人として見られたいだけの偽善者と言われてしまう。"}],"source":"egs","sourceCharacterId":"26592","sourceWorkId":"36808","spoiler":false},{"segments":[{"spoiler":false,"text":"篮球部部长，诗织的妹妹。"},{"spoiler":false,"text":"典型优等生，开朗温柔，众人的领袖。"},{"spoiler":false,"text":"本性却极度在意他人评价，独自一人便无法决定任何事，格外优柔寡断。"},{"spoiler":false,"text":"被绑匪三村形容成只想被他人视作好人的伪善者。"}],"source":"bangumi","sourceCharacterId":"168275"}],"profileFacts":[{"label":"胸围（本版本）","value":"101 cm","valueContext":null,"source":"egs","sourceCharacterId":"26592","sourceWorkId":"36808","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"174 cm","valueContext":null,"source":"egs","sourceCharacterId":"26592","sourceWorkId":"36808","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"26592","sourceWorkId":"36808","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"26592","sourceWorkId":"36808","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcf8968604746f6333ad99992ab89488cdd449b843b145a3b0309d5a06d4dda5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96af382f964a55072950ca994a2dbd3c2dbe528117eac361633b8d62c412a152.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平野有紗","creatorId":"vndb:s4474","sourcePersonId":"vndb:s4474","canonicalEntityId":"vndb:s4474","name":"平野 有紗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:509757:168275:30292:1","source":"bangumi"}]},{"characterId":"char_c141890","characterName":"島村 寛子","sourceIds":{"bangumi":[{"characterId":"168305","match":"exact-normalized-name-in-linked-work","subjectId":"509757"}],"egsCharacterIds":["26593"],"vndbCharacterId":"c141890"},"originalCharacterName":"島村 寛子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"107"},"height":{"reviewState":"no-conflict","source":"vndb","value":"175"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"102"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The outspoken, loud-mouthed vice-captain"},{"spoiler":false,"text":"She is childhood friends with Izuki and Shiori. She is the vice-captain of the basketball club and Izuki's assistant."},{"spoiler":false,"text":"She is blunt and doesn't hesitate to say things that Izuki would stammer over, which annoys some of the club members."},{"spoiler":false,"text":"However, it seems that she is also causing stress for the kidnappers..."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c141890"},{"segments":[{"spoiler":false,"text":"伊月・詩織とは幼馴染の関係。バスケ部の副部長で伊月の補佐役。ハッキリ物事を言うため、伊月が口ごもってしまうようなことでも遠慮なく言ってしまうので、部員の一部煙たがられている。しかし彼女も彼女で部活のメンバーたちにストレスを溜め込んでいるようで……。"}],"source":"egs","sourceCharacterId":"26593","sourceWorkId":"36808","spoiler":false},{"segments":[{"spoiler":false,"text":"伊月和诗织的青梅竹马。"},{"spoiler":false,"text":"篮球部副部长，负责辅佐伊月，为把话讲清，会直言不讳说出伊月感到为难的话，因此遭到部分队员的排斥。"},{"spoiler":false,"text":"但她的种种行为似乎也为社团成员们带来了压力。"}],"source":"bangumi","sourceCharacterId":"168305"}],"profileFacts":[{"label":"胸围（本版本）","value":"107 cm","valueContext":null,"source":"egs","sourceCharacterId":"26593","sourceWorkId":"36808","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"175 cm","valueContext":null,"source":"egs","sourceCharacterId":"26593","sourceWorkId":"36808","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"102 cm","valueContext":null,"source":"egs","sourceCharacterId":"26593","sourceWorkId":"36808","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"63 cm","valueContext":null,"source":"egs","sourceCharacterId":"26593","sourceWorkId":"36808","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/266bf3b54aabac6b49fd03dd7f4333b57b0864214a65373d2cc7cad3b678a416.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/7640050e9ea7e94c235aebfd53a2d21ec026fd572caf1635426f62c3809ea9c3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白井すみれ","creatorId":"vndb:s39797","sourcePersonId":"vndb:s39797","canonicalEntityId":"vndb:s39797","name":"白井すみれ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:509757:168305:70321:1","source":"bangumi"}]},{"characterId":"char_c141891","characterName":"若松 詩織","sourceIds":{"bangumi":[{"characterId":"168306","match":"exact-normalized-name-in-linked-work","subjectId":"509757"}],"egsCharacterIds":["26594"],"vndbCharacterId":"c141891"},"originalCharacterName":"若松 詩織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"105"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"hip":{"reviewState":"source-only","source":"vndb","value":"96"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"64"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"105/64/96"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A married woman advisor with a ripe body"},{"spoiler":false,"text":"She's the basketball club advisor and teacher in charge. With a strong sense of justice, she won't back down even in the face of robbers, and tries to protect her students."},{"spoiler":false,"text":"She married this spring and has a husband who works as a salaryman, but she doesn't seem to be very satisfied with their nighttime activities."},{"spoiler":false,"text":"She protects her younger sister Izuki and other students, and is the first to fall into the hands of the robbers."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c141891"},{"segments":[{"spoiler":false,"text":"バスケ部顧問＆引率の講師。正義感の強い性格で強盗犯たちに対しても一歩も引かず、生徒を守ろうとする。この春結婚したばかりの既婚者でサラリーマンの夫がいるが夜の営みはあまり満足していない様子。妹の伊月をはじめとする生徒をかばって一番初めに犯人たちの手に墜ちてしまう。"}],"source":"egs","sourceCharacterId":"26594","sourceWorkId":"36808","spoiler":false},{"segments":[{"spoiler":false,"text":"篮球部顾问兼领队老师。"},{"spoiler":false,"text":"正义感十足，即使面对抢劫犯时也毫不畏惧，努力守护着学生。"},{"spoiler":false,"text":"今年春天与上班族丈夫结婚，但夜晚的夫妻生活似乎并不美满。"},{"spoiler":false,"text":"为保护以妹妹伊月为首的一众而最先落入犯人手中。"}],"source":"bangumi","sourceCharacterId":"168306"}],"profileFacts":[{"label":"胸围（本版本）","value":"105 cm","valueContext":null,"source":"egs","sourceCharacterId":"26594","sourceWorkId":"36808","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"26594","sourceWorkId":"36808","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"26594","sourceWorkId":"36808","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"64 cm","valueContext":null,"source":"egs","sourceCharacterId":"26594","sourceWorkId":"36808","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97536605088dc1139a227476ec7f21c89318b7b1dead3bbefc1d139eb12e5786.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1c9d4381b929b841b52a4ec3beb813bcb3029ecd3926153f19ec50f533539f0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:509757:168306:10027:1","source":"bangumi"}]},{"characterId":"char_c141892","characterName":"村田 美樹","sourceIds":{"bangumi":[{"characterId":"168307","match":"exact-normalized-name-in-linked-work","subjectId":"509757"}],"egsCharacterIds":["26595"],"vndbCharacterId":"c141892"},"originalCharacterName":"村田 美樹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"122"},"height":{"reviewState":"no-conflict","source":"vndb","value":"186"},"hip":{"reviewState":"source-only","source":"vndb","value":"99"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"68"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"122/68/99"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Club member with an extraordinary body and large areola"},{"spoiler":false,"text":"She's the tallest member of the club. She has a calm and gentle personality, and because of her mature appearance, the club members her age treat her like a mother, which is confusing to her."},{"spoiler":false,"text":"Even when the club members are making a fuss, she stands a step back with a smile, but she is strong-willed and does not back down even in the face of robbers, and she also has a bold side, such as stating her opinions."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c141892"},{"segments":[{"spoiler":false,"text":"部で一番大きな部員。落ち着いた優しい性格で、大人びた風貌から同年代の部員達からも母親扱いされて当人も困惑している。部員たちが騒いでいるときも一歩下がった立ち位置で微笑みを浮かべいるが、芯は強く強盗犯たちにも一歩も引かず、自分の意見を述べるなど図太い一面も持つ。"}],"source":"egs","sourceCharacterId":"26595","sourceWorkId":"36808","spoiler":false},{"segments":[{"spoiler":false,"text":"篮球部最高的部员。"},{"spoiler":false,"text":"性格温柔沉稳，外表成熟，因此经常被同龄的部员们视作妈妈角色，本人对此颇感困惑。"},{"spoiler":false,"text":"部员们喧闹时她也总是微笑的守在一旁。实则内心坚强，即使面对抢劫犯也毫不退缩，敢于表达出自己的意见，展现出勇敢的一面。"}],"source":"bangumi","sourceCharacterId":"168307"}],"profileFacts":[{"label":"胸围（本版本）","value":"122 cm","valueContext":null,"source":"egs","sourceCharacterId":"26595","sourceWorkId":"36808","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"186 cm","valueContext":null,"source":"egs","sourceCharacterId":"26595","sourceWorkId":"36808","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"99 cm","valueContext":null,"source":"egs","sourceCharacterId":"26595","sourceWorkId":"36808","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"68 cm","valueContext":null,"source":"egs","sourceCharacterId":"26595","sourceWorkId":"36808","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02a5e0cfc60f5694f4e26d074015455b95998bc5580746df42dd93613b2dbac3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ede3a938619bbaf4181ae5f2f19c99d0df8e70e4a98dc1d921e17b2037423d3f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田紗記子","creatorId":"vndb:s1658","sourcePersonId":"vndb:s1658","canonicalEntityId":"vndb:s1658","name":"葵時緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:509757:168307:17079:1","source":"bangumi"}]},{"characterId":"char_c141893","characterName":"小島 純那","sourceIds":{"bangumi":[{"characterId":"168308","match":"exact-normalized-name-in-linked-work","subjectId":"509757"}],"egsCharacterIds":["26596"],"vndbCharacterId":"c141893"},"originalCharacterName":"小島 純那","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"103"},"height":{"reviewState":"no-conflict","source":"vndb","value":"173"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"103/60/90"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A loose-lipped, show-off gyaru full of attitude"},{"spoiler":false,"text":"With her bright personality and unrivaled athletic ability, she is the mood-maker of the team."},{"spoiler":false,"text":"She is also fashionable and is knowledgeable about the latest fashion trends."},{"spoiler":false,"text":"However, she is so showy that she tries to make herself look bigger, which leads to her lying, which is found amusing by the twins sisters and others."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c141893"},{"segments":[{"spoiler":false,"text":"明るい性格と無類の運動神経の良さからチームのムードメーカー。オシャレにも気を使っており、最先端のファッションにも明るい。しかし、見栄っ張りで自分を大きく見せようとするあまり虚言癖があり、それを双子などからは面白がられている。"}],"source":"egs","sourceCharacterId":"26596","sourceWorkId":"36808","spoiler":false},{"segments":[{"spoiler":false,"text":"因开朗的性格和无与伦比的运动神经，成为了队内的气氛制造者。"},{"spoiler":false,"text":"注重时尚，对最前沿的流行趋势了如指掌。"},{"spoiler":false,"text":"但她爱慕虚荣，有自吹自擂的习惯，双胞胎等人经常能从其言行中找到乐趣。"}],"source":"bangumi","sourceCharac