reatorId":"vndb:s2391","sourcePersonId":"egs:creator:4744","canonicalEntityId":"vndb:s2391","name":"高橋菜々","detail":"OP曲「ADVANCE」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:146806","source":"egs"},{"creditedName":"神谷ともえ","creatorId":"vndb:s5421","sourcePersonId":"egs:creator:9444","canonicalEntityId":"vndb:s5421","name":"神谷ともえ","detail":"一部お手伝い","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:186062","source":"egs"}]},"cast":[{"characterId":"char_c96489","characterName":"ブランシュ・ルクレール","sourceIds":{"bangumi":[{"characterId":"131206","match":"exact-normalized-name-in-linked-work","subjectId":"15966"}],"egsCharacterIds":["20492"],"vndbCharacterId":"c96489"},"originalCharacterName":"ブランシュ・ルクレール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An honorable and hardworking female knight. Due to her talent and hard work, Blanche was quickly admitted by Lilfynia Haidopair to the elite ranks of the Knights of Haidopair. Blanche admires Lilfynia greatly and strives to become more like her. However, in her longing for Lilfynia she becomes so stubborn that she sometimes struggles to be honest."}],"source":"vndb","sourceCharacterId":"c96489"},{"segments":[{"spoiler":false,"text":"ハイドパイル騎士団に所属する女騎士。"},{"spoiler":false,"text":"騎士団に登用されてから日が浅いが、本人の才能や努力もあり、リルフィニアから重用されていた。"},{"spoiler":false,"text":"ブランシュにとってリルフィニアは目標であり、憧れであり、命の恩人であった。"},{"spoiler":false,"text":"しかしリルフィニアにあこがれ、そうなろうとするあまりに堅物となってしまい、融通が利かない場面も多い。"},{"spoiler":false,"text":"はじめは法や礼儀を無視するジャンに対して、反感を抱く。"},{"spoiler":false,"text":"しかしジャンの孤児たちを守るためという行動原理を知り、考えを改め次第に惹かれていく。"},{"spoiler":false,"text":"ただやはり堅物な部分が邪魔をして、素直になれないことも多い。"}],"source":"egs","sourceCharacterId":"20492","sourceWorkId":"12386","spoiler":false},{"segments":[{"spoiler":false,"text":"ハイドパイル騎士団に所属する女騎士。"},{"spoiler":false,"text":"本人の才能や努力により、屈指の精鋭ぞろいであるハイドパイル騎士団において、登用されてから日が浅いがリルフィニアから重用されている。"},{"spoiler":false,"text":"ブランシュにとってリルフィニアは目標であり、憧れである。しかしリルフィニアに憧れ、そうなろうとするあまりに堅物となってしまい、素直になれないことも多い。"},{"spoiler":false,"text":"「だから、あの日からずっと、私はリルフィニア様を目標に生きている」"}],"source":"bangumi","sourceCharacterId":"131206"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad209cb771093037a27ab125cf0c01676ee8d724f1e4cfd1481ef16fd6ee7597.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c4ec98013ef9ca17d6b411e24f0a58a6e76a364a35c410df444d20229aad580.webp","width":119,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15966:131206:6469:1","source":"bangumi"}]},{"characterId":"char_c96490","characterName":"ソフィア・ベルツェリウス","sourceIds":{"bangumi":[{"characterId":"131207","match":"exact-normalized-name-in-linked-work","subjectId":"15966"}],"egsCharacterIds":["20493"],"vndbCharacterId":"c96490"},"originalCharacterName":"ソフィア・ベルツェリウス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Princess of Edingard and daughter of Marie and Siegfried."}],"source":"vndb","sourceCharacterId":"c96490"},{"segments":[{"spoiler":false,"text":"エディンガルドの王女。"},{"spoiler":false,"text":"前作のヒロインの一人であるマリーとジークフリートの娘。"},{"spoiler":false,"text":"高飛車だがさびしがり屋。"},{"spoiler":false,"text":"マリーと親子喧嘩して、家出同然に同行する。"},{"spoiler":false,"text":"母親から受け継いだ召喚能力と父親から受け継いだ弓の才能がある。"},{"spoiler":false,"text":"ルネとは王女と巫女というお互いの立場と関係なく友情を温めている。"}],"source":"egs","sourceCharacterId":"20493","sourceWorkId":"12386","spoiler":false},{"segments":[{"spoiler":false,"text":"エディンガルドの王女でマリーとジークフリートの娘。"},{"spoiler":false,"text":"非常に高飛車でわがままだが、これは王女だからというわけではなく、召喚能力と弓の才能という自分の能力に対する自信からきているものである。だからこそ、自分が認めた相手からは対等に扱ってもらう事を望んでいる。"},{"spoiler":false,"text":"ルネとは王女と巫女という互いの立場と関係なく友人関係を築いている。"},{"spoiler":false,"text":"「それが、王女として生まれた自分の、最低限の義務だと思いますから」"}],"source":"bangumi","sourceCharacterId":"131207"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9a12f0b939df6f64ed6335bdb24332aa8dd3f74c4a203dce71f53889a9a1fc2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/fff9cf3801c1812c5cdfcce06cca1f239944cbdb7897f24290924466c9bceda2.webp","width":81,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15966:131207:6016:1","source":"bangumi"}]},{"characterId":"char_c96491","characterName":"ルネ・フォルトゥナ","sourceIds":{"bangumi":[{"characterId":"131208","match":"exact-normalized-name-in-linked-work","subjectId":"15966"}],"egsCharacterIds":["20494"],"vndbCharacterId":"c96491"},"originalCharacterName":"ルネ・フォルトゥナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A shrine maiden who is a descendant of the Ale tribe. Despite her parents still being alive, Rene decided she loved Aria and became her adoptive daughter. Although her magic powers are inferior to Aria's, they are still quite strong, but Rene refrains from using them because she has yet to learn how to control them properly."}],"source":"vndb","sourceCharacterId":"c96491"},{"segments":[{"spoiler":false,"text":"アリアの義娘。エディンガルドの神官でもある。"},{"spoiler":false,"text":"エール族の末裔でアリアには劣るものの強い力を秘めている。"},{"spoiler":false,"text":"しかしうまく力を制御して引き出すことができないため、人知れずそのことを気に病んでいる。"},{"spoiler":false,"text":"普段は気まじめだが、親しい人に対しては歳相応の無邪気さを見せる。"},{"spoiler":false,"text":"特にソフィアと仲がよく、互いの立場と関係なく友人関係を築いている。"}],"source":"egs","sourceCharacterId":"20494","sourceWorkId":"12386","spoiler":false},{"segments":[{"spoiler":false,"text":"エール族の末裔で両親は健在だが、アリアに気に入られ義娘となった。"},{"spoiler":false,"text":"アリアには劣るものの強い力を秘めているが、うまく力を制御して引き出すことができないため、普段は見せないがそのことを気に病んでいる。"},{"spoiler":false,"text":"普段は気まじめだが、親しい人に対しては歳相応の無邪気さを見せる。特にソフィアと仲がよく、王女と巫女という互いの立場と関係なく友人関係を築いている。"},{"spoiler":false,"text":"「私も微力ながら頑張ります！」"}],"source":"bangumi","sourceCharacterId":"131208"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1c6322de500813f037cc7896da7e04faf01467738056525438ab9a84168dc8c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b32b6b49e18efe06274b489862b7a3de8711a03916d15f22d0541ba114a53acb.webp","width":182,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15966:131208:4810:1","source":"bangumi"}]},{"characterId":"char_c96492","characterName":"イルマ・イェーガー","sourceIds":{"bangumi":[{"characterId":"131209","match":"exact-normalized-name-in-linked-work","subjectId":"15966"}],"egsCharacterIds":["20495"],"vndbCharacterId":"c96492"},"originalCharacterName":"イルマ・イェーガー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A passionate mercenary who searches for her older brother. Irma lives at the town's inn as the signboard girl for the purpose of getting information about the whereabouts of her brother."},{"spoiler":false,"text":"Irma is a tomboyish and enthusiastic person, but due to her experience in helping out at an inn, she got good at household chores such as cooking and sewing. She often worries about her small breasts."}],"source":"vndb","sourceCharacterId":"c96492"},{"segments":[{"spoiler":false,"text":"バランレイン出身で行方不明の兄“ライナルト”を探し、"},{"spoiler":false,"text":"情報を得るために人が集まる宿屋で看板娘として生活していた。"},{"spoiler":false,"text":"ジャンたちと知り合い、以前と様子の違う兄を見てその真意を確かめるために旅に同行する。"},{"spoiler":false,"text":"男勝りで熱血系だが家事は得意で女の子らしい一面もある。"}],"source":"egs","sourceCharacterId":"20495","sourceWorkId":"12386","spoiler":false},{"segments":[{"spoiler":false,"text":"行方不明の兄を探し、情報を得るために人が集まる宿屋で看板娘として生活していた。"},{"spoiler":false,"text":"エレクトスに兄がいるらしいと知り、エレクトスが進軍したハイドパイルに向かう途中でジャンたちと知り合う。"},{"spoiler":false,"text":"男勝りで熱血系だが、宿屋で働いていたいう事もあり、料理や裁縫など家事は得意で女の子らしい一面もある。"},{"spoiler":false,"text":"胸の小ささが悩み。"},{"spoiler":false,"text":"「ちょ、何だよ、それ。あたしが全く、女の子らしくないみたいじゃないか」"}],"source":"bangumi","sourceCharacterId":"131209"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f9604bcedc9c92fba461bd000b169493ac98b8eaeba9d01b1e5a68c51f543cd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a37692dd60486cafc1ca7df16a23f717ecc59d1576f0223c1d2bdb199e5af85.webp","width":121,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15966:131209:6131:1","source":"bangumi"}]},{"characterId":"char_c96493","characterName":"ネリー・ブラン","sourceIds":{"bangumi":[{"characterId":"131210","match":"exact-normalized-name-in-linked-work","subjectId":"15966"}],"egsCharacterIds":["20496"],"vndbCharacterId":"c96493"},"originalCharacterName":"ネリー・ブラン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A fortune-teller from Balunrain who can see the past and the future with Geist's eyes."}],"source":"vndb","sourceCharacterId":"c96493"},{"segments":[{"spoiler":false,"text":"バランレイン出身でガイストの目を持つ娘。"},{"spoiler":false,"text":"前作でオルヴァガイストの知恵を受け継ぐものはいなくなったので、きちんとした力の使い方はわからないが、直感的に使いこなしている。"},{"spoiler":false,"text":"聖剣エルゼスフィアー(ウルリカ)と交信することができ、ジャンたちにその言葉を伝える。"},{"spoiler":false,"text":"天然お姉さん系だが解説時のみ真面目になる。"}],"source":"egs","sourceCharacterId":"20496","sourceWorkId":"12386","spoiler":false},{"segments":[{"spoiler":false,"text":"バランレイン出身でガイストの眼を持つ女性。"},{"spoiler":false,"text":"オルヴァガイストの知恵を受け継ぐものはいないため、自身の力が何なのかはわかっていない。"},{"spoiler":false,"text":"しかしその力を直感的に使いこなしており、占い師として生計を立てている。また聖剣エルゼスフィアー（ウルリカ）と交信することができ、その言葉をジャンたちに伝える。"},{"spoiler":false,"text":"普段は天然で大抵のことには動じず笑って済ます。変わったモノが好き。"},{"spoiler":false,"text":"「ええ、もうビンビンに感じますわ～」"}],"source":"bangumi","sourceCharacterId":"131210"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67997be19fa4b8c4d063b37de0da0cee1da8d690cfe1a9a4f125b2cdebedb0c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a415e0f89ff6db2ce8a1715fe821199800f8d88b92c488c5e83be861e1f60b8e.webp","width":118,"height":256,"source":"static-detail"},"actors":[{"creditedName":"富山あかり","creatorId":"vndb:s891","sourcePersonId":"vndb:s891","canonicalEntityId":"vndb:s891","name":"富山 あかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15966:131210:12717:1","source":"bangumi"}]},{"characterId":"char_c96494","characterName":"ジャン・デュポン","sourceIds":{"bangumi":[{"characterId":"131205","match":"exact-normalized-name-in-linked-work","subjectId":"15966"}],"egsCharacterIds":["20497"],"vndbCharacterId":"c96494"},"originalCharacterName":"ジャン・デュポン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"スラムで何でも屋を営む青年。記憶を喪失している。"},{"spoiler":false,"text":"3年前にスラムの老人に拾われたのが彼のいちばん古い記憶である。"},{"spoiler":false,"text":"過去のない自分に対しての皮肉をこめてジャン・デュポン（非常にありふれた姓と名）を名乗っていた。"},{"spoiler":false,"text":"その後、老人は亡くなってしまったが、同じく老人が拾ってきた孤児たちとともにスラムで生活していた。"},{"spoiler":false,"text":"生きるため、そして孤児たちを生かすためならば、彼には地位も名誉も、法すらも関係なかったのだ。"}],"source":"egs","sourceCharacterId":"20497","sourceWorkId":"12386","spoiler":false},{"segments":[{"spoiler":false,"text":"20年前の戦乱から復興したハイドパイルだったが、そこには新たな問題があった。"},{"spoiler":false,"text":"家や家族を失った者たちがコミュニティをつくり、そこに瓦解したバランレインから難民が加わり、町の一部はスラムと化していた。"},{"spoiler":false,"text":"そのスラムで孤児と共に何でも屋を営む青年がいた。過去の記憶がない彼は自分に対しての皮肉をこめてジャン・デュポン（非常にありふれた姓と名）と名乗っていた。生きるため、そして孤児たちを生かすためならば、彼には地位も名誉も、法すらも関係なかったのだ。"},{"spoiler":false,"text":"「悪いが、おしゃべりはここまでだ。」"}],"source":"bangumi","sourceCharacterId":"131205"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/884b0c488eda84d6c7c8f606ba781f6695b30596dc66e33e6c8269ba37ecde98.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b95d279b555e3c33d8343c9c843a2ace5931da97b99e293609b8b895b548af4.webp","width":94,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜木章人","creatorId":"vndb:s1643","sourcePersonId":"vndb:s1643","canonicalEntityId":"vndb:s1643","name":"桜木 章人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15966:131205:19468:1","source":"bangumi"}]},{"characterId":"char_vndb_c96498","characterName":"フェリクス・ハイドパイル","sourceIds":{"vndbCharacterId":"c96498"},"originalCharacterName":"フェリクス・ハイドパイル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A hero who defeated Akbar in the previous war and saved Cranvar. After the war, Felix was able to take up a high position, but he chose to rebuild as the lord of his hometown, Haidopair, overrun by the Balanrain army. Felix is married to Lilfynia, who fought with him in the war, but they have no children."}],"source":"vndb","sourceCharacterId":"c96498"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/179a04d76edf2eb9835fb69aa5a4210c5f2839d1f67522d1b67de6372c7bb033.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c1f2801bf36edada146d08ad974a07f5123603f846d49111b749d7f6ecdf30b.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c96499","characterName":"リルフィニア・ハイドパイル","sourceIds":{"vndbCharacterId":"c96499"},"originalCharacterName":"リルフィニア・ハイドパイル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Lilfynia is the daughter of Akbar Gill Clift, who fought in the war 20 years ago with Felix Haidopair. She became Felix's wife after the war, and has been working with him to rebuild Haidopair."},{"spoiler":false,"text":"Lilfynia likes Blanche because of her loyalty to fulfilling her duties."}],"source":"vndb","sourceCharacterId":"c96499"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/923b3f002adf229eb4e13dcf5f69621e86eeb5c6648f426770763a4a176ecc8e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4823a7be5210ffdb95a14893100c1a2c2f53097f8346f17e88de5f9299fcbd2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"香澄 りょう","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15794","source":"vndb"}]},{"characterId":"char_vndb_c96500","characterName":"エレナ","sourceIds":{"vndbCharacterId":"c96500"},"originalCharacterName":"エレナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Elena is a descendant of the Ale tribe who still lives quietly in the southern ruins. She helped Felix during the war 20 years ago, her appearance is still very youthful despite the passing years."}],"source":"vndb","sourceCharacterId":"c96500"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fb30b8298706840e4c9c88ae008458a137d081fad7976fa226d64714c059d74.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/560bb236c87af5248a1013f9d1e4194943ea3734a831bf0fbf5d05c8612230f4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中家 志穂","creatorId":"vndb:s738","sourcePersonId":"vndb:s738","canonicalEntityId":"vndb:s738","name":"橘 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15800","source":"vndb"}]},{"cha