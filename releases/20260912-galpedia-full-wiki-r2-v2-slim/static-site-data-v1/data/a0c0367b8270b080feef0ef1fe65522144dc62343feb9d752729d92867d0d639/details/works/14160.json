ourcePersonId":"vndb:s644","canonicalEntityId":"vndb:s644","name":"巫浄 スウ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:54717","source":"vndb"},{"creditedName":"チーム・いーちゃん","creatorId":"vndb:s699","sourcePersonId":"vndb:s699","canonicalEntityId":"vndb:s699","name":"チーム・いーちゃん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:54718","source":"vndb"},{"creditedName":"甘井 ももこ","creatorId":"vndb:s46566","sourcePersonId":"vndb:s46566","canonicalEntityId":"vndb:s46566","name":"甘井 ももこ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:54720","source":"vndb"}]},"cast":[{"characterId":"char_c29887","characterName":"時枝 柚子","sourceIds":{"bangumi":[{"characterId":"48332","match":"exact-normalized-name-in-linked-work","subjectId":"197598"}],"egsCharacterIds":["21822"],"vndbCharacterId":"c29887"},"originalCharacterName":"時枝 柚子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"お人好しで遠慮ぎみ、加えて少しばかり引っ込み思案な所以外は、何処までも健気で純粋一途、元気一杯な裕樹の幼なじみ。"},{"spoiler":false,"text":"子供の頃は裕樹と隣どおしの幼なじみだったが、両親の仕事の都合で引っ越して以来、この春に舞台になる学園で裕樹に再会するまで離ればなれだった。"},{"spoiler":false,"text":"小さな頃は身体が弱く、今以上に引っ込み思案の面倒を裕樹が見ていた。"},{"spoiler":false,"text":"その頃から裕樹に片想いしていた。"},{"spoiler":false,"text":"両親の仕事の都合で引っ越した後も裕樹の事を想っており、もし再会できた時には、もう裕樹に迷惑をかけないように元気な身体になろうと努力。"},{"spoiler":false,"text":"その成果もあり現在ではスパッツ姿が眩しい元気な身体になり、運動系の部活の助っ人を頼まれるほど成長した。"},{"spoiler":false,"text":"自分のコトを「ボク」よ呼ぶ、ボクっ娘。"}],"source":"egs","sourceCharacterId":"21822","sourceWorkId":"14160","spoiler":false},{"segments":[{"spoiler":false,"text":"お人好しで引っ込み思案、どこまでも健気で純粋一途、元気一杯な裕樹の幼なじみ。"},{"spoiler":false,"text":"子供の頃は裕樹の家と隣同士で、裕樹が両親の都合で引っ越して以来、この春に学園で再開するまでずっと離ればなれだった。"},{"spoiler":false,"text":"小さな頃は身体が弱く、今以上に引っ込み思案だったが裕樹が面倒を見てくれて、その頃から彼に片思いしていた。"},{"spoiler":false,"text":"ずっと裕樹のことを想い続け、もし再会できた時には迷惑をかけないように元気な身体になろうと頑張って、現在ではスパッツ姿が眩しい元気な身体に。"},{"spoiler":false,"text":"運動系の部活で助っ人を頼まれるほどに成長した。"}],"source":"bangumi","sourceCharacterId":"48332"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f52a7c674873a3738226b18f003b8334016f2976c2077cd37e8c77cedcd2cd9d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48a06e2de6daa9700a9d9b215685b6624dec067852bd72b451bf2677132898e0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197598:48332:6409:1","source":"bangumi"}]},{"characterId":"char_c29888","characterName":"宙宮 早苗","sourceIds":{"bangumi":[{"characterId":"48333","match":"exact-normalized-name-in-linked-work","subjectId":"197598"}],"egsCharacterIds":["21823"],"vndbCharacterId":"c29888"},"originalCharacterName":"宙宮 早苗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"裕樹と柚子の通う学園の理科教師。"},{"spoiler":false,"text":"外観はオットリのんびりマイペース。誰に対しても微笑みかけているようなイメージで、生徒、教職陣問わずに人気がある学園のマドンナ的存在。"},{"spoiler":false,"text":"その正体は、【時空管理局】が要注意集団に認定している狂的科学者集団【トフェル・シンクタンク】の一員であり、近い将来に裕樹と柚子の間に生まれる子供を恩師としている科学者。"},{"spoiler":false,"text":"上記の誰に対しても優しい雰囲気の笑みは同じ人間に向けるというよりも、一般人が休日の公園に群がるハトにエサをやっている時に浮かべる笑みに近かったりする。"},{"spoiler":false,"text":"天才肌で科学者体質が強く自分の興味の無いものには、とことん無関心。"},{"spoiler":false,"text":"逆に一度興味を持った物や者には色々一途でご執心という難儀な性格。"},{"spoiler":false,"text":"この度、裕樹と柚子の間に出来る子供（＝早苗の恩師＝超天才）を生み出す、裕樹の精液に興味を持ち、タイムトラベルしてきた。"}],"source":"egs","sourceCharacterId":"21823","sourceWorkId":"14160","spoiler":false},{"segments":[{"spoiler":false,"text":"裕樹と柚子の通う学園の理科教師。"},{"spoiler":false,"text":"外観はオットリのんびりマイペース。誰に対しても微笑みかけているようなイメージで、学生・教職陣問わず人気がある学園のマドンナ的存在。"},{"spoiler":false,"text":"その正体は、『時空管理局』 が要注意集団に認定している狂的科学者集団 『トフェル・シンクタンク』 の一員であり、近い将来に裕樹と柚子の間に生まれる子供を恩師としている科学者。"},{"spoiler":false,"text":"この度、天才の恩師を生み出す裕樹の精液に興味を持って、「凡人の柚子との間にできた子供が天才として生まれてくるなら、天才の自分との間に生まれる子供は、さらにもっと天才になるだろう」 という予測を実行するために、わざわざタイムトラベルしてやってきた。"}],"source":"bangumi","sourceCharacterId":"48333"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b53421d2ad9816d92df331bb8eb84f59507a95ce4ae08dcdc191f002e07c3ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d88862be6eeefb096b212b2298ba55a3d159205a0ef994bf5ebe874c67317959.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤宮菜穂","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197598:48333:6019:1","source":"bangumi"}]},{"characterId":"char_vndb_c155980","characterName":"水無月 裕樹","sourceIds":{"vndbCharacterId":"c155980"},"originalCharacterName":"水無月 裕樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c29889","characterName":"HAC-LC07型","sourceIds":{"vndbCharacterId":"c29889"},"originalCharacterName":"HAC-LC07型","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"