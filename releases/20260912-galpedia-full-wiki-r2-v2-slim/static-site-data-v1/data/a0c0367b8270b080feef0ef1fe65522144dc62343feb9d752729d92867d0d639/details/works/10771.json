alse,"text":"常に余裕のある微笑みを浮かべている、啓発セミナーの講師。"},{"spoiler":false,"text":"理知的な話し方をするが、優しいお姉さんといった感じで、冷たい感じは受けない。"},{"spoiler":false,"text":"ただし、彼女の本心は全く見えない。"}],"source":"bangumi","sourceCharacterId":"219089"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08d35494475f9274cae436eb4cf9a942300108abda872b0e8501d8ae2a925671.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d9af00a0734bff55fa4ddcaae04a4d98316c516e80f5f109da0e39455ef86a6.webp","width":159,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c70988","characterName":"日凪 朋美","sourceIds":{"bangumi":[{"characterId":"219088","match":"exact-normalized-name-in-linked-work","subjectId":"217796"}],"egsCharacterIds":["18286"],"vndbCharacterId":"c70988"},"originalCharacterName":"日凪 朋美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"トラウマ：「怪物」"},{"spoiler":false,"text":"舞台となる学園に通う女子学生。"},{"spoiler":false,"text":"生まれつき洞察力と観察力に優れ、無意識の他人の心を読んでしまう、一種の超能力を持つ少女。"},{"spoiler":false,"text":"その異常な能力によって、彼女は周囲から奇異な目で見られ、あまつされ両親からも気味悪がられてしまう。"},{"spoiler":false,"text":"彼女の両親は離婚しており、その能力が原因だと思っている。そのためか、自分が不要な人間だと思い込んでいる節があり、自殺願望が強い。"}],"source":"egs","sourceCharacterId":"18286","sourceWorkId":"8713","spoiler":false},{"segments":[{"spoiler":false,"text":"真理亜にイジメられている女の子。"},{"spoiler":false,"text":"仕草などから相手の考えていることがわかる読心術を持っているが、それが原因で親などから煙たがれ、他人との関わりを避けるようになった。"},{"spoiler":false,"text":"人の顔色をうかがい、オドオドした彼女の態度が、イジメッ子には堪らないのか、彼女はイジメの標的にされることが多い。"},{"spoiler":false,"text":"彼女の読心術を他人を救うために使いたい、と主人公に説かれ、セミナーに通い始めるが……。"}],"source":"egs","sourceCharacterId":"18286","sourceWorkId":"10771","spoiler":false},{"segments":[{"spoiler":false,"text":"内気で弱々しくクラスの中で虐められている少女。"},{"spoiler":false,"text":"虐められていても抵抗することはなく、全てを受け入れてしまっている。"},{"spoiler":false,"text":"誰にも頼らず、助けを求めることすらしない。"},{"spoiler":false,"text":"学園内でも彼女に対する虐めが問題視されている。"}],"source":"bangumi","sourceCharacterId":"219088"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/8517600f0b20e62d96550a64146f803f143bba1a272073e1aafc6b02b753e532.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed93d8cf52cedc8c4043f8c06e348b7c4e33e1be10553381be04469e77ac3dce.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥川 久美子","creatorId":"vndb:s861","sourcePersonId":"vndb:s861","canonicalEntityId":"vndb:s861","name":"奥川 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41880","source":"vndb"}]},{"characterId":"char_c70989","characterName":"東堂 真里亜","sourceIds":{"bangumi":[{"characterId":"219090","match":"exact-normalized-name-in-linked-work","subjectId":"217796"}],"egsCharacterIds":["18287"],"vndbCharacterId":"c70989"},"originalCharacterName":"東堂 真里亜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"トラウマ：「虐め」"},{"spoiler":false,"text":"舞台となる学園に通う女子学生。"},{"spoiler":false,"text":"自殺をも考えたほどの酷い虐めに遭っていた過去を持つ少女。"},{"spoiler":false,"text":"現在は、逆に虐める立場になってはいるが、苛められている相手の気持ちが痛いほどわかるため、苛めながらも彼女自身も傷ついている。"}],"source":"egs","sourceCharacterId":"18287","sourceWorkId":"8713","spoiler":false},{"segments":[{"spoiler":false,"text":"朋美をイジメている不良娘。"},{"spoiler":false,"text":"過去にイジメに遭っていた、その反動からイジメる側に回ってしまった。"},{"spoiler":false,"text":"自分がイジメられていた過去を知る主人公の出現によって、また自分があの頃のようにイジメられるのではないか、と恐れている。"}],"source":"egs","sourceCharacterId":"18287","sourceWorkId":"10771","spoiler":false},{"segments":[{"spoiler":false,"text":"狡猾な不良学生。表だって問題行為を起こすわけではなく影で他人を操って問題を起こしている。"},{"spoiler":false,"text":"最も多く行っているのが虐め行為で、クラスでターゲットを見つけると、集団で虐め始める。"},{"spoiler":false,"text":"その時も自分だけが悪者にならないように、慎重に行動している。"}],"source":"bangumi","sourceCharacterId":"219090"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2738fe3e1f3a42890f41c6e5e1624b6c64a1f8be12b70abbeaf41eb6c0f67e8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c669e4b3f3bf2a49830b7919d06b7f07abe079f6129eed125c92c01fa078f2ea.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梨本 悠里","creatorId":"vndb:s1650","sourcePersonId":"vndb:s1650","canonicalEntityId":"vndb:s1650","name":"梨本 悠里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41881","source":"vndb"}]},{"characterId":"char_vndb_c70990","characterName":"池上 双馬","sourceIds":{"vndbCharacterId":"c70990"},"originalCharacterName":"池上 双馬","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewSta