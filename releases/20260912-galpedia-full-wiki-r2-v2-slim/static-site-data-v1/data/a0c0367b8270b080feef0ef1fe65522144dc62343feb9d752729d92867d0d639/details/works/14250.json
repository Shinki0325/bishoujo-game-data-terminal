to-confirmed","relationId":"egs:work-creator:227464","source":"egs"},{"creditedName":"立花あや","creatorId":"vndb:s62","sourcePersonId":"egs:creator:5854","canonicalEntityId":"vndb:s62","name":"立花あや","detail":"OP曲「ドラマティック・パレード」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:96331","source":"egs"},{"creditedName":"立花 あや","creatorId":"vndb:s62","sourcePersonId":"vndb:s62","canonicalEntityId":"vndb:s62","name":"南條 愛乃","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:54454","source":"vndb"},{"creditedName":"空下 元","creatorId":"vndb:s2283","sourcePersonId":"vndb:s2283","canonicalEntityId":"vndb:s2283","name":"空下 元","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:54458","source":"vndb"}]},"cast":[{"characterId":"char_c751","characterName":"桜濱 雪乃","sourceIds":{"bangumi":[{"characterId":"17159","match":"exact-normalized-name-in-linked-work","subjectId":"3685"}],"egsCharacterIds":["17017"],"vndbCharacterId":"c751"},"originalCharacterName":"桜濱 雪乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"217"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Don't worry. We can do it.\""},{"spoiler":false,"text":"The protagonist's childhood friend, who was made into the President of the \"United States of Nippon\" by aliens. She has a brainwashing device embedded in her body, turning the world into one where the left becomes right if she says it is. Her approval ratings climb rapidly due to her looks and personality (and brainwashing effects). She even has a fan club among the government officials. Known to love anime and manga, her supporters call her 'Your Excellency'. A daughter of doctors, good at sports, and has excellent grades. She isn't boastful about it, and has a modest and gentle personality... She wears the mask of a prim and proper high-class lady, but is clumsy and spoiled in her private life. She is also an extremely shy person, fretting over messing up her lines and blushing during speeches. Since she set forth the \"Jun-kun Supremacy Doctrine\" and has a troublesome side of passing crazy laws for the sake of love, disputes between Junichiro and the bureaucrats never die out."},{"spoiler":false,"text":"From JAST USA's official site"}],"source":"vndb","sourceCharacterId":"c751"},{"segments":[{"spoiler":false,"text":"宇宙人によって『合衆国新本』の大統領にされてしまった、主人公の幼なじみ。"},{"spoiler":false,"text":"身体に毒電波の発信装置を埋め込まれ、彼女が右と言えば左も右になる世界に。"},{"spoiler":false,"text":"その容姿と性格（と、洗脳の影響）から支持率はうなぎ登り。官僚の間でファンクラブも結成された。"},{"spoiler":false,"text":"それを鼻にかけない、控えめで穏やかな性格……などと、清楚なお嬢様の仮面を被っているが、プライベートではドジっ子で甘えん坊。"},{"spoiler":false,"text":"おまけに超がつくほどの恥ずかしがり屋で、演説中に台詞を噛んでは顔を真っ赤にして悶えている。"}],"source":"egs","sourceCharacterId":"17017","sourceWorkId":"12604","spoiler":false},{"segments":[{"spoiler":false,"text":"宇宙人によって『合衆国新本』の大統領にされてしまった、主人公の幼なじみ。"},{"spoiler":false,"text":"身体に毒電波の発信装置を埋め込まれ、彼女が右と言えば左も右になる世界に。"},{"spoiler":false,"text":"その容姿と性格（と、洗脳の影響）から支持率はうなぎ登り。官僚の間でファンクラブも結成された。"},{"spoiler":false,"text":"アニメ・漫画好きで知られ、支持者からは『閣下』と呼ばれている。"},{"spoiler":false,"text":"医者の娘で、スポーツ万能、成績優秀。"},{"spoiler":false,"text":"それを鼻にかけない、控えめで穏やかな性格……などと、清楚なお嬢様の仮面を被っているが、プライベートではドジっ子で甘えん坊。"},{"spoiler":false,"text":"おまけに超がつくほどの恥ずかしがり屋で、演説中に台詞を噛んでは顔を真っ赤にして悶えている。"},{"spoiler":false,"text":"また、『純くん至上主義』を掲げ、愛のためなら無茶な法案でも認めてしまうという困った一面を持つため、純一郎と官僚達との諍いは絶えない。"},{"spoiler":false,"text":"「大丈夫。わたし達ならできるよ」"}],"source":"bangumi","sourceCharacterId":"17159"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/cebd8a0227a915ac7a7a60d9e9c1bf648aa72ebea308f98afd7575e94eda9692.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8bc8d2fd135e846a6114a4347a1ba7b87187acf925386a8dc2a9e62b2785675.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南條愛乃","creatorId":"vndb:s62","sourcePersonId":"vndb:s62","canonicalEntityId":"vndb:s62","name":"南條 愛乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14312:17159:4792:1","source":"bangumi"}]},{"characterId":"char_vndb_c3720","characterName":"クー・リトルリトル","sourceIds":{"vndbCharacterId":"c3720"},"originalCharacterName":"クー・リトルリトル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Humans are so amusing and interesting. Giggle...\""},{"spoiler":false,"text":"A mysterious loli alien with twintails, she is responsible for the changes that have come over Yukino after her ship crashed, destroying Japan's government completely."},{"spoiler":false,"text":"From J-List"}],"source":"vndb","sourceCharacterId":"c3720"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/737f0bb4ac1c0e92e6f544f3a924e09e03cf415e802ec59b8bc6bbf8f9c26dba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4c93fa95c97e2b391771c150d21f07dd7eeb99b63e33ecab19cc3ece1742efe.webp","width":214,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉 りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntit