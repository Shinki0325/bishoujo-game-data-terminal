vndb:vn-staff:139276","source":"vndb"},{"creditedName":"さいもん","creatorId":"vndb:s4758","sourcePersonId":"vndb:s4758","canonicalEntityId":"vndb:s4758","name":"さいもん","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:139279","source":"vndb"},{"creditedName":"ひなづか 凉","creatorId":"vndb:s6786","sourcePersonId":"vndb:s6786","canonicalEntityId":"vndb:s6786","name":"ひなづか 凉","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:139282","source":"vndb"},{"creditedName":"みずゆき","creatorId":"vndb:s12933","sourcePersonId":"vndb:s12933","canonicalEntityId":"vndb:s12933","name":"みずゆき","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:139285","source":"vndb"},{"creditedName":"竹森 真太郎","creatorId":"vndb:s12934","sourcePersonId":"vndb:s12934","canonicalEntityId":"vndb:s12934","name":"竹森 真太郎","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:139287","source":"vndb"},{"creditedName":"成海 クリスティアー ノート","creatorId":"vndb:s12935","sourcePersonId":"vndb:s12935","canonicalEntityId":"vndb:s12935","name":"成海 クリスティアー ノート","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:139289","source":"vndb"}]},"cast":[{"characterId":"char_c61974","characterName":"藤ヶ崎 美帆","sourceIds":{"bangumi":[{"characterId":"53066","match":"exact-normalized-name-in-linked-work","subjectId":"211163"}],"egsCharacterIds":["16140"],"vndbCharacterId":"c61974"},"originalCharacterName":"藤ヶ崎 美帆","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Her father was a cruise ship captain and her mother was an oceanographer."},{"spoiler":false,"text":"Her mother died of illness several years ago, and since then she has lived with her father."},{"spoiler":false,"text":"Although she hasn't decided on her future, she wants to work in a job related to the sea."},{"spoiler":false,"text":"As part of that, she got a diving license. She's not very good at sports, but she is good at swimming."},{"spoiler":false,"text":"Normally, she is a calm and reserved type, but when she goes out to sea, she gets a little excited."}],"source":"vndb","sourceCharacterId":"c61974"},{"segments":[{"spoiler":false,"text":"父はクルーズ船の船長・母親は海洋学者だった。"},{"spoiler":false,"text":"母親は数年前に病気で亡くなっており、それからは父親と二人暮らし。"},{"spoiler":false,"text":"将来はまだ具体的に決めていないけれども、海に関わる仕事に就きたいと思っている。"},{"spoiler":false,"text":"その一環として、ダイビングのライセンスを取った。"},{"spoiler":false,"text":"スポーツはあまり得意ではないけれど、泳ぐのだけは上手い。"},{"spoiler":false,"text":"普段はどちらかと言えば落ち着いていて、大人しいタイプだけれども、海に出ると少しテンションが上がる。"},{"spoiler":false,"text":"潤とは、少ないやりとりでわかり合える仲で、一緒にいて一番安心できる友達。"}],"source":"egs","sourceCharacterId":"16140","sourceWorkId":"25046","spoiler":false},{"segments":[{"spoiler":false,"text":"今作の主人公である女子校生。 父はクルーズ船の船長、母は海洋学者だった。"},{"spoiler":false,"text":"母親は数年前に病気で亡くなっており、それからは父親と二人暮らし。"},{"spoiler":false,"text":"将来は海に関わる仕事に就きたいと思っていて、ダイビングのライセンスを取得済み。"},{"spoiler":false,"text":"スポーツは苦手だが泳ぐのだけは上手い。"},{"spoiler":false,"text":"普段は落ち着いていておとなしい性格だが、海に出ると少しテンションが上がる。"},{"spoiler":false,"text":"潤とは少ないやり取りで分かり合える仲で、一緒にいて一番安心できる友達。"},{"spoiler":false,"text":"「ふふっ、やっぱり海を見ると嬉しくなっちゃう」"}],"source":"bangumi","sourceCharacterId":"53066"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/abd2bafe66ec3100eb2c47d032776ed67be304375c59993434a40f99fab653c8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6dcaf4524ee83bcdcb8f64d5b61bf2ee4a40cdd8f49e95b50b9721808f6cc80c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:211163:53066:4646:1","source":"bangumi"}]},{"characterId":"char_c61975","characterName":"守部 潤","sourceIds":{"bangumi":[{"characterId":"53067","match":"exact-normalized-name-in-linked-work","subjectId":"211163"}],"egsCharacterIds":["16141"],"vndbCharacterId":"c61975"},"originalCharacterName":"守部 潤","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She lost her parents at a young age, and since she had no close relatives she was taken in by an institution."},{"spoiler":false,"text":"She met Miho shortly after entering the institution."},{"spoiler":false,"text":"She is Jun's first friend and his best friend."},{"spoiler":false,"text":"She is not very good at talking to people, and doesn't say much."},{"spoiler":false,"text":"(She can talk normally with Miho and the other residents of the institution)"},{"spoiler":false,"text":"She is like an older sister to the other children at the institution, and everyone loves him. She does not live a wealthy life, and does various part-time jobs."},{"spoiler":false,"text":"She is good at swimming, and has been invited to join the swimming club."},{"spoiler":false,"text":"To save money, she does not have a cell phone."}],"source":"vndb","sourceCharacterId":"c61975"},{"segments":[{"spoiler":false,"text":"幼い頃に両親を亡くし、近い親戚も居なかったため施設に引き取られた。"},{"spoiler":false,"text":"美帆とは、施設に入って間もない頃に出会った。"},{"spoiler":false,"text":"潤にとっては初めての友達で、一番の友達。"},{"spoiler":false,"text":"人と話すのがあまり得意でなく、口数が少ない。"},{"spoiler":false,"text":"(美帆や施設の住人が相手なら人並みに話せる)"},{"spoiler":false,"text":"施設ではほかの子供たちのお姉さん的存在で、みんなから慕われている。 暮らしはけして裕福では無く、いろいろとアルバイトをしている。"},{"spoiler":false,"text":"水泳が得意で、水泳部に誘われている。"},{"spoiler":false,"text":"お金の節約のため、携帯電話は持っていない。"}],"source":"egs","sourceCharacterId":"16141","sourceWorkId":"25046","spoiler":false},{"segments":[{"spoiler":false,"text":"幼い頃に両親を亡くし、施設に引き取られて育った少女。"},{"spoiler":false,"text":"美帆とは施設に入った頃に出会い、初めてで一番の友達となった。"},{"spoiler":false,"text":"人と話すのはあまり得意ではなく、美帆や施設の住人以外に対しては口数が少ない。"},{"spoiler":false,"text":"施設では他の子供たちのお姉さん的存在で、みんなから慕われている。"},{"spoiler":false,"text":"暮らしは裕福ではなく、携帯電話は持てず色々とアルバイトをしている。"},{"spoiler":false,"text":"水泳が得意で、水泳部に誘われている。"},{"spoiler":false,"text":"「ねぇ美帆、夏休み、一緒にバイトしない？」"}],"source":"bangumi","sourceCharacterId":"53067"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/440253525d8cd153b6e8cda867da4ae3481520098e39c6a2be36896b54d13b31.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26a27440403e5b3fc604b510acef9d13ec21396409bbb7f2297150b73718cd4a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:211163:53067:10026:1","source":"bangumi"}]},{"characterId":"char_c61976","characterName":"来栖 乃々果","sourceIds":{"bangumi":[{"characterId":"53068","match":"exact-normalized-name-in-linked-work","subjectId":"211163"}],"egsCharacterIds":["16142"],"vndbCharacterId":"c61976"},"originalCharacterName":"来栖 乃々果","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Besides her singing career, she is a solo idol who is also active in gravure and dramas."},{"spoiler":false,"text":"She recently appeared in a TV drama that has been well-received, and her acting career is expected to grow."},{"spoiler":false,"text":"She is participating in this cruise as one of the idols in her agency's fan event, \"A Cruising Tour with Idols.\""},{"spoiler":false,"text":"She has a cheerful personality and tends to seem like she doesn't think about anything, but she is actually very serious. She is also thinking carefully about her future, and is taking credits properly while continuing her idol activities."},{"spoiler":false,"text":"She plans to put an end to her idol activities when she graduates from university and become a music teacher."}],"source":"vndb","sourceCharacterId":"c61976"},{"segments":[{"spoiler":false,"text":"歌手活動の他、グラビアやドラマなどでも活躍しているソロアイドル。"},{"spoiler":false,"text":"最近出演したTVドラマで良い評判を得ていて、女優活動も期待されている。"},{"spoiler":false,"text":"今回のクルーズには、所属事務所のファンイベント「アイドルたちと一緒に過ごすクルージングツアー」のアイドルの一員として参加している。"},{"spoiler":false,"text":"陽気な性格で、何も考えていないように思われがちだが、実は真面目。将来についてもしっかり考えていて、アイドル活動をしつつもきちんと単位を取っている。"},{"spoiler":false,"text":"大学の卒業に合わせてアイドル活動には区切りをつけ、音楽教師になろうと思っている。"}],"source":"egs","sourceCharacterId":"16142","sourceWorkId":"25046","spoiler":false},{"segments":[{"spoiler":false,"text":"歌手やグラビア、ドラマなどでも活躍しているソロアイドル。 大学生。"},{"spoiler":false,"text":"最近出演したドラマで良い評判を得ていて、女優活動も期待されている。"},{"spoiler":false,"text":"今回のクルーズにはファンイベントのために参加した。"},{"spoiler":false,"text":"陽気で何も考えていないように思われがちだが、実はまじめな性格。"},{"spoiler":false,"text":"アイドル活動をしながらもきちんと単位を取得していて、"},{"spoiler":false,"text":"大学の卒業に合わせてアイドル活動に区切りをつけ、音楽教師になろうと考えている。"},{"spoiler":false,"text":"「アイドルは人に見られるお仕事だからね。 いろいろ気をつけないと」"}],"source":"bangumi","sourceCharacterId":"53068"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4dfc4cefdc45fc6981652e6a9c034d23846ea416d6867959f3dafa65b7ce3dde.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/369193fd8dd9c4b0fec670a91b0fceb917c00a2b7184bcab4925f21c94086e16.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中茉理花","creatorId":"vndb:s2571","sourcePersonId":"vndb:s2571","canonicalEntityId":"vndb:s2571","name":"田中 茉理花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:211163:53068:15994:1","source":"bangumi"}]},{"characterId":"char_c61977","characterName":"音羽 咲希","sourceIds":{"bangumi":[{"characterId":"53069","match":"exact-normalized-name-in-linked-work","subjectId":"211163"}],"egsCharacterIds":["16143"],"vndbCharacterId":"c61977"},"originalCharacterName":"音羽 咲希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Recently, she won a famous violin competition and has been in the limelight. She"},{"spoiler":false,"text":"usually has a gentle and relaxed demeanor, but when she plays the violin, she shows a dignified expression."},{"spoiler":false,"text":"She started playing the violin at a young age, but she always fell just short of the mark in competitions and was unable to achieve any results."},{"spoiler":false,"text":"However, she continued to practice harder than anyone else and finally saw results."},{"spoiler":false,"text":"She was invited to this cruise as a job."},{"spoiler":false,"text":"Because her family's finances are not easy, she thought about quitting the violin several times, but her parents let her continue, saying, \"It's okay.\""},{"spoiler":false,"text":"In order to repay her parents' feelings, she wants to become famous as a violinist, earn money, and make her parents' lives easier."}],"source":"vndb","sourceCharacterId":"c61977"},{"segments":[{"spoiler":false,"text":"つい最近、有名なバイオリンのコンクールで優勝し、脚光を浴びている。"},{"spoiler":false,"text":"普段はおっとりした雰囲気で、のんびりしているのだが、バイオリンを弾く時は凛々しい表情を見せる。"},{"spoiler":false,"text":"バイオリンは幼い頃に始めたのだが、コンクールなどではいつもあと一歩"},{"spoiler":false,"text":"届かず、成績は残せずにいた。"},{"spoiler":false,"text":"それでも地道に人一倍の練習を続けてきて、ようやく成果が出た。"},{"spoiler":false,"text":"今回のクルーズは仕事として招待された。"},{"spoiler":false,"text":"家計は楽ではないため、何度かバイオリンを辞めようと思ったのだが、両親は「大丈夫だから」と続けさせてくれた。"},{"spoiler":false,"text":"そんな両親の想いに報いるためにも、バイオリンで有名になってお金を稼ぎ、両親に楽をさせてあげたいと思っている。"}],"source":"egs","sourceCharacterId":"16143","sourceWorkId":"25046","spoiler":false},{"segments":[{"spoiler":false,"text":"最近 有名なヴァイオリンのコンクールで優勝し、脚光を浴びている女子校生。"},{"spoiler":false,"text":"普段はおっとりしているが、ヴァイオリンを弾く時は凛々しい表情を見せる。"},{"spoiler":false,"text":"幼い頃から地道に練習を重ね、艱難辛苦の先にようやく成果を挙げることができた。"},{"spoiler":false,"text":"今回のクルーズには仕事で招待されている。"},{"spoiler":false,"text":"家計は苦しく何度かヴァイオリンを辞めようと考えたが、両親が続けさせてくれた。"},{"spoiler":false,"text":"そんな両親に報いるためにも、有名になってお金を稼ぎ 楽をさせてあげたいと思っている。"},{"spoiler":false,"text":"「わたし、プロになってお父さんとお母さんに恩返ししたいんです」"}],"source":"bangumi","sourceCharacterId":"53069"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2cd0e5cad262e7822dfb3d1047b70325011e11d9e9b10e2108d0fa2c7227964.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54e035a538ca5c747ce5183ac47d75aeba099fc280b48f6dfd9c6dea3472c353.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:211163:53069:8580:1","source":"bangumi"}]},{"characterId":"char_c61978","characterName":"水梨 ナディア","sourceIds":{"bangumi":[{"characterId":"53070","match":"exact-normalized-name-in-linked-work","subjectId":"211163"}],"egsCharacterIds":["16144"],"vndbCharacterId":"c61978"},"originalCharacterName":"水梨 ナディア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is half Japanese, with a Japanese father and a Romanian mother."},{"spoiler":false,"text":"She was born and raised in Japan."},{"spoiler":false,"text":"After graduating from the school, she moved around overseas for a while, and then worked as a casino dealer in her mother's hometown, Romania."},{"spoiler":false,"text":"She was scouted there and started working at the Northern Lights casino."},{"spoiler":false,"text":"This voyage was her first job at the Northern Lights."},{"spoiler":false,"text":"She is fearless and is the type of person who says what she wants to say no matter who she is talking to."},{"spoiler":false,"text":"She is usually a friendly older sister, and quickly becomes friends with Miho, Jun, and the others."},{"spoiler":false,"text":"She has learned self-defense techniques since she was a child, and is merciless towards bad customers."},{"spoiler":false,"text":"Because of this, in Romania, she was treated as a bodyguard in addition to being a dealer."}],"source":"vndb","sourceCharacterId":"c61978"},{"segments":[{"spoiler":false,"text":"日本人の父とルーマニア人の母を両親に持つハーフ。"},{"spoiler":false,"text":"日本生まれの日本育ち。"},{"spoiler":false,"text":"学園卒業後、しばらく海外を転々とし、その後、母の故郷・ルーマニアでカジノのディーラーとして働いていた。"},{"spoiler":false,"text":"そこでスカウトされ、ノーザンライトのカジノで働く事になった。"},{"spoiler":false,"text":"今回の航行がノーザンライトでの初仕事。"},{"spoiler":false,"text":"物怖じしない性格で、誰が相手でもいうことははっきり言えるタイプ。"},{"spoiler":false,"text":"普段は気さくなお姉さんで、美帆や潤たちともすぐに仲良くなる。"},{"spoiler":false,"text":"幼い頃から護身術などを習っていて、たちの悪い客には容赦がない。"},{"spoiler":false,"text":"そのおかげで、ルーマニアではディーラーの他に用心棒的な扱いもされていた。"}],"source":"egs","sourceCharacterId":"16144","sourceWorkId":"25046","spoiler":false},{"segments":[{"spoiler":false,"text":"日本人の父とルーマニア人の母を持つハーフ。 日本生まれの日本育ち。"},{"spoiler":false,"text":"学園卒業後は海外を転々とし、その後はルーマニアでディーラーとして働いていた。"},{"spoiler":false,"text":"そこでスカウトされ、ノーザンライトのカジノで働くことになる。"},{"spoiler":false,"text":"幼い頃から護身術などを習っていて、タチの悪い客には容赦がない。"},{"spoiler":false,"text":"物怖じしない性格で、誰が相手でも言うことはハッキリ言えるタイプ。"},{"spoiler":false,"text":"普段は気さくなお姉さんで、美帆や潤ともすぐに仲良くなる。"},{"spoiler":false,"text":"「ここは紳士淑女の社交場よ。 礼儀を知らない輩はご退場願おうかしら」"}],"source":"bangumi","sourceCharacterId":"53070"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b6251ffdd4c04fb8e9d5117523c8056049f4cbe050786216aa3591032b1ea15.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/6903bb9e829e8717a9427e0f0f84be28cbc9c456d9fa5ff133720f808ebe610c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:211163:53070:6359:1","source":"bangumi"}]},{"characterId":"char_vndb_c155912","characterName":"染谷 茂夫","sourceIds":{"vndbCharacterId":"c155912"},"originalCharacterName":"染谷 茂夫","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"His father is the president of a major real estate company, and he works there."},{"spoiler":false,"text":"Although he is technically an employee, he doesn't go to work regularly and lives a life of his own accord."},{"spoiler":false,"text":"His father's company appears to be a normal real estate company, but behind the scenes they use underhanded tactics to boost their performance."},{"spoiler":false,"text":"He grew up seeing this dark side and emulated its methods himself, living a carefree life during his student days, manipulating his teachers and classmates."},{"spoiler":false,"text":"He is on this cruise under orders from his father, but he doesn't think too deeply about it and is only going on it for fun."},{"spoiler":false,"text":"He is extremely clingy with women, and likes to toy with them using various methods."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c155912"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c172322","characterName":"戸澤　龍一","sourceIds":{"vndbCharacterId":"c172322"},"originalCharacterName":"戸澤　龍一","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:91","sourceCompanyId":"egs:brand:91","canonicalEntityId":"egs:brand:91","name":"Guilty","roleCodes":["brand"],"identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-brand:40965:91","source":"egs"},{"companyId":"vndb:p15756","sourceCompanyId":"vndb:p15756","canonicalEntityId":"vndb:p15756","name":"SVN","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:160129:v20990","source":"vndb"},{"companyId":"vndb:p115","sourceCompanyId":"vndb:p115","canonicalEntityId":"vndb:p115","name":"Guilty","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:58079:v20990","source":"vndb"},{"companyId":"vndb:p115","sourceCompanyId":"vndb:p115","canonicalEntityId":"vndb:p115","name":"Guilty","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:58148:v20990","source":"vndb"},{"companyId":"vndb:p115","sourceCompanyId":"vndb:p115","canonicalEntityId":"vndb:p115","name":"Guilty","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:63151:v20990","source":"vndb"},{"companyId":"vndb:p115","sourceCompanyId":"vndb:p115","canonicalEntityId":"vndb:p115","name":"Guilty","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:63496:v20990","source":"vndb"},{"companyId":"vndb:p115","sourceCompanyId":"vndb:p115","canonicalEntityId":"vndb:p115","name":"Guilty","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:65584:v20990","source":"vndb"},{"companyId":"vndb:p187","sourceCompanyId":"vndb:p187","canonicalEntityId":"vndb:p187","name":"アイチェリー","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:65585:v20990","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
