atus":"source-native","relationId":"vndb:vn-staff:49270","source":"vndb"},{"creditedName":"Lip on Hip","creatorId":"vndb:s1083","sourcePersonId":"vndb:s1083","canonicalEntityId":"vndb:s1083","name":"Lip on Hip","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49272","source":"vndb"}]},"cast":[{"characterId":"char_c50380","characterName":"深野 水恵","sourceIds":{"bangumi":[{"characterId":"89068","match":"exact-normalized-name-in-linked-work","subjectId":"218686"}],"egsCharacterIds":["22678"],"vndbCharacterId":"c50380"},"originalCharacterName":"深野 水恵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"23"},"bust":{"reviewState":"source-only","source":"vndb","value":"105"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"J"},"hip":{"reviewState":"source-only","source":"vndb","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"23才、新任保健医。"},{"spoiler":false,"text":"男心をくすぐる最強の笑顔とバストの持ち主。"},{"spoiler":false,"text":"清潔感あふれるイメージで通っているが、実は年下の男のコに目がない。好きなコには何でもしてあげたいし、色々教えたいと思っているものの、現在、お相手はいない様子。"},{"spoiler":false,"text":"お尻の大きいことがちょっとコンプレックス。"},{"spoiler":false,"text":"まだ処女だという噂も……。"}],"source":"egs","sourceCharacterId":"22678","sourceWorkId":"8466","spoiler":false},{"segments":[{"spoiler":false,"text":"桃泉教育大学にて教員免許および養護教諭1種免許を取得して春風学園保健医に就任。今年で2年目の24歳になるが、現時点ではまだ23歳。"},{"spoiler":false,"text":"一見した感じは清潔感漂う保健の先生だが、大の年下好きで、好きになってしまうと徹底的に相手を情緒的＆性的にかわいがってしまうタイプ。好きだけどセックスしたくないというタイプではない。普段はエロエロでない分、セックスの時にはエロが全開になる。相手を気持ちよくさせたい、相手に気持ちよくなってほしいという気持ちが強いからだろう。"},{"spoiler":false,"text":"「この子なら……」と決めた相手に対しては、徹底的にかわいい子かわいい子しちゃう。元々の母性本能は強い。"},{"spoiler":false,"text":"年上への興味はまったくなし。オジサマ趣味もないし、キャリア志向もない。いい子を見つけて結婚して、いい奧様になりたいと思っている。子供は好きなので、子供は最低でも2人は欲しいと思っている。"}],"source":"bangumi","sourceCharacterId":"89068"}],"profileFacts":[{"label":"年龄（本版本）","value":"23 岁","valueContext":null,"source":"egs","sourceCharacterId":"22678","sourceWorkId":"8466","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"105 cm","valueContext":null,"source":"egs","sourceCharacterId":"22678","sourceWorkId":"8466","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"j","valueContext":null,"source":"egs","sourceCharacterId":"22678","sourceWorkId":"8466","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"22678","sourceWorkId":"8466","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"22678","sourceWorkId":"8466","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"22678","sourceWorkId":"8466","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56ee7d649187a21b678cca52cefbc0cdbda741a5fddaa533744848317e528a66.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f413e95ebe60971698db9c07fd564ec872f1d72d0492cb41a13da4e9d5281d4c.webp","width":100,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮下富三子","creatorId":"vndb:s1097","sourcePersonId":"vndb:s1097","canonicalEntityId":"vndb:s1097","name":"三園あすか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218686:89068:14968:1","source":"bangumi"}]},{"characterId":"char_c57503","characterName":"天宮 聖里香","sourceIds":{"bangumi":[{"characterId":"65211","match":"exact-normalized-name-in-linked-work","subjectId":"218685"}],"egsCharacterIds":["25112"],"vndbCharacterId":"c57503"},"originalCharacterName":"天宮 聖里香","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"95"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が一目惚れした爆乳コスプレイヤー。"},{"spoiler":false,"text":"その正体は、主人公の友人の姉で、紅艶女学院に通う三年生。"},{"spoiler":false,"text":"胸は95センチのGカップでスタイルは抜群。"},{"spoiler":false,"text":"美人だが、性格は、かなりきつく高飛車なところが難点。"}],"source":"egs","sourceCharacterId":"25112","sourceWorkId":"8120","spoiler":false},{"segments":[{"spoiler":false,"text":"紅艶女学院3年。修平の姉。スリーサイズは95G・55・85。みんながよく知っているアニメやコミック、ゲームのコスプレではなく、みんながあまり知らないコスプレ、自分でいいと思ったフィギュアのコスプレをしている。"},{"spoiler":false,"text":"性格はかなりきつく、高飛車。美人だが、一見して声をかけづらい。密かにコスプレをやっているが、それで人気者になろうとか、芸能界に行こうとかういう気もないらしい。ただの気晴らしで気まぐれに出ているだけの話。"},{"spoiler":false,"text":"実は、遺産を相続できないことになっている。弟とは異母兄弟。父親が密かに書いていた遺書を覗き見してしまってから、父親との関係が悪化してしまう。遺書を見たことは父親には話していない。彼女がどんどん高飛車になっていったのはそのあたりから。"},{"spoiler":false,"text":"「わたし、愛されていないのよ。娼婦の子なんだもの。芸者の娘なのよ。だから、こんなに淫乱なのよ」"}],"source":"bangumi","sourceCharacterId":"65211"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67fc3a83ce6e1589e4353643bb0ba07a3ae3cc6e95e388f9bb1aa5dfc546e7ea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13664e64ffe55bea5f197bd4e47294b5804ed4f71282ec0eba2cf17dc717c4f6.webp","width":141,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c50381","characterName":"横井 秀夫","sourceIds":{"vndbCharacterId":"c50381"},"originalCharacterName":"横井 秀夫","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"so