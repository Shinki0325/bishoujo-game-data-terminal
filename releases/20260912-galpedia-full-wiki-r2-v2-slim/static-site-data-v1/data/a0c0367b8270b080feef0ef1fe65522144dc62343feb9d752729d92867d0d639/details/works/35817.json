{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"35817","model":{"presentationWorkId":"egs:35817","staff":{"artwork":[],"scenario":[{"creditedName":"Linkedbrain Inc.(リンクトブレイン)","creatorId":"vndb:s23944","sourcePersonId":"egs:creator:36142","canonicalEntityId":"vndb:s23944","name":"Linkedbrain Inc.(リンクトブレイン)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:275687","source":"egs"}],"music":[],"other":[{"creditedName":"乾和音","creatorId":"vndb:s17985","sourcePersonId":"egs:creator:34488","canonicalEntityId":"vndb:s17985","name":"乾和音","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"auto-confirmed","relationId":"egs:work-creator:275686","source":"egs"},{"creditedName":"臼田裕次郎","creatorId":"vndb:s23733","sourcePersonId":"egs:creator:35021","canonicalEntityId":"vndb:s23733","name":"臼田裕次郎","detail":"企画原案、プロデューサー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:275692","source":"egs"}]},"cast":[{"characterId":"char_bangumi_169947","characterName":"Nagisa Hihara","sourceIds":{"bangumi":[{"characterId":"169947","match":"source-roster","subjectId":"481982"}]},"originalCharacterName":"Nagisa Hihara","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"射击武器：突击步枪"},{"spoiler":false,"text":"近战武器：战斗匕首"},{"spoiler":false,"text":"在秋叶原女仆咖啡厅打工的新人女仆，性格开朗活泼。治愈系的她，总是带着无忧无虑的笑容为主人们提供服务。"},{"spoiler":false,"text":"某天，她被卷入了蔓延于秋叶原的瘟疫中。虽然与凛香一同成功逃离，但双方都遭到了感染。"},{"spoiler":false,"text":"所幸，特殊抗体放缓了她的变异速度，让她在倒下之前得到了花音的救助。"},{"spoiler":false,"text":"为了拯救凛香，凪咲装备起了重型武器，决心与僵尸战斗。"},{"spoiler":false,"text":"在抗体与病毒的碰撞下，她的身体机能大幅提升，得到了超出常人好几倍的肌肉力量、动态视力、治愈能力与持久力。"}],"source":"bangumi","sourceCharacterId":"169947"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5ace86d62373804a570d3e5fbd4c1ebc66702e369d037ee01ee2b5d90182d1dc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83c88a3aca7da4b4ca9e0ac861e60f8b28bca8712498012e40001e561d427808.webp","width":146,"height":256,"source":"static-detail"},"actors":[{"creditedName":"礒部花凜","creatorId":"vndb:s33929","sourcePersonId":"vndb:s33929","canonicalEntityId":"vndb:s33929","name":"礒部 花凜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:481982:169947:20438:1","source":"bangumi"}]},{"characterId":"char_bangumi_169948","characterName":"Rinka Kazane","sourceIds":{"bangumi":[{"characterId":"169948","match":"source-roster","subjectId":"481982"}]},"originalCharacterName":"Rinka Kazane","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"射击武器：狙击步枪"},{"spoiler":false,"text":"近战武器：刀"},{"spoiler":false,"text":"与凪咲在同一家女仆咖啡厅打工的女仆服务生。"},{"spoiler":false,"text":"给周围人一种酷酷的印象，实际上只是不擅长与人交谈的社交障碍者。"},{"spoiler":false,"text":"虽然她与凪咲同年，但在女仆咖啡厅是前辈。经常教凪咲如何工作。"},{"spoiler":false,"text":"对于与自己完全相反、能以平常心对待所有人的凪咲抱有一种近乎仰慕的情感。"},{"spoiler":false,"text":"兴趣是玩游戏，尤其喜欢FPS。拥有在世界大赛中排名第二的实力，在该领域颇有名气。"}],"source":"bangumi","sourceCharacterId":"169948"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25a00af533a779606a24fda8064acbe298b0f0db406bb7f29b4272cc14856a87.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c203c323610ba4d4f7892a93fb34e7253cfede9dbda25d88838594f8e35f8118.webp","width":146,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Lynn","creatorId":"vndb:s27021","sourcePersonId":"vndb:s27021","canonicalEntityId":"vndb:s27021","name":"Lynn","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:481982:169948:15497:1","source":"bangumi"}]},{"characterId":"char_bangumi_169949","characterName":"Arisa Hikami","sourceIds":{"bangumi":[{"characterId":"169949","match":"source-roster","subjectId":"481982"}]},"originalCharacterName":"Arisa Hikami","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"射击武器：霰弹枪"},{"spoiler":false,"text":"近战武器：电锯"},{"spoiler":false,"text":"知名地下偶像团体“女仆偶像5”的成员。"},{"spoiler":false,"text":"瘟疫爆发时，“女仆偶像5”的其他成员与粉丝们都不幸感染成僵尸，只有她的变异速度因抗体而放缓，奇迹般地存活于剧场中等待救助。"},{"spoiler":false,"text":"哪怕面对着僵尸命悬一线，她的中二病言行也不会出现丝毫破绽。因此，被凪咲评价为“真中二病”。"}],"source":"bangumi","sourceCharacterId":"169949"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d7b873233466834f64874beb19d953527ec2ed2f1996ac662d0162528e63431.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c6904065661e5d1ca898d76bcfc5995129d85c8c405fc206a91a06142e60174.webp","width":146,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田憂希","creatorId":"vndb:s10197","sourcePersonId":"vndb:s10197","canonicalEntityId":"vndb:s10197","name":"高田 憂希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:481982:169949:18087:1","source":"bangumi"}]},{"characterId":"char_bangumi_169950","characterName":"Leyla Sanders","sourceIds":{"bangumi":[{"characterId":"169950","match":"source-roster","subjectId":"481982"}]},"originalCharacterName":"Leyla Sanders","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"射击武器：冲锋枪"},{"spoiler":false,"text":"近战武器：苦无"},{"spoiler":false,"text":"超级喜欢日本文化的留学生。"},{"spoiler":false,"text":"因沉迷忍者与女仆，在忍者主题的女仆咖啡厅做服务生。"},{"spoiler":false,"text":"是凛香在大学的学妹。偶然目睹凛香在剑道比赛上的出色表现后，出于仰慕开始称呼其为“前辈”。"},{"spoiler":false,"text":"时不时会冒出别扭的日语。虽说是通过动画片学习日语养成的坏习惯，但那似乎让她与愛璃咲之间产生了奇妙的化学反应。两人在亚文化的话题上聊得非常投缘。"}],"source":"bangumi","sourceCharacterId":"169950"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74759bcf606520a6cc2981d966a48adec4d0fe2f8ab2d9a7e60625bca2651155.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/371bfa3422db50f63db9933dc7c6cfcc0c3a65c8e14cd313f8a014085d2a15d7.webp","width":146,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村カンナ","creatorId":"vndb:s21092","sourcePersonId":"vndb:s21092","canonicalEntityId":"vndb:s21092","name":"中村カンナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:481982:169950:26994:1","source":"bangumi"}]},{"characterId":"char_bangumi_169951","characterName":"Otoha Tsuchiura","sourceIds":{"bangumi":[{"characterId":"169951","match":"source-roster","subjectId":"481982"}]},"originalCharacterName":"Otoha Tsuchiura","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"射击武器：迷你炮机枪"},{"spoiler":false,"text":"近战武器：晨星锤"},{"spoiler":false,"text":"从女仆咖啡厅这项事业的黎明期起，就以女仆服务生的身份深耕秋叶原的传奇女仆。她几乎认识秋叶原所有的女仆服务生，在女仆们眼中是像母亲一般的存在，深受大家的尊敬。"},{"spoiler":false,"text":"她为人稳重，但思维敏捷，善于洞察事件的本质。身为人生经验丰富的大姐姐，很乐于为年轻的凪咲一行人提供建议。"},{"spoiler":false,"text":"涉及年龄的话题是禁忌。"}],"source":"bangumi","sourceCharacterId":"169951"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/5064971eb3741d43b300f811c6178623e61d3fae19562c025fc93309a2b65ffb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf7d800173d391c9b12b5d33ca699d2f43507c1b4df0872498d05e641b7e2bce.webp","width":146,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黒木ほの香","creatorId":"vndb:s33581","sourcePersonId":"vndb:s33581","canonicalEntityId":"vndb:s33581","name":"黒木 ほの香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:481982:169951:26044:1","source":"bangumi"}]},{"characterId":"char_bangumi_169952","characterName":"Kanon Mikagami","sourceIds":{"bangumi":[{"characterId":"169952","match":"source-roster","subjectId":"481982"}]},"originalCharacterName":"Kanon Mikagami","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"她救助了因感染病毒而倒下的凪咲，是凭借凪咲含有抗体的血液开发出疫苗的天才研究员。设法帮助凪咲拯救了凛香。"},{"spoiler":false,"text":"从外表或许很难想象，其实已经接近30岁。"}],"source":"bangumi","sourceCharacterId":"169952"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52f969df57a43cc4b15f5ac3b5fda8f7f8b66b9274492a249477d8be2e104821.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28c3f92d40f6f4cb89899980a29021c80e33142470bba390e9bc93b9ca677242.webp","width":146,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春野杏","creatorId":"vndb:s20231","sourcePersonId":"vndb:s20231","canonicalEntityId":"vndb:s20231","name":"春野杏","roleCode":"voice-actor","roleL