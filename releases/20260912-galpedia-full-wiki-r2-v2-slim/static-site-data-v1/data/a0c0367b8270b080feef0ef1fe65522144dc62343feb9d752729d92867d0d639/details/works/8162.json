irmed","relationId":"egs:work-creator:21279","source":"egs"}],"music":[{"creditedName":"MANYO(まにょっ、Little Wing、六浦館)","creatorId":"vndb:s39","sourcePersonId":"egs:creator:2551","canonicalEntityId":"vndb:s39","name":"MANYO(まにょっ、Little Wing、六浦館)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:20037","source":"egs"}],"other":[{"creditedName":"真理絵(marie)","creatorId":"vndb:s47","sourcePersonId":"egs:creator:12359","canonicalEntityId":"vndb:s47","name":"真理絵(marie)","detail":"OP曲「toy memory」、ED曲「sapphirus」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:65077","source":"egs"},{"creditedName":"真理絵","creatorId":"vndb:s47","sourcePersonId":"vndb:s47","canonicalEntityId":"vndb:s47","name":"真理絵","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:13200","source":"vndb"},{"creditedName":"弘森 魚","creatorId":"vndb:s3705","sourcePersonId":"vndb:s3705","canonicalEntityId":"vndb:s3705","name":"弘森 魚","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:13203","source":"vndb"}]},"cast":[{"characterId":"char_c11087","characterName":"イナルナ・パム・バーミリオン","sourceIds":{"bangumi":[{"characterId":"145723","match":"exact-normalized-name-in-linked-work","subjectId":"225101"}],"egsCharacterIds":["25117"],"vndbCharacterId":"c11087"},"originalCharacterName":"イナルナ・パム・バーミリオン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"hip":{"reviewState":"source-only","source":"vndb","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"地下に拡がる巨大帝国の魔王にして第一皇女。"},{"spoiler":false,"text":"なぜか魔力もない主人公に召還され使い魔になってしまった。"},{"spoiler":false,"text":"自由の身になったら主人公を殺すっ！　と言いながらも、次第に新しい生活に馴染んじゃっているよう。"}],"source":"egs","sourceCharacterId":"25117","sourceWorkId":"8162","spoiler":false},{"segments":[{"spoiler":false,"text":"種族：魔族"},{"spoiler":false,"text":"地下に広がる巨大国家、魔族の国の第一王位継承者。"},{"spoiler":false,"text":"が、父である先代 の魔王が亡くなり跡目争いが勃発した際、意地悪な叔母に言葉巧みに騙され、地下牢へ幽閉されてしまう。"},{"spoiler":false,"text":"常に明るく、たまに落ち込む事はあれど絶対にくじけない前向きで明るい性格。幼くして幽閉されたせいか、基本的には世間知らずのお姫様。"},{"spoiler":false,"text":"そんなある日の事、床に突如として表れた召喚ゲートによって地上世界に飛ばされてしまう。"},{"spoiler":false,"text":"しかも飛ばされた先は、召喚術を行っていた主人公・真一の部屋。"},{"spoiler":false,"text":"突然のことにワタワタしている間に、真一の使い魔にされてしまう。"},{"spoiler":false,"text":"「自由になったらぜったいに殺すからな！　ホントに、ホントだぞ！"},{"spoiler":false,"text":"それまでは、私はお前のファミリアだ。ご奉仕するから覚悟しろ」"}],"source":"bangumi","sourceCharacterId":"145723"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"25117","sourceWorkId":"8162","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"147 cm","valueContext":null,"source":"egs","sourceCharacterId":"25117","sourceWorkId":"8162","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"25117","sourceWorkId":"8162","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"48 cm","valueContext":null,"source":"egs","sourceCharacterId":"25117","sourceWorkId":"8162","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f981aa5918ab3a0cf156c9252500d113ea4b2690b0fb033a51625c52129bec6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/8137704172921f75ef3803d3688a7318ab10473f877a03c619c1e47823f1bbb5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225101:145723:5922:1","source":"bangumi"}]},{"characterId":"char_c11088","characterName":"江口　こより","sourceIds":{"bangumi":[{"characterId":"145725","match":"exact-normalized-name-in-linked-work","subjectId":"225101"}],"egsCharacterIds":["25118"],"vndbCharacterId":"c11088"},"originalCharacterName":"江口　こより","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメートで愛称は委員長。"},{"spoiler":false,"text":"クラス委員で迷宮委員。"},{"spoiler":false,"text":"ついでに図書委員長をしているマジメな少女。"},{"spoiler":false,"text":"しかし、なぜか主人公とパムの行為を目撃したり、実家はラブホテルだったり…"},{"spoiler":false,"text":"エッチ方面に縁があるみたい。"}],"source":"egs","sourceCharacterId":"25118","sourceWorkId":"8162","spoiler":false},{"segments":[{"spoiler":false,"text":"種族：エルフ？"},{"spoiler":false,"text":"使い魔：シンディ（ローパー系の不定形生物）"},{"spoiler":false,"text":"真一のクラスメートであり、クラスの委員長を務めている女の子。スセリとは親友の間柄なので真一とは面識があるが、あまり話 したりはしない。むしろ真一の悪い噂（ナンパで様々な少女を毒牙にかけた 等）の方をよく知っているため、どちらかというと警戒気味だったりする。"},{"spoiler":false,"text":"家族関係で何かと苦労を抱えているようで、暗い表情を 見せることも多いが、根はしっかり者で優しい性格の女の子。"},{"spoiler":false,"text":"「真一くんっていい人だったんですね。噂ではそのぉ……"},{"spoiler":false,"text":"視線だけでエッチなコトして妊娠するって……ごめんなさいっ！」"}],"source":"bangumi","sourceCharacterId":"145725"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"25118","sourceWorkId":"8162","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"25118","sourceWorkId":"8162","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"25118","sourceWorkId":"8162","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"25118","sourceWorkId":"8162","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d8c28f32da44b3cee064016220bb46afea1e69671bec8d455cb34a2c00acbe8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9cf2577063e096a2b3aed3890c83bfa7d069e4c212a3782925644ea3c086b0e3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225101:145725:5741:1","source":"bangumi"}]},{"characterId":"char_c11089","characterName":"葦野 スセリ","sourceIds":{"bangumi":[{"characterId":"145724","match":"exact-normalized-name-in-linked-work","subjectId":"225101"}],"egsCharacterIds":["25119"],"vndbCharacterId":"c11089"},"originalCharacterName":"葦野 スセリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"69"},"height":{"reviewState":"no-conflict","source":"vndb","value":"143"},"hip":{"reviewState":"source-only","source":"vndb","value":"71"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公を兄と慕う幼なじみの少女。"},{"spoiler":false,"text":"お隣のパン屋の看板娘でもあり、得意料理は「たこ焼きメロンパン」"},{"spoiler":false,"text":"……味覚は少しおかしいみたいだ。"},{"spoiler":false,"text":"彼女はこの世界まれなハイエルフで、世界最強の魔法使いでもある。"}],"source":"egs","sourceCharacterId":"25119","sourceWorkId":"8162","spoiler":false},{"segments":[{"spoiler":false,"text":"種族：エルフ（ハイ・エルフ）"},{"spoiler":false,"text":"使い魔：ぷちな（プラチナドラゴン）"},{"spoiler":false,"text":"真一宅のご近所にある、美味しいと評判のパン屋の一人娘。"},{"spoiler":false,"text":"真一とは幼なじみの間柄であり、幼い頃から同い年の真一を「お兄ちゃん」と呼び慕っている。"},{"spoiler":false,"text":"性格は、ほんわかしていて、素直で、天真爛漫。全て の物事を前向きに受け止め、「スセリの側だけ時間の流れがゆったりしてるよね」と友達に言われるくらい癒される、穏やかな女の子。 少し天然系な事もあり、男女問わずクラスメートからの人気が高い。"},{"spoiler":false,"text":"「お兄ちゃんが、今日は、たこ焼きメロンパンって作ったんだよ！"},{"spoiler":false,"text":"たくさん食べてね」"}],"source":"bangumi","sourceCharacterId":"145724"}],"profileFacts":[{"label":"胸围（本版本）","value":"69 cm","valueContext":null,"source":"egs","sourceCharacterId":"25119","sourceWorkId":"8162","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"143 cm","valueContext":null,"source":"egs","sourceCharacterId":"25119","sourceWorkId":"8162","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"71 cm","valueContext":null,"source":"egs","sourceCharacterId":"25119","sourceWorkId":"8162","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"43 cm","valueContext":null,"source":"egs","sourceCharacterId":"25119","sourceWorkId":"8162","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3a13232c75aee582529d6f940b319ee0fb7af7b81e6af5348e7aa25ab2db259.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/758ec1189a7d3e461978b23a5cb51917be1b9860e6a37c27abacf4fb96a501c0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225101:145724:4830:1","source":"bangumi"}]},{"characterId":"char_c11090","characterName":"リュセ・ル・チリペッパー","sourceIds":{"bangumi":[{"characterId":"145726","match":"exact-normalized-name-in-linked-work","subjectId":"225101"}],"egsCharacterIds":["25120"],"vndbCharacterId":"c11090"},"originalCharacterName":"リュセ・ル・チリペッパー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"172"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"エルフの元となった神獣族の女の子。"},{"spoiler":false,"text":"魔王一家を根絶やしにするため、何者かに送り込まれてきた。"},{"spoiler":false,"text":"しかし、記憶を失いパムや主人公の世話になるハメに。"},{"spoiler":false,"text":"見た目は年上のお姉さんだが、性格は素直なお子ちゃまタイプ。"}],"source":"egs","sourceCharacterId":"25120","sourceWorkId":"8162","spoiler":false},{"segments":[{"spoiler":false,"text":"種族：神獣族"},{"spoiler":false,"text":"使い魔：赤兎（セキト。赤毛の一角ウサギ）"},{"spoiler":false,"text":"物語の序盤に、真一の住む街・真ヨコハマ市にやってくる女の子。父親と一緒に旅をしていたらしいが、父親とはぐれて住む場所もなかった。しばらく真一の家に厄介になることになるが、父親と再会後は公園のブルーテントで暮らしている変わり者。"},{"spoiler":false,"text":"性格は生真面目で、義理堅いところもあるが、あまりモノを知らず、むちゃくちゃな行動を取ることが多々ある。精神年齢も低い模様。"},{"spoiler":false,"text":"「リュセには何か重要な使命があったのです。"},{"spoiler":false,"text":"でも思い出せないのです……まさかあなたが私のお父さん?!」"}],"source":"bangumi","sourceCharacterId":"145726"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"25120","sourceWorkId":"8162","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"172 cm","valueContext":null,"source":"egs","sourceCharacterId":"25120","sourceWorkId":"8162","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"25120","sourceWorkId":"8162","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"25120","sourceWorkId":"8162","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/5338fd26326be9977b605140998fe558da56c9a589c8a6338d57572c0dbbd050.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9dcf8a29dfd71647965b2bf3aa2100e8ee405f04789869bc0eefb8c7d00dfee.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩居由希子","creatorId":"vndb:s1160","sourcePersonId":"vndb:s1160","canonicalEntityId":"vndb:s1160","name":"岩居 由希子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225101:145726:4163:1","source":"bangumi"}]},{"characterId":"char_c11091","characterName":"江口 飛鳥","sourceIds":{"bangumi":[],"egsCharacterIds":["25121"],"vndbCharacterId":"c11091"},"originalCharacterName":"江口 飛鳥","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真一達が通う学園の学生会会長。"},{"spoiler":false,"text":"文武両道、誰にでも優しく、美形で身長も高く、聖騎士の称号も持っていて魔法も自在に使いこなす完全無欠の好青年！"},{"spoiler":false,"text":"……なのだが、同性愛者。"},{"spoiler":false,"text":"しかも真一に興味津々。何とかして真一を「攻略」しようと画策中。"},{"spoiler":false,"text":"委員長である江口こよりとは二卵性双生児。"}],"source":"egs","sourceCharacterId":"25121","sourceWorkId":"8162","spoiler":false}],"profileFacts":[{"label":"身高（本版本）","value":"180 cm","valueContext":null,"source":"egs","sourceCharacterId":"25121","sourceWorkId":"8162","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f97bb758f4fd08164b70d700e187f7b236bef49ae696618f4c75512ae1761dd.webp"