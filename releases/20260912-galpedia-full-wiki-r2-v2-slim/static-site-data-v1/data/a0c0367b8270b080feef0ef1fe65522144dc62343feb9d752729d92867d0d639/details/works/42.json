雄一","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:15369","source":"vndb"},{"creditedName":"TAC","creatorId":"vndb:s35061","sourcePersonId":"vndb:s35061","canonicalEntityId":"vndb:s35061","name":"TAC","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:15370","source":"vndb"},{"creditedName":"TAC","creatorId":"vndb:s35061","sourcePersonId":"vndb:s35061","canonicalEntityId":"vndb:s35061","name":"TAC","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:15372","source":"vndb"},{"creditedName":"JENNI","creatorId":"vndb:s35062","sourcePersonId":"vndb:s35062","canonicalEntityId":"vndb:s35062","name":"JENNI","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:15373","source":"vndb"},{"creditedName":"K.SAIKI","creatorId":"vndb:s35063","sourcePersonId":"vndb:s35063","canonicalEntityId":"vndb:s35063","name":"K.SAIKI","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:15374","source":"vndb"},{"creditedName":"NoBuyuki","creatorId":"vndb:s35064","sourcePersonId":"vndb:s35064","canonicalEntityId":"vndb:s35064","name":"NoBuyuki","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:15375","source":"vndb"},{"creditedName":"KTI","creatorId":"vndb:s35065","sourcePersonId":"vndb:s35065","canonicalEntityId":"vndb:s35065","name":"KTI","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:15376","source":"vndb"},{"creditedName":"奈々緒 一直","creatorId":"vndb:s35072","sourcePersonId":"vndb:s35072","canonicalEntityId":"vndb:s35072","name":"奈々緒 一直","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:15377","source":"vndb"}]},"cast":[{"characterId":"char_c13946","characterName":"セリカ・シルフィル","sourceIds":{"bangumi":[{"characterId":"1763","match":"exact-normalized-name-in-linked-work","subjectId":"12119"},{"characterId":"1763","match":"exact-normalized-name-in-linked-work","subjectId":"88429"}],"egsCharacterIds":["3202"],"vndbCharacterId":"c13946"},"originalCharacterName":"セリカ・シルフィル","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"b"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the Ikusa Megami series. A swordsman who has been wandering from place to place for hundreds of years. Having obtained the body of a goddess through godslaying, he is chased by every deity and nation due to that sin, fighting off many assassins."}],"source":"vndb","sourceCharacterId":"c13946"},{"segments":[{"spoiler":false,"text":"女神の肉体を持ち、鋭い剣技を習得した主人公。"},{"spoiler":false,"text":"しかし、女神の肉体を完全には支配しきれておらず、"},{"spoiler":false,"text":"状況によって、女性特有の丸みを帯びてしまうことも。"},{"spoiler":false,"text":"同盟関係にある水の巫女からの依頼で、"},{"spoiler":false,"text":"魔神封鎖地の調査に向かったのだが……。"}],"source":"egs","sourceCharacterId":"3202","sourceWorkId":"2341","spoiler":false},{"segments":[{"spoiler":false,"text":"本編主人公。"},{"spoiler":false,"text":"冒険者達の守護神や、開拓の神として崇められている嵐の神（バリハルト）の神官戦士。"},{"spoiler":false,"text":"純粋で正義感が強く、平和を愛する人柄と、卓越した剣の腕前、そして潜在する大きな魔法能力から「勇者」と呼ばれこともあるが、本人はそれを好ましく思っていない。"},{"spoiler":false,"text":"しかし、自分の身を顧みない勇ましいその戦いぶりは、勇者と呼ばれるに相応しい。"}],"source":"egs","sourceCharacterId":"3202","sourceWorkId":"6134","spoiler":false},{"segments":[{"spoiler":false,"text":"女神アストライアの肉体を持つ放浪の剣士。"},{"spoiler":false,"text":"人々から神殺しと呼ばれ畏怖と神話の対象とされ、"},{"spoiler":false,"text":"すべての神々の敵となり、数々の戦いで仲間や心を失いながらも、"},{"spoiler":false,"text":"剣に封じられた仇敵の魔神ハイシェラと共に旅を続けている。"},{"spoiler":false,"text":"気紛れでエクリアを連れて歩くことになったが、"},{"spoiler":false,"text":"苦悩するエクリアを見て、失われていた過去や未来を模索するようになる。"}],"source":"egs","sourceCharacterId":"3202","sourceWorkId":"11748","spoiler":false},{"segments":[{"spoiler":false,"text":"女神アストライアという古神(いにしえがみ)の肉体を持つ本編の主人公。そのため人々より「神殺し」と呼ばれ畏怖され、常に狙われる存在として数百年の間世界を渡り歩いてきた。"},{"spoiler":false,"text":"近年の大きな戦(戦女神VERITA時)にて大きく力を失ってしまった神殺しだが、盟友「水の巫女」の依頼を受けてレウィニア王女の調査でミルフェの街に赴くことになった。"}],"source":"egs","sourceCharacterId":"3202","sourceWorkId":"19878","spoiler":false},{"segments":[{"spoiler":false,"text":"女神を殺しその体を奪った神殺しとして現神からは古神の肉体を持っているために、古神からは同胞殺しとして、魔神など闇勢力からは体を奪い力を手に入れるために"},{"spoiler":false,"text":"現神勢力の人間達からはその伝説により、世界中から畏れられ狙われている。また、女神の体を奪ったことで神核を得、神格者にも分類される。"},{"spoiler":false,"text":"女神の体を男性体として維持する為魔力が必要。枯渇すると女性の体になってしまう上にほとんど行動も不能になってしまう。"},{"spoiler":false,"text":"しかし、現神への信仰から魔力を生み出すことが古神の体を持っているためにできないため、その魔力の補給は敵を屠って吸収するか性魔術で得るしかない。"},{"spoiler":false,"text":"飛燕剣と呼ばれる剣技を得意とし、秘印系の魔術、特に電撃系を使用する。"},{"spoiler":false,"text":"なお、相棒に魔剣となったハイシェラがいるが、常に剣となった彼女を武器に使用しているわけではなく、現地調達した武器を使用することも多い。"},{"spoiler":false,"text":"またその際、飛燕剣はそのスピードを生かすために武具の重量が重要になるため、重量には気を使っている。"},{"spoiler":false,"text":"その戦闘力は神殺しの名の通り凄まじく、魔神ですら容易に打ち倒す。歴戦の勇士で半魔人のリウイも、VERITAでは防戦一方だった（闇ルートを除く）。"}],"source":"bangumi","sourceCharacterId":"1763"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"1763","value":"古神/人类"}],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"b","source":"vndb","sourceCharacterId":"c13946","value":"b"},{"comparisonValue":"m","source":"egs","sourceCharacterId":"3202","value":"男性"},{"comparisonValue":"m","source":"egs","sourceCharacterId":"3202","value":"男性"},{"source":"bangumi","sourceCharacterId":"1763","value":"男/女"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/cea8a01974f496cb6de4805eab23012b01df605485c23c64b3b5a72a28b60c9a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdd307bb6b3d24b034a98707d2eb494b308d70da16ce69f7d7907e441fc85e1f.webp","width":118,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c25922","characterName":"シュリ・レイツェン","sourceIds":{"bangumi":[{"characterId":"21494","match":"exact-normalized-name-in-linked-work","subjectId":"88429"}],"egsCharacterIds":["3203"],"vndbCharacterId":"c25922"},"originalCharacterName":"シュリ・レイツェン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"セリカのメイドNo.3にして、第三使徒。"},{"spoiler":false,"text":"エクリアほどではないが、セリカの魔力を効率よく引き継いだため、"},{"spoiler":false,"text":"魔法使いとしても優秀なタイプ。"},{"spoiler":false,"text":"神格位を持つセリカに対し、特別な想いを寄せるメイドたちの中で、"},{"spoiler":false,"text":"彼女の想いは、誰よりも強い。"}],"source":"egs","sourceCharacterId":"3203","sourceWorkId":"2341","spoiler":false},{"segments":[{"spoiler":false,"text":"一面の小麦畑に埋もれたような農村(イストの村)で暮らしている少女。"},{"spoiler":false,"text":"戦乱の影響か、言葉を発することもせず、感情も表に出さない。"},{"spoiler":false,"text":"とある事件の後にセリカに身請けされ、徐々に感情を取り戻していく。"}],"source":"egs","sourceCharacterId":"3203","sourceWorkId":"11748","spoiler":false},{"segments":[{"spoiler":false,"text":"女神体を維持するためにセリカと使徒の契りを交わした娘。"},{"spoiler":false,"text":"使徒として3番目の契約者であり、使用人としては見習いであるため今回の旅では修行を兼ねて同行を許された唯一の従者である。"},{"spoiler":false,"text":"夜伽を含めた身の周りの世話を献身的に行い、秘められた器用さと魔力から新しい能力が開花していく。"}],"source":"egs","sourceCharacterId":"3203","sourceWorkId":"19878","spoiler":false},{"segments":[{"spoiler":false,"text":"神杀的第三使徒"},{"spoiler":false,"text":"「これをこれを掛け合わせれば……。 よしっ、上手く出来ましたっ！」"},{"spoiler":false,"text":"为了维持男性体和赛利卡交换使徒之契的女孩。"},{"spoiler":false,"text":"作为使徒是第３号的契约者，作为佣人因为是见习把此次的旅行兼作修行，而被容许同行的唯一的从者。 献身地进行包括夜伽在内的贴身的帮助，因为与生俱来的才能和魔力被隐藏的新的能力开花结果了。"}],"source":"bangumi","sourceCharacterId":"21494"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fedf2b03ca9db75c1eb94c7b342a6a7ad5e6143c08badc13cc24d090d71c120d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d6644dae361a51e89213fde6c1118ade81c85b413c0c45411bdb15aed1d95f8.webp","width":106,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c25923","characterName":"レヴィア・ローグライア","sourceIds":{"bangumi":[{"characterId":"22523","match":"exact-normalized-name-in-linked-work","subjectId":"88429"}],"egsCharacterIds":["3204"],"vndbCharacterId":"c25923"},"originalCharacterName":"レヴィア・ローグライア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"レウィニア所属の白地龍騎士団軍団長。"},{"spoiler":false,"text":"騎士道一直線でプライドが高く、責任感も非常に高いタイプ。"},{"spoiler":false,"text":"性根では優しい所もあるのだが、それを表に出すことはあまりない。"},{"spoiler":false,"text":"水の巫女の勅命で、前作に引き続き行動を共にする。"}],"source":"egs","sourceCharacterId":"3204","sourceWorkId":"2341","spoiler":false},{"segments":[{"spoiler":false,"text":"リカの盟友「水の巫女」が統治するレウィニア神権国の第11軍団、通称「白地龍騎士団」の若き軍団長。"},{"spoiler":false,"text":"軍団長の中では最年少ではあるが、剣技、神聖系魔術に優れ、実直な騎士道精神を持ち合わせていることから、とりわけ庶民や部下の人気が高い。"},{"spoiler":false,"text":"しかし、セリカと同じく昨年に起きた大きな戦で3000名の部隊が壊滅的な打撃を受けて再編成中な上に、大昔に失踪した王女捜索という軍隊らしからぬ任命を受けてしまう。"}],"source":"egs","sourceCharacterId":"3204","sourceWorkId":"19878","spoiler":false},{"segments":[{"spoiler":false,"text":"白地龙骑士团・军团长"},{"spoiler":false,"text":"「女である前に私は騎士だ。 守るべき者を置いて退く訳にはいかない」"},{"spoiler":false,"text":"赛利卡的盟友“水之巫女”统治的莱维尼亚神权国（レウィニア神権国）的第11军团，通称“白地龙骑士团”的年轻的军团长。"},{"spoiler":false,"text":"虽然是最年少，但是剑技、神圣系魔术优秀，具有正直的骑士精神，特别在平民与部下中的人气很高。 在战斗中受到严重损害，部队再编中收到了搜索王女这种不像军队风格的任命。"}],"source":"bangumi","sourceCharacterId":"22523"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/5927935b72ca5844c6e8992e412273ce3f3d596ff2f2d97ee45c708d8e5b8f86.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2d008e9911e64c95278f4790c60d4066b766782e245a9bade5a2da66bf46208.webp","width":179,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c30621","characterName":"ハイシェラ","sourceIds":{"bangumi":[{"characterId":"1766","match":"exact-normalized-name-in-linked-work","subjectId":"12119"},{"characterId":"1766","match":"exact-normalized-name-in-linked-work","subjectId":"88429"}],"egsCharacterIds":["3219"],"vndbCharacterId":"c30621"},"originalCharacterName":"ハイシェラ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"1月1日"},"bloodType":{"reviewState":"no-conflict","source":"bangumi","value":"4"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"178cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"58kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"セリカの剣に封じられた魔神。"},{"spoiler":false,"text":"かつて神殺しの身体を執拗に狙ってきたライバルだった。"},{"spoiler":false,"text":"セリカ(とエクリア)だけに通じる心の会話で冒険の指南をしてくれる。"}],"source":"egs","sourceCharacterId":"3219","sourceWorkId":"11748","spoiler":false},{"segments":[{"spoiler":false,"text":"かつてセリカを付け狙い、激戦を繰り返していた宿敵の女魔神。"},{"spoiler":false,"text":"神殺しに敗れてからは自らを剣の中に宿し、女神化の影響で記憶の失われるセリカに助言する保護者となった。"},{"spoiler":false,"text":"会話は互いの心話によって成り立っており、周囲の者にはハイシェラの声は届かない。"},{"spoiler":false,"text":"先の大戦でかなりの力を失ったセリカでは、現在の魔剣を扱うことが叶わず、ハイシェラは刀身より放出される魔神の力を抑えるためにあえて短剣の姿に変え、主人の復活を見守っている。"}],"source":"egs","sourceCharacterId":"3219","sourceWorkId":"19878","spoiler":false},{"segments":[{"spoiler":false,"text":"セリカが持つ剣に封じられている魔神。人間であった頃のセリカを知る数少ない人物の一人でもある。"},{"spoiler":false,"text":"ディル=リフィーナの世界が誕生する以前から生きており、元はネイ=ステリナ（剣と魔法の世界）の魔族であったが、何らかのきっかけでイアス=ステリナ（地球）に漂着した。"},{"spoiler":false,"text":"人間の科学者たちの手によって機工女神に改造され、その強大な力でやがて『地の魔神』と呼ばれ怖れられる。"},{"spoiler":false,"text":"マクルの街の神殿にて多くの悲劇を目の当たりにし、生きることに疲れたセリカの心の隙をつき、その女神アストライアの肉体を奪うことに成功する。"},{"spoiler":false,"text":"そして、多くの魔神達を従えてケレース地方で勢力を築き、イソラ、ガンナシア、ターペ＝エトフといった国々を滅ぼす。"},{"spoiler":false,"text":"この頃のハイシェラは、潔しを好み卑怯を憎む一方、残虐・享楽的な面も強く、気まぐれに他者の運命を弄ぶ行いも少なくなかった。"},{"spoiler":false,"text":"その後、オメールの遺跡にてセリカが眠りより目覚めることになり、女神の身体をセリカへ返すことになる。"},{"spoiler":false,"text":"セリカへ身体を返した際に、女神の身体を失ったのみならずセリカの魂とも別れたことに大きな喪失感を感じ、セリカを想うようになる。"},{"spoiler":false,"text":"挾間の宮殿での決戦を前に、さらなる力の充実を図るため、セリカと女神の身体を賭けて勝負することになる。"},{"spoiler":false,"text":"紅き月神殿での勝負に敗れ、その身を吸収されることを望むが、セリカはこれを拒否。ハイシェラを殺したくないとわがままを言う彼に、魔剣となって彼の傍で共に生きてゆくことを決意する。"},{"spoiler":false,"text":"記憶が虚ろいやすいセリカに代わり、その果てなき運命の全てを共に見、全てを彼の代わりに記憶する、セリカの半身ともいえる存在となった。"},{"spoiler":false,"text":"ハイシェラはセリカに初めて会ったのは紅き月神殿と教えているが、真実はニアクール遺跡での出会いが最初である。"},{"spoiler":false,"text":"永き時を生きてきたためか、様々な知識を蓄えており、セリカやエクリアを助けることもある。"},{"spoiler":false,"text":"どこで覚えたのかその知識は溺れた者の快方の仕方やメイドの仕事、花輪の作り方まで幅広い。"}],"source":"bangumi","sourceCharacterId":"1766"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"1766","value":"人造魔神"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/922f3a191226c9f2c322a32784fb2c3af33bba9aca760a9d4a21d5b5ce3fad7d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74c00de6664a22c8930d015a9b9d3554a9b32e664a745aae84d60a3cf4cf50ae.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c49864","characterName":"ラティナ・ティン・レウィニア","sourceIds":{"bangumi":[],"egsCharacterIds":["3220"],"vndbCharacterId":"c49864"},"originalCharacterName":"ラティナ・ティン・レウィニア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"レウィニア王家の元第四王女。ローレン卿の婚約者で約１８年前の行方不明事件から次第に忘れ去られた存在だった。"},{"spoiler":false,"text":"最近になって如何なる理由か、ミルフェ周辺で半霊体の姿で人々から精気を奪い去っていく姿が目撃される。"},{"spoiler":false,"text":"本国はその噂を手掛かりにセリカ達を派遣するに至った。"},{"spoiler":false,"text":"先んじて情報を入手したローレン卿が何らかの鍵といわれる。"}],"source":"egs","sourceCharacterId":"3220","sourceWorkId":"19878","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9cc582d778256ad8f2afac306c607b2e80684a6582e4beca6debdce4aba9066a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1ac66529e91e26437746e126387f1781b85ca1845b90dbc3f1fd430932d97665.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c49955","characterName":"リ・クアルー","sourceIds":{"bangumi":[{"characterId":"46402","match":"exact-normalized-name-in-linked-work","subjectId":"88429"}],"egsCharacterIds":["3212"],"vndbCharacterId":"c49955"},"originalCharacterName":"リ・クアルー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"下半身が強固な竜鱗に覆われた大蛇の尾を持つ龍人(ナーガ)族の娘。"},{"spoiler":false,"text":"元々古神に属する古い血統と長さ寿命を持ち、古風ながら品のある口調が特徴の一族の王女だったが、現在ははるか南に位置するディジェネール地方の隠れ里より連れられて八守護者のひとりとして幽閉されている。"}],"source":"egs","sourceCharacterId":"3212","sourceWorkId":"19878","spoiler":false},{"segments":[{"spoiler":false,"text":"作为第八守护者的龙人王女"},{"spoiler":false,"text":"「我等が神の眷属であったのは昔の事だ。 今の我等は古の神とは関係ない」"},{"spoiler":false,"text":"下半身が强固な竜鳞に覆われた大蛇の尾を持つ龙人(ナーガ)族の娘。"},{"spoiler":false,"text":"元々古神に属する古い血统と长さ寿命を持ち、古风ながら品のある口调が特徴の一族の王女だったが、现在ははるか南に位置するディジェネール地方の隠れ里より连れられて八守护者のひとりとして幽闭されている。"}],"source":"bangumi","sourceCharacterId":"46402"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/8976f1df3a06b254e6c9d5e7a38fd75523e6c5c17ceadae0ef9e15e45ba0bec6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22c8f7988c61d36461912a81b55ff0d8fdc6acdc2cdea4680f4c3024d16be871.webp","width":179,"height":256,"source":"static-detail"},"actors":[]},{"characterId"