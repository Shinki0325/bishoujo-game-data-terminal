{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"14529","model":{"presentationWorkId":"vndb:v5494","staff":{"artwork":[{"creditedName":"ハサ西","creatorId":"vndb:s7501","sourcePersonId":"egs:creator:14280","canonicalEntityId":"vndb:s7501","name":"ハサ西","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:90526","source":"egs"}],"scenario":[{"creditedName":"紅羽一葉","creatorId":"vndb:s7502","sourcePersonId":"egs:creator:4714","canonicalEntityId":"vndb:s7502","name":"紅羽一葉","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:90527","source":"egs"}],"music":[{"creditedName":"斉藤康仁","creatorId":"vndb:s5931","sourcePersonId":"egs:creator:4797","canonicalEntityId":"vndb:s5931","name":"斉藤康仁","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:298894","source":"egs"}],"other":[{"creditedName":"紅羽一葉","creatorId":"vndb:s7502","sourcePersonId":"egs:creator:4714","canonicalEntityId":"vndb:s7502","name":"紅羽一葉","detail":"企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:158924","source":"egs"},{"creditedName":"ハサ西","creatorId":"vndb:s7501","sourcePersonId":"vndb:s7501","canonicalEntityId":"vndb:s7501","name":"ハサ西","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:57832","source":"vndb"},{"creditedName":"紅羽 一葉","creatorId":"vndb:s7502","sourcePersonId":"vndb:s7502","canonicalEntityId":"vndb:s7502","name":"紅羽 一葉","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:57835","source":"vndb"}]},"cast":[{"characterId":"char_c76725","characterName":"尾崎","sourceIds":{"bangumi":[{"characterId":"18576","match":"exact-normalized-name-in-linked-work","subjectId":"61406"}],"egsCharacterIds":["11041"],"vndbCharacterId":"c76725"},"originalCharacterName":"尾崎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a member of the “Project for the Return of Wounded and Injured Soldiers with Alternative Human Organs” and a member of the military."},{"spoiler":false,"text":"He is a technical captain in the Imperial Navy. He is an expert in immunology, cardiology, and surgery. He has mixed feelings about the treatment of his “work” and “Rei,” but does not reveal them publicly."},{"spoiler":false,"text":"However, since “Rei” and “Kaon” are experimental samples necessary for the advancement of his research, he will do anything to keep them alive. Basically, he has no morals and puts his own inquisitiveness above all else."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c76725"},{"segments":[{"spoiler":false,"text":"主人公。"},{"spoiler":false,"text":"「代替人体器官ニ依ル戦傷兵復帰計画」の実働メンバーの一人で、軍属。"},{"spoiler":false,"text":"階級は帝国海軍所属の技術大尉。"},{"spoiler":false,"text":"免疫学と循環器、及び外科のエキスパート。"},{"spoiler":false,"text":"自分の「作品」である「零」の扱いについて複雑な思いがあるが、表向きには出さない。"},{"spoiler":false,"text":"ただし、「零」そして「華音」は研究を昇華させるために必要な実験サンプルであるため、彼女らを生かすためには何でもする。"},{"spoiler":false,"text":"基本的にモラルは無く、自分の探求心を何よりも優先させる。"}],"source":"egs","sourceCharacterId":"11041","sourceWorkId":"14529","spoiler":false},{"segments":[{"spoiler":false,"text":"『代替人体器官的战伤士兵复归计划』的实际成员之一的军属。"},{"spoiler":false,"text":"军衔时帝国海军所属的技术大尉。是免疫学、循环器官以及外科的专家。"},{"spoiler":false,"text":"对于自己的“作品”零的对待方式有着复杂的想法，但是不会表现出来。"},{"spoiler":false,"text":"因为“零”和“华音”是升华研究所必需的实验样本，为了能让她们活下去什么都愿意做。"},{"spoiler":false,"text":"基本上没有道德，会将自己的探索心放在首位。"}],"source":"bangumi","sourceCharacterId":"18576"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/6503e39914bb889c085aea352dd36844542fc5ad0164f3a5253bd631011d25ab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4faacad66b927499bf1ef8905175f3fb7d605cd53bbfb223f99c8112f95cc62.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c76727","characterName":"森田 華音","sourceIds":{"bangumi":[{"characterId":"18560","match":"exact-normalized-name-in-linked-work","subjectId":"61406"}],"egsCharacterIds":["11040"],"vndbCharacterId":"c76727"},"originalCharacterName":"森田 華音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The sub heroine. She is a nurse (military nurse) in an old-fashioned nurse's uniform. She is always taciturn, and when she speaks out, she does so in a definitive tone, but she is obedient to Ozaki's orders."},{"spoiler":false,"text":"Kaon is one of Ozaki's “works,” and organs from the human body of “Rei” have been transplanted into her. He has also conducted several other experiments on Kaon."},{"spoiler":false,"text":"The results sometimes surface in the form of physical illness or loss of mental equilibrium. She worships Ozaki, and her jealousy of Rei's beauty and the way Ozaki treats her leads her to madness."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c76727"},{"segments":[{"spoiler":false,"text":"サブヒロイン。狂言回し。"},{"spoiler":false,"text":"古風なナース服を着た看護婦（従軍看護婦）だが、どちらかというと尾崎の助手といった趣がある。"},{"spoiler":false,"text":"常に寡黙で、発言するときは断定的な口調になるが、尾崎の命令には従順。"},{"spoiler":false,"text":"華音も尾崎の「作品」のひとつであり、「零」の人間時の臓器は華音に移植されている。"},{"spoiler":false,"text":"他にもいくつかの実験が施されており、ときおりそれが体調不良や精神の平衡を欠いたりする形で表面化する。"},{"spoiler":false,"text":"尾崎を崇拝し、零の美しさや尾崎からの扱われ方に嫉妬し、狂気を深めてゆく。"}],"source":"egs","sourceCharacterId":"11040","sourceWorkId":"14529","spoiler":false},{"segments":[{"spoiler":false,"text":"虽然是一名身穿旧式护士服的护士（从军护士），但总的来说是尾崎的助手。"},{"spoiler":false,"text":"总是沉默寡言，在发言时会变成严厉断定的语气，不过会听从尾崎的命令。"},{"spoiler":false,"text":"华音也是尾崎的“作品”之一，“零”作为人类时期的内脏都移植到华音身上。"},{"spoiler":false,"text":"同时还实施了其他数个实验，这些问题偶尔会以身体不适或者精神紊乱的形式表现出来。"},{"spoiler":false,"text":"崇拜尾崎，嫉妒零的美丽和尾崎对她的态度，让自己变得更加疯狂。"}],"source":"bangumi","sourceCharacterId":"18560"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db32ba57c389ba54dc9ef853ea5f5781a507ea7748442faf1399b3be098d951b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2207a441252b911ffe5496545ab7337c86a83be92afb1f8090293ab61ce5d60.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川知子","creatorId":"vndb:s694","sourcePersonId":"vndb:s694","canonicalEntityId":"vndb:s694","name":"ひむろゆり(氷室百合)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61406:18560:5924:1","source":"bangumi"}]},{"characterId":"char_vndb_c76726","characterName":"零","sourceIds":{"vndbCharacterId":"c76726"},"originalCharacterName":"零","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The heroine. As a result of the ongoing experiment, her organs are being replaced with those of a pig."},{"spoiler":false,"text":"She is very valuable as a research subject, but since the technology has not been fully developed and the war situation is getting out of control, she has become the consolation prize of the military brass."},{"spoiler":false,"text":"She is a girl who is polite in her language and has even mastered the etiquette of a nobleman, but her intelligence has regressed, perhaps due to the effects of her surgery."},{"spoiler":false,"text":"Stimulated by the repeated experiments and the intensified play, she loses the last of her mind and her life is reaching its end."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c76726"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/257c6f26f9bd260e0a68b2101e53d1ef39b0fd76a5b0c810ce0a13a4dab436db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a658534b579010b94df4d99cd8686e56679ff2f99b45ecb562f1f11387ee22ab.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘 みもざ","creatorId":"vndb:s24","sourcePersonId":"vndb:s24","canonicalEntityId":"vndb:s24","name":"西口 有香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:32278","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p1571","sourceCompanyId":"egs:brand:1883","canonicalEntityId":"vndb:p1571","name":"黒雛","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:14529:1883","source":"egs"},{"companyId":"vndb:p381","sourceCompanyId":"vndb:p381","canonicalEntityId":"vndb:p381","name":"Hina Soft","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:12400:v5494","source":"vndb"},{"companyId":"vndb:p1571","sourceCompanyId":"vndb:p1571","canonicalEntityId":"vndb:p1571","name":"黒雛","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:12401:v5494","source":"vndb"},{"companyId":"vndb:p381","sourceCompanyId":"vndb:p381","canonicalEntityId":"vndb:p381","name":"Hina Soft","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:12402:v5494","source":"vndb"},{"companyId":"vndb:p1571","sourceCompanyId":"vndb:p1571","canonicalEntityId":"vndb:p1571","name":"黒雛","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:12403:v5494","source":"vndb"},{"companyId":"vndb:p1571","sourceCompanyId":"vndb:p1571","canonicalEntityId":"vndb:p1571","name":"黒雛","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:41409:v5494","source":"vndb"},{"companyId":"vndb:p4064","sourceCompanyId":"vndb:p4064","canonicalEntityId":"vndb:p4064","name":"D-PLAY","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:41410:v5494","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
