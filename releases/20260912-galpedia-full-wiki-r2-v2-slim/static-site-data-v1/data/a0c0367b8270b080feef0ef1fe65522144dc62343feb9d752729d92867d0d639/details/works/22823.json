:"vndb:s1999","name":"椎咲 雛樹","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:126296","source":"vndb"},{"creditedName":"望月 典子","creatorId":"vndb:s21472","sourcePersonId":"vndb:s21472","canonicalEntityId":"vndb:s21472","name":"望月 典子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:126301","source":"vndb"},{"creditedName":"望月 典子","creatorId":"vndb:s21472","sourcePersonId":"vndb:s21472","canonicalEntityId":"vndb:s21472","name":"望月 典子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:126302","source":"vndb"},{"creditedName":"三目 八面","creatorId":"vndb:s21473","sourcePersonId":"vndb:s21473","canonicalEntityId":"vndb:s21473","name":"三目 八面","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:126303","source":"vndb"}]},"cast":[{"characterId":"char_c39828","characterName":"柊 朱音","sourceIds":{"bangumi":[{"characterId":"105630","match":"exact-normalized-name-in-linked-work","subjectId":"222786"}],"egsCharacterIds":["8072"],"vndbCharacterId":"c39828"},"originalCharacterName":"柊 朱音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"サイズ：T158　処女、好きな人に一途、結構大胆"},{"spoiler":false,"text":"陽気な性格とチャーミングな笑顔が武器の売り出し中アイドル。"},{"spoiler":false,"text":"誰にでも気さくでスタッフ、共演者にも分け隔て無く接し現場の評判も上々。"},{"spoiler":false,"text":"ただし、売れてきて忙しくなりストレスが溜まり気味。"},{"spoiler":false,"text":"大勢の人間から注目され視線を感じるとゾクゾクする体質。"},{"spoiler":false,"text":"元々は視線を感じることに性的な興奮を感じる等の事は無かったが仕事の忙しさからストレスが溜まるようになり、しだいに視線を感じることや大勢の人がいる中でこっそりと性的な行為をする背徳感に強く快感を覚えるようになる。"},{"spoiler":false,"text":"人が多いところで行為をすることが多いが、見られるのが好きというわけではなく、みんなが注目する中で実はエッチな事をしているというドキドキ感がたまらなく好き。"},{"spoiler":false,"text":"事務所としてはどこの馬の骨とも知らないのとスキャンダルになるよりは、表に情報が出ないようにマネージャーを宛がい発散させコントロールをしようとしている。"},{"spoiler":false,"text":"そんな中にマネージャーとして配属された主人公“俊介”に実は気がつかないところで一目惚れしているために今回の事務所からのお達しには乗り気。"},{"spoiler":false,"text":"当然主人公への好感度が高いのでスキンシップが多い。"}],"source":"egs","sourceCharacterId":"8072","sourceWorkId":"22823","spoiler":false},{"segments":[{"spoiler":false,"text":"陽気な性格とチャーミングな笑顔で人気急上昇中の売れっ子アイドル。"},{"spoiler":false,"text":"誰にでも気さくでスタッフや共演者にも分け隔てなく接し、現場の評判も上々。"},{"spoiler":false,"text":"しかし、最近 仕事が忙しくなってきてストレスが溜まり気味。"},{"spoiler":false,"text":"大勢の人間から注目され視線を感じるとゾクゾクする体質。"},{"spoiler":false,"text":"また大勢の人間がいる中で密かに性的な行為をするドキドキ感がたまらなく好き。"},{"spoiler":false,"text":"スキャンダルになる前にマネージャーで性欲を発散するよう事務所に提案される。"},{"spoiler":false,"text":"実はマネージャーとなった俊介に一目惚れしており、事務所からのお達しには乗り気。"},{"spoiler":false,"text":"スキンシップが多く好きな人に一途で大胆だが、未だに男性経験はなく処女。"}],"source":"bangumi","sourceCharacterId":"105630"}],"profileFacts":[{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"8072","sourceWorkId":"22823","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73257901191a221f7f5f41373cb567670816d4d9eb7fd432701d1af6f9c4d2d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/354941ea7c2834a861e8c198cac2e15b896b3f06f73dc96ce3b77f2babcd49d9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"蒼桐かこ","creatorId":"vndb:s3283","sourcePersonId":"vndb:s3283","canonicalEntityId":"vndb:s3283","name":"蒼桐 かこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222786:105630:24909:1","source":"bangumi"}]},{"characterId":"char_vndb_c117031","characterName":"今井 俊介","sourceIds":{"vndbCharacterId":"c117031"},"originalCharacterName":"今井 俊介","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authorita