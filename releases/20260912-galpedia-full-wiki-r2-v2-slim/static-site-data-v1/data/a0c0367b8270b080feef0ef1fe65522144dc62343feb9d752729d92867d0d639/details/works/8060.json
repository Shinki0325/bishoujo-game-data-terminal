{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"8060","model":{"presentationWorkId":"vndb:v693","staff":{"artwork":[{"creditedName":"斉藤カホ(白井恵利子、黒井恵利子)","creatorId":"vndb:s4098","sourcePersonId":"egs:creator:2827","canonicalEntityId":"vndb:s4098","name":"斉藤カホ(白井恵利子、黒井恵利子)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:78518","source":"egs"}],"scenario":[{"creditedName":"中森南文里(一砂、守河辰巳)","creatorId":"vndb:s1617","sourcePersonId":"egs:creator:2300","canonicalEntityId":"vndb:s1617","name":"中森南文里(一砂、守河辰巳)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:19701","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c68796","characterName":"小坂 真琴","sourceIds":{"bangumi":[{"characterId":"59081","match":"exact-normalized-name-in-linked-work","subjectId":"229770"}],"egsCharacterIds":["17267"],"vndbCharacterId":"c68796"},"originalCharacterName":"小坂 真琴","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female teacher, known as the “Steel Virgin” by her students. She is the assistant head of her grade."},{"spoiler":false,"text":"She has a cool attitude toward her students and her classes. Her classes are strict and stifling, but she also has a surprising side to her, as when she waters her flowerbeds by herself."},{"spoiler":false,"text":"She is currently having an affair with a man who has a wife and child."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c68796"},{"segments":[{"spoiler":false,"text":"「生徒とこんなことになるなんて、教師失格よね。」"},{"spoiler":false,"text":"生徒から「鋼鉄の処女」と呼ばれる学年副主任。"},{"spoiler":false,"text":"クールで理知的な性格で、教師としての仕事もビジネスとして割り切っている。"},{"spoiler":false,"text":"厳しく息の詰まるような授業は生徒達に不評ではあるが、脱落者を出さない指導方法は定評がある。"},{"spoiler":false,"text":"現在、妻子ある男性と不倫の関係にあるようだが……。"}],"source":"egs","sourceCharacterId":"17267","sourceWorkId":"3701","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公とつばめが通っている槁ヶ丘学園の教師。担当は英語。"},{"spoiler":false,"text":"「鋼鉄の処女」の異名を持つ彼女の授業は非常に厳しく、息が詰まるほどの緊張感が漂う。"},{"spoiler":false,"text":"しかしその指導方法は的確でわかりやすく、脱落する学生は少ない。"},{"spoiler":false,"text":"お堅い印象を与えるが、見た目よりは柔らかい。"},{"spoiler":false,"text":"※『僕と4人の女教師』『てすた～Teach＆Study～』に登場。"}],"source":"egs","sourceCharacterId":"17267","sourceWorkId":"11250","spoiler":false},{"segments":[{"spoiler":false,"text":"Ｂ：85cm　Ｗ：59cm　Ｈ：87cm"},{"spoiler":false,"text":"生徒から『鋼鉄の処女』と呼ばれる、女教師。学年副主任。"},{"spoiler":false,"text":"生徒達に接する態度や授業を「仕事」としているクールな面を持つ。"},{"spoiler":false,"text":"授業は厳しく息の詰まるような授業を行うが、一人花壇に水をやるような意外な一面も持っている。"},{"spoiler":false,"text":"現在、妻子ある男性と不倫関係にある。"},{"spoiler":false,"text":"「先生だってね・・・ただの女なのよ・・・」"}],"source":"bangumi","sourceCharacterId":"59081"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/5284163a9b4af862173142925cfe780118a07b81bb6e985b427d9df8ef431e2a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bf6ea613c031622f41122e4b62c5c9a2ec51e7efe14cfddaa305828fc6e8a52.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みすみ","creatorId":"vndb:s1164","sourcePersonId":"vndb:s1164","canonicalEntityId":"vndb:s1164","name":"石松 千恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7089","source":"vndb"}]},{"characterId":"char_c80302","characterName":"皆瀬川 由子","sourceIds":{"bangumi":[{"characterId":"59100","match":"exact-normalized-name-in-linked-work","subjectId":"229775"}],"egsCharacterIds":["17268"],"vndbCharacterId":"c80302"},"originalCharacterName":"皆瀬川 由子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園の3年生。主人公の先輩にあたる。"},{"spoiler":false,"text":"好きな科目は国語（文学好き）、嫌いな科目は体育。趣味は読書、編み物、クロスワードパスル。"},{"spoiler":false,"text":"成績はかなり優秀。学園でもベスト5に入るくらい。"},{"spoiler":false,"text":"ガリ勉ではなく、記憶力と応用力に長けたタイプ。"},{"spoiler":false,"text":"しかし、実はかなりのドジスキルの所有者。"},{"spoiler":false,"text":"家は普通だが、小さい頃はバリバリのお嬢様学校にいた。"},{"spoiler":false,"text":"そのため一部の知識（性知識など）が偏っているところがある。"},{"spoiler":false,"text":"下級生からはそのお嬢様風の容姿で、同級生（先輩連中）からはその見た目と違うドジッぷりのギャップで隠れた人気がある。"},{"spoiler":false,"text":"料理は「ミスをしない限りは」わりと上手。"},{"spoiler":false,"text":"実は家庭教師経験はなし。"},{"spoiler":false,"text":"近所の小学生に勉強を教えてお菓子をご馳走になった程度。"},{"spoiler":false,"text":"事務員のバイトをやったことがあるが、お茶くみだけは高確率にこぼすのでさせてもらえなかった。"},{"spoiler":false,"text":"「こ、これで…あなたの家庭教師にしてもらえますか？」"}],"source":"egs","sourceCharacterId":"17268","sourceWorkId":"8060","spoiler":false},{"segments":[{"spoiler":false,"text":"つばめの知り合いで、槁ヶ丘学園の卒業生。"},{"spoiler":false,"text":"在学当時は、常に学年のベスト5に入っていたほど成績優秀の学生だった。"},{"spoiler":false,"text":"お嬢様風の清楚な容姿を持つが、典型的なドジッ娘。"},{"spoiler":false,"text":"現在は、別の街に移り住んでおり、つばめとは電話で連絡を取っている。"},{"spoiler":false,"text":"※『てすた～Teach＆Study～』に登場。本作では声のみの登場になります。"}],"source":"egs","sourceCharacterId":"17268","sourceWorkId":"11250","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の3年生。主人公の先輩にあたる。"},{"spoiler":false,"text":"好きな科目は国語