1030da5363a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9c98db37d7312af6a9958054c7bce512b35518af394584d3b3a9dc5c5e79d5c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏野 こおり","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68622","source":"vndb"}]},{"characterId":"char_vndb_c43579","characterName":"ルーシャ・ヘインズ","sourceIds":{"vndbCharacterId":"c43579"},"originalCharacterName":"ルーシャ・ヘインズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a young girl who manages the diner with the main character. While capable and reliable, she is inept with relationships, often finding it difficult to be forthright with her affections. She trusts the main character like family, and when the two of them are alone, she will sometimes show her childish side."},{"spoiler":false,"text":"\"Personally, I think it would be a lot of fun if more people were to come and bring some life to this place.\""}],"source":"vndb","sourceCharacterId":"c43579"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cba9cffff6ae71eb734aeaa5b4ec10f16c28ba711405d27e5a71f9f60c3693ef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b97ad8cb53c8196ea6542a42f61f1c5cc8657d0828bc4044d9e9bd1500e0b164.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"かわしま りの","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68623","source":"vndb"}]},{"characterId":"char_vndb_c43582","characterName":"カレン・ランカスター","sourceIds":{"vndbCharacterId":"c43582"},"originalCharacterName":"カレン・ランカスター","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A lady belonging to the town's vigilante corps. Teasing the main character is one of her favorite pastimes. She has been taking care of the main character since a long time ago, and continues to act as everyone's older sister. She is also researching the \"disaster\" that occurred at some point in the past, and continues to investigate the mystery of the vampires that terrorized the world."},{"spoiler":false,"text":"\"That might mean a lonely battle. Can you do this?\""}],"source":"vndb","sourceCharacterId":"c43582"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a09e6ed28f4defa54a800ebf61c7a1541d4c52df39e471cab52284267348795.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/897d02c837be101ead8af5578d29312eb66beb598bc08e9e8c23b067f8cd25fd.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風音","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68624","source":"vndb"}]},{"characterId":"char_vndb_c51872","characterName":"レオン・レアード","sourceIds":{"vndbCharacterId":"c51872"},"originalCharacterName":"レオン・レアード","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[