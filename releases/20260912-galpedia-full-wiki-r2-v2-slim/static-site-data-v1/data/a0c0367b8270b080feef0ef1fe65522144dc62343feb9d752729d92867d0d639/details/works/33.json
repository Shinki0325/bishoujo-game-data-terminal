value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yet another angel who, like Ami, came down from heaven to study humans."},{"spoiler":false,"text":"She has a flippantly sharp tongue, but she is hardly a delinquent. It is in her nature to want to help someone who seems to be in need of it. Her own justification for doing this is \"seeing people like that gets me real pissed.\""},{"spoiler":false,"text":"During her time on earth, she's ostensibly freeloading at the residence of an elderly couple, but in actuality, they were quick to accept her as a grandchild of sorts."},{"spoiler":false,"text":"Of course, she's also a sucker for donuts."}],"source":"vndb","sourceCharacterId":"c20621"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/892ac50580f2f5d763fbca85e860462ab5092511efbf154627bb894165a34447.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/455d5b39e7a15b0768add105759790173e9a60eb3e81978fe4d7e9e5edeefe2a.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"乃田 あす実","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"韮井叶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:3278","source":"vndb"}]},{"characterId":"char_vndb_c20622","characterName":"天使 ももこ","sourceIds":{"vndbCharacterId":"c20622"},"originalCharacterName":"天使 ももこ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An angel who came down from heaven on her own to study humans."},{"spoiler":false,"text":"She's a gloriously upbeat and happy individual, who pays zero heed to the depressing and sad elements in life, and always wears a beaming smile on her face. Perhaps owing to this disposition of hers, she is quite a social butterfly with lots of friends."},{"spoiler":false,"text":"Incidentally, her grades are just as bad as, or worse than, Ami's, and she cares even less about this than Ami does. However, it can be argued that she sees enabling a general atmosphere of happiness in the people around her as the most ideal raison d'etre for an angel."},{"spoiler":false,"text":"It goes without saying that she too is wild about donuts."}],"source":"vndb","sourceCharacterId":"c20622"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c985e777fdd6dfa4dfcf1abc6bc1ed82d6f272f21758998e309fd9a4da44f104.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/876d08f266655431187b76dab0f5d930381534039e8345425b6278cc78c70405.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長崎 みなみ","creatorId":"vndb:s1073","sourcePersonId":"vndb:s1073","canonicalEntityId":"vndb:s1073","name":"長崎 みなみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:3276","source":"vndb"}]},{"characterId":"char_vndb_c20623","characterName":"由良 和実","sourceIds":{"vndbCharacterId":"c20623"},"originalCharacterName":"由良 和実","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a848b9d39e0cf8c1fb57c214bc81a00271247c0dc841a49135b0ff333e5369f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80d22f9450f645a89d6cbc9f82588947978d4107d37fe3db0b870cca42c2b48f.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c55001","characterName":"天使 紗菜","sourceIds":{"vndbCharacterId":"c55001"},"originalCharacterName":"天使 紗菜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An angel who, just like Ami, came down from heaven to study humans."},{"spoiler":false,"text":"In spite of being Ami's younger twin sister, her grades are significantly better. It wouldn't exactly be a reach for someone to mistake her for the older sister."},{"spoiler":false,"text":"However, putting her greater academic strengths aside, she is every bit as big a sucker for donuts as Ami is."},{"spoiler":false,"text":"Birthday: Unknown"},{"spoiler":false,"text":"Likes: Donuts, studying"},{"spoiler":false,"text":"Dislikes: Irresponsibility"},{"spoiler":false,"text":"Hobby: Savoring a nice cup of tea (with a compulsory donut on the side)"}],"source":"vndb","sourceCharacterId":"c55001"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cdb6a5ad7780234d0287cf3a7d5735b53cace45480b09234bb9e8bdbc344cde6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/daf8e8fb2ca9eb7a9a4f24695cf6d9f3d15c6a6abd0018ac6e8c79920f659c6a.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本山友美","creatorId":"vndb:s4441","sourcePersonId":"vndb:s4441","canonicalEntityId":"vndb:s4441","name":"本山友美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:3282","source":"vndb"}]},{"characterId":"char_vndb_c55002","characterName":"広瀬 香美","sourceIds":{"vndbCharacterId":"c55002"},"originalCharacterName":"広瀬 香美","characterNameSource":null,"role":"appears","status":"source-only-candidate","identitySta