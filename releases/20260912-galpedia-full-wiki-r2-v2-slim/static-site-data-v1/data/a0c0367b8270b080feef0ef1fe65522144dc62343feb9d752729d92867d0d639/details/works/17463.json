ht":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c2146","characterName":"銀","sourceIds":{"vndbCharacterId":"c2146"},"originalCharacterName":"銀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hatsune's old enemy, who has been crossing over and fighting her for a very long time. He was injured in the previous battle just like Hatsune, and has been conserving power. Although he has a form of a priest, he is not actually one."},{"spoiler":false,"text":"Edit from AliceSoftWikia"}],"source":"vndb","sourceCharacterId":"c2146"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b588b6df63f3c558785537464d4cf364d8cbf86bfda560587aa919009654bb49.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f68be7a2890b19bbf45a03ee383a320bf69ae66b686c4d32949308e4b3e609fb.webp","width":202,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c2147","characterName":"比良坂 初音","sourceIds":{"vndbCharacterId":"c2147"},"originalCharacterName":"比良坂 初音","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A spider youkai (jorougumo) who has lived for many hundreds of years. After being gravely wounded by a priest named Shirogane, Hatsune goes into hiding for one month. After that, she decides to go to Yaesaka High in search of prey to heal her wounds. By consuming the body of her victims, or having sex with them, she can obtain life energy and conserve power."}],"source":"vndb","sourceCharacterId":"c2147"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4ceab2e2acbc3de5a3631d9e64e7ce84338942901b480adb0cdeef71e9cdce67.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78e026a9a74a78997bed4f5f8dd947a72512b1e6cc70b3c0801cccc3a9988b6b.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c2148","characterName":"渡辺 つぐみ","sourceIds":{"vndbCharacterId":"c2148"},"originalCharacterName":"渡辺 つぐみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year student at Yaesaka, and Takahiro's younger sister. Belongs to a swimming club, in the same class as Kanako, and an active and spirited girl. But slightly pitiful for being a target of both Hatsune and Iguchi. She is the most popular girl among the staff."},{"spoiler":false,"text":"Edited from AliceSoftWikia"}],"source":"vndb","sourceCharacterId":"c2148"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/7808fd580d2df672e0c4a15bb76d67e2c695421044b59871fcd543f24e5fc249.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3fd2062415e389dc9ae048c2339d72d682d139c9a0bb8085ea92eb33b9d233b7.webp","width":154,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c2149","characterName":"深山 奏子","sourceIds":{"vndbCharacterId":"c2149"},"originalCharacterName":"深山 奏子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year student at Yaesaka High School and a daughter of a rich man. She became the victim of delinquent students, and was gang-raped in the back of a gymnastics building on the night when Hatsune first appeared. However, Hatsune saved her."},{"spoiler":false,"text":"Edited from AliceSoftWikia"}],"source":"vndb","sourceCharacterId":"c2149"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/abc0134b16c61d2fe8ffa655db45a8174b8eb9a4db58c7b5eb9bd8d99227bbb8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7bac0a6b18a898c26ad7aa484ac2753faf2961901af79334d7e8ee6b87d69b0.webp","width":133,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c2150","characterName":"渡辺 鷹弘","sourceIds":{"vndbCharacterId":"c2150"},"originalCharacterName":"渡辺 鷹弘","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"President of Yaesaka's student council, a second-year student who is also captain of the kendo club. Sachiho's childhood friend. Owns a sword passed down from generation to generation, for self-defense. Distrustful of Hatsune."},{"spoiler":false,"text":"Edited from AliceSoftWikia"}],"source":"vndb","sourceCharacterId":"c2150"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfeea84e826aab22549f119cc00de2583d96f4d593d37bb2cfc03412ca683452.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/504463642c201c9076a96b4c2817ca1622527e745b3764ce6ce6845829c337e7.webp","width":149,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c2151","characterName":"葛城 和久","sourceIds":{"vndbCharacterId":"c2151"},"origin