icalEntityId":"vndb:s7025","name":"櫻 レオナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14357:12099:29845:1","source":"bangumi"}]},{"characterId":"char_c32168","characterName":"由希 せせり","sourceIds":{"bangumi":[{"characterId":"12100","match":"exact-normalized-name-in-linked-work","subjectId":"14357"}],"egsCharacterIds":["12089"],"vndbCharacterId":"c32168"},"originalCharacterName":"由希 せせり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園の１年生で、演劇部に所属している。"},{"spoiler":false,"text":"同じ演劇部の１年生・涼月とは無二の親友。"},{"spoiler":false,"text":"元気で一生懸命。爽やかでまっすぐな女の子。"},{"spoiler":false,"text":"時には泣いてしまう事もあるけれど、"},{"spoiler":false,"text":"負けないめげないくじけない。一人称は「ボク」。"},{"spoiler":false,"text":"時折歌を自作しては変なメロディーで歌っている。"},{"spoiler":false,"text":"思い込みが激しく、勝手に勘違いしては暴走してしまう事も。"},{"spoiler":false,"text":"手先が器用で、演劇部では衣装のお針子を担当。"},{"spoiler":false,"text":"自分の容姿に自信がなく、鳥羽莉や涼月に憧れている。"},{"spoiler":false,"text":"初恋の相手である胡太郎に告白するも玉砕。"},{"spoiler":false,"text":"それでもめげずに、果敢にアタックを敢行する。"}],"source":"egs","sourceCharacterId":"12089","sourceWorkId":"6204","spoiler":false},{"segments":[{"spoiler":false,"text":"主学園の１年生で、演劇部に所属している。同じ演劇部の１年生・涼月とは無二の親友。"},{"spoiler":false,"text":"元気で一生懸命。爽やかでまっすぐな女の子。時には泣いてしまう事もあるけれど、負けないめげないくじけない。一人称は「ボク」。時折歌を自作しては変なメロディーで歌っている。思い込みが激しく、勝手に勘違いしては暴走してしまう事も。手先が器用で、演劇部では衣装のお針子を担当。"},{"spoiler":false,"text":"自分の容姿に自信がなく、鳥羽莉や涼月に憧れている。初恋の相手である胡太郎に告白するも玉砕。それでもめげずに、果敢にアタックを敢行する。"}],"source":"bangumi","sourceCharacterId":"12100"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f47924f7ff4b1e1c38d604de8dcc678cfae0ed6408c309e6ddd72058be33c40.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3