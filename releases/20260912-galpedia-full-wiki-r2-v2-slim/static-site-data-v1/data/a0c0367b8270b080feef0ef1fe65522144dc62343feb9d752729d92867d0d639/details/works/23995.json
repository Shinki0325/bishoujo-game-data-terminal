urceCharacterId":"16063","sourceWorkId":"23995","spoiler":false},{"segments":[{"spoiler":false,"text":"2年生で主人公の同級生。 ちょっと不器用で世話焼きな性格。"},{"spoiler":false,"text":"学園の亡き理事長の孫であり、共学反対派の中心人物。"},{"spoiler":false,"text":"主人公を邪魔者扱いするが、同時に彼の転入生という弱い立場も気にしており、"},{"spoiler":false,"text":"結果的に矛盾した態度を取ってしまう。"}],"source":"bangumi","sourceCharacterId":"54396"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95a61295aaebf199e1456f338281caff9014f5e67114d7fd463fa3b4ae264532.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0ef8474f1317692bc05f20eb09c0ac0ff27733aaed3ca9cc835b3902df1efb5e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊原ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187477:54396:4916:1","source":"bangumi"}]},{"characterId":"char_c59445","characterName":"天之宮 歌恋","sourceIds":{"bangumi":[{"characterId":"54397","match":"exact-normalized-name-in-linked-work","subjectId":"187477"}],"egsCharacterIds":["16064"],"vndbCharacterId":"c59445"},"originalCharacterName":"天之宮 歌恋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"二年生である主人公の同級生。"},{"spoiler":false,"text":"どこか浮世離れした感のあるお嬢様。"},{"spoiler":false,"text":"日々を退屈と考えているのか、転入してきた異性である主人公に興味津々。"},{"spoiler":false,"text":"元々の寂しがり屋な性格も手伝い、持て余しているわがままボディと無邪気な天真爛漫さで主人公を自覚無いまま誘惑アタック！"},{"spoiler":false,"text":"風紀が乱れるとステラからはいつも厳しい指導をもらうが、本人はまったく懲りる様子もない。"}],"source":"egs","sourceCharacterId":"16064","sourceWorkId":"23995","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の同級生。 どこか常識離れしているお嬢様。"},{"spoiler":false,"text":"日々に退屈しているのか、転入してきた異性の主人公に興味津々。"},{"spoiler":false,"text":"寂しがりな性格もあってか、わがままボディと無邪気な天真爛漫さで誘惑アタック！"},{"spoiler":false,"text":"風紀が乱れるとステラからいつも厳しい指導を受けるが、まったく懲りる様子がない。"}],"source":"bangumi","sourceCharacterId":"54397"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f02928f07cd70144e6a45a9e9197546f282f5c0e7e2279421753d03d56d91940.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33b9b9d780d1840ee8ea7eb2a7b003082fb6684531befe52d16555a359d9a215.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187477:54397:5928:1","source":"bangumi"}]},{"characterId":"char_c59446","characterName":"早河 彗","sourceIds":{"bangumi":[],"egsCharacterIds":["16065"],"vndbCharacterId":"c59446"},"originalCharacterName":"早河 彗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"二年生である主人公の同級生。"},{"spoiler":false,"text":"ノリ重視でいつも人の輪の中にいる。"},{"spoiler":false,"text":"からかうのが好きでやや乱暴な口調だが半面、人への配慮が行き届いており視野も広く、考え方も柔軟。しかも空気を読むのが上手いので本来はクラスのまとめ役となりそうな人格者だが、責任ある立場が苦手でいつも逃げ回っている。"},{"spoiler":false,"text":"そういう意味ではステラとは真逆の性格であり、面倒ごとを押し付けている意識があるのか少し後ろめたい気持ちを一方的に抱いている。"},{"spoiler":false,"text":"主人公に思わせぶりなきわどい言動を放っては、相手をどれだけ取り乱せられるかという奇妙なゲームを始めるが……？"}],"source":"egs","sourceCharacterId":"16065","sourceWorkId":"23995","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0cb07de668efee3722c71cd8767e9badf2e4f49f33a722d