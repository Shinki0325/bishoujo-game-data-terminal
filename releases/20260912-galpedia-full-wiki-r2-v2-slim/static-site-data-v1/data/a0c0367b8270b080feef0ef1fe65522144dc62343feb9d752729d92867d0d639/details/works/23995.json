umi"}]},{"characterId":"char_c60690","characterName":"海老沢 亜子","sourceIds":{"bangumi":[{"characterId":"54406","match":"exact-normalized-name-in-linked-work","subjectId":"187477"}],"egsCharacterIds":["16073"],"vndbCharacterId":"c60690"},"originalCharacterName":"海老沢 亜子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"二年生の主人公より●歳年上の残念な下級生。"},{"spoiler":false,"text":"隙をみてやたらと触ってくるボディランゲージの子。"},{"spoiler":false,"text":"特に主人公の髪の手触りを一方的に気に入っており、いつもなでなでしてくる。"},{"spoiler":false,"text":"そしてその「いつもなでなでしているから」というよくわからない独自の理論展開により主人公へ勉強を教えてもらうようお願いしてくる。"},{"spoiler":false,"text":"基本的に他力本願の甘えん坊で、欲望に正直な自堕落な性格。ついでに仕草は女性として隙だらけ。"},{"spoiler":false,"text":"主人公としては保護者のように心配しており、放っておけない存在になってしまう。"}],"source":"egs","sourceCharacterId":"16073","sourceWorkId":"23995","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公より●歳年上の残念な下級生。 やたら身体を触りたがる女の子。"},{"spoiler":false,"text":"特に主人公の髪の手触りを気に入っており、いつもなでなでしてくる。"},{"spoiler":false,"text":"さらに、それを理由に勉強を教えるようねだってくる独自理論を展開。"},{"spoiler":false,"text":"基本的に他力本願の甘えん坊で、欲望に正直な自堕落な性格。"},{"spoiler":false,"text":"女性として隙だらけで、主人公としては放って置けない存在。"},{"spoiler":false,"text":"保護者のような心境で心配している。"}],"source":"bangumi","sourceCharacterId":"54406"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/3140788f9ead8517b4e5a7948384a4550221f67ce675fde188b494a853d6b173.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fcdabeccf98d01e67f53d69d389c9cba886502f9301c10f6c2b12001957f273b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"設楽麻美","creatorId":"vndb:s869","sourcePersonId":"vndb:s869","canonicalEntityId":"vndb:s869","name":"設楽 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187477:54406:7904:1","source":"bangumi"}]},{"characterId":"char_c60691","characterName":"土屋 珠希","sourceIds":{"bangumi":[{"characterId":"54407","match":"exact-normalized-name-in-linked-work","subjectId":"187477"}],"egsCharacterIds":["16074"],"vndbCharacterId":"c60691"},"originalCharacterName":"土屋 珠希","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"二年生である主人公の同級生。"},{"spoiler":false,"text":"これといって特徴や特技無しで、成績ほどほど。"},{"spoiler":false,"text":"運動ほどほど。おっぱいほどほど。背丈ほどほど。"},{"spoiler":false,"text":"クイーン・オブ・普通。"},{"spoiler":false,"text":"しかし皮肉なことに、強烈な個性のジャングルと化しているこの教室においては一周回って普通であることがひとつの個性として認知されている状態。"},{"spoiler":false,"text":"本人的にはそのことを由々しき問題と考えており、普段から非常に気にしている。"}],"source":"egs","sourceCharacterId":"16074","sourceWorkId":"23995","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の同級生。 これといった特徴はなく、クイーン・オブ・普通。"},{"spoiler":false,"text":"しかし強烈な個性に囲まれたクラス内では逆に個性として認知されている。"},{"spoiler":false,"text":"料理が好きで、とても家庭的。"}],"source":"bangumi","sourceCharacterId":"54407"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77f875f14590089407702d3f1923d3f7af1cd6d55f159b67429ae102e4835e8d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a05c277c9ac1ec5e7ed916ef7c41664d6c3a4d763c09786e45c1ef57def6c8c1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長妻樹里","creatorId":"vndb:s1197","sourcePersonId":"vndb:s1197","canonicalEntityId":"vndb:s1197","name":"長妻 樹里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187477:54407:8493:1","source":"bangumi"}]},{"characterId":"char_c60692","characterName":"柚木 千歳","sourceIds":{"bangumi":[{"characterId":"54408","match":"exact-normalized-name-in-linked-work","subjectId":"187477"}],"egsCharacterIds":["16075"],"vndbCharacterId":"c60692"},"originalCharacterName":"柚木 千歳","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"二年生である主人公の同級生。"},{"spoiler":false,"text":"演劇部であり、スラリと長い四肢とスレンダーな体つきからか女子からの人気が異様に高い。"},{"spoiler":false,"text":"元・クラスの壁ドン要員(※やる側)。"},{"spoiler":false,"text":"主人公がクラスに転入してきて男性の役回りから解放されたからか、普段から感謝の言葉を口にしている。"},{"spoiler":false,"text":"実はそれなりに乙女なのはお約束。"},{"spoiler":false,"text":"主人公から女の子扱いされたいと内心強く願っているが、元々自分の女性的な魅力に対して自信がないこともあり、いまいち主人公にその気持ちを伝えられていない様子。"}],"source":"egs","sourceCharacterId":"16075","sourceWorkId":"23995","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の同級生。 運動神経抜群な演劇部。"},{"spoiler":false,"text":"スレンダーな体躯で女子人気が異様に高く、壁ドン（する側）要員だった。"},{"spoiler":false,"text":"しかし主人公が転入したことで解放され、いつも感謝を口にしている。"},{"spoiler":false,"text":"実は乙女なハートを持っており、女の子扱いされたいと強く願っている。"},{"spoiler":false,"text":"だが自分の女性的な魅力に自信がなく、その気持ちを伝えることは出来ないでいる。"}],"source":"bangumi","sourceCharacterId":"54408"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cdeb8b950f32600a14b9f4448bb36fdf188a3601ea6781d0df2b88c512d1f235.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7b1404af8412c421371e7ab31d83806f2f590243ed3fe6cd18fda43de9d213f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林 由依","creatorId":"vndb:s4454","sourcePersonId":"vndb:s4454","canonicalEntityId":"vndb:s4454","name":"陸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70221","source":"vndb"}]},{"characterId":"char_c60693","characterName":"四分儀 流香","sourceIds":{"bangumi":[{"characterId":"54409","match":"exact-normalized-name-in-linked-work","subjectId":"187477"}],"egsCharacterIds":["16076"],"vndbCharacterId":"c60693"},"originalCharacterName":"四分儀 流香","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"二年生である主人公の同級生。"},{"spoiler":false,"text":"ウワサ大好き、妄想大好き！"},{"spoiler":false,"text":"いつも楽しくにぎやかに教室の中をかき回す、クラスのトラブルメーカー。"},{"spoiler":false,"text":"本人にその自覚がまったく無いところがあり呆れて誰も諭そうとはしない模様。"},{"spoiler":false,"text":"ちょっとオタク趣味も持っており、昔の少年向けアニメの話題についてこれる主人公のことを勝手にオタ友達認定している。"},{"spoiler":false,"text":"甘党としてもクラスでは有名で、くみの献上品をちょくちょく横からつまみ食いしていたりする。"},{"spoiler":false,"text":"ちなみに主人公を中心としたハーレムを教室内で形成できないかと密かに暗躍中。"}],"source":"egs","sourceCharacterId":"16076","sourceWorkId":"23995","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の同級生。 噂や妄想が大好きな無自覚のトラブルメーカー。"},{"spoiler":false,"text":"オタク趣味があり、昔の少年向けアニメに通じる主人公をオタ友認定している。"},{"spoiler":false,"text":"甘党としても有名で、くみの献上お菓子をよく横からつまみ食いしている。"},{"spoiler":false,"text":"クラスに主人公を中心としたハーレムを形成しようと密かに暗躍中。"}],"source":"bangumi","sourceCharacterId":"54409"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47e644b50f94fb4617d09a749d988567888b80ee9e8c282d5d6cf927504e8ab1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/325c607d29542620ff4821a569055f9a90b4cc22ed4d2e5c8363f7556a6bfc53.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤崎紗矢香","creatorId":"vndb:s6866","sourcePersonId":"vndb:s6866","canonicalEntityId":"vndb:s6866","name":"藤崎 紗矢香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187477:54409:30075:1","source":"bangumi"}]},{"characterId":"char_c60694","characterName":"月島 和羽","sourceIds":{"bangumi":[{"characterId":"54410","match":"exact-normalized-name-in-linked-work","subjectId":"187477"}],"egsCharacterIds":["16077"],"vndbCharacterId":"c60694"},"originalCharacterName":"月島 和羽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の実の妹。"},{"spoiler":false,"text":"両親とは別居しているため、ふたりで同棲もとい同居中。"},{"spoiler":false,"text":"病弱で学園に出られないが、本人はむしろ大好きな兄に対して奥さんみたいなことが出来ると喜んでいる模様。"},{"spoiler":false,"text":"兄である主人公の子を授かりたいと本気で考えており、どうやったら襲ってくれるのかとあざとくも可愛い策を練っている。"}],"source":"egs","sourceCharacterId":"16077","sourceWorkId":"23995","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の実の妹。 両親は別居しているため二人暮らし。"},{"spoiler":false,"text":"病弱で学園には来られないが、むしろ奥さんみたいと喜んでいる様子。"},{"spoiler":false,"text":"兄との子を授かりたいと本気で考えており、どうやったら襲ってくれるのか"},{"spoiler":false,"text":"あざとくも可愛い策をいつも練っている。"}],"source":"bangumi","sourceCharacterId":"54410"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24536dca7fa0ba04b1a0a24696ddda38dbee15a7a1fef06e059605658a57c5c5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e95758e047ed85eacb8c655cd011997af9a80143ada83cef9aa57a42f2439a8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜咲千依","creatorId":"vndb:s608","sourcePersonId":"vndb:s608","canonicalEntityId":"vndb:s608","name":"藤咲ウサ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187477:54410:8990:1","source":"bangumi"}]},{"characterId":"char_c60695","characterName":"福地 万理子","sourceIds":{"bangumi":[{"characterId":"54411","match":"exact-normalized-name-in-linked-work","subjectId":"187477"}],"egsCharacterIds":["16078"],"vndbCharacterId":"c60695"},"originalCharacterName":"福地 万理子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"二年Ａ組である主人公のクラスの担任教師。"},{"spoiler":false,"text":"いつもまとめるのが難しい個性豊かな教室で苦労ばかりしているお姉さん。"},{"spoiler":false,"text":"男子歓迎派と否定派で真っ二つの中、問題の渦中にある頼りがいのある主人公と日々、どうあるべきか方針を相談し合っている。"},{"spoiler":false,"text":"基本的には慎ましやかで温和な性格だが、たまに過激な言動が飛び出してきて主人公を大いに驚かせてくれる。"},{"spoiler":false,"text":"姉のいない主人公は、姉が出来たらこんな感じだろうか？といつも考えている。"},{"spoiler":false,"text":"ちなみに重度の機械オンチ。"}],"source":"egs","sourceCharacterId":"16078","sourceWorkId":"23995","spoiler":false},{"segments":[{"spoiler":false,"text":"2年A組の担任教師。 個性豊かな教室でいつも苦労しているお姉さん。"},{"spoiler":false,"text":"現在は男子問題の渦中にある主人公と、日々どうすべきか相談し合っている。"},{"spoiler":false,"text":"温和な性格だが、たまに過激な発言をして皆を驚かせることも。"},{"spoiler":false,"text":"主人公にとって、姉がいたらこんな感じだろうか？ と想像させてしまう存在。"},{"spoiler":false,"text":"実は重度の機械オンチ。"}],"source":"bangumi","sourceCharacterId":"54411"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f025892dc48893501179164110b6751b0a0ec3995ee196ff5098d271894711a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70b71113f06b0a9bb1b6c15038c3f8b7aeb6936c9728da9651e257a09635d55b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187477:54411:6351:1","source":"bangumi"}]},{"characterId":"char_vndb_c63842","characterName":"月島 優牙","sourceIds":{"vndbCharacterId":"c63842"},"originalCharacterName":"月島 優牙","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"se