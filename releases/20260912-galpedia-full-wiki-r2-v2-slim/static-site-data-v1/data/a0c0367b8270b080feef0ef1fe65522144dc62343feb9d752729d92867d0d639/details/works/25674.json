{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"25674","model":{"presentationWorkId":"vndb:v25872","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c113647","characterName":"エマ","sourceIds":{"vndbCharacterId":"c113647"},"originalCharacterName":"エマ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"518"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The daughter of a hero who was ordered by the king to subdue the Demon King's daughter. Strong and firm. She likes to cook."},{"spoiler":false,"text":"She respects her father, the hero, and hates the Demon King who killed him. Therefore, she considers this subjugation to be her mission. She thought herself how to wield a sword."},{"spoiler":false,"text":"Her hometown is a rural area away from the capital, where she lived with her mother. She entered the tower three days before the Demon King's daughter's birthday. She prepared to kill the Demon King's daughter when he emerged."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c113647"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d081831fc1cc0dfecd318766c7b101c9eb9d4f275e3bbba2815e2fc33591ec46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d5c7f6fb48a18c3853d94d760377286e4a09c90b91bbaad9ac74fc6107d85ee.webp","width":106,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c113648","characterName":"クロエ","sourceIds":{"vndbCharacterId":"c113648"},"originalCharacterName":"クロエ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1231"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Demon King's daughter, who has been imprisoned in the tower ever since he was defeated. Because of that, she is ignorant of the world, and her words and deeds are a bit childish."},{"spoiler":false,"text":"By emerging on her 16th birthday, she will become a demon king who will destroy the world. Until then, she cannot be harmed by powerful magic. When she emerges, her magical power weakens, so it is said that this is the only time to subdue it."},{"spoiler":false,"text":"The imprisoned tower used to be a library, so she likes reading books."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c113648"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e90262bbd7c3a710fdeb792069cc7bf7b77c4a5e0295c8dc65d9103a7f36d7ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27df62c0b355991f28761c4d4b4499e5df250704de6fd9936564dd709ab6e772.webp","width":175,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p7481","sourceCompanyId":"egs:brand:5509","canonicalEntityId":"vndb:p7481","name":"ベルカゲ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:25674:5509","source":"egs"},{"companyId":"vndb:p7481","sourceCompanyId":"vndb:p7481","canonicalEntityId":"vndb:p7481","name":"ベルカゲ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:107693:v25872","source":"vndb"},{"companyId":"vndb:p7481","sourceCompanyId":"vndb:p7481","canonicalEntityId":"vndb:p7481","name":"ベルカゲ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:72087:v25872","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing"],"source":"terminal-wiki-full-runtime-v7"}}
