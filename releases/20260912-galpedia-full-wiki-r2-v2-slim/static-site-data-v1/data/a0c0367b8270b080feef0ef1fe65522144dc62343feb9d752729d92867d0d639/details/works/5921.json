k","subjectId":"225092"}],"egsCharacterIds":["13846"],"vndbCharacterId":"c51012"},"originalCharacterName":"河村 泉美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"高見沢学園に通う二年生。"},{"spoiler":false,"text":"明朗快活で、ポジティブな頑張り屋さん。"},{"spoiler":false,"text":"成績は普通だが、スポーツが得意で、新体操部に所属している。"},{"spoiler":false,"text":"部活の終わった後や休日はレストランでバイトをして海外留学の資金を貯めている。"},{"spoiler":false,"text":"恋愛経験はなく、ウブで純情な女の子。"}],"source":"egs","sourceCharacterId":"13846","sourceWorkId":"5921","spoiler":false},{"segments":[{"spoiler":false,"text":"2年生。髪はポニーテールのロング。サイズとプロポーションは標準。"},{"spoiler":false,"text":"快活で、はきはきしていて、とにかく前向きな、がんばり屋さん。"},{"spoiler":false,"text":"成績はごく普通だが、スポーツは得意。"},{"spoiler":false,"text":"新体操部に所属しており、レギュラーにも選ばれている。"},{"spoiler":false,"text":"夜間や休日はカフェレストランでウエイトレスのアルバイトをしている。"},{"spoiler":false,"text":"学生Ｃとは同じクラスで、親友の関係。"},{"spoiler":false,"text":"家族には１歳離れた弟がおり、いつも彼のことを心配している。"},{"spoiler":false,"text":"恋愛経験はなく、キスもしたことがないほど。初心で純情。"}],"source":"bangumi","sourceCharacterId":"93105"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed38e3b0e6270d5b8e667ec121a5df3c8891bc44b619d6afeaea1d9686e0371e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d23c03c2ec8d0f05d0e22435a2af71a5ee44ad22c78397c5ade9a2589726db90.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225092:93105:5890:1","source":"bangumi"}]},{"characterId":"char_c51013","characterName":"高見沢 優香","sourceIds":{"bangumi":[{"characterId":"93106","match":"exact-normalized-name-in-linked-work","subjectId":"225092"}],"egsCharacterIds":["13847"],"vndbCharacterId":"c51013"},"originalCharacterName":"高見沢 優香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"高見沢学園に通う三年生。"},{"spoiler":false,"text":"学園の理事長の母と、学園長の父を持ち、自らも学生会長を務めている優等生。"},{"spoiler":false,"text":"学業優秀、スポーツ万能、ファッションモデルさながらのプロポーションにして美人。"},{"spoiler":false,"text":"お嬢様育ちのためか、プライドが高く、やや世間知らず。"},{"spoiler":false,"text":"学園では高嶺の花的な存在。"}],"source":"egs","sourceCharacterId":"13847","sourceWorkId":"5921","spoiler":false},{"segments":[{"spoiler":false,"text":"3年生。髪はさらさらのストレートのロング。"},{"spoiler":false,"text":"ファッションモデルさながらに、サイズ、プロポーションともに抜群。"},{"spoiler":false,"text":"学園の理事長を母に、学園長を父に持つ、生徒会長。"},{"spoiler":false,"text":"傲慢で、ルールにうるさいが、基本的には優しく、思いやりがある。"},{"spoiler":false,"text":"才色兼備を絵に描いたように、美人で、成績優秀、スポーツ万能と、非の打ちどころがない。"},{"spoiler":false,"text":"お嬢様育ちのため、世間知らずなところがある。"},{"spoiler":false,"text":"学校では知らない者がいないほどの有名人で、大多数の尊敬と憧憬を集めている。"},{"spoiler":false,"text":"完璧すぎるためか、近寄りがたく思われており、親しい友人はほとんどいない。"},{"spoiler":false,"text":"母親同様にクリスチャンだが、信心深くはなく、主人公の教会にも寄り付かない。"},{"spoiler":false,"text":"恋愛経験は豊富だが、しばらく付き合っただけで終わることが多く、まだ処女。"}],"source":"bangumi","sourceCharacterId":"93106"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/8976475e3d0a0d1781eca9884b179e1f6e7f80242dc3596b0685e5af601ee577.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2e5b6092a3614d21c56a35a94bb88f93636b9b6e729268ba6c28b0e45b39b4e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225092:93106:5075:1","source":"bangumi"}]},{"characterId":"char_c51014","characterName":"高見沢 綾音","sourceIds":{"bangumi":[{"characterId":"93110","match":"exact-normalized-name-in-linked-work","subjectId":"225092"}],"egsCharacterIds":["13853"],"vndbCharacterId":"c51014"},"originalCharacterName":"高見沢 綾音","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuka's mother."}],"source":"vndb","sourceCharacterId":"c51014"},{"segments":[{"spoiler":false,"text":"高見沢学園の理事長にして、優香の母親。"},{"spoiler":false,"text":"36歳とまだまだ若く、見事なプロポーションと美しさを併せ持つ。"},{"spoiler":false,"text":"教育熱心で自宅で病に伏せっている学園長の夫にかわり、二人分の仕事をこなす多忙な毎日でありながらも、家族の時間も大切にしようと心掛けている。"},{"spoiler":false,"text":"しかしながら、夫とセックスレスのため欲求不満気味。"}],"source":"egs","sourceCharacterId":"13853","sourceWorkId":"5921","spoiler":false},{"segments":[{"spoiler":false,"text":"36歳。髪はロングのものをアップにしている。"},{"spoiler":false,"text":"背が高く、バストもヒップもたっぷりしたグラマー。"},{"spoiler":false,"text":"優香の母で、若くして学園の理事長をしている。"},{"spoiler":false,"text":"現在は、自宅で伏せっている学園長の夫にかわって、２人ぶんの仕事をこなしている。"},{"spoiler":false,"text":"資産家の１人娘で、両親が早くに亡くなったため、全てを引き継いだ。"},{"spoiler":false,"text":"教育熱心で、社会参加の意識が高い。"},{"spoiler":false,"text":"忙しい中で家庭のことにも時間を割き、１人娘である優香にも愛情を注いでいる。"},{"spoiler":false,"text":"クリスチャンの家系で、主人公の教会にもよく通っており、寄付も惜しまない。"},{"spoiler":false,"text":"夫とは２０歳も離れており、若いころに結婚したが、いまでも仲睦まじい。"},{"spoiler":false,"text":"厳格な教育者にして、良妻賢母だが、その実、淫乱なところがある。"},{"spoiler":false,"text":"夫とは久しくセックスレスなので、欲求不満ぎみ。"}],"source":"bangumi","sourceCharacterId":"93110"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd01434dc2bfa44344ae05cce6b61f11cf18e4b9a0feef76e5a0ff57eee7c7a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a62dbb87fe0e2b70817c7f6872e220be61b4444b4be69ba79d9ba030b801398f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"ももぞの薫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225092:93110:6131:1","source":"bangumi"}]},{"characterId":"char_c51015","characterName":"倉橋 菜々子","sourceIds":{"bangumi":[{"characterId":"93107","match":"exact-normalized-name-in-linked-work","subjectId":"225092"}],"egsCharacterIds":["13848"],"vndbCharacterId":"c51015"},"originalCharacterName":"倉橋 菜々子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"高見沢学園の英語教師。"},{"spoiler":false,"text":"仕事熱心で、生活指導も兼任している。"},{"spoiler":false,"text":"誰にでも分け隔てなく接する気さくで優しい性格から、同僚の教師や教え子からの人気が高い。"},{"spoiler":false,"text":"体育教員の美貴とは親友同士。"},{"spoiler":false,"text":"恋愛経験はそれなりにあるが、現在はフリー。"}],"source":"egs","sourceCharacterId":"13848","sourceWorkId":"5921","spoiler":false},{"segments":[{"spoiler":false,"text":"24歳。髪はミディアムロング。背は高いほうで、グラビアアイドル級のグラマー。"},{"spoiler":false,"text":"若い英語の教師で、学生Ａのクラスを受け持つ担任で、生徒指導もしている。"},{"spoiler":false,"text":"いまどきめずらしい仕事熱心な教師。"},{"spoiler":false,"text":"誰にも公平に接することと、生徒を子ども扱いしないこと、"},{"spoiler":false,"text":"お堅いところがなく、話のわかることから、学園じゅうの信望を集めている。"},{"spoiler":false,"text":"良い意味でも悪い意味でも、生徒たちのおねえさんといった印象。"},{"spoiler":false,"text":"霊能の持ち主で、先祖にちからのある巫女がおり、その加護を受けている。"},{"spoiler":false,"text":"体育教師とは同僚であり友人。"},{"spoiler":false,"text":"恋愛経験はそれなりだが、いまは特定の恋人はおらず、それを淋しく感じている。非処女。"}],"source":"bangumi","sourceCharacterId":"93107"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34b720853aa26ae8db2e75958a213a758321494f3071010959e98359e1f73f46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19910e9d6539423546c3cd6d975e9c69bf51e346b4b39185fa2ecc8eb5ac00d8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"RUMI","creatorId":"vndb:s1011","sourcePersonId":"vndb:s1011","canonicalEntityId":"vndb:s1011","name":"RUMI","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:27582","source":"vndb"}]},{"characterId":"char_c51016","characterName":"マリア・アン・ミュラー","sourceIds":{"bangumi":[{"characterId":"93108","match":"exact-normalized-name-in-linked-work","subjectId":"225092"}],"egsCharacterIds":["13849"],"vndbCharacterId":"c51016"},"originalCharacterName":"マリア・アン・ミュラー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔女・魔術師狩りを生業とする組織から高見沢学園に送り込まれたウィッチハンター。"},{"spoiler":false,"text":"東欧の生まれで、ルーマニア人の父と日本人の母を持つハーフ。"},{"spoiler":false,"text":"ウィッチハンターとしては、まだまだ新米で実戦経験がほとんどない。"},{"spoiler":false,"text":"感情をあまり表に出さないクールな性格で、無口。"},{"spoiler":false,"text":"幼い頃からウィッチハンターとして育てられたため、一般常識に欠ける面も。"},{"spoiler":false,"text":"また海外生活が長いせいか、日本の生活に戸惑っているようだ。"}],"source":"egs","sourceCharacterId":"13849","sourceWorkId":"5921","spoiler":false},{"segments":[{"spoiler":false,"text":"20歳。髪はウエ－ブのかかったロング。"},{"spoiler":false,"text":"背はそれほど高くないが、バランスのとれた、引き締まった体つきをしている。"},{"spoiler":false,"text":"実戦経験のほとんどない新米のウィッチハンターで、"},{"spoiler":false,"text":"主人公の消息を掴むために、この街に送り込まれてきた。"},{"spoiler":false,"text":"英語教師の受け持つ、２年の学生Ａのクラスに転校生として現れる。"},{"spoiler":false,"text":"東欧の生まれで、ルーマニア人の父と日本人の母を持つハーフ。"},{"spoiler":false,"text":"金髪に青い瞳、抜けるような白い肌をしている。"},{"spoiler":false,"text":"無口でクール、喜怒哀楽をほとんど表さない。"},{"spoiler":false,"text":"小さなころから辺境の村でウィッチハンターとして育てられたため、常識に欠ける。"},{"spoiler":false,"text":"初体験となる日本の学校での生活にとまどい、失敗を繰り返す。"},{"spoiler":false,"text":"うっかりすると、すぐに馬脚を現しそうになるので、学園内では目立たないようにしている。"},{"spoiler":false,"text":"戦闘は得意だが、調査などの隠密行動には向いていない。"},{"spoiler":false,"text":"恋愛経験はもちろんない。"}],"source":"bangumi","sourceCharacterId":"93108"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dff4e0363ec50772f2cdbd6d02d585f9d15daeb3422f5066d38e4ff5838ff7fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0d80bc4f43afe0bf0e88ad19e07f003d4cd717d8eeba9ee75f5e1add5aab512.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"儀武ゆう子","creatorId":"vndb:s263","sourcePersonId":"vndb:s263","canonicalEntityId":"vndb:s263","name":"儀武 ゆう子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225092:93108:4744:1","source":"bangumi"}]},{"characterId":"char_c51017","characterName":"篠原 ほのか","sourceIds":{"bangumi":[{"characterId":"93109","match":"exact-normalized-name-in-linked-work","subjectId":"225092"}],"egsCharacterIds":["13851"],"vndbCharacterId":"c51017"},"originalCharacterName":"篠原 ほのか","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"高見沢学園に通う二年生。"},{"spoiler":false,"text":"おっとりとした天然系の眼鏡ッ娘。"},{"spoiler":false,"text":"肉感的なプロポーションで、見事な巨乳の持ち主。"},{"spoiler":false,"text":"読書が趣味の優等生で、やや妄想癖がある。"},{"spoiler":false,"text":"神話やオカルトなど、神秘的なものに興味を持っており、もっぱらファンタジーやホラー系小説を愛読している。"},{"spoiler":false,"text":"泉美とは親友と云える間柄。"},{"spoiler":false,"text":"恋愛経験はないが、知識だけはたっぷりある。"}],"source":"egs","sourceCharacterId":"13851","sourceWorkId":"5921","spoiler":false},{"segments":[{"spoiler":false,"text":"2年生。髪はミディアムロング。めがね。背は低いが、肉感的なグラマーで、巨乳の持ち主。"},{"spoiler":false,"text":"おっとりしており、天然系。優等生だが、スポーツは苦手。"},{"spoiler":false,"text":"暇があれば想像に耽っていて、ぼんやりしていることが多い。"},{"spoiler":false,"text":"神話、オカルトなど、神秘的なものに興味を持っており、ファンタジーやホラー小説の愛読者。"},{"spoiler":false,"text":"部活はしていないが、図書委員で、放課後はいつも図書室にいる。"},{"spoiler":false,"text":"泉美とは同じクラスで、小さなころからよくいっしょに遊んだ仲。"},{"spoiler":false,"text":"いまでは親友と言っていい関係にある。"},{"spoiler":false,"text":"恋愛経験はないが、知識だけはたっぷりある。そもそも夢見がちなので、恋に恋している。"}],"source":"bangumi","sourceCharacterId":"93109"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18bec21eac2494da06e6e404251947a4fbede8568716c910ce8168ade404ba10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a7fa560111298aba6bcb6f9917ba8d205cd7e46c6a2874c6f7a3e4dd8a50531.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225092:93109:4830:1","source":"bangumi"}]},{"characterId":"char_c51018","characterName":"天野 美貴","sourceIds":{"bangumi":[{"characterId":"93111","match":"exact-normalized-name-in-linked-work","subjectId":"225092"}],"egsCharacterIds":["13852"],"vndbCharacterId":"c51018"},"originalCharacterName":"天野 美貴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"高見沢学園の体育教師。"},{"spoiler":false,"text":"新体操部の顧問で、自らも新体操では元日本代表の強化選手だったが、怪我によって引退。"},{"spoiler":false,"text":"体育会系のノリの指導方法は、学生から敬遠されがち。"},{"spoiler":false,"text":"英語教師の菜々子とは親友の間柄だが、学生から慕われている菜々子に対してのコンプレックスが渦巻いている。"},{"spoiler":false,"text":"過去の悲惨な経験から、潜在的なレズビアンの性癖が……。"}],"source":"egs","sourceCharacterId":"13852","sourceWorkId":"5921","spoiler":false},{"segments":[{"spoiler":false,"text":"25歳。髪はショート。背はそこそこ高く、スレンダーながら出るところは出ている。"},{"spoiler":false,"text":"英語教師の同僚で、新体操部の顧問。"},{"spoiler":false,"text":"新体操では元日本代表候補の強化選手だったが、けがで引退して、体育の教師となった。"},{"spoiler":false,"text":"筋金入りの体育会系で、本人は良かれと思ってやっているのだが、"},{"spoiler":false,"text":"授業や部活ではことさら厳しく接するため、生徒たちに敬遠されている。"},{"spoiler":false,"text":"英語教師とは親友と言ってもいいくらいに親しいが、内心、"},{"spoiler":false,"text":"生徒たちに慕われている彼女にたいするコンプレックスがくすぶっている。"},{"spoiler":false,"text":"処女ではないが、１回きりの、しかも、悲惨な経験しかなく、"},{"spoiler":false,"text":"新しい恋人が欲しいとは思っていない。潜在的なレズビアンでもある。"}],"source":"bangumi","sourceCharacterId":"93111"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b323075100fcd5d6f1845149e1c780936e9a1cf7d64dd4b8cbe2709990872d1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4991189886ef577144c4da5584e61a57975499ca7c054384f86ddaf9ae7bd3e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤邑子","creatorId":"vndb:s833","sourcePersonId":"vndb:s833","canonicalEntityId":"vndb:s833","name":"後藤 邑子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225092:93111:4514:1","source":"bangumi"},{"creditedName":"こむら 菜々","creatorId":"vndb:s4822","sourcePersonId":"vndb:s4822","canonicalEntityId":"vndb:s4822","name":"こむら 菜々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:27583","source":"vndb"}]},{"characterId":"char_c51019","characterName":"小野瀬 櫻子","sourceIds":{"bangumi":[{"characterId":"93112","match":"exact-normalized-name-in-linked-work","subjectId":"225092"}],"egsCharacterIds":["13850"],"vndbCharacterId":"c51019"},"originalCharacterName":"小野瀬 櫻子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が赴任してきた教会で、前任者の補佐を務めていた修道女。"},{"spoiler":false,"text":"優しく、慈愛に満ちた、献身的な女性。"},{"spoiler":false,"text":"信仰心が高く、教区と信者のために働いている。"},{"spoiler":false,"text":"反面、真面目に過ぎ、融通が利かないところも。"},{"spoiler":false,"text":"信仰の道を選んだのは、己の高い情欲を抑えるためだったことから、常に熟れた肉体を持て余し、悶々としている。"}],"source":"egs","sourceCharacterId":"13850","sourceWorkId":"5921","spoiler":false},{"segments":[{"spoiler":false,"text":"26歳。髪はミディアムロング。背は高くも低くもない。着やせするタイプのグラマー。"},{"spoiler":false,"text":"主人公の赴任してきた教会で、前任者の補佐をしていた。"},{"spoiler":false,"text":"優しく、献身的な、慈愛の心の持ち主。"},{"spoiler":false,"text":"信仰に全てを捧げており、教区と信者のために一心に働いている。"},{"spoiler":false,"text":"そのぶん、真面目で、融通は利かない。"},{"spoiler":false,"text":"信者たちからは聖母のように敬愛されているが、多少堅苦しいとも思われている。"},{"spoiler":false,"text":"恋愛経験はないが、子どものころに悪戯され、強姦されたことがあり、処女ではない。"},{"spoiler":false,"text":"その経験から、セックスにたいして否定的。しかし、その実、Ｍ体質で、性欲も強い。"},{"spoiler":false,"text":"そのことは本人も自覚しており、情欲を抑えるために、おのれに禁欲を強いる信仰の道を選んだ。"},{"spoiler":false,"text":"いつも熟れた肉体を持てあましている。"}],"source":"bangumi","sourceCharacterId":"93112"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9ada5dbd3b20571e384f5285adc0b0286ed06e246b921c88aec6ee031d27099f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11b657c61c5badb12e91fabd5dfae12ee7cb765157e473e9df3ff1999dfd5e79.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225092:93112:4956:1","source":"bangumi"}]},{"characterId":"char_vndb_c51020","characterName":"河村 智樹","sourceIds":{"vndbCharacterId":"c51020"},"originalCharacterName":"河村 智樹","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"