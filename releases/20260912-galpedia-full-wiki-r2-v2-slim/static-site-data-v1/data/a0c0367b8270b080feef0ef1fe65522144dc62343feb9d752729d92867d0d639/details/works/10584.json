:"vndb"},{"creditedName":"ZEQU","creatorId":"vndb:s641","sourcePersonId":"vndb:s641","canonicalEntityId":"vndb:s641","name":"ZEQU","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:69819","source":"vndb"},{"creditedName":"松本 竜","creatorId":"vndb:s708","sourcePersonId":"vndb:s708","canonicalEntityId":"vndb:s708","name":"松本 竜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:69822","source":"vndb"},{"creditedName":"宮塚 リキロ","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:69824","source":"vndb"},{"creditedName":"宮塚 リキロ","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:69825","source":"vndb"}]},"cast":[{"characterId":"char_c28241","characterName":"一条 七々織","sourceIds":{"bangumi":[{"characterId":"45905","match":"exact-normalized-name-in-linked-work","subjectId":"192379"},{"characterId":"45905","match":"exact-normalized-name-in-linked-work","subjectId":"303915"}],"egsCharacterIds":["16598"],"vndbCharacterId":"c28241"},"originalCharacterName":"一条 七々織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"203"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"スポーツ万能、抜群のリーダーシップで生徒会を引っ張る学園名物会長で、今回の処女卒業合宿の立案者。"},{"spoiler":false,"text":"気さくで裏表のない性格から、男女ともに人気がある。"},{"spoiler":false,"text":"性知識が豊富そうに話をするが、実は全て知ったかぶりの処女で、男性経験の無さを克服しようと、企画を立てた様子。"}],"source":"egs","sourceCharacterId":"16598","sourceWorkId":"10584","spoiler":false},{"segments":[{"spoiler":false,"text":"生徒会長。三年生。スポーティ巨乳先輩。"},{"spoiler":false,"text":"スポーツ万能、抜群の行動力とリーダーシップで生徒会を引っ張る学園の名物会長。"},{"spoiler":false,"text":"処女卒業合宿を企画した張本人で伸之の活躍！？によって見事、処女を卒業する。"}],"source":"egs","sourceCharacterId":"16598","sourceWorkId":"11375","spoiler":false},{"segments":[{"spoiler":false,"text":"生徒会長。三年生。スポーティ巨乳先輩。"},{"spoiler":false,"text":"スポーツ万能、抜群の行動力とリーダーシップで生徒会を引っ張る学園の名物会長。"},{"spoiler":false,"text":"今回の処女卒業合宿を企画した張本人。"},{"spoiler":false,"text":"気さくで裏表のない性格から男女ともに慕われているが、実は男性経験が皆無なのが悩み。"},{"spoiler":false,"text":"性的な知識については全て知ったかぶりで、処女であることは同じ生徒会のメンバーにもひた隠しにしている。"}],"source":"bangumi","sourceCharacterId":"45905"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fcbf56846b44e20e83da28e2a50604bf2205b52e907058f93919465939de9ccd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48013bc37b4222cc4ebb8454341918767fc2d32367689394b9b8c4af1f128063.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹間千ノ美","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:192379:45905:19333:1","source":"bangumi"}]},{"characterId":"char_c28289","characterName":"翠川 優那","sourceIds":{"bangumi":[],"egsCharacterIds":["16599"],"vndbCharacterId":"c28289"},"originalCharacterName":"翠川 優那","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"303"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"おっとりした良家の箱入り娘。"},{"spoiler":false,"text":"包容力があり母性溢れ、何かと突っ走る七々緒のフォローを受け持つ。"},{"spoiler":false,"text":"Gカップの爆乳とエッチへの高い関心を持つが、男性経験はなく、高校最後の夏休みの冒険として、今回の企画に参加。"},{"spoiler":false,"text":"大事に育てられすぎたせいか、貞操観念や羞恥心が薄い。"}],"source":"egs","sourceCharacterId":"16599","sourceWorkId":"10584","spoiler":false},{"segments":[{"spoiler":false,"text":"生徒会副会長。三年生。マイペース爆乳先輩。"},{"spoiler":false,"text":"良家の子女で箱入り娘。おっとりしていて包容力のある、母性溢れるお嬢さま。"},{"spoiler":false,"text":"Ｇカップ爆乳の持ち主でＨへの関心も人一倍高い。"},{"spoiler":false,"text":"いままで男とつき合った事はなかったが七々織が企画した合宿に参加し伸之に処女を捧げる。"}],"source":"egs","sourceCharacterId":"16599","sourceWorkId":"11375","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3eedfc137d8ba4e4adab416b92154741b93db3f5dcd8b39bc5ee6fb383801121.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb67637ae00aeb8412f58e5f6e5b621ee6419592122c23080b1d7f8388e965e9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青川 ナガレ","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:39192","source":"vndb"}]},{"characterId":"char_c28291","characterName":"伊丹 遥歩","sourceIds":{"bangumi":[{"characterId":"45907","match":"exact-normalized-name-in-linked-work","subjectId":"192379"},{"characterId":"45907","match":"exact-normalized-name-in-linked-work","subjectId":"303915"}],"egsCharacterIds":["16597"],"vndbCharacterId":"c28291"},"originalCharacterName":"伊丹 遥歩","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"101"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Not thought to be interested in romance but does love the protagonist, and wants to go to college with and marry him."}],"source":"vndb","sourceCharacterId":"c28291"},{"segments":[{"spoiler":false,"text":"密かに、伸之に一途な想いを寄せる幼馴染。"},{"spoiler":false,"text":"その想いを今まで伝えられずいたが、二年生に進級し、同じクラスになったことから一念発起で企画に参加。"},{"spoiler":false,"text":"夢は、伸之と一緒に大学へ通い、そのまま同棲し、結婚すること。"},{"spoiler":false,"text":"子供はたくさん欲しいらしく、伸之となら貧乏だって平気。"}],"source":"egs","sourceCharacterId":"16597","sourceWorkId":"10584","spoiler":false},{"segments":[{"spoiler":false,"text":"生徒会書記。二年生。主人公信之の同級生。美乳幼馴染。"},{"spoiler":false,"text":"学園でも評判の美少女。"},{"spoiler":false,"text":"伸之への想いをなかなか切り出せずにいたが、七々織の無茶苦茶な計画の乗って伸之に処女を捧げ結ばれることに。"}],"source":"egs","sourceCharacterId":"16597","sourceWorkId":"11375","spoiler":false},{"segments":[{"spoiler":false,"text":"生徒会書記。二年生。主人公信之の同級生。美乳幼馴染。"},{"spoiler":false,"text":"学園でも評判の美少女だが、浮いた噂ひとつなく、恋愛に興味がないと思われているが、内心では幼馴染みの信之に一途な恋心を抱いている。"},{"spoiler":false,"text":"伸之への想いをなかなか切り出せず、高校に進学してからはあまり交流がなくなった事を気にしていたが、2年生になってクラスが同じになったのを期に一念発起、七々織が企画した合宿に信之を推薦する。"},{"spoiler":false,"text":"夢は伸之と一緒の大学に進学する事。そしてそのまま同棲し、結婚。"},{"spoiler":false,"text":"子供はたくさん欲しい。伸之となら貧乏だって平気。"}],"source":"bangumi","sourceCharacterId":"45907"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf246adcda291e4d3b0d7ebd40a9a301b6b430ebef9df647d7a78a31dec9b0c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93afd9bb9125b7eb14f96e4982fa6f07f428d9255814fe5e95323cf6dadb63cd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:192379:45907:5906:1","source":"bangumi"}]},{"characterId":"char_vndb_c29588","characterName":"香坂　伸之","sourceIds":{"vndbCharacterId":"c29588"},"originalCharacterName":"香坂　伸之","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vn