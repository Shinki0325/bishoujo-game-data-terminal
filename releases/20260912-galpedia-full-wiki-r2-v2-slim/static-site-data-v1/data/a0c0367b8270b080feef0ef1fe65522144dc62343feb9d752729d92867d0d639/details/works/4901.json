"creditedName":"みんめい","creatorId":"vndb:s7931","sourcePersonId":"vndb:s7931","canonicalEntityId":"vndb:s7931","name":"みんめい","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:35536","source":"vndb"}]},"cast":[{"characterId":"char_c27257","characterName":"成羽 菫","sourceIds":{"bangumi":[{"characterId":"94843","match":"exact-normalized-name-in-linked-work","subjectId":"114016"},{"characterId":"94843","match":"exact-normalized-name-in-linked-work","subjectId":"148412"},{"characterId":"94843","match":"exact-normalized-name-in-linked-work","subjectId":"148414"}],"egsCharacterIds":["13873"],"vndbCharacterId":"c27257"},"originalCharacterName":"成羽 菫","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"薊学園三年生で、主人公達の先輩。"},{"spoiler":false,"text":"綺麗だけど、妙な噂が絶えない人。"},{"spoiler":false,"text":"妙な噂とは、部の女子全員を喰ったとかっていうレズな噂を聞いたかと思えば、"},{"spoiler":false,"text":"後輩の男子を摘んでいる等々。"},{"spoiler":false,"text":"そんな艶聞の噂を断固として否定しない意志の強い人物。"},{"spoiler":false,"text":"アロマストラップなる『香油入れ』を常に持ち歩いている。"},{"spoiler":false,"text":"（中身は人を貶めるための睡眠薬だとか媚薬だという噂）"},{"spoiler":false,"text":"登場する女性キャラのなかで、一番大人のキャラ。"},{"spoiler":false,"text":"とかく性に対しては子供のように無邪気という困った人。"},{"spoiler":false,"text":"普段のおっとりした感じからは想像も出来ない"},{"spoiler":false,"text":"ラリー・キングも びっくり官能ハードトークには定評がある。"},{"spoiler":false,"text":"主人公の事を密かに（本人はそう思って）狙っている。"}],"source":"egs","sourceCharacterId":"13873","sourceWorkId":"3181","spoiler":false},{"segments":[{"spoiler":false,"text":"薊学園三年生。"},{"spoiler":false,"text":"アンニュイな感じの美少女。"},{"spoiler":false,"text":"しかし、水泳部の女子たちとレズ関係にあるとか、後輩の男子を摘み食いしているとか、妙な噂が絶えない。"}],"source":"egs","sourceCharacterId":"13873","sourceWorkId":"3687","spoiler":false},{"segments":[{"spoiler":false,"text":"薊学園三年生。心療クラブ代表。"},{"spoiler":false,"text":"学生らしからぬセクシーさとフェロモンを振りまく女性。"},{"spoiler":false,"text":"セックスについても奔放で、気に入れば男、女関係なく、誰とでも寝る。"},{"spoiler":false,"text":"男を手玉にとって、相手の恥ずかしがる姿を見ることに興奮を覚える。"},{"spoiler":false,"text":"うぶな一年生はクラブの新入生の女の子たちを摘み食いしている彼女は、英田柾や神目楓も狙っているらしいが……。"}],"source":"egs","sourceCharacterId":"13873","sourceWorkId":"6136","spoiler":false},{"segments":[{"spoiler":false,"text":"薊学園一年生。"},{"spoiler":false,"text":"家は資産家、門限は夕方という生粋のお嬢様。"},{"spoiler":false,"text":"世間知らずを認めており、親離れをするため、一人暮らしをはじめ薊学園に通っている。"},{"spoiler":false,"text":"早島つばきとは幼馴染みで親友。"},{"spoiler":false,"text":"趣味はアロマセラピー。"},{"spoiler":false,"text":"つばきの側にいる男子が気になるが、友情を気にして言い出せずにいる。"}],"source":"egs","sourceCharacterId":"13873","sourceWorkId":"13025","spoiler":false},{"segments":[{"spoiler":false,"text":"私立薊学園3年。セクシーな外見とエロい心を持つ。"},{"spoiler":false,"text":"決め台詞は「お姉さん変態だから」。"},{"spoiler":false,"text":"男を手玉に取り、相手が恥ずかしがるのが何より興奮するという特殊な性癖。"},{"spoiler":false,"text":"心療クラブという怪しげなサークルの権力者。"}],"source":"bangumi","sourceCharacterId":"94843"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/535e2c2accc1304399288de114e578633ce34c450598605088ef761735bba10e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e11e8e324636095c4a7740e75e87e522f877710add7e2a540ee1612854b7f66c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"児玉さとみ","creatorId":"vndb:s115","sourcePersonId":"vndb:s115","canonicalEntityId":"vndb:s115","name":"児玉 さとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:148413:94843:15954:1","source":"bangumi"}]},{"characterId":"char_c8282","characterName":"建部 稲穂","sourceIds":{"bangumi":[{"characterId":"94848","match":"exact-normalized-name-in-linked-work","subjectId":"148413"},{"characterId":"94848","match":"exact-normalized-name-in-linked-work","subjectId":"148415"},{"characterId":"94848","match":"exact-normalized-name-in-linked-work","subjectId":"213278"}],"egsCharacterIds":["22726"],"vndbCharacterId":"c8282"},"originalCharacterName":"建部 稲穂","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"教育実習生。"},{"spoiler":false,"text":"ショートカットで清潔感溢れる美人。"},{"spoiler":false,"text":"まだ学生であるためか、その服装は教師らしくなく、際どい格好が目立つ。"},{"spoiler":false,"text":"そのため、学園の男子たちの熱い視線を集めている。"},{"spoiler":false,"text":"情熱的な性格だが、それが災いして事件に巻き込まれていく。"}],"source":"egs","sourceCharacterId":"22726","sourceWorkId":"4901","spoiler":false},{"segments":[{"spoiler":false,"text":"私立坂ノ下学園教育実習生"},{"spoiler":false,"text":"同学園の卒業生"},{"spoiler":false,"text":"大学四回生"},{"spoiler":false,"text":"担当教科：英語"},{"spoiler":false,"text":"正義感が強く、元気で活発。面倒見も良い。"},{"spoiler":false,"text":"明るい性格で、過ぎたことはクヨクヨと悩まない。"},{"spoiler":false,"text":"一本気で純粋だが、頑固というわけでもない。"},{"spoiler":false,"text":"周りに気を遣うことも忘れないが、"},{"spoiler":false,"text":"その態度から内面を察することができるほど、顔に感情が出る。"},{"spoiler":false,"text":"スレンダーな体型で、学生時代は陸上部でハードル選手として活躍していた。"},{"spoiler":false,"text":"かつての恩師である美甘櫻に憧れて教師を目指す。"}],"source":"egs","sourceCharacterId":"22726","sourceWorkId":"7395","spoiler":false},{"segments":[{"spoiler":false,"text":"私立薊学園新米教師・新聞部顧問。"},{"spoiler":false,"text":"「青春」と「愛」が口癖の新任教師。"},{"spoiler":false,"text":"顧問のいなかった新聞部の顧問をしている。"},{"spoiler":false,"text":"日々大人社会でストレスに苛まれながらも問題児達を温かく見守っているつもり。"}],"source":"egs","sourceCharacterId":"22726","sourceWorkId":"7850","spoiler":false},{"segments":[{"spoiler":false,"text":"薊学園を数年前に卒業した、教育実習生。"},{"spoiler":false,"text":"まだまだ学生気分が抜けておらず、"},{"spoiler":false,"text":"先生と生徒というより、友達感覚で接してくれる人間を好む。"},{"spoiler":false,"text":"教師になる理由をいまだ見つけられず、"},{"spoiler":false,"text":"口癖である「愛」について深く考える一面もあるが、"},{"spoiler":false,"text":"基本的には底抜けに明るくノリがいいおねーさん。"},{"spoiler":false,"text":"自分の将来について悩みつつ、"},{"spoiler":false,"text":"同年代の少年少女からそのヒントを貰うために日々努力している。"},{"spoiler":false,"text":"学校に短めのスカートを履いてくるなど、"},{"spoiler":false,"text":"無防備なところもあるが、貞操観念はしっかりしている。"},{"spoiler":false,"text":"スタイルはいい方。胸の大きさは普通。"},{"spoiler":false,"text":"真面目な人だけど、周囲に合わせて明るくなったり暗くなったり。"},{"spoiler":false,"text":"臨機応変になんにでも接する事ができる。"},{"spoiler":false,"text":"教師に向いているが、本人はそれに気付いていない。"}],"source":"bangumi","sourceCharacterId":"94848"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa94e9635329b6f255f354adb17f4a4a34f3e7ffa9a2515ddb94d413bc3b9131.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91bd71f1216f0bf496232ba7fd02136c428d3439da290d29942ae9e98fbc0d24.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:148413:94848:4463:1","source":"bangumi"}]},{"characterId":"char_vndb_c27256","characterName":"閑谷 紫苑","sourceIds":{"vndbCharacterId":"c27256"},"originalCharacterName":"閑谷 紫苑","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1446d2d7e804660c70574e5eb9cc97d213aff7dfe0ca30b0deefd3fa2e19333.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a451538a9b8437b05b