spoiler":false,"text":"生徒会所属(庶務)。人のために何でもこなそうと努力するが、行きすぎてウザがられる事も……。"},{"spoiler":false,"text":"人の名前を憶えるのが苦手で、それぞれにあだ名をつけて呼ぶ。"}],"source":"egs","sourceCharacterId":"8646","sourceWorkId":"19980","spoiler":false},{"segments":[{"spoiler":false,"text":"悠斗の双子姉妹の姉のほう。"},{"spoiler":false,"text":"だらしない母親の代わりに何かと悠斗の世話を焼きたがる。"},{"spoiler":false,"text":"ド近眼でメガネ装備。 コンタクトは苦手で涙目になってしまう。"},{"spoiler":false,"text":"学園では生徒会の庶務を担当。"},{"spoiler":false,"text":"サバサバしていて面倒見が良く、同性からも異性からも友達感覚で人気がある。"},{"spoiler":false,"text":"反面、女の子として見られることがなく、異性から告白されたことがない。"},{"spoiler":false,"text":"「そ、それ、妹を女として扱ってるってことよね？　う、うわ……うっわ……」"}],"source":"bangumi","sourceCharacterId":"36803"}],"profileFacts":[{"label":"胸围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"8646","sourceWorkId":"19980","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"8646","sourceWorkId":"19980","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"8646","sourceWorkId":"19980","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"8646","sourceWorkId":"19980","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"8646","sourceWorkId":"19980","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"46 kg","valueContext":null,"source":"egs","sourceCharacterId":"8646","sourceWorkId":"19980","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e884941e4a226239d5e3d4bea1ab4217994eabd8b31cc49f09d18cd8198b99a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/920c6cdd1633136bcb12c6e379b30385fcda4cb9ae054948e61b8a9231e52bd9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田愛衣","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:138051:36803:6509:1","source":"bangumi"}]},{"characterId":"char_c35741","characterName":"神波 さち","sourceIds":{"bangumi":[{"characterId":"36804","match":"exact-normalized-name-in-linked-work","subjectId":"138051"}],"egsCharacterIds":["8647"],"vndbCharacterId":"c35741"},"originalCharacterName":"神波 さち","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"721"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"62"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"隣の家に住む幼なじみ。ポニーテール(オルカテール)の格闘娘(アニメや映画のアクションから吸収した格闘術)"},{"spoiler":false,"text":"不器用なおバカ。直情的でカッとなりやすい。のに、刑事になるのが夢な、ちょっと危うい正義っ娘。"},{"spoiler":false,"text":"兄(神波仁)が大好き。悠斗とは逆に、心の中をうっかり漏らしてしまうタチ(特に兄のことを考えている時など)"},{"spoiler":false,"text":"思い込み激しく、それが原因で人間関係が上手くいかないことも。"},{"spoiler":false,"text":"悠斗は電車だが、さちはローラー付きの特製シューズで登校している(鍛えるため)"},{"spoiler":false,"text":"父親は割と有名な家電量販店コウナミ電機の社長。隠しているわけではないが自分から言うことはない。"}],"source":"egs","sourceCharacterId":"8647","sourceWorkId":"19980","spoiler":false},{"segments":[{"spoiler":false,"text":"長沢家の隣家に住む幼なじみ。 ポニーテール。"},{"spoiler":false,"text":"アニメの変身ヒロインが好きで、正義を愛し、独自の格闘術を持っている。"},{"spoiler":false,"text":"スペックは 不器用なおバカ、高飛車ツンツン、ハッキリしないことが嫌い。"},{"spoiler":false,"text":"心の中で言っているつもりのことをうっ