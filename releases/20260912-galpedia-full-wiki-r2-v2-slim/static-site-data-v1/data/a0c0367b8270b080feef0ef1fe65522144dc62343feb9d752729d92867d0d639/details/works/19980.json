することになっていて、うまくやれるか不安に思っている。"},{"spoiler":false,"text":"日本のことは大好きで、日本語もかなり勉強している。 侍とお笑いに特別な興味を抱く。"},{"spoiler":false,"text":"おおらかでゆったりマイペース。 何をされても怒らず、“罪を憎んで人を憎まず” を体現している。"},{"spoiler":false,"text":"おもしろいことを常に優先し、ハプニングが起こりそうな方向に嗅覚を働かせる。"},{"spoiler":false,"text":"「何でもするよ、一生。 ウチ……アナータの願い、実行するやのん」"}],"source":"bangumi","sourceCharacterId":"36806"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"8649","sourceWorkId":"19980","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"8649","sourceWorkId":"19980","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"147 cm","valueContext":null,"source":"egs","sourceCharacterId":"8649","sourceWorkId":"19980","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"8649","sourceWorkId":"19980","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"8649","sourceWorkId":"19980","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"46 kg","valueContext":null,"source":"egs","sourceCharacterId":"8649","sourceWorkId":"19980","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee7ba9da10a9d9f50c8ca949a9a4e27bd83ea293400aead7c1f3dd1ff958782b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22e6368ec997500d94cd7206d893aeef2ba79b0096872d6a37e1640b573f3325.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:138051:36806:5052:1","source":"bangumi"}]},{"characterId":"cha