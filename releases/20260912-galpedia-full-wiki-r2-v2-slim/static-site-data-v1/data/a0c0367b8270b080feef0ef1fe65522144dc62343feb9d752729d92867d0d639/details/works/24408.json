atus":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"131"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Favorite colors: Black, dark red"},{"spoiler":false,"text":"Favorite things: Water balloons, cotton candy"}],"source":"vndb","sourceCharacterId":"c22036"},{"segments":[{"spoiler":false,"text":"浅草橋の裏路地で「機巧屋」という雑貨屋を経営している不思議な女の子。"},{"spoiler":false,"text":"主人公【多輝】に時間を操る力を与える。"},{"spoiler":false,"text":"それは一日をプラスできるというもの。"},{"spoiler":false,"text":"普段は店の一番奥にちょこんと座って、収集した骨董級の古い時計を眺めてはうっとりしている。"}],"source":"egs","sourceCharacterId":"2243","sourceWorkId":"19221","spoiler":false},{"segments":[{"spoiler":false,"text":"『1/2 summer（ワンサイドサマー）』 に座敷童子として登場したクロハ。"},{"spoiler":false,"text":"力を取り戻したことで自由を手に入れ、ふらりと東京へとやって来ていた。"},{"spoiler":false,"text":"そしてこの神田旅籠町番外地で、『機巧屋』 という雑貨屋を経営している。"},{"spoiler":false,"text":"なにやら企んでいる様子で、主人公・多輝に “一日をプラスする” 時間を操る力を授ける。"},{"spoiler":false,"text":"普段は店の一番奥にちょこんと座って、裏路地を通り行く人をなんとなく目で追っている不思議な女の子。"},{"spoiler":false,"text":"そして毎日のように収拾した骨董級の古い時計を眺めては、うっとりしている。"},{"spoiler":false,"text":"すべての力を取り戻したことで “クロハ” から “黒翼” と名乗るようになった。"},{"spoiler":false,"text":"「その美味しそうなものは何？　ほう、ドーナツとな !?」"}],"source":"bangumi","sourceCharacterId":"22859"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba44f6de32cd91033f0961269fc46178837cb39d347c64e9dee3af505af74675.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe33a67860e43308dd824a08fcb8ffcf6cd085367517ec7a2cfe0a9acf804a58.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:76913:22859:11646:1","source":"bangumi"}]},{"characterId":"char_c24121","characterName":"蔵前 ななみ","sourceIds":{"bangumi":[{"characterId":"22853","match":"exact-normalized-name-in-linked-work","subjectId":"76913"}],"egsCharacterIds":["2237"],"vndbCharacterId":"c24121"},"originalCharacterName":"蔵前 ななみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Favorite color: red, black"},{"spoiler":false,"text":"Favorite food: soba"},{"spoiler":false,"text":"Least favorite food: spicy stuff"}],"source":"vndb","sourceCharacterId":"c24121"},{"segments":[{"spoiler":false,"text":"多輝の幼馴染みで活発な女の子。"},{"spoiler":false,"text":"ハキハキとしていて主導権を握りたがる、アクティブな女の子。"},{"spoiler":false,"text":"多輝のことが好きで、多輝と二人っきりになるために賽の目クラブを作った。"},{"spoiler":false,"text":"そんな能動的なななみだがが、実は肝心なところや自分が決められないことは多輝に決めてもらったりする甘えん坊。"},{"spoiler":false,"text":"多輝にはなんだかんだで頼りっぱなし。左利き。"}],"source":"egs","sourceCharacterId":"2237","sourceWorkId":"19221","spoiler":false},{"segments":[{"spoiler":false,"text":"多輝の幼なじみで、活発な女の子。 左利き。"},{"spoiler":false,"text":"ハキハキとしていて主導権を握りたがるアクティブタイプ。"},{"spoiler":false,"text":"多輝のことが好きで、多輝と二人っきりになるために “賽の目クラブ” を作った。"},{"spoiler":false,"text":"そんな能動的な ななみ だが、実は肝心なことは多輝に決めてもらったりする甘えん坊なところがある。"},{"spoiler":false,"text":"多輝にはなんだかんだで頼りっぱなし。"},{"spoiler":false,"text":"「じゃん！　お弁当作ってきたよ、一緒に食べよ？　うわ、何そのイヤそうな顔！　あたしだって腕を磨いたのよ!?」"}],"source":"bangumi","sourceCharacterId":"22853"}],"profileFacts":[],"