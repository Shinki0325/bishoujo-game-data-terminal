82cb18d9759106c26f.webp","width":146,"height":256,"source":"static-detail"},"actors":[{"creditedName":"川澄綾子","creatorId":"vndb:s16","sourcePersonId":"vndb:s16","canonicalEntityId":"vndb:s16","name":"川澄 綾子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37382:36730:740:1","source":"bangumi"}]},{"characterId":"char_bangumi_36731","characterName":"キハラ アツロウ","sourceIds":{"bangumi":[{"characterId":"36731","match":"source-roster","subjectId":"37382"}]},"originalCharacterName":"キハラ アツロウ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"热情仗义的主角好友"},{"spoiler":false,"text":"主角的好友，与主角就读同一所高中。为人正直热情，偶尔也会满口艰涩理论。小学起便对BBS论坛等颇有兴趣，目标是当个高级程序员。跟主角一样是持有COMP的恶魔召唤师。"}],"source":"bangumi","sourceCharacterId":"36731"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fce712b15794ce049961ab77a6e074a7be7b562a322b0b24f8fa724386e7a5ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2be0b8ee89cfbbd22206b600eee2cb91a710cc8b91fd020ca49ed5808908a57d.webp","width":177,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阿部敦","creatorId":"vndb:s633","sourcePersonId":"vndb:s633","canonicalEntityId":"vndb:s633","name":"阿部 敦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37382:36731:5015:1","source":"bangumi"}]},{"characterId":"char_bangumi_36732","characterName":"タカギ ケイスケ","sourceIds":{"bangumi":[{"characterId":"36732","match":"source-roster","subjectId":"37382"}]},"originalCharacterName":"タカギ ケイスケ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"对破坏秩序者加以制裁的少年"},{"spoiler":false,"text":"主角的好友木原笃郎初中时的朋友，升入高中后经常受欺负，此后渐渐养成了不信任他人的性格。持有COMP成功召唤恶魔的圭介在某件事的刺激下，盛怒之中决意创造一个只有正义存在的世界，并且开始了他疯狂的制裁行动。"}],"source":"bangumi","sourceCharacterId":"36732"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/5266b6cebe659a99ca9d5c9013b1e163bcda35a0fb98de39fb04d4b814717148.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23629c17b04c58bd89f79c5d2c56e5f37f95b7f9a9f325e420456954cebece03.webp","width":136,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶裕貴","creatorId":"vndb:s84","sourcePersonId":"vndb:s84","canonicalEntityId":"vndb:s84","name":"梶 裕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37382:36732:5209:1","source":"bangumi"}]},{"characterId":"char_bangumi_36733","characterName":"コマキ ミドリ","sourceIds":{"bangumi":[{"characterId":"36733","match":"source-roster","subjectId":"37382"}]},"originalCharacterName":"コマキ ミドリ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"乐于救人的网络偶像美少女"},{"spoiler":false,"text":"15岁的初中生，COSPLAY界知名网络偶像，昵称小翠。手持COMP成为恶魔召唤使后，充满正义感的小翠便致力于帮助手无寸铁的平民，但不知不觉中自己的恶魔使能力也开始遭到人们的嫉妒和诘难……"}],"source":"bangumi","sourceCharacterId":"36733"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01c4a9f0ee4380c493131de657936524404ecaa5fa1b4fab88b764e676dac4b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/017ec00545d2d1456dffa013acde01de0989c7a19d51186e78eb5a499cee33c8.webp","width":175,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊瀬茉莉也","creatorId":"vndb:s4898","sourcePersonId":"vndb:s4898","canonicalEntityId":"vndb:s4898","name":"伊瀬 茉莉也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37382:36733:4769:1","source":"bangumi"}]},{"characterId":"char_bangumi_36734","characterName":"クズリュウ アマネ","sourceIds":{"bangumi":[{"characterId":"36734","match":"source-roster","subjectId":"37382"}]},"originalCharacterName":"クズリュウ アマネ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"从恐惧中拯救人类的现代巫女"},{"spoiler":false,"text":"翔门会教祖的女儿，16岁，浑身弥漫着一股神秘的气息。身为翔门会屈指的超能力巫女，天音拥有连恶魔都畏惧三分的强大实力，一直活跃在救助市民的第一线。"}],"source":"bangumi","sourceCharacterId":"36734"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/071337bcf2b4233ad63f0333f9aa358c5e4de1b4432f37ac5ff4f2e6c8328cf3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/416574e53fdd897839669d3f61412199d28a7b53b5537d05a486d9c7a7f7a0e4.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"能登麻美子","creatorId":"vndb:s468","sourcePersonId":"vndb:s468","canonicalEntityId":"vndb:s468","name":"能登麻美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37382:36734:3827:1","source":"bangumi"}]},{"characterId":"char_bangumi_36735","characterName":"ハルサワ ヨシノ","sourceIds":{"bangumi":[{"characterId":"36735","match":"source-roster","subjectId":"37382"}]},"originalCharacterName":"ハルサワ ヨシノ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"在封锁之城歌唱的摇滚歌手"},{"spoiler":false,"text":"20岁的女性歌手，著名地下乐队D·VA的主唱。演唱乐队成员彩留下的序列发生器中谱好的乐曲时不慎召唤出恶魔，为此她深感内疚，认为东京全域恶魔的暴行是她的责任。"}],"source":"bangumi","sourceCharacterId":"36735"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e43d0c50223ed443c665e4b6a87d3166e0e2e73cdc6ffb09023253c18a76822e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43c46262f8df192de82ea2d7ca7e50b9e0bcf3462cca89958e477fe557de55c9.webp","width":190,"height":256,"source":"static-detail"},"actors":[{"creditedName":"皆川純子","creatorId":"vndb:s948","sourcePersonId":"vndb:s948","canonicalEntityId":"vndb:s948","name":"皆川純子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37382:36735:4224:1","source":"bangumi"}]},{"characterId":"char_bangumi_36736","characterName":"カミヤ エイジ","sourceIds":{"bangumi":[{"characterId":"36736","match":"source-roster","subjectId":"37382"}]},"originalCharacterName":"カミヤ エイジ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"等待失踪恋人的酒吧老板"},{"spoiler":false,"text":"在东京表参道经营一家酒吧兼乐队舞台，25岁。封锁后酒吧被迫停业，咏司在烦恼之余也会幸灾乐祸地旁观东京的混乱事态。地下乐队D·VA的键盘手彩突然失踪后，身为彩的男友，咏司一直试图找到彩的踪迹。"}],"source":"bangumi","sourceCharacterId":"36736"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b929f39f785e398f0ad4217993b1de72d1a0726178be5e975eaf5d6434334b54.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4ff6a829ec973baef18e7b6c0e2b7a18d8b0cc356682593ba399964d26f8c798.webp","width":104,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小西克幸","creatorId":"vndb:s65","sourcePersonId":"vndb:s65","canonicalEntityId":"vndb:s65","name":"小西 克幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37382:36736:3861:1","source":"bangumi"}]},{"characterId":"char_bangumi_36737","characterName":"ニカイドウ タダシ","sourceIds":{"bangumi":[{"characterId":"36737","match":"source-roster","subjectId":"37382"}]},"originalCharacterName":"ニカイドウ タダシ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"充满野心的超能力团团长"},{"spoiler":false,"text":"超能力团“涉谷DIMONS”的团长，19岁。外表看似凶恶，其实相当善解人意关心他人。原本身为团长的哥哥成了连续杀人案“吸血事件”的牺牲品后，手持COMP的征志发誓要替哥哥报仇雪恨。"}],"source":"bangumi","sourceCharacterId":"36737"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a26d380f0f0929b595c963ebe6f2a942045411fb57a99cd75e148f4a736f65f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17b37d78c2d75b892cfd36726e3c0d1e42e2dde19fe5d46e624e88898d12a60d.webp","width":98,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間宮康弘","creatorId":"vndb:s546","sourcePersonId":"vndb:s546","canonicalEntityId":"vndb:s546","name":"間宮 康弘","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37382:36737:5218:1","source":"bangumi"}]},{"characterId":"char_bangumi_36738","characterName":"モチヅキ マリ","sourceIds":{"bangumi":[{"characterId":"36738","match":"source-roster","subjectId":"37382"}]},"originalCharacterName":"モチヅキ マリ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"欲为死去恋人复仇的女性"},{"spoiler":false,"text":"23岁的小学保健老师，曾当过主角好友笃郎初中时的家庭教师。与超能力团“涉谷钻石”的团长二阶堂征志自幼相识，一直暗恋他的哥哥。征志哥哥死于“吸血事件”后，出于对凶手的憎恨，她从未放弃过寻找杀害征志哥哥的罪魁祸首。"}],"source":"bangumi","sourceCharacterId":"36738"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/4440cd6bf40c3a20dbfc177a953aaffe6a7f282aa19d3ef059d906f3b9271e83.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b958059b73d63733a5c2dd43fe31ca8d01e696e0625604011475301b8804f149.webp","width":188,"height":256,"source":"static-detail"},"actors":[{"creditedName":"河原木志穂","creatorId":"vndb:s13","sourcePersonId":"vndb:s13","canonicalEntityId":"vndb:s13","name":"河原木 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37382:36738:4422:1","source":"bangumi"}]},{"characterId":"char_bangumi_36739","characterName":"ホンダ ヤスユキ","sourceIds":{"bangumi":[{"characterId":"36739","match":"source-roster","subjectId":"37382"}]},"originalCharacterName":"ホンダ ヤスユキ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"29歳。ハンドルネームは「YASPON」。封鎖内にいる男性会社員。とある企業から、悪魔を捕獲するという依頼を受けている。また、封鎖の外に重病の息子がおり、なんとしても脱出しようとする。"},{"spoiler":false,"text":"落ち着いた大人、良き父親のようなそぶりをしているが、カイドーと一緒に民間人に復讐を仕掛けたり、身勝手ともとれる強硬な手段に出ることもある。"},{"spoiler":false,"text":"ルートによっては本性を現す。"}],"source":"bangumi","sourceCharacterId":"36739"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a167cc4bf7d95a52dbbe74f3113be4ca707a4fc0a772ab44b0c4b9cde6f2a8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/295ef5c5c177d1057a0494e2111e5daf38539cd161f611b86784f10ef65fc2f9.webp","width":240,"height":240,"source":"static-detail"},"actors":[{"creditedName":"津田健次郎","creatorId":"vndb:s739","sourcePersonId":"vndb:s739","canonicalEntityId":"vndb:s739","name":"津田 健次郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37382:36739:3977:1","source":"bangumi"}]},{"characterId":"char_bangumi_36740","characterName":"ナオヤ","sourceIds":{"bangumi":[{"characterId":"36740","match":"source-roster","subjectId":"37382"}]},"originalCharacterName":"ナオヤ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“恶魔召唤程序”的中心人物"},{"spoiler":false,"text":"主角的表兄，天才程序员，自幼失去双亲后被主角一家收养，现独自居住在东京青山。主角一行手中安装有“恶魔召唤程序”的COMP正是他的杰作，不知他是否与东京的骚乱有着某种关联呢？"}],"source":"bangumi","sourceCharacterId":"36740"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01266540415ceba87f572b7f4e3de47af2200182daf96d290c4f155180d58075.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/187a01ae5cc74b7d4d1608b702af62b4d7aff8a9849aa1e481d4a7d241a44a10.webp","width":80,"height":256,"source":"static-detail"},"actors":[{"creditedName":"谷山紀章","creatorId":"vndb:s59","sourcePersonId":"vndb:s59","canonicalEntityId":"vndb:s59","name":"谷山 紀章","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37382:36740:4678:1","source":"bangumi"}]},{"characterId":"char_bangumi_36741","characterName":"ショウジ","sourceIds":{"bangumi":[{"characterId":"36741","match":"source-roster","subjectId":"37382"}]},"originalCharacterName":"ショウジ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"女性ジャーナリスト。封鎖内で取材活動を行っているが英語混じりや時代遅れの言葉遣いが節々にある。"},{"spoiler":false,"text":"過去に先輩が政府の陰謀を知ったことで殺されており、今回の封鎖の真相を突き止めたいという気持ちは人一倍強い。"}],"source":"bangumi","sourceCharacterId":"36741"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d1bd27029c0bd32d28b95f18c53fdc586d073773eda30668b81529cced4a464.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a0147fe6bc78b2b7ad1c626328920b91fb9db29090bfd00856c43a011a47a72.webp","width":240,"height":240,"source":"static-detail"},"actors":[{"creditedName":"渡辺明乃","creatorId":"vndb:s499","sourcePersonId":"vndb:s499","canonicalEntityId":"vndb:s499","name":"渡辺明乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37382:36741:4032:1","source":"bangumi"}]},{"characterId":"char_bangumi_36742","characterName":"イヅナ ミサキ","sourceIds":{"bangumi":[{"characterId":"36742","match":"source-roster","subjectId":"37382"}]},"originalCharacterName":"イヅナ ミサキ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"26歳。政府の派遣した特殊部隊「STF」の女性隊員。"},{"spoiler":false,"text":"自衛隊、警察、消防の指揮権を持っており、自衛隊としては一尉の階級を持っている。また、一般には知られていない政府の秘密を概ね把握している。"},{"spoiler":false,"text":"任務には忠実だが、国民に銃を向ける事には胸を痛めており、事態収拾のため主人公達に協力を求める。そのために命を捨てる覚悟があり、後にCOMPを入手して悪魔と契約する。これにより、彼女も封鎖内から出られなくなる。"}],"source":"bangumi","sourceCharacterId":"36742"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/6630caf08d35e0898723ec44ac99cdaf0157f854e5e677