source-roster","subjectId":"51705"},{"characterId":"123327","match":"source-roster","subjectId":"73740"},{"characterId":"123327","match":"source-roster","subjectId":"85085"}]},"originalCharacterName":"Ikaruga Takatsugu","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"斯衛軍第16斯衛大隊指揮官。五摂家と呼ばれる五代武家の一家である斑鳩家の当主。五摂家出身者にのみ搭乗が許される青い武御雷を駆り、甲21号作戦に参戦する。"}],"source":"bangumi","sourceCharacterId":"123327"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8320b154a62e7e70533bacaaa7b4a47b81eaa3eac640ebdc499fcdabdcf8a620.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27f0519768a55a4f02f8591276af6291ad44de78a6ad18ee91817d42b0db6820.webp","width":77,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_16867","characterName":"しろがね たける","sourceIds":{"bangumi":[{"characterId":"16867","match":"source-roster","subjectId":"116744"},{"characterId":"16867","match":"source-roster","subjectId":"225992"},{"characterId":"16867","match":"source-roster","subjectId":"29469"},{"characterId":"16867","match":"source-roster","subjectId":"47274"},{"characterId":"16867","match":"source-roster","subjectId":"4827"},{"characterId":"16867","match":"source-roster","subjectId":"4828"},{"characterId":"16867","match":"source-roster","subjectId":"73740"}]},"originalCharacterName":"しろがね たける","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1216"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"男主角。隶属于联合国太平洋方面第11军横滨基地卫士训练学校第207卫士训练部队的训练兵（军校毕业后任职少尉）。"},{"spoiler":false,"text":"EXTRA篇为主人公白银武和青梅竹马的鉴纯夏、突然转入的御剣冥夜以及同班同学们之间的学园剧。"},{"spoiler":false,"text":"UNLIMITED篇中，白银武某日醒来后发现自己进入了一个平行世界，在这个平行世界里，地球人数十年来都与带有敌意的外星生命体“BETA”苦战着。自己被卷入这场战争中。"},{"spoiler":false,"text":"ALTERNATIVE篇，武发现自己经过时间跳跃又一次来到了充满战乱的平行世界。他决定以唯一知道这个世界的未来的人类的身分，为了完成“ALTERNATIVE4”计划而再次敲开联合国军横滨基地的大门。"},{"spoiler":false,"text":"有着成为卫士的才能，再次被编入207实验部队的武，带着3年之间的军事经验和未来的记忆，以及不输给伙伴们的觉悟，再次迎向挑战。"},{"spoiler":false,"text":"时间只剩下两个月左右。究竟武是否能达到目的，人类又是否能战胜BETA呢……？"}],"source":"bangumi","sourceCharacterId":"16867"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63d9ec1a233ca0e96b0ba0ef0405bfe6416807bce39a7ed2e98e6c2d4eb98919.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/034893bbe5ffbd58f40cdf38b27ba5fa201ce7dd6b3be2bc630148b8c60d1bd1.webp","width":63,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_16869","characterName":"みつるぎ めいや","sourceIds":{"bangumi":[{"characterId":"16869","match":"source-roster","subjectId":"225992"},{"characterId":"16869","match":"source-roster","subjectId":"47274"},{"characterId":"16869","match":"source-roster","subjectId":"4827"},{"characterId":"16869","match":"source-roster","subjectId":"4828"},{"characterId":"16869","match":"source-roster","subjectId":"73740"}]},"originalCharacterName":"みつるぎ めいや","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1216"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"和武一样身为联合国太平洋军第11军・横浜基地卫士训练学校・第207卫士训练部队所属训练兵（军校毕业后任职少尉），也是日本帝国政威大将军煌武院悠阳（こうぶいん ゆうひ）的双胞胎妹妹。"},{"spoiler":false,"text":"接近战的王者，持有名刀皆琉神威的剑术高手。气质高雅，沉着冷静。"},{"spoiler":false,"text":"在搬运冥夜专用的战术机武御雷，帝国近卫军所属的月咏中尉等人对她的守护等事情里，都可以看出她身份的重要性。但是冥夜本人却不喜欢自己受到特别的对待"},{"spoiler":false,"text":"UNLIMITED篇时得知她是统治日本的将军家族的亲戚，但并未说明详情，而武直到12·5事件才得知真相。"},{"spoiler":false,"text":"曾UNLIMITED篇中，冥夜始终没搭乘过的专用紫色武御雷，到了ALTERNATIVE篇终于能正式出阵。"},{"spoiler":false,"text":"樱花作战中向武告白后和重头脑级同归于尽。"}],"source":"bangumi","sourceCharacterId":"16869"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6abee37ca1bb8ff36aa00fa5edf72369779368acfaf5856f4408cc47e32f7cca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/666a8acacebe3c513ad317bfe8caf024c7a938451094d090caf0d1f971d665d6.webp","width":121,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_16875","characterName":"じんぐうじ まりも","sourceIds":{"bangumi":[{"characterId":"16875","match":"source-roster","subjectId":"115675"},{"characterId":"16875","match":"source-roster","subjectId":"14107"},{"characterId":"16875","match":"source-roster","subjectId":"14496"},{"characterId":"16875","match":"source-roster","subjectId":"16959"},{"characterId":"16875","match":"source-roster","subjectId":"29469"},{"characterId":"16875","match":"source-roster","subjectId":"4827"},{"characterId":"16875","match":"source-roster","subjectId":"4828"},{"characterId":"16875","match":"source-roster","subjectId":"73740"}]},"originalCharacterName":"じんぐうじ まりも","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0810"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"３年Ｂ組的担任教師。担当教科是英語。"},{"spoiler":false,"text":"横滨基地卫士训练学校的教官，军阶为中士。国連軍20700。"},{"spoiler":false,"text":"A-01部队的卫士们全是她的学生。"},{"spoiler":false,"text":"和夕呼是自横滨基地由联合国军接管前，还是日本帝国军白陵基地时就认识的朋友。"},{"spoiler":false,"text":"日本帝国陆军出身。深受所有学生的敬爱。"}],"source":"bangumi","sourceCharacterId":"16875"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b773f197d7b9a396ed7ac0f0d24e740b20bae67ee3940645c0a990a74be8f57d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52c83c00b01dcfd2598be20c75349f81c5119ef418d0f69443d0d5bd1d80cd6c.webp","width":61,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_29013","characterName":"アルフレッド・ウォーケン","sourceIds":{"bangumi":[{"characterId":"29013","match":"source-roster","subjectId":"4828"},{"characterId":"29013","match":"source-roster","subjectId":"73740"}]},"originalCharacterName":"アルフレッド・ウォーケン","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"米国陸軍に所属する歴戦の衛士。米軍対日派遣部隊指揮官。階級は少佐。冷静沈着、実直で客観性を失わない優れた武人。クーデター戦にて沙霧大尉に倒される。TDAではアメリカ代表として交渉も担当。政治能力も非常に高いことが判明した。妻子持ちで、妻の名はマリア、息子の名はブライアン。彼の息子のブライアンはF-22Aラプター搭乗するウォーケンに憧れ衛士になりたいという夢を持っていたが、G弾による重力偏差の結果の大気の大減圧の為に死亡したと思われる。AL,TDAのどちらにしてもキーホルダーは渡せていない。"}],"source":"bangumi","sourceCharacterId":"29013"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/702af750548f17146efb89020846205d2d2be1a5dab7290c431bc2a7e7169eef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fec59558a72d8d53a986a1db01cfbc78af65f563022a4b5ebff90d50b7ceda7c.webp","width":104,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_29014","characterName":"沙霧尚哉","sourceIds":{"bangumi":[{"characterId":"29014","match":"source-roster","subjectId":"4827"},{"characterId":"29014","match":"source-roster","subjectId":"4828"},{"characterId":"29014","match":"source-roster","subjectId":"73740"}]},"originalCharacterName":"沙霧尚哉","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"彩峰萩閣の部隊に所属していて、「光州作戦」の前に負傷し、内地送還になった為、軍の追及・処罰を免れる。この事を機に、12･5事件を起こしたと思われる。『オルタ』最強衛士候補。月詠に殺されたがっていた。慧の返事が来ないって毎回軽く落ち込んでいた。で決起、というのは嘘なので信じないように。TDAにおいて日米と敵対関係にあるフランス軍のラファールに搭乗し、ウォーケンのF-22と死闘を演じる。"}],"source":"bangumi","sourceCharacterId":"29014"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04f5e27e4c45bf92260313afe2315ea457f87e8c99b090ef346aefd94ddb930b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34f2b09be9e29b50b81047d155b710cd2359a96c6264e8f9894282536ee3c471.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_63807","characterName":"たつなみ ひびき","sourceIds":{"bangumi":[{"characterId":"63807","match":"source-roster","subjectId":"16959"},{"characterId":"63807","match":"source-roster","subjectId":"29469"},{"characterId":"63807","match":"source-roster","subjectId":"73740"}]},"originalCharacterName":"たつなみ ひびき","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"第1戦術機甲連隊第1大隊第17小隊“ウォードッグ”所属で小隊長。階級は中尉。"},{"spoiler":false,"text":"過去にも小隊を率いた経験がある。前向きな性格で隊の士気を維持している。"},{"spoiler":false,"text":"ムキムキの筋肉に強い憧れを持っている。"}],"source":"bangumi","sourceCharacterId":"63807"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc7acf09c81e30971681cfaf06217d89b6e9296513dea22bd715eba14ac6a8e7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/t