:"vndb:s2810","name":"ウシ子","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:149481","source":"vndb"}]},"cast":[{"characterId":"char_c73007","characterName":"結城 桜","sourceIds":{"bangumi":[{"characterId":"64942","match":"exact-normalized-name-in-linked-work","subjectId":"252066"}],"egsCharacterIds":["20135"],"vndbCharacterId":"c73007"},"originalCharacterName":"結城 桜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真人の幼馴染みの見習いメイド。お節介焼きの性格で、孤立しがちな真人のことを心配し、「自分が守ってあげないと」と思っている。真人が自宅からメイド（玲奈）に連れられていくのを目撃し、"},{"spoiler":false,"text":"気になって後をつけ、真人の祖父の遺言と、インキュバスの力の秘密を知る。"},{"spoiler":false,"text":"真人をド変態にしないためにも見習いメイドとして、彼のお世話に参加する。"},{"spoiler":false,"text":"家事全般は普通にこなせる。"}],"source":"egs","sourceCharacterId":"20135","sourceWorkId":"26983","spoiler":false}],"profileFacts":[{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"20135","sourceWorkId":"26983","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"20135","sourceWorkId":"26983","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae86c81fe0e520acb754db0d9c78fa9d3a8a940020850b307f9db156df8e8f46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51d9e53c44c539ace9d3de3277e6ec61403e4e4df297ed86e57532734235cf34.webp","width":116,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:252066:64942:5906:1","source":"bangumi"}]},{"characterId":"char_c73008","characterName":"犬飼 愛萌","sourceIds":{"bangumi":[{"characterId":"64944","match":"exact-normalized-name-in-linked-work","subjectId":"252066"}],"egsCharacterIds":["20136"],"vndbCharacterId":"c73008"},"originalCharacterName":"犬飼 愛萌","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"屋敷のドジっ娘メイド。人の役に立ちたくてメイドになるも、極度のあがり症で入社一年目にして解雇通告を受けてしまい、最後のチャンスとして真人の世話を命じられる。"},{"spoiler":false,"text":"むっつりスケベで、メイド長の玲奈からインキュバスの精液について聞かされ、恥ずかしがりつつも真人のお世話に興味津々。巨乳のため足元が見えず、よくつまずいて転ぶ。また、胸が感じやすい。"},{"spoiler":false,"text":"感じすぎると、オシッコを漏らしてしまう。"}],"source":"egs","sourceCharacterId":"20136","sourceWorkId":"26983","spoiler":false}],"profileFacts":[{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"20136","sourceWorkId":"26983","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"20136","sourceWorkId":"26983","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76d68e73f42ef9058f28d9563bbc51696145fd13acc96545c0bd23aa2ae6cb99.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa34e33823759156f4b7b4bddcc3c3b3910d08d40219ed51984d01c0c830c845.webp","width":116,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:252066:64944:5900:1","source":"bangumi"}]},{"characterId":"char_c73009","characterName":"大河 玲奈","sourceIds":{"bangumi":[],"egsCharacterIds":["20137"],"vndbCharacterId":"c73009"},"originalCharacterName":"大河 玲奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"屋敷のメイド長。真人の祖父・源三の右腕であり、源三の経営する「行久場メイドカンパニー」の秘書も務める才女。ただし、真人を呼びに行っていきなりフェラをするほど、媚薬効果のあるインキュバスの精液が大好きで、まだ力を制御できない真人の精液を虎視眈々と狙っている。"},{"spoiler":false,"text":"過去はビッチギャルだったが、源三と出会い、その有能さを買われて今に至る。"},{"spoiler":false,"text":"貞操概念がほぼ無い。"}],"source":"egs","sourceCharacterId":"20137","sourceWorkId":"26983","spoiler":false}],"profileFacts":[{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"20137","sourceWorkId":"26983","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"20137","sourceWorkId":"26983","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/0953eb3c32ca39a74a42a4a65d93fd76cc12e2c58d4563932fc51e3f83860055.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/5286570d0e4c13ba353187e8ac4609762b6ac2d8188ad7245e1e2a793c7bee20.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榛名 れん","creatorId":"vndb:s455","sourcePersonId":"vndb:s455","canonicalEntityId":"vndb:s455","name":"神保 巴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:78015","source