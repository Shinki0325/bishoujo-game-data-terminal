"vndb:s8123","name":"らんまる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:139333","source":"vndb"}]},"cast":[{"characterId":"char_c63202","characterName":"未来","sourceIds":{"bangumi":[{"characterId":"54276","match":"exact-normalized-name-in-linked-work","subjectId":"215808"}],"egsCharacterIds":["16360"],"vndbCharacterId":"c63202"},"originalCharacterName":"未来","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"上流家庭で育った元お嬢様。名門女子校を卒業したばかり。"},{"spoiler":false,"text":"容姿、スタイルは色んな意味で抜群であり、オタク層のど真ん中を行く美少女。"},{"spoiler":false,"text":"恋愛経験は特になく、自慰もしたことのない穢れ無き処女。性知識も小学生並だが、感度は良好（くすぐったがり屋）"},{"spoiler":false,"text":"オタク知識も皆無であり、コスプレやシチュに恥じらいや照れが強く、その初々しさが受けたりもする。"},{"spoiler":false,"text":"おとなしく、自分を表に出さない控えめな性格。家事のスキルは平凡だが、料理の盛り付けやケチャップ文字にラテアートはかなり上手。"},{"spoiler":false,"text":"性格は気丈で、こんなどん底の人生になってもへこたれずに、健気に明るく振る舞っている。"},{"spoiler":false,"text":"当然、空元気であり、心を許せる人間には、弱い本音を漏らして泣きじゃくったりもする。"},{"spoiler":false,"text":"これといった性感帯や性的弱点は特になく、全ては主人公の調教次第。"},{"spoiler":false,"text":"一応、キスは愛し合う者が行う行為として、客は勿論、主人公に対しても拒む（愛情や淫乱度で可能になっていく）"},{"spoiler":false,"text":"父の会社が倒産し、莫大な負債を抱えて両親はそれを苦に自殺。"},{"spoiler":false,"text":"借金を肩代わりしてくれた『寅角』には、黒い恩義を感じている。"},{"spoiler":false,"text":"未来は両親の借金を背負い、その身体を使って高級コールガールとして生きていく覚悟を決めている。"}],"source":"egs","sourceCharacterId":"16360","sourceWorkId":"25104","spoiler":false},{"segments":[{"spoiler":false,"text":"「夜蝶の未来～調教ノ果テニ～」"},{"spoiler":false,"text":"趣味：創作料理　 将来の夢：素敵な旦那様と明るく楽しい喫茶店を開く"},{"spoiler":false,"text":"上流家庭で育った元お嬢様。 名門女子校を卒業したばかり。"},{"spoiler":false,"text":"父の会社が倒産して両親は自殺。 借金を肩代わりした寅角に恩義を感じている。"},{"spoiler":false,"text":"そのため自らの身体を使い、高級コールガールとして生きていく覚悟を決めている。"},{"spoiler":false,"text":"処女で性知識も小学生並だが、感度は良好。 恥じらいがあって初々しい。"},{"spoiler":false,"text":"気丈な性格で健気に明るく振舞ってはいるが、やはり空元気で弱い一面を隠している。"},{"spoiler":false,"text":"今後の彼女はすべて、主人公の調教次第で変わっていく。"}],"source":"egs","sourceCharacterId":"16360","sourceWorkId":"29749","spoiler":false},{"segments":[{"spoiler":false,"text":"上流家庭で育った元お嬢様。 名門女子校を卒業したばかり。"},{"spoiler":false,"text":"父の会社が倒産して両親は自殺。 借金を肩代わりした寅角に恩義を感じている。"},{"spoiler":false,"text":"そのため自らの身体を使い、高級コールガールとして生きていく覚悟を決めている。"},{"spoiler":false,"text":"処女で性知識も小学生並だが、感度は良好。 恥じらいがあって初々しい。"},{"spoiler":false,"text":"気丈な性格で健気に明るく振舞ってはいるが、やはり空元気で弱い一面を隠している。"},{"spoiler":false,"text":"今後の彼女はすべて、主人公の調教次第で変わっていく。"}],"source":"bangumi","sourceCharacterId":"54276"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"54276","value":"創作料理"},{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"16360","sourceWorkId":"25104","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"16360","sourceWorkId":"25104","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"16360","sourceWorkId":"25104","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"16360","sourceWorkId":"25104","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"16360","sourceWorkId":"25104","sourceField":null,"scoped":true},{"label":"体重（本版本）","value