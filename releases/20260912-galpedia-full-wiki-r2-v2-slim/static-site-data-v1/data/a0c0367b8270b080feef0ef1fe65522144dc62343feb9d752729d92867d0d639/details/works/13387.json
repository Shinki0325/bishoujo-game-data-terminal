:[{"spoiler":false,"text":"やさぐれた主人公から誰もが離れていった中で、今でも変わらぬ友情を持ってくれているたった一人の親友。"}],"source":"bangumi","sourceCharacterId":"59113"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e26225d3166cb9aecad1420e06edaf7ab90992cd7dcaa55f1c95698b95610b47.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5ad76fbadf183e1d823f068c729c400fe8064afac2e08be347834714909a616c.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c10721","characterName":"ラムダス・ムジャヒルディーン","sourceIds":{"bangumi":[{"characterId":"59114","match":"exact-normalized-name-in-linked-work","subjectId":"229788"}],"egsCharacterIds":["14128"],"vndbCharacterId":"c10721"},"originalCharacterName":"ラムダス・ムジャヒルディーン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a competent and strict butler who was given to him by an Indian maharajah who had been associated with the Turner family."},{"spoiler":false,"text":"Although his son had already succeeded in business in India and was already living a wealthy life, the righteous man himself continued to serve the protagonist until his body was destroyed."},{"spoiler":false,"text":"He has brought in a well-made granddaughter to take his place."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c10721"},{"segments":[{"spoiler":false,"text":"人種：アーリア系"},{"spoiler":false,"text":"ターナー家と付き合いのあったインドのマハラジャから譲り受けた有能で厳格な執事。"},{"spoiler":false,"text":"息子はインドで事業に成功し、すでに裕福な暮らしをしているものの、義理堅い本人は体を壊すまで主人公に仕え続けた。"},{"spoiler":false,"text":"自分の代わりに出来の良い孫娘を呼び寄せている。"}],"source":"egs","sourceCharacterId":"14128","sourceWorkId":"13387","spoiler":false},{"segments":[{"spoiler":false,"text":"ターナー家と付き合いのあった、