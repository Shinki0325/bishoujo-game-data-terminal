gn","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:88299","source":"vndb"},{"creditedName":"齋藤 紀子","creatorId":"vndb:s2345","sourcePersonId":"vndb:s2345","canonicalEntityId":"vndb:s2345","name":"齋藤 紀子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:88301","source":"vndb"}]},"cast":[{"characterId":"char_c41950","characterName":"君島 紀香","sourceIds":{"bangumi":[{"characterId":"100309","match":"exact-normalized-name-in-linked-work","subjectId":"348456"},{"characterId":"100309","match":"exact-normalized-name-in-linked-work","subjectId":"348550"}],"egsCharacterIds":["22774"],"vndbCharacterId":"c41950"},"originalCharacterName":"君島 紀香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『尽くしてあげちゃう2』のヒロインの一人。前作から5ヶ月ほど経っているという設定。"},{"spoiler":false,"text":"大輔（前作の主人公）とはすでに恋人関係で、周囲にも公認されている。"},{"spoiler":false,"text":"長身にメリハリのあるボディラインを持つ美人タイプのキャラクターだが、性格は結構軽く意地っ張り。"},{"spoiler":false,"text":"そのギャップのせいか不思議と異性を感じさせない女の子でもある。"},{"spoiler":false,"text":"モデルクラブにスカウトされていたが、大輔との交際を選び、モデルへの道は断念している。"},{"spoiler":false,"text":"大輔の家の合い鍵を貰い、ほとんど通い妻状態。"},{"spoiler":false,"text":"最近は大輔の愛猫「小雪」とも仲良しさん。小雪相手に不安な胸の内を語ったりしてしまう様だ。"},{"spoiler":false,"text":"好物は大輔の淹れてくれるレモンティー。それを口実に大輔の部屋に行きたがるフシあり。"}],"source":"egs","sourceCharacterId":"22774","sourceWorkId":"1542","spoiler":false},{"segments":[{"spoiler":false,"text":"お馴染み『尽くしてあげちゃう2』『紀香たんといっしょ☆』のヒロインの一人。"},{"spoiler":false,"text":"大輔（『尽くしてあげちゃう2』の主人公）とはすでに恋人関係で、周囲にも公認されている。"},{"spoiler":false,"text":"長身にメリハリのあるボディラインを持つ美人タイプだが、性格は結構軽く意地っ張り。"},{"spoiler":false,"text":"そのギャップのせいか不思議と異性を感じさせない女の子でもある。"},{"spoiler":false,"text":"モデルクラブにスカウトされていたが、大輔との交際を選び、モデルへの道は断念している。"},{"spoiler":false,"text":"大輔とは相変わらず口喧嘩が絶えない毎日だが、大抵は彼が折れてくれるので上手く収まっている様だ。"},{"spoiler":false,"text":"すでに大輔の両親とは「結婚を前提に」とまで話が進み、彼の部屋でのお泊まりも日常茶飯事のほとんど通い妻状態。"},{"spoiler":false,"text":"最近は大輔の愛猫「小雪」とも仲良しさん。"},{"spoiler":false,"text":"孝之とは以前から友人関係だが、最近では大輔と一緒に３人でつるむ事も多い。"},{"spoiler":false,"text":"なんとか撫子とくっつけようと、彼女なりに張り切っているようだ。"}],"source":"egs","sourceCharacterId":"22774","sourceWorkId":"2602","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の親友「君島 翔一」の姉。"},{"spoiler":false,"text":"学生ながらも売れっ子モデルで写真集も発売されている。"},{"spoiler":false,"text":"いわゆるボン・キュッ・ボンなちょっとアダルティーなお姉様。"},{"spoiler":false,"text":"興味本位で見舞いに来たのに、朴念仁の彼をすっかり気に入ってしまったらしく、"},{"spoiler":false,"text":"３年生なのに同じ学校に転校してきてしまう……"}],"source":"egs","sourceCharacterId":"22774","sourceWorkId":"2689","spoiler":false},{"segments":[{"spoiler":false,"text":"「尽くしてあげちゃう」ヒロイン。シリーズ多数に登場。"},{"spoiler":false,"text":"大輔の同級生でむつみの親友。"},{"spoiler":false,"text":"見事大輔と結ばれた紀香は、ラブラブ通い妻の真っ最中。"},{"spoiler":false,"text":"しかしイキナリ大輔の両親に紹介されることになって大慌て！"},{"spoiler":false,"text":"お淑やかな女の子を目指して「身も心もメイドになる」宣言をするが……"}],"source":"egs","sourceCharacterId":"22774","sourceWorkId":"2756","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトでむつみの親友。"},{"spoiler":false,"text":"前作『尽くしてあげちゃう』にも登場。そのときの1年前という設定。"},{"spoiler":false,"text":"「尽くして」シリーズ中、最も人気の高いヒロイン。"},{"spoiler":false,"text":"メリハリのあるボディラインで、モデルクラブのスカウトに声をかけられている。"},{"spoiler":false,"text":"主人公とは口喧嘩の絶えない仲だが、心の内では憎からず思っている。"}],"source":"egs","sourceCharacterId":"22774","sourceWorkId":"3684","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の親友「君島 翔一」の姉で、学生ながらも売れっ子モデルで写真集も発売されているというちょっとアダルティーなお姉様。見た目は知的な印象を与えるが、実際のところその性格はたいへん軽い。胸は結構ある。主人公の事は興味本位で見舞いに来たのだが、朴念仁の彼をすっかり気に入ってしまったらしく、最終学年であるにもかかわらず同じ学校に転校してきてしまう。"}],"source":"bangumi","sourceCharacterId":"100309"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/302c7bb09095e40944e22d2086b2bbb5db63d