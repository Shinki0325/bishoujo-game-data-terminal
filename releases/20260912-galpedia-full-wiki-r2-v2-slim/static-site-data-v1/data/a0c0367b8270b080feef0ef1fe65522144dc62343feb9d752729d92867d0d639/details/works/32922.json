"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"},"weight":{"reviewState":"source-only","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Serizawa Ema transferred to the school as a second-year student. She is quick-witted, nimble, and is an outstanding student. She doesn’t like exercise very much but is very athletic."},{"spoiler":false,"text":"She doesn’t usually show her emotions and isn’t good at expressing herself. It’s not that she thinks she doesn’t need friends, but she is often alone."},{"spoiler":false,"text":"She is an only child, so she feels she has missed out on being close with others, That’s why she likes being mischievous and making physical contact."},{"spoiler":false,"text":"She’s actually a popular illustrator and is famous online. She keeps that a secret to those around her, though. Also, she hasn’t released a new illustration recently."},{"spoiler":false,"text":"In her private life, she isn’t careful about what she eats. On the contrary, she is always neat and cleans her room properly. She also prefers wearing sexy underwear."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c104035"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b2a2d918296214f59fb4e3795c45298f64f8defa507b147c8ccb975dadc54f8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/7019c3693bd7a79c544f60f9d5d56653994f29e7e4cb82421e432e823387d906.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c112712","characterName":"桐咲 あさひ","sourceIds":{"vndbCharacterId":"c112712"},"originalCharacterName":"桐咲 あさひ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He has been assigned to help run a public bathhouse while his grandmother is away."},{"spoiler":false,"text":"Although he is dressed as a woman, he is a boy."},{"spoiler":false,"text":"He is serious and caring, and cannot leave anyone in trouble. On the other hand, he is a little sensitive."},{"spoiler":false,"text":"His parents are overseas and he lives with his older sister. He takes care of the household chores in place of his older sister."},{"spoiler":false,"text":"When he hears that his grandmother's bathhouse is no longer able to continue running, he takes it upon herself to do something about it."},{"spoiler":false,"text":"He has a crush on Chika, a part-time worker he meets at the bathhouse."},{"spoiler":false,"text":"However, he feels he cannot express his feelings to her because he is dressed as a woman."}],"source":"vndb","sourceCharacterId":"c112712"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b31e643e2baf20a88a9daeeff0505e11404116b173243a493b4af161d3791d5f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4ab52e3edfb41144ee490c1451ed7b01a70902a7e7ed6f7ed1f2017ab2e0d3ea.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"秋野 花","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91988","source":"vndb"}]},{"characterId":"char_vndb_c112714","characterName":"桐江 千佳","sourceIds":{"vndbCharacterId":"c112714"},"originalCharacterName":"桐江 千佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"},"weight":{"reviewState":"source-only","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has been working part-time at a public bathhouse since before Asahi arrived."},{"spoiler":false,"text":"She is honest, quiet, and reserved. She does not get angry very often, but her emotions are clear."},{"spoiler":false,"text":"Her bath at home is broken, so she rents a bath at Hime-no-yu after work."},{"spoiler":false,"text":"She has a close relationship with Asahi's grandmother, who is like family."},{"spoiler":false,"text":"She has a strong emotional attachment to the bathhouse and wants to continue to operate it."},{"spoiler":false,"text":"She does not know that Asahi is a man, and since they are the same age, she is happy to have a good friend to talk with. She is happy to have made a good friend."},{"spoiler":false,"text":"\"Why don't we take a bath together? It feels really good.\""}],"source":"vndb","sourceCharacterId":"c112714"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb0fbf807787e6a78670914e5499e31fb2d0415d18548cc16116141912201ad5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16348545fff8a1134c385974ba49c1bde570b7e745abcab4b8cd1a181b2f577c.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"cr