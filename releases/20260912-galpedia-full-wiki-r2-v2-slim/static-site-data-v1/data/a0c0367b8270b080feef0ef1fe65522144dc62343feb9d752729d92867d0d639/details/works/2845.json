-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"時折、主人公の前に現れる謎の美女。"},{"spoiler":false,"text":"古風な衣装と、落ち着いた物腰、達観した喋り方から、何処か浮世離れした存在。"},{"spoiler":false,"text":"彼女が主人公にもたらすものとは……？"}],"source":"egs","sourceCharacterId":"27363","sourceWorkId":"2845","spoiler":false},{"segments":[{"spoiler":false,"text":"濡れたような長い黒髪が映える、絶世の美女。"},{"spoiler":false,"text":"達観したかのような、見た目に違わない古風な喋り方をする。"},{"spoiler":false,"text":"物腰、立振舞いに、全てを超越した何かを感じずにはいられない。"},{"spoiler":false,"text":"付かず離れずの距離で、いつも東児の周囲に現れる。"},{"spoiler":false,"text":"果たして、それは目的があってか否か。"},{"spoiler":false,"text":"それは彼女自身でさえ、まだ・・・・・・。"}],"source":"bangumi","sourceCharacterId":"141822"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b862300548ea578ef1c3822f2bf63daf8da6b656c0c88c2af1dee6296d87d5fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/828b09bf335f0d37010521de69d3f1159053d83bff5cae859747d1d9d08f700b.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幡宮かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230197:141822:5940:1","source":"bangumi"}]},{"characterId":"char_c21487","characterName":"貴船 桜花","sourceIds":{"bangumi":[{"characterId":"141823","match":"exact-normalized-name-in-linked-work","subjectId":"230197"}],"egsCharacterIds":["27364"],"vndbCharacterId":"c21487"},"originalCharacterName":"貴船 桜花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"春の陽気を感じさせるような、明るさと温もりを持った少女。"},{"spoiler":false,"text":"主人公は、彼女と春の季節に出会い、そして喜びを得る代わりに、別離の悲しみも味わうことに……。"}],"source":"egs","sourceCharacterId":"27364","sourceWorkId":"2845","spoiler":false},{"segments":[{"spoiler":false,"text":"小さく整った顔立ちに栗色の髪、それを覆うかのような大きな髪飾り。"},{"spoiler":false,"text":"若草色の着物と季節の花々が描かれた帯で、春の息吹、そして儚さが滲み出る。"},{"spoiler":false,"text":"人となどもう会うこともないと思っていた東児は彼女と出会い、そして生活を共にすることになる。"},{"spoiler":false,"text":"そこで喜びを得る代わり、味わわなくても良かったかもしれない、別離の悲しみも味わうことになる。"},{"spoiler":false,"text":"一青年の（短い間の）成長の為のスケープゴートというには、とても悲しい存在。"},{"spoiler":false,"text":"それ故に、彼女を穏やかに送り出してやらなくてはいけない。"}],"source":"bangumi","sourceCharacterId":"141823"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9fade2f6ebc4a1327bc5491972bd215538df8a48a2026deae8d731d812e085a2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea3129d6c6f3896c931560407b74e4fb7df299bb0f63ba91bc058b99ed957fdc.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"カンザキカナリ","creatorId":"vndb:s1000","sourcePersonId":"vndb:s1000","canonicalEntityId":"vndb:s1000","name":"カンザキ カナリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230197:141823:24747:1","source":"bangumi"}]},{"characterId":"char_c21490","characterName":"酒田 美潮","sourceIds":{"bangumi":[{"characterId":"141824","match":"exact-normalized-name-in-linked-work","subjectId":"230197"}],"egsCharacterIds":["27365"],"vndbCharacterId":"c21490"},"originalCharacterName":"酒田 美潮","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人類に起きた理不尽を呪う少女。"},{"spoiler":false,"text":"小柄で愛らしい容姿の彼女だが、そのドレスには血痕が……。"},{"spoiler":false,"text":"不釣合いな鉈を軽々と携え、夜毎、狩りを続けているようだが、その目的は……？"},{"spoiler":false,"text":"主人公が彼女と出会ったのは夏。"},{"spoiler":false,"text":"これまでの抱いてきた価値観を、彼女に「偽善」である、と無慈悲に斬り捨てられ……。"}],"source":"egs","sourceCharacterId":"27365","sourceWorkId":"2845","spoiler":false},{"segments":[{"spoiler":false,"text":"プラチナブロンドのソバージュがかった美しい髪に、ドレス。"},{"spoiler":false,"text":"フランス人形のような愛らしい容姿。"},{"spoiler":false,"text":"しかし、そのドレスにはおびただしい量の、血痕。"},{"spoiler":false,"text":"彼女は毎夜、狩りを続ける。"},{"spoiler":false,"text":"華奢な手に、普通ではない巨大な鉈を軽々と携えて。"},{"spoiler":false,"text":"この世の（人にだけおきた）理不尽を呪いながら。"},{"spoiler":false,"text":"これまでに構築してきた価値観は、彼女の前で『偽善』として斬り捨てられる。"},{"spoiler":false,"text":"それは無慈悲に。"}],"source":"bangumi","sourceCharacterId":"141824"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e888f8ab926966cc16f296e5fa2b2ed05735862d19515e19e848d4fd928ab08.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b143bbaac5125b83915af15288e91f0bf5566b01e3ab07952b6b1720dacc7d0.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さくらなつみ","creatorId":"vndb:s666","sourcePersonId":"vndb:s666","canonicalEntityId":"vndb:s666","name":"岩泉まい(樋口まゆら、樋口まゆ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230197:141824:6279:1","source":"bangumi"}]},{"characterId":"char_c21491","characterName":"永野 呉葉","sourceIds":{"bangumi":[],"egsCharacterIds":["27366"],"vndbCharacterId":"c21491"},"originalCharacterName":"永野 呉葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"双子の姉妹。"},{"spoiler":false,"text":"髪型が若干違う以外は、鏡写しのように紅葉とそっくりだが、性格は正反対。"},{"spoiler":false,"text":"臆病な紅葉と違い、気丈で明朗快活。"},{"spoiler":false,"text":"主人公は彼女ら姉妹と秋に出会い、愉快な日々を過ごしていくが……。"}],"source":"egs","sourceCha