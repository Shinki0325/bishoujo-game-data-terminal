rId":"char_c21493","characterName":"浦辺 小春","sourceIds":{"bangumi":[{"characterId":"141826","match":"exact-normalized-name-in-linked-work","subjectId":"230197"}],"egsCharacterIds":["27368"],"vndbCharacterId":"c21493"},"originalCharacterName":"浦辺 小春","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"名前の通り、深まる秋の最中に暖かい日差しを思わせる女性。"},{"spoiler":false,"text":"少しずつ迫る絶望の時を前にして、東児に一時の平和を味わわせてくれる存在。"},{"spoiler":false,"text":"しかしそれは飽くまでも小春から東児にとってである。"},{"spoiler":false,"text":"刻一刻と迫る最後の時は、確実に彼女に先に訪れる。"},{"spoiler":false,"text":"そこで改めて、東児は現実というものを目の当たりにすることになる。"},{"spoiler":false,"text":"しかし、彼女は最後に穏やかな表情で旅立たせるべきだ。東児にはその責任がある。"},{"spoiler":false,"text":"そこに、もう彼女の自我が無いとしても。"}],"source":"egs","sourceCharacterId":"27368","sourceWorkId":"2845","spoiler":false},{"segments":[{"spoiler":false,"text":"名前の通り、深まる秋の最中に暖かい日差しを思わせる女性。"},{"spoiler":false,"text":"少しずつ迫る絶望の時を前にして、東児に一時の平和を味わわせてくれる存在。"},{"spoiler":false,"text":"しかしそれは飽くまでも小春から東児にとってである。"},{"spoiler":false,"text":"刻一刻と迫る最後の時は、確実に彼女に先に訪れる。"},{"spoiler":false,"text":"そこで改めて、東児は現実というものを目の当たりにすることになる。"},{"spoiler":false,"text":"しかし、彼女は最後に穏やかな表情で旅立たせるべきだ。東児にはその責任がある。"},{"spoiler":false,"text":"そこに、もう彼女の自我が無いとしても。"}],"source":"bangumi","sourceCharacterId":"141826"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9ad55ccc424cf1e60f095773b0e7afef633a7ad5329d9eb2e2be51fb6b98f820.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/118083fcf92e28f42cc09703a08d7433114decb0c00302d8358e2d0c8c304cb6.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大野まりな","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230197:141826:4434:1","source":"bangumi"}]},{"characterId":"char_c21494","characterName":"御門 ふゆ","sourceIds":{"bangumi":[{"characterId":"141827","match":"exact-normalized-name-in-linked-work","subjectId":"230197"}],"egsCharacterIds":["27369"],"vndbCharacterId":"c21494"},"originalCharacterName":"御門 ふゆ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"19"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"冬の季節に出会う無邪気で天真爛漫な天然少女。"},{"spoiler":false,"text":"一見、10代前半の子供のような容姿をしているが、間違いなく19歳。"},{"spoiler":false,"text":"その天然ボケぶりで、主人公を時に戸惑わせ、時に心和ませてくれるが、彼女には隠された秘密が……。"}],"source":"egs","sourceCharacterId":"27369","sourceWorkId":"2845","spoiler":false},{"segments":[{"spoiler":false,"text":"屈託無く、天真爛漫。良く言えば無邪気。悪くいえば天然。"},{"spoiler":false,"text":"ただ断言できるのは、何ら憎むべきところはないこと。"},{"spoiler":false,"text":"一見するとまだ10代前半に見えないこともないが、れっきとした19歳。"},{"spoiler":false,"text":"常にボケっぷりを発揮するが、時折見せる、驚くほど計算されつくした仕草や言動が不可思議である。"},{"spoiler":false,"text":"その真の姿を見た時。"},{"spoiler":false,"text":"東児は彼女の理解者として、側にいてやることはできるだろうか。"},{"spoiler":false,"text":"それは一緒に笑っていられる選択だろうか。"},{"spoiler":false,"text":"『大過』でさえも、その結末知るところではない。"}],"source":"bangumi","sourceCharacterId":"141827"}],"profileFacts":[{"label":"年龄（本版本）","value":"19 岁","valueContext":null,"source":"egs","sourceCharacterId":"27369","sourceWorkId":"2845","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/9361d58406999d7e8747ab54d23ee5ed0bac7b804116b80009025bcd27d5f8e8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da1d9190ec79796edd8618c41abeb3a11a2b1afa1ad16a44694d7a616a65a15e.webp","width":183,"height":256,"sou