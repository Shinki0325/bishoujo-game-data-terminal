56f0898a87ea7fc8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5fa90358c0f6d7097b2fd273954d072e67f4b388f1153c90ebbe7e3e398ca92.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ゆづき ひな。","creatorId":"vndb:s8928","sourcePersonId":"vndb:s8928","canonicalEntityId":"vndb:s8928","name":"ゆづき ひな。","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45204","source":"vndb"}]},{"characterId":"char_c46504","characterName":"村瀬 渚","sourceIds":{"bangumi":[{"characterId":"103740","match":"exact-normalized-name-in-linked-work","subjectId":"223726"}],"egsCharacterIds":["14493"],"vndbCharacterId":"c46504"},"originalCharacterName":"村瀬 渚","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"近代未来工科学園の入学した新一年生で、野球部マネージャー。"},{"spoiler":false,"text":"軽そうな外見とは裏腹に、意外にシッカリ者。"},{"spoiler":false,"text":"気は強いが、押しが弱く、調子に乗りやすいところが玉に瑕。"},{"spoiler":false,"text":"エッチに興味津々なお年頃で、それが“エッチなご褒美”という前代未聞の発想へと繋がった（？）。"},{"spoiler":false,"text":"生来の淫乱な性癖もあって、そのエッチは徐々にエスカレートしていく。"}],"source":"egs","sourceCharacterId":"14493","sourceWorkId":"10890","spoiler":false},{"segments":[{"spoiler":false,"text":"元近代未来工科学園野球部マネージャーで、現在、教育実習生として同校に赴任中。"},{"spoiler":false,"text":"弱小野球部を短期間で立て直し、強豪校に伸し上げた伝説を持つ。"},{"spoiler":false,"text":"その方法を七海に伝授し、自らも加わって、野球部復活を目指す。"},{"spoiler":false,"text":"学生時代に単純だった性格はさらに磨きがかかって、豪快の域に達している。"},{"spoiler":false,"text":"体つきも豊満になって大人の魅力ムンムン。"},{"spoiler":false,"text":"野球部内ではナイスバディーの渚派と、初々しくも引き締まった身体つきの七海派にわかれているともわかれていないとも……。"}],"source":"egs","sourceCharacterId":"14493","sourceWorkId":"13004","spoiler":false},{"segments":[{"spoiler":false,"text":"近代未来工科学園野球部伝説のマネージャー。"},{"spoiler":false,"text":"現在は新任教師として近未来に赴任中。"},{"spoiler":false,"text":"学生時代に単純だった性格にはさらに磨きがかかって、"},{"spoiler":false,"text":"半ば豪快の域にまで達している。"}],"source":"egs","sourceCharacterId":"14493","sourceWorkId":"16344","spoiler":false},{"segments":[{"spoiler":false,"text":"近代未来工科学園新入生。惚れっぽい性格に流されるまま、弱小野球部のマネージャーになってしまったいわゆるフツーの女の子。"},{"spoiler":false,"text":"軽そうな外見とは裏腹に意外としっかりモノで、男所帯の野球部を1人で切り盛りしています。"},{"spoiler":false,"text":"年相応にエッチなことには興味津々。"},{"spoiler":false,"text":"そんな性格が相まって、“エッチなご褒美”はどんどんエスカレートしていくことに……"}],"source":"bangumi","sourceCharacterId":"103740"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df075efe40d23e0444a06263d7eb775eaea83e983eb619fb96b4df9ce1a7c96c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d682cec11dd7e288cc0acf9639bf3b5e62c515571839e39dac0ff513b95d005.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ヒマリ","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45200","source":"vndb"}]},{"characterId":"char_c57532","characterName":"大島 七海","sourceIds":{"bangumi":[{"characterId":"204603","match":"exact-normalized-name-in-linked-work","subjectId":"50353"}],"egsCharacterIds":["14492"],"vndbCharacterId":"c57532"},"originalCharacterName":"大島 七海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公兼ヒロイン。"},{"spoiler":false,"text":"舞台となる近代未来工科学園に入学したばかりの一年生。"},{"spoiler":false,"text":"同校に進学する前までは、野球のボーイズリーグに所属し、選手として活躍していた。"},{"spoiler":false,"text":"ショートストップを任されるほど、優秀な選手だったが、進学後は選手を止めてマネージャーに転身。"},{"spoiler":false,"text":"性格は気が強く、ボーイズ時代は鬼軍曹と呼ばれ、チームメイトたちに恐れられた（？）。"},{"spoiler":false,"text":"今回、伝説のマネージャーとして勇名を馳せる村瀬渚のアドバイスの下で、弱小野球部の立て直しに孤軍奮闘するが……。"}],"source":"egs","sourceCharacterId":"14492","sourceWorkId":"13004","spoiler":false},{"segments":[{"spoiler":false,"text":"近代未来工科学園所属のマネージャー。"},{"spoiler":false,"text":"本作では進級して3年生に。"},{"spoiler":false,"text":"気の強い性格で、ボーイズ時代についた渾名は鬼軍曹。"},{"spoiler":false,"text":"ボーイズリーグではショートを守っていたが、"},{"spoiler":false,"text":"進学を機にマネージャーに転身した。"}],"source":"egs","sourceCharacterId":"14492","sourceWorkId":"16344","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公兼ヒロイン。近代未来工科学園に入学したばかりの1年生。"},{"spoiler":false,"text":"気の強いい性格で、ボーイズ時代についた渾名は鬼軍曹。"},{"spoiler":false,"text":"伸ばし始めた髪が、ようやくポニーテールを作れるぐらいに伸びたことが少し嬉しい。"},{"spoiler":false,"text":"日焼けしやすい体質で、最近始まったプール授業のせいで、早速身体が水着型に焼けてしまっているのを気にしている。"},{"spoiler":false,"text":"ボーイズリーグではショートを守っていたが、進学を機にマネージャーに転身。"},{"spoiler":false,"text":"弱小と化した近未来野球部を復活させるため、伝説のマネージャー・村瀬渚のアドバイスのもと孤軍奮闘することになる。"}],"source":"bangumi","sourceCharacterId":"204603"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa5278d76ac762757298c07f2f0aed902aab9eb1c2ef3fd9ad97dee5c4b52a5a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d8b06fdca4195f53d06e60409fe8d039972964fd9e61dff7f17f7c62e897706.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"逢川 奈々","creatorId":"vndb:s530","sourcePersonId":"vndb:s530","canonicalEntityId":"vndb:s530","name":"逢川奈々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45202","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p908","sourceCompanyId":"egs:brand:1923","canonicalEntityId":"vndb:p908","name":"劇團近未来","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:16344:1923","source":"egs"},{"companyId":"vndb:p908","sourceCompanyId":"vndb:p908","canonicalEntityId":"vndb:p908","name":"劇團近未来","roleCodes":["developer","publisher"],"identityStatus":"source-n