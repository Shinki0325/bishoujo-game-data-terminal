":"vndb"},{"creditedName":"浮世 かいか","creatorId":"vndb:s38018","sourcePersonId":"vndb:s38018","canonicalEntityId":"vndb:s38018","name":"浮世 かいか","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:200587","source":"vndb"}]},"cast":[{"characterId":"char_c131382","characterName":"ヘルミリア＝ヴァン＝ノクスローゼ","sourceIds":{"bangumi":[],"egsCharacterIds":["24990"],"vndbCharacterId":"c131382"},"originalCharacterName":"ヘルミリア＝ヴァン＝ノクスローゼ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Having once ruled the Magical Kingdom of Ragnarök for a thousand years, she is the Demon King among Demon Kings (self-proclaimed). Feared throughout the ages under titles like \"The Millennium King\" and \"The Immortal Rose\" (self-proclaimed)."},{"spoiler":false,"text":"Currently a second-year student at Kamui Academy. She skips classes and can’t even be bothered to properly participate in world-saving hero duties, spending most of her time lazing around playing games in her room. A problem child, a shut-in, and a slacker of a Demon King. She frequently clashes with Hinagiku, a living manifestation of justice."},{"spoiler":false,"text":"Ability: \"Resplendent Twelve Apostles\""},{"spoiler":false,"text":"The power to summon and command across worlds twelve Demon Kings who once served her. Essentially a summoning spell. Her favorite is the Dragon King Exus—she finds his black-and-white pattern adorable."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c131382"},{"segments":[{"spoiler":false,"text":"かつて魔法王国ラグナレカに千年の覇を唱えた、魔王の中の魔王。（自称)"},{"spoiler":false,"text":"千年王、不滅の薔薇など、畏怖と共にその名は語られていたという。（自称)"},{"spoiler":false,"text":"今は神居学園に通うニ年生。"},{"spoiler":false,"text":"授業はおろか、世界を守る勇者活動にもロクに参加せず、基本は部屋でごろごろとゲームをしている。"},{"spoiler":false,"text":"問題児にして、引きこもりのぐーたら魔王。"},{"spoiler":false,"text":"特に正義の具現化のようなヒナギクとは、頻繁にやりあっている。"}],"source":"egs","sourceCharacterId":"24990","sourceWorkId":"35267","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"24990","sourceWorkId":"35267","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"24990","sourceWorkId":"35267","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"153 cm","valueContext":null,"source":"egs","sourceCharacterId":"24990","sourceWorkId":"35267","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"24990","sourceWorkId":"35267","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"24990","sourceWorkId":"35267","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52bf99eb56d15fb2e042a0b6eb98bd0c42d5f9bf8dfc39c80958f2515096755d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36e32d2b31ab4fcf6a4b825e67a5f0b0367bfc15ca2e34e4e154a20637cbff7b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"月野 きいろ","creatorId":"vndb:s1545","sourcePersonId":"vndb:s1545","canonicalEntityId":"vndb:s1545","name":"さいとう よしえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:96226","source":"vndb"}]},{"characterId":"char_c131383","characterName":"最上 ヒナギク","sourceIds":{"bangumi":[{"characterId":"139944","match":"exact-normalized-name-in-linked-work","subjectId":"459368"}],"egsCharacterIds":["24991"],"vndbCharacterId":"c131383"},"originalCharacterName":"最上 ヒナギク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The warrior of the \"Salvation Committee\". Among the members, she's the newest arrival to this world—a first-year student."},{"spoiler":false,"text":"Apparently summoned from a Japanese-styled (?) world, she gives an impression close to a feudal-era samurai as the protagonist knows it. A righteous person who declares without hesitation: \"I fight to protect the weak and save the world!\" Bright, bold, and loves the spotlight. Oh, and she's kind of dumb. Charges ahead shouting \"Leave it to me!\" and never dwells on failures... and so on."},{"spoiler":false,"text":"Ability: \"Demon-Wail Crimson Lotus\""},{"spoiler":false,"text":"A talking sword. While devastating as a blade, it's also a reliable partner offering tactical support. ...Though its nagging mother-hen personality gets annoying sometimes (according to her)."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c131383"},{"segments":[{"spoiler":false,"text":"主人公たちが属する『救世委員会』の戦士枠。"},{"spoiler":false,"text":"メンバーでは一番この世界に来てからの日が浅い、一年生。"},{"spoiler":false,"text":"和風（？）の世界から召喚されてきたらしく、主人公が知る戦国時代の侍に近い印象。"},{"spoiler":false,"text":"「弱い者を守り、世界を救うために戦う」ときっぱり言い切れる正義の人。"},{"spoiler":false,"text":"明るくて、豪快で、目立ちたがり。ついでに言うとおバカ。"},{"spoiler":false,"text":"「私に任せろ」と突っ込んでいくし、失敗してもくよくよしない……等々。"}],"source":"egs","sourceCharacterId":"24991","sourceWorkId":"35267","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公たちが属する『救世委員会』の戦士枠。"},{"spoiler":false,"text":"メンバーでは一番この世界に来てからの日が浅い、一年生。"},{"spoiler":false,"text":"和風（？）の世界から召喚されてきたらしく、主人公が知る戦国時代の侍に近い印象。"},{"spoiler":false,"text":"「弱い者を守り、世界を救うために戦う」ときっぱり言い切れる正義の人。"},{"spoiler":false,"text":"明るくて、豪快で、目立ちたがり。ついでに言うとおバカ。"},{"spoiler":false,"text":"「私に任せろ」と突っ込んでいくし、失敗してもくよくよしない……等々。"},{"spoiler":false,"text":"能力：「鬼哭紅蓮（おになきぐれん）」"},{"spoiler":false,"text":"喋る刀。刀としての破壊力もさることながら、サポート役としても有用な頼れる相棒。"},{"spoiler":false,"text":"…なのだが口うるさいオカン気質なので、時々鬱陶しい（本人談）。"}],"source":"bangumi","sourceCharacterId":"139944"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"24991","sourceWorkId":"35267","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"24991","sourceWorkId":"35267","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"24991","sourceWorkId":"35267","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"24991","sourceWorkId":"35267","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"24991","sourceWorkId":"35267","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9aba6838057663284f85a728092f1720fadce6f8fb8edb6edd98898692ad16f9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3f8a7481d0ede543a02a8c468a3ec3e245577a198ea8a50f139b95b81e80b49.webp","width":143,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川育美","creatorId":"vndb:s14378","sourcePersonId":"vndb:s14378","canonicalEntityId":"vndb:s14378","name":"長谷川 育美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:459368:139944:30858:1","source":"bangumi"}]},{"characterId":"char_c131384","characterName":"綾月 ハルカ","sourceIds":{"bangumi":[{"characterId":"139945","match":"exact-normalized-name-in-linked-work","subjectId":"459368"}],"egsCharacterIds":["24992"],"vndbCharacterId":"c131384"},"originalCharacterName":"綾月 ハルカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl summoned from a highly advanced civilization. Third-year student."},{"spoiler":false,"text":"Lacking in emotional expression and rarely engaging proactively with others, she fades into the background. Usually found reading in the library—always with a book in hand. She squanders her rare ability on \"verifying wonderful things\" and \"realizing storybook worlds\". Overall, she’s hard to read."},{"spoiler":false,"text":"Ability: \"My Dear Phantasm\""},{"spoiler":false,"text":"A magic book that manifests anything she writes into reality. Effects last 30 minutes within \"roughly her perceptual range (vision)\", though this depends on how she phrases each entry. A super cheat skill capable of warping the very nature of the world."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c131384"},{"segments":[{"spoiler":false,"text":"文明が高度に発展した世界から召喚されてきた少女。"},{"spoiler":false,"text":"学年は三年生。"},{"spoiler":false,"text":"感情が乏しい上にあまり物事に積極的に関わろうとしないので、存在感は薄め。"},{"spoiler":false,"text":"基本的にはいつも図書館にいて、本ばかり読んでいる。"},{"spoiler":false,"text":"「素敵なことの検証」「物語の世界の実現」と言っては、稀有な能力を無駄使いしている。"},{"spoiler":false,"text":"総じて何を考えているのかよくわからない人。"}],"source":"egs","sourceCharacterId":"24992","sourceWorkId":"35267","spoiler":false},{"segments":[{"spoiler":false,"text":"文明が高度に発展した世界から召喚されてきた少女。"},{"spoiler":false,"text":"学年は三年生。"},{"spoiler":false,"text":"感情が乏しい上にあまり物事に積極的に関わろうとしないので、存在感は薄め。"},{"spoiler":false,"text":"基本的にはいつも図書館にいて、本ばかり読んでいる。"},{"spoiler":false,"text":"「素敵なことの検証」「物語の世界の実現」と言っては、稀有な能力を無駄使いしている。"},{"spoiler":false,"text":"総じて何を考えているのかよくわからない人。"},{"spoiler":false,"text":"能力：「私のための物語（マイ・ディアー・ファンタズマ）」"},{"spoiler":false,"text":"彼女が記した内容がなんでも現実になる魔法の本。"},{"spoiler":false,"text":"効果の持続時間は30分、効果範囲は「だいたい彼女の認識（視界）の内」だが、"},{"spoiler":false,"text":"それも記入の仕方次第。"},{"spoiler":false,"text":"世界のあり方すら歪めかねないスーパーチート。"}],"source":"bangumi","sourceCharacterId":"139945"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"24992","sourceWorkId":"35267","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"24992","sourceWorkId":"35267","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"24992","sourceWorkId":"35267","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"24992","sourceWorkId":"35267","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"24992","sourceWorkId":"35267","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc4b5fec32d7294e1088c583d4515459c