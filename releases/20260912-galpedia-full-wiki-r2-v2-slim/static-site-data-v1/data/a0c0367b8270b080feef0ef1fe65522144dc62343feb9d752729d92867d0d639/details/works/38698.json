"fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b3b4258717c536a88530f1a379a41fbfaeb4e5ec88d34567bce1e8facd25bff.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小鹿 なお","creatorId":"vndb:s51316","sourcePersonId":"vndb:s51316","canonicalEntityId":"vndb:s51316","name":"小鹿 なお","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:100463","source":"vndb"}]},{"characterId":"char_vndb_c163597","characterName":"ギャル子さん","sourceIds":{"vndbCharacterId":"c163597"},"originalCharacterName":"ギャル子さん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A ghost girl (presumably a high schooler)."},{"spoiler":false,"text":"A natural at conversation, she has unusually wide circle of ghostly acquaintances."},{"spoiler":false,"text":"Unlike Shiori, she doesn't seem too concerned about the past-or passing on."},{"spoiler":false,"text":"Instead, she spends her afterlife roaming around town and chatting with fellow ghosts, enjoying her days in carefree leisure."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c163597"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95153caa97e9ae2296fd0107462f076fa66dd328b04b34d43086f9b6b2d62e9e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bd0929db057b029abd19adcd36255566c4e97ac81a07242467b60464e455239.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風間 万裕子","creatorId":"vndb:s22444","sourcePersonId":"vndb:s22444","canonicalEntityId":"vndb:s22444","name":"風間 万裕子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:100461","source":"vndb"}]},{"characterId":"char_vndb_c163598","characterName":"司書さん","sourceIds":{"vndbCharacterId":"c163598"},"originalCharacterName":"司書さん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female ghost who's always in the library."},{"spoiler":false,"text":"She's lingered in this world for quite some time, which has made her very knowledgeable about the dead."},{"spoiler":false,"text":"Her expertise often helps Shiori and the protagonist."},{"spoiler":false,"text":"Unlike Shiori and the other ghosts, she still has memories from when she was alive."},{"spoiler":false,"text":"She seems to have some major regret binding her in the library, but she rarely talks about herself"},{"spoiler":false,"text":"Edited from Steam"}],"source":"vndb","sourceCharacterId":"c163598"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cd482bb778c8f3474277481ebdd0f450c6b967a1dbe808f35aa819078514c9f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83edf1103e21b219b1eb30620f6044f7fcbb6c6f638a1da1a198566075769494.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"寺崎 裕香","creatorId":"vndb:s5179","sourcePersonId":"vndb:s5179","canonicalEntityId":"vndb:s5179","name":"寺崎 裕香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:100459","source":"vndb"}]},{"characterId":"char_vndb_c168400","characterName":"主人公","sourceIds":{"vndbCharacterId":"c168400"},"originalCharacterName":"主人公","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[],"profileF