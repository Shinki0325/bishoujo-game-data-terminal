"vndb"}]},{"characterId":"char_vndb_c20563","characterName":"織田 三郎 久遠 信長","sourceIds":{"vndbCharacterId":"c20563"},"originalCharacterName":"織田 三郎 久遠 信長","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kuon is the head of the Oda Clan and the main heroine of the Sengoku † Koihime series."},{"spoiler":false,"text":"She is a visionary leader with a strong vision for the future that she can adapt at need to the situation. Despite her often cool manner toward outsiders, she agonizes over the sacrifices she needs to make as a leader as much as or more than Kensuke. Seen as an oddball by many, she just happens to think in a manner that differs from most."},{"spoiler":false,"text":"She frequently agonizes over 'using' Kensuke, but this doesn't stop her from doing so as needed for the good of all. She is very much a believer in the big picture, even when it hurts."}],"source":"vndb","sourceCharacterId":"c20563"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/230cfdb1b5e0f9d4520b791e41aaee87b8c749a2f72e262d5787bfd1ed621cdf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fa01e86e6021ee3c39f2127e1cb839affb7e2f5d28e19972bc80d537e5155e2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森永 有栖","creatorId":"vndb:s1648","sourcePersonId":"vndb:s1648","canonicalEntityId":"vndb:s1648","name":"中村 繪里子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97856","source":"vndb"}]},{"characterId":"char_vndb_c20564","characterName":"斎藤 帰蝶 結菜","sourceIds":{"vndbCharacterId":"c20564"},"originalCharacterName":"斎藤 帰蝶 結菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuina is a strategist of the Oda Clan, and Kuon's wife."}],"source":"vndb","sourceCharacterId":"c20564"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50edf7f3e2e61a3ffb83e721404739ffcf88127d58965ee961857b34bdc3dcea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa197dba029e80541d79a1d7c791b6bd6c4b4046f2330a92cd54e62c5c1796b8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青山 ゆかり","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97846","source":"vndb"}]},{"characterId":"char_vndb_c20566","characterName":"新田 剣丞","sourceIds":{"vndbCharacterId":"c20566"},"originalCharacterName":"新田 剣丞","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main protagonist of the Sengoku†Koihime series, a student at Franchesca Academy and Kazuto's nephew. He serves the Oda Clan as a retainer and general and is assigned the leader of the Kensuke Squad."},{"spoiler":true,"text":"He was trained extensively and harshly by Hongou Kazuto's many wives (all the girls from Shin Koihime Musou), and while he isn't a match for them, he is more than skilled enough to make him an above-average warrior in the Sengoku era."},{"spoiler":false,"text":"Kensuke possesses a varied lineup of skills ranging from weaponscraft and tactics to cooking and the making of simple devices like smoke bombs and signal flares. He is also brave and level-headed, tending to take circumstances as they come without letting them get him down. He has inherited his uncle's natural philandering ways (though he protests this frequently when others point it out to him), and he gathers women without even realizing he is doing it."}],"source":"vndb","sourceCharacterId":"c20566"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89934f888f7873c3b4a190174f0290d5f2dafce47c4ce8aabc2297e579fab2bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8ce40af7b416e7f3e52f4c02139930326084d5e031d70cd04552e55c04ec6a49.webp","width":256,"height":241,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c20567","characterName":"丹羽 五郎左衛門尉 麦穂 長秀","sourceIds":{"vndbCharacterId":"c20567"},"originalCharacterName":"丹羽 五郎左衛門尉 麦穂 長秀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mugiho is a retainer and general in the Oda Clan."}],"source":"vndb","sourceCharacterId":"c20567"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0bdf733518534cec61813f6ebf9f5bf01d15f50175f333dbafeda49245e4f89a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/866d5447284996ae2ff030abcfc36c4d7637209c4aa97bb2a4c91d654d6f7245.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"波奈束 風景","creatorId":"vndb:s44","sourcePersonId":"vndb:s44","canonicalEntityId":"vndb:s44","name":"中島 沙樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97843","source":"vndb"}]},{"characterId":"char_v