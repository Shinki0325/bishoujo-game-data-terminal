th":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62666","characterName":"美衣芽","sourceIds":{"vndbCharacterId":"c62666"},"originalCharacterName":"美衣芽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Beautiful woman whose real name, age, background, etc. are unknown at all."},{"spoiler":false,"text":"She runs \"Eyewear Shop Mieme\" near the college where Yuu goes."},{"spoiler":false,"text":"Strongly quirky personality. She has a habit of teasing people."},{"spoiler":false,"text":"She can make magical glasses. When put on it, they bring out various abilities."},{"spoiler":false,"text":"Her hobby is to travel around the world. There seem to be many acquaintances of sorcerers in the countries."},{"spoiler":false,"text":"Source"}],"source":"vndb","sourceCharacterId":"c62666"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3b674fb05870bfecefd437676c7714a7fba4d0698e69f120f16c7e5d45c5907.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/904b0e681ca289b48147380d84026447a86ccda6e2d476e44a79079fb723c251.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62667","characterName":"日暮 慶次","sourceIds":{"vndbCharacterId":"c62667"},"originalCharacterName":"日暮 慶次","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuu's inseparable relationship rather than a best friend since high school."},{"spoiler":false,"text":"At college, he often acts together while exchanging banter with Yuu."},{"spoiler":false,"text":"He is playful unlike Yuu."},{"spoiler":false,"text":"His hobby is to see Mieme at her shop."},{"spoiler":false,"text":"He doesn't know at all Yuu and Mieme are sorcerer."},{"spoiler":false,"text":"Source"}],"source":"vndb","sourceCharacterId":"c62667"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec66cef70bc418c9948a8641db870f0e83bcee0097192adca8cf87aaa30a5d2c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53749c95f463752dc8fdf0f9ddaa305a93a4b6162d086fd9ed8dbbfd4f578b7b.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c62668","characterName":"如月 勇","sourceIds":{"vndbCharacterId":"c62668"},"originalCharacterName":"如月 勇","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main character of this game. When he was young he met a mysterious old man and got a magic that can strengthen his fist."},{"spoiler":false,"text":"As a child he dreamed of getting rid of bad guys with that power, but in reality he became an adult without such opportunity."},{"spoiler":false,"text":"Although he is usually a college student, he works as a member of the private night patrol team \"Light Guardian\" at night."},{"spoiler":false,"text":"The dream of wanting to serve people has changed its shape and becomes the cornerstone of his present."},{"spoiler":false,"text":"Source"}],"source":"vndb","sourceCharacterId":"c62668"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4af4991b8e04319b64f036bfa269da902dc148cb6e44b639e5f751e5356bc8c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/termi