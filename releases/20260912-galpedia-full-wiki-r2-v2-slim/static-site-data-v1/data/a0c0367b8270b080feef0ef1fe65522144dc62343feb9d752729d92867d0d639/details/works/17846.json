:["2243"],"vndbCharacterId":"c22036"},"originalCharacterName":"クロハ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"131"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Favorite colors: Black, dark red"},{"spoiler":false,"text":"Favorite things: Water balloons, cotton candy"}],"source":"vndb","sourceCharacterId":"c22036"},{"segments":[{"spoiler":false,"text":"浅草橋の裏路地で「機巧屋」という雑貨屋を経営している不思議な女の子。"},{"spoiler":false,"text":"主人公【多輝】に時間を操る力を与える。"},{"spoiler":false,"text":"それは一日をプラスできるというもの。"},{"spoiler":false,"text":"普段は店の一番奥にちょこんと座って、収集した骨董級の古い時計を眺めてはうっとりしている。"}],"source":"egs","sourceCharacterId":"2243","sourceWorkId":"19221","spoiler":false},{"segments":[{"spoiler":false,"text":"『1/2 summer（ワンサイドサマー）』 に座敷童子として登場したクロハ。"},{"spoiler":false,"text":"力を取り戻したことで自由を手に入れ、ふらりと東京へとやって来ていた。"},{"spoiler":false,"text":"そしてこの神田旅籠町番外地で、『機巧屋』 という雑貨屋を経営している。"},{"spoiler":false,"text":"なにやら企んでいる様子で、主人公・多輝に “一日をプラスする” 時間を操る力を授ける。"},{"spoiler":false,"text":"普段は店の一番奥にちょこんと座って、裏路地を通り行く人をなんとなく目で追っている不思議な女の子。"},{"spoiler":false,"text":"そして毎日のように収拾した骨董級の古い時計を眺めては、うっとりしている。"},{"spoiler":false,"text":"すべての力を取り戻したことで “クロハ” から “黒翼” と名乗るようになった。"},{"spoiler":false,"text":"「その美味しそうなものは何？　ほう、ドーナツとな !?」"}],"source":"bangumi","sourceCharacterId":"22859"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba44f6de32cd91033f0961269fc46178837cb39d347c64e9dee3af505af74675.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe33a67860e43308dd824a08fcb8ffcf6cd085367517ec7a2cfe0a9acf804a58.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"秋野 花","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ 