urce":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Faction: Angel"},{"spoiler":false,"text":"Race: Seraph"},{"spoiler":false,"text":"Occupation: Knight"},{"spoiler":false,"text":"Reality: University medical student"},{"spoiler":false,"text":"Hobby: Watching westerns alone"},{"spoiler":false,"text":"Specialty: Remembering things"},{"spoiler":false,"text":"Favorite Food: Tortillas"},{"spoiler":false,"text":"Dislikes: Fortune-telling"},{"spoiler":false,"text":"\"Come with me, Amadeus. No scar shall grace this hand.\""},{"spoiler":false,"text":"The arrogant leader of the Angels, who has unshaken confidence and pride in himself. Trusted by those around him and praised at all times, he has been elevated to godly status in the eyes of his followers."},{"spoiler":false,"text":"In order to make Kazuha his, he is very persistent in his approach to her without any regard to those around them. In real life, he attends a prestigious medical school to carry out his father’s plans for him to become a doctor. His focus is purely academic, and as he’s not very sociable, he’s often called “invisible” by his peers."},{"spoiler":false,"text":"Annoyed by those who don’t acknowledge or respect him, he is frustrated with how different things are in real life versus his life in Arcadia."},{"spoiler":false,"text":"From the official site"}],"source":"vndb","sourceCharacterId":"c38576"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7eba772c5afda932444760e01aed4890a6895d388230def2089334f105f7826.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be92a9fbe93041651fdd9745254b7a044fbfe234802805212bbcb2eb8caa94b2.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井 孝宏","creatorId":"vndb:s50","sourcePersonId":"vndb:s50","canonicalEntityId":"vndb:s50","name":"櫻井 孝宏","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64366","source":"vndb"}]},{"characterId":"char_vndb_c38929","characterName":"ヒロヤ","sourceIds":{"vndbCharacterId":"c38929"},"originalCharacterName":"ヒロヤ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"513"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Faction: Demon"},{"spoiler":false,"text":"Race: Therian"},{"spoiler":false,"text":"Occupation: Boxer"},{"spoiler":false,"text":"Reality: 2nd-year high school student"},{"spoiler":false,"text":"Hobby: Soccer"},{"spoiler":false,"text":"Specialty: Sprinting"},{"spoiler":false,"text":"Favorite Food: Meat (esp. hamburger steak)"},{"spoiler":false,"text":"Dislikes: Numbers"},{"spoiler":false,"text":"\"Don't look like that. I'll figure something out.\""},{"spoiler":false,"text":"A brusque Boxer with a slight attitude, who often tends to be harsh with Kazuha. Though he can sometimes come off as aloof, he is actually a caring person who puts his life on the line for Kazuha in the game world."},{"spoiler":false,"text":"In real life, he is her childhood friend. Although they played together for years as children, after graduating from junior high, they eventually grew apart. He has been acting distant around her lately for some reason."},{"spoiler":false,"text":"He is also a good friend of Kazuha’s brother, Shiki, who was the one who invited Hiroya to play Arcadia in the first place. He helps Kazuha find her brother, while at the same time protecting her after she becomes the “Almighty.”"},{"spoiler":false,"text":"From the official site"}],"source":"vndb","sourceCharacterId":"c38929"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8439ce8306895b91a8a56a53f6070a4017d31ce292e29b5c4b9278854905e29.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcfa32fc2b25cf1f1066a940af661f074a9bd76704cab4d4b41cd90f4389d706.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡本 信彦","creatorId":"vndb:s550","sourcePersonId":"vndb:s550","canonicalEntityId":"vndb:s550","name":"岡本 信彦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64375","source":"vndb"}]},{"characterId":"char_vndb_c38941","characterName":"ラディウス","sourceIds":{"vndbCharacterId":"c38941"},"originalCharacterName":"ラディウス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"108"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"184"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Faction: Demon"},{"spoiler":false,"text":"Race: Dracon"},{"spoiler":false,"text":"Occupation: Fencer"},{"spoiler":false,"text":"Reality: Idol/1st-year college student"},{"spoiler":false,"text":"Hobby: Cycling"},{"spoiler":false,"text":"Specialty: Singing"},{"spoiler":false,"text":"Favorite Food: Grapes"},{"spoiler":false,"text":"Dislikes: Variety shows"},{"spoiler":false,"text":"\"Like I said, she's none of my concern.\""},{"spoiler":false,"text":"A solitary Dracon Fencer who’s not too fond of lies or jokes in general. He is very straightforward with his opinions, and comes off as rude to the people around him. He is aware of his obvious skill as a swordsman and looks down on Kazuha for not having any power, despite her position as the “Almighty,” and dismisses her as useless."},{"spoiler":false,"text":"In real life, he’s a popular idol who is fed up with the illusion of fame and being forced to act friendly, so blows off steam by being his true self in the game world. He doesn’t like to be complimented on his appearance and becomes upset if anyone praises his looks."},{"spoiler":false,"text":"From the official site"}],"source":"vndb","sourceCharacterId":"c38941"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23c4d61c2a134b1af722d8972f7bc0910590f9543bb57d69a91656d1140f54bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4ee54ba7fc62378eb3ef0e6efbdf48869482d7ff5d198f3f2c5d56e23dc45cc1.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前野 智昭","creatorId":"vndb:s64","sourcePersonId":"vndb:s64","canonicalEntityId":"vndb:s64","name":"前野 智昭","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64367","source":"vndb"}]},{"characterId":"char_vndb_c43651","characterName":"リベラ","sourceIds":{"vndbCharacterId":"c43651"},"originalCharacterName":"リベラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1027"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Faction: Demon"},{"spoiler":false,"text":"Race: Hellion"},{"spoiler":false,"text":"Occupation: Mage"},{"spoiler":false,"text":"Reality: 2nd-year junior high student"},{"spoiler":false,"text":"Hobby: Games"},{"spoiler":false,"text":"Specialty: Fake Smiles"},{"spoiler":false,"text":"Favorite Food: Curry Rice"},{"spoiler":false,"text":"Dislikes: Melons (as a sympathy gift)"},{"spoiler":false,"text":"\"This is just one of those times when we gotta help each other. Right?\""},{"spoiler":false,"text":"A young, mischievously charming Hellion."},{"spoiler":false,"text":"In Arcadia, she wields her charm to get equipment and money from all sorts of people. After learning that Kazuha is the “Almighty,” she sticks by Kazuha’s side in attempt to use her to her advantage."},{"spoiler":false,"text":"In real life, she is actually a boy in junior high who is chronically hospitalized. Self-deprecating and warped, he has no hesitation in using others to compensate for his ill health. Seeing anyone having fun annoys him."},{"spoiler":false,"text":"From the official site"}],"source":"vndb","sourceCharacterId":"c43651"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efa5dccbd00e93aa12e1e597d32b1c3b29c3b7b2472cc640a36ca02a7146d9c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/659e06650e6a7e499322296d7e36b427a9f9ed4b5c3a20e87d2be34c558b780c.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花江 夏樹","creatorId":"vndb:s2180","sourcePersonId":"vndb:s2180","canonicalEntityId":"vndb:s2180","name":"ペロペロンチーノ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64377","source":"vndb"}]},{"characterId":"char_vndb_c43659","characterName":"ザイン","sourceIds":{"vndbCharacterId":"c43659"},"originalCharacterName":"ザイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Faction: NPC"},{"spoiler":false,"text":"Race: Human"},{"spoiler":false,"text":"Occupation: Merchant"},{"spoiler":false,"text":"Reality: None"},{"spoiler":false,"text":"Hobby: Listening to people’s stories"},{"spoiler":false,"text":"Specialty: Server data analysis"},{"spoiler":false,"text":"Favorite Food: Pot-au-feu (extra vegetables)"},{"spoiler":false,"text":"Dislikes: Lemons"},{"spoiler":false,"text":"\"I'm the only one who gets to look at you...\""},{"spoiler":false,"text":"A silver-haired young man who was found unconscious in the woods. All of his memories had disappeared, except for his feeling of responsibility to protect Kazuha, and he does precisely that."},{"spoiler":false,"text":"Originally, he was a NPC who guided people around town and provided players with quests. Upon finding out about his true self through meeting Kazuha, he begins to explore his pure and gentle, but somewhat deviant side."},{"spoiler":false,"text":"The fact he actually doesn’t exist starts to frustrate him, and his vulnerability begins to rear its head as a result."},{"spoiler":false,"text":"From the official site"}],"source":"vndb","sourceCharacterId":"c43659"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8a60da1d9a3a60c6165a72f6a2db2f531170ad2695e09f7547caf6bdb2b3f69.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47017203902d68ce32c3758b93cf3dbf3f219059abca639794fb4ab0f8d399a7.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平川 大輔","creatorId":"vndb:s133","sourcePersonId":"vndb:s133","canonicalEntityId":"vndb:s133","name":"平川 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64369","source":"vndb"}]},{"characterId":"char_vndb_c43660","characterName":"ポヨポヨ","sourceIds":{"vndbCharacterId":"c43660"},"originalCharacterName":"ポヨポヨ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"35"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"2"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Faction: None"},{"spoiler":false,"text":"Race: None"},{"spoiler":false,"text":"Occupation: Intel"},{"spoiler":false,"text":"Age: None"},{"spoiler":false,"text":"Reality: None"},{"spoiler":false,"text":"Hobby: Shopping"},{"spoiler":false,"text":"Specialty: Juggling beanbags"},{"spoiler":false,"text":"Favorite Food: Oranges"},{"spoiler":false,"text":"Dislikes: Idealists"},{"spoiler":false,"text":"\"Hehe. Despite my looks, Poyo-Poyo is one talented Intel, poyo!\""},{"spoiler":false,"text":"A mysterious monster with no allegiance to either faction, who travels all over Arcadia, selling information to inquiring minds. It shows up in front of Kazuha from time to time, and teases her with the possibility of knowing about her brother Shiki, but mostly acts aloof, making it difficult for anyone to know its true intentions."},{"spoiler":false,"text":"It occasionally is seen with a serious face, as if determined to do something…No one knows its true identity, but rumor has it that it knows considerable secrets about the world of Arcadia."},{"spoiler":false,"text":"From the official site"}],"source":"vndb","sourceCharacterId":"c43660"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41806919d5a7ae7c21de925ad8addcfec0953c99509a47fa47017ebc3ca80098.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09cbb37017f9ca263cf49bcd1729917b649811aa619909ec787e003b134fd883.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳥海 浩輔","creatorId":"vndb:s45","sourcePersonId":"vndb:s45","canonicalEntityId":"vndb:s45","name":"鳥海 浩輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64364","source":"vndb"}]},{"characterId":"char_vndb_c43661","characterName":"カズハ","sourceIds":{"vndbCharacterId":"c43661"},"originalCharacterName":"カズハ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Looking for her missing brother Shiki, Kazuha begins to play the video game “Arcadia,” and becomes trapped in the game world. She is loyal and obedient, but strong enough to voice her opinions when challenged."},{"spoiler":false,"text":"After an unexpected turn of events force her to become the “Almighty,” both Angels and Demons start to see her as a possession to be acquired. She works hard to progress through their adventure, and assists her allies as a Minstrel."},{"spoiler":false,"text":"From the official site"}],"source":"vndb","sourceCharacterId":"c43661"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/712acbe2f557fd732fbbb362b926427c666af55fd2a1a8e91aabf0f668711178.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee4acd8864a68e730633324891d15c6b0a345afa6f38493d93c4998d7de9bc78.webp","width":208,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c48031","characterName":"ディメント","sourceIds":{"vndbCharacterId":"c48031"},"originalCharacterName":"ディメント","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"birthday":{"reviewState":"source-only","source":"vndb","value":"822"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"186"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"64"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Faction: None"},{"spoiler":false,"text":"Race: Fallen"},{"spoiler":false,"text":"Occupation: Assassin"},{"spoiler":false,"text":"Reality: Convenience store clerk"},{"spoiler":false,"text":"Hobby: Watching the clock"},{"spoiler":false,"text":"Specialty: Darts"},{"spoiler":false,"text":"Favorite Food: Pomegranates"},{"spoiler":false,"text":"Dislikes: Team games"},{"spoiler":false,"text":"\"Hehehe... Great. If it hurts, it's proof that you're alive.\""},{"spoiler":false,"text":"He finds sheer joy in taking lives, Angels’ or Demons’. He lusts after murder and throws out numerous daggers that are hidden inside of his coat. Concealed in the shadows, he waits for his chance to steal Kazuha, but he is also ready to kill her without hesitation if she puts up a fight."},{"spoiler":false,"text":"He used to be an Angel, but after becoming trapped in the game world, he began to grow obsessed with killing, and now lives to take the lives of others."},{"spoiler":false,"text":"As punishment for killing his own kind, he was stripped of his original status and labeled “Fallen,” a mark that serves as a penalty and proof of being a PK."},{"spoiler":false,"text":"From the official site"}],"source":"vndb","sourceCharacterId":"c48031"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/charact