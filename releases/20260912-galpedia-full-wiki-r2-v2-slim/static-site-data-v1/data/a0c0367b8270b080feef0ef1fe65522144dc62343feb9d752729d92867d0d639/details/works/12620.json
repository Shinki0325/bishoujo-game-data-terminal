idate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"birthday":{"reviewState":"source-only","source":"vndb","value":"104"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Memories Off 6 ~T-Wave~:"},{"spoiler":false,"text":"Hobbies: Internet, traveling."},{"spoiler":false,"text":"Likes: Talking, Japanese Culture."},{"spoiler":false,"text":"Dislikes: Preaching, studying."},{"spoiler":false,"text":"A regular at the restaurant \"Fumi\" and a freeter. He makes a living working part-time at the chain restaurant \"Ressac.\" He is alumnus from Sumisora High School where his activities at the school festival have turned into legend. Although he gives out the impression of a frivolous and shallow person, in truth, Shin is loyal to a fault and dependable. He has an older sister who is actually"},{"spoiler":true,"text":"Suzushiro Rein, whose real name is Inaho Suzu"},{"spoiler":false,"text":"Memories Off 6: Next Relation:"},{"spoiler":false,"text":"In his vacation from working at the chain restaurant \"Ressac,\" Shin had to go out for a summer only long-term part-time job in an onsen (spa) located in a ryokan (traditional inn)."},{"spoiler":false,"text":"Translated from the Japanese Wikipedia."}],"source":"vndb","sourceCharacterId":"c13545"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76fe86435d814f52a880f9b50dce6c4dd32a0ca31fe1e9f9bc6e56f0fea2c079.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/127bfefd1ea543a2e2c9e41e50c61d7d58316c30e4b5c0a68c8113b724d0a1d3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間島 淳司","creatorId":"vndb:s756","sourcePersonId":"vndb:s756","canonicalEntityId":"vndb:s756","name":"間島 淳司","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15826","source":"vndb"}]},{"characterId":"char_vndb_c13552","characterName":"Saga Tooru","sourceIds":{"vndbCharacterId":"c13552"},"originalCharacterName":"Saga Tooru","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"629"},"height":{"reviewState":"source-only","source":"vndb","value":"171"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"(18 in Memories Off 6: Next Relation)"},{"spoiler":false,"text":"Hobbies: Guitar."},{"spoiler":false,"text":"Likes: Music in general, Ririsu."},{"spoiler":false,"text":"Dislikes: Studying."},{"spoiler":false,"text":"A second year student at Sumisora High School. Tooru is Shio's classmate and best friend, even though he's often neglected. Claims that he likes Ririsu, he declares his feelings to her openly and directly. It often leads to her kicking his ass, but he seems to be enjoying it, as he's a little bit of a masochist."},{"spoiler":false,"text":"While Tooru's a little bit of a luck-pusher, it was shown that his actions are not as great as his words. He is known in his school as a legendary useless person."},{"spoiler":false,"text":"Because Tooru understands the undertones of the relationship between Shio and Ririsu, he ends up to be the stalking horse over and over again, even though he dislikes that."},{"spoiler":false,"text":"Tooru plays the guitar. When it comes to music, he can listen to anything, from classical to death metal."},{"spoiler":false,"text":"In \"Next Relation\", after getting a license, he purchases the motorcycle he always wanted."},{"spoiler":false,"text":"Taken from Wikipedia and translated from the official site and the Japanese Wikipedia."}],"source":"vndb","sourceCharacterId":"c13552"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26922aa7997843a41fa3c8f0929562a52136b694da6d140f3f7bb26fa7711ec8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e33ddb2e980fa1fbcfbf7b1b78e7110b3f5ef0b20646e68772a322fbeebf93d6.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"根本 幸多","creatorId":"vndb:s7081","sourcePersonId":"vndb:s7081","canonicalEntityId":"vndb:s7081","name":"根本 幸多","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15833","source":"vndb"}]},{"characterId":"char_vndb_c13559","characterName":"秋津 神奈","sourceIds":{"vndbCharacterId":"c13559"},"originalCharacterName":"秋津 神奈","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuno's best friend, she transferred from a school abroad when she was in junior high."},{"spoiler":false,"text":"In \"Next Relation\" she helps Shio and Yuuno with the radio program production."},{"spoiler":false,"text":"Translated from the Japanese Wikipedia."}],"source":"vndb","sourceCharacterId":"c13559"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/806325cfb6be2cf7834cf03d37dc0d3f934cfd8637f0d026272b1353ccaa8ec9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfc486a09433091e9150d6109333f5d56d1430ac450afdfd91223bbe15aff8bd.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"溝口 小百合","creatorId":"vndb:s12209","sourcePersonId":"vndb:s12209","canonicalEntityId":"vndb:s12209","name":"溝口 小百合","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15835","source":"vndb"}]},{"characterId":"char_vndb_c13562","characterName":"塚本 香里","sourceIds":{"vndbCharacterId":"c13562"},"originalCharacterName":"塚本 香里","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ririsu's mother. Kaori is the owner of a youthful appearance, young enough to pass through as Ririsu's older sister. She usually has a mild temperament, but she tends to show motherly playfulness towards Ririsu. She also appears to be a crying drunk."},{"spoiler":false,"text":"In Memo Off 6: T-Wave (In this game she made a voice only appearance):"},{"spoiler":false,"text":"She is living with Yuugo (the dating itself has started a few years ago). This relationship has caused a major conflict between Kaori and Ririsu, making the later move in with her grandmother Fumiko, and away from her mother."},{"spoiler":false,"text":"In Memo Off 6: Next Relation:"},{"spoiler":false,"text":"The relationships conflict between the parents and the children of the two families (Yuugo and Shio, Kaori and Ririsu) has been already settled. They are all living together in peace."},{"spoiler":false,"text":"Translated from the Japanese Wikipedia."}],"source":"vndb","sourceCharacterId":"c13562"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1d9575da937d4fa9b232178d12eda3a12a4b8d903ed7a402866481f86462e66.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f2224879ed5fd74cb5c9ffda97bf38f860c719fdfcf2683a9eb5e7bf1837431.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"久保田 恵","creatorId":"vndb:s109","sourcePersonId":"vndb:s109","canonicalEntityId":"vndb:s109","name":"久保田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15822","source":"vndb"}]},{"characterId":"char_vndb_c14762","characterName":"塚本 雄吾","sourceIds":{"vndbCharacterId":"c14762"},"originalCharacterName":"塚本 雄吾","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Father of Shio. The two were separated due to a huge fight between them (It seems that he had Shio cast out from his house)."},{"spoiler":true,"text":"In Memo Off 6 - Next Relation:"},{"spoiler":true,"text":"Yuugo have reconciled with Shio, and is now free to show off his great love to Kaori."},{"spoiler":true,"text":"In addition, it turns out he is a merry drinker."},{"spoiler":false,"text":"Translated from the Japanese Wikipedia."}],"source":"vndb","sourceCharacterId":"c14762"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/390f36040d3ec46a6ceddacfa40fda64a311a80dc814977df521e3e41eaa1a5e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d50b55f0b8029c41a97ab85bdd6d7c896fa2d634e60337e5c11406a9977157a.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"上別府 仁資","creatorId":"vndb:s1196","sourcePersonId":"vndb:s1196","canonicalEntityId":"vndb:s1196","name":"上別府 仁資","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15828","source":"vndb"}]},{"characterId":"char_vndb_c14763","characterName":"嘉神川 幸蔵","sourceIds":{"vndbCharacterId":"c14763"},"originalCharac