:{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Age: 19 (in Togireta Film), 20 (in encore), 21 (in Memo Off 6: Next Relation)."},{"spoiler":false,"text":"Likes: Cycling and the color orange."},{"spoiler":false,"text":"A part-time worker at cafe Rusakku. Mahiro's very stubborn and hotblooded, but also very forgetful and childish. She tends to make clumsy and silly mistakes in cases of emergency. Mahiro also gets easily embarrassed and is quite insensitive when romance is involved. Despite all of this, Mahiro has a tender motherly side too."},{"spoiler":false,"text":"Asuka saw her at the scene of Yuusuke's death saying that his death was her fault. She's a big fan of of the model Karin Hanamatsuri, one of the heroines in Memories Off ~Sorekara~."},{"spoiler":false,"text":"Taken from MAL and translated from the official site."}],"source":"vndb","sourceCharacterId":"c10459"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/9128d05a7be4edabc3bc5db5e269160a86ecba949209bdc3254ac6c3f6eb2328.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/4616ffd9b3d7c17174c418d8e84e18e52352aba146d241235cf0d0db9118809a.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井ノ上 奈々","creatorId":"vndb:s1808","sourcePersonId":"vndb:s1808","canonicalEntityId":"vndb:s1808","name":"井ノ上奈々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15831","source":"vndb"}]},{"characterId":"char_vndb_c13500","characterName":"Tsukamoto Shio","sourceIds":{"vndbCharacte