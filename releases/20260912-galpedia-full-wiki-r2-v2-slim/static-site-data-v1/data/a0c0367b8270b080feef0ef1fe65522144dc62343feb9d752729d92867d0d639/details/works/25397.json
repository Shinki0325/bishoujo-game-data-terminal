ctors":[{"creditedName":"福島 潤","creatorId":"vndb:s395","sourcePersonId":"vndb:s395","canonicalEntityId":"vndb:s395","name":"福島 潤","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73772","source":"vndb"}]},{"characterId":"char_vndb_c61497","characterName":"アクア","sourceIds":{"vndbCharacterId":"c61497"},"originalCharacterName":"アクア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"source-only","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aqua is the goddess of water who judged humans to send to the RPG world, up until Kazuma dragged her along with him. She is an energetic and inattentive girl who likes to receive reverence for her status and gets upset easily. As an Archpriest and a goddess, she is powerful against demons and the undead, and is able to resurrect recently deceased people as well as purify water supplies. Rather than learning skills which would benefit her party, she spends most of her skill points learning party tricks."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c61497"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1ea51a529a279721300902a789a1dff6da6fdfb6a2521644dd75bdfb5acfe99.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9afaf823a993ca4a432b3f4e10ab3011211e18aa275e26c065aff9ba9b16864d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮 天","creatorId":"vndb:s7409","sourcePersonId":"vndb:s7409","canonicalEntityId":"vndb:s7409","name":"雨宮 天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73776","source":"vndb"}]},{"characterId":"char_vndb_c61498","characterName":"めぐみん","sourceIds":{"vndbCharacterId":"c61498"},"originalCharacterName":"めぐみん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"13"},"height":{"reviewState":"source-only","source":"vndb","value":"149"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Megumin is a 13-year-old (14 and 15 later on), archwizard who is part of the crimson demons race; powerful humanoids who possess black hair, red eyes, and chuunibyou characteristics. Megumin only knows a single spell, an incredibly powerful Explosion spell that immediately incapacitates her for the rest of the day when cast, and refuses to learn any other skills."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c61498"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f20ac46c0c0d2b8c8ada34afe779fe38f9de4747041ca4d115611a9c88f0ddaf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15229a13a7825fb6cedfeea12ffa9c5d3012053ca1547f70a5c0c426d65deb00.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋 李依","creatorId":"vndb:s10632","sourcePersonId":"vndb:s10632","canonicalEntityId":"vndb:s10632","name":"高橋 李依","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73777","source":"vndb"}]},{"characterId":"char_vndb_c61499","characterName":"ダスティネス・フォード・ララティーナ","sourceIds":{"vndbCharacterId":"c61499"},"originalCharacterName":"ダスティネス・フォード・ララティーナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"height":{"reviewState":"source-only","source":"vndb","value":"171"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Darkness is a 18-year-old crusader who possesses powerful offense and defense, but lacks the accuracy to deliver her attacks. She is a masochist who dreams of being ravaged by monsters or married to an abusive husband; regardless, she becomes serious with issues involving her friends. She is a noble from the influential Dustiness family, who became a crusader against her father's wishes."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c61499"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89a38c254f3dc7b43727bf149ed0ae16c845af705441fd3d82df85cc2a6599bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e7c7a9bfccb4b03d8e6e51126359bb442797d3aa6b1774a2a4f267d4d6afa3d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茅野 愛衣","creatorId":"vndb:s630","sourcePersonId":"vndb:s630","canonicalEntityId":"vndb:s630","name":"茅野 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73773","source":"vndb"}]},{"characterId":"char_vndb_c61500","characterName":"ゆんゆん","sourceIds":{"vndbCharacterId":"c61500"},"originalCharacterName":"ゆんゆん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yun'yun is Megumin's former classmate and daughter to the crimson demon's chief. She has a normal personality, causing her to be ironically estranged from her chūnibyō peers. Yun'yun is a highly skilled ArchWizard and uses her rivalry with Megumin as an excuse to create a friendship."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c61500"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/ddb27aeadf0f0a50c8f5950da8c9a3020abe77e1e80147c7cbaae1009497d402.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d7583f2902cff3c8549df3f44e4135873866a0236a66fec29e8d3d2790fdb7d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"豊崎 愛生","creatorId":"vndb:s6857","sourcePersonId":"vndb:s6857","canonicalEntityId":"vndb:s6857","name":"豊崎 愛生","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73775","source":"vndb"}]},{"characterId":"char_vndb_c61501","characterName":"ウィズ","sourceIds":{"vndbCharacterId":"c61501"},"originalCharacterName":"ウィズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"172"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Wiz is a powerful lich wizard who, despite being one of the Devil King's generals, is a timid and kind woman who uses her powers to assist civilians and lead lost spirits to the afterlife. She runs an unsuccessful magic shop which is later managed by Vanir, in which she is treated like a slave worker."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c61501"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/9047fbcb2dd5e4c0f4cb