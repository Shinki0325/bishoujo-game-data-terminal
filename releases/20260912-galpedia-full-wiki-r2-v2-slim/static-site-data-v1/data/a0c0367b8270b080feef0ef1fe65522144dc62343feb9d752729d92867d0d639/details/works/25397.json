":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Vanir is one of the Devil King's generals who ends up taking over the management of Wiz's magic shop. He is the devil of foresight and one of the dukes of hell and his ability is to read everything about anybody, but he cannot read anything about people that are as powerful as he is (the Devil King's generals and other dukes), people stronger than him (Aqua and other gods), and people who are a little weaker than him. These people have their readings clouded and incomplete. An exception to this is Kazuma, whose cunning nature makes him hard to read. He also has very powerful combat skills that he refuses to use on humans."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c61503"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71359a3678ee3ee574ea4c72506f99a15977073b11b385088541c2b79349a94b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7e870d907318a1eff021115b7d7cff8de15f7c115706ca82965c2e1cb60f174.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西田 雅一","creatorId":"vndb:s2655","sourcePersonId":"vndb:s2655","canonicalEntityId":"vndb:s2655","name":"西田雅一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73774","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:2282","sourceCompanyId":"egs:brand:2282","canonicalEntityId":"egs:brand:2282","name":"MAGES.(5pb.)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:25397:2282","source":"egs"},{"companyId":"vndb:p18058","sourceCompanyId":"vndb:p18058","canonicalEntityId":"vndb:p18058","name":"Shaggy","roleCodes":["publisher"