,"relationId":"vndb:vn-staff:54452","source":"vndb"}]},"cast":[{"characterId":"char_c11159","characterName":"夏目 音奈","sourceIds":{"bangumi":[{"characterId":"53294","match":"exact-normalized-name-in-linked-work","subjectId":"14265"}],"egsCharacterIds":["11834"],"vndbCharacterId":"c11159"},"originalCharacterName":"夏目 音奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1224"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She switches bodies with her younger twin brother Otone at the beginning of the story."}],"source":"vndb","sourceCharacterId":"c11159"},{"segments":[{"spoiler":false,"text":"ストレートロングヘアーの似合う自信家な女の子。"},{"spoiler":false,"text":"主人公の双子の姉でトラブルメーカー。性格は自由奔放＆大胆不敵。"},{"spoiler":false,"text":"さらに天下無双でゴーイングマイウェイな女の子。"},{"spoiler":false,"text":"ただ、弟に見せる普段の姿よりも外面は良いし、物事をちゃんと考えられる性格。"},{"spoiler":false,"text":"キレるとあっという間に暴走するが……　なので基本的にはトラブルメーカーな彼女だが、“いざというときに頼りになる存在”でもある。"},{"spoiler":false,"text":"今回の物語も彼女が発端であり、音子と身体を入れ替えたのも彼女。"},{"spoiler":false,"text":"つまり主人公（音子）は姉の身体で生活することになるのだが……元々双子だからか、音奈的には特に問題はないと考えている。"}],"source":"egs","sourceCharacterId":"11834","sourceWorkId":"14014","spoiler":false},{"segments":[{"spoiler":false,"text":"元気で明るい……どころか、自由奔放でゴーイングマイウェイな性格の、主人公の双子の姉。"},{"spoiler":false,"text":"いつも楽しいことを探しており、楽しいことのためならあらゆる労力も犠牲もいとわない。"},{"spoiler":false,"text":"そのため弟の音子からは 「過去の引っ越しの3割はお姉ちゃんのせい」 と言われるほど。"},{"spoiler":false,"text":"精神を入れ替える “マインドチェンジ” の超能力を持っており、引っ越しのタイミングを利用して音子と入れ替わり、男としての学園生活を楽しもうと目論んだのが今回の物語の発端である。"},{"spoiler":false,"text":"「今は私の身体なんだから、ちゃんと女の子らしく振る舞うこと！　なんでって？　その方が面白いに決まってるからよっ♪」"}],"source":"bangumi","sourceCharacterId":"53294"}],"profileFacts":[{"label":"好物","source":"bangumi","sourceCharacterId":"53294","value":"辛い物、しょっぱい物全般子"},{"label":"特技","source":"bangumi","sourceCharacterId":"53294","value":"マインドチェンジ（精神交換）"},{"label":"趣味","source":"bangumi","sourceCharacterId":"53294","value":"刺激的な日常のために策謀を張り巡らすこと"},{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"11834","sourceWorkId":"14014","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"11834","sourceWorkId":"14014","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"11834","sourceWorkId":"14014","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"11834","sourceWorkId":"14014","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"11834","sourceWorkId":"14014","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"48 kg","valueContext":null,"source":"egs","sourceCharacterId":"11834","sourceWorkId":"14014","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c371e53ede35bdff934eadeee61a0cef2ed6fca31daedf13afbd5e323027c21.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f744ef4772c4a7e53509dadae41cdb2c00737643be93062cfb24abfef4f77c9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14265:53294:5900:1","source":"bangumi"}]},{"characterId":"char_c11161","characterName":"松岡 奏","sourceIds":{"bangumi":[{"characterId":"53295","match":"exact-normalized-name-in-linked-work","subjectId":"14265"}],"egsCharacterIds":["11835"],"vndbCharacterId":"c11161"},"originalCharacterName":"松岡 奏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"114"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"3年前の富士見町クリスマスフェスタで姉達の演奏を見て、自分も同じように友達とライブをしたい！　……と考え、姉と同じ学園に入学。"},{"spoiler":false,"text":"しかし既に学園に軽音部はなく、２年の時にやっと同好会を設立。"},{"spoiler":false,"text":"メンバーは彼女一人だけといった悲惨な状況……そんな時、奏は音子と出会い、姉のギターを姉そっくりに弾いた（サイコメトリーの能力で弾いてしまった）彼女をメンバーの一人にしようと考え、誘ってくる。"},{"spoiler":false,"text":"奏は中流家庭生まれのの普通の女の子。"},{"spoiler":false,"text":"しかし極度の方向音痴であったり、良く忘れ物をしたりと“ドジッ子”な雰囲気を持つ女の子。"}],"source":"egs","sourceCharacterId":"11835","sourceWorkId":"14014","spoiler":false},{"segments":[{"spoiler":false,"text":"少しおっとりしているけど、いつもポジティブで明るく優しい女の子。"},{"spoiler":false,"text":"数年前にバンド活動をしていた姉の演奏を見て感激し、自分も仲間たちとバンド活動を楽しみたいと思っていた。"},{"spoiler":false,"text":"女の子になった音子とはクラスも住む寮も同じ。"},{"spoiler":false,"text":"ふとしたきっかけで音子が “サイコメトリー” の超能力を使い奏のギターを見事に演奏してしまった事に感激し、音子をバンド同好会に勧誘することになる。"},{"spoiler":false,"text":"「みんな一緒ならきっとできるよ。がんばろーっ！　あ、その前にバンドを組んでくれる “みんな” を探さないと」"}],"source":"bangumi","sourceCharacterId":"53295"}],"profileFacts":[{"label":"好物","source":"bangumi","sourceCharacterId":"53295","value":"響花の作った洋菓子全般"},{"label":"特技","source":"bangumi","sourceCharacterId":"53295","value":"道に迷う、人とぶつかる、忘れ物をする、etc……"},{"label":"趣味","source":"bangumi","sourceCharacterId":"53295","value":"ギター練習"},{"label":"胸围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"11835","sourceWorkId":"14014","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"11835","sourceWorkId":"14014","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"11835","sourceWorkId":"14014","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"11835","sourceWorkId":"14014","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"11835","sourceWorkId":"14014","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"45 kg","valueContext":null,"source":"egs","sourceCharacterId":"11835","sourceWorkId":"14014","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2e4c3473128cc1d26b955f1a6052b8bd226cbc18755ab80d3fbf7e7196f0400.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e98eff8e2a6fa01700a46f503910f96ac69a77558e4a35987397fb2228dfcd9b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北村彩","creatorId":"vndb:s912","sourcePersonId":"vndb:s912","canonicalEntityId":"vndb:s912","name":"北村 彩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14265:53295:6046:1","source":"bangumi"}]},{"characterId":"char_c11162","characterName":"和泉 響花","sourceIds":{"bangumi":[{"characterId":"53296","match":"exact-normalized-name-in-linked-work","subjectId":"14265"}],"egsCharacterIds":["11836"],"vndbCharacterId":"c11162"},"originalCharacterName":"和泉 響花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"831"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"奏の親友で、転入してきた音子とは同じクラス。"},{"spoiler":false,"text":"しかもクラス委員を務め、寮では寮長まで勤めているしっかり者の女の子。"},{"spoiler":false,"text":"ドジッ子な奏をフォローするのも主に彼女の役目であり、友人達からも「奏と響花で１セット」と言われてしまうほど仲が良かったりする。"}],"source":"egs","sourceCharacterId":"11836","sourceWorkId":"14014","spoiler":false},{"segments":[{"spoiler":false,"text":"音子と同級生でクラスメイト。"},{"spoiler":false,"text":"凛とした雰囲気と真面目な性格から、クラス内では委員長も勤める才色兼備の女の子。"},{"spoiler":false,"text":"だがその一方でお菓子作りが趣味という可愛い一面も持っている。"},{"spoiler":false,"text":"奏の親友だが、バンド活動には最初は否定的。"},{"spoiler":false,"text":"だが奏の説得もありベースギターを担当することになる。"},{"spoiler":false,"text":"また突然現れて奏の興味を惹く音子にはちょっとヤキモチを妬いてしまうことも。"},{"spoiler":false,"text":"「わ、私が奏の側にいるのは、奏のことが放っておけないからで、その、別に側にいたいからとか、好きとかではなくてだな……」"}],"source":"bangumi","sourceCharacterId":"53296"}],"profileFacts":[{"label":"好物","source":"bangumi","sourceCharacterId":"53296","value":"ウメボシ、ぎんなんなど地味系和食"},{"label":"特技","source":"bangumi","sourceCharacterId":"53296","value":"ヴァイオリン、ピアノ、琴"},{"label":"趣味","source":"bangumi","sourceCharacterId":"53296","value":"洋菓子作り（普通の料理は出来ない）"},{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"11836","sourceWorkId":"14014","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"11836","sourceWorkId":"14014","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"11836","sourceWorkId":"14014","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"11836","sourceWorkId":"14014","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"11836","sourceWorkId":"14014","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"48 kg","valueContext":null,"source":"egs","sourceCharacterId":"11836","sourceWorkId":"14014","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/559a378fbf1683dbac3c2c44c84492ebeee1ba36f9c04226dc2b3ee43e85c543.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdbd72d4531a34a057a10a39c9c99067f94d8647ef616df11fa463ff03d2a485.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14265:53296:5928:1","source":"bangumi"}]},{"characterId":"char_c11164","characterName":"幸田 葉澄","sourceIds":{"bangumi":[{"characterId":"53297","match":"exact-normalized-name-in-linked-work","subjectId":"14265"}],"egsCharacterIds":["11837"],"vndbCharacterId":"c11164"},"originalCharacterName":"幸田 葉澄","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"701"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"51"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"小動物っぽい女の子。"},{"spoiler":false,"text":"父親も元はバンドマンでドラム担当。"},{"spoiler":false,"text":"その時の印象は、当時幼かった葉澄には衝撃的なものだった。"},{"spoiler":false,"text":"当然、自分も大きくなったらドラムを叩くものだと勘違いし独学で練習。"},{"spoiler":false,"text":"しかも持ち前の絶対リズム感により、１曲だけならプロ顔負けの演奏が出来るほどになってしまう。"},{"spoiler":false,"text":"楽器を買おうと町に出たもののあまりの金額に挫折しそうになった富士見学園バンド同好会のメンバーとお店で出会い、「演奏させてくれるなら！」と、ドラムと一緒にメンバー入りすることに。"}],"source":"egs","sourceCharacterId":"11837","sourceWorkId":"14014","spoiler":false},{"segments":[{"spoiler":false,"text":"音子や奏たちの一学年後輩で、実家は富士美市で喫茶店を営んでいる。"},{"spoiler":false,"text":"なんとなく小動物っぽい雰囲気を持っているが、その小さい身体にパワーは無限大。"},{"spoiler":false,"text":"元気爆発、明るい病弱（？）少女"},{"spoiler":false,"text":"外見は小柄なもののドラムに対する思い入れは人一倍強く、バンドメンバーを探していた奏や音子たちの話を聞いて、ドラムセットごとバンドメンバーに加わることになる。"},{"spoiler":false,"text":"「小さくないもん！　はずみんのことは貧乳じゃなくて、巨乳予備軍って言って欲しいの！　わかった!?」"}],"source":"bangumi","sourceCharacterId":"53297"}],"profileFacts":[{"label":"好物","source":"bangumi","sourceCharacterId":"53297","value":"果物全般（主にバナナ）"},{"label":"特技","source":"bangumi","sourceCharacterId":"53297","value":"ドラムを叩くこと"},{"label":"趣味","source":"bangumi","sourceCharacterId":"53297","value":"人に抱きつくこと"},{"label":"胸围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"11837","sourceWorkId":"14014","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCh