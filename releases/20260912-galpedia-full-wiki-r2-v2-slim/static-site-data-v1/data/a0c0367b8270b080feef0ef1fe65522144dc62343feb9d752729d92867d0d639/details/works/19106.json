{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"19106","model":{"presentationWorkId":"vndb:v12765","staff":{"artwork":[{"creditedName":"中乃空","creatorId":"vndb:s578","sourcePersonId":"egs:creator:13406","canonicalEntityId":"vndb:s578","name":"中乃空","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:121819","source":"egs"}],"scenario":[{"creditedName":"神堂劾(九十九神一)","creatorId":"vndb:s1280","sourcePersonId":"egs:creator:2054","canonicalEntityId":"vndb:s1280","name":"神堂劾(九十九神一)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:121820","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c24416","characterName":"眞柴 麻優子","sourceIds":{"bangumi":[{"characterId":"67632","match":"exact-normalized-name-in-linked-work","subjectId":"79493"}],"egsCharacterIds":["1578"],"vndbCharacterId":"c24416"},"originalCharacterName":"眞柴 麻優子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"教え子２人と、肉体関係を持ってしまった。"},{"spoiler":false,"text":"彼らのことは、昔からよく知っている。"},{"spoiler":false,"text":"彼らのことを大切に想う気持ちは、確かに存在する。"},{"spoiler":false,"text":"でも、いまの私たちは、教師と教え子。"},{"spoiler":false,"text":"こんな関係は、続けてはいけない。"},{"spoiler":false,"text":"この関係が世間にバレたら、彼らの未来が閉ざされてしまう。"},{"spoiler":false,"text":"でも――"},{"spoiler":false,"text":"私は、彼らを愛する覚悟を決めた。"}],"source":"egs","sourceCharacterId":"1578","sourceWorkId":"19106","spoiler":false},{"segments":[{"spoiler":false,"text":"昔は主人公の家の近所に住んでいたが、進学と共に故郷を離れ、大学を卒業後に再び主人公たちのいる故郷に教師として赴任してきた。"},{"spoiler":false,"text":"学園では物静かで、しっかり者としてのイメージを周囲に抱かせているが、それは本来の自分から気を張るようにして作り上げたもの。"},{"spoiler":false,"text":"私生活や主人公たちの前では、元来の明るくチャーミングで甘えん坊な女性に変わる。"},{"spoiler":false,"text":"おっとりしたしゃべり方とやさしい表情からほんわかしたムードが漂うが、根はしっかりとした心の強い女性。"}],"source":"bangumi","sourceCharacterId":"67632"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb46a90246865cb438897deb85ccf47e55958074ace971052d6e1d5ada8a4362.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f30ef2731166ce11b9465de6d2ced4c18c515689e3607be11d3068e4becc0a3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79493:67632:5906:1","source":"bangumi"}]},{"characterId":"char_c24417","characterName":"笹目塚 結衣","sourceIds":{"bangumi":[{"characterId":"67633","match":"exact-normalized-name-in-linked-work","subjectId":"79493"}],"egsCharacterIds":["1579"],"vndbCharacterId":"c24417"},"originalCharacterName":"笹目塚 結衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"彼のことが好きだった。"},{"spoiler":false,"text":"彼に想い人がいると分かっていても、諦めることはできなかった。"},{"spoiler":false,"text":"でもある日、私は見てしまう。"},{"spoiler":false,"text":"あの女と、彼、そして彼の親友の３人が、セックスをしているところを。"}],"source":"egs","sourceCharacterId":"1579","sourceWorkId":"19106","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼なじみ。"},{"spoiler":false,"text":"家が近所ということもあり、主人公やその親友・雅也と一緒にいる時間が多かった。"},{"spoiler":false,"text":"しかし麻優子とはあまり面識がなく、麻優子の話を聞いたことはあったが、仲間には加わろうとしていなかった。"},{"spoiler":false,"text":"昔から主人公のことを好きなのだが、なかなか言い出せずにいる。"},{"spoiler":false,"text":"麻優子に対する主人公の気持ちにも感付いており、それゆえに日々歯がゆい思いをしている。"}],"source":"bangumi","sourceCharacterId":"67633"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b274d75b5081ac4160560cd2f946c9a4c7d04cb6b0a1f0c1c9419d719947a407.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/3749d2bfe2ed6a93babfdc5ca45a42cfa8210bf4229b47cec18b47df7323205d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79493:67633:6016:1","source":"bangumi"}]},{"characterId":"char_c47484","characterName":"水上 恭介","sourceIds":{"bangumi":[{"characterId":"108850","match":"exact-normalized-name-in-linked-work","subjectId":"79493"}],"egsCharacterIds":["1577"],"vndbCharacterId":"c47484"},"originalCharacterName":"水上 恭介","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"突然の再会。"},{"spoiler":false,"text":"きっかけは、教師として彼女が学園に赴任してきたこと。"},{"spoiler":false,"text":"近所に住む、優しい年上の女性だった彼女。"},{"spoiler":false,"text":"彼女のことが、俺は好きだった。"},{"spoiler":false,"text":"彼女は戸惑いつつも、俺――いや、俺たちの気持ちを受け入れてくれた。"},{"spoiler":false,"text":"俺。そして、俺と同じように彼女を好きだった、親友を――。"}],"source":"egs","sourceCharacterId":"1577","sourceWorkId":"19106","spoiler":false},{"segments":[{"spoiler":false,"text":"本編主人公。"},{"spoiler":false,"text":"幼少の頃に近所に住んでいた麻優子に淡い恋心を抱いていたが、麻優子が進学と同時に都会へ行ってしまい、その想いは潰える。"},{"spoiler":false,"text":"しかし、主人公が通う学園に麻優子が教師として就任して以来、再び湧き上がる恋心を感じている。"},{"spoiler":false,"text":"実家から通おうと思えば可能なのだが、大学進学前の自立を促すため、両親に勧められて学園の寮に入っている。"}],"source":"bangumi","sourceCharacterId":"108850"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_c47485","characterName":"尾ノ寺 雅也","sourceIds":{"bangumi":[{"characterId":"90590","match":"exact-normalized-name-in-linked-work","subjectId":"79493"}],"egsCharacterIds":["1580"],"vndbCharacterId":"c47485"},"originalCharacterName":"尾ノ寺 雅也","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"無二の親友と、同じ女性を好きになった。"},{"spoiler":false,"text":"あいつが、あの人をどれだけ愛しているかは知っている。"},{"spoiler":false,"text":"でも、それは俺だって同じ。"},{"spoiler":false,"text":"親友と同じ女性を好きになっても、譲る気持ちはなかった。"},{"spoiler":false,"text":"それだけ、本気で好きだった。憧れの女性だったんだ。"},{"spoiler":false,"text":"だから、俺は選択する。親友と共に、あの人を愛するということを。"}],"source":"egs","sourceCharacterId":"1580","sourceWorkId":"19106","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公とは正反対の雰囲気を持つ明るい少年。"},{"spoiler":false,"text":"スポーツマンで、身体を動かしていることが何よりも好き。"},{"spoiler":false,"text":"趣味も多く、勉強以外だったらそつなくこなす。"},{"spoiler":false,"text":"幼少時代には主人公の家の近所に住んでおり、麻優子ともよく遊んでいた。"},{"spoiler":false,"text":"母親が病気で死に、父親の仕事が多忙になったため中学の時に引っ越したが、その父親の海外転勤により故郷の学園に進学。主人公と再会を果たした。"},{"spoiler":false,"text":"主人公とは再会後も、幼少時代と変わらぬ親友関係が続いている。"}],"source":"bangumi","sourceCharacterId":"90590"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d3bdcf8f1d9760f485e628f20cab6276da785f45adcccafdb8c6614afb4801c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99a25564544e36d23ea2f4a1c3676f0cdab1c75f6fcd2188f20373bdc139bbd0.webp","width":124,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p341","sourceCompanyId":"egs:brand:334","canonicalEntityId":"vndb:p341","name":"Waffle","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:19106:334","source":"egs"},{"companyId":"vndb:p19859","sourceCompanyId":"vndb:p19859","canonicalEntityId":"vndb:p19859","name":"我要起飞了",