e-in-linked-work","subjectId":"14223"}],"egsCharacterIds":["13256"],"vndbCharacterId":"c50497"},"originalCharacterName":"本郷 藍","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人懐っこく無邪気で道に迷った主人公を自分の住む館へと導く少女。"},{"spoiler":false,"text":"羞恥心は薄いがエッチを重ねる内に…？"}],"source":"egs","sourceCharacterId":"13256","sourceWorkId":"9582","spoiler":false},{"segments":[{"spoiler":false,"text":"本郷　藍（ほんごう　あい）　CV：安堂りゅう"},{"spoiler":false,"text":"亲近人的天真少女，将迷路的主人公带进自己居住的洋馆里。"},{"spoiler":false,"text":"羞耻心淡薄，但在反复着啪啪啪的时候……？"}],"source":"bangumi","sourceCharacterId":"34070"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7ab263cd9d9ce9ca3a867eecd755de058b9350bc89a0f53dba2cfc584ea17bf1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87b4e196385d633c311a56abb6f17fbca369dd03cb67002d748fb31e1e52965d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14223:34070:6106:1","source":"bangumi"}]},{"characterId":"char_c51408","characterName":"桃野 桃子","sourceIds":{"bangumi":[{"characterId":"34069","match":"exact-normalized-name-in-linked-work","subjectId":"14223"}],"egsCharacterIds":["13258"],"vndbCharacterId":"c51408"},"originalCharacterName":"桃野 桃子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いつも明るくて元気な主人公の助手。"},{"spoiler":false,"text":"大きすぎる胸が悩みで少しエッチな少女。"},{"spoiler":false,"text":"主人公と共に館を訪れるが…。"},{"spoiler":false,"text":"特技はマーシャルアーツ。「はなマルッ！」の桃野桃は実姉。"}],"source":"egs","sourceCharacterId":"13258","sourceWorkId":"9582","spoiler":false},{"segments":[{"spoiler":false,"text":"桃野　桃子（ももの　ももこ）　CV：中瀬ひな"},{"spoiler":false,"text":"总是开朗活泼的主人公的助手。"},{"spoiler":false,"text":"过大的巨乳是其烦恼的有些好色的少女。"},{"spoiler":false,"text":"和主人公一起访问了洋馆，但是…。"},{"spoiler":false,"text":"特技是武术。"},{"spoiler":false,"text":"「はなマルッ！」中的桃野桃是其亲生姐姐。"}],"source":"bangumi","sourceCharacterId":"34069"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36e88917dc0bb2bbfb6406b1d1ceaa67d2f1f9cd714637006f5ea88d220279f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df81e05482b0d8c728b98f5fdaa0f120960eae7e757453c74c0da6a230110e00.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"なかせひな","creatorId":"vndb:s926","sourcePersonId":"vndb:s926","canonicalEntityId":"vndb:s926","name":"なかせ ひな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14223:34069:12719:1","source":"bangumi"}]},{"characterId":"char_c51409","characterName":"本郷 瑠璃子","sourceIds":{"bangumi":[{"characterId":"34071","match":"exact-normalized-name-in-linked-work","subjectId":"14223"}],"egsCharacterIds":["13257"],"vndbCharacterId":"c51409"},"originalCharacterName":"本郷 瑠璃子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"雪乃と藍の実母で歳若い未亡人。"},{"spoiler":false,"text":"着物をまとった貞淑で儚げな印象の館の主だが…。"}],"source":"egs","sourceCharacterId":"13257","sourceWorkId":"9582","spoiler":false},{"segments":[{"spoiler":false,"text":"本郷　瑠璃子（ほんごう　るりこ）　CV：名和野恋"},{"spoiler":false,"text":"雪