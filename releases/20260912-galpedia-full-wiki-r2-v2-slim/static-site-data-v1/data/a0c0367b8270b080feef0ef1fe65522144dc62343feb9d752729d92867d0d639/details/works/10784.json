","identityStatus":"source-native","relationId":"vndb:vn-staff:34964","source":"vndb"}]},"cast":[{"characterId":"char_c28045","characterName":"飛井 風太","sourceIds":{"bangumi":[{"characterId":"159207","match":"exact-normalized-name-in-linked-work","subjectId":"22178"}],"egsCharacterIds":["1147"],"vndbCharacterId":"c28045"},"originalCharacterName":"飛井 風太","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『風太編』主人公。女装が似合いそうな可愛らしい系美少年。"},{"spoiler":false,"text":"優柔不断で臆病。"},{"spoiler":false,"text":"この為、恥ずかしがって電車の中で老人に席を譲ることすらできない。"},{"spoiler":false,"text":"性癖は正常だが、貞操観念には小うるさい。"},{"spoiler":false,"text":"同じクラスの米尾羽里が好きなのだが、当然、告白できない。"},{"spoiler":false,"text":"この為、生き方が正反対だが自分を好きだと言ってくれる四位葉月や園美のことが気になる今日この頃。"},{"spoiler":false,"text":"「そ、そんなの……おかしいよ。誰とでもセ……そ、その……"},{"spoiler":false,"text":"一緒に寝るなんて、どう考えてもいけないことだよ」"}],"source":"egs","sourceCharacterId":"1147","sourceWorkId":"10784","spoiler":false},{"segments":[{"spoiler":false,"text":"『風太編』主人公。女装が似合いそうな可愛らしい系美少年。"},{"spoiler":false,"text":"優柔不断で臆病。この為、恥ずかしがって電車の中で老人に席を譲ることすらできない。"},{"spoiler":false,"text":"性癖は正常だが、貞操観念には小うるさい。"},{"spoiler":false,"text":"同じクラスの米尾羽里が好きなのだが、当然、告白できない。この為、生き方が正反対だが自分を好きだと言ってくれる四位葉月や園美のことが気になる今日この頃。"},{"spoiler":false,"text":"「そ、そんなの……おかしいよ。誰とでもセ……そ、その……一緒に寝るなんて、どう考えてもいけないことだよ」"}],"source":"bangumi","sourceCharacterId":"159207"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c88827b363530605551ffadd0449296f5f1d8cb77876bedc076bb959063f690.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49be609dac814432d7e490b3da22ea1cdac97d00492b11e39cb328bb48b553fe.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c28046","characterName":"米尾 羽里"