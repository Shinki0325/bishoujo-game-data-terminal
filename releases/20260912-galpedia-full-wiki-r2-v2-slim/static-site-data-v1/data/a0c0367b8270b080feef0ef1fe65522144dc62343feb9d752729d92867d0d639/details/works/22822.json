/39/39dba1797630485877b2205663402f8aa3781470451abe449d47564e3f91abe2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0b5893a4497e274b53bd24fc402092899b12c781391e29a2be9ce5b99cbdf22.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐倉 綾音","creatorId":"vndb:s3892","sourcePersonId":"vndb:s3892","canonicalEntityId":"vndb:s3892","name":"佐倉 綾音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66886","source":"vndb"}]},{"characterId":"char_vndb_c45389","characterName":"天々座 理世","sourceIds":{"vndbCharacterId":"c45389"},"originalCharacterName":"天々座 理世","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"214"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the waitresses at the Rabbit House. The daughter of a soldier, she has a very disciplined, military-like personality, however she is still very kind. She even carries a Glock and combat knife hidden on her person, but she is shown to having a strong feminine side as well, such as being vulnerable to cute things, and her appearance. She's pretty close to Sharo, who is her underclassman at the elite school she attends. Named after Thé des Alizés tea."}],"source":"vndb","sourceCharacterId":"c45389"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31cc534c6e00018c6006995eb57a03a831e33a87060c3f440dfc39be9a1ed0f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f9dfda31f9ec21db811b02e6aa9eb560098735cd989ce8f4069be92d83deaea.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"種田 梨沙","creatorId":"vndb:s4944","sourcePersonId":"vndb:s4944","canonicalEntityId":"vndb:s4944","name":"種田 梨沙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66889","source":"vndb"}]},{"characterId":"char_vndb_c45390","characterName":"桐間 紗路","sourceIds":{"vndbCharacterId":"c45390"},"originalCharacterName":"桐間 紗路","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"715"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"151"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chiya's childhood friend who lives next door to the Ama Usa An. She attends the same elite school as Rize, as a scholarship student, but is otherwise quite poor. She also has a slight fear of rabbits and becomes increasingly hyper after drinking coffee, her emotions differing depending on the blend. She is in love with Rize. She had a grey rabbit named \"Wild Geese\" (ワイルドギース), which Sharo reluctantly let it stay on her house under the condition for it to find its own food. She works at the Fleur de Lapin café. Named after Kilimanjaro coffee."}],"source":"vndb","sourceCharacterId":"c45390"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a247d8e59a62310491ac5b35989c4be47a0d659b46a86aeb8f295bb8fdc89eb5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02113a2c0debb014a1c0019692eaf06d6cb66e3c3371091256db59a415d7907d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"内田 真礼","creatorId":"