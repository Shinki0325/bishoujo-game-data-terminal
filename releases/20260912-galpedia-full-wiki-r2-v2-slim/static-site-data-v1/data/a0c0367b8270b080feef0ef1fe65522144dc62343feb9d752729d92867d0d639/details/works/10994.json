ds":{"bangumi":[{"characterId":"91651","match":"exact-normalized-name-in-linked-work","subjectId":"230768"}],"egsCharacterIds":["13277"],"vndbCharacterId":"c50410"},"originalCharacterName":"萩尾 苺","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"葵の幼馴染であり、「放課後怪しげ団」初代部長。"},{"spoiler":false,"text":"天然でほわほわ、ちょっぴり泣き虫だが、"},{"spoiler":false,"text":"不思議な事に対する探求心が人一倍強い。"},{"spoiler":false,"text":"そのため、勢いに任せて突っ走る傾向があり、葵はフォローとツッコミに大忙し。"},{"spoiler":false,"text":"大きいを「ビグい」、小さいを「ミニこい」、可愛いを「かわうい」など、"},{"spoiler":false,"text":"独特の単語を使うため、一見頭が弱そうに感じるが、"},{"spoiler":false,"text":"勉強は学園でもトップクラスの成績を誇るから、人間わからないものだ。"},{"spoiler":false,"text":"兄妹のように育った葵のことが大好きな様子。"}],"source":"egs","sourceCharacterId":"13277","sourceWorkId":"10994","spoiler":false},{"segments":[{"spoiler":false,"text":"天然でほわほわして、少し泣き虫なところもあるが不思議なことに対する探究心が人一倍強い。"},{"spoiler":false,"text":"一見頭が弱そうに見えるが、勉強は学園でもトップクラスの成績。ドの越えた、かなりの方向音痴。"},{"spoiler":false,"text":"主人公なども所属する \"放課後怪しげ団\" 初代部長をしている。"},{"spoiler":false,"text":"勢いに任せて突っ走る傾向があり、主人公はそのフォローとツッコミ役。"},{"spoiler":false,"text":"大きいを 『ビグい』小さいを 『ミニこい』かわいいを 『かわうい』など、独特の単語を使う。"},{"spoiler":false,"text":"春風寮に住んでいる。"},{"spoiler":false,"text":"近所に住み、兄妹のように育った主人公が大好き。"}],"source":"bangumi","sourceCharacterId":"91651"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef702348c784c3cb73fe1c7f1d8b014e80da4a37d66ee5ca4d5b1516b74cd53c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c8632b613fff2b6c0e8f13fe0c71fd014823d3771df52883f836ea2ed2a6950.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230768:91651:4830:1","source":"bangumi"}]},{"characterId":"char_c50411","characterName":"ミルク","sourceIds":{"bangumi":[{"characterId":"91652","match":"exact-normalized-name-in-linked-work","subjectId":"230768"}],"egsCharacterIds":["13278"],"vndbCharacterId":"c50411"},"originalCharacterName":"ミルク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"葵の机の引き出しに突然現れ、強引に「ヒーロー」にしてしまった少女。"},{"spoiler":false,"text":"無口系で若干（？）腹黒なタイプ。"},{"spoiler":false,"text":"語尾に「～ス」を付ける（「いやッス」「だめッス」など）話し方をし、"},{"spoiler":false,"text":"他人を煙に巻くような言動を取るため、考えが掴みにくい。"},{"spoiler":false,"text":"葵をオモチャのように扱っており、彼にとっては、"},{"spoiler":false,"text":"敵だか味方だかよくわからない要注意人物。"},{"spoiler":false,"text":"ちなみに、「ポリバケツにブリーフ一枚」という格好は、"},{"spoiler":false,"text":"深い意味などなく、単なる嫌がらせなようだ。"}],"source":"egs","sourceCharacterId":"13278","sourceWorkId":"10994","spoiler":false},{"segments":[{"spoiler":false,"text":"若干腹黒な、無口系。"},{"spoiler":false,"text":"「いやッス」 「だめッス」など、語尾に『ス』を付ける。"},{"spoiler":false,"text":"なにを考えているか分かりづらく、他人を煙に巻くような言動をする。"},{"spoiler":false,"text":"主人公のことをオモチャのように扱うため、主人公にとっては、敵か味方か分からない要注意人物。"},{"spoiler":false,"text":"主人公をある日突然現れたミルクが、なぜか強引にヒーローに変身させてしまう。"},{"spoiler":false,"text":"ただし、変身した主人公の格好はポリバケツにブリーフである。"},{"spoiler":false,"text":"目的は不明だが、デザインは単なる嫌がらせのようだ……"}],"source":"bangumi","sourceCharacterId":"91652"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96373d78781b77c3b5e8ef8cfac231eeebb234e190c0164a018845eb3f96cc18.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91f890633739c9dd309d169b6ec56f31aae6bbabd3a108483eb871bf394cc56c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230768:91652:6016:1","source":"bangumi"}]},{"characterId":"char_c50483","characterName":"マリーゴールド","sourceIds":{"bangumi":[{"characterId":"91653","match":"exact-normalized-name-in-linked-work","subjectId":"230768"}],"egsCharacterIds":["13279"],"vndbCharacterId":"c50483"},"originalCharacterName":"マリーゴールド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔王の娘で、典型的なツンデレタイプ。通称＝マリア。"},{"spoiler":false,"text":"寮に住み、家出状態で飛び出してきたため、非常に貧乏。"},{"spoiler":false,"text":"高貴な魔族のように振る舞っているが、意外と面倒見は良く、"},{"spoiler":false,"text":"苺や下級生にお願いされると、しぶしぶ言うことを聞いてしまう。"},{"spoiler":false,"text":"実は、人類の「オタク文化」を愛していて、"},{"spoiler":false,"text":"本人も重度のコスプレイヤーだが、恥ずかしいので隠している。"},{"spoiler":false,"text":"ちなみに、コスプレでは大きな胸を生かした露出の多い服装を好む。"},{"spoiler":false,"text":"葵とはケンカ友達で、憎からず思っているようだが、"},{"spoiler":false,"text":"苺のことや照れる気持ちから、素直になれない。"}],"source":"egs","sourceCharacterId":"13279","sourceWorkId":"10994","spoiler":false},{"segments":[{"spoiler":false,"text":"魔王の娘で、普段はマリアと呼ばれている。"},{"spoiler":false,"text":"典型的なツンデレで、主人公とはケンカ友達。"},{"spoiler":false,"text":"意外と面倒見はよく、苺や下級生にお願いされると、しぶしぶ言うことを聞いてしまう。"},{"spoiler":false,"text":"学園では高貴な魔族のように振舞っているが、実は重度のオタクでコスプレイヤー。"},{"spoiler":false,"text":"コスプレでは、大きな胸を生かした露出が多めの服装を好む。"},{"spoiler":false,"text":"人類のオタク文化を愛しているが、恥ずかしいので学園では隠している。"},{"spoiler":false,"text":"主人公のことは憎からず思っているが、照れる気持ちや苺のことがあり、素直になれずにいる。"},{"spoiler":false,"text":"春風寮に住んでいる。"},{"spoiler":false,"text":"家出状態で飛び出してきたので、非常に貧乏。"}],"source":"bangumi","sourceCharacterId":"91653"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/7520a19c7d4dd890632a931c242137ea777c9a2df8b965febac4c6cccee50923.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7ecd24594c66384ca54b7d0836422a619cbcce05c683440fcbec7db2f2fbaae0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"平野響子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230768:91653:5669:1","source":"bangumi"}]},{"characterId":"char_c50484","characterName":"イシス・ベル・スプレンデス","sourceIds":{"bangumi":[{"characterId":"91654","match":"exact-normalized-name-in-linked-work","subjectId":"230768"}],"egsCharacterIds":["13280"],"vndbCharacterId":"c50484"},"originalCharacterName":"イシス・ベル・スプレンデス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔界と親戚関係にある「冥界」のお姫様。"},{"spoiler":false,"text":"人間界との交流で、葵のいる学園に留学で来ている。"},{"spoiler":false,"text":"おっとり真面目、常に丁寧な口調で話すが、"},{"spoiler":false,"text":"誰に対しても一歩引いたような印象を受ける。"},{"spoiler":false,"text":"何か困ったことがあっても自分の中に抱え込んでしまいがち。"},{"spoiler":false,"text":"極度の方向音痴で、初めて学園にやってきたときも迷っていた。"},{"spoiler":false,"text":"そこを、葵に助けられたことから、葵のことを密かに頼りにしている。"}],"source":"egs","sourceCharacterId":"13280","sourceWorkId":"10994","spoiler":false},{"segments":[{"spoiler":false,"text":"やや儚げで、おっとりとしているが、芯は強い。"},{"spoiler":false,"text":"根が真面目で、なにか困ったことがあっても自分の中に抱え込んでしまうタイプ。"},{"spoiler":false,"text":"常に丁寧な口調で話し、誰に対しても1歩引いたような所がある。"},{"spoiler":false,"text":"苺と同じで方向音痴な上に、一緒にいる家来まで方向音痴なため、よく道に迷っている。"},{"spoiler":false,"text":"魔界とは親戚関係にある冥界のお姫様。"},{"spoiler":false,"text":"人間界との交流の意味もあって主人公のいる学園に留学で来ている。"},{"spoiler":false,"text":"初めて学園に来る時に、迷っている所を主人公に助けてもらったこともあり、主人公のことを密かに頼りにしているフシがある。"},{"spoiler":false,"text":"春風寮に住んでいる。"}],"source":"bangumi","sourceCharacterId":"91654"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb486a62477952b50c7900e19cbd6856fd0a55d3ef2d122625faae0ddb044075.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc449aa9c6bcc8bf84ef9a7c5c8d50c45ad696db4757c469b9d577eec761ad31.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230768:91654:6016:1","source":"bangumi"}]},{"characterId":"char_c50485","characterName":"香山 紫苑","sourceIds":{"bangumi":[{"characterId":"91656","match":"exact-normalized-name-in-linked-work","subjectId":"230768"}],"egsCharacterIds":["13282"],"vndbCharacterId":"c50485"},"originalCharacterName":"香山 紫苑","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"おっとりした柔らかい雰囲気、気品や思いやりをもった性格、"},{"spoiler":false,"text":"一見、お嬢様タイプの美少女だが、実は年齢不詳の天女。"},{"spoiler":false,"text":"少しイタズラ好きで、自分の身体の魅力をよく理解しており、"},{"spoiler":false,"text":"時々、葵を冗談っぽく誘惑したりする。"},{"spoiler":false,"text":"楓の上位神で、彼女とは母親や姉のような関係らしい。"}],"source":"egs","sourceCharacterId":"13282","sourceWorkId":"10994","spoiler":false},{"segments":[{"spoiler":false,"text":"天女であり、齢数百年とも、数千年とも言われている（実年齢は教えてくれない）。"},{"spoiler":false,"text":"おっとりした柔らかい雰囲気の美少女で、気品や他人に対する思いやりを持った、お嬢様的性格。"},{"spoiler":false,"text":"一見するとボーっとしているが頭の回転は速く、すこしイタズラ好きなところもある。"},{"spoiler":false,"text":"自分の身体の魅力をよく理解しており、時々主人公を冗談っぽく誘惑したりする。"},{"spoiler":false,"text":"楓の上位にあたる神で、楓とは母親や姉のような関係。"}],"source":"bangumi","sourceCharacterId":"91656"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e3cb96a746595e8bd49773972f5164eead1e0048b667efac389ef4fa4218a2c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af5104d0bdf84b59367b368705eaa3fc69dbef4ad9625b2105d75fe0eac8b5a4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平山ゆかり","creatorId":"vndb:s285","sourcePersonId":"vndb:s285","canonicalEntityId":"vndb:s285","name":"東かりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230768:91656:5905:1","source":"bangumi"}]},{"characterId":"char_c50488","characterName":"権太","sourceIds":{"bangumi":[{"characterId":"210278","match":"exact-normalized-name-in-linked-work","subjectId":"80906"}],"egsCharacterIds":["11015"],"vndbCharacterId":"c50488"},"originalCharacterName":"権太","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"背が低く、せむし男のような容姿。"},{"spoiler":false,"text":"酒好きで、顔が赤く酒焼けしている。"},{"spoiler":false,"text":"薬草使い。"}],"source":"egs","sourceCharacterId":"11015","sourceWorkId":"14549","spoiler":false},{"segments":[{"spoiler":false,"text":"年齢：不明　 身長：不明　 血液型：不明"},{"spoiler":false,"text":"3人いる畑番の1人。"},{"spoiler":false,"text":"背は低く、常に背を曲げたような体勢をしている。"},{"spoiler":false,"text":"畑番の中で “薬草使い” という役割を担っている。"},{"spoiler":false,"text":"山の中で薬草などの植物を独自に育てており、それらから祭事で使用する村独特の薬を作り出している。"},{"spoiler":false,"text":"酒好きで、いつも酔っぱらっている。酒焼けと薬焼けのせいで顔が常に赤い。"},{"spoiler":false,"text":"「ヒヒヒ……効いちょる、効いちょる……薬の効果は抜群じゃわい……」"}],"source":"bangumi","sourceCharacterId":"210278"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/c