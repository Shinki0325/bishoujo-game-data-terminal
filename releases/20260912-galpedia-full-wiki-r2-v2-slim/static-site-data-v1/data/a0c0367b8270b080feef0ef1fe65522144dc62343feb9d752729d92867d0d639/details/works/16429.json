{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"16429","model":{"presentationWorkId":"vndb:v3815","staff":{"artwork":[{"creditedName":"艶道 ミツ","creatorId":"vndb:s5816","sourcePersonId":"vndb:s5816","canonicalEntityId":"vndb:s5816","name":"武井 英彦","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:45269","source":"vndb"}],"scenario":[{"creditedName":"デヴォラ・ジョンストン","creatorId":"vndb:s5234","sourcePersonId":"vndb:s5234","canonicalEntityId":"vndb:s5234","name":"デヴォラ・ジョンストン","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:45266","source":"vndb"}],"music":[{"creditedName":"drops-tone","creatorId":"vndb:s2511","sourcePersonId":"vndb:s2511","canonicalEntityId":"vndb:s2511","name":"drops-tone","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:45265","source":"vndb"}],"other":[{"creditedName":"露店","creatorId":"vndb:s7069","sourcePersonId":"vndb:s7069","canonicalEntityId":"vndb:s7069","name":"露店","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:45267","source":"vndb"},{"creditedName":"艶道 ミツ","creatorId":"vndb:s5816","sourcePersonId":"vndb:s5816","canonicalEntityId":"vndb:s5816","name":"武井 英彦","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:45268","source":"vndb"}]},"cast":[{"characterId":"char_c35989","characterName":"山岸 佐知子","sourceIds":{"bangumi":[{"characterId":"93169","match":"exact-normalized-name-in-linked-work","subjectId":"246924"}],"egsCharacterIds":["12475"],"vndbCharacterId":"c35989"},"originalCharacterName":"山岸 佐知子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"41"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the manager of a bento shop in the shopping district of the town where the protagonist was born and raised. She has known the protagonist since elementary school."},{"spoiler":false,"text":"When he was in junior high school, he would come to the shop every day, but they had not seen each other since he left his hometown."},{"spoiler":false,"text":"She divorced her husband. She now lives alone in a rented house with a lunch box shop on the first floor and a living space on the second floor."},{"spoiler":false,"text":"When she meets the protagonist for the first time in six years, she finds that he has become a fine young man, and he begins to see her as a woman, not as a old lady running a bento shop."},{"spoiler":false,"text":"Her hobby is doing Karaoke. She is especially skilled at having sex when she is on top."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c35989"},{"segments":[{"spoiler":false,"text":"主人公が中学時代によく通った弁当屋のオバちゃん。41歳。"},{"spoiler":false,"text":"現在も同じ場所で弁当屋を営んでいる。"},{"spoiler":false,"text":"六年前、自分の浮気が原因で夫と離婚し、今の弁当屋で住み込みで働くようになった。"},{"spoiler":false,"text":"弁当屋歴は10年ほどで、オーナーからも信頼され、仕込からメニュー考案まで一人でこなしている。"},{"spoiler":false,"text":"主人公のことは小学生時代から知っている。六年ぶりに帰郷した主人公が立派な青年になっていたことから、オンナとしての感覚が刺激され……。"}],"source":"egs","sourceCharacterId":"12475","sourceWorkId":"13713","spoiler":false},{"segments":[{"spoiler":false,"text":"登場作品：『馴染みのオバちゃん』"},{"spoiler":false,"text":"バツイチでも逞しく生きる弁当屋のオバちゃん。"}],"source":"egs","sourceCharacterId":"12475","sourceWorkId":"16429","spoiler":false},{"segments":[{"spoiler":false,"text":"町の商店街にある弁当屋の雇われ店長。"},{"spoiler":false,"text":"主人公は地元を離れるまで毎日のように通っており、小学生の頃から知られている。"},{"spoiler":false,"text":"佐知子と主人公が再び出会うことになる6年の間に、彼女は夫と離婚。"},{"spoiler":false,"text":"現在は1階が弁当屋、2階が住居スペースの借家にひとり寂しく（身を持て余しながら）住んでいる。"},{"spoiler":false,"text":"6年ぶりに出会った主人公が立派な青年になっていたため、弁当屋のオバちゃんの顔とは別に、オンナとしての感覚で主人公を見るようになる。"}],"source":"bangumi","sourceCharacterId":"93169"}],"profileFacts":[{"label":"特技","source":"bangumi","sourceCharacterId":"93169","value":"オバちゃん上位の強引で激しいセックス"},{"label":"年龄（本版本）","value":"41 岁","valueContext":null,"source":"egs","sourceCharacterId":"12475","sourceWorkId":"16429","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0eb629f5b2c84806bf65e0e2d605cef519790c0a83494977ce84a981fe09c212.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26890bd6b01ea2bc771dc8f1b507016da3fa79a790815e73aab00b964613706d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨津 さえ","creatorId":"vndb:s1653","sourcePersonId":"vndb:s1653","canonicalEntityId":"vndb:s1653","name":"雨津 さえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24985","source":"vndb"}]},{"characterId":"char_c35990","characterName":"Kazu-chan (かずちゃん)","sourceIds":{"bangumi":[{"characterId":"93170","match":"exact-normalized-name-in-linked-work","subjectId":"246924"}],"egsCharacterIds":["12476"],"vndbCharacterId":"c35990"},"originalCharacterName":"Kazu-chan (かずちゃん)","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"42"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The proprietress of a kimono shop in a shuttered shopping district. A childhood friend of Sachiko, a bento shop owner. She married the original owner of the kimono shop 20 years ago."},{"spoiler":false,"text":"Since the death of her husband, she has been running the kimono shop by herself as the proprietress, she has not updated her family registry yet. She married before her childhood friend Sachiko, and became a single woman before Sachiko."},{"spoiler":false,"text":"She has sharper instincts than Sachiko, and always plays a supportive role behind Sachiko's back. She tries to forget her late husband for the sake of Sachiko, who always invites her to play with her, but she can't seem to get over it and keeps growing armpit hair, which her husband loved."},{"spoiler":false,"text":"She is a mature woman with a gentle sexuality who plays with and loves the main character, She is old enough to be his mother."},{"spoiler":false,"text":"Her hobby is flower arrangement. Her special skill is tying herself up in shibari."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c35990"},{"segments":[{"spoiler":false,"text":"呉服屋を経営する佐知子の幼馴染。42歳。"},{"spoiler":false,"text":"10年前に夫が心不全で他界し、現在は一人で呉服屋を切り盛りしている。"},{"spoiler":false,"text":"佐知子とは小学生時代からの竹馬の友で、短大時代には何でも話し合える気の置けない友人となった。"},{"spoiler":false,"text":"しかし何処かで佐知子に勝ちたいと思っており、それが表に出ないように気張っているらしい。"},{"spoiler":false,"text":"佐知子よりも感が鋭く、能天気な彼女を陰ながらサポートしている。"},{"spoiler":false,"text":"主人公とは、スポーツクラブで知り合い、それからちょっかいをかけるようになった。"}],"source":"egs","sourceCharacterId":"12476","sourceWorkId":"13713","spoiler":false},{"segments":[{"spoiler":false,"text":"登場作品：『馴染みのオバちゃん』"},{"spoiler":false,"text":"腋毛を大事にする呉服屋のしっとり未亡人。"}],"source":"egs","sourceCharacterId":"12476","sourceWorkId":"16429","spoiler":false},{"segments":[{"spoiler":false,"text":"シャッター商店街にある呉服屋の女将。20年ほど前に若旦那の元に嫁いだ。"},{"spoiler":false,"text":"弁当屋の佐知代とは幼なじみで、竹馬の友。"},{"spoiler":false,"text":"旦那を亡くしてからも籍を抜かずに、女将として呉服屋をひとりで切り盛りしている。"},{"spoiler":false,"text":"佐知代よりも勘が鋭く、能天気な彼女の影でサポート役に徹することを常としている。"},{"spoiler":false,"text":"いつも遊びに誘ってくれる佐知代のためにも、亡き夫のことを忘れようと努めているのだが、なかなか吹っ切れず、夫が好きだった腋毛を生やし続けている。"},{"spoiler":false,"text":"母子ほどの年齢差がある主人公には、しっとりした熟女の色気で翻弄し、かわいがる。"}],"source":"bangumi","sourceCharacterId":"93170"}],"profileFacts":[{"label":"特技","source":"bangumi","sourceCharacterId":"93170","value":"一人亀甲縛り"},{"label":"年龄（本版本）","value":"42 岁","valueContext":null,"source":"egs","sourceCharacterId":"12476","sourceWorkId":"16429","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/9303ffb86bbc16ae8c40df5489bda71bd2dd5a316ff74b9d5b3d8e29fe72aab4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/395e7a57d5787a2c803cb0f580524a002e6ef59d383367222b14b33224b354f9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MARIO","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:246924:93170:4918:1","source":"bangumi"}]},{"characterId":"char_vndb_c116382","characterName":"柿本 肇","sourceIds":{"vndbCharacterId":"c116382"},"originalCharacterName":"柿本 肇","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c35991","characterName":"河合 智代","sourceIds":{"vndbCharacterId":"c35991"},"originalCharacterN