{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"25265","model":{"presentationWorkId":"vndb:v17942","staff":{"artwork":[],"scenario":[{"creditedName":"下妻憂","creatorId":"egs:creator:14003","sourcePersonId":"egs:creator:14003","canonicalEntityId":"egs:creator:14003","name":"下妻憂","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:186883","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_106763","characterName":"Asagao Yuuki","sourceIds":{"bangumi":[{"characterId":"106763","match":"source-roster","subjectId":"313600"},{"characterId":"106763","match":"source-roster","subjectId":"314039"},{"characterId":"106763","match":"source-roster","subjectId":"371701"},{"characterId":"106763","match":"source-roster","subjectId":"371709"}]},"originalCharacterName":"Asagao Yuuki","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"夕暮　秋貴の幼馴染であり親友。"},{"spoiler":false,"text":"生まれた時から近所づきあいがあり、人生の殆どを一緒に過ごしてきた。"},{"spoiler":false,"text":"物心ついた辺りから女装をする事が多くなり、現在では生活での大半を女装をして過ごしている。"},{"spoiler":false,"text":"学校での籍は男性で表記されているが、扱いはほぼ女生徒のそれとなっている。"},{"spoiler":false,"text":"秋貴に好意を抱いており、物語が始まる前日に告白し、見事恋人同士となる。"},{"spoiler":false,"text":"家事全般が得意で身なりにも気を使っており、女性以上に女性らしい。"},{"spoiler":false,"text":"非常に一途であり献身的であるが、その反面、秋貴には行き過ぎた想いと行動を見せる事がある。"},{"spoiler":false,"text":"人当たりがよく、学内でも人気者。"}],"source":"bangumi","sourceCharacterId":"106763"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d792b0f0338fb74f44009a56ffdeb9fc422718f6aad83de62df30694e0ec7e65.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5a0efd89835e8d1fcfe0d258d1b2b2d55474a3813fe2ca6ea776f6e797f3b5b.webp","width":130,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_106764","characterName":"Yuugure Akitaka","sourceIds":{"bangumi":[{"characterId":"106764","match":"source-roster","subjectId":"313600"},{"characterId":"106764","match":"source-roster","subjectId":"371709"}]},"originalCharacterName":"Yuugure Akitaka","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"常識と良識を旨としているが、結城の存在については黙認している。"},{"spoiler":false,"text":"結城が学内で評判が良い為、相乗して秋貴も同性・異性に関わらず友好的である。"},{"spoiler":false,"text":"既に学内では「結城は秋貴の彼女」と位置づけられてしまっているが、結城と交際を始めた事を公表するつもりはないらしい。"},{"spoiler":false,"text":"面倒事を避ける傾向にあるが、その為に結城と付き合いだし、結果的に面倒事に巻き込まれてしまった。"}],"source":"bangumi","sourceCharacterId":"106764"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_bangumi_106765","characterName":"Onigawara Saburou","sourceIds":{"bangumi":[{"characterId":"106765","match":"source-roster","subjectId":"314039"},{"characterId":"106765","match":"source-roster","subjectId":"371701"},{"characterId":"106765","match":"source-roster","subjectId":"371709"}]},"originalCharacterName":"Onigawara Saburou","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヤンデレ男の娘シリーズのヒロインその2。"},{"spoiler":false,"text":"自分の事を「さーや」と愛称呼びする。"},{"spoiler":false,"text":"かつて最悪の地元不良であったが、現在は比較的丸くなっている様子。"},{"spoiler":false,"text":"今作では結城の「おままごと」に巻き込まれ、彼が近くにいる間は自我を失い「さーや」の役割を演じている。"},{"spoiler":false,"text":"初日に結城が外出した隙をついて、主人公に真実とこれから起こりかねない最悪の事態を告げる。"},{"spoiler":false,"text":"以降、主人公やその他を牽引する存在となる。"},{"spoiler":false,"text":"前作以上に鬼三郎の側面が大きく表出しており、自我が戻り主人公と2人の時はかなり口が悪い。"},{"spoiler":false,"text":"秋貴の事を「あーくん」と呼ぶ。"},{"spoiler":false,"text":"真の事は「馬鹿女」と呼ぶ。"}],"source":"bangumi","sourceCharacterId":"106765"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/feca514dc9edda22e111b1eeceed9a4e08b4c9844034d8900d34d3c5c77b92ac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/268087574c9abb59f4d71fd067955e0a7d6d2864dcf8e63055d7e65bd43d1276.webp","width":136,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:3975","sourceCompanyId":"egs:brand:3975","canonicalEntityId":"egs:brand:3975","name":"さふいずむ","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:25265:3975","source":"egs"},{"companyId":"vndb:p5181","sourceCompanyId":"vndb:p5181","canonicalEntityId":"vndb:p5181","name":"さふいずむ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:47418:v17942","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
