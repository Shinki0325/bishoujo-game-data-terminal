"57288","match":"exact-normalized-name-in-linked-work","subjectId":"221460"}],"egsCharacterIds":["17486"],"vndbCharacterId":"c66709"},"originalCharacterName":"ダルマ女","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A wheelchair-bound, limbless mass murderer who has weapons stowed within her prosthetic legs. Her modified wheelchair tops out at 50 KPH, allowing her to hunt her prey to the ends of the earth."},{"spoiler":false,"text":"She's become something of an urban legend in Tokyo"},{"spoiler":false,"text":"From Shiravuna, via MangaGamer"}],"source":"vndb","sourceCharacterId":"c66709"},{"segments":[{"spoiler":false,"text":"電動車椅子に乗った四肢のない女殺人鬼。"},{"spoiler":false,"text":"両腕両足は凶器類を内蔵した機械式のロボットアーム。"},{"spoiler":false,"text":"改造車椅子は最高時速５０キロで疾走し、狙った獲物をどこまでも追いかける。"},{"spoiler":false,"text":"都市伝説の化け物じみた存在。"}],"source":"egs","sourceCharacterId":"17486","sourceWorkId":"25299","spoiler":false},{"segments":[{"spoiler":false,"text":"電動車椅子に乗った四肢のない女殺人鬼。"},{"spoiler":false,"text":"両腕両足は凶器類を内蔵した機械式のロボットアーム。"},{"spoiler":false,"text":"改造車椅子は最高時速50キロで疾走し、狙った獲物をどこまでも追いかける。"},{"spoiler":false,"text":"都市伝説の化け物じみた存在。"}],"source":"bangumi","sourceCharacterId":"57288"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/774a5e0646abfc41bc42f6bd94cf68671549b2824de3a5f1cc008f820d891570.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/257a38a2edd1b3b5242fc2e4f1e885315ca9e106a9270fbe829dfbb15e307002.webp","width":127,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c81471","characterName":"暮坂 照","sourceIds":{"bangumi":[{"characterId":"70046","match":"exact-normalized-name-in-linked-work","subjectId":"270533"}],"egsCharacterIds":["21221"],"vndbCharacterId":"c81471"},"originalCharacterName":"暮坂 照","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Teru appears to be a fine, handsome man. His physical fitness and academic aptitude are above average, making him fairly popular with women. He's seen as a likable comic relief among male circles, often compared to the \"protagonist's best friend\" archetype in manga or anime."},{"spoiler":false,"text":"In actuality, Teru is a cunning liar and an egoist. He will lie through his teeth and exploit others remorselessly to elevate his position. He views this as the absolute rule of how the world works, and anyone who does not adhere to it is regarded as a despicable fool."},{"spoiler":false,"text":"\"Sleeping together means we should date? Come on, that's way too black and white.\""},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c81471"},{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"見た目はさわやかな雰囲気イケメン。学力、運動神経は中の上あたりでソツがない。自他ともに「漫画やアニメの主人公の親友キャラみたい」な立ち位置を任じる。"},{"spoiler":false,"text":"地の性格は狡猾な嘘つきでエゴイスト。自分がより良い立場に立つために、嘘をついたり他人を利用することに一切の躊躇いがない。むしろこの世はそうすることが当然のルールで、それができない人間を軽蔑すべき愚か者だと考えている。"}],"source":"egs","sourceCharacterId":"21221","sourceWorkId":"27614","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"見た目はさわやかな雰囲気イケメン。学力、運動神経は中の上あたり。"},{"spoiler":false,"text":"女子に結構モテる一方、男子グループ内では憎めない三枚目キャラとして、"},{"spoiler":false,"text":"「漫画やアニメの主人公の親友キャラみたい」な立ち位置を任じる。"},{"spoiler":false,"text":"地の性格は狡猾な嘘つきでエゴイスト。自分がより良い立場に立つために、"},{"spoiler":false,"text":"嘘をついたり他人を利用することに一切の躊躇が無い。"},{"spoiler":false,"text":"むしろこの世界はそうすることが当然のルールで、"},{"spoiler":false,"text":"それができない人間を軽蔑すべき愚か者だと考えている。"},{"spoiler":false,"text":"「セックスしたから付き合うって、短絡しすぎだろ。」"}],"source":"bangumi","sourceCharacterId":"70046"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/133ffc81b891568cd5648349b059c9ccd54b42f02f4a42597542b256a5d9d4e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6aa9de434e694a12b9b68bda5074882f5a157e4eee0b4116275798178fae6a9e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柊唯也","creatorId":"vndb:s3336","sourcePersonId":"vndb:s3336","canonicalEntityId":"vndb:s3336","name":"柊 唯也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:270533:70046:40168:1","source":"bangumi"}]},{"characterId":"char_c81472","characterName":"まおっち","sourceIds":{"bangumi":[{"characterId":"70047","match":"exact-normalized-name-in-linked-work","subjectId":"270533"}],"egsCharacterIds":["21222"],"vndbCharacterId":"c81472"},"originalCharacterName":"まおっち","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Teru's childhood friend."},{"spoiler":false,"text":"A raven-haired girl with piercing eyes and a fierce look."},{"spoiler":false,"text":"She's your classic justice warrior - hates lies, stands up for the underdog, can't stand any funny business, and isn't afraid to call it as she sees it."},{"spoiler":false,"text":"In any everyday world, she'd be the oddball everyone avoids, but somehow, she becomes the lovable class weirdo."},{"spoiler":false,"text":"Of course, plenty can't stand her \"holier-than-thou\" attitude. Teru, in particular, represents these individuals, making those two mix like oil and water."},{"spoiler":false,"text":"\"I knew you were a piece of work, but this is a new low! You man-whore! Absolute trash!\""},{"spoiler":false,"text":"Translated from the offical site"}],"source":"vndb","sourceCharacterId":"c81472"},{"segments":[{"spoiler":false,"text":"照の幼なじみ。"},{"spoiler":false,"text":"眼力が強く凛々しい顔立ちの黒髪女子。"},{"spoiler":false,"text":"嘘を嫌い、弱きを助け、曲がったことを許さず、それを声にすることを恐れない性格の持ち主。つまりは正義の味方。普通なら冷笑されたり孤立したりする変人タイプだが、周囲からそれなりに愛され名物キャラ的な立ち位置になっている。"},{"spoiler":false,"text":"もちろんそうした「真っ当な人間」を苦手に思う者も多く、主人公はその代表格であり、犬猿の仲。"}],"source":"egs","sourceCharacterId":"21222","sourceWorkId":"27614","spoiler":false},{"segments":[{"spoiler":false,"text":"照の幼なじみ。眼力が強く凛々しい顔立ちの黒髪女子。"},{"spoiler":false,"text":"嘘を嫌い、弱気を助け、曲がったことを許さず、"},{"spoiler":false,"text":"それを声にすることを恐れない性格の持ち主。つまりは正義の味方。"},{"spoiler":false,"text":"普通なら冷笑されたり孤立したりする変人タイプだが、"},{"spoiler":false,"text":"周囲からそれなりに愛され名物キャラ的な立ち位置になっている。"},{"spoiler":false,"text":"もちろんそうした「真っ当な人間」を苦手に思う者も多く、"},{"spoiler":false,"text":"照はその代表格であり、犬猿の仲。"},{"spoiler":false,"text":"「わかってたけど最低すぎ！ヤリチン野郎！クズ！」"}],"source":"bangumi","sourceCharacterId":"70047"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07eb11b0b9eca7ef063558a95a9443aa62ac3edc8750f959a4cf3f347f9fb203.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a8ab1bd6d3c9fc5c21eceeade425b0dd90d87932fe0e5fed0caceb0668c829f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"湯宮由海","creatorId":"vndb:s5006","sourcePersonId":"vndb:s5006","canonicalEntityId":"vndb:s5006","name":"湯宮 由海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:270533:70047:19558:1","source":"bangumi"}]},{"characterId":"char_c81473","characterName":"三峯 あいら","sourceIds":{"bangumi":[],"egsCharacterIds":["21223"],"vndbCharacterId":"c81473"},"originalCharacterName":"三峯 あいら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the \"dead\" who becomes an ally of Teru."},{"spoiler":false,"text":"A true gyaru through and through - bleached hair, dramatic eyes, and model height to boot. Her experience as a reader model isn't just for show - she's got the looks to back it up."},{"spoiler":false,"text":"Think street-smart meets a loyal friend - she's straightforward and rough around the edges but with a heart of gold. While she can work a room like nobody's business, don't expect her to win any vocabulary contests."},{"spoiler":false,"text":"\"You totally died today, didn't you? Somewhere out there.\""},{"spoiler":false,"text":"Translated from the offical site"}],"source":"vndb","sourceCharacterId":"c81473"},{"segments":[{"spoiler":false,"text":"照の仲間となる“死者”の一人。"},{"spoiler":false,"text":"明るい髪色にぱっちりアイメイクのわかりやすいギャル。高身長でスレンダー。スタイルがよく、読者モデル経験もある。"},{"spoiler":false,"text":"男前かつサバサバした大ざっぱな性格で、友情に篤いマイルドヤンキー気質。コミュ力は高いが語彙力は低い。"}],"source":"egs","sourceCharacterId":"21223","sourceWorkId":"27614","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/2365df3b41a4cb5658bd14df5290a0b20652574cd9febe3f5afffdd8c64369e8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31828a276073a88336870669f04263738c44bef2aae739cd25cd2786834ca6f0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉 みづき","creatorId":"vndb:s18363","sourcePersonId":"vndb:s18363","canonicalEntityId":"vndb:s18363","name":"青葉 みづき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80331","source":"vndb"}]},{"characterId":"char_c81474","characterName":"布良 麻奈美","sourceIds":{"bangumi":[{"characterId":"70049","match":"exact-normalized-name-in-linked-work","subjectId":"270533"}],"egsCharacterIds":["21224"],"vndbCharacterId":"c81474"},"originalCharacterName":"布良 麻奈美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"26"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the \"dead\" who became Teru's companion."},{"spoiler":false,"text":"A mid-twenties wife with a child. She has a baby face, a large bust, and a gentle and inclusive character. She dislikes conflict and is weak when it comes to violence and seeing blood."},{"spoiler":false,"text":"During the day, while her child is at the daycare, she works part-time, as both she and her husband are working. She loves her husband and child and is very faithful."},{"spoiler":false,"text":"\"Count me out... We're talking about murder here, aren't we?\""},{"spoiler":false,"text":"Translated from the offical site"}],"source":"vndb","sourceCharacterId":"c81474"},{"segments":[{"spoiler":false,"text":"照の仲間となる“死者”の一人。"},{"spoiler":false,"text":"20代半ばの子持ち主婦。童顔で巨乳。"},{"spoiler":false,"text":"温和で包容力がある性格。争いごとが嫌いで暴力や血を見るのは苦手。"},{"spoiler":false,"text":"夫婦共働きで、子供を保育所に預けている昼間はパートの仕事をしている。夫と子供を愛しており、身持ちは非常に固い。"}],"source":"egs","sourceCharacterId":"21224","sourceWorkId":"27614","spoiler":false},{"segments":[{"spoiler":false,"text":"照の仲間となる “死者” の一人。20代半ばの子持ち主婦。童顔で巨乳。"},{"spoiler":false,"text":"温和で包容力がある性格。争いごとが嫌いで暴力や血を見るのが苦手。"},{"spoiler":false,"text":"夫婦共働きで、子供を保育所に預けている昼間はパートの仕事をしている。"},{"spoiler":false,"text":"夫と子供を愛しており、身持ちは非常に固い。"},{"spoiler":false,"text":"「私は嫌よ……だって、殺すとか殺さないとかいう話なんでしょ？」"}],"source":"bangumi","sourceCharacterId":"70049"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fca5025d9305663dc471d2e26d1175a0e8aa3e47022a91b1711c4e78059d240e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4439ecd837295a19189