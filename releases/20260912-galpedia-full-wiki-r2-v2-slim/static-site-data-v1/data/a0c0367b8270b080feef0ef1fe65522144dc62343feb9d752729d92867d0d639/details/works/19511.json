:false},{"segments":[{"spoiler":false,"text":"聖堂学園1年。"},{"spoiler":false,"text":"天摩家の次女。といっても、本家の人間ではない。本家の人間は、16年ほど前に事故で死亡している。"},{"spoiler":false,"text":"厳一郎の娘の娘であり、つまり孫娘。母親が離婚して天摩家に出戻りしたため、天摩家の屋敷で暮らしている。"},{"spoiler":false,"text":"実は悪魔。ある期日までに人間の魂を奪わないと人間の姿に戻れず、悪魔の姿のままになってしまうらしい。"},{"spoiler":false,"text":"「人のことをそのようにからかうのは、よくなくってよ」"}],"source":"bangumi","sourceCharacterId":"45355"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd2d4d2c76958180c4daa304d64954aecdd7525414896e899324efa82515a017.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0e0ee5edf13628f5128d8f54142f3d4153c4e0520d8d611925bb78db22c2166.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽月理恵","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79404:45355:5907:1","source":"bangumi"}]},{"characterId":"char_c28137","characterName":"天摩 優里亜","sourceIds":{"bangumi":[{"characterId":"45356","match":"exact-normalized-name-in-linked-work","subjectId":"79404"}],"egsCharacterIds":["12470"],"vndbCharacterId":"c28137"},"originalCharacterName":"天摩 優里亜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"928"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"105"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"K"},"height":{"reviewState":"no-conflict","source":"vndb","value":"175"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"63"}},"descriptions":[{"segments":[{"s