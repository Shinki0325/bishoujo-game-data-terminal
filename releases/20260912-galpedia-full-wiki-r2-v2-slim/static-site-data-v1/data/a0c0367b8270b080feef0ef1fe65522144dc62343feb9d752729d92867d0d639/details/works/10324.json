ntityStatus":"source-native","relationId":"vndb:vn-staff:19507","source":"vndb"},{"creditedName":"八月朔日 珈瑠","creatorId":"vndb:s4915","sourcePersonId":"vndb:s4915","canonicalEntityId":"vndb:s4915","name":"八月朔日珈瑠","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:19511","source":"vndb"},{"creditedName":"剣蔵","creatorId":"vndb:s9083","sourcePersonId":"vndb:s9083","canonicalEntityId":"vndb:s9083","name":"村雨 剣蔵","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:19512","source":"vndb"},{"creditedName":"漣 枕","creatorId":"vndb:s9828","sourcePersonId":"vndb:s9828","canonicalEntityId":"vndb:s9828","name":"漣 枕","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:19513","source":"vndb"},{"creditedName":"すなすな","creatorId":"vndb:s10375","sourcePersonId":"vndb:s10375","canonicalEntityId":"vndb:s10375","name":"すなすな","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:19514","source":"vndb"}]},"cast":[{"characterId":"char_c25964","characterName":"芹宮 蓉子","sourceIds":{"bangumi":[{"characterId":"61603","match":"exact-normalized-name-in-linked-work","subjectId":"114963"},{"characterId":"61603","match":"exact-normalized-name-in-linked-work","subjectId":"114964"}],"egsCharacterIds":["6100"],"vndbCharacterId":"c25964"},"originalCharacterName":"芹宮 蓉子","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"おっとりとした優しげな印象、楚々として貞淑な雰囲気を醸し出すメインヒロイン。"},{"spoiler":false,"text":"学生時代から今の夫と付き合っていて、夫以外の男を知らない、今どき珍しくウブで貞操観念が強い。"},{"spoiler":false,"text":"そのため、セックスレスになった夫のせいで溜まった性欲を自慰で沈めていた所を亮人に盗撮され、肉体関係を迫られることに。"},{"spoiler":false,"text":"正常位しか知らない彼女にとって、亮人が要求する破廉恥なセックスはあまりに刺激的すぎて、徐々に肉欲の牝へと豹変していく。"}],"source":"egs","sourceCharacterId":"6100","sourceWorkId":"10324","spoiler":false},{"segments":[{"spoiler":false,"text":"目尻が垂れ気味で、おっとりした印象と清楚な雰囲気を漂わせる貞淑な人妻。"},{"spoiler":false,"text":"愛する夫と息子の三人で暮らしている近所でも評判の美人妻。"},{"spoiler":false,"text":"学生時代より夫・昌彦と付き合っていて、生まれてこの方昌彦以外の男を知らない。"},{"spoiler":false,"text":"お嬢様育ちだった為か貞操観念が強く、夫である昌彦との性生活が、すっかり無くなってしまった今でも不倫などは考えられない。"},{"spoiler":false,"text":"かと言って昌彦に無理矢理セックスを迫るような事も恥ずかしくて出来ないので、夫や息子が家を出た後に拙い自慰に耽って自分を満足させている。"},{"spoiler":false,"text":"だがしかし、ある日そんな様子を一志の友人“亮人”に盗撮され肉体関係を強要されてしまう。"},{"spoiler":false,"text":"初めは弱々しく抵抗する蓉子だが、正常位しか知らないようなセックスしかして来なかった、清楚な妻に次々と向けられる亮人の破廉恥な要求は余りに刺激が強く、息子と同い年の少年の欲望を受け止める内に蓉子は徐々に徐々に妻の顔を忘れ、そして母の顔を忘れ、一匹の牝へと変貌していく。"}],"source":"egs","sourceCharacterId":"6100","sourceWorkId":"21078","spoiler":false},{"segments":[{"spoiler":false,"text":"目尻が垂れ気味で、おっとりした印象と清楚な雰囲気を漂わせる貞淑な人妻。愛する夫と息子の三人で暮らしている近所でも評判の美人妻。学生時代より夫・昌彦と付き合っていて、生まれてこの方昌彦以外の男を知らない。お嬢様育ちだった為か貞操観念が強く、夫である昌彦との性生活がすっかり無くなってしまった今でも不倫などは考えられない"},{"spoiler":false,"text":"かと言って昌彦に無理矢理セックスを迫るような事も恥ずかしくて出来ないので、夫や息子が家を出た後に拙い自慰に耽って自分を満足させている。ある日そんな様子を一志の友人“亮人”に盗撮され肉体関係を強要されてしまう。 初めは弱々しく抵抗する蓉子だが、正常位しか知らないようなセックスしかしてこなかった清楚な妻に次々と向けられる亮人の破廉恥な要求は余りに刺激が強く、息子と同い年の少年の欲望を受け止める内に蓉子は徐々に徐々に妻の顔を忘れ、そして母の顔を忘れ、一匹の牝へと変貌していく。"}],"source":"bangumi","sourceCharacterId":"61603"}],"profileFacts":[{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"6100","sourceWorkId":"10324","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"6100","sourceWorkId":"10324","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"6100","sourceWorkId":"10324","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"6100","sourceWorkId":"10324","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"48 kg","valueContext":null,"source":"egs","sourceCharacterId":"6100","sourceWorkId":"10324","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d905b7915cb34b3490271c680d95828636adab0c7859ea7b6d5bf238c6b38560.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc5e20d09d440c77930ca8a5f5471f1ebf41336b92f664fb17811fd3972f7701.webp","width":149,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あらいしずか","creatorId":"vndb:s665","sourcePersonId":"vndb:s665","canonicalEntityId":"vndb:s665","name":"あらい しずか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:114963:61603:4647:1","source":"bangumi"}]},{"characterId":"char_c25965","characterName":"巳塚　操","sourceIds":{"bangumi":[{"characterId":"61604","match":"exact-normalized-name-in-linked-work","subjectId":"114963"},{"characterId":"61604","match":"exact-normalized-name-in-linked-work","subjectId":"114964"}],"egsCharacterIds":["6101"],"vndbCharacterId":"c25965"},"originalCharacterName":"巳塚　操","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"亮人の義母で、知的でお堅い雰囲気を漂わせる美人妻。"},{"spoiler":false,"text":"いつも無愛想で不機嫌そうにしているため、友人の母でありながら、一志は彼女が苦手。"},{"spoiler":false,"text":"その見た目通り、独身時代はバリバリ仕事をこなすキャリアウーマンで、元凄腕の検事だったらしい。"}],"source":"egs","sourceCharacterId":"6101","sourceWorkId":"10324","spoiler":false},{"segments":[{"spoiler":false,"text":"肩の上で切り揃えた髪は茶色掛かっているが、染めている訳ではなく天然。日本人以外の血が混じっているらしく、余りアジア系の顔立ちではない知的な雰囲気を漂わせる美人。"},{"spoiler":false,"text":"亮人の義母で、血は繋がっていない。"},{"spoiler":false,"text":"いつも無愛想で不機嫌そうにしているので、一志は苦手としている。"},{"spoiler":false,"text":"その見た目に反せず独身時代はバリバリのキャリアウーマンで、元腕利きの検事（結婚と同時に退職している）。"},{"spoiler":false,"text":"過去、何度か法廷で敵として父親である昌彦と顔を会わせたことがあるという事実も、一志の苦手意識に拍車を掛けている。"}],"source":"egs","sourceCharacterId":"6101","sourceWorkId":"21078","spoiler":false},{"segments":[{"spoiler":false,"text":"肩の上で切り揃えた髪は茶色掛かっているが、染めている訳ではなく天然。日本人以外の血が混じっているらしく、余りアジア系の顔立ちではない知的な雰囲気を漂わせる美人。亮人の義母で、血は繋がっていない。いつも無愛想で不機嫌そうにしているので、一志は苦手としている。"},{"spoiler":false,"text":"その見た目に反せず独身時代はバリバリのキャリアウーマンで、元腕利きの検事（結婚と同時に退職している）。過去、何度か法廷で敵として父親である昌彦と顔を会わせたことがあるという事実も、一志の苦手意識に拍車を掛けている。"}],"source":"bangumi","sourceCharacterId":"61604"}],"profileFacts":[{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"6101","sourceWorkId":"10324","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"6101","sourceWorkId":"10324","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"6101","sourceWorkId":"10324","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"6101","sourceWorkId":"10324","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"50 kg","valueContext":null,"source":"egs","sourceCharacterId":"6101","sourceWorkId":"10324","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a073cfd04a9c5bacbea0f16507cc3066ad57b04395639c564a49ddeb15bff3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96a57d13c109a20d68d26ec70f1161018a1e9366b416f90a9bd2002776fef7e2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MARIO","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:114963:61604:4918:1","source":"bangumi"}]},{"characterId":"char_c25966","characterName":"巳塚 亮人","sourceIds":{"bangumi":[{"characterId":"89408","match":"exact-normalized-name-in-linked-work","subjectId":"114963"},{"characterId":"89408","match":"exact-normalized-name-in-linked-work","subjectId":"114964"}],"egsCharacterIds":["6102"],"vndbCharacterId":"c25966"},"originalCharacterName":"巳塚 亮人","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"一志の同級生で、何度か家に遊びに来たことのある少年。"},{"spoiler":false,"text":"中性的で、整った顔立ちの持ち主。"},{"spoiler":false,"text":"虫も殺さないような顔をして、自分の生活圏内にいる目をつけた女性を襲い、犯し、奴隷としたてあげる悪魔のような少年。"},{"spoiler":false,"text":"手持ちの奴隷に飽きてきた頃に蓉子と出会い、一目でその円熟した美貌の虜になる。"},{"spoiler":false,"text":"蓉子の弱みを握る為に芹宮家の寝室やトイレやリビングに盗聴器や隠しカメラを取り付けていて、トイレで自慰に耽る蓉子の姿を撮影する事に成功する。"},{"spoiler":false,"text":"それをネタに蓉子を凌辱し、自らの奴隷とするべく調教を開始する。"}],"source":"egs","sourceCharacterId":"6102","sourceWorkId":"21078","spoiler":false},{"segments":[{"spoiler":false,"text":"一志の同級生で、何度か家に遊びに来たことのある少年。中性的で、整った顔立ちの持ち主。"},{"spoiler":false,"text":"虫も殺さないような顔をして、自分の生活圏内にいる目をつけた女性を襲い、犯し、奴○としたてあげる悪魔のような少年。手持ちの奴○に飽きてきた頃に蓉子と出会い、一目でその円熟した美貌の虜になる。蓉子の弱みを握る為に芹宮家の寝室やトイレやリビングに盗聴器や隠しカメラを取り付けていて、トイレで自慰に耽る蓉子の姿を撮影する事に成功する。それをネタに蓉子を○辱し、自らの奴○とするべく調教を開始する。"}],"source":"bangumi","sourceCharacterId":"89408"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d56a0223678fd2c3b04d76689028855c4af85614540c537a87fb2a1b5f8c358.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae88067a7f3b3a820a86319d9d692dcd400cb0b1ff3479025f4e5f322c7b9cef.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c25967","characterName":"芹宮 一志","sourceIds":{"bangumi":[{"characterId":"89409","match":"exact-normalized-name-in-linked-work","subjectId":"114963"},{"characterId":"89409","match":"exact-normalized-name-in-linked-work","subjectId":"114964"}],"egsCharacterIds":["6103"],"vndbCharacterId":"c25967"},"originalCharacterName":"芹宮 一志","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"名私立学園に通う蓉子と昌彦自慢の息子。"},{"spoiler":false,"text":"少々内気な所もあるものの、昌彦と蓉子の性格を受け継いだ心優しい少年。"},{"spoiler":false,"text":"子犬っぽい外見からか年上の女性に人気があるらしいが、特定の異性と付き合っているという話は聞かない。"},{"spoiler":false,"text":"蓉子に仄かな恋愛感情を抱いているが、その異常性に気付いているので苦しんでいる。"}],"source":"egs","sourceCharacterId":"6103","sourceWorkId":"21078","spoiler":false},{"segments":[{"spoiler":false,"text":"有名私立学園に通う蓉子と昌彦自慢の息子。少々内気な所もあるものの、昌彦と蓉子の性格を受け継いだ心優しい少年。子犬っぽい外見からか年上の女性に人気があるらしいが、特定の異性と付き合っているという話は聞かない。"},{"spoiler":false,"text":"蓉子に仄かな恋愛感情を抱いているが、その異常性に気付いているので苦しんでいる。"}],"source":"bangumi","sourceCharacterId":"89409"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/3248