"relationId":"vndb:vn-staff:38390","source":"vndb"},{"creditedName":"dsp2003","creatorId":"vndb:s45769","sourcePersonId":"vndb:s45769","canonicalEntityId":"vndb:s45769","name":"dsp2003","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:38391","source":"vndb"},{"creditedName":"eyeless","creatorId":"vndb:s54921","sourcePersonId":"vndb:s54921","canonicalEntityId":"vndb:s54921","name":"eyeless","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:38392","source":"vndb"}]},"cast":[{"characterId":"char_c21869","characterName":"レイミア=ヒュギエイア","sourceIds":{"bangumi":[{"characterId":"53162","match":"exact-normalized-name-in-linked-work","subjectId":"180891"}],"egsCharacterIds":["14425"],"vndbCharacterId":"c21869"},"originalCharacterName":"レイミア=ヒュギエイア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"一人前と認めてもらうために、主人公を籠絡しようとする蛇娘。"},{"spoiler":false,"text":"幼いころ、出会った主人公ことが忘れられず、一族の風習にかこつけて彼の家に押しかけた。"},{"spoiler":false,"text":"ただ、プライドが高いため人間に惚れているという事実が認められず、主人公に対してはツンケンした態度をとってしまう。"},{"spoiler":false,"text":"怒ったり照れたり、嬉しかったり悲しかったり……ちょっとした感情を表現するためことあるごとに主人公を尻尾で締め付けたり、石化したりする可愛らしい（？）女の子。"}],"source":"egs","sourceCharacterId":"14425","sourceWorkId":"13029","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公を籠絡しようとする蛇娘。"},{"spoiler":false,"text":"幼少の頃主人公と出会っており、それ以来なにかと主人公のことが気になっている。"},{"spoiler":false,"text":"主人公の側にいたいがため、一族の風習にかこつけて押しかけてくる。"},{"spoiler":false,"text":"ただ、プライドが高いため、主人公に対してはツンケンした態度をとってしまう、素直になれない女の子。"},{"spoiler":false,"text":"怒ったり照れたり、嬉しかったり悲しかったり、ちょっとした感情を表現するためことあるごとに主人公を尻尾で締め付けたり、石化させたりする可愛らしい（？）女の子。"},{"spoiler":false,"text":"「す、好きだなんて勘違いしないでよねっ！　し、仕方なく……そう！　仕方なくなんだから！」"}],"source":"bangumi","sourceCharacterId":"53162"}],"profileFacts":[{"label":"種族","source":"bangumi","sourceCharacterId":"53162","value":"ラミア"},{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"14425","sourceWorkId":"13029","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"14425","sourceWorkId":"13029","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"14425","sourceWorkId":"13029","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"14425","sourceWorkId":"13029","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f912e3b5b2869d066254f2b66314bd29bf9fa2dad400deed474846a5c7f922f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a42171decb56afdb545dbc75f66596fcc2164e5589d149eface664a12d0c5d37.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:180891:53162:5922:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p813","sourceCompanyId":"egs:brand:2737","canonicalEntityId":"vndb:p813","name":"Vanadis","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:13029:2737","source":"egs"},{"companyId":"vndb:p813","sourceCompanyId":"vndb:p813","canonicalEntityId":"vndb:p813","name":"Vanadis","roleC