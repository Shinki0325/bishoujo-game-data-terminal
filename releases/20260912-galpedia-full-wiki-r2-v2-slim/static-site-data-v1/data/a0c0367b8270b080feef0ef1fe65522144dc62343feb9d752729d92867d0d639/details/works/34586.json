racterId":"132497"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_c128281","characterName":"橘 鈴魚","sourceIds":{"bangumi":[{"characterId":"133634","match":"exact-normalized-name-in-linked-work","subjectId":"443582"}],"egsCharacterIds":["24765"],"vndbCharacterId":"c128281"},"originalCharacterName":"橘 鈴魚","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"728"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the younger sister of and successor to Aina, the current mermaid princess."},{"spoiler":false,"text":"On the surface, she is a bit of a brat, but in reality, she is a kind and caring girl."},{"spoiler":false,"text":"Actually, she is surprisingly whiny and spoiled."},{"spoiler":false,"text":"She can do anything she puts her mind to, and she is willing to work hard."},{"spoiler":false,"text":"She is also the type who hates showing her efforts to others."},{"spoiler":false,"text":"translated from official website"}],"source":"vndb","sourceCharacterId":"c128281"},{"segments":[{"spoiler":false,"text":"藍魚の妹であり、その後を継いだ現人魚姫。"},{"spoiler":false,"text":"表面上はツンツンしているが、本当は優しくて気遣いのできる少女。"},{"spoiler":false,"text":"実は、意外に泣き虫で甘えん坊。"},{"spoiler":false,"text":"何でも器用にできる上に、努力も惜しまない。"},{"spoiler":false,"text":"そして、その努力を他人に見せるのを嫌がるタイプでもある。"}],"source":"egs","sourceCharacterId":"24765","sourceWorkId":"34586","spoiler":false},{"segments":[{"spoiler":false,"text":"藍魚の妹であり、その後を継いだ現人魚姫。"},{"spoiler":false,"text":"表面上はツンツンしているが、"},{"spoiler":false,"text":"実際には優しくて気遣いのできる少女。"},{"spoiler":false,"text":"何でも器用にできる上に、努力も惜しまない性格。"},{"spoiler":false,"text":"そして、その努力を他人に見せるのを嫌がるタイプでもある。"},{"spoiler":false,"text":"意外に甘えん坊で泣き虫だったりする。"},{"spoiler":false,"text":"甘える対象は当然ながら、姉である藍魚。"},{"spoiler":false,"text":"本人としては用心深い性格をしていると思っているが、"},{"spoiler":false,"text":"実は姉に似てドジなところがある。"}],"source":"bangumi","sourceCharacterId":"133634"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"133634","value":"ヘヴィメタル・ホラー映画・写真撮影"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"133634","value":"他人を見下す人・南逢瀬町ｄｉｓ"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca19bd6a172af74eebf67ca0e5f2b660269c4b566979c70b2d0b5e193813c3d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8a778821f8c1ccb2c9984bdcacbe11cffbc98a091ef96a5a7c0108c783df56e.webp","width":191,"height":256,"source":"static-detail"},"actors":[{"creditedName":"益子優衣","creatorId":"vndb:s25620","sourcePersonId":"vndb:s25620","canonicalEntityId":"vndb:s25620","name":"益子 優衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:443582:133634:49384:1","source":"bangumi"}]},{"characterId":"char_c128282","characterName":"大和 綾音","sourceIds":{"bangumi":[{"characterId":"133635","match":"exact-normalized-name-in-linked-work","subjectId":"443582"}],"egsCharacterIds":["24767"],"vndbCharacterId":"c128282"},"originalCharacterName":"大和 綾音","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An old friend of the protagonists who has since passed away."},{"spoiler":false,"text":"She has been gone for ten years, but her presence has had a great impact on them all."},{"spoiler":false,"text":"She had an innocent and strong personality, and was regarded as the leader of the village children."},{"spoiler":false,"text":"translated from official website"}],"source":"vndb","sourceCharacterId":"c128282"},{"segments":[{"spoiler":false,"text":"主人公たちの古くからの友人であり故人。"},{"spoiler":false,"text":"十年前にいなくなった彼女の存在は、彼らに大きな影響を与えている。"},{"spoiler":false,"text":"性格は天真爛漫で押しが強く、村の子供たちのリーダー的存在だった。"}],"source":"egs","sourceCharacterId":"24767","sourceWorkId":"34586","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公たちの古くからの友人であり故人。"},{"spoiler":false,"text":"十年前にいなくなった彼女の存在は、"},{"spoiler":false,"text":"彼らに大きな影響を与えている。"},{"spoiler":false,"text":"正確は天真爛漫で押しが強く、"},{"spoiler":false,"text":"子供たちのリーダー的存在だった。"}],"source":"bangumi","sourceCharacterId":"133635"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:443582:133635:10026:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p5914","sourceCompanyId":"egs:brand:4805","canonicalEntityId":"vndb:p5914","name":"Wonder Fool","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:34586:4805","source":"egs"},{"companyId":"vndb:p5914","sourceCompanyId":"vndb:p5914","canonicalEntityId":"vndb:p5914","name":"Wonder Fool","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:120060:v45561","source":"vndb"},{"companyId":"vndb:p19661","sourceCompanyId":"vndb:p19661","canonicalEntityId":"vndb:p19661","name":"樱和亭汉化组","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:120808:v45561","source":"vndb"},{"companyId":"vndb:p5914","sourceCompanyId":"vndb:p5914","canonicalEntityId":"vndb:p5914","name":"Wonder Fool","roleCodes":["develo