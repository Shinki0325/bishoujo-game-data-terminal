{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"11214","model":{"presentationWorkId":"vndb:v1124","staff":{"artwork":[{"creditedName":"相川亜利砂(あいかわ亜利砂)","creatorId":"vndb:s2040","sourcePersonId":"egs:creator:142","canonicalEntityId":"vndb:s2040","name":"相川亜利砂(あいかわ亜利砂)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:70072","source":"egs"}],"scenario":[{"creditedName":"酒井童人(毒枝佳果)","creatorId":"vndb:s635","sourcePersonId":"egs:creator:2256","canonicalEntityId":"vndb:s635","name":"酒井童人(毒枝佳果)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:70073","source":"egs"},{"creditedName":"若林浩太郎(鏃キロク)","creatorId":"vndb:s2555","sourcePersonId":"egs:creator:2257","canonicalEntityId":"vndb:s2555","name":"若林浩太郎(鏃キロク)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:70074","source":"egs"},{"creditedName":"尾崎貞夫(小田崎コウ)","creatorId":"vndb:s2967","sourcePersonId":"egs:creator:2225","canonicalEntityId":"vndb:s2967","name":"尾崎貞夫(小田崎コウ)","detail":"リゼット＝ケッセルリンク","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:70075","source":"egs"},{"creditedName":"ひらいでらく(かすか量)","creatorId":"vndb:s2502","sourcePersonId":"egs:creator:1235","canonicalEntityId":"vndb:s2502","name":"ひらいでらく(かすか量)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:70076","source":"egs"}],"music":[{"creditedName":"どんまる","creatorId":"vndb:s1454","sourcePersonId":"egs:creator:6872","canonicalEntityId":"vndb:s1454","name":"どんまる","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:70077","source":"egs"}],"other":[{"creditedName":"馬場隆博(BABA.DOS)","creatorId":"vndb:s6956","sourcePersonId":"egs:creator:4576","canonicalEntityId":"vndb:s6956","name":"馬場隆博(BABA.DOS)","detail":"エグゼクティブプロデューサー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:127224","source":"egs"},{"creditedName":"丘野塔也(天雲玄樹)","creatorId":"vndb:s3805","sourcePersonId":"egs:creator:1627","canonicalEntityId":"vndb:s3805","name":"丘野塔也(天雲玄樹)","detail":"ゲームデザイン、ディレクター","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:70083","source":"egs"},{"creditedName":"丘野 塔也","creatorId":"vndb:s3805","sourcePersonId":"vndb:s3805","canonicalEntityId":"vndb:s3805","name":"天雲 玄樹","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:20275","source":"vndb"},{"creditedName":"丘野 塔也","creatorId":"vndb:s3805","sourcePersonId":"vndb:s3805","canonicalEntityId":"vndb:s3805","name":"天雲 玄樹","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:20276","source":"vndb"},{"creditedName":"馬場 隆博","creatorId":"vndb:s6956","sourcePersonId":"vndb:s6956","canonicalEntityId":"vndb:s6956","name":"馬場 隆博","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:20277","source":"vndb"}]},"cast":[{"characterId":"char_c67056","characterName":"ユーリ","sourceIds":{"bangumi":[{"characterId":"151253","match":"exact-normalized-name-in-linked-work","subjectId":"82162"}],"egsCharacterIds":["17342"],"vndbCharacterId":"c67056"},"originalCharacterName":"ユーリ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Main character. Also known as Yuri."},{"spoiler":false,"text":"He has been prejudiced from an early age, and his character is completely distorted, extremely self-centered, and selfish. He will do whatever it takes to fulfill his desires, but he is not always thorough and often makes mistakes."},{"spoiler":false,"text":"He is also a petty person, and when he makes a mistake, he is unusually quick to run away from it."},{"spoiler":false,"text":"He became tired of life in the royal family and left the country as soon as he came of age at the age of 15. He was a carefree adventurer, relying on his swordsmanship, when he heard that the king was to be elected, he returned home."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c67056"},{"segments":[{"spoiler":false,"text":"「キングダム」王家第二王子で、本作の主人公。"},{"spoiler":false,"text":"通称“ユーリ”。"},{"spoiler":false,"text":"妾の子として生まれたため、幼少から王族で不遇を強いられ、すっかり性格が歪む。"},{"spoiler":false,"text":"極めて自己中心的でワガママ。計算高く、欲望に正直で手段を選ばない。"},{"spoiler":false,"text":"反面、非常に心根が弱く、小物風情を漂わせる。逃げ足が異常に早い。"},{"spoiler":false,"text":"王家の生活に嫌気がさし、15歳で成人すると同時に出奔。"},{"spoiler":false,"text":"気ままな冒険家業を生きていたが、次期国王選出の話を聞いて舞い戻る。"}],"source":"egs","sourceCharacterId":"17342","sourceWorkId":"11214","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公。通称・ユーリ。"},{"spoiler":false,"text":"妾の子として生まれ、幼い頃から偏見を受けて育ったため人間性はすっかり歪み、極めて自己中心的でワガママな性格になってしまった。"},{"spoiler":false,"text":"計算高く、己の欲望を満たすためには手段を選ばないが、詰めが甘く失敗することも多い。"},{"spoiler":false,"text":"小心者で小物的な所もあり、失敗した時の逃げ足は異常に早い。"},{"spoiler":false,"text":"王家での生活に嫌気がさし、15歳で成人すると同時に出奔。"},{"spoiler":false,"text":"剣の腕を頼りに気ままな冒険者稼業をしていたが、次期国王選出の話を聞きつけ、帰還する。"}],"source":"bangumi","sourceCharacterId":"151253"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c67056","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"17342","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"17342","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"151253","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2c682c10aa73be4d605f780b1dd546330baffa8a177c45b50c3532c4b6ab1b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/2467d9672a8dd4f8cf861930f76e5be29b48f2cc7ba2a6380d1d0fdf45ec9daa.webp","width":109,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c67057","characterName":"リタ＝エルランド","sourceIds":{"bangumi":[{"characterId":"144769","match":"exact-normalized-name-in-linked-work","subjectId":"82162"}],"egsCharacterIds":["17337"],"vndbCharacterId":"c67057"},"originalCharacterName":"リタ＝エルランド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a virtuous, pure and innocent princess. She strongly believes that “a noble must do her duty,” and from her early childhood, she has taken the initiative in being taught to be a priestess."},{"spoiler":false,"text":"She often gives priority to serving her people as a priestess over her position as a princess, which annoys her aides every time she does so."},{"spoiler":false,"text":"While she is a strict disciplinarian herself, she is also tolerant of others and treats everyone with respect. Because of her personality, she is respected as a saint by her subordinates and the people."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c67057"},{"segments":[{"spoiler":false,"text":"東の大国、聖教の国エルランドの女王。"},{"spoiler":false,"text":"「高貴なものは、義務を果たさなければならない」がモットーで、幼少より人々に奉仕する司祭の教えを受ける。"},{"spoiler":false,"text":"王女よりも司祭として人々のことを考えて行動する、高潔で純真なお姫様。"},{"spoiler":false,"text":"自分に厳しく、他人に寛容で、わけ隔てなく接することから国中で“聖女”と慕われる。"}],"source":"egs","sourceCharacterId":"17337","sourceWorkId":"11214","spoiler":false},{"segments":[{"spoiler":false,"text":"高潔で純心無垢なお姫さま。"},{"spoiler":false,"text":"『高貴な者は、義務を果たさなければならない』と強く考えており、幼い頃から率先して司祭としての教えを受ける。"},{"spoiler":false,"text":"王女としての立場よりも、司祭として民への奉仕を優先させてしまうことも多く、その度に側近の頭を悩ませている。"},{"spoiler":false,"text":"自分自身を日々厳しく律する反面、他人に対しては寛容で誰に対しても分け隔てなく丁寧に接する。"},{"spoiler":false,"text":"そんな人柄のおかげで、部下や国民からは聖女と敬われている。"}],"source":"bangumi","sourceCharacterId":"144769"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/935a6d8255be6f9fe9e6bf4668ae86b1b8e2d251ad87b0918034e95a1e18fa46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c19343663f166aeea857e3f357529b2de08b12f5d52a71cea770c4b2a30a23c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"比未子","creatorId":"vndb:s1499","sourcePersonId":"vndb:s1499","canonicalEntityId":"vndb:s1499","name":"比未子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:82162:144769:18171:1","source":"bangumi"}]},{"characterId":"char_c67058","characterName":"ヘンリエッタ＝ル・ノーブル","sourceIds":{"bangumi":[{"characterId":"144770","match":"exact-normalized-name-in-linked-work","subjectId":"82162"}],"egsCharacterIds":["17338"],"vndbCharacterId":"c67058"},"originalCharacterName":"ヘンリエッタ＝ル・ノーブル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Dressed in luxurious clothes, with a maid of honor at her side, she is a super rich princess living in a luxurious palace. She is also selfish and high spirited."},{"spoiler":false,"text":"She hates when things don't go her way, and is a constant source of annoyance to her entourage. She also believes that she is the most beautiful woman in the world and that no man can resist her charms."},{"spoiler":false,"text":"She happens to meet Kristof at a party and falls in love with him at first sight. Angry that he is not taken in by her good looks, she takes matters into her own hands and takes Kristof captive."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c67058"},{"segments":[{"spoiler":false,"text":"北の大国である貴族の国「ル・ノーブル」の王女。"},{"spoiler":false,"text":"豪華な服に、大勢の侍女と立派な宮殿暮らし。まさに絵に描いたようなお姫様。"},{"spoiler":false,"text":"贅沢に育ったのでワガママで高飛車。自尊心も強く、自分の美貌を世界一と誇る。"},{"spoiler":false,"text":"当然、男の目線はすべて自分に向いていると思っている。"},{"spoiler":false,"text":"しかし、主人公の兄クリストフに一目ぼれし、軍を動かし捕虜にしてしまう。"}],"source":"egs","sourceCharacterId":"17338","sourceWorkId":"11214","spoiler":false},{"segments":[{"spoiler":false,"text":"豪華な服を身に纏い、侍女を侍らせ、豪華な宮殿に暮らすスーパーリッチなお姫さま。"},{"spoiler":false,"text":"性格もワガママで高飛車。思い通りにいかないことが大嫌い。"},{"spoiler":false,"text":"また自分の美貌は天下一だと思っており、跪かない男はいないと考えている。"},{"spoiler":false,"text":"たまたまパーティーで会ったクリストフに一目惚れ。自身の美貌になびかないことに腹を立て、軍を勝手に動かしクリストフを捕虜にしてしまう。"}],"source":"bangumi","sourceCharacterId":"144770"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4091935be2f780575b388774e963c1733464514428e9e2c6992f4964f128f3c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fb9eec1e4c79f8f08e9ab5f179c6528b42f1d7f32bcf6e5d271d38e1baf7778.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻レオナ","creatorId":"vndb:s7025","sourcePersonId":"vndb:s7025","canonicalEntityId":"vndb:s7025","name":"櫻レオナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:82162:144770:29845:1","source":"bangumi"}]},{"characterId":"char_c67059","characterName":"リゼット＝ケッセルリンク","sourceIds":{"bangumi":[{"characterId":"144771","match":"exact-normalized-name-in-linked-work","subjectId":"82162"}],"egsCharacterIds":["17339"],"vndbCharacterId":"c67059"},"originalCharacterName":"リゼット＝ケッセルリンク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the best magician in the kingdom, born with a genius mind and powerful magical powers."},{"spoiler":false,"text":"She is characterized by her cold eyes and inorganic facial expression, and emits an aura that does not allow others to approach her. Her speech is stiff and she is not very good at expressing her emotions."},{"spoiler":false,"text":"She is always absorbed in her research and quietly explodes with passionate anger when disturbed. She is on a mission and sees life as somewhat ephemeral."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c67059"},{"segments":[{"spoiler":false,"text":"南の大国である魔法使いの国「ケッセルリンク」の王女。"},{"spoiler":false,"text":"一国の王女にして、王国一の魔法使い。"},{"spoiler":false,"text":"冷徹、無機質、表情に乏しく、近寄りがたい空気を漂わせる。"},{"spoiler":false,"text":"魔法の研究に集中していることがほとんどで、邪魔されると静かに怒りを爆発させる。"},{"spoiler":false,"text":"何か使命を帯びている様子で、人生そのものを儚く見ているようだが……。"}],"source":"egs","sourceCharacterId":"17339","sourceWorkId":"11214","spoiler":false},{"segments":[{"spoiler":false,"text":"天才的な頭脳と、強大な魔力を持って生まれた王国一の魔法使い。"},{"spoiler":false,"text":"冷たい目と無機質な表情が特徴的で、他人を寄せ付けないオーラを発している。"},{"spoiler":false,"text":"感情の表現がひどく苦手で、話し方も事務的。"},{"spoiler":false,"text":"いつも研究に没頭しており、邪魔をされると静かに熱い怒りを爆発させる。"},{"spoiler":false,"text":"とある使命を抱えており、人生をどこか刹那的に捉えている。"}],"source":"bangumi","sourceCharacterId":"144771"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9dd45e01f9f31f2b0b409d1272d5d067cc971333e4843ac06615ace111922f1c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25baa717b3e0091af9d679260d092a23d28b6fbebd8553f145d3ba4870a9293c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七生 みこと","creatorId":"vndb:s1697","sourcePersonId":"vndb:s1697","canonicalEntityId":"vndb:s1697","name":"七生 みこと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10211","source":"vndb"}]},{"characterId":"char_c67060","characterName":"ウルズ＝バッカーニアーズ","sourceIds":{"bangumi":[{"characterId":"144772","match":"exact-normalized-name-in-linked-work","subjectId":"82162"}],"egsCharacterIds":["17340"],"vndbCharacterId":"c67060"},"originalCharacterName":"ウルズ＝バッカーニアーズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Despite her cute appearance, she is a headstrong and victorious princess. She leads her ships and pirates to raid coastal cities one after another, and spends her days looting and plundering."},{"spoiler":false,"text":"Like her father, she dreams of one day being called a pirate king, a name that will be feared throughout the land."},{"spoiler":false,"text":"She acts and behaves like a boy, and her language is coarse. She thinks she is dignified, but because she looks childish, people think she is cute, and she is often underestimated. In such cases, she uses force to silence them."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c67060"},{"segments":[{"spoiler":false,"text":"西の大国である海賊の国「バッカーニアーズ」の王女。"},{"spoiler":false,"text":"外見は可愛いが、性格は男勝り。自分の船で海賊を率いて略奪三昧。"},{"spoiler":false,"text":"父親のように“海賊王”と呼ばれるのが夢。"},{"spoiler":false,"text":"言葉づかいが男の子っぽくて、粗野。外見のせいで余計子供に見られることも。"},{"spoiler":false,"text":"幼く見られて侮られたときは、実力行使で黙らせる。"}],"source":"egs","sourceCharacterId":"17340","sourceWorkId":"11214","spoiler":false},{"segments":[{"spoiler":false,"text":"キュートな外見とは裏腹に、男勝りで勝ち気なお姫様。"},{"spoiler":false,"text":"自分の船と海賊を率いて沿岸の街を次々と襲撃、略奪三昧の日々を行っている。"},{"spoiler":false,"text":"自身の父親と同じく、いつしか諸国で恐れられる海賊王と呼ばれるのが夢。"},{"spoiler":false,"text":"言動が男の子っぽく、言葉遣いも粗野。"},{"spoiler":false,"text":"本人は威厳があるつもりだが、見た目が○○っぽいので可愛らしく思われ、侮られることも多い。そういう時は実力行使で黙らせてしまう"}],"source":"bangumi","sourceCharacterId":"144772"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e88c352cd967136b59d951d9adf633b683d7dccc389c89dcc79511fb0ff76933.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8e935ffb979b693e9a3304b54473e6eae686bbdf1633c1ff531aca28b2e9e93.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:82162:144772:5900:1","source":"bangumi"}]},{"characterId":"char_c67061","characterName":"セレス","sourceIds":{"bangumi":[{"characterId":"144773","match":"exact-normalized-name-in-linked-work","subjectId":"82162"}],"egsCharacterIds":["17341"],"vndbCharacterId":"c67061"},"originalCharacterName":"セレス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a talented woman who combines popularity, bravery and beauty. She is a hard-nosed, fastidious person who never overlooks injustice."},{"spoiler":false,"text":"She not only leads the Knights, but also participates in national politics as a member of the Senate. She and Yuri trained together in the knighthood when they were children."},{"spoiler":false,"text":"Therefore, she is well acquainted with Yuri's personality and is vehemently opposed to his succession to the throne."},{"spoiler":false,"text":"She is secretly in love with Kristof, but has given up on the idea that it is a love that is attainable."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c67061"},{"segments":[{"spoiler":false,"text":"「キングダム」の騎士団長。"},{"spoiler":false,"text":"武勇に長け正義感が強く、美しい顔立ちをした女騎士。"},{"spoiler":false,"text":"すぐれた統率力から重用され、元老院の一員として国政にも関与。"},{"spoiler":false,"text":"子どもの頃にユーリと騎士団で腕を研いた仲で、彼の性格をよく知る。"},{"spoiler":false,"text":"ゆえに王位継承には猛反対。"},{"spoiler":false,"text":"密かにクリストフを想っている。"}],"source":"egs","sourceCharacterId":"17341","sourceWorkId":"11214","spoiler":false},{"segments":[{"spoiler":false,"text":"人望と武勇、美貌を兼ね備えた才女。"},{"spoiler":false,"text":"堅物で潔癖、決して不義を見逃せない性格。"},{"spoiler":false,"text":"騎士団の統率だけではなく、元老院の一員として国政にも参加している。"},{"spoiler":false,"text":"ユーリとは幼い頃、騎士団で共に剣の腕を磨いた間柄。"},{"spoiler":false,"text":"それゆえ、ユーリの人間性についても熟知しており、王位継承に猛反対する。"},{"spoiler":false,"text":"密かにクリストフのことを想っているが、叶わぬ恋だと諦めている。"}],"source":"bangumi","sourceCharacterId":"144773"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/9270bb09a401b8f114f9777b28da478c86a4444b426d824c646367da5f1d01b9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07b190275e2d841bae4c93cffbe5494322ab64713c37302bca8c30fbd85c48cc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由倉奈於","creatorId":"vndb:s923","sourcePersonId":"vndb:s923","canonicalEntityId":"vndb:s923","name":"由倉 奈於","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:82162:144773:6083:1","source":"bangumi"}]},{"characterId":"char_c67062","characterName":"ロコ","sourceIds":{"bangumi":[{"characterId":"144774","match":"exact-normalized-name-in-linked-work","subjectId":"82162"},{"characterId":"144774","match":"exact-normalized-name-in-linked-work","subjectId":"82168"}],"egsCharacterIds":["12570"],"vndbCharacterId":"c67062"},"originalCharacterName":"ロコ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An elven boy who has strayed from the forest."},{"spoiler":false,"text":"He is Yuri's brother in arms from when Yuri was an adventurer, and now remains a loyal follower."},{"spoiler":false,"text":"He used to be a bandit and has a variety of skills, including picking and archery."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c67062"},{"segments":[{"spoiler":false,"text":"ユーリの相棒。エルフの少年。"},{"spoiler":false,"text":"森からはぐれて盗賊で命をつないでいたときユーリと出会う。"},{"spoiler":false,"text":"剣の腕が確かなので、性格は目をつぶって一緒に旅に出る。"},{"spoiler":false,"text":"ユーリを「アニキ」と慕う。"}],"source":"egs","sourceCharacterId":"12570","sourceWorkId":"11214","spoiler":false},{"segments":[{"spoiler":false,"text":"【ユーリの従者】"},{"spoiler":false,"text":"森からはぐれたエルフの少年。"},{"spoiler":false,"text":"ユーリが冒険者をしていた頃からの弟分で、今では従者としてコキ使われている。"},{"spoiler":false,"text":"かつては盗賊をしており、ピッキングや弓術など多彩な技能を持つ。"}],"source":"egs","sourceCharacterId":"12570","sourceWorkId":"13726","spoiler":false},{"segments":[{"spoiler":false,"text":"森からはぐれたエルフの少年で、盗賊として人里で生きるうちにユーリと出会い、一緒に旅をするようになる。"},{"spoiler":false,"text":"性格はともかく剣の実力は確かなユーリを、アニキと慕っている。"},{"spoiler":false,"text":"故郷へ帰還するユーリにくっついて、王国へとやってくる。"},{"spoiler":false,"text":"「～ッス」「オイラは～」といった口調が特徴的な、元気で明るい性格。"}],"source":"bangumi","sourceCharacterId":"144774"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c67062","value":"m"},{"comparisonValue":"m","source":"egs","sourceCharacterId":"12570","value":"男性"},{"comparisonValue":"m","source":"egs","sourceCharacterId":"12570","value":"男性"},{"comparisonValue":"f","source":"bangumi","sourceCharacterId":"144774","value":"女"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c26cb229be9cc829747d4d1c1e43a49db997dd2cce23d46fad1595736e79b95d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35d0827d63b611732c8d961879a6ae223fa11f8c9ad1953c090ca5ada7984a99.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由宇翼","creatorId":"vndb:s1420","sourcePersonId":"vndb:s1420","canonicalEntityId":"vndb:s1420","name":"あさり☆","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:82162:144774:18193:1","source":"bangumi"}]},{"characterId":"char_vndb_c67063","characterName":"クリストフ＝キングダム","sourceIds":{"vndbCharacterId":"c67063"},"originalCharacterName":"クリストフ＝キングダム","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c45df58086015daf2bdb1d7597185976163dec26137cd986442ad2f66d8f6b64.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0db4c330b7b622d6a333451b44b9e08180a050fafe050b8ad6394391f492a2f3.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p503","sourceCompanyId":"egs:brand:2141","canonicalEntityId":"vndb:p503","name":"Frill","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:11214:2141","source":"egs"},{"companyId":"vndb:p503","sourceCompanyId":"vndb:p503","canonicalEntityId":"vndb:p503","name":"Frill","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:142638:v1124","source":"vndb"},{"companyId":"vndb:p503","sourceCompanyId":"vndb:p503","canonicalEntityId":"vndb:p503","name":"Frill","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:142639:v1124","source":"vndb"},{"companyId":"vndb:p503","sourceCompanyId":"vndb:p503","canonicalEntityId":"vndb:p503","name"