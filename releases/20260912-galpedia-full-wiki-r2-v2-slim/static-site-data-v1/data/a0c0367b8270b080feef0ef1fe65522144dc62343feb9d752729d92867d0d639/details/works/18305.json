{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"18305","model":{"presentationWorkId":"vndb:v12550","staff":{"artwork":[{"creditedName":"井硲六郎","creatorId":"vndb:s10442","sourcePersonId":"egs:creator:15997","canonicalEntityId":"vndb:s10442","name":"井硲六郎","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:115322","source":"egs"}],"scenario":[{"creditedName":"OZ","creatorId":"vndb:s1905","sourcePersonId":"egs:creator:13419","canonicalEntityId":"vndb:s1905","name":"OZ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:115323","source":"egs"}],"music":[],"other":[{"creditedName":"藤原隆之","creatorId":"vndb:s13001","sourcePersonId":"egs:creator:13420","canonicalEntityId":"vndb:s13001","name":"藤原隆之","detail":"監修","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:135025","source":"egs"},{"creditedName":"阿部四百(400、阿部400)","creatorId":"vndb:s3914","sourcePersonId":"egs:creator:15433","canonicalEntityId":"vndb:s3914","name":"阿部四百(400、阿部400","detail":"彩色","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:167695","source":"egs"}]},"cast":[{"characterId":"char_c38413","characterName":"秋宮 沙也香","sourceIds":{"bangumi":[{"characterId":"46767","match":"exact-normalized-name-in-linked-work","subjectId":"193564"}],"egsCharacterIds":["566"],"vndbCharacterId":"c38413"},"originalCharacterName":"秋宮 沙也香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"97"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"source-only","source":"vndb","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"容姿端麗で物静かな少女。"},{"spoiler":false,"text":"「そう」「ええ」等、端的に喋り必要以上に会話をしようとはしないので、周囲にはクールだと思われており、友人はいない。"},{"spoiler":false,"text":"実際には口数が少なく人付き合いが下手なだけで、クラスの頼み事などには嫌な顔をせず応じてくれる。"},{"spoiler":false,"text":"子供が好きで、子供たちと接する時だけは笑顔を見せる。"},{"spoiler":false,"text":"家は昔からの資産家であり、お金持ち。"},{"spoiler":false,"text":"その見目麗しさや、男を惹き付けてやまないプロポーションのせいで入学当時から男子に何度も言い寄られているが、未だに誰とも付き合ったことはない。"},{"spoiler":false,"text":"特に親しくしている男子もいないし、告白されても全く芽がないので、学園では高嶺の花として認識されている。常に長袖の服を着ていて、あまり肌を晒さない。"},{"spoiler":false,"text":"実際には、沙也香はその金持ちの家の子供ではなく、借金の形におもしろがって見受けされた子供で、性奴隷として扱われていた。"},{"spoiler":false,"text":"幼い頃から金持ち達が集う秘密の社交界で玩具にされ、調教され続けている。"},{"spoiler":false,"text":"長年、依存性のある薬物を投与され続けたせいで、中毒になっている。"},{"spoiler":false,"text":"注射の痕を隠すために普段は肌を見せないようにしている。"}],"source":"egs","sourceCharacterId":"566","sourceWorkId":"18305","spoiler":false},{"segments":[{"spoiler":false,"text":"端庄文静的少女。被周围的人都认为是很酷的女性。"},{"spoiler":false,"text":"但实际上只是寡言不善于与人交往，对班里的请求等事情都不会露出厌恶的表情。"},{"spoiler":false,"text":"她很喜欢孩子，只有和孩子接触时才会露出笑容。"},{"spoiler":false,"text":"家族自古以来都是资本家，很有钱。"},{"spoiler":false,"text":"虽然有很多男性向她追求多次，但至今为止都还没有和任何人交往过。"},{"spoiler":false,"text":"实际上，沙也香并不是那个有钱人家的孩子，只是债主认为她是一个有趣的孩子，被当成是性奴隶。"},{"spoiler":false,"text":"从小就在有钱人聚集的秘密社交界中担任玩具，被不断地调教。"},{"spoiler":false,"text":"因为常年注射含有成瘾性药物的缘故，已经上瘾了。"}],"source":"bangumi","sourceCharacterId":"46767"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4d52a9f65e072995640b3118d4ad988ced67bda6789f60fb34253358b2f24c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74c3a9159558b540872cd993771cc5b3c1e31919416a5a065afcd4b7932dc4b3.webp","width":213,"height":256,"source":"static-detail"},