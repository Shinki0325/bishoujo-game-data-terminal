。"}],"source":"bangumi","sourceCharacterId":"203421"}],"profileFacts":[{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"4389","sourceWorkId":"20832","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fe50ed33689974696933a949e74aa9b173c9dcca1c5384337aadddf08819d65.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0ec2efbff1128d8c5daee985ae54dd544702ab8f1de30aa083758538e5e86068.webp","width":160,"height":209,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p815","sourceCompanyId":"egs:brand:658","canonicalEntityId":"vndb:p815","name":"アンダームーン","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:20832:658","source":"egs"},{"companyId":"vndb:p815","sourceCompanyId":"vndb:p815","canonicalEntityId":"vndb:p815","name":"アンダームーン","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:40715:v15656","source":"vndb"},{"companyId":"vndb:p4417","sourceCompanyId":"vndb:p4417","canonicalEntityId":"vndb:p4417","name":"株式会社天沼矛","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:40716:v15656","source":"vndb"},{"companyId":"vndb:p815","sourceCompanyId":"vndb:p815","canonicalEntityId":"vndb:p815","name":"アンダームーン","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:42015:v15656","source":"vndb"},{"companyId":"vndb:p815","sourceCompanyId":"vndb:p815","canonicalEntityId":"vndb:p815","name":"アンダームーン","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:44800:v15656","source":"vndb"},{"companyId":"vndb:p4417","sourceCompanyId":"vndb:p4417","canonicalEntityId":"vndb:p4417","name":"株式会社天沼矛","roleCodes":["developer"],"identityStatus":"s