haracterName":"小島 茜","sourceIds":{"bangumi":[{"characterId":"174834","match":"exact-normalized-name-in-linked-work","subjectId":"16957"}],"egsCharacterIds":["10901"],"vndbCharacterId":"c9827"},"originalCharacterName":"小島 茜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"販売店でアルバイトをしている女の子。"},{"spoiler":false,"text":"やかましいくらいの元気っ子で、周りを引っ掻き回すムードメイカー。"},{"spoiler":false,"text":"悪ノリがすぎる所もあってよく自爆する。"},{"spoiler":false,"text":"男勝りで勝気な性格ではあるが、料理が得意だったりと家庭的な一面があったりもする。"},{"spoiler":false,"text":"姉御肌で世話好き。"},{"spoiler":false,"text":"悠依（ゆい）とは幼いころからの親友で、入院生活の長い悠依を気遣う優しい子でもある。"},{"spoiler":false,"text":"エッチな事に対しては茶化して煙に巻きつつも実は興味津々なお年頃。"}],"source":"egs","sourceCharacterId":"10901","sourceWorkId":"14625","spoiler":false},{"segments":[{"spoiler":false,"text":"販売店でアルバイトをしている女の子。"},{"spoiler":false,"text":"悠依とは幼いころからの親友で"},{"spoiler":false,"text":"過去に何度も来ていた主人公とも顔なじみ。"},{"spoiler":false,"text":"男勝りで荒っぽい性格ではあるが"},{"spoiler":false,"text":"意外と器用な一面があったりもする。"},{"spoiler":false,"text":"姉御肌で世話好き、"},{"spoiler":false,"text":"悠依の主人公に対する思いを知っている為、"},{"spoiler":false,"text":"自分の気持ちを抑え、一步身を引いている。"},{"spoiler":false,"text":"「悠依はあたしのモノだ！」"}],"source":"bangumi","sourceCharacterId":"174834"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d60676379e1749a8df86a1ac7d3a9881e93004e87d1e10f471961846ca8d9a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e9daa9ca3d66a7957b184d44a95688bee9566a6776fed26c96c4f214753a9e8.webp","width":192,"height":252,"source":"static-detail"},"actors":[]},{"characterId":"char_c9828","characterName":"緒川 悠依","sourceIds":{"bangumi":[{"characterId":"174835","match":"exact-normalized-name-in-linked-work","subjectId":"16957"}],"egsCharacterIds":["10902"],"vndbCharacterId":"c9828"},"originalCharacterName":"緒川 悠依","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“孝志”の従兄妹。"},{"spoiler":false,"text":"孝志を実の兄のように慕っている。"},{"spoiler":false,"text":"滅多にベッドから出ることは出来ないが、健気に明るく振舞っている。"},{"spoiler":false,"text":"“孝志”の従妹。生まれつき心臓が弱く、幼い頃から病院暮らし。"},{"spoiler":false,"text":"本人は大人っぽく振る舞いたいと思っているが、入院生活が長いせいか、割と世間知らずでどこかしら子供っぽい。"},{"spoiler":false,"text":"学校にも中々行く事ができない為、幼馴染の茜の他に友達はいない。"}],"source":"egs","sourceCharacterId":"10902","sourceWorkId":"14625","spoiler":false},{"segments":[{"spoiler":false,"text":"\"孝志\"の従兄妹。\"孝志\"実の兄のように慕っている。"},{"spoiler":false,"text":"幼い頃から心臓を患い、病に伏して入院していることが多く、"},{"spoiler":false,"text":"めったにベッドから出ることは出来ないが、健気に明るく振舞っている。"},{"spoiler":false,"text":"学校にも中々行くことができない為、幼馴染の茜の他に友達はいない。"},{"spoiler":false,"text":"「うん……大丈夫だよ。」"}],"source":"bangumi","sourceCharacterId":"174835"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/950838fc8c01b59bb40ae56fa14080f466dc3f90a7f7fc3ab2574d8338835697.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa843ae50883783d3b17a0caebab4d9a1a7629a375bcc5f2263dca286f02b164.webp","width":186,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c9829","characterName":"緒川 椿","sourceIds":{"bangumi":[{"characterId":"174837","match":"exact-normalized-name-in-linked-work","subjectId":"16957"}],"egsCharacterIds":["10903"],"vndbCharacterId":"c9829"},"originalCharacterName":"緒川 椿","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“悠依”の母親。"},{"spoiler":false,"text":"たおやかで物腰が柔らかい、販売店の皆の優しいお母さん。"},{"spoiler":false,"text":"亡き妹の残した一人娘である“歩美”を、自分の娘のように育てている。"},{"spoiler":false,"text":"年頃の娘がいるとはとても思えない若い容姿で、皆からは「椿さん」と呼ばれて親しまれているが、娘の悠依や姪の歩美には母親として少し厳しく接する一面もある。"}],"source":"egs","sourceCharacterId":"10903","sourceWorkId":"14625","spoiler":false},{"segments":[{"spoiler":false,"text":"店長の奥さんで、 悠依の母親。"},{"spoiler":false,"text":"家族や奨学生の食事を切り盛りする優しいお母さん。"},{"spoiler":false,"text":"亡き妹の残した一人娘である\"歩美”を、 自分の娘のように育てている。"},{"spoiler":false,"text":"一児の母にはとても見えないような若い容姿で、"},{"spoiler":false,"text":"雪乃達には 「椿さん」 と呼ばれている。"},{"spoiler":false,"text":"「それでは、よろしくお願いしますね。」"}],"source":"bangumi","sourceCharacterId":"174837"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e74a4064d5fa0e5d2f3ff665ca0dabac2c57180e023b330d1e5641cb76999717.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/044e77dc263ae53fe38693c2a92f64ca7ef0e8165fc04c33c85bab9f04b24da1.webp","width":146,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c9831","characterName":"萩原 今日子","sourceIds":{"bangumi":[{"characterId":"174836","match":"exact-normalized-name-in-linked-work","subjectId":"16957"}],"egsCharacterIds":["10904"],"vndbCharacterId":"c9831"},"originalCharacterName":"萩原 今日子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“雪乃”が通う大学の同期生の女の子。"},{"spoiler":false,"text":"街唯一のファミレスでウェイトレスをしている。"},{"spoiler":false,"text":"いたずら猫のような性格で、とかくＨにたいしては寛容な心の持ち主。"},{"spoiler":false,"text":"雪乃のことを「ゆきのん」と呼びつつ、弄り倒している。"}],"source":"egs","sourceCharacterId":"10904","sourceWorkId":"14625","spoiler":false},{"segments":[{"spoiler":false,"text":"“雪乃” が通う大学の同期生の女の子。"},{"spoiler":false,"text":"街唯一のファミレスでウェイトレスをしている。"},{"spoiler":false,"text":"いたずら猫のような性格で、 とかく性にたいしては寛容な心の持ち主。"},{"spoiler":false,"text":"「またまたームリしちゃって。"},{"spoiler":false,"text":"私はいーよ。 ゆきのんのカレシでも。」"}],"source":"bangumi","sourceCharacterId":"174836"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/cac2fbfb2ec00b7938844bfc5b6be65c64138cd092ccc3da6fa5232bc38d7b09.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2e6f5797eeb391b9e1bd6721ed2995c6de08af01a8e364518db0dce1d5b5f54.webp","width":140,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c9832","characterName":"押阪 忍","sourceIds":{"bangumi":[{"characterId":"174838","match":"exact-normalized-name-in-linked-work","subjectId":"16957"}],"egsCharacterIds":["10905"],"vndbCharacterId":"c9832"},"originalCharacterName":"押阪 忍","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"販売店の事務員で寡黙な女性。"},{"spoiler":false,"text":"人と関わる事を拒絶する女性だが、彼女がそうなったのには理由が……。"}],"source":"egs","sourceCharacterId":"10905","sourceWorkId":"14625","spoiler":false},{"segments":[{"spoiler":false,"text":"販売店の専業として働いている元新聞奨学生。"},{"spoiler":false,"text":"他人とのコミュニケーションをとることに関して"},{"spoiler":false,"text":"無頓着。"},{"spoiler":false,"text":"歩美と同様、口数が極端に少ない寡黙な女性。"},{"spoiler":false,"text":"「じゃあ君、女の子にかかずらっている"},{"spoiler":false,"text":"暇はないんじゃなくて?」"}],"source":"bangumi","sourceCharacterId":"174838"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/66a0fcc2cdbabad068b3aff7bd8943c807f52ae942f30d54dc0907d4b23db3c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e02aee10c1ab8d3210aabae1a954630b49a5bec779fa32932b6d8ddef1aa3d84.webp","width":131,"height