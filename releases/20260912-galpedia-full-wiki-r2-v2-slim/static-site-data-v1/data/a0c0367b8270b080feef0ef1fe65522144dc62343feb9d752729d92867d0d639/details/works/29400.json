rce-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first year at Hanyuu Academy, and a year younger than her childhood friend, Ryoutarou, whom she reunited with when he moved back to Japan."},{"spoiler":false,"text":"Emi and Ryoutarou were so close when they were kids that she’d call him Big Brother... despite her already having a big brother, Tooru. Although she used to be bossy when she was young and always forced Ryoutarou and Tooru to do what she wanted, she’s become much friendlier now that she’s grown up, and is deeply ashamed of the way she used to act."},{"spoiler":false,"text":"“N-No, it’s... way too embarrassing to call you Big Brother now.”"},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c78406"},{"segments":[{"spoiler":false,"text":"羽生学園1年生。数年ぶりに再会した遼太郎（主人公）の一つ年下の幼馴染。昔よく懐かれていて、実の兄を差し置いて遼太郎のことを『お兄ちゃん』と呼んでいた。小さい頃は我が強く周りを振り回して遼太郎たちに迷惑を掛けていたが、今は性格が落ち着きその頃の記憶は自身にとって黒歴史になっている。"}],"source":"egs","sourceCharacterId":"20971","sourceWorkId":"27575","spoiler":false},{"segments":[{"spoiler":false,"text":"羽生学園1年生。数年ぶりに再会した遼太郎（主人公）の一つ年下の幼馴染。昔よく懐かれていて、実の兄を差し置いて遼太郎のことを『お兄ちゃん』と呼んでいた。小さい頃は我が強く周りを振り回して遼太郎たちに迷惑を掛けていたが、今は性格が落ち着きその頃の記憶は自身にとって黒歴史になっている。"}],"source":"bangumi","sourceCharacterId":"69002"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0ef3a6c09deb5db8d569b76d5e9a0dc882e289936dc075ee2613f289329522b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a602b4fb04c1c6e8a203cacfe533f1881f6db40fc6894513b22607f832b86fe9.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三宅麻理恵","creatorId":"vndb:s2258","sourcePersonId":"vndb:s2258","canonicalEntityId":"vndb:s2258","name":"三宅 麻理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269618:69002:6846:1","source":"bangumi"}]},{"characterId":"char_c78407","characterName":"東金 望愛","sourceIds":{"bangumi":[{"characterId":"69003","match":"exact-normalized-name-in-linked-work","subjectId":"269618"}],"egsCharacterIds":["20972"],"vndbCharacterId":"c78407"},"originalCharacterName":"東金 望愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The class president of Class 2-C, which Ryoutarou has transferred to."},{"spoiler":false,"text":"Adored by her classmates, she has a bit of a clumsy side that makes everybody worry about her. She’s also a student librarian at the campus library, and often has duties there after class."},{"spoiler":false,"text":"“Wanna walk to the next class together?\""},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c78407"},{"segments":[{"spoiler":false,"text":"遼太郎が転入した羽生学園2年C組のクラス委員長。クラスメイトたちから慕われている一方、どこか抜けていて危なっかしい一面もあり、放っておけない気持ちにさせられてしまう。図書館委員に所属しており、放課後は図書室で司書代わりとしていることが多い。"}],"source":"egs","sourceCharacterId":"20972","sourceWorkId":"27575","spoiler":false},{"segments":[{"spoiler":false,"text":"遼太郎が転入した羽生学園2年C組のクラス委員長。クラスメイトたちから慕われている一方、どこか抜けていて危なっかしい一面もあり、放っておけない気持ちにさせられてしまう。図書館委員に所属しており、放課後は図書室で司書代わりとしていることが多い。"}],"source":"bangumi","sourceCharacterId":"69003"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35e4916ad5be04ab7b354a99baad0d67c63a0a8a8fdcc5d29711b093d7685111.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37dacecb292ec8032b8a4c98b391f61cbb67f2a1f8c6f610a0394d479982f3af.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結城ほのか","creatorId":"vndb:s6018","sourcePersonId":"vndb:s6018","canonicalEntityId":"vndb:s6018","name":"結城 ほのか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269618:69003:20256:1","source":"bangumi"}]},{"characterId":"char_c78408","characterName":"陣内 莉佳子","sourceIds":{"bangumi":[{"characterId":"69004","match":"exact-normalized-name-in-linked-work","subjectId":"269618"}],"egsCharacterIds":["20973"],"vndbCharacterId":"c78408"},"originalCharacterName":"陣内 莉佳子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"925"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second year student at Hanyuu Academy who loves to run and is a dedicated member of the track and field club."},{"spoiler":false,"text":"After spotting her doing morning training, Ryoutarou finds himself sitting next to her during their joint English class by coincidence, and the two end up becoming fast friends. Rikako is so shy when it comes to talking to other people, especially guys, that she comes off as cold. Although she wants to make lots of friends, she’s afraid of giving people the wrong impression."},{"spoiler":false,"text":"“I’m, uhh, just not used to talking to guys... I don’t know how to respond...”"},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c78408"},{"segments":[{"spoiler":false,"text":"羽生学園2年D組、走るのが好きな部活熱心な女の子。朝練中に目撃し、気になっていたところに合同授業で隣の席になったことで仲良くなった。あまり人と会話することに慣れておらず、特に男子相手だとそっけない態度になってしまう…できればたくさん友達を作りたいが誤解を生んでしまうことを気にしている。"}],"source":"egs","sourceCharacterId":"20973","sourceWorkId":"27575","spoiler":false},{"segments":[{"spoiler":false,"text":"羽生学園2年D組、走るのが好きな部活熱心な女の子。朝練中に目撃し、気になっていたところに合同授業で隣の席になったことで仲良くなった。あまり人と会話することに慣れておらず、特に男子相手だとそっけない態度になってしまう…できればたくさん友達を作りたいが誤解を生んでしまうことを気にしている。"}],"source":"bangumi","sourceCharacterId":"69004"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/983b79552ee7e1f88b94939824cc7fdfb251bb700e0816b0c5b5653bf9e4c17f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3c16c1f7a2949f2cfb62e1f0ee9bcbea53726e9a385102aeca9fe0ae00ff178.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘志穂","creatorId":"vndb:s738","sourcePersonId":"vndb:s738","canonicalEntityId":"vndb:s738","name":"橘 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269618:69004:7169:1","source":"bangumi"}]},{"characterId":"char_c78409","characterName":"鈴山 美里","sourceIds":{"bangumi":[{"characterId":"69005","match":"exact-normalized-name-in-linked-work","subjectId":"269618"}],"egsCharacterIds":["20974"],"vndbCharacterId":"c78409"},"originalCharacterName":"鈴山 美里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third year at Hanyuu Academy who’s in the same class as Tooru."},{"spoiler":false,"text":"She’s a bright and bubbly senior who’s well-liked by both the guys and the girls. There’s not a student in third year who doesn’t know her. Caring, fun-loving and positive, Misato won’t hesitate to chat up anybody that takes her interest."},{"spoiler":false,"text":"“Tomorrow’s gonna be a good one! I’ll make sure it’s a fun day for you!”"},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c78409"},{"segments":[{"spoiler":false,"text":"羽生学園３年生。幼馴l染の亨と同じクラスの元気な先輩。男女ともに人気があり、クラスのムードメ ーカーだけではなく3年で美里を知らない人はいないくらいの有名人。気配りが出来て面白いこと楽しいことが大好き、面白そうなことがあれば進んで声をかける行動力もあり、ポジティブ思考の持ち主"}],"source":"egs","sourceCharacterId":"20974","sourceWorkId":"27575","spoiler":false},{"segments":[{"spoiler":false,"text":"羽生学園３年生。幼馴l染の亨と同じクラスの元気な先輩。男女ともに人気があり、クラスのムードメ ーカーだけではなく3年で美里を知らない人はいないくらいの有名人。気配りが出来て面白いこと楽しいことが大好き、面白そうなことがあれば進んで声をかける行動力もあり、ポジティブ思考の持ち主"}],"source":"bangumi","sourceCharacterId":"69005"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/2752767a2f618cc6676e5fbdde34d7f74f19ccbf791c72d8847f044e008d2d47.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb1e393b26d9f9122825734a2e94df98ae7494be706930e4ed54f847e0e0fe0b.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"五十嵐裕美","creatorId":"vndb:s77","sourcePersonId":"vndb:s77","canonicalEntityId":"vndb:s77","name":"五十嵐 裕美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269618:69005:5208:1","source":"bangumi"}]},{"characterId":"char_c78410","characterName":"烏丸 裕香","sourceIds":{"bangumi":[{"characterId":"69007","match":"exact-normalized-name-in-linked-work","subjectId":"269618"}],"egsCharacterIds":["20975"],"vndbCharacterId":"c78410"},"originalCharacterName":"烏丸 裕香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first year at Hanyuu Academy."},{"spoiler":false,"text":"She is the only daughter of the owner of the prestigious Karasuma Confectionaries. Her overprotective father has assigned a bodyguard in a black suit to accompany her everywhere she goes to protect her from any ‘scoundrels,’ a.k.a. guys. As a result, the other students are reluctant to approach her and she can’t make any friends, which makes her want to rebel against her father and run away from her bodyguard."},{"spoiler":false,"text":"Although she keeps up appearances on campus, as Ryoutarou gets to know her, she reveals her innocent side to him."},{"spoiler":false,"text":"“Ryoutarou! Help me hide from Mr. Mutou!”"},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c78410"},{"segments":[{"spoiler":false,"text":"羽生学園1年生。『烏丸製菓』と呼ばれる大企業の社長の一人娘。過保護な父親の指示で、常に護衛役のSPが付いている。そのせいか友達もあまり出来なくなってしまったため、親に対する反抗心が強く、黒服から逃走することもしばしば。学園ではおしとやかに過ごしているが、親しくなると年相応な無邪気さが垣間見える。"}],"source":"egs","sourceCharacterId":"20975","sourceWorkId":"27575","spoiler":false},{"segments":[{"spoiler":false,"text":"羽生学園1年生。『烏丸製菓』と呼ばれる大企業の社長の一人娘。過保護な父親の指示で、常に護衛役のSPが付いている。そのせいか友達もあまり出来なくなってしまったため、親に対する反抗心が強く、黒服から逃走することもしばしば。学園ではおしとやかに過ごしているが、親しくなると年相応な無邪気さが垣間見える。"}],"source":"bangumi","sourceCharacterId":"69007"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9ecdb486439eeaf7af6215faeac4793b615581aa01060fcd1017c31bc3aa01c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/847505fb045a38206bc803080461c8b763b672cd1a256dff3d3aa5cebd9eb673.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"戸板優衣","creatorId":"vndb:s10510","sourcePersonId":"vndb:s10510","canonicalEntityId":"vndb:s10510","name":"戸板 優衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269618:69007:24908:1","source":"bangumi"}]},{"characterId":"char_c78411","characterName":"吉村 凛","sourceIds":{"bangumi":[{"characterId":"69008","match":"exact-normalized-name-in-linked-work","subjectId":"269618"}],"egsCharacterIds":["20977"],"vndbCharacterId":"c78411"},"originalCharacterName":"吉村 凛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third year at Hanyuu Academy, and in the same class as Misato and Tooru."},{"spoiler":false,"text":"Due to an embarrassing incident at last year’s beauty contest, she earned herself the nickname \"the Medusa of Hanyuu Academy.\" Now she regrets ever competing in the contest, and hides her face behind her long hair. While she’ll speak to most of the girls, she barely talks to any of the guys. She often hangs out with Misato, and steps in whenever she bothers Ryoutarou."},{"spoiler":false,"text":"“T-The Medusa of Hanyuu Academy?! N-Nope, never heard of it! Ahahahaha!”"},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c78411"},{"segments":[{"spoiler":false,"text":"羽生学園3年生。美里と同じクラスの先輩。昨年行われた『ミス・ミスター羽生』で見事優勝し、男子全員を勃起させ動けなくさせたことから『羽生学園のメデューサ』というあだ名がついた。本人的には不本意であり後悔もしているため、素顔を隠すようになった。美里とよく一緒にいることが多い。"}],"source":"egs","sourceCharacterId":"20977","sourceWorkId":"27575","spoiler":false},{"segments":[{"spoiler":false,"text":"羽生学園3年生。美里と同じクラスの先輩。昨年行われた『ミス・ミスター羽生』で見事優勝し、男子全員を勃起させ動けなくさせたことから『羽生学園のメデューサ』というあだ名がついた。本人的には不本意であり後悔もしているため、素顔を隠すようになった。美里とよく一緒にいることが多い。"}],"source":"bangumi","sourceCharacterId":"69008"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71a3fe2efc5cbad9ae9c11eea7cc92aa73e63aae56e2b85a8888f87da1d08b43.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce34fb4238f59c611fb1c0a33643272f21cdae000bbf1d10cabff61a48b390c2.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長妻樹里","creatorId":"vndb:s1197","sourcePersonId":"vndb:s1197","canonicalEntityId":"vndb:s1197","name":"長妻 樹里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269618:69008:8493:1","source":"bangumi"}]},{"characterId":"char_c78412","characterName":"えりちゃん先生","sourceIds":{"bangumi":[{"characterId":"69009","match":"exact-normalized-name-in-linked-work","subjectId":"269618"}],"egsCharacterIds":["20976"],"vndbCharacterId":"c78412"},"originalCharacterName":"えりちゃん先生","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The teacher of Ryoutarou class."},{"spoiler":false,"text":"She’s popular among her students, who affectionately call her ‘Miss Eri.’ As she’s easy to approach, they often come to her for advice, but the sheer number of students who want to talk to her can be a little overwhelming at times."},{"spoiler":false,"text":"“While you’re studying here, I want you to find what’s most important to you.”"},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c78412"},{"segments":[{"spoiler":false,"text":"遼太郎のクラスの担任。生徒との距離が近いこともあり、生徒たちから『えりちゃん先生』と呼ばれることも。親しみやすい雰囲気を持っため思春期の悩み相談などもしていて、生徒たちに人気がある反面、生徒から相談が多い分、 苦労することもある。"}],"source":"egs","sourceCharacterId":"20976","sourceWorkId":"27575","spoiler":false},{"segments":[{"spoiler":false,"text":"遼太郎のクラスの担任。生徒との距離が近いこともあり、生徒たちから『えりちゃん先生』と呼ばれることも。親しみやすい雰囲気を持っため思春期の悩み相談などもしていて、生徒たちに人気がある反面、生徒から相談が多い分、 苦労することもある。"}],"source":"bangumi","sourceCharacterId":"69009"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a6d58518caf33d7aca0c5e647a2ebaae7fa2bc10b0894d50d166ad202a098aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef981dd8a6a6fb9a63aed5c8ee973a1a2c34522a195160b12029f44a8e38125b.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井ノ上奈々","creatorId":"vndb:s1808","sourcePersonId":"vndb:s1808","canonicalEntityId":"vndb:s1808","name":"井ノ上奈々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269618:69009:4745:1","source":"bangumi"}]},{"characterId":"char_vndb_c78405","characterName":"篠崎 遼太郎","sourceIds":{"vndbCharacterId":"c78405"},"originalCharacterName":"篠崎 遼太郎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"721"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the game who has a generally positive personality. Because of his parents' work, he was forced to move overseas constantly and as a result he struggled to adapt to school life aboard. At the same time, due to him having to constantly change schools, he developed strong communication skills and is able to easily strike up conversations even with strangers. Sometimes he has a habit of overthinking things when he's afraid of making mistakes or failing at something, but he usually manages to get out of these mental blocks quickly."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c78405"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44b37c57992d895d4312ca5840b706c513d02826a73cc4824518a462ec6785b3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6efc78868279f9902891e74f2b153451f350b747d99c26d8fbfe6281f0c9930c.webp","width":248,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82770","characterName":"花園 亨","sourceIds":{"vndbCharacterId":"c82770"},"originalCharacterName":"花園 亨","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Emi's older brother and Ryoutarou's childhood friend, whom he also sees as his younger brother. A very caring man who also likes teasing those around him, especially both Emi and Ryoutarou. His hobbies include weight training and cooking."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c82770"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/673b75c39ca03190328a2ab512f8eee6a3fc446171f1a053ac999099eadcc056.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/530e2d46fd5ea2e057ec6ff63630a7538c8d06de44125d341d569308bd4dd7de.webp","width":202,"height":256,"source":"static-detail"},"actors":[{"creditedName":"M.GT","creatorId":"vndb:s25341","sourcePersonId":"vndb:s25341","canonicalEntityId":"vndb:s25341","name":"M.GT","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80200","source":"vndb"}]},{"characterId":"char_vndb_c82771","characterName":"嶋林 優弥","sourceIds":{"vndbCharacterId":"c82771"},"originalCharacterName":"嶋林 優弥","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ryoutarou's classmate who sits behind and quickly became good friends with him. He looks rather ordinary and is good at reading the room. He really likes sunbathing and the spring weather."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c82771"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3ac6eaa399f7eff6de30b6f9e6b2033e25e6b51d485fb3de5c307ac12d256352.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07ceac6b447062d40167416a3a9c3339f3a9407600cc7529dce7926bcc84e02b.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"多日丘乃夢","creatorId":"vndb:s25348","source