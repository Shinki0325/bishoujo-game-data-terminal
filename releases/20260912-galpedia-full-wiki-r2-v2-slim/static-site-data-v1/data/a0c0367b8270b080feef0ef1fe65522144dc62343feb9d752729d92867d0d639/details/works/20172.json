aracterId":"char_c25995","characterName":"高城 結菜","sourceIds":{"bangumi":[{"characterId":"33836","match":"exact-normalized-name-in-linked-work","subjectId":"136178"}],"egsCharacterIds":["3641"],"vndbCharacterId":"c25995"},"originalCharacterName":"高城 結菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"pending-conflict","source":"vndb","value":"714"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Despite being a member of the dropout group, she is well liked by those around her. She is liked because of who she is and not her abilities. She was placed in the \"special\" classroom because of her unknown potential ability."},{"spoiler":false,"text":"Even though she in this classroom, she maintains a positive attitude. During the protagonist's training practicum, her friendly and comforting presence helped him get used to his new role. Her very presence makes the classroom a better place to be."},{"spoiler":false,"text":"The protagonist gradually becomes attracted to her and becomes a object of romantic interest. However, it is not clear if it because of her unknown P/A. Just like the protagonist, her parents passed away when she was young and is currently raised by non blood-related parents."},{"spoiler":false,"text":"She is pure, sincere, caring, high achiever, and pretty. From a man's point of view, she has perfect looks and personality. She is a symbol of envy from the girls, and she never shows her weak side."},{"spoiler":false,"text":"P/A: Connection"},{"spoiler":false,"text":"Hobbies: Cooking, reading, studying"},{"spoiler":false,"text":"Special Skill: Tennis talent"},{"spoiler":false,"text":"Likes: Sweet things, cute things, four leaf clovers"},{"spoiler":false,"text":"Dislikes: Bitter things, spicy things."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c25995"},{"segments":[{"spoiler":false,"text":"落ちこぼれ組に在籍しているのにも関わらず、周りからは一目置かれている。ただそれは能力上の話ではなく、彼女の人間的な部分。"},{"spoiler":false,"text":"表立った能力値はほぼ無いが、潜在能力値が高いため特殊教室に落とされた学生の一人。"},{"spoiler":false,"text":"『落ちこぼれ組』のレッテルを貼られていても、健気に前向きに物事を考えている。"},{"spoiler":false,"text":"主人公が実習で緊張している中、親しく接し和ませてくれる存在であり、なぜか彼女がいるだけで特殊教室の雰囲気も良いように思える。"},{"spoiler":false,"text":"そんな彼女に主人公も徐々に惹かれていき、恋愛の対象として見るようになっていく。しかしそれが彼女のP/Aなのかは定かではない。"},{"spoiler":false,"text":"ちなみに彼女も主人公同様、小さい頃に両親が他界し今の両親とは血の繋がりが無い。"}],"source":"egs","sourceCharacterId":"3641","sourceWorkId":"20172","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"3641","sourceWorkId":"20172","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"3641","sourceWorkId":"20172","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"3641","sourceWorkId":"20172","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"3641","sourceWorkId":"20172","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"45 kg","valueContext":null,"source":"egs","sourceCharacterId":"3641","sourceWorkId":"20172","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"birthday":[{"comparisonValue":"0714","source":"vndb","sourceCharacterId":"c25995","value":"714"},{"comparisonValue":"0714","source":"egs","sourceCharacterId":"3641","value":"7/14"},{"comparisonValue":"0704","source":"bangumi","sourceCharacterId":"33836","value":"7月4日"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/967c97f1a82a28e717b0b91c06da8cdac56202370f2717738d5db25b246ac35b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/764be44f3f178303470726bf5c838c076bc6ea87afa816ea0eeabeb13e2d6c9a.webp","width":94,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:136178:33836:8580:1","source":"bangumi"}]},{"characterId":"char_c25996","characterName":"三原 藍夏","sourceIds":{"bangumi":[{"characterId":"61593","match":"exact-normalized-name-in-linked-work","subjectId":"136178"}],"egsCharacterIds":["3642"],"vndbCharacterId":"c25996"},"originalCharacterName":"三原 藍夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"818"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"b"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the homeroom teacher for the “special\" classroom at Jougasaki academy. Just like the protagonist, she does not have a working ability."},{"spoiler":false,"text":"She originally possessed the ability \"mentalism,\" that affects the way people view themselves. The cause for her power going out of control is due to her father's comments about her."},{"spoiler":false,"text":"She is fond of the principal who saved her and tries her best at being a teacher for her sake, but the students low expectations of her make her feel bad."},{"spoiler":false,"text":"She is a kind, clean older woman with a nice smile. Her cute looks are enhanced by her glasses."},{"spoiler":false,"text":"P/A: Mentalism"},{"spoiler":false,"text":"Hobbies: Drinking at pubs, lazing around in her room"},{"spoiler":false,"text":"Special skills: pacifying people, trying her best at everything, cooking"},{"spoiler":false,"text":"Likes: Cooking, taking care of others, Principal Jougasaki, drinking"},{"spoiler":false,"text":"Dislikes: Gross and usual foods"},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c25996"},{"segments":[{"spoiler":false,"text":"城ヶ崎学園で『落ちこぼれ学級』の担任教師をしている。彼女もまた、主人公同様、無能力者。"},{"spoiler":false,"text":"元々は人の心に作用し、道しるべを示す能力『Mentalism』の持ち主だったがその能力が暴走し、肉体をも変化させてしまうようなディープなところまでP/Aが作用してしまい、それを止めるため現学園長の『城ヶ崎三月』によって能力を奪われた。"},{"spoiler":false,"text":"自分を救ってくれた学園長をとても慕っていて、彼女のためにも良き教師であろうとしている。"},{"spoiler":false,"text":"生徒達の事を親身になって考え、常にベストであろう方向へ導くべく努力をしているが、生徒達の方が無能力者である藍夏には期待をしておらず、その感情をぶつけられる事もしばしば。"}],"source":"egs","sourceCharacterId":"3642","sourceWorkId":"20172","spoiler":false},{"segments":[{"spoiler":false,"text":"城ヶ崎学園で 落ちこぼれ学級 の担任教師をしている。"},{"spoiler":false,"text":"彼女もまた主人公同様、無能力者。"},{"spoiler":false,"text":"元々は人の心に作用し、道しるべを示す能力 “Mentalism” の持ち主だったが、その能力が暴走し、肉体をも変化させてしまうようなディープなところまで P/A が作用してしまい、それを止めるため現学園長の 城ヶ崎三月 によって能力を奪われた。"},{"spoiler":false,"text":"自分を救ってくれた学園長をとても慕っていて、彼女のためにも良き教師であろうとしている。"},{"spoiler":false,"text":"学生たちのことを親身になって考え、常にベストであろう方向へ導くべく努力をしているが、学生たちのほうが無能力者である藍夏には期待をしておらず、その感情をぶつけられることもしばしば。"},{"spoiler":false,"text":"「気持ちはわかりますけど、ご自分の立場を忘れないようにしてくださいね」"}],"source":"bangumi","sourceCharacterId":"61593"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"61593","value":