me":"灰墨 イノリ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:155921","source":"vndb"},{"creditedName":"灰墨 イノリ","creatorId":"vndb:s4545","sourcePersonId":"vndb:s4545","canonicalEntityId":"vndb:s4545","name":"灰墨 イノリ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:155922","source":"vndb"}]},"cast":[{"characterId":"char_c13085","characterName":"月丘 彰","sourceIds":{"bangumi":[],"egsCharacterIds":["15916"],"vndbCharacterId":"c13085"},"originalCharacterName":"月丘 彰","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"75"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Grade: 2nd year, Sakura Group"},{"spoiler":false,"text":"Affiliation: The gardening club"},{"spoiler":false,"text":"Akira is a pretty average guy, with the exception of his feminine looks. He is kind, a donkan and also very hilarious, as sometimes he get’s toyed with by everyone because of his submissive demeanor."},{"spoiler":false,"text":"Akira's twin sister Akiko is sickly and is in the hospital, so she can’t go to school. The problem is that she’s been sick for too long and she may have to repeat the year, or even drop out of school. So his parents decided to send him, the splitting image of his sister, over to the all-girls prestigious school to go undercover as his sister, and live her life for a while so that when she comes back, she can take his place without dropping out of school or repeating a year."},{"spoiler":false,"text":"Since he gets easily swept away by the situation, he gave in to his parents' idea and he becomes more and more of a girl deeper in the story because of his attitude. Since Akira did go to replace Akiko without her permission, every time he makes a mistake he gets shouted at by his sister through the phone."},{"spoiler":false,"text":"Edited from Accany's review"}],"source":"vndb","sourceCharacterId":"c13085"},{"segments":[{"spoiler":false,"text":"双子の妹、月丘晶子として、乙女の園に潜り込むことになる本作の主人公。"},{"spoiler":false,"text":"女性のような容姿をしている点を除けば、普通の男子。"},{"spoiler":false,"text":"お嬢様学園では「男女」の違いと、「一般人とお嬢様」の二つの違いに苦労することになる。"},{"spoiler":false,"text":"性格は楽観的で物事をあまり深く考えない、基本的にサバサバしてる。"},{"spoiler":false,"text":"常識人だが、妹のことになると後先考えずに行動してしまうシスコン。"},{"spoiler":false,"text":"「大丈夫だよ、晶子。オレ達双子を見分けられる奴なんて、そういないって」"}],"source":"egs","sourceCharacterId":"15916","sourceWorkId":"11914","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c13085","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"15916","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"15916","value":"女性"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53a88836e6a8b6f01375b2925c7b2c2e13daf816bf42fadea9b5f01c6ab3c8b6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02eba9a018f58f336b07db76c796059ee962b5d5db24d44a8c5ad3c9c1f0d7ee.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"まき いづみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80813","source":"vndb"}]},{"characterId":"char_c80851","characterName":"無敗の白","sourceIds":{"bangumi":[{"characterId":"69829","match":"exact-normalized-name-in-linked-work","subjectId":"274152"}],"egsCharacterIds":["2