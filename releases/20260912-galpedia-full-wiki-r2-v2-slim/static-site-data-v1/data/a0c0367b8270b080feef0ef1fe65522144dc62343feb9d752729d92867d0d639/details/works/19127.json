edirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"1ヶ月前に獣士になったばかりの新米。"},{"spoiler":false,"text":"同期のノエルと共に育て上げられ、互いにライバル視している。"},{"spoiler":false,"text":"長剣を好んで使い、元気な切り込み隊長、及びムードメーカーとなっている。"},{"spoiler":false,"text":"天才肌のノエルに戦力では劣ってしまうも、持ち前の明るさとガッツでカバー。"},{"spoiler":false,"text":"肝が座っており、よくモンスターに無茶な戦いを挑んでは、仲間たちを心配させていた。"},{"spoiler":false,"text":"大切な獣士仲間や家族を奪ったモンスターを狩る為、ノエルと共に修行の旅に出る。"}],"source":"egs","sourceCharacterId":"4014","sourceWorkId":"19127","spoiler":false},{"segments":[{"spoiler":false,"text":"1ヵ月前に獣士になったばかりの新米。"},{"spoiler":false,"text":"同期のノエルと共に育て上げられ、互いにライバル視している。"},{"spoiler":false,"text":"長剣を好んで使い、元気な切り込み隊長、及びムードメーカーとなっている。"},{"spoiler":false,"text":"天才肌のノエルに戦力では劣ってしまうものの、持ち前の明るさとガッツでカバー。"},{"spoiler":false,"text":"肝が座っており、よくモンスターに無茶な戦いを挑んでは、仲間たちを心配させていた。"},{"spoiler":false,"text":"大切な獣士仲間や家族を奪ったモンスターを狩るため、ノエルと共に修行の旅に出る。"}],"source":"bangumi","sourceCharacterId":"61680"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cdcde2501dafdb7b3978f2dd565463f0b18addec2cbee6d25502757662ae694a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcfe65dee0815e1cb4a4baa7ef216198146a080788cdbfbd58f82ba7e52b336b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:81570:61680:4799:1","source":"bangumi"}]},{"characterId":"char_c24753","characterName":"ノエル","sourceIds":{"bangumi":[{"characterId":"61681","match":"exact-normalized-name-in-linked-work","subjectId":"81570"}],"egsCharacterIds":["4015"],"vndbCharacterId":"c24753"},"originalCharacterName":"ノエル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アーニャと共に育ち、獣士としても共に育て上げられた。"},{"spoiler":false,"text":"1ヶ月前に正式に獣士になったばかりの新米だが、凄腕。"},{"spoiler":false,"text":"アーニャとはお互いの足りない所を補い合い、良きライバルとして競っている。"},{"spoiler":false,"text":"短剣を使用し、主にサポートとして動き回っている。"},{"spoiler":false,"text":"新米ながら、頼れるお姉さんとして、年上からも頼られている。"},{"spoiler":false,"text":"自分には無い突飛な作戦、勇気、ガッツなどをアーニャに見出し、内心羨ましがり、落ち込む時もある。"},{"spoiler":false,"text":"家族は幼い頃に亡くなり、獣士団を自分の居場所としていたが、1晩の間に全てを奪われ、アーニャと共に復讐の旅に出る。"}],"source":"egs","sourceCharacterId":"4015","sourceWorkId":"19127","spoiler":false},{"segments":[{"spoiler":false,"text":"アーニャと共に育ち、獣士としても共に育て上げられた。"},{"spoiler":false,"text":"1ヵ月前に正式に獣士になったばかりの新米だが、凄腕。"},{"spoiler":false,"text":"アーニャとはお互いの足りないところを補い合い、良きライバルとして競っている。"},{"spoiler":false,"text":"短剣を使用し、主にサポートとして動き回っている。"},{"spoiler":false,"text":"新米ながら頼れるお姉さんとして、年上からも頼られている。"},{"spoiler":false,"text":"自分には無い突飛な作戦、勇気、ガッツなどをアーニャに見出し、内心羨ましがり、落ち込む時もある。"},{"spoiler":false,"text":"家族は幼い頃に亡くなり獣士団を自分の居場所としていたが、一晩の間にすべてを奪われ、アーニャと共に復讐の旅に出る。"}],"source":"bangumi","sourceCharacterId":"61681"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b388962135a86c5c04340554c1d96494933eb615dce3779cb86c8b61d7db0b0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a9995d156f14042c547f466c38b2720deab8ce13fbc088d9b9296437111caaf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:81570:61681:4490:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p2342","sourceCompanyId":"egs:brand