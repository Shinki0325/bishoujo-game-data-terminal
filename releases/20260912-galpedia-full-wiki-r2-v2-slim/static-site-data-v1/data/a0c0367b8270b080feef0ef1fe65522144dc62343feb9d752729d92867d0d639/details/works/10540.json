:false,"text":"「絶対に許さないわ……ひいいっ、ダメ、動かないで、くああっ！」"}],"source":"egs","sourceCharacterId":"18644","sourceWorkId":"10540","spoiler":false},{"segments":[{"spoiler":false,"text":"ややぶっきらぼうながら、しっかりとした口調。"},{"spoiler":false,"text":"端正なショートカットに切れ長でやや吊り目。"},{"spoiler":false,"text":"実は元競泳選手の父親と元シンクロナイズドスイミング選手の母親を持ち、水泳界のサラブレットとも呼ばれている。"},{"spoiler":false,"text":"百メートル自由形で全国大会二連覇をしていて、三連覇にも期待がかかっている。"},{"spoiler":false,"text":"学校の水泳部に籍を置いているが、部活にはほとんど参加せず、幼い頃から通っているスイミングクラブで練習している。"}],"source":"bangumi","sourceCharacterId":"61582"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"18644","sourceWorkId":"10540","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"18644","sourceWorkId":"10540","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"18644","sourceWorkId":"10540","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"18644","sourceWorkId":"10540","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"18644","sourceWorkId":"10540","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26c50ec7071e672144f0106578f358d08e905c3a7fbada8d294a7deed693c7ec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4fce667bd588590449115221e58ec985c772c43e2cdb7e9ad0f531542b3af871.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219229:61582:4489:1","source":"bangumi"}]},{"characterId":"char_c47983","characterName":"森野 胡桃","sourceIds":{"bangumi":[{"characterId":"61583","match":"exact-normalized-name-in-linked-work","subjectId":"219229"}],"egsCharacterIds":["18645"],"vndbCharacterId":"c47983"},"originalCharacterName":"森野 胡桃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"O"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美玲に憧れ、水泳部に入部した一年生。"},{"spoiler":false,"text":"しかし、スポーツ音痴で全く泳げないため仮部員扱いになっている。"},{"spoiler":false,"text":"基本的に部員は競泳水着着用なのだが、仮部員扱いなので、スクール水着で部活に参加。"},{"spoiler":false,"text":"泣き虫で甘えん坊だが、美玲のことになると人一倍頑張る面も。"},{"spoiler":false,"text":"「痛いっ、痛いよぉっ、た、助けて……うああっ、み、美玲先輩ぃぃっ！」"}],"source":"egs","sourceCharacterId":"18645","sourceWorkId":"10540","spoiler":false},{"segments":[{"spoiler":false,"text":"やや舌足らずで甘えた口調。"},{"spoiler":false,"text":"ふわっとした柔らかいストレートロングで少しタレ気味の大きな目。"},{"spoiler":false,"text":"まったく泳げないのに、美玲に憧れて水泳部に入部した。"},{"spoiler":false,"text":"美玲がほとんど部活に来ない事を知ってショックを受けるが、辞めると言い出せず、泳げないままの状態で部活に参加し続けている。"},{"spoiler":false,"text":"今回の夏合宿には美玲が参加するということで期待している。"},{"spoiler":false,"text":"泣き虫だが、憧れの美玲の為に自らの体を犠牲にするなど、芯の強い部分もある。"}],"source":"bangumi","sourceCharacterId":"61583"}],"profileFacts":[{"label":"胸围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"18645","sourceWorkId":"10540","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCharacterId":"18645","sourceWorkId":"10540","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"147 cm","valueContext":null,"source":"egs","sourceCharacterId":"18645","sourceWorkId":"10540","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"18645","sourceWorkId":"10540","sourceField":null,"scoped":true},{"label"