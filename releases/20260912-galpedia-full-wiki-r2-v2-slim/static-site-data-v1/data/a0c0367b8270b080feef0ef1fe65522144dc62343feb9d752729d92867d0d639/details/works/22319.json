398936"}]},"originalCharacterName":"リア","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"レンの幼なじみで、お姉さん的な存在。面倒見が良く、いつもレンの世話を焼いていた。彼女も魔族としての封印を解かれ、漆黒の翼を広げて羽ばたく。"}],"source":"bangumi","sourceCharacterId":"133957"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/000ef972c50ba55ead4d3ed73c84045d4c62d0ce0e220a61e0ad6696dcb4a72d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d93ec43608f6c43694fa82540e4a259e50707ba74b8d766601dada5fc1b7b9d.webp","width":150,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_133958","characterName":"シルフィ","sourceIds":{"bangumi":[{"characterId":"133958","match":"source-roster","subjectId":"398936"}]},"originalCharacterName":"シルフィ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"レンの前に現れる人間の少女。魔族から遠ざけられていたため、彼らに対して偏見を持っている。性格は明るく活動的。父親は５大勇者の一人、ガーランドである。"}],"source":"bangumi","sourceCharacterId":"133958"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34f00a7e532295ff8a4056ed60ef7304d2f92ecaef1077deced16751d18c7876.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/100500e43f1421bf33913afc2023072cdba61fe78ec620016d51064e1d31d18b.webp","width":150,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_133959","characterName":"ハイゼンガルド","sourceIds":{"bangumi":[{"characterId":"133959","match":"source-roster","subjectId":"398936"}]},"