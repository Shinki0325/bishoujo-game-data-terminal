:"FullMooN","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:63767","source":"vndb"},{"creditedName":"えどがわ るる","creatorId":"vndb:s47852","sourcePersonId":"vndb:s47852","canonicalEntityId":"vndb:s47852","name":"えどがわ るる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:63769","source":"vndb"},{"creditedName":"itto","creatorId":"vndb:s49733","sourcePersonId":"vndb:s49733","canonicalEntityId":"vndb:s49733","name":"itto(童天.WEB)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:63770","source":"vndb"}]},"cast":[{"characterId":"char_c38701","characterName":"上坂 梨乃","sourceIds":{"bangumi":[{"characterId":"212665","match":"exact-normalized-name-in-linked-work","subjectId":"239545"}],"egsCharacterIds":["11324"],"vndbCharacterId":"c38701"},"originalCharacterName":"上坂 梨乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"東吾の幼馴染。"},{"spoiler":false,"text":"子供の頃から良い慣れている『トーゴ』という名前で東吾を呼ぶ。"},{"spoiler":false,"text":"東吾とは家も隣で、小さい頃から友達として暮らしてきたので、今でも何か困ると東吾へ頼る癖がある。"},{"spoiler":false,"text":"思春期に入って少し東吾と距離を置いたが、ずっと東吾の事が好き。"},{"spoiler":false,"text":"明るく元気で、男子や女子の区別無く接する人柄のため、男女とわず人気がある。"},{"spoiler":false,"text":"部活には所属して居なかったのだが、楢識紫によって『撫子会』へ入会させられてしまう。"},{"spoiler":false,"text":"本来の紫の目的は、主人公である東吾であったのだが、東吾の調査をしている途中で、梨乃の存在が浮上し、紫としては梨乃を排除するよりも、巻き込んだ方がいいと判断し『撫子会』へ入会をさせられる。"},{"spoiler":false,"text":"『撫子会』という切っ掛けを得て、自分の気持ちを伝える覚悟をすることになる。"}],"source":"egs","sourceCharacterId":"11324","sourceWorkId":"14724","spoiler":false},{"segments":[{"spoiler":false,"text":"タイプ：典型的な元気ヒロイン　 趣味：テニス"},{"spoiler":false,"text":"好きなもの：トーゴ関連　 嫌いなもの：暗いところ、暗がり"},{"spoiler":false,"text":"東吾の幼なじみ。"},{"spoiler":false,"text":"明るく元気で男女の区別無く接する人柄のため、両性から人気がある。"},{"spoiler":false,"text":"今でも○○の頃から言い慣れた 「トーゴ」 という愛称で主人公を呼んでいる。"},{"spoiler":false,"text":"東吾とは家も隣で、小さい頃から友達として暮らしてきたので、今でも何か困ると東吾に頼る癖がある。"},{"spoiler":false,"text":"思春期に入って少し東吾と距離を置いたが、ずっと東吾のことが好き。"},{"spoiler":false,"text":"ムリヤリ入らされた 『撫子会』 がキッカケで東吾に自分の気持ちを伝えることになってしまう。"},{"spoiler":false,"text":"しかし色々な順番をすっ飛ばしてエッチしてしまい、戸惑いも○く残ってしまうが……。"}],"source":"bangumi","sourceCharacterId":"212665"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/737c6e544d988fe2d0cee177356e5064156d82f449d643b6c5f982591a5094cd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3d7b8361c717efadae6f918a007ed96b87b9b23426ccf6a0ec1f618a4bceadc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:239545:212665:15684:1","source":"bangumi"}]},{"characterId":"char_c38702","characterName":"ゆかりん","sourceIds":{"bangumi":[{"characterId":"212666","match":"exact-normalized-name-in-linked-work","subjectId":"239545"}],"egsCharacterIds":["11325"],"vndbCharacterId":"c38702"},"originalCharacterName":"ゆかりん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"才識兼美の文字をそのまま人にした様な女性。"},{"spoiler":false,"text":"『撫子会』に在籍しており、会長も勤めている。"},{"spoiler":false,"text":"大人しく柔らかい物腰ではあるがどこか迫力も備わっている。"},{"spoiler":false,"text":"大変頭がよく、学園内でも成績は常にトップクラス。"},{"spoiler":false,"text":"また親が政治家ということもあり、教師には並々ならぬ信用がある。"},{"spoiler":false,"text":"その信用を利用して『撫子会』を行っている。"},{"spoiler":false,"text":"会員は先日まで、紫を合わせて四人のみとなっていたが、新たに東吾と梨乃を入会させる。"},{"spoiler":false,"text":"東吾と梨乃の入会については、本人達の意思確認より前に、紫からの数ヶ月に及ぶ身辺調査の結果が会員に伝えられており、入会については全員のOKをとっている。"},{"spoiler":false,"text":"エッチの経験は豊富に見えて実は耳年増。本番エッチは男性相手は初めて。"},{"spoiler":false,"text":"数ヶ月に及ぶ調査の結果と、会員全員の審査の結果を経て、東吾が「会員」として相応しいと結論付けていることもあり、東吾の調査は完璧で、東吾の恥ずかしい秘密もいくつかばれている。"},{"spoiler":false,"text":"飴と鞭の誘い文句で、東吾と梨乃を入会させてしまう。"}],"source":"egs","sourceCharacterId":"11325","sourceWorkId":"14724","spoiler":false},{"segments":[{"spoiler":false,"text":"タイプ：ミス・パーフェクト　 趣味：お花、お茶、お琴、など"},{"spoiler":false,"text":"好きなもの：花、猫、琴子　 嫌いなもの：いいわけをする人間、潔くないこと"},{"spoiler":false,"text":"才識兼美の文字をそのまま人にしたような女性。"},{"spoiler":false,"text":"大変頭が良く、学園内でも成績は常にトップクラス。また親が政治家ということもあり、教師からも並々ならぬ信用を置かれている。"},{"spoiler":false,"text":"その信用を利用して、上流階級の学生同士が相互扶助を行う 『撫子会』 を発足したが……。"},{"spoiler":false,"text":"飴と鞭の誘い文句で、東吾と梨乃を入会させてしまう。"}],"source":"bangumi","sourceCharacterId":"212666"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44eafb7c88042620be7a0f2f6b3cf35e8e90160c8053dc5322df8fe2fec38073.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/dab99bbad622933d96d8ef1a51d1b08d26a8988de29b89b41b3df3da15e9ceb8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"相原 詩織","creatorId":"vndb:s3624","sourcePersonId":"vndb:s3624","canonicalEntityId":"vndb:s3624","name":"相原 詩織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35722","source":"vndb"}]},{"characterId":"char_c38703","characterName":"間条 琴子","sourceIds":{"bangumi":[{"characterId":"212667","match":"exact-normalized-name-in-linked-work","subjectId":"239545"}],"egsCharacterIds":["11326"],"vndbCharacterId":"c38703"},"originalCharacterName":"間条 琴子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"眼鏡と三つ編みの、少々やぼったい感じの女の子。"},{"spoiler":false,"text":"自分に自信が無い上に、真面目な性格も手伝って、いつも周りよりも一歩引いた立ち位置にいる女の子。"},{"spoiler":false,"text":"紫とは前の学年からクラスメイトであり、それを機に紫から琴子と友好を結んだ。"},{"spoiler":false,"text":"大人しい性格で、頼まれると嫌といえない。"},{"spoiler":false,"text":"そのために貧乏くじをコレまで何度も引いて苦労してきている。"},{"spoiler":false,"text":"また、自分の容姿に自信がもてず、太っている体（普通はグラマーと言う）もコンプレックスがある。"},{"spoiler":false,"text":"その自分と友達になってくれた紫の事は、好きだと思っている。一番の友達。"},{"spoiler":false,"text":"紫は琴子の自信のなさも、性格も、そして本当は「誰かと結ばれたい」という思いも知っており、それゆえに『撫子会』へ入部させた。"},{"spoiler":false,"text":"初めての相手は、紫。"},{"spoiler":false,"text":"こういう琴子と関係を持つ相手という事もあり「会員」の厳選は徹底されていた。"}],"source":"egs","sourceCharacterId":"11326","sourceWorkId":"14724","spoiler":false},{"segments":[{"spoiler":false,"text":"タイプ：気弱な子羊　 趣味：絵を描くこと"},{"spoiler":false,"text":"好きなもの：紫、絵　 嫌いなもの：弱い自分、男の子"},{"spoiler":false,"text":"眼鏡で三つ編みの、少々やぼったい感じのする女の子。"},{"spoiler":false,"text":"おとなしく、頼まれるとイヤと言えない性格のため貧乏くじを今まで何度も引いて苦労してきている。"},{"spoiler":false,"text":"また自分の容姿に自信が持てず、太っている身体 （普通はグラマーと言う） にもコンプレックスを持っている。"},{"spoiler":false,"text":"紫とは前の学年からクラスメイトであり、それを機に紫から友好を結んでもらった。"},{"spoiler":false,"text":"そんな彼女を一番の友達だと思っており、誘われた 『撫子会』 にも入会している。"}],"source":"bangumi","sourceCharacterId":"212667"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edb62c72fdfcc626155e5666b23f854a4ce1b2d56dc6cfd94188afddef638ae0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5dc40c6c1403b192122b579eaf03cae4df3598d4e3e38a41faf4af1ffa145733.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"霧島はるな","creatorId":"vndb:s2698","sourcePersonId":"vndb:s2698","canonicalEntityId":"vndb:s2698","name":"霧島はるな(水無月じゅん)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:239545:212667:13771:1","source":"bangumi"}]},{"characterId":"char_c38704","characterName":"うるる","sourceIds":{"bangumi":[{"characterId":"212669","match":"exact-normalized-name-in-linked-work","subjectId":"239545"}],"egsCharacterIds":["11327"],"vndbCharacterId":"c38704"},"originalCharacterName":"うるる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"令嬢と呼ばれるセレブな家庭の娘。"},{"spoiler":false,"text":"好奇心が大盛で奔放に生きているが楢識の誘いで『撫子会』に入会する。"},{"spoiler":false,"text":"基本的に我がママ＆命令口調。"},{"spoiler":false,"text":"学年で言えば主人公より下なのだが、改めることはない。"},{"spoiler":false,"text":"セレブな家柄で、それを鼻にかけて金の力をちらつかせるところがあり、その力に逆らえるような相手を紫以外に知らない。"},{"spoiler":false,"text":"友人と呼べる相手が、お金に集るような友達しかいなかったが、紫と出会って『撫子会』に入り、それ以外の関係もあると理解する。"},{"spoiler":false,"text":"結構、仲間思い。"},{"spoiler":false,"text":"紫の身辺調査報告で、東吾のことに興味を持ち、気に入ってしまう。"},{"spoiler":false,"text":"男性に興味を持つというのは初めてで、東吾とするまでは処女。"}],"source":"egs","sourceCharacterId":"11327","sourceWorkId":"14724","spoiler":false},{"segments":[{"spoiler":false,"text":"タイプ：いわゆるツンデレ　 趣味：チェス"},{"spoiler":false,"text":"好きなもの：勝負や賭け事　 嫌いなもの：負けること"},{"spoiler":false,"text":"令嬢と呼ばれるセレブな家庭の娘。"},{"spoiler":false,"text":"好奇心が旺盛で自由奔放に生きている。意外と仲間思い。"},{"spoiler":false,"text":"基本的にワガママ＆命令口調。学年は主人公より下なのだが、改めることはない。"},{"spoiler":false,"text":"今まで周囲にはお金に寄ってくるような者しかいなかったが、紫と出会って 『撫子会』 に入り、それ以外の関係もあると理解する。"},{"spoiler":false,"text":"東吾に興味を持ち、気に入ってしまう。"}],"source":"bangumi","sourceCharacterId":"212669"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4497d8fd778e7993f192d53e7e7709702a138b77dbe2faa63adc9797f6bc9dd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd2691c04bd6d88109bfaa94ac7fe1063ae5e1eae0359b3fdc893aba909fe7e0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七生 みこと","creatorId":"vndb:s1697","sourcePersonId":"vndb:s1697","canonicalEntityId":"vndb:s1697","name":"七生 みこと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:35720","source":"vndb"}]},{"characterId":"char_c38705","characterName":"ひな","sourceIds":{"bangumi":[{"characterId":"212670","match":"exact-normalized-name-in-linked-work","subjectId":"239545"}],"egsCharacterIds":["11328"],"vndbCharacterId":"c38705"},"originalCharacterName":"ひな","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"喜怒哀楽などの変化が乏しい、大人しい系の女の子。"},{"spoiler":false,"text":"仲の良い友人などがおらず、一人で読書しているような子で、自分から回りへ干渉しようとはしない。一人が苦にならない性格。"},{"spoiler":false,"text":"わりと不思議ちゃんで、紫に誘われてあっさり『撫子会』へ入会する。"},{"spoiler":false,"text":"物語が楽しめる本が好きで、よく読んでいる。"},{"spoiler":false,"text":"当然、男性経験もなく東吾とエッチするまで処女。"},{"spoiler":false,"text":"紫により、エッチというモノに興味が出てきているらしく、東吾の参加は自分の欲求を果たすのにも丁度良いと考えている。"},{"spoiler":false,"text":"「物語」に出てくる服を着て、その役になりきる――という、いわゆる「コスプレ」趣味がある。"},{"spoiler":false,"text":"しかし、物語の役になるために衣装を着るのではなく、あくまで「ひなり」が、そのキャラの立場なら…という"},{"spoiler":false,"text":"“IF”のシチュエーションを楽しむという一風変ったコスプレだ。"}],"source":"egs","sourceCharacterId":"11328","sourceWorkId":"14724","spoiler":false},{"segments":[{"spoiler":false,"text":"タイプ：無表情、不思議キャラ　 趣味：占い"},{"spoiler":false,"text":"好きなもの：不思議なこと、ミステリー、コスプレ　 嫌いなもの：現実的なこと、勉○"},{"spoiler":false,"text":"喜怒哀楽などの変化が乏しい、もの静かな女の子。"},{"spoiler":false,"text":"仲の良い友人はおらず、一人で読書ばかりして自分から他者へ干渉しようとはしない。"},{"spoiler":false,"text":"物語のある本が好きで、よく読んでいる。"},{"spoiler":false,"text":"わりと不思議ちゃん。紫に誘われてあっさり 『撫子会』 へ入会する。"},{"spoiler":false,"text":"紫のおかげでエッチというモノに興味が湧いたらしく、東吾の存在は自分の欲求を果たすのに丁度いいと考えている。"}],"source":"bangumi","sourceCharacterId":"212670"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5ab25adad12086777a035e28d727d863de511c8a24040432c2a82efa01d