db:s12989","name":"サクライユウイチ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:47210","source":"vndb"},{"creditedName":"サクライユウイチ","creatorId":"vndb:s12989","sourcePersonId":"vndb:s12989","canonicalEntityId":"vndb:s12989","name":"サクライユウイチ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:47212","source":"vndb"}]},"cast":[{"characterId":"char_c75244","characterName":"和泉 絢","sourceIds":{"bangumi":[{"characterId":"59068","match":"exact-normalized-name-in-linked-work","subjectId":"229215"}],"egsCharacterIds":["24494"],"vndbCharacterId":"c75244"},"originalCharacterName":"和泉 絢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の同級生。"},{"spoiler":false,"text":"広義の意味でマイペースな女の子。"},{"spoiler":false,"text":"幼い頃に、実兄を亡くしているが、まだ幼かった当時の彼女には、兄の死が理解できなかった。"},{"spoiler":false,"text":"しかし、大きく成長した今でも、その兄の死を直視しようとしていない。"}],"source":"egs","sourceCharacterId":"24494","sourceWorkId":"3557","spoiler":false},{"segments":[{"spoiler":false,"text":"進也の同級生。"},{"spoiler":false,"text":"広義の意味でマイペースな少女。"},{"spoiler":false,"text":"人に迷惑をかけても「お互い様だよね？」と言い放つ割に、人に迷惑をかけられそうになる時にはナチュラルに回避しているという、厄介な人物。もっとも受けた恩を忘れることはなく、別の形できっちり返す。唯一の問題は、その返し方が別の厄介事を産む可能性があることだけである。"},{"spoiler":false,"text":"幼い頃に実の兄を失っている。"},{"spoiler":false,"text":"だが幼かった当時の彼女にはそれが理解できず、そしてその認識は今現在も続いている。"}],"source":"bangumi","sourceCharacterId":"59068"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/744179b0a28c78473a1cf7b6d3cce0fed64871b634dbc9b045c42cfd763a5f6f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b87749d6f32819fdcd8cb1bb283fcc1f75471dfbc0edd4df9a99b56c248f3961.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"峯香織","creatorId":"vndb:s20187","sourcePersonId":"vndb:s20187","canonicalEntityId":"vndb:s20187","name":"峯香織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229215:59068:5481:1","source":"bangumi"},{"creditedName":"和泉 あやか","creatorId":"vndb:s493","sourcePersonId":"vndb:s493","canonicalEntityId":"vndb:s493","name":"和泉あやか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26103","source":"vndb"}]},{"characterId":"char_c75245","characterName":"紗渉 梢","sourceIds":{"bangumi":[{"characterId":"59069","match":"exact-normalized-name-in-linked-work","subjectId":"229215"}],"egsCharacterIds":["24495"],"vndbCharacterId":"c75245"},"originalCharacterName":"紗渉 梢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の先輩。"},{"spoiler":false,"text":"口数が少なく穏やかそうに見えて、リアリストで、かなり辛らつな弁舌を見せるのが、彼女の持ち味。"},{"spoiler":false,"text":"基本的には、人当たりもよく、先生や同級生からの信任も厚い。"},{"spoiler":false,"text":"意外にそそっかしく、歩いているときに机や壁にぶつかってしまうこともしばしば。"}],"source":"egs","sourceCharacterId":"24495","sourceWorkId":"3557","spoiler":false},{"segments":[{"spoiler":false,"text":"一見口数が少なく穏やかそうな進也の一学年上の先輩。"},{"spoiler":false,"text":"だがその実、柔らかい口調にきつい内容を添えるリアリスト。その辛辣な弁舌を前に、淡い憧れを砕かれた者も少なくない。"},{"spoiler":false,"text":"とはいえ、無分別に攻撃的というわけではなく、常時は人当たりもよく、また先生方や同級生からの信任も厚い。そのせいか、やや大人びた雰囲気を自然と身に纏っている。"},{"spoiler":false,"text":"意外とそそっかしい一面もあり、歩いてる時に机や壁にぶつかってしまう時もある。"}],"source":"bangumi","sourceCharacterId":"59069"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad4e0ce8ec782309ff1122cc19a499eac51de819f8f1c586e1051aaa87467c6a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/deb4e1fcc834a7e6b7b28aa88dc4f149a18312599bbed8a18c80cda1a69776d2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅野るり","creatorId":"vndb:s1239","sourcePersonId":"vndb:s1239","canonicalEntityId":"vndb:s1239","name":"浅野 るり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229215:59069:3946:1","source":"bangumi"}]},{"characterId":"char_c75246","characterName":"桜庭 かざり","sourceIds":{"bangumi":[{"characterId":"59070","match":"exact-normalized-name-in-linked-work","subjectId":"229215"}],"egsCharacterIds":["24496"],"vndbCharacterId":"c75246"},"originalCharacterName":"桜庭 かざり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の親友・公生の妹。"},{"spoiler":false,"text":"主人公と兄が、彼女が物心つく前から親しかったこともあり、主人公を「お兄ちゃん」と呼んで慕っている。"},{"spoiler":false,"text":"性格は、普段はやや引っ込み思案だが、主人公の前では緊張しないことから、明朗快活な本当の自分を見せる。"}],"source":"egs","sourceCharacterId":"24496","sourceWorkId":"3557","spoiler":false},{"segments":[{"spoiler":false,"text":"進也の親友、公生の妹。"},{"spoiler":false,"text":"兄である公生と進也は、物心つく前からの親友だった。"},{"spoiler":false,"text":"そのおかげでかざりは、進也とは生まれた時からのつき合いになる。"},{"spoiler":false,"text":"それはかざりにとってひどく嬉しいことであり、公生がいてよかった唯一の出来事だと公言している。普段はやや引っ込み思案だが、進也の前では緊張しないのか明るく健気な自分をストレートに出している。"},{"spoiler":false,"text":"幼い頃からの付き合いのせいか、進也のことを「お兄ちゃん」と呼び慕っている。ちなみに実の兄である公生のことは「ハム」というあだ名で呼び捨てている。"}],"source":"bangumi","sourceCharacterId":"59070"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a06e6a0d8cd6291a5bc8cee1b646b7853351af0307e22a80c26970ae5559d09a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd76da7821ae8d108e80afad5a6ff082f7cbb99c7dd2858db40fb27f7631ac99.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"谷井あすか","creatorId":"vndb:s657","sourcePersonId":"vndb:s657","canonicalEntityId":"vndb:s657","name":"谷井 あすか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229215:59070:4593:1","source":"bangumi"}]},{"characterId":"char_c75247","characterName":"橘 日和","sourceIds":{"bangumi":[{"characterId":"59071","match":"exact-normalized-name-in-linked-work","subjectId":"229215"}],"egsCharacterIds":["24497"],"vndbCharacterId":"c75247"},"originalCharacterName":"橘 日和","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"舞台となる学校の新任教師。"},{"spoiler":false,"text":"生真面目でありながら不器用で、自分が思っているほど大人ではなく、自縄自縛に陥ることもしばしば。"},{"spoiler":false,"text":"主人公と交際していたが、主人公の通う学校に赴任してきてから、教師と生徒という関係ということからも他人の目もあり、疎遠になってしまった。"}],"source":"egs","sourceCharacterId":"24497","sourceWorkId":"3557","spoiler":false},{"segments":[{"spoiler":false,"text":"この学校の新任教師であり、休校なのに登校してしまった学生の対処役として学校にきた人物でもあり、かつては進也の彼女でもあった人。"},{"spoiler":false,"text":"赴任してきたことがきっかけで、進也との関係が拗れてしまう。しかし決定的な答えは出さないまま半年を過ごしてしまう。"},{"spoiler":false,"text":"生真面目で不器用で、自分で思っている程大人ではない。"},{"spoiler":false,"text":"限界を知らないくせに決めつけている面もあり、自縄自縛に陥ることも少なくない。"}],"source":"bangumi","sourceCharacterId":"59071"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/adca146aefc218c7bcfd7866e53e952c3f001a1027f3b5fa90404f592ee98909.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/359be071742566c44f96433a355b563c50fef3714f94a22c8a2e70992103a265.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一宮桜","creatorId":"vndb:s491","sourcePersonId":"vndb:s491","canonicalEntityId":"vndb:s491","name":"一宮 桜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229215:59071:44717:1","source":"bangumi"}]},{"characterId":"char_c75248","characterName":"上村 蕗乃","sourceIds":{"bangumi":[{"characterId":"59072","match":"exact-normalized-name-in-linked-work","subjectId":"229215"}],"egsCharacterIds":["24498"],"vndbCharacterId":"c75248"},"originalCharacterName":"上村 蕗乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"休校となった朝に、行き倒れになっていた下級生の少女。"},{"spoiler":false,"text":"そんな自分を保健室に運び込んでくれた主人公に一目惚れしたのか、主人公を慕って懐いて来る。"},{"spoiler":false,"text":"性格は、朗らかで、尋常じゃないほどポジティブ。"}],"source":"egs","sourceCharacterId":"24498","sourceWorkId":"3557","spoiler":false},{"segments":[{"spoiler":false,"text":"休校になった朝、昇降口で行き倒れていた下級生。"},{"spoiler":false,"text":"助けてもらったせいか、進也のことを慕っていつもつきまとう。"},{"spoiler":false,"text":"行き倒れという、レアながらも幸福と言い難い状況で始まった学園生活なのに、誰よりも現状を楽しんでいる。"},{"spoiler":false,"text":"そのことだけでも、前向きで朗らかな性格だということが分かる…良く言えば。"},{"spoiler":false,"text":"そのバカバカしいまでの前向きさは、有無を言わせぬ力を持っている。"}],"source":"bangumi","sourceCharacterId":"59072"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9fc035d436b9c97ac52fd3c2564bd7ceed8362e807de650a92d50417fb875a2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02b583c0346d70fba324d429ba92ad1e91c36451a7d3ef11d53b67e86af403d0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井清己","creatorId":"vndb:s771","sourcePersonId":"vndb:s771","canonicalEntityId":"vndb:s771","name":"浅井 清己","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229215:59072:4336:1","source":"bangumi"}]},{"characterId":"char_c75249","characterName":"桜庭 公生","sourceIds":{"bangumi":[{"characterId":"59074","match":"exact-normalized-name-in-linked-work","subjectId":"229215"}],"egsCharacterIds":["24500"],"vndbCharacterId":"c75249"},"originalCharacterName":"桜庭 公生","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"進也の親友。"},{"spoiler":false,"text":"「俺達って、親友か？」「いや違うだろ」「だよなー」と受け答えする悪友同士。その波長の合い加減を疑う者は周囲に一人もいない。 意外なことに、女性関係はそこそこ手広い。その分深くはないが、それは単純に気が向かないせいであり、男同士でバカをやってる方が楽しいだけのこと。それを進也に言わせれば、「つまり男の方が好きなんだあいつは」ということになる。 かざりのことは、単なる妹だと思ってる。もちろん可愛くもあるし大事でもあるが、シスコン的な気持ちは一切ない。"}],"source":"egs","sourceCharacterId":"24500","sourceWorkId":"3557","spoiler":false},{"segments":[{"spoiler":false,"text":"進也の親友。"},{"spoiler":false,"text":"「俺達って、親友か？」「いや違うだろ」「だよなー」と受け答えする悪友同士。その波長の合い加減を疑う者は周囲に一人もいない。"},{"spoiler":false,"text":"意外なことに、女性関係はそこそこ手広い。その分深くはないが、それは単純に気が向かないせいであり、男同士でバカをやってる方が楽しいだけのこと。それを進也に言わせれば、「つまり男の方が好きなんだあいつは」ということになる。"},{"spoiler":false,"text":"かざりのことは、単なる妹だと思ってる。もちろん可愛くもあるし大事でもあるが、シスコン的な気持ちは一切ない。"}],"source":"bangumi","sourceCharacterId":"59074"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0dfb1e8e65812feb3417c4103192dd700f04dd72a36b8ffae9312b182c712e69.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09678ffae93b7c01efc2e5ac282a772ed9bcb0ecb6f259a237385699f83335c6.webp","width":244,"height":256,"source":"static-detail"},"actors":[{"creditedName":"坪井智浩","creatorId":"vndb:s254","sourcePersonId":"vndb:s254","canonicalEntityId":"vndb:s254","name":"坪井 智浩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229215:59074:4968:1","source":"bangumi"}]},{"characte