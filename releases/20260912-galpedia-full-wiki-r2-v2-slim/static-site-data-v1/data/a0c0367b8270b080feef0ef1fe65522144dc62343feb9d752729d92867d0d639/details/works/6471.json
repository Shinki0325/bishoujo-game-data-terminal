eCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:58142","source":"vndb"}]},"cast":[{"characterId":"char_c80812","characterName":"白瀬 つなみ","sourceIds":{"bangumi":[{"characterId":"154427","match":"exact-normalized-name-in-linked-work","subjectId":"225500"}],"egsCharacterIds":["26166"],"vndbCharacterId":"c80812"},"originalCharacterName":"白瀬 つなみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。"},{"spoiler":false,"text":"人前では、快活で気さく女の子を演じているが、本当はそうではなく、どちらかといえばネガティブ。"},{"spoiler":false,"text":"両親を亡くし、身寄りもなく、たったひとりで健気に生きてきた。"},{"spoiler":false,"text":"将来の夢もなく、生きていく意味すら見出せないことから、悩み苦しんでいるが、そういったことを話せる相手もいなければ、話して楽になろうという人間でもない。"},{"spoiler":false,"text":"主人公と交際し、肉体関係を結んだのも、今の自分を変えたいと思ったからなのだが……。"}],"source":"egs","sourceCharacterId":"26166","sourceWorkId":"6471","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3c4a193466cfa64c55bf71fd8d4488952856107c28e0cb95a447a09763daab8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/130bb5107cdc5e4652e47958615a35f7cc5ca02cae8fb33f4d3ea49faa81406a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽吹梨里","creatorId":"vndb:s57","sourcePersonId":"vndb:s57","canonicalEntityId":"vndb:s57","name":"羽吹 梨里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225500:154427:6547:1","source":"bangumi"}]},{"characterId":"char_c80813","characterName":"高岡 みさき","sourceIds":{"bangumi":[{"characterId":"154428","match":"exact-normalized-name-in-linked-work","subjectId":"225500"}],"egsCharacterIds":["26167"],"vndbCharacterId":"c80813"},"originalCharacterName":"高岡 みさき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「うわ、それまぞ―――い。」が口癖の女の子。"},{"spoiler":false,"text":"性格は明るく元気。努力家。喜怒哀楽が激しく子供っぽい一面も。"},{"spoiler":false,"text":"自称“つなみ”の大親友で、学園きってのスプリンター。"},{"spoiler":false,"text":"はては世界陸上か、オリンピックかと夢は膨らむものの、スプリンターとしての命である膝が限界に達していた彼女は、その夢を諦めなければならなかった。"},{"spoiler":false,"text":"そうしたことから、自棄になって荒んでしまった彼女を支えてくれたのが主人公だった。"},{"spoiler":false,"text":"大親友の彼氏と知っていながらも、主人公に惹かれていく彼女は……。"}],"source":"egs","sourceCharacterId":"26167","sourceWorkId":"6471","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/8265b3c99b38a9d78087f28c9017b8542ef24a6490a0a1b4bc583326133739f7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fae9c168c90c0633a3dd70927a484366e6ef859adbf9e243f63f556d3f7e87cc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"不二 まどか","creatorId":"vndb:s11960","sourcePersonId":"vndb:s11960","canonicalEntityId":"vndb:s11960","name":"不二 まどか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:32467","source":"vndb"}]},{"characterId":"char_c80815","characterName":"塚越 ななり","sourceIds":{"bangumi":[{"characterId":"154429","match":"exact-normalized-name-in-linked-work","subjectId":"225500"}],"egsCharacterIds":["26168"],"vndbCharacterId":"c80815"},"originalCharacterName":"塚越 ななり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"啓太の彼女。"},{"spoiler":false,"text":"悪戯好きで、他人を巻き込んで、色々騒動を起こすトラブルメーカー。"},{"spoiler":false,"text":"寂しがり屋で、自分に自信がなく、そういったところを隠そうと強がって、明るく、楽天的に振舞っている。"},{"spoiler":false,"text":"劇中、主人公を誘惑するといったシーンもあるが、それも、ちょっとした彼女のおちゃめな悪戯で、啓太が一番好きなのは変わらない。"}],"source":"egs","sourceCharacterId":"26168","sourceWorkId":"6471","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/0059b2965a4d98a32566cd9513a20ca7048f1f4707c09c20a7832075d4cdff5e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df26df2c0777d10eb71f12318a3d6808505bb8b3ea341292ed830516817c68e5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"祭田絵理","creatorId":"vndb:s456","sourcePersonId":"vndb:s456","canonicalEntityId":"vndb:s456","name":"祭田 絵理","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:225500:154429:19630:1","source":"bangumi"}]},{"characterId":"char_c80816","characterName":"名護 啓太","sourceIds":{"bangumi":[{"characterId":"154430","match":"exact-normalized-name-in-linked-work","subjectId":"225500"}],"egsCharacterIds":["26169"],"vndbCharacterId":"c80816"},"originalCharacterName":"名護 啓太","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の親友（悪友）で幼馴染。"},{"spoiler":false,"text":"気は優しく、楽天家で、お節介焼き。"},{"spoiler":false,"text":"だらだらとしている割にはスポーツマン。"},{"spoiler":false,"text":"頭で考えるよりも先に行動するタイプ。"},{"spoiler":false,"text":"口癖は「バカヤロ、今の気持ちがもったいないだろ。」"},{"spoiler":false,"text":"この物語は、彼の「お節介」が原因で始まったといっても過言ではない。"},{"spoiler":false,"text":"「恋愛病」に関しても「気にしてもしょうがない」とまったく気にしていない様子。"},{"spoiler":false,"text":"そうしたこともあってか、しっかり“ななり”という彼女が居る。"}],"source":"egs","sourceCharacterId":"26169","sourceWorkId":"6471","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets