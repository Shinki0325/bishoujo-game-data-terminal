{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"25542","model":{"presentationWorkId":"vndb:v21433","staff":{"artwork":[{"creditedName":"樋上いたる","creatorId":"vndb:s257","sourcePersonId":"egs:creator:621","canonicalEntityId":"vndb:s257","name":"樋上いたる","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:189029","source":"egs"}],"scenario":[{"creditedName":"首藤頼多(高橋冷夢、内藤自由、始門弦武)","creatorId":"vndb:s2772","sourcePersonId":"egs:creator:204","canonicalEntityId":"vndb:s2772","name":"首藤頼多(高橋冷夢、内藤自由、始門弦武)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:189030","source":"egs"}],"music":[{"creditedName":"Funczion SOUNDS","creatorId":"vndb:s1071","sourcePersonId":"vndb:s1071","canonicalEntityId":"vndb:s1071","name":"Funczion SOUNDS","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:141555","source":"vndb"}],"other":[{"creditedName":"Kitty-tama","creatorId":"vndb:s24005","sourcePersonId":"vndb:s24005","canonicalEntityId":"vndb:s24005","name":"Kitty-tama","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:141546","source":"vndb"},{"creditedName":"John Pickett","creatorId":"vndb:s27671","sourcePersonId":"vndb:s27671","canonicalEntityId":"vndb:s27671","name":"John Pickett","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:141547","source":"vndb"},{"creditedName":"Aki","creatorId":"vndb:s29111","sourcePersonId":"vndb:s29111","canonicalEntityId":"vndb:s29111","name":"Aki","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:141548","source":"vndb"},{"creditedName":"K. Wiley","creatorId":"vndb:s27749","sourcePersonId":"vndb:s27749","canonicalEntityId":"vndb:s27749","name":"Kaitlyn Wiley","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:141549","source":"vndb"},{"creditedName":"J. Burgos","creatorId":"vndb:s27685","sourcePersonId":"vndb:s27685","canonicalEntityId":"vndb:s27685","name":"Jonathan Burgos","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:141550","source":"vndb"},{"creditedName":"K. Wright","creatorId":"vndb:s28031","sourcePersonId":"vndb:s28031","canonicalEntityId":"vndb:s28031","name":"Kurtis Wright","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:141551","source":"vndb"},{"creditedName":"B. Arendarski","creatorId":"vndb:s29118","sourcePersonId":"vndb:s29118","canonicalEntityId":"vndb:s29118","name":"Bartosz Arendarski","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:141552","source":"vndb"},{"creditedName":"樋上 いたる","creatorId":"vndb:s257","sourcePersonId":"vndb:s257","canonicalEntityId":"vndb:s257","name":"樋上 いたる","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:141553","source":"vndb"},{"creditedName":"SSparks","creatorId":"vndb:s27616","sourcePersonId":"vndb:s27616","canonicalEntityId":"vndb:s27616","name":"Caroline Favero","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:141557","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c68508","characterName":"アシリレラ","sourceIds":{"vndbCharacterId":"c68508"},"originalCharacterName":"アシリレラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Asirrera is a hardworking romanticist who has left the Koropokkur village in order to pursue her dream of becoming a human and falling in love, just like the girl in Koropokkur legend. Although pursuing this dream is her primary goal, she secretly holds yet another reason for leaving the village… She’s clumsy, easily flustered, and a bit ditzy, but she’s genuine and earnest to her very core."},{"spoiler":false,"text":"Unfortunately, her clumsiness causes a great deal of trouble for our protagonist, Satoru, and she pledges to make amends and help him with his cafe. In addition to the general Koropokkur powers of changing size and how her outfit appears, she possesses the ability to conceal herself from others."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c68508"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8b866a657ee62099ce78b73f87b18100d147db7f51d59b563ff3528118cab6e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e9609f07492a038c2c8074a8c27f2c9b5a012f31f437cb0694d4e8f57e09753.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c68509","characterName":"ハルアンテ","sourceIds":{"vndbCharacterId":"c68509"},"originalCharacterName":"ハルアンテ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haruante is a very intelligent and capable leader when she’s not spinning outrageous stories. Back in the Koropokkur village, she taught Cirta and Asirrera much of what they know, especially about the human world. She loves to tell dramatic and mysterious stories, but she has a compassionate side to her, too. She’s like an older sister to the two and takes Asirrera’s situation very seriously, perhaps moreso than she does."},{"spoiler":false,"text":"In addition to the general Koropokkur powers, like changing her size and how her outfit looks, she also possesses the ability to control other creatures (the less intelligent, the better!) and transform their physical appearance."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c68509"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3fdbeb57413fdc7527823a75445a7c89191c3a4b05a79c95a81b6d914e62a45.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7d3b72b1a8ec61a07ea570b346806578ea557da22105374c1dc4e7b7995217e.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c68510","characterName":"チルタ","sourceIds":{"vndbCharacterId":"c68510"},"originalCharacterName":"チルタ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Cirta is a carefree, rough around the edges kind of girl, who ignores all the minor issues or trivial matters that life happens to throw at her. Despite being a great hunter, she decides to leave the Koropokkur village after watching Asirrera’s hilarious antics in the human world. She’s a tomboy and a loyal friend through and through, and devotes everything to supporting Asirrera achieve her goals and obtaining true happiness."},{"spoiler":false,"text":"She loves to exercise, especially fighting and contests of strength. Like Asirrera and the rest of the Koropokkur, she has the ability to change her size and how her outfit appears. Her powers also grants her super strength, which allows her to carry – or break – objects with ease."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c68510"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c2d38865490282b760f19e0767628fc6286275050cfa3813ac6e5cd7b6c551a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4a94cebbbcaa7c7f3f8d840909387599c259e5afe327b5877e95eed9a81811c.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c71380","characterName":"Satoru","sourceIds":{"vndbCharacterId":"c71380"},"originalCharacterName":"Satoru","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young maid cafe owner."}],"source":"vndb","sourceCharacterId":"c71380"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5df99bce33866536ad8ec863f9908254d613a769f61f12b0e7bad2955604833b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1024dcdfdd962ac7d74b102677dc6506c7989857b97ea6b6f665fe5f980101a.webp","width":256,"height":186,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p428","sourceCompanyId":"egs:brand:5482","canonicalEntityId":"vndb:p428","name":"MANGA GAMER","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:25542:5482","source":"egs"},{"companyId":"vndb:p20793","sourceCompanyId":"vndb:p20793","canonicalEntityId":"vndb:p20793","name":"KikaChan Games","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:142356:v21433","source":"vndb"},{"companyId":"vndb:p428","sourceCompanyId":"vndb:p428","canonicalEntityId":"vndb:p428","name":"MangaGamer","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:59717:v21433","source":"vndb"},{"companyId":"vndb:p428","sourceCompanyId":"vndb:p428","canonicalEntityId":"vndb:p428","name":"MangaGamer","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:63862:v21433","source":"vndb"},{"companyId":"vndb:p428","sourceCompanyId":"vndb:p428","canonicalEntityId":"vndb:p428","name":"MangaGamer","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:67714:v21433","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
