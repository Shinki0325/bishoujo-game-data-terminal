-only","source":"vndb","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"},"weight":{"reviewState":"source-only","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist’s kouhai. She has a cute appearance, pays attention to everyone, is kind, and is the mascot-esque character that eases the tension. She is worried about getting fat, so she likes to talk about dieting. She has a habit of disappearing when you aren’t looking, but conversely will suddenly appear before you, and is both nonchalant and evasive."},{"spoiler":false,"text":"from Gematsu"}],"source":"vndb","sourceCharacterId":"c82298"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/cecd2a2265f2d90dbea4492e6aba8a0422b61de2132f20cacdda98743505f2cd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/536c82dcbe4caf9230f86d7c810e53e68cf356ea820269c9dd33392701ade7f7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"千本木 彩花","creatorId":"vndb:s12945","sourcePersonId":"vndb:s12945","canonicalEntityId":"vndb:s12945","name":"千本木 彩花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:63435","source":"vndb"}]},{"characterId":"char_vndb_c82299","characterName":"MISAKI","sourceIds":{"vndbCharacterId":"c82299"},"originalCharacterName":"MISAKI","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1029"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"source-only","source":"vndb","value":"159"},"hip":{"reviewState":"source-only",