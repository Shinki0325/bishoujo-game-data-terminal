}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/892ac50580f2f5d763fbca85e860462ab5092511efbf154627bb894165a34447.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/455d5b39e7a15b0768add105759790173e9a60eb3e81978fe4d7e9e5edeefe2a.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"乃田 あす実","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"韮井叶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:3290","source":"vndb"}]},{"characterId":"char_vndb_c20622","characterName":"天使 ももこ","sourceIds":{"vndbCharacterId":"c20622"},"originalCharacterName":"天使 ももこ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An angel who came down from heaven on her own to study humans."},{"spoiler":false,"text":"She's a gloriously upbeat and happy individual, who pays zero heed to the depressing and sad elements in life, and always wears a beaming smile on her face. Perhaps owing to this disposition of hers, she is quite a social butterfly with lots of friends."},{"spoiler":false,"text":"Incidentally, her grades are just as bad as, or worse than, Ami's, and she cares even less about this than Ami does. However, it can be argued that she sees enabling a general atmosphere of happiness in the people around her as the most ideal raison d'etre for an angel."},{"spoiler":false,"text":"It goes without saying that she too is wild about donuts."}],"source":"vndb","sourceCharacterId":"c20622"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c985e777fdd6