dth":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178147:40318:4810:1","source":"bangumi"}]},{"characterId":"char_c55858","characterName":"永明寺 冬真","sourceIds":{"bangumi":[{"characterId":"40319","match":"exact-normalized-name-in-linked-work","subjectId":"178147"}],"egsCharacterIds":["19669"],"vndbCharacterId":"c55858"},"originalCharacterName":"永明寺 冬真","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美和学園の三年生ながら、中州家の古株で若頭で、小さい頃から千夏と一緒に育った、彼女の姉気分的存在。"},{"spoiler":false,"text":"金銭管理から家事全般までこなす中州家の重要人物で、ライバルである大塩組からも一目置かれている。"},{"spoiler":false,"text":"学園内では、成績優秀、剣術にも優れた才女だが、少々、腹黒い一面があるのが、たまにキズ。"}],"source":"egs","sourceCharacterId":"19669","sourceWorkId":"9583","spoiler":false},{"segments":[{"spoiler":false,"text":"美和学園3年。"},{"spoiler":false,"text":"口数少ない中州組若頭。 先代の時代から侠客として中州組に居る古株でもある。"},{"spoiler":false,"text":"金銭管理から家事全般までをそつなくこなす中州組の重要人物で、 大塩組からも一目置かれている。"},{"spoiler":false,"text":"成績は常にトップを走り、剣術にも優れる才女。"},{"spoiler":false,"text":"ただ、少々腹黒いのが弱点か。"}],"source":"bangumi","sourceCharacterId":"40319"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76130be796fc5fa1c6ef948054608c2e0eb78a439e745e34f3b53e1ea5bb5fc4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/516b40f02282f96962983416e3c9c631968a7953feb334c829c225876ac209f0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178147:40319:4714:1","source":"bangumi"}]},{"characterId":"char_c55859","characterName":"高田　アキ","sourceIds":{"bangumi":[{"characterId":"40320","match":"exact-normalized-name-in-linked-work","subjectId":"178147"}],"egsCharacterIds":["19670"],"vndbCharacterId":"c55859"},"originalCharacterName":"高田　アキ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美和学園の一年生。"},{"spoiler":false,"text":"任侠道に憧れて中州組に飛び込んできた家出娘。"},{"spoiler":false,"text":"明るく賑やか、元気印の少女だが、下着観察や風呂覗きといった、オヤジくさい趣味を持つ。"},{"spoiler":false,"text":"成績の方は、進級が危ぶまれるくらいの実力だったりする。"}],"source":"egs","sourceCharacterId":"19670","sourceWorkId":"9583","spoiler":false},{"segments":[{"spoiler":false,"text":"美和学園1年。"},{"spoiler":false,"text":"任侠道に憧れ中州組に飛び込んできた家出少女。"},{"spoiler":false,"text":"いつも明るく賑やかな少女だが、下着観察に風呂のぞきと 趣味思考に少々オヤジが入っているのが玉に瑕。"},{"spoiler":false,"text":"成績は、常に逆トップ。"},{"spoiler":false,"text":"実は進級が危ぶまれているとか……。"}],"source":"bangumi","sourceCharacterId":"40320"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f22b503e1d5163b41d10c912a9576ee5506ba6c587997edfcb0d60a315e954c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2eee818ece07d3cc501460dd74ed067d51088ca8074e2b77ad832e3fda242aa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神崎ちろ","creatorId":"vndb:s1055","sourcePersonId":"vndb:s1055","canonicalEntityId":"vndb:s1055","name":"神崎 ちろ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178147:40320:4160:1","source":"bangumi"}]},{"characterId":"char_c55860","ch