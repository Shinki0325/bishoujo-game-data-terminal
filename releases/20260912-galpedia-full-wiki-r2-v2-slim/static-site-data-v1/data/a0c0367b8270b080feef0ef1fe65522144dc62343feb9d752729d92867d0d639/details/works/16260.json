adata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"篠崎小太郎の幼馴染であり、元恋人。"},{"spoiler":false,"text":"交通事故に遭い、若くしてこの世を去った。"},{"spoiler":false,"text":"幼い頃に両親を亡くし、兄の隆一と共に祖父の家で育てられる。"},{"spoiler":false,"text":"しかし家庭環境はあまり良いとは言えず、同年代の子らには両親が居ないことを理由にイジメに遭っていたこともある。"},{"spoiler":false,"text":"その時に知り合ったのが小太郎で、真希を守ってあげた事から二人の関係は始まる。"},{"spoiler":false,"text":"将来の夢は小太郎と結婚し、平凡な暖かい家庭を築くこと。"},{"spoiler":false,"text":"普通の幸せ、普通の暮らし……それを強く夢見ていた。"}],"source":"egs","sourceCharacterId":"9391","sourceWorkId":"16260","spoiler":false},{"segments":[{"spoiler":false,"text":"篠崎小太郎の幼なじみであり、元恋人。"},{"spoiler":false,"text":"交通事故に遭い、若くしてこの世を去った。"},{"spoiler":false,"text":"幼い頃に両親を亡くし、兄の隆一と共に祖父の家で育てられる。"},{"spoiler":false,"text":"しかし家庭環境はあまり良いといえず、同年代の子らには両親が居ないことを理由にイジメられたこともある。"},{"spoiler":false,"text":"その時に知り合ったのが小太郎で、真希を守ってあげたことからふたりの関係は始まる。"},{"spoiler":false,"text":"将来の夢は小太郎と結婚し、平凡な温かい家庭を築くこと。"},{"spoiler":false,"text":"普通の幸せ、普通の暮らし。 それを強く夢見ていた。"}],"source":"bangumi","sourceCharacterId":"15530"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23d2f8d321af2f5fe8580e9bc70c63e57c1a38dd63e0ee3fe204c6fde2797bac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c593f2a94c2888cb9c0439fb6b4a72d66969a45b594e733530166a3d971bea4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西口有香","creatorId":"vndb:s24","sourcePersonId":"vndb:s24","canonicalEntityId":"vndb:s24","name":"西口 有香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37826:15530:6592:1","source":"bangumi"}]},{"characterId":"char_c65592","characterName":"篠崎 萌香","sourceIds":{"bangumi":[{"characterId":"15531","match":"exact-normalized-name-in-linked-work","subjectId":"37826"}],"egsCharacterIds":["9392"],"vndbCharacterId":"c65592"},"original