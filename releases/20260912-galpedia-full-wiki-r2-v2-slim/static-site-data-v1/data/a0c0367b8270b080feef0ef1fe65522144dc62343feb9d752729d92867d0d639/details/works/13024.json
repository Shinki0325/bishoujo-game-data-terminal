sourceCharacterId":"5519","sourceWorkId":"17257","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のメインヒロイン。"},{"spoiler":false,"text":"前回の事件を通して過酷な運命に打ち勝ち、妹と共に幸福な未来を勝ち取った。"},{"spoiler":false,"text":"クールな性格で、相変わらず不器用で感情表現が苦手。"},{"spoiler":false,"text":"だが前回の事件を通して少し明るくなり、人当たりも良くなった。"},{"spoiler":false,"text":"もっとも寡黙なのは相変わらずなので、交友関係はあまり広くない。"},{"spoiler":false,"text":"封印したはずのリヴァーズドの再出現、そして失踪した仲間を助け出すために、再びアルカナカードの力を開放し戦いに挑む。"}],"source":"bangumi","sourceCharacterId":"93029"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3ea5b398f33a8a063b3832c1eb751395c5f569e8362051e8a6dd02c8e0c837d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a62c5bb992cfaca89b3af45d597ef75b3e388fd4c0325f8b2d34e08092cfb0a.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西口有香","creatorId":"vndb:s24","sourcePersonId":"vndb:s24","canonicalEntityId":"vndb:s24","name":"西口 有香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331521:93029:6592:1","source":"bangumi"}]},{"characterId":"char_c33390","characterName":"アルカナスレイヤー・ジョーカー","sourceIds":{"bangumi":[{"characterId":"93030","match":"exact-normalized-name-in-linked-work","subjectId":"222098"},{"characterId":"93030","match":"exact-normalized-name-in-linked-work","subjectId":"331521"}],"egsCharacterIds":["5520"],"vndbCharacterId":"c33390"},"originalCharacterName":"アルカナスレイヤー・ジョーカー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【死神の力に蝕まれる妹】"},{"spoiler":false,"text":"瑠架の妹。"},{"spoiler":false,"text":"顔立ちや体形は瑠架に似ているが、表情豊かで明るい。"},{"spoiler":false,"text":"そのせいか別人のようでもある。"},{"spoiler":false,"text":"だがその明るさは、病人の自分を気遣ってもらわないようにと、"},{"spoiler":false,"text":"弱音をはかないように無理しての事でもある。"}],"source":"egs","sourceCharacterId":"5520","sourceWorkId":"13024","spoiler":false},{"segments":[{"spoiler":false,"text":"もう一人のメインヒロイン。"},{"spoiler":false,"text":"前回ではアルカナカード『世界』に操られていたが、姉と共にその運命を絶ち切り、幸せな未来を掴んだ。"},{"spoiler":false,"text":"今は病気も治って体調も万全、元気いっぱいのボクっこ。"},{"spoiler":false,"text":"姉とは対照的に明るい性格で、何事にもポジティブ。"},{"spoiler":false,"text":"また抜群の運動神経を誇り、クラスでは人気者である。"},{"spoiler":false,"text":"瑠架と平凡な、しかしかけがえのない毎日を過ごしていたが、再びリヴァーズドとの戦いに巻き込まれた姉を助けたいとの思いから、自らもセイバーへと変身。"},{"spoiler":false,"text":"瑠架と共にアルカナシャドウとの戦いに挑む。"}],"source":"egs","sourceCharacterId":"5520","sourceWorkId":"17257","spoiler":false},{"segments":[{"spoiler":false,"text":"もう一人のメインヒロイン。"},{"spoiler":false,"text":"前回の事件ではアルカナカードに選ばれた運命に翻弄されていたが、姉と共にその運命を絶ち切り、幸せな未来を掴んだ。"},{"spoiler":false,"text":"今は病気も治って体調も万全、天真爛漫で元気いっぱいのボクっこ。"},{"spoiler":false,"text":"姉とは対照的に明るい性格で、何事にもポジティブ。"},{"spoiler":false,"text":"また抜群の運動神経を誇り、クラスでは人気者である。"},{"spoiler":false,"text":"瑠架と平凡な、しかしかけがえのない毎日を過ごしていたが、再びリヴァーズドとの戦いに巻き込まれてしまう。"},{"spoiler":false,"text":"姉を助けたいという思いから自らもセイバーに変身。瑠架と共にアルカナシャドウとの戦いに挑む。"}],"source":"bangumi","sourceCharacterId":"93030"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cc14b45a358d6724c1deb43565fd5d78a39b330cc7b8c89165eaabf6d7a75c5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/7964e67c046c6abbe4506c9ab7f835ead5f8156c9d93f7e09e1890e2991ff831.webp","width":150,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331521:93030:6349:1","source":"bangumi"}]},{"characterId":"char_c33391","characterName":"アルカナセイバー・フォルトゥナ","sourceIds":{"bangumi":[{"characterId":"93031","match":"e