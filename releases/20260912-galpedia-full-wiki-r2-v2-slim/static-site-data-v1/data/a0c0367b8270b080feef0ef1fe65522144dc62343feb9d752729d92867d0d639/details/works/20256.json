.webp","width":195,"height":203,"source":"static-detail"},"actors":[{"creditedName":"水橋かおり","creatorId":"vndb:s131","sourcePersonId":"vndb:s131","canonicalEntityId":"vndb:s131","name":"水橋 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:84236:10441:3851:1","source":"bangumi"}]},{"characterId":"char_bangumi_10445","characterName":"美树沙耶加","sourceIds":{"bangumi":[{"characterId":"10445","match":"source-roster","subjectId":"24923"},{"characterId":"10445","match":"source-roster","subjectId":"84236"}]},"originalCharacterName":"美树沙耶加","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「那家伙要是敢来找麻烦，看我不揍飞他。反正还有麻美姐在呢」"},{"spoiler":false,"text":"是鹿目圆的同班同学。性格活泼开朗，和圆是很好的朋友。"},{"spoiler":false,"text":"「あいつが何かちょっかい出してきたら、あたしがぶっとばしてやるからさ。マミさんだってついてるんだし」"},{"spoiler":false,"text":"まどかのクラスメイト。いつも元気で活発な性格で、まどかとは大の仲良し。"}],"source":"bangumi","sourceCharacterId":"10445"}],"profileFacts":[{"label":"出身","source":"bangumi","sourceCharacterId":"10445","value":"见泷原市"},{"label":"学校","source":"bangumi","sourceCharacterId":"10445","value":"见泷原中学校"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb49dddc7911d473bb5354a90fa472b927643dbae2a1acb08485f4fecac6247a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca3d1452f6d50e90cad0bf40633a1af2bec9d87abcc32f685cddbb821f0e756e.webp","width":151,"height":239,"source":"static-detail"},"actors":[{"creditedName":"喜多村英梨","creatorId":"vndb:s269","sourcePersonId":"vndb:s269","canonicalEntityId":"vndb:s269","name":"喜多村 英梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:84236:10445:4251:1","source":"bangumi"}]},{"characterId":"char_bangumi_10446","characterName":"孵化者","sourceIds":{"bangumi":[{"characterId":"10446","match":"source-roster","subjectId":"24923"},{"characterId":"10446","match":"source-roster","subjectId":"84236"}]},"originalCharacterName":"孵化者","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"「和我签订契约，成为魔法少女吧！」"},{"spoiler":false,"text":"可以实现少女的一个愿望的魔法使者。"},{"spoiler":false,"text":"「僕と契約して、魔法少女になってほしいんだ」"},{"spoiler":false,"text":"少女の願い事をひとつだけ叶えてくれる魔法の使者。"},{"spoiler":false,"text":"〴( ◕‿‿◕ )〵"}],"source":"bangumi","sourceCharacterId":"10446"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"10446","value":"Top Sales"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b145e05c867f06a87b0e6cdf48ed4cbbfb7a0daa8cfde77e8f106f82a609cd91.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78dd71749a2b8efba44bfdf61f00f5f1af739c5819758dc730d0ced1e5fe5090.webp","width":256,"height":135,"source":"static-detail"},"actors":[{"creditedName":"加藤英美里","creatorId":"vndb:s1190","sourcePersonId":"vndb:s1190","canonicalEntityId":"vndb:s1190","name":"加藤 英美里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:84236:10446:4850:1","source":"bangumi"}]},{"characterId":"char_bangumi_10672","characterName":"佐倉 杏子","sourceIds":{"bangumi":[{"characterId":"10672","match":"source-roster","subjectId":"24923"},{"characterId":"10672","match":"source-roster","subjectId":"84236"}]},"originalCharacterName":"佐倉 杏子","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"14"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「总之，干掉她就行了吧？」"},{"spoiler":false,"text":"觊觎麻美地盘而从其他城市前来的魔法少女。总是吃着零食。不顾周边受损的利己主义者。"},{"spoiler":false,"text":"「要するに、ブッ潰しちゃえばいいんでしょ？」"},{"spoiler":false,"text":"マミの縄張りを狙い、別の町からやってきた魔法少女。いつも何かを食べている。周囲の被害を鑑みない利己主義者。"}],"source":"bangumi","sourceCharacterId":"10672"}],"profileFacts":[{"label":"出身","source":"bangumi","sourceCharacterId":"10672","value":"风见野市"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab40d2cf00ecd621d0b7575a0371bb358ddbc5bd2caab217c6ef0b6c6861c240.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52373e4807a3811562e4f4a06c91e7c4b9b724a5b62634ed56dda907c554ab41.webp","width":161,"height":252,"source":"static-detail"},"actors":[{"creditedName":"野中藍","creatorId":"vndb:s1187","sourcePersonId":"vndb:s1187","canonicalEntityId":"vndb:s1187","name":"野中 藍","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:84236:10672:4371:1","source":"bangumi"}]},{"characterId":"char_bangumi_10682","characterName":"上條恭介","sourceIds":{"bangumi":[{"characterId":"10682","match":"source-roster","subjectId":"24923"},{"characterId":"10682","match":"source-roster","subjectId":"84236"}]},"originalCharacterName":"上條恭介","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美树沙耶香的青梅竹马。原本是一位很有前途的小提琴手，但一场事故让他无法再演奏。被沙耶香所暗恋。"},{"spoiler":false,"text":"さやかの幼馴染。将来有望なヴァイオリン奏者だったが、事故により二度と演奏のできない体となる。さやかの思い人。"}],"source":"bangumi","sourceCharacterId":"10682"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1e36cada71f87749dc59b70621e419892862ec9db077fa57d8b4cdcd020adaa.webp","fallbackUrl