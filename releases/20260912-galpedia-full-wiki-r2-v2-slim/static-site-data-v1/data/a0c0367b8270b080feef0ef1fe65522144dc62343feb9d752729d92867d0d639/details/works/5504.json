terName":"ウィル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Lives in Plen Arc. She is a member of \"Song of God\" and tasked with the duty of conveying the will of God to people through dance."},{"spoiler":false,"text":"God called to her, but because she defied him, the oracles have decimated Plen Arc."},{"spoiler":false,"text":"When ALES arrives in Plen Arc, she has gone missing."},{"spoiler":false,"text":"The question is whether she perished with the city, or..."},{"spoiler":false,"text":"Taken from Hirameki International"}],"source":"vndb","sourceCharacterId":"c4155"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/5901629e2a12e66dc68213689be5c40d4f3a66245e4d416ea4be851fa57394b0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b1de87d84fa388309e94185ec152b2069173a9955c99a42db8d2be3dbece8bd.webp","width":239,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雪野 五月","creatorId":"vndb:s474","sourcePersonId":"vndb:s474","canonicalEntityId":"vndb:s474","name":"ゆきの さつき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1717","source":"vndb"}]},{"characterId":"char_vndb_c4156","characterName":"クエイク","sourceIds":{"vndbCharacterId":"c4156"},"originalCharacterName":"クエイク","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man that lives in the seaside hamlet of Sea Arc also happens to be an oracle. Normally living a quiet life with the fishermen of Sea Arc, QUAKE cuts a bold figure and has a personality that leaves an impression. Despite appearances, he is also a man of deep reflection and possesses a wealth of knowledge."},{"spoiler":false,"text":"A certain incident drives him to join forces in taking action with ALES."},{"spoiler":false,"text":"Taken from Hirameki International"}],"source":"vndb","sourceCharacterId":"c4156"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53212d21fe056140f33bf6fa13e754806edeba03918136236e1751f5d4038488.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3facd1b2444c417c8539b074d080c0cc0b9822839001dc42561786ebcb2ded8.webp","width":239,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小西 克幸","creatorId":"vndb:s65","sourcePersonId":"vndb:s65","canonicalEntityId":"vndb:s65","name":"小西克幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1711","source":"vndb"}]},{"characterId":"char_vndb_c4157","characterName":"スィー","sourceIds":{"vndbCharacterId":"c4157"},"originalCharacterName":"スィー","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Raised as the daughter of a florist, on her 18th birthday a coup d'etat occurs and she is told by her surrogate mother, NENE, that she is the last member of the royal family."},{"spoiler":false,"text":"But because of the coup d'etat, she is unable to ascend to the thrown and NENE is killed by the conspirators behind the political takeover."},{"spoiler":false,"text":"Bequeathed the \"Key of Will\" with which she has been entrusted, she sets off on a journey with LALIELA to see that it is delivered to the Sage U."},{"spoiler":false,"text":"Taken from Hirameki International"}],"source":"vndb","sourceCharacterId":"c4157"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6e96dea0160b46b149a5d912594a7c7f73c135104f70551d65e286440fa84d3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/6631b0b24ad77bfff82611bf3108e6602b55eb6341cf03bca2ad44ee21df5d34.webp","width":239,"height":256,"source":"static-detail"},"actors":[{"creditedName":"堀江 由衣","creatorId":"vndb:s46","sourcePersonId":"vndb:s46","canonicalEntityId":"vndb:s46","name":"堀江 由衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1709","source":"vndb"}]},{"characterId":"char_vndb_c4158","characterName":"ラーライラ","sourceIds":{"vndbCharacterId":"c4158"},"originalCharacterName":"ラーライラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"LALIELA is NENE's daughter and she has been raised with SUI as her sister since she was a child."},{"spoiler":false,"text":"LALIELA knows that SUI is the royal princess and she was raised as her bodyguard cum maid-in-waiting."},{"spoiler":false,"text":"She is truly an incredible fighter."},{"spoiler":false,"text":"She does not wear her heart on her sleeve and takes a cool attitude to all encounters, but begins to change as she journeys with SUI."},{"spoiler":false,"text":"Taken from Hirameki International"}],"source":"vndb","sourceCharacterId":"c4158"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c53cbf4b7cad145679bafc66f6d222db2ff4f67fde9510ba598eb32cbcb8a6d3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fada37fd48b5b1057e50920f0576fec1aba76a79918ed62c0b0535f52b204b81.webp","width":239,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長沢 美樹","creatorId":"vndb:s1385","sourcePersonId":"vndb:s1385","canonicalEntityId":"vndb:s1385","name":"長沢 美樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1725","source":"vndb"}]},{"characterId":"char_vndb_c4159","characterName":"ティティ","sourceIds":{"vndbCharacterId":"c4159"},"originalCharacterName":"ティティ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"TITI lives in Towngilde and has taken over for her missing father, a scientist of great renown. Following in his footsteps, TITI is in charge of overseeing the Imperial office program in charge of demystifying the technologies used in the hyper-advanced science savvy civilizations of antiquity with an eye to opening up the technologies to the public."},{"spoiler":false,"text":"After meeting SUI, TITI decides to depart on her journey with her."},{"spoiler":false,"text":"Taken from Hirameki International"}],"source":"vndb","sourceCharacterId":"c4159"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab6011ce97fcf40eb4590e208c061ca2cb5a82c099a7a19cb170b6cf2e9f7caa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cdc387b230739c267f6b03a9e6276d599475627157c96ff77d56c7c1d592793.webp","width":239,"height":256,"source":"static-detail"},"actors":[{"creditedName":"笹島 かほる","creatorId":"vndb:s1017","sourcePersonId":"vndb:s1017","canonicalEntityId":"vndb:s1017","name":"神無月ほのか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1722","source":"vndb"}]},{"characterId":"char_vndb_c4160","characterName":"タツタ","sourceIds":{"vndbCharacterId":"c4160"},"originalCharacterName":"タツタ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young man living in Village Gilde."},{"spoiler":false,"text":"Though young, he is independent and proud of this. There is nothing he despises more than being treated like a child."},{"spoiler":false,"text":"While looking for his sister that he lost contact with in the old capital, he falls for LALIELA the instant he sees her and joins up with SUI and company, deciding to journey with them."},{"spoiler":false,"text":"Taken from Hirameki International"}],"source":"vndb","sourceCharacterId":"c4160"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a62518969ac46f3f2223fb2a3eb0d0bfc633bbbe262f5467aad3102c2ca7a799.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07de4f10a2d8c8a010258cf55a2369cfb00b62b0a7db766bb31467bab962af13.webp","width":239,"height":256,"source":"static-detail"},"actors":[{"creditedName":"くまい もとこ","creatorId":"vndb:s1408","sourcePersonId":"vndb:s1408","canonicalEntityId":"vndb:s1408","name":"くまいもとこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1726","source":"vndb"}]},{"characterId":"char_vndb_c4326","characterName":"リリーヌ","sourceIds":{"vndbCharacterId":"c4326"},"originalCharacterName":"リリーヌ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Leader of the royal group of knights."}],"source":"vndb","sourceCharacterId":"c4326"}],