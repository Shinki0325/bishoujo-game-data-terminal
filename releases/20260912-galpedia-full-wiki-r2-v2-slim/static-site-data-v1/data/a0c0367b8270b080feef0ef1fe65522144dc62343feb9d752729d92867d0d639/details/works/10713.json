lse,"text":"Based on official website"}],"source":"vndb","sourceCharacterId":"c9764"},{"segments":[{"spoiler":false,"text":"“織節家”の三女で、春臣より二つ年下。"},{"spoiler":false,"text":"あまり感情の起伏を見せないが、イタズラ好きで、負けず嫌いな一面も。"},{"spoiler":false,"text":"読書家だが、エッチへの好奇心が強く、読んでいるのは官能小説ばかり。"},{"spoiler":false,"text":"真冬がオナニーしている場面を、春臣は偶然見てしまうが……？"},{"spoiler":false,"text":"「フフ……口よりも、身体のほうが素直ね」"}],"source":"egs","sourceCharacterId":"15754","sourceWorkId":"10713","spoiler":false},{"segments":[{"spoiler":false,"text":"三姉妹の三女、主人公の２コ下。あまり感情の起伏がない娘。本が好き。"},{"spoiler":false,"text":"しかし性への好奇心は強く、いつも官能小説を読んでいる。"},{"spoiler":false,"text":"悪戯好きで負けず嫌いな面も。"}],"source":"egs","sourceCharacterId":"15754","sourceWorkId":"12049","spoiler":false},{"segments":[{"spoiler":false,"text":"织节三姐妹中的三女，织节夏实和织节秋奈的妹妹，贫乳。比主人公·志木春臣小两岁。"},{"spoiler":false,"text":"感情从来不会有过大的起伏（表面上不将自己的感情表现出来，实际却有小恶魔般的性格），喜欢书。同时也有着喜欢恶作剧和胡闹以及好强的一面。"}],"source":"bangumi","sourceCharacterId":"13072"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"15754","sourceWorkId":"10713","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"149 cm","valueContext":null,"source":"egs","sourceCharacterId":"15754","sourceWorkId":"10713","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"15754","sourceWorkId":"10713","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"45 cm","valueContext":null,"source":"egs","sourceCharacterId":"15754","sourceWorkId":"10713","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"40 kg","valueContext":null,"source":"egs","sourceCharacterId":"15754","sourceWorkId":"10713","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"height":[{"comparisonValue":"149","source":"vndb","sourceCharacterId":"c9764","value":"149"},{"comparisonValue":"149","scope":"sourceWork","source":"egs","sourceCharacterId":"15754","sourceWorkId":"10713","value":"149"},{"comparisonValue":"149","scope":"sourceWork","source":"egs","sourceCharacterId":"15754","sourceWorkId":"12049","value":"149"},{"comparisonValue":"151","source":"bangumi","sourceCharacterId":"13072","value":"151cm"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/166887b58ad3272250c9ba2557fdf1aa7ee9265833a8b6e1284f53096b25f92a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60ccb4f5b970c4b74ac1adb2d2439a149d9ff906f918ccc8b38fb7ff7f6b980c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阪田佳代","creatorId":"vndb:s650","sourcePersonId":"vndb:s650","canonicalEntityId":"vndb:s650","name":"鮎川ひなた","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61767:13072:5133:1","source":"bangumi"}]},{"characterId":"char_c9765","characterName":"白檀 翠","sourceIds":{"bangumi":[{"characterId":"28360","match":"exact-normalized-name-in-linked-work","subjectId":"61767"},{"characterId":"28360","match":"exact-normalized-name-in-linked-work","subjectId":"61768"}],"egsCharacterIds":["15755"],"vndbCharacterId":"c9765"},"originalCharacterName":"白檀 翠","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"41"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Classmates with Haruomi, Midori is also its president. She's been best friends with Suzuran for a long time. Calm and collected as well as intelligent and switched on, she's a little domineering. She often quotes famous proverbs, quotes and sayings. For some reason, she treats Haruomi like an enemy."},{"spoiler":false,"text":"From official website"}],"source":"vndb","sourceCharacterId":"c9765"},{"segments":[{"spoiler":false,"text":"春臣のクラスのクラス委員長。"},{"spoiler":false,"text":"クールでしゃっきり、ちょっぴり高飛車なタイプ。"},{"spoiler":false,"text":"何故か、春臣を敵対視しているようで……。"},{"spoiler":false,"text":"「男なんて、やっぱり最低最悪ね!!　志木君も、そこらへんの男どもと同じ……私たちの敵だわ!!」"}],"source":"egs","sourceCharacterId":"15755","sourceWorkId":"10713","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスの学級委員長。クールできりっとした女の子。"},{"spoiler":false,"text":"ちょっとだけ高飛車な感じ。よく四字熟語や名言を引用。"},{"spoiler":false,"text":"鈴蘭を好きで最初は春臣を敵対視していた。"}],"source":"egs","sourceCharacterId":"15755","sourceWorkId":"12049","spoiler":false},{"segments":[{"spoiler":false,"text":"担任着春臣班班长的职务的少女，贫乳，严格的性格，对春臣的接触特别严格"},{"spoiler":false,"text":"常常与铃兰一起行动"},{"spoiler":false,"text":"不过稍微有些高飞车的感觉。经常拽一些四字成语或者名言之类的东西。"},{"spoiler":false,"text":"不知为何对主角抱有敌视态度。"},{"spoiler":false,"text":"“男人啊，果然是最烂最差劲的！！志木君和那些臭男人一样，都是我们的敌人！！”"}],"source":"bangumi","sourceCharacterId":"28360"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"15755","sourceWorkId":"10713","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"15755","sourceWorkId":"10713","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"15755","sourceWorkId":"10713","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"15755","sourceWorkId":"10713","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"41 kg","valueContext":null,"source":"egs","sourceCharacterId":"15755","sourceWorkId":"10713","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/702f4819acd9998f19451d418480bb61f201383ceb2c1ae4d65a5adb83fccf3f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5b86c9cadb7da7a115da0ad82d7aa94b3a7658cec0999b5012239770ba56174.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61767:28360:4830:1","source":"bangumi"}]},{"characterId":"char_c9766","characterName":"姫野原 鈴蘭","sourceIds":{"bangumi":[{"characterId":"47637","match":"exact-normalized-name-in-linked-work","subjectId":"61767"},{"characterId":"47637","match":"exact-normalized-name-in-linked-work","subjectId":"61768"}],"egsCharacterIds":["15756"],"vndbCharacterId":"c9766"},"originalCharacterName":"姫野原 鈴蘭","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"102"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Airheaded and shy, Suzuran is classmates with Akina, Haruomi and Midori. She fell in love with Haruomi at first sight, and her shyness motivates her to stalk him. She's quite innocent and childlike, but she has a high libido. Suzuran rarely speaks, but when she does, she uses floriography. Since she and Midori has been best friends for a long time, only Midori can understand Suzuran without difficulty."},{"spoiler":false,"text":"Based on official website"}],"source":"vndb","sourceCharacterId":"c9766"},{"segments":[{"spoiler":false,"text":"春臣に一目惚れし、ストーカーしてくるクラスメイト。"},{"spoiler":false,"text":"しかし、天然系ぽわぽわ少女なため、本人にその意識はない。"},{"spoiler":false,"text":"ほとんど喋らず、花言葉で会話する女の子。"},{"spoiler":false,"text":"夏実に負けない巨乳を誇り、性欲も強い。"},{"spoiler":false,"text":"シャァァァァァ……「あ……うふぅ……」"}],"source":"egs","sourceCharacterId":"15756","sourceWorkId":"10713","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、主人公に一目惚れし、追い掛けまわしていた天然ボケの少女。"},{"spoiler":false,"text":"ほわほわした性格だが、性欲が強い。"}],"source":"egs","sourceCharacterId":"15756","sourceWorkId":"12049","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、主人公に一目惚れし、ストーカーする天然ボケの少女。"},{"spoiler":false,"text":"ほわほわした性格だが性欲が強い。"},{"spoiler":false,"text":"ほとんどしゃべらず花言葉で会話する。"},{"spoiler":false,"text":"シャァァァァァ……　「あ……うふぅ……」"}],"source":"bangumi","sourceCharacterId":"47637"}],"profileFacts":[{"label":"胸围（本版本）","value":"102 cm","valueContext":null,"source":"egs","sourceCharacterId":"15756","sourceWorkId":"10713","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"15756","sourceWorkId":"10713","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"15756","sourceWorkId":"10713","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"15756","sourceWorkId":"10713","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"47 kg","valueContext":null,"source":"egs","sourceCharacterId":"15756","sourceWorkId":"10713","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd1eedc5b1d44395fe819be37067e4c238763657a24d18e81c4ed6a2a90aa6a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab4e13c4e2191fb3ef08ff37e8a39bde36a2e8016d4e37a76fa562b882c100cb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小暮英麻","creatorId":"vndb:s654","sourcePersonId":"vndb:s654","canonicalEntityId":"vndb:s654","name":"小暮 英麻","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61767:47637:4282:1","source":"bangumi"}]},{"characterId":"char_vndb_c14083","characterName":"志木 春臣","sourceIds":{"vndbCharacterId":"c14083"},"originalCharacterName":"志木 春臣","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the Kanojo x Kanojo x Kanojo series. A calm and collected young man, Haruomi doesn't stand out much. When he goes for something, he goes all out. He's the type to be intially overlooked by others. Haruomi's hobby is to speed-solve Rubik's cubes."},{"spoiler":false,"text":"Based on official website"}],"source":"vndb","sourceCharacterId":"c14083"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf0bcf40a5d5194190809bf61f159cf4450ebb3591e3c2c77b84c5f48e56e36d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3adab234c2444c1bcc11b2201b68273b7c1f7ccec0cafe96d55b8c9889e2b5d7.webp","width":177,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c14084","characterName":"本能寺 司","sourceIds":{"vndbCharacterId":"c14084"},"originalCharacterName":"本能寺 司","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"149"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haruomi's classmate, they eventually become good friends. He's not smart, but he's good at sports. Even though he is good-looking, Tsukasa isn't popular with girls because of his cowardly and weak, \"hetare\" personality. Despite that fact, he loves girls and really wishes to be popular with them. Convinced that Haruomi has grasped his weakness, Tsukasa feels as though he is outclassed by him. Even so, he greatly adores Haruomi. His favourite phrase is \"I'm your best friend, riiiight?\""},{"spoiler":false,"text":"When Haruomi is down, Tsukasa shows his kind side when he tries to cheer him up. Very self-conscious about his height, he wears \"secret shoes\" to give himself a 10cm boost. He's also afraid of becoming bald, since his father is so. His behaviour is puppy-like, so he frequently (and jokingly) gets called \"Pochi\" and \"Shiro\" (common Japanese dog names) by his peers."},{"spoiler":false,"text":"The events of \"Doki Doki Full Throttle\" suggests that he may be bisexual or homosexual."},{"spoiler":false,"text":"Based on the official website's character profile."}],"source":"vndb","sourceCharacterId":"c14084"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f05f6e750997c2e7b91af23376979cd7c6b2b09510c1349133f00415b80d9eb9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98ff38d649ac9af760929ae5e423cdc1aa00463136b11d4ee2d7f4537ae458b0.webp","width":173,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中 一郎","creatorId":"vndb:s7952","sourcePersonId":"vndb:s7952","canonicalEntityId":"vndb:s7952","name":"田中 一郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7165","source":"vndb"}]}],"songs":[],"comp