ameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"とにかく明るく積極的。かつ天然。愛されキャラ。"},{"spoiler":false,"text":"思いつきをすぐ口にだすので、けっこう推理はハズレも多い。"},{"spoiler":false,"text":"しかし行動力は随一。"},{"spoiler":false,"text":"調査や尾行などさっさと動きまわる。"},{"spoiler":false,"text":"肉体労働担当。"},{"spoiler":false,"text":"怪力とかそういう技はない。"},{"spoiler":false,"text":"また他人の領域にもエンリョなく突っ込んで話しかけてくるが、根っから悪気がない。"}],"source":"egs","sourceCharacterId":"5524","sourceWorkId":"21014","spoiler":false},{"segments":[{"spoiler":false,"text":"性癖：異物挿入フェチ"},{"spoiler":false,"text":"とにかく明るく積極的、かつ天然。 愛されキャラな女の子。"},{"spoiler":false,"text":"行動力は随一で、思ったことをすぐ口に出すタイプ。"},{"spoiler":false,"text":"他人の領域にエンリョなく突っ込んで話し掛けてくるが、悪気はあるわけではない。"},{"spoiler":false,"text":"なんでも試したい好奇心の塊。"},{"spoiler":false,"text":"最近は、異物挿入に興味津々の様子。"}],"source":"bangumi","sourceCharacterId":"210605"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a243ad75044917ad6e9f814c5c8adb9d7337a575e613c9b030e9f72b775f7dd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f65b7ebab10a844e445fb41686da4f7dc242a731c5d3f2e26af77b6b58bf56a1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:226880:210605:5936:1","source":"bangumi"}]},{"characterId":"char_c24664","characterName":"江田島 紗希","sourceIds":{"bangumi":[{"characterId":"210606","match":"exact-normalized-name-in-linked-work","subjectId":"226880"}],"egsCharacterIds":["5525"],"vndbCharacterId":"c24664"},"originalCharacterName":"江田島 紗希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"成績優秀。校則もしっかり守る優等生。"},{"spoiler":false,"text":"やや堅い丁寧語で話す。"},{"spoiler":false,"text":"そこそこの学校なので４人とも頭は悪くないが中でも紗希は優秀。"},{"spoiler":false,"text":"受験の折、第一志望の入試当日に高熱を出してしまい、不合格となった過去がある。"},{"spoiler":false,"text":"二度と同じ思いはしたくない、と健康にかなり気を遣っている。"}],"source":"egs","sourceCharacterId":"5525","sourceWorkId":"21014","spoiler":false},{"segments":[{"spoiler":false,"text":"性癖：オシオキされるプレイが好き"},{"spoiler":false,"text":"成績優秀でやや堅い丁寧語で話す女の子。 校則もしっかり守る優等生。"},{"spoiler":false,"text":"受験当日に高熱を出して不合格となった過去があり、それ以来、健康にかなり気を遣っている。"},{"spoiler":false,"text":"実は オシオキ されると人格崩壊するほどツボにハマる M気質を持っている。"},{"spoiler":false,"text":"汚される系のプレイもストライク。"}],"source":"bangumi","sourceCharacterId":"210606"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/2825e9e6c579eeff292a4774a768ba25b5efb1672ffeb967a2fb469292678f4e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df6cbd6e2771395b900912633b31e9a913291fbb3c777d142dbe2bca18202378.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近藤祐記","creatorId":"vndb:s1412","sourcePersonId":"vndb:s1412","canonicalEntityId":"vndb:s1412","name":"近藤 祐記","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:226880:210606:5904:1","source":"bangumi"}]},{"characterId":"char_c24665","characterName":"渡来 美琴","sourceIds":{"bangumi":[{"characterId":"210607","match":"exact-normalized-name-in-linked-work","subjectId":"226880"}],"egsCharacterIds":["5526"],"vndbCharacterId":"c24665"},"originalCharacterName":"渡来 美琴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"無表情。口数の多いほうではない。"},{"spoiler":false,"text":"たまにしゃべるとざっくり。ばっさり。"},{"spoiler":false,"text":"友達ができにくい。"},{"spoiler":false,"text":"自分でも自覚はあるらしいが、性格なので仕方ない。"},{"spoiler":false,"text":"そのため、遠慮なく話しかけてくるひばりは美琴にとって大切な存在となっている。"}],"source":"egs","sourceCharacterId":"5526","sourceWorkId":"21014","spoiler":false},{"segments":[{"spoiler":false,"text":"性癖：体液や下着の匂いで興奮する匂いフェチ"},{"spoiler":false,"text":"無表情で口数の少ない女の子。"},{"spoiler":false,"text":"たまにしゃべると ざっくり、ばっさり…… 言葉の斬れ味が鋭く、友達ができにくい。"},{"spoiler":false,"text":"自分でも自覚はあるらしいが、性格なので仕方ないと半ば諦めている。"},{"spoiler":false,"text":"そのため遠慮なく話し掛けてくる ひばりは、美琴にとって大切な存在となっている。"},{"spoiler":false,"text":"桁外れに優れた嗅覚に恵まれてしまったため、極端な匂いフェチになってしまった。"}],"source":"bangumi","sourceCharacterId":"210607"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aeeeb65260b3aa86c22e374fe090709fd370f53491faec2ef096a8748e61c16f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/568f96dba473fa9c8265505733929574583eb4343f34f128fd1c43722ed2500b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:226880:210607:6469:1","source":"bangumi"}]},{"characterId":"char_c24666","characterName":"中村 唯","sourceIds":{"bangumi":[{"characterId":"210608","match":"exact-normalized-name-in-linked-work","subjectId":"226880"}],"egsCharacterIds":["5527"],"vndbCharacterId":"c24666"},"originalCharacterName":"中村 唯","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"seg