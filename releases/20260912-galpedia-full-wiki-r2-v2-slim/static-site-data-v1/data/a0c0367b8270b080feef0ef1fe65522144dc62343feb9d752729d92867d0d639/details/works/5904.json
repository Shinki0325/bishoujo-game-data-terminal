5904","spoiler":false},{"segments":[{"spoiler":false,"text":"子供好きの主婦。若干天然が入っているため、ぼんやりしているように見えるがそこが魅力でもある。昔美鈴の通っていた高校の先生で あった雅俊と結ばれる。旦那の事を信頼し愛しているが、子供を作る事に非協力的な旦那に少し不満をもっている。近所の子供が遊びに くると、自分で作ったお菓子とかを振舞ったりするのでご近所からも評判が良い。"}],"source":"bangumi","sourceCharacterId":"201387"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/193dfc9986d305af59a64b1fb3c8f6d8fdfe14cf12fb32a607c68f919ecac38e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f61084e4f7151c14716b2181be8dee9de513fb9c58b29e95747abcbb79e59542.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222250:201387:4830:1","source":"bangumi"}]},{"characterId":"char_c81233","characterName":"小野寺 あやね","sourceIds":{"bangumi":[{"characterId":"201384","match":"exact-normalized-name-in-linked-work","subjectId":"222250"}],"egsCharacterIds":["26530"],"vndbCharacterId":"c81233"},"originalCharacterName":"小野寺 あやね","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公をサポートする秘書のような存在。"},{"spoiler":false,"text":"数年来の主人公のパートナーで口数も少なく愛想も良くないが、パートナーとしてはかなり優秀な存在。"},{"spoiler":false,"text":"公私共に痒いところに手が届き、余計な事には口を出さない。"},{"spoiler":false,"text":"分をわきまえた行動なので主人公が彼女にわずらわしさを感じる事はない。"}],"source":"egs","sourceCharacterId":"26530","sourceWorkId":"5904","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公をサポートする秘書のような存在。数年来の主人公のパートナーで口数も少なく愛想も良くないが、パートナーとしてはかなり優秀な存在。"},{"spoiler":false,"text":"公私共に痒いところに手が届き、余計な事には口を出さない。分をわきまえた行動なので主人公が彼女にわずらわしさを感じる事はない。"}],"sou