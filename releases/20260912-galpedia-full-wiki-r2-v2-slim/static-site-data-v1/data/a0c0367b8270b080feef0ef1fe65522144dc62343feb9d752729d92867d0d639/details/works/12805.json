{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"12805","model":{"presentationWorkId":"vndb:v2183","staff":{"artwork":[{"creditedName":"深泥正","creatorId":"vndb:s2572","sourcePersonId":"egs:creator:2428","canonicalEntityId":"vndb:s2572","name":"深泥正","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:85972","source":"egs"}],"scenario":[{"creditedName":"遊真一希(遊馬一希)","creatorId":"vndb:s2601","sourcePersonId":"egs:creator:5208","canonicalEntityId":"vndb:s2601","name":"遊真一希(遊馬一希)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:85973","source":"egs"}],"music":[],"other":[{"creditedName":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","creatorId":"vndb:s592","sourcePersonId":"egs:creator:13068","canonicalEntityId":"vndb:s592","name":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","detail":"デモムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:82686","source":"egs"}]},"cast":[{"characterId":"char_c46596","characterName":"岡崎 沙也佳","sourceIds":{"bangumi":[{"characterId":"205489","match":"exact-normalized-name-in-linked-work","subjectId":"223666"}],"egsCharacterIds":["14897"],"vndbCharacterId":"c46596"},"originalCharacterName":"岡崎 沙也佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"24"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The wife of Hideki's older brother."}],"source":"vndb","sourceCharacterId":"c46596"},{"segments":[{"spoiler":false,"text":"主人公の兄の嫁。義姉。24歳。"},{"spoiler":false,"text":"愛する夫が事故で急逝し、未亡人となる。お腹の中に夫の子供が宿っており、このほど無事出産し、一児の母となった。"},{"spoiler":false,"text":"非常に芯のしっかりした女性だが、何事も自分で一人で抱え込んでしまうところがあり、頑張り過ぎてしまうきらいがある。"},{"spoiler":false,"text":"夫が亡くなってから、主人公が親身になって身の回りの世話をしてくれ、出産の前後の大変な時期にも励まし続けてくれた主人公に感謝している。また主人公からの好意も察しているものの、それには応えられないと考えていたが……。"}],"source":"egs","sourceCharacterId":"14897","sourceWorkId":"12805","spoiler":false},{"segments":[{"spoiler":false,"text":"未亡人。24才。"},{"spoiler":false,"text":"芯のしっかりした女性だが、その分、頑張りすぎ、何でも一人で抱え込んでしまうところがある。"},{"spoiler":false,"text":"本人もそういった弱さには気づいていない。また情には厚く、近所でも評判の良妻だった。"},{"spoiler":false,"text":"夫である隆秀とは大学生時代の同級生で、在学当時から付き合っており、後に結婚する。"},{"spoiler":false,"text":"結婚後は義弟の秀樹と3人暮らしを、隆秀兄弟の営む喫茶店を手伝うことになる。"}],"source":"bangumi","sourceCharacterId":"205489"}],"profileFacts":[{"label":"年龄（本版本）","value":"24 岁","valueContext":null,"source":"egs","sourceCharacterId":"14897","sourceWorkId":"12805","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e28381db47a21860e9669fca5ffe6a84d9ed17c68476b96364b6347b2cf86fbc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c4728a4aaeb630a96a58fd68650f8d2a60e1af6830b5801377f91a4fd7929cd.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c155584","characterName":"岡崎 秀樹","sourceIds":{"vndbCharacterId":"c155584"},"originalCharacterName":"岡崎 秀樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"19"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p314","sourceCompanyId":"egs:brand:2093","canonicalEntityId":"vndb:p314","name":"Norn","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:12805:2093","source":"egs"},{"companyId":"vndb:p314","sourceCompanyId":"vndb:p314","canonicalEntityId":"vndb:p314","name":"Norn",