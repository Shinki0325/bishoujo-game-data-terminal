text":"『16騎士』の中でも最強と謂われ、最も悪を憎む正義の女騎士として民衆からは聖人の様に敬われている。"}],"source":"bangumi","sourceCharacterId":"94297"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65aa1c12d633951a5cd48bda6313c41f75d61bd353b874ce3a5d4e9d680de294.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bb50f3e5233c9058ab5ec3efbb5fadbc81a233755224cdab3bbfc125998a967.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"もえはら ぶり","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"韮井叶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13134","source":"vndb"}]},{"characterId":"char_c29105","characterName":"あやめ","sourceIds":{"bangumi":[{"characterId":"130282","match":"exact-normalized-name-in-linked-work","subjectId":"91315"}],"egsCharacterIds":["18791"],"vndbCharacterId":"c29105"},"originalCharacterName":"あやめ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が舞台となる鬼方村で出会った和服姿の少女。"},{"spoiler":false,"text":"どことなく古めかしく、上品な雰囲気を漂わせているが、時折、無邪気な表情を見せたり、哀しげな表情を見せる。"},{"spoiler":false,"text":"主人公の祖父に世話になったことがあるらしいのだが……。"}],"source":"egs","sourceCharacterId":"18791","sourceWorkId":"7868","spoiler":false},{"segments":[{"spoiler":false,"text":"『AYAME～人形婬戯～』のメインヒロイン。"},{"spoiler":false,"text":"主人公が舞台となる鬼方村で出会った和服姿の少女。"},{"spoiler":false,"text":"どことなく古めかしく、上品な雰囲気を漂わせているが、時折、無邪気な表情を見せたり、哀しげな表情を見せる。"},{"spoiler":false,"text":"主人公の祖父に世話になったことがあるらしいのだが……。"}],"source":"egs","sourceCharacterId":"18791","sourceWorkId":"10412","spoiler":false},{"segments":[{"spoiler":false,"text":"鬼方村で出会った和服姿の美少女。純一の祖父に世話になったことがあるらしい。"},{"spoiler":false,"text":"どことなく古めかしく、上品な雰囲気が漂っているが、時折、驚くほど無邪気な顔を、そして哀しそうな顔を見せる。"},{"spoiler":false,"text":"純一とのふれあいの中で、彼女に生じた変化が、やがて彼女自身を苦しめることになる。"},{"spoiler":false,"text":"『優しくて不思議なお方……。私は、あなたをお待ちしておりました……』"}],"source":"bangumi","sourceCharacterId":"130282"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69fa2a4c89a6f843ca8933d01eef6aa5666d42a5ee1f84f6cee38fd5bfb40e58.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/436da89db90e029951bc635d02247ccc259a2ab3332dac238c2196d6709748c7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"逢川 奈々","creatorId":"vndb:s530","sourcePersonId":"vndb:s530","canonicalEntityId":"vndb:s530","name":"逢川奈々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13131","source":"vndb"}]},{"characterId":"char_c29106","characterName":"鬼方 由水","sourceIds":{"bangumi":[{"characterId":"130283","match":"exact-normalized-name-in-linked-work","subjectId":"91315"}],"egsCharacterIds":["18792"],"vndbCharacterId":"c29106"},"originalCharacterName":"鬼方 由水","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の妹。"},{"spoiler":false,"text":"活発で行動的な女の子。"},{"spoiler":false,"text":"主人公との音信が途絶えたことにより、自身も舞台となる鬼方村へと赴く。"},{"spoiler":false,"text":"霊感が強く、村であやめそっくりの亡霊を目撃するが……。"}],"source":"egs","sourceCharacterId":"18792","sourceWorkId":"7868","spoiler":false},{"segments":[{"spoiler":false,"text":"『AYAME～人形婬戯～』の主人公・鬼方純一の妹。"},{"spoiler":false,"text":"活発で行動的な女の子。"},{"spoiler":false,"text":"主人公との音信が途絶えたことにより、自身も舞台となる鬼方村へと赴く。"},{"spoiler":false,"text":"霊感が強く、村であやめそっくりの亡霊を目撃するが……。"}],"source":"egs","sourceCharacterId":"18792","sourceWorkId":"10412","spoiler":false},{"segments":[{"spoiler":false,"text":"純一の妹。"},{"spoiler":false,"text":"思慮深いが、おっとり方の兄に比べて、活動的で、思ったことをすぐ行動に移すタイプ。鬼方村に行ったきり、連絡が途絶えてしまった兄を心配し、自身もその地に赴く。"},{"spoiler":false,"text":"多少、霊感があり、村であやめそっくりの亡霊（？）を目撃する。"},{"spoiler":false,"text":"『わたしは毎日すっごい忙しいのっ、バイトとか勉強とかお兄ちゃんの世話とかっ』"}],"source":"bangumi","sourceCharacterId":"130283"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b846ecf7fdb70f4e4f9dec61cef103051b4796409431d0d03b9188129fca4f6f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/559b4045eff7a6821cf5f3612a994aef0c6c06ff9bddc1b45748467b4f618098.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日 アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日アン(春乃うらら)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13133","source":"vndb"}]},{"characterId":"char_c29542","characterName":"東雲 乙香","sourceIds":{"bangumi":[{"characterId":"144045","match":"exact-normalized-name-in-linked-work","subjectId":"266016"}],"egsCharacterIds":["18794"],"vndbCharacterId":"c29542"},"originalCharacterName":"東雲 乙香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の姉で、祓魔師のエキスパート。"},{"spoiler":false,"text":"学力、運動、容姿の全てにおいてハイレベルな天才肌だが、少々性格に難があり、学園内でもいつもツンケンしている。"},{"spoiler":false,"text":"自分にも他人にも厳しいタイプで、特に主人公に対しては特に厳しい。"},{"spoiler":false,"text":"が、弟に自分以外の女の子が近づくと、途端に不機嫌になるが……？"},{"spoiler":false,"text":"インクに魂を人質に取られた主人公を救うため、恥ずかしながらも弟を誘惑したり、奉仕したりとエッチなことをするハメに。"}],"source":"egs","sourceCharacterId":"18794","sourceWorkId":"10203","spoiler":false},{"segments":[{"spoiler":false,"text":"『お祓いお姉さん！ ～弟を誘惑しなさいっ～』のメインヒロインで、祓魔師のエキスパート。"},{"spoiler":false,"text":"学力、運動、容姿の全てにおいてハイ