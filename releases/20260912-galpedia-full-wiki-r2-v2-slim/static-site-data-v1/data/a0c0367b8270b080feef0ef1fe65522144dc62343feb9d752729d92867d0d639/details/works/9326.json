taff:33304","source":"vndb"}]},"cast":[{"characterId":"char_c29392","characterName":"夏目 翔子","sourceIds":{"bangumi":[{"characterId":"94303","match":"exact-normalized-name-in-linked-work","subjectId":"266089"}],"egsCharacterIds":["19970"],"vndbCharacterId":"c29392"},"originalCharacterName":"夏目 翔子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"何処にでもいるような貞淑な人妻。"},{"spoiler":false,"text":"サラリーマンの夫・隆史と長男・優一、娘・美香の四人家族。"},{"spoiler":false,"text":"幸せな家族と思われがちだが、夫が仕事に忙しく、家庭を顧みなくなっていることに不満を感じている。"},{"spoiler":false,"text":"夫婦の営みもほとんどなく、かなりの欲求不満。"},{"spoiler":false,"text":"そんなとき、ネットで淫らな掲示板サイトを見つけ、次第に倒錯した世界へと堕ちていく。"}],"source":"egs","sourceCharacterId":"19970","sourceWorkId":"9326","spoiler":false},{"segments":[{"spoiler":false,"text":"貞淑な人妻。夫を愛しているが、夫はいつも仕事のことばかりで、家庭や翔子のことを顧みなくなっている事に不満を覚えている。"},{"spoiler":false,"text":"セックスに関しても、最近は自分から誘っても応じてくれない上、行為があっても非常に淡白で自分勝手に一人でイッてしまう夫に相当の欲求不満を感じている。"},{"spoiler":false,"text":"そんな時ネットで淫らな掲示板サイトを発見、ほんの遊び心の書き込みから予期せぬ運命に翻弄されてゆく。"}],"source":"bangumi","sourceCharacterId":"94303"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56c98e1b5fee8ed13c1fd42f1e1686af493caffc4fb9df26caacf45f18735dc7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b42fe91f727e73e81db08f6e97af0bf87b5968f0f650eb81ffa86753d56b69f0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紫水 晶","creatorId":"vndb:s2990","sourcePersonId":"vndb:s2990","canonicalEntityId":"vndb:s2990","name":"紫水 晶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:17756","source":"vndb"}]},{"characterId":"char_c29393","characterName":"岡田 和美","sourceIds":{"bangumi":[{"characterId":"94304","match":"exact-normalized-name-in-linked-work","subjectId":"266089"}],"egsCharacterIds":["19972"],"vndbCharacterId":"c29393"},"originalCharacterName":"岡田 和美","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"翔子と同じマンションに住んでいる友人。"},{"spoiler":false,"text":"共働きで子供は居ない。"},{"spoiler":false,"text":"性については奔放で、男性だけでなく女性経験もある。"},{"spoiler":false,"text":"翔子と主人公の関係も薄々感付いているようだが……。"}],"source":"egs","sourceCharacterId":"19972","sourceWorkId":"9326","spoiler":false},{"segments":[{"spoiler":false,"text":"翔子と同じマンションに住んでいる友人。夫婦共に共働きで子供はいない。性格は、ざっくばらんとしており親しみやすい。"},{"spoiler":false,"text":"性についてもざっくばらんな感じがあり、レズではないが女性経験もあり。 翔子と一仁の行いについても薄々感づくが何も咎めようとしない。"}],"source":"bangumi","sourceCharacterId":"94304"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/519eb41384eab02f6cebe7d4871b665c9d9a464a32a5faa30d43a037fc6d4330.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc91db6339a219c239401f2ed6ed14e8e04329212d11e1aed1252677403fa032.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山崎 ゆうな","creatorId":"vndb:s2991","sourcePersonId":"vndb:s2991","canonicalEntityId":"vndb:s2991","name":"山碕 ゆうな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:17757","source":"vndb"}]},{"characterId":"char_c29394","characterName":"夏目 美香","sourceIds":{"bangumi":[{"characterId":"94305","match":"exact-normalized-name-in-linked-work","subjectId":"266089"}],"egsCharacterIds":["19971"],"vndbCharacterId":"c29394"},"originalCharacterName":"夏目 美香","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"sour