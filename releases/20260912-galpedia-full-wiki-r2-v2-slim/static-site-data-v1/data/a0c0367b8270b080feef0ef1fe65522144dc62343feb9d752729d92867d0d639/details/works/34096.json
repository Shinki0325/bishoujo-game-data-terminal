{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"34096","model":{"presentationWorkId":"vndb:v42945","staff":{"artwork":[],"scenario":[],"music":[{"creditedName":"鈴木 ぷよ","creatorId":"vndb:s16368","sourcePersonId":"vndb:s16368","canonicalEntityId":"vndb:s16368","name":"鈴木 美弘","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:194619","source":"vndb"}],"other":[{"creditedName":"甘美 梨羽","creatorId":"vndb:s54139","sourcePersonId":"vndb:s54139","canonicalEntityId":"vndb:s54139","name":"甘美 梨羽","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:194620","source":"vndb"},{"creditedName":"小寺 可南子","creatorId":"vndb:s54140","sourcePersonId":"vndb:s54140","canonicalEntityId":"vndb:s54140","name":"小寺 可南子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:194621","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c125035","characterName":"Saiga Tendo","sourceIds":{"vndbCharacterId":"c125035"},"originalCharacterName":"Saiga Tendo","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"29"},"birthday":{"reviewState":"source-only","source":"vndb","value":"929"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is the unluckiest detective in the universe, overlooked by the Goddess of Fate and loved by the God of Death and the God of Poverty."},{"spoiler":false,"text":"He longs to be a great detective like Holmes or Kindaichi, who solves big cases."},{"spoiler":false,"text":"However, the requests he receives are only commonplace cases such as \"looking for a pet that has run away\" or \"trouble in the shopping arcade."},{"spoiler":false,"text":"Even these requests are met with a series of mishaps, and he is continually failing."},{"spoiler":false,"text":"Will he ever be called a \"great detective\"?"}],"source":"vndb","sourceCharacterId":"c125035"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3fbc697b2767dacb338e5ad7f7cd03dacaa002bd134de7b7b67f3f4968947f7e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81fad583112e35c9269da355b34a843e51471e6221df6fc5b274646179e6ec94.webp","width":136,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林親弘","creatorId":"vndb:s20191","sourcePersonId":"vndb:s20191","canonicalEntityId":"vndb:s20191","name":"小林親弘","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:94606","source":"vndb"}]},{"characterId":"char_vndb_c125036","characterName":"Hin Rei","sourceIds":{"vndbCharacterId":"c125036"},"originalCharacterName":"Hin Rei","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"909"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"There is not a shred of mysteriousness about her, she is a fortune teller with high tension."},{"spoiler":false,"text":"She is well versed in palmistry, tarot, astrology, and various other forms of fortune telling, and boasts a hundred-percent accuracy rate."},{"spoiler":false,"text":"In order to change Tendo's worst luck, she becomes a detective assistant and solves the town's troubles."},{"spoiler":false,"text":"What do you see behind the crystal ball, a happy ending or a bad one?"}],"source":"vndb","sourceCharacterId":"c125036"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04a6e248211b0e71e51513aee4dbee0d88161723f89f56b83594b7b8cf377686.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6c0b0b3c387d02b1473f5717db1da085eab96e6d0df7dea1de332fe90437b3b.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"内田 真礼","creatorId":"vndb:s1326","sourcePersonId":"vndb:s1326","canonicalEntityId":"vndb:s1326","name":"内田 真礼","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:94605","source":"vndb"}]},{"characterId":"char_vndb_c125037","characterName":"Chouno Sanagi","sourceIds":{"vndbCharacterId":"c125037"},"originalCharacterName":"Chouno Sanagi","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"10"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1010"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A fifth grader who has been in and out of the detective agency without permission."},{"spoiler":false,"text":"She is the point of contact for the office and is a solid girl who accepts requests, manages the website, and does the accounting."},{"spoiler":false,"text":"For some reason, she dreams of becoming Tendo's bride and sees Rei as her rival."}],"source":"vndb","sourceCharacterId":"c125037"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d2204648b1854b62b5504f076d08ed69837c90b89245685fa03e9a1bc38cbbc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb2b15877aa70605eb69bc3efbbd4c93460cc337419abe42a3ae8b38bca8d3ad.webp","width":164,"height":256,"source":"static-detail"},"actors":[{"creditedName":"日野 まり","creatorId":"vndb:s33635","sourcePer