{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"8253","model":{"presentationWorkId":"vndb:v352","staff":{"artwork":[{"creditedName":"水島☆多也","creatorId":"vndb:s576","sourcePersonId":"egs:creator:130","canonicalEntityId":"vndb:s576","name":"水島☆多也","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:20283","source":"egs"}],"scenario":[{"creditedName":"小沢裕樹","creatorId":"vndb:s919","sourcePersonId":"egs:creator:3894","canonicalEntityId":"vndb:s919","name":"小沢裕樹","detail":"碧","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:141419","source":"egs"},{"creditedName":"酒巻雨竜","creatorId":"vndb:s908","sourcePersonId":"egs:creator:2619","canonicalEntityId":"vndb:s908","name":"酒巻雨竜","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:20284","source":"egs"},{"creditedName":"想ファクトリー","creatorId":"vndb:s2777","sourcePersonId":"egs:creator:2071","canonicalEntityId":"vndb:s2777","name":"想ファクトリー","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:20285","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c24174","characterName":"水無瀬 紗由理","sourceIds":{"bangumi":[{"characterId":"92795","match":"exact-normalized-name-in-linked-work","subjectId":"269668"}],"egsCharacterIds":["24349"],"vndbCharacterId":"c24174"},"originalCharacterName":"水無瀬 紗由理","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1028"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A member of the piano department. Commonly known as the 'Rose Princess', she is the most honorable student in the academy, and her family is well-known. A genuine Ojou-sama."},{"spoiler":false,"text":"Her manners, academics, and musical skills are top-notch, and her beautiful appearance makes her an icon at her school."},{"spoiler":false,"text":"She's smart and sharp, but is naive about the world. She has an instinctive dislike for the main character."},{"spoiler":false,"text":"As Representative of the piano department, she organizes all the students in it and has close relationship with the other representatives."}],"source":"vndb","sourceCharacterId":"c24174"},{"segments":[{"spoiler":false,"text":"竜胆女子学院音楽学部で、器楽学科のピアノ専攻の代表。通称『薔薇の姫様』。"},{"spoiler":false,"text":"ヒロインの上級生で、学院きっての優等生。"},{"spoiler":false,"text":"家柄も有名な、生粋のお嬢様。"},{"spoiler":false,"text":"淑女としての振るまい方、学業、音楽の技術とどれをとってもピカ一で、更に学生離れした美しい容姿から、学院内でも知らない者がいないほどの有名人。"},{"spoiler":false,"text":"頭もよく回る切れ者だが、少し世間離れしたところがある。"},{"spoiler":false,"text":"主人公に対しては生理的に受け付けないと嫌悪感を抱いている。"},{"spoiler":false,"text":"ピアノ専攻の代表として、ピアノ専攻をまとめるほか、他の専攻・学科とも交流が深い。"},{"spoiler":false,"text":"中でも打楽器・管楽器専攻代表の圭とは親友の関係にあり、弦楽器専攻代表の碧とも親密な仲となっている。"}],"source":"egs","sourceCharacterId":"24349","sourceWorkId":"8253","spoiler":false},{"segments":[{"spoiler":false,"text":"３学年　Ａクラス"},{"spoiler":false,"text":"音楽学部　器楽学科 ピアノ専攻"},{"spoiler":false,"text":"専攻楽器 ピアノ"},{"spoiler":false,"text":"竜胆女子学院音楽学部で、器楽学科のピアノ専攻の代表。通称『薔薇の姫様』。学院きっての優等生で家柄も有名な、生粋のお嬢様。"},{"spoiler":false,"text":"淑女としての振るまい方、学業、音楽の技術どれをとってもピカ一で、更に学生離れした美しい容姿から、学院内でも知らない者がいない有名人。"},{"spoiler":false,"text":"頭もよく回る切れ者だが、少し世間離れしたところがある。主人公に対しては生理的に受け付けないと嫌悪感を抱いている。"},{"spoiler":false,"text":"ピアノ専攻の代表として、ピアノ専攻をまとめるほか、他の専攻・学科とも交流が深い。中でも打楽器・管楽器専攻代表の圭とは親友であり、弦楽器専攻代表の碧とも親密な仲。とりわけ、碧に関しては、下級生である以上に妹のように睦まじく接し、「お姉さま」と呼ばれるほど親密な関係を築いている。"}],"source":"bangumi","sourceCharacterId":"92795"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"24349","sourceWorkId":"8253","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"24349","sourceWorkId":"8253","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"24349","sourceWorkId":"8253","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"24349","sourceWorkId":"8253","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"24349","sourceWorkId":"8253","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"45 kg","valueContext":null,"source":"egs","sourceCharacterId":"24349","sourceWorkId":"8253","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"bust":[{"comparisonValue":"88","source":"vndb","sourceCharacterId":"c24174","value":"88"},{"comparisonValue":"88","scope":"sourceWork","source":"egs","sourceCharacterId":"24349","sourceWorkId":"8253","value":"88"},{"comparisonValue":"84","source":"bangumi","sourceCharacterId":"92795","value":"84"}],"waist":[{"comparisonValue":"56","source":"vndb","sourceCharacterId":"c24174","value":"56"},{"comparisonValue":"56","scope":"sourceWork","source":"egs","sourceCharacterId":"24349","sourceWorkId":"8253","value":"56"},{"comparisonValue":"55","source":"bangumi","sourceCharacterId":"92795","value":"55"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c979092e49f7eef8eaf96c632359c08c12d7bc9cc3375e345b055f1ce9db000.webp","fallbackUrl":"ht