bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cde7dad18859dd0306f7642a2be5ebe2e2690401c959a0424d11614275e3897.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b99309e7d328cc3163eb6081f3e2dbf5f64e5e359b103aa85df715abc33a0283.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹間千ノ美","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271329:95409:19333:1","source":"bangumi"}]},{"characterId":"char_c23020","characterName":"北大路 凛","sourceIds":{"bangumi":[{"characterId":"95410","match":"exact-normalized-name-in-linked-work","subjectId":"271329"}],"egsCharacterIds":["4707"],"vndbCharacterId":"c23020"},"originalCharacterName":"北大路 凛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"俺がこの街にやってきて早々に手を出してしまった女子校生だ。"},{"spoiler":false,"text":"しばらく痴漢の技を封印するつもりで地方に移ったってのに、コイツのせいで俺は再びこの街でも痴漢として活動することになっちまった。"},{"spoiler":false,"text":"ずいぶんといいところのお嬢様らしくて、その育ちのせいか性格は高飛車。"},{"spoiler":false,"text":"ワガママ。生意気でプライドが高く、負けず嫌いときてる！"},{"spoiler":false,"text":"そのくせ、やけに打たれ弱いところがあって、ガキっぽい。というかまだガキだ。"},{"spoiler":false,"text":"ま、そういった弱みを見せてるときはなかなか可愛いヤツなんだが。"},{"spoiler":false,"text":"俺が痴漢をして処女を奪ってから、何を考えてかは知らないが、従姉の穂香と一緒に周りをウロチョロするようになった。"},{"spoiler":false,"text":"せっかくだから痴漢の仕事を色々手伝わせているが、役に立つんだか立たないんだか。"},{"spoiler":false,"text":"アレの時は案外積極的に迫ってくるから、ナニを勃たせるのはなかなか上手いんだけどな。フフフフ……。"},{"spoiler":false,"text":"このお嬢様を側に置いてる一番の理由は、コイツが俺に渡してくれた、この地域を走る電車に自由に乗れるフリーパスの存在があるからだ。"},{"spoiler":false,"text":"痴漢にとって、電車に乗り放題という特典はこの上ないくらいありがたい。金持ちとは仲良くしておくものだな。"},{"spoiler":false,"text":"毎度何だかんだと文句は言うが、俺の命令にはたいてい従うし、しばらくは仲間として付き合っていてもいいかな、と思ってる。"},{"spoiler":false,"text":"しっかり働いてくれれば、たっぷりエロいご褒美をやるからな。よろしく頼むぜ……。"}],"source":"egs","sourceCharacterId":"4707","sourceWorkId":"11664","spoiler":false},{"segments":[{"spoiler":false,"text":"【痴漢レポート】"},{"spoiler":false,"text":"俺がこの街にやってきて早々に手を出してしまった女子校生だ。"},{"spoiler":false,"text":"しばらく痴漢の技を封印するつもりで地方に移ったってのに、コイツのせいで俺は再びこの街でも痴漢として活動することになっちまった。"},{"spoiler":false,"text":"ずいぶんといいところのお嬢様らしくて、その育ちのせいか性格は高飛車。"},{"spoiler":false,"text":"ワガママ。生意気でプライドが高く、負けず嫌いときてる！"},{"spoiler":false,"text":"そのくせ、やけに打たれ弱いところがあって、ガキっぽい。というかまだガキだ。"},{"spoiler":false,"text":"ま、そういった弱みを見せてるときはなかなか可愛いヤツなんだが。"},{"spoiler":false,"text":"俺が痴漢をして処女を奪ってから、何を考えてかは知らないが、従姉の穂香と一緒に周りをウロチョロするようになった。"},{"spoiler":false,"text":"せっかくだから痴漢の仕事を色々手伝わせているが、役に立つんだか立たないんだか。"},{"spoiler":false,"text":"アレの時は案外積極的に迫ってくるから、ナニを勃たせるのはなかなか上手いんだけどな。フフフフ……。"},{"spoiler":false,"text":"このお嬢様を側に置いてる一番の理由は、コイツが俺に渡してくれた、この地域を走る電車に自由に乗れるフリーパスの存在があるからだ。"},{"spoiler":false,"text":"痴漢にとって、電車に乗り放題という特典はこの上ないくらいありがたい。金持ちとは仲良くしておくものだな。"},{"spoiler":false,"text":"毎度何だかんだと文句は言うが、俺の命令にはたいてい従うし、しばらくは仲間として付き合っていてもいいかな、と思ってる。"},{"spoiler":false,"text":"しっかり働いてくれれば、たっぷりエロいご褒美をやるからな。よろしく頼むぜ……。"}],"source":"egs","sourceCharacterId":"4707","sourceWorkId":"19942","spoiler":false},{"segments":[{"spoiler":false,"text":"俺がこの街にやってきて早々に手を出してしまった女子校生だ。"},{"spoiler":false,"text":"しばらく痴漢の技を封印するつもりで地方に移ったってのに、コイツのせいで俺は再びこの街でも痴漢として活動することになっちまった。"},{"spoiler":false,"text":"ずいぶんといいところのお嬢様らしくて、その育ちのせいか性格は高飛車。"},{"spoiler":false,"text":"ワガママ。生意気でプライドが高く、負けず嫌いときてる！"},{"spoiler":false,"text":"そのくせ、やけに打たれ弱いところがあって、ガキっぽい。というかまだガキだ。"},{"spoiler":false,"text":"ま、そういった弱みを見せてるときはなかなか可愛いヤツなんだが。"},{"spoiler":false,"text":"俺が痴漢をして処女を奪ってから、何を考えてかは知らないが、従姉の穂香と一緒に周りをウロチョロするようになった。"},{"spoiler":false,"text":"せっかくだから痴漢の仕事を色々手伝わせているが、役に立つんだか立たないんだか。"},{"spoiler":false,"text":"アレの時は案外積極的に迫ってくるから、ナニを勃たせるのはなかなか上手いんだけどな。フフフフ……。"},{"spoiler":false,"text":"このお嬢様を側に置いてる一番の理由は、コイツが俺に渡してくれた、この地域を走る電車に自由に乗れるフリーパスの存在があるからだ。"},{"spoiler":false,"text":"痴漢にとって、電車に乗り放題という特典はこの上ないくらいありがたい。金持ちとは仲良くしておくものだな。"},{"spoiler":false,"text":"毎度何だかんだと文句は言うが、俺の命令にはたいてい従うし、しばらくは仲間として付き合っていてもいいかな、と思ってる。"},{"spoiler":false,"text":"しっかり働いてくれれば、たっぷりエロいご褒美をやるからな。よろしく頼むぜ……。"}],"source":"bangumi","sourceCharacterId":"95410"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"4707","sourceWorkId":"11664","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"4707","sourceWorkId":"11664","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"4707","sourceWorkId":"11664","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"4707","sourceWorkId":"11664","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"4707","sourceWorkId":"11664","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"45 kg","valueContext":null,"source":"egs","sourceCharacterId":"4707","sourceWorkId":"11664","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc16a7537580f6d2b4be8fb2ddf6faee3b780a79454ebbcb2506ea58e683fee4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/8052f6f59540e7efcfe115c2eaa8a88b60b19a99eb530a08a12e33fb1482c16b.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vn