","identityStatus":"source-native","relationId":"vndb:vn-staff:156036","source":"vndb"},{"creditedName":"nao","creatorId":"vndb:s935","sourcePersonId":"vndb:s935","canonicalEntityId":"vndb:s935","name":"nao","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:156039","source":"vndb"},{"creditedName":"天ヶ咲 麗","creatorId":"vndb:s4314","sourcePersonId":"vndb:s4314","canonicalEntityId":"vndb:s4314","name":"天ヶ咲 麗","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:156040","source":"vndb"},{"creditedName":"キャンディホリック","creatorId":"vndb:s18732","sourcePersonId":"vndb:s18732","canonicalEntityId":"vndb:s18732","name":"キャンディホリック","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:156043","source":"vndb"}]},"cast":[{"characterId":"char_c81044","characterName":"植草 ひばり","sourceIds":{"bangumi":[{"characterId":"69555","match":"exact-normalized-name-in-linked-work","subjectId":"271185"}],"egsCharacterIds":["21127"],"vndbCharacterId":"c81044"},"originalCharacterName":"植草 ひばり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1013"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hibari Uekusa is a rookie nurse who started working at Seisho General Hospital this spring. She becomes one of Keita's attending nurses. Back in their school days, she had a slight crush on Keita but graduated without ever confessing her feelings. Afterward, she attended nursing school and started working at this hospital this spring."},{"spoiler":false,"text":"Hibari was a sheltered girl and had never had a boyfriend because she worked hard studying to become a nurse. Her understanding and experience of love are somewhat naive, typical of a virgin."},{"spoiler":false,"text":"Hibari's purity makes her susceptible. While she is perplexed by Keita's physical demands, she doesn't find them repulsive."}],"source":"vndb","sourceCharacterId":"c81044"},{"segments":[{"spoiler":false,"text":"この春から聖奨総合病院に入職したばかりの新人ナース。"},{"spoiler":false,"text":"主人公の担当ナースの一人となる。"},{"spoiler":false,"text":"学園時代、主人公にほのかな恋心を抱いていたが、打ち明けることのないまま卒業してしまう。"},{"spoiler":false,"text":"その後は看護学校へ進学し、この春からこの病院で働き始めた。"},{"spoiler":false,"text":"箱入り娘で、ナースになるために一生懸命勉強していたこともあって男性と付き合ったことはない。"},{"spoiler":false,"text":"免疫も理解もないため、恋愛観はやや幼い。当然、処女。"},{"spoiler":false,"text":"純粋であるがゆえに無警戒。"},{"spoiler":false,"text":"主人公が身体を求めてきたことには戸惑っているが、嫌悪はしていない。"}],"source":"egs","sourceCharacterId":"21127","sourceWorkId":"27756","spoiler":false},{"segments":[{"spoiler":false,"text":"この春から聖奨総合病院に入職したばかりの新人ナース。"},{"spoiler":false,"text":"主人公の担当ナースの一人となる。"},{"spoiler":false,"text":"学園時代、主人公にほのかな恋心を抱いていたが、"},{"spoiler":false,"text":"打ち明けることのないまま卒業してしまう。"},{"spoiler":false,"text":"その後は看護学校へ進学し、この春からこの病院で働き始めた。"},{"spoiler":false,"text":"箱入り娘で、ナースになるために、"},{"spoiler":false,"text":"一生懸命勉強していたこともあって男性と付き合ったことはない。"},{"spoiler":false,"text":"免疫も理解もないため、恋愛観はやや幼い。当然、処女。"},{"spoiler":false,"text":"純粋であるがゆえに無警戒。"},{"spoiler":false,"text":"主人公が身体を求めてきたことには戸惑っているが、嫌悪はしていない。"}],"source":"bangumi","sourceCharacterId":"69555"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"21127","sourceWorkId":"27756","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"21127","sourceWorkId":"27756","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"21127","sourceWorkId":"27756","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"21127","sourceWorkId":"27756","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"21127","sourceWorkId":"27756","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/acb9154ada71aa439dcf4e6e815beb7ee36a21c7fc05013d28a6fedbc5d1e33b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/0108b1a37cb9e1cad5b53e5377f12cafd7bcd1e89e5fcc768e65c7d5e3bf6bed.webp","width":106,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩崎可苗","creatorId":"vndb:s12843","sourcePersonId":"vndb:s12843","canonicalEntityId":"vndb:s12843","name":"そよかぜみらい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271185:69555:10038:1","source":"bangumi"}]},{"characterId":"char_c81045","characterName":"An (アン)","sourceIds":{"bangumi":[{"characterId":"69556","match":"exact-normalized-name-in-linked-work","subjectId":"271185"}],"egsCharacterIds":["21128"],"vndbCharacterId":"c81045"},"originalCharacterName":"An (アン)","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"802"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affectionately known as \"An,\" Angelia is a senior nurse to Hibari and one of Keita's attending nurses. She's a Japanese-English half and was raised in Japan. With her bright and friendly personality, she's trusted by everyone."},{"spoiler":false,"text":"Angelia has high standards for romantic relationships, and she spreads the word that she has a boyfriend to fend off unwanted advances, but in truth, she's a virgin. \"I've decided to give all of myself to the man I determine is 'the one',\" she confides only to Keita."},{"spoiler":false,"text":"That's because Angelia has some interest in Keita, a young prodigy from a top-tier university who seems to have a bright future. Although she's generally supportive of Keita, she isn't averse to making her own audacious moves when the circumstances call for it."}],"source":"vndb","sourceCharacterId":"c81045"},{"segments":[{"spoiler":false,"text":"あだ名はアン。ひばりの先輩ナースで、主人公の担当ナースの一人。"},{"spoiler":false,"text":"日英のハーフで、日本育ち。"},{"spoiler":false,"text":"明るく気さくな性格で誰からも頼られている。"},{"spoiler":false,"text":"恋愛においては理想が高く、虫よけのために彼氏がいるようなことを吹聴しているが実は処女。"},{"spoiler":false,"text":"「絶対この人、って決めた人に女の子の全部捧げるって決めてるんだから」と主人公にだけは打ち明ける。"},{"spoiler":false,"text":"それというのも、若く超一流大学のエリートで未来も明るそうなので主人公に少なからず関心があるから。"},{"spoiler":false,"text":"主人公に協力をしてくれるが、場合によっては強烈にモーションをかけてくることも。"}],"source":"egs","sourceCharacterId":"21128","sourceWorkId":"27756","spoiler":false},{"segments":[{"spoiler":false,"text":"あだ名はアン。ひばりの先輩ナースで、主人公の担当ナースの一人。"},{"spoiler":false,"text":"日英のハーフで、日本育ち。明るく気さくな性格で誰からも頼られている。"},{"spoiler":false,"text":"恋愛においては理想が高く、"},{"spoiler":false,"text":"虫よけのために彼氏がいるようなことを吹聴しているが実は処女。"},{"spoiler":false,"text":"「絶対この人、って決めた人に女の子の全部捧げるって決めてるんだから」"},{"spoiler":false,"text":"と主人公にだけは打ち明ける。"},{"spoiler":false,"text":"それというのも、若く超一流大学のエリートで、"},{"spoiler":false,"text":"未来も明るそうなので主人公に少なからず関心があるから。"},{"spoiler":false,"text":"主人公に協力をしてくれるが、"},{"spoiler":false,"text":"場合によっては強烈にモーションをかけてくることも。"}],"source":"bangumi","sourceCharacterId":"69556"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"21128","sourceWorkId":"27756","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"21128","sourceWorkId":"27756","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"21128","sourceWorkId":"27756","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"21128","sourceWorkId":"27756","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"21128","sourceWorkId":"27756","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f7441769a126c135570dc853c172f1b4fda124913cf82a2634764ccb8d8fd03.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04524203fd5063b4fed3a5c7c63653204076f57ee03596f49c9d3ad63bb4aa9b.webp","width":106,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小澤みのり","creatorId":"vndb:s15910","sourcePersonId":"vndb:s15910","canonicalEntityId":"vndb:s15910","name":"小澤 みのり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271185:69556:32659:1","source":"bangumi"}]},{"characterId":"char_c81046","characterName":"石神 裕也","sourceIds":{"bangumi":[{"characterId":"69557","match":"exact-normalized-name-in-linked-work","subjectId":"271185"}],"egsCharacterIds":["21129"],"vndbCharacterId":"c81046"},"originalCharacterName":"石神 裕也","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"713"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"height":{"reviewState":"no-conflict","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Surgeon"},{"spoiler":false,"text":"Dr. Ishigami, Keita's assigned physician, is a man in his 30s, married, and brimming with prospects as an outstanding doctor. His clean-cut good looks are a magnet for women's attention."},{"spoiler":false,"text":"Despite his soft-spoken demeanor that endears him to the staff, he harbors a dark secret: he meticulously targets and conquers women. However, Hibari leans on him, unknowingly placing her trust in the doctor, even confiding in him about her feelings for Keita."},{"spoiler":false,"text":"On the surface, he appears to counsel Keita and show empathetic concern for Hibari, but in the depths of his heart, he plots to claim her for himself. Keita accidentally stumbles upon Ishigami's reprehensible scheme, urging Hibari to be wary of him. This revelation puts Ishigami on high alert, inadvertently pushing Keita into the line of fire."}],"source":"vndb","sourceCharacterId":"c81046"},{"segments":[{"spoiler":false,"text":"主人公の担当医師。３０代の既婚者。"},{"spoiler":false,"text":"未来ある優秀な医師。外見も清潔感があって女性にもてる。"},{"spoiler":false,"text":"物腰もソフトでスタッフからも人気があるが、実は鬼畜で、これと狙いを定めた女を片っ端からモノにしている。"},{"spoiler":false,"text":"だが、ひばりはこの医師を頼りにしていて、主人公のことも相談してしまう。"},{"spoiler":false,"text":"表面上は主人公をたしなめたり、ひばりに親身に接したりするが本心では彼女をモノにすることしか考えていない。"},{"spoiler":false,"text":"主人公は偶然、この男の愚劣な企みを耳にしてしまい、石神への警戒をヒロインに訴える。"},{"spoiler":false,"text":"そのことでかえって石神を警戒させ、主人公自身も危険にさらされることに。"}],"source":"egs","sourceCharacterId":"21129","sourceWorkId":"27756","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の担当医師。30代の既婚者。"},{"spoiler":false,"text":"未来ある優秀な医師。外見も清潔感があって女性にもてる。"},{"spoiler":false,"text":"物腰もソフトでスタッフからも人気があるが、"},{"spoiler":false,"text":"実は鬼畜でこれと狙いを定めた女を片っ端からモノにしている。"},{"spoiler":false,"text":"だが、ひばりはこの医師を頼りにしていて、主人公のことも相談してしまう。"},{"spoiler":false,"text":"表面上は主人公をたしなめたり、ひばりに親身に接したりするが、"},{"spoiler":false,"text":"本心では彼女をモノにすることしか考えていない。"},{"spoiler":false,"text":"主人公は偶然、この男の愚劣な企みを耳にしてしまい、石神への警戒をヒロインに訴える。"},{"spoiler":false,"text":"そのことでかえって石神を警戒させ、主人公自身も危険にさらされることに。"}],"source":"bangumi","sourceCharacterId":"69557"}],"profileFacts":[{"label":"身高（本版本）","value":"178 cm","valueContext":null,"source":"egs","sourceCharacterId":"21129","sourceWorkId":"27756","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"73 kg","valueContext":null,"source":"egs","sourceCharacterId":"21129","sourceWorkId":"27756","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c81046","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"21129","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"21129","value":"女性"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/482223409e7b698591e645a8cf3091c8515e8441cad22d2833b864a68dbfe8e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/240b00c3d6384ae813a176607cc82931ead8c57c3d74a69665ba91a6ee16c57e.webp","width":106,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c81047","characterName":"久米 憲人","sourceIds":{"bangumi":[{"characterId":"69558","match":"exact-normalized-name-in-linked-work","subjectId":"271185"}],"egsCharacterIds":["21130"],"vndbCharacterId":"c81047"},"originalCharacterName":"久米 憲人","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"3/15"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rehabilitation Physician"},{"spoiler":false,"text":"Kume is a rather bland middle-aged man with a gloomy demeanor, often poorly received by his staff and frequently the recipient of complaints from patients. Hibari's impartial and warm approach towards everyone has led Kume to develop a one-sided infatuation for her, resulting in behavior that borders stalking, including surreptitious photography and eavesdropping. His obsession is undeniably twisted, yet there's a certain purity in his feelings, for better or worse."},{"spoiler":false,"text":"Kume is well aware that Hibari harbors unspoken feelings for Keita, which has given rise to a deep-seated resentment towards him. As a rehabilitation doctor, he wields power to irreversibly affect the outcome of Keita's recovery, a fact he begins to use as an implicit threat. His romantic feelings for Hibari are sincere, yet his demeanor can shift dramatically when he feels betrayed."}],"source":"vndb","sourceCharacterId":"c81047"},{"segments":[{"spoiler":false,"text":"冴えない中年。根暗でスタッフからの受けもあまりよくない。患者からのクレームも多い。"},{"spoiler":false,"text":"ひばりは誰に対しても別け隔てなく接するので、久米は一方的に恋慕し、盗撮や盗聴、ストーキングまがいのことしている。"},{"spoiler":false,"text":"歪んではいるが良くも悪くも自分の想いに対して純粋。"},{"spoiler":false,"text":"ひばりが本当は主人公のことを憎からず想っているのを久米は知ってるので、主人公を逆恨みしている。"},{"spoiler":false,"text":"リハビリ医なので、事故の範囲で取り返しのつかないことができると脅してきたりするようになる。"},{"spoiler":false,"text":"ひばりへの恋愛感情は一途だが、裏切られたと感じれば豹変する。"}],"source":"egs","sourceCharacterId":"21130","sourceWorkId":"27756","spoiler":false},{"segments":[{"spoiler":false,"text":"冴えない中年。根暗でスタッフからの受けもあまりよくない。患者からのクレームも多い。"},{"spoiler":false,"text":"ひばりは誰に対しても別け隔てなく接するので、"},{"spoiler":false,"text":"久米は一方的に恋慕し、盗撮や盗聴、ストーキングまがいのことしている。"},{"spoiler":false,"text":"歪んではいるが良くも悪くも自分の想いに対して純粋。"},{"spoiler":false,"text":"ひばりが本当は主人公のことを憎からず想っているのを久米は知ってるので、主人公を逆恨みしている。"},{"spoiler":false,"text":"リハビリ医なので、事故の範囲で取り返しのつかないことができると脅してきたりするようになる。"},{"spoiler":false,"text":"ひばりへの恋愛感情は一途だが、裏切られたと感じれば豹変する。"}],"source":"bangumi","sourceCharacterId":"69558"}],"profileFacts":[{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"21130","sourceWorkId":"27756","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"64 kg","valueContext":null,"source":"egs","sourceCharacterId":"21130","sourceWorkId":"27756","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b2f351c60d30a44b911e98bef5f5fea3eac551e01084d8472920b2b5e4abe9e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00fcb1157aaa30b70e46537cd11109db8adf99d3da9f75dd9901f7942736d933.webp","width":106,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c81048","characterName":"旭 泰平","sourceIds":{"bangumi":[{"characterId":"69559","match":"exact-normalized-name-in-linked-work","subjectId":"271185"}],"egsCharacterIds":["21131"],"vndbCharacterId":"c81048"},"originalCharacterName":"旭 泰平","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"523"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Taihei Asahi, a plump man around 50, does as he pleases in the hospital, including grabbing nurses' bottoms, yet for some reason, none of the medical staff ever reprimand him. He is, in fact, the chairman of \"Seisho General Hospital,\" and the doctors' treatment can easily change depending on his mood. He treats the doctors as if they're beneath him."},{"spoiler":false,"text":"Unaware of this, Keita interacts with him normally as a fellow patient, perceiving him merely as a lecherous older man. While he's not particularly troubled by women, his hospitalization has frustrated him. Seeing Keita and Hibari's intimate moments stirs his desires."},{"spoiler":false,"text":"He plots to tear apart their pure love and covet Hibari's chastity. With connections in the underworld, he's a dangerous character who can easily cross some risky bridges."}],"source":"vndb","sourceCharacterId":"c81048"},{"segments":[{"spoiler":false,"text":"５０歳前後のずんぐり。スケベで病院内で看護師のお尻を触ったりとやりたい放題なのだが、何故か医師達は誰も注意しない。"},{"spoiler":false,"text":"実は『聖奨総合病院』の理事長で、この男の機嫌次第で簡単に医師の待遇は変わってしまう。"},{"spoiler":false,"text":"他の竿役である医師達のことも顎で使っている。"},{"spoiler":false,"text":"主人公はそれとは知らずに、エロいおっさん程度の認識で入院患者同士として普通に接している。"},{"spoiler":false,"text":"女に困ってはいないが、入院のせいで悶々としているところへ、主人公とひばりのいちゃつく様を見せられてむらむら。"},{"spoiler":false,"text":"二人の純愛を引き裂いてひばりの純潔を貪ってやろうと企む。"},{"spoiler":false,"text":"裏社会にもルートがあり、少々のヤバい橋なら簡単に渡れる危険人物。"}],"source":"egs","sourceCharacterId":"21131","sourceWorkId":"27756","spoiler":false},{"segments":[{"spoiler":false,"text":"50歳前後のずんぐり。スケベで病院内で看護師のお尻を触ったりとやりたい放題なのだが、"},{"spoiler":false,"text":"何故か医師達は誰も注意しない。実は『聖奨総合病院』の理事長で、"},{"spoiler":false,"text":"この男の機嫌次第で簡単に医師の待遇は変わってしまう。医師達のことも顎で使っている。"},{"spoiler":false,"text":"主人公はそれとは知らずに、"},{"spoiler":false,"text":"エロいおっさん程度の認識で入院患者同士として普通に接している。"},{"spoiler":false,"text":"女に困ってはいないが、入院のせいで悶々としているところへ、"},{"spoiler":false,"text":"主人公とひばりのいちゃつく様を見せられてむらむら。"},{"spoiler":false,"text":"二人の純愛を引き裂いてひばりの純潔を貪ってやろうと企む。"},{"spoiler":false,"text":"裏社会にもルートがあり、少々のヤバい橋なら簡単に渡れる危険人物。"}],"source":"bangumi","sourceCharacterId":"69559"}],"profileFacts":[{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"21131","sourceWorkId":"27756","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"89 kg","valueContext":null,"source":"egs","sourceCharacterId":"21131","sourceWorkId":"27756","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c81048","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"21131","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"21131","value":"女性"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/facbc8e12aff9bb3d7583e40f3a1218fc273d8b4d180dd9b9cd794792f86f969.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c95e08949241f7a284f7facc15332fd9609b39c3e120b8fc9cb20d364e39b00.webp","width":106,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林範雄","creatorId":"vndb:s188","sourcePersonId":"vndb:s188","canonicalEntityId":"vndb:s188","name":"小林 範雄","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271185:69559:12716:1","source":"bangumi"}]},{"characterId":"char_c81049","characterName":"清瀬 京太","sourceIds":{"bangumi":[{"characterId":"69560","match":"exact-normalized-name-in-linked-work","subjectId":"271185"}],"egsCharacterIds":["21126"],"vndbCharacterId":"c81049"},"originalCharacterName":"清瀬 京太","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"height":{"reviewState":"no-conflict","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Keita shared his school days with Hibari Uekusa. They attended the same school and were in the same grade but in different classes. At that time, their paths occasionally crossed in the library, but their interactions were limited to polite exchanges. Preoccupied with college entrance exams, the idea of having a girlfriend never crossed his mind. Although he didn't advance their relationship, Hibari's presence always lingered in his heart."},{"spoiler":false,"text":"However, they graduated without him confessing his subtle feelings of love for her. Even after entering college, he remained somewhat isolated, not participating in clubs or social circles. Naturally, he never had a girlfriend."},{"spoiler":false,"text":"Keita's unexpected hospitalization following a traffic accident led to a miraculous reunion with Hibari, who had become a nurse. He's intensely drawn to Hibari's purity and her vibrant work ethic, rekindling the feelings he once had during their school days. Keita is intelligent but a bit neurotic, a quintessential case of social awkwardness. He tends to avoid human relationships altogether."}],"source":"vndb","sourceCharacterId":"c81049"},{"segments":[{"spoiler":false,"text":"植草ひばりとは学園時代、同じ学園でクラスは違うが同学年だった。"},{"spoiler":false,"text":"当時は主に図書室でお互いを見かけるも社交辞令程度の会話止まり。"},{"spoiler":false,"text":"受験第一で恋人を作ることなど考えられなかったため仲が進展することはなかったが、彼女の存在は常に心にあった。"},{"spoiler":false,"text":"だが、結局はほのかな恋心を打ち明けることもなくお互い卒業を迎える。"},{"spoiler":false,"text":"大学に入った後もサークルなどには参加しておらず、孤立気味。"},{"spoiler":false,"text":"当然、女性と付き合ったこともない。"},{"spoiler":false,"text":"交通事故で入院したことを機に、看護師になったひばりと奇跡的に再会した。"},{"spoiler":false,"text":"ひばりの純粋さや活き活きと働く姿に強く惹かれ、また学園時代の想いを新たにしつつある。"},{"spoiler":false,"text":"頭は回るがやや神経質で、いわゆるコミュ障。人間関係そのものを敬遠している。"}],"source":"egs","sourceCharacterId":"21126","sourceWorkId":"27756","spoiler":false},{"segments":[{"spoiler":false,"text":"植草ひばりとは学園時代、同じ学園でクラスは違うが同学年だった。"},{"spoiler":false,"text":"当時は主に図書室でお互いを見かけるも社交辞令程度の会話止まり。"},{"spoiler":false,"text":"受験第一で恋人を作ることなど考えられなかったため、"},{"spoiler":false,"text":"仲が進展することはなかったが彼女の存在は常に心にあった。"},{"spoiler":false,"text":"だが、結局はほのかな恋心を打ち明けることもなくお互い卒業を迎える。"},{"spoiler":false,"text":"大学に入った後もサークルなどには参加しておらず、孤立気味。"},{"spoiler":false,"text":"当然、女性と付き合ったこともない。"},{"spoiler":false,"text":"交通事故で入院したことを機に、看護師になったひばりと奇跡的に再会した。"},{"spoiler":false,"text":"ひばりの純粋さや活き活きと働く姿に強く惹かれ、また学園時代の想いを新たにしつつある。"},{"spoiler":false,"text":"頭は回るがやや神経質で、いわゆるコミュ障。人間関係そのものを敬遠している。"}],"source":"bangumi","sourceCharacterId":"69560"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0d7824b7a89b0a760554f7adfdd59a6aa4ed69e118d945c98107bed7d2513fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fab2e4fd86b4180954719983bcd588f2b1127811e1c848f7971fecc1fe1286be.webp","width":251,"height":254,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p980","sourceCompanyId":"egs:brand:1815","canonicalEntityId":"vndb:p980","name":"LiLiM DARKNESS","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:27756:1815","source":"egs"},{"companyId":"vndb:p15756","sourceCompanyId":"vndb:p15756","canonicalEntityId":"vndb:p15756","name":"SVN","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:148225:v25376","source":"vndb"},{"companyId":"vndb:p10008","sourceCompanyId":"vndb:p10008","canonicalEntityId":"vndb:p10008","name":"ホビコレD","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:162151:v25376","source":"vndb"},{"companyId":"vndb:p980","sourceCompanyId":"vndb:p980","canonicalEntityId":"vndb:p980","name":"LiLiM DARKNESS","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:162845:v25376","source":"vndb"},{"companyId":"vndb:p10008","sourceCompanyId":"vndb:p10008","canonicalEntityId":"vndb:p10008","name":"ホビコレD","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:162846:v25376","source":"vndb"},{"companyId":"vndb:p980","sourceCompanyId":"vndb:p980","canonicalEntityId":"vndb:p980","name":"LiLiM DARKNESS","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:70450:v25376","source":"vndb"},{"companyId":"vndb:p980","sourceCompanyId":"vndb:p980","canon