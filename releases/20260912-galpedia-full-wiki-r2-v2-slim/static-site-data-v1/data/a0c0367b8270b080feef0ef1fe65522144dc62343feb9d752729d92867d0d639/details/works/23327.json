-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Takuto's wife. She works as a part time lecturer for high schools and universities. She is a very caring and helpful person even to strangers, and because of her straight forward personality she often overdoes things causing her to blunder."},{"spoiler":false,"text":"She has a very unyielding personality and hates to lose, yet when it comes to her husband she is quite obedient and listens to whatever he says."},{"spoiler":false,"text":"She sees herself as Takuma's real sister and teases him a lot."}],"source":"vndb","sourceCharacterId":"c43408"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/7158ec5a511e0b162c66e2a2dd2af54d8d8369e804f4873f359571f7b5dddb6a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eaec58136d51d027c17d813c11d302a4696f7e7bac9dd0192c9743c66f54b7c1.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"綾音 まこ","creatorId":"vndb:s2581","sourcePersonId":"vndb:s2581","canonicalEntityId":"vndb:s2581","name":"綾音 まこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68073","source":"vndb"}]},{"characterId":"char_vndb_c43409","characterName":"本間 千佳子","sourceIds":{"vndbCharacterId":"c43409"},"originalCharacterName":"本間 千佳子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kyouka's mother, a very understanding married woman with a refined and gentle air about her. She attends swimming and yoga classes on weekdays and enjoys dancing."},{"spoiler":false,"text":"When Kyouka got married, she felt a little lonely, but when she heard Takuma was going to live with her, she was really delighted. Like her daughter, she is very good at taking care of others and has strong maternal instincts."},{"spoiler":true,"text":"She reveals that her husband had an affair with a young woman when Kyouka was a young child, and she herself suffered the affair. She told Takuma that she wanted to have an affair with someone else to get revenge on her husband, so she didn't mind having an affair with Takuma, not out of love but for revenge."}],"source":"vndb","sourceCharacterId":"c43409"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44e9a478f52e66d441cbbd10cd96a6a2d80850e4410ef02f1bf25c9ff711e6b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/7838173921631d702b4150bebfcbedd7809f34a61477a8b0ff8b4800b7d5b7a2.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ありかわ 真奈","creatorId":"vndb:s5761","sourcePersonId":"vndb:s5761","canonicalEntityId":"vndb:s5761","name":"ありかわ真奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:68074","source":"vndb"}]},{"characterId":"char_vndb_c43410","characterName":"沢渡 拓斗","sourceIds":{"vndbCharacterId":"c43410"},"originalCharacterName":"沢渡 拓斗","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Takuma's older brother and Kyouka's husband."},{"spoiler":false,"text":"He is a kind and intellectual looking man and the ideal husband, for Takuma he is a reliable and ideal older brother."}],"source":"vndb","sourceCharacterId":"c43410"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/ch