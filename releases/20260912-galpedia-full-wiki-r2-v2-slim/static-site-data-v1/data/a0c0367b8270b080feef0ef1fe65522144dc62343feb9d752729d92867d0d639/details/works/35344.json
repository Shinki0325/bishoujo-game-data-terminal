s","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:133454","source":"vndb"},{"creditedName":"テルジ ヨシザワ","creatorId":"vndb:s44398","sourcePersonId":"vndb:s44398","canonicalEntityId":"vndb:s44398","name":"テルジ ヨシザワ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:133455","source":"vndb"},{"creditedName":"佐々木 久夫","creatorId":"vndb:s46514","sourcePersonId":"vndb:s46514","canonicalEntityId":"vndb:s46514","name":"佐々木 久夫","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:133457","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c70816","characterName":"望月 六実","sourceIds":{"vndbCharacterId":"c70816"},"originalCharacterName":"望月 六実","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daughter of Rokuro Mochizuki, a former member of the Sanada ninjas."},{"spoiler":false,"text":"She was trained to be a ninja by Hakuunsai Tozawa, the master of Sasuke Sarutobi, in the village of Togakushi. When Nobushige Sanada decides to enter Osaka, Hakuunsai sends her to his estate."},{"spoiler":false,"text":"From Idea Factory International"}],"source":"vndb","sourceCharacterId":"c70816"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/798bcbeac5cfacb3f756344a0850c0896835e2f0c2d4db60d255d1711a71e595.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d00bf50b3a019a13cdee87f49c1730789be0537ba3e446a4b168d67e3648920.webp","width":219,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c70817","characterName":"真田 信繁","sourceIds":{"vndbCharacterId":"c70817"},"originalCharacterName":"真田 信繁","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Second son of the Sanada family."},{"spoiler":false,"text":"Fought alongside Mitsunari Ishida at the Battle of Sekigahara. He was exiled to Mt. Kudo in Kishu with his father, Masayuki Sanada, as punishment. Masayuki, having twice repelled the Tokugawa's forces, was assassinated, leaving Nobushige by himself. He's bothered by not being considered a threat and resolves to side with the Toyotomi in their uprising."},{"spoiler":false,"text":"From Idea Factory International"}],"source":"vndb","sourceCharacterId":"c70817"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6ebb0d1c252b0fa9f1a8e742fc3b41306771cb54d80c75d01a59a12c389d91f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3b4e2b9ab2563bf8176e0f929d7805b24264cbf942fe170cbb18cde6eec9f8c.webp","width":217,"height":256,"source":"static-detail"},"actors":[{"creditedName":"諏訪部 順一","creatorId":"vndb:s66","sourcePersonId":"vndb:s66","canonicalEntityId":"vndb:s66","name":"諏訪部 順一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70764","source":"vndb"}]},{"characterId":"char_vndb_c70818","characterName":"猿飛 佐助","sourceIds":{"vndbCharacterId":"c70818"},"originalCharacterName":"猿飛 佐助","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A member of the Sanada ninjas and the youngest among the ten."},{"spoiler":false,"text":"His father, a former Koga ninja, died when Sasuke was a child. He was raised by Hakuunsai Tozawa to become a Sanada ninja. He later serves Nobushige Sanada in intelligence and protection work. He blames himself for the assassination of Masayuki. Despite being the youngest, he is the most skilled in ninja arts. True to his name, he excels at monkey-style ninja arts and is friends with a little monkey."},{"spoiler":false,"text":"From Idea Factory International"}],"source":"vndb","sourceCharacterId":"c70818"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/011de43d7f2ec68834b83caf529f228f6943eef9400f7a267089e030b584a459.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/755d05426b07ffdf23ee88b44ad0615d746ab29d5e5bf018ef89781869d640a0.webp","width":202,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杉田 智和","creatorId":"vndb:s370","sourcePersonId":"vndb:s370","canonicalEntityId":"vndb:s370","name":"杉田 智和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70769","source":"vndb"}]},{"characterId":"char_vndb_c70819","characterName":"霧隠 才蔵","sourceIds":{"vndbCharacterId":"c70819"},"originalCharacterName":"霧隠 才蔵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A member of the Sanada ninjas. Formerly an Iga ninja."},{"spoiler":false,"text":"He left the Iga clan for personal reasons and sought to make a name for himself by challenging well-known warriors. After dueling Nobushige Sanada and Sasuke Sarutobi, he joined the Sanada ninjas. He is confident in both swordsmanship and ninja arts, and often resorts to ruthless tactics to fulfill his goals. His ultimate goal is to rise as a samurai, preferring the sword to ninja tools."},{"spoiler":false,"text":"From Idea Factory International"}],"source":"vndb","sourceCharacterId":"c70819"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/cebec9aa3f685a1d31507e7f8a9e9a280a7d70a1b2f186f8d621c24983d56c6d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34c187fd6498c21c38c62af8cf00310f08ed12756dc4d18137f96a49725c91b9.webp","width":215,"height":256,"source":"static-detail"},"actors":[{"creditedName":"興津 和幸","creatorId":"vndb:s85","sourcePersonId":"vndb:s85","canonicalEntityId":"vndb:s85","name":"興津 和幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70765","source":"vndb"}]},{"characterId":"char_vndb_c70820","characterName":"筧 十蔵","sourceIds":{"vndbCharacterId":"c70820"},"originalCharacterName":"筧 十蔵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Former retainer of the Sanada clan. Attendant to Nobushige Sanada."},{"spoiler":false,"text":"Juzo originally served Nobushige as a page within the Sanada household, then followed him to Mt. Kudo even after their confinement. He later began working as a Sanada ninja, specializing in modified firearms, explosives, and gunpowder handling. Because of a debt of gratitude to the Sanada family, he always puts Nobushige first. He makes sound, rational judgments and treats women kindly."},{"spoiler":false,"text":"From Idea Factory International"}],"source":"vndb","sourceCharacterId":"c70820"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/1339a71c9c69fd95febb7818a2eb98299ce1c68fc93d22a215418ff5d05f151a.webp","fallbackUrl":"ht