:{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"弓や七海、伊織のクラスメイトでバレー部のエース級選手。"},{"spoiler":false,"text":"整った風貌や社交的な性格で女子生徒達に絶大な人気を誇るが、その裏側では喫煙や暴行などを繰り返している問題児。"},{"spoiler":false,"text":"オカ研のことを痛い連中と馬鹿にしていたが、とある事件をきっかけに、彼もまた悪魔と契約を結んでしまう。"},{"spoiler":false,"text":"彼に【啓示】を与えた魔王アイムは炎の魔王として知られており、その啓示名も『呪詛の炎熱（ブレイムスロワー）』、バレー部で鳴らしたパワーとテクニックで、全てを焼き尽くす火球を放ちまくる。"},{"spoiler":false,"text":"「俺の啓示は『呪詛の炎熱』……ムカつくやつぁ全部燃やして灰にする……最高の力だぜ」"}],"source":"egs","sourceCharacterId":"13","sourceWorkId":"15720","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0fd846a5b59ef7f14011caae1f1805d4600b6b1f668be483fcab969c2bdb6a64.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e23097ede72c8ffd714cb1d1fe08a9d4d93bbdc2fe4daec2b3a4fe75777ccf1b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"原田 友貴","creatorId":"vndb:s34","sourcePersonId":"vndb:s34","canonicalEntityId":"vndb:s34","name":"原田 友貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40588","source":"vndb"}]},{"characterId":"char_c25066","characterName":"美槻 七海","sourceIds":{"bangumi":[{"characterId":"52337","match":"exact-normalized-name-in-linked-work","subjectId":"20676"}],"egsCharacterIds":["7"],"vndbCharacterId":"c25066"},"originalCharacterName":"美槻 七海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AAA"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"70"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"review