lationId":"vndb:vn-staff:66435","source":"vndb"},{"creditedName":"All Limited Trigger","creatorId":"vndb:s13612","sourcePersonId":"vndb:s13612","canonicalEntityId":"vndb:s13612","name":"All Limited Trigger","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:66438","source":"vndb"}]},"cast":[{"characterId":"char_c33618","characterName":"天野 紗月","sourceIds":{"bangumi":[{"characterId":"44904","match":"exact-normalized-name-in-linked-work","subjectId":"15000"}],"egsCharacterIds":["838"],"vndbCharacterId":"c33618"},"originalCharacterName":"天野 紗月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"優秀な魔法使い。"},{"spoiler":false,"text":"礼儀正しく、清楚で生真面目。"},{"spoiler":false,"text":"お兄ちゃん大好き！"},{"spoiler":false,"text":"でも、しばらく離れ離れだったので、素直に甘えることができない……。"},{"spoiler":false,"text":"クールな面に不器用な愛情表現に戸惑う、ちょっぴりツンデレ少女。"},{"spoiler":false,"text":"「ルナルティアのことなら、私に何でも聞いてね！"},{"spoiler":false,"text":"兄ぃにをサポートするのが私の役目なんだから♪」"}],"source":"egs","sourceCharacterId":"838","sourceWorkId":"14879","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹で優秀な魔法使い。"},{"spoiler":false,"text":"礼儀正しく、清楚で生真面目。クールだけとちょっぴりツンデレな女の子。"},{"spoiler":false,"text":"お兄ちゃん大好きっ娘だが、しばらく離れていたせいか素直に甘えることが出来なくなっている。"},{"spoiler":false,"text":"他の女の子が主人公に近づくだけで嫉妬してしまうことも。"}],"source":"bangumi","sourceCharacterId":"44904"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a576e816376dc51f444fccf4d53011efabe6e1de6043bd63ba2fcd7ec638d88.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f80df36435dd3338d401692667bfcf0006890d9187bc4495716529430bffe0e0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15000:44904:5922:1","source":"bangumi"}]},{"characterId":"char_c33619","characterName":"エノラ・テトラピア","sourceIds":{"bangumi":[{"characterId":"44907","match":"exact-normalized-name-in-linked-work","subjectId":"15000"}],"egsCharacterIds":["840"],"vndbCharacterId":"c33619"},"originalCharacterName":"エノラ・テトラピア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"精霊使いの彼女の夢は、世界の真相を確かめること。"},{"spoiler":false,"text":"清楚な彼女の野望はとても大きい!?"},{"spoiler":false,"text":"「この世界は地球とは違って、呼び出せる精霊のチカラが異なるんです」"}],"source":"egs","sourceCharacterId":"840","sourceWorkId":"14879","spoiler":false},{"segments":[{"spoiler":false,"text":"精霊の力を行使する癒し担当のシャーマンさん。"},{"spoiler":false,"text":"月では地球と精霊の力が異なるらしく、月世界の仕組みの解明を野望に抱え、主人公たちと行動を共にするようになる。"}],"source":"bangumi","sourceCharacterId":"44907"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91b9758a68b77c01183ae195ffafbfeb39da6f1f196ff15c875723963e92e10a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0109e12af5ac2c02bda7485585900124b78af156247b59645afcf80879d8cf9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15000:44907:5020:1","source":"bangumi"}]},{"characterId":"char_c33620","characterName":"十六夜 飛鳥","sourceIds":{"bangumi":[{"characterId":"44906","match":"exact-normalized-name-in-linked-work","subjectId":"15000"}],"egsCharacterIds":["841"],"vndbCharacterId":"c33620"},"originalCharacterName":"十六夜 飛鳥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"質実剛健、こんな時代じゃなきゃ思い切り剣を振るえない！"},{"spoiler":false,"text":"過剰に、過激に、体育会系！"},{"spoiler":false,"text":"とにかく強いヤツに会いに行く！"},{"spoiler":false,"text":"「月世界には、地球にはいない不思議な生き物がいっぱい。"},{"spoiler":false,"text":"とても危険だから私みたいな剣士が必要なの」"}],"source":"egs","sourceCharacterId":"841","sourceWorkId":"14879","spoiler":false},{"segments":[{"spoiler":false,"text":"代々剣士を生業とする家系の、体育会系で好戦的なクラスメイト。"},{"spoiler":false,"text":"剣に魔力を付与する、月世界ならではの戦い方を会得している。"},{"spoiler":false,"text":"月には危険な生物も多いが、自分の能力を余すことなく発揮できると喜ぶお茶目（？）な一面も。"},{"spoiler":false,"text":"私より強いヤツに会いに行く！ とばかりに剣を振るう、質実剛健で頼りになる少女。"}],"source":"bangumi","sourceCharacterId":"44906"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/7949b219889f7663f6382c0f4c69dd09cc06144efc8e4a54fec9e9aa02a7d64a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc971957d978077212283f8857e69b9e79dfb53846d48a44eeb7626e40f785b0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井ノ上奈々","creatorId":"vndb:s1808","sourcePersonId":"vndb:s1808","canonicalEntityId":"vndb:s1808","name":"井ノ上奈々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15000:44906:4745:1","source":"bangumi"}]},{"characterId":"char_c33621","characterName":"ルナル・ラ・ラパン","sourceIds":{"bangumi":[{"characterId":"44905","match":"exact-normalized-name-in-linked-work","subjectId":"15000"}],"egsCharacterIds":["839"],"vndbCharacterId":"c33621"},"originalCharacterName":"ルナル・ラ・ラパン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"実は、ルナルティアで伝説のウサギ族の女の子。"},{"spoiler":false,"text":"天然ボケボケな性格だけどお姫様でもある。"},{"spoiler":false,"text":"ウサギ族の王の密命を受けこの学園にやってきた。"},{"spoiler":false,"text":"「月の世界にはウサギ族が住んでるうさ！"},{"spoiler":false,"text":"でもこのことは人間達には内緒うさ！」"}],"source":"egs","sourceCharacterId":"839","sourceWorkId":"14879","spoiler":false},{"segments":[{"spoiler":false,"text":"根っからの善人でお人好しな、月の世界のお姫様。"},{"spoiler":false,"text":"月世界から地球人を追い出す方法を探す使命を受けて学園に転校してきたのだが、素直さが災いしてうっかり計画の全てを喋ってしまうほどの天然さん。"}],"source":"bangumi","sourceCharacterId":"44905"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07c2e4103113a6dc69f2d3f1432b28f3925c0138732248602e66a3a0866f3081.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d947795f16ae8b954cdfb422915ab7f0df7a96d349041c3702fa198383d93d08.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新堂真弓","creatorId":"vndb:s1427","sourcePersonId":"vndb:s1427","canonicalEntityId":"vndb:s1427","name":"新堂 真弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15000:44905:6166:1","source":"bangumi"}]},{"characterId":"char_c33622","characterName":"ラヴィ・ルーナ","sourceIds":{"bangumi":[{"characterId":"44908","match":"exact-normalized-name-in-linked-work","subjectId":"15000"}],"egsCharacterIds":["842"],"vndbCharacterId":"c33622"},"originalCharacterName":"ラヴィ・ルーナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"冒険の邪魔をしてくる謎のライバルキャラとは彼女のこと。"},{"spoiler":false,"text":"クールで、ぶっきらぼうで、粗野な態度の女の子。"},{"spoiler":false,"text":"でも、実は根は良い娘。"},{"spoiler":false,"text":"彼女には、秘密の使命があるらしく他人との関わりを極力さけている節も主人公と触れ合ううちに人間の優しさを知り、使命と主人公との狭間に揺れることに。"},{"spoiler":false,"text":"「なによ？　なにか用？」"}],"source":"egs","sourceCharacterId":"842","sourceWorkId":"14879","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公たちの冒険を邪魔する、クールでぶっきらぼうな謎の少女。"},{"spoiler":false,"text":"ルナルのような耳はあるけど、冒険の邪魔をしてくるってことは……敵なの？ 味方なの？"},{"spoiler":false,"text":"ともに学園生活を過ごして主人公たちと触れ合っていくことで、彼女の心境にも変化が……？"}],"source":"bangumi","sourceCharacterId":"44908"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87726a0ce0bb4ecfb137900b87e11ab204aa9f7d0137f7edb25270e8c26edabb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b09fb310986912af6637787189a16ceef2082839e8922a524701010240053b1d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"萩原えみこ","creatorId":"vndb:s867","sourcePersonId":"vndb:s867","canonicalEntityId":"vndb:s867","name":"萩原 えみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15000:44908:4854:1","source":"bangumi"}]},{"characterId":"char_vndb_c33623","characterName":"妖精","sourceIds":{"vndbCharacterId":"c33623"},"originalCharacterName":"妖精","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd34b68b0eda5274f10e38e77753d837ff435da1001b51787332a4fc8dcfe562.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71924f7618bae8cceef3f757d580ccb297183ea18a378b969a59e475f40ca682.webp","width":213,"height":256,"source":"static-d