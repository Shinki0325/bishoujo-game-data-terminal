{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"22829","model":{"presentationWorkId":"vndb:v18666","staff":{"artwork":[{"creditedName":"会田孝信","creatorId":"vndb:s3875","sourcePersonId":"egs:creator:13911","canonicalEntityId":"vndb:s3875","name":"会田孝信","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:159221","source":"egs"},{"creditedName":"ぺこ(かにビーム)","creatorId":"vndb:s1235","sourcePersonId":"egs:creator:1886","canonicalEntityId":"vndb:s1235","name":"ぺこ(かにビーム)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:159222","source":"egs"}],"scenario":[{"creditedName":"JUN","creatorId":"egs:creator:240","sourcePersonId":"egs:creator:240","canonicalEntityId":"egs:creator:240","name":"JUN","roleCode":"scenario","roleLabel":"剧本","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:159223","source":"egs"},{"creditedName":"日吉ひより","creatorId":"vndb:s3874","sourcePersonId":"egs:creator:21047","canonicalEntityId":"vndb:s3874","name":"日吉ひより","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:159224","source":"egs"},{"creditedName":"JUN","creatorId":"vndb:s1628","sourcePersonId":"vndb:s1628","canonicalEntityId":"vndb:s1628","name":"JUN","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:126322","source":"vndb"}],"music":[],"other":[{"creditedName":"ぺこ","creatorId":"vndb:s1235","sourcePersonId":"vndb:s1235","canonicalEntityId":"vndb:s1235","name":"かにビーム","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:126320","source":"vndb"}]},"cast":[{"characterId":"char_c10001","characterName":"安曇 璃紗","sourceIds":{"bangumi":[{"characterId":"16918","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16918","match":"exact-normalized-name-in-linked-work","subjectId":"62536"},{"characterId":"16918","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["553"],"vndbCharacterId":"c10001"},"originalCharacterName":"安曇 璃紗","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class Representative of the Year 1 \"Snow\" class, and a classmate of Miya's. Has an earnest and hardworking personality. As a hard-nosed person, she often finds herself in leadership positions. She’s what you might call a high-class tsundere girl."},{"spoiler":false,"text":"While she naturally does well academically and has common sense, whenever she gets into it with Miya, she always gets outreasoned and frequently stomps her feet. Having an unusually strong sense of shame, she gets flustered and briefly digs herself into a hole when thrust into a romantic relationship."},{"spoiler":false,"text":"The half-Japanese daughter of a foreign company with a British mother. Built like a model, and the owner of enormous breasts."},{"spoiler":false,"text":"Translated from Getchu and Yurin Yurin"}],"source":"vndb","sourceCharacterId":"c10001"},{"segments":[{"spoiler":false,"text":"1年雪組のクラス委員長で、美夜とは同級生。"},{"spoiler":false,"text":"性格は生真面目で努力家。"},{"spoiler":false,"text":"押しが強く、気がつくとリーダー的立場になる事が多い。"},{"spoiler":false,"text":"いわゆるツンデレお嬢様、もちろん成績は優秀で常識人なのだが、美夜が絡むと必ず理屈で論破され、地団駄を踏むことが多い。"},{"spoiler":false,"text":"人一倍羞恥心が強く、恋愛関係で突っ込まれると、わたわたと慌て墓穴を掘る事しばし。"},{"spoiler":false,"text":"外資系企業令嬢で母親が英国人というハーフ。"},{"spoiler":false,"text":"モデル並みのプロポーションで、巨乳の持ち主。"}],"source":"egs","sourceCharacterId":"553","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"2年雪組のクラス委員長で、美夜とは同級生にして恋人。"},{"spoiler":false,"text":"性格は生真面目で努力家。"},{"spoiler":false,"text":"相変わらずサボりクセのある美夜をなんとか授業に出そうとするも、なんだかんだとへ理屈で論破された上に、可愛いキスや愛のささやきで誤魔化される事しばし。"},{"spoiler":false,"text":"実はかなりの可愛いもの好きで、少女趣味丸出しの部屋には、恋人の美夜しか入れた事がないらしい。"}],"source":"egs","sourceCharacterId":"553","sourceWorkId":"18197","spoiler":false},{"segments":[{"spoiler":false,"text":"２年雪組のクラス委員長で、美夜とは同級生にして恋人。性格は生真面目で努力家。"},{"spoiler":false,"text":"相変わらずサボりクセのある美夜をなんとか授業に出そうとするも、なんだかんだとへ理屈で論破され、地団駄を踏むことしばし。"},{"spoiler":false,"text":"実はかなりの可愛いもの好きで、少女趣味丸出しの部屋には、恋人の美夜しか入れた事がないらしい。"}],"source":"egs","sourceCharacterId":"553","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"１年雪組のクラス委員長で、美夜とは同級生。性格は生真面目で努力家。押しが強く、気がつくとリーダー的立場になる事が多い。"},{"spoiler":false,"text":"いわゆるツンデレお嬢様、もちろん成績は優秀で常識人なのだが、美夜が絡むと必ず理屈で論破され、地団駄を踏むことが多い"},{"spoiler":false,"text":"人一倍羞恥心が強く、恋愛関係で突っ込まれると、わたわたと慌て墓穴を掘る事しばし。"},{"spoiler":false,"text":"外資系企業令嬢で母親が英国人というハーフ。モデル並みのプロポーションで、巨乳の持ち主。"},{"spoiler":false,"text":"声：黒井音瑚 (bgm.tv查不到…)"}],"source":"bangumi","sourceCharacterId":"16918"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13ff9e850d66c7589580e8235cab018c100af7532872fb248cc0409fa083aeea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfa51e4058e46202569796bf8540b29f3a79d1c6ca93918c7069a5d87cb8685a.webp","width":89,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米山有佳子","creatorId":"vndb:s3866","sourcePersonId":"vndb:s3866","canonicalEntityId":"vndb:s3866","name":"米山 有佳子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:156664:16918:19139:1","source":"bangumi"}]},{"characterId":"char_c10002","characterName":"綾瀬 美夜","sourceIds":{"bangumi":[{"characterId":"16919","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16919","match":"exact-normalized-name-in-linked-work","subjectId":"62536"},{"characterId":"16919","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["554"],"vndbCharacterId":"c10002"},"originalCharacterName":"綾瀬 美夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student of the Year 1 \"Snow\" class, and a classmate of Risa's. A prominent genius on campus, but has difficulty in social situations. Doesn’t really take issue with people other than Risa, and socializes as little as possible."},{"spoiler":false,"text":"Whenever she speaks with Risa it's always abusive, but she's actually covering her own embarrassment. Her speech and behavior always keep others at a distance. She rarely shows her soft side and is unflappable. When she does show her soft side, she becomes timid and casts nervous glances from beneath her lashes."},{"spoiler":false,"text":"Although you wouldn’t guess it from the way she talks, her behavior is actually quite ladylike. Possessing one of the most prominent intellects on campus, she has been offered the chance to study abroad and even skip grades, but she hates interacting with others, so she enrolled in the not particularly academically demanding school for high-class girls, St. Michael's."},{"spoiler":false,"text":"Translated from Getchu and Yurin Yurin"}],"source":"vndb","sourceCharacterId":"c10002"},{"segments":[{"spoiler":false,"text":"1年雪組の学生で璃紗のクラスメイト。"},{"spoiler":false,"text":"校内一の才女だが人付き合いが苦手で、璃紗以外の人物とは無難＆最小限の付き合い。"},{"spoiler":false,"text":"璃紗と口を利けば罵詈雑言ばかりだが、実は照れ隠し。"},{"spoiler":false,"text":"他の者とは常に距離を置いた口調と態度。"},{"spoiler":false,"text":"滅多にデレない＆動揺しない。デレる場合は気弱になって上目使いでソワソワ。"},{"spoiler":false,"text":"口調からそうは見えないが、実はかなり女らしい立ち振る舞い。"},{"spoiler":false,"text":"校内一の頭脳の持ち主で、海外留学や飛び級の打診もあったのだが、人付き合いを嫌い、さほど学力的には高くないお嬢様学校のミカ女に入学。"}],"source":"egs","sourceCharacterId":"554","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"璃紗の恋人で２年雪組の同級生。"},{"spoiler":false,"text":"校内一の才女で、相変わらず人付き合いが苦手だったがベストカップルのメンバーとはそれなりに交流を持ち始めて来た様子。"},{"spoiler":false,"text":"「受ける意味がない」と相変わらず授業をサボりまくり、旧美術部のアトリエを私物化して隠れ家状態に。"},{"spoiler":false,"text":"実はかなりの大食いで、さらに璃紗の私物をこっそりと着服してはコレクションしている模様。"}],"source":"egs","sourceCharacterId":"554","sourceWorkId":"18197","spoiler":false},{"segments":[{"spoiler":false,"text":"璃紗の恋人で２年雪組の同級生。校内一の才女で、相変わらず人付き合いが苦手だったがベストカップルのメンバーとはそれなりに交流を持ち始めて来た様子。"},{"spoiler":false,"text":"「受ける意味がない」と相変わらず授業をサボりまくり、旧美術部のアトリエを私物化して隠れ家状態に。"},{"spoiler":false,"text":"実はかなりの大食いで、さらに璃紗の私物をこっそりと着服してはコレクションしている模様。"}],"source":"egs","sourceCharacterId":"554","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"１年雪組の学生で璃紗のクラスメイト。校内一の才女だが人付き合いが苦手で、璃紗以外の人物とは無難＆最小限の付き合い。"},{"spoiler":false,"text":"璃紗と口を利けば罵詈雑言ばかりだが、実は照れ隠し。他の者とは常に距離を置いた口調と態度。"},{"spoiler":false,"text":"滅多にデレない＆動揺しない。デレる場合は気弱になって上目使いでソワソワ。"},{"spoiler":false,"text":"口調からそうは見えないが、実はかなり女らしい立ち振る舞い。"},{"spoiler":false,"text":"校内一の頭脳の持ち主で、海外留学や飛び級の打診もあったのだが、人付き合いを嫌い、さほど学力的には高くないお嬢様学校のミカ女に入学。"},{"spoiler":false,"text":"声：秋本ねりね (中村桜)"}],"source":"bangumi","sourceCharacterId":"16919"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/dad290b2fd2b15b14ef53025180c88e4373be10555e3cf650bc1903a8f47fb89.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44810265e598a12f38536181f35833984452aee80a2312f8ed98226616a72823.webp","width":89,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村桜","creatorId":"vndb:s3644","sourcePersonId":"vndb:s3644","canonicalEntityId":"vndb:s3644","name":"中村 桜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:156664:16919:16171:1","source":"bangumi"}]},{"characterId":"char_c13131","characterName":"石神 皐","sourceIds":{"bangumi":[{"characterId":"29634","match":"exact-normalized-name-in-linked-work","subjectId":"79483"}],"egsCharacterIds":["1524"],"vndbCharacterId":"c13131"},"originalCharacterName":"石神 皐","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A brilliant, but frank and aloof girl with boyish tendencies."},{"spoiler":false,"text":"What you would call an aloof mystery. Up front and self-assured. She always speaks in a masculine way."},{"spoiler":false,"text":"Although she’s never had much interest in eating, Yuuno has been using her home cooking to draw her out more, so that she’ll be straightforward with her expressions of affection, regardless of their surroundings."},{"spoiler":false,"text":"Translated from Yurin Yurin"}],"source":"vndb","sourceCharacterId":"c13131"},{"segments":[{"spoiler":false,"text":"天才だけど素直でクールなボクっ娘"},{"spoiler":false,"text":"いわゆる素直クールな物怖じしない不思議ちゃん。一人称は「ボク」で、常に少年の様な口調で話す。"},{"spoiler":false,"text":"空気を読まない発言や、ずけずけと物を言う性格が、他のクラスメイトとは、一定の距離を開けてしまいがちに。"},{"spoiler":false,"text":"食べることに興味はなかったが、同室の優乃の手作り料理に餌付けされてしまい、それ以降、周囲の視線もなんのそので、ストレートに愛情表現してくる様に。"}],"source":"egs","sourceCharacterId":"1524","sourceWorkId":"19269","spoiler":false},{"segments":[{"spoiler":false,"text":"天才だけど"},{"spoiler":false,"text":"素直でクールなボクっ娘"},{"spoiler":false,"text":"いわゆる素直クールな物怖じしない不思議ちゃん。一人称は「ボク」で、常に少年のような口調で話す。"},{"spoiler":false,"text":"食べることに興味はなかったが、同室の優乃の手作り料理に餌付けされてしまい、それ以降、周囲の視線もなんのそので、ストレートに愛情表現してくるように。"}],"source":"bangumi","sourceCharacterId":"29634"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d4e76e246d22dc7a1c3faf85695a5c8d929584bdf5ba618e66f87d097e95301.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/adbfb7612afc38bc0fd7bfad396bfc7aea504226386ac998a49ad5aa556ce9ee.webp","width":64,"height":256,"source":"static-detail"},"actors":[{"creditedName":"設楽麻美","creatorId":"vndb:s869","sourcePersonId":"vndb:s869","canonicalEntityId":"vndb:s869","name":"設楽 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:156664:29634:7904:1","source":"bangumi"}]},{"characterId":"char_c13132","characterName":"篠崎 六夏","sourceIds":{"bangumi":[{"characterId":"22643","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["1979"],"vndbCharacterId":"c13132"},"originalCharacterName":"篠崎 六夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year student who was accepted into the escalator school of St. Michael's through taking outside entrance exams."},{"spoiler":false,"text":"Shortly after enrolling, she set a new national record in the 100 meter dash and became an instant celebrity on campus."},{"spoiler":false,"text":"She has a kind disposition, and has to intervene when she sees someone in trouble. Because of that tendency, she's earned the nickname, \"Sir Knight\" (騎士様)."},{"spoiler":false,"text":"She serves as vice-representative of her class, and was chosen along with class representative Sayuki as one of the academy’s Best Couples."},{"spoiler":false,"text":"Translated from post with info from Dengeki Hime"}],"source":"vndb","sourceCharacterId":"c13132"},{"segments":[{"spoiler":false,"text":"聖ミカエル女子学園に外部入学してきた１年生。入学早々、全国レベルの１００ｍ記録を出してしまい、一躍有名人になってしまったスポーツ少女。それでいて困っている人を放っておけない性格で、すっかり人気者に。"},{"spoiler":false,"text":"クラス副委員長であり、委員長である沙雪と共にベストカップルに選出され、その頼りになる人柄から「白雪の騎士」と呼ばれている模様。どうやら璃紗とはなにか関係がある様だが……？"}],"source":"egs","sourceCharacterId":"1979","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"聖ミカエル女子学園に外部入学してきた１年生。入学早々、全国レベルの１００ｍ記録を出してしまい、"},{"spoiler":false,"text":"一躍有名人になってしまったスポーツ少女。それでいて困っている人を放っておけない性格で、すっかり人気者に。"},{"spoiler":false,"text":"クラス副委員長であり、委員長である沙雪と共にベストカップルに選出され、その頼りになる人柄から"},{"spoiler":false,"text":"「白雪の騎士」と呼ばれている模様。どうやら璃紗とはなにか関係がある様だが……？"},{"spoiler":false,"text":"声：緑川円 (bgm.tv查不到…)"}],"source":"bangumi","sourceCharacterId":"22643"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2eda9957b96d3488a21ca3180447bdfd4eaa6f4516abcabe4d1830fbebf53e17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/7792917f5d64d4bd316b654f159565671324b1b527b81b126ec576f9b88462e4.webp","width":87,"height":256,"source":"static-detail"},"actors":[{"creditedName":"緑川 円","creatorId":"vndb:s3867","sourcePersonId":"vndb:s3867","canonicalEntityId":"vndb:s3867","name":"緑川 円","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67420","source":"vndb"}]},{"characterId":"char_c13133","characterName":"白河 沙雪","sourceIds":{"bangumi":[{"characterId":"22644","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["1980"],"vndbCharacterId":"c13133"},"originalCharacterName":"白河 沙雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A classmate of Rikka's. Serving as class representative, she lives with her grandfather, who is apparently descended from samurai who once defended a castle."},{"spoiler":false,"text":"Her name combined with her noble lineage has earned her the nickname \"Snow White\" (白雪姫)."},{"spoiler":false,"text":"Additionally, being both beautiful and brilliant, a scholar and an athlete, she’s been touted by many as the second coming of \"The Perfect Lady\"."},{"spoiler":false,"text":"In no time at all after her enrollment, these abilities result in her being entrusted with the role of Chairman of the Environmental Improvement Committee, which is essentially the academy's student council."},{"spoiler":false,"text":"Translated from post with info from Dengeki Hime"}],"source":"vndb","sourceCharacterId":"c13133"},{"segments":[{"spoiler":false,"text":"六夏の同級生でクラスメイト。才色兼備、文武両道にして環境整備委員会に選出された才媛。"},{"spoiler":false,"text":"中等部時代からその名声は轟き、ＯＧである蓬莱泉麗奈以来の「究極の淑女」との呼び声も高い。"},{"spoiler":false,"text":"実家は祖父が城を所有しているとの噂もある武家の末裔で、その名前から「白雪姫」とあだ名されている。"},{"spoiler":false,"text":"六夏と璃紗のスキャンダル（？）を切っ掛けに、さらに渦中の人になってしまい……？"}],"source":"egs","sourceCharacterId":"1980","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"六夏の同級生でクラスメイト。才色兼備、文武両道にして環境整備委員会に選出された才媛。"},{"spoiler":false,"text":"中等部時代からその名声は轟き、ＯＧである蓬莱泉麗奈以来の「究極の淑女」との呼び声も高い。"},{"spoiler":false,"text":"実家は祖父が城を所有しているとの噂もある武家の末裔で、その名前から「白雪姫」とあだ名されている。"},{"spoiler":false,"text":"六夏と璃紗のスキャンダル（？）を切っ掛けに、さらに渦中の人になってしまい……？"},{"spoiler":false,"text":"声：咲智ゆん (bgm.tv查不到…)"}],"source":"bangumi","sourceCharacterId":"22644"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34dc7ff725377a372e61d10a8ee5c46e06fd17eafd3437bf0f2a5fbffd7ae1d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a076030fd7de5d68da69c11b192cf686b6c770e26a4583c3be617bd9f7cde1bb.webp","width":89,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤あずさ","creatorId":"vndb:s3868","sourcePersonId":"vndb:s3868","canonicalEntityId":"vndb:s3868","name":"佐藤 あずさ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:156664:22644:16088:1","source":"bangumi"}]},{"characterId":"char_c5858","characterName":"沢口 麻衣","sourceIds":{"bangumi":[{"characterId":"16343","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16343","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["559"],"vndbCharacterId":"c5858"},"originalCharacterName":"沢口 麻衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"918"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A very responsible second year high school student who has some tomboy tendencies. She falls in love with Reo after getting to know a different side of her."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c5858"},{"segments":[{"spoiler":false,"text":"2年生で、幼稚舎からミカ女に通っている生粋のミカ女育ちだが、両親はフツーの共働き夫婦。"},{"spoiler":false,"text":"特にクラス委員というわけではないものの、面倒見のいい姉御的性格のせいか、頼りにされる事が多い模様。"},{"spoiler":false,"text":"当人的には「自分は庶民」と自覚。"},{"spoiler":false,"text":"ミカ女暮らしが長いので、天然お嬢様達の扱いは手慣れている。"},{"spoiler":false,"text":"そんな物怖じしない性格と行動的なところが人気で、下級生や上級生からラブレターをもらうことも珍しくない。"}],"source":"egs","sourceCharacterId":"559","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"３年生で、幼稚舎からミカ女に通っている生粋のミカ女育ちだが、両親はフツーの共働き夫婦。"},{"spoiler":false,"text":"特にクラス委員というわけではないものの、面倒見のいい姉御的性格のせいか、頼りにされる事が多い模様。"},{"spoiler":false,"text":"そんな物怖じしない性格と行動的なところが人気で、下級生や上級生からラブレターをもらうことも珍しくない。"},{"spoiler":false,"text":"クラスメイトの玲緒とは恋人同士で、現在は玲緒の部屋にほぼ毎日通っている、いわゆる通い妻状態。"}],"source":"egs","sourceCharacterId":"559","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"二年级学生，学习成绩和运动神经都相当不错，也擅长做家务，不是学生委员却非常有号召力，成为被大家像大姐姐一样依靠的人气焦点，连身为会长的松原优菜也很重视她，但她总是以生活在普通家庭中的“庶民”自嘲。因为帮助难以适应班级生活的玲绪而与她日渐亲密。"}],"source":"bangumi","sourceCharacterId":"16343"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36a115cb6928b81254e5e0f9fe3d62942c928937e54307e0a1f3d4c05184559c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98c508a246ceb26b4e4091f8d731c6e973717574f3bdb7ac2eb0cef40dc83f77.webp","width":87,"height":256,"source":"static-detail"},"actors":[{"creditedName":"峯香織","creatorId":"vndb:s20187","sourcePersonId":"vndb:s20187","canonicalEntityId":"vndb:s20187","name":"峯香織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:156664:16343:5481:1","source":"bangumi"},{"creditedName":"和泉 あやか","creatorId":"vndb:s493","sourcePersonId":"vndb:s493","canonicalEntityId":"vndb:s493","name":"和泉あやか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67415","source":"vndb"}]},{"characterId":"char_c5860","characterName":"川村 玲緒","sourceIds":{"bangumi":[{"characterId":"16344","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16344","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["560"],"vndbCharacterId":"c5860"},"originalCharacterName":"川村 玲緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"322"},"bust":{"reviewState":"source-only","source":"vndb","value":"69"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A short second year high school student. She is antisocial, a tsundere and in love with Mai."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c5860"},{"segments":[{"spoiler":false,"text":"2年生で麻衣の同級生。母方は財閥系の裕福な家庭で、いわゆる箱入りのお嬢様。"},{"spoiler":false,"text":"だが玲緒自身は社交性が薄く、人見知りの激しい性格。"},{"spoiler":false,"text":"背は低めでかなりのちびっ子という幼児体型だが、ふわふわのロングの髪と整った顔立ちのせいで、可愛らしいと人気が高い。"},{"spoiler":false,"text":"が、麻衣以外にはまったく懐かない、ある意味猛獣の様な超ツンデレ少女。"},{"spoiler":false,"text":"両親は海外で暮らしており、一人マンション暮らし。"},{"spoiler":false,"text":"ただし家事は一切出来ず、放っておくとジャンクフードばかりの生活。"},{"spoiler":false,"text":"故に麻衣としては通い妻をする事に。"}],"source":"egs","sourceCharacterId":"560","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"３年生で麻衣の同級生にして恋人。いわゆる箱入りのお嬢様だが、社交性が薄く、人見知りの激しい性格。"},{"spoiler":false,"text":"背は低めで幼児体型だが、ふわふわのロングの髪と整った顔立ちのせいで、可愛らしいと人気が高い。"},{"spoiler":false,"text":"麻衣以外にはまったく懐かない、ある意味猛獣の様な超ツンデレ少女だったが、現在では気を許す友人もチラホラ。"},{"spoiler":false,"text":"両親は海外で暮らしており、一人マンション暮らし。通い妻状態の麻衣とはケンカしつつもラブラブな毎日。"}],"source":"egs","sourceCharacterId":"560","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"二年级学生，因为母亲离婚而转校。身材矮小，面貌也很像小学生。家境优越并且备受溺爱，性格傲娇并且叛逆，做事冒失，因此与同学关系不佳而被孤立。自称接受过知名声乐教师的指导，因此很擅长唱歌。在受到麻衣的帮助后变得越来越在意她。"}],"source":"bangumi","sourceCharacterId":"16344"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f0492c0b507bf30030a404fcf48d95ed3bb644172dd50e50ab3f07aca43a7ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/3410d9fcbed186acc9acd2d63e9ce7fc5f4310597c0980992c61be3c3f73b635.webp","width":91,"height":256,"source":"static-detail"},"actors":[{"creditedName":"設楽麻美","creatorId":"vndb:s869","sourcePersonId":"vndb:s869","canonicalEntityId":"vndb:s869","name":"設楽 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:156664:16344:7904:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p437","sourceCompanyId":"egs:brand:1942","canonicalEntityId":"vndb:p437","name":"ふぐり屋","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:22829:1942","source":"egs"},{"companyId":"vndb:p17113","sourceCompanyId":"vndb:p17113","canonicalEntityId":"vndb:p17113","name":"St Michael's lobby","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:113962:v18666","source":"vndb