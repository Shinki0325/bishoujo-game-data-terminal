{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"17618","model":{"presentationWorkId":"vndb:v11171","staff":{"artwork":[{"creditedName":"くらすけ","creatorId":"vndb:s7023","sourcePersonId":"egs:creator:13698","canonicalEntityId":"vndb:s7023","name":"くらすけ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:109593","source":"egs"}],"scenario":[{"creditedName":"almi3104","creatorId":"vndb:s11016","sourcePersonId":"egs:creator:16609","canonicalEntityId":"vndb:s11016","name":"almi3104","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:109592","source":"egs"}],"music":[],"other":[{"creditedName":"遊月 ことな","creatorId":"vndb:s5692","sourcePersonId":"vndb:s5692","canonicalEntityId":"vndb:s5692","name":"遊月 ことな","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:92450","source":"vndb"}]},"cast":[{"characterId":"char_c33394","characterName":"アーシュ・ザラシュートラ","sourceIds":{"bangumi":[{"characterId":"219031","match":"exact-normalized-name-in-linked-work","subjectId":"56452"}],"egsCharacterIds":["5158"],"vndbCharacterId":"c33394"},"originalCharacterName":"アーシュ・ザラシュートラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【武器(つるぺたボディ)の使い方を知らないサキュバス】"},{"spoiler":false,"text":"男の精を糧として生きる淫魔。"},{"spoiler":false,"text":"しかし、まだ一度も直接男から精をもらったことがない落ちこぼれ。"},{"spoiler":false,"text":"ツルペタという極上の【体】を持っているが、それを活かす【技】とツルペタを美しいと思う【心】を持っていない。"},{"spoiler":false,"text":"未だ男を知らないため、基本は無邪気な性格であるが、男を誘惑するために色々な資料などから情報を得たせいで、口調はちょっと尊大かつ傲慢気味。"},{"spoiler":false,"text":"淫魔であるためエッチなことには興味津々で、一日も早く男とエッチすることを夢見て一人Ｈにふけっている。"},{"spoiler":false,"text":"「さあ、わらわのとっておきの誘惑を前に、欲望の詰まった肉棒をさらけ出すといい！」"}],"source":"egs","sourceCharacterId":"5158","sourceWorkId":"17618","spoiler":false},{"segments":[{"spoiler":false,"text":"男の精を糧として3万年以上を生きるサキュバス――"},{"spoiler":false,"text":"なのだが、未だに男から直接精をもらったことがない落ちこぼれ。"},{"spoiler":false,"text":"周りのボン・キュッ・ボンなサキュバスの誘惑法を真似るものの、如何せん持って生まれたツルペタボディではその技術を活かせていない。"},{"spoiler":false,"text":"長く生きているため表面上はちょっと尊大かつ傲慢気味だが、根は素直で騙されやすい性格。"}],"source":"bangumi","sourceCharacterId":"219031"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/068d7aac88c77f6ee90f970b8355e36c8edb04d21ed1e4dadc2000ece118c050.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a5f017223a9ad79de9d5243ddcfd14b55f8cabb42f0b24304698adf27fe06d0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日アン(春乃うらら)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:56452:219031:6480:1","source":"bangumi"}]},{"characterId":"char_vndb_c112955","characterName":"外山 原紀","sourceIds":{"vndbCharacterId":"c112955"},"originalCharacterName":"外山 原紀","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p384","sourceCompanyId":"egs:brand:1869","canonicalEntityId":"vndb:p384","name":"HEAT-SOFT","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:17618:1869","source":"egs"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonicalEntityId":"vndb:p384","name":"ヒートソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release