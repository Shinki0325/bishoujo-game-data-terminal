{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"20578","model":{"presentationWorkId":"vndb:v17241","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c70898","characterName":"真樹 あずさ","sourceIds":{"bangumi":[{"characterId":"219093","match":"exact-normalized-name-in-linked-work","subjectId":"217796"}],"egsCharacterIds":["18291"],"vndbCharacterId":"c70898"},"originalCharacterName":"真樹 あずさ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"トラウマ：「？」"},{"spoiler":false,"text":"主人公の夢に現れる謎の少女。"},{"spoiler":false,"text":"舞台となる学園に通う学生ではあるが、主人公が受け持つクラスの教え子ではなく、ほとんど接点がない。"}],"source":"egs","sourceCharacterId":"18291","sourceWorkId":"8713","spoiler":false},{"segments":[{"spoiler":false,"text":"若菜の親友。"},{"spoiler":false,"text":"若菜よりも先にセミナーに通っていた彼女は、主人公に若菜を洗脳するための道具にされる。"},{"spoiler":false,"text":"主人公に洗脳された彼女は、主人公に絶対服従状態。"},{"spoiler":false,"text":"若菜のためだと思い込まされ、若菜の洗脳に協力させられる。"}],"source":"egs","sourceCharacterId":"18291","sourceWorkId":"10769","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が商店街で出会った、同じセリフを延々と繰り返す"},{"spoiler":false,"text":"正体不明の謎の少女。"},{"spoiler":false,"text":"性格は明るくて元気だが、気が強くて主人公のいうことを"},{"spoiler":false,"text":"聞かず、勝手な行動を取ることもある。"},{"spoiler":false,"text":"意思の疎通が出来ないため、はっきりとはわからないが、"},{"spoiler":false,"text":"記憶が混乱しているようで、自分が誰かもわからないらしい。"},{"spoiler":false,"text":"そのため、成り行きで主人公の部屋へ転がり込んでしまった。"},{"spoiler":false,"text":"性的快感を覚えると、何故かその間は普通に会話できるように"},{"spoiler":false,"text":"なるが、気持ちが良すぎてしまうと、今度は逆に喘いでしまって"},{"spoiler":false,"text":"会話できなくなってしまう。"}],"source":"egs","sourceCharacterId":"18291","sourceWorkId":"20578","spoiler":false},{"segments":[{"spoiler":false,"text":"隣のクラスの学生。"},{"spoiler":false,"text":"受け持ちの教師が急病になり、主人公が代わりに授業を行った。"},{"spoiler":false,"text":"ところがその翌日から、学園に登校しないようになり、引きこもるようになった。"}],"source":"bangumi","sourceCharacterId":"219093"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0e9cfa5715899ac80db43e2f7555526c8df515b70e21918a68c906ad4a5406d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/272b9ffdc1ac2e1dc5b7fd2d9d094e2032140043fbe298c232a9a74264f08593.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神崎 ちひろ","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:63875","source":"vndb"}]},{"characterId":"char_vndb_c111814","characterName":"山岸 圭太","sourceIds":{"vndbCharacterId":"c111814"},"originalCharacterName":"山岸 圭太","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:4251","sourceCompanyId":"egs:brand:4251","canonicalEntityId":"egs:brand:4251","name":"roroE","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:20578:4251","source":"egs"},{"companyId":"vndb:p826","sourceCompanyId":"vndb:p826","canonicalEntityId":"vndb:p826","name":"Eroro","roleCodes":["devel