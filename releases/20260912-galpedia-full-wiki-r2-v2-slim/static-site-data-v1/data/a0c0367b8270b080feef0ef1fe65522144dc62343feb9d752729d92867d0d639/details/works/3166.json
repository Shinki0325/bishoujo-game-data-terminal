5484","match":"exact-normalized-name-in-linked-work","subjectId":"11418"}],"egsCharacterIds":["2460"],"vndbCharacterId":"c35260"},"originalCharacterName":"クリステル＝Ｖ＝マリー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"彼方の血を吸いにきたらしい吸血鬼。"},{"spoiler":false,"text":"10代後半の外見をしてはいるが、見た目より遥かに長く生きているようだ。"},{"spoiler":false,"text":"金髪碧眼。髪の毛はストレートで腰まで届く長さ。"},{"spoiler":false,"text":"体格は既にきっちりと成長しきっていて、出る所は出る、引っ込む所は引っ込んでいる。"},{"spoiler":false,"text":"性格は情熱的。というか高飛車。"},{"spoiler":false,"text":"振る舞いは非常に雅で、礼儀正しく、古臭いが正確な日本語を使う。"}],"source":"egs","sourceCharacterId":"2460","sourceWorkId":"3166","spoiler":false},{"segments":[{"spoiler":false,"text":"彼方の血を吸いにきたらしい吸血鬼。"},{"spoiler":false,"text":"しかし彼方の血が身体に合わなかったのか、倒れて彼方に逆に介抱される羽目になる。見た目より遙かに長く生きている。性格は情熱的。というか高飛車。だが、それはフリであり、本当は非常に繊細で寂しがり屋。生きる為に強気の仮面を被った。振る舞いは非常に雅で、礼儀正しく、古臭いが正確な日本語を使う。吸血鬼の例に漏れず血を吸った相手と契約を交わして吸血鬼にすることもできるらしいが、今のところ彼方とそれをする気はないらしい。"}],"source":"bangumi","sourceCharacterId":"45484"}],"profileFacts":[{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"2460","sourceWorkId":"3166","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/740fa36fef39116e4adc6e1b3b32a638c07ee54648248475f63d995880f02db9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20d015bce9a50a95d0dcc93ac77cf10fae72b87a9e7579f0efdd0702e691383d.webp","width":250,"height":250,"source":"static-detail"},"actors":[{"creditedName":"松久保いほ","creatorId":"vndb:s8744","sourcePersonId":"vndb:s8744","canonicalEntityId":"vndb:s8744","name":"松久保 いほ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11418:45484:4889:1","source":"bangumi"},{"creditedName":"春瀬 みき","creatorId":"vndb:s1566","sourcePersonId":"vndb:s1566","canonicalEntityId":"vndb:s1566","name":"春瀬 みき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5612","source":"vndb"}]},{"characterId":"char_c35261","characterName":"佐倉 佳苗","sourceIds":{"bangumi":[{"characterId":"45485","match":"exact-normalized-name-in-linked-work","subjectId":"11418"}],"egsCharacterIds":["2461"],"vndbCharacterId":"c35261"},"originalCharacterName":"佐倉 佳苗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"315"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"O"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"彼方の幼なじみ。"},{"spoiler":false,"text":"性格は温厚で、内に抱え込み悩むタイプ。"},{"spoiler":false,"text":"小学校の高学年からの付き合いで、母親の死をきっかけに閉塞していた彼方の人間関係が、佳苗の長期に渡る献身（？）で復活したという過去がある。"},{"spoiler":false,"text":"このため彼方は佳苗のことをとても大切に考えており、佳苗もまた彼方のことを大切に考えている。"}],"source":"egs","sourceCharacterId":"2461","sourceWorkId":"3166","spoiler":false},{"segments":[{"spoiler":false,"text":"彼方の幼なじみ。"},{"spoiler":false,"text":"小学校の高学年からの付き合いで、母親の死をきっかけに閉塞していた彼方の人間関係が、佳苗の長期に渡る献身（？）で復活したという過去がある。このため彼方は佳苗のことをとても大切に考えており、佳苗もまた彼方のことを大切に考えている。性格は温厚で、内に抱え込み悩むタイプ。彼方に生じた問題については知らされておらず、蚊帳の外にいる。"}],"source":"bangumi","sourceCharacterId":"45485"}],"profileFacts":[{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"2461","sourceWorkId":"3166","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/205b91fc175b1eaef09365c444819e06156b999a46bc03fd094eaacdafa0db91.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71e713d150071744795464960d1f434f78a0ad1bc990614be4685200499c5562.webp","width":250,"height":250,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11418:45485:4956:1","source":"bangumi"}]},{"characterId":"char_c35262","characterName":"九重 二十重","sourceIds":{"bangumi":[{"characterId":"12564","match":"exact-normalized-name-in-linked-work","subjectId":"11418"}],"egsCharacterIds":["2462"],"vndbCharacterId":"c35262"},"originalCharacterName":"九重 二十重","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"クリスを追ってきた退魔士。"},{"spoiler":false,"text":"いつも射るような視線をしており、冷静でほとんど笑わない。"},{"spoiler":false,"text":"自らの生業のため、日常的な幸せを望むべくもない。"}],"source":"egs","sourceCharacterId":"2462","sourceWorkId":"3166","spoiler":false},{"segments":[{"spoiler":false,"text":"クリスを追っている人外の者達を「狩る」役目を負っている人物。転校生として彼方たちのクラスにやってくる。クリスに対しては「餌」という認識しか持っておらず、互いに利害の一致する部分はあるが歩み寄る様子は一切ない。"}],"source":"bangumi","sourceCharacterId":"12564"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a28881bd711da3e7fceee2dbeaf1bfe0c729376120ecb616e4c0aee322a6360d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eae2c25525ecdcb0cfbbc4a582ff3760b0236557431d90a7fc00b19099d1b5a0.webp","width":141,"height":129,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11418:12564:4832:1","source":"bangumi"}]},{"characterId":"char_c35263","characterName":"鹿島 いずみ","sourceIds":{"bangumi":[{"characterId":"45486","match":"exact-normalized-name-in-linked-work","subjectId":"11418"}],"egsCharacterIds":["2463"],"vndbCharacterId":"c35263"},"originalCharacterName":"鹿島 いずみ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"707"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いつも笑顔が絶えない、優の担当看護婦。"},{"spoiler":false,"text":"彼方とも親しく、彼とは化学療法科の窓口でいつも遊んでいる。"},{"spoiler":false,"text":"「人の死」と直面する職場で心がひび割れていたが、彼方が放った一言をきっかけに、彼女は自分の救いを見つける。"}],"source":"egs","sourceCharacterId":"2463","sourceWorkId":"3166","spoiler":false},{"segments":[{"spoiler":false,"text":"癌患者の優の担当看護婦。"},{"spoiler":false,"text":"彼方とも親しく、彼とは化学療法科の窓口でいつも遊んでいる。「いずみちゃん」と呼ばないと怒り、年齢を聞くとすごく怒る。いつも笑顔が絶えないが、実の所それは表面だけ。「人の死」と直面する職場ではひび割れた心を表に出すわけにはいかないと考えている。長めの髪を後頭部でまとめており、お団子というとちょっと拗ねる。"}],"source":"bangumi","sourceCharacterId":"45486"}],"profileFacts":[{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"2463","sourceWorkId":"3166","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24ebe866e5b6ed79210a1335565ec29351584c0d947b087c9c988ed924f1cc88.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6cc4c6ca3de2286b5aea5abbfd63bd2799cfe8121b584261aab52dbaeb38bc8.webp","width":250,"height":250,"source":"static-detail"},"actors":[{"creditedName":"MARIO","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11418:45486:4918:1","source":"bangumi"}]},{"characterId":"char_c35264","characterName":"朝倉 優","sourceIds":{"bangumi":[{"characterId":"45487","match":"exact-normalized-name-in-linked-work","subjectId":"11418"}],"egsCharacterIds":["2464"],"vndbCharacterId":"c35264"},"originalCharacterName":"朝倉 優","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"428"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"AB"},"height":{"reviewState":"no-conflict","source":"vndb","value":"130"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"彼方が病院で知り合った少女。"},{"spoiler":false,"text":"長期に渡り入院していたため、他人との交流を徹底的に嫌い、心を閉ざしている。"},{"spoiler":false,"text":"しかし、彼女の例外になりえた彼方だけにはゆっくりと心を開き始める。"}],"source":"egs","sourceCharacterId":"2464","sourceWorkId":"3166","spoiler":false},{"segments":[{"spoiler":false,"text":"彼方の抱えた『問題』が原因で知り合った少女。"},{"spoiler":false,"text":"癌センターに入院している。長期に渡る薬物治療の結果極端に成長が遅れており、身長が低く、体格も非常に細い。ふわふわの長い髪と、覗うようなまるい瞳が印象的。誰も悲しませないですむように他人との交流を徹底的に嫌い、心を閉ざしている。しかし、抱えた『問題』ゆえに彼女の例外になりえた彼方だけにはゆっくりと心を開き始める。癌患者だが、臓器移植による治癒の可能性は残っている。彼方とはよくチェスをするのだが、今のところ１６勝１５敗３分で優が勝ち越している。"}],"source":"bangumi","sourceCharacterId":"45487"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fa4861deac3cd5765913d74a07d1c218aef47b1f1f47e53be41f87a21b4acaa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8ec9bdd39585fb3c84324d40481d7516c55fb47e7b92c3814f