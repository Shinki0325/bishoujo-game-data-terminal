","sourcePersonId":"vndb:s3983","canonicalEntityId":"vndb:s3983","name":"秋月 つかさ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:73722","source":"vndb"},{"creditedName":"sleepwalker","creatorId":"vndb:s3998","sourcePersonId":"vndb:s3998","canonicalEntityId":"vndb:s3998","name":"sleepwalker","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:73730","source":"vndb"}]},"cast":[{"characterId":"char_c26806","characterName":"春野 つばめ","sourceIds":{"bangumi":[{"characterId":"24454","match":"exact-normalized-name-in-linked-work","subjectId":"22431"}],"egsCharacterIds":["9770"],"vndbCharacterId":"c26806"},"originalCharacterName":"春野 つばめ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"407"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's childhood friend."},{"spoiler":true,"text":"Tsubame is later depressed because they failed to shoot down the meteor and now all hope is lost."}],"source":"vndb","sourceCharacterId":"c26806"},{"segments":[{"spoiler":false,"text":"明るく元気で、男子でも友達のように付き合える、主人公の幼馴染。"},{"spoiler":false,"text":"移動スーパー「黒沢屋」でアルバイトをしており、村の子供、お年寄りにも人気がある。"},{"spoiler":false,"text":"家事全般が得意で、家ではすずめに代わって母親役をしている（すずめが娘役）。"},{"spoiler":false,"text":"学園ではその持ち前の明るさで、アイドル的人気がある（しかし本人は気付いていない）。"},{"spoiler":false,"text":"小さい頃から、翼のことを「さーくん」と呼んでいる。"}],"source":"egs","sourceCharacterId":"9770","sourceWorkId":"15936","spoiler":false},{"segments":[{"spoiler":false,"text":"开朗活泼，和男生们也像普通朋友般交往，主人公的青梅竹马。在移动超市『黑沢屋』打工，在村里的小孩和老人间也很有人气。擅长所有家务，在家里代替雀扮演着母亲的角色（雀扮演女儿）。"},{"spoiler":false,"text":"在学园凭借着这份天生的活泼开朗，获得了偶像般的人气（但本人并没有察觉）。小时候起就称呼翼为「翼儿」。"},{"spoiler":false,"text":"「Hello，everyone！今天也精神百倍吗？我？我还是一如既往哟！」"}],"source":"bangumi","sourceCharacterId":"24454"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"24454","value":"美春学园后期　2年A班　生活部部员"},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"9770","sourceWorkId":"15936","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"9770","sourceWorkId":"15936","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a95c287c11a4d109f494fbbe5db5948c11409af48cf1d6c2f52fe40edc27f32c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8be9822f4354eb5b3bb57e0476948c547ec54de142d4471ecf977c28dfa819dc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22431:24454:5928:1","source":"bangumi"}]},{"characterId":"char_c26807","characterName":"烏丸 都","sourceIds":{"bangumi":[{"characterId":"24455","match":"exact-normalized-name-in-linked-work","subjectId":"22431"}],"egsCharacterIds":["9771"],"vndbCharacterId":"c26807"},"originalCharacterName":"烏丸 都","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"120"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学校にいる間は静かで清楚な印象なので、高嶺の花に見える。"},{"spoiler":false,"text":"しかし実は、夜更かしして居眠りをしているだけの生活部副部長。"},{"spoiler":false,"text":"自由奔放な部長と、ノリのいいつばめをまとめる、生活部の女房役（影の支配者）。"},{"spoiler":false,"text":"家で経営している和風喫茶「しとらん亭」で、ウエイトレスのバイトをしている。"},{"spoiler":false,"text":"実妹の奏を溺愛しており、奏だけは怒りを買わずに都を眠りから覚ますことができる。"}],"source":"egs","sourceCharacterId":"9771","sourceWorkId":"15936","spoiler":false},{"segments":[{"spoiler":false,"text":"在学园里给人清纯可人的印象，令人望而却步的高岭之花。但实际上，只是个经常熬夜只会打瞌睡的生活部副部长。负责调教自由奔放的部长和得意忘形的燕，生活部的辅佐者。"},{"spoiler":false,"text":"在家里经营的和风咖啡店『紫兔兰亭』当服务员。溺爱着亲生妹妹奏，只有奏能将都从睡眠中唤醒并不惹她生气。"},{"spoiler":false,"text":"「啊，那件事啊？我睡着的时候，貌似一点也不招人喜欢」"}],"source":"bangumi","sourceCharacterId":"24455"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"24455","value":"美春学园后期　2年B班　生活部副部长"},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"9771","sourceWorkId":"15936","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"9771","sourceWorkId":"15936","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/1971361c0c70f484c25032a07cad5298dcf940d56393bd8feae9bd7303718d17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/abec86e530a63df08fd9e023b4b4e227d1dc547217be875f3c1eaf9e1d19249e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北村彩","creatorId":"vndb:s912","sourcePersonId":"vndb:s912","canonicalEntityId":"vndb:s912","name":"北村 彩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22431:24455:6046:1","source":"bangumi"}]},{"characterId":"char_c26808","characterName":"湊 美羽","sourceIds":{"bangumi":[{"characterId":"24456","match":"exact-normalized-name-in-linked-work","subjectId":"22431"}],"egsCharacterIds":["9772"],"vndbCharacterId":"c26808"},"originalCharacterName":"湊 美羽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"303"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AAA"},"height":{"reviewState":"no-conflict","source":"vndb","value":"142"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"無口でクール、頭脳明晰だけど、ニヒルで人生に対し諦観を持っている新入部員。"},{"spoiler":false,"text":"やる気のない態度を見せるが、頼み事は断らないため、何を考えているのかわかりにくい。"},{"spoiler":false,"text":"構ってくる主人公やつばめをうざいと思っているが、自由主義の部長のことは嫌っていない。"},{"spoiler":false,"text":"ツッコミどころ満載な部員たちに対するツッコミ役。"},{"spoiler":false,"text":"ゲームショップ「ディーガル」で店員のアルバイトをしており、趣味はエロゲーと公言している。"}],"source":"egs","sourceCharacterId":"9772","sourceWorkId":"15936","spoiler":false},{"segments":[{"spoiler":false,"text":"无口而冷漠，头脑聪明，但对周围漠不关心、看透人生的新部员。虽然看上去没有干劲，但从不会拒绝他人的委托，很难看透她在想些什么。虽然觉得关照她的主人公和燕很烦人，但并不讨厌自由主义的部长。负责对满载槽点的部员们吐槽。"},{"spoiler":false,"text":"在游戏店『ディーガル』打工，宣言兴趣是工口游戏。"},{"spoiler":false,"text":"「前辈，好烦。如果给钱的话，我还是可以听你哔哔的」"}],"source":"bangumi","sourceCharacterId":"24456"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"24456","value":"美春学园后期　1年A班　生活部部员"},{"label":"罩杯（本版本）","value":"aaa","valueContext":null,"source":"egs","sourceCharacterId":"9772","sourceWorkId":"15936","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"142 cm","valueContext":null,"source":"egs","sourceCharacterId":"9772","sourceWorkId":"15936","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/6372384c781dc2f5de0c0bbc4cef9163d409bb4e4ed7346635a0065c849e00f9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe6321b0e8141ef6e069d9aac9ff93924beb872e03bd4f28553231d10285f331.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22431:24456:6016:1","source":"bangumi"}]},{"characterId":"char_c26810","characterName":"さくら","sourceIds":{"bangumi":[{"characterId":"24464","match":"exact-normalized-name-in-linked-work","subjectId":"22431"}],"egsCharacterIds":["9780"],"vndbCharacterId":"c26810"},"originalCharacterName":"さくら","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AAA"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"悲しいながらも、強い瞳を持つ少女。"},{"spoiler":false,"text":"他人との関係を拒絶し、俗世間から身を引いている。"},{"spoiler":false,"text":"姿は少女だが、その言葉は大人びており、達観した印象すら受ける。"},{"spoiler":false,"text":"生きることと死ぬことの意味を、常に考えている。"},{"spoiler":false,"text":"その姿は明るい世界とは対象に、暗い影を落としている。"}],"source":"egs","sourceCharacterId":"9780","sourceWorkId":"15936","spoiler":false},{"segments":[{"spoiler":false,"text":"眼神中流露着悲伤与坚定气质的女孩子。拒绝与他人扯上关系，远离俗世。虽然是少女的外表，但她的言辞很成熟，给人看破红尘的感觉。"},{"spoiler":false,"text":"总是在思考着生与死的意义。她的身影宛如在光明的世界里落下的黑影。"},{"spoiler":false,"text":"「哥哥们，是“永远”啊……好可怜」"}],"source":"bangumi","sourceCharacterId":"24464"}],"profileFacts":[{"label":"罩杯（本版本）","value":"aaa","valueContext":null,"source":"egs","sourceCharacterId":"9780","sourceWorkId":"15936","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"9780","sourceWorkId":"15936","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3f23ee3dd918c57e12d872c916305854f4484e725aba53821c58c2305081695.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd6eeec38af1ee5a116e31fe18060d4f0d61da140f1eb878dbead539c4331d0b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22431:24464:8580:1","source":"bangumi"}]},{"characterId":"char_c26811","characterName":"三条 詩乃","sourceIds":{"bangumi":[{"characterId":"24463","match":"exact-normalized-name-in-linked-work","subjectId":"22431"}],"egsCharacterIds":["9779"],"vndbCharacterId":"c26811"},"originalCharacterName":"三条 詩乃","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"826"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AAA"},"height":{"reviewState":"no-conflict","source":"vndb","value":"126"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明るく元気で、何にでも興味を持っている女の子。"},{"spoiler":false,"text":"誰にでも笑顔を振りまき、何でもポジティブに捉える。"},{"spoiler":false,"text":"水曜日のお昼時にだけ姿を現し、何故かいつもひとりで行動をしている。"},{"spoiler":false,"text":"ふと見せる遠い目が、少しだけ儚く見えるときがある。"},{"spoiler":false,"text":"サイドに纏めた髪の毛がトレードマーク。"}],"source":"egs","sourceCharacterId":"9779","sourceWorkId":"15936","spoiler":false},{"segments":[{"spoiler":false,"text":"开朗活泼，对任何事都满怀兴趣的女孩子。对任何人都笑容满面，任何事都往积极的一面想。只在星期三的中午出现，不知为何总是独自一人。"},{"spoiler":false,"text":"不经意间眺望远方的眼神，显得如此缥缈虚幻。绑在一侧的单马尾是她的特征。"},{"spoiler":false,"text":"「没问题！诗乃和小樱是好朋友！」"}],"source":"bangumi","sourceCharacterId":"24463"}],"profileFacts":[{"label":"罩杯（本版本）","value":"aaa","valueContext":null,"source":"egs","sourceCharacterId":"9779","sourceWorkId":"15936","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"126 cm","valueContext":null,"source":"egs","sourceCharacterId":"9779","sourceWorkId":"15936","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f22bc887c1b3cd80727c456c01bdc7fc8f7fcc20168b96dafbd58471c7318207.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a7b988973f251b9e2ed326ee0b036db311e468afda5178664cf53e0d4de0896.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"英みらい","creatorId":"vndb:s996","sourcePersonId":"vndb:s996","canonicalEntityId":"vndb:s996","name":"英みらい(大山チロル、ひつじまる)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22431:24463:8069:1","source":"bangumi"}]},{"characterId":"char_c26812","characterName":"十日町 霞","sourceIds":{"bangumi":[{"characterId":"24462","match":"exact-normalized-name-in-linked-work","subjectId":"22431"}],"egsCharacterIds":["9778"],"vndbCharacterId":"c26812"},"originalCharacterName":"十日町 霞","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1224"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明るく前向きなボクっ子（エロ）ゲームショップ店員。"},{"spoiler":false,"text":"エロゲーをこよなく愛し、頭の中は常にエロゲーのことで一杯の腐女子。"},{"spoiler":false,"text":"油断すると地方訛りが出てしまい、すぐに頭を抱えて後悔してしまう。"},{"spoiler":false,"text":"口癖は『エロスだべっ！』という、ちょっと可哀想な子。"},{"spoiler":false,"text":"自分のことを『ボク』と呼ぶ。"}],"source":"egs","sourceCharacterId":"9778","sourceWorkId":"15936","spoiler":false},{"segments":[{"spoiler":false,"text":"积极开朗的游戏店『DEE GULL』店员。十分热爱工口游戏，满脑子想的都是工口游戏的腐女。一不留神就冒出家乡话，马上就抱着脑袋后悔。"},{"spoiler":false,"text":"口癖是「工口（仙台口音）哟！」，有些悲剧的孩子。称自己为“偶”。"},{"spoiler":false,"text":"「能够动摇偶的精神的东西……那就是、工口哟！」"}],"source":"bangumi","sourceCharacterId":"24462"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"24462","value":"游戏店『DEE GULL』店员"},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"9778","sourceWorkId":"15936","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"9778","sourceWorkId":"15936","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f75a1e0949a1669f39dc6cfcecf3989b42f13dfbdbbf833dc370213b3548905b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24cc77895bef9cd0a47204a61195afb2422a7622cdd7df167d7e0e967d997018.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"涼貴涼","creatorId":"vndb:s519","sourcePersonId":"vndb:s519","canonicalEntityId":"vndb:s519","name":"涼貴 涼","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22431:24462:22923:1","source":"bangumi"}]},{"characterId":"char_c26813","characterName":"卯月 歩鳥","sourceIds":{"bangumi":[{"characterId":"24461","match":"exact-normalized-name-in-linked-work","subjectId":"22431"}],"egsCharacterIds":["9777"],"vndbCharacterId":"c26813"},"originalCharacterName":"卯月 歩鳥","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"615"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園に赴任してきたばかりの新任教師。"},{"spoiler":false,"text":"誰もなり手がいない生活部の顧問に祭り上げられる。"},{"spoiler":false,"text":"しかし副学園長先生にいつも怒られてばかりなので、部活に顔を出すことは滅多にない。"},{"spoiler":false,"text":"超天然キャラクターにより、学生たちからは愛されている。"},{"spoiler":false,"text":"愛車である『ロドちゃん』をいじるのが趣味。"}],"source":"egs","sourceCharacterId":"9777","sourceWorkId":"15936","spoiler":false},{"segments":[{"spoiler":false,"text":"刚到学园赴任的新任教师。被推举为没人愿意接手的生活部的顾问。但是总是惹副校长老师生气，不怎么出席社团活动。超天然呆，被学生们所敬爱。"},{"spoiler":false,"text":"兴趣是摆弄爱车『ロドちやん』。"},{"spoiler":false,"text":"「大家好。今天的课就到此为止哦～那么再见、拜拜」"}],"source":"bangumi","sourceCharacterId":"24461"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"24461","value":"2年B班班主任（担当是国语）"},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"9777","sourceWorkId":"15936","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"9777","sourceWorkId":"15936","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b063defaa41f12fab52c7ed89680dca8579c0e600f0f828056b62333a9c4310.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50a672f66453ac646a5833dec6da47a6aec720660095ead3a97dff065419858b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22431:24461:6469:1","source":"bangumi"}]},{"characterId":"char_c26814","characterName":"春野 すずめ","sourceIds":{"bangumi":[{"characterId":"24460","match":"exact-normalized-name-in-linked-work","subjectId":"22431"}],"egsCharacterIds":["9776"],"vndbCharacterId":"c26814"},"originalCharacterName":"春野 すずめ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"331"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"つばめや翼にとって姉のような存在のつばめの母親。"},{"spoiler":false,"text":"しかし家事全般が苦手なので、そのほとんどをつばめが行っている。"},{"spoiler":false,"text":"土いじりが好きで、農作業をして生計を立てている。"},{"spoiler":false,"text":"トコシエであるため見た目は若いが、実年齢は（極秘）。"},{"spoiler":false,"text":"翼の親とは、古い付き合いだったらしい。"}],"source":"egs","sourceCharacterId":"9776","sourceWorkId":"15936","spoiler":false},{"segments":[{"spoiler":false,"text":"对于燕和翼来说是姐姐般的存在，燕的母亲。但是不擅长任何家务，家务基本上都交给燕负责。喜欢与泥土打交道，通过种地来维持生计。"},{"spoiler":false,"text":"由于是“永远”，外表看上去十分年轻，实际年龄是机密。和翼的母亲似乎是老朋友。"},{"spoiler":false,"text":"「燕，肚子饿了。妈妈我，想吃汉堡包啊」"}],"source":"bangumi","sourceCharacterId":"24460"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"24460","value":"农业研究家（自称）"},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"9776","sourceWorkId":"15936","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"9776","sourceWorkId":"15936","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d271e321fcf3d7f1eafd56ecabf14ab946208530d2e5f4069258f04bc93bf5a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89d17e9a3b7d9a0128b8edce4610093de019fb540e9970617ab4c8408ec0a243.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"飯野ユウ","creatorId":"vndb:s931","sourcePersonId":"vndb:s931","canonicalEntityId":"vndb:s931","name":"飯野 ユウ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22431:24460:6377:1","source":"bangumi"}]},{"characterId":"char_c26815","characterName":"白鷹 すみれ","sourceIds":{"bangumi":[{"characterId":"24457","match":"exact-normalized-name-in-linked-work","subjectId":"22431"}],"egsCharacterIds":["9773"],"vndbCharacterId":"c26815"},"originalCharacterName":"白鷹 すみれ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"918"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"数々の伝説を持つ、生活部部長。"},{"spoiler":false,"text":"ざっくばらんな性格で、何事にも動じず、何事も気にしない。"},{"spoiler":false,"text":"部員たちからの信頼は絶大で、何かと頼りにされている。"},{"spoiler":false,"text":"視力が悪いわけではないらしいが、外出する時には眼鏡をかける（本人曰く、眼鏡っ子萌え）。"},{"spoiler":false,"text":"女子部員へのセクハラ行為や、下ネタ談義が趣味。"}],"source":"egs","sourceCharacterId":"9773","sourceWorkId":"15936","spoiler":false},{"segments":[{"spoiler":false,"text":"拥有着好几个传说的生活部部长。心直口快的性格，不为任何事所动摇，不拘小节。很受到部员们的信赖，一有什么事就依靠她。"},{"spoiler":false,"text":"视力并不是不好，但出门的时候一定要戴眼镜（据本人说是萌眼镜）。兴趣是对女部员进行性骚扰和讲荤段子。"},{"spoiler":false,"text":"「在此断言！今天将会是自地球诞生以来，最热闹的日子！」"}],"source":"bangumi","sourceCharacterId":"24457"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"24457","value":"美春学园后期　3年D班　生活部部长"},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"9773","sourceWorkId":"15936","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"9773","sourceWorkId":"15936","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b371dd60ced0f4c9df7bb5808a6ee2bd2dd56eb77c2cb534e80ec5bd5fb95d9a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52d9dda27114fae90c4b485faf447b87ac7a6686ea0ade9c9ed951a0e110e9a9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"アイカリツ","creatorId":"vndb:s3995","sourcePersonId":"vndb:s3995","canonicalEntityId":"vndb:s3995","name":"アイカリツ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41400","source":"vndb"}]},{"characterId":"char_c26816","characterName":"烏丸 奏","sourceIds":{"bangumi":[{"characterId":"24458","match":"exact-normalized-name-in-linked-work","subjectId":"22431"}],"egsCharacterIds":["9774"],"vndbCharacterId":"c26816"},"originalCharacterName":"烏丸 奏","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"901"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AA"},"height":{"reviewState":"no-conflict","source":"vndb","value":"142"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"引っ込み思案で、人見知りが激しい都の妹。"},{"spoiler":false,"text":"運動神経が鈍く、何かとつまずいたりぶつかったりする。"},{"spoiler":false,"text":"都に誘われて、去年から生活部の部室へよく遊びに来ている。"},{"spoiler":false,"text":"絵を描くのが得意で、常にスケッチブックを手にしている。"},{"spoiler":false,"text":"子供っぽい外見が気になるらしく、姉の胸の大きさに憧れている（特訓中）。"}],"source":"egs","sourceCharacterId":"9774","sourceWorkId":"15936","spoiler":false},{"segments":[{"spoiler":false,"text":"胆小消极、极其怯生，都的妹妹。"},{"spoiler":false,"text":"运动神经很迟钝，常常不小心跌倒、撞墙。"},{"spoiler":false,"text":"从去年起就常常被都邀到生活部的社团教室里来玩。"},{"spoiler":false,"text":"擅长画画，总是把素描本拿在手上。"},{"spoiler":false,"text":"十分在意自己年幼的外表，很羡慕姐姐的大胸（特训中）。"},{"spoiler":false,"text":"「我、我这样的……完全不行的说……」"}],"source":"bangumi","sourceCharacterId":"24458"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"24458","value":"美春学园前期　1年B班"},{"label":"罩杯（本版本）","value":"aa","valueContext":null,"source":"egs","sourceCharacterId":"9774","sourceWorkId":"15936","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"142 cm","valueContext":null,"source":"egs","sourceCharacterId":"9774","sourceWorkId":"15936","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8b53fc969e6b967764721d672bf59714524f412447aa793d89e4fdf3c645204.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b65671fbc330ca3b214cb1ab6ab5a3895b50d946b83aff829892e77a101afc6f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"尾崎未來","creatorId":"vndb:s986","sourcePersonId":"vndb:s986","canonicalEntityId":"vndb:s986","name":"尾崎 未來","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22431:24458:13776:1","source":"bangumi"}]},{"characterId":"char_c26817","characterName":"天使突抜 瀬利華","sourceIds":{"bangumi":[{"characterId":"24459","match":"exact-normalized-name-in-linked-work","subjectId":"22431"}],"egsCharacterIds":["9775"],"vndbCharacterId":"c26817"},"originalCharacterName":"天使突抜 瀬利華","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1010"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"元天使突抜グループ令嬢で、生活部の天敵であるプライドが高い学生会長。"},{"spoiler":false,"text":"学園では絶対的な権力を持ち、主人公（翼）が所属していた水泳部を潰した張本人。"},{"spoiler":false,"text":"生活部に頻繁に出入りし部を潰すと脅しをかけるが、ことごとくすみれ（部長）に返り討ちにされてしまう。"},{"spoiler":false,"text":"胸の小ささが玉に瑕で、指摘されると怒り出す。"},{"spoiler":false,"text":"巻き髪がトレードマークだが、実は……"}],"source":"egs","sourceCharacterId":"9775","sourceWorkId":"15936","spoiler":false},{"segments":[{"spoiler":false,"text":"原天使突抜集团的千金，生活部的天敌，自尊心强的学生会会长。在学园里拥有绝对的权利，击溃主人公所属的游泳部的始作俑者。频繁地出入生活部，威胁要击溃生活部，但常常被堇（部长）赶了回去。"},{"spoiler":false,"text":"胸小是美中不足，被指出来的话就会生气。卷发是她的特征，但实际上……"},{"spoiler":false,"text":"「老、老师在这里？给我记住了！白鹰堇！」"}],"source":"bangumi","sourceCharacterId":"24459"}],"profileFacts":[{"label":"所属","source":"bangumi","sourceCharacterId":"24459","value":"美春学园后期　3年A班　美春学园学生会会长"},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"9775","sourceWorkId":"15936","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8dd7754e4f2f72f614b6c79829f76726fb5c012b533f0ee48522c595f13a1f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02f65d946da1d4c229a5512e99ad8b46ba9e2cbcfa160fecaeec69bb8a0c7249.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮沢ゆあな","creatorId":"vndb:s830","sourcePersonId":"vndb:s830","canonicalEntityId":"vndb:s830","name":"宮沢ゆあな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22431:24459:5915:1","source":"bangumi"}]},{"characterId":"char_vndb_c90934","characterName":"新庄 翼","sourceIds":{"vndbCharacterId":"c90934"},"originalCharacterName":"新庄 翼","ch