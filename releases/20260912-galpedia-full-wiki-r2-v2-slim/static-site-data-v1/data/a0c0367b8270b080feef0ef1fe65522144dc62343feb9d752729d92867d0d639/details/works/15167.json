t":"頼りがいがあるが故に、女の子たちにとってはわがままを言いやすい相手でもある。"}],"source":"bangumi","sourceCharacterId":"12746"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/0426b003de446b98d7c99518d9ec3a66a42df3c9c331bf0c79c86eda21001b05.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96cdd42ea46932b0545df245f159980e65b87ddcab1eea57695ad01eae7cd737.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c2095","characterName":"小桜 くるみ","sourceIds":{"bangumi":[{"characterId":"12741","match":"exact-normalized-name-in-linked-work","subjectId":"14769"}],"egsCharacterIds":["10337"],"vndbCharacterId":"c2095"},"originalCharacterName":"小桜 くるみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"901"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"height":{"reviewState":"no-conflict","source":"vndb","value":"151"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Three years younger than Takumi. Miu's friend. The older twin sister of Hina. She hates men. Kurumi is the one that made the accessories for the cafe's uniforms."},{"spoiler":false,"text":"summarized from Getchu"}],"source":"vndb","sourceCharacterId":"c2095"},{"segments":[{"spoiler":false,"text":"美羽の友達で喫茶店の近くに住んでいる。"},{"spoiler":false,"text":"ひなとは双子の姉妹でくるみは姉になる。"},{"spoiler":false,"text":"巧巳より3つ年下。"},{"spoiler":false,"text":"無口で表情の変化に乏しい。"},{"spoiler":false,"text":"友達を作るのも不得手で、周りの人々は社交的な妹のほうを相手にし、くるみはおざなりになることもしばしば。"},{"spoiler":false,"text":"観察眼には優れているが、自分から行動することは苦手。"},{"spoiler":false,"text":"感情表現が下手なのと、周りを立てる性格を誤解されがちだが、実はいつも妹（ひな）のことを気に掛けるやさしいお姉さんの一面もある。"}],"source":"egs","sourceCharacterId":"10337","sourceWorkId":"15167","spoiler":false},{"segments":[{"spoiler":false,"text":"巧巳より3つ年下の、美羽の友達。"},{"spoiler":false,"text":"ひなとは双子の姉妹でくるみは姉になる。"},{"spoiler":false,"text":"無口で表情の変化に乏しい。"},{"spoiler":false,"text":"観察眼には優れているが、自分から行動することは苦手。"},{"spoiler":false,"text":"感情表現が下手なことと、周りを立てる性格から誤解されがちだが、いつもひなのことを気に掛けるやさしい一面もある。"},{"spoiler":false,"text":"「私の妹をエッチな目で見ないで……ロリコン」"}],"source":"bangumi","sourceCharacterId":"12741"}],"profileFacts":[{"label":"胸围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"10337","sourceWorkId":"15167","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"151 cm","valueContext":null,"source":"egs","sourceCharacterId":"10337","sourceWorkId":"15167","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"10337","sourceWorkId":"15167","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"10337","sourceWorkId":"15167","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a7822b98a4ae7dfc36f9a89251c8f22a5fafe0acd927b683f8f14376060dbe9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c6c59dbc00fbfc4142447659745c77affe0eb25bdc6760ed322448f5fd1dbdc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14769:12741:10027:1","source":"bangumi"}]},{"characterId":"char_c2096","characterName":"水城 美羽","sourceIds":{"bangumi":[{"characterId":"12740","match":"exact-normalized-name-in-linked-work","subjectId":"14769"}],"egsCharacterIds":["10335"],"vndbCharacterId":"c2096"},"originalCharacterName":"水城 美羽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"422"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The manager of the cafe. She's positive and assertive. As a child, she asked Takumi to marry her when she grew up."},{"spoiler":false,"text":"summarized from Getchu"}],"source":"vndb","sourceCharacterId":"c2096"},{"segments":[{"spoiler":false,"text":"喫茶店の暫定店長。巧己の従妹で2つ年下。"},{"spoiler":false,"text":"約3年ぶりの再会となる。"},{"spoiler":false,"text":"久しぶりに会う美羽の成長した姿には戸惑いを覚えるほど。"},{"spoiler":false,"text":"明るく前向きで積極的な性格。"},{"spoiler":false,"text":"巧己の事が大好きで早く大人の女として認められたがっている。"},{"spoiler":false,"text":"昔「お兄ちゃんのお嫁さんにして欲しい」とお願いしたことがあり、そのとき巧巳から「大人になったらね」と言われたことを未だに覚えている。"}],"source":"egs","sourceCharacterId":"10335","sourceWorkId":"15167","spoiler":false},{"segments":[{"spoiler":false,"text":"喫茶店の暫定店長で、2つ年下の従妹。"},{"spoiler":false,"text":"明るく前向きで積極的な性格。"},{"spoiler":false,"text":"巧己のことが大好きで、早く大人の女として認められたがっている。"},{"spoiler":false,"text":"子供の頃、「お兄ちゃんのお嫁さんにしてほしい」 とお願いした事があり、その時 「大人になったら」 と言われたことをいまだに覚えている。"},{"spoiler":false,"text":"「今日からお兄ちゃんと1つ屋根の下だね？　妹に襲われないよう、注意だぞっ」"}],"source":"bangumi","sourceCharacterId":"12740"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"10335","sourceWorkId":"15167","sourceFi