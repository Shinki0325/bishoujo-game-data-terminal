:"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:114258","source":"vndb"},{"creditedName":"玄野 トモアキ","creatorId":"vndb:s713","sourcePersonId":"vndb:s713","canonicalEntityId":"vndb:s713","name":"玄野 トモアキ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:114260","source":"vndb"},{"creditedName":"かなみ","creatorId":"vndb:s895","sourcePersonId":"vndb:s895","canonicalEntityId":"vndb:s895","name":"かなみ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:114261","source":"vndb"},{"creditedName":"でぇすて","creatorId":"vndb:s921","sourcePersonId":"vndb:s921","canonicalEntityId":"vndb:s921","name":"でぇすて(D.S.T、不二川巴人)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:114268","source":"vndb"},{"creditedName":"橘 まお","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:114269","source":"vndb"},{"creditedName":"神鷹 輝","creatorId":"vndb:s7532","sourcePersonId":"vndb:s7532","canonicalEntityId":"vndb:s7532","name":"神鷹 輝","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:114272","source":"vndb"},{"creditedName":"禁肉さん","creatorId":"vndb:s19191","sourcePersonId":"vndb:s19191","canonicalEntityId":"vndb:s19191","name":"禁肉さん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:114273","source":"vndb"}]},"cast":[{"characterId":"char_c22314","characterName":"神山 優理","sourceIds":{"bangumi":[{"characterId":"60772","match":"exact-normalized-name-in-linked-work","subjectId":"122964"}],"egsCharacterIds":["5248"],"vndbCharacterId":"c22314"},"originalCharacterName":"神山 優理","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Principal of the newly founded Seishuu Academy. Old friends with Maki, often refers to Maki as her older sister in private conversations. Daughter of the head of the Kamiyama family that are of a similar line of educators to Kazuya. A lady of kindness and intellect, she graduated top of her class from Shuukoukan Academy. Her role as Principal of Seishuu is not only a way of proving herself to her family, but also a fulfillment of her love for learning new things and having others experience the same. She would do anything for Seishuu Academy's sake."}],"source":"vndb","sourceCharacterId":"c22314"},{"segments":[{"spoiler":false,"text":"国内有数の教育者一族の本家に一人娘として生まれ、幼い頃から人を指導する立場となるべく英才教育を受けて育てられた女性。"},{"spoiler":false,"text":"若くして人を率いる素養を身につけており、優しい物腰ながらも凛とした静かな威厳を持つ。"},{"spoiler":false,"text":"生まれもっての才能に加え、本人の勤勉な性格により学習能力が抜群に高く、何をやらせてもすぐに吸収して巧みにこなしてしまう。"},{"spoiler":false,"text":"その能力を発揮し、数々の優秀な成績を上げて、たちまち一族の期待を一身に背負うようになる。"},{"spoiler":false,"text":"若年ながら誠秀学園の開校プロジェクトを任され、それを成し遂げて学園長の席に収まった。"},{"spoiler":false,"text":"人を教え導くことを生業としきた自分の家系を誇りに思っており、自分も尊敬する先人のように立派な教師として役目を果たすことを人生の目標としている。"},{"spoiler":false,"text":"教育に対して並々ならぬ熱意を燃やしており、他人に喜んでもらえるなら、自分でできることは何でもする性格。"},{"spoiler":false,"text":"学生のために身を挺することも厭わず、彼らを脅かす存在に対しては学園長として断固立ち向かう。"}],"source":"egs","sourceCharacterId":"5248","sourceWorkId":"21116","spoiler":false},{"segments":[{"spoiler":false,"text":"凛然之中包含着温柔的年轻学园长"},{"spoiler":false,"text":"出生自国内数一数二的教育者一族的本家的独生女。"},{"spoiler":false,"text":"自小接受英才教育，虽然举止温和但也有着稳重而凛然的威严。"},{"spoiler":false,"text":"再加上因为本人勤勉的性格，学习能力出众，不管做什么都会很快吸收并顺利地处理完毕。"},{"spoiler":false,"text":"年纪轻轻就被委托了誠秀学園的建校计划，最终完成坐上了学园长的位子。"},{"spoiler":false,"text":"对自己的血统怀着骄傲，以像尊敬的先人一样作为优秀教师完成使命为人生的目标。"},{"spoiler":false,"text":"为了学生愿意挺身而出，作为学园长坚毅地面对威胁他们的存在。"}],"source":"bangumi","sourceCharacterId":"60772"}],"profileFacts":[{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"5248","sourceWorkId":"21116","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"5248","sourceWorkId":"21116","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"5248","sourceWorkId":"21116","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"5248","sourceWorkId":"21116","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/210c53a5f4a94a26e095fa0a659d9a8852f7b743a9ffd11ad97951e09ac0e66f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab53e7845fef881c9dfadabed6fc0485258a2cb78d2cf8a1f971f6cabef7dfdd.webp","width":120,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川知子","creatorId":"vndb:s694","sourcePersonId":"vndb:s694","canonicalEntityId":"vndb:s694","name":"ひむろゆり(氷室百合)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122964:60772:5924:1","source":"bangumi"}]},{"characterId":"char_c22315","characterName":"吉岡 マキ","sourceIds":{"bangumi":[{"characterId":"60773","match":"exact-normalized-name-in-linked-work","subjectId":"122964"}],"egsCharacterIds":["5250"],"vndbCharacterId":"c22315"},"originalCharacterName":"吉岡 マキ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"27"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"927"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"World history teacher at Seishuu Academy. Old friends with Yuuri. Exudes an air of professionalism, and maturity. As a member of a branch family in relation to the Kamiyama household, she makes it her duty to protect Yuuri."}],"source":"vndb","sourceCharacterId":"c22315"},{"segments":[{"spoiler":false,"text":"いつでも凛々しい表情を崩さず、毅然とした態度で振る舞う教師。"},{"spoiler":false,"text":"常に姿勢正しく、冷淡な口調で喋り、誰にも弱みを見せない。"},{"spoiler":false,"text":"指導は厳しめ、授業もスパルタ気味で、学生達からは近寄りがたい教師として恐れられている。"},{"spoiler":false,"text":"教育者一族の人間だが分家筋の生まれで、優理とは親戚として子供の頃から付き合いがある。"},{"spoiler":false,"text":"優理からはその頃からずっと慕われており、姉妹のように接する仲。"},{"spoiler":false,"text":"その関係と、マキ本人の優秀さを買われ、一族から優理の補佐を任されて誠秀学園の教員となる。"},{"spoiler":false,"text":"優理のことは自分自身よりも大切な存在として見ており、彼女に対してだけは心を許し、仕事では彼女の補佐として忌憚のない意見をぶつけながらも、日常のやりとりでは柔らかい表情を見せることもある。"}],"source":"egs","sourceCharacterId":"5250","sourceWorkId":"21116","spoiler":false},{"segments":[{"spoiler":false,"text":"身缠冷淡的氛围的美貌世界史教師"},{"spoiler":false,"text":"总是维持着凛然的表情，以毅然的态度为人处事的教师。"},{"spoiler":false,"text":"指导严格，上课也很严苛，被学生们视为难以接近的教师而畏惧。"},{"spoiler":false,"text":"虽然教育者一族的人，但却是分家出身，和優理是亲戚，自小就有着交情。"},{"spoiler":false,"text":"从那时起就一直被優理所仰慕，就像是姐妹般的关系。"},{"spoiler":false,"text":"而和優理的关系和本人的优秀被看中，被一族授予了辅佐優理的任务，并成为誠秀学園的教师。"},{"spoiler":false,"text":"把優理视为比自己要更重要的存在，只对她敞开心扉。"},{"spoiler":false,"text":"虽然在工作上会毫无忌惮地产生意见上的冲突，但在日常的交流中也会露出柔和的表情。"}],"source":"bangumi","sourceCharacterId":"60773"}],"profileFacts":[{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"5250","sourceWorkId":"21116","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"5250","sourceWorkId":"21116","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"5250","sourceWorkId":"21116","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"5250","sourceWorkId":"21116","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05f92cda89443edb775a60a5cf24853b1937ac0147a7b4839ac7e9b582d39a15.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9b8585b452510d2f04fa789920fc9ce29f4d34ea9ac45b79f05d32653ebabae.webp","width":121,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤雅美","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122964:60773:13773:1","source":"bangumi"}]},{"characterId":"char_c22316","characterName":"大谷 歌穂","sourceIds":{"bangumi":[{"characterId":"60774","match":"exact-normalized-name-in-linked-work","subjectId":"122964"}],"egsCharacterIds":["5249"],"vndbCharacterId":"c22316"},"originalCharacterName":"大谷 歌穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"PE teacher at Seishuu Academy. Due to her penchant for friendliness and understanding, she's quite popular among the students. Old dorm mate and friend of Asahi when they were students of Shuukoukan Academy."}],"source":"vndb","sourceCharacterId":"c22316"},{"segments":[{"spoiler":false,"text":"快活な性格で、どんな学生にも気さくに接する明るさとノリの良さを持っているため、学生・教師問わず誰からも慕われている女性。"},{"spoiler":false,"text":"とても面倒見がよく、学生達に何かあった際は真正面から真摯に問題に取り組む姉御肌気質。"},{"spoiler":false,"text":"教師という仕事に誇りを持っており、とても真面目。"},{"spoiler":false,"text":"出来の悪い学生ほど、よく気に掛けている。"},{"spoiler":false,"text":"しかし学生のことは細かく気が利く一方で、自分自身のことは疎かにしがちで、部屋が片付けられなかったり、食事をカップ麺で済ませたりするなど、少々残念な面もある。"}],"source":"egs","sourceCharacterId":"5249","sourceWorkId":"21116","spoiler":false},{"segments":[{"spoiler":false,"text":"拥有学园屈指可数的人气的体育教師"},{"spoiler":false,"text":"性格活泼，不管对任何学生都很率直的体育教师。"},{"spoiler":false,"text":"因为开朗和爱起劲的性格，深受学生和老师的爱慕。"},{"spoiler":false,"text":"非常热心，学生遇到问题的时候正对面地努力于解决问题的大姐头性格。"},{"spoiler":false,"text":"对教师的工作怀有骄傲，特别认真。"},{"spoiler":false,"text":"越是行为恶劣的学生就越是担心。"},{"spoiler":false,"text":"但是对学生的事情很机灵的另一方面，对自己的事情就特别马大哈。"},{"spoiler":false,"text":"也有不整理房间，用杯面应付三餐的有些残念的一面。"}],"source":"bangumi","sourceCharacterId":"60774"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"5249","sourceWorkId":"21116","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"5249","sourceWorkId":"21116","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"5249","sourceWorkId":"21116","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"5249","sourceWorkId":"21116","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/492d82ffce570c08ecbd92132635c3d7e8fed70363ea5e4d2a2f04b3557b68a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c49ee3874af5a66989de872b0e1a918c9009a0dbb4cb0f27556613c21cc941b8.webp","width":125,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122964:60774:15637:1","source":"bangumi"}]},{"characterId":"char_c22317","characterName":"西崎 あさひ","sourceIds":{"bangumi":[{"characterId":"60775","match":"exact-normalized-name-in-linked-work","subjectId":"122964"}],"egsCharacterIds":["5251"],"vndbCharacterId":"c22317"},"originalCharacterName":"西崎 あさひ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Art teacher at Seishuu Academy. She works hard to prove her maturity. Short-tempered to others that call her childish. Old dorm mate and friend of Kaho when they were students at Shuukoukan Academy."}],"source":"vndb","sourceCharacterId":"c22317"},{"segments":[{"spoiler":false,"text":"年齢とマッチしない幼い見た目の女性。"},{"spoiler":false,"text":"自らの子供っぽさを気にしており、普段は物腰の落ち着いた、大人びた振る舞いをして、学生達には年上然とした態度で接するよう心がけている。"},{"spoiler":false,"text":"しかしボロが出やすく、「可愛い」とマスコット的な扱われ方をするとすぐに本性が現れ、子供っぽくプンプンと怒る。"},{"spoiler":false,"text":"本来の性格は勝ち気でやんちゃ、そして少々凶暴。"},{"spoiler":false,"text":"そんな幼い容姿と気性を持つ一方、並々ならぬ努力家でもあり、庶民の身では難しいとされる修煌館学園への入学を果たした上で、念願の教職に就いた。"}],"source":"egs","sourceCharacterId":"5251","sourceWorkId":"21116","spoiler":false},{"segments":[{"spoiler":false,"text":"小巧可怜的幼小美術教師"},{"spoiler":false,"text":"外表年幼得和年龄不符的女性。"},{"spoiler":false,"text":"很在意自己的孩子气，所以注意着自己以年长者的态度来应对学生。"},{"spoiler":false,"text":"但是很快又会原形毕露，被称赞「可爱」和被当做是吉祥物对待的时候露出本性，像是小孩子一样生气。"},{"spoiler":false,"text":"原本性格好胜且顽皮，还有有些凶暴。"},{"spoiler":false,"text":"在有着幼稚的外表和性情的另一方面是个非常人能比的努力家，进入了庶民难以进入的修煌館学園就读之后成功达成了心愿，当上了教师。"}],"source":"bangumi","sourceCharacterId":"60775"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"5251","sourceWorkId":"21116","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"153 cm","valueContext":null,"source":"egs","sourceCharacterId":"5251","sourceWorkId":"21116","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"5251","sourceWorkId":"21116","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"5251","sourceWorkId":"21116","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a999c23afeff486cf5b6cb2baaee215b625e504a67cedddfdbb0ceff0528be38.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89d4724e6b101c160a4f4222fc77468a9007895d1486a531f2ff034bbf4ee8f1.webp","width":94,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘志穂","creatorId":"vndb:s738","sourcePersonId":"vndb:s738","canonicalEntityId":"vndb:s738","name":"橘 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122964:60775:7169:1","source":"bangumi"}]},{"characterId":"char_c22318","characterName":"高峰 美結","sourceIds":{"bangumi":[{"characterId":"60776","match":"exact-normalized-name-in-linked-work","subjectId":"122964"}],"egsCharacterIds":["5252"],"vndbCharacterId":"c22318"},"originalCharacterName":"高峰 美結","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"819"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Math teacher at Seishuu Academy. Saya's younger sister. She acts arrogantly but she's actually quite clumsy, and easy to fluster."}],"source":"vndb","sourceCharacterId":"c22318"},{"segments":[{"spoiler":false,"text":"学生にも同僚の教師にも高慢な態度を取る、優理とは違う方向性で生粋のお嬢様気質。"},{"spoiler":false,"text":"実力はあり優秀な人間だが、他人を見下しており、出来の悪い成績下位の人間は容赦なく切り捨てる教育方針。"},{"spoiler":false,"text":"またそういった思想や態度を公言しているので、学生達からは敬遠されている。"},{"spoiler":false,"text":"名家である家の威光で、周りの人間からもてはやされてきたため、絵に描いたようにプライドが高い高飛車な性格になった。"},{"spoiler":false,"text":"一方で、挫折の経験が無いため打たれ弱く、直接悪意をぶつけられることにも慣れていない。"},{"spoiler":false,"text":"自分に対処できない事態が舞い込んでくると、簡単にパニックに陥ってしまう。"}],"source":"egs","sourceCharacterId":"5252","sourceWorkId":"21116","spoiler":false},{"segments":[{"spoiler":false,"text":"让人很想欺负的胆小而傲慢的大小姐数学教师"},{"spoiler":false,"text":"对学生和同事都是一副傲慢的态度的，和優理不同方向上的纯粹大小姐气质。"},{"spoiler":false,"text":"虽然是个有实力的优秀人才，但看不起别人，贯彻毫不留情地将差生给抛弃的教育方针。"},{"spoiler":false,"text":"再因为公开了自己的思想和态度，所以被学生们敬而远之。"},{"spoiler":false,"text":"因为家里的权势而被赞扬的原因，养成了范本般的自尊心强的蛮横性格。"},{"spoiler":false,"text":"另一方面因为没遭受过挫折，所以经不起打击，也不习惯直接被人恶意相待。"},{"spoiler":false,"text":"一旦陷入自己无法应对的事态中就会轻易陷入恐慌中。"}],"source":"bangumi","sourceCharacterId":"60776"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"5252","sourceWorkId":"21116","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"5252","sourceWorkId":"21116","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"5252","sourceWorkId":"21116","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"5252","sourceWorkId":"21116","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2cd84f3ba9f2dd3862aefc6d2dc0661d98588fe22371a99cb1b1b26cad560384.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a741275b818a3776583942843585242c71565085b1773b38166598a3d8461f30.webp","width":145,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日アン(春乃うらら)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122964:60776:6480:1","source":"bangumi"}]},{"characterId":"char_vndb_c22476","characterName":"金本 一也","sourceIds":{"vndbCharacterId":"c22476"},"originalCharacterName":"金本 一也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student at Seishuu Academy."},{"spoiler":false,"text":"Born to a line of educators. Son to one of the founders of Shuukoukan Academy, a top-class elite school."}],"source":"vndb","sourceCharacterId":"c22476"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74f62ff921b4a643f6a60df5b341e988d539bedc2a94cb300ad372caf87631fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8ae15d45721029bc515c70f23a18d182ca68e0d3418be8c6294e51dfdef