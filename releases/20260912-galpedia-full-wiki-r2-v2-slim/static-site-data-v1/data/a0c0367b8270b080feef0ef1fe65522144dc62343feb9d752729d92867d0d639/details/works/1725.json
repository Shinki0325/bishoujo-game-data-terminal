5","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の３人の幼なじみの中の一人で、乃亜のお姉さん。"},{"spoiler":false,"text":"仲良し４人組の中で一人年上だった美鈴は、当然のように何かと面倒見が良いお姉さんになってしまった。"},{"spoiler":false,"text":"今は花屋で働いており付き合いは減っているが、飲みに行こうと良く誘われる。"}],"source":"bangumi","sourceCharacterId":"152744"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/022ca99eaa936790c71ededcbc2960ea9aa18ef296684bc1e227d726886efb56.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/337200c8ddc1be374bad1a7cb2f23e1281ff4707583ec06e4cb5a00e3a117e14.webp","width":140,"height":210,"source":"static-detail"},"actors":[]},{"characterId":"char_c84287","characterName":"ロリ先生","sourceIds":{"bangumi":[{"characterId":"152742","match":"exact-normalized-name-in-linked-work","subjectId":"329220"}],"egsCharacterIds":["27752"],"vndbCharacterId":"c84287"},"originalCharacterName":"ロリ先生","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の担任の先生。"},{"spoiler":false,"text":"担当教科は数学と物理。"},{"spoiler":false,"text":"見た目が幼く、よく苛められて……もとい慕われている先生。"},{"spoiler":false,"text":"男子の一部では”ロリ先生”で通っている。"}],"source":"egs","sourceCharacterId":"27752","sourceWorkId":"1725","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の通う学園の教師。"},{"spoiler":false,"text":"見た目が幼く、いまいち教師には見えないが・・・。"},{"spoiler":false,"text":"学生には人気が有り、男子の間では”ロリ先生”と呼ばれていることも有る。"}],"source":"bangumi","sourceCharacterId":"152742"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/401f6bcc901caef0e0acaf53c7225ba8681e0233426480834dc914b8fc42d4b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7debd297d87e998d0899c7f333