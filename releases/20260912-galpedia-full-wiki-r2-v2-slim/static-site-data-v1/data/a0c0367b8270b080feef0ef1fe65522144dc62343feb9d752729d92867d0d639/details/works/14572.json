onflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18d1a88a0f6f8a8f2ea6b51a39f0d1e4f088bd89485e0dda749065f96cfc5d08.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/459adf03204e84aee092b0ebd01866aa90f4ee1be68e180f21d87a93b487e50b.webp","width":256,"height":246,"source":"static-detail"},"actors":[{"creditedName":"興津 和幸","creatorId":"vndb:s85","sourcePersonId":"vndb:s85","canonicalEntityId":"vndb:s85","name":"興津 和幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45140","source":"vndb"}]},{"characterId":"char_vndb_c145466","characterName":"寮監","sourceIds":{"vndbCharacterId":"c145466"},"originalCharacterName":"寮監","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5fa6a06256e677213c3b5a7c8f9fc3d363436d23fa6fc315b0931dc2be82dfa1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bcbc0c560b0475cc3178e4723552da6b179334da9113312d5910bf5e18715d8e.webp","width":256,"height":144,"source":"static-detail"},"actors":[{"creditedName":"生天目 仁美","creatorId":"vndb:s270","sourcePersonId":"vndb:s270","canonicalEntityId":"vndb:s270","name":"生天目仁美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45141","source":"vndb"}]},{"characterId":"char_vndb_c145467","characterName":"上条 当麻","sourceIds":{"vndbCharacterId":"c145467"},"originalCharacterName":"上条 当麻","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c73cab30058f12ea9f21a19fe0949cb8d07168c9684de112f2e8188b9dc772e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a78987b33921a9ae4837f251d6a8bd3d84d7e1d3e2804ec2f46d2796ebc24c1.webp","width":256,"height":144,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c42572","characterName":"御坂 美琴","sourceIds":{"vndbCharacterId":"c42572"},"originalCharacterName":"御坂 美琴","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"birthday":{"reviewState":"source-only","source":"vndb","value":"502"},"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"161"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"source-only","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mikoto is a main heroine in Toaru Majutsu no Index and the main protagonist of Toaru Kagaku no Railgun. She is the third ranked Level 5 esper in Academy City, and is nicknamed \"the Railgun\" due to her signature move. Her ability belongs to a type of esper powers known as Electromaster: those who can generate and manipulate electricity. Being the strongest Electromaster in the Academy City, her maximum output is known to be 1 billion volts."},{"spoiler":false,"text":"To most people, she is considered a 'proper lady' (referred as ojou-sama), but in reality, she's short-tempered, prideful, and has an improper attitude with some slight tomboyish tendencies and insecurities, a fact few people know of. Despite this, she is generally friendly and easygoing, and Saten and Uiharu comment on how they are shocked to find that, compared to other Level 5's, she doesn't look down on lower-level espers at all. This is probably because she was originally a level 1 esper and became a Level 5 esper through very hard work."},{"spoiler":false,"text":"Often times she shows an incredibly immature and selfish side and even slight tsundere tendencies when her crush, Touma, insults her. To add to this childishness, she has an inclination towards cute things, most specifically, Gekota and Kill Bear merchandise. She likes frog merchandise, but only if it features Gekota."},{"spoiler":false,"text":"From Toaru Majutsu no Index Wiki"}],"source":"vndb","sourceCharacterId":"c42572"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb6a9f7472fade9ad99f308822ddd0c707781a53ce4a9bc2f955b79bfae3de0e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51563e416bc1cfa36ac2ce534d5a7abab4fefdebd1932467c62a87f44cf73240.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤 利奈","creatorId":"vndb:s360","sourcePersonId":"vndb:s360","canonicalEntityId":"vndb:s360","name":"佐藤 利奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45142","source":"vndb"}]},{"characterId":"char_vndb_c42573","characterName":"白井 黒子","sourceIds":{"vndbCharacterId":"c42573"},"originalCharacterName":"白井 黒子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"152"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Age: 12-13"},{"spoiler":false,"text":"Kuroko is is a Level 4 esper and a student of Tokiwadai Middle School, as well as a member of Judgment. She can usually be found accompanying the third-ranked Level 5 esper Mikoto — her best friend, partner, and roommate. Aside from being a girl with a modernistic outlook, she can also be blunt when giving her opinions, and this has caused her to be at odds with Uiharu once. Another distinguishing characteristic of Kuroko is her feelings of romantic love towards Mikoto, which is shown to be genuine love."},{"spoiler":false,"text":"Kuroko can be described as a \"girl living in the future\". She is used to the world 30 years from now portrayed by Academy City and is ignorant to the customs that present-day Japan still practices, like the \"love umbrella\", and the conventional technology outside Academy City. Although usually laid-back and friendly, Kuroko portrays determination and confidence in her own abilities when she encounters enemies, even to those whom she knows is more powerful than herself. To her credit, she is an honorable girl who keeps her word, is kind to children, and shares with Mikoto and Touma the same ironclad sense of justice that makes neither of them ever back down in the face of adversity."},{"spoiler":false,"text":"From Toaru Majutsu no Index Wiki"}],"source":"vndb","sourceCharacterId":"c42573"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ecafc48227ca34754545a8f70d2a0f5ce553e6df64cf456093d2b4e90a0eeaaa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95c63bd73b19470b02ed1bc8230ab2fe1ff8ea79e377549b8fbd89f23a27dcde.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新井 里美","creatorId":"vndb:s1324","sourcePersonId":"vndb:s1324","canonicalEntityId":"vndb:s1324","name":"新井 里美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45146","source":"vndb"}]},{"characterId":"char_vndb_c42574","characterName":"佐天 涙子","sourceIds":{"vndbCharacterId":"c42574"},"originalCharacterName":"佐天 涙子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Age: 12-13"},{"spoiler":false,"text":"Ruiko is a character from the Toaru Kagaku no Railgun sidestories. She is a Level 0 Academy City student and a classmate and close friend of Uiharu Kaizari. Ruiko has an outgoing and friendly personality, but is a little shameless as she sometimes flips Kazari's (and only her's) skirt in public. She was born outside Academy City and when she was younger, she decided that she wanted to go to Academy City to become an esper."},{"spoiler":false,"text":"She is superstitious despite being in the city of science, though she likes to presume otherwise as when she states that she doesn't believe that her mother's good luck charm actually works. Because of this, she is a fan of internet rumors and urban legends, and loves telling her friends about them. This extends to herself, believing that her nose is sensitive to money, though she backs this up by showing Mikoto four bank cards she had already obtained."},{"spoiler":false,"text":"Saten Ruiko can be described as a normal-acting preteen in the series in comparison to her peers, not having any extracurricular activities like Judgment or being particularly book smart. She is very affable, quick to make friends, and cheerful. She knows the latest trends and fashions, and in fact has the most wardrobe changes in the series."},{"spoiler":false,"text":"From Toaru Majutsu no Index Wiki"}],"source":"vndb","sourceCharacterId":"c42574"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5bc812bb9cecbe3a1f5d358a815173b5f39816bfce5c3d97e5ccf97112f9847e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2a6eee9f244b46e1f1e55a3fc251fda947bb86860c56c125634ec0b4bd5eb12.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤 かな恵","creatorId":"vndb:s853","sourcePersonId":"vndb:s853","canonicalEntityId":"vndb:s853","name":"伊藤かな恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45145","source":"vndb"}]},{"characterId":"char_vndb_c42575","characterName":"初春 飾利","sourceIds":{"vndbCharacterId":"c42575"},"originalCharacterName":"初春 飾利","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"152"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Age: 12-13"},{"spoiler":false,"text":"Kazari is a character in Toaru Kagaku no Railgun. She is a Level 1 Academy City student, and along with her colleague and friend Shirai Kuroko, is a member of the student composed law enforcement organization, Judgment. Kazari is usually shy and humble but always friendly. She is also shown to be equally high-spirited as her friend Saten Ruiko. She admits that she is composed most of the time because of a so-called \"limit\" she places on herself. Without that limit, she is very energetic and can be airheaded at times as well."},{"spoiler":false,"text":"Moreover, she is intrigued and interested in the Ojou-sama lifestyle, as shown with her trying to impress Kuroko with her tea making abilities."},{"spoiler":false,"text":"Kazari's ability is Thermal Hand, which allows her to conserve part of the objects temperature she touches. Although she is incapable of normal combat like Kuroko, she still has a strong sense of justice, being a member of Judgment, and will do her utmost to do her duty. She is also very talented in operating computers, as she displayed the ability to easily hack into almost all of Academy City's systems. In fact, her main job in Judgment is working on the computer and use it to support the other members, such as picking up info on trouble makers. This more than makes up for her weak esper ability and lack of physical strength."},{"spoiler":false,"text":"From Toaru Majutsu no Index Wiki"}],"source":"vndb","sourceCharacterId":"c42575"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/072285304a30dbc9ac0107f63379aa57b6d3841909b4b7500ac0a82f94c7a901.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68fd4e41ca96cce99feaa4bb36c092474c923d830bd8c888c32d2b4cb049f1be.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"豊崎 愛生","creatorId":"vndb:s6857","sourcePersonId":"vndb:s6857","canonicalEntityId":"vndb:s6857","name":"豊崎 愛生","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45153","source":"vndb"}]},{"characterId":"char_vndb_c42576","characterName":"泡浮 万彬","sourceIds":{"vndbCharacterId":"c42576"},"originalCharacterName":"泡浮 万彬","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Maaya is a side character introduced in Toaru Kagaku no Railgun. She is a Level 3 Academy City esper whose ability involves the manipulation of buoyancy, and is part of the swimming team of her school along with her close friend Wannai Kinuho. She is also a classmate of Shirai Kuroko. She is often seen together with her friend, Kinuho. She is shown to be kind, and is also considerate and forgiving of other's flaws. She is also seen to be respectful towards a senpai. She also has diverse knowledge on swimsuits."},{"spoiler":false,"text":"From Toaru Majutsu no Index Wiki"}],"source":"vndb","sourceCharacterId":"c42576"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1f22b26310bc505a6317e3f7c80406f80daa870e47bcc64cdefd76eedf4dbd5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78979be51691286bdd926cffea6834b243774cd8f49caad042b9694d06e8a9fe.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南條 愛乃","creatorId":"vndb:s62","sourcePersonId":"vndb:s62","canonicalEntityId":"vndb:s62","name":"南條 愛乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45139","source":"vndb"}]},{"characterId":"char_vndb_c42577","characterName":"婚后 光子","sourceIds":{"vndbCharacterId":"c42577"},"originalCharacterName":"婚后 光子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Age: 13-14"},{"spoiler":false,"text":"Mitsuko is a minor character that appears in the Toaru Kagaku no Railgun side-stories. Being a Tokiwadai Student and Level 4 Esper, her pride often result in her getting involved in unfortunate situations which however overshadows her obviously strong abilities. She is the heiress of the Kongou Aviation Industry which was held in high regard by the aviation industry."},{"spoiler":false,"text":"She is proud of herself most of the time despite being newly transferred and possesses traits of a real ojou-sama, unlike Misaka Mikoto who is the complete opposite, because of this personality she is often at odds with Shirai Kuroko. Because of this personality however, she is completely unaware of common everyday things such as finding directions or how to use the proper tool for foodstuffs."},{"spoiler":false,"text":"She often embellishes the truth for her own convenience and will try to stretch the truth until she can no longer keep up the facade. Despite this she is an honorable and decent girl who looks out for her friends, is kind to children, and is willing to help people in need."},{"spoiler":false,"text":"From Toaru Majutsu no Index Wiki"}],"source":"vndb","sourceCharacterId":"c42577"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4dc7c338fd012acf36f9f1b21f9b6c0ea06fce3495dcf1a44253babe348fdfdd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a98c00885a575c16e137a8b5efa55a92a630ff92997433067418016c3f67df78.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"寿 美菜子","creatorId":"vndb:s5749","sourcePersonId":"vndb:s5749","canonicalEntityId":"vndb:s5749","name":"寿 美菜子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45152","source":"vndb"}]},{"characterId":"char_vndb_c42578","characterName":"湾内 絹保","sourceIds":{"vndbCharacterId":"c42578"},"originalCharacterName":"湾内 絹保","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kinuhoi s a minor character introduced in the Toaru Kagaku no Railgun sidestory. She is an Academy City esper with Level 3 Hydro Hand. She is part of the swimming team of her school, along with her close friend Awatsuki Maaya. She is also a classmate of Shirai Kuroko."},{"spoiler":false,"text":"From Toaru Majutsu no Index Wiki"}],"source":"vndb","sourceCharacterId":"c42578"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec399c7f4bac84fa7ed3d92499a3e0c3e73fd326bf9bf865d19997ad53ced9a2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/0643a5af52c8c87314e64b860a7368da19383f0ab22ebdb8b40a4e4b584df2b2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"戸松 遥","creatorId":"vndb:s5478","sourcePersonId":"vndb:s5478","canonicalEntityId":"vndb:s5478","name":"戸松 遥","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45151","source":"vndb"}]},{"characterId":"char_vndb_c42579","characterName":"固法 美偉","sourceIds":{"vndbCharacterId":"c42579"},"originalCharacterName":"固法 美偉","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mii is a recurring character in the Toaru Kagaku no Railgun side story. A high school student of Academy City, she is a Level 3 esper and is Chief of the 177th Branch of Judgment where Uiharu Kazari and Shirai Kuroko work. As their senpai (upperclassman) and chief, she tries to make sure both girls take their work at Judgment seriously and at the same time wants them to be safe. Her ability is very similar to a x-ray vision."},{"spoiler":false,"text":"Mii displays a responsible and motherly maturity rarely found in girls of her age; an attribute that earned her station of leadership in the 177th Judgement Branch and the universal respect of her juniors, to whom she is a lovingly-kind and reliable big-sister. That said, she is still a teenage girl who shows a warmly mischievous streak when at ease, and can be just as tender-hearted and vulnerable as any 16-year-old girl when it comes to matters of love"},{"spoiler":false,"text":"From Toaru Majutsu no Index Wiki"}],"source":"vndb","sourceCharacterId":"c42579"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51ba43b67295a07bc02211f67451b50cc9b3f02b841b6a7830612423a953d0b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff7dfe82a59a9594e7b2711e10d2ec39470837b420cf2567550d08c86debc26f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"植田 佳奈","creatorId":"vndb:s17","sourcePersonId":"vndb:s17","canonicalEntityId":"vndb:s17","name":"植田 佳奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45138","source":"vndb"}]},{"characterId":"char_vndb_c42580","characterName":"黄泉川 愛穂","sourceIds":{"vndbCharacterId":"c42580"},"originalCharacterName":"黄泉川 愛穂","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aiho is a character introduced in Toaru Majutsu no Index. She is a P.E. teacher at A Certain High School, and is good friend with fellow teacher, Tsukuyomi Komoe. Also a member of Anti-Skill, she cares for the well-being of children even if they are criminals, and absolutely believes that she will not use a weapon on children. She is the current legal guardian of Accelerator, Last Order, and Misaka Worst."},{"spoiler":false,"text":"She takes her job seriously, and often berates her junior, Tessou Tsuzuri if she doesn't do her job properly on patrols. Due to her habit of ramming delinquents with protective items like shield or helmets to resolve incidents, saying it's alright to do so since those are protective items, she's known as 'the woman who uses comedy-like methods to solve problems that could end up as a tragedy'."},{"spoiler":false,"text":"Out of the job, she is very cheerful, and enjoys beer, eatouts, and public baths with her friends, apparently, willing to go become pass-out drunk in public. She also enjoys teasing Komoe as if she was a child."},{"spoiler":false,"text":"From Toaru Majutsu no Index Wiki"}],"source":"vndb","sourceCharacterId":"c42580"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af54b994da66c6a950e52a5f369c7260340c65a4bd07c7825679c2a4b3b902eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19669f7129940ce8b61decbcc9b848c76d21cf4ee60616561d9c07868508474a.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"甲斐田 裕子","creatorId":"vndb:s3825","sourcePersonId":"vndb:s3825","canonicalEntityId":"vndb:s3825","name":"甲斐田裕子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45150","source":"vndb"}]},{"characterId":"char_vndb_c42581","characterName":"硲舎 佳茄","sourceIds":{"vndbCharacterId":"c42581"},"originalCharacterName":"硲舎 佳茄","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kana, originally referred to as the Bag Girl due to her first appearance, is a character introduced in Toaru Kagaku no Railgun. She has a cheerful and polite disposition. Although, as natural to that of a child, becomes quite tearful when faced with a difficult situation, like losing that bag of hers."},{"spoiler":false,"text":"Kana appears during the game's talking bits."}],"source":"vndb","sourceCharacterId":"c42581"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd73dd6c6a32b7aa9e2f2e0f8e1694ac83f40058722ab6893120ad8e5875235d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c01b91eb62817596d1170866bf6e43648eba135f362a4074c9aa42a75eb6d74.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹達 彩奈","creatorId":"vndb:s1767","sourcePersonId":"vndb:s1767","canonicalEntityId":"vndb:s1767","name":"竹達 彩奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45148","source":"vndb"}]},{"characterId":"char_vndb_c85185","characterName":"実生 好子","sourceIds":{"vndbCharacterId":"c85185"},"originalCharacterName":"実生 好子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/372a913dfffb9b47aa11d4422d30fa466d732011a497e678c8989e29361ce067.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/795b8c11c8c59e4987f9322d7068043d2df3eee6d7ab9c1bb4fb6a09b8bffcec.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"豊口 めぐみ","creatorId":"vndb:s614","sourcePersonId":"vndb:s614","canonicalEntityId":"vndb:s614","name":"豊口 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45143","source":"vndb"}]},{"characterId":"char_vndb_c85186","characterName":"一澤 暁子","sourceIds":{"vndbCharacterId":"c85186"},"originalCharac