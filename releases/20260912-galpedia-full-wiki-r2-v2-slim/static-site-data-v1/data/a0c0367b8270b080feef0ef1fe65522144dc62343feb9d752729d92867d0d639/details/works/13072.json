b"},{"creditedName":"RUNA","creatorId":"vndb:s3057","sourcePersonId":"vndb:s3057","canonicalEntityId":"vndb:s3057","name":"SATOMI","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:38507","source":"vndb"}]},"cast":[{"characterId":"char_c52195","characterName":"ミリオム","sourceIds":{"bangumi":[{"characterId":"59012","match":"exact-normalized-name-in-linked-work","subjectId":"218156"}],"egsCharacterIds":["14389"],"vndbCharacterId":"c52195"},"originalCharacterName":"ミリオム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【シリーズ最強にプリティなメインヒロイン】"},{"spoiler":false,"text":"すっかり一人前の悪魔となったいまでも、どんくさく、すぐに泣く。"},{"spoiler":false,"text":"自分を助けてくれた主人公のことを心から愛している。"},{"spoiler":false,"text":"ヨーグルトや、なれ鮨などの乳酸菌食品を食べると酔っぱらう。"}],"source":"egs","sourceCharacterId":"14389","sourceWorkId":"13072","spoiler":false},{"segments":[{"spoiler":false,"text":"生来の気の弱さと優しさのせいで、悪いことが全くできない新米悪魔。リリムから一人前の悪魔になるべく、大魔王アザゼルの命を受け人間界に来るも、空腹で倒れる。行き倒れのところを主人公に拾われ、何かにつけて自分を大事にしてくれる姿に一遍で恋に落ちてしまう。料理はてんでダメで、得意なものは冷凍食品の解凍。牙があるのを気にしていて、からかわれると泣き出す。"}],"source":"bangumi","sourceCharacterId":"59012"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3db53e65468d35d9a8d093ecb8add20e29f894d29e28dde2b5eba5bcd7f8a50d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d7f2767a580703a292965c28b97e4424da7c4379e23ebf912c18e2d53ab1fe7.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218156:59012:4830:1","source":"bangumi"}]},{"characterId":"char_c52197","characterName":"アマリン","sourceIds":{"bangumi":[{"characterId":"136783","match":"exact-normalized-name-in-linked-work","subjectId":"218156"}],"egsCharacterIds":["14391"],"vndbCharacterId":"c52197"},"originalCharacterName":"アマリン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【隣に越してきた少女】"},{"spoiler":false,"text":"主人公の隣の部屋に引っ越してきた少女だが、正体はやはり魔界からやってきたサキュバス。"},{"spoiler":false,"text":"口数は少なく、気がつくと黙って主人公のことを見ているので驚かされる。"},{"spoiler":false,"text":"主食はケーキでおかずがアイスクリームという大の甘い物好き。"},{"spoiler":false,"text":"天然なのか狙っているのか解らないところがある。"}],"source":"egs","sourceCharacterId":"14391","sourceWorkId":"13072","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の隣の部屋に引っ越してきた少女だが、正体はやはり魔界からやってきたサキュバス。 口数は少なく、気がつくと黙って主人公のことを見ているので驚かされる。 主食はケーキでおかずがアイスクリームという大の甘い物好き。 天然なのか狙っているのか解らないところがある。"}],"source":"bangumi","sourceCharacterId":"136783"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b53768f6f3569d4ea65d127bad6785cf4919500b784fb74e5a2d06def75305a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/4399501121adfc57ed645d3ed80e69eacf137f7b204fb6c53777c9c3df9692e4.webp","width":256,"height":178,"source":"static-detail"},"actors":[{"creditedName":"儀武ゆう子","creatorId":"vndb:s263","sourcePersonId":"vndb:s263","canonicalEntityId":"vndb:s263","name":"儀武 ゆう子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218156:136783:4744:1","source":"bangumi"}]},{"characterId":"char_c52198","characterName":"道後 梨露","sourceIds":{"bangumi":[{"characterId":"136782","match":"exact-normalized-name-in-linked-work","subjectId":"218156"}],"egsCharacterIds":["14390"],"vndbCharacterId":"c52198"},"originalCharacterName":"道後 梨露","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【創太のクラスへの転校生】"},{"spoiler":false,"text":"主人公のクラスへの転校生だが、正体は魔界からやってきたサキュバス。"},{"spoiler":false,"text":"本名はリロキ。"},{"spoiler":false,"text":"性格は割とがさつであるが、主人公以外の前では大人しく上品なふりをしている。"},{"spoiler":false,"text":"主人公に対しちょっかいを出すが、倍返しをいつも食らってしまう。"},{"spoiler":false,"text":"好きなものは唐揚げ棒。嫌いなものは辛い物。"}],"source":"egs","sourceCharacterId":"14390","sourceWorkId":"13072","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスへの転校生だが、正体は魔界からやってきたサキュバス。本名はリロキ。 性格は割とがさつであるが、主人公以外の前では大人しく上品なふりをしている。主人公に対しちょっかいを出すが、倍返しをいつも食らってしまう。 好きなものは唐揚げ棒。嫌いなものは辛い物。"}],"source":"bangumi","sourceCharacterId":"136782"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7a78ba36ab8be9f9dd48d61da9e42c054f95a2bce488deb3e5d7b32d0c7d5f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a91380b560a0baac8d6971663d7ce467b1449d7046f00bd34b60bee2ea336887.webp","width":256,"height":178,"source":"static-detail"},"actors":[{"creditedName":"衣央理 全","creatorId":"vndb:s2988","sourcePersonId":"vndb:s2988","canonicalEntityId":"vndb:s2988","name":"衣央里 全","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20797","source":"vndb"}]},{"characterId":"char_vndb_c118799","characterName":"和倉 創太","sourceIds":{"vndbChar