）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"11974","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"11974","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"11974","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"50 kg","valueContext":null,"source":"egs","sourceCharacterId":"11974","sourceWorkId":"13845","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b591830fa81ad8f0686ba6049201cecc10f5882b676272679c9d60682c26ea7b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d15434ebb4c5f57723851e0f28be5ce4e80aec7911879a649397dab07d12ce0.webp","width":256,"height":251,"source":"static-detail"},"actors":[{"creditedName":"茅原実里","creatorId":"vndb:s1459","sourcePersonId":"vndb:s1459","canonicalEntityId":"vndb:s1459","name":"茅原 実里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14529:13360:4421:1","source":"bangumi"}]},{"characterId":"char_c72791","characterName":"プラウラ","sourceIds":{"bangumi":[],"egsCharacterIds":["11978"],"vndbCharacterId":"c72791"},"originalCharacterName":"プラウラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公カルの幼少期から、身の回りの世話を勤める女従者のひとり。"},{"spoiler":false,"text":"ルスラン王国重臣の娘。"},{"spoiler":false,"text":"長い睫、聡明そうなまなざし。スラリとしたモデルのような痩身。"},{"spoiler":false,"text":"抜群の美貌とスタイル。人当たりがよく、おまけに料理上手。"},{"spoiler":false,"text":"さらには表面的な性格も良い。……が美しい外見と裏腹に、その内実は腹黒な謀略家。"},{"spoiler":false,"text":"主人カルへの究極的な忠誠心を除いては、世の中のあらゆるモラルから開放されたモンスター。"},{"spoiler":false,"text":"主家ルスランのお家再興のためには、人倫に外れた汚れ仕事に手を染めることも厭わない。"},{"spoiler":false,"text":"同僚のファルツ同様、Ｅウェポンを用いた武技に精通しているが、なかでも射撃が得意。"}],"source":"egs","sourceCharacterId":"11978","sourceWorkId":"13845","spoiler":false}],"profileFacts":[{"label":"年龄（本版本）","value":"19 岁","valueContext":null,"source":"egs","sourceCharacterId":"11978","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"11978","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"11978","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"11978","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"11978","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"47 kg","valueContext":null,"source":"egs","sourceCharacterId":"11978","sourceWorkId":"13845","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbf7a160e75cd669ee38aa159db522d47b8ac73c4fbc9a56494493e835e23f99.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55c6ad4df066058571155e724560f9ca1c0884ef559560a476d42f4aa113e634.webp","width":150,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神田 朱未","creatorId":"vndb:s1666","sourcePersonId":"vndb:s1666","canonicalEntityId":"vndb:s1666","name":"神田 朱未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26140","source":"vndb"}]},{"characterId":"char_c72792","characterName":"ガラクシア","sourceIds":{"bangumi":[],"egsCharacterIds":["11977"],"vndbCharacterI