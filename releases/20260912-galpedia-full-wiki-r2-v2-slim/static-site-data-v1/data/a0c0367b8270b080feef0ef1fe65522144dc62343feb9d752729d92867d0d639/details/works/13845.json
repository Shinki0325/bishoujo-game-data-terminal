r":false,"text":"融通の利かない生真面目屋ながら、基本的には明るく素直な性格。物腰も礼儀正しい。"},{"spoiler":false,"text":"社会的に差別されがちなパーセプターの権利獲得のため功を焦っているところがある。"},{"spoiler":false,"text":"その気負いと若年ゆえの経験不足から、要らぬ失敗を重ねることも。"},{"spoiler":false,"text":"帝都の治安を脅かす“汚染者”に単独で対抗し得る存在であり、他の隊員たちとも一線を画した強大な能力を持つ。"}],"source":"egs","sourceCharacterId":"11976","sourceWorkId":"13845","spoiler":false}],"profileFacts":[{"label":"年龄（本版本）","value":"14 岁","valueContext":null,"source":"egs","sourceCharacterId":"11976","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"11976","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"11976","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"11976","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"11976","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"50 kg","valueContext":null,"source":"egs","sourceCharacterId":"11976","sourceWorkId":"13845","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8deedf53d09192bdc8416f4160cfae263039d6775f81a5785384f85ae0055e3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fc6c9df7e339e769a82d4f4a791d8bed49847b496fb25540922e0e24b0c9b3b.webp","width":167,"height":256,"source":"static-detail"},"actors":[{"creditedName":"福井 裕佳梨","creatorId":"vndb:s10439","sourcePersonId":"vndb:s10439","canonicalEntityId":"vndb:s10439","name":"福井 裕佳梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26142","source":"vndb"}]},{"characterId":"char_c76236","characterName":"トアラ・ラボアキン","sourceIds":{"bangumi":[],"egsCharacterIds":["11980"],"vndbCharacterId":"c76236"},"originalCharacterName":"トアラ・ラボアキン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"フルクラム帝国支配圏にある小王国から、帝国ジュニアアカデミーに留学してきた王族の少年。第二学年所属。"},{"spoiler":false,"text":"小柄な体つきのため、実際の年より幼くみられることが多い。"},{"spoiler":false,"text":"帝国到着早々、留学初日にＥテクノロジー絡みのテロ事件に巻き込まれ、それが縁でカルと知り合う。以後、なにかにつけ彼女と行動をともにすることに。"},{"spoiler":false,"text":"性格は素直で純朴。田舎者で世間知らずな反面、存続の危機に立たされるほどの深刻な財政難に苦しむ貧乏小国の出身のためか、芯はかなり強く、知恵も回る。"},{"spoiler":false,"text":"真っ正直で、物の裏の読むことが苦手なカルの知恵袋的なポジション。"},{"spoiler":false,"text":"また学年成績トップクラスの知能を活かし、アカデミーで試験があるたびに、彼女の臨時家庭教師を務めている。"}],"source":"egs","sourceCharacterId":"11980","sourceWorkId":"13845","spoiler":false}],"profileFacts":[{"label":"年龄（本版本）","value":"13 岁","valueContext":null,"source":"egs","sourceCharacterId":"11980","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"149 cm","valueContext":null,"source":"egs","sourceCharacterId":"11980","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"41 kg","valueContext":null,"source":"egs","sourceCharacterId":"11980","sourceWorkId":"13845","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e97aff44fc710dbb13cb12a6db53202d600e69f8a9b956e214f676be8d408e51.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c2dc8f04bc412a33ba8eb0c9188a4cfb8dcbece15cbce9cc2a8774e71d6ae8f.webp","width":127,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永 朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"s