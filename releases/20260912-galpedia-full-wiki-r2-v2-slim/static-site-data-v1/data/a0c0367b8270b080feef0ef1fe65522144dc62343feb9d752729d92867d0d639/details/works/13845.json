CharacterName":"エリンシエ・ヤースロップ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"143"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"帝国ジュニアアカデミー第一学年所属。"},{"spoiler":false,"text":"空中王国ネオスフィアからの留学生。元ネオスフィアの女王。"},{"spoiler":false,"text":"現在は女王位から退き、帝国の先進技術や文化を学びにはるばる帝都までやってきた。"},{"spoiler":false,"text":"しかしそれは表向きであり、さる事件がもとで帝国に政治的に睨まれたネオスフィア王国が、恭順の意を示すため差し出した実質的な人質である。"},{"spoiler":false,"text":"女王位を退いて今なお、その言動は国外政治に与える影響が小さくなく、そのため行動は常に帝国政府の監視下に置かれている。"},{"spoiler":false,"text":"女王時代は英明の名をほしいままにした天才君主だったが、帝都に来てからは、年相応の子供っぽいきかんきな言動や、とっぴな行動が目立つ。"},{"spoiler":false,"text":"また反帝国的な態度を隠そうともしないため、帝国人の生徒と衝突することも多い。"},{"spoiler":false,"text":"その一方で、元女王という特殊な経歴、異様に高い知能指数、周囲に媚びない様子に共感を覚えた男子生徒たちに間で隠れファンクラブが結成されている。"}],"source":"egs","sourceCharacterId":"11975","sourceWorkId":"13845","spoiler":false}],"profileFacts":[{"label":"年龄（本版本）","value":"11 岁","valueContext":null,"source":"egs","sourceCharacterId":"11975","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"11975","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"11975","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"11975","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"11975","sourceWorkId":"13845","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"50 kg","valueContext":null,"source":"egs","sourceCharacterId":"11975","sourceWorkId":"13845","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"