l,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1118"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A sniper from the SORD unit based at St. Aile’s International, sister school to Mihama Academy."},{"spoiler":false,"text":"It’s said that once she has you in her sights, there’s no escape - hence her nickname, “Mystic Eye”. Her main weapon is a Blaser R93."},{"spoiler":false,"text":"Gumi behaves like an old-school war veteran, and tends to adopt a ludicrously single-minded approach to her duties. Burning with a powerful sense of justice, Gumi takes a hard line against unscrupulous behavior; the harshness of her rebukes can come as quite a shock."},{"spoiler":false,"text":"Her special skill is speed eating, and she won’t be beaten in this by anyone."},{"spoiler":false,"text":"\"Sorry, senpai. There's still something I need to do - one task I have to complete.\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c62418"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a27cc28a6d01148bbc9f150ca76412fbf697a54f71c55a544e245477a0d1504.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/9061433466960d92af3dcbd46029aa318443ffc8faa5d306316f82496f10d435.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三森 すずこ","creatorId":"vndb:s627","sourcePersonId":"vndb:s627","canonicalEntityId":"vndb:s627","name":"三森 すずこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84307","source":"vndb"}]},{"characterId":"char_vndb_c62419","characterName":"シルビア","sourceIds":{"vndbCharacterId":"c62419"},"originalCharacterName":"シルビア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Members of St. Aile’s SORD team. Sylvie and Vel are third years, and therefore upperclassmen to Gumi and the others; as older students, they are allowed to wear nuns' habits instead of regular uniforms. They work as a pair during missions."},{"spoiler":false,"text":"\"Do I really look like a 'sly vixen' to you?\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c62419"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3fce9183ebd68ea808b171ddf514fe372ce089de58528480d799caf380c023c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85359720df376fcac7904f562091a131532c8b7bd816b33953d8296a323b8c0d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長妻 樹里","creatorId":"vndb:s1197","sourcePersonId":"vndb:s1197","canonicalEntityId":"vndb:s1197","name":"長妻 樹里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84309","source":"vndb"}]},{"characterId":"char_vndb_c62420","characterName":"ベルベット","sourceIds":{"vndbCharacterId":"c62420"},"originalCharacterName":"ベルベット","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Members of St. Aile’s SORD team. Sylvie and Vel are third years, and therefore upperclassmen to Gumi and the others; as older students, they are allowed to wear nuns' habits instead of regular uniforms. They work as a pair during missions."},{"spoiler":false,"text":"\"Hey there, terrorist scum! You makin' sure to 'love thy neighbor'?\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c62420"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/ddb249498be22d462ece9483bf9226d4d98ff925e458b07850848aed18a0ae6f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82b37dac63d99fec9b0ea800279044f57245c6f5f15507905f093a7eccacdea4.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小見川 千明","creatorId":"vndb:s8797","sourcePersonId":"vndb:s8797","canonicalEntityId":"vndb:s8797","name":"小見川 千明","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84320","source":"vndb"}]},{"characterId":"char_vndb_c66510","characterName":"仙石 大雅","sourceIds":{"vndbCharacterId":"c66510"},"originalCharacterName":"仙石 大雅","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"729"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"67"},"hip":{"reviewState":"source-only","source":"vndb","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"First cousin to Sengoku Ichiru, and an elementary student in Mihama Academy’s sapper school. Taiga’s always lived a pampered life, having grown up as heiress to the Sengoku estate. She’s a quick-witted and intelligent girl, as evidenced by the fact that she’s already passed her university entrance exams."},{"spoiler":false,"text":"With all the expectations heaped on her, it’s only natural that Taiga should come across as a little arrogant. This is one of the reasons why she tends to keep her distance from other people - though she’s quite happy on her own. Rena calls her “The Milquik Master”, following a serendipitous encounter back when she first arrived at Mihama."},{"spoiler":false,"text":"Taiga is intent on participating in activities that are usually closed to children of her stature; she cares little for age restrictions, nor other people’s opinions of her. Eventually her persistence pays off, when Haruto finally heeds her request to join Class A."},{"spoiler":false,"text":"\"Kujirase... Where am I to be allowed out into the field?\""},{"spoiler":false,"text":"From the official site"}],"source":"vndb","sourceCharacterId":"c66510"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2bad3a50b2218cd8f41666d81eb4c23ceeab51d6af36cff7125f6e4bb6220be.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/898762bc520a3ce3bf8961511fd30153c15600096ee272fa1520e1b418668184.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高森 奈津美","creatorId":"vndb:s979","sourcePersonId":"vndb:s979","canonicalEntityId":"vndb:s979","name":"高森 奈津美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84308","source":"vndb"}]},{"characterId":"char_vndb_c71600","characterName":"狗駒 悠希","sourceIds":{"vndbCharacterId":"c71600"},"originalCharacterName":"狗駒 悠希","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1101"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"100"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"I"},"hip":{"reviewState":"source-only","source":"vndb","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Murasaki's older sister, and a Ninja Master of the same rank. She returns to Mihama after having been away to work abroad for an extended period of time."},{"spoiler":false,"text":"While she has many acquaintances of all shapes and sizes, she doesn't appear to have anybody she can call a true friend. A cheerful girl with a mischievous side, she stands out due to her carefree behavior. She openly expresses her affection, which makes her come off as a bit easy, but this is merely a façade to hide her true nature."},{"spoiler":false,"text":"Her weapons of choice are a suppressor-equipped Bulgarian Makarov and a Kalashnikov (AKS-74U)."},{"spoiler":false,"text":"\"Jeez! How can you spew such lies without battin' an eyelid?!\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c71600"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3186e2c056bfc914ba7e373790066137b13cb9fbd77bd53c2c2adcac3dd60ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91642dd1fa16d15888d217e3f3e66676d7432611ae8fa08a7c01701c522c97b2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐々木 未来","creatorId":"vndb:s3660","sourcePersonId":"vndb:s3660","canonicalEntityId":"vndb:s3660","name":"佐々木 未来","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84314","source":"vndb"}]},{"characterId":"char_vndb_c82644","characterName":"漆原 縁","sourceIds":{"vndbCharacterId":"c82644"},"originalCharacterName":"漆原 縁","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A former member of the Phantom Triggers, the organization that evolved into SORD, who doubled as the team's instructor and handler."},{"spoiler":false,"text":"His main job was to teach his students the skills they needed to prevent them from being killed in action. While he's normally a calm and collected thinker, it is rumored that he's seriously scary on the battlefield."},{"spoiler":false,"text":"He never bragged about his accomplishments on the field, though he could be quite talkative when he was off the clock."},{"spoiler":false,"text":"As the only responsible adult on the team, he is the only father figure that Haruto has ever had."},{"spoiler":false,"text":"\"Aoi-kun, this isn't a game. Get a move on and wrap things up. There's no need to go all out on a simple job like this.\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c82644"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05152df6bbdf0bdaacf8bd84e14056e925b14b9e8124e6e68a7441231bcadd59.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27c480494acc144545bd31c90c5d08b14f91a971a0c9c4e6ce2e3e8a61add021.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浜田 賢二","creatorId":"vndb:s385","sourcePersonId":"vndb:s385","canonicalEntityId":"vndb:s385","name":"浜田 賢二","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84305","source":"vndb"}]},{"characterId":"char_vndb_c82645","characterName":"鮫島 黒江","sourceIds":{"vndbCharacterId":"c82645"},"originalCharacterName":"鮫島 黒江","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kuroe was a reserve student at Mihama Academy's CIRS division, also known as the \"Phantom Triggers\" back in the day. She also acted as Enishi's personal bodyguard and secretary. While she is a Hollow graduate from the same dangerous generation as Aoi, the clever and quiet Kuroe is classified as a \"downer\" type."},{"spoiler":false,"text":"She's extremely loyal to her master Enishi, and doesn't have much interest in anything else."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c82645"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9ac9e2d3cfdfe2e668bfadc57fdfc71840e2b8fef8a66c5cc17e0b9d8dcbc146.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/66a23d7779e2c884eff8fe85f4452d487f9fb1fd38a00b1df553ba6e7e74a3c7.webp","width":166,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加隈 亜衣","creatorId":"vndb:s603","sourcePersonId":"vndb:s603","canonicalEntityId":"vndb:s603","name":"加隈 亜衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84306","source":"vndb"}]},{"characterId":"char_vndb_c91917","characterName":"仙石 綾芽","sourceIds":{"vndbCharacterId":"c91917"},"originalCharacterName":"仙石 綾芽","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ichiru's younger brother, and the eldest son of the Sengoku family. Though a handler at St. Aile's, in charge of Sylvia and Velvet, he's also a complete recluse; he hardly shows his face in public."},{"spoiler":false,"text":"Even more outspoken than his sister, he usually comes across as haughty or just plain rude."},{"spoiler":false,"text":"\"And who the hell are you, anyway? Tell me your name, and you can be damn sure I won't forget it. How about that?\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c91917"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/facaa4d62b59b8c839b121ef0fafcc9710cf84bf4912c2535158d5152db940e3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72a22c60e82d8cd267be1a6707688e7fbc0e8c29926bbedc09298a6b04742626.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林 直人","creatorId":"vndb:s1093","sourcePersonId":"vndb:s1093","canonicalEntityId":"vndb:s1093","name":"水樹空","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84326","source":"vndb"}]},{"characterId":"char_vndb_c91947","characterName":"Murakami Caitlin","sourceIds":{"vndbCharacterId":"c91947"},"originalCharacterName":"Murakami Caitlin","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/bec6a8bc6bcbb449eb36c180cb6fb251254816d52b56a1984ea4f4463fe5a221.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48a2ced1863cba206b557cdec3823594a1831ddd51f3752f00c75000db84565f.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName