b"},{"creditedName":"いけだかなめ。","creatorId":"vndb:s5133","sourcePersonId":"vndb:s5133","canonicalEntityId":"vndb:s5133","name":"いけだかなめ。","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:152597","source":"vndb"},{"creditedName":"花摘 藍","creatorId":"vndb:s18377","sourcePersonId":"vndb:s18377","canonicalEntityId":"vndb:s18377","name":"花摘 藍","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:152603","source":"vndb"},{"creditedName":"花摘 藍","creatorId":"vndb:s18377","sourcePersonId":"vndb:s18377","canonicalEntityId":"vndb:s18377","name":"花摘 藍","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:152604","source":"vndb"}]},"cast":[{"characterId":"char_c76296","characterName":"桜木 いろは","sourceIds":{"bangumi":[{"characterId":"67064","match":"exact-normalized-name-in-linked-work","subjectId":"262373"}],"egsCharacterIds":["20522"],"vndbCharacterId":"c76296"},"originalCharacterName":"桜木 いろは","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"19"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Iroha is a brand new voice actress still in college who has just started her employment with Cuckoo Clock."},{"spoiler":false,"text":"During her high school years she passed an audition to become a scholarship student at a major voice acting agency, so there are high hopes for her future. She became interested in voicing erotic games after playing them herself. When searching for an agency that would help her become a voice actress for erotic games, she discovered Cuckoo Clock and showed great initiative by meeting directly with Midori and securing her contract."},{"spoiler":false,"text":"As expected from a promising student from a training school, she can perform any character flawlessly. Since she only attended all-girls schools, she hasn’t experienced romance before, and doesn’t understand how couples normally behave, but she’s trying to overcome that hurdle with her strong desire for improvement."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c76296"},{"segments":[{"spoiler":false,"text":"「クックークロック」に仮所属する現役女子大生新人声優。"},{"spoiler":false,"text":"高校生時代、特待生オーディションに合格して大手声優養成所に入り、将来を嘱望されていた。"},{"spoiler":false,"text":"エロゲーをプレイしてエロゲー声優に興味を持つ。"},{"spoiler":false,"text":"エロゲー声優になれる事務所を探していたときに「クックークロック」を見つけ、美鳥に直談判して契約を取り付けた行動派。"},{"spoiler":false,"text":"養成所の特待生だっただけあり、どんなキャラも演技もそつなくこなす。"},{"spoiler":false,"text":"ずっと女子校で恋愛経験も無く、男女のやり取りがわからずにいるが、持ち前の強い向上心で克服しようとしている。"}],"source":"egs","sourceCharacterId":"20522","sourceWorkId":"27292","spoiler":false},{"segments":[{"spoiler":false,"text":"「クックークロック」に仮所属する現役女子大生新人声優。"},{"spoiler":false,"text":"高校生時代、特待生オーディションに合格して大手声優事務所に入り、"},{"spoiler":false,"text":"将来を渇望されていた。エロゲーをプレイしてエロゲー声優に興味を持つ。"},{"spoiler":false,"text":"エロゲー声優になれる事務所を探していたときに「クック―クロック」を見つけ、"},{"spoiler":false,"text":"美鳥に直談判して契約を取り付けた行動派。"},{"spoiler":false,"text":"養成所の特待生だっただけあり、どんなキャラも演技もそつなくこなす。"},{"spoiler":false,"text":"ずっと女子校で恋愛経験も無く、男女のやり取りがわからずにいるが、"},{"spoiler":false,"text":"持ち前の強い向上心で克服しようとしている。"}],"source":"bangumi","sourceCharacterId":"67064"}],"profileFacts":[{"label":"年龄（本版本）","value":"19 岁","valueContext":null,"source":"egs","sourceCharacterId":"20522","sourceWorkId":"27292","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"20522","sourceWorkId":"27292","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc66db3e8ffda4bca6c7844bd1540fa730b04818cdb4c72e782c49915d7bc02b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc97cb9d480dbcf3b5b288fce6726b0446cff5c4048a2c1314a2078fb2d322fe.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井菜々絵","creatorId":"vndb:s6525","sourcePersonId":"vndb:s6525","canonicalEntityId":"vndb:s6525","name":"櫻井 菜々絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:262373:67064:19126:1","source":"bangumi"}]},{"characterId":"char_c76297","characterName":"森永 精華","sourceIds":{"bangumi":[{"characterId":"67065","match":"exact-normalized-name-in-linked-work","subjectId":"262373"}],"egsCharacterIds":["20523"],"vndbCharacterId":"c76297"},"originalCharacterName":"森永 精華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"28"},"height":{"reviewState":"no-conflict","source":"vndb","value":"139"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Seika is a voice actress employed by Cuckoo Clock."},{"spoiler":false,"text":"While she looks like she should be a young student, she’s a fully grown woman. She already has a long career as a voice actress, and is considered a veteran in the field. She brings strong name recognition to the products she works on, and holds a solid share of the market for loli characters in erotic games."},{"spoiler":false,"text":"While she’s become typecast into loli character roles, she has the talent to perform a variety of different characters as well. Outside of the company she responds to people with her cute persona and her business smile, but with her coworkers she’s a caring, reliable senior, much like her boss. However, she works the main protagonist like an oppressive tyrant."},{"spoiler":false,"text":"She takes great pride in her work as a voice actress, and is very professional about it."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c76297"},{"segments":[{"spoiler":false,"text":"「クック―クロック」所属の声優。"},{"spoiler":false,"text":"低年齢学生にしか見えない容姿だが、歴とした大人の女性。"},{"spoiler":false,"text":"声優歴は長く、ベテランの域。"},{"spoiler":false,"text":"それなりにネームバリューもあり、エロゲーのロリキャラに一定のシェアを持つ。"},{"spoiler":false,"text":"ロリキャラ専門声優のようになっているが、本来はさまざまな役を演じ分ける実力派。"},{"spoiler":false,"text":"社外に向けては営業スマイルと可愛いキャラで応対し、社内では社長に次ぐ年長者として良いお姉さん。"},{"spoiler":false,"text":"しかし主人公に対しては横暴な暴君としてこき使う。"},{"spoiler":false,"text":"声優の仕事にプライドを持ち、プロ意識が高い。"}],"source":"egs","sourceCharacterId":"20523","sourceWorkId":"27292","spoiler":false},{"segments":[{"spoiler":false,"text":"「クック―クロック」所属の声優。"},{"spoiler":false,"text":"低年齢学生にしか見えない容姿だが、歴とした大人の女性。"},{"spoiler":false,"text":"声優歴は長く、ベテランの域。それなりにネームバリューもあり、"},{"spoiler":false,"text":"エロゲーのロリキャラに一定のシェアを持つ。"},{"spoiler":false,"text":"ロリキャラ専門声優のようになっているが、"},{"spoiler":false,"text":"本来はさまざまな役を演じ分ける実力派。"},{"spoiler":false,"text":"社外に向けては営業スマイルと可愛いキャラで対応し、"},{"spoiler":false,"text":"社内では社長に次ぐ年長者として良いお姉さん。"},{"spoiler":false,"text":"しかし主人公に対しては横暴な暴君としてこき使う。"},{"spoiler":false,"text":"声優の仕事にプライドを持ち、プロ意識が高い。"}],"source":"bangumi","sourceCharacterId":"67065"}],"profileFacts":[{"label":"年龄（本版本）","value":"28 岁","valueContext":null,"source":"egs","sourceCharacterId":"20523","sourceWorkId":"27292","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"139 cm","valueContext":null,"source":"egs","sourceCharacterId":"20523","sourceWorkId":"27292","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c83944396033045df0a41460abd8143c4f1df34c2a7d0e6e38266fc1d259467.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a781f5cacc6ba4c066390c3be8c68add6d1b5051c0024018b1b21f9276d3ff03.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:262373:67065:4830:1","source":"bangumi"}]},{"characterId":"char_c76298","characterName":"武者 蓮美","sourceIds":{"bangumi":[{"characterId":"67066","match":"exact-normalized-name-in-linked-work","subjectId":"262373"}],"egsCharacterIds":["20524"],"vndbCharacterId":"c76298"},"originalCharacterName":"武者 蓮美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"25"},"height":{"reviewState":"no-conflict","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hasumi is the recording engineer for Cuckoo Clock’s in-house studio."},{"spoiler":false,"text":"The way she acts due to her height makes her seem demure, and her quiet nature also makes her come off as melancholy. Once she arrives at work, she holes up in the studio and rarely ever comes out. Though she’s capable of handling all the studio work by herself, she’s extremely shy and struggles to communicate properly, only just barely managing to hold normal conversations with her coworkers."},{"spoiler":false,"text":"As a recording engineer she’s a perfectionist, and she’s both diligent and intense about her work. She’s also so incredibly talented that can handle cutting the audio in real time while recording."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c76298"},{"segments":[{"spoiler":false,"text":"「クックークロック」自社スタジオの録音エンジニア。"},{"spoiler":false,"text":"挙動がその長身もあってかおっとりとして見え、寡黙なことも手伝って陰キャ感が強い。"},{"spoiler":false,"text":"実際、出社するとスタジオから出てこないスタジオ引き籠もり。"},{"spoiler":false,"text":"一人でスタジオ業務をこなすが、人見知りが激しく、コミュニケーション能力を欠いている。"},{"spoiler":false,"text":"辛うじて、社内の人間とは普通にコミュニケーションが取れる。"},{"spoiler":false,"text":"録音エンジニアとしては、真面目で仕事に厳しく、完璧主義。"},{"spoiler":false,"text":"収録しながらリアルタイムに音声のカッティングをする凄腕の持ち主。"}],"source":"egs","sourceCharacterId":"20524","sourceWorkId":"27292","spoiler":false},{"segments":[{"spoiler":false,"text":"「クック―クロック」自社スタジオの録音エンジニア。"},{"spoiler":false,"text":"挙動がその身長もあってかおっとりして見え、"},{"spoiler":false,"text":"寡黙なことも手伝って陰キャ感が強い。"},{"spoiler":false,"text":"実際、出社するとスタジオから出てこないスタジオ引き籠もり。"},{"spoiler":false,"text":"一人でスタジオ業務をこなすが、人見知りが激しく、"},{"spoiler":false,"text":"コミュニケーション能力を欠いている。"},{"spoiler":false,"text":"辛うじて、社内の人間とは普通にコミュニケーションが取れる。"},{"spoiler":false,"text":"録音エンジニアとしては、真面目で仕事に激しく、完璧主義。"},{"spoiler":false,"text":"収録しながらリアルタイムに音声のカッティングをする凄腕の持ち主。"}],"source":"bangumi","sourceCharacterId":"67066"}],"profileFacts":[{"label":"年龄（本版本）","value":"25 岁","valueContext":null,"source":"egs","sourceCharacterId":"20524","sourceWorkId":"27292","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"175 cm","valueContext":null,"source":"egs","sourceCharacterId":"20524","sourceWorkId":"27292","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51073ae530e6bdeeefdf61a16a6d3d97baeda48e77b4149d8e75b573f5431b09.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0aaf16d10613251a931ecf64a9897538bb4c2a1b7aae92f29f11e839f8a1cc4f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:262373:67066:4937:1","source":"bangumi"}]},{"characterId":"char_c76299","characterName":"吉備 桃子","sourceIds":{"bangumi":[{"characterId":"67067","match":"exact-normalized-name-in-linked-work","subjectId":"262373"}],"egsCharacterIds":["20525"],"vndbCharacterId":"c76299"},"originalCharacterName":"吉備 桃子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"24"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Touko works as a manager at Cuckoo Clock."},{"spoiler":false,"text":"She’s a hardworking woman who’s handled managing both their actresses and their general business affairs by herself. While she seems like an intellectual at first glance, she’s actually a free-spirited, clumsy sportswoman. She spends a lot of time on sales and accompanying the agency’s voice actresses in order to secure good work for them as their manager."},{"spoiler":false,"text":"She’s the type to plunge headlong into things that strike her interest, and she’s brimming with curiosity. She takes good care of the protagonist, but he often has to help her clean up after her clumsy mistakes too."},{"spoiler":false,"text":"Edited from MangaGamer"}],"source":"vndb","sourceCharacterId":"c76299"},{"segments":[{"spoiler":false,"text":"「クックークロック」に勤めるマネージャー。"},{"spoiler":false,"text":"社内の事務とマネージャー業務を一人で切り盛りする働き者。"},{"spoiler":false,"text":"一見知性的だが、中身は自由奔放で体育会系なドジっ子。"},{"spoiler":false,"text":"マネージャーとして、事務所に所属する声優達が活躍し、良い仕事が出来るようにと、営業や付き添いに走り回っている。"},{"spoiler":false,"text":"興味を持ったら一直線に突っ込んでいくタイプで、好奇心旺盛。"},{"spoiler":false,"text":"主人公に対しては面倒見がいいが、当人がドジっ子なせいでフォローされることの方が多い。"}],"source":"egs","sourceCharacterId":"20525","sourceWorkId":"27292","spoiler":false},{"segments":[{"spoiler":false,"text":"「クック―クロック」に勤めるマネージャー。"},{"spoiler":false,"text":"社内の事務とマネージャー業務を一人で切り盛りする働き者。"},{"spoiler":false,"text":"一見知性的だが、中身は自由奔放で体育会系なドジっ子。"},{"spoiler":false,"text":"マネージャーとして、事務所に所属する声優たちが活躍し、"},{"spoiler":false,"text":"良い仕事が出来るようにと営業や付き添いに走り回っている。"},{"spoiler":false,"text":"興味を持ったら一直線に突っ込んでいくタイプで、好奇心旺盛。"},{"spoiler":false,"text":"主人公に対しては面倒見がいいが、"},{"spoiler":false,"text":"当人がドジっこなせいでフォローされることの方が多い。"}],"source":"bangumi","sourceCharacterId":"67067"}],"profileFacts":[{"label":"年龄（本版本）","value":"24 岁","valueContext":null,"source":"egs","sourceCharacterId":"20525","sourceWorkId":"27292","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"20525","sourceWorkId":"27292","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd877639bae5d3601b400985856aeadf0b3c20faa42d3218297dfa6dc1d64269.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4cfe1daf42d6ab65b051818a9c35667d9f29cbeebd10606bb10027831bbf893c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中茉理花","creatorId":"vndb:s2571","sourcePersonId":"vndb:s2571","canonicalEntityId":"vndb:s2571","name":"田中 茉理花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:262373:67067:15994:1","source":"bangumi"}]},{"characterId":"char_c76300","characterName":"九鹿 美鳥","sourceIds":{"bangumi":[{"characterId":"67068","match":"exact-normalized-name-in-linked-work","subjectId":"262373"}],"egsCharacterIds":["20526"],"vndbCharacterId":"c76300"},"originalCharacterName":"九鹿 美鳥","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"35"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Midori is the founder of the Cuckoo Clock voice acting agency. She’s both the president and one of its voice actresses."},{"spoiler":false,"text":"She’s a veteran voice actress with over a decade long career, and is popular in the industry due to being a reliable mentor for younger actresses. She’s done voice acting for non-adult products as well, but adult titles are her mainstay and she still enthusiastically accepts offers for them."},{"spoiler":false,"text":"While she’s normally frank and broad-minded, she’s serious and earnest about her work. In private though, she’s quite messy. She’s often swamped with work, and is a also still single, even though she’s around 40 years old."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c76300"},{"segments":[{"spoiler":false,"text":"声優事務所「クックークロック」の創立者。"},{"spoiler":false,"text":"社長であり、所属声優。"},{"spoiler":false,"text":"芸歴十数年のベテラン声優。 同業の女性声優からの人望が厚く、若い声優達の頼れる良き姐御。"},{"spoiler":false,"text":"社長であると同時に、声優としても事務所の柱。"},{"spoiler":false,"text":"一般声優としても仕事をしていたことがあり、18禁をメインとしている今でもオファーさえあればやる気でいる。"},{"spoiler":false,"text":"豪放磊落で豪快な性格だが、仕事には真摯で真剣。"},{"spoiler":false,"text":"しかし私生活はだらしない。"},{"spoiler":false,"text":"声優業をしつつ社長業にも奔走している。"},{"spoiler":false,"text":"アラフォーだが未婚の独身。"}],"source":"egs","sourceCharacterId":"20526","sourceWorkId":"27292","spoiler":false},{"segments":[{"spoiler":false,"text":"声優事務所「クック―クロック」の創立者。社長であり、所属声優。"},{"spoiler":false,"text":"芸歴十数年のベテラン声優。同業の女性声優からの人望が厚く、"},{"spoiler":false,"text":"若い声優達の頼れる良き姉御。"},{"spoiler":false,"text":"社長であると同時に、声優としても事務所の柱。"},{"spoiler":false,"text":"一般声優としても仕事をしていたことがあり、"},{"spoiler":false,"text":"18禁をメインとしている今でもオファーさえあればやる気でいる。"},{"spoiler":false,"text":"豪放磊落で豪快な性格だが、仕事には真撃で真剣。"},{"spoiler":false,"text":"しかし私生活はだらしない。声優業をしつつ社長業にも奔走している。"},{"spoiler":false,"text":"アラフォーだが未婚の独身。"}],"source":"bangumi","sourceCharacterId":"67068"}],"profileFacts":[{"label":"年龄（本版本）","value":"35 岁","valueContext":null,"source":"egs","sourceCharacterId":"20526","sourceWorkId":"27292","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"20526","sourceWorkId":"27292","sourceField":null,"scoped":true}],"metadataCandid