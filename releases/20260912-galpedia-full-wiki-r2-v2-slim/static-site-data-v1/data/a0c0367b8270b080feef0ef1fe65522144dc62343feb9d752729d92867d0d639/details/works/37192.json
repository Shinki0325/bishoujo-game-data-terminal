ext":"Her main weapon is a fan."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c104187"},{"segments":[{"spoiler":false,"text":"霧ノ杜神社の長女で退魔巫女。"},{"spoiler":false,"text":"前向きで、見た目は幼いが明るく元気で、ほわほわした雰囲気の天然気味な女の子。"},{"spoiler":false,"text":"甘党で甘いものが大好き。過去の妖怪退治の時に懐いたすねこすりをペットにしている。"},{"spoiler":false,"text":"紅葉という、自分よりも見た目が大人っぽい妹がいる。"},{"spoiler":false,"text":"退魔巫女としての力は姉のましろの方が上。"}],"source":"egs","sourceCharacterId":"27435","sourceWorkId":"37192","spoiler":false},{"segments":[{"spoiler":false,"text":"霧ノ杜神社の長女で退魔巫女。"},{"spoiler":false,"text":"前向きで、見た目は幼いが明るく元気でほわほわした雰囲気の天然気味な女の子。"},{"spoiler":false,"text":"甘党で甘いものが大好き。"},{"spoiler":false,"text":"過去の妖怪退治の時に懐いたすねこすりをペットにしている。"},{"spoiler":false,"text":"紅葉という自分よりも見た目が大人ぽい妹がいる。"}],"source":"bangumi","sourceCharacterId":"105894"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afb4c98c10edfe550f8c6ca266784f85a48d8158e35dabfe85198f0761634165.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0451957d887235e75d508af678fb0517ce2aed080f5390ff093a9c86d2d1d8f.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:516238:105894:10026:1","source":"bangumi"}]},{"characterId":"char_c123020","characterName":"佐伯 紅葉","sourceIds":{"bangumi":[{"characterId":"124770","match":"exact-normalized-name-in-linked-work","subjectId":"516238"}],"egsCharacterIds":["27436"],"vndbCharacterId":"c123020"},"originalCharacterName":"佐伯 紅葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"霧ノ杜神社の次女で退魔巫女。"},{"spoiler":false,"text":"ましろの妹で、自分に自信がなく、普段はちょっと控えめな感じの大人しい性格の女の子。"},{"spoiler":false,"text":"でも、妖怪と戦う時は勇気を振り絞り凛々しくなる。"},{"spoiler":false,"text":"自分を引っ張ってくれる姉のましろをすごく尊敬していて、大好き。"},{"spoiler":false,"text":"小柄な姉のましろと一緒にいると、自分がお姉さんだと思われてしまうことを気にしている。"}],"source":"egs","sourceCharacterId":"27436","sourceWorkId":"37192","spoiler":false},{"segments":[{"spoiler":false,"text":"霧ノ杜神社(きりのもりじんじゃ)の退魔巫女でましろの妹。"},{"spoiler":false,"text":"自分に自信が無くて普段はちょっと控えめな感じの大人しい性格の女の子。"},{"spoiler":false,"text":"でも妖怪と戦う時は勇気を振り絞り凛々しくなる。"},{"spoiler":false,"text":"自分を引っ張ってくれる姉のましろをすごく尊敬していて大好き。"},{"spoiler":false,"text":"小柄な姉のましろと一緒にいた場合"},{"spoiler":false,"text":"自分がお姉さんだと思われてしまう事を気にしてる。"}],"source":"bangumi","sourceCharacterId":"124770"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/336215e3dea51a679d3e23b4abb1eec573d048ee68aaf7727efb345b284e008c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e4460bddbe95624411d5c7fc3e5de2ba93e72fcd35d30069a78667008248cb4.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:516238:124770:5928:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:2720","sourceCompanyId":"egs:brand:2720","canonicalEntityId":"egs:brand:2720","name":"でぼの巣製作所","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:37192:2720","source":"egs"},{"companyId":"vndb:p709","sourceCompanyId":"vndb:p709","canonicalEntityId":"vndb:p709","name":"でぼの巣製作所","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:138676:v52859","source