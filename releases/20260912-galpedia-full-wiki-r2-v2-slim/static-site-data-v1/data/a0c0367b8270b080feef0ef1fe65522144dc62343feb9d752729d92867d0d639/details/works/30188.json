i"}]},{"characterId":"char_c93506","characterName":"相沢 恵美里","sourceIds":{"bangumi":[{"characterId":"88640","match":"exact-normalized-name-in-linked-work","subjectId":"317243"}],"egsCharacterIds":["23193"],"vndbCharacterId":"c93506"},"originalCharacterName":"相沢 恵美里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"現役のアイドル。歴代でも屈指の人気を誇る。"},{"spoiler":false,"text":"普段は愛想よく振舞い少しお馬鹿キャラ演じる／何気に強か　という二面性を持つ。"},{"spoiler":false,"text":"基本的に芸能界での仕事第一で動いているため、勉学には疎く、頭は弱い。クイズ番組に出演しても、おバカ担当だが、持ち前の愛嬌で乗り切る。「恋愛の曲」を歌ったり、ドラマで恋する少女を演じるも、本当に異性を好きになったこともなく、恋を知らないため、どこか可愛いだけのうわべのもの。 ――と、芸能界での今後の成長について、悩んでいる所を主人公に付け込まれる。"}],"source":"egs","sourceCharacterId":"23193","sourceWorkId":"30188","spoiler":false},{"segments":[{"spoiler":false,"text":"現役のアイドル。歴代でも屈指の人気を誇る。"},{"spoiler":false,"text":"普段は愛想よく振舞い少しお馬鹿キャラ演じる／何気に強か　という二面性を持つ。"},{"spoiler":false,"text":"基本的に芸能界での仕事第一で動いているため、勉学には疎く、頭は弱い。クイズ番組に出演しても、おバカ担当だが、持ち前の愛嬌で乗り切る。「恋愛の曲」を歌ったり、ドラマで恋する少女を演じるも、本当に異性を好きになったこともなく、恋を知らないため、どこか可愛いだけのうわべのもの。 ――と、芸能界での今後の成長について、悩んでいる所を主人公に付け込まれる。"}],"source":"bangumi","sourceCharacterId":"88640"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07b03aac3147ad53eb0dbbc70c0a14c3b7d4c12a5753488d6cbbf497dab8662d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c0f14a18b90d5437f1603c4eb52168dc17656f303b50597659fceddae81ccc1.webp","width":233,"height":256,"source":"static-detail"},"actors":[{"creditedName":"海乃 シオ","creatorId":"vndb:s19149","sourcePersonId":"vndb:s19149","canonicalEntityId":"vndb:s19149","name":"海乃 シオ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85911","source":"vndb"}]},{"characterId":"char_c93507","characterN