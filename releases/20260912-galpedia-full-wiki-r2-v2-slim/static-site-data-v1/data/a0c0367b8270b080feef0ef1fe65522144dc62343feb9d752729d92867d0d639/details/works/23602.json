:"株式会社こだまプロダクション","detail":"効果音","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:194393","source":"egs"},{"creditedName":"藤村沙紀","creatorId":"egs:creator:20382","sourcePersonId":"egs:creator:20382","canonicalEntityId":"egs:creator:20382","name":"藤村沙紀","detail":"ムービー","roleCode":"other","roleLabel":"其他","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:194394","source":"egs"},{"creditedName":"フォントワークス株式会社(フォントワークス)","creatorId":"vndb:s40909","sourcePersonId":"egs:creator:21706","canonicalEntityId":"vndb:s40909","name":"フォントワークス株式会社(フォントワークス)","detail":"フォント協力","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:194395","source":"egs"},{"creditedName":"有限会社エレメント","creatorId":"egs:creator:31997","sourcePersonId":"egs:creator:31997","canonicalEntityId":"egs:creator:31997","name":"有限会社エレメント","detail":"プログラム提供","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:194419","source":"egs"},{"creditedName":"株式会社アルカディアワークス","creatorId":"egs:creator:31998","sourcePersonId":"egs:creator:31998","canonicalEntityId":"egs:creator:31998","name":"株式会社アルカディアワークス","detail":"販売","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:194420","source":"egs"},{"creditedName":"岬","creatorId":"vndb:s15393","sourcePersonId":"egs:creator:27870","canonicalEntityId":"vndb:s15393","name":"岬","detail":"主題歌 「Remain of Hope」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:197723","source":"egs"},{"creditedName":"Rozea","creatorId":"vndb:s4610","sourcePersonId":"vndb:s4610","canonicalEntityId":"vndb:s4610","name":"Rozea","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:130306","source":"vndb"},{"creditedName":"藤村 沙紀","creatorId":"vndb:s4858","sourcePersonId":"vndb:s4858","canonicalEntityId":"vndb:s4858","name":"藤村 沙紀","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:130308","source":"vndb"},{"creditedName":"国産 もやし","creatorId":"vndb:s5201","sourcePersonId":"vndb:s5201","canonicalEntityId":"vndb:s5201","name":"国産 もやし","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:130309","source":"vndb"},{"creditedName":"佐藤 輝政","creatorId":"vndb:s14905","sourcePersonId":"vndb:s14905","canonicalEntityId":"vndb:s14905","name":"佐藤 輝政","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:130311","source":"vndb"},{"creditedName":"佐藤 輝政","creatorId":"vndb:s14905","sourcePersonId":"vndb:s14905","canonicalEntityId":"vndb:s14905","name":"佐藤 輝政","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:130312","source":"vndb"},{"creditedName":"岬","creatorId":"vndb:s15393","sourcePersonId":"vndb:s15393","canonicalEntityId":"vndb:s15393","name":"岬","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:130313","source":"vndb"},{"creditedName":"こだまプロダクション","creatorId":"vndb:s19962","sourcePersonId":"vndb:s19962","canonicalEntityId":"vndb:s19962","name":"こだまプロダクション","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:130315","source":"vndb"},{"creditedName":"天倉 りぃ","creatorId":"vndb:s44929","sourcePersonId":"vndb:s44929","canonicalEntityId":"vndb:s44929","name":"天倉 りぃ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:130316","source":"vndb"}]},"cast":[{"characterId":"char_c46255","characterName":"ルル","sourceIds":{"bangumi":[{"characterId":"43854","match":"exact-normalized-name-in-linked-work","subjectId":"178356"}],"egsCharacterIds":["8622"],"vndbCharacterId":"c46255"},"originalCharacterName":"ルル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"正義が偶然に見つけた謎の少女。保護した時は最低限の生活をする上での知識以外、すべての記憶を失っていた。ひょんなきっかけで発見者である正義に懐き、正義もまた身寄りの無い彼女を放ってはおけず、以後彼女の世話を引き受けると同時、記憶を探すことになる。"},{"spoiler":false,"text":"出会った当時は常にぼーっとしていてつかみどころのない少女だが、正義たちと日々を過ごしていく中で様々な出来事を経験し、やがて記憶と人間性を取り戻していく。"},{"spoiler":false,"text":"そして彼女にすべての記憶が戻った時、物語は大きな転機を迎えることになる。"}],"source":"egs","sourceCharacterId":"8622","sourceWorkId":"23602","spoiler":false},{"segments":[{"spoiler":false,"text":"正义偶然遇见的谜之少女。"},{"spoiler":false,"text":"在获得救助时她除了最低程度的生活能力以外，丧失了其它所有的知识和记忆。"},{"spoiler":false,"text":"意外地由正义发现后便黏上了他，正义也无法放着无所依靠的露露不管，"},{"spoiler":false,"text":"只能在一边照顾她的同时，一边帮她寻找记忆。"},{"spoiler":false,"text":"刚相遇时是一位总是发呆的莫名其妙的少女，"},{"spoiler":false,"text":"不过与正义同居了一段日子经历了各种各样的事情后，记忆和感情也逐渐地取回。"},{"spoiler":false,"text":"然而当她取回所有记忆之时，物语将会迎来巨大的转机？！"}],"source":"bangumi","sourceCharacterId":"43854"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed4d7046fcb8e50cc89dfc223d3452d633b185660d1a074be3c4e482aa59eb00.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/7361cfc49665f69d03912ff709679626a1006b0aa64b40b8b3ae6e151577da15.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178356:43854:11646:1","source":"bangumi"},{"creditedName":"編流まり","creatorId":"vndb:s18270","sourcePersonId":"vndb:s18270","canonicalEntityId":"vndb:s18270","name":"編流まり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:69328","source":"vndb"}]},{"characterId":"char_c46256","characterName":"姫野 春香","sourceIds":{"bangumi":[{"characterId":"43855","match":"exact-normalized-name-in-linked-work","subjectId":"178356"}],"egsCharacterIds":["8623"],"vndbCharacterId":"c46256"},"originalCharacterName":"姫野 春香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"20"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"便利屋きりしまの唯一の社員。……といっても別に法人ではないので、単に仲間といった方が正しい。"},{"spoiler":false,"text":"主に事務関係の仕事をしてくれている縁の下の力持ち。"},{"spoiler":false,"text":"この世界には、動物のような身体的特徴を持った人間が存在し、そういった人々のことを「亜人」と呼んでいる。"},{"spoiler":false,"text":"春香は両親がそれぞれ人間と亜人であり、彼女自身はハーフ。普通の時は亜人の特徴は見えないが、精神が"},{"spoiler":false,"text":"高揚したりびっくりしたりするとネコのような耳と尻尾が飛び出すという半分人間、半分亜人の特性を持っている。"},{"spoiler":false,"text":"かつて正義がまだ現役エージェントだった時に面倒を見たことがあり、そこから知り合いとなって現在の関係に続いている。生まれ持って大きな魔力を保有しているのだが、なぜか魔法を使うことができないという特殊性を持つ。本人としては昔から変わらないことなので深刻には考えていないが、その魔力を正義のために有効に使えれば……とは夢想したりしている。"}],"source":"egs","sourceCharacterId":"8623","sourceWorkId":"23602","spoiler":false},{"segments":[{"spoiler":false,"text":"桐岛便利屋唯一的社员。"},{"spoiler":false,"text":"……说实在的这连法人都没有的团体，说是同伴的一员还比较恰当。"},{"spoiler":false,"text":"主要负责事务关系的处理，有着广阔的人脉。"},{"spoiler":false,"text":"在这个世界里存在着带动物特征的人类，人们称呼那种群体为「亚人」。"},{"spoiler":false,"text":"春香则是人类和亚人的后代，即混血儿。"},{"spoiler":false,"text":"虽然平时并不会显现出亚人的特征，不过在精神高扬或是受惊吓的时候，"},{"spoiler":false,"text":"就会露出像猫咪一样的耳朵和尾巴，也就是说有着一半人类、一半亚人的特征。"},{"spoiler":false,"text":"以前正义还是现役特工时曾被其关照，自那时便相识而发展到现在的关系。"},{"spoiler":false,"text":"虽然自出生时便有着庞大的魔力，不过不知为何无法使出魔法。"},{"spoiler":false,"text":"本人倒是自小已经习惯了自己的特殊体质所以没有多想原因，"},{"spoiler":false,"text":"不过偶尔会幻想……如果能为正义来有效地使用魔力就好了。"}],"source":"bangumi","sourceCharacterId":"43855"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/9264f94d3c8ca7e1a39d170b8484f5de3eea19524a4e28696b41fb9109de303a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f91d76e135444d6e46eaf4fb446d4d8fe94f86ee36ed7f27ca247ff5bbcdcf6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178356:43855:6351:1","source":"bangumi"}]},{"characterId":"char_c46257","characterName":"カレン・マクダウェル","sourceIds":{"bangumi":[{"characterId":"43856","match":"exact-normalized-name-in-linked-work","subjectId":"178356"}],"egsCharacterIds":["8624"],"vndbCharacterId":"c46257"},"originalCharacterName":"カレン・マクダウェル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"正義の便利屋「便利屋きりしま」が事務所として間借りさせてもらっている喫茶店「アイディアル」。"},{"spoiler":false,"text":"その店のオーナーであり、正義の便利屋としての大先輩である女性。珍しい夢魔の亜人で、常にエロの二文字がつきまとう難儀なキャラクターの御仁。"},{"spoiler":false,"text":"便利屋の間では『ティカー』という二つ名で通っている腕利きの情報屋で、彼女を頼りにする便利屋は多い。正義がオプティマルをやめて便利屋になろうとしたとき、手引きしたのが彼女であり、正義としては恩人。しかし常にエロを重視する性格のせいでイマイチ尊敬しきれないのが玉に瑕。"},{"spoiler":false,"text":"もともと謎多き人物だが、彼女には何か大きな秘密があるようで……？"}],"source":"egs","sourceCharacterId":"8624","sourceWorkId":"23602","spoiler":false},{"segments":[{"spoiler":false,"text":"咖啡厅「Ideal」（アイディアル）的所有者，"},{"spoiler":false,"text":"正义的「便利屋桐岛」事务所便租借在咖啡厅内的一角。"},{"spoiler":false,"text":"同时对于正义来说也是自己便利屋的大前辈。"},{"spoiler":false,"text":"她属于一种珍稀的梦魔亚人，是一位句句不离工口二字的麻烦角色。"},{"spoiler":false,"text":"以前从事便利屋时以「缇卡」（テイカー）为名号，精明地开设着一家情报屋。"},{"spoiler":false,"text":"曾向她发出委托的便利屋不计其数。"},{"spoiler":false,"text":"正义从Optimal退休开始从事便利屋时，便是由她带着入门，因此是正义的大恩人。"},{"spoiler":false,"text":"不过因其极度重视工口的性格所以至今也不太能得到正义的尊敬，可谓白璧之瑕。"},{"spoiler":false,"text":"虽然本身就是谜团重重的人物，"},{"spoiler":false,"text":"不过在她身上似乎能感觉到某个重大的秘密……？"}],"source":"bangumi","sourceCharacterId":"43856"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/907142a111e9faccee1ebc63c5bf6ace3f99d477e057696c75c8554351c3dbc7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4acfc13adff6ea55f05a161a783eaf2274a16bc9f7618dae7ddb0de5877f591.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178356:43856:5052:1","source":"bangumi"}]},{"characterId":"char_c46258","characterName":"神崎 エルザ","sourceIds":{"bangumi":[{"characterId":"43857","match":"exact-normalized-name-in-linked-work","subjectId":"178356"}],"egsCharacterIds":["8625"],"vndbCharacterId":"c46258"},"originalCharacterName":"神崎 エルザ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"現在のオプティマル内で最強とうたわれているエージェント。かつての正義の同僚であり、現在も親交がある気心の知れた女友達でもある。その魔力の高さからもうかがえるように生粋の亜人。"},{"spoiler":false,"text":"狐のような耳とふさふさの尻尾をしており、本人も手入れに余念がないチャームポイント。ちなみに尻尾は敏感で、不意に触れられると女が出てきてしまうらしい。"},{"spoiler":false,"text":"いつもは凛としたエージェントのエースとして振舞っているが、こう見えて意外と純情な乙女だったりする。密かに正義へ恋愛感情を抱いているが、そんな純情さもあって口には出来ずにいる。"}],"source":"egs","sourceCharacterId":"8625","sourceWorkId":"23602","spoiler":false},{"segments":[{"spoiler":false,"text":"当下被传为Optimal最强特工的女性。"},{"spoiler":false,"text":"以前曾是正义的同僚，现在也与其有着深交的意气相投的女性友人。"},{"spoiler":false,"text":"她极高的魔力宣告了其纯粹亚人的身份。"},{"spoiler":false,"text":"除有着狐耳和毛茸茸的尾巴以外，干练专一的行事风格也是她的魅力之一。"},{"spoiler":false,"text":"顺便一提尾巴部分极度敏感，据传不小心碰到的话会露出娇羞的样子。"},{"spoiler":false,"text":"虽然平时总是威风凛凛地扮演着精英特工的身份，"},{"spoiler":false,"text":"其实意外的是一位纯情的少女。"},{"spoiler":false,"text":"暗地里对正义抱有恋爱感情，然而由于纯情的性格至今都未曾表白。"}],"source":"bangumi","sourceCharacterId":"43857"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/eff7a06b84474408b80c682c14fec70841ee0867cc90c53efd3e0826028eb8a2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c4824b84f15d57a06f8dc972af202fc646dd1cb7b3106287ed823674a5ba910.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大野まりな","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178356:43857:4434:1","source":"bangumi"}]},{"characterId":"char_c46259","characterName":"古川 舞","sourceIds":{"bangumi":[{"characterId":"43858","match":"exact-normalized-name-in-linked-work","subjectId":"178356"}],"egsCharacterIds":["8626"],"vndbCharacterId":"c46259"},"originalCharacterName":"古川 舞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"エルザの後輩にして、正義とも少し縁があるエージェントの女性。オプティマル入隊当時から「天才」として扱われている優秀な人物で、その評価は今も変わっていない。"},{"spoiler":false,"text":"性格はマジメが服を着て歩いているような委員長タイプで、何より規則や正義を重んじる。"},{"spoiler":false,"text":"規則はともかく、正義を重視するという点では正義と価値観が共通するところが多く意見が合ったりする。とはいえ頑固というわけではなく、そこは大人としての分別もわきまえている。"},{"spoiler":false,"text":"昔、とある出来事をきっかけに正義を尊敬するようになり、今も彼のことをファイターとしても、一人の男性としても尊敬しているところがある。"}],"source":"egs","sourceCharacterId":"8626","sourceWorkId":"23602","spoiler":false},{"segments":[{"spoiler":false,"text":"艾尔莎的后辈，也是曾和正义有着少许缘分的女性。"},{"spoiler":false,"text":"初入队Optimal时是被当作「天才」级别的优秀人物，而那个评价至今也未曾变化。"},{"spoiler":false,"text":"其认真的性格仿佛古板的委员长一般，将规则和正义（非男主）作为第一准则。"},{"spoiler":false,"text":"姑且不论规则，她重视正义的这点因和男主的价值观相通，因此两人的观点多半重合。"},{"spoiler":false,"text":"不过她也还没到顽固的地步，能够成熟地将状况分别对待。"},{"spoiler":false,"text":"以前曾因某件事而对男主抱有敬意，"},{"spoiler":false,"text":"如今也将他作为一名战士、一位男士般地尊敬着。"}],"source":"bangumi","sourceCharacterId":"43858"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8e60a09e835f163050141c01213a02d2636359123dd1b57baf5ede41f18f37e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24685698d636efe986f9e4d4994d1fd23b16f624e7f795cbb540a990a2bbb4df.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178356:43858:6016:1","source":"bangumi"}]},{"characterId":"char_c46260","characterName":"一瀬 杏子","sourceIds":{"bangumi":[{"characterId":"43859","match":"exact-normalized-name-in-linked-work","subjectId":"178356"}],"egsCharacterIds":["8627"],"vndbCharacterId":"c46260"},"originalCharacterName":"一瀬 杏子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"オプティマルの寮で舞とルームメイトをしているエージェントの女の子。いつも舞と一緒に行動しており、公私共に仲がいい友達であり同僚。エルザや舞ほどではないがそれでも優秀なエージェントであり、これからのルーキー的な存在となっている。"},{"spoiler":false,"text":"荒事を担うエージェントとしてはやや不安になるほどの小心者で、いつもビクビクしている。"},{"spoiler":false,"text":"そんなままでは一人前のエージェントになれないと自覚しているが、こればかりは性格というものでいかんともしがたかったり。それでも舞と共通する努力肌の人間で、前に進む努力だけは諦めていない。なんとも応援したくなるようなタイプの女性である。"}],"source":"egs","sourceCharacterId":"8627","sourceWorkId":"23602","spoiler":false},{"segments":[{"spoiler":false,"text":"在Optimal的宿舍内和舞是宿友关系的女孩子。"},{"spoiler":false,"text":"总是和舞一起行动，与她于公于私都非常要好的亲友兼同僚。"},{"spoiler":false,"text":"虽没到艾尔莎和舞的程度，不过也是前程似锦的优秀特工。"},{"spoiler":false,"text":"作为从事危险工作的特工来说稍微有些过于胆小，总是一副瑟瑟发抖的感觉。"},{"spoiler":false,"text":"自己也觉得这样下去很难成为独当一面的特工，"},{"spoiler":false,"text":"不过毕竟是性格的原因总不可能一蹴而就。"},{"spoiler":false,"text":"幸好与舞一样平时都十分努力，从未放弃过改善的尝试，"},{"spoiler":false,"text":"是会让人不自觉开始应援的努力家类型。"}],"source":"bangumi","sourceCharacterId":"43859"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/795ef885975b3859cea527fbdc9d11ddf1bd687657090e028246332bb1eb27ce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd7ed67edbdc6e2b407a89387023d41a3f317df8078f082d502abbb47ce83ae8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松山紗香","creatorId":"vndb:s904","sourcePersonId":"vndb:s904","canonicalEntityId":"vndb:s904","name":"松山 紗香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178356:43859:10662:1","source":"bangumi"}]},{"characterId":"char_c46261","characterName":"桐生 雫","sourceIds":{"bangumi":[{"characterId":"43860","match":"exact-normalized-name-in-linked-work","subjectId":"178356"}],"egsCharacterIds":["8628"],"vndbCharacterId":"c46261"},"originalCharacterName":"桐生 雫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"恭司と同じく、元エージェントだった女性。恭司とは職務上先輩後輩の関係に当たるが、関係はそれだけではなく、家族ぐるみの親しい付き合いをしていた。男女の関係はないが、雫自身は恭司に対して親愛以上の感情を抱いている。そんな心情もあり、恭司がオプティマルから抜ける際、彼女もまた恭司の後を追いかけた。"},{"spoiler":false,"text":"自分の思いが通じることは願っておらず、ただ自分に良くしてくれた彼の役に少しでも立ちたいと思っている。そういった意味でも、まさに薄幸のの美女。"}],"source":"egs","sourceCharacterId":"8628","sourceWorkId":"23602","spoiler":false},{"segments":[{"spoiler":false,"text":"与恭司同样曾是特工的女性。"},{"spoiler":false,"text":"与他是职务上的前后辈的关系，两人的家族也久有深交。"},{"spoiler":false,"text":"虽还没有男女间的关系，不过雫自身对恭司抱有敬爱之上的感情。"},{"spoiler":false,"text":"在各种思绪交汇之下，因此当恭司脱离Optimal时，她也追随而去。"},{"spoiler":false,"text":"不奢望自己的心意能传达，"},{"spoiler":false,"text":"只是希望能对曾经善待过自己的恭司尽上一丝绵薄之力。"},{"spoiler":false,"text":"各种意义上来说都是一名薄幸的美女。"}],"source":"bangumi","sourceCharacterId":"43860"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5821832c93a09211e7f719ae10a79eb4294577110e669ec193333079889bf3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08cef261aa6e0bfe2e516ba07edab96beb221bc0ae5f558a1490ae26d5da8f9d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"咲乃藍里","creatorId":"vndb:s436","sourcePersonId":"vndb:s436","canonicalEntityId":"vndb:s436","name":"咲乃 藍里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178356:43860:5692:1","source":"bangumi"}]},{"characterId":"char_c46262","characterName":"桐生 狛","sourceIds":{"bangumi":[{"characterId":"43861","match":"exact-normalized-name-in-linked-work","subjectId":"178356"}],"egsCharacterIds":["8629"],"vndbCharacterId":"c46262"},"originalCharacterName":"桐生 狛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"雫の実の妹で、姉のことを心底信じきっているとても素直な女の子。だがその素直さはある意味野生じみているともいえ、すべて本能で動いているのではと思うぐらい直感で動く。そのシンプルすぎる考え方は年齢に対してやや幼く感じられるもの。その幼さは同時に純粋さとも言え、姉が信じる恭司を彼女もまた信じ、好きになり、守ろうと思っている。だが本人は小難しいことは一切考えておらず、ただ単に姉や恭司が喜ぶことをしようと思っているだけだったりする。"}],"source":"egs","sourceCharacterId":"8629","sourceWorkId":"23602","spoiler":false},{"segments":[{"spoiler":false,"text":"雫的亲妹妹，打心底信任着姐姐的率直女孩子。"},{"spoiler":false,"text":"不过她的率直某种程度上可以说是野性也不为过，任何事都会单纯凭本能和直觉地行动。"},{"spoiler":false,"text":"这种单纯的思考方式似乎比直观的年龄来说要更加年幼，"},{"spoiler":false,"text":"而其年幼的心智所赋予的纯粹性格，使得她对于姐姐信任有加的恭司也死心塌地，"},{"spoiler":false,"text":"非但本人喜欢着他，也希望自己能守护他。"},{"spoiler":false,"text":"不过其实本人并没有把事情想得那么复杂，"},{"spoiler":false,"text":"只是单纯为了让姐姐和恭司高兴而竭尽全力。"}],"source":"bangumi","sourceCharacterId":"43861"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/619b8d82da0859dc8aafa0eec818ab23b9dbf549edec23954f67f3bf98f47c66.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba91b683b63a5c544d164701b9150faeadafba5e785f54386e28d3395dbb2f45.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178356:43861:5928:1","source":"bangumi"}]},{"characterId":"char_c46263","characterName":"アドミス","sourceIds":{"bangumi":[{"characterId":"43862","match":"exact-normalized-name-in-linked-work","subjectId":"178356"}],"egsCharacterIds":["8631"],"vndbCharacterId":"c46263"},"originalCharacterName":"アドミス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"とある遺跡に封印され、眠っていたところを恭司によって強制的に目覚めさせられた古の存在。"},{"spoiler":false,"text":"両方の目は常に閉じられており、同時に天使のような穏やかな微笑みをたたえている。"},{"spoiler":false,"text":"物腰や所作もまるで名家のお嬢様といった風だが、どこか得体のしれない雰囲気をまとっている。"},{"spoiler":false,"text":"恭司の求めに応じ、彼と行動をともにしているが、彼女の真意がどこにあるのかは見えない。"}],"source":"egs","sourceCharacterId":"8631","sourceWorkId":"23602","spoiler":false},{"segments":[{"spoiler":false,"text":"被封印在某个遗迹里、一直沉眠着的古老的存在，因恭司的原因而被强制唤醒。"},{"spoiler":false,"text":"双眼总是处于闭合的状态，同时表情维持着天使般祥和的笑容。"},{"spoiler":false,"text":"举手投足仿佛哪里的高贵大小姐一般，"},{"spoiler":false,"text":"不过身边总缠绕着某种难以捉摸的氛围。"},{"spoiler":false,"text":"回应了恭司的要求，目前与他一起行动着，"},{"spoiler":false,"text":"无人知道她的真实意图是什么。"}],"source":"bangumi","sourceCharacterId":"43862"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92ad1c430dace4793fb528a8840398999b1871cd8ca7416bf0284a88216da171.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/226dc5abd58eb86c7aad224d27f08b93c3dbd24e435ebb11c50e9fbc471a4ba2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:178356:43862:5741:1","source":"bangumi"}]},{"characterId":"char_c68037","characterName":"二階堂 恭司","sourceIds":{"bangumi":[],"egsCharacterIds":["8630"],"vndbCharacterId":"c68037"},"originalCharacterName":"二階堂 恭司","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"正義やエルザとは元オプティマル同僚で、今は理由あってお尋ね者になっている男。正義がその半身を失い、さらには魔力さえも失うことになった大事故において、彼も片目を失うという大怪我を負った。"},{"spoiler":false,"text":"だが彼にとって最大の喪失は、その事故で実の妹である「桜花」が死んだこと。それが物語すべての始まりであり、正義たちとの確執の始まりである。"},{"spoiler":false,"text":"かつては、周囲にも自分にも厳しいエリートエージェントを絵にしたような人物だった。だが堅苦しいだけではなく、誰にも分け隔てなく優しい紳士的な面も持ち合わせ、組織内での信頼も厚かった。"},{"spoiler":false,"text":"それが今では笑顔を少しも見せない、心が凍ったかのような男になってしまっている。"}],"source":"egs","sourceCharacterId":"8630","sourceWorkId":"23602","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2c25a34949c0171e9522b2747613fe7d13421293e32043e5804e4efbffb9efa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f54b9352379f640413dd9b4654eaf6d0c99b2f861ccc1165739ab22e29d4eee.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c68038","characterName":"井原 庄次郎","sourceIds":{"bangumi":[],"egsCharacterIds":["8632"],"vndbCharacterId":"c68038"},"originalCharacterName":"井原 庄次郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"正義が間借している喫茶アイディアルのマスターにして、正義と同じ、かつてオプティマルに所属していた導具の開発責任者だった人物。ゆえに導具の扱いに明るく、正義の身体のメンテナンスもしてくれている男。"},{"spoiler":false,"text":"オプティマルのエージェントたちが使う特殊な導具「ZED」を開発した人物であり、現代の魔導科学において彼の名前を知らない人物はいないとまで言われている。しかし当の本人の素顔は誰よりもドリルを愛するドリルマニアで、はっきり言って変人。えてして天才とは人に理解され難いものなのである（汗）"}],"source":"egs","sourceCharacterId":"8632","sourceWorkId":"23602","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60b31175faf05a12530ad67c9dc113f1f944914296e1dee3873f1c1ad2bc110a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce0b7252be292261505ffd92e824edc0d3533529adf6ee7eefac875875d8f2d6.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c50818","characterName":"桐島 正義","sourceIds":{"vndbCharacterId":"c50818"},"originalCharacterName":"桐島 正義","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/3700413c01bfdaaa658954ea279af72f5129b4cc634fb667ba5bbfa5