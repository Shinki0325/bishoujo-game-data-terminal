{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"11780","model":{"presentationWorkId":"vndb:v2408","staff":{"artwork":[{"creditedName":"あきよしよしあき","creatorId":"vndb:s12429","sourcePersonId":"egs:creator:785","canonicalEntityId":"vndb:s12429","name":"あきよしよしあき","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:79580","source":"egs"}],"scenario":[{"creditedName":"騎西ソアラ","creatorId":"vndb:s5114","sourcePersonId":"egs:creator:2251","canonicalEntityId":"vndb:s5114","name":"騎西ソアラ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:79581","source":"egs"}],"music":[{"creditedName":"曽谷 コウヘイ","creatorId":"vndb:s10269","sourcePersonId":"vndb:s10269","canonicalEntityId":"vndb:s10269","name":"曽谷 コウヘイ","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:34710","source":"vndb"}],"other":[{"creditedName":"騎西ソアラ","creatorId":"vndb:s5114","sourcePersonId":"egs:creator:2251","canonicalEntityId":"vndb:s5114","name":"騎西ソアラ","detail":"企画、スクリプト、効果音、デバッグ","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:134456","source":"egs"},{"creditedName":"騎西 ソアラ","creatorId":"vndb:s5114","sourcePersonId":"vndb:s5114","canonicalEntityId":"vndb:s5114","name":"騎西 ソアラ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34709","source":"vndb"}]},"cast":[{"characterId":"char_c54694","characterName":"フォリス","sourceIds":{"bangumi":[{"characterId":"34859","match":"exact-normalized-name-in-linked-work","subjectId":"142909"}],"egsCharacterIds":["15986"],"vndbCharacterId":"c54694"},"originalCharacterName":"フォリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"冥府の王、閻魔大王の一人娘。"},{"spoiler":false,"text":"王の一人娘だけあって、ワガママに育った。そのため高飛車で、自分の思い通りにならないと途端に怒り出し、大きな声で喚く。"},{"spoiler":false,"text":"ちなみに名前の“Foris”はラテン語で「門」の意。"},{"spoiler":false,"text":"「こやつでないと嫌じゃ！　絶対に嫌じゃ！」"}],"source":"egs","sourceCharacterId":"15986","sourceWorkId":"11780","spoiler":false},{"segments":[{"spoiler":false,"text":"冥府の王、閻魔大王の一人娘。"},{"spoiler":false,"text":"勝手に決められそうになった結婚相手に猛反対し、自分で見つけるために人間界にやってきてバッタリ出会った主人公を気に入り、冥府へ連れて行く。"},{"spoiler":false,"text":"王の一人娘だけあって性格はお嬢様でワガママ。生粋のタカビーではないが命令口調で主人公にモノを言う。"},{"spoiler":false,"text":"気に入らないことがあるとすぐに怒り、大きな声で命令する。"},{"spoiler":false,"text":"今まで、周りの人間（？）は王の一人娘のご機嫌を損ないたくないため、みんな逆らうことなどせず、思い通りに振舞っていた。"},{"spoiler":false,"text":"しかし主人公はそんなことは知らないので、嫌なことは嫌！といい、それにショックを受ける。"},{"spoiler":false,"text":"だけどそれが、自分と向き合ってくれている。自分のことを見てくれている。と判った閻魔娘は、主人公に惹かれていく。"},{"spoiler":false,"text":"最初は「こやつもわらわの手下じゃ」と感じていたのが「こやつでないと嫌じゃ！絶対に嫌じゃ！」と、いい意味？でワガママになる。"}],"source":"bangumi","sourceCharacterId":"34859"}],"profileFacts":[{"label":"胸围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"15986","sourceWorkId":"11780","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"148 cm","valueContext":null,"source":"egs","sourceCharacterId":"15986","sourceWorkId":"11780","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"15986","sourceWorkId":"11780","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"15986","sourceWorkId":"11780","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45c6bedb7fec1dce8170998b5ad956d7bfb1835fcf8cdc1f67d29be482975d94.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf7dfe5c4e4b14da90d9deffd2073c1b42b30eda39c51376126f06be93ba2073.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田愛衣","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:142909:34859:6509:1","source":"bangumi"}]},{"characterId":"char_c54695","characterName":"倉貫 結菜","sourceIds":{"bangumi":[{"characterId":"34861","match":"exact-normalized-name-in-linked-work","subjectId":"142909"}],"egsCharacterIds":["15987"],"vndbCharacterId":"c54695"},"originalCharacterName":"倉貫 結菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染。"},{"spoiler":false,"text":"主人公のことをずっと前から好きだったが、今さら言えないし……、と素直になれないツンデレ。"},{"spoiler":false,"text":"フォリスが主人公を冥府に連れ去ろうとするのを目撃し、主人公の足にしがみついて一緒に冥府へと……。"},{"spoiler":false,"text":"「し、仕方ないわね！　あ、あんたみたいな男、こんな機会でもないと一生エッチできないでしょうから、私が相手をしてあげる！」"}],"source":"egs","sourceCharacterId":"15987","sourceWorkId":"11780","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼馴染。"},{"spoiler":false,"text":"主人公のことが昔から密かに好きだけど、今さら言えないし、私って性格キツイし…とかそんな風に思っていて、素直になれない女の子。"},{"spoiler":false,"text":"一緒に通学するような仲じゃないのだけど、たまに一緒になったりもする（待ち合わせをして行くような仲では無い）。"},{"spoiler":false,"text":"フォリスが主人公の魂を連れ去ろうとするのを見て、主人公の足にしがみついて一緒に冥府に行くことになる。"},{"spoiler":false,"text":"典型的なツンデレ。主人公の前では素直になれない。"},{"spoiler":false,"text":"主人公とエッチをしなさい。と閻魔大王に言われて嫌！と言うけれど、逃れられないのを知って「し、仕方ないわね！あ、あんたみたいな男、こんな機会でもないと一生エッチできないでしょうから、私が相手をしてあげる！感謝しなさいよっ！」とか顔を真っ赤にしてツンツンしながら言う。"}],"source":"bangumi","sourceCharacterId":"34861"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"15987","sourceWorkId":"11780","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"15987","sourceWorkId":"11780","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"15987","sourceWorkId":"11780","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"15987","sourceWorkId":"11780","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fea82cc456138418d94db448ff8d3569cf20e3eb0b3440f2c710c1036b77127d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/827fd581d750881e004f41db59d1e25727cefed777e733959af576111b134790.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:142909:34861:5936:1","source":"bangumi"}]},{"characterId":"char_vndb_c54696","characterName":"閻魔","sourceIds":{"vndbCharacterId":"c54696"},"originalCharacterName":"閻魔","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"m