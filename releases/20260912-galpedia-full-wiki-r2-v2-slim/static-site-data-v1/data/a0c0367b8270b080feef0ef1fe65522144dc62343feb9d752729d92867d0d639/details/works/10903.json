-native","relationId":"vndb:vn-staff:19293","source":"vndb"},{"creditedName":"くまの きよみ","creatorId":"vndb:s15438","sourcePersonId":"vndb:s15438","canonicalEntityId":"vndb:s15438","name":"くまの きよみ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:19295","source":"vndb"},{"creditedName":"五十嵐 雄策","creatorId":"vndb:s23728","sourcePersonId":"vndb:s23728","canonicalEntityId":"vndb:s23728","name":"五十嵐 雄策","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:19297","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c10808","characterName":"乃木坂 春香","sourceIds":{"vndbCharacterId":"c10808"},"originalCharacterName":"乃木坂 春香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1020"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haruka is the main female character of the story, and is Yuuto's classmate. Due to her beauty and intelligence, She is idolized at school and regarded as the school's most unattainable girl, even known by the French nicknames Nuit Étoile (The Night Star) and Lumière du Clavier (The Piano's Light). She is very skilled at playing the piano and has taken overall victories in international contests. She also has a gentle personality, is a natural airhead, and is quite clumsy. Her deep hidden secret is that she is a major otaku and loves anime and manga. In middle school, her secret was exposed and she received a certain amount of prejudice towards it which caused her to keep it a secret once she entered high school. When Yuuto finds out about it, Haruka is relieved that he does not tell anyone or harass her about it and over the course of the series, develops romantic feelings for him. She also comes from a rich family and privileged upbringing, so her interest in the otaku subculture is looked down upon due to her status in society, which is another reason why she keeps it a secret. Haruka once fled to a park after being scolded by her father, several years before. It was here that her anime obsession started when Yuuto gave her the first issue of Innocent Smile. While being very talented, she cannot draw well, but does not realize it because she is too proud of it for anyone to tell her directly."},{"spoiler":false,"text":"Taken from Wikipedia"}],"source":"vndb","sourceCharacterId":"c10808"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed9d7d05822de36514ebd0de32641a42495b28156465282c23e538b587a6c3f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2bad12ee952b6aabddd5352f82b186f28c4028dd96a71ebb967322d9b9d0686.webp","width":236,"height":256,"source":"static-detail"},"actors":[{"creditedName":"能登 麻美子","creatorId":"vndb:s468","sourcePersonId":"vndb:s468","canonicalEntityId":"vndb:s468","name":"能登麻美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9537","source":"vndb"}]},{"characterId":"char_vndb_c10809","characterName":"乃木坂 美夏","sourceIds":{"vndbCharacterId":"c10809"},"originalCharacterName":"乃木坂 美夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"birthday":{"reviewState":"source-only","source":"vndb","value":"405"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"70"},"height":{"reviewState":"source-only","source":"vndb","value":"147"},"hip":{"reviewState":"source-only","source":"vndb","value":"71"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mika is Haruka's younger sister in her second year of junior high school. Her hobbies include playing the violin, playing squash, caring for wild pigs, and spying on her sister and Yuuto. She has a personality that is the exact opposite of her sister's, who is naïve. She enjoys Yuuto's company and she often calls him \"Onii-san\" (an affectionate word meaning brother, brother-in-law, or a brother-like male figure). When Haruka is with Yuuto, however, Mika likes to tease them. In contrast to her airhead older sister, Mika is very stable. Even at her young age, she is more knowledgeable about sex than Haruka, although she will get shocked or stunned mentally if exposed to H-rated material just like her sister. She shows some interest in Yuuto after their date. She is deathly afraid of ghosts. She has been running for the student council president of her all girl school for two consecutive years. She is just as much as an idol as her sister at school and is known by the name Moonlight Strawberry."},{"spoiler":false,"text":"Taken from Wikipedia"}],"source":"vndb","sourceCharacterId":"c10809"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eec6871686370f4dbb5106d23ca972496d3ae59a3a058434e6607075f3668d01.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b26ccea206f3c5d7e4e258c53319a74aa41758575f0149a7ae3f91efa6ae643.webp","width":251,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤 麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9538","source":"vndb"}]},{"characterId":"char_vndb_c10810","characterName":"天宮 椎菜","sourceIds":{"vndbCharacterId":"c10810"},"originalCharacterName":"天宮 椎菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"424"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shiina is a girl who participated in the London Piano Contest with Haruka; Shiina ranked second after Haruka who ranked first. She transfers into Yuuto's class at school. Her hobbies include playing the piano and the martial art of naginatajutsu. She always has a positive, cheerful and sociable personality. This makes her transition as a transfer student very easy. She used to live in Otaru, Hokkaido, Japan, though does not speak much of those days. She shows an interest for Yuuto as she believes there might be a reason they constantly bump into each other. She said one of the reason she chose Yuuto's school to transfer to is because of a famous teacher who graduated from the school and is known as the Performer of the Sunset is teaching at the school."},{"spoiler":false,"text":"Taken from Wikipedia"}],"source":"vndb","sourceCharacterId":"c10810"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae56112ff6ca9a779d63abcedc3a4102b77d21de1b08d8050f5f2ddb1f3cbd43.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9ab97586f6ad0a444b00d1bc229af2d7af43ccfde4a50b38501ddd8503967fa1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤 利奈","creatorId":"vndb:s360","sourcePersonId":"vndb:s360","canonicalEntityId":"vndb:s360","name":"佐藤 利奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9535","source":"vndb"}]},{"characterId":"char_vndb_c10811","characterName":"桜坂 葉月","sourceIds":{"vndbCharacterId":"c10811"},"originalCharacterName":"桜坂 葉月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"source-only","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hazuki is the head maid of the Nogizaka family. She is mainly in charge of looking after Haruka and Mika, particularly Haruka; Hazuki acts in the way of an older sister towards her. She is generally very reserved and expressionless, but sometimes speaks of bombshell announcements. Hazuki adores cute things and even has a collection of stuffed animals. She often appears out of nowhere holding a chainsaw, her preferred defensive weapon."},{"spoiler":false,"text":"Taken from Wikipedia"}],"source":"vndb","sourceCharacterId":"c10811"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b728b60a65a5535d50a9d91d9b3d396db9e623413f458804afc88992f3d51c8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71f90e32a1df8621ebba625e8ca87676c1a31607343a93fad715a56b4afbe3b8.webp","width":212,"height":256,"source":"static-detail"},"actors":[{"creditedName":"清水 香里","creatorId":"vndb:s5724","sourcePersonId":"vndb:s5724","canonicalEntityId":"vndb:s5724","name":"清水 香里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9542","source":"vndb"}]},{"characterId":"char_vndb_c10812","characterName":"七城 那波","sourceIds":{"vndbCharacterId":"c10812"},"originalCharacterName":"七城 那波","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"716"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"source-only","source":"vndb","value":"166"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nanami is the third-highest ranking maid of the Nogizaka family, and she usually helps Hazuki with her work, but is more commonly found alongside Mika helping and joining in on her spying missions. She has a friendly personality and smiles a lot, though also has a wicked tongue. She is seen wearing sunglasses often. Like Hazuki, she also often appears out of nowhere, though holding a large hammer that looks like a meat tenderizer for a defensive weapon. She has a habit of driving extremely fast (she drives the family Rolls-Royce Phantom like a WRC driver, though she sometimes drives the other Nogizaka limousine), but Haruka just states she is a great driver when one is in a hurry."},{"spoiler":false,"text":"Taken from Wikipedia"}],"source":"vndb","sourceCharacterId":"c10812"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34a053990206fec805fc4b259a93ddfe863d4e7d3045c9d648caa28e7ea40012.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4ae39985b23cec2e972af56c5ed02ce3141758983a70367761304cc0a93e130.webp","width":232,"height":256,"source":"static-detail"},"actors":[{"creditedName":"植田 佳奈","creatorId":"vndb:s17","sourcePersonId":"vndb:s17","canonicalEntityId":"vndb:s17","name":"植田 佳奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9534","source":"vndb"}]},{"characterId":"char_vndb_c10813","characterName":"アリスティア＝レイン","sourceIds":{"vndbCharacterId":"c10813"},"originalCharacterName":"アリスティア＝レイン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"67"},"height":{"reviewState":"source-only","source":"vndb","value":"139"},"hip":{"reviewState":"source-only","source":"vndb","value":"64"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Alistia, otherwise known as Alice, is the eight-highest ranking maid of the Nogizaka family, and is in charge of VIP security and sabotage. She looks like a grade school student, and is a blond Caucasian (most likely German, since she once utters \"Bruder\", which conveys the same meaning as Mika's \"Onii-san\", when addressing Yuuto). She rarely speaks (being not yet skilled in Japanese), and normally converses with others via an array of nods and head-shakes to express her meanings (while uttering \"koku\"). However, in the second series, she is revealed to have superb fighting skills with the attitude of a programmed hell-bent killer, as she was revealed by Hazuki to be the one in charge of VIP security and sabotage. She has a baseball bat studded with spikes, as well as spiked knuckles, as weapons."},{"spoiler":false,"text":"Taken from Wikipedia"}],"source":"vndb","sourceCharacterId":"c10813"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28b387dcea1cb594d49954533cacf89377c05a045ca3ae522ff6c0e9ab35889c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/1534c5cda09b6262122badd5bbc8f8a4508cdae39404caec5303a55a18401313.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"釘宮 理恵","creatorId":"vndb:s500","sourcePersonId":"vndb:s500","canonicalEntityId":"vndb:s500","name":"釘宮理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9539","source":"vndb"}]},{"characterId":"char_vndb_c10814","characterName":"小樽 利緒","sourceIds":{"vndbCharacterId":"c10814"},"originalCharacterName":"小樽 利緒","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"503"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rio comes from Hokkaido. She was Shiina's friend and classmate when they were in elementary school. She is currently hosting cosplay events in Akiba like Nobunaga does."},{"spoiler":false,"text":"Since Rio has moved to Tokyo, Shiina have not heard from her, but they reunite by chance when both of them are asked by Yuuto to participate in a cosplay event that Nobunaga organized."},{"spoiler":false,"text":"Roughly tr