}],"egsCharacterIds":["7387"],"vndbCharacterId":"c38095"},"originalCharacterName":"稲佐 白兎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Weapon: Her charm"},{"spoiler":false,"text":"Attribute: Metal"}],"source":"vndb","sourceCharacterId":"c38095"},{"segments":[{"spoiler":false,"text":"八雲学園の先輩。"},{"spoiler":false,"text":"大地と並んで郷土史研究会の幽霊部員その2。"},{"spoiler":false,"text":"小柄だがバストは十分に先輩であることをアピールしている。"},{"spoiler":false,"text":"独特の雰囲気をもち、険悪なムードの中でも平然と乗り込んできて空気を代えてしまう。"},{"spoiler":false,"text":"変に英語が混じったインチキ外人風のしゃべり方を好むが、キャラ付けということで狙ってやっているらしい。"},{"spoiler":false,"text":"大地に対しては、セクハラまがいの行動をしてからかっている。"},{"spoiler":false,"text":"武器は呪符系。属性は金。"}],"source":"egs","sourceCharacterId":"7387","sourceWorkId":"22384","spoiler":false},{"segments":[{"spoiler":false,"text":"悪戯好きで巨乳な先辈"},{"spoiler":false,"text":"稲佐 白兎（いなさ はくと）"},{"spoiler":false,"text":"武器：呪符系／属性：金"},{"spoiler":false,"text":"郷土史研究会の幽霊部员で、小さい身体に大きな胸を持つ小悪魔な先辈。主人公にセクハラまがいの悪戯をしてからかうのが趣味。"},{"spoiler":false,"text":"「グッモーニーン♪　おはよ、おふたりさん」"}],"source":"bangumi","sourceCharacterId":"35173"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5bc67f3a525d95f85e7de48902a94ed74b1515c8113f2ad305d87b4f2252691f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d7818fcb15a22befe724527bd435836bd4487b04c7f1dea098a0923d991314b.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"武石あゆ実","creatorId":"vndb:s1745","sourcePersonId":"vndb:s1745","canonicalEntityId":"vndb:s1745","name":"武石 あゆ実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:142739:35173:16168:1","source":"bangumi"}]},{"characterId":"char_c38096","charact