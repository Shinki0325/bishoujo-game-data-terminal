{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"20801","model":{"presentationWorkId":"vndb:v15604","staff":{"artwork":[{"creditedName":"石井彰","creatorId":"vndb:s2469","sourcePersonId":"egs:creator:1754","canonicalEntityId":"vndb:s2469","name":"石井彰","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:134972","source":"egs"}],"scenario":[{"creditedName":"冬野氷夜(冬野ヒョウヤ)","creatorId":"vndb:s2603","sourcePersonId":"egs:creator:17137","canonicalEntityId":"vndb:s2603","name":"冬野氷夜(冬野ヒョウヤ)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:134973","source":"egs"},{"creditedName":"西矢沙広","creatorId":"vndb:s2600","sourcePersonId":"egs:creator:1902","canonicalEntityId":"vndb:s2600","name":"西矢沙広","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:134974","source":"egs"},{"creditedName":"遊真一希(遊馬一希)","creatorId":"vndb:s2601","sourcePersonId":"egs:creator:5208","canonicalEntityId":"vndb:s2601","name":"遊真一希(遊馬一希)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:134975","source":"egs"},{"creditedName":"Fuzisawa","creatorId":"vndb:s2602","sourcePersonId":"egs:creator:13903","canonicalEntityId":"vndb:s2602","name":"Fuzisawa","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:134976","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c27996","characterName":"藤島 あやめ","sourceIds":{"bangumi":[{"characterId":"69459","match":"exact-normalized-name-in-linked-work","subjectId":"173159"}],"egsCharacterIds":["4548"],"vndbCharacterId":"c27996"},"originalCharacterName":"藤島 あやめ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Stepmother of the protagonist. Half-Japanese."},{"spoiler":false,"text":"Regarded as a flawless superwoman, this capable woman became the chief of the Fujishima family."},{"spoiler":false,"text":"Following a philosophy of \"If one does not work, neither shall he eat\", she's very harsh towards people perceived as useless, even inside the household."}],"source":"vndb","sourceCharacterId":"c27996"},{"segments":[{"spoiler":false,"text":"義母。ハーフ。完璧超人系。全てにおいて万能で一族を実質に取り仕切るまでになっている。"},{"spoiler":false,"text":"周囲からも畏敬を抱かれている。"},{"spoiler":false,"text":"一族にとっては嫁の立場だがその有能さから親族たちは彼女を頼っているところが大きい。"},{"spoiler":false,"text":"働かざる者食うべからず的な発想で身内で無能な人間には厳しい。"},{"spoiler":false,"text":"一族を取り仕切る立場の上、街でも尊敬を集め議員になっており代表的な立場。"},{"spoiler":false,"text":"嫁いできた立場のため巨根崇拝意識は薄い。"},{"spoiler":false,"text":"ペット時は牝豚衣装。"},{"spoiler":false,"text":"主人公に豚女と書いてぶため呼ばわりされても喜ぶ。"}],"source":"egs","sourceCharacterId":"4548","sourceWorkId":"20801","spoiler":false},{"segments":[{"spoiler":false,"text":"義母。 ハーフ。 完璧超人系。"},{"spoiler":false,"text":"すべてにおいて万能で、畏敬され一族を実質取り仕切るまでになっている。"},{"spoiler":false,"text":"働かざる者食うべからず的な発想で、身内でも無能な人間には厳しい。"}],"source":"bangumi","sourceCharacterId":"69459"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07432edfc7962b80b5b69be04234486dea6ad3d4aedefc4f38fa5b3168e545cb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab3445694be19fa8f6fd64331d67011da030c968f0c99decf38cb1164e215253.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"美月華恋","creatorId":"vndb:s3114","sourcePersonId":"vndb:s3114","canonicalEntityId":"vndb:s3114","name":"美月 華恋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:173159:69459:25433:1","source":"bangumi"}]},{"characterId":"char_c27997","characterName":"藤島 咲姫","sourceIds":{"bangumi":[{"characterId":"69460","match":"exact-normalized-name-in-linked-work","subjectId":"173159"}],"egsCharacterIds":["4549"],"vndbCharacterId":"c27997"},"originalCharacterName":"藤島 咲姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ayame's daughter and Student Council President."},{"spoiler":false,"text":"A strong-willed young lady, accomplished in both studies and sports. Prideful and a sore loser, yet with an air of cuteness about her."},{"spoiler":false,"text":"Saki greatly admires her mother and works hard to earn her approval."}],"source":"vndb","sourceCharacterId":"c27997"},{"segments":[{"spoiler":false,"text":"ちょろ可愛いいところがあるツンデレお嬢様系。プライドが高くて負けず嫌い。"},{"spoiler":false,"text":"母親を尊敬している。主人公の巨根に負けてからは徹底的に隷属する。"},{"spoiler":false,"text":"主人公を巡って母にもライバル意識を燃やす。"},{"spoiler":false,"text":"ペニスに免疫がなく最初は腰を抜かす。"},{"spoiler":false,"text":"学園では姫様扱いでチヤホヤされる。"},{"spoiler":false,"text":"母への想いが強く母に認められたいがだめに努力して成績・スポーツなどでも優秀。"},{"spoiler":false,"text":"ペット時は牝豚衣装。"},{"spoiler":false,"text":"主人公に便姫呼ばわりされても喜ぶ。"},{"spoiler":false,"text":"生徒会長。"}],"source":"egs","sourceCharacterId":"4549","sourceWorkId":"20801","spoiler":false},{"segments":[{"spoiler":false,"text":"あやめの娘で、学園の生徒会長。"},{"spoiler":false,"text":"文武両道だがちょろ可愛いいところがある勝気お嬢様。"},{"spoiler":false,"text":"プライドが高くて負けず嫌い。"},{"spoiler":false,"text":"母親を尊敬しており、母に認められたいがために努力している。"}],"source":"bangumi","sourceCharacterId":"69460"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd4088e97af4e3eba7eb1349c0ed08dc8bbbc2e09b6279f89d966ec7972acfcb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69890dd180cf552cd16176bd7fed58541e97b293c1ce81b4e2a4daf6af96ab25.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:173159:69460:15684:1","source":"bangumi"}]},{"characterId":"char_c27998","characterName":"藤島 麗奈","sourceIds":{"bangumi":[{"characterId":"69461","match":"exact-normalized-name-in-linked-work","subjectId":"173159"}],"egsCharacterIds":["4550"],"vndbCharacterId":"c27998"},"originalCharacterName":"藤島 麗奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Woman of the Fujishima family who combines both voluptuousness and motherliness."},{"spoiler":false,"text":"A former celebrity, she became a good mother but is not that good with the housework."},{"spoiler":false,"text":"A cheerful and gutsy woman."}],"source":"vndb","sourceCharacterId":"c27998"},{"segments":[{"spoiler":false,"text":"妖艶さと母性を兼ね備えている。元女優やアイドル。"},{"spoiler":false,"text":"今はよき母になっているが家事などは苦手ぎみ。"},{"spoiler":false,"text":"明るくしっかり者。"},{"spoiler":false,"text":"現在は、趣味を兼ねて自分のデザインしたものを扱う宝飾店や飲食店を複数経営している。"},{"spoiler":false,"text":"ファッションや美食にうるさい。"},{"spoiler":false,"text":"母親性豪感覚で主人公の巨根を食べようとするが逆転される。"},{"spoiler":false,"text":"積極的に主人公を欲情させるようなプレイ、衣装などで奉仕。"},{"spoiler":false,"text":"娘にも主人公に対する媚態を教育する。"},{"spoiler":false,"text":"ペット時は牝犬衣装。"}],"source":"egs","sourceCharacterId":"4550","sourceWorkId":"20801","spoiler":false},{"segments":[{"spoiler":false,"text":"妖艶さと母性を兼ね備えている一族の女性。"},{"spoiler":false,"text":"元タレントで、今は良き母になっているが家事などは苦手ぎみ。"},{"spoiler":false,"text":"明るくしっかり者。"}],"source":"bangumi","sourceCharacterId":"69461"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8bbdde49fcc70013f7c52a9c4310d6dc06c470b16572e8f329f3a3bc531be822.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f31d59d74834304d153e530896c385b7931f1e3cefe33166b89c972073bc8c62.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由倉奈於","creatorId":"vndb:s923","sourcePersonId":"vndb:s923","canonicalEntityId":"vndb:s923","name":"由倉 奈於","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:173159:69461:6083:1","source":"bangumi"}]},{"characterId":"char_c27999","characterName":"藤島 律子","sourceIds":{"bangumi":[{"characterId":"69462","match":"exact-normalized-name-in-linked-work","subjectId":"173159"}],"egsCharacterIds":["4551"],"vndbCharacterId":"c27999"},"originalCharacterName":"藤島 律子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rena's daughter and member of the school's public morals committee."},{"spoiler":false,"text":"Seeing her free-spirited and extravagant mother as a good example of what not to do, Ritsuko grew up to be strict and stern."},{"spoiler":false,"text":"Proud of her Fujishima heritage and aware of it's importance, she feels disdain towards the unworthy main character."}],"source":"vndb","sourceCharacterId":"c27999"},{"segments":[{"spoiler":false,"text":"明るく享楽的、奔放なところがある母を反面教師として厳しく厳格に育った娘。"},{"spoiler":false,"text":"いわゆる武士娘で学校では風紀委員を詰め、周囲からは厳しいが尊敬されている。"},{"spoiler":false,"text":"一族としての自覚、誇りも強くそれに相応しくない主人公を蔑視・敵視している。"},{"spoiler":false,"text":"普段は寡黙でクールな美少女といった印象。"},{"spoiler":false,"text":"一族の誇り、家訓などを重視するため繁栄のための巨根崇拝意識はある。"},{"spoiler":false,"text":"ただし主人公への嫌悪も強い。"},{"spoiler":false,"text":"ペット時は牝犬衣装。"},{"spoiler":false,"text":"武道全般に通じているがその中でも特に弓道を得意としており弓道部の部長も務めている。"},{"spoiler":false,"text":"チンポに負けるのが好きな変態。"}],"source":"egs","sourceCharacterId":"4551","sourceWorkId":"20801","spoiler":false},{"segments":[{"spoiler":false,"text":"麗奈の娘で、学園の風紀委員。"},{"spoiler":false,"text":"享楽的・奔放なところがある母を反面教師として、厳しく厳格に育った娘。"},{"spoiler":false,"text":"周囲からは厳しいが尊敬されている。"},{"spoiler":false,"text":"一族としての自覚・誇りも強く、それに相応しくない主人公を蔑視している。"}],"source":"bangumi","sourceCharacterId":"69462"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/540e8c84c8cc45fc8082fd5d7bcc23fadd8b173438b8a5758d037655eb6a3339.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/086b9b2cd4cc60cc9d0a6916cbef63666e3b24aaadd010e708d7843a984b6ee7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"波野夏花","creatorId":"vndb:s3225","sourcePersonId":"vndb:s3225","canonicalEntityId":"vndb:s3225","name":"波野夏花(夏花)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:173159:69462:16169:1","source":"bangumi"}]},{"characterId":"char_c28000","characterName":"藤島 桃代","sourceIds":{"bangumi":[{"characterId":"69463","match":"exact-normalized-name-in-linked-work","subjectId":"173159"}],"egsCharacterIds":["4552"],"vndbCharacterId":"c28000"},"originalCharacterName":"藤島 桃代","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The most devoted mother and wife amongst the women of the Fujishima family."},{"spoiler":false,"text":"Overflowing with motherly charms, she lovingly supports her husband and daughter. A mother to her core."}],"source":"vndb","sourceCharacterId":"c28000"},{"segments":[{"spoiler":false,"text":"お嬢様育ちの良妻賢母。専業主婦。"},{"spoiler":false,"text":"優しく抱擁力があり夫と娘を慈しみ支えている。芯はしっかりしている。"},{"spoiler":false,"text":"貞淑→娘と一緒にヤリマンはしゃぎプレイ+献身的なプレイをみせる。"},{"spoiler":false,"text":"献身的な部分はキモメンギルドの僧侶のようなイメージ。"},{"spoiler":false,"text":"本人は政略結婚で結婚しているが夫に不満はなく夫、娘に愛情を注いでいる。"},{"spoiler":false,"text":"特に娘への愛は深く幼馴染との婚約を一族に無理をいって通している。"},{"spoiler":false,"text":"ペット時は牝猫衣装。"},{"spoiler":false,"text":"旦那は海外出張中。"}],"source":"egs","sourceCharacterId":"4552","sourceWorkId":"20801","spoiler":false},{"segments":[{"spoiler":false,"text":"一族の女性でお嬢様育ちの良妻賢母。"},{"spoiler":false,"text":"母性にあふれ抱擁力があり、夫と娘を慈しみ支えている。"},{"spoiler":false,"text":"また、母親として芯はしっかりとしている。"}],"source":"bangumi","sourceCharacterId":"69463"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22e71a34aa808f95399b62cfb950ef6af15b90412c39591c02d3756ee4cbf8a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/5449daf70d3f6a0818b5315c2b790a6f4865d5da7dc6c56615cfe9e4ab784142.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"霧島はるな","creatorId":"vndb:s2698","sourcePersonId":"vndb:s2698","canonicalEntityId":"vndb:s2698","name":"霧島はるな(水無月じゅん)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:173159:69463:13771:1","source":"bangumi"}]},{"characterId":"char_c28001","characterName":"藤島 るり","sourceIds":{"bangumi":[{"characterId":"69464","match":"exact-normalized-name-in-linked-work","subjectId":"173159"}],"egsCharacterIds":["4553"],"vndbCharacterId":"c28001"},"originalCharacterName":"藤島 るり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Momoyo's daughter. Quiet, shy and innocent."},{"spoiler":false,"text":"Docile and soothing, Ruri is like an angel who knows no filth. Seen as an ideal bride, she's very popular among the male students."}],"source":"vndb","sourceCharacterId":"c28001"},{"segments":[{"spoiler":false,"text":"容姿は母に似ているものの大人しくて引っ込み思案。清純派。"},{"spoiler":false,"text":"ゆるふわ系。汚れのない存在として男子人気が高い。"},{"spoiler":false,"text":"周囲からは汚れを知らないお姫様のような扱いを受けている。"},{"spoiler":false,"text":"ただし媚態などは知らないため母の教育でそれを覚えていく。"},{"spoiler":false,"text":"幼馴染の許嫁がいる。清い関係ながらお互い恋愛感情を育んでおり、娘の気持ちを汲んで本来なら政略結婚するところを母親が頼み込み幼馴染との許嫁を決めた。"},{"spoiler":false,"text":"ペット時は牝猫衣装。"}],"source":"egs","sourceCharacterId":"4553","sourceWorkId":"20801","spoiler":false},{"segments":[{"spoiler":false,"text":"桃代の娘。 おとなしくて引っ込み思案の清純派。"},{"spoiler":false,"text":"癒し系で家庭的。 汚れを知らない天使、理想の嫁として男子たちの人気が高い。"}],"source":"bangumi","sourceCharacterId":"69464"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68f79fabb8fa9d478c70bbe8ce03aae72ec0cc6c6c2d0192ed6b398754bd1082.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/242617dfefcea6308c6601b99bf6bea42217e25bf22dc09a540e357316ffea5c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間宮菜南子","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:173159:69464:15995:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p918","sourceCompanyId":"egs:brand:2797","canonicalEntityId":"vndb:p918","name":"Miel","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:20801:2797","source":"egs"},{"companyId":"vndb:p918","sourceCompanyId":"vndb:p918","canonicalEntityId":"vndb:p918","name":"Miel","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:40606:v15604","source":"vndb"},{"companyId":"vndb:p918","sourceCompanyId":"vndb:p918","canonicalEntityId":"vndb:p918","name":"Mie