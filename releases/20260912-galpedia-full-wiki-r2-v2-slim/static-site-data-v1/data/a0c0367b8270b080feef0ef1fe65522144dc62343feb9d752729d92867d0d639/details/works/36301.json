{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"36301","model":{"presentationWorkId":"vndb:v3913","staff":{"artwork":[{"creditedName":"志水 直隆","creatorId":"vndb:s2213","sourcePersonId":"vndb:s2213","canonicalEntityId":"vndb:s2213","name":"志水 なおたか","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:46062","source":"vndb"}],"scenario":[{"creditedName":"常盤 眼作","creatorId":"vndb:s3265","sourcePersonId":"vndb:s3265","canonicalEntityId":"vndb:s3265","name":"常盤 眼作","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:46065","source":"vndb"}],"music":[{"creditedName":"黄昏の夢","creatorId":"vndb:s2259","sourcePersonId":"vndb:s2259","canonicalEntityId":"vndb:s2259","name":"黄昏の夢","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:46063","source":"vndb"}],"other":[{"creditedName":"志水 直隆","creatorId":"vndb:s2213","sourcePersonId":"vndb:s2213","canonicalEntityId":"vndb:s2213","name":"志水 なおたか","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:46061","source":"vndb"},{"creditedName":"齋藤 紀子","creatorId":"vndb:s2345","sourcePersonId":"vndb:s2345","canonicalEntityId":"vndb:s2345","name":"齋藤 紀子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:46064","source":"vndb"}]},"cast":[{"characterId":"char_c41953","characterName":"小峰 美桃","sourceIds":{"bangumi":[{"characterId":"130024","match":"exact-normalized-name-in-linked-work","subjectId":"348549"}],"egsCharacterIds":["25494"],"vndbCharacterId":"c41953"},"originalCharacterName":"小峰 美桃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【いつも口煩い幼馴染】"},{"spoiler":false,"text":"健一の幼馴染にして、クラスメイト。"},{"spoiler":false,"text":"実は健一のことが好きなのだが、気恥ずかしさからつい彼と張り合っては苛めてしまう…というのはお約束。"},{"spoiler":false,"text":"自分のことは「ボク」と言う、元気いっぱいの女の子。"},{"spoiler":false,"text":"当面の悩みは、主人公が美術部をサボって来ないこと。"},{"spoiler":false,"text":"クラスの女の子のまとめ役で、何かあると先頭に立って男子に文句を言うタイプ。"},{"spoiler":false,"text":"とはいえ実は恋愛に憧れる普通の女の子。"},{"spoiler":false,"text":"主人公と張り合っているうちにクラスの女の子達に「頼りになる」というレッテルを貼られてしまっているので、自分を見失いかけている。"},{"spoiler":false,"text":"美術部に在籍しているが、絵はあまり得意ではない。"}],"source":"egs","sourceCharacterId":"25494","sourceWorkId":"36301","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼馴染にして、クラスメイト。自分のことはボクと言う、元気いっぱいの女の子。クラスの女の子のまとめ役で、何かあると先頭に立って男子に文句を言うタイプ。とはいえ実は恋愛に憧れる普通の女の子。"}],"source":"bangumi","sourceCharacterId":"130024"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/951f5b26634f4ac258e24bbff33a3e3d59ceba757e0877a026df0f7913e6fc0c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29ea411088f0f03c0046147202d0d3e24fa0650f83e17be172a889e8f59e8e01.webp","width":150,"height":217,"source":"static-detail"},"actors":[{"creditedName":"野上 奈々","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:25425","source":"vndb"}]},{"characterId":"char_c41954","characterName":"ぴんく","sourceIds":{"bangumi":[{"characterId":"130023","match":"exact-normalized-name-in-linked-work","subjectId":"348549"}],"egsCharacterIds":["25493"],"vndbCharacterId":"c41954"},"originalCharacterName":"ぴんく","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【幼馴染に憑依した悪魔】"},{"spoiler":false,"text":"以前、主人公の祖父に召喚され、あわよくば魂を持って帰ってやろうと考えていたらしいが、"},{"spoiler":false,"text":"あっさり『真実の名』を呼ばれ下僕に成り下がった幸薄い女悪魔。"},{"spoiler":false,"text":"本来の体は魔界にあり、この世界にとどまるには誰かしらの身体が必要。"},{"spoiler":false,"text":"精神と魔力の一部しか持ってこれないので、案外たいしたことは出来ない。"},{"spoiler":false,"text":"「ご飯」は主人公の精なので、基本的にエッチ好き。"},{"spoiler":false,"text":"ゲーム中では『美桃』の身体を拝借しているが、本人曰く「私の本体は絶世の美女なんですよぅ」と言い張っている。"},{"spoiler":false,"text":"とにかく悪魔らしくない穏やかな性格で、主人公に誉められると心から喜んでしまう。"},{"spoiler":false,"text":"基本的に主人公に絶対***なのだが、案外「そんなの駄目ですよぅ～」といさめる場合が多い。"}],"source":"egs","sourceCharacterId":"25493","sourceWorkId":"36301","spoiler":false},{"segments":[{"spoiler":false,"text":"悪魔らしくない穏やかな性格で、主人公に誉められると心から喜ぶ。美桃の体にとりついている。"}],"source":"bangumi","sourceCharacterId":"130023"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a2515a970df92894d740915beb70a29b3c4715794633145b6f0e5d5257da88e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24afe2e6936b9fc504b9cfbee33d1bf476a19f13704d069ebd31dc43ce609c0e.webp","width":150,"height":228,"source":"static-detail"},"actors":[{"creditedName":"野上 奈々","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:25426","source":"vndb"}]},{"characterId":"char_c41955","characterName":"南 由貴","sourceIds":{"bangumi":[{"characterId":"130026","match":"exact-normalized-name-in-linked-work","subjectId":"348549"}],"egsCharacterIds":["25496"],"vndbCharacterId":"c41955"},"originalCharacterName":"南 由貴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【変わった趣味の同級生】"},{"spoiler":false,"text":"美桃の同級生にして親友。"},{"spoiler":false,"text":"おっとりしていて温厚そうに見えるが、実は新入生から保健の先生まで何でも来いの真性レズ。"},{"spoiler":false,"text":"校内に沢山の恋人（もちろん全員美少女）を持ち、ある種のネットワークを構築している。"},{"spoiler":false,"text":"何故か主人公には気安く話し掛けてくるが、話題は「美桃ちゃんって、可愛いですわ～」っと、こんなのばっかり。"},{"spoiler":false,"text":"別に男嫌いではなく、「だって女の子の方が可愛いんですもの～」というのが理由。"},{"spoiler":false,"text":"おかげで主人公は学校のあちこちで彼女が女の子とエッチしているのを見かけることに・・・"},{"spoiler":false,"text":"もちろん美桃にもモーションを掛け続けているが、あっさりかわされて来た（というか、美桃が激ニブなため）。"},{"spoiler":false,"text":"茶道部に在籍している"}],"source":"egs","sourceCharacterId":"25496","sourceWorkId":"36301","spoiler":false},{"segments":[{"spoiler":false,"text":"美桃の同級生にして親友。茶道部に在籍している。"}],"source":"bangumi","sourceCharacterId":"130026"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/837ba98145c3c532329c22889e0516a73a483b8198fec4f9cc22d844e23cf184.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06ce65fdee941fd521f3937707f8a3e69350d54faac5bace3db8d11c2ac4d88f.webp","width":150,"height":217,"source":"static-detail"},"actors":[{"creditedName":"白井 綾乃","creatorId":"vndb:s665","sourcePersonId":"vndb:s665","canonicalEntityId":"vndb:s665","name":"あらい しずか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:25423","source":"vndb"}]},{"characterId":"char_c41956","characterName":"小峰 美鈴","sourceIds":{"bangumi":[{"characterId":"130025","match":"exact-normalized-name-in-linked-work","subjectId":"348549"}],"egsCharacterIds":["25495"],"vndbCharacterId":"c41956"},"originalCharacterName":"小峰 美鈴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mimomo's older sister."}],"source":"vndb","sourceCharacterId":"c41956"},{"segments":[{"spoiler":false,"text":"【美桃の姉＆主人公達の担任教諭】"},{"spoiler":false,"text":"まだ女子大生らしさの残る若手教師で、主人公とも知己の仲。"},{"spoiler":false,"text":"実は主人公の初恋の相手だが、告白すらしていない。"},{"spoiler":false,"text":"軽い性格と親しみやすさから生徒に人気が高いが、仕事の失敗は多い。"},{"spoiler":false,"text":"結構気分屋で、押しが強い。"},{"spoiler":false,"text":"学生時代からの彼氏が居るが、現在あまり上手くいっておらず主人公にコボしたりしている。"},{"spoiler":false,"text":"主人公の事は『可愛い弟』というスタンスで、基本的には妹の美桃と上手く行くことを願っているが…"},{"spoiler":false,"text":"主人公相手にエッチなつまみ食いをすることに関しては、別に罪悪感は無かったり。"}],"source":"egs","sourceCharacterId":"25495","sourceWorkId":"36301","spoiler":false},{"segments":[{"spoiler":false,"text":"美桃の姉で、主人公達の担任教諭。まだ女子大生らしさの残る若手教師。軽い性格と親しみやすさから生徒に人気が高い一方、仕事の失敗は多い。"}],"source":"bangumi","sourceCharacterId":"130025"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/502e6897e0601a4ca44a44e3eecd99c48cc2d0e2c57088d26ee31813e947121b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c60bf48a1e0434675225128dec840e4cfeec31adc7423e9777fd618bb0cadf5a.webp","width":150,"height":219,"source":"static-detail"},"actors":[{"creditedName":"原 由菓","creatorId":"vndb:s1112","sourcePersonId":"vndb:s1112","canonicalEntityId":"vndb:s1112","name":"原 由菓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:25424","source":"vndb"}]},{"characterId":"char_c41957","characterName":"沢村 果歩","sourceIds":{"bangumi":[{"characterId":"130027","match":"exact-normalized-name-in-linked-work","subjectId":"348549"}],"egsCharacterIds":["25497"],"vndbCharacterId":"c41957"},"originalCharacterName":"沢村 果歩","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【美術部の後輩】"},{"spoiler":false,"text":"美桃の美術部の後輩で、普段は口数の少ないおしとやかで物腰の穏やかなお嬢様。"},{"spoiler":false,"text":"よく気がつき、なんとなく主人公を慕っているような態度見え隠れする。"},{"spoiler":false,"text":"料理が得意で、主人公にお弁当を作ってきたりする事も。"},{"spoiler":false,"text":"極度の恥ずかしがり屋で、すぐ赤面してしまう大人しいタイプだが、"},{"spoiler":false,"text":"何故か主人公には積極的に接してくる。"},{"spoiler":false,"text":"主人公と親しい美桃を、ちょっと意識している。"}],"source":"egs","sourceCharacterId":"25497","sourceWorkId":"36301","spoiler":false},{"segments":[{"spoiler":false,"text":"美桃の美術部の後輩。普段は口数の少ないおしとやかで物腰の穏やかなお嬢様。極度の恥ずかしがり屋で、すぐ赤面してしまう大人しいタイプ。しかし何故か主人公には積極的に接してくる。"}],"source":"bangumi","sourceCharacterId":"130027"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d2863e8e542568ffd9eda03b9bdd012e12f70ebb7021acddea7e23c8c2b43e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27a74bafd63e85635cd72653692c9862b9e18d008e4bc67c92b5c866f0af37e7.webp","width":150,"height":216,"source":"static-detail"},"actors":[{"creditedName":"葉月 ミカ","creatorId":"vndb:s121","sourcePersonId":"vndb:s121","canonicalEntityId":"vndb:s121","name":"川崎 恵理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:25422","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p89","sourceCompanyId":"egs:brand:210","canonicalEntityId":"vndb:p89","name":"トラヴュランス","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:36301:210","source":"egs"},{"companyId":"vndb:p89","sourceCompanyId":"vndb:p89","canonicalEntityId":"vndb:p89","name":"トラヴュランス","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:14955:v3913","source":"vndb"},{"companyId":"vndb:p1899","sourceCompanyId":"vndb:p1899","canonicalEntityId":"vndb:p1899","name":"株式会社コンテンツトラフィック","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:14956:v3913","source":"vndb"},{"companyId":"vndb:p89","sourceCompanyId":"vndb:p89","canonicalEntityId":"vndb:p89","name":"トラヴュランス","roleCodes":["developer","publisher"],"identityStatus":"source-native","rela