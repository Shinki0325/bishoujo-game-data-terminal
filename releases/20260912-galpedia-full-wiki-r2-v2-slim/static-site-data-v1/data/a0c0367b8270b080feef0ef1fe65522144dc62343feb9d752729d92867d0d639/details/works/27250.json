poiler":false},{"segments":[{"spoiler":false,"text":"アグラリエル王国を治める女王。ハイエルフの血筋であり、アルミアの母親。"},{"spoiler":false,"text":"エルフの国を豊かに繁栄させハイエルフとダークエルフの争いを止めさせて、"},{"spoiler":false,"text":"ナルルースを近衛騎士としたのもこの女王である。"},{"spoiler":false,"text":"本人はそういった功績を鼻にかけることもなく、民のための治世を行い、名君として慕われている。"},{"spoiler":false,"text":"「生憎ですが、招かれざる客のお相手は出来ません。お下がりなさい」"}],"source":"bangumi","sourceCharacterId":"78123"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55fd08a4916cb8367f917ea63940497afd7fbaaa43ee053be3c3c0de8e6cd4c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18c41424a6a06e61c595af0e5845af7ebb45c32c9d5024e36951e0bef69000f7.webp","width":157,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266231:78123:4940:1","source":"bangumi"}]},{"characterId":"char_c77789","characterName":"ナルルース＝ルィンヘン","sourceIds":{"bangumi":[{"characterId":"78124","match":"exact-normalized-name-in-linked-work","subjectId":"266231"}],"egsCharacterIds":["23576"],"vndbCharacterId":"c77789"},"originalCharacterName":"ナルルース＝ルィンヘン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A dark elf charged with protecting the queen."},{"spoiler":false,"text":"As a dark elf she was originally at conflict with the high elves, however after Ephildis became queen their relationships improved. As proof of friendship between high and dark elves, Narrus was appointed as a knight in the queen's guard."},{"spoiler":false,"text":"Princess Almia adores her as an older sister and while she is aware of her own position, she also values Almia like a younger sister."},{"spoiler":false,"text":"Unlike elves or high elves as a dark elf she has some resistance to hypnosis, so while her body can be control he consciousness remains."}],"source":"vndb","sourceCharacterId":"c77789"},{"segments":[{"spoiler":false,"text":"褐色のダークエルフという種族で女王の守護騎士。"},{"spoiler":false,"text":"もともとハイエルフとは対立していたダークエルフだがエフィルディスが女王となってからは関係が改善され、友好の証として『女王の守護騎士』という立場を与えられた。"},{"spoiler":false,"text":"アルミア姫からは姉のようにも慕われており、自分の立場をわきまえないといけないと自制しながらもアルミアを妹のように大事に思っている。"},{"spoiler":false,"text":"エルフやハイエルフと違いダークエルフの精神は催眠に抵抗をもつが、それ故に正気のままに体だけ操られ嬲られてしまう。"}],"source":"egs","sourceCharacterId":"23576","sourceWorkId":"27250","spoiler":false},{"segments":[{"spoiler":false,"text":"褐色のダークエルフという種族で女王の守護騎士。"},{"spoiler":false,"text":"もともとハイエルフとは対立していたダークエルフだが、"},{"spoiler":false,"text":"エフィルディスが女王となってからは関係が改善され、"},{"spoiler":false,"text":"友好の証として『女王の守護騎士』という立場を与えられた。"},{"spoiler":false,"text":"アルミア姫からは姉のようにも慕われており、"},{"spoiler":false,"text":"自分の立場をわきまえないといけないと自制しながらも、"},{"spoiler":false,"text":"アルミアを妹のように大事に思っている。"},{"spoiler":false,"text":"エルフやハイエルフと違いダークエルフの精神は催眠に抵抗をもつが、"},{"spoiler":false,"text":"それ故に正気のままに体だけ操られ嬲られてしまう。"},{"spoiler":false,"text":"「私を見出して下さった女王の為にも、この王国を守らなければ……」"}],"source":"bangumi","sourceCharacterId":"78124"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"23576","sourceWorkId":"27250","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"23576","sourceWorkId":"27250","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source