{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"9571","model":{"presentationWorkId":"vndb:v4408","staff":{"artwork":[{"creditedName":"瀬浦沙悟","creatorId":"vndb:s2964","sourcePersonId":"egs:creator:9544","canonicalEntityId":"vndb:s2964","name":"瀬浦沙悟","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:46562","source":"egs"}],"scenario":[{"creditedName":"松本竜","creatorId":"vndb:s708","sourcePersonId":"egs:creator:1245","canonicalEntityId":"vndb:s708","name":"松本竜","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:46563","source":"egs"},{"creditedName":"そのだまさき","creatorId":"vndb:s596","sourcePersonId":"egs:creator:900","canonicalEntityId":"vndb:s596","name":"そのだまさき","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:46564","source":"egs"},{"creditedName":"栗栖","creatorId":"vndb:s720","sourcePersonId":"egs:creator:2594","canonicalEntityId":"vndb:s720","name":"栗栖","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:46565","source":"egs"}],"music":[{"creditedName":"溝口哲也","creatorId":"vndb:s628","sourcePersonId":"egs:creator:3375","canonicalEntityId":"vndb:s628","name":"溝口哲也","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:46569","source":"egs"}],"other":[{"creditedName":"wavedash","creatorId":"vndb:s27654","sourcePersonId":"vndb:s27654","canonicalEntityId":"vndb:s27654","name":"Greg Deng","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:49655","source":"vndb"},{"creditedName":"Murderous Int","creatorId":"vndb:s42742","sourcePersonId":"vndb:s42742","canonicalEntityId":"vndb:s42742","name":"Murderous Int","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:49656","source":"vndb"},{"creditedName":"spirkality","creatorId":"vndb:s42744","sourcePersonId":"vndb:s42744","canonicalEntityId":"vndb:s42744","name":"spirkality","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:49657","source":"vndb"},{"creditedName":"EDEN","creatorId":"vndb:s536","sourcePersonId":"vndb:s536","canonicalEntityId":"vndb:s536","name":"EDEN","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49658","source":"vndb"},{"creditedName":"チーム・やしガニ","creatorId":"vndb:s593","sourcePersonId":"vndb:s593","canonicalEntityId":"vndb:s593","name":"チーム・やしガニ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49659","source":"vndb"},{"creditedName":"松本 竜","creatorId":"vndb:s708","sourcePersonId":"vndb:s708","canonicalEntityId":"vndb:s708","name":"松本 竜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49663","source":"vndb"},{"creditedName":"笹＠","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:49665","source":"vndb"},{"creditedName":"笹＠","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49666","source":"vndb"}]},"cast":[{"characterId":"char_c29489","characterName":"サラ・スコーピオン","sourceIds":{"bangumi":[{"characterId":"49551","match":"exact-normalized-name-in-linked-work","subjectId":"80595"}],"egsCharacterIds":["19703"],"vndbCharacterId":"c29489"},"originalCharacterName":"サラ・スコーピオン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the empire’s knights. Leader of the Scorpion Legion, a group that’s part-mercenary, part-pirate. A feared pirate, known as pirate knight Sara."},{"spoiler":false,"text":"After searching for the long-lost treasured sword for many years, she makes a deal with the Duke of Blankenheim, a member of a powerful family of the empire that holds information concerning the treasured sword. In exchange for such information, the Duke orders her to capture his antagonist, the hero of the Wales Tributory Alliance, Sylia of the Silver. A catastrophic dilemma falls upon Sara as a result of this."}],"source":"vndb","sourceCharacterId":"c29489"},{"segments":[{"spoiler":false,"text":"本編主人公。"},{"spoiler":false,"text":"半海賊半傭兵スコーピオン兵団の首領にして、帝国騎士の一人。"},{"spoiler":false,"text":"“海賊騎士サラ”の異名をもって恐れられる女海賊。"},{"spoiler":false,"text":"帝国の権門・ブランケンハイム公が彼女が捜し求めていた宝剣の情報を持っているこたことから、その情報と引き換えに、彼と敵対するウェールズ諸侯同盟の英雄・白銀のシリア捕縛の依頼を引き受ける。"},{"spoiler":false,"text":"「私は海賊………海賊には海賊の戦い方があるのよ！　甲冑のお嬢様」"}],"source":"egs","sourceCharacterId":"19703","sourceWorkId":"9571","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公。帝国騎士の一人。"},{"spoiler":false,"text":"半海賊半傭兵スコーピオン兵団の首領。海賊騎士サラの異名をもって恐れられる女海賊。"},{"spoiler":false,"text":"長年、さる宝剣の在り処を探っていたサラは、宝剣に関する情報を持つ帝国の権門・ブランケンハイム公と取り引きし、情報と引き換えに彼と敵対するウェールズ諸侯同盟の英雄、白銀のシリア捕縛の任務を引き受ける事に。しかしこの事がキッカケに、サラに絶対絶命の窮地が訪れる事となる。"},{"spoiler":false,"text":"「私は海賊………海賊には海賊の戦い方があるのよ！　甲冑のお嬢様」"}],"source":"bangumi","sourceCharacterId":"49551"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53d3737d701d07c2c97ac85af897e9fd735697c8634d5869dae94e42807547ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da415977e90b4c911b7aafa6a3c3edbc830f9b367061171e1c850463127da467.webp","width":199,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本井えみ","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80595:49551:4177:1","source":"bangumi"}]},{"characterId":"char_c29490","characterName":"シリア・フォン・ベルンシュタイン","sourceIds":{"bangumi":[{"characterId":"49552","match":"exact-normalized-name-in-linked-work","subjectId":"80595"}],"egsCharacterIds":["19704"],"vndbCharacterId":"c29490"},"originalCharacterName":"シリア・フォン・ベルンシュタイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sylia of the Silver, a feared knight and hero of the Wales Tributory Alliance."},{"spoiler":false,"text":"Thought to be the strongest knight in the galaxy, her skills as a knight surpass even Hans and Sara. The daughter of the powerful Bernstein noble family of Wales. She was forced to serve as general to protect the land of Wales. The lords of Wales don’t have territorial ambitions, and only wish for Wales’s safety. However, the Duke of Blankenheim believed that to be weak, and is the cause of him having his own territorial ambitions. Sylia realized this and began to plan to counter-attack the Duke of Blankenheim. During this time, though, the pirate Sara appeared before her."}],"source":"vndb","sourceCharacterId":"c29490"},{"segments":[{"spoiler":false,"text":"ウェールズ諸侯同盟の英雄・白銀のシリアと恐れられる女騎士。"},{"spoiler":false,"text":"騎士としての実力は、サラやサラの副官・ハンスを凌駕する。"},{"spoiler":false,"text":"ウェールズの有力貴族・ベルンシュタイン家の令嬢だったが、戦乱の続く世の中で、ウェールズの地を守るために将軍に担ぎ上げられた。"},{"spoiler":false,"text":"ウェールズには領土的な野心がなく、それが隣国のブランケンハイム公からは弱気に受け取られ、侵略の憂き目に遭う。"},{"spoiler":false,"text":"「落ち着け！　お前たちはこのシリア・フォン・ベルンシュタインの兵士であろう!!」"}],"source":"egs","sourceCharacterId":"19704","sourceWorkId":"9571","spoiler":false},{"segments":[{"spoiler":false,"text":"ウェールズ諸侯同盟の英雄、白銀のシリアと恐れられる女騎士。"},{"spoiler":false,"text":"銀河最強の騎士と目されており、実際騎士としての実力はサラやハンスを凌駕する。ウェールズの有力貴族ベルンシュタイン家の令嬢で、戦乱の中、ウェールズの地を守るために将軍に押し上げられた経緯がある。"},{"spoiler":false,"text":"ウェールズ諸侯は領土的野心はまったくなく、ウェールズの安全のみを考えている。しかしそれが逆に隣接するブランケンハイム公には弱気に映り、領土的野心を持たせる原因になっている。シリアはその事を見抜き、ブランケンハイム公への反撃を企図していたが、その途上で彼女の前に海賊騎士サラが現れる。"},{"spoiler":false,"text":"「落ち着け!!　お前たちはこのシリア・フォン・ベルンシュタインの兵士であろう!!"},{"spoiler":false,"text":"女海賊一人に動揺する部下など私は持った覚えはないぞ!!」"}],"source":"bangumi","sourceCharacterId":"49552"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/075a942c110c10bad8f17dd5b3db1d003e271cfeb8d567df1e49385cf5bebf0e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b564ee04f8a3d6749a94dcb1d71f092aed83ac08d63d54f2f1454ecbe75aa52f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永井ちひろ","creatorId":"vndb:s530","sourcePersonId":"vndb:s530","canonicalEntityId":"vndb:s530","name":"永井 ちひろ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80595:49552:18652:1","source":"bangumi"}]},{"characterId":"char_c29491","characterName":"カリン・フォン・ギーレン","sourceIds":{"bangumi":[{"characterId":"49553","match":"exact-normalized-name-in-linked-work","subjectId":"80595"}],"egsCharacterIds":["19705"],"vndbCharacterId":"c29491"},"originalCharacterName":"カリン・フォン・ギーレン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"gender":{"reviewState":"source-only","source":"vndb","value":"f"},"sex":{"reviewState":"source-only","source":"vndb","value":"b"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Head of the Gielen family. The older of the twin sisters. One of the empire’s knights."},{"spoiler":false,"text":"Rules the planet that Sara infiltrated to steal the treasured sword. Believed to be a quiet ruler of the land they possess, with their main trade being sight-seeing and the mining of rare metals. However, she has deep ties with the underworld, and is thought to be something like the mafia of space. As moral order has deteriorated under the galactic empire’s thousand year rule, so too has the degeneracy of nobles increased. The twins have made a killing off of this by dealing in human-trafficking and illegal drug trade with said nobles."}],"source":"vndb","sourceCharacterId":"c29491"},{"segments":[{"spoiler":false,"text":"ギーレン男爵家の当主にして帝国騎士の一人。"},{"spoiler":false,"text":"双子姉妹の姉。"},{"spoiler":false,"text":"彼女の治める惑星は、表向きは平和を第一とする態度を示しながら、裏では闇世界と深い繋がりがあり、宇宙マフィアとしての顔を持つ。"},{"spoiler":false,"text":"退廃的な暮らしに溺れる貴族たちを相手に、人身売買や違法ドラッグの売買で莫大な利益を上げているらしい。"},{"spoiler":false,"text":"「ええ、もちろん。凄い楽しみが増えたわね、セシル♪」"}],"source":"egs","sourceCharacterId":"19705","sourceWorkId":"9571","spoiler":false},{"segments":[{"spoiler":false,"text":"ギーレン男爵家の当主。双子姉妹の姉。帝国騎士の一人。"},{"spoiler":false,"text":"主人公が宝剣を奪おうと潜り込んだ惑星を支配している貴族。観光とレアメタルの採掘を主な産業として、平和に領土を収めている穏健な領主、と思われているが、実は裏では闇世界と深い繋がりを持った宇宙マフィアといった顔を待つ。"},{"spoiler":false,"text":"銀河帝国千年支配の風紀の乱れは著しく、特に特権階級である貴族たちの退廃は顕著。双子姉妹はそんな貴族相手に人身売買や違法ドラッグの売買で莫大な利益を上げている。"},{"spoiler":false,"text":"「ええ、もちろん。凄い楽しみが増えたわね、セシル♪」"}],"source":"bangumi","sourceCharacterId":"49553"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"b","source":"vndb","sourceCharacterId":"c29491","value":"b"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"19705","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"19705","value":"女性"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e0e192bba7f7950bc8f4017ddf62f982ed6ff072b041be70d74c367689265dc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb996a142b1bc4ccdb80a21e30bef23a3835e634e9c053c95357ae592335ec74.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80595:49553:6106:1","source":"bangumi"}]},{"characterId":"char_c29492","characterName":"セシル・フォン・ギーレン","sourceIds":{"bangumi":[{"characterId":"17883","match":"exact-normalized-name-in-linked-work","subjectId":"80595"}],"egsCharacterIds":["19706"],"vndbCharacterId":"c29492"},"originalCharacterName":"セシル・フォン・ギーレン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"gender":{"reviewState":"source-only","source":"vndb","value":"f"},"sex":{"reviewState":"source-only","source":"vndb","value":"b"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The younger of the twin sisters. One of the empire’s knights."},{"spoiler":false,"text":"The only distinguishing feature from her big sister is that she speaks and acts somewhat childlishy, as exhibited by the fact she always carries a large stuffed animal with her. It’s also worth noting that various weapons, such as hand grenades, machine guns, and gas spray are hidden within said stuffed animal."}],"source":"vndb","sourceCharacterId":"c29492"},{"segments":[{"spoiler":false,"text":"双子姉妹の妹。帝国騎士の一人。"},{"spoiler":false,"text":"容姿は姉と変わらないが、口調や性格がやや幼く、大きなぬいぐるみを常に持ち歩いている相違点がある。"},{"spoiler":false,"text":"そのぬいぐるみには、ガス噴射やマシンガン、手榴弾などといった様々な兵器が隠されている。"},{"spoiler":false,"text":"「とっても刺激的なお姉さま♪」"}],"source":"egs","sourceCharacterId":"19706","sourceWorkId":"9571","spoiler":false},{"segments":[{"spoiler":false,"text":"セシル・フォン・ギーレン。双子の妹。帝国騎士の一人。"},{"spoiler":false,"text":"姉とまったく同じ容姿だがいつも持っている大きなぬいぐるみと口調、性格が少し幼いところが唯一の区別するポイント。ちなみにぬいぐるみには、ガス噴射やマシンガン、手榴弾など様々な兵器が隠されている。"}],"source":"bangumi","sourceCharacterId":"17883"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"b","source":"vndb","sourceCharacterId":"c29492","value":"b"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"19706","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"19706","value":"女性"},{"comparisonValue":"f","source":"bangumi","sourceCharacterId":"17883","value":"女"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03d2ca13f489d1ee0db19e4a68acec5cde1e6b0d20cab84f1665824fee81a5e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fc245efb8170296902d12665a645275cc94a5b81d8b5a99e7f7b94ed928a3b7.webp","width":256,"height":163,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80595:17883:6106:1","source":"bangumi"}]},{"characterId":"char_vndb_c29493","characterName":"ハンス・ビューロー","sourceIds":{"vndbCharacterId":"c29493"},"originalCharacterName":"ハンス・ビューロー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Vice leader of the Scorpion Legion and Sara’s adjutant. One of the empire’s knights. A skilled soldier wielding a photon lance, and also Sara’s arms instructor."},{"spoiler":false,"text":"Sara trusts him the most out of anyone, and they have been together since before the formation of the Scorpion Legion. Subordinates believe that friction exists between Sara and Hans as a result of him scolding her for her actions at times and also for fielding his own plans to Sara."}],"source":"vndb","sourceCharacterId":"c29493"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f0f3f2a5708a7a0b1380bcd50db6a16970e28d43f28efadf38d6fbbf50f9a9e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bba5e0a8086706ecff1a7519a2d4a7eff80f1bbfef75ca85cb5c73ed2f09c95.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c29494","characterName":"ブランケンハイム公ヨハヒム","sourceIds":{"vndbCharacterId":"c29494"},"originalCharacterName":"ブランケンハイム公ヨハヒム","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The present Duke of Blankenheim. One of the great nobles descended from the imperial family."},{"spoiler":false,"text":"Blankenheim have over 600 years of authority in the galaxy, and possess a fortune from owning mines filled with rare metals. He has had and was raised with authority as a noble in his personal life, and has lived a life of debauchery since he was young. Believes that only nobles are real people. He is a terribly cowardly person at heart, but also extremely calculating and malicious. He’s worked on his looks as he’s aged, and has spent a ludicrous amount of money buying beautiful women from the twins to submit to his cruel deeds. Since the emperor’s assassination he’s burned with desire to take that highest of seats, strengthening his armed forces with a ”bigger is better”-like creed."}],"source":"vndb","sourceCharacterId":"c29494"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3392f904fd0ad1f289b821d74435452fe62f6bc2bc6fb6df3d2170f8fedd52d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef157f32bb55bbd896ed2fbfe45e385fdf370ce857effa6c15e23f4eff751e2d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1413","sourceCompanyId":"egs:br