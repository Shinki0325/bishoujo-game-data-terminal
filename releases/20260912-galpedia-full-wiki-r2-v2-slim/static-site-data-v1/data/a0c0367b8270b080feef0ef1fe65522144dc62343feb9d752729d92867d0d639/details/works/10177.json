{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"10177","model":{"presentationWorkId":"vndb:v790","staff":{"artwork":[{"creditedName":"きのはらひかる","creatorId":"vndb:s2803","sourcePersonId":"egs:creator:582","canonicalEntityId":"vndb:s2803","name":"きのはらひかる","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:55542","source":"egs"}],"scenario":[{"creditedName":"御子石大郁","creatorId":"vndb:s21940","sourcePersonId":"egs:creator:1879","canonicalEntityId":"vndb:s21940","name":"御子石大郁","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:55543","source":"egs"}],"music":[],"other":[{"creditedName":"本間 ゆかり","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:15664","source":"vndb"}]},"cast":[{"characterId":"char_c64978","characterName":"ザブダス","sourceIds":{"bangumi":[{"characterId":"58939","match":"exact-normalized-name-in-linked-work","subjectId":"219174"}],"egsCharacterIds":["19016"],"vndbCharacterId":"c64978"},"originalCharacterName":"ザブダス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ウァバの従姉で、オダエナトゥスの姪にあたる少女。"},{"spoiler":false,"text":"武芸を好み、矛の腕においてはパルミュラ一と称されるが、実は、実戦経験はない。"},{"spoiler":false,"text":"武勇に優れる兄に憧れ、日々の鍛錬に励んでいるが、少々、ブラコンの気があるような……。"},{"spoiler":false,"text":"「もはや兄に恨みはない…わたしも物心付く前のことで覚えていない…」"}],"source":"egs","sourceCharacterId":"19016","sourceWorkId":"10177","spoiler":false},{"segments":[{"spoiler":false,"text":"マエオニウス之妹。ウァバ的表姐，也就是オダエナトクス的侄女。"},{"spoiler":false,"text":"双亲在其小时候就因政变死去了。她极其喜欢武术，对枪的造诣无出其右。但是却缺乏实战经验。"},{"spoiler":false,"text":"爱慕着英勇的哥哥，每天都发奋努力。稍微有些兄控情节……"}],"source":"bangumi","sourceCharacterId":"58939"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c9889f5216d260b128feedca48a8dbb27f34b25b8d550a8d91b7b3b18d8c6fd2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30d92cdd9a7d05256c2d67b947e5fa0e31f938ef2f4e33033fbdb3e65430cb20.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木川絵理子","creatorId":"vndb:s1634","sourcePersonId":"vndb:s1634","canonicalEntityId":"vndb:s1634","name":"木川 絵理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219174:58939:4668:1","source":"bangumi"}]},{"characterId":"char_c64980","characterName":"マエオニウス","sourceIds":{"bangumi":[{"characterId":"58943","match":"exact-normalized-name-in-linked-work","subjectId":"219174"}],"egsCharacterIds":["19018"],"vndbCharacterId":"c64980"},"originalCharacterName":"マエオニウス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ザブダスの兄。"},{"spoiler":false,"text":"オダエナトゥスから絶大な信頼を受けており、彼の親衛隊長を務める優秀な将軍。"},{"spoiler":false,"text":"右も左もわからなかった主人公を、友人として導く。"}],"source":"egs","sourceCharacterId":"19018","sourceWorkId":"10177","spoiler":false},{"segments":[{"spoiler":false,"text":"ザブダス的哥哥，也是オダエナトゥス、パト的外甥。深受オダエナトゥス的信赖，担任着他的亲卫队长职务，是个优秀的将领。"},{"spoiler":false,"text":"武勇过人，对于ユージ（主人公）而言是亦师亦友的存在。"},{"spoiler":false,"text":"ザブダスの兄。ウァバの従兄でオダエナトゥス、パトの甥。"},{"spoiler":false,"text":"オダエナトゥスから絶大な信頼を受けており、彼の親衛隊長を務める優秀な将軍。"},{"spoiler":false,"text":"武勇に優れ、アンティオキア夜襲戦では、多くの敵将を討ち取る手柄を示す。"},{"spoiler":false,"text":"右も左もわからなかったユージを、友人として導く役割を担う。"}],"source":"bangumi","sourceCharacterId":"58943"}],"profileFacts":[],"metadataCandidateConflic