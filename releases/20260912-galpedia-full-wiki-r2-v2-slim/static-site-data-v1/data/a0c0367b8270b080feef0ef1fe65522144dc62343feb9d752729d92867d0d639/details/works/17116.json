ped":true},{"label":"体重（本版本）","value":"46 kg","valueContext":null,"source":"egs","sourceCharacterId":"8436","sourceWorkId":"17116","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/960f23ee1acbd057612bc5d1c9a6af52de5ab1b0660184e1b0aa535984249d37.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7966d6edcaf0820cecd06ebed2f446667ea641693959fa736412b812500b0a2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"悠 はるか","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:48097","source":"vndb"}]},{"characterId":"char_c22187","characterName":"天賀谷 凌汰","sourceIds":{"bangumi":[{"characterId":"210211","match":"exact-normalized-name-in-linked-work","subjectId":"265127"}],"egsCharacterIds":["8438"],"vndbCharacterId":"c22187"},"originalCharacterName":"天賀谷 凌汰","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"189"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"90"}},"descriptions":[{"segments":[{"spoiler":false,"text":"兄夫婦の家に浪人生として居候することになる主人公。"},{"spoiler":false,"text":"容姿は普通以下で、自堕落な生活により、若くして腹が出始めている。"},{"spoiler":false,"text":"身長は兄よりも大きいが、それすらネガティブに考えてしまっている。"},{"spoiler":false,"text":"体臭も強く、汗っかきなので、女性にはあまり好まれない。"},{"spoiler":false,"text":"幼い頃から兄と比べられ続けていたので、自分に自信が持てず、どこか歪んでいる面もある。"},{"spoiler":false,"text":"兄や母親から、常にプレッシャーをかけられておりストレスとなっている。"},{"spoiler":false,"text":"外見の暗い雰囲気とは違い、ある程度普通のコミュニケーションは可能。"},{"spoiler":false,"text":"頭は特別悪いわけではないが、比較対象が優秀なため、下に見られる。"},{"spoiler":false,"text":"そのため学業に対するモチベーションが上がらない。"},{"spoiler":false,"text":"家族の中で唯一優しくしてくれるのが父親のみ。"},{"spoiler":false,"text":"兄嫁との関係は悪くはないが、性的な目線で見ていることを隠すために、積極的には交流を持とうとはしていない。"}],"source":"egs","sourceCharacterId":"8438","sourceWorkId":"17116","spoiler":false},{"segments":[{"spoiler":false,"text":"兄夫婦の家に浪人生として居候することになる主人公。"},{"spoiler":false,"text":"容姿は普通以下で、自堕落な生活により、若くして腹が出始めている。"},{"spoiler":false,"text":"身長は兄よりも高いが、それすらネガティブに考えてしまっている。"},{"spoiler":false,"text":"体臭が強く汗っかきなので、女性にはあまり好まれない。"},{"spoiler":false,"text":"幼い頃から兄と比べられ続けていたので自分に自信が持てず、どこか歪んでいる面もある。"},{"spoiler":false,"text":"外見は暗い雰囲気だが、ある程度普通のコミュニケーションは可能。"},{"spoiler":false,"text":"家族の中で唯一優しくしてくれるのは父親のみ。 兄や母親からは常にプレッシャーをかけられており、ストレスとなっている。"},{"spoiler":false,"text":"兄嫁との関係は悪くはないが、性的な目線で見ていることを隠すため、積極的には交流を持とうとはしていない。"},{"spoiler":false,"text":"また、優秀な兄の妻を “好き” になることは彼のプライドがさらに傷つくことになるため、無意識的に避けている。"}],"source":"bangumi","sourceCharacterId":"210211"}],"profileFacts":[{"label":"身高（本版本）","value":"189 cm","valueContext":null,"source":"egs","sourceCharacterId":"8438","sourceWorkId":"17116","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6d070682cfc59b89eabf946a85f3bb192e25669d0994203aae278d0943dc18c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a317ce666529c55356bd2011d3c12abcd1349fbdf297d4b668d8d3e9827fa486.webp","width":85,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c22188","characterName":"富樫 秋南","sourceIds":{"bangumi":[{"characterId":"210210","match":"exact-normalized-name-in-linked-work","subjectId":"265127"}],"egsCharacterIds":["8437"],"vndbCharacterId":"c22188"},"originalCharacterName":"富樫 秋南","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"98"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflic