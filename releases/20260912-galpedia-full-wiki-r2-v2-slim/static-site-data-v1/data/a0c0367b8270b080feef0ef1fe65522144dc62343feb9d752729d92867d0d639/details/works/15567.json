いる。"}],"source":"egs","sourceCharacterId":"11975","sourceWorkId":"13845","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2ee264cd631b7857f33cd9e5487764eda089f44f309404a93d485dd1e7ccab6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4d9f6fc67cca401f6967b2f6924e1836f348add1e2b7317653031db82bae591.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"釘宮 理恵","creatorId":"vndb:s500","sourcePersonId":"vndb:s500","canonicalEntityId":"vndb:s500","name":"釘宮理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26138","source":"vndb"}]},{"characterId":"char_c72790","characterName":"カル・ルスラン","sourceIds":{"bangumi":[{"characterId":"13360","match":"exact-normalized-name-in-linked-work","subjectId":"14529"}],"egsCharacterIds":["11974"],"vndbCharacterId":"c72790"},"originalCharacterName":"カル・ルスラン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"帝国ジュニア・アカデミー第二学年所属。"},{"spoiler":false,"text":"１４年前の統一戦争で帝国軍に滅ぼされた小国「ルスラン」のお姫様であるが、現在は王家復興を願う多くの遺臣たち期待を一身に背負いつつ帝都で勉学に励む。"},{"spoiler":false,"text":"そしてもうひとつ裏の顔は、違法Ｅテクノロジー研究および、違法Ｅウェポンを取り締まる政府組織「パシアテ文明保存管理局」、通称“ライブラリ”の学生エージェント。"},{"spoiler":false,"text":"相手がライブラリの命令に応じず強硬手段に出る場合は、超重機動兵「アルパー」を呼び出し戦闘も行う。"},{"spoiler":false,"text":"長身でスタイル抜群、凛とした美貌を備えた美少女。"},{"spoiler":false,"text":"実年齢よりずっと大人びて見えるため学校では一目置かれ、近寄りがたいと思われることもあるが、根は正直者、生真面目な努力家。"}],"source":"egs","sourceCharacterId":"11974","sourceWorkId":"13845","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b591830fa81ad8f0686ba6049201cecc10f5882b676272679c9d60682c26ea7b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d15434ebb4c5f57723851e0f28be5ce4e80aec7911879a649397dab07d12ce0.webp","width":256,"height":251,"source":"static-detail"},"actors":[{"creditedName":"茅原実里","creatorId":"vndb:s1459","sourcePersonId":"vndb:s1459","canonicalEntityId":"vndb:s1459","name":"茅原 実里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14529:13360:4421:1","source":"bangumi"}]},{"characterId":"char_c72791","characterName":"プラウラ","sourceIds":{"bangumi":[],"egsCharacterIds":["11978"],"vndbCharacterId":"c72791"},"originalCharacterName":"プラウラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公カルの幼少期から、身の回りの世話を勤める女従者のひとり。"},{"spoiler":false,"text":"ルスラン王国重臣の娘。"},{"spoiler":false,"text":"長い睫、聡明そうなまなざし。スラリとしたモデルのような痩身。"},{"spoiler":false,"text":"抜群の美貌とスタイル。人当たりがよく、おまけに料理上手。"},{"spoiler":false,"text":"さらには表面的な性格も良い。……が美しい外見と裏腹に、その内実は腹黒な謀略家。"},{"spoiler":false,"text":"主人カルへの究極的な忠誠心を除いては、世の中のあらゆるモラルから開放されたモンスター。"},{"spoiler":false,"text":"主家ルスランのお家再興のためには、人倫に外れた汚れ仕事に手を染めることも厭わない。"},{"spoiler":false,"text":"同僚のファルツ同様、Ｅウェポンを用いた武技に精通しているが、なかでも射撃が得意。"}],"source":"egs","sourceCharacterId":"11978","sourceWorkId":"13845","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbf7a160e75cd669ee38aa159db522d47b8ac73c4fbc9a56494493e835e23f99.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55c6ad4df066058571155e724560f9ca1c0884ef559560a476d42f4aa113e634.webp","width":150,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神田 朱未","creatorId":"vndb:s1666","sourcePersonId":"vndb:s1666","canonicalEntityId":"vndb:s1666","name":"神田 朱未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26140","source":"vndb"}]},{"characterId":"char_c72792","characterName":"ガラクシア","sourceIds":{"bangumi":[],"egsCharacterIds":["11977"],"vndbCharacterId":"c72792"},"originalCharacterName":"ガラクシア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"統一戦争における戦いにおいて、帝国軍に滅ぼされた某王国の決戦兵器らしいが、その詳細は謎に包まれている。"}],"source":"egs","sourceCharacterId":"11977","sourceWorkId":"13845","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f9a139253865293c2a807912aeac1fdb6e242b3605237fc0487459428721ea7b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2543a0de0f5d24c137764e9b39e88f7b3896b569d08879d67c6d60318ad1821.webp","width":212,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今井 麻美","creatorId":"vndb:s240","sourcePersonId":"vndb:s240","canonicalEntityId":"vndb:s240","name":"今井 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26136","source":"vndb"}]},{"characterId":"char_c72793","characterName":"ミルスキ・リーンネ","sourceIds":{"bangumi":[],"egsCharacterIds":["11976"],"vndbCharacterId":"c72793"},"originalCharacterName":"ミルスキ・リーンネ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"生まれながらにして様々な力を備えた超能力者(パーセプター)にして、帝都内の治安維持を務める海軍のパーセプター部隊“ヤクトファルク”の隊長。"},{"spoiler":false,"text":"高位の帝国貴族リーンネ家の出身であり、14才という年齢にして軍の特殊部隊を任されている。"},{"spoiler":false,"text":"融通の利かない生真面目屋ながら、基本的には明るく素直な性格。物腰も礼儀正しい。"},{"spoiler":false,"text":"社会的に差別されがちなパーセプターの権利獲得のため功を焦っているところがある。"},{"spoiler":false,"text":"その気負いと若年ゆえの経験不足から、要らぬ失敗を重ねることも。"},{"spoiler":false,"text":"帝都の治安を脅かす“汚染者”に単独で対抗し得る存在であり、他の隊員たちとも一線を画した強大な能力を持つ。"}],"source":"egs","sourceCharacterId":"11976","sourceWorkId":"13845","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8deedf53d09192bdc8416f4160cfae263039d6775f81a5785384f85ae0055e3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fc6c9df7e339e769a82d4f4a791d8bed49847b496fb25540922e0e24b0c9b3b.webp","width":167,"height":256,"source":"static-detail"},"actors":[{"creditedName":"福井 裕佳梨","creatorId":"vndb:s10439","sourcePersonId":"vndb:s10439","canonicalEntityId":"vndb:s10439","name":"福井 裕佳梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26142","source":"vndb"}]},{"characterId":"char_c76236","characterName":"トアラ・ラボアキン","sourceIds":{"bangumi":[],"egsCharacterIds":["11980"],"vndbCharacterId":"c76236"},"originalCharacterName":"トアラ・ラボアキン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"フルクラム帝国支配圏にある小王国から、帝国ジュニアアカデミーに留学してきた王族の少年。第二学年所属。"},{"spoiler":false,"text":"小柄な体つきのため、実際の年より幼くみられることが多い。"},{"spoiler":false,"text":"帝国到着早々、留学初日にＥテクノロジー絡みのテロ事件に巻き込まれ、それが縁でカルと知り合う。以後、なにかにつけ彼女と行動をともにすることに。"},{"spoiler":false,"text":"性格は素直で純朴。田舎者で世間知らずな反面、存続の危機に立たされるほどの深刻な財政難に苦しむ貧乏小国の出身のためか、芯はかなり強く、知恵も回る。"},{"spoiler":false,"text":"真っ正直で、物の裏の読むことが苦手なカルの知恵袋的なポジション。"},{"spoiler":false,"text":"また学年成績トップクラスの知能を活かし、アカデミーで試験があるたびに、彼女の臨時家庭教師を務めている。"}],"source":"egs","sourceCharacterId":"11980","sourceWorkId":"13845","spoiler":false}],"profileFacts":[],"metada