{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"5205","model":{"presentationWorkId":"egs:5205","staff":{"artwork":[{"creditedName":"ZUN","creatorId":"egs:creator:2843","sourcePersonId":"egs:creator:2843","canonicalEntityId":"egs:creator:2843","name":"ZUN","roleCode":"artwork","roleLabel":"原画","identityStatus":"alias-only-review","relationId":"egs:work-creator:9063","source":"egs"}],"scenario":[{"creditedName":"ZUN","creatorId":"egs:creator:2843","sourcePersonId":"egs:creator:2843","canonicalEntityId":"egs:creator:2843","name":"ZUN","roleCode":"scenario","roleLabel":"剧本","identityStatus":"alias-only-review","relationId":"egs:work-creator:9064","source":"egs"}],"music":[{"creditedName":"ZUN","creatorId":"egs:creator:2843","sourcePersonId":"egs:creator:2843","canonicalEntityId":"egs:creator:2843","name":"ZUN","roleCode":"music","roleLabel":"作品音乐","identityStatus":"alias-only-review","relationId":"egs:work-creator:9066","source":"egs"}],"other":[]},"cast":[{"characterId":"char_bangumi_10478","characterName":"蕾米莉亚·斯卡雷特","sourceIds":{"bangumi":[{"characterId":"10478","match":"source-roster","subjectId":"104009"},{"characterId":"10478","match":"source-roster","subjectId":"1146"},{"characterId":"10478","match":"source-roster","subjectId":"1148"},{"characterId":"10478","match":"source-roster","subjectId":"1150"},{"characterId":"10478","match":"source-roster","subjectId":"1151"},{"characterId":"10478","match":"source-roster","subjectId":"1153"},{"characterId":"10478","match":"source-roster","subjectId":"2134"}]},"originalCharacterName":"蕾米莉亚·斯卡雷特","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"初登场时为500岁的萝莉吸血鬼，红魔馆女主人，像贵族般注重威严和体面，性格跟外表一样非常孩子气而任性。害怕流动的水、阳光（会变蒸气，吸到蒸气的人会长生不死）、洋葱，但不怕十字架 (因为不知道有什么好怕)。曾经为了自己方便，将幻想乡笼罩在一片红雾之中（东方红魔乡）。似乎很爱喝咲夜泡的红茶（加B型血的红茶）。"}],"source":"bangumi","sourceCharacterId":"10478"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"10478","value":"吸血鬼"},{"label":"能力","source":"bangumi","sourceCharacterId":"10478","value":"操纵命运程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f690d22104f8f111475b1447410272bb87e8f7bccce675c2c305c56607c2853f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11010676fb7eab35e4a04aa8922af5f5f7a65a2e7771da6ad731f94b3003fe69.webp","width":128,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_10480","characterName":"恶魔之妹","sourceIds":{"bangumi":[{"characterId":"10480","match":"source-roster","subjectId":"1146"},{"characterId":"10480","match":"source-roster","subjectId":"1151"}]},"originalCharacterName":"恶魔之妹","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"初登场时为495岁的吸血鬼，蕾米的妹妹，可是力量却比蕾米强很多。由于精神不稳定的关系一直被蕾米关在红魔馆未曾出去过，不知道人类就是她平常吃的点心。"}],"source":"bangumi","sourceCharacterId":"10480"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"10480","value":"吸血鬼"},{"label":"能力","source":"bangumi","sourceCharacterId":"10480","value":"破坏存在的事物程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83964f3e3af22566a8ca21a95d195500ba42e6ab42946c8501fe92af1d3f5fa0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a98ff5cda8cad829040672041cbf2227e3ea9f22ff84f76db02decbdeaa60ef5.webp","width":200,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_12688","characterName":"十六夜 咲夜","sourceIds":{"bangumi":[{"characterId":"12688","match":"source-roster","subjectId":"104009"},{"characterId":"12688","match":"source-roster","subjectId":"1146"},{"characterId":"12688","match":"source-roster","subjectId":"1148"},{"characterId":"12688","match":"source-roster","subjectId":"1150"},{"characterId":"12688","match":"source-roster","subjectId":"1151"},{"characterId":"12688","match":"source-roster","subjectId":"1153"},{"characterId":"12688","match":"source-roster","subjectId":"2134"},{"characterId":"12688","match":"source-roster","subjectId":"329342"},{"characterId":"12688","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"十六夜 咲夜","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"她是住在红魔馆并在里面工作的女仆。是被称之为恶魔之馆的红魔馆中唯一的人类，是女仆们的仆长。"},{"spoiler":false,"text":"她是个在普通人类不敢接近的地方工作的不可思议的少女。"},{"spoiler":false,"text":"没人见过她在进入红魔馆之前是怎样的。而且她对幻想乡里人类的来访极为冷淡，常站在妖怪的阵营之中。所以人们觉得她不是幻想乡的人类，有可能是外面世界或者是别的世界来的人。"},{"spoiler":false,"text":"她没有和村落里任何人类亲近，身上含有许多谜。"},{"spoiler":false,"text":"不过，当她去村落买东西时，她会一脸愉快，一点也没有敌视人类的样子。"}],"source":"bangumi","sourceCharacterId":"12688"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"12688","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"12688","value":"操纵时间的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/badfc65679c51a64f83971b2fbcf3fd13d46dab33013f71db781edf64f76f640.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a45982af2e686a3ac26458362bc4b1715751ec4821b9bd2da5964412df51d2bd.webp","width":186,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_20127","characterName":"大酱","sourceIds":{"bangumi":[{"characterId":"20127","match":"source-roster","subjectId":"1146"}]},"originalCharacterName":"大酱","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"大妖精是个住在红魔馆附近湖畔的妖精。跟其他妖精一样，她总是很精神也很喜欢恶作剧，性格简单，凭感情行事。"},{"spoiler":false,"text":"没有台词，没有SC，也没有立绘，总归就是一个“杂鱼角色”（ZUN语），跟剧情“没什么关系”（ZUN语）。"},{"spoiler":false,"text":"大妖精与琪露诺是好朋友，《三月精》里有她和琪露诺经常玩捉迷藏的说明。"},{"spoiler":false,"text":"“大妖精”的“大”，是一个敬称，表示这只妖精比一般妖精要强，与身体大小没有直接关系，相同用法的有：“大德鲁伊”、“大魔法师”等（这一点就如同“小恶魔”的“小”表示她是恶魔中较弱的一只，而不是身体小）。大妖精的英文名称是“Great Fairy”。"}],"source":"bangumi","sourceCharacterId":"20127"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"20127","value":"妖精"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6548f53a08287b7f0bea2652c04de3c4e8c53a660789eb1d4550c829c432ec5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98592443d6b6b88b592c4035e7191031fb28a044e24c2826921fbf080ea66d9a.webp","width":111,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_20128","characterName":"Little Devil","sourceIds":{"bangumi":[{"characterId":"20128","match":"source-roster","subjectId":"1146"}]},"originalCharacterName":"Little Devil","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"小恶魔是《红魔乡》登场的杂鱼角色，官方关于她的资料几乎为零。除非她再次出场，否则其身份仍然是谜。"},{"spoiler":false,"text":"在《东方红魔乡》事件发生时她居住在红魔馆内。她的真正身份无从得知，但很多人相信是她是帕秋莉的助手。"},{"spoiler":false,"text":"小恶魔发射的子弹是巨大的气泡形，因此会遮住她自己的样子，很难看清长相。弹幕结构较为简单，由巨大的气泡形子弹和细小的子弹交错而成。"}],"source":"bangumi","sourceCharacterId":"20128"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"20128","value":"恶魔"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6d49c9115de8cba82cf8857a6f9884e65e58be6ef69882bbca47cc936770d7f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88dadcfde89e2d62fba70862ef2e781c5f37fe6b9e87076eed4fdc5b136dabb1.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_4647","characterName":"Rumia","sourceIds":{"bangumi":[{"characterId":"4647","match":"source-roster","subjectId":"1146"},{"characterId":"4647","match":"source-roster","subjectId":"1151"}]},"originalCharacterName":"Rumia","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"在妖怪之中属于弱者，拥有让其周围无论昼夜都是一片黑暗这能力的，就是露米娅。"},{"spoiler":false,"text":"这妖怪产生的黑暗，是让火把都失去作用的魔法之暗，闯入其中的人类的视野会降低得无异于失明。被趁着这种黑暗被袭击的话可能撑不了一时半刻，不过幸好她不会和别的妖怪一同行动。"},{"spoiler":false,"text":"外表是年幼的少女，赤眼，头发是黄色的并系着一条红色缎带，据说是穿着黑色的衣服目的是为了融入黑暗之中，但是由于通常都处在黑暗之中所以很难确认。"},{"spoiler":false,"text":"也许是作为黑暗的怪物，通常都会被人害怕，不过在看到她真实姿态的人都因为其年幼少女的外表会有点失望。可能将身形包裹在黑暗之中就是为了隐藏她的外貌。"},{"spoiler":false,"text":"还有，黑暗的能力只是辅助性的，袭击人类的时候都是凭力量来进行。由于外表只是看起来的样子而已，究竟她有多强仍是疑问，在黑暗中又无法分出胜负。看不到退路的话是令人恐惧的。"}],"source":"bangumi","sourceCharacterId":"4647"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"4647","value":"妖怪"},{"label":"能力","source":"bangumi","sourceCharacterId":"4647","value":"操纵黑暗程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08daa55a5424d896e7b7a0bb99d8b3db73513390382bfbc36c069b2bb5e69af5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a043cb267d8821f393d535e61832e72419ce8780999cf3883386eb71102e563b.webp","width":128,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_485","characterName":"博麗靈夢","sourceIds":{"bangumi":[{"characterId":"485","match":"source-roster","subjectId":"104009"},{"characterId":"485","match":"source-roster","subjectId":"1146"},{"characterId":"485","match":"source-roster","subjectId":"1148"},{"characterId":"485","match":"source-roster","subjectId":"1150"},{"characterId":"485","match":"source-roster","subjectId":"1151"},{"characterId":"485","match":"source-roster","subjectId":"1153"},{"characterId":"485","match":"source-roster","subjectId":"1155"},{"characterId":"485","match":"source-roster","subjectId":"1157"},{"characterId":"485","match":"source-roster","subjectId":"1160"},{"characterId":"485","match":"source-roster","subjectId":"12696"},{"characterId":"485","match":"source-roster","subjectId":"131875"},{"characterId":"485","match":"source-roster","subjectId":"1395"},{"characterId":"485","match":"source-roster","subjectId":"2134"},{"characterId":"485","match":"source-roster","subjectId":"329342"},{"characterId":"485","match":"source-roster","subjectId":"430567"},{"characterId":"485","match":"source-roster","subjectId":"5752"},{"characterId":"485","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"博麗靈夢","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幻想乡境内博丽神社的现有巫女。"},{"spoiler":false,"text":"博丽神社是专门守护幻想乡不可缺少的大结界的神社。博丽的巫女代代以解决异变为事业。"},{"spoiler":false,"text":"她是历代巫女中最缺乏危机感的一位，不知是因为修行不足，还是因为已经拥有足够的实力。"},{"spoiler":false,"text":"她天生地幸运和敏锐，也退治了不少妖怪。"}],"source":"bangumi","sourceCharacterId":"485"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"485","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"主要是在空中飞行的程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"作为博丽巫女的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"在空中飞行的程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"操纵灵气的程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f33007c417ade7c73b7ee78244285c2ff601da86919605a6f56c0570deb01c0c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc26d83763ce8144e0a342eaeb5a41bf3e1756ec782d0268170ef9bac39c8489.webp","width":237,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_486","characterName":"霧雨魔理沙","sourceIds":{"bangumi":[{"characterId":"486","match":"source-roster","subjectId":"104009"},{"characterId":"486","match":"source-roster","subjectId":"1146"},{"characterId":"486","match":"source-roster","subjectId":"1148"},{"characterId":"486","match":"source-roster","subjectId":"1150"},{"characterId":"486","match":"source-roster","subjectId":"1151"},{"characterId":"486","match":"source-roster","subjectId":"1153"},{"characterId":"486","match":"source-roster","subjectId":"1155"},{"characterId":"486","match":"source-roster","subjectId":"1157"},{"characterId":"486","match":"source-roster","subjectId":"1160"},{"characterId":"486","match":"source-roster","subjectId":"12696"},{"characterId":"486","match":"source-roster","subjectId":"131875"},{"characterId":"486","match":"source-roster","subjectId":"1395"},{"characterId":"486","match":"source-roster","subjectId":"2134"},{"characterId":"486","match":"source-roster","subjectId":"329342"},{"characterId":"486","match":"source-roster","subjectId":"430567"},{"characterId":"486","match":"source-roster","subjectId":"5752"},{"characterId":"486","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"霧雨魔理沙","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"居住于魔法森林的人类魔法使，常骑着扫把，「霧雨店」的独生女。會使用魔法森林的蘑菇調製火藥，所使用的魔法幾乎只有把東西破壞的效果，而且燃料需要長時間準備，但是其效果非常強力，在Spell Card規則成立下，純粹的破壞力在人類當中屬於最高等級。此外在幻想乡是出了名的小偷，帕邱莉的图书馆、香霖堂，如果不是古明地觉会读心术，甚至连地灵殿都会惨遭毒手。"}],"source":"bangumi","sourceCharacterId":"486"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"486","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"486","value":"使用魔法程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e00e4df671f5f80d5733c44e4b69596b901aad88177fc335789c2dd5ea6b2d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3bd6c6ab5c1df20f216ccf8f7e1581841d4fed04fe2cad0f92ce726df7fb8d1.webp","width":237,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_488","characterName":"知识与避世的少女","sourceIds":{"bangumi":[{"characterId":"488","match":"source-roster","subjectId":"1146"},{"characterId":"488","match":"source-roster","subjectId":"1148"},{"characterId":"488","match":"source-roster","subjectId":"1150"},{"characterId":"488","match":"source-roster","subjectId":"1151"},{"characterId":"488","match":"source-roster","subjectId":"1153"},{"characterId":"488","match":"source-roster","subjectId":"1155"},{"characterId":"488","match":"source-roster","subjectId":"2134"}]},"originalCharacterName":"知识与避世的少女","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大概有100岁的魔女，平常待在红魔馆里面的图书馆的知识分子，有气喘的毛病。擅长操纵七曜（火水木金土日月），名言是“凡物都有属性。所谓的属性，跟弱点是一样的东西”。"},{"spoiler":false,"text":"Patchouli→广藿香（一种香草，因此她有“帕琪”“香草”一类的昵称），Knowledge→知识"}],"source":"bangumi","sourceCharacterId":"488"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"488","value":"魔女、魔法使"},{"label":"能力","source":"bangumi","sourceCharacterId":"488","value":"使用魔法程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"488","value":"使用魔法（主要是属性）程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"488","value":"使用魔法（主要是精灵魔法）的程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"488","value":"操纵火+水+木+金+土+日+月的程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8493e88bcc7680de30e8b9e6e66890ad487612a220d97d4b7f4da9fa8fe97d9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de86334f8179285b5b96f03c533ec39d91050913e666646d4b78d3ba0862f3c0.webp","width":151,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_74480","characterName":"冴月麟","sourceIds":{"bangumi":[{"characterId":"74480","match":"source-roster","subjectId":"1146"}]},"originalCharacterName":"冴月麟","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"冴月麟是预定在《东方红魔乡》中出场的人物，可能是主角，但在开发阶段被神主神隐，现在只能在《红魔乡》主程序的源代码中找到她的痕迹。"},{"spoiler":false,"text":"如果你用文本方式打开红魔乡.exe，就能在其他主角附近找到“冴月麟”的名字。"},{"spoiler":false,"text":"可以看出，原本她设定为可以使用“风”符和“花”符，但由于制作时间不足，因此这名角色未能出场。"},{"spoiler":false,"text":"没有官方造型，一设中没有任何立绘，也没有任何造型的描述。"},{"spoiler":false,"text":"在亚特兰大AWA座谈会上有人向ZUN问了有关冴月麟的问题："},{"spoiler":false,"text":"Q：能给我们讲讲红魔乡里的未用角色冴月麟吗？"},{"spoiler":false,"text":"ZUN"},{"spoiler":false,"text":"不好意思，能重复一遍角色名字吗？啊啊啊啊啊啊啊啊啊啊啊啊啊！你们知道的，我本来想更多的开发红魔乡。毕竟这是我的第一部windows作品嘛。但是我的时间预计不太对，迫于时间紧迫我不得不去掉了很多安排。她只是一个由于时间限制必须去掉的角色而已，我本来是打算让她当自机的。"}],"source":"bangumi","sourceCharacterId":"74480"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d85c168005e0c3529486c9b0dad5fa81c63e43d59643625f3ae90529cfe345fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c83a41611c21ef4ae059e339b72e189492b49d04c85e7bc6b95edf4050a9b617.webp","width":256,"height":239,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_890","characterName":"湖上的冰精","sourceIds":{"bangumi":[{"characterId":"890","match":"source-roster","subjectId":"104009"},{"characterId":"890","match":"source-roster","subjectId":"1146"},{"characterId":"890","match":"source-roster","subjectId":"1150"},{"characterId":"890","match":"source-roster","subjectId":"2134"},{"characterId":"890","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"湖上的冰精","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"在雾之湖的附近，即使是夏天也会出现极端低温。这时候常能遇到的妖精就是冰之妖精。"},{"spoiler":false,"text":"她是湖附近妖精们中的领袖般的存在，力量也比其他妖精强。她是属于好战型的，所以必须留神。"},{"spoiler":false,"text":"她身高颇低，穿蓝色的衣服，背后有冰之羽翼。"},{"spoiler":false,"text":"她有操控冷气的能力。能瞬间冻结小东西，比普通的妖精更危险。一直在释放冷气的她周围总是很寒冷。"},{"spoiler":false,"text":"人们不知道她住在哪里，也无法得知她平时的生活是怎样的。不光是琪露诺，所有的妖精都能溶入大自然之中，所以人类们看不见。"}],"source":"bangumi","sourceCharacterId":"890"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"890","value":"妖精"},{"label":"能力","source":"bangumi","sourceCharacterId":"890","value":"操控冷气程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25af4f6889a331e39b0794d719a1f9518b4db2435d771266f0facafae6918544.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bbae3be8cbaf201d20a01a4252681feb495db0eacefea46e8410e4782bb64341.webp","width":180,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_891","characterName":"中国","sourceIds":{"bangumi":[{"characterId":"891","match":"source-roster","subjectId":"1146"},{"characterId":"891","match":"source-roster","subjectId":"1151"},{"characterId":"891","match":"source-roster","subjectId":"1153"},{"characterId":"891","match":"source-roster","subjectId":"2134"}]},"originalCharacterName":"中国","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"红魔馆的门卫，外表和人类一样，身穿中国风的服装，身手敏捷，擅长武术，很少使用奇怪的妖术。"}],"source":"bangumi","sourceCharacterId":"891"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"891","value":"妖怪"},{"label":"能力","source":"bangumi","sourceCharacterId":"891","value":"运用气程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89eb0b92b5535ad1b1d26f43e6a8b3f7aa420498af3bc36262c7bacddbe9d2d1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c77ddb506dcd6dddad5701b208b0e10e4902210cb7a30d86a578a52d2228f52.webp","width":126,"height":254,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:997","sourceCompanyId":"egs:brand:997","canonicalEntityId":"egs:brand:997","name":"上海アリス幻樂団","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:5205:997","source":"egs"}],"missingStates":["confirmed-character-relation-missing","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
