{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"9622","model":{"presentationWorkId":"vndb:v1247","staff":{"artwork":[{"creditedName":"かん奈(岩本幸子、如月かん奈)","creatorId":"vndb:s4821","sourcePersonId":"egs:creator:232","canonicalEntityId":"vndb:s4821","name":"かん奈(岩本幸子、如月かん奈)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:80139","source":"egs"}],"scenario":[{"creditedName":"衆堂ジョオ","creatorId":"vndb:s1136","sourcePersonId":"egs:creator:5403","canonicalEntityId":"vndb:s1136","name":"衆堂ジョオ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:38880","source":"egs"}],"music":[{"creditedName":"曽谷コウヘイ","creatorId":"vndb:s10269","sourcePersonId":"egs:creator:12454","canonicalEntityId":"vndb:s10269","name":"曽谷コウヘイ","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:65801","source":"egs"}],"other":[{"creditedName":"騎西ソアラ","creatorId":"vndb:s5114","sourcePersonId":"egs:creator:2251","canonicalEntityId":"vndb:s5114","name":"騎西ソアラ","detail":"効果音、デバッグ","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:186578","source":"egs"},{"creditedName":"かん奈","creatorId":"vndb:s4821","sourcePersonId":"vndb:s4821","canonicalEntityId":"vndb:s4821","name":"かん奈(岩本幸子、如月かん奈)","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:22134","source":"vndb"}]},"cast":[{"characterId":"char_c57509","characterName":"宮乃大王院 煌々","sourceIds":{"bangumi":[{"characterId":"221811","match":"exact-normalized-name-in-linked-work","subjectId":"218688"}],"egsCharacterIds":["19561"],"vndbCharacterId":"c57509"},"originalCharacterName":"宮乃大王院 煌々","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"世界有数の大財閥・宮乃大王院家の跡取り娘。"},{"spoiler":false,"text":"傍若無人で高飛車、ツンデレ、人間暴風、歩く非常識など、迷惑極まりない性格に見えるが、それは苦労や不自由な生活をしたことがないかららしい。"},{"spoiler":false,"text":"一馬を執事（奴隷？）としてこき使うが、彼が「煌々様」と呼んだりすると、とたんに不機嫌になるようで……。"},{"spoiler":false,"text":"「ほう……初めて聞く名だが、学食とはそのように珍味であるか」"}],"source":"egs","sourceCharacterId":"19561","sourceWorkId":"9622","spoiler":false},{"segments":[{"spoiler":false,"text":"世界有数の大財閥、宮乃大王院家の跡取り。高飛車、偉そう、ツンデレ。歩く暴風（いろんな意味で）。"},{"spoiler":false,"text":"突然、主人公の部屋に押しかけ、ことあるごとに問題を巻き起こすのだが、それはおよそ苦労や不自由を感じたことのない人生を送ってきたゆえに決定的に常識が欠如しているからであり、性格は素直で良い子。"},{"spoiler":false,"text":"主人公を執事（奴隷？）としてこき使うが、主人公がいかにも執事として「煌々様」と呼んだりするとトタンに不機嫌になる不思議。"},{"spoiler":false,"text":"「将来にそなえて宮乃（以下略）の跡取りたるもの“えっち”にも慣れておかなければ」というピントのずれた建前で、無理矢理主人公と関係を結んだりする。だがエッチの知識も偏っていたり勘違いしているため、よくわからないコスプレ系Hやらが多くなる。"}],"source":"bangumi","sourceCharacterId":"221811"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4d714e3fa8fb1918d6604bd9e56ea8a675b62d689a0daa17a439f236721ba03.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d5d7fe07bd1761f8b64e5f5507a5c9a201663a3e1b64532cde12ed366880549.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高村優里","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218688:221811:13512:1","source":"bangumi"}]},{"characterId":"char_c57510","characterName":"夕霧 姫子","sourceIds":{"bangumi":[{"characterId":"221812","match":"exact-normalized-name-in-linked-work","subjectId":"218688"}],"egsCharacterIds":["19562"],"vndbCharacterId":"c57510"},"originalCharacterName":"夕霧 姫子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、委員長を務める常識人。"},{"spoiler":false,"text":"キツイ物言いとツリ目から倦厭されがちだが、容姿は結構美人。"},{"spoiler":false,"text":"徹底したモラル人なため、常識知らずで一馬を振り回す煌々に苛立ち、彼女のワガママに応える一馬に対しても、お小言が絶えない。"},{"spoiler":false,"text":"でもその言動は、一馬に寄せる淡い想いの裏返し。"},{"spoiler":false,"text":"煌々と対立することで、徐々に一馬との距離を詰める結果になるが……？"},{"spoiler":false,"text":"「ちょっとちょっとちょっと、これってどういうことなの!?」"}],"source":"egs","sourceCharacterId":"19562","sourceWorkId":"9622","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメート。キツイ物言いとツリ目ゆえ、倦厭されてしまうことが多いが、その容姿は結構美少女。（でも貧乳。負け犬キャラ）"},{"spoiler":false,"text":"委員長という立場にあることからもわかるように、非常にモラルの高い常識人。それゆえ常識知らずで日々主人公を引っ張り回す（迷惑をかける）煌々にいらだつ。"},{"spoiler":false,"text":"同時に、そんな煌々のわがままに応える主人公に対しても、ついついキツイ一言。でもそれは、一馬のことを憎からず思っている気持ちの裏返し。"},{"spoiler":false,"text":"煌々と対立することで、徐々に主人公との距離をつめたりして、三人の微妙な力関係が変化。それが煌々のジェラシーの要因となり……？"},{"spoiler":false,"text":"※サブヒロインのためエッチシーンはありません"}],"source":"bangumi","sourceCharacterId":"221812"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b027369f4c4a3936f31b7a5619cb6276a1459f07af968af0a70f3d782ed22bac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9df5e9294d2a2271cae4290b5b087f7b17d0b7e48bceac464fa80e4bb0dd4ff.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永井ちひろ","creatorId":"vndb:s530","sourcePersonId":"vndb:s530","canonicalEntityId":"vndb:s530","name":"永井 ちひろ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218688:221812:18652:1","source":"bangumi"}]},{"characterId":"char_vndb_c57511","characterName":"六条 一馬","sourceIds":{"vndbCharacterId":"c57511"},"originalCharacterName":"六条 一馬","characterNameSource":null,"role":"main","status":"source-only-candidate","