":[{"spoiler":false,"text":"“響”の元同級生で、個撮モノのＡＶを世に送り出す新進気鋭のＡＶ監督。"},{"spoiler":false,"text":"基本的には面倒見のいい性格で、女性にも優しい。"},{"spoiler":false,"text":"ＡＶ出演は決して強制や騙しうちをすることはなく、あくまで提案に留め、女性の自由意思に任せている。"},{"spoiler":false,"text":"自分の撮影したＡＶが世に送り出され、それが多くの男性を満足させていることにやり甲斐を感じている。"},{"spoiler":false,"text":"そのため金を荒稼ぎしたい欲求はなく、必要以上の贅沢をしたり、必要以上に溜め込んだりという趣味はない。"},{"spoiler":false,"text":"次回作のために、お眼鏡に適う女性を探していた。"}],"source":"egs","sourceCharacterId":"19089","sourceWorkId":"26241","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_c67877","characterName":"花菱 響","sourceIds":{"bangumi":[{"characterId":"200020","match":"exact-normalized-name-in-linked-work","subjectId":"238991"}],"egsCharacterIds":["19088"],"vndbCharacterId":"c67877"},"originalCharacterName":"花菱 響","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"元レディースで男勝りできっぷのいい性格を持った一児の母。"},{"spoiler":false,"text":"言動から男勝りな面ばかりが目立つが、恋愛感情に理想を抱く乙女チックなところも。"},{"spoiler":false,"text":"生活に困窮するあまり最後の手段として身体を売ろうとし、トラブルになったところで“誠一郎”に助けられた。"},{"spoiler":false,"text":"それどころか、当面の生活費を援助されることに。"},{"spoiler":false,"text":"恩を受けっぱなしではいけないと、自らの意思で“誠一郎”の作るＡＶへの出演を決める。"}],"source":"egs","sourceCharacterId":"19088","sourceWorkId":"26241","spoiler":false},{"segments":[{"spoiler":false,"text":"元レディースで男勝りできっぷのいい性格を持った一児の母。"},{"spoiler":false,"text":"言動から男勝りな面ばかりが目立つが、"},{"spoiler":false,"text":"恋愛感情に理想を抱く乙女チックなところも。"},{"spoiler":false,"text":"生活に困窮するあまり最後の手段として身体を売ろうとし、"},{"spoiler":false,"text":"トラブルになったところで“誠一郎”に助けられた。"},{"spoiler":false,"text":