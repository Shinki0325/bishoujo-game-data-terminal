de":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:25060","source":"vndb"},{"creditedName":"有限会社アフェス「無月庭」","creatorId":"vndb:s12956","sourcePersonId":"vndb:s12956","canonicalEntityId":"vndb:s12956","name":"有限会社アフェス「無月庭」","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:25061","source":"vndb"},{"creditedName":"はらいち","creatorId":"vndb:s14427","sourcePersonId":"vndb:s14427","canonicalEntityId":"vndb:s14427","name":"はらいち","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:25062","source":"vndb"},{"creditedName":"ジー・ウェーブ","creatorId":"vndb:s19494","sourcePersonId":"vndb:s19494","canonicalEntityId":"vndb:s19494","name":"ジー・ウェーブ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:25063","source":"vndb"},{"creditedName":"ねこ","creatorId":"vndb:s32372","sourcePersonId":"vndb:s32372","canonicalEntityId":"vndb:s32372","name":"ねこ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:25064","source":"vndb"},{"creditedName":"ヤマ♡びっこ","creatorId":"vndb:s2432","sourcePersonId":"vndb:s2432","canonicalEntityId":"vndb:s2432","name":"ヤマ♡びっこ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:25065","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c1094","characterName":"藤枝涼子","sourceIds":{"vndbCharacterId":"c1094"},"originalCharacterName":"藤枝涼子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ryouko is the widow of apartment 503, living next door to Kouji and his dad, Akira."},{"spoiler":false,"text":"By profession, Ryouko is a wedding dress designer that works for a wedding planning company. At home, she is the \"mother\" of the \"family\" that lives on the Florias apartment building's fifth floor. She apparently lost her husband many years before the story begins, since her daughter Koyuki makes no mention of her father, and Ryouko herself isn't really clinging to the memory of her dead husband."},{"spoiler":false,"text":"From Moroboshi Yuumei's review"}],"source":"vndb","sourceCharacterId":"c1094"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28331beeca1bb4aca2dfb67923983d5e98438f26f25308b95158765b93184e1b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b5f86c80064470869dd4c882333bec2d0ebf4e8b8151b00ba502882a33f2875.webp","width":198,"height":256,"source":"static-detail"},"actors":[{"creditedName":"まき いづみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12882","source":"vndb"}]},{"characterId":"char_vndb_c1095","characterName":"藤枝小雪","sourceIds":{"vndbCharacterId":"c1095"},"originalCharacterName":"藤枝小雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Koyuki is Ryouko's only daughter, and lives in apartment 503 with her mother."},{"spoiler":false,"text":"As a foil for her mother, Koyuki is the temperamental-yet-less-passive best friend that has had a thing for Kouji since she met him five years ago. Of course, hell would freeze over before she would ever admit she has feelings for him."},{"spoiler":false,"text":"Even though she is a year younger than our protagonist, Koyuki does not hesitate to put him in his place when needed, and is the stronger will out of the two. This does not mean she outright disrespects our protagonist, however. She cares about him enough that she'll respect his decisions when it comes to serious matters, but at times can see things that he clearly cannot."},{"spoiler":false,"text":"Being a person driven more by actions than words, she has a tendency to meddle and get things rolling when it comes to the other characters, largely because everyone else is too busy sulking or worrying about things."},{"spoiler":false,"text":"From Moroboshi Yuumei's review"}],"source":"vndb","sourceCharacterId":"c1095"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3f2b6e241efd7e39d8018e20bf5634e3fe07abbe015a1e8fa087126287a781d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73e379a5e3a514f14cb61703ab91f3f4e3089c96bb1d8dff213583bc102be6d7.webp","width":198,"height":256,"source":"static-detail"},"actors":[{"creditedName":"韮井 叶","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"韮井叶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12884","source":"vndb"}]},{"characterId":"char_vndb_c1096","characterName":"クリスティーナ ホステトラー","sourceIds":{"vndbCharacterId":"c1096"},"originalCharacterName":"クリスティーナ ホステトラー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Originally presented as Kouji's betrothed, Christina hails from the US as the daughter of a high executive for the McDowell's fast food restaurant chain. While very new to Japanese culture, she's more than willing to follow on the arrangement made by her mother and Kouji's father, and dedicates herself to being the ideal wife for Kouji."},{"spoiler":false,"text":"Of course, there's more to this story. Aside from being Kouji's fiancee, Christina is also an \"agent\" for the McDowell's company, and is assigned to protect Kouji."},{"spoiler":false,"text":"From Moroboshi Yuumei's review"}],"source":"vndb","sourceCharacterId":"c1096"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31d9b6dde9195a089a60bc432a770fecec865597fa29568a631a200e44c735ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae8ea7d73c9b07dee346691c2d3b185fdd21195439498867b8fb9ff1520741ca.webp","width":198,"height":256,"source":"static-detail"},"actors":[{"creditedName":"カンザキ カナリ","creatorId":"vndb:s1000","sourcePersonId":"vndb:s1000","canonicalEntityId":"vndb:s1000","name":"カンザキ カナリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12883","source":"vndb"}]},{"characterId":"char_vndb_c1097","characterName":"菊永瑠璃","sourceIds":{"vndbCharacterId":"c1097"},"originalCharacterName":"菊永瑠璃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ruri is a girl that used to know Kouji before he moved to Florias. She's always looked up to him as an older brother, and presents herself as a timid girl. Of course, Ruri has a much darker side that at first only manifests when she and Kouji are alone. Simply put, Ruri is the \"master\" and Kouji is the \"slave\" in their brother-sister relationship. In fact, Kouji developed a deep fear of her back when they were children."},{"spoiler":false,"text":"Ruri decides to track down our protagonist to renew their \"relationship\" by trying to blackmail him into going to the same university as her. At the same time, she aims to get away from her mother, who has remarried for the sixth time."},{"spoiler":false,"text":"Despite her faults, Ruri yearns for nothing more than to have a place in the world. She's convinced that she's the only one that truly cares for Kouji, but finds herself at ease with the other characters."},{"spoiler":false,"text":"From Moroboshi Yuumei's review"}],"source":"vndb","sourceCharacterId":"c1097"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/308807ebecfa3773eb1520e178c2e6e598b83ea066f1409b9d05d012c36305c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad1e2d83244331a07c4ce88d12c8e75f71411e83a54892525eb08f777addd074.webp","width":198,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茶谷 やすら","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12881","source":"vndb"}]},{"characterId":"char_vndb_c1098","characterName":"秋月 かおり","sourceIds":{"vndbCharacterId":"c1098"},"originalCharacterName":"秋月 かおり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kaori is the \"older sister\" of the fifth floor's surrogate family, and resides in apartment 501."},{"spoiler":false,"text":"Kaori was a university student when she met Kouji three years before ML begins. At present, however, she's an author of erotic novels. While most of her work involves actual books, she will do the occasional scenario writing for ero-game companies."},{"spoiler":false,"text":"Despite being the \"older sister\", Kaori has proven to be unable to take care of herself, and welcomed the formation of the \"family\" on her floor. Her level of comfort and lack of female modesty with her \"family\" has led to her walking around wearing nothing but her underwear and a white shirt when at home."},{"spoiler":false,"text":"Her irresponsible facet aside, Kaori is also one of the more perceptive characters in the story, being amongst the first to have suspicion that there may be something going on between our protagonist and Ryouko."},{"spoiler":false,"text":"From Moroboshi Yuumei's review"}],"source":"vndb","sourceCharacterId":"c1098"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afa38e46e19255eee90c5b11653b68f53878e622c9fa473c80e00f7c351e14d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/9985b38aab277127828985c59fa1e17763534e578ce743bdd19adb5e1c2bdaf2.webp","width":198,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一色 ヒカル","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12879","source":"vndb"}]},{"characterId":"char_vndb_c1099","characterName":"桜木 昭","sourceIds":{"vndbCharacterId":"c1099"},"originalCharacterName":"桜木 昭","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/476b9c72326bf29360fe72c2a65c16cd09cc6eb889348662859408ac486f5035.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76b05b078646a78bea5ca36b7c589e1deb026210200ea4f1855b40382c605f6b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"胸肩 腎","creatorId":"vndb:s31","sourcePersonId":"vndb:s31","canonicalEntityId":"vndb:s31","name":"山本 兼平","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12880","source":"vndb"}]},{"characterId":"char_vndb_c1100","characterName":"桜木浩二","sourceIds":{"vndbCharacterId":"c1100"},"originalCharacterName":"桜木浩二","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Our protagonist is a senior in high school that at one point was the ace of his school's baseball team. An injury forced him into early retirement, crushing his dreams of being a professional baseball player. For the last five years Kouji and his dad have been living in an apartment building where, as time passed, the tenants of his floor became something like a surrogate family."},{"spoiler":false,"text":"Much to Kouji's dismay, his dad has a bit of a reputation as a womanizer, and most expect him to be a chip off the old block. Proving them wrong, Kouji is more serious than his dad, and already has his heart set on someone."},{"spoiler":false,"text":"From Moroboshi Yuumei's review"}],"source":"vndb","sourceCharacterId":"c1100"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c35006","characterName":"神谷","sourceIds":{"vndbCharacterId":"c35006"},"originalCharacterName":"神谷","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f2b2549250412d4beb3ed8bfb1b99b246a87657f0687573fe2a50d792466533.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e235a37e9c3f5a39bcfbaa28f3ba42f8c5a8680dcedaef4fe7159e9334e4b7a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p241","sourceCompanyId":"egs:brand:1018","canonicalEntityId":"vndb:p241","name":"HERMIT","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:3930:1018","source":"egs"},{"companyId":"vndb:p241","sourceCompanyId":"vndb:p241","canonicalEntityId":"vndb:p241","name":"HERMIT","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:3358:v1456","source":"vndb"},{"companyId":"vndb:p4480","sourceCompanyId":"vndb:p4480","canonicalEntityId":"vndb:p4480","name":"famille汉化组","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:36442:v1456","source":"vndb"},{"companyId":"vndb:p241","sourceCompanyId":"vndb:p241","canonicalEntityId":"vndb:p241","name":"HERMIT","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:8755:v1456","source":"vndb"}],"missingStates":["confirmed-character-relation-missing"],"source":"terminal-wiki-full-runtime-v7"}}
