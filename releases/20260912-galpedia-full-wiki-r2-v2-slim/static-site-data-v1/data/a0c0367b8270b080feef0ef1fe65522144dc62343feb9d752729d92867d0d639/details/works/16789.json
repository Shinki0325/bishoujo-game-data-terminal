:"vndb:s1844","canonicalEntityId":"vndb:s1844","name":"桐月","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:85348","source":"vndb"},{"creditedName":"松井 洋平","creatorId":"vndb:s9169","sourcePersonId":"vndb:s9169","canonicalEntityId":"vndb:s9169","name":"松井 洋平","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:85350","source":"vndb"},{"creditedName":"Tas.K","creatorId":"vndb:s10410","sourcePersonId":"vndb:s10410","canonicalEntityId":"vndb:s10410","name":"Tas.K","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:85351","source":"vndb"}]},"cast":[{"characterId":"char_c22843","characterName":"くおん","sourceIds":{"bangumi":[{"characterId":"16165","match":"exact-normalized-name-in-linked-work","subjectId":"37004"}],"egsCharacterIds":["3018"],"vndbCharacterId":"c22843"},"originalCharacterName":"くおん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"height":{"reviewState":"no-conflict","source":"vndb","value":"169"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"61"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"神社の要石に封じられていた妖怪。"},{"spoiler":false,"text":"過去には人を食っていた鬼として坂井町の伝承に残っており、涼士を含め都合が悪くなったら殺して食う存在と思っている節がある。"},{"spoiler":false,"text":"妖の存在でありながら異界を封じることを生業にしているが理由は不明。"},{"spoiler":false,"text":"知能はあるが気まぐれで好奇心旺盛。"},{"spoiler":false,"text":"人を殺すのも食うのも特に好きではないが嫌悪を持っているわけでもなく、文字通りどうでもいいと思っている。"},{"spoiler":false,"text":"人の常識を遥かに超えた身体能力に伸縮自在の爪と炎を使うが、大部分の能力を異界ごと要石に封じられてしまったため、封印から解き放たれた直後はほとんど力を持っていない。"},{"spoiler":false,"text":"涼士が持つ核には自分の命とも呼べる力が詰まっているため、奇妙な繋がりを持つことになる。"},{"spoiler":false,"text":"現代文明は見るのも初めてで、新しい物を見つけては興味深くあれこれ聞いてくる面もある。"},{"spoiler":false,"text":"「数百年ぶりの世は、うるさくてかなわぬ」"}],"source":"egs","sourceCharacterId":"3018","sourceWorkId":"16789","spoiler":false},{"segments":[{"spoiler":false,"text":"封印在神社的要石中的妖怪。"},{"spoiler":false,"text":"根据留传在坂井町的传说，她过去曾是食人的恶鬼，一度认为只要是对自己不利的存在都要残杀吞噬，涼士也不例外。"},{"spoiler":false,"text":"身为妖怪却以封印异界为生，理由不明。"},{"spoiler":false,"text":"虽然有一定的知性，但随性而好奇心旺盛。"},{"spoiler":false,"text":"无论杀人还是食人她都不是特别喜欢，但也对此完全没有忌惮，就如字面上的意思觉得“无所谓”。"},{"spoiler":false,"text":"有着远超越人类常识的身体能力，并能使用伸缩自如的爪子与火焰，但由于她的大部分能力都同异界一起被封印在要石之中，被从封印中解放出来之后基本上没有什么力量。"},{"spoiler":false,"text":"由于涼士所持有的核心充满了重于她生命的力量，两人之间缔结了奇特的羁绊。"},{"spoiler":false,"text":"由于是初次见识到现代文明，一碰到新鲜事物就兴致勃勃地刨根问底。"}],"source":"bangumi","sourceCharacterId":"16165"}],"profileFacts":[{"label":"胸围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"3018","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"169 cm","valueContext":null,"source":"egs","sourceCharacterId":"3018","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"3018","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"3018","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"38 kg","valueContext":null,"source":"egs","sourceCharacterId":"3018","sourceWorkId":"16789","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a34c977cf870a538325ee0d4e26158c0daf3edaec6e17adfd31d779b50ef314.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22d1e0041e96170cf911d41ee7e89b83234412a7bf3285f9b67220f5f2c50b14.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37004:16165:5741:1","source":"bangumi"}]},{"characterId":"char_c22844","characterName":"永月 文香","sourceIds":{"bangumi":[{"characterId":"16166","match":"exact-normalized-name-in-linked-work","subjectId":"37004"}],"egsCharacterIds":["3019"],"vndbCharacterId":"c22844"},"originalCharacterName":"永月 文香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"涼士の幼なじみでクラスメイト。"},{"spoiler":false,"text":"子供の頃に引っ越してきた涼士と知り合い、ある事件が起きるまではいつも一緒に遊ぶ一番の親友だった。"},{"spoiler":false,"text":"それ以後は単なるクラスメイト程度に疎遠になってしまっていたが、事件に関わるようになり涼士と再び距離を縮めていく。"},{"spoiler":false,"text":"食生活に乏しい遠上家にとって頭の上がらない存在。"},{"spoiler":false,"text":"「ねえりょうちゃん……その女の人って……」"}],"source":"egs","sourceCharacterId":"3019","sourceWorkId":"16789","spoiler":false},{"segments":[{"spoiler":false,"text":"涼士的青梅竹马，同班同学。"},{"spoiler":false,"text":"小时候和搬家过来的涼士相识，直到发生某个事件为止都是总在一起玩耍的最亲密的伙伴。"},{"spoiler":false,"text":"自那之后疏远成了单纯的同班同学关系，但随着对事件的介入而再次缩短了和涼士间的距离。"},{"spoiler":false,"text":"对于饮食生活贫乏的遠上家来说，在她面前抬不起头来。"}],"source":"bangumi","sourceCharacterId":"16166"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"3019","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"3019","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"3019","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"3019","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"48 kg","valueContext":null,"source":"egs","sourceCharacterId":"3019","sourceWorkId":"16789","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0ef940b493cd63fd261c652acaab1cd9ce0d257a83f904b908edf535c8f1a05c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae284356f7926ec614ef464e7c90c33ec07b547da9ff53dc346311625ce5fc6a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37004:16166:11646:1","source":"bangumi"}]},{"characterId":"char_c22845","characterName":"相原 沙織","sourceIds":{"bangumi":[{"characterId":"16167","match":"exact-normalized-name-in-linked-work","subjectId":"37004"}],"egsCharacterIds":["3020"],"vndbCharacterId":"c22845"},"originalCharacterName":"相原 沙織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"63"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"涼士たちの通う学園の学生会長。"},{"spoiler":false,"text":"心理学と天体観測を趣味にしており、学園唯一の天文部員。"},{"spoiler":false,"text":"神社を天体観測のスポットにしており、その縁で涼士と知り合い、今では互いに話し掛ける仲になっている。"},{"spoiler":false,"text":"事件に巻き込まれる形になり、事態の収束を図る涼士たちに協力をする。"},{"spoiler":false,"text":"沈着冷静で頭脳明晰を絵に描いたような人物だが、全ての事柄を客観視して一歩引いている面がある。"},{"spoiler":false,"text":"人間の心の歪みや傷が現実世界に露呈する異界化事件は、彼女にとって興味深くもあり畏れでもある。"},{"spoiler":false,"text":"「へぇ。興味深いわね」"}],"source":"egs","sourceCharacterId":"3020","sourceWorkId":"16789","spoiler":false},{"segments":[{"spoiler":false,"text":"涼士他们所就读的学校的学生会会长。"},{"spoiler":false,"text":"兴趣是心理学与天体观测，学园唯一的天文部部员。"},{"spoiler":false,"text":"将神社作为天体观测的据点，因此与涼士相识，现在成了见面会互相搭话的伙伴。"},{"spoiler":false,"text":"被卷入了事件之中，协助想要收拾事态的涼士等人。"},{"spoiler":false,"text":"沉着冷静、头脑聪明的理想中的人物，但总是爱退一步站在客观的角度上看待所有的事情。"},{"spoiler":false,"text":"对于将人类内心的扭曲与伤痕呈现到现实世界的异界化事件，她既充满了兴趣又感到畏惧。"}],"source":"bangumi","sourceCharacterId":"16167"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"3020","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"3020","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"3020","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"63 cm","valueContext":null,"source":"egs","sourceCharacterId":"3020","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"52 kg","valueContext":null,"source":"egs","sourceCharacterId":"3020","sourceWorkId":"16789","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bcd8199785f0ed9212cd9d8ead068184d5d37045fcad52ff8159edb5fb63dffd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b79dfdc2830c8060b7529584924885c776281cd7e49f87972e3e7b97105c464.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37004:16167:5075:1","source":"bangumi"}]},{"characterId":"char_c22846","characterName":"エウスリーゼ","sourceIds":{"bangumi":[{"characterId":"16168","match":"exact-normalized-name-in-linked-work","subjectId":"37004"}],"egsCharacterIds":["3021"],"vndbCharacterId":"c22846"},"originalCharacterName":"エウスリーゼ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"70"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"68"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"48"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"30"}},"descriptions":[{"segments":[{"spoiler":false,"text":"くおんと敵対している少女。"},{"spoiler":false,"text":"何を目的にしているのか不明だが、異界化を収束させようとする涼士たちと目的が異なる様子。"},{"spoiler":false,"text":"くおんが他者の生死に興味が無いのと反対に、巻き込まないよう無関係の人間を遠ざける節があるが、それが目的のためか性格によるものかは不明。"},{"spoiler":false,"text":"目見麗しい女の子だが過去にくおんと戦ったことがあり、推定年齢は数百歳を超える。"},{"spoiler":false,"text":"現代社会にまぎれて暮しているため、生活に関わりのある物は一通り使えるが、基本的には苦手。"},{"spoiler":false,"text":"「あの女との付き合いはやめなさい。身を滅ぼす事になるわ"}],"source":"egs","sourceCharacterId":"3021","sourceWorkId":"16789","spoiler":false},{"segments":[{"spoiler":false,"text":"与くおん敌对的少女。"},{"spoiler":false,"text":"虽然不知道她有何目的，但貌似与想要解决异界化的涼士等人的目的不同。"},{"spoiler":false,"text":"与くおん对他人的生死毫无兴趣相反，她总是为了不让他人被牵扯进来而疏远毫不相关的一般人，但不知这是出于她的目的还是性格。"},{"spoiler":false,"text":"看上去是漂亮的女孩子，但过去曾和くおん战斗过，推测年龄超过了数百岁。"},{"spoiler":false,"text":"由于融入现代社会中生活，与生活相关的电器大都能使用，但基本上很不擅长"}],"source":"bangumi","sourceCharacterId":"16168"}],"profileFacts":[{"label":"胸围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"3021","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"3021","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"68 cm","valueContext":null,"source":"egs","sourceCharacterId":"3021","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"48 cm","valueContext":null,"source":"egs","sourceCharacterId":"3021","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"30 kg","valueContext":null,"source":"egs","sourceCharacterId":"3021","sourceWorkId":"16789","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8432289bc2aec497d3df1c506466d1168d952fc0c24aecca4f5aa93c79a1469.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/4728b25b1c2114fb6b7eaea4819ae63b38397dc27c82bb2a5d95a277d7060cc6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37004:16168:5020:1","source":"bangumi"}]},{"characterId":"char_c22847","characterName":"遠上 涼士","sourceIds":{"bangumi":[{"characterId":"16169","match":"exact-normalized-name-in-linked-work","subjectId":"37004"}],"egsCharacterIds":["3022"],"vndbCharacterId":"c22847"},"originalCharacterName":"遠上 涼士","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"語の主人公。"},{"spoiler":false,"text":"幼い頃に祖父に預けられて以来、坂井町に住んでいる。"},{"spoiler":false,"text":"そのことが切っ掛けで責任感は人より強いが、どこにでもいる少年の範囲内でしかなかった。"},{"spoiler":false,"text":"くおんと出会ったことで奇妙な縁を持ち、様々な事件に関わることになる。"},{"spoiler":false,"text":"体内にくおんが封じられていた要石の核を持ち、手にした鉱物に異界とそれに繋がる力を封じることができる。"},{"spoiler":false,"text":"その力で異界化した世界を戻していくことになるが、逆に石に力を込めて解き放つこともできる。"},{"spoiler":false,"text":"くおんの力の大部分が要石の破片と核に吸収されているため、もっぱらくおんの力を使う。"},{"spoiler":false,"text":"「いい加減にしろ馬鹿猫！　少しは常識を考えろ！」"}],"source":"egs","sourceCharacterId":"3022","sourceWorkId":"16789","spoiler":false},{"segments":[{"spoiler":false,"text":"故事的主人公。"},{"spoiler":false,"text":"小时候被寄养到祖父家以来，就住在了坂井町。"},{"spoiler":false,"text":"因此有着比其他人都强的责任感，但这也不过是在一个普通少年的范畴里。"},{"spoiler":false,"text":"与くおん的邂逅为他带来了奇妙的因缘，将其卷入到各种事件中。"},{"spoiler":false,"text":"体内有着封印くおん的要石的核心，能将异界以及与之相关联的力量封印到手中的矿物里。"},{"spoiler":false,"text":"虽然能用这种能力将异界化的世界还原，但相反也能将力量注入石头以将其解放出来。"},{"spoiler":false,"text":"由于くおん的力量大部分被要石的碎片与核心所吸收，他完全能使用くおん的力量。"}],"source":"bangumi","sourceCharacterId":"16169"}],"profileFacts":[{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"3022","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"65 kg","valueContext":null,"source":"egs","sourceCharacterId":"3022","sourceWorkId":"16789","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62983af9b8f7954e26b9ca9b0043b713e0944ebabaf50a4df17b19c8c871e2ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8a5f1b77bb7752cab7970282233822dfa3d9f7a67e0300f88ee15150a719071.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c22848","characterName":"アリーセ","sourceIds":{"bangumi":[{"characterId":"16170","match":"exact-normalized-name-in-linked-work","subjectId":"37004"}],"egsCharacterIds":["3023"],"vndbCharacterId":"c22848"},"originalCharacterName":"アリーセ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"69"},"height":{"reviewState":"no-conflict","source":"vndb","value":"140"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"68"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"49"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"25"}},"descriptions":[{"segments":[{"spoiler":false,"text":"エウスリーゼに付き従う女の子。"},{"spoiler":false,"text":"涼士に何もさせずに手玉にとるだけの戦闘力を持ちながら、行動は気まぐれを通り越して適当。"},{"spoiler":false,"text":"街中にふらりと現われては、涼士にたかることもあれば、その場のノリで手助けをすることも。"},{"spoiler":false,"text":"主人であるエウスリーゼの命令は聞くが、それ以外では何を考えているのか分からない。"},{"spoiler":false,"text":"主人と違って現代文明に詳しく、携帯の操作も得意。 有名な週刊漫画雑誌は一通り読んでいる。"},{"spoiler":false,"text":"「ありがとう。お礼にリーゼのパンツあげ……やっぱり何でもない」"}],"source":"egs","sourceCharacterId":"3023","sourceWorkId":"16789","spoiler":false},{"segments":[{"spoiler":false,"text":"跟随着エウスリーゼ的女孩子。"},{"spoiler":false,"text":"有着能让涼士毫无还手之力便束手就擒的战斗力，行动极其随性。"},{"spoiler":false,"text":"不经意间出现在街上，时而捉弄涼士，时而出手相助。"},{"spoiler":false,"text":"虽然听从主人エウスリーゼ的命令，但除此之外不知道她在想些什么。"},{"spoiler":false,"text":"与主人不同，对现代文明十分了解，很擅长使用手机。有名的周刊漫画杂志基本都看过。"}],"source":"bangumi","sourceCharacterId":"16170"}],"profileFacts":[{"label":"胸围（本版本）","value":"69 cm","valueContext":null,"source":"egs","sourceCharacterId":"3023","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"140 cm","valueContext":null,"source":"egs","sourceCharacterId":"3023","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"68 cm","valueContext":null,"source":"egs","sourceCharacterId":"3023","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"49 cm","valueContext":null,"source":"egs","sourceCharacterId":"3023","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"25 kg","valueContext":null,"source":"egs","sourceCharacterId":"3023","sourceWorkId":"16789","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/332ef921c1f08e7f966fb7da4c01ddb38285f1b24b8e2886af9fb1a1638e1707.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/736127ff792da4ddb78439fbd9e81193fc39bf39efba74ac6322e6777f048f33.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あおきさやか","creatorId":"vndb:s194","sourcePersonId":"vndb:s194","canonicalEntityId":"vndb:s194","name":"あおき さやか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:37004:16170:4869:1","source":"bangumi"}]},{"characterId":"char_c22849","characterName":"三田 春名","sourceIds":{"bangumi":[{"characterId":"16171","match":"exact-normalized-name-in-linked-work","subjectId":"37004"}],"egsCharacterIds":["3024"],"vndbCharacterId":"c22849"},"originalCharacterName":"三田 春名","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"涼士たちのクラスを受け持つ担任の先生。"},{"spoiler":false,"text":"小柄で優しい外見をしているが、しっかりとした厳しいところのある先生として知れ渡っている。"},{"spoiler":false,"text":"教師というよりみんなのお姉さん的なポジションだが、本人はもう少し威厳を持ちたいらしい。"},{"spoiler":false,"text":"行動力があって努力家だが、そのために年配の教師からは少々浮いた扱いをされている。"},{"spoiler":false,"text":"とある格闘技が大好きで、たまに試合を見に行くことも。"},{"spoiler":false,"text":"「遠上くん。何があったのか分かりませんが、困った事があったら先生に相談してね」"}],"source":"egs","sourceCharacterId":"3024","sourceWorkId":"16789","spoiler":false},{"segments":[{"spoiler":false,"text":"负责涼士他们班的班主任老师。"},{"spoiler":false,"text":"有着娇小而温柔的外貌，但也有着干练与严厉的一面的众所周知的老师。"},{"spoiler":false,"text":"虽然比起教师来说更像是大家的大姐姐，但本人似乎想要更保持些威严。"},{"spoiler":false,"text":"有行动力的努力之人，但因此被年长的教师觉得有些轻浮。"},{"spoiler":false,"text":"最喜欢某格斗技，偶尔还去看比赛。"}],"source":"bangumi","sourceCharacterId":"16171"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"3024","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"3024","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"3024","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"3024","sourceWorkId":"16789","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"47 kg","valueContext":null,"source":"egs","sourceCharacterId":"3024","sourceWorkId":"16789","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b2b0a5c78d4800d93e1e70df8cac2a15d3ae3b0d1e7eabda783bb886160714f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c7cb3b4489c40b5b48effaf6e131ead2b6a8bbb6aa242c11f22a67222ba9f0f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s6