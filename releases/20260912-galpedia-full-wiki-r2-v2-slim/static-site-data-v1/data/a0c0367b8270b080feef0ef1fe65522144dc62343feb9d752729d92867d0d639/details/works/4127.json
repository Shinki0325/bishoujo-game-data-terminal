native","relationId":"vndb:vn-staff:39211","source":"vndb"},{"creditedName":"SATOMI","creatorId":"vndb:s3057","sourcePersonId":"vndb:s3057","canonicalEntityId":"vndb:s3057","name":"SATOMI","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:39213","source":"vndb"},{"creditedName":"ガンちゃん","creatorId":"vndb:s3575","sourcePersonId":"vndb:s3575","canonicalEntityId":"vndb:s3575","name":"ガンちゃん","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:39214","source":"vndb"},{"creditedName":"濱田 智彰","creatorId":"vndb:s3576","sourcePersonId":"vndb:s3576","canonicalEntityId":"vndb:s3576","name":"濱田 智彰","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:39216","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c57145","characterName":"鳴島 愛","sourceIds":{"vndbCharacterId":"c57145"},"originalCharacterName":"鳴島 愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"32"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She used to live next door to Kento when he was living in an apartment complex (he lived there until he graduated from high school). She was also a swimmer in school and taught Kento how to swim for the first time."},{"spoiler":false,"text":"When Kento was 12 years old, they were separated by Ai's marriage. She married for the sake of her dying father, it is difficult to say that she married the person she truly loves. However, she has spent the last 10 years of her life without letting her husband and people around her realize this."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c57145"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d97ace80019de14f4753d521143360ccddae644bda8425a1a29a3b814d1c0da5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f41e4b1fb123fc5f6bde62adebc41b804299492022dc77fd29f7b415d2bae815.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北都 南","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21310","source":"vndb"}]},{"characterId":"char_vndb_c57146","characterName":"天中院 聖華","sourceIds":{"vndbCharacterId":"c57146"},"originalCharacterName":"天中院 聖華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"38"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ai's sister-in-law. (Ai's husband's sister) She is a gorgeous wife of a wealthy family. She feels her life's purpose is to improve her own body. She also understands the value of her body and married into the Tenchuuin family five years ago as an instrument of a political marriage for the development of the Narushima Group. The difference in age between her and her husband is over 40 years."},{"spoiler":false,"text":"However, she is actually the daughter of a concubine and not a legitimate daughter of the Narushima family. This is a top secret known only to a few people in the Narushima family. Because of this, she had to go through a lot of hardships when she was a child. Therefore, she may appear to be a carefree hedonist, but in fact she is extremely smart and has a great deal of insight."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c57146"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/355a2680929f30c1cc8ea362befb2232247b9248859294814ebd439049f1b5ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d00b95d475f2bee843d25515df319f62ddf172dda80c01b89d0985eadb30af72.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金田 めい","creatorId":"vndb:s2331","sourcePersonId":"vndb:s2331","canonicalEntityId":"vndb:s2331","name":"小橋 知子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21314","source":"vndb"}]},{"characterId":"char_vndb_c57147","characterName":"橘 健人","sourceIds":{"vndbCharacterId":"c57147"},"originalCharacterName":"橘 健人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c57148","characterName":"小武海 千絵","sourceIds":{"vndbCharacterId":"c57148"},"originalCharacterName":"小武海 千絵","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"26"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a young mother with a baby. However, perhaps because she is too young, she lacks the self-awareness of a mother. For example, she leaves her son at the daycare center to go to the gym, or she doesn't want to change his diaper."},{"spoiler":false,"text":"She is very sociable and can easily make friends with anyone, especially Sakura, and they sometimes go out for drinks together."},{"spoiler":false,"text":"She is friend's with Sakura's who runs a day-care center, where she takes care of her child at a friend's price."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c57148"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69fb765ce962b83562c0e494e8f156e9462952e53ca74bd59629878fe49af4d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/cacaf6ce7df3f17f244d59e19b15fc1f1e9c9a7904b82d6b7af8aaeb4abf696f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森 藍子","creatorId":"vndb:s2308","sourcePersonId":"vndb:s2308","canonicalEntityId":"vndb:s2308","name":"南川 のりこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21313","source":"vndb"}]},{"characterId":"char_vndb_c57149","characterName":"麻倉 さくら","sourceIds":{"vndbCharacterId":"c57149"},"originalCharacterName":"麻倉 さくら","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"33"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She goes to train but has no motivation. She routinely takes a bath in the jacuzzi and drinks beer. Her body's metabolic rate is unusually high, and she can lose weight in no time with little exercise, she is also prone to rebounding and gaining weight quickly."},{"spoiler":false,"text":"Her husband is working alone and rarely comes home. So he don't notice whether Sakura is fat or skinny when he sees her occasionally. This is the reason why she has become indifferent to maintaining his body shape, but now she thinks it is rather suspicious when someone says, \"You've lost weight. (Signs of cheating)"},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c57149"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32d26e827364cda50de333d47ef83ce1cf3f4e01f8d8f7c38e878ec5c5343720.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/151225701ebf5a88b9321ae6c6b721b6fdbcb6a050903c9eb559110719bd540b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みすみ","creatorId":"vndb:s1164","sourcePersonId":"vndb:s1164","canonicalEntityId":"vndb:s1164","name":"石松 千恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21312","source":"vndb"}]},{"characterId":"char_vndb_c57150","characterName":"江西 紫","sourceIds":{"vndbCharacterId":"c57150"},"originalCharacterName":"江西 紫","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"39"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the manager of the gym and the resident masseuse in the relaxation room. She is the sister of the swimming coach who took care of Kento in college. Her husband is also a former swimmer, and was his wife and trainer. The reason I say \"was\" is that her husband was in a traffic accident just like Kento, and unfortunately, he passed away."},{"spoiler":false,"text":"That was 10 years ago. Since then, she has been working at this gym, and appointed as manager of the branch."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c57150"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df9b6901379e4ea8bd3534762cd3b9f10959f8b36a0cc45aceedf4f6ecaa1e1f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17eff36c8cae9ddc50fac70379f665166726df7a60cef972cdab0c361c6cea6d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"児玉 さとみ","creatorId":"vndb:s115","sourcePersonId":"vndb:s115","canonicalEntityId":"vndb:s115","name":"児玉 さとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21311","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p561","sourceCompanyId":"egs:brand:341","canonicalEntityId":"vndb:p561","name":"DISCOVERY","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:4127:341","source":"egs"},{"companyId":"vndb:p561","sourceCompanyId":"vndb:p561","canonicalEntityId":"vndb:p561","name":"ディスカバリー","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:47973:v2950","source":"vndb"},{"companyId":"vndb:p561","sourceCompanyId":"vndb:p561","canonicalEntityId":"vndb:p561","name":"ディスカバリー","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:6911:v2950","source":"vndb"},{"companyId":"vndb:p139","sourceCompanyId":"vndb:p139","canonicalEntityId":"vndb:p139","name":"電脳CLUB","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:6916:v2950","source":"vndb"},{"companyId":"vndb:p561","sourceCompanyId":"vndb:p561","canonicalEntityId":"vndb:p561","name":"ディスカバリー","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:6917:v2950","source":"vndb"},{"companyId":"vndb:p561","sourceCompanyId":"vndb:p561","canonicalEntityId":"vndb:p561","name":"ディスカバリー","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:6919:v2950","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
