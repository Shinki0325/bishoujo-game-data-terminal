:vn-staff:61736","source":"vndb"},{"creditedName":"あっきー先生","creatorId":"vndb:s23108","sourcePersonId":"vndb:s23108","canonicalEntityId":"vndb:s23108","name":"あっきー先生","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:61739","source":"vndb"},{"creditedName":"小山田","creatorId":"vndb:s54639","sourcePersonId":"vndb:s54639","canonicalEntityId":"vndb:s54639","name":"小山田","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:61742","source":"vndb"}],"music":[{"creditedName":"Angel Note","creatorId":"vndb:s758","sourcePersonId":"vndb:s758","canonicalEntityId":"vndb:s758","name":"Angel Note","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:61729","source":"vndb"}],"other":[{"creditedName":"マンサク","creatorId":"vndb:s5770","sourcePersonId":"egs:creator:1841","canonicalEntityId":"vndb:s5770","name":"マンサク","detail":"名義のみ","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:167670","source":"egs"},{"creditedName":"浅生 詠","creatorId":"vndb:s3580","sourcePersonId":"vndb:s3580","canonicalEntityId":"vndb:s3580","name":"浅生 詠","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:61731","source":"vndb"},{"creditedName":"ケンスケ","creatorId":"vndb:s8180","sourcePersonId":"vndb:s8180","canonicalEntityId":"vndb:s8180","name":"ケンスケ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:61735","source":"vndb"},{"creditedName":"ねびにらる","creatorId":"vndb:s9392","sourcePersonId":"vndb:s9392","canonicalEntityId":"vndb:s9392","name":"ねびにらる","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:61737","source":"vndb"},{"creditedName":"ねびにらる","creatorId":"vndb:s9392","sourcePersonId":"vndb:s9392","canonicalEntityId":"vndb:s9392","name":"ねびにらる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:61738","source":"vndb"},{"creditedName":"あっきー先生","creatorId":"vndb:s23108","sourcePersonId":"vndb:s23108","canonicalEntityId":"vndb:s23108","name":"あっきー先生","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:61740","source":"vndb"},{"creditedName":"小山田","creatorId":"vndb:s54639","sourcePersonId":"vndb:s54639","canonicalEntityId":"vndb:s54639","name":"小山田","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:61743","source":"vndb"},{"creditedName":"小山田","creatorId":"vndb:s54639","sourcePersonId":"vndb:s54639","canonicalEntityId":"vndb:s54639","name":"小山田","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:61744","source":"vndb"},{"creditedName":"村上 幸太郎","creatorId":"vndb:s54640","sourcePersonId":"vndb:s54640","canonicalEntityId":"vndb:s54640","name":"村上 幸太郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:61745","source":"vndb"}]},"cast":[{"characterId":"char_c17943","characterName":"加賀野 愛","sourceIds":{"bangumi":[{"characterId":"14282","match":"exact-normalized-name-in-linked-work","subjectId":"24622"}],"egsCharacterIds":["13071"],"vndbCharacterId":"c17943"},"originalCharacterName":"加賀野 愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"異界から派遣された戦士。"},{"spoiler":false,"text":"彼女の住む世界では、完全な階級分業社会で、彼女は幼い頃から戦士としての厳しい訓練を受けて育ってきた。そのため、性格は非常にクールで、無口。他者を受け入れない頑なさを持つ。しかしそれは精神的に抑え込んでるに過ぎず、時折、女の子らしい一面を見せたり、感情を爆発させることもある。"},{"spoiler":false,"text":"そうした戦士として不必要と思える感情を見せることは彼女にとって「未熟者の証拠」と思っている。"},{"spoiler":false,"text":"主人公との出会いによって、徐々に心が通じ、彼女の凍てついた心も氷解して……。"}],"source":"egs","sourceCharacterId":"13071","sourceWorkId":"1906","spoiler":false},{"segments":[{"spoiler":false,"text":"リン同様、異世界から派遣されてきた戦士。"},{"spoiler":false,"text":"前作初期の寡黙で冷徹な性格から比べて、だいぶ丸くなっているが、あくまで「任務＞人間」。"},{"spoiler":false,"text":"無闇に人間を巻き込もうとはしないが、仕方のない状況では躊躇しない。"},{"spoiler":false,"text":"前作で、廃人同様の聡恵に対しモノ扱いに近いことをしていたが、それはもうしない。"},{"spoiler":false,"text":"以前は巻き込まれた人間のことを気にも留めなかったが、現時点では怪我をしていたら応急処置やいい形での記憶操作をしてやるくらいの気遣いはある。"},{"spoiler":false,"text":"感情をあまり表に出さないアイにとって、それをあらわにするリンが苦手であり、その実うらやましくもある。"},{"spoiler":false,"text":"秋俊を愛しているのは変わらない。"}],"source":"egs","sourceCharacterId":"13071","sourceWorkId":"7193","spoiler":false},{"segments":[{"spoiler":false,"text":"第一作：突然出现在主人公秋俊面前的来自异界的魔法战士。性格冷酷且沉默寡言，不轻易接受别人。异界是个阶级分化的社会，爱作为一个战士受到严格的训练，形成对敌人的凌辱不做任何妥协，不带一丝感情的冷酷作战方法。可是令一方面，她还是无法掩盖作为女孩子的性格，喜欢奇特可爱的小东西，非常喜欢甜食(例如一桶水果冰糕)。在异界里，位于下级的战士们连真正的名字也没有，“加贺野爱”是在人间的假名(伙伴之间的通称也“爱”)。在战斗中善于使用武器“怒槌”召唤雷系魔法攻击，又可以使用操纵记忆的魔法执行任务。为了异界的战斗压抑着感情，不过，在与秋俊的接触中渐渐改变。"},{"spoiler":false,"text":"第二作：异界的魔法战士，虽然在前作封印了秋俊的记忆，但仍爱慕着他。依旧沉默寡言，但不再冷冰冰的了。还是喜欢可爱玩偶和甜食。内心羡慕能公开与秋俊交往的凛。"},{"spoiler":false,"text":"第三作：女主人公，异界的魔法战士。现在和秋俊一起生活。"}],"source":"bangumi","sourceCharacterId":"14282"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55201bfdfb4dc47090670e846e82a551cc6b90e185f82882628bbf7c0077bdf1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01e9f3df4a679fc7cfe4903ce0d20d73e6fc27e3e827f6c10c7d15ee95fab019.webp","width":256,"height":242,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c17950","characterName":"メグ","sourceIds":{"vndbCharacterId":"c17950"},"originalCharacterName":"メグ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1206"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rin and Ai’s senior, she is known as the strongest warrior, to the extent of being called a “demon god,” despite her gentle and soft appearance."},{"spoiler":false,"text":"She has a kind, “big sister” type personality. Her willingness to actively interact with humans makes her an outlier in her world."},{"spoiler":false,"text":"She comes to Akitoshi’s apartment as its manager."},{"spoiler":false,"text":"In truth, she is secretly tasked with a mission to kill Shin."}],"source":"vndb","sourceCharacterId":"c17950"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/194424c92e96100d8b0d33d821319b93476dceb4682c7346d122d4f67c4323d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/5988f05b68f9c41a76b4ac46c742f107ccc9f99906d47a0bbbc736d2c1ef9129.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瀬野 摩紀","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:34460","source":"vndb"}]},{"characterId":"char_vndb_c40050","characterName":"リン","sourceIds":{"vndbCharacterId":"c40050"},"originalCharacterName":"リン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd77c4234541c8a81a437a9d1d69a504a93300a499ad397291759ae5294091ba.webp","fallb