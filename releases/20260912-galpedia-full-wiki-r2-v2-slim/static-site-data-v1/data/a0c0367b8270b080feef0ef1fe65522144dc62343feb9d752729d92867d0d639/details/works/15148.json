rect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"303"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shrine maiden at the local god's - Iwagami's - shrine-"}],"source":"vndb","sourceCharacterId":"c32145"},{"segments":[{"spoiler":false,"text":"優しい性格でみんなのお姉さん役。"},{"spoiler":false,"text":"主人公の世話役で、神の御使いである主人公に献身的。"},{"spoiler":false,"text":"ごく当たり前のように主人公の下半身までお世話してしまう。"},{"spoiler":false,"text":"それは山深い田舎で過ごしたため、始めて接する都会の男という存在に激しく誤解を抱いているためでもある。"},{"spoiler":false,"text":"巖神と人を介在する巫女として、村のみんなから祭り上げられている。"},{"spoiler":false,"text":"生まれついての癒しのカリスマで圧倒的な支持を得ている。"},{"spoiler":false,"text":"巫女としての職務を全うするため完全に女の子として育てられている。"},{"spoiler":false,"text":"普段は優しいが一度切れると怖い。"},{"spoiler":false,"text":"特に神社や因習を守らない人間には般若面をかぶってお仕置きモードに変貌する。"}],"source":"egs","sourceCharacterId":"10373","sourceWorkId":"15148","spoiler":false},{"segments":[{"spoiler":false,"text":"優しい性格でみんなのお姉さん役。"},{"spoiler":false,"text":"主人公の世話役で、神の御使いである主人公に献身的。"},{"spoiler":false,"text":"ごく当たり前のように主人公の下半身までお世話してしまう。"},{"spoiler":false,"text":"巖神と人を介在する巫女として、村のみんなから祭り上げられている。"},{"spoiler":false,"text":"生まれついての癒しのカリスマで圧倒的な支持を得ており、巫女としての職務を全うするため完全に女の子として育てられている。"},{"spoiler":false,"text":"普段は優しいが一度キレると怖い。"},{"spoiler":false,"text":"特に神社や因習を守らない人間には、般若面をかぶってお仕置きモードに変貌する。"},{"spoiler":false,"text":"「ご奉仕頑張ります。なんでしたら、妊娠するくらいまで！」"}],"source":"bangumi","sourceCharacterId":"12481"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f40964bf7cfec86035533c568cba392e374ae23251956125a5face669fc5b3dd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c02723f032c06ec3ad0d4f4776676f9e9d585de3610f43ab8668db351c07c32b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15002:12481:5936:1","source":"bangumi"}]},{"characterId":"char_c32147","characterName":"曲林 静樹","sourceIds":{"bangumi":[{"characterId":"12482","match":"exact-normalized-name-in-linked-work","subjectId":"15002"}],"egsCharacterIds":["10374"],"vndbCharacterId":"c32147"},"originalCharacterName":"曲林 静樹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mischievous kid, always playing around the shrine"}],"source":"vndb","sourceCharacterId":"c32147"},{"segments":[{"spoiler":false,"text":"何事も楽しくが身上で主人公を誘惑してくる。"},{"spoiler":false,"text":"主人公が困惑している理由をまるで理解していない。"},{"spoiler":false,"text":"反応が楽しいだけの理由で、わざときわどい格好で迫ってきたり、とても無邪気で罪作りな小悪魔。"},{"spoiler":false,"text":"ミニスカとノースリーブと動きやすい格好。"},{"spoiler":false,"text":"スパッツは見えても気にしない。"},{"spoiler":false,"text":"明るく振舞ってはいるが、実は天涯孤独の身の上。"}],"source":"egs","sourceCharacterId":"10374","sourceWorkId":"15148","spoiler":false},{"segments":[{"spoiler":false,"text":"何事も楽しくが信条で、主人公を積極的に誘惑してくる。"},{"spoiler":false,"text":"主人公が困惑している理由をまるで理解していない。"},{"spoiler":false,"text":"反応が楽しいというだけの理由で、わざときわどい格好で迫ってきたりと、とても無邪気で罪作りな小悪魔。"},{"spoiler":false,"text":"服装はミニスカにノースリーブと動きやすい格好。スパッツは見えても気にしない。"},{"spoiler":false,"text":"明るく振舞ってはいるが、実は天涯孤独の身の上。"},{"spoiler":false,"text":"「だから、男の子じゃなくて男の娘！」"}],"source":"bangumi","sourceCharacterId":"12482"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b9157325f54870c2eb84c4513a6136cbe8c3bd980df40a0856ea0d307cc4ea0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7af89e47e68d83afdef0e26e6844cda45edca7ae1eb5dafdf5ce1fe7cce23469.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真中桂子","creatorId":"vndb:s4378","sourcePersonId":"vndb:s4378","canonicalEntityId":"vndb:s4378","name":"真中 桂子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15002:12482:5205:1","source":"bangumi"}]},{"characterId":"char_c32154","characterName":"古屋敷 由良","sourceIds":{"bangumi":[{"characterId":"12483","match":"exact-normalized-name-in-linked-work","subjectId":"15002"}],"egsCharacterIds":["10375"],"vndbCharacterId":"c32154"},"originalCharacterName":"古屋敷 由良","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The only resident of the hidden village, who ever leaves it. He is currently a university student. He despises crossdressing and started studying in order to leave the village after graduation."}],"source":"vndb","sourceCharacterId":"c32154"},{"segments":[{"spoiler":false,"text":"我がままで気難し屋のお嬢様。毒舌キャラ。"},{"spoiler":false,"text":"両親が忙しいため、小さい頃から夏休みの間は親戚の史緒の家に預けられている。"},{"spoiler":false,"text":"幼い頃から女として育てられ、外に出て実際の男と女を知ってからは自分の境遇を呪うようになる。村の因習に従い女装しているが本人は嫌々。"},{"spoiler":false,"text":"しきたりに煩い史緒が怖くて脱ぐこともできない。"},{"spoiler":false,"text":"女としてしみついた癖がなかなか抜けない。"},{"spoiler":false,"text":"普通の常識が通じない村の因習を主人公に説明する役目。"},{"spoiler":false,"text":"性知識は外の常識を兼ね備えた人間だが性格的には支配するのが好きなドS。"},{"spoiler":false,"text":"主人公がやってきたせいで村のみんなに子供を作るようせっつかれるため、早く出て行って欲しいと思っている。"},{"spoiler":false,"text":"主人公を利用して、村を脱出しようと考えその体をつかって篭絡することを思いつく。"},{"spoiler":false,"text":"主人公を身も心も支配するために羞恥心を煽ってＳ気のある責めをしてくる。"}],"source":"egs","sourceCharacterId":"10375","sourceWorkId":"15148","spoiler":false},{"segments":[{"spoiler":false,"text":"ワガママで気難し屋のお嬢様。毒舌キャラ。"},{"spoiler":false,"text":"両親が忙しいため、小さい頃から夏休みの間は親戚の史緒の家に預けられている。"},{"spoiler":false,"text":"村の因習に従い女装しているが、本人は嫌々。しきたりにうるさい史緒が怖くて脱ぐこともできない。"},{"spoiler":false,"text":"また女として染み付いた習慣がなかなか抜けない。"},{"spoiler":false,"text":"性知識は外の常識を兼ね備えた人間だが、性格的には支配するのが好きなドS。"},{"spoiler":false,"text":"主人公がやってきたせいで村のみんなに子供を作るようせっつかれるため、早く出て行ってほしいと思っている。"},{"spoiler":false,"text":"「椅子じゃないでしょ、豚は床の上で十分。それとも四つん這いのほうがいい？」"}],"source":"bangumi","sourceCharacterId":"12483"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/2067e833d184b1c7e83dc17a23330c10113bb4750e3beb88712f152881f50b73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f13489cc27f7470645f5062b970a5338e958dc8b2759df07b99e1ee5f663674e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15002:12483:5900:1","source":"bangumi"}]},{"characterId":"char_vndb_c32157","characterName":"度会 行人","sourceIds":{"vndbCharacterId":"c32157"},"originalCharacterName":"度会 行人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist, who goes wandering to the mountains after being rejected by all women and falls into a deep pit to be saved by Fumio."}],"source":"vndb","sourceCharacterId":"c32157"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p308","sourceCompanyId":"egs:brand:1982","canonicalEntityId":"vndb:p308","name":"脳内彼女","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:15148:1982","source":"egs"},{"companyId":"vndb:p24514","sourceCompanyId":"vndb:p24514","canonicalEntityId":"vndb:p24514","name":"Kuroneko Hashimoto","roleCodes":[