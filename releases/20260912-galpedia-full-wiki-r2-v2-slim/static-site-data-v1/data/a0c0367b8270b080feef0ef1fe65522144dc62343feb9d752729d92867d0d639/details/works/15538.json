assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/462ea7efd3cfd62567762dc90986035f0c0786f75cf6e3130e48a824d185a5d2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鷹岳 優咲","creatorId":"vndb:s35348","sourcePersonId":"vndb:s35348","canonicalEntityId":"vndb:s35348","name":"鷹岳 優咲","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40112","source":"vndb"}]},{"characterId":"char_c34227","characterName":"鞍月 柚南","sourceIds":{"bangumi":[{"characterId":"58261","match":"exact-normalized-name-in-linked-work","subjectId":"19063"}],"egsCharacterIds":["9981"],"vndbCharacterId":"c34227"},"originalCharacterName":"鞍月 柚南","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Childhood Friend and classmate of Yoruhiko"}],"source":"vndb","sourceCharacterId":"c34227"},{"segments":[{"spoiler":false,"text":"主人公・夜彦の幼馴染。"},{"spoiler":false,"text":"幼い頃から夜彦に思いを寄せているが、ずっと告白できないまま、現在に至っている。"},{"spoiler":false,"text":"「ヒコくんのお嫁さんになったら、素敵な教会で結婚式をあげて、新婚旅行は南国に行って、毎日のお目覚めはキスから始まって……きゃーっ！ もうもうっ！」"},{"spoiler":false,"text":"――と、妄想はするものの、現実は手を繋いだことすらほとんどない。"},{"spoiler":false,"text":"味覚は普通なのだが、生来ののんびり性格とおっちょこちょいが手伝ってか、料理スキルは皆無。卵かけ御飯程度しか作れないのがコンプレックス。"},{"spoiler":false,"text":"食いしん坊の夜彦に美味しい手料理を振舞いたい！ と一念発起し、調理研究会に入った。"},{"spoiler":false,"text":"愛情いっぱいの美味しい手作り弁当を持って、夜彦とピクニックに赴き、「はい、ヒコ君、あーん♪」とイチャラブするのが柚南の当面の目標である。"}],"source":"egs","sourceCharacterId":"9981","sourceWorkId":"15538","spoiler":false},{"segments":[{"spoiler":false,"text":"夜彦の幼なじみ。"},{"spoiler":false,"text":"幼い頃から夜彦に想いを寄せているが、ずっと告白できないまま現在に至っている。"},{"spoiler":false,"text":"味覚は普通なのだが、のんびりな性格とおっちょこちょいが手伝ってか料理スキルは皆無で、卵かけご飯程度しか作れない。"},{"spoiler":false,"text":"夜彦に美味しい手料理を振舞いたい！ と一念発起し、調理研究会に入った。"},{"spoiler":false,"text":"「隠し味の愛情はたっぷり入ってるよ♪」"}],"source":"bangumi","sourceCharacterId":"58261"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/2290629f7930aae9690cb2aa393865c188f4b96d5811c5217a390f0d86ad3010.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f786e0413777e66f699e1587e4d49d9a6a336fcbc6fadb3eb4dcda77a88bef4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19063:58261:6349:1","source":"bangumi"}]},{"characterId":"char_c34228","characterName":"ぐーにゃん","sourceIds":{"bangumi":[{"characterId":"58262","match":"exact-normalized-name-in-linked-work","subjectId":"19063"}],"egsCharacterIds":["9982"],"vndbCharacterId":"c34228"},"originalCharacterName":"ぐーにゃん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Classmate of Yoruhiko"},{"spoiler":true,"text":"Ringo will develop taste disorder in her story but she will get her taste back later. She will also become the next president of the cooking club."}],"source":"vndb","sourceCharacterId":"c34228"},{"segments":[{"spoiler":false,"text":"主人公・夜彦のクラスメイトで、悪友。愛称しんぐー。"},{"spoiler":false,"text":"ホテルでシェフをしているしている親の影響もあり、料理スキルは高いものの、キツイ性格と口調のせいで他人と距離を置きがちな少女。"},{"spoiler":false,"text":"親譲りの料理の腕を見込まれて、憎まれ口を叩きながらも主人公の誘いを受けてメンバーに加わる。"},{"spoiler":false,"text":"プライドが高く、妥協を許さない性格で料理に関してもトコトン追求するタイプ。"},{"spoiler":false,"text":"毎日作るお弁当ですら研究を欠かさない。"},{"spoiler":false,"text":"バストサイズが夜彦が触っても気付かない程小ぶりで、色気がないことをかなり気にしている。"},{"spoiler":false,"text":"口ではアレコレと文句を言いつつも、心の奥では気さくに話しかけてくれる夜彦に感謝しており、共に活動していくうち、段々と気になる存在に……"},{"spoiler":false,"text":"「料理の基本は和食も洋食も変わらないわ。"}],"source":"egs","sourceCharacterId":"9982","sourceWorkId":"15538","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・夜彦のクラスメイトで悪友。高級ホテルに務めるシェフの一人娘"},{"spoiler":false,"text":"胸のサイズはやや小さめで、真彩以下。"},{"spoiler":false,"text":"胸の小ささと色気がないことを少し気にしている。"},{"spoiler":false,"text":"キツイ性格と口調のせいで他人と距離を置き気味の林檎にとって、物怖じしない （鈍感とも言う） 夜彦が学園内で初めてできた友人。"},{"spoiler":false,"text":"「料理の基本は和食も洋食も変わらないわ。レシピ通りに作れば、失敗するわけがないじゃない」"}],"source":"bangumi","sourceCharacterId":"58262"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83b76d1a4528ed5b856ecfc987c0203fec4d3283186d79f28676f4277936b64d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d0003444b845632c8248f5a99b25e7bc112507badf142be5771287660bab62b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19063:58262:8055:1","source":"bangumi"}]},{"characterId":"char_c34229","characterName":"深海 鈴乃","sourceIds":{"bangumi":[{"characterId":"58263","match":"exact-normalized-name-in-linked-work","subjectId":"19063"}],"egsCharacterIds":["9983"],"vndbCharacterId":"c34229"},"originalCharacterName":"深海 鈴乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuna and Maaya’s senpai"}],"source":"vndb","sourceCharacterId":"c34229"},{"segments":[{"spoiler":false,"text":"主人公の先輩で、調理研究会会長。物腰柔らかく温厚。"},{"spoiler":false,"text":"いつもニコニコとおだやかな笑顔で皆を見守るお姉さん的存在。"},{"spoiler":false,"text":"柚南や真綾がとんでもない料理を作ろうとしても、ひとつひとつ丁寧に優しく注意しながら教えてくれる面倒見のいいタイプ。"},{"spoiler":false,"text":"一般的な家庭料理が得意で、煮物、麻婆豆腐、ハンバーグなどなど、派手さは無いものの、和洋中、家庭的にアレンジされたレシピを大量に持つ。"},{"spoiler":false,"text":"成績優秀。運動も苦手ではなく、オールマイティーだが、胸が大きいせいで男性に見られるプレッシャーに弱い。"},{"spoiler":false,"text":"が、夜彦だけは例外で『男というより弟』であるらしく、ごく普通に接してくれる。"}],"source":"egs","sourceCharacterId":"9983","sourceWorkId":"15538","spoiler":false},{"segments":[{"spoiler":false,"text":"いつもおだやかな笑顔で皆を見守るお姉さん的先輩で、料理研究会会長。物腰柔らかく温厚。"},{"spoiler":false,"text":"一般的な家庭料理が得意で、派手さは無いものの和洋中、家庭的にアレンジされたレシピを大量に持つ。"},{"spoiler":false,"text":"成績優秀。運動も苦手ではなくオールマイティーだが、胸が大きいせいで男性に見られるとプレッシャーを感じてしまう。"},{"spoiler":false,"text":"“男というより弟” 扱いの夜彦だけは例外らしい。"},{"spoiler":false,"text":"「さて、それでは今日も美味しいお料理ができるように、がんばりましょう♪」"}],"source":"bangumi","sourceCharacterId":"58263"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86a97c417d7ab1bde805e0be3bcf4525073626b7e7a08ab56ce5e980aba56b6c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d80b625d67ab372545534a2a44eac61716b88bb45dd81058afdd37cdaabd3b7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19063:58263:6351:1","source":"bangumi"}]},{"characterId":"char_c34230","characterName":"まやちゃん","sourceIds":{"bangumi":[{"characterId":"58264","match":"exact-normalized-name-in-linked-work","subjectId":"19063"}],"egsCharacterIds":["9984"],"vndbCharacterId":"c34230"},"originalCharacterName":"まやちゃん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kouhai of Yuna and Suzuno"}],"source":"vndb","sourceCharacterId":"c34230"},{"segments":[{"spoiler":false,"text":"主人公の後輩にあたる。有り余るほどに元気で、いつでもテンション高め。"},{"spoiler":false,"text":"日々、あまり客の来ない学食の運営に精を出しており、鈴乃に調理研究会を発足するように提案した張本人。"},{"spoiler":false,"text":"かなりの甘党で、ケーキにチョコレートとあんこをトッピングして蜂蜜をかける程甘味を愛している。"},{"spoiler":false,"text":"主食でもおかずでも、なんでも甘くしてしまうひどい癖がある。"},{"spoiler":false,"text":"学食に客が来ないのは、真彩のせいなんじゃないかという説あり。"},{"spoiler":false,"text":"ただし、スイーツを作らせれば、独自の甘みに対するこだわりで光るものがある。"}],"source":"egs","sourceCharacterId":"9984","sourceWorkId":"15538","spoiler":false},{"segments":[{"spoiler":false,"text":"1-A所属。夜彦の後輩にあたる。"},{"spoiler":false,"text":"あり余るほどに元気で、いつでもテンション高め。"},{"spoiler":false,"text":"日々あまり客の来ない学食の運営に精を出しており、鈴乃に調理研究会を発足するように提案した張本人。"},{"spoiler":false,"text":"かなりの甘党で、得意料理は野菜炒めの蜂蜜ソース和え。"},{"spoiler":false,"text":"主食でもおかずでも、なんでも甘くしてしまうひどい癖がある。"},{"spoiler":false,"text":"「はふぅ～っ、やっぱり甘味は最高なのですよ！」"}],"source":"bangumi","sourceCharacterId":"58264"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6cc8fa4c62168837ff9db7b513838037081175a22751b6f0acac22feeabadd2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e75c868ab13bc2ed926dbaea6d01442ed152085945cea132973db4e6e92e8943.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞森柚子","creatorId":"egs:creator:36244","sourcePersonId":"egs:creator:36244","canonicalEntityId":"egs:creator:36244","name":"瑞森柚子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19063:58264:25171:1","source":"bangumi"},{"creditedName":"このえ ゆずこ","creatorId":"vndb:s995","sourcePersonId":"vndb:s995","canonicalEntityId":"vndb:s995","name":"このえ ゆずこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40109","source":"vndb"}]},{"characterId":"char_c34231","characterName":"ネメシス","sourceIds":{"bangumi":[{"characterId":"58265","match":"exact-normalized-name-in-linked-work","subjectId":"19063"}],"egsCharacterIds":["9985"],"vndbCharacterId":"c34231"},"originalCharacterName":"ネメシス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuna classmate"}],"source":"vndb","sourceCharacterId":"c34231"},{"segments":[{"spoiler":false,"text":"２－Ｃ所属で、柚南のクラスメイト。"},{"spoiler":false,"text":"お嬢様然とした礼儀正しい性格、見た目の麗しさも相まって学園のアイドルといった物腰。"},{"spoiler":false,"text":"クラスメートの柚南が学食を盛り上げようとしているのを知って、度々訪ねてくる。"},{"spoiler":false,"text":"料理評論家の間ではその名は有名で、味見をした瞬間周囲にそのイメージを視覚にして伝えるという珍しい体質の持ち主。"},{"spoiler":false,"text":"味見の瞬間、周囲の人間には彼女が女神のような姿に見えることから、業界では『神の味覚審判【ネメシス】』と呼ばれている。"},{"spoiler":false,"text":"……が、何故か夜彦には食事を始めた途端、淫靡な雰囲気をまとっているようにしか見えないため、大変目のやり場に困る存在。"}],"source":"egs","sourceCharacterId":"9985","sourceWorkId":"15538","spoiler":false},{"segments":[{"spoiler":false,"text":"2-C所属で、柚南のクラスメイト。"},{"spoiler":false,"text":"お嬢様然とした礼儀正しい性格、見た目の麗しさも相まって学園のアイドルといった物腰。"},{"spoiler":false,"text":"クラスメイトの柚南が学食を盛り上げようとしているのを知って、度々訪ねてくる。"},{"spoiler":false,"text":"料理評論家の間ではその名は有名で、味見をした瞬間、周囲にそのイメージを視覚にして伝えるという珍しい体質の持ち主。"},{"spoiler":false,"text":"その瞬間は周囲の人間には彼女が女神のような姿に見えることから、業界では “神の味覚審判（ネメシス）” と呼ばれている。"},{"spoiler":false,"text":"……が、何故か夜彦には食事を始めた途端、淫靡な雰囲気をまとっているようにしか見えないため、大変目のやり場に困る存在。"}],"source":"bangumi","sourceCharacterId":"58265"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ece2ff06c251875675af79ec51717ddfc7f92ea29e10f3d8f5341e0f69f0d072.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf14264294a3e6bfe20a4a3fc745fe26c1fa0b5d22bfb923e21f7d8d4a4afddf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加乃みるく","creatorId":"vndb:s863","sourcePersonId":"vndb:s863","canonicalEntityId":"vndb:s863","name":"加乃 みるく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19063:58265:11511:1","source":"bangumi"}]},{"characterId":"char_c34232","characterName":"久保 日向","sourceIds":{"bangumi":[{"characterId":"58266","match":"exact-normalized-name-in-linked-work","subjectId":"19063"}],"egsCharacterIds":["9986"],"vndbCharacterId":"c34232"},"originalCharacterName":"久保 日向","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Home room teacher of Yoruhiko and Ringo and the teacher in charge of Yuna, Suzuno and Maaya cooking club"}],"source":"vndb","sourceCharacterId":"c34232"},{"segments":[{"spoiler":false,"text":"学食の常連で夜彦の担任、かつ調理研究会の顧問。"},{"spoiler":false,"text":"人が少なく、教師として気張らなくていい学食で、一部の学生をセクハラ紛いにイジりつつ食事をするのが日課になっている。"},{"spoiler":false,"text":"真彩の失敗激甘料理も笑いながら食べてしまう、ある意味では非常に度量の大きな女性。"},{"spoiler":false,"text":"料理スキルはまったくなく、作る気もまったくない食べる方専門。"},{"spoiler":false,"text":"夜彦ほどではないが、大食い属性持ちであり。しかも食べても太らず、体型を維持している。"},{"spoiler":false,"text":"緊急事態を迎えた研究会のために何かすると言うことはなく、基本的に見守るだけだが、基本的には良い先生で、締めるべきところはちゃんと締めている。"},{"spoiler":false,"text":"学生の人気も高く、むしろ、ベテラン教師陣に評判が悪い。"}],"source":"egs","sourceCharacterId":"9986","sourceWorkId":"15538","spoiler":false},{"segments":[{"spoiler":false,"text":"学食の常連で夜彦の担任、かつ調理研究会の顧問。"},{"spoiler":false,"text":"人が少なく教師として気張らなくていい学食で、一部の学生をセクハラ紛いにイジりつつ食事をするのが日課になっている。"},{"spoiler":false,"text":"真彩の失敗激甘料理も笑いながら食べてしまう、ある意味では非常に度量の大きな女性。"},{"spoiler":false,"text":"料理スキルはまったく無く、作る気もまったく無い食べるほう専門。"},{"spoiler":false,"text":"夜彦ほどではないが大食い属性持ちであり、しかも食べても太らず体型を維持している。"},{"spoiler":false,"text":"緊急事態を迎えた研究会のために何かするということはなく、基本的に見守るだけだが、締めるべきところはちゃんと締めている。"},{"spoiler":false,"text":"学生からの人気は高いが、ベテラン教師陣には評判が悪い。"}],"source":"bangumi","sourceCharacterId":"58266"}],"profileFacts":[],"metadataCand