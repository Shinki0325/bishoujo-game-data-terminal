ic-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:448660:138228:6036:1","source":"bangumi"}]},{"characterId":"char_c77995","characterName":"橘 月姫","sourceIds":{"bangumi":[{"characterId":"138230","match":"exact-normalized-name-in-linked-work","subjectId":"448660"}],"egsCharacterIds":["27476"],"vndbCharacterId":"c77995"},"originalCharacterName":"橘 月姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【典型的なお嬢様】"},{"spoiler":false,"text":"主人公に(不純な動機で)迫るプライド高めな人。"},{"spoiler":false,"text":"一乃瀬真名さんと同じ大学に通っているが、何かと彼女に対抗する。"},{"spoiler":false,"text":"かなり経済的に裕福な家庭で育ったお嬢様タイプである。"},{"spoiler":false,"text":"何をするにも、財力にモノを言わせた「華麗な作戦」を練る。"},{"spoiler":false,"text":"ただしそれが良い方向に働いているかは疑問というのが大方の意見らしい。"},{"spoiler":false,"text":"ひとたび呼べば付き人の「黒福 慶吾」が現れ、その作戦を実行に移してくれる。"},{"spoiler":false,"text":"なにかとアクションが派手で、演出込みの高笑いをするが、"},{"spoiler":false,"text":"いまひとつキマらないのは何故か。"}],"source":"egs","sourceCharacterId":"27476","sourceWorkId":"2744","spoiler":false},{"segments":[{"spoiler":false,"text":"【典型的なお嬢様】"},{"spoiler":false,"text":"主人公に(不純な動機で)迫るプライド高めな人。"},{"spoiler":false,"text":"一乃瀬真名さんと同じ大学に通っているが、何かと彼女に対抗する。"},{"spoiler":false,"text":"かなり経済的に裕福な家庭で育ったお嬢様タイプである。"},{"spoiler":false,"text":"何をするにも、財力にモノを言わせた「華麗な作戦」を練る。"},{"spoiler":false,"text":"ただしそれが良い方向に働いているかは疑問というのが大方の意見らしい。"},{"spoiler":false,"text":"ひとたび呼べば付き人の「黒福 慶吾」が現れ、その作戦を実行に移してくれる。"},{"spoiler":false,"text":"なにかとアクションが派手で、演出込みの高笑いをするが、"},{"spoiler":false,"text":"いまひとつキマらないのは何故か。"},{"spoiler":false,"text":"「私にできないことなど、なにひとつなくってよ！」"}],"source":"bangumi","sourceCharacterId":"138230"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2bd0be804df480da48a8f37cae5847f967278ab278677d8895b69e18c2e3ccb7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c36d97cb73e15d427daf44e61ba1c2bb6a970c12f547d7992f0ce2403b83bf23.webp","width":123,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真木碧","creatorId":"vndb:s2000","sourcePersonId":"vndb:s2000","canonicalEntityId":"vndb:s2000","name":"真木 碧","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:448660:138230:6130:1","source":"bangumi"}]},{"characterId":"char_c77996","characterName":"剣崎 美雪","sourceIds":{"bangumi":[{"characterId":"138232","match":"exact-normalized-name-in-linked-work","subjectId":"448660"}],"egsCharacterIds":["27478"],"vndbCharacterId":"c77996"},"originalCharacterName":"剣崎 美雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【しっかりした店員さん】"},{"spoiler":false,"text":"きまじめな一面をもつ人。めがねがトレードマーク。"},{"spoiler":false,"text":"大人な感じで日頃はやさしく、ちょっと頼れる感じの人。"},{"spoiler":false,"text":"ある人（神無月 未来）にからかわれると静かに怒りをため、一線を超えると激しく噴出する。"},{"spoiler":false,"text":"実は笑い上戸。面白い話を聞いたり思い出したりすると、息ができなくなるまで（静かに）大爆笑する。"},{"spoiler":false,"text":"どうやら心の中の表情は常人を超える豊かさがあるが、あまり地を出さないように努力するヘンなきまじめさがあり、必死で表情を真顔に保とうとする。"},{"spoiler":false,"text":"神無月 未来さんと、幼馴染でくされ縁。"},{"spoiler":false,"text":"なぜか仕事場まで一緒になっている。"},{"spoiler":false,"text":"神無月 未来にはいろんな意味で勝っているという自負から、たまに挑発的なことを神無月 未来に言い、くやしがらせる。"}],"source":"egs","sourceCharacterId":"27478","sourceWorkId":"2744","spoiler":false},{"segments":[{"spoiler":false,"text":"【しっかりした店員さん】"},{"spoiler":false,"text":"きまじめな一面をもつ人。めがねがトレードマーク。"},{"spoiler":false,"text":"大人な感じで日頃はやさしく、ちょっと頼れる感じの人。"},{"spoiler":false,"text":"ある人（神無月 未来）にからかわれると静かに怒りをため、"},{"spoiler":false,"text":"一線を超えると激しく噴出する。"},{"spoiler":false,"text":"実は笑い上戸。面白い話を聞いたり思い出したりすると、"},{"spoiler":false,"text":"息ができなくなるまで（静かに）大爆笑する。"},{"spoiler":false,"text":"どうやら心の中の表情は常人を超える豊かさがあるが、"},{"spoiler":false,"text":"あまり地を出さないように努力するヘンなきまじめさがあり、"},{"spoiler":false,"text":"必死で表情を真顔に保とうとする。"},{"spoiler":false,"text":"神無月 未来さんと、幼馴染でくされ縁。"},{"spoiler":false,"text":"なぜか仕事場まで一緒になっている。"},{"spoiler":false,"text":"神無月 未来にはいろんな意味で勝っているという自負から、"},{"spoiler":false,"text":"たまに挑発的なことを神無月 未来に言い、くやしがらせる。"},{"spoiler":false,"text":"「ま、あのバカはほっといて……」"}],"source":"bangumi","sourceCharacterId":"138232"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/322e67bab97fc79fb313bda775739fda64373b4b3f08e1c4d59c5d0f21036644.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/5248135b891a6c5d606fc94f430c974ed5a7ca6dd01cefa70a20bf3660119eb8.webp","width":136,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:448660:138232:4940:1","source":"bangumi"}]},{"characterId":"char_c77998","characterName":"神無月 未来","sourceIds":{"bangumi":[{"characterId":"138229","match":"exact-normalized-name-in-linked-work","subjectId":"448660"}],"egsCharacterIds":["27475"],"vndbCharacterId":"c77998"},"originalCharacterName":"神無月 未来","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【元気(すぎ)な店員さん】"},{"spoiler":false,"text":"何かにつけて元気が溢れ出す暴走気味の人。"},{"spoiler":false,"text":"すぐに熱くなる。しかもウルサイ。"},{"spoiler":false,"text":"きまじめそうな人（剣崎美雪さん限定）をいじって反応を見るのが日課。"},{"spoiler":false,"text":"歳の割に子供っぽい面が表に出やすいが、ヘンに少女趣味な面もある。"},{"spoiler":false,"text":"騙されやすく、情に厚く涙もろい一面があり、良くも悪くも一直線な性格。"},{"spoiler":false,"text":"剣崎 美雪と幼馴染でくされ縁。なぜか仕事場まで一緒になっている。"},{"spoiler":false,"text":"まれに剣崎さんと絶妙なコンビネーションで大活躍することがあるらしいが……。"},{"spoiler":false,"text":"普段からは想像がつきにくい。"}],"source":"egs","sourceCharacterId":"27475","sourceWorkId":"2744","spoiler":false},{"segments":[{"spoiler":false,"text":"【元気(すぎ)な店員さん】"},{"spoiler":false,"text":"何かにつけて元気が溢れ出す暴走気味の人。"},{"spoiler":false,"text":"すぐに熱くなる。しかもウルサイ。"},{"spoiler":false,"text":"きまじめそうな人（剣崎美雪さん限定）をいじって反応を見るのが日課。"},{"spoiler":false,"text":"歳の割に子供っぽい面が表に出やすいが、ヘンに少女趣味な面もある。"},{"spoiler":false,"text":"騙されやすく、情に厚く涙もろい一面があり、良くも悪くも一直線な性格。"},{"spoiler":false,"text":"剣崎 美雪と幼馴染でくされ縁。なぜか仕事場まで一緒になっている。"},{"spoiler":false,"text":"まれに剣崎さんと絶妙なコンビネーションで大活躍することがあるらしいが……。"},{"spoiler":false,"text":"普段からは想像がつきにくい。"},{"spoiler":false,"text":"「ね、ね、美雪～。今日のおやつは何にする？"},{"spoiler":false,"text":"お向かいの万疋屋のケーキ？　それとも……」"}],"source":"bangumi","sourceCharacterId":"138229"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/395a9f48d4d994b370a67d3b88e7ddc394210ee1fd24e20c3632a747ddf67244.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a2f40373e9a96f7b0d25eec5ef303285c8d3fb2ee096af217d2d82c861d3012.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水城ありさ","creatorId":"vndb:s10851","sourcePersonId":"vndb:s10851","canonicalEntityId":"vndb:s10851","name":"水城 ありさ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:448660:138229:55937:1","source":"bangumi"}]},{"characterId":"char_c77999","characterName":"深崎 留奈","sourceIds":{"bangumi":[{"characterId":"138231","match":"exact-normalized-name-in-linked-work","subjectId":"448660"}],"egsCharacterIds":["27477"],"vndbCharacterId":"c77999"},"originalCharacterName":"深崎 留奈","charac