rce":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"近江联盟第5代会长·乡田仁的养子。近江四天王中的一人，近江连合直系乡龙会第2代会长。"},{"spoiler":false,"text":"背后刺有被叫做四神兽之长的黄龙刺青。身穿内衬黑色衬衫的米黄色西服外披黑绒的米黄色大衣，常常会携带一把小太刀。"},{"spoiler":false,"text":"有着“关西之龙”的称号，与桐生一马被称为极道双龙。"},{"spoiler":false,"text":"因坚强实力和领袖魅力而被称为“关西之龙”，但他认为「龙的称号应该要独一无二」，其实并不喜欢这个外号。"},{"spoiler":false,"text":"为达目的不择手段，想要的东西就全力抢夺，但在强悍作风的背后，他也秉持着不随便违背仁义的理念。怀着进军关东的野心，企图攻进神室町。"}],"source":"bangumi","sourceCharacterId":"197327"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44b073a4b87a9301d6c7ce0cc9f8065ce66999224394e6d78a5b40ad048d53c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df92496d5107355abec7de942fee7565a994ec75fae3a1cf74a5934a9b595e05.webp","width":256,"height":144,"source":"static-detail"},"actors":[{"creditedName":"岩崎征実","creatorId":"vndb:s4902","sourcePersonId":"vndb:s4902","canonicalEntityId":"vndb:s4902","name":"岩崎 征実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223578:197327:4277:1","source":"bangumi"}]},{"characterId":"char_bangumi_29220","characterName":"東城会四代目","sourceIds":{"bangumi":[{"characterId":"29220","match":"source-roster","subjectId":"155364"},{"characterId":"29220","match":"source-roster","subjectId":"223578"}]},"originalCharacterName":"東城会四代目","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"184"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"88"}},"descriptions":[{"segments":[{"spoiler":false,"text":"背に彫られた宝玉を持った龍の刺青から「堂島の龍」「伝説の龍」「伝説の極道」と呼ばれる元ヤクザ。"},{"spoiler":false,"text":"強い正義感と情の厚さを兼ね備え、仁義に生きる男。引退後も彼の影響などで極道に足を踏み入れる者もいる。基本的に物静かで感情をあまり表情に出さないが、自身が強い信頼を抱いた者（島袋力也など）が死んだ場合などは滂沱（ぼうだ）の涙を流すこともある。また、根が強く、一度決めたら曲げないほどの頑固さもある。"}],"source":"bangumi","sourceCharacterId":"29220"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c46afdd7e618bfeb3f8e344af5e750f0a9e0c9f62754b5fdaeb76b1f660af3f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/381d2f0abe1bc99a9ecfd83b1c076d5a2d57fba4fef26523e2138af93c287434.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黒田崇矢","creatorId":"vndb:s170","sourcePersonId":"vndb:s170","canonicalEntityId":"vndb:s170","name":"黒田 崇矢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223578:29220:4225:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:628","sourceCompanyId":"egs:brand:628","canonicalEntityId":"egs:brand:628","name":"SEGA(セガゲームス)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:30328:628","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
