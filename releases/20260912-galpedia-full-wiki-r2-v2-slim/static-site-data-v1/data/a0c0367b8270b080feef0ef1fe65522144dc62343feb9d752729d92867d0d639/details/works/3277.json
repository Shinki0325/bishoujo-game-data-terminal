":"source-only","source":"vndb","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"病院随一の天然ロリッ娘新人ナース。"},{"spoiler":false,"text":"その天然ボケ、ドジっぷりは美希を遥かに凌ぐが、ナースのお仕事的には美希よりも「出来る」ようだ。"},{"spoiler":false,"text":"趣味はゲーム機や同人誌集めのほかコスプレも嗜む程度。"},{"spoiler":false,"text":"エッチなことには無関心のように見えて、かなり興味津々。"}],"source":"egs","sourceCharacterId":"27147","sourceWorkId":"3277","spoiler":false},{"segments":[{"spoiler":false,"text":"一ノ瀬大学医学部付属病院に勤務する新人ナース。"},{"spoiler":false,"text":"美希、愛美、沙弥香たちと同期。天然ボケでいつも回りの人を疲れさせる。妄想癖があり美希より重症気味。看護学校時代の成績は芳しくなかったのですが、美希より出来る感じです。趣味のゲーム機集めはかなりマニアック。また、ゲームキャラのコスプレや同人誌（やおい系）なんかも自分でつくったりしている。Ｈなことには興味深々な性格。"}],"source":"bangumi","sourceCharacterId":"37638"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4b1cdde3f75f799d73017d9c9197f148358119370036ff211db7de22a2ed0d3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c9832c73179b3f70061bdd5ff4ddcc6c890911743a2005aced9d9c94e8081d0.webp","width":180,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:158433:37638:4830:1","source":"bangumi"}]},{"characterId":"char_c4074","characterName":"長月 沙弥香","sourceIds":{"bangumi":[{"characterId":"37637","match":"exact-normalized-name-in-linked-work","subjectId":"158433"}],"egsCharacterIds":["27146"],"vndbCharacterId":"c4074"},"originalCharacterName":"長月 沙弥香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"見栄っ張りで自意識過剰、さらにはプライドも高い新人ナース。"},{"spoiler":false,"text":"何故なのか、美希に対して異様なまでにライバル心を燃やし、なんであれ美希に勝っていないと気が済まないらしい。"},{"spoiler":false,"text":"そのため美希の親友・愛美とも犬猿の仲。"}],"source":"egs","sourceCharacterId":"27146","sourceWorkId":"3277","spoiler":false},{"segments":[{"spoiler":false,"text":"一ノ瀬大学医学部付属病院の新人ナース。"},{"spoiler":false,"text":"自分では気にしていないが、他人からみると、かなり自意識過剰な感じに見える。そのせいか友人らしい友人はいない。とにかく、なんでも美希より勝っていないと気がすまず、また、人の話をあまりまじめに聞かないので同じコトを何回も聞く癖がある。会話もたまにピントのずれた答えが返ってくる。"}],"source":"bangumi","sourceCharacterId":"37637"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89b7bb7674e84525f84dcc9df60abeccb19addf4d66faa637732da396ce3490d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c69311d02b1a1b8a8bfa16c26a161194c2022e9617a8fc0da23aa6140519e0f7.webp","width":165,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松久保いほ","creatorId":"vndb:s8744","sourcePersonId":"vndb:s8744","canonicalEntityId":"vndb:s8744","name":"松久保 いほ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:158433:37637:4889:1","source":"bangumi"},{"creditedName":"春瀬 みき","creatorId":"vndb:s1566","sourcePersonId":"vndb:s1566","canonicalEntityId":"vndb:s1566","name":"春瀬 みき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29629","source":"vndb"}]},{"characterId":"char_c4075","characterName":"川村 映子","sourceIds":{"bangumi":