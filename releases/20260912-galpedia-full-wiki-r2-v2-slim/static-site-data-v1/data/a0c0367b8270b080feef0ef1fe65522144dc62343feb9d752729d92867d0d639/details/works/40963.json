":"あやかわ りく","creatorId":"vndb:s9839","sourcePersonId":"vndb:s9839","canonicalEntityId":"vndb:s9839","name":"あやかわ りく","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:129314","source":"vndb"},{"creditedName":"証","creatorId":"vndb:s9840","sourcePersonId":"vndb:s9840","canonicalEntityId":"vndb:s9840","name":"証","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:129316","source":"vndb"}]},"cast":[{"characterId":"char_c45153","characterName":"柚ノ木 未緒","sourceIds":{"bangumi":[{"characterId":"42490","match":"exact-normalized-name-in-linked-work","subjectId":"185097"}],"egsCharacterIds":["8382"],"vndbCharacterId":"c45153"},"originalCharacterName":"柚ノ木 未緒","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist who is an active member of the tennis club, as well as the student council president. Mio is a hardworking girl who is very popular with her peers, and she has a graceful personality."},{"spoiler":false,"text":"Her parents are doctors and currently working abroad, so she lives together with just Shiori, whom she has a close relationship with."}],"source":"vndb","sourceCharacterId":"c45153"},{"segments":[{"spoiler":false,"text":"両親は共に医者。"},{"spoiler":false,"text":"二人とも主に海外で活動していて、なかなか日本には帰って来ない。"},{"spoiler":false,"text":"そのため普段はお手伝いさんの栞と二人で生活している。"},{"spoiler":false,"text":"栞とはそれほど歳も離れていないため、姉妹に間違われることがある。"},{"spoiler":false,"text":"未緒も栞の事を姉のように思っている所があり、時々甘えたくなる。"},{"spoiler":false,"text":"両親のことを尊敬していて、将来は自分も医師になりたいと考えている。"},{"spoiler":false,"text":"休日など、近所の総合病院の託児所で手伝いをしたりもしている。"},{"spoiler":false,"text":"しっかり者で、大抵のことはそつなくこなし、成績も良い。"},{"spoiler":false,"text":"一見隙のない雰囲気を持っているのだが、意外と抜けた所があり、ほんわかしている。"},{"spoiler":false,"text":"学園側・学生側どちらの立場も考えて動く事ができて、教師からも学生からも信頼が厚い。"},{"spoiler":false,"text":"普段は穏和だが、締めるところはきちんと締められるタイプ。"}],"source":"egs","sourceCharacterId":"8382","sourceWorkId":"23430","spoiler":false},{"segments":[{"spoiler":false,"text":"学生会長を務め、テニス部でも活躍している本作の主人公。"},{"spoiler":false,"text":"しっかり者で成績が良く、大抵のことはそつなくこなしてしまう。"},{"spoiler":false,"text":"隙のない女性に見えるが、意外とヌケたところもあり、ほんわかしている。"},{"spoiler":false,"text":"両親は医者として海外で活動しており、家ではお手伝いさんの栞と二人暮らし。"},{"spoiler":false,"text":"それほど年は離れていないので、周囲からは姉妹に間違われることがある。"},{"spoiler":false,"text":"本人たちも姉妹のように思っていて、家族同然の親しい関係を築いている。"},{"spoiler":false,"text":"「いつもありがとう。 みんながいてくれて、私は本当に幸せ者ね」"}],"source":"bangumi","sourceCharacterId":"42490"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9e04d49069d33824bf745f05106a0be071b900ddcf45583d3ccf99903562783.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a9dbca4990955416769355363ae385c0f2097377c7eca88c3de1e2bbc4be1f7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185097:42490:6016:1","source":"bangumi"}]},{"characterId":"char_c45154","characterName":"鮎川 凛香","sourceIds":{"bangumi":[{"characterId":"42491","match":"exact-normalized-name-in-linked-work","subjectId":"185097"}],"egsCharacterIds":["8383"],"vndbCharacterId":"c45154"},"originalCharacterName":"鮎川 凛香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mio's best friend who is also her childhood friend, as well as a member of the tennis club. She is aiming to become a professional tennis player, so she takes her activities at the club very seriously."}],"source":"vndb","sourceCharacterId":"c45154"},{"segments":[{"spoiler":false,"text":"未緒とは、幼い頃に同じテニススクールで出会い、そこで仲良くなった。"},{"spoiler":false,"text":"気がつけば学園もずっと一緒で、長い付き合いに。"},{"spoiler":false,"text":"ストイックな性格で一見クールな印象なのだが、わりとうっかりしている所があり、未緒とはお互いの抜けた所をフォローしあうような関係。"},{"spoiler":false,"text":"自分のうっかりは棚において「未緒には自分がついていないと……」なんて思っていたりする。"},{"spoiler":false,"text":"テニスの実力は部内随一で、都道府県の選抜チームに選出された。"},{"spoiler":false,"text":"練習熱心で、プロを目指している。"},{"spoiler":false,"text":"内心では未緒と一緒にプロになりたいと思っていたので、未緒が別の道へ進むことを少し寂しく感じている。"}],"source":"egs","sourceCharacterId":"8383","sourceWorkId":"23430","spoiler":false},{"segments":[{"spoiler":false,"text":"未緒の幼なじみで親友。 テニス部のエース。"},{"spoiler":false,"text":"幼い頃にテニススクールで出会い、気がつけば学園もずっと一緒。"},{"spoiler":false,"text":"ストイックな性格で一見クールな印象だが、わりとうっかりしている。"},{"spoiler":false,"text":"未緒とは、お互いにヌケたところをフォローし合うような関係。"},{"spoiler":false,"text":"自分のうっかりは棚に置いて、「未緒には自分がついていないと……」 なんて思っている。"},{"spoiler":false,"text":"将来は未緒と一緒にプロになりたいと思っていたので、願い叶わず少し寂しく感じている。"},{"spoiler":false,"text":"「次の大会は絶対優勝よ。 私と未緒、2人の力で優勝するんだから」"}],"source":"bangumi","sourceCharacterId":"42491"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/5980a78e9b052fa303cd1d5d99ea3fb49206a03a464be485bd82faa9a14dd6d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/9522cb8bc1713ca9afe89f611b4ee02e8d690e80ce9ea92b49ef178165e6d76e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林桂子","creatorId":"vndb:s443","sourcePersonId":"vndb:s443","canonicalEntityId":"vndb:s443","name":"小林 桂子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185097:42491:16180:1","source":"bangumi"}]},{"characterId":"char_c45155","characterName":"生駒 結衣","sourceIds":{"bangumi":[{"characterId":"42492","match":"exact-normalized-name-in-linked-work","subjectId":"185097"}],"egsCharacterIds":["8384"],"vndbCharacterId":"c45155"},"originalCharacterName":"生駒 結衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mio's cousin who also lives in her neighborhood, and a member of the school's swimming club. She loves the rice Shiori cooks, so she often crashes into Yui's house. Similarly to Mio, Yui is a very hardworking and diligent person, but tends to be overly serious at times too."},{"spoiler":false,"text":"She isn't all that sure about her future, but wishes to become a coach and PE teacher. During school she often hangs out with both Mio and Rinka."}],"source":"vndb","sourceCharacterId":"c45155"},{"segments":[{"spoiler":false,"text":"明るい性格でお調子者な所があるのだが、根は真面目なしっかり者で、さりげなく未緒や凛香をフォローする事も多い。"},{"spoiler":false,"text":"勉強するよりも体を動かすほうが好きといったタイプなのだが、勉強もしっかりやるタイプで成績も良い。"},{"spoiler":false,"text":"栞の作るご飯を食べたい、と言いながら、よく未緒の家に泊まりに来たりする。"},{"spoiler":false,"text":"人の世話を焼くのが好きなタイプで大体なんでも出来るのだが、料理だけは大の苦手。"},{"spoiler":false,"text":"将来の事はまだ明確には決めていないが、大まかにスポーツトレーナーや体育教師をイメージしている。"},{"spoiler":false,"text":"未緒の目指している道と、所々重なる所もあるため、一緒に勉強したりする事もある。"}],"source":"egs","sourceCharacterId":"8384","sourceWorkId":"23430","spoiler":false},{"segments":[{"spoiler":false,"text":"ご近所に住んでいる未緒の従姉妹。 水泳部員。"},{"spoiler":false,"text":"栞の作るご飯を食べたいと言っては、よく未緒の家に泊まりに来たりする。"},{"spoiler":false,"text":"明るい性格でお調子者なところはあるが、根はまじめなしっかり者。"},{"spoiler":false,"text":"さりげなく未緒や凛香をフォローすることも多い。"},{"spoiler":false,"text":"世話焼きでだいたいのことはこなせるが、料理だけは大の苦手。"},{"spoiler":false,"text":"将来のことはあまり考えていないが、トレーナーや体育教師をイメージしている。"},{"spoiler":false,"text":"未緒の目指している道と重なる部分もあるため、一緒に勉強することがある。"},{"spoiler":false,"text":"「なんでもかんでも1人で背負うことないんだからね。 駄目なときは投げちゃっていいんだから」"}],"source":"bangumi","sourceCharacterId":"42492"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21641705043d320b98ff9776288974017b97e917ffd95f5567f2205dcd428108.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f007e058518f8b02bc1623160d0ef9850cd39f37b23e9cfe95574897cb97daa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さいとうよしえ","creatorId":"vndb:s1545","sourcePersonId":"vndb:s1545","canonicalEntityId":"vndb:s1545","name":"月野きいろ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185097:42492:20696:1","source":"bangumi"}]},{"characterId":"char_c45156","characterName":"朝日奈 このみ","sourceIds":{"bangumi":[{"characterId":"42493","match":"exact-normalized-name-in-linked-work","subjectId":"185097"}],"egsCharacterIds":["8385"],"vndbCharacterId":"c45156"},"originalCharacterName":"朝日奈 このみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mio's underclassman and the treasurer of the student council, as well as a member of the swimming club. She is the wealthy daughter of the president of a major pharmaceutical company. Prior to entering high school, she'd heard of Mio because her parents were acquaintances with Mio's, but never had interacted with her."},{"spoiler":false,"text":"After entering high school, she entered the student council out of curiosity due to Mio being the president. However, she quickly started loving Mio and became dedicated at her job. She was assigned as the treasurer because she's good at maths; however, Konomi has trouble with every other subject. Konomi is also bad at sports, but joined the swimming club because she wanted to learn to swim. Her dream is to be able to swim before Mio graduates."}],"source":"vndb","sourceCharacterId":"c45156"},{"segments":[{"spoiler":false,"text":"大手製薬会社の社長の娘。"},{"spoiler":false,"text":"父は未緒の両親と知り合い。"},{"spoiler":false,"text":"未緒の事は話には聞いていたけれど、この学園に入学するまで会ったことは無かった。"},{"spoiler":false,"text":"その未緒が学生会長だと聞き、半ば興味半分で学生会に入る。"},{"spoiler":false,"text":"今では未緒の人となりにすっかり懐いていて、ある種、恋愛対象に近い憧れ目線で未緒を見ている。"},{"spoiler":false,"text":"スポーツはあまり得意ではないのだが、せめて泳げるようになりたくて水泳部に入部した。"},{"spoiler":false,"text":"数学は得意なのだが、他の成績はあまり良い方では無く、よく未緒に勉強を見てもらっている。"}],"source":"egs","sourceCharacterId":"8385","sourceWorkId":"23430","spoiler":false},{"segments":[{"spoiler":false,"text":"学生会会計で水泳部員。 大手製薬会社の社長の娘。"},{"spoiler":false,"text":"父が未緒の両親と知り合いで、未緒のことを知ってはいたが、会ったことはなかった。"},{"spoiler":false,"text":"入学してから未緒が学生会長だと聞き、興味半分で学生会に入ると、"},{"spoiler":false,"text":"今ではすっかり懐いて恋愛感情にも似た憧れを抱くようになった。"},{"spoiler":false,"text":"スポーツはあまり得意ではないのだが、せめて泳げるようになりたくて水泳部に入部した。"},{"spoiler":false,"text":"「あうぅ…… 未緒先輩ありがとうございます。 あ、でも、今はダメです！　今はテニスに集中してくださいね」"}],"source":"bangumi","sourceCharacterId":"42493"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2bb4e20e1061bfd93f78adf73d2f3d8dee745b47e89e5a6a2918a76afcac3550.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c7590c23cb0b06265fa3c246f739f4cbdc1272f4aa05d70a2185760a6d409eb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185097:42493:11646:1","source":"bangumi"}]},{"characterId":"char_c45157","characterName":"兎夜 栞","sourceIds":{"bangumi":[{"characterId":"42494","match":"exact-normalized-name-in-linked-work","subjectId":"185097"}],"egsCharacterIds":["8386"],"vndbCharacterId":"c45157"},"originalCharacterName":"兎夜 栞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mio's maid coming from the Toya family, who have served the Yunoki family for a longer time. She has been with Mio ever since she was young, and the two are like sisters; sometimes they even get mistaken as a pair of siblings. She is willing to do anything for her dear Mio. Despite her relaxed nature she is proficient in all kinds of household chores."}],"source":"vndb","sourceCharacterId":"c45157"},{"segments":[{"spoiler":false,"text":"母も柚ノ木家のお手伝いさんをしていて、幼い頃から母に連れられて来たりしていた。"},{"spoiler":false,"text":"父親は亡くなっている。"},{"spoiler":false,"text":"母は未緒の両親のお供として一緒に海外を渡り歩いている。"},{"spoiler":false,"text":"一応雇い主と雇われ人の関係なのだが、母子ともどもまるで家族のような雰囲気でもある。"},{"spoiler":false,"text":"未緒とはなかば姉妹のような関係で育った。"},{"spoiler":false,"text":"実際、周りからはよく姉妹と間違われる。"},{"spoiler":false,"text":"一見おっとりした雰囲気なのだが、家事全般をはじめ何事も非常に有能で、仕事はテキパキとこなす。"},{"spoiler":false,"text":"しかし、どこか抜けた所があり、よく未緒と一緒にほんわかしている。"},{"spoiler":false,"text":"柚ノ木家には強い感謝の気持ちを抱いている。"},{"spoiler":false,"text":"学生時代はテニス部に所属していて、全国大会の出場経験がある。"}],"source":"egs","sourceCharacterId":"8386","sourceWorkId":"23430","spoiler":false},{"segments":[{"spoiler":false,"text":"柚ノ木家に住み込みで働いているお手伝いさん。"},{"spoiler":false,"text":"母も柚ノ木家のお手伝いさんをしていて、幼い頃からよく連れて来られていた。"},{"spoiler":false,"text":"一応雇い主と雇われ人の関係だが、母子共々まるで家族のような雰囲気。"},{"spoiler":false,"text":"未緒とは姉妹のような関係で育ち、実際に周りからはよく姉妹と間違われる。"},{"spoiler":false,"text":"おっとりしているが、家事全般をはじめ何事においても非常に有能。"},{"spoiler":false,"text":"仕事はテキパキとこなすが、どこかヌケたところもあり、よく未緒と一緒にほんわかしている。"},{"spoiler":false,"text":"「みなさんを迎える準備は終わっていますので、お嬢様は何も心配しなくていいんですよ」"}],"source":"bangumi","sourceCharacterId":"42494"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/463795d4c4996fcc63d3c539dd0864a7af1e52f7a29f4129f836519d0771eebe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48c39d172a51127813ba1c14714a8803a29d0d75f4177051abc0fa85778ff41f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185097:42494:15637:1","source":"bangumi"}]},{"characterId":"char_vndb_c155926","characterName":"出村 正","sourceIds":{"vndbCharacterId":"c155926"},"originalCharacterName":"出村 正","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Quiet and unassuming, he doesn't stand out much at school."},{"spoiler":false,"text":"He rarely comes up in conversation, for better or worse. His parents are directors of a wholesale company, and he grew up in a fairly wealthy family. At one point, he aspired to become a doctor, but gave up when he realized that his connections alone weren't enough."},{"spoiler":false,"text":"He later obtained a teaching license and found a job."},{"spoiler":false,"text":"He is divorced and currently single. He secretly manufactures illegal drugs in a location unknown to anyone else."},{"spoiler":false,"text":"He does it not for financial gain, but because he enjoys watching people fall into decadence through drugs."},{"spoiler":false,"text":"He has an unusual possessiveness, using things he likes until they break."},{"spoiler":false,"text":"He exploits students' weaknesses, threatening them to engage in questionable activities."},{"spoiler":false,"text":"He enjoys watching girls orgasm and uses tools or drugs to make them orgasm until they are completely exhausted."},{"spoiler":false,"text":"He also enjoys seeing them blush with embarrassment and engages in verbal abuse and shame play."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c155926"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d0ab5cd2dee65f8e61666fc6e4a06bc498b35b7e32a46366f1defbb741bb73a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f83912b239809c7d47c6c7864b5698730fd29bb547d1cc6a75ca22deb1ec2904.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c155927","characterName":"海老沼 康平","sourceIds":{"vndbCharacterId":"c155927"},"originalCharacterName":"海老沼 康平","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He moves around from place to place within his circle of friends without having a fixed address."},{"spoiler":false,"text":"He meets Takeshii while gambling."},{"spoiler":false,"text":"Lately, he has been staying at Takeshi's place."},{"spoiler":false,"text":"Without belonging to any particular company or group, he changes the people he hangs out with from time to time, earning money through both legal and illegal means to make a living."},{"spoiler":false,"text":"He is physically strong due to having practiced karate and judo as a child."},{"spoiler":false,"text":"Although he was raised without any particular hardships, he began associating with bad seniors during his student days and gradually developed poor behavior."},{"spoiler":false,"text":"Ignoring his parents' words and acting as he pleased, he ended up causing an incident."},{"spoiler":false,"text":"Even afterward, showing no signs of repentance, he was eventually disowned by his parents."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c155927"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c03d6f2d9d6c196bb02e9edc6d653c8d5e3f50a10eb5c9e3c914dda24b4f63e8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64384c61501e8be63a6dd1083a5ed26a50e4f34769e26b7e9dee6d873c688761.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c155928","characterName":"漆畑 剛史","sourceIds":{"vndbCharacterId":"c155928"},"originalCharacterName":"漆畑 剛史","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He has been swimming since he was a student and was once a candidate for the national team at an international competition."},{"spoiler":false,"text":"After graduating from a prestigious university, he joined a corporate team but struggled to improve and eventually quit."},{"spoiler":false,"text":"Since then, he has not sought reemployment and continues to live as a freeter, getting by day to day."},{"spoiler":false,"text":"He is addicted to gambling and spends all the money he earns from part-time jobs on gambling."},{"spoiler":false,"text":"Deep down, he feels envy toward people who are passionate about sports."},{"spoiler":false,"text":"He is not very sociable, and while he managed to get by in college, he was unable to fit in with his peers after joining the corporate team, which led to his failure."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c155928"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f72858579b33a65465a020b79aaab360b1adc5b08cfea9a19eae7b64cf146517.webp","fallbackUrl":"https://wiki-assets.bi