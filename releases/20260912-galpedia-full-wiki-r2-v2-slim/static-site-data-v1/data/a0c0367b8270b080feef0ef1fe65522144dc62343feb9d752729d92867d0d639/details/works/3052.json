ct-normalized-name-in-linked-work","subjectId":"230756"}],"egsCharacterIds":["13293"],"vndbCharacterId":"c59962"},"originalCharacterName":"妹尾 杏","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"詠呼の友達。"},{"spoiler":false,"text":"主人公へのイジメの首謀者。"},{"spoiler":false,"text":"心に空虚なものを抱えていて、"},{"spoiler":false,"text":"それを埋めるために浪費に走る。"},{"spoiler":false,"text":"お金の為に売春に手を出すこともあり、"},{"spoiler":false,"text":"その反動で男性への不信感がつのるばかり。"}],"source":"egs","sourceCharacterId":"13293","sourceWorkId":"3052","spoiler":false},{"segments":[{"spoiler":false,"text":"詠呼と仲の良い友人。"},{"spoiler":false,"text":"彼女達が中心となって主人公をイジメている。杏は、可愛いくて女子には優しいが、男に対しては冷たい。周囲に隠れて売春をやっており、それが男性不信に拍車をかけている。"}],"source":"bangumi","sourceCharacterId":"76855"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f55bfb39d1a5e914f53ac89f5cf0c58b621ac080246a164bdbb01994eaa14de.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b67a49831a910619bf6b1b0d908706dd6ed5fb9b198a2c2e88b743c4b3ff9d38.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Rita","creatorId":"vndb:s102","sourcePersonId":"vndb:s102","canonicalEntityId":"vndb:s102","name":"平井 理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230756:76855:5742:1","source":"bangumi"}]},{"characterId":"char_c59963","characterName":"空 夏生","sourceIds":{"bangumi":[{"characterId":"76850","match":"exact-normalized-name-in-linked-work","subjectId":"230756"}],"egsCharacterIds":["13291"],"vndbCharacterId":"c59963"},"originalCharacterName":"空 夏生","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":