親のしつけが厳しく、超が付くお嬢様学園に通っているが、本当は一樹と同じ学園に通いたいと思っている。"},{"spoiler":false,"text":"成績優秀、スポーツ万能で、趣味は料理とネットゲーム。"},{"spoiler":false,"text":"「カズちゃんは、黙って私の言うことを聞いていればいいのよ～。ふふっ♪」"}],"source":"bangumi","sourceCharacterId":"22702"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/751d37c374b29943c1543665de2fa59f4d822909345a493073fa604ac02928bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a26ff83deaea445bbe174d429b3540338de2ee72e7242c229b973d88fae58598.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:76797:22702:4490:1","source":"bangumi"}]},{"characterId":"char_c20996","characterName":"桜井 まゆの","sourceIds":{"bangumi":[{"characterId":"22703","match":"exact-normalized-name-in-linked-work","subjectId":"76797"}],"egsCharacterIds":["11089"],"vndbCharacterId":"c20996"},"originalCharacterName":"桜井 まゆの","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"71"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園の2年生。同じクラスメイト。"},{"spoiler":false,"text":"見た目は幼く、天然ドジっこな面あり。"},{"spoiler":false,"text":"一樹のことを「市村くん♪」と呼んで慕っている。"}],"source":"egs","sourceCharacterId":"11089","sourceWorkId":"14494","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の2年生。主人公とはクラスメイト。"},{"spoiler":false,"text":"見た目は幼く、なおかつ天然な面もあり、みんなから可愛がられるような存在。"},{"spoiler":false,"text":"主人公のことを 「市村くん♪」 と呼んで慕っている。"},{"spoiler":false,"text":"食いしん坊でいつもお腹を空かせているらしい。"},{"spoiler":false,"text":"事情があって両親とは離れて暮らしている。"},{"spoiler":false,"text":"「天ぷら、牛丼、ハンバーグ♪　あっ、それと焼きそばパンも絶対必要だよ！」"}],"source":"bangumi","sourceCharacterId":"22703"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/0863b0fadb990c2aba01865c04d12c3f56af6a96bf83ec10ea08206683e4560b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd171058f60b2612751ab76fef9303dff3c2ba9354a1b2f65fbeb4c0834fa790.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"亜城めぐ","creatorId":"vndb:s454","sourcePersonId":"vndb:s454","canonicalEntityId":"vndb:s454","name":"亜城 めぐ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:76797:22703:4833:1","source":"bangumi"}]},{"characterId":"char_c20997","characterName":"柏原 魅樹","sourceIds":{"bangumi":[{"characterId":"22704","match":"exact-normalized-name-in-linked-work","subjectId":"76797"}],"egsCharacterIds":["11090"],"vndbCharacterId":"c20997"},"originalCharacterName":"柏原 魅樹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"同じクラスメイトで席が隣。高飛車でテンションも高めな性格。"},{"spoiler":false,"text":"のんびり屋の一樹に対しては常に手厳しい。"}],"source":"egs","sourceCharacterId":"11090","sourceWorkId":"14494","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公とクラスメイトで席が隣。"},{"spoiler":false,"text":"高飛車でテンションも高めな、尖った性格の女の子。"},{"spoiler":false,"text":"のんびり屋の一樹に対しては常に手厳しく、しかし彼の癒しオーラに包まれると時折本音も出る。"},{"spoiler":false,"text":"見事なプロポーションのせいか、学園男子の注目の的。何度も告白されているが、その度に断っている。"},{"spoiler":false,"text":"「こっち見るな！　あっちいけっ！」"}],"source":"bangumi","sourceCharacterId":"22704"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f97e94ab9194f4975bf35b603670b4765ef7fb5dc4c6bc31fff4b8b6f5fa0c28.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb2c89f5561cf4ab29c7cedca35746a5148514d02300519a02cb785cf23d2c5a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高口幸子","creatorId":"vndb:s261","sourcePersonId":"vndb:s261","canonicalEntityId":"vndb:s261","name":"高口 幸子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:76797:22704:4838:1","source":"bangumi"}]},{"characterId":"char_c20998","characterName":"市村 咲音","sourceIds":{"bangumi":[{"characterId":"22705","match":"exact-normalized-name-in-linked-work","subjectId":"76797"}],"egsCharacterIds":["11091"],"vndbCharacterId":"c20998"},"originalCharacterName":"市村 咲音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"義理妹。訳あって数年間、離れて暮らしていたが突然の帰還。"},{"spoiler":false,"text":"一樹にいつもひっついてまわる。炊事洗濯が壊滅的に苦手。"}],"source":"egs","sourceCharacterId":"11091","sourceWorkId":"14494","spoiler":false},{"segments":[{"spoiler":false,"