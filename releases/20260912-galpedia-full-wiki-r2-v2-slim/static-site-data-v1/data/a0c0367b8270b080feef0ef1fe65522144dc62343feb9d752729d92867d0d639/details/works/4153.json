{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"4153","model":{"presentationWorkId":"vndb:v6048","staff":{"artwork":[{"creditedName":"Moo℃団(なべち、てってち、ぎんぱち、渡辺義弘)","creatorId":"vndb:s1891","sourcePersonId":"egs:creator:98","canonicalEntityId":"vndb:s1891","name":"Moo℃団(なべち、てってち、ぎんぱち、渡辺義弘)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:6351","source":"egs"}],"scenario":[{"creditedName":"シナリオ制作チームさるさる","creatorId":"egs:creator:5656","sourcePersonId":"egs:creator:5656","canonicalEntityId":"egs:creator:5656","name":"シナリオ制作チームさるさる","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:272857","source":"egs"},{"creditedName":"紺野かほる","creatorId":"vndb:s12719","sourcePersonId":"egs:creator:2154","canonicalEntityId":"vndb:s12719","name":"紺野かほる","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:6352","source":"egs"}],"music":[{"creditedName":"m.c.TOM","creatorId":"vndb:s6343","sourcePersonId":"egs:creator:2622","canonicalEntityId":"vndb:s6343","name":"m.c.TOM","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:7904","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c75678","characterName":"芝沢 乙恵","sourceIds":{"bangumi":[{"characterId":"149036","match":"exact-normalized-name-in-linked-work","subjectId":"230360"}],"egsCharacterIds":["26949"],"vndbCharacterId":"c75678"},"originalCharacterName":"芝沢 乙恵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"衣頼の姉で、薫の親友。"},{"spoiler":false,"text":"いつも周囲にどう見られているかをチェックし、「良い娘」であろうとする優等生。"},{"spoiler":false,"text":"明るく優しい性格。クラスでも頼りにされ委員長を務める。"},{"spoiler":false,"text":"反面、優等生的な彼女に嫉妬する生徒も少なくなく、陰口を叩かれ、いたく傷ついている。"},{"spoiler":false,"text":"最近、そうした優等生を演じ続けるのに疲れているようだ。"},{"spoiler":false,"text":"彼女の凌辱タイプは「ぶっかけ型」。"},{"spoiler":false,"text":"臭く粘り強い精液をぶっかけられた彼女は、嫌がりながら泣き叫び逃げようとするが……。"}],"source":"egs","sourceCharacterId":"26949","sourceWorkId":"4153","spoiler":false},{"segments":[{"spoiler":false,"text":"明るい性格で、いわゆる優等生タイプ。"},{"spoiler":false,"text":"衣頼の姉で、薫の親友。"},{"spoiler":false,"text":"身体的特徴は美乳、3人の中では１番大きい。"},{"spoiler":false,"text":"特に抜きん出た部分は無いのだが、誰もに好かれる性格とその"},{"spoiler":false,"text":"癒し系の容姿からクラスの委員長をやるくらいのカリスマはある。"},{"spoiler":false,"text":"自分が外からどう見られているのかを常に意識していて、"},{"spoiler":false,"text":"自分が『良い娘』であろうと努力している。"},{"spoiler":false,"text":"だが、それが逆に嫉妬や妬みを買ってしまっている事に"},{"spoiler":false,"text":"常に傷ついている。"}],"source":"bangumi","sourceCharacterId":"149036"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f44e28c019a66bbb1e59101d7b43a305a9c9c547e4ed49a6bcf1e7f0bc6d11eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc03ca657fe4eb32ab7edcf3e771e9a4c6109662446a21e8913cb0cad265f691.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤雅美","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230360:149036:13773:1","source":"bangumi"}]},{"characterId":"char_c75679","characterName":"芝沢 衣頼","sourceIds":{"bangumi":[{"characterId":"149037","match":"exact-normalized-name-in-linked-work","subjectId":"230360"}],"egsCharacterIds":["26950"],"vndbCharacterId":"c75679"},"originalCharacterName":"芝沢 衣頼","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"乙恵の妹。"},{"spoiler":false,"text":"幼い頃から入退院を繰り返してきた病弱でおとなしい女の子。"},{"spoiler":false,"text":"そうしたことから姉や周囲から大事にされ、それに甘えるしかない自分に歯がゆく感じているものの、どうすることも出来ず、自分を棄てて誰かに恭順するように生きてきた。"},{"spoiler":false,"text":"彼女の凌辱タイプは「飲精型」。"},{"spoiler":false,"text":"粘り強くも強烈な異臭を放つ精液を飲まされる彼女は、嫌悪感を抑えて言い成りになっていくが……。"}],"source":"egs","sourceCharacterId":"26950","sourceWorkId":"4153","spoiler":false},{"segments":[{"spoiler":false,"text":"大人しくて病弱な少女。"},{"spoiler":false,"text":"乙恵の妹で、薫とはあまりなじみは無い。"},{"spoiler":false,"text":"身体的特徴は成長途中の貧乳、乳腺の発達が遅く陥没乳首。"},{"spoiler":false,"text":"幼い頃から体が弱く、入退院を繰り返している。"},{"spoiler":false,"text":"姉に大事に守られている事を自分で認識しているが、"},{"spoiler":false,"text":"それに甘えるしかない自分がとても嫌い。"},{"spoiler":false,"text":"それゆえか何事にも自ら意思を棄てて誰かの命令に"},{"spoiler":false,"text":"恭順する姿勢が目立つ。"},{"spoiler":false,"text":"だが、内心ではそんな自分を激しく嫌悪していて、"},{"spoiler":false,"text":"精神的に自分を追い詰めて行く事になる。"}],"source":"bangumi","sourceCharacterId":"149037"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/590f8fbc06c0f1b53cd575e7b6249ae0396c25c0e3d55eec54da8066661521c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f84f9f5bdef15aab41bef13ca00868abce3bb9f3905e79c74be653595c7c0462.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230360:149037:6409:1","source":"bangumi"}]},{"characterId":"char_c75680","characterName":"長浜 薫","sourceIds":{"bangumi":[{"characterId":"149038","match":"exact-normalized-name-in-linked-work","subjectId":"230360"}],"egsCharacterIds":["26951"],"vndbCharacterId":"c75680"},"originalCharacterName":"長浜 薫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"乙恵の親友。"},{"spoiler":false,"text":"勝気でプライドの高い女の子。日本女子ソフトボールの期待の星で学園のヒーロー。"},{"spoiler":false,"text":"そのプライドの高さから、他人から距離をとられがちで、自分でも非常に気にしている。"},{"spoiler":false,"text":"優等生で学園でも人気者の乙恵に嫉妬にも似た感情を抱いているようだ。"},{"spoiler":false,"text":"彼女の凌辱タイプは「アナル型」。"},{"spoiler":false,"text":"プライドの高い彼女が通常ではありえない肛凌辱にプライドを傷つけられながらも、気丈に耐え、怒りの感情を爆発させるが……。"}],"source":"egs","sourceCharacterId":"26951","sourceWorkId":"4153","spoiler":false},{"segments":[{"spoiler":false,"text":"少し勝気な娘。"},{"spoiler":false,"text":"乙恵の親友で、衣頼とはあまりなじみは無い。"},{"spoiler":false,"text":"身体的特徴はひきしまったプロポーション。"},{"spoiler":false,"text":"日本女子ソフトを背負って立つといわれる学園のヒーロー。"},{"spoiler":false,"text":"高いプライドを糧に幾つもの勝負を勝ち抜いてきた。"},{"spoiler":false,"text":"だがそのプライドが他人との距離を離してしまっている事に、"},{"spoiler":false,"text":"自分でも気が付いている。"},{"spoiler":false,"text":"親友として扱ってくれる「乙恵」には限りない感謝を向けているが、"},{"spoiler":false,"text":"反面自分には無い人気者な彼女に対する激しい嫉妬とも戦っている。"},{"spoiler":false,"text":"乙恵の憧れに近い感情が取らせる数々の言動が、"},{"spoiler":false,"text":"本人には同情に見えてしまっている事も多い。"},{"spoiler":false,"text":"乙恵が最近振ったクラスの男子に恋をしていたが、"},{"spoiler":false,"text":"自分が振られる事が怖くて告白できずにいる。"}],"source":"bangumi","sourceCharacterId":"149038"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0bd49f67aadec8f5c1b5122f6b59ef6aa90c90893860ea9f0621a5a4f8434e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/1483e0b73acdb29d882ea346a16cb3bedfcedd1bef6c481bef4e9638ceb3ac9d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹間千ノ美","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230360:149038:19333