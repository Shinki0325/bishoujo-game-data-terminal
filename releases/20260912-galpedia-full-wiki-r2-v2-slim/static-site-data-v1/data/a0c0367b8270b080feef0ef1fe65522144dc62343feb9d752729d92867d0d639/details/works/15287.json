metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"130"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"T"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"11"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"72"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Actual Breast Priestess. Grandmother of Ukyou. Mother of Renka and Momoka."},{"spoiler":false,"text":"In Chichi Miko!!:"},{"spoiler":false,"text":"She is still young, but she wants to give the job to a younger girl."},{"spoiler":false,"text":"Chichi Miko!! Plus 1:"},{"spoiler":false,"text":"She married Ukyou and had a daughter with him. The three of them live together in the shrine."}],"source":"vndb","sourceCharacterId":"c6692"},{"segments":[{"spoiler":false,"text":"乳泉神社の神主をつとめる、主人公の祖母。"},{"spoiler":false,"text":"霊能者と言われていて、神秘的なイメージを持つが、基本的に穏やかな気性だけれど、時々、主人公や娘達に悪戯をしかけたりとお茶目な面もある。"},{"spoiler":false,"text":"どっしりした超乳の持ち主で、チクビは敏感な陥没チクビ。"},{"spoiler":false,"text":"母乳体質で、飲んだ者に特殊な効果が表れる母乳が出る。"},{"spoiler":false,"text":"乳巫女候補への乳巫女特訓時には、祖母から依頼を受けたとして、乳天狗（!?）に変装して指導に当たるが、髪とボディライン・態度などで、みんなにはバレバレ。"}],"source":"egs","sourceCharacterId":"8786","sourceWorkId":"15287","spoiler":false},{"segments":[{"spoiler":false,"text":"右京と結ばれてからも現役で乳泉神社の神主をつとめる、主人公の祖母。"},{"spoiler":false,"text":"陥没乳首で、母乳体質。"},{"spoiler":false,"text":"娘の鏡華を産んで以来、ますます若々しく美しくなって、母乳の出も良くなっているので、よく右京に搾って貰っている。"}],"source":"egs","sourceCharacterId":"8786","sourceWorkId":"16893","spoiler":false},{"segments":[{"spoiler":false,"text":"乳泉神社で現・乳巫女を務める右京の祖母。"},{"spoiler":false,"text":"年齢に不釣り合いな美貌と、超乳を持つ美女。"},{"spoiler":false,"text":"普段は神社の巫女らしく年相応に落ち着いていて、穏やかでしとやかな印象を受けるが、こと乳巫女関連になると人が変わる。"},{"spoiler":false,"text":"毎日おっぱいを搾って乳泉神社 特製のお守りを作っていたが、最近聖乳の出が悪くなってきたのを気にしているもよう。"},{"spoiler":false,"text":"「よいですか、右京？　これから貴方は、皆と共に乳巫女修行に勤めるのですよ」"}],"source":"bangumi