aving poor eyesight she wears contact lenses."}],"source":"vndb","sourceCharacterId":"c3236"},{"segments":[{"spoiler":false,"text":"千歌音のマネージャー。兄の経営するアイドル事務所でマネージャーをしている。"},{"spoiler":false,"text":"おっちょこちょいでかなりのドジっ子。過去にアイドルを目指していたが挫折。"},{"spoiler":false,"text":"現在は千歌音をトップアイドルとして成長させることを生きがいとしている。"},{"spoiler":false,"text":"千歌音を街で見かけスカウトしたのも彼女。"},{"spoiler":false,"text":"甘い物に目がなく趣味はケーキバイキング。"},{"spoiler":false,"text":"視力は悪くコンタクト。すごく音痴で方向音痴の2大音痴を有する。"}],"source":"egs","sourceCharacterId":"26824","sourceWorkId":"12124","spoiler":false},{"segments":[{"spoiler":false,"text":"千歌音のマネージャー。"},{"spoiler":false,"text":"兄の経営するアイドル事務所でマネージャーをしている。"},{"spoiler":false,"text":"おっちょこちょいでかなりのドジっ子。過去にアイドルを目指していたが挫折。"},{"spoiler":false,"text":"現在は千歌音をトップアイドルとして成長させることを生きがいとしている。"},{"spoiler":false,"text":"千歌音を街で見かけスカウトしたのも彼女。"},{"spoiler":false,"text":"甘い物に目がなく趣味はケーキバイキング。"},{"spoiler":false,"text":"視力は悪くコンタクト。すごく音痴で方向音痴の2大音痴を有する。"},{"spoiler":false,"text":"「千歌音さ……きゃっ！あ、ああっ書類が！と、飛んでいかないでー!!」"}],"source":"bangumi","sourceCharacterId":"50513"}],"profileFacts":[{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"26824","sourceWorkId":"12124","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"26824","sourceWorkId":"12124","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"26824","sourceWorkId":"12124","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"26824","sourceWorkId":"12124","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d761a583afabaad3ff97fcb60c29d27442216b8a2d9e6a1c75f935bff7b7c63.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81c854067480b44b5966b5e1a681d72c07f0530d9c