6798","source":"vndb"},{"creditedName":"johnny.k","creatorId":"vndb:s41117","sourcePersonId":"vndb:s41117","canonicalEntityId":"vndb:s41117","name":"johnny.k","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:116801","source":"vndb"}],"other":[{"creditedName":"今井 麻美","creatorId":"vndb:s240","sourcePersonId":"vndb:s240","canonicalEntityId":"vndb:s240","name":"今井 麻美","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:116789","source":"vndb"},{"creditedName":"原 由実","creatorId":"vndb:s3261","sourcePersonId":"vndb:s3261","canonicalEntityId":"vndb:s3261","name":"原 由実","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:116790","source":"vndb"},{"creditedName":"早瀬あきら","creatorId":"vndb:s8835","sourcePersonId":"vndb:s8835","canonicalEntityId":"vndb:s8835","name":"早瀬あきら","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:116793","source":"vndb"},{"creditedName":"sorano","creatorId":"vndb:s41116","sourcePersonId":"vndb:s41116","canonicalEntityId":"vndb:s41116","name":"sorano","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:116799","source":"vndb"},{"creditedName":"松本 流花","creatorId":"vndb:s41115","sourcePersonId":"vndb:s41115","canonicalEntityId":"vndb:s41115","name":"宮藤 優矢","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:116800","source":"vndb"},{"creditedName":"みやざー","creatorId":"vndb:s44912","sourcePersonId":"vndb:s44912","canonicalEntityId":"vndb:s44912","name":"みやざー","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:116802","source":"vndb"}]},"cast":[{"characterId":"char_c26020","characterName":"大幸 あすか","sourceIds":{"bangumi":[{"characterId":"120425","match":"exact-normalized-name-in-linked-work","subjectId":"122533"}],"egsCharacterIds":["8312"],"vndbCharacterId":"c26020"},"originalCharacterName":"大幸 あすか","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"19"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"402"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"63"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The honest, simple, relaxed, fluffy and somewhat sluggish older sister. She's not dumb, but her memory could use some work. Nicknames during high school: \"Jellyfish Club Leader\", \"Lazy Sis.\" In general, she's pretty much hopeless, but she has a knack for being loved by others. When it really counts, her ability to get things done and decisiveness shines through."},{"spoiler":false,"text":"Doesn't have memory of the first 8 years of her life, but she's not too worried about that. She heard from her parents that she was being mischievous at one time when she was a kid, climbed up a tree and fell off. But she doesn't remember any of it."},{"spoiler":false,"text":"Up until her high school career inquiry, she hasn't given much thought to her future, but from the words \"I'll be a nurse!\" written in the final page of her favorite picture book in elementary, she decided to aspire to be one. She currently doesn't have a clear reason on why she chose that path, but together with the help from her little sister Nao, both enroll in the Imperial Capital Nursing Technical School, getting one step closer to becoming a nurse."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c26020"},{"segments":[{"spoiler":false,"text":"本作の主人公。素直で天真爛漫、ゆるふわポンコツ姉。頭は悪くないが、物覚えが若干よくない。高校時代のあだ名は「クラゲ部部長」「大幸姉妹のしっかりしてない方」。総じてダメキャラだが、人から愛される才能があり、ここぞというときの決断力・実行力はある。"},{"spoiler":false,"text":"八歳以前の記憶がないが、本人はあまり気にしていない。両親からは子供の頃、やんちゃして木に登り落ちた時からと聞いているが本人は当然覚えていない。"},{"spoiler":false,"text":"高校の進路希望調査の時期まで、将来について考えたことがなく、幼い頃の持ち物だった絵本の最後のページに書かれていた「かんごしになる！」という言葉により、看護師を志すことに。なぜ看護師になるのか、という明確な理由は今のところないものの、妹なおのバックアップに助けられ、看護師への第一歩、帝都看護専門学校に入学する。"}],"source":"egs","sourceCharacterId":"8312","sourceWorkId":"21471","spoiler":false},{"segments":[{"spoiler":false,"text":"八歳以前の記憶がないが、本人はあまり気にしていない。両親からは子供の頃、やんちゃして木に登り落ちた時からと聞いているが本人は当然覚えていない。"},{"spoiler":false,"text":"高校の進路希望調査の時期まで、将来について考えたことがなく、幼い頃の持ち物だった絵本の最後のページに書かれていた「かんごしになる！」という言葉により、看護師を志すことに。なぜ看護師になるのか、という明確な理由は今のところないものの、妹なおのバックアップに助けられ、看護師への第一歩、帝都看護専門学校に入学する。"}],"source":"bangumi","sourceCharacterId":"120425"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3e2ed282d5b1cefcd39367d96acef2970493042ef1a867a93c236ffb3e40586.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a794ec628fe678a8c87d9924fcfc4995a060f992cdb0127afa971f099b027732.webp","width":114,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅倉杏美","creatorId":"vndb:s1089","sourcePersonId":"vndb:s1089","canonicalEntityId":"vndb:s1089","name":"浅倉 杏美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122533:120425:5827:1","source":"bangumi"}]},{"characterId":"char_c26021","characterName":"大幸 なお","sourceIds":{"bangumi":[{"characterId":"120428","match":"exact-normalized-name-in-linked-work","subjectId":"122533"}],"egsCharacterIds":["8313"],"vndbCharacterId":"c26021"},"originalCharacterName":"大幸 なお","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"401"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The kind, flawless younger sister who loves her older sister Asuka a lot, devoting everything of herself to support her. The self-proclaimed \"Responsible Imouto\", \"Onee-chan's Special Medicine.\" While they're born one year apart and in the same grade level, Nao has cared about Asuka (who's not good at studying) to the point where she helped her sis get accepted into the Imperial Capital Nursing Technical School, even enrolling herself to the very same school just to be with Asuka."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c26021"},{"segments":[{"spoiler":false,"text":"姉激ラブ、姉の支えになることが自分のすべて、という完全無欠の良妹。自称「できた妹」「お姉ちゃんの特効薬」。姉と年子で同学年といういわゆる「スーパー年子」で、勉強の出来ない姉を帝都看護入学までサポートし、自身も同校に入学してしまう程、姉想いである。"}],"source":"egs","sourceCharacterId":"8313","sourceWorkId":"21471","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5df7f78ad07895b1229ecf83a50e63785f7f2f83257cf01c87c84603f48b13fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b74a5b7e84058d9f9ed41944477474799a3ecb713535aeeea841cb66f970716d.webp","width":115,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加隈亜衣","creatorId":"vndb:s603","sourcePersonId":"vndb:s603","canonicalEntityId":"vndb:s603","name":"加隈 亜衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122533:120428:10806:1","source":"bangumi"}]},{"characterId":"char_c26022","characterName":"大原 かえで","sourceIds":{"bangumi":[{"characterId":"120427","match":"exact-normalized-name-in-linked-work","subjectId":"122533"}],"egsCharacterIds":["8316"],"vndbCharacterId":"c26022"},"originalCharacterName":"大原 かえで","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"27"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"303"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Former registered nurse and Asuka's nurse instructor. Born in the \"Oohara\" family known for their exceptional influence in medicine. Chose to go to the Imperial Capital Nursing Technical School to work as a teacher after serving as an RN. She's the \"White Robe Angel\", according to Asuka."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c26022"},{"segments":[{"spoiler":false,"text":"あすかの入学する帝都看護の教員で元看護師。看護業界の名門「大原」の出で、自身も看護師として活躍後、教員の道を選び帝都看護へ。あすか曰く「白衣の天使」"}],"source":"egs","sourceCharacterId":"8316","sourceWorkId":"21471","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/253e9c47b695359bb04351c9efc025a517e0d03f4781e62d1f63264afd8ed65d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef1b2456ed21c037610890461b7911387fbd27ed9cc5f7a804eb7ee814dfa7e7.webp","width":71,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今井麻美","creatorId":"vndb:s240","sourcePersonId":"vndb:s240","canonicalEntityId":"vndb:s240","name":"今井 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122533:120427:4061:1","source":"bangumi"}]},{"characterId":"char_c43459","characterName":"天藤いつき","sourceIds":{"bangumi":[{"characterId":"120426","match":"exact-normalized-name-in-linked-work","subjectId":"122533"}],"egsCharacterIds":["8314"],"vndbCharacterId":"c43459"},"originalCharacterName":"天藤いつき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"111"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Asuka's classmate. Daughter of a distinguished family known for its traditional Japanese dance. She's a refined, charismatic, and stylish girl. Her personality is open-minded and mischievous (ecchi topics and sexual harassment are her specialties). Favorite phrase: \"I'm lying.\" Currently going out with Sakuya."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c43459"},{"segments":[{"spoiler":false,"text":"あすかの入学する帝都看護の同級生。日本舞踊の家元である名家の娘。洗練されたイマドキのカリスマお洒落ガール。性格も開放的で悪戯好き（下ネタ、セクハラが得意）。口癖は「嘘だよ」現・さくやの恋人。"}],"source":"egs","sourceCharacterId":"8314","sourceWorkId":"21471","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/546bda6807e8a94baffed4193f9ae1cc29febac2ff87719435b08534132a17cd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c12a81f9a363494ecb849be0264f83408411951e0b339d4b6ac3f3d588b2acb1.webp","width":93,"height":256,"source":"static-detail"},"actors":[{"creditedName":"原由実","creatorId":"vndb:s3261","sourcePersonId":"vndb:s3261","canonicalEntityId":"vndb:s3261","name":"原 由実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:122533:120426:5825:1","source":"bangumi"}]},{"characterId":"char_c43460","characterName":"武田さくや","sourceIds":{"bangumi":[{"characterId":"120429","match":"exact-normalized-name-in-linked-work","subjectId":"122533"}],"egsCharacterIds":["8315"],"vndbCharacterId":"c43460"},"originalCharacterName":"武田さくや","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"18"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1113"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Asuka's classmate. Comes from a wealthy family. Has a strong sense of responsibility, is prideful, stubborn and lives by the concept of the so-called noblesse oblige. For some reason, she acts cold towards Asuka when they first meet. Currently going out with Itsuki."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c43460"},{"segments":[{"spoiler":false,"text":"あすかの入学する帝都看護の同級生。資産家で富豪の親を持つお嬢様。責任感が強く気位が高く、頑固で意地っ張り。いわゆるノブレスオブリージュ。初対面の筈のあすかに何故か冷たくあたる。現・いつきの恋人。"}],"source":"egs","sourceCharacterId":"8315","sourceWorkId":"21471","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3d2aa5198860eaf6499f58c035fb530c7ba223f7f70ad092e5bc97ff90c934d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/5729023aa087d971ead47da6ac66be433dcbf265e36c179415841f07ac3491ee.webp","width":88,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田村ゆかり","creatorId":"vndb:s104","sourcePersonId":"vndb:s104","canonicalEntityId":"vndb:s104","name":"田村 ゆかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationI