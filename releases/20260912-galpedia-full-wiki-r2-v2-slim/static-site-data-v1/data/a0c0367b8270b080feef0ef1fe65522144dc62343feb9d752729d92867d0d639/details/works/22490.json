{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"22490","model":{"presentationWorkId":"vndb:v18175","staff":{"artwork":[{"creditedName":"麻倉桜(クリスチーネ高円寺、ざくれろ)","creatorId":"vndb:s2744","sourcePersonId":"egs:creator:2580","canonicalEntityId":"vndb:s2744","name":"麻倉桜(クリスチーネ高円寺、ざくれろ)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:156529","source":"egs"}],"scenario":[{"creditedName":"大熊陣八","creatorId":"vndb:s2773","sourcePersonId":"egs:creator:2417","canonicalEntityId":"vndb:s2773","name":"大熊陣八","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:156528","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c23220","characterName":"岩淵 遥","sourceIds":{"bangumi":[{"characterId":"46033","match":"exact-normalized-name-in-linked-work","subjectId":"145395"},{"characterId":"46033","match":"exact-normalized-name-in-linked-work","subjectId":"192704"}],"egsCharacterIds":["4972"],"vndbCharacterId":"c23220"},"originalCharacterName":"岩淵 遥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"年下の幼馴染みであった健とは、大学進学時にいったん離れるが、１年後に健が上京してきて再会。"},{"spoiler":false,"text":"その後、清らかな交際を続け、先日、晴れて入籍となった。"},{"spoiler":false,"text":"実家は古くから続く神社であり、今も巫女を務めている。"},{"spoiler":false,"text":"それでも家事には一切手を抜かず、夫に尽くすことを喜びと感じている。"},{"spoiler":false,"text":"料理が得意で、夫には毎日、結婚前からもお手製の弁当を用意している。"},{"spoiler":false,"text":"子供は授かりもの、という考えだが、授かる機会はもう少しあっても……と思ったりも。"}],"source":"egs","sourceCharacterId":"4972","sourceWorkId":"21095","spoiler":false},{"segments":[{"spoiler":false,"text":"健が子供の頃から憧れ続けた人。"},{"spoiler":false,"text":"穏やかな微笑を絶やさず、心配りが上手。"},{"spoiler":false,"text":"その一方で、自分の信念を貫く力強さも兼ね備えている。"},{"spoiler":false,"text":"学生時代から人気の的だったが、健が見事にその心を射止めた。"}],"source":"egs","sourceCharacterId":"4972","sourceWorkId":"22490","spoiler":false},{"segments":[{"spoiler":false,"text":"健が子供の頃から憧れ続けた人。"},{"spoiler":false,"text":"穏やかな微笑を絶やさず、心配りが上手。"},{"spoiler":false,"text":"その一方で、自分の信念を貫く力強さも兼ね備えている。"},{"spoiler":false,"text":"学生時代から人気の的だったが、健が見事にその心を射止めた。"},{"spoiler":false,"text":"「健さん、今夜のお食事、何かリクエストはありますか？」"}],"source":"bangumi","sourceCharacterId":"46033"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/0275be6bdcfce40cd499ce31315cd95c3bade9f98368cd23a149286b2804508f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e9571412bd3343dc297a1ba81941677fb5302d21d7836d61a1cea3de90a025c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤さくら","creatorId":"vndb:s947","sourcePersonId":"vndb:s947","canonicalEntityId":"vndb:s947","name":"花澤 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:145395:46033:17075:1","source":"bangumi"}]},{"characterId":"char_c23221","characterName":"滝沢 陽菜","sourceIds":{"bangumi":[{"characterId":"46035","match":"exact-normalized-name-in-linked-work","subjectId":"128901"},{"characterId":"46035","match":"exact-normalized-name-in-linked-work","subjectId":"145395"},{"characterId":"46035","match":"exact-normalized-name-in-linked-work","subjectId":"192704"}],"egsCharacterIds":["4973"],"vndbCharacterId":"c23221"},"originalCharacterName":"滝沢 陽菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"純人無垢で頑張りやの巫女だが、姉・遥ほど、霊力は高くない。"},{"spoiler":false,"text":"しかし、無邪気で可憐、純粋な彼女は、敬愛する姉に少しでも近づくようにと、辛い修行にも耐える芯の強い所も持つ。"},{"spoiler":false,"text":"主人公・健に淡い想いを寄せていたが、健の肉体を乗っ取った白鬼丸に付け込まれ……。"},{"spoiler":false,"text":"「あのね、おにいちゃん。陽菜ね、今朝、とっても不思議な夢を見たの。聞いてくれる？　えっとね、えっとね……。」"}],"source":"egs","sourceCharacterId":"4973","sourceWorkId":"9829","spoiler":false},{"segments":[{"spoiler":false,"text":"純人無垢で頑張りやの巫女だが、姉・遥ほど、霊力は高くない。"},{"spoiler":false,"text":"しかし、無邪気で可憐、純粋な彼女は、敬愛する姉に少しでも近づくようにと、辛い修行にも耐える芯の強い所も持つ。"},{"spoiler":false,"text":"主人公・健に淡い想いを寄せていたが、健の肉体を乗っ取った白鬼丸に付け込まれ……。"},{"spoiler":false,"text":"「あのね、おにいちゃん。陽菜ね、今朝、とっても不思議な夢を見たの。"},{"spoiler":false,"text":"聞いてくれる？　えっとね、えっとね……。」"}],"source":"egs","sourceCharacterId":"4973","sourceWorkId":"10179","spoiler":false},{"segments":[{"spoiler":false,"text":"遥の実妹であり、やはり幼馴染みであった健を兄として慕っていた。"},{"spoiler":false,"text":"今は、義理とはいえ、本当に兄妹の関係になったことを嬉しく思っている。"},{"spoiler":false,"text":"この春から、健の後輩として、やはり母校で教師を勤める。"},{"spoiler":false,"text":"その愛くるしい笑顔と、明るく前向きな性格が相まって、生徒たちの間ではマスコット的な人気がある。"},{"spoiler":false,"text":"また、姉を凌駕するその巨乳が、思春期の男子の視線を釘付けにしている。"},{"spoiler":false,"text":"本人は教師として、大人らしく振る舞っているつもりだが、まだまだ子供っぽさが抜けていない面も多い。"}],"source":"egs","sourceCharacterId":"4973","sourceWorkId":"21095","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のメインヒロイン。母校で教師をしており、主人公・健の職場の後輩。"},{"spoiler":false,"text":"ちょっと恥ずかしがり屋なところがある。"},{"spoiler":false,"text":"自分から押していくようなタイプではないので、剛蔵のような男性は苦手。"},{"spoiler":false,"text":"大人っぽく振る舞おうとしているが、中身はまだまだ子供っぽいところが多く残っている。"},{"spoiler":false,"text":"幼い頃から、健に想いを寄せていた。"},{"spoiler":false,"text":"その健が敬愛する姉と結婚し、祝福しているのだが、時折、モヤモヤした気持ちになることがある。"}],"source":"egs","sourceCharacterId":"4973","sourceWorkId":"21362","spoiler":false},{"segments":[{"spoiler":false,"text":"遥の妹。 健にとっては年下の幼なじみ。"},{"spoiler":false,"text":"幼い頃から健のことを 「お兄ちゃん」 と呼び、よく懐いていた。"},{"spoiler":false,"text":"ちょっと甘えん坊な面もあるが、意外と空気を読んでいる。"},{"spoiler":false,"text":"大人になった今も、その気性は変わっていない。"}],"source":"egs","sourceCharacterId":"4973","sourceWorkId":"22490","spoiler":false},{"segments":[{"spoiler":false,"text":"遥の妹。 健にとっては年下の幼なじみ。"},{"spoiler":false,"text":"幼い頃から健のことを 「お兄ちゃん」 と呼び、よく懐いていた。"},{"spoiler":false,"text":"ちょっと甘えん坊な面もあるが、意外と空気を読んでいる。"},{"spoiler":false,"text":"大人になった今も、その気性は変わっていない。"},{"spoiler":false,"text":"「おにい……じゃない、岩淵先生、おはようございます！」"}],"source":"bangumi","sourceCharacterId":"46035"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0f541457945df6bd894f8968dfd5f30d67c2ee0bafab3535fb320572c70abea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e92d3356cbd00c5eb518695164b4dcf48832c94bc1503f27dba340d3afe288ac.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水野七海","creatorId":"vndb:s2524","sourcePersonId":"vndb:s2524","canonicalEntityId":"vndb:s2524","name":"星野七海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:145395:46035:17078:1","source":"bangumi"}]},{"characterId":"char_c68161","characterName":"岩淵 健","sourceIds":{"bangumi":[{"characterId":"46037","match":"exact-normalized-name-in-linked-work","subjectId":"145395"},{"characterId":"46037","match":"exact-normalized-name-in-linked-work","subjectId":"192704"}],"egsCharacterIds":["4975"],"vndbCharacterId":"c68161"},"originalCharacterName":"岩淵 健","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幼い頃から遥に淡い憧れを抱いており、思春期を経て、それは恋心と変わった。"},{"spoiler":false,"text":"遥を追って進学のために上京し、告白。"},{"spoiler":false,"text":"晴れて恋人同士となり、長い春を経た後、先日、ついに結婚となった。"},{"spoiler":false,"text":"現在は母校で教師をしており、同僚や生徒たちからの信任も厚い。"},{"spoiler":false,"text":"家では良き夫として、互いに思いやり合う夫婦関係を築いている。"},{"spoiler":false,"text":"父である剛蔵を反面教師としたのか、物腰は柔らかで、性格も温厚である。"},{"spoiler":false,"text":"反面、いまいち押しが弱く、優柔不断な面がある。"}],"source":"egs","sourceCharacterId":"4975","sourceWorkId":"21095","spoiler":false},{"segments":[{"spoiler":false,"text":"母校で教職に就く若手教師。"},{"s