{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"2646","model":{"presentationWorkId":"vndb:v148","staff":{"artwork":[{"creditedName":"山根正宏(せんどりくん、sendori)","creatorId":"vndb:s2562","sourcePersonId":"egs:creator:59","canonicalEntityId":"vndb:s2562","name":"山根正宏(せんどりくん、sendori)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:3657","source":"egs"}],"scenario":[{"creditedName":"Recite(リサイト、有限会社リサイト)","creatorId":"vndb:s2819","sourcePersonId":"egs:creator:3854","canonicalEntityId":"vndb:s2819","name":"Recite(リサイト、有限会社リサイト)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:13878","source":"egs"},{"creditedName":"橘ぱん(橘卯月)","creatorId":"vndb:s1734","sourcePersonId":"egs:creator:2193","canonicalEntityId":"vndb:s1734","name":"橘ぱん(橘卯月)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:20383","source":"egs"},{"creditedName":"村上 早紀","creatorId":"vndb:s6997","sourcePersonId":"vndb:s6997","canonicalEntityId":"vndb:s6997","name":"村上 早紀","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:4601","source":"vndb"}],"music":[],"other":[{"creditedName":"山根 正宏","creatorId":"vndb:s2562","sourcePersonId":"vndb:s2562","canonicalEntityId":"vndb:s2562","name":"せんどりくん","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:4599","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c23240","characterName":"水野 涼子","sourceIds":{"vndbCharacterId":"c23240"},"originalCharacterName":"水野 涼子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ryouko is Yousuke's step-sister and Shizuka's only child and daughter. Contrary to her mother, she's very quiet and terse, preferring to observe others rather than absorb attention herself. Despite her laconic nature, she's admired in school. She does her best to keep track of Yousuke and make sure he's doing alright on his own."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough and Erogereview"}],"source":"vndb","sourceCharacterId":"c23240"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4dad7355976dd23e41b8d2aa1c376ad2a5ef469181f1a33e646e052408ab311b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8dac4bc0f99136acc09fe8d07b0ab238e5a170dc8658a97deb5f7be7e9ca9980.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"原島 瑠璃子","creatorId":"vndb:s1010","sourcePersonId":"vndb:s1010","canonicalEntityId":"vndb:s1010","name":"原島 瑠璃子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1548","source":"vndb"}]},{"characterId":"char_vndb_c23252","characterName":"水野 静佳","sourceIds":{"vndbCharacterId":"c23252"},"originalCharacterName":"水野 静佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shizuka should be the most responsible member of the Mizuno family, as Yousuke's kind step-mother and Ryouko's mother. However, despite her grief over her husband's death, she seems to be a bit more naturally carefree than her daughter. That hasn't, however, prevented her from becoming lonely. As a result, she encourages Yousuke to visit her often."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c23252"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16babbc1a5158649671497473e0bc84fd531955a9aba8d377bb25de5b19a06ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0aa8704839c36cfbe757cdda04198c3e3a3ca756bcd63525efd4ebb2a482efb9.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘 紗枝","creatorId":"vndb:s13343","sourcePersonId":"vndb:s13343","canonicalEntityId":"vndb:s13343","name":"橘 紗枝","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1552","source":"vndb"}]},{"characterId":"char_vndb_c23253","characterName":"佐々木 貴美","sourceIds":{"vndbCharacterId":"c23253"},"originalCharacterName":"佐々木 貴美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Takami is the representative of Yousuke's class. She is known for being a little sharp and blunt, but there are rare times when she exhibits a lack of confidence. She was very kind to Yousuke after his father died, and she did her best to help him keep up in class. She is stern with him, but that only shows that she cares about him."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough and Erogereview"}],"source":"vndb","sourceCharacterId":"c23253"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/0758baa084a5825b38f811768d7d2c486d935128debf0de69488920e1b4027f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/1425ed6f8166da7ffdc75426e5d4c5ce3731163bd49bc8c7bca131a0360cdf7c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日 恵美","creatorId":"vndb:s143","sourcePersonId":"vndb:s143","canonicalEntityId":"vndb:s143","name":"笠井 律子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1550","source":"vndb"}]},{"characterId":"char_vndb_c23254","characterName":"長沢 美月","sourceIds":{"vndbCharacterId":"c23254"},"originalCharacterName":"長沢 美月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mitsuki is a young, beautiful chemistry teacher at Yousuke's school. After Yousuke's tragedy, she insisted on helping him get over his loss. Her kind and gentle support produced a very special student-teacher relationship between the two."},{"spoiler":false,"text":"From Ben Woodhouse's Walkthrough"}],"source":"vndb","sourceCharacterId":"c23254"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9abeae9240b1f5a803243af0ffee0f44c10bd377f83d2d2a023b8966453abcd7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e54158e40a6ac88643c49575ee99800dd9ae7cba060a67ac76eeff796a65dc6.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結城 みづほ","creatorId":"vndb:s2068","sourcePersonId":"vndb:s2068","canonicalEntityId":"vndb:s2068","name":"武政 弘子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1551","source":"vndb"}]},{"characterId":"char_vndb_c23255","characterName":"川森 珪子","sourceIds":{"vndbCharacterId":"c23255"},"originalCharacterName":"川森 珪子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Keiko is the manager and a barmaid of the Cafe \"Fir Tree\". She is Yousuke's boss at his part-time waiter job. Although her business is struggling, she pays Yousuke a nice salary, as she knows how tough it is to be alone. Because of all that he’s been through, she does all she can for him, although it’s not easy for her."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough and Erogereview"}],"source":"vndb","sourceCharacterId":"c23255"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a59e4db80c39883014c5e13e51a07d189108e2ed7eefc7f509c2449559eeefe3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f482334c86d088dd097356dcfb096501dd86153455ce1c51b4dd6ad74e7219f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴美 ほのか","creatorId":"vndb:s462","sourcePersonId":"vndb:s462","canonicalEntityId":"vndb:s462","name":"藤原 美央子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1547","source":"vndb"}]},{"characterId":"char_vndb_c28816","characterName":"上総 御世","sourceIds":{"vndbCharacterId":"c28816"},"originalCharacterName":"上総 御世","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Miyo is Yousuke's fellow classmate and a caretaker of the local Shinto temple. She is visually impaired, but gifted with paranormal abilities that extend her sight beyond the limitations of normal people."},{"spoiler":false,"text":"Edited from Erogereview"}],"source":"vndb","sourceCharacterId":"c28816"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29d80c0c55e6077bbbc1db2ba6a9153af790dcf700c37f636a5eea2fe6d25685.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae9cceb4624ac1b94fd178efce3ce46dddc32cbd7751134ce266b78158270422.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"原 由菓","creatorId":"vndb:s1112","sourcePersonId":"vndb:s1112","canonicalEntityId":"vndb:s1112","name":"原 由菓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1549","source":"vndb"}]},{"characterId":"char_vndb_c38472","characterName":"水野 洋介","sourceIds":{"vndbCharacterId":"c38472"},"originalCharacterName":"水野 洋介","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Something is terribly wrong with Mizuno Yousuke. Was it caused by the traumatic death of his father? Or perhaps it was the humiliating incident which led to his separation from his remaining family. Yousuke has a life of unhappiness that began after his mother's untimely death, when he was just a child. He spent most of his life growing up with his father, who had remarried to a beautiful yet quite young woman. But now with the death of his father, he has lost his whole family. His death left Yousuke in darkness. He is now uncontrollably driven to hurt the people who care about him the most, to repay their kindness with merciless destruction that is bound to become very intense as he starts assaulting his victims with some vicious methods such as bondage, enemas, and other sexual humiliations."},{"spoiler":false,"text":"Edited from Ben Woodhouse's Walkthrough and JAST USA"}],"source":"vndb","sourceCharacterId":"c38472"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0722b47cd5b432c38c5fdd5a9472d7