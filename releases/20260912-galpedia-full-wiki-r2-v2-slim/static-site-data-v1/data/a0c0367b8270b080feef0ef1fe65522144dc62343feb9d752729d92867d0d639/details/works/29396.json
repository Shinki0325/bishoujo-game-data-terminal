{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"29396","model":{"presentationWorkId":"egs:29396","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_160818","characterName":"ローラちゃん","sourceIds":{"bangumi":[{"characterId":"160818","match":"source-roster","subjectId":"225259"},{"characterId":"160818","match":"source-roster","subjectId":"502979"}]},"originalCharacterName":"ローラちゃん","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"シティのお嬢様。"},{"spoiler":false,"text":"1歳年上なのを良いことに"},{"spoiler":false,"text":"すぐにお姉さんぶろうとする。"},{"spoiler":false,"text":"でもバスト(胸)は貧相。"},{"spoiler":false,"text":"実は漫画が好き。"},{"spoiler":false,"text":"そして、すぐに影響を受けて漫画のマネをする。"},{"spoiler":false,"text":"好きな食べ物は最後に食べるタイプだが"},{"spoiler":false,"text":"大好物の巨大シュークリームを残していたら"},{"spoiler":false,"text":"てとらに食べられてしまった。"},{"spoiler":false,"text":"……死ぬほど悲しかったが、"},{"spoiler":false,"text":"てとらが美味しいと思って食べてくれたのなら"},{"spoiler":false,"text":"良いと思うことにした。"}],"source":"bangumi","sourceCharacterId":"160818"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aeec1e4e30eef07851f19f77d3654d0726f7d9706f7747fb12340390ee6b21d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffa8f3a3e992f1d56f7ed6e8ef562a045377a4519e7cb0a4842130ef8fa9d426.webp","width":158,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_160869","characterName":"カリン","sourceIds":{"bangumi":[{"characterId":"160869","match":"source-roster","subjectId":"502979"},{"characterId":"160869","match":"source-roster","subjectId":"503028"}]},"originalCharacterName":"カリン","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"■かりん(♂)"},{"spoiler":false,"text":"主人公。"},{"spoiler":false,"text":"学校では普通に友達と接しているけど、"},{"spoiler":false,"text":"実は誰にも言えないお尻の悩みがあった。"},{"spoiler":false,"text":"誰かにお尻を思いっきりイジられたい。"},{"spoiler":false,"text":"でも、誰にも言えない。"},{"spoiler":false,"text":"かりんという名前は"},{"spoiler":false,"text":"武術の神様っぽい名前で、"},{"spoiler":false,"text":"自分では男の子っぽくてカッコいいと思っているけど、"},{"spoiler":false,"text":"周りから「女みたいな名前!」と言われる度にムカムカしている。"}],"source":"bangumi","sourceCharacterId":"160869"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c00e08e851e4614984cf5517131cd5b591c2a8988667c508aa7762cab2221caf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0731aec13e61767f06b5fc4435c6d449cd2a7577d41b69d4b1d81eeccafcfda.webp","width":180,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_160871","characterName":"ありな","sourceIds":{"bangumi":[{"characterId":"160871","match":"source-roster","subjectId":"502979"},{"characterId":"160871","match":"source-roster","subjectId":"503028"}]},"originalCharacterName":"ありな","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"■ありな(♀)"},{"spoiler":false,"text":"かりんのクラスメイトの女の子。"},{"spoiler":false,"text":"かりんをイジめてみたいなぁと内心思ってる。"},{"spoiler":false,"text":"物語後半、事態は急展開。"},{"spoiler":false,"text":"ありなはかりんのご主人様になっちゃう?"},{"spoiler":false,"text":"【女子高生ありな】"},{"spoiler":false,"text":"本編の主人公。"},{"spoiler":false,"text":"どこにでもいるスイーツ（笑）な女子高生。"},{"spoiler":false,"text":"5分に1度は「可愛くなりたい」などと口にする程、筋金入りのスイーツ（笑）だった。"},{"spoiler":false,"text":"ある日、学校でいきなり男子にカンチョーされてしまい、"},{"spoiler":false,"text":"その時は屈辱と羞恥で死にそうになったが"},{"spoiler":false,"text":"同時にお尻の快感を覚えてしまった。"},{"spoiler":false,"text":"以後、部屋で一人の時、"},{"spoiler":false,"text":"鏡で自分の肛門を見ていたり、"},{"spoiler":false,"text":"少しずつお尻への性的欲求が膨らんでいく。"}],"source":"bangumi","sourceCharacterId":"160871"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e03b1b30464adbe868fbed517ea28dfdda001568baa7d1e0c9c12a695db3850c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85d7b7f5f9d9afbd8b3981c19f700d0b26df13c0563cdbff328125d292417336.webp","width":180,"height":200,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p4202","sourceCompanyId":"egs:brand:3319","canonicalEntityId":"vndb:p4202","name":"アリコレ -Aria corporation-","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:29396:3319","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
