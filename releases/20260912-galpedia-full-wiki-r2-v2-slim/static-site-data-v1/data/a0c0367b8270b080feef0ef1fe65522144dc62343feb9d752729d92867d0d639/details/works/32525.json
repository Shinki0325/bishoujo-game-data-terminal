朝ノ こちょ","creatorId":"vndb:s53861","sourcePersonId":"vndb:s53861","canonicalEntityId":"vndb:s53861","name":"朝ノ こちょ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:182223","source":"vndb"},{"creditedName":"朝ノ こちょ","creatorId":"vndb:s53861","sourcePersonId":"vndb:s53861","canonicalEntityId":"vndb:s53861","name":"朝ノ こちょ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:182224","source":"vndb"},{"creditedName":"谷屋楽","creatorId":"vndb:s53862","sourcePersonId":"vndb:s53862","canonicalEntityId":"vndb:s53862","name":"谷屋楽","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:182225","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c104631","characterName":"ミント","sourceIds":{"vndbCharacterId":"c104631"},"originalCharacterName":"ミント","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"626"},"height":{"reviewState":"source-only","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Welcome home, Master!\""},{"spoiler":false,"text":"Likes: Family, Master"},{"spoiler":false,"text":"Dislikes: Tomatoes"},{"spoiler":false,"text":"Hobbies: Going for walks"},{"spoiler":false,"text":"Special Ability: ???"},{"spoiler":false,"text":"She is a Cherubim: a half-animal, half-angel girl."},{"spoiler":false,"text":"She has cat-like ears and tail, as well as angelic wings but does not have a halo. She has a complex about her tiny wings and usually wears toy wings to make up for it. She isn't good at using her angelic powers and is still an angel-in-training. She came down from Heaven to find a certain something but is unsuccessful and ends up collapsing on the side of the road. That's when you find and save her. Soon after, she begins to fondly call you master and affectionately waits at home for your return every day."},{"spoiler":false,"text":"She's kind of a brat who loves to play tricks. She wants to repay the favor of you saving her but it ends up being her that is taken care of instead."},{"spoiler":false,"text":"Voice Profile: A bit high-pitched but also calm and soothing."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c104631"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac2bb101439d9afcd712c19c9c6e1e0d41708fd515a994f6b82c6d1085f0124f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d66113f3cf6a63fe3bdff711b03498fccc5caa3d635256466f55bea64bc23108.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"飴川 紫乃","creatorId":"vndb:s15910","sourcePersonId":"vndb:s15910","canonicalEntityId":"vndb:s15910","name":"小澤 みのり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90555","source":"vndb"}]},{"characterId":"char_vndb_c104632","characterName":"カカオ","sourceIds":{"vndbCharacterId":"c104632"},"originalCharacterName":"カカオ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"407"},"height":{"reviewState":"source-only","source":"vndb","value":"146"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You dirty pig! Let go of my sister!\""},{"spoiler":false,"text":"Likes: Her big sister (Mint)"},{"spoiler":false,"text":"Dislikes: That despicable pig"},{"spoiler":false,"text":"Hobbies: Cat's cradle"},{"spoiler":false,"text":"Special Ability: Rejuvenation"},{"spoiler":false,"text":"She is a Cherubim: a half-animal, half-angel girl."},{"spoiler":false,"text":"She has cat-like ears and tail, as well as angelic wings but unlike Mint, she does have a halo. She excels as an angel and is proficient in magic. However, just like Mint she isn't a full-fledged angel yet. After her big sister, Mint, never returned after saying she was going down to Earth, Cacao grew worried and went to look for her. Upon learning why Mint is on earth, she struggles desperately to change her sister's mind."},{"spoiler":false,"text":"Voice Profile: A bit high-pitched and stand-offish."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c104632"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5a6a48808edbfc2d8da7d2c9a22b2e2e4a9d0ec14f2785856d40bff924945ba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a89fb19862ba24bfff20ccb9a1c8ea20f1949f78c8c81b60343510d02fb529d2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水野 七海","creatorId":"vndb:s2524","sourcePersonId":"vndb:s2524","canonicalEntityId":"vndb:s2524","name":"星野七海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90554","source":"vndb"}]},{"characterId":"char_vndb_c104633","characterName":"リリー","sourceIds":{"vndbCharacterId":"c104633"},"originalCharacterName":"リリー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"912"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Gimme a reward for working really hard♪\""},{"spoiler":false,"text":"Likes: Mint, Master"},{"spoiler":false,"text":"Dislikes: Boredom"},{"spoiler":false,"text":"Hobbies: Teasing Mint"},{"spoiler":false,"text":"Special Ability: Misdirection"},{"spoiler":false,"text":"A half-animal, half-demon girl."},{"spoiler":false,"text":"She has animal-like ears and a tail, as well as black wings."},{"spoiler":false,"text":"She has the demonic power to make people unaware of her presence (she very easily blends in with her surroundings)."},{"spoiler":false,"text":"Possessing a great body, she uses that to tease Mint. Wanting to help pay her way while living with you and Mint, she hides her true identity in order to take on a part-time job."},{"spoiler":false,"text":"She likes to have fun and joke around, but deep down is a serious girl who is always willing to give her honest opinion and offer advice on anything."},{"spoiler":false,"text":"Voice Profile: Somewhat mature but not a particularly low voice."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c104633"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fd067ce944e10a9c12bf9d4f45b8d26e067f5963b0349452c74774a15e26695.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46156c0931791230c7e147923225e4af57f6991c502fddfd10950869ea88ad6c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立花 沙羅","creatorId":"vndb:s5545","sourcePersonId":"vndb:s5545","canonicalEntityId":"vndb:s5545","name":"春岡 沙和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90553","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:7366","sourceCompanyId":"egs:brand:7366","canonicalEntityId":"egs:brand:7366","name":"あにまるハーブ","roleCodes":["brand"],"id