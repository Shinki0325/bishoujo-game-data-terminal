,"identityStatus":"no-alias-hit","relationId":"egs:work-creator:292802","source":"egs"},{"creditedName":"合同会社ブートアップ","creatorId":"egs:creator:38761","sourcePersonId":"egs:creator:38761","canonicalEntityId":"egs:creator:38761","name":"合同会社ブートアップ","detail":"販売","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:292803","source":"egs"},{"creditedName":"とん","creatorId":"egs:creator:25261","sourcePersonId":"egs:creator:25261","canonicalEntityId":"egs:creator:25261","name":"とん","detail":"グラフィック","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:292804","source":"egs"},{"creditedName":"小春 めう","creatorId":"vndb:s1971","sourcePersonId":"vndb:s1971","canonicalEntityId":"vndb:s1971","name":"小春 めう","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:129713","source":"vndb"},{"creditedName":"天ヶ咲 麗","creatorId":"vndb:s4314","sourcePersonId":"vndb:s4314","canonicalEntityId":"vndb:s4314","name":"天ヶ咲 麗","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:129714","source":"vndb"},{"creditedName":"あきのしん","creatorId":"vndb:s5440","sourcePersonId":"vndb:s5440","canonicalEntityId":"vndb:s5440","name":"あきのしん","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:129718","source":"vndb"},{"creditedName":"河原 ゆう","creatorId":"vndb:s13712","sourcePersonId":"vndb:s13712","canonicalEntityId":"vndb:s13712","name":"河原 ゆう","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:129720","source":"vndb"}]},"cast":[{"characterId":"char_c45514","characterName":"篠田 郁美","sourceIds":{"bangumi":[{"characterId":"64302","match":"exact-normalized-name-in-linked-work","subjectId":"251917"}],"egsCharacterIds":["8810"],"vndbCharacterId":"c45514"},"originalCharacterName":"篠田 郁美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"32"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"101"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A full time housewife. The aunt of the protagonist (his mother's little sister), and is married to her husband Takeo for 5 years. Currently, she's living with her husband in a detached house near the protagonist's home."},{"spoiler":false,"text":"A gentle woman with good manners and strong motherly instinct. During the childhood days of the protagonist, she changed his diapers everyday, slept with him on the same bed, and loved him as if he was her own child. As she likes children, she earnestly wishes to have her own baby, but because of her husband's busy work schedule, her desire is yet to be fulfilled."},{"spoiler":false,"text":"Despite her plain and neat appearance, she's got eye catching proportions. Her G-cup breasts and hips capable of easy childbirth stands out even under her clothes. However, as her husband's not paying attention to her lately, she thinks that her womanly charm is lacking."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c45514"},{"segments":[{"spoiler":false,"text":"本作のヒロイン。32歳の専業主婦。"},{"spoiler":false,"text":"主人公にとっては叔母（母親の妹）にあたる女性で、夫の武雄とは5年前に結婚した。"},{"spoiler":false,"text":"現在は主人公の自宅近くの一戸建て住宅に夫とふたりで住んでいる。"},{"spoiler":false,"text":"穏やかで人当たりのいい性格をしており、母性本能がとても強い。"},{"spoiler":false,"text":"主人公が幼かった頃は毎日オシメを替えたり一緒の布団で眠ったりと、まるで我が子のように可愛がってくれていた。"},{"spoiler":false,"text":"子供好きなため早く赤ちゃんが欲しいと願っているが、夫の仕事が忙しいこともありその願望はいまも叶わずにいる。"},{"spoiler":false,"text":"飾り気の少ない清楚な容貌とは正反対に、とても人目をひくプロポーションの持ち主。"},{"spoiler":false,"text":"とくにGカップの巨乳とむっちりとした安産型のお尻は、服のうえからでもかなり目立つ。"},{"spoiler":false,"text":"ただ本人は夫があまり相手をしてくれないこともあり、自分に女性としての魅力が足りないと考えている。"}],"source":"egs","sourceCharacterId":"8810","sourceWorkId":"23515","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の叔母にあたる女性で、5年前に結婚した。"},{"spoiler":false,"text":"現在は主人公の自宅近くの一戸建てに二人で住んでいる。"},{"spoiler":false,"text":"清楚な容貌とは裏腹に、とても人目を惹くプロポーションの持ち主。"},{"spoiler":false,"text":"しかし本人は夫があまり相手をしてくれないこともあり、自分に女性としての魅力が足りないと考えている。"},{"spoiler":false,"text":"穏やかで人当たりの良い性格をしており、母性本能がとても強い。"},{"spoiler":false,"text":"主人公にも昔からオシメを替えたり一緒の布団で眠ったりと、"},{"spoiler":false,"text":"まるで我が子のように可愛がってくれていた。"}],"source":"bangumi","sourceCharacterId":"64302"}],"profileFacts":[{"label":"年龄（本版本）","value":"32 岁","valueContext":null,"source":"egs","sourceCharacterId":"8810","sourceWorkId":"23515","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"101 cm","valueContext":null,"source":"egs","sourceCharacterId":"8810","sourceWorkId":"23515","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"8810","sourceWorkId":"23515","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"8810","sourceWorkId":"23515","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"8810","sourceWorkId":"23515","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"63 cm","valueContext":null,"source":"egs","sourceCharacterId":"8810","sourceWorkId":"23515","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b71ffda8d4473c7aea37b5f44385d3905c9fbbebe80d29243f93b985348b847.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e42e4d17fb8d8e683899df2225bded6db6589d90dffc1c6cf0a6355d0b9616e9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩村琴美","creatorId":"vndb:s1172","sourcePersonId":"vndb:s1172","canonicalEntityId":"vndb:s1172","name":"岩村 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:251917:64302:4813:1","source":"bangumi"}]},{"characterId":"char_vndb_c45515","characterName":"楠木 裕太","sourceIds":{"vndbCharacterId":"c45515"},"originalCharacterName":"楠木 裕太","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the story. A boy who attends a private affiliated school."},{"spoiler":false,"text":"With a strong sense of responsibility and a will to take action, he's not the type to throw in the towel. While his height is average compared to boys his age, his reflexes are excellent. He's the ace striker of their soccer club."},{"spoiler":false,"text":"As both of his parents are working and is mostly out of the house, his aunt who was just a student back then looked after him when he was young."},{"spoiler":false,"text":"Since then, he's held feelings of love towards his aunt, but shortly after Ikumi started working, she got married."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c45515"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5ca0c566064a9a826d7cf42f15e4f4bc60165962e6b5559b504058d3f86b1d76.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d084e44ef436ff73f3eaa689124ae4411c598c5bcc12b50922307ca8b7fbdd0.webp","width":256,"height":254,"source":"static-detail"},"actors":[]},{"characterId":"