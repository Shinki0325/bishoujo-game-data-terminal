{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"10116","model":{"presentationWorkId":"vndb:v1875","staff":{"artwork":[{"creditedName":"水原優","creatorId":"vndb:s5166","sourcePersonId":"egs:creator:3387","canonicalEntityId":"vndb:s5166","name":"水原優","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:53519","source":"egs"}],"scenario":[{"creditedName":"想ファクトリー","creatorId":"vndb:s2777","sourcePersonId":"egs:creator:2071","canonicalEntityId":"vndb:s2777","name":"想ファクトリー","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:53520","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c45234","characterName":"清水 円","sourceIds":{"bangumi":[{"characterId":"205575","match":"exact-normalized-name-in-linked-work","subjectId":"223736"}],"egsCharacterIds":["14086"],"vndbCharacterId":"c45234"},"originalCharacterName":"清水 円","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明るくノリが良い性格だが、俊への想いにはストレートになれず、ついからかったり、弄ったりしてしまう。"},{"spoiler":false,"text":"自分とは違う魅力を持つ妹・光莉に、対抗意識を燃やし、大人の魅力で、俊の籠絡をはかろうとするが……。"},{"spoiler":false,"text":"経験豊富な素振りを見せるが、俊に対する一途な想いから、実際には処女だったりする。"},{"spoiler":false,"text":"「よーし、それじゃあ俊クンの童貞、あたしが奪っちゃおう♪」"}],"source":"egs","sourceCharacterId":"14086","sourceWorkId":"10116","spoiler":false},{"segments":[{"spoiler":false,"text":"『あねあね～許して！お姉ちゃんたち、ボクのおち○ち○ダメになっちゃう！～』登場ヒロイン。"},{"spoiler":false,"text":"教育実習生として俊、光莉の学校にやってきた大学四年生。"},{"spoiler":false,"text":"明るくノリが良い性格だが、俊への想いにはストレートになれず、ついからかったり、弄ったりしてしまう。"},{"spoiler":false,"text":"自分とは違う魅力を持つ妹・光莉に、対抗意識を燃やし、大人の魅力で、俊の籠絡をはかろうとするが……。"},{"spoiler":false,"text":"経験豊富な素振りを見せるが、俊に対する一途な想いから、実際には処女だったりする。"}],"source":"egs","sourceCharacterId":"14086","sourceWorkId":"13401","spoiler":false},{"segments":[{"spoiler":false,"text":"俊の従姉。この度、教育実習生として俊と光莉の学校にやって来る。"},{"spoiler":false,"text":"明るくノリがいいが、少々、ハメを外しすぎるところがある。"},{"spoiler":false,"text":"一見、開けっぴろげな性格に見えるが、従弟の俊に対する思いに関しては、ストレートに表現できず、彼をからかったり、弄ったりという言動をとってしまう。"},{"spoiler":false,"text":"自分と違って家事全般を得意とする光莉には、俊を巡って強い敵愾心を抱き、大人の魅力で対抗しようとする。"},{"spoiler":false,"text":"俊は彼女を慕いつつも、自分を弄る言動に警戒、敬遠といった心情を抱いてもいる。"},{"spoiler":false,"text":"この度、母校でもあり俊と光莉の学校でもあるところに教育実習生としてやってくる。"},{"spoiler":false,"text":"これを機会に、実習期間である2週間で、家と学校で光莉と共に俊へのアピールを行い、彼がどちらかを選ぶよう迫る。"},{"spoiler":false,"text":"俊の前では性的経験が豊富なように振舞うが、彼に一途なため実際には処女。"}],"source":"bangumi","sourceCharacterId":"205575"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4072fccd57407666bb7a56fa31bc994faf0452c2ef08c647176292769620ea3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8342759682d59fe35e9d14a2c346957cb70115ccb84817940477ff5dc5b3c949.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MARIO","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223736:205575:4918:1","source":"bangumi"}]},{"characterId":"char_c45235","characterName":"清水 光莉","sourceIds":{"bangumi":[{"characterId":"205576","match":"exact-normalized-name-in-linked-work","subjectId":"223736"}],"egsCharacterIds":["14087"],"vndbCharacterId":"c45235"},"originalCharacterName":"清水 光莉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"俊と同じ学校にかよう三年生。"},{"spoiler":false,"text":"容姿端麗、成績優秀、お淑やかのお嬢様タイプで、校内でも1、2を争う美少女として、男子から熱い視線を集めている。"},{"spoiler":false,"text":"普段は、落ち着いて節度ある言動を心掛けているようだが、俊のことになると、とたんに暴走を始め、過激でエッチなことでも、なんのためらいもなくしてしまう。"},{"spoiler":false,"text":"家事全般が得意な面をアピールし、俊を懐柔しようと頑張るが……。"},{"spoiler":false,"text":"「わ、私だってお姉ちゃんより、ずーっとずーっと俊ちゃんのこと、好きだもんっ！」"}],"source":"egs","sourceCharacterId":"14087","sourceWorkId":"10116","spoiler":false},{"segments":[{"spoiler":false,"text":"『あねあね～許して！お姉ちゃんたち、ボクのおち○ち○ダメになっちゃう！～』登場ヒロイン。"},{"spoiler":false,"text":"俊と同じ学校にかよう三年生。"},{"spoiler":false,"text":"容姿端麗、成績優秀、お淑やかのお嬢様タイプで、校内でも1、2を争う美少女として、男子から熱い視線を集めている。"},{"spoiler":false,"text":"普段は、落ち着いて節度ある言動を心掛けているようだが、俊のことになると、とたんに暴走を始め、過激でエッチなことでも、なんのためらいもなくしてしまう。"},{"spoiler":false,"text":"家事全般が得意な面をアピールし、俊を懐柔しようと頑張るが……。"}],"source":"egs","sourceCharacterId":"14087","sourceWorkId":"13401","spoiler":false},{"segments":[{"spoiler":false,"text":"俊の従姉。俊と同じ学校に通う。"},{"spoiler":false,"text":"おしとやかで成績優秀、優しい美貌をもっていると、校内でも1、2を争う美少女として通っている。"},{"spoiler":false,"text":"姉を反面教師として、落ち着きと節度ある行動を普段から心がけている。"},{"spoiler":false,"text":"しかし、幼い頃から大好きな俊に対する事柄だけは姉に劣らないかそれ以上の暴走ぶりを示す。"},{"spoiler":false,"text":"特に俊を巡って争う姉に対してや、俊を守るためには、腹黒な事も平気でやってのける。"},{"spoiler":false,"text":"俊が同居するようになってからは、家事が得意な面を積極的に押し出し、彼を懐柔しようとする。"},{"spoiler":false,"text":"本人はすっかり俊の新妻気取り。俊の方もその暴走ぶりに気圧されながらも、彼女のストレートな愛情表現は素直に嬉しく思っている。"}],"source":"bangumi","sourceCharacterId":"205576"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/847c40fd13ddeef48b2cf16431c35ffd3431da6c366005a8b4bc93780a022d98.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16b4194cacb55d9b6112b85b8bfcef84d3c8c66f2c4e90e0c0e2a5cb6d86b6e7.webp","width"