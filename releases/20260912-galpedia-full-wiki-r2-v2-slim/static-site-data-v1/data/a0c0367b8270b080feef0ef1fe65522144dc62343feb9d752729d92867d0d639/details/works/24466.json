d":"24466","spoiler":false},{"segments":[{"spoiler":false,"text":"入学当初から有名人となっているお嬢様。"},{"spoiler":false,"text":"凛とした佇まいだが決して偉そうにはせず、誰にでも優しく手を差し伸べる。"},{"spoiler":false,"text":"お菓子は買うものであり 自分が作るなど考えたこともなかったが、"},{"spoiler":false,"text":"製菓学科講師である かりん の影響で製菓コースを選択する。"},{"spoiler":false,"text":"実はかなりの甘えんぼで照れ屋な性格。"},{"spoiler":false,"text":"彼女との距離が近づくにつれて、素の表情が垣間見えるようになってくる。"},{"spoiler":false,"text":"バカップルのようなイチャイチャに憧れているなど、表と裏でかなりのギャップがある。"},{"spoiler":false,"text":"「絶対笑わないって約束だからね！　その…キス、してほしいなって、思ったの……」"}],"source":"bangumi","sourceCharacterId":"50581"}],"profileFacts":[{"label":"性格","source":"bangumi","sourceCharacterId":"50581","value":"甘えんぼ、照れ屋"},{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"15837","sourceWorkId":"24466","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"15837","sourceWorkId":"24466","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"15837","sourceWorkId":"24466","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"15837","sourceWorkId":"24466","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"15837","sourceWorkId":"24466","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45aa3c9c3679a45ac508d80bd03b0a15245429e439ddb270c492dbc6dd85ce48.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cb7d797c8c7f39373eeb668ff368d6a9477dac48883cffe05bb5548c713e72b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLab