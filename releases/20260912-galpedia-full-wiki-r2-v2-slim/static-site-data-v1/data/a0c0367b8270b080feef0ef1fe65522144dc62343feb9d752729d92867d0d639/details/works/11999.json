rs/v1/images/19/19cebbd582c46cf5692cb6fc3120e279e0653e13851f34ea2ce77079d92ea8ec.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c11131","characterName":"金田 秋穂","sourceIds":{"bangumi":[{"characterId":"141216","match":"exact-normalized-name-in-linked-work","subjectId":"12310"}],"egsCharacterIds":["19801"],"vndbCharacterId":"c11131"},"originalCharacterName":"金田 秋穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"912"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"167"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"元気で明るい、春音の親友。"},{"spoiler":false,"text":"姉御肌で快活な彼女は、身体の弱い春音の面倒を進んで見ている様子。"},{"spoiler":false,"text":"主人公の幼馴染・亮太と付き合っているようだが、彼女自身は「頼りになるお兄さん」タイプを求めているようで……。"}],"source":"egs","sourceCharacterId":"19801","sourceWorkId":"9559","spoiler":false},{"segments":[{"spoiler":false,"text":"元気で明るい、春音の親友。"},{"spoiler":false,"text":"姉御肌で快活な彼女は、身体の弱い春音の面倒を進んで見ている様子。"},{"spoiler":false,"text":"主人公の幼馴染・亮太と付き合っているようだが、彼女自身は「頼りになるお兄さん」タイプを求めているようで……。"}],"source":"bangumi","sourceCharacterId":"141216"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/031a53ab91a49b01db069c094f9d58783fe182624d2f4fdb81a28bd047983144.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e10b4327480f8153582efd37446595f52093ba2fed3fb52597d2b7729836e5a.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c11174","characterName":"ソル・ヴァルキリー","sourceIds":{"bangumi":[{"characterId":"11022","match":"exact-normalized-name-in-linked-work","subjectId":"3590"}],"egsCharacterIds":["13583"],"vndbCharacterId":"c11174"},"originalCharacterName":"ソル・ヴァルキリー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"69"},"height":{"reviewState":"no-conflict","source":"vndb","value":"143"},"hip":{"reviewState":"source-only","source":"vndb","value":"73"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公・村上琉平と契約を結ぶヴァルキリーの少女。"},{"spoiler":false,"text":"数万年も“時の船”と呼ばれる遺跡で眠り続けていた。"},{"spoiler":false,"text":"外見も性格も子供っぽく、負けん気が強く意地っ張り。"},{"spoiler":false,"text":"普段は琉平をマスターと認めず、ワガママで生意気な面が目立つ。しかし、本来の性格は寂しがり屋で意外なほど素直なところもある。"},{"spoiler":false,"text":"最大の能力は“未来における自分の可能性”を引き出し、その能力を数倍にも高めること。"},{"spoiler":false,"text":"本編でも、絶対的な火力と精密射撃を誇る“炎の乙女・ヴリュンヒルデ”、高速での戦闘と鋼鉄をも両断する斬撃を得意とする“刃の乙女・シュベルトライデ”等が登場。"},{"spoiler":false,"text":"その力はこの世界に復活したヴァルキリー達の中でも最強に位置する……はず。"}],"source":"egs","sourceCharacterId":"13583","sourceWorkId":"8722","spoiler":false},{"segments":[{"spoiler":false,"text":"与主人公・村上琉平缔结契约的女武神少女。在被称为“时之船”的遗迹中沉睡了数万年之久。"},{"spoiler":false,"text":"外貌和性格都很孩子气，逞强好胜顽固不化。平时不承认琉平为主人，我行我素盛气凌人的一面很显眼。"},{"spoiler":false,"text":"不过，本来的性格很怕寂寞，也有着意外率真的一面。"},{"spoiler":false,"text":"最大的能力是引出“自己未来的可能性”，将那份能力提高数倍之多。"},{"spoiler":false,"text":"她的力量在复活于这个世界的女武神中也是最强的……应该是这样。"}],"source":"bangumi","sourceCharacterId":"11022"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a118d80dadcd0e33f282cb66da34589d1565518298b105ff2177615b692eab2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c2e22e983ef6814affad4da168b3ce3ee494a11daaedc113dad72332e2f915a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c11175","characterName":"ハガル・ヴァルキリー","sourceIds":{"bangumi":[{"characterId":"10580","match":"exact-normalized-name-in-linked-work","subjectId":"3590"}],"egsCharacterIds":["13584"],"vndbCharacterId":"c11175"},"originalCharacterName":"ハガル・ヴァルキリー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"99"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ソルの“未来の可能性の一つ”を具象化した存在。"},{"spoiler":false,"text":"ソルの姿でいる間は、琉平の寿命を消費してしまうため、普段はハガルの姿でいることが多い。"},{"spoiler":false,"text":"この間はソルも休眠状態だが、ハガルとは感覚を共有している様子。"},{"spoiler":false,"text":"ハガル、家事全般が得意で、ちょっととぼけたところのある優しい女性。"},{"spoiler":false,"text":"主である琉平には、いつも献身的に接してくれる。しかし、いつも献身の度合いはいつもエッチな方へ傾き、肉体を共有するソルにしてみれば気が気ではない。"},{"spoiler":false,"text":"また、琉平が夢で見た遙かな過去の情景に、彼女とそっくりな人物が登場する。その女性は別の名前、別の主を持つらしいが…。"}],"source":"egs","sourceCharacterId":"13584","sourceWorkId":"8722","spoiler":false},{"segments":[{"spoiler":false,"text":"ソル“未来的可能性之一”具象化而成的存在。"},{"spoiler":false,"text":"因为以ソル的姿态存在期间会消费琉平的寿命，平时多以ハガル的姿态存在。在这个期间ソル处于休眠状态，但好像和ハガル共有着感觉。"},{"spoiler":false,"text":"擅长全部家务，有点傻呵呵的温柔女性。一直献身性地服侍着主人琉平。"},{"spoiler":false,"text":"然而，献身的重点总是倾向于H方面，让共有着肉体的ソル战战兢兢如履薄冰。"}],"source":"bangumi","sourceCharacterId":"10580"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/8406aea3eb7bdd2d6b430f1109d28a778e1cfe83615c0127e09a5fa65858a375.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/0151305f782263fcb61efb9825a770248d97f2c94528e484764d20de5467c289.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c11176","characterName":"浅海 澪璃","sourceIds":{"bangumi":[{"characterId":"10581","match":"exact-normalized-name-in-linked-work","subjectId":"3590"}],"egsCharacterIds":["13585"],"vndbCharacterId":"c11176"},"originalCharacterName":"浅海 澪璃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"100"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"琉平のクラスメイトで幼馴染み。さらに従妹で許嫁でもある少女。"},{"spoiler":false,"text":"家は旧家でかつ実業家という、バリバリのお嬢様。お茶やお花など習い事も一通りこなせるが、それ以上に幼い頃から続けている剣道の腕前に優れ、全国大会優勝の経験もあるほど。"},{"spoiler":false,"text":"面倒見が良く世話好きでもありますが、ヤキモチ妬きで意地っ張りで恥ずかしがり屋と、いつも琉平の前では素直になれない様子。"},{"spoiler":false,"text":"琉平がハガルをつれて帰国してからは、澪璃もハガルをライバル視…ハガルの方も澪璃をライバル視している様子。"}],"source":"egs","sourceCharacterId":"13585","sourceWorkId":"8722","spoiler":false},{"segments":[{"spoiler":false,"text":"琉平的同学兼青梅竹马。而且同时还是表妹兼未婚妻的少女。"},{"spoiler":false,"text":"出身于历史悠久的实业世家，是个如假包换的千金大小姐。在茶道与花道等才艺方面都有着基本的修养，但更为优秀的是其从小时候开始锻炼至今的剑道水平，甚至还有过全国大会优胜的经验。"},{"spoiler":false,"text":"很会照顾人，也很喜欢多管闲事，但因为爱吃醋又固执还害羞，貌似在琉平面前总是坦率不起来。"},{"spoiler":false,"text":"自从琉平带着ハガル归国以来，澪璃和ハガル似乎就将彼此视为情敌了。"}],"source":"bangumi","sourceCharacterId":"10581"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fc124af9ab52adaeb6fb4329db74dbd6dd8e52cf420666953ec6f206410eaf0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e9b12b39b723e6c539b50df47ecd23efc8c0b966ed0a1c94d5eb9b6230ee4d6.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c11177","characterName":"来島 詩帆","sourceIds":{"bangumi":[{"characterId":"143712","match":"exact-normalized-name-in-linked-work","subjectId":"3590"}],"egsCharacterIds":["2451"],"vndbCharacterId":"c11177"},"originalCharacterName":"来島 詩帆","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"73"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"hip":{"reviewState":"source-only","source":"vndb","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"琉平、澪璃のクラスメイトで、ちょうど琉平が海外へ渡っていた間に転校してきた少女。"},{"spoiler":false,"text":"実際の年齢よりいくらか年下に見られる外見に、ボンヤリとした様子や、ごく当たり前のことを知らなかったりと、保護欲をくすぐるのかクラスでの人気も高いらしい。"},{"spoiler":false,"text":"過去のこと、家庭のことに暗い影が感じられ、そのことに話が及ぶと彼女の口が途端に重くなる。"},{"spoiler":false,"text":"学園に出没するベルセルクと何らかの関わりを持っているらしいのだが……。"}],"source":"egs","sourceCharacterId":"2451","sourceWorkId":"8722","spoiler":false},{"segments":[{"spoiler":false,"text":"琉平のクラスメイト、学園の理事であり校長の来島猛の娘。世話焼きで明るい性格の女の子。クラス委員なので転校生の琉平やハガルの世話を焼くことも多い。琉平には好意を寄せているらしい。趣味はヴァイオリンとぬいぐるみ、クッション作り。家事は得意だけど料理は苦手。"}],"source":"egs","sourceCharacterId":"2451","sourceWorkId":"19671","spoiler":false},{"segments":[{"spoiler":false,"text":"琉平、澪璃のクラスメイトで、ちょうど琉平が海外へ渡っていた間に転校してきた少女。"},{"spoiler":false,"text":"実際の年齢よりいくらか年下に見られる外見に、ボンヤリとした様子や、ごく当たり前のことを知らなかったりと、保護欲をくすぐるのかクラスでの人気も高いらしい。"},{"spoiler":false,"text":"過去のこと、家庭のことに暗い影が感じられ、そのことに話が及ぶと彼女の口が途端に重くなる。"},{"spoiler":false,"text":"学園に出没するベルセルクと何らかの関わりを持っているらしいのだが……"}],"source":"bangumi","sourceCharacterId":"143712"}],"