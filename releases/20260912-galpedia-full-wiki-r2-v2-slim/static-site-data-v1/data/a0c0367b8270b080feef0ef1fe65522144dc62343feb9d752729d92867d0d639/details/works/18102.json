h":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉野一平","creatorId":"vndb:s8073","sourcePersonId":"vndb:s8073","canonicalEntityId":"vndb:s8073","name":"吉野一平","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61076:52947:28469:1","source":"bangumi"}]},{"characterId":"char_c9819","characterName":"河嶋 秀弥","sourceIds":{"bangumi":[{"characterId":"52949","match":"exact-normalized-name-in-linked-work","subjectId":"36205"},{"characterId":"52949","match":"exact-normalized-name-in-linked-work","subjectId":"61076"}],"egsCharacterIds":["4229"],"vndbCharacterId":"c9819"},"originalCharacterName":"河嶋 秀弥","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"179"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"67"}},"descriptions":[{"segments":[{"spoiler":false,"text":"生涯独身でヨボヨボの爺さんの身だったが、自殺中に時を巻き戻されて若かりし頃に戻った本編の主人公。"},{"spoiler":false,"text":"学生時代、顔は悪くない上に運動も勉強もそこそこにこなしていたが、たまたま女性関係には全く縁が無かった。"},{"spoiler":false,"text":"気持ちまで若返ってはいるが、80年生きた人間としてどこか達観した部分も備えている。"},{"spoiler":false,"text":"死神オーグメントにタイムスリップする能力を与えられるが、トリガーが自分の喉を突き刺すことなので、おいそれと時を戻せないのが最近の悩み。"},{"spoiler":false,"text":"今度こそ幸せな人生を歩むため、オーグメントの助力を得ながらも奮闘する。"},{"spoiler":false,"text":"若返ってからは、守村学園２年Ｂ組の学生として学園に通うことになる。"}],"source":"egs","sourceCharacterId":"4229","sourceWorkId":"16825","spoiler":false},{"segments":[{"spoiler":false,"text":"ヨボヨボの爺さんだった身から自殺中に時を巻き戻されて、若かりし頃に戻った本編の主人公。"},{"spoiler":false,"text":"死神・オーグメントの助力を得て、様々な困難を乗り越えた秀弥は、最高の幸せを勝ち取る。"},{"spoiler":false,"text":"しかし、幸せな日々を送るにも、色々と大変なことがある……ということを、これから身をもって知ることになるのだった。"}],"source":"egs","sourceCharacterId":"4229","sourceWorkId":"18102","spoiler":false},{"segments":[{"spoiler":false,"text":"生涯独身でヨボヨボの爺さんの身だったが、自殺中に時を巻き戻されて若かりし頃に戻った本編の主人公。"},{"spoiler":false,"text":"学生時代、顔は悪くないうえに運動も勉強もそこそこにこなしていたが、たまたま女性関係にはまったく縁が無かった。"},{"spoiler":false,"text":"気持ちまで若返ってはいるが、80年生きた人間としてどこか達観した部分も備えている。"},{"spoiler":false,"text":"死神オーグメントにタイムスリップする能力を与えられるが、トリガーが自分の喉を突き刺すことなので、おいそれと時を戻せないのが最近の悩み。"},{"spoiler":false,"text":"今度こそ幸せな人生を歩むため、オーグメントの助力を得ながらも奮闘する。"},{"spoiler":false,"text":"若返ってからは、守村学園2年B組の学生として学園に通うことになる。"},{"spoiler":false,"text":"「まさか、本当に60年前なのか…？」"}],"source":"bangumi","sourceCharacterId":"52949"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"52949","value":"無趣味"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/298f7083fcb477961b2a5257b3724853bb9ee23f951ad803c81ae9bb360c962b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21fb6030c0ced00e54f9785f74d5ddc7499cf1eeadc7fd398eebd5e5461a08b6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"増田雄市","creatorId":"vndb:s1822","sourcePersonId":"vndb:s1822","canonicalEntityId":"vndb:s1822","name":"増田 雄市","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61076:52949:19465:1","source":"bangumi"}]},{"characterId":"char_c9820","characterName":"梅川 詩帆","sourceIds":{"bangumi":[{"characterId":"52940","match":"exact-normalized-name-in-linked-work","subjectId":"36205"},{"characterId":"52940","match":"exact-normalized-name-in-linked-work","subjectId":"61076"}],"egsCharacterIds":["4221"],"vndbCharacterId":"c9820"},"originalCharacterName":"梅川 詩帆","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"守村学園2年B組。"},{"spoiler":false,"text":"秀弥の幼なじみでクラスメイトでモテモテ（なのだが、本人はその自覚ナシ）"},{"spoiler":false,"text":"梅川家は河嶋家のご近所さんなので、家族ぐるみで付き合いがある。"},{"spoiler":false,"text":"お陰で秀弥とは小さな頃から、一緒に仲良く遊んで育った。"},{"spoiler":false,"text":"喧嘩した訳ではないが、数年前から徐々に秀弥とは疎遠になっている。"}],"source":"egs","sourceCharacterId":"4221","sourceWorkId":"16825","spoiler":false},{"segments":[{"spoiler":false,"text":"河嶋家のすぐご近所に住む、秀弥と蓉子の幼なじみで秀弥の同級生。"},{"spoiler":false,"text":"最近では、さらに『秀弥の恋人』という肩書きも付いて、毎日楽しそうに過ごしている。"},{"spoiler":false,"text":"だが最近になって、新たな悩みが生まれてしまい……？"}],"source":"egs","sourceCharacterId":"4221","sourceWorkId":"18102","spoiler":false},{"segments":[{"spoiler":false,"text":"守村学園2年B組。 秀弥の幼なじみでクラスメイトでモテモテ（なのだが、本人は自覚ナシ）。"},{"spoiler":false,"text":"梅川家は河嶋家のご近所さんなので、家族ぐるみで付き合いがある。"},{"spoiler":false,"text":"おかげで、秀弥とは小さな頃から一緒に仲良く遊んで育った。"},{"spoiler":false,"text":"喧嘩したわけではないが、数年前から徐々に秀弥とは疎遠になっている。"},{"spoiler":false,"text":"「あ、河嶋くん。おはよう」"}],"source":"bangumi","sourceCharacterId":"52940"}],"profileFacts":[{"label":"特技","source":"bangumi","sourceCharacterId":"52940","value":"授業"},{"label":"趣味","source":"bangumi","sourceCharacterId":"52940","value":"勉強（特に文系）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/422eb3e8bf4614a45ec5fbc77b2ff16b59b323d9ac37077558560b828cb71f4c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0541fac6730b699ab728d9583ffefc168128e503c0d61006d2ed9c84270bf32.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"計名 さや香","creatorId":"vndb:s859","sourcePersonId":"vndb:s859","canonicalEntityId":"vndb:s859","name":"かずなさやか(計名さや香)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51772","source":"vndb"}]},{"characterId":"char_c9821","characterName":"陣 紗月","sourceIds":{"bangumi":[{"characterId":"52941","match":"exact-normalized-name-in-linked-work","subjectId":"36205"},{"characterId":"52941","match":"exact-normalized-name-in-linked-work","subjectId":"61076"}],"egsCharacterIds":["4222"],"vndbCharacterId":"c9821"},"originalCharacterName":"陣 紗月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"守村学園の２年生で、秀弥と詩帆の隣のＡクラス。詩帆と仲が良い。"},{"spoiler":false,"text":"かわいく強気で気難しい、テンション高い女の子。"},{"spoiler":false,"text":"秀弥とはひょんな事から知り合うが、顔を合わせると口論ばかり。"},{"spoiler":false,"text":"兄がいることを隠しているが、実はちょっと……いや、かなりブラコン。"},{"spoiler":false,"text":"そんな兄の友明いわく『目に入れて脳が口からハミ出ても痛くないほどかわいい』らしい。"}],"source":"egs","sourceCharacterId":"4222","sourceWorkId":"16825","spoiler":false},{"segments":[{"spoiler":false,"text":"かわいく強気で気難しい、隣のクラスのブラコン女子。"},{"spoiler":false,"text":"今日もクレイジーな兄貴である友明と、クレイジーな彼氏である秀弥に振り回されつつ、青春を謳歌している。"},{"spoiler":false,"text":"そんな矢先、友明が秀弥に頼み事をして……？"}],"source":"egs","sourceCharacterId":"4222","sourceWorkId":"18102","spoiler":false},{"segments":[{"spoiler":false,"text":"守村学園の2年生で、秀弥と詩帆の隣のAクラス。 詩帆と仲が良い。"},{"spoiler":false,"text":"かわいく強気で気難しい、テンション高い女の子。"},{"spoiler":false,"text":"秀弥とはひょんなことから知り合うが、顔を合わせると口論ばかり。"},{"spoiler":false,"text":"兄がいることを隠しているが、実はちょっと……いや、かなりブラコン。"},{"spoiler":false,"text":"そんな兄の友明いわく 「目に入れて脳が口からハミ出ても痛くないほどかわいい」 らしい。"},{"spoiler":false,"text":"「ところで、アンタ一体誰よ。詩帆の知り合い？」"}],"source":"bangumi","sourceCharacterId":"52941"}],"profileFacts":[{"label":"特技","source":"bangumi","sourceCharacterId":"52941","value":"兄いびり"},{"label":"趣味","source":"bangumi","sourceCharacterId":"52941","value":"読書（少女漫画）、編み物"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27186a6c69883f311ad8233054dda495c749b1eb69654cfc8b4468dafb628c70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0f3b666f8413af7c254e6e26da3769a896fcba78c0bd011d19efef7669ac06d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61076:52941:5928:1","source":"bangumi"}]},{"characterId":"char_c9822","characterName":"裾野辺 菜実","sourceIds":{"bangumi":[{"characterId":"52942","match":"exact-normalized-name-in-linked-work","subjectId":"36205"},{"characterId":"52942","match":"exact-normalized-name-in-linked-work","subjectId":"61076"}],"egsCharacterIds":["4223"],"vndbCharacterId":"c9822"},"originalCharacterName":"裾野辺 菜実","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"守村学園の１年生で、この春入学したばかり。"},{"spoiler":false,"text":"実家を出て、学園の英語教師である姉と二人暮らしをしている。"},{"spoiler":false,"text":"クールだけど色々気の利く後輩。"},{"spoiler":false,"text":"よく猟奇的でインパクトあるセリフを口走る事もある女の子。"},{"spoiler":false,"text":"実は動物好きの料理好き。最近では作物を育てる事にも興味津々。"},{"spoiler":false,"text":"名前がおいしそう。"}],"source":"egs","sourceCharacterId":"4223","sourceWorkId":"16825","spoiler":false},{"segments":[{"spoiler":false,"text":"サイケで猟奇的かつクールな後輩で、部員が秀弥と自分しかいないという料理部の部長をつとめる。"},{"spoiler":false,"text":"姉である美波が、守村学園内で英語教師をしている。"},{"spoiler":false,"text":"しかし最近は、その美波が自分と秀弥の付き合いを認めようとしないことに頭を悩ませている。"},{"spoiler":false,"text":"なにか美波を納得させる秘策は無いかと秀弥と話している内、あることを思いつき……？"}],"source":"egs","sourceCharacterId":"4223","sourceWorkId":"18102","spoiler":false},{"segments":[{"spoiler":false,"text":"守村学園の1年生で、この春入学したばかり。"},{"spoiler":false,"text":"実家を出て、学園の英語教師である姉と二人暮らしをしている。"},{"spoiler":false,"text":"クールだけど色々と気の利く後輩。"},{"spoiler":false,"text":"よく猟奇的でインパクトあるセリフを口走ることもある女の子。"},{"spoiler":false,"text":"実は動物好きの料理好き。 最近では作物を育てることにも興味津々。"},{"spoiler":false,"text":"名前がおいしそう。"},{"spoiler":false,"text":"「ううん。わたしも……生き物が死ぬのは、つらい」"}],"source":"bangumi","sourceCharacterId":"52942"}],"profileFacts":[{"label":"特技","source":"bangumi","sourceCharacterId":"52942","value":"料理、姉の扱い"},{"label":"趣味","source":"bangumi","sourceCharacterId":"52942","value":"動物を愛でること、畑仕事"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff11fa784812e4f484eaeb0d054bd01270b3a3e2563a097a7c6bca3ad9482e62.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc0cfb74304ec9629dcf539caad497bdd5f997ab9fa8700aeef8120dd268dbe3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61076:52942:8580:1","source":"bangumi"}]},{"characterId":"char_c9824","characterName":"河嶋 蓉子","sourceIds":{"bangumi":[{"characterId":"52943","match":"exact-normalized-name-in-linked-work","subjectId":"36205"},{"characterId":"52943","match":"exact-normalized-name-in-linked-work","subjectId":"61076"}],"egsCharacterIds":["4224"],"vndbCharacterId":"c9824"},"originalCharacterName":"河嶋 蓉子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"秀弥の実姉で一応大学生だが、秀弥が帰宅する頃には大体家に居る人。"},{"spoiler":false,"text":"弟である秀弥を溺愛しており、『ひーちゃん』と呼んで異様なまでにかわいがっている。"},{"spoiler":false,"text":"しかし、愛情が傍迷惑なレベルにまで溢れ返っているアレな人。"},{"spoiler":false,"text":"そのせいか、弟に対してだけ羞恥心を置き忘れる事態がたびたび発生する。"}],"source":"egs","sourceCharacterId":"4224","sourceWorkId":"16825","spoiler":false},{"segments":[{"spoiler":false,"text":"秀弥の姉だが、弟を溺愛し過ぎており、その愛が傍迷惑なレベルにまで溢れかえっているアレな人。"},{"spoiler":false,"text":"しかしそれが、秀弥とオーグメントの行動により、少しずつ変わってきてしまっていた。"},{"spoiler":false,"text":"蓉子は既に自覚している。それがなんであるのかを。"}],"source":"egs","sourceCharacterId":"4224","sourceWorkId":"18102","spoiler":false},{"segments":[{"spoiler":false,"text":"秀弥の実姉で一応大学生だが、秀弥が帰宅する頃にはだいたい家に居る人。"},{"spoiler":false,"text":"弟である秀弥を溺愛しており、“ひーちゃん” と呼んで異様なまでにかわいがっている。"},{"spoiler":false,"text":"しかし、愛情が傍迷惑なレベルにまであふれ返っているアレな人。"},{"spoiler":false,"text":"そのせいか、弟に対してだけ羞恥心を置き忘れる事態がたびたび発生する。"},{"spoiler":false,"text":"「ひーちゃん、おはよー！　さ、良い天気だよ。起きましょーっ！」"}],"source":"bangumi","sourceCharacterId":"52943"}],"profileFacts":[{"label":"特技","source":"bangumi","sourceCharacterId":"52943","value":"ナチュラルハイテンション"},{"label":"趣味","source":"bangumi","sourceCharacterId":"52943","value":"ひーちゃん、映画鑑賞"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34d54fbc7bc4b62b029aef93b2d638067d18f1866dbf4eab9c928f8a0bb82492.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee3d503e2e3075036ab010d0ce99ffd25807b5fcd70a33670f8572a5d3146633.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61076:52943:6351:1","source":"bangumi"}]},{"characterId":"char_vndb_c9823","characterName":"オーグメント","sourceIds":{"vndbCharacterId":"c9823"},"originalCharacterName":"オーグメント","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"revie