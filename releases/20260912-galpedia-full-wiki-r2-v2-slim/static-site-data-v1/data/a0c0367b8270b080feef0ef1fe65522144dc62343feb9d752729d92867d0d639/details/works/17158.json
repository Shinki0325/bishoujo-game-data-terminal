de":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:277769","source":"egs"},{"creditedName":"薫子","creatorId":"vndb:s10539","sourcePersonId":"vndb:s10539","canonicalEntityId":"vndb:s10539","name":"薫子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:88900","source":"vndb"},{"creditedName":"薫子","creatorId":"vndb:s10539","sourcePersonId":"vndb:s10539","canonicalEntityId":"vndb:s10539","name":"薫子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:88901","source":"vndb"},{"creditedName":"留里佳","creatorId":"vndb:s9549","sourcePersonId":"vndb:s9549","canonicalEntityId":"vndb:s9549","name":"山本 留里佳","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:88902","source":"vndb"}]},"cast":[{"characterId":"char_c6108","characterName":"本庄 千弥子","sourceIds":{"bangumi":[{"characterId":"200553","match":"exact-normalized-name-in-linked-work","subjectId":"218337"}],"egsCharacterIds":["7007"],"vndbCharacterId":"c6108"},"originalCharacterName":"本庄 千弥子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"優希の母親で、主人公（健二）の義母。"},{"spoiler":false,"text":"夫（忠志）とはお見合い結婚。"},{"spoiler":false,"text":"自分の親と夫の親が知り合いで、その縁でお見合いをし、結婚に至る。"},{"spoiler":false,"text":"年上の夫と早くに結婚したため、社会に出て働いた経験が無く、世間擦れしていない。"},{"spoiler":false,"text":"夫以外の男と付き合った経験がなく、当然夫以外の男と、性的関係を 持ったことも無かった。"},{"spoiler":false,"text":"夫の年齢もあり、ここ数年は夜の営みも無く女の悦びを忘れかけていたが、自分の人生に疑問を持ったことは無いものの、自由に生きようとしている。"},{"spoiler":false,"text":"妊娠した娘のことは密かに応援しており、そして、自身はあまり認識していないが、自由に恋愛を楽しんでいる娘のことを羨ましく思っていた。"}],"source":"egs","sourceCharacterId":"7007","sourceWorkId":"17158","spoiler":false},{"segments":[{"spoiler":false,"text":"淑やかで控えめな性格。"},{"spoiler":false,"text":"真面目で思いやりのある、優しい女性。"},{"spoiler":false,"text":"世間擦れしておらず、年齢の割りに純真。"},{"spoiler":false,"text":"意外と積極的な面も。"}],"source":"bangumi","sourceCharacterId":"200553"}],"profileFacts":[{"label":"年龄（本版本）","value":"43 岁","valueContext":null,"source":"egs","sourceCharacterId":"7007","sourceWorkId":"17158","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"7007","sourceWorkId":"17158","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"7007","sourceWorkId":"17158","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"7007","sourceWorkId":"17158","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"7007","sourceWorkId":"17158","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/018ef0eea4922392a033204326e2b631b8a97e32288d3b80cc9837241d06b041.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79d9c9133147bafe95fc7485d0e6ef23b1b957490e38440f4278f5f9d6e5dd1b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上 瑞樹","creatorId":"vndb:s7111","sourcePersonId":"vndb:s7111","canonicalEntityId":"vndb:s7111","name":"井上 瑞樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47190","source":"vndb"}]},{"characterId":"char_vndb_c117016","characterName":"本庄 健二","sourceIds":{"vndbCharacterId":"c117016"},"originalCharacterName":"