:"egs:creator:24521","name":"ヒラノギ","detail":"アシスタントディレクター","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:226955","source":"egs"},{"creditedName":"NYAON","creatorId":"vndb:s2020","sourcePersonId":"vndb:s2020","canonicalEntityId":"vndb:s2020","name":"NYAON","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:115602","source":"vndb"},{"creditedName":"NYAON","creatorId":"vndb:s2020","sourcePersonId":"vndb:s2020","canonicalEntityId":"vndb:s2020","name":"NYAON","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:115603","source":"vndb"},{"creditedName":"師走 ほりお","creatorId":"vndb:s2457","sourcePersonId":"vndb:s2457","canonicalEntityId":"vndb:s2457","name":"師走 ほりお","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:115604","source":"vndb"}]},"cast":[{"characterId":"char_c28860","characterName":"湯川 百花","sourceIds":{"bangumi":[{"characterId":"29930","match":"exact-normalized-name-in-linked-work","subjectId":"118101"}],"egsCharacterIds":["5668"],"vndbCharacterId":"c28860"},"originalCharacterName":"湯川 百花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の妹。一つ年下で、同じ学園に通っている。バドミントン部所属。"},{"spoiler":false,"text":"学園では優等生だが、兄に対しては反抗的で生意気な態度をとってくる。"},{"spoiler":false,"text":"兄の部屋にあったエロ本やＤＶＤを処分したところ、それらの「代わり」として盗撮や悪戯を受けるようになっていく。"},{"spoiler":false,"text":"秘かな興奮もあり、全てに気づきながらも我慢していると、やがてその態度はレイプ願望と誤解されてしまい……。"}],"source":"egs","sourceCharacterId":"5668","sourceWorkId":"21326","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹。 ひとつ年下で、同じ学園に通っている。"},{"spoiler":false,"text":"学園では優等生だが、兄に対しては反抗的で生意気な態度をとってくる。"},{"spoiler":false,"text":"兄の部屋にあったエロ本やDVDを処分した代償として、盗撮やイタズラを受けることに。"},{"spoiler":false,"text":"その行為にすべて気付きながらも、密かな興奮もあって知らないフリをしていた。"},{"spoiler":false,"text":"やがてその態度は “レイプ願望” と誤解されてしまい……。"},{"spoiler":false,"text":"「何を探してるの？　エッチな本なら私が捨てたけど？」"}],"source":"bangumi","sourceCharacterId":"29930"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73cd951e82880224848e85391e0576bb0a092bd4bd084909d27ef1a67a628fad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7c543afef249baa7aba8823a0c3bfd2b2891df34e455a2af8fe52e503c120da.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:118101:29930:15637:1","source":"bangumi"}]},{"characterId":"char_c28861","characterName":"高崎 莉音","sourceIds":{"bangumi":[{"characterId":"29931","match":"exact-normalized-name-in-linked-work","subjectId":"118101"}],"egsCharacterIds":["5669"],"vndbCharacterId":"c28861"},"originalCharacterName":"高崎 莉音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"百花の同級生。百花のことが大好きで、湯川家にもよく遊びにくる。"},{"spoiler":false,"text":"少々思い込みが激しい面があり、普段はどちらかといえば大人しいのに思い詰めると一直線。"},{"spoiler":false,"text":"大切な親友が最近元気をなくしていることを心から心配している。"},{"spoiler":false,"text":"やがて百花が主人公に弄ばれていることを知り、彼女を助けようとするのだが……。"}],"source":"egs","sourceCharacterId":"5669","sourceWorkId":"21326","spoiler":false},{"segments":[{"spoiler":false,"text":"百花の同級生。 百花のことが大好きで、湯川家にもよく遊びに来る。"},{"spoiler":false,"text":"普段はおとなしい性格だが、少々思い込みが激しい面があり、思い詰めると一直線。"},{"spoiler":false,"text":"親友である百花が元気をなくしていることを、心から心配している。"},{"spoiler":false,"text":"やがて百花が主人公に弄ばれていることを知り、彼女を助けようとするのだが……。"},{"spoiler":false,"text":"「百花ちゃんは、私が守りますっ!!」"}],"source":"bangumi","sourceCharacterId":"29931"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98c4b365981540577b1a3fa47b37631f0d4e5747645e309781742ef753df54fa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64ed4bd08e6c9c602ca98bc44ebad387f2d44af2da6aac61e77d08b6420ef83b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天海玖美","creatorId":"vndb:s2832","sourcePersonId":"vndb:s2832","canonicalEntityId":"vndb:s2832","name":"天海 玖美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:118101:29931:15998:1","source":"bangumi"}]},{"characterId":"char_c28862","characterName":"相馬 直輝","sourceIds":{"bangumi":[{"characterId":"29932","match":"exact-normalized-name-in-linked-work","subjectId":"118101"}],"egsCharacterIds":["5670"],"vndbCharacterId":"c28862"},"originalCharacterName":"相馬 直輝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の友人。チャラい外見のお調子者だが、根は純情。"},{"spoiler":false,"text":"エロ本やＤＶＤを主人公に預けたところ、その妹に全て捨てられてしまう。"},{"spoiler":false,"text":"代償として、その友人の妹――百花の写真を要求するのだが、当初はエロ写真のつもりはなかった。"},{"spoiler":false,"text":"百花のことが好き。"}],"source":"egs","sourceCharacterId":"5670","sourceWorkId":"21326","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の友人。 チャラい外見のお調子者だが、根は純情。"},{"spoiler":false,"text":"百花のことが好き。"},{"spoiler":false,"text":"エロ本やDVDを主人公に預けたところ、百花にすべて捨てられてしまう。"},{"spoiler":false,"text":"その代償として百花の写真を要求するのだが、図らずもエロ写真をもらってしまう。"},{"spoiler":false,"text":"「やっぱり百花ちゃんはいつ見てもかわいいなぁ」"}],"source":"bangumi","sourceCharacterId":"29932"}],"profileFacts":[],"metadataCandidateConflicts":{},"image