terId":"89833","match":"exact-normalized-name-in-linked-work","subjectId":"7400"}],"egsCharacterIds":["17003"],"vndbCharacterId":"c1911"},"originalCharacterName":"知里 紫織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shiori is an incredibly intellectual yet mysterious woman who serves as the mansion’s sole housekeeper. She possesses two personalities: during the day a motherly understanding figure; during the night a lusting harlot. Having lived with this curse for so long, Shiori has long forgotten which aspect is her true self."},{"spoiler":false,"text":"From Eroge Review"}],"source":"vndb","sourceCharacterId":"c1911"},{"segments":[{"spoiler":false,"text":"館の一切を取り仕切るメイド。"},{"spoiler":false,"text":"性格は優しく穏やか。"},{"spoiler":false,"text":"書物全般に対して造詣が深い。"},{"spoiler":false,"text":"また男を悦ばせる至高のテクニックの持ち主。"}],"source":"egs","sourceCharacterId":"17003","sourceWorkId":"3863","spoiler":false},{"segments":[{"spoiler":false,"text":"館の一切を取り仕切っているメイド。"},{"spoiler":false,"text":"穏やかで優しい性格。書物全般に対して造詣が深い。"},{"spoiler":false,"text":"昼は淑女、夜は娼婦、といったタイプ。性に関する技術や、"},{"spoiler":false,"text":"男を喜ばせるテクニックに長けていて、主人公に対しては、"},{"spoiler":false,"text":"誘惑者の役割。非処女。"}],"source":"bangumi","sourceCharacterId":"89833"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4efdfb188a14520339cb81a719f314cdae5d003852c44dda6b66b793375d6e0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1d86e0b8d4e6636b758a8cd8da79a2edfe6ed544b2ccaa870b2c3a634036d80.webp","width":179,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひびきりん","creatorId":"vndb:s3640","sourcePersonId":"vndb:s3640","canonicalEntityId":"vndb:s3640","name":"ひびき りん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7400:89833:40661:1","source":"bangumi"}]},{"characterId":"char_c1912","characterName":"竜胆","sourceIds":{"bangumi":[{"characterId":"89836","match":"exact-normalized-name-in-linked-work","subjectId":"7400"}],"egsCharacterIds":["17004"],"vndbCharacterId":"c1912"},"originalCharacterName":"竜胆","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mysterious and aloof, Rindou resides in the inner most chambers of the mansion and rarely leaves her quarters: even to eat or socialize. Her alabaster skin and blood red eyes create a foreboding air, yet she is always seen with a kind smile and knowing expression."},{"spoiler":false,"text":"From Eroge Review"}],"source":"vndb","sourceCharacterId":"c1912"},{"segments":[{"spoiler":false,"text":"透き通るほどの白い肌と髪を持つ、アルビノの少女。"},{"spoiler":false,"text":"「神樹の館」の守り神的な存在として、屋敷の奥で生活をしているらしいが、滅多なことで顔を出すことはない。"},{"spoiler":false,"text":"他の住人の間では、一種のタブーとして畏れ、敬われている。"}],"source":"egs","sourceCharacterId":"17004","sourceWorkId":"3863","spoiler":false},{"segments":[{"spoiler":false,"text":"謎の住人。"},{"spoiler":false,"text":"透き通るほどに白い、アルビノの少女。"},{"spoiler":false,"text":"屋敷の奥で生活しているらしく、普段、顔を出すことは滅多にない。"},{"spoiler":false,"text":"「神樹の館」の守り神的存在。住人たちの間では、"},{"spoiler":false,"text":"一種のタブーとして畏れ、敬われている。"},{"spoiler":false,"text":"彼女の意思ひとつで、館はその姿を変貌させる。"}],"source":"bangumi","sourceCharacterId":"89836"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c30a2a9434852274201543f7dab8db4aaeaf2a7194c34c26826c7cc331fbd222.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f732a1ec49ff60d264c583577688a6d233493ccaf9da917ddd11c414000fdd31.webp","width":171,"height":256,