[{"characterId":"char_c31627","characterName":"エリード","sourceIds":{"bangumi":[{"characterId":"174738","match":"exact-normalized-name-in-linked-work","subjectId":"30096"}],"egsCharacterIds":["14533"],"vndbCharacterId":"c31627"},"originalCharacterName":"エリード","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"欲望を司る女神。"},{"spoiler":false,"text":"光の教団が新たに信仰の象徴にした「偽天の女神」の影響で、 光の従属神達と同じく力が徐々に弱りつつある。"},{"spoiler":false,"text":"しかし、人間が生きるうえで抗えない欲望を司るために、現時点では他の女神たちより頭ひとつ抜き出た力を保っている。"},{"spoiler":false,"text":"天の女神としての力を「光の教団」に盗むように奪われたルトナに己の未来を重ね、状況打破の為に、主要因であるダンテスの元に現われ、光の教団打倒の為の協力を申し出る。"},{"spoiler":false,"text":"「ふふ……、さあダンテス、奪いなさい。欺瞞に満ちた光に属する女神たちの力を。……それが、あなたの復讐に繋がるわ」"}],"source":"egs","sourceCharacterId":"14533","sourceWorkId":"12975","spoiler":false},{"segments":[{"spoiler":false,"text":"欲望を司る女神。"},{"spoiler":false,"text":"正ノルニル教団が新たに信仰の象徴にした「偽天の女神」の影響で、光の従属神たちと同じく力が徐々に弱りつつある。"},{"spoiler":false,"text":"しかし、人間が生きるうえで抗えない欲望を司るために、現時点では他の女神たちより頭ひとつ抜き出た力を保っている。"},{"spoiler":false,"text":"天の女神としての力を「正ノルニル教団」に盗むように奪われたルトナに己の未来を重ね、状況打破のために主要因であるダンテスの元に現われ、正ノルニル教団打倒のための協力を申し出る。"},{"spoiler":false,"text":"気紛れな性格で、その時々の気分で同じ事を聞いても回答がガラリと変わる。"},{"spoiler":false,"text":"狂言回しのように振る舞いダンテスの復讐などには触れず、軽い性格を思わせ、その真意は定かではない。"}],"source":"bangumi","sourceCharacterId":"174738"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"14533","sourceWorkId":"12975","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"14