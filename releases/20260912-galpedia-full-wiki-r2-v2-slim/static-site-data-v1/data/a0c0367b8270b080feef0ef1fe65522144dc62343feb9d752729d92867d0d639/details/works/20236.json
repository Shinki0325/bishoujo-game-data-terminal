{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"20236","model":{"presentationWorkId":"vndb:v14651","staff":{"artwork":[{"creditedName":"紅葉蛍(紅葉-K)","creatorId":"vndb:s2458","sourcePersonId":"egs:creator:2173","canonicalEntityId":"vndb:s2458","name":"紅葉蛍(紅葉-K)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:129360","source":"egs"}],"scenario":[{"creditedName":"川原圭人","creatorId":"vndb:s2230","sourcePersonId":"egs:creator:2496","canonicalEntityId":"vndb:s2230","name":"川原圭人","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:129361","source":"egs"},{"creditedName":"仙道佳帆","creatorId":"vndb:s2229","sourcePersonId":"egs:creator:6836","canonicalEntityId":"vndb:s2229","name":"仙道佳帆","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:129362","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c18028","characterName":"桐生 慎二","sourceIds":{"vndbCharacterId":"c18028"},"originalCharacterName":"桐生 慎二","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist who was always compared to his popular brother. He became an adult without ever trusting his own family."},{"spoiler":false,"text":"When he became an adult, he was jobless and living aimlessly, but after casually trying stock trading, his talents showed great results, and now, he's living alone comfortably."},{"spoiler":false,"text":"He couldn't accept that his childhood love Ayako married his hated brother, and ever since then, he hasn't came home."},{"spoiler":false,"text":"Madoka, who takes every chance to belittle Shinji as a worthless loser, always compares him to his older brother. Because of that, he never stopped resenting her."},{"spoiler":false,"text":"One day, when his brother asked him for a loan to save his company, he decided it was a good opportunity to steal everything from him."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c18028"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f8c3c254487a769039c78993c4ad01f334b000f7e9779e7579cbef0a1f092ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1371c817ccff64e5338ed4faf58eaf434fe2d806b798515d012c08181d00f0d.webp","width":256,"height":192,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c18031","characterName":"桐生 栄一","sourceIds":{"vndbCharacterId":"c18031"},"originalCharacterName":"桐生 栄一","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man with an attractive face and figure, and a good grasp of things. He has lived smoothly just like what his parents expected of him."},{"spoiler":false,"text":"However, because of his management incompetence, the company he inherited from his father is currently on the verge of bankruptcy."},{"spoiler":false,"text":"Since his childhood, he has always completely looked down on his incompetent younger brother, but after knowing of Shinji's wealth, he planned on ripping off his brother's money."},{"spoiler":false,"text":"He treats his wife Ayako like a beautiful trophy he won, and doesn't love her more than that. On the other hand, he uses the love that Madoka has for him to make use of her as his convenient woman, and as a substitute for Ayako."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c18031"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/824a55cb009643bf2179e432d61787aa63b8d7e4a7bf298f71fca7de4252e27b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aaba4fa9617b52f1782248c477aca1282b629a7f3246e3caf1cd522e43e5013e.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p185","sourceCompanyId":"egs:brand:1690","canonicalEntityId":"vndb:p185","name":"CATTLEYA","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:20236:1690","source":"egs"},{"companyId":"vndb:p185","sourceCompanyId":"vndb:p185","canonicalEntityId":"vndb:p185","name":"CATTLEYA","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:37287:v14651","source":"vndb"},{"companyId":"vndb:p185","sourceCompanyId":"vndb:p185","canonicalEntityId":"vndb:p185","name":"CATTLEYA","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:39476:v14651","source":"vndb"},{"companyId":"vndb:p139","sourceCompanyId":"vndb:p139","canonicalEntityId":"vndb:p139","name":"電脳CLUB","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:42129:v14651","source":"vndb"},{"companyId":"vndb:p185","sourceCompanyId":"vndb:p185","canonicalEntityId":"vndb:p185","name":"CATTLEYA","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:42130:v14651","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
