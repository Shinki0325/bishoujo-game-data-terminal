62"}]},"originalCharacterName":"Hishima Sazakuchi","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0907"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"死神の一人。しかし本人曰く「不真面目」で、死神のゲームの運営にはほとんど参加していない。"},{"spoiler":false,"text":"理知的な雰囲気を漂わせるが、口を開くと皮肉屋で偏屈。"},{"spoiler":false,"text":"死神の中でも浮いた存在で、何か目的や思惑があるのかすら不明の謎多き人物。"}],"source":"bangumi","sourceCharacterId":"99063"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/182c36b1440656715fc9c53451f7ef41374d6cfbeabcf77b5023293da2270283.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d8fb89b5eae5c5bd9ca8db4968b3efec9d123c0ab3cf5d998bf85502362dd26.webp","width":80,"height":256,"source":"static-detail"},"actors":[{"creditedName":"武内駿輔","creatorId":"vndb:s10963","sourcePersonId":"vndb:s10963","canonicalEntityId":"vndb:s10963","name":"武内 駿輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320462:99063:16361:1","source":"bangumi"}]},{"characterId":"char_bangumi_99064","characterName":"Shoka Sakurane","sourceIds":{"bangumi":[{"characterId":"99064","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"Shoka Sakurane","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0330"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"死神の一人。いつも面倒そうに監視の仕事をこなしている。"},{"spoiler":false,"text":"現在のゲームを退屈だと感じており、若干仕事にも身が入っていない。新人チームである『ツイスターズ』に興味を示し、ゲームが荒れるように煽る。"},{"spoiler":false,"text":"彼女が着ているパーカーは、最近渋谷に