{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"35804","model":{"presentationWorkId":"egs:35804","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_100321","characterName":"ミカギ ハツキ","sourceIds":{"bangumi":[{"characterId":"100321","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"ミカギ ハツキ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0505"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"得体のしれないミステリアスの男性。渋谷のことをよく知らないようで、街に対しての興味を覗かれる。"}],"source":"bangumi","sourceCharacterId":"100321"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70e5239461082a3706c324b544e0f9718c0142c4e3104a742943ca6043a6711e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98c820fb49ae1d6efdbd6e9c3dd02a35fb01bcabb1f01e81e8c31ecf6b3d87e5.webp","width":91,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_13043","characterName":"サクラバ ネク","sourceIds":{"bangumi":[{"characterId":"13043","match":"source-roster","subjectId":"219"},{"characterId":"13043","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"サクラバ ネク","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0421"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公。渋谷生まれ渋谷育ちの15歳の少年。他人と分かり合うことに疑問を感じ、一人でいることを好むと同時に他人と関わることを極度に嫌っている。常にヘッドフォンを着けているのは、自分と周りの世界を遮断していることの表れである。趣味は音楽や「グラフィティ」と呼ばれるストリートアート。シブヤで「CAT」と呼ばれる、グラフィティやデザインで有名な人物を尊敬している。バッジを利用したサイキックに長けている。"}],"source":"bangumi","sourceCharacterId":"13043"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/2840014e0f4ee52d32e8dde487964a1134ca2f2f15f968c608ac437170480cc7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1aded7926e1bc11301d7a0276faf4f12a67621b8affb37b5593c6d897b14261f.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"内山昂輝","creatorId":"vndb:s12922","sourcePersonId":"vndb:s12922","canonicalEntityId":"vndb:s12922","name":"内山 昂輝","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320462:13043:5768:1","source":"bangumi"}]},{"characterId":"char_bangumi_13044","characterName":"ミサキ シキ","sourceIds":{"bangumi":[{"characterId":"13044","match":"source-roster","subjectId":"219"},{"characterId":"13044","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"ミサキ シキ","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1012"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"15歳の少女。落ち着いた雰囲気だが、やや天然なところもある。死神のゲーム初参加なのにネクと初めて会った時「契約すればノイズを倒せる」など死神のゲームに少し詳しいところがある。おしゃれ好きで、へそ出しファッションに身を包み、手作りの黒ネコのぬいぐるみ“にゃんタン”をよく持ち歩いている。裁縫が得意で、着ている服は自分で作ったもの。将来の夢はファッションデザイナー。にゃんタンを操る「サイコマンス」が主戦法（本作中でシキは自らの能力を「テレキネシス」と言っていたが、実際は自我を与える「サイコマンス」である）。"}],"source":"bangumi","sourceCharacterId":"13044"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/8277b5ba833c5ea6d178cc36e04005b1e3c9c1d33f5e70069719c831a1508fd9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd790a4d6a26962afb5efe4888c7865b163694d7504798f5899d6ee6adca9900.webp","width":82,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_13045","characterName":"キリュウ ヨシヤ","sourceIds":{"bangumi":[{"characterId":"13045","match":"source-roster","subjectId":"219"},{"characterId":"13045","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"キリュウ ヨシヤ","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1101"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"15歳の少年。生意気で偉そうな態度をとる。"},{"spoiler":false,"text":"頭の回転が速くずる賢こく、どこか飄々としていて、"},{"spoiler":false,"text":"別の世界や者が視える。ネクと手を組むことになるが、"},{"spoiler":false,"text":"様々なこと詳しいため、信頼できそうな反面、どことなく"},{"spoiler":false,"text":"信用ができない部分もある。"}],"source":"bangumi","sourceCharacterId":"13045"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff2f13ca164fa8ed7a2e6dae5d6f7f758d41fd15b30fe25476abf3c706859b14.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08cfe5a2a8028c7ea419980357d6b985fdaad71c884739eba64c9599c3f90130.webp","width":85,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村良平","creatorId":"vndb:s382","sourcePersonId":"vndb:s382","canonicalEntityId":"vndb:s382","name":"木村 良平","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320462:13045:4994:1","source":"bangumi"}]},{"characterId":"char_bangumi_13046","characterName":"ビトウ ダイスケノジョウ","sourceIds":{"bangumi":[{"characterId":"13046","match":"source-roster","subjectId":"219"},{"characterId":"13046","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"ビトウ ダイスケノジョウ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0801"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"15歳の少年。パートナーのライムと行動を共にしている。頑固で熱く、思いついた事をそのまま実行する短絡的で直情的な性格で、よくライムにたしなめられている。自分と正反対の性格のネクに対して少々熱くなることも多い。本名を呼ばれる事を嫌がる。スケボーが得意で、主戦法はスケボーに乗っての白兵戦。"}],"source":"bangumi","sourceCharacterId":"13046"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12be2d9ccf300a6abb7adfdf18f92cb5f35cae9e490ba14e2d61b78e3e87a454.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/7079d3daccdba632dc3ffb215e38a3b395b70f252d40eb2b391e7325493727a6.webp","width":97,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村昴","creatorId":"vndb:s8109","sourcePersonId":"vndb:s8109","canonicalEntityId":"vndb:s8109","name":"木村 昴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320462:13046:6787:1","source":"bangumi"}]},{"characterId":"char_bangumi_13047","characterName":"ビトウ ライム","sourceIds":{"bangumi":[{"characterId":"13047","match":"source-roster","subjectId":"219"},{"characterId":"13047","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"ビトウ ライム","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0120"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ビイトといつも一緒にいる、明るくひたむきな少女。一人称はボク（ボク少女）。ビイトと揃いのドクロマークのニットキャップを被っている。冷静な判断力を持ち、暴走しがちなビイトをサポートしている。頻繁にことわざを使う癖がある。"}],"source":"bangumi","sourceCharacterId":"13047"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3fb506ae2f102f2363017e34ca893f7b42987c469e69ac912f8ca49f093d4a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7c45efd077236a439e834d9f80aee4ef18102190913e9d858e6b9f7f64be186.webp","width":79,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹達彩奈","creatorId":"vndb:s1767","sourcePersonId":"vndb:s1767","canonicalEntityId":"vndb:s1767","name":"竹達 彩奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320462:13047:5228:1","source":"bangumi"}]},{"characterId":"char_bangumi_88881","characterName":"ヤシロ ウヅキ","sourceIds":{"bangumi":[{"characterId":"88881","match":"source-roster","subjectId":"219"},{"characterId":"88881","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"ヤシロ ウヅキ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0702"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"組織の下っ端に位置する17歳の女性。常に仕事にやりがいを求めており、その為なら嘘のミッションを吹っかけるなどどんな手段も選ばない。通称ピンク頭。自身の実力は高く、ゲームマスター代行に指名される程の力を持つが、感情的で向こう見ずな性格から、制御が足らず失敗してしまうことが多い。同僚の狩谷とよくつるんでいるが、組織に入ってからの日は彼より浅いため一応後輩である。狩谷が幹部入りを断っていたのを知り、足手まといになるのを嫌がっていたが、狩谷に「自分のペースでやればいいのサ」「俺はこの雑多なシブヤが好きなのサ」などと言われて、自分を見つめなおすようになる。"}],"source":"bangumi","sourceCharacterId":"88881"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e87fa4887c4d7aa1d12800f6e3481e09d55e20115e165e4c2845a499d5ba1c45.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/adb41640b6134bc0ce270769a5e3f75b8244147e1fcfbb965d02563cc8719b38.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新井里美","creatorId":"vndb:s1324","sourcePersonId":"vndb:s1324","canonicalEntityId":"vndb:s1324","name":"新井 里美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320462:88881:4625:1","source":"bangumi"}]},{"characterId":"char_bangumi_88883","characterName":"カリヤ コウキ","sourceIds":{"bangumi":[{"characterId":"88883","match":"source-roster","subjectId":"219"},{"characterId":"88883","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"カリヤ コウキ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0926"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"常に気だるげでやる気も無さそうだが、硬派でプライドが高く、仕事に誇りを持っている19歳の青年。通称アメ玉。八代と行動を共にしており、度々ラーメンの奢りを賭けたゲームを提案している。組織での位置は彼女と同程度。しかし実は幹部クラスの実力を持っており、実際に昇進の話も出たことがあるが、それを蹴って現場での仕事を選んだ。常に変化する渋谷を眺めることを好むためである。棒付きキャンディー（彼曰く「ロリポップではなくあんこ玉」）をいつも持っている。話す時は「だヨ」など、いつも語尾がカタカナ調。"}],"source":"bangumi","sourceCharacterId":"88883"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/9051045cf97691a1a952750714c06bce6c51a1868bdac7fa353f305430d6f8e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf6b82b2fea16853f1c8194350cb87af085b0fcf611d04ce27469e315d19641e.webp","width":132,"height":256,"source":"static-detail"},"actors":[{"creditedName":"勝杏里","creatorId":"vndb:s4899","sourcePersonId":"vndb:s4899","canonicalEntityId":"vndb:s4899","name":"勝 杏里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320462:88883:9447:1","source":"bangumi"}]},{"characterId":"char_bangumi_88886","characterName":"ミナミモト ショウ","sourceIds":{"bangumi":[{"characterId":"88886","match":"source-roster","subjectId":"219"},{"characterId":"88886","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"ミナミモト ショウ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0223"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"冷酷で凶暴な一面を持つが、高い知能を持つ18歳の青年。よく巨大なオブジェを造る（見た目は完全にゴミの山である）ため、ネクにオブジェ死神と呼ばれる。最年少で大出世を果たした過去を持つが、協調性は0に等しい。数学マニアで会話には数学用語が頻出し、「ゼタ遅ぇ」「このヘクトパスカルが！」などが口癖。又、「お前ら全員ここで4ね（しね）！」等と、数字を誤字として用いられる場合も見られる。たまにメガホンで叫ぶ。"}],"source":"bangumi","sourceCharacterId":"88886"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c909e1833e7cf9aa0c9f78f56c9e84c61f4b5c164304ce69a64af5eb723c8c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12d3864a0ac1e1b691fb46b107007232c33cc299e03f2722677d2a506a80c9eb.webp","width":91,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_94411","characterName":"Rindo Kanade","sourceIds":{"bangumi":[{"characterId":"94411","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"Rindo Kanade","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1020"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ＵＧで行われている死神のゲームの参加者。スマホで様々な情報を見るのが好きな男子高校生。周囲の空気を読んで行動する性格で、積極的に人と関わろうとはしないが拒絶することもない。わけがわからないまま突然ゲームに参加させられ、チーム「ツイスターズ」のリーダーとなる。"}],"source":"bangumi","sourceCharacterId":"94411"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcc95ece32ce35a21b44b2f64f668c9de81a8f0fa952f29d182ff30effb18d79.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e3298fff98006ccb74c91e7f361a5550d866da8b2607936361810dc1fc038ab.webp","width":110,"height":256,"source":"static-detail"},"actors":[{"creditedName":"内田雄馬","creatorId":"vndb:s11606","sourcePersonId":"vndb:s11606","canonicalEntityId":"vndb:s11606","name":"内田雄馬","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320462:94411:15390:1","source":"bangumi"}]},{"characterId":"char_bangumi_94412","characterName":"Tosai \"Fret\" Furesawa","sourceIds":{"bangumi":[{"characterId":"94412","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"Tosai \"Fret\" Furesawa","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0420"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"リンドウと同級生のお調子者で、ともに死神のゲームに参加する。人と楽しく会話することが好きで、誰とでも打ち解けられる特技を持つ。一方で重苦しい空気を嫌い、真面目な話し合いは無意識に避けている。適度にノリがよく、渋谷散策に付き合ってくれるリンドウとはいい友人関係。"}],"source":"bangumi","sourceCharacterId":"94412"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c29701bedf249e8497767985f4080a215f18054937ee9867ff52a0764d64b7a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/322edd2a82c4068928adb40e38fa6193ecbcbc79ece69b70d2c5fcd51935cea4.webp","width":119,"height":256,"source":"static-detail"},"actors":[{"creditedName":"沢城千春","creatorId":"vndb:s8016","sourcePersonId":"vndb:s8016","canonicalEntityId":"vndb:s8016","name":"沢城 千春","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320462:94412:19523:1","source":"bangumi"}]},{"characterId":"char_bangumi_94413","characterName":"Nagi Usui","sourceIds":{"bangumi":[{"characterId":"94413","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"Nagi Usui","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0727"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"死神のゲームの参加者。渋谷在住の女子大生だが、見た目からは中学生と間違われることもある。趣味への情熱に溢れ、趣味のために生きているといっても過言ではない日々を送っていた。他人の心の動きを見極めるのが得意で、真意のわからない上辺だけの対応をする者には冷やか。"}],"source":"bangumi","sourceCharacterId":"94413"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f86a922582bc955ffbb96342dae6f661be34b1468eceee5d5e33de00e74b4b9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff4b7495425ce9652f59a5e4ad75e89575b1360a1d0421978c0371362ebed1ce.webp","width":86,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_99053","characterName":"Susukichi","sourceIds":{"bangumi":[{"characterId":"99053","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"Susukichi","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1013"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"死神のゲームの参加者。チーム『ルーイン』に属している。"},{"spoiler":false,"text":"巨大な身体に鋭い眼光ながら、少年のように高い声を持ち、まくし立てるように喋る。"},{"spoiler":false,"text":"彼がもっとも愛するゲーム『リバーシ』のように、その性格や考え方も白黒ハッキリしている 。"}],"source":"bangumi","sourceCharacterId":"99053"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a30a1308342ed1697a33a0e8ed3420e72437c460cfc130f3c713c367f1614a43.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe0a5fd746f8122ddbbf98b312a3964fafff0068913fddb9537274c29c6751ab.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花江夏樹","creatorId":"vndb:s2180","sourcePersonId":"vndb:s2180","canonicalEntityId":"vndb:s2180","name":"ペロペロンチーノ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320462:99053:7772:1","source":"bangumi"}]},{"characterId":"char_bangumi_99054","characterName":"Tsugumi Matsunae","sourceIds":{"bangumi":[{"characterId":"99054","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"Tsugumi Matsunae","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0101"}},"descriptions":[{"segments":[{"spoiler":false,"text":"死神のゲームの参加者。チーム『ルーイン』に属してはいるが他人との交流はほぼ皆無で、誰かと会話している様子すらない。"},{"spoiler":false,"text":"見た目とは裏腹に高いサイキック能力を持ち、参加者同士の戦いでは負け知らず。"},{"spoiler":false,"text":"常に連れているぬいぐるみは、現在渋谷で話題のブランド『ガット・ネーロ』の黒猫キャラクターに酷似しているが、なぜかそのブランドが誕生するより前から所持しているという。"}],"source":"bangumi","sourceCharacterId":"99054"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6bbc46effd98064573b00ccee2bcc8a5c2a7ac238dd77de436f41662a3027957.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab3b922db105f58a61067cecc0fd32aef734168dc69b306523f6d1aec83dff4a.webp","width":86,"height":256,"source":"static-detail"},"actors":[{"creditedName":"尾崎由香","creatorId":"vndb:s17837","sourcePersonId":"vndb:s17837","canonicalEntityId":"vndb:s17837","name":"尾崎由香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320462:99054:26815:1","source":"bangumi"}]},{"characterId":"char_bangumi_99055","characterName":"Fuya Kawahara","sourceIds":{"bangumi":[{"characterId":"99055","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"Fuya Kawahara","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0314"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"死神のゲームの参加者。渋谷の暗渠を求めて散策していたところ、ゲームへと参加させられた。"},{"spoiler":false,"text":"チーム『幽川舎（ゆうせんしゃ）』のリーダーを務めるが、臆病でリーダーには不向きな性格。しかしその臆病さが、これまでゲームから脱落しなかった彼の強さでもある。"},{"spoiler":false,"text":"手に持っているのは、自分で暗渠を書き込んだ市販の地図。"}],"source":"bangumi","sourceCharacterId":"99055"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f96d56eb4cdf0515d20a7495d747d0a3de54470c622961589342df4f3d3f22e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89750052918fc17a118fcdcab937b2b628671c40320ac809dec686cd2c2877c9.webp","width":84,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中島ヨシキ","creatorId":"vndb:s11439","sourcePersonId":"vndb:s11439","canonicalEntityId":"vndb:s11439","name":"中島 ヨシキ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320462:99055:19714:1","source":"bangumi"}]},{"characterId":"char_bangumi_99056","characterName":"Kanon Tachibana","sourceIds":{"bangumi":[{"characterId":"99056","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"Kanon Tachibana","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1228"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"死神のゲームの参加者。チーム『ヴァリー』のリーダーを務める、優しく妖艶な女性。年下で新人のリンドウたちにゲームのルールを説いてくれるが、戦況を見て立場を変える狡猾な一面も。"},{"spoiler":false,"text":"彼女自身の能力は抜きん出ているわけではないものの、これまでのゲームで生き残ってきただけの知恵を備えている。"}],"source":"bangumi","sourceCharacterId":"99056"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83d731c7482f5f5d81fd3c631b84d441500fc4e83574fa3af5aaeba1d2062478.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/faa05876805bf6dc14a09ad223a95af7f55351c61b83f1e56800fc39e8900dcf.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"上坂すみれ","creatorId":"vndb:s4466","sourcePersonId":"vndb:s4466","canonicalEntityId":"vndb:s4466","name":"上坂 すみれ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320462:99056:7307:1","source":"bangumi"}]},{"characterId":"char_bangumi_99057","characterName":"Motoi","sourceIds":{"bangumi":[{"characterId":"99057","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"Motoi","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1002"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"死神のゲームの参加者。チーム『ピュアハート』のリーダーを務める、ピュアでポジティブな言動が印象的な男性。"},{"spoiler":false,"text":"優しい笑顔とビジネス用語満載ながらも詩的な言動は、周囲をやや引かせつつも楽しい空気にさせる。彼のチームは、その人柄に惹かれてなのか、人数が多く規模も大きい。"}],"source":"bangumi","sourceCharacterId":"99057"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/674914839e96c582e1a989ba9eb18a4b8f2055bdd5604702708179a7545982ba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/3594129728414c58b0f6383a2f8aa0815e9f1be4e1ea6e743173d78da03c81d3.webp","width":150,"height":256,"source":"static-detail"},"actors":[{"creditedName":"駒田航","creatorId":"vndb:s13538","sourcePersonId":"vndb:s13538","canonicalEntityId":"vndb:s13538","name":"駒田航","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320462:99057:24755:1","source":"bangumi"}]},{"characterId":"char_bangumi_99058","characterName":"Coco Atarashi","sourceIds":{"bangumi":[{"characterId":"99058","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"Coco Atarashi","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1224"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"死神の一人。原宿を中心に自由気ままに活動している女の子。死神の仕事にはほとんど興味がなく、気まぐれに渋谷の外のエリアへ出かけることも。ちゃっかり者でずる賢く、都合よく相手を騙そうとすることも多いが、一応、友達想いの面もある。"},{"spoiler":false,"text":"3年前のゲーム終了後に起こったある事件で、ネクやビイトとともに行動していた。"}],"source":"bangumi","sourceCharacterId":"99058"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edf778d47fb31f87caffb70985d63e3e401ad8bf59f0e81d5f55eecd0ac9bf8d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a95388a8f6b63acfe7e3c33dca7825cadb4e47102454caeab0ba47648ee7c214.webp","width":137,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高野麻里佳","creatorId":"vndb:s12286","sourcePersonId":"vndb:s12286","canonicalEntityId":"vndb:s12286","name":"高野麻里佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320462:99058:16031:1","source":"bangumi"}]},{"characterId":"char_bangumi_99059","characterName":"Shiba Miyakaze","sourceIds":{"bangumi":[{"characterId":"99059","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"Shiba Miyakaze","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0621"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"現在の渋谷UGで、死神のトップに君臨する男。"},{"spoiler":false,"text":"わずか1年足らずで渋谷のゲームマスターの座にまで上り詰め、チーム同士が争う新ルールの死神ゲームを仕掛ける。常に熱いゲーム展開を心から望んでいる。"},{"spoiler":false,"text":"他の死神に比べ彼のサイキックの力は別格で、周囲に逆らう者はいない。"}],"source":"bangumi","sourceCharacterId":"99059"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/732d690eb314bd239915c939c758eca2416a5699a6d7b2e180247de70ad2fd73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/3505a25999ef3d0a49e68faeffa4ea74d0c846458381118ace94930fd95f119a.webp","width":81,"height":256,"source":"static-detail"},"actors":[{"creditedName":"濱野大輝","creatorId":"vndb:s8320","sourcePersonId":"vndb:s8320","canonicalEntityId":"vndb:s8320","name":"濱野大輝","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320462:99059:19515:1","source":"bangumi"}]},{"characterId":"char_bangumi_99060","characterName":"Tanzo Kubo","sourceIds":{"bangumi":[{"characterId":"99060","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"Tanzo Kubo","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0815"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"死神のゲームを運営する死神の一人。監視業務のほか、参加者の敗北認定など細かい処理を担当している。"},{"spoiler":false,"text":"ヒマなことも多いのか、リンドウたちの前に現れては好き勝手に話をしていく。"},{"spoiler":false,"text":"他の死神や参加者たちを見下しているのが言動に表れており、彼を好ましく思わない者は多い。唯一、死神のリーダーであるシイバには愛想よく接している。"}],"source":"bangumi","sourceCharacterId":"99060"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03bdf202b8b1fe8b86bdec07ee87007769f2dfe59414ef39f3aaefeb4f4a4518.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/6526832fa952e0842ddd2fc4646993e7a8bdec776c168190392dda02fe1f1c52.webp","width":153,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中野泰佑","creatorId":"vndb:s21959","sourcePersonId":"vndb:s21959","canonicalEntityId":"vndb:s21959","name":"熱波整","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320462:99060:42420:1","source":"bangumi"}]},{"characterId":"char_bangumi_99061","characterName":"Ayano Kamachi","sourceIds":{"bangumi":[{"characterId":"99061","match":"source-roster","subjectId":"320462"}]},"originalCharacterName":"Ayano Kamachi","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0518"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"死神のゲームを運営する死神の一人。いわゆる死神の幹部であり、能力も高くリーダーのシイバから信頼されている。"},{"spoiler":false,"text":"他者に対して冷たく容赦のない言動をとるが、同じ死神のショウカにだけは態度が違い、妹のようにかわいがっている。その様子は怖いほど甘い。"}],"source":"bangumi","sourceCharacterId":"99061"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edcdfd891cefe939e1b7a512e2f4bffc06b03cfd910f38436e80e81ad2856925.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22ad28b741130f9c55e1094cd320a72a5172d2ae4f4