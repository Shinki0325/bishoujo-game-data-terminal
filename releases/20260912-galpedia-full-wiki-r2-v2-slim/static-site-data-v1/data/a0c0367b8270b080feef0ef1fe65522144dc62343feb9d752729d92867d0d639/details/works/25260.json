s.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61a65db8c6e7681840406eb95c0750b179c7d71019b93a5739b64b3112edb22e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"四葉 ヨウ","creatorId":"vndb:s24032","sourcePersonId":"vndb:s24032","canonicalEntityId":"vndb:s24032","name":"四葉ヨウ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74129","source":"vndb"}]},{"characterId":"char_c62584","characterName":"沖名 誠司","sourceIds":{"bangumi":[{"characterId":"54496","match":"exact-normalized-name-in-linked-work","subjectId":"214100"}],"egsCharacterIds":["17885"],"vndbCharacterId":"c62584"},"originalCharacterName":"沖名 誠司","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young man who came back to his hometown to find out the truth behind his mother's death."}],"source":"vndb","sourceCharacterId":"c62584"},{"segments":[{"spoiler":false,"text":"母である明の死の真相を探るべく、数年ぶりに故郷の村、散吉郷へと帰って来た青年。"},{"spoiler":false,"text":"昔は根暗で内向的な性格をしていた影響から気が知れた相手の前では普通に会話が出来るものの、見知らぬ他人と接するのは、あまり得意ではない。"},{"spoiler":false,"text":"父親である帝とは、距離を置いていたためどう接していいか分からず、今では別々に住んでいる。"}],"source":"egs","sourceCharacterId":"17885","sourceWorkId":"25260","spoiler":false},{"segments":[{"spoiler":false,"text":"母の死の真相を探るために帰郷した青年。昔は内向的だったため、気心の知れた人とは会話が出来るが、見知らぬ他人との交流は苦手。"}],"source":"bangumi","sourceCharacterId":"54496"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e61e1bf6c7ced0ced15ae149f4378840f6dd304a352d3e87589e436fc9db1c60.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d83435bb90f193524693a0065db630330fd1b540ec108c822f02445cd4769d7.webp","width":178,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c62585","characterName":"御石 美衣奈","sourceIds":{"bangumi":[{"characterId":"54497","match":"exact-normalized-name-in-linked-work","subjectId":"214100"}],"egsCharacterIds":["17880"],"vndbCharacterId":"c62585"},"originalCharacterName":"御石 美衣奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Seiji's childhood friend and her home is where Seiji lives. A gentle, bright, and popular regardless of gender."}],"source":"vndb","sourceCharacterId":"c62585"},{"segments":[{"spoiler":false,"text":"誠司と同じ三年生であり、幼馴染の一人。"},{"spoiler":false,"text":"少し天然で明るくお人よしで、誰からも好かれやすく気がつくと輪の中心にいるような人望を持つ。"},{"spoiler":false,"text":"時折り動物達と会話するように接し、ガーデニングが趣味で、自宅に豪華な庭園を造ってしまうほど。"},{"spoiler":false,"text":"誠司とは親子間の交流があり、その関係もあって彼女の家へ居候することになる。"}],"source":"egs","sourceCharacterId":"17880","sourceWorkId":"25260","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が居候する家の娘で幼なじみ。優しくて明るく男女を問わず人気があるが、動物に話しかけるなど、やや天然な一面もある。"}],"source":"bangumi","sourceCharacterId":"54497"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f62d7f604888d2e347c364acf438753535a6c695e9cabeb831c6d53d8f011b7a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/262621788687dac8a1d5dd52b1ae1fe1cf3b86bc1590d6ed60f8fcd7c9746a95.webp","width":178,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏目みつ華","creatorId":"vndb:s15376","sourcePersonId":"vndb:s15376","canonicalEntityId":"vndb:s15376","name":"夏目 みつ華","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:214100:54497:56075:1","source":"bangumi"}]},{"characterId":"char_c62586","characterName":"火鼠谷 杏子","sourceIds":{"bangumi":[{"characterId":"54499"