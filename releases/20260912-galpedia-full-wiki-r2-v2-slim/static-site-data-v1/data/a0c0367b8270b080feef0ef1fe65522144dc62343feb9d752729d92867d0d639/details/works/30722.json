umi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"◆西布亚（Shibuya）"},{"spoiler":false,"text":"她作为炼金术师，负责合成道具。"},{"spoiler":false,"text":"不同于她的外貌，其实她还很懵懂，还不太懂色色的事。"},{"spoiler":false,"text":"在原来的世界里，学校内地位最高，有很多朋友。"},{"spoiler":false,"text":"很受男生欢迎，在校内受到过多次告白。"},{"spoiler":false,"text":"由于外表是涩谷(Shibuya)系辣妹，有着西布亚的戏称。"}],"source":"bangumi","sourceCharacterId":"139058"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/609d9bb57a78b60627b06ea9db3ee3375ced5f78d1839b4124b4449e10e92940.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd75ce751c43a650f0fc35dda5c648adec3cabddbc363184ff685b15bdc83018.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_139059","characterName":"乳ウシ","sourceIds":{"bangumi":[{"characterId":"139059","match":"source-roster","subjectId":"331757"}]},"originalCharacterName":"乳ウシ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"◆奶牛"},{"spoiler":false,"text":"她作为占卜师，会给予玩家对冒险有帮助的信息。"},{"spoiler":false,"text":"在原来的世界里，是住在修人家附近的发小后辈。"},{"spoiler":false,"text":"自O学O年级起胸开始渐渐变大，如今拥有在学校里独占鳌头的巨乳。"},{"spoiler":false,"text":"遭男生调戏冠以戏称，那名字不知怎么的就固定了，叫奶牛。"}],"source":"bangumi","sourceCharacterId":"139059"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58f88091707f081baff32ca017fe4eb33ab1002bfdc87e4cc7d4afa9cc21abaa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15d04673c854f13f93696782ad99153e79ba01b3cb62b4fce64dbc4d35de55f1.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_139060","c