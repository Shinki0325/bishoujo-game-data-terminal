redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"19"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"19歳の予備校生。チラシ配りの少女。"},{"spoiler":false,"text":"可愛らしく、純情で処女。"},{"spoiler":false,"text":"自分の内気な性格を直す為に、チラシ配りのバイトを試みた。"},{"spoiler":false,"text":"しかし、思うような改善が見られない。"},{"spoiler":false,"text":"主人公はある日、蹴鞠についキスをしてしまう。"},{"spoiler":false,"text":"蹴鞠は驚くが、自分の性格を直せるかもしれないと、主人公との性行為を求めてくるが……。"}],"source":"egs","sourceCharacterId":"16185","sourceWorkId":"11659","spoiler":false},{"segments":[{"spoiler":false,"text":"予備校に通っている女の子。"},{"spoiler":false,"text":"自分に自信が無く、もっと強くなりたいと願っている。"},{"spoiler":false,"text":"何故か七郎太に親近感を覚える。"}],"source":"bangumi","sourceCharacterId":"206572"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fa3120325d301252c82c75e4467bec8c48c9dd384e2b1ef0bd414683783e4be.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a843276bcbe7a3397e823998eb3b21b75a5bc0e28a4c106c1babbba2e4284a6b.webp","width":137,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川知子","creatorId":"vndb:s694","sourcePersonId":"vndb:s694","canonicalEntityId":"vndb:s694","name":"ひむろゆり(氷室百合)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230333:206572:5924:1","source":"bangumi"}]},{"characterId":"char_c23833","characterName":"能貴 夏津未","sourceIds":{"bangumi":[{"characterId":"206571","match":"exact-normalized-name-in-linked-work","subjectId":"230333"}],"egsCharacterIds":["16184"],"vndbCharacterId":"c23833"},"originalCharacterName":"能貴 夏津未","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"20"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"コンビニで働いているフリーター。活発な性格。20歳。"},{"spoiler":false,"text":"コンビニ強盗を撃退した主人公に興味を持つようになる。"},{"spoiler":false,"text":"夏津未には、憧れている空手部の先輩がいるが、その男は夏津未をセッ○スフレンドとしか認識していない。"},{"spoiler":false,"text":"悩む夏津未は、主人公に色々と相談するうちに、男と女の関係に至ってしまう。"}],"source":"egs","sourceCharacterId":"16184","sourceWorkId":"11659","spoiler":false},{"segments":[{"spoiler":false,"text":"父親が経営しているコンビニを手伝っている。"},{"spoiler":false,"text":"快活な性格で、元気な挨拶が自慢。"},{"spoiler":false,"text":"空手の有段者で、後ろ回し蹴りが得意。"},{"spoiler":false,"text":"自分の男勝りな性格が、少し嫌い。"}],"source":"bangumi","sourceCharacterId":"206571"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c05657f8fbc0923aa58c7e16151855fdbdd8848d3e816fa26ffdb73147481f9a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e77ce53c0c6abecbee52cc0a7dc9b73d4ef504f8dabfb8a640c449b7840dd9a0.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"平野響子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230333:206571:5669:1","source":"bangumi"}]},{"characterId":"char_c23834","characterName":"奥乃手 真樹","sourceIds":{"bangumi":[{"characterId":"206568","match":"exact-normalized-name-in-linked-work","subjectId":"230333"}],"egsCharacterIds":["16183"],"vndbCharacterId":"c23834"},"originalCharacterName":"奥乃手 真樹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「うるおい荘」の住人。部屋は1号室。"},{"spoiler":false,"text":"人妻。淑やか性格。"},{"spoiler":false,"text":"旦那とは別居中で、一人息子とも離れて暮らしている。"},{"spoiler":false,"text":"大学生である主人公に興味津々な様子で、身体を使っ