2785","source":"vndb"},{"creditedName":"よっしー","creatorId":"vndb:s31352","sourcePersonId":"vndb:s31352","canonicalEntityId":"vndb:s31352","name":"よっしー","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:152786","source":"vndb"},{"creditedName":"仁井 豊太郎","creatorId":"vndb:s35182","sourcePersonId":"vndb:s35182","canonicalEntityId":"vndb:s35182","name":"仁井豊太郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:152787","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c77097","characterName":"雨津 ユカリ","sourceIds":{"vndbCharacterId":"c77097"},"originalCharacterName":"雨津 ユカリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"G"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Tatarigami who dropped out of the Divine Education Act."},{"spoiler":false,"text":"She enjoys physical contact with people and will come on pretty strongly, but always brings misfortune to the objects of her affection."},{"spoiler":false,"text":"Originally she was enshrined in the big city, but unable to face the feelings of terror she caused around her, she escaped to Kamimori City and met Akira."},{"spoiler":false,"text":"After scaring so many people she loved through her curse, her heart is deeply wounded."},{"spoiler":false,"text":"When Akira doesn't fear her curse at all, she feels they are destined to be together, but her profound love creates a darkness when she sees Akira being tempted away from her by Shion and Kaede."},{"spoiler":false,"text":"She loves him so deeply it's hard to control her feelings, and sometimes she acts a little scary."},{"spoiler":false,"text":"She's obsessed with him and much of everything she does is focused around him somehow."},{"spoiler":false,"text":"She feels a little bad about insinuating herself into his life and trying to force him to act like newly-weds, but she just can't hold back her joy at finding someone she feels destined to be with."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c77097"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b237984976254202749008866a7b6488d1ef78a95baa54be1bdb7a97dad296a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5c8cbc42b7e39f510edfc98c5824d088fd1bb51f7b4d8eb8f73525f8f23ec83.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南里 一花","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:79494","source":"vndb"}]},{"characterId":"char_vndb_c77098","characterName":"真瀬 彰","sourceIds":{"vndbCharacterId":"c77098"},"originalCharacterName":"真瀬 彰","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c77099","characterName":"未園 シオン","sourceIds":{"vndbCharacterId":"c77099"},"originalCharacterName":"未園 シオン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"height":{"reviewState":"source-only","source":"vndb","value":"154"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Goddess of misfortune who arrived in Kamimori City not long before Yukari."},{"spoiler":false,"text":"She'll do anything she can, including helping out the elderly, for a price (usually vegetables or snacks)."},{"spoiler":false,"text":"The elderly people in the area are pretty fond of her as a result, even if she is a Goddess of misfortune."},{"spoiler":false,"text":"She's generally cheerful and positive, and doesn't take a whole lot seriously, except for money. She pinches every single penny she can get her hands on."},{"spoiler":false,"text":"From the moment she set eyes on the main character she considered it a foregone conclusion they would be together and started making advances on him."},{"spoiler":false,"text":"This makes her a troublemaker, as she has no problem trying to seduce him in front of Yukari and Kaede."},{"spoiler":false,"text":"She blames the fact that she's not as curvy as the other Goddesses on the fact that she's the Goddess of misfortune, and therefore got shortchanged in that department too."}],"source":"vndb","sourceCharacterId":"c77099"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a883047d21ba0b69712ff02cfeb81caa8de1211a7def201515539ccc295e82dc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3d7eae8f9c197cf7dfd33cc6dd6fc3681d5e3583c1f31cfb22116b76006a6e3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"上原 あおい","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:79492","source":"vndb"}]},{"characterId":"char_vndb_c77100","characterName":"静森 カエデ","sourceIds":{"vndbCharacterId":"c77100"},"originalCharacterName":"静森 カエデ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"H"},"height":{"reviewState":"source-only","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A former Tatarigami who descended to Earth following the Divine Education Act."},{"spoiler":false,"text":"Where she used to bring calamity to Kamimori City, now she is worshipped at the local shrine."},{"spoiler":false,"text":"Her love for Akira after meeting him only helps to cure her curse, and she is revered as a protectorate of the city."},{"spoiler":false,"text":"She's calm and even-tempered now, and tries to not bring up her dark past as a wild Tatarigami."},{"spoiler":false,"text":"She's voluptuous like a pin-up model."},{"spoiler":false,"text":"She doesn't hide her affections for Akira, but gets shy about sexual matters."},{"spoiler":false,"text":"This makes her feel a little jealous about how easily Shion latches onto him or Yukari tries to consummate the marriage she imagines for them."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c77100"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59107fe135897acd508be6e9ce8164052385ce985e10ec6887f7a795f40dbb64.webp","fallbackUrl":"htt