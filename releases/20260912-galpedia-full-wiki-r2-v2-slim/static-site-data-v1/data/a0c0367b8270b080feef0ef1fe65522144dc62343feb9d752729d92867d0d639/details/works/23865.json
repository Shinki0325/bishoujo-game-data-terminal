nId":"vndb:vn-staff:131664","source":"vndb"},{"creditedName":"禾 刀郷","creatorId":"vndb:s7796","sourcePersonId":"vndb:s7796","canonicalEntityId":"vndb:s7796","name":"禾 刀郷","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:131665","source":"vndb"},{"creditedName":"しまさらゆめき","creatorId":"vndb:s9293","sourcePersonId":"vndb:s9293","canonicalEntityId":"vndb:s9293","name":"しまさらゆめき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:131666","source":"vndb"},{"creditedName":"aina","creatorId":"vndb:s9294","sourcePersonId":"vndb:s9294","canonicalEntityId":"vndb:s9294","name":"aina","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:131667","source":"vndb"},{"creditedName":"グランテール井上","creatorId":"vndb:s9295","sourcePersonId":"vndb:s9295","canonicalEntityId":"vndb:s9295","name":"グランテール井上","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:131668","source":"vndb"},{"creditedName":"大木 犬太郎","creatorId":"vndb:s10273","sourcePersonId":"vndb:s10273","canonicalEntityId":"vndb:s10273","name":"大木 犬太郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:131669","source":"vndb"}]},"cast":[{"characterId":"char_c49937","characterName":"斯波 将覧","sourceIds":{"bangumi":[{"characterId":"46835","match":"exact-normalized-name-in-linked-work","subjectId":"185496"}],"egsCharacterIds":["10598"],"vndbCharacterId":"c49937"},"originalCharacterName":"斯波 将覧","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"武士道を奉じ、弱きを助け強きをくじく正義感を持った男児。"},{"spoiler":false,"text":"しかし、とにかくおつむが頓珍漢で、お馬鹿すぎる困った子。"},{"spoiler":false,"text":"根拠のない自信と善意とやる気が満ちあふれているため、毎日が楽しそうである。"},{"spoiler":false,"text":"異邦の領主の嫡流らしいのだが、あまりにも馬鹿なために家元より放り出されている。"},{"spoiler":false,"text":"事ある毎にお馬鹿さ加減を発揮して、事態が悪化の一途を辿るのだが、時にはそのお馬鹿さ加減が昏迷した状況を切り開くきっかけになったりもする。"}],"source":"egs","sourceCharacterId":"10598","sourceWorkId":"23865","spoiler":false},{"segments":[{"spoiler":false,"text":"武士道を奉じ、弱きを助け強きをくじく正義感を持った男児。"},{"spoiler":false,"text":"しかし、とにかくおつむが頓珍漢で、お馬鹿すぎる困った子。"},{"spoiler":false,"text":"根拠のない自信と善意とやる気が満ちあふれているため、毎日が楽しそうである。"},{"spoiler":false,"text":"異邦の領主の嫡流らしいのだが、あまりにも馬鹿なために家元より放り出されている。"},{"spoiler":false,"text":"事ある毎にお馬鹿さ加減を発揮して、事態が悪化の一途を辿るのだが、"},{"spoiler":false,"text":"時にはそのお馬鹿さ加減が昏迷した状況を切り開くきっかけになったりもする。"},{"spoiler":false,"text":"「はっはっは。 よきに計らえ……」"}],"source":"bangumi","sourceCharacterId":"46835"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"46835","value":"侍"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4f88f87a34fe00a5ecc134e5c5ab5ba5ebe3c703717488956a852538aba1aa5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e87073890aa17dead7c0d7c322c4e5f2ff0cee5ee138ddef33995ce27d9aa258.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"須藤翔","creatorId":"vndb:s4816","sourcePersonId":"vndb:s4816","canonicalEntityId":"vndb:s4816","name":"やじまのぼる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185496:46835:19281:1","source":"bangumi"}]},{"characterId":"char_c49939","characterName":"ハクメイ丸","sourceIds":{"bangumi":[{"characterId":"46837","match":"exact-normalized-name-in-linked-work","subjectId":"185496"}],"egsCharacterIds":["10600"],"vndbCharacterId":"c49939"},"originalCharacterName":"ハクメイ丸","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"褐色肌のエルフ。ダークエルフではないのでそう言われると死んだ目になってじめじめと落ち込む。髪型はポニーテール、猫のような眼で、体が非常に柔軟であり、これも猫のよう。黙っていれば可憐な美少女なのだが、表情がころころ変わり、崩れ顔、変顔を見せることが多い残念美人。性格は一見生真面目、付き合ってみると怖がりでいささか常識を欠いていて、アグレッシブなマゾ気質であることが判明する。職業はニンジャ。戦闘術、体術に長けて攻撃力も回避力も高い。鍵や罠の解除、索敵などもこなす、戦士と盗賊を合わせてもっと強くしたような上級職。ただし魔法に対しての素養はない。"},{"spoiler":false,"text":"忍術技に関してはマスタークラスなのだが、彼女は「とかく怖い考えにとらわれがち」であるため、忍んでいられない。"}],"source":"egs","sourceCharacterId":"10600","sourceWorkId":"23865","spoiler":false},{"segments":[{"spoiler":false,"text":"語尾が「～であります」的なエセ軍人口調の少女。 ただ、そこまで堅くはない。"},{"spoiler":false,"text":"生真面目な印象だが、実は怖がりでいささか常識を欠いているところがある。"},{"spoiler":false,"text":"またアグレッシブなマゾ気質で、時に “いじめてほしい衝動” に駆られる。"},{"spoiler":false,"text":"将覧を主君と定め、“忠義一徹” を貫いている。"},{"spoiler":false,"text":"……と言えば聞こえは良いが、実態は彼に依存しており、長く離れると不安定になる。"},{"spoiler":false,"text":"ニコライトのことは、良き同志と信頼している。"},{"spoiler":false,"text":"「自分は、も、もう耐えられないでありますうっひゃあああーーーっ！」"}],"source":"bangumi","sourceCharacterId":"46837"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"46837","value":"忍者"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fa2005939dca688d0ebf32b629adbfaab7e22a2099bf9850e7d723ab81332ba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8dcdb5d2f9ea692d2b80a4f8d2052ec697c7318d826ec922b2426d025cc4f653.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185496:46837:5936:1","source":"bangumi"}]},{"characterId":"char_c49941","characterName":"ニコライト・ペルシャイド","sourceIds":{"bangumi":[{"characterId":"46836","match":"exact-normalized-name-in-linked-work","subjectId":"185496"}],"egsCharacterIds":["10599"],"vndbCharacterId":"c49941"},"originalCharacterName":"ニコライト・ペルシャイド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"波打ち豊かな髪の、世慣れていて、艶めかしい美女。物言いは、乱暴のような、それでいて柔らかな、物がわかった姐さん風。性格は達観と強欲を同居させた、熟練の冒険者。がめつい火事場泥棒……とも言えなくもない。パーティの世話役＆ご意見番。立ち位置的に突っ込みをすることも多い（彼女自身も問題行動を多々起こすのだが）。"},{"spoiler":false,"text":"職業としては魔法職に位置するのだが、呪文は使わず錬金術の秘薬でもって魔法効果を発動させる。攻撃も補助も回復もこなすオールラウンダーだが、物理攻撃力的にはまあそれなりというところ。ただし攻撃魔法に関しては、単体攻撃魔法は使用できず、ほぼ全てが範囲攻撃となる上に威力の手加減もできない。"}],"source":"egs","sourceCharacterId":"10599","sourceWorkId":"23865","spoiler":false},{"segments":[{"spoiler":false,"text":"物言いは乱暴のような、それでいて柔らかな、物がわかった姐さん風。"},{"spoiler":false,"text":"性格は達観と強欲を同居させた 熟練の冒険者タイプ。"},{"spoiler":false,"text":"将覧やハクメイ丸には呆れ加減な口を利きつつも、姐さん女房的に世話を焼く。"},{"spoiler":false,"text":"立ち位置的にツッコミをすることも多い（彼女自身も問題行動を多々起こすのだが）。"},{"spoiler":false,"text":"職業は魔法職で、攻撃も補助も回復もこなすオールラウンダー。"},{"spoiler":false,"text":"ただし攻撃魔法は単体を狙えず、ほぼ全てが範囲攻撃となるうえに加減もできない。"},{"spoiler":false,"text":"「待って旦那止まって、旦那いかないでえええっ！」"}],"source":"bangumi","sourceCharacterId":"46836"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"46836","value":"アルケミスト"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7e6a9c5f5a74bc97f5a6260031ca3a03d6dcfbd8f108e0df28e522dd941e36a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2f078a4b854a4f492a427a755d5e2b344103e88fc08da47214193affd80769e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"栗原雅子","creatorId":"vndb:s298","sourcePersonId":"vndb:s298","canonicalEntityId":"vndb:s298","name":"野月 まひる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185496:46836:6570:1","source":"bangumi"}]},{"characterId":"char_c49942","characterName":"黒塚","sourceIds":{"bangumi":[{"characterId":"46838","match":"exact-normalized-name-in-linked-work","subjectId":"185496"}],"egsCharacterIds":["10601"],"vndbCharacterId":"c49942"},"originalCharacterName":"黒塚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"途中からパーティに加入する、絶世の美少女。将覧と似通った意匠の装具を身に着けており、どこやら彼の事をずっと以前から見知っていたような口をきく。将覧の方もこの少女に対して何やら既知感を抱く。性格は良くも悪くも浮世離れ、人間離れしており、人を辟易とさせることもしばしば。"},{"spoiler":false,"text":"パーティ内のクラスとしては弓手。ずば抜けた、神がかった技量を示す。"}],"source":"egs","sourceCharacterId":"10601","sourceWorkId":"23865","spoiler":false},{"segments":[{"spoiler":false,"text":"後からパーティに加入する、絶世の美少女。"},{"spoiler":false,"text":"良くも悪くも浮世離れ・人間離れした性格で、人を辟易とさせることもしばしば。"},{"spoiler":false,"text":"クラスとしては弓手。 ずば抜けた神がかった技量を示す。"},{"spoiler":false,"text":"将覧と似た意匠の装具を身に着けており、将覧のことを以前から知っている様子。"},{"spoiler":false,"text":"一方で将覧も、この少女に対しては何やら既知感を抱くことになる。"},{"spoiler":false,"text":"「む。 これはまぐわいの気配！」"}],"source":"bangumi","sourceCharacterId":"46838"}],"profileFacts":[{"label":"職業","source":"bangumi","sourceCharacterId":"46838","value":"弓兵？"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75807d2bfbd19fba3a40c12a58f0b2a49c2bab6ced2f752e28ec523e0fa16015.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8ee6087a97d2ebf2662ceb6e8f14dfed355e387911b25ee1c298b7e3a6513835.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神保巴","creatorId":"vndb:s455","sourcePersonId":"vndb:s455","canonicalEntityId":"vndb:s455","name":"神保 巴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185496:46838:12718:1","source":"bangumi"}]},{"characterId":"char_c49943","characterName":"アーテ・クロイツナッハ","sourceIds":{"bangumi":[{"characterId":"46840","match":"exact-normalized-na