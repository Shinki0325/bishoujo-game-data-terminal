56,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:279484:144577:4799:1","source":"bangumi"}]},{"characterId":"char_c25448","characterName":"ルーシー","sourceIds":{"bangumi":[],"egsCharacterIds":["25652"],"vndbCharacterId":"c25448"},"originalCharacterName":"ルーシー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のハメ撮り仲間。"},{"spoiler":false,"text":"巨乳。"},{"spoiler":false,"text":"プロの変態として、調教などを手伝う。"},{"spoiler":false,"text":"本名「留子」。本名連呼はタブー。"}],"source":"egs","sourceCharacterId":"25652","sourceWorkId":"7480","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/628ef4b6cf3156b7cda44b266af854e59c28b4f7d11626d523a358a78fc6174f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/829353b58a5ad167074f0a5352460e93c35b6676674498c3bea9e949d63de7ec.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平野 響子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"藤本 教子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22759","source":"vndb"}]},{"characterId":"char_c25450","characterName":"芦屋　麻亜子","sourceIds":{"bangumi":[{"characterId":"144578","match":"exact-normalized-name-in-linked-work","subjectId":"279484"}],"egsCharacterIds":["25651"],"vndbCharacterId":"c25450"},"originalCharacterName":"芦屋　麻亜子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"生意気で小悪魔な性格。三姉妹の三女。"},{"spoiler":false,"text":"男の肉体に強い関心を持つ、お年頃。"},{"spoiler":false,"text":"人畜無害な“フリ”をしている主人公を拘束。"},{"spoiler":false,"text":"三人の親友とやりたい放題する。"},{"spoiler":false,"text":"ただ、挿入やキスはしない。"}],"source":"egs","sourceCharacterId":"25651","sourceWorkId":"7480","spoiler":false},{"segments":[{"spoiler":false,"text":"三姉妹の末娘。生意気＆小悪魔系。同時にゆかりにもっとも懐いている。今、最大の関心ごとは「男のカラダ」。"},{"spoiler":false,"text":"麻亜子には三人の親友がいる。人畜無害なふりをして下宿を始めた主人公を、彼女たちは格好の獲物とみなし、主人公を拘束し、逆○○○に及ぶ。最初から挿入やキスには至らないが、それ以外はやりたい放題。"},{"spoiler":false,"text":"【濡れ場傾向】"},{"spoiler":false,"text":"おませっ子軍団・集団逆○○○"}],"source":"bangumi","sourceCharacterId":"144578"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"25651","sourceWorkId":"7480","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"25651","sourceWorkId":"7480","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"48 cm","valueContext":null,"source":"egs","sourceCharacterId":"25651","sourceWorkId":"7480","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d20c12aff2249316904641f95f8bbd55df59e5f7f3aa1ca73b88b3afbb118fc6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cdcef1787d1971cbf4d2e9531724cf6304d3619e2864045899cbd486154cae5f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:279484:144578:4830:1","source":"bangumi"}]},{"characterId":"char_c25451","characterName":"芦屋　ゆかり","sourceIds":{"bangumi":[{"characterId":"144575","match":"exact-normalized-name-in-linked-work","subjectId":"279484"}],"egsCharacterIds":["25648"],"vndbCharacterId":"c25451"},"originalCharacterName":"芦屋　ゆかり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"芦屋家のうら若き義母。"},{"spoiler":false,"text":"主人の死後、自分の貯金を取り崩しながら一家を支えている。"},{"spoiler":false,"text":"母子家庭育ちで、重度のファザコン。"},{"spoiler":false,"text":"亡き夫の手により、心身共にM女に調教済み。"},{"spoiler":false,"text":"成熟しながらも性欲に飢えた肉体を、"},{"spoiler":false,"text":"主人公にたっぷり調教されることになる。"}],"source":"egs","sourceCharacterId":"25648","sourceWorkId":"7480","spoiler":false},{"segments":[{"spoiler":false,"text":"歳若き義母。夫とは三十も歳が離れていた。母子家庭で育った私生児のため、重度のファザコン。芦屋家主人は、結婚後急死。今は自分の貯金を取り崩しつつ一家を支えている。"},{"spoiler":false,"text":"夫の手で特殊な性癖に○○済。○○はメンタルな方向で進められ、今や○○の悦びに悶え泣くM人妻。夫の死後、その肉体は悶々と夜泣きしている。"},{"spoiler":false,"text":"主人公は、その熟しているくせに半処女の肉体を犯し、 たっぷり再開発することに。亡夫が乗りうつったフリをして…。"},{"spoiler":false,"text":"【濡れ場傾向】"},{"spoiler":false,"text":"寝取り／縄／乳（搾乳）"}],"source":"bangumi","sourceCharacterId":"144575"}],"profileFacts":[{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"25648","sourceWorkId":"7480","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"25648","sourceWorkId":"7480","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"25648","sourceWorkId":"7480","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea81b669d339f78e81d44770226579cb97f1cec4740d375b3b6186385ad5272d.webp","fallbackUrl":"https://wiki-assets.bishojo.