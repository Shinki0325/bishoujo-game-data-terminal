source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who suddenly appears in Kotaro's class, convinces him that both Kotaro and herself have magic powers and should form a magic club at school. She is a nice person who is friendly to everyone and is good at cooking."}],"source":"vndb","sourceCharacterId":"c55247"},{"segments":[{"spoiler":false,"text":"主人公に“魔法倶楽部”設立を持ちかけた謎の少女。"},{"spoiler":false,"text":"常に期待に満ちた眼差しで主人公を見ている。"},{"spoiler":false,"text":"何か目的があって主人公に近づいてきたようだが……。"},{"spoiler":false,"text":"「あなたのその資質を……その魔法の力を、私たちと一緒に伸ばしてみませんか？」"}],"source":"egs","sourceCharacterId":"19823","sourceWorkId":"9523","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公に「魔法倶楽部を作りませんか？」と持ちかける謎の少女。"},{"spoiler":false,"text":"なにか目的があって主人公に近づいてきたのか、常に期待の眼差しで主人公を見ている。"},{"spoiler":false,"text":"「あなたのその資質を……"},{"spoiler":false,"text":"その魔法の力を、私たちと一緒に伸ばしてみませんか？」"}],"source":"bangumi","sourceCharacterId":"147650"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c893802837bd7b81fdd161fb453e3229032284e4026506bf0003957995e2313.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/9833df84f8fba8e206c10b8a72f5a2f8f37060b44bb72863a27fd6961b9f9e6f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218187:147650:6469:1","source":"bangumi"}]},{"characterId":"char_c55248","characterName":"千石　アスカ","sourceIds":{"bangumi":[{"characterId":"147651","match":"exact-normalized-name-in-linked-work","subjectId":"218187"}],"egsCharacterIds":["19824"],"vndbCharacterId":"c55248"},"originalCharacterName":"千石　アスカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kotaro's childhood friend, she is very distrustful of the Magic Club and Kazuha's motives. She is very shy with her true feelings, and gets jealous very easily. She is later forced into officially joining the Magic Club by Saeko."}],"source":"vndb","sourceCharacterId":"c55248"},{"segments":[{"spoiler":false,"text":"真面目で素直になれない、主人公の幼馴染。"},{"spoiler":false,"text":"主人公に好意を寄せているのだが、その性格からアプローチできずにいる。"},{"spoiler":false,"text":"頼りないと思っている主人公に、保護者的な態度をとることもしばしば。"},{"spoiler":false,"text":"「ま～たやってる。小太郎、草いじりしかすることないの？」"}],"source":"egs","sourceCharacterId":"19824","sourceWorkId":"9523","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼なじみ。生真面目で素直になれない性格。"},{"spoiler":false,"text":"アスカから見ると主人公は頼りないところもあるため、つい保護者的な態度になってしまう。"},{"spoiler":false,"text":"「ま～たやってる。小太郎、草いじりしかすることないの？」"}],"source":"bangumi","sourceCharacterId":"147651"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e5196cd14e9c0a32b849fb358c267d3531a713263d955746473fbdc32034caa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82dd1f5bc1e14fce36299c7ae8cf43674c2cf7d186b1d6e32c531b3d9b5e2bed.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結下みちる","creatorId":"vndb:s794","sourcePersonId":"vndb:s794","canonicalEntityId":"vndb:s794","name":"結下 みちる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218187:147651:4705:1","source":"bangumi"}]},{"characterId":"char_c55249","characterName":"久遠時　真央","sourceIds":{"bangumi":[{"characterId":"147652","match":"exact-normalized-name-in-linked-work","subjectId":"218187"}],"egsCharacterIds":["19825"],"vndbCharacterId":"c55249"},"originalCharacterName":"久遠時　真央","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kazuha's younger sister. She is very friendly and outgoing, sometimes too much. Her acting overfamiliar with Asuka gets her in trouble sometimes. She likes to cause trouble and willingly goes along with Saeko's schemes usually."}],"source":"vndb","sourceCharacterId":"c55249"},{"segments":[{"spoiler":false,"text":"主人公を“お兄ちゃん”と慕う、一葉の妹。"},{"spoiler":false,"text":"人懐っこく好奇心旺盛な性格。"},{"spoiler":false,"text":"知らないことにはなんにでもチャレンジしたがるが……。"},{"spoiler":false,"text":"「また来ても、わたしが護るもん」"}],"source":"egs","sourceCharacterId":"19825","sourceWorkId":"9523","spoiler":false},{"segments":[{"spoiler":false,"text":"一葉の妹だが、むしろ主人公を「お兄ちゃん」と慕うようになるほど人なつっこい女の子。"},{"spoiler":false,"text":"好奇心旺盛で知らないことにはなんでもチャレンジしたがる。"},{"spoiler":false,"text":"「また来ても、わたしが護るもん」"}],"source":"bangumi","sourceCharacterId":"147652"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/806a8105ac646d3c20574fe77b370e2dd2ef4f1a5fb85b22363342de1a6f6020.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dff12f138138818bdde07a15958c2b9854cbdd1915b4cb79e3448683541ff15a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218187:147652:6409:1","source":"bangumi"}]},{"characterId":"char_c55251","characterName":"早狩　冴子","sourceIds":{"bangumi":[{"characterId":"147654","match":"exact-normalized-name-in-linked-work","subjectId":"218187"}],"egsCharacterIds":["19826"],"vndbCharacterId":"c55251"},"originalCharacterName":"早狩　冴子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The leader of the Magic CLub, and a celebrity in the school. Is always one step ahead of everyone, thus she is feared by many. Loves to tease and torment both her friends and enemies, but always has a smile on her face."}],"source":"vndb","sourceCharacterId":"c55251"},{"segments":[{"spoiler":false,"text":"どんなことでも楽しむ術を極めた上級生。"},{"spoiler":false,"text":"いつもニコニコと上機嫌な素振りを見せるが……。"},{"spoiler":false,"text":"“魔法倶楽部”の提案を聞いて、ノリノリで設立させた張本人。"},{"spoiler":false,"text":"「この私がいる以上、他のどんなクラブ活動よりも明るく楽しい学園生活を保証するわよ～」"}],"source":"egs","sourceCharacterId":"19826","sourceWorkId":"9523","spoiler":false},{"segments":[{"spoiler":false,"text":"いつもニコニコと上機嫌な上級生で、何事も楽しむ術を極めた強者。"},{"spoiler":false,"text":"一葉の突拍子もない提案を聞いて、ノリノリな感じで魔法倶楽部を設立させる張本人。"},{"spoiler":false,"text":"「この私がいる以上、"},{"spoiler":false,"text":"他のどんなクラブ活動よりも明るく楽しい学園生活を保障するわよ～」"}],"source":"bangumi","sourceCharacterId":"147654"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cb09dac3c19a5ebbb602e1de88271103399185912b6f8cfd45a552e0c5572db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aad8332f91612092bc81e41707d8ed8b05bfc04ab843686c41a05985dab68507.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218187:147654:6351:1","source":"bangumi"}]},{"characterId":"char_c55252","characterName":"伏見　瀬