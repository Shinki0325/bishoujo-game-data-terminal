","relationId":"vndb:vn-staff:67589","source":"vndb"}]},"cast":[{"characterId":"char_c43416","characterName":"水無瀬 静琉","sourceIds":{"bangumi":[{"characterId":"60718","match":"exact-normalized-name-in-linked-work","subjectId":"80907"}],"egsCharacterIds":["25506"],"vndbCharacterId":"c43416"},"originalCharacterName":"水無瀬 静琉","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本編主人公。"},{"spoiler":false,"text":"清廉潔白で有名な大物政治家の娘。"},{"spoiler":false,"text":"学校でも成績は常にトップクラスの優等生。"},{"spoiler":false,"text":"才色兼備、文武両道で、所属する弓道部では次期主将の有力候補と目されている。"},{"spoiler":false,"text":"比較的のんびりした性格で、気取らず、それでもいて凛とした空気を漂わせる美人。"},{"spoiler":false,"text":"責任感が強く、周囲からの信頼も厚い。"}],"source":"egs","sourceCharacterId":"25506","sourceWorkId":"7672","spoiler":false},{"segments":[{"spoiler":false,"text":"清廉潔白で有名な大物政治家の娘として、周りから注目を集めている。"},{"spoiler":false,"text":"学校での成績は常にトップクラスを維持。文武両道がモットーで、弓道部に所属。次期主将はほぼ確定的と言われている。責任感が強く、周りからの信頼も厚い。"},{"spoiler":false,"text":"普段は比較的のんびりで気取らない性格だが、時折凛とした空気を纏う。"},{"spoiler":false,"text":"密かな好物はコンビニのミルクプリン。"}],"source":"bangumi","sourceCharacterId":"60718"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0e26fcb835772bb166f1dde63d91efde416b9d97e59da262f2ef6a7a8a63241.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d9af5cd7cbbeb2144b9f8f1a54d6af74ddaeffac2d17e91c1f71ec0f975506a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80907:60718:4489:1","source":"bangumi"}]},{"characterId":"char_c43417","characterName":"蓬莱 姫乃","sourceIds":{"bangumi":[{"characterId":"60837","match":"exact-normalized-name-in-linked-work","subjectId":"80907"}],"egsCharacterIds":["25507"],"vndbCharacterId":"c43417"},"originalCharacterName":"蓬莱 姫乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"静琉の親友。"},{"spoiler":false,"text":"静琉とは初等部からの付き合いで、静琉をライバル視している。"},{"spoiler":false,"text":"成績は静琉に負けず劣らず優秀。"},{"spoiler":false,"text":"文武両道を貫くことも静琉と変わらず、新体操部に所属。"},{"spoiler":false,"text":"あまり表に出さないものの、情に厚く涙もろい。また努力家でもある。"},{"spoiler":false,"text":"大手電子企業で社長を務める父を持ち、その影響からか機会にめっぽう強い。"}],"source":"egs","sourceCharacterId":"25507","sourceWorkId":"7672","spoiler":false},{"segments":[{"spoiler":false,"text":"静琉の親友。自称・静琉のライバル。"},{"spoiler":false,"text":"初等部に入学した時に同じクラスになり、それ以来の付き合い。子供の頃から静琉をライバル視し、なにかと勝負をしかけてくる。その実、単に静琉を構いたいという気持ちが見え隠れ。"},{"spoiler":false,"text":"成績は静琉に負けず劣らずトップクラスを維持。新体操部に所属している。"},{"spoiler":false,"text":"あまり表に出さないが情に厚く涙もろい。密かに努力家。"},{"spoiler":false,"text":"父親は大手電子企業の社長。一技術者から成り上がった父親の影響か、めっぽう機械に強い。"}],"source":"bangumi","sourceCharacterId":"60837"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8b9ac6ccd3932e065305125df5187aa039bd10663faaf26c67882f4c5f01c8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6712cb1df6a86e83461cf316ce8ad4451bad7e6c818c84eb3a789d3eb16dc38.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本井えみ","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80907:60837:4177:1","source":"bangumi"}]},{"characterId":"char_c43418","characterName":"乾 彩音","sourceIds":{"bangumi":[{"characterId":"60838","match":"exact-normalized-name-in-linked-work","subjectId":"80907"}],"egsCharacterIds":["25508"],"vndbCharacterId":"c43418"},"originalCharacterName":"乾 彩音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"静琉たちの先輩。"},{"spoiler":false,"text":"陸上部の主将を務め、近い将来、記録を更新するだろうと期待されている走り高跳びのホープ。"},{"spoiler":false,"text":"ストイックな性格で、自分にも他人にも厳しい。"},{"spoiler":false,"text":"さりげなく面倒見が良いことから皆に慕われ、後輩の女子からの告白されることも多い。"},{"spoiler":false,"text":"何気に料理が得意。"}],"source":"egs","sourceCharacterId":"25508","sourceWorkId":"7672","spoiler":false},{"segments":[{"spoiler":false,"text":"静琉たちの先輩。陸上部主将にして、走り高跳びの実力者。"},{"spoiler":false,"text":"近いうちに記録を更新するだろうと期待されている。すでに有名実業団などからスカウトの話も来ているらしい。"},{"spoiler":false,"text":"ストイックで自分にも他人にも厳しい性格。しかし、さりげなく面倒見が良いのでみんなから慕われている。後輩の女子から告白されること多数。"},{"spoiler":false,"text":"現在は親元を離れて寮で暮らしている。なにげに料理上手。"}],"source":"bangumi","sourceCharacterId":"60838"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/deb1b5683c30b0ad81301616f1884e9f11604e054622486bd929c835c51f0833.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/016ee945ae72090adc4f17cad3abe2c59f2dc4cb00bbe77c9caddf3d7a42adac.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽吹梨里","creatorId":"vndb:s57","sourcePersonId":"vndb:s57","canonicalEntityId":"vndb:s57","name":"羽吹 梨里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80907:60838:6547:1","source":"bangumi"}]},{"characterId":"char_c43419","characterName":"早乙女 さくら","sourceIds":{"bangumi":[{"characterId":"60839","match":"exact-normalized-name-in-linked-work","subjectId":"80907"}],"egsCharacterIds":["25509"],"vndbCharacterId":"c43419"},"originalCharacterName":"早乙女 さくら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"現在売り出し中のアイドル。"},{"spoiler":false,"text":"明るく天然なところがファンに評判。"},{"spoiler":false,"text":"普段はおとなしく、やや人見知りする性格。"},{"spoiler":false,"text":"将来の夢は女優。"},{"spoiler":false,"text":"静琉達が刑務所に連れて来られたときには、既に収監されていた。"}],"source":"egs","sourceCharacterId":"25509","sourceWorkId":"7672","spoiler":false},{"segments":[{"spoiler":false,"text":"静琉たちよりも先に捕まっていた少女。"},{"spoiler":false,"text":"最近売り出し中のアイドル。明るい天然キャラとして人気を得ている。"},{"spoiler":false,"text":"普段は大人しい性格で、やや人見知り。趣味は読書。将来の夢は女優。"}],"source":"bangumi","sourceCharacterId":"60839"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e8c2317616053e15255f413d962e2ab85b84bfc4fc6eda057f24202c639384b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72b9a3b82e1b97ea6572506804230083fa5e7583f334f033331ef436e3f0737b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田佳代","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:80907:60839:6038:1","source":"bangumi"}]},{"characterId":"char_c43420","characterName":"レナ","sourceIds":{"bangumi":[{"characterId":"60840","match":"exact-normalized-name-in-linked-work","subjectId":"80907"}],"egsCharacterIds":["25510"],"vndbCharacterId":"c43420"},"originalCharacterName":"レナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","va