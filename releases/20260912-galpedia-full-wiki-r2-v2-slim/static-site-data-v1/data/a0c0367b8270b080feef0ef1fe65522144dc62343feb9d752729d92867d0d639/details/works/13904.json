"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Date of Birth (Creation): 2006/10/14"},{"spoiler":false,"text":"From: Musashino-shi, Tokyo."},{"spoiler":false,"text":"Hobbies: Bathing, playing with cats, gaming."},{"spoiler":false,"text":"Special skill: Guitar, cooking (Japanese food)."},{"spoiler":false,"text":"Favorite food: Ramen (pork noodles), macaroon."},{"spoiler":false,"text":"Favorite artists: Nirvana, Foo Fighters, Sonic Youth, Iggy and The Stooges, The Clash, Patti Smith, Avril Lavigne."},{"spoiler":false,"text":"Recent favorites: Maximum the Hormone and Grizzly Bear."},{"spoiler":false,"text":"Super Sonico was created by the Nitroplus Company in 2007 to be the mascot for their yearly Nitro Super Sonic (NSS) Music Festival held in Japan each year. Since her creation, she has become quite popular and has even starred in her own video game: SoniComi, the PS3/PSV game Motto! SoniComi and the 3DS idol producing game SoniPro. She even starred in her own anime, SoniAni."},{"spoiler":false,"text":"She also a member of band Dai Ichi Uchuu Sokudo and has released several singles and albums."},{"spoiler":false,"text":"From 2011.03.01 till 2011.05.31 Sonico starred in Kimisho as a limited time heroine."},{"spoiler":false,"text":"Profile details translated from her official site."},{"spoiler":false,"text":"Summary from Anime Vice."}],"source":"vndb","sourceCharacterId":"c3643"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c332712a0d2f651d6784af5fa58d143c84c3fedc9f86018bbd7d3bd2c3cf3d63.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/622c0f874a79c0a4c1fab3e3c63d53192990d10897a9d70c343214962fb5062b.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山本 彩乃","c