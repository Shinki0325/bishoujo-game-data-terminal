voice:48002:18548:4061:1","source":"bangumi"}]},{"characterId":"char_bangumi_18549","characterName":"かつらぎ","sourceIds":{"bangumi":[{"characterId":"18549","match":"source-roster","subjectId":"108440"},{"characterId":"18549","match":"source-roster","subjectId":"15927"},{"characterId":"18549","match":"source-roster","subjectId":"194888"},{"characterId":"18549","match":"source-roster","subjectId":"223001"},{"characterId":"18549","match":"source-roster","subjectId":"48002"},{"characterId":"18549","match":"source-roster","subjectId":"92119"}]},"originalCharacterName":"かつらぎ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1105"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"bust":{"reviewState":"source-only","source":"bangumi","value":"95"},"height":{"reviewState":"source-only","source":"bangumi","value":"165"},"hip":{"reviewState":"source-only","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"通称「かつ姉」。戦い強くなることが生きがいで、とにかく考える前に手が出てしまう。情に厚く涙もろい親分肌で、めちゃくちゃなことも言うが仲間からも好かれている。セクハラが趣味で美少女を見ると誰かれ構わずついセクハラしたくなるが、されるのは苦手。好きな物はラーメン。秘伝忍法は龍。属性は風。具足を用いた蹴り技が得意で、切り裂くように蹴りまくる戦闘スタイルは、力強い蹴り技で敵を圧倒する。"}],"source":"bangumi","sourceCharacterId":"18549"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"18549","value":"性骚扰"},{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"18549","value":"拉面"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0b66eb1e0be49f5500231e195c9d9bf876de64d09ccddfbf656d4fa7cc1a778.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/4200847f73685e343817cb7d3f17f986864e822ccf5e824a69f27af3