ch":"source-roster","subjectId":"92119"}]},"originalCharacterName":"むらさめ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0606"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"180"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"名門の忍一族の一人息子だが、彼に忍の才能が無かったために斑鳩が養子となった。実子でない斑鳩が「飛燕」を与えられたことを恨んでいる。"},{"spoiler":false,"text":"鎖鎌を得意としており、小学生の時「町内鎖鎌大会6位」になったとのことだが、斑鳩には通用せず一蹴されてしまう。なお鎖鎌大会以降は順位を異様に気にする性格になってしまい蛇女編でも大食い大会の順位を非常に気にしていた。また彼が依頼を出しているミッションもあるが、ここでも「6」という数字を気にしている。なお主人公たちの水準には全く及ばないものの、常人よりははるかに強い。"}],"source":"bangumi","sourceCharacterId":"155251"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"155251","value":"义妹"},{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"155251","value":"咖喱"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e7c636f2b5728a4cf91304753020ab81b5c6fc94c53ce00c9c80e0297c1ecdf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81c6a96cfca23a41afebcb244c2d8b6411047ac086094357fef204a5d22b564a.webp","width":256,"height":217,"source":"static-detail"},"actors":[{"creditedName":"山本兼平","creatorId":"vndb:s31","sourcePersonId":"vndb:s31","canonicalEntityId":"vndb:s31","name":"山本 兼平","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:48002:155251:7559:1","source":"bangumi"}]},{"characterId":"char_bangumi_155263","characterName":"どうげん","sourceIds":{"bangumi":[{"characterId":"155263","match":"source-roster","subjectId":"15927"},{"characterId":"155263","match":"source-roster","subjectId":"223001"},{"characterId":"155263","match":"source-roster","subjectId":"48002"},{"characterId":"155263","match":"source-roster","subjectId":"92119"}]},"originalCharacterName":"どうげん","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"シリーズを通しての悪役、あるモノ（設定が原作と異なる）のために超秘伝忍法書を求めている。名前は『Burst』の蛇女編で判明。"},{"spoiler":false,"text":"アニメ版では鈴音に指令を送る謎の存在で、秘立蛇女子学園の首領らしき人物。鈴音を通して焔たちに指示を送っている。普段は姿を見せず、声だけで会話するが、終盤は姿を現す。右顔に刀の傷痕があり右目は失明している。"}],"source":"bangumi","sourceCharacterId":"155263"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d9e7cd3c5384d91dfd3b59683cc170f1e8bb618254b4bc0c0ed1d418caf4d43.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5c8f8b025763fe9a34c94093f1aa71e0e3c030e15714643bd2dfce190097b87.webp","width":162,"height":256,"source":"static-detail"},"actors":[{"creditedName":"寺井智之","creatorId":"vndb:s5771","sourcePersonId":"vndb:s5771","canonicalEntityId":"vndb:s5771","name":"寺井 智之","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:48002:155263:5607:1","source":"bangumi"}]},{"characterId":"char_bangumi_18546","characterName":"あすか","sourceIds":{"bangumi":[{"characterId":"18546","match":"source-roster","subjectId":"108440"},{"characterId":"18546","match":"source-roster","subjectId":"15927"},{"characterId":"18546","match":"source-roster","subjectId":"194888"},{"characterId":"18546","match":"source-roster","subjectId":"221228"},{"characterId":"18546","match":"source-roster","subjectId":"223001"},{"characterId":"18546","match":"source-roster","subjectId":"288017"},{"characterId":"18546","match":"source-roster","subjectId":"48002"},{"characterId":"18546","match":"source-roster","subjectId":"92119"}]},"originalCharacterName":"あすか","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0908"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"bust":{"reviewState":"source-only","source":"bangumi","value":"90"},"height":{"reviewState":"source-only","source":"bangumi","value":"155"},"hip":{"reviewState":"source-only","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いつも元気いっぱいで、どんなことにも一生懸命。忍の道とは何か、本人なりに一生懸命に考えている。忍としての実力はまだまだだが、偉大な忍を祖父「半蔵」に持っており、潜在能力は抜群。好きな物はじっちゃん（半蔵）の太巻き。趣味は修行。秘伝忍法はガマ。属性は土。長短2本の脇差を振るう戦闘をする二刀流での斬撃が中心の戦闘スタイル。"}],"source":"bangumi","sourceCharacterId":"18546"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"18546","value":"修行"},{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"18546","value":"爷爷的太卷寿司"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cb4624300cd1a71cd50d9a202948147a3515b74ce243e7c173d4eb12f2bd3fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbde01a372743de57550d9363b53d911aae6a50c8f99b00fee6586afd9473523.webp","width":169,"height":256,"source":"static-detail"},"actors":[{"creditedName":"原田ひとみ","creatorId":"vndb:s1116","sourcePersonId":"vndb:s1116","canonicalEntityId":"vndb:s1116","name":"原田 ひとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:48002:18546:5206:1","source":"bangumi"}]},{"characterId":"char_bangumi_18548","characterName":"いかるが","sourceIds":{"bangumi":[{"characterId":"18548","match":"source-roster","subjectId":"108440"},{"characterId":"18548","match":"source-roster","subjectId":"15927"},{"characterId":"18548","m