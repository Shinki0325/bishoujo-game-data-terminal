ある。根が真面目で融通がきかないところもあるため、たまに暴走して空回りしてしまい他のメンバーからあきれられることも。飛鳥とは縁があり、互いを高め合うライバルとなる。趣味は戦いで、好きな食べ物は和食。六刀を振るう剣技の他に、最終決戦ではもう一本の太刀を使う一刀流の技を使う。太刀を使用している状態では「紅蓮の焔」と表記されており、蛇女編では一定条件を満たした後に使用可能になる。"}],"source":"bangumi","sourceCharacterId":"18554"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"18554","value":"战斗"},{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"18554","value":"日式食物、肉"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/66d0997711ce7e792e0f2c78a2d6fa9ffdc08488686d057472920066cf377b25.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f02bcf5bcfca67126eae1323c0e263aaba1b7a272df605c0d420ad6f3671a434.webp","width":135,"height":256,"source":"static-detail"},"actors":[{"creditedName":"喜多村英梨","creatorId":"vndb:s269","sourcePersonId":"vndb:s269","canonicalEntityId":"vndb:s269","name":"喜多村 英梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:48002:18554:4251:1","source":"bangumi"}]},{"characterId":"char_bangumi_18555","characterName":"よみ","sourceIds":{"bangumi":[{"characterId":"18555","match":"source-roster","subjectId":"108440"},{"characterId":"18555","match":"source-roster","subjectId":"15927"},{"characterId":"18555","match":"source-roster","subjectId":"194888"},{"characterId":"18555","match":"source-roster","subjectId":"221228"},{"characterId":"18555","match":"source-roster","subjectId":"223001"},{"characterId":"18555","match":"source-roster","subjectId":"288017"},{"characterId":"18555","match":"source-roster","subjectId":"48002"},{"characterId":"18555","match":"source-roster","subjectId":"92119"}]},"originalCharacterName":"よみ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0210"},"bloodType":{"reviewState":"so