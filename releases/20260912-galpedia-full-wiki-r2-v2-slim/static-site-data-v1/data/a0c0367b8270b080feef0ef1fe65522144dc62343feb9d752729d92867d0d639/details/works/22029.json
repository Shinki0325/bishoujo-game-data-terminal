れであり、本人は頑張っているものの、よく問題を起こすトラブルメーカー。子供の喧嘩のような体術を使うが戦闘はやや苦手で、諜報活動が得意。好きな物は甘い物全般。趣味はテレビゲーム。秘伝忍法はウサギ。属性は雷。戦闘スタイルは「ポカポカ変則格闘術」と呼ばれる謎の格闘術で、でたらめな動きだが威力は抜群。"}],"source":"bangumi","sourceCharacterId":"18551"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"18551","value":"家用机游戏"},{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"18551","value":"所有甜点心"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f3ad285a30f55396d01e49eadd7051849a813a2a4ce5debeb06b00f3c57329b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e1706a2d86c97a45e62ce9bf17d26b73cc83700709f87d68adf13e3d577943f.webp","width":169,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井口裕香","creatorId":"vndb:s3971","sourcePersonId":"vndb:s3971","canonicalEntityId":"vndb:s3971","name":"井口 裕香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:48002:18551:4851:1","source":"bangumi"}]},{"characterId":"char_bangumi_18552","characterName":"王牌","sourceIds":{"bangumi":[{"characterId":"18552","match":"source-roster","subjectId":"108440"},{"characterId":"18552","match":"source-roster","subjectId":"15927"},{"characterId":"18552","match":"source-roster","subjectId":"223001"},{"characterId":"18552","match":"source-roster","subjectId":"48002"},{"characterId":"18552","match":"source-roster","subjectId":"92119"}]},"originalCharacterName":"王牌","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"伝説の忍と称えられている飛鳥の母方の祖父。「半蔵学院」の名前は彼が由来となっている。現役を引退した今は飛鳥の実家で寿司職人として暮らしており、彼の太巻きは評判が高い。"}],"source":"bangumi","sourceCharacterId":"18552"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1b8555cb48ac545f7872da5f9729f619d5551e18a24934e2655eaef6c8c3b2f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/7827177aa9c457d168c6a7303c87efc25746ce3ba193fa7fc9861bbdb9fba8b2.webp","width":256,"height":206,"source":"static-detail"},"actors":[{"creditedName":"山本兼平","creatorId":"vndb:s31","sourcePersonId":"vndb:s31","canonicalEntityId":"vndb:s31","name":"山本 兼平","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:48002:18552:7559:1","source":"bangumi"}]},{"characterId":"char_bangumi_18553","characterName":"Mr.K(PBSの司会進行)","sourceIds":{"bangumi":[{"characterId":"18553","match":"source-roster","subjectId":"15927"},{"characterId":"18553","match":"source-roster","subjectId":"194888"},{"characterId":"18553","match":"source-roster","subjectId":"223001"},{"characterId":"18553","match":"source-roster","subjectId":"48002"},{"characterId":"18553","match":"source-roster","subjectId":"92119"}]},"originalCharacterName":"Mr.K(PBSの司会進行)","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0505"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"185"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"由緒正しい忍の家系に生まれた最上忍であり、破格の実力の持ち主だが、任務のため平気で命を捨てる生き方に嫌気がさし、現在は前線を退いて後進が一人でも多く生き残るように厳しく教育に打ち込んでいる。好きな物は豆類。"}],"source":"bangumi","sourceCharacterId":"18553"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"18553","value":"后辈的育成"},{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"18553","value":"豆类"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1