02"},{"characterId":"18556","match":"source-roster","subjectId":"92119"}]},"originalCharacterName":"ひかげ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0909"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"bust":{"reviewState":"source-only","source":"bangumi","value":"85"},"height":{"reviewState":"source-only","source":"bangumi","value":"160"},"hip":{"reviewState":"source-only","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"実力はあるが「感情がない」と自称する無表情で口数も少なく、何を考えているのかよくわからない無気力な少女。葛城からの挑戦に気乗りせず、受け流している。手足に暗器を仕込み、柔軟な体と合わせた変幻自在の体術を使う。一定以上の痛みを受けると極度の興奮状態、狂乱モードになる。クールに戦うその姿はまるで戦闘マシーン。"}],"source":"bangumi","sourceCharacterId":"18556"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"18556","value":"无"},{"label":"喜欢的食物","source":"bangumi","sourceCharacterId":"18556","value":"无"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f8de0dd709ef7bee88e514ff8ecdeee96c20c88834270f23b4c4861d6aaf1bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57403e245834aaf352b304f011953e28b8273660e30f0adad9a9adfb632149c0.webp","width":169,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白石涼子","creatorId":"vndb:s953","sourcePersonId":"vndb:s953","canonicalEntityId":"vndb:s953","name":"白石涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:48002:18556:4730:1","source":"bangumi"}]},{"characterId":"char_bangumi_18557","characterName":"みらい","sourceIds":{"bangumi":[{"characterId":"18557","match":"source-roster","subjectId":"108440"},{"cha