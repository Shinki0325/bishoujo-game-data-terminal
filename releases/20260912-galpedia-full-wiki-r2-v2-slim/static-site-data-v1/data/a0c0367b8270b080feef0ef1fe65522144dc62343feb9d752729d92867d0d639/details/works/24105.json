は主人公を支えることが出来ないため、主人公への神力の供給を手伝うことになり、主人公と関係を持つことになる。"}],"source":"egs","sourceCharacterId":"11749","sourceWorkId":"24105","spoiler":false},{"segments":[{"spoiler":false,"text":"ベテラン死神。 第二級死神ライセンス所持者。"},{"spoiler":false,"text":"浄化と呼ばれる霊を滅する火を使い、かつては最強の死神の一人と称えられていた。"},{"spoiler":false,"text":"カタナ一人では主人公の命を支えることが出来ないため、補佐することになる。"},{"spoiler":false,"text":"「あらあら…… キミは私の言う通りにしなくてはダメですわ」"}],"source":"bangumi","sourceCharacterId":"48822"}],"profileFacts":[{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"11749","sourceWorkId":"24105","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"11749","sourceWorkId":"24105","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"11749","sourceWorkId":"24105","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"11749","sourceWorkId":"24105","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"11749","sourceWorkId":"24105","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36449f448a3e805fa7b777291e2383fe16604edb7b00a334c4f5d66091ccd966.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9ab5ba533b4bfacd108a65fe57efaf3134ee7535a3c53d44cb93a8f62d524e68.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中みかん","creatorId":"vndb:s943","sourcePersonId":"vndb:s943","canonicalEntityId":"vndb:s943","name":"野中みかん(尾野山みか)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:198715:48822:32581:1","source":"bangumi"}]},{"characterId":"char_c67741","characterName":"北条 雫","sourceIds":{"bangumi":[{"characterId":"48823","match":"exact-normalized-name-in-linked-work","subjectId":"198715"}],"egsCharacterIds":["11750"],"vndbCharacterId":"c67741"},"originalCharacterName":"北条 雫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"一般人。同い年の身体の弱い幼なじみ。元は元気な女の子だった。"},{"spoiler":false,"text":"隣家に住む同級生だが現在入院中。"},{"spoiler":false,"text":"同じ学園に通うことになっていたが、入学式で彼女は体調を崩し、それ以来一緒に登校出来ていない。"},{"spoiler":false,"text":"数日に一度は彼女の見舞いに行くのが主人公の日課。"}],"source":"egs","sourceCharacterId":"11750","sourceWorkId":"24105","spoiler":false},{"segments":[{"spoiler":false,"text":"身体の弱い幼なじみ。 隣家の同級生だが現在入院中。"},{"spoiler":false,"text":"入学式で倒れて以来登校しておらず、数日に一度は見舞いに行くのが主人公の日課。"},{"spoiler":false,"text":"会うたびに容赦のない小言を言ってくるが、主人公の一番の理解者。"},{"spoiler":false,"text":"「少女漫画ならここは男の子が頑張る場面だよ」"}],"source":"bangumi","sourceCharacterId":"48823"}],"profileFacts":[{"label":"胸围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"11750","sourceWorkId":"24105","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"11750","sourceWorkId":"24105","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"149 cm","valueContext":null,"source":"egs","sourceCharacterId":"11750","sourceWorkId":"24105","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"11750","sourceWorkId":"24105","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"11750","sourceWorkId":"24105","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d88b50806d689464dde6215a1b59ad808bcf2d255c9c777fb5314343a0beac5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a7de703be58f895609efb8e5ee33abe2ac084bd0bdc07b210e5f85a1a8827fd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"入江望愛","creatorId":"vndb:s8302","sourcePersonId":"vndb:s8302","canonicalEntityId":"vndb:s8302","name":"入江 望愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:198715:48823:23543:1","source":"bangumi"}]},{"characterId":"char_c67743","characterName":"葛西 夕","sourceIds":{"bangumi":[{"characterId":"48824","match":"exact-normalized-name-in-linked-work","subjectId":"198715"}],"egsCharacterIds":["11751"],"vndbCharacterId":"c67743"},"originalCharacterName":"葛西 夕","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"一般人。学園の先輩。重度のオカルトマニア。"},{"spoiler":false,"text":"オカルト研究会（オカ研）の会長。同好会が部室を使うために最低２名は所属していなければならないと言うことで主人公を無理矢理引き込んだ。"},{"spoiler":false,"text":"主人公とは違うベクトルでドライな人物。"},{"spoiler":false,"text":"家が神社であるため、不思議現象の話をさんざん聞かされて育ってきたが、自身にその手の経験がなく、オカルト現象に憧れている。"},{"spoiler":false,"text":"日常のコメディキャラ。いざというときには頼りになる先輩。"}],"source":"egs","sourceCharacterId":"11751","sourceWorkId":"24105","spoiler":false},{"segments":[{"spoiler":false,"text":"オカルト研究会の会長で、重度のオカルトマニア。"},{"spoiler":false,"text":"部室を確保するため主人公を無理やり引き込んだ先輩。。"},{"spoiler":false,"text":"神社の娘で不思議現象を散々聞かされて育ったが、一度も実体験がなく憧れている。"},{"spoiler":false,"text":"「ん？ そんなに私の胸が気になるのか？　仕方ないな」"}],"source":"bangumi","sourceCharacterId":"48824"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"11751","sourceWorkId":"24105","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"11751","sourceWorkId":"24105","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"11751","sourceWorkId":"24105","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"11751","sourceWorkId":"24105","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"11751","sourceWorkId":"24105","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbb7138ae35183d697e5a2d07808b6c8dbef8f76f4699832c788d768005b854d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6ec81b5c40bfd7544832c2498ef3be5547cf191b9ea473f765fd4d76b0111060.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桐村まり","creatorId":"vndb:s1549","sourcePersonId":"vndb:s1549","canonicalEntityId":"vndb:s1549","name":"桐村 まり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:198715:48824:23768:1","source":"bangumi"}]},{"characterId":"char_c67744","characterName":"南雲 輝梨","sourceIds":{"bangumi":[{"characterId":"48825","match":"exact-normalized-name-in-linked-work","subjectId":"198715"}],"egsCharacterIds":["11752"],"vndbCharacterId":"c67744"},"originalCharacterName":"南雲 輝梨","characterNameSource"