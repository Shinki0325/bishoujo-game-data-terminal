ctor","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:218439","source":"vndb"}]},"cast":[{"characterId":"char_c159169","characterName":"マリーヌ・ラ・ヴァルロワ","sourceIds":{"bangumi":[{"characterId":"190016","match":"exact-normalized-name-in-linked-work","subjectId":"598960"}],"egsCharacterIds":["28172"],"vndbCharacterId":"c159169"},"originalCharacterName":"マリーヌ・ラ・ヴァルロワ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"303"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Princess of Valleroy. She studies swordsmanship and knighthood at the Valleroy Royal Academy. She is a top student with excellent grades. Has a domineering personality and talks in a very high-handed manner but has a very high sense of duty as someone who carries the burdens and responsibilities of royalty."},{"spoiler":false,"text":"She is not yet wise to the ways of the world and has a very pure and sincere personality."},{"spoiler":false,"text":"Having snuck out of the castle for a certain reason, she meets Aruji when she uses the abandoned inn as a place to stay and ends up becoming the inn's first patron. In order to hide her identity, she introduces herself as \"Mylene\", a daughter of nobility."},{"spoiler":false,"text":"Due to her position as a princess, she's used to changing clothes in front of servants, so she has a somewhat diminished sense of vulnerability about being seen naked. This does not mean that she is completely without shame though."},{"spoiler":false,"text":"Also to prepare her for succession to the throne, she has received proper sex education, so she is very knowledgeable about sexual matters. But as she has no actual practical experience (she's a virgin), she's just an armchair expert who lets her imagination and expectations run wild in her head. She's surprisingly proactive and devoted, even willing to perform fellatio and engage in outdoor play."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c159169"},{"segments":[{"spoiler":false,"text":"ヴァルロワ王国の皇女。"},{"spoiler":false,"text":"ヴァルロワ王立学院にて剣士としての剣術を学んでおり成績優秀で主席。"},{"spoiler":false,"text":"いわゆる高飛車、高圧的な口調ではあるが、王国の皇女という環境と国を背負うという責任感、また世間擦れしていないためであり、性格的には実直且つ素直。"},{"spoiler":false,"text":"とある理由で城を抜け出し、アルジの宿屋で寝泊まりしていたところでアルジと出会い廃宿の一人目の宿泊客となる。"},{"spoiler":false,"text":"当初は身分を隠すため、貴族の娘”ミレーヌ”と名乗る。"}],"source":"egs","sourceCharacterId":"28172","sourceWorkId":"39350","spoiler":false},{"segments":[{"spoiler":false,"text":"ヴァルロワ王国の皇女。"},{"spoiler":false,"text":"ヴァルロワ王立学院にて剣士としての剣術を学んでおり成績優秀で主席。"},{"spoiler":false,"text":"いわゆる高飛車、高圧的な口調ではあるが、王国の皇女という環境と国を背負うという責任感、また世間擦れしていないためであり、性格的には実直且つ素直。"},{"spoiler":false,"text":"とある理由で城を抜け出し、アルジの宿屋で寝泊まりしていたところでアルジと出会い、廃宿の1人目の宿泊客となる。"},{"spoiler":false,"text":"当初は身分を隠すため、貴族の娘”ミレーヌ”と名乗る。"},{"spoiler":false,"text":"「こ、この変態異常性欲者っ！！ い、今すぐここから出ていきなさいっ！！」"}],"source":"bangumi","sourceCharacterId":"190016"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"28172","sourceWorkId":"39350","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"28172","sourceWorkId":"39350","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"28172","sourceWorkId":"39350","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"28172","sourceWorkId":"39350","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"28172","sourceWorkId":"39350","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a98ee9733bccf9d2e3bc16f02a81407addba5eeebb974748ae26e61b6e6539f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8322543cb0e725bdc82c4fef256f85e50f468382ff8975dc35089b5b018e2ecf.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花月さや","creatorId":"vndb:s23345","sourcePersonId":"vndb:s23345","canonicalEntityId":"vndb:s23345","name":"花月さや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:598960:190016:40638:1","source":"bangumi"}]},{"characterId":"char_c159170","characterName":"クリソベリル・アルマローリ","sourceIds":{"bangumi":[{"characterId":"190017","match":"exact-normalized-name-in-linked-work","subjectId":"598960"}],"egsCharacterIds":["28173"],"vndbCharacterId":"c159170"},"originalCharacterName":"クリソベリル・アルマローリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"215"},"bust":{"reviewState":"source-only","source":"vndb","value":"101"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"95"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A cleric of a foreign holy church. Personality-wise, she's quite the airhead and a bit of a scatterbrain, but apparently her abilities as a priestess are among the highest within the church. However, she often makes mistakes due to her personality, which is why her standing within the church hierarchy isn't very high."},{"spoiler":false,"text":"A series of blunders culminated in her getting lost during a stormy night and by coincidence she wanders into Aruji's inn, becoming its second patron."},{"spoiler":false,"text":"She always has a smile on her face with narrowed eyes, and despite being a cleric, her speech and actions are often surprisingly unserious and lighthearted."},{"spoiler":false,"text":"Her clothes are so revealing that it's almost sacrilegious to call her a cleric; her attire constantly threatens to reveal more than it should, though she herself is utterly oblivious and unconcerned. However, she treats the protagonist differently, deliberately trying to force even the barely-covered parts into view. Despite relentlessly tempting the protagonist, she is actually inexperienced (a virgin), fitting her role as a cleric. Because of this, she always tries to take the lead by acting like a big sister, yet she also has a submissive side that yields under pressure."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c159170"},{"segments":[{"spoiler":false,"text":"異国の聖教会に属する聖職者。"},{"spoiler":false,"text":"性格的にかなりの天然で惚け惚けしているが、プリーストとしての能力は高く教会内においても最上位……らしい。"},{"spoiler":false,"text":"ただ、その性格が災いしてミスが多く、教会内においての地位は高くない。"},{"spoiler":false,"text":"数々のミスの連続と、極めつけに道に迷い嵐に見舞われた夜にアルジの宿へと流れ着いたことで廃宿の２人目の宿泊客となる。"},{"spoiler":false,"text":"いつも糸目でニコニコしており、聖職者という割にはあまりに軽い言動・行動が多く見受けられる。"}],"source":"egs","sourceCharacterId":"28173","sourceWorkId":"39350","spoiler":false},{"segments":[{"spoiler":false,"text":"異国の聖教会に属する聖職者。"},{"spoiler":false,"text":"性格的にかなりの天然で惚け惚けしているが、プリーストとしての能力は高く教会内においても最上位……らしい。"},{"spoiler":false,"text":"ただ、その性格が災いしてミスが多く、教会内においての地位は高くない。"},{"spoiler":false,"text":"数々のミスの連続と、極めつけに道に迷い嵐に見舞われた夜にアルジの宿へと流れ着いたことで、廃宿の2人目の宿泊客となる。"},{"spoiler":false,"text":"いつも糸目でニコニコしており、聖職者という割にはあまりに軽い言動・行動が多く見受けられる。"},{"spoiler":false,"text":"「きゃーっ♪ 泊めて貰えるんですか～っ！？ 嬉しいっ♪ お礼に、お姉さんイ・ロ・イ・ロ・頑張っちゃうから♪」"}],"source":"bangumi","sourceCharacterId":"190017"}],"profileFacts":[{"label":"胸围（本版本）","value":"101 cm","valueContext":null,"source":"egs","sourceCharacterId":"28173","sourceWorkId":"39350","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"28173","sourceWorkId":"39350","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"28173","sourceWorkId":"39350","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"28173","sourceWorkId":"39350","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"28173","sourceWorkId":"39350","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5de6280dc75d407cfef1f1b842bc4ef509a14eb2b1c4a487a43c17dc0182f26c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22089c6f09d0e4b77b7df5abfefeae4da74805460683b476652029b108a33e6c.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"倉下撫子","creatorId":"vndb:s18213","sourcePersonId":"vndb:s18213","canonicalEntityId":"vndb:s18213","name":"倉下 撫子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:598960:190017:34868:1","source":"bangumi"}]},{"characterId":"char_c159171","characterName":"クンツァ","sourceIds":{"bangumi":[{"characterId":"190019","match":"exact-normalized-name-in-linked-work","subjectId":"598960"}],"egsCharacterIds":["28174"],"vndbCharacterId":"c159171"},"originalCharacterName":"クンツァ","characterNameSource":null,"role":"side","