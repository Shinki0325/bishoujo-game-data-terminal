al company. Riri is cheerful, energetic and nice. She loves to eat and sleeps a lot."},{"spoiler":false,"text":"Riri is a childhhod friend and schoolmate of Yukino Matsui. She has romantic feelings towards Noel, her bodyguard and schoolmate."},{"spoiler":false,"text":"Translated from the Russian Wikipedia."}],"source":"vndb","sourceCharacterId":"c575"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4eb353994007b9b17c14e21470f1873b661102a68012f9a90997818e2948d6b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/7553f180a057ad15a99637657c2ed049fd3fdd5b240a9fa02df14e20c260f6a7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"理多","creatorId":"vndb:s102","sourcePersonId":"vndb:s102","canonicalEntityId":"vndb:s102","name":"平井 理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9100","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:262","sourceCompanyId":"egs:brand:262","canonicalEntityId":"egs:brand:262","name":"FlyingShine","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:3953:262","source":"egs"},{"companyId":"vndb:p85","sourceCompanyId":"vndb:p85","canonicalEntityId":"vndb:p85","name":"フライングシャイン","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:2293:v1000","source":"vndb"},{"companyId":"vndb:p85","sourceCompanyId":"vndb:p85","canonicalEntityId":"vndb:p85","name":"フライングシャイン","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:30907:v1000","source":"vndb"},{"companyId":"vndb:p3370","sourceCompanyId":"vndb:p3370","canonicalEntityId":"vndb:p3370","name":"eclat","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:30908:v1000","source":"vndb"},{"company