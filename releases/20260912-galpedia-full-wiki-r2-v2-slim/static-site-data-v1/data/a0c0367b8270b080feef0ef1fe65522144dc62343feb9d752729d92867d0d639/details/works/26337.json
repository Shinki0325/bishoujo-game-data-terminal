ditedName":"huke","creatorId":"vndb:s232","sourcePersonId":"vndb:s232","canonicalEntityId":"vndb:s232","name":"huke","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:157363","source":"vndb"},{"creditedName":"菊池 通隆","creatorId":"vndb:s6026","sourcePersonId":"vndb:s6026","canonicalEntityId":"vndb:s6026","name":"菊池 通隆","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:157366","source":"vndb"},{"creditedName":"東風輪 敬久","creatorId":"vndb:s11751","sourcePersonId":"vndb:s11751","canonicalEntityId":"vndb:s11751","name":"東風輪敬久","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:157368","source":"vndb"},{"creditedName":"桑名 真吾","creatorId":"vndb:s14517","sourcePersonId":"vndb:s14517","canonicalEntityId":"vndb:s14517","name":"桑名真吾","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:157370","source":"vndb"},{"creditedName":"株式会社クリープ","creatorId":"vndb:s18796","sourcePersonId":"vndb:s18796","canonicalEntityId":"vndb:s18796","name":"株式会社クリープ(cre-p)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:157371","source":"vndb"},{"creditedName":"月蝕會議","creatorId":"vndb:s20031","sourcePersonId":"vndb:s20031","canonicalEntityId":"vndb:s20031","name":"月蝕會議","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:157373","source":"vndb"},{"creditedName":"佐藤 嘉晃","creatorId":"vndb:s39892","sourcePersonId":"vndb:s39892","canonicalEntityId":"vndb:s39892","name":"佐藤嘉晃","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:157375","source":"vndb"},{"creditedName":"福谷 大","creatorId":"vndb:s39893","sourcePersonId":"vndb:s39893","canonicalEntityId":"vndb:s39893","name":"福谷大","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:157376","source":"vndb"},{"creditedName":"村瀬 一路","creatorId":"vndb:s40802","sourcePersonId":"vndb:s40802","canonicalEntityId":"vndb:s40802","name":"村瀬 一路","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:157378","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c84005","characterName":"水梨 新","sourceIds":{"vndbCharacterId":"c84005"},"originalCharacterName":"水梨 新","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"27"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Argh... What a drag. Who the hell implemented these nasty bugs...?\""},{"spoiler":false,"text":"He must save Shiina... or risk his life trying."},{"spoiler":false,"text":"Enigma Games' lead programmer, who helped develop World's Odyssey alongside Shiina. In the midst of a frightening scandal, he discovers his former colleague inside of their cancelled game. In order to help Shiina on her quest, Arata manipulates the game's code in real-time, fixing bugs that threaten the lives of her and her party. It is up to Arata to travel between the game and the real world to investigate the mystery of Shiina's disappearance..."},{"spoiler":false,"text":"He uses the Enigma Games' bear mascot character Enigma as a skin when he enters World's Odyssey. Its primary function is for administrative use, giving a friendly face to moderators who could enforce fair play within the game. In the events of the game, Arata uses \"Mr. Enigma\" to communicate with Shiina and interact with her party members. Because Mr. Enigma's function is communication, he cannot participate in battle."},{"spoiler":false,"text":"From Idea Factory"}],"source":"vndb","sourceCharacterId":"c84005"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/885d37b8380def23c37485788a6474e446d8fb946acc0d8e3909d183a428fb79.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/469fe21e80b518590e3338725368cae7868d2cfebb6c3fafcd9fb98fdfe72dac.webp","width":228,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Chris Niosi","creatorId":"vndb:s168","sourcePersonId":"vndb:s168","canonicalEntityId":"vndb:s168","name":"Chris Niosi","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81410","source":"vndb"},{"creditedName":"徳武 竜也","creatorId":"vndb:s19238","sourcePersonId":"vndb:s19238","canonicalEntityId":"vndb:s19238","name":"徳武 竜也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81439","source":"vndb"}]},{"characterId":"char_vndb_c84006","characterName":"二ノ宮 しいな","sourceIds":{"vndbCharacterId":"c84006"},"originalCharacterName":"二ノ宮 しいな","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"World's Odyssey was my dream, which makes it my duty to return things back to the way they were!\""},{"spoiler":false,"text":"A girl who pines for the world from whence she came as she fights to survive inside of the world she created."},{"spoiler":false,"text":"Shiina wakes up inside of World's Odyssey, the VRMMORPG which had been cancelled for nearly a year, with no memory of her arrival. She served as the game's director for the duration of its development until her mysterious disappearance. With no way to perform a manual log-out, she sets out to complete the game's perfect ending."},{"spoiler":false,"text":"From Idea Factory"}],"source":"vndb","sourceCharacterId":"c84006"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bfeeb184a8d8020fa588826a7d54ba355c6f50caafb1be641cefe2169467d980.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f8d3353b88d6ab188e6af4f33fbd85ed036f63f20c5d9a595d5f69ae29d4b7c.webp","width":215,"height":256,"source":"static-detail"},"actors":[{"creditedName":"東城 日沙子","creatorId":"vndb:s10072","sourcePersonId":"vndb:s10072","canonicalEntityId":"vndb:s10072","name":"東城日沙子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81424","source":"vndb"},{"creditedName":"Kayli Mills","creatorId":"vndb:s14749","sourcePersonId":"vndb:s14749","canonicalEntityId":"vndb:s14749","name":"Kayli Mills","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81432","source":"vndb"}]},{"characterId":"char_vndb_c84007","characterName":"リリィ ホープス","sourceIds":{"vndbCharacterId":"c84007"},"originalCharacterName":"リリィ ホープス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I... I vow to protect my people!\""},{"spoiler":false,"text":"As a member of the royal family... she fights to preserve her honor."},{"spoiler":false,"text":"In World's Odyssey's storyline, Lily is an NPC character that serves as princess of Heartis, the realm's most famous kingdom. However, Arata and Shiina soon realize that there's more than meets the eye to her. After watching Shiina fight with her Buggy in battle, Lily asks Shiina to help save her father, the king of Heartis."},{"spoiler":false,"text":"From Idea Factory"},{"spoiler":true,"text":"Her real name is Yamamura Yurisa (山村 百合紗)."}],"source":"vndb","sourceCharacterId":"c84007"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9fe9617f40c770368fd6ee680ef8a8855555e6cfe558d8a6570c5530baaa2df7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/969b46dca4a7df0b7e9985c1beb9a472a8c86c051e95623e31f0ec5dac2991b3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Kira Buckland","creatorId":"vndb:s429","sourcePersonId":"vndb:s429","canonicalEntityId":"vndb:s429","name":"Kira Buckland","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81415","source":"vndb"},{"creditedName":"桑原 由気","creatorId":"vndb:s14653","sourcePersonId":"vndb:s14653","canonicalEntityId":"vndb:s14653","name":"桑原 由気","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81431","source":"vndb"}]},{"characterId":"char_vndb_c84008","characterName":"アル アストラ","sourceIds":{"vndbCharacterId":"c84008"},"originalCharacterName":"アル アストラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I wonder what it means to be a legendary adventurer...\""},{"spoiler":false,"text":"Her heart yearns for adventure..."},{"spoiler":false,"text":"A bright, bubbly NPC who aspires to be an adventurer. Al is found by Shiina, malnourished and on the verge of death, and joins her party as they set off for Odyssia. Her boundless enthusiasm is somewhat peculiar for an A.I. character."},{"spoiler":false,"text":"From Idea Factory"},{"spoiler":true,"text":"Her real name is Morikubo Hinata (森久保 ひなた)."}],"source":"vndb","sourceCharacterId":"c84008"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/4757c94ed4fff2db01c26ad620b90def8437d8209c840503962d1b65a6d94d31.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23bae9bac7f82feba88aeacc5ba97b613aa36f65712b6e2fb6c3d9923a14a6ce.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Erica Mendez","creatorId":"vndb:s369","sourcePersonId":"vndb:s369","canonicalEntityId":"vndb:s369","name":"Erica Mendez","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81413","source":"vndb"},{"creditedName":"田中 美海","creatorId":"vndb:s8115","sourcePersonId":"vndb:s8115","canonicalEntityId":"vndb:s8115","name":"田中 美海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81421","source":"vndb"}]},{"characterId":"char_vndb_c84009","characterName":"クレア グレイブ","sourceIds":{"vndbCharacterId":"c84009"},"originalCharacterName":"クレア グレイブ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"...All right, who wants to start the bidding?\""},{"spoiler":false,"text":"She travels far and wide, selling to souls who live in a broken world..."},{"spoiler":false,"text":"The infamous Red Peddler, who is introduced as a dubious merchant before joining Shiina's party. Her obsession with flipping antique goods often gets her into trouble, but she has a keen knowledge for priceless goods and weapons. Despite her rapacious veneer, she makes for a reliable ally."},{"spoiler":false,"text":"From Idea Factory"},{"spoiler":true,"text":"Her real name is Hiizumi Kaede (樋泉 楓). She is Senji's daughter."}],"source":"vndb","sourceCharacterId":"c84009"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/3940a4588c9e3f63c0aa782a2345e8fed8e9e66baa9381e13c1016a1c0afde67.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0df0e80ecb4c2e1b73cef87db038daf6ee38e41cf461b10b44388f54eb49e2b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Erika Harlacher","creatorId":"vndb:s9383","sourcePersonId":"vndb:s9383","canonicalEntityId":"vndb:s9383","name":"Erika Harlacher","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81423","source":"vndb"},{"creditedName":"高野 麻里佳","creatorId":"vndb:s12286","sourcePersonId":"vndb:s12286","canonicalEntityId":"vndb:s12286","name":"高野麻里佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81428","source":"vndb"}]},{"characterId":"char_vndb_c84010","characterName":"常盤 澄香","sourceIds":{"vndbCharacterId":"c84010"},"originalCharacterName":"常盤 澄香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Um, I'm a programmer too, you know? Let me give it a whirl!\""},{"spoiler":false,"text":"A coworker of Arata and Shiina's who works as a programmer on a project separate from World's Odyssey. As soon as she discovers that Shiina, whom she considered to be a sister, was stuck inside of W.O.D., she teams up with Arata to extract her. Her hobbies include curry ramen cups and fanatically studying the occult."},{"spoiler":false,"text":"From Idea Factory"}],"source":"vndb","sourceCharacterId":"c84010"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13bec420c7e9004a8dc28f10c7dfc1dc5c87d8f1156b704f373ad0c2fa4589bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/9249488f88d2e54b5ae3076fdc00afb542064f79d8f2a4465b4a597eac7240af.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Cherami Leigh","creatorId":"vndb:s431","sourcePersonId":"vndb:s431","canonicalEntityId":"vndb:s431","name":"Cherami Leigh","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81416","source":"vndb"},{"creditedName":"井澤 詩織","creatorId":"vndb:s7962","sourcePersonId":"vndb:s7962","canonicalEntityId":"vndb:s7962","name":"井澤 詩織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81420","source":"vndb"}]},{"characterId":"char_vndb_c84011","characterName":"リディア ノーラン","sourceIds":{"vndbCharacterId":"c84011"},"originalCharacterName":"リディア ノーラン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Oh, sorry! I know you were in the middle of telling me something, but I was pre-ordering a game!\""},{"spoiler":false,"text":"A foreigner who works as a character designer for Enigma Games. She prides herself on being an otaku, flaunting her decked-out itabag and collection of figurines at her desk. Her favorite video games are otome games, but she dabbles in other genres from time to time. She values honesty, impulsiveness, and thrill-seeking. Being the same age as Shiina allows the two to strike up a fast friendship."},{"spoiler":false,"text":"From Idea Factory"}],"source":"vndb","sourceCharacterId":"c84011"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/382b9e37399493305c77d56f70f49a02cebe2228e4020cebbe4f0c04f3bffe60.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/2283b6b06b5e8386d4a62262f9b4ec0dad6635fecc61329f5126dc6876c94c6b.webp","width":226,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Sarah Anne Williams","creatorId":"vndb:s185","sourcePersonId":"vndb:s185","canonicalEntityId":"vndb:s185","name":"Sarah Anne Williams","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81411","source":"vndb"},{"creditedName":"藤田 茜","creatorId":"vndb:s8737","sourcePersonId":"vndb:s8737","canonicalEntityId":"vndb:s8737","name":"藤田 茜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81425","source":"vndb"}]},{"characterId":"char_vndb_c84029","characterName":"ルシル フィアレーテ","sourceIds":{"vndbCharacterId":"c84029"},"originalCharacterName":"ルシル フィアレーテ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"What? Um... Hmm... I dunno...\""},{"spoiler":false,"text":"What more to life is there than solitude?"},{"spoiler":false,"text":"A half-elf NPC that is demure and pensive, if not frail. Generally, Elves are regarded for their wisdom, but this seems not to be the case with Lucile. She is often caught day-dreaming or muttering by Shiina's party, adding to her mysterious nature."},{"spoiler":false,"text":"From Idea Factory"},{"spoiler":true,"text":"Her real name is Svetlana Amou (スヴェトラーナ・天羽)."}],"source":"vndb","sourceCharacterId":"c84029"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31972155500a3a5fb248612e1683ca02d8340e461c5a77bc6def4f2681bdd348.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6be7ac7ee673df00b25aa3133d3b226c3ae8529bb05f03686865655e3aafe60b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Brianna Knickerbocker","creatorId":"vndb:s14751","sourcePersonId":"vndb:s14751","canonicalEntityId":"vndb:s14751","name":"Brianna Knickerbocker","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81433","source":"vndb"},{"creditedName":"橋本 ちなみ","creatorId":"vndb:s19236","sourcePersonId":"vndb:s19236","canonicalEntityId":"vndb:s19236","name":"橋本ちなみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81437","source":"vndb"}]},{"characterId":"char_vndb_c84030","characterName":"セリカ クレイトン","sourceIds":{"vndbCharacterId":"c84030"},"originalCharacterName":"セリカ クレイトン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Bring it on! I'll crush you with one swing of my sword!"},{"spoiler":false,"text":"A young, fearless warrior better known by her alias, the Monarch Adventurer. Her skills on the battlefield are considered second-to-none. Her ultimate goal is to reach the gates of Odyssia, the mystical sky capital, and she is famous for being the only NPC to ever get close. Her charm and light-hearted humor make her a welcome addition to Shiina's party."},{"spoiler":false,"text":"From Idea Factory"},{"spoiler":true,"text":"Her real name is Chloe Aaron (クロエ・アーロン)."}],"source":"vndb","sourceCharacterId":"c84030"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b0e90cc12f6b04da71b5d9cf121e3af2c211b4594d021e740d1e33c8f12ce19.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fec18301c78b114ea497a90c9cda55e7a2387a4acca32f7f6b7b608410b607c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今村 彩夏","creatorId":"vndb:s13042","sourcePersonId":"vndb:s13042","canonicalEntityId":"vndb:s13042","name":"今村彩夏","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81430","source":"vndb"},{"creditedName":"Faye Mata","creatorId":"vndb:s19753","sourcePersonId":"vndb:s19753","canonicalEntityId":"vndb:s19753","name":"Faye Mata","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81441","source":"vndb"}]},{"characterId":"char_vndb_c84031","characterName":"リプカ","sourceIds":{"vndbCharacterId":"c84031"},"originalCharacterName":"リプカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Hehehe. Beg for death. I want to see the light leave your eye...\""},{"spoiler":false,"text":"Her desire to kill inspires her to commit unfathomable atrocities..."},{"spoiler":false,"text":"A member of the Ludens, a mysterious group of beings that suddenly appear in World's Odyssey. She is obsessed with murders and massacres."},{"spoiler":false,"text":"From Idea Factory"}],"source":"vndb","sourceCharacterId":"c84031"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a12c6d284df12322bf421ea34ae719b3fdf303a2d2a953b3b0e73dfd10a95ea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b68f87ea5eaf10aadd1854148a3affdbc75406c2e6ab327d8ded285f95afc0ac.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"喜多村 英梨","creatorId":"vndb:s269","sourcePersonId":"vndb:s269","canonicalEntityId":"vndb:s269","name":"喜多村 英梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81412","source":"vndb"}]},{"characterId":"char_vndb_c84032","characterName":"安城 一","sourceIds":{"vndbCharacterId":"c84032"},"originalCharacterName":"安城 一","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Wow, I sense something spooky. I'm so excited~\""},{"spoiler":false,"text":"The eccentric owner and barista of the café, the Night Owl. He allows Arata to use his café as a place of refuge while on the run from the authorities. He is an avid consumer of occult literature and moderates occult forums online. His knowledge might come in handy..."},{"spoiler":false,"text":"From Idea Factory"}],"source":"vndb","sourceCharacterId":"c84032"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/7253957ab917e3a335aa3ef42328986109ce5cdd7b4da5021d0efc1956a605e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f77fc5686f0d2880d08c288ef4b1aae96bb6923c76788b172bd73cdf3ea502d1.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"矢野 龍太","creatorId":"vndb:s11765","sourcePersonId":"vndb:s11765","canonicalEntityId":"vndb:s11765","name":"矢野 龍太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81427","source":"vndb"}]},{"characterId":"char_vndb_c84033","characterName":"ルーク","sourceIds":{"vndbCharacterId":"c84033"},"originalCharacterName":"ルーク","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"My my, ladies. What would you like to purchase today?\""},{"spoiler":false,"text":"A beast who works as a traveling merchant. Shiina finds him as he is being attacked by a frightening monster and saves his life. To repay Shiina, he imparts the history of World's Odyssey to her. Because of the game's bugs, he is able to duplicate himself and appear all over the map, controlling all of his separate selves at once. In a world ravaged by bugs, he is a handy ally to have."},{"spoiler":false,"text":"From Idea Factory"}],"source":"vndb","sourceCharacterId":"c84033"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b4a7954c9fb4614d26cf8514da1bbd7e0304f81de04f4f9fa46c555e4ed5b82.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26533eb534ced8adae45e1d9352b13638c39f127e188d3a71cdff9b310cb64ae.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村大志","creatorId":"vndb:s19237","sourcePersonId":"vndb:s19237","canonicalEntityId":"vndb:s19237","name":"中村大志","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81438","source":"vndb"}]},{"characterId":"char_vndb_c84034","characterName":"樋泉 千治","sourceIds":{"vndbCharacterId":"c84034"},"originalCharacterName":"樋泉 千治","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You'd better tell me what you know, or I'll punch you to death, you bastard...\""},{"spoiler":false,"text":"A detective who works at the Sagami police station, who suspects Arata as the culprit behind the world's cyber-terror attack. He is a man of few words, which are often delivered coldly and curtly. However, he is fully commmited to bringing justice to the criminals responsible for the attack, though it seems he has a personal agenda motivating his fervor..."},{"spoiler":false,"text":"From Idea Factory"}],"source":"vndb","sourceCharacterId":"c84034"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e15ae3921e40d30282328d026c51c9f92ed3169806538a09e4d710d419b3d0d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b9b00b8843bdf75c60ae5c3c11bb00d74000dcbc17902f031bb2e939034a050.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"亀山 雄慈","creatorId":"vndb:s12703","sourcePersonId":"vndb:s12703","canonicalEntityId":"vndb:s12703","name":"亀山 雄慈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81429","source":"vndb"}]},{"characterId":"char_vndb_c84035","characterName":"ノヴァ","sourceIds":{"vndbCharacterId":"c84035"},"originalCharacterName":"ノヴァ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You're going to kill me? You're going to mess me up? AHA! I LOVE THAT HATRED!\""},{"spoiler":false,"text":"Pain begets pleasure."},{"spoiler":false,"text":"A member of the Ludens, a mysterious group of beings that suddenly appear in World's Odyssey. She is the Agent of Wrath. Her aggressive front makes her difficult to reason with. She is a masochist, deriving enjoyment from the infliction of pain."},{"spoiler":false,"text":"From Idea Factory"}],"source":"vndb","sourceCharacterId":"c84035"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81fe7dc1d33ded09d5be7f94d8fd57c02f28d6454386217d3e5268b2c3c7e925.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/608c0aa4b7b091567b4251e30747e6fbb04e8f63a385a0618b3ce16fc320c3ce.webp","width":224,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉岡 麻耶","creatorId":"vndb:s5512","sourcePersonId":"vndb:s5512","canonicalEntityId":"vndb:s5512","name":"吉岡 麻耶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81418","source":"vndb"},{"creditedName":"Allegra Clark","creatorId":"vndb:s19749","sourcePersonId":"vndb:s19749","canonicalEntityId":"vndb:s19749","name":"Allegra Clark","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81440","source":"vndb"}]},{"characterId":"char_vndb_c84036","characterName":"アリス","sourceIds":{"vndbCharacterId":"c84036"},"originalCharacterName":"アリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Hehehe. It's almost as if you've stumbled into Wonderland.\""},{"spoiler":false,"text":"Despair and desire go hand in hand."},{"spoiler":false,"text":"A member of the Ludens, a mysterious group of beings that suddenly appear in World's Odyssey. She is the Agent of Desire, who often speaks for the rest of the Ludens. Her peaceful demeanor might trick you into thinking she's approachable, but she has a tendency to look down upon others."},{"spoiler":false,"text":"From Idea Factory"}],"source":"vndb","sourceCharacterId":"c84036"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/977030233e30b1bc23e1b91953c90e8f3c792dc9c8f13e084bb9c40603e29983.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/6297f06cd2d68ffc6cd15f777daca90825f2e9779735f01fb3c89ec2ec68a5d2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Mela Lee","creatorId":"vndb:s8480","sourcePersonId":"vndb:s8480","canonicalEntityId":"vndb:s8480","name":"Mela Lee","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81422","source":"vndb"},{"creditedName":"山下 七海","creatorId":"vndb:s19235","sourcePersonId":"vndb:s19235","canonicalEntityId":"vndb:s19235","name":"山下七海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81436","source":"vndb"}]},{"characterId":"char_vndb_c84037","characterName":"明日風 凛","sourceIds":{"vndbCharacterId":"c84037"},"originalCharacterName":"明日風 凛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"32"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Um... What is it? If you have business with me, please make it short.\""},{"spoiler":false,"text":"Head secretary to the CEO of Enigma Games. Because the CEO is prone to keeping out of the public eye, Rin relays information from him to the Enigma team. She has a youthful appearance but is older than she looks, preferring to let her actions do the talking. Whenever Arata has trouble, she often serves as a guide to illuminate the path ahead of him."},{"spoiler":false,"text":"From Idea Factory"}],"source":"vndb","sourceCharacterId":"c84037"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cca483382e91cbfc53ae2f35685e6bfeb7f4477b44b683f04c66d346c5d4756f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/131fd955ad05b2d535809c47d4164bff03ab072723e3227150041872addc4b32.webp","width":183,"height":2