t":256,"source":"static-detail"},"actors":[{"creditedName":"小野 友樹","creatorId":"vndb:s42","sourcePersonId":"vndb:s42","canonicalEntityId":"vndb:s42","name":"小野 友樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7323","source":"vndb"}]},{"characterId":"char_vndb_c85136","characterName":"朝比奈 みくる","sourceIds":{"vndbCharacterId":"c85136"},"originalCharacterName":"朝比奈 みくる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mikuru Asahina is the fourth member to join the SOS Brigade, and the only person other than Kyon to join against her will. She is a shy and cute \"moe\" girl, often harassed by Haruhi Suzumiya. She is secretly a time traveler from the future who came back in time to observe Haruhi. She is best friends with Tsuruya and shows a great talent for brewing tea. Mikuru often has trouble talking to Kyon because many of the things he asks about are \"classified\". Mikuru is the mascot for the SOS Brigade, mainly as a way to attract attention. Because she is so popular, Haruhi uses her as eye candy."},{"spoiler":false,"text":"(Edited from the Haruhi Suzumiya wiki)"}],"source":"vndb","sourceCharacterId":"c85136"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f85878b1a61c9d6f56563079ab56c40563f4b5bb503865626450e518c5cefa3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/2023e561460c45c77103b561213f803105750e65c8fb188b2f4f05d671433371.webp","width":91,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤 邑子","creatorId":"vndb:s833","sourcePersonId":"vndb:s833","canonicalEntityId":"vndb:s833","name":"後藤邑子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7327","source":"vndb"}]},{"characterId":"char_vndb_c85137","characterName":"キョン","sourceIds":{"vndbCharacterId":"c85137"},"originalCharacterName":"キョン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kyon is the main protagonist of the series and primary narrator. He is the second person to join the SOS Brigade, and unintentionally gave Haruhi Suzumiya the idea to form the club. He is the \"fourth seat\" of the group. He is the only member of the group who is \"normal\", having no special abilities at all."},{"spoiler":false,"text":"(Edited from the Haruhi Suzumiya wiki)"}],"source":"vndb","sourceCharacterId":"c85137"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/004fbb3b10323533d9d32233469bd3f813ab009e8e38e441bac11fb26ad1cfd8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/8566db76aa531f45d9f8f425a7069df029592be748c5d0abce351abde7f6044f.webp","width":93,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杉田 智和","creatorId":"vndb:s370","sourcePersonId":"vndb:s370","canonicalEntityId":"vndb:s370","name":"杉田 智和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7326","source":"vndb"}]},{"characterId":"char_vndb_c85138","characterName":"長門 有希","sourceIds":{"vndbCharacterId":"c85138"},"originalCharacterName":"長門 有希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuki Nagato is the third person to join the SOS Brigade. At first glance, she appears to be an introverted, taciturn bibliophile. She later reveals herself to Kyon as an alien created by the Data Overmind, and possesses supernatural powers as a result. She was sent to North High to watch over Haruhi Suzumiya, and over the course of her time there she comes to develop insights into being a person, as well as emotions (according to Kyon). She is commonly known by her surname \"Nagato\" (which is not unusual), as Kyon often called her by her surname, as opposed to how he almost always called Haruhi Suzumiya by her given name \"Haruhi\"."},{"spoiler":false,"text":"(Edited from the Haruhi Suzumiya wiki)"}],"source":"vndb","sourceCharacterId":"c85138"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/855be00fe44da20fdab66d1973feb1a6720037e1078e77d5e3f3d4475fffb98f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a19843d0be8e3f3bb7475bc5e2bb5595135e5e1f355b2c10215abb0ed6bb5a4c.webp","width":79,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茅原 実里","creatorId":"vndb:s1459","sourcePersonId":"vndb:s1459","canonicalEntityId":"vndb:s1459","name":"茅原 実里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7332","source":"vndb"}]},{"characterId":"char_vndb_c85139","characterName":"古泉一樹","sourceIds":{"vndbCharacterId":"c85139"},"originalCharacterName":"古泉一樹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Itsuki Koizumi is the fifth person to join the SOS Brigade, recruited by Haruhi Suzumiya because he fit with her idea of a \"mysterious transfer student\" after he was transferred into North High. He later reveals himself to Kyon as an espe