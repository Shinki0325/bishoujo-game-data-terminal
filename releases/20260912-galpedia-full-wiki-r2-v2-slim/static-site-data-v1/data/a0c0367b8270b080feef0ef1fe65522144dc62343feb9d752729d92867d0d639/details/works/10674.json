ndb:s1459","name":"茅原 実里","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:14698","source":"vndb"},{"creditedName":"平野 綾","creatorId":"vndb:s1500","sourcePersonId":"vndb:s1500","canonicalEntityId":"vndb:s1500","name":"平野 綾","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:14699","source":"vndb"},{"creditedName":"ヤスカワ ショウゴ","creatorId":"vndb:s12408","sourcePersonId":"vndb:s12408","canonicalEntityId":"vndb:s12408","name":"ヤスカワ ショウゴ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:14703","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c72530","characterName":"涼宮 ハルヒ","sourceIds":{"vndbCharacterId":"c72530"},"originalCharacterName":"涼宮 ハルヒ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Suzumiya Haruhi is the title character, the main female protagonist of the series, and leader of the SOS Brigade whose energetic and eccentric character proves to be the driving force for the series. She has a mind for adventure which often leads her subordinates to be swept into her plans. While being smart, beautiful, and energetic Haruhi was eyed as an oddball ever since middle school: She set all the desks from her classroom out into the hallway, painted stars on the roofs, and even painted a huge hieroglyph on the school field (though this was later shown to be Kyon). Haruhi cannot stand boredom so she comes up with activities for the SOS Brigade, making them participate whether they like it or not. In the sixth grade, Haruhi felt she was no longer special after going to a baseball game and realizing she was one in a sea of people. After that she set out to make her life interesting and unique. What Haruhi does not know is that she has an outstanding power to change the environment around her as she pleases. By subconsciously using it, she gathers Asahina Mikuru, Koizumi Itsuki, and Nagato Yuki into one place: the SOS Brigade. The story is indirect in saying how much Yuki, Mikuru and Itsuki know about each other."}],"source":"vndb","sourceCharacterId":"c72530"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47d4f0b3e8496bce670eb00199cc131ae3383836a984ad413ea207aa836306ea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6c4784d515caad6d984ee9bfa966065e5b52ca4f2e6ed3ef17a0efd24b8c7d6.webp","width":184,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平野 綾","creatorId":"vndb:s1500","sourcePersonId":"vndb:s1500","canonicalEntityId":"vndb:s1500","name":"平野 綾","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7333","source":"vndb"}]},{"characterId":"char_vndb_c80807","characterName":"喜緑 江美里","sourceIds":{"vndbCharacterId":"c80807"},"originalCharacterName":"喜緑 江美里","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/055756606b7a5da3547dd32086abd94780f88a3320a2a959a37ade5fb4332a2d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/0062ba1ff3f793b8f0e5287fc6412998133f815eb7721871ae55129f13aef8e4.webp","width":186,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白鳥由里","creatorId":"vndb:s10441","sourcePersonId":"vndb:s10441","canonicalEntityId":"vndb:s10441","name":"白鳥由里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","rel