94"},"originalCharacterName":"高井 梓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"音楽教師。人妻（新婚）。"},{"spoiler":false,"text":"いいところの令嬢で特に大きな不幸もなく育ってきた。"},{"spoiler":false,"text":"中学・高校と吹奏楽部に所属し（フルート）、音大に進学。"},{"spoiler":false,"text":"フルートを続けコンクール入賞経験もある。"},{"spoiler":false,"text":"純粋培養で育ってきたため、性格は穏やか。押しが弱く、流されやすい。"},{"spoiler":false,"text":"常に笑顔を絶やさず、男子生徒や男性教師の人気者。"},{"spoiler":false,"text":"結婚を残念に思っている者も多い。"}],"source":"egs","sourceCharacterId":"13747","sourceWorkId":"11245","spoiler":false},{"segments":[{"spoiler":false,"text":"良家の令嬢で、特に大きな不幸もなく育ってきた女性。"},{"spoiler":false,"text":"性格はおっとりしていて、時に優柔不断と呆れられるほどの優しさを持っている。"},{"spoiler":false,"text":"常に笑顔を絶やさず、教師、学生を問わず男性陣から多大なる人気を集める。"},{"spoiler":false,"text":"中学・高校と吹奏楽部に所属し、音大に進学。"},{"spoiler":false,"text":"大学で同じ楽団に所属していた友人・高井浩介から告白されて交際、すでに入籍も済ませた。"},{"spoiler":false,"text":"いよいよ結婚式も迫り、学生や同僚から冷やかされる幸福な日々を送っている。こんなに幸せでいいのかな……と不安になるほど。"}],"source":"bangumi","sourceCharacterId":"93098"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f604bb7cc8d501468c3fb2aa171187cc19d71bb2c2df84810b295f7b6036eaa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5ff46dede49bc9c925dbbcc47ec8f78f935fd7d049e1c6aa08de5f57008fc141.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茉雪千鶴","creatorId":"vndb:s801","sourcePersonId":"vndb:s801","canonicalEntityId":"vndb:s801","name":"茉雪 千鶴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:46536:93098:6304:1","source":"bangumi"}]},{"characterId":"char_c48995","characterName":"上丘 梨央","sourceIds":{"bangumi":[{"characterId":"93103","match":"exact-normalized-name-in-linked-work