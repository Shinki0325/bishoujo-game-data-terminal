false,"text":"今どき珍しい大和撫子である。"},{"spoiler":false,"text":"勉強も運動も中の上といったところで、本人曰く『器用貧乏』。"},{"spoiler":false,"text":"誰よりも優しく、困った人は見過ごせないという、少し損な性格をしている。"},{"spoiler":false,"text":"しかしそんな彼女だからこそ誰からも愛されている。"},{"spoiler":false,"text":"もしもカレシができれば、間違いなく尽くすタイプ。"},{"spoiler":false,"text":"老舗和菓子屋「みなみや」の一人娘で、放課後や休日は女中姿に身を包み、家の手伝いをしている。"},{"spoiler":false,"text":"彼女の抜群の風貌もあり、常連客たちからは和風美女な看板娘として名高い。"}],"source":"egs","sourceCharacterId":"8029","sourceWorkId":"22917","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同じクラス、2年B組のクラスメイト。 今どき珍しい大和撫子。"},{"spoiler":false,"text":"勉強も運動も中の上といったところで、本人曰く “器用貧乏”。"},{"spoiler":false,"text":"誰よりも優しく、困った人は見過ごせないという、少し損な性格をしている。"},{"spoiler":false,"text":"しかしそんな彼女だからこそ誰からも愛されている。 間違いなく尽くすタイプ。"},{"spoiler":false,"text":"老舗和菓子屋 『みなみや』 の一人娘で、放課後や休日は家業の手伝いをしている。"},{"spoiler":false,"text":"彼女の抜群の風貌もあり、常連客たちからは和風美女な看板娘として名高い。"},{"spoiler":false,"text":"「“三波”がやってるお店だから『みなみや』。 そのままでしょう？」"}],"source":"bangumi","sourceCharacterId":"38523"}],"profileFacts":[{"label":"喜欢","source":"bangumi","sourceCharacterId":"38523","value":"和菓子、読書"},{"label":"特技","source":"bangumi","sourceCharacterId":"38523","value":"暗算"},{"label":"讨厌","source":"bangumi","sourceCharacterId":"38523","value":"操作の難しい機械"},{"label":"趣味","source":"bangumi","sourceCharacterId":"38523","value":"料理（特にお菓子作り）"},{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"8029","sourceWorkId":"22917","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"8029","sourceWorkId":"22917","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"8029","sourceWorkId":"22917","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"8029","sourceWorkId":"22917","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourc