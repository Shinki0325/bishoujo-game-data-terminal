characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1221"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"O"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Taking care of her siblings, listening to music (anime songs)"},{"spoiler":false,"text":"Skills: Her jumping ability"},{"spoiler":false,"text":"Likes: Exercise in general, dishes made from wild vegetables"},{"spoiler":false,"text":"Dislikes: Greasy things (she hates getting fatter)"},{"spoiler":false,"text":"A third-year student and the girls' basketball club's president. She is very kind, friendly, has excellent grades, and has also an exceptional body, which has made her very popular with her peers. She has the talent of motivating almost anybody with her words."}],"source":"vndb","sourceCharacterId":"c42354"},{"segments":[{"spoiler":false,"text":"学園の３年生。女子バスケ部の主将。"},{"spoiler":false,"text":"一言で言うなら『優しさの塊』のような存在。"},{"spoiler":false,"text":"失敗した人には「よしよし」と慰め、成功した人には「次ももっと頑張ろう！」と言って、自然と人をやる気にさせる力を持つ。"},{"spoiler":false,"text":"おっとりとした性格の反面、いざバスケの試合になるとキリリと引き締まった表情でポイントガード（司令塔）としてゲームメイクしていく、チームの中心人物。"},{"spoiler":false,"text":"成績優秀、運動神経抜群、そして抜群のプロポーションという、これ以上ないパーフェクトな存在として羨望の的となっている"}],"source":"egs","sourceCharacterId":"8031","sourceWorkId":"22917","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の3年生で、女子バスケ部の主将。 一言で言うと “優しさの塊” のような存在。"},{"spoiler":false,"text":"失敗した人は 「よしよし」 と慰め、成功した人には 「次も頑張ろう！」 と言って、自然と人をやる気にさせる力を持つ。"},{"spoiler":false,"text":"成績優秀、運動神経抜群、そして抜群のプロポーションを持ち、これ以上ないパーフェクトな存在として羨望の的となっている。"},{"spoiler":false,"text":"バスケ部ではポイントガード（司令塔）としてゲームメイクをするチームの中心人物。"},{"spoiler":false,"text":"おっとりとした性格の反面、試合中はキリリと引き締まった表情を見せる。"},{"spoiler":false,"text":"「よかったら、一緒にバスケの練習しない？」"}],"source":"bangumi","sourceCharacterId":"38525"}],"profileFacts":[{"label":"喜欢","source":"bangumi","sourceCharacterId":"38525","value":"運動全般、山菜料理"},{"label":"特技","source":"bangumi","sourceCharacterId":"38525","value":"ジャンプ力の高さ"},{"label":"讨厌","source":"bangumi","sourceCharacterId":"38525","value":"脂っこいもの（好きだけど太るから）"},{"label":"趣味","source":"bangumi","sourceCharacterId":"38525","value":"姉弟の世話、音楽鑑賞（邦楽・アニソン）"},{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"8031","sourceWorkId":"22917","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"8031","sourceWorkId":"22917","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"166 cm","valueContext":null,"source":"egs","sourceCharacterId":"8031","sourceWorkId":"22917","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"8031","sourceWorkId":"22917","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"8031","sourceWorkId":"22917","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a88027054d11a9d00fbb7d97a0a5baadb332d4d3fe0acb2eec436176f1acf66f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40e5ee379d3928a029a0cadf8672f7eb32a8bd683ad14a30bd48e92587cb9a95.webp","width":90,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:158422:38525:6359:1","source":"bangumi"}]},{"characterId":"char_c42945","characterName":"綾瀬 透華","sourceIds":{"bangumi":[{"characterId":"38526","match":"exact-normalized-name-in-linked-work","subjectId":"158422"}],"egsCharacterIds":["8032"],"vndbCharacterId":"c42945"},"originalCharacterName":"綾瀬 透華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"303"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"A"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Seaside strolling"},{"spoiler":false,"text":"Skills: Playing the piano"},{"spoiler":false,"text":"Likes: Children, classical music"},{"spoiler":false,"text":"Dislikes: Insects, summer (hot seasons)"},{"spoiler":false,"text":"The school's newly appointed music teacher. Confident and pretty mischievous, she can also be emphatetic and is supportive of her students. Due to her caring nature, she has gained popularity quickly among the students. The students often ask love advice from Touka, but she keeps it a secret that she has never had boyfriend nor any kind of experience in love."}],"source":"vndb","sourceCharacterId":"c42945"},{"segments":[{"spoiler":false,"text":"新任の音楽教諭。"},{"spoiler":false,"text":"まだ赴任したばかりだというのに、その茶目っ気の強い性格と、"},{"spoiler":false,"text":"生徒たちへ親身になるスタンスのおかげで、異様なスピードで生徒たちの信頼を得るようになる。"},{"spoiler":false,"text":"女子たちから恋愛相談をされることも多いらしい。"},{"spoiler":false,"text":"ただし当人にも恋愛経験はないため、その辺りは正直に伝えて「一般論」でアドバイスしているのだが、それはそれで「私たちと同じ目線でアドバイスをくれる相手」として女子たちの評価に繋がっているらしい。"}],"source":"egs","sourceCharacterId":"8032","sourceWorkId":"22917","spoiler":false},{"segments":[{"spoiler":false,"text":"新任の音楽教諭。"},{"spoiler":false,"text":"茶目っ気は強いが親身に接するスタンスで、早くも教え子たちの信頼を得ている。"},{"spoiler":false,"text":"女子から恋愛相談をされることも多いが、"},{"spoiler":false,"text":"自身に恋愛経験がないことを正直に伝えて、一般論でアドバイスしている。"},{"spoiler":false,"text":"それが “同じ目線でアドバイスをくれる相手” と、好評を博している。"},{"spoiler":false,"text":"「いいのよ。 リラックスして？　怖くないわよ？」"}],"source":"bangumi","sourceCharacterId":"38526"}],"profileFacts":[{"label":"喜欢","source":"bangumi","sourceCharacterId":"38526","value":"子ども、音楽（クラシック）"},{"label":"特技","source":"bangumi","sourceCharacterId":"38526","value":"ピアノ（絶対音感がある）"},{"label":"讨厌","source":"bangumi","sourceCharacterId":"38526","value":"虫、暑い季節"},{"label":"趣味","source":"bangumi","sourceCharacterId":"38526","value":"海辺を散策"},{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"8032","sourceWorkId":"22917","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"8032","sourceWorkId":"22917","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"8032","sourceWorkId":"22917","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"8032","sourceWorkId":"22917","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"8032","sourceWorkId":"22917","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a51ad971f1602327e5bb1ccd2807c48a55cc72e05d51d3f4a9e9b7c02ddb36c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd10f4906a2ec611d53751fa