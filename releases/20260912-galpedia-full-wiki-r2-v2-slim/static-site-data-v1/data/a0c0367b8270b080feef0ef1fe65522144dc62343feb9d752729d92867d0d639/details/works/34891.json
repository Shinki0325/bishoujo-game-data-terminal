看護師の資格を持つ彼女は、パークの救護スタッフでもある。"},{"spoiler":false,"text":"見るからに「優しそうな人」で、包容力と責任感のある、ちゃんとした大人。"},{"spoiler":false,"text":"一方で自分の主張が弱く、誰かがやなくちゃいけない仕事をいつも引き受けてしまう。"},{"spoiler":false,"text":"細かいところを気にするたちで、計画性もあるのに、"},{"spoiler":false,"text":"なぜか重要なところでミスをするドジっ子でもある。"},{"spoiler":false,"text":"学園に赴任してきたばかりではあるが、学生時代はパーク内でバイトしていた。"},{"spoiler":false,"text":"そのため、主人公や主人公の母親（社長）とはそれなりに長い付き合い。"},{"spoiler":false,"text":"5年前に主人公の家庭教師を務めていたが、"},{"spoiler":false,"text":"主人公の学力は一向に上がらなかった。"}],"source":"bangumi","sourceCharacterId":"136140"}],"profileFacts":[{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"24842","sourceWorkId":"34891","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"24842","sourceWorkId":"34891","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"24842","sourceWorkId":"34891","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"24842","sourceWorkId":"34891","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b1f71620928f512048260289da4d069f8c1cb8df5625fe98a55ddc776d91ebe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55fc0facec5fb51c4e7e53537b454c1fb30eae937b2c1978d26fdb48967daede.webp","width":99,"height":256,"source":"static-detail"},"actors":[{"creditedName":"乙葉紅","creatorId":"vndb:s42773","sourcePersonId":"vndb:s42773","canonicalEntityId":"vndb:s42773","name":"乙葉紅","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:95779","source":"vndb"}]},{"characterId":"char_c129248","characterName":"舞浜 鏡子","sourceIds":{"bangumi":[{"characterId":"136167","match":"exact-normalized-name-in-linked-work","subjectI