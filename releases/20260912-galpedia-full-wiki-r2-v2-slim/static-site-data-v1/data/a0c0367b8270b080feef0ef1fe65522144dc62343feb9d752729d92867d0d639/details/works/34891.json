criptions":[{"segments":[{"spoiler":false,"text":"Sumito's younger sister by one year."},{"spoiler":false,"text":"Yuriko plays the lead role in the \"Dream Garden\" musicals and, despite still being a student, she's already a professional-level dancer. Contrary to her appearance, she's always composed and confident, which has earned her a sort of charismatic presence."},{"spoiler":false,"text":"Yuriko is adept at understanding the essence of matters and discerning others' desires. She enjoys seeing the troubled faces of those she likes, often setting up cute pranks and then watching their reactions with a mischievous grin."},{"spoiler":false,"text":"Specialty: Skilled in discerning hidden desires"},{"spoiler":false,"text":"Hobby: Assisting others in realizing their wishes"},{"spoiler":false,"text":"Likes: Tea"},{"spoiler":false,"text":"Dislikes: Coffee"},{"spoiler":false,"text":"Academic Skills: Excellent"},{"spoiler":false,"text":"Athletic Abilities: Outstanding"},{"spoiler":false,"text":"Domestic Skills: Capable, yet a reluctant homemaker"},{"spoiler":false,"text":"Weak Point: Not a morning person"}],"source":"vndb","sourceCharacterId":"c129244"},{"segments":[{"spoiler":false,"text":"澄人の1歳年下の妹。"},{"spoiler":false,"text":"『ドリームガーデン』でのミュージカルでは主役を務めており、学生でありながら、すでにプロ級のダンサーでもある。"},{"spoiler":false,"text":"見た目に反し、いつも余裕があり、自信たっぷりに振る舞うため、ある種のカリスマ性を獲得してしまっている。"},{"spoiler":false,"text":"物事の本質や、他人の欲望を見抜くのが得意。"},{"spoiler":false,"text":"好きな人の困った顔を見るのが好きで、可愛い悪戯を仕掛けては、ニヤニヤしながら相手の反応を眺めている。"}],"source":"egs","sourceCharacterId":"24841","sourceWorkId":"34891","spoiler":false},{"segments":[{"spoiler":false,"text":"「くすくす。お兄ちゃんってば、いつも大げさなんだから」"},{"spoiler":false,"text":"澄人の1歳年下の妹。"},{"spoiler":false,"text":"『ドリームガーテン』でのミュージカルでは主役を務めており、"},{"spoiler":false,"text":"学生でありながら、すでにプロ級のダンサーでもある。"},{"spoiler":false,"text":"見た目に反し、いつも余裕があり、自信たっぷりに振る舞うため、"},{"spoiler":false,"text":"ある種のカリスマ性を獲得してしまっている。"},{"spoiler":false,"text":"物事の本質や、他人の欲望を見拔くのが得意。"},{"spoiler":false,"text":"好きな人の困った顔を見るのが好きで、可愛い恶戯を仕掛けては、"},{"spoiler":false,"text":"ニヤニヤしながら相手の反応を眺めている。"}],"source":"bangumi","sourceCharacterId":"136139"}],"profileFacts":[{"label":"胸围（本版本）","value":"72 cm","valueContext":null,"source":"egs","sourceCharacterId":"24841","sourceWorkId":"34891","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"147 cm","valueContext":null,"source":"egs","sourceCharacterId":"24841","sourceWorkId":"34891","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"24841","sourceWorkId":"34891","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"49 cm","valueContext":null,"source":"egs","sourceCharacterId":"24841","sourceWorkId":"34891","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afce443d9de7623b1116667472e697e8a90819f61cc430e6084c6f24bbd1c642.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58367e253766e8cfb2560f3da6f80cd7d6d3fc7bd7c0eb6bf43188588694ea86.webp","width":73,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:451131:136139:4937:1","source":"bangumi"}]},{"characterId":"char_c129246","characterName":"葛西 望々","sourceIds":{"bangumi":[{"characterId":"136140","match":"exact-normalized-name-in-linked-work","subjectId":"451131"}],"egsCharacterIds":["24842"],"vndbCharacterId":"c129246"},"originalCharacterName":"葛西 望々","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"824"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":