c68a155db9c272c12f3edd4dbc2884de202f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69a2cef67c79530462052a7a8e041a034c6755bf44da0446b6de064181fd7c17.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安田未央","creatorId":"vndb:s25","sourcePersonId":"vndb:s25","canonicalEntityId":"vndb:s25","name":"安田 未央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:170418:93139:4957:1","source":"bangumi"}]},{"characterId":"char_c9159","characterName":"紀碕 すみれ","sourceIds":{"bangumi":[{"characterId":"93140","match":"exact-normalized-name-in-linked-work","subjectId":"170418"}],"egsCharacterIds":["27418"],"vndbCharacterId":"c9159"},"originalCharacterName":"紀碕 すみれ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。"},{"spoiler":false,"text":"いつもオドオドしている気弱な女の子。"},{"spoiler":false,"text":"暗所、閉所恐怖症で、その原因であった親元から離れ、舞台となる学園にやってきたが、そこでもイジメに遭い、心を閉ざしてしまった。"},{"spoiler":false,"text":"担任教諭の香村小百合から薦められ、水泳部に入部し、心身を鍛えようと頑張っているようだ。"}],"source":"egs","sourceCharacterId":"27418","sourceWorkId":"2660","spoiler":false},{"segments":[{"spoiler":false,"text":"≪過去の経験から被害妄想に囚われてる虐められっ子の自我復活≫"},{"spoiler":false,"text":"両親の仲が悪く、特に幼少の頃に父親から受けた折檻がトラウマになっていて、狭いところ暗いところでは恐怖のために混乱する。高校進学にあたり両親の元から離れようと自ら、全寮制の桜ヶ丘学園に通うことを決めたのだが、不幸にも虐めでさらに心を閉ざしてしまう。今では寮の自分の部屋でも恐怖に心が落ち着かなくなっている有り様。仕方なく暫定的に小百合がすみれに付き添う形で寮生活を送っている。また身体を動かしたほうがよいと考えた小百合は自分が顧問をしている水泳部への入部を薦め、授業が終わった後は積極的に指導している。"},{"spoiler":false,"text":"備　考 ： 部活中に地震があったため、スイミングウエアで行動することに。"}],"source":"bangumi","sourceCharacterId":"93140"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/096caa0faae12fba12586293adf583eaaaa6d9a3442ff8319092fd33f8b3c243.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a13ffc3505df38cfb196a5c2b8799c6189897a17fb33a7d4653118fba4c254ac.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:170418:93140:4937:1","source":"bangumi"}]},{"characterId":"char_c9160","characterName":"千寿 水羽","sourceIds":{"bangumi":[{"characterId":"93141","match":"exact-normalized-name-in-linked-work","subjectId":"170418"}],"egsCharacterIds":["27419"],"vndbCharacterId":"c9160"},"originalCharacterName":"千寿 水羽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の後輩。"},{"spoiler":false,"text":"有数の財閥「千寿グループ」の一人娘。"},{"spoiler":false,"text":"内気で恥ずかしがり屋の女の子。"},{"spoiler":false,"text":"ふとしたことから主人公を好きになってしまうが、奥手な性格から告白する勇気もなく、ただ遠くから見つめるだけ……。"},{"spoiler":false,"text":"そうしたことから、活動的な女の子になりたくてテニス部に入部する。"}],"source":"egs","sourceCharacterId":"27419","sourceWorkId":"2660","spoiler":false},{"segments":[{"spoiler":false,"text":"≪自分に自信がなく引っ込み思案なおとなしいお嬢様の殻破り≫"},{"spoiler":false,"text":"おとなしい女の子で恥かしがり屋。千寿家はこの桜ヶ丘学園創設時にも出資している財閥で、水羽はその一人娘。家にまつわるいろいろな面で自分の生き方を思い悩んでいる。この学園に進学して間もなくふとしたきっかけで慎一に恋心を抱いた。しかしそのまま告白する勇気もなく、いつも遠くから見ている日々。引っ込み思案な性格を直すためにという親の薦めもあり、部活は活動的なテニスに入部したのだが得意ではない。"},{"spoiler":false,"text":"備　考 ： テニス部活動中に地震が起こったため、テニスルックのまま。"}],"source":"bangumi","sourceCharacterId":"93141"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e81011184c6f7aefe42efc97b66710a9159c7f8308bb45360a814883bce3b32.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/558bab1c558694947e570b6311ebd9979e23120420fa9c5467090db306861651.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本井えみ","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:170418:93141:4177:1","source":"bangumi"}]},{"characterId":"char_c9161","characterName":"香村 小百合","sourceIds":{"bangumi":[{"characterId":"93142","match":"exact-normalized-name-in-linked-work","subjectId":"170418"}],"egsCharacterIds":["27420"],"vndbCharacterId":"c9161"},"originalCharacterName":"香村 小百合","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の前年度の担任教諭。"},{"spoiler":false,"text":"正義感が強く、情熱的な女性。"},{"spoiler":false,"text":"新米の体育教諭で、学生達と年齢も近く、美人で気さくなところから人気が高い。"}],"source":"egs","sourceCharacterId":"27420","sourceWorkId":"2660","spoiler":false},{"segments":[{"spoiler":false,"text":"≪理想の実現を目指す自己犠牲精神の強い熱血女教師の勇気≫"},{"spoiler":false,"text":"大学卒業後すぐに母校桜ヶ丘学園に就任した新米体育教師。人気がある優しい女性。正義感が強い。一人暮らしの独身。彼氏はいたが、この地震のために連絡が取れず今は連絡不通状態。性体験はあるものの、教師という仕事に就いているせいもあり、貞操観念が強く、SEXに関してもわりと古い考えの持ち主。その分、豊満な身体をもてあましてる部分もあり、本人の悩み。"}],"source":"bangumi","sourceCharacterId":"93142"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7444a41478dc7a2c84caf09cacacf2bbea84b13b01b9325ee64f24691d06df4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3ce15808660c6155dfe2bd22d83a2c16b273aa31c9d040529f7c0ff1ec83080.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松田美菜","creatorId":"vndb:s1118","sourcePersonId":"vndb:s1118","canonicalEntityId":"vndb:s1118","name":"松田 美菜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:170418:93142:67452:1","source":"bangumi"}]},{"characterId":"char_c9162","characterName":"星 蓮実","sourceIds":{"bangumi":[{"characterId":"93144","match":"exact-normalized-name-in-linked-work","subjectId":"170418"}],"egsCharacterIds":["27421"],"vndbCharacterId":"c9162"},"originalCharacterName":"星 蓮実","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と前年度同じクラスだった女の子。"},{"spoiler":false,"text":"感受性の強い性格から、相手の思っていることが言動や仕草から何かと感じやすい。"},{"spoiler":false,"text":"すみれを苛めている中心的な人物だが、どうやら彼女の両親が離婚したことが、ひとつの原因のひとつになっているようだが……。"}],"source":"egs","sourceCharacterId":"27421","sourceWorkId":"2660","spoiler":false},{"segments":[{"spoiler":false,"text":"≪人一倍感受性が強いゆえに誤解されやすい少女の心の支え≫"},{"spoiler":false,"text":"学業のみならず、頭脳明晰で言葉や仕草から人の心を読めてしまう。もともとは心遣いというプラスの面になってたのだが、両親の離婚問題が起こってからはどんどんマイナスの面に働くことが増えた。両親が不仲で離婚話も持ち上がって早一年。両親はすでに別居状況。すみれと逆に蓮実は多情で淫乱な性癖を持つ母親を憎み、その血を受け継いだ自分の性癖を恐れ、女の貪欲な性そのものを憎んでいる。父親の経済で学園に通っていたが、離婚話が持ち上がるのと同時に仕事が暗礁に乗り上げ、その後は蓮実との連絡も途絶えがちになる。すみれへの虐めは母親への憎しみの転嫁とやりきれない寂しさから。"}],"source":"bangumi","sourceCharacterId":"93144"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/9251b6607533d7715c6d9e49d2bb1d00df0e69e515983fb9d8a740e455029429.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89029f0111d4c070b8a5f95709a3ca69c28ac1865bdaea837c860c9a780d4393.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"原 由菓","creatorId":"vndb:s1112","sourcePersonId":"vndb:s1112","canonicalEntityId":"vndb:s1112","name":"原 由菓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19103","source":"vndb"}]},{"characterId":"char_c9252","characterName":"上篠 絵理華","sourceIds":{"bangumi":[{"characterId":"93145","match":"exact-normalized-name-in-linked-work","subjectId":"170418"}],"egsCharacterIds":["27422"],"vndbCharacterId":"c9252"},"originalCharacterName":"上篠 絵理華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"男性よりも綺麗な女性を好むレズ的傾向のある女の子。"},{"spoiler":false,"text":"自分の欲望に忠実で、自己中心的。"},{"spoiler":false,"text":"主人公に対しては反抗心剥き出しで接して来るようだが……。"}],"source":"egs","sourceCharacterId":"27422","sourceWorkId":"2660","spoiler":false},{"segments":[{"spoiler":false,"text":"慎一の後輩。"},{"spoiler":false,"text":"男性よりも綺麗な女性が好きな女の子。"},{"spoiler":false,"text":"好みの美人には甘えた態度をとるが慎一には"},{"spoiler":false,"text":"反抗心むき出しで接してくる。"},{"spoiler":false,"text":"男性経験がないわけではないらしい。"},{"spoiler":false,"text":"自分の欲望に忠実で一方的な性格なので"},{"spoiler":false,"text":"あまり人の話を聞いていないフシがある。"}],"source":"bangumi","sourceCharacterId":"93145"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f58502e5c45b177c1c3d1a4c24abcbef8fdfcedf94611891c9fb27c7ce7581a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13ddfb4cafb631bac3f9f13dd0f81e9af1d6cb2f12b84ab6717cae21de8d2aa6.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:170418:93145:4490:1","source":"bangumi"}]},{"characterId":"char_c9253","characterName":"納野宮 響","sourceIds":{"bangumi":[{"characterId":"93146","match":"exact-normalized-name-in-linked-work","subjectId":"170418"}],"egsCharacterIds":["27423"],"vndbCharacterId":"c9253"},"originalCharacterName":"納野宮 響","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の同級生。"},{"spoiler":false,"text":"快楽主義者で「今が良ければそれで良い」という考えの持ち主で、何かとトラブルを起こす。"},{"spoiler":false,"text":"束縛されるのもするにも基本的に嫌い、自由奔放。"}],"source":"egs","sourceCharacterId":"27423","sourceWorkId":"2660","spoiler":false},{"segments":[{"spoiler":false,"text":"慎一の同級生。"},{"spoiler":false,"text":"快楽主義者で「今が良ければそれで良い」"},{"spoiler":false,"text":"と言う考えの持ち主。"},{"spoiler":false,"text":"セックスに目が無く、蓮実とは違った意味で"},{"spoiler":false,"text":"トラブルメーカー。"},{"spoiler":false,"text":"着替え中に地震にあった為、下着姿で慎一達と"},{"spoiler":false,"text":"行動をともにすることになる。"}],"source":"bangumi","sourceCharacterId":"93146"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1dc73ea172c9ce6bee3568b5995fdd90c63ad441d9b9a16c7817194137beda1b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b660d7f8fa6b7e3bec72a6a2e920d4fcbbd2f835fa2a4ac42984352662daf3e.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:170418:93146:4937:1","source":"bangumi"}]},{"characterId":"char_c9254","characterName":"阿久津 魔亜子","sourceIds":{"bangumi":[{"characterId":"93143","match":"exact-normalized-name-in-linked-work","subjectId":"170418"}],"egsCharacterIds":["27424"],"vndbCharacterId":"c9254"},"originalCharacterName":"阿久津 魔亜子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と吹雪の共通の幼馴染。"},{"spoiler":false,"text":"吹雪とは、「ふーちゃん」「魔亜ちゃん」と呼び合う仲。"},{"spoiler":false,"text":"主人公とは、家が隣同士ということもあり、姉弟同然に育ってきた。"}],"source":"egs","sourceCharacterId":"27424","sourceWorkId":"2660","spoiler":false},{"segments":[{"spoiler":false,"text":"≪年上女性との揺れ動く思慕の感情の行方と自分の未来探し≫"},{"spoiler":false,"text":"吹雪とは違う意味での幼馴染。幼少の頃から実家が隣同士のために慎一にとっては姉弟のような、それでいて親友のような関係。物事を深く考える頭の良いタイプでしっかり者。眼鏡っ子。この春大学を卒業し無事就職出来たが、その中でずっと付き合ってた恋人とつい最近別れてしまったという状況。休みを利用して慎一をおちょくりに（実際には話を聞いてもらおうと）学園に来ていた。"}],"source":"bangumi","sourceCharacterId":"93143"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afa475ed13d1c20a0f243fd82c4e1872da0e37b85be18070f1559f6f33a6a7de.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d3eb2bb20a2106df85afe262900de5c919d66fd8d8b06f327f078c76652c008.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中山依里子","creatorId":"vndb:s46185","sourcePersonId":"vndb:s46185","canonicalEntityId":"vndb:s46185","name":"中山 依里子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:170418:93143:20943:1","source":"bangumi"},{"creditedName":"GUNTA","creatorId":"vndb:s1107","sourcePersonId":"vndb:s1107","canonicalEntityId":"vndb:s1107","name":"GUNTA","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19102","source":"vndb"}]},{"characterId":"char_c9255","characterName":"河原 苺","sourceIds":{"bangumi":[{"characterId":"93147","match":"exact-normalized-name-in-linked-work","subjectId":"170418"}],"egsCharacterIds":["27425"],"vndbCharacterId":"c9255"},"originalCharacterName":"河原 苺","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":