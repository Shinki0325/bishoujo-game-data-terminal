onId":"vndb:s47168","canonicalEntityId":"vndb:s47168","name":"Kaizerscythe","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:46776","source":"vndb"},{"creditedName":"Yuuyuun","creatorId":"vndb:s47169","sourcePersonId":"vndb:s47169","canonicalEntityId":"vndb:s47169","name":"Yuuyuun","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:46777","source":"vndb"},{"creditedName":"bigcookie","creatorId":"vndb:s47170","sourcePersonId":"vndb:s47170","canonicalEntityId":"vndb:s47170","name":"bigcookie","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:46778","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c4000","characterName":"主人公","sourceIds":{"vndbCharacterId":"c4000"},"originalCharacterName":"主人公","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second year High School student just transferred to Towano High School. Soon after he joins the library committee, the tennis club and a part time job at a family restaurant. He's the only character you can name in the game, and you may choose to refer in first person as ore (俺?) or boku (僕?) (both are the male form of \"I,\" although \"Ore\" is considered more masculine). In the Loveplus Rinko Days manga his name is Wataru Aikawa."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4000"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c4001","characterName":"高嶺 愛花","sourceIds":{"vndbCharacterId":"c4001"},"originalCharacterName":"高嶺 愛花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1005"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second year high school student who goes to the same after school tennis club with the protagonist. She comes from a well-off family and has lived a sheltered life, having no experience in many \"normal\" things like eating a hamburger combo, going out with her friends after the club, or watching TV. Her classmates shy away from her perfectionism, which is why she has few friends."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4001"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4372f849689ad00ecc9ec892dc398c8274e070f5a1577a045a5b78dedb486db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a63eba31e3f7425ca93b8b32b3c54a83673b78a9d614ba1836da67d1bfcf004e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"早見 沙織","creatorId":"vndb:s1871","sourcePersonId":"vndb:s1871","canonicalEntityId":"vndb:s1871","name":"早見 沙織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:25859","source":"vndb"}]},{"characterId":"char_vndb_c4002","characterName":"小早川 凛子","sourceIds":{"vndbCharacterId":"c4002"},"originalCharacterName":"小早川 凛子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"817"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first year high school student who the protagonist meets after being forced to join the library committee. She constantly wears earphones and has an attitude that keeps people away from her. Rinko's attitude stems from her feeling alienated and unwanted in her home after her father remarried, bringing a new mother and younger brother into the house. \"Whenever I am home, the atmosphere darkens\", as Rinko described. She wanders the streets after school, avoiding going back to an unwelcoming home. She likes punk rock and fighting games."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4002"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/801e0749e5bde37178d46daac09441630e21ab35824d742cf38f687ddaa7c4d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4a30412a2e5279be2c55070e09118ca44aab1d491b2c342665013df926560b1.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"丹下 桜","creatorId":"vndb:s4839","sourcePersonId":"vndb:s4839","canonicalEntityId":"vndb:s4839","name":"丹下桜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:25861","source":"vndb"}]},{"characterId":"char_vndb_c4003","characterName":"姉ヶ崎 寧々","sourceIds":{"vndbCharacterId":"c4003"},"originalCharacterName":"姉ヶ崎 寧々","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"420"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third year high school student working part-time in a family restaurant, where the protagonist meets her. She is the dependable big sister from whom everyone asks help. She has a mole under her right eye and likes housework and horror movies."},{"spoiler":false,"text":"In an early development setting she was meant to be a college student with light makeup. The latter remained part of her appearance during game release."},{"spoiler":false,"text":"from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4003"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e6913e0d70534fdc4d8da9a2b1052761e157c7359e8bebbcf988b6110e3153e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d7dbc933514e4236dfe35358a1c65751a41ac7710ff27d89f6bfd26ab1c9946.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"皆口 裕子","creatorId":"vndb:s1937","sourcePersonId":"vndb:s1937","canonicalEntityId":"vndb:s1937","name":"皆口 裕子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:25860","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p77","sourceCompanyId":"egs:brand:621","canonicalEntityId":"vndb:p77","name":"KONAMI","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:14571:621","source":"egs"},{"companyId":"vndb:p17654","sourceCompanyId":"vndb:p17654","canonicalEntityId":"vndb:p17654","name":"洗衣机翻汉化组","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:115602:v4006","source":"vndb"},{"companyId":"vndb:p17654","sourceCompanyId":"vndb:p17654","canonicalEntityId":"vndb:p17654","name":"洗衣机翻汉化组","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:130030:v4006","source":"vndb"},{"companyId":"vndb:p77","sourceCompanyId":"vndb:p77","canonicalEntityId":"vndb:p77","name":"KONAMI","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:50841:v4006","source":"vndb"},{"companyId":"vndb:p77","sourceCompanyId":"vndb:p77","canonicalEntityId":"vndb:p77","name":"KONAMI","roleCode