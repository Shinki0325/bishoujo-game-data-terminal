,"source":"vndb","sourceCharacterId":"c53946"},{"segments":[{"spoiler":false,"text":"フォルクロールに住み込みで働く女の子。学校に通うのに便利なので住ませてもらっている。"},{"spoiler":false,"text":"生真面目なしっかり者で、フォルクロールの大黒柱。"},{"spoiler":false,"text":"手先が不器用なうえ、甘いものが苦手というケーキ屋としては致命的な弱点がある。"},{"spoiler":false,"text":"休憩スペースで提供しているコーヒー、紅茶は彼女の担当。美味しいと評判。"},{"spoiler":false,"text":"クロウのことは困っているならと受け入れるものの早く家族のところに帰った方がいいと思っている。"}],"source":"egs","sourceCharacterId":"13644","sourceWorkId":"24409","spoiler":false},{"segments":[{"spoiler":false,"text":"フォルクロールに住み込みで働く少女。 お店は学園へ通うのにも便利。"},{"spoiler":false,"text":"生真面目なしっかり者で、フォルクロールの大黒柱。"},{"spoiler":false,"text":"しかし手先が不器用なうえ、甘いものが苦手というケーキ屋として致命的な弱点がある。"},{"spoiler":false,"text":"休憩スペースで提供しているコーヒーや紅茶は彼女の担当で、美味しいと評判。"},{"spoiler":false,"text":"突然現れたクロウを、困っているのならと受け入れるものの、"},{"spoiler":false,"text":"早く家族のもとへ帰ったほうが良いと思っている。"},{"spoiler":false,"text":"「あの、早く思い出して、家族のところに帰ったほうがいいですよ」"}],"source":"bangumi","sourceCharacterId":"47782"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"47782","value":"チョコレートケーキ、アールグレイ"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"47782","value":"甘いもの"},{"label":"胸围（本版本）","value":"71 cm","valueContext":null,"source":"egs","sourceCharacterId":"13644","sourceWorkId":"24409","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"146 cm","valueContext":null,"source":"egs","sourceCharacterId":"13644","sourceWorkId":"24409","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"13644","sourceWorkId":"24409","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"13644","sourceWorkId":"24409","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae1c3b2c1d4f0c4895bca26783e892b93f8e07f5d468d3241eb63d13016a446d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f643b88552ae448efe123c41ed13b9d4ebe588659867d7c02c110dc66c9909cd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"門脇舞以","creatorId":"vndb:s440","sourcePersonId":"vndb:s440","canonicalEntityId":"vndb:s440","name":"門脇 舞以","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:196255:47782:4402:1","source":"bangumi"}]},{"characterId":"char_c53947","characterName":"古倉 める","sourceIds":{"bangumi":[{"characterId":"47784","match":"exact-normalized-name-in-linked-work","subjectId":"196255"}],"egsCharacterIds":["13645"],"vndbCharacterId":"c53947"},"originalCharacterName":"古倉 める","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1224"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Sweet foods, kotatsu"},{"spoiler":false,"text":"Dislikes: Bitter foods"},{"spoiler":false,"text":"Favorite cake: Any cake"},{"spoiler":false,"text":"Meru is the granddaughter of the Folkroll store's manager. She tries her best to keep Folkroll going while her grandfather is in the hospital. She is curious about everything and gets Kurou to work at the shop to find out about his amnesiac past. She really loves sweets and can't be trusted to bake cakes, as she begins to taste them as soon as they appear in front of her. She is full of energy no matter how cold the day is. However, once she gets under the kotatsu, she likes to settle down and doesn't move for a while."},{"spoiler":false,"text":"Translated from DMM"}],"source":"vndb","sourceCharacterId":"c53947"},{"segments":[{"spoiler":false,"text":"フォルクロール店長の孫。祖父が入院しているあいだもフォルクロールを続けようとがんばっている。"},{"spoiler":false,"text":"何事にも興味津々で、記憶喪失のクロウの過去を探るために彼をお店に置く。"},{"spoiler":false,"text":"とにかく甘いものが大好きですぐつまみ食いしてしまうため、ケーキ作りは任せられない。"},{"spoiler":false,"text":"どんな寒い日でも元気いっぱい。ただおこたに入るとしばらくは絶対に動かなくなる。"}],"source":"egs","sourceCharacterId":"13645","sourceWorkId":"24409","spoiler":false},{"segments":[{"spoiler":false,"text":"芙克洛店长的孙女。自从爷爷住院以来，一直都在努力延续甜品店的经营。"},{"spoiler":false,"text":"好奇心旺盛，于是为了帮助失去记忆的九郎寻找他的过去，将他收留在了店里。"},{"spoiler":false,"text":"对甜品没有一点抗拒力，一没盯住就会偷吃，因此大家制作饼干的时候绝对不会叫上她。"},{"spoiler":false,"text":"天气多冷也精神百倍，可只要一钻进被炉就会老实得不行。"},{"spoiler":false,"text":"「ふんふん、クロウ君からは何やら謎の匂いを感じますな～」"}],"source":"bangumi","sourceCharacterId":"47784"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"47784","value":"ケーキ、あまいもの、おこた"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"47784","value":"にがいもの"},{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"13645","sourceWorkId":"24409","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"13645","sourceWorkId":"24409","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"13645","sourceWorkId":"24409","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"13645","sourceWorkId":"24409","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b2f7ea53cda87cb1eca838735c852a37fc0a2863fd00c689d5e30893c20d809.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77cb59f55936c1bd80309cababa0e160909b32119b496089e56d22c9c69e5c3b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原舞","creatorId":"vndb:s985","sourcePersonId":"vndb:s985","canonicalEntityId":"vndb:s985","name":"石原 舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:196255:47784:13372:1","source":"bangumi"}]},{"characterId":"char_c53948","characterName":"ショコラ・ネージュ","sourceIds":{"bangumi":[{"characterId":"47785","match":"exact-normalized-name-in-linked-work","subjectId":"196255"}],"egsCharacterIds":["13646"],"vndbCharacterId":"c53948"},"originalCharacterName":"ショコラ・ネージュ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"810"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Kurou's cakes"},{"spoiler":false,"text":"Dislikes: Studying"},{"spoiler":false,"text":"Favorite cake: Mille crêpes"},{"spoiler":false,"text":"The daughter of the president of a large company who has come to take over Folkroll. At first, she follows her brother and tries to shut down Folkroll, but after eating the cake made by Kurou, she turns into an ally of the shop. She is a customer, but if she is rewarded with a cake, she will do anything, including working as a waitress."},{"spoiler":false,"text":"Translated from DMM"}],"source":"vndb","sourceCharacterId":"c53948"},{"segments":[{"spoiler":false,"text":"フォルクロールを買収するためやってきたとある大企業の社長令嬢。"},{"spoiler":false,"text":"初めは兄に従いフォルクロールを潰そうとするが、クロウの作ったケーキを食べると一転してお店の味方に。"},{"spoiler":false,"text":"一応お客という立場だが、ケーキをご褒美にすれば店員など何でもやってくれる。"}],"source":"egs","sourceCharacterId":"13646","sourceWorkId":"24409","spoiler":false},{"segments":[{"spoiler":false,"text":"某企业为了收购芙克洛而派来的社长千金。"},{"spoiler":false,"text":"起初只是遵照哥哥的指示前来找茬，吃了九郎的蛋糕后便一下成为了芙克洛的忠实伙伴。"},{"spoiler":false,"text":"虽说是客人，雇她为店员却只需几块蛋糕。"},{"spoiler":false,"text":"「わああ、AMAGINGデスこのケーキ……♪」"}],"source":"bangumi","sourceCharacterId":"47785"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"47785","value":"クロウの作ったケーキ、ミルクレープ"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"47785","value":"勉強"},{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"13646","sourceWorkId":"24409","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"13646","sourceWorkId":"24409","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"13646","sourceWorkId":"24409","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"13646","sourceWorkId":"24409","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d1420186c6bbbf027a7af42222a2b2a9700ec4b9c14cd0d2d716f3a3fda7e19.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/abefa2ca70ef53696d6751059e84e2ca8748a75fb0aac364a66e7d6b1f48f8e9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜咲千依","creatorId":"vndb:s608","sourcePersonId":"vndb:s608","canonicalEntityId":"vndb:s608","name":"藤咲ウサ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:196255:47785:8990:1","source":"bangumi"}]},{"characterId":"char_c57459","characterName":"村崎 小町","sourceIds":{"bangumi":[{"characterId":"55348","match":"exact-normalized-name-in-linked-work","subjectId":"196255"}],"egsCharacterIds":[