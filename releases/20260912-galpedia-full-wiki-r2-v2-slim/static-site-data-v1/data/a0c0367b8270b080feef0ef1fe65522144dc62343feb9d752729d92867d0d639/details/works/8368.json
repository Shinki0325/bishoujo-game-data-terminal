creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:147859:209560:5906:1","source":"bangumi"}]},{"characterId":"char_c2340","characterName":"蓮水 伊万里","sourceIds":{"bangumi":[{"characterId":"209554","match":"exact-normalized-name-in-linked-work","subjectId":"147859"}],"egsCharacterIds":["24953"],"vndbCharacterId":"c2340"},"originalCharacterName":"蓮水 伊万里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"619"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"哀川家に仕えるメイドでありながら、主である主人公と身分違いの恋に落ちた少女。"},{"spoiler":false,"text":"ほぼ新妻同然に主人公と同棲中の彼女は、昼は撫子学園に通う、男女から人気のある優等生。"},{"spoiler":false,"text":"夜はちょっぴり甘えん坊な恋人であり、狭いアパートの一室で主人公との愛を育む。"},{"spoiler":false,"text":"おっとりとした性格で家事から裁縫まで完璧にこなす家庭的な彼女。"},{"spoiler":false,"text":"実はちょっぴりヤキモチ焼き。"},{"spoiler":false,"text":"スタイルも良く、どこまでも女の子らしい伊万里だが、運動音痴なのが唯一の悩み。"}],"source":"egs","sourceCharacterId":"24953","sourceWorkId":"8368","spoiler":false},{"segments":[{"spoiler":false,"text":"哀川家に仕えるメイドでありながら、主である主人公と身分違いの恋に落ちた少女。"},{"spoiler":false,"text":"彼女との同棲生活を中心に物語が始まる。"}],"source":"bangumi","sourceCharacterId":"209554"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e064c8be98e224176c22378a23269c2cdb7a9f323f4b83c84bd1f3e49acb283.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d01e4d168610b7d168451c1f65e0c2e161bbddd72c2e42ba2dba18cb561cd10a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:147859:209554:4463:1","source":"bangumi"}]},{"characterId":"char_c2341","characterName":"神楽坂 皐月","sourceIds":{"bangumi":[{"characterId":"209556","match":"exact-normalized-name-in-linked-work","subjectId":"147859"}],"egsCharacterIds":["24954"],"vndbCharacterId":"c2341"},"originalCharacterName":"神楽坂 皐月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1123"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"哀川家と並ぶ名家、神楽坂家の一人娘。"},{"spoiler":false,"text":"幼い頃から家柄に恥じない淑女になるよう、厳しい教育を受けている。"},{"spoiler":false,"text":"かつて哀川の屋敷で主人公に出会って以来、彼を兄として慕い続けている。"},{"spoiler":false,"text":"幼き日に交わした約束を信じて……。"},{"spoiler":false,"text":"他の誰よりも主人公が好きで、何かと理由をつけては毎日のように甘えてくる彼女。"},{"spoiler":false,"text":"抱きついてきたり、キスをねだったりと、行き過ぎたスキンシップを迫るのは、常に主人公に振り向いて欲しいという想いの表れ。"},{"spoiler":false,"text":"プライドが高く、高飛車な性格のため、好意を寄せていない相手に対しては冷たいという一面も持っている。"}],"source":"egs","sourceCharacterId":"24954","sourceWorkId":"8368","spoiler":false},{"segments":[{"spoiler":false,"text":"哀川家と並ぶ名家、「神楽坂」家の一人娘だが、実は養子で孤児院育ち。"},{"spoiler":false,"text":"○○のころ主人公に貰った「家族になってあげる」という言葉を信じ続けて、気丈に振舞っている。負けん気の○い女の子。"}],"source":"bangumi","sourceCharacterId":"209556"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41bbf3e2b301583668fa68675dc5644529db524f0e0afeb1dc66c305a710e2f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/6946e88d98f94cd448a3a57b12056c04c2cc48b34786744fd6c404930d309ca2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","