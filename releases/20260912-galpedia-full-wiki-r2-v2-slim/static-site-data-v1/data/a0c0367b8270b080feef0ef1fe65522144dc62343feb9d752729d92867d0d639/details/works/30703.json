me":"山野 詠子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:173126","source":"vndb"},{"creditedName":"おおむね 鶴川","creatorId":"vndb:s23243","sourcePersonId":"vndb:s23243","canonicalEntityId":"vndb:s23243","name":"おおむね 鶴川","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:173127","source":"vndb"},{"creditedName":"Tirami su Amore!","creatorId":"vndb:s23244","sourcePersonId":"vndb:s23244","canonicalEntityId":"vndb:s23244","name":"M-Arms","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:173129","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c96002","characterName":"ミータオ","sourceIds":{"vndbCharacterId":"c96002"},"originalCharacterName":"ミータオ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mi Tao is a stripper. Her childhood memories are vague and before she knew it, she ended up in the slums. There, she met Ryou, who's around the same age as her and their fates intertwined. Mi Tao is a very good dancer and when her body is pushed to its limits during rigorous dancing, she enters a peculiar trance. She often hums a tune even she herself has no idea where it comes from, though it's Ryou's lullaby. She loves Ryou and is the type to devote herself to her boyfriend."},{"spoiler":false,"text":"Translation of official website profile."}],"source":"vndb","sourceCharacterId":"c96002"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/830fa69e619f1aa4a96fa1fa8090af729566152e8c3cd64bd0009adc5d75d932.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/988720ed1ee24ab55039a66ea48e7e695a37f401ad844d3b9f8b8b01a74b6bf3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"手塚 りょうこ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87014","source":"vndb"}]},{"characterId":"char_vndb_c96003","characterName":"リョウ","sourceIds":{"vndbCharacterId":"c96003"},"originalCharacterName":"リョウ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mi Tao's childhood friend and the person who named her. Ryou met Mi Tao in the slums when they were both children and they lived together supporting one other. However, he eventually became addicted to the drugs that began to circulate nearby. Nowadays, Ryou has somehow managed to get back on his feet."},{"spoiler":false,"text":"Translation of official website profile."}],"source":"vndb","sourceCharacterId":"c96003"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6f0adf6ac898c8fcdc09ffd1f84c01da27ba409213b43f5d2e6738fd9ea4f8d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0aaf8b0f259fafa667096606c98deabcd829806451af6ccfa9ce8e17333d408f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三橋 渡","creatorId":"vndb:s15809","sourcePersonId":"vndb:s15809","canonicalEntityId":"vndb:s15809","name":"三橋 渡","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87015","source":"vndb"}]},{"characterId":"char_vndb_c96004","characterName":"ウツブシ","sourceIds":{"vndbCharacterId":"c96004"},"originalCharacterName":"ウツブシ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A wealthy man in his 30s, Utsubushi rapidly rose to prominence in this remarkably developed nation. His manner of speech is self-important. He's self-aware of his wealth and doesn't even try to hide it. Utsubushi visited the theater where Mi Tao works on a whim and became fixated on her, subsequently snooping around for information on her past and her current lifestyle."},{"spoiler":false,"text":"Translation of official website profile."}],"source":"vndb","sourceCharacterId":"c96004"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2ac96a7d603031d98abf87199463785c18b0829cfe0ad79ff78a656b7b3c08e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c876d4ea6eb7aed31eb7f9bdb344031e00942724783bee94764bf9e070182f0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"九財 翼","creatorId":"vndb:s19762","sourcePersonId":"vndb:s19762","canonicalEntityId":"vndb:s19762","name":"善財 達也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87016","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p9520","sourceCompanyId":"egs:brand:5936","canonicalEntityId":"vndb:p9520","name":"サキュレント","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:30703:5936","source":"egs"},{"companyId":"vndb:p9520","sourceCompanyId":"vndb:p9520","canonicalEntityId":"vndb:p9520","name":"サキュレント","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:109220:v30589","source":"vndb"},{"companyId":"vndb:p9520","sourceCompanyId":"vndb:p9520","canonicalEntityId":"vndb:p9520","name":"サキュレント","roleCodes":["develope