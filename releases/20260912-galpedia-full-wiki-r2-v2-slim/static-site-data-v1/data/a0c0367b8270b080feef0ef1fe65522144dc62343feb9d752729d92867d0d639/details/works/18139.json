entityStatus":"source-native","relationId":"vndb:vn-staff:96433","source":"vndb"},{"creditedName":"かつらぎ","creatorId":"vndb:s4147","sourcePersonId":"vndb:s4147","canonicalEntityId":"vndb:s4147","name":"かつらぎ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:96435","source":"vndb"},{"creditedName":"船亀 由真人","creatorId":"vndb:s4241","sourcePersonId":"vndb:s4241","canonicalEntityId":"vndb:s4241","name":"船亀 由真人","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:96437","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c25215","characterName":"槇村 一花","sourceIds":{"vndbCharacterId":"c25215"},"originalCharacterName":"槇村 一花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Dream big and aim to become a housing complex wife!\""},{"spoiler":false,"text":"Hayato's childhood friend and housing complex wife (candidate)."},{"spoiler":false,"text":"Her favorite phrase since childhood was \"My dream is to become a housing complex wife\", but when her parents had to transfer schools, she moved near Hayato's housing complex again, and applied for a housing complex wife position."},{"spoiler":false,"text":"They were safely reunited, and she became the first housing complex wife candidate."},{"spoiler":false,"text":"She has a clear and straightforward personality, and can speak properly even with people of higher rank."},{"spoiler":false,"text":"She is a typical girl of her age, who has a weakness for fashion and cute things, but has a special love for sweets."},{"spoiler":false,"text":"Her general housework skills are average, but she lost confidence when Kaede's skills were at a professional level."},{"spoiler":false,"text":"However, when it comes to sexual matters, she is proactive, and often encourages Kaede, making her quite active."},{"spoiler":false,"text":"She loves animals, and often joins in taking care of the cat that Hayato picked up."}],"source":"vndb","sourceCharacterId":"c25215"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc4b5ce74f4828500b027a7b83a528261028794e03e76f0a68ad2ec34a1aa4f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21128ca9d6f82e96b1f432230f550002bfa91a6a7c89c6de14d1993699c8d5a8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"萌花ちょこ","creatorId":"vndb:s564","sourcePersonId":"vndb:s564","canonicalEntityId":"vndb:s564","name":"ミルノ 純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51212","source":"vndb"}]},{"characterId":"char_vndb_c25216","characterName":"鬼龍院 楓","sourceIds":{"vndbCharacterId":"c25216"},"originalCharacterName":"鬼龍院 楓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"height":{"reviewState":"source-only","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I'm not worthy, but please take care of me\""},{"spoiler":false,"text":"A sudden apartment complex wife (candidate)."},{"spoiler":false,"text":"A Yamato Nadeshiko with long black hair and wearing a kimono."},{"spoiler":false,"text":"Although she is a respectable young lady from a noble family, her strong desire to become an apartment complex wife led her to apply."},{"spoiler":false,"text":"She was raised in a household where common sense was somewhat old-fashioned, doing things such as walking three steps behind a man and bowing with three fingers together at the entrance when greeting someone, so she herself has a chaste way of thinking."},{"spoiler":false,"text":"Therefore, she is also modest when it comes to sex, but she gradually begins to compete with Ichika, trying not to lose to her advances."},{"spoiler":false,"text":"She is skilled enough at general housework that even Ichika has given up on competing there, but she is not good with cats, and it is a source of worry for her that she cannot get in between Hayato and Ichika when they take care of them."}],"source":"vndb","sourceCharacterId":"c25216"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/129702d3c9fe6f1d849337abd912fa6ab5cecb6776dc97bd23f51899e485d4fa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f25127d73c83d0c5bc7a5198c997329202d6f50d156aed3b03a8fd0aafa088e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊 るな","creatorId":"vndb:s654","sourcePersonId":"vndb:s654","canonicalEntityId":"vndb:s654","name":"小暮 英麻","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51210","source":"vndb"}]},{"characterId":"char_vndb_c25217","characterName":"樋口 真名","sourceIds":{"vndbCharacterId":"c25217"},"originalCharacterName":"樋口 真名","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"source-only","source":"vndb","value":"150"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Is it ok if i call you Onii-chan?\""},{"spoiler":false,"text":"The younger sister of Hayato's badly-mannered friend."},{"spoiler":false,"text":"When their father transferred and their mother followed him, the siblings live alone in the same housing complex as Hayato."},{"spoiler":false,"text":"Perhaps because of her silly older brother, she grew up to be a reliable person, so she takes care of not only her brother but also Hayato, who is without parents."},{"spoiler":false,"text":"The more she sees her sloppy older brother, the more she admires Hayato, who is independent, and she has a slight crush on him."},{"spoiler":false,"text":"However, while she is keeping a close eye on the current housing complex wife commotion, she has decided to act as an oasis for him when he gets tired of their aggressive advances."},{"spoiler":false,"text":"She likes baths and takes them often, so she always smells of shampoo."},{"spoiler":false,"text":"Although she is annoyed with her brother, she does not abandon him, and she knows her place as a younger sister, so she is a kind girl who never uses violence or nasty remarks."}],"source":"vndb","sourceCharacterId":"c25217"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd22b25dcfd918dc34e0efd7b1a401eae67ef0739532533b6fd9276576c41dbc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14fd9e4f77d00aacd6fa2416fdba9a9b8b7fad4bf7c1ac49d4bd3bcfe9c30dff.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"早瀬 ゃょぃ","creatorId":"vndb:s936","sourcePersonId":"vndb:s936","canonicalEntityId":"vndb:s936","name":"早瀬 弥生","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51211","source":"vndb"}]},{"characterId":"char_vndb_c91712","characterName":"藤堂 隼人","sourceIds":{"vndbCharacterId":"c91712"},"originalCharacterName":"藤堂 隼人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"His parents passed away several years ago, and he inherited the apartment complex that was their asset, which he now runs."},{"spoiler":false,"text":"His management is neither good nor bad."},{"spoiler":false,"text":"However, he is worried about the recent decline in tenant applicants due to the recession."},{"spoiler":false,"text":"When spring comes, a large number of vacant rooms become available, so he places a large-scale advertisement to recruit tenants."},{"spoiler":false,"text":"In the middle of this, he remembers something from his childhood and half-jokingly adds \"Apartment wife wanted\" to the advertisement, which changes his life completely..."}],"source":"vndb","sourceCharacterId":"c91712"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1385","sourceCompanyId":"egs:brand:2671","canonicalEntityId":"vndb:p1385","name":"ALcotハニカム","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:18139:2671","source":"egs"},{"companyId":"vndb:p1385","sourceCompanyId":"vndb:p1385","canonicalEntityId":"vndb:p1385","name":"ALcot ハニカム","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vn