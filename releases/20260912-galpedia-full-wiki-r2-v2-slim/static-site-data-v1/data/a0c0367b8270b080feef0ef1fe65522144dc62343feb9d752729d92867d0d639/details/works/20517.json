648","characterName":"牛神様","sourceIds":{"bangumi":[],"egsCharacterIds":["3876"],"vndbCharacterId":"c26648"},"originalCharacterName":"牛神様","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"egs","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"教育の神、天神様の神獣で、とある理由から英吾にくっついて来てしまう。"},{"spoiler":false,"text":"神獣はブラックメルヘンとは敵対する立場にあり、ブラックメルヘンの野望を挫くべく英吾に協力する。"},{"spoiler":false,"text":"英吾が使える能力はすべてこの牛神様によるものである。"},{"spoiler":false,"text":"見た目はただのホルスタインだが、人語を話すことが出来る。"},{"spoiler":false,"text":"天神様の守護獣だけあって教育については一家言あり、どこからともなく現れては新米教師の英吾に一方的なアドバイスを告げて去っていく。"},{"spoiler":false,"text":"普通に校舎内にも出没するので、学生からは英吾が牛をペットにしていると思われている節がある。"}],"source":"egs","sourceCharacterId":"3876","sourceWorkId":"20517","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46d2c4d55f98ce85b115719c14bce2c94121f73527950005e83238d1f38aeaed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7de225ab8186edcb90ffd8398e8ae84e5e8d88b33532631ac8261f92e5b33502.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c26643","characterName":"バッケンハンター","sourceIds":{"vndbCharacterId":"c26643"},"originalCharacterName":"バッケンハンター","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"152"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Cast of Snow White princess and one of Bakken series with the name of Bakken Calibur"}],"source":"vndb","sourceCharacterId":"c26643"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters