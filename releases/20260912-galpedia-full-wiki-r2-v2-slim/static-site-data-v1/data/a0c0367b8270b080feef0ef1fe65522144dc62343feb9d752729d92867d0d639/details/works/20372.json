iler":false,"text":"しゃべり方や物腰は柔らかく、礼節もわきまえているが、嫌なことは嫌だと誰に対しても言える。"},{"spoiler":false,"text":"また、高貴な身分であるが威厳をかざしたりせず、自分に非があれば頭を下げられる。"},{"spoiler":false,"text":"出来ないことは出来るようになるまでやる節があり、周りがそのくらいで諦めたらと言っても、それでも一生懸命やろうとする頑固な一面もある。"},{"spoiler":false,"text":"しかし苦手なことは多く、手先も不器用。"},{"spoiler":false,"text":"ただ、類まれな運動神経を持ち、頭も良く、容姿の美しさもあって周囲からは完璧だと思われてる。"},{"spoiler":false,"text":"「私は私の知らない世界を知りたいんです！」"}],"source":"bangumi","sourceCharacterId":"63203"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"3762","sourceWorkId":"20372","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"3762","sourceWorkId":"20372","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"3762","sourceWorkId":"20372","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"3762","sourceWorkId":"20372","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c188f343c616e37afca211d11b83f5372e3298af5b51b02e0319a27444d6f621.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1ab7d85c744a2b9d3bdff7d6a6651621ec39d516bc62861b4fc99e3b6ceec8d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:106356:63203:6016:1","source":"bangumi"}]},{"characterId":"char_c19118","characterName":"花村 郁","sourceIds":{"bangumi":[{"characterId":"63204","match":"exact-normalized-name-in-linked-work","subjectId":"106356"}],"egsCharacterIds":["3764"],"vndbCharacterId":"c19118"},