{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"959","model":{"presentationWorkId":"vndb:v7493","staff":{"artwork":[],"scenario":[],"music":[{"creditedName":"とまぞぉ","creatorId":"vndb:s1265","sourcePersonId":"vndb:s1265","canonicalEntityId":"vndb:s1265","name":"荒川 憲一","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:71162","source":"vndb"}],"other":[{"creditedName":"MONTAN","creatorId":"vndb:s14722","sourcePersonId":"vndb:s14722","canonicalEntityId":"vndb:s14722","name":"森山 雄治","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:71163","source":"vndb"},{"creditedName":"MONTAN","creatorId":"vndb:s14722","sourcePersonId":"vndb:s14722","canonicalEntityId":"vndb:s14722","name":"森山 雄治","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:71164","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c171174","characterName":"ケイト","sourceIds":{"vndbCharacterId":"c171174"},"originalCharacterName":"ケイト","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the enterprising young captain of her very own galactic galleon. Always on the search for adventure (or treasure), she's hit a bit of a dry spell lately and is bored to death."},{"spoiler":false,"text":"Fortunately, the arrival of a space pirate vessel brightens her day and after a short skirmish, Kate and her shipmate Yuria board the pirate ship to loot it of precious silver-platinum."},{"spoiler":false,"text":"From \"Angel Dust\" story."}],"source":"vndb","sourceCharacterId":"c171174"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0e98a0c0b34d0e74e2bda98380e5183c6935cae3d9ebe8f658c620da5fbcfcd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2efb3ffc80062139b61ae51315914e2a513ff217f8ccadf30254268584532d4c.webp","width":189,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c171176","characterName":"ユリア","sourceIds":{"vndbCharacterId":"c171176"},"originalCharacterName":"ユリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is Kate's first officer and only shipmate abord their tiny stellar crusier."},{"spoiler":false,"text":"Yuria tries to cheer up her commanding officer when they're floating along in the dull, empty space between stars, but Kate doesn't appreciate the favor."},{"spoiler":false,"text":"When a space pirate vessel appears, that changes though, and soon both girls are blasting their way on board to loot the ship."},{"spoiler":false,"text":"From \"Angel Dust\" story."}],"source":"vndb","sourceCharacterId":"c171176"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af869e727082e270ad07a54b30daed3ebbb3e4a272ad24335ee5822c104d5dc5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/750462ff1dc4a9d9f41844c67c9ff66c86b1acf3a3b1ff6d7043b398d163cab3.webp","width":189,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c171183","characterName":"留理","sourceIds":{"vndbCharacterId":"c171183"},"originalCharacterName":"留理","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[