"vndb"},{"creditedName":"鈴葉 ユミ","creatorId":"vndb:s2523","sourcePersonId":"vndb:s2523","canonicalEntityId":"vndb:s2523","name":"鈴葉 ユミ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:124576","source":"vndb"},{"creditedName":"癸 乙夜","creatorId":"vndb:s2829","sourcePersonId":"vndb:s2829","canonicalEntityId":"vndb:s2829","name":"癸乙夜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:124579","source":"vndb"},{"creditedName":"天津 凪","creatorId":"vndb:s6491","sourcePersonId":"vndb:s6491","canonicalEntityId":"vndb:s6491","name":"天津 凪","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:124580","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c54275","characterName":"庵崎 薫","sourceIds":{"vndbCharacterId":"c54275"},"originalCharacterName":"庵崎 薫","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a reincarnated body of \"Serahime\" who received a curse, but she has no memory of her previous life. Her parents were killed right in front of her, but her bright and lively personality would convince you otherwise. She is good at sports in general, and boasts exceptional strength in kendo, which she learned from her foster father, who is her instructor."},{"spoiler":false,"text":"Until Ren appeared, she had a life without love. While hesitating and suffering, she eats people's sins and searches for her own way of life through battle."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c54275"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3f30433754d1586a7e6bab6c46c9b9ad7af59fb4acbc54d640b13676936b37c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c904ebbaad05c641f47814132384bf695a2e1bf07ae1dc2ef1e7e9ad38fcbc1.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"内田 愛美","creatorId":"vndb:s810","sourcePersonId":"vndb:s810","canonicalEntityId":"vndb:s810","name":"内田 愛美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66340","source":"vndb"}]},{"characterId":"char_vndb_c54276","characterName":"永海 連","sourceIds":{"vndbCharacterId":"c54276"},"originalCharacterName":"永海 連","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is the reincarnation of \"Renki,\" one of Serahime's followers. When the princess was defeated, he wished to receive a curse of his own will, and since then he has been reincarnating repeatedly while staying close to her soul."},{"spoiler":false,"text":"He helps Kaoru, who has no memories of being a princess, and teaches her the \"Sumikui no Gi\", a way to atone for her sins. He looks kind but always puts Kaoru first, sometimes causing him to be careless about everyone else."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c54276"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c87f7e5efadcb3bac8b4ce1dfe4c316e595d9827de285159c24b8f8276bbf534.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6ac95cd33e4135d7ee7f99353111b4890a39862b5780ee2b8a3f983d87371282.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"赤羽根 健治","creatorId":"vndb:s1381","sourcePersonId":"vndb:s1381","canonicalEntityId":"vndb:s1381","name":"赤羽根 健治","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66335","source":"vndb"}]},{"characterId":"char_vndb_c54277","characterName":"上樹 守人","sourceIds":{"vndbCharacterId":"c54277"},"originalCharacterName":"上樹 守人","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Serahime's fiancee from a thousand years ago. Every time Kaoru reincarnated, he watched over the execution of the \"Sin Kui Ritual\", but since he lost sight of Serahime's soul in the previous generation, he has been searching for her all along."},{"spoiler":false,"text":"Because of his taciturn and expressionless face, he gives off a cold impression, but inside, he has a surprising amount of..."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c54277"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/34f6284d2eb518275711fd5636adee328421998018889a101d935d727f1a33db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8abed3927729810fe44ddf807a8a4039febda9169604d611815d9b2dd4d36f13.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野 友樹","creatorId":"vndb:s42","sourcePersonId":"vndb:s42","canonicalEntityId":"vndb:s42","name":"小野 友樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66332","source":"vndb"}]},{"characterId":"char_vndb_c54278","characterName":"陸 至央","sourceIds":{"vndbCharacterId":"c54278"},"originalCharacterName":"陸 至央","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"For some reason, the scion of the \"Kuga clan\" wants to kill Kaoru. As a result of being educated from an early age to extinguish \"Serahime's Soul\", while possessing excellent powers, he has become distorted."},{"spoiler":false,"text":"A hedonist who loves fighting. He always looks bossy and thinks that Kaoru is a \"good toy.\""},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c54278"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e2e6a88703c72dce1071cdd2cb3e2dc7e0362731a19b4ccd4527ea3b7015cbc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a379263cf18ba9b62839d22193c1f97105827e96e7ba195d0a53fc6d898fb63.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立花 慎之介","creatorId":"vndb:s55","sourcePersonId":"vndb:s55","canonicalEntityId":"vndb:s55","name":"立花 慎之介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66333","source":"vndb"}]},{"characterId":"char_vndb_c54279","characterName":"陸 任史","sourceIds":{"vndbCharacterId":"c54279"},"originalCharacterName":"陸 任史","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shiou's butler, who almost acts like a foster father. He's been by his side ever since he was young."},{"spoiler":false,"text":"Contrary to his master, he is a calm gentleman."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c54279"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wi