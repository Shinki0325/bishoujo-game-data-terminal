{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"29132","model":{"presentationWorkId":"egs:29132","staff":{"artwork":[],"scenario":[],"music":[],"other":[{"creditedName":"三月のパンタシア(みあ)","creatorId":"egs:creator:35286","sourcePersonId":"egs:creator:35286","canonicalEntityId":"egs:creator:35286","name":"三月のパンタシア(みあ)","detail":"主題歌「たべてあげる」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"ambiguous-alias-review","relationId":"egs:work-creator:218460","source":"egs"}]},"cast":[{"characterId":"char_bangumi_10596","characterName":"Rin Tohsaka","sourceIds":{"bangumi":[{"characterId":"10596","match":"source-roster","subjectId":"297634"},{"characterId":"10596","match":"source-roster","subjectId":"911"},{"characterId":"10596","match":"source-roster","subjectId":"935"}]},"originalCharacterName":"Rin Tohsaka","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0203"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"bust":{"reviewState":"source-only","source":"bangumi","value":"77"},"height":{"reviewState":"source-only","source":"bangumi","value":"159"},"hip":{"reviewState":"source-only","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"57"},"weight":{"reviewState":"source-only","source":"bangumi","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"穂群原学園2年A組に通う女生徒で、魔術師。魔術の名門、遠坂家の後継者。"},{"spoiler":false,"text":"学園内では非の打ち所のない優等生として男子生徒の人気も上々だが、イジワル大好きないじめっこ、という小悪魔的な本性を持つ。"},{"spoiler":false,"text":"現代に生きる魔術師として聖杯戦争に参加。素人同然の主人公と衝突する。"}],"source":"bangumi","sourceCharacterId":"10596"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05226c806b1e6ccc3487c73d565948201b3bd45d0adc1b245720b194b5470739.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b65f680b5fe78a518d6bcef4296f818a2d94edcf310bd6199c0d4325b30ec1d8.webp","width":175,"height":256,"source":"static-detail"},"actors":[{"creditedName":"植田佳奈","creatorId":"vndb:s17","sourcePersonId":"vndb:s17","canonicalEntityId":"vndb:s17","name":"植田 佳奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:297634:10596:4263:1","source":"bangumi"}]},{"characterId":"char_bangumi_273","characterName":"Altria Pendragon","sourceIds":{"bangumi":[{"characterId":"273","match":"source-roster","subjectId":"173533"},{"characterId":"273","match":"source-roster","subjectId":"214013"},{"characterId":"273","match":"source-roster","subjectId":"297634"},{"characterId":"273","match":"source-roster","subjectId":"331486"},{"characterId":"273","match":"source-roster","subjectId":"911"},{"characterId":"273","match":"source-roster","subjectId":"935"}]},"originalCharacterName":"Altria Pendragon","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"bangumi","value":"73"},"height":{"reviewState":"source-only","source":"bangumi","value":"154"},"hip":{"reviewState":"source-only","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"53"},"weight":{"reviewState":"source-only","source":"bangumi","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Fate/stay night"},{"spoiler":false,"text":"被卫宫士郎召唤的英灵。作为三骑士之一的Saber，以「最优秀的剑之骑士」闻名。她曾在第四次圣杯战争中被召唤，当时士郎的养父——卫宫切嗣是她的Master。"},{"spoiler":false,"text":"她的真实身份是英格兰传说中的英雄——亚瑟王。从石中拔出选王之剑的少女「阿尔托莉雅」，为了成为理想的君主而隐瞒了自己的性别。然而，在内乱中目睹国土荒废的她，认为自己未能胜任王者之位，因此渴望借由圣杯重新选定合格的王，以拯救祖国不列颠。"},{"spoiler":false,"text":"她拥有不负传说之名的强大力量，但由于与士郎之间缺乏魔力的“通路”，常因魔力不足而陷入苦战。性格极其刻板认真，对于自己是女性的自觉也相当淡薄，以至于一开始总与士郎意见不合。但最终，她在与士郎的相处中肯定了自己的人生，并决心摧毁寄宿着“此世全部之恶”的圣杯。对她而言，能让自己镜像一般的士郎成为Master，或许是再幸运不过的事情了。"},{"spoiler":false,"text":"Fate/Zero"},{"spoiler":false,"text":"传说中的骑士王亚瑟现界的身姿，真名是阿尔托莉雅。卫宫切嗣召唤的从者，召唤时所用的圣遗物是Excalibur的剑鞘，她在第四次圣杯战争中保护着作为代理Master的爱丽丝菲尔。"},{"spoiler":false,"text":"传说中的亚瑟王是男性，那是因为她为了统治方便而隐瞒了性别。拔出选定之剑后身体便不再成长与老化，因此一直是少女的模样。高尚而廉洁、认真而顽固，怀抱的愿望是拯救曾经走上灭亡之路的祖国不列颠。"},{"spoiler":false,"text":"Fate/Grand Order"},{"spoiler":false,"text":"不列颠传说中的王。也被誉为骑士王。阿尔托莉雅是幼名，自从当上国王之后，就开始被称为亚瑟王了。在骑士道凋零的时代，手持圣剑，给不列颠带来了短暂的和平与最后的繁荣。史实上虽为男性，但在这个世界内却似乎是男装丽人，行为举止都以男性为标准，因此很不擅长应对异性向自己表达的好感。"},{"spoiler":false,"text":"崇尚万人眼中正确生活、正确人生的理想王者之一。锄强扶弱，是个无可非议的人物。冷静沉着，无论何时都十分认真的优等生。尽管如此……虽说从不愿意开口承认，但她却有着不服输的一面。对任何需要一争高下的事都不会手下留情，一旦败北则会非常懊悔。"},{"spoiler":false,"text":"她具有指挥军团的天生才能。在团体战斗中，可令我军的能力提升。贯彻清廉正直，大公无私的王。其公正令骑士们愿意守护于她的身旁，令民众们在对贫困的忍耐中看到了希望。她的王者之路并不是为了统帅少数强者，而是为了领导更多无力之人而存在的。"},{"spoiler":false,"text":"亚瑟王传说以骑士时代的终结为结局。亚瑟王虽然击退了异民族，但却无法回避不列颠土地的毁灭。圆桌骑士之一·莫德雷德的反叛导致国家一分为二，骑士之城卡美洛也失去了其辉煌。亚瑟王在卡姆兰之丘成功讨伐了莫德雷德，自己却也因负重伤而倒下。在去世前，她将圣剑交给了最后的心腹贝德维尔，离开了这个世界。死后她被送往了理想乡——不存于此世的乐园·阿瓦隆，并打算在遥远的未来再次拯救不列颠。"}],"source":"bangumi","sourceCharacterId":"273"}],"profileFacts":[{"label":"喜欢的东西","source":"bangumi","sourceCharacterId":"273","value":"规矩精细的饮食、布娃娃（尤其是狮子的）"},{"label":"属性","source":"bangumi","sourceCharacterId":"273","value":"秩序·善·地"},{"label":"特技","source":"bangumi","sourceCharacterId":"273","value":"器械运动、秘密地精通各种赌博"},{"label":"讨厌的东西","source":"bangumi","sourceCharacterId":"273","value":"粗糙的饮食、过多装饰"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78c81176293bff59bdaef415cafbb7e043d0640cc59c570b6d815e8aa9f1f1f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e397d20052d6b229c9daa5185b5318b004b311de857ca4c1887f4324bb2a6040.webp","width":179,"height":256,"source":"static-detail"},"actors":[{"creditedName":"川澄綾子","creatorId":"vndb:s16","sourcePersonId":"vndb:s16","canonicalEntityId":"vndb:s16","name":"川澄 綾子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:297634:273:740:1","source":"bangumi"}]},{"characterId":"char_bangumi_3214","characterName":"衛宮 士郎","sourceIds":{"bangumi":[{"characterId":"3214","match":"source-roster","subjectId":"297634"},{"characterId":"3214","match":"source-roster","subjectId":"911"},{"characterId":"3214","match":"source-roster","subjectId":"935"}]},"originalCharacterName":"衛宮 士郎","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"167"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"穗群原学园（Homurabara）高中部二年级学生及见习中的魔术师、10年前冬木市（Fuyuki）大火中的少数生还者之一。被身为魔术师的卫宫切嗣所救并收养，受卫宫切嗣的影响，是个英雄迷，并发誓长大之后一定要成为“正义的伙伴”拯救所有受到苦难的人们。所以只要是他人的请求他从不会拒绝。擅长分析物件构造（可以解析眼中所见的任何东西的构造）和修理电器。"},{"spoiler":false,"text":"虽然是魔术师，不过除了构造把握、强化和投影以外，并不会其他基本的魔术。因为十年前那场大火的关系，在右肩留下一道火烧的伤痕，在礼射时男性要露出右肩，以此原因而退出弓道社。早上为和食派，曾有一段时间教樱作饭，领悟性高的樱很快就学会了。在料理方面不管是日式还是西式都很擅长。在饮食方面对于红茶、日本茶及咖啡一律平等，唯独不喜欢喝梅昆布茶。酒量不好，顶多是撑一下的程度。爱好是修理东西，曾经帮藤村大河的祖父藤村雷画改造摩托车，而从雷画那里拿到大量的零用钱。而加入弓道部的契机，是因为看到体格劣于他人却不服输的性格，雷画推荐他学习弓道。在此之前的相扑似乎也是雷画推荐的。"},{"spoiler":false,"text":"天生就对剑特别喜好。此外弓术也早已到达了大师的境界，“箭矢呢，是在射出前就已经射中的”，因此他唯一的失误只是因为他本来就没有要让箭矢击中红心。拥有技能：投影魔术的实质与Archer相同，是其心象风景“固有结界—无限剑制”。由于本身的属性是剑，可以投影所有理解范围内的武器（限定为剑，也能投影防具，但通常需要二至三倍的魔力）。因此在UBW线中与英雄王匹敌。（因为本身魔力回路太少，所以透过跟远坂 凛进行性行为建立魔力回路以支撑结界）此外固有结界—无限剑制由于与Archer的心象风景不太相同，因此唱诵的咒文也有一些差别，此外虽然Archer与士郎有相当大的实力差距，但在此线与Archer对战的过程中士郎逐渐吸收了Archer的战斗经验，两人处于势均力敌的状态。"},{"spoiler":false,"text":"此外，虽然叫做投影，不过一般的投影可以在投影出和原型相似的某种物品后，在加上补强，但是士郎的投影是完全靠自己心中的想像来凭空制造物品，是将内心具现化的技能(同时也是固有结界-无限剑制的基础)。"},{"spoiler":false,"text":"根据投影的规则，就算完美的投影出宝具，也会比原先的宝具降低一个等级。但是在制剑过程中，会自然了解剑的一切，包含持有过剑的人的剑术武技虽然不到完全拷贝，所以只要投影出来的剑都能够立刻的上手使用，仿佛是自己曾用过的剑一样，但并不是变成真正的武学大师，还是有很大的部份依赖士郎本身学习到的剑术和战斗经验。"},{"spoiler":false,"text":"在HF线中失去了左手，因而接受了Archer的左手，绮礼曾对两人的肉体契合度异常之高感到惊讶，即使如此，由于Archer的左手拥有远远超越于现在的士郎所拥有的大量魔力回路、战斗经验、投影知识，所以需要以扼杀魔力的圣骸布紧紧封印住，借此骗过身体，若是轻率使用，反而会被手臂侵蚀，唯一的方法便是透过自身的锻炼，在未来成长至足以驾驭左手后，才能够将之自由使用。此外，士郎可使用手臂中所累积的投影知识，在与Rider联手与黑Saber的途中，也曾投影出英灵卫宫曾投影出的结界宝具－炽天覆七重圆环（Lo.Aias），在fate/hollow ataraxia中Archer在最后一日进行决战时，身上便携带当初用来封印左手的圣骸布，该Archer是否为此线中成长并且成功驾驭左手的英灵卫宫这点尚存争议，因HF线最后结局士郎原本的肉体已经崩坏，之后使用的身体是由樱变卖间桐的房子向苍崎橙子购买的人偶（仅有略为提到），其原因可推测为fate/hollow ataraxia是融合本作三线从而发展出类似续篇的关系，极有可能为圣杯所制造的矛盾现象。"},{"spoiler":false,"text":"士郎的自我治疗能力是来自他体内Excalibur的剑鞘“遗世独立的理想乡（Avalon）”，此宝具必须与Saber建立契约以及她的魔力才能发动，靠近Saber效果更明显。但在游戏中的死亡路线都派不上用场。"},{"spoiler":false,"text":"此外英雄王的乖离剑・Ea是在“剑”这一武器的概念出现之前所创造出来的，因此士郎无法理解其构造及投影。"}],"source":"bangumi","sourceCharacterId":"3214"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/522457408b00a9e64f763e493ed68c11d4fa8071b3a77f3a1cbb7bfafa55ebb7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05b51292223bd57a650b9d6caf272083a4d0f708961f99cc8939b767d7f34e62.webp","width":150,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杉山紀彰","creatorId":"vndb:s15","sourcePersonId":"vndb:s15","canonicalEntityId":"vndb:s15","name":"杉山 紀彰","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:297634:3214:4578:1","source":"bangumi"}]},{"characterId":"char_bangumi_3215","characterName":"まとうさくら","sourceIds":{"bangumi":[{"characterId":"3215","match":"source-roster","subjectId":"297634"},{"characterId":"3215","match":"source-roster","subjectId":"911"},{"characterId":"3215","match":"source-roster","subjectId":"935"}]},"originalCharacterName":"まとうさくら","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0302"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"bust":{"reviewState":"source-only","source":"bangumi","value":"85"},"height":{"reviewState":"source-only","source":"bangumi","value":"156"},"hip":{"reviewState":"source-only","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"56"},"weight":{"reviewState":"source-only","source":"bangumi","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"過去のちょっとしたきっかけから、主人公や藤村先生とは家族同然の付き合いを続けている一学年下の後輩。"},{"spoiler":false,"text":"やや引っ込み思案なおとなしい性格をしているが、時折主人公に対して積極的になる一面も持ち合わせている。"},{"spoiler":false,"text":"穏やかな日常の象徴で、戦いに巻き込まれる事はないのだが……？"}],"source":"bangumi","sourceCharacterId":"3215"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/cef2d18693b2f7903d958d0184d3918656f5d2297274ecd81b9933f3f78b49b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4c66348728dbd2eb65f3487a47d0a54045e09e9146ca772906269bf468a2041.webp","width":180,"height":256,"source":"static-detail"},"actors":[{"creditedName":"下屋則子","creatorId":"vndb:s71","sourcePersonId":"vndb:s71","canonicalEntityId":"vndb:s71","name":"下屋則子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:297634:3215:4471:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:5490","sourceCompanyId":"egs:brand:5490","canonicalEntityId":"egs:brand:5490","name":"株式会社アニプレックス","roleCodes":["brand"],"identityStatus":"alias-only-review","relationId":"egs:work-brand:29132:5490","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
