{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"12564","model":{"presentationWorkId":"vndb:v1788","staff":{"artwork":[{"creditedName":"久遠路火鷹(天人)","creatorId":"vndb:s2473","sourcePersonId":"egs:creator:3516","canonicalEntityId":"vndb:s2473","name":"久遠路火鷹(天人)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:78210","source":"egs"}],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c46298","characterName":"美那神 はづき","sourceIds":{"bangumi":[{"characterId":"98288","match":"exact-normalized-name-in-linked-work","subjectId":"224174"}],"egsCharacterIds":["15214"],"vndbCharacterId":"c46298"},"originalCharacterName":"美那神 はづき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a priestess of the Minakami family and serves as “Yaorozu no Iwato no Omoriyaku” (guardian of Yaorozu no Iwato)."},{"spoiler":false,"text":"She has a strong sense of justice, is strong-minded and dignified, but also has a bit of a temper. She is a virgin."},{"spoiler":false,"text":"Since her parents died early in life, she cares for her younger sister, Satsuki, She desperately endures Kurouto's embarrassing training in place of Satsuki."},{"spoiler":false,"text":"Eventually, she begins to feel pleasure in her body, and she can no longer deny it..."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c46298"},{"segments":[{"spoiler":false,"text":"「八百岩戸の御守役」に就いた、美那神家の巫女。20歳。"},{"spoiler":false,"text":"凛々しさを持ち、正義感に溢れているが、気が強く、やや短気なところがある。"},{"spoiler":false,"text":"両親を早くに亡くし、たった一人の肉親である妹を大切に思っている。"},{"spoiler":false,"text":"それゆえに、さつきの身代りになって主人公の恥ずかしい責めにも必死に耐えるが、やがて快楽の虜に……。"},{"spoiler":false,"text":"処女。"}],"source":"egs","sourceCharacterId":"15214","sourceWorkId":"12564","spoiler":false},{"segments":[{"spoiler":false,"text":"美那神家の巫女で、“八百岩戸の御守役” （やおろずのいわとのおもりやく）に就く。"},{"spoiler":false,"text":"正義感に溢れ、気が強く凛々しいが、少し短気なところがある。処女。"},{"spoiler":false,"text":"早くに両親を亡くしたため、妹のさつきを大切に思っており、さつきの身代わりに玄人の恥ずかしい調教に必死に耐える。"},{"spoiler":false,"text":"やがて、肉体が快感を感じ始め、それを否定できなくなっていき…。"}],"source":"bangumi","sourceCharacterId":"98288"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b0c2e6b8d387a37e1927fa2eaf6214dfcb8facb9e7b4ff5a1a04c0f4590a02c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c13d177b054f3cda6447defacde8a2d4f3dc580feb7dfda07b88255d89b8f36d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"計名 さや香","creatorId":"vndb:s859","sourcePersonId":"vndb:s859","canonicalEntityId":"vndb:s859","name":"かずなさやか(計名さや香)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14860","source":"vndb"}]},{"characterId":"char_c46299","characterName":"美那神 さつき","sourceIds":{"bangumi":[{"characterId":"98289","match":"exact-normalized-name-in-linked-work","subjectId":"224174"}],"egsCharacterIds":["15215"],"vndbCharacterId":"c46299"},"originalCharacterName":"美那神 さつき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the younger sister of Hazuki, a priestess of the Minakami family. She helps her older sister Hazuki, who has been chosen to be the “guardian of Yaorozu no Iwato\"."},{"spoiler":false,"text":"She is an honest, cheerful, and optimistic person. Because she is too innocent, she is good-natured and easily deceived. She is a virgin."},{"spoiler":false,"text":"She is proud of her older sister, Hazuki, and adores her very much. She sometimes cries because she can't stand the abuse of Kurouto."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c46299"},{"segments":[{"spoiler":false,"text":"美那神家の巫女にして、はづきの妹。18歳。"},{"spoiler":false,"text":"素直で明るい楽天家。性格も子供っぽく、気弱で甘えん坊。また純真過ぎるほど純真でお人好し、故に騙されやすい。"},{"spoiler":false,"text":"自分をいつも優しく見守ってくれている姉を尊敬し、誇りに思っている。"},{"spoiler":false,"text":"処女。"}],"source":"egs","sourceCharacterId":"15215","sourceWorkId":"12564","spoiler":false},{"segments":[{"spoiler":false,"text":"美那神家の巫女ではづきの妹。"},{"spoiler":false,"text":"“八百岩戸の御守役” に選ばれた姉はづきを助ける。"},{"spoiler":false,"text":"素直で明るい楽天家。純真すぎるため、お人好しで人に騙されやすい。"},{"spoiler":false,"text":"気弱で泣き虫な甘えん坊で、子供っぽいところがある。処女。"},{"spoiler":false,"text":"姉のはづきを誇りに思い、とても慕っている。"},{"spoiler":false,"text":"玄人の責めに耐えられず、泣いてしまうことも。"}],"source":"bangumi","sourceCharacterId":"98289"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f49d11e632cf0b5762399dca34288877edffd1f2634cf2c8628bb3dd019a112.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9df884514363f9f1d6e93a6d4c895068aa0333df3282e8759b808f9f76d92c81.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224174:98289:5936:1","source":"bangumi"}]},{"characterId":"char_vndb_c119078","characterName":"屋木坂 玄人","sourceIds":{"vndbCharacterId":"c119078"},"originalCharacterName":"屋木坂 玄人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a sadist with a strong body and mind and a strong desire for domination. He plans to resurrect the evil god “Orochi,” and is trying to surpass human beings by transforming them."},{"spoiler":false,"text":"He is absolutely confident in himself and has a brutal personality, he enjoys training the sisters slowly and gradually."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c119078"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1571","sourceCompanyId":"egs:brand:1883","canonicalEntityId":"vndb:p1571","name":"黒雛","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:12564:1883","source":"egs"},{"companyId":"vndb:p176","sourceCompanyId":"vndb:p176","canonicalEntityId":"vndb:p176","name":"N43 Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:155830:v1788","source":"vndb"},{"companyId":"vndb:p1571","sourceCompanyId":"vndb:p1571","canonicalEntityId":"vndb:p1571","name":"黒雛","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:155831:v1788","source":"vndb"},{"companyId":"vndb:p381","sourceCompanyId":"vndb:p381","canonicalEntityId":"vndb:p381","name":"Hina Soft","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:4161:v1788","source":"vndb"},{"companyId":"vndb:p1571","sourceCompanyId":"vndb:p1571","canonicalEntityId":"vndb:p1571","name":"黒雛","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:4162:v1788","source":"vndb"},{"companyId":"vndb:p381","sourceCompanyId":"vndb:p381","canonicalEntityId":"vndb:p381","name":"Hina Soft","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:4163:v1788","source":"vndb"},{"companyId":"vndb:p1571","sourceCompanyId":"vndb:p1571","canonicalEntityId":"vndb:p1571","name":"黒雛","roleCodes":["developer"],"