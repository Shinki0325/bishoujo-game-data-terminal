8542","name":"望月 健太郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:1300","source":"vndb"},{"creditedName":"横緒 健一","creatorId":"vndb:s48543","sourcePersonId":"vndb:s48543","canonicalEntityId":"vndb:s48543","name":"横緒 健一","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:1301","source":"vndb"},{"creditedName":"AKKO","creatorId":"vndb:s53698","sourcePersonId":"vndb:s53698","canonicalEntityId":"vndb:s53698","name":"AKKO","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:1302","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c3275","characterName":"木田 時紀","sourceIds":{"vndbCharacterId":"c3275"},"originalCharacterName":"木田 時紀","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An unfriendly young man with a bit of a temper. While he gets along to a degree with his best friend, Isao, Kida is something of a loner during his time off. He has no real interest in relationships, or \"normal\" life in general, and because of this he believes that the world would probably be better off without him. Despite being someone who lacks direction, he will be quick to act when the situation calls for it. His only real source of comfort is smoking cigarettes."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c3275"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f3da5c7e94ab31942a17d0eb12fcc3eccd2afd59c33aec9dc5eb0142d571b2c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f15789ecadd0492f961b376c9e08c5f5fb58e7c44bfa53642eeda1cf1d8cf0f.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c3276","characterName":"栗原 透子","sourceIds":{"vndbCharacterId":"c3276"},"originalCharacterName":"栗原 透子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kida's classmate. A simple girl that is seen as troublesome by most and a true nuisance by Kida. Despite knowing that she is slow and somewhat bothersome to others, Touko feels she needs to do her best and contribute to the world. Unfortunately, the fact that Touko has never had a chance to prove herself has left her with a desire to find something that will give her own life some meaning. She manages to find that meaning upon meeting Kida, and will do anything to preserve it."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c3276"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a254b255d1e746c4f3cfab4944203191a7eb0246220ec9e64e7b47ee194a5d5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/3301bbfb084cd954d495f35e14ec288f77de79aac3718d76e8533ac7ac9aeded.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鮎川 ひなた","creatorId":"vndb:s650","sourcePersonId":"vndb:s650","canonicalEntityId":"vndb:s650","name":"鮎川ひなた","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:267","source":"vndb"}]},{"characterId":"char_vndb_c3277","characterName":"榊 しのぶ","sourceIds":{"vndbCharacterId":"c3277"},"originalCharacterName":"榊 しのぶ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kida's classmate and Touko's best friend. A sharp-tongued and quick-witted girl who holds the position of class representative. Having known Touko all of her life, Shinobu has taken it upon herself to look after her best friend and punish anyone that crosses her. Unfortunately, this has done more harm than good for Touko, even if Shinobu is for the most part unaware of it. Her devotion is so strong that her classmates suspect that Shinobu and Touko might be romantically involved."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c3277"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/ddc08729fb62ed20b03f1ac542fc8dd5c9e7c7212100552cc640a159f0f9db8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62afb42f3c41d36689d02cf829bd6f9dcc16ec1fbb195ecd719f3f46f419c139.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鷹月 さくら","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:264","source":"vndb"}]},{"characterId":"char_vndb_c3278","characterName":"須磨寺 雪緒","sourceIds":{"vndbCharacterId":"c3278"},"originalCharacterName":"須磨寺 雪緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl from Kida's school. Yukio is respected and admired by the underclassmen, who see her as an intelligent and beautiful senpai. Though Yukio seems to have an ideal reputation and proves to be a very capable young woman, she has decided to abandon the idea of forming bonds and connections with others. She also seems to dislike being the object of people's affections."},{"spoiler":false,"text":"Edited from Wikipedia"},{"spoiler":false,"text":"Yukio always questions about fate, if humans are just playthings for the gods. In her route,"},{"spoiler":true,"text":"Yukio asks him straight in the face \"do you want to have sex with me? You look like you want to.\" and they go into a love hotel. They keep on this \"body relationship\", while the main character tries to understand more about Yukio, she keeps her distance. Has a broken family life and afraid to loose something else she dears again. At the end, both of them decided that there is nothing left in this world for them and jump off the roof. They end up surviving, though. When they came to in the hospital later, Yukio then finally acknowledges that they do have choice and not everything is completely governed by fate."}],"source":"vndb","sourceCharacterId":"c3278"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38c27a83e64b08d367236c9e656078dbc046feb3bdb5cfed824033eb2799f917.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d586f5e07079660b8b40be654915e8e424b6c3852ac9550d8cc129a3bd8a2b42.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井村屋 ほのか","creatorId":"vndb:s867","sourcePersonId":"vndb:s867","canonicalEntityId":"vndb:s867","name":"萩原 えみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:268","source":"vndb"}]},{"characterId":"char_vndb_c3279","characterName":"葉月 真帆","sourceIds":{"vndbCharacterId":"c3279"},"originalCharacterName":"葉月 真帆","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An underclassman in the lacrosse team. Maho is a cute and energetic girl that happens to be Shimomura Isao's girlfriend. She thinks of Kida as an older brother, and tends to feel more at ease around him than around her boyfriend."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c3279"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/4990156a6942566518c8e5901ab4fe720b15d680ffe19f8249a115fb8baba535.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbb76a27364307e63cbe5f02e83734e2528d96df4ccf7e75a4d44be982f5ca09.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安玖深 音","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:266","source":"vndb"}]},{"characterId":"char_vndb_c3280","characterName":"麻生 明日菜","sourceIds":{"vndbCharacterId":"c3280"},"originalCharacterName":"麻生 明日菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An older girl that works at the local cake shop. Asuna is generally amicable and is very willing to give advice (and is somewhat romantic). She instantly takes a liking to Kida upon meeting him, and vows to protect and look after him. Though she seems to be quite comfortable with the role of \"older sister\" leading the \"inexperienced younger man\", her demeanor changes to that of a tense and quiet person whenever her past is brought up."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c3280"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7e3770392c2e3604addebad7e26e087e77ca06f3913a9ccef94b1397627a086.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/5771386e296f8ff78a8696656f253e6bd3463aeddf59fbce19ca302ddb49b0e8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"皆美 伊吹","creatorId":"vndb:s1429","sourcePersonId":"vndb:s1429","canonicalEntityId":"vndb:s1429","name":"牧野 芳奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:269","source":"vndb"}]},{"characterId":"char_vndb_c59896","characterName":"木田 恵美梨","sourceIds":{"vndbCharacterId":"c59896"},"originalCharacterName":"木田 恵美梨","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The younger sister of Tokinori."},{"spoiler":false,"text":"Despite being the younger of the two, Emiri is undoubtedly the more dominant and, in some ways, has seized control of the household."},{"spoiler":false,"text":"Despite their disagreements, Emiri still has a strong bond with her brother. She has learned to lower her expectations of him due to his lack of direction."},{"spoiler":false,"text":"She also respects and admires Yukio."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c59896"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3dfd1d16874d5dfda282327ecace92dbe950add2bce6dc0eb5479b63b164247e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/0579e6190c1e7492b408712ff0727ce19c808a0679a0e831fdcbfd389811c6cd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みる","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:265","source":"vndb"}]},{"characterId":"char_vndb_c59897","characterName":"霜村 功","sourceIds":{"vndbCharacterId":"c59897"},"originalCharacterName":"霜村 功","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kida's best friend and Maho's boyfriend."},{"spoiler":false,"text":"Isao can be considered the opposite of Kida, and as such is outgoing and more of an optimist."},{"spoiler":false,"text":"He is completely focused on his plans for spending Christmas with Maho"},{"spoiler":true,"text":", but is unaware of how uncomfortable she feels about the prospect of sex and sexuality during their time together."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c59897"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5ef3e5b6283a0184cd7c559654424bfb4ae0638bf71de62462ef3cd9d930ced8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c17ae94d775ecf403642ee8e54dc50757be1edded5e53d5ccad606bb3646470f.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c59898","characterName":"巣鴨 文吾","sourceIds":{"vndbCharacterId":"c59898"},"originalCharacterName":"巣鴨 文吾","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The short-tempered owner of the cake shop \"Wien Nocturne\". He is Asuna's uncle through marriage and a t