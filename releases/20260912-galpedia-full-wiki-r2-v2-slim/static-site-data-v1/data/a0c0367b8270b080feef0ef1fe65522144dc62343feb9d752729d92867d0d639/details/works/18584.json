{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"18584","model":{"presentationWorkId":"vndb:v7982","staff":{"artwork":[{"creditedName":"Po*","creatorId":"vndb:s3453","sourcePersonId":"vndb:s3453","canonicalEntityId":"vndb:s3453","name":"Po*","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:75061","source":"vndb"}],"scenario":[{"creditedName":"遊真 一希","creatorId":"vndb:s2601","sourcePersonId":"vndb:s2601","canonicalEntityId":"vndb:s2601","name":"遊真 一希","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:75060","source":"vndb"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c63466","characterName":"ノヴァ","sourceIds":{"vndbCharacterId":"c63466"},"originalCharacterName":"ノヴァ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A poor vagrant of low social status, he's a kind man who emanates an unusual charm."},{"spoiler":false,"text":"While treated very badly by men, he's incredibly popular with women."},{"spoiler":false,"text":"By changing his appearance, his qualities immediatly become evident. He made a noble woman fall in love at first sight."},{"spoiler":false,"text":"He's also the man who will become the legendary king of pregnancy."}],"source":"vndb","sourceCharacterId":"c63466"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c63467","characterName":"セレーヌ","sourceIds":{"vndbCharacterId":"c63467"},"originalCharacterName":"セレーヌ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Her beauty and grace well-known even in neighbouring countries, she's a princess admired by her people."},{"spoiler":false,"text":"Her dothing father ordered the head of the royal guards to protect her and not let any man come near her."},{"spoiler":false,"text":"As a result, she has never been touched by a man other than the king, and barely even spoke to any other man."},{"spoiler":false,"text":"She's mostly ignorant about sex."}],"source":"vndb","sourceCharacterId":"c63467"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1ccb5901aa5111264c04d4d13cfcdfe68ee3f3ab0b5fbb01f7f45cfbfb9458db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/255b49b3f2b36a7ea54b33d2e69128136e5142903a6dda1a8a3a9e5f138711ae.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊東 もえ","creatorId":"vndb:s3678","sourcePersonId":"vndb:s3678","canonicalEntityId":"vndb:s3678","name":"伊東 もえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:42121","source":"vndb"}]},{"characterId":"char_vndb_c63492","characterName":"リア","sourceIds":{"vndbCharacterId":"c63492"},"originalCharacterName":"リア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An aristocratic girl brimming with curiosity who is living without any inconveniences."},{"spoiler":false,"text":"She feels attracted to the protagonist when she sees him in low spirits in front of the castle gate and invites him to work in her mansion."},{"spoiler":false,"text":"But without forgetting their difference of social status, she approaches him as if playing around."}],"source":"vndb","sourceCharacterId":"