p","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"早瀬弥生","creatorId":"vndb:s936","sourcePersonId":"vndb:s936","canonicalEntityId":"vndb:s936","name":"早瀬 弥生","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41490:55269:11647:1","source":"bangumi"}]},{"characterId":"char_c22281","characterName":"宵宮 シュリー","sourceIds":{"bangumi":[{"characterId":"55268","match":"exact-normalized-name-in-linked-work","subjectId":"41490"}],"egsCharacterIds":["8424"],"vndbCharacterId":"c22281"},"originalCharacterName":"宵宮 シュリー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"411"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水泳部部長。パティーの姉。ハーフで帰国子女。"},{"spoiler":false,"text":"開け広げな性格で、慎みや思慮などとは無縁の性格。"},{"spoiler":false,"text":"かつて海外から編入してきた時に、唯一優しくしてくれた知早を、それ以来『ハニー』と呼び慕い、友人関係を装って接しているが、実際には心を奪われ、肉体的にも精神的にも狙っている。"},{"spoiler":false,"text":"と思いきや、同じ水泳部のいさなのことも可愛がりたいと思っているらしかったり、真弥にセクハラまがいのことをしてきたりと節操がなく、『変態女』と真弥には名付けられ、毛嫌いされている。"},{"spoiler":false,"text":"神としての名は『吉祥天』で、幸福や美や富を司る享楽の神。"},{"spoiler":false,"text":"妹のパティー（黒闇天）と行動を共にしていることが多く、二人で一組の神様ともいえる。"}],"source":"egs","sourceCharacterId":"8424","sourceWorkId":"17146","spoiler":false},{"segments":[{"spoiler":false,"text":"パティーの姉で、ハーフの帰国子女。水泳部部長を務めている3年生。"},{"spoiler":false,"text":"開けっ広げな性格で、慎みや思慮などとは無縁の性格。"},{"spoiler":false,"text":"かつて海外から編入してきた時に唯一優しくしてくれた知早を、それ以来 「ハニー」 と呼び慕い、友人関係を装って接しているが、実際には心を奪われ、肉体的にも精神的にも狙っている。"},{"spoiler":false,"text":"と思いきや、同じ水泳部のいさなのことも可愛がりたいと思っているらしかったり、真弥にセクハラまがいのことをしてきたりと節操がなく、“変態女” と真弥には名付けられ毛嫌いされている。"},{"spoiler":false,"text":"「いいわ。ワタシはあなたに質問をする、あなたはその間、ワタシのバストを楽しむ。これでお互い損はないわね」"}],"source":"bangumi","sourceCharacterId":"55268"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"55268","value":"ハニー、イナサ、女の子、楽しいこと、エッチな同人誌"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"55268","value":"ハニーとの仲を邪魔するもの"},{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"8424","sourceWorkId":"17146","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"8424","sourceWorkId":"17146","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"8424","sourceWorkId":"17146","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"8424","sourceWorkId":"17146","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/9861925962994e04b5604e01eb2f77b63a8df5248372dc13243a0aaa9a4b49b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e574b52a479f5ab825fa8346d0c672559dc916c5e7e496bb0849d45e5912e360.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41490:55268:6469:1","source":"bangumi"}]},{"characterId":"char_c22282","characterName":"徳永 星乃","sourceIds":{"bangumi":[{"characterId":"55265","match":"exact-normalized-name-in-linked-work","subjectId":"41490"}],"egsCharacterIds":["8421"],"vndbCharacterId":"c22282"},"originalCharacterName":"徳永 星乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"820"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"height":{"reviewState":"no-conflict","source":"vndb","value":"151"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"１つ年下の妹。"},{"spoiler":false,"text":"実際には、真弥とは遠い親戚関係であり、幼い頃に真弥の家に引き取られ、それ以来同じ屋根の下で兄妹のように暮らしている妹的存在の女の子である。"},{"spoiler":false,"text":"小さい時は、いつも真弥の後をついてくる可愛さがあり、お年寄りにもよく構われていたが、その面影はどこへやら、近頃は真弥から話しかけてもそっけなく返されることが多い。"},{"spoiler":false,"text":"現在は、ファッションやメイクにこだわりを持ち、いかにも今風な友達と一緒になって遊ぶのが楽しみのようだ。"},{"spoiler":false,"text":"彼女は他にないタイプの神で、『福禄寿』と『寿老人』という、南極星を司る２つの神の資質を備えている。"}],"source":"egs","sourceCharacterId":"8421","sourceWorkId":"17146","spoiler":false},{"segments":[{"spoiler":false,"text":"1年生。1つ年下の妹。 実際は真弥とは遠い親戚関係であり、幼い頃に真弥の家に引き取られ、それ以来同じ屋根の下で兄妹のように暮らしている女の子。"},{"spoiler":false,"text":"小さい頃はいつも真弥の後をついて回り、お年寄りにもよく構われていたのだが……。"},{"spoiler":false,"text":"近頃は真弥から話し掛けても、そっけなく返されることが多くなってしまった。"},{"spoiler":false,"text":"ファッションやメイクにこだわりを持ち、いかにも今風な友達と一緒になって遊ぶのが楽しみ。"},{"spoiler":false,"text":"彼女は他に類のない、南極星を司る『福禄寿』 と 『寿老人』、2つの神の資質を備えている。"},{"spoiler":false,"text":"星を読み未来を予知する能力があり、危機を知らせ、七福神たちに行動の指針を示す。"},{"spoiler":false,"text":"しかし己の能力が現場向きでないため、神様の活動についてはイマイチ実感を得ていない。"},{"spoiler":false,"text":"興味がないような態度を取りながらも、これまで過ごした時間が長い分、真弥という人物に対しての理解は誰よりも深く、女ばかりの環境に戸惑う真弥を労わる気遣いも見せる。"},{"spoiler":false,"text":"「何、かっこつけてんの？　ありえないんだけど」"}],"source":"bangumi","sourceCharacterId":"55265"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"55265","value":"オシャレ（ファッション、メイク）"},{"lab