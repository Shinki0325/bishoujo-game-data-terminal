adataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74d0c5217c6bdd6e04018b5f4f0104280cb74da47b94a0027d65af954b029ecb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d0ddd70dca09800dbd297bedccd5dc2b5708789f0a2b3326048728e9746804d.webp","width":167,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ブリドカット・セーラ・恵美","creatorId":"vndb:s3948","sourcePersonId":"vndb:s3948","canonicalEntityId":"vndb:s3948","name":"ブリドカット・セーラ・恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:77387","source":"vndb"}]},{"characterId":"char_vndb_c59701","characterName":"野上 姫子","sourceIds":{"vndbCharacterId":"c59701"},"originalCharacterName":"野上 姫子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nogami has worked as Sengoku Ichiru's assistant ever since her time in CIRS’ Special Medical Division, and she continues to uphold that role at Mihama Academy."},{"spoiler":false,"text":"While brilliant, she also possesses several personal faults that get in the way of her day-to-day life. Case in point: the fact that her room is always such a total mess. Haruto thinks of her as a sort of surrogate older sister, turning to her first whenever he has issues that he's reluctant to discuss with Principal Sengoku."},{"spoiler":false,"text":"\"Nogami is fine.\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c59701"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/9388933b0d1b4e837ec3d76bcdbd7f6bac73276c5eaea54aad0c2ac0e7659926.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/charact