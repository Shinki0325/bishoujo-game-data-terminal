EntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:12342","source":"vndb"},{"creditedName":"松本 有加","creatorId":"vndb:s34890","sourcePersonId":"vndb:s34890","canonicalEntityId":"vndb:s34890","name":"松本 有加","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:12352","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c19166","characterName":"猫宮 のの","sourceIds":{"vndbCharacterId":"c19166"},"originalCharacterName":"猫宮 のの","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"410"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"AA"},"height":{"reviewState":"source-only","source":"vndb","value":"138"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Makoto’s childhood friend, ex-neighbour, and junior by a year. Her easygoing accent is one of her traits."},{"spoiler":false,"text":"Used to do everything at the Yuuki household; especially cooking in which she excelled at. She also used to wake up Makoto, Iori, and, whenever she stayed over, Matsuri."},{"spoiler":false,"text":"To Iori, she was her guardian. To Makoto, his caretaker."},{"spoiler":false,"text":"Wished to someday get back at Makoto for all his teasing."},{"spoiler":false,"text":"From Solpress"}],"source":"vndb","sourceCharacterId":"c19166"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4ff79160e3d90a68c8c788ec092bfb7d5a05e4d3773d6d72a30224de4adfa50e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9ecc2aab82131693a1cae08b6aef601c099828f3f52d2b534a9ccb798011246a.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊原 ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5753","source":"vndb"}]},{"characterId":"char_vndb_c56622","characterName":"雪 亜凜沙","sourceIds":{"vndbCharacterId":"c56622"},"originalCharacterName":"雪 亜凜沙","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"831"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"145"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Makoto’s classmate. A “childhood friend” that yearned to become a real childhood friend. A quiet, delicate girl with pale skin like that of snow, and a well proportioned face like that of a doll. Liked to read books by the window during breaks. Everyone thought of her as an unapproachable, yet beautiful, girl though she wasn’t aware of it."},{"spoiler":false,"text":"Due to a long-term hospitalization, she lost touch with people her age. However, even if she wanted to hold a conversation with them, she would get nervous, become unable to speak, and would flee in a panic. Her voice would be as low as a whisper, and one wouldn’t be able to make it out unless they were but a breath away."},{"spoiler":false,"text":"Before being hospitalized, she would rely on Makoto since they were friends. But by the time she was discharged, not only was he cold towards her, but he also completely forgot about her. Unable to depend on him any longer, she decided not to forgive him until he apologized. Though she was weak to Makoto’s smile, needing only one to completely forgive him."},{"spoiler":false,"text":"She wished to be a childhood friend in the same way Makoto, Iori, Matsuri, and Nono are."},{"spoiler":false,"text":"From Solpress"}],"source":"vndb","sourceCharacterId":"c56622"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2e9d7939724a891551255e8337e3dfab6fc8b782c38a5d075d4602ca9eff2d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8e2261a72a3039885af6b6e34887f565f41c47ae448653174a796e927713678.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みる","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5755","source":"vndb"},{"creditedName":"矢作 紗友里","creatorId":"vndb:s670","sourcePersonId":"vndb:s670","canonicalEntityId":"vndb:s670","name":"矢作 紗友里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5762","source":"vndb"}]},{"characterId":"char_vndb_c56623","characterName":"柚姫 衣織","sourceIds":{"vndbCharacterId":"c56623"},"originalCharacterName":"柚姫 衣織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"707"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"height":{"reviewState":"source-only","source":"vndb","value":"154"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Iori is Makoto’s childhood friend, who used to live together with him, and is also one year his senior. Putting it nicely, she is an older “little sister.” Otherwise, an absolute good-for-nothing. She liked being pampered by Makoto and, much to his chagrin, acted like a big sister too. “You shouldn’t forget your carrots, okay? Here, I’ll give you mine too.”"},{"spoiler":false,"text":"Used to drink a glass of lemon juice, together with Makoto, every night before going to sleep. Always adding three spoonfuls of sugar."},{"spoiler":false,"text":"From Solpress"}],"source":"vndb","sourceCharacterId":"c56623"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b8c13dfbda3305f3b8e91ab744ef2291f6fd07edd3f597c6b05771a3c1fe2b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af2a103bb46470d566effb5ed20c3ef2ddeef790b932ad12cbd59b447a2ba9cd.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"草柳 順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5760","source":"vndb"},{"creditedName":"後藤 邑子","creatorId":"vndb:s833","sourcePersonId":"vndb:s833","canonicalEntityId":"vndb:s833","name":"後藤 邑子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5764","source":"vndb"}]},{"characterId":"char_vndb_c56624","characterName":"天地 祭","sourceIds":{"vndbCharacterId":"c56624"},"originalCharacterName":"天地 祭","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"801"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Matsuri is Makoto’s childhood friend and has had a love/hate relationship with him since forever. Same age as Makoto and always barges into his room through the window."},{"spoiler":false,"text":"Despite her wish to be treated differently, Matsuri would always whine whenever her friends left her alone. She is moody, cheerful, daring at times, and somewhat popular due to her shy nature around strangers. Despite her antagonistic relationship with Makoto, she would always go along with his pranks. “The point is, it’ll be all right if we don’t get caught. We’re playing a prank on them, after all.”"},{"spoiler":false,"text":"From Solpress"}],"source":"vndb","sourceCharacterId":"c56624"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d94243ce836c39519ce052ebba57e43f1068ac14754238a2d185140deedfe9b5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4cd0e3830f07657fa0ee54e79fb4c025d62a26f2a9beb128f44522727fddb53.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤 麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5758","source":"vndb"},{"creditedName":"伊吹雫","creatorId":"vndb:s12045","sourcePersonId":"vndb:s12045","canonicalEntityId":"vndb:s12045","name":"伊吹雫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5770","source":"vndb"}]},{"characterId":"char_vndb_c56627","characterName":"鈴木 久美子","sourceIds":{"vndbCharacterId":"c56627"},"originalCharacterName":"鈴木 久美子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Iori's classmate."}],"source":"vndb","sourceCharacterId":"c56627"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/