yuu:5766","source":"vndb"}]},{"characterId":"char_vndb_c77792","characterName":"天地 祭","sourceIds":{"vndbCharacterId":"c77792"},"originalCharacterName":"天地 祭","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"801"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"C"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"After Mochizuki closed down, she was the only one to attend the local school, Gekka. An upper-class school mostly attended by girls from elite families. Her once cheerful personality soured and turned cold and taciturn. She has changed the most in regards to personality and looks with nobody knowing the reasons why."},{"spoiler":false,"text":"From Solpress"}],"source":"vndb","sourceCharacterId":"c77792"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1f32b5894f3126e0d7519bcabdc56908af5a2336b5d1f6dfd4f253cabe1dbbf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/574a558b2e1973ef8f391877353e8fbbfd88c462836b7d05f05d5f1b485adb5a.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤 麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5759","source":"vndb"},{"creditedName":"伊吹雫","creatorId":"vndb:s12045","sourcePersonId":"vndb:s12045","canonicalEntityId":"vndb:s12045","name":"伊吹雫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5771","source":"vndb"}]},{"characterId":"char_vndb_c77793","characterName":"柚姫 衣織","sourceIds":{"vndbCharacterId":"c77793"},"originalCharacterName":"柚姫 衣織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"707"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"G"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"After Mochizuki closed down, she moved in with some relatives in another prefecture and attended a local business academy. Her huge breasts, the only thing Makoto was proud of her for, grew even bigger. Her habit of acting like an older sister is still very much alive."},{"spoiler":false,"text":"She was looking forward to reuniting with Makoto and getting pampered by him, but was disappointed to learn that he doesn’t refer to her like before."}],"source":"vndb","sourceCharacterId":"c77793"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/723f7f9a1df3e90a76f04b4ed3b627e1011464ba7408bf60f5fd8e419594c697.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a3fe90c86451e615cef18dc67d623e92b8378ebd814ecc98e00a5cd3b6818ac.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"草柳 順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5761","source":"vndb"},{"creditedName":"後藤 邑子","creatorId":"vndb:s833","sourcePersonId":"vndb:s833","canonicalEntityId":"vndb:s833","name":"後藤 邑子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5765","source":"vndb"}]},{"characterId":"cha