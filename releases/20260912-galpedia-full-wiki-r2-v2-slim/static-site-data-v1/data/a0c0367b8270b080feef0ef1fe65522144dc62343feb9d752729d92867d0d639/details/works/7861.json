:false,"text":"若くして相当な成果を上げている開発部門のホープで、入社後すぐに海外に派遣され、帰って来た途端に一部門を単独で与えられるという鳴り物入りの扱いを受けている。 平静な外見の下にはおもしろがりな激情家の素顔があるが、本人はそれを隠し切ることこそ面白がっているので本性は他人には窺い知れない。 主人公が手にした媚薬スプレーは、開発部でも異端の麗子が独自に「回春薬」という名目で開発した薬。 実は後遺症などの無い媚薬。スプレータイプで男性のフェロモンと結びつき、女性の性感を過度に刺激する。それを知らないヒロイン達は、 純粋に主人公の男としての魅力に参ってしまったと思っている。"}],"source":"bangumi","sourceCharacterId":"90224"}],"profileFacts":[{"label":"年龄（本版本）","value":"28 岁","valueContext":null,"source":"egs","sourceCharacterId":"25350","sourceWorkId":"7861","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"25350","sourceWorkId":"7861","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"25350","sourceWorkId":"7861","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"25350","sourceWorkId":"7861","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/953d1a580264b46d695723e62bc9bc8f18f37ebf7c89bffb90f0c85abe71ce6d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/8734fcef1c7d28f24f64f512c21a1cac11e92169b6dd25024968a675408fc371.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤村歩","creatorId":"vndb:s1703","sourcePersonId":"vndb:s1703","canonicalEntityId":"vndb:s1703","name":"藤村 歩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223770:90224:4783:1","source":"bangumi"}]},{"characterId":"char_c4348","characterName":"栗橋 さつき","sourceIds":{"bangumi":[{"characterId":"90228","match":"exact-normalized-name-in-linked-work","subjectId":"223770"}],"egsCharacterIds":["25353"],"vndbCharacterId":"c4348"},"originalCharacterName":"栗橋 さつき","characterNameSource":null,"role":"primary","status":"source-on