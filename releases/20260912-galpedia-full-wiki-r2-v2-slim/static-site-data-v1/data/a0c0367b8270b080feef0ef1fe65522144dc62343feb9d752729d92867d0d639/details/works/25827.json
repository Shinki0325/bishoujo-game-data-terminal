ments":[{"spoiler":false,"text":"An enigmatic youth you met in the pitch black world. He's always lethargic without having an interest in anything, a so-called shut-in. That being said, he's a very talkative quibbler and has malicious tongue. He often says things that would turn the entire world against him."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c28307"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a05a12fcf1250d91fde82b39bf1914afbaa622e2617505b582bef13657f406d9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a2fbfd30256ec1795500c270e3959be9daf44d588bd1c90a5ed293ddbeae67f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松岡 禎丞","creatorId":"vndb:s748","sourcePersonId":"vndb:s748","canonicalEntityId":"vndb:s748","name":"松岡 禎丞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:71685","source":"vndb"},{"creditedName":"青山 桐子","creatorId":"vndb:s18319","sourcePersonId":"vndb:s18319","canonicalEntityId":"vndb:s18319","name":"青山 桐子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:71689","source":"vndb"}]},{"characterId":"char_vndb_c28308","characterName":"オオカミ","sourceIds":{"vndbCharacterId":"c28308"},"originalCharacterName":"オオカミ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"birthday":{"reviewState":"source-only","source":"vndb","value":"303"},"height":{"reviewState":"source-only","source":"vndb","value":"166"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A weak-bodied young boy wearing a wolf-design hood. He doesn't have much energy or strength. At a first glance, he seems like a herbivorous guy, but on the inside, he's masculine."},{"spoiler":true,"text":"His actual last name is \"大神 (Oogami)\", and he's childhood friends with Akazukin (the actual wolf in Taishou x Alice). They haven't been in contact with one another ever since Oogami's grandmother fell ill."},{"spoiler":false,"text":"Translation of his official website profile."}],"source":"vndb","sourceCharacterId":"c28308"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c54da8283c132a405d92a589ea9888f692a39758ff8f80cff6de8e43d3d0955c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/cadeede527c4ad912a701a399927194a2b396bb4800191bab5fc619a708a297e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花江 夏樹","creatorId":"vndb:s2180","sourcePersonId":"vndb:s2180","canonicalEntityId":"vndb:s2180","name":"ペロペロンチーノ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:71686","source":"vndb"}]},{"characterId":"char_vndb_c28309","characterName":"猟師","sourceIds":{"vndbCharacterId":"c28309"},"originalCharacterName":"猟師","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"29"},"birthday":{"reviewState":"source-only","source":"vndb","value":"314"},"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"72"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man full of mysteries, he leaves an impression of being coldhearted. When he suddenly appears, sometimes he offers advice, while other times he is antagonistic."},{"spoiler":false,"text":"He is Yurika's older brother and his real full name is \"有栖 椋士 (Arisu Ryoushi)\"."},{"spoiler":false,"text":"Translation of his official website profile."}],"source":"vndb","sourceCharacterId":"c28309"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/6659dcdc327d0ffac34f3ba8effdc9da4aedbe9b83bd267a6242cf395051756c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3fda72e06c5bb0033526faa988e5167bb7f709d51f0cf988a8a9aee2cf6c545.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橋詰 知久","creatorId":"vndb:s2181","sourcePersonId":"vndb:s2181","canonicalEntityId":"vndb:s2181","name":"橋詰 知久","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:71687","source":"vndb"}]},{"characterId":"char_vndb_c35905","characterName":"母親","sourceIds":{"vndbCharacterId":"c35905"},"originalCharacterName":"母親","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"31"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A very kind lady who is like an embodiment of the ideal mother. Her hobby is cooking."},{"spoiler":false,"text":"Translation of her official website profile."}],"source":"vndb","sourceCharacterId":"c35905"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be1ecf59b46c265496437d3aba23b6c4247ba1c217607d3c11b9f3b3d2b22b1c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/termi