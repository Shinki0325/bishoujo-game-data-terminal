ce-native","relationId":"vndb:vn-seiyuu:71679","source":"vndb"}]},{"characterId":"char_vndb_c28305","characterName":"白雪","sourceIds":{"vndbCharacterId":"c28305"},"originalCharacterName":"白雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1225"},"height":{"reviewState":"source-only","source":"vndb","value":"167"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A pretty boy who believes he is the most hideous thing in the entire world. He comes off as cold since he doesn't show emotion or speak much, but he's very observant of others and shows consideration indirectly. Although he will say rude things in rare cases, it's likely he doesn't realize it himself."},{"spoiler":false,"text":"Taken from Otome Jikan."}],"source":"vndb","sourceCharacterId":"c28305"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20ce36e234c832f77709460846ba2868ccdff5f6b41891d1e262fd15f358156d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11cbfbc621bf57e8a6e539426b3bb95636007e6041130ed27a2357f8da992983.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"蒼井 翔太","creatorId":"vndb:s141","sourcePersonId":"vndb:s141","canonicalEntityId":"vndb:s141","name":"蒼井 翔太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:71683","source":"vndb"}]},{"characterId":"char_vndb_c28306","characterName":"魔法使い","sourceIds":{"vndbCharacterId":"c28306"},"originalCharacterName":"魔法使い","characterNameSource":null,"role":"primary","status":"source-only-ca