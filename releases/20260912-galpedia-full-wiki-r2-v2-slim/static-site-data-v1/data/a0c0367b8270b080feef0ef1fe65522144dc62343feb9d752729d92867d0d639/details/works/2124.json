":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Childhood friend of Yuuya and also his bodyguard, protecting him from the misfortune that brings the use of \"Yui\". Doesn't have powers, but instead has a superb ability with the sword and a very developed sixth sense. Works also as a nurse in the local hospital. From a family that owns a ryokan, has been trained in domestic tasks since little."}],"source":"vndb","sourceCharacterId":"c3296"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a6c3c75d226d4a332b0652fc96e3d3e3d094f3cf110b8b28d37c77881d2b5ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af945a7c97bab96b716817614eab7893a7899218eeef06571b2feabcbf0d7b10.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c3297","characterName":"ソルネ","sourceIds":{"vndbCharacterId":"c3297"},"originalCharacterName":"ソルネ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"100"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Director and keeper of the Monogami Museum and 100 years old monogami (objects that developed a soul after continued use) herself. Doll made by the previous director, dead several years before, from a fragment of the big cherry blossom tree. Acts as a mother for all the monogami in the museum, and can interact with them thanks to her power of \"Soujou\" (thought transfer)."}],"source":"vndb","sourceCharacterId":"c3297"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f961a8d4f984061a26b634f5eafd693d1b50df2133d769e387a48af053d4c433.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce031ed59fd9c5486f4f8bc976c7bbba28bda3f1bb38ddbdca9eb5572f769b9f.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c3298","characterName":"鈴森 静名","sourceIds":{"vndbCharacterId":"c3298"},"originalCharacterName":"鈴森 静名","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Guardian of Yuuya and Yui after their parents death. Has a terrible frightful dark side. Owner of Kaguraya. Has the power of \"Kyokou\" (hollow happiness)."}],"source":"vndb","sourceCharacterId":"c3298"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c17e50ccc05b570978eaa9d3a638b7c6f23dd4166cb051ae79dd8ae44db48bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bfd377e5883500cef873f8fbc341f69a7a5e06d6e338731b6be2de04d8fef979.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c3299","characterName":"紺屋 美奈","sourceIds":{"vndbCharacterId":"c3299"},"originalCharacterName":"紺屋 美奈","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daughter from a prominent moribito family. Of a reserved personality, seemed lively only when playing tennis, but a severe wound in her feet has made her future prospects dark, and the characters fear that it would become a trauma."}],"source":"vndb","sourceCharacterId":"c3299"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f