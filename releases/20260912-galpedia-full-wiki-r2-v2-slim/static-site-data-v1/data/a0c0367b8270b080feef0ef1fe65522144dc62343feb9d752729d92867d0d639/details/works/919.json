cters/v1/images/71/71fb2c92b6d8d4c1b6b5c839e4f0a3d15200aac32bc1aa33ee49a0bb1f9e50b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74b3bf1590d3d39eafc35c766d75590d3762fc8cc455fae9e8f6dbc8b492315b.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82068","characterName":"源 優子","sourceIds":{"vndbCharacterId":"c82068"},"originalCharacterName":"源 優子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Specialities: studying, sports in general"},{"spoiler":false,"text":"Weakness: music"},{"spoiler":false,"text":"Hobby: gaming"},{"spoiler":false,"text":"Kouji's childhood friend and the school student president. She is also Kouji's ex-girlfriend. Her parents divorced when she was young, and she was taken custody of and raised by her mother who runs a beauty clinic. Strict about regulations and promises, but otherwise a very laid-back personality. For better or worse, in some respects she is inattentive and sloppy with budgeting. She is a big sister figure in that she looks after her juniors well and treats men and her seniors with impartiality, but she has gaming as her hobby and is a super gamer girl to the point that she has gaming system boards at her home and can even create cable harnesses herself."},{"spoiler":false,"text":"Translated from Scramble HOUSE's official website"}],"source":"vndb","sourceCharacterId":"c82068"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7eee1668b03e10a7060e1a3c302875048ee1b13c8cd3eef853caaecbc6e534f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6bfc649ee79ae63c5772c86f3849ca1e27e0c19b3e6458d77d447f6029936530.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82070","characterName":"雨宮 麗依那","sourceIds":{"vndbCharacterId":"c82070"},"originalCharacterName":"雨宮 麗依那","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"source-only","source":"vndb","value":"168"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Specialities: studying, sports. She can do pretty much anything."},{"spoiler":false,"text":"Weakness: interpersonal relationships"},{"spoiler":false,"text":"Hobby: reading"},{"spoiler":false,"text":"The sole daughter of the Amemiya family, the largest landowner in the town of Kanna. An honorable young lady whose father is the member of the parliament, but she dyed her hair upon entering the Kanna Academy. She is the type that hates crowds and loud places, and finds peace in reading books. She hates how she becomes hysteric at a moment's notice and tries to act as rational as she can. Because Reina is the daughter of a wealthy family and because she excels at studying and all kinds of sports, those around her find her difficult to approach and think of her as distant and arrogant, but she indulges in junk food when no one is looking and also collects toys from the meals."},{"spoiler":false,"text":"Translated from Scramble HOUSE's official website"}],"source":"vndb","sourceCharacterId":"c82070"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58967984cff1a13d00f3d83a92f2758553d014d89aea0b21cc48a69571f79961.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97b2dfb46d29a819d272450b3e61d3c5e38583e9ff14f7435a6efee449dff394.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82073","characterName":"佐伯 香奈","sourceIds":{"vndbCharacterId":"c82073"},"originalCharacterName":"佐伯 香奈","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Adviser of the school art club. Married and has children."}],"source":"vndb","sourceCharacterId":"c82073"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0e5a9ebcb6b73283c2b7c5535656432e1311d3730417f289803900a2033b227.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d00467965061c2f77d87c86d78bdda0603d955cb2902f7b746d79956537a8b87.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82076","characterName":"海江田 佳枝","sourceIds":{"vndbCharacterId":"c82076"},"originalCharacterName":"海江田 佳枝","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kouji's aunt and a famous painter. Acts as Kouji's guardian."}],"source":"vndb","sourceCharacterId":"c82076"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8723b0d7d7ec21f4c0e5013633602ee912c065c465687f3176ef0e40c8ab20a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/3452beb372668fd961072e0ba9a2ca9f527afe9adc0ddd691d6c1ccc76507da7.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82077","characterName":"弘司の母","sourceIds":{"vndbCharacterId":"c82077"},"originalCharacterName":"弘司の母","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kouji's mother who passed away when he was a child and whose ghost now haunts Kouji's house. Only her blood relatives Kouji and Yoshie are able to see her."}],"source":"vndb","sourceCharacterId":"c82077"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2df5c3615c1346ef8e1aa822308b2da9ac79e5b384daf213d42c0bfb2932fb90.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8dddad52f0e3d42316077bb7de3578a00a6ab708340b39171a8b14a5e3f56ac2.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82078","characterName":"海江田 羽純","sourceIds":{"vndbCharacterId":"c82078"},"originalCharacterName":"海江田 羽純","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"source-only","source":"vndb","value":"161"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Specialities: philosophy and comparative religion"},{"spoiler":false,"text":"Weakness: sports in general"},{"spoiler":false,"text":"Hobby: housework in general. She especially loves cooking and knitting"},{"spoiler":false,"text":"Language teacher at Kanna Academy. She is Kouji's cousin who takes care of cooking and housework at Kaieda household. In the Kaieda household that houses those who are both decadent and artistically inclined, she is the sole person stubborn enough to secure a position as a teacher. She shows neither talent nor interest in art, instead possessing fascination towards the metaphysical world that can't be drawn. She is extremely gentle and always gives a heartwarming impression to those around her. However, she tends to make false assumptions upon which she can't easily be swayed to change her mind."},{"spoiler":false,"text":"Translated from Gyutto product page"}],"source":"vndb","sourceCharacterId":"c82078"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47c1a184d6354a11386a3b4ebc6024453a8c0669f4aa25eca5e30d51948d1da2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/543838f55776142b660a4693ed5800ae02b49ba0db8994c9438eaecda29f1259.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82079","characterName":"平野 深雪","sourceIds":{"vndbCharacterId":"c82079"},"originalCharacterName":"平野 深雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"73"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Specialities: painting, fine arts in general"},{"spoiler":false,"text":"Weaknesses: indifference to the latest fads, inability to use high tech equipment well"},{"spoiler":false,"text":"Hobbies: painting and playing with animals"},{"spoiler":false,"text":"A strong-willed person with a firm sense of duty who will see any decision through to the end. At the same time, she is able to pick up on the feelings of others and considerately match how she treats the other party. She finds it very hard to deal with anything inanimate and is completely hopeless with anything mechanic to the point where even turning a computer on brings her trouble. She likes hand-crafted fashion such as reworking her and her friend's school uniforms. At present she is collecting Indian jewelry."},{"spoiler":false,"text":"Translated from Scramble HOUSE's official website"}],"source":"vndb","sourceCharacterId":"c82079"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/3353322c209022db1cc8d6acc230e61b8b2d6c296a90951578067e4ab35eea8e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/abf0adf4832d02a0e281646ec001a0520ffab9f69d26ded4d7289cd7d5bb9df6.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82080","characterName":"山岡 あみ","sourceIds":{"vndbCharacterId":"c82080"},"originalCharacterName":"山岡 あみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"73"},"height":{"reviewState":"source-only","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"75"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Speciality: liberal arts subjects in general"},{"spoiler":false,"text":"Weakness: interpersonal relationships"},{"spoiler":false,"text":"Hobbies: the occult, black magic"},{"spoiler":false,"text":"Kouji's junior. An acquaintance of Minamoto Yuuko through whom she got to know Kouji. She has a gloomy and easily dejected personality, and feels strongly alienated from others. She hasn't gotten along with her parents and her siblings ever since she was a child, or rather, they do not involve themselves with her. She got interested in the occult and black magic after entering middle school and has been leading a life of indulging into them. Even the reason she wanted to meet Kouji was that he is said to have seen a ghost in his childhood. She respects Yuuko and wants to become like her. She likes shoujo manga and reggae music."},{"spoiler":false,"text":"Translated from Scramble HOUSE's official website"}],"source":"vndb","sourceCharacterId":"c82080"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c955fdc4b4d4da4542339d8fcaf2d08148caa76eb9090e66fd033167e5bac0e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/386c1daa1758e464adcc77d49ed276ba7988f30b152da6542623493b98ee2922.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82081","characterName":"早川 紅葉","sourceIds":{"vndbCharacterId":"c82081"},"originalCharacterName":"早川 紅葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"source-only","source":"vndb","value":"170"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Specialities: martial arts in general, exorcism"},{"spoiler":false,"text":"Weakness: relationships with men"},{"spoiler":false,"text":"Hobby: collecting weapons"},{"spoiler":false,"text":"A taciturn and unsociable boyish girl. Possesses great knowledge of the arts. Dislikes feminine clothing and wears her school uniform's skirt out of necessity. She has many black pantsuits in her dresser at home. Seems like she is somehow connected to Alcon..."},{"spoiler":false,"text":"Translated from Scramble HOUSE's official website"}],"source":"vndb","sourceCharacterId":"c82081"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/581abbf604a7286a93bb111a9eb1db25280460953792b09d6f646bf68fec0c0d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70a0dc630a642607b0e2643c5641c1323ad5ca6a8f6d3e7a12d436d6aaf1eea5.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82090","characterName":"三浦 順一郎","sourceIds":{"vndbCharacterId":"c82090"},"originalCharacterName":"三浦 順一郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuko's current boyfriend. He is an aspiring writer and a web novelist."}],"source":"vndb","sourceCharacterId":"c82090"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/9454dd5de855ab5a2bc7f6d63c9c20a31c96b78b93d941a64c571d10f4976288.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86da533aa9ca284b7d8d7eea25a9bd6264abc7284c6e254bb2faa75df1766995.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82091","characterName":"優子の母","sourceIds