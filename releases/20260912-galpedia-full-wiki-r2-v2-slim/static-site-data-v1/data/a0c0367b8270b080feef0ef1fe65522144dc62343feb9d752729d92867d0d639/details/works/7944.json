rId":"vndb:s44993","sourcePersonId":"vndb:s44993","canonicalEntityId":"vndb:s44993","name":"かじむら カジマ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:32721","source":"vndb"},{"creditedName":"蓮見 ついな","creatorId":"vndb:s46018","sourcePersonId":"vndb:s46018","canonicalEntityId":"vndb:s46018","name":"蓮見 ついな","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:32722","source":"vndb"}]},"cast":[{"characterId":"char_c43192","characterName":"プリマヴェール・フレア","sourceIds":{"bangumi":[{"characterId":"94806","match":"exact-normalized-name-in-linked-work","subjectId":"228963"}],"egsCharacterIds":["16969"],"vndbCharacterId":"c43192"},"originalCharacterName":"プリマヴェール・フレア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"太陽の力を司るプリマヴェール。"},{"spoiler":false,"text":"普段は明朗快活、健気で優しい女子校生で、少し子供っぽいところもあるが、正義感は人一倍強く、決して挫けない心を持つ。"},{"spoiler":false,"text":"囚われのプリマヴェール・ルナ（サクラ）を救うため、そして、悪を打ち倒すため、彼女は今日も戦い続ける。"}],"source":"egs","sourceCharacterId":"16969","sourceWorkId":"7944","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のメインヒロイン。太陽の力を司る、プリマヴェール・フレアに変身する。普段は太陽のように明るく元気、たまにはドジもするけれど、けなげで優しい女子校生。私立星屑学園に通う1年生。"},{"spoiler":false,"text":"サクラと比べるとまだまだ未熟で、子供っぽいところも。なにせ彼女は、まだ恋も知らない少女なのだから。"},{"spoiler":false,"text":"正義感が強く、決して挫けない強い心を持っている。"},{"spoiler":false,"text":"囚らわれの身のサクラを救い出すため、そして世界を悪の手から護るため、ハルカは今日も戦う！"},{"spoiler":false,"text":"「待っててくださいお姉様、きっと救い出してみせます！」"}],"source":"bangumi","sourceCharacterId":"94806"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/820a318442be5a657b948e0f78a3eec0e398b531cfc9d1424d3b0f3047a3a570.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/baf7141d2010ae16610b91551d11a3b44c8ff100a66ba08f4f7527b82550692a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤雅美","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228963:94806:13773:1","source":"bangumi"}]},{"characterId":"char_c43193","characterName":"プリマヴェール・ルナ","sourceIds":{"bangumi":[{"characterId":"94807","match":"exact-normalized-name-in-linked-work","subjectId":"228963"}],"egsCharacterIds":["16970"],"vndbCharacterId":"c43193"},"originalCharacterName":"プリマヴェール・ルナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"月の力を司るプリマヴェールで、ハルカのお姉様的存在。"},{"spoiler":false,"text":"全校生徒が憧れる先輩であり、柔らかい優しさを持つ女子校生。"},{"spoiler":false,"text":"マルクジェネとの戦いに敗れ、囚われの身となり、「実験」と称した恥辱・凌辱にまみれた日々を過ごす。"}],"source":"egs","sourceCharacterId":"16970","sourceWorkId":"7944","spoiler":false},{"segments":[{"spoiler":false,"text":"月の力を司る、プリマヴェール・ルナに変身する。ハルカのお姉様的存在であったが、マルクジェネとの戦いに破れ、囚われの身となる。そして始まる、実験という名の陵辱。死ぬ事も許されず、恥辱にまみれる日々を過ごすことになる。"},{"spoiler":false,"text":"ハルカと同じ私立星屑学園に通う3年生。全校生徒憧れの先輩であり、全てを包み込む柔らかな優しさを持つ女性だった。"},{"spoiler":false,"text":"「月は太陽によって輝くもの……お願いフレア、戦って！」"}],"source":"bangumi","sourceCharacterId":"94807"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99f40ecb56a86d248ebb26e90025b368e835ce5672232e80bb0813428a6c97d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3c6be7981da3b54dcea21c92bc753c92e6ecb19d6e09f58ca5f3b9227265c8f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228963:94807:4489:1","source":"bangumi"}]},{"characterId":"char_c43194","characterName":"ブラックルナ","sourceIds":{"bangumi":[{"characterId":"94815","match":"exact-normalized-name-in-linked-work","subjectId":"228963"}],"egsCharacterIds":["16975"],"vndbCharacterId":"c43194"},"originalCharacterName":"ブラックルナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"gender":{"reviewState":"source-only","source":"vndb","value":"f"},"sex":{"reviewState":"source-only","source":"vndb","value":"b"}},"descriptions":[{"segments":[{"spoiler":false,"text":"プリマヴェール・ルナに似ている女性。"},{"spoiler":false,"text":"しかし、怪しく艶やかな笑みを浮かべ、際どい恰好で登場する彼女の身体は、闇のエナジーで覆われており、正義の光は見えない。"},{"spoiler":false,"text":"はたして、彼女とルナの関係は……？"}],"source":"egs","sourceCharacterId":"16975","sourceWorkId":"7944","spoiler":false},{"segments":[{"spoiler":false,"text":"プリマヴェール・ルナによく似ている女性だが、彼女の正体は一体…？"}],"source":"bangumi","sourceCharacterId":"94815"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"b","source":"vndb","sourceCharacterId":"c43194","value":"b"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"16975","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"16975","value":"女性"},{"comparisonValue":"f","source":"bangumi","sourceCharacterId":"94815","value":"女"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3b103d73403bc2a69c3c0292acbbd4caf23fa5bf5f1c1ee0b462a5aeee82bad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc3205d6c4f6a1912bc158a42246a8a89e59e0fad5e2e3843930ffe8dfebd88d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228963:94815:4489:1","source":"bangumi"}]},{"characterId":"char_c43195","characterName":"キルヴィール","sourceIds":{"bangumi":[{"characterId":"94813","match":"exact-normalized-name-in-linked-work","subjectId":"228963"}],"egsCharacterIds":["16973"],"vndbCharacterId":"c43195"},"originalCharacterName":"キルヴィール","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"3歳で兵法書を読破した、マルクジェネの天才軍師。"},{"spoiler":false,"text":"その性格は、極めて残忍かつ狡猾で、苦痛に喘ぐ人々の姿にエクスタシーを感じるほど。"},{"spoiler":false,"text":"組織内では、主人公のライバル的存在であり、彼を快く思っていない彼女は、"},{"spoiler":false,"text":"何かにつけて目の敵にしている様子。"}],"source":"egs","sourceCharacterId":"16973","sourceWorkId":"7944","spoiler":false},{"segments":[{"spoiler":false,"text":"マルクジェネの軍師を務める。3歳で孫子の兵法書を読破したという天才。しかし、その性質は、非常に凶悪で狡猾。人の命など虫けら以下にしか考えておらず、理不尽に与えられた苦悩にあえぐ善良な市民の姿に、エクスタシーを感じる。夕食の食べ残しを捨てる程度の気分で、街一つを爆破しかねない。邪悪極まりない極度のサディストである。"},{"spoiler":false,"text":"プリンスの事を心良く思っておらず、何かとつけて目の敵にする。狡猾な女狐。組織内における、プリンスのライバルとなる存在。"},{"spoiler":false,"text":"「ニシシ……『バグ』さえ完成したら、世界はアタシのもの♪」"}],"source":"bangumi","sourceCharacterId":"94813"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/0595489963deeb32bcd2f07903f86349a2607d25be250aa00bbdfc5d0c4fcd32.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65bdcc62b6d7fec671d226a86d399f58ad135a77f585433675a76d94817b5c29.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228963:94813:4490:1","source":"bangumi"}]},{"characterId":"char_c43198","characterName":"早苗さん","sourceIds":{"bangumi":[{"characterId":"94812","match":"exact-normalized-name-in-linked-work","subjectId":"228963"}],"egsCharacterIds":["16974"],"vndbCharacterId":"c43198"},"originalCharacterName":"早苗さん","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"マルクジェネが誇る超科学研究所の所長。"},{"spoiler":false,"text":"主人公にとっては、死んだ兄の嫁であり、悪の組織にありながら、どこか家庭的な雰囲気で、誰にでも面倒見がよいため、組織内でも評判の女性。"},{"spoiler":false,"text":"時折見せる天然ボケが、逆に可愛いと高評価だが、彼女の本当の姿を見た者は、戦いに散った夫だけとか。"}],"source":"egs","sourceCharacterId":"16974","sourceWorkId":"7944","spoiler":false},{"segments":[{"spoiler":false,"text":"マルクジェネが誇る超科学研究所の所長を務める女性。プリンスにとっては、死んだ兄の嫁であり、今は未亡人という事になる。"},{"spoiler":false,"text":"悪の組織にありながら、どこか家庭的な雰囲気を持つ女性で、プリンスに対してだけではなく、組織の誰にとっても面倒見のいい義姉といった女性に見える。年齢的にも外観的にも大人の女であるが、時折見せる天然ボケな部分などが、むしろ可愛らしいとの評判もある。"},{"spoiler":false,"text":"果たして、彼女の本当の姿を見た者はまだ組織内にはいない。いるとすれば、戦いに散っていった夫だけであるが……。"},{"spoiler":false,"text":"「そんなこともあろうかと、いいものを用意したの♪」"}],"source":"bangumi","sourceCharacterId":"94812"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d741fcd2de1c1411c9934fd83b76a64e6b8a86b2ab5dd90b54b198b9de01e71.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e2bb66a5b1f26d867e5970b542e620154a2f25c38339a6ba9d66b4250e65296.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228963:94812:4832:1","source":"bangumi"}]},{"characterId":"char_c43199","characterName":"メリッサ","sourceIds":{"bangumi":[{"characterId":"94811","match":"exact-normalized-name-in-linked-work","subjectId":"228963"}],"egsCharacterIds":["16972"],"vndbCharacterId":"c43199"},"originalCharacterName":"メリッサ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"b"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公直属の作戦参謀。"},{"spoiler":false,"text":"外見は年端もいかない少女のようだが、作戦に一切の私情を挟まず、合理的に行動する、実直な軍人である。"},{"spoiler":false,"text":"有能な秘書ではあるが、その頑なな態度は、主人公を苛立たせることもしばしば。"},{"spoiler":false,"text":"現在、恋人はいないようだが……。"}],"source":"egs","sourceCharacterId":"16972","sourceWorkId":"7944","spoiler":false},{"segments":[{"spoiler":false,"text":"プリンス直属の作戦参謀。外観は年端のいかぬ少女であるが、態度や言動は、まるで実直な軍人のようである。"},{"spoiler":false,"text":"作戦に一切の私情を挟まず、常に合理的に行動しようとする機械のような少女。そのかたくなな態度が、プリンスを苛立たせる事もしばしば。"},{"spoiler":false,"text":"有能な秘書でもあり、ゲーム中、プレイヤーをサポートしてくれる。"},{"spoiler":false,"text":"恋人はいないし、きっと今後も作らないと思われる。（本人が必要ないと思っているうちは無理だろう……）"},{"spoiler":false,"text":"「これは極めて単純（シンプル）かつ効果的（イフェクティブ）な作戦です」"}],"source":"bangumi","sourceCharacterId":"94811"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"b","source":"vndb","sourceCharacterId":"c43199","value":"b"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"16972","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"16972","value":"女性"},{"comparisonValue":"f","source":"bangumi","sourceCharacterId":"94811","value":"女"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/543cd1868d06ebadc6b83958bade6ae4b18f83d187214e85e01cb9356f6c4b73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a381cdbe737e4c5e08799789f5c727ba715b3a4cac94f4dc4791d7a127bb448.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田佳代","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228963:94811:6038:1","source":"bangumi"}]},{"characterId":"char_c43200","characterName":"ミルフィ","sourceIds":{"bangumi":[{"characterId":"94808","match":"exact-normalized-name-in-linked-work","subjectId":"228963"}],"egsCharacterIds":["16971"],"vndbCharacterId":"c43200"},"originalCharacterName":"ミルフィ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"プリマヴェールにくっついている謎の妖精。"},{"spoiler":false,"text":"ハルカの前では、その外見同様、愛くるしく振舞うが、彼女がいなくなると、とたんに性悪な本性を現す。"},{"spoiler":false,"text":"「女をオトすには、傷ついてるときが一番や！」と、ケンイチとハルカを無理やりくっつけようとしたり、"},{"spoiler":false,"text":"そのためなら、ハルカの恥ずかしい秘密を平気で暴露する、ある意味、一番危険で鬼畜なキャラクター。"}],"source":"egs","sourceCharacterId":"16971","sourceWorkId":"7944","spoiler":false},{"segments":[{"spoiler":false,"text":"プリマヴェールにくっついている謎の妖精。魔法の力で空中に浮遊している。ハルカの前では、とても愛らしく振る舞っているが、彼女がいなくなるととたんに正体を現す。下卑た言葉を発し、ゲスな考え方をする。 例えば「女をオトすには、傷ついてる時が一番や！」とか平気で言い、ケンイチとハルカを無理矢理くっつけようとしたり。そのためなら、ハルカの恥ずかしい秘密を暴露する事も躊躇しない。ある意味、一番鬼畜なキャラクター。"},{"spoiler":false,"text":"「愛のエナジーで変身ミル～☆」"}],"source":"bangumi","sourceCharacterId":"94808"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"f","source":"vndb","sourceCharacterId":"c43200","value":"f"},{"comparisonValue":"m","source":"egs","sourceCharacterId":"16971","value":"男性"},{"comparisonValue":"m","source":"egs","sourceCharacterId":"16971","value":"男性"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e31c5442379a03097f4016f84132604d81dc1f1f466c3d81dbad77ae6d2a9d5c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b5405bd6081b4