onId":"vndb:vn-staff:183354","source":"vndb"},{"creditedName":"青谷 鴬","creatorId":"vndb:s15157","sourcePersonId":"vndb:s15157","canonicalEntityId":"vndb:s15157","name":"青谷 鴬","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:183356","source":"vndb"},{"creditedName":"ねこ","creatorId":"vndb:s32372","sourcePersonId":"vndb:s32372","canonicalEntityId":"vndb:s32372","name":"ねこ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:183360","source":"vndb"},{"creditedName":"やよ","creatorId":"vndb:s32384","sourcePersonId":"vndb:s32384","canonicalEntityId":"vndb:s32384","name":"やよ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:183361","source":"vndb"},{"creditedName":"ホームラン","creatorId":"vndb:s34453","sourcePersonId":"vndb:s34453","canonicalEntityId":"vndb:s34453","name":"ホームラン","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:183362","source":"vndb"},{"creditedName":"鶏さん","creatorId":"vndb:s35096","sourcePersonId":"vndb:s35096","canonicalEntityId":"vndb:s35096","name":"鶏さん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:183363","source":"vndb"},{"creditedName":"藤 生中","creatorId":"vndb:s49778","sourcePersonId":"vndb:s49778","canonicalEntityId":"vndb:s49778","name":"藤 生中","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:183365","source":"vndb"}]},"cast":[{"characterId":"char_c106847","characterName":"禰矢 郁美","sourceIds":{"bangumi":[{"characterId":"110111","match":"exact-normalized-name-in-linked-work","subjectId":"375909"}],"egsCharacterIds":["24589"],"vndbCharacterId":"c106847"},"originalCharacterName":"禰矢 郁美","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a second-year student at Minomori Private Academy."},{"spoiler":false,"text":"She was abandoned soon after birth, and after being passed around by relatives, she was taken in and raised in an orphanage."},{"spoiler":false,"text":"When she first arrived at the orphanage, she was a child with little emotion, but as she came into contact with the elderly couple who ran the orphanage, she gradually developed feelings like any other human being."},{"spoiler":false,"text":"She excelled in her studies, always ranking at the top of her class in tests. She entered Minomori Academy as a special scholarship student. (She has studied silently since she was a child because she thought she needed academic ability to stand on her own.)"},{"spoiler":false,"text":"Upon entering Minomori Academy, she left the orphanage and began living in the student dormitory."},{"spoiler":false,"text":"To earn money for living expenses, she works part-time at a family restaurant several times a week. She had originally wanted to work in the kitchen, but the manager put her in charge of the hall."},{"spoiler":false,"text":"Yuno is the first friend Ikumi has made, and she is very special to Ikumi. She had no particular interest in theater or the performing arts, but she joined the drama club because of Yuno's influence."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c106847"},{"segments":[{"spoiler":false,"text":"親を知らずに育った天涯孤独の少女"},{"spoiler":false,"text":"私立美乃守学園・普通科2年生。"},{"spoiler":false,"text":"産まれてすぐに育児放棄され、親戚筋をたらい回しにされた末、養護施設に引き取られて育った。"},{"spoiler":false,"text":"施設に来た頃は喜怒哀楽がほとんどない子供だったが、施設を運営する年輩の夫婦と接するうちに徐々に人並みの感情を養っていった。"},{"spoiler":false,"text":"勉強は得意で、テストの順位は常にトップクラス。"},{"spoiler":false,"text":"美乃守学園には特別奨学生として入学した。"},{"spoiler":false,"text":"（独り立ちするのには学力が必要だと思ったため、小さい頃から黙々と勉強していた）"},{"spoiler":false,"text":"美乃守学園に進学するにあたり、施設を出て学生寮で暮らすようになる。"},{"spoiler":false,"text":"生活費を稼ぐため、週に数回ファミレスでバイトをしている。"},{"spoiler":false,"text":"本当はキッチン希望だったが、店長の要望でホールを担当している。"},{"spoiler":false,"text":"結乃は初めて出来た友達で、郁美にとっては特別な存在。"},{"spoiler":false,"text":"演劇や芸能について特に興味はなかったが、結乃の影響で演劇部に入った。"}],"source":"egs","sourceCharacterId":"24589","sourceWorkId":"32484","spoiler":false},{"segments":[{"spoiler":false,"text":"私立美乃守学園・普通科2年生。"},{"spoiler":false,"text":"産まれてすぐに育児放棄され、親戚筋をたらい回しにされた末、養護施設に引き取られて育った。"},{"spoiler":false,"text":"施設に来た頃は喜怒哀楽がほとんどない子供だったが、"},{"spoiler":false,"text":"施設を運営する年輩の夫婦と接するうちに徐々に人並みの感情を養っていった。"},{"spoiler":false,"text":"勉強は得意で、テストの順位は常にトップクラス。"},{"spoiler":false,"text":"美乃守学園には特別奨学生として入学した。"},{"spoiler":false,"text":"（独り立ちするのには学力が必要だと思ったため、小さい頃から黙々と勉強していた）"},{"spoiler":false,"text":"美乃守学園に進学するにあたり、施設を出て学生寮で暮らすようになる。"},{"spoiler":false,"text":"生活費を稼ぐため、週に数回ファミレスでバイトをしている。"},{"spoiler":false,"text":"本当はキッチン希望だったが、店長の要望でホールを担当している。"},{"spoiler":false,"text":"結乃は初めて出来た友達で、郁美にとっては特別な存在。"},{"spoiler":false,"text":"演劇や芸能について特に興味はなかったが、結乃の影響で演劇部に入った。"}],"source":"bangumi","sourceCharacterId":"110111"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b924764ff1b95d1f822930cfbe8d1d9094666be1e9e63d3f75d6d5c40f8b63e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/9348d330ebb302be01b8a10a17e38ea6d82c95e61eb5ea6673aa4c9dbbd9c0ad.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"優希知冴","creatorId":"vndb:s12252","sourcePersonId":"vndb:s12252","canonicalEntityId":"vndb:s12252","name":"優希 知冴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:375909:110111:18452:1","source":"bangumi"}]},{"characterId":"char_c106849","characterName":"東ヶ崎 結乃","sourceIds":{"bangumi":[{"characterId":"110112","match":"exact-normalized-name-in-linked-work","subjectId":"375909"}],"egsCharacterIds":["24590"],"vndbCharacterId":"c106849"},"originalCharacterName":"東ヶ崎 結乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A quiet hard worker who takes theater seriously."},{"spoiler":false,"text":"A second-year student in the performing arts department at Minomori Private Academy."},{"spoiler":false,"text":"Since her stage debut at a young age, she has been appearing consistently."},{"spoiler":false,"text":"She is not well known among the general public because she rarely appears on television or other media, but she is well known among theater lovers and has a core fan base."},{"spoiler":false,"text":"Her father runs a small-to-medium-sized entertainment production company, to which Yuino belongs."},{"spoiler":false,"text":"Perhaps because she is surrounded by many adults, she tends to be seen as calmer than children her age and is often mistaken for an older person."},{"spoiler":false,"text":"She is friendly and can talk normally with almost anyone, but she has a habit of keeping a step back, and has few friends who are more than a certain level close to her."},{"spoiler":false,"text":"Among her few friends, Ikumi is a special person to whom she can show her true self."},{"spoiler":false,"text":"She is quite nosy with those she becomes close to, and is concerned about Ikumi's personal affairs."},{"spoiler":false,"text":"One of her hobbies is coordinating Ikumi's outfits."}],"source":"vndb","sourceCharacterId":"c106849"},{"segments":[{"spoiler":false,"text":"真摯に演劇と向き合う物静かな努力家"},{"spoiler":false,"text":"私立美乃守学園・芸能科2年生。"},{"spoiler":false,"text":"幼いころに舞台デビューして以来、コンスタントに出演を重ねている。"},{"spoiler":false,"text":"テレビなどのメディアにはほとんど出ないため、一般的な認知度は高くないが、演劇好きには知られた存在で、コアなファンも付いている。"},{"spoiler":false,"text":"父は中小の芸能プロダクションを経営していて、結乃も所属している。"},{"spoiler":false,"text":"周囲に大人が多かったためか、同年代の子と比べると落ち着いた印象を持たれやすく、年上に見られることが多い。"},{"spoiler":false,"text":"人当たりが良く、だいたいどんな相手とも普通に話せるけれども、一歩引いた立ち位置で付き合う癖があり、一定以上に親しい友人は少ない。"},{"spoiler":false,"text":"少ない友人の中でも、郁美は素の自分を見せられる特別な存在。"},{"spoiler":false,"text":"仲良くなった相手にはわりとお節介焼きで、郁美の身の回りのことを何かと気にかけている。"},{"spoiler":false,"text":"郁美のコーディネートが趣味のひとつ。"}],"source":"egs","sourceCharacterId":"24590","sourceWorkId":"32484","spoiler":false},{"segments":[{"spoiler":false,"text":"私立美乃守学園・芸能科2年生。"},{"spoiler":false,"text":"幼いころに舞台デビューして以来、コンスタントに出演を重ねている。"},{"spoiler":false,"text":"テレビなどのメディアにはほとんど出ないため、一般的な認知度は高くないが、"},{"spoiler":false,"text":"演劇好きには知られた存在で、コアなファンも付いている。"},{"spoiler":false,"text":"父は中小の芸能プロダクションを経営していて、結乃も所属している。"},{"spoiler":false,"text":"周囲に大人が多かったためか、同年代の子と比べると落ち着いた印象を持たれやすく、"},{"spoiler":false,"text":"年上に見られることが多い。"},{"spoiler":false,"text":"人当たりが良く、だいたいどんな相手とも普通に話せるけれども、"},{"spoiler":false,"text":"一歩引いた立ち位置で付き合う癖があり、一定以上に親しい友人は少ない。"},{"spoiler":false,"text":"少ない友人の中でも、郁美は素の自分を見せられる特別な存在。"},{"spoiler":false,"text":"仲良くなった相手にはわりとお節介焼きで、郁美の身の回りのことを何かと気にかけている。"},{"spoiler":false,"text":"郁美のコーディネートが趣味のひとつ。"}],"source":"bangumi","sourceCharacterId":"110112"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe33aae42142c2a823c03a272d08e5a9b473dce3f063dfa9de3bbfc37682ae9a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3eea94fdbab515feadbecabbafbb20303f8792b5ca7929eb754d9f6393d905ac.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"日向美紅","creatorId":"vndb:s18158","sourcePersonId":"vndb:s18158","canonicalEntityId":"vndb:s18158","name":"日向 美紅","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:375909:110112:27401:1","source":"bangumi"}]},{"characterId":"char_c106850","characterName":"白石 梨々紗","sourceIds":{"bangumi":[{"characterId":"110113","match":"exact-normalized-name-in-linked-work","subjectId":"375909"}],"egsCharacterIds":["24591"],"vndbCharacterId":"c106850"},"originalCharacterName":"白石 梨々紗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Although she appears free-spirited, she is a serious and caring senior."},{"spoiler":false,"text":"A third-year student in the performing arts department at Minomori Private Academy."},{"spoiler":false,"text":"Both of her parents are famous painters, and Ririsa has been traveling around the world all year round since she was a child."},{"spoiler":false,"text":"Because of this, she has very few memories of interacting with her parents."},{"spoiler":false,"text":"She is easygoing and good at getting close to people, and can usually get along with people she meets for the first time."},{"spoiler":false,"text":"On the other hand, she always keeps a certain distance, and there are very few people she interacts with in her private life."},{"spoiler":false,"text":"Although she is easygoing, she is a reliable person who is very observant. She often enjoys paying attention to Kasumi."},{"spoiler":false,"text":"After being scouted, she started modeling, but in reality, it doesn't feel right."},{"spoiler":false,"text":"She is good at painting, but recently she has been interested in three-dimensional sculpture."},{"spoiler":false,"text":"In the drama club, she is mainly in charge of art-related activities."},{"spoiler":false,"text":"There are things she is grateful to Yuino, and even though she is younger, she respects her."},{"spoiler":false,"text":"She feels that she has something in common with Ikumi, and is concerned about her."}],"source":"vndb","sourceCharacterId":"c106850"},{"segments":[{"spoiler":false,"text":"奔放に見えつつ、真面目で気遣い屋の先輩"},{"spoiler":false,"text":"私立美乃守学園・芸能科3年生。"},{"spoiler":false,"text":"両親は共に有名な画家で、梨々紗が幼い頃から一年中世界を飛び回っている。"},{"spoiler":false,"text":"そのため、親と触れあった思い出は極端に少ない。"},{"spoiler":false,"text":"飄々としていて、人の懐に入るのが上手く、初対面の人とも大抵仲良くなれる。"},{"spoiler":false,"text":"反面、常に一定の距離を取る所があり、私生活まで付き合いのある人間はごく少数。"},{"spoiler":false,"text":"ノリは軽いけれども、よく気がつくしっかり者。"},{"spoiler":false,"text":"よく果純をかまって楽しんでいる。"},{"spoiler":false,"text":"スカウトされたのをきっかけにモデル活動をしているが、実の所あまりしっくり来ていない。"},{"spoiler":false,"text":"絵画が得意なのだが、最近は立体造形に凝っている。"},{"spoiler":false,"text":"演劇部の活動では主に美術関係を担当している。"},{"spoiler":false,"text":"結乃には感謝していることがあり、年下ながらも尊敬している。"},{"spoiler":false,"text":"郁美とはどこか似ている所があると感じていて、気にかけている。"}],"source":"egs","sourceCharacterId":"24591","sourceWorkId":"32484","spoiler":false},{"segments":[{"spoiler":false,"text":"私立美乃守学園・芸能科3年生。"},{"spoiler":false,"text":"両親は共に有名な画家で、梨々紗が幼い頃から一年中世界を飛び回っている。"},{"spoiler":false,"text":"そのため、親と触れあった思い出は極端に少ない。"},{"spoiler":false,"text":"飄々としていて、人の懐に入るのが上手く、初対面の人とも大抵仲良くなれる。"},{"spoiler":false,"text":"反面、常に一定の距離を取る所があり、私生活まで付き合いのある人間はごく少数。"},{"spoiler":false,"text":"ノリは軽いけれども、よく気がつくしっかり者。"},{"spoiler":false,"text":"よく果純をかまって楽しんでいる。"},{"spoiler":false,"text":"スカウトされたのをきっかけにモデル活動をしているが、実の所あまりしっくり来ていない。"},{"spoiler":false,"text":"絵画が得意なのだが、最近は立体造形に凝っている。"},{"spoiler":false,"text":"演劇部の活動では主に美術関係を担当している。"},{"spoiler":false,"text":"結乃には感謝していることがあり、年下ながらも尊敬している。"},{"spoiler":false,"text":"郁美とはどこか似ている所があると感じていて、気にかけている。"}],"source":"bangumi","sourceCharacterId":"110113"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f239c64629822c979c84beb4a2a5cff07184657ec0c06858a2aa01f4fca5f427.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8f5906915f3de8249c84aeea4d9df3552177c0d3721ac568d93de791ba6aadb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤色朔","creatorId":"vndb:s10944","sourcePersonId":"vndb:s10944","canonicalEntityId":"vndb:s10944","name":"藤色 朔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:375909:110113:50224:1","source":"bangumi"}]},{"characterId":"char_c106851","characterName":"向 果純","sourceIds":{"bangumi":[{"characterId":"110114","match":"exact-normalized-name-in-linked-work","subjectId":"375909"}],"egsCharacterIds":["24592"],"vndbCharacterId":"c106851"},"originalCharacterName":"向 果純","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A shy junior who wants to work hard for her family."},{"spoiler":false,"text":"A first-year student in the performing arts department at Minomori Private Academy."},{"spoiler":false,"text":"Before entering Minomori Academy, she was scouted and joined an entertainment agency."},{"spoiler":false,"text":"However, she is not very busy and attends school as usual."},{"spoiler":false,"text":"She lives with her father and younger brother, but her father is currently recuperating at home due to rehabilitation."},{"spoiler":false,"text":"Therefore, Kasumi is mainly responsible for housework."},{"spoiler":false,"text":"She has a shy personality and does not speak up easily."},{"spoiler":false,"text":"Sheis weak to pressure and cannot refuse when asked for a favor."},{"spoiler":false,"text":"Shortly after entering the school, she had the opportunity to participate in a play put on by Yuino and her friends, and since then she has become friends with Yuino, Ikumi, and the others."},{"spoiler":false,"text":"She wants to work hard in the performing arts because of her family's financial situation, but she is shy and finds it difficult to be positive about it."}],"source":"vndb","sourceCharacterId":"c106851"},{"segments":[{"spoiler":false,"text":"家族のために頑張りたい恥ずかしがり屋な後輩"},{"spoiler":false,"text":"私立美乃守学園・芸能科1年生。"},{"spoiler":false,"text":"美乃守学園へ入学する前にスカウトされて芸能事務所に所属している。"},{"spoiler":false,"text":"ただし、それほど忙しく活動しているわけではなく、学園には普通に通っている。"},{"spoiler":false,"text":"父と弟との3人暮らしだが、父は病気のリハビリ中で現在は自宅療養をしている。"},{"spoiler":false,"text":"そのため、家事などは主に果純が行っている。"},{"spoiler":false,"text":"内気な性格で、あまり自分から声をかけられない。"},{"spoiler":false,"text":"押しに弱く、頼み事をされると断れないタイプ。"},{"spoiler":false,"text":"入学して間もない頃に、結乃たちが行っている演劇に参加する機会があり、それ以来結乃や郁美たちと仲良くなった。"},{"spoiler":false,"text":"家の経済面のため、芸能活動も頑張りたいと思っているが、恥ずかしがり屋でなかなか前向きになれずにいる。"}],"source":"egs","sourceCharacterId":"24592","sourceWorkId":"32484","spoiler":false},{"segments":[{"spoiler":false,"text":"私立美乃守学園・芸能科1年生。"},{"spoiler":false,"text":"美乃守学園へ入学する前にスカウトされて芸能事務所に所属している。"},{"spoiler":false,"text":"ただし、それほど忙しく活動しているわけではなく、学園には普通に通っている。"},{"spoiler":false,"text":"父と弟との3人暮らしだが、父は病気のリハビリ中で現在は自宅療養をしている。"},{"spoiler":false,"text":"そのため、家事などは主に果純が行っている。"},{"spoiler":false,"text":"内気な性格で、あまり自分から声をかけられない。"},{"spoiler":false,"text":"押しに弱く、頼み事をされると断れないタイプ。"},{"spoiler":false,"text":"入学して間もない頃に、結乃たちが行っている演劇に参加する機会があり、"},{"spoiler":false,"text":"それ以来結乃や郁美たちと仲良くなった。"},{"spoiler":false,"text":"家の経済面のため、芸能活動も頑張りたいと思っているが、"},{"spoiler":false,"text":"恥ずかしがり屋でなかなか前向きになれずにいる。"}],"source":"bangumi","sourceCharacterId":"110114"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a413a93001c4a6278e53fad8d04638e1bc9b9946a91b572043848b9075cf319a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45d138c9ca678c84ec80941d025f2c7b22be02c19832678965f25ac59db05cc9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水瀬ゆき","creatorId":"vndb:s14300","sourcePersonId":"vndb:s14300","canonicalEntityId":"vndb:s14300","name":"水瀬ゆき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:375909:110114:30883:1","source":"bangumi"}]},{"characterId":"char_c106852","characterName":"初瀬 未希","sourceIds":{"bangumi":[{"characterId":"110115","match":"exact-normalized-name-in-li