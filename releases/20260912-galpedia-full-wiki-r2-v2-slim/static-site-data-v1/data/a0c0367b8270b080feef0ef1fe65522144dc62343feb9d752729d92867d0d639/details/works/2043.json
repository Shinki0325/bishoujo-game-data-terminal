segments":[{"spoiler":false,"text":"The heroine from the first game. She was saved and taken away by Yuusuke before she was forced into an unwanted marriage to cover her father's debts."},{"spoiler":false,"text":"When asked, “What do you like about Yusuke? She is the kind of girl who simply replies, “Everything.\""},{"spoiler":false,"text":"She believes in Yusuke's hidden talent and is proud to be able to support him behind the scenes. She has the talent to brighten up a place just by being there."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c75512"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/4450cb355ad204604d149a62cac4c35d4f21ccae338362560fc4beb030fdbe71.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c88212e0e429fbb9c2c96ae68016c41cd1328c8d2882aab7a1fe7937e97260c5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡田 未央","creatorId":"vndb:s1167","sourcePersonId":"vndb:s1167","canonicalEntityId":"vndb:s1167","name":"岡田 未央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21291","source":"vndb"}]},{"characterId":"char_vndb_c75513","characterName":"三崎 温子","sourceIds":{"vndbCharacterId":"c75513"},"originalCharacterName":"三崎 温子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"As a child, she was sickly and weak, and promised to marry Yusuke on her sickbed."},{"spoiler":false,"text":"Since she no longer has a trace of the sickly look she once had, Yusuke does not realize that she is his childhood friend until she tells him. She is a manly and dynamic person who is not afraid to expose her skin in front of men because of her job. However, he is actually a bit clueless when it comes to the opposite sex."},{"spoiler":false,"text":"She is currently a budding gravure idol. She is the lead actress in a drama series for which Yuusuke is the assistant director."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c75513"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/376cacde0975cc036c08b2e18c491b9680d87e59dd2b7697ae6819d1e0cd0aed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a98ad9cd1700ffbae112b14c14c804ab8de8d0a6a89cf16de54df9359128fe41.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c75514","characterName":"藤宮 静馬","sourceIds":{"vndbCharacterId":"c75514"},"originalCharacterName":"藤宮 静馬","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Vice President of Fujinomiya Eiga Co. He is like an older brother to Yusuke."},{"spoiler":false,"text":"He discovered Yusuke's talent and encouraged him to join his own film company."},{"spoiler":false,"text":"He is a man worth relying on."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c75514"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c0ea00fceef0c33c00607687c97bcc3607d3d15d9f97a33bd030194ec888d93.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2d59eab9371b6f25ae8a9e60534d0cb40a85c86489aea79ad3c64828efa585b.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c75515","characterName":"七神 博士","sourceIds":{"vndbCharacterId"