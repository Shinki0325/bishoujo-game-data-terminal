me":"S.Murata","creatorId":"vndb:s9215","sourcePersonId":"vndb:s9215","canonicalEntityId":"vndb:s9215","name":"S.MURATA","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:120496","source":"vndb"}]},"cast":[{"characterId":"char_c33047","characterName":"姫野 星奏","sourceIds":{"bangumi":[{"characterId":"33215","match":"exact-normalized-name-in-linked-work","subjectId":"132528"}],"egsCharacterIds":["7029"],"vndbCharacterId":"c33047"},"originalCharacterName":"姫野 星奏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"612"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"hip":{"reviewState":"source-only","source":"vndb","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's childhood friend, who suddenly moved to another place a few years ago. She's secretly popular amongst the male students."},{"spoiler":true,"text":"Sena is that girl who Koutarou fell in love with and gave the letter to, only to have her transfer the next day and leave Koutarou unable to associate himself with anything regarding romance."}],"source":"vndb","sourceCharacterId":"c33047"},{"segments":[{"spoiler":false,"text":"人当たりはいいけどおとなしい。クラスの中ではあまり目立たない、けど、笑顔で周りを和ませる愛想も手伝ってか、ひそかに男子に人気がある。"},{"spoiler":false,"text":"洸太郎だけは彼女の笑顔をまっすぐ見られない。"},{"spoiler":false,"text":"転校が多く、幼少の頃、一時期御影ヶ丘町に住んでいたことがある。"},{"spoiler":false,"text":"父、母と三人暮らし。"}],"source":"egs","sourceCharacterId":"7029","sourceWorkId":"21993","spoiler":false},{"segments":[{"spoiler":false,"text":"总是在身边慢悠悠的她是软萌弱妹子"},{"spoiler":false,"text":"姫野 星奏 （ひめの せな）"},{"spoiler":false,"text":"班级：2-D（御影ヶ丘）　 所属：文艺部　　生日：6月12日　 血型：A型"},{"spoiler":false,"text":"胸：平均　　兴趣/特技：读书、制作点心"},{"spoiler":false,"text":"喜欢：读书、料理、粗点心　　讨厌：寒冷与酷热"},{"spoiler":false,"text":"亲切待人但是为人老实，在班里不太显眼的女孩子。"},{"spoiler":false,"text":"但是因为她的笑颜能让周围和谐融洽，暗地里很受男生的欢迎。"},{"spoiler":false,"text":"只有洸太郎不能直面她的笑容。"},{"spoiler":false,"text":"经常转校，小时候曾住在御影ヶ丘町一段时间。"},{"spoiler":false,"text":"「我回来呢，是为了再一次，倾听星星的声音」"}],"source":"bangumi","sourceCharacterId":"33215"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"33215","value":"読書、料理、駄菓子"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"33215","value":"寒いのと暑いの"},{"label":"学年","source":"bangumi","sourceCharacterId":"33215","value":"2-D（御影ヶ丘）"},{"label":"所属","source":"bangumi","sourceCharacterId":"33215","value":"文芸部"},{"label":"趣味・特技","source":"bangumi","sourceCharacterId":"33215","value":"読書、お菓子作り"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9deaeb0da92dc432b85b6ba670bda9cfb404e3f87a4f2cd744ea58dcc0763320.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a5efd19938c61deb1f8f3b87e5633ab04a62a961ed6f161faf7fe6422f3768d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:132528:33215:4809:1","source":"bangumi"}]},{"characterId":"char_c33048","characterName":"新堂 彩音","sourceIds":{"bangumi":[{"characterId":"33216","match":"exact-normalized-name-in-linked-work","subjectId":"132528"}],"egsCharacterIds":["7030"],"vndbCharacterId":"c33048"},"originalCharacterName":"新堂 彩音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"726"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's classmate from the middle school and his best friend who hadn’t talked to him since a certain incident."},{"spoiler":true,"text":"Ayane being the headstrong class rep, speaks out of her way during a class recital practice and gathers the contempt of her classmates. This is when Koutarou starts to sing very loudly to the surprise of everyone and then faints, and Ayane later learns that the reason why Koutarou seemed to be so passive was because he had a frail body. From this moment, Ayane’s viewpoint on the protagonist changes 180 degrees, to going heads-over-heels in love to the point she changes schools just to be with him."}],"source":"vndb","sourceCharacterId":"c33048"},{"segments":[{"spoiler":false,"text":"進学前は洸太郎と『友達以上恋人未満』とまわりからはからかわれるほど仲が良かった。"},{"spoiler":false,"text":"今はろくに口もきいてくれない。"},{"spoiler":false,"text":"何かに怒っているけど、その理由が洸太郎には分からない。"},{"spoiler":false,"text":"桜代の服飾科に通っていたはずが、学園の統合にともない普通科に編入してくる。"},{"spoiler":false,"text":"家族構成は、父、母、弟の三人暮らし。長女。"}],"source":"egs","sourceCharacterId":"7030","sourceWorkId":"21993","spoiler":false},{"segments":[{"spoiler":false,"text":"再び出会った膨れっ面の彼女は ツンデレぴゅあガール"},{"spoiler":false,"text":"進学前は洸太郎と “友達以上恋人未満” と周りからからかわれるほどに仲が良かった。"},{"spoiler":false,"text":"今はロクに口もきいてくれない。 何かに怒っているけど、その理由が洸太郎には分からない。"},{"spoiler":false,"text":"桜代の服飾科に通っていたはずが、学園の統合に伴い普通科に編入してくる。"},{"spoiler":false,"text":"「だからなに？　私がクラブに入ってるかどうかが、國見君に何の関係があるの？」"}],"source":"bangumi","sourceCharacterId":"33216"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"33216","value":"少女漫画、かわいいもの、甘いもの、料理、ネットでお買い物"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"33216","value":"苦いもの、運動、虫"},{"label":"学年","source":"bangumi","sourceCharacterId":"33216","value":"2-D（御影ヶ丘）"},{"label":"所属","source":"bangumi","sourceCharacterId":"33216","value":"文芸部（幽霊部員）"},{"label":"趣味・特技","source":"bangumi","sourceCharacterId":"33216","value":"雑貨集め、不味い料理を作る"},{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"7030","sourceWorkId":"21993","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"7030","sourceWorkId":"21993","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"7030","sourceWorkId":"21993","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"7030","sourceWorkId":"21993","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/ddb2ef61914a70c08032c5eba09d3aa362c2eb817ca4ff3cc4c09b7a80721744.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb0914ce94975b31ef7afb75d8f6356eabc95bcbeffd26f37699733be5bc82ba.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"仙台エリ","creatorId":"vndb:s195","sourcePersonId":"vndb:s195","canonicalEntityId":"vndb:s195","name":"仙台 エリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:132528:33216:4749:1","source":"bangumi"}]},{"characterId":"char_c33049","characterName":"小鞠 ゆい","sourceIds":{"bangumi":[{"characterId":"33217","match":"exact-normalized-name-in-linked-work","subjectId":"132528"}],"egsCharacterIds":["7031"],"vndbCharacterId":"c33049"},"originalCharacterName":"小鞠 ゆい","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"222"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl, who the protagonist first sees talking to the tulips planted outside the old school facilities. Yui actually doesn’t attend this school but still comes to tend to the flowers every day."}],"source":"vndb","sourceCharacterId":"c33049"},{"segments":[{"spoiler":false,"text":"海の近くにある御影浜学園に在籍する少女。"},{"spoiler":false,"text":"とある事がきっかけで洸太郎の事が好きになり、不器用なアプローチを繰り返す。"},{"spoiler":false,"text":"けどマイペースな洸太郎は気にしない。菜子と仲良くしてくれよと頭をなでている。そしてさらいゆいは暴走する。"},{"spoiler":false,"text":"家族構成は、姉と犬、だけ（？）"}],"source":"egs","sourceCharacterId":"7031","sourceWorkId":"21993","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が好きでたまらない彼女は ロリっ子ゆるふわ少女"},{"spoiler":false,"text":"海の近くにある御影浜学園に在籍する少女。"},{"spoiler":false,"text":"とある事がきっかけで洸太郎のことが好きになり、不器用なアプローチを繰り返している。"},{"spoiler":false,"text":"しかしマイペースな洸太郎は気にしない。 妹の菜子と仲良くしてくれよと頭を撫でている。"},{"spoiler":false,"text":"そしてさらに ゆいは暴走する。"},{"spoiler":false,"text":"「ふたりの愛を邪魔する者は消されてもういないということ……むぐっ！」"}],"source":"bangumi","sourceCharacterId":"33217"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"33217","value":"主人公、絵本、静かな場所、花、小動物（うさぎさん、ねこさん）"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"33217","value":"知らない人"},{"label":"学年","source":"bangumi","sourceCharacterId":"33217","value":"3-A（御影浜）"},{"label":"所属","source":"bangumi","sourceCharacterId":"33217","value":"栽培クラブ"},{"label":"趣味・特技","source":"bangumi","sourceCharacterId":"33217","value":"絵を描く、主人公を観察する、耳がいい、鼻が利く"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83bef477f77ef72605f111aa692af02d359d130a7aee3c485c9a75ed3737446a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1df031590cee94cd502f60c4bd2daf825148c8abada5d94126