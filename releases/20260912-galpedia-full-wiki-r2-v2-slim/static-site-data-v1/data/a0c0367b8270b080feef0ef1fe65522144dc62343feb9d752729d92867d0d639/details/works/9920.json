canonicalEntityId":"vndb:s17847","name":"小梅","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:15249","source":"vndb"}]},"cast":[{"characterId":"char_c15166","characterName":"雲呑 深空","sourceIds":{"bangumi":[{"characterId":"44642","match":"exact-normalized-name-in-linked-work","subjectId":"12767"}],"egsCharacterIds":["15477"],"vndbCharacterId":"c15166"},"originalCharacterName":"雲呑 深空","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"41"}},"descriptions":[{"segments":[{"spoiler":false,"text":"――絵本作家を夢見る、ほんわか笑顔な女の子"},{"spoiler":false,"text":"いつもフエルトペンを持ち歩く、柔らかい笑顔がチャームポイントの二年生。"},{"spoiler":false,"text":"成績優秀、容姿端麗、独創性もあり運動もそこそこ、更には嫌味のない性格と、男女問わず人気者になりそうなタイプだが、なぜか、人と一定の距離を保っているため、親しい友人はいない。"},{"spoiler":false,"text":"健気で真っ直ぐな反面、ちょっぴり頑固に見える面も。"},{"spoiler":false,"text":"場を和ませるほんわか少女だが、実はメンタル面が非常に打たれ弱いようで……。"},{"spoiler":false,"text":"「空を飛ぶなんて、素敵だと思いますっ」"}],"source":"egs","sourceCharacterId":"15477","sourceWorkId":"9920","spoiler":false},{"segments":[{"spoiler":false,"text":"【絵本作家を夢見る、ほんわか笑顔な女の子】"},{"spoiler":false,"text":"瑞鳳学園の２年生。"},{"spoiler":false,"text":"世界で唯一、その身一つで空を飛んだ事のあるスーパーロマンチスト。"},{"spoiler":false,"text":"絵は少し下手になってしまったが、めげる事無く絵本作家を目指している。"},{"spoiler":false,"text":"突如現れた謎の少女“花梨”をついつい保護者のように世話を焼いてしまい、可愛い妹のように思っている。"},{"spoiler":false,"text":"「私もロマンチックな魔法、使ってみたいですっ」"}],"source":"egs","sourceCharacterId":"15477","sourceWorkId":"12312","spoiler":false},{"segments":[{"spoiler":false,"text":"瑞鳳学園の2年生。"},{"spoiler":false,"text":"いつもフエルトペンを持ち歩く、ほんわか笑顔がチャームポイントのメインヒロイン。"},{"spoiler":false,"text":"明るく健気で真っ直ぐな性格な反面、ピュアすぎてちょっと頑固に思えるような一面もある。成績優秀な上に美少女で、独創性もあり運動もそこそこと非の打ち所が無い上に嫌味が無いので、男女問わずに人気者になれる素質はあるのだが、なぜか他人とは常に一定の距離を保っているため、仲の良い友人はいない。"},{"spoiler":false,"text":"いつも場を和ませてくれるほんわか少女だがメンタル面は非情に打たれ弱く、守ってあげたいと思わせる脆さも併せ持っている、か弱い少女。"},{"spoiler":false,"text":"「空を飛ぶなんて、素敵だと思いますっ」"}],"source":"bangumi","sourceCharacterId":"44642"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb52f5ade3510f7d52cfcfd6ac414147ab5b45bcadbd511654f217f4b5d67675.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d3d79de80d2eb1f5e02f852ec16461ba93daff487a0c66b28b20785a1cdf603.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南條愛乃","creatorId":"vndb:s62","sourcePersonId":"vndb:s62","canonicalEntityId":"vndb:s62","name":"南條愛乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12767:44642:4792:1","source":"bangumi"}]},{"characterId":"char_c15167","characterName":"鳥井 かりん","sourceIds":{"bangumi":[{"characterId":"44643","match":"exact-normalized-name-in-linked-work","subjectId":"12767"}],"egsCharacterIds":["19209"],"vndbCharacterId":"c15167"},"originalCharacterName":"鳥井 かりん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"――天然ボケへっぽこメガネ娘（ミステリアス仕様）"},{"spoiler":false,"text":"空を飛ぶために学園を占拠した謎の少女。"},{"spoiler":false,"text":"素性を明かさないミステリアスな雰囲気……など、全く持っていない天然ボケでへっぽこな巨乳メガネっ娘である。"},{"spoiler":false,"text":"現在は、アニメで意気投合した深空宅に転がり込んで、居候を決め込んでいる。"},{"spoiler":false,"text":"何故か翔の家の合鍵を所持しており、毎朝起こしに来たりする世話好き（？）な一面も。"},{"spoiler":false,"text":"「あぅ。メガネは、私のあいでんてぃてぃーなんです」"}],"source":"egs","sourceCharacterId":"19209","sourceWorkId":"9920","spoiler":false},{"segments":[{"spoiler":false,"text":"空を飛ぶために突如学園を占拠した、素性を明かさぬ謎の少女。"},{"spoiler":false,"text":"しかしあまりにも天然でヘッポコなため、全然ミステリアスっぽくない。"},{"spoiler":false,"text":"アニメ『名探偵コバンくん』好きで意気投合したのをいい事に深空の家へ転がり込んで居候として生活しているらしく、住所までも不明。"},{"spoiler":false,"text":"なぜか翔の家の合鍵を持っており、毎朝起こしに来たりする世話焼き娘な妹的一面も持ち合わせている。"},{"spoiler":false,"text":"「あぅ。メガネは、私のあいでんてぃてぃーなんです」"}],"source":"bangumi","sourceCharacterId":"44643"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c89e0b4148d76f5e8072d75710cfdce9cad406fd53df3c1b215d31a2746ccdd5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c98707e75818115add73b4c7e266e4df26aa04e2eac220a7a575f987817df5b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"椎名るぅ","creatorId":"vndb:s571","sourcePersonId":"vndb:s571","canonicalEntityId":"vndb:s571","name":"椎名 るぅ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12767:44643:56631:1","source":"bangumi"}]},{"characterId":"char_c15168","characterName":"嵩立 静香","sourceIds":{"bangumi":[{"characterId":"44644","match":"exact-normalized-name-in-linked-work","subjectId":"12767"},{"characterId":"44644","match":"exact-normalized-name-in-linked-work","subjectId":"16377"}],"egsCharacterIds":["15479"],"vndbCharacterId":"c15168"},"originalCharacterName":"嵩立 静香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"73"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"――素直になれない、幼馴染の女の子"},{"spoiler":false,"text":"翔のクラスメイトで、幼い頃から付き合いのある幼馴染。"},{"spoiler":false,"text":"メンバーの中で一番の常識人であるため、ツッコミ担当に回ることが多い。"},{"spoiler":false,"text":"どう見ても翔に気があるのだが、翔が鈍感＋素直になれない性格なため、トゲトゲしている風に見られがちだが、根は優しくて可愛らしい乙女。"},{"spoiler":false,"text":"今日も今日とて、翔に対してヤキモチを焼いて、"},{"spoiler":false,"text":"クールなツンデレっぷりを存分に披露している。「私が翔の事を嫌ったことなんて……一度たりとも無いわよ」"}],"source":"egs","sourceCharacterId":"15479","sourceWorkId":"9920","spoiler":false},{"segments":[{"spoiler":false,"text":"【相も変わらず素直になれない、恋する幼馴染の女の子】"},{"spoiler":false,"text":"瑞鳳学園の２年生。"},{"spoiler":false,"text":"翔とは幼少の頃からの付き合いで、クラスメイトでもある少女。"},{"spoiler":false,"text":"一番の良識人ゆえに、メンバーの中でツッコミに回ることが多くなってしまう、ツッコミ担当。"},{"spoiler":false,"text":"翔のことが大好きなのだが素直になれないため、もどかしい想いをしながら日々を過ごしている。"},{"spoiler":false,"text":"なお、未だに大きくならない自分の胸にコンプレックスを持っている。"},{"spoiler":false,"text":"「んもぅ、カバさんをそんなのと一緒にしないでよねっ！」"}],"source":"egs","sourceCharacterId":"15479","sourceWorkId":"12312","spoiler":false},{"segments":[{"spoiler":false,"text":"瑞鳳学園の2年生。"},{"spoiler":false,"text":"翔とは幼少の頃からの付き合いで、クラスメイトでもある少女。"},{"spoiler":false,"text":"一番の良識人ゆえに、メンバーの中でツッコミに回ることが多くなってしまう、ツッコミ担当。"},{"spoiler":false,"text":"どう見ても翔に気があるのだが、本人が鈍感ゆえにもどかしい思いをしている。"},{"spoiler":false,"text":"また、素直になれない性格が災いしてトゲトゲしているように見られる事が多いが、根は優しくてお人よしで、可愛らしい女の子な性格をしている。"},{"spoiler":false,"text":"ヤキモチ焼きな上に素直になれないため、花蓮とは違う形のクールなツンデレぶりを披露してくれる少女。"},{"spoiler":false,"text":"「私が翔の事を嫌ったことなんて……"},{"spoiler":false,"text":"一度たりとも無いわよ」"}],"source":"bangumi","sourceCharacterId":"44644"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63d4f8406777f0a9d20d3001a4d0255e662c8590f183272e5b318db84d7cbf4a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/538b880d2816c57601fda007e6fcf6a23c58b5d1dfa78499adc0ba01c02190f2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ミルノ純","creatorId":"vndb:s564","sourcePersonId":"vndb:s564","canonicalEntityId":"vndb:s564","name":"ミルノ 純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12767:44644:6167:1","source":"bangumi"}]},{"characterId":"char_c15169","characterName":"鈴白 灯","sourceIds":{"bangumi":[{"characterId":"44645","match":"exact-normalized-name-in-linked-work","subjectId":"12767"},{"characterId":"44645","match":"exact-normalized-name-in-linked-work","subjectId":"16377"}],"egsCharacterIds":["15481"],"vndbCharacterId":"c15169"},"originalCharacterName":"鈴白 灯","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"50"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"――その佇まいは、優雅で可憐。頼りになる、ちょっとお茶目な先輩"},{"spoiler":false,"text":"翔たちの先輩で、学園の三年生。"},{"spoiler":false,"text":"数年前に、事故で失明した先輩だが、「絶対空間把握能力」というレア能力のおかげで、生活の不自由はない。"},{"spoiler":false,"text":"なので、彼女が持つ白杖は主にお仕置き用の攻撃道具であり、更には、数多の修羅場を乗り切ってきた者が持つ独特の威圧感で、人類の上位種を自称する“トリ太”すらも一目置いている。"},{"spoiler":false,"text":"「ぶぅ。私だって、か弱い女の子なんですからねっ」"}],"source":"egs","sourceCharacterId":"15481","sourceWorkId":"9920","spoiler":false},{"segments":[{"spoiler":false,"text":"【その佇まいは、優雅で可憐。お茶目でいじっぱりな先輩】"},{"spoiler":false,"text":"瑞鳳学園の３年生。"},{"spoiler":false,"text":"数年前の事故で光を失うも、絶対空間把握能力と言う稀有な能力により、普通に生活をこなしている先輩。"},{"spoiler":false,"text":"最近は手術を受けるためにバイトを始めたため、茶道部の部長ながらも部活動はそこそこに控えているらしい。"},{"spoiler":false,"text":"日本の伝統とお茶をこよなく愛す。"},{"spoiler":false,"text":"彼女の持っている白杖は主におしおき用の攻撃に使用され、様々な武器に変化する。"},{"spoiler":false,"text":"「ぶぅ。天野くん、私が先輩だってこと、忘れてませんか？」"}],"source":"egs","sourceCharacterId":"15481","sourceWorkId":"12312","spoiler":false},{"segments":[{"spoiler":false,"text":"瑞鳳学園の3年生。"},{"spoiler":false,"text":"数年前の事故で光を失うも、絶対空間把握能力と言う稀有な能力により、普通に生活をこなしている先輩。"},{"spoiler":false,"text":"日本の伝統とお茶をこよなく愛し、彼女の持っている白杖は主におしおき用の攻撃に使用され、様々な武器に変化する。"},{"spoiler":false,"text":"多くの修羅場を乗り切ってきたゆえに持つ独特の威厳は、人類の上位種であるトリ太すら一目置くほどの人物である。"},{"spoiler":false,"text":"「ぶぅ。私だって、か弱い女の子なんですからねっ」"}],"source":"bangumi","sourceCharacterId":"44645"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a68440bc5a9ceffc11430fc395b9c20d1dc3ff4fd6d11728883a09093bf5300a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59eadffce55afa908beaa44ae153777f3ee1395b78199b9b1f504b866162d630.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春夏ひとみ","creatorId":"vndb:s569","sourcePersonId":"vndb:s569","canonicalEntityId":"vndb:s569","name":"春夏 ひとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12767:44645:10650:1","source":"bangumi"}]},{"characterId":"char_c15170","characterName":"姫野王寺 花蓮","sourceIds":{"bangumi":[{"characterId":"44648","match":"exact-normalized-name-in-linked-work","subjectId":"12767"},{"characterId":"44648","match":"exact-normalized-name-in-linked-work","subjectId":"16377"}],"egsCharacterIds":["15482"],"vndbCharacterId":"c15170"},"originalCharacterName":"姫野王寺 花蓮","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"―お姫様のような貧乏学生（？）の後輩"},{"spoiler":false,"text":"高級日傘にプラチナ扇子、純金英和辞典、専用の執事まで持つ一年生。"},{"spoiler":false,"text":"端からみれば、良いところのお嬢様なのだが、経済状況は厳しいらしく、コッペパンで日々の極貧生活を食いつなぐ。"},{"spoiler":false,"text":"プライドが高くお調子者だが、基本的にはいい子。"},{"spoiler":false,"text":"……なのだが、出会いの印象から翔には威嚇するようにツンツンお澄まし。"},{"spoiler":false,"text":"いわゆるひとつの「ツンデレ」少女。"},{"spoiler":false,"text":"「――これは、私のプライドの問題ですの。『例え貧しくとも心は常に高貴に』ですわ」"}],"source":"egs","sourceCharacterId":"15482","sourceWorkId":"9920","spoiler":false},{"segments":[{"spoiler":false,"text":"【おバカでお嬢様でお貧乏な後輩の女の子】"},{"spoiler":false,"text":"瑞鳳学園の１年生。"},{"spoiler":false,"text":"高級日傘とプラチナの扇子、純金英和辞典と言う三種の神器と専用の執事まで併せ持つ、お嬢様な女の子。"},{"spoiler":false,"text":"しかしながら多くの援助を受けない一人暮らしをしているため、その経済状況はかなり厳しいらしく、コッペパンで食いつなぐ極貧生活をしながら過ごしている。"},{"spoiler":false,"text":"基本的に良い子なのだが、おバカな上にプライドが高く、お調子者。"},{"spoiler":false,"text":"「わ、私のことも、ちゃんと女の子として見て欲しいですわ」"}],"source":"egs","sourceCharacterId":"15482","sourceWorkId":"12312","spoiler":false},{"segments":[{"spoiler":false,"text":"瑞鳳学園の1年生。"},{"spoiler":false,"text":"高級日傘とプラチナの扇子、純金英和辞典と言う三種の神器と専用の執事まで併せ持つ女の子。"},{"spoiler":false,"text":"どう見てもお嬢様なのだが、その経済状況はかなり厳しいらしく、コッペパンで食いつなぐ極貧生活をして過ごしていると言う、変な少女。"},{"spoiler":false,"text":"基本的に良い子なのだが、妙にプライドが高くお調子者で、出逢いの印象から翔相手の時には威嚇するようにツンツンしている。いわゆる一つのツンデレ少女。"},{"spoiler":false,"text":"「―――これは、私のプライドの問題ですの。『例え貧しくとも心は常に高貴に』ですわ」"}],"source":"bangumi","sourceCharacterId":"44648"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba400c7e5cc40d176fce9dad7