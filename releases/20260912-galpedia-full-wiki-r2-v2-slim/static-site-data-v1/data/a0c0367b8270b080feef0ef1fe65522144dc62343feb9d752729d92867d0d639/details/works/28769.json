":"vndb:s217","name":"和泉 万夜","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:160667","source":"vndb"},{"creditedName":"和泉 万夜","creatorId":"vndb:s217","sourcePersonId":"vndb:s217","canonicalEntityId":"vndb:s217","name":"和泉 万夜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:160668","source":"vndb"},{"creditedName":"上田 メタヲ","creatorId":"vndb:s238","sourcePersonId":"vndb:s238","canonicalEntityId":"vndb:s238","name":"上田 メタヲ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:160669","source":"vndb"},{"creditedName":"上田 メタヲ","creatorId":"vndb:s238","sourcePersonId":"vndb:s238","canonicalEntityId":"vndb:s238","name":"上田 メタヲ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:160671","source":"vndb"},{"creditedName":"上田 メタヲ","creatorId":"vndb:s238","sourcePersonId":"vndb:s238","canonicalEntityId":"vndb:s238","name":"上田 メタヲ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:160672","source":"vndb"},{"creditedName":"株式会社キューブ","creatorId":"vndb:s2651","sourcePersonId":"vndb:s2651","canonicalEntityId":"vndb:s2651","name":"株式会社キューブ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:160673","source":"vndb"},{"creditedName":"Naynit Kcalbwen Studio","creatorId":"vndb:s7472","sourcePersonId":"vndb:s7472","canonicalEntityId":"vndb:s7472","name":"たいにゃん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:160674","source":"vndb"},{"creditedName":"中む～","creatorId":"vndb:s11349","sourcePersonId":"vndb:s11349","canonicalEntityId":"vndb:s11349","name":"人外 中村","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:160676","source":"vndb"}]},"cast":[{"characterId":"char_c87335","characterName":"七瀬 静羽","sourceIds":{"bangumi":[{"characterId":"72164","match":"exact-normalized-name-in-linked-work","subjectId":"292518"}],"egsCharacterIds":["21790"],"vndbCharacterId":"c87335"},"originalCharacterName":"七瀬 静羽","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nanase Shizuha is a vampire traveling across Japan together with Yuna. Bashful, passive, and meek, Shizuha only wishes to live in peace and obscurity, away from those who would hunt her kind."},{"spoiler":false,"text":"Despite her timidness, she digs in her heels and always refuses to consume human blood, even though it means weakening herself to the point of putting her and Yuna at a disadvantage to their pursuers. The only person she allows herself to feed on is Yuna, as she considers the act a confirmation of their bond. Her affection for Yuna makes Shizuha extremely dependent on her, a fact that Yuna finds both endearing and bothersome."},{"spoiler":false,"text":"\"...Don’t you think sometimes that you’d be better off being human? You wouldn't be running for your life right now if you weren’t a vampire...\""},{"spoiler":false,"text":"From JAST USA"}],"source":"vndb","sourceCharacterId":"c87335"},{"segments":[{"spoiler":false,"text":"日本の各地を旅する吸血鬼。"},{"spoiler":false,"text":"気弱で消極的な性格をしており、人間を吸血することを好まない。"},{"spoiler":false,"text":"戦うことも嫌いでハンターに見つかっても毎回逃げているが、追い詰められても戦闘は由奈に任せる場合が多い。"},{"spoiler":false,"text":"満月の夜は吸血衝動が高まるため、由奈に抱いてもらってその衝動を抑えている。"}],"source":"egs","sourceCharacterId":"21790","sourceWorkId":"28769","spoiler":false},{"segments":[{"spoiler":false,"text":"日本の各地を旅する吸血鬼。"},{"spoiler":false,"text":"気弱で消極的な性格をしており、人間を吸血することを好まない。"},{"spoiler":false,"text":"戦うことも嫌いでハンターに見つかっても毎回逃げているが、追い詰められても戦闘は由奈に任せる場合が多い。"},{"spoiler":false,"text":"満月の夜は吸血衝動が高まるため、由奈に抱いてもらってその衝動を抑えている。"}],"source":"bangumi","sourceCharacterId":"72164"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef688b4c953933a3648f3284a4464db03cf08a73cc439c1b2c64d1f01cb6a6b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afccdd5b33a3bee65a5e03b58b81391b94474f8b2f095f604fa904e963b0d76b.webp","width":92,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桐村まり","creatorId":"vndb:s1549","sourcePersonId":"vndb:s1549","canonicalEntityId":"vndb:s1549","name":"桐村 まり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:292518:72164:23768:1","source":"bangumi"}]},{"characterId":"char_c87646","characterName":"園原 由奈","sourceIds":{"bangumi":[{"characterId":"72162","match":"exact-normalized-name-in-linked-work","subjectId":"292518"}],"egsCharacterIds":["21789"],"vndbCharacterId":"c87646"},"originalCharacterName":"園原 由奈","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shinohara Yuna is a vampire traveling across Japan together with Shizuha. Haughty, calculating, and sinister, she seeks to make the most of her eternal life by reveling in her vampiric nature."},{"spoiler":false,"text":"She sees humans as mere pawns, never hesitating to suck their blood and bend them to her will if she believes it will suit her ends. The only person she truly seems to hold dear is Shizuha, with whom she shares an intimate relationship. She does, however, find Shizuha's passive nature and adamant refusal to drink human blood to be bothersome."},{"spoiler":false,"text":"\"You should be a little more dignified about this. We're vampires, dear. We're not like those ordinary humans. We're a stronger, ageless, more elegant existence.\""},{"spoiler":false,"text":"From JAST USA"}],"source":"vndb","sourceCharacterId":"c87646"},{"segments":[{"spoiler":false,"text":"日本の各地を旅する吸血鬼。"},{"spoiler":false,"text":"高圧的な性格で、人間のことは都合の良い駒としか見ておらず、吸血して眷属化することに躊躇いはない。"},{"spoiler":false,"text":"しかし、ハンターに目を付けられるような行動は慎んでいるため、必要な場合にしか吸血行為は行っていない。"},{"spoiler":false,"text":"静羽とは一年ほど一緒に旅を続けており、彼女だけは特別な存在となっている。"}],"source":"egs","sourceCharacterId":"21789","sourceWorkId":"28769","spoiler":false},{"segments":[{"spoiler":false,"text":"日本の各地を旅する吸血鬼。"},{"spoiler":false,"text":"高圧的な性格で、人間のことは都合の良い駒としか見ておらず、吸血して眷属化することに躊躇いはない。"},{"spoiler":false,"text":"しかし、ハンターに目を付けられるような行動は慎んでいるため、必要な場合にしか吸血行為は行っていない。"},{"spoiler":false,"text":"静羽とは一年ほど一緒に旅を続けており、彼女だけは特別な存在となっている。"}],"source":"bangumi","sourceCharacterId":"72162"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39b23b11245e338cd30e791b100e12afb066a4fbc5438398be7b843d7f772f9d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e821c257497ddb30e54ed2def8fa076bd44f60d6239bd6fc6abee3bd87980312.webp","width":138,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤沢れい香","creatorId":"vndb:s14338","sourcePersonId":"vndb:s14338","canonicalEntityId":"vndb:s14338","name":"藤沢 れい香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:292518:72162:32998:1","source":"bangumi"}]},{"characterId":"char_c87647","characterName":"榊 優衣架","sourceIds":{"bangumi":[{"characterId":"72165","match":"exact-normalized-name-in-linked-work","subjectId":"292518"}],"egsCharacterIds":["21791"],"vndbCharacterId":"c87647"},"originalCharacterName":"榊 優衣架","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sakaki Yuika is a vampire hunter affiliated with the Hunters' Association."},{"spoiler":false,"text":"While she is quiet and taciturn on the outside, her heart burns with hatred toward all vampires. Trained to do battle with creatures far stronger than she is and armed to the teeth, Yuika is ruthless in combat. Her signature weapon is a powerful pile bunker that can easily extinguish a vampire’s life with lethal efficiency. She commands a unit of three biological weapons developed to assist in hunting vampires. While Yuika remains loyal to the Association and will put its orders above her personal goals if need be, the same cannot be said for her subordinates. Keeping them in line is a constant source of concern for her."},{"spoiler":false,"text":"\"I will exterminate... every single vampire...\""},{"spoiler":false,"text":"From JAST USA"}],"source":"vndb","sourceCharacterId":"c87647"},{"segments":[{"spoiler":false,"text":"ハンター協会に所属するハンターの一人。"},{"spoiler":false,"text":"対吸血鬼専用兵器・パイルバンカーを使って、これまでに何体もの吸血鬼を屠ってきた。"},{"spoiler":false,"text":"過去、家族を吸血鬼に殺害されており、その憎悪が原動力。"},{"spoiler":false,"text":"現在は三人の部下を連れて各地を回りながら、吸血鬼狩りの日々を送っている。"}],"source":"egs","sourceCharacterId":"21791","sourceWorkId":"28769","spoiler":false},{"segments":[{"spoiler":false,"text":"ハンター協会に所属するハンターの一人。"},{"spoiler":false,"text":"対吸血鬼専用兵器・パイルバンカーを使って、これまでに何体もの吸血鬼を屠ってきた。"},{"spoiler":false,"text":"過去、家族を吸血鬼に殺害されており、その憎悪が原動力。"},{"spoiler":false,"text":"現在は三人の部下を連れて各地を回りながら、吸血鬼狩りの日々を送っている。"}],"source":"bangumi","sourceCharacterId":"72165"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b78551b03b9f03e6a3fc3c08d2954950a6874cb947a7dc625159949df7f461a9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da3a36806dad813a80040446a337f12e49ee29b39efb22b6de040b86a6afd62b.webp","width":95,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽真ちい","creatorId":"vndb:s14495","sourcePersonId":"vndb: