{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"26673","model":{"presentationWorkId":"vndb:v23519","staff":{"artwork":[{"creditedName":"スミスミ","creatorId":"vndb:s7028","sourcePersonId":"egs:creator:50","canonicalEntityId":"vndb:s7028","name":"スミスミ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:197882","source":"egs"}],"scenario":[{"creditedName":"ADU(あづ)","creatorId":"vndb:s8735","sourcePersonId":"egs:creator:25838","canonicalEntityId":"vndb:s8735","name":"ADU(あづ)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:197881","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c57121","characterName":"天野 奈々子","sourceIds":{"bangumi":[{"characterId":"153020","match":"exact-normalized-name-in-linked-work","subjectId":"396994"}],"egsCharacterIds":["8132"],"vndbCharacterId":"c57121"},"originalCharacterName":"天野 奈々子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明るく心優しく純真な、普通の女の子。"},{"spoiler":false,"text":"元は想聖天使に憧れる一般人にすぎなかったが、EMアームズの適合者として見出され自身もクロスエモーションとなる。"},{"spoiler":false,"text":"何事も前向きに考え、自分にできる事が有れば一生懸命に取り組む。"},{"spoiler":false,"text":"人を疑う事を知らず、少し子供っぽい所もある。"},{"spoiler":false,"text":"まだ未熟な所もあるが、その純心はEMアームズと抜群の適合率を誇り、人々の「想い」をまっすぐに受け止める事も出来る。"}],"source":"egs","sourceCharacterId":"8132","sourceWorkId":"22994","spoiler":false},{"segments":[{"spoiler":false,"text":"明るく心優しく純真な、普通の女の子。"},{"spoiler":false,"text":"元は想聖天使に憧れる一般人にすぎなかったが、EMアームズの適合者として見出され自身もクロスエモーションとなる。"},{"spoiler":false,"text":"何事も前向きに考え、自分にできることがあれば一生懸命に取り組む。"},{"spoiler":false,"text":"人を疑う事を知らず、少し子供っぽいところもある。"},{"spoiler":false,"text":"まだ未熟なところもあるが、その純心はEMアームズと抜群の適合率を誇り、人々の「想い」をまっすぐに受け止めることが出来る。"}],"source":"bangumi","sourceCharacterId":"153020"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8bf2aeaa42baffbd1b2ba285f3f92a3daa14888e31fc1e8beddafcc16fe245c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/633db18d292279bc178284080c3c3282b84bd3e8ca634d34a9cbb81b2f7c160d.webp","width":180,"height":250,"source":"static-detail"},"actors":[{"creditedName":"水瀬 沙季","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:78373","source":"vndb"}]},{"characterId":"char_c57123","characterName":"四封堂 葵","sourceIds":{"bangumi":[{"characterId":"153021","match":"exact-normalized-name-in-linked-work","subjectId":"396994"}],"egsCharacterIds":["8133"],"vndbCharacterId":"c57123"},"originalCharacterName":"四封堂 葵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"EMアームズ適合者第一号。四封堂家は古より人ならざる者から衆生を守って来た退魔の家系であり、"},{"spoiler":false,"text":"クロスエモーションをバックアップする対イド機関「エスペラント」の前身でもある。"},{"spoiler":false,"text":"プライドが高くきまじめな性格で、四封堂家の一員として、強い責任感と使命感を抱いている。"},{"spoiler":false,"text":"世界最初の想聖天使としてイドムと戦い続けており、その凜々しい立ち居振る舞いから人々の信頼や尊敬は厚い"}],"source":"egs","sourceCharacterId":"8133","sourceWorkId":"22994","spoiler":false},{"segments":[{"spoiler":false,"text":"今作のメインヒロイン。"},{"spoiler":false,"text":"本編ではサブヒロインだった為に戦闘時に使用する事が出来なかった。"},{"spoiler":false,"text":"すでに開始時からクロスエモーションとして活躍していたヒロイン、それゆえに広く周知されている。"},{"spoiler":false,"text":"プライド高く孤高な性格。"},{"spoiler":false,"text":"責任感がとても強く、それゆえに自他ともに厳しい。"},{"spoiler":false,"text":"口下手で口数が少なく、あまり何を考えているかわからない。"},{"spoiler":false,"text":"日本の霊的守護を担う四封堂家の令嬢。"},{"spoiler":false,"text":"四封堂家は対イド機関「エスペランサ」の前身でもあり、彼女はそれゆえの重責を背負っている。"},{"spoiler":false,"text":"自他ともに厳しく接するタイプで、メインヒロインに対しても最初は厳しくあたる（別に性格が悪いわけではなく、責任感が強すぎるという感じ）。"},{"spoiler":false,"text":"厳しく芯が強い性格で、出自からもパワーストーンとの適応力が高く練度も高い。"},{"spoiler":false,"text":"EMアームズを使いこなすが、人々からのエモーションをあまり素直に受け止めることが出来ず、戦士としての伸び代が少ない。"},{"spoiler":false,"text":"また人前で媚を売るのを恥と考えており、あまりプロモートやファンサービスをしないので人々からの受けが悪い（もちろん見た目も良いし、そういったキャラが好きなファンも多いので支持はあるが）。"},{"spoiler":false,"text":"本編ではその任務の重圧から孤立し、敗北した事で敵に洗脳され「悪堕ち」してしまった。"}],"source":"bangumi","sourceCharacterId":"153021"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a49a24a9af42f8a9981c33860e27709eb55641c1b65d41504da8c20e32102d37.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/6928313991d9db9ade6fa150c0a2f954e841e046416c644c9279d2f865bdfc42.webp","width":180,"height":250,"source":"static-detail"},"actors":[{"creditedName":"藤堂 みさき","creatorId":"vndb:s1030","sourcePersonId":"vndb:s1030","canonicalEntityId":"vndb:s1030","name":"柏木 美優","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:78374","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p1050","sourceCompanyId":"egs:brand:443","canonicalEntityId":"vndb:p1050","name":"TOUCHABLE","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:26673:443","source":"egs"},{"companyId":"vndb:p1050","sourceCompanyId":"vndb:p1050","canonicalEntityId":"vndb:p1050","name":"TOUCHABLE","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:66022:v23519","source":"vndb"},{"companyId":"vndb:p1050","sourceCompanyId":"vndb:p1050","canonicalEntityId":"vndb:p1050","name":"TOUCHABLE","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:69584:v23519","source":"vndb"}],"missingStates":["current-runtime-cover-u