{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"19761","model":{"presentationWorkId":"vndb:v7000","staff":{"artwork":[{"creditedName":"日高 じおんぐ","creatorId":"vndb:s6771","sourcePersonId":"vndb:s6771","canonicalEntityId":"vndb:s6771","name":"日高 じおんぐ","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:68260","source":"vndb"}],"scenario":[{"creditedName":"Dr.ぼんべ","creatorId":"vndb:s6769","sourcePersonId":"vndb:s6769","canonicalEntityId":"vndb:s6769","name":"Dr.ぼんべ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:68259","source":"vndb"}],"music":[],"other":[]},"cast":[{"characterId":"char_c40041","characterName":"秋山 乃亜","sourceIds":{"bangumi":[{"characterId":"40809","match":"exact-normalized-name-in-linked-work","subjectId":"43352"}],"egsCharacterIds":["17019"],"vndbCharacterId":"c40041"},"originalCharacterName":"秋山 乃亜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who lives at a facility because she lost her parents in an accident at a young age. She gets along well with a certain boy living in the same facility as her, and treated him like a brother when they were younger. However, growing up, she has started holding feelings for him."},{"spoiler":false,"text":"After he gets into an accident, Noa decides to accept this special blood type into her body... only to find out that it triggers explosive, as in very big and sudden, body transformations and remodels her body completely. In order to save her beloved, she is forced to succumb to the mad scientist's different experiments she will have to go through."}],"source":"vndb","sourceCharacterId":"c40041"},{"segments":[{"spoiler":false,"text":"施設で暮らす少女。"},{"spoiler":false,"text":"幼い頃に両親とともに事故に遭う。"},{"spoiler":false,"text":"自分は瀕死の重症を被いながらも命は助かったが、"},{"spoiler":false,"text":"両親は亡くなってしまっている。"},{"spoiler":false,"text":"同じ施設で育った年下の青年と仲がよく、兄弟のように振舞っているが、"},{"spoiler":false,"text":"成長し一人の少女となった今では、"},{"spoiler":false,"text":"知らずのうちに男性としてその彼を愛してしまっているようだ。"},{"spoiler":false,"text":"その肉体は心無い医師によって、"},{"spoiler":false,"text":"決まった時が来ると「爆発」するように改造されている。"},{"spoiler":false,"text":"ある日事故に遭ってしまった彼を救うため、"},{"spoiler":false,"text":"マッドサイエンティストの医師による女体改造施術を受ける事となる。"}],"source":"egs","sourceCharacterId":"17019","sourceWorkId":"15150","spoiler":false},{"segments":[{"spoiler":false,"text":"施設で暮らす少女。幼い頃に両親と共に事故に遭っている。"},{"spoiler":false,"text":"少女は瀕死の重症を負いながらも命を繋いだが、両親はその時に亡くなってしまった。"},{"spoiler":false,"text":"同じ施設で育った年下の青年と仲が良く、兄弟のように振舞っているが、成長し一人の少女となった今では、知らずのうちに異性として愛してしまっている。"},{"spoiler":false,"text":"交通事故に遭った青年を救うため血液の提供を申し出るが、とある男の “女体改造” を施された形跡が見つかり、いずれは身体が爆発すると宣言される。"},{"spoiler":false,"text":"自分のためよりも青年を助けるため、マッドサイエンティストである若槻医師に身体を差し出すことを決意するが……"}],"source":"bangumi","sourceCharacterId":"40809"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f3dfdce888b8485849057678dc3ae1cd40478acdda58da72b5348a1797a215c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61332ae809ef4d4d0bcff5a7ac0c440da2ff4d39af15e7bdee9f42360b23e93a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:43352:40809:15684:1","source":"bangumi"}]},{"ch