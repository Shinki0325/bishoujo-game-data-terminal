{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"6763","model":{"presentationWorkId":"vndb:v3449","staff":{"artwork":[{"creditedName":"K×T","creatorId":"vndb:s52308","sourcePersonId":"egs:creator:3918","canonicalEntityId":"vndb:s52308","name":"K×T","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:14088","source":"egs"}],"scenario":[{"creditedName":"カルメ","creatorId":"vndb:s52309","sourcePersonId":"egs:creator:36049","canonicalEntityId":"vndb:s52309","name":"カルメ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:234252","source":"egs"}],"music":[{"creditedName":"畑亜貴","creatorId":"vndb:s2712","sourcePersonId":"egs:creator:2559","canonicalEntityId":"vndb:s2712","name":"畑亜貴","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:16489","source":"egs"}],"other":[{"creditedName":"K×T","creatorId":"vndb:s52308","sourcePersonId":"egs:creator:3918","canonicalEntityId":"vndb:s52308","name":"K×T","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"auto-confirmed","relationId":"egs:work-creator:14089","source":"egs"},{"creditedName":"畑 亜貴","creatorId":"vndb:s2712","sourcePersonId":"vndb:s2712","canonicalEntityId":"vndb:s2712","name":"畑 亜貴","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:43266","source":"vndb"},{"creditedName":"畑 亜貴","creatorId":"vndb:s2712","sourcePersonId":"vndb:s2712","canonicalEntityId":"vndb:s2712","name":"畑 亜貴","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:43267","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c16095","characterName":"リアム","sourceIds":{"vndbCharacterId":"c16095"},"originalCharacterName":"リアム","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Liam is a human teenager who lives in Rirudahna, and attends school there. He is chosen by the leader of the angels, Ruu, to mix a fragrance using the herbs of Flaithis, Rirudahna, and Annwn to try to bring peace between the warring Flaithis and Annwn once and for all. He is a gentle person who gets scared easily and also isn't very assertive when it comes to arguments, but he is also full of curiosity and may take rash actions because of this. Whether he ends up bright and gentle or strangely stubborn depends on the paths taken by the player."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c16095"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a58f942cd07d99d0380ff5baa5a31758fdf332722366364ab413bb4b4dfa9f2f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25dcb84dde6e7781f3d57fcd382620225c69d532d2e97a7181504f4390e8be52.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南 央美","creatorId":"vndb:s1870","sourcePersonId":"vndb:s1870","canonicalEntityId":"vndb:s1870","name":"南 央美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23806","source":"vndb"}]},{"characterId":"char_vndb_c16096","characterName":"アドル","sourceIds":{"vndbCharacterId":"c16096"},"originalCharacterName":"アドル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Addle is an angel from Flaithis, and is the leader of Lugh's imperial guards. He is a noble-minded character who puts on a very serious front and won't tolerate injustice or unreasonableness. However, on the inside he is very passionate and has a serious romantic attitude towards love. Addle's chivalrous knight-like behavior can lead to a refreshing, romantic love."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c16096"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c05280aa06166c0ff8a5e5d93b66cde824acccf06c3b74b0b885c23cf85bf1b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a80bcd6fd53f22cbf1ebffa855da9c8220f985262ebe579e525ed5aae3f9cc0f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"千葉 進歩","creatorId":"vndb:s400","sourcePersonId":"vndb:s400","canonicalEntityId":"vndb:s400","name":"千葉 進歩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23802","source":"vndb"}]},{"characterId":"char_vndb_c16097","characterName":"フィリス","sourceIds":{"vndbCharacterId":"c16097"},"originalCharacterName":"フィリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Philyth is an angel and part of the imperial guards of Flaithis. Philyth is very quiet and noble-minded, an angel of feminine beauty. Although he appears very graceful, soft, and delicate, he also hides a playful side and will sometimes crack a smile or laugh when least expected. He is the type that offers a gentle and affectionate romance."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c16097"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d1eb1234099993a6b6260b96cf63e166ae0cd91302c1889a4a279ba10f0e817.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b99f8cfd393553171317f684862d8aff1d8fe91df70a8478240fda8f3ea5b4e4.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤 美紀","creatorId":"vndb:s886","sourcePersonId":"vndb:s886","canonicalEntityId":"vndb:s886","name":"伊藤 美紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23805","source":"vndb"}]},{"characterId":"char_vndb_c16098","characterName":"ソリュード","sourceIds":{"vndbCharacterId":"c16098"},"originalCharacterName":"ソリュード","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"24"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Solude is an angel who is part of the imperial guard of Flaithis. He is a calm and generous person, who holds individual values which are unique for an angel. Inside he has a romanticist's passionate heart, but becomes clumsy or awkward when trying to express his feelings openly."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c16098"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9ff7787a3b680e6fd46c23223099b7a6273e873961c62d9a66a306012278f881.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/caa09eb02483210ad6fa52043bf8bf7ec9fbfc4e8666719f116406bbeb9da3b1.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上 和彦","creatorId":"vndb:s374","sourcePersonId":"vndb:s374","canonicalEntityId":"vndb:s374","name":"井上和彦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23800","source":"vndb"}]},{"characterId":"char_vndb_c16099","characterName":"ティム","sourceIds":{"vndbCharacterId":"c16099"},"originalCharacterName":"ティム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tim is an angel, also a member of the Flaithis imperial guard. Tim is very much a young and bright yet naive person, possessing the innocence of his age. He is very much the \"good honor student\" type: polite, respectable, and obedient. Romantically, Tim tends to be the submissive-type, but can take on a very caring, motherly love for the person he likes."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c16099"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/7671b7871940716aeffb2650677ffad966ca6dddf854d70ce76e0aa2ca66cb34.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/2735548d82c7f58c7a6f6fe270d239adb6cd0b25ea257dd236c819589adac531.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"関 智一","creatorId":"vndb:s249","sourcePersonId":"vndb:s249","canonicalEntityId":"vndb:s249","name":"関 智一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23798","source":"vndb"}]},{"characterId":"char_vndb_c16100","characterName":"ナデュー","sourceIds":{"vndbCharacterId":"c16100"},"originalCharacterName":"ナデュー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nadhew is a demon from Annwn. Being a demon, he tends to be impolite, atrocious, and spontaneous, and takes pleasure in picking on others. He likes to see how far he can push people, and is extremely mischievous. When it comes to romance, Nadhew tends to equate love with power. Since he becomes clumsy with serious romantic love, he takes a more playful approach."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c16100"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc6b87fe0c637107ca24ac170d0d4cd7713da34ad69f0aaa544733415d98dbca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed9334373fb280be804b2faf682aaace8d2d9764e457f80b349a2c3aba597e70.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"関 俊彦","creatorId":"vndb:s741","sourcePersonId":"vndb:s741","canonicalEntityId":"vndb:s741","name":"関 俊彦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23803","source":"vndb"}]},{"characterId":"char_vndb_c16101","characterName":"シトラ","sourceIds":{"vndbCharacterId":"c16101"},"originalCharacterName":"シトラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sittra is a demon from Annwn who is characterized as being very intellectual and voluptuous. He is a very elegant demon and takes pleasure in things he finds beautiful. When it comes to romance, he likes a balance of play and seriousness."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c16101"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/ded170e5d98adfdda33e3a841e38afc95ce9e0a1655e6e938c717a789b0d2e93.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6d86e908fbd8f653c707b2655cc386e6cfd43d51caef83f54cc197c42d91503.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"速水 奨","creatorId":"vndb:s751","sourcePersonId":"vndb:s751","canonicalEntityId":"vndb:s751","name":"速水 奨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23804","source":"vndb"}]},{"characterId":"char_vndb_c16102","characterName":"クレイドル","sourceIds":{"vndbCharacterId":"c16102"},"originalCharacterName":"クレイドル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"23"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Claydle is a demon of Annwn. He is a very cold-blooded person and a sadist who enjoys blood. In addition, he also has strong destructive magic power, and because of such even other demons tend to keep their distance from him. He is not the type to take interest in romance; unless, of course, he finds himself a willing masochistic submissive..."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c16102"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d103a28c41ce1ee509dd12f6e15145471e2f54f889ebcb7c2f33c9b44be14bac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05e5b582bd10026cb894906949db287379424a1a3009639ab46c9cbb90dee39c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三木 眞一郎","creatorId":"vndb:s252","sourcePersonId":"vndb:s252","canonicalEntityId":"vndb:s252","name":"三木眞一郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23799","source":"vndb"}]},{"characterId":"char_vndb_c16104","characterName":"ロキ","sourceIds":{"vndbCharacterId":"c16104"},"originalCharacterName":"ロキ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Roki is a demon of Annwn. He can be a violent and rough little brat, but there is something charming about him which makes him hard to dislike. He still carries the cruelty of a demon, but it is displayed in more of a child-like manner, and he finds it great fun to cause trouble. When it comes to romance, he is considered very cat-like; curious, playful, sometimes making the move, other times waiting for it."},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c16104"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63e749a5c50c6727e66b13311b531a9b2c284d8947c6eb613d6158a9ab9ebc84.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/889ea962b0f9ca37ed49253f81c0c0cab86a19cf33c742f735c53d4583d25689.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森久保 祥太郎","creatorId":"vndb:s381","sourcePersonId":"vndb:s381","canonicalEntityId":"vndb:s381","name":"森久保祥