{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"33120","model":{"presentationWorkId":"egs:33120","staff":{"artwork":[],"scenario":[],"music":[],"other":[{"creditedName":"三輪士郎","creatorId":"egs:creator:28610","sourcePersonId":"egs:creator:28610","canonicalEntityId":"egs:creator:28610","name":"三輪士郎","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"no-alias-hit","relationId":"egs:work-creator:283055","source":"egs"}]},"cast":[{"characterId":"char_bangumi_115402","characterName":"RINGO","sourceIds":{"bangumi":[{"characterId":"115402","match":"source-roster","subjectId":"371547"}]},"originalCharacterName":"RINGO","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"为了将你从这里带回去。"},{"spoiler":false,"text":"……为了阻止世界的终结。"},{"spoiler":false,"text":"Aion分裂出的特工。初临于人世，对人类社会及人类的感情有着旺盛的好奇心。与艾罗等恶魔召唤师共赴前线，为阻止世界的毁灭积极奔走。"},{"spoiler":false,"text":"-"},{"spoiler":false,"text":"あなたをここから連れ戻しにきた。"},{"spoiler":false,"text":"……世界の終わりを止めるために。"},{"spoiler":false,"text":"Aionのエージェント。生まれたばかりの存在で、社会や文化、人間の感情に強い好奇心を持つ。アロウ達デビルサマナーと共に前線に立ち、終焉の回避のために奔走する。"},{"spoiler":false,"text":"-"},{"spoiler":false,"text":"One of the agents of Aion, a futuristic digital sentient being. As an entity that was just created, she displays a keen interest in human society, culture, and emotions."},{"spoiler":false,"text":"Her choices and efforts, along with those of Arrow and her other fellow Devil Summoners, will be instrumental in deciding the fate of the human world."}],"source":"bangumi","sourceCharacterId":"115402"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb2d556a8a35d7ee40d4abaef0f2a6141244d058c514c151fa75f54af9426fae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72f23726cee03673834d16ac15275c86d07dcb887b6d807bc0716dc4bc28869e.webp","width":196,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黒沢ともよ","creatorId":"vndb:s10496","sourcePersonId":"vndb:s10496","canonicalEntityId":"vndb:s10496","name":"黒沢 ともよ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:371547:115402:9560:1","source":"bangumi"}]},{"characterId":"char_bangumi_115403","characterName":"FIGUE","sourceIds":{"bangumi":[{"characterId":"115403","match":"source-roster","subjectId":"371547"}]},"originalCharacterName":"FIGUE","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"你们需要一个能俯瞰局势的指挥者。"},{"spoiler":false,"text":"我负责在后方支援你们。"},{"spoiler":false,"text":"和林檎同时，作为Aion分裂出的特工诞生于世。"},{"spoiler":false,"text":"性格冷静、深思熟虑，总能适时制止突发奇想、一股脑行事的林檎。"},{"spoiler":false,"text":"不直接参与战斗，善于分析情报，坐镇后方支援。"},{"spoiler":false,"text":"-"},{"spoiler":false,"text":"状況を俯瞰できるコマンダーは必要でしょう。"},{"spoiler":false,"text":"私は後方からサポートをしたいと思います。"},{"spoiler":false,"text":"Aionのエージェントで、リンゴと同時に生まれた。クールで思慮深く、マイペースに突き進むリンゴをたしなめることも。戦いには直接参加せず、情報解析や後方支援を担う。"},{"spoiler":false,"text":"-"},{"spoiler":false,"text":"Another of Aion's agents, like Ringo. Cool and thoughtful, she acts like an older sister to Ringo and keeps her in check, as Ringo tends to be more stubborn. She, too, displays interest and admiration for humans, and is friendly to them. She specializes in analyzing information, and supports the team from behind the scenes."}],"source":"bangumi","sourceCharacterId":"115403"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8c885e07cf47d58e4e71149f7dcb4d16e1a188ae29eb8854c6151e15a997294.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27a7215da0b6cc897b8df32d3ab75d57d492cc92c13905f07aa3ff3a7a2b5524.webp","width":250,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森なな子","creatorId":"vndb:s9718","sourcePersonId":"vndb:s9718","canonicalEntityId":"vndb:s9718","name":"森 なな子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:371547:115403:14843:1","source":"bangumi"}]},{"characterId":"char_bangumi_115404","characterName":"ARROW","sourceIds":{"bangumi":[{"characterId":"115404","match":"source-roster","subjectId":"371547"}]},"originalCharacterName":"ARROW","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"停止无意义的争斗！"},{"spoiler":false,"text":"那些所作所为都是错的！快给我醒醒！"},{"spoiler":false,"text":"隶属于八咫乌的恶魔召唤师。Aion计算出的“关键人物”之一。"},{"spoiler":false,"text":"平时少言寡语，是一名为人稳重的青年。实际上他蕴含着一颗赤诚的耿直之心。"},{"spoiler":false,"text":"-"},{"spoiler":false,"text":"こんな戦いやめよう！"},{"spoiler":false,"text":"間違っているんだ！目を覚ませよ！"},{"spoiler":false,"text":"ヤタガラス所属のデビルサマナー。Aionが検出した「保護対象」の一人。普段は口数が少なく、実直で穏やかな青年。しかし内心には熱いものを秘めている。"},{"spoiler":false,"text":"-"},{"spoiler":false,"text":"An agent of Yatagarasu, one of the Devil Summoner factions. He is one of the individuals whose death supposedly plays a part in triggering the apocalypse. He was seemingly murdered during an undercover investigation, and is resurrected with Ringo's soul hacking. Normally gentle and quiet, but deep inside he is passionate and follows a strict moral code. Because of this, he often clashes with Milady."}],"source":"bangumi","sourceCharacterId":"115404"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7b5dfefbfefe6d22732a6d3223e4d22d2b60f1abd307c84f441e9af21270b00.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f77b8d4173df393aebcc19026e09567d732cc52eb1c9c3e5bf0667d58e4cb59.webp","width":234,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石川界人","creatorId":"vndb:s4435","sourcePersonId":"vndb:s4435","canonicalEntityId":"vndb:s4435","name":"石川 界人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:371547:115404:9953:1","source":"bangumi"}]},{"characterId":"char_bangumi_115405","characterName":"MILADY","sourceIds":{"bangumi":[{"characterId":"115405","match":"source-roster","subjectId":"371547"}]},"originalCharacterName":"MILADY","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"只要想到那个男人还逍遥自在地活着……"},{"spoiler":false,"text":"我就无法忍受。"},{"spoiler":false,"text":"隶属于魅影协会的恶魔召唤师，因为某个原因加入林檎一行。"},{"spoiler":false,"text":"性格冷静、富有理性，有时甚至会做出近似残酷的决策。但那一切似乎都与其过去的经历有关。"},{"spoiler":false,"text":"-"},{"spoiler":false,"text":"あの男がのうのうと生きてると思うと……"},{"spoiler":false,"text":"我慢できないのよ。"},{"spoiler":false,"text":"ファントムソサエティ所属のデビルサマナー。とある理由でリンゴに同行する。"},{"spoiler":false,"text":"理性的かつ合理的な性格で、時に冷酷な判断を下すこともあるが、どうやら過去の経験が関与しているようだ。"},{"spoiler":false,"text":"-"},{"spoiler":false,"text":"An agent of the Phantom Society, another of the Devil Summoner factions. She's killed by her own allies for reasons unknown. She is resurrected by Ringo's soul hacking, and decides to work with her to find out why she was killed. Calm and collected, she operates with logical thinking and efficiency, sometimes leading her to make decisions that others may deem heartless. It seems this may have something to do with her past."}],"source":"bangumi","sourceCharacterId":"115405"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85ac0b957d6ebfbeb5b3fe4e5f87f1c49a1baace40de6ad56f6592c93c2d9654.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/9641eaafb9b85bfa6b28f122adfbe3141124eb876acc482c91dc83795ca887f9.webp","width":227,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小清水亜美","creatorId":"vndb:s622","sourcePersonId":"vndb:s622","canonicalEntityId":"vndb:s622","name":"小清水 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:371547:115405:4474:1","source":"bangumi"}]},{"characterId":"char_bangumi_115406","characterName":"SAIZO","sourceIds":{"bangumi":[{"characterId":"115406","match":"source-roster","subjectId":"371547"}]},"originalCharacterName":"SAIZO","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真是的，这召唤师啊，"},{"spoiler":false,"text":"一个个的都喜欢把事情搞复杂。"},{"spoiler":false,"text":"麻烦得要死啊。"},{"spoiler":false,"text":"不隶属于任何组织的恶魔召唤师。"},{"spoiler":false,"text":"是个性格惹人喜爱，时而耍帅的浪漫主义者。"},{"spoiler":false,"text":"善于察言观色，经常会在艾罗与米莱狄争吵时介入劝架。"},{"spoiler":false,"text":"-"},{"spoiler":false,"text":"ったく、サマナーってのは、"},{"spoiler":false,"text":"どいつもこいつもこじらせやがって。"},{"spoiler":false,"text":"めんどくせーったらないぜ。"},{"spoiler":false,"text":"フリーのデビルサマナー。ロマンチストで愛嬌たっぷりなかっこつけ屋。"},{"spoiler":false,"text":"空気を読み行動するタイプで、対立しがちなアロウとミレディの仲裁に入ることも多い。"},{"spoiler":false,"text":"-"},{"spoiler":false,"text":"A freelance Devil Summoner. Although he's murdered by a Phantom Society agent, he is resurrected with Ringo's soul hacking. He decides to accompany Ringo and her team with a certain objective of his own in mind. A romantic at heart, he plays it cool in his own endearing way. Able to read the room, he often mediates and steps in whenever Arrow and Milady clash with one another."}],"source":"bangumi","sourceCharacterId":"115406"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/822e227aedc9098d6732ca1d357648a42eac5d67fe3d430706a1196569626617.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4a7245322d7991a1f550ae177130ce44efe0aa257e59bc798e084b68533cf64.webp","width":256,"height":213,"source":"static-detail"},"actors":[{"creditedName":"松風雅也","creatorId":"vndb:s615","sourcePersonId":"vndb:s615","canonicalEntityId":"vndb:s615","name":"松風 雅也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:371547:115406:4758:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p203","sourceCompanyId":"egs:brand:737","canonicalEntityId":"vndb:p203","name":"ATLUS","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:33120:737","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
