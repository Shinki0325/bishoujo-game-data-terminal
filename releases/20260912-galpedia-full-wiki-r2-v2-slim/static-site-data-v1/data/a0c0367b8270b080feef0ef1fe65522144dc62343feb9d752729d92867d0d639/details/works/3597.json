/v1/images/14/14cac52db0efe2cf5c5166761f814a1c72958199992b1669537140f247f7ab5d.webp","width":207,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c5539","characterName":"一代","sourceIds":{"vndbCharacterId":"c5539"},"originalCharacterName":"一代","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Contestant #1 in the Under 20 Talent Contest, she becomes enraged when the announcement is made that Mutsumi has won."},{"spoiler":false,"text":"Taking things into her own hands, Kazuyo proceeds to show off that she's still more talented than her rival could ever be."},{"spoiler":false,"text":"From \"Afternoon\" story."}],"source":"vndb","sourceCharacterId":"c5539"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/229a4f3915079768336ce830b30d21579ddd4712a77759bc690399b225415d12.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/285bb0445f4bcad30007f7ab44eaffeb9119eb0c9dafa36c167602de6a1e736f.webp","width":207,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c95057","characterName":"久美","sourceIds":{"vndbCharacterId":"c95057"},"originalCharacterName":"久美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young female investigator."},{"spoiler":false,"text":"She and her partner, Miho, accepted a job from a client after a period of poor business. The mission was to investigate the disappearance of women at a mansion."},{"spoiler":false,"text":"Kumi was tasked with infiltrating the premises, disguised as a maid."},{"spoiler":false,"text":"From \"Double Impact\" story."}],"source":"vndb","sourceCharacterId":"c95057"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a644625f9b8c982fc0a482a4cd1897829eeb105c54250c249e9bc2d562c6d62.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9ff66fa40cf3da1fc81909343e6713ea34d8ee0da6f55bf7e47767a69369207d.webp","width":207,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c95058","characterName":"カレラ","sourceIds":{"vndbCharacterId":"c95058"},"originalCharacterName":"カレラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has reaped the souls of countless men and looks forward to each new conquest with renewed interest. Due to her experience, she has been assigned to work with the wizard Alpina to help harness more powerful energies from the human soul."},{"spoiler":false,"text":"In Viper-V6 (\"The Devil Came\" story), she is called to Earth by Ogawa's summoning spell, where she gives him the standard summoning contract: pleasure her completely or lose his soul. Since no man has ever completely satisfied a succubus, Carrera has no doubts that Ogawa will be just another soul she brings back to the demon world. To her surprise he has an nearly unlimited well of energy and manages to satisfy her."},{"spoiler":false,"text":"In Viper-GTS, Carrera returns to the underworld empty-handed, which has never happened to her before. She is summoned before the lords of the nether world to explain her failure, where she was embarrassingly imprisoned."}],"source":"vndb","sourceCharacterId":"c95058"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.