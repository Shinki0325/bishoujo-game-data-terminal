"}]},"cast":[{"characterId":"char_vndb_c42783","characterName":"リアン＝ロレンス","sourceIds":{"vndbCharacterId":"c42783"},"originalCharacterName":"リアン＝ロレンス","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"When I hear about things like adventure and exploration, I just get so excited!\""},{"spoiler":false,"text":"She's always yearned for adventure and goes to the port city to seek it out."},{"spoiler":false,"text":"She was taught swordsmanship by her missing father and is quite good at it."}],"source":"vndb","sourceCharacterId":"c42783"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d78d9d2346d679b41bb3959a16864f558030800fb79a1e85abe226da904ef7f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa8f29b53af648607aeb158563a5639618c62ee77ab9c708a528ded8953c0c03.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小松 未可子","creatorId":"vndb:s7545","sourcePersonId":"vndb:s7545","canonicalEntityId":"vndb:s7545","name":"小松 未可子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57334","source":"vndb"}]},{"characterId":"char_vndb_c42784","characterName":"ジェイク＝バーンズ","sourceIds":{"vndbCharacterId":"c42784"},"originalCharacterName":"ジェイク＝バーンズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Raise the flag you guys! There's a mountain of treasure in front of us!\""},{"spoiler":false,"text":"The captain of a crew of pirates."},{"spoiler":false,"text":"An overbearing guy who is quite confident but he's actually quite kind and treasures his comrades above all else, especially his right hand man Crave who he's know since he was a kid."},{"spoiler":false,"text":"Even though he's a pirate he only targets corrupt merchants and other pirates who do bad deeds, he leaves good merchants and normal ships alone."}],"source":"vndb","sourceCharacterId":"c42784"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/863ae23495d525da8b246896faeec07f3705c938220cf83c4cda4312dde29baa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/635159a79834e67c64afc6fa10c149949c31d9ec9b53d36f969da7062dc64f14.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杉田 智和","creatorId":"vndb:s370","sourcePersonId":"vndb:s370","canonicalEntityId":"vndb:s370","name":"杉田 智和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57325","source":"vndb"}]},{"characterId":"char_vndb_c42785","characterName":"クレイヴ＝フォスター","sourceIds":{"vndbCharacterId":"c42785"},"originalCharacterName":"クレイヴ＝フォスター","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"...It can't be helped, I'll just have to protect the back of the captain who is full of openings.\""},{"spoiler":false,"text":"The vice-captain of the crew of pirates. Jake's right hand man and childhood friend."},{"spoiler":false,"text":"He's responsible for the management and finances of the pirate group. His specialty is negotiation especially using his logic to set things right."},{"spoiler":false,"text":"However when the freewheeling Jake and Emilio mess around with him he shows a side that is quick to anger, he's the one person in the crew that isn't to be messed with."}],"source":"vndb","sourceCharacterId":"c42785"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cf6f29cb046fdf507be024b3a3fee2549a1f823560eeaf1af7e19fd3c885a23.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14a24ae28c546c01c9fe0bbabaf90858a8176186a15b8f94ca372ca38e5940b8.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"KENN","creatorId":"vndb:s372","sourcePersonId":"vndb:s372","canonicalEntityId":"vndb:s372","name":"KENN","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57326","source":"vndb"}]},{"characterId":"char_vndb_c42786","characterName":"エミリオ＝ルース","sourceIds":{"vndbCharacterId":"c42786"},"originalCharacterName":"エミリオ＝ルース","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Nyahaha, Everybody's going to owe me one now~\""},{"spoiler":false,"text":"Just a normal member of the crew of pirates."},{"spoiler":false,"text":"He has a personality like a fickle cat and absolutely wont do things he isn't interested in."},{"spoiler":false,"text":"He possesses strangely sharp intuition and is good at gambling and card games."},{"spoiler":false,"text":"He respects Jake and Crave for taking him in, but his favorite thing to do is still to tease Jake."}],"source":"vndb","sourceCharacterId":"c42786"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fa46e0cbe462a4028f1f06d93f335b3da8fd995291e259185a91f82d7b7c2b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad19afaf9c04b7a9746dea3c1cf5d8a22a9141637f4c84b1dada094d0bff9b91.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松岡 禎丞","creatorId":"vndb:s748","sourcePersonId":"vndb:s748","canonicalEntityId":"vndb:s748","name":"松岡 禎丞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57330","source":"vndb"}]},{"characterId":"char_vndb_c42787","characterName":"フレデリック＝ロゼ＝ランフォード","sourceIds":{"vndbCharacterId":"c42787"},"originalCharacterName":"フレデリック＝ロゼ＝ランフォード","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You damn pirates! I'm going to catch you today for sure!\""},{"spoiler":false,"text":"Captain of the seventh team of special anti-pirate forces in the Guardia Navy."},{"spoiler":false,"text":"The eldest son of the noble Rumford family."},{"spoiler":false,"text":"He's quite aware of the fact that he looks younger than his age and gets angry when it's pointed out."},{"spoiler":false,"text":"The fact that he's assigned as the leader of a special team at his young age is more because of his own effort than the fact that he's a noble."}],"source":"vndb","sourceCharacterId":"c42787"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b36790eb293a33e00686ce8491150509084e7db7af2410a3d5eb427c3d4fa8db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b95927c6370d69be422963ca839b24c1f83e4ea70a7251164d8837187d83e651.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柿原 徹也","creatorId":"vndb:s80","sourcePersonId":"vndb:s80","canonicalEntityId":"vndb:s80","name":"柿原 徹也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57324","source":"vndb"}]},{"characterId":"char_vndb_c42790","characterName":"ディーン＝カヴィル","sourceIds":{"vndbCharacterId":"c42790"},"originalCharacterName":"ディーン＝カヴィル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"...Experience outdoes plain talent, it would be good if you remembered that.\""},{"spoiler":false,"text":"Vice-captain of the seventh team of special anti-pirate forces in the Guardia Navy."},{"spoiler":false,"text":"He owes Frederick a favor and in order to repay him he becomes his subordinate in the special team."},{"spoiler":false,"text":"He has the best sword arm among the whole of the Guardia navy and is a person who is feared by the pirates."},{"spoiler":false,"text":"A quiet guy who doesn't like to talk about things outside of work and who likes to think in the long term."}],"source":"vndb","sourceCharacterId":"c42790"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/6454d3bf47403d96d67c0cd759422224050df95c776c01118e9e130f458cf5b3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f44336bfa29114a9bc2ec0fa7bcbe1e2cb89bac8acbce9b799215526cd76b2d4.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"置鮎 龍太郎","creatorId":"vndb:s747","sourcePersonId":"vndb:s747","canonicalEntityId":"vndb:s747","name":"置鮎 龍太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57329","source":"vndb"}]},{"characterId":"char_vndb_c42791","characterName":"レナード＝フォン＝バークレイ","sourceIds":{"vndbCharacterId":"c42791"},"originalCharacterName":"レナード＝フォン＝バークレイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1112"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"My duty is to present a glimpse of a dream world to all the beautiful women.\""},{"spoiler":false,"text":"A noble of the country of Astrica and an actor in the church plays."},{"spoiler":false,"text":"His family has been nobility for a long time, but after his parents death the legacy is crumbling and he lives simply in an old mansion only with his old butler Henry."},{"spoiler":false,"text":"He's good at negotiation, but he can only share his good side with women and often looks down at other men."}],"source":"vndb","sourceCharacterId":"c42791"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70069a800a0ba792e16f0a4e4bdcf78b95293729d2559bb130c531f5ef7b35ce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef541a2cb2c8c6c87bb97aa434afc0489b3e4cb90c14191a1f213f6baeeba552.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森川 智之","creatorId":"vndb:s53","sourcePersonId":"vndb:s53","canonicalEntityId":"vndb:s53","name":"森川智之","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:57323","source":"vndb"}]},{"characterId":"char_vndb_c42792","characterName":"サディアス＝キースリー","sourceIds":{"vndbCharacterId":"c42792"},"originalCharacterName":"サディアス＝キースリー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descri