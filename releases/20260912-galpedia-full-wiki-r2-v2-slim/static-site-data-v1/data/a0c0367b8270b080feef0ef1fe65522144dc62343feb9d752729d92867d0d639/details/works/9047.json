reditedName":"Umi-game","creatorId":"egs:creator:37349","sourcePersonId":"egs:creator:37349","canonicalEntityId":"egs:creator:37349","name":"Umi-game","detail":"スペシャルサンクス","roleCode":"other","roleLabel":"其他","identityStatus":"alias-only-review","relationId":"egs:work-creator:240740","source":"egs"},{"creditedName":"14","creatorId":"egs:creator:37350","sourcePersonId":"egs:creator:37350","canonicalEntityId":"egs:creator:37350","name":"14","detail":"スペシャルサンクス","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:240741","source":"egs"},{"creditedName":"アニメアンテナ委員会","creatorId":"egs:creator:37351","sourcePersonId":"egs:creator:37351","canonicalEntityId":"egs:creator:37351","name":"アニメアンテナ委員会","detail":"アニメーション制作","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:240742","source":"egs"},{"creditedName":"真理絵(marie)","creatorId":"vndb:s47","sourcePersonId":"egs:creator:12359","canonicalEntityId":"vndb:s47","name":"真理絵(marie)","detail":"OP曲「蒼月」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:65082","source":"egs"},{"creditedName":"真理絵","creatorId":"vndb:s47","sourcePersonId":"vndb:s47","canonicalEntityId":"vndb:s47","name":"真理絵","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:43149","source":"vndb"},{"creditedName":"松宮 豊","creatorId":"vndb:s2407","sourcePersonId":"vndb:s2407","canonicalEntityId":"vndb:s2407","name":"松宮 豊","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:43151","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c11067","characterName":"二藍 茜","sourceIds":{"vndbCharacterId":"c11067"},"originalCharacterName":"二藍 茜","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Akane is a university student studying history. She was hoping to relax during the summer holidays, but after her mother collapsed at work, Akane decides to help her family business until her mother gets better. Everything was normal until she discovers a letter addressed to her mother, which revealed that Akane is actually adopted. Shocked, Akane is torn between finding out the whole truth and the fear of finding out things that would be better left untouched."},{"spoiler":false,"text":"Sully claims that she summoned him, but Akane has no knowledge of doing so. At first, working in place of her mother is tiring and stressful, but she adjusts before she knows it. Her kind, caring and hardworking nature makes her well suited to her post."}],"source":"vndb","sourceCharacterId":"c11067"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cc2c49af77c1d004602d68c2864703a64c1a2ff528b44aabde5e49fa7be333c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/804916f61c441e3fb9e9b59ab7aee1c6e3300c12fcac365c5fc19d2efa758963.webp","width":205,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c11068","characterName":"カバレフ・スタニスラフマダー・サリィヴァン","sourceIds":{"vndbCharacterId":"c11068"},"originalCharacterName":"カバレフ・スタニスラフマダー・サリィヴァン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nicknamed Sully, he is an angel prince that was (supposedly) summoned from the moon by Akane. Sully was tasked by his father, the king, to help Akane resolve what is currently bothering her (the truth about her real parents) by the next full moon. Though he is 20, he often gets mistaken as a child, if not, a mid-teenager (Akane described him as \"looking around 15-years-old)."},{"spoiler":false,"text":"Not wanting to make Akane's peers suspicious, Sully had somebody from the moon world alter their memories, so he could better carry out his task. Because of this, those close to Akane are arranged to think that Sully is a distant relative of Akane's. Despite his complex and somewhat dignified method of speech, Sully is quite childish and slightly spoiled. However, Sully can be surprisingly obedient at times. He too, ends up helping out the eel restaurant as a waiter and delivery boy as part of his guise."}],"source":"vndb","sourceCharacterId":"c11068"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93c3f2e6e543b83ce7b24e22b69309e23d9f915dcaa4e1ca1425651dc8795000.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fcba8ebc36bff55fb0c2738fdc4c6d1d15b1c6cbb9e3179d38bca09b90118c7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"少林寺 アキラ","creatorId":"vndb:s375","sourcePersonId":"vndb:s375","canonicalEntityId":"vndb:s375","name":"菅沼 久義","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23744","source":"vndb"}]},{"characterId":"char_vndb_c11069","characterName":"青山 秀一","sourceIds":{"vndbCharacterId":"c11069"},"originalCharacterName":"青山 秀一","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shuichi is a new addition to the eel restaurant, making him Akane and Atsunori's kouhai. He decided to work part time for the first time in his life, as he wanted to have more experiences before school starts again. Shuichi is an interior design student at a specialist college. He's cheerful, outgoing and polite, but is sometimes hard to read. Shuichi is quite sharp, and picks up on his surroundings with little effort. He apparently went to the same high school as Akane, but she doesn't remember."}],"source":"vndb","sourceCharacterId":"c11069"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8b75a725c999992ace444803913a7c92438483713bbe6b97a4318b052b94b9e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f60b56d422ef8194ad350ed333392a4ef8956a5fa9b3c0873a10078585d16253.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"空野 太陽","creatorId":"vndb:s88","sourcePersonId":"vndb:s88","canonicalEntityId":"vndb:s88","name":"岸尾 だいすけ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23743","source":"vndb"}]},{"characterId":"char_vndb_c11070","characterName":"須賀 敦公","sourceIds":{"vndbCharacterId":"c11070"},"originalCharacterName":"須賀 敦公","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"26"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Atsunori has been working as a chef for the restaurant for five years. He's very laidback, friendly and cheerful. Because of his dedication to his job and the restaurant, he's well-liked by Akane's parents and is even treated like family a lot of the time. He's also the go-to guy when Makoto is away- his juniors trust in and find him to be reliable. In spite of his extroversion, Akane catches him losing his cheer every now and then, and has no idea what's bothering him. Atsunori doesn't think highly of Yuusuke, and seems to know him from before the restaurant workers' first meeting with him."}],"source":"vndb","sourceCharacterId":"c11070"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1558a1dfcf5b550a5349df40c9254ca8b15d852fb63e41c040b23fadf4823ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6eda8d66783efd846feab382be56abacffeb6e834160b07f1ef58e8a0cc88c32.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安芸怜須 ケン","creatorId":"vndb:s385","sourcePersonId":"vndb:s385","canonicalEntityId":"vndb:s385","name":"浜田 賢二","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23745","source":"vndb"}]},{"characterId":"char_vndb_c11072","characterName":"藤崎 祐介","sourceIds":{"vndbCharacterId":"c11072"},"originalCharacterName":"藤崎 祐介","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuusuke is a businessman that recently moved into the town of Toiro for work purposes. He eventually becomes a regular at the Osaki eel restaurant. Yuusuke has a refreshing personality, which alongside with his friendliness and polite charm, helps him leave excellent impressions upon everyone he meets. Even so, Yuusuke can be surprisingly argumentative. Quick-witted, he never loses in a verbal argument. As well as Atsunori, Moe also has a bad impression of Yuusuke; becoming much ruder than she usually is."}],"source":"vndb","sourceCharacterId":"c11072"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/223ee87cd5cb42d66c26fd304d71f7fb530ef09686bdd3da01591747a3d1e341.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff25544aed0d308e0017691ed1a61032b54946a5faf420faf6fa3b6a5331cfe3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黄金原 光輝","creatorId":"vndb:s1904","sourcePersonId":"vndb:s1904","canonicalEntityId":"vndb:s1904","name":"金子 英彦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23748","source":"vndb"}]},{"characterId":"char_vndb_c11073","characterName":"杜若 五郎","sourceIds":{"vndbCharacterId":"c11073"},"originalCharacterName":"杜若 五郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"30"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Very refined, polite and mild-mannered, Gorou is a traditionalist gentleman. He has known Akane's parents for a while; tasked with managing the floral displays of the restaurant. Gorou seems to especially get along with Miyoko. He's very calm and relaxed, and seems to calm those around him as well. Gorou sometimes makes some unexpected observations or statements, which makes Akane occasionally describe him as a \"strange man\". When he's not busy taking care of the restaurant's flowers, he works as a Kadou (flower arrangement art) teacher."}],"source":"vndb","sourceCharacterId":"c11073"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93f2f25e0af33ef52808d10ade352905ccf1a29fb1724b4d09d949b8b92504a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/effcd7e17f915d8558ab916838fc3fd6693ef1ef2854b99d244b27db05192018.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山口 武","creatorId":"vndb:s236","sourcePersonId":"vndb:s236","canonicalEntityId":"vndb:s236","name":"竹本 英史","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23742","source":"vndb"}]},{"characterId":"char_vndb_c11074","characterName":"山吹 葵","sourceIds":{"vndbCharacterId":"c11074"},"originalCharacterName":"山吹 葵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"23"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aoi is Akane's senpai since their high school days, though they've only recently reconnected. He was her senior in their high school's Japanese archery club. Additionally, Aoi and Akane are childhood friends. Akane used to have a crush on him, but eventually her feelings fizzled out. Now a university student, Aoi is studying to become a vet, and as a result, is frequently busy with his studies, even during the summer holidays. He is the older brother of Moe, the local shrine's miko (shrine maiden)."},{"spoiler":false,"text":"Aoi has a very calm, docile and kind personality, which made him popular with the girls during his school days. He goes about his everyday activities at his own distinctive pace. Maybe because of these traits, Aoi has a tendency to think too hard about even the simplest things. He lacks strong opinions, so he often finds himself going with the flow."}],"source":"vndb","sourceCharacterId":"c11074"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba226c2465e2f4f0c33a214c4e7123907e2099f5dd4a8dcd89738f768dcc7558.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b683569a71904eb5eb230f2cbe1502eb15f5d814a682efedb81e039d4c9e11b1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大文字 妬","creatorId":"vndb:s2861","sourcePersonId":"vndb:s2861","canonicalEntityId":"vndb:s2861","name":"田中大文","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23747","source":"vndb"}]},{"characterId":"char_vndb_c11075","characterName":"山吹 萌","sourceIds":{"vndbCharacterId":"c11075"},"originalCharacterName":"山吹 萌","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the same age as Akane, and they went to the same primary school together. Moe is Aoi's younger sister, and works at her family's shrine as its maiden (miko) since she graduated high school. Despite playing together in their childhood, Moe is now cold and rude towards Akane. In fact, her coldness and rudeness isn't limited to Akane- the only person she seems to be amicable with is Aoi."}],"source":"vndb","sourceCharacterId":"c11075"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9bd9bc6e7ad8b09a32bcc5d76eff94fbcfe7227bc163f18a162b590f09e6844.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aeff5b802a7da6af3b31e0b3cc2626ce41b79b5fb79056734f7f9eb08bb3b37e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中原 まこと","creatorId":"vndb:s14697","sourcePersonId":"vndb:s14697","canonicalEntityId":"vndb:s14697","name":"中原 まこと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:23749","source":"vndb"}]},{"char