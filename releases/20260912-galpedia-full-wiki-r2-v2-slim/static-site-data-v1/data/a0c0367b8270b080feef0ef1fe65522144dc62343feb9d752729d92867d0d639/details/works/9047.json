ins in a stable condition- her collapse wasn't a sign of anything life-threatening."},{"spoiler":false,"text":"CV: SaRara (friend of the developer's, not a professional voice actress)"}],"source":"vndb","sourceCharacterId":"c11077"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5ff70efb21e1501699621f023a62aebeb538e1324ea137abb2e39f794396776c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6bdfd8f84914ec646c14b1d3956ca9766123da74275d027a04eab0c28addef5f.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1106","sourceCompanyId":"egs:brand:1428","canonicalEntityId":"vndb:p1106","name":"月下氷人","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:9047:1428","source":"egs"},{"companyId":"vndb:p1106","sourceCompanyId":"vndb:p1106","canonicalEntityId":"vndb:p1106","name":"月下氷人","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:7904:v3426","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
