nId":"vndb:vn-staff:33566","source":"vndb"}]},"cast":[{"characterId":"char_c20538","characterName":"イリス・レベル","sourceIds":{"bangumi":[{"characterId":"52110","match":"exact-normalized-name-in-linked-work","subjectId":"210765"}],"egsCharacterIds":["25662"],"vndbCharacterId":"c20538"},"originalCharacterName":"イリス・レベル","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A human (earthling)."},{"spoiler":false,"text":"A beautiful lieutenant belonging to the SSF’s Special Armored Company #101."},{"spoiler":false,"text":"An ace that pilots a cutting edge Armored Knight, the ADT-74 Griffin."},{"spoiler":false,"text":"Iris possesses a bright, sociable personality, and she’s viewed as an easy-going leader to her juniors. On the other hand, she’s slightly childish at times, evident during squabbles with her partner, Mei Li."},{"spoiler":false,"text":"She has a strong sense of justice and she confronts criminals with a cold demeanor, which she is feared for."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c20538"},{"segments":[{"spoiler":false,"text":"人間（地球人）の女性。"},{"spoiler":false,"text":"連邦保安軍「SSF」の第101特殊装甲中隊に所属する中尉。"},{"spoiler":false,"text":"最新鋭の装甲騎「ADT-74ゲツエイ」を愛機とするエースパイロット。"},{"spoiler":false,"text":"性格は明朗快活で気さくだが、若干、子供っぽいところも。"},{"spoiler":false,"text":"また正義感が強く、犯罪者に対しては至って冷酷。"}],"source":"egs","sourceCharacterId":"25662","sourceWorkId":"7408","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公。人間（地球人）。"},{"spoiler":false,"text":"連邦保安軍『ＳＳＦ』の第101特殊装甲中隊に所属する美女中尉。"},{"spoiler":false,"text":"新鋭装甲騎ＡＤＴ-74グリフォンを駆るエースパイロット。"},{"spoiler":false,"text":"気さくで明るい性格で、後輩たちなどにも優しい先輩で通っているが、"},{"spoiler":false,"text":"その一方で少し子供っぽいところがあり、 相棒のメイリィとの掛け合いや言い争いの時にそれは垣間見える。"},{"spoiler":false,"text":"正義感が強く犯罪者には冷然な態度で臨み、彼らからは恐れられている。"}],"source":"bangumi","sourceCharacterId":"52110"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/eff6e7707b22450bb39cbbb71e17cb49722399a4aa3972120f801837fb505ede.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a89fe5a0c18430e5364f640471102cf0c9c047e0b5ff05c72a683d70fd456b7f.webp","width":185,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日 アン","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:210765:52110:6480:1","source":"bangumi"}]},{"characterId":"char_c20539","characterName":"メイリィ ナセリ","sourceIds":{"bangumi":[{"characterId":"53455","match":"exact-normalized-name-in-linked-work","subjectId":"210765"}],"egsCharacterIds":["25663"],"vndbCharacterId":"c20539"},"originalCharacterName":"メイリィ ナセリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Iris’ partner. An elven."},{"spoiler":false,"text":"A lieutenant belonging to the SSF’s Special Armored Company #101, just like Iris."},{"spoiler":false,"text":"An ace that pilots a cutting edge Armored Knight, the ADT-73 Chimera. Elvens boast long lives, and while she may appear childish, her age is really over 100 years, at least by human standards."},{"spoiler":false,"text":"Elvens are incredibly intelligent and scientific, though they do have a tendency to look down on other species’ due to their high pride. Mei Li is no exception, possessing an unyielding spirit that occasionally arouses trouble."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c20539"},{"segments":[{"spoiler":false,"text":"エルフィン人の女性。イリスの相棒。"},{"spoiler":false,"text":"連邦保安軍『SSF』の第101特殊装甲中隊に所属する中尉。"},{"spoiler":false,"text":"新鋭装甲騎「ADT-73コンゴウ」を愛機とするエースパイロット。"},{"spoiler":false,"text":"幼く見えるが、人間年齢的には100歳を超える。"},{"spoiler":false,"text":"優れた知性と科学力を有する種族であるエルフィン人は、気位が高く、他の種族を下に見る傾向があり、それが元でトラブルを巻き起こすこともしばしば。"}],"source":"egs","sourceCharacterId":"25663","sourceWorkId":"7408","spoiler":false},{"segments":[{"spoiler":false,"text":"イリスの相棒。エルフィン人。"},{"spoiler":false,"text":"イリスと同じく、連邦保安軍『ＳＳＦ』の第101特殊装甲中隊に所属する中尉。"},{"spoiler":false,"text":"新鋭装甲騎ＡＤＴ-73キメイラを駆るエースパイロット。"},{"spoiler":false,"text":"一見幼く見えるが人間年齢でいうと100歳は超えるのだとか。"},{"spoiler":false,"text":"長命を誇るエルフィン人の特徴である。"},{"spoiler":false,"text":"エルフィン人は優れた知性と科学力を有する種族で、気位が高く他の種族のバカにする傾向がある。"},{"spoiler":false,"text":"彼女にもそんな傾向があり、その勝気な性格もあってしばしばトラブルを引き起こす。"}],"source":"bangumi","sourceCharacterId":"53455"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36907338d9a9d04e7bab354967ac2361ff3370346963b34ca6d9d7e88211768c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28afa5b7b36c6aab95c13bf8e5770bd8a19cbac0421396dd2397caf9d82a25b8.webp","width":102,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大野まりな","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:210765:53455:4434:1","source":"bangumi"}]},{"characterId":"char_vndb_c34332","characterName":"リルル","sourceIds":{"vndbCharacterId":"c34332"},"originalCharacterName":"リルル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A servant in Dark Town's brothel who mysteriously looks like Mei Li."},{"spoiler":false