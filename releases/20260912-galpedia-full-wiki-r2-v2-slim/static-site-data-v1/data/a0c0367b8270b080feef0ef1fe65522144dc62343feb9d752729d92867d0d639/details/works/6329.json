State":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染。"},{"spoiler":false,"text":"くノ一になるべく特訓に励んでいるが、心・技・体と全てにおいてヘッポコなことから、毎年、落第し、その留年回数は忍術学院で歴代第一位を記録し、今尚、更新中。"},{"spoiler":false,"text":"茶屋「まほろば」でウェイトレスのバイトをしており、そちらを本業にすれば良いのにと、周囲は思っている。"},{"spoiler":false,"text":"昔から主人公に好意を寄せているが、片想い。"}],"source":"egs","sourceCharacterId":"26242","sourceWorkId":"6329","spoiler":false},{"segments":[{"spoiler":false,"text":"里でくのいちとなるべく特訓に励む万年落第生。"},{"spoiler":false,"text":"忍術学院の中でも歴代一位の留年回数を保持している（記録更新中）。"},{"spoiler":false,"text":"心・技・体とすべてにおいて劣等生なへっぽこくのいち。"},{"spoiler":false,"text":"乳はでかい。"},{"spoiler":false,"text":"茶屋「まほろば」でウェイトレスのバイトをしている。"}],"source":"bangumi","sourceCharacterId":"141439"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2bd2e7843bb6d87051adea4816113d5e76005e9bf5af90dea247c9f5d383ff6c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e7a4e30954108cd7268a58e3c4b0c29ff817544664f9e438e7c41278400d2a7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:274762:141439:5890:1","source":"bangumi"}]},{"characterId":"char_c54719","characterName":"小鈴","sourceIds":{"bangumi":[{"characterId":"141440","match":"exact-normalized-name-in-linked-work","subjectId":"274762"}],"egsCharacterIds":["26243"],"vndbCharacterId":"c54719"},"originalCharacterName":"小鈴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"里で「姫ちゃん」と呼ばれ親しまれる可愛らしい女の子。"},{"spoiler":false,"text":"主人公の受け持つ教室でも、その可愛らしさからマスコット的な存在。"},{"spoiler":false,"text":"性格は負けず嫌いで子供っぽく、その言動も自由奔放。"},{"spoiler":false,"text":"世間知らずなところが目立つ彼女だが、時折、一般庶民では知りえない知識を披露することもしばしば。"}],"source":"egs","sourceCharacterId":"26243","sourceWorkId":"6329","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の受け持つ教室のマスコットキャラ的存在の生徒。"},{"spoiler":false,"text":"自由奔放な言動から、里の中では「姫ちゃん」と呼ばれ親しまれている。"}],"source":"bangumi","sourceCharacterId":"141440"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/039182dcf07f3e1e96626b34c2eb4254544ef2b0ba7c41e95120272bc87d4087.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db58a8bc7707f8a7a4649297fa4845da2474d79921e02bdb5bd6f7dd450388bb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高瀬 聖","creatorId":"vndb:s2061","sourcePersonId":"vndb:s2061","canonicalEntityId":"vndb:s2061","name":"高瀬聖","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:45659","source":"vndb"}]},{"characterId":"char_c54720","characterName":"ティアラ","sourceIds":{"bangumi":[{"characterId":"141441","match":"exact-normalized-name-in-linked-work","subjectId":"274762"}],"egsCharacterIds":["26244"],"vndbCharacterId":"c54720"},"originalCharacterName":"ティアラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本人曰く、海外からの留学生。"},{"spoiler":false,"text":"過度に自由奔放な性格で、何事にも捕らわれず、拘らず、故に遅刻と欠席の常習***。"},{"spoiler":false,"text":"酒をこよなく愛し、いつも酔っ払ったような言動で周囲を煙に巻く。"},{"spoiler":false,"text":"里で古物商のような店を構えており、外国の知識や品物を売りさばいている。"}],"source":"egs","sourceCharacterId":"26244","sourceWorkId":"6329","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の教室に在籍する生徒で、海外からの留学生（本人談）外国の知識や品物を多く持ち、副業として里の中で古物商のような店を構えている。"},{"spoiler":false,"text":"酒を愛する、遅刻と欠席の常習者。"}],"source":"bangumi","sourceCharacterId":"141441"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df048276fda01414ee9fb83ee765dfd6561ada21c66456fb1735ff1f6a5e6a5a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e26ac551e840f325c10cb02bd08a1803a9df95fe4618981238eda20cc9bc605.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"なかせひな","creatorId":"vndb:s926","sourcePersonId":"vndb:s926","canonicalEntityId":"vndb:s926","name":"なかせ ひな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:274762:141441:12719:1","source":"bangumi"}]},{"characterId":"char_c54721","characterName":"巴","sourceIds":{"bangumi":[{"characterId":"141442","match":"exact-normalized-name-in-linked-work","subjectId":"274762"}],"egsCharacterIds":["26245"],"vndbCharacterId":"c54721"},"originalCharacterName":"巴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の教室の生徒で、学級委員を務めるほどの優等生。"},{"spoiler":false,"text":"成績もトップクラスを誇るが、真面目な性格が災いして、様々な苦労を背負い込む。"},{"spoiler":false,"text":"別の教室には双子の弟・葵が在籍。"},{"spoiler":false,"text":"しかし、巴とは正反対で、強引な上にワガママで自己中心的。"},{"spoiler":false,"text":"常に巴に強気な態度を取っているらしいが……。"}],"source":"egs","sourceCharacterId":"26245","sourceWorkId":"6329","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の教室で学級委員として皆をまとめている生徒。教室の中でもトップクラスの成績を誇る。"},{"spoiler":false,"text":"真面目な性格だが、それが災いして苦労人となっている。"},{"spoiler":false,"text":"他の生徒たちに振り回され、胃を痛める受難の日々が続く。"}],"source":"bangumi","sourceCharacterId":"141442"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/2486063263e7bd3661d8582a3ed4a8d1fa569b9c9166334dec774da54b17c5c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f74a4a8bb7d714418d708f89ceca7392a7989fef6a764e15b8fbf94abe5b7ea.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"儀武ゆう子","creatorId":"vndb:s263","sourcePersonId":"vndb:s263","canonicalEntityId":"vndb:s263","name":"儀武 ゆう子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:274762:141442:4744:1","source":"bangumi"}]},{"characterId":"char_c54722","characterName":"氷雨","sourceIds":{"bangumi":[{"characterId":"141444","match":"exact-normalized-name-in-linked-work","subjectId":"274762"}],"egsCharacterIds":["26246"],"vndbCharacterId":"c54722"},"originalCharacterName":"氷雨","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"里に所属するくノ一で、主に暗殺の任務を担う。"},{"spoiler":false,"text":"忍術、体術ともに抜群の実力を誇る彼女だが、何故か主人公の教室に転入生として編入される。"},{"spoiler":false,"text":"性格は沈着冷静で、感情もあまり表に出さず、上からの命令は絶対***のまさに忍者そのもの。"},{"spoiler":false,"text":"はたして、彼女の目的は……？"}],"source":"egs","sourceCharacterId":"26246","sourceWorkId":"6329","spoiler":false},{"segments":[{"spoiler":false,"text":"里に所属するくのいちで、暗殺任務を担う。"},{"spoiler":false,"text":"何故か主人公の教室に転入生として編入されるが、その実力は完全に他の生徒を凌駕している。"}],"source":"bangumi","sourceCharacterId":"141444"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52dab0e9294d7ac69518dafb8dd90fde8d6378914ca35a4a2ffa04cd14074bb8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a804c11f2426768b613962c3f92b6e3d3fd26f53f7704dd217723d71f958e16.webp","width":213,"height":256,"source":"st