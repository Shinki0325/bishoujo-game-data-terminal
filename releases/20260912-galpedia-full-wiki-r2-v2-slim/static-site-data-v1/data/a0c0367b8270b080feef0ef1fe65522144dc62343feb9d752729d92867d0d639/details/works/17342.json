iler":false},{"segments":[{"spoiler":false,"text":"子供たちの引率で、海へ旅行にやってきた専業主婦。"},{"spoiler":false,"text":"新聞記者と称して話しかけてきた主人公のウソをあっさり見破るも、適当に合わせて手玉に取るなど、茶目っ気たっぷりで大人の余裕を漂わせる女性。"},{"spoiler":false,"text":"ニコニコ微笑んでいたかと思いきや、ふいにズバッと鋭い指摘をしてきたり、油断がならない。"},{"spoiler":false,"text":"「クスッ…もう～、おばさんをからかっちゃダメよ～」"}],"source":"bangumi","sourceCharacterId":"62754"}],"profileFacts":[{"label":"年龄（本版本）","value":"40 岁","valueContext":null,"source":"egs","sourceCharacterId":"5322","sourceWorkId":"17342","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"5322","sourceWorkId":"17342","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"5322","sourceWorkId":"17342","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"5322","sourceWorkId":"17342","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"5322","sourceWorkId":"17342","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"5322","sourceWorkId":"17342","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"63 kg","valueContext":null,"source":"egs","sourceCharacterId":"5322","sourceWorkId":"17342","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b1272949431c193c5f849435feae068b33de3fe0f9da3b6e2cf05f773260810.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e03ce31d1a59f62f0175488b1c50b822def691beb5f9540ae80ca761985aca25.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor"