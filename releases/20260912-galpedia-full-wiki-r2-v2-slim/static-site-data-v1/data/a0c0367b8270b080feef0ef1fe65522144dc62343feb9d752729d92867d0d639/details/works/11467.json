":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"西学二年生。全国規模で企業展開しており国内電工メーカーとして五本の指に入る大手メーカー「熊沢電工」の社長令嬢。"},{"spoiler":false,"text":"胸の大きさも東西学園あわせて五本の指に入る。"},{"spoiler":false,"text":"見た目のおしとやかさに反して、なかなか活発な面も見せる。"}],"source":"egs","sourceCharacterId":"16387","sourceWorkId":"11467","spoiler":false},{"segments":[{"spoiler":false,"text":"西栄峰学園2年の一般学園生。"},{"spoiler":false,"text":"両学園の合同組織であるAGバトル管理委員会に所属している。"},{"spoiler":false,"text":"また国内でも五指に入る電工メーカー・熊沢電工の社長令嬢。"},{"spoiler":false,"text":"かなりの箱入り娘で、基本的にはおっとりとした穏健な性格。ただ、芯が弱いということはなく、時にはそれが行きすぎて感情を爆発させてしまうこともある。"},{"spoiler":false,"text":"なによりも、かわいいものが大好き。彼女にとって最近1番の萌えの対象は、主人公の天野ゆうきだったり。"},{"spoiler":false,"text":"その萌える姿を観察しては、ひとりで和んでいる。"},{"spoiler":false,"text":"バストのサイズは両学園で最高だとのウワサ。"},{"spoiler":false,"text":"「天野くんって、やっぱり萌えるなぁ～」"}],"source":"bangumi","sourceCharacterId":"34602"}],"profileFacts":[{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"16387","sourceWorkId":"11467","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"16387","sourceWorkId":"11467","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"16387","sourceWorkId":"11467","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"16387","sourceWorkId":"11467","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2565f2dcb8eda97be5a811614197edd793d4fa17a573293607fae1d2afda796.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8f98328eaaf45001d7a43c2f7fc6d90b3cb7eaf3c5a0b9c100284c3c7d08272.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"亜城めぐ","cr