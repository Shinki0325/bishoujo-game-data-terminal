s mother."}],"source":"vndb","sourceCharacterId":"c48633"},{"segments":[{"spoiler":false,"text":"「橘才華」（完璧お嬢）の母親。和服美人。両学園の理事長でもある。"},{"spoiler":false,"text":"いつも穏やかに微笑しているが、これでもかという毒舌家。"},{"spoiler":false,"text":"料理の腕は確かだが、どういう趣味なのかグロテスクな素材の使用を好み、周囲を戦慄させている。"}],"source":"egs","sourceCharacterId":"16389","sourceWorkId":"11467","spoiler":false},{"segments":[{"spoiler":false,"text":"東西栄峰学園の理事長。"},{"spoiler":false,"text":"橘グループ社長夫人であり、才華の母親。また、七夏のお師匠さまでもあるらしい。"},{"spoiler":false,"text":"才華と七夏にとっては、まったく頭の上がらない相手である。"},{"spoiler":false,"text":"彼女にとっては、あらゆる行動が道楽であり、一般的な倫理や道徳は、彼女を縛るカセにはまったくならない。"},{"spoiler":false,"text":"底知れない実力を持ちながら、色々な事柄を \"楽しむ\" 以外の目的を持たない存在は、まさにジョーカー。"},{"spoiler":false,"text":"彼女を知る者は、その気まぐれの被害が自分に向かないように天に祈るしかない。"},{"spoiler":false,"text":"「……家に帰ったらお仕置き、ということで」"}],"source":"bangumi","sourceCharacterId":"34601"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"16389","sourceWorkId":"11467","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"166 cm","valueContext":null,"source":"egs","sourceCharacterId":"16389","sourceWorkId":"11467","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"16389","sourceWorkId":"11467","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"16389","sourceWorkId":"11467","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c54ea4775bfc4d088dfcb07e3cd6e481411f61a4caaccfdf0da745d724087f85.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/9199bde93906f9b06349bb81fb9b53e0350f3b4f094f450f5da213907f89747d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高田初美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363",