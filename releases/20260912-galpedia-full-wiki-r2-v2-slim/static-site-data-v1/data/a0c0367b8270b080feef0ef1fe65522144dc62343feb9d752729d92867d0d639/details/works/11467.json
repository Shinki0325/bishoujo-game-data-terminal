:"二千年の歴史を持つ古武術・薙島錘刈（つむがり）流の次期継承者であり、すでに皆伝を得ている。その破壊力は、蹴りでコンクリート塀を砕くほど。"},{"spoiler":false,"text":"男子相手でも敵はない『不敗の武道士』。"},{"spoiler":false,"text":"武道家としての面以外にも、家事全般をこなせたりスタイルも良かったりと、女性らしいところは女性らしい。"},{"spoiler":false,"text":"機械の類は苦手で、実家の薙島家では何十年モノの古い家電を使い続けているらしい。"},{"spoiler":false,"text":"携帯電話やパソコンなどは、もはや彼女にとって異文明の産物。"},{"spoiler":false,"text":"「常勝無敗、我に敵なし！」"}],"source":"bangumi","sourceCharacterId":"34595"}],"profileFacts":[{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"16382","sourceWorkId":"11467","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"16382","sourceWorkId":"11467","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"16382","sourceWorkId":"11467","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"16382","sourceWorkId":"11467","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"55 kg","valueContext":null,"source":"egs","sourceCharacterId":"16382","sourceWorkId":"11467","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c18d0f1282da19cba5041d3b64e484107d6ba4f8f245d53de19a1d915cc476df.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2e240fef164cc4e69b917452215e03eabd027a04f5ba6400c3b3b87f91576b3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林桂子","creatorId":"vndb:s443","sourcePersonId":"vndb:s443","canonicalEntityId":"vndb:s443","name":"美月(声優)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15738:34595:16180:1","source":"bangumi"}]},{"characterId":"char_c48628","characterName":"光原 零子","sourceIds":{"bangumi":[{"characterId":"34597"