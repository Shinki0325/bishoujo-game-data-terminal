12","source":"vndb"},{"creditedName":"しきがみあずま","creatorId":"vndb:s37698","sourcePersonId":"vndb:s37698","canonicalEntityId":"vndb:s37698","name":"しきがみあずま","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:50413","source":"vndb"},{"creditedName":"ふくぽん","creatorId":"vndb:s37700","sourcePersonId":"vndb:s37700","canonicalEntityId":"vndb:s37700","name":"ふくぽん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:50414","source":"vndb"},{"creditedName":"ノディ！","creatorId":"vndb:s37703","sourcePersonId":"vndb:s37703","canonicalEntityId":"vndb:s37703","name":"ノディ！","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:50415","source":"vndb"},{"creditedName":"しげ","creatorId":"vndb:s37705","sourcePersonId":"vndb:s37705","canonicalEntityId":"vndb:s37705","name":"しげ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:50416","source":"vndb"},{"creditedName":"三重紙","creatorId":"vndb:s37815","sourcePersonId":"vndb:s37815","canonicalEntityId":"vndb:s37815","name":"三重紙","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:50417","source":"vndb"},{"creditedName":"MACKY","creatorId":"vndb:s42254","sourcePersonId":"vndb:s42254","canonicalEntityId":"vndb:s42254","name":"MACKY","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:50418","source":"vndb"},{"creditedName":"えびちり","creatorId":"vndb:s9157","sourcePersonId":"vndb:s9157","canonicalEntityId":"vndb:s9157","name":"えび ちり","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:50419","source":"vndb"}]},"cast":[{"characterId":"char_c57068","characterName":"ヒューバート・リプトン","sourceIds":{"bangumi":[{"characterId":"36857","match":"exact-normalized-name-in-linked-work","subjectId":"88739"}],"egsCharacterIds":["3285"],"vndbCharacterId":"c57068"},"originalCharacterName":"ヒューバート・リプトン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"GI988年10月10日"},"height":{"reviewState":"no-conflict","source":"vndb","value":"197"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"92"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hubert Lipton is the former Lieutenant General of the Helman Second Army, the son of Thoma Lipton, one of the strongest humans to have ever lived, and the best friend and trusted right hand of Patton Misnarge."},{"spoiler":false,"text":"From AliceSoft Wiki"}],"source":"vndb","sourceCharacterId":"c57068"},{"segments":[{"spoiler":false,"text":"パットンの幼馴染、元ヘルマン軍人。"},{"spoiler":false,"text":"生前から現在も「世界最強」と名高い前ヘルマン第３軍将軍、トーマ・リプトンを父に持つ。"},{"spoiler":false,"text":"幼い頃に父によって引き合わされて以来パットンの親友。"},{"spoiler":false,"text":"パットン失脚後の遺跡探索任務からハンティに連れ出されて離脱し、潜伏中のパットンと再会。"},{"spoiler":false,"text":"以降、本国では戦死したと思われているのを利用して、パットンとともに革命の準備を続けてきた。"},{"spoiler":false,"text":"父を倒したのがランスだということは既にパットンから聞いて知っているが、戦いに生きた父は満足だっただろうと理解しているので、ランスを恨む気持ちはない。"},{"spoiler":false,"text":"今回は付け髭とJAPANの鎧で変装中。"}],"source":"egs","sourceCharacterId":"3285","sourceWorkId":"19702","spoiler":false},{"segments":[{"spoiler":false,"text":"パットンの教育係だったトーマ・リプトンの息子で、パットンの幼馴染であり無二の親友。フリークの依頼でデンズと共に調査隊に入りユプシロンに侵入するがゴルチの暴走によりデンズを失う。デンズの仇討ちを行おうとするが闘将に歯がたたず、命からがらフリークと共にハンティに救出された。"},{"spoiler":false,"text":"幼少の頃から剣の才能を発揮し、11歳でヘルマン軍の正規兵試験に当時の最年少記録で合格。「数百年に1人の天才児」と将来を嘱望されるが、成長するにつれ「最強にしてヘルマンを代表する武人トーマ」という偉大な父親への反発から、一時期は全てに身が入らなくなり、自由な生き方に憧れるようになる。恐らく正伝と思われる「にせなぐりまくりたわぁ」ではトーマの必殺技も披露しているのが時より議論の的となっている（ヒューバートの剣LVは1であり、本来必殺技は放てない）。"}],"source":"bangumi","sourceCharacterId":"36857"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/504cec5790036e21989e1330de827f0bd4000ef0c46e967402c7a38b1e38b47a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/858eb323db74bcb0dcdf343c03305d1a4935f1cd113ef091f9138670106d8453.webp","width":225,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c155298","characterName":"Mars the great","sourceIds":{"vndbCharacterId":"c155298"},"originalCharacterName":"Mars the great","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mars the Great makes a guest appearance in the Alicesoft game Persiom as an adventurer exploring the depths of the Hades Labyrinth that can randomly be encountered upon entering the labyrinth's entrance hall. He is notable for being one of the only guest characters that can be encountered by every playable character, including the Miracle Gang, and will reward the player with the morning star weapon when he is encountered after they have advanced farther into the labyrinth than him. His title on the adventurer ranking board is listed as \"Fabulous\"."}],"source":"vndb","sourceCharacterId":"c155298"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/5263112b44a74a5a15fe541b26bf0de5d1eb97a449113600153d60a50a8b0269.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b02ab5a46c8f83401ab6ef75791bba5a799ee955c2b30631c283fdf4b0ce940.webp","width":256,"height":192,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c79863","characterName":"ディカキス・ド・フック","sourceIds":{"vndbCharacterId":"c79863"},"originalCharacterName":"ディカキス・ド・フック","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"29"},"height":{"reviewState":"source-only","source":"vndb","value":"195"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"98"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/1716e9be68db96f1a236106a349c98b67f97380e803858bb3a31ed0fd1ee4199.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c453160124735759edb0ee685ae20d1739cc3ecb5838dc9df48f045f304f3133.webp","width":168,"height":188,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c79865","characterName":"プルーペット","sourceIds":{"vndbCharacterId":"c79865"},"originalCharacterName":"プルーペット","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"38"},"height":{"reviewState":"source-only","source":"vndb","value":"100"},"weight":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Pluepet is a talented merchant born in the free city of Portugal in GI980. He travels to all sorts of places as a travelling merchant selling rare goods. He appeared in most Rance games after the 4.x games, and also made appearances in Toushin Toshi games."},{"spoiler":false,"text":"He's a strange green creature that travels around in something that resembles a spaceship. His race is unknown but he's probably some rare type of monster. Personality-wise, he's a businessman. He's a very skilled and clever individual that knows how to trade, but he's also very cruel and cold, showing no interest in everything outside of selling his goods and making money. He completely lacks morality and will do whatever he considers will bring the best earning, regardless if it's selling drugs, slaves or innocent girls as prostitutes. He simply sees everything around him as a means to trade and increase profits, and is perfectly fine with helping people as well if he thinks it will be profitable."},{"spoiler":false,"text":"From AliceSoft Wiki"}],"source":"vndb","sourceCharacterId":"c79865"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06a15c79da4cce227d6ae2e0ff9a61ee952e42f6d72d88df2d282b206afcfb8c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c62b9d1ba5718363eb0fe6bae612763b447b30544aa6903401cd66fc2a8d4b5a.webp","width":168,"height":188,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p120","sourceCompanyId":"egs:brand:30","canonicalEntityId":"vndb:p120","name":"ALICESOFT","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:676:30","source":"egs"},{"companyId":"vndb:p120","sourceCompanyId":"vndb:p120","canonicalEntityId":"vndb:p120","name":"アリスソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:10115:v4477","source":"vndb"},{"companyId":"vndb:p120","sourceCompanyId":"vndb:p120","canonicalEntityId":"vndb:p120","name":"アリスソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:10116:v4477","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
