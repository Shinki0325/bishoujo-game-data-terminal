cts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eae84b7c99c3466236b3167bb13abe96d71ded82e246cd391b3c5ba8c4884f3e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd55db6cdc4c7d6e869f373e978add38699b39bccb477e506b29cc72f3c5e92a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"片倉 ひな","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:101750","source":"vndb"}]},{"characterId":"char_c56519","characterName":"ノル","sourceIds":{"bangumi":[{"characterId":"50256","match":"exact-normalized-name-in-linked-work","subjectId":"207176"}],"egsCharacterIds":["16412"],"vndbCharacterId":"c56519"},"originalCharacterName":"ノル","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"71.5"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AA"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"While she looks like a child, she is an elder elf and the oldest (also leader) of the elf clan."},{"spoiler":false,"text":"With the help of ancient documents of the great elders she summons the protagonist to her world."},{"spoiler":true,"text":"184014 years old."},{"spoiler":true,"text":"Her true name is Norn Alfheim."}],"source":"vndb","sourceCharacterId":"c56519"},{"segments":[{"spoiler":false,"text":"エルフ族の長老だが見た目は子供なエルダーエルフ。"},{"spoiler":false,"text":"生きる古文書とも言われている、エルフの村の大長老で主人公を異世界から召喚した人物でもある。"}],"source":"egs","sourceCharacterId":"16412","sourceWorkId":"24614","spoiler":false},{"segments":[{"spoiler":false,"text":"エルフ族の長老だが見た目は子供なエルダーエルフ。"},{"spoiler":false,"text":"生きる古文書とも言われている大長老で、主人公を異世界から召喚した人物でもある。"},{"spoiler":false,"text":"「やれやれ。困ったやつらなのじゃ。 争いよりも大切なことがあるじゃろう。 たとえば、種付け……とかな♪」"}],"source":"bangumi","sourceCharacterId":"50256"}],"profileFacts":[],"metadataCandidateConflicts":{"bust":[{"comparisonValue":"71","source":"vndb","sourceCharacterId":"c56519","value":"71"},{"comparisonValue":"71.5","scope":"sourceWork","source":"egs","sourceCharacterId":"16412","sourceWorkId":"24614","value":"71.5"},{"comparisonValue":"71.5","source":"bangumi","sourceCharacterId":"50256","value":"71.5"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c052d95ae1b9caf6a3a513d08112e132785978960a44717f2de8472d4e899a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95cb7d58d96b0e43611f24c44b9f58bde31df9fb9e97c64a2d669177de7fd36e.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c56522","characterName":"ミズリィ・ステントレーム","sourceIds":{"bangumi":[{"characterId":"50259","match":"exact-normalized-name-in-linked-work","subjectId":"207176"}],"egsCharacterIds":["16415"],"vndbCharacterId":"c56522"},"originalCharacterName":"ミズリィ・ステントレーム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"120"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"L"},"height":{"reviewState":"no-conflict","source":"vndb","value":"169"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A wicked witch and matriarch of the dark elves, she serves as their advisor and is a woman of few words."},{"spoiler":false,"text":"Despite how she may look and dress – she is virgin. She falls madly in love with the protagonist at first sight."},{"spoiler":true,"text":"2546 years old."}],"source":"vndb","sourceCharacterId":"c56522"},{"segments":[{"spoiler":false,"text":"ダークエルフ族の族長で邪悪な魔法使い。"},{"spoiler":false,"text":"ダークエルフ族のご意見番ポジションで、普段は寡黙で思慮深く言葉少なに話す。"},{"spoiler":false,"text":"いやらしい服装と肉体のせいで勘違いされるが、処女であり、初めての男である主人公にベタ惚れしてしまう。"}],"source":"egs","sourceCharacterId":"16415","sourceWorkId":"24614","spoiler":false},{"segments":[{"spoiler":false,"text":"ダークエルフ族の族長で、邪悪な魔法使い。"},{"spoiler":false,"text":"ダークエルフ属のご意見番であり、普段は寡黙で思慮深く言葉少なに話す。"},{"spoiler":false,"text":"いやらしい服装と肉体のせいで勘違いされるが処女であり、初めての男である主人公にベタ惚れしてしまう。"},{"spoiler":false,"text":"「だめぇ～。あなたの臭いを嗅いでいるだけで、もうアソコがびちゃびちゃなのぉ。 今夜も私のことをイかせまくってぇ……♪」"}],"source":"bangumi","sourceCharacterId":"50259"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/300ef5bde267dba1ca92af7f162d8d1af18d6624dad94c0dd9f5dad25fc1bb6a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/daca79eef0dd1146c84b07f168e30ba472f34010dfa560015eba6cd94860c35d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長原 杏子","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:101751","source":"vndb"}]},{"characterId":"char_vndb_c67214","characterName":"伊藤 祐一","sourceIds":{"vndbCharacterId":"c67214"},"originalCharacterName":"伊藤 祐一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A regular Japanese young man, Yuuichi was aimlessly carousing around the streets wondering when his luck would change, hoping to a score girlfriend soon; when suddenly a strange-looking young girl appeared in front of him, Yuuchi thought the girl was a cosplayer or something, the way she was dressed, but Yuuichi has no time to think any further as he spirited away to a completely different world."},{"spoiler":false,"text":"After a few mishaps Yuuichi is captured by what appears to be elves, the strange girl that spirited him away introduces herself as the elder Nol, who explains to Yuuichi their female-only populace is diminishing, their Holy Tree which once gave them elven offspring is weakening and can no longer produce new children; so Nol proposes Yuuichi conceive more elves with the women of their village, Yuuichi accepts if Nol takes him back to his world."},{"spoiler":true,"text":"Yuuichi soon becomes another point of contest in the war between Elfs and Dark Elfs, as the first sexual contact with a male awakens the libido those elves never had prior in their very long lives, and it is proven his semen can also fill up their magical reserves, so each side wants to keep Yuuichi only for themselves; however, Yuuichi's surprisingly kind and selfless nature is what wins the elves over, often disarming their willingness to fight each other, thus they eventually procreate out of sincere love."}],"source":"vndb","sourceCharacterId":"c67214"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a31734cfa43c1e6fca5868ec6f20a2fce2cf594bc7623fd5e4da71ecec3ab3cf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/753d9dae3a6ed670d444ef16ca4c1cebe417cdcbb56f6daa650d5f4be4932207.webp","width":152,"height":195,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p490","sourceCompanyId":"egs:brand:328","canon