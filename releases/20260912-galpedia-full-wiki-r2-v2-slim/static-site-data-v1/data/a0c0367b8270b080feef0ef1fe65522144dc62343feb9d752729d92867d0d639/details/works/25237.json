reatorId":"vndb:s7769","sourcePersonId":"egs:creator:20486","canonicalEntityId":"vndb:s7769","name":"松下紗知","detail":"原作、世界観設定、監督","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:186447","source":"egs"},{"creditedName":"咲良ゆの(冬乃桜)","creatorId":"vndb:s12797","sourcePersonId":"egs:creator:23126","canonicalEntityId":"vndb:s12797","name":"咲良ゆの(冬乃桜)","detail":"OP曲「SHiNING!D-BLΛDE」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:197639","source":"egs"},{"creditedName":"松下 紗知","creatorId":"vndb:s7769","sourcePersonId":"vndb:s7769","canonicalEntityId":"vndb:s7769","name":"松下 紗知","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:139993","source":"vndb"},{"creditedName":"松下 紗知","creatorId":"vndb:s7769","sourcePersonId":"vndb:s7769","canonicalEntityId":"vndb:s7769","name":"松下 紗知","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:139994","source":"vndb"},{"creditedName":"maruhi","creatorId":"vndb:s10411","sourcePersonId":"vndb:s10411","canonicalEntityId":"vndb:s10411","name":"maruhi","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:139995","source":"vndb"},{"creditedName":"桜楽 サラ","creatorId":"vndb:s10917","sourcePersonId":"vndb:s10917","canonicalEntityId":"vndb:s10917","name":"桜楽 サラ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:139996","source":"vndb"},{"creditedName":"冬乃 桜","creatorId":"vndb:s12797","sourcePersonId":"vndb:s12797","canonicalEntityId":"vndb:s12797","name":"冬乃 桜","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:139998","source":"vndb"},{"creditedName":"さんちゅ～","creatorId":"vndb:s51124","sourcePersonId":"vndb:s51124","canonicalEntityId":"vndb:s51124","name":"さんちゅ～","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:140002","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c61787","characterName":"アスカ・ノア","sourceIds":{"vndbCharacterId":"c61787"},"originalCharacterName":"アスカ・ノア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An energetic and cheerful girl who has won the Dolphin Blade student championships over two consecutive years. She has a mischievous streak and won't hesitate to tease members of the opposite sex."},{"spoiler":false,"text":"With her looks, physique and talent she could walk into any Blader team of her choice, but she deliberately chose to sign up with a weak team on the verge of disbandment because she loves the sport and wants to continue enjoying it on her own terms. Asuka understands the allure of professional female Dolphin Bladers and enthusiastically participates in races and fan events without hesitation."},{"spoiler":false,"text":"Surprisingly for someone with an outgoing and active personality, she spends a lot of her free time playing video games or going to the gaming arcade to play the dancing games."}],"source":"vndb","sourceCharacterId":"c61787"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a7cd646546292d8125090b686097ffdef4de80b1ec516b51502ef41cd10afeb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/494ced7ff05e232e7d569cbe29c49a6e85451bdca1e607941d2263e47a70bc6c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結城 ほのか","creatorId":"vndb:s6018","sourcePersonId":"vndb:s6018","canonicalEntityId":"vndb:s6018","name":"結城 ほのか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74044","source":"vndb"}]},{"characterId":"char_vndb_c61788","characterName":"リィル・アシュレイ","sourceIds":{"vndbCharacterId":"c61788"},"originalCharacterName":"リィル・アシュレイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Blader's Blader whose mother was also a well-known Blader in her own right. She dislikes being treated as an idol by the Dolphin Blade team. Although she quit the team in protest at the team's decision to market her as an idol rather than as a racing athlete, her situation at the start of the game hasn't really changed in actuality."},{"spoiler":false,"text":"Although she's loath to admit it, she loves ice cream and collecting stuffed toys, traits typically considered normal for girls her age."},{"spoiler":false,"text":"Her dedication to the racing cause frequently leads her to push her body beyond its limits, forcing her to stop practice to allow her to recover."}],"source":"vndb","sourceCharacterId":"c61788"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84fb8c963ca13f70e75c35cc0ee180685ba2d8582d553b5a062fa48dee259740.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2e69fc047ef925934860fa5259a295edea56b02a563bd8e811e216b5d76e36c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"葵 ゆり","creatorId":"vndb:s1748","sourcePersonId":"vndb:s1748","canonicalEntityId":"vndb:s1748","name":"葵 ゆり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74043","source":"vndb"}]},{"characterId":"char_vndb_c61789","characterName":"千江寺 羽衣","sourceIds":{"vndbCharacterId":"c61789"},"originalCharacterName":"千江寺 羽衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The granddaughter of the former owner of the Dolphin Blade team, she has been in contact with the sport from a very young age. She is very organised and is in charge of some administrative duties as well as the welfare of her fellow teammates. Prior to pursuing the Dolphin Blade sport professionally, she played a lot of tennis (albeit most of the time alone against the serve machine)."},{"spoiler":false,"text":"Because she was chased around by a dog when she was young, she remains terrified of dogs regardless of their size and will freeze in abject terror when she sights one approaching her."},{"spoiler":false,"text":"Arguably the best cook amongst the five girls."}],"source":"vndb","sourceCharacterId":"c61789"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d8f31622ba2bda9781eea13e929af88f2c8189e5d5712c0a389566711210065.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b674a22dcbbe42884136b52821d122d3a946f6de2bdfa7cf65d67848b986cc8.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"秋野 花","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74042","source":"vndb"}]},{"characterId":"char_vndb_c61790","characterName":"詩乃霧 音羽","sourceIds":{"vndbCharacterId":"c61790"},"originalCharacterName":"詩乃霧 音羽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Previously a shut-in NEET. Otoha was interested in Dolphin Blade not as a sport but in the technology behind the motorised floating shoes. This interest led to her hacking into the team database and carelessly destroying its data. Otoha is now a team-member partly to pay back the debt she incurred for the damages (what really happened was Otoha's older sister paying the debt and encouraging the debt angle in hopes of curing Otoha from her NEET lifestyle)"},{"spoiler":false,"text":"Otoha is well-versed in the technology behind the float shoes and exploits this to compensate for her technical deficiencies as a racing athlete."},{"spoiler":false,"text":"She loves taking saunas. Although mostly cured of her previous shut-in lifestyle, she dislikes spending her free time outdoors and prefers to laze around her room in her free time or working part-time as a waitress in the team cafeteria. Her interest in technology extends to a fascination with retro personal computers."}],"source":"vndb","sourceCharacterId":"c61790"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a11772516aa1f6a5f18db3639ba437722adc84aa83f500662ea2728c8f2e1af2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a3b792d2e5c6d27811d6f8a3ba3619e7460eb6a2a7fed757f0c78a40177372e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水野 七海","creatorId":"vndb:s2524","sourcePersonId":"vndb:s2524","canonicalEntityId":"vndb:s2524","name":"星野七海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74045","source":"vndb"}]},{"characterId":"char_vndb_c61791","characterName":"テテ・ディンガ","sourceIds":{"vndbCharacterId":"c61791"},"originalCharacterName":"テテ・ディンガ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The dark-skinned member of the Dinga ethnic minority. This ethnic group prizes victory above everything else despite its peaceful nature, which is why Tete hates to lose."},{"spoiler":false,"text":"Originally a stowaway who left her village and ended up on Yamato island, she challenged a Dolphin Blade athlete to a contest of speed and lost (not surprising since she was swimming while the athlete was using the standard equipment). Unable to accept defeat, she has forced her way into the Dolphin Blade team and refuses to return home to her village until she is victorious in the sport."},{"spoiler":false,"text":"A victim of severe culture shock when she first arrives in Yamato island."}],"source":"vndb","sourceCharacterId":"c61791"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4a0dcb872639afbe24c54f015495e44cae245ab470fc70211c22240f630fcdd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f87ffe8327c70f6374ceb02c3c62981ad58e8565ed8a33571ed2cdf5b9d14e41.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安 ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74041","source":"vndb"}]},{"characterId":"char_vndb_c64666","characterName":"コウスケ","sourceIds":{"vndbCharacterId":"c64666"},"originalCharacterName":"コウスケ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The newly appointed manager of the Dolphin Blade team which has fallen on hard times and is heavily in debt. Having lost his previous position at Aihara Electronics as well as his girlfriend who dumped him after realising he was no longer financially attractive, he has to prove his worth as a manager by paying back the team's debt over set intervals or face the sack."},{"spoiler":false,"text":"He has no experience whatsoever at managing a sports team and had hitherto little contact with the sport prior to his demotion. On the other hand he is a native of the island where the Dolphin Blade races are widely followed and is determined to learn the ropes quickly in hopes of reclaiming his old position."}],"source":"vndb","sourceCharacterId":"c64666"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p6842","sourceCompanyId":"egs:brand:5424","canonicalEntityId":"vndb:p6842","name":"Island Belle","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:25237:5424","source":"egs"},{"companyId":"vndb:p6842","sourceCompanyId":"vndb:p6842","canonicalEntityId":"vndb:p6842","name":"Island Belle","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:58582:v21144","source":"vndb"},{"companyId":"vndb:p27893","sourceCompanyId":"vndb:p27893","canonicalEntityId":"vndb:p27893","name":"Project L.A","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:58583:v21144","source":"vndb"},{"companyId":"vndb:p6842","sourceCompanyId":"vndb:p6842","canonicalEntityId":"vndb:p6842","name":"Island Belle","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:60595:v21144","source":"vndb"},{"companyId":"vndb:p27893","sourceCompanyId":"vndb:p27893","canonicalEntityId":"vndb:p27893","name":"Project L.A","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:60596:v21144","source":"vndb"},{"companyId":"vndb:p6842","sourceCompanyId":"vndb:p6842","canonicalEntityId":"vndb:p6842","name":"Island Belle","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:84911:v21144","source":"vndb"},{"companyId":"vndb:p27893","sourceCompanyId":"vndb:p27893","canonicalEntityId":"vndb:p27893","name":"Project L.A","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:84912:v21144","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
