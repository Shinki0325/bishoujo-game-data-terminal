:"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Don't worry, a noisy little hedgehog like you is the last thing I want.\""},{"spoiler":false,"text":"The protagonist of this story."},{"spoiler":false,"text":"A heavy smoker with a cynical attitude, he’s a university student in Tokyo, belonging to the folklore studies department. Raised by adoptive parents, he’s been told that he once stayed at the main Kuraki family household as a child, though he remembers almost nothing of that time. He suffers from a mysterious condition that prevents him from recognizing women's faces, and he is plagued by strange nightmares."},{"spoiler":false,"text":"From the official site."}],"source":"vndb","sourceCharacterId":"c155612"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/7813191d0125bda6294856f213f801a3203d298d8f46702531d7ffc27454067c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6d0b5b709d8155ce99554c4e13787ef20d2a79a1af18f6cd77386f67e0df77b.webp","width":205,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c155613","characterName":"倉木 鈴菜","sourceIds":{"vndbCharacterId":"c155613"},"originalCharacterName":"倉木 鈴菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"You should just hurry up and get kicked out already!\""},{"spoiler":false,"text":"The only daughter of the Kuraki family."},{"spoiler":false,"text":"She has inherited the role of the \"Tsukimachi no Miko\" (Moon-Waiting Priestess), passed down through generations. Raised with great care, she's a strong-willed young lady, but also somewhat naive about the world. She refuses to acknowledge Koichi as the new head of the family and often behaves in a rebellious and confrontational manner."},{"spoiler":false,"text":"From the official site."}],"source":"vndb","sourceCharacterId":"c155613"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e259b3581540ff1cd6526e85d2ce3b312bdc6d2508f5dc80d9df01b2425e14d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92c450affaa74fdf0317948372628ec01eab34d75e399650a1ccff374e20d2a2.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏野 ぱいん","creatorId":"vndb:s32998","sourcePersonId":"vndb:s32998","canonicalEntityId":"vndb:s32998","name":"夏野 ぱいん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97576","source":"vndb"}]},{"characterId":"char_vndb_c155614","characterName":"春川 知美","sourceIds":{"vndbCharacterId":"c155614"},"originalCharacterName":"春川 知美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Oh no, taking care of the master is only natural...\""},{"spoiler":false,"text":"A servant of the Kuraki family."},{"spoiler":false,"text":"She has a gentle and introverted personality. Though her responses are often soft and elusive, she performs her duties flawlessly and finds her greatest joy in serving others and making them happy. With no family of her own, she was raised as an adopted daughter by Ippei Harukawa, the Kuraki family’s physician."},{"spoiler":false,"text":"From the official site."}],"source":"vndb","sourceCharacterId":"c155614"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/985438b648438284ae8ab1f89b77c7571b9c60498c220435f871ceb9c6e8f669.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55ac505776306e51db2193879365e3c1caaf760652defae3f5847df89188bed4.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"遠野 そよぎ","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97565","source":"vndb"}]},{"characterId":"char_vndb_c155615","characterName":"栗原 沙也加","sourceIds":{"vndbCharacterId":"c155615"},"originalCharacterName":"栗原 沙也加","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Oho~! Using your authority as the head of the family already, are we~?\""},{"spoiler":false,"text":"A servant of the Kuraki family."},{"spoiler":false,"text":"Cheerful, outspoken, and friendly, she’s a mood-maker who interacts with Koichi in a casual, easygoing manner. It’s said that her appearance closely resembles that of a once-famous actress who mysteriously disappeared—but..."},{"spoiler":false,"text":"From the official site."}],"source":"vndb","sourceCharacterId":"c155615"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a334a9a0304a880233b20664cdbd560068480486f8caf84be052978fd452fa5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea15ab9765cc035b8ca45fe222861246c6d7e1b47c6167001de641fa29ee2191.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"東 シヅ","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97574","source":"vndb"}]},{"characterId":"char_vndb_c155620","characterName":"東　衣緒","sourceIds":{"vndbCharacterId":"c155620"},"originalCharacterName":"東　衣緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Harukawa-san... um... I was just wondering what kind of person she likes...\""},{"spoiler":false,"text":"Suzuna’s childhood friend."},{"spoiler":false,"text":"A sincere and honest boy, so slender and delicate in appearance that he could easily be mistaken for a girl. Scholarly by nature, he has an interest in folklore and has been staying at the Kuraki household for the past few days in a student-like position. He harbors a quiet affection for Tomomi Harukawa, one of the household’s servants."},{"spoiler":false,"text":"From the official site."}],"source":"vndb","sourceCharacterId":"c155620"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55689b8755f9b9de13c142c840fa9fa2f4eef41efb13d93b6e8967ef21c30750.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6b10a2ca12e1fce747affa2faf92e54d6fbf7561d05b469ace28ee652ddce27.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐山 森","creatorId":"vndb:s882","sourcePersonId":"vndb:s882","canonicalEntityId":"vndb:s882","name":"松元 惠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97569","source":"vndb"}]},{"characterId":"char_vndb_c155622","characterName":"倉木 由利子","sourceIds":{"vndbCharacterId":"c155622"},"originalCharacterName":"倉木 由利子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“—So then, Koichi-san, have you made up your mind?”"},{"spoiler":false,"text":"The one who oversees the Kuraki household and Suzuna’s mother."},{"spoiler":false,"text":"Usually graceful and strict with an air of allure, she can at times act with a gentle, maternal warmth—as if she were an entirely different person. A woman difficult to pin down. She strongly desires for Koichi to become the head of the Kuraki family."},{"spoiler":false,"text":"From the official site."}],"source":"vndb","sourceCharacterId":"c155622"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/644e8bd08f3c6d0b744161866bc35b7cbf57c4979b49eab525d31a841ff7035b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61a4e770cb53bf33812a0bcef72f6f264e49a3fc07f11f7e125909839637f19d.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一色 ヒカル","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97564","source":"vndb"}]},{"characterId":"char_vndb_c155623","characterName":"沢口 千賀子","sourceIds":{"vndbCharacterId":"c155623"},"originalCharacterName":"沢口 千賀子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I thought I warned you—learn to judge women better.\""},{"spoiler":false,"text":"Koichi’s ex-girlfriend, though they still remain on friendly terms."},{"spoiler":false,"text":"She currently works as Professor Motoyama’s assistant and is part of the same seminar."},{"spoiler":false,"text":"Though she often speaks in a cool and detached manner, she isn’t truly cold-hearted."},{"spoiler":false,"text":"Even in summer, she habitually wears black leather gloves."},{"spoiler":false,"text":"From the official site."}],"source":"vndb","sourceCharacterId":"c155623"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52bc9b9c5a9696001901c1b60136c92770ff3341f397a4d1b48865a670b8a7d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aea07796122ca761d3f0349e44d10ad9ed75482c86b575d0a4411a26f623563e.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"谷口 ケイ","creatorId":"vndb:s7969","sourcePersonId":"vndb:s7969","canonicalEntityId":"vndb:s7969","name":"矢口 アサミ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97571","source":"vndb"}]},{"characterId":"char_vndb_c159439","characterName":"本山晋吾","sourceIds":{"vndbCharacterId":"c159439"},"originalCharacterName":"本山晋吾","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31e1bbf7ab41b5d70898726a3468d66b637e369038f00b69d550a636b62c00ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3c1efc14e71d0fe253d7ed6dd76a67faedfe6707d35ea89512c371b8642e280.webp","width":201,"height":256,"source":"static-detail"},"actors":[{"creditedName":"六本木 天人","creatorId":"vndb:s21652","sourcePersonId":"vndb:s21652","canonicalEntityId":"vndb:s21652","name":"六本木天人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97575","source":"vndb"}]},{"characterId":"ch