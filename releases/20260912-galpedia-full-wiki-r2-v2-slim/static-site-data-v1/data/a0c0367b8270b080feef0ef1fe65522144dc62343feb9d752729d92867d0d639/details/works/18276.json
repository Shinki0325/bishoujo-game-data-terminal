oice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:64719:50290:5741:1","source":"bangumi"}]},{"characterId":"char_c17131","characterName":"葛城 真人","sourceIds":{"bangumi":[{"characterId":"20178","match":"exact-normalized-name-in-linked-work","subjectId":"64719"}],"egsCharacterIds":["300"],"vndbCharacterId":"c17131"},"originalCharacterName":"葛城 真人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Masato is Ria's older brother and Hisui's childhood friend, his little \"Hime-chan\". He left the city with his parents and his sister a few years ago, promising Hisui that they would one day reach Arcadia together and promising him that he would come back for her when he grew up."},{"spoiler":false,"text":"The years passed and Masato and his family returned to town. But Hisui seems to have forgotten it or she is simply ignoring it. Her character has now become cold to everyone and she no longer seems to like Ria at all. Having joined the Sleipnir Academy, Masato now aspires to master AD technology, but..."}],"source":"vndb","sourceCharacterId":"c17131"},{"segments":[{"spoiler":false,"text":"本編の主人公。"},{"spoiler":false,"text":"学業は学年トップだが、AD実技の成績が極度に悪いため、いつも落第寸前。"},{"spoiler":false,"text":"頭でっかちのひょろひょろもやしなど不名誉なあだ名を付けられているが、“特別試験” で一発逆転の落第脱出を狙っている。"}],"source":"bangumi","sourceCharacterId":"20178"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4e4694e484d437e1a1b847efcaf50e943d44d3f68c3b25c1f9b5a7b52e82cfa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc107b7dad0d941d9e4bbef0b05769003662e22fadba660a1761de3cf401a9d6.webp","width":189,"height":256,"source":"static-detail"},"actors":[]},{"characterId"