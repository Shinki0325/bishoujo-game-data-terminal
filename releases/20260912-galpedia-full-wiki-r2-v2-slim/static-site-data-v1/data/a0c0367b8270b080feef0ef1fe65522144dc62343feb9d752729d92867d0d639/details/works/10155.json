ndbCharacterId":"c11612"},"originalCharacterName":"長瀬 準一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"331"},"height":{"reviewState":"source-only","source":"vndb","value":"184"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Jun'ichi is a second year high school student and had a quarrel with a transfer student, Yuuhi Katagiri on the first day of school. It turns out that Yuuhi is his fiancée as arranged by his family. He had a reputation of a delinquent in junior high school until his sister Minato decided to move in with him. He has a snarky attitude and is often teased by everyone around him, including his teacher. His life takes a drastic turn with Yuuhi entering his life. When he first met her he had the impression she was a helpless girl and kissed her because of a misunderstanding. After that, Yuuhi becomes much more violent towards Jun'ichi. Since Yuuhi is often harassed, he finds himself protecting her; as time progresses, their love for each other grows, even though neither of them will admit it."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c11612"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c510c2e5dfbb6a979b8772e59b0f3fda1ff5a4f8a87a35ec9b74170f26da3781.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44dd4245ef8f14c6d4af79947c18e8d74fec69b2b529aa69c1b09aa7c73c6e80.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c11613","characterName":"長瀬 湊","sourceIds":{"vndbCharacterId":"c11613"},"originalCharacterName":"長瀬 湊","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"502"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"C"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is Jun`ichi's younger sister."},{"spoiler":false,"text":"She is a year younger than he is and attends the same school that he does as a first year high school student. She is capable in all areas of household related work and is proud of it. She also has unique abilities, like listening to the ground to detect the presence of animals, as well as be able to communicate with them. She has feelings for Jun'ichi. She mentions that she was an adopted sister once, but later says it was a joke. Minato is blood-related to Jun'ichi in the PC game, in the PS2 version she is not related to him, and it is implied that she is not blood-related to Jun'ichi in the anime."},{"spoiler":false,"text":"She's a friend of Yocchan. In Hoshizora e Kakaru Hashi she visits Yamabiko with her."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c11613"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/7145d6591701360f2d4a1dc85777ab1e525ffe5088bc194b80c96c1468d74dcf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/bad06431656c461765d1e58c358c28474f4082c8a122caa1ea4f3014a9faa74a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水沢 光","creatorId":"vndb:s240","sourcePersonId":"vndb:s240","canonicalEntityId":"vndb:s240","name":"今井 麻美","roleCode":"voice-ac