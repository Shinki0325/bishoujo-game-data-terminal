{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"19917","model":{"presentationWorkId":"vndb:v14575","staff":{"artwork":[{"creditedName":"オギンバラ(オギン★バラ、オギン☆バラ)","creatorId":"vndb:s3933","sourcePersonId":"egs:creator:17800","canonicalEntityId":"vndb:s3933","name":"オギンバラ(オギン★バラ、オギン☆バラ)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:127590","source":"egs"}],"scenario":[{"creditedName":"カズウミ","creatorId":"vndb:s3934","sourcePersonId":"egs:creator:16149","canonicalEntityId":"vndb:s3934","name":"カズウミ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:128511","source":"egs"}],"music":[{"creditedName":"tutti","creatorId":"vndb:s1117","sourcePersonId":"vndb:s1117","canonicalEntityId":"vndb:s1117","name":"筒井 香織","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:107007","source":"vndb"}],"other":[]},"cast":[{"characterId":"char_c18477","characterName":"オルトリンデ","sourceIds":{"bangumi":[{"characterId":"43363","match":"exact-normalized-name-in-linked-work","subjectId":"105282"}],"egsCharacterIds":["8402"],"vndbCharacterId":"c18477"},"originalCharacterName":"オルトリンデ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"105"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"I"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious beauty who wanders around the grounds of the Royal Academy. She is the only surviving princess of a ruined kingdom who has been living under the curse of immortality for about 700 years."},{"spoiler":false,"text":"She sometimes rolls around with the protagonist often teasing him. Aside from the protagonist, she rarely talks to anyone else. Her purpose is to dispel the curse, and she doesn't seem to have any intention of interfering with the current era..."},{"spoiler":false,"text":"Her staple food is donuts, she especially likes mochi donuts. When it comes to donuts, she becomes very passionate and excitable. She is very disappointed that Master Donut's point card system will end. She views the kids' menu giving points for purchasing new products a serious issue, because she isn't a kid..."}],"source":"vndb","sourceCharacterId":"c18477"},{"segments":[{"spoiler":false,"text":"王立学園の敷地内をブラブラしている、神出鬼没の謎の美女。"},{"spoiler":false,"text":"その正体は約700年もの間不老不死の呪いのため生き続けてきた、滅びた王国唯一の生き残りである姫。"},{"spoiler":false,"text":"時に試すように。時に戯れるように。掌でコロコロと主人公を転がしからかう。"},{"spoiler":false,"text":"主人公以外とは全くといっていいほど会話しない。"},{"spoiler":false,"text":"目的は解呪であり。今の時代に干渉するつもりはないようだが…。"},{"spoiler":false,"text":"主食はドーナツ、特にポン・タ・リングがお気に入り。"},{"spoiler":false,"text":"ドーナツのことになると大人気なくムキになったり、はしゃいだりする。"},{"spoiler":false,"text":"マスタードーナツのポイントカード制が終わる事をとても残念に思っている。"},{"spoiler":false,"text":"キッズメニュー購入特典とかにされたらマジ困る。キッズじゃないから。"}],"source":"egs","sourceCharacterId":"8402","sourceWorkId":"19917","spoiler":false},{"segments":[{"spoiler":false,"text":"王立学園の敷地内をブラブラしている、神出鬼没の謎の美女。"},{"spoiler":false,"text":"その正体は約700年もの間不老不死の呪いのため生き続けてきた、滅びた王国唯一の生き残りの姫である。"},{"spoiler":false,"text":"時に試すように、時に戯れるように、掌でコロコロと主人公を転がしてからかう。"},{"spoiler":false,"text":"主人公以外とは全くと言っていいほど会話しない。"},{"spoiler":false,"text":"目的は解呪で、今の時代に干渉するつもりはないようだが……。"},{"spoiler":false,"text":"主食はドーナツ、特にポン・タ・リングがお気に入り。"},{"spoiler":false,"text":"ドーナツのことになるとムキになったりはしゃいだりする。"},{"spoiler":false,"text":"マスタードーナツのポイントカード制が終わることをとても残念に思っている。"},{"spoiler":false,"text":"キッズメニュー購入特典とかにされたらマジ困る。 キッズじゃないから。"},{"spoiler":false,"text":"「当たり前じゃろ、誰の肉体に触れておると思っておる。 最初からそう従順に頼めばよいのじゃ……手間をとらせおって」"}],"source":"bangumi",