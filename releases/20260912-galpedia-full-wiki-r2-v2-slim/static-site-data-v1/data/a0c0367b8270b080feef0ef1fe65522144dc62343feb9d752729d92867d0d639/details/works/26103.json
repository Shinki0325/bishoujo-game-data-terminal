ditedName":"D林","creatorId":"vndb:s11388","sourcePersonId":"vndb:s11388","canonicalEntityId":"vndb:s11388","name":"林 知明","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121226","source":"vndb"},{"creditedName":"へくちゅん","creatorId":"vndb:s12594","sourcePersonId":"vndb:s12594","canonicalEntityId":"vndb:s12594","name":"へくちゅん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121229","source":"vndb"},{"creditedName":"如月 ゆう","creatorId":"vndb:s17495","sourcePersonId":"vndb:s17495","canonicalEntityId":"vndb:s17495","name":"如月 ゆう","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121230","source":"vndb"},{"creditedName":"満腹亭白米","creatorId":"vndb:s17508","sourcePersonId":"vndb:s17508","canonicalEntityId":"vndb:s17508","name":"満腹亭白米","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:121232","source":"vndb"}]},"cast":[{"characterId":"char_c36020","characterName":"朝宮 ひまり","sourceIds":{"bangumi":[{"characterId":"36809","match":"exact-normalized-name-in-linked-work","subjectId":"142141"}],"egsCharacterIds":["7977"],"vndbCharacterId":"c36020"},"originalCharacterName":"朝宮 ひまり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"801"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class: 2-3"},{"spoiler":false,"text":"Likes: Blue Skies, White Clouds, Freedom"},{"spoiler":false,"text":"Dislikes: Watches, phones, and any fancy gadgets"},{"spoiler":false,"text":"One of the protagonist's many classmates. Himari is a pretty girl who always dons a strange hat. She lives in the same dormitory as the protagonist."},{"spoiler":false,"text":"While she attends class in the morning, she has a habit of bolting out of class after attendance is taken. It’s rumored that she talks with unseen entities, and she’s quite the peculiar free spirit. Her favorite pastime is staring off into the ocean by herself."},{"spoiler":false,"text":"\"This is \"Iris\". My only... no! One of my many many friends.\""},{"spoiler":false,"text":"Edited from MangaGamer"}],"source":"vndb","sourceCharacterId":"c36020"},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、変わった帽子 を被った美少女。"},{"spoiler":false,"text":"主人公と同じ寮の住人でもある。"},{"spoiler":false,"text":"学園に登校しても出席だけとって帰ってしまったり、目に見えない精霊と話ができると噂されていたりと、かなり個性的な自由人。"},{"spoiler":false,"text":"一人で海と空を眺めているのが好きらしい。"}],"source":"egs","sourceCharacterId":"7977","sourceWorkId":"22121","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、めですと名付けた帽子を被った美少女。"},{"spoiler":false,"text":"主人公と同じ寮の住人でもある。"},{"spoiler":false,"text":"以前は学園で姿を見かけないレアキャラでぼっちだったが、今ではきちんと授業も受け、学園生活を満喫している。"},{"spoiler":false,"text":"言動は相変わらず個性的で、そんなところも男子学生の間で人気を博しているらしい。"}],"source":"egs","sourceCharacterId":"7977","sourceWorkId":"24415","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、変わった帽子・めです（CV：上田朱音） を被った美少女。"},{"spoiler":false,"text":"主人公と同じ寮の住人でもある。"},{"spoiler":false,"text":"学園に登校しても出席だけとって帰ってしまったり、目に見えない精霊と話ができると噂されていたりと、かなり個性的な自由人。"},{"spoiler":false,"text":"一人で海と空を眺めているのが好きらしい。"},{"spoiler":false,"text":"「この子は “めです”。 わたしの唯ぃ……じゃなくて！　たくさんのお友達の一人よ」"}],"source":"bangumi","sourceCharacterId":"36809"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"36809","value":"青い空、白い雲、自由"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"36809","value":"時計とか、携帯電話とか"},{"label":"所属","source":"bangumi","sourceCharacterId":"36809","value":"本校 2年3組"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec7efc7dd2708a996bc005c83b81428905c6f28894111b05b931a548f68bc430.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1518756284505d68908982345e24ab9d428cf22a4a35eeaf6237bfc6853bddc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結城ほのか","creatorId":"vndb:s6018","sourcePersonId":"vndb:s6018","canonicalEntityId":"vndb:s6018","name":"結城 ほのか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:142141:36809:20256:1","source":"bangumi"}]},{"characterId":"char_c36021","characterName":"白の守護者","sourceIds":{"bangumi":[{"characterId":"36810","match":"exact-normalized-name-in-linked-work","subjectId":"142141"}],"egsCharacterIds":["7978"],"vndbCharacterId":"c36021"},"originalCharacterName":"白の守護者","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"424"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class: 2-1"},{"spoiler":false,"text":"Likes: Her parents, cute stuffed animals (she keeps this secret)"},{"spoiler":false,"text":"Dislikes: Flattery"},{"spoiler":false,"text":"Hazuki is the president of the Kazana Academy student council, and the principal's daughter. Brains and beauty are hers to command, making her a stalwart force amongst both students and faculty."},{"spoiler":false,"text":"She’s often seen working up a storm in the student council room, and few students have seen her outside school. Her father is often away from the island, and she acts as his proxy."},{"spoiler":false,"text":"\"Do I... really look like I am bored? I try to seem like I am enjoying myself.\""},{"spoiler":false,"text":"Edited from MangaGamer"}],"source":"vndb","sourceCharacterId":"c36021"},{"segments":[{"spoiler":false,"text":"風南学園の生徒会長で、理事長の娘でもある少女。"},{"spoiler":false,"text":"才色兼備を体現したような存在で、講師や学生からの信任も厚い。"},{"spoiler":false,"text":"いつも生徒会室で仕事をこなしていて、プライベートの姿を見かけたらレアイベントだと言われている。"},{"spoiler":false,"text":"理事長である父が島を空ける際は、その代理を務めることもあるらしい。"}],"source":"egs","sourceCharacterId":"7978","sourceWorkId":"22121","spoiler":false},{"segments":[{"spoiler":false,"text":"風南学園の生徒会長で、理事長の娘でもある。"},{"spoiler":false,"text":"才色兼備を体現したような存在で、講師や学生からの信任も厚い。"},{"spoiler":false,"text":"相変わらず生徒会長と、理事長代理の仕事を忙しくこなしているが、以前に比べると表情に余裕が見えるようになったと学生の間でも評判になっている。"},{"spoiler":false,"text":"可愛い物好きも少しずつ浸透してきており、そのギャップが堪らないと一部で熱が上がっているもよう。"}],"source":"egs","sourceCharacterId":"7978","sourceWorkId":"24415","spoiler":false},{"segments":[{"spoiler":false,"text":"風南学園の生徒会長で、理事長の娘でもある少女。"},{"spoiler":false,"text":"才色兼備を体現したような存在で、講師や学生からの信任も厚い。"},{"spoiler":false,"text":"いつも生徒会室で仕事をこなしていて、プライベートの姿を見かけたらレアイベントだと言われている。"},{"spoiler":false,"text":"理事長である父が島を空ける際は、その代理を務めることもあるらしい。"},{"spoiler":false,"text":"「私、そんなにつまらなそうに見えます？　楽しんでいるように見せているつもりなのですけれど」"}],"source":"bangumi","sourceCharacterId":"36810"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"36810","value":"両親、可愛いぬいぐるみ（秘密にしている）"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"36810","value":"おべっか"},{"label":"所属","source":"bangumi","sourceCharacterId":"36810","value":"本校 2年1組"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/3066ace74158b952a1043b38eb9e8e73320a61f250acbfa2bec96fb6128fdf47.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92b290b09b4c498eaf5538113c3e06949fbd4a5f8c92ad0fdaf48629e743cb5e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:142141:36810:5020:1","source":"bangumi"}]},{"characterId":"char_c36022","characterName":"神月 依愛","sourceIds":{"bangumi":[{"characterId":"36811","match":"exact-normalized-name-in-linked-work","subjectId":"142141"}],"egsCharacterIds":["7979"],"vndbCharacterId":"c36022"},"originalCharacterName":"神月 依愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"229"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class: 2-3"},{"spoiler":false,"text":"Likes: The occult periodical \"The Weekly Wildebeast\", traveling to spiritual places"},{"spoiler":false,"text":"Dislikes: Ghosts"},{"spoiler":false,"text":"One of the protagonist's many classmates that calls herself the \"Daughter of Darkness.\" She lives in the same dormitory as the protagonist."},{"spoiler":false,"text":"Donning a highly-customized school uniform, she prefers to employ advanced diction in her speech."},{"spoiler":false,"text":"As such, most in her class keep their distance whenever possible. She is convinced the transfer student, the protagonist, bears many secrets, and is quite curious about him."},{"spoiler":false,"text":"\"...I am the sealed Daughter of Darkness. Offer thy name as sacrifice to my resurrection.\""},{"spoiler":false,"text":"Edited from MangaGamer"}],"source":"vndb","sourceCharacterId":"c36022"},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、自称魔王の娘。"},{"spoiler":false,"text":"主人公と同じ寮の住人でもある。"},{"spoiler":false,"text":"改造した制服に身を包み、難解で特徴的な言い回しを好む。"},{"spoiler":false,"text":"そのため、まともに相手をできるクラスメイトは数えるほどしかいない。"},{"spoiler":false,"text":"季節外れの転入生である主人公には秘密があるはず、と興味を抱いているらしい。"}],"source":"egs","sourceCharacterId":"7979","sourceWorkId":"22121","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同学年で、自称魔王の娘。"},{"spoiler":false,"text":"主人公と同じ寮の住人でもある。"},{"spoiler":false,"text":"改造した制服に身を包み、難解で特徴的な言い回しを好むため、以前はまともに相手をできる相手は殆どいなかったが、その突き抜けて堂々とした姿に魅せられる者は男女問わず、最近では熱狂的な信者たちも増え、その勢力を拡大しているらしい。"}],"source":"egs","sourceCharacterId":"7979","sourceWorkId":"24415","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、自称魔王の娘。"},{"spoiler":false,"text":"主人公と同じ寮の住人でもある。"},{"spoiler":false,"text":"改造した制服に身を包み、難解で特徴的な言い回しを好む。"},{"spoiler":false,"text":"そのため、まともに相手をできるクラスメイトは数えるほどしかいない。"},{"spoiler":false,"text":"季節外れの転入生である主人公には秘密があるはず、と興味を抱いているらしい。"},{"spoiler":false,"text":"「我は封印されし魔王が娘。 そなたの名を復活の贄として捧げん」"}],"source":"bangumi","sourceCharacterId":"36811"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"36811","value":"オカルト雑誌「ヌー」、霊的スポット巡り"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"36811","value":"お化け"},{"label":"所属","source":"bangumi","sourceCharacterId":"36811","value":"本校 2年3組"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/466670b66bdaf3b71f5c4de4444ae2748ec012284ed95f327152f04f81f52b33.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c456edec4d72e319ca0b5d1ac13ee5fdc7d3be1913c53b5199d4df6ad4d2383.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"仙台エリ","creatorId":"vndb:s195","sourcePersonId":"vndb:s195","canonicalEntityId":"vndb:s195","name":"仙台 エリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:142141:36811:4749:1","source":"bangumi"}]},{"characterId":"char_c36023","characterName":"天の逆神","sourceIds":{"bangumi":[{"characterId":"36812","match":"exact-normalized-name-in-linked-work","subjectId":"142141"}],"egsCharacterIds":["7980"],"vndbCharacterId":"c36023"},"originalCharacterName":"天の逆神","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"702"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class: 3-4 (extension school)"},{"spoiler":false,"text":"Likes: Black coffee (She really wants sugar, though), Western music (but she really listens to tons of J-pop and anime songs)"},{"spoiler":false,"text":"Dislikes: Spicy food"},{"spoiler":false,"text":"She's the protagonist's cousin, but insists that she's his little sister. She moved to the dormitory the protagonist was assigned to, and intends to look after him."},{"spoiler":false,"text":"Given the protagonist’s tendency to stay on top of things, she rarely gets the chance to \"take care of him\" like she envisions. Among her classmates, she is apparently seen as well off and hardworking."},{"spoiler":false,"text":"\"On your first day of your transfer, the cousin character is supposed to wake you up! We had a deal, right?!\""},{"spoiler":false,"text":"Edited from MangaGamer"}],"source":"vndb","sourceCharacterId":"c36023"},{"segments":[{"spoiler":false,"text":"なぜか ことあるごとに妹的な立ち位置を主張してくる従妹。"},{"spoiler":false,"text":"女性だけだった寮に主人公が住むことになり、お目付け役として同じ寮に移ってきた。"},{"spoiler":false,"text":"なにかと主人公の世話を焼こうとするが、自分で出来てしまう主人公に先を越されてしまうことが多い。"},{"spoiler":false,"text":"同級生の間ではしっかりしたイメージで見られているらしい。"}],"source":"egs","sourceCharacterId":"7980","sourceWorkId":"22121","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の従妹で、学園では２学年後輩。"},{"spoiler":false,"text":"主人公のお目付け役として移ってきた第二学生寮だったが、新年度の部屋割りでも第二学生寮に留まっている。"},{"spoiler":false,"text":"なにかと主人公の世話を焼こうとするが、自分でできてしまう主人公に先を越されることまでを、お約束として楽しめるようになったもよう。"},{"spoiler":false,"text":"以前は見栄を張っているところがあったが、今では自然体で振る舞い、同級生の間でも評判が上がっているらしい。"}],"source":"egs","sourceCharacterId":"7980","sourceWorkId":"24415","spoiler":false},{"segments":[{"spoiler":false,"text":"なぜか ことあるごとに妹的な立ち位置を主張してくる従妹。"},{"spoiler":false,"text":"女性だけだった寮に主人公が住むことになり、お目付け役として同じ寮に移ってきた。"},{"spoiler":false,"text":"なにかと主人公の世話を焼こうとするが、自分で出来てしまう主人公に先を越されてしまうことが多い。"},{"spoiler":false,"text":"同級生の間ではしっかりしたイメージで見られているらしい。"},{"spoiler":false,"text":"「なんでもう起きてるの？　転校初日は妹キャラに起こされるのがお約束じゃない！」"}],"source":"bangumi","sourceCharacterId":"36812"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"36812","value":"ブラックコーヒー（本当は砂糖を入れたい）、洋楽（本当はアニソンやJ-POPを聞いている）"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"36812","value":"辛い物"},{"label":"所属","source":"bangumi","sourceCharacterId":"36812","value":"付属 3年4組"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55eaf6fa4bdb81d6f1c2ac4f8f23ab7f41486c9baf27ef789cb3c2260c55c4bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8aecc3195f691e87fc51084dfc0225ba4e4f91ed20309ec4dd4367108e67a5c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"福圓美里","creatorId":"vndb:s362","sourcePersonId":"vndb:s362","canonicalEntityId":"vndb:s362","name":"福圓 美里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:142141:36812:4372:1","source":"bangumi"}]},{"characterId":"char_c36024","characterName":"天","sourceIds":{"bangumi":[{"characterId":"36813","match":"exact-normalized-name-in-linked-work","subjectId":"142141"}],"egsCharacterIds":["7981"],"vndbCharacterId":"c36024"},"originalCharacterName":"天","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1231"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class: - (Caretaker of Paradise)"},{"spoiler":false,"text":"Likes: Seeing people smile"},{"spoiler":false,"text":"Dislikes: Has none"},{"spoiler":false,"text":"Ame is a girl-type AI who greeted the protagonist upon his arrival on Kazana Island. She proclaims that it is her role to make everyone on the island happy. Her perpetual smile makes her the pride and joy of the island residents."},{"spoiler":false,"text":"Apart from her usual duties, she is also in charge of maintenance of the entire system governing the island."},{"spoiler":false,"text":"\"I exist to make everyone happy♪\""},{"spoiler":false,"text":"Edited from MangaGamer"}],"source":"vndb","sourceCharacterId":"c36024"},{"segments":[{"spoiler":false,"text":"風南島にやってきた主人公を出迎えた、少女型人工知能。"},{"spoiler":false,"text":"実体を持たないホログラムで、島中どこにでも現れては困っている人に声を掛けている。"},{"spoiler":false,"text":"いつも明るい笑顔を絶やさないその姿は、島の住民にも好意的に受け入れられている。"},{"spoiler":false,"text":"島のすべての人を幸せにするための存在を自任し、島に張り巡らされたシステムの管理運営を司っているらしい。"}],"source":"egs","sourceCharacterId":"7981","sourceWorkId":"22121","spoiler":false},{"segments":[{"spoiler":false,"text":"風南島にやってきた主人公を出迎えた「少女型人工知能」。"},{"spoiler":false,"text":"実体を持たないホログラムで、島中どこにでも現れては困っている人に声をかける姿が島民からも好意的に受け入れられていた。"},{"spoiler":false,"text":"島に張り巡らされたシステムと人工妖精の管理運営も司っていたが、楽園の管理人は、現在、奏（かなで）へと引き継がれている。"}],"source":"egs","sourceCharacterId":"7981","sourceWorkId":"24415","spoiler":false},{"segments":[{"spoiler":false,"text":"風南島にやってきた主人公を出迎えた、少女型人工知能。"},{"spoiler":false,"text":"実体を持たないホログラムで、島中どこにでも現れては困っている人に声を掛けている。"},{"spoiler":false,"text":"いつも明るい笑顔を絶やさないその姿は、島の住民にも好意的に受け入れられている。"},{"spoiler":false,"text":"島のすべての人を幸せにするための存在を自任し、島に張り巡らされたシステムの管理運営を司っているらしい。"},{"spoiler":false,"text":"「私は全ての人を幸せにするために存在してるんですよ♪」"}],"source":"bangumi","sourceCharacterId":"36813"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"36813","value":"人の笑顔"},{"label":"所属","source":"bangumi","sourceCharacterId":"36813","value":"楽園の管理人"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/024b51af6cb6e6fbe421d3348fccdf966e64947bc4635829ad041eb523731e95.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5ea407e7fe1e916cca10eda1bb9ac13e81c4642b976feb0a9ff340b4a9a8251a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真中桂子","creatorId":"vndb:s4378","sourcePersonId":"vndb:s4378","canonicalEntityId":"vndb:s4378","name":"真中 桂子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:142141:36813:5205:1","source":"bangumi"}]},{"characterId":"char_c39891","characterName":"高村 鳴","sourceIds":{"bangumi":[{"characterId":"36814","match":"exact-normalized-name-in-linked-work","subjectId":"142141"}],"egsCharacterIds":["7982"],"vndbCharacterId":"c39891"},"originalCharacterName":"高村 鳴","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1130"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class: First year student at a school on the mainland."},{"spoiler":false,"text":"Likes: Stargazing."},{"spoiler":false,"text":"Dislikes: Dishonesty."},{"spoiler":false,"text":"Mei is the protagonist’s actual sister. Along with her brother, she resided at the Fujishiro household, their mother’s sister. However, he left for Kazana Academy, but she continued to live there with her aunt."},{"spoiler":false,"text":"She is disappointed with her brother for leaving the coop, but understands his reasons for doing so, and knows it is futile to be angry with him."},{"spoiler":false,"text":"\"And what was your intention in not contacting me, mister? Might I request an explanation?\""},{"spoiler":false,"text":"Edited from MangaGamer"}],"source":"vndb","sourceCharacterId":"c39891"},{"segments":[{"spoiler":false,"text":"主人公の実妹。"},{"spoiler":false,"text":"兄妹で藤白家のお世話になっていたが、主人公が風南学園に転入してしまったため一人で居候している。"},{"spoiler":false,"text":"勝手に出て行ってしまった兄の行動は不満に思っているが、その真意も容易に推測できるだけに怒ることもできないでいる。"}],"source":"egs","sourceCharacterId":"7982","sourceWorkId":"22121","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の実妹。"},{"spoiler":false,"text":"兄妹で藤白家のお世話になっていたが、主人公が風南学園に転入してしまったため一人で居候している。"},{"spoiler":false,"text":"勝手に出て行ってしまった兄の行動は不満に思っているが、"},{"spoiler":false,"text":"その真意も容易に推測できるだけに怒ることもできないでいる。"},{"spoiler":false,"text":"「一週間も音沙汰なしとはどういうおつもりか、ご説明願えますか、お・兄・様？」"}],"source":"bangumi","sourceCharacterId":"36814"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"36814","value":"星を見上げること"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"36814","value":"不義理"},{"label":"所属","source":"bangumi","sourceCharacterId":"36814","value":"都内の学園 1年生"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a099f8c183327606e81da246a5db2d7f94c36b24fe3cdb4ccb7a05a3fafabbc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/4222a6d72974657f7339aa2acf705652e4b602679b0ce25077cc00daaa2fbea2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高森奈津美","creatorId":"vndb:s979","sourcePersonId":"vndb:s979","canonicalEntityId":"vndb:s979","name":"高森 奈津美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:142141:36814:7302:1","source":"bangumi"}]},{"characterId":"char_c39892","characterName":"辻谷 大和","sourceIds":{"bangumi":[{"characterId":"36815","match":"exact-normalized-name-in-linked-work","subjectId":"142141"}],"egsCharacterIds":["7983"],"vndbCharacterId":"c39892"},"originalCharacterName":"辻谷 大和","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"401"},"height":{"reviewState":"no-conflict","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's classmate and only shown male friend. He refers to the protagonist as \"Comrade,\" and adds \"Lady\" (-jou) to the female characters' names (ex. Lady Asamiya/Asamiya-jou for Himari). He has an entertaining dynamic with Io due to their quirky personalities, and she refers to him as \"The Keeper of Secrets.\" He shares a resemblance in appearance and personality with Suginami from the popular Da Capo games, also by Circus."}],"source":"vndb","sourceCharacterId":"c39892"},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、謎の情報通。"},{"spoiler":false,"text":"非公式新聞部というよく分からない部活に所属しており、主人公をなぜか親しげに “同志” と呼ぶ。"},{"spoiler":false,"text":"“初音島のトリックスター” なる人物に心酔しているらしい。"}],"source":"egs","sourceCharacterId":"7983","sourceWorkId":"22121","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、謎の情報通。"},{"spoiler":false,"text":"非公式新聞部というよく分からない部活に所属しており、主人公をなぜか親しげに “同志” と呼ぶ。"},{"spoiler":false,"text":"“初音島のトリックスター” なる人物に心酔しているらしい。"},{"spoiler":false,"text":"「はっはは、悩め若人よ！　それは必ずお前の糧となる……っと。 今のは似ていただろう？」"}],"source":"bangumi","sourceCharacterId":"36815"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"36815","value":"楽しいこと、初音島のトリックスター"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"36815","value":"楽しくないこと"},{"label":"所属","source":"bangumi","sourceCharacterId":"36815","value":"本校 2年3組"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f86025262abdf998ef1f19e5dd2a9f6eae6d301972d8c98afef85e1d43c41f8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85a5331b726f34f8a72615406edb6f29abe3aff15a2eab90e413cd25af9d3931.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"原田友貴","creatorId":"vndb:s34","sourcePersonId":"vndb:s34","canonicalEntityId":"vndb: