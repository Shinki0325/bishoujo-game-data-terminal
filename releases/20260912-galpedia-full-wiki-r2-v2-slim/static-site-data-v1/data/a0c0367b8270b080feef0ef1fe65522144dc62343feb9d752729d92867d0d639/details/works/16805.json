alue":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"},"weight":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is Kazunori's sister-in-law and Kumi's mother. She raised Kazunori and her daughter together, after Kazunori's parents passed away when he was young. She is like a mother to him."},{"spoiler":false,"text":"She is a gentle and calm person, but she is strict about her work. To cheer Kazunori up when he falls on hard times at his part-time job at a coffee shop, she teaches him a “magic tongue kiss” that her husband taught her."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c6567"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75342ee0e2514239e49d9dd805515ef46eed914e4bec7e1f83bbeccb9d8bc572.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1caef2447fb61b426fb6f2d63b32d9a5fa94aa058688adbe7d6277d20b30100f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊木 春乃","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46300","source":"vndb"}]},{"characterId":"char_vndb_c6568","characterName":"御薗 千春","sourceIds":{"vndbCharacterId":"c6568"},"originalCharacterName":"御薗 千春","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"height":{"reviewState":"source-only","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"},"weight":{"reviewState":"source-only","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kazunori's childhood friend and the manager of the coffee shop Espoir. She was Kazunori's first love, but she married another man. However, her husband eloped with a waitress, so she is currently \"single\"."},{"spoiler":false,"text":"She is cheerful, energetic, kind, patient, and compassionate. On the other hand, she is lonely, jealous, and very jealous."},{"spoiler":false,"text":"Perhaps because her husband ran off with another woman, she is in a great deal of depression."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c6568"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/4225b05638142dc92c676e61555879e1cdf294eb20dd80f578ea8e05797bb615.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2eeb464be0cadf0c1c47be995973be0fe21cef8907bd34b3351f2f2580fba731.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"御苑生 メイ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46297","source":"vndb"}]},{"characterId":"char_vndb_c6573","characterName":"氷上 裕梨愛","sourceIds":{"vndbCharacterId":"c6573"},"originalCharacterName":"氷上 裕梨愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only",