eCharacterId":"c119976","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"16438","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"16438","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"139561","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbc3fed8f881d1e42a2b98d362b67f45284bdac2666c4903e944d05d1910cf9d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/3148f1c341369c4f7e1e45f4777cf58f7b5af612e6fd7b913205f04de1eb7cf7.webp","width":129,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山本 パンダ","creatorId":"vndb:s8217","sourcePersonId":"vndb:s8217","canonicalEntityId":"vndb:s8217","name":"山本 パンダ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10779","source":"vndb"}]},{"characterId":"char_c119978","characterName":"与那原 彗","sourceIds":{"bangumi":[{"characterId":"139560","match":"exact-normalized-name-in-linked-work","subjectId":"12092"}],"egsCharacterIds":["16437"],"vndbCharacterId":"c119978"},"originalCharacterName":"与那原 彗","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"802"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"height":{"reviewState":"no-conflict","source":"vndb","value":"174"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大地と魅流のクラスメイトにして悪友。真性のマゾ気質。"},{"spoiler":false,"text":"一年の頃に同じクラスになって以来、常に三人で騒いできた。"},{"spoiler":false,"text":"苦痛も何もなく得られる成功に意味はない！　とあえて茨の道を選ぶが、彼にとってそれは悦びの道ですらある。"},{"spoiler":false,"text":"魅流に純粋に恋愛感情を抱いており、魅流から与えられる苦痛はアドレナリン大放出。"},{"spoiler":false,"text":"時として恍惚の表情すら浮かべる。"},{"spoiler":false,"text":"「ああん。違うよ、マイハニー。でも、そんな焦らせ方に、オレのハートはやっぱりキュンキュンフル回転さ！」"}],"source":"egs","sourceCharacterId":"16437","sourceWorkId":"11447","spoiler":false},{"segments":[{"spoiler":false,"text":"・茜橋東学園2年"},{"spoiler":false,"text":"・身長：174"},{"spoiler":false,"text":"・血液型：B型"},{"spoiler":false,"text":"・主人公への呼称：大地"},{"spoiler":false,"text":"・一人称：オレ"},{"spoiler":false,"text":"・趣味：ラジオ体操・乾布摩擦"},{"spoiler":false,"text":"・特技：バカなのに風邪を引く（寒空での無茶なラジオ体操乾布摩擦による）・あらゆる苦痛に悦びを見いだせる。"},{"spoiler":false,"text":"・苦手なもの／事：生ガキ（命中率１００％）"},{"spoiler":false,"text":"・好きなもの／事：悦びに繋がる苦痛・魅流・女体の神秘・かっこいいもの"},{"spoiler":false,"text":"・嫌いなもの／事：苦痛のない成功・人真似・ファッション雑誌"},{"spoiler":false,"text":"・家族構成：父・母・弟"},{"spoiler":false,"text":"大地と魅流のクラスメイトにして悪友。一年の頃に同じクラスになって以来、常に三人で騒いできた。"},{"spoiler":false,"text":"一言でいうならマゾである。はっきり言ってマゾである。大事な事だから二度言うくらいにバカである。"},{"spoiler":false,"text":"苦痛も何もなく得られる成功に意味はない！　とあえて茨の道を選ぶが、彼にとってそれは悦びの道ですらある。"},{"spoiler":false,"text":"魅流に純粋に恋愛感情を抱いており、魅流から与えられる苦痛はアドレナリン大放出。時として恍惚の表情すら浮かべる。"}],"source":"bangumi","sourceCharacterId":"139560"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c119978","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"16437","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"16437","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"139560","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe12fe75f3cdbe963f742f7afc6864c6fb7c57a72b27ca40306851d99b140706.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5487b175cbbd81b987a7000b04dbde9e15fd1ecd2dc83a5c343a9ad55b2444a.webp","width":129,"height":256,"source":"static-detail"},"actors":[{"creditedName":"荻原秀樹","creatorId":"vndb:s749","sourcePersonId":"vndb:s749","canonicalEntityId":"vndb:s749","name":"荻原 秀樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12092:139560:4069:1","source":"bangumi"}]},{"characterId":"char_c31017","characterName":"泉 空","sourceIds":{"bangumi":[{"characterId":"11268","match":"exact-normalized-name-in-linked-work","subjectId":"12092"}],"egsCharacterIds":["16425"],"vndbCharacterId":"c31017"},"originalCharacterName":"泉 空","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"707"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"71"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"144"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大地や皐月、天音、銀一郎の幼なじみだったが七年前に親の転勤によって離ればなれに。"},{"spoiler":false,"text":"別れる際に再会の約束をしたものの、その約束は守られることなく、彼女の『死』によって終わったはずだった。"},{"spoiler":false,"text":"が、彼女は再び大地達の前に姿を見せる。将来の十二星座の候補の一人として。"},{"spoiler":false,"text":"他の候補生とは違い、完全に星座としての力に目覚めているため肉体の成長が止っているが、紛れもなく大地と同い年。"},{"spoiler":false,"text":"昔は明るく好奇心旺盛なヤンチャ少女だったが、星座への目覚めや時間が彼女を成長させたのか、今は落ち着きを見せている。"},{"spoiler":false,"text":"実際、落ち着いた女性を目指してはいるものの、その本性は変わっておらず、きっかけさえあればすぐに元気な自分が現れる。"},{"spoiler":false,"text":"「なんで、今更……守るの。殺したままにしておいてよっ」"}],"source":"egs","sourceCharacterId":"16425","sourceWorkId":"11447","spoiler":false},{"segments":[{"spoiler":false,"text":"茜桥东学园2年级。大地与皐月、天音、银一郎的青梅竹马。"},{"spoiler":false,"text":"7年前因为父母调动工作，离开了大家。但现在作为将来的十二星座候补再次出现在大地他们面前。"},{"spoiler":false,"text":"与其他的候补生不同，因为作为星座的力量已经完全觉醒，肉体的成长停止了。但是，毫无疑问，与大地同年。"},{"spoiler":false,"text":"虽然目标是成为雍容女性，但好奇心旺盛的淘气少女的本性却无法改变，一有契机精神十足的本我就会出现。"},{"spoiler":false,"text":"只对大地十分冷淡。对大地之外的人则是热心照顾，有时也会意外地上劲。"},{"spoiler":false,"text":"「为何、事到如今才……保护我。你便当我已经死了吧」"}],"source":"bangumi","sourceCharacterId":"11268"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"11268","value":"购物、试穿"},{"label":"特技","source":"bangumi","sourceCharacterId":"11268","value":"短跑"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b31beb9a6366929293948a03416d56e87379733084c25d0b4860f0bbea8555e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f6917e2cedcd57fbce091ccb421c506cdeb45e17fc210365396573a0600f9cd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12092:11268:4956:1","source":"bangumi"}]},{"characterId":"char_c31018","characterName":"狩野 星亜","sourceIds":{"bangumi":[{"characterId":"11269","match":"exact-normalized-name-in-linked-work","subjectId":"12092"}],"egsCharacterIds":["16426"],"vndbCharacterId":"c31018"},"originalCharacterName":"狩野 星亜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1117"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"十二星座の一人にして双璧と呼ばれる『獅子座』の実の妹。"},{"spoiler":false,"text":"将来の十二星座候補の一人であり、その潜在能力はかなりのものだが、現状星座としての力は完全には発動していない。"},{"spoiler":false,"text":"候補生試験のために転校、大地のクラスメイトとなる。"},{"spoiler":false,"text":"努力家であり、勉強、運動とどれも抜群。"},{"spoiler":false,"text":"だが、真面目で少しプライド高い性格のためか、努力を知られることを酷く嫌う。"},{"spoiler":false,"text":"「なんだ……見てくれてた人、いたんじゃない」"}],"source":"egs","sourceCharacterId":"16426","sourceWorkId":"11447","spoiler":false},{"segments":[{"spoiler":false,"text":"茜桥东学园2年级。被称为双壁的十二星座之一“狮子座”的实妹。"},{"spoiler":false,"text":"将来的十二星座候补，潜在能力虽然相当高杆，但作为星座的力量还没有完全发动。为了接受候补生考试而转校，成为了大地的同学。"},{"spoiler":false,"text":"身为努力家，学习?运动都很优秀。但是，大概因为一本正经，自尊感强的性格的关系吧，非常讨厌被人发觉自己在努力。与实力相反不擅长应对突发事件，在精神面上也有点脆弱。"},{"spoiler":false,"text":"超级甜食党，咖啡最少也要加入3勺砂糖才会喝。相反很讨厌辣的东西。咖喱只吃儿童向的辣味，寿司只吃没芥末的。"},{"spoiler":false,"text":"「什么呀……不是有人看到了么」"}],"source":"bangumi","sourceCharacterId":"11269"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"11269","value":"偷偷努力"},{"label":"特技","source":"bangumi","sourceCharacterId":"11269","value":"家庭料理 （只限于简单的料理"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edc5935fa49d919c23ed465588efecba248e151a6eafe268ac789393a1b0c4f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/574b6a9a09127705c513b4f5b123a6e0664e7c08bb654fbe93b6ab5e3003fb6e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12092:11269:4432:1","source":"bangumi"}]},{"characterId":"char_c31019","characterName":"藤崎 天音","sourceIds":{"bangumi":[{"characterId":"11270","match":"exact-normalized-name-in-linked-work","subjectId":"12092"}],"egsCharacterIds":["16427"],"vndbCharacterId":"c31019"},"originalCharacterName":"藤崎 天音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1102"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大地、空の幼なじみであり、姉貴分。"},{"spoiler":false,"text":"兄貴分であるもう一人の幼なじみ銀一郎と、大地の妹である皐月を加えた五人で、幼い頃はずっと一緒に遊んでいた。"},{"spoiler":false,"text":"座右の銘は、背は低いが心はおっきく。見た目は子供だが、中見は非常に頼りになる年上女性。"},{"spoiler":false,"text":"相当なブラコンであり、年下である大地をそれはもう心の底から可愛がっている。"},{"spoiler":false,"text":"空を失った大地の姉として、銀一郎と共に支え続けた。"},{"spoiler":false,"text":"「こら！　またそうやってエロイこと考えてるんだから。まったくもう、あたしはそういう大くんが……あーもう可愛いじゃない、ちくしょう！」"}],"source":"egs","sourceCharacterId":"16427","sourceWorkId":"11447","spoiler":false},{"segments":[{"spoiler":false,"text":"茜桥东学园3年级。大地、空的青梅竹马，大姐头。"},{"spoiler":false,"text":"加上大哥大的另一个青梅竹马?银一郎与大地的妹妹?皐月，5个人从小时候开始就一起玩到大。"},{"spoiler":false,"text":"座右铭是『个小心大』。外貌虽然幼齿，其实是个很可靠的年长女性。"},{"spoiler":false,"text":"相当的弟控，从心底里爱着年幼的大地。作为失去了空的大地的姐姐，与银一郎一起一直支持着他。"},{"spoiler":false,"text":"天生的气氛制造者，擅长调动周围气氛。"},{"spoiler":false,"text":"学力虽然一般，但运动系则是超级擅长。就如那个缎带显示的一般，拥有猫一般的灵敏性。"},{"spoiler":false,"text":"顺带一提，私服常常是哥特萝莉系。"},{"spoiler":false,"text":"「喂！又想着色色的事了吧。"},{"spoiler":false,"text":"真是的，我对这样的大君……啊～真是太可爱了、可恶！"}],"source":"bangumi","sourceCharacterId":"11270"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"11270","value":"剪报"},{"label":"特技","source":"bangumi","sourceCharacterId":"11270","value":"强硬的说得"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8ed46d4513493e6be0e392df818b1d65ac2494c2b6c0b84e7a53e7aa6d79187.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba1c6f28a2534cf04cdaa52c88fd90abbf987ad363581710081ce799da102ef3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12092:11270:4646:1","source":"bangumi"}]},{"characterId":"char_c31020","characterName":"姫ノ宮 輝夜","sourceIds":{"bangumi":[{"characterId":"11271","match":"exact-normalized-name-in-linked-work","subjectId":"12092"}],"egsCharacterIds":["16428"],"vndbCharacterId":"c31020"},"originalCharacterName":"姫ノ宮 輝夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1215"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"十二星座候補生として転校。大地の妹である皐月のクラスメイトなり、そのまま親友となる。"},{"spoiler":false,"text":"家族をすべて事故で失っており、引き取られた親戚の家で率先して家事を引き受けていたため、そちらは万能。"},{"spoiler":false,"text":"奥ゆかしく、一歩下がって相手を立てる大和撫子系美少女。"},{"spoiler":false,"text":"自分のことよりもまずは周囲のことを考える気配りを欠かさない。"},{"spoiler":false,"text":"学園内での人気も非常に高い。"},{"spoiler":false,"text":"常に家族の写真を入れたペンダントをしており、独りになった時には、その写真に色々と語りかけている。"},{"spoiler":false,"text":"「あ、あの……っ、大地先輩のお仕事、お手伝いさせてもらっていいですか……？」"}],"source":"egs","sourceCharacterId":"16428","sourceWorkId":"11447","spoiler":false},{"segments":[{"spoiler":false,"text":"茜桥东学园1年级。作为十二星座候补生转校。成为了大地的妹妹?皐月的同学兼好友。"},{"spoiler":false,"text":"在事故中失去了所有亲人，在收养她的亲戚的家里带头包下家务，因此家务方面万能。"},{"spoiler":false,"text":"内向腼腆，退后一步衬出良人的大和抚子系美少女。比起自己的事，优先考虑周围人的事的贴心人。在学园内的人气也非常之高。"},{"spoiler":false,"text":"学习很强，别说大她一岁的大地了，就连大她两岁的天音与银一郎也能轻松愉快地教。相反，运动能力平平。"},{"spoiler":false,"text":"一直挂着装有家人照片的首饰，孤独一人的时候，会对着照片喃喃自语。"},{"spoiler":false,"text":"「请、请问……大地前辈的工作，我能帮上什么忙么……？」"}],"source":"bangumi","sourceCharacterId":"11271"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"11271","value":"全部家务"},{"label":"特技","source":"bangumi","sourceCharacterId":"11271","value":"速读、按摩"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff10a05e47ff762f7b69786df9711873435ea3906071bb83ec856d0d75e04ae1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/341aaeac142f4604a3dacfc803be70d3e1792a0158dd9d36d716ac5a871977be.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12092:11271:4727:1","source":"bangumi"}]},{"characterId":"char_c31021","characterName":"橘 皐月","sourceIds":{"bangumi":[{"characterId":"11272","match":"exact-normalized-name-in-linked-work","subjectId":"12092"},{"characterId":"11272","match":"exact-normalized-name-in-linked-work","subjectId":"16778"}],"egsCharacterIds":["10175"],"vndbCharacterId":"c31021"},"originalCharacterName":"橘 皐月","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"331"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と一つ違いの実の妹。"},{"spoiler":false,"text":"勉強や運動に関しては中の中と普通だが、容姿端麗、性格温厚、よく気が付いて家事手伝いが趣味という、男性相手の長所をこれでもかと持つ少女。"},{"spoiler":false,"text":"むろん学園の生徒達にも、一学年～三学年まで問わず人気者。"},{"spoiler":false,"text":"女子にも、その気の付くところが気に入られているらしく、マスコットのように可愛がられている。"},{"spoiler":false,"text":"が、それらのすべての長所を易々と打ち消す重度のブラコンは、もはや周囲の誰もが『だって皐月だし』で納得してしまうレベル。"},{"spoiler":false,"text":"「すみません。重い荷物を持って帰ってきたお兄ちゃんを癒すことのが最優先だって思ったので」"}],"source":"egs","sourceCharacterId":"10175","sourceWorkId":"11447","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・大地の実の妹で、極度のブラコン『妹』。"},{"spoiler":false,"text":"兄の役に立つ、世話をするを人生のすべてとし、家事を始めとするすべてを完璧にこなす完璧少女。"},{"spoiler":false,"text":"周囲に、どうしてこれだけの娘が兄一筋なんて間違った道を……"},{"spoiler":false,"text":"……と悔やまれているがすでにもう諦めた連中が大半なので、どちらかというと風物詩の一種かもしれない。"},{"spoiler":false,"text":"子供の頃から将来の夢は『お兄ちゃんのお嫁さん♪』。"},{"spoiler":false,"text":"それはどんな事件があろうと、どんな娘が大地の前に現れようと、揺らぐことのない彼女の信念。"},{"spoiler":false,"text":"むしろ揺らぐと世界が終わる。"}],"source":"egs","sourceCharacterId":"10175","sourceWorkId":"15324","spoiler":false},{"segments":[{"spoiler":false,"text":"茜桥东学园1年级。比主人公小1岁的实妹。"},{"spoiler":false,"text":"学习与运动虽然很普通，但容姿端丽，性格温厚，又很贴心，以帮助家务为兴趣，堪称拥有贤妻良母的一切优点的少女。"},{"spoiler":false,"text":"在女生中也被当做吉祥物一般疼爱着，不问学年的人气者。虽然有点慢性子，但一直精神无比乐观开朗的气氛制造者。"},{"spoiler":false,"text":"但是，兄控重度到了足以抵消这些所有优点的程度。已经到了周围任何人都能以一句「是那个皐月啊」自我谅解的程度。"},{"spoiler":false,"text":"从前，创造了面对「将来的梦想是？」的询问，立刻回答「哥哥的新娘?」的传说。至于这个梦想有没有改变呢只有神……就算不是神那也是一目了然。"},{"spoiler":false,"text":"「不好意思。我认为治愈拿着重重的行李回来的哥哥是最优先事项」"}],"source":"bangumi","sourceCharacterId":"11272"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"11272","value":"帮忙家务、扫除、给房间改头换面"},{"label":"特技","source":"bangumi","sourceCharacterId":"11272","value":"比闹钟正好早5分钟醒来"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0d2d522ea811cf20323838bb59969c5ac3efbc52d75b14afe35eeb4f4c2ae94.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1a937ec1a468e76bcae6412b5adf1f9683a4398863ebcfed63395b08ff57c20.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12092:11272:6016:1","source":"bangumi"}]},{"characterId":"char_c31022","characterName":"明石沢 魅流","sourceIds":{"bangumi":[{"characterId":"11273","match":"exact-normalized-name-in-linked-work","subjectId":"12092"}],"egsCharacterIds":["16429"],"vndbCharacterId":"c31022"},"originalCharacterName":"明石沢 魅流","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"525"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"彗と共に、一年の頃からの大地のクラスメイト。"},{"spoiler":false,"text":"いわゆる賑やかし役であり、ムードメーカー。どんなイベントも、彼女と彗を中心におけば途端に盛り上がる。"},{"spoiler":false,"text":"さばさばとしており、行動力の固まり。深く考えることは苦手で、迷ったら試せが心情。"},{"spoiler":false,"text":"男のような口調『～だぜ』もあり、女子の人気は高いのだが、男子からはほとんど女扱いされていない。"},{"spoiler":false,"text":"容姿のレベルが高いだけに、回りの男子からは『あれで性別さえ間違えていなければ』と溜息混じりの言葉がよく聞かれる。"},{"spoiler":false,"text":"「起きないから鬼籍っていうんだぜ」"}],"source":"egs","sourceCharacterId":"16429","sourceWorkId":"11447","spoiler":false},{"segments":[{"spoiler":false,"text":"茜桥东学园2年级。从1年级开始就和大地与彗是同学。"},{"spoiler":false,"text":"所谓的负责调动气氛的气氛制造者。无论是什么活动，只要中心有她和彗，就会立刻气氛高涨。"},{"spoiler":false,"text":"性格爽朗，行动力的聚合体。不擅长想得太深，信条是『迷惘的话就先试试』。也因为语调像男人一般「～だぜ」的关系么，在女生中的人气很高。另一方面，男生们几乎没有人把她当女性看待。"},{"spoiler":false,"text":"正因为容姿的水平很高，才常常听到周围的男生们带着叹息说道「如果她没有搞错性别的话」。"},{"spoiler":false,"text":"另外，想要干掉魅流不需要刀具。一直放置不管让她无聊就行了。"},{"spoiler":false,"text":"「再起不能那才叫鬼籍啊」"}],"source":"bangumi","sourceCharacterId":"11273"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"11273","value":"记录 （照片、日记、剪报等等，一切感兴趣的东西的记录）"},{"label":"特技","source":"bangumi","sourceCharacterId":"11273","value":"可○ 1升装一口气饮尽"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f7255ec59d7e5620424918ad3f73688b11965f2e8516577128c5417922024fb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/196ccbcc9db3656204d5ca648f3e8c0f940267bb59501f3a805443919a239033.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12092:11273:5906:1","source":"bangumi"}]},{"characterId":"char_c31023","characterName":"狩野 陽夏","sourceIds":{"bangumi":[{"characterId":"110469","match":"exact-normalized-name-in-linked-work","subjectId":"12092"},{"characterId":"110469","match":"exact-normalized-name-in-linked-work","subjectId":"246377"}],"egsCharacterIds":["16430"],"vndbCharacterId":"c31023"},"originalCharacterName":"狩野 陽夏","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"21"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1117"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"67"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AA"},"height":{"reviewState":"no-conflict","source":"vndb","value":"140"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"68"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"星座の最高位にある十二星座。その中でも『乙女座』と並び双璧とも最強とも謳われている武力を誇る。"},{"spoiler":false,"text":"星座は、その力に完全に目覚めると同時に肉体の成長が停止する。"},{"spoiler":false,"text":"彼女は幼い頃に飛行機事故において命を落としかけ、その際に目覚めた。そのため肉体年齢は幼いが、実際は成人に達している。"},{"spoiler":false,"text":"十二星座としての経験も、現役十二星座の中でトップクラスである。"},{"spoiler":false,"text":"有事には、自らの身体よりも大きな戦斧を軽々と振り回し障害を排除する。"},{"spoiler":false,"text":"その破壊力の前にはコンクリートの壁など無いに等しい。"},{"spoiler":false,"text":"「ああ、そうだな。名前を聞くときはまず自ら名乗るのが礼儀か」"}],"source":"egs","sourceCharacterId":"16430","sourceWorkId":"11447","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公への呼称：大地"},{"spoiler":false,"text":"・一人称：あたし"},{"spoiler":false,"text":"・趣味：昴に甘えること"},{"spoiler":false,"text":"・特技：書道（五段）"},{"spoiler":false,"text":"・苦手なもの／事：タバコ、タバコの煙"},{"spoiler":false,"text":"・好きなもの／事：昴・鍋物（みんなで食べられるから）・筋を通す人"},{"spoiler":false,"text":"・嫌いなもの／事：賭け事・筋の通っていない人"},{"spoiler":false,"text":"・家族構成・父・母・妹"},{"spoiler":false,"text":"星座の最高位にある十二星座。その中でも『乙女座』と並び双璧とも最強とも謳われている武力を誇る。"},{"spoiler":false,"text":"星座は、その力に完全に目覚めると同時に肉体の成長が停止する。彼女は幼い頃に飛行機事故において命を落としかけ、その際に目覚めた。そのため肉体年齢は幼いが、実際は成人に達している。十二星座としての経験も、現役十二星座の中でトップクラスである。"},{"spoiler":false,"text":"礼儀に厳しく、人として最低限守らなければならないルールを破る人間に対しては容赦無い。が、婚約者である昴の前ではまるで別人のように甘えたがりになり、精神年齢が十は下がる。なお、今回の候補生の一人である狩野星亜は、彼女の実の妹である。"}],"source":"bangumi","sourceCharacterId":"110469"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a976a511c3deb1168ffb65861f2276f524f1d1fc9a9fea6f6d830e38396cd52.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e879992d621860949796051185059566df65e29e00ee84016de8f19570387aa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"萩原えみこ","creatorId":"vndb:s867","sourcePersonId":"vndb:s867","canonicalEntityId":"vndb:s867","name":"萩原 えみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12092:110469:4854:1","source":"bangumi"}]},{"characterId":"char_c31024","characterName":"乙女座・白鳥","sourceIds":{"bangumi":[{"characterId":"139558","match":"exact-normalized-name-in-linked-work","subjectId":"12092"}],"egsCharacterIds":["16431"],"vndbCharacterId":"c31024"},"originalCharacterName":"乙女座・白鳥","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"28"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"height":{"reviewState":"no-conflict","source":"vndb","value":"171"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『獅子座』と並び最強と称される最強の十二星座『乙女座』。"},{"spoiler":false,"text":"その外見は、まさに『乙女座』の名を得るために産まれたと言われるほどに美しく、常に温かな微笑をたたえている。"},{"spoiler":false,"text":"優しく穏やかで、常に相手を思いやるその姿は周囲の人々から女神、と称されることも多い。"},{"spoiler":false,"text":"星座となる前からも数え切れないほどの男性に言い寄られてきたが、すべて断ってきた。"},{"spoiler":false,"text":"が、そんな姿とは裏腹に、守るべきものに危害を加えようとするものには容赦しない。"},{"spoiler":false,"text":"暴力に関しては本心から嫌っているが、何かを守るためには力も必要だということは充分に理解している。"},{"spoiler":false,"text":"「あら、ありがとうございます。でも、私のことなんかよりも、まずは彼のこと、ですよね」"}],"source":"egs","sourceCharacterId":"16431","sourceWorkId":"11447","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公への呼称：大地さん"},{"spoiler":false,"text":"・一人称：私"},{"spoiler":false,"text":"・趣味：刺繍・編み物・新しいレシピの研究"},{"spoiler":false,"text":"・特技：合気道・空手・剣道・家事全般"},{"spoiler":false,"text":"・苦手なもの／事：虫・不潔な人"},{"spoiler":false,"text":"・好きなもの／事：可愛らしいもの・穏やかな人"},{"spoiler":false,"text":"・嫌いなもの／事：暴力・思いやりの無い人"},{"spoiler":false,"text":"・家族構成・父・母・姉・妹"},{"spoiler":false,"text":"『獅子座』と並び最強と称される最強の十二星座『乙女座』。その外見は、まさに『乙女座』の名を得るために産まれたと言われるほどに美しく、常に温かな微笑をたたえている。"},{"spoiler":false,"text":"優しく穏やかで、常に相手を思いやるその姿は周囲の人々から女神、と称されることも多い。星座となる前からも数え切れないほどの男性に言い寄られてきたが、すべて断ってきた。"},{"spoiler":false,"text":"が、そんな姿とは裏腹に、守るべきものに危害を加えようとするものには容赦しない。暴力に関しては本心から嫌っているが、何かを守るためには力も必要だということは充分に理解している。"}],"source":"bangumi","sourceCharacterId":"139558"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/4813c64c164d4dde9f4e1205adacce62b7b1bca3c2a11f2d7ab79872dac0550f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89b2dc52807a1f42d96c78424dc44b4a96fc8d54a245d9fe45da5ff4100f75c7.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12092:139558:6036:1","source":"bangumi"}]},{"characterId":"char_c31025","characterName":"北杜 七星","sourceIds":{"bangumi":[{"characterId":"110470","match":"exact-normalized-name-in-linked-work","subjectId":"12092"}],"egsCharacterIds":["16432"],"vndbCharacterId":"c31025"},"originalCharacterName":"北杜 七星","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"19"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"707"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"十二星座の一人である『水瓶座』。"},{"spoiler":false,"text":"戦うための力は他の十二星座と比べると大きく劣るが、それを補って余りある力、『予知』を持っている。"},{"spoiler":false,"text":"占星術師として未来の可能性を見るその力は、様々な事件の防止のためにも十二星座にとっては無くてはならないものである。"},{"spoiler":false,"text":"素直な頑張り屋で、十二星座という特別な地位にいながらも決して驕ることはない。"},{"spoiler":false,"text":"が、その反面、気弱で大人しく恐がりで、いつもオドオドと誰かの後ろに隠れている。"},{"spoiler":false,"text":"にも関わらず、好奇心旺盛でホラー好きときているため、周囲の人は度々気絶した彼女の後始末をさせられることとなる。"},{"spoiler":false,"text":"「はい。お任せ下さい。びしっと占わさせていただきます」"}],"source":"egs","sourceCharacterId":"16432","sourceWorkId":"11447","spoiler":false},{"segments":[{"spoiler":false,"text":"十二星座の水瓶座。17歳の時に星座となり、実年齢は19歳。占星術を使ってかなりの確率で未来を予知できるが、戦闘力は低い。星座候補試験の試験官（主に陽夏の抑え役）として共に茜橋へ着任し、自分の占星術で試験の協力者に選ばれた大地へホロスコープツリーを手渡す。優しく礼儀正しいが気は弱い。常識を軽く突破している十二星座の中では、比較的常識人。ホラー映画が好きだが恐がりなので1人では見られず、いつも誰かを誘っている。"}],"source":"bangumi","sourceCharacterId":"110470"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e0a9f5c9977b993f1662166f2ec6b8c49dcc6f760b90c9436aef46ca2384420.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/728a6072862c2284404346c46a6b8dbd624988c5701e77eaf79f9db0c0f02c8d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夢咲朱花","creatorId":"vndb:s1962","sourcePersonId":"vndb:s1962","canonicalEntityId":"vndb:s1962","name":"夢咲 朱花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:charac