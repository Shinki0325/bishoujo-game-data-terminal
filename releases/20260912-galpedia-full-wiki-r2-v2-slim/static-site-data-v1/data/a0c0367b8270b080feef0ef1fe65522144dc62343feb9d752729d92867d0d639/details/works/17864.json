ler":false,"text":"考えるよりも感じろ、迷うよりも行動しろ、な考えのもと、自らが信じた道をまっすぐ胸を張って歩いてきた。"},{"spoiler":false,"text":"頭は決して良くないが、ケンカは大得意。この周辺ではまさに敵無し。"},{"spoiler":false,"text":"今の大地の存在に多大な影響を与えた人物であり、大地も絶対の信頼を置いている。"}],"source":"bangumi","sourceCharacterId":"139559"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4ede9a31333fdf3876a42473451d4be5581d893968af1b24ae5289602d7d246.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd277f5c984ce677b99ed51b5a342617e3ae640e6f9ccd0004a64fe60d79a25e.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"角川竜二","creatorId":"vndb:s1896","sourcePersonId":"vndb:s1896","canonicalEntityId":"vndb:s1896","name":"丸山 竜一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12092:139559:45729:1","source":"bangumi"}]},{"characterId":"char_c119972","characterName":"牡羊座・飛山","sourceIds":{"bangumi":[{"characterId":"110461","match":"exact-normalized-name-in-linked-work","subjectId":"12092"}],"egsCharacterIds":["16433"],"vndbCharacterId":"c119972"},"originalCharacterName":"牡羊座・飛山","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"20"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"219"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"十二星座の一人『牡羊座』。あらゆるものを『直す』ことの出来る能力の持ち主。"},{"spoiler":false,"text":"それはあらゆるケガや病気を『治せる』ということでもある。"},{"spoiler":false,"text":"ただし決して私情でその力を使うことはなく、その人物を治すことが使命の遂行に必要な場合に限られる。"},{"spoiler":false,"text":"マイペースでお気楽な性格をしており、常に余裕ある笑みを浮かべ滅多なことでは動じない。"},{"spoiler":false,"text":"助けられる人すら助けようとしないその態度を残酷と非難されてはいるが、まったく意に介していない。"},{"spoiler":false,"text":"「お前みたいな顔をした奴は、大体馬みたいなんだよ。どこのことかは乙女の口からは到底言えないけれどな」"}],"source":"egs","sourceCharacterId":"16433","sourceWorkId":"11447","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公への呼称：子馬ちゃん"},{"spoiler":false,"text":"・一人称：あたし"},{"spoiler":false,"text":"・趣味：カラオケ"},{"spoiler":false,"text":"・特技：ハーモニカ"},{"spoiler":false,"text":"・苦手なもの／事：融通の利かない人・真面目すぎる人"},{"spoiler":false,"text":"・好きなもの／事：可愛い、もしくは綺麗な女性・妹"},{"spoiler":false,"text":"・嫌いなもの／事：ケガ、病気など、痛い、苦しい思いをすること"},{"spoiler":false,"text":"・家族構成：父・母・妹"},{"spoiler":false,"text":"十二星座の一人『おひつじ座』であり治癒術師。"},{"spoiler":false,"text":"はっきり言ってレズ。美女・美少女には目が無く、すぐナンパする。"},{"spoiler":false,"text":"お気楽でゆるい性格。そのためか、真面目な陽夏などにはよく突付かれているが、本人は少しも気にしていない。"},{"spoiler":false,"text":"他の人に、自分が頑張っている姿を見られることを嫌う。"}],"source":"bangumi","sourceCharacterId":"110461"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2501a5455b25a36c078c1f8fbbfeb170cbf9f9f22d995d4b1007386d6d22d74.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48f3cf70d75fae5668a9b6f4dcb31af70e2f4ad231e7240eafafb12e5d62873f.webp","width":148,"height":256,"source":"static-detail"},"actors":[{"creditedName":"稲田佳乃香","creatorId":"vndb:s1659","sourcePersonId":"vndb:s1659","canonicalEntityId":"vndb:s1659","name":"稲田 佳乃香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12092:110461:6593:1","source":"bangumi"}]},{"characterId":"char_c119976","characterName":"夢 昴","sourceIds":{"bangumi":[{"characterId":"139561","match":"exact-normalized-