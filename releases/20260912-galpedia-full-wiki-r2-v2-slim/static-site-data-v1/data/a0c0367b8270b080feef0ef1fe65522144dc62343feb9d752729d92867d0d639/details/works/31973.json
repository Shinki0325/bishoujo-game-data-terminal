[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8e8fb8aefa87479df6337a80fd77c79102806879c4312991198c7519a4c6acf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edb06e9ede7a8d0b86ff20ffb78ce58835e3e566ac014b3a24e106ee06800360.webp","width":148,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c73017","characterName":"対馬 馨","sourceIds":{"vndbCharacterId":"c73017"},"originalCharacterName":"対馬 馨","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He was born into a line of doctors beginning with his grandfather, and studies earnestly to meet the expectations that he becomes one himself. His high school was one of the most elite in his region, but due to unforeseen developments, he dropped out. He currently attends part-time school, while studying on his own to enroll into a medical college."},{"spoiler":false,"text":"The current coursework at school contributes little to his studies he will need to enter college, but he enjoys the non-discriminatory environment of part-time high school."},{"spoiler":false,"text":"As if dropping out of the usual high school rat race wasn’t enough, he has started to doubt whether he will continue his efforts to be a doctor and worries he will disappoint yet again."},{"spoiler":false,"text":"While appearing to be a diligent person, deep down he really may not be. A somewhat lost and confused youth."},{"spoiler":false,"text":"from MangaGamer's site"}],"source":"vndb","sourceCharacterId":"c73017"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c861de41448f0390a81534c603f909a7ff04af926c998a8c422f494420512721.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c32eca44e1c6f18e45ac1fde3f64a720dbb0db99af74644a8f954810a24b192a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c73018","characterName":"花井 三日月","sourceIds":{"vndbCharacterId":"c73018"},"originalCharacterName":"花井 三日月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"169"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student the same age as Kei. Korekiyo Hanai’s younger sister. Vocalist. Albino."},{"spoiler":false,"text":"She lives in Hokkaido, and after officially dropping out of school after extended truancy, she met Kei when visiting her brother."},{"spoiler":false,"text":"She gets along well with her brother, and is a talented vocalist, but shows little interest in pursuing music in any way."},{"spoiler":false,"text":"At first glance her appearance is one of striking beauty, but the more people appraise her, the less ”normal” she looks, which affects her self-esteem."},{"spoiler":false,"text":"Strange by nature, although in a different way than her brother, her peculiar mannerisms and thought processes make for awkward interactions with others."},{"spoiler":false,"text":"from MangaGamer's site"}],"source":"vndb","sourceCharacterId":"c73018"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05fd897cc99981af73362eb4a222dc6d33e1df0bb0de5e6a01cea39fba310bc1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a0dbcf5fe59bbdb88197c00292f45a7be483223b99c6ea040f670bee55c8956.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘 志穂","creatorId":"vndb:s738","sourcePersonId":"vndb:s738","canonicalEntityId":"vndb:s738","name":"橘 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:77356","source":"vndb"}]},{"characterId":"char_vndb_c73019","characterName":"香坂 輪","sourceIds":{"vndbCharacterId":"c73019"},"originalCharacterName":"香坂 輪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"height":{"reviewState":"source-only","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Bassist for Kacho-Fugetsu. Bass/chorus. Her skills exceed even her good looks."},{"spoiler":false,"text":"She loves music, and playing in a band, and picks at her bass whenever she has a free moment."},{"spoiler":false,"text":"Yet, she’s aloof to almost everything else and tends to doze off unreliably when things get boring or complicated."},{"spoiler":false,"text":"Little of her past before the band is known. Certain things such as her luxurious condo despite having little income adds an element of mystery to her personal life."},{"spoiler":false,"text":"from MangaGamer's site"}],"source":"vndb","sourceCharacterId":"c73019"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a4487c07423d288c59fb9c1760ab763e4e7a85b19324118aee55b65ea36d5c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/4316fe9cdafe9295e2d04f98cd0ec04894918e2bcb489a0d9ca94395c7c093a4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神保 巴","creatorId":"vndb:s455","sourcePersonId":"vndb:s455","canonicalEntityId":"vndb:s455","name":"神保 巴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:77355","source":"vndb"}]},{"characterId":"char_vndb_c73020","characterName":"尾崎 弥子","sourceIds":{"vndbCharacterId":"c73020"},"originalCharacterName":"尾崎 弥子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"C"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Kei’s juniors during their time in middle school. Current classmate."},{"spoiler":false,"text":"She respects Kei and is sure to refer to him as ”Senpai,” her senior. During middle school, sudden family trouble prevented her from attending further."},{"spoiler":false,"text":"Now, to support herself and her mother, she works day shifts at a supermarket, while attending part-time school at night."},{"spoiler":false,"text":"In such a day and age, she is a rare example of a hardworking girl with nothing but love for others."},{"spoiler":false,"text":"She loves her parents, despite them forcing her into such a busy situation."},{"spoiler":false,"text":"How is it possible to bring up such caring, selfless people in this world?"},{"spoiler":false,"text":"from MangaGamer's site"}],"source":"vndb","sourceCharacterId":"c73020"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c82744867e2f1e81bfde22670fb3d47f591af48a30aa4845b27ef30e17f23074.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6c7464dd92ac446233740c80420c6a4c56902eb4df2e12b5f5f9665ae225c4e.webp","width":213,"height":256,"sour