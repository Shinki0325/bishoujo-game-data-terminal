tionId":"vndb:vn-staff:108327","source":"vndb"}],"other":[{"creditedName":"カサンドラ","creatorId":"vndb:s3053","sourcePersonId":"egs:creator:20500","canonicalEntityId":"vndb:s3053","name":"カサンドラ","detail":"OP曲「Lovely Life」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:132631","source":"egs"},{"creditedName":"しらたま","creatorId":"vndb:s3158","sourcePersonId":"egs:creator:17029","canonicalEntityId":"vndb:s3158","name":"しらたま","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"auto-confirmed","relationId":"egs:work-creator:132635","source":"egs"},{"creditedName":"カサンドラ","creatorId":"vndb:s3053","sourcePersonId":"vndb:s3053","canonicalEntityId":"vndb:s3053","name":"カサンドラ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:108330","source":"vndb"}]},"cast":[{"characterId":"char_c19179","characterName":"橋本 にいな","sourceIds":{"bangumi":[{"characterId":"25348","match":"exact-normalized-name-in-linked-work","subjectId":"100421"}],"egsCharacterIds":["3776"],"vndbCharacterId":"c19179"},"originalCharacterName":"橋本 にいな","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's sister and a big brocon. An honest and shy girl, she is extremely prone to crying. Naturally clumsy, she often falls down on flat grounds. Out of the four heroines she has the youngest appearance. She is very much interested in ecchi stuff, and actively tries to have get her brother to bang her during dates. Having said this she actually has zero experience or knowledge on these things."}],"source":"vndb","sourceCharacterId":"c19179"},{"segments":[{"spoiler":false,"text":"健一の妹であり、彼のことが大好き。"},{"spoiler":false,"text":"性格はかなり大人しく、人見知りが激しくて泣き虫。"},{"spoiler":false,"text":"天然でドジであり、何もないところで転ぶことができる特技の持ち主。"},{"spoiler":false,"text":"４人の女の子の中で一番幼い外見の持ち主であり、ストーンでペターンでツルーンな容貌のことをかなり気にしている。"},{"spoiler":false,"text":"エッチなことをすればグラマラスなスタイルになれると共に、主人公と恋人同士になれると教えられ、一石二鳥だとデートでいろいろとエッチなことをしようと考えている。――が、そういった経験は全く無い上に知識も皆無。"},{"spoiler":false,"text":"どうすればいいのかデートするまでに何とかしようと考え中な日々を過ごしている。"}],"source":"egs","sourceCharacterId":"3776","sourceWorkId":"20342","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・健一の妹であり、兄のことが大好き。"},{"spoiler":false,"text":"性格はかなりおとなしく、人見知りが激しくて泣き虫。"},{"spoiler":false,"text":"天然なドジであり、何もないところで転ぶことができる特技の持ち主。"},{"spoiler":false,"text":"4人の中で一番幼い外見の持ち主。ストーンでペターンでツルーンな容姿をかなり気にしている。"},{"spoiler":false,"text":"エッチなことをすればグラマラスなスタイルになれると共に、主人公と恋人同士になれると教えられ、一石二鳥だとデートで色々とエッチなことをしようと考えている。"},{"spoiler":false,"text":"――が、そういった経験はまったく無いうえに知識も皆無。"},{"spoiler":false,"text":"どうすればいいのか、デートするまでになんとかしようと考え中な日々を過ごしている。"},{"spoiler":false,"text":"「おにぃちゃんは にいな のなの！」"}],"source":"bangumi","sourceCharacterId":"25348"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fcd6b45fdb454d1734590efb2d7869012768adcfa300cc035fd4a9af27abc011.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68ecf922c1368cb65f32bfac9769236ddc69e362c4a02a73d521d34cd114cf4c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"峰岸由香里","creatorId":"vndb:s925","sourcePersonId":"vndb:s925","canonicalEntityId":"vndb:s925","name":"峰岸 由香里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100421:25348:5939:1","source":"bangumi"}]},{"characterId":"char_c19180","characterName":"水沢 あん","sourceIds":{"bangumi":[{"characterId":"25349","match":"exact-normalized-name-in-linked-work","subjectId":"100421"}],"egsCharacterIds":["3777"],"vndbCharacterId":"c19180"},"originalCharacterName":"水沢 あん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's childhood friend. Despite the fact that she is older than Niina, they have the same loli physical appearances, at a glance its impossible to tell who is older. Despite the fact that she loves the protagonist, because of her tsundere personality she keeps those feelings hidden. She pretends to be knowledgeable about sex, but in fact have zero experience and know next to nothing about it."}],"source":"vndb","sourceCharacterId":"c19180"},{"segments":[{"spoiler":false,"text":"主人公とにいなの幼馴染。"},{"spoiler":false,"text":"にいなよりも年上だが、外見はどう見てもにいなと同じ程度かそれ以上に幼くにしか見えない。"},{"spoiler":false,"text":"幼馴染である主人公のことを好いているが、その天邪鬼な性格から気持ちを打ち明けられないでいる。"},{"spoiler":false,"text":"しかし、にいなたちが積極的にアプローチしていることに触発され、彼を巡る勝負を承知する。"},{"spoiler":false,"text":"自分は経験豊富だとうそぶくが、エッチなことの経験は全く無いばかりか、かなり疎い。"}],"source":"egs","sourceCharacterId":"3777","sourceWorkId":"20342","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と にいな の幼なじみ。"},{"spoiler":false,"text":"にいな よりも年上だが、外見はどう見てもにいなと同じ程度か、それ以上に幼くしか見えない。"},{"spoiler":false,"text":"幼なじみである主人公のことを好いているが、その天邪鬼な性格から気持ちを打ち明けられないでいる。"},{"spoiler":false,"text":"しかし、にいな たちが積極的にアプローチしていることに触発され、彼を巡る勝負を承知する。"},{"spoiler":false,"text":"自分は経験豊富だとうそぶくが、エッチなことの経験はまったく無いばかりか、かなり疎い。"},{"spoiler":false,"text":"「あたしだってラブラブなことしたいんだからぁっ!!」"}],"source":"bangumi","sourceCharacterId":"25349"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c225ab79a64603fcf4a42a2369d55dd212fdb1ae1ae9f0fbadc317f07c6a9f9c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbd0ceb56ac4a85e4d13cf6e52561baed1a4f3492368767e0a72df5b664d714c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100421:25349:11646:1","source":"bangumi"}]},{"characterId":"char_c19183","characterName":"支倉 ゆりこ","sourceIds":{"bangumi":[{"characterId":"25350","match":"exact-normalized-name-in-linked-work","subjectId":"100421"}],"egsCharacterIds":["3778"],"vndbCharacterId":"c19183"},"originalCharacterName":"支倉 ゆりこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Niina's friend. While she keeps her love for the protagonist hidden, but because of Niina's confession, she could not suppress her feelings any longer and confess as well. Although she is usually pretty quiet, but when necessary she will express her thoughts. She is more stubborn than her appearance suggest, and won't change her mind no matter what once she made a decision. Perhaps its because of her appearance, but she is a very mature girl, and has very big boobs for her age. Although she is very knowledgeable about sex, she has no experience."}],"source":"vndb","sourceCharacterId":"c19183"},{"segments":[{"spoiler":false,"text":"にいなの友達。"},{"spoiler":false,"text":"主人公のことを密かに想い続けており、にいなの告白をきっかけに気持ちを抑え切れず、主人公に告白してしまう。"},{"spoiler":false,"text":"性格は極めて寡黙だが、言うべきときにははっきりと自己主張するタイプ。"},{"spoiler":false,"text":"見かけ以上に頑固で思い込みが激しく、一度こうと決めたら絶対にそれを変えない。"},{"spoiler":false,"text":"容貌は性格のせいか少し大人びているが、それ以上に年には不相応なほどの巨乳の持ち主。"},{"spoiler":false,"text":"エッチなことは知識として持っているが、全くの未経験。"}],"source":"egs","sourceCharacterId":"3778","sourceWorkId":"20342","spoiler":false},{"segments":[{"spoiler":false,"text":"にいな の友達。"},{"spoiler":false,"text":"主人公のことを密かに想い続けており、にいな の告白をきっかけに気持ちを抑え切れず、主人公に告白してしまう。"},{"spoiler":false,"text":"極めて寡黙だが、言うべき時にはハッキリと自己主張するタイプ。"},{"spoiler":false,"text":"見かけ以上に頑固で思い込みが激しく、一度こうと決めたら絶対にそれを変えない。"},{"spoiler":false,"text":"容貌は性格のせいか少し大人びているが、それ以上に歳には不相応なほどの巨乳の持ち主。"},{"spoiler":false,"text":"エッチなことは知識として持っているが、まったくの未経験。"},{"spoiler":false,"text":"「デートすれば、あなたを私のものにできる自信がある」"}],"source":"bangumi","sourceCharacterId":"25350"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13231f0ef9e182ab5dc79d73c0478724b3f7692d047df73b36c49178027328da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4fcdacf60bc3a7c861e3bb9ad0a9c20ad4d5064a3c667abb22529cf72da6e57.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤田しずく","creatorId":"vndb:s937","sourcePersonId":"vndb:s937","canonicalEntityId":"vndb:s937","name":"藤田 しずく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100421:25350:16178:1","source":"bangumi"}]},{"characterId":"char_c19188","characterName":"柚々口 ももか","sourceIds":{"bangumi":[{"characterId":"25351","match":"exact-normalized-name-in-linked-work","subjectId":"100421"}],"egsCharacterIds":["3779"],"vndbCharacterId":"c19188"},"originalCharacterName":"柚々口 ももか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Niina's friend. She openly declared her love for the protagonist, and does not mind if she becomes his lover or mistress. Her figure is slightly more mature for her age. Has a childish personality, and often does stupid things on a whim, quite capricious. She sometimes likes to whine and act spoiled. When she gets rejected she won't in fact be angry but will burst into tears. Her feelings are vulnerable and is prone to depression."}],"source":"vndb","sourceCharacterId":"c19188"},{"segments":[{"spoiler":false,"text":"にいなの友達。"},{"spoiler":false,"text":"主人公のことを大好きであり、恋人がだめなら愛人でもいいと公言してはばからない。"},{"spoiler":false,"text":"体つきは年よりも大人びているが、その顔立ちは年相応。"},{"spoiler":false,"text":"その性格も年齢相応で子供のままであり、相当に気まぐれ、そしてかなり我がまま。"},{"spoiler":false,"text":"しかし、甘えたり、スネたり、そしてエッチなことで誤魔化したりして我がままをきかせてしまう天性の小悪魔ぷりを発揮している。"},{"spoiler":false,"text":"ただそのぶん、拒否されたり怒られることに不慣れであり、実際にそうされると泣き出したり、すごく落ち込む脆さがある。"}],"source":"egs","sourceCharacterId":"3779","sourceWorkId":"20342","spoiler":false},{"segments":[{"spoiler":false,"text":"にいな の友達。"},{"spoiler":false,"text":"主人公のことを大好きであり、恋人がダメなら愛人でもいいと公言してはばからない。"},{"spoiler":false,"text":"身体つきは歳よりも大人びているが、その顔立ちは年相応。"},{"spoiler":false,"text":"その性格も年相応で子供のままであり、相当に気まぐれ。そしてかなりワガママ。"},{"spoiler":false,"text":"甘えたりスネたり、そしてエッチなことで誤魔化したりしてワガママをきかせてしまう天性の小悪魔っぷりを発揮している。"},{"spoiler":false,"text":"その分 拒否されたり怒られることに不慣れであり、実際にそうされると泣き出したり、すごく落ち込む脆さがある。"},{"spoiler":false,"text":"「あなたの全部をわたしのものにしたいわ__」"}],"source":"bangumi","sourceCharacterId":"25351"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21ac2dc4e164cc4cd8bf45d47a9604bfb01e753c77e2ea8842768e4c2f366b80.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a4911e644cfe938c2f029c82ab28c2bf40f57247748aae15a58c15d1240a154.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100421:25351:5936:1","source":"bangumi"}]},{"characterId":"char_vndb_c21632","characterName":"橋本 健一","sourceIds":{"vndbCharacterId":"c21632"},"originalCharacterName":"橋本 健一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{