nId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183412:142704:6409:1","source":"bangumi"}]},{"characterId":"char_bangumi_142705","characterName":"伊勢ちぐさ","sourceIds":{"bangumi":[{"characterId":"142705","match":"source-roster","subjectId":"183412"}]},"originalCharacterName":"伊勢ちぐさ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"戦術兵器統括システム（TGS）搭載人型兵器2号体。"},{"spoiler":false,"text":"分析能力に重点を置いて製造されているため、やや官僚的で冷たい印象を与える。"},{"spoiler":false,"text":"だが、人間の行動には興味を持っており、観察、考察をしては、「何故、人間はこんな無駄なことをするのか」と首をひねることが多い。"},{"spoiler":false,"text":"セックスについてもデータベース的な知識しかないが、それゆえに、フェティズム、被虐と嗜虐（SMプレイ等）など、人間の強い性衝動に影響を受けやすい傾向がある。"}],"source":"bangumi","sourceCharacterId":"142705"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/1951ddf5acb070b8b8a6285e313b122a9abc9d3128cedb9526989a412bc7089e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e882d5a30ff1cc62b662f0a3d510d42c207c1739f18ceb936c3ff7b966094273.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あらいしずか","creatorId":"vndb:s665","sourcePersonId":"vndb:s665","canonicalEntityId":"vndb:s665","name":"あらい しずか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183412:142705:4647:1","source":"bangumi"}]},{"characterId":"char_bangumi_142706","characterName":"榛名もえぎ","sourceIds":{"bangumi":[{"characterId":"142706","match":"source-roster","subjectId":"183412"}]},"originalCharacterName":"榛名もえぎ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"戦術兵器統括システム（TGS）搭載人型兵器3号体。"},{"spoiler":false,"text":"マルチ部隊支援能力に重点を置いた双子型という、新しい試みで製造されたアンドロイド。"},{"spoiler":false,"text":"いつもにこにこしており、誰にでもわけへだてなく接する。"},{"spoiler":false,"text":"だが、怒るときも、にこにこしながら周囲の物を破壊する癖があるため、逆に笑顔が怖く感じられることもある。妹のくるみとは仲が良く、常に一緒に行動している。"},{"spoiler":false,"text":"セックスについての知識は人並みに与えられているが、具体的な方向性について定められたプログラムは存在していない。"}],"source":"bangumi","sourceCharacterId":"142706"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c86befc897c9a632cf7b9d2b2d2206c0825060ed5751d62856ad791beb4ea675.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4ed579026f0c06d35e4350c33497f95b353ce05218570c05324e994c9279d4e1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183412:142706:4714:1","source":"bangumi"}]},{"characterId":"char_bangumi_142708","characterName":"榛名くるみ","sourceIds":{"bangumi":[{"characterId":"142708","match":"source-roster","subjectId":"183412"}]},"originalCharacterName":"榛名くるみ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"戦術兵器統括システム（TGS）搭載人型兵器4号体。"},{"spoiler":false,"text":"マルチ部隊支援能力に重点を置いた双子型という、新しい試みで製造されたアンドロイド。"},{"spoiler":false,"text":"もえぎとは逆に、容赦なく毒舌を撒き散らす攻撃的な性格。"},{"spoiler":false,"text":"だが、根は甘えん坊で、自分を甘えさせてくれる包容力のある人間には心を許しがちになる。"},{"spoiler":false,"text":"もえぎに対して毒舌を向けることはまずないが、なにかの拍子で怒らせてしまうと青ざめて必死に謝り出すことから、力関係はもえぎのほうが上らしい。"},{"spoiler":false,"text":"セックスについての知識は人並みに与えられているが、具体的な方向性について定められたプログラムは存在していない。"}],"source":"bangumi","sourceCharacterId":"142708"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/651c2c55f6a6e6b9592bef7c09eef5532d08a2272e7effcc5ef9f3bcef941de6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35517cae8eeab1f3ea0500192a94d0c42428887a18064d49387fe28cb2930356.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_142710","characterName":"姫島玲子","sourceIds":{"bangumi":[{"characterId":"142710","match":"source-roster","subjectId":"183412"}]},"originalCharacterName":"姫島玲子","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"戦術兵器統括システム（TGS）の開発責任者。"},{"spoiler":false,"text":"功名心と野心に燃える美貌の女科学者で、科学の発展のためなら、すべてを犠牲にしてもよいと考えている。"},{"spoiler":false,"text":"師であるオルロイ教授を裏切り、自衛隊の決戦兵器として『アンドロイド』シリーズを完成させた。"},{"spoiler":false,"text":"性格的にはかなり屈折しており、科学的探究心と、出世欲が行動の原動力。また、常にテンションが高く、ナルシスト的発言が多い。"},{"spoiler":false,"text":"アンドロイドに対して特別な感情はもちあわせておらず、「所詮は機械人形」と考えている。"}],"source":"bangumi","sourceCharacterId":"142710"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71f1a9f84cad95090ab0ab6e94bdf4772c935f6fdf446330bc78d58fd9c11f95.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb5552d8860b2b81386c183c6802a92437883fea4d9fc37da82e11103e894fa7.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_208010","characterName":"皇ヶ崎雅人","sourceIds":{"bangumi":[{"characterId":"208010","match":"source-roster","subjectId":"183412"}]},"originalCharacterName":"皇ヶ崎雅人","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"180"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"74"}},"descriptions":[{"segments":[{"spoiler":false,"text":"陸上自衛隊司令。階級は一佐。"},{"spoiler":false,"text":"幹部候補として将来を嘱望されていた優秀な自衛官だったが、戦いの中で最愛の恋人を失い、すっかり生きる意欲を失っていた。"},{"spoiler":false,"text":"しかし、反抗部隊の司令官に任じられ、対ソ戦を戦い抜くうちに、4人のアンドロイド達によってしだいに人間性を取り戻して行く。"},{"spoiler":false,"text":"性格は生真面目だが、言葉数が少なく、表情も豊かとはいえないため、あまり人には理解されにくい。周囲からは優秀で謹厳な司令官と思われている。"},{"spoiler":false,"text":"戦いの中では非情であり、巧緻より拙速を尊ぶタイプ。しかし平時は温厚で、やや優柔不断な面も見せる。また、軍以外の事になるとてんで気が利かず、とくに女性に対してはかなり不器用だったりする。"}],"source":"bangumi","sourceCharacterId":"208010"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/631efbc1aab59558be573e01a8791b16fb4c60ec3de9ad90ed333d68f2260baf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2c14e2916d440dca223c60dc5356439e0f77f616fde673e904200aa5fcff4b1.webp","width":256,"height":223,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_208011","characterName":"Ariyoshi Megumi","sourceIds":{"bangumi":[{"characterId":"208011","match":"source-roster","subjectId":"183412"}]},"originalCharacterName":"Ariyoshi Megumi","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"bust":{"reviewState":"source-only","source":"bangumi","value":"90"},"height":{"reviewState":"source-only","source":"bangumi","value":"155"},"hip":{"reviewState":"source-only","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"58"},"weight":{"reviewState":"source-only","source":"bangumi","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"雅人の婚約者。政財界の大立者の娘で、裕福な家庭で両親から十分な愛情を受けて育った。"},{"spoiler":false,"text":"誰にでも優しくふるまう性格をしているが、反面他人を簡単に信用し過ぎてしまうこともあり、よく雅人から心配されていた。"},{"spoiler":false,"text":"「守るために戦う」という雅人の言葉を信じ、よき妻となることを夢見ていたが、東京決戦で死亡した。"}],"source":"bangumi","sourceCharacterId":"208011"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a28e98f43eeed5b10daa521d544c8403b1b068326aa80c2e76c7e44c8c36f441.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f74294d95bb80a25c17826da469e68f8841f54b5660ee2342654d07ec013154.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_208012","characterName":"Iji Orloi","sourceIds":{"bangumi":[{"characterId":"208012","match":"source-roster","subjectId":"183412"}]},"originalCharacterName":"Iji Orloi","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"height":{"reviewState":"source-only","source":"bangumi","value":"164"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アンドロイドたちの産みの親。チェコ出身の科学者で、「人間そっくりのロボット」を目指して研究を続けていたが、ソ連軍に拉致され、強制的に軍事用アンドロイドを開発させられる。"},{"spoiler":false,"text":"だが、オルロイ博士はそれ以上の軍事協力を拒否し、日本に亡命。文部科学省の援助の元、あかね、ちぐさ、もえぎ、くるみの4体のアンドロイドを造り上げる。"},{"spoiler":false,"text":"しかし、弟子であり右腕だと信じていた姫島博士に裏切られ、日本でもアンドロイドを軍事利用されることになり、悲観して姿をくらました。"}],"source":"bangumi","sourceCharacterId":"208012"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"h