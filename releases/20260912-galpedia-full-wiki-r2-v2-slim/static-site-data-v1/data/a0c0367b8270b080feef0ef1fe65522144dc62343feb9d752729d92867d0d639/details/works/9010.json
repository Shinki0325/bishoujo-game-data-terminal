c-detail"},"actors":[]},{"characterId":"char_bangumi_208014","characterName":"Alexei Bunikovsky","sourceIds":{"bangumi":[{"characterId":"208014","match":"source-roster","subjectId":"183412"}]},"originalCharacterName":"Alexei Bunikovsky","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"184"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"85"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ソ連軍司令官。将軍。機甲戦術の達人。若いが実戦経験も豊富。中央アジアの反乱鎮圧で頭角をあらわした。日本侵攻にあたっては総司令官として前線に立って活躍。"},{"spoiler":false,"text":"九州の早期攻略を提唱していたが、「東京支配を磐石にせよ」とのソ連本国の意向に従わざるをえず、やむなくわずかな手勢で福岡に進軍する。"},{"spoiler":false,"text":"性格は野卑で自信家。勤務中でもかまわずウォッカをあおっているが、その戦術的才能は確かで、必ず戦闘に見合った戦果を持ち帰る。"},{"spoiler":false,"text":"ただ、党本部からは煙たがられており、日本侵攻にあたっての人事は、左遷であるとも言われている。"}],"source":"bangumi","sourceCharacterId":"208014"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/897402e1acac8db25e0e24874448e2855dbd0553519da2629fc24cc66184143d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/903f966e2c48ae75225548779d7c127c311e2d4f2bc5280e446c0c3c017b1063.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_208015","characterName":"Stanislav Artuhov","sourceIds":{"bangumi":[{"characterId":"208015","match":"source-roster","subjectId":"183412"}]},"originalCharacterName":"Stanislav Artuhov","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"height":{"reviewState":"source-only","source":"bangumi","value":"175"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ソ連軍政治将校。中佐。ブニコフ将軍の行動を監視するために送り込まれた男。なにかことあるごとに、将軍の行動を党本部に報告しようとする。"},{"spoiler":false,"text":"性格は保身的で抜け目のない、嫌味な男。党本部における出世だけがただひとつの生きがいで、それ以外のことには全く興味がない。"},{"spoiler":false,"text":"日本人を毛嫌いし、差別的な感情を抱いている。"}],"source":"bangumi","sourceCharacterId":"208015"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f04e92140081180817286cf0f9addcc0d51633edadef9a77931e0d825c187337.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2db6f8977e5e595b931ccf6c928d4fa85857935f75cbced1e18b6b19f5143f43.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅科准平","creatorId":"vndb:s2704","sourcePersonId":"vndb:s2704","canonicalEntityId":"vndb:s2704","name":"浅科 准平","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:183412:208015:20000:1","source":"bangumi"}]},{"characterId":"char_bangumi_208016","characterName":"Ivan Dolgov","sourceIds":{"bangumi":[{"characterId":"208016","match":"source-roster","subjectId":"183412"}]},"originalCharacterName":"Ivan Dolgov","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"height":{"reviewState":"source-only","source":"bangumi","value":"153"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"90"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ソ連軍大佐。ブニコフ将軍の部下。性格的にはいたって小心者の悪党だが、小心がゆえに守りに入ったときの鉄壁さには定評がある。"},{"spoiler":false,"text":"ブニコフ将軍に対しては、それなりの忠誠心をもっているが、心の奥底では自分も将軍になりたいという野心を抱いている。"}],"source":"bangumi","sourceCharacterId":"208016"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b760830bb690e5175f273dba803d5e23f1ec30f0cb005b116bcfbfbdbdd019de.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e5c1944133813e92dc7294722e8c51d03f0b378f19fffc6596fc9581c10afc8.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_208017","characterName":"Anastasia","sourceIds":{"bangumi":[{"characterId":"208017","match":"source-roster","subjectId":"183412"}]},"originalCharacterName":"Anastasia","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"bangumi","value":"86"},"height":{"reviewState":"source-only","source":"bangumi","value":"167"},"hip":{"reviewState":"source-only","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"56"},"weight":{"reviewState":"source-only","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ソ連製TGS搭載人型兵器試作体。"},{"spoiler":false,"text":"あかね、ちぐさといった4体のアンドロイドが日本で誕生する以前、ソ連においてオルロイ博士が開発した試作体。"},{"spoiler":false,"text":"その後、ソ連製のTGSを搭載され、戦場に現れる。「妹」たちに対して特別な感情はないが、自分を捨てた（と思い込んでいる）オルロイ博士と、人間全体を憎悪している。"},{"spoiler":false,"text":"名前の由来は、ギリシャ語の「キリストの復活」。転じて「復活せし者」。"}],"source":"bangumi","sourceCharacterId":"208017"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44b97afd5de18b7e8c7c19c59649fd62ee5440497216783487f640b5418a3164.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b05cf77aacce4fe1d10f01cd200b64233edebc96806a92eae2f32d58b5778f71.webp","width":213,"height":256,"source":"static-detail"},