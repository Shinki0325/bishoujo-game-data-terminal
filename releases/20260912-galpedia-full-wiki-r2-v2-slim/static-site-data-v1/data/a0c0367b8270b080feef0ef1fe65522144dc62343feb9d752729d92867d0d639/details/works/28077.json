44245171b9c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45c010f69f3a5aeb59b74f4963406a03ef1ab221d8305c6c09215e151c495999.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_68448","characterName":"屡雨 ゆずは","sourceIds":{"bangumi":[{"characterId":"68448","match":"source-roster","subjectId":"268291"},{"characterId":"68448","match":"source-roster","subjectId":"326857"},{"characterId":"68448","match":"source-roster","subjectId":"378157"}]},"originalCharacterName":"屡雨 ゆずは","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"bangumi","value":"96"},"height":{"reviewState":"source-only","source":"bangumi","value":"161"},"hip":{"reviewState":"source-only","source":"bangumi","value":"95"},"waist":{"reviewState":"source-only","source":"bangumi","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"さくらと同じく学園1年。"},{"spoiler":false,"text":"園芸部が誇る期待のおっぱいさん2号。"},{"spoiler":false,"text":"さくらの幼馴染兼同居人。"},{"spoiler":false,"text":"幼少の頃よりさくらと一緒に住んでいる。"},{"spoiler":false,"text":"うらやましがられるほど昔からやたらと仲がいい。"},{"spoiler":false,"text":"普段はさくらのメイン被害者。"},{"spoiler":false,"text":"巻き込まれ体質でいつもフォローばかりしている。"},{"spoiler":false,"text":"基本的に相方（さくら）の突っ込み担当。"},{"spoiler":false,"text":"ルーティアの契約者。"},{"spoiler":false,"text":"ウェーブのかかった深い蒼色の髪は、"},{"spoiler":false,"text":"融合（ユニフィア）時には空色に。"},{"spoiler":false,"text":"長い杖をふるう魔法使い。"},{"spoiler":false,"text":"多くは後ろからさくらのフォローをする。"},{"spoiler":false,"text":"「私は何も出来ないかもしれないけど……。でも、私もお手伝いしたいです」"}],"source":"bangumi","sourceCharacterId":"68448"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fb628709176111ee08e275c7662d8801842e0b2a6bd9c2c421e1102e7fc8b52.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/45b702c