wiki/v1/characters/v1/images/c6/c60c6b96cd0a3fd7ea4f9bbc6f9bde6509159bd3c45f581d1a6d3a6e438515e4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐倉ゆき","creatorId":"vndb:s839","sourcePersonId":"vndb:s839","canonicalEntityId":"vndb:s839","name":"佐倉 ゆき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126269:91281:15997:1","source":"bangumi"}]},{"characterId":"char_c23072","characterName":"蒲生 仁美","sourceIds":{"bangumi":[{"characterId":"91275","match":"exact-normalized-name-in-linked-work","subjectId":"126269"},{"characterId":"91275","match":"exact-normalized-name-in-linked-work","subjectId":"41608"}],"egsCharacterIds":["10516"],"vndbCharacterId":"c23072"},"originalCharacterName":"蒲生 仁美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"新米車内販売員。"},{"spoiler":false,"text":"真面目な正確だが、仕事はドジばかり。"},{"spoiler":false,"text":"気が弱く、いつも謝ってばかり。"},{"spoiler":false,"text":"普段の愛想はよく、可愛らしい印象がある。"}],"source":"egs","sourceCharacterId":"10516","sourceWorkId":"11004","spoiler":false},{"segments":[{"spoiler":false,"text":"メス奴隷助手その2。"},{"spoiler":false,"text":"現在も『満潮』において車内販売員を務めており、やはり美樹と同じく身の回りから下の世話まで、精治にこき使われている。"}],"source":"egs","sourceCharacterId":"10516","sourceWorkId":"14988","spoiler":false},{"segments":[{"spoiler":false,"text":"美樹と同じく、引き続き【夜鷹】でも車内販売員を務める女性。"},{"spoiler":false,"text":"精治の裏業務の助手その二。"},{"spoiler":false,"text":"気弱な性格で何かと失敗を引き起こす頼りない女ではあるものの環境適応能力は案外高く、今では意外と図太い一面も垣間見える。"},{"spoiler":false,"text":"【夜鷹】においても車掌や運転手と同じく複数の車内販売員が搭乗することになっており、仁美はその中のチーフを務めている。"},{"spoiler":false,"text":"部下より危なっかしいのは相変わらずだが、それも愛嬌として受け止められており、最近は面倒見が良いと言われる事も。"}],"source":"egs","sourceCharacterId":"10516","sourceWorkId":"35509","spoiler":false},{"segments":[{"spoiler":false,"text":"まだ歳若い新米車内販売員。"},{"spoiler":false,"text":"一生懸命仕事に取り組む真面目な女性。"},{"spoiler":false,"text":"ただし有能かというと話は別で、荷物を落として商品をダメにしたり、車内で転倒して乗客と衝突するなど、いわゆるドジっ子である。"},{"spoiler":false,"text":"また少々気の弱いところがあり、横柄な態度の乗客などには腰が引けてしまう。"},{"spoiler":false,"text":"いつも謝ってばかりいるが、普段は愛想よくかわいらしい女性である。"},{"spoiler":false,"text":"副車掌の美樹同様、精治の手伝いをさせられることになる。"}],"source":"bangumi","sourceCharacterId":"91275"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b769f413477f6dfe5288f930781129d647b3f7bd838520181388d6c9651deff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd21439f4ae98c21a28d90caa70dd1abf428bb0113ddb4c117299aada369d008.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘志穂","creatorId":"vndb:s738","sourcePersonId":"vndb:s738","canonicalEntityId":"vndb:s738","name":"橘 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126269:91275:7169:1","source":"bangumi"}]},{"characterId":"char_c23078","characterName":"海堂 精治","sourceIds":{"bangumi":[{"characterId":"91268","match":"exact-normalized-name-in-linked-work","subjectId":"41608"},{"characterId":"91268","match":"exact-normalized-name-in-linked-work","subjectId":"467435"}],"egsCharacterIds":["17825"],"vndbCharacterId":"c23078"},"originalCharacterName":"海堂 精治","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He was secretly raised by powerful people in the underworld through the Special Sex Man Creation Plan and eventually rose to the top of the organization, becoming the worst and worst conductor."},{"spoiler":false,"text":"Although he has a very strong sexual desire, he also has the rationality to carefully pursue and kill his prey."},{"spoiler":false,"text":"Even though he is the top of the organization, he never lets go of his job of securing female slaves through his duties as a conductor, and leaves all the complicated matters to his partner Takatsuki and other trusted members of the organization."}],"source":"vndb","sourceCharacterId":"c23078"},{"segments":[{"spoiler":false,"text":"「特急 満潮」の車掌。主人公。"},{"spoiler":false,"text":"裏社会の権力者によって【特別性奴創造計画】の駒として育成された男。"},{"spoiler":false,"text":"元は孤児で、幼少から性の技術を鍛錬させられた調教のプロフェッショナル。"},{"spoiler":false,"text":"満潮の車掌に甘んじているが、権力掌握を伺う野心家の心を隠し持つ。"},{"spoiler":false,"text":"“欲・即・姦”がポリシー。しかし、目的のために自制するしたたかさも。"}],"source":"egs","sourceCharacterId":"17825","sourceWorkId":"11004","spoiler":false},{"segments":[{"spoiler":false,"text":"【特別性奴創造計画】によって裏社会の権力者達が秘密裏に育て上げ、結果的に組織の頂点に立った最凶最悪の車掌。"},{"spoiler":false,"text":"非常に性欲が強いが、狙った獲物は慎重に追い込んで仕留めようとする理性的な周到さも持ち合わせている。"},{"spoiler":false,"text":"組織のトップでありながらも車掌業務によってメス奴隷を確保するという自身の仕事は決して手放さず、煩雑な事はすべて相棒の高槻や信頼の置ける組織の人員に一任している。"}],"source":"egs","sourceCharacterId":"17825","sourceWorkId":"35509","spoiler":false},{"segments":[{"spoiler":false,"text":"鉄道会社を有する裏社会の出資者たちが、【特別性奴創造計画】のため自分たちにとって都合のいいように作り上げた男。"},{"spoiler":false,"text":"元々は孤児である。計画に関わる者にその身柄を引き取られた後、幼い頃から性的技術を仕込まれ、生来の才能や身体能力にも恵まれた精治は、計画実行のため【満潮】の車掌に任命された。"},{"spoiler":false,"text":"精治を育てた者たちは気づいていないが、実は天性の野心家である。"},{"spoiler":false,"text":"精治はこの計画を逆に利用し、機会を見て一気に権力を掌握することを考えている。"},{"spoiler":false,"text":"己の欲望に忠実な性格で、【欲・即・姦】がポリシーだが、実現のためには必要なだけ欲望を我慢することもできる計画的な一面も持つ。"},{"spoiler":false,"text":"二面性があり、人のいい爽やかな車掌と、邪悪な○辱鬼のふたつの顔を巧みに使い分ける。"}],"source":"bangumi","sourceCharacterId":"91268"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d668a802a9e194351f5239df358d7643f9e0f7bf9cfa4997bd7b689b1a575635.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a38fb59b86c1b504c3b73d7414dfd99a9b35fe9d7c0b8482353f4d9050442b5d.webp","width":213,"heig