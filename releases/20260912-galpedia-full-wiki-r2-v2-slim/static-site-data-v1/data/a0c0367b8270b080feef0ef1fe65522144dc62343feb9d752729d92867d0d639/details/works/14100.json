firmed","relationId":"egs:work-creator:136663","source":"egs"},{"creditedName":"加納 京太","creatorId":"vndb:s322","sourcePersonId":"vndb:s322","canonicalEntityId":"vndb:s322","name":"加納 京太","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:53938","source":"vndb"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:53939","source":"vndb"},{"creditedName":"深雪 まな","creatorId":"vndb:s3801","sourcePersonId":"vndb:s3801","canonicalEntityId":"vndb:s3801","name":"盛合 千鶴子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:53946","source":"vndb"},{"creditedName":"LUCHICA","creatorId":"vndb:s16983","sourcePersonId":"vndb:s16983","canonicalEntityId":"vndb:s16983","name":"LUCHICA","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:53949","source":"vndb"},{"creditedName":"LUCHICA","creatorId":"vndb:s16983","sourcePersonId":"vndb:s16983","canonicalEntityId":"vndb:s16983","name":"LUCHICA","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:53950","source":"vndb"}]},"cast":[{"characterId":"char_c28310","characterName":"西御門 ひよこ","sourceIds":{"bangumi":[{"characterId":"56000","match":"exact-normalized-name-in-linked-work","subjectId":"14267"}],"egsCharacterIds":["11524"],"vndbCharacterId":"c28310"},"originalCharacterName":"西御門 ひよこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"524"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"２年Ｃ組。アタルの隣の家に住む、甲斐甲斐しい世話焼き系幼馴染。"},{"spoiler":false,"text":"小学生の頃から常にクラスメイトで腐れ縁で、炊事、洗濯、掃除、家事全般マスタークラス。"},{"spoiler":false,"text":"不在がちなアタルの両親に頼まれ、アタルの身の回りの世話を務めているのだが、ニッポン政府から派遣されてきた柴田の進言により、彼直属のメイドとなってしまう。"},{"spoiler":false,"text":"小学生の頃まで、護身術として空手を学んでいたのだが、「女の子らしくない」ということに気づいて、ある程度の技術を身につけたところでやめた。"},{"spoiler":false,"text":"「そんなことしちゃ、めっ！」と、時折、相手を叱るために彼女が放つピヨピヨチョップは『当たらない』はずのアタルにも当たってしまう。そこに愛があるためである。"},{"spoiler":false,"text":"将来の夢はアタルのお嫁さんだったのだが、アタルが突然国王に就任してしまうわ、現れた姫たちに翻弄されるわで、てんてこ舞い。"},{"spoiler":false,"text":"夢遊癖があり、夜な夜なパジャマ姿で屋敷を徘徊することがある。"},{"spoiler":false,"text":"「私がアタルくんのメイドさん……えへ、なんか照れちゃうね」"}],"source":"egs","sourceCharacterId":"11524","sourceWorkId":"14100","spoiler":false},{"segments":[{"spoiler":false,"text":"アタルの隣家に住む、小さい頃から腐れ縁の甲斐甲斐しい世話焼き系幼なじみ。"},{"spoiler":false,"text":"家事全般はマスタークラス。"},{"spoiler":false,"text":"アタルが突然国王に就任してしまうわ、現れた姫たちに翻弄されるわで、てんてこ舞い。"},{"spoiler":false,"text":"さらにはニッポン政府から派遣されてきた柴田の進言により、彼直属のメイドとなってしまう。"},{"spoiler":false,"text":"「そんなことしちゃ、めっ！」 と放つピヨピヨチョップが “当たらない” はずのアタルにも当たってしまうのは愛ゆえに？"},{"spoiler":false,"text":"夢遊癖があり、夜な夜なパジャマ姿で屋敷を徘徊することも。"},{"spoiler":false,"text":"「私がアタルくんのメイドさん……えへ、なんか照れちゃうね」"}],"source":"bangumi","sourceCharacterId":"56000"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"56000","value":"アタル"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"56000","value":"虫"},{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"11524","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"11524","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"11524","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"11524","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"11524","sourceWorkId":"14100","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b8130289b4c0cdf30158a48ca4b329eb7c67ca81d37bfc4cb9e27bc55faf4cb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c02341fed0f7a21b3085664451d89cb59ee08d06923f12db2a7a031214505ca.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14267:56000:6016:1","source":"bangumi"}]},{"characterId":"char_c28311","characterName":"ミルフィ･ポム･デリング","sourceIds":{"bangumi":[{"characterId":"56001","match":"exact-normalized-name-in-linked-work","subjectId":"14267"}],"egsCharacterIds":["11525"],"vndbCharacterId":"c28311"},"originalCharacterName":"ミルフィ･ポム･デリング","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"213"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"71"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"146"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Cheeky, arrogant princess of the military state of Islia."},{"spoiler":false,"text":"She has grown up in her warm, dry castle without knowing any hardships, and her attitude is every bit as childish as her appearance."},{"spoiler":false,"text":"Her petite frame and tiny limbs allow our hero to keep her from approaching him simply by holding his hand out against her head."},{"spoiler":false,"text":"She wears a small crown on her head, a possession of her mother's, and is ordinarily quite haughty and arrogant while wearing it, but becomes docile when it is taken off."},{"spoiler":false,"text":"After Ataru offers her a donut, telling her, \"Your name sounds like a donut, after all,\" she falls completely in love with them."},{"spoiler":false,"text":"She loves anime, and learned the Nipponese language by watching it."},{"spoiler":false,"text":"While watching one particular robot anime, she mused, \"These Nipponese robot animes are all made as a reflection of reality, aren't they? Like, you can't just make up a story that realistic.\""},{"spoiler":false,"text":"Thanks to that gross misunderstanding on her part, she is obsessed with having a bipedal robot as the ultimate weapon to aid in her nation's arms buildup."},{"spoiler":false,"text":"\"That's Nippon for ya! Being able to watch anime in real time is, like, the best thing ever♪\""}],"source":"vndb","sourceCharacterId":"c28311"},{"segments":[{"spoiler":false,"text":"軍事国家イスリア王国のわがままで生意気なお姫様。"},{"spoiler":false,"text":"ぬくぬくと苦労も知らず、王宮で育ってきたせいで、容姿も幼いがそれ以上に思考が幼い。"},{"spoiler":false,"text":"身長が低く、手足も短いため、主人公に手を伸ばされて、頭を押さえつけられると届かない。"},{"spoiler":false,"text":"頭には母の遺品である小さな王冠をかぶっていて、普段は尊大な態度だが、王冠がはずれると途端に弱々しくなる。"},{"spoiler":false,"text":"「名前がドーナツみたいだから」と、アタルが与えたところ、一度食べたらすっかり大好物に。"},{"spoiler":false,"text":"ニッポン語を覚えてしまったほどのアニメ好き。"},{"spoiler":false,"text":"またロボットアニメを見て、「日本のロボットアニメは、全て現実をモチーフに作られているんでしょ？"},{"spoiler":false,"text":"じゃなきゃ、あんなリアルなお話が作れるはずないもん」と、すさまじい勘違いをしていて、軍備増強の最終兵器として二足歩行兵器を欲している。"},{"spoiler":false,"text":"「さすがはニッポンねー。リアルタイムでアニメを見られるなんて、サイッコーに幸せだわっ♪」"}],"source":"egs","sourceCharacterId":"11525","sourceWorkId":"14100","spoiler":false},{"segments":[{"spoiler":false,"text":"軍事国家イスリア王国の、わがままで生意気なお姫様。"},{"spoiler":false,"text":"ぬくぬくと苦労も知らず王宮で育ってきたせいで、容姿も幼いがそれ以上に思考が幼い。"},{"spoiler":false,"text":"頭には母の遺品である小さな王冠をかぶっていて、普段は尊大な態度だが、王冠が外れると途端に弱々しくなる。"},{"spoiler":false,"text":"「名前がドーナツみたいだから」 と、アタルがドーナツを与えたらすっかり大好物に。"},{"spoiler":false,"text":"アニメ好き。さらにロボットアニメは全て現実をモチーフに作られていると勘違いしていて、軍備増強用に歩行兵器を欲している。"},{"spoiler":false,"text":"「さすがはニッポンねー。リアルタイムでアニメを見られるなんて、サイッコーに幸せだわっ♪」"}],"source":"bangumi","sourceCharacterId":"56001"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"56001","value":"アニメ、甘いもの、高いところ、ドーナツ"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"56001","value":"辛いもの・苦いもの・怖いもの"},{"label":"胸围（本版本）","value":"71 cm","valueContext":null,"source":"egs","sourceCharacterId":"11525","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCharacterId":"11525","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"146 cm","valueContext":null,"source":"egs","sourceCharacterId":"11525","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"11525","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"11525","sourceWorkId":"14100","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e9c33d9e355e29ad3076bf7e886d4efabfd6659e7fba6c46c3b73b0587a1dc0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51e1a1fa3f22ca7c8439d0a2c9f0834726ddf88323116f11635651b5f3b82960.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴木はるこ","creatorId":"vndb:s283","sourcePersonId":"vndb:s283","canonicalEntityId":"vndb:s283","name":"狛乃ハルコ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14267:56001:19625:1","source":"bangumi"}]},{"characterId":"char_c28312","characterName":"セーラ･パトロエル･クアドラント","sourceIds":{"bangumi":[{"characterId":"56002","match":"exact-normalized-name-in-linked-work","subjectId":"14267"}],"egsCharacterIds":["11526"],"vndbCharacterId":"c28312"},"originalCharacterName":"セーラ･パトロエル･クアドラント","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"827"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Princess of the Quadrant Kingdom, an island nation smaller than even Nippon."},{"spoiler":false,"text":"She is a kind-hearted and perpetually relaxed lady."},{"spoiler":false,"text":"Her beauty is so great that no one could possibly refuse her advances, but she is also quite unaware of her own charms."},{"spoiler":false,"text":"All women in Quadrant are born beautiful, and growing up in that environment has left her with quite a misaligned sense of beauty."},{"spoiler":false,"text":"As a result, she will often point to things which no one in their right mind could conceivably define as cute and say, \"That's so cute!\" (Eg. Karakasa and nurikabe ghosts in haunted houses)"},{"spoiler":false,"text":"Quadrant's population has an intrinsic gender imbalance, with ten women for every man, so Quadrantian women are desperate to claim what little men they have as their own."},{"spoiler":false,"text":"Indeed, it is within the national interest for women to seduce prospective men, and the act of stealing into a man's room at night to sleep with him is considered a major rite of passage for young girls."},{"spoiler":false,"text":"Having grown up with these cultural ideals, she makes a habit of attempting to sneak into Ataru's room each and every night in order to tempt him, but it only leads to a successive, neverending string of failures."},{"spoiler":false,"text":"She attributes her actions to having fallen in love with Ataru at first sight, after having a dream about him."},{"spoiler":false,"text":"\"I have been taught that a night tryst is a veritable accomplishment for a lady. Just leave everything to me.\""}],"source":"vndb","sourceCharacterId":"c28312"},{"segments":[{"spoiler":false,"text":"日本より小さい島国、クアドラント王国の王女様。"},{"spoiler":false,"text":"おっとりしていて、ひとあたりがいい。"},{"spoiler":false,"text":"自分の美貌を鼻にかけない、というか、自らの美貌に気付いていない。"},{"spoiler":false,"text":"クアドラントの女性は軒並み美人揃いであり、その中で育ったため、美的感覚がズレている。"},{"spoiler":false,"text":"そのため、どう見ても変な、とてもかわいいとはいえないような物に対して「カワイイ！」を連呼する。（具体例：お化け屋敷の唐傘やぬりかべなど）"},{"spoiler":false,"text":"クアドラントの人口比率は、男女比1:10。女性は少ない男性を捕まえるために必死。"},{"spoiler":false,"text":"お国柄で女性が男性を誘い、夜這いをかけることも乙女のたしなみとされている。"},{"spoiler":false,"text":"王女である彼女もまたその慣例に習い、惚れたアタルに夜な夜な夜這いを仕掛けるのだが、様々な妨害に遭い、ずっと失敗続きである。"},{"spoiler":false,"text":"押しかけた理由が「夢の中でみたアタルに一目ぼれした」とは本人談。"},{"spoiler":false,"text":"「『夜這いは女の嗜み』と教わっております。お任せくださいな」"}],"source":"egs","sourceCharacterId":"11526","sourceWorkId":"14100","spoiler":false},{"segments":[{"spoiler":false,"text":"日本より小さい島国・クアドラント王国の王女様。"},{"spoiler":false,"text":"おっとりしていて、人当たりが良い。"},{"spoiler":false,"text":"クアドラントの女性は軒並み美人揃いであり、その中で育ったため、美的感覚がズレている。"},{"spoiler":false,"text":"そのため、どう見ても変でかわいいとは言えないような物に対して 「カワイイ！」 を連呼する。"},{"spoiler":false,"text":"お国柄で、女性が男性を誘うことが乙女のたしなみとされている。"},{"spoiler":false,"text":"王女である彼女もまたその慣例に習い、アタルに夜な夜な夜這いを仕掛けるのだが、妨害に遭い失敗続きである。"},{"spoiler":false,"text":"押しかけた理由が 「夢の中でみたアタルに一目ぼれした」 とは本人談。"},{"spoiler":false,"text":"「“夜這いは女の嗜み” と教わっております。お任せくださいな」"}],"source":"bangumi","sourceCharacterId":"56002"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"56002","value":"魚料理全般、アタル"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"56002","value":"特になし"},{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"11526","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"11526","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"11526","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"11526","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"11526","sourceWorkId":"14100","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f367bc501de76c061122bbc17013e6ca896c0928ead929b9c68ed381a96aba59.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d124ce4ed51d5c5ea8bc18034fc1e253ef80734fe21757449beed3fecb5f38d2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14267:56002:5928:1","source":"bangumi"}]},{"characterId":"char_c28322","characterName":"エリス･ラスコヴァン","sourceIds":{"bangumi":[{"characterId":"56003","match":"exact-normalized-name-in-linked-work","subjectId":"14267"}],"egsCharacterIds":["11527"],"vndbCharacterId":"c28322"},"originalCharacterName":"エリス･ラスコヴァン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"804"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ミルフィに仕える、軍人気質の付き人。"},{"spoiler":false,"text":"片目に眼帯をしているが、別に失明しているわけではない。"},{"spoiler":false,"text":"ミルフィのことが大好き。どんな時も（寝てる時であっても）ミルフィの側から片時も離れようとしない。"},{"spoiler":false,"text":"姫が死ねといえば本気で死ぬ。ミルフィと同じ部屋で過ごしている。"},{"spoiler":false,"text":"わがまま姫様の、面倒をみている苦労人なのだが、その苦労をまったく苦労とは思っていない。手のかかるほど可愛い。"},{"spoiler":false,"text":"手製のミルフィのぬいぐるみを持っている。手先は器用で、縫製はお手の物。"},{"spoiler":false,"text":"銃器をはじめとした武器のエキスパート。狙いをつけたら絶対に外さないのだが、何故かアタルにだけは不思議と当てられない。"},{"spoiler":false,"text":"「姫様の敵は全て自分の敵だ。情けなどかけない。微塵の容赦もしない」"}],"source":"egs","sourceCharacterId":"11527","sourceWorkId":"14100","spoiler":false},{"segments":[{"spoiler":false,"text":"ミルフィに仕える、軍人気質の付き人。"},{"spoiler":false,"text":"片目に眼帯をしているが、別に失明しているわけではない。"},{"spoiler":false,"text":"ミルフィのことが大好きで、どんな時もミルフィの側から離れようとしない。"},{"spoiler":false,"text":"わがまま姫の面倒をみるのは相当の苦労のはずだが、まったく苦に思っていない。手が掛かるほど可愛いらしい。"},{"spoiler":false,"text":"手製のミルフィぬいぐるみを持っている。手先は器用で、縫製はお手の物。"},{"spoiler":false,"text":"銃器をはじめとした武器のエキスパート。"},{"spoiler":false,"text":"狙いをつけたら絶対に外さないのだが、なぜかアタルにだけは不思議と当てられない。"},{"spoiler":false,"text":"「はぅぁぁ……姫様は本当に可愛らしくていらっしゃる……！」"}],"source":"bangumi","sourceCharacterId":"56003"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"56003","value":"ミルフィ"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"56003","value":"特になし"},{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"11527","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"11527","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"11527","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"11527","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"11527","sourceWorkId":"14100","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8c8b8a269fd6b17a7b009452493d7b78c5f591d1c3abd9df194ca1e68e03859.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03a60df460efee096a1c1d7d31ec9883a0e4e388acd04f6a76f63a6b554aebe7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14267:56003:6469:1","source":"bangumi"}]},{"characterId":"char_c28359","characterName":"アサリ","sourceIds":{"bangumi":[{"characterId":"56004","match":"exact-normalized-name-in-linked-work","subjectId":"14267"}],"egsCharacterIds":["11528"],"vndbCharacterId":"c28359"},"originalCharacterName":"アサリ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"222"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"70"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AA"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"73"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A quite mysterious person of unknown age, who is utterly devoted to Sera as her butler."},{"spoiler":false,"text":"She has cat ears on her head, but don't let that bother you."},{"spoiler":false,"text":"Try to touch them and she'll strangle you."},{"spoiler":false,"text":"She's always seen wearing a black sailor uniform, but don't let that bother you."},{"spoiler":false,"text":"That's just her costume."},{"spoiler":false,"text":"She has a tongue of pure acid, and is not one to mince words."},{"spoiler":false,"text":"She also sleeps a lot, often for more than half the entire day."},{"spoiler":false,"text":"One could almost doubt if she actually serves any purpose as a butler, but she has a strangely admirable tenacity for seeing to Sera's everyday necessities."},{"spoiler":false,"text":"\"My ears? Yes, of course, everybody has ears~."},{"spoiler":false,"text":"Huh? Whatever are you talking about~? I cannot understand you at all~.\""}],"source":"vndb","sourceCharacterId":"c28359"},{"segments":[{"spoiler":false,"text":"執事として、セーラに忠実に仕える、年齢不詳な謎多き人。"},{"spoiler":false,"text":"頭にネコ耳がついているが、気にしてはいけない。"},{"spoiler":false,"text":"触ろうとすると、触る前に締め上げられる。"},{"spoiler":false,"text":"常時服装は黒セーラーだが、気にしてはいけない。"},{"spoiler":false,"text":"それがアサリさんのコスチューム。"},{"spoiler":false,"text":"なぜか毒に詳しく、毒の話をよく持ち出す。"},{"spoiler":false,"text":"睡眠時間が長く、１日の半分以上は寝ている。"},{"spoiler":false,"text":"本当に執事としての仕事をしているのかと疑いたくなるのだが、不思議と見事にセーラの身の回りを世話している。"},{"spoiler":false,"text":"「耳？ はいー、誰でも耳はありますよねー。"},{"spoiler":false,"text":"え？ 何を言ってるんでしょー。全然わからないですー」"}],"source":"egs","sourceCharacterId":"11528","sourceWorkId":"14100","spoiler":false},{"segments":[{"spoiler":false,"text":"通称アサリさん。"},{"spoiler":false,"text":"執事としてセーラに仕える、年齢不祥な謎多き人。"},{"spoiler":false,"text":"頭にネコ耳がついているが、気にしてはいけない。触ろうとすると、触る前に締め上げられる。"},{"spoiler":false,"text":"常時服装は黒セーラーだが、気にしてはいけない。それがアサリさんのコスチューム。"},{"spoiler":false,"text":"なぜか毒に詳しい。"},{"spoiler":false,"text":"睡眠時間が長く、一日の半分以上は寝ている。"},{"spoiler":false,"text":"本当に執事としての仕事をしているのかと疑いたくなるのだが、不思議と見事にセーラの身の回りを世話している。"},{"spoiler":false,"text":"「はいー、アサリっていうんですよー♪　フレンドリーかつ気兼ねなく 『アサリ様』 とお呼びくださいねー♪」"}],"source":"bangumi","sourceCharacterId":"56004"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"56004","value":"寝ること"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"56004","value":"自分の言うことを聞かない人"},{"label":"胸围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"11528","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"aa","valueContext":null,"source":"egs","sourceCharacterId":"11528","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"148 cm","valueContext":null,"source":"egs","sourceCharacterId":"11528","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"73 cm","valueContext":null,"source":"egs","sourceCharacterId":"11528","sourceWorkId":"14100","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"11528","sourceWorkId":"14100","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c0a441d58011727d4553ec349d6985ae834bbb1edd3db30c7ebfcddaca4a518.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/fff9b8f0e76b5c256a3ab62d9759365a82ebe51b840fcaf7d1effb69974edc56.webp","width":213,"heig