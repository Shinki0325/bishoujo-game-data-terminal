","canonicalEntityId":"vndb:s13256","name":"MAGNUM","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:128145","source":"vndb"}]},"cast":[{"characterId":"char_c42834","characterName":"姫星 アリカ","sourceIds":{"bangumi":[{"characterId":"51417","match":"exact-normalized-name-in-linked-work","subjectId":"163120"}],"egsCharacterIds":["9094"],"vndbCharacterId":"c42834"},"originalCharacterName":"姫星 アリカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"裏の世界ではその名を知らない者はいないとまでいわれるとある巨大組織のボスに、実の孫娘同然に寵愛されている少女。"},{"spoiler":false,"text":"主人公の秘密を知る唯一の人物であり鳳鐘女学院の中にあって、特別異彩を放つ天真爛漫なお嬢様。"},{"spoiler":false,"text":"退屈と窮屈をなにより嫌い、自由と自分らしさを好む。"},{"spoiler":false,"text":"主人公と共に「恋愛部」を設立し恋をしらないお嬢様達に、恋愛の素晴らしさを広めるべく日々お嬢様らしからぬ画策を巡らせている。"}],"source":"egs","sourceCharacterId":"9094","sourceWorkId":"23053","spoiler":false},{"segments":[{"spoiler":false,"text":"創の秘密を知る唯一の人物。 鳳鐘女学院において特別異彩を放つ天真爛漫なお嬢様。"},{"spoiler":false,"text":"退屈と窮屈を何より嫌い、自由と自分らしさを好むと同時に、"},{"spoiler":false,"text":"お嬢様としての立場に縛られる子たちをなんとかしてあげたいと考えている。"},{"spoiler":false,"text":"「ねえハジメくん、私と秘密の取引をしませんか？」"}],"source":"bangumi","sourceCharacterId":"51417"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eaff855cdcbb0c564f303217aea6903a9ec7093d27f0b64ad28419ede1eb66b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff6347246078bb777be689952abac4bb8e761f790f91d8739ff74a7523fc8d6b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ミルノ純","creatorId":"vndb:s564","sourcePersonId":"vndb:s564","canonicalEntityId":"vndb:s564","name":"ミルノ 純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:163120:51417:6167:1","source":"bangumi"}]},{"characterId":"char_c46281","characterName":"ポリーナ・コッペリア","sourceIds":{"bangumi":[{"characterId":"51418","match":"exact-normalized-name-in-linked-work","subjectId":"163120"}],"egsCharacterIds":["9095"],"vndbCharacterId":"c46281"},"originalCharacterName":"ポリーナ・コッペリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"＜マーウェポーレ＞という欧州の小国から、賓客として鳳鐘女学院に留学してきた正真正銘のお姫様。"},{"spoiler":false,"text":"親しい者からはペコという愛称で呼ばれている。"},{"spoiler":false,"text":"小さな身なりながら、王族に相応しい品格と人格の持ち主で鳳鐘女学院のお嬢様達からも尊敬の念を集めている。"},{"spoiler":false,"text":"しかし周囲の評判とは裏腹に、本国の経済状況は貧しており彼女自身、周囲からの評価と、自国の窮状のギャップに苦しんでいる。"}],"source":"egs","sourceCharacterId":"9095","sourceWorkId":"23053","spoiler":false},{"segments":[{"spoiler":false,"text":"マーウェポーレ という欧州の小国から賓客として留学してきた正真正銘のお姫様。"},{"spoiler":false,"text":"親しい者からは、ペコ という愛称で呼ばれている。"},{"spoiler":false,"text":"本国の経済状況は厳しく、自身の高い評価と自国の窮状のギャップに苦しんでいる。"},{"spoiler":false,"text":"「日本も、鳳鐘も大好きです、わたし」"}],"source":"bangumi","sourceCharacterId":"51418"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/130a506b98ee9745c37e74d48b3582247c2fb5a5ef3d4ad272a4309e74819f3d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/5367d606f2de8e44757e1583189830616ee28888b6e99805ccf0dbf2a575f413.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:163120:51418:11646:1","source":"bangumi"}]},{"characterId":"char_c46284","characterName":"一ツ橋 紅緒","sourceIds":{"bangumi":[{"characterId":"51419","match":"exact-normalized-name-in-linked-work","subjectId":"163120"}],"egsCharacterIds":["9096"],"vndbCharacterId":"c46284"},"originalCharacterName":"一ツ橋 紅緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"由緒正しい武家の血筋を受け継ぐ、名家のお嬢様。"},{"spoiler":false,"text":"一橋流という名実ともにトップクラスの剣術道場の師範代でもあり生粋のお嬢様でありながら男顔負けの凄腕で、日々黙々と剣術の研鑽に勉めている。"},{"spoiler":false,"text":"折り目正しく正義感に溢れ、自分にも他人にも厳しい性格をしておりアリカとはある意味真逆のタイプ。"}],"source":"egs","sourceCharacterId":"9096","sourceWorkId":"23053","spoiler":false},{"segments":[{"spoiler":false,"text":"由緒正しい武家の血筋を受け継ぐ、名家のお嬢様。"},{"spoiler":false,"text":"生粋のお嬢様でありながら男顔負けの凄腕で、日々黙々と剣術の研鑽に勉めている。"},{"spoiler":false,"text":"剣術の腕に自信はあるものの、お嬢様としての自分には自信が持てないでいる。"},{"spoiler":false,"text":"「フン。 どうせ、私の頭の中には剣道の事しかないわよ」"}],"source":"bangumi","sourceCharacterId":"51419"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eaeddb37826a30d2355ce3ef87b23ff8221db079e5a40af790f39af033ec4338.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60aabfe156f9cb465e09a9687c0ed571974820f51598675193b8d4191139ba63.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瀬戸千晴","creatorId":"vndb:s3220","sourcePersonId":"vndb:s3220","canonicalEntityId":"vndb:s3220","name":"春山色葉","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:163120:51419:19142:1","source":"bangumi"}]},{"characterId":"char_c46411","characterName":"近江 紫","sourceIds":{"bangumi":[{"characterId":"51420","match":"exact-normalized-name-in-linked-work","subjectId":"163120"}],"egsCharacterIds":["9097"],"vndbCharacterId":"c46411"},"originalCharacterName":"近江 紫","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"女学院の剣道部に所属する、無口でどこかつかみどころのない不思議なお嬢様。"},{"spoiler":false,"text":"一橋流門下でもあるため、なにをするにも一ッ橋紅緒にべったりで彼女の付き人のように、どこへ行くにも一緒。"},{"spoiler":false,"text":"誰よりも紅緒を慕い、自分よりも常に紅緒の事を考えている。"}],"source":"egs","sourceCharacterId":"9097","sourceWorkId":"23053","spoiler":false},{"segments":[{"spoiler":false,"text":"学院の剣道部に所属する、無口でどこか掴み所のない不思議なお嬢様。"},{"spoiler":false,"text":"一橋流門下なため何をするにも紅緒にべったりで、どこへ行くにも常に一緒。"},{"spoiler":false,"text":"誰よりも紅緒を慕うが、それゆえに隠し事をしていることを悩んでいる。"},{"spoiler":false,"text":"「紅緒様に仇なす者は、疾く排除します」"}],"source":"bangumi","sourceCharacterId":"51420"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2ecdd663a327ceadd8651a3bef5a54fe68dce05578bed406d4a734dd4d777a30.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1123dfee0469f1b84a9aeb75b3768bced0c1ee6e75e99cde3150729af2861f1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:163120:51420:4727:1","source":"bangumi"}]},{"characterId":"char_c46412","characterName":"藤原 赤穂","sourceIds":{"bangumi":[{"characterId":"51421","match":"exact-normalized-name-in-linked-work","subjectId":"163120"}],"egsCharacterIds":["9098"],"vndbCharacterId":"c46412"},"originalCharacterName":"藤原 赤穂","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学院の風紀を護る為に粉骨砕身するお嬢様。"},{"spoiler":false,"text":"風紀執行委員長に就任しており、規律に厳しく、日々お嬢様とはかくあるべしと自他共に強いている。"},{"spoiler":false,"text":"銀子に心酔しており、逆に天真爛漫で破天荒なアリカを目の敵にしている。"}],"source":"egs","sourceCharacterId":"9098","sourceWorkId":"23053","spoiler":false},{"segments":[{"spoiler":false,"text":"学院の風紀を守るために粉骨砕身するお嬢様。"},{"spoiler":false,"text":"風紀執行委員長であり、日々お嬢様とはかくあるべしと自他共に強いている。"},{"spoiler":false,"text":"銀子に心酔しており、天真爛漫で破天荒なアリカを目の敵にしている。"},{"spoiler":false,"text":"「ああもう、鳳鐘の一員ともあろう者が嘆かわしい……！」"}],"source":"bangumi","sourceCharacterId":"51421"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/8283e21515938aa25c6e062439ec3a9a4c2d0e65dee36faa3779bb76fcd0db68.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a3edbafea1e02fe6730168fc1d99bc1f6e4f8c22b4a5129c991d2bffd00ae10.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"清水美紗","creatorId":"vndb:s1975","sourcePersonId":"vndb:s1975","canonicalEntityId":"vndb:s1975","name":"よもぎかすみ(蓬かすみ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:163120:51421:21151:1","source":"bangumi"}]},{"characterId":"char_c46413","characterName":"皇坂 銀子","sourceIds":{"bangumi":[{"characterId":"51422","match":"exact-normalized-name-in-linked-work","subjectId":"163120"}],"egsCharacterIds":["9099"],"vndbCharacterId":"c46413"},"originalCharacterName":"皇坂 銀子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"前年度のハイネスにして、圧倒的な美貌とカリスマを備えた、まさにお嬢様の中のお嬢様。"},{"spoiler":false,"text":"男装の麗人と見まごう精悍な立ち居振る舞いもあって、学院中の生徒達から絶大なる人気を誇っている。"},{"spoiler":false,"text":"だが、あまりに才気に溢れているが故に、孤独でもありいつか自分に並び立つ者が現れないかと切望しつつ、王者としての無聊を託つ日々を送っている。"}],"source":"egs","sourceCharacterId":"9099","sourceWorkId":"23053","spoiler":false},{"segments":[{"spoiler":false,"text":"学院で絶大なる人気を誇る、圧倒的な美貌とカリスマを備えたお嬢様。"},{"spoiler":false,"text":"あまりに才気にあふれているがゆえに孤独でもあり、"},{"spoiler":false,"text":"いつか自分に並び立つ者が現れないか切望しつつ、退屈な日々を送っている。"},{"spoiler":false,"text":"「キミは私を“王子”扱いしないでくれるんだろう？」"}],"source":"bangumi","sourceCharacterId":"51422"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2cdb9ea662a6d006d541fbfa97e51100beedc05f1c56e425082e25660198738d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e713272d7de47ac25b8763476c9d0e659a2a927f345743bb6f925323de8c19b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中島裕美子","creatorId":"vndb:s1119","sourcePersonId":"vndb:s1119","canonicalEntityId":"vndb:s1119","name":"中島 裕美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:163120:51422:5019:1","source":"bangumi"}]},{"characterId":"char_c46434","characterName":"斯波 義春","sourceIds":{"bangumi":[{"characterId":"51424","match":"exact-normalized-name-in-linked-work","subjectId":"163120"}],"egsCharacterIds":["9101"],"vndbCharacterId":"c46434"},"originalCharacterName":"斯波 義春","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学院の茶道部に所属している、おっとりほんわかしたお嬢様。"},{"spoiler":false,"text":"見た目も性格も、まさにお嬢様といった雰囲気だが最近、頓に性的なモノへの興味が尽きない自分に困惑しつつ胸の高まりを抑えきれない日々を送っている。"}],"source":"egs","sourceCharacterId":"9101","sourceWorkId":"23053","spoiler":false},{"segments":[{"spoiler":false,"text":"学院の茶道部に所属している、おっとりほんわかしたお嬢様。"},{"spoiler":false,"text":"まさに生粋のお嬢様といった風格だが、最近 性的なモノへの興味が尽きず、"},{"spoiler":false,"text":"困惑しつつも胸の高鳴りを抑えきれない日々を送っている。"},{"spoiler":false,"text":"「お願いです。 その、創さんに教えてもらいた