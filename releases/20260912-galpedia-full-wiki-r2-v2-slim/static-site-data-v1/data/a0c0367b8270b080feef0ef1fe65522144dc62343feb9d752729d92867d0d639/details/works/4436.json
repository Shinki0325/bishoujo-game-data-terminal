uto-confirmed","relationId":"egs:work-creator:19297","source":"egs"}],"music":[{"creditedName":"NEY","creatorId":"vndb:s3270","sourcePersonId":"egs:creator:4564","canonicalEntityId":"vndb:s3270","name":"NEY","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:16579","source":"egs"},{"creditedName":"Shade","creatorId":"vndb:s511","sourcePersonId":"egs:creator:957","canonicalEntityId":"vndb:s511","name":"Shade","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:19298","source":"egs"}],"other":[{"creditedName":"豊田瀬莉香","creatorId":"egs:creator:12576","sourcePersonId":"egs:creator:12576","canonicalEntityId":"egs:creator:12576","name":"豊田瀬莉香","detail":"挿入歌「A Night Come’s!」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"no-alias-hit","relationId":"egs:work-creator:177483","source":"egs"},{"creditedName":"Duca","creatorId":"vndb:s386","sourcePersonId":"egs:creator:12492","canonicalEntityId":"vndb:s386","name":"Duca","detail":"挿入歌「Blue Planet」「Square Of The Moon」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:71979","source":"egs"}]},"cast":[{"characterId":"char_c368","characterName":"ホワイトファング","sourceIds":{"bangumi":[{"characterId":"10759","match":"exact-normalized-name-in-linked-work","subjectId":"11159"}],"egsCharacterIds":["12809"],"vndbCharacterId":"c368"},"originalCharacterName":"ホワイトファング","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"16"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rouga is a man with a strong sense of justice who enjoys a good fight and fine women. With a strong body and great reflexes, he seeks to dominate the entire nation."},{"spoiler":false,"text":"He was trained by his older brother, Zanma Gou. And while Rouga often is annoyed by Gou's antics and tend to punch him into oblivion, he does heed his brother's advice and show a degree of respect for him."},{"spoiler":false,"text":"Rouga is betrothed to Tenrou Kunagi, and cares quite a bit for her. Although that does not seem to stop him from loving other women as well."},{"spoiler":false,"text":"Edited from Alice Soft wiki"}],"source":"vndb","sourceCharacterId":"c368"},{"segments":[{"spoiler":false,"text":"大番長の主人公。女好きでケンカ好きの正義漢。"},{"spoiler":false,"text":"優れた身体能力と反射神経の持ち主で、全国制覇を目指している。"},{"spoiler":false,"text":"白い学ラン姿でケンカをしている内に、"},{"spoiler":false,"text":"いつしかホワイトファング（白狼牙）のあだ名が付けられる。"}],"source":"egs","sourceCharacterId":"12809","sourceWorkId":"3178","spoiler":false},{"segments":[{"spoiler":false,"text":"本編の主人公で、聖城学園に転校して来た特体生。"},{"spoiler":false,"text":"ホワイトファングの呼び名を持つ。"},{"spoiler":false,"text":"同じクラスの「日比生咲苗」「陣内兵太」「成瀬有紀」と共に、"},{"spoiler":false,"text":"聖城学園の番長「闇崎アキト」のグループと対抗する事になる。"},{"spoiler":false,"text":"「斬真豪」という兄あり。 全国制覇を目指している。"}],"source":"bangumi","sourceCharacterId":"10759"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbfd877683c96ddcdd02faa87e44f5ace8a7b472daa9e9236877f616c5417ee3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b9fd3786c1c6071a710cc9663bfa61012cb13be40548220605cea021492f8fe.webp","width":156,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p120","sourceCompanyId":"egs:brand:30","canonicalEntityId":"vndb:p120","name":"ALICESOFT","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:4436:30","source":"egs"},{"companyId":"vndb:p120","sourceCompanyId":"vndb:p120","canonicalEntityId":"vndb:p120","name":"アリスソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:4806:v30469","source":"v