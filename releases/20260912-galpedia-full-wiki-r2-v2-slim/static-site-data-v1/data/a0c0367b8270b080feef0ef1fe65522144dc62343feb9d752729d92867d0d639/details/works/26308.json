,"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"66"}},"descriptions":[{"segments":[{"spoiler":false,"text":"虎視眈々とボスの座を狙っている新参者。"},{"spoiler":false,"text":"ジャンも顔を見たことがあるだけで、彼のことを詳しくは知らないが、"},{"spoiler":false,"text":"のし上がるためには仲間を次々と蹴落とすことで有名。"},{"spoiler":false,"text":"しれっと嘘をつき、後は知らぬ存ぜぬで押し通す。"},{"spoiler":false,"text":"若くして登りつめただけあって野心は強く、強引なところも。"},{"spoiler":false,"text":"無駄口が多く、他のキャラクターより切れやすいため、"},{"spoiler":false,"text":"わりと足を引っ張るタイプ。"},{"spoiler":false,"text":"ジャンのことを微妙に利用しようとしている節もある。"},{"spoiler":false,"text":"基本、自分より弱いものに対しては、かなり高圧的で攻撃的。"}],"source":"bangumi","sourceCharacterId":"14928"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97aceab5d015740c4034c56fdc9e6242ee82272d475184ab7469809142bb93c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/245cc8b1cb44e1b1cd9156a584dac4d0170b0f6a75f420b6830d73d6f0cb7250.webp","width":104,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平川大輔","creatorId":"vndb:s133","sourcePersonId":"vndb:s133","canonicalEntityId":"vndb:s133","name":"平川 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:32725:14928:4452:1","source":"bangumi"}]},{"characterId":"char_bangumi_14929","characterName":"Bernardo Ortolani","sourceIds":{"bangumi":[{"characterId":"14929","match":"source-roster","subjectId":"13139"},{"characterId":"14929","match":"source-roster","subjectId":"24811"},{"characterId":"14929","match":"source-roster","subjectId":"24955"},{"characterId":"14929","match":"source-roster","subjectId":"32725"}]},"originalCharacterName":"Bernardo Ortolani","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","v