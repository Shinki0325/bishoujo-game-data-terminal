nal-wiki/v1/characters/v1/images/af/af4616f7c2863bb2acd986b0cc8d65faf496380ae4a4b3fa224d23d829f3325a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"カンザキカナリ","creatorId":"vndb:s1000","sourcePersonId":"vndb:s1000","canonicalEntityId":"vndb:s1000","name":"カンザキ カナリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:260845:202736:24747:1","source":"bangumi"}]},{"characterId":"char_c74605","characterName":"宮越 恵子","sourceIds":{"bangumi":[{"characterId":"202737","match":"exact-normalized-name-in-linked-work","subjectId":"260845"}],"egsCharacterIds":["27260"],"vndbCharacterId":"c74605"},"originalCharacterName":"宮越 恵子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"霧端家に傅くメイドのひとり。"},{"spoiler":false,"text":"性格はクールで高飛車。"},{"spoiler":false,"text":"屋敷の女主人・さやかに絶対の忠誠を誓い、その言動や振る舞いもさやかと似て、他人を小馬鹿にしたような態度が目立つ。"}],"source":"egs","sourceCharacterId":"27260","sourceWorkId":"3331","spoiler":false},{"segments":[{"spoiler":false,"text":"妖艶な年上のメイド。"},{"spoiler":false,"text":"西洋のメイド姿と人を小馬鹿にした態度が特徴の女性。"},{"spoiler":false,"text":"身も心も「さやか」の支配下にあり、その為か言動や考え方まで"},{"spoiler":false,"text":"さやかの分身とも言えるほど似通っている。"}],"source":"bangumi","sourceCharacterId":"202737"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b08677843d5f2c03d480b4e5fb8f90a708b33bba5943f4b2eba3ac0ddd31743e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f7f5fff0f3a844491112673e80e6006fc7422a99cd13001c68be8c65ae7b9ec.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あらいしずか","creatorId":"vndb:s665","sourcePersonId":"vndb:s665","canonicalEntityId":"vndb:s665","name":"あらい しずか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:260845:202737:4647:1","source":"bangumi"}]},{"characterId":"char_c74606","characterName":"木々野 ユキ","sourceIds":{"bangumi":[{"characterId":"202738","match":"exact-normalized-name-in-linked-work","subjectId":"260845"}],"egsCharacterIds":["27261"],"vndbCharacterId":"c74606"},"originalCharacterName":"木々野 ユキ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"霧端家に傅くメイドのひとり。"},{"spoiler":false,"text":"おどおどした感じの気弱そうな女の子。"},{"spoiler":false,"text":"外見や話し方等に、まだ幼さが残っているものの、与えられた仕事をしっかりとこなす。"},{"spoiler":false,"text":"西洋の衣服に未だ慣れず、仕方なく自分の着物を代用している。"}],"source":"egs","sourceCharacterId":"27261","sourceWorkId":"3331","spoiler":false},{"segments":[{"spoiler":false,"text":"館の下女。"},{"spoiler":false,"text":"外見＆年齢相応に話し方や動作に幼さは残っているものの、"},{"spoiler":false,"text":"与えられた仕事はしっかりこなす。"},{"spoiler":false,"text":"洋装に慣れず、仕方なく自分の持っていた着物を着ている。"}],"source":"bangumi","sourceCharacterId":"202738"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c41a9dcd424a229df31e6fcb3b3326f50599faf219abf504b037f1d334d4817.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14622aa4b339e914913067803cc23c908b31d42c64eda3347e76dc6ab90e996c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あおきさやか","creatorId":"vndb:s194","sourcePersonId":"vndb:s194","canonicalEntityId":"vndb:s194","name":"あおき さやか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:260845:202738:4869:1","source":"bangumi"}]},{"characterId":"char_vndb_c102367","characterName":"田村 達也","sourceIds":{"vndbCharacterId":