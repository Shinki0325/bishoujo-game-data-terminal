etail":"OP曲「FAMIFAMI☆」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:64349","source":"egs"},{"creditedName":"民安 ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:34186","source":"vndb"}]},"cast":[{"characterId":"char_c82639","characterName":"望月 桜","sourceIds":{"bangumi":[{"characterId":"134450","match":"exact-normalized-name-in-linked-work","subjectId":"217507"}],"egsCharacterIds":["25734"],"vndbCharacterId":"c82639"},"originalCharacterName":"望月 桜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"メインヒロインっぽい娘"},{"spoiler":false,"text":"凄まじいドジっぷりを誇る、主人公が通う学園の下級生。"},{"spoiler":false,"text":"明るく前向きな努力家だが、精神的に未熟な部分があり、失敗して叱られたりすると、どん底まで落ち込むこともしばしば。"},{"spoiler":false,"text":"夢は、世界一のファミレスマスター!!"},{"spoiler":false,"text":"……なのだが、その道は果てしなく遠い。"}],"source":"egs","sourceCharacterId":"25734","sourceWorkId":"7297","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公よりひとつ下の下級生。"},{"spoiler":false,"text":"基本的に明るく前向き努力家な女の子。だけど、まだまだ精神的には未熟なトコがあり、失敗して怒られたりすると派手に落ち込むこともしばしば。"},{"spoiler":false,"text":"また、凄まじいほどのドジっぷりだが、どうにか日常生活は普通におくれているようだ…。"},{"spoiler":false,"text":"夢は世界一のファミレスマスター！"}],"source":"bangumi","sourceCharacterId":"134450"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c500f9f74121cbe1cdd716a1cee042bea4afe04c1d9707e613b8d042052512d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/909d5ab7a451746f711fc3c0c4499f0598632c9977425740f1ac07d51acad25f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"綾川りの","creatorId":"vndb:s1054","sourcePersonId":"vndb:s1054","canonicalEntityId":"vndb:s1054","name":"綾川 りの","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217507:134450:6323:1","source":"bangumi"}]},{"characterId":"char_c82640","characterName":"観音寺 香","sourceIds":{"bangumi":[{"characterId":"134451","match":"exact-normalized-name-in-linked-work","subjectId":"217507"}],"egsCharacterIds":["25735"],"vndbCharacterId":"c82640"},"originalCharacterName":"観音寺 香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いじっぱりなツンデレ娘"},{"spoiler":false,"text":"財閥令嬢のツンデレ同級生。"},{"spoiler":false,"text":"現在、経済市場の最先端であるファミレス市場を勉強するため、アリス・ミラー・スクールに入学。"},{"spoiler":false,"text":"貴族育ちで、世間ズレしているのだが、本人は気にせず恥じらいを見せない。"},{"spoiler":false,"text":"なので、主人公の方が赤面するような行為をすることもしばしば。"}],"source":"egs","sourceCharacterId":"25735","sourceWorkId":"7297","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の同級生。財閥令嬢。ツンデレの超お嬢様。"},{"spoiler":false,"text":"今や経済市場で最先端となったファミレス市場を勉強するために入学してきた。気位が高く他人を見下しているが、そのくせ貴族育ちなので一人では何もできない。"},{"spoiler":false,"text":"世間ズレしているにも関らず、威風堂々としており、また、余りにも恥じらいがないので、主人公のほうが赤面することもしばしば。"}],"source":"bangumi","sourceCharacterId":"134451"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f969f071be8c4308a296a1fe5b61e99e63386cea7faa38e361d1d96b7e6c5e5b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19c0aa2836cd32089c8a0e23c8029d6b82ddd16d54c48bee28f3974f99828d5c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐久間紅美","creatorId":"vndb:s1145","sourcePersonId":"vndb:s1145","canonicalEntityId":"vndb:s1145","name":"佐久間 紅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217507:134451:4499:1","source":"bangumi"}]},{"characterId":"char_c82641","characterName":"佐藤 みるく","sourceIds":{"bangumi":[{"characterId":"134452","match":"exact-normalized-name-in-linked-work","subjectId":"217507"}],"egsCharacterIds":["25736"],"vndbCharacterId":"c82641"},"originalCharacterName":"佐藤 みるく","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"甘えさせてくれる癒しのお姉さん"},{"spoiler":false,"text":"微笑みを絶やさない、母性溢れる巨乳お姉さん。"},{"spoiler":false,"text":"彼女に癒されたいがため、リピートになる男性客は数知れず。"},{"spoiler":false,"text":"実は天才肌で、主人公の厳しい（？）レッスンも、マイペースでなんとな～く乗り切ってしまったりする。"},{"spoiler":false,"text":"ごく普通の家の子で、風変りな身の上話などないように見えるが……。"}],"source":"egs","sourceCharacterId":"25736","sourceWorkId":"7297","spoiler":false},{"segments":[{"spoiler":false,"text":"常に微笑みを絶やさない巨乳な女の子。"},{"spoiler":false,"text":"そのうえ、母乳が噴き出すほどの母性の持ち主。"},{"spoiler":false,"text":"その笑顔に癒され、彼女目当てに訪れる男性客も多数いるほどだ。 本人はそんなことは露知らず、いつも常にマイペース。そのマイペースぶりで、つらい教育もなんとな～くで乗り切る、天才肌。"},{"spoiler":false,"text":"とはいえ、ごくごくフツーの家の子なので、風変わりな身の上話などはないようだが…。"}],"source":"bangumi","sourceCharacterId":"134452"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91e6d214890b4225dcfac808f677213f95e95b85d5fa85d0f08c7245598c5065.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6ef6e0b60e35ef584d4d2159228640346b1397953764ec76124dc99e175db3a6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217507:134452:4714:1","source":"bangumi"}]},{"characterId":"char_c82642","characterName":"メリッサ・アイリーン・タカハシ","sourceIds":{"bangumi":[{"characterId":"134453","match":"exact-normalized-name-in-linked-work","subjectId":"217507"}],"egsCharacterIds":["25737"],"vndbCharacterId":"c82642"},"originalCharacterName":"メリッサ・アイリーン・タカハシ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"とらぶるめ～か～"},{"spoiler":false,"text":"飛び級でイギリス本校のマスターコースを修了し、日本校に派遣された天才。"},{"spoiler":false,"text":"大人ぶって見せるが、主人公や他の女の子より年下でロリっ娘体型。"},{"spoiler":false,"text":"イギリス人の母と日本人の父を持つハーフだが、本人はどうでもよいらしく、"},{"spoiler":false,"text":"自分の名前も、マリコでも、マイコでも。マチコでも、メアリでも気にしない。"}],"source":"egs","sourceCharacterId":"25737","sourceWorkId":"7297","spoiler":false},{"segments":[{"spoiler":false,"text":"イギリス人の母と日本人の父を持つハーフ。"},{"spoiler":false,"text":"飛び級でイギリス本校のマスターコースを修了し、日本校に派遣されて来た。教師だが主人公やヒロインたちよりも年下。"},{"spoiler":false,"text":"また、本人は特にハーフとかそんなものは全く気にしておらず、自分の名前すらもマリコでもマイコでもマチコでもメアリでも気にしていない。"}],"source":"bangumi","sourceCharacterId":"134453"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61e0860cc0460094a2bdecc05395db014329f8e558d501fbf48e182a4d4b24fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/6812af5c9096a6c43592ea9dd8e4dd8bcd3564f66495c0757e8fdfc1e6431200.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217507:134453:5900:1","source":"bangumi"}]},{"characterId":"char_vndb_c82755","characterName":"真辺 アズサ","sourceIds":{"vndbCharacterId":"c82