{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"11355","model":{"presentationWorkId":"vndb:v1944","staff":{"artwork":[{"creditedName":"広崎悠意","creatorId":"vndb:s2026","sourcePersonId":"egs:creator:986","canonicalEntityId":"vndb:s2026","name":"広崎悠意","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:78200","source":"egs"}],"scenario":[{"creditedName":"広崎悠意","creatorId":"vndb:s2026","sourcePersonId":"egs:creator:986","canonicalEntityId":"vndb:s2026","name":"広崎悠意","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:78201","source":"egs"}],"music":[],"other":[{"creditedName":"水瀬拓未","creatorId":"vndb:s2606","sourcePersonId":"egs:creator:13465","canonicalEntityId":"vndb:s2606","name":"水瀬拓未","detail":"デモムービー、オープニングムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:219505","source":"egs"},{"creditedName":"水瀬 拓未","creatorId":"vndb:s2606","sourcePersonId":"vndb:s2606","canonicalEntityId":"vndb:s2606","name":"水瀬 拓未","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:29795","source":"vndb"}]},"cast":[{"characterId":"char_c125500","characterName":"瑞樹 詩織","sourceIds":{"bangumi":[{"characterId":"57510","match":"exact-normalized-name-in-linked-work","subjectId":"224091"}],"egsCharacterIds":["16672"],"vndbCharacterId":"c125500"},"originalCharacterName":"瑞樹 詩織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公に調教される女子学生。"},{"spoiler":false,"text":"父親は教師をしており、学校では優等生的な存在で、性格も明るく、快活。"},{"spoiler":false,"text":"しかし、苛めに遭っていた友人を見捨てる言動をしてしまったことがきかっけとなって、友人は自殺。"},{"spoiler":false,"text":"罪の意識に苛まれ、精神的に追い込まれた彼女は自殺を考えるようになった。"},{"spoiler":false,"text":"山荘に連れて来られ、主人公に凌辱されるが、それも自分への罰と思い、受け入れ難い状況に耐え忍んでいる。"},{"spoiler":false,"text":"死を覚悟したためか、主人公に対してはっきりとした物言いをする。"}],"source":"egs","sourceCharacterId":"16672","sourceWorkId":"11355","spoiler":false},{"segments":[{"spoiler":false,"text":"父親は教師。優秀で快活な学生であったが、"},{"spoiler":false,"text":"イジメに遭っている友人を見捨てる言動をしてしまい、友人は自殺。"},{"spoiler":false,"text":"罪の意識に苛まれるうち疲弊して後追い自殺を考えていた。"},{"spoiler":false,"text":"山荘に連れて来られたのを自分への罰とも考え、受け入れがたい状況に耐えている。"},{"spoiler":false,"text":"大人しそうな外見だが、一度は死をも決意したためか、主人公に対する物言いははっきりしている。"},{"spoiler":false,"text":"調教と称して自分を襲う主人公に対し、その人間的弱さを指摘する。"}],"source":"bangumi","sourceCharacterId":"57510"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aab088c940016ec4f7447c833c4c7813758c0452a1540b5cff0fabe5e15d9fa5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31735825287cba83fa3c85611d6111be2512d6135f17f9afb8bd0ca921c049fa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青井 美海","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15791","source":"vndb"}]},{"characterId":"char_c125502","characterName":"木暮 美央","sourceIds":{"bangumi":[{"characterId":"57511","match":"exact-normalized-name-in-linked-work","subjectId":"224091"}],"egsCharacterIds":["16673"],"vndbCharacterId":"c125502"},"originalCharacterName":"木暮 美央","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"自殺を考えている主人公と詩織を山荘に連れてきた女性。"},{"spoiler":false,"text":"いつも含みのある笑みを浮かべ、主人公とのやり取りや言動において、何処か浮世離れしており、時としてユーモラスささえも感じさせる。"},{"spoiler":false,"text":"主人公に少女を調教するように依頼した理由は、その調教を記録させて、それを売るのが目的と話しているが、本当の理由は解らない。"}],"source":"egs","sourceCharacterId":"16673","sourceWorkId":"11355","spoiler":false},{"segments":[{"spoiler":false,"text":"自殺を考えている秀一と詩織を山荘に連れてきた女性。"},{"spoiler":false,"text":"秀一に調教の記録をつけさせ、それを売るのが目的と言っているが、本当の目的は謎。"},{"spoiler":false,"text":"ここに男女を招く役割を、調教を終えた女が代々引き継いでいるとも考えられる。"},{"spoiler":false,"text":"年齢は不詳だが詩織とそう違わないように見える。"},{"spoiler":false,"text":"いつも含みのある笑みを浮かべ、言動は時として浮世離れしており、"},{"spoiler":false,"text":"主人公とのやりとりは時としてユーモラスでさえある。"}],"source":"bangumi","sourceCharacterId":"57511"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/acf561dcb60d864749ca4c1a07f9ce12f2ff7d5e2475a8d1ffaa8a225be1cfea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84d6818df4f0d8cc691597ab80bed5ae4dcb64f107e6bb4b902835e40ae27dc6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"来栖 空良","creatorId":"vndb:s33153","sourcePersonId":"vndb:s33153","canonicalEntityId":"vndb:s33153","name":"来栖 空良","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15792","source":"vndb"}]},{"characterId":"char_vndb_c125503","characterName":"小野寺 秀一","sourceIds":{"vndbCharacterId":"c125503"},"originalCharacterName":"小野寺 秀一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p754","sourceCompanyId":"egs:brand:2420","canonicalEntityId":"vndb:p754","name":"暗黒劇場","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:11355:2420","source":"egs"},{"companyId":"vndb:p754","sourceCompanyId":"vndb:p754","canonicalEntityId":"vndb:p754","name