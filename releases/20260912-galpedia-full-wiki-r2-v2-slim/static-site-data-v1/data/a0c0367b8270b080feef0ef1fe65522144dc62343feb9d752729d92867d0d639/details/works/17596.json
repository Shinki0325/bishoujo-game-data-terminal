:false},{"segments":[{"spoiler":false,"text":"市位家を支える母。"},{"spoiler":false,"text":"のはずだが母親らしいことはあまりせず、家事は主人公らに押し付け任せている。"},{"spoiler":false,"text":"よく当たると評判の占い師らしいが、家計は謎に包まれている。"},{"spoiler":false,"text":"ダイナマイト（古）なボディで、くねくね尻を振って歩く。"},{"spoiler":false,"text":"「仲が良くて微笑ましい限りじゃない？　怒るのもめんどくさいし」"}],"source":"bangumi","sourceCharacterId":"49141"}],"profileFacts":[{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"7968","sourceWorkId":"17596","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"cupSize":[{"comparisonValue":"g","source":"vndb","sourceCharacterId":"c32848","value":"G"},{"comparisonValue":"g","scope":"sourceWork","source":"egs","sourceCharacterId":"7968","sourceWorkId":"17596","value":"G"},{"comparisonValue":"gカップ","source":"bangumi","sourceCharacterId":"49141","value":"Gカップ"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89f7386d0f30c1f88561a5947accf5202640358b3ed267c695c1332283037584.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e2ef7686db59ae9fae0c45018816e896fb91f0291e8389d468a72bad7d993ed.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藍川珪","creatorId":"vndb:s872","sourcePersonId":"vndb:s872","canonicalEntityId":"vndb:s872","name":"藍川珪","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:198759:49141:14421:1","source":"bangumi"}]},{"characterId":"char_c32849","characterName":"姫野 二季","sourceIds":{"bangumi":[{"characterId":"49142","match":"exact-normalized-name-in-linked-work","subjectId":"198759"}],"egsCharacterIds":["7969"],"vndbCharacterId":"c32849"},"originalCharacterName":"姫野 二季","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1012"},"bust":{"reviewState":"source-only","s