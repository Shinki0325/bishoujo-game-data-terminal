向きはコンピューターのプログラマー。裏の顔は凄腕のエージェントという噂。"},{"spoiler":false,"text":"プロとしての非常さを持ちながらも、今は大事な弟を守るために命懸けで闘う!? 彼女は敵なのか？味方なのか？"}],"source":"bangumi","sourceCharacterId":"49136"},{"segments":[{"spoiler":false,"text":"主人公らの通う学園の、保健室の先生。"},{"spoiler":false,"text":"学生の恋愛相談にのることも多く、男女問わず人気がある。"},{"spoiler":false,"text":"時折気になる発言をしたり、謎の多い女性。"},{"spoiler":false,"text":"「ふふ、君に興味があるから……それだけでは不服か？」"}],"source":"bangumi","sourceCharacterId":"49144"}],"profileFacts":[{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"7971","sourceWorkId":"17596","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"cupSize":[{"comparisonValue":"g","source":"vndb","sourceCharacterId":"c32851","value":"G"},{"comparisonValue":"g","scope":"sourceWork","source":"egs","sourceCharacterId":"7971","sourceWorkId":"17596","value":"G"},{"comparisonValue":"gカップ","source":"bangumi","sourceCharacterId":"49144","value":"Gカップ"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96c579b57e373640f673ff4668cb0a70350692138ebf979d541e97d537dccfb4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b11f854f978c2525bcae69d8830ecfb490b0a3cc854eb6ff2945efddef693d71.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:198759:49144:6469:1","source":"bangumi"}]},{"characterId":"char_c32852","characterName":"山田 ももこ","sourceIds":{"bangumi":[{"characterId":"49145","match":"exact-normalized-name-in-linked-work","subjectId":"198759"}],"egsCharacterIds":["7972"],"vndbCharacterId":"c32852"},"originalCharacterName":"山田 ももこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"review