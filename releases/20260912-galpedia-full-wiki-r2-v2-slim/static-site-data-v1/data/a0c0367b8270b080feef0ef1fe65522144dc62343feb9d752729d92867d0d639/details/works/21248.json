15","characterName":"秋山 達郎","sourceIds":{"bangumi":[{"characterId":"90160","match":"exact-normalized-name-in-linked-work","subjectId":"126046"}],"egsCharacterIds":["6206"],"vndbCharacterId":"c2315"},"originalCharacterName":"秋山 達郎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Protagonist of Taimanin Yukikaze. Brother of Akiyama Rinko."}],"source":"vndb","sourceCharacterId":"c2315"},{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"凜子の弟。"},{"spoiler":false,"text":"ゆきかぜとは幼馴染であり長い間、互いを思っているが友達以上恋人未満の関係。"},{"spoiler":false,"text":"代々、優秀な忍者を輩出する名門の嫡男で主人公も次代の主力として期待されているが、そのプレッシャーか優しい性格のためか伸び悩んでいる。"},{"spoiler":false,"text":"すでに頭角をあらわしているゆきかぜに何とか追いつき、彼女にふさわしい男になろうと弛まぬ努力を重ねている。対魔忍として大きな才能を秘めているが、まだその実力は未知数。"},{"spoiler":false,"text":"得物は忍者刀。"}],"source":"egs","sourceCharacterId":"6206","sourceWorkId":"21248","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公。 凜子の弟。"},{"spoiler":false,"text":"ゆきかぜとは幼なじみであり、長い間互いを想っているが、友達以上恋人未満の関係。"},{"spoiler":false,"text":"代々優秀な忍者を輩出する名門の嫡男で、次代の主力として期待されているが、そのプレッシャーか優しい性格のためか伸び悩んでいる。"},{"spoiler":false,"text":"すでに頭角を現しているゆきかぜになんとか追いつき、彼女に相応しい男になろうとたゆまぬ努力を重ねている。"},{"spoiler":false,"text":"対魔忍として大きな才能を秘めているが、まだその才能は開花しておらず忍法を使うことが出来ない。"},{"spoiler":false,"text":"得物は忍者刀。"}],"source":"bangumi","sourceCharacterId":"90160"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cb2342b2aedd4a0c058e6ad6902d0b7f152fa8a55fe1b8553446aa4b24b845e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/0609b9b9af35c588206070e6770aa519ab81dfcc42d8674c1ce295910a2c203f.webp","width":135,"height":256,"source":"static-detail"},"actors":[