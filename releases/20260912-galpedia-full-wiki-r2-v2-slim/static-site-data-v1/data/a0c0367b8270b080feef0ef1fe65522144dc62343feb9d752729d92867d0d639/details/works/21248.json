:"source-native","relationId":"vndb:vn-staff:114771","source":"vndb"},{"creditedName":"つゑふ","creatorId":"vndb:s23462","sourcePersonId":"vndb:s23462","canonicalEntityId":"vndb:s23462","name":"つゑふ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:114772","source":"vndb"}]},"cast":[{"characterId":"char_c2310","characterName":"水城 ゆきかぜ","sourceIds":{"bangumi":[{"characterId":"25646","match":"exact-normalized-name-in-linked-work","subjectId":"126046"},{"characterId":"25646","match":"source-roster","subjectId":"126046"},{"characterId":"25646","match":"exact-normalized-name-in-linked-work","subjectId":"21330"},{"characterId":"25646","match":"source-roster","subjectId":"21330"},{"characterId":"25646","match":"source-roster","subjectId":"295256"}],"egsCharacterIds":["6207"],"vndbCharacterId":"c2310"},"originalCharacterName":"水城 ゆきかぜ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"203"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Main heroine of Taimanin Yukikaze. Fights with twin handguns which amplifies her lightning attacks."}],"source":"vndb","sourceCharacterId":"c2310"},{"segments":[{"spoiler":false,"text":"新世代の戦力と期待される若き対魔忍。"},{"spoiler":false,"text":"代々、“雷遁の術”使いを輩出する名門で彼女も亡き父親同様、“雷遁の術”を使う。"},{"spoiler":false,"text":"“雷遁の術”とは雷を操る強力な術で攻撃系忍法では最強の火力と言われているもの。"},{"spoiler":false,"text":"その中でも彼女の操る雷撃は強力すぎて自身制御が難しいため、術を行使する触媒として特別に制作された銃を使用している。"},{"spoiler":false,"text":"ゆきかぜはその銃に雷撃の弾丸を生み出し、強力な雷撃弾を発射する事ができる。"},{"spoiler":false,"text":"二丁拳銃を得物に、舞うように雷撃弾を放つその姿から電撃の対魔忍の異名を持つ。"},{"spoiler":false,"text":"勝気で負けず嫌い、プライドの高さがたまにキズで唯一心許せる存在が幼馴染の秋山達郎となかなか恋愛関係に進展できないのが悩み。"},{"spoiler":false,"text":"とにかく体を動かして遊ぶのが好きで年中日焼けしている美少女。"}],"source":"egs","sourceCharacterId":"6207","sourceWorkId":"15881","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のヒロイン。"},{"spoiler":false,"text":"新世代の戦力と期待される若き対魔忍。"},{"spoiler":false,"text":"代々、“雷遁の術”使いを排出する名門で彼女も亡き父親同様、“雷遁の術”を使う。"},{"spoiler":false,"text":"“雷遁の術”とは雷を操る強力な術で攻撃系忍法では最強の火力と言われているもの。その中でも彼女の操る雷撃は強力すぎて自身制御が難しいため、術を行使する触媒として特別に制作された銃を使用している。ゆきかぜはその銃に雷撃の弾丸を生み出し、強力な雷撃弾を発射する事ができる。"},{"spoiler":false,"text":"二丁拳銃を得物に、舞うように雷撃弾を放つその姿から〝電撃の対魔忍”の異名を持つ。"},{"spoiler":false,"text":"勝気で負けず嫌い、プライドの高さがたまにキズで唯一心許せる存在が幼馴染の秋山達郎となかなか恋愛関係に進展できないのが悩み。"},{"spoiler":false,"text":"とにかく体を動かして遊ぶのが好きで年中日焼けしている美少女。"}],"source":"egs","sourceCharacterId":"6207","sourceWorkId":"21248","spoiler":false},{"segments":[{"spoiler":false,"text":"新世代の戦力と期待される若き対魔忍。"},{"spoiler":false,"text":"代々、“雷遁の術”使いを輩出する名門で彼女も亡き父親同様、“雷遁の術”を使う。"},{"spoiler":false,"text":"“雷遁の術”とは雷を操る強力な術で攻撃系忍法では最強の火力と言われているもの。"},{"spoiler":false,"text":"その中でも彼女の操る雷撃は強力すぎて自身制御が難しいため、術を行使する触媒として特別に制作された銃を使用している。"},{"spoiler":false,"text":"ゆきかぜはその銃に雷撃の弾丸を生み出し、強力な雷撃弾を発射する事ができる。"},{"spoiler":false,"text":"二丁拳銃を得物に、舞うように雷撃弾を放つその姿から電撃の対魔忍の異名を持つ。"},{"spoiler":false,"text":"勝気で負けず嫌い、プライドの高さがたまにキズで唯一心許せる存在が幼馴染の秋山達郎となかなか恋愛関係に進展できないのが悩み。"},{"spoiler":false,"text":"とにかく体を動かして遊ぶのが好きで年中日焼けしている美少女。"},{"spoiler":false,"text":"「そ、そう！　達郎がそう言うなら期待しておいてあげる……！」"}],"source":"egs","sourceCharacterId":"6207","sourceWorkId":"21820","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のヒロイン。新世代の戦力と期待される若き対魔忍。"},{"spoiler":false,"text":"代々 “雷遁の術”使いを排出する名門で、彼女も雷遁の術を使う。"},{"spoiler":false,"text":"雷遁は攻撃系忍法では最強の火力と言われており、その中でも彼女の操る雷撃は強力すぎて制御が難しいため、触媒として特別に製作された銃を使用している。"},{"spoiler":false,"text":"二丁拳銃を得物に、舞うように雷撃弾を放つその姿から “電撃の対魔忍” の異名を持つ。"},{"spoiler":false,"text":"勝気で負けず嫌い。プライドの高さがたまにキズで、唯一心許せる存在が幼なじみの秋山達郎だが、なかなか恋愛関係に進展できないのが悩み。"},{"spoiler":false,"text":"とにかく身体を動かして遊ぶのが好きで、年中日焼けしている美少女。"},{"spoiler":false,"text":"＜忍法・雷銃撃＞"},{"spoiler":false,"text":"雷遁の術を応用した強力な攻撃系忍法。二丁拳銃を触媒に雷を集約をさせて雷球を放つ。"},{"spoiler":false,"text":"打ち出された雷球は半プラズマ化しているため、目標を高熱で溶解して大穴を空け、瞬時に雷エネルギーが解放され5000Ｖの雷撃で対象を引き裂く。"},{"spoiler":false,"text":"「そ、そう！　達郎がそう言うなら期待しておいてあげる……！」"}],"source":"bangumi","sourceCharacterId":"25646"}],"profileFacts":[{"label":"出身","source":"bangumi","sourceCharacterId":"25646","value":"水城家"},{"label":"属性","source":"bangumi","sourceCharacterId":"25646","value":"自然"},{"label":"所属","source":"bangumi","sourceCharacterId":"25646","value":"対魔忍"},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"6207","sourceWorkId":"21248","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee14a8bddad789c38111748c3b38a2d2774a3324369b29dfe2bf3ae850519cbe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c3ac063bf787fe70efdd0cf4ef0b5d7c846ab733b9a3e8992eec236e4a5001a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川知子","creatorId":"vndb:s694","sourcePersonId":"vndb:s694","canonicalEntityId":"vndb:s694","name":"ひむろゆり(氷室百合)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126046:25646:5924:1","source":"bangumi"}]},{"characterId":"char_c2311","characterName":"秋山 凜子","sourceIds":{"bangumi":[{"characterId":"25647","match":"exact-normalized-name-in-linked-work","subjectId":"126046"},{"characterId":"25647","match":"exact-normalized-name-in-linked-work","subjectId":"21330"}],"egsCharacterIds":["6208"],"vndbCharacterId":"c2311"},"originalCharacterName":"秋山 凜子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"808"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"172"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sub heroine of Taimanin Yukikaze. Protagonist Akiyama Tatsuro's elder sister. Fights with a katana."}],"source":"vndb","sourceCharacterId":"c2311"},{"segments":[{"spoiler":false,"text":"ゆきかぜの通う学園の先輩対魔忍。"},{"spoiler":false,"text":"彼女の幼馴染で姉のような存在。達郎の姉。"},{"spoiler":false,"text":"太刀の使い手。忍びの里に代々伝わる剣術『逸刀流』の皆伝。"},{"spoiler":false,"text":"妹（ゆきかぜ）と弟（達郎）の世話をやくのが趣味で二人にとことん優しく包容力があり甘いところが多々あるが、それは二人だけに見せる一面で、学園の評判では強く美しく厳しい先輩として見られている。"},{"spoiler":false,"text":"恋愛より妹弟を愛でるのが楽しいためか、数多の男子の求愛にまったく興味を示さない。"},{"spoiler":false,"text":"女子生徒の中ではレズ説が囁かれ、秘かに凜子様ファンクラブなるものが存在し強い広がりを見せているが本人は至ってノーマル。"}],"source":"egs","sourceCharacterId":"6208","sourceWorkId":"15881","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の先輩対魔忍。"},{"spoiler":false,"text":"ゆきかぜの幼馴染で姉のような存在。"},{"spoiler":false,"text":"主人公・秋山達郎は弟。"},{"spoiler":false,"text":"太刀の使い手。忍びの里に代々伝わる剣術『逸刀流』の皆伝。"},{"spoiler":false,"text":"〝斬鬼の対魔忍”と恐れられる手練の美しき剣客。"},{"spoiler":false,"text":"妹（ゆきかぜ）と弟（達郎）の世話をやくのが趣味で二人にとことん優しく包容力があり甘いところが多々あるが、それは二人だけに見せる一面で、学園の評判では強く美しく厳しい先輩として見られている。恋愛より妹弟を愛でるのが楽しいためか、数多の男子の求愛にまったく興味を示さない。"},{"spoiler":false,"text":"女子生徒の中ではレズ説が囁かれ、秘かに凜子様ファンクラブなるものが存在し強い広がりを見せているが本人は至ってノーマル。"},{"spoiler":false,"text":"常にゆきかぜと行動をともにし、彼女を献身的にサポートしている。"}],"source":"egs","sourceCharacterId":"6208","sourceWorkId":"21248","spoiler":false},{"segments":[{"spoiler":false,"text":"ゆきかぜの通う学園の先輩対魔忍。"},{"spoiler":false,"text":"彼女の幼馴染で姉のような存在。達郎の姉。"},{"spoiler":false,"text":"太刀の使い手。忍びの里に代々伝わる剣術『逸刀流』の皆伝。"},{"spoiler":false,"text":"妹（ゆきかぜ）と弟（達郎）の世話をやくのが趣味で二人にとことん優しく包容力があり甘いところが多々あるが、それは二人だけに見せる一面で、学園の評判では強く美しく厳しい先輩として見られている。"},{"spoiler":false,"text":"恋愛より妹弟を愛でるのが楽しいためか、数多の男子の求愛にまったく興味を示さない。"},{"spoiler":false,"text":"女子生徒の中ではレズ説が囁かれ、秘かに凜子様ファンクラブなるものが存在し強い広がりを見せているが本人は至ってノーマル。"},{"spoiler":false,"text":"常にゆきかぜと行動をともにし、彼女を献身的にサポートしている。"},{"spoiler":false,"text":"「達郎。ゆきかぜの処女はもう散らせたのか？"},{"spoiler":false,"text":"もし奪っていれば、ついでに姉の処女も散らせてはくれぬだろうか？」"}],"source":"egs","sourceCharacterId":"6208","sourceWorkId":"21820","spoiler":false},{"segments":[{"spoiler":false,"text":"ゆきかぜの通う学園の先輩対魔忍であり、幼なじみで姉のような存在。達郎の姉。"},{"spoiler":false,"text":"太刀の使い手。忍びの里に代々伝わる剣術・逸刀流の皆伝。"},{"spoiler":false,"text":"学園では強く美しく厳しい先輩として見られている。"},{"spoiler":false,"text":"しかし妹（ゆきかぜ） と弟（達郎） の世話を焼くのが趣味で、ふたりにとことん甘い。"},{"spoiler":false,"text":"恋愛より妹弟を愛でるのが楽しいためか、数多の男子の求愛にまったく興味を示さない。"},{"spoiler":false,"text":"女子学生の間ではレズ説が囁かれ、秘かに凜子様ファンクラブなるものが存在している。"},{"spoiler":false,"text":"常にゆきかぜと行動を共にし、彼女を献身的にサポートしている。"},{"spoiler":false,"text":"＜忍法・空遁の術＞"},{"spoiler":false,"text":"空間を跳躍する異能系忍法。"},{"spoiler":false,"text":"約1キロの範囲で五感を跳躍させ情報を得る “五感跳躍の法” や、自らやその周囲のものを跳躍させる “空間跳躍の法” を操る。"},{"spoiler":false,"text":"「達郎。ゆきかぜの処女はもう散らせたのか？　もし奪っていれば、ついでに姉の処女も散らせてはくれぬだろうか？」"}],"source":"bangumi","sourceCharacterId":"25647"}],"profileFacts":[{"label":"出身","source":"bangumi","sourceCharacterId":"25647","value":"秋山家"},{"label":"属性","source":"bangumi","sourceCharacterId":"25647","value":"超人"},{"label":"所属","source":"bangumi","sourceCharacterId":"25647","value":"対魔忍"},{"label":"身高（本版本）","value":"172 cm","valueContext":null,"source":"egs","sourceCharacterId":"6208","sourceWorkId":"21248","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92d76df83a418f56c2a226ca82d54226af4fb1c05345277a93cf6514b7badd59.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20ca17ff9a8872dbec467f1af9a29b1b0ae6bb9b84a019c335f07d021c74