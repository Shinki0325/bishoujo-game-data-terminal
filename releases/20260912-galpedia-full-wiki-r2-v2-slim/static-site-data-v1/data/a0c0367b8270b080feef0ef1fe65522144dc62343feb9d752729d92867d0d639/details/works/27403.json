eves. She then begs him to watch the DVD she sent him and those who will follow, not to forgive her but to finally know the truth."}],"source":"vndb","sourceCharacterId":"c78046"},{"segments":[{"spoiler":false,"text":"信親の妻"},{"spoiler":false,"text":"信親を深く愛していたのだが……"},{"spoiler":false,"text":"ひょんなことから悪夢のような日々を過ごすことになる。"}],"source":"egs","sourceCharacterId":"20683","sourceWorkId":"27403","spoiler":false},{"segments":[{"spoiler":false,"text":"信親の元妻信親を深く愛していたのだが……"},{"spoiler":false,"text":"ひょんなことから悪夢のような日々を過ごすことになる。"}],"source":"bangumi","sourceCharacterId":"199978"}],"profileFacts":[{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"20683","sourceWorkId":"27403","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"20683","sourceWorkId":"27403","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"20683","sourceWorkId":"27403","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9db608f6a94ea937efabc71494498a4b79dad0eec7d7595bd942610408963f0d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afecc5104d57dfffb9ad18656620a0e3658404890b82162de933e8bd636645b9.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨森りこ","creatorId":"vndb:s9788","sourcePersonId":"vndb:s9788","canonicalEntityId":"vndb:s9788","name":"雨森 りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:267803:199978:48853:1","source":"bangumi"}]},{"characterId":"char_vndb_c117088","characterName":"樋山 信親","sourceIds":{"vndbCharacterId":"c117088"},"originalCharacterName":"樋山 信親","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative",