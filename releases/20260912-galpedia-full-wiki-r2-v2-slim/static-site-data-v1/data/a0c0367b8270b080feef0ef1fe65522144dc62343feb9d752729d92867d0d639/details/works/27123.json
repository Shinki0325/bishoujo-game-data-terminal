oiler":false,"text":"幼いころの記憶が一部欠如している。"},{"spoiler":false,"text":"結愛を初めて目にした瞬間、運命的な衝撃を受けて以降、"},{"spoiler":false,"text":"彼女のことを良く知りたいと行動を起こすことになる。"}],"source":"bangumi","sourceCharacterId":"68615"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5bce2886caee9f5a6a72a5d2de32e9f076d2882d1b4ae0902855f2f90687910.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a209a2474abf971338623f9e1e74ebe25ec76b3ab8494cc9588d656c2f26fd0d.webp","width":166,"height":241,"source":"static-detail"},"actors":[]},{"characterId":"char_c76317","characterName":"美城 ありす","sourceIds":{"bangumi":[{"characterId":"67032","match":"exact-normalized-name-in-linked-work","subjectId":"256595"},{"characterId":"67032","match":"exact-normalized-name-in-linked-work","subjectId":"297848"}],"egsCharacterIds":["20719"],"vndbCharacterId":"c76317"},"originalCharacterName":"美城 ありす","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"71"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"146"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"71"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公を兄のように慕う後輩の少女。"},{"spoiler":false,"text":"明るく前向きで、誰にも優しい性格で周囲に愛されている。"},{"spoiler":false,"text":"頑張り屋で大変諦めが悪い。"},{"spoiler":false,"text":"ダメなことをそのままにしたくないと、どれだけ苦労してもそれを成し遂げる強さも持っている。"},{"spoiler":false,"text":"アイドルを夢見ながらも、実は超が付くほどの音痴。"},{"spoiler":false,"text":"その歌声は周囲の人間の記憶を飛ばすほどとも言われる。"},{"spoiler":false,"text":"毎朝、町に子守歌を流す時計台に出没している。"}],"source":"egs","sourceCharacterId":"20719","sourceWorkId":"27123","spoiler":fals