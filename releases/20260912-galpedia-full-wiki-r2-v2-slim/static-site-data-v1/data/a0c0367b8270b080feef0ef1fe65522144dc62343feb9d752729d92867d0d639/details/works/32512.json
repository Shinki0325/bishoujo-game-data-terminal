urcePersonId":"vndb:s2482","canonicalEntityId":"vndb:s2482","name":"さいとう つかさ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:184327","source":"vndb"},{"creditedName":"さいとう つかさ","creatorId":"vndb:s2482","sourcePersonId":"vndb:s2482","canonicalEntityId":"vndb:s2482","name":"さいとう つかさ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:184329","source":"vndb"},{"creditedName":"天翔 狗","creatorId":"vndb:s5399","sourcePersonId":"vndb:s5399","canonicalEntityId":"vndb:s5399","name":"天翔 狗","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:184331","source":"vndb"},{"creditedName":"いせの やじん","creatorId":"vndb:s8479","sourcePersonId":"vndb:s8479","canonicalEntityId":"vndb:s8479","name":"いせの やじん","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:184332","source":"vndb"}]},"cast":[{"characterId":"char_c107099","characterName":"天津 瑠奈","sourceIds":{"bangumi":[{"characterId":"111871","match":"exact-normalized-name-in-linked-work","subjectId":"387220"}],"egsCharacterIds":["24013"],"vndbCharacterId":"c107099"},"originalCharacterName":"天津 瑠奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main heroine of the game."},{"spoiler":false,"text":"She's a first years student at Etoile private academy."},{"spoiler":false,"text":"She's a young girl who dreams of becoming a fairy-tale writer, she's a bit shy and clumsy."},{"spoiler":false,"text":"As a result of her twin sister, Rena, dragging her along with her pushy personality, she's the main writer for the school mini magazine \"Etoile Journal\" (which is knwon as a gossip newspaper)."},{"spoiler":false,"text":"She considers herself to not be especially good at anything and that makes her a bit lacking in self-confidence."},{"spoiler":false,"text":"Compared to her sister Rena she's worse in physical activities. She can't swim."},{"spoiler":false,"text":"Her hair looks like a short two-sides-up from the front, but it's actually tied together at the back."},{"spoiler":false,"text":"Translated from DLsite"}],"source":"vndb","sourceCharacterId":"c107099"},{"segments":[{"spoiler":false,"text":"本作のメインヒロイン。"},{"spoiler":false,"text":"私立エトワール学園一年。"},{"spoiler":false,"text":"ちょっとドジな恥ずかしがり屋で、童話作家を夢見る少女。"},{"spoiler":false,"text":"双子の姉、玲奈に強引に引きずられる形で、学園ミニコミ誌「エトワールジャーナル」（という名のゴシップ壁新聞）の主に文章作成担当をしている。"},{"spoiler":false,"text":"とりわけ特技らしい特技はないと思っている、ちょっと意気地のない系。"},{"spoiler":false,"text":"姉の玲奈と比べると運動神経は劣る。かなづち。"},{"spoiler":false,"text":"髪の毛は正面からだと短めのツーサイドアップ気味に見えるが、実際には後ろ中央で分けてひとつ結びしているだけ。"}],"source":"egs","sourceCharacterId":"24013","sourceWorkId":"32512","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f28383c974cb712f3317d3fe63818ec869d7ff1b495304412a5c3be3ee763e22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/0566ffa64506b99e9e8285afb234ab1285ba95cb3b0f9d8723eb0995afe9cd40.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:387220:111871:15637:1","source":"bangumi"}]},{"characterId":"char_c107100","characterName":"天津 玲奈","sourceIds":{"bangumi":[{"characterId":"111873","match":"exact-normalized-name-in-linked-work","subjectId":"387220"}],"egsCharacterIds":["24015"],"vndbCharacterId":"c107100"},"originalCharacterName":"天津 玲奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first year student at Etoile Private Academy who is Runa's twin sister."},{"spoiler":false,"text":"She obtained the illegal app \"Angel Maker\" after learning about it from a news article called \"Angel Maker, the urban legend\"."},{"spoiler":false,"text":"She's cheerful and intelligent, but throws out a ton of verbal abuse."},{"spoiler":false,"text":"Rena's rough manner of speech alongside her personality and leadership abilities gained her a reputation as \"someone to rely on\" among her classmates."},{"spoiler":false,"text":"On the other hand, she made many enemies because of her rude, intrusive and foul-mouthed attitude."},{"spoiler":false,"text":"Her hair style is two-sides-up."},{"spoiler":false,"text":"She's determined and hates losing."},{"spoiler":false,"text":"Translated from DLsite"}],"source":"vndb","sourceCharacterId":"c107100"},{"segments":[{"spoiler":false,"text":"私立エトワール学園一年。瑠奈の双子の姉。"},{"spoiler":false,"text":"『エトワールジャーナル』の記事ネタとして「エンジェルメイカーの都市伝説」を聞き、非正規アプリを入手する。"},{"spoiler":false,"text":"明るく脳天気だが、粗野で超毒舌吐き。"},{"spoiler":false,"text":"乱暴な物言いでちょっとガサツな性格だが、リーダーシップ的な性格でもあり、そのあたりは同級生などからも「頼りになる」と評判はいい。"},{"spoiler":false,"text":"逆に言うと「あけすけなく、でしゃばりかつ、毒舌」なので、敵も多い（と思われる）。"},{"spoiler":false,"text":"髪型はツーサイドアップ。勝ち気で負けず嫌い。"}],"source":"egs","sourceCharacterId":"24015","sourceWorkId":"32512","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3c8bf0d5a4471b2c7aba0db4e9d6c78af10537c25aac4e9a8250fcbca0587ec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06f816725d9e692f29d831752a64757c39d144c8251c9ac883a9a195828dac21.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:387220:111873:8055:1","source":"bangumi"}]},{"characterId":"char_c107101","characterName":"国府方 海夕","sourceIds":{"bangumi":[{"characterId":"111872","match":"exact-normalized-name-in-linked-work","subjectId":"387220"}],"egsCharacterIds":["24014"],"vndbCharacterId":"c107101"},"originalCharacterName":"国府方 海夕","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"First year student at Etoile private academy."},{"spoiler":false,"text":"She's a childhood friend of Runa and Rena."},{"spoiler":false,"text":"She likes to draw cute things."},{"spoiler":false,"text":"She's the illustrator for the Etoile Journal."},{"spoiler":false,"text":"She aspires to be a mangaka, but in truth she's a dreamer who is always aiming for more."},{"spoiler":false,"text":"Her own corner in the Etoile Journal is called \"The daily Tamanosuke\" in which she reports the actions of the backyard cat in a pitcure essay."},{"spoiler":false,"text":"Her peculiar illustrations have a small following."},{"spoiler":false,"text":"She's a sensitive girl who gets easily flustered, she has a short fuse."},{"spoiler":false,"text":"She dislikes insects, arthropod​s and the likes, but more than anything she dislikes spiders."},{"spoiler":false,"text":"Translated from DLsite"}],"source":"vndb","sourceCharacterId":"c107101"},{"segments":[{"spoiler":false,"text":"私立エトワール学園一年。"},{"spoiler":false,"text":"瑠奈と玲奈の幼馴染。"},{"spoiler":false,"text":"可愛いものを描くのが好き。エトワールジャーナル挿絵担当。"},{"spoiler":false,"text":"漫画家志望者。だけれど、本当はもっとなりたいものがある、夢見がちな少女。"},{"spoiler":false,"text":"「エトワールジャーナル」の独自コーナー「今日のたまのすけ」という裏庭の猫の行動を追ったイラストエッセイや、挿絵が独特のセンスでプチ人気。"},{"spoiler":false,"text":"性格はあわてんぼうで、感受性が強く、よくあわあわとして、テンパりやすい。"},{"spoiler":false,"text":"虫、節足動物などが苦手で、その中でも蜘蛛が超苦手。"}],"source":"egs","sourceCharacterId":"24014","sourceWorkId":"32512","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d4855f2c03118d2e76fab4f8017b3f0c67d32434410031d765d919a4a6c8a53.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/1070d63bfb44aa22c9f0a1106ebc5133046b62b84864821de55946a8e723044f.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平井まみ","creatorId":"vndb:s939","sourcePersonId":"vndb:s939","canonicalEntityId":"vndb:s939","name":"平井 まみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:387220:111872:18547:1","source":"bangumi"}]},{"characterId":"char_vndb_c107569","characterName":"橘 瑛里華","sourceIds":{"vndbCharacterId":"c107569"},"originalCharacterName":"橘 瑛里華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A magical girl who suddenly appears in front of Runa and the others."},{"spoiler":false,"text":"Translated from DLsite"}],"source":"vndb","sourceCharacterId":"c107569"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35f3d09f5bbdda55dbaaecdd2788d31ebf4b6331a0a5d6fc04d87c6ce997e234.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/8697ceafb5ba213dfcc7045168ba9805869c69ab5bf6c84aa4747ef8fcaacdb2.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"手塚 りょうこ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91103","source":"vndb"}]},{"characterId":"char_vndb_c107570","characterName":"奏馬 絢香","sourceIds":{"vndbCharacterId":"c107570"},"originalCharacterName":"奏馬 絢香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The elder sister of Kurea Souma, the heroine who appears in the previous work \"Shinsei Kourin Dacryon ~Tadashii Tenshi no Sodatekata~\"."},{"spoiler":false,"text":"Her personality is somewhat unusual, she's calm and carefree but her ideas can be a bit bizzarre."},{"spoiler":false,"text":"One day she obtained the \"angel maker\" at the same time as Erika and blew up as \"Dacryon Ayaka\"."},{"spoiler":false,"text":"She lives with her mother. She cares about her little sister."},{"spoiler":false,"text":"Translated from DLsite"}],"source":"vndb","sourceCharacterId":"c107570"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/8689073c09aa6d25902222ab62ff81badb44c56c47ad31e0b2fdd46911aa2f5e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da77a85da291bbc0bb912b9089630354d6dc01c5b3c0a1a7e02d6cf5292c917b.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"渋谷 ひめ","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91102","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p7501","sourceCompanyId":"egs:brand:5692","canonicalEntityId":"vndb:p7501","name":"CHAOS-R","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:32512:5692","sourc