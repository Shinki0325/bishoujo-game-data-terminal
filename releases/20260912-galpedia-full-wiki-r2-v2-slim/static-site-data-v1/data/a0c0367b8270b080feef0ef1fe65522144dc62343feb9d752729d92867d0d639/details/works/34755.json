{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"34755","model":{"presentationWorkId":"vndb:v47197","staff":{"artwork":[{"creditedName":"山本和枝(やまもと☆かずえ)","creatorId":"vndb:s2266","sourcePersonId":"egs:creator:168","canonicalEntityId":"vndb:s2266","name":"山本和枝(やまもと☆かずえ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:269511","source":"egs"}],"scenario":[{"creditedName":"シャア専用◎","creatorId":"vndb:s2261","sourcePersonId":"egs:creator:2171","canonicalEntityId":"vndb:s2261","name":"シャア専用◎","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:269512","source":"egs"}],"music":[{"creditedName":"Angel Note","creatorId":"vndb:s758","sourcePersonId":"egs:creator:2558","canonicalEntityId":"vndb:s758","name":"Angel Note","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:269513","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c81501","characterName":"鏑木 紫","sourceIds":{"bangumi":[{"characterId":"77007","match":"exact-normalized-name-in-linked-work","subjectId":"227400"},{"characterId":"77007","match":"exact-normalized-name-in-linked-work","subjectId":"279447"},{"characterId":"77007","match":"exact-normalized-name-in-linked-work","subjectId":"305833"},{"characterId":"77007","match":"exact-normalized-name-in-linked-work","subjectId":"554987"}],"egsCharacterIds":["17666"],"vndbCharacterId":"c81501"},"originalCharacterName":"鏑木 紫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"元々退魔とは無縁だった稲黍神社の一人娘。"},{"spoiler":false,"text":"背が小さく幼い雰囲気。喋り方やしぐさも子供っぽいので、脳天気に見えるが芯は強い。"},{"spoiler":false,"text":"幼少時はお姉さんぶっていたのだが、成長が止まって、小柄でかわいらしい見た目になったのがコンプレックス。"}],"source":"egs","sourceCharacterId":"17666","sourceWorkId":"25976","spoiler":false},{"segments":[{"spoiler":false,"text":"小柄で可愛いフリーランスの退魔巫女。"},{"spoiler":false,"text":"元々退魔とは無縁だった稲黍神社（いなきびじんじゃ）の一人娘。"},{"spoiler":false,"text":"喋り方やしぐさも子供っぽいので脳天気に見えるが芯は強い。"},{"spoiler":false,"text":"現在は幼馴染の佑馬と一緒に退魔の仕事をしているが両親には内緒にしている。"},{"spoiler":false,"text":"みんなを守れる力があるのなら少しでも役に立てたいと思っているが、それ故に少々危なっかしい所も。"},{"spoiler":false,"text":"小柄で幼い見た目なのがコンプレックス。"}],"source":"egs","sourceCharacterId":"17666","sourceWorkId":"29517","spoiler":false},{"segments":[{"spoiler":false,"text":"小柄で可愛いフリーランスの駆け出し退魔巫女。"},{"spoiler":false,"text":"元々退魔とは無縁だった稲黍いなきび神社の一人娘。"},{"spoiler":false,"text":"喋り方やしぐさも子供っぽいので能天気に見えるが芯は強い。"},{"spoiler":false,"text":"みんなを守れる力があるのなら少しでも役に立てたいと思っている。ただ、それ故に少々危なっかしい所も。"},{"spoiler":false,"text":"ちはやとは大親友でいろいろ教えあう仲。小柄で幼い見た目なのがコンプレックス。お菓子作りやお掃除グッズを集めるのが趣味。"}],"source":"egs","sourceCharacterId":"17666","sourceWorkId":"38571","spoiler":false},{"segments":[{"spoiler":false,"text":"小柄で可愛いフリーランスの退魔巫女。"},{"spoiler":false,"text":"元々退魔とは無縁だった稲黍(いなきび)神社の一人娘。喋り方やしぐさも子供っぽいので脳天気に見えるが芯は強い。"},{"spoiler":false,"text":"現在は幼馴染の佑馬と一緒に退魔の仕事をしているが両親には内緒にしている。みんなを守れる力があるのなら少しでも役に立てたいと思っているが、それ故に少々危なっかしい所も。"},{"spoiler":false,"text":"小柄で幼い見た目なのがコンプレックス。"}],"source":"bangumi","sourceCharacterId":"77007"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/008e352ce141d1d6a11baddae6d99ec675afc2af786bfcad39ffcfa14db65586.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5fcac2612713204afa058bd113c4990a93f679687c9f0cd5d07bc819680892b0.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:448123:77007:11646: