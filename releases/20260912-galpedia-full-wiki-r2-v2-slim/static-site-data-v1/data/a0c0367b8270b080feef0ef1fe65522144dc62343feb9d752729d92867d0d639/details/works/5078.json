2337e1fabbc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187617:151776:4714:1","source":"bangumi"}]},{"characterId":"char_c25049","characterName":"万里子","sourceIds":{"bangumi":[{"characterId":"151813","match":"exact-normalized-name-in-linked-work","subjectId":"187617"}],"egsCharacterIds":["26693"],"vndbCharacterId":"c25049"},"originalCharacterName":"万里子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"三流短大の二年生。"},{"spoiler":false,"text":"果澄を陥れる主犯格・井場のガールフレンド"},{"spoiler":false,"text":"果澄とは対照的に、下品で肉体的にも貧相。"},{"spoiler":false,"text":"ファッションセンスもあまり良くない。"},{"spoiler":false,"text":"男らから羨望を集める果澄に嫉妬のような感情を抱いている。"}],"source":"egs","sourceCharacterId":"26693","sourceWorkId":"5078","spoiler":false},{"segments":[{"spoiler":false,"text":"果澄を陥れる主犯格「井場」の彼女。"},{"spoiler":false,"text":"ランクとしては中の下以下に属する三流短大の2年生。"},{"spoiler":false,"text":"友達の愛美と一緒に行動していることが多い。"},{"spoiler":false,"text":"ケバいファッション、下品な物言いは果澄とは対照的で"},{"spoiler":false,"text":"肉体的には痩せていて「色黒」「貧乳」、まさに貧相なボディといったところ。"},{"spoiler":false,"text":"男がもてはやす、果澄の豊満な肉体や上品な物腰を憎々しげに思っている。"}],"source":"bangumi","sourceCharacterId":"151813"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cf9e4e4774ae2c9770f48fb615b773df740047c90b575c8e5dafbc3326dbb4e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9eccea03e150bdcaabb736ab5588f168d2931b7a3068b9e698215407a8f8d694.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜庭わかな","creatorId":"vndb:s807","sourcePersonId":"vndb:s807","canonicalEntityId":"vndb:s807","name":"桜庭 わかな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:187617:151813:11261:1","source":"bangumi"}]},{"characterId":"char_c25050","characterName":"愛美","sourceIds":{"bangumi":[{"characterId":"151814","match":"exact-normalized-name-in-linked-work","subjectId":"187617"}],"egsCharacterIds":["26694"],"vndbCharacterId":"c25050"},"originalCharacterName":"愛美","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"万里子と同じ三流短大の二年生。"},{"spoiler":false,"text":"万里子と仲が良く、よくつるんでいる。"},{"spoiler":false,"text":"背が低く、ぽっちゃりしたタイプの女性。"},{"spoiler":false,"text":"全てにおいて自分よりも優れている果澄に対して、卑屈な感情を抱えている。"},{"spoiler":false,"text":"そうした気持ちの表れからか、果澄の交際中の彼氏・室町を誘惑するが……。"}],"source":"egs","sourceCharacterId":"26694","sourceWorkId":"5078","spoiler":false},{"segments":[{"spoiler":false,"text":"万里子の友人であり、古屋の彼女。"},{"spoiler":false,"text":"いわゆる三流短大（万里子と同じ）の2年生。"},{"spoiler":false,"text":"レベルが同程度ということもあり、万里子とはとても仲がよい。"},{"spoiler":false,"text":"背が低くてポッチャリした、泥臭いタイプ。"},{"spoiler":false,"text":"全ての幸せを手にしているような果澄に対して、心の中で卑屈になってしまう。"},{"spoiler":false,"text":"その気持ちの現われか、果澄の彼である室町を誘惑する。"}],"source":"bangumi","sourceCharacterId":"151814"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f0f37d71890151cb54e20997042cc9ab5967565b9e6f60b0e3fa1d3bda5447c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c655eb25207da9be230c5c6bd63cd65cefed629d3f0b452997cdc80c8b8680d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田