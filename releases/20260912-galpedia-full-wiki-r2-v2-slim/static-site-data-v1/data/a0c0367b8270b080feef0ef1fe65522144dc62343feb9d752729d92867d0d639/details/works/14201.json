"11379","sourceWorkId":"14201","spoiler":false},{"segments":[{"spoiler":false,"text":"三年级学生。学生会长。"},{"spoiler":false,"text":"性格自由奔放、天真烂漫，因此很有人气。"},{"spoiler":false,"text":"学习、运动都不太擅长，会很好地向同班的真子讨教。"},{"spoiler":false,"text":"很有领导力，会说出“啊啊，真是的，不要错过哦！”这样发挥领导能力的类型。"},{"spoiler":false,"text":"有传言说有恋人，但没有人知道真相。"}],"source":"bangumi","sourceCharacterId":"92449"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07573c53a43c7e19ddcd47e2e2e7418520fb91cc41baea133de4b07dba7eae4e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4cf8a3146c877aaa6168932d26dc17ce75d76b273ed9ee9e313bfdcf76f4dca8.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:28950:92449:5075:1","source":"bangumi"}]},{"characterId":"char_vndb_c43175","characterName":"佐藤 新一","sourceIds":{"vndbCharacterId":"c43175"},"originalCharacterName":"佐藤 新一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Protagonist of the story. He is also from old-fashioned family and member of student council where he works together with his beloved fiancé Mako. He took it for granted that Mako would stay by his side forever until he lost her."}],"source":"vndb","sourceCharacterId":"c43175"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/3774a1161f65abd50a4b9f4af8475a8360b65fc7191ed4a3cb280d3772d096bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/