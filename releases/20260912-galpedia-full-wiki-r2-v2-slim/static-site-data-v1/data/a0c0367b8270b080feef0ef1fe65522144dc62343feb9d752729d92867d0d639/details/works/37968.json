tive","relationId":"vndb:vn-staff:213895","source":"vndb"},{"creditedName":"久野 藍","creatorId":"vndb:s35186","sourcePersonId":"vndb:s35186","canonicalEntityId":"vndb:s35186","name":"久野 藍","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:213897","source":"vndb"},{"creditedName":"阿部 まれお","creatorId":"vndb:s36172","sourcePersonId":"vndb:s36172","canonicalEntityId":"vndb:s36172","name":"阿部 まれお","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:213899","source":"vndb"},{"creditedName":"カスカベ シシオ","creatorId":"vndb:s1505","sourcePersonId":"vndb:s1505","canonicalEntityId":"vndb:s1505","name":"草壁よしお","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:213900","source":"vndb"},{"creditedName":"とまりぎ亭","creatorId":"vndb:s43809","sourcePersonId":"vndb:s43809","canonicalEntityId":"vndb:s43809","name":"とまりぎ亭","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:213902","source":"vndb"}]},"cast":[{"characterId":"char_c136700","characterName":"赤塚 ハル","sourceIds":{"bangumi":[{"characterId":"154684","match":"exact-normalized-name-in-linked-work","subjectId":"487413"}],"egsCharacterIds":["25749"],"vndbCharacterId":"c136700"},"originalCharacterName":"赤塚 ハル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"同じクラスの友達。"},{"spoiler":false,"text":"天真爛漫で、自分の意見はハッキリ言える凛とした部分もある。"},{"spoiler":false,"text":"クラスではいつも上位グループの女子たちでつるんでいて、目立った存在。"},{"spoiler":false,"text":"華やかな見た目ですごく目立った存在だが、鼻にかけている様子もないため、男女問わず人気がある。"},{"spoiler":false,"text":"主人公にはすごく気を許していてよくふたりで話す。"},{"spoiler":false,"text":"ふたりのときの無警戒過ぎる故のエロさがでてしまう。"}],"source":"egs","sourceCharacterId":"25749","sourceWorkId":"36240","spoiler":false},{"segments":[{"spoiler":false,"text":"「学校中に自分のチョイスした"},{"spoiler":false,"text":"曲が流れてるって、"},{"spoiler":false,"text":"ちょっと楽しくない？」"},{"spoiler":false,"text":"クラスではいつも上位グループの女子たちで"},{"spoiler":false,"text":"つるんでいて、目立った存在。"},{"spoiler":false,"text":"主人公にはすごく気を許していて よくふたりで話す。"},{"spoiler":false,"text":"ふたりのときの無警戒過ぎる故の エロさがでてしまう。"},{"spoiler":false,"text":"休み時間も一緒にいることが多くて、"},{"spoiler":false,"text":"周りの羨望のまなざしをもろに受ける。"},{"spoiler":false,"text":"ちょっとおバカなところがあって、のろけも無自覚になってしまい、"},{"spoiler":false,"text":"周りも大騒ぎ。にぎやかな冷やかしイベントが多め。"},{"spoiler":false,"text":"好きな人には物理的にも触れていたいと思っている。"},{"spoiler":false,"text":"同じクラスなのをいいことに教室で 周りに気づかれないようにスキンシップしてくる。"},{"spoiler":false,"text":"好きが我慢できずに、授業中も熱い視線を送ってくる。"},{"spoiler":false,"text":"とぼけるのが下手なため、周りから追及されるとボロを出しそうになる。"},{"spoiler":false,"text":"そのたびに主人公があたふたしてしまうような"},{"spoiler":false,"text":"スリリングな展開が起きる。"}],"source":"bangumi","sourceCharacterId":"154684"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21406e593ed52a0b6ba1435abc0e8ac9977c8a974eee0029ef12a6d97f825a24.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7656ffa7ec931d907176cbd70467038f2c175eea15876c07484eb7ef029c5a2.webp","width":99,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井ノ上奈々","creatorId":"vndb:s1808","sourcePersonId":"vndb:s1808","canonicalEntityId":"vndb:s1808","name":"井ノ上奈々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:537130:154684:4745:1","source":"bangumi"}]},{"characterId":"char_c136701","characterName":"名取 美沙","sourceIds":{"bangumi":[{"characterId":"154685","match":"exact-normalized-name-in-linked-work","subjectId":"487413"}],"egsCharacterIds":["25750"],"vndbCharacterId":"c136701"},"originalCharacterName":"名取 美沙","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同じ委員会に所属。"},{"spoiler":false,"text":"過去に主人公の変態的な一面を見てしまってから、妙な親近感を感じたのか気に入られてしまい、それから主人公を挑発するように肌を見せたり、下着を見せたりするようにと、どんどんエスカレートしていき、自分の身体で興奮する主人公を見て、自分も興奮するようになってしまった。"},{"spoiler":false,"text":"周囲に見せる清楚な一面と、自分にだけ見せるドエロい一面を持つ。"},{"spoiler":false,"text":"性欲が底なしだが、本人は自覚がなく。少し依存体質。"}],"source":"egs","sourceCharacterId":"25750","sourceWorkId":"36240","spoiler":false},{"segments":[{"spoiler":false,"text":"「これはクセといいますか……"},{"spoiler":false,"text":"その……」"},{"spoiler":false,"text":"普段は表情が乏しく、掴みどころがよくわからないためあまり誰も深く関わらないクラスメイト。"},{"spoiler":false,"text":"同じ委員会で、過去に主人公の変態的な一面を見て妙に親近感を感じて気に入られてしまう。"},{"spoiler":false,"text":"それから主人公を挑発するように下着を見せ始める。性欲が底なしだが、本人は自覚がない。"},{"spoiler":false,"text":"周囲に見せる清楚な一面と、自分にだけ見せるドエロい一面のギャップを楽しむヒロイン。"},{"spoiler":false,"text":"清楚な一面しかしらないクラスメイトから、"},{"spoiler":false,"text":"どうやって付き合ったか聞かれたり、"},{"spoiler":false,"text":"彼女は真面目そうで健全なお付き合いなんだろうなと素直に応援される。"},{"spoiler":false,"text":"手すらつないでいなそうに思われてクラスメイトに小ばかにされるが、"},{"spoiler":false,"text":"ふたりのときは変態性癖丸出しのド変態。"},{"spoiler":false,"text":"そのギャップでエロを際立たせる。"},{"spoiler":false,"text":"性欲を爆発させた彼女に色んな場所で求められてしまう。"},{"spoiler":false,"text":"ひと気のない教室や、体育倉庫、大通り近くの路地裏など、"},{"spoiler":false,"text":"バレそうでバレないスリリングな場所でのエッチを楽しむ。"}],"source":"bangumi","sourceCharacterId":"154685"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/801da4f5ddd4bb59a7d74267bb0d1de5cc78d193c7350f86e13e09fa0ad0ea9a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23e51dda5629972894de25bdf0e70a39d53f7ab2158aa07565d865adfbd7f676.webp","width":93,"height":256,"source":"static-detail"},"actors":[{"creditedName":"久野のぎ","creatorId":"vndb:s37485","sourcePersonId":"vndb:s37485","canonicalEntityId":"vndb:s37485","name":"久野 のぎ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:537130:154685:64022:1","source":"bangumi"}]},{"characterId":"char_c136702","characterName":"佐和 ちあき","sourceIds":{"bangumi":[{"characterId":"154686","match":"exact-normalized-name-in-linked-work","subjectId":"487413"}],"egsCharacterIds":["25751"],"vndbCharacterId":"c136702"},"originalCharacterName":"佐和 ちあき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公との幼馴染で、今も同じクラスメイトだが、学校ではみんなに幼馴染ということを隠してきた。"},{"spoiler":false,"text":"ふんわりいつも笑顔で、一緒にいると元気をもらえる癒しポジ。"},{"spoiler":false,"text":"当然クラスでも人気がある。"},{"spoiler":false,"text":"子供の頃からずっと一緒だったため、異性としての意識がお互いに弱く、主人公と自分はいつか結ばれると油断しきっていたところ、彼の周りに魅力的な女性が増え始め、もっと積極的にならなきゃと焦り始めている。"}],"source":"egs","sourceCharacterId":"25751","sourceWorkId":"36240","spoiler":false},{"segments":[{"spoiler":false,"text":"「おはよ。また学校一緒だね」"},{"spoiler":false,"text":"子供の頃からずっと一緒だったため、異性としての意識がお互いに弱い。"},{"spoiler":false,"text":"学校ではみんなに幼馴染ということを隠してきた。"},{"spoiler":false,"text":"主人公と自分はいつか結ばれると油断しきっていたところ、"},{"spoiler":false,"text":"彼の周りに魅力的な女性が増え始め、もっと積極的にならなきゃと焦り始める。"},{"spoiler":false,"text":"とにかく甘えんぼで、クラスにいてもデレデレニコニコ。"},{"spoiler":false,"text":"幼馴染だったこともオープンになり、"},{"spoiler":false,"text":"昼休みは教室であ〜んしたり、抱き着いたり、"},{"spoiler":false,"text":"クラスの隠れファンが泣いたりと賑やかなイベントが増える。"},{"spoiler":false,"text":"ふたりの甘い空間が広がる。"},{"spoiler":false,"text":"いじると面白いキャラのため、授業中に主人公のほうから"},{"spoiler":false,"text":"ドキっとさせるメッセージを飛ばしたりして、"},{"spoiler":false,"text":"赤くなる彼女の反応を楽しんだりする。"},{"spoiler":false,"text":"学校でイチャイチャするときは"},{"spoiler":false,"text":"ふたりきりになれる場所を探してこっそり会う。"},{"spoiler":false,"text":"幼馴染のため、お互いの家への行き来が早い段階から始まる。"}],"source":"bangumi","sourceCharacterId":"154686"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93f940b0665a65b62e8a5e9a6fc0ed0fdedf1f210576460379c8d59911e5eed0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e28c20a777c5e1d20a79a9587a65635893d6193e08670bcfd5a45cb626b9d2c2.webp","width":91,"height":256,"source":"static-detail"},"actors":[{"creditedName":"京亜耶奈","creatorId":"vndb:s14782","sourcePersonId":"vndb:s14782","canonicalEntityId":"vndb:s14782","name":"京 亜耶奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:537130:154686:27805:1","source":"bangumi"}]},{"characterId":"char_c136703","characterName":"桃内 楓","sourceIds":{"bangumi":[{"characterId":"154687","match":"exact-normalized-name-in-linked-work","subjectId":"487413"}],"egsCharacterIds":["25752"],"vndbCharacterId":"c136703"},"originalCharacterName":"桃内 楓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the heroine of the official short story Valentine Day."}],"source":"vndb","sourceCharacterId":"c136703"},{"segments":[{"spoiler":false,"text":"部活や委員会などでよく顔を合わせる後輩で、学園一のお嬢様と有名な少女。"},{"spoiler":false,"text":"物腰柔らかでお嬢様扱いされているが、話すと見た目ほどお嬢様ではなく、周りが持ち上げてしまっているのを止められず、お嬢様という認識が広がってしまった。"},{"spoiler":false,"text":"素のままで接してくれる主人公に惹かれているが、少しつんとした喋り方をしてしまい、会うたびに行われるツンな態度と内心のデレ……王道のツンデレ展開になってしまっている。"},{"spoiler":false,"text":"主人公を手に入れたい願望が高まり、偽装カップルになることを打診してくる。"}],"source":"egs","sourceCharacterId":"25752","sourceWorkId":"36240","spoiler":false},{"segments":[{"spoiler":false,"text":"「先輩は、家事のできる"},{"spoiler":false,"text":"お嫁さんと結婚したほうが"},{"spoiler":false,"text":"いいタイプですね」"},{"spoiler":false,"text":"部活や委員会などでよく顔を合わせる後輩で、学園一のお嬢様と有名な少女。"},{"spoiler":false,"text":"物腰柔らかでお嬢様扱いされているが、話すと見た目ほどお嬢様ではなく、主人公とふたりのときは少しつんとした喋り方をする。"},{"spoiler":false,"text":"会うたびに行われるツンな態度と内心のデレ……王道のツンデレ展開の始まりである。"},{"spoiler":false,"text":"主人公を手に入れたい願望が高まり、偽装カップルになることを打診してくる。"},{"spoiler":false,"text":"偽装カップルから、公式カップルに。誰の告白も受けたことがない鉄壁のお嬢様のため、"},{"spoiler":false,"text":"学園中に一気に噂になり注目の的。主人公と不釣り合いじゃないかと周りから危惧されるが、"},{"spoiler":false,"text":"主人公のいいところや、好きなところをのろけのように宣言してくる。"},{"spoiler":false,"text":"学校中から羨望のまなざしを向けられながらも、まっすぐ好意を向けてくれる彼女。"},{"spoiler":false,"text":"安心感と優越感でウハウハな展開。"},{"spoiler":false,"text":"偽装カップルの延長でそのまま秘密の恋愛を続行。"},{"spoiler":false,"text":"学園一の人気者のため、交際前の共通パートから"},{"spoiler":false,"text":"こっそりふたりで密会するような展開。"},{"spoiler":false,"text":"彼女と接点があることもあまり知られていないため、"},{"spoiler":false,"text":"こっそり会うことへの優越感がさらに強くなる。"}],"source":"bangumi","sourceCharacterId":"154687"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4434810c8e66eafe8ece543e81599f112a7bd002090632b6c5b00d86b4072db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf2679b463c7bef919805ffdc892656718506f32e7ed73b30307f5e521f2bdca.webp","width":89,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西連寺亜希","creatorId":"vndb:s14876","sourcePersonId":"vndb:s14876","canonicalEntityId":"vndb:s14876","name":"西連寺 亜希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:537130:154687:36177:1","source":"bangumi"}]},{"characterId":"char_vndb_c138906","characterName":"草野 なつめ","sourceIds":{"vndbCharacterId":"c138906"},"originalCharacterName":"草野 なつめ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d7442e71e21aa7bac9d27992bd61b547c2bc2c560838344e0962b0eadc5b809.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f70800df2