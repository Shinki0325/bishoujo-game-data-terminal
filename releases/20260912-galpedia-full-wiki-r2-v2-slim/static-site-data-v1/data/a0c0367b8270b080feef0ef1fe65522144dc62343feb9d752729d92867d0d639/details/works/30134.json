{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"30134","model":{"presentationWorkId":"egs:30134","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_156347","characterName":"マリス・プランダー","sourceIds":{"bangumi":[{"characterId":"156347","match":"source-roster","subjectId":"312095"}]},"originalCharacterName":"マリス・プランダー","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"マリス・プランダーは謎に包まれた人物で、その素性は不明です。"},{"spoiler":false,"text":"『アサイラム』の舞台である、その名の通りアサイラムに迷い込んだ彼女は、"},{"spoiler":false,"text":"ただ故郷に帰りたいという目的だけを持ち行動を開始します。"},{"spoiler":false,"text":"マリスは、彼女と同じようにアサイラムに迷い込んだ人々と出会い、"},{"spoiler":false,"text":"彼らの協力を得ながら、この地を脱出するための方法を探す冒険に出ます。"},{"spoiler":false,"text":"その性格"},{"spoiler":false,"text":"マリスは見た目に反して子供っぽい性格で、"},{"spoiler":false,"text":"良く言えば無邪気、悪く言えば無知で世間知らずです。"},{"spoiler":false,"text":"また人間ではないためか倫理観に欠けているところがあります。"},{"spoiler":false,"text":"とはいえ決して悪人ではなく、また素直でもあるため、"},{"spoiler":false,"text":"変わった人物ではありますが人当たりは悪くありません。"},{"spoiler":false,"text":"分からないことは分からないと正直に言えるタイプです。"},{"spoiler":false,"text":"性の知識"},{"spoiler":false,"text":"マリスは性的なことに関しても無知です。"},{"spoiler":false,"text":"「そういう行為をしたことがない」というようなものではなく、"},{"spoiler":false,"text":"性行為自体を全く知りません。"},{"spoiler":false,"text":"しかしながら物覚えがよく、そして快感に対しても素直なので、"},{"spoiler":false,"text":"一度経験すると目覚ましい成長を遂げることでしょう。"},{"spoiler":false,"text":"無知なマリスがどのように変わっていくのか、ぜひ楽しみにしてください。"}],"source":"bangumi","sourceCharacterId":"156347"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/942a1b694633ebeabd71bfa7690ac39d97e04427103863ecbbe1a28dc588f487.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f29cf33686801ade9b65f5458695274088aa1be376384c6743f83c19080e239a.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_156348","characterName":"ヴェルサ・アンシーン","sourceIds":{"bangumi":[{"characterId":"156348","match":"source-roster","subjectId":"312095"},{"characterId":"156348","match":"source-roster","subjectId":"347465"}]},"originalCharacterName":"ヴェルサ・アンシーン","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヴェルサ・アンシーンは、遥か昔にマリスと同じようにアサイラムに迷い込んだ女性です。"},{"spoiler":false,"text":"彼女もまた故郷に帰ろうと様々な活動を続けてきたようですが、"},{"spoiler":false,"text":"結局、脱出することはできず今に至っています。"},{"spoiler":false,"text":"ヴェルサは今ではアサイラムの脱出を諦めてしまっており、"},{"spoiler":false,"text":"拠点である宵の聖域でまったり過ごしています。"},{"spoiler":false,"text":"新たにやってきたマリスに助言を与えはしますが、"},{"spoiler":false,"text":"彼女が本当にアサイラムから脱出できるとは思っていないようです。"},{"spoiler":false,"text":"立場"},{"spoiler":false,"text":"宵の聖域の最古参であるヴェルサは、同所の住人の保護者的存在と言えます。"},{"spoiler":false,"text":"見た目こそ幼い少女のようですが、内面はまるで母親のようで、皆に慕われています。"},{"spoiler":false,"text":"マリスもまたヴェルサには気を許します。"},{"spoiler":false,"text":"二人の絆は『アサイラム』のシナリオにおいて重要なものとなります。"},{"spoiler":false,"text":"性格"},{"spoiler":false,"text":"ヴェルサは一言では言い表しがたい性格をしています。"},{"spoiler":false,"text":"基本的には温厚でのんびりとしていますが、どことなくつかみどころがなく、"},{"spoiler":false,"text":"大人のようで子供のような、ある種の神秘性を持つ人物です。"},{"spoiler":false,"text":"ただ、いずれにせよ内面は成熟しており、性の経験も豊富なようです。"},{"spoiler":false,"text":"ヴェルサはシーンが存在するキャラクターですが、"},{"spoiler":false,"text":"その内容は相手を完全に手玉に取ったようなものとなっています。"},{"spoiler":false,"text":"女性上位であることは他と同じですが、苛烈に責めるというよりは、"},{"spoiler":false,"text":"言葉や仕草等で男性を翻弄するタイプです。"}],"source":"bangumi","sourceCharacterId":"156348"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db22d0ada6cd7b26d469c7d2bba14577dc7fc13276d2c631d9281ebd4abf1fb2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b026f2edab010ae785635f6bbd716f40255db926d50c66319c5d2fac5ad9a37.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_156349","characterName":"刻印作りのメル","sourceIds":{"bangumi":[{"characterId":"156349","match":"source-roster","subjectId":"312095"}]},"originalCharacterName":"刻印作りのメル","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"メルは宵の聖域で静かに過ごしている女性です。"},{"spoiler":false,"text":"アサイラムからの脱出を強く願っている様子はなく、"},{"spoiler":false,"text":"住人の中では最も覇気がなく、消極的な人物です。"},{"spoiler":false,"text":"実際のところ、彼女は変化を求めていません。"},{"spoiler":false,"text":"大人しくしていれば傷つくこともないのだから、無駄に抗う必要はないと考えています。"},{"spoiler":false,"text":"しかし反面、積極的に行動するマリスやラルスをどこか羨ましく思っています。"},{"spoiler":false,"text":"ゲーム的な一面としては、メルは装備品である刻印を作り出すことができます。"},{"spoiler":false,"text":"刻印はゲームの攻略に必須と言える要素ですので、長らくお世話になることでしょう。"},{"spoiler":false,"text":"ちなみに、メルにはシーンが存在します。"}],"source":"bangumi","sourceCharacterId":"156349"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/918079af6efe03e7bd4739fca32741e7df17e1584b49795a04300f3dc55af1c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72c7f3806e55b8419e1d8044f16d129fa7cd4f53abb8c5aaf330b91dda166742.webp","width":134,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_156350","characterName":"名もなき商売人","sourceIds":{"bangumi":[{"characterId":"156350","match":"source-roster","subjectId":"312095"}]},"originalCharacterName":"名もなき商売人","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"宵の聖域には商売人と名乗る男性がいます。"},{"spoiler":false,"text":"彼は名前を忘れてしまっており、自分が何者なのか、"},{"spoiler":false,"text":"何をしたいのか、何をすべきなのかを分からないでいます。"},{"spoiler":false,"text":"唯一、収集癖だけは自覚しており、これを拠り所としています。"},{"spoiler":false,"text":"彼は集めた有用な道具をマナと引き換えに譲ってくれます。"}],"source":"bangumi","sourceCharacterId":"156350"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d76d5d762370d1a9e7906fd84fc4e894f84cc96657486f05760b55a4b338c800.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b59a769e86f57be17e6eb24a28934211732cb589e4c1a494931f867ebec60799.webp","width":202,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_156351","characterName":"理知の獣","sourceIds":{"bangumi":[{"characterId":"156351","match":"source-roster","subjectId":"312095"}]},"originalCharacterName":"理知の獣","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"コルデンズはマリスのように宵の聖域を拠点にアサイラムを探索しています。"},{"spoiler":false,"text":"彼は自分がアサイラムに迷い込んだことには何か理由があると考えており、"},{"spoiler":false,"text":"故郷への帰還よりも、ここでなすべき使命を探し求めています。"},{"spoiler":false,"text":"コルデンズはマリスに協力的で、必要に応じて訓練相手になってくれ、"},{"spoiler":false,"text":"過去作で言うところの「トレーニング・チキニル」と同様の役割を果たします。"},{"spoiler":false,"text":"また、コルデンズはとあるやり込み要素にも関わりますが、こちらは後日お伝えします。"},{"spoiler":false,"text":"ちなみに、コルデンズはシーンに関わります（つまり、そういうことです）。"}],"source":"bangumi","sourceCharacterId":"156351"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/8092a0ede794b3b30a1df04d49776968c91e66ce9ccf303b05047922fc907e73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/0639d65424abe67e86e64aed93f68f686bde4b8153e2f1a79c9721fc45a70600.webp","width":253,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_156352","characterName":"錬金術師ピーロ","sourceIds":{"bangumi":[{"characterId":"156352","match":"source-roster","subjectId":"312095"}]},"originalCharacterName":"錬金術師ピーロ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ピーロは宵の聖域で生活する女性です。"},{"spoiler":false,"text":"アサイラムからの脱出を願ってはいますが戦闘は不得手なようで、"},{"spoiler":false,"text":"他に自分ができることを探しています。"},{"spoiler":false,"text":"彼女ははっきり言って淫蕩で、性にだらしなく、あけっぴろげです。"},{"spoiler":false,"text":"半面、意外なことに錬金術を得意としています。"},{"spoiler":false,"text":"この二つの要素が合わさり、彼女はいかがわしい道具を作り出します。"},{"spoiler":false,"text":"ゲーム的に言うと、彼女は多くのシーンの解放に関わります。"},{"spoiler":false,"text":"攻略に関わるわけではありませんが、重要な役割を持つと言えます。"},{"spoiler":false,"text":"ちなみに、ピーロ自身のシーンも存在します。"}],"source":"bangumi","sourceCharacterId":"156352"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28bcc5db5179da30572aa0dea8065501681571be6d46f8442996d6153c1c2108.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77a6d4de6bc7f56cce6a1631c924f3ed4a384b4a9ae7602f85b0872355f36926.webp","width":169,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_156353","characterName":"悪魔斬りのラルス","sourceIds":{"bangumi":[{"characterId":"156353","match":"source-roster","subjectId":"312095"}]},"originalCharacterName":"悪魔斬りのラルス","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ラルスはアサイラムの探索に積極的な人物で、"},{"spoiler":false,"text":"宵の聖域にいることが少ないです。"},{"spoiler":false,"text":"ラルスはゲーム的な機能を持たないNPCですが、"},{"spoiler":false,"text":"彼を通じてシナリオや設定に関する情報を得られることが多いです。"},{"spoiler":false,"text":"謎に包まれたアサイラムについて深く知りたい方は、"},{"spoiler":false,"text":"彼と積極的に会話してみるとよいでしょう。"},{"spoiler":false,"text":"ちなみに以前にお伝えした男の娘のシーンはラルスと野生の雄の魔物が絡みます。"},{"spoiler":false,"text":"ラルスはノンケなので、無理矢理ホモにさせられるような"},{"spoiler":false,"text":"『SEQUEL』にはなかった雰囲気のシーンになると思います。"}],"source":"bangumi","sourceCharacterId":"156353"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/4040db73200e80cfad4b76fc76a28b74bf9273d424c4bf3af458a3ce171e5436.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/779e63596fa6476d3cb1b38b96f64a04752579f1cd2d0b84427802aed6b7a611.webp","width":200,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_156354","characterName":"星の旅人","sourceIds":{"bangumi":[{"characterId":"156354","match":"source-roster","subjectId":"312095"},{"characterId":"156354","match":"source-roster","subjectId":"435190"}]},"originalCharacterName":"星の旅人","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"イノは『イノセントルール』の主人公となる人物で、男性です。『アサイラム』ではいろいろとあった彼ですが、今では目的のない旅をしており、本作の舞台パーラテスにおいても特に理由なく冒険を始めることになります。"},{"spoiler":false,"text":"イノは無垢な少年といったようなキャラクターで、性の知識、経験共に皆無に等しいです。そんな彼が、とある理由から女性型の魔物たちを仲間にしていくことになりますが、その結果どのような目に遭うのか想像に難くありません……"}],"source":"bangumi","sourceCharacterId":"156354"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a6c53056783815518f7a6684b7e329067d38acd4634dae042ba0299d21e1ad7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7ed01c8511163bfd1def30d9efdfa336b8d9c7ae54e567cb01cb16299df2b26b.webp","width":192,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:5393","sourceCompanyId":"egs:brand:5393","canonicalEntityId":"egs:brand:5393","name":"リーフジオメトリ","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:30134:5393","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
