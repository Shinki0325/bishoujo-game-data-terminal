{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"20716","model":{"presentationWorkId":"vndb:v15464","staff":{"artwork":[{"creditedName":"オダワラハコネ(小田原箱根)","creatorId":"vndb:s1843","sourcePersonId":"egs:creator:1677","canonicalEntityId":"vndb:s1843","name":"オダワラハコネ(小田原箱根)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:137645","source":"egs"},{"creditedName":"たかやki","creatorId":"vndb:s2588","sourcePersonId":"vndb:s2588","canonicalEntityId":"vndb:s2588","name":"たかやki","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:111290","source":"vndb"}],"scenario":[{"creditedName":"モーリー","creatorId":"vndb:s2195","sourcePersonId":"egs:creator:2509","canonicalEntityId":"vndb:s2195","name":"モーリー","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:137646","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c16701","characterName":"彩咲 すみれ","sourceIds":{"bangumi":[{"characterId":"23271","match":"exact-normalized-name-in-linked-work","subjectId":"76914"}],"egsCharacterIds":["2369"],"vndbCharacterId":"c16701"},"originalCharacterName":"彩咲 すみれ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"B-Buzz off. Sometimes I just... have moments when I wanna be left alone, okay?\""},{"spoiler":false,"text":"Sumire is a classmate of Takeru, who is always acting cool and aloof (merely pretending, of course). She's part of Takeru's circle of friends, but feels a little more distant than the others."},{"spoiler":false,"text":"She thinks what Takeru's doing is praise-worthy, but can't be honest about it. In fact, she'll act the exact opposite, insulting him and berating him for acting like \"Mister Nice Guy\". She can't ultimately suppress her desire to compliment him, though, and always tacks on a \"That was nice of you\" at the end."},{"spoiler":false,"text":"You'll usually never see her acting feminine in any way, though that's more the result of her doing everything in her power to hide her feminine traits. Truthfully, she's a normal girl too, and she works hard day in and day out to make her crush, Takeru, happy."},{"spoiler":false,"text":"From English official site"}],"source":"vndb","sourceCharacterId":"c16701"},{"segments":[{"spoiler":false,"text":"クールな雰囲気（を装っている）クラスメイトの女の子。"},{"spoiler":false,"text":"健(主人公)と一緒のグループにいるけど、ちょっと離れた位置にいるように感じる。"},{"spoiler":false,"text":"健を褒めようとしても最初は素直に褒めない。"},{"spoiler":false,"text":"裏腹な態度で毒舌っぽく、健の善行を批評するが健を褒めたいという意思が表に出ているし、最後にはなんだかんだで 「よくやりましたね」などと、お褒めの言葉をかける。"},{"spoiler":false,"text":"女の子らしさは普段は見せず、むしろ壊滅的に思えるが、実のところはものすっごく女の子らしく、大好きな健に喜んでもらうために、日夜励んでいたりする。"}],"source":"egs","sourceCharacterId":"2369","sourceWorkId":"19203","spoiler":false},{"segments":[{"spoiler":false,"text":"クールな雰囲気（を装っている）クラスメイトの女の子。"},{"spoiler":false,"text":"健と一緒のグループにいるけど、ちょっと離れた位置にいるように感じる。"},{"spoiler":false,"text":"健を褒めようとしても最初は素直に褒めない。"},{"spoiler":false,"text":"裏腹な態度で毒舌っぽく健の善行を批評するが、健を褒めたいという意思が表に出ているし、最後にはなんだかんだで 「よくやりましたね」 などと、お褒めの言葉をかける。"},{"spoiler":false,"text":"女の子らしさは普段は見せず、むしろ壊滅的に思えるが、実のところはものすっごく女の子らしく、大好きな健に喜んでもらうために、日夜励んでいたりする。"},{"spoiler":false,"text":"「し、失礼ね。 わたしは……たまには1人になりたいことがあるだけよ」"}],"source":"bangumi","sourceCharacterId":"23271"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f96a42ff37f3a0cef50b3903a1fb073da4227af09f2ca1b2c00edc8ac571b104.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/1194a0b506b2e7843295b78e24f2fd11ff26dad2c9c062fbfe20da4cb322a445.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126646:23271:4727:1","source":"bangumi"}]},{"characterId":"char_c16704","characterName":"一条 葵","sourceIds":{"bangumi":[{"characterId":"23274","match":"exact-normalized-name-in-linked-work","subjectId":"76914"}],"egsCharacterIds":["2372"],"vndbCharacterId":"c16704"},"originalCharacterName":"一条 葵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Hmm? Something on your mind, Takeru-kun? My chest, is it? Having dirty thoughts now, are we?\""},{"spoiler":false,"text":"Aoi is a very outgoing, sociable girl, who's always having a good time. She does whatever she wants, whenever she wants, however she wants. You'll never know when and where she'll show up."},{"spoiler":false,"text":"She's looked up to and adorned by both boys and girls alike, and not only she is she a borderline genius who can do pretty much anything, she's also a natural beauty who approaches and befriends people of her own accord, rather than the other way round. All of that bestows her with somewhat of an idol status around school, though maybe the word diva is more fitting. She's anything but pure and virtuous."},{"spoiler":false,"text":"She's capable of pretty much anything, but she has a short attention span, never sticking to one thing and never staying in one place for too long. The meaning of life to her, is to just have fun. Lately she's found herself interested in Takeru. His reactions are interesting and amusing to her. She enjoys teasing him in every way imaginable, including kinky things."},{"spoiler":false,"text":"She's a big lover of small animals, and just cute things in general."},{"spoiler":false,"text":"From English official site"}],"source":"vndb","sourceCharacterId":"c16704"},{"segments":[{"spoiler":false,"text":"明るい雰囲気をまとい、フレンドリーで楽しげな空気を出している活発な女の子。"},{"spoiler":false,"text":"自由奔放。神出鬼没。天才肌でハイスペックな先輩。"},{"spoiler":false,"text":"男女問わず人気が高く、美人で何でも出来て先輩のほうから話しかけてくれたりするという、NOT清楚系学園アイドル。"},{"spoiler":false,"text":"何でも出来るが、飽きっぽくて一箇所に留まらない人。"},{"spoiler":false,"text":"自分の楽しいことをやるのに生きている。"},{"spoiler":false,"text":"ただ、この頃は自分の予想を裏切った反応をした健(主人公)に興味津々。"},{"spoiler":false,"text":"あの手この手（エロからかいも含む）でからかって楽しんでいる。"},{"spoiler":false,"text":"小さい動物や、可愛いものが大好き。"}],"source":"egs","sourceCharacterId":"2372","sourceWorkId":"19203","spoiler":false},{"segments":[{"spoiler":false,"text":"明るい雰囲気をまとい、フレンドリーで楽しげな空気を出している活発な女の子。"},{"spoiler":false,"text":"自由奔放。 神出鬼没。 天才肌でハイスペックな先輩。"},{"spoiler":false,"text":"男女問わず人気が高く、美人で何でも出来て先輩のほうから話し掛けてくれたりするという、NOT清楚系学園アイドル。"},{"spoiler":false,"text":"何でも出来るが、飽きっぽくて一箇所に留まらない人。"},{"spoiler":false,"text":"自分の楽しいことをやるために生きている。"},{"spoiler":false,"text":"ただ、この頃は自分の予想を裏切った反応をした健に興味津々。"},{"spoiler":false,"text":"あの手この手 （エロからかいも含む） でからかって楽しんでいる。"},{"spoiler":false,"text":"小さい動物や、可愛いものが大好き。"},{"spoiler":false,"text":"「んー？　なぁに、健くん。 胸元が気になるの？　お姉さんに興奮しちゃった？」"}],"source":"bangumi","sourceCharacterId":"23274"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/681cd6d76d6ec8321371cbc201fab1bc7ade4607a6464157ce0e15068c16c1c8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aef0c163cdc07fa971321abc7c9cef7d41f74951e6dd2c38742d926f7144ce98.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126651:23274:5741:1","source":"bangumi"}]},{"characterId":"char_vndb_c16755","characterName":"柊 千恵美","sourceIds":{"vndbCharacterId":"c16755"},"originalCharacterName":"柊 千恵美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"81"},"height":{"reviewState":"source-only","source":"vndb","value":"150"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e22aa9851276c35e92b1d3cc4f0ba368c106c157d9df32de662844953fea33f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afa75eff45936b7959453ba26e5d3452abfd22fa969c27010756aab7336b483a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜川 未央","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59470","source":"vndb"}]},{"characterId":"char_vndb_c16756","characterName":"荻嶋 鏡水","sourceIds":{"vndbCharacterId":"c16756"},"originalCharacterName":"荻嶋 鏡水","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"source-only","source":"vndb","value":"159"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aoi's best friend and classmate."}],"source":"vndb","sourceCharacterId":"c16756"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b270f63c33053d5cba1821a49d74c12e6a499538b9e82cae659bbdc6a3c54bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c34f714e1925776f5c2207d3829a152280b8ee79904b6930dd603cce7a41d27.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榛名 れん","creatorId":"vndb:s455","sourcePersonId":"vndb:s455","canonicalEntityId":"vndb:s455","name":"神保 巴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59472","source":"vndb"}]},{"characterId":"char_vndb_c77659","characterName":"柏瀬 健","sourceIds":{"vndbCharacterId":"c77659"},"originalCharacterName":"柏瀬 健","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"C'mon, just hand it over. I'll help you with that. We'll get it done faster with the both of us.\""},{"spoiler":false,"text":"Takeru is the protagonist of our story. He's in his second year of high school, and serves as the chairman of the Election Committee."},{"spoiler":false,"text":"He usually acts slaphappy, and being lazy is his forte. However, when it comes to other people, to someone who has some serious problems or trouble on their hands, he'll stop with the laughs and do everything he can to help. It's a side of him that very rarely comes out. He's a nice, generous person who won't hesitate to offer a helping hand to those in need. If a situation calls for him to be tactful and considerate, he knows to do that."},{"spoiler":false,"text":"Due to that side of his personality, he's pretty well-known. As is his friend Takuto, but for very different reasons. Before he knew it, girls were all over him, and guys looked up to him as someone they could count on if they needed something. Unfortunately, his usual nonchalant, almost indifferent, attitude ruins that. As does the shenanigans he pulls with his friend Takuto. It all just kind of balances out in the end."},{"spoiler":false,"text":"He's not a morning person at all, so when he's forced to wake up on his own, he usually has to rush to school to avoid being tardy. His mom often nags him about that, as she does with his other bad habits."},{"spoiler":false,"text":"From English official site"}],"source":"vndb","sourceCharacterId":"c77659"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:509","sourceCompanyId":"egs:brand:509","canonicalEntityId":"egs:brand:509","name":"HOOKSOFT(HOOK)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:20716:509","source":"egs"},{"companyId":"vndb:p106","sourceCompanyId":"vndb:p106","canonicalEntityId":"vndb:p106","name":"HOOKSOFT","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:150859:v15464","source":"vndb"},{"companyId":"vndb:p106","sourceCompanyId":"vndb:p106","canonicalEntityId":"vndb:p106","name":"HOOKSOFT","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:40004:v15464","source":"vndb"},{"companyId":"vndb:p106","sourceCompanyId":"vndb:p106","canonicalEntityId":"vndb:p106","name":"HOOKSOFT","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:40005:v15464","source":"vndb"},{"companyId":"vndb:p4468","sourceCompanyId":"vndb:p4468","canonicalEntityId":"vndb:p4468","name":"脸肿汉化组","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:47605:v15464","source":"vndb"},{"companyId":"vndb:p106","sourceCompanyId":"vndb:p106","canonicalEntityId":"vndb:p106","name":"HOOKSOFT","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:80255:v15464","source":"vndb"},{"companyId":"vndb:p106","sourceCompanyId":"vndb:p106","canonicalEntityId":"vndb:p106","name":"HOOKSOFT","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:83698:v15464","source":"vndb"},{"companyId":"vndb:p106","sourceCompanyId":"vndb:p106","canonicalEntityId":"vndb:p106","name":"HOOKSOFT","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:83699:v15464","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
