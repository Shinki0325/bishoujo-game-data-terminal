]},{"characterId":"char_vndb_c8877","characterName":"ココ・ナッツミルク","sourceIds":{"vndbCharacterId":"c8877"},"originalCharacterName":"ココ・ナッツミルク","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Coco is the radar operator on the Elsior. She is friendly and a good friend of Almo."},{"spoiler":false,"text":"Translated from developer's website"}],"source":"vndb","sourceCharacterId":"c8877"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/715d76a2f9258d7794e61ae50fc16e9f94b4d657ea5bdc2c8b29a75ac90878b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6ef0f611b06b0bcd80847b87abc0b7545f5bcef931c4e0e55663bf76fa6536e8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅野 るり","creatorId":"vndb:s1239","sourcePersonId":"vndb:s1239","canonicalEntityId":"vndb:s1239","name":"浅野 るり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8357","source":"vndb"}]},{"characterId":"char_vndb_c8878","characterName":"クレータ・ビスキュイ","sourceIds":{"vndbCharacterId":"c8878"},"originalCharacterName":"クレータ・ビスキュイ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Creta is in charge of maintenance of the Elsior and Emblem Frames. She is a major fan of bishonen idol Ricky Kart."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c8878"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/9756a5ee7274b545526c73f9ef92304cb4512989e1617f2a7e931b8092b69532.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21d69fa8862757a5c63d153f3d08b79eed3627965af956bcd5b5ff36b799ac51.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小島 幸子","creatorId":"vndb:s16617","sourcePersonId":"vndb:s16617","canonicalEntityId":"vndb:s16617","name":"小島幸子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8365","source":"vndb"}]},{"characterId":"char_vndb_c8879","characterName":"ケーラ・ヘーゼル","sourceIds":{"vndbCharacterId":"c8879"},"originalCharacterName":"ケーラ・ヘーゼル","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kela Hazel is the Elsior's doctor, specializing in counseling. She has a major love of coffee and enjoys knitting as a hobby."},{"spoiler":false,"text":"From Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c8879"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a6351b147c1a9c59494ac431b3e8306a726d0e026edf9f97197b4ea171a1a68.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7e462256c0a21c13d44f6a4fa85d892157ff07f8690d861d1271bb25df3ae45.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大原 さやか","creatorId":"vndb:s100","sourcePersonId":"vndb:s100","canonicalEntityId":"vndb:s100","name":"大原 さやか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8350","source":"vndb"}]},{"characterId":"char_vndb_c8880","characterName":"クロミエ・クワルク","sourceIds":{"vndbCharacterId":"c8880"},"originalCharacterName":"クロミエ・クワルク","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"142"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kuromie Quark looks after the animals onboard the Elsior, and also is one of the few known people who can understand the mysterious Space Whales. Whenever Tact visits the Whale Room, Tact can ask Kuromie to get a \"reading\" (by communicating with the Space Whales) on how all the Angels feel about him."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c8880"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67a0e73ac2642c228a93aa2416036575de446c89fd4a64da4c1bba3016307cd5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85884b8a9a4e5dd7880cbdafc407810fe4a0d84d8d52243bdd3f8b5b0f987272.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"能登 麻美子","creatorId":"vndb:s468","sourcePersonId":"vndb:s468","canonicalEntityId":"vndb:s468","name":"能登 麻美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8353","source":"vndb"}]},{"characterId":"char_vndb_c897","characterName":"ルフト・ヴァイツェン","sourceIds":{"vndbCharacterId":"c897"},"originalCharacterName":"ルフト・ヴァイツェン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Luft Weizen was a general in the Transbaal Empire Armed Forces, as well as Tact Mayers's old teacher. He not only rescued Takuto, but gave him command of both the Elle Ciel and Angel Troupe."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"},{"spoiler":true,"text":"At the end of the Galaxy Angel story he became Minister of Defence and Prime minister of Transbaal Empire"}],"source":"vndb","sourceCharacterId":"c897"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/8622edee7b7bbce2f06d06a1d030676dc8fb1e66a0d7660d331ab8e2d93c5001.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/663e35833fbaada7b1ac8fe828b2888fa40197d67b62b5ca73fcb5bcedb38fd2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"納谷 六朗","creatorId":"vndb:s10569","sourcePersonId":"vndb:s10569","canonicalEntityId":"vndb:s10569","name":"納谷 六朗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8364","source":"vndb"}]},{"characterId":"char_vndb_c898","characterName":"ノア","sourceIds":{"vndbCharacterId":"c898"},"originalCharacterName":"ノア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"141"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The administrator of the Black Moon."},{"spoiler":false,"text":"From Galaxy Angel Wiki"},{"spoiler":true,"text":"She became the foremost expert in Lost Technology in the Transbaal Empire, and spearheaded research and development efforts of new Lost Technology."}],"source":"vndb","sourceCharacterId":"c898"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2c65c0880b6f467f2b93bdfedb1faf587a820a99175f20b48a1c4967564be4f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/626f2131bd53142fe6c0cc23d8626eed7f83090ec97aa7dcaba05a66dcd55253.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"谷井 あすか","creatorId":"vndb:s657","sourcePersonId":"vndb:s657","canonicalEntityId":"vndb:s657","name":"谷井 あすか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8356","source":"vndb"}]},{"characterId":"char_vndb_c899","characterName":"シヴァ・トランスバール","sourceIds":{"vndbCharacterId":"c899"},"originalCharacterName":"シヴァ・トランスバール","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The only surviving member of the royal family of the Transbaal Kingdom, Prince Shiva is the target of assassination of Prince Eonia, and is under the constant protection of both the Angel Troupe and the Elsior. Raised on the White Moon, he is somewhat antisocial towards others and would rather remain secluded within his room onboard the Elsior. Also quite belligerent to Tact at first, demanding that the Elsior head straight back to Transbaal and stop Eonia at once. Possesses a heavy burden of being the last of the royal family, with knowledge that he must become king at such a young age."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"},{"spoiler":true,"text":"Actually Shiva is a girl. Her true gender could be found at the end of the Galaxy Angel story and is already known at the beginning of Moonlit Lovers."},{"spoiler":true,"text":"Lady Shatoyan, who is Shiva's guardian is actually her real mother."}],"source":"vndb","sourceCharacterId":"c899"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e44417985845fe63bf92c75825371f72de84e22ae21b36a58016da298b66967c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48