entityStatus":"source-native","relationId":"vndb:vn-staff:16819","source":"vndb"},{"creditedName":"里見 哲朗","creatorId":"vndb:s23906","sourcePersonId":"vndb:s23906","canonicalEntityId":"vndb:s23906","name":"里見 哲朗","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:16821","source":"vndb"},{"creditedName":"甑 ひとみ","creatorId":"vndb:s23907","sourcePersonId":"vndb:s23907","canonicalEntityId":"vndb:s23907","name":"甑 ひとみ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:16822","source":"vndb"},{"creditedName":"草薙","creatorId":"vndb:s13199","sourcePersonId":"vndb:s13199","canonicalEntityId":"vndb:s13199","name":"株式会社草薙","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:16829","source":"vndb"},{"creditedName":"飯島 正樹","creatorId":"vndb:s23914","sourcePersonId":"vndb:s23914","canonicalEntityId":"vndb:s23914","name":"飯島 正樹","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:16830","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c1079","characterName":"日向","sourceIds":{"vndbCharacterId":"c1079"},"originalCharacterName":"日向","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Commander of the 18th Empire fleet."},{"spoiler":true,"text":"Hyuuga was adjutant of Chitose's father. He is grateful to him for saving his life and the lives of the crew during the accident several years ago. He was the one who gave Chitose her stuffed animal, which was her father's last present to her."}],"source":"vndb","sourceCharacterId":"c1079"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa81ed1446848b3c1342fd032208b40c30fbab10dbe935dd66be495918121982.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8ccb52d539b737fbc2acaed720bc6b7057711de5cdd72b31a451a3ea689a322.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c809","characterName":"ミルフィーユ・桜葉","sourceIds":{"vndbCharacterId":"c809"},"originalCharacterName":"ミルフィーユ・桜葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Milfeulle Sakuraba is a member of the Moon Angel Troupe. Her hobby is cooking snacks, particularly cake, and making tea. She pilots the Emblem Frame Lucky Star."},{"spoiler":false,"text":"Milfeulle is always caring and cheerful and will never hesitate to help another person, even an enemy. Her extreme luck caused her little but trouble when she was younger and the isolation, combined with her highly emotional nature, causes her to blame herself and her power whenever something goes wrong. Milfeulle is the most naive of the Angels and, though not stupid by any means, she can be clueless and accident-prone. She is incredibly slow to anger, usually becoming sad or disappointed if displeased. Otherwise she is extremely expressive, often accompanying her moods with exaggerated speech and body language. Likewise, she is almost incapable of hatred or antagonism; rather than hating Eonia for what he has done she finds it sad that he is willing to drown the galaxy in blood just because he is unhappy. Milfeulle also dislikes the idea of anyone dying for anyone else, no matter how noble the cause, since it would still create sadness for the loved ones left behind."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c809"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/622d672294ef70cd307f3d20aa08beaa6e29fe29a2f2282ee8a79fe9e3cdb9ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d87738ffe7a9eb9726b22349a79af93cf7e00cfa692aae401f8d484ecaed9f2c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新谷 良子","creatorId":"vndb:s3626","sourcePersonId":"vndb:s3626","canonicalEntityId":"vndb:s3626","name":"新谷 良子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8361","source":"vndb"}]},{"characterId":"char_vndb_c811","characterName":"タクト・マイヤーズ","sourceIds":{"vndbCharacterId":"c811"},"originalCharacterName":"タクト・マイヤーズ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"171"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tact was defined by three things: his carefree attitude, his empathic nature and his sharp mind. While on the surface he appeared to be unreliable and lazy, he was actually a highly competent strategist and tactician. As his friend Lester remarks at one point, while Tact's behavior is embarrassing at times, he is at his best when it matters the most."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c811"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b85dee44c7523e3a1cc814899da647214edd2e9b556b4c8be6553bf9456f4420.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0de390dfb9b10d72f5904ee17b62d0801c489f770fa060f1d8fa59472b805aa6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"上田 祐司","creatorId":"vndb:s1443","sourcePersonId":"vndb:s1443","canonicalEntityId":"vndb:s1443","name":"うえだ ゆうじ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8358","source":"vndb"}]},{"characterId":"char_vndb_c812","characterName":"ヴァニラ・H","sourceIds":{"vndbCharacterId":"c812"},"originalCharacterName":"ヴァニラ・H","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"13"},"height":{"reviewState":"source-only","source":"vndb","value":"132"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Vanilla H is the youngest member of the Moon Angel Troupe, and she pilots the Emblem Frame GA-005, also known as Harvester. She has the ability to control nanomachines, which allowes her to treat wounds, and with the assistance of Harvester, repair machinery as well."},{"spoiler":false,"text":"A very stoic girl, she hardly ever showed any emotion and spoke in a deadpan voice. She was always seen wearing a headgear featuring a red gem on top, possibly a mark of her family or religion."},{"spoiler":false,"text":"Age 13 in GA and 14 in the later games."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c812"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85263a8e146bbc6cce863b40516757763e4dcc23fc3302a04b319721b65e0b11.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82302d5ee9bd74b45813a2425f4178cf1bb6ee1530c67c17c0cacec4129cd853.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"かない みか","creatorId":"vndb:s1818","sourcePersonId":"vndb:s1818","canonicalEntityId":"vndb:s1818","name":"かない みか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8359","source":"vndb"}]},{"characterId":"char_vndb_c813","characterName":"烏丸ちとせ","sourceIds":{"vndbCharacterId":"c813"},"originalCharacterName":"烏丸ちとせ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chitose is a member of the Moon Angel Troupe and pilots the Emblem Frame Sharp Shooter."},{"spoiler":false,"text":"A traditional, polite, and soft-spoken young woman, Chitose joined the military for two reasons; for her respect and admiration for both her father and the Angel Troupe. Extremely intelligent, Chitose became an elite within the military, scoring the highest marks ever in the military exam, defeating even Milfeuille (whom scored the second highest due to her luck)."},{"spoiler":false,"text":"Highly experienced in archery, Chitose ends up being chosen as the pilot of the 6th Angel Frame, the \"Sharp Shooter\", which is designed for extreme range sniping. Chitose greatly respects her friends/teammates in the Angel Troupe, to the point where she wishes not to do anything that might offend them, even to the point of forcing herself to suppress her growing feelings for Tact."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c813"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64807d36150ef8dc84d7a4a600db7695524bce8c30903732a16b2284fc1e66d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e496f9db627476c954999608cdbf652a00e9bd400569505f78aad0522a18d5b0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤 沙緒里","creatorId":"vndb:s244","sourcePersonId":"vndb:s244","canonicalEntityId":"vndb:s244","name":"後藤沙緒里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8352","source":"vndb"}]},{"characterId":"char_vndb_c820","characterName":"蘭花・フランボワーズ","sourceIds":{"vndbCharacterId":"c820"},"originalCharacterName":"蘭花・フランボワーズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ranpha Franboise is a member of the Moon Angel Troupe and pilots the emblem frame Kung-fu Fighter."},{"spoiler":false,"text":"Ranpha is a proud and sometimes harsh woman who can be difficult to approach but is kind to people she considers her friends and is willing to put their feelings and needs before her own. She favours a direct approach to problem solving, often defusing situations with an application of brute force that coincides well with the Kung Fu Fighter's abilities."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c820"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/1712ebb58e9eb67105570311c64dfd867fbd5580db44fcb9705c59161943c0b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f7ecb2486a2cb8d10198f4ce9fdbfb7f435722260c683c0d59ecf31e67ef2df.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田村 ゆかり","creatorId":"vndb:s104","sourcePersonId":"vndb:s104","canonicalEntityId":"vndb:s104","name":"田村 ゆかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8351","source":"vndb"}]},{"characterId":"char_vndb_c821","characterName":"ミント・ブラマンシュ","sourceIds":{"vndbCharacterId":"c821"},"originalCharacterName":"ミント・ブラマンシュ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"height":{"reviewState":"source-only","source":"vndb","value":"123"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mint Blancmanche is a member of the Moon Angel Troupe and pilots the Emblem Frame Trick Master."},{"spoiler":false,"text":"Possessing telepathic abilities, Mint can read the surface thoughts of others, even if she doesn't want to. This led to her reluctancy to be with others outside the Angel Troupe. She loves all candy and exotic tea, particularly Orange Pekoe from the planet Nirugi and tea leaf from the Samrong system. Mint also has a fascination for fast food owing to her sheltered life in the Blancmanche family mansion. The one thing she keeps secret from even her closest friends is her hobby of dressing up in animal costumes."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c821"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c4a8e07fdf97d7efd75249b747738fcb8e39ff0431640a7daf957a51399d155.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4eab33bbdbf76f6ba1d72d8ae18ccbd99d81f56d21559d1d81c611ad275cfc9a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"沢城 みゆき","creatorId":"vndb:s43","sourcePersonId":"vndb:s43","canonicalEntityId":"vndb:s43","name":"沢城 みゆき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8348","source":"vndb"}]},{"characterId":"char_vndb_c822","characterName":"フォルテ・シュトーレン","sourceIds":{"vndbCharacterId":"c822"},"originalCharacterName":"フォルテ・シュトーレン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Forte Stollen is a member of the Moon Angel Troupe and pilots the Emblem Frame Happy Trigger."},{"spoiler":false,"text":"Forte is the leader of the Moon Angel Troupe. Being the oldest, Forte acts as the big sister of the group, often giving advice to others. Like many of the other characters in the first game, Forte is less than impressed with the appointment of Tact as the commander of the Elsior and bluntly tells him that she will not consider him her commander until he proves himself. He eventually does, and she begins to trust him as much as she would her teammates on the Angels."},{"spoiler":false,"text":"Forte is the most experienced among the Angels, and is intimately familiar with such details as the mechanics of Milfeulle's luck as well as the workings of the Emblem Frames. She is fond of gunpowder weapons rather than laser weapons, even though gunpowder weapons are difficult to come by in the time period in which the games take place."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c822"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0164343745823c5d8922fca47c51a44f709ff6274d52ae19fbcd79b2636c5ec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/615137ed30e8e055b4563526c16d8bf46d8347ae23b1d06e0b5205a7309fd072.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山口 眞弓","creatorId":"vndb:s3103","sourcePersonId":"vndb:s3103","canonicalEntityId":"vndb:s3103","name":"山口 眞弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8360","source":"vndb"}]},{"characterId":"char_vndb_c836","characterName":"レスター・クールダラス","sourceIds":{"vndbCharacterId":"c836"},"originalCharacterName":"レスター・クールダラス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"186"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The first officer of the Elsior, Lester spends most of his time either making sure that Tact is doing his job as a commander, or trying to find Tact as he goes off on one of his crazy adventures with the Angel Troupe. Has known Tact since the military academy, and has been with him ever since."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c836"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/5377e239245d3505cecdc1e8a398df126243d3f189a3ba1c5812d83db5caf5f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c501d89a27a2383f91749adc4899dea38455fbdfdff37349e021bf8a8ae9c32.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小西 克幸","creatorId":"vndb:s65","sourcePersonId":"vndb:s65","canonicalEntityId":"vndb:s65","name":"小西克幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8349","source":"vndb"}]},{"characterId":"char_vndb_c883","characterName":"シャトヤーン","sourceIds":{"vndbCharacterId":"c883"},"originalCharacterName":"シャトヤーン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Referred to as a saint by virtually every character in the games, she is the ruler of the White Moon that orbits the homeworld of the Transbaal Empire. The respect she is given by other characters (including Tact Mayers, who generally eschews the use of honorifics) is shown by the suffix '-sama' (様), which is used to refer to those of a much higher rank."},{"spoiler":false,"text":"Edited from Galaxy Angel Wiki"}],"source":"vndb","sourceCharacterId":"c883"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/8611bc7ba6e3d88a8e77a2980ba9b48699a8253ddce48fdbb40c5c6b0954bb03.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c65c92584f34a9a41177e98a610e760eeb994566a52d1c211d533b240021b2d6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上 喜久子","creatorId":"vndb:s473","sourcePersonId":"vndb:s473","canonicalEntityId":"vndb:s473","name":"井上喜久子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8354","source":"vndb"}]},{"characterId":"char_vndb_c8832","characterName":"ネフューリア","sourceIds":{"vndbCharacterId":"c8832"},"originalCharacterName":"ネフューリア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nefyuuria is Rezom's first officer, but she is only using him for her own purposes. She is cruel and apathetic toward her enemies, believing herself to be inherently superior."},{"spoiler":true,"text":"She soon reveals herself to be from the Val Fasq race aiming to conquer the Transbaal empire."}],"source":"vndb","sourceCharacterId":"c8832"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"