},{"creditedName":"nao","creatorId":"vndb:s935","sourcePersonId":"vndb:s935","canonicalEntityId":"vndb:s935","name":"nao","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:66520","source":"vndb"},{"creditedName":"島みや えい子","creatorId":"vndb:s1468","sourcePersonId":"vndb:s1468","canonicalEntityId":"vndb:s1468","name":"島みやえい子(島宮えい子)","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:66521","source":"vndb"},{"creditedName":"山下 慎一狼","creatorId":"vndb:s4927","sourcePersonId":"vndb:s4927","canonicalEntityId":"vndb:s4927","name":"山下 慎一狼","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66526","source":"vndb"},{"creditedName":"IWAKO","creatorId":"vndb:s7155","sourcePersonId":"vndb:s7155","canonicalEntityId":"vndb:s7155","name":"IWAKO","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66527","source":"vndb"},{"creditedName":"株式会社キューン・プラント","creatorId":"vndb:s7417","sourcePersonId":"vndb:s7417","canonicalEntityId":"vndb:s7417","name":"株式会社キューン・プラント(quunplant)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66528","source":"vndb"},{"creditedName":"泉水 いこ","creatorId":"vndb:s7802","sourcePersonId":"vndb:s7802","canonicalEntityId":"vndb:s7802","name":"泉水 いこ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66530","source":"vndb"},{"creditedName":"外道サキ","creatorId":"vndb:s41179","sourcePersonId":"vndb:s41179","canonicalEntityId":"vndb:s41179","name":"外道サキ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66531","source":"vndb"}]},"cast":[{"characterId":"char_c59131","characterName":"白","sourceIds":{"bangumi":[{"characterId":"59233","match":"exact-normalized-name-in-linked-work","subjectId":"19444"}],"egsCharacterIds":["15352"],"vndbCharacterId":"c59131"},"originalCharacterName":"白","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious girl, who is a zashikiwarashi. She is sent to protect Kazuma from his misfortunes and make him stronger."}],"source":"vndb","sourceCharacterId":"c59131"},{"segments":[{"spoiler":false,"text":"自称座敷わらし。"},{"spoiler":false,"text":"家の前にダンボールで捨てられていた白髪の少女。"},{"spoiler":false,"text":"しかしその力は箪笥の奥から１０円見つけることができるとか、茶柱が立つといった程度。"},{"spoiler":false,"text":"（本人は一馬の不幸体質の所為で本来の力を発揮できないと言っているが真偽は不明）"},{"spoiler":false,"text":"基本的に控えめで怖がりだが、一馬のことを「ぱぱ」と呼び慕っており、一馬の前では儚げながらも微笑みを絶やさない。"},{"spoiler":false,"text":"一馬に拾われて「白」と名づけられ屋敷に居座ることに。"}],"source":"egs","sourceCharacterId":"15352","sourceWorkId":"14736","spoiler":false},{"segments":[{"spoiler":false,"text":"突然在一馬家里出现的白发少女。自称是座敷童。"},{"spoiler":false,"text":"但那力量最多只是能从衣柜里找到10日元或让茶叶棍立起来的程度。"},{"spoiler":false,"text":"（虽然她本人解释是因为一馬的不幸体质使她的原本力量发挥不了？）"},{"spoiler":false,"text":"基本上是谨慎胆小，但却很亲昵地叫一馬做“爸爸”，在一馬面前是既虚渺又笑容不绝。"},{"spoiler":false,"text":"被一馬起名为「白」，在大屋里赖着不走。"},{"spoiler":false,"text":"「爸爸，你抱起白的话就一定能变得幸福的哦——」"}],"source":"bangumi","sourceCharacterId":"59233"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a130536f56ffd7bce712792672701216b9a2c0aeb80be6f048f5ef68017e333.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/9760d4a9bac645912b6868fa199e417bdff603fb94e72c1798bb012f2d407c7b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"mahilo","creatorId":"vndb:s1492","sourcePersonId":"vndb:s1492","canonicalEntityId":"vndb:s1492","name":"眞尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19444:59233:34633:1","source":"bangumi"}]},{"characterId":"char_c59132","characterName":"天童 一花","sourceIds":{"bangumi":[{"characterId":"59234","match":"exact-normalized-name-in-linked-work","subjectId":"19444"}],"egsCharacterIds":["15353"],"vndbCharacterId":"c59132"},"originalCharacterName":"天童 一花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The younger sister of Kazuma. Usually gets jealous when sees him with other girls and tries to make all his attention hers."}],"source":"vndb","sourceCharacterId":"c59132"},{"segments":[{"spoiler":false,"text":"若くして天童家の頭首として君臨する一馬の妹。そして重度のブラコン。"},{"spoiler":false,"text":"一馬に対して兄妹として以上の愛情を抱いており、一馬に甘えられる時間を何より大切にしている。"},{"spoiler":false,"text":"そのための労力は惜しまない、努力の人。"},{"spoiler":false,"text":"若くして当主となったのも、一馬が当主としての仕事に忙殺されて、自分との時間が減ることを嫌ったため。"},{"spoiler":false,"text":"頭首としての仕事等で、どうしても一馬と共に居られない時のために、グループ傘下企業の技術力を無駄に駆使して「兄グッズ」を製作している変態。"}],"source":"egs","sourceCharacterId":"15353","sourceWorkId":"14736","spoiler":false},{"segments":[{"spoiler":false,"text":"年纪轻轻就以当家身份君临天童家，一馬的妹妹。而且是重度的兄控。"},{"spoiler":false,"text":"对一馬有着兄妹以上的爱意，将能向一馬撒娇的时间看得比什么都重要。"},{"spoiler":false,"text":"因为此不惜努力，是相当努力的人。"},{"spoiler":false,"text":"年纪轻轻就当上当家也是因为不想一馬因工作过忙而减少和自己一起的时间。"},{"spoiler":false,"text":"有时要处理当家的工作而不能和一馬一起，为此她乱用旗下企业的技术能力制作出『哥哥GOODS』,她就是这样的变态。"},{"spoiler":false,"text":"「哥、哥哥！ 你在发什么呆！ 拥抱啊摸摸头啊之类的，你因该有更多要为我做的吧!?」"}],"source":"bangumi","sourceCharacterId":"59234"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1be0959fb5a0a450f0bb6f3e77a0a2b0c3fb023a065c2da0a9d897d034e03df9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0fc939a262e290e0753738763a0ab702bedd1562768aa8b3558762a6904acc04.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19444:59234:10027:1","source":"bangumi"}]},{"characterId":"char_c59133","characterName":"三島 葉子","sourceIds":{"bangumi":[{"characterId":"59235","match":"exact-normalized-name-in-linked-work","subjectId":"19444"}],"egsCharacterIds":["15354"],"vndbCharacterId":"c59133"},"originalCharacterName":"三島 葉子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kazuma's maid, who replaced his real mother and raised him as her own child. She's not good at cooking and cleaning, but good at fighting. Believes that one day Kazuma will make her his wife."}],"source":"vndb","sourceCharacterId":"c59133"},{"segments":[{"spoiler":false,"text":"一馬付のメイド（護衛役）。"},{"spoiler":false,"text":"生後間もなくから一馬を任された、実質一馬を育てた母親代わりの女性。"},{"spoiler":false,"text":"しかし、戦闘能力に特化していたため、メイドとしての能力、家事全般といったことに関しては不得手。"},{"spoiler":false,"text":"その関係の長さから、一馬のことを一番良く理解していると自負しており、そのことで一花と小競り合いを見せることもしばしば。"},{"spoiler":false,"text":"幼少期に一馬が自分にプロポーズしてくれたことをずっと心に抱いていて、今でもいつか一馬が自分をお嫁さんにしてくれると信じている。"},{"spoiler":false,"text":"作中一番の巨乳さん。"}],"source":"egs","sourceCharacterId":"15354","sourceWorkId":"14736","spoiler":false},{"segments":[{"spoiler":false,"text":"一馬的近身女仆（护卫）。"},{"spoiler":false,"text":"一馬出生后不久就交给了她负责，实质上是代为养育一馬的母亲般的女性。"},{"spoiler":false,"text":"但因为特化了战斗能力，所以作为女仆的能力和全部家务相关就不擅长。"},{"spoiler":false,"text":"因为两人的关系长久，自认为对一馬是最为理解，也因此常常和一花有些小竞争。"},{"spoiler":false,"text":"一直思念着一馬在年幼时曾向自己求婚的事，而且还相信着一馬总有一天会娶自己为新娘子。"},{"spoiler":false,"text":"「那个……一馬大人，我并不是你的母亲呀——」"}],"source":"bangumi","sourceCharacterId":"59235"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/483d7d5d9ab331b4de3f375542a65c62a68b25e9dcda84a504d314239f79b9ef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e17c9d228e1cbd5a26929376b53240cd476ef14bbc7e64cd0ad968c48156af26.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻レオナ","creatorId":"vndb:s7025","sourcePersonId":"vndb:s7025","canonicalEntityId":"vndb:s7025","name":"櫻レオナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19444:59235:29845:1","source":"bangumi"}]},{"characterId":"char_c59134","characterName":"野々村 樹子","sourceIds":{"bangumi":[{"characterId":"59236","match":"exact-normalized-name-in-linked-work","subjectId":"19444"}],"egsCharacterIds":["15355"],"vndbCharacterId":"c59134"},"originalCharacterName":"野々村 樹子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ichika's maid, who likes to tease people (teasing Ichika is also her daily routine). Also has a hobby to plant some mysterious plants behind the mansion (there are rumors that that plants is not from our world)."}],"source":"vndb","sourceCharacterId":"c59134"},{"segments":[{"spoiler":false,"text":"一花付のメイド。"},{"spoiler":false,"text":"家事全般から一花の仕事の補佐まで完璧こなす。"},{"spoiler":false,"text":"しかし、人をからかうことに生き甲斐を感じており、メイドという立場にありながら、一花からかって遊ぶことも日常茶飯事。"},{"spoiler":false,"text":"そして、その魔の手は白や葉子、一馬にまで及び、純真な彼らに変態的な行為を吹聴していく。"},{"spoiler":false,"text":"ガーデニングが趣味で、屋敷の庭すべてを一人で管理している。"},{"spoiler":false,"text":"しかし、一部では世に出せないような怪しい植物を栽培しているいう噂も。"}],"source":"egs","sourceCharacterId":"15355","sourceWorkId":"14736","spoiler":false},{"segments":[{"spoiler":false,"text":"一花的近身女仆。"},{"spoiler":false,"text":"从家务到一花工作的辅助都做得很完美。"},{"spoiler":false,"text":"不过，在戏弄人时才感到有人生意义，虽然她于女仆的立场，但戏弄一花拿来玩乐也是家常便饭。"},{"spoiler":false,"text":"而且，她的魔爪甚至还伸向了白和葉子以及一馬，给纯真的他们宣传变态的行为。"},{"spoiler":false,"text":"园艺是兴趣，大屋领地内的庭院全由她一人打理着。"},{"spoiler":false,"text":"但也有传闻她栽培着一些不见得光的可疑植物。"},{"spoiler":false,"text":"「啊哈哈～还要问为什么吗，因为我是魔法使者啊」"}],"source":"bangumi","sourceCharacterId":"59236"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b42af8f2b1a31b5f7c019d2cbeb96d7cfab331c61fd6e6351b97ec4a65ade6c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da4889562aa58053c5a227712ff4b7ad155459e0890ee9f3a0df77a1095f4512.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由倉奈於","creatorId":"vndb:s923","sourcePersonId":"vndb:s923","canonicalEntityId":"vndb:s923","name":"由倉 奈於","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19444:59236:6083:1","source":"bangumi"}]},{"characterId":"char_c59135","characterName":"天童 一馬","sourceIds":{"bangumi":[{"characterId":"59237","match":"exact-normalized-name-in-linked-work","subjectId":"19444"}],"egsCharacterIds":["15351"],"vndbCharacterId":"c59135"},"originalCharacterName":"天童 一馬","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist, who already treats his misfortunes as a part of his daily life, it has been 38 times that he had been kidnapped, so his younger sister Ichika and maid Kiko are forbade him from leaving the house. Somehow, he met Shiro who is a zashikiwarashi."}],"source":"vndb","sourceCharacterId":"c59135"},{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"その生まれで全ての運を使い果たしたのか、交通事故にあったり誘拐されたりと何かとトラブルの絶えない不幸体質。"},{"spoiler":false,"text":"その所為で一花に外出を禁止されてしまっており、基本的に普段は家事手伝いをしている。"},{"spoiler":false,"text":"しかし、自分の不幸体質が原因で、一花や葉子に迷惑がかかっていることに負い目を感じており、体質改善の方法に頭を悩ませている。"}],"source":"egs","sourceCharacterId":"15351","sourceWorkId":"14736","spoiler":false},{"segments":[{"spoiler":false,"text":"本作的主人公。"},{"spoiler":false,"text":"不知是不是出生时用尽了运气，有着不断遇上交通意外和绑架等麻烦不绝的不幸体质。"},{"spoiler":false,"text":"因此他被一花禁止了外出，平时基本都在家里帮手做家务。"},{"spoiler":false,"text":"但是他对因自己的不幸体质给一花和葉子带来麻烦感到内疚，正烦恼着改善体质的方法。"},{"spoiler":false,"text":"「唉～，这已经是第38次（绑架）了——真没用啊我」"}],"source":"bangumi","sourceCharacterId":"59237"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/5832fe9f33386133047a047d98c62819157dfccfc536ab82dc51fc8c37405f7b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/0975dd1f0832f280352142a68791498340f5c5f2e0a6e857e16e215df2cab607.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥川久美子","creatorId":"vndb:s861","sourcePersonId":"vndb:s861","canonicalEntityId":"vndb:s861","name":"奥川 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19444:59237:22331:1","source":"bangumi"}]},{"characterId":"char_c59136","characterName":"烏丸 剣豪","sourceIds":{"bangumi":[{"characterId":"59238","match":"exact-normalized-name-in-linked-work","subjectId":"19444"}],"egsCharacterIds":["15356"],"vndbCharacterId":"c59136"},"originalCharacterName":"烏丸 剣豪","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"天道家専属ドライバー。"},{"spoiler":false,"text":"家庭持ちの超絶子煩悩。"},{"spoiler":false,"text":"隙あらば一人娘の自慢話をはじめるため話が長い。"},{"spoiler":false,"text":"しかし運転技術は天才的な腕前を誇る。"},{"spoiler":false,"text":"その能力を駆使して、仕事がどんなに夜遅くなろうとも家に娘の寝顔を見に帰る良きパパさん。"}],"source":"egs","sourceCharacterId":"15356","sourceWorkId":"14736","spoiler":false},{"segments":[{"spoiler":false,"text":"天童家的专属司机。有家庭，痛爱女儿的人。"},{"spoiler":false,"text":"一有机会就长篇大论地夸赞自己的独生女。"},{"spoiler":false,"text":"不过他有着天才般自豪的驾驶技术。"},{"spoiler":false,"text":"他使用他的能力，工作不管多晚了也会抽空回家看看女儿的睡脸的好爸爸。"},{"spoiler":false,"text":"「给我滚开！ 别拦着我!!　 爱她、小爱她正等着我啊!!!」"}],"source":"bangumi","sourceCharacterId":"59238"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e2d9a3605192650d61bb26a13ebf2b3c49783a1023162c912aadfab31f040c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40acbe9cd6e5cafdcd85a84fff4a7ca6c600873e0413c47c6bb4ef47adfb4d8e.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c59137","characterName":"獅童 誠","sourceIds":{"bangumi":[{"characterId":"59239","match":"exact-normalized-name-in-linked-work","subjectId":"19444"}],"egsCharacterIds":["15357"],"vndbCharacterId":"c59137"},"originalCharacterName":"獅童 誠","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"天童の傘下に連なる一族の頭首。"},{"spoiler":false,"text":"あくどい手法を駆使して一代で力をつけてきた人物。"},{"spoiler":false,"text":"天童の頂点にのし上がることを至上命題としており、そのためなら手段を選ばない。"}],"source":"egs","sourceCharacterId":"15357","sourceWorkId":"14736","spoiler":false},{"segments":[{"spoiler":false,"text":"天童旗下相关联的一族的主席。"},{"spoiler":false,"text":"虽然代代都是担任着天童的暗部，但他是使用毒辣手段成功在他这一代得到强大权力的人物。"},{"spoiler":false,"text":"将立于天童顶点作为至上的目标，为此不择手段。"},{"spoiler":false,"text":"「下次请和我说一声。这类事的处理可是我部门最擅长的」"}],"source":"bangumi","sourceCharacterId":"59239"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe5c20d7e60ca7344ce987d71cef7f3f9f9dd854c9e2f6843