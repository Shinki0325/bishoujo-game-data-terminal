assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b5d0f9f34ec92beb3f9506a52debd554555b18fb113084c9d3cce7294adbf0c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:33140:44690:4937:1","source":"bangumi"}]},{"characterId":"char_c22342","characterName":"ダークス","sourceIds":{"bangumi":[{"characterId":"12378","match":"exact-normalized-name-in-linked-work","subjectId":"67221"}],"egsCharacterIds":["672"],"vndbCharacterId":"c22342"},"originalCharacterName":"ダークス","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔王の森と呼ばれる迷宮群で構成されるフォーゼロッテ宮の魔王。"},{"spoiler":false,"text":"元は冒険者であったが、魔王であるフォーゼロッテと結婚し、魔王に就任した。"},{"spoiler":false,"text":"その後、天界の侵攻を退け、名実ともに魔王となったはずだったが、マクドゥによってそれを否定され、街を作ることになった。"},{"spoiler":false,"text":"最近では魔力の操作を自在に行えるようになり、触手の塊であるが自身の分身体を作ることに成功した。"},{"spoiler":false,"text":"成功してしまった。"}],"source":"egs","sourceCharacterId":"672","sourceWorkId":"18450","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公"},{"spoiler":false,"text":"冒险者。 尽管抵达魔王面前，却遭到反击。"},{"spoiler":false,"text":"陷入濒死之境被魔王所救，其后作为魔王的手下（魔王军的一员）开始活动。"},{"spoiler":false,"text":"作为冒险者很有能力，但因为被魔王所救时手续出错（失败），在很多方面变得不够成熟了。"},{"spoiler":false,"text":"从冒险者时代开始就好女色，加入魔王军之后更是变本加厉。"}],"source":"bangumi","sourceCharacterId":"12378"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/034b5cfd05f32c23ae1ec2b55f6be545efb1f3e5b07a881bff97e9128d05ddf1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc560dd3abe5dce7c7b38db474c65eafb34dd9911491fe3acebd82150091816c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"関通利","creatorId":"vndb:s3695","sourcePersonId":"vndb:s3695","canonicalEntityId":"vndb:s3695","name":"きせとしみち","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:33140:12378:5038:1","source":"bangumi"}]},{"characterId":"char_c24669","characterName":"マリーアリス","sourceIds":{"bangumi":[{"characterId":"44692","match":"exact-normalized-name-in-linked-work","subjectId":"67221"}],"egsCharacterIds":["676"],"vndbCharacterId":"c24669"},"originalCharacterName":"マリーアリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"天界兵だったが、ダークスによって寝返り。"},{"spoiler":false,"text":"現在は魔王ダークスの親衛隊隊長を勤めている。"},{"spoiler":false,"text":"殴る前に考えるより、殴ってから考えるようになりつつある。"}],"source":"egs","sourceCharacterId":"676","sourceWorkId":"18450","spoiler":false},{"segments":[{"spoiler":false,"text":"“天蓋の城” より攻め込んできた天界の軍勢の1/4を率いる大隊長。"},{"spoiler":false,"text":"天蓋の城は天界が地上 （人間界） に作った要塞施設。"},{"spoiler":false,"text":"突如 魔王の森に侵攻を行い大打撃を与えることに成功するも、マリーアリスは逃走に失敗。捕らえられてしまう。"},{"spoiler":false,"text":"以後、ダークスによって凌辱される日々を過ごす。"}],"source":"bangumi","sourceCharacterId":"44692"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3b58e48f9142ddb29991d18261f4c1a3b753ccae5480085aa7e57f64ca46c05.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27febca079df8c4e6e404a82f8103cf97f3cc402a039c362c25c50b08d912c85.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":