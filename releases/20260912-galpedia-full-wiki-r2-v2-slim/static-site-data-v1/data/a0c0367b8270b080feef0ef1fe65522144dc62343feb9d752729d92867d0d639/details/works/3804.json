me":"川田まみ","detail":"主題歌「eclipse」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:83787","source":"egs"},{"creditedName":"KOTOKO","creatorId":"vndb:s410","sourcePersonId":"vndb:s410","canonicalEntityId":"vndb:s410","name":"KOTOKO","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:47403","source":"vndb"},{"creditedName":"川田 まみ","creatorId":"vndb:s555","sourcePersonId":"vndb:s555","canonicalEntityId":"vndb:s555","name":"川田 まみ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:47404","source":"vndb"},{"creditedName":"カワギシ ケイタロウ","creatorId":"vndb:s1069","sourcePersonId":"vndb:s1069","canonicalEntityId":"vndb:s1069","name":"wagi","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:47406","source":"vndb"},{"creditedName":"神月 社","creatorId":"vndb:s4003","sourcePersonId":"vndb:s4003","canonicalEntityId":"vndb:s4003","name":"神月 社","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:47408","source":"vndb"}]},"cast":[{"characterId":"char_c64105","characterName":"緋月 鮎美","sourceIds":{"bangumi":[{"characterId":"58089","match":"exact-normalized-name-in-linked-work","subjectId":"23048"}],"egsCharacterIds":["23389"],"vndbCharacterId":"c64105"},"originalCharacterName":"緋月 鮎美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She's Akizuki Academy's third year and is in the same class as Naoto who has transferred into the same school. Although she isn't the type to show leadership in her class, her calm and homely demeanor makes her very popular."},{"spoiler":false,"text":"Ayumi is good at studies and she received an A recommendation for choosing university."},{"spoiler":false,"text":"Because of Yuiko marrying, she has undertaken all domestic chores in the house by herself. Therefore, she doesn't have time to play and wasn't able to get a boyfriend despite her popularity. Ayumi herself isn't really eager to find a boyfriend, though."}],"source":"vndb","sourceCharacterId":"c64105"},{"segments":[{"spoiler":false,"text":"転校した直人と同じクラスの三年生。"},{"spoiler":false,"text":"成績優秀、穏やかで家庭的な雰囲気を持つ彼女は、周囲からの人気も高い。"},{"spoiler":false,"text":"長女・結衣子の結婚で、家事を一手に引き受けたため、遊ぶ時間が少なく、モテるのに彼氏はいない。"},{"spoiler":false,"text":"鮎美も彼氏が欲しいとは思っていない様子。"}],"source":"egs","sourceCharacterId":"23389","sourceWorkId":"8725","spoiler":false},{"segments":[{"spoiler":false,"text":"【三女】"},{"spoiler":false,"text":"秋月学園に通う3年生で転校してきた直人と同じクラスになる。"},{"spoiler":false,"text":"クラスではリーダーシップを発揮するタイプではないが、穏やかであり、家庭的な雰囲気を持つ鮎美は人気が高い。"},{"spoiler":false,"text":"勉強もでき、模試の結果はいつも志望校A判定をもらっている。"},{"spoiler":false,"text":"結衣子の結婚にともない、一家の家事を一手に引き受けている。"},{"spoiler":false,"text":"ゆえに遊ぶ時間がないため、人気はあるのに彼氏なしの状態が続いている。"},{"spoiler":false,"text":"鮎美も積極的に彼氏がほしいとは思っていない。"}],"source":"bangumi","sourceCharacterId":"58089"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a32bf29a409f65350f97593d5ea94f14fdce47b52436ea5bf32f418b8b9f94d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fbc677cf5a7d68a788c44995e5f7413d9db9189672399b55bbb5e5c92658f90f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:23046:58089:4675:1","source":"bangumi"}]},{"characterId":"char_c64107","characterName":"緋月 美津菜","sourceIds":{"bangumi":[{"characterId":"58090","match":"exact-normalized-name-in-linked-work","subjectId":"23048"}],"egsCharacterIds":["23390"],"vndbCharacterId":"c64107"},"originalCharacterName":"緋月 美津菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Akizuki Academy's first year and Ayumi's little sister. She doesn't talk much and her facial expressions don't express her emotions much. Raised as the youngest sister surrounded by other women, she hasn't any resistance towards men and is lacking knowledge about them."},{"spoiler":false,"text":"Still, Mitsuna herself doesn't mind that at all."},{"spoiler":false,"text":"Sometimes she ends up blurting out random things she learned from books."}],"source":"vndb","sourceCharacterId":"c64107"},{"segments":[{"spoiler":false,"text":"直人が通う学園の一年生。"},{"spoiler":false,"text":"口数が少なく、表情も乏しい。"},{"spoiler":false,"text":"女ばかりの環境で育ったためか、男に対しての免疫が無く、知識も少ない。"},{"spoiler":false,"text":"が、本人は全く気にしていないようだ。"}],"source":"egs","sourceCharacterId":"23390","sourceWorkId":"8725","spoiler":false},{"segments":[{"spoiler":false,"text":"【四女】"},{"spoiler":false,"text":"秋月学園に通う1年生で、鮎美の妹。"},{"spoiler":false,"text":"口数が少なく、表情にも感情が出にくい。"},{"spoiler":false,"text":"末っ子で、女ばかりの環境で育ったためか、男に対しての免疫が無く、知識も乏しい。"},{"spoiler":false,"text":"だが、本人は全く気にしていない。辞書で得た知識をときどき口走る。"}],"source":"bangumi","sourceCharacterId":"58090"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69f0daee22acfe8fce2958d8b700c617be830927c33f7c52546a5691a992a7b5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4cb31079f8c974212039f49b42c3798a2f565a618717f2cf9c6c1039c528806a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩居由希子","creatorId":"vndb:s1160","sourcePersonId":"vndb:s1160","canonicalEntityId":"vndb:s1160","name":"岩居 由希子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:23046:58090:4163:1","source":"bangumi"}]},{"characterId":"char_c64109","characterName":"緋月 詩乃","sourceIds":{"bangumi":[{"characterId":"58091","match":"exact-normalized-name-in-linked-work","subjectId":"23048"}],"egsCharacterIds":["23391"],"vndbCharacterId":"c64109"},"originalCharacterName":"緋月 詩乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A teacher at Akizuki Academy and the older sister of Ayumi and Mitsuna."},{"spoiler":false,"text":"She is an average teacher and doesn't feel any special passion towards teaching. Still, as a young female teacher she is popular among students."},{"spoiler":false,"text":"During her schooldays she learned Aikido (has black belt), so she's got self-defense covered."},{"spoiler":false,"text":"She's extremely direct and harsh with her words. Loves alcohol and drinks a lot, sometimes drinking so much she loses her memory."},{"spoiler":false,"text":"In the past she has experienced a huge failure, since then, she has put any relations with men on hold."}],"source":"vndb","sourceCharacterId":"c64109"},{"segments":[{"spoiler":false,"text":"学園の女教師で、鮎美、美津菜の姉。"},{"spoiler":false,"text":"教師として、特に気合いを入れて指導してはいないが、その容姿と若さから、教え子たちからの人気は上々。"},{"spoiler":false,"text":"学生時代、合気道をしていた体育会系で、きつくダイレクトな言葉がタマにキズ。"},{"spoiler":false,"text":"過去に大失恋をしており、それ以来、男関係はないようだが……。"}],"source":"egs","sourceCharacterId":"23391","sourceWorkId":"8725","spoiler":false},{"segments":[{"spoiler":false,"text":"【次女】"},{"spoiler":false,"text":"秋月学園に勤める女教師で、鮎美と美津菜の姉。"},{"spoiler":false,"text":"教師としては凡庸であり、特に熱血教師をやっている感じではない。"},{"spoiler":false,"text":"しかし、若い女教師ということもあり、教え子たちからの人気はそこそこある。"},{"spoiler":false,"text":"学生時代合気道をならっていたので（黒帯）、護身術の心得がある。"},{"spoiler":false,"text":"言葉が非常にダイレクトできつい。"},{"spoiler":false,"text":"酒好き。酒豪。記憶をなくすまで飲むこともしばしば。"},{"spoiler":false,"text":"過去に大失恋を経験している。それ以来、男はキャンセル気味。"}],"source":"bangumi","sourceCharacterId":"58091"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63f0091e088117056c0ee142022e8f6fcb30fd1f3662e5a8a93e813a75d1820a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d177f4f126dd9aef0ba210900ad092a908b0a7eb655d7c90d9e903192265820f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石松千恵美","creatorId":"vndb:s1164","sourcePersonId":"vndb:s1164","canonicalEntityId":"vndb:s1164","name":"石松 千恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:23046:58091:4273:1","source":"bangumi"}]},{"characterId":"char_c67834","characterName":"緋月 結衣子","sourceIds":{"bangumi":[{"characterId":"58092","match":"exact-normalized-name-in-linked-work","subjectId":"23048"}],"egsCharacterIds":["23392"],"vndbCharacterId":"c67834"},"originalCharacterName":"緋月 結衣子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ayumi, Mitsuna and Shino's older sister, as well as wife of Masakazu who is her distant relative. She met with Masakazu by chance and the two normally fell in love, then married."},{"spoiler":false,"text":"Currently she is acting as a housewife and is living in Naoto's hometown. Because of various circumstances she has agreed to provide her body and give birth to Naoto's child, but they didn't manage to make one."},{"spoiler":false,"text":"While feeling guilty towards her husband, her romantic feelings are slowly moving onto Naoto."},{"spoiler":false,"text":"She feels motherly instincts towards Naoto."}],"source":"vndb","sourceCharacterId":"c67834"},{"segments":[{"spoiler":false,"text":"緋月四姉妹の長女で、すでに結婚している人妻。"},{"spoiler":false,"text":"今は専業主婦で、もろもろの結果、直人の子を産むため身体を提供するが、妊娠には至らなかった。"},{"spoiler":false,"text":"彼に母性愛的なモノを感じており、夫に罪悪感を感じる一方、少しづつ気持ちが傾き始める。"}],"source":"egs","sourceCharacterId":"23392","sourceWorkId":"8725","spoiler":false},{"segments":[{"spoiler":false,"text":"鮎美たちの姉で、遠縁の正和と結婚した。"},{"spoiler":false,"text":"正和との出会いは偶然で普通に恋愛した後に結婚した。"},{"spoiler":false,"text":"今は専業主婦で直人たちの故郷で暮らしている。"},{"spoiler":false,"text":"諸事情の末、直人の子を産むためその身体を提供することを承諾したが、妊娠にはいたらなかった。"},{"spoiler":false,"text":"夫に対しての罪悪感は常に感じている一方で、少しずつ直人に対しても気持ちが動いてきている。"},{"spoiler":false,"text":"どこか母性愛的なものを直人に対して感じている。"}],"source":"bangumi","sourceCharacterId":"58092"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/594a303a99993918e8a809c24854f2a6164bd192d488263d945478b93f58ab20.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f6bffa52383639cae3f54de0845fadee4cde4d9c1f25702f77697fb26679399.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北条明日香","creatorId":"vndb:s1016","sourcePersonId":"vndb:s1016","canonicalEntityId":"vndb:s1016","name":"北条 明日香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:23046:58092:32486:1","source":"bangumi"}]},{"characterId":"char_vndb_c64106","characterName":"燐堂 直人","sourceIds":{"vndbCharacterId":"c64106"},"originalCharacterName":"燐堂 直人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c64108","characterName":"緋月 正和","sourceIds":{"vndbCharacterId":"c64108"},"originalCharacterName":"緋月 正和","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The son of the main Hizuki family and Suzune's older brother. He is married to Yuiko."},{"spoiler":false,"text":"Masakazu has an extremely strong sense of responsibility and loyalty to Rindou family, and the accident made it even stronger."}],"source":"vndb","sourceCharacterId":"c64108"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d749927ded396353fa00c2251e9947f6d2297fe7750096d7fc10c1ff56ab9c1f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14326d13e40e599947b81e9d52a8e73a3392a5799b98b6632c9f6482031a1157.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c64111","characterName":"燐堂 万蔵","sourceIds":{"vndbCharacterId":"c64111"},"originalCharacterName":"燐堂 万蔵","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Great-great grandfather of Naoto Rindou. 2nd Generation Head of the Clan."}],"source":"vndb","sourceCharacterId":"c64111"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd0efd46c3861ad5f91642d7cdf87efe764fe96d8930dabe996729584edf005c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f8885a6bfe641ef94f6f99212aa6ca4810b00fbdc0021d45a7305f5f80135d8.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c67825","characterName":"明石 奈津子","sourceIds":{"vndbCharacterId"