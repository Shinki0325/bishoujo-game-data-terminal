"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"モトリー診療所のナースにして、喫茶店「モトリー」でウェイトレスもしている女の子。"},{"spoiler":false,"text":"義理人情に厚く、弱い者を見逃せない熱血タイプ。"},{"spoiler":false,"text":"看護界のゴールデンルーキーと呼ばれる彼女は、その名に恥じない決断力と統率力を兼ねそろえたリーダーだが、時々、何かが抜けてしまうことも……。"},{"spoiler":false,"text":"「動脈注射と採血の達人！　ナースレッド！」"}],"source":"egs","sourceCharacterId":"19171","sourceWorkId":"9975","spoiler":false},{"segments":[{"spoiler":false,"text":"普段は喫茶店「モトリー」のウェイトレス＆モトリー診療所のナース。"},{"spoiler":false,"text":"義理人情に人一倍あつく、熱血溢れる女の子。"},{"spoiler":false,"text":"看護界のゴールデンルーキーで、優れた判断力と統率力を持ったリーダーだが、時々抜けているところが…。"}],"source":"bangumi","sourceCharacterId":"93306"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96a17b264e64e4e356d71a1f9ecff6076b43a366f31edaebc390829a6d9c696b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c252eef1bfe62212f14ea6e02ec8468f900dee5b979168a1fecc72055e9024d8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"カンザキカナリ","creatorId":"vndb:s1000","sourcePersonId":"vndb:s1000","canonicalEntityId":"vndb:s1000","name":"カンザキ カナリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219227:93306:24747:1","source":"bangumi"}]},{"characterId":"char_c39617","characterName":"ブラックナース香織","sourceIds":{"bangumi":[{"characterId":"93313","match":"exact-normalized-name-in-linked-work","subjectId":"219227"}],"egsCharacterIds":["19177"],"vndbCharacterId":"c39617"},"originalCharacterName":"ブラックナース香織","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"見た目は、落ち着きはらっているお姉さんタイプ。"},{"spoiler":false,"text":"その実態は、単にボーっとしているだけのお姉さん。"},{"spoiler":false,"text":"しかし、一度“スイッチ”が入ると、キレのある踊りをしながら意見を言い、言い終わるとビシッと決めポーズを取る。"},{"spoiler":false,"text":"それが無ければ、かなり優秀なナース兼秘書なのだが……。"},{"spoiler":false,"text":"「小さなことからコツコツと……。それが悪の神髄です」"}],"source":"egs","sourceCharacterId":"19177","sourceWorkId":"9975","spoiler":false},{"segments":[{"spoiler":false,"text":"沈着冷静。時々ボーっとしている。"},{"spoiler":false,"text":"時折ボソリときつい毒舌をつぶやき、主人公のKKKを 引かせてしまう事がある。"}],"source":"bangumi","sourceCharacterId":"93313"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11e88680c874cc3f45a06a57e759337b043d466dcda5d3fefb526878ae82c7b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74019762db872ecc111d5bf1dab3cb7af30db6b1f4fbef7df30b04f78cb89477.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219227:93313:5900:1","source":"bangumi"}]},{"characterId":"char_c39620","characterName":"青島 明日香","sourceIds":{"bangumi":[{"characterId":"93308","match":"exact-normalized-name-in-linked-work","subjectId":"219227"}],"egsCharacterIds":["19173"],"vndbCharacterId":"c39620"},"originalCharacterName":"青島 明日香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"言葉使いがちょっぴり（？）キツイ、クールビューティ。"},{"spoiler":false,"text":"看護学校時代は優秀な成績を残していたが、卒業後、何故かフリーターとして生活している。"},{"spoiler":false,"text":"看護師としては、自分より夏美の方が優秀だと思っており、彼女にライバル心を抱いている様子。"},{"spoiler":false,"text":"「連日夜勤でも問題無しよ！　ナースブルー！」"}],"source":"egs","sourceCharacterId":"19173","sourceWorkId":"9975","spoiler":false},{"segments":[{"spoiler":false,"text":"クールなキャラ。言葉遣いに多少キツイ面がある。"},{"spoiler":false,"text":"看護学校に通っていた頃は優秀であったが、どういう訳か卒業後、 一時期フリーターとして生活している。"},{"spoiler":false,"text":"看護師としては夏美より自分の方が上と思っており、 夏美に対してライバル心を抱いている。"}],"source":"bangumi","sourceCharacterId":"93308"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12de2882bdf2a1415fd037f64c020a789ccd1557fdc87576a958a9d44181099b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e9fe055a3d0fb54d82b55d4770d382f86138f346d1e37b90e89e211a5010083.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219227:93308:6016:1","source":"bangumi"}]},{"characterId":"char_c39621","characterName":"黄山 麻美","sourceIds":{"bangumi":[{"characterId":"93309","match":"exact-normalized-name-in-linked-work","subjectId":"219227"}],"egsCharacterIds":["19174"],"vndbCharacterId":"c39621"},"originalCharacterName":"黄山 麻美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"新しい武器を作り出す秀才で、メカフェチな女の子。"},{"spoiler":false,"text":"メカを作り出す腕前は本物で、更に身体を動かすことが苦手なことから、「ナースではなくメカ関係の仕事をした方がいいんじゃないか」"},{"spoiler":false,"text":"と、思われることもしばしば。"},{"spoiler":false,"text":"得意技は、最新のPCで敵の弱点を見破ること。"},{"spoiler":false,"text":"「点滴の天才！　ナースイエロー」"}],"source":"egs","sourceCharacterId":"19174","sourceWorkId":"9975","spoiler":false},{"segments":[{"spoiler":false,"text":"大のメカ好きで新しい武器を作る秀才な女の子。"},{"spoiler":false,"text":"ナースではなくメカ関係の仕事を目指した方が 良いのではないかと思うほど…。"},{"spoiler":false,"text":"（身体を動かす事は苦手なのでナースとしてはあまり役に立っていない）"},{"spoiler":false,"text":"最新のPC機器を使いこなし、敵の弱点を見破る能力を持っている。"}],"source":"bangumi","sourceCharacterId":"93309"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c378dba3f3b8f84d1e6c495c77fad57817cdea2d6efb33c58753f4fc6b28fc67.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1bdf60fee3947b25ac621a29adca9a8944716b8754b830ce4b6e5d25aa30f0c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"蓮香","creatorId":"vndb:s1682","sourcePersonId":"vndb:s1682","canonicalEntityId":"vndb:s1682","name":"蓮香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219227:93309:21086:1","source":"bangumi"}]},{"characterId":"char_c39622","characterName":"緑川 恵利","sourceIds":{"bangumi":[{"characterId":"93307","match":"exact-normalized-name-in-linked-work","subjectId":"219227"}],"egsCharacterIds":["19172"],"vndbCharacterId":"c39622"},"originalCharacterName":"緑川 恵利","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ナースレンジャー最年少のマスコットキャラ的存在で、メンバー内のムードメーカー。"},{"spoiler":false,"text":"明るくまじめな性格だが、血気盛んな面も併せ持ち、興奮すると大阪弁が顔を覗かせる。"},{"spoiler":false,"text":"好きな男性に対しては、積極的に行動するのだが……。"},{"spoiler":false,"text":"「オペ助手としての腕は天下一品！　ナースグリーン！」"}],"source":"egs","sourceCharacterId":"19172","sourceWorkId":"9975","spoiler":false},{"segments":[{"spoiler":false,"text":"ナースレンジャー内でのムードメーカー。"},{"spoiler":false,"text":"メンバー中最年少でマスコットキャラ的な存在。"},{"spoiler":false,"text":"普段は明るくまじめだが、血気盛んな面も持っている。"},{"spoiler":false,"text":"興奮すると時折大阪弁が出るが、本人は極力出さない ように気をつけている。"},{"spoiler":false,"text":"好きな男性に対しては、結構積極的に行動する。"}],"source":"bangumi","sourceCharacterId":"93307"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61bd33ea954c176da369dd77b07b60612a704f3457da116789711f3e727f145c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8eac099ac220356149746dc6b8b483508a8e36086c0859f31a7419f2585e3fcc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤宮菜穂","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:219227:93307:6019:1","source":"bangumi"}]},{"characterId":"char_c39623","characterName":"桃原 沙由美","sourceIds":{"bangumi":[{"characterId":"93310","match":"exact-normalized-name-in-linked-work","subjectId":"219227"}],"egsCharacterIds":["19175"],"vndbCharacterId":"c39623"},"originalCharacterName":"桃原 沙由美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"見かけ倒でちょっぴりお荷物のぶりっ娘ナース。"},{"spoiler":false,"text":"その圧倒的なぶりっ娘ぶりに、周りの人たちはほとほとまいっている。"},{"spoiler":false,"text":"（ただし、本人は可愛いと思っている様子）"},{"spoiler":false,"text":"爆発物処理が得意。"},{"spoiler":false,"text":"気が合うのか、グリーン・恵利といつも一緒にいる。"},{"spoiler":false,"text":"「医療○○ならお手のもの！　ナースピンク！」"}],"source":"egs","sourceCharacterId":"19175","sourceWorkId":"9975","spoiler":false},{"segments":[{"spoiler":false,"text":"本人は可愛いと思っているが、 周りの人たちは、ぶりっ子ぶりにほとほとまいっている。"},{"spoiler":false,"text":"恵利と一緒にいることが多い。"},{"spoiler":false,"text":"爆発物処理を得意とする。"}],"source":"bangumi","sourceCharacterId":"93310"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4a0a5f54008aa1e5a51a2757559f8f5662aa690b870dcf9715f96cdd