{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"21774","model":{"presentationWorkId":"vndb:v17090","staff":{"artwork":[{"creditedName":"鳴滝しん","creatorId":"vndb:s1981","sourcePersonId":"egs:creator:1940","canonicalEntityId":"vndb:s1981","name":"鳴滝しん","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:147830","source":"egs"},{"creditedName":"てすら","creatorId":"vndb:s6143","sourcePersonId":"egs:creator:18779","canonicalEntityId":"vndb:s6143","name":"てすら","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:148440","source":"egs"}],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c22815","characterName":"鹿子嶋 ケンコ","sourceIds":{"bangumi":[{"characterId":"200746","match":"exact-normalized-name-in-linked-work","subjectId":"110511"}],"egsCharacterIds":["6123"],"vndbCharacterId":"c22815"},"originalCharacterName":"鹿子嶋 ケンコ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメートにして、クラス委員長。男子に厳しく美人に甘く、自分に厳しくダメなヤツにちょっと甘い、姉御肌というより兄貴分のような頼りがいのある女の子。"},{"spoiler":false,"text":"性格はクールだが、ハートはホット。"},{"spoiler":false,"text":"格好を付けてるつもりなのか、時折、ケンコ・フォルゴーレ・チェンタウロというあからさまな偽名を使い、ハーフを自称するが、どうみても100パーセント日本人の顔立ちをしているので、今まで誰も信じたことはない。"}],"source":"egs","sourceCharacterId":"6123","sourceWorkId":"20522","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスメイトにして、クラス委員長。"},{"spoiler":false,"text":"男子に厳しく美人に甘く、自分に厳しくダメなヤツにちょっと甘い、姉御肌というより兄貴分のような頼りがいのある女の子。"},{"spoiler":false,"text":"性格はクールだが、ハートはホット。"},{"spoiler":false,"text":"格好を付けているつもりなのか、時折 ケンコ・フォルゴーレ・チェンタウロ というあからさまな偽名を使いハーフを自称する。"},{"spoiler":false,"text":"しかしどう見ても100％日本人の顔立ちをしているので、今まで誰も信じたことはない。"}],"source":"bangumi","sourceCharacterId":"200746"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"200746","value":"2年生"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4db067fef40e1693280b54575acb23025a80fa3eaa258228ff5d4e34e67009d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/448831caf9f34c0f742076ba6ce8ccf5b6d4edabb6f26ac40ec9fb93c1f9d225.webp","width":113,"height":256,"source":"static-detail"},"actors":[{"creditedName":"千愛","creatorId":"vndb:s6169","sourcePersonId":"vndb:s6169","canonicalEntityId":"vndb:s6169","name":"千愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:63705","source":"vndb"}]},{"characterId":"char_c22935","characterName":"ケンコ・ケンコ","sourceIds":{"bangumi":[{"characterId":"142513","match":"exact-normalized-name-in-linked-work","subjectId":"90766"}],"egsCharacterIds":["2483"],"vndbCharacterId":"c22935"},"originalCharacterName":"ケンコ・ケンコ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の館に住み込みで働いているメイド。"},{"spoiler":false,"text":"日本有数の研究者であり孤高の発明家であった祖父の唯一の助手であり弟子。"},{"spoiler":false,"text":"幼いときから主人公に仕えてくれている同級生。"},{"spoiler":false,"text":"メイドとしては優秀で、まるで3人いるかのように3倍働ける。"},{"spoiler":false,"text":"クローン培養・製造装置の管理者であり、理論と設計を完成させた後、亡くなった主人公の祖父の代わりに装置を完成させた。"},{"spoiler":false,"text":"常に冷静沈着で、多少の物事には動じない性格だが、反面、脳内はピンク色の変態であり、ヒマさえあればエロ妄想に耽っている。"},{"spoiler":false,"text":"主人公に対しては意外と厳しく、ご主人様命令なのに一度もやらせてくれない。"},{"spoiler":false,"text":"華奢な体つきのわりに力が強く、振るう主武器は長槍鎌“崩壊する輝月の漆黒”（テンペスト・トゥ・テスタメント・オブ・ザ・ブラックムーン）であり、主人公の住む館の防備も一人で担っている。"}],"source":"egs","sourceCharacterId":"2483","sourceWorkId":"19624","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の館に住み込みで働いているメイド。"},{"spoiler":false,"text":"日本有数の研究者であり孤高の発明家であった祖父の、唯一の助手であり弟子。"},{"spoiler":false,"text":"幼い頃から主人公に仕えてくれている同級生。"},{"spoiler":false,"text":"メイドとしては優秀で、まるで3人いるかのように3倍働ける。"},{"spoiler":false,"text":"クローン培養・製造装置の管理者であり、亡くなった祖父の代わりに装置を完成させた。"},{"spoiler":false,"text":"常に冷静沈着で多少の物事には動じない性格だが、反面、脳内はピンク色の変態であり、ヒマさえあればエロ妄想に耽っている。"},{"spoiler":false,"text":"主人公に対しては意外と厳しく、ご主人様命令なのに一度もヤらせてくれない。"},{"spoiler":false,"text":"華奢な身体つきのわりに力が強く、主人公の住む館の防備も一人で担っている。"},{"spoiler":false,"text":"「おや、DT様。もとい、ご主人様。 どうなさいました？」"}],"source":"bangumi","sourceCharacterId":"142513"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ecb91c3d51410c26080e82341bb23c41178cee9cf9658ad9c3f5f1ea59f1d30a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9e7d42e1859c1ed500f739ac257255ce5c032cdfb191b04b4aa8820696f9812.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"千愛","creatorId":"vndb:s6169","sourcePersonId":"vndb:s6169","canonicalEntityId":"vndb:s6169","name":"千愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:63706","source":"vndb"}]},{"characterId":"char_c23722","characterName":"ケンコ・アイチ","sourceIds":{"bangumi":[{"characterId":"142173","match":"exact-normalized-name-in-linked-work","subjectId":"271213"}],"egsCharacterIds":["3616"],"vndbCharacterId":"c23722"},"originalCharacterName":"ケンコ・アイチ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の働く調教館に住み込みで働いているメイド。"},{"spoiler":false,"text":"メイドといっても、館の主人から全権を預けられており、他の使用人とは格が異なる。"},{"spoiler":false,"text":"種族的には人間のはずだが、顔がややのっぺりとしており、平たい顔をしていることから、出身は東南の果ての島国ではないかと噂されている。何故かエルフ耳を付けている。"},{"spoiler":false,"text":"性格は冷静沈着で非常に規律正しく、物事をハッキリさせたがる。"},{"spoiler":false,"text":"だが、仕事時間外や仕事の管轄外の事柄については、もの凄く怠惰である。"},{"spoiler":false,"text":"主人公たちの調教のサポートも行い、進み具合の管理や売却先の選定から交渉までを取り仕切っているため、彼女の影響力は強く広い。"},{"spoiler":false,"text":"故に敵に回すと、この界隈で生きていけなくなる人間の一人である。"},{"spoiler":false,"text":"調教中のエルフ奴隷を取り返そうと、やってくる連中からの防備も彼女の大事な仕事である。"},{"spoiler":false,"text":"「おやごきげんよう。本日も大変結構な調教日和ですね。――夜ですが」"}],"source":"egs","sourceCharacterId":"3616","sourceWorkId":"20136","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の働く○○館に住み込みで働いているメイド。"},{"spoiler":false,"text":"メイドといっても、館の主人から全権を預けられており、他の使用人とは格が異なる。"},{"spoiler":false,"text":"種族的には人間のはずだが、顔がややのっぺりとしており、平たい顔をしていることから、出身は東南の果ての島国ではないかと噂されている。"},{"spoiler":false,"text":"何故かエルフ耳を付けている。"},{"spoiler":false,"text":"性格は冷静沈着で非常に規律正しく、物事をハッキリさせたがる。"},{"spoiler":false,"text":"だが、仕事時間外や仕事の管轄外の事柄については、もの凄く怠惰である。"},{"spoiler":false,"text":"主人公たちの○○のサポートも行い、進み具合の管理や売却先の選定から交渉までを取り仕切っているため、彼女の影響力は強く広い。"},{"spoiler":false,"text":"ゆえに敵に回すと、この界隈で生きていけなくなる人間の一人である。"},{"spoiler":false,"text":"○○中のエルフ○○を取り返そうとやってくる連中からの防備も、彼女の大事な仕事である。"}],"source":"bangumi","sourceCharacterId":"142173"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a0f36fe91d0a4610a67f54e48794cb2be2d4d83ea85d2ae739d44fbdc118a40.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/844b12e0d61950f442fab486abe6d414397f69d345269acda370e8239afed40d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"千愛","creatorId":"vndb:s6169","sourcePersonId":"vndb:s6169","canonicalEntityId":"vndb:s6169","name":"千愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:63707","source":"vndb"}]},{"characterId":"char_c46537","characterName":"ケンコ・K6・鸛","sourceIds":{"bangumi":[{"characterId":"46710","match":"exact-normalized-name-in-linked-work","subjectId":"79208"}],"egsCharacterIds":["4736"],"vndbCharacterId":"c46537"},"originalCharacterName":"ケンコ・K6・鸛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と一緒に、旅亭・桂城荘へやってきたものの、宿泊費をもたない上司の代わりに働かされている。"},{"spoiler":false,"text":"なぜか主人公に心酔しており、主人公がどちらの選択をしてもついてきてくれる。"},{"spoiler":false,"text":"スペックはもの凄く高く、下手に直感に頼る主人公よりもよほど調査能力は高い。"},{"spoiler":false,"text":"名前は偽名のようだが全て本名。Ｋ６は、ミドルネームと母方と父方の姓名。"},{"spoiler":false,"text":"Ｋのうち４つは、命名の際、日本語の名前をつけることに祖父たちが激しく反対したためミドルネームが付いた。"},{"spoiler":false,"text":"さらに誕生時、曾祖父たちの間で発生していた後継者問題の妥協案として、それぞれの姓を個別で継ぐという条件で解決したため、こんなことになった。"},{"spoiler":false,"text":"フルネームは、ケンコ・キルスティ・カッリアラ・コイヴラハティ・カタヤイネン・コウノトリ。"},{"spoiler":false,"text":"旅館の従業員としては優秀だが、愛想が足りないため裏方仕事が多い。それでも十分優秀。"},{"spoiler":false,"text":"「喰らうがいいのです。ケンコ砲…発射!!　　バァァーーン！（実弾）」"}],"source":"egs","sourceCharacterId":"4736","sourceWorkId":"17832","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と一緒に桂城荘へやってきたものの、宿泊費を持たない上司のせいで働かされている。"},{"spoiler":false,"text":"なぜか主人公に心酔しており、主人公がどんな選択をしても付いてきてくれる。"},{"spoiler":false,"text":"スペックはもの凄く高く、下手に直感に頼る主人公よりもよほど調査能力は高い。"},{"spoiler":false,"text":"旅館の従業員としては優秀だが、愛想が足りないため裏方仕事が多い。"},{"spoiler":false,"text":"それでも十分優秀。"},{"spoiler":false,"text":"「大丈夫なのです…。たとえ、あなたがどんな道を選んだとしてもケンコは黙って付いていくのです。それは、あの日に決めた誓いなのです…」"}],"source":"bangumi","sourceCharacterId":"46710"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd291334c79a647342daa3b98825c2be29fa332a0bae779ae91e7a329f1316bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c8daf6794192c7739554279ea21b3e92eb57617d8ea5a7378529f1256722975.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"千愛","creatorId":"vndb:s6169","sourcePersonId":"vndb:s6169","canonicalEntityId":"vndb:s6169","name":"千愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:63709","source":"vndb"}]},{"characterId":"char_vndb_c46535","characterName":"ケンコ・歌川","sourceIds":{"vndbCharacterId":"c46535"},"originalCharacterName":"ケンコ・歌川","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"source-only","source":"vndb","value":"151"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4ead1031c1f7ef9d1848fb665bbe0fb4a6632893f90baa