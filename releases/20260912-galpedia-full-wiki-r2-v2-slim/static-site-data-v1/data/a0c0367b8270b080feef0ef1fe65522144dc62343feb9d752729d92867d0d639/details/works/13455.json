p":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"},"weight":{"reviewState":"source-only","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sora is in the same grade as Kou. She is also Minazuki Makoto's elder sister and dotes on her, having once beaten up someone for making Makoto cry. She often jumps to conclusions without analysing the situation, but is at heart an honest and good-natured girl with compassion for the weak. She does not get along well with Kou initially, though she eventually develops feelings for him."},{"spoiler":true,"text":"During the events of Gray Christmas, Sora headed to the Drexler Organisation's headquarters to perform a favour for Kirishima Rain, but was subsequently caught in and dissolved by the escaping Assembler nanovirus while in a call with Kou."}],"source":"vndb","sourceCharacterId":"c17107"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b9b664e9f1e01357e9db6683a3875afe7c3c3d50e4dbc92da8b1259c83c1dfb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d9587288e0a903b3966fd6788e52f6a987f434e1597603b073b08d54fc0d7e6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さくら はづき","creatorId":"vndb:s270","sourcePersonId":"vndb:s270","canonicalEntityId":"vndb:s270","name":"生天目仁美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22349","source":"vndb"}]},{"characterId":"char_vndb_c20519","characterName":"ノイ","sourceIds":{"vndbCharacterId":"c20519"},"originalCharacterName":"ノイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"529"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"68"},"height":{"reviewState":"source-only","source":"vndb","value":"144"},"hip":{"reviewState":"source-only","source":"vndb","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"50"},"weight":{"reviewState":"source-only","source":"vndb","value":"33"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An unlicensed doctor who has taken up residence in the slums of Suzushiro City. She operates an adult goods shop as her front. While to all outward appearances she seems to be still a child, she is in fact older than Kou. She usually wears a gothic lolita costume, but dons a white robe when engaging in medical activities."},{"spoiler":true,"text":"Her youthful appearance is due in part to her being a Designer's Child."}],"source":"vndb","sourceCharacterId":"c20519"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/557c4f425941d56710ed04c6c96b7838d56afca4f5be1f49b5708f671eb3a839.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f608ce8c62e5b5f15202035ff1864625569ac54b48cb16f76ebcefbbb9827810.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"有栖川 みや美","creatorId":"vndb:s363","sourcePersonId":"vndb:s363","canonicalEntityId":"vndb:s363","name":"高田 初美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22348","source":"vndb"}]},{"characterId":"char_vndb_c4558","characterName":"門倉 甲","sourceIds":{"vndbCharacterId":"c4558"},"originalCharacterName":"門倉 甲","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"307"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"174"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"64"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the story. A free mercenary and an excellent Simulacrum pilot. Kou has been chasing after the the truth behind the incident known as \"Gray Christmas\", in which his town and school was razed, but loses parts of his memory at the beginning of the story."},{"spoiler":false,"text":"He pilots the Simulacrum \"Shadow Wolf\"."}],"source":"vndb","sourceCharacterId":"c4558"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6db7d01d6d6c48c435566a091d8c41fbb86d7e9fa068a1ed9c32106824c0c62.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46b32f3ff6a73663df9628e37331728ee92c565f97939be638007bffb3520aba.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c4559","characterName":"桐島 レイン","sourceIds":{"vndbCharacterId":"c4559"},"originalCharacterName":"桐島 レイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"724"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"height":{"reviewState":"source-only","source":"vndb","value":"171"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"},"weight":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mercenary and Kou's subordinate."},{"spoiler":false,"text":"Referring to Kou as Lieutenant, she serves as a guide to the amnesiac Kou. She acts as both his moral and physical support."},{"spoiler":false,"text":"Even though she is polite and gentle, her gestures and expression often leave an impression of coldness."},{"spoiler":false,"text":"She rarely expresses much emotion, but is merciless towards her enemies."},{"spoiler":false,"text":"Her actions usually put Kou's safety as top priority, so much that she may even give up her own life for Kou."},{"spoiler":false,"text":"She pilots the Simulacrum \"Aigis Guard\"."},{"spoiler":true,"text":"Her father is the head of GOAT's Asian division, Kirishima Isao. During her school days, she piloted the Simulacrum \"Aigis\"."}],"source":"vndb","sourceCharacterId":"c4559"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3c71f7177da3351f901f88585e64f7ed5d94dcf5a92f08259456d050fe9a7770.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b16917c0c8f5f5c0d566ab6b8dfefe635613dc820f04f08be444aa5a42ca69d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井村屋 ほのか","creatorId":"vndb:s867","sourcePersonId":"vndb:s867","canonicalEntityId":"vndb:s867","name":"萩原 えみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22350","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p119","sourceCompanyId":"egs:brand:84","canonicalEntityId":"vndb:p119","name":"戯画","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:13455:84","source":"egs"},{"companyId":"vndb:p119","sourceCompanyId":"vndb:p119","canonicalEntityId":"vndb:p119","name":"戯画","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:10925