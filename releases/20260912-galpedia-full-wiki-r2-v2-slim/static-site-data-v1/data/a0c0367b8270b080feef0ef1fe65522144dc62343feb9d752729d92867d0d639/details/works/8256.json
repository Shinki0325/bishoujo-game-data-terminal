"},{"spoiler":false,"text":"茜島重工のテクノロジーで、人工的に作られたサイガースーツ。"},{"spoiler":false,"text":"「サイガーイン」の掛け声でトレーラーがやってきて、中で装着するのに3分を要する。装着後はすべてにおいてアイサイガーを上回るスペックを持つが、48秒間しか活動できない。"}],"source":"bangumi","sourceCharacterId":"58997"}],"profileFacts":[{"label":"年龄（本版本）","value":"25 岁","valueContext":null,"source":"egs","sourceCharacterId":"13188","sourceWorkId":"8256","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"13188","sourceWorkId":"8256","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"13188","sourceWorkId":"8256","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"13188","sourceWorkId":"8256","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"13188","sourceWorkId":"8256","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"13188","sourceWorkId":"8256","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"49 kg","valueContext":null,"source":"egs","sourceCharacterId":"13188","sourceWorkId":"8256","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32a2b2ef3288a616af237ae3c2062f2547146ba089bb045672c295ecee04070f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/5335f0aca556fc2294d36d7797f78acf29b799fc928b493a89ecdf05a1d02328.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"咲良さく","creatorId":"vndb:s7809","sourcePersonId":"vndb:s7809","canonicalEntityId":"vndb:s7809","name":"咲良 さく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229683:58997:92705:1","source":"ba