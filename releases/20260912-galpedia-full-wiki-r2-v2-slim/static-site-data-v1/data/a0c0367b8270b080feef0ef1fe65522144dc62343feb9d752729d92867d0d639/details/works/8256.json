53","spoiler":false},{"segments":[{"spoiler":false,"text":"警察官の夫を殉職で亡くした、未亡人シスター。"},{"spoiler":false,"text":"天然でぽわぽわした性格は相変わらず。"}],"source":"egs","sourceCharacterId":"13186","sourceWorkId":"8256","spoiler":false},{"segments":[{"spoiler":false,"text":"アイサイガーのムードメーカー、風の戦士“サイガーリリー”。"},{"spoiler":false,"text":"その正体は、修道院で働く見習いシスターをする未亡人。"},{"spoiler":false,"text":"しかし、もしも……梃魔の能力で、"},{"spoiler":false,"text":"夫の殉職が「なかった」ことになるのだとしたら……？"}],"source":"egs","sourceCharacterId":"13186","sourceWorkId":"10079","spoiler":false},{"segments":[{"spoiler":false,"text":"アイサイガーのムードメーカー、風の戦士“サイガーリリー”。"},{"spoiler":false,"text":"その正体は、修道院で働く見習いシスターをする未亡人。"}],"source":"egs","sourceCharacterId":"13186","sourceWorkId":"11476","spoiler":false},{"segments":[{"spoiler":false,"text":"人妻戦隊と言うからには、メンバーは3人いないといけない。というわけで、美紅が深く考えずに作った「正義の味方、ぼしゅー！」ポスターを見てやってきた、のほほんとした外人さん。"},{"spoiler":false,"text":"旦那は警察官だったが、3年前にとある事件で殉職した。"},{"spoiler":false,"text":"結婚前は星林修道院のシスター見習いだった。未亡人となった今ではシスターになることは叶わないが、特別に修道院に住み込みで働いている。"},{"spoiler":false,"text":"変身後は「サイガーアイリス」。"},{"spoiler":false,"text":"邪悪を吹き飛ばす、聖なる風の巨大な力をモチーフにした戦士。サイクロン掃除機を模した、サイ＝クリーナーが専用武器。"}],"source":"bangumi","sourceCharacterId":"58995"}],"profileFacts":[{"label":"年龄（本版本）","value":"30 岁","valueContext":null,"source":"egs","sourceCharacterId":"13186","sourceWorkId":"8256","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"99 cm","valueContext":null,"source":"egs","sourceCharacterId":"13186","sourceWorkId":"8256","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"j","valueContext":null,"source":"egs","sourceCharacterId":"13186","sourceWorkId":"8256","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"13186","sourceWorkId":"8256","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"97 cm","valueContext":null,"source":"egs","sourceCharacterId":"13186","sourceWorkId":"8256","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"63 cm","valueC