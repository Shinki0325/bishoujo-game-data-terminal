e":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「星林女子学園」に通う女子学生でありながら、れっきとした人妻。"},{"spoiler":false,"text":"両親を幼いころに亡くし、育ててくれた祖父が急病で倒れたことから、"},{"spoiler":false,"text":"祖父に花嫁姿を見せたくて、書道教室の兄弟子・礼と結婚。"},{"spoiler":false,"text":"しかし、彼は学園教師であることから、その事実は周囲に秘密の上、"},{"spoiler":false,"text":"旦那とはキスをしたことすらなく、人妻でありながら、処女。"},{"spoiler":false,"text":"ひかり自身は「礼クンラブ」なので、なんとか関係を持とうとするが……。"}],"source":"egs","sourceCharacterId":"13187","sourceWorkId":"8256","spoiler":false},{"segments":[{"spoiler":false,"text":"アイサイガーの若き力、光の戦士“サイガーチェリー”。"},{"spoiler":false,"text":"その正体は、学生でありながら学園教師と結婚している女子校生幼妻。"},{"spoiler":false,"text":"まだまだ成長途中で力は弱いが、持前の明るさと根性、"},{"spoiler":false,"text":"フレッシュな肉体でガンバる。"}],"source":"egs","sourceCharacterId":"13187","sourceWorkId":"10079","spoiler":false},{"segments":[{"spoiler":false,"text":"アイサイガーの若き力、光の戦士“サイガーチェリー”。"},{"spoiler":false,"text":"その正体は、学生でありながら学園教師と結婚している女子校生幼妻。"}],"source":"egs","sourceCharacterId":"13187","sourceWorkId":"11476","spoiler":false},{"segments":[{"spoiler":false,"text":"『聖き光に舞うさくら　サイガーチェリー!!』"},{"spoiler":false,"text":"桜坂 ひかり（おうさか ひかり）星林女子学園に通う、現役女子学生。しかし、れっきとした人妻である。"},{"spoiler":false,"text":"急病で倒れた祖父に花嫁姿を見せるため、兄弟子であり、幼なじみでもある礼と結婚。しかし礼は、星林女子学園の教師でもあるため、その事実は周囲には絶対に秘密。"},{"spoiler":false,"text":"ちなみに礼とはキスもした事がなく、当然のことながら処女である。"},{"spoiler":false,"text":"サイガーチェリー"},{"spoiler":false,"text":"桜をモチーフにしたサイガースーツ。光の属性を持つ。"},{"spoiler":false,"text":"まだ成長途中のアイサイガーで、角などが丸い。衣装もひらひらっぽく、顔を覆うバイザーもない。"},{"spoiler":false,"text":"パワーも美紅たちに較べて全然弱いが、根性でカバー。ネクロビースト化した人間を、元の姿に戻す能力を持っている。……が、なぜそんな力があるのかは本人にもわからない。"}],"source":"bangumi","sourceCharacterId":"58996"}],"profileFacts":[{"label":"年龄（本版本）","value":"18 岁","valueContext":null,"source":"egs","sourceCharacterId":"13187","sourceWorkId":"8256","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterI