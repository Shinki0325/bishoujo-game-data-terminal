3295","sourceWorkId":"34671","spoiler":false},{"segments":[{"spoiler":false,"text":"ウサギの獣人で、気弱で引っ込み思案な女の子。ホーランドロップらしく甘えたがりなところもあり、心を許した相手にはぴとっとくっついてたくさん甘えることも。"},{"spoiler":false,"text":"姉が『もちづき』2号店の店長になるにあたり、大好きな姉の力になりたくて夕渚町についてきた。"}],"source":"bangumi","sourceCharacterId":"91395"}],"profileFacts":[{"label":"胸围（本版本）","value":"73 cm","valueContext":null,"source":"egs","sourceCharacterId":"23295","sourceWorkId":"30553","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"148 cm","valueContext":null,"source":"egs","sourceCharacterId":"23295","sourceWorkId":"30553","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"23295","sourceWorkId":"30553","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"23295","sourceWorkId":"30553","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"42 kg","valueContext":null,"source":"egs","sourceCharacterId":"23295","sourceWorkId":"30553","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2ac2729a1f2e91b3aa9cfa3d00cae5e9f2220bd84a322ebd3821ef9f5c0d175c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03c959e4cf3faf4f20247bf846403c6e3425a3ab43ad969d668a1176969f7d67.webp","width":141,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春咲 さくら","creatorId":"vndb:s33844","sourcePersonId":"vndb:s33844","canonicalEntityId":"vndb:s33844","name":"春咲 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:86694","source":"vndb"}]},{"characterId":"char_c96001","characterName":"百々瀬 みつき","sourceIds":{"bangumi":[{"characterId":"91396","match":"exact-normalized-name-in-linked-work","subjectId":"325937"},{"characterId":"91396","match":"exact-normalized-name-in-linked-work","subj