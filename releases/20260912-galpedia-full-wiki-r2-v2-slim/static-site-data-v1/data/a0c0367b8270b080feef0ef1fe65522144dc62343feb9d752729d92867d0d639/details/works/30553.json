","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:172145","source":"vndb"},{"creditedName":"ダリオスサウム","creatorId":"vndb:s27568","sourcePersonId":"vndb:s27568","canonicalEntityId":"vndb:s27568","name":"鈴木 規夫","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:172146","source":"vndb"},{"creditedName":"緑葉 みんと","creatorId":"vndb:s34093","sourcePersonId":"vndb:s34093","canonicalEntityId":"vndb:s34093","name":"よしだ みんと","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:172147","source":"vndb"}]},"cast":[{"characterId":"char_c85515","characterName":"舞羽 ナナ","sourceIds":{"bangumi":[{"characterId":"71977","match":"exact-normalized-name-in-linked-work","subjectId":"290343"},{"characterId":"71977","match":"exact-normalized-name-in-linked-work","subjectId":"325937"},{"characterId":"71977","match":"exact-normalized-name-in-linked-work","subjectId":"413620"}],"egsCharacterIds":["22072"],"vndbCharacterId":"c85515"},"originalCharacterName":"舞羽 ナナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"807"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"With an unfeminine, casual way of talking, she tends to be frank with people she meets the first time. Although proud to be a beastfolk, she prefers to be thought of as \"cool\" rather than \"cute\". She is into videogames and plays them extensively regardless of genre. For the longest time, guys would always come to hit on Ichika and like a dutiful mama cat, Nana will chase away any that get too close to her."},{"spoiler":false,"text":"Slightly edited from the official website"}],"source":"vndb","sourceCharacterId":"c85515"},{"segments":[{"spoiler":false,"text":"女の子らしくない砕けた口調で、初対面の相手でもフランクに接する。"},{"spoiler":false,"text":"獣人であることに誇りを持っているものの、「かわいい」よりも「かっこいい」と思われたいので、「かわいい」と言われると「かわいくねーし！」と反発するのがお決まり。"},{"spoiler":false,"text":"ゲームが趣味で、ジャンルや媒体を問わず幅広くプレイしている。"},{"spoiler":false,"text":"苺華は昔から異性に言い寄られることが多く、彼女に近づく悪い虫を親猫のように追い払ってきた。"},{"spoiler":false,"text":"アメリカンショートヘアらしく元気で活発、そして強気な少女。"}],"source":"egs","sourceCharacterId":"22072","sourceWorkId":"28581","spoiler":false},{"segments":[{"spoiler":false,"text":"元気で活発な女の子。誰でもフランクに接するので打ち解けやすい。「かわいい」よりも「かっこいい」と思われたい。"}],"source":"egs","sourceCharacterId":"22072","sourceWorkId":"30553","spoiler":false},{"segments":[{"spoiler":false,"text":"アメリカンショートヘアの獣人で、"},{"spoiler":false,"text":"誰とでも打ち解けられるフランクな性格。"},{"spoiler":false,"text":"「かわいい」よりも「かっこいい」と思われたい派。"},{"spoiler":false,"text":"そのため「かわいい」と言われると「かわいくねーし！」と怒る。"},{"spoiler":false,"text":"ゲームが趣味で、主人公や寮の住人と一緒にゲームをすることも。"},{"spoiler":false,"text":"お菓子作りが大の得意で、その腕前はプロ並み。"}],"source":"egs","sourceCharacterId":"22072","sourceWorkId":"34671","spoiler":false},{"segments":[{"spoiler":false,"text":"元気で活発、そして強気な少女"},{"spoiler":false,"text":"女の子らしくない砕けた口調で、初対面の相手でもフランクに接する。獣人であることに誇りを持っているものの、「かわいい」よりも「かっこいい」と思われたいので、「かわいい」と言われると「かわいくねーし！」と反発するのがお決まり。ゲームが趣味で、ジャンルや媒体を問わず幅広くプレイしている。苺華は昔から異性に言い寄られることが多く、彼女に近づく悪い虫を親猫のように追い払ってきた。"}],"source":"bangumi","sourceCharacterId":"71977"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"22072","sourceWorkId":"30553","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":