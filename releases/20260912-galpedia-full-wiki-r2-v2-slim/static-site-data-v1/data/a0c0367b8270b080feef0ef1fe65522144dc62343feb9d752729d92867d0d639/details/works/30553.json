":false,"text":"お酒に弱いのにお酒好きで、酔うととてもテンションが高くなる。"},{"spoiler":false,"text":"主人公よりも年上だが、外見も相まって年上らしさはあまり感じられない。"},{"spoiler":false,"text":"妹のかぐやを溺愛しており、やや過保護なところも。"}],"source":"egs","sourceCharacterId":"23296","sourceWorkId":"34671","spoiler":false},{"segments":[{"spoiler":false,"text":"かぐやの姉で、同じくホーランドロップの獣人。"},{"spoiler":false,"text":"夕渚町に新しく開店した甘味処『もちづき』2号店の店長。手作りのお団子は絶品で、お店のために日々新しいメニューを考えている。"},{"spoiler":false,"text":"明るく人当たりが良くてしっかり者に見えるが、ドジを踏んだり忘れ物をしたりと抜けている一面も。"}],"source":"bangumi","sourceCharacterId":"91396"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"23296","sourceWorkId":"30553","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"149 cm","valueContext":null,"source":"egs","sourceCharacterId":"23296","sourceWorkId":"30553","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"23296","sourceWorkId":"30553","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"23296","sourceWorkId":"30553","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"43 kg","valueContext":null,"source":"egs","sourceCharacterId":"23296","sourceWorkId":"30553","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc93c1685902a28271a3ab2f55d47271154a737c208042c818a4c094e6d105a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f135fb978b1bd05c8f2d5f9589a3402b98b0cb0f7673ef15747f128107a1437.webp","width":141,"height":256,"source":"static-detail"},"actors":[{"creditedName":"都 とわ","creatorId":"vndb:s33845","sourcePersonId":"vndb:s33845","canonicalEntityId":"vndb:s33845","name":"都 とわ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:86695","source":"vndb"}]},{"characterI