mi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"嵐の日に河川敷へ写真を撮りに出掛け、行方不明となる。"},{"spoiler":false,"text":"所持品のみ川から引き上げられたが遺体は未だ見付からない。"},{"spoiler":false,"text":"葬儀の日取りも決まったが、その死には多くの不審が付きまとう。"},{"spoiler":false,"text":"旧姓は津久居、賢太郎とは実の兄弟。幽霊棟で暮していた。"}],"source":"bangumi","sourceCharacterId":"36843"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c12c4684f92eafb9458fc033c3c60a47d91135ca36e183a58e78a02ceb2fcf17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/2254f8f4f25d93ae5ca15a4587d46b3179a6d1062e7f221f1e63d1428c9d4e86.webp","width":132,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:2685","sourceCompanyId":"egs:brand:2685","canonicalEntityId":"egs:brand:2685","name":"TARHS","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:18913:2685","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
