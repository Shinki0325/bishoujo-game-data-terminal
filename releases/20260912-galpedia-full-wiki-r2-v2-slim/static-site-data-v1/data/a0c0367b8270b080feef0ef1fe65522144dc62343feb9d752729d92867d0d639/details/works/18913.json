characterId":"21620","match":"source-roster","subjectId":"66429"},{"characterId":"21620","match":"source-roster","subjectId":"66431"},{"characterId":"21620","match":"source-roster","subjectId":"66433"},{"characterId":"21620","match":"source-roster","subjectId":"73027"}]},"originalCharacterName":"つくい けんたろう","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0129"},"height":{"reviewState":"source-only","source":"bangumi","value":"178"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"66"}},"descriptions":[{"segments":[{"spoiler":false,"text":"26歳"},{"spoiler":false,"text":"週刊北斗の記者。少年犯罪をテーマにコラムを書いている。"},{"spoiler":false,"text":"実弟・御影清史朗が水難事故で亡くなった件を示唆するような手紙を受け取り、弟が生前通っていた学園に訪れた所を拉致・監禁される。言動は乱雑で必要があれば自分より弱者であっても躊躇いなく暴力を働く為、本来被害者である筈だが学生達から顰蹙を買う場面もある。"},{"spoiler":false,"text":"生前の清史朗へ冷たい態度をとっていた事に後ろめたさがある。"}],"source":"bangumi","sourceCharacterId":"21620"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a02646630786a80389fc6456ad6b5c1c2655f66d356164cfc7beda24138d4c8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/513a66ae71d1c1f5a505bb6049f5286a78d7f302a8bdb1aeadd3d3a656281189.webp","width":153,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_21621","characterName":"つじむら れんじ","sourceIds":{"bangumi":[{"characterId":"21621","match":"source-roster","subjectId":"377970"},{"characterId":"21621","match":"source-roster","subjectId":"380652"},{"characterId":"21621","match":"source-roster","subjectId":"66429"},{"characterId":"21621","match":"source-roster","subjectId":"66431"},{"characterId":"21621","match":"source-roster","subjectId":"66433"},{"characterId":"21621","match":"source-roster","subjectId":"73027"}]},"originalCharacterName":"つじむら れんじ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0818"},"height":{"reviewState":"source-only","source":"bangumi","value":"184"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"67"}},"descriptions":[{"segments":[{"spoiler":false,"text":"17歳 ／幽霊棟101号室"},{"spoiler":false,"text":"昨年四季文学賞を受賞しデビューした高校生作家。賢太郎にはデコと呼ばれている。"},{"spoiler":false,"text":"傍若無人な人物で、他人の話にくい事柄を容赦なく聞き出し、答えが返らない場合強烈に責める傾向がある。学生達の間ではリーダー格で監禁に関しては彼を中心として話し合いが行われるが、独断が多く皮肉が多い為反感を買うことも多い。"},{"spoiler":false,"text":"一方で炊事を一人で担うなど面倒見のよい一面もあるが、料理の味は可もなく不可もない。"}],"source":"bangumi","sourceCharacterId":"21621"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df0ffa3784043604600c101f4c62797e9bdbc33b29116951a938796d2e1bb1bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f593e5ea62460ec41a3f7b993845930d924e4cf1756f8afb5a9d8c0dfff73ef4.webp","width":144,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_21622","characterName":"かや あきひろ","sourceIds":{"bangumi":[{"characterId":"21622","match":"source-roster","subjectId":"377970"},{"characterId":"21622","match":"source-roster","subjectId":"380652"},{"characterId":"21622","match":"source-roster","subjectId":"66429"},{"characterId":"21622","match":"source-roster","subjectId":"66431"},{"characterId":"21622","match":"source-roster","subjectId":"66433"},{"characterId":"21622","match":"source-roster","subjectId":"73027"}]},"originalCharacterName":"かや あきひろ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"代議士の息子で学園の生徒会長を勤める優等生。賢太郎にはメガネと呼ばれている。"},{"spoiler":false,"text":"品行方正な生徒会長で有ると同時に、世襲議員の名門家系である家の名前を効果的に使うキレ者でもあるが、恩人として慕っている白峰には子供のような顔を見せる。毎朝のランニングが日課で、純粋に体格と力であれば学生達の中で一番強いが、機械には非常に弱く生活能力には欠ける一面も。"}],"source":"bangumi","sourceCharacterId":"21622"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/015d6ced02752b4aae6b8a28b8120bc0980fd5f5283266d30e99b9ebba5fe593.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e99614b222d158d4838ce3e447585ba87f7c8ffa875b6239c26e1b591bb5b916.webp","width":115,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_21623","characterName":"くぼや みはる","sourceIds":{"bangumi":[{"characterId":"21623","match":"source-roster","subjectId":"377970"},{"characterId":"21623","match":"source-roster","subjectId":"380652"},{"characterId":"21623","match":"source-roster","subjectId":"66429"},{"characterId":"21623","match":"source-roster","subjectId":"66431"},{"characterId":"21623","match":"source-roster","subjectId":"66433"},{"characterId":"21623","match":"source-roster","subjectId":"73027"}]},"originalCharacterName":"くぼや みはる","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園と同じ系列の施設で育った孤児。賢太郎にはオカマと呼ばれている。"},{"spoiler":false,"text":"夏に亡くなった清史朗とは中学時代からの友達。明るく親切で、泣き虫だが気遣い屋。その一方で大人受けは悪く、里親が付かない「返品っ子」だったと自身で話している。また、親や担任教師をノイローゼにするという噂も。"},{"spoiler":false,"text":"教会の神波とは同じ施設で育ち半ば保護者のような存在で懐いていたが、現在は邪険に扱う傾向が強く周囲には反抗期かと言われている。"}],"source":"bangumi","sourceCharacterId":"21623"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b4284cf26f86