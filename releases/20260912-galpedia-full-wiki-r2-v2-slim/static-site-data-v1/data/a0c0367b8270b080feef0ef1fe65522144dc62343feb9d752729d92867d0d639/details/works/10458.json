e","relationId":"vndb:vn-staff:27008","source":"vndb"},{"creditedName":"MYU","creatorId":"vndb:s3842","sourcePersonId":"vndb:s3842","canonicalEntityId":"vndb:s3842","name":"櫻 みゅう","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:27010","source":"vndb"},{"creditedName":"墨","creatorId":"vndb:s8333","sourcePersonId":"vndb:s8333","canonicalEntityId":"vndb:s8333","name":"墨","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:27012","source":"vndb"}]},"cast":[{"characterId":"char_c31486","characterName":"月嶋 乙羽","sourceIds":{"bangumi":[{"characterId":"49207","match":"exact-normalized-name-in-linked-work","subjectId":"154757"}],"egsCharacterIds":["18719"],"vndbCharacterId":"c31486"},"originalCharacterName":"月嶋 乙羽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"100"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"J"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The first and oldest daughter of the Tsukishima family. Like her other sisters Otoha is a teacher and she takes care of the household in general too, just like a housewife."}],"source":"vndb","sourceCharacterId":"c31486"},{"segments":[{"spoiler":false,"text":"よく気がつく働き者で、家の家事を面倒見る料理大好きな長女。"},{"spoiler":false,"text":"ほんわか明るい癒し系の優しいお姉さんだが、少々妄想癖があって、夢見がちなタイプ。"},{"spoiler":false,"text":"いつもにこやかな雰囲気だが、太一に関することだけは、まず譲らない。"},{"spoiler":false,"text":"キス、お風呂が好きで、よく太一にチューしたり、「一緒にお風呂」を誘ってくる。"},{"spoiler":false,"text":"「ね、たーくん。お姉ちゃんにちゅーして♪」"}],"source":"egs","sourceCharacterId":"18719","sourceWorkId":"10458","spoiler":false},{"segments":[{"spoiler":false,"text":"気のつく働き者で料理大好き。主に月嶋家の家事方面の面倒を見ている。"},{"spoiler":false,"text":"とても優しいお姉さんで、性格はほんわか明るい癒し系だが、妄想癖があって少々夢見がち。"},{"spoiler":false,"text":"雰囲気はにこやかでも、太一については独占欲が強い。キスが大好きで、太一によくキスを迫る。"},{"spoiler":false,"text":"お風呂が大好きで、一緒に入りましょ、と誘いをかけてくる。"}],"source":"bangumi","sourceCharacterId":"49207"}],"profileFacts":[{"label":"胸围（本版本）","value":"100 cm","valueContext":null,"source":"egs","sourceCharacterId":"18719","sourceWorkId":"10458","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"j","valueContext":null,"source":"egs","sourceCharacterId":"18719","sourceWorkId":"10458","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"18719","sourceWorkId":"10458","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"18719","sourceWorkId":"10458","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"18719","sourceWorkId":"10458","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b29507186d35819b9061889e53a79851a84d0654e01f7f3a075ef700151323aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e999f6fff2bc4b6b75b2220e3b5353582ac66b3aadb3a0e6e134334e2cd4a5ad.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154757:49207:6359:1","source":"bangumi"}]},{"characterId":"char_c31487","characterName":"月嶋 芳夜","sourceIds":{"bangumi":[{"characterId":"49208","match":"exact-normalized-name-in-linked-work","subjectId":"154757"}],"egsCh