 as the school's nurse."}],"source":"vndb","sourceCharacterId":"c31488"},{"segments":[{"spoiler":false,"text":"いつの間にか住みついた、月嶋家の居候。"},{"spoiler":false,"text":"明るく気さくで享楽的、イタズラ大好きでエッチにもおおらか、学園内でも、いつもビキニ＋白衣というマニアックな色気を振りまいている。"},{"spoiler":false,"text":"夜には布団にもぐりこんで、太一を抱き枕にしたり、酔った振りしてエッチなイタズラをしかけたりするトラブルメーカー。"},{"spoiler":false,"text":"「こんばんわーっ、今日も夜這いですよ♪」"}],"source":"egs","sourceCharacterId":"18722","sourceWorkId":"10458","spoiler":false},{"segments":[{"spoiler":false,"text":"すごいバディのアメリカハーフなお姉さんで、いつの間にか月嶋家に住みついている。"},{"spoiler":false,"text":"星羽学園の保険医で、白衣にビキニがトレードマーク。自宅でもビキニ姿で歩き回っている。"},{"spoiler":false,"text":"性格は明るく気ままで享楽的、Hにもおおらかでイタズラ大好き、深夜も太一のベッドにもぐりこんで、抱き枕にするトラブルメーカー。"},{"spoiler":false,"text":"お酒を飲むと、酔った振りしてエッチなことをしてくる。夢は、保健室で太一と、イケナイ個人授業をすることらしい。"}],"source":"bangumi","sourceCharacterId":"49210"}],"profileFacts":[{"label":"胸围（本版本）","value":"110 cm","valueContext":null,"source":"egs","sourceCharacterId":"18722","sourceWorkId":"10458","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"m","valueContext":null,"source":"egs","sourceCharacterId":"18722","sourceWorkId":"10458","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"18722","sourceWorkId":"10458","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"18722","sourceWorkId":"10458","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"18722","sourceWorkId":"10458","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25a9114ca4b772a09519ab6c0acc53ec5ee2cf481ea3f45835780a66fd858636.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/4434af7e083e3830d5a4749c0c5d3d6f7959a1c96f541ffcd3d3c74a8ec1e439.webp","width":213,"height":256,"source":"static-de