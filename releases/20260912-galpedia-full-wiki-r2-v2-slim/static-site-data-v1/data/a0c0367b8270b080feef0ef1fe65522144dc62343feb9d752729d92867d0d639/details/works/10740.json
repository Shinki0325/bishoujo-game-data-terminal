":"新田 静香","sourceIds":{"bangumi":[{"characterId":"93288","match":"exact-normalized-name-in-linked-work","subjectId":"124548"}],"egsCharacterIds":["18311"],"vndbCharacterId":"c30881"},"originalCharacterName":"新田 静香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"直道の幼馴染で、学園の風紀委員。"},{"spoiler":false,"text":"幼馴染としての彼女は、不器用な直道の世話をつい焼いてしまうが、風紀委員としての彼女は、厳しく直道を罰する。"},{"spoiler":false,"text":"得意技は「トラースキック」。"},{"spoiler":false,"text":"音楽が好きで、常にデジタルオーディオプレイヤーを持ち歩いている。"},{"spoiler":false,"text":"不知火軍との戦いに巻き込まれた際、直道が持っていたとある道具により、戦う力を得る。"},{"spoiler":false,"text":"「あんたのスケベは視線を、風紀委員として見過ごすワケにはいかないのよ」"}],"source":"egs","sourceCharacterId":"18311","sourceWorkId":"10740","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の風紀委員。主人公とは幼馴染。"},{"spoiler":false,"text":"不器用な主人公を見るに見かねてつい世話を焼いてしまうが、風紀委員として厳しく直道を罰する。"},{"spoiler":false,"text":"得意技はトラースキック。音楽鑑賞が大好きで常にデジタルオーディオプレーヤーを持っている。"}],"source":"bangumi","sourceCharacterId":"93288"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/346e1c2d139fcee8c9e8e4b4ceec93ab84f6e637ef0bc412a9a67a918bb97c54.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2265b8e85a223deca06891466b003130f2b553ca3d5092e646665983f0d339c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田内夏子","creatorId":"vndb:s3102","sourcePersonId":"vndb:s3102","canonicalEntityId":"vndb:s3102","name":"田内 夏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:124548:93288:19410:1","source":"bangumi"}]},{"characterId":"char_c30882","characterName":"夏川 りんね","sourceIds":{"bangumi":[{"characterId":"93289","match":"exact-normalized-name-in-linked-work","sub