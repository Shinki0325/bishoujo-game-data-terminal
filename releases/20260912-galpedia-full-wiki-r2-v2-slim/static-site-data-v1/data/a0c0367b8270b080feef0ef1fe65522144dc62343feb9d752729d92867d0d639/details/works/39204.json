1211","canonicalEntityId":"vndb:s31211","name":"せんや","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:127623","source":"vndb"},{"creditedName":"有限会社ロックンバナナ","creatorId":"vndb:s26686","sourcePersonId":"vndb:s26686","canonicalEntityId":"vndb:s26686","name":"ロックンバナナ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:127624","source":"vndb"}]},"cast":[{"characterId":"char_c44338","characterName":"白井 美月","sourceIds":{"bangumi":[{"characterId":"41406","match":"exact-normalized-name-in-linked-work","subjectId":"166756"}],"egsCharacterIds":["8104"],"vndbCharacterId":"c44338"},"originalCharacterName":"白井 美月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"311"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"私立星和学園音楽科１年生。"},{"spoiler":false,"text":"すこしだけ大人びた空気を纏う美少女。"},{"spoiler":false,"text":"涼やかなまなざしと、ストレートロング黒髪が美しい。"},{"spoiler":false,"text":"自分の世界を持っていて、好んで一人でいることはないものの、一人でも平気な性格。"},{"spoiler":false,"text":"ほっそりとして見えるが、着やせするタイプ。"},{"spoiler":false,"text":"幼い頃主人公の家の近所に引っ越して来た。ニュータウンの白く立派な家に住んでいる。"},{"spoiler":false,"text":"両親と一人娘の三人暮らし。比較的裕福な家庭で、家族関係も非常に円満。"},{"spoiler":false,"text":"家が近所なため主人公とは小～中学は同じ学校で、クラスメイトになることもあったが全く意識されず、ほとんど会話も交わすこともなく、別々の学校に進学した。"},{"spoiler":false,"text":"現在はバイオリニストを目指して、電車で一時間ほどかかる音楽科に通っている"}],"source":"egs","sourceCharacterId":"8104","sourceWorkId":"23062","spoiler":false},{"segments":[{"spoiler":false,"text":"洋溢着淡淡的成熟气质的美少女。拥有爽朗的视线和美丽的黑色长发。拥有自己的世界，虽然不是因为自己愿意而一人独处，但独自一人也无所谓的性格。看上去纤细，但其实是穿上去显瘦的类型。"},{"spoiler":false,"text":"和父母生活，家庭比较富裕。家人关系很圆满。因为家在附近，所以和主人公上同一小学和初中，虽然也曾是同班同学，但没注意过他，也基本没说过话。现在以小提琴家为目标，在私立音乐科学习。"}],"source":"bangumi","sourceCharacterId":"41406"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c763dddc5c964fd30fbe83a6241efe6caa632770eaf278216ebfb5f8ebbf7c5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/429ca944a72dd80ae91814aaab5959ddfd5b97143f2cbc6fd1da92326b24c80a.webp","width":111,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田紗記子","creatorId":"vndb:s1658","sourcePersonId":"vndb:s1658","canonicalEntityId":"vndb:s1658","name":"葵時緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:166756:41406:17079:1","source":"bangumi"}]},{"characterId":"char_c44339","characterName":"尾久野 晋二","sourceIds":{"bangumi":[{"characterId":"51189","match":"exact-normalized-name-in-linked-work","subjectId":"166756"}],"egsCharacterIds":["8105"],"vndbCharacterId":"c44339"},"originalCharacterName":"尾久野 晋二","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1112"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"公立九々治学園１年生。"},{"spoiler":false,"text":"特にはっきりした理由もなく、日々の鬱屈を溜め込んでいる少年。"},{"spoiler":false,"text":"自意識過剰で、被害妄想気味なところがある。"},{"spoiler":false,"text":"根拠の無い自信の裏返しでもある。"},{"spoiler":false,"text":"両親と兄弟二人の四人家族。"},{"spoiler":false,"text":"一人暮らしの祖父の家に入り浸っている。"},{"spoiler":false,"text":"計画という名の妄想をノートに書き綴り、いつか実現するのだと暗い情熱を滾らせている。"}],"source":"egs","sourceCharacterId":"8105","sourceWorkId":"23062","spoiler":false},{"segments":[{"spoiler":false,"text":"没啥特别的理由，积蓄着日常郁闷的少年。"},{"spoiler":false,"text":"自作多情，充满着被害妄想症。毫无理由的否定自己。"},{"spoiler":false,"text":"家中除了父母以外还有一个兄弟，不过现在沉浸在独居的祖父家。"},{"spoiler":false,"text":"将名为“计划”的妄想在笔记本上书写成册，总有一天要将其实现的黑色冲动在心中翻滚。"}],"source":"bangumi","sourceCharacterId":"51189"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f98fddce065715a6fd3b22c9892a0121eb9cbf944d0ba9bfcf7f4ab13a8a9f86.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44eddc273a8a47190687466fdd45f870d17646f849323b7ddcd89b4ace68dc08.webp","width":111,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北山恭祐","creatorId":"vndb:s5570","sourcePersonId":"vndb:s5570","canonicalEntityId":"vndb:s5570","name":"北山 恭祐","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:166756:51189:20510:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p200","sourceCompanyId":"egs:brand:724","canonicalEntityId":"vndb:p200","name":"CLOCKUP","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:39204:724","source":"egs"},{"companyId":"vndb:p10008","sourceCompanyId":"vndb:p10008","canonicalEntityId":"vndb:p10008","name":"ホビコレD","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:160111:v18806","source":"vndb"},{"companyId":"vndb:p10008","sourceCompanyId":"vndb:p10008","canonicalEntityId":"vndb:p10008","name":"ホビコレD","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:163697:v18806","source":"vndb"},{"companyId":"vndb:p26724","sourceCompanyId":"vndb:p26724","canonicalEntityId":"vndb:p26724","name":"Innocence Translations","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:170690:v18806","source":"vndb"},{"companyId":"vndb:p200","sourceCompanyId":"vndb:p200","canonic