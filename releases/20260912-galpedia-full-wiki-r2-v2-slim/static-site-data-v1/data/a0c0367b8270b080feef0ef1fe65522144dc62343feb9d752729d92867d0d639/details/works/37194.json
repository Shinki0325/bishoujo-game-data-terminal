{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"37194","model":{"presentationWorkId":"vndb:v30998","staff":{"artwork":[{"creditedName":"柾見ちえ","creatorId":"vndb:s23619","sourcePersonId":"egs:creator:36839","canonicalEntityId":"vndb:s23619","name":"柾見ちえ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:284929","source":"egs"}],"scenario":[{"creditedName":"モーリー","creatorId":"vndb:s2195","sourcePersonId":"egs:creator:2509","canonicalEntityId":"vndb:s2195","name":"モーリー","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:284930","source":"egs"}],"music":[],"other":[{"creditedName":"Robert K","creatorId":"vndb:s27546","sourcePersonId":"vndb:s27546","canonicalEntityId":"vndb:s27546","name":"Robert Kleinhenz","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:174423","source":"vndb"},{"creditedName":"Taylor D","creatorId":"vndb:s33389","sourcePersonId":"vndb:s33389","canonicalEntityId":"vndb:s33389","name":"Taylor D","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:174424","source":"vndb"},{"creditedName":"Chris Melchin","creatorId":"vndb:s33638","sourcePersonId":"vndb:s33638","canonicalEntityId":"vndb:s33638","name":"Chris Melchin","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:174425","source":"vndb"},{"creditedName":"Miki Z","creatorId":"vndb:s38239","sourcePersonId":"vndb:s38239","canonicalEntityId":"vndb:s38239","name":"Miki Z","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:174426","source":"vndb"}]},"cast":[{"characterId":"char_c97197","characterName":"ファルナ","sourceIds":{"bangumi":[{"characterId":"98264","match":"exact-normalized-name-in-linked-work","subjectId":"338704"}],"egsCharacterIds":["23404"],"vndbCharacterId":"c97197"},"originalCharacterName":"ファルナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A maid of honor in the service of Eleanor."},{"spoiler":false,"text":"She loves Eleanor as if she were her younger sister. As a maidservant, she is good at housework, but not so good at hard labor."},{"spoiler":false,"text":"She and Eleanor are taken captive and sold to a slave trader. In the slave trade, she is treated as a valuable slave thanks to her good looks and her skills as a former maid."},{"spoiler":false,"text":"When Garland came to buy her, she noticed that he seemed to be a good person and that he had money. She told the dealer that he could make money by having Garland buy her and Ellie as a set, and succeeded in getting Garland to buy them."},{"spoiler":false,"text":"She has a certain amount of trust in Garland because of his personality."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c97197"},{"segments":[{"spoiler":false,"text":"アリエノールに仕えている侍女。"},{"spoiler":false,"text":"アリエノールのことを妹同然に可愛がっている。"},{"spoiler":false,"text":"侍女であるため、家事は万能だが荒事は苦手。"},{"spoiler":false,"text":"アリエノールと一緒に捕らわれの身となり奴○商に売られてしまう。"},{"spoiler":false,"text":"奴○商では、美貌と元侍女としての技能のおかげで、"},{"spoiler":false,"text":"高価な奴○としてそれなりの扱いを受けていた。"},{"spoiler":false,"text":"ガーラントが奴○を買いに訪れた際に、人が良さそうな所、お金を持っている所などに目をつけ、奴○商に、自分とアリーをセットでガーラントに買ってもらうことで儲けになると話を吹き込み、見事、ガーラントに買わせることに成功する。"},{"spoiler":false,"text":"ガーラントのことは、その人柄からある程度信用している。"}],"source":"egs","sourceCharacterId":"23404","sourceWorkId":"30950","spoiler":false},{"segments":[{"spoiler":false,"text":"アリエノールに仕えている侍女。"},{"spoiler":false,"text":"アリエノールのことを妹同然に可愛がっている。"},{"spoiler":false,"text":"侍女であるため、家事は万能だが荒事は苦手。"},{"spoiler":false,"text":"アリエノールと一緒に捕らわれの身となり奴○商に売られてしまう。"},{"spoiler":false,"text":"奴○商では、美貌と元侍女としての技能のおかげで、"},{"spoiler":false,"text":"高価な奴○としてそれなりの扱いを受けていた。"},{"spoiler":false,"text":"ガーラントが奴○を買いに訪れた際に、人が良さそうな所、お金を持っている所などに目をつけ、"},{"spoiler":false,"text":"奴○商に、自分とアリーをセットでガーラントに買ってもらうことで儲けになると話を吹き込み、"},{"spoiler":false,"text":"見事、ガーラントに買わせることに成功する。"},{"spoiler":false,"text":"ガーラントのことは、その人柄からある程度信用している。"},{"spoiler":false,"text":"「姫様に何もしないでくださるのなら、私がこの身を捧げます」"}],"source":"bangumi","sourceCharacterId":"98264"}],"profileFacts":[{"label":"属性","source":"bangumi","sourceCharacterId":"98264","value":"お姉さん、メイド、奴○、世話焼き"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/190910816f4e22fca5672152586c43c78706dc67f12d631a5305f8fd4847262b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9ed60fc2b48177a5e5f8657fc32e20da8d593317d920b3d80391306418091a87.webp","width":64,"height":256,"source":"static-detail"},"actors":[{"creditedName":"武石あゆ実","creatorId":"vndb:s1745","sourcePersonId":"vndb:s1745","canonicalEntityId":"vndb:s1745","name":"武石 あゆ実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:338704:98264:16168:1","source":"bangumi"}]},{"characterId":"char_vndb_c97196","characterName":"アリエノール・ピックザクス","sourceIds":{"vndbCharacterId":"c97196"},"originalCharacterName":"アリエノール・ピックザクス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the first princess of the exiled Kingdom of Pixenzax. She is nicknamed \"Ellie\" by her family and close friends."},{"spoiler":false,"text":"A tomboyish princess with a strong will, perhaps due to her original temperament. She was a talented swordswoman and highly popular, so she worked as a princess knight."},{"spoiler":false,"text":"After the betrayal of her betrayer, her country falls into ruin, and she is taken captive and sold to a slave trader. When she undergoes a physical examination at the slave trader, her mark (bruise), which is only found on royalty, is confirmed, and she is treated as a high-class slave."},{"spoiler":false,"text":"Then, Garland visits the store to buy a slave, and they have a fateful encounter."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c97196"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85aedc969b34a09a3619400ee19a775b9001882ac9d31495450c91d8703edc33.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/265c208be6a4e526580269c6057866e9359e44aff00bf03ac737d43d32e1c17d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柏木 逢花","creatorId":"vndb:s1549","sourcePersonId":"vndb:s1549","canonicalEntityId":"vndb:s1549","name":"桐村 まり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87518","source":"vndb"}]},{"characterId":"char_vndb_c98338","characterName":"ガーラント","sourceIds":{"vndbCharacterId":"c98338"},"originalCharacterName":"ガーラント","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this story. He comes from a nameless village, and after the death of his parents, he comes to the city to become an adventurer. He has an aptitude for adventuring, and steadily improves his skills, becoming a mid-level adventurer at a young age."},{"spoiler":false,"text":"He is invited to go on a quest by a senior he trusts, but when he finds himself in a tight spot, he is used as bait and badly injured."},{"spoiler":false,"text":"He can no longer trust people and decides to return to the home he built in the woods, however he knows he can't live by himself due to his injuries. As a compromise, he decides to buy a slave who can help him with his daily life."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c98338"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b17007db654e989455769f8321df190c89612d5bab348f600a4b87f633d21c8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/033b0a65a73a58bea340af37bb03144d6437b2e281533c16b3dc7685667cf6c2.webp","width":188,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p341","sourceCompanyId":"egs:brand:334","canonicalEntityId":"vndb:p341","name":"Waffle","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:37194:334","source":"egs"},{"companyId":"vndb:p341","sourceCompanyId":"vndb:p341","canonicalEntityId":"vndb:p341","name":"Waffle","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:103502:v30998","source":"vndb"},{"companyId":"vndb:p341","sourceCompanyId":"vndb:p341","canonicalEntityId":"vndb:p341","name":"Waffle","roleCodes":["developer","publisher"],"identityStatus":"source-native","relat