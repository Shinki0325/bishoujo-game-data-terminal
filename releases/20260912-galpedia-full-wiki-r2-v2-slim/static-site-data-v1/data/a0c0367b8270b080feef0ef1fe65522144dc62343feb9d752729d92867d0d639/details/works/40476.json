{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"40476","model":{"presentationWorkId":"vndb:v63089","staff":{"artwork":[{"creditedName":"浅賀葵","creatorId":"vndb:s4556","sourcePersonId":"egs:creator:884","canonicalEntityId":"vndb:s4556","name":"浅賀葵","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:302969","source":"egs"}],"scenario":[{"creditedName":"有島悠也","creatorId":"vndb:s5564","sourcePersonId":"egs:creator:437","canonicalEntityId":"vndb:s5564","name":"有島悠也","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:302970","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c166582","characterName":"カナーリエ＝フォーゲル","sourceIds":{"vndbCharacterId":"c166582"},"originalCharacterName":"カナーリエ＝フォーゲル","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Job: Swordsman"},{"spoiler":false,"text":"Origin: Fleur Lapin Kingdom"},{"spoiler":false,"text":"A longsword-wielding swordsman belonging to the Adventurer's Guild."},{"spoiler":false,"text":"She is qualified to investigate forbidden areas and is one of the most skilled members of the guild. She"},{"spoiler":false,"text":"has high mission completion abilities, but is also very curious and sometimes takes actions that other adventurers would never expect."},{"spoiler":false,"text":"Her actions and fate can also show various possibilities depending on the observer."},{"spoiler":false,"text":"A woman like a kaleidoscope."},{"spoiler":false,"text":"She is very skilled in handling tools."},{"spoiler":false,"text":"A lone wolf."}],"source":"vndb","sourceCharacterId":"c166582"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/172492897f541838f30b8ed6e19630f3bb68ec161c23f92fe8c275dc8055752a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb47fa8730c51399f57294519448fb40e95507df767fa739bd3d0f7f97a3f527.webp","width":205,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c166583","characterName":"ペイリカ＝ビーナ","sourceIds":{"vndbCharacterId":"c166583"},"originalCharacterName":"ペイリカ＝ビーナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Job: Warrior"},{"spoiler":false,"text":"Origin: Grassland City Lumiel"},{"spoiler":false,"text":"A cheerful woman who is the mood maker of the party and actively interacts with others. She is the type to act on intuition."},{"spoiler":false,"text":"A warrior who confuses enemies with swift movements and unleashes a flurry of attacks when the enemy is vulnerable."},{"spoiler":false,"text":"Her attractive physique is appealing, and she is popular with both men and women."}],"source":"vndb","sourceCharacterId":"c166583"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d69c597c71096908760a7a49717b12cd569630166d487440e0bb865d6d662a47.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35f9a9f10f45ac12aaf0094112686ca31cfa0d214fedb7abe549f39ed1d9df8f.webp","width":205,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c166585","characterName":"スワン＝シーガル","sourceIds":{"vndbCharacterId":"c166585"},"originalCharacterName":"スワン＝シーガル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex"