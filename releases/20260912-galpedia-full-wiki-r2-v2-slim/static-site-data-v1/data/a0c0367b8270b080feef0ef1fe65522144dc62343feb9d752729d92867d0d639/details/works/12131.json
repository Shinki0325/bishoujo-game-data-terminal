:"vndb:s11430","name":"しろくま","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:25084","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c34812","characterName":"たろ","sourceIds":{"vndbCharacterId":"c34812"},"originalCharacterName":"たろ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I want to stay... in this 'mansion'...\""},{"spoiler":false,"text":"The protagonist of the game. He is pretty timid and looks like a girl due to his delicate features. As one could guess from his appearance, Taro has a shy personality, not to mention he is a mediocre student with few to no friends. One day, his life goes upside down as he falls in love at first sight with Shiro, who makes him to move into the mansion where the four sisters live. After this, he stops going to school, and his bizarre life in the mansion starts."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c34812"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fad52bd0634585a72e200a046af05da12ec1ba23aee35ed1787b326a92dfa026.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad157f55391e9e9dce181a67ce0b53d142789f853d1669213d1c7608e9bc4367.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黒岩 心々","creatorId":"vndb:s263","sourcePersonId":"vndb:s263","canonicalEntityId":"vndb:s263","name":"儀武 ゆう子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12893","source":"vndb"}]},{"charact