ce-native","relationId":"vndb:vn-seiyuu:12898","source":"vndb"}]},{"characterId":"char_vndb_c34818","characterName":"百合絵","sourceIds":{"vndbCharacterId":"c34818"},"originalCharacterName":"百合絵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"},"weight":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The second oldest daughter of the four sisters living in the mansion. Yurie is the one who takes on the role of the sisters' leader. She is always wearing men's clothes and is also very tomboyish, not to mention she possesses the talent of provoking anybody. She also knows the most about real life, due to having lived in reality for longer than any of the sisters. Yurie's typical day consists of driving around the mansion with her sports car."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c34818"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec8269e5771aceaa857ca309db18232104abc8cd32063cd17e36fcd0f140c61f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4cbf8516770981499811f4c64b0ae0f1e9de51817612b23891177f82c735deec.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平野 響子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"平野響子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12892","source":"vndb"}]},{"characterId":"char_vndb_c34819","characterName":"しろ","sourceIds":{"vndbCharacterId":"c34819"},"originalCharacterName":"しろ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"63"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"67"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"},"weight":{"reviewState":"source-only","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Taro... what do you think of... this mansion?\""},{"spoiler":false,"text":"A mysterious girl who lives in the mansion with the sisters. Though she keeps a poker face on almost all the time, she starts showing her friendly side more after Taro comes to live into the mansion, and begins to bond with him due to having to do the same work as him. Due to Shiro having a weak presence, almost nobody outside the mansion remembers her, nor does know about her."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c34819"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/4303005fc0b1953abdbc6e036d3a95d5b05c0e2028fcaf56904abb226572fb28.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fdee4f29e6993682f2a5d133fa289865fcbfd3ebe49d972d5e8e8658925b672e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"早乙女 綾","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12896","source":"vndb"}]},{"characterId":"char_vndb_c34820","characterName":"ハナ","sourceIds":{"vndbCharacterId":"c34820"},"originalCharacterName":"ハナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"gender":{"reviewState":"source-only","source":"vndb","value":"f"},"height":{"reviewState":"source-only","source":"vndb","value":"172"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"b"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"},"weight":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Miladies, it's almost time for your afternoon tea...\""},{"spoiler":false,"text":"A maid working at the mansion. Despite always showing a sour face, Hana is a very competent maid, and could be counted as the mansion's best maid. She also often claims to be able to do anything. For some reason, she is always blaming Taro for everything, and is almost overprotective of Yumiko. As Hana keeps her real identity a secret, the others don't know anything about her aside from the fact that she's very proficient at her job."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c34820"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74f52f966ebb06bb5cc03c27f56d9a350a95e1ab1704a92326cc54f5faaa5791.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2760ff676e6d04b919f8267780fc3f7051e196968bb1b00e4a0b71fc019771c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みすみ","creatorId":"vndb:s1164","sourcePersonId":"vndb:s1164","canonicalEntityId":"vndb:s1164","name":"石松 千恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relati