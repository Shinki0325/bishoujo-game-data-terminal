poiler":false,"text":"桔梗の娘だけ有り忍びの腕は一流。"},{"spoiler":false,"text":"若さ故に思慮が浅く血気に流行る傾向がある。"},{"spoiler":false,"text":"また、礼儀作法が完全には身に付いておらず、つい失言してしまう事が多い。"},{"spoiler":false,"text":"房術の修行を始めていないため処女。"}],"source":"egs","sourceCharacterId":"14324","sourceWorkId":"13113","spoiler":false},{"segments":[{"spoiler":false,"text":"藩主付きのくノ一で桔梗の娘。"},{"spoiler":false,"text":"志乃姫とは同い年だが、山野で育ったため緋桐のほうが大人びている。"},{"spoiler":false,"text":"昔は志乃姫の小姓だったが、年を重ねていくうちにお庭番となる。"},{"spoiler":false,"text":"桔梗の娘だけあって忍の腕は一流だが、若さ故に血気に流行る傾向がある。"},{"spoiler":false,"text":"また、礼儀作法が完全には身に付いておらず失言が目立つ。房術の修行を始めていないため処女。"},{"spoiler":false,"text":"桔梗と同様に忍びの仕事に対して誇りを持っているが、緋桐のほうが融通を利かせられる。"},{"spoiler":false,"text":"もっとも、そういう面は桔梗に注意される原因にもなっている。"}],"source":"bangumi","sourceCharacterId":"220014"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"14324","sourceWorkId":"13113","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"14324","sourceWorkId":"13113","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"14324","sourceWorkId":"13113","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"14324","sourceWorkId":"13113","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"58.8 kg","valueContext":null,"source":"egs","sourceCharacterId":"14324","sourceWorkId":"13113","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"weight":[{"comparisonValue":"59","source":"vndb","sourceCharacterId":"c40011","value":"59"},{"comparisonValue":"58.8","scope":"sourceWork","source":"egs","sourceCharacterId":"14324","sourceWorkId":"13113","value":"58.8"},{"comparisonValue":"58.8","source":"bangumi","sourceCharacterId":"220014","value":"58.8kg"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd1