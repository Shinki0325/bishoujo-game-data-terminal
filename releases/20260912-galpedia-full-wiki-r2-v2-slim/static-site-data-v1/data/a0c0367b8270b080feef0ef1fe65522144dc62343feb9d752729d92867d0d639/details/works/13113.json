":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"63"},"weight":{"reviewState":"pending-conflict","source":"vndb","value":"72"}},"descriptions":[{"segments":[{"spoiler":false,"text":"藩主の御庭番であるくノ一で鬼灯とは同郷。"},{"spoiler":false,"text":"鬼灯が里を壊滅させた時、任務で外に出ていたため生き延びた。"},{"spoiler":false,"text":"里が壊滅した後は、以前から里と親交のあった藩に身を寄せる。"},{"spoiler":false,"text":"夫がいたが任務で命を落としている。"},{"spoiler":false,"text":"忍びとしての技術は一流で体術、忍術ともにかなりのレベルにあるが主人公には遠く及ばない。"},{"spoiler":false,"text":"また、豊満な身体をしているわりには房術が苦手（不得手ではない）。"},{"spoiler":false,"text":"かなりの巨乳で、そのため乳首が陥没している。"}],"source":"egs","sourceCharacterId":"14323","sourceWorkId":"13113","spoiler":false},{"segments":[{"spoiler":false,"text":"藩主付きのくノ一で城のお庭番をしている。藩主が亡くなった後は志乃姫に仕える。"},{"spoiler":false,"text":"稟とした印象を受けるが落ち着いた優しい女性。母親でもあるため芯も強い。"},{"spoiler":false,"text":"夫は忍びの任務で命を落としている。"},{"spoiler":false,"text":"かつては山中の里に居たが、里で騒動が起こったため城に身を寄せている。"},{"spoiler":false,"text":"忍びの技に誇りを持っているため卑劣な手段を嫌う傾向にある。"},{"spoiler":false,"text":"忍としての技量は体術、忍術ともに一流。"},{"spoiler":false,"text":"房術にも長けているが、豊満過ぎる身体つきを気にしているため率先して行おうとはしない。"},{"spoiler":false,"text":"また陰毛が濃く、本人もそれを気にしている。"}],"source":"bangumi","sourceCharacterId":"220013"}],"profileFacts":[{"label":"胸围（本版本）","value":"110 cm","valueContext":null,"source":"egs","sourceCharacterId":"14323","sourceWorkId":"13113","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"167 cm","valueContext":null,"source":"egs","sourceCharacterId":"14323","sourceWorkId":"13113","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"107 cm","valueContext":null,"source":"egs","sourceCharacterId":"14323","sourceWorkId":"13113","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"63 cm","valueContext":null,"source":"egs","sourceCharacterId":"14323","sourceWorkId":"13113","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"71.8 kg","valueContext":null,"source":"egs","sourceCharacterId":"14323","sourceWorkId":"13113","sourceField":null,"scoped":true}],"metadataCand