oritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf5aa51be290ad0c3bac9cdda582c6299dee134aa640c0d9166b2519fc145742.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3cfccf1262dcd53fcf7be673bccedbf8ed76f0d10d3b3eac68631f15fee2704.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c28822","characterName":"天 雅","sourceIds":{"vndbCharacterId":"c28822"},"originalCharacterName":"天 雅","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d36094a5765fd9823cd0ad9526fd391f37ed598450b80eca784af1228aa4dc61.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/007620ca05702d842aee7e620cb7ccda4c0aab59016fe0e6dbb6b3021c386b38.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c28823","characterName":"しあんちゃん","sourceIds":{"vndbCharacterId":"c28823"},"originalCharacterName":"しあんちゃん","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chien-Chan is producer Chien's mascot character."}],"source":"vndb","sourceCharacterId":"c28823"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48041fda374d8d15745944599e726118f937a305eb5e8baa66a4868ef0b427ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/247b4edc17f55acc1c6290eec1eca1ebaf3c2d6c491a0a6c63c31d2dd2da8f9a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c815","characterName":"戌笛 なゆ","sourceIds":{"vndbCharacterId":"c815"},"originalCharacterName":"戌笛 なゆ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"AA"},"height":{"reviewState":"source-only","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nayu is Hitori’s childhood friend who is a year younger than him. She follows Hitori to his new school even though it is quite far away from their home town. She is quite unsociable and doesn’t like talking to people and can reply to people quite icily. Nayu is quite strong and refuses to show her weak points in public, although, behind this tough exterior is really a very shy and sweet girl. She’s scared of people as she used to live in the country and is scared that people will find her very strange. She feels at ease when she’s with the protagonist."},{"spoiler":false,"text":"From Liemyx's blog"}],"source":"vndb","sourceCharacterId":"c815"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f18bf88bc57bfa96ed0bd602cb0f6bb3d8bd19475e0515339718211d8ab22f1b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55eae6f2aa6de5539a6157b47678b87c1b558dc30cbc330ee92b7b3503d8f214.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜川 未央","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:37276","source":"vndb"}]},{"characterId":"char_vndb_c816","characterName":"黒河 まりあ","sourceIds":{"vndbCharacterId":"c816"},"originalCharacterName":"黒河 まりあ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Maria is in her second year at the school and is the head of the mediation committee. She lives by herself since her parents own some big business and have to travel around the world. She is very quick-witted and very good at getting her point across during arguments. She has been in the committee since she was in first year but her hard work and determination saw her being made the chairman this year. She appears to be quite calm but if you anger her then she will get violent – so watch out!"},{"spoiler":false,"text":"From Liemyx's blog"}],"source":"vndb","sourceCharacterId":"c816"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef8bb8623571f8cd253dade2841a4a34706a073c50ae38ab77238f59066af9c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80fa39804363dcbd1697217028109ae3e0c0c71a95a398730d5f6db252346de8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安 ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:37274","source":"vndb"}]},{"characterId":"char_vndb_c817","characterName":"藪野 ちゆる","sourceIds":{"vndbCharacterId":"c817"},"originalCharacterName":"藪野 ちゆる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chiyuru is also in second year and is in the Health committee, she is quite naive and straight-speaking – essentially a genki type character who lives by her own rhythm. She is pretty smart and very mischievous and likes making perverse jokes. She loves to read romantic stories (with ecchi elements) and is a romanticist even though she has no experience whatsoever with real love. Since she doesn’t act very girly, Hitori has never really considered her as a “girl” or a romantic interest… Will she manage to find her Prince Charming?"},{"spoiler":false,"text":"From Liemyx's blog"}],"source":"vndb","sourceCharacterId":"c817"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3252dde461d6e358ed7eacb24aa698f66942a4f04289a41fc15c83c2a04a31c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39ae646cffabfeee21781b0626806183074c1299c41d55d2a9c1783262e8278b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雪都 さお梨","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:37277","source":"vndb"}]},{"characterId":"char_vndb_c818","characterName":"清乃宮 みつ","sourceIds":{"vndbCharacterId":"c818"},"originalCharacterName":"清乃宮 みつ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"423"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mitsu is in 3rd year (one year older than Hitori) and is the president of the school’s festival committee, she was originally the vice president of the health committee but this year, she transferred to the festival committee. She appears to be the type who can handle anything but in reality, she’s really scared of things going wrong. She can also be a little selfish and has a childish side too. Mitsu has an old-fashioned view of love – that you must dedicate yourself to one person, due to this, she hates people talking about perverse things in front of her and gets angry and blushes madly when this happens. If she gets too emotional then she gets a nosebleed too!"},{"spoiler":false,"text":"From Liemyx's blog"}],"source":"vndb","sourceCharacterId":"c818"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc7ade2c9624fe7bfbd4ae60bf71a0e2e1d2c685ee28491f61cdb8d6a0f22119.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/916a292851dc9c8220811d9ca0fcfe7cd358373d1141905e7d5a166c45e10932.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"夏野 こおり","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:37273","source":"vndb"}]},{"characterId":"char_vndb_c819","characterName":"千々輪 ありす","sourceIds":{"vndbCharacterId":"c819"},"originalCharacterName":"千々輪 ありす","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"98"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"F"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Arisu is in 1st year and she’s a member of the festival committee, she’s very cheery and is kind to everyone and brightens up the atmosphere when she’s there. She would rather listen to other people than talk herself. Due to all of this, it is impossible for Hitori (or anyone else) to dislike her. She quite often says “That’s ecchi, isn’t that right~~”. Despite her size and age, she is very well-endowed and so she gets perved on by some guys which really annoys her."},{"spoiler":false,"text":"From Liemyx's blog"}],"source":"vndb","sourceCharacterId":"c819"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ecd66cc407081bbbbb6bfe8863687b4d650e1d12b37aaee9aac92a12aaaf9db8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8d8a72daedb76ada7981f01769661863ccdb89483a035bbec6bf954e3386a4e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊原 ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:37275","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p218","sourceCompanyId":"egs:brand:1713","canonicalEntityId":"vndb:p218","name":"Chien","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:15156:1713","source":"egs"},{"companyId":"vndb:p218","sourceCompanyId":"vndb:p218","canonicalEntityId":"vndb:p218","name":"Chien","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"