19"},{"segments":[{"spoiler":false,"text":"イギリス人の母と日本人の父のハーフ。"},{"spoiler":false,"text":"貴族のお嬢様のような見た目だが、中身はポンコツで基本ボケてる。さらにはすぐ「ふふーん」と、調子に乗って自滅するのはいつものこと。"},{"spoiler":false,"text":"ざっくばらんな性格ではあるものの、意外と恥ずかしがり屋で乙女な部分があったり。"},{"spoiler":false,"text":"水沢兄妹とは小学生の頃からの付き合いの幼馴染。"},{"spoiler":false,"text":"年下ではあるものの、めぐりとは親友同士の関係。"},{"spoiler":false,"text":"３人で過ごす時間を何より大事にしており、ずっと続けばよいと思っている。"},{"spoiler":false,"text":"基本的にポジティブで、自分が生霊となったことに対しても、特段気にしている様子は無いものの……？"}],"source":"egs","sourceCharacterId":"8672","sourceWorkId":"23631","spoiler":false},{"segments":[{"spoiler":false,"text":"光一やめぐりの幼なじみ。 イギリス人の母と日本人の父のハーフ。"},{"spoiler":false,"text":"貴族のお嬢様のような見た目だが、中身はポンコツで基本ボケている。"},{"spoiler":false,"text":"さらにはすぐ「ふふーん」と、調子に乗って自滅するのはいつものこと。"},{"spoiler":false,"text":"ざっくばらんな性格ではあるものの、意外と恥ずかしがり屋で乙女な部分がある。"},{"spoiler":false,"text":"水沢兄妹とは小学生からの付き合いで、年下ではあるものの めぐりとは親友同士。"},{"spoiler":false,"text":"3人で過ごす時間を何より大事にしており、ずっと続けば良いと思っている。"},{"spoiler":false,"text":"基本はポジティブで、自分が生霊となったことも特段 気にしていないようだが……？"},{"spoiler":false,"text":"「ふふーん、この私に任せておきなさい。 泥船に乗ったつもりでね！」"}],"source":"bangumi","sourceCharacterId":"41094"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"41094","value":"特撮ヒーロー"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"41094","value":"トマト、親しい人の悲しい表情"},{"label":"学年","source":"bangumi","sourceCharacterId":"41094","value":"前期課程3年"},{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"8672","sourceWorkId":"23631","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"8672","sourceWorkId":"23631","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"8672","sourceWorkId":"23631","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"8672","sourceWorkId":"23631","sourceField":null,"scoped":true},{"label":"腰围（本版