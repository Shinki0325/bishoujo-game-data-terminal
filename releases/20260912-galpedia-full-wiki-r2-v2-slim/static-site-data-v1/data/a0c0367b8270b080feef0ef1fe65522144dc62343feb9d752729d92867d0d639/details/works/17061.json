reditedName":"Re-born","creatorId":"vndb:s5988","sourcePersonId":"vndb:s5988","canonicalEntityId":"vndb:s5988","name":"Re-born","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:87986","source":"vndb"},{"creditedName":"あおきゅん","creatorId":"vndb:s11946","sourcePersonId":"vndb:s11946","canonicalEntityId":"vndb:s11946","name":"あおきゅん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:87987","source":"vndb"},{"creditedName":"さつき が てんこもり","creatorId":"vndb:s41534","sourcePersonId":"vndb:s41534","canonicalEntityId":"vndb:s41534","name":"さつき が てんこもり","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:87989","source":"vndb"}]},"cast":[{"characterId":"char_c6218","characterName":"アンジェリカ・ノル・ペルツォフカ","sourceIds":{"bangumi":[{"characterId":"47086","match":"exact-normalized-name-in-linked-work","subjectId":"194286"},{"characterId":"47086","match":"exact-normalized-name-in-linked-work","subjectId":"45835"},{"characterId":"47086","match":"exact-normalized-name-in-linked-work","subjectId":"78641"}],"egsCharacterIds":["1877"],"vndbCharacterId":"c6218"},"originalCharacterName":"アンジェリカ・ノル・ペルツォフカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"98"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"HP: 8000"},{"spoiler":false,"text":"MP: 9000"},{"spoiler":false,"text":"Attack: 9999"},{"spoiler":false,"text":"Defense: 7500"},{"spoiler":false,"text":"Special Skill: Insta-Kill Absolute 0 - Releases a wave of blizzards from her hand. Insta-kills the opponent."},{"spoiler":false,"text":"One of the four Demon Lords. She rules over the northern part of the demon world and is in fact the strongest out of the four."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c6218"},{"segments":[{"spoiler":false,"text":"魔界北方を支配し、魔王の中でも一番武力が高い。"},{"spoiler":false,"text":"クールな性格で、合理的な考えをする才媛。"},{"spoiler":false,"text":"生真面目な性格で、魔王というわりには驚くほど素直でやや天然気味。"},{"spoiler":false,"text":"だが意志は非常に強く、自分の考えを変えない頑固なところもある。"},{"spoiler":false,"text":"四つに分かれ争っている魔界の今の状況を、非合理的だと憂いている。"}],"source":"egs","sourceCharacterId":"1877","sourceWorkId":"17061","spoiler":false},{"segments":[{"spoiler":false,"text":"クールな性格で、合理的な考え方は変わっていないものの、真面目で素直、天然気味で嘘を簡単に信じてしまうところも健在。"},{"spoiler":false,"text":"現在はデイトレードなどで人間界の財をなし、森井家の金銭的な大黒柱となっている。"}],"source":"egs","sourceCharacterId":"1877","sourceWorkId":"19337","spoiler":false},{"segments":[{"spoiler":false,"text":"【夏はいろいろな意味で嫌いになりそうな乙女魔王】"},{"spoiler":false,"text":"最近、さらにお腹のお肉が気になるご様子の極寒の魔王さま。"},{"spoiler":false,"text":"南の島で水着になるとのことで、全体的にシェイプアップをしようとしたのだが、若干失敗して、リバウンドした模様。"},{"spoiler":false,"text":"・スリーサイズ：99/60/90"},{"spoiler":false,"text":"・属性：夏にお悩みのぷにぷに優等生"},{"spoiler":false,"text":"この胸に軋む想いは、どうすればあいつに伝わるのだろうか……"}],"source":"egs","sourceCharacterId":"1877","sourceWorkId":"20422","spoiler":false},{"segments":[{"spoiler":false,"text":"魔界北方を支配し、魔王の中でも一番武力が高い。クールで合理的な考えをする才媛。"},{"spoiler":false,"text":"生真面目な性格で、魔王というわりには驚くほど素直でやや天然気味。"},{"spoiler":false,"text":"だが意志は非常に強く、自分の考えを変えない頑固なところもある。"},{"spoiler":false,"text":"四つに分かれ争っている魔界の今の状況を、非合理的だと憂いている。"},{"spoiler":false,"text":"「気持ち良く……ないか？　すまない、まだこういう事に慣れていないんだ」"},{"spoiler":false,"text":"【エッチステータス】"},{"spoiler":false,"text":"うぅ……すまない、こんな締まりのない身体で……。"},{"spoiler":false,"text":"それもこれも国政のことばかりに没頭し、女としての自分を磨くことを怠っていたせいだな。"},{"spoiler":false,"text":"男性経験もないし、そもそも男女の営みに関しても、まだまだ知らないことばかり……はぁ……。"},{"spoiler":false,"text":"だからその……お前にいろいろと “エッチなこと” を教えて欲しい。"}],"source":"bangumi","sourceCharacterId":"47086"}],"profileFacts":[{"label":"胸围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"1877","sourceWorkId":"17061","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"1877","sourceWorkId":"17061","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"1877","sourceWorkId":"17061","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/836673d0a7664a393cdfc653a45006de23407d9651a84bc547cc08b81fb26475.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30f0cda537c8f97d3aab5104c2b14f1c0c4af2f7e45b1622372a8ec5ef429caf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:45835:47086:5906:1","source":"bangumi"}]},{"characterId":"char_c6220","characterName":"ジッタ","sourceIds":{"bangumi":[{"characterId":"47087","match":"exact-normalized-name-in-linked-work","subjectId":"194286"},{"characterId":"47087","match":"exact-normalized-name-in-linked-work","subjectId":"45835"},{"characterId":"47087","match":"exact-normalized-name-in-linked-work","subjectId":"78641"}],"egsCharacterIds":["1884"],"vndbCharacterId":"c6220"},"originalCharacterName":"ジッタ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewSta