{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"10995","model":{"presentationWorkId":"vndb:v832","staff":{"artwork":[{"creditedName":"紫カジマ","creatorId":"vndb:s44993","sourcePersonId":"egs:creator:5473","canonicalEntityId":"vndb:s44993","name":"紫カジマ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:68531","source":"egs"}],"scenario":[{"creditedName":"にゃこ","creatorId":"vndb:s9736","sourcePersonId":"egs:creator:12891","canonicalEntityId":"vndb:s9736","name":"にゃこ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:68532","source":"egs"},{"creditedName":"わさび(シナリオ)","creatorId":"vndb:s34899","sourcePersonId":"egs:creator:10096","canonicalEntityId":"vndb:s34899","name":"わさび(シナリオ)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:68533","source":"egs"},{"creditedName":"文音(彩音)(シナリオ)","creatorId":"vndb:s5809","sourcePersonId":"egs:creator:2478","canonicalEntityId":"vndb:s5809","name":"文音(彩音)(シナリオ)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:70731","source":"egs"},{"creditedName":"千歳","creatorId":"vndb:s7463","sourcePersonId":"egs:creator:5183","canonicalEntityId":"vndb:s7463","name":"千歳","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:70732","source":"egs"}],"music":[{"creditedName":"TOY","creatorId":"vndb:s1966","sourcePersonId":"vndb:s1966","canonicalEntityId":"vndb:s1966","name":"TOY","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:16263","source":"vndb"}],"other":[{"creditedName":"渡部涼","creatorId":"vndb:s54989","sourcePersonId":"egs:creator:23087","canonicalEntityId":"vndb:s54989","name":"渡部涼","detail":"OP曲「琥珀の音」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:145995","source":"egs"},{"creditedName":"パリオ","creatorId":"vndb:s2790","sourcePersonId":"egs:creator:12719","canonicalEntityId":"vndb:s2790","name":"パリオ","detail":"ムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:70958","source":"egs"},{"creditedName":"パリオ","creatorId":"vndb:s2790","sourcePersonId":"vndb:s2790","canonicalEntityId":"vndb:s2790","name":"パリオ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:16264","source":"vndb"},{"creditedName":"水鼠","creatorId":"vndb:s5004","sourcePersonId":"vndb:s5004","canonicalEntityId":"vndb:s5004","name":"水鼠","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:16265","source":"vndb"},{"creditedName":"KIT","creatorId":"vndb:s17303","sourcePersonId":"vndb:s17303","canonicalEntityId":"vndb:s17303","name":"KIT","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:16269","source":"vndb"},{"creditedName":"美峰","creatorId":"vndb:s19991","sourcePersonId":"vndb:s19991","canonicalEntityId":"vndb:s19991","name":"(株)美峰(株式会社美峰)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:16270","source":"vndb"},{"creditedName":"渡部 涼","creatorId":"vndb:s54989","sourcePersonId":"vndb:s54989","canonicalEntityId":"vndb:s54989","name":"渡部 涼","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:16273","source":"vndb"}]},"cast":[{"characterId":"char_c48860","characterName":"フィーナ=レネアビット","sourceIds":{"bangumi":[{"characterId":"56009","match":"exact-normalized-name-in-linked-work","subjectId":"154084"}],"egsCharacterIds":["16976"],"vndbCharacterId":"c48860"},"originalCharacterName":"フィーナ=レネアビット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Musical instrument: Harp (small)."}],"source":"vndb","sourceCharacterId":"c48860"},{"segments":[{"spoiler":false,"text":"宿屋兼酒場を営む両親の手伝いをしている、働き者の少女。"},{"spoiler":false,"text":"温和で優しく、胸を温かくしてくれる素朴な魅力を持っている。"},{"spoiler":false,"text":"飲み食いするガサツな客たちも、看板娘のフィーナには甘いようで、"},{"spoiler":false,"text":"酔った勢いでケンカが起こることもあるが、"},{"spoiler":false,"text":"彼女が一生懸命止めに入ると、腰を落ち着けるようである。"},{"spoiler":false,"text":"元々音楽に惹かれており、フェリクスを助けたことで、演奏会にも関わっていく。"}],"source":"egs","sourceCharacterId":"16976","sourceWorkId":"10995","spoiler":false},{"segments":[{"spoiler":false,"text":"ウィーネフェルトの街で宿屋兼酒場を営む両親の手伝いをしている。"},{"spoiler":false,"text":"両親思いで、食事や酒を運んだり、部屋の掃除をしたり洗濯をしたり、買い出しに出かけたりとよく働く。過去にあった音楽との出会いにより、音楽に惹かれ、楽器－ハープを召喚することが出来るという、特異な力を目覚めさせた。"},{"spoiler":false,"text":"性格は温和で優しく、胸を温かくしてくれる素朴な身近さを感じさせてくれる。ケンカなどの争いごとや、人と人がいがみ合ったりするのが苦手で、酔った客のケンカには敏感。ちょっと怖いけど、ケンカはダメ、と一生懸命に止められると、酔った客も腰を落ち着けくれる。看板娘であり、飲み食いしに来るガサツな男達も娘のように思い、彼女には甘い。"},{"spoiler":false,"text":"倒れたフェリクスを助けたことから、演奏会へと関わっていく。"},{"spoiler":false,"text":"「好きだって気持ちは大切に…………うん、そうだよね」"}],"source":"bangumi","sourceCharacterId":"56009"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62b737f20d1136abdd779f91a4676e62ba8a80c284207f63f65c377abbf61dbe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/054b603b164bc00b28f0b56f94a09a04d877c5e79e6d8c52392d86073895a08c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幡宮かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154084:56009:5940:1","source":"bangumi"}]},{"characterId":"char_c48861","characterName":"シンシア=ルーチェル","sourceIds":{"bangumi":[{"characterId":"56010","match":"exact-normalized-name-in-linked-work","subjectId":"154084"}],"egsCharacterIds":["16977"],"vndbCharacterId":"c48861"},"originalCharacterName":"シンシア=ルーチェル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Musical instrument: Clarinet."}],"source":"vndb","sourceCharacterId":"c48861"},{"segments":[{"spoiler":false,"text":"馬＋鳥のような生き物“ヴィーオ”と共に各地を回る、しっかり者の女の子。"},{"spoiler":false,"text":"早くに両親を亡くした彼女を救ってくれた「美しい音色」に憧れ、"},{"spoiler":false,"text":"その力に惹かれる強い思いから、楽器召還の能力に目覚める。"},{"spoiler":false,"text":"フィーナと仲が良く、少し前まで宿屋で一緒に演奏していたことから、"},{"spoiler":false,"text":"フェリクスとも知り合うことになる。"},{"spoiler":false,"text":"甘えを許されない事情からしっかり者になったが、本当は誰かに甘えたいようで――。"}],"source":"egs","sourceCharacterId":"16977","sourceWorkId":"10995","spoiler":false},{"segments":[{"spoiler":false,"text":"物心つく前に父親を亡くし、あまり身体の丈夫でなかった母親も、シンシアを残してこの世を去ってしまう。"},{"spoiler":false,"text":"そんな彼女に救いをもたらしたのは、花をつけ始めた大樹の下、美しい音色を奏でる旅人だった。花びら舞い散る幻想的な風景、すべてを忘れて音楽に聴き入り、その力に惹かれて自分もああなりたいと志す。その気持ちが彼女を楽器召還の力に目覚めさせた。"},{"spoiler":false,"text":"フェリクス同様、各地を一人で渡り歩いていたため、外見に反してしっかりもの。それは早くに両親を亡くし、元々の家庭の事情からも甘えたりすることができなかっただけで、本当は誰かに甘えたりしたい。"},{"spoiler":false,"text":"ヴィーオという荷物や人を運ぶための、馬と鳥を足したような動物と共に各地を回っている。"},{"spoiler":false,"text":"フィーナと仲がよく、少し前までは宿屋で一緒に演奏したりしていたことから、フェリクスとも知り合う。演奏会には元々参加するつもりでいた。"},{"spoiler":false,"text":"「えへへ、今日も感謝感謝だね」"}],"source":"bangumi","sourceCharacterId":"56010"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1525c6a78e7331b98493c815fb4912e53c9690b83e8d1c14faf80307d59ae55.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1725e9ccdcd7cdf946bc34154431b1540c62a059b8aad2f71837daf00c4d47d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阪田佳代","creatorId":"vndb:s650","sourcePersonId":"vndb:s650","canonicalEntityId":"vndb:s650","name":"鮎川ひなた","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154084:56010:5133:1","source":"bangumi"}]},{"characterId":"char_c48862","characterName":"アルシエラ=リヴィエランテ","sourceIds":{"bangumi":[{"characterId":"56011","match":"exact-normalized-name-in-linked-work","subjectId":"154084"}],"egsCharacterIds":["16978"],"vndbCharacterId":"c48862"},"originalCharacterName":"アルシエラ=リヴィエランテ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A famous violinist from a wealthy upper class family. Vogras Rivielante's daughter."}],"source":"vndb","sourceCharacterId":"c48862"},{"segments":[{"spoiler":false,"text":"振る舞い、教養、品格を備えた貴族の娘。"},{"spoiler":false,"text":"しかし、それは彼女が演じている一つの顔に過ぎず、"},{"spoiler":false,"text":"本来は好奇心が強く、走り回ったり、いたずら好きな普通の女の子。"},{"spoiler":false,"text":"だた、演じることが苦痛な訳ではなく、素の自分で付き合える友達が欲しいだけ。"},{"spoiler":false,"text":"昔、聞いた音楽家の演奏と各地を巡った話から、外の世界と音楽に関心を抱き演奏会に参加、"},{"spoiler":false,"text":"フェリクスがその音楽家の息子だと知り、絡んでくるようになる。"}],"source":"egs","sourceCharacterId":"16978","sourceWorkId":"10995","spoiler":false},{"segments":[{"spoiler":false,"text":"貴族の娘として生まれ、相応の振る舞い、教養、品格を与えられて育った。"},{"spoiler":false,"text":"ある日屋敷に招かれた音楽家の演奏と、各地を巡った時の話を聞き、外の世界と音楽に強く惹かれた。元々好奇心が強い彼女は、自分を聞いた話に重ねるだけでは足りず、屋敷を抜け出し一人で街へ出るようになる。小さな冒険、家柄と自分の立ち位置を理解している彼女は、それは少しの間見れば覚める夢だとわかっている。"},{"spoiler":false,"text":"上流階級のお嬢さま、といった顔は、彼女が演じているに過ぎない顔。本来は好奇心が強く、幼い頃は屋敷の中を走り回ったり、虫を掴んでお手伝いの女性を驚かせたりしていた。演じていることは別段苦痛ではなく、家のことも嫌いではない。ただ、本来の姿で付き合える友達が欲しい。"},{"spoiler":false,"text":"彼女も演奏会に参加していて、そこからフェリクスと知り合う。"},{"spoiler":false,"text":"昔屋敷に招かれたというのはフェリクスの両親であり、フェリクスを彼らの息子と知り絡んでくる。"},{"spoiler":false,"text":"「たっ、たまたま、通りかかった、だけよ…………」"}],"source":"bangumi","sourceCharacterId":"56011"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a5340ac01de4216f7d2534f25ae80ca06d66e801cbf320da3638cc90fb73b92.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b59894fd4dc69a101f176b26c07f1c67a002c57f7bcc4cbb28a41a051029443.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154084:56011:5906:1","source":"bangumi"}]},{"characterId":"char_c48863","characterName":"シェルミィ=スピウェルド","sourceIds":{"bangumi":[{"characterId":"56012","match":"exact-normalized-name-in-linked-work","subjectId":"154084"}],"egsCharacterIds":["16979"],"vndbCharacterId":"c48863"},"originalCharacterName":"シェルミィ=スピウェルド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Musical instrument: Bodhrán."}],"source":"vndb","sourceCharacterId":"c48863"},{"segments":[{"spoiler":false,"text":"装飾品職人の父を誇りにする少女。"},{"spoiler":false,"text":"明るく元気なムードメーカーで友達も多く、子供たちとよく遊んでいる。"},{"spoiler":false,"text":"演奏会とは無縁ながら、その交流の広さからフィーナやシンシアとも知り合いで、"},{"spoiler":false,"text":"フィリクスとも、出会ってすぐ打ち解ける。"},{"spoiler":false,"text":"楽器は触ったこともないのだが、音楽を聴くことは好きらしく、"},{"spoiler":false,"text":"自然と身体でリズムを取ってしまう。"}],"source":"egs","sourceCharacterId":"16979","sourceWorkId":"10995","spoiler":false},{"segments":[{"spoiler":false,"text":"街に運ばれてくる金や銀などから装飾品を作る職人の家に生まれる。"},{"spoiler":false,"text":"父親の作った装飾品で誰かが喜ぶ顔や、可愛くも、綺麗にも、人の印象を変えてしまう装飾品に惹かれる。父親のことは誇りに思っており、まだ子供だった頃にもらったアクセサリを宝物にしている。将来は父親の後を継ぎ、自分も職人になろうと父親の元で修行している。"},{"spoiler":false,"text":"明るく元気な性格で、街でも知り合いが多く、子供たちとよく遊んでいたりする。男の子、女の子、といった認識はなく、ただ友達、というふうに相手を認識する。"},{"spoiler":false,"text":"性格から注意力散漫で不器用と思われがちだが、職人を目指しているだけあって、器用で高い集中力もある。"},{"spoiler":false,"text":"演奏会とは無関係ながら、行動範囲が広く、フィーナやシンシアとも知り合いで、フェリクスともすぐに打ち解ける。楽器には触ったこともないが、音楽を聴くことは好きで、自然とリズムを取ってしまう。"},{"spoiler":false,"text":"「あは、音楽って楽しいね！なんだかのぼせてきちゃったよ」"}],"source":"bangumi","sourceCharacterId":"56012"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a0e4c5dcc9f0a182952759a352aec1e18a860b1b847ec91481ba0657dea8b88.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d07a90001106d61cbbe876f8517f6b6726bc9f2138e6143f859f18230a8ab39.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154084:56012:6016:1","source":"bangumi"}]},{"characterId":"char_c48864","characterName":"イレーネ=カトルディータ","sourceIds":{"bangumi":[{"characterId":"56013","match":"exact-normalized-name-in-linked-work","subjectId":"154084"}],"egsCharacterIds":["16980"],"vndbCharacterId":"c48864"},"originalCharacterName":"イレーネ=カトルディータ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Musical instrument: Lute."}],"source":"vndb","sourceCharacterId":"c48864"},{"segments":[{"spoiler":false,"text":"親戚が営むカフェの手伝いをしている少女。"},{"spoiler":false,"text":"流行り病で両親と故郷を無くした心の傷を持っているが、"},{"spoiler":false,"text":"それを表に出さない柔らかな微笑みと、包み込むような温もりから、"},{"spoiler":false,"text":"お菓子の差し入れで通っている孤児院の子供や、カフェのお客から慕われている。"},{"spoiler":false,"text":"演奏会には参加しておらず、音楽にも関わりがないが、"},{"spoiler":false,"text":"広場を明るくする奏者たちの音色には、いつも耳を傾けているようだ。"}],"source":"egs","sourceCharacterId":"16980","sourceWorkId":"10995","spoiler":false},{"segments":[{"spoiler":false,"text":"流行り病により両親と故郷を失い、今は故郷を離れこの街で親戚の営むカフェの手伝いをしている。表に出して落ち込んだりすることはないが、過去の出来事は傷となって残っている。"},{"spoiler":false,"text":"街の孤児院の建っている位置や外観、そこの景観から故郷の家を感じ、売れ残ったお菓子などを差し入れている。街は今花とお祭りで盛り上がっているが、故郷を失った時も花が咲いており、綺麗だと思う一方で当時を思い出し心に刺さるものがある。"},{"spoiler":false,"text":"その穏やかな性格と雰囲気から、孤児院の子供たちからはお菓子をくれるお姉さん、とはまた別に慕われている。柔らかな微笑み、包み込むようなぬくもりは、カフェにおいても力を発揮している。元々の性格もあるが、過去の出来事が彼女の周囲を包むぬくもりを大きくしている。"},{"spoiler":false,"text":"演奏会には参加しておらず、フェリクスがカフェを訪れたことにより出会う。音楽に関わりはないが、広場を明るくしてくれる奏者たちの音色には、いつも耳を傾けている。"},{"spoiler":false,"text":"「毎日顔を合わせられるのって、素敵じゃないかしら」"}],"source":"bangumi","sourceCharacterId":"56013"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/909567579af478fb2d00a00deb39d342162fd50bc7248965a6417744f929d291.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e99172393ac1b4ed4c218785260422d64fc451b8003deee46f6cb10c8c7403f6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平山ゆかり","creatorId":"vndb:s285","sourcePersonId":"vndb:s285","canonicalEntityId":"vndb:s285","name":"東かりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154084:56013:5905:1","source":"bangumi"}]},{"characterId":"char_vndb_c48865","characterName":"ヴォグラス＝リヴィエランテ","sourceIds":{"vndbCharacterId":"c48865"},"originalCharacterName":"ヴォグラス＝リヴィエランテ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The town's mayor who is a wealthy upper class man, judges the concert and Alsiela Rivielante's father."}],"source":"vndb","sourceCharacterId":"c488