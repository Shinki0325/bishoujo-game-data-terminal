:creator:34312","canonicalEntityId":"egs:creator:34312","name":"ウキヨライフ","detail":"DTP","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:226079","source":"egs"},{"creditedName":"Kitty-tama","creatorId":"vndb:s24005","sourcePersonId":"vndb:s24005","canonicalEntityId":"vndb:s24005","name":"Kitty-tama","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:169910","source":"vndb"},{"creditedName":"DS55","creatorId":"vndb:s27612","sourcePersonId":"vndb:s27612","canonicalEntityId":"vndb:s27612","name":"Roman Stuart","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:169911","source":"vndb"},{"creditedName":"Eleventacle","creatorId":"vndb:s29602","sourcePersonId":"vndb:s29602","canonicalEntityId":"vndb:s29602","name":"Eleventacle","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:169912","source":"vndb"},{"creditedName":"Dr.Octopus","creatorId":"vndb:s52105","sourcePersonId":"vndb:s52105","canonicalEntityId":"vndb:s52105","name":"Dr.Octopus","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:169913","source":"vndb"},{"creditedName":"tomsan","creatorId":"vndb:s6343","sourcePersonId":"vndb:s6343","canonicalEntityId":"vndb:s6343","name":"tomsan","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:169917","source":"vndb"},{"creditedName":"樋舘 誠","creatorId":"vndb:s7774","sourcePersonId":"vndb:s7774","canonicalEntityId":"vndb:s7774","name":"樋舘 誠","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:169918","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c31432","characterName":"リグレット","sourceIds":{"vndbCharacterId":"c31432"},"originalCharacterName":"リグレット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The goddess of the northern sky who governs over winter, and is the youngest daughter of the 4 goddesses."},{"spoiler":false,"text":"Also known as the『Guardian Deity of Ice』."},{"spoiler":false,"text":"She governs over crafts, fishing and music(tradition included) from within the country of midwinter in the north surrounded by sub-zero temperatures and snowstorms, Guraz. She is known as a goddess who tests the strength and perseverance of humanity."},{"spoiler":false,"text":"As expected of the youngest sister of the 4 goddesses, her youth stands out. While she is a symbol of worship and a goddess who is meant to guide humans, she really just wants to be pampered and fussed over. While she can't exactly show it when in front of humans, she relies very much on her sisters and is dependent on them."},{"spoiler":false,"text":"「I-I'm the goddess of this land, Rigret! If you resist, then in the name of the Guardian Deity, I won't forgive you!」"},{"spoiler":false,"text":"Weapon name: Gjallarjorn"},{"spoiler":false,"text":"From Ninetail"}],"source":"vndb","sourceCharacterId":"c31432"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c15bc3f751b06adf434e9d67e890708b1c607aa8ff9e109734045a5987858969.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad0e41e8e8607d99e6dce568d5a4d0cb61f098a7da1af78b8c980043c486a003.webp","width":212,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c31433","characterName":"リグレット","sourceIds":{"vndbCharacterId":"c31433"},"originalCharacterName":"リグレット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The form taken on by the Goddess of Winter, Rigret, after she has succumbed to corruption by Loki."},{"spoiler":false,"text":"Having been thoroughly corrupted, her transient yet pure and innocent personality has completely vanished, and she has become an impish devil who tricks and deceives men."},{"spoiler":false,"text":"Because she seems almost like an innocent kitten, there is nothing more cruel than being faced with the reality of her personality on a battlefield as an enemy soldier."},{"spoiler":false,"text":"After being corrupted by Loki, she now has a strong desire to monopolise, and therefore just about always clings to him, wanting attention. However, he seems to find this annoying, and usually manages to throw her off or give her the slip."},{"spoiler":false,"text":"「Will you praise me more, Loki? Faith is power...My Gjallarhorn can grant blessings, and with that, everyone would willingly, happily die for me」"},{"spoiler":false,"text":"Weapon name: Gjallarjorn"}],"source":"vndb","sourceCharacterId":"c31433"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee8ae9504884ad74a5fd98c0683f63902f6f21e17599cbbac48161078ff7ea92.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f6698f841007aec757aa6fe00104400be374b37fcab918dee5bb3506fa77247.webp","width":212,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c51977","characterName":"ロキ＝ムスペルヘイム","sourceIds":{"vndbCharacterId":"c51977"},"originalCharacterName":"ロキ＝ムスペルヘイム","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The current head of Muspellzheimr, a tributary house to the imperial nobility which once held significant influence within the demon realm."},{"spoiler":false,"text":"He lived his early life peacefully with his parents. However, one day his father was branded a rebel without cause, and was executed for his suspected crimes while his mother was incarcerated."},{"spoiler":false,"text":"Loki was not executed, but was instead forced to give up his demonic armament which is considered a proof of inheritance to the throne."},{"spoiler":false,"text":"After that, Loki was forced to live in the castle, ostracised and branded as the child of a rebel. However, Loki has now decided to participate in the feud for the throne."},{"spoiler":false,"text":"Armed with his skill with the spear and tactical mind left behind by his deceased father, with the knowledge of magic and how to handle women taught to him by his maid, Fena..."},{"spoiler":false,"text":"And finally, primed with his ace in the hole, the power of the 『God of Armageddon』, he fights to win the feud for the throne."},{"spoiler":false,"text":"「I will become the ruler of the demon realm. To that end, I'm willing to destroy every obstacle in my path!」"}],"source":"vndb","sourceCharacterId":"c51977"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a6d44ff04c1155a94cd4dd868f3c2d419d5fce2214428b12d4c4819acdc9f3d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdac979ed26f2adff3880adf03c48798ef2d6a3c44b06b66abfb55878debd5b5.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:2058","sourceCompanyId":"egs:brand:2058","canonicalEntityId":"egs:brand:2058","name":"DualTail(DualMage)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:29951:2058","source":"egs"},{"companyId":"vndb:p507","sourceCompanyId":"vndb:p507","canonicalEntityId":"vndb:p507","name":"dualtail","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:84481:v29473","source":"vndb"},{"companyId":"vndb:p102","sourceCompanyId":"vndb:p102","canonicalEntityId":"vndb:p102","name":"JAST USA","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:94152:v29473","source":"vndb"},{"companyId":"vndb:p507","sourceCompanyId":"vndb:p507","canonicalEntityId":"vndb:p507","name":"dualtail","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:94153:v29473","source":"vndb"},{"companyId":"vndb:p507","sourceCompanyId":"vndb:p507","canonicalEntityId":"vndb:p507","name":"dualtail","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:98623:v29473","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
