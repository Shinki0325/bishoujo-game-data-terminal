{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"25541","model":{"presentationWorkId":"vndb:v21434","staff":{"artwork":[{"creditedName":"白谷こなか","creatorId":"vndb:s17502","sourcePersonId":"egs:creator:33305","canonicalEntityId":"vndb:s17502","name":"白谷こなか","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:203261","source":"egs"}],"scenario":[{"creditedName":"へくちゅん","creatorId":"vndb:s12594","sourcePersonId":"egs:creator:32095","canonicalEntityId":"vndb:s12594","name":"へくちゅん","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:203262","source":"egs"}],"music":[{"creditedName":"okky","creatorId":"vndb:s22768","sourcePersonId":"vndb:s22768","canonicalEntityId":"vndb:s22768","name":"沖野 将史","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:141565","source":"vndb"}],"other":[{"creditedName":"K. Wiley","creatorId":"vndb:s27749","sourcePersonId":"vndb:s27749","canonicalEntityId":"vndb:s27749","name":"Kaitlyn Wiley","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:141558","source":"vndb"},{"creditedName":"B. Diep","creatorId":"vndb:s37837","sourcePersonId":"vndb:s37837","canonicalEntityId":"vndb:s37837","name":"B. Diep","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:141559","source":"vndb"},{"creditedName":"J. Burgos","creatorId":"vndb:s27685","sourcePersonId":"vndb:s27685","canonicalEntityId":"vndb:s27685","name":"Jonathan Burgos","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:141560","source":"vndb"},{"creditedName":"J. Davidson","creatorId":"vndb:s27478","sourcePersonId":"vndb:s27478","canonicalEntityId":"vndb:s27478","name":"Alice Davidson","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:141561","source":"vndb"},{"creditedName":"J. Baumlin","creatorId":"vndb:s28172","sourcePersonId":"vndb:s28172","canonicalEntityId":"vndb:s28172","name":"John Baumlin","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:141562","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c64081","characterName":"アイ・Ｅ","sourceIds":{"vndbCharacterId":"c64081"},"originalCharacterName":"アイ・Ｅ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ai used to boast a tremendous amount of popularity, but after losing her mantle at the top she is looking for a chance to prove her mettle."},{"spoiler":false,"text":"Her desire for the crown is strong, and she spares no effort. However, she tends to mess up and get flustered, leading her to fall short of the mark. To make sure she delivers favorable results for this concert and continue acting as Macro Space’s representative, she is currently devising a trump card for the tournament."},{"spoiler":false,"text":"Affiliation:"},{"spoiler":false,"text":"Macro Space"},{"spoiler":false,"text":"“I have to take first place at the Space Live!”"},{"spoiler":false,"text":"From Mangagamer"}],"source":"vndb","sourceCharacterId":"c64081"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/225b6bcc6516699e1233649be4de31b9edcb0cff62b9e6b6e513dbf1ef401fc2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e669a091155b7071719806f7bdf3a0880a8fcc19cd1b1434775c18c0f71ca610.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c64082","characterName":"Ｇ・クロム","sourceIds":{"vndbCharacterId":"c64082"},"originalCharacterName":"Ｇ・クロム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"With vast economic power propping her up, she is greatly expanding her popularity. Supposedly, dark rumors are hinting that a stranger has acquired her personal information."},{"spoiler":false,"text":"Although she’s the cool and emotionless type, she unexpectedly hates losing and will lash out when provoked."},{"spoiler":false,"text":"She excels at data analysis, so she will exploit that by challenging her opponents’ weaknesses, adhere to the audience’s preferences, and employ superior tactics. Her Space is betting everything on her, so she’s the favorite to win."},{"spoiler":false,"text":"Affiliation: Goggle Space"},{"spoiler":false,"text":"“I have no interest in being the top idol. But... I hate losing.”"},{"spoiler":false,"text":"From Mangagamer"}],"source":"vndb","sourceCharacterId":"c64082"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fe13510a8bd3d39e7cbeebb471259dfa427b52a3904316b01b1e5b3a669b441.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52c724b43f6bb89ed467b3fc54bbaefd0b975807135bfb720285b3b118df62bb.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c64083","characterName":"火狐","sourceIds":{"vndbCharacterId":"c64083"},"originalCharacterName":"火狐","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A fox spirit said to have been wandering since ancient Net Space. Her elusive nature is such, that given the chance to vanish before you, she will reappear in the exact same location."},{"spoiler":false,"text":"She acts haughty, but her skills and reputation are second to none."},{"spoiler":false,"text":"Although she’s next in line to be the ideal candidate for the championship due to her composure and exceptional prowess, she doesn’t yearn for victory. Instead, she delights in seeing the youth give it their all."},{"spoiler":false,"text":"Affiliation: Mosaic Space"},{"spoiler":false,"text":"“You say you do not know me? My word, it seems some education is in order.”"},{"spoiler":false,"text":"From Mangagamer"}],"source":"vndb","sourceCharacterId":"c64083"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31cc7c55cb5b63fac1f24080e5403815dd1d641646e39724c2e1512fa888a7e7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/741a09755c0ad93784bb9518d559514ee7174486f9ae3c85019253ece27e6ceb.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c64084","characterName":"サリファ","sourceIds":{"vndbCharacterId":"c64084"},"originalCharacterName":"サリファ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sarifa is an eloquent and fashionable person that dislikes rooms with windows. Numerous people have seen her indulging in apples. She prides herself on her trendy fashion sense which she uses as her selling point, but she utterly rejects those who clash with her style."},{"spoiler":false,"text":"She makes a point of never displaying her bad side, which she upholds, come rain or shine. Although she’s the most composed and pragmatic of the idols, she has a habit of employing all-or-nothing gambles."},{"spoiler":false,"text":"Affiliation:"},{"spoiler":false,"text":"AI Space"},{"spoiler":false,"text":"“I won’t do something unrefined like achieve victory through great effort. Instead, I will attain it in a smart fashion. Right, in a way best suited to my nature.”"},{"spoiler":false,"text":"From Mangagamer"}],"source":"vndb","sourceCharacterId":"c64084"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3166b03fdceaaa3f3df9333ea20b9136af5b764cd0f37660b6a328b6142e425.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e08404eb4be16fdc039e77147d328532e30de11082f97e7882dba5a68de3ccd.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c64085","characterName":"月影","sourceIds":{"vndbCharacterId":"c64085"},"originalCharacterName":"月影","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Born in the country of the rising sun, she dons an old-fashioned look and has the Galapagos-style trait of referring to herself as ‘Boku.’She is worried that her Japanese-style appeal is overlapping with Higitsune."},{"spoiler":false,"text":"She wants to shed her minor character persona, so she exudes an almost cunningly cute aura. However, she lacks many opportunities to attract attention, so she never gets the chance to bare her fangs."},{"spoiler":false,"text":"Her dream is to become an adored star during this concert."},{"spoiler":false,"text":"Affiliation:"},{"spoiler":false,"text":"Luna Space"},{"spoiler":false,"text":"“Don’t say that! What I’m wearing is authentic Japanese clothing.”"},{"spoiler":false,"text":"From Mangagamer"}],"source":"vndb","sourceCharacterId":"c64085"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/724fba79f057c0b26a66f3043d61951d69782f0bf1f7204da81ed6e5a8bd3dfe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a5a5a5d8e5a57094335ab2f1b162f7ce0f4aba614969c2a29b9925cc9090d7a.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:111","sourceCompanyId":"egs:brand:111","canonicalEntityId":"egs:brand:111","name":"CIRCUS","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:25541:111","source":"egs"},{"companyId":"vndb:p65","sourceCompanyId":"vndb:p65","canonicalEntityId":"vndb:p65","name":"CIRCUS","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:59719:v21434","source":"vndb"},{"companyId":"vndb:p428","sourceCompanyId":"vndb:p428","canonicalEntityId":"vndb:p428","name":"MangaGamer","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:59720:v21434","source":"vndb"},{"companyId":"vndb:p65","sourceCompanyId":"vndb:p65","canonicalEntityId":"vndb:p65","name":"CIRCUS","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:67794:v21434","source":"vndb"},{"companyId":"vndb:p428","sourceCompanyId":"vndb:p428","canonicalEntityId":"vndb:p428","name":"MangaGamer","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:68813:v21434","source":"vndb"},{"companyId":"vndb:p428","sourceCompanyId":"vndb:p428","canonicalEntityId":"vndb:p428","name":"MangaGamer","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:73451:v21434","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
