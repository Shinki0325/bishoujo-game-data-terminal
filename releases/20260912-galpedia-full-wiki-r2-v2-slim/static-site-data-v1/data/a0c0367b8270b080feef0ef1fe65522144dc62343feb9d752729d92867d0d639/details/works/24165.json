"マンガ"},{"label":"性格","source":"bangumi","sourceCharacterId":"58566","value":"プライドが高い、押しつけがましい"},{"label":"苦手なもの","source":"bangumi","sourceCharacterId":"58566","value":"異界に関わる人間、怒ったときの主人公"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55bbd41b49250ae029fe15768ddfad0c7e5a7c18bcd361bce09a4f2d6208ce16.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2dd30fef61625de216286a1afab9c9003e9402c18f340c5eed88b959793066f0.webp","width":146,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山中真尋","creatorId":"vndb:s457","sourcePersonId":"vndb:s457","canonicalEntityId":"vndb:s457","name":"山中 真尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197401:58566:5602:1","source":"bangumi"}]},{"characterId":"char_c55259","characterName":"篠田 洸太","sourceIds":{"bangumi":[{"characterId":"58567","match":"exact-normalized-name-in-linked-work","subjectId":"197401"}],"egsCharacterIds":["11361"],"vndbCharacterId":"c55259"},"originalCharacterName":"篠田 洸太","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"19"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An exorcist who helps people troubled by evil spirits and monsters. Blessed with such talent since he was young, he learned many techniques at a young age. He was strange and standoffish as a child, but grew up into a talented exorcist."},{"spoiler":false,"text":"He's a straightforward and honest man, who tries to see the good in everyone. Because of his purity of heart, he can seem a little ditzy at times."}],"source":"vndb","sourceCharacterId":"c55259"},{"segments":[{"spoiler":false,"text":"悪霊やアヤカシに困っている人を助けて回っている祓い師。"},{"spoiler":fals