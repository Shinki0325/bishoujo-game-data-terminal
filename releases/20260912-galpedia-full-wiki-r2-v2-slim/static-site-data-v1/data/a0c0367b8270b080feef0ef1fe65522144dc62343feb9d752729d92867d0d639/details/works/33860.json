rce":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affiliation: Hazuki Private School 2nd year, Group A (Formerly: Satsuki Private Academy)"},{"spoiler":false,"text":"Favorite food: Ice Daifuku"},{"spoiler":false,"text":"Gift: Hyper Highspeed (can think so fast that time literally stops)"},{"spoiler":true,"text":"His Hyper Highspeed isn't actually a gift received from Noah, but one he gained through sheer hard work."}],"source":"vndb","sourceCharacterId":"c10120"},{"segments":[{"spoiler":false,"text":"ある日突然、記憶を失っていた青年。"},{"spoiler":false,"text":"本編の主人公。"},{"spoiler":false,"text":"穏やかな性格で甘いマスクの、他人に優しい性格を持つ。"},{"spoiler":false,"text":"困っている人を放っておけず、厄介事を抱えてしまうお人好し。"},{"spoiler":false,"text":"他の学生たちや教師からも人望を集めていた。"},{"spoiler":false,"text":"――らしい。"},{"spoiler":false,"text":"だが、実際の自分はそんな性格をしていないことに戸惑ぃを覚える。"},{"spoiler":false,"text":"常にイライラし、世界のあり方に疑問を持ち、「聖女様」とやらのために世界が構築されていることに怒りを持つ。"},{"spoiler":false,"text":"だが、妹の光理を心配させない為にも何とかして優しい兄を演じ続ける、そんな日常を送る。"},{"spoiler":false,"text":"だが「メフィスト」と出会い、その言葉を聞いて――。"},{"spoiler":false,"text":"久司朗は記憶を持たないまま、聖女を巡る戦いに身を投じることになるのだった。"}],"source":"egs","sourceCharacterId":"1862","sourceWorkId":"19201","spoiler":false},{"segments":[{"spoiler":false,"text":"ある日突然、記憶を失っていた青年。 本編の主人公。"},{"spoiler":false,"text":"穏やかな性格で甘いマスクの、他人に優しい性格を持つ。"},{"spoiler":false,"text":"困っている人を放っておけず、厄介事を抱えてしまうお人好し。"},{"spoiler":false,"text":"他の学生たちや教師からも人望を集めていた――らしい。"},{"spoiler":false,"text":"だが、実際の自分はそんな性格をしていないことに戸惑っている。"},{"spoiler":false,"text":"世界の在り方に疑問を持ち、“聖女様” とやらのために世界が構築されていることに怒りを覚えている。"},{"spoiler":false,"text":"だが、妹の光理を心配させないためにもなんとかして優しい兄を演じ続ける、そんな日常を送る。"},{"spoiler":false,"text":"しかし “メフィスト” と出会い、その言葉を聞いて――久司朗は記憶を持たないまま、聖女を巡る戦いに身を投じることになるのだった。"},{"spoiler":false,"text":"能力 （ギフト） を持っていないが、それに匹敵するほどの技術である “高速思考（ハイパーハイスピード）” を有している。"},{"spoiler":false,"text":"無数の思考を並行して処理する高度な演算能力。"}],"source":"bangumi","sourceCharacterId":"139893"}],"profileFacts":[{"label":"好物","source":"bangumi","sourceCharacterId":"139893","value":"大福アイス"},{"label":"所属","source":"bangumi","sourceCharacterId":"139893","value":"公立葉月学園 2年A組"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c74d7bd33cc76b0d44ba26771e585eafe9044fae1efa042c2a76f71618cb1867.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1cc8f0b73b553362e9eb7985fbe31181f6780c8d42f1146eccda8967c50c318e.webp","width":90,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柿原徹也","creatorId":"vndb:s80","sourcePersonId":"vndb:s80","canonicalEntityId":"vndb:s80","name":"柿原 徹也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15001:139893:4782:1","source":"bangumi"}]},{"characterId":"char_vndb_c10095","characterName":"明智 光理","sourceIds":{"vndbCharacterId":"c10095"},"originalCharacterName":"明智 光理","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"150"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affiliation: Hazuki Private School 2nd year, Group A"},{"spoiler":false,"text":"Favorite Food: Chocolate Anman"},{"spoiler":false,"text":"Gift: Witch's Library (The ability to create a “Library” full of books with records on how the gifts work)"}],"source":"vndb","sourceCharacterId":"c10095"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0ec2836006da1b3f155d0653685ba6fdd3633189abe8e608b5e86c54fd00ff66.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f806a2aeff6e62fd7a63b21283058b701b88c24317da67fec57e8eb175049f28.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤田 なつ","creatorId":"vndb:s362","sourcePersonId":"vndb:s362","canonicalEntityId":"vndb:s362","name":"福圓 美里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33799","source":"vndb"}]},{"characterId":"char_vndb_c10096","characterName":"葉月 翠名","sourceIds":{"vndbCharacterId":"c10096"},"originalCharacterName":"葉月 翠名","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"C"},"height":{"reviewState":"source-only","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affiliation: Hazuki Private School 2nd year, Group A (Formerly: Satsuki Academy) / Newspaper Club"},{"spoiler":false,"text":"Favorite food: Strawberry chocolate"},{"spoiler":false,"text":"Gift: Logical Dash (the ability to see the future, but this future prediction is based on what would “logically” happen in the future)"},{"spoiler":false,"text":"Suina is the president of the newspaper club and the daughter of the headmaster of the school. In her Route, she was selected as one of the 3 candidates for the World President Election. Joining the newspaper club the easiest plan Kyuushiro can think of, because the girls in this school are acquainted to him, and the more likely easier it is to manipulate them."},{"spoiler":false,"text":"She's suspicious of Kyuushiro's actions. Back in their Satsuki school days, Suina was already in love with Kyuushiro and because of that, she tended to read into Kyuushiro’s future, and after Hikari’s arrival, she was not able to see into his future anymore."},{"spoiler":false,"text":"From Visual Novel Spam"}],"source":"vndb","sourceCharacterId":"c10096"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2d62aeae6a08227576ce61102decdc81f821c239b2180bbb590d43aa62b2d6e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e08719e47af6b350430ae3f331f2f299d3a74c5c90eecb7ab2e00382d1b9b42.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"斉藤 愛子","creatorId":"vndb:s858","sourcePersonId":"vndb:s858","canonicalEntityId":"vndb:s858","name":"神田 理江","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33805","source":"vndb"}]},{"characterId":"char_vndb_c10097","characterName":"サクラ＝ウィンザー","sourceIds":{"vndbCharacterId":"c10097"},"originalCharacterName":"サクラ＝ウィンザー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affiliation: Hazuki Private School 2nd year, Group B (Formerly: St. July Girls' School)"},{"spoiler":false,"text":"Favorite Food: Chocolate sticks"},{"spoiler":false,"text":"Gift: Update (the ability to repair broken things, but in return, you lose something)"},{"spoiler":false,"text":"Sakura is a half-Japanese, half-British girl from St. July Private School and Iris' older sister. Like Suina, she was selected as one of the 3 candidates for the World President Election. She belongs to a royal family in Europe, so she led a sad life because of social status and her gift. However, she has a weird obsession with Noah. Sakura has so much grace and nobility to be called one of the treasures of St. July Private School. Likes acting as the tsukkomi in any situation. Due to her gift, she's quite handicapped. Her gift is similar to healing, but it's really dangerous when used numerous times."},{"spoiler":false,"text":"From Visual Novel Spam"}],"source":"vndb","sourceCharacterId":"c10097"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b185ef8f8307f70e6dffaf3a06f8468c7e71c4f32f57a8f683c47ff38658e4b3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e652d01b47276faaca6a8417731a1a2aea0f0ee4bee2126632e09a5ec25f448d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真中 海","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33804","source":"vndb"}]},{"characterId":"char_vndb_c10098","characterName":"時雨里 姫乃","sourceIds":{"vndbCharacterId":"c10098"},"originalCharacterName":"時雨里 姫乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"75"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"AA"},"height":{"reviewState":"source-only","source":"vndb","value":"144"},"hip":{"reviewState":"source-only","source":"vndb","value":"75"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affiliation: Hazuki Private School 1st year, Group A (Formerly: Minazuki Government School)"},{"spoiler":false,"text":"Favorite food: Cinnamon cookies"},{"spoiler":false,"text":"Gift: Iron Maiden (The ability to be invulnerable to physical and mental damage by hardening the body and the mental strength)"},{"spoiler":false,"text":"Himeno is the Student Council President of Minazuki Government School, which means she's one of the candidates who'll compete with Suina and Sakura for World Presidency. However, she has a different motive of obtaining Noah: they wanted to destroy Noah. Her gift, Iron Maiden has a weakness. She can not swim, because she will sink. She is also weak to poison gas because the gas will damage her internally."},{"spoiler":false,"text":"From Visual Novel Spam"}],"source":"vndb","sourceCharacterId":"c10098"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6efa6d05127c1ef29fa91f827445a3632365d85442a693ee8d57c6041edf1082.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31cbd5f3c726d3f91e8bf7a0192956cc8bd60e9b17ba1522ec37afcfa55cd77c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雲雀 鈴愛","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33808","source":"vndb"}]},{"characterId":"char_vndb_c10099","characterName":"光明寺 夢子","sourceIds":{"vndbCharacterId":"c10099"},"originalCharacterName":"光明寺 夢子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"F"},"height":{"reviewState":"source-only","source":"vndb","value":"167"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affiliation: Hazuki Private School 1st year, Group A (Formerly: Satsuki Academy)"},{"spoiler":false,"text":"Favorite food: Nikuman"},{"spoiler":false,"text":"Gift: Third Eye (the ability to avoid any attacks as long as the body feels that the attack is hostile against her)"},{"spoiler":false,"text":"Another member of Suina's newspaper club. A freshman, her job is to run around collecting information, and report everything to Suina, so she's like a scout. A really energetic heroine, and a bit of an airhead. Her family is famous for their Martial Arts, and it goes well with her Third Eye."},{"spoiler":false,"text":"From Visual Novel Spam"}],"source":"vndb","sourceCharacterId":"c10099"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef09c48bd3ff427c1da838fac7e7c43582728fbdaea28bff9d66c7ca3bc6c380.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52d37e2f24382c44a10806b8012993e8e8b7bcca5a76c0bce8e2e9e7212c5894.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"日比谷 小桃","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33809","source":"vndb"}