:"vndb:s42541","name":"猫原 まお","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:115223","source":"vndb"},{"creditedName":"猫原 まお","creatorId":"vndb:s42541","sourcePersonId":"vndb:s42541","canonicalEntityId":"vndb:s42541","name":"猫原 まお","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:115224","source":"vndb"}]},"cast":[{"characterId":"char_c25021","characterName":"来生 蓉子","sourceIds":{"bangumi":[{"characterId":"200419","match":"exact-normalized-name-in-linked-work","subjectId":"222761"}],"egsCharacterIds":["5955"],"vndbCharacterId":"c25021"},"originalCharacterName":"来生 蓉子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"64"}},"descriptions":[{"segments":[{"spoiler":false,"text":"基本的におっとり。ちょっと世間とズレた感覚がある。"},{"spoiler":false,"text":"学生時代1学年上のお嬢様にペットとしてディープな調教を受け続け"},{"spoiler":false,"text":"そして捨ててしまわれた過去を持つ。"},{"spoiler":false,"text":"そんなところに舞い込んだお見合い話にうっかり乗って真面目しか取り柄のない面白味の欠片もない男と結婚。"},{"spoiler":false,"text":"子供ができて以降、ただでさえ希薄だった夫婦の中は更に希薄になり、間もなく夫はジャカルタに長期単身赴任となる。"},{"spoiler":false,"text":"常に爆発寸前の変態性癖を隠して生活してきたが、夫の不在と息子に手がかからなくなってきた事もあって今は息子不在の昼間に快楽を貪欲に求めて一人変態プレイを延々と続けている。"},{"spoiler":false,"text":"普段の笑顔の下には渇きにも似た猛烈な性欲を秘め、雌としての本能を滾らせている。"}],"source":"egs","sourceCharacterId":"5955","sourceWorkId":"21258","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の母親。 おっとりしていて、少し世間とズレた感覚を持っている。"},{"spoiler":false,"text":"学生時代にお嬢様からペットとしてディープな調教を受け続け、そのうえ捨てられてしまう。"},{"spoiler":false,"text":"そんな時に振られたお見合い話に乗ってマジメなだけの男と結婚してしまい、牝としての欲求を燻らせることに。"},{"spoiler":false,"text":"子供に手が掛からなくなり、夫も長期の単身赴任となった今、昼間は貪欲に快楽を求めて一人で変態プレイを続けている。"}],"source":"bangumi","sourceCharacterId":"200419"}],"profileFacts":[{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"5955","sourceWorkId":"21258","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"5955","sourceWorkId":"21258","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"5955","sourceWorkId":"21258","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"5955","sourceWorkId":"21258","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"64 cm","valueContext":null,"source":"egs","sourceCharacterId":"5955","sourceWorkId":"21258","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc2f97862f6cc2463e8ab336acd1b70db7df1a80751e362d825ec45996d013b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5eaa69faf8e3dc32ae9b61009ced0f4dfaeb9be2168b1fc29443aee8e3ef3485.webp","width":96,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひろは","creatorId":"vndb:s7115","sourcePersonId":"vndb:s7115","canonicalEntityId":"vndb:s7115","name":"ひろは","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:61578","source":"vndb"}]},{"characterId":"char_vndb_c25203","characterName":"来生 健人","sourceIds":{"vndbCharacterId":"c25203"},"originalCharacterName":"来生 健人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandida