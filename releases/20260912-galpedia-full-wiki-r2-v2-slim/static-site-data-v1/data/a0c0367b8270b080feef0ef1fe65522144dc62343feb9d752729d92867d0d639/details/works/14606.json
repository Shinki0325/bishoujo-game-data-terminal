兴趣","source":"bangumi","sourceCharacterId":"11276","value":"读书、DVD鉴赏（除恐怖片以外）"},{"label":"特技","source":"bangumi","sourceCharacterId":"11276","value":"全部家务"},{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"10957","sourceWorkId":"14606","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"149 cm","valueContext":null,"source":"egs","sourceCharacterId":"10957","sourceWorkId":"14606","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"10957","sourceWorkId":"14606","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"10957","sourceWorkId":"14606","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4fb17355b86d9e0343e987e735fada9bacc6c1414b76e0e7815b7e2ab518f4e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48287c08feb71510c415fde0089815eb2ec48e430bc109b694f2a003f18f8d72.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12100:11276:6016:1","source":"bangumi"}]},{"characterId":"char_c44304","characterName":"フランチェスカ＝フジシロ","sourceIds":{"bangumi":[{"characterId":"11278","match":"exact-normalized-name-in-linked-work","subjectId":"12100"}],"egsCharacterIds":["10959"],"vndbCharacterId":"c44304"},"originalCharacterName":"フランチェスカ＝フジシロ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"328"},"bloodType":{"reviewState":"no-conflict","source":"vndb","valu