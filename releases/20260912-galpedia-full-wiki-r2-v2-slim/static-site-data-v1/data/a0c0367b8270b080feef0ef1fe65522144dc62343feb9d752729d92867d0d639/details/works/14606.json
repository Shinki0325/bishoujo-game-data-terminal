o.date/terminal-wiki/v1/characters/v1/images/65/652297ed8942950ca6955e8d008eb60f5faa4e4a62414ec3818a9df053e12b1c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"倉田まりや","creatorId":"vndb:s789","sourcePersonId":"vndb:s789","canonicalEntityId":"vndb:s789","name":"澄田 まりや","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12100:11278:6018:1","source":"bangumi"}]},{"characterId":"char_c44305","characterName":"朝倉 千明","sourceIds":{"bangumi":[{"characterId":"11280","match":"exact-normalized-name-in-linked-work","subjectId":"12100"}],"egsCharacterIds":["10961"],"vndbCharacterId":"c44305"},"originalCharacterName":"朝倉 千明","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"何の仕事をしているのか誰も知らず、毎日多忙の為、あまり家にいない。"},{"spoiler":false,"text":"家にいるときは、主人公をからかって遊んで、そしてまた仕事に向かう。"},{"spoiler":false,"text":"性格は、あまり物にこだわらず大雑把で、細かいことは気にしない。"}],"source":"egs","sourceCharacterId":"10961","sourceWorkId":"14606","spoiler":false},{"segments":[{"spoiler":false,"text":"工作好像是在操办着什么公司，但家人不知情。貌似很忙。"},{"spoiler":false,"text":"不拘小节、大大咧咧的人。"},{"spoiler":false,"text":"平时不会回家，偶尔会心血来潮地回来调戏悠，玩上一通后扬长而去。"},{"spoiler":false,"text":"和セリナ的母亲是亲戚。因为她嫁到国外的时候亲戚一致反对，她就成为了窗口，偷偷地和セリナ的母亲保持着联络。"}],"source":"bangumi","sourceCharacterId":"11280"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"11280","value":"格斗技"},{"label":"特技","source":"bangumi","sourceCharacterId":"11280","value":"在哪里都能睡着、自来熟、天下无敌"},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"10961","sourceWorkId":"14606","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f0adbfecbcff5d3e7f253dc6f9e58efef896cba3a0c7e6510a579165357c857.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/032b58c2210b5f8eb92c26d975292b7ecca9de5b2489b181bb6b1bfba3337a64.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村恵子","creatorId":"vndb:s282","sourcePersonId":"vndb:s282","canonicalEntityId":"vndb:s282","name":"中村 恵子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12100:11280:6020:1","source":"bangumi"}]},{"characterId":"char_c44306","characterName":"高津 涼子","sourceIds":{"bangumi":[{"characterId":"11279","match":"exact-normalized-name-in-linked-work","subjectId":"12100"}],"egsCharacterIds":["10960"],"vndbCharacterId":"c44306"},"originalCharacterName":"高津 涼子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1231"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園3年生の生徒会長。"},{"spoiler":false,"text":"学園内でめちゃくちゃなことをされても強く言えない気弱な女の子。"},{"spoiler":false,"text":"とても「いい人」なので皆から信頼されているが、尊敬はされていない。"},{"spoiler":false,"text":"ある日、危ないところを主人公に助けられる。"}],"source":"egs","sourceCharacterId":"10960","sourceWorkId":"14606","spoiler":false},{"segments":[{"spoiler":false,"text":"武稜学园的3年级学生，学生会长。"},{"spoiler":false,"text":"弱气。在学园内不管被怎么欺侮都只会忍气吞声。可怜的孩子。"},{"spoiler":false,"text":"某一天很危险的时候被悠搭救，但悠并没有特别觉得自己帮到了她。"},{"spoiler":false,"text":"十分普通。家里是面包店。"},{"spoiler":false,"text":"因为是个好人，受到大家的深厚信赖。但并未被尊敬。"}],"source":"bangumi","sourceCharacterId":"11279"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"11279","value":"帮忙家里活、学习"},{"label":"特技","source":"bangumi","sourceCharacterId":"11279","value":"记忆力很好"},{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"10960","sourceWorkId":"14606","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"10960","sourceWorkId":"14606","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"10960","sourceWorkId":"14606","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"10960","sourceWorkId":"14606","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31601098469e89d664ca8f3f8699989bb1debc535dc82764d6cdc730e33645a8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/586bf342d65ac51f562b35d90bc9d98e23c6282ca5e4d8d68a7f011a60e6a3ec.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤宮菜穂","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12100:11279:6019:1","source":"bangumi"}]},{"characterId":"char_c69407","characterName":"ジャンヌ＝イングウェイ","sourceIds":{"bangumi":[{"characterId":"11277","match":"exact-normalized-name-in-linked-work","subjectId":"12100"}],"egsCharacterIds":["10958"],"vndbCharacterId":"c69407"},"originalCharacterName":"ジャンヌ＝イングウェイ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"505"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"通称ジャン。"},{"spoiler":false,"text":"セリナの護衛で主に荒事メインで世話を務める少女。"},{"spoiler":false,"text":"男装は趣味ではなく、主人公の周りに女性がいると機嫌が悪くなるセリナへの配慮。"},{"spoiler":false,"text":"だが、性格自体が男っぽいので、本人はあんまり気にしてない。"}],"source":"egs","sourceCharacterId":"10958","sourceWorkId":"14606","spoiler":false},{"segments":[{"spoiler":false,"text":"武稜学园的2年级学生。"},{"spoiler":false,"text":"因为悠的身边有其他女孩子在的话セリナ就会不高兴，特意女扮男装陪她留学。"},{"spoiler":false,"text":"不过本人的性格也比较像男人，并不怎么在意。"},{"spoiler":false,"text":"出身自贵族，将来已经注定要侍奉在セリナ身边。表情丰富性格开朗，剑术水平一流。"},{"spoiler":false,"text":"悠负责セリナ的家务与贴身事宜，她则负责粗暴行为。"},{"spoiler":false,"text":"彻底沉迷于老早就有兴趣的日本动画文化。"},{"spoiler":false,"text":"「小受、眼镜、西服，这是我想出的三种神器」"},{"spoiler":false,"text":"「虽然你说对同志的话题没有兴趣，但我却想用同志的话题来羞辱你」"},{"spoiler":false,"text":"语调怪异。但比起语调来说为人更怪异。"}],"source":"bangumi","sourceCharacterId":"11277"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"11277","value":"购物"},{"label":"特技","source":"bangumi","sourceCharacterId":"11277","value":"全部粗暴行为"},{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"10958","sourceWorkId":"14606","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"10958","sourceWorkId":"14606","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"10958","sourceWorkId":"14606","source