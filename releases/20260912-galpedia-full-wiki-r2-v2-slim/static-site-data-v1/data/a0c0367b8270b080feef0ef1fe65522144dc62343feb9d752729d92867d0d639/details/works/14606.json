","value":"电视游戏（秘密）"},{"label":"特技","source":"bangumi","sourceCharacterId":"11275","value":"骑马"},{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"10956","sourceWorkId":"14606","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"10956","sourceWorkId":"14606","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"10956","sourceWorkId":"14606","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"10956","sourceWorkId":"14606","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/596193d9e7a80b037ce426c98c1734e29f8f27f53703642a68357c20b8eed7f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/9682ec9a8db6f1d2b52e2292dd945c5d331fc45e835fa41816b58f402dbdfbc1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12100:11275:5922:1","source":"bangumi"}]},{"characterId":"char_c38301","characterName":"セリナ＝コウサカ＝ヴィクセル","sourceIds":{"bangumi":[{"characterId":"11274","match":"exact-normalized-name-in-linked-work","subjectId":"12100"}],"egsCharacterIds":["10955"],"vndbCharacterId":"c38301"},"originalCharacterName":"セリナ＝コウサカ＝ヴィクセル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"226"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ちょっと天然でぽわぽわしたお姫様。"},{"spoiler":false,"text":"甘やかされて育ったため、悪気のないワガママもあるが非を指摘されれば素直に謝る。"},{"spoiler":false,"text":"おおらかな性格で誰からも好かれている。"},{"spoiler":false,"text":"平和主義者の彼女だが、信念や誇りを汚された場合は、その限りではない。"}],"source":"egs","sourceCharacterId":"10955","sourceWorkId":"14606","spoiler":false},{"segments":[{"spoiler":false,"text":"メルベリ公国・公王国王陛下的千金，拥有王位继承权。"},{"spoiler":false,"text":"武稜学园的2年级学生。表面身份是悠的亲戚。"},{"spoiler":false,"text":"喜欢的事物是甜食。还有悠。黏得死死的，不管做什么事都想要依赖悠的人。然而却又不怎么听话。"},{"spoiler":false,"text":"一直以来被娇生惯养着长大，有着天然任性的一面，不过被指出错误之处的话也会道歉。"},{"spoiler":false,"text":"性格坦诚，人见人爱。"},{"spoiler":false,"text":"基本上是和平主义，但是自己的骄傲和信念被玷污的话也会进行对抗。"}],"source":"bangumi","sourceCharacterId":"11274"}],"profileFacts":[{"label":"兴趣","source":"bangumi","sourceCharacterId":"11274","value":"买零食吃、午睡"},{"label":"特技","source":"bangumi","sourceCharacterId":"11274","value":"英语会话"},{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"10955","sourceWorkId":"14606","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"10955","sourceWorkId":"14606","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"10955","sourceWorkId":"14606","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"10955","sourceWorkId":"14606","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09d91094abd5009088c49f8c89202234f2a47aa366f8c3d6c7