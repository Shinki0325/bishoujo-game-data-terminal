{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"6249","model":{"presentationWorkId":"vndb:v3450","staff":{"artwork":[{"creditedName":"羽音るな","creatorId":"vndb:s7527","sourcePersonId":"egs:creator:2620","canonicalEntityId":"vndb:s7527","name":"羽音るな","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:11537","source":"egs"}],"scenario":[{"creditedName":"東トナタ","creatorId":"vndb:s1509","sourcePersonId":"egs:creator:1375","canonicalEntityId":"vndb:s1509","name":"東トナタ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:11538","source":"egs"}],"music":[{"creditedName":"Blueberry&Yogurt(ヨーグルト)","creatorId":"vndb:s297","sourcePersonId":"egs:creator:2959","canonicalEntityId":"vndb:s297","name":"Blueberry&Yogurt(ヨーグルト)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:14273","source":"egs"}],"other":[{"creditedName":"Rita(理多)","creatorId":"vndb:s102","sourcePersonId":"egs:creator:5819","canonicalEntityId":"vndb:s102","name":"Rita(理多)","detail":"OP曲 「パニック☆しんどろーむ！」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:72162","source":"egs"},{"creditedName":"理多","creatorId":"vndb:s102","sourcePersonId":"vndb:s102","canonicalEntityId":"vndb:s102","name":"平井 理子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:43271","source":"vndb"}]},"cast":[{"characterId":"char_c18685","characterName":"馬渡 梓","sourceIds":{"bangumi":[{"characterId":"66446","match":"exact-normalized-name-in-linked-work","subjectId":"262380"}],"egsCharacterIds":["26266"],"vndbCharacterId":"c18685"},"originalCharacterName":"馬渡 梓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"帝嶺学園に通う二年生。"},{"spoiler":false,"text":"主人公と同じクラスに転校してきた。"},{"spoiler":false,"text":"根は優しくて、常識人……、らしい。"},{"spoiler":false,"text":"主人公との出会いが最悪だったため、あまり良い印象を持っていなかったが……。"}],"source":"egs","sourceCharacterId":"26266","sourceWorkId":"6249","spoiler":false},{"segments":[{"spoiler":false,"text":"「この超絶ウルトラミラクル大馬鹿すけべ－－－っ！」"},{"spoiler":false,"text":"二年生。主人公とはクラスメイト。登場キャラ中、一番の常識人。"},{"spoiler":false,"text":"その転校先で主人公にスカートずりおろされるわ、学園改造計画によって校則が厳しくなるわで、散々な目に。"},{"spoiler":false,"text":"主人公と最悪の出会いを果たしており、主人公の思想に共感はするものの、つい意地を張ってしまいパートナーになれない。"},{"spoiler":false,"text":"しかし根は優しい子。"}],"source":"bangumi","sourceCharacterId":"66446"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99dd011ae3cd9e74fe257e791ad11a09d0a8ea3e2d0e295b427c74f7b3bc08e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4aeaeb856b71bb010469e71e92080633daf5b0c051197ea713fc05d2638eb5ab.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結下みちる","creatorId":"vndb:s794","sourcePersonId":"vndb:s794","canonicalEntityId":"vndb:s794","name":"結下 みちる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:262380:66446:4705:1","source":"bangumi"}]},{"characterId":"char_c18687","characterName":"羊崎 みくる","sourceIds":{"bangumi":[{"characterId":"66447","match":"exact-normalized-name-in-linked-work","subjectId":"262380"}],"egsCharacterIds":["26267"],"vndbCharacterId":"c18687"},"originalCharacterName":"羊崎 みくる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"帝嶺学園に通う二年生。"},{"spoiler":false,"text":"主人公の幼馴染にして、クラスメイト。"},{"spoiler":false,"text":"天然にして、何事に対してもマイペース。しかし、周囲をトラブルに巻き込むほどの天性のドジッ娘。"},{"spoiler":false,"text":"主人公にとっては疫病神的な存在。"}],"source":"egs","sourceCharacterId":"26267","sourceWorkId":"6249","spoiler":false},{"segments":[{"spoiler":false,"text":"「私だって、やればできる子なんだよう"},{"spoiler":false,"text":"わ、あいたーっ、うぅぅ、転んじゃったよう」"},{"spoiler":false,"text":"二年生。主人公のクラスメイトで幼馴染。"},{"spoiler":false,"text":"ドジ。とにかくドジ。とてもドジ。"},{"spoiler":false,"text":"しかもそのドジに主人公を激しく巻き込む主人公から見たら疫病神。"},{"spoiler":false,"text":"そんなドジがたたって、退学処分になってしまう。"},{"spoiler":false,"text":"と、そんな訳でパートナー選別からは外されている…が、本人は、主人公の役に立ちたいと、パートナーになりたがる健気な一面も。"}],"source":"bangumi","sourceCharacterId":"66447"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4593e11ebaa64172ffb18b15237c7dfd3d186586ae32e190314c05e163f3756.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae189d238da01ac712294e4d2261f425810c901a635dfbc2c74e33227a57d1d2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:262380:66447:4463:1","source":"bangumi"}]},{"characterId":"char_c18730","characterName":"兎塚 詩和","sourceIds":{"bangumi":[{"characterId":"66448","match":"exact-normalized-name-in-linked-work","subjectId":"262380"}],"egsCharacterIds":["26268"],"vndbCharacterId":"c18730"},"originalCharacterName":"兎塚 詩和","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"帝嶺学園に通う一年生。主人公の後輩。"},{"spoiler":false,"text":"財閥の令嬢で、慎ましくも礼儀正しく、しかしたまに毒舌が飛ぶ。"},{"spoiler":false,"text":"校則を変えようと立ち上がった主人公の熱意に感動し、パートナーとして立候補する。"},{"spoiler":false,"text":"色々と主人公に協力的だが、何か裏がありそうな……。"}],"source":"egs","sourceCharacterId":"26268","sourceWorkId":"6249","spoiler":false},{"segments":[{"spoiler":false,"text":"「先輩のまったくもって何も考えてないとこ、好きです」"},{"spoiler":false,"text":"一年生。乃空、椿とは別クラス。"},{"spoiler":false,"text":"「こーそくシステム」に挑戦しようとする主人公のため、パートナーに志願する。"},{"spoiler":false,"text":"基本的には礼儀正しく大人しい女の子だが、ときどき毒舌に。"}],"source":"bangumi","sourceCharacterId":"66448"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba79831db0ba54be337bb1cb5a9a40f4efcfdb1690ea7ceadf31437af941060e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90017c8d2b545bf8df005e23a1cc77d376afabc6db817bc25e9639d008a27561.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:262380:66448:4832:1","source":"bangumi"}]},{"characterId":"char_c18731","characterName":"鳥羽 乃空","sourceIds":{"bangumi":[{"characterId":"66450","match":"exact-normalized-name-in-linked-work","subjectId":"262380"}],"egsCharacterIds":["26270"],"vndbCharacterId":"c18731"},"originalCharacterName":"鳥羽 乃空","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"帝嶺学園に通う一年生。主人公の後輩。"},{"spoiler":false,"text":"いつもとろ～んと眠そうにしている女の子。"},{"spoiler":false,"text":"実際、眠いらしく、気付くと寝息を立てている。"},{"spoiler":false,"text":"そんな彼女の作りたい校則とは……!?"}],"source":"egs","sourceCharacterId":"26270","sourceWorkId":"6249","spoiler":false},{"segments":[{"spoiler":false,"text":"「くーくー、ただいま寝ているため、"},{"spoiler":false,"text":"お話できません、くーくー」"},{"spoiler":false,"text":"一年生。詩和とは別クラス。椿とは同じクラス。"},{"spoiler":false,"text":"万年、眠いヒロイン。気づくと寝ている。"},{"spoiler":false,"text":"ぼーっとしていて、何を考えているのかは謎。"},{"spoiler":false,"text":"だが、あまりに寝すぎるので、授業のほうがピンチに。"},{"spoiler":false,"text":"そんな訳で、いつどこでも、寝ていていい校則を作りたいと思っていたらしい。"}],"source":"bangumi","sourceCharacterId":"66450"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/441743cf1c1f0823e8cf03df4d1ee9e77c4dcdd5fcbc4d49621284186beee6bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/9753fcd4c45801e79e8dbc8e69f2bb14ba2f4943faf3075f5e499c14b10c1f00.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:262380:66450:4810:1","source":"bangumi"}]},{"characterId":"char_c18732","characterName":"猫山 美々子","sourceIds":{"bangumi":[{"characterId":"66449","match":"exact-normalized-name-in-linked-work","subjectId":"262380"}],"egsCharacterIds":["26269"],"vndbCharacterId":"c18732"},"originalCharacterName":"猫山 美々子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"帝嶺学園に通う三年生。主人公の先輩。"},{"spoiler":false,"text":"トンデモ校則によって、ネコミミを付けて生活を余儀なくされた女の子。"},{"spoiler":false,"text":"あだ名も、名前からもじったのか、その姿からなのか、まんま「ネコミミ」。"},{"spoiler":false,"text":"残り少ない学園生活をネコミミ無しで過ごしたいと強く思い、主人公とペアを組んで戦いたいと……。"}],"source":"egs","sourceCharacterId":"26269","sourceWorkId":"6249","spoiler":false},{"segments":[{"spoiler":false,"text":"「ネコミミって呼ぶなぁーっ！」"},{"spoiler":false,"text":"あだ名はネコミミ。理由は、ずばりネコミミをつけているから。"},{"spoiler":false,"text":"しかし、それは彼女の趣味などではなく、学校の校則により猫耳着用が義務付けられているため。"},{"spoiler":false,"text":"過去、猫耳が好きで好きでたまらなかったカップルによって、作られた猫耳着用校則。他人に迷惑をかけないよう「名前が“猫山 美々子”という名前であること」という、まずありえない条件を付けたのだが、みごとに彼女にあてはまってしまったらしい。"}],"source":"bangumi","sourceCharacterId":"66449"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e70a3fc5519b4cb1bcdeaf9a3e06ecbc7caa3663119c996c9874f18d96e3c20f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb7ae66c2353dc7c0b493d91011248b34fd5088e70ab61eb0ee22a2fe606f4dd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜庭わかな","creatorId":"vndb:s807","sourcePersonId":"vndb:s807","canonicalEntityId":"vndb:s807","name":"桜庭 わかな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:262380:66449:11261:1","source":"bangumi"}]},{"characterId":"char_vndb_c102464","characterName":"不動 大樹","sourceIds":{"vndbCharacterId":"c102464"},"originalCharacterName":"不動 大樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8069661c6fa2264bd44f0e6a2d648710e4b195611247068c45f72aa0efbc410.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18346fb1c22f2c401904ecb216f25b78530392cbdf6bd3febc4f1d379997b2c2.webp","width":223,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p78","sourceCompanyId":"egs:brand:572","canonicalEntityId":"vndb:p78","name":"Tarte","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:6249:572","source":"egs"},{"companyId":"vndb:p78","sourceCompanyId":"vndb:p78","canonicalEn