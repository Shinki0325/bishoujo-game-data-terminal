rceCharacterId":"c57060"},{"segments":[{"spoiler":false,"text":"望（主人公）の幼馴染の女の子。一見地味で物静かだが、明るい性格。"},{"spoiler":false,"text":"望に対しては淡い好意を抱いており、卒業を間近にして友人に背中を押され、望と期間限定の同棲を始める。"},{"spoiler":false,"text":"初めは一緒にいられるだけで……と思っているが、同棲生活をする中で望に対する気持ちが大きくなっていくのを自覚していく。"}],"source":"egs","sourceCharacterId":"13084","sourceWorkId":"24434","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・望の幼なじみの女の子。 一見地味で物静かだが、明るい性格。"},{"spoiler":false,"text":"望に対しては淡い好意を抱いており、卒業を間近にして友人に背中を押され、"},{"spoiler":false,"text":"望と期間限定の同棲を始める。"},{"spoiler":false,"text":"初めは一緒に居られるだけで…… と思っているが、同棲生活をする中で"},{"spoiler":false,"text":"望に対する気持ちが大きくなっていくのを自覚していく。"},{"spoiler":false,"text":"「そのっ……！　わ、私の……私の家で一緒に暮らしてみない!?」"}],"source":"bangumi","sourceCharacterId":"50632"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb8c8a41596ae6652c34f2ce344b2c9d2327161074b210590366178d6007119b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a23924b23c2cdced3e416d96182e927e5d6f998c502f10e544f0f1ef489369c4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間宮菜南子","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:196964:50632:15995:1","source":"bangumi"}]},{"characterId":"char_vndb_c69021","characterName":"春原 望","sourceIds":{"vndbCharacterId":"c69021"},"originalCharacterName":"春原 望","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nozomu is the childhood friend of Shiori. As soon as he graduates, Nozomu will start living alone to go to university but having never lived alone until now, he d