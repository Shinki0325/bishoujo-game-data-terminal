urce":"egs","sourceCharacterId":"16218","sourceWorkId":"11615","spoiler":false},{"segments":[{"spoiler":false,"text":"明朗快活、頭脳明晰な少女。"},{"spoiler":false,"text":"飛びぬけた頭の良さが原因で理不尽なイジメに遭い、学園にやってくることになった。"},{"spoiler":false,"text":"学園に来てからは友達もたくさんできて、本人も満足している。"},{"spoiler":false,"text":"何に対しても好奇心旺盛な性格。ノリがよくて感情表現が激しい。"},{"spoiler":false,"text":"堅実な地道さと脊髄反射的な行動力を併せ持っているため、どこかつかみどころがない。"}],"source":"bangumi","sourceCharacterId":"37863"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3dd34634fe740f25b7260469ffd126e83c44df66fcd4927dfb55693c74cadfe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffe8bf0538d2d7a23ad2383787ac06426434104195d5cd821fb326933c919dbd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154940:37863:5936:1","source":"bangumi"}]},{"characterId":"char_c50458","characterName":"伊勢谷 菜巳","sourceIds":{"bangumi":[{"characterId":"37864","match":"exact-normalized-name-in-linked-work","subjectId":"154940"}],"egsCharacterIds":["16219"],"vndbCharacterId":"c50458"},"originalCharacterName":"伊勢谷 菜巳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【お嬢様気質のツンツン娘】"},{"spoiler":false,"text":"父が大物政治家で何不自由無く生活していた女の子。"},{"spoiler":false,"text":"しかし、隠し子である事が知られ居場所が無くなってしまった。"},{"spoiler":false,"text":"主人公に見覚えがある気がして、気になって仕方が無い。"},{"spoiler":false,"text":"叱ってくれる主人公に父性を見出す。"},{"spoiler":false,"text":"家族の愛情に飢えている？"},{"spoiler":false,"text":"「私だってヒマじゃないのよ？　いい迷惑なんだから」"}],"source":"egs","sourceCharacterId":"16219","sourceWorkId":"11615","spoiler":false},{"segments":[{"spoiler":false,"text":"ある大物政治家の娘。"},{"spoiler":false,"text":"実は妾との子であり、父からの支援を受けつつ母親とふたりで不自由のない生活を送っていた。"},{"spoiler":false,"text":"しかし父親の不祥事がマスコミにより発覚すると、隠し子である自分の存在も世間に知れ渡ってしまう。"},{"spoiler":false,"text":"そして居場所を失った菜巳は、逃げるように学園へとやってきた。"}],"source":"bangumi","sourceCharacterId":"37864"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d338488a68c799fdb5a8cf72cc138a19ca3e86ad439895c2ef8d6d4bc6ce25d9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72abfc094d5da7ce7b2bba6d7ae171c14f26ebd182aae5900773240e7e6ddaa4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新堂真弓","creatorId":"vndb:s1427","sourcePersonId":"vndb:s1427","canonicalEntityId":"vndb:s1427","name":"新堂 真弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154940:37864:6166:1","source":"bangumi"}]},{"characterId":"char_c50460","characterName":"白山 アイリス 紡","sourceIds":{"bangumi":[{"characterId":"37865","match":"exact-normalized-name-in-linked-work","subjectId":"154940"}],"egsCharacterIds":["16220"],"vndbCharacterId":"c50460"},"originalCharacterName":"白山 アイリス 紡","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【金髪ロングヘアーの大和撫子】"},{"spoiler":false,"text":"学生離れしたプロポーションを持つハーフの女の子。"},{"spoiler":false,"text":"プロポーションとハーフである事でセクハラを受けていた。"},{"spoiler":false,"text":"落ち着いた物腰の主人公とは自然に会話が出来、もっと話を聞いて欲しいと思う。"},{"spoiler":false,"text":"良く躾けられた正に大和撫子。"},{"spoiler":false,"text":"しかし、その躾けに反し、おもらしに快感を覚えてしまう事も？"},{"spoiler":false,"text":"「殿方をお待ちするのは当然ですので」"}],"source":"egs","sourceCharacterId":"16220","sourceWorkId":"11615","spoiler":false},{"segments":[{"spoiler":false,"text":"見事なサラサラストレートロングの金髪と、宝石のような碧眼を持つ日米ハーフの娘。愛称は 「アリス」。"},{"spoiler":false,"text":"学生離れしたプロポーションを持っており、背が高く巨乳であるが、その胸が本人の一番の悩み。"},{"spoiler":false,"text":"巨乳を隠すために普段はブラではなく、サラシを巻いている。"}],"source":"bangumi","sourceCharacterId":"37865"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/4372637501c31b25a4545c202d9d6301d15ce7b21bd319d61e6d5d3186b7551b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bfe3651897a7cd27a8df802390b9e977896a18a53953de60c38c9a083018431d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154940:37865:4463:1","source":"bangumi"}]},{"characterId":"char_c50461","characterName":"此花 咲耶","sourceIds":{"bangumi":[{"characterId":"37866","match":"exact-normalized-name-in-linked-work","subjectId":"154940"}],"egsCharacterIds":["16221"],"vndbCharacterId":"c50461"},"originalCharacterName":"此花 咲耶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【頼りになる保健室の先生】"},{"spoiler":false,"text":"主人公の同僚で、保健室の先生。"},{"spoiler":false,"text":"きっちり仕事の出来る、明るく優しい頼りになる女性。"},{"spoiler":false,"text":"学生達にも好かれている。"},{"spoiler":false,"text":"主人公や女の子が迷っていると、優しくそっと背中を押してくれる。"},{"spoiler":false,"text":"主人公に好意を持っているが、中々気付いてもらえない。"},{"spoiler":false,"text":"色々伝えたい事があるようだが……。"},{"spoiler":false,"text":"「いつでも相談に乗るっすよー？」"}],"source":"egs","sourceCharacterId":"16221","sourceWorkId":"11615","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の同僚である、保健室の先生。"},{"spoiler":false,"text":"キッチリと仕事ができ、明るく優しく頼りになる女性。主人公もちょっと尊敬している。"},{"spoiler":false,"text":"お互いに大学時代から面識があり、彼女自身も主人公にかなりの好意を持っている。"},{"spoiler":false,"text":"今回の潜入カウンセリングの件と、主人公の正体を知っている数少ない一人。"}],"source":"bangumi","sourceCharacterId":"37866"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90aabefd2f11297627d51bba94874457d8cb7191f667b3c703f5efa22448e1f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd0ac6fe516f35bdca3565c70595d06ae47804620f0edfcd57ce6fde13798cea.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154940:37866:6106:1","source":"bangumi"}]},{"characterId":"char_c50462","characterName":"此花 詠美","sourceIds":{"bangumi":[{"characterId":"37867","match":"exact-normalized-name-in-linked-work","subjectId":"154940"}],"egsCharacterIds":["16222"],"vndbCharacterId":"c50462"},"originalCharacterName":"此花 詠美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【感情表現が下手な少女】"},{"spoiler":false,"text":"感情表現が苦手で無口な女の子。咲耶の妹。"},{"spoiler":false,"text":"コミュニケーション能力に問題があり、他人を怖がってしまう。"},{"spoiler":false,"text":"初めて会った主人公と、会話どころか一緒に登校すら出来た事を本人も不思議に思っている。"},{"spoiler":false,"text":"自分を変えたいと思ってはいるが……。"},{"spoiler":false,"text":"「人と話すのが、苦手なんです」"}],"source":"egs","sourceCharacterId":"16222","sourceWorkId":"11615","spoiler":false},{"segments":[{"spoiler":false,"text":"咲耶の妹。"},{"spoiler":false,"text":"感情表現が下手で、かなり無口な少女。存在感も薄く、気が付くと背後にいたりする。"},{"spoiler":false,"text":"性格は天然ボケ系。脈略なく話が飛ぶため、初めて接する人はちょっと取っ付きづらい。"},{"spoile