urce":"vndb"}]},"cast":[{"characterId":"char_c13057","characterName":"月丘 泉","sourceIds":{"bangumi":[{"characterId":"21803","match":"exact-normalized-name-in-linked-work","subjectId":"73743"}],"egsCharacterIds":["1818"],"vndbCharacterId":"c13057"},"originalCharacterName":"月丘 泉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Key Emotion: Curiosity"},{"spoiler":false,"text":"Rank: S-rank"},{"spoiler":false,"text":"Izumi is Yuuji's childhood friend and classmate who is a carrier, carrying Rapunzel's spirit inside her. Her family is wealthy, and she is often treated around like a real princess to the extent where she was practically confined to her house. Due to this, she wasn't able to satisfy her curiosity, and to Izumi's luck (or misfortune), her trigger emotion is \"curiosity\". Being an “S-ranked Princess”, which means she is extremely dangerous, this curiosity transforms her into a wild and frantic girl craving to satisfy her desire to learn, and usually involves attacking the people who get in her way with her hair."},{"spoiler":true,"text":"She later turns into an SS-ranked princess, and gains the ability to make the world loop (in other words, cause time loops)."}],"source":"vndb","sourceCharacterId":"c13057"},{"segments":[{"spoiler":false,"text":"学園二年生。祐二とは同じクラス。"},{"spoiler":false,"text":"昔、祐二の家の近くに住んでいたこともあり、幼馴染である。"},{"spoiler":false,"text":"少々常識知らずなところがあったり、快活で破天荒な“演技染みた”語り口を稀にする。"},{"spoiler":false,"text":"彼女は超ＶＩＰな良家のご令嬢であり、いわゆる箱入り娘。"},{"spoiler":false,"text":"今まで外の世界というものを見たことがなかった為、世間ズレしてしまっている。"},{"spoiler":false,"text":"女の子らしく甘い物が大好き。そして大食い。"},{"spoiler":false,"text":"本当は直情的かつ多感で素直だが、祐二に対してはそうなれないことも多い。"},{"spoiler":false,"text":"彼女に住む＜お姫さま＞は、＜ラプンツェル＞。"},{"spoiler":false,"text":"自身の「好奇心」が刺激されることによって発現する。"},{"spoiler":false,"text":"島にも二人しかいないＳ級の＜お姫さま病【プリンセスシンドローム】＞であり、強力な＜望奏【メルヘン】＞、＜伸長の髪縛り【ヘアー・ザ・ロック】＞を使い、周囲の人や物を縛り上げる。"},{"spoiler":false,"text":"変貌時は無邪気で傍若無人になる。"}],"source":"egs","sourceCharacterId":"1818","sourceWorkId":"19081","spoiler":false},{"segments":[{"spoiler":false,"text":"学園二年生。祐二とは同じクラス。"},{"spoiler":false,"text":"昔、祐二の家の近くに住んでいたこともあり、幼なじみである。"},{"spoiler":false,"text":"少々常識知らずなところがあったり、快活で破天荒な “演技じみた” 語り口を稀にする。"},{"spoiler":false,"text":"彼女は超VIPな良家のご令嬢であり、いわゆる箱入り娘。"},{"spoiler":false,"text":"今まで外の世界というものを見たことがなかったため、世間ズレしてしまっている。"},{"spoiler":false,"text":"女の子らしく甘い物が大好き。そして大食い。"},{"spoiler":false,"text":"本当は直情的かつ多感で素直だが、祐二に対してはそうなれないことも多い。"},{"spoiler":false,"text":"彼女に住む “お姫さま” は “ラプンツェル”。 自身の “好奇心” が刺激されることによって発現する。"},{"spoiler":false,"text":"島にも2人しかいないS級の “お姫さま病（プリンセスシンドローム）” であり、強力な “望奏（メルヘン）” 伸長の髪縛り（ヘアー・ザ・ロック） を使い、周囲の人や物を縛り上げる。"},{"spoiler":false,"text":"変貌時は無邪気で傍若無人になる。"},{"spoiler":false,"text":"「……今日も一日、欲しがらない。 求めなければ、大丈夫」"}],"source":"bangumi","sourceCharacterId":"21803"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"1818","sourceWorkId":"19081","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"1818","sourceWorkId":"19081","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"1818","sourceWorkId":"19081","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"1818","sourceWorkId":"19081","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","s