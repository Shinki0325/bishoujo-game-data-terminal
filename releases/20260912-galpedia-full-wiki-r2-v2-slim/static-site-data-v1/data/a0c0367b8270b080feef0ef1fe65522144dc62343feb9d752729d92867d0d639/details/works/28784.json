働いている。"},{"spoiler":false,"text":"いまだに学生気分が抜けきらない年下夫のことで思い悩んでいた時に、"},{"spoiler":false,"text":"かつて憧れていた主人公と再会し……。"},{"spoiler":false,"text":"「あ……でもそれって、今は私を女として見てくれてるって、そういうことですよね？」"}],"source":"bangumi","sourceCharacterId":"65237"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/394d6195bc073874ff6e2f861dc075042fe12d25da6db48aa5c799399506a405.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90dd5264ebb17de3ed067a1b125ecb597f94ca0881f5b126f8feb446d8433588.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"広深香菜","creatorId":"vndb:s5646","sourcePersonId":"vndb:s5646","canonicalEntityId":"vndb:s5646","name":"広深 香菜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:249913:65237:20485:1","source":"bangumi"}]},{"characterId":"char_vndb_c73698","characterName":"藤木 翔真","sourceIds":{"vndbCharacterId":"c73698"},"originalCharacterName":"藤木 翔真","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An ordinary businessman."},{"spoiler":false,"text":"He had feelings for Mai who was his trainer but after completing his training she got married so he gave up on her."},{"spoiler":false,"text":"He was also close with his junior, Satone, from his student days but after graduation they feel out of contact."}],"source":"vndb","sourceCharacterId":"c73698"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p212","sourceCompanyId":"egs:brand:516","canonicalEntityId":"vndb:p212","name":"Anim","roleCodes":["brand"],"identityStatus":"auto-confirmed",