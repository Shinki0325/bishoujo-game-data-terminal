{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"30146","model":{"presentationWorkId":"vndb:v29410","staff":{"artwork":[{"creditedName":"なお","creatorId":"vndb:s13613","sourcePersonId":"egs:creator:19516","canonicalEntityId":"vndb:s13613","name":"なお","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:286834","source":"egs"}],"scenario":[{"creditedName":"なお","creatorId":"vndb:s13613","sourcePersonId":"egs:creator:19516","canonicalEntityId":"vndb:s13613","name":"なお","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:286835","source":"egs"}],"music":[],"other":[{"creditedName":"なお","creatorId":"vndb:s13613","sourcePersonId":"vndb:s13613","canonicalEntityId":"vndb:s13613","name":"なお","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:169599","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c78132","characterName":"檜山 美紗緒","sourceIds":{"vndbCharacterId":"c78132"},"originalCharacterName":"檜山 美紗緒","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A high school girl who has yet to know love."},{"spoiler":false,"text":"He lives together with her mother in a fatherless home."},{"spoiler":false,"text":"She lives wild and free, and hates studying."},{"spoiler":false,"text":"Possibly because of perceived inferiority of living in the countryside, she has dyed her hair and likes to show off, but deep down she is kind and takes people's feeling into account before acting. However, she gets embarrassed when praised like she doesn't want to show that side of her."},{"spoiler":false,"text":"She often acts in a half-hearted manner as if things were out of her control."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c78132"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5efbb103f7fa91b837c856ff5192ff9ac7fd8326d86d6639a4136c25648494b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36efa1351764022734a301b3272132fb068872299113e760b31d755279fee9ce.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c78133","characterName":"馬場 楓","sourceIds":{"vndbCharacterId":"c78133"},"originalCharacterName":"馬場 楓","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Misao's childhood friend. He tends give an impression of a deliquent, but he is well-mannered and his dyed hair was only him following Misao's example. Studying is no problem to him either. He has a complex over his gender-neutral name \"Kaede.\""},{"spoiler":false,"text":"He hates how his father is fully compliant with his landowner uncle, and his next step in life is to enter a university in a city and move away from Anoyama."},{"spoiler":false,"text":"He thinks that Misao's inability to know how to love someone due to a certain reason is his own fault."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c78133"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cd73fa94927c37a0df3331cce1d07de41f51604f174b2c1f5c262463a1f3ee0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0e6dc80bf3296e8c6d6537d97a3bc9a3e4530c038f048d0d7f905550b83c80d.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c78182","characterName":"八神 塔子","sourceIds":{"vndbCharacterId":"c78182"},"originalCharacterName":"八神 塔子","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The owner of the cafe \"Stardust.\""},{"spoiler":false,"text":"The cafe was originally founded by her husband, but just when things were looking bright, he departed this world."},{"spoiler":false,"text":"She was at a loss whether to part with the store and start working not just for herself but also to raise her son, but decided not to abandon the store left behind by her husband and took up managing it herself."},{"spoiler":false,"text":"However, her husband's popular coffee blend was no longer available, thus leading to a gradual decrease in customers. The cafe is now a gathering spot for Anoyama's elderly and the sales slump continues, so the business is in a tough spot."},{"spoiler":false,"text":"She has her hands full with the store and is worried that she can't do anything for her son."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c78182"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9edf391095d1aa4d64374de73c15eb4746d8ecba9439204310497a99b243ad7c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4dd9371c309362fbc64639cc0f4609836c026ea2d30b757e67a785b00c502955.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c78855","characterName":"馬場 慶三","sourceIds":{"vndbCharacterId":"c78855"},"originalCharacterName":"馬場 慶三","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kaede's uncle and Anoyama's landowner. His wife passed away and he has been living alone for over a decade."},{"spoiler":false,"text":"For generations the Baba family tree has had pure-blooded Anoyama natives tying the knot, and Keizou too is insistent on having descendants with Anoyama blood in their veins."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c78855"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88d7617cda862e4d2966e9759ea1ee37afc792cef139207951a745b5ab91f6a0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/5304c4db461551690f885f684d41436d372fbf343013303a244a78ef73ba0b27.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c90713","characterName":"檜山 友莉","sourceIds":{"vndbCharacterId":"c90713"},"originalCharacterName":"檜山 友莉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b205112a359933261dca5816aa28d91e2ab33e636cd86880fd02a2f7326fc406.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fe22550889ab72e13cf966a58ca912d5426981294e99dec1409dbcd22a7ffe9.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:2999","sourceCompanyId":"egs:brand:2999","canonicalEntityId":"egs:brand:2999","name":"VENUS","roleCodes":["brand"],"identityStatus":"alias-only-review","rela