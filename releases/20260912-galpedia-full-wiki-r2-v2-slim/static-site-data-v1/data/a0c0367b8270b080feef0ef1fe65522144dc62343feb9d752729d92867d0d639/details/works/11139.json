":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a40b58328f805a6c3a05fa777fa1bcbec0b7623625979f622dfc3ae7fbdc4f73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef98e43c647438d1ebae118943afcc6b58845fe2d508a539b7a6e7216348eb66.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"波多野 和俊","creatorId":"vndb:s6865","sourcePersonId":"vndb:s6865","canonicalEntityId":"vndb:s6865","name":"波多野 和俊","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8064","source":"vndb"}]},{"characterId":"char_c42645","characterName":"フィロメーラ","sourceIds":{"bangumi":[],"egsCharacterIds":["17759"],"vndbCharacterId":"c42645"},"originalCharacterName":"フィロメーラ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ナーヤの食事の世話から退屈しのぎの遊び相手まで、日常の世話全般をこなすメイド。"},{"spoiler":false,"text":"完璧な供給システムの確立した「魔法の世界」では、魔法工学の技術を持たない一般人は、フィロメーラのように技術者のもとで奉公することが多い。"}],"source":"egs","sourceCharacterId":"17759","sourceWorkId":"7026","spoiler":false},{"segments":[{"spoiler":false,"text":"「魔法の世界」の大統領・ナーヤに仕えるメイドさん。"},{"spoiler":false,"text":"本作では「～永遠神剣QUIZ～」のヒロインとして登場。"}],"source":"egs","sourceCharacterId":"17759","sourceWorkId":"11139","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96d0a515801ae1ce0dadaa264c62c0b734dfbe1eba07a6efdb9d56225e34b7b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81e9dec92055273cc5e464bf52a38a106dab55e18af71377816d245de947db04.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"彩世 ゆう","creatorId":"vndb:s57","sourcePersonId":"vndb:s57","canonicalEntityId":"vndb:s57","name":"羽吹 梨里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8050","source":"vndb"}]},{"characterId":"char_c42646","characterName":"レチェレ","sourceIds":{"bangumi":[],"egsCharacterIds":["25909"],"vndbCharacterId":"c42646"},"originalCharacterName":"レチェレ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「精霊の世界」の酒場「バスティル亭」を営む心優しい少女。"},{"spoiler":false,"text":"両親とは既に死別しているが、体調を崩した叔父に代わって店を切り盛りしている。"},{"spoiler":false,"text":"新しい料理のメニューを考え出すのが特技。"},{"spoiler":false,"text":"なお、バスティルとは「精霊の世界」で「どんぐり」を指す。"}],"source":"egs","sourceCharacterId":"25909","sourceWorkId":"7026","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/1672db9d8ee2176e038aff032ddea0d66d4d82d6c0a9935e807b2a7088a7f632.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46e57ea6a4adc12fef3bd070fc19ca7fa5a94cf1b9f047716acb1dd083531ce5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"文月 かな","creatorId":"vndb:s54","sourcePersonId":"vndb:s54","canonicalEntityId":"vndb:s54","name":"文月 かな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8042","source":"vndb"}]},{"characterId":"char_c42656","characterName":"ソルラスカ","sourceIds":{"bangumi":[{"characterId":"11511","match":"exact-normalized-name-in-linked-work","subjectId":"11258"}],"egsCharacterIds":["17754"],"vndbCharacterId":"c42656"},"originalCharacterName":"ソルラスカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"望に対してライバル意識は持つが、すぐに意気投合する「旅団」のメンバー。"},{"spoiler":false,"text":"男として生まれた以上、天下を取りたいと考えている。"},{"spoiler":false,"text":"がさつで乱暴者だが、涙もろく情に篤いまっすぐな性格の持ち主。"},{"spoiler":false,"text":"天然、大食漢、味音痴、どこでも眠れる。"},{"spoiler":false,"text":"五歳年下の妹がいる。"}],"source":"egs","sourceCharacterId":"17754","sourceWorkId":"7026","spoiler":false},{"segments":[{"spoiler":false,"text":"永遠神剣：第六位「荒神」"},{"spoiler":false,"text":"守護神獣：黒き牙"},{"spoiler":false,"text":"がさつ、天然、大食漢（味音痴）、どこでも眠れる乱暴者だが、涙もろくて情に厚い、良くも悪くも「まっすぐ」な男。"},{"spoiler":false,"text":"妹や子分たちが待つ故郷には帰らず、タリアと共に「旅団」に残るが、彼女との関係は、特に進展していない様子。"}],"source":"egs","sourceCharacterId":"17754","sourceWorkId":"11139","spoiler":false},{"segments":[{"spoiler":false,"text":"永远神剑：第六位　『荒神』"},{"spoiler":false,"text":"守护神兽：狼「黑牙」"},{"spoiler":false,"text":"对望报有对手意识，但马上就与其意气相投的「旅団」的成员。"},{"spoiler":false,"text":"认为既然生为男人，就要想着夺取天下。"},{"spoiler":false,"text":"虽然为人粗暴无礼,但同时性格直接重情义易落泪。"},{"spoiler":false,"text":"单细胞、饭量大、味觉白痴、不管哪里都能睡。有一个小自己五岁的妹妹。"}],"source":"bangumi","sourceCharacterId":"11511"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/bee35751456b8173065d32951914084bfdd176c4cc7173f564a9cba813276f3c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5c7ae752590b4973444b0860812d0a7c43003f4b89816d766aac23a3ce7cbd1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木島 宇太","creatorId":"vndb:s52","sourcePersonId":"vndb:s52","canonicalEntityId":"vndb:s52","name":"水島 大宙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8049","source":"vndb"}]},{"characterId":"char_c42657","characterName":"スバル＝セラフカ","sourceIds":{"bangumi":[{"characterId":"11512","match":"exact-normalized-name-in-linked-work","subjectId":"11258"}],"egsCharacterIds":["25902"],"vndbCharacterId":"c42657"},"originalCharacterName":"スバル＝セラフカ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真面目で物腰やわらかな青年。"},{"spoiler":false,"text":"「旅団」の頼れるお兄さん的存在。"},{"spoiler":false,"text":"仲裁やまとめ役を買って出たり、望や沙月、希美の相談にもよく乗ってくれる。"},{"spoiler":false,"text":"争いは嫌いだが、仲間を守るためならば自ら率先して行動する。"},{"spoiler":false,"text":"富民層の息子だが、父親に反発して家を出た過去を持つ。"}],"source":"egs","sourceCharacterId":"25902","sourceWorkId":"7026","spoiler":false},{"segments":[{"spoiler":false,"text":"永远神剑：第六位　『苍穹』"},{"spoiler":false,"text":"守护神兽：狮鹫兽「スパース」"},{"spoiler":false,"text":"为人认真处事圆滑的青年，「旅団」中属于可靠的大哥般的存在。"},{"spoiler":false,"text":"有时会担当仲裁或打圆场的角色，经常开导望及沙月、希美等人。"},{"spoiler":false,"text":"尽管讨厌争斗，但只要是为了保护同伴的话，会由自己率先行动。"},{"spoiler":false,"text":"富人阶级的孩子，但过去因反抗父亲二离家出走了。"}],"source":"bangumi","sourceCharacterId":"11512"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df59415fc52901f444338710a183cd4bf206ddfe01739ebb75acc65e75a00889.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8a74f55c011d61d22450c468a9a36cf586b11fcbb1073a333e8171af64a2fd3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"滑川 菊太郎","creatorId":"vndb:s1819","sourcePersonId":"vndb:s1819","canonicalEntityId":"vndb:s1819","name":"かわむら 拓央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8057","source":"vndb"}]},{"characterId":"char_c6038","characterName":"カティマ＝アイギアス","sourceIds":{"bangumi":[{"characterId":"11502","match":"exact-normalized-name-in-linked-work","subjectId":"11258"}],"egsCharacterIds":["25898"],"vndbCharacterId":"c6038"},"originalCharacterName":"カティマ＝アイギアス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A princess of the fallen kingdom \"Aigers\", who wishes to restore her kingdom and is leading rebel soldiers in \"Sword World\". Katima has a very strong sense of justice, and does not tolerate any evildoing. Because she upholds chivalry, she is very straightforward and dislike using any cowardly acts."},{"spoiler":false,"text":"Katima completely adores Nozomi's Divine Beast, Monobe."}],"source":"vndb","sourceCharacterId":"c6038"},{"segments":[{"spoiler":false,"text":"「剣の世界」で反乱軍の先鋒として戦う亡国の王女。"},{"spoiler":false,"text":"正義感がとても強く、悪は決して許さない。"},{"spoiler":false,"text":"卑怯なことを好まず、騎士道精神を重んじすぎる嫌いがある。"},{"spoiler":false,"text":"望たちとの生活ではお姉さん的ポジション。"},{"spoiler":false,"text":"普段は温厚な性格だが、望を巡る争いにいつの間にか参戦してしまうことも。"}],"source":"egs","sourceCharacterId":"25898","sourceWorkId":"7026","spoiler":false},{"segments":[{"spoiler":false,"text":"永远神剑：第六位　『心神』"},{"spoiler":false,"text":"守护神兽：战栗兵器「アイギアス」"},{"spoiler":false,"text":"『剑之世界』中以反乱军先锋身份战斗的亡国的王女。"},{"spoiler":false,"text":"正义感极强，决不饶恕邪恶。"},{"spoiler":false,"text":"讨厌卑鄙之事，有太过注重骑士道精神的倾向。"},{"spoiler":false,"text":"与望等人的日常生活中担任姐姐般的角色。"},{"spoiler":false,"text":"一旦希美和沙月因望的事而发生冲突时，会出来担当和解人员。"}],"source":"bangumi","sourceCharacterId":"11502"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c425311d941b3dada0e0433509f8e6d052a9eaf8bf3a400f45f7fc34c5f9c58.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3ff8c7fe8278d15493551d8d9ca74a8dc0d4c5085d1b291d9ae8c6428436cf27.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜川 美紅","creatorId":"vndb:s2139","sourcePersonId":"vndb:s2139","canonicalEntityId":"vndb:s2139","name":"三五 美奈子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8058","source":"vndb"}]},{"characterId":"char_c6041","characterName":"永峰 希美","sourceIds":{"bangumi":[{"characterId":"11501","match":"exact-normalized-name-in-linked-work","subjectId":"11258"}],"egsCharacterIds":["25897"],"vndbCharacterId":"c6041"},"originalCharacterName":"永峰 希美","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nozomi is a childhood friend of Nozomu, whom he grew up together with. They grew close when Nozomi's family started taking care of Nozomu when his parents went missing. Nozomi tend to be very kind and reserved, but when the matter concerns Nozomu, she will be very hostile to anyone who gets too close to him."},{"spoiler":false,"text":"Nozomi clashes with Satsuki over Nozomu often, and considers her a rival, albeit unilaterally."}],"source":"vndb","sourceCharacterId":"c6041"},{"segments":[{"spoiler":false,"text":"望のことを一途に想う幼馴染みで、同日に生まれたお隣り同士。"},{"spoiler":false,"text":"斑鳩沙月という学園のマドンナ的先輩の登場で何かと張り合おうとするが、望に気がついてもらえない。"},{"spoiler":false,"text":"少々人見知りするが、基本的に明るく優しい性格。"},{"spoiler":false,"text":"趣味は料理と日記を付けること。"}],"source":"egs","sourceCharacterId":"25897","sourceWorkId":"7026","spoiler":false},{"segments":[{"spoiler":false,"text":"永远神剑：第六位　『清净』"},{"spoiler":false,"text":"守护神兽：次元鲸鱼「ものべー」"},{"spoiler":false,"text":"一心一意想着望的青梅竹马，且是同一天出生的隔壁邻居。"},{"spoiler":false,"text":"虽尽力对抗了斑鳩沙月这位如同学园的麦当娜般存在的学姐，但是自己不太有主见。"},{"spoiler":false,"text":"稍稍有些认生，但基本属于明朗温柔的性格。"},{"spoiler":false,"text":"兴趣是料理和写日记。"}],"source":"bangumi","sourceCharacterId":"11501"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83729d5be8049d1