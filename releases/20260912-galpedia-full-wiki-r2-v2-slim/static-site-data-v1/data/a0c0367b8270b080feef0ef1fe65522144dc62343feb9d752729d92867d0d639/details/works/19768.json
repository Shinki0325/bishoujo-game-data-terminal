-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb17b316dbf47c0366b30297922987057c216ca3a4c9a4ac0e7fd88d4ee6ca6d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b58a4d283d35d24bfe95fbc77d95961d47691a9eb88d3adf7c673e15b1ba1e9b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中嶋 アキ","creatorId":"vndb:s15919","sourcePersonId":"vndb:s15919","canonicalEntityId":"vndb:s15919","name":"太齋 明子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64287","source":"vndb"}]},{"characterId":"char_vndb_c79865","characterName":"プルーペット","sourceIds":{"vndbCharacterId":"c79865"},"originalCharacterName":"プルーペット","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"38"},"height":{"reviewState":"source-only","source":"vndb","value":"100"},"weight":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Pluepet is a talented merchant born in the free city of Portugal in GI980. He travels to all sorts of places as a travelling merchant selling rare goods. He appeared in most Rance games after the 4.x games, and also made appearances in Toushin Toshi games."},{"spoiler":false,"text":"He's a strange green creature that travels around in something that resembles a spaceship. His race is unknown but he's probably some rare type of monster. Personality-wise, he's a businessman. He's a very skilled and clever individual that knows how to trade, but he's also very cruel and cold, showing no interest in everything outside of selling his goods and making money. He completely lacks morality and will do whatever he considers will bring the best earning, regardless if it's selling drugs, slaves or innocent girls as prostitutes. He simply sees everything around him as a means to trade and increase profits, and is perfectly fine with helping people as well if he thinks it will be profitable."},{"spoiler":false,"text":"From AliceSoft Wiki"}],"source":"vndb","sourceCharacterId":"c79865"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06a15c79da4cce227d6ae2e0ff9a61ee952e42f6d72d88df2d282b206afcfb8c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c62b9d1ba5718363eb0fe6bae612763b447b30544aa6903401cd66fc2a8d4b5a.webp","width":168,"height":188,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c95529","characterName":"使徒 アトランタ","sourceIds":{"vndbCharacterId":"c95529"},"originalCharacterName":"使徒 アトランタ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Atlanta is a mage and is skilled with many curses and spells. Her most iconic curse is the one that traps her opponent in a Mirror and divides it into several fragments. Those trapped in it cannot get out and their only hope is that someone else finds all the mirror pieces. Once they are all gathered and put together, the victim will be released immediately."},{"spoiler":true,"text":"Atlanta is an Apostle of Lexington first (chronologically) seen in Rance IV and later seen in every iteration of the Toushin Toshi series up to date. She's travelling all over The Continent carrying the Demonic Blood Soul of her master searching for a way to bring him back, but she's not very competent, since she's spent a few centuries with no success."},{"spoiler":false,"text":"From AliceSoft Wiki"}],"source":"vndb","sourceCharacterId":"c95529"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/charact