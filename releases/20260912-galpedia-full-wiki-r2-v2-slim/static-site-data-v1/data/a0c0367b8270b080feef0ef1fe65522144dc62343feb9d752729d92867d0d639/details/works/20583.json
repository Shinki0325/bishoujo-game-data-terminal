":"vndb:s5999","canonicalEntityId":"vndb:s5999","name":"井筒 日美","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:100961","source":"vndb"},{"creditedName":"mau","creatorId":"vndb:s6183","sourcePersonId":"vndb:s6183","canonicalEntityId":"vndb:s6183","name":"mau","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:100962","source":"vndb"},{"creditedName":"Ma-ki","creatorId":"vndb:s15373","sourcePersonId":"vndb:s15373","canonicalEntityId":"vndb:s15373","name":"牧野真児","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:100963","source":"vndb"},{"creditedName":"島田類","creatorId":"vndb:s39920","sourcePersonId":"vndb:s39920","canonicalEntityId":"vndb:s39920","name":"島田類","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:100964","source":"vndb"},{"creditedName":"島田類","creatorId":"vndb:s39920","sourcePersonId":"vndb:s39920","canonicalEntityId":"vndb:s39920","name":"島田類","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:100965","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c22016","characterName":"めのう","sourceIds":{"vndbCharacterId":"c22016"},"originalCharacterName":"めのう","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A meek and obedient princess with a docile disposition. Her requirement to mate and find a suitable drone to become her husband hasn't sunk in. Upon Kaguya's return, Menou receives an order from her mother, the queen, to assassinate Kaguya. After deciding that she wants to cooperate in order to govern the hive, the queen gets murdered by Kaguya. Kaguya pins the crime on Menou, forcing the latter to escape from her hive."},{"spoiler":false,"text":"Based on the tanslation of the official website profile."}],"source":"vndb","sourceCharacterId":"c22016"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa9ad6450097073ba6de974a10033a4f677fb654ae73610134858ae92059a101.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/180cd165177d16b7710098b30acdcc5098ae38751f8d9b2837abbd24b236a15a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"香春部 春香","creatorId":"vndb:s1550","sourcePersonId":"vndb:s1550","canonicalEntityId":"vndb:s1550","name":"香春部 春香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53945","source":"vndb"}]},{"characterId":"char_vndb_c22017","characterName":"輝夜","sourceIds":{"vndbCharacterId":"c22017"},"originalCharacterName":"輝夜","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A princess who is also an heir to the throne. Ever since she was a child, Kaguya had a dangerous, seductive aura about her. Though she miraculously survived her fall from a cliff to the world below, her life from then on revolved around \"accompanying\" the men living there. Taking advantage of her mother's death, Kaguya immediately begins to capture the castle. Noble and wise, she possesses the will to follow through with anything, once she sets her mind on it."},{"spoiler":false,"text":"Based on the translation on the official website profile."}],"source":"vndb","sourceCharacterId":"c22017"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/ccece3549f9864965130e5e44e8bfeea3171675d0bd3a0eb669bae36c6e160f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46b362df1f83f660716bbc9d6f43a3d4281894660a5adfd4d0320bcdb5299c18.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和央 きりか","creatorId":"vndb:s1549","sourcePersonId":"vndb:s1549","canonicalEntityId":"vndb:s1549","name":"桐村 まり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53944","source":"vndb"}]},{"characterId":"char_vndb_c22058","characterName":"白鴎","sourceIds":{"vndbCharacterId":"c22058"},"originalCharacterName":"白鴎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hakuou wanders his hunting ground, the \"Lost Forest\", which is located right under the Sky World's gates."},{"spoiler":true,"text":"Sometime in the past, he ate the leader of a religious organisation known as the \"Golden Bees\". As a result, Hakuou was cursed. He became unable to eat humans, and lost his pride as a drone. Now he's currently searching for a way to lift the curse."},{"spoiler":true,"text":"He seems to have some kind of involvement with Kaguya; the latter being currently contained by a surgeon."},{"spoiler":false,"text":"There's nothing sinister about his liking of bondage- it's simply to his sexual tastes."},{"spoiler":false,"text":"Based on the tanslation of the official website profile."}],"source":"vndb","sourceCharacterId":"c22058"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83f72fbad143e7e300fb3ca5fa647a5bc80fe66cfafb77d175ef141f1dc3f84e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33464fb94255ff8b42b2ffe1b4fddb018e19804203877229f19ed998d5e3fa76.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平井 達矢","creatorId":"vndb:s133","sourcePersonId":"vndb:s133","canonicalEntityId":"vndb:s133","name":"平川 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53939","source":"vndb"}]},{"characterId":"char_vndb_c22059","characterName":"紅玉","sourceIds":{"vndbCharacterId":"c22059"},"originalCharacterName":"紅玉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ordinarily, he does not show himself in front of others."},{"spoiler":true,"text":"Since his birth, Ruby has lived his life fulfilling his task of culling bee larvae by cannibalising them. Unlike ordinary bees, Ruby does not chiefly feed on humans. Due to him being a cannibal, he is loathed by the other bees. Embracing Menou's lack of knowledge of this aspect of him, Ruby wishes to become her husband..."},{"spoiler":false,"text":"Based on the tanslation of the official website profile."}],"source":"vndb","sourceCharacterId":"c22059"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba36909d183d4061840f36c22c6bb27cc908ef20e896c56eed74b9d8d22a7095.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c0e72e752b7d1905845fd7c1dd43345478f389877c8a80b96b35970e0e49e1a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田村 拓狼","creatorId":"vndb:s40","sourcePersonId":"vndb:s40","canonicalEntityId":"vndb:s40","name":"江口 拓也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53940","source":"vndb"}]},{"characterId":"char_vndb_c22066","characterName":"貴峰丸","sourceIds":{"vndbCharacterId":"c22066"},"originalCharacterName":"貴峰丸","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Takanemaru is Menou's tutor."},{"spoiler":false,"text":"He possesses a taciturn and cold aura, but he also has a very strong sense of responsibility and takes care of Menou very thoroughly."},{"spoiler":true,"text":"He's somehow connected to the queen, and appears to be hiding something from Menou since her childhood. As the queen's death approaches, Takanemaru begins to show some level of unrest."},{"spoiler":false,"text":"Based on the tanslation of the official website profile."}],"source":"vndb","sourceCharacterId":"c22066"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94ec06c3a8400c134dbf9021119c5c8993fe6fc1d2b1a0c5a3d1bda0e9300744.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed0b1f76b3f737f1e6ffd3d0cf7e348cdb37eaa4b64476ca85205972d67e2066.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"沖野 靖広","creatorId":"vndb:s67","sourcePersonId":"vndb:s67","canonicalEntityId":"vndb:s67","name":"高橋 広樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53942","source":"vndb"}]},{"characterId":"char_vndb_c22067","characterName":"虚","sourceIds":{"vndbCharacterId":"c22067"},"originalCharacterName":"虚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"There isn't anybody in the hive that doesn't know of the Bug Caretaker, Utsuro. Most bees don't want anything to do with him due to him carrying around the various bugs he takes care of, in addition to his odd, servile smile. When Kaguya speaks to him kindly, he comes to greatly admire her."},{"spoiler":false,"text":"Based on the tanslation of the official website profile."}],"source":"vndb","sourceCharacterId":"c22067"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/7004c8e688f0eb1dfd2cc9df86a7c45e45ecba64a7835c4849c4080d61993b5e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/5426e34e6c33396782484eabbd89f81f92a0d6f97d2a637f5fa12b35c89df06b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いちご みるく","creatorId":"vndb:s1447","sourcePersonId":"vndb:s1447","canonicalEntityId":"vndb:s1447","name":"白石 稔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53943","source":"vndb"}]},{"characterId":"char_vndb_c22068","characterName":"燐","sourceIds":{"vndbCharacterId":"c22068"},"originalCharacterName":"燐","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rin possesses the blood of a princess whom was deemed inferior against the previous queen. Treated like a slave, he wasn't even allowed to wear clothes. However, he was able to go on thanks to his natural cheerfulness. His good, honest heart is slowly warped into darkness due to Kaguya's influence."},{"spoiler":false,"text":"Based on the translation of the official website profile."}],"source":"vndb","sourceCharacterId":"c22068"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1dfcb46d544664a9f267c62c0a236a0edf23e3fd344ff99d5f3bea7ce5f97b5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13af9d6448b1390c4480c3d20556fe51b1a81dfd54002cf4714ebe8c6f2dfba9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"魁皇 楽","creatorId":"vndb:s80","sourcePersonId":"vndb:s80","canonicalEntityId":"vndb:s80","name":"柿原 徹也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53938","source":"vndb"}]},{"characterId":"char_vndb_c22069","characterName":"皇樹","sourceIds":{"vndbCharacterId":"c22069"},"originalCharacterName":"皇樹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He loathes women, but endures their presence. He has a swindler-like attitude, and nobody can tell what he's thinking. It's even a mystery why Sumeragi offered to cooperate with Kaguya."},{"spoiler":false,"text":"Based on the tanslation of the official website profile."}],"source":"vndb","sourceCharacterId":"c22069"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29abffba8b21098bd256778ea5d29a42e7b1b2e9e3fc7401d467884608abf1d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a58179002a105f64fb46acbf4d39569ffb2e5e33bdf9a2dca0bf9ea3211a5669.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ワッショイ 太郎","creatorId":"vndb:s255","sourcePersonId":"vndb:s255","canonicalEntityId":"vndb:s255","name":"川田紳司","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53941","source":"vndb"}]},{"characterId":"char_vndb_c22070","characterName":"リリム","sourceIds":{"vndbCharacterId":"c22070"},"originalCharacterName":"リリム","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Lilim is Hakuou and Menou's neighbour, when the two take residence in the village temporarily. She seems to take care of Menou to an almost nosy degree. However, Lilim has an unpleasant background that is hidden from them..."},{"spoiler":true,"text":"Lilim is the current leader of the cult-like Golden Bees religious organisation, which was founded by her father (the man who cursed Hakuou). Her goal is to successfully breed a bee and a human to create a being which will be powerful. However, her attempts have failed, and produced many retarded offspring that act as her minions."},{"spoiler":false,"text":"Based on the tanslation of the official website profile."}],"source":"vndb","sourceCharacterId":"c22070"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/574c83d5b5c532de7fe80b5a3ec52682d89cc491827ef20594548eb8b20d8bc5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d2955c86835889eca03a469ef3577e6aca82152f9f7600397e259fffcc15c21.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜 めぐみ","creatorId":"vndb:s1551","sourcePersonId":"vndb:s1551","canonicalEntityId":"vndb:s1551","name":"桜 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationI