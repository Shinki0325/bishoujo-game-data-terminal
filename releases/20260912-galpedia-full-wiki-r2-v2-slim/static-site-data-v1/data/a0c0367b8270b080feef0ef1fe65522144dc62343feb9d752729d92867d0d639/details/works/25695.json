conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 'girl' Seiji met when he was young. Acts like his puppy dog and calls him 'Master', following him around most of the time."}],"source":"vndb","sourceCharacterId":"c63711"},{"segments":[{"spoiler":false,"text":"主人公のことを「ご主人」と呼ぶ幻夷の少女。"},{"spoiler":false,"text":"彼女が主人公の前に現れたことにより、様々な状況が変わり、物語が始まる。"}],"source":"egs","sourceCharacterId":"17738","sourceWorkId":"25695","spoiler":false},{"segments":[{"spoiler":false,"text":"学年:2年"},{"spoiler":false,"text":"住居:稜未邸"},{"spoiler":false,"text":"属性:ペット・しなやか・無邪気・素直・犬系"},{"spoiler":false,"text":"年齢相応の見た目だが、言動が子供(子犬)っぽいため、幼めに見える。"},{"spoiler":false,"text":"「ご主人ご主人!」と常に尻尾をパタパタ振っている子犬イメージ。"},{"spoiler":false,"text":"元気系というよりは、感情を素直に表して上下幅が大きい感じ。"},{"spoiler":false,"text":"彼女が主人公の前に現れたことにより、様々な状況が変わり、物語が始まる。"},{"spoiler":false,"text":"自分のことはほとんど覚えておらず、名前と、主人公のペットであるということだけを覚えている。"},{"spoiler":false,"text":"しかし『自分は主人公のペットである』という思いだけは彼女に刻み込まれており、主人に会えた嬉しさそのままに、少女の見た目でペットのようにじゃれつく。"},{"spoiler":false,"text":"「ずっとずっと、逢いたかった! わたしの――」"}],"source":"bangumi","sourceCharacterId":"57133"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"17738","sourceWorkId":"25695","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"17738","sourceWorkId":"25695","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"17738","sourceWorkId":"25695","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"17738","sourceWorkId":"25695","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24cecadf49524a94a04ed264da8329ddf8b34bd4fee75e7d4d43494484f52818.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/5044fd0990d6b9a9d2eab3780690986630d22f1b19ae2d9dfa9bf9e6fd756c86.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山岡ゆり","creatorId":"vndb:s11656","sourcePersonId":"vndb:s11656","canonicalEntityId":"vndb:s11656","name":"山岡 ゆり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222825:57133:5645:1","source":"bangumi"}]},{"characterId":"char_c63712","characterName":"笹浦 すずな","sourceIds":{"bangumi":[{"characterId":"57134","match":"exact-normalized-name-in-linked-work","subjectId":"222825"}],"egsCharacterIds":["17739"],"vndbCharacterId":"c63712"},"originalCharacterName":"笹浦 すずな","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"301"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Seiji's little sister who is head over heels in love with him. Tries her best in seducing him, but can get pretty shy when Seiji teases her."}],"source":"vndb","sourceCharacterId":"c63712"},{"segments":[{"spoiler":false,"text":"兄である主人公のことが大好きなブラコン妹。"},{"spoiler":false,"text":"小柄だが、とにかくエロい体つき(胸やら、むちむちの太ももやら、肉付きのいいお尻やら)をしている。"}],"source":"egs","sourceCharacterId":"17739","sourceWorkId":"25695","spoiler":false},{"segments":[{"spoiler":false,"text":"学年:1年"},{"spoiler":false,"text":"住居:稜未邸"},{"spoiler":false,"text":"属性:妹・ロリ巨乳・黒タイツ・ブラコン"},{"spoiler":false,"text":"小さくて、とにかくエロい体つき(胸もだが、黒タイツむちむち太ももとか、肉付きのいいお尻とか)。自身の容姿を理解して、活かしてくる計算高い小悪魔だが、臆病なところがあり、困難からはすぐに逃げようとする。"},{"spoiler":false,"text":"兄を異性として大好きだが、最後の一歩を踏み出す勇気はなく、今の居心地のよい依存関係が続けられればそれで満足だった。しかし、もみじ――兄に懐く美少女が現れたことで状況が変わる。"},{"spoiler":false,"text":"このままでは兄がもみじに取られ、離れていってしまう。それは玉砕したときと同じであり、兄と共にいるために、長年秘めた想いを遂げるために、すずなも動く必要が出てくる。"},{"spoiler":false,"text":"「お兄ちゃんに全部お任せです。 お兄ちゃんがいれば、私の人生安泰です」"}],"source":"bangumi","sourceCharacterId":"57134"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"17739","sourceWorkId":"25695","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"17739","sourceWorkId":"25695","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"145 cm","valueContext":null,"source":"egs","sourceCharacterId":"17739","sourceWorkId":"25695","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"17739","sourceWorkId":"25695","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"17739","sourceWorkId":"25695","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c00b7427ab33a84f145b0bb6b403b80306bb5e7702c3c29be629826091e5f03.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a25d8c099eafbc203ef099c79474bdb520bc18f19f02ffde671410c1a3a08382.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長妻樹里","creatorId":"vndb:s1197","sourcePersonId":"vndb:s1197","canonicalEntityId":"vndb:s1197","name":"長妻 樹里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222825:57134:8493:1","source":"bangumi"}]},{"characterId":"char_c63713","characterName":"稜未 小乃葉","s