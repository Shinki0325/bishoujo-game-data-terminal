{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"11359","model":{"presentationWorkId":"vndb:v3032","staff":{"artwork":[{"creditedName":"CARNELIAN","creatorId":"vndb:s961","sourcePersonId":"egs:creator:155","canonicalEntityId":"vndb:s961","name":"CARNELIAN","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:79922","source":"egs"},{"creditedName":"ドレン・チェリー(天宮ぽらん)","creatorId":"vndb:s1074","sourcePersonId":"egs:creator:3","canonicalEntityId":"vndb:s1074","name":"ドレン・チェリー(天宮ぽらん)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:79923","source":"egs"}],"scenario":[{"creditedName":"宙形安久里(DR2、山形安久里)","creatorId":"vndb:s1224","sourcePersonId":"egs:creator:728","canonicalEntityId":"vndb:s1224","name":"宙形安久里(DR2、山形安久里)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:79924","source":"egs"},{"creditedName":"片桐由摩","creatorId":"vndb:s3433","sourcePersonId":"egs:creator:2880","canonicalEntityId":"vndb:s3433","name":"片桐由摩","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:84178","source":"egs"},{"creditedName":"玉城未悠","creatorId":"vndb:s4080","sourcePersonId":"egs:creator:14936","canonicalEntityId":"vndb:s4080","name":"玉城未悠","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:88346","source":"egs"}],"music":[{"creditedName":"KIM’s SOUNDROOM","creatorId":"vndb:s1226","sourcePersonId":"egs:creator:2999","canonicalEntityId":"vndb:s1226","name":"KIM’s SOUNDROOM","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:88325","source":"egs"},{"creditedName":"ave;new","creatorId":"vndb:s1260","sourcePersonId":"vndb:s1260","canonicalEntityId":"vndb:s1260","name":"ave;new","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:39880","source":"vndb"}],"other":[{"creditedName":"Point Pictures(株式会社ポイント・ピクチャーズ)","creatorId":"vndb:s5820","sourcePersonId":"egs:creator:14524","canonicalEntityId":"vndb:s5820","name":"Point Pictures(株式会社ポイント・ピクチャーズ)","detail":"ムービー作成","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:84264","source":"egs"},{"creditedName":"佐倉紗織","creatorId":"vndb:s1261","sourcePersonId":"egs:creator:12573","canonicalEntityId":"vndb:s1261","name":"佐倉紗織","detail":"主題歌「OctaveRain」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:84301","source":"egs"},{"creditedName":"CARNELIAN","creatorId":"vndb:s961","sourcePersonId":"egs:creator:155","canonicalEntityId":"vndb:s961","name":"CARNELIAN","detail":"ディレクター、企画","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:84439","source":"egs"},{"creditedName":"CARNELIAN","creatorId":"vndb:s961","sourcePersonId":"vndb:s961","canonicalEntityId":"vndb:s961","name":"CARNELIAN","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:39874","source":"vndb"},{"creditedName":"CARNELIAN","creatorId":"vndb:s961","sourcePersonId":"vndb:s961","canonicalEntityId":"vndb:s961","name":"CARNELIAN","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:39876","source":"vndb"},{"creditedName":"佐倉 紗織","creatorId":"vndb:s1261","sourcePersonId":"vndb:s1261","canonicalEntityId":"vndb:s1261","name":"佐倉 紗織","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:39881","source":"vndb"},{"creditedName":"株式会社ポイント・ピクチャーズ","creatorId":"vndb:s5820","sourcePersonId":"vndb:s5820","canonicalEntityId":"vndb:s5820","name":"株式会社ポイント・ピクチャーズ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:39882","source":"vndb"}]},"cast":[{"characterId":"char_c31476","characterName":"藤田 のどか","sourceIds":{"bangumi":[{"characterId":"11869","match":"exact-normalized-name-in-linked-work","subjectId":"5759"}],"egsCharacterIds":["16641"],"vndbCharacterId":"c31476"},"originalCharacterName":"藤田 のどか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の従姉妹。"},{"spoiler":false,"text":"学園生活が始まり程なくして、転校生という形でやってきた。"},{"spoiler":false,"text":"主人公と同じように谷田部家の使用人兼学生となる。"},{"spoiler":false,"text":"明るく気だての良い娘で、谷田部家の人間達の中で唯一家事能力が高く、ただその力のみで家族内での確固たる発言権を得ている。"},{"spoiler":false,"text":"特に包丁捌きは神技のレベルと言わしめ、どんなに細くても等間隔に包丁を通せることが自慢とか。"},{"spoiler":false,"text":"その正確無比な刃物捌きは包丁以外にも発揮される。"},{"spoiler":false,"text":"だが稀に服の裁断などで失敗した場合、たとえそれが1mm以下の他人には分からない失敗であろうとも絶対に許せないというプライドの様なものもあるらしい。"},{"spoiler":false,"text":"かつて幼い頃主人公と出会い、仲も良かったらしく（主人公は覚えていない）、始めから主人公に好意を抱き何くれとなく絡んでくる。"},{"spoiler":false,"text":"ドジっ子なのか、いつの間にか手に怪我をしほとんどいつも包帯を巻いている。"}],"source":"egs","sourceCharacterId":"16641","sourceWorkId":"11359","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的表姐妹，仿佛是追随着主人公而来到谷田部家大宅的佣人兼学生。"},{"spoiler":false,"text":"性格明朗活泼，料理・洗衣服・打扫等等的家务事无所不能。"},{"spoiler":false,"text":"因此在自理能力为零的谷田部家住客里面有着很强的发言权，作为家庭主妇一样统治着这个家。"},{"spoiler":false,"text":"在各种家务中尤其以料理最为擅长，运用菜刀的手法更加被周围的人成为神技。"},{"spoiler":false,"text":"似乎在小时候就曾经和小次郎相遇并且关系很好，令人不可思议的是小次郎对这些竟然完全没有印象。"},{"spoiler":false,"text":"因此，从再次相遇之后开始便对小次郎包邮好感并且很亲近他。"},{"spoiler":false,"text":"而关于她的事唯一令人想不透的就是，明明挥舞菜刀的时候是如此的华丽纯熟，完全看不出会有受伤的可能，而手上却经常缠着绷带。"}],"source":"bangumi","sourceCharacterId":"11869"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17fea231ddcc44db80ef53ee28bd3193f6bfabc27e6c6a707823ac5691b8fe3b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/760d0193a52231604866b284dda7ddc87f1d18840f452cf0d67976935a924224.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Rita","creatorId":"vndb:s102","sourcePersonId":"vndb:s102","canonicalEntityId":"vndb:s102","name":"平井 理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5759:11869:5742:1","source":"bangumi"}]},{"characterId":"char_c31477","characterName":"田丸 優芽","sourceIds":{"bangumi":[{"characterId":"11873","match":"exact-normalized-name-in-linked-work","subjectId":"5759"}],"egsCharacterIds":["16645"],"vndbCharacterId":"c31477"},"originalCharacterName":"田丸 優芽","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"古文教師。園芸部の顧問。"},{"spoiler":false,"text":"教師、生徒を問わず男子生徒のファン多し。"},{"spoiler":false,"text":"いわゆる天然系であり、せっかくの美女なのによく泥だらけの園芸スタイルでうろうろしている。"},{"spoiler":false,"text":"興味を持つと填るタイプなのか、授業中も脱線すること多し、古文の教師なのに生物方面の知識は凄まじい。"},{"spoiler":false,"text":"実は複数の博士号を持っている超才媛。"},{"spoiler":false,"text":"シャムロック・グループのバイオ関係の研究所で将来を嘱望される若き天才だった。"},{"spoiler":false,"text":"また谷田部乃愛、美海の両親とも知り合いだったらしい。"}],"source":"egs","sourceCharacterId":"16645","sourceWorkId":"11359","spoiler":false},{"segments":[{"spoiler":false,"text":"古文教师兼园艺部的顾问。"},{"spoiler":false,"text":"在教师和学生中都有着众多的男粉丝。"},{"spoiler":false,"text":"性格就是所谓的天然系，虽然有着人见人爱车见车载的美貌和身材，但是毫不在意自己女性的形像，经常满身是泥的在校内游荡。"},{"spoiler":false,"text":"担任的科目是古文，生物方面的知识也十分厉害。而且是拥有多个博士头衔的超级才女。"},{"spoiler":false,"text":"似乎和竹内牧場颇有渊缘，该企业集团拥有的大多数专利都是她学生时代的研究成果。"},{"spoiler":false,"text":"另一方面她似乎也认识谷田部乃愛、美海的父母。"}],"source":"bangumi","sourceCharacterId":"11873"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b34ba7cd3d8db02f2d6d26ecb11eab659914839ecd5a1c7788037aeb6e906ab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5af26ce22382ab4137d51b1b96104c8e69e5ffc5ad3cf00439d173e8bc44c803.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"咲乃藍里","creatorId":"vndb:s436","sourcePersonId":"vndb:s436","canonicalEntityId":"vndb:s436","name":"咲乃 藍里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5759:11873:5692:1","source":"bangumi"}]},{"characterId":"char_c31480","characterName":"武田 レイチェル","sourceIds":{"bangumi":[{"characterId":"11870","match":"exact-normalized-name-in-linked-work","subjectId":"5759"}],"egsCharacterIds":["16644"],"vndbCharacterId":"c31480"},"originalCharacterName":"武田 レイチェル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"金髪でクールな少女。"},{"spoiler":false,"text":"父がアメリカ人、母が日本人のハーフの帰国子女であり谷田部乃愛の親友。"},{"spoiler":false,"text":"乃愛のファンであり、実は色々欠点のある乃愛を「パーフェクトなアイドル」に演出するのが趣味なのか、まるでマネージャーの様に乃愛の面倒を見ている。"},{"spoiler":false,"text":"レイチェルと呼ばれるのは嫌いで、周囲の人間達にはレイ、もしくはレイちゃんと呼ばせている。"},{"spoiler":false,"text":"そして表には見せていないが大の男嫌い。"},{"spoiler":false,"text":"また全く勉強をしている様には見えないのに、常に学年で上位３位の成績をおさめている。"},{"spoiler":false,"text":"本人も勉強というものをしたことがないと言う。写真記憶の持ち主。"},{"spoiler":false,"text":"両親共に外資系の世界的な製薬会社の優秀な研究員であり、彼女は天才のサラブレットである。"}],"source":"egs","sourceCharacterId":"16644","sourceWorkId":"11359","spoiler":false},{"segments":[{"spoiler":false,"text":"爸爸是美国人，母亲是日本人的混血儿，归国子女。谷田部乃愛的好朋友。"},{"spoiler":false,"text":"她不仅是乃愛的粉丝，而且在暗地里替乃愛掩盖她的缺点，使她在大家面前表现得像『完美偶像』一样，本人更将这样做视为自己的生存价值。"},{"spoiler":false,"text":"非常讨厌别人叫她レイチェル，周围的人都称呼她做レイ或者レイ酱。"},{"spoiler":false,"text":"而且不为人知的是，她非常的讨厌男性。"},{"spoiler":false,"text":"平时完全没有看见她学习的样子，但考试的时候总是能排在前三位。"},{"spoiler":false,"text":"她本人也说对读书没什么兴趣，之所以有这么优秀的成绩是因为她的父母都是拥有天才头脑的研究员。继承了她父母遗传的优良血统，她也有着名为『写真记忆』的这种特殊能力。"}],"source":"bangumi","sourceCharacterId":"11870"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/432b6b2b20ca96c9aa1a816300f1faede06915e707393c596a2a8909bcf8c224.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba744d39f61be836a6ffd0796840e9d01e71904b05b27d114657e1985459b6c3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5759:11870:4956:1","source":"bangumi"}]},{"characterId":"char_c31483","characterName":"谷田部 シャム","sourceIds":{"bangumi":[{"characterId":"11868","match":"exact-normalized-name-in-linked-work","subjectId":"5759"}],"egsCharacterIds":["16642"],"vndbCharacterId":"c31483"},"originalCharacterName":"谷田部 シャム","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"谷田部家の少年執事。"},{"spoiler":false,"text":"家令的立場の人間で少年ながら家計全般を取り仕切り、家事以外の一切の場で完璧な仕事ぶりを誇っている。"},{"spoiler":false,"text":"谷田部の姓であるが養子。いわゆる天才であり将来はシャムロック・グループのエリート幹部への道が決まっていると言われている。"},{"spoiler":false,"text":"極めてクールであり、家族間、姉妹間の問題には基本的に介入しない。"},{"spoiler":false,"text":"主人公達に対してもまるで大人の様な口をきく。"},{"spoiler":false,"text":"家族内では会話のTPOを余り気にしないらしく、普段のクールな言動との相乗効果で毒舌と受け取られることも多い。"},{"spoiler":false,"text":"屋敷の地下にプライベートルームがあるが、そこには絶対に誰も入れない。主人公ですら入れなかった。"}],"source":"egs","sourceCharacterId":"16642","sourceWorkId":"11359","spoiler":false},{"segments":[{"spoiler":false,"text":"谷田部家的少年管家。"},{"spoiler":false,"text":"虽然还是一位俊朗的少年，但是已经以管家的身份管理着谷田部家除了家务以外其他所有事物，其高明的处事方法足可引以为豪。"},{"spoiler":false,"text":"姓谷田部是因为他是谷田部家的养子。"},{"spoiler":false,"text":"被称作天才并且已经内定将来会作为『シャムロック•财团』精英干部的一员。"},{"spoiler":false,"text":"性格非常的cool，对别人的家庭问题和谷田部姐妹之间的关系基本都是不闻不问，对主人公说话也使用大人对小孩说话的口吻。"},{"spoiler":false,"text":"在大屋的地下建了他的私人卧室，不允许任何人进入。"}],"source":"bangumi","sourceCharacterId":"11868"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cab2f24931903a866eee1facb424cf139e658c026cbe1b627103670c21841d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02545f9983b2a669acab2cbc7a1e5e1a4ff21343c0438aceba2b5b2a3e81c6bd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松元恵","creatorId":"egs:creator:8999","sourcePersonId":"egs:creator:8999","canonicalEntityId":"egs:creator:8999","name":"松元恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5759:11868:4515:1","source":"bangumi"},{"creditedName":"守田 羽糸","creatorId":"vndb:s882","sourcePersonId":"vndb:s882","canonicalEntityId":"vndb:s882","name":"松元 惠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21717","source":"vndb"}]},{"characterId":"char_c31484","characterName":"竹内 桃太郎","sourceIds":{"bangumi":[{"characterId":"11871","match":"exact-normalized-name-in-linked-work","subjectId":"5759"}],"egsCharacterIds":["16647"],"vndbCharacterId":"c31484"},"originalCharacterName":"竹内 桃太郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の友人。山国の幼馴染。"},{"spoiler":false,"text":"ツクバ近郊の酪農家（ジモピー愛飲の牛乳産地）の息子である。"},{"spoiler":false,"text":"お馬鹿で直なお調子者。"},{"spoiler":false,"text":"本人的には勉強嫌いで、この学園に何で入れたのか自分でも分かっていないという。"},{"spoiler":false,"text":"だが本人は自覚していないが実はかなり頭がよい。"},{"spoiler":false,"text":"門前の小僧は何とやらで山国（小学校時代からよくサボっていた）の優秀な友人達と接しているうちに彼らの常識とされるレベルの高い教養を身につけてしまっている。"},{"spoiler":false,"text":"田丸優芽先生のファンを自称する。"}],"source":"egs","sourceCharacterId":"16647","sourceWorkId":"11359","spoiler":false},{"segments":[{"spoiler":false,"text":"能够和刚转校过来的小次郎毫无隔阂地交流的同级生。"},{"spoiler":false,"text":"山国兵武（やまぐに ひょうぶ）的青梅竹马，ツクバ近郊奶酪农场・竹内牧場的少爷。"},{"spoiler":false,"text":"表面轻浮但是本性率直善良纯朴。"},{"spoiler":false,"text":"本人不怎么喜欢读书，自己也经常说不知道为什么能够考进这所学校。"},{"spoiler":false,"text":"自称是田丸優芽的粉丝。"}],"source":"bangumi","sourceCharacterId":"11871"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/200216db823eb60012828cc3ad5ceec8d71770fda45f9a233ead0d920230d6b0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5e5d3329094c29158503d3d8395348874e86f98153a28fa39c1461336c9e687.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"坪井智浩","creatorId":"vndb:s254","sourcePersonId":"vndb:s254","canonicalEntityId":"vndb:s254","name":"坪井 智浩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5759:11871:4968:1","source":"bangumi"}]},{"characterId":"char_c31485","characterName":"山国 兵武","sourceIds":{"bangumi":[{"characterId":"11872","match":"exact-normalized-name-in-linked-work","subjectId":"5759"}],"egsCharacterIds":["16646"],"vndbCharacterId":"c31485"},"originalCharacterName":"山国 兵武","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の友人。"},{"spoiler":false,"text":"武田レイチェルとは双方の両親が同じ企業に勤めている仲"},{"spoiler":false,"text":"（中等部の3年間留学している時に知り合っている）。"},{"spoiler":false,"text":"美形であり話も如才が無いため、女生徒に良くもてる。"},{"spoiler":false,"text":"また自分でももてることが分かっていて当然と思っている節がある。"},{"spoiler":false,"text":"ガールハントが趣味の超女好き。"},{"spoiler":false,"text":"主人公や竹内を同好の士にしようとよくそそのかしてくる。"},{"spoiler":false,"text":"また男同時の会話の時は話題がほとんど女性の下半身絡みという変態でもある。"},{"spoiler":false,"text":"故に彼をよく知る女性陣からは当然ながら敬遠されてしまっている。"},{"spoiler":false,"text":"特にレイチェルは彼のことが大嫌いである。"},{"spoiler":false,"text":"成績は常に赤点ギリギリライン。ほとんどコネ入学である。"},{"spoiler":false,"text":"が、およそ言語と名の付くモノに関してだけは乾いたスポンジが水を吸収する様に習得してしまう。"}],"source":"egs","sourceCharacterId":"16646","sourceWorkId":"11359","spoiler":false},{"segments":[{"spoiler":false,"text":"小次郎的朋友。"},{"spoiler":false,"text":"因为脸蛋长得好和说话懂得讨人欢心，在女学生里面有很高的人气。"},{"spoiler":false,"text":"一看见女孩子就会想些非常猥亵的事，并以为小次郎和桃太郎都是和自己同一类人，经常挑唆他们。"},{"spoiler":false,"text":"一旦只有男性在场的时候好色的本性就会完全暴露出来，说话非常色情。"},{"spoiler":false,"text":"因此熟悉他的女性都对他敬而远之。他的父母和レイチェル的父母是同僚，但他却被レイチェル视作害虫一般的存在。"},{"spoiler":false,"text":"成绩基本上是在及格线上徘徊，但是对语言和名称的记忆能力就像干海绵吸水的能力一样强。"}],"source":"bangumi","sourceCharacterId":"11872"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/9301c015bc159654bc92b3d873149372eff2f6c69cd7386788c310ba63b5b84a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f891511e3bbe0372a0a6e5a9a51ffac591ead260cb115fe194015daa48598bdf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柿原徹也","creatorId":"vndb:s80","sourcePersonId":"vndb:s80","canonicalEntityId":"vndb:s80","name":"柿原 徹也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5759:11872:4782:1","source":"bangumi"}]},{"characterId":"char_c3576","characterName":"藤田 小次郎","sourceIds":{"bangumi":[{"characterId":"11874","match":"exact-normalized-name-in-linked-work","subjectId":"5759"}],"egsCharacterIds":["16643"],"vndbCharacterId":"c3576"},"originalCharacterName":"藤田 小次郎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公。"},{"spoiler":false,"text":"長身のハンサム。「黙っていればクールで格好良い」典型。"},{"spoiler":false,"text":"中身は真面目な朴念仁。「牧歌的な家族生活」にこだわりがあり、周りの人間達にもそれを強制する。ただし本人の家事能力は最低。"},{"spoiler":false,"text":"だがとにかく真面目なので、これら家事技術に関しては物語の中で徐々にレベルアップしていくことになる。"},{"spoiler":false,"text":"身内と見なせば相手が誰であろうと守る男気？の強い人間である。"},{"spoiler":false,"text":"また色々な変な「癖」がある。"},{"spoiler":false,"text":"（どんな天気だろうと外出時には傘を持ち歩く。何故か右手だけ手袋をはめる）"},{"spoiler":false,"text":"ツクバ有数の大企業『シャムロック・グループ』会長、谷田部幽谷（やたべ　ゆうこく）の遠縁。"},{"spoiler":false,"text":"幽谷の孫娘達が住む屋敷に、住み込みの使用人兼学生という形でやってくる。"}],"source":"egs","sourceCharacterId":"16643","sourceWorkId":"11359","spoiler":false},{"segments":[{"spoiler":false,"text":"『S研高级顾问・人工知能研究所』的藤田雄一（ふじた ゆういち）博士的外甥，和谷田部姐妹是远房亲戚的关系。"},{"spoiler":false,"text":"武田レイチェル曰：「不说话的话就是高大英俊的好男人，可惜就是不能保持沉默」"},{"spoiler":false,"text":"不懂风情又顽固，崇尚『像温暖的牧歌一样的家庭生活』到了可怕的程度，并将这种观念强加给身边的其他人。"},{"spoiler":false,"text":"但是他本人的家务能力基本为零。"},{"spoiler":false,"text":"只有是被他认作自己人的人，他都会非不顾身地去守护，非常有男子气概（？）。无论什么天气都伞不离手，不知到为什么只有右手一直都带着手套。"},{"spoiler":false,"text":"当他以住家佣工兼学生的身份来到ツクバ郊外谷田部姉妹所住的大屋里，并擅自宣言要和她们成为 『家人』的那一刻开始，这个故事便开幕了。"}],"source":"bangumi","sourceCharacterId":"11874"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86876cf086917c79eeae410a2e620eac1d490a3f2d1b060583833d10a06ebd1b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb499ec8f1c3c455a3ce20571cf5cafb55ff5b80d06867e659b29a1452e13279.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c3577","characterName":"谷田部 乃愛","sourceIds":{"bangumi":[{"characterId":"11866","match":"exact-normalized-name-in-linked-work","subjectId":"5759"}],"egsCharacterIds":["16639"],"vndbCharacterId":"c3577"},"originalCharacterName":"谷田部 乃愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yatabe Noa is the elder sister of the Yatabe sisters, and as the granddaughter of one of the most powerful corporations of the world she’s grown up to be pretty sheltered. Generally speaking, she’s a nice person who’s aware of her naivete (but not her complete inability to cook), and while she’s not the most social person in the world, she is popular enough to be the school idol. Unfortunately for Kojirou, Noa is also extremely protective of her younger sister."},{"spoiler":false,"text":"From Choux's review."}],"source":"vndb","sourceCharacterId":"c3577"},{"segments":[{"spoiler":false,"text":"お団子ヘアがトレードマークの学園のアイドル。"},{"spoiler":false,"text":"容姿端麗頭脳明晰スポーツ万能のスーパー女学生。"},{"spoiler":false,"text":"お高くも止まらず友達思いでもあり、服装などの趣味も抜群、およそ欠点らしいところが見あたらない。"},{"spoiler":false,"text":"だが実際は色々なところで不器用。"},{"spoiler":false,"text":"特にファッション、インテリアセンスはほとんど無く、家事能力も最低である。"},{"spoiler":false,"text":"その辺は全部、マネジメントとコーディネートが大好きな、彼女の親友である武田レイチェルの手腕によるところが大きかったりする。"},{"spoiler":false,"text":"非常に妹思いなのだが、心を閉ざしがちな妹に対してどう接して良いか分からず、主人公がやってくるまではその行動の大半が空回りしていた。"},{"spoiler":false,"text":"主人公に最初淡い一目惚れ感情を抱くが、それを自覚する前に彼の「乙女プライバシーって何？」の行動に猛烈に反発することになる。"},{"spoiler":false,"text":"ツクバ有数の大企業『シャムロック・グループ』会長、谷田部幽谷（やたべ　ゆうこく）の孫娘。両親は飛行機事故で死亡している。"}],"source":"egs","sourceCharacterId":"16639","sourceWorkId":"11359","spoiler":false},{"segments":[{"spoiler":false,"text":"ツくバ内屈指可数的大企业「シャムロック•财团」的会长谷田部 幽谷的孙女。包子头的发型是个人标志，学园的大众偶像。"},{"spoiler":false,"text":"有着卓越的容貌和运动神经，看上去是完美无缺的尖子生。"},{"spoiler":false,"text":"没有架子又关心朋友，衣着的品位也相当高级，看上去完全找不到任何的缺点。"},{"spoiler":false,"text":"但是实际上在各个方面相当的笨拙。"},{"spoiler":false,"text":"尤其在时尚感觉方面可以说是毁灭性的糟糕，好在有喜欢当经理人的好朋友武田レイチェル的协调和帮助，总算没有暴露给周围的人知道。"},{"spoiler":false,"text":"对妹妹美海非常的关怀，却不知道怎么和自闭的她接触，在主人公来到之前她所做的行动多数都是无用功。"}],"source":"bangumi","sourceCharacterId":"11866"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8e2a1416dea53585f524af156878b18c1c3f6baf547020d3be162ac12f928e7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a46440570ce0f53e812e27c44146f4f791be430b1565010f9b105f48471f347f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阪田佳代","creatorId":"vndb:s650","sourcePersonId":"vndb:s650","canonicalEntityId":"vndb:s650","name":"鮎川ひなた","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5759:11866:5133:1","source":"bangumi"}]},{"characterId":"char_c3578","characterName":"谷田部 美海","sourceIds":{"bangumi":[{"characterId":"11867","match":"exact-normalized-name-in-linked-work","subjectId":"5759"}],"egsCharacterIds":["16640"],"vndbCharacterId":"c3578"},"originalCharacterName":"谷田部 美海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ボサボサ頭のショートヘアとヘッドフォンの印象が強い、乃愛の妹。"},{"spoiler":false,"text":"ただし彼女達は年子なので学年は一緒。"},{"spoiler":false,"text":"人気者の姉とは正反対で、友達も少なく"},{"spoiler":false,"text":"いつもヘッドフォンを付けながら窓の外を見ている感じの子である。"},{"spoiler":false,"text":"対人恐怖症という訳ではないが、他人と深く関わることを極端に避ける子。"},{"spoiler":false,"text":"両親が死亡した飛行機事故に彼女も居合わせており、奇跡的に助かったという過去を持つが、その事件のことがどうやら深く関係しているらしい。"},{"spoiler":false,"text":"田丸優芽の園芸部に所属している。"},{"spoiler":false,"text":"園芸植物に興味がある訳ではなさそうなのだが、温室にいるのは好きな様である。"},{"spoiler":false,"text":"主人公に対しても、特に強い好悪の感情は抱いていない。"},{"spoiler":false,"text":"彼女がヘッドフォンでいつも聞いている音は、音楽ではなく水の音（波の音や泡の音など）である。"}],"source":"egs","sourceCharacterId":"16640","sourceWorkId":"11359","spoiler":false},{"segments":[{"spoiler":false,"text":"乃愛的妹妹，发型是短短的蓬松卷发，总是戴着大耳机。和姐姐在学校是同一个年级。"},{"spoiler":false,"text":"和总是被大家包围的姐姐相反，没有什么朋友，经常一个人望着窗外。"},{"spoiler":false,"text":"她之所以极力地避免和其他人扯上关系的原因是一次飞机意外事故中她的双亲不幸身亡，而她当时也在那架飞机上。"},{"spoiler":false,"text":"所属田丸優芽的园艺部，经常一个人晒日光浴。"},{"spoiler":false,"text":"参加园艺部其实并不是因为喜欢花草树木，似乎只是喜欢温室的环境而已。"},{"spoiler":false,"text":"不知为何对初次见面的主人公完全没有戒心，很自然地靠近他。"}],"source":"bangumi","sourceCharacterId":"11867"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86a7510f8eaa640e962abc3f9109e09a7a53902a36696b6cc87d858fe4793bad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1f14ccfd331ad6a0926a9b585cd13bd6313be7d7c8427a806b08e4075b418e7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幡宮かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5759:11867:5940:1","source":"bangumi"}]},{"characterId":"char_vndb_c31481","characterName":"リョーダ","sourceIds":{"vndbCharacterId":"c31481"},"originalCharacterName":"リョーダ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f37a72c9d50370db722474c08816ce079709f4745132ef5b81a5357c7de3e0f4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60210ceebe99f03b68e9f824722086083d0f7661c66c5846298c46c530b9591c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一色 ヒカル","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21709","source":"vndb"}]},{"cha