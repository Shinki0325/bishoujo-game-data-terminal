739","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c59701","characterName":"野上 姫子","sourceIds":{"vndbCharacterId":"c59701"},"originalCharacterName":"野上 姫子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nogami has worked as Sengoku Ichiru's assistant ever since her time in CIRS’ Special Medical Division, and she continues to uphold that role at Mihama Academy."},{"spoiler":false,"text":"While brilliant, she also possesses several personal faults that get in the way of her day-to-day life. Case in point: the fact that her room is always such a total mess. Haruto thinks of her as a sort of surrogate older sister, turning to her first whenever he has issues that he's reluctant to discuss with Principal Sengoku."},{"spoiler":false,"text":"\"Nogami is fine.\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c59701"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/9388933b0d1b4e837ec3d76bcdbd7f6bac73276c5eaea54aad0c2ac0e7659926.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/015b52c2aec366e0facba61eba14f3a41283686fca6dd178b0db4aeb08a3905c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近江 知永","creatorId":"vndb:s6907","sourcePersonId":"vndb:s6907","canonicalEntityId":"vndb:s6907","name":"近江 知永","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80735","source":"vndb"}]},{"characterId":"char_vndb_c59707","characterName":"井ノ原 真紀","sourceIds":{"vndbCharacterId":"c59707"},"originalCharacterName":"井ノ原 真紀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"404"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"F"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"AKA “Soul Speed”."},{"spoiler":false,"text":"Maki is affiliated with a hostile Russian crime syndicate; it is likely that she is being employed by the organization as both a contract killer and bagman."},{"spoiler":false,"text":"Maki is strong and well-built, making her handy in a fight. She wields four Glock 26s, and goes by many aliases. Though wary of others and very quick to anger, Maki’s actually remarkably naïve."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c59707"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/208223c03ed4f8efaa8c02d0340308906f671cd0bf672768ef41c43bf65a995c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90e07f672e4b5cc4f5569631bdfc93d31c239a43d9b69d8197caa83127fa7532.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南條 愛乃","creatorId":"vndb:s62","sourcePersonId":"vndb:s62","canonicalEntityId":"vndb:s62","name":"南條 愛乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80726","source":"vndb"}]},{"characterId":"char_vndb_c61352","characterName":"タナトスシステム","sourceIds":{"vndbCharacterId":"c61352"},"originalCharacterName":"タナトスシステム","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/826391ec0188990dd3200831096dfb2121ffd2cce467e06796f4a597142f6eb8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6de7847033941598ed7a1c1cdedd3bd770beae8cf7be742b0ea7aa0640a2eb3a.webp","width":256,"height":157,"source":"static-detail"},"actors":[{"creditedName":"友永 朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80727","source":"vndb"}]},{"characterId":"char_vndb_c62418","characterName":"九真城 恵","sourceIds":{"vndbCharacterId":"c62418"},"originalCharacterName":"九真城 恵","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1118"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A sniper from the SORD unit based at St. Aile’s International, sister school to Mihama Academy."},{"spoiler":false,"text":"It’s said that once she has you in her sights, there’s no escape - hence her nickname, “Mystic Eye”. Her main weapon is a Blaser R93."},{"spoiler":false,"text":"Gumi behaves like an old-school war veteran, and tends to adopt a ludicrously single-minded approach to her duties. Burning with a powerful sense of justice, Gumi takes a hard line against unscrupulous behavior; the harshness of her rebukes can come as quite a shock."},{"spoiler":false,"text":"Her special skill is speed eating, and she won’t be beaten in this by anyone."},{"spoiler":false,"text":"\"Sorry, senpai. There's still something I need to do - one task I have to complete.\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c62418"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a27cc28a6d01148bbc9f150ca76412fbf697a54f71c55a544e245477a0d1504.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/9061433466960d92af3dcbd46029aa318443ffc8faa5d306316f82496f10d435.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三森 すずこ","creatorId":"vndb:s627","sourcePersonId":"vndb:s627","canonicalEntityId":"vndb:s627","name":"三森 すずこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80729","source":"vndb"}]},{"characterId":"char_vndb_c66510","characterName":"仙石 大雅","sourceIds":{"vndbCharacterId":"c66510"},"originalCharacterName":"仙石 大雅","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"729"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"67"},"hip":{"reviewState":"source-only","source":"vndb","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"First cousin to Sengoku Ichiru, and an elementary student in Mihama Academy’s sapper school. Taiga’s always lived a pampered life, having grown up as heiress to the Sengoku estate. She’s a quick-witted and intelligent girl, as evidenced by the fact that she’s already passed her university entrance exams."},{"spoiler":false,"text":"With all the expectations heaped on her, it’s only natural that Taiga should come across as a little arrogant. This is one of the reasons why she tends to keep her distance from other people - though she’s quite happy on her own. Rena calls her “The Milquik Master”, following a serendipitous encounter back when she first arrived at Mihama."},{"spoiler":false,"text":"Taiga is intent on participating in activities that are usually closed to children of her stature; she cares little for age restrictions, nor other people’s opinions of her. Eventually her persistence pays off, when Haruto finally heeds her request to join Class A."},{"spoiler":false,"text":"\"Kujirase... Where am I to be allowed out into the field?\""},{"spoiler":false,"text":"From the official site"}],"source":"vndb","sourceCharacterId":"c66510"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2bad3a50b2218cd8f41666d81eb4c23ceeab51d6af36cff7125f6e4bb6220be.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/898762bc520a3ce3bf8961511fd30153c15600096ee272fa1520e1b418668184.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高森 奈津美","creatorId":"vndb:s979","sourcePersonId":"vndb:s979","canonicalEntityId":"vndb:s979","name":"高森 奈津美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80730","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p26","sourceCompanyId":"egs:brand:1866","canonicalEntityId":"vndb:p26","name":"PROTOTYPE","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:30350:1866","source":"egs"},{"companyId":"vndb:p26","sourceCompanyId":"vndb:p26","canonicalEntityId":"vndb:p