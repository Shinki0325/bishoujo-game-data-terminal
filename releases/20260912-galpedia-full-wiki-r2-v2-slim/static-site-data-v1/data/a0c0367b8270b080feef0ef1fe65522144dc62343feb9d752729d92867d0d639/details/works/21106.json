cter-voice:236651:153087:7169:1","source":"bangumi"}]},{"characterId":"char_c29441","characterName":"早乙女 沙月","sourceIds":{"bangumi":[{"characterId":"153089","match":"exact-normalized-name-in-linked-work","subjectId":"236651"}],"egsCharacterIds":["5298"],"vndbCharacterId":"c29441"},"originalCharacterName":"早乙女 沙月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"埋め込まれた触手のタネがフタナリに育ち、妹達に異常な愛情を持ってしまう姉キャラ。スタイルは良く、学校でも人気は有るが家では次女に面倒を見て貰っている。"}],"source":"egs","sourceCharacterId":"5298","sourceWorkId":"21106","spoiler":false},{"segments":[{"spoiler":false,"text":"清楚でおっとりした姉。"},{"spoiler":false,"text":"スタイルが良く学園でも人気はあるが、家では次女に面倒を見てもらっている。"},{"spoiler":false,"text":"陰核に埋め込まれた触手のタネがフタナリに育ち、妹たちに異常な愛情を持ってしまう。"},{"spoiler":false,"text":"男根の扱いに戸惑っているところ、電車で遭遇した痴漢から “手ほどき” を受けることになる。"}],"source":"bangumi","sourceCharacterId":"153089"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1cf844bab9e11feca2901efbc7df749562bc0a32bc560b9861f43b9ccf6ebf9b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cfa0dc05d7caab6f1967a15c482b7fb2812b42e46f6c6408e2d27bb51735928.webp","width":99,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤宮菜穂","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:236651:153089:6019:1","source":"bangumi"}]},{"characterId":"char_c29442","characterName":"早乙女 美星","sourceIds":{"bangumi":[{"characterId":"153090","match":"exact-normalized-name-in-linked-work","subjectId":"236651"}],"egsCharacterIds":["5300"],"vndbCharacterId":"c29442"},"originalCharacterName":"早乙女 美星","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"３姉妹でも特に胸が大きく、コンプレックスを持っていていつも前屈みに歩いている。"},{"spoiler":false,"text":"目立つ事が嫌いだで羞恥心が強く、露出系のプレイに敏感に反応してしてしまう。"}],"source":"egs","sourceCharacterId":"5300","sourceWorkId":"21106","spoiler":false},{"segments":[{"spoiler":false,"text":"羞恥心が強く、目立つことが嫌いな三女。"},{"spoiler":false,"text":"胸が大きくコンプレックスになっていて、いつも前屈みに歩いている。"},{"spoiler":false,"text":"しかし実験ではさらに胸を大きくされ、露出を強要される。"},{"spoiler":false,"text":"異常空間で全裸登校させられるなど、異常な羞恥責めに遭うことに。"}],"source":"bangumi","sourceCharacterId":"153090"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/7749dc12c6ec4c5bf9fc49a7264bc738d7c27e2cb1c03cceb7cc9aedc905e78d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94cf0b3f6ad9224abeabfb5fc37fd00a859f0882e6d90750c5a5ad5cce3daee5.webp","width":104,"height":256,"source":"static-detail"},"actors":[{"creditedName":"清水美紗","creatorId":"vndb:s1975","sourcePersonId":"vndb:s1975","canonicalEntityId":"vndb:s1975","name":"よもぎかすみ(蓬かすみ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:236651:153090:21151:1","source":"bangumi"}]},{"characterId":"char_c29443","characterName":"幻夢","sourceIds":{"bangumi":[],"egsCharacterIds":["5301"],"vndbCharacterId":"c29443"},"originalCharacterName":"幻夢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"侵蝕シリーズに登場する淫魔。"},{"spoiler":false,"text":"今回は侵蝕１より前の、現世に出たばかりの頃。外見上はシリーズ最年少に。遺跡調査中に迷い込んだヒロイン達を使って魔力を回収する事を目的として巻き込んで行く。"}],"source":"egs","sourceCh