ce-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Protagonist of the second story. After his childhood heart problems got worse by time went on, Akihito refuses to go to school and has turned into a shadow of his past self, who used to be good at studying and exercising and got along with everyone."},{"spoiler":true,"text":"He's actually in a coma after a failed suicide attempt. The whole story is his dream while being in coma."}],"source":"vndb","sourceCharacterId":"c6813"},{"segments":[{"spoiler":false,"text":"小学生の頃は勉強も運動もできて、皆から憧れられる存在だったのだが、今は心臓の病のせいで不登校になっている。"},{"spoiler":false,"text":"明るく屈託のなかった性格は、歳月を経て暗く疑り深い性格へと変貌していた。"},{"spoiler":false,"text":"幼馴染で初恋の相手・沢渡雫には、変わらぬ愛情とわだかまりを同時に感じている。"}],"source":"egs","sourceCharacterId":"8504","sourceWorkId":"17089","spoiler":false},{"segments":[{"spoiler":false,"text":"小学的时候是运动和学习都被大家所憧憬的存在。"},{"spoiler":false,"text":"但是现在因为心脏病的原因而停止上学。"},{"spoiler":false,"text":"开朗和无忧无虑的性格饱经岁月洗礼，变成疑心很重的阴暗性格。"},{"spoiler":false,"text":"对于青梅竹马和初恋对象・泽渡雫，产生了不一样的爱情与隔阂的感觉。"}],"source":"bangumi","sourceCharacterId":"86452"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/399f627f29e5b79acb4c4d573f5f1e0e1c1c9357c3eef6d67210c147540030c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/278133fa5b9cfb0267a60062f6c4ae559eafcc7eb2c494fcd6ff357908c439c9.webp","width":206,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c6814","characterName":"沢渡 雫","sourceIds":{"bangumi":[{"characterId":"16163","match":"exact-normalized-name-in-linked-work","subjectId":"41128"}],"egsCharacterIds":["8501"],"vndbCharacterId":"c6814"},"originalCharacterName":"沢渡 雫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirec