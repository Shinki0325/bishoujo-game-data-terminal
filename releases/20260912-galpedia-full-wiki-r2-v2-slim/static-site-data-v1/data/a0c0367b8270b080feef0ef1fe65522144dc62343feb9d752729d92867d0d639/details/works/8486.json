erId":"70990"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdf71a3605d9af13223699aec6164df72790ed2c997fa9215abff101016bd807.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbb517f556e4d3f4a0b70a8d733ff2c6ad968c305e8a7019110bb1875ea06d8c.webp","width":155,"height":256,"source":"static-detail"},"actors":[{"creditedName":"萩原えみこ","creatorId":"vndb:s867","sourcePersonId":"vndb:s867","canonicalEntityId":"vndb:s867","name":"萩原 えみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:238949:70990:4854:1","source":"bangumi"}]},{"characterId":"char_c67423","characterName":"茅ヶ崎 園子","sourceIds":{"bangumi":[{"characterId":"71473","match":"exact-normalized-name-in-linked-work","subjectId":"238949"}],"egsCharacterIds":["22360"],"vndbCharacterId":"c67423"},"originalCharacterName":"茅ヶ崎 園子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"St.アルクトゥルスの芸術科に通う学生。"},{"spoiler":false,"text":"家庭的で優しく、人当たりの良い性格から、男子学生からの人気も高い。"},{"spoiler":false,"text":"ストーカーによる性的暴行を受けた過去を持ち、そうしたことから全寮制の学園に入れられた。"},{"spoiler":false,"text":"しかし、学園がレイプ事件に巻き込まれ、その両親の配慮が裏目になってしまう。"}],"source":"egs","sourceCharacterId":"22360","sourceWorkId":"8486","spoiler":false},{"segments":[{"spoiler":false,"text":"家庭的で優しく、人当たりのいい、他人に慕われやすい少女である。"},{"spoiler":false,"text":"料理に裁縫といったスキルも高く、オルガン演奏が得意でパイプオルガンも弾ける所から、男子学生の人気も非常に高い。"},{"spoiler":false,"text":"過去にストーカーによる性的暴行を受けた経歴があり、そういった物事から遠ざける為に、園子は全寮制の学園に入れられた。"},{"spoiler":false,"text":"その配慮が逆に、逃げる事の出来ない凌辱の檻であったという事は、まだ現時点では誰も知る由も無かった。"}],"source":"bangumi","sourceCharacterId":"71473"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/9090853e8e304b6d0d9d85b6b54a6e9a4df16ae897119b10f132e49d92c24647.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/413725f07f6c642debeb11c0a71fd2146143b4accea01af61536c8441209c1f7.webp","width":141,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:238949:71473:4463:1","source":"bangumi"}]},{"characterId":"char_c67424","characterName":"クリエール・キャロライン","sourceIds":{"bangumi":[{"characterId":"71474","match":"exact-normalized-name-in-linked-work","subjectId":"238949"}],"egsCharacterIds":["22361"],"vndbCharacterId":"c67424"},"originalCharacterName":"クリエール・キャロライン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"St.アルクトゥルスの芸術科に通う学生。"},{"spoiler":false,"text":"園子のルームメイトであり、芸術科の寮長も務めている。"},{"spoiler":false,"text":"多感で、かなりミーハーで、ちゃらんぽらんな女の子。"},{"spoiler":false,"text":"それでいて人を引っ張っていくリーダーシップがあり、他の学生から慕われている。"},{"spoiler":false,"text":"「クリエ」と愛称で呼ばれることが多いが、イスカにそう呼ばれることに嫌悪感がある。"}],"source":"egs","sourceCharacterId":"22361","sourceWorkId":"8486","spoiler":false},{"segments":[{"spoiler":false,"text":"芸術科に所属する女学生で帰国子女。"},{"spoiler":false,"text":"園子のルームメイトであり、芸術科の寮長を務めている。多感で子猫のような印象を他人に与える所が強い。"},{"spoiler":false,"text":"かなりのミーハー気質でかつ勢いのある性格で、怜音とは逆に慕われる寮長である反面、ちゃらんぽらんな所も多い。"},{"spoiler":false,"text":"皆からは「クリエ」と略されてているが、イスカにそう呼ばれると少しだけ嫌そうな顔をする。"},{"spoiler":false,"text":"それはクリエ自身が優秀な部類に属する学生である為、イスカの実力を理解できて劣等感を覚えているからという所でもある。"}],"source":"bangumi","sourceCharacterId":"71474"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/301487000c8ea5198fb878b5bf3620fdb078f2344f51371d9c9f73835885b036.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e88eaeb8cf47be7ee6363bbfbbc7b15b1912d20b1ce1e5fc941d952f8f52a88.webp","width":130,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幡宮かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:238949:71474:5940:1","source":"bangumi"}]},{"characterId":"char_c67425","characterName":"稲城 衣里","sourceIds":{"bangumi":[{"characterId":"71475","match":"exact-normalized-name-in-linked-work","subjectId":"238949"}],"egsCharacterIds":["22362"],"vndbCharacterId":"c67425"},"originalCharacterName":"稲城 衣里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"St.アルクトゥルスの神学科に通う学生。"},{"spoiler":false,"text":"同学科において抜群の成績を誇る才女。"},{"spoiler":false,"text":"容姿端麗、運動神経良好、穏和な性格と非の打ち所がなく、優雅な立ち振る舞いも相俟って、学園では羨望を集めている。"},{"spoiler":false,"text":"しかし、天才故に抱える独特の孤独感に苛まれている。"},{"spoiler":false,"text":"そんな彼女は、同じ孤独を抱えるイスカに「天使ゲーム」を持ち掛ける。"}],"source":"egs","sourceCharacterId":"22362","sourceWorkId":"8486","spoiler":false},{"segments":[{"spoiler":false,"text":"「進学科」でもある神学科において抜群の成績を誇る才女。"},{"spoiler":false,"text":"抜群の成績、運動神経良好、性格は穏和と非の打ち所がない。"},{"spoiler":false,"text":"ただその反面、並び立つ人物が存在しない為に独特の感性と孤独感を持ち合わせている。"},{"spoiler":false,"text":"そんな彼女は『天使ゲーム』を立案し、イスカに持ちかける。"}],"source":"bangumi","sourceCharacterId":"71475"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a22a6774904347aa7767d38a32356322d8e175d20bb85d03ac14f1cdef45f1f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/2485bc88726eea620356571a6d549a6265cd15b823a6f46080c7d57b3767839f.webp","width":185,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:238949:71475:5890:1","source":"bangumi"}]},{"characterId":"char_c67426","characterName":"仁科 怜音","sourceIds":{"bangumi":[{"characterId":"146068","match":"exact-normalized-name-in-linked-work","subjectId":"238949"}],"egsCharacterIds":["22363"],"vndbCharacterId":"c67426"},"originalCharacterName":"仁科 怜音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"St.アルクトゥルスの神学科に通う学生。"},{"spoiler":false,"text":"プロテスタント色が強い“ファンタメンタリズム（聖書が全て事実という考え方）”寄りの信仰を持つ少女。"},{"spoiler":false,"text":"しかし、彼女自身はカトリック信仰で、いささかな矛盾を胸に秘める。"},{"spoiler":false,"text":"成績は常に上位にあるものの、衣里には全科目で後塵を拝し、劣等感を抱いている。"},{"spoiler":false,"text":"神学科の寮長という立場から、規律をもって他人を押えつけようとし、他の学生から嫌われている。"}],"source":"egs","sourceCharacterId":"22363","sourceWorkId":"8486","spoiler":false},{"segments":[{"spoiler":false,"text":"ファンタメンタリズム（聖書が全て事実という考え方）寄りな信仰態度を持つ、いささか余裕のない感じの人物。"},{"spoiler":false,"text":"もっとも、ファンタメンタリズムはプロテスタント色が強いが、この学園と怜自身はカトリックである。"},{"spoiler":false,"text":"成績は神学科の中でも上位ではあるが、衣里にすべての科目で負けている事に対して劣等感を抱いている。"},{"spoiler":false,"text":"またそういった劣等感を払拭する為に剣道部に在籍し、この学内では珍しい有段者でもある。"},{"spoiler":false,"text":"神学科の寮長という立場から、規律でもって他人を押さえつけようという一面が強い。"},{"spoiler":false,"text":"そのため、基本的に彼女はイスカとは別の意味で嫌われ者である。"}],"source":"bangumi","sourceCharacterId":"146068"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bce046feff17edf675817e0e9cb2ba367b22fd81d4527218dc996442072daa93.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f36347dc89560fe07b4110590a53e93ce81b8a47e3c657341dcd835d4e39f55b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:238949:146068:4675:1","source":"bangumi"}]},{"characterId":"char_c67427","characterName":"御園尾 皐月","sourceIds":{"bangumi":[{"characterId":"146069","match":"exact-normalized-name-in-linked-work","subjectId":"238949"}],"egsCharacterIds":["22364"],"vndbCharacterId":"c67427"},"originalCharacterName":"御園尾 皐月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"St.アルクトゥルスの神学科に通う学生。"},{"spoiler":false,"text":"何事にも消極的で、他人の視線を伺う、小動物のようなオドオドした雰囲気の少女。"},{"spoiler":false,"text":"衣里のルームメイトである彼女は、衣里の侍女のような立ち居振る舞いが目立ち、衣里の取り巻きと揶揄され、陰口を叩かれることもしばしば。"},{"spoiler":false,"text":"無能なように見えて、事務能力に長けており、衣里の立案した「天使ゲーム」を色々とサポートすることになる。"},{"spoiler":false,"text":"衣里に馴れ馴れしいイスカに嫌悪の感情を抱いているが、それを必至に抑えている。"}],"source":"egs","sourceCharacterId":"22364","sourceWorkId":"8486","spoiler":false},{"segments":[{"spoiler":false,"text":"神学科に所属、衣里のルームメイトで侍女のように立ち振る舞っている、取り巻きとも一部に言われている学生。"},{"spoiler":false,"text":"人の視線を常に伺う様子は小動物的であり、また、不安定な性格を表している。"},{"spoiler":false,"text":"衣里のそばにいる事で他人の恨みを買う事もあるが、消極的すぎる性格もあって目立った○○を被ってはいない。"},{"spoiler":false,"text":"表面的な特徴とは裏腹に、事務処理などといった物事は得意であり、衣里の立案した天使計画では色々と活動する。"},{"spoiler":false,"text":"衣里の近くにいるイスカに対しては嫌悪の感情を抱いているが、それは現時点では必死に隠されている。"}],"source":"bangumi","sourceCharacterId":"146069"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://w