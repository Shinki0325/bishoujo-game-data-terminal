r":[{"creditedName":"村田 あゆみ","creatorId":"vndb:s4642","sourcePersonId":"vndb:s4642","canonicalEntityId":"vndb:s4642","name":"村田 あゆみ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:31432","source":"vndb"},{"creditedName":"新川 宗平","creatorId":"vndb:s11910","sourcePersonId":"vndb:s11910","canonicalEntityId":"vndb:s11910","name":"新川 宗平","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:31437","source":"vndb"},{"creditedName":"菅原 健","creatorId":"vndb:s13548","sourcePersonId":"vndb:s13548","canonicalEntityId":"vndb:s13548","name":"菅原 健","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:31438","source":"vndb"},{"creditedName":"泉 達也","creatorId":"vndb:s32633","sourcePersonId":"vndb:s32633","canonicalEntityId":"vndb:s32633","name":"泉 達也","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:31440","source":"vndb"},{"creditedName":"平田 純子","creatorId":"vndb:s560","sourcePersonId":"vndb:s560","canonicalEntityId":"vndb:s560","name":"彩音","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:31442","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c143381","characterName":"風海 純也","sourceIds":{"vndbCharacterId":"c143381"},"originalCharacterName":"風海 純也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"23"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the Hayarigami series."},{"spoiler":false,"text":"He was once a promising detective in the Tokyo Metropolitan Police Department's Criminal Investigation Bureau's Section 1. At the start of the game, he was ordered to be transferred to the MPD's Historical Archives Section instead, located on the 5th basement floor, due to a troubling incident that involved him."},{"spoiler":false,"text":"His rank is lieutenant. He has good running skills, and he rarely misses the criminal in the chase."}],"source":"vndb","sourceCharacterId":"c143381"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e2857f0604c2d2ff95394b324a94f58f428454a5af95fac2c735cbaf113786b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee81ce807f357726bc973cd35614835e6584df714f321be6524f03c38f200e08.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c143382","characterName":"小暮  宗一郎","sourceIds":{"vndbCharacterId":"c143382"},"originalCharacterName":"小暮  宗一郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"27"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He was partnered with the protagonist during the first case they handled. Afterwards, he began working in the Historical Archives Section alongside the protagonist. His rank is sergeant."},{"spoiler":false,"text":"Despite his appearance as a veteran detective, he is still in his 20s and single. He is a third-degree black belt in judo, a third-degree black belt in kendo, and a second-degree black belt in karate, and is a passionate and enthusiastic person. However, contrary to his appearance, he is extremely averse to blood and ghost stories."}],"source":"vndb","sourceCharacterId":"c143382"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41afa31c7bff4145faf588800012bdff20dd89bda3716b04adab2dbd75e6a767.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/012d7f5681da1359eb3f7fe954b786c7bfbb380b58cc1f8be2c10fdb5fcacf00.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c143383","characterName":"犬童 蘭子","sourceIds":{"vndbCharacterId":"c143383"},"originalCharacterName":"犬童 蘭子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female police inspector who speaks in a suspicious Osaka dialect and is in charge of the Historical Archives Section. She is the protagonist's superior, but she rarely does any real work, instead spending most of her time watching TV or engaging in public gambling."},{"spoiler":false,"text":"Occasionally, she shows her extensive knowledge of the occult, making her a mysterious figure."}],"source":"vndb","sourceCharacterId":"c143383"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/3485e4c29eea3ddc34a2ab2f9269d67f48a351b4934b0303456d98a288490fc3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/009d114b2ca706b18123b5f9fd1d8683afee90fc35243ad5fe5ce452d206fa92.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c143384","characterName":"霧崎 水明","sourceIds":{"vndbCharacterId":"c143384"},"originalCharacterName":"霧崎 水明","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He works as a folklore lecturer at an university in Tokyo and is well-versed in the occult and urban legends. He lost his parents during his middle school years and was taken in by the protagonist's family. To the protagonist, he is like an older brother."}],"source":"vndb","sourceCharacterId":"c143384"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/6553c68810c01a4e4d890e37132c5a294db390597580a7dcf3747f28cf2677bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c29e8be71575384fa7ddfd859e3e638eff456031b1849a3d64d5ae62c56de487.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c143385","characterName":"式部 人見","sourceIds":{"vndbCharacterId":"c143385"},"originalCharacterName":"式部 人見","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"29"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a medical examiner and also teaches forensic medicine as an associate professor at the same university. She has been a friend of Kirisaki since their university days, but she is a contrasting figure as an occult skeptic."}],"source":"vndb","sourceCharacterId":"c143385"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d55aeded31475aa8cafcb6b7a7018fc969aac7e9877530641bdc8a0c2119a678.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a003019802ee6068529b861c2cac2401d04dff141de413385e322ba907a785ee.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c143386","characterName":"間宮 ゆうか","sourceIds":{"vndbCharacterId":"c143386"},"originalCharacterName":"間宮 ゆうか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An occult enthusiast who is a student at the university where Kirisaki teaches. She has taken it upon herself to be an assistant."},{"spoiler":false,"text":"She has a passionate, almost obsessive, drive to solve mysterious cases, but her psychic abilities are completely non-existent."}],"source":"vndb","sourceCharacterId":"c143386"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a1c65ff2894e03421eab03ea0ff871d3ef8f1de72ae3ad94cd2ef1c237b0b21.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/2812f2095e2ee11bd820cec786c2eac7fa1d0a08648e19cf08b53f109a80e915.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c143389","characterName":"道明寺 秋彦","sourceIds":{"vndbCharacterId":"c143389"},"originalCharacterName":"道明寺 秋彦","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious person who brings strange cases to the protagonist. He claims to be a detective from the MPD, but each time he appears he gives a different title and affiliation, making his true identity unknown."}],"source":"vndb","sourceCharacterId":"c143389"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/3514db57715b1ea706e7eb4a6ef8fda5c87cd3bc9091acc679ab2d815968dac8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c178d3741e88ba795c872ad617bc477f5caf76c25c89aebb9983ac23ca23159f.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":