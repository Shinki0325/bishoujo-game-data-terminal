]},{"characterId":"char_bangumi_202806","characterName":"Pamela","sourceIds":{"bangumi":[{"characterId":"202806","match":"source-roster","subjectId":"38522"}]},"originalCharacterName":"Pamela","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"黒は何者をも受け入れ、混沌とし、情欲をも無償で受け入れる。"},{"spoiler":false,"text":"整った四肢は男を抱きとめるためであり、頬を埋めることに飽く事のない体は束縛のない安息の地でもある。"},{"spoiler":false,"text":"だから、心置きなく抱けばいい、注げば注ぐほど、彼女は深く悦ぶのだから。"},{"spoiler":false,"text":"求められ、受け入れる。それだけの関係。"},{"spoiler":false,"text":"故に、彼女は男を愛する娼婦である"}],"source":"bangumi","sourceCharacterId":"202806"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c6d8cd2098d7438a97755bca630dea0124bd5237f17f7c33bcdbb03ea7e0209.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5460080bb820642aa83c40c10982fbfcce1493042ac62e17c72289f7ea47811.webp","width":190,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_202807","characterName":"Fiona","sourceIds":{"bangumi":[{"characterId":"202807","match":"source-roster","subjectId":"38522"}]},"originalCharacterName":"Fiona","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"純潔、清廉、無垢。白を纏う彼女は娼婦であるのか？"},{"spoiler":false,"text":"無論、この世界に立つからには、そうでなければならない。"},{"spoiler":false,"text":"望むか、望まぬか、何れかの時に知れる事。"},{"spoiler":false,"text":"記憶は美しく曇りのない水晶柱。"},{"spoiler":false,"text":"だが、決して割れぬわけでもない。"},{"spoiler":false,"text":"故に、彼女は穢れ無き娼婦であろうか？"}],"source":"bangumi","sourceCharacterId":"202807"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url"