e","relationId":"vndb:vn-staff:211742","source":"vndb"},{"creditedName":"A子","creatorId":"vndb:s11939","sourcePersonId":"vndb:s11939","canonicalEntityId":"vndb:s11939","name":"A子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:211744","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c143907","characterName":"牛尾 朱美","sourceIds":{"vndbCharacterId":"c143907"},"originalCharacterName":"牛尾 朱美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"24"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a tall, strong, and athletic girl who laughs a lot and is cheerful. She often teases the protagonist, who is not used to women."},{"spoiler":false,"text":"She has a very strong sex drive and wants to have sex all day. She and her husband have a very good relationship, but he is a truck driver and is often away from home, making her feel lonely."},{"spoiler":false,"text":"She does not worry about being seen in her underwear on the apartment premises. She has a secret complex about her puffy areolas."},{"spoiler":false,"text":"From DLsite"}],"source":"vndb","sourceCharacterId":"c143907"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97be97b547c3b522ee1a6d9b56c7df34ae7f1386e504cee9c1f41555623a996d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4059540f4ada10e442cefa1145ee2d8944d5abc9065a19352b349ea471ae134.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"御苑生 メイ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99277","source":"vndb"}]},{"characterId":"char_vndb_c143908","characterName":"熊谷 詩乃","sourceIds":{"vndbCharacterId":"c143908"},"originalCharacterName":"熊谷 詩乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"26"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She grew up as a young lady from a wealthy family. She met her husband at a party with other schools when she was in college, and they became involved in a relationship."},{"spoiler":false,"text":"She has few friends and feels lonely in an environment where she does not know anyone since she left her hometown."},{"spoiler":false,"text":"She is the type to compare herself to the heroines of tv dramas, and easily gets swept away with the situations and circumstances found in the show."},{"spoiler":false,"text":"She finds pleasure in the idea of being in similar situations found in tv dramas due to her sense of immorality and guilt."},{"spoiler":false,"text":"From DLsite"}],"source":"vndb","sourceCharacterId":"c143908"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f6656c2128cd99d48a9a33d68db9f25f1acac3e18b1bfc9c472889c4595a9c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba674e0a8be6b59896785e9f694782831181cca72dab11c88034aaae5e3d853b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎津 まお","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99276","source":"vndb"}]},{"characterId":"char_vndb_c150422","characterName":"仲間 工","sourceIds":{"vndbCharacterId":"