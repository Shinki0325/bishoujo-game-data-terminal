umi":[{"characterId":"47084","match":"exact-normalized-name-in-linked-work","subjectId":"27629"}],"egsCharacterIds":["18283"],"vndbCharacterId":"c166839"},"originalCharacterName":"姫原 夢加","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"11/11"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"遊斗、空たちのクラスメイト。"},{"spoiler":false,"text":"その大人びた雰囲気から、男子たちに人気がある。"},{"spoiler":false,"text":"当然、何人もの相手に言い寄られているが、全て相手にせず、適当にあしらっている。"}],"source":"egs","sourceCharacterId":"18283","sourceWorkId":"10782","spoiler":false},{"segments":[{"spoiler":false,"text":"遊斗や空たちのクラスメイト。その独特の大人っぽさが同年代以上の魅力を醸し出している女の子。"},{"spoiler":false,"text":"当然人気もあり、数多くの男たちに言い寄られているがそのどれもをあしらっている。"},{"spoiler":false,"text":"特定のグループには属していないが、遊斗や空たちとはそこそこ話す仲。"},{"spoiler":false,"text":"地方から引っ越してきたらしい噂が流れているが、夢加は自分のことをあまり話さないので、詳しく知る者はいない。"}],"source":"bangumi","sourceCharacterId":"47084"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/0450bdf6e0fe6e00f1252792e517e1b4d736905109c69b5f304d7ef0e80cb51e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d3a1c4db15510ecdc97b5f642f7245e65ec65e9d4ecf928b0fba6699586a962.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水杜明寿香","creatorId":"vndb:s1200","sourcePersonId":"vndb:s1200","canonicalEntityId":"vndb:s1200","name":"水杜 明寿香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:27629:47084:4938:1","source":"bangumi"}]},{"characterId":"char_c166840","characterName":"こよみ","sourceIds":{"bangumi":[{"characterId":"47083","match":"exact-normalized-name-in-linked-work","subjectId":"27629"}],"egsCharacterIds":["18282"],"vndbCharacterId":"c166840"},"originalCharacterName":"こよみ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"130"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"29"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魂をあの世へと導く水先案内人。"},{"spoiler":false,"text":"つまり「死神」。死神暦は10年。"},{"spoiler":false,"text":"現世へ強い思いを持つ魂たちの解放も、彼女の仕事の一つである。"}],"source":"egs","sourceCharacterId":"18282","sourceWorkId":"10782","spoiler":false},{"segments":[{"spoiler":false,"text":"魂をあの世へと導く案内人。つまりは「死神」である。"},{"spoiler":false,"text":"稀に現世への強い想いが残る魂があり、そういった魂の解放も仕事のうち。"}],"source":"bangumi","sourceCharacterId":"47083"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/526e55a120df6c13a5e6becc988a3013d4902d7cc69d5f6a86cd3e39295d2f6e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20d73d706f9817a4ab04e01d7253e8dd57e85f59a8fcd3fd2258be6c7216c16d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井清己","creatorId":"vndb:s771","sourcePersonId":"vndb:s771","canonicalEntityId":"vndb:s771","name":"浅井 清己","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:27629:47083:4336:1","source":"bangumi"}]},{"characterId":"char_c55358","characterName":"夢村 登瀬","sourceIds":{"bangumi":[{"characterId":"77434","match":"exact-normalized-name-in-linked-work","subjectId":"27628"}],"egsCharacterIds":["18285"],"vndbCharacterId":"c55358"},"originalCharacterName":"夢村 登瀬","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"66"},"height":{"reviewState":"no-conflict","source":"vndb","value":"140"},"hip":{"reviewState":"source-only","source":"vndb","value":"69"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"35"}},"descriptions":[{"segments":[{"spoiler":false,"text":"容姿は子供そのものだが、正真正銘、広宇の祖母である。"},{"spoiler":false,"text":"前に出版した夢占いの本がベストセラーになり、今や地元だけに留まらず全国的にもその名が知れ渡っているが、広宇からしてみたらただの毒舌妖怪ばばあである。"},{"spoiler":false,"text":"甘い物に目がなく、料理をするとなんでも甘く作ってしまう。"},{"spoiler":false,"text":"糖分控えめで注文すると塩分が多くなる。"}],"source":"egs","sourceCharacterId":"18285","sourceWorkId":"8943","spoiler":false},{"segments":[{"spoiler":false,"text":"『夢見師』から登場の夢占い師。"},{"spoiler":false,"text":"甘いものがなによりの好物。"},{"spoiler":false,"text":"一見、幼い少女に見えるが、本当の年齢は……？"}],"source":"egs","sourceCharacterId":"18285","sourceWorkId":"10782","spoiler":false},{"segments":[{"spoiler":false,"text":"虽然长相看起来很象小孩子，实实在在的是広宇的祖母。"},{"spoiler":false,"text":"因为之前出版的占梦书销量很好，虽然现在住在老家，但是在全国都很有名，对広宇来说却只是个毒舌妖怪的老太婆。喜欢吃甜食，不管什么食物都做的很甜。如果要求少放糖的话就会放很多盐。"}],"source":"bangumi","sourceCharacterId":"77434"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b76461ce17b35a4f22d9c38a63fd23110cd4f6e2d5b34ad975c528f7d0daed3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/7277d56e27f447f775afcb4fe0752e5362de8e0f577d2cce8e7e3df65ce3cbef.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Yuki-Lin","creatorId":"vndb:s801","sourcePersonId":"vndb:s801","canonicalEntityId":"vndb:s801","name":"茉雪 千鶴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7949","source":"vndb"}]},{"characterId":"char_c64852","characterName":"天川環","sourceIds":{"bangumi":[{"characterId":"47078","match":"exact-normalized-name-in-linked-work","subjectId":"27629"}],"egsCharacterIds":["18277"],"vndbCharacterId":"c64852"},"originalCharacterName":"天川環","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1111"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"遊斗の初恋相手で、腐れ縁仲間。"},{"spoiler":false,"text":"環もまた、遊斗に惹かれていたが、お互い素直になれず、あと一歩が踏み出せずにいた。"},{"spoiler":false,"text":"遊斗に公園に呼び出された日、交通事故に遭ってしまい、不運にも亡くなってしまうが、幽霊として再び遊人の前に現れる。"}],"source":"egs","sourceCharacterId":"18277","sourceWorkId":"10782","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公、夢川遊斗の初恋の相手。遊斗、環、陽とは中学からの仲。"},{"spoiler":false,"text":"遊斗と同じく、お互い惹かれ合っていたが、素直になれず最後の１歩が踏み出せずにいた。"},{"spoiler":false,"text":"ある日、不運にも交通事故に出会い死亡してしまったが、環は遊斗のことが心配でこの世に留まった。"},{"spoiler":false,"text":"しかし環も自分の想いを、そしてちゃんとしたかたちでの別れを伝えたいと思っていた。"},{"spoiler":false,"text":"わかってはいるが、環は遊斗と一緒にいれる幸せに甘えてしまう。"}],"source":"bangumi","sourceCharacterId":"47078"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f425be6a434088706a846416fcc7f63b46083c0d3b93d0f649d82d327f001fa8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f944a19edcc843401c9940ba15c0c39d98498a284908969a9e41efeab0a8c47.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"谷井あすか","creatorId":"vndb:s657","sourcePersonId":"vndb:s657","canonicalEntityId":"vndb:s657","name":"谷井 あすか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:27629:47078:4593:1","source":"bangumi"}]},{"characterId":"char_c64853","characterName":"矢羽田空","sourceIds":{"bangumi":[{"characterId":"47079","match":"exact-normalized-name-in-linked-work","subjectId":"27629"}],"egsCharacterIds":["18278"],"vndbCharacterId":"c64853"},"originalCharacterName":"矢羽田空","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"516"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"空、環の腐れ縁仲間で、環とは親友同士だった。"},{"spoiler":false,"text":"何でも話せる間だった環に、空が唯一秘密にしていたのは「遊斗に惹かれている、自分の想い」――。"},{"spoiler":false,"text":"二人の気持ちに気づいていた空は、身を引こうと決めていたが、環が交通事故で亡くなってしまい、その心境に変化が訪れる。"}],"source":"egs","sourceCharacterId":"18278","sourceWorkId":"10782","spoiler":false},{"segments":[{"spoiler":false,"text":"環の親友。空と環は文字通りの親友だった。"},{"spoiler":false,"text":"互いに支え合い、空、環、遊斗はいつも一緒に過ごしてきた。"},{"spoiler":false,"text":"どんなことでも話し合える関係だったが、空には環にひとつだけ話せないことがあった。"},{"spoiler":false,"text":"それは自分の遊斗に対する想い。"},{"spoiler":false,"text":"付き合いの長さから、環の想い、そして遊斗も自分ではなく環に惹かれていることに気づいた空は、自ら身を引くことを心に決める。しかし、そんな矢先の環の事故死。悲しむ自分と、心の隅で喜んでしまった自分。"},{"spoiler":false,"text":"そんな自分がどうしようもなく嫌いになってしまい、皮肉にも環がいなくなったことで、遊斗に益々想いを伝えられなくなってしまった。"}],"source":"bangumi","sourceCharacterId":"47079"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/7261c39c4b0d37851ca804923a020f398e3d2ed5103d7d84340916bf02f61032.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd8bb241f2f9481a725da28a533ca3612c60a4b554fc1d151586a9177758af28.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松浦チエ","creatorId":"vndb:s774","sourcePersonId":"vndb:s774","canonicalEntityId":"vndb:s774","name":"松浦 チエ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:27629:47079:4425:1","source":"bangumi"}]},{"characterId":"char_c64854","characterName":"神代聖","sourceIds":{"bangumi":[{"characterId":"47080","match":"exact-normalized-name-in-linked-work","subjectId":"27629"}],"egsCharacterIds":["18279"],"vndbCharacterId":"c64854"},"originalCharacterName":"神代聖","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1008"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"遊斗の前に突如現れた幽霊少女。"},{"spoiler":false,"text":"口数が少なく、何を考えているのか掴めない不思議な雰囲気を持つ。"},{"spoiler":false,"text":"なぜ夢幻体になったのか？"},{"spoiler":false,"text":"彼女の未練とはいったい何なのか？"},{"spoiler":false,"text":"その答えは、彼女の特技に関係ありそうだが……？"}],"source":"egs","sourceCharacterId":"18279","sourceWorkId":"10782","spoiler":false},{"segments":[{"spoiler":false,"text":"ピアニストの父を持ち、その影響で自らもピアノの道を歩む。"},{"spoiler":false,"text":"父のようなピアノを弾きたい。聖にとって父は言葉以上の存在だった。"},{"spoiler":false,"text":"しかし、演奏旅行中、聖の父は帰らぬ人となってしまう。"},{"spoiler":false,"text":"そして、生きる希望を失った聖は自殺をしてしまった。"},{"spoiler":false,"text":"この世にはもう未練はないはずなのに……そう思っている聖だがなぜか成仏できずにいた。"},{"spoiler":false,"text":"その理由は自分でもわからなかった。否、わかろうとしていなかった。"},{"spoiler":false,"text":"自分がもう一度、ピアノを弾くことを夢見ていることに。"}],"source":"bangumi","sourceCharacterId":"47080"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/1477ceade408e1768c069418074d8604b1c5370dbf2321ffe31f4ab389735e3c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d442e2c6bb8e59866e45bb9f748d282a309e5c5f1e21aa740fc94fe1efa39073.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:27629:47080:4727:1","source":"bangumi"}]},{"characterId":"char_c64855","characterName":"御手洗 幽水","sourceIds":{"bangumi":[{"characterId":"47081","match":"exact-normalized-name-in-linked-work","subjectId":"27629"}],"egsCharacterIds":["18280"],"vndbCharacterId":"c64855"},"originalCharacterName":"御手洗 幽水","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"624"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"41"}},"descriptions":[{"segments":[{"spoiler":false,"text":"他人を寄せ付けないオーラを放つ少女。"},{"spoiler":false,"text":"性格はきつく、年功序列など彼女の辞書には存在しない。"},{"spoiler":false,"text":"「昔からこうだった」と彼女は言うが、幽霊になった妹・霊奈は「妹想いで優しい姉」だったらしい。"},{"spoiler":false,"text":"はたして、どちらの言葉が本当なのか――？"}],"source":"egs","sourceCharacterId":"18280","sourceWorkId":"10782","spoiler":false},{"segments":[{"spoiler":false,"text":"才能溢れる画家の卵だった。しかし絵の道に行ったのも親の目を引くため……。"},{"spoiler":false,"text":"生まれつき病弱だった妹の霊奈。両親は霊奈に付きっ切りで幽水に費やす時間はほとんどなかった。"},{"spoiler":false,"text":"『お姉ちゃんなんだから我慢しなさい』"},{"spoiler":false,"text":"その言葉を聞き続け成長してきた幽水。自分と同い歳なのに……。"},{"spoiler":false,"text":"幽水は毎回、その言葉を飲み込んでいた。幽水の心は成長するにつれ荒んでゆき、親から離れていく。妹の事は嫌いではなかったが、仲が良いとはいえない関係。"},{"spoiler":false,"text":"なんとか姉妹、仲良くなりたいと思っていた幽水だったが、どうしても親を独り占めしていると思ってしまい、上手くきっかけがつくれないでいた。"},{"spoiler":false,"text":"そこで考えたのが妹を描いた絵。それをプレゼントしようと意気込む幽水だったが、その絵が完成する前に妹はこの世を去ってしまった。それっきり幽水は絵を描くことをやめてしまう。"}],"source":"bangumi","sourceCharacterId":"47081"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4ff55069dc6365b8473e0a3d354d7f1b00d8841438510060294118cfe0d8ca84.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/dea59705db98d0808ef5a6746d1da09cea1788042ee413337d12a98e58ffd2c7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小暮英麻","creatorId":"vndb:s654","sourcePersonId":"vndb:s654","canonicalEntityId":"vndb:s654","name":"小暮 英麻","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:27629:47081:4282:1","source":"bangumi"}]},{"characterId":"char_c64856","characterName":"御手洗霊奈","sourceIds":{"bangumi":[{"characterId":"47082","match":"exact-normalized-name-in-linked-work","subjectId":"27629"}],"egsCharacterIds":["18281"],"vndbCharacterId":"c64856"},"originalCharacterName":"御手洗霊奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"624"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"41"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幽水の双子の妹。"},{"spoiler":false,"text":"生まれつき身体が弱く、若くしてこの世を去ってしまう。"},{"spoiler":false,"text":"けれど、姉のことが気がかりで成仏できない様子。"},{"spoiler":false,"text":"それは、いつも強がっている姉の本当の思いを、彼女だけが知っていたから――。"}],"source":"egs","sourceCharacterId":"18281","sourceWorkId":"10782","spoiler":false},{"segments":[{"spoiler":false,"text":"幽水の双子の妹。生まれつきの病気でこの世を去ってしまう。"},{"spoiler":false,"text":"しかし姉のことが気がかりで成仏できないでいた。"},{"spoiler":false,"text":"自分の前では強がっていた姉だが、本当は寂しがっていることを霊奈は知っていたから。"},{"spoiler":false,"text":"どうすれば姉を救えるか？そんな時、自分の姿を見ることができる遊斗と出会い、姉を救ってもらうよう頼み込むことに。"}],"source":"bangumi","sourceCharacterId":"47082"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/8563445bbceee274bc6fc03465e46923fc0dcb6af23af16f1e83f7c97034c1c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a4adcdb1ac2d659fbb4665b1881