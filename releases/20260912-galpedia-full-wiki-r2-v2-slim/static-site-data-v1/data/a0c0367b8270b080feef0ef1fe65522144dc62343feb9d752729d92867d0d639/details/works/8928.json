},"descriptions":[{"segments":[{"spoiler":false,"text":"幼くして居合の免許皆伝を修めた、ヴェインの一学年下の後輩。"},{"spoiler":false,"text":"気丈なしっかり者だが融通の利かない性格で、"},{"spoiler":false,"text":"それがトラブルの元になることもしばしば。"},{"spoiler":false,"text":"また、非常にたくましい想像力の持主で、多分に思い込みが激しい。"}],"source":"bangumi","sourceCharacterId":"158346"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"158346","value":"規則正しい生活"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"158346","value":"不潔な場所、だらしない人"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c172032e6b1850d4e9279211e4a43e1ba9941582380ed1da9b31fe8767a9d60.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/187524f5580e2737f44294a694d924c4b5caf8fe77030db5fcca02e660de0c6e.webp","width":155,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮崎羽衣","creatorId":"vndb:s273","sourcePersonId":"vndb:s273","canonicalEntityId":"vndb:s273","name":"宮崎 羽衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41272:158346:4773:1","source":"bangumi"}]},{"characterId":"char_bangumi_158347","characterName":"Mupe Oktavia Wondratschek VIII","sourceIds":{"bangumi":[{"characterId":"158347","match":"source-roster","subjectId":"41272"}]},"originalCharacterName":"Mupe Oktavia Wondratschek VIII","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"遥か遠い世界からやってきた謎の留学生。"},{"spoiler":false,"text":"ひょんなことからヴェインたちのアトリエで一緒に錬金術を学ぶことに。"},{"spoiler":false,"text":"壷のような乗り物に乗って学園をうろうろしているためか、"},{"spoiler":false,"text":"周りからはちょっとした変わり者だと思われている。"}],"source":"bangumi","sourceCharacterId":"158347"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"158347","value":"任侠、義理人情、兄弟仁義"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"158347","value":"愚鈍な民衆"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/298d81f91fcf30f972a37142ff77cfbcd25c44ed17f0ff777ba2d5af841ea9ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f7cc93ef187459f03da3258fa01a3e319709cde3cac61d389b3c9b4e35e43cc.webp","width":204,"height":256,"source":"static-detail"},"actors":[{"creditedName":"チョー","creatorId":"vndb:s1766","sourcePersonId":"vndb:s1766","canonicalEntityId":"vndb:s1766","name":"桐生大地","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41272:158347:3828:1","source":"bangumi"}]},{"characterId":"char_bangumi_160103","characterName":"Toni Eisler","sourceIds":{"bangumi":[{"characterId":"160103","match":"source-roster","subjectId":"41272"}]},"originalCharacterName":"Toni Eisler","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1230"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"179"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【マナケミア】"},{"spoiler":false,"text":"ヴェインに幾度となく因縁をつけて邪魔をしてくる上級生。いつもレーネと一緒に行動している。"},{"spoiler":false,"text":"目的のためには卑怯な手段も厭わない性格で、更に熱くなると目的すら選ばないが、一方でどこか悪人になりきれない面もある。ある人物の命令で動いている。"},{"spoiler":false,"text":"【マナケミア2】"},{"spoiler":false,"text":"アルレビス学園の万年平教師。実家は遠方のため、妻を残して、かれこれ三年単身赴任中。そのためかどうかはしらないが、終始機嫌が悪そうな顔をしている。"},{"spoiler":false,"text":"機嫌だけでなく態度も口も性格も悪いが、心の底では生徒たちを大切に思っている・・・たぶん。"},{"spoiler":false,"text":"自分が平教師で我慢しているのに、いきなり教頭として迎えられたグンナルが、ものすごく気に食わず、学生時代の因縁もあってか、顔を突き合わせてケンカをふっかける毎日である。"},{"spoiler":false,"text":"ウルリカ、クロエ、リリアが所属する錬金術科の担任。"}],"source":"bangumi","sourceCharacterId":"160103"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2de442ecf559243dabba1d6421eb606ec4d03a794fa91b5ea27ca02dd6bc5343.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/8842d05dc003d2954329fa678e72a4a5f95defbc0aef28451f483faf107804bc.webp","width":112,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真殿光昭","creatorId":"vndb:s887","sourcePersonId":"vndb:s887","canonicalEntityId":"vndb:s887","name":"真殿 光昭","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41272:160103:4313:1","source":"bangumi"}]},{"characterId":"char_bangumi_160121","characterName":"Seppl Kleiber","sourceIds":{"bangumi":[{"characterId":"160121","match":"source-roster","subjectId":"41272"}]},"originalCharacterName":"Seppl Kleiber","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0302"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"169"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【マナケミア】"},{"spoiler":false,"text":"ヴェインやフィロの担任教師。"},{"spoiler":false,"text":"やや軽いところがあるが、生徒からの人気は高い。"},{"spoiler":false,"text":"ヴェインを学園にスカウトした人物でもある。"},{"spoiler":false,"text":"【マナケミア2】"},{"spoiler":false,"text":"アルレビス学園の現校長。能力的にも人望的にも、特に秀でたものはないが、他に候補者がいなかったため、うっかり校長になってしまった。"},{"spoiler":false,"text":"しかし、彼が校長になってからのアルレビス学園は受難の連続、深刻な経営危機を迎えてしまう。"},{"spoiler":false,"text":"その危機を救ってくれたマルータに頭が上がらず、元々なかった校長としての威厳が、最近はますますなくなっている。"}],"source":"bangumi","sourceCharacterId":"160121"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75f42d1eaa292868c1962b66b9e509423baea3f4cfd10aed334cc4147056df98.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/010f8aca6463de7be7f533eb80b39832d853cf9664c4f05f009b442fa16861b5.webp","width":132,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上和彦","creatorId":"vndb:s374","sourcePersonId":"vndb:s374","canonicalEntityId":"vndb:s374","name":"井上和彦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41272:160121:1582:1","source":"bangumi"}]},{"characterId":"char_bangumi_36074","characterName":"帕梅拉·伊碧斯","sourceIds":{"bangumi":[{"characterId":"36074","match":"source-roster","subjectId":"11436"},{"characterId":"36074","match":"source-roster","subjectId":"138202"},{"characterId":"36074","match":"source-roster","subjectId":"19494"},{"characterId":"36074","match":"source-roster","subjectId":"2250"},{"characterId":"36074","match":"source-roster","subjectId":"249447"},{"characterId":"36074","match":"source-roster","subjectId":"283338"},{"characterId":"36074","match":"source-roster","subjectId":"310881"},{"characterId":"36074","match":"source-roster","subjectId":"41265"},{"characterId":"36074","match":"source-roster","subjectId":"41271"},{"characterId":"36074","match":"source-roster","subjectId":"41272"}]},"originalCharacterName":"帕梅拉·伊碧斯","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"工作室系列的吉祥物之一。"},{"spoiler":false,"text":"在不同的世界观下，身世、性格稍有不同。"},{"spoiler":false,"text":"--------------------------------------------------"},{"spoiler":false,"text":"A4"},{"spoiler":false,"text":"最早登场是在メッテルブルグ宿屋的某房间，是在那里住了几十年的幽灵。以前那个房间因为有幽灵的传说，所以没人敢住。不过，后来尤蒂入住其中，并告诉大家帕梅拉并不是什么可怕东西的事实，于是那个房间又变得格外受欢迎了起来。"},{"spoiler":false,"text":"A5"},{"spoiler":false,"text":"25年后，原来的幽灵房间要事先预约也变得非常困难。但随着尤蒂回到自己的时代之后，帕梅拉渐渐开始有些觉得寂寞了，表情也没有以前看起来那么快乐。她也正在寻找新的朋友。"},{"spoiler":false,"text":"A6"},{"spoiler":false,"text":"アレーキア洞窟封印龙的祭品，后来成为幽灵后住过下水道、古堡、图书馆……虽然遇见过炼金很多代主角了、经历过很多冒险了，不过总是失忆的特性使得她仍如小白一般单纯天真。"},{"spoiler":false,"text":"A9"},{"spoiler":false,"text":"资料馆的幽灵，以惊吓学生为乐，剧情中加入了主角维恩所在的炼金工房，曾和现任校长是同学。"},{"spoiler":false,"text":"拥有该作最强技能，而且使用门槛很低。"},{"spoiler":false,"text":"A11"},{"spoiler":false,"text":"ロロナが拾ったクマのヌイグルミに宿っていた幽霊。悲壮感を感じさせないおっとりとした性格で後に自分のお店「パメラ屋さん」をオーブンする。"},{"spoiler":false,"text":"A12"},{"spoiler":false,"text":"トトリが住むアランヤ村にあるパメラ屋さんの店主。"},{"spoiler":false,"text":"何年か前にアーランドからやって来て、気づいたら店を開いていた。"},{"spoiler":false,"text":"のんびりぽや～っとした性格で、あまり物事を深く考えたりしない。"},{"spoiler":false,"text":"お店の管理もちゃんとできているのか、やや怪しいところがある。"},{"spoiler":false,"text":"見た目は若いが、年齢は不詳。"},{"spoiler":false,"text":"どうやら昔のことはあまり覚えていないらしい。"},{"spoiler":false,"text":"A13"},{"spoiler":false,"text":"经营量贩店，DLC可加入为战斗角色。"},{"spoiler":false,"text":"A17"},{"spoiler":false,"text":"教会のシスター。"},{"spoiler":false,"text":"おっとり、ほんわかとした性格。"},{"spoiler":false,"text":"常に間延びした口調でしゃべり、周囲を無意識に和ませる。"},{"spoiler":false,"text":"教会の仕事をほぼ一人で切り盛りしている他、街の子供たちを預かる託児所を開いているなど、わりと働き屋。"},{"spoiler":false,"text":"街の老人に対しても子供のように接するなど、彼女の年齢は謎。"},{"spoiler":false,"text":"A18"},{"spoiler":false,"text":"為了修女研修，離開家鄉基爾亨‧貝爾，出來旅行的修女。"},{"spoiler":false,"text":"但是在結束修女的培訓之後，因為買了太多土產導致盤纏都花完的關係，她不得不在萊森貝格經營店鋪工作賺錢。"},{"spoiler":false,"text":"總是從容不迫，也令人摸不著頭緒的個性。"},{"spoiler":false,"text":"A19"},{"spoiler":false,"text":"キルヘン・ベルでシスターを務めていた女性。今はヴェーニュ教会で、グレースとともにシスターの仕事に励んでいる。"},{"spoiler":false,"text":"キルヘン・ベルに戻るはずがなぜかメルヴェイユ行きの馬車に乗ってしまい、今は故郷に帰ることを目標に路銀を貯めている。"},{"spoiler":false,"text":"ぽわわんとした性格で、シスターとしての実力もある、教会でもかなりの人気者。"},{"spoiler":false,"text":"A20"},{"spoiler":false,"text":"在亚尔兹经营【帕梅拉的店】的女性。"},{"spoiler":false,"text":"因为个性温和又带着轻飘飘的感觉，让她的店成为亚尔兹的观光景点之一。似乎是萝乐娜的旧识。"},{"spoiler":false,"text":"A21"},{"spoiler":false,"text":"在库肯港初次登场。主线剧情后期，帕梅拉会作为旅行者在库肯港出现，并伴随一系列相关的支线任务。"},{"spoiler":false,"text":"A22"},{"spoiler":false,"text":"本作在王都初次登场。带着大量布丁，想把布丁推广到全世界。 机缘巧合加入了朵拉莉亚“盗贼”团，帮助盗贼团找到装满金币的宝箱分给了穷人们，盗贼团也帮助了帕梅拉推广布丁的愿望。"}],"source":"bangumi","sourceCharacterId":"36074"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/2304ac8c4bcdb34ff998c6c80281fdb7c6fa967e31baa0fc9baf2219a49d3c1e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afc34afc0557da8bf2a66c4a771137c06db970ca0d77810b85834ceeddb1208e.webp","width":187,"height":256,"source":"static-detail"},"actors":[{"creditedName":"谷井あすか","creatorId":"vndb:s657","sourcePersonId":"vndb:s657","canonicalEntityId":"vndb:s657","name":"谷井 あすか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41272:36074:4593:1","source":"bangumi"}]},{"characterId":"char_bangumi_59698","characterName":"ハゲル","sourceIds":{"bangumi":[{"characterId":"59698","match":"source-roster","subjectId":"11436"},{"characterId":"59698","match":"source-roster","subjectId":"19494"},{"characterId":"59698","match":"source-roster","subjectId":"2250"},{"characterId":"59698","match":"source-roster","subjectId":"24106"},{"characterId":"59698","match":"source-roster","subjectId":"28755"},{"characterId":"59698","match":"source-roster","subjectId":"41259"},{"characterId":"59698","match":"source-roster","subjectId":"41271"},{"characterId":"59698","match":"source-roster","subjectId":"41272"}]},"originalCharacterName":"ハゲル","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"190"}},"descriptions":[{"segments":[{"spoiler":false,"text":"工作室系列中多次登场的秃头铁匠。"},{"spoiler":false,"text":"在不同的世界观中都很在意自己的秃头。"},{"spoiler":false,"text":"--------------------------------------------------"},{"spoiler":false,"text":"A19　　43歳"},{"spoiler":false,"text":"メルヴェイユで鍛冶屋を営んでいる大柄な男性。その名のとおり、頭頂部は光り輝いている。"},{"spoiler":false,"text":"代々鍛冶屋を生業とする家系で、自らの鍛冶屋を守っていくことにかけては並々ならぬ情熱を注いでいる。"},{"spoiler":false,"text":"陽気で気の良い性格をしており、その名物っぷりは観光ガイドブックにも載るほどである。"}],"source":"bangumi","sourceCharacterId":"59698"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"59698","value":"铁匠"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee4837113b5bf8050b2792d9d9974fb1b119caf50aec519e469167df306d887a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fbf71ce9d57dbf5cca0bea4b28df2233fe85c137c92674d4751caf65de0e7fe.webp","width":132,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_80104","characterName":"サルファ","sourceIds":{"bangumi":[{"characterId":"80104","match":"source-roster","subjectId":"41272"}]},"originalCharacterName":"サルファ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"70"},"weight":{"reviewState":"source-only","source":"bangumi","value":"6"}},"descriptions":[{"segments":[{"spoiler":false,"text":"萨尔法是迪欧弗拉图斯·奥列沃尔斯在旅行途中捡来的一只黑猫，在那以后一直陪伴在迪欧弗拉图斯身旁，直到其去世。"},{"spoiler":false,"text":"了解迪欧弗拉图斯的经历以及和伊泽鲁迪的故事，但表示“无法理解人类的情感”。,从维因·奥列沃尔斯记事以来，萨尔法与维因一直生活在森林深处的小屋里。"},{"spoiler":false,"text":"对维因来说，萨尔法更像一位哥哥。他对维因深表关心，虽然有时有些直言不讳，但永远站在维因一边。,听得懂所有人说的话。在“另一个维因”消失以前，维因能听懂萨尔法的话。伊泽鲁迪能听见萨尔法说话，但无法理解其说了什么。,喜欢生鱼，讨厌愚蠢的炼金术士。,GUST官方设定的萨尔法的英文名是“Sulphur”，意为“硫”，硫是炼金术三要素之一。"}],"source":"bangumi","sourceCharacterId":"80104"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d706ad8a1ef5adb9653abd591052f0fb12970f5b73670b6d4f6f988eb4d0acd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e53f3ef83d0e757ca23f738047cfd632d3bcb5645ddd93b1c900a639d12f16c.webp","width":201,"height":251,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_80114","characterName":"Isolde Schelling","sourceIds":{"bangumi":[{"characterId":"80114","match":"source-roster","subjectId":"41272"}]},"originalCharacterName":"Isolde Schelling","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"29"},"birthday":{"reviewState":"source-only","source":"bangumi","value":"1129"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"source-only","source":"bangumi","value":"157"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"阿尔雷比斯学园的一位老师，主讲预测学、纹章学等课程。对学生要求严格，布置的作业普遍偏难,加上冷漠的性格，她成为了学园里最受学生尊敬和害怕的老师之一。擅长照顾小猫,不对任何事物感兴趣。讨厌被赛普尔·克莱伯直接叫名字,喜欢指使他人做事。"},{"spoiler":false,"text":"予測学・紋章学の教師。２９歳。"},{"spoiler":false,"text":"無口、無表情、無愛想と三拍子揃った女性教師。"},{"spoiler":false,"text":"他の先生に比べて難解な課題を出す傾向があり、本人の性格も相まって生徒たちからは色々な意味で畏れられている。"},{"spoiler":false,"text":"彼女自身もアルレビス学園の卒業生で、ゼップルとは同級生だった。"},{"spoiler":false,"text":"トニとレーネのコンビに尊敬されていた。"}],"source":"bangumi","sourceCharacterId":"80114"}],"profileFacts":[{"label":"星座","source":"bangumi","sourceCharacterId":"80114","value":"射手座"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8f6327806cde1afc5afb28592ba1aa9ab8026919c64be6e355891c2de2c15f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a5e95e4ac55241a8d1aea6432978b1d751932a7c08d9a8aa79cc9178f20f700.webp","width":135,"height":256,"source":"static-detail"},"actors":[{"creditedName":"川澄綾子","creatorId":"vndb:s16","sourcePersonId":"vndb:s16","canonicalEntityId":"vndb:s16","name":"川澄 綾子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41272:80114:740:1","source":"bangumi"}]},{"characterId":"char_bangumi_80117","characterName":"レーネ・キル","sourceIds":{"bangumi":[{"characterId":"80117","match":"source-roster","subjectId":"41272"}]},"originalCharacterName":"レーネ・キル","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0430"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"height":{"reviewState":"source-only","source":"bangumi","value":"156"},"weight":{"reviewState":"source-only","source":"bangumi","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"和托尼·艾斯勒一起行动的女子，,比起炼金术来更加喜欢打扮的年纪，,而且很讨厌麻烦事。不知道是受何人指使与托尼一起去抓维因。,到底有什么目的呢？"}],"source":"bangumi","sourceCharacterId":"80117"}],"profileFacts":[{"label":"星座","source":"bangumi","sourceCharacterId":"80117","value":"白羊座"},{"label":"职业","source":"bangumi","sourceCharacterId":"80117","value":"炼金术士"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12fbabaca9cd272f55865de0cf15430a7a69f2172ff9eb0534761a20d31df182.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/caed8d38ada7d7638c3af6d64b1d975bda5e1bf74e91dacd8bafd528247bc4a1.webp","width":92,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中藍","creatorId":"vndb:s1187","sourcePersonId":"vndb:s1187","canonicalEntityId":"vndb:s1187","name":"野中藍","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41272:80117:4371:1","source":"bangumi"}]},{"characterId":"char_bangumi_80120","characterName":"古恩纳鲁","sourceIds":{"bangumi":[{"characterId":"80120","match":"source-roster","subjectId":"41272"}]},"originalCharacterName":"古恩纳鲁","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"1210"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"height":{"reviewState":"source-only","source":"bangumi","value":"183"},"weight":{"reviewState":"source-only","source":"bangumi","value":"73"}},"descriptions":[{"segments":[{"spoiler":false,"text":"生性放荡不羁，崇尚自由，不屑于学园的规章制度，经常做出一些荒谬的事情，但是战斗能力非常强。非常擅长发明创造，设有“古恩纳鲁秘密武器”系列。在《玛娜传奇1》中，古恩纳鲁是一位比维因等人高一届的学长，也是“古恩纳鲁的工作室”以及“正义的伙伴”组织的负责人，虽然极少参与管理事物。在《玛娜传奇2》中，古恩纳鲁接受赛普尔·克莱伯的邀请，重返阿尔雷比斯学园担任教师兼教导主任。"},{"spoiler":false,"text":"ヴェインの一学年上の先輩。"},{"spoiler":false,"text":"学園中にその名を轟かせる、屈指のトラブルメーカーで、"},{"spoiler":false,"text":"入学間もないヴェインを、強引に自らのアトリエに引きずり込む。"},{"spoiler":false,"text":"自分さえ楽しければ他人の迷惑は気にしないという、素敵な考えの持主。"}],"source":"bangumi","sourceCharacterId":"80120"}],"profileFacts":[{"label":"喜欢的东西","source":"bangumi","sourceCharacterId":"80120","value":"波澜壮阔的人生、发明创造"},{"label":"星座","source":"bangumi","sourceCharacterId":"80120","value":"射手座"},{"label":"职业","source":"bangumi","sourceCharacterId":"80120","value":"学生/炼金术士"},{"label":"讨厌的东西","source":"bangumi","sourceCharacterId":"80120","value":"退居凡尘俗世"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20f0f596bafc668795f1c496509bba3434ff6d8fa681333b18cc9cbc58e584e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/617bfa0c2a99f9ec66b5003192d079d248f4d065ccedcf7c1080a8698165fc3e.webp","width":250,"height":256,"source":"static-detail"},"actors":[{"creditedName":"堀内賢雄","creatorId":"vndb:s389","sourcePersonId":"vndb:s389","canonicalEntityId":"vndb:s389","name":"堀内 賢雄","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41272:80120:3961:1","source":"bangumi"}]},{"characterId":"char_bangumi_80121","characterName":"菲萝","sourceIds":{"bangumi":[{"characterId":"80121","match":"source-roster","subjectId":"249447"},{"characterId":"80121","match":"source-roster","subjectId":"41272"}]},"originalCharacterName":"菲萝","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"20"},"birthday":{"reviewState":"source-only","source":"bangumi","value":"0621"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"height":{"reviewState":"source-only","source":"bangumi","value":"151"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"《玛娜传奇～学园的炼金术士们～》的女主,维因·奥列沃尔斯的同桌,不害怕任何人，性格开朗活泼，但是也有点天然,所属阿尔雷比斯学园古恩纳鲁的炼金工作室,喜欢炼金术的少女，经常独自一人研究各种奇奇怪怪的炼金术,尤其喜欢尝试自创的炼金术,心地善良，但对任何人都没有戒备心,宿舍很脏乱，曾引起隔壁寝室同学的抗议。"},{"spoiler":false,"text":"ヴェインのクラスメートの女の子。"},{"spoiler":false,"text":"誰に対しても物怖じしない、人なつっこくて明るい性格。"},{"spoiler":false,"text":"ただし、少々天然。"},{"spoiler":false,"text":"錬金術が大好きで、ヒマを見つけては独自の怪しい調合を試み、"},{"spoiler":false,"text":"その度にアトリエを爆発させている。"}],"source":"bangumi","sourceCharacterId":"80121"}],"profileFacts":[{"label":"星座","source":"bangumi","sourceCharacterId":"80121","value":"双子座"},{"label":"职业","source":"bangumi","sourceCharacterId":"80121","value":"学生/炼金术士"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e98fa25b2e294bbe17f274adbf3c1ee41b1f9598798c19534937df4dce9cb9c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b56d24fd1db554374c4b05da03e3488ab7f819f4e973a5f597d231495e35a174.webp","width":123,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野川さくら","creatorId":"vndb:s1611","sourcePersonId":"vndb:s1611","canonicalEntityId":"vndb:s1611"