{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"8928","model":{"presentationWorkId":"egs:8928","staff":{"artwork":[],"scenario":[],"music":[],"other":[{"creditedName":"真理絵(marie)","creatorId":"vndb:s47","sourcePersonId":"egs:creator:12359","canonicalEntityId":"vndb:s47","name":"真理絵(marie)","detail":"挿入歌「ねぇ」「シリウス」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:126047","source":"egs"},{"creditedName":"みとせのりこ","creatorId":"vndb:s788","sourcePersonId":"egs:creator:4493","canonicalEntityId":"vndb:s788","name":"みとせのりこ","detail":"挿入歌「STIGMATA」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:126048","source":"egs"},{"creditedName":"芳住和之","creatorId":"egs:creator:22422","sourcePersonId":"egs:creator:22422","canonicalEntityId":"egs:creator:22422","name":"芳住和之","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"no-alias-hit","relationId":"egs:work-creator:141683","source":"egs"},{"creditedName":"霜月はるか","creatorId":"vndb:s22","sourcePersonId":"egs:creator:3290","canonicalEntityId":"vndb:s22","name":"霜月はるか","detail":"OP曲「Run for your life」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:68569","source":"egs"}]},"cast":[{"characterId":"char_bangumi_158344","characterName":"Titil Mimi Nike Mele","sourceIds":{"bangumi":[{"characterId":"158344","match":"source-roster","subjectId":"41272"}]},"originalCharacterName":"Titil Mimi Nike Mele","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"16"},"birthday":{"reviewState":"source-only","source":"bangumi","value":"0306"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"height":{"reviewState":"source-onl