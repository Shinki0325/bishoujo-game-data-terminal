ndb:s15392","canonicalEntityId":"vndb:s15392","name":"まろや伽夜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:169811","source":"vndb"},{"creditedName":"yucchi","creatorId":"vndb:s35465","sourcePersonId":"vndb:s35465","canonicalEntityId":"vndb:s35465","name":"yucchi","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:169812","source":"vndb"},{"creditedName":"yukina","creatorId":"vndb:s45979","sourcePersonId":"vndb:s45979","canonicalEntityId":"vndb:s45979","name":"yukina","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:169814","source":"vndb"}]},"cast":[{"characterId":"char_c99952","characterName":"狼代 旅人","sourceIds":{"bangumi":[{"characterId":"100672","match":"exact-normalized-name-in-linked-work","subjectId":"317674"}],"egsCharacterIds":["23927"],"vndbCharacterId":"c99952"},"originalCharacterName":"狼代 旅人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A genius gamer who makes a fortune in virtual currency by playing the VR racing game \"SkyOut Forever\"."},{"spoiler":false,"text":"He manages to go toe-to-toe with corporate teams even though he's only a high school student, and is always vying for the top."},{"spoiler":false,"text":"He is cool, calm, and confident, but he hates large gatherings of people."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c99952"},{"segments":[{"spoiler":false,"text":"静かな情熱を燃やす天才ゲーマー"},{"spoiler":false,"text":"VRレースゲーム【Skyout】で仮想通貨を荒稼ぎする天才ゲーマー。"},{"spoiler":false,"text":"高校生ながら企業チームとも互角に張り合い、常にトップを争っている。"},{"spoiler":false,"text":"クールな自信家で、大人数で群れることが嫌い。"},{"spoiler":false,"text":"合理性を重視する緻密かつ正確、時には大胆なプレイスタイルで、多くのギャラリーを魅了している。"},{"spoiler":false,"text":"愛機は反重力バイク「wolfgear2.0」"}],"source":"egs","sourceCharacterId":"23927","sourceWorkId":"31594","spoiler":false},{"segments":[{"spoiler":false,"text":"燃烧寂寥的激情的天才玩家。"},{"spoiler":false,"text":"虚拟世界："},{"spoiler":false,"text":"他是在VR竞速游戏“Skyout”中赚着虚拟货币的一位天才玩家。虽然只是高中生，但他有着和企业队伍势均力敌的实力，并常常争夺顶尖排位。"},{"spoiler":false,"text":"爱“酷”的自信家，讨厌大量人群聚集。他既注重合理、又注重精准、但有时很狂放大胆的游戏风格，吸引了不少群众看戏。"},{"spoiler":false,"text":"爱车是反重力摩托车“wolfgear 2.0”。"}],"source":"bangumi","sourceCharacterId":"100672"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/663cb1cbf7de2f96e197e8ad73da90f42c2924bc001bff42a74fd3ca6a11e182.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7879119dcf2ad26a1704e9105b0ea4a1180c51327ad5f99f60161240d37a6c6.webp","width":252,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石井孝英","creatorId":"vndb:s16912","sourcePersonId":"vndb:s16912","canonicalEntityId":"vndb:s16912","name":"石井 孝英","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:317674:100672:32081:1","source":"bangumi"}]},{"characterId":"char_c99953","characterName":"天宮 希優","sourceIds":{"bangumi":[{"characterId":"100671","match":"exact-normalized-name-in-linked-work","subjectId":"317674"}],"egsCharacterIds":["23926"],"vndbCharacterId":"c99953"},"originalCharacterName":"天宮 希優","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"123"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A self-proclaimed learning companion AI who was supposed to be the mascot for the moon's solar farm."},{"spoiler":false,"text":"She lives alone in a corner of the moon server known as Lunar world."},{"spoiler":true,"text":"In her \"real form\", Lunar-Q remotely controls an android body to experience what life is like on Earth."},{"spoiler":false,"text":"From Steam"},{"spoiler":true,"text":"Real name: Amamiya Kiyu (天宮 希優)"}],"source":"vndb","sourceCharacterId":"c99953"},{"segments":[{"spoiler":false,"text":"地球に憧れる月面AI"},{"spoiler":false,"text":"VIRTUAL"},{"spoiler":false,"text":"月面太陽光発電計画【プロジェクト・セレーネ】のマスコット……"},{"spoiler":false,"text":"になるはずだったという自称・学習型コンパニオンAI。"},{"spoiler":false,"text":"月面サーバーの片隅【ルナーワールド】に一人で住んでいる。"},{"spoiler":false,"text":"元気で快活な性格だが、相手との距離感を掴むのが下手で、妙に馴れ馴れしい。"},{"spoiler":false,"text":"ずっとひとりぼっちだったので、何事にも好奇心旺盛。"},{"spoiler":false,"text":"趣味はゲーム実況を観戦すること。"},{"spoiler":false,"text":"REAL"},{"spoiler":false,"text":"LUNAR-Qが地球の生活を体験すべく、アンドロイドを操作している状態。"},{"spoiler":false,"text":"月面から遠隔操作で操っている。"},{"spoiler":false,"text":"外見は「もしリアルに存在したら」という本人の想像に合わせてカスタマイズされている"}],"source":"egs","sourceCharacterId":"23926","sourceWorkId":"31594","spoiler":false},{"segments":[{"spoiler":false,"text":"憧憬地球的月面AI。"},{"spoiler":false,"text":"虚拟世界："},{"spoiler":false,"text":"她自称自己是“学习型AI伴侣”，原本应该作为月面太阳能发电计划“Project Selene”（译注：原文“セレーネ”，希腊神话中的月亮女神“塞勒涅”）的吉祥物。"},{"spoiler":false,"text":"她在月面服务器的角落“Lunar Corner”独自一人居住着。"},{"spoiler":false,"text":"她虽然有着时刻都精神充沛、快乐开朗的性格，但不善于拉近与对方的距离感。她有种微妙的亲近感。"},{"spoiler":false,"text":"由于经常是独居，对任何事都充满好奇心。兴趣是观看游戏实况。"},{"spoiler":false,"text":"现实世界："},{"spoiler":false,"text":"这是LUNAR-Q为了体验地球生活在操控的人工生命体状态。她从月面远距离操纵控制着这个人工生命体。"},{"spoiler":false,"text":"外表是LUNAR-Q想象“假若本人是真实存在”的理念定制的。"}],"source":"bangumi","sourceCharacterId":"100671"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a79204fdb683133e4c2bfc37f47420691124c50bd68c04d8b3da67393ec895f9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff1bb1bbd783f379f7eedda41150f0a1dee37867e3ad3eb5ef77b2ba785ac15b.webp","width":256,"height":244,"source":"static-detail"},"actors":[{"creditedName":"田中美海","creatorId":"vndb:s8115","sourcePersonId":"vndb:s8115","canonicalEntityId":"vndb:s8115","name":"田中 美海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:317674:100671:13683:1","source":"bangumi"}]},{"characterId":"char_c99954","characterName":"ガヤ","sourceIds":{"bangumi":[{"characterId":"100673","match":"exact-normalized-name-in-linked-work","subjectId":"317674"}],"egsCharacterIds":["23928"],"vndbCharacterId":"c99954"},"originalCharacterName":"ガヤ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Bit's partners, a fox-eared girl."},{"spoiler":false,"text":"In reality, it's actually Byakko, one of Tabito's classmates who plays with a female avatar."},{"spoiler":false,"text":"Putting his knowledge of VR environments and programming to good use, he helps Tabito obtain victory by acting as his race engineer and advisor."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c99954"},{"segments":[{"spoiler":false,"text":"万全サポートのバ美肉美少年"},{"spoiler":false,"text":"ビットの相棒を務める、狐耳幼○。"},{"spoiler":false,"text":"その正体は旅人の同級生・百狐が女体アバターをまとったもの。"},{"spoiler":false,"text":"VR環境やプログラム知識を駆使して、レースエンジニア兼アドバイザーとして勝利に貢献する。"},{"spoiler":false,"text":"かわいいものに目が無く、数々のVRアイドルにも入れあげており、複数の「推し」に日々課金している。"}],"source":"egs","sourceCharacterId":"23928","sourceWorkId":"31594","spoiler":false},{"segments":[{"spoiler":false,"text":"作为“可靠的后援”，顶着女孩子虚拟形象活动（バ美肉）的美少年 。"},{"spoiler":false,"text":"虚拟世界："},{"spoiler":false,"text":"狐狸耳朵幼女百々咲こん，是T-BIT的搭档。"},{"spoiler":false,"text":"现实世界："},{"spoiler":false,"text":"百々咲こん实际上是狼代旅人的同学 市々谷百狐 “完全使用”的女性形象虚拟角色。"},{"spoiler":false,"text":"他用VR环境和编程等方面的知识作为赛车工程师兼顾问为T-BIT的胜利做出贡献。"},{"spoiler":false,"text":"他非常喜欢可爱的事物。他在虚拟偶像上挥霍很多金钱，给自己推的多个偶像们氪金。"}],"source":"bangumi","sourceCharacterId":"100673"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c99954","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"23928","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"23928","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"100673","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6ab8bf061db6679446eef9fc5b9a6453d1c4ceb2dd7da5044a256d2940ab20d1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c11e479722f483d6430d055334e767f55e6af74f163492ce6883db1a12fa768b.webp","width":256,"height":246,"source":"static-detail"},"actors":[{"creditedName":"若井友希","creatorId":"vndb:s19441","sourcePersonId":"vndb:s19441","canonicalEntityId":"vndb:s19441","name":"若井 友希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:317674:100673:20215:1","source":"bangumi"}]},{"characterId":"char_c99955","characterName":"イリヤ・ロジェストヴェンスカヤ","sourceIds":{"bangumi":[{"characterId":"100674","match":"exact-normalized-name-in-linked-work","subjectId":"317674"}],"egsCharacterIds":["23929"],"vndbCharacterId":"c99955"},"originalCharacterName":"イリヤ・ロジェストヴェンスカヤ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Bit's relentless self-proclaimed rival, who appears as a cat-eared avatar and drives a monstrous machine."},{"spoiler":false,"text":"She spares no expense when it comes to purchasable items, always trying to buy her way to victory, but her execution always falls short."},{"spoiler":false,"text":"From Steam"},{"spoiler":true,"text":"She's the daughter of the CEO of Selene. Her real name is Illya Rozhdestvenskaya (イリヤ・ロジェストヴェンスカヤ)"}],"source":"vndb","sourceCharacterId":"c99955"},{"segments":[{"spoiler":false,"text":"獰猛果敢なネコ耳モンスター"},{"spoiler":false,"text":"猫耳アバター姿でモンスターマシンを駆り、ビットを執拗につけ狙う自称・ライバル。"},{"spoiler":false,"text":"金に糸目を付けず課金アイテムを買い漁り、札束の力で叩きのめそうとしてくるが、肝心なところで詰めが甘い。"},{"spoiler":false,"text":"数々の大手スポンサーのバックアップを受けており、「猫耳軍団」と呼ばれる私兵まで引き連れている。"}],"source":"egs","sourceCharacterId":"23929","sourceWorkId":"31594","spoiler":false},{"segments":[{"spoiler":false,"text":"凶猛果断的猫耳“兽娘”。"},{"spoiler":false,"text":"虚拟世界："},{"spoiler":false,"text":"她有着外表戴着一对猫耳的虚拟形象，操纵着怪兽机器，作为（T-BIT）的“（她）自称的对手”，她时刻将T-BIT作为執物伺机跟着准备下手。"},{"spoiler":false,"text":"不加思索地大笔花钱买收费装备以想用“钞能力”去击败对手，却总遇上“关键时刻掉链子”。"},{"spoiler":false,"text":"她有着多个赞助商的赞助，甚至带着被称为“猫耳军团”的私人士兵。"},{"spoiler":false,"text":"现实世界："},{"spoiler":false,"text":"相关信息禁止访问。"}],"source":"bangumi","sourceCharacterId":"100674"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a81056ba2762c7b29fa5fcd302e95b27d96428def82856c1f1ae01f4d5b91e0a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f94846e87b89002b5911349ed08100edb72b9a2085e8015481388b5d7f6f5b8.webp","width":256,"height":246,"source":"static-detail"},"actors":[{"creditedName":"八巻アンナ","creatorId":"vndb:s22799","sourcePersonId":"vndb:s22799","canonicalEntityId":"vndb:s22799","name":"八巻 アンナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:317674:100674:31872:1","source":"bangumi"}]},{"characterId":"char_vndb_c104104","characterName":"天宮 美優","sourceIds":{"vndbCharacterId":"c104104"},"originalCharacterName":"天宮 美優","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":true,"text":"LUNAR-Q (Amamiya Kiyu)'s mother. She worked on the 