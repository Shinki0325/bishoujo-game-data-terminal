ame":"kobi","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:12743","source":"vndb"},{"creditedName":"有限会社コーデックス","creatorId":"vndb:s5581","sourcePersonId":"vndb:s5581","canonicalEntityId":"vndb:s5581","name":"有限会社codeX(有限会社コーデックス)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:12744","source":"vndb"},{"creditedName":"六鹿 文彦","creatorId":"vndb:s12574","sourcePersonId":"vndb:s12574","canonicalEntityId":"vndb:s12574","name":"六鹿 文彦","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:12745","source":"vndb"}]},"cast":[{"characterId":"char_c59764","characterName":"徳川 吉宗","sourceIds":{"bangumi":[{"characterId":"118175","match":"exact-normalized-name-in-linked-work","subjectId":"218776"}],"egsCharacterIds":["19555"],"vndbCharacterId":"c59764"},"originalCharacterName":"徳川 吉宗","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"第108代銀河征夷大将軍"},{"spoiler":false,"text":"第108代銀河征夷大将軍。時代劇の文脈で動く人。"},{"spoiler":false,"text":"新しもの好きで、涙もろく情に厚い。"},{"spoiler":false,"text":"細かいことは気にしない性格で、どんな失敗も笑い飛ばす。"},{"spoiler":false,"text":"豪放磊落といえば聞こえはいいが、あまりに脳天気な笑い声は、"},{"spoiler":false,"text":"もしかしたらバカなのかもしれないと、周囲の人々を不安にさせることも。"},{"spoiler":false,"text":"しかし急場に至っては冷静な判断力と、無謀と紙一重なほど大胆な決断力で、"},{"spoiler":false,"text":"人々をぐいぐいと引っ張っていく。仲間は決して裏切らないが、質草にすることはある。"},{"spoiler":false,"text":"「策など無い！」"}],"source":"egs","sourceCharacterId":"19555","sourceWorkId":"8790","spoiler":false},{"segments":[{"spoiler":false,"text":"ライアーソフト第１９弾「ＳＨＯＧＵＮ８」の主人公。"},{"spoiler":false,"text":"豪放磊落な性格の、征夷大将軍。うっかり先物取引に手を出したため、母星を担保に莫大な借金を抱えることに。"}],"source":"egs","sourceCharacterId":"19555","sourceWorkId":"9637","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/ebfc1f5bea8f9652b1ebe1ecdbc20a424a433ee2b75ee96ef78f21753c570528.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e000b0a7821299b447ea905c5c39dcfb4ec3938e60f4df09de8128a526333f82.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c59765","characterName":"沙奈","sourceIds":{"bangumi":[{"characterId":"118183","match":"exact-normalized-name-in-linked-work","subjectId":"218776"}],"egsCharacterIds":["19554"],"vndbCharacterId":"c59765"},"originalCharacterName":"沙奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幼なじみ主計長"},{"spoiler":false,"text":"主人公の乳母子の関係。小さい頃からずっと吉宗を見て育ってきた。"},{"spoiler":false,"text":"その後経済／会計関係の学部をきわめて優秀な成績で大学を卒業。"},{"spoiler":false,"text":"そのままエコノミストとして大学に残る道もあったが、"},{"spoiler":false,"text":"吉宗が先物取引で失敗したと聞き、"},{"spoiler":false,"text":"惑星オオエドでの経済危機を救うために、様々な誘いを振り切って帰郷する。"},{"spoiler":false,"text":"ゲーム中では主人公の主計長として、台所事情を一手に引き受けることに。"},{"spoiler":false,"text":"無駄におおらかな吉宗の起こすトラブルに、胃の痛い毎日を送っている。"},{"spoiler":false,"text":"オオエド出身者では時代劇的な行動原理の呪縛から逃れた、数少ない常識人。"},{"spoiler":false,"text":"しかし艦隊ではそのために苦労することもしばしば。"},{"spoiler":false,"text":"「これ以上口のついたものを増やすわけにはいきません！　子作り禁止！」"}],"source":"egs","sourceCharacterId":"19554","sourceWorkId":"8790","spoiler":false},{"segments":[{"spoiler":false,"text":"ライアーソフト第１９弾「ＳＨＯＧＵＮ８」のヒロイン。"},{"spoiler":false,"text":"吉宗の幼馴染で、オオエドきっての常識人。"},{"spoiler":false,"text":"そのため、非常識な面々のフォローやツッコミを一手に引き受ける多忙な日々。"}],"source":"egs","sourceCharacterId":"19554","sourceWorkId":"9637","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d70e3711ad4f41c7c2755ee3534f861a613ec0f3738f806e0a46175b