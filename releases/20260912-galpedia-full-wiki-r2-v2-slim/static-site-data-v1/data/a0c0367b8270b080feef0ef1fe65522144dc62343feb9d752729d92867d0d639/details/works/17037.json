adataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26ea9baf0b8a3337421adaa4787322a3045fcafbb2107a4e9f2eca0e42f875a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7dfca2e19b3afe0c1fcdc6cd5a68bdf6ac80acbb91114f12d64a06f609f7d082.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きのこはじめ","creatorId":"vndb:s18231","sourcePersonId":"vndb:s18231","canonicalEntityId":"vndb:s18231","name":"きのこはじめ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46390","source":"vndb"}]},{"characterId":"char_vndb_c752","characterName":"イリーナ・ウラジーミロヴナ・プチナ","sourceIds":{"vndbCharacterId":"c752"},"originalCharacterName":"イリーナ・ウラジーミロヴナ・プチナ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1007"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"It's best if you don't anger me too much...\""},{"spoiler":false,"text":"An active duty president who reigns over Rusia with super charisma. She obtains information that a UFO crashed into Nippon, and visits to talk about laws dealing with import restrictions. On the day of her visit, she is saved by the protagonist and falls in love at first sight. She becomes interested in him ever since, making an appearance at his school as a transfer student while handling government affairs. However, she becomes disillusioned by the protagonist, the great king of sexual harassment. She disciplines him with her slapping fan to make him into a gentleman even to this day. As a disciplinarian in school, correcting the behavior of the students is her daily routine. She fosters a rivalry against the childhood friend president who's also the head of the student council, and seems to have plans to correct the entire school as a disciplinarian. Yukino and her friends nicknamed her Puchin, but she gets mad when they call her that."},{"spoiler":false,"text":"From JAST USA's official site"},{"spoiler":true,"text":"She is the local superhero of Ota Ward in Naka no Hito nado Inai! Tokyo Hero Project."}],"source":"vndb","sourceCharacterId":"c752"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a00ccf21d6966022f2a4beff7a085671e74d5b095aef79882fc8a8fbdcfbb03b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3251ff24709c8bbec0401567120849e4b6179e7eb47aa881b0236f6a7b54428.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"海原 エレナ","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:46378","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p129","sourceCompanyId":"egs:brand:1037","canonicalEntityId":"vndb:p129","name":"ALcot","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:17037:1037","source":"egs"},{"companyId":"vndb:p102","sourceCompanyId":"vndb:p102","canonicalEntityId":"vndb:p102","name":"JAST USA","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:103319:v10237","source":"vndb"},{"companyId":"vndb:p129","sourceCompanyId":"vndb:p129","canonicalEntityId":"vndb:p129","name":"ALcot","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:169999:v10237","source":"vndb"},{"companyId":"vndb:p3320","sourceCompanyId":"vndb:p3320","canonicalEntityId":"vn