":"vndb:s1774","name":"井上 麻里奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53712","source":"vndb"}]},{"characterId":"char_vndb_c88300","characterName":"本多・二代","sourceIds":{"vndbCharacterId":"c88300"},"originalCharacterName":"本多・二代","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Head of the Mikawa Security Corps. She is Masazumi's second cousin and the daughter of Tadakatsu Honda, one of the four divine Matsudaira kings. Due to the strict training she received from her father, she became a skilled fighter with the spear but is clueless about the world. While she holds a high level of morale, she is easily embarrassed, which causes her to drop her guard."}],"source":"vndb","sourceCharacterId":"c88300"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf0bac012a463880f8434f43523185e5e188dd71718092cfdc0209c2978a12bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6351f7ee59601ac6abefce77b07073c89535fcc3991f30fbc08c7bf3698bfcc.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林 ゆう","creatorId":"vndb:s246","sourcePersonId":"vndb:s246","canonicalEntityId":"vndb:s246","name":"小林 ゆう","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53697","source":"vndb"}]},{"characterId":"char_vndb_c88301","characterName":"葵 喜美","sourceIds":{"vndbCharacterId":"c88301"},"originalCharacterName":"葵 喜美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"s