{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"17512","model":{"presentationWorkId":"vndb:v10106","staff":{"artwork":[{"creditedName":"ニケ(聡間まこと)","creatorId":"vndb:s17251","sourcePersonId":"egs:creator:17322","canonicalEntityId":"vndb:s17251","name":"ニケ(聡間まこと)","detail":"一枚絵イラスト/アイコン","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:108838","source":"egs"},{"creditedName":"鈴ノ","creatorId":"vndb:s10728","sourcePersonId":"egs:creator:17323","canonicalEntityId":"vndb:s10728","name":"鈴ノ","detail":"キャラデザ・メインイラストレーション","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:108839","source":"egs"},{"creditedName":"松浦いちろー","creatorId":"vndb:s17254","sourcePersonId":"egs:creator:17324","canonicalEntityId":"vndb:s17254","name":"松浦いちろー","detail":"背景画","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:108840","source":"egs"},{"creditedName":"友","creatorId":"vndb:s17253","sourcePersonId":"vndb:s17253","canonicalEntityId":"vndb:s17253","name":"友","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:86807","source":"vndb"},{"creditedName":"亜希","creatorId":"vndb:s17255","sourcePersonId":"vndb:s17255","canonicalEntityId":"vndb:s17255","name":"亜希","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:86809","source":"vndb"},{"creditedName":"クレタ","creatorId":"vndb:s17256","sourcePersonId":"vndb:s17256","canonicalEntityId":"vndb:s17256","name":"クレタ","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:86810","source":"vndb"}],"scenario":[{"creditedName":"ひづめ","creatorId":"vndb:s10727","sourcePersonId":"egs:creator:17325","canonicalEntityId":"vndb:s10727","name":"ひづめ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:108841","source":"egs"}],"music":[{"creditedName":"The faces","creatorId":"vndb:s17252","sourcePersonId":"vndb:s17252","canonicalEntityId":"vndb:s17252","name":"The faces","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:86806","source":"vndb"}],"other":[{"creditedName":"ひづめ","creatorId":"vndb:s10727","sourcePersonId":"vndb:s10727","canonicalEntityId":"vndb:s10727","name":"濱田 雄偉","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:86803","source":"vndb"},{"creditedName":"鈴ノ","creatorId":"vndb:s10728","sourcePersonId":"vndb:s10728","canonicalEntityId":"vndb:s10728","name":"鈴ノ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:86804","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c59460","characterName":"ジョゼット・ジョーストン","sourceIds":{"vndbCharacterId":"c59460"},"originalCharacterName":"ジョゼット・ジョーストン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"164"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Josette Carodine is her real name, but her nickname is Jo. She’s a cowboy born in Cow Stone Bell, the Desert’s Navel, a place she dreams of getting out of some day. Her mother passed away soon after she was born and her father has disappeared, leaving her to be raised by her foul-mouthed uncle...a trait which has unfortunately rubbed off on her."},{"spoiler":false,"text":"She practices shooting daily, and so has a mean quick draw, but all her knowledge of being a gunslinger comes from dime novels. She can play the guitar, but is pretty tone-deaf. Has a bit of an accent"},{"spoiler":false,"text":"from Mangagamer"}],"source":"vndb","sourceCharacterId":"c59460"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9a6c76933e35d88027f309c5e5b82d9559d9b1e9aaf3d5d055356a294ed39e0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfdc7ee4a19c82053bf976f98a95563cace736b5ef04e3550d00ebd2239180b0.webp","width":197,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c59461","characterName":"Rashenka Enrikimari Inaho","sourceIds":{"vndbCharacterId":"c59461"},"originalCharacterName":"Rashenka Enrikimari Inaho","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"166"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl of the Fuuro. Her real name is Rashenka Enrikimari Inaho, which means"},{"spoiler":false,"text":"“Grain in the Wind.”"},{"spoiler":false,"text":"While she is both a shaman who hears the voices of the spirits and a warrior who defends the forest, most of her time is spent working as a guide for people crossing the desert."},{"spoiler":false,"text":"She is silent and unfriendly, opening herself up only to forest and nature. This may be only natural, however, as she was found in the forest as a baby and is treated as a messenger from Wolfking by her village."},{"spoiler":false,"text":"She has superior physical capabilities, as is common for Fuuro, and excels at knife throwing."},{"spoiler":false,"text":"from Mangagamer"}],"source":"vndb","sourceCharacterId":"c59461"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/baca1e7a7913f3099d0d365697e69b2a7b4fb656e03811f1378ed9d5ad7492bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a70b97e04a2b537d7067226b66ce6d8fdb6d89c98c331bbd2dc07ab1393899a.webp","width":197,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c59462","characterName":"Flannel Hopefield","sourceIds":{"vndbCharacterId":"c59462"},"originalCharacterName":"Flannel Hopefield","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Josette’s best friend, and daughter of the family that owns the biggest ranch in Cow Stone Bell."},{"spoiler":false,"text":"The town of Cow Stone Bell grew out of what was originally just the Hopefield family’s ranch, and the head of the family acts almost like the mayor of the town today."},{"spoiler":false,"text":"Dainty and refined, nearly the polar opposite of Josette, she nonetheless slathers her friend in praise for her bravery and seeming ability to do anything she puts her mind to. She loves to read (especially romance novels) and has a lovely singing voice."},{"spoiler":false,"text":"from Mangagamer"}],"source":"vndb","sourceCharacterId":"c59462"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e536532b8e9abaa38137e6c315ac9d8bd3c8beb2c38c06a82634fc256e3562b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/1364f3aa03bf854f955689bd4352972510d1a544f2c6ff7ec59379f11c3d2fdd.webp","width":197,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c59463","characterName":"ジョブス・キャロダイン","sourceIds":{"vndbCharacterId":"c59463"},"originalCharacterName":"ジョブス・キャロダイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"174"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Josette’s uncle."},{"spoiler":false,"text":"Loves “drinkin’, smokin’, and gamblin’,” leading Josette to refer to him with less than kind words on occasion."},{"spoiler":false,"text":"He’s a potbellied middle-aged man now, but was a famous bounty hunter in his youth. He took part in the Border War as well, where his skill with a rifle earned him the name “Crushing Bow” from the Fuuro."},{"spoiler":false,"text":"from Mangagamer"}],"source":"vndb","sourceCharacterId":"c59463"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2498bf0a7d9542be67e5044ab90c5906d03042290c2baafed5185c4d5d7c07c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7de17a8f2307565b0c8bcec237a07ecd49738c87ec882d41b7a8d293e08f592a.webp","width":197,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c59464","characterName":"ビズキット","sourceIds":{"vndbCharacterId":"c59464"},"originalCharacterName":"ビズキット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A boy who claims to be from another world. He also claims to serve a Lady Gabrielle, who he was separated from when crossing between worlds. While he does not know much of the ways of the world, he does seem to know a lot about certain specialized topics. He speaks to the crass Josette with a brazen rudeness, resulting in the two fighting to no end."},{"spoiler":false,"text":"from Mangagamer"}],"source":"vndb","sourceCharacterId":"c59464"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c70f2a92f0c4ed9550fe1a472b633b7a1af420d5a0f163cefa7ccf427f33013.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/075b96c3cef3c14960db2fa2e9325a80f8408b805e9c65c63890d964db73194a.webp","width":197,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c59465","characterName":"マクベイン","sourceIds":{"vndbCharacterId":"c59465"},"originalCharacterName":"マクベイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A wandering outlaw that Josette and Inaho met while working to secure travel funds. Though he works as the dingy saloon’s bouncer and seems to spend all his time, even on the job, either drinking or sleeping, he carries himself like a person who’s survived battles on many a bloody field."},{"spoiler":false,"text":"from Mangagamer"}],"source":"vndb","sourceCharacterId":"c59465"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d45d3471106550a3b71e3d2e7777dafc6a98d3c4326990b2e4fdb09523e637c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce28b9d351c2b99c480cdb931f2d46c556e60334411426629c59c7936a5cb656.webp","width":197,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c59505","characterName":"Laramie Beth","sourceIds":{"vndbCharacterId":"c59505"},"originalCharacterName":"Laramie Beth","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vn