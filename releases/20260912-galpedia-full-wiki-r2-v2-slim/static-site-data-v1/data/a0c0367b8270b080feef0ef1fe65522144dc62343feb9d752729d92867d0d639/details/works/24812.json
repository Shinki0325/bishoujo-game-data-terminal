:false,"text":"大きな黒縁メガメが特徴の、物静かでおっとりとした性格。"},{"spoiler":false,"text":"社交的ではなくいつも一人で過ごしている。"},{"spoiler":false,"text":"クラスでも非常に影の薄い存在だったが・・・"},{"spoiler":false,"text":"ある日、主人公との偶然の出来事で状況は一変する。"},{"spoiler":false,"text":"性には疎そうに見えるが実は好奇心旺盛のムッツリスケベさん。"}],"source":"egs","sourceCharacterId":"16830","sourceWorkId":"24812","spoiler":false},{"segments":[{"spoiler":false,"text":"学園に転入してきたクラスメイトの女の子。"},{"spoiler":false,"text":"大きな黒縁メガメが特徴の、物静かでおっとりとした性格。"},{"spoiler":false,"text":"あまり社交的ではなくクラスでも非常に影の薄い存在だったが……"},{"spoiler":false,"text":"ある日、主人公との偶然の出来事で状況が一変する。"},{"spoiler":false,"text":"性には疎そうに見えるが、実は好奇心旺盛のムッツリスケベさん。"}],"source":"bangumi","sourceCharacterId":"54210"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f911f3971bbd7c30b76df1f3d0b05e6331e5ef645ff8014f64da88b3df498fda.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da86c52cdee677645a423d502698c886b14efb0f8ee5d28b5f0172122e19385d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長瀬ゆずは","creatorId":"vndb:s2287","sourcePersonId":"vndb:s2287","canonicalEntityId":"vndb:s2287","name":"長瀬ゆずは","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:211831:54210:24238:1","source":"bangumi"}]},{"characterId":"char_c80143","characterName":"坂上 俊也","sourceIds":{"bangumi":[{"characterId":"54207","match":"exact-normalized-name-in-linked-work","subjectId":"211831"}],"egsCharacterIds":["16833"],"vndbCharacterId":"c80143"},"originalCharacterName":"坂上 俊也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Once again, he's brilliantly secured the protagonist role? This boy."},{"spoiler":false,"text":"A year has passed since his marriage to Yukari, and he should be showing a slightly more mature side than in the previous work... But..."},{"spoiler":false,"text":"His days continue to be thrown off balance by Yukari's overly attentive hospitality. In this installment too, he's hit with mishaps at home, at school, day and night."},{"spoiler":false,"text":"“Hang in there, Toshiya!”"},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c80143"},{"segments":[{"spoiler":false,"text":"本作でも見事に主人公の座を射止めた？男の子。"},{"spoiler":false,"text":"ゆかりとの新婚生活も１年が経過し前作の時よりは、少し大人になった姿を見せたいはずなのだが・・・"},{"spoiler":false,"text":"ゆかりのサービス精神旺盛なおもてなしに翻弄される日々が続いている。"},{"spoiler":false,"text":"今作でも家でも学園でもハプニングに見舞われる。"},{"spoiler":false,"text":"”頑張れ俊くん！”"}],"source":"egs","sourceCharacterId":"16833","sourceWorkId":"24812","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公で、ほのかな恋心を抱いていたお姉ちゃんと"},{"spoiler":false,"text":"結婚することになって、喜んでいいやら戸惑っていいやら。"},{"spoiler":false,"text":"サービス満点なお姉ちゃんとの生活で、混乱するコトしきり。"}],"source":"bangumi","sourceCharacterId":"54207"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c679f49d7e227799a9652750e767b497b2d3491645029565ee9d78674f4e518.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/229238b0c3ec18b8c4ce63aa6787368752ece214ab6b78aa8be37607553bdf5d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p467","sourceCompanyId":"egs:brand:707","canonicalEntityId":"vndb:p467","name":"TRYSET","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:24812:707","source":"egs"},{"companyId":"vndb:p467","sourceCompanyId":"vndb:p467","canonicalEntityId":"vndb:p467","name":"TRYSET","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:165717:v20838","source":"vndb"},{"companyId":"vndb