],"source":"vndb","sourceCharacterId":"c126019"},{"segments":[{"spoiler":false,"text":"ゆかりの兄で香織の旦那。"},{"spoiler":false,"text":"一見すると真面目な公務員。"},{"spoiler":false,"text":"しかしセックスにはワイルドな面もありそんな意外性に惹かれた香織を見事に射止めた！？"},{"spoiler":false,"text":"俊也のことを実の弟のように可愛がりゆかりとの夜の営みについても実演でアドバイス？"}],"source":"egs","sourceCharacterId":"16832","sourceWorkId":"24812","spoiler":false},{"segments":[{"spoiler":false,"text":"ゆかりの兄。真面目な公務員。"},{"spoiler":false,"text":"どうやって香織を射止めたのかは謎。"},{"spoiler":false,"text":"でも、上手くやっているらしい。"},{"spoiler":false,"text":"俊也君を弟のように可愛がっている。"}],"source":"bangumi","sourceCharacterId":"54208"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23288f0ad70e2629472e63478f5cbd17574fe763f601ab3f4cf396b35c36911a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7ed401c795fc7e8d78503988f2c8c0c05ee7a332321eff59951a11f8ac4c75eb.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c59452","characterName":"坂上 ゆかり","sourceIds":{"bangumi":[{"characterId":"54202","match":"exact-normalized-name-in-linked-work","subjectId":"211831"}],"egsCharacterIds":["16826"],"vndbCharacterId":"c59452"},"originalCharacterName":"坂上 ゆかり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Formerly known as: Tooyama Yukari, wife of Toshiya."},{"spoiler":false,"text":"A composed beauty with a bright personality, she was quite popular but had absolutely no prior romantic experience (Toshiya being her first)."},{"spoiler":false,"text":"However, even before marriage, she received instruction from her mother, Masae, and studied erotic techniques day and night for her future husband, Toshiya."},{"spoiler":false,"text":"Even now, after marriage,