:93866","source":"vndb"}],"other":[{"creditedName":"小野友樹","creatorId":"vndb:s42","sourcePersonId":"egs:creator:11470","canonicalEntityId":"vndb:s42","name":"小野友樹","detail":"OP曲「まほろばの空」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:232684","source":"egs"},{"creditedName":"小野 友樹","creatorId":"vndb:s42","sourcePersonId":"vndb:s42","canonicalEntityId":"vndb:s42","name":"小野 友樹","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:93840","source":"vndb"},{"creditedName":"KENN","creatorId":"vndb:s372","sourcePersonId":"vndb:s372","canonicalEntityId":"vndb:s372","name":"KENN","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:93841","source":"vndb"},{"creditedName":"lasah","creatorId":"vndb:s1692","sourcePersonId":"vndb:s1692","canonicalEntityId":"vndb:s1692","name":"lasah","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:93842","source":"vndb"},{"creditedName":"岩崎 大介","creatorId":"vndb:s2383","sourcePersonId":"vndb:s2383","canonicalEntityId":"vndb:s2383","name":"岩崎 大介","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:93851","source":"vndb"},{"creditedName":"読","creatorId":"vndb:s2675","sourcePersonId":"vndb:s2675","canonicalEntityId":"vndb:s2675","name":"読","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:93856","source":"vndb"},{"creditedName":"中山 尚司","creatorId":"vndb:s10408","sourcePersonId":"vndb:s10408","canonicalEntityId":"vndb:s10408","name":"中山 尚司","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:93864","source":"vndb"},{"creditedName":"細谷 博子","creatorId":"vndb:s11684","sourcePersonId":"vndb:s11684","canonicalEntityId":"vndb:s11684","name":"細谷 博子","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:93865","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c26415","characterName":"香夜","sourceIds":{"vndbCharacterId":"c26415"},"originalCharacterName":"香夜","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A merchant’s daughter from Edo, Musashi Province. She runs a small restaurant with her father near the castle, but due to the cold weather and crop failures, their business is in a severe condition. Influenced by her deceased mother, she learned how to fight with a naginata—Buko-ryu Naginata-jutsu. Even though she’s a woman, she understands the samurai heart."},{"spoiler":false,"text":"One day, a Tokugawa samurai gave her a very important request. It’s a request for Kayo to become a fake bride and attend a mass wedding all the way to Sunpu, in place of a princess. Apparently Kayo and the wife of the Castellan of Sunpu—Hisahime—look exactly alike."},{"spoiler":false,"text":"If she refuses, they might not be able to continue running a restaurant. Kayo’s decision is…"},{"spoiler":false,"text":"from kokoronodamu"}],"source":"vndb","sourceCharacterId":"c26415"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/9860c147cca449dea90a034b0a0ccb1e1fc8156a55833be06a29ef1ad37804d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd11dc50099c09c9fdcdfd6c637b0f14d23c0ef522e7cca84fcc7d709a06be2d.webp","width":203,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c26420","characterName":"九十九丸","sourceIds":{"vndbCharacterId":"c26420"},"originalCharacterName":"九十九丸","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1107"},"height":{"reviewState":"source-only","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Birthplace: Mutsu Province"},{"spoiler":false,"text":"Sword: Mumei (Nameless)"},{"spoiler":false,"text":"Style: Tamiya-ryu Iai"},{"spoiler":false,"text":"A samurai-in-training who comes to Edo from Mutsu Province. Following his teacher’s words, he left home in order to polish his swordsmanship. His goal is to win the Imperial Tournament of Sword Retrieval and receive the Book of Iai. Not attached to the past nor the future, he lives the way he wants to in the present. He has a black wood pigeon named Hayato."},{"spoiler":false,"text":"from kokoronodamu"}],"source":"vndb","sourceCharacterId":"c26420"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71712fc30fc77dd232ad435392570e448ff207267f14ab771026b96683c83477.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/599b93a869608f6f2673c227a001f6898bf26db0780382c714779a298bcee2cc.webp","width":215,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野 友樹","creatorId":"vndb:s42","sourcePersonId":"vndb:s42","canonicalEntityId":"vndb:s42","name":"小野 友樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:49949","source":"vndb"}]},{"characterId":"char_vndb_c26422","characterName":"螢","sourceIds":{"vndbCharacterId":"c26422"},"originalCharacterName":"螢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"19"},"birthday":{"reviewState":"source-only","source":"vndb","value":"404"},"height":{"reviewState":"source-only","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Birthplace: Kibi Province"},{"spoiler":false,"text":"Sword: Raikiri & Kazakiri"},{"spoiler":false,"text":"Style: Ushitora"},{"spoiler":false,"text":"A samurai who wields dual swords. He came to Edo from Kibi Province, in order to join the Imperial Tournament of Sword Retrieval and win the Five Heavenly Swords. He makes a living by working as a roundsman, protecting Edo’s security. He’s aggressive and has a bad mouth. He’s also clumsy, in the sense that he can’t be honest to the people he doesn’t respect. However, he’s actually a kind man who will turn protective upon getting relied on."},{"spoiler":false,"text":"from kokoronodamu"}],"source":"vndb","sourceCharacterId":"c26422"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5abc19517fc4ba9fe648b27e46ee45dcd510bac97e97631be762a74617006342.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e568969d31e6c7b64f1e9c6caf2aa49c433814f150d6cc816b4f3c5c27bb89e.webp","width":212,"height":256,"source":"static-detail"},"actors":[{"creditedName":"KENN","creatorId":"vndb:s372","sourcePersonId":"vndb:s372","canonicalEntityId":"vndb:s372","name":"KENN","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:49953","source":"vndb"}]},{"characterId":"char_vndb_c26426","characterName":"縁","sourceIds":{"vndbCharacterId":"c26426"},"originalCharacterName":"縁","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"23"},"birthday":{"reviewState":"source-only","source":"vndb","value":"801"},"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Birthplace: Hitachi Province"},{"spoiler":false,"text":"Sword: Mikazuki Munechika"},{"spoiler":false,"text":"Style: Yagyuu Shinkage-ryu"},{"spoiler":false,"text":"The official spy of Edo / Tokugawa Shogunate. He’s an expert in martial arts, but he has a irresponsible, happy-go-lucky personality. He won’t take any action if it’s not for something he’s interested in. It’s also impossible to stop his delusions, and he screws up from time to time."},{"spoiler":false,"text":"from kokoronodamu"}],"source":"vndb","sourceCharacterId":"c26426"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee2efd4fcdf1ed48adde4e82deee2d3df0a5f8a45dede5888f0e99378eaaf1cf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f1618062ad1082c555ebceb03d786062d4953e085480c6318ee10d463478eb5.webp","width":214,"height":256,"source":"static-detail"},"actors":[{"creditedName":"置鮎 龍太郎","creatorId":"vndb:s747","sourcePersonId":"vndb:s747","canonicalEntityId":"vndb:s747","name":"置鮎 龍太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:49954","source":"vndb"}]},{"characterId":"char_vndb_c26427","characterName":"鷺原 左京","sourceIds":{"vndbCharacterId":"c26427"},"originalCharacterName":"鷺原 左京","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"125"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Birthplace: Yamashiro Province"},{"spoiler":false,"text":"Sword: Hotarumaru"},{"spoiler":false,"text":"Style: Kurama-ryu + self-taught"},{"spoiler":false,"text":"The son of the Sagihara family, direct vassal of the Fushimi feudal clan in the Yamashiro Province. The Sagihara family is a descendant of Amakuni, a group of blacksmiths that was formed back in the Heian period. They were also guardians who protected the Five Heavenly Swords in the past. After his family was killed, he threw away his status and came to Edo. While he might look like an inexperienced young master, he knows how to get on in the world due to his vagabond journey."},{"spoiler":false,"text":"from kokoronodamu"}],"source":"vndb","sourceCharacterId":"c26427"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1744aac8d122427055824c8185c9a0de1d6f8becde5fa4f243dbf408fb75de8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fb57a86e4bf83ff54c79d185c1f8a1aed299f206719bd722c237cbcd7ac02f4.webp","width":209,"height":256,"source":"static-detail"},"actors":[{"creditedName":"保志 総一朗","creatorId":"vndb:s114","sourcePersonId":"vndb:s114","canonicalEntityId":"vndb:s114","name":"保志 総一朗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:49951","source":"vndb"}]},{"characterId":"char_vndb_c26428","characterName":"鈴懸","sourceIds":{"vndbCharacterId":"c26428"},"originalCharacterName":"鈴懸","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"930"},"height":{"reviewState":"source-only","source":"vndb","value":"171"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Birthplace: Musashi Province"},{"spoiler":false,"text":"Sword: Housenka"},{"spoiler":false,"text":"Style: Self-taught"},{"spoiler":false,"text":"A samurai with medical knowledge who grew up with a youkai. Right after he was born, he was thrown away to Takao Mountain as his parents couldn’t afford to feed more children. He was taken in by Karula—a tengu who lives in the mountain—who taught him both swordsmanship and medics. He came to Edo in order to find his dream. He’s honest, cheerful and innocent like a child, but due to his innocence, he won’t ever give up on fixing things he judged as wrong. Since he’s inexperienced and doesn’t know much about the world, he tends to cause quarrels with the government officials."},{"spoiler":false,"text":"from kokoronodamu"}],"source":"vndb","sourceCharacterId":"c26428"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed4b9f3ad4327db6dd0c155383d8ad2c84f433ed1349829230835dd28012a07b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afc860331d9375cf4640a680ec9035de2d693c351b8c40d73112ba07680d8e80.webp","width":217,"height":256,"source":"static-detail"},"actors":[{"creditedName":"逢坂 良太","creatorId":"vndb:s248","sourcePersonId":"vndb:s248","canonicalEntityId":"vndb:s248","name":"逢坂 良太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:49952","source":"vndb"}]},{"characterId":"char_vndb_c26429","characterName":"黒羽 実彰","sourceIds":{"vndbCharacterId":"c26429"},"originalCharacterName":"黒羽 実彰","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"birthday":{"reviewState":"source-only","source":"vndb","value":"615"},"height"