{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"3977","model":{"presentationWorkId":"egs:3977","staff":{"artwork":[{"creditedName":"庵西蘭","creatorId":"vndb:s9917","sourcePersonId":"egs:creator:2096","canonicalEntityId":"vndb:s9917","name":"庵西蘭","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5956","source":"egs"}],"scenario":[{"creditedName":"シナリオ制作チームさるさる","creatorId":"egs:creator:5656","sourcePersonId":"egs:creator:5656","canonicalEntityId":"egs:creator:5656","name":"シナリオ制作チームさるさる","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:272911","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_egs_22779","characterName":"高山 遥","sourceIds":{"egsCharacterIds":["22779"]},"originalCharacterName":"高山 遥","characterNameSource":null,"role":"1","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の同級生にして、なりたての彼女。"},{"spoiler":false,"text":"彼女曰く「ずっと気になってた」と言う感じで付き合い始めるが、今だ、身体の関係はなし。"},{"spoiler":false,"text":"クラスでも真面目かつ、そこそこ勉強も出来る人気者で、隠れファン多し。"},{"spoiler":false,"text":"しかしながら、「知らない人とは付き合えない」というまっとうな理由から、すでに数人振っている模様。"},{"spoiler":false,"text":"基本的に世話好きで尽くすタイプだが、ちょっと抜けているところも。"},{"spoiler":false,"text":"実に騙されやすく、すぐ冗談や嘘を本気にしてはからかわれやすい。"},{"spoiler":false,"text":"とにかくいつも一生懸命で、万人に好かれやすい性格。"}],"source":"egs","sourceCharacterId":"22779","sourceWorkId":"3241","spoiler":false},{"segments":[{"spoiler":false,"text":"高山遥"},{"spoiler":false,"text":"『スウィートハーツ』、『Sweet Hearts ～さんにんえっち～』に登場。"},{"spoiler":false,"text":"原画：庵西蘭（スィートハーツ）"},{"spoiler":false,"text":"主人公の同級生にしてなりたての彼女。"},{"spoiler":false,"text":"基本的に世話好きで尽くすタイプだが、ちょっと抜けている所も。"},{"spoiler":false,"text":"実に騙されやすく、すぐ冗談や嘘を本気にしてはからかわれたりしている。"},{"spoiler":false,"text":"とにかくいつも一生懸命で、万人に好かれやすい性格。"},{"spoiler":false,"text":"だが、騙されグセが付いているので、すぐに狼狽する事が多い。"},{"spoiler":false,"text":"弱点は寝起きで、かなりの確率で幼児退行してしまう。"},{"spoiler":false,"text":"眠る時も抱きつきグセがあったり（抱き枕愛用）、キスや頬ずりしまくったりとかなり激しい一面もある。"}],"source":"egs","sourceCharacterId":"22779","sourceWorkId":"3801","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の同級生にして、なりたての彼女……だった女の子。"},{"spoiler":false,"text":"本作では主人公とのエッチも十分経験済み。"},{"spoiler":false,"text":"牡丹と主人公の関係も許し、そればかりか3人で愛し合うことを提唱。"},{"spoiler":false,"text":"ずいぶん大人になったと思いきや、冗談や嘘を真に受けてしまうのは相変わらず。"}],"source":"egs","sourceCharacterId":"22779","sourceWorkId":"3977","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1577","sourceCompanyId":"egs:brand:1054","canonicalEntityId":"vndb:p1577","name":"スウィートハーツ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:3977:1054","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
