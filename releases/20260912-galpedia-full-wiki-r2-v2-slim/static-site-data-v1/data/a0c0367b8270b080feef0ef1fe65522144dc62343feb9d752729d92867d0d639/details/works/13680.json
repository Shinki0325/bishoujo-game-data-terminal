tityStatus":"source-native","relationId":"vndb:vn-staff:44866","source":"vndb"},{"creditedName":"葦辺 亨","creatorId":"vndb:s41129","sourcePersonId":"vndb:s41129","canonicalEntityId":"vndb:s41129","name":"葦辺亨","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:44867","source":"vndb"}]},"cast":[{"characterId":"char_c6919","characterName":"葛城 瑞穂","sourceIds":{"bangumi":[{"characterId":"198934","match":"exact-normalized-name-in-linked-work","subjectId":"224292"}],"egsCharacterIds":["12519"],"vndbCharacterId":"c6919"},"originalCharacterName":"葛城 瑞穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"35"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The mother of his best friend Yuya. She has been concerned about Kazuki's mother's absence since kindergarten, and has always invited him to her home."},{"spoiler":false,"text":"She trusts Kazuki as her son's best friend. She is a soft and cheerful mother who treats everyone equally. She has only had sex with her husband and has little skill and knowledge."},{"spoiler":false,"text":"Since she has not had sex with her husband for a long time, she falls in love with the youthful and energetic Kazuki."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c6919"},{"segments":[{"spoiler":false,"text":"主人公の親友・裕也の母親。"},{"spoiler":false,"text":"主人公のことは幼稚園時代から知っており、息子の親友として信頼している。"},{"spoiler":false,"text":"母親の居ない主人公を気遣って、自宅に招いてくれるなど、色々と世話を焼いてくれていた。"},{"spoiler":false,"text":"誰にでも分け隔てなく接する、優しく朗らかな性格。"},{"spoiler":false,"text":"セッ○スは夫しか知らないため、自分が思っているよりも拙い。"},{"spoiler":false,"text":"夫婦の営みはほとんどなくなっており、熟れた肉体を持て余し、欲求不満気味。"},{"spoiler":false,"text":"主人公とのセッ○スに溺れながらも、口ではどこまでも抵抗しようとする。"}],"source":"egs","sourceCharacterId":"12519","sourceWorkId":"13680","spoiler":false},{"segments":[{"spoiler":false,"text":"親友・裕也の母親。幼稚園の頃から、一輝に母親が居ないことを気遣い、ことあるごとに自宅に招いてくれていた優しい女性。"},{"spoiler":false,"text":"一輝のことは、息子の親友として信頼している。"},{"spoiler":false,"text":"誰に対しても平等に接する、柔和で朗らかなお母さん。"},{"spoiler":false,"text":"セックスは夫としか経験がなく、技術も知識も少ない。"},{"spoiler":false,"text":"旦那とご無沙汰なため、若さと勢いのある一輝とのセックスに溺れてしまう。"}],"source":"bangumi","sourceCharacterId":"198934"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/bed020e29f29973721bb2d394edec90e69e925517c90c46527993da204ec3d59.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3ee122a4fbea4bde4679792e5eca9b6e18fb5060f1086bfa0864423452034ef9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224292:198934:6349:1","source":"bangumi"}]},{"characterId":"char_vndb_c76666","characterName":"澤田 一輝","sourceIds":{"vndbCharacterId":"c76666"},"originalCharacterName":"澤田 一輝","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this work. His parents divorced when he was a child, and he was raised by his father."},{"spoiler":false,"text":"Because of this, he has a strong yearning for his mother, but at the same time, he also has a sense of hatred toward her for abandoning him. Although she is a bit shy, she is warm-hearted and usually interacts with people she is familiar with in a cheerful manner."},{"spoiler":false,"text":"She has had a longing and fondness for Mizuho, the mother of her best friend Yuya, since he was a child. He has been secretly developing a desire and obsession for Mizuho."},{"spoiler":false,"text":"He has good grades in school and is a quick-witted person. He has a pure heart, but also has conflicting and distorted emotions."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c76666"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/901a89bfa6141e586b5473a0ff79ef8faaa38c2a70cf388bf197ff84fd1b8cc6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11ae2335afe270de84e14325220b0462d5d92574c79ed4db0d3ae6e7529bf1ef.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1573","sourceCompanyId":"egs:brand:1897","canonicalEntityId":"vndb:p1573","name":"桃雛","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:13680:1897","source":"egs"},{"companyId":"vndb:p5726","sourceCompanyId":"vndb:p5726","canonicalEntityId":"vndb:p5726","name":"有限会社シルバーバレット","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:163209:v3757","source":"vndb"},{"companyId":"vndb:p28580","sourceCompanyId":"vndb:p28580","canonicalEntityId":"vndb:p28580","name":"まんごーぷりん","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:163210:v3757","source":"vndb"},{"companyId":"vndb:p1573","sourceCompanyId":"vndb:p1573","canonicalEntityId":"vndb:p1573","name":"桃雛","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:8483:v3757","source":"vndb"},{"companyId":"vndb:p5726","sourceCompanyId":"vndb:p5726","canonicalEntityId":"vndb:p5726","name":"有限会社シルバーバレット","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:8484:v3757","source":"vndb"},{"companyId":"vndb:p1573","sourceCompanyId":"vndb:p1573","canonicalE