ive","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An unwaveringly compassionate housekeeping genius, the maternal Tomomi draws attention from every man who catches a glimpse of her: Tetsuya being no exception. Much about Tomomi’s habits and personal life are well hidden, adding an air of mystique to her natural charisma."},{"spoiler":false,"text":"Taken from Nargrakhan's review."}],"source":"vndb","sourceCharacterId":"c3119"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae4d797d0d5912fc88df32f95361187c8c2b176fc760560fd6e339c31e2b7c13.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e22b05aa05d652e6dca213062b8d3d11ed757e81f9dd9bb8033ca91746d183e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"広森 なずな","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11259","source":"vndb"}]},{"characterId":"char_vndb_c3120","characterName":"御堂　伊織","sourceIds":{"vndbCharacterId":"c3120"},"originalCharacterName":"御堂　伊織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Class president of the graduating class, well-to-do Iori is daughter of the municipal councilman. Easily befriended and strongly devoted towards friends, her straightforward honesty is hard to disagree with."},{"spoiler":false,"text":"Taken from Nargrakhan's review."}],"source":"vndb","sourceCharacterId":"c3120"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/ter