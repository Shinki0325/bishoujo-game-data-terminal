{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"15380","model":{"presentationWorkId":"vndb:v15784","staff":{"artwork":[{"creditedName":"ゆ","creatorId":"egs:creator:16796","sourcePersonId":"egs:creator:16796","canonicalEntityId":"egs:creator:16796","name":"ゆ","roleCode":"artwork","roleLabel":"原画","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:104225","source":"egs"},{"creditedName":"ゆ","creatorId":"vndb:s22984","sourcePersonId":"vndb:s22984","canonicalEntityId":"vndb:s22984","name":"ゆ","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:112924","source":"vndb"}],"scenario":[{"creditedName":"将治","creatorId":"vndb:s16635","sourcePersonId":"egs:creator:16795","canonicalEntityId":"vndb:s16635","name":"将治","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:104224","source":"egs"}],"music":[{"creditedName":"飛来永理","creatorId":"vndb:s7262","sourcePersonId":"egs:creator:4840","canonicalEntityId":"vndb:s7262","name":"飛来永理","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:96087","source":"egs"}],"other":[]},"cast":[{"characterId":"char_vndb_c68331","characterName":"肋紋寺 メグ","sourceIds":{"vndbCharacterId":"c68331"},"originalCharacterName":"肋紋寺 メグ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Owner and manager of the confectionery store Primrose. After returning from France, she and Chiharu started to manage \"Primrose\", a confectionary store where customers can eat in."},{"spoiler":false,"text":"She has a strong connection with the people of the shopping association in the town and seems to have the aptitude for running a business. The store seems to be doing quite well."},{"spoiler":false,"text":"She is especially particular about coffee, and handles everything from purchasing beans to roasting and brewing. Her jewel-like coffee, brewed drop by drop with a flannel in one hand, is enough to make even the most discerning coffee connoisseur gasp."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c68331"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f266ab9ccc0510e8e96fb66712426b7a67cd3a2001859549dddcb2fb0959b18.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a489c2d3fd8d03f9164459852e563f66c9db8f7edef8fe3de361414e3a5036e.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c79612","characterName":"大瀬良 さくら","sourceIds":{"vndbCharacterId":"c79612"},"originalCharacterName":"大瀬良 さくら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An apprentice patissier who lives and works at Primrose, a pastry store tucked away in a residential area."},{"spoiler":false,"text":"She and the protagonist are childhood friends, having been in the same class in elementary, middle, and high school. However, after entering high school, they gradually became estranged as their conversation became less and less."},{"spoiler":false,"text":"Originally, she wanted to be a voice actor, but her dream was dashed and she decided to become a confectioner, her second favorite job. After graduating from high school, she studied French confectionery techniques at a confectionery school."},{"spoiler":false,"text":"She fell in love with the chef patissier Chiharu of \"Primrose\" where she works, and looks up to her as her mentor."},{"spoiler":false,"text":"Her treasures are her LD boxes and LD decks of anime that have not been released on DVD. She meets the protagonist again, who is at a loss, and asks him if he would like to work at the store where she works."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c79612"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38f6e7c8e180992b0e507ed69ff5b8ed516230825249d4012b81d876cf4323fe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1cee1b407b87bae01292fe66d3becfbcef6725870f81859d13c179fde8a2680.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c79613","characterName":"月見里 チハル","sourceIds":{"vndbCharacterId":"c79613"},"originalCharacterName":"月見里 チハル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chief Patissier of the confectionery store \"Primrose\". After paying off her parents' debts, she studied confectionery and went to France to study."},{"spoiler":false,"text":"After returning to Japan, she was invited by Megu, who had worked at the same place before, to become a patissier at Primrose, a pastry store."},{"spoiler":false,"text":"She is now like a mentor to apprentice patissier Sakura, she is trying her best to teach her all the skills she has in making fresh pastries."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c79613"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64b11b353f98172e8d009226c0a3a0aa2ca8878b1beed06f538e67348e9ee245.webp","fallbackUrl":"https: