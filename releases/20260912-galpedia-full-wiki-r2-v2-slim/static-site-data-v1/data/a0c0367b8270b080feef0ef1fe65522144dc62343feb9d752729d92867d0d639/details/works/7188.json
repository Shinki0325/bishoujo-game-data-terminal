/v1/characters/v1/images/01/018a1e0f1e15cc152a337f6263d82f776a74d217e3a6d6ba4ed2e27b1a949f27.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc9b640b9148a3b1ad4cd528faf65c649bb945b5f8936fb7754b706b3f3b0ecb.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c5274","characterName":"神野 つかさ","sourceIds":{"bangumi":[{"characterId":"48044","match":"exact-normalized-name-in-linked-work","subjectId":"149736"}],"egsCharacterIds":["26883"],"vndbCharacterId":"c5274"},"originalCharacterName":"神野 つかさ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"801"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Hiroto's classmates. She's obsessed with the occult, magic, tarot, and similar things."}],"source":"vndb","sourceCharacterId":"c5274"},{"segments":[{"spoiler":false,"text":"主人公の同級生。"},{"spoiler":false,"text":"部員が自分一人の「魔法研究会」に所属し、タロットや秘薬の調合など、怪しげな実験を繰り返しているオカルトおたく。実際、多少の魔法は使えるらしい。"},{"spoiler":false,"text":"何故か主人公に敵対しており、魔法の実験台にすることもしばしば。"},{"spoiler":false,"text":"趣味は暗いが、性格は明朗快活。"},{"spoiler":false,"text":"昼でも暗い実験室（サークル室）で儀式や実験をする傍らで、媚***などを使ってオナニーするのが日課（？）。"}],"source":"egs","sourceCharacterId":"26883","sourceWorkId":"3349","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の同級生。タロットや秘薬の調合などを始めとした（自称）魔法研究会（部員一人）のオカルトおたく。"},{"spoiler":false,"text":"実際に多少の魔法なら使えるらしい。洋人とはいつも敵対している。"},{"spoiler":false,"text":"薬や魔法の実験台に。暗い趣味の割に、明るくハツラツとした性格。"}],"source":"bangumi","sourceCharacterId":"48044"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4dd01bd4d3c8182bb28e4056c63a0252031b9fefdf2e10a0b05b0e5e280503f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd99564059efc7486c1712aba59bf230d289e80f4c2fa6133746c5f85f773024.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"祭田絵理","creatorId":"vndb:s456","sourcePersonId":"vndb:s456","canonicalEntityId":"vndb:s456","name":"祭田 絵理","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:149736:48044:19630:1","source":"bangumi"}]},{"characterId":"char_c5275","characterName":"南 瑚乃葉","sourceIds":{"bangumi":[{"characterId":"48040","match":"exact-normalized-name-in-linked-work","subjectId":"149736"}],"egsCharacterIds":["26879"],"vndbCharacterId":"c5275"},"originalCharacterName":"南 瑚乃葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"721"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染で、同級生。"},{"spoiler":false,"text":"また主人公のバイト先であるメイド喫茶「サザンクロス」のマスターの娘で、抗議のない日は店の手伝いをしている。"},{"spoiler":false,"text":"父親一人に育てられたためか、男優りで強気な面を覗かせるが、人当たりがよく可愛らしい容姿もあって、学園、喫茶店でもアイドル的な人気がある。"},{"spoiler":false,"text":"主人公に対してあれこれ口うるさいが、ほのかな恋心を寄せている。友人の柊那に主人公の告白の手伝いを頼まれ、複雑な想いのまま仲介を引き受ける。"}],"source":"egs","sourceCharacterId":"26879","sourceWorkId":"3349","spoiler":false},{"segments":[{"spoiler":false,"text":"メインヒロインの一人。洋人とは幼馴染であり、同級生でもある。"},{"spoiler":false,"text":"洋人のバイト先である喫茶店のマスターの娘で、講義の無い日は店の手伝いをしている。父親一人の手で育てられたためか、洋人に対しては時折、男勝りの強気な面を見せるところも。多少うるさがられているところもあるが、洋人のことをいつも気遣う世話好きな性格。人当たりもよく、学園の生徒からも喫茶店の客からも好かれている、マドンナ的な存在。友人である柊那に、洋人への告白を手伝って欲しいと相談され、複雑な思いで仲介役となる。"}],"source":"bangumi","sourceCharacterId":"48040"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fd1e8ca218c163dc36b4347ccf10b645de6b490ad61b39cb56ddd35126f0bd0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d793d0e5fd65f3887b583cc07986936c11b7bbd3cd3cf4c32c86bfbaf975a9cd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松久保いほ","creatorId":"vndb:s8744","sourcePersonId":"vndb:s8744","canonicalEntityId":"vndb:s8744","name":"松久保 いほ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:149736:48040:4889:1","source":"bangumi"},{"creditedName":"春瀬 みき","creatorId":"vndb:s1566","sourcePersonId":"vndb:s1566","canonicalEntityId":"vndb:s1566","name":"春瀬 みき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12068","source":"vndb"}]},{"characterId":"char_vndb_c11945","characterName":"南 作太郎","sourceIds":{"vndbCharacterId":"c11945"},"originalCharacterName":"南 作太郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"187"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"107"}},"descriptions":[