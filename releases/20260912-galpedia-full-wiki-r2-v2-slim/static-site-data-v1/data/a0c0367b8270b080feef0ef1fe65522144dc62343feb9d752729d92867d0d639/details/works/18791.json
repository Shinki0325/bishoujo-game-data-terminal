 side."}],"source":"vndb","sourceCharacterId":"c12340"},{"segments":[{"spoiler":false,"text":"【生真面目な先生。 主人公たちの担任。】"},{"spoiler":false,"text":"外国人とのクォーターで、外見は学園最高だが、堅物で生真面目で融通がきかなくて、しかも面白味がないので、人気はない。"},{"spoiler":false,"text":"「校内では節度を持ちなさい。"},{"spoiler":false,"text":"いちゃつきたいなら外でなさい。よろしいですね？」"}],"source":"egs","sourceCharacterId":"1313","sourceWorkId":"17365","spoiler":false},{"segments":[{"spoiler":false,"text":"生真面目な先生。 主人公たちの担任。"},{"spoiler":false,"text":"外国人とのクォーターで、外見は学園最高。"},{"spoiler":false,"text":"教え子を気に掛ける良き教師であろうと心掛けてはいるのだが、どうにも融通が利かない。"},{"spoiler":false,"text":"加えて面白味がないので、残念ながら人気はない。"},{"spoiler":false,"text":"「校内で恋愛をするなとは言いませんが、節度をわきまえなさい」"}],"source":"bangumi","sourceCharacterId":"42717"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd03613cf2949f4135271df43ee1b2979644fcfe3d3812f3cc37dc9e54d67f8c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb3475fd8dd5dc252dd3c36d51f3371f197474c1ca50447caf68571cf2e7106c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:68239:42717:4646:1","source":"bangumi"}]},{"characterId":"char_c12341","characterName":"静内 蛍火","sourceIds":{"bangumi":[{"characterId":"42718","match":"exact-normalized-name-in-linked-work","subjectId":"45348"}],"egsCharacterIds":["1314"],"vndbCharacterId":"c12341"},"originalCharacterName":"静内 蛍火","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【元気な女の子。】"},{"spoiler":false,"text":"友達とつるんでふざけ、遊びや学生生活を謳歌している。"},{"spoiler