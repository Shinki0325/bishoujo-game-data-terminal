reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a second-year student at Harusaki Gakuen."},{"spoiler":false,"text":"She hates city males and is cold to the protagonist (a male), but speaks friendly to him when they are in the dormitory (female)."},{"spoiler":false,"text":"In contrast to her best friend Minako, she cannot do any housework or cooking, but her grades are good and she is one of the top students in her grade."},{"spoiler":false,"text":"She likes cute mascot-type characters. She is especially fond of a mascot named \"Sachi Ususan\"."},{"spoiler":false,"text":"\"Don't get too close, you little slut!\""}],"source":"vndb","sourceCharacterId":"c5575"},{"segments":[{"spoiler":false,"text":"春咲学園二年生。"},{"spoiler":false,"text":"都会の男が大嫌いで主人公(男)には冷たいが、寮(女同士)だと友好的に喋ってくれる。"},{"spoiler":false,"text":"親友の美奈子とは対照的にかじや炊事の類は全くできないが、成績は良く学年トップクラス。"},{"spoiler":false,"text":"可愛いマスコット系キャラが好き。"},{"spoiler":false,"text":"特に「さちうすさん」というマスコットが一押し。"}],"source":"egs","sourceCharacterId":"24542","sourceWorkId":"13107","spoiler":false},{"segments":[{"spoiler":false,"text":"春咲学園二年生。"},{"spoiler":false,"text":"都会の男が大嫌いで主人公（男）には冷たいが、寮（女同士）だと友好的に喋ってくれる。"},{"spoiler":false,"text":"親友の美奈子とは対照的に家事や炊事の類は全くできないが、成績は良く学年トップクラス。"},{"spoiler":false,"text":"可愛いマスコット系キャラが好き。特に「さちうすさん」というマスコットが一押し。"},{"spoiler":false,"text":"「近づかないでよ、いやらしッ！」"}],"source":"bangumi","sourceCharacterId":"31228"}],"profileFacts":[{"label":"星座","source":"bangumi","sourceCharacterId":"31228","value":"天秤座"},{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"24542","sourceWorkId":"13107","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"24542","sourceWorkId":"13107","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"24542","sourceWorkId":"13107","sourceField":null