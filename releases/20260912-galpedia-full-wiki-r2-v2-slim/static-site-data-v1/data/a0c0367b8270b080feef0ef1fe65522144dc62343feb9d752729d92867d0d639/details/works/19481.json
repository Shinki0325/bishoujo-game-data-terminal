{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"19481","model":{"presentationWorkId":"vndb:v13327","staff":{"artwork":[{"creditedName":"ジェントル佐々木","creatorId":"vndb:s1223","sourcePersonId":"egs:creator:87","canonicalEntityId":"vndb:s1223","name":"ジェントル佐々木","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:124171","source":"egs"}],"scenario":[{"creditedName":"OZ","creatorId":"vndb:s1905","sourcePersonId":"egs:creator:13419","canonicalEntityId":"vndb:s1905","name":"OZ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:124172","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c77080","characterName":"プリズムシャイン","sourceIds":{"bangumi":[{"characterId":"209253","match":"exact-normalized-name-in-linked-work","subjectId":"223992"}],"egsCharacterIds":["2764"],"vndbCharacterId":"c77080"},"originalCharacterName":"プリズムシャイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"s Hatsune's younger sister, and just like her sister, she hates crooked things. She loves her older sister."},{"spoiler":false,"text":"Unlike her cool beauty sister, she is lively and has a straightforward personality where her emotions are easily shown on her face, and she is always on the move. She"},{"spoiler":false,"text":"is popular with a different demographic than Hatsune, and like Hatsune, she is also often confessed to, but for now, her older sister is number one, so she has no intention of dating a guy. She is"},{"spoiler":false,"text":"not good at studying, and Hatsune often scolds her about it."},{"spoiler":false,"text":"She admires her older sister who fights as a Prism Breaker, so she trains hard herself, and recently she has started fighting alongside her sister as a Prism Shine"}],"source":"vndb","sourceCharacterId":"c77080"},{"segments":[{"spoiler":false,"text":"今作のメインヒロイン、プリズムシャイン。"},{"spoiler":false,"text":"初音の妹で、姉と同じように曲がったことが嫌いな少女。"},{"spoiler":false,"text":"お姉ちゃん大好き。"},{"spoiler":false,"text":"クールビューティーな姉とは違い、快活で感情がすぐ顔に出る分かりやすい性格で、いつもちょこちょこ動きまわっている。"},{"spoiler":false,"text":"初音とはまた違った層に人気があり、同じように告白されることもあるが、今のところはお姉ちゃんが一番なので、男の人と付き合うつもりはない。"},{"spoiler":false,"text":"勉強は苦手で、よくそのことで初音にお説教されている。"},{"spoiler":false,"text":"プリズムレイカーになって戦う姉に憧れ、自らも特訓を積んで、最近になりプリズムシャインとして姉と一緒に戦うようになる。"}],"source":"egs","sourceCharacterId":"2764","sourceWorkId":"20139","spoiler":false},{"segments":[{"spoiler":false,"text":"初音の妹で、姉と同じように曲がったことが嫌いな少女。お姉ちゃん大好き。"},{"spoiler":false,"text":"クールビューティーな姉とは違い、快活で感情がすぐ顔に出る分かりやすい性格で、 いつもちょこちょこ動きまわっている。"},{"spoiler":false,"text":"初音とはまた違った層に人気があり、同じように告白されることもあるが、 今のところはお姉ちゃんが一番なので、男の人と付き合うつもりはない。"},{"spoiler":false,"text":"勉強は苦手で、よくそのことで初音にお説教されている。"},{"spoiler":false,"text":"プリズムレイカーになって戦う姉に憧れ、自らも特訓を積んで、 最近になりプリズムシャインとして姉と一緒に戦うようになる。"}],"source":"bangumi","sourceCharacterId":"209253"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59816d9daca9154d03d9aad57568b1090b26e7ecc7fd1d40b649fdcff16723b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbaf3802cb5d2e8f88d617a79b4d388d7c5d69a4e3fd23e01268e895600a3217.webp","width":203,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223993:209253:15684:1","source":"bangumi"}]},{"characterId":"char_c77081","characterName":"プリズムレイカー","sourceIds":{"bangumi":[{"characterId":"209252","match":"exact-normalized-name-in-linked-work","subjectId":"223992"}],"egsCharacterIds":["2765"],"vndbCharacterId":"c77081"},"originalCharacterName":"プリズムレイカー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A serious girl with a strong sense of justice who hates crooked things."},{"spoiler":false,"text":"She is the president of the student council at school and can be a bit stubborn, but her looks and behavior make her popular with both men"},{"spoiler":false,"text":"and women. She is often confessed to due to her natural talents such as her face and style, but she has never dated a boy because the school rules prohibit impure heterosexual relations. She"},{"spoiler":false,"text":"also works harder than anyone else, so her grades are always at the top. As a Prism Breaker, she fights every day against"},{"spoiler":false,"text":"the evil organization that attacks the city . No matter how hard it is for her, she believes in protecting the weak and those in trouble. Her overwhelming fighting power also makes her unpopular with the executives of ."}],"source":"vndb","sourceCharacterId":"c77081"},{"segments":[{"spoiler":false,"text":"生真面目で、曲がったことが大嫌いな正義感の強い少女。"},{"spoiler":false,"text":"学校では生徒会の会長をやっていて、頭が硬いことを除けば、そのビジュアルや立ち居振る舞いから人気を博している。"},{"spoiler":false,"text":"顔やスタイル等、生まれ持った素養もあってよく告白されるが、校則で不純異性交遊を禁止しているという理由などから、男子と付き合ったことがない。"},{"spoiler":false,"text":"また人一倍努力家なため、成績も常に上位をキープしている。"},{"spoiler":false,"text":"プリズムレイカーとして、街を襲う悪の組織＜グレナダ＞と日々戦いを繰り広げている。"},{"spoiler":false,"text":"自分がどれだけ辛くとも、弱い人や困っている人を守り抜くという信念を持っている。"},{"spoiler":false,"text":"また、その圧倒的な戦闘力から＜グレナダ＞の幹部には疎まれている。"}],"source":"egs","sourceCharacterId":"2765","sourceWorkId":"20139","spoiler":false},{"segments":[{"spoiler":false,"text":"生真面目で、曲がったことが大嫌いな正義感の強い少女。"},{"spoiler":false,"text":"学校では生徒会の会長をやっていて、やや頭が硬いところもあるが、 そのビジュアルや立ち居振る舞いから男女問わず人気を博している。"},{"spoiler":false,"text":"顔やスタイル等、生まれ持った素養もあってよく告白されるが、 校則で不純異性交遊を禁止しているという理由などから、 男子と付き合ったことがない。"},{"spoiler":false,"text":"また人一倍努力家なため、成績も常に上位をキープしている。"},{"spoiler":false,"text":"プリズムレイカーとして、街を襲う悪の組織"},{"spoiler":false,"text":"＜グレナダ＞と日々戦いを繰り広げている。"},{"spoiler":false,"text":"自分がどれだけ辛くとも、弱い人や困っている人を守り抜くという信念を持っている。"},{"spoiler":false,"text":"また、その圧倒的な戦闘力から＜グレナダ＞の幹部には疎まれている。"}],"source":"bangumi","sourceCharacterId":"209252"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5dcddcc8ee57d19984d4fcc617e14497afb22e301acc17462b7b95bb068934d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/4583ce107c09d095bbc7f22911a76cd3495590458fcc28e536149fd23d91872f.webp","width":195,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223993:209252:5890:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p684","sourceCompanyId":"egs:brand:1841","canonicalEntityId":"vndb:p684","name":"pin-point","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:19481:1841","source":"egs"},{"companyId":"vndb:p684","sourceCompanyId":"vndb:p684","canonicalEntityId":"vndb:p684","name":"ピンポイント","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:130210:v13327","source":"vndb"},{"companyId":"vndb:p684","sourceCompanyId":"vndb:p684","canonicalEntityId":"vndb:p684","name":"ピンポイント","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:167385:v13327","source":"vndb"},{"companyId":"vndb:p1000","sourceCompanyId":"vndb:p1000","canonicalEntityId":"vndb:p1000","name":"Amber","roleCodes":["publisher