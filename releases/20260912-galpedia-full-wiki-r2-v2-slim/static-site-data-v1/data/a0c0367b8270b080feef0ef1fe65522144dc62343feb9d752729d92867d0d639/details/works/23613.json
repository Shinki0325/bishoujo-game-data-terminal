vndbCharacterId":"c1521"},"originalCharacterName":"松原優菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1104"},"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year high school student. She is smart, attractive, popular and rich girl who is admired by the students of St. Michael's. Yet she falls in love with the clumsy and average Nanami."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c1521"},{"segments":[{"spoiler":false,"text":"ミカ女の2年生で、実質上の学生会である「環境整備委員会」の委員長で、両親は大病院の院長というお嬢様。"},{"spoiler":false,"text":"ややおっとりはしているものの、知的美人で性格も温厚。"},{"spoiler":false,"text":"スポーツ万能で巨乳の持ち主という正に完璧超人。"},{"spoiler":false,"text":"下級生はもちろん、上級生にまで慕われる学園のアイドル的存在だが、当人にその自覚はなくやや天然体質。"},{"spoiler":false,"text":"ところが……実はかなりの甘えん坊でエロ乙女。"},{"spoiler":false,"text":"で、身も心もめいっぱい尽くさないと気が済まない困った性格。"}],"source":"egs","sourceCharacterId":"556","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"ミカ女の３年生で、実質上の学生会である「環境整備委員会」の委員長で、両親は大病院の院長というお嬢様。"},{"spoiler":false,"text":"ややおっとりはしているものの、知的美人で性格も温厚。スポーツ万能で巨乳の持ち主という正に完璧超人。"},{"spoiler":false,"text":"相変わらずかなりの甘えん坊でエロ乙女。七海の事となると、なりふり構わず取り乱してしまう一面も。"},{"spoiler":false,"text":"委員長の引退を前に、恋人でもある七海相手に、猛スパルタの特訓中の毎日を過ごしているらしい。"}],"source":"egs","sourceCharacterId":"556","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"米卡女校二年级学生，环境整备委员会会长，在同学之间很吸引目光，是个各方面都很完美的大小姐，而内心十分天然呆以及好色。未来的志向是当医生。与织田七海邂逅的同时也喜欢上了她。"}],"source":"bangumi","sourceCharacterId":"16346"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9c072803dc6fbb6f24e92724427bc16b55006ea909060fd3e71c384d64c961c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/3558bbc922b5417b53a3a81266db79cd6c97917360352188772a3f0c479c9aba.webp","width":84,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩村琴美","creatorId":"vndb:s1172","sourcePersonId":"vndb:s1172","canonicalEntityId":"vndb:s1172","name":"岩村 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5356:16346:4813:1","source":"bangumi"}]},{"characterId":"char_c5721","characterName":"織田 七海","sourceIds":{"bangumi":[{"characterId":"16650","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16650","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["555"],"vndbCharacterId":"c5721"},"originalCharacterName":"織田 七海","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"515"},"bust":{"reviewState":"source-only","source":"vndb","value":"75"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first-year high school student. Despite being a pretty average girl with bad luck, she has caught the attention of the famous Yuuna."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c5721"},{"segments":[{"spoiler":false,"text":"ミカ女の２年生で、明るく元気で人見知りをしない性格。上級生である優菜とは恋人同士。"},{"spoiler":false,"text":"優菜共々「環境整備委員会」のメンバーで、優菜の跡を継いで委員長になる為に現在猛勉強中。"},{"spoiler":false,"text":"実はちょっと妄想癖豊かな耳年増少女。頭の中は、いつも優菜とのラブロマンスでいっぱい！？"},{"spoiler":false,"text":"イマイチ育たないおっぱいと、ぷにぷにしたお腹が悩みの恋する乙女。"}],"source":"egs","sourceCharacterId":"555","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"米卡女校的新生，不擅长学习，但却为了考上米卡女校（原因是学校制服漂亮）而拼命读书并最终遂愿。家境普通，有点不适应周围全是大小姐的环境。在新生入学典礼当天对优菜一见钟情，因此进入环境整备委员会。后来应优菜的要求称其为“姐姐大人”。"},{"spoiler":false,"text":"声：元祖版:十色冬香，唇とキスで＋新装版:春奈有美 (bgm.tv二者皆查不到…)"}],"source":"bangumi","sourceCharacterId":"16650"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32dc36aa1260afa4c96ab20f03ca5a5e9a3b64602f2a611f942debc80ce3bdb1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b843db9158f0dba25c6e86dea88a462c4a71085c96a4971d6106df4357a15bf6.webp","width":89,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木川絵理子","creatorId":"vndb:s1634","sourcePersonId":"vndb:s1634","canonicalEntityId":"vndb:s1634","name":"木川 絵理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5356:16650:4668:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p437","sourceCompanyId":"egs:brand:1942","canonicalEntityId":"vndb:p437","name":"ふぐり屋","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:23613:1942","source":"egs"},{"companyId":"vndb:p21699","sourceCompanyId":"vndb:p21699","canonicalEntityId":"vndb:p21699","name":"AleksaPsi","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:124617:v917","source":"vndb"},{"companyId":"vndb:p21699","sourceCompanyId":"vndb:p21699","canonicalEntityId":"vndb:p21699","name":"AleksaPsi","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:124704:v917","source":"vndb"},{"companyId":"vndb:p18672","sourceCompanyId":"vndb:p18672","canonicalEntityId":"vndb:p18672","name":"iqdhk8t0hxww","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:131931:v917","source":"vndb"},{"companyId":"vndb:p1238","sourceCompanyId":"vndb:p1238","canonicalEntityId":"vndb:p1238","name":"Jiyuu VN","roleCodes":["pub