":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:155838","source":"egs"},{"creditedName":"茶太","creatorId":"vndb:s203","sourcePersonId":"vndb:s203","canonicalEntityId":"vndb:s203","name":"茶太","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:118747","source":"vndb"},{"creditedName":"恋純 ほたる","creatorId":"vndb:s1908","sourcePersonId":"vndb:s1908","canonicalEntityId":"vndb:s1908","name":"恋純 ほたる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:118750","source":"vndb"},{"creditedName":"菱野 優希","creatorId":"vndb:s2791","sourcePersonId":"vndb:s2791","canonicalEntityId":"vndb:s2791","name":"菱野 優希","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:118753","source":"vndb"},{"creditedName":"藤本 スミレ","creatorId":"vndb:s4123","sourcePersonId":"vndb:s4123","canonicalEntityId":"vndb:s4123","name":"藤本 スミレ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:118754","source":"vndb"},{"creditedName":"紘瀬 さやか","creatorId":"vndb:s4480","sourcePersonId":"vndb:s4480","canonicalEntityId":"vndb:s4480","name":"紘瀬 さやか","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:118762","source":"vndb"},{"creditedName":"伊東 久美子","creatorId":"vndb:s4481","sourcePersonId":"vndb:s4481","canonicalEntityId":"vndb:s4481","name":"伊東 久美子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:118763","source":"vndb"},{"creditedName":"Rastel","creatorId":"vndb:s4482","sourcePersonId":"vndb:s4482","canonicalEntityId":"vndb:s4482","name":"rastel","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:118764","source":"vndb"}]},"cast":[{"characterId":"char_c30389","characterName":"篠原 悠利","sourceIds":{"bangumi":[{"characterId":"34228","match":"exact-normalized-name-in-linked-work","subjectId":"128763"}],"egsCharacterIds":["6326"],"vndbCharacterId":"c30389"},"originalCharacterName":"篠原 悠利","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is the son of the famous fashion brand \"Shinohara.\" Even so, he is kind-hearted and not arrogant."},{"spoiler":false,"text":"He seems to be popular if he is not talking, but he is actually not good with girls to the point of not speaking properly when interacting with them."},{"spoiler":false,"text":"\"What are you going to do if the next president of Shinohara can't even talk with the girls?\""},{"spoiler":false,"text":"At the behest of the current Shinohara president (mother), he ended up going to Magnolia Girls' Academy with his status and gender hidden."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c30389"},{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"学園の２年生。"},{"spoiler":false,"text":"大企業の御曹司ながら、驕ったところもなく、心優しい男の子。"},{"spoiler":false,"text":"物腰も柔らかく、黙っていればもてそうなものだが、ガールフレンドはできた試しがない。"},{"spoiler":false,"text":"というのは、女の子が妙に苦手で、まともに喋ることさえできないためだった。"},{"spoiler":false,"text":"それについて本人は、女の力が強い家庭で生まれ育ったせいでは…と密かに考えている。"},{"spoiler":false,"text":"（ちなみに６人姉弟の末っ子で、上５人はみんな女）"},{"spoiler":false,"text":"「シノハラの次期社長が女子と喋れもしないでどうするの！」"},{"spoiler":false,"text":"現社長（母親）に一喝された悠里は、本人なりの決意もあって、“マグノリア女学院”に身分も性別も隠して通うことになるのだった。"}],"source":"egs","sourceCharacterId":"6326","sourceWorkId":"21775","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の2年生。 大企業の御曹司ながら驕ったところのない、心優しい男の子。"},{"spoiler":false,"text":"物腰も柔らかくモテそうなものだが、ガールフレンドはできた試しがない。"},{"spoiler":false,"text":"というのも、女の子が妙に苦手でまともに喋ることさえ出来ないため。"},{"spoiler":false,"text":"それについて本人は、女の力が強い家庭で生まれ育ったせいではと密かに考えている。"},{"spoiler":false,"text":"（6人姉弟の末っ子で、他の 5人はみんな女性。）"},{"spoiler":false,"text":"「シノハラの次期社長が女子と喋れもしないでどうするの！」 と現社長（母親）に一喝され、"},{"spoiler":false,"text":"本人なりの決意もあって マグノリア女学院に身分も性別も隠して通うことになる。"},{"spoiler":false,"text":"女装中は 篠原悠利 と名乗っている。"}],"source":"bangumi","sourceCharacterId":"34228"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/213aa535d40b25ff95288a729eacfbb6a8736ff95c6a3f2791db7343603a3957.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d1f075d2b738d9098a1652e0ca0b67c855c8114e5bcce1a6f78383676d4346d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c30390","characterName":"西園寺 紗夜","sourceIds":{"bangumi":[{"characterId":"34227","match":"exact-normalized-name-in-linked-work","subjectId":"128763"}],"egsCharacterIds":["6330"],"vndbCharacterId":"c30390"},"originalCharacterName":"西園寺 紗夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a cold girl, both in her behaviour and her looks."},{"spoiler":false,"text":"Due to her personality, she had been curtly refusing to engage, and thus, she was given the nickname \"Iron Maiden.\" Though, she is rather fond of the nickname."},{"spoiler":false,"text":"She seems cold about everything, which gives her a unique and cool vibe. But, she does not appear to accept her own cold self because she constantly searches for something to warm her heart."},{"spoiler":false,"text":"She is a ojousama like Airi, but unlike Airi, she has had contact with men in social circles. However, she had never met a man she was attracted to."},{"spoiler":false,"text":"She may seem uninterested, but it is not like she is not interested in romance."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c30390"},{"segments":[{"spoiler":false,"text":"学園の３年生。"},{"spoiler":false,"text":"言動もルックスもクールな女の子。"},{"spoiler":false,"text":"その性格から告白（エンゲージ）を素っ気なく断り続けていたところ、とうとうついたあだ名が“アイアン・メイデン（鉄の乙女）”。"},{"spoiler":false,"text":"とはいえ本人はその称号を結構気に入っている。"},{"spoiler":false,"text":"何事にも冷めたところがあり、それが独特のクールな雰囲気を醸し出している。"},{"spoiler":false,"text":"だがその冷めた自分を甘んじて受け入れているわけではなく、心を熱くしてくれる何かがないかと、常に探しているようなところがある。"},{"spoiler":false,"text":"藍璃と同じく良家のお嬢様だが、藍璃とは違い、社交界などで男性と接したことはある。だが心惹かれる男性にはついぞお目にかかったことはなかった。冷めてはいるものの、恋愛に興味がないわけではない。"}],"source":"egs","sourceCharacterId":"6330","sourceWorkId":"21775","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の3年生。 言動もルックスもクールな女の子。"},{"spoiler":false,"text":"数多の告白を素っ気なく断り続け、付いたあだ名が “アイアン・メイデン（鉄の乙女）” 。"},{"spoiler":false,"text":"しかし本人は、その称号を結構気に入っている。"},{"spoiler":false,"text":"何事にも冷めたところがある一方で、心を熱くしてくれる何かを探している。"},{"spoiler":false,"text":"良家のお嬢様だが箱入り娘というわけではなく、社交界などで男性と接したことはある。"},{"spoiler":false,"text":"しかし恋愛に興味が無いわけではないが、心惹かれる男性に出会ったことはない。"}],"source":"bangumi","sourceCharacterId":"34227"}],"profileFacts":[{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"6330","sourceWorkId":"21775","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd732417fca38d8491054702a76d73b4d7f3c452478f9814566dd831fc6b24cb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19e7a355f57b46e3ab434e2b8a500a2b8a896facb953038ce61fa15a4a9e8e93.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安藤知花","creatorId":"vndb:s2001","sourcePersonId":"vndb:s2001","canonicalEntityId":"vndb:s2001","name":"早崎 千香子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:128763:34227:19106:1","source":"bangumi"}]},{"characterId":"char_c30391","characterName":"白雪 ゆみな","sourceIds":{"bangumi":[{"characterId":"34226","match":"exact-normalized-name-in-linked-work","subjectId":"128763"}],"egsCharacterIds":["6329"],"vndbCharacterId":"c30391"},"originalCharacterName":"白雪 ゆみな","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a shy and quiet girl."},{"spoiler":false,"text":"Her cuteness is like a small animal and is especially popular among senior students."},{"spoiler":false,"text":"She has severe androphoia."},{"spoiler":false,"text":"She is worried about what she would do after graduating from Magnolia Girls' Academy. 'A wonderful love...' is what she has been yearning for as a young maiden."},{"spoiler":false,"text":"The protagonist sympathises with Yumina because their circumstances are a little similar. Of course, Yumina does not know that fact because she only recognises the protagonist as a 'lovely-oneesama.'"},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c30391"},{"segments":[{"spoiler":false,"text":"学園の１年生。"},{"spoiler":false,"text":"引っ込み思案でおとなしい女の子。まるで小動物みたいな可愛らしさがあり、とくに上級生からの人気が高い。"},{"spoiler":false,"text":"実は重度の男性恐怖症。マグノリア女学院に通っている間はいいが、卒業した後はいったいどうなることかと、今から思い悩んでいる。"},{"spoiler":false,"text":"一方で、年頃の乙女として、素敵な彼氏と素敵な恋愛がしてみたい…というあこがれも抱いている。"},{"spoiler":false,"text":"境遇がちょっと似ているため、主人公はゆみなに対して共感を抱く。"},{"spoiler":false,"text":"だがもちろん、ゆみなのほうはその事実を知らず、主人公のことは「素敵なお姉様」としか認識していない。"}],"source":"egs","sourceCharacterId":"6329","sourceWorkId":"21775","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の1年生。 引っ込み思案でおとなしい女の子。"},{"spoiler":false,"text":"まるで小動物みたいな可愛らしさがあり、特に上級生からの人気が高い。"},{"spoiler":false,"text":"重度の男性恐怖症で、学院を卒業した後はいったいどうなることかと今から思い悩んでいる。"},{"spoiler":false,"text":"一方で、年頃の乙女として素敵な彼氏と素敵な恋愛がしてみたい…… という憧れも抱いている。"},{"spoiler":false,"text":"境遇がちょっと似ているため、主人公は ゆみなに対して共感を抱く。"},{"spoiler":false,"text":"もちろん ゆみなはそんな事情など知らず、主人公を “素敵なお姉様” としか認識していない。"}],"source":"bangumi","sourceCharacterId":"34226"}],"profileFacts":[{"label":"身高（本版本）","value":"148 cm","valueContext":null,"source":"egs","sourceCharacterId":"6329","sourceWorkId":"21775","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e510f67e1c3a4d2324e573fc89a17f2c71dafaf0cdaef86c97aef32a6a26fda6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/615881f4352bbf3dcb1b67b4b5c6fea90dcb18c96395fde8365e63864ec071e0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:128763:34226:11646:1","source":"bangumi"}]},{"characterId":"char_c30393","characterName":"神水守 藍璃","sourceIds":{"bangumi":[{"characterId":"34225","match":"exact-normalized-name-in-linked-work","subjectId":"128763"}],"egsCharacterIds":["6328"],"vndbCharacterId":"c30393"},"originalCharacterName":"神水守 藍璃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is as popular as Haruka in the academy."},{"spoiler":false,"text":"Besides her beauty, her popularity and support were also because of her enveloping gentle personality."},{"spoiler":false,"text":"She does not seem to mind the \"engage\" offer, but she seems not too keen on the idea."},{"spoiler":false,"text":"She is a genuine ojousama and has never interacted with men. Therefore, her knowledge of men is strangely fictitious, and perhaps the reason why she is very interested in sexual things and why there is a rumour about her being older than she looks."},{"spoiler":false,"text":"She is the dormitory manager in charge of the second-years, and that was how she ended up interacting with the protagonist."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c30393"},{"segments":[{"spoiler":false,"text":"学園の２年生。"},{"spoiler":false,"text":"遙花と並ぶ学園の人気者。眉目秀麗なことに加えて、全てをふんわりと包み込むような優しい人柄が人気と支持を集めていた。"},{"spoiler":false,"text":"やはりエンゲージの申し込みは引きも切らないが、本人はあまりピンときていないらしい。"},{"spoiler":false,"text":"生粋のお嬢様で、男子と触れ合ったことがない。"},{"spoiler":false,"text":"そのため、男子についての知識に、妙に空想的なところがある。"},{"spoiler":false,"text":"またそのせいもあってか、エッチなことには興味津々で、意外にも耳年増という噂。"},{"spoiler":false,"text":"２年生担当の寮長を務めていて、そんな縁から主人公と触れ合っていくことになる。"}],"source":"egs","sourceCharacterId":"6328","sourceWorkId":"21775","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の2年生。 遙花と並ぶ学園の人気者。"},{"spoiler":false,"text":"眉目秀麗で、すべてをふんわりと包み込むような優しい人柄が人気と支持を集めている。"},{"spoiler":false,"text":"やはり “エンゲージ” の申し込みは引きも切らないが、本人はあまりピンときていないらしい。"},{"spoiler":false,"text":"生粋のお嬢様で、男子と触れ合ったことがない。"},{"spoiler":false,"text":"そのため男性に関する知識に空想的なところがあり、意外とエッチなことに興味津々で耳年増という噂も。"},{"spoiler":false,"text":"2年生担当の寮長を務めていて、そんな縁から主人公と触れ合っていくことになる。"}],"source":"bangumi","sourceCharacterId":"34225"}],"profileFacts":[{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"6328","sourceWorkId":"21775","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1ae7c2a9b6e61ac8551a4258c50f28bd4d0f4a11eb2fa4084b3f0bbb8de4215c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac91facfe2636abd9002ea9e6937d2ae11b646239597f49186315f23ab84f875.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:128763:34225:6469:1","source":"bangumi"}]},{"characterId":"char_c30394","characterName":"姫小路 遙花","sourceIds":{"bangumi":[{"characterId":"34224","match":"exact-normalized-name-in-linked-work","subjectId":"128763"}],"egsCharacterIds":["6327"],"vndbCharacterId":"c30394"},"originalCharacterName":"姫小路 遙花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the most popular girl in the academy because of her beauty and friendly personality."},{"spoiler":false,"text":"Haruka has turned down countless girls' confessions who wanted to \"engage\" with her. She is interested in love, but she doesn't have much interest in pseudo-love between girls."},{"spoiler":false,"text":"She is the first to reach out to Yuuri when he becomes stiff in front of everyone, and she has been Yuuri most reliable friend since then."},{"spoiler":false,"text":"She is extremely popular, but she has enrolled in the late courses; a \"Customer.\" It seemed like she was having a hard time letting her consciousness slip away and that she was creating a wall for the people around her to confess (engage) their feelings to her again, and she was secretly worried about it."},{"spoiler":false,"text":"She is an ordinary girl dreaming of an ordinary romance."},{"spoiler":false,"text":"Translated from official website"}],"source":"vndb","sourceCharacterId":"c30394"},{"segments":[{"spoiler":false,"text":"学園の２年生。"},{"spoiler":false,"text":"その美貌と気さくな性格から、学園きっての人気者。"},{"spoiler":false,"text":"彼女と“エンゲージ”を結びたがる女の子は数知れないが、遙花はそのいくつもの告白を断ってきた。"},{"spoiler":false,"text":"恋愛に興味はあるものの、女の子同士の疑似恋愛にはあまり惹かれるものがなかった。"},{"spoiler":false,"text":"みんなの前でカチコチになってしまった悠利に、真っ先に手を差しのばしてくれたのが彼女だった。"},{"spoiler":false,"text":"以来、悠利にとって、最も頼りになる友人となる。"},{"spoiler":false,"text":"抜群の人気を誇る遙花だが、実は後期課程から入学した“お客さん”。"},{"spoiler":false,"text":"本人もその意識がなかなか抜けず、また周りも告白（エンゲージ）してくるわりには壁を作っているようで、心中密かに悩んでいる。"},{"spoiler":false,"text":"ごく普通の恋愛を夢見ている、その意味ではごく普通の女の子。"}],"source":"egs","sourceCharacterId":"6327","sourceWorkId":"21775","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の2年生。 その美貌と気さくな性格から学園きっての人気者。"},{"spoiler":false,"text":"緊張で固まっていた主人公に手を差し伸べてくれて、それ以来 最も頼りになる友人となった。"},{"spoiler":false,"text":"彼女と “エンゲージ” を結びたがる子は数知れないが、そのすべての告白を断ってきた。"},{"spoiler":false,"text":"恋愛に興味はあるものの、女の子同士の疑似恋愛にはあまり惹かれるものがない様子。"},{"spoiler":false,"text":"抜群の人気を誇る遙花だが、実は後期課程から入学した “お客さん”。"},{"spoiler":false,"text":"本人もその意識がなかなか抜けず、また周りも告白してくるわりには壁を作っているようで密かに悩んでいる。"}],"source":"bangumi","sourceCharacterId":"34224"}],"profileFacts":[{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"6327","sourceWorkId":"21775","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4fe8a186c9f275a5f658f1f6c7ab04ccb7b421040143341633884458588caa28.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00bb14e0a639bb18111d9236fe62023439f0cdb27898e1f771e763c0f7b34bfd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤さくら","creatorId":"vndb:s947","sourcePersonId":"vndb:s947","canonicalEntityId":"vndb:s947","name":"花澤 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:128763:34224:17075:1","source":"bangumi"}]},{"characterId":"char_vndb_c47438","characterName":"篠原 晶","sourceIds":{"vndbCharacterId":"c47438"},"origi