:"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"おバカで元気な見習い天使。ミカとはソリが合わず、遭うたびにケンカばかりしている。"},{"spoiler":false,"text":"馬鹿すぎたせいで奉仕学科の単位が取れず、ミカと一緒に補修を受けることになってしまった。"},{"spoiler":false,"text":"地上では無知であることに付け込まれてしまい…?"}],"source":"bangumi","sourceCharacterId":"204787"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/1162be99851a58155542b758e5f71c0ebe5bfe756206582706a5912cfa78ec09.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9cf4c13551d5db9081d29ea85a6f7bd8d1fc83a9017b61e25da107981658508e.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"秋野かえで","creatorId":"vndb:s17531","sourcePersonId":"vndb:s17531","canonicalEntityId":"vndb:s17531","name":"秋野 かえで","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:438199:204787:34936:1","source":"bangumi"}]},{"characterId":"char_bangumi_204788","characterName":"Freya","sourceIds":{"bangumi":[{"characterId":"204788","match":"source-roster","subjectId":"438199"}]},"originalCharacterName":"Freya","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ミカたちを優しく教え導く女神様。"},{"spoiler":false,"text":"いつも柔和な笑みを浮かべるその姿はまさに女神様…に見えるが、実はかなりの好色家であり、ちょっとしたことですぐ発情してしまうむっつりスケベ。"},{"spoiler":false,"text":"時折、ミカたちの様子を見に地上に降りてくる。"}],"source":"bangumi","sourceCharacterId":"204788"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21abe3a7b67e864a89c06ded9c12807147f2ec7fac033be6f63cad90a8d6f965.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c48a7682d8bf040e6e566ecf9e16ff