{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"765","model":{"presentationWorkId":"vndb:v4636","staff":{"artwork":[{"creditedName":"山本定吉(山本岳央)","creatorId":"egs:creator:713","sourcePersonId":"egs:creator:713","canonicalEntityId":"egs:creator:713","name":"山本定吉(山本岳央","roleCode":"artwork","roleLabel":"原画","identityStatus":"no-alias-hit","relationId":"egs:work-creator:922","source":"egs"}],"scenario":[{"creditedName":"KAI","creatorId":"vndb:s1504","sourcePersonId":"egs:creator:714","canonicalEntityId":"vndb:s1504","name":"KAI","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:923","source":"egs"}],"music":[{"creditedName":"森野いずみ","creatorId":"vndb:s2141","sourcePersonId":"egs:creator:4422","canonicalEntityId":"vndb:s2141","name":"森野いずみ","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:108585","source":"egs"}],"other":[{"creditedName":"鳩月つみき","creatorId":"vndb:s1466","sourcePersonId":"egs:creator:377","canonicalEntityId":"vndb:s1466","name":"鳩月つみき","detail":"ディレクター","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:108586","source":"egs"},{"creditedName":"藤原組長(藤原行弘、つるぎゆきの)","creatorId":"vndb:s326","sourcePersonId":"egs:creator:13540","canonicalEntityId":"vndb:s326","name":"藤原組長(藤原行弘、つるぎゆきの)","detail":"マップデザイン・広報","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:108587","source":"egs"},{"creditedName":"鳩月 つみき","creatorId":"vndb:s1466","sourcePersonId":"vndb:s1466","canonicalEntityId":"vndb:s1466","name":"鳩月 つみき","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:51738","source":"vndb"}]},"cast":[{"characterId":"char_bangumi_100081","characterName":"オボン","sourceIds":{"bangumi":[{"characterId":"100081","match":"source-roster