:"vndb:vn-staff:7124","source":"vndb"},{"creditedName":"海路 本田","creatorId":"vndb:s6939","sourcePersonId":"vndb:s6939","canonicalEntityId":"vndb:s6939","name":"海路 本田","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:7126","source":"vndb"}]},"cast":[{"characterId":"char_c90957","characterName":"七滝 鎖月","sourceIds":{"bangumi":[{"characterId":"163499","match":"exact-normalized-name-in-linked-work","subjectId":"509183"}],"egsCharacterIds":["25238"],"vndbCharacterId":"c90957"},"originalCharacterName":"七滝 鎖月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔女がらみの事件を未然に防ぐのを生業にする魔女。"},{"spoiler":false,"text":"主人公の命を救ったことから、魔力を著しく消耗し、現在はかなり弱体化してしまっている模様。"},{"spoiler":false,"text":"それを理由にして主人公を助手として仕事を手伝わせている。"},{"spoiler":false,"text":"スタイル抜群のクールビューティーなお姉さんだが、その行動は大雑把。"},{"spoiler":false,"text":"主人公をからかうことが、今は、何より楽しいらしい。"}],"source":"egs","sourceCharacterId":"25238","sourceWorkId":"8075","spoiler":false},{"segments":[{"spoiler":false,"text":"魔女。"},{"spoiler":false,"text":"魔女や魔法がらみの事件を未然に防ぐのが仕事。魔女の世界から『はぐれ魔女』達を探し、狩るために各地を巡っている。"},{"spoiler":false,"text":"主人公が死にかけていたところに偶然居合わせた彼女は魔法を使って、主人公を生き返らせた。相当な力を持っているのだが、主人公の復活にかなりの魔力を使ってしまったので今は弱体化中。 それを理由にして助手である響也に色々と仕事を手伝わせる。"},{"spoiler":false,"text":"魅惑的なボディラインを持つお姉さん。クールな外見の割に行動は結構大雑把。主人公をからかうことを娯楽の一つにしている。"}],"source":"bangumi","sourceCharacterId":"163499"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60502bd9a48ba71dd29a48b8782a5537e2345b478ce8e3ba757119f6907c93f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef874edea042749dc585891447e621ecee4e9b930a631d69c3f613c670fb77c9.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"藤本 教子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:509183:163499:5669:1","source":"bangumi"}]},{"characterId":"char_c90959","characterName":"久城 蓮華","sourceIds":{"bangumi":[{"characterId":"163500","match":"exact-normalized-name-in-linked-work","subjectId":"509183"}],"egsCharacterIds":["25239"],"vndbCharacterId":"c90959"},"originalCharacterName":"久城 蓮華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。"},{"spoiler":false,"text":"元気快活で、運動神経抜群の女の子。"},{"spoiler":false,"text":"主人公が昔住んでいた家の隣に住んでいた幼馴染。"},{"spoiler":false,"text":"勝気な性格から、ちょくちょくトラブルに巻き込まれることが多く、時折、彼女と接した相手が原因不明の怪我を負ってしまうことがあるようだが……。"}],"source":"egs","sourceCharacterId":"25239","sourceWorkId":"8075","spoiler":false},{"segments":[{"spoiler":false,"text":"響也のクラスメイト。元幼馴染。"},{"spoiler":false,"text":"昔響也が引越しするまでの間、隣の家に住んでいた。元気かつ活発な女の子。運動神経抜群で各運動部をあちこち掛け持ちしている。小さい頃に会っていた主人公のことを覚えていて、転校してきた主人公に積極的に声を掛けて来る。"},{"spoiler":false,"text":"その勝気な性格からトラブルに巻き込まれることが多いが、なぜか相手が原因不明の怪我を負ったりすることがある。"}],"source":"bangumi","sourceCharacterId":"163500"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5f047d96205952d3e169d60f4c09088c82dc903ab414693a001af2e33997dc4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcac6e36ba01407c7e85725208ce2a188c44b9fe218cfad6e341654de08f1f73.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"横手 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:509183:163500:4937:1","source":"bangumi"}]},{"characterId":"char_c90960","characterName":"氷見沼 水芭","sourceIds":{"bangumi":[{"characterId":"163501","match":"exact-normalized-name-in-linked-work","subjectId":"509183"}],"egsCharacterIds":["25240"],"vndbCharacterId":"c90960"},"originalCharacterName":"氷見沼 水芭","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"舞台となる学園の生徒会副会長。"},{"spoiler":false,"text":"人望も行動力も現生徒会長よりも上回ることから、実質的には彼女が会長といっても過言ではない。"},{"spoiler":false,"text":"文武両道の優等生で、性格も非常にクール。"},{"spoiler":false,"text":"規律にうるさく、自分にも相手にも厳しい。"},{"spoiler":false,"text":"規律を守らせるために強硬な手法を用いることも多く、規律を破る生徒を密かに罰しているのでないかという噂も……。"}],"source":"egs","sourceCharacterId":"25240","sourceWorkId":"8075","spoiler":false},{"segments":[{"spoiler":false,"text":"クールな上級生。"},{"spoiler":false,"text":"生徒会副会長。人望も行動力も会長を上回り、実質的な会長。文武両道に秀で自分にも他人にも厳しい。規律を守ることに心血を注いでいて、よく校内を巡回している。"},{"spoiler":false,"text":"強硬的な手法を用いることが多いので、規律を破る生徒を密かに罰しているのではないかという噂がある。"}],"source":"bangumi","sourceCharacterId":"163501"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1d09d4dddc0f5bf14990dd7d1e801841b84a87b21b815268d78bba581b765f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/765f65b9df255ed8c3a9b2b025b780240ca81e7bd1d365357db3ee38ff98581a.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"嶋崎はるか","creatorId":"vndb:s1013","sourcePersonId":"vndb:s1013","canonicalEntityId":"vndb:s1013","name":"嶋崎 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:509183:163501:6302:1","source":"bangumi"}]},{"characterId":"char_c90961","characterName":"綺羅星 眺","sourceIds":{"bangumi":[{"characterId":"163503","match":"exact-normalized-name-in-linked-work","subjectId":"509183"}],"egsCharacterIds":["25242"],"vndbCharacterId":"c90961"},"originalCharacterName":"綺羅星 眺","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園でも有名なお嬢様。"},{"spoiler":false,"text":"昔、この辺りを治めていた一族の一人娘。"},{"spoiler":false,"text":"育ちの良さ、やや世間知らず、その立ち振る舞いも、まさにお嬢様。"},{"spoiler":false,"text":"自分がお嬢様然とした目て見られるのを意識していて、周囲の理想を壊さないよう人知れず努力している。"},{"spoiler":false,"text":"学園を愛し、自分が学園を正しく導かなければならないと使命感に燃えているようだが……。"}],"source":"egs","sourceCharacterId":"25242","sourceWorkId":"8075","spoiler":false},{"segments":[{"spoiler":false,"text":"お嬢様で上級生。"},{"spoiler":false,"text":"昔、この辺りを治めていた一族の一人娘。世が世ならお嬢様と呼ばれていたのかもしれない。立ち振る舞いもいかにもなお嬢様で、学内でも有名な存在である。学園を愛していて、この学園を正しく導いていかなければならないという使命感に燃えている。"},{"spoiler":false,"text":"本人は認めたがらないが、育ちのせいか意外とものを知らなかったりする。実は結構努力家で、皆の理想とするお嬢様像と現実の自分をすり合わせるために密かに頑張っていたりする。"},{"spoiler":false,"text":"お嬢故か周囲に取り巻きがいることが多い。"}],"source":"bangumi","sourceCharacterId":"163503"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fde8722aee70f5fdeb234dc4c46e66dad9fdc18b46d693432f20d4e0794fdb3c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/138a68fa7575c080d0394bf448c313e1489edc78b57d9b037dda922ff8b46e5a.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:509183:163503:4675:1","source":"bangumi"}]},{"characterId":"char_c90962","characterName":"五十嵐 千歳","sourceIds":{"bangumi":[{"characterId":"163504","match":"exact-normalized-name-in-linked-work","subjectId":"509183"}],"egsCharacterIds":["25243"],"vndbCharacterId":"c90962"},"originalCharacterName":"五十嵐 千歳","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園内を徘徊している謎の女性。"},{"spoiler":false,"text":"学生でも教師でもないようだが、学園内のことに、かなり精通している。"}],"source":"egs","sourceCharacterId":"25243","sourceWorkId":"8075","spoiler":false},{"segments":[{"spoiler":false,"text":"謎の女性。"},{"spoiler":false,"text":"響也が学内で見かけることになる女性。見たところ学生でも教師でも無いようだが、それにしては学内に妙に詳しい。"}],"source":"bangumi","sourceCharacterId":"163504"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/007d01f757d5fcc22fe1fd1172fa8447df072b403136e28c4abcc6e082f3e685.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/dea7b7cc326fe151c1dd4d1dd020f4309d35214e2cace91855c5205f86a17226.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"嶋崎はるか","creatorId":"vndb:s1013","sourcePersonId":"vndb:s1013","canonicalEntityId":"vndb:s1013","name":"嶋崎 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:509183:163504:6302:1","source":"bangumi"}]},{"characterId":"char_c90963","characterName":"高尾 紗和","sourceIds":{"bangumi":[{"characterId":"163502","match":"exact-normalized-name-in-linked-work","subjectId":"509183"}],"egsCharacterIds":["25241"],"vndbCharacterId":"c90963"},"originalCharacterName":"高尾 紗和","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスの担任。"},{"spoiler":false,"text":"新米教師というわけではないが、おっとりぽややんとした雰囲気から頼りなさを感じる女教師。"},{"spoiler":false,"text":"尊敬される教師を目指しているが、生徒からの評価は、どちらかといえば「友達」感覚に近い。"},{"spoiler":false,"text":"学園一のプロポーションの持ち主だが、彼女自身はあまり意識していないようだ。"},{"spoiler":false,"text":"読書好きなことから、よく図書室を利用している。"}],"source":"egs","sourceCharacterId":"25241","sourceWorkId":"8075","spoiler":false},{"segments":[{"spoiler":false,"text":"ぽやんとした女教師。"},{"spoiler":false,"text":"主人公のクラスの担任。温和というよりはぼんやりしているという印象の方が強い。新人という訳ではないのだが、まだまだ不慣れな感じが多い。皆に尊敬されるような教師になりたいと思っているが、生徒達からは友達のような感じで親しまれている。"},{"spoiler":false,"text":"学園一と噂されるプロポーションの持ち主だが、当人は余りそれを意識していない。「もったいない」「資源の無駄遣い」とよく言われる。暇さえあれば図書室に篭っている。機敏とは縁遠いような人物なのに、結構神出鬼没だったりする。"}],"source":"bangumi","sourceCharacterId":"163502"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b91ab7c7221ed375299a01dd82c2815fa7c055199b8e0e20b767e34e3ef903c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f09815ff88032cf6438997c5134229ee6934eaacacbca37361725222d84e6f4f.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北条明日香","creatorId":"vndb:s1016","sourcePersonId":"vndb:s1016","canonicalEntityId":"vndb:s1016","name":"北条 明日香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:509183:163502:32486:1","source":"bangumi"}]},{"characterId":"char_vndb_c90958","characterName":"舞鶴 響也","sourceIds":{"vndbCharacterId":"c90958"},"originalCharacterName":"舞鶴 響也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86996f220b3b12526e1094cc806049db939aa80a182e14ace74786d9e2eb145a.webp","