{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"9952","model":{"presentationWorkId":"vndb:v2076","staff":{"artwork":[{"creditedName":"川合正起","creatorId":"vndb:s898","sourcePersonId":"egs:creator:351","canonicalEntityId":"vndb:s898","name":"川合正起","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:48661","source":"egs"}],"scenario":[{"creditedName":"有限会社りっくりっく","creatorId":"vndb:s6802","sourcePersonId":"egs:creator:4023","canonicalEntityId":"vndb:s6802","name":"有限会社りっくりっく","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:48662","source":"egs"},{"creditedName":"若林 浩太郎","creatorId":"vndb:s2555","sourcePersonId":"vndb:s2555","canonicalEntityId":"vndb:s2555","name":"若林 浩太郎","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:31534","source":"vndb"},{"creditedName":"石弓 達也","creatorId":"vndb:s4411","sourcePersonId":"vndb:s4411","canonicalEntityId":"vndb:s4411","name":"牧山 昌弘","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:31535","source":"vndb"}],"music":[],"other":[]},"cast":[{"characterId":"char_c26792","characterName":"五十川 さゆり","sourceIds":{"bangumi":[{"characterId":"90317","match":"exact-normalized-name-in-linked-work","subjectId":"229268"}],"egsCharacterIds":["6513"],"vndbCharacterId":"c26792"},"originalCharacterName":"五十川 さゆり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Protagonist's mother-in-law. She blames herself for her daughter's actions, and so she offers to take care of the protagonist in place of her daughter Akane."},{"spoiler":false,"text":"Several years ago, she eloped with her boyfriend who then left her as soon as she got pregnant. She used to be a prostitute to provide for her daughter by herself, and was a top hostess back in the day together with the protagonist's aunt Fujino. Ashamed of her past, she wants to keep it a secret from the protagonist if possible."}],"source":"vndb","sourceCharacterId":"c26792"},{"segments":[{"spoiler":false,"text":"主人公の妻の母。"},{"spoiler":false,"text":"質の悪い男にひっかかり、ホステスをして一人娘を育てた過去を持つ。"},{"spoiler":false,"text":"厳格な家庭に育ち、貞操観念の強い女性なのだが、ホステス時代には、仕方なく客と一夜を共にすることもあったため、肉体は十分開発されていて、性技も巧み。"},{"spoiler":false,"text":"男の裏の部分を見て来たため、男を全く信用していなかったが、あまりにも不器用な娘婿にだけは、今までにない誠意を感じ、惹かれていく。"},{"spoiler":false,"text":"「若い殿方が精を放ちたいと思うのは本能ですもの。仕方がありませんわ」"}],"source":"egs","sourceCharacterId":"6513","sourceWorkId":"9952","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妻の母。"},{"spoiler":false,"text":"質の悪い男にひっかかり、ホステスをして一人娘を育てた過去を持つ。"},{"spoiler":false,"text":"厳格な家庭に育ち、貞操観念の強い女性なのだが、ホステス時代には、仕方なく客と一夜を共にすることもあったため、肉体は十分開発されていて、性技も巧み。"},{"spoiler":false,"text":"男の裏の部分を見て来たため、男を全く信用していなかったが、あまりにも不器用な娘婿にだけは、今までにない誠意を感じ、惹かれていく。"},{"spoiler":false,"text":"「若い殿方が精を放ちたいと思うのは本能ですもの。仕方がありませんわ」"}],"source":"egs","sourceCharacterId":"6513","sourceWorkId":"22087","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妻の母。"},{"spoiler":false,"text":"質の悪い男にひっかかり、ホステスをして一人娘を育てた過去を持つ。"},{"spoiler":false,"text":"厳格な家庭に育ち、貞操観念の強い女性なのだが、ホステス時代には、仕方なく客と一夜を共にすることもあったため、肉体は十分開発されていて、性技も巧み。"},{"spoiler":false,"text":"男の裏の部分を見て来たため、男を全く信用していなかったが、あまりにも不器用な娘婿にだけは、今までにない誠意を感じ、惹かれていく。"},{"spoiler":false,"text":"「若い殿方が精を放ちたいと思うのは本能ですもの。仕方がありませんわ」"}],"source":"egs","sourceCharacterId":"6513","sourceWorkId":"22102","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妻の母。"},{"spoiler":false,"text":"若い頃に質の悪い男にひっかかって娘を出産。男は妊娠を機に雲隠れし、実家からも絶縁を言い渡されるがホステスをして一人娘を育て上げた大変な苦労人。"},{"spoiler":false,"text":"元々厳格な家庭で育てられた為、貞操観念は極めて強いが、ホステス時代には生きていく為、仕方なく客と寝る事もあった。"},{"spoiler":false,"text":"それ故、肉体は十二分に開発され、性技も巧みではあるが、世の男性の裏の部分を見てきたため男性を全く信用していない。"},{"spoiler":false,"text":"しかしあまりにも不器用な娘婿（主人公）にだけは今まで自分が接してきた男性には無い誠意のようなものを感じている。"},{"spoiler":false,"text":"娘の不始末のせいでとなにくれとなく主人公の世話を焼くうちに姑ではなく女として主人公を意識するようになってしまう。"}],"source":"bangumi","sourceCharacterId":"90317"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"6513","sourceWorkId":"9952","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"6513","sourceWorkId":"9952","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"63 cm","valueContext":null,"source":"egs","sourceCharacterId":"6513","sourceWorkId":"9952","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21fb1b628552e03e65401ee67240d12eecb2c631e92e4e10d75a008044a49124.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46f72227cdf8ee3047b48f357393d5ddd50bc8e93989c3a43cdf800eb333aa3d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229268:90317:6036:1","source":"bangumi"}]},{"characterId":"char_c26793","characterName":"二階堂 藤乃","sourceIds":{"bangumi":[{"characterId":"90318","match":"exact-normalized-name-in-linked-work","subjectId":"229268"}],"egsCharacterIds":["19201"],"vndbCharacterId":"c26793"},"originalCharacterName":"二階堂 藤乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Protagonist's aunt. She was the protagonist's first love, and the woman who took his virginity when he was a child."},{"spoiler":false,"text":"She considered Sayuri as her rival back when they were hostesses, as she was always second to her. After hearing news of Akihiko being abandoned by his wife, she rushed over to his house out of worry, and soon lived with him. Contrary to her sharp tongue and blunt personality, she's actually very kind and thoughtful."}],"source":"vndb","sourceCharacterId":"c26793"},{"segments":[{"spoiler":false,"text":"主人公の親戚の叔母。"},{"spoiler":false,"text":"水商売から身を起こし、今では複数の飲食店を経営するオーナーになった女傑で、気風のいい姉御肌タイプだが、気に食わない相手には傲慢な態度をとることがある。"},{"spoiler":false,"text":"藤乃にとって、主人公は特別らしく幼い頃から可愛がっていて、それは、彼が性に目覚めた頃、独占欲に駆られて筆おろしをしたほど。"},{"spoiler":false,"text":"さゆりとは、同じ店で働くホステスとして、トップを争うライバル同士だった。"},{"spoiler":false,"text":"再会したさゆりが向ける、主人公への好意を感じ取り、非常に警戒していている。"},{"spoiler":false,"text":"「女の身体の扱い方も全部アタシが教えてあげたの。アタシがあの子の初めてのオンナなんだから」"}],"source":"egs","sourceCharacterId":"19201","sourceWorkId":"9952","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の親戚の叔母。"},{"spoiler":false,"text":"身体一つで水商売から身を起こし、今では複数の飲食店を経営するオーナーにまで登りつめた女傑。"},{"spoiler":false,"text":"気風のいい姉御肌な女性だが、他人や気に食わない人間に対しては傲慢で高飛車な態度を取ることもしばしば。"},{"spoiler":false,"text":"しかし、主人公にだけは特別で子供の頃からとにかく猫可愛がりしていた。"},{"spoiler":false,"text":"その愛情は肉親の情を大きく越えており、主人公が性に目覚めた頃に独占欲に駆られて筆下ろしを施した程である。"},{"spoiler":false,"text":"かつて、さゆりとは同じ店で働くホステスとして、店のトップを競い合うライバルだった。"},{"spoiler":false,"text":"結婚式でさゆりと再会して以来、彼女の無意識の主人公への好意を敏感に感じ取り、非常に警戒している。"},{"spoiler":false,"text":"蒸発騒動を好機とばかりに主人公を手中に取り戻すべく押しかけてくる。"}],"source":"bangumi","sourceCharacterId":"90318"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"19201","sourceWorkId":"9952","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"19201","sourceWorkId":"9952","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"19201","sourceWorkId":"9952","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57436bad13ee6f904ea23851df4ff8a59bcb1585e250e0356af342738374181a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/1530da6b285091f2ac3e644a0cb4dda2e4d7595bf34c0b67f193326f85f8e1de.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あらいしずか","creatorId":"vndb:s665","sourcePersonId":"vndb:s665","canonicalEntityId":"vndb:s665","name":"あらい しずか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229268:90318:4647:1","source":"bangumi"}]},{"characterId":"char_c26794","characterName":"朝比奈 静江","sourceIds":{"bangumi":[{"characterId":"90319","match":"exact-normalized-name-in-linked-work","subjectId":"229268"}],"egsCharacterIds":["19202"],"vndbCharacterId":"c26794"},"originalCharacterName":"朝比奈 静江","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"94"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Her husband is the man who the protagonist's wife engaged in an affair with. She tries to kill the protagonist out of anger, but soon starts living together with the protagonist, his mother-in-law, and his aunt."},{"spoiler":false,"text":"She is pressured by her in-laws to get pregnant, and since she's failed to do so, she gets routinely scorned by them. Because of that, she never enjoyed sex with her husband."}],"source":"vndb","sourceCharacterId":"c26794"},{"segments":[{"spoiler":false,"text":"主人公の妻と一緒に蒸発した男性の妻。"},{"spoiler":false,"text":"嫁ぎ先では、後継ぎを生むためだけの道具として扱われていた。"},{"spoiler":false,"text":"夫の蒸発で嫁ぎ先にいられなくなり、実家にも帰れず、逆恨みから、主人公に文句を言うためにやってきた。"},{"spoiler":false,"text":"お人好しの主人公からの申し出で同居を始めるが、始めは横柄に接してくる。"},{"spoiler":false,"text":"しかし、彼が自分同様に傷ついた者だと悟り、心を開くと、徐々にオンナとしての悦びを見出し、笑顔を取り戻していく。"},{"spoiler":false,"text":"「男の人にこんな事をしてもらうのは初めてなもので……」"}],"source":"egs","sourceCharacterId":"19202","sourceWorkId":"9952","spoiler":false},{"segments":[{"spoiler":false,"text":"妻と一緒に蒸発した男性の妻。"},{"spoiler":false,"text":"旦那が蒸発したせいで嫁ぎ先にもいられなくなり、実家にも帰れず、捨て鉢になって逆恨みし主人公に文句を言いに来たが藤乃に一喝されてしまう。"},{"spoiler":false,"text":"娘の不始末で静江にまで辛い思いをさせてしまったと涙を流すさゆりを見兼ねてお人好しの主人公が静江に同居を申し出る。"},{"spoiler":false,"text":"始めは主人公をどうしても許せず横柄に接するが、やがて自分と同様に配偶者の裏切りに傷ついた存在であると悟り、心を開いていく。"},{"spoiler":false,"text":"嫁ぎ先では夫からは跡継ぎを産むためだけの道具のように扱われ、姑からはなかなか懐妊しないことを苛められ、繊細な心を痛めていた。"},{"spoiler":false,"text":"主人公と生活をともにする事で様々なプレッシャーから開放され、徐々にオンナとしての悦びを見出し笑顔を取り戻していく。"}],"source":"bangumi","sourceCharacterId":"90319"}],"profileFacts":[{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"19202","sourceWorkId":"9952","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"19202","sourceWorkId":"9952","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"19202","sourceWorkId":"9952","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6da940b8ae4dcb1b0339c6d7c1a32b854e407341cff0b5a635e2f604cf926f38.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1725021e87b018c9f8fd76b7126f6d5ea3538fbf58b15607ea698369f80237a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MARIO","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229268:90319:4918:1","source":"bangumi"}]},{"characterId":"char_vndb_c46805","characterName":"日下部 秋彦","sourceIds":{"vndbCharacterId":"c46805"},"originalCharacterName":"日下部 秋彦","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Akihiko moves into a new house where he was supposed to start living with his wife and mother-in-law. There, he suddenly receives a text from his wife telling him that she has been having an affair with another man and to take care of her mother for her. To make matters worse, his work place finds out about the affair and he is forced to take a paid leave."},{"spoiler":false,"text":"Soon he finds himself living with three beautiful women: his mother-in-law, his aunt, and the wife of the man whom his wife cheated on him."}],"source":"vndb","sourceCharacterId":"c46805"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/163208ce63144ee86ea37ee41410df63fa23ca5e068197e9ec0e1d0824068c37.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/646dc4c5cc746a7c7f36475725c1229adbe8b2a7abc84c2