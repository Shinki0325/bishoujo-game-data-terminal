{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"15083","model":{"presentationWorkId":"egs:15083","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_78458","characterName":"ユーディー","sourceIds":{"bangumi":[{"characterId":"78458","match":"source-roster","subjectId":"249447"},{"characterId":"78458","match":"source-roster","subjectId":"41265"},{"characterId":"78458","match":"source-roster","subjectId":"41266"}]},"originalCharacterName":"ユーディー","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"16"},"birthday":{"reviewState":"source-only","source":"bangumi","value":"1010"},"height":{"reviewState":"source-only","source":"bangumi","value":"160"},"weight":{"reviewState":"source-only","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"继承家业经营着魔法药店的炼金术士少女，性格开朗活泼而有些冒失。一次在调和道具龙之沙漏（作用类似于时之石板，可以静止怪物的时间一会儿）时不小心掉了一根头发进入大锅，结果发生意外而来到了200年后的未来。她一面靠着炼金术维持生活，一面寻找着回自己时代的方法。游戏中她只与女性角色有感情戏，所以本作也被部分玩家划分为百合系。"}],"source":"bangumi","sourceCharacterId":"78458"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"78458","value":"炼金术士"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43587131185eeb20d843b41f17221591d00d0bbd5ce564a51a28a8c7b773ed22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b21f25557e9c81370aa2f7871120cbfec11ee7ebae35067f5118db5e17d33aec.webp","width":181,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神田理江","creatorId":"vndb:s858","sourcePersonId":"vndb:s858","canonicalEntityId":"vndb:s858","name":"神田 理江","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41266:78458:4618:1","source":"bangumi"}]},{"characterId":"char_bangumi_78459","characterName":"ヴィトス・ロートス","sourceIds":{"bangumi":[{"characterId":"78459","match":"source-roster","subjectId":"41265"},{"characterId":"78459","match":"source-roster","subjectId":"41266"}]},"originalCharacterName":"ヴィトス・ロートス","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"20"},"birthday":{"reviewState":"source-only","source":"bangumi","value":"0102"},"height":{"reviewState":"source-only","source":"bangumi","value":"172"},"weight":{"reviewState":"source-only","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"隶属于商会的青年，一个放高利贷的新手，,是尤蒂来到200年前的世界，所遇到的第一个人。,为人喜欢金钱，讨厌负债。,很会做生意，对女性不太拿手，很会算账，,王国内外，甚至连小道消息他都能够知道，,有时还会带着自己的眼镜进行一些细小的工作"}],"source":"bangumi","sourceCharacterId":"78459"}],"profileFacts":[{"label":"星座","source":"bangumi","sourceCharacterId":"78459","value":"摩羯座"},{"label":"职业","source":"bangumi","sourceCharacterId":"78459","value":"商人(放高利贷的）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed460bdc67430db3252534368100854e2845d032eb74a9b43b29f48a7d4d05bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf0c57f85cf54022c0490620545be74835e4e8c098f08a4061f341e7429e0c47.webp","width":170,"height":241,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_78460","characterName":"Sphere","sourceIds":{"bangumi":[{"characterId":"78460","match":"source-roster","subjectId":"41265"},{"characterId":"78460","match":"source-roster","subjectId":"41266"}]},"originalCharacterName":"Sphere","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"35"},"height":{"reviewState":"source-only","source":"bangumi","value":"140"},"weight":{"reviewState":"source-only","source":"bangumi","value":"23"}},"descriptions":[{"segments":[{"spoiler":false,"text":"喜欢：甜点；,讨厌：苦的东西、恐怖故事；,梦想：在精灵界开蛋糕店。,外表看起来像是十岁左右小女孩的小不点，也是PSP版前作《尤蒂的工作室～格拉姆纳特的炼金术士～》中的新收录登场人物，在前作中不但失去记忆，甚至连名字也都忘记，会跟尤蒂在芬迪王国正中央山脉里面的古代遗迹“法克多亚神殿”中相遇；而25年过去了，在《薇欧蕾特的工作室～格拉姆纳特的炼金术士2～群青的回忆～》中她将再度迷路，并与女主角在卡洛迪（胡萝卜）遗迹相遇。在本作中，她依然还是一样说话很毒舌，不过或许是因为精神方面比前作要稍微成长一点，因此被其他角色当成小姐姐一般看待。,"}],"source":"bangumi","sourceCharacterId":"78460"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48585771bab96ee6289ceab721a1ee0ea9360ef5adc54cb7f19c59f54e8fe4c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0dfc06c19ff689673ea91934c4d46c8897fd138714d9c6b5c4d520666dcb2332.webp","width":181,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p910","sourceCompanyId":"egs:brand:766","canonicalEntityId":"vndb:p910","name":"ガスト","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:15083:766","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
