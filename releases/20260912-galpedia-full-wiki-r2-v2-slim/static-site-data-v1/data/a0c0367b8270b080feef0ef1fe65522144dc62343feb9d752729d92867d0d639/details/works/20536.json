-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e1b2e3fd50a9603e57503e5de9f4812b18f439faf45b6dd0b9cc19a36cded2b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/200f0b2c18f90c184f8c3767a9f22d54062aefe25ef47b6e3472f7b3ca8eff9e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西口有香","creatorId":"vndb:s24","sourcePersonId":"vndb:s24","canonicalEntityId":"vndb:s24","name":"西口 有香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:105787:26231:6592:1","source":"bangumi"}]},{"characterId":"char_c21369","characterName":"矢本 由美子","sourceIds":{"bangumi":[{"characterId":"26232","match":"exact-normalized-name-in-linked-work","subjectId":"105787"}],"egsCharacterIds":["4063"],"vndbCharacterId":"c21369"},"originalCharacterName":"矢本 由美子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl that was admitted to the school from outside the country. She is a member of the badminton team. She sees Airi as a rival. She has a very high self-esteem, but also has a very candid side and is easily teased. Her nickname is \"Yamato Sauce\", whom Airi came up with. When she is called that she becomes really angry."}],"source":"vndb","sourceCharacterId":"c21369"},{"segments":[{"spoiler":false,"text":"他県の学園に通う少女。バドミントン部所属。"},{"spoiler":false,"text":"藍里をライバル視している。"},{"spoiler":false,"text":"負けん気が強く、プライドも高いが、若干素直すぎる面もあり、からかわれやすい。"},{"spoiler":false,"text":"あだ名は「やもっさん（藍里命名）」だが、そう呼ぶと割と本気で怒る。"}],"source":"egs","sourceCharacterId":"4063","sourceWorkId":"20536","spoiler":false},{"segments":[{"spoiler":false,"text":"他県の学園に通う少女。 バドミントン部所属。藍里をライバル視している。"},{"spoiler":false,"text":"負けん気が強くプライドも高いが、若干素直すぎる面もあり、からかわれやすい。"},{"spoiler":false,"text":"あだ名は 「やもっさん」（藍里命名） だが、そう呼ぶとわりと本気で怒る。"},{"spoiler":false,"text":"「あたしと勝負しなさい、瀬峰さん。」"}],"source":"bangumi","sourceCharacterId":"26232"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8ae4a2f8f3002c4be24f9d85e3c873a51001aea46674b98b63c42540a4c431e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d79c906dae8f6af3d28dc0d437a47a727a9f9e57b2860cadbabf50b2a5c6f0bb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柚原みう","creatorId":"vndb:s977","sourcePersonId":"vndb:s977","canonicalEntityId":"vndb:s977","name":"柚原 みう","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:105787:26232:15162:1","source":"bangumi"}]},{"characterId":"char_c21737","characterName":"岩出山 篤史","sourceIds":{"bangumi":[{"characterId":"26229","match":"exact-normalized-name-in-linked-work","subjectId":"105787"}],"egsCharacterIds":["4060"],"vndbCharacterId":"c21737"},"originalCharacterName":"岩出山 篤史","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Miki's brother and owner of the curry shop that the protagonist frequents. It is not known if its because of her sister constantly taking care of him, but he has a severe case of siscon. In order to raise her important sister, he works likes a madman. Openly declares that if there is any bastard out there that dares to get close to his sister, he will throw them into the pot and boil them alive."}],"source":"vndb","sourceCharacterId":"c21737"},{"segments":[{"spoiler":false,"text":"未喜の兄。"},{"spoiler":false,"text":"陸がよく通うカレーショップ『匙』の経営者。"},{"spoiler":false,"text":"妹の親代わりだったためか、重度のシスコン。"},{"spoiler":false,"text":"何より大事な妹を育てるため、仕事一辺倒で生きてきた。"},{"spoiler":false,"text":"万が一妹に近づく野郎がいるものなら、拷問にかけたうえで鍋に入れて煮込むと公言してはばからない。"}],"source":"egs","sourceCharacterId":"4060","sourceWorkId":"20536","spoiler":false},{"segments":[{"spoiler":false,"text":"未喜の兄。 陸がよく通うカレーショップ 『匙』 の経営者。"},{"spoiler":false,"text":"妹の親代わりだったためか、重度のシスコン。"},{"spoiler":false,"text":"何より大事な妹を育てるため、仕事一辺倒で生きてきた。"},{"spoiler":false,"text":"万が一妹に近づく野郎がいるものなら、拷問にかけたうえで鍋に入れて煮込むと公言してはばからない。"},{"spoiler":false,"text":"「陸もあるみたいだね。 シスコンの素質。」"}],"source":"bangumi","sourceCharacterId":"26229"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7740d13ec022afb8d173183903381715608b2f74ff77a965ca4fa766c686b03.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab0fcc28f2f21d0d891baab1430469962e5f3d744eae45d14b3a3a1130f78d78.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水野 咲","creatorId":"vndb:s10223","sourcePersonId":"vndb:s10223","canonicalEntityId":"vndb:s10223","name":"水野 咲","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:58928","source":"vndb"}]},{"characterId":"char_c21738","characterName":"大崎 陸","sourceIds":{"bangumi":[],"egsCharacterIds":["4059"],"vndbCharacterId":"c21738"},"originalCharacterName":"大崎 陸","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist. He has a clock that lets him travel back in time given to him by Ren. Since 5 years ago, he became a regular time traveler. He has a strong sense of responsibility with a firm will. His purpose for time traveling is to change the future that cannot be changed. Traveling back in time, he helps a variety of people, and has interacted with meddlesome people. In order to earn money for his travels, he works part time at a lot of places. People often misinterpret him as a NEET, but he in fact has a job."}],"source":"vndb","sourceCharacterId":"c21738"},{"segments":[{"spoiler":false,"text":"時間を巻き戻すことのできる『時計』を片手に、５年前から各地を渡り歩いている旅人。"},{"spoiler":false,"text":"ちょっとやそっとでは変わらない意志の強さと、責任感を併せ持つ。"},{"spoiler":false,"text":"旅の目的は「変わらない」はずの未来を変えること。"},{"spoiler":false,"text":"時間の巻き戻しによる“人助け”を行なっており、少々おせっかい気味に、出会った人たちと関わろうとする。"},{"spoiler":false,"text":"旅の資金稼ぎのため、主に日雇いアルバイトで生活。"},{"spoiler":false,"text":"よく勘違いされるが、ちゃんと働いているのでニートではない。"}],"source":"egs","sourceCharacterId":"4059","sourceWorkId":"20536","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a8786a14337c2459fde9281fba4606800d9912eb97b75253f15658e52939c22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/115e69097a4ce261ea7e299da131a544178a0a02ae73cb45e005b24d4ac3903c.webp","width":256,"height":245,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c106379","characterName":"白石 奈月","sourceIds":{"vndbCharacterId":"c106379"},"originalCharacterName":"白石 奈月","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58ffad3f70c0dcdd3bc1d923e7f7b8da4b6794fa4eac80d73fe4e533653db34f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb59544f97a7cbc5ed89c6a045b872cea5d859a0380615993cbe88882747e0d2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"御子神 猫","creatorId":"vndb:s27","sourcePersonId":"vndb:s27","canonicalEntityId":"vndb:s27","name":"大咲 茉菜","roleCode":"voice-actor","roleLabel":"声优","identitySt