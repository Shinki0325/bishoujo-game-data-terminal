,"sourceWorkId":"2118","spoiler":false},{"segments":[{"spoiler":false,"text":"坂口付きの看護婦。シリーズを通して人気のヒロイン。"},{"spoiler":false,"text":"坂口に弱みを握られ、今では肉奴隷状態に。"},{"spoiler":false,"text":"しかし意思の強い女性で、完全には隷属していない。"},{"spoiler":false,"text":"どちらかというと、強い坂口に寄りかかっている感じ。"}],"source":"egs","sourceCharacterId":"22725","sourceWorkId":"2702","spoiler":false},{"segments":[{"spoiler":false,"text":"シリーズを通して登場している坂口付きの看護婦。"},{"spoiler":false,"text":"坂口に弱みを握られ脅されて言いなりになっているが、"},{"spoiler":false,"text":"自分の意思だけはしっかり持っていて坂口に対して隷属していない。"},{"spoiler":false,"text":"ただ自分の全てを知る相手として坂口を精神的な拠り所にしている節がある。"}],"source":"bangumi","sourceCharacterId":"146922"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"22725","sourceWorkId":"2118","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"22725","sourceWorkId":"2118","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"22725","sourceWorkId":"2118","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"22725","sourceWorkId":"2118","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7a619f6672c76cf9fab17f5a2a4016e2360407c7a8245e6334f21464ea2b352.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/4407488b463fb50931c4782c80ee4fcd593e0c0d76e964d97a19fcf57ce12b7f.webp","width":166,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高野直子","creatorId":"vndb:s14","sourcePersonId":"vndb:s14","canonicalEntityId":"vndb:s14","name":"高野 直子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:306657:146922:4031:1","source":"bangumi"}]},{"characterId":"char_c28684","characterNam