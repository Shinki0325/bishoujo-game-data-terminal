ource-native","relationId":"vndb:vn-staff:5863","source":"vndb"},{"creditedName":"橋本 みゆき","creatorId":"vndb:s390","sourcePersonId":"vndb:s390","canonicalEntityId":"vndb:s390","name":"橋本 みゆき","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:5864","source":"vndb"},{"creditedName":"有里亜","creatorId":"vndb:s983","sourcePersonId":"vndb:s983","canonicalEntityId":"vndb:s983","name":"有里亜","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:5865","source":"vndb"},{"creditedName":"あごバリア","creatorId":"vndb:s1130","sourcePersonId":"vndb:s1130","canonicalEntityId":"vndb:s1130","name":"あごバリア","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:5868","source":"vndb"},{"creditedName":"鈴平 ひろ","creatorId":"vndb:s1348","sourcePersonId":"vndb:s1348","canonicalEntityId":"vndb:s1348","name":"鈴平 ひろ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:5869","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c110449","characterName":"リコリス","sourceIds":{"vndbCharacterId":"c110449"},"originalCharacterName":"リコリス","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Lycoris, a clone distinctly crafted for Project Yggdrasil, stood out with her unique violet eyes, differing from Nerine. She had an encounter with Rin in the human world before the principal events of the story. Tragically, she met an untimely end. Upon her passing, Lycoris's memories were transferred to Nerine, bequeathing her not just a melodious singing voice but also her profound affection for Rin."},{"spoiler":false,"text":"Before her departure, Lycoris shared her tender tale about Rin with Primula, igniting the young girl's interest in him. Although not bound by blood, Primula held Lycoris close to her heart as a sister. In a gesture of affection, Lycoris passed on a treasured stuffed cat she had received from Rin to Primula."}],"source":"vndb","sourceCharacterId":"c110449"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffbcb169d0a4e32573c75e349e077b28593c612aee5ba1f0a369b0f441a4da9c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/464d0e8fd3960eef8bbcbb38be0956821d34ea6a0af308532f5ee64c56052621.webp","width":256,"height":205,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c21065","characterName":"フォーベシイ","sourceIds":{"vndbCharacterId":"c21065"},"originalCharacterName":"フォーベシイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"413"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Forbesii when he was still a prince of the Demon World 20 years prior."},{"spoiler":false,"text":"He keeps a small number of servants on hand since only a select few are invited into his mansion."},{"spoiler":false,"text":"According to correct history, he ties the knot with his maid, Sage. But now that Rin and his friends have arrived, the course of events can be rewritten based on their choices."}],"source":"vndb","sourceCharacterId":"c21065"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18259a5e22a35bd25bf2a241aa926833035f00faeb3ae247a5c2d04a788f5fa4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28b7f70e3fbc687bbee8d00c1ade91821ebc32f708cdbe7dc8eeb16565cbae83.webp","width":216,"height":256,"source":"static-detail"},"actors":[{"creditedName":"司馬嵯峨 之","creatorId":"vndb:s53","sourcePersonId":"vndb:s53","canonicalEntityId":"vndb:s53","name":"森川智之","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2135","source":"vndb"}]},{"characterId":"char_vndb_c4671","characterName":"土見 稟","sourceIds":{"vndbCharacterId":"c4671"},"originalCharacterName":"土見 稟","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rin, a student at the National Verbena Academy in class 2C, may not be the sharpest tool in the shed academically, but he certainly hits the ball out of the park on the athletic field. Tragically, a bolt from the blue struck eight years earlier when his parents perished in a car accident. In the aftermath, the Fuyou family generously took him under their wing."},{"spoiler":false,"text":"Then, on a red-letter day in June, his life took another turn. Both Lisianthus, the Divine Princess, and Nerine, the Demon Princess, made a splash by transferring to his school. Suddenly, Rin found himself between a rock and a hard place, seen as a potential spouse for both princesses. This twist positioned him as \"A man who can become a god, a demon, or an ordinary man.\" With the ball in his court, envy grew like wildfire among the male students who admired Fuyo Kaede, Lisianthus, and Nerine. Yet, Rin remained blissfully in the dark about his burgeoning popularity. Little did he know that clandestine photos of him were fetching prices worth their weight in gold on the black market."},{"spoiler":false,"text":"In contrast to this chaotic social scene, Rin's character shone brightly. He always went the extra mile for others, placing their needs above his own. He'd jump through hoops to support those around him and despised showing his cards by appearing vulnerable."},{"spoiler":false,"text":"However, at home, it was a different ball game. Rin was like a fish out of water regarding domestic tasks. Here, Kaede pulled the strings, managing chores and often playing the role of the early bird, waking up the ever-tardy Rin."},{"spoiler":false,"text":"\"I'm confident that no one can beat my endurance.\""}],"source":"vndb","sourceCharacterId":"c4671"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92db059bd0d71fd73035b1b4c980d68f807e182a345cbc4ecb071a06a8405f36.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a83c100be8df9378d574da7f4c9ed89c9915b327d3d9f7289d7a17f2d760b54a.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c4673","characterName":"ネリネ","sourceIds":{"vndbCharacterId":"c4673"},"originalCharacterName":"ネリネ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1013"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"source-only","source":"vndb","value":"154"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rin, for short, is the only daughter of the King of the Devils. Like Lisianthus, the memories of her childhood with Rin have brought her to the Human world. She is proper, modest, and reserved, but she won't hesitate to release her offensive magic when someone makes a fool out of Rin. She also possesses a beautiful voice, dubbed \"Angel's Bell,\" but she dislikes singing."},{"spoiler":true,"text":"In her route's sequel, Tick Tack!, Nerine can be potentially subjected to changes in personality, physical features, and memory due to Rin's interference in the past era before her birth."},{"spoiler":false,"text":"from MangaGamer"}],"source":"vndb","sourceCharacterId":"c4673"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/086fd3538c1ade67cdb39a74a96b415298fc5ebf81e8b22adfe8884cc398d5fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f4109b9c76cb10577a9ff06e4ed7cd56a81a4c8ce514a4b3a98c77b67d82f53.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松永 雪希","creatorId":"vndb:s452","sourcePersonId":"vndb:s452","canonicalEntityId":"vndb:s452","name":"永見 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2136","source":"vndb"}]},{"characterId":"char_vndb_c4678","characterName":"麻弓＝タイム","sourceIds":{"vndbCharacterId":"c4678"},"originalCharacterName":"麻弓＝タイム","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"101"},"bust":{"reviewState":"source-only","source":"vndb","value":"77"},"height":{"reviewState":"source-only","source":"vndb","value":"167"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mayumi is a human-devil hybrid who is Kaede and Rin’s classmate."},{"spoiler":false,"text":"A curious person and rushes into anything and often becomes a troublemaker. She always carried a digital camera around to satisfy her curiosity."},{"spoiler":false,"text":"She is a pretty and stylish girl; however, she has an inferiority complex related to her chests that are even smaller than Primula's."},{"spoiler":false,"text":"Her grades are so low that she joins supplementary classes regularly, but she is quite knowledgeable about trivial matters. Mayumi is also a skilled negotiator."}],"source":"vndb","sourceCharacterId":"c4678"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5ac9ed55c5876d078eb8d9ce416a0cdd6d4b1869a9b7fd69f1d5a2addb28499e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70814859acf89e7921add6ccecca8fa815392895f095dd7fac9890232cee239d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"香取 那須巳","creatorId":"vndb:s126","sourcePersonId":"vndb:s126","canonicalEntityId":"vndb:s126","name":"井上 美紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2132","source":"vndb"}]},{"characterId":"char_vndb_c4681","characterName":"フォーベシイ","sourceIds":{"vndbCharacterId":"c4681"},"originalCharacterName":"フォーベシイ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"413"},"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nerine's father and the lord of the realm of the devils. He is lecherous and thus quickly gets along with Itsuki at the beginning of the game. Like the King of Gods, he too has a habit of embarrassing his daughter, which usually leads to Nerine addressing him as \"King of Devils\" instead of \"Father\" as punishment."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4681"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd060c6f18635a7d1f878603679e1a35f39154c9c3eb4998c727f0011c90bc18.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a22b61f62a24c9ae0b475df9dbe090b422e1db53d38c88eaf2ecc4a987810a6b.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c4685","characterName":"緑葉 樹","sourceIds":{"vndbCharacterId":"c4685"},"originalCharacterName":"緑葉 樹","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"314"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Itsuki Midoriba is Rin's \"bad\" friend and classmate. Being the womanizer of the class, he is envious of the girls' attraction to Rin and often mentions that he will look after the girls Rin does not pick."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4685"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09a06244c6253cf5ec3d971b639bc09bb7409e33f5cf14019a899f2f179188f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/969c0671e8a88b2ff31cbd16337699e654a739c8519f513e5aa1214f8ee441ff.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小池 竹蔵","creatorId":"vndb:s749","sourcePersonId":"vndb:s749","canonicalEntityId":"vndb:s749","name":"荻原 秀樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2137","source":"vndb"}]},{"characterId":"char_vndb_c4688","characterName":"セージ","sourceIds":{"vndbCharacterId":"c4688"},"originalCharacterName":"セージ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1218"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"75"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sage is Forbesii's maid. In the standard timeline, she marries him and is Nerine's mother."},{"spoiler":false,"text":"Sage is very energetic and cheerful in almost all circumstances. She is an excellent housemaker and good at hiding her feeling, especially towards Forbesii, to whom her whole heart is dedicated. However, since Forbesii is a prince and she is just his maid, Sage tries to provide services to Forbesii and devotes her life to it in the hope that she may not have to leave him when he ties the knot with his fiancee, Ai."},{"spoiler":true,"text":"In one possible timeline, Rin may decide to engage in sexual and romantic relations with Sage, thus changing the future mother of Nerine. Rin will be forced to reject Sage when she asks him who he would choose as a partner - Nerine or Sage. Sage will then admit she will later cry over the fact Rin is leaving her behind. A red-haired Nerine will replace the original blue-haired one if Rin chooses this path."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4688"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/5692a89d2baaacbc5fa478046b845661e34c87623108ddb79ff56d56fdc26842.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23a5f95fb5a867eded42df09f368ce3f00f7dda76d2358ad830f77995861d37b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青山 ゆかり","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2133","source":"vndb"}]},{"characterId":"char_vndb_c4689","characterName":"アイ","sourceIds":{"vndbCharacterId":"c4689"},"originalCharacterName":"アイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"912"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"F"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ai is the daughter of a noble family from the Demon World. She is well-educated, graceful, and gentle and has always been seen smiling sweetly. Her speech, thoughts, and actions can be considered 'Big-Sisterly'. She often refers to herself as \"Ai-Onee San\" to Rin."},{"spoiler":false,"text":"She was Forbesii's first fiancée. Although their parents decided on her engagement to Forbesii, Ai herself seems to love him genuinely. In the main timeline, however, they break their engagement, and Forbesii marries Sage instead."},{"spoiler":true,"text":"If the player decides to restore the original timeline, then Ai will be a potential heroine. The latter can be romanced with Rin in addition to having Nerine in the epilogue. In the epilogue of her route, she becomes Rin's second simultaneous lover after waiting for 20 years and reuniting with Rin in the human world."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4689"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68c5a6138420fbf5251d500b1932c8fda9fd63559338e11ff0a5af616d27e8eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e525e57ecdc334dd3ac29eaca3652217fc0207559d665c42a2067ee97a4b38d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三村 祥子","creatorId":"vndb:s858","sourcePersonId":"vndb:s858","canonicalEntityId":"vndb:s858","name":"神田 理江","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:2138","source":"vndb"}]},{"characterId":"char_vndb_c4690","characterName":"サイネリア","sourceIds":{"vndbCharacterId":"c4690"},"originalCharacterName":"サイネリア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"214"},"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"height":{"reviewState":"source-only","source":"vndb","value":"169"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Cineraria is the younger sister of Forbesii, one of the wives of Eustoma, and the mother of Lisianthus. She carries around a chair to hit people like Lisianthus does."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4690"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/chara