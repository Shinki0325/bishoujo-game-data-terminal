"source-native","relationId":"vndb:vn-staff:177163","source":"vndb"},{"creditedName":"Local Bus","creatorId":"vndb:s24547","sourcePersonId":"vndb:s24547","canonicalEntityId":"vndb:s24547","name":"Local Bus","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:177164","source":"vndb"},{"creditedName":"荒井 正広","creatorId":"vndb:s24627","sourcePersonId":"vndb:s24627","canonicalEntityId":"vndb:s24627","name":"荒井 正広","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:177166","source":"vndb"},{"creditedName":"荒井 正広","creatorId":"vndb:s24627","sourcePersonId":"vndb:s24627","canonicalEntityId":"vndb:s24627","name":"荒井 正広","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:177167","source":"vndb"},{"creditedName":"風穴 尚紀","creatorId":"vndb:s24628","sourcePersonId":"vndb:s24628","canonicalEntityId":"vndb:s24628","name":"風穴 尚紀","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:177169","source":"vndb"},{"creditedName":"嘉手 苅睦","creatorId":"vndb:s48065","sourcePersonId":"vndb:s48065","canonicalEntityId":"vndb:s48065","name":"嘉手 苅睦","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:177170","source":"vndb"},{"creditedName":"嘉手 苅睦","creatorId":"vndb:s48065","sourcePersonId":"vndb:s48065","canonicalEntityId":"vndb:s48065","name":"嘉手 苅睦","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:177171","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c3786","characterName":"前原 圭一","sourceIds":{"vndbCharacterId":"c3786"},"originalCharacterName":"前原 圭一","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"birthday":{"reviewState":"source-only","source":"vndb","value":"413"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this story."},{"spoiler":false,"text":"He is temperamental and hot blooded, but at the same time he's also indecisive. He gets shy around girls easily... He is the sort of character you would find in the lead role of a love story."},{"spoiler":false,"text":"As a matter of course, he's not very honest about himself. And of course, he's also quite popular with the girls."},{"spoiler":false,"text":"Unfortunately this isn't a love story, so his personality won't do him much good. Quite the opposite, in fact..."},{"spoiler":true,"text":"At his old school, Keiichi grew bored of getting good grades and bought a BB gun, entertaining himself by shooting at younger kids as they were walking home. His parents determined that they were also at fault for not realizing Keiichi's unhappiness and struggles, and so they moved to Hinamizawa to help Keiichi get a fresh start."},{"spoiler":false,"text":"From Keiichi Maebara on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3786"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa20bc09c71f234538acb5c5a42e6ba5204107d2b1e1c601eeda51ba937523fe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/85a22143c63022a1d43fc52afafd857e20118bb47e66c70cba032d5a799bb282.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"保志 総一朗","creatorId":"vndb:s114","sourcePersonId":"vndb:s114","canonicalEntityId":"vndb:s114","name":"保志 総一朗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89068","source":"vndb"}]},{"characterId":"char_vndb_c3787","characterName":"竜宮 レナ","sourceIds":{"vndbCharacterId":"c3787"},"originalCharacterName":"竜宮 レナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"13"},"birthday":{"reviewState":"source-only","source":"vndb","value":"728"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rena is a classmate of Keiichi's. She is quite interested in his everyday life, possibly because of an inherent urge to look after people."},{"spoiler":false,"text":"She comes with the standard-issue honesty, earnesty and blushes that you find in many heroines."},{"spoiler":false,"text":"However, her only reward for taking care of Keiichi is an incessant series of pranks. It really is unfortunate for her."},{"spoiler":false,"text":"She likes anything and everything she considers adorable, and this is also a very typical trait in a heroine."},{"spoiler":false,"text":"But that is also her greatest weakness..."},{"spoiler":true,"text":"Rena originally called herself Ryuuguu Reina, being born and raised in Hinamizawa. Her family moved to Ibaraki for her mother's work. After her parents divorced, Reina's mental state deteriorated to the point where in 1982 she went on a rampage destroying windows in her school and attacked three students, permanently blinding one of them in one eye. She claimed to hear Oyashiro-sama telling her to return to Hinamizawa, believing she was cursed for leaving the village in the first place."},{"spoiler":false,"text":"Edited from Rena Ryuugu on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3787"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf35df8acbb7c44d3ee9c1cb85f85aa8c8d0645c291074fdebd1388be0db569c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bfc60f301111244e680dcc6c3fe2ecdd82297e284fba78ca5c212d7944ed6282.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中原 麻衣","creatorId":"vndb:s444","sourcePersonId":"vndb:s444","canonicalEntityId":"vndb:s444","name":"中原 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89069","source":"vndb"}]},{"characterId":"char_vndb_c3788","characterName":"園崎 魅音","sourceIds":{"vndbCharacterId":"c3788"},"originalCharacterName":"園崎 魅音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"birthday":{"reviewState":"source-only","source":"vndb","value":"710"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mion is one grade higher than Keiichi. She is the class representative."},{"spoiler":false,"text":"She is the active class representative type, which is the second most common type."},{"spoiler":false,"text":"She is a leader, someone who makes friends with everyone, regardless of gender or age."},{"spoiler":false,"text":"Because of her high-strung, easy-going, hyperactive personality, those around her never have to be bored. She is about the best kind of friend anyone could wish for."},{"spoiler":false,"text":"Her personality is somewhat marred by a tendency to sound like an old man, but that's something to be forgiven."},{"spoiler":false,"text":"Mion likes games of all kinds, be they card games, board games or video games. Because of who she is, her games tend to be high-tension. It's to be expected."},{"spoiler":false,"text":"She plays with her friends in the context of club activity."},{"spoiler":true,"text":"Mion was born under the name \"Sonozaki Shion\", but had swapped places with her twin sister on the day that the heir to the family head was to be given the demon tattoo, and as such permanently assumed the role of \"Sonozaki Mion\". She denies knowing about the tattoo arrangement beforehand."},{"spoiler":false,"text":"Edited from Mion Sonozaki on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3788"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a84dd566cafb3ca9dc70dfa69196f71e7cb2ae21341d50801f9dd200753e69c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd15e73b7f679668810252bb1d950b8b1c272e4d5c960a02664c3d4f21226b81.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雪野 五月","creatorId":"vndb:s474","sourcePersonId":"vndb:s474","canonicalEntityId":"vndb:s474","name":"ゆきの さつき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89070","source":"vndb"}]},{"characterId":"char_vndb_c3789","characterName":"北条 沙都子","sourceIds":{"vndbCharacterId":"c3789"},"originalCharacterName":"北条 沙都子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"11"},"birthday":{"reviewState":"source-only","source":"vndb","value":"624"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl one grade lower than Keiichi."},{"spoiler":false,"text":"She is usually very polite, but because she is still young she sometimes has difficulty with grammar."},{"spoiler":false,"text":"However, behind her innocent exterior lies a personality that loves setting traps for other people. You could call her a trickster. She tries her utmost to snare Keiichi, but she has only limited success."},{"spoiler":false,"text":"Although the result of failure is easily imaginable, Satoko doesn't like to lose, and she doesn't learn from experience. That is why she keeps confronting him, with all due consequences."},{"spoiler":false,"text":"Even when she realizes her skills are insufficient, her smile never wavers."},{"spoiler":true,"text":"In 1980, Satoko developed terminal symptoms of Hinamizawa Syndrome, stemming from her dislike of her parents. When they went to the observation platform at the park, Satoko pushed her parents off and killed them. Satoko had no memory of the event."},{"spoiler":false,"text":"Edited from Satoko Houjou on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3789"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/8020e1e80789b11916467bb8eaa84bdec3ea7e1faa3357ad9ba3b0c8226f22fe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1dc7121051d5703908f30bd90322ae97656a9d40f8c55f7b25ed6518ca3db040.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"かない みか","creatorId":"vndb:s1818","sourcePersonId":"vndb:s1818","canonicalEntityId":"vndb:s1818","name":"かない みか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89075","source":"vndb"}]},{"characterId":"char_vndb_c3790","characterName":"古手 梨花","sourceIds":{"vndbCharacterId":"c3790"},"originalCharacterName":"古手 梨花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"11"},"birthday":{"reviewState":"source-only","source":"vndb","value":"821"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rika is a grade lower than Keiichi, and thus is a classmate of Satoko's."},{"spoiler":false,"text":"She is very quiet and reserved for her age, which makes her almost the polar opposite of Satoko. However, the two of them can often be found in each other's company."},{"spoiler":false,"text":"Whenever Satoko is in tears after losing against Keiichi, it is Rika who cheers her up. When Satoko wins, Rika comforts Keiichi instead. When Keiichi teases Rena, Rika comforts her."},{"spoiler":false,"text":"In fact, Rika comforts whomever is in need of comfort."},{"spoiler":false,"text":"She seems happy with it."},{"spoiler":true,"text":"When by herself or with Hanyuu, Rika completely drops her cutesy and child-like personality and displays a much more cynical, mature, apathetic, serious and occasionally hostile personality, developed as a result of her 100 years of traveling through the Sea of Fragments."},{"spoiler":false,"text":"From Rika Furude on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3790"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5a7406a56252303677b71dd3e1a7b48268cb50cd7d95b24312492b43982de3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/9140e480b0ef1fc04ab136a643fe3edf39b041dcefcd2dcb3471fbbb22e5b4e3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田村 ゆかり","creatorId":"vndb:s104","sourcePersonId":"vndb:s104","canonicalEntityId":"vndb:s104","name":"田村 ゆかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89067","source":"vndb"}]},{"characterId":"char_vndb_c3814","characterName":"園崎 詩音","sourceIds":{"vndbCharacterId":"c3814"},"originalCharacterName":"園崎 詩音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"birthday":{"reviewState":"source-only","source":"vndb","value":"710"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The twin sister of Sonozaki Mion."},{"spoiler":false,"text":"Like her older sister, she has a crafty personality and may be even more adept at worldly affairs than Mion."},{"spoiler":true,"text":"She has a soft spot for Satoshi and wanted to help him out, so she took the job of manager of the Hinamizawa Fighters."},{"spoiler":false,"text":"She usually lives in Okinomiya and doesn't go to and from the village often."},{"spoiler":true,"text":"Shion was actually born the older sister. On the day she was supposed to get her demon tattoo signifying her status as the family successor, the twins switched. Thus, the younger sister received the tattoo and was forced to become Mion while the older sister started to live as Shion."},{"spoiler":true,"text":"As the perceived younger twin, Shion was eventually sent to the boarding school St. Lucia, remaining there for years before getting tired of it and escaping with the help of Kasai Tatsuyoshi in 1982 to live in Okinomiya."},{"spoiler":false,"text":"Edited from Shion Sonozaki on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3814"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32832cbaa688fc0e9a1e1ed4ffffcae5110c8ec668f1a20864d0e7388e8a4364.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/1788d8aa14f74d4a2f3b68ea9f922e7d8293de945fd8085aa368f4ecb1619809.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雪野 五月","creatorId":"vndb:s474","sourcePersonId":"vndb:s474","canonicalEntityId":"vndb:s474","name":"ゆきの さつき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89071","source":"vndb"}]},{"characterId":"char_vndb_c3817","characterName":"古手 羽入","sourceIds":{"vndbCharacterId":"c3817"},"originalCharacterName":"古手 羽入","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"801"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Her favorite food is cream puffs and she doesn't like horns growing on her head. She was timid and easy to tease, and she was able to quickly get to know each other in the village and enjoy the long-awaited \"school\" life..."},{"spoiler":false,"text":"For her, this event was a big event that she had never expected."},{"spoiler":false,"text":"Hinamizawa is wrapped in a tragedy again."},{"spoiler":true,"text":"Hanyuu is Furude Rika's ancestor and the true form of Oyashiro-sama. With her powers, Rika is able to travel between Fragments every time she dies and experience different events in an attempt to escape fate."},{"spoiler":false,"text":"Edited from Hanyuu on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3817"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83b3359076ab82871dd98c60b6b68d054dd457e37d4b17a8aa12a20fc651f074.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88e61ad26b6cf0924050c01ac1ff1752b0ef11a6eb42d055b39caba9a8fbab95.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"堀江 由衣","creatorId":"vndb:s46","sourcePersonId":"vndb:s46","canonicalEntityId":"vndb:s46","name":"堀江 由衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89066","source":"vndb"}]},{"characterId":"char_vndb_c3826","characterName":"知恵 留美子","sourceIds":{"vndbCharacterId":"c3826"},"originalCharacterName":"知恵 留美子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"503"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a teacher at the Hinamizawa branch school."},{"spoiler":false,"text":"She is a student-focused teacher and is trusted not only by the children but also by the villagers."},{"spoiler":false,"text":"She is also unimaginably obsessed with curry and has a curry garden behind the school."},{"spoiler":false,"text":"From Rumiko Chie on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3826"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/0429350062125d8991f6fb8e1df19833f00991fa5faeae2c630f9e593b7534e8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb426618abd07b66118bce61b0963da64d6136b4e3a626b66be2cf71795b87e9.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"折笠 富美子","creatorId":"vndb:s1240","sourcePersonId":"vndb:s1240","canonicalEntityId":"vndb:s1240","name":"折笠 富美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89073","source":"vndb"}]},{"characterId":"char_vndb_c3829","characterName":"大石 蔵人","sourceIds":{"vndbCharacterId":"c3829"},"originalCharacterName":"大石 蔵人","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1115"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A veteran detective who is trying to uncover the truth behind the serial cases of mysterious deaths that occur every year in Hinamizawa. He's working hard to try to solve this case before he retires, but there are a lot of villagers who resent the fact that he's investigating this case."},{"spoiler":true,"text":"Residents who have been in contact with Ooishi have disappeared due to Oyashiro-sama's curse, so he's known as \"Oyashiro-sama's messenger\" and is feared..."},{"spoiler":false,"text":"From Kuraudo Ooishi on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3829"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb73fba54b9ac2e039be84869e9f32b1c5a405edd70de27401e20f7f2ef95b87.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c402ba1c6b5cbd0885e7ed46c1b2c029308d97b0e82ab32e56aa039b0a1b64f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茶風林","creatorId":"vndb:s1816","sourcePersonId":"vndb:s1816","canonicalEntityId":"vndb:s1816","name":"茶風林","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89074","source":"vndb"}]},{"characterId":"char_vndb_c3861","characterName":"鷹野 三四","sourceIds":{"vndbCharacterId":"c3861"},"originalCharacterName":"鷹野 三四","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"620"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A nurse at the Irie Clinic, loved by everyone in the village. She has a somewhat mysterious atmosphere and always has a meaningful smile. In occult mania, she seems to be very interested in the \"Oyashiro-sama\" faith in Hinamizawa."},{"spoiler":true,"text":"Takano Miyo was born Tanashi Miyoko and is the mastermind behind the Great Hinamizawa Disaster, involving the murder of Tomitake Jirou, Furude Rika, Irie Kyousuke, and later the entire village of Hinamizawa."},{"spoiler":false,"text":"Edited from Miyo Takano on 07th Expansion Wiki"}],"source":"vndb","sourceCharacterId":"c3861"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3eb3ce875509783f07883edbfc7bfb90a93b278431fda704c670981e399704d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b8a291a390c3cb622390b1073d959a823c64a147a8943f807b4e7e7643b69c9.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤 美紀","creatorId":"vndb:s886","sourcePersonId":"vndb:s886","canonicalEntityId":"vndb:s886","name":"伊藤 美紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:89072","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p367","sourceCompanyId":"egs:brand:1830","canonicalEntityId":"vndb:p367","name":"AQインタラクティブ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:12966:1830","source":"egs"},{"companyId":"vndb:p367","sourceCompanyId":"vndb:p367","canonicalEntityId":"vndb:p367","name":"AQインタラクティブ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:155368:v32082","source":"vndb"},{"companyId":"vndb:p367","sourceCompanyId":"vndb:p367","canonicalEntityId":"vndb:p367","name":"AQインタラクティブ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:92214:v32082","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavail