0","sourcePersonId":"vndb:s1690","canonicalEntityId":"vndb:s1690","name":"結月 そら","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:142950","source":"vndb"},{"creditedName":"なかむら さちよ","creatorId":"vndb:s14575","sourcePersonId":"vndb:s14575","canonicalEntityId":"vndb:s14575","name":"なかむら さちよ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:142956","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c84856","characterName":"鳴海 昴","sourceIds":{"vndbCharacterId":"c84856"},"originalCharacterName":"鳴海 昴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"503"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of your childhood friends. High school senior."},{"spoiler":false,"text":"He lives with his grandparents and looks after his twin brother and sister. He’s usually calm and gentle, but sometimes he makes scathing comments and is scary when angered. Loves games and spends all his time playing them when he’s alone."},{"spoiler":false,"text":"‘Don’t worry. We’ll always be together from now on.’"},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c84856"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/4150f3a67c32c291707d0be9b7ecf1b81a694bda0476c661da0fda931b575bf7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7f6909a09c4e913d40edd7a5936719215245d5d96741c646be37f86cf295366.webp","width":254,"height":254,"source":"static-detail"},"actors":[{"creditedName":"寺島 惇太","creatorId":"vndb:s11126","sourcePersonId":"vndb:s11126","canonicalEntityId":"vndb:s11126","name":"寺島 惇太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:75206","source":"vndb"}]},{"characterId":"char_vndb_c84857","characterName":"恒上 波智","sourceIds":{"vndbCharacterId":"c84857"},"originalCharacterName":"恒上 波智","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"728"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of your childhood friends. High school senior."},{"spoiler":false,"text":"He has grown up with you and Subaru since he was a child and both of you are like older siblings to him. He’s often seen as free-spirited and self-centred, but he treats everyone equally and has many friends. Good at sports and a member of the high school football club as well as the photography club."},{"spoiler":false,"text":"‘There’s nothing for you to worry about. You have me right here, after all.’"},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c84857"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/545f3fb0a921966506f7434a1d098803758ce919e90bcd3f21c3cf6093a38f95.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b61b22da536ea32191aaa6e92e68f88edd93a9788b7fb6f2e8fcb0e4760950a5.webp","width":254,"height":254,"source":"static-detail"},"actors":[{"creditedName":"濱 健人","creatorId":"vndb:s16123","sourcePersonId":"vndb:s16123","canonicalEntityId":"vndb:s16123","name":"濱 健人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:75208","source":"vndb"}]},{"characterId":"char_vndb_c84858","characterName":"天地 理音","sourceIds":{"vndbCharacterId":"c84858"},"originalCharacterName":"天地 理音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"414"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Transfer student. High school senior."},{"spoiler":false,"text":"He used to be in the showbiz industry, but came to Hoshinami Island for some reason. He is whimsy but straightforward as he always says whatever he thinks out loud. Because of this, he is easily misunderstood and disliked, but he doesn’t mind at all. A typical city boy as he isn’t fond of insects or fish. He’s a good singer and was once recruited as a vocalist for a band."},{"spoiler":false,"text":"‘You’re planning on dying without ever seeing the outside world?’"},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c84858"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd34dd1b55995cb43f85332f087ce346fcb05920853b3e50e8527090eb249f02.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27849c27d5ef492f524aa62236cb25ea68971bd7db95726a748dd56880d9f1d4.webp","width":254,"height":254,"source":"static-detail"},"actors":[{"creditedName":"土岐 隼一","creatorId":"vndb:s12701","sourcePersonId":"vndb:s12701","canonicalEntityId":"vndb:s12701","name":"土岐隼一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:75207","source":"vndb"}]},{"characterId":"char_vndb_c84859","characterName":"宇良 星真","sourceIds":{"vndbCharacterId":"c84859"},"originalCharacterName":"宇良 星真","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"117"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A high school student who’s a year younger than you. High school sophomore."},{"spoiler":false,"text":"Moved from the mainland when he was in middle school due to his parents’ divorce. He’s taciturn and his facial expressions are not that expressive. Used to take photographs, but stopped doing so for one reason or another. Although he rarely goes to school, he shows up every day to the photography club that you, Subaru and Nachi created."},{"spoiler":false,"text":"‘...This photography club just serves me as another time-killer.’"},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c84859"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/857812807eed8b007be461526a1acec8bcbead521045c5cd30d1b81f766b7ea6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf8ceed8cb7b497489ccf5ca72288666b79ad56a20a94ad6f2e2096eee4d0d29.webp","width":254,"height":254,"source":"static-detail"},"actors":[{"creditedName":"岡本 信彦","creatorId":"vndb:s550","sourcePersonId":"vndb:s550","canonicalEntityId":"vndb:s550","name":"岡本信彦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:75205","source":"vndb"}]},{"characterId":"char_vndb_c84860","characterName":"神流 夕月","sourceIds":{"vndbCharacterId":"c84860"},"originalCharacterName":"神流 夕月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"birthday":{"reviewState":"source-only","source":"vndb","value":"308"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He’s the advisor of the ‘photography club’, a club created by you and your friends."},{"spoiler":false,"text":"He left the island to fulfil his dream of becoming a teacher, but suddenly returned with a cat, Kanna. He’s like an older brother to you and your 2 childhood friends, and your first love. He used to laugh a lot, but now he hardly ever smiles and his personality has changed so much that he’s like a totally different person."},{"spoiler":false,"text":"‘When I take a good look at this island, it’s like time’s frozen and nothing has changed.’"},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c84860"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff8e080058b8b5326674f8c7d46dd204a1c41de1c00b5eaf33b350e903a2f6a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc865a625ec9967c3fa5732a2211c671b4069eb6294da44f3b7f3f988054d66c.webp","width":254,"height":254,"source":"static-detail"},"actors":[{"creditedName":"梶 裕貴","creatorId":"vndb:s84","sourcePersonId":"vndb:s84","canonicalEntityId":"vndb:s84","name":"梶 裕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:75204","source":"vndb"}]},{"characterId":"char_vndb_c84861","characterName":"美潮 星海","sourceIds":{"vndbCharacterId":"c84861"},"originalCharacterName":"美潮 星海","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"se