atorId":"vndb:s14287","sourcePersonId":"vndb:s14287","canonicalEntityId":"vndb:s14287","name":"ひっさつくん","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:154962","source":"vndb"},{"creditedName":"ひっさつくん","creatorId":"vndb:s14287","sourcePersonId":"vndb:s14287","canonicalEntityId":"vndb:s14287","name":"ひっさつくん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:154964","source":"vndb"},{"creditedName":"合資会社ワムソフト","creatorId":"vndb:s15832","sourcePersonId":"vndb:s15832","canonicalEntityId":"vndb:s15832","name":"WAMSOFT(合資会社ワムソフト)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:154965","source":"vndb"},{"creditedName":"U.Yakimiso","creatorId":"vndb:s43312","sourcePersonId":"vndb:s43312","canonicalEntityId":"vndb:s43312","name":"U.Yakimiso","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:154968","source":"vndb"}]},"cast":[{"characterId":"char_c93620","characterName":"御桶代 紫都香","sourceIds":{"bangumi":[{"characterId":"86496","match":"exact-normalized-name-in-linked-work","subjectId":"270534"}],"egsCharacterIds":["23104"],"vndbCharacterId":"c93620"},"originalCharacterName":"御桶代 紫都香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student at Tatesuga Academy and captain of the archery club. She is the daughter of the family that runs Western Kanou Shrine and is the protagonist's childhood friend. Her grades are top of the class, and her outgoing personality lends itself to strong leadership."},{"spoiler":false,"text":"From NookGaming"}],"source":"vndb","sourceCharacterId":"c93620"},{"segments":[{"spoiler":false,"text":"盾須賀学園２年生。弓道部主将。"},{"spoiler":false,"text":"西叶納神社の娘で、主人公の幼馴染。"},{"spoiler":false,"text":"学業成績はトップクラス、活発な性格で強いリーダーシップも発揮する。"},{"spoiler":false,"text":"その性格から同級生だけでなく上級生、下級生からも一目置かれる存在。"},{"spoiler":false,"text":"又、男子からも人気がある。"},{"spoiler":false,"text":"楼子とは親友同士。"}],"source":"egs","sourceCharacterId":"23104","sourceWorkId":"27615","spoiler":false},{"segments":[{"spoiler":false,"text":"盾须贺学园2年级。弓道部主将。"},{"spoiler":false,"text":"出身于西叶纳神社，与主人公青梅竹马。"},{"spoiler":false,"text":"学习成绩优异，也因为开朗的性格而具有很强的领导力。"},{"spoiler":false,"text":"因为她的性格，不只是同年级的学生，高年级的前辈和低年级的后辈也都对她另眼相看。"},{"spoiler":false,"text":"另外，她在男生之中也很有人气。"},{"spoiler":false,"text":"和楼子是非常要好的朋友。"}],"source":"bangumi","sourceCharacterId":"86496"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9354c0edb17b70b68d0bd3f457384ffc1d1692606c6c797f114d13aa82d8394.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb3ea56b813ddce7f51fb21142546169aa940a58efbff7a0d87c82aa4db9c242.webp","width":200,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山岡ゆり","creatorId":"vndb:s11656","sourcePersonId":"vndb:s11656","canonicalEntityId":"vndb:s11656","name":"山岡 ゆり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:270534:86496:5645:1","source":"bangumi"}]},{"characterId":"char_c93621","characterName":"叶納 楼子","sourceIds":{"bangumi":[{"characterId":"86497","match":"exact-normalized-name-in-linked-work","subjectId":"270534"}],"egsCharacterIds":["23105"],"vndbCharacterId":"c93621"},"originalCharacterName":"叶納 楼子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year student at Tatesuga Academy. She's the class representative, and head of the history research club. Her specialty is Japanese history, with a particular focus in the Heian period. She is secretly popular among the boys and is best friends with Shizuka."},{"spoiler":false,"text":"From NookGaming"},{"spoiler":false,"text":"She was adopted by Yoshitsune's parents,"},{"spoiler":true,"text":"after being orphaned at young age. Her original surname is 宮簀(miyazu)"}],"source":"vndb","sourceCharacterId":"c93621"},{"segments":[{"spoiler":false,"text":"盾須賀学園２年生。クラス委員長、歴史研究部部長。"},{"spoiler":false,"text":"得意な歴史は日本史、平安時代が特に得意。"},{"spoiler":false,"text":"学業は紫都香に負けずとも劣らない。"},{"spoiler":false,"text":"紫都香のような強いリーダーシップを発揮するタイプではないが、親しまれやすい性格。"},{"spoiler":false,"text":"密かに男子から人気がある。"},{"spoiler":false,"text":"紫都香とは親友同士。"}],"source":"egs","sourceCharacterId":"23105","sourceWorkId":"27615","spoiler":false},{"segments":[{"spoiler":false,"text":"盾须贺学园2年级。班长、历史研究部部长。"},{"spoiler":false,"text":"特别擅长日本史，尤其是平安时代的部分。"},{"spoiler":false,"text":"学习成绩与紫都香不相上下。"},{"spoiler":false,"text":"并不是紫都香那样能够发挥强烈的领导力的类型，而具有容易让人感到亲近的性格。"},{"spoiler":false,"text":"暗地里博得了许多男生的爱慕。"},{"spoiler":false,"text":"与紫都香是非常要好的朋友。"}],"source":"bangumi","sourceCharacterId":"86497"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93151d78ef1eca24af701d7d6d2970fa9977748030e93f2a72f444e9141cce3c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9be0b71af1f34842cd3496fc4cef25df4f82923817293aff518d47be4c55d029.webp","width":165,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡本理絵","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:270534:86497:13368:1","source":"bangumi"}]},{"characterId":"char_c93799","characterName":"佐藤 忠信","sourceIds":{"bangumi":[{"characterId":"86909","match":"exact-normalized-name-in-linked-work","subjectId":"270534"}],"egsCharacterIds":["23109"],"vndbCharacterId":"c93799"},"originalCharacterName":"佐藤 忠信","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A warrior from the late Heian period. She is one of Yoshitsune's Four Heavenly Kings. She is brave and bold in nature, and a skilled archer. She is also deeply loyal, and does not hesitate to speak her mind even to those above her."},{"spoiler":false,"text":"From NookGaming"}],"source":"vndb","sourceCharacterId":"c93799"},{"segments":[{"spoiler":false,"text":"平安末期の武士。"},{"spoiler":false,"text":"義経の家臣であり、義経四天王の一人。"},{"spoiler":false,"text":"信夫佐藤氏は現在の福島県飯坂温泉で湯荘司と呼ばれ、温泉を管理して"},{"spoiler":false,"text":"いたと言われている。"},{"spoiler":false,"text":"佐藤継信は姉。"},{"spoiler":false,"text":"勇猛果敢な性格で弓の名手。"},{"spoiler":false,"text":"忠義に厚く、目上の人間に対しては滅多なことでは逆らわない。"}],"source":"egs","sourceCharacterId":"23109","sourceWorkId":"27615","spoiler":false},{"segments":[{"spoiler":false,"text":"平安末期の武士。"},{"spoiler":false,"text":"義経の家臣であり、義経四天王の一人。"},{"spoiler":false,"text":"信夫佐藤氏は現在の福島県飯坂温泉で湯荘司と呼ばれ、温泉を管理していたと言われている。"},{"spoiler":false,"text":"佐藤継信は姉。"},{"spoiler":false,"text":"勇猛果敢な性格で弓の名手。"},{"spoiler":false,"text":"忠義に厚く、目上の人間に対しては滅多なことでは逆らわない。"}],"source":"bangumi","sourceCharacterId":"86909"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/014a9748d1f711a46b9c57e4b344599f624ffcda3fa6020f127645cd37cb1ecc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b1bb4a59b69a13ad433696d6a51571059c9d4a54a3ef3fcf324f24c3c117fe1.webp","width":221,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長妻樹里","creatorId":"vndb:s1197","sourcePersonId":"vndb:s1197","canonicalEntityId":"vndb:s1197","name":"長妻 樹里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:270534:86909:8493:1","source":"bangumi"}]},{"characterId":"char_c93800","characterName":"佐藤 継信","sourceIds":{"bangumi":[{"characterId":"86908","match":"exact-normalized-name-in-linked-work","subjectId":"270534"}],"egsCharacterIds":["23108"],"vndbCharacterId":"c93800"},"originalCharacterName":"佐藤 継信","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A warrior from the late Heian period. She is one of Yoshitsune's Four Heavenly Kings. She has an earnest and straightforward personality, she's perhaps even a little too serious at times. She is not only skilled in martial arts, but is also well-read in various texts, which is remarkable for the Heian period when literacy rates were extremely low."},{"spoiler":false,"text":"From NookGaming"}],"source":"vndb","sourceCharacterId":"c93800"},{"segments":[{"spoiler":false,"text":"平安末期の武士。"},{"spoiler":false,"text":"義経の家臣であり、義経四天王の一人。"},{"spoiler":false,"text":"信夫佐藤氏は長らく奥州藤原氏に仕えている豪族。"},{"spoiler":false,"text":"真面目で実直な性格。少し真面目すぎるきらいがあるほど。"},{"spoiler":false,"text":"武芸だけではなく、識字率が著しく低い平安時代において"},{"spoiler":false,"text":"様々な書物にも目を通している。"},{"spoiler":false,"text":"佐藤忠信は妹。"}],"source":"egs","sourceCharacterId":"23108","sourceWorkId":"27615","spoiler":false},{"segments":[{"spoiler":false,"text":"平安末期の武士。"},{"spoiler":false,"text":"義経の家臣であり、義経四天王の一人。"},{"spoiler":false,"text":"信夫佐藤氏は長らく奥州藤原氏に仕えている豪族。"},{"spoiler":false,"text":"真面目で実直な性格。少し真面目すぎるきらいがあるほど。"},{"spoiler":false,"text":"武芸だけではなく、識字率が著しく低い平安時代において様々な書物にも目を通している。"},{"spoiler":false,"text":"佐藤忠信は妹。"}],"source":"bangumi","sourceCharacterId":"86908"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0f604c90cab0fce4e72144c664456954ad7873b03bc61187f4e5c530552e335.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a0e87dcc5bfa8470f3f05058f2a56f6fcc565ddc5f729122db8c61f8c190d52.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:270534:86908:4799:1","source":"bangumi"}]},{"characterId":"char_c93801","characterName":"伊勢 三郎","sourceIds":{"bangumi":[{"characterId":"86906","match":"exact-normalized-name-in-linked-work","subjectId":"270534"}],"egsCharacterIds":["23107"],"vndbCharacterId":"c93801"},"originalCharacterName":"伊勢 三郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A warrior from the late Heian period. She is one of Yoshitsune's Four Heavenly Kings. Her father was a retainer of the Genji clan, but he passed away from illness along with her mother. She is naturally gentle, the type who wouldn't hurt a fly, but when she puts on her mask, her personality shifts and she becomes bold and aggressive."},{"spoiler":false,"text":"From NookGaming"}],"source":"vndb","sourceCharacterId":"c93801"},{"segments":[{"spoiler":false,"text":"平安末期の武士。"},{"spoiler":false,"text":"義経の郎党であり、義経四天王の一人。"},{"spoiler":false,"text":"父親は源氏の郎党だったが、母親とともに病で亡くなった。"},{"spoiler":false,"text":"それ以来、盗賊になって生き抜いていてる。"},{"spoiler":false,"text":"本来は虫も殺せない優しい性格だが、マスクをすると強気な性格になる。"},{"spoiler":false,"text":"狩りが得意。又、忍者の始祖とも言われているほど、身のこなしが軽い。"}],"source":"egs","sourceCharacterId":"23107","sourceWorkId":"27615","spoiler":false},{"segments":[{"spoiler":false,"text":"平安末期の武士。"},{"spoiler":false,"text":"義経の郎党であり、義経四天王の一人。"},{"spoiler":false,"text":"父親は源氏の郎党だったが、母親とともに病で亡くなった．"},{"spoiler":false,"text":"それ以来、盗賊になって生き抜いていてる。"},{"spoiler":false,"text":"本来は虫も殺せない優しい性格だが、マスクをすると強気な性格になる。"},{"spoiler":false,"text":"狩りが得意。又、忍者の始祖とも言われているほど、"},{"spoiler":false,"text":"身のこなしが軽い。"}],"source":"bangumi","sourceCharacterId":"86906"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/251c83d8fd277135949617c9ee671780c3ca9a9e8c99ac8002538b4ae9ed7dac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0ec1e48a97b097ab198c21bc894b2017a32dff501575d8ae71d5ac7acda323f7.webp","width":229,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:270534:86906:8580:1","source":"bangumi"}]},{"characterId":"char_c93802","characterName":"武蔵坊 弁慶","sourceIds":{"bangumi":[{"characterId":"86905","match":"exact-normalized-name-in-linked-work","subjectId":"270534"}],"egsCharacterIds":["23106"],"vndbCharacterId":"c93802"},"originalCharacterName":"武蔵坊 弁慶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A warrior monk from the late Heian period. She is one of Yoshitsune's Four Heavenly Kings. She trained at Mount Hiei, but was expelled due to her violent temperament. She devised a plan to steal a total of 1000 swords in Kyoto. What's more, she stole not from weak, ordinary people, but specifically from warriors of the Taira clan, and has succeeded in collecting 999."},{"spoiler":false,"text":"From NookGaming"}],"source":"vndb","sourceCharacterId":"c93802"},{"segments":[{"spoiler":false,"text":"平安末期の僧兵。"},{"spoiler":false,"text":"義経の郎党であり、義経四天王の一人。"},{"spoiler":false,"text":"比叡山で修業を積むも、乱暴な性格から比叡山を追い出されてしまう。"},{"spoiler":false,"text":"その後、ある理由から京都で太刀を奪う計画を立てる。"},{"spoiler":false,"text":"その数、１０００本。"},{"spoiler":false,"text":"しかも、弱い人間からではなく主に平家の者から奪い、９９９本まで奪うことに成功した。"},{"spoiler":false,"text":"使う薙刀の名は『岩融』。"}],"source":"egs","sourceCharacterId":"23106","sourceWorkId":"27615","spoiler":false},{"segments":[{"spoiler":false,"text":"平安时代末期的僧兵，义经的家臣，义经四天王之一。"},{"spoiler":false,"text":"原本在比睿山学艺，结果因为粗暴的性格而被逐出比睿山。"},{"spoiler":false,"text":"之后，出于某种原因开始打算在京都掠夺武者的太刀。"},{"spoiler":false,"text":"她的目标是，夺得一千把太刀。"},{"spoiler":false,"text":"而且，她从不对弱者下手，而是专门对隶属于平家的武者下手，并顺利地夺得了九百九十九把太刀。"},{"spoiler":false,"text":"她手中的薙刀名为“岩融”。"}],"source":"bangumi","sourceCharacterId":"86905"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49b56a4d46f4362feaa57e41dc14315c4b1bd56741c66a57e45573557708db29.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cb582c429a08d6015f41c38a595b9561c16f3a244b4115d09d7c3f968b721c0.webp","width":211,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:270534:86905:10027:1","source":"bangumi"}]},{"characterId":"char_c93957","characterName":"平 知盛","sourceIds":{"bangumi":[{"characterId":"87067","match":"exact-normalized-name-in-linked-work","subjectId":"270534"}],"egsCharacterIds":["23112"],"vndbCharacterId":"c93957"},"originalCharacterName":"平 知盛","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"従二位・中納言 ※最終官位"},{"spoiler":false,"text":"平家の武将。平清盛の四女。"},{"spoiler":false,"text":"猛将と呼ばれた教経に対して、知盛は智将と言われた。"},{"spoiler":false,"text":"戦いの際も、持ち前の知略で源氏を大いに苦しめる。"},{"spoiler":false,"text":"幼少期から利発な子で、父の清盛が最も期待した子であったと言われている。"},{"spoiler":false,"text":"姉・宗盛とは仲が良いものの、宗盛の危うさのようなものを心配している。"}],"source":"egs","sourceCharacterId":"23112","sourceWorkId":"27615","spoiler":false},{"segments":[{"spoiler":false,"text":"従二位・中納言※最終官位"},{"spoiler":false,"text":"平家の武将。平清盛の四女。"},{"spoiler":false,"text":"猛将と呼ばれた教経に対して、知盛は智将と言われた。"},{"spoiler":false,"text":"戦いの際も、持ち前の知略で源氏を大いに苦しめる。幼少期から利発な子で、父の清盛が最も期待した子であったと言われている。"},{"spoiler":false,"text":"姉・宗盛とは仲が良いものの、宗盛の危うさのようものを心配している。"}],"source":"bangumi","sourceCharacterId":"87067"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd376b6927f3280c4b019c2bff450a713036e5033c574b47c53ad6159277f7cb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b9764a5473a9d7e45340b6e0ae03d1d7c3de8a062ddd9e19e7f7f85d4a2a2f3.webp","width":189,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:270534:87067:5020:1","source":"bangumi"}]},{"characterId":"char_c93958","characterName":"平 宗盛","sourceIds":{"bangumi":[{"characterId":"87066","match":"exact-normalized-name-in-linked-work","subjectId":"270534"}],"egsCharacterIds":["23111"],"vndbCharacterId":"c93958"},"originalCharacterName":"平 宗盛","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"従一位・内大臣 ※最終官位"},{"spoiler":false,"text":"平家の武将。平清盛の三女。"},{"s