edirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"111"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"151"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"小さな頃からアイドルを目指す少女。"},{"spoiler":false,"text":"かつて見たアイドルという存在そのものに憧れているが、歌ったり踊ったりする以外に具体的に何をする職業なのかはよくわかっていない。"},{"spoiler":false,"text":"ただ『アイドルになりたい』そんな純粋かつ単純な願望のみで動いている。"},{"spoiler":false,"text":"しかし思いに反して恥ずかしがり屋な為、誰もいない家の中でしか自分を曝け出せないので、その願望を知る者はいない。"},{"spoiler":false,"text":"主人公の甘い言葉に騙され、歪んだアイドルへと生まれ変わっていく。"},{"spoiler":false,"text":"主人公に騙され、アイドルになる為に指示された事に対して疑問を多少抱きつつも、結果が伴う為、頑張って受け入れていく。"},{"spoiler":false,"text":"アイドルに対する知識は少なく、特に誰が目標なども無く、誰がアイドルとして凄いかも知らない。"},{"spoiler":false,"text":"ただ、自分がアイドルになるという事に対しては強い思いを持っている。"},{"spoiler":false,"text":"アイドルになるという事が目的である為、ファンが欲しいという事や大勢の前でパフォーマンスをしたいといった願望は一切ない。"}],"source":"egs","sourceCharacterId":"8600","sourceWorkId":"23567","spoiler":false},{"segments":[{"spoiler":false,"text":"小さな頃からアイドルを目指している少女。"},{"spoiler":false,"text":"しかし恥ずかしがり屋で夢を語るようなことはなく、その思いを知る者はいない。"},{"spoiler":false,"text":"ただ “アイドルになりたい” という純粋な願望から陰ながら努力を重ね、"},{"spoiler":false,"text":"歌って踊る以外のアイドルの仕事についてはまったく分かっていない。"},{"spoiler":false,"text":"主人公の指導には疑問を多少抱きつつも、結果が伴うため頑張って受け入れていく。"},{"spoiler":false,"text":"そして甘い言葉に騙され続け、歪んだアイドルへと生まれ変わっていく。"},{"spoiler":false,"text":"「子供の頃に見たキラキラしたアイドルになりたいんです」"}],"source":"bangumi","sourceCharacterId":"43076"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"8600","sourceWorkId":"23567","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"151 cm","valueContext":null,"source":"egs","sourceCharacterId":"8600","sourceWorkId":"23567","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"8600","sourceWorkId":"23567","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"8600","sourceWorkId":"23567","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0f0ebb2e74b864743833a70edc5062a7212ff0867a5f6e41cde658e7a23761b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7ef2d51e513c21f29d27d6ca49206c5c6358331052aa738919ea5aac9ad22ae.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:181513:43076:5075:1","source":"bangumi"}]},{"characterId":"char_c45758","characterName":"志筑 志津","sourceIds":{"bangumi":[{"characterId":"43077","match":"exact-normalized-name-in-linked-work","subjectId":"181513"}],"egsCharacterIds":["8601"],"vndbCharacterId":"c45758"},"originalCharacterName":"志筑 志津","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"214"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公に才能を見抜かれスカウトされた少女。同じ学園に通っている後輩。"},{"spoiler":false,"text":"初めはアイドルには何の興味もないし、目立つなんて冗談じゃない、と拒否するが、主人公の手腕と待遇の良さを知り、口車に乗せられ、裏方としてアルバイトを始める事に。"},{"spoiler":false,"text":"悠里と雲母がこの後合流する娘とアイドルユニットとしてデビューする予定と嘘を吐かれ、合流するまでのリハーサル相手としてアイドルの真似事もする事となる。"},{"spoiler":false,"text":"何事もそつなくこなす器用さがあり、それもあって悠里から一目置かれ、仮ユニットを組む事には賛成されている。"},{"spoiler":false,"text":"アイドルに対する知識は悠里以上にはあるが、一般人がテレビを見て知る程度のもの。"},{"spoiler":false,"text":"雲母についてはこういう人もいる、と静観。自分とはまったく違う部分などは評価している。"}],"source":"egs","sourceCharacterId":"8601","sourceWorkId":"23567","spoiler":false},{"segments":[{"spoiler":false,"text":"同じ学園に通っている後輩。 主人公に才能を見抜かれスカウトされた。"},{"spoiler":false,"text":"初めは、アイドルに興味はないし目立つなんて冗談じゃない、と拒否していたが、"},{"spoiler":false,"text":"主人公の手腕と待遇の良さを知り、裏方のアルバイトとして参加する。"},{"spoiler":false,"text":"何事も器用にそつなくこなし、悠里からも一目置かれている。"},{"spoiler":false,"text":"雲母についてはこういう人もいると静観し、自分とは違う部分は評価している。"},{"spoiler":false,"text":"「ほどほどに稼いだらセミリタイアしてのんびり暮らす。 それが私の人生設計」"}],"source":"bangumi","sourceCharacterId":"43077"}],"profileFacts":[{"label":"胸围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"8601","sourceWorkId":"23567","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"8601","sourceWorkId":"23567","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"8601","sourceWorkId":"23567","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"8601","sourceWorkId":"23567","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e086d76f5da71689eb9dfb4c6a1e7be0c4bcd6b87f5274f29c01ae6fa3177fc1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7ab31f1939e0268550d5922947b7d13071f19d92070123a6c1471a16d4bbded2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:181513:43077:6359:1","source":"bangumi"}]},{"characterId":"char_c45759","characterName":"鏡花院 聖羅","sourceIds":{"bangumi":[{"characterId":"43078","match":"exact-normalized-name-in-linked-work","subjectId":"181513"}],"egsCharacterIds":["8602"],"vndbCharacterId":"c45759"},"originalCharacterName":"鏡花院 聖羅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"319"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園の先輩。"},{"spoiler":false,"text":"自称トップアイドルの玉子（卵ではなく、勘違いしている）"},{"spoiler":false,"text":"主人公からスカウトされたのも当然と思っており、傲慢なところがあるも、どこか抜けていて実力は三人の中で一番下。"},{"spoiler":false,"text":"悠里に負けないくらいアイドルへの憧れがあるが、自分には天性の素質があると思い込んでおり、努力を怠っている。"},{"spoiler":false,"text":"学園でも人気者というわけではなく、変わり者という認識だが、本人は他人の評価をまったく気にしていない。"},{"spoiler":false,"text":"誰も見ていなくても自分は輝いていると思っているナルシストで、プロポーションはいいが、それ以外がまずい残念美人。"},{"spoiler":false,"text":"アイドルに対する知識だけは三人の中で随一。"},{"spoiler":false,"text":"しかし学力が学園に入れる程度の低さで、アイドルには必要ないとあまり勉強する気なし。"},{"spoiler":false,"text":"苗字を田舎っぽいと思い、名前の読みは好きだが漢字が嫌いな為、呼ばれ方にはこだわる。"},{"spoiler":false,"text":"他の二人は自分の引き立て役と思っているが、自分がより輝く為に必要な存在と考えている。"}],"source":"egs","sourceCharacterId":"8602","sourceWorkId":"23567","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の先輩。 自称・トップアイドルの玉子（卵と勘違いしている）。"},{"spoiler":false,"text":"悠里に負けず劣らずアイドルへの憧れが強く、アイドルについての知識は随一。"},{"spoiler":false,"text":"しかし実力は三人の中で一番下で、アイドルに必要ないからと勉強もせず学力は低い。"},{"spoiler":false,"text":"プロポーションは良いが、それ以外がダメな残念美人。"},{"spoiler":false,"text":"傲慢なところがあり、自分は輝いていると思っているナルシスト。"},{"spoiler":false,"text":"しかも自分には天性の素質があると思い込んでいて努力を怠っている。"},{"spoiler":false,"text":"学園でも人気者ではなく変わり者という認識だが、本人はまったく気にしていない。"},{"spoiler":false,"text":"「今日は実力の 1％も出せてないの、こういう日もあるわ」"}],"source":"bangumi","sourceCharacterId":"43078"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"8602","sourceWorkId":"23567","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"8602","sourceWorkId":"23567","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"8602","sourceWorkId":"23567","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"8602","sourceWorkId":"23567","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25adf360fce5c8e22f47c1e88b96ffac234778413433a798cd20e28062266310.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/174a71d328d547b1403699dbae7b401d871938b53392d6665282a5c5a12c16d2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:181513:43078:15684:1","source":"bangumi"}]},{"characterId":"char_vndb_c45760","characterName":"和泉 東吾","sourceIds":{"vndbCharacterId":"c45760"},"originalCharacterName":"和泉 東吾","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConfl