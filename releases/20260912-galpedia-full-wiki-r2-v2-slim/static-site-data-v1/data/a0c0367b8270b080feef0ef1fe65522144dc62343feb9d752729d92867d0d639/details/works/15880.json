"},{"creditedName":"禾 刀郷","creatorId":"vndb:s7796","sourcePersonId":"vndb:s7796","canonicalEntityId":"vndb:s7796","name":"禾 刀郷","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:72489","source":"vndb"},{"creditedName":"しまさらゆめき","creatorId":"vndb:s9293","sourcePersonId":"vndb:s9293","canonicalEntityId":"vndb:s9293","name":"しまさらゆめき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:72490","source":"vndb"},{"creditedName":"aina","creatorId":"vndb:s9294","sourcePersonId":"vndb:s9294","canonicalEntityId":"vndb:s9294","name":"aina","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:72491","source":"vndb"},{"creditedName":"グランテール井上","creatorId":"vndb:s9295","sourcePersonId":"vndb:s9295","canonicalEntityId":"vndb:s9295","name":"グランテール井上","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:72492","source":"vndb"},{"creditedName":"大木 犬太郎","creatorId":"vndb:s10273","sourcePersonId":"vndb:s10273","canonicalEntityId":"vndb:s10273","name":"大木 犬太郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:72494","source":"vndb"},{"creditedName":"kobi","creatorId":"vndb:s10984","sourcePersonId":"vndb:s10984","canonicalEntityId":"vndb:s10984","name":"kobi","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:72495","source":"vndb"}]},"cast":[{"characterId":"char_c24962","characterName":"リンドウ","sourceIds":{"bangumi":[{"characterId":"146527","match":"exact-normalized-name-in-linked-work","subjectId":"22974"}],"egsCharacterIds":["9851"],"vndbCharacterId":"c24962"},"originalCharacterName":"リンドウ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A strange woman, who appeared before Inami when he ran around the mountains on his journey of revenge. Judging from her physique and appearance, she cannot be considered an ordinary person, but she is suspected of being a sanjin. Nonetheless, she possesses miraculous spiritual power and immortality (possibly due to her long life), and even sanjins regard her as a mountain princess or goddess."},{"spoiler":false,"text":"Her appearance, as well as her senses and personality, are alien to humanity. Rindou continuously speaks and conducts, even to Inami, as if leading one around by the nose."},{"spoiler":false,"text":"Although it's unclear how she is related to the protagonist's enemies, he hates her strongly and intensely, the same way he hates sanjins. On the other hand, Rindou finds his emotional outbursts directed at her to be enjoyable."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c24962"},{"segments":[{"spoiler":false,"text":"復讐行に山野を駆け巡る伊波の前に出現した異形の女。"},{"spoiler":false,"text":"その骨格、風体からして常人とは思われず、恐らくは彼女もまた山人と思われる。"},{"spoiler":false,"text":"ただ、永きにわたる歳月を経てきたせいか、不可思議な妖力・不死身性を有しており、山人たちからも山姫・姫神扱いされている。"},{"spoiler":false,"text":"容姿のみならず、感性、性格もまた人間離れしており、伊波に対しても翻弄するような言動を取ることもしばしば。"},{"spoiler":false,"text":"伊波の仇とどういう関わりがあるのか不明だが、山人たちと同様に彼の憎しみを強く強く受ける。"},{"spoiler":false,"text":"が、自分に向けられる青年の感情の爆発を楽しんでいる節もある。"}],"source":"egs","sourceCharacterId":"9851","sourceWorkId":"15880","spoiler":false},{"segments":[{"spoiler":false,"text":"復讐行に山野を駆け巡る伊波の前に出現した異形の女。"},{"spoiler":false,"text":"その骨格、風体からして常人とは思われず、恐らくは彼女もまた山人と思われる。"},{"spoiler":false,"text":"ただ、永きにわたる歳月を経てきたせいか、不可思議な妖力・不死身性を有しており、山人たちからも山姫・姫神扱いされている。"},{"spoiler":false,"text":"容姿のみならず、感性、性格もまた人間離れしており、伊波に対しても翻弄するような言動を取ることもしばしば。"},{"spoiler":false,"text":"伊波の仇とどういう関わりがあるのか不明だが、山人たちと同様に彼の憎しみを強く強く受ける。"},{"spoiler":false,"text":"が、自分に向けられる青年の感情の爆発を楽しんでいる節もある。"},{"spoiler":false,"text":"「お前のしつこさときたら、乳へ吸いつく赤子のよう…… 吸いたいかえ？　吸わせてやろうかえ……？」"}],"source":"bangumi","sourceCharacterId":"146527"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/3312a585ede86a67971de03923c848b87ccaf64a56988b3afdff1b0ff6ad869a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59fdbb0a12398dd3719afb3f0ca6b09108696d343e1a0e84006e20bfdc437aa4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雪野梨沙","creatorId":"vndb:s1610","sourcePersonId":"vndb:s1610","canonicalEntityId":"vndb:s1610","name":"雪野 梨沙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22974:146527:5903:1","source":"bangumi"}]},{"characterId":"char_c24963","characterName":"山人","sourceIds":{"bangumi":[{"characterId":"146531","match":"exact-normalized-name-in-linked-work","subjectId":"22974"}],"egsCharacterIds":["9854"],"vndbCharacterId":"c24963"},"originalCharacterName":"山人","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Strange things who lurk in deep mountain valleys. Their true origins are unclear. There are various theories about it: some believe they are ancestors of the people who lived in this country, while others believe they are some different kind of strange creatures."},{"spoiler":false,"text":"It appears that almost no male sajins have been born in recent years, so the species' population size is steadily decreasing. They also share another characteristic of dying out species: they all essentially look the same, possibly because their blood is thick and their genes are averaging out."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c24963"},{"segments":[{"spoiler":false,"text":"深山幽谷に潜む、不思議のモノたち。バー"},{"spoiler":false,"text":"この国に住む人間たちの起源になったとも、あるいは人間とは異なる妖（あやかし）のモノだとも様々に言われているが、その正体は定かではない。"},{"spoiler":false,"text":"バー"},{"spoiler":false,"text":"近年男がほとんど生まれなくなっているらしく、その数は減少の一途にある。"},{"spoiler":false,"text":"血が濃く、平均化されてきたせいか、いずれも容貌が酷似するようになっており、これもまた滅びゆく民族の特徴といえよう。"}],"source":"egs","sourceCharacterId":"9854","sourceWorkId":"15880","spoiler":false},{"segments":[{"spoiler":false,"text":"深山幽谷に潜む、不思議のモノたち。"},{"spoiler":false,"text":"この国に住む人間たちの起源になったとも、あるいは人間とは異なる妖（あやかし）のモノだとも様々に言われているが、その正体は定かではない。"},{"spoiler":false,"text":"近年男がほとんど生まれなくなっているらしく、その数は減少の一途にある。"},{"spoiler":false,"text":"血が濃く、平均化されてきたせいか、いずれも容貌が酷似するようになっており、これもまた滅びゆく民族の特徴といえよう。"},{"spoiler":false,"text":"「山はあたいらの領分。里はあんたらの領分」"}],"source":"bangumi","sourceCharacterId":"146531"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6ec04ec0903811aca9f79699ab30f8026cbdbf64e4eb08059b82ca1f8db9626.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6e5257b3fa25dd0bae5eee8f7ed22efab234d4b9e4306e8a4aaf7923f9394ad.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22974:146531:4463:1","source":"bangumi"}]},{"characterId":"char_c24964","characterName":"いち","sourceIds":{"bangumi":[{"characterId":"146525","match":"exact-normalized-name-in-linked-work","subjectId":"22974"}],"egsCharacterIds":["9850"],"vndbCharacterId":"c24964"},"originalCharacterName":"いち","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl from a mountain village who is derisively referred to as \"Wild Dog\" and is compelled to. In the past, she suffered an injury that left her with one eye blind. She lived by herself in a remote hut and rarely visited the village."},{"spoiler":false,"text":"However, due to pressing circumstances, Ichi laid hands on Inami's belongings, was easily captured and mercilessly raped. For better or worse, her nose is more acute than an ordinary person's, so she got into a predicament: Inami dragged her with him as a substitute for a hound and a handy outlet for his sexual and violent urges."},{"spoiler":false,"text":"The rope around her neck was not untied until the end of the story."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c24964"},{"segments":[{"spoiler":false,"text":"とある山間の集落で “ヤマイヌ” と蔑称され、軽んぜられている娘。"},{"spoiler":false,"text":"過去になんらかの傷を負い、片目が潰れてしまっている。"},{"spoiler":false,"text":"集落から離れた山小屋に一人住まい、滅多に里に降りてくることはなかった。"},{"spoiler":false,"text":"しかしやむにやまれぬ事情から、伊波の荷物に手を出してしまったところ、あえなく捕まり、無残にも手籠めにされることとなる。"},{"spoiler":false,"text":"幸か不幸か常人より鼻が利くという体質もあって、猟犬代わりとして、かつまた手近な性欲・暴力欲のはけ口として、以降伊波に奴隷のように引きずり回される羽目に。"},{"spoiler":false,"text":"彼女の首に打たれた縄は、物語の最後まで解かれることはない。"}],"source":"egs","sourceCharacterId":"9850","sourceWorkId":"15880","spoiler":false},{"segments":[{"spoiler":false,"text":"とある山間の集落で “ヤマイヌ” と蔑称され、軽んぜられている娘。"},{"spoiler":false,"text":"過去になんらかの傷を負い、片目が潰れてしまっている。"},{"spoiler":false,"text":"集落から離れた山小屋に一人住まい、滅多に里に降りてくることはなかった。"},{"spoiler":false,"text":"しかしやむにやまれぬ事情から、伊波の荷物に手を出してしまったところ、あえなく捕まり、無残にも手籠めにされることとなる。"},{"spoiler":false,"text":"幸か不幸か常人より鼻が利くという体質もあって、猟犬代わりとして、かつまた手近な性欲・○○欲のはけ口として、以降伊波に○○のように引きずり回される羽目に。"},{"spoiler":false,"text":"彼女の首に打たれた縄は、物語の最後まで解かれることはない。"},{"spoiler":false,"text":"「めっかちって、言わないでね……？」"}],"source":"bangumi","sourceCharacterId":"146525"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2afd55e031b53efb4941cf537e7948666727d9563e583838a35506091faa04f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d010d567a688056255510a4bd46bf2537b8629574d33f562b277a6ea97c7d6cf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"栗原雅子","creatorId":"vndb:s298","sourcePersonId":"vndb:s298","canonicalEntityId":"vndb:s298","name":"野月 まひる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22974:146525:6570:1","source":"bangumi"}]},{"characterId":"char_c24965","characterName":"瀬川 京香","sourceIds":{"bangumi":[{"characterId":"146528","match":"exact-normalized-name-in-linked-work","subjectId":"22974"}],"egsCharacterIds":["9852"],"vndbCharacterId":"c24965"},"originalCharacterName":"瀬川 京香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A woman whom Inami met on his journey of revenge. With her father being European and her mother being Japanese, she has several characteristics of the mixed-race child: flax hair and light reddish-brown eyes."},{"spoiler":false,"text":"Not only does Segawa wear unusual Western clothing, but she also appears to be conducting research in folkloristics, a field of study that has only started to rise. Therefore, she leads an outstanding life for a woman of her time."},{"spoiler":false,"text":"You can imagine how many challenges Segawa, an intelligent and proper woman, has faced in her life as a result of her origin."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c24965"},{"segments":[{"spoiler":false,"text":"伊波が復讐行の途次出会うことになる女性。"},{"spoiler":false,"text":"その亜麻色の髪、薄鳶色の瞳は、欧州人の父と日本人の母の間に産まれた混血児という身の上によっている。"},{"spoiler":false,"text":"この時代の女性としてはまだ珍しい洋装の上に、興ったばかりの民俗学を研究しているらしく、当時としては相当に尖った人生を歩んでいる。"},{"spoiler":false,"text":"知的で穏当な女性ではあるのだが、その出自から、色々と障害の多い人生を送ってきたのではと推測される。"}],"source":"egs","sourceCharacterId":"9852","sourceWorkId":"15880","spoiler":false},{"segments":[{"spoiler":false,"text":"伊波が復讐行の途次出会うことになる女性。"},{"spoiler":false,"text":"その亜麻色の髪、薄鳶色の瞳は、欧州人の父と日本人の母の間に産まれた混血児という身の上によっている。"},{"spoiler":false,"text":"この時代の女性としてはまだ珍しい洋装の上に、興ったばかりの民俗学を研究しているらしく、当時としては相当に尖った人生を歩んでいる。"},{"spoiler":false,"text":"知的で穏当な女性ではあるのだが、その出自から、色々と障害の多い人生を送ってきたのではと推測される。"},{"spoiler":false,"text":"「この研究は、実地調査が大切なんです。だから私も色々な処へ、調査旅行に」"}],"source":"bangumi","sourceCharacterId":"146528"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/801283bab69a6477b812a36d02de33472192c9047c9d1a8a84bd41a6c4a5ea8d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e4eccf8f2094885a099892cbe682ea22daade4575b05247cc417707e3dca702.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22974:146528:6469:1","source":"bangumi"}]},{"characterId":"char_c24966","characterName":"山東 鈴子","sourceIds":{"bangumi":[{"characterId":"146530","match":"exact-normalized-name-in-linked-work","subjectId":"22974"}],"egsCharacterIds":["9853"],"vndbCharacterId":"c24966"},"originalCharacterName":"山東 鈴子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young girl and the sole daughter of a wealthy person from a mountain village that Inami happened to visit."},{"spoiler":false,"text":"Her father and household members bring her up like a princess and overprotect her, yet for some reason she lives closed in a storeroom in a corner of the magnificent mansion. There are chains attached to her wrist and ankle."},{"spoiler":false,"text":"Santou does not, however, show much curiosity about the outer world. The reason is probably that there are no inconveniences in her luxurious storeroom. She is a pure young lady, uncorrupted by the unhappiness of the outside world, almost like a precious hidden pearl, and yet..."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c24966"},{"segments":[{"spoiler":false,"text":"伊波が訪れることになる山村の、分限者の一人娘である少女。"},{"spoiler":false,"text":"父親や家人からは蝶よ花よと過保護にされているのだが、なぜか宏壮な家屋敷の片隅の土蔵に封じこめられて暮らしており、両の手首足首には細い鎖が繋がれている。"},{"spoiler":false,"text":"ただ蔵の中は贅沢に整えられており、不自由がないせいもあってか、本人も外の世界には興味が薄い。"},{"spoiler":false,"text":"純真無垢、外界の憂き事に汚されざる、秘中の珠のような少女ではあるのだが―――"}],"source":"egs","sourceCharacterId":"9853","sourceWorkId":"15880","spoiler":false},{"segments":[{"spoiler":false,"text":"伊波が訪れることになる山村の、分限者の一人娘である少女。"},{"spoiler":false,"text":"父親や家人からは蝶よ花よと過保護にされているのだが、なぜか宏壮な家屋敷の片隅の土蔵に封じこめられて暮らしており、両の手首足首には細い鎖が繋がれている。"},{"spoiler":false,"text":"ただ蔵の中は贅沢に整えられており、不自由がないせいもあってか、本人も外の世界には興味が薄い。"},{"spoiler":false,"text":"純真無垢、外界の憂き事に汚されざる、秘中の珠のような少女ではあるのだが―――"},{"spoiler":false,"text":"「鈴はねえ、お外になんか出なくってもいいの」"}],"source":"bangumi","sourceCharacterId":"146530"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43222cac3139b08981d24afae9ca1ba259737e7f246f13e0ca50e89a70c0c1bd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b39b5fef92451d94b2fb663116654c6cea3174285cfa1960d61e37f6660604e1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22974:146530:5922:1","source":"bangumi"}]},{"characterId":"char_c24967","characterName":"千種 初美","sourceIds":{"bangumi":[],"egsCharacterIds":["9855"],"vndbCharacterId":"c24967"},"originalCharacterName":"千種 初美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The only daughter of Inami's foster parent, Viscount Chigusa, and the fiance of the young man. From childhood, she was a sensible and cheerful girl, who interacted with the protagonist, who had lost his family and was adopted, without any biases."},{"spoiler":false,"text":"Hatsumi developed feelings for Inami as she grew up beautiful and vigorous, so the two of them even became engaged. However, one night, she was brutally murdered in the city. And so the story of revenge begins, originating from her death."},{"spoiler":false,"text":"The protagonist continues to cherish her, his dearest and only beloved. Somehow, Wild Dog Ichi closely resembles her."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c24967"},{"segments":[{"spoiler":false,"text":"伊波の養い親・千種子爵家の一人娘にして、青年の許嫁であった娘。"},{"spoiler":false,"text":"幼少時より聡明かつ明朗な娘であり、家族を喪い引き取られた伊波に対しても別け隔てなく接していた。"},{"spoiler":false,"text":"美しく健やかに長じていくうちに伊波との間に愛情を育み、婚約を結ぶまでに至る。"},{"spoiler":false,"text":"しかしある夜 街中で惨殺されてしまい、彼女の死がこの復讐の物語の発端となる。"},{"spoiler":false,"text":"伊波が想い続ける、最愛にして唯一の女性。"},{"spoiler":false,"text":"何故かヤマイヌ・いちは、この初美と容貌が酷似している。"}],"source":"egs","sourceCharacterId":"9855","sourceWorkId":"15880","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/9805280f01262cf404d35c29cf3dfc5f9546197f18e20427c818bb311017d94d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75803a2df85e32a2e05b54f12e980e50f9df40b7853667964d58de863690ba43.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野月 まひる","creatorId":"vndb:s298","sourcePersonId":"vndb:s298","canonicalEntityId":"vndb:s298","name":"野月 まひる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40746","source":"vndb"}]},{"characterId":"char_c48874","characterName":"伊波 冬矢","sourceIds":{"bangumi":[],"egsCharacterIds":["9849"],"vndbCharacterId":"c48874"},"originalCharacterName":"伊波 冬矢","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this story. He has his lot: his parents passed away when he was young—but afterwards he was blessed with a foster parent, got a fiance, and led a happy life."},{"spoiler":false,"text":"...Nevertheless, it completely changed once someone murdered her. Those irreplaceable days were lost. The incident changed the young man into a demon of revenge. His heart was warped by suspicions, his eyes were corrupted with obsession, and his brain was on the verge of insanity."},{"spoiler":false,"text":"His blaze of vengeance will not be extinguished. Not until the day he plunges into the abyss of doom, dragging everyone else with him, no matter if they are foe or friend."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c48874"},{"segments":[{"spoiler":false,"text":"本編の主人公。"},{"spoiler":false,"text":"幼少時に家族を亡くすという不遇の身の上にあったものの、その後養い親に恵まれ許嫁を得て、それなりに幸せな生を送っていた。"},{"spoiler":false,"text":"――が、許嫁が何者かに殺害されてしまったことにより、人生が一変する。"},{"spoiler":false,"text":"失われてしまった、かけがえのない日々。それが青年を復讐の鬼に変える。"},{"spoiler":false,"text":"猜疑に凝り固まった心、執念にドス汚れた瞳、なかば狂いかかった脳髄。"},{"spoiler":false,"text":"彼の復讐の炎は消えることがない。"},{"spoiler":false,"text":"仇であろうと無かろうと、関わった者全てを巻きこみ、破滅の淵に転がり落ちていくその日まで。"}],"source":"egs","sourceCharacterId":"9849","sourceWorkId":"15880","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1dc0865a69d747f6790b9ea2424dc9a41d400a2fa2b6b8ce82e401c1422aa010.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd82fe70d1b0f35ff02bf40ab1a783d60f8060c47a08c5753d2c35ea434e89a4.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c48875","characterName":"椿 啓文","sourceIds":{"bangumi":[],"egsCharacterIds":["9857"],"vndbCharacterId":"c48875"},"originalCharacterName":"椿 啓文","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A member of the imperial capital's Ministry of Home Affairs. A young gentleman. One of a few of Inami's friends."},{"spoiler":false,"text":"A mild-mannered, common-sense man. It's unusual for someone like him to be the protagonist's friend. Tsubaki is also one of the few individuals who can advise or admonish Inami. He also has a wife."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c48875"},{"segments":[{"spoiler":false,"text":"帝都にて内務省に勤める、若き紳士。そして伊波の数少ない友人。"},{"spoiler":false,"text":"温厚な常識人であり、こういう人物が伊波と友達付き合いを続けていられるというのも不思議な話である。"},{"spoiler":false,"text":"伊波に対して忠告や諌言ができる少ない人間でもある。"},{"spoiler":false,"text":"なお細君あり。"}],"source":"egs","sourceCharacterId":"9857","sourceWorkId":"15880","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f24d7a5cdce9d89d077ca88b21a0bef124a154d7f2888c9dfbce3fe5052ab7f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3f2b528771b9d1bb0e033392edf7e46eb7256ba4c8a192d501a64966d276fbe.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c48876","characterName":"化野 八郎","sourceIds":{"bangumi":[],"egsCharacterIds":["9856"],"vndbCharacterId":"c48876"},"originalCharacterName":"化野 八郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A rickshaw puller, who calls himself Adashino. He does not stop in one town. Pulling his rickshaw, he appears everywhere Inami goes."},{"spoiler":false,"text":"Is this merely a coincidence? Or, perhaps, Adashino acts based on some sort of calculations? In any case, he only dodges the suspicions with a faint smile."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c48876"},{"segments":[{"spoiler":false,"text":"化野（あだしの）と名乗る、人力車の車夫。"},{"spoiler":false,"text":"一つの町に留まらず、人力車を牽いて伊波の行く先々に現れる。"},{"spoiler":false,"text":"それが偶然によるものか、なんらかの思惑を抱いての行動なのか、彼自身は薄ら笑いに誤魔化すばかり。"}],"source":"egs","sourceCharacterId":"9856","sourceWorkId":"15880","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b002935f671c5fef8bb0402d39c182fa357c4933349560ef041207f67e666e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e251f9652d823a9d14cafb448c28d328fb5cbeae6e54addf985af56ce60728f.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c154999","characterName":"時雨 宗右衛門","sourceIds":{"vndbCharacterId":"c154999"},"originalCharacterName":"時雨 宗右衛門","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b579d2101a9603be50668329a9870bdbc5216cce7a7721f023626bcc4e3ad62.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7dd55973c461307bc11ed3cd0d0549c9f8eb875a3e45b66f29eb08e750507d30.webp","width":195,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p404","sourceCompanyId":"egs:brand:2464","canonicalEntityId":"vndb:p404","name":"raiL-soft","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:15880:2464","source":"egs"},{"companyId":"vndb:p404","sourceCompanyId":"vndb:p404","canonicalEntityId":"vndb:p404","name":"raiL-soft","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:18213:v7661","source":"vndb"},{"companyId":"vndb:p7120","sourceCompanyId":"vndb:p7120","canonicalEntityId":"vndb:p7120","name":"株式会社ビジネスパートナー","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:18214:v7661","source":"vndb"},{"companyId":"vndb:p404","sourceCompanyId":"vndb:p404","canonicalEntityId":"vndb:p404","name":"raiL-soft","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:18530:v7661","source":"vndb"},{"companyId":"vndb:p7120","sourceCompanyId":"vndb:p7120","canonicalEntityId":"vndb:p7120","name":"株式会社ビジネスパートナー","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:18531:v7661","source":"vndb"},{"companyId":"vndb:p404","sourceCompanyId":"vndb:p404","canonicalEntityId":"vndb:p404","name":"raiL-soft","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:60078:v7661","source":"vndb"},{"companyId":"vndb:p7120","sourceCompanyId":"vndb:p7120","canonicalEntityId":"vndb:p7120","name":"株式会社ビジネスパートナー","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:60079:v7661","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
