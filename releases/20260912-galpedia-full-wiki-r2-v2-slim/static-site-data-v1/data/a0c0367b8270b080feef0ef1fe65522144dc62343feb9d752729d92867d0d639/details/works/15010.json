lEntityId":"vndb:s10633","name":"すぱな","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:65199","source":"vndb"},{"creditedName":"スダ ヲカユ","creatorId":"vndb:s19333","sourcePersonId":"vndb:s19333","canonicalEntityId":"vndb:s19333","name":"スダ ヲカユ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:65200","source":"vndb"},{"creditedName":"studio-outline","creatorId":"vndb:s26072","sourcePersonId":"vndb:s26072","canonicalEntityId":"vndb:s26072","name":"橋本 慎一","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:65201","source":"vndb"},{"creditedName":"R/B2スタジオ","creatorId":"vndb:s26691","sourcePersonId":"vndb:s26691","canonicalEntityId":"vndb:s26691","name":"R/B2スタジオ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:65202","source":"vndb"},{"creditedName":"せんや","creatorId":"vndb:s31211","sourcePersonId":"vndb:s31211","canonicalEntityId":"vndb:s31211","name":"せんや","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:65203","source":"vndb"},{"creditedName":"有限会社ロックンバナナ","creatorId":"vndb:s26686","sourcePersonId":"vndb:s26686","canonicalEntityId":"vndb:s26686","name":"ロックンバナナ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:65204","source":"vndb"},{"creditedName":"氷城 蒼依","creatorId":"vndb:s37674","sourcePersonId":"vndb:s37674","canonicalEntityId":"vndb:s37674","name":"氷城蒼依","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:65205","source":"vndb"}]},"cast":[{"characterId":"char_c7811","characterName":"真中 合歓","sourceIds":{"bangumi":[{"characterId":"14742","match":"exact-normalized-name-in-linked-work","subjectId":"19385"}],"egsCharacterIds":["3525"],"vndbCharacterId":"c7811"},"originalCharacterName":"真中 合歓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nemu is widely considered to be the most beautiful girl in Keisuke’s class, carrying the grace and poise of a sophisticated noble woman. Her demeanor and candor however, are condescending and intolerably insulting. Despite being classmates with Keisuke and Kanae, she has hardly ever interacted with them. She is sadistic and emotionally disgusting, spewing hateful discontent and encouraging irrational prejudgment with her every action."},{"spoiler":false,"text":"Even in this extreme situation that she found herself in, she still keeps her cool as her reaction is neither terror nor desperation, but amusement and delight. Nothing gives her more pleasure than the suffering of others, abusing the weak and breaking the powerful. Unfortunately for Keisuke, affection and torture are one and the same to her. When Nemu figures out about Keisuke’s hidden lusts, she'll gently start pressuring him to unleash them. One might surmise that she just loves being hated."},{"spoiler":false,"text":"Edited from erogereview, MangaGamer and belucre's euphoria review"}],"source":"vndb","sourceCharacterId":"c7811"},{"segments":[{"spoiler":false,"text":"六恵館学園の２年生。恵輔のクラスメイト。"},{"spoiler":false,"text":"教室ではいつも一人でいる高嶺の花的な美少女。"},{"spoiler":false,"text":"クラスメイトながら恵輔や叶とはほとんど交流がない。"},{"spoiler":false,"text":"頭の回転が速く、観察力に優れ、身体能力も高い。"},{"spoiler":false,"text":"極限状態にあっても余裕のある態度を崩さず、オープニングで恵輔の秘めた欲望を見抜き、その衝動を解放すべきだと甘く説く。"},{"spoiler":false,"text":"気まぐれで意味深な態度で恵輔を惑乱し、翻弄する。"},{"spoiler":false,"text":"その真意は不明。"}],"source":"egs","sourceCharacterId":"3525","sourceWorkId":"20303","spoiler":false},{"segments":[{"spoiler":false,"text":"性格反复无常，具有蛊惑性的令人难以理解的少女"},{"spoiler":false,"text":"六庆馆学园2年级。恵輔的同班同学。"},{"spoiler":false,"text":"在教室总是孤身一人的高岭之花般的美少女。"},{"spoiler":false,"text":"头脑转弯很快，观察力也很优秀，体能也很强。"},{"spoiler":false,"text":"即使到了最紧急的状态也保持着余裕的态度，在一开始看穿了恵輔内心的欲望后，便开始诱惑他说应该解放那股冲动。"},{"spoiler":false,"text":"运用反复无常的意味深长的态度来玩弄恵輔。"},{"spoiler":false,"text":"真正用意不明。"},{"spoiler":false,"text":"「你果然很可爱呢。但是我啊、喜欢更冷酷的男人」"}],"source":"bangumi","sourceCharacterId":"14742"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/562ec396ba1e823a680a72d635b8949bb2c25b37fb4b15bfe4d3f58fe74b59d5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df1f0b55fb9320d66127a6d3a036176fa7bca8123ce70901c8a03682fc5b5a0b.webp","width":67,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19385:14742:5922:1","source":"bangumi"}]},{"characterId":"char_c7813","characterName":"帆刈 叶","sourceIds":{"bangumi":[{"characterId":"14743","match":"exact-normalized-name-in-linked-work","subjectId":"19385"}],"egsCharacterIds":["3526"],"vndbCharacterId":"c7813"},"originalCharacterName":"帆刈 叶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Keisuke’s childhood friend, classmate and most trusted confidant. She's a kind girl, always caring for those around her and never losing her smile. Not only is she kind, but she’s also capable of speaking her mind when the situation demands it. She is willing to endure hellish treatment and nightmarish torture to help Keisuke escape, remaining unwaveringly devoted to him, even if her feelings are unrequited. But nevertheless, for Keisuke she's an irreplaceable friend and there is no one else for whom he'd want more to survive the Game than her."},{"spoiler":false,"text":"Edited from erogereview, MangaGamer and belucre's euphoria review"}],"source":"vndb","sourceCharacterId":"c7813"},{"segments":[{"spoiler":false,"text":"六恵館学園の２年生。"},{"spoiler":false,"text":"恵輔のクラスメイトで幼なじみ。"},{"spoiler":false,"text":"恵輔とは信頼関係で結ばれている。"},{"spoiler":false,"text":"笑顔を絶やさず、常に周りを気遣える心優しい女の子。"},{"spoiler":false,"text":"ただ優しいだけではなく、必要な時はきちんと自分の意見を言える芯の強さも併せ持っている。"},{"spoiler":false,"text":"童顔で背が低いので、年下に見られがちなのを密かに気にしている。"},{"spoiler":false,"text":"反面胸だけは育ち続けていて、制服のサイズが合わなくなりつつあるのが目下の悩み。"}],"source":"egs","sourceCharacterId":"3526","sourceWorkId":"20303","spoiler":false},{"segments":[{"spoiler":false,"text":"善良且坚强的青梅竹马"},{"spoiler":false,"text":"六庆馆学园2年级。恵輔的同班同学兼青梅竹马。"},{"spoiler":false,"text":"和恵輔缔结了互相信赖的关系。"},{"spoiler":false,"text":"总是保持着笑容，经常关心周围的人的心地善良的女孩子。"},{"spoiler":false,"text":"但她并不仅仅只是善良而已，也有着必要的时候能够说出自己的意见的坚强的一面。"},{"spoiler":false,"text":"因为童颜和身高，所以暗暗地介意着自己经常被人当做小孩子。"},{"spoiler":false,"text":"另一方面只有胸部在不停地凶长，因为制服的尺寸已经容不下而烦恼。"},{"spoiler":false,"text":"「我…是你的伙伴…所以不管…不管做什么事…我、都不在乎…」"}],"source":"bangumi","sourceCharacterId":"14743"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f995e7199a4306a9ba9cbabd977a1ab990c7de304438fa476919923683cb1307.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/4715d87e00136c0fbdf26cb6a58c4a415f4a1c44bc1afa6d8cd1f6f309716f6b.webp","width":65,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19385:14743:6351:1","source":"bangumi"}]},{"characterId":"char_c7816","characterName":"白夜 凛音","sourceIds":{"bangumi":[{"characterId":"14744","match":"exact-normalized-name-in-linked-work","subjectId":"19385"}],"egsCharacterIds":["3527"],"vndbCharacterId":"c7816"},"originalCharacterName":"白夜 凛音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Keisuke's schoolmate, Rinne, is the second year student at Rokukeikan Academy and an infamously emotionless representative of the Discipline Committee. She is unbending and remorseless, a person who obeys the exacting Letter of the Law and has no sympathy or understanding for the Spirit. Her methodical nature and strictness often causes discomfort to the people around her. She values order and control above all with a tendency to be hard on those that don’t follow the rules. The luxurious long hair and cold beautiful face are the only things students know of her, as she disdains friendship and despises unnecessary involvement."},{"spoiler":false,"text":"Edited from erogereview and MangaGamer"}],"source":"vndb","sourceCharacterId":"c7816"},{"segments":[{"spoiler":false,"text":"六恵館学園の２年生。風紀委員を勉めている。"},{"spoiler":false,"text":"長く美しい黒髪を持つ、冷たい感じのする美少女。"},{"spoiler":false,"text":"几帳面で、自分にも他人にも厳しいところがあるため、共に行動する人間に息苦しさを感じさせることが多い。"},{"spoiler":false,"text":"規律と統制を重んじ、定められたルールから外れる者に厳しく接する傾向にある。"},{"spoiler":false,"text":"独りを好むと思われがちだが、朗読会や清掃ボランティアなどに積極的に参加し、社会の良き一員であろうとする。"}],"source":"egs","sourceCharacterId":"3527","sourceWorkId":"20303","spoiler":false},{"segments":[{"spoiler":false,"text":"重视纪律、无口无表情的少女"},{"spoiler":false,"text":"六庆馆学园2年级。担任风纪委员。"},{"spoiler":false,"text":"性格一本正经，对自己和别人都很严厉，经常让和她在一起的人感到喘不过气来。"},{"spoiler":false,"text":"重视纪律和统一，有着对违反了规定的规则的人一副极为苛刻的态度的倾向。"},{"spoiler":false,"text":"虽然按常理来说她一般是属于独行侠的类型，但她积极参加朗读会和清扫志愿者，是一个合格的良好市民。"},{"spoiler":false,"text":"「那是这个地方的规则、遵守是当然的。再荒谬的规则也是规则」"}],"source":"bangumi","sourceCharacterId":"14744"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2154b885716df663157eed29c75b2ef05aa1b358763ba9dbeeb417f723e7db3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/866f2fef394f39dadca31e68d0a2f80564fe2a96d53017cfa5380e632e928126.webp","width":101,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水口まつり","creatorId":"vndb:s879","sourcePersonId":"vndb:s879","canonicalEntityId":"vndb:s879","name":"水口 まつり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19385:14744:6380:1","source":"bangumi"}]},{"characterId":"char_c7819","characterName":"蒔羽 梨香","sourceIds":{"bangumi":[{"characterId":"14745","match":"exact-normalized-name-in-linked-work","subjectId":"19385"}],"egsCharacterIds":["3528"],"vndbCharacterId":"c7819"},"originalCharacterName":"蒔羽 梨香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"71"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first year student at Rokukeikan Academy and, by extension, Keisuke's kouhai. Rika also belongs to the same astronomy club as Kanae and him. Somewhat spoiled, a cry-baby, and sociable, she’s viewed as something like a mascot and beloved by her fellow classmates. She has a personality of an innocent girl with the heart and soul of a younger child which makes her the most vulnerable victim of the Game. While normally bright and enthusiastic, her cheerful demeanor is easily spoiled as she is often the target of teasing and mockery by Nemu. Her overemotional nature, prone to tantrums and tears, will give her the most difficulty in adjusting to the cruel and twisted trials of the Game."},{"spoiler":false,"text":"Edited from erogereview, MangaGamer and belucre's euphoria review"}],"source":"vndb","sourceCharacterId":"c7819"},{"segments":[{"spoiler":false,"text":"六恵館学園の１年生。"},{"spoiler":false,"text":"恵輔や叶と同じ天文学部に所属している。"},{"spoiler":false,"text":"恵輔の後を子犬のようについてまわり、放課後にはクラブに誘いに来るほど懐いている。"},{"spoiler":false,"text":"甘えん坊で、泣き虫で、人なつっこく、マスコット的存在として、同じ年のクラスメイトにも可愛がられている。"},{"spoiler":false,"text":"失敗をしても、「梨香ならしょうがないか」と何となく許されてしまう愛嬌の持ち主。"}],"source":"egs","sourceCharacterId":"3528","sourceWorkId":"20303","spoiler":false},{"segments":[{"spoiler":false,"text":"喜欢撒娇的爱哭虫后辈"},{"spoiler":false,"text":"六庆馆学园的1年级。和恵輔与叶一样从属于天文学部。"},{"spoiler":false,"text":"经常好像小狗一般跟在恵輔屁股后面转，放学后也跟着他出入天文学部。"},{"spoiler":false,"text":"喜欢撒娇，爱哭虫，喜欢亲近人，作为吉祥物般的存在，同学年的同学们也十分喜欢她。"},{"spoiler":false,"text":"即使失败也会被说「因为是梨香所以没办法」，不管做什么事都会被原谅的魅力的拥有者。"},{"spoiler":false,"text":"「前辈不会对梨香做粗暴的事吧？因为梨香对前辈…」"}],"source":"bangumi","sourceCharacterId":"14745"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f98f01c65c53042c14adacd52c5e656c2932ee0a19b57355e2ac46504710b3d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/5797630ccf95f16c6659bdee48fede412db64643d602b122ce112e9045111bb5.webp","width":133,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19385:14745:6016:1","source":"bangumi"}]},{"characterId":"char_c7821","characterName":"葵 菜月","sourceIds":{"bangumi":[{"characterId":"14746","match":"exact-normalized-name-in-linked-work","subjectId":"19385"}],"egsCharacterIds":["3529"],"vndbCharacterId":"c7821"},"originalCharacterName":"葵 菜月","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"105"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"I"},"height":{"reviewState":"no-conflict","source":"vndb","value":"171"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An English teacher recently appointed to Keisuke’s high school, Rokukeikan Academy. Her sympathetic and irresponsibly laidback personality coupled with her voluptuous mature body made her very popular with the student population. Natsuki’s selflessness is immediately made known when she willingly offered herself to Keisuke to ravage her, as she is the oldest person present there and an only sexually active woman participating in the Game. No matter what happens, she's trying her best to maintain her optimistic nature with her belief that everyone will survive the Game."},{"spoiler":false,"text":"Edited from erogereview and MangaGamer"}],"source":"vndb","sourceCharacterId":"c7821"},{"segments":[{"spoiler":false,"text":"今年六恵館学園に赴任してまもない英語教師。"},{"spoiler":false,"text":"３年生を担当している。"},{"spoiler":false,"text":"おっとりとして優しい性格の上、美人とあって、学生たちの人気は高い。"},{"spoiler":false,"text":"他の教師から、「教師としての威厳に欠けているから学生たちに舐められるのだ」と嫌味を言われることもあるが、あまり気にしていない。"},{"spoiler":false,"text":"割と何とでもなると思っているまったりオプティミスト。"}],"source":"egs","sourceCharacterId":"3529","sourceWorkId":"20303","spoiler":false},{"segments":[{"spoiler":false,"text":"性格大方温柔的受欢迎的老师"},{"spoiler":false,"text":"今年在六庆馆学园赴任的英语教师。3年级担当。"},{"spoiler":false,"text":"性格大方温柔的美人般的存在，非常受学生欢迎。"},{"spoiler":false,"text":"有时候也会被其他老师讽刺「缺乏作为老师的威严，经常和学生们在一起鬼混」，但本人不怎么介意。"},{"spoiler":false,"text":"抱着船到桥头自然直的态度的乐观主义者。"},{"spoiler":false,"text":"「好啦。这种事情，是不能让其他的孩子们去做的。所以呢、这就是老师的任务了」"}],"source":"bangumi","sourceCharacterId":"14746"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f471e04a8e22855eeee5c16786b7660f96f75ada6684a633b5070894e996c620.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c218a9b9f6afc4c6d19a67f7c1b5e87f573d647eaddf0dc88404036055306aab.webp","width":89,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19385:14746:6359:1","source":"bangumi"}]},{"characterId":"char_c7822","characterName":"安藤 都子","sourceIds":{"bangumi":[{"characterId":"14747","match":"exact-normalized-name-in-linked-work","subjectId":"19385"}],"egsCharacterIds":["3530"],"vndbCharacterId":"c7822"},"originalCharacterName":"安藤 都子","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Miyako, a second year student at Rokukeikan Academy and Keisuke's classmate, is the no nonsense Classroom Representative with a perfect grade point average and high aspirations for the future. She holds steady to her convictions and refuses to compromise when the rules of the Game are explained."},{"spoiler":false,"text":"Edited from erogereview and MangaGamer"}],"source":"vndb","sourceCharacterId":"c7822"},{"segments":[{"spoiler":false,"text":"六恵館学園の２年生。"},{"spoiler":false,"text":"恵輔のクラスメイトで、クラス委員長を務めている。"},{"spoiler":false,"text":"しっかり者で、非常に真面目な少女。"},{"spoiler":false,"text":"その厳しさから不真面目な生徒には疎まれがちだが、心の底から嫌っている人間はいない。"},{"spoiler":false,"text":"みんなの頼れる委員長。"},{"spoiler":false,"text":"極限状態にあってはその性格が災いし、ゲームの参加資格を喪失。ゲームから除外される。"}],"source":"egs","sourceCharacterId":"3530","sourceWorkId":"20303","spoiler":false},{"segments":[{"spoiler":false,"text":"性格死板的委员长"},{"spoiler":false,"text":"六庆馆学园2年级。"},{"spoiler":false,"text":"恵輔的同班同学，担任班委员长。"},{"spoiler":false,"text":"性格死板，非常认真的少女。"},{"spoiler":false,"text":"被大家所信赖的委员长。"},{"spoiler":false,"text":"虽然因为她的死板严厉学生们都对她敬而远之，但打心底讨厌她的人却没有。"},{"spoiler":false,"text":"在极限状态时因为性格使然，丧失了参加游戏的资格。被从游戏中除外了。"},{"spoiler":false,"text":"「别再说这种无聊的事情了，快让我们从这里出去！听到没有！？你知道吗？这可是犯罪！」"}],"source":"bangumi","sourceCharacterId":"14747"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5ed179b30658046f5a3569893539b37c38562519721ddf763ee37949e55c39e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/673a4e8c22120b24a085b90609943e2786cc76349de5f3a63bf675274e373ccc.webp","width":88,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平山ゆかり","creatorId":"vndb:s285","sourcePersonId":"vndb:s285","canonicalEntityId":"vndb:s285","name":"東かりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:19385:14747:5905:1","source":"bangumi"}]},{"characterId":"char_vndb_c43551","characterName":"高遠 恵輔","sourceIds":{"vndbCharacterId":"c43551"},"originalCharacterName":"高遠 恵輔","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A solemn young man who is trying his hardest to maintain a happy, average life in order to hide his deeply sadistic side. While he has a kind of a stoic nature on the outside, inside he is filled with conflicting and dark emotions, his passion for abuse and torture that bring him inescapable shame as well as pleasure. If it weren't for these hidden desires of his, he'd be considered just another unlucky and unfortunate victim of the Game. But despite having a hard battle to subdue these inner feelings, he is still giving his best in order to protect and save all of his loved ones before anything else. Nemu perfectly describes him as “an odd man, excited to watch girls tortured yet trying to save the very same girls from death, even at the cost of his life”. The Game will serve as a perfect test to his mental strength and endurance. A choice on whether he will let himself succumb to his inner beastly desires or whether he will persevere long enough to find a way out of this hellish nightmare shall be left to no one else but him to decide."},{"spoiler":false,"text":"Edited from permagate's euphoria review and belucre's euphoria review"}],"source":"vndb","sourceCharacterId":"c43551"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/410cd87cbcf9b87b6ced2ee9a6b8e08d5712a2dadbc849ff47566eb3f70b6948.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5c4733ababb48a65dabb3c2ebc4e3a485f772452ebe950438ae353d33465974.webp","width":218,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p200","sourceCompanyId":"egs:brand:724","canonicalEntityId":"vndb:p200","name":"CLOCKUP","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:15010:724","source":"egs"},{"companyId":"vndb:p18672","sourceCompanyId":"vndb:p18672","canonicalEntityId":"vndb:p18672","name":"iqdhk8t0hxww","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:121416:v6540","source":"vndb"},{"companyId":"vndb:p428","sourceCompanyId":"vndb:p428","canonicalEntityId":"vndb:p428","name":"MangaGamer","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:121799:v6540","source":"vndb"},{"companyId":"vndb:p7446","sourceCompanyId":"vndb:p7446","canonicalEntityId":"vndb:p7446","name":"Otorhin","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:144792:v6540","source":"vndb"},{"companyId":"vndb:p24514","sourceCompanyId":"vndb:p24514","canonicalEntityId":"vndb:p24514","name":"Kuroneko Hashimoto","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:150235:v6540","source":"vndb"},{"companyId":"vndb:p200","sourceCompanyId":"