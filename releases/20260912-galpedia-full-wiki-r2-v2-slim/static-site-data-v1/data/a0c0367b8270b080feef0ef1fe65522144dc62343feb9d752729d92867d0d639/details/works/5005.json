rsonId":"vndb:s32210","canonicalEntityId":"vndb:s32210","name":"東京俳優生活協同組合","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:22890","source":"vndb"},{"creditedName":"松浦 幸治","creatorId":"vndb:s47878","sourcePersonId":"vndb:s47878","canonicalEntityId":"vndb:s47878","name":"松浦 幸治","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:22892","source":"vndb"},{"creditedName":"松浦 幸治","creatorId":"vndb:s47878","sourcePersonId":"vndb:s47878","canonicalEntityId":"vndb:s47878","name":"松浦 幸治","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:22893","source":"vndb"}]},"cast":[{"characterId":"char_c72787","characterName":"エリンシエ・ヤースロップ","sourceIds":{"bangumi":[],"egsCharacterIds":["11975"],"vndbCharacterId":"c72787"},"originalCharacterName":"エリンシエ・ヤースロップ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"143"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"帝国ジュニアアカデミー第一学年所属。"},{"spoiler":false,"text":"空中王国ネオスフィアからの留学生。元ネオスフィアの女王。"},{"spoiler":false,"text":"現在は女王位から退き、帝国の先進技術や文化を学びにはるばる帝都までやってきた。"},{"spoiler":false,"text":"しかしそれは表向きであり、さる事件がもとで帝国に政治的に睨まれたネオスフィア王国が、恭順の意を示すため差し出した実質的な人質である。"},{"spoiler":false,"text":"女王位を退いて今なお、その言動は国外政治に与える影響が小さくなく、そのため行動は常に帝国政府の監視下に置かれている。"},{"spoiler":false,"text":"女王時代は英明の名をほしいままにした天才君主だったが、帝都に来てからは、年相応の子供っぽいきかんきな言動や、とっぴな行動が目立つ。"},{"spoiler":false,"text":"また反帝国的な態度を隠そうともしないため、帝国人の生徒と衝突することも多い。"},{"spoiler":false,"text":"その一方で、元女王という特殊な経歴、異様に高い知能指数、周囲に媚びない様子に共感を覚えた男子生徒たちに間で隠れファンクラブが結成されている。"}],"source":"egs","sourceCharacterId":"11975","sourceWorkId":"13845","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/charac