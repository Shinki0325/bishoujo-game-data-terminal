e":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真鈴ヶ崎純真学園の二年生。"},{"spoiler":false,"text":"子供の頃から昆虫が大好きで、それに関する知識も豊富。"},{"spoiler":false,"text":"学校が帰りに見たこともない虫（蟲）を発見したことがきっかけで、それが消えた先の池添薬品会社へと何度も忍び込むこととなる。"},{"spoiler":false,"text":"やがて、工場には地下室があることを突き止める。"},{"spoiler":false,"text":"「あたし、今まで読んだ図鑑の虫、全部覚えてるんだからっ！」"}],"source":"egs","sourceCharacterId":"5678","sourceWorkId":"17256","spoiler":false},{"segments":[{"spoiler":false,"text":"真鈴ヶ崎純真学園の二年生。 明るく行動力のある性格。"},{"spoiler":false,"text":"いつも一緒にいる親友の栞奈は一歳年下の幼なじみ。"},{"spoiler":false,"text":"幼い頃に父が買ってくれた鈴虫がキッカケで、昆虫が大好きになる。"},{"spoiler":false,"text":"虫に関する知識は豊富で、それは新種の虫にも気付けるほど。"}],"source":"bangumi","sourceCharacterId":"93043"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/9723bb46a320fd4a287313f26a2ef26042de8779b2a4b6445f7412439b9bdc02.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c29d8df032e7b4a57573e4116173e7e3521005d77eaf6782d8bdbf08ee75fcfb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平山ゆかり","creatorId":"vndb:s285","sourcePersonId":"vndb:s285","canonicalEntityId":"vndb:s285","name":"東かりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61818:93043:5905:1","source":"bangumi"}]},{"characterId":"char_c33762","characterName":"林 栞奈","sourceIds":{"bangumi":[{"characterId":"93044","match":"exact-normalized-name-in-linked-work","subjectId":"61818"}],"egsCharacterIds":["5679"],"vndbCharacterId":"c33762"},"originalCharacterName":"林 栞奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"瑠璃の一つ年下で真鈴ヶ崎純真学園の一年生。"},{"spoiler":false,"text":"虫は大の苦手。"},{"spoiler":false,"text":"瑠璃が工場に忍び込んでいることを知り、何とかそれをやめさせようとする。"},{"spoiler":false,"text":"しかし、なし崩し的に自分も忍び込むはめになってしまい、工場に地下の秘密を知ってしまう……。"},{"spoiler":false,"text":"「む、虫に触るなんて絶対無理だよぉ」"}],"source":"egs","sourceCharacterId":"5679","sourceWorkId":"17256","spoiler":false},{"segments":[{"spoiler":false,"text":"真鈴ヶ崎純真学園の一年生で、親友の瑠璃とは違い虫のことは大の苦手。"},{"spoiler":false,"text":"気が弱いところもあるが、瑠璃とは幼い頃から仲良くしている。"},{"spoiler":false,"text":"瑠璃にお願いされて、製薬工場の捜索にも付き合うこととなるが……。"}],"source":"bangumi","sourceCharacterId":"93044"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fae00dbe0f7b92d147e35c88ec5247115d4fbee098b0bb651cf9c6e75a12ce18.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a42f0bc60145e7f14a94adff0ec1a03fd6ca5eee415be6ce0d2a049376fe75a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61818:93044:6351:1","source":"bangumi"}]},{"characterId":"char_c33763","characterName":"池添 雅美","sourceIds":{"bangumi":[{"characterId":"93046","match":"exact-normalized-name-in-linked-work","subjectId":"61818"}],"egsCharacterIds":["5681"],"vndbCharacterId":"c33763"},"originalCharacterName":"池添 雅美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"夫である清彦とは対照的に、とても評判の良い妻。"},{"spoiler":false,"text":"誰にでも分け隔てなく優しく接する性格をしている。"},{"spoiler":false,"text":"「いいのよ。でも、暗くなる前におうちに帰ったほうがいいと思うわ」"}],"source":"egs","sourceCharacterId":"5681","sourceWorkId":"17256","spoiler":false},{"segments":[{"spoiler":false,"text":"夫である清彦とは対照的に、とても評判の良い妻。"},{"spoiler":false,"text":"誰にでも分け隔てなく優しく接している。"}],"source":"bangumi","sourceCharacterId":"93046"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab75a53f8546f1cea6dd6a8fe9abd4e60062ed91b03bb009216bf89e952dae5a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1dd618dfea1b78342f2eb72e4ef0986e21c25964ce7b6156316ba027690e568c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:61818:93046:4940:1","source":"bangumi"}]},{"characterId":"char_c33764","characterName":"櫻井 夢美","sourceIds":{"bangumi":[{"characterId":"93047","match":"exact-normalized-name-in-linked-work","subjectId":"61818"}],"egsCharacterIds":["5682"],"vndbCharacterId":"c33764"},"originalCharacterName":"櫻井 夢美","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真鈴ヶ崎統華大学の学生。"},{"spoiler":false,"text":"瑠璃達より年齢は上。"},{"spoiler":false,"text":"喫茶店ＡｎｚＵの店長代理でもある。"},{"spoiler":false,"text":"「……二人ともほどほどにね」"}],"source":"egs","sourceCharacterId":"5682","sourceWorkId":"17256","spoiler":false},{"segments":[{"spoiler":false,"text":"瑠璃と栞奈がよく行く喫茶店 『AnzU』 の店長代理。"},{"spoiler":false,"text":"年上のお姉さんといった立場で、瑠璃の相談に乗ってくれたりする。"}],"source":"bangumi","sourceCharacterId":"93047"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d524317b6cf7d066ed0087ce0ce3ff139d081860a9dabe9cfe754a842b56cb8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3bfd42901ac98057a1c