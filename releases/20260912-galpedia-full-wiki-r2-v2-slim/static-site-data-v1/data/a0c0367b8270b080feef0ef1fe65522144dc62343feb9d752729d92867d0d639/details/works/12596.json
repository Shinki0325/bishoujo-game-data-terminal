e03c6a50a77222e96084e3bcd6ea49d2ba2fba1fe2cf0fb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13444:57564:5906:1","source":"bangumi"}]},{"characterId":"char_c40069","characterName":"エミリア・M・ゴトフリート","sourceIds":{"bangumi":[{"characterId":"57565","match":"exact-normalized-name-in-linked-work","subjectId":"13444"}],"egsCharacterIds":["568"],"vndbCharacterId":"c40069"},"originalCharacterName":"エミリア・M・ゴトフリート","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【蔵の町の外人娘】"},{"spoiler":false,"text":"紅殻町の蔵町の座敷蔵に寄宿している、外国人の娘。"},{"spoiler":false,"text":"容姿端麗、成績優秀、きつめの顔立ちながら、性格は生真面目で人を信じやすいお人好し。"},{"spoiler":false,"text":"『日本の文化を学びに留学した』と言い張っているのが、生国のことになると何故か口数が少なくなる。"},{"spoiler":false,"text":"文化のギャップのせいか色々ととんちんかんな事をしでかすことも多い。"},{"spoiler":false,"text":"街中のうるさ方から目を付けられ、出物腫れ物のように扱われているため、周囲から孤立しがち。おかげでけっこう寂しがり。"},{"spoiler":false,"text":"実家は裕福な貿易商であり、紅殻町の珍奇物品を買い付けたりもしている……らしい。"}],"source":"egs","sourceCharacterId":"568","sourceWorkId":"12596","spoiler":false},{"segments":[{"spoiler":false,"text":"紅殻町の蔵町の座敷蔵に寄宿している、外国人の娘。"},{"spoiler":false,"text":"容姿端麗、成績優秀、きつめの顔立ちながら、性格は生真面目で実は人を信じやすいお人好し。"},{"spoiler":false,"text":"『日本の文化を学びに留学した』と言い張っているのが、生国のことになると何故か口数が少なくなる。"},{"spoiler":false,"text":"文化のギャップのせいか色々ととんちんかんな事をしでかすことも多い。街中のうるさ方から目を付けられ、出物腫れ物を扱うように接っされているため、周囲から孤立しがち。おかげでけっこう寂しがり。"},{"spoiler":false,"text":"実家は裕福な貿易商であり、紅殻町の珍奇物品を買い付けたりもしている……らしい。"}],"source":"bangumi","sourceCharacterId":"57565"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5b01b395d999e650781017c98d2c000c8ebebc03d72ba8fafed26e7056e7b4a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b37486e37fa926c76cac1e47fb602c65dfb6a432a6921195bc4e45083f131cb1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雪野梨沙","creatorId":"vndb:s1610","sourcePersonId":"vndb:s1610","canonicalEntityId":"vndb:s1610","name":"雪野 梨沙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13444:57565:5903:1","source":"bangumi"}]},{"characterId":"char_c40072","characterName":"人見 十湖","sourceIds":{"bangumi":[{"characterId":"57567","match":"exact-normalized-name-in-linked-work","subjectId":"13444"}],"egsCharacterIds":["570"],"vndbCharacterId":"c40072"},"originalCharacterName":"人見 十湖","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【探検家の娘】"},{"spoiler":false,"text":"探検家を自称する女。"},{"spoiler":false,"text":"帰省途中の主人公と同じ汽車に乗り合わせ、そのまま紅殻町まで（勝手に）ついてきてしまった。"},{"spoiler":false,"text":"主人公の調査中も何かと彼についてまわり、困惑させる。"},{"spoiler":false,"text":"性格は豪放磊落。よく笑いよく食らいよく呑む。"},{"spoiler":false,"text":"単純バカなのではなく、幾度もの修羅場をかいくぐり、世の中の色々な出来事を見てきてなお倦まず、いい感じにさばけてきている。"}],"source":"egs","sourceCharacterId":"570","sourceWorkId":"12596","spoiler":false},{"segments":[{"spoiler":false,"text":"探検家を自称する女。帰省途中の主人公と同じ汽車に乗り合わせ、そのまま紅殻町まで（勝手に）ついてきてしまった。"},{"spoiler":false,"text":"主人公の調査中も何かと彼についてまわり、困惑させる。"},{"spoiler":false,"text":"性格は豪放磊落。よく笑いよく食らいよく呑む。単純バカなのではなく、幾度もの修羅場をかいくぐり、世の中の色々な出来事を見てきてなお倦まず、いい感じにさばけてきている。"}],"source":"bangumi","sourceCharacterId":"57567"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c38b5652b1ca6798e8bfaf4204f2c9975270f1bb43bdf3ef2061c65da1b187f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53dc411edae7b2ba486165399885fcc217180ac55819931ba0a9b8f43bd9903f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"栗原雅子","creatorId":"vndb:s298","sourcePersonId":"vndb:s298","canonicalEntityId":"vndb:s298","name":"野月 まひる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:13444:57567:6570:1","source":"bangumi"}]},{"characterId":"char_c40074","characterName":"宮里 智久","sourceIds":{"bangumi":[{"characterId":"57563","match":"exact-normalized-name-in-linked-work","subjectId":"13444"}],"egsCharacterIds":["571"],"vndbCharacterId":"c40074"},"originalCharacterName":"宮里 智久","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公。大学三回生。文系。学芸員志望。とりたてて取り柄のない青年ではあり、本人もそれを自覚しているのだが、本当は奇妙なモノに惹かれる性癖と、それらへの高い親和性を示す。"},{"spoiler":false,"text":"物事に対しては冷静であろうと務め、意志力もそれなりに強い。だがそれは裏返せば、想定外の事態には狼狽えやすく、物分かり悪く頑固である、ということでもある。"},{"spoiler":false,"text":"そして実は結構涙もろい。感情の琴線に触れる事があると、我慢しきれず涙を漏らしてしまうこともしばしばだ。"}],"source":"egs","sourceCharacterId":"571"},{"segments":[{"spoiler":false,"text":"主人公。大学三回生。文系。学芸員志望。とりたてて取り柄のない青年ではあり、本人もそれを自覚しているのだが、本当は奇妙なモノに惹かれる性癖と、それらへの高い親和性を示す。"},{"spoiler":false,"text":"物事に対しては冷静であろうと務め、意志力もそれなりに強い。だがそれは裏返せば、想定外の事態には狼狽えやすく、物分かり悪く頑固である、ということでもある。"},{"spoiler":false,"text":"そして実は結構涙もろい。感情の琴線に触れる事があると、我慢しきれず涙を漏らしてしまうこともしばしばだ。"}],"source":"bangumi","sourceCharacterId":"57563"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/071c0a1511426b54e44551cc77dacab290a1c9b5fec7e6e35e506b4c372bbc3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1d441e2e4fedcff44f55c5b7c848b552b1550