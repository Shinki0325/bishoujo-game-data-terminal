{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"22610","model":{"presentationWorkId":"vndb:v18368","staff":{"artwork":[{"creditedName":"の歯","creatorId":"vndb:s4279","sourcePersonId":"egs:creator:17731","canonicalEntityId":"vndb:s4279","name":"の歯","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:157670","source":"egs"},{"creditedName":"バイオレットシット","creatorId":"vndb:s4611","sourcePersonId":"egs:creator:18368","canonicalEntityId":"vndb:s4611","name":"バイオレットシット","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:157671","source":"egs"},{"creditedName":"ひなづか凉(桜路ひよこ)","creatorId":"vndb:s6786","sourcePersonId":"egs:creator:25527","canonicalEntityId":"vndb:s6786","name":"ひなづか凉(桜路ひよこ)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:157693","source":"egs"},{"creditedName":"あしもと☆よいか","creatorId":"vndb:s6787","sourcePersonId":"egs:creator:25528","canonicalEntityId":"vndb:s6787","name":"あしもと☆よいか","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:157694","source":"egs"},{"creditedName":"kanata","creatorId":"vndb:s6788","sourcePersonId":"egs:creator:25529","canonicalEntityId":"vndb:s6788","name":"kanata","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:157695","source":"egs"},{"creditedName":"八嶋 テツヤ","creatorId":"vndb:s3593","sourcePersonId":"vndb:s3593","canonicalEntityId":"vndb:s3593","name":"八嶋 テツヤ","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:124931","source":"vndb"}],"scenario":[{"creditedName":"灰猫(灰田てん、灰田恬)","creatorId":"vndb:s3938","sourcePersonId":"egs:creator:3770","canonicalEntityId":"vndb:s3938","name":"灰猫(灰田てん、灰田恬)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:157672","source":"egs"},{"creditedName":"藤枝卓也","creatorId":"vndb:s4759","sourcePersonId":"egs:creator:12673","canonicalEntityId":"vndb:s4759","name":"藤枝卓也","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:157673","source":"egs"},{"creditedName":"霧島へるん","creatorId":"vndb:s5202","sourcePersonId":"egs:creator:12963","canonicalEntityId":"vndb:s5202","name":"霧島へるん","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:157674","source":"egs"},{"creditedName":"かいだるい","creatorId":"vndb:s4283","sourcePersonId":"egs:creator:17826","canonicalEntityId":"vndb:s4283","name":"かいだるい","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:157675","source":"egs"},{"creditedName":"佐藤四十六杯","creatorId":"vndb:s7628","sourcePersonId":"egs:creator:21733","canonicalEntityId":"vndb:s7628","name":"佐藤四十六杯","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:157676","source":"egs"},{"creditedName":"可動命","creatorId":"vndb:s6790","sourcePersonId":"egs:creator:21737","canonicalEntityId":"vndb:s6790","name":"可動命","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:157677","source":"egs"},{"creditedName":"臼場影郎","creatorId":"vndb:s6789","sourcePersonId":"egs:creator:25530","canonicalEntityId":"vndb:s6789","name":"臼場影郎","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:157696","source":"egs"},{"creditedName":"空蝉座","creatorId":"vndb:s3594","sourcePersonId":"vndb:s3594","canonicalEntityId":"vndb:s3594","name":"空蝉座","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:124932","source":"vndb"}],"music":[],"other":[]},"cast":[{"characterId":"char_c38041","characterName":"舞野 由可利","sourceIds":{"bangumi":[{"characterId":"47279","match":"exact-normalized-name-in-linked-work","subjectId":"194759"}],"egsCharacterIds":["7201"],"vndbCharacterId":"c38041"},"originalCharacterName":"舞野 由可利","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A high school student one grade above Momoka and the village chief's daughter."},{"spoiler":false,"text":"She's serious and courteous, often a leader among the villager's youngsters. Well aware of her own position as the village chief's daughter, she feels like she has to do her best more than anyone else."},{"spoiler":false,"text":"As a result, there is no one in the surroundings who can spoil her and she secretly wants to be spoiled."},{"spoiler":false,"text":"Yukari loves animals so she would like to become a veterinarian in the future. Although she doesn't hate the village, she would like to see the world outside."}],"source":"vndb","sourceCharacterId":"c38041"},{"segments":[{"spoiler":false,"text":"真面目な性格で、礼儀正しく、村の若者たちの中でもリーダー役になることが多い。村長の娘という立場をわかっているので、人一倍しっかりしなければという気持ちを持っている。"},{"spoiler":false,"text":"その実、周囲に甘える相手がいない事もあって、誰かに甘えたいという気持ちを内に秘めている。"},{"spoiler":false,"text":"動物が好きで、将来は獣医になりたいと考えている。"},{"spoiler":false,"text":"村が嫌いなわけでは無いけれども、一度村を出てみたいとも思っている。"}],"source":"egs","sourceCharacterId":"7201","sourceWorkId":"22610","spoiler":false},{"segments":[{"spoiler":false,"text":"村長の一人娘で、妹・百花の 1つ先輩の女子校生。"},{"spoiler":false,"text":"まじめな性格で礼儀正しく、村の若者たちの中でもリーダー役になることが多い。"},{"spoiler":false,"text":"村長の娘という立場を分かっており、人一倍しっかりしなければという気持ちがある。"},{"spoiler":false,"text":"一方で、甘えられる相手がおらず、誰かに甘えたいという気持ちを内に秘めている。"},{"spoiler":false,"text":"動物が好きで、将来は獣医になりたいと考えている。"},{"spoiler":false,"text":"村が嫌いというわけではないが、一度村を出てみたいとも思っている。"},{"spoiler":false,"text":"「ここにいる間だけでもいいので、また家庭教師をしてください」"}],"source":"bangumi","sourceCharacterId":"47279"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f787c84f88f86109f65d60411c43ff60466e7a839063bbae3726f72609bd323e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c0bf4b5ba3ac3fcbc5268f8157f54f6cd15eb9588514342b5ac9ec2b6bdd529.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中茉理花","creatorId":"vndb:s2571","sourcePersonId":"vndb:s2571","canonicalEntityId":"vndb:s2571","name":"田中 茉理花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:194759:47279:15994:1","source":"bangumi"}]},{"characterId":"char_c38042","characterName":"都築 百花","sourceIds":{"bangumi":[{"characterId":"47280","match":"exact-normalized-name-in-linked-work","subjectId":"194759"}],"egsCharacterIds":["7202"],"vndbCharacterId":"c38042"},"originalCharacterName":"都築 百花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A high school student and satoshi's little sister who's younger than him by several years. She has a bright personality who doesn't shy away from anyone, getting along with pretty much everyone is her specialty."},{"spoiler":false,"text":"Momoka was invited by their parents to join the overseas trip, but she refused."},{"spoiler":false,"text":"However, the house was too large for her all alone so she's borrowing a detached room at an inn, and is helping out in the inn whenever she has time."},{"spoiler":false,"text":"Although she hasn't decided on her future plans, she wants to live together with Satoshi."}],"source":"vndb","sourceCharacterId":"c38042"},{"segments":[{"spoiler":false,"text":"智司とは少し歳の離れた妹。"},{"spoiler":false,"text":"明るく人見知りしない性格。"},{"spoiler":false,"text":"特技は大抵の人とはすぐに仲良くなれること。"},{"spoiler":false,"text":"両親から海外旅行に誘われたが、それを断って一人で村に残った。"},{"spoiler":false,"text":"しかし実家に一人は広すぎるので、現在は旅館の離れを借りて暮らしていて、時間がある時は旅館の手伝いをしたりしている。"},{"spoiler":false,"text":"進路などは具体的には決めていないが、智司と一緒に暮らしたいと考えている。"}],"source":"egs","sourceCharacterId":"7202","sourceWorkId":"22610","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・智司とは少し歳の離れた妹。"},{"spoiler":false,"text":"明るく人見知りしない性格で、大抵の人とはすぐに仲良くなれる。"},{"spoiler":false,"text":"両親から海外旅行に誘われたが、それを断って一人で村に残った。"},{"spoiler":false,"text":"現在は旅館の離れを借りて暮らしていて、時間がある時は旅館の手伝いをしている。"},{"spoiler":false,"text":"進路などは具体的には決めていないが、智司と一緒に暮らしたいと考えている。"},{"spoiler":false,"text":"「こうしてお兄ちゃんと一緒にいられるから、毎日幸せだよ」"}],"source":"bangumi","sourceCharacterId":"47280"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7df08fc4156f6ca8df81535f5184930746470ebd3c975df17d68ec0953ae87db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2eebba4a03ca4b5592c6e577ed704ee304df70fd2da96152e426af9f29656a22.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"八幡七味","creatorId":"vndb:s1988","sourcePersonId":"vndb:s1988","canonicalEntityId":"vndb:s1988","name":"八幡 七味","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:194759:47280:21494:1","source":"bangumi"}]},{"characterId":"char_c38043","characterName":"鳴瀬 亜美","sourceIds":{"bangumi":[{"characterId":"47281","match":"exact-normalized-name-in-linked-work","subjectId":"194759"}],"egsCharacterIds":["7203"],"vndbCharacterId":"c38043"},"originalCharacterName":"鳴瀬 亜美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A high school student in the same year as Momoka."},{"spoiler":false,"text":"Ami is living together with five of her relatives her mother, little brother and little sister, as well her grandparents from the mother's side. Her mother has a weak body so she isn't only able to work part-time. As a result, they aren't too wealthy and have to live very humbly."},{"spoiler":false,"text":"Several times a week Ami works part-time outside of the village to add onto family finances. Thanks to that, and thanks to the things they receive from neighbor farmers they are able to make a living."},{"spoiler":false,"text":"Ami has no intention of leaving the village, she's planning to live together and take care of her grandparents and her mother."},{"spoiler":false,"text":"But actually she loves reading and would like to become either a translator or a proofreader, but due to the family situation she can't really concentrate on studying... and feels uneasy as a result."}],"source":"vndb","sourceCharacterId":"c38043"},{"segments":[{"spoiler":false,"text":"母、弟、妹、母の両親との5人暮らし。母はあまり身体の強いほうでは無いため、フルで働くのは難しく、パートで働いている"},{"spoiler":false,"text":"そのため、あまり裕福とは言えず、生活は質素。"},{"spoiler":false,"text":"。"},{"spoiler":false,"text":"週に数回、村の外にバイトに出て働き、家計の足しにしている。"},{"spoiler":false,"text":"それらの稼ぎと、周囲の農家からの頂き物で暮らしている。"},{"spoiler":false,"text":"村を出るつもりはなく、将来は祖父母や親の面倒を見ながら暮らしたいと思っている。"},{"spoiler":false,"text":"実は読書家で、将来は翻訳や校正の仕事をしたいと思っているが、現状のままではその勉強をする事もままならないのでは……と不安を抱いている。"}],"source":"egs","sourceCharacterId":"7203","sourceWorkId":"22610","spoiler":false},{"segments":[{"spoiler":false,"text":"百花の同級生。 母・弟・妹、母の両親との 6人暮らし。"},{"spoiler":false,"text":"母は身体が強いほうではないため、パートで働いている。"},{"spoiler":false,"text":"そこで亜美も村の外でバイトに励み、その稼ぎと農家からの頂き物で暮らしている。"},{"spoiler":false,"text":"村を出るつもりはなく、将来は祖父母や親の面倒を見ながら暮らしたいと思っている。"},{"spoiler":false,"text":"実は読書家で、将来は翻訳や校正の仕事をしたいと思っているが、"},{"spoiler":false,"text":"現状のままではその勉強をすることもままならないのではと不安を抱いている。"},{"spoiler":false,"text":"「わ、私は別にどっちでもいいんだけど…… やることないなら、ちょっと手伝ってよ」"}],"source":"bangumi","sourceCharacterId":"47281"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/049a7e1eb82403f525b277599fdfcbbe30895e9380be7e77009841ff50d4f3a9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/7143801b646d5dc4c3d8501e8c049a7c0730307f9767615b90658fae7c6c0036.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:194759:47281:4490:1","source":"bangumi"}]},{"characterId":"char_c38044","characterName":"橘 千里","sourceIds":{"bangumi":[{"characterId":"47283","match":"exact-normalized-name-in-linked-work","subjectId":"194759"}],"egsCharacterIds":["7205"],"vndbCharacterId":"c38044"},"originalCharacterName":"橘 千里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A nurse."},{"spoiler":false,"text":"She works at an infirmary ran by an elderly couple. Chisato doesn't come from the village, she herself has chosen to come a village lacking people with medical qualifications. Her responsible personality doesn't allow her to ignore people in trouble, and being very bright person who gets along with people well, she immediately got used to the village."},{"spoiler":false,"text":"In the elderly doctor's stead she does home visits to nurse people in the village. She wishes the village's medical equipment was improved."},{"spoiler":false,"text":"Since she has come to the village after Satoshi left, she isn't acquainted with him."}],"source":"vndb","sourceCharacterId":"c38044"},{"segments":[{"spoiler":false,"text":"老夫婦の医師が運営している村の診療所で働いている。"},{"spoiler":false,"text":"村の出身ではなく、医療関係者の少ないこの村に自ら志願してやってきた。責任感が強く、困っている人を放っておけない性格。"},{"spoiler":false,"text":"明るくて人当たりが良い性格で、村にもすぐに馴染んだ。"},{"spoiler":false,"text":"老齢の先生に代わって、村中の訪問看護を行っている。"},{"spoiler":false,"text":"村の医療設備の充実を願っている。"},{"spoiler":false,"text":"智司が村を出てからやってきた為、智司とは面識がない。"}],"source":"egs","sourceCharacterId":"7205","sourceWorkId":"22610","spoiler":false},{"segments":[{"spoiler":false,"text":"老夫婦が運営している村の診療所で働いている看護師。"},{"spoiler":false,"text":"責任感が強く、困っている人を放っておけない性格。"},{"spoiler":false,"text":"明るくて人当たりが良く、村にもすぐに馴染んだ。"},{"spoiler":false,"text":"村の出身ではなく、医療関係者の少ないこの村に自ら志願してやってきた。"},{"spoiler":false,"text":"現在は老齢の先生に代わって、村中の訪問看護を行っている。"},{"spoiler":false,"text":"智司が村を出てからやってきたので、智司とは面識がない。"},{"spoiler":false,"text":"「実は私も、こっちに来たてのころは似たような感じだったんですよ？」"}],"source":"bangumi","sourceCharacterId":"47283"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f9b8079a63831ba5be985eb83142bde780bd34d35921de3dad160e7a76e0c52.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/735d438c172df99e0cf15ec0dc05bce1d02f307c6d16f7fd363620e38942c103.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:194759:47283:6351:1","source":"bangumi"}]},{"characterId":"char_c38045","characterName":"森園 梨帆","sourceIds":{"bangumi":[{"characterId":"47284","match":"exact-normalized-name-in-linked-work","subjectId":"194759"}],"egsCharacterIds":["7206"],"vndbCharacterId":"c38045"},"originalCharacterName":"森園 梨帆","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An university student."},{"spoiler":false,"text":"Just like Satoshi, Riho is a botanist, normally she appears to be very absentminded, but she can be very active when doing things she loves. Using the summer vacation she has come to the countryside to look for unusual plants."},{"spoiler":false,"text":"She quite likes this village because the nature in it and in the surroundings is intact."},{"spoiler":false,"text":"Although she does attend to the same university as Satoshi, the two weren't acquainted before. Now that both stay at the same inn and both study plants, they have come to talk often."},{"spoiler":false,"text":"She loves liquor (and is strong drinker)."}],"source":"vndb","sourceCharacterId":"c38045"},{"segments":[{"spoiler":false,"text":"智司と同じように植物の研究をしている。"},{"spoiler":false,"text":"普段はぼんやりした印象なのだが好きな事に対しては行動的。"},{"spoiler":false,"text":"夏休みを利用して田舎へ珍しい花の観察にきた。"},{"spoiler":false,"text":"手つかずの自然が多いこの村をかなり気に入る。"},{"spoiler":false,"text":"智司と同じ大学へ通っているのだが、これまでお互いのことは知らずにいた。同じ旅館に泊まっていて、同じように植物の観察をしていた事から、話をするようになる。"},{"spoiler":false,"text":"お酒が好き（強い）"}],"source":"egs","sourceCharacterId":"7206","sourceWorkId":"22610","spoiler":false},{"segments":[{"spoiler":false,"text":"智司と同じように植物の研究をしている大学生。"},{"spoiler":false,"text":"夏休みを利用して、田舎へ珍しい花の観察に来た。"},{"spoiler":false,"text":"普段はぼんやりした印象だが、好きなことに対しては行動的。 お酒が好き（強い）。"},{"spoiler":false,"text":"智司と同じ大学へ通っているが、これまでお互いのことは知らずにいた。"},{"spoiler":false,"text":"同じ旅館に泊まり、同じように植物の観察をしていたことから話をするようになる。"},{"spoiler":false,"text":"手つかずの自然が多いこの村をかなり気に入っている様子。"},{"spoiler":false,"text":"「珍しいお花の話を肴にして、一緒に飲みましょ？」"}],"source":"bangumi","sourceCharacterId":"47284"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54c917bff78ba1a67663ca40258e0a3e002044a8049bb4785bd28920ffa73935.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8aa9cf54fe8cacc30df824c620b6c36ea4bfecac28ad9c5f50d3e99f3b6ebb7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平山ゆかり","creatorId":"vndb:s285","sourcePersonId":"vndb:s285","canonicalEntityId":"vndb:s285","name":"東かりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:194759:47284:5905:1","source":"bangumi"}]},{"characterId":"char_c38046","characterName":"小御門 良子","sourceIds":{"bangumi":[{"characterId":"47285","match":"exact-normalized-name-in-linked-work","subjectId":"194759"}],"egsCharacterIds":["7207"],"vndbCharacterId":"c38046"},"originalCharacterName":"小御門 良子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An Inn's young okami and a widow."},{"spoiler":false,"text":"Ryouko used to manage an inn together with her husband, but ever since he died she had to do it all alone. When working, she's firm and reliable, but when she's off she acts very leisurely."},{"spoiler":false,"text":"She and Satoshi are in similar age and they used to be like siblings, with Ryouko being the older sister. She has a meddling and busybody personality."},{"spoiler":false,"text":"Her getting married and becoming a widow, have both happened when Satoshi was away from the village."}],"source":"vndb","sourceCharacterId":"c38046"},{"segments":[{"spoiler":false,"text":"元々は夫婦で経営していたのだが、夫が亡くなったため今は1人で経営している。"},{"spoiler":false,"text":"働いている時はしっかりしているが、仕事外はわりとのんびりしている。"},{"spoiler":false,"text":"智司とは年齢が近く、村にいる時は姉と弟のような間柄でもあった。"},{"spoiler":false,"text":"何かとおせっかい焼きな性格をしている。"},{"spoiler":false,"text":"結婚をしたのも未亡人になったのも、智司が村にいない間の出来事。"}],"source":"egs","sourceCharacterId":"7207","sourceWorkId":"22610","spoiler":false},{"segments":[{"spoiler":false,"text":"旅館の若女将で未亡人。"},{"spoiler":false,"text":"元々は夫婦で経営していたのだが夫が亡くなり、今は一人で経営している。"},{"spoiler":false,"text":"働いている時はしっかりしているが、それ以外ではわりとのんびりしている。"},{"spoiler":false,"text":"智司とは年齢が近く、村にいる時は姉と弟のような間柄でもあった。"},{"spoiler":false,"text":"結婚をしたのも未亡人になったのも、智司が村にいない間の出来事。"},{"spoiler":false,"text":"「あら、お風呂で一緒になっちゃうなんてちょっとうらやましいわ」"}],"source":"bangumi","sourceCharacterId":"47285"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/6988f54e2d3c99aeb22eb7700550dd6b76e21e8aa7bc37ece87ca07d2b0cb4ad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5ca5bf18c5527bc5c26d4f1188ed69e314dfb9fbc4134e713d54877c8db1dd5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"谷山 ひかる","creatorId":"vndb:s8181","sourcePersonId":"vndb:s8181","canonicalEntityId":"vndb:s8181","name":"谷山 ひかる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66632","source":"vndb"}]},{"characterId":"char_c38047","characterName":"八神 雪乃","sourceIds":{"bangumi":[{"characterId":"47282","match":"exact-normalized-name-in-linked-work","subjectId":"194759"}],"egsCharacterIds":["7204"],"vndbCharacterId":"c38047"},"originalCharacterName":"八神 雪乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A miko and Satoshi's childhood friend a year younger than him, the two always played together when they were kids."},{"spoiler":false,"text":"Since she hasn't anything to do aside from her duties as a miko, she often helps out at the inn. She has a bright personality for which she is loved by both adults and children. Yukino loves her life in the village and wants to live in the village for the rest of her life."},{"spoiler":false,"text":"Although she doesn't show it, Yukino easily gets lonely. When Satoshi was leaving the village she has obediently seen him off, but then felt quite depressed for a while."}],"source":"vndb","sourceCharacterId":"c38047"},{"segments":[{"spoiler":false,"text":"智司より一歳年下の幼馴染み。"},{"spoiler":false,"text":"小さな頃はいつも一緒に遊んでいた。"},{"spoiler":false,"text":"巫女の仕事は行事の時以外はあまり忙しく無いので、旅館の手伝いに行ったりしている。明るく朗らかな性格で、大人からも子供からも慕われている。"},{"spoiler":false,"text":"村での生活が好きで、この先もずっと村で暮らしたいと思っている。"},{"spoiler":false,"text":"あまり表には出さないけれども、寂しがり屋の一面がある。智司が村を出る時は素直に送り出したが、その後しばらく沈んでいた。"}],"source":"egs","sourceCharacterId":"7204","sourceWorkId":"22610","spoiler":false},{"segments":[{"spoiler":false,"text":"智司より一歳年下の幼なじみ。 小さな頃はいつも一緒に遊んでいた。"},{"spoiler":false,"text":"明るく朗らかな性格で、村の大人からも子供からも慕われている。"},{"spoiler":false,"text":"そしてあまり表には出さないが、実は寂しがり屋の一面がある。"},{"spoiler":false,"text":"かつて智司が村を出る時は素直に送り出したが、その後しばらく沈んでいた。"},{"spoiler":false,"text":"村で巫女をしているが、行事がなく時間がある時は旅館の仕事を手伝っている。"},{"spoiler":false,"text":"村での生活が好きで、この先もずっと村で暮らしたいと思っている。"},{"spoiler":false,"text":"「ふふっ、私に会いに来てくれたってことでいいのかな？」"}],"source":"bangumi","sourceCharacterId":"47282"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51f9af6cd780505061501a6def46fe0696942230d6141d89b9e4d91be3c1cbf3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/883a5b75cfcc2be242e29cdf13968378ebca699bb039a527e454eb39db81dd74.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神保巴","creatorId":"vndb:s455","sourcePersonId":"vndb:s455","canonicalEntityId":"vndb:s455","name":"神保 巴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:194759:47282:12718:1","source":"bangumi"}]},{"characterId":"char_c71455","characterName":"都築 智司","sourceIds":{"bangumi":[{"characterId":"209751","match":"exact-normalized-name-in-linked-work","subjectId":"194759"}],"egsCharacterIds":["7200"],"vndbCharacterId":"c71455"},"originalCharacterName":"都築 智司","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An university student and a quarter Russian (his grandmother was Russian)."},{"spoiler":false,"text":"Surrounded by nature ever since he was born, he has found interest in plants and has aimed to become a botanist. As a result, he has chosen to go to an university famous for its botanic studies."},{"spoiler":false,"text":"Currently his main focus is studying mountain plants, he was supposed to continue his studies on them but he was a little bothered about his home village and home."},{"spoiler":false,"text":"Satoshi has extremely good grades, and even in the university he's among the top students. He's very active in the wild, often going out into the mountains, as a result he is more muscular and durable than his looks suggest."}],"source":"vndb","sourceCharacterId":"c71455"},{"segments":[{"spoiler":false,"text":"植物の研究に勤しむ大学生。 祖母がロシア人のクォーター。"},{"spoiler":false,"text":"自然に囲まれて育って植物に興味を持ち、植物の研究者を志す。"},{"spoiler":false,"text":"そのため村を出て有名な大学へ進み、学内でも上位の成績を修めている。"},{"spoiler":false,"text":"山での野外活動も多く、一見した雰囲気よりも筋肉質で体力がある。"},{"spoiler":false,"text":"現在は高山植物の研究をしている。"},{"spoiler":false,"text":"今後も研究を続けていく予定だが、村や実家のことも少し気になっている。"},{"spoiler":false,"text":"「しばらくは温泉につかってのんびりするか……」"}],"source":"bangumi","sourceCharacterId":"209751"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2ff326fdb5d2a0f069d14f9d060def4ef1bda5714ceed4051b8ab4da07cd99f9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/648e19ac38809dbb4cb5cd0eed8b25490e6279cd509ea3f653ce39e3293791ff.webp","width":256,"height":138,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:91","sourceCompanyId":"egs:brand:91","canonical