る性格。"},{"spoiler":false,"text":"ご主人を2年前に亡くしたが、子供が出来なかったためご主人側の実家から離縁され性が国分寺に戻っている。"},{"spoiler":false,"text":"琴美の夫は商社マンで、結婚後も出張で自宅には居なかっため、"},{"spoiler":false,"text":"SEXは数少なく性的には未開発。"}],"source":"bangumi","sourceCharacterId":"52456"}],"profileFacts":[{"label":"年龄（本版本）","value":"30 岁","valueContext":null,"source":"egs","sourceCharacterId":"15224","sourceWorkId":"12554","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"99 cm","valueContext":null,"source":"egs","sourceCharacterId":"15224","sourceWorkId":"12554","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"15224","sourceWorkId":"12554","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"67 cm","valueContext":null,"source":"egs","sourceCharacterId":"15224","sourceWorkId":"12554","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/fff8a4e9d5d5946291a63a9a78d4926d3afca84b738f31c146ff2554eb60eaee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/278cd73f803997b97d25765eb5044a490a350aeb0f432d0a10b4c0c875d8d33b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日アン(春乃うらら)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:211396:52456:6480:1","source":"bangumi"}]},{"characterId":"char_c26695","characterName":"国分寺 紅葉","sourceIds":{"bangumi":[{"characterId":"52457","match":"exact-normalized-name-in-linked-work","subjectId":"211396"}],"egsCharacterIds":["15225"],"vndbCharacterId":"c26695"},"originalCharacterName":"国分寺 紅葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","sourc