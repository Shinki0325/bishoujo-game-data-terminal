{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"3119","model":{"presentationWorkId":"vndb:v7653","staff":{"artwork":[{"creditedName":"ぷれしゃすている(尾尻進矢)","creatorId":"vndb:s5001","sourcePersonId":"egs:creator:363","canonicalEntityId":"vndb:s5001","name":"ぷれしゃすている(尾尻進矢)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:4564","source":"egs"}],"scenario":[{"creditedName":"三枝じゅんいち","creatorId":"vndb:s21854","sourcePersonId":"egs:creator:136","canonicalEntityId":"vndb:s21854","name":"三枝じゅんいち","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:4565","source":"egs"}],"music":[{"creditedName":"ミューズアート","creatorId":"egs:creator:2984","sourcePersonId":"egs:creator:2984","canonicalEntityId":"egs:creator:2984","name":"ミューズアート","roleCode":"music","roleLabel":"作品音乐","identityStatus":"no-alias-hit","relationId":"egs:work-creator:9608","source":"egs"}],"other":[{"creditedName":"T-Yam","creatorId":"vndb:s7095","sourcePersonId":"vndb:s7095","canonicalEntityId":"vndb:s7095","name":"T-Yam","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:72425","source":"vndb"},{"creditedName":"大原 みなみ","creatorId":"vndb:s11715","sourcePersonId":"vndb:s11715","canonicalEntityId":"vndb:s11715","name":"大原 みなみ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:72426","source":"vndb"},{"creditedName":"三枝 ジュンイチ","creatorId":"vndb:s21854","sourcePersonId":"vndb:s21854","canonicalEntityId":"vndb:s21854","name":"三枝 じゅんいち","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:72428","source":"vndb"}]},"cast":[{"characterId":"char_c18524","characterName":"宮條 藍子","sourceIds":{"bangumi":[{"characterId":"221173","match":"exact-normalized-name-in-linked-work","subjectId":"347787"}],"egsCharacterIds":["27243"],"vndbCharacterId":"c18524"},"originalCharacterName":"宮條 藍子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の通う名門音楽学校に転校してきた女の子。"},{"spoiler":false,"text":"女性では珍しく大型のコントラバスの奏者で、その腕前は抜群。"},{"spoiler":false,"text":"物静かで、ミステリアスな雰囲気の彼女。"},{"spoiler":false,"text":"主人公とは以前、会ったことがあるらしいが……。"}],"source":"egs","sourceCharacterId":"27243","sourceWorkId":"3119","spoiler":false},{"segments":[{"spoiler":false,"text":"名門音楽学校への転入生（専門＝コントラバス）"},{"spoiler":false,"text":"転校生として9月に突然やってくる。女性というのに大型のコントラバスを奏する非常に珍しい女性。実際に、発表会の課題となっている「Ｇ線上のアリア・サイドＢ」では女性とは思えないウルトラＣ級の腕を披露する。灰谷とは以前に、一度どこかで会っているらしい親近感を持ちはするが、詳細は一切不明。パートナーを失って悩んでいる主人公の前に現れて、「パートナーになってもいい」と言い放つ。"}],"source":"bangumi","sourceCharacterId":"221173"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/6234d3756013761d8e011c5bec298157d17ecec1c51d891ddb26e53c9455775b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b16d362e973e597e73bdb38eb289bd941a970cc96a5e728510a07d8a72115e3a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:347787:221173:6131:1","source":"bangumi"}]},{"characterId":"char_c18525","characterName":"麻布瀬 夕菜","sourceIds":{"bangumi":[],"egsCharacterIds":["27247"],"vndbCharacterId":"c18525"},"originalCharacterName":"麻布瀬 夕菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"しばらく彩倉家に住むことになった聡美の従姉妹。"},{"spoiler":false,"text":"無邪気で天真爛漫で子供っぽい女の子。"},{"spoiler":false,"text":"生意気なところもあり、掴みにくいところも。"}],"source":"egs","sourceCharacterId":"27247","sourceWorkId":"3119","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb0157e0f64284d22285316eb4ba3956a852f2142a9482c1ab0fbcb242d1746a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce9522b602dd83abc2efacf31e4790dc3bcba93c0d3e210ea11788cbf57f8371.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みる","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40687","source":"vndb"}]},{"characterId":"char_c18526","characterName":"彩倉 聡美","sourceIds":{"bangumi":[{"characterId":"221174","match":"exact-normalized-name-in-linked-work","subjectId":"347787"}],"egsCharacterIds":["27242"],"vndbCharacterId":"c18526"},"originalCharacterName":"彩倉 聡美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"体育系の学校に通う主人公の幼馴染。"},{"spoiler":false,"text":"明るく健康的な女の子だが、実は気弱で、片想いの主人公にずっと告白できないでいる。"},{"spoiler":false,"text":"最近、ストーカーに悩まされているようだが……。"}],"source":"egs","sourceCharacterId":"27242","sourceWorkId":"3119","spoiler":false},{"segments":[{"spoiler":false,"text":"体育系学校の2年生（専門＝新体操）"},{"spoiler":false,"text":"主人公・灰谷の近所に住んでいる幼なじみ。裕福ではないが普通の中流の家庭よりは恵まれている。父親が海外出張が多いために、いつも美人のお母さんと2人で住んでいる。灰谷の生活している2Fからは、双眼鏡などを使うと聡美の自室が見える。内心は主人公を好きだが、積極的に迫ってくるほどではない。ストーキングに悩み、恐れているが、そのことは主人公にも素直に相談できないでいる。"}],"source":"bangumi","sourceCharacterId":"221174"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8ec49d89329d1e77b732916cdc6cad017478c5561f4503da18bd8b316526a51.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6eb363799fb48aa33a09d22874813763bdf75a36404fe63f10edca3da6ee510e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:347787:221174:4956:1","source":"bangumi"}]},{"characterId":"char_c18527","characterName":"彩倉 百合子","sourceIds":{"bangumi":[{"characterId":"221175","match":"exact-normalized-name-in-linked-work","subjectId":"347787"}],"egsCharacterIds":["27244"],"vndbCharacterId":"c18527"},"originalCharacterName":"彩倉 百合子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"聡美の母親。"},{"spoiler":false,"text":"元モデルだったことから、そのスタイルは抜群。"},{"spoiler":false,"text":"主人公にとって、彼女は憧れの存在で、女性の理想像になっている。"},{"spoiler":false,"text":"普段は明るく振舞っているものの、夫が海外出張中であることから、寂しさを感じているようだが……。"}],"source":"egs","sourceCharacterId":"27244","sourceWorkId":"3119","spoiler":false},{"segments":[{"spoiler":false,"text":"聡美の母親で主婦。聡美と2人暮らしだが、元モデルだったこともあり美人で色っぽい。"},{"spoiler":false,"text":"父親が家にいないことで、外には見えてこないが心の中では寂しさが渦巻いている。灰谷は小さい頃から、この百合子にあこがれており、彼女のことを「百合子さん」と呼びながら育った。（「聡美のお母さん」とは呼ばない）常に憧れの人であり、女性とはこういうものだという理想型として存在していた女性。"}],"source":"bangumi","sourceCharacterId":"221175"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1c5244ee3885e7475f067e2b0ecbf2745b22b5d7e43bb55e074cd5de910abaa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f763567395e4855773f6bc541e4575895e6c6bd2c58dcfd1b00caee3b1281256.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"坂田有希","creatorId":"vndb:s1595","sourcePersonId":"vndb:s1595","canonicalEntityId":"vndb:s1595","name":"坂田 有希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:347787:221175:15687:1","source":"bangumi"}]},{"characterId":"char_c18529","characterName":"黛 久子","sourceIds":{"bangumi":[{"characterId":"221176","match":"exact-normalized-name-in-linked-work","subjectId":"347787"}],"egsCharacterIds":["27245"],"vndbCharacterId":"c18529"},"originalCharacterName":"黛 久子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の通う音楽学校の女性教員。"},{"spoiler":false,"text":"性格は明るく、挑発的なファッションを好む。"},{"spoiler":false,"text":"非常に色っぽく、そのグラマラスなボディで主人公を誘惑してくるが……。"}],"source":"egs","sourceCharacterId":"27245","sourceWorkId":"3119","spoiler":false},{"segments":[{"spoiler":false,"text":"灰谷の通う音楽学校の先生で、オーボエが専門。"},{"spoiler":false,"text":"明るい性格で、常に彼には同じように軽く接してくる。でも、いざ二人きりになると灰谷を誘惑する。いつもアミタイツをはいたボディコン姿で、基本的にはグラマラスで胸も大きい。メガネをかけているが、はずすと美人だと分かる。関係を持つと、常に誘惑してくる関係になり、大いに性的に楽しむことができる。メガネをかけたままの行為でのフィニッシュは必ずメガネにかけることを要求してくる。"}],"source":"bangumi","sourceCharacterId":"221176"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b6fa1f4558e6f8ac1e24c6ea3a157cc18c86096f666e369fc69eba6303e0c94.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e86898d91b7824e065927e7729128a4bd97d9a4d9126f53cf07f11fe3a982609.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:347787:221176:6131:1","source":"bangumi"}]},{"characterId":"char_c18530","characterName":"三田村 ヒカリ","sourceIds":{"bangumi":[{"characterId":"221177","match":"exact-normalized-name-in-linked-work","subjectId":"347787"}],"egsCharacterIds":["27246"],"vndbCharacterId":"c18530"},"originalCharacterName":"三田村 ヒカリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同じ音楽学校に通う女の子。"},{"spoiler":false,"text":"生粋のお嬢様で、主人公と交際するまでは男性のことを何も知らなかった。"},{"spoiler":false,"text":"主人公が女たらしに見えることから、主人公と別れ、セッションのパートナーも解消する。"},{"spoiler":false,"text":"しかし、彼女の行為は、主人公を困らせたかったというのが本音らしく、主人公を好きである気持ちは変わっていない。"}],"source":"egs","sourceCharacterId":"27246","sourceWorkId":"3119","spoiler":false},{"segments":[{"spoiler":false,"text":"名門音楽学校の2年生（専門＝バイオリン）"},{"spoiler":false,"text":"主人公が夏休みまで付き合っていたパートナー。音楽が好きな子ではあるが、基本的にお嬢さんで両親に逆らえない、純粋培養された女性。もちろん灰谷に関係を求められるまで、男性のことは知らなかった。女たらしに見える灰谷に愛想を尽かし、パートナーを解消することに。困らせるだけか、困らせることで灰谷の心を揺さぶろうとしているのかは不明。やがて藍子という存在が出てきて、思い通りに行かなくなり再び主人公に対して誘惑をしかけてくる。"}],"source":"bangumi","sourceCharacterId":"221177"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/294a8cdbbc8ec7b1c97e7980a48b9d629db2e2bd603023eddf38700d532592e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f115ce67ac15279167f81050fcd847f1cdb511461cd7d64fd4f15bbdd1a8d659.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"坂田有希","creatorId":"vndb:s1595","sourcePersonId":"vndb:s1595","canonicalEntityId":"vndb:s1595","name":"坂田 有希","roleCode":"vo