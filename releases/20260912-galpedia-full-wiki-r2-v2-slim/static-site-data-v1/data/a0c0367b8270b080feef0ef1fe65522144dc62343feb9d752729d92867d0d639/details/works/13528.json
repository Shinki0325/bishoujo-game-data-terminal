:"source-native","relationId":"vndb:vn-staff:42771","source":"vndb"},{"creditedName":"かみや まねき","creatorId":"vndb:s1192","sourcePersonId":"vndb:s1192","canonicalEntityId":"vndb:s1192","name":"かみや まねき","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:42772","source":"vndb"},{"creditedName":"黒崎 将弘","creatorId":"vndb:s3066","sourcePersonId":"vndb:s3066","canonicalEntityId":"vndb:s3066","name":"黒崎 将弘","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:42774","source":"vndb"}]},"cast":[{"characterId":"char_c8992","characterName":"天川 遊莉亜","sourceIds":{"bangumi":[{"characterId":"131919","match":"exact-normalized-name-in-linked-work","subjectId":"148455"}],"egsCharacterIds":["13699"],"vndbCharacterId":"c8992"},"originalCharacterName":"天川 遊莉亜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【身に纏うユニフォームの如く、身も心も真っ白で無垢なメイドさん】"},{"spoiler":false,"text":"突如、主人公の元に現れ、他界した彼の祖父母からの依頼と称して、強引にメイドとして仕えてしまう女性。"},{"spoiler":false,"text":"主と決めた主人公のいう事を嫌な顔一つせず受け入れてくれる包容力を示す。"},{"spoiler":false,"text":"その反面、主人公をひとかどの人物に育てる妙な使命感に燃えており、にこやかな笑顔のまま彼に鬼のような厳しい特訓を強いたりもする。"},{"spoiler":false,"text":"世界でも１、２を争うほどの有名なメイドに与えられる"},{"spoiler":false,"text":"「白き革新」の称号を二つ名として名乗る事を許されて、その事実が遊莉亜がいかに有能なのかを証明している。"},{"spoiler":false,"text":"主である主人公から求められれば、身体を許すことも当然と考えているが、知識でしか性行為を知らない為、耳年増状態となっている。"},{"spoiler":false,"text":"あらゆる意味で、主に都合の良い存在であろうとする。"}],"source":"egs","sourceCharacterId":"13699","sourceWorkId":"13528","spoiler":false},{"segments":[{"spoiler":false,"text":"突如、煌司の元に現れ、他界した彼の祖母に縁ある人物からの依頼と称して、強引に仕えてしまう純白のメイド・サーヴァント。"},{"spoiler":false,"text":"主と決めた煌司の言うことを嫌な顔一つせず受け入れてくれる包容力を示す。"},{"spoiler":false,"text":"その反面、どこか融通のきかない一面もあり、ふとした事で機嫌を損ねると、後で手痛いしっぺ返しを喰らわされることもある。"},{"spoiler":false,"text":"煌司をひとかどの人物に育てる妙な使命感に燃えており、にこやかな笑顔のまま彼に鬼のような厳しい特訓を強いたりもする。"},{"spoiler":false,"text":"世界でも数えるほどしかいない高いランクと権限を与えられているメイドであり、ただ主に仕えるだけの存在ではなく、公私を支えるパートナーを名乗ることを許されてもいる。"},{"spoiler":false,"text":"その証として二つ名を持つことが許されており、「白き革新」と呼ばれることがある。"}],"source":"bangumi","sourceCharacterId":"131919"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e83e3473827d55120cf9a41a80d91b830c87ec534f3831cace5239c053782d1c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/acabd522d1a910de9cc65a64ecfe3f2177ace2cc8a70c122639b499a136325f9.webp","width":156,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:148455:131919:5741:1","source":"bangumi"}]},{"characterId":"char_c8993","characterName":"霧乃 依莉沙","sourceIds":{"bangumi":[{"characterId":"131920","match":"exact-normalized-name-in-linked-work","subjectId":"148455"}],"egsCharacterIds":["13700"],"vndbCharacterId":"c8993"},"originalCharacterName":"霧乃 依莉沙","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【掲げる色のように、一度抱いた想いは何色にも染まらず決して曲げない黒いメイドさん】"},{"spoiler":false,"text":"遊莉亜を追って登場し、主人公の警護担当に半ば強引に収まってしまうメイド。"},{"spoiler":false,"text":"お互いの所属する部署は犬猿の仲であるため、同じように遊莉亜と依莉沙もいがみ合っている。"},{"spoiler":false,"text":"とはいえ、傍からそれを見てると仲の良い二人がじゃれあっているようにしか見えない。"},{"spoiler":false,"text":"大人びた達観した考えを持っているかと思えば、変に意地を張って子供じみた態度を見せたりも。"},{"spoiler":false,"text":"基本的に自信の塊のような性格で、自分こそが最高のメイドであると自負している。"},{"spoiler":false,"text":"ちょっと三白眼気味の吊り目で、本人は密かにそれを気にしている。"},{"spoiler":false,"text":"ユリアと同様に渾名があり、「黒き癒し」と呼ばれている。"},{"spoiler":false,"text":"ＳＥＸの傾向は主導権を握ろうとするタイプ。"},{"spoiler":false,"text":"自分の手管で相手が達してしまう事が快感でしかたがないＳ気質。"},{"spoiler":false,"text":"しかし、身体は非常に感じやすいＭタイプで、主導権をとられてしまうとたちまちメロメロになってしまう。"}],"source":"egs","sourceCharacterId":"13700","sourceWorkId":"13528","spoiler":false},{"segments":[{"spoiler":false,"text":"遊莉亜を追ってやってきて、彼女同様強引に煌司に仕えてしまう、漆黒を身にまとうもう一人のメイド・サーヴァント。"},{"spoiler":false,"text":"遊莉亜の所属する部署と依莉沙の所属する部署は犬猿の仲であるため、同じように遊莉亜と依莉沙もいがみ合っている。"},{"spoiler":false,"text":"とはいえ、傍からそれを見ていると仲の良い二人がじゃれあっているようにしか見えない腐れ縁的な関係だが、本人たちは決して仲がいいとは認めようとしない。"},{"spoiler":false,"text":"大人びた達観した考えを持っているかと思えば、変に意地を張って○○じみた態度を見せたりもする。"},{"spoiler":false,"text":"基本的に自信の塊のような性格で、自分こそが最高のメイド・サーヴァントであると自負しているが、決して尊大な態度をとるワケでもなく、人当たりは非常に良い。"},{"spoiler":false,"text":"ちょっと三白眼気味のつり目で、本人も密かにそれを気にしていたりする。"},{"spoiler":false,"text":"特にそれが原因で小さな○○に怖がられる事が多く、その度に乙女心が傷ついてしまっているらしい。"},{"spoiler":false,"text":"遊莉亜同様二つ名を許されており、依莉沙のそれは「黒き癒し」。"}],"source":"bangumi","sourceCharacterId":"131920"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3e522ab004ed6cea82d355aa3a8b9e8137e20c1658e4ad77dcad32ddec9c36b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fde248099b04045c466cf84454b1a232c9168dce2df7b4ba2fd66024fdbe98f6.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:148455:131920:4832:1","source":"bangumi"}]},{"characterId":"char_c8994","characterName":"綾瀬 絢奈","sourceIds":{"bangumi":[{"characterId":"131921","match":"exact-normalized-name-in-linked-work","subjectId":"148455"}],"egsCharacterIds":["13701"],"vndbCharacterId":"c8994"},"originalCharacterName":"綾瀬 絢奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【思い描く夢の為に、努力を惜しまない純真な幼馴染】"},{"spoiler":false,"text":"主人公のクラスメイト。器量よし、気だてよしのクラスの人気者。"},{"spoiler":false,"text":"幼い頃から自分を援助してくれている男性がおり、その彼に恩を返すため彼に尽くすメイドになりたいと思っており、日々の修練を欠かさない努力家。"},{"spoiler":false,"text":"しかし、その男性とも１年ほど前から音信不通になってしまっており、その安否を気遣っている。"},{"spoiler":false,"text":"件の男性は遊莉亜と依莉沙の組織に所属していたので何か情報を得られる可能性を信じ、また後の自分の目的のために二人に弟子入りする。"},{"spoiler":false,"text":"以前は主人公とも名前で呼び合う中だったが、上記の男性への絢奈の好意を感じとってしまった主人公がある時を境に距離を置くようになり、今では名字で互いを呼ぶようになってしまった経緯がある。"},{"spoiler":false,"text":"ＳＥＸの傾向も努力家の性格が前面に出て、慣れない事、知らない事でも積極的に憶えようとする。"},{"spoiler":false,"text":"最初こそぎこちないものの、それが幸いして主人公を満足させられるようになっていく。"}],"source":"egs","sourceCharacterId":"13701","sourceWorkId":"13528","spoiler":false},{"segments":[{"spoiler":false,"text":"煌司の幼なじみでクラスメイト。"},{"spoiler":false,"text":"器量よし、気だてよしのクラスの人気者。"},{"spoiler":false,"text":"見た目に違わず純真な心の持ち主だが、逆に素直すぎるというか、○○っぽい一面がある。"},{"spoiler":false,"text":"本人もその事を気にしている節があり、それを友人に指摘されてむくれることも。"},{"spoiler":false,"text":"しかし、基本的には誰にでも好かれる明るい性格のため、絢奈を慕う人間はクラスの内外を問わず非常に多い。"},{"spoiler":false,"text":"とある事情から、メイド・サーヴァントになることに並々ならぬ情熱を抱いており、夢は遊莉亜や依莉沙のように二つ名を許されるくらいになること。"},{"spoiler":false,"text":"そのための日々の修練を欠かさない努力家で、遊莉亜と依莉沙に師事したいとも考えている。"},{"spoiler":false,"text":"以前は煌司とも名前で呼び合う仲だったが、互いに異性であることを意識しだした頃に距離を置いてしまった時期があり、気付けば現在のように名字で呼び合うようになっていた。"}],"source":"bangumi","sourceCharacterId":"131921"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7f5d36f759b4fee86cd72264d6c1dd10cb815273dabe22b2c7cad804deb6dee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba3604ea98f6d0939e4ccd7817f3d7da6e460c17900c5a3873bba3ce81004d0a.webp","width":135,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高梁碧","creatorId":"vndb:s1193","sourcePersonId":"vndb:s1193","canonicalEntityId":"vndb:s1193","name":"高梁 碧","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:148455:131921:4781:1","source":"bangumi"}]},{"characterId":"char_c8995","characterName":"柊 ゆかり","sourceIds":{"bangumi":[{"characterId":"131922","match":"exact-normalized-name-in-linked-work","subjectId":"148455"}],"egsCharacterIds":["13702"],"vndbCharacterId":"c8995"},"originalCharacterName":"柊 ゆかり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【どんな我が儘も笑顔で受け止めてそうな包容力を感じさせる管理人さん】"},{"spoiler":false,"text":"主人公が住んでいるアパートの管理人兼大家。"},{"spoiler":false,"text":"アパートは主人公の祖父母の名義だが、主人公が成人するまでゆかりが管理を任されている。"},{"spoiler":false,"text":"主人公の祖父母に恩があり、その縁から主人公を弟の様に可愛がっている。"},{"spoiler":false,"text":"主人公にとっては、少し年の離れた頼れるお姉さん。"},{"spoiler":false,"text":"主人公の積極的なスキンシップを巧みな技で躱すも、内心まんざらでもない様子。"},{"spoiler":false,"text":"突然、現れたユリアの存在が気が気でないものの、主人公が受け入れてしまった事で"},{"spoiler":false,"text":"なしくずし的に同居を認めてしまっている。"},{"spoiler":false,"text":"それでも、管理人権限で部屋を分ける事だけは譲らなかった裏には、主人公に対する譲れない想いが見え隠れしている為。"},{"spoiler":false,"text":"何事も周囲を率先するリーダー気質の割にＳＥＸの傾向はひたすら受け身で、相手の望むままに身体を開いて流されてしまう。"},{"spoiler":false,"text":"辱められると返って火が着いてしまう完全なＭ気質を主人公に知られてしまい、嫌がりながらも快感を感じてしまう。"}],"source":"egs","sourceCharacterId":"13702","sourceWorkId":"13528","spoiler":false},{"segments":[{"spoiler":false,"text":"煌司が住んでいるアパート 『緋翼荘』 の管理人。"},{"spoiler":false,"text":"煌司の祖母に恩があり、その縁から主人公を弟のように可愛がっている。"},{"spoiler":false,"text":"煌司にとっては、少し年の離れた頼れるお姉さん。"},{"spoiler":false,"text":"その積極的なスキンシップを巧みな技で躱すも、内心まんざらでもない様子。"},{"spoiler":false,"text":"突然現れた遊莉亜や依莉沙の存在に気が気でないものの、煌司が受け入れてしまったことで、なし崩し的に同居を認めてしまう。"},{"spoiler":false,"text":"それでも管理人権限で部屋を分ける事だけは譲らなかった裏には、煌司に対する譲れない想いが見え隠れしているため。"},{"spoiler":false,"text":"本人は無意識、また気付いてもそうだとはなかなか認めないが、かなりのやきもち焼き。"}],"source":"bangumi","sourceC