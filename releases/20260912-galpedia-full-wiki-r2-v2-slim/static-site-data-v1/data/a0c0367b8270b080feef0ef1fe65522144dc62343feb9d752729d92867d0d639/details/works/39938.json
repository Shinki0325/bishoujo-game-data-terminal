rId":"vndb:s14765","sourcePersonId":"vndb:s14765","canonicalEntityId":"vndb:s14765","name":"heki.","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:221650","source":"vndb"},{"creditedName":"JENNI","creatorId":"vndb:s35062","sourcePersonId":"vndb:s35062","canonicalEntityId":"vndb:s35062","name":"JENNI","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:221655","source":"vndb"},{"creditedName":"松長 暁生","creatorId":"vndb:s44160","sourcePersonId":"vndb:s44160","canonicalEntityId":"vndb:s44160","name":"松長 暁生","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:221656","source":"vndb"}]},"cast":[{"characterId":"char_c30517","characterName":"エクリア・フェミリンス","sourceIds":{"bangumi":[{"characterId":"15114","match":"exact-normalized-name-in-linked-work","subjectId":"12119"}],"egsCharacterIds":["14044"],"vndbCharacterId":"c30517"},"originalCharacterName":"エクリア・フェミリンス","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Due to certain reason Ekria wants to die and so meets Celica and requests him to kill her but Celica refuses her request."}],"source":"vndb","sourceCharacterId":"c30517"},{"segments":[{"spoiler":false,"text":"四使徒の中で最も長くセリカと共にいる女性。"},{"spoiler":false,"text":"魔術の造詣も深く、メイドの中では最も強い魔力を有する。"},{"spoiler":false,"text":"現在は、使徒になって間もないシュリやサリアに"},{"spoiler":false,"text":"メイドの仕事や魔術を教えたりする"},{"spoiler":false,"text":"“メイド長”的な立場をになっている様子。"}],"source":"egs","sourceCharacterId":"14044","sourceWorkId":"2341","spoiler":false},{"segments":[{"spoiler":false,"text":"元カルッシャ王国の姫将軍(きしょうぐん)。"},{"spoiler":false,"text":"(幻燐2より)闇夜の眷属国となったメンフィル王国とリウイとの戦いに敗れ、追放される。"},{"spoiler":false,"text":"姫神フェミリンスの末裔であり、最終決戦では姫神化の暴走で妹イリーナを殺害してしまう。"},{"spoiler":false,"text":"血縁者に移ってしまうフェミリンスの呪いで死ぬこともできない絶望の中、"},{"spoiler":false,"text":"神殺しのセリカと出会い、彼に死の贖罪を求めるようになる。"},{"spoiler":false,"text":"死を求めて旅を続ける中(VERITA本編)で、自らの罪を自覚し、安易な死よりも困難な生を選ぶ。"},{"spoiler":false,"text":"いつ終わるともしれない贖罪を果たすため、"},{"spoiler":false,"text":"セリカの使徒となって永遠に近い刻を生きることに。"}],"source":"egs","sourceCharacterId":"14044","sourceWorkId":"11748","spoiler":false},{"segments":[{"spoiler":false,"text":"戦女神2ではシュリと並んでのメインヒロイン。VERITAではメインヒロイン。"},{"spoiler":false,"text":"セリカの第一使徒。落ち着いた雰囲気を纏う妙齢の美女。セリカとは相性がよく、念話で会話することが可能であり、またハイシェラと会話する事も出来る。"},{"spoiler":false,"text":"セリカ曰く、安心して背中を任せられる唯一の相手。"},{"spoiler":false,"text":"使徒の中でのメイド長、或いはセリカ一家の家宰というべきポジションで、仕事の割り当て、屋敷の管理、掃除などまで幅広くこなす。長年の付き合いから成せる業か、セリカの行動を先読みして行動することが多い。"},{"spoiler":false,"text":"情報収集、分析、交渉術、馬術などにも長け、その力をセリカのために惜しむことなく使う。"},{"spoiler":false,"text":"VERITAにおける当初はセリカが他の女性と性交渉を持つことに（人並に）敏感で、それを察すると臍を曲げることもあったが、レウィニアでの生活を得た頃には「セリカの為になるならば」という信念を優先させ、表向きはかなり寛容な態度でいる。"},{"spoiler":false,"text":"元はメンフィルに滅ぼされたカルッシャ王国の第一王女であり、自ら戦いに赴く戦姫で、裏工作や暗殺なども行う非情な面も持っていた。100年を経た現在でも、敵に対しては時折そのような面を見せる。"},{"spoiler":false,"text":"姫神フェミリンスの呪いとともに受け継いだ魔力は人の限界を超えた力であり、「姫将軍」と畏怖された。常に仮面を被っていたが、これは呪いを抑えるための物であり、もう被ることはなくなった戦女神２時点でも思い出の品として仮面は所持している。"},{"spoiler":false,"text":"戦闘では鞭を使うが、主力は強力な各種魔術である。冷却、水流、純粋、念動、攻撃呪鍛、防御呪鍛の各種秘印術に加え、魅了や束縛の性魔術を使いこなす。加えて非戦闘時は結界魔術も扱う。"}],"source":"bangumi","sourceCharacterId":"15114"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"15114","value":"人类"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c9c6aa95c64a75f2834e8e012bca7bbdfe8c6e2ed11dfa8ee173982ea61c5c3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb38c51dbe7e3cd236ffdc6d159641925cc7d6149068a951afb6d60a43215bd6.webp","width":180,"height":256,"source":"static-detail"},"actors":[{"creditedName":"未来羽","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","