tyStatus":"source-native","relationId":"vndb:vn-staff:56162","source":"vndb"}],"other":[{"creditedName":"カンナユリ","creatorId":"vndb:s9059","sourcePersonId":"vndb:s9059","canonicalEntityId":"vndb:s9059","name":"カンナユリ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:56164","source":"vndb"},{"creditedName":"まっすう","creatorId":"vndb:s9352","sourcePersonId":"vndb:s9352","canonicalEntityId":"vndb:s9352","name":"まっすう","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:56166","source":"vndb"}]},"cast":[{"characterId":"char_c47340","characterName":"エイプリル","sourceIds":{"bangumi":[{"characterId":"130045","match":"exact-normalized-name-in-linked-work","subjectId":"436516"}],"egsCharacterIds":["25498"],"vndbCharacterId":"c47340"},"originalCharacterName":"エイプリル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ラスカラス伯爵の息女にして姫君。"},{"spoiler":false,"text":"教皇庁直属の悪魔狩り組織「聖ゲオルギウス騎士団」の女騎士にしてハンター。"},{"spoiler":false,"text":"ヴァンパイアハンターとしての知識に精通し、驚異的な肉体能力に加え、頭脳も明晰。その性格も冷静沈着にして思慮深く、家族や仲間を思いやる優しい心の持ち主。"},{"spoiler":false,"text":"ムチやクロス型の投擲爆弾など、様々な対ヴァンパイア武器、道具を使いこなす。"}],"source":"egs","sourceCharacterId":"25498","sourceWorkId":"7628","spoiler":false},{"segments":[{"spoiler":false,"text":"伯爵の息女にして姫君。"},{"spoiler":false,"text":"教皇庁直属で、吸血鬼など人外の魔物を狩る悪魔狩り組織「聖ゲオルギウス騎士団」の女騎士にしてハンター。"},{"spoiler":false,"text":"吸血鬼を退治する学問と技術に精通し、脅威的な肉体と明晰な頭脳を持つ、冷静沈着にして思慮深い女性。"},{"spoiler":false,"text":"クールな外見とその戦いぶりから冷淡な人物に見られがちだが、家族や仲間を思いやる心を忘れない優しい心をもっている。"},{"spoiler":false,"text":"ムチやクロス型投擲爆弾など、退治用の数々の道具を使いこなす。"}],"source":"bangumi","sourceCharacterId":"130045"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/3124485154e40b53d7d2416131cb0b0334e9d2c50c9a0fa433dede9b3f0f63ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71ce6bbb2c355366bed5153cb1eabaaf1b93702eb3deb15110be34a408edce79.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:436516:130045:5741:1","source":"bangumi"}]},{"characterId":"char_c47341","characterName":"トリエラ・メルツェーデス","sourceIds":{"bangumi":[{"characterId":"130046","match":"exact-normalized-name-in-linked-work","subjectId":"436516"}],"egsCharacterIds":["25499"],"vndbCharacterId":"c47341"},"originalCharacterName":"トリエラ・メルツェーデス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"教皇庁直属である「聖メルツェーデス教団」の聖女。"},{"spoiler":false,"text":"ハンターとしての技能はエイプリルに劣るものの、魔物を滅ぼせる「聖なる血」が流れる彼女は吸血鬼を退ける特殊な力を持つ。"},{"spoiler":false,"text":"血の力は本人の意志の力に左右されるため、その血の効力を保つため、常に自信と一族のプライドを持つように心掛けている。"},{"spoiler":false,"text":"血の力以外、全てにおいて及ばないエイプリルをライバル視している。"}],"source":"egs","sourceCharacterId":"25499","sourceWorkId":"7628","spoiler":false},{"segments":[{"spoiler":false,"text":"教皇庁直属の聖メルツェーデス教団の聖女。ハンターとしての技能はエイプリルに劣るが、“聖なる血”を受け継いだ肉体は、吸血鬼を退ける力を持つ。"},{"spoiler":false,"text":"聖女がもたらす奇跡の血は、魔を滅ぼす力があるため、一種の聖遺物として王国では高額で取り引きされ、それが教団と教皇庁の財源となっている。"},{"spoiler":false,"text":"聖なる血の一族であるというプライドと、戦闘能力においては敵わないというコンプレックスから、エイプリルに対して激しいライバル意識を剥き出しにしている。"}],"source":"bangumi","sourceCharacterId":"130046"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb51440ecc92b4cc989a206ec803e2ef9c6d194cb4dc3ce248a0f99eb3c4524b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75bca37c132e67a5fb78fe19198cc8a36cfb8bd6daaac20416d9b09b42b471ff.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和泉忍","creatorId":"vndb:s1623","sourcePersonId":"vndb:s1623","canonicalEntityId":"vndb:s1623","name":"伊藤 葉純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:436516:130046:6379:1","source":"bangumi"}]},{"characterId":"char_c47343","characterName":"レン","sourceIds":{"bangumi":[{"characterId":"130047","match":"exact-normalized-name-in-linked-work","subjectId":"436516"}],"egsCharacterIds":["25500"],"vndbCharacterId":"c47343"},"originalCharacterName":"レン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"b"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公にかしずく謎多き両性具有の召使い。"},{"spoiler":false,"text":"その正体は主人公でさえ知らず、一説には人類と同じくらい古くから地上を徘徊していた、というが……。人の魂を喰らい、その姿を自由に変えることが出来る魔物。"},{"spoiler":false,"text":"主人公と道化の関係にあり、主人公に仕えているものの、時折、主人公をひどく罵ったり、からかったりする。"},{"spoiler":false,"text":"笑顔を絶やさず、常ににこやかだが、性格はいたって残忍で、人間的な道徳観を持ち合わせていない。"}],"source":"egs","sourceCharacterId":"25500","sourceWorkId":"7628","spoiler":false},{"segments":[{"spoiler":false,"text":"ドレイクでさえその正体を知らない、少女にして少年…両性具有の召使い。"},{"spoiler":false,"text":"ドレイクとは、王と道化の関係にあり、ドレイクに仕えてはいるが――ときおり手ひどくドレイクを痛罵したり嘲笑ったり、からかったりする。それでもレンは、深く深く、ドレイクのことを愛している模様である。その理由はドレイクも知らない。"},{"spoiler":false,"text":"見かけはいつも笑顔だが性格はいたって残忍で、人間的な道徳観は持ち合わせておらず、笑顔で残酷なことをやってのける、小悪魔的存在。"},{"spoiler":false,"text":"変身や幻覚の能力を持ち、その力でヒロイン達を容赦なく責める。"}],"source":"bangumi","sourceCharacterId":"130047"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"b","source":"vndb","sourceCharacterId":"c47343","value":"b"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"25500","value":"女性"},{"comparisonValue":"f","source":"eg