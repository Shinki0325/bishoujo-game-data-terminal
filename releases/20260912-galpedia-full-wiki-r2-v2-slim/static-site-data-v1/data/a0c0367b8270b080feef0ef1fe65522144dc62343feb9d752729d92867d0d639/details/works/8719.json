":"210796"}],"egsCharacterIds":["23502"],"vndbCharacterId":"c65374"},"originalCharacterName":"浦田 杏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"カナヅチを治したいという一大決心で、生徒になった女の子。"},{"spoiler":false,"text":"ところが、指導の最中に主人公の指で感じてしまい、気分が優れないからと言って連れていってもらった医務室で主人公と行為に。"},{"spoiler":false,"text":"そこで潮を吹いた杏は、「おしっこを漏らしてしまった」と勘違いして……!?"}],"source":"egs","sourceCharacterId":"23502","sourceWorkId":"8719","spoiler":false},{"segments":[{"spoiler":false,"text":"カナヅチを治したいという一大決心で、スイミング指導コースにきた女の子。"},{"spoiler":false,"text":"ところが、コーチをうけていた途中、主人公の指によって身体が女の喜びを感じてしまう!?"},{"spoiler":false,"text":"変な気分になった杏は、気分が優れないからと言って連れてって貰った医務室で、"},{"spoiler":false,"text":"主人公に自然と愛撫を求めてしまい、“潮”をふいて絶頂に達してしまう！"},{"spoiler":false,"text":"しかし、性知識に疎い杏は、それをしおふきだとは考えず、「おもらしした」と思いこんでしまったようで……!?"},{"spoiler":false,"text":"「コ、コーチ…だめです……おしっこ、おしっこが漏れちゃうっ……」"}],"source":"bangumi","sourceCharacterId":"52069"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"23502","sourceWorkId":"8719","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"23502","sourceWorkId":"8719","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"23502","sourceWorkId":"8719","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"23502","sourceWorkId":"8719","sourceField":null,"scoped":true}],"metadataCandidateConf