わ……。ふふ、もっと下も触ってくださいませんか？」"}],"source":"bangumi","sourceCharacterId":"52070"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/1958765667070903e8e3203e2dec19d7e63fb5c3071b75ebd29d527e059c1d6a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4d7e5e882627b3d31d230ee276511cc8870a690be10ad631663e34b0a793538.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"及川ひとみ","creatorId":"vndb:s110","sourcePersonId":"vndb:s110","canonicalEntityId":"vndb:s110","name":"及川 ひとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:210796:52070:13696:1","source":"bangumi"}]},{"characterId":"char_vndb_c65370","characterName":"川石 誠","sourceIds":{"vndbCharacterId":"c65370"},"originalCharacterName":"川石 誠","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p258","sourceCompanyId":"egs:brand:721","canonicalEntityId":"vndb:p258","name":"マリン","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:8719:721","source":"egs"},{"companyId":"vndb:p258","sourceCompanyId":"vndb:p258","canonicalEntityId":"vndb:p258","name":"マリン","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:13260:v5754","source":"vndb"},{"companyId":"vndb:p258","sourceCompanyId":"vndb:p258","canonicalEntityId":"vndb:p258","name":"マリン","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:13261:v5754","source":"vndb"},{"companyId":"vndb:p258","sourceCompanyId":"vndb:p258","canonicalEntityId":"vndb:p258","name