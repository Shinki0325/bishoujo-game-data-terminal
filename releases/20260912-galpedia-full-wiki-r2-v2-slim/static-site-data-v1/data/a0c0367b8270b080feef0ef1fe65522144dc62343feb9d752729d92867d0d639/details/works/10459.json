":"vndb:vn-staff:19503","source":"vndb"}],"other":[{"creditedName":"やべあきら","creatorId":"vndb:s40461","sourcePersonId":"egs:creator:40574","canonicalEntityId":"vndb:s40461","name":"やべあきら","detail":"イベントCG彩色","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:276416","source":"egs"},{"creditedName":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","creatorId":"vndb:s592","sourcePersonId":"egs:creator:13068","canonicalEntityId":"vndb:s592","name":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","detail":"デモムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:74063","source":"egs"},{"creditedName":"田丸 まこと","creatorId":"vndb:s2324","sourcePersonId":"vndb:s2324","canonicalEntityId":"vndb:s2324","name":"田丸 まこと","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:19499","source":"vndb"},{"creditedName":"織姫 よぞら","creatorId":"vndb:s1282","sourcePersonId":"vndb:s1282","canonicalEntityId":"vndb:s1282","name":"Ayumi.","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:19504","source":"vndb"}]},"cast":[{"characterId":"char_c10166","characterName":"レイア","sourceIds":{"bangumi":[{"characterId":"94749","match":"exact-normalized-name-in-linked-work","subjectId":"229571"},{"characterId":"94749","match":"exact-normalized-name-in-linked-work","subjectId":"229572"},{"characterId":"94749","match":"exact-normalized-name-in-linked-work","subjectId":"229573"}],"egsCharacterIds":["13923","13927"],"vndbCharacterId":"c10166"},"originalCharacterName":"レイア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main heroine of the first game. Her name was never mentioned in the first game, she was simply referred to as Valkyrie. She was captured by Duke."},{"spoiler":false,"text":"In the second game her name is revealed to be Leia."}],"source":"vndb","sourceCharacterId":"c10166"},{"segments":[{"spoiler":false,"text":"大神から命じられ人間たちを守り、戦場を駆ける戦乙女。"},{"spoiler":false,"text":"しかし、自ら人間を守ることが自分に課せられた使命であると信じている。"},{"spoiler":false,"text":"その凛々しい顔付きからややキツイ印象を与えるが、人当たりが良く、誰とでもすぐに打ち解けられる温厚な性格。"},{"spoiler":false,"text":"ひとたび戦場に出れば、鬼神の如き活躍を見せ、人間に害する悪を容赦なく叩きのめす。"},{"spoiler":false,"text":"神々の力が封じ込められた「黄金の指輪」の加護がなくなると、彼女本来の力が失われる。"},{"spoiler":false,"text":"天空の戦士たちを統率する軍師・フレイアを尊敬し、憧れの念を抱いている。"}],"source":"egs","sourceCharacterId":"13923","sourceWorkId":"3786","spoiler":false},{"segments":[{"spoiler":false,"text":"人間界を守るべく降臨した「日輪の戦乙女」で、前作のヒロイン。"},{"spoiler":false,"text":"慈愛と優しさに満ちた性格だが、敵に対しては容赦しない。"},{"spoiler":false,"text":"しかし、人質をとられるなどの手段にはめっぽう弱く、"},{"spoiler":false,"text":"そこを突かれて、デュークに捕らわれてしまった。"},{"spoiler":false,"text":"度重なる凌辱調教で、清らかだった肉体は開発され尽くしてしまったが、"},{"spoiler":false,"text":"心は堕ちる寸前で抵抗を続けている。"},{"spoiler":false,"text":"だが、デュークの興味が新たな戦乙女に移ると……？"}],"source":"egs","sourceCharacterId":"13927","sourceWorkId":"10459","spoiler":false},{"segments":[{"spoiler":false,"text":"蒼穹の戦乙女レイアはラグナロクでデュークに別れを告げたものの、"},{"spoiler":false,"text":"彼のことが忘れられずに帰ってきてしまう。"},{"spoiler":false,"text":"名目上は「ミッドガルドの治安を守る」ということだが……。"},{"spoiler":false,"text":"嫉妬するとブラックヴァルキリーに変身。"},{"spoiler":false,"text":"デュークを独り占めしようとする。"}],"source":"egs","sourceCharacterId":"13927","sourceWorkId":"11296","spoiler":false},{"segments":[{"spoiler":false,"text":"人当たりが良く温厚で誰とでもすぐにうち解けます。性格も非常によいです。"},{"spoiler":false,"text":"しかし、ひとたび戦場に出ると容赦なく人間を害する悪を打ちのめします。"},{"spoiler":false,"text":"人々を守るためなら何でもするという信念があります。また、この信念を通すためならどんなことでもします。"},{"spoiler":false,"text":"ヴァルキリーは大神の命令で人間を守っていますが、自身も人々を助けるのが自分に課せられた生涯の勤めだと信じています。"},{"spoiler":false,"text":"人々にはヴァルキリー様、戦争乙女、盾の乙女(スカルメール）などとも呼ばれています。"},{"spoiler":false,"text":"いつも慎ましく清楚で優しいフレイアに、尊敬し憧れの念を抱いています。"},{"spoiler":false,"text":"ヴァルキリーが本来の力を発揮するには、神々の力を封じ込めた黄金の指輪が必要です。"}],"source":"bangumi","sourceCharacterId":"94749"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d827901143f864b7ab67fba068502d2811d681d9452c36ce1228947561df929d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3f0228e7a89768919e90a2bc92deb2871f0c831e41be723dc1cab792c42806f.webp","width":129,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229573:94749:6036:1","source":"bangumi"}]},{"characterId":"char_c30001","characterName":"フレイア","sourceIds":{"bangumi":[{"characterId":"94750","match":"exact-normalized-name-in-linked-work","subjectId":"229571"},{"characterId":"94750","match":"exact-normalized-name-in-linked-work","subjectId":"229573"}],"egsCharacterIds":["13924"],"vndbCharacterId":"c30001"},"originalCharacterName":"フレイア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"177cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"58Kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔王に調教され、主人公の肉奴兼秘書に貶められた、天空の戦士たちを統率する元軍師。"},{"spoiler":false,"text":"ヴァルキリーの憧れの存在。"},{"spoiler":false,"text":"頭の切れる知的なお姉さん。性格は優しく物静かで温厚だが、規律や躾に厳しい。"},{"spoiler":false,"text":"そんな彼女は魔王に堕とされてからは、その知識や才能を快楽を得るために使うようになり、ヴァルキリーに対しても自分と同じように快楽を味わって欲しいと願うように……。"}],"source":"egs","sourceCharacterId":"13924","sourceWorkId":"3786","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公によって調教、籠絡され、"},{"spoiler":false,"text":"完全な性奴隷へと堕ちた前作のヒロインたち。"},{"spoiler":false,"text":"以前の面影はどこにもなく、ただひたすら快楽を求め、"},{"spoiler":false,"text":"まぐわい続けている。"}],"source":"egs","sourceCharacterId":"13924","sourceWorkId":"10459","spoiler":false},{"segments":[{"spoiler":false,"text":"ヴァルキリーを含む、天空の戦士達を統率していた軍師ですが、魔王に調教されてしまい、"},{"spoiler":false,"text":"現在は主人公の肉奴隷兼秘書として生活を送っています。"},{"spoiler":false,"text":"ヴァルキリーのお姉さん的存在ですが、調教後のフレイアはヴァルキリーにも"},{"spoiler":false,"text":"自分と同じような快楽を早く味わってもらいたいと思っています。"},{"spoiler":false,"text":"知的で非常に頭が切れ躾に厳しいお姉さんです。基本的には物静かですが、悪いことは誰であろうと注意をします。"},{"spoiler":false,"text":"フレイアの厳しさの裏には常に優しさがあります。"},{"spoiler":false,"text":"しかし、調教されてしまったフレイアは、快楽を得るためにその知識や才能を使います。"},{"spoiler":false,"text":"特にエッチシーンでは、自身を蔑み豹変したようにエッチに没頭します。"}],"source":"bangumi","sourceCharacterId":"94750"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98e2a89d4323134b4473f8d42bc4df76e8818c6d2ee776e2035cf880d122497c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4ed29f0f5b31ca99451be3abcf0c9c3ee831b38bc33312f5fa69da351d59d5c5.webp","width":129,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229573:94750:4675:1","source":"bangumi"}]},{"characterId":"char_c30002","characterName":"スクルド","sourceIds":{"bangumi":[{"characterId":"94751","match":"exact-normalized-name-in-linked-work","subjectId":"229571"},{"characterId":"94751","match":"exact-normalized-name-in-linked-work","subjectId":"229572"},{"characterId":"94751","match":"exact-normalized-name-in-linked-work","subjectId":"229573"}],"egsCharacterIds":["13925"],"vndbCharacterId":"c30002"},"originalCharacterName":"スクルド","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"150cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"42Kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ヴァルキリーを慕い、憧れる後輩の見習い女神。"},{"spoiler":false,"text":"跳ねっ返りで気が強く、意地っ張りな元気娘。"},{"spoiler":false,"text":"しかし、ヴァルキリーやフレイアなど、気を許した相手に対しては素直さを見せる。"},{"spoiler":false,"text":"男が嫌いだが、それよりも悪が許せず、悪の権化であると信じている悪魔を根絶やしにしたいと思っている。"},{"spoiler":false,"text":"まだまだ肉体的にも、精神的にも幼い。"}],"source":"egs","sourceCharacterId":"13925","sourceWorkId":"3786","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公によって調教、籠絡され、"},{"spoiler":false,"text":"完全な性奴隷へと堕ちた前作のヒロインたち。"},{"spoiler":false,"text":"以前の面影はどこにもなく、ただひたすら快楽を求め、"},{"spoiler":false,"text":"まぐわい続けている。"}],"source":"egs","sourceCharacterId":"13925","sourceWorkId":"10459","spoiler":false},{"segments":[{"spoiler":false,"text":"見習いの戦乙女で、レイアを助けにデュークの命を狙ったのも今は昔。"},{"spoiler":false,"text":"すっかり、みんなから空気扱いされていじめられる姿が板に付いてしまった。"},{"spoiler":false,"text":"仕返しに姿を消す薬を飲んで悪戯しまくり、ストレス解消していたが……。"}],"source":"egs","sourceCharacterId":"13925","sourceWorkId":"11296","spoiler":false},{"segments":[{"spoiler":false,"text":"ヴァルキリーに憧れている少女で、自分もいつかはヴァルキリーのようになりたいと思っています。今は見習いの女神です。"},{"spoiler":false,"text":"スクルドは男と悪魔が大嫌いで、ヴァルキリーのことを心の底から愛しています。"},{"spoiler":false,"text":"基本的には気が強く意地っ張りの元気っ娘です。"},{"spoiler":false,"text":"しかし、ヴァルキリーやフレイア等、気を許した相手には素直でよい子です。"},{"spoiler":false,"text":"男が嫌いですが、それよりも悪魔自体が大嫌いです。"},{"spoiler":false,"text":"絶対正義の精神を持っているため、悪魔を根絶やしにしようと思っています。"}],"source":"bangumi","sourceCharacterId":"94751"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c188583461a8e1ed7eb9cbffefa7ea0f13ff603322915d557324cd4b2a21d7f7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0cf298fbae04eaf1b573cfdbcc0b39c2f7fad58609915d1fd6c729bf36fe0e66.webp","width":150,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本井えみ","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229573:94751:4177:1","source":"bangumi"}]},{"characterId":"char_c30004","characterName":"フェンリル","sourceIds":{"bangumi":[{"characterId":"94752","match":"exact-normalized-name-in-linked-work","subjectId":"229571"},{"characterId":"94752","match":"exact-normalized-name-in-linked-work","subjectId":"229572"},{"characterId":"94752","match":"exact-normalized-name-in-linked-work","subjectId":"229573"}],"egsCharacterIds":["13926"],"vndbCharacterId":"c30004"},"originalCharacterName":"フェンリル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"170cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"54Kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔族のみで構成された「魔法騎士団」の団長。主人公のお目付け役。"},{"spoiler":false,"text":"主人公とも地位は変わらないが、人間と魔族のハーフである主人公と違い、純血の魔族で、由緒ある血統を持つ魔族のエリート。"},{"spoiler":false,"text":"性格は気が強く、高慢だが、それは自身の弱さを隠すための虚勢でしかなく、またその身分の高さから、なかなか素直になれない。"},{"spoiler":false,"text":"胸が大きく、挑発的なスタイルをしているが、そうした見た目に反して貞操観念が強い。"},{"spoiler":false,"text":"ハーフで身分の低い主人公を小馬鹿にしているが、密かに好意を抱いている。"}],"source":"egs","sourceCharacterId":"13926","sourceWorkId":"3786","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公によって調教、籠絡され、"},{"spoiler":false,"text":"完全な性奴隷へと堕ちた前作のヒロインたち。"},{"spoiler":false,"text":"以前の面影はどこにもなく、ただひたすら快楽を求め、"},{"spoiler":false,"text":"まぐわい続けている。"}],"source":"egs","sourceCharacterId":"13926","sourceWorkId":"10459","spoiler":false},{"segments":[{"spoiler":false,"text":"元々デュークのお目付け役として魔界の上層部から送り込まれた魔族のエリート。"},{"spoiler":false,"text":"今ではデュークにすっかり心を奪われてしまった。"},{"spoiler":false,"text":"身体は完全に雌奴隷に堕ちきっているものの、態度は素直じゃないまま。"},{"spoiler":false,"text":"疲れて自室に帰ってきたデュークを、かいがいしく世話するのだが……。"}],"source":"egs","sourceCharacterId":"13926","sourceWorkId":"11296","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法と剣を同時に支える完全な魔族のみで構成された『魔法騎士団』の団長です。"},{"spoiler":false,"text":"地位は主人公と同じですが『エリート集団のトップ』で、さらに由緒ある血統なため、"},{"spoiler":false,"text":"魔界内においては比較にならないほどの身分差があります。"},{"spoiler":false,"text":"完全な魔族であるフェンリルは、人間の血が流れている主人公のことをいつも小馬鹿にしています。"},{"spoiler":false,"text":"魔王が任命した主人公のお目付役で、常に主人公を監視しています。"},{"spoiler":false,"text":"見た目よりも貞操観念が強く、一度主人公とエッチするとヴァルキリーにかなり強い嫉妬を抱いたりします。"},{"spoiler":false,"text":"気が強く高慢ですが、それは寂しさや自身の弱さを隠すために虚勢を張っているだけです。"},{"spoiler":false,"text":"気高いので心を許した相手でも素直になることが出来ません。"}],"source":"bangumi","sourceCharacterId":"94752"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb08edb6485355a28c35a1c9d7722b1e4b7e0fc1dea96467a176633c28b3ef03.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f26c13f12cd1594fa7accdd43e89de14884d51bf7620a5c950064d09396203ab.webp","width":183,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あらいしずか","creatorId":"vndb:s665","sourcePersonId":"vndb:s665","canonicalEntityId":"vndb:s665","name":"あらい しずか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229573:94752:4647:1","source":"bangumi"}]},{"characterId":"char_c31732","characterName":"アリーヤ","sourceIds":{"bangumi":[{"characterId":"94754","match":"exact-normalized-name-in-linked-work","subjectId":"229572"},{"characterId":"94754","match":"exact-normalized-name-in-linked-work","subjectId":"229573"}],"egsCharacterIds":["13928"],"vndbCharacterId":"c31732"},"originalCharacterName":"アリーヤ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"171cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":":54Kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"レイアより強大な力を持った「残月の戦乙女」。"},{"spoiler":false,"text":"冷静、冷徹な性格で、信奉しているオーディンの命ならば、"},{"spoiler":false,"text":"どんなことでもこなす強い信念を持っている。"},{"spoiler":false,"text":"月の満ち欠けにより女神の力が変化するため、"},{"spoiler":false,"text":"新月、月食の時には、女神の加護を受けられず、"},{"spoiler":false,"text":"膣内射精されると確実に妊娠してしまう弱点がある。"}],"source":"egs","sourceCharacterId":"13928","sourceWorkId":"10459","spoiler":false},{"segments":[{"spoiler":false,"text":"天界最強の戦乙女だったが、レイアの裏切りにあってデュークに調教された。"},{"spoiler":false,"text":"女として自我に目覚めた彼女は、自分の意思でオーディンと袂を分かつ。"},{"spoiler":false,"text":"ラグナロク後、デュークの元にとどまったアリーヤは、"},{"spoiler":false,"text":"かいがいしく彼の色んな世話を焼いた。"},{"spoiler":false,"text":"しかし、いまだ彼の事を『デューク』と呼べず、"},{"spoiler":false,"text":"距離感を抱いていることに悩んでいた。"}],"source":"egs","sourceCharacterId":"13928","sourceWorkId":"11296","spoiler":false},{"segments":[{"spoiler":false,"text":"天界最強の戦女神だったが、レイアの裏切りにあってデュークの調教を受ける。"},{"spoiler":false,"text":"女としての自我に目覚めたアーリヤは、自分の意思でオーディンと袂を分かち、デュークの側についた。"},{"spoiler":false,"text":"ラグナロク後、デュークの元に留まったアーリヤだったが、デュークのことをいまだに名前で呼べず、やきもきしている。"},{"spoiler":false,"text":"そこで、他の女性たちにアドバイスを請うのだが……。"}],"source":"bangumi","sourceCharacterId":"94754"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/837b4a05e549ae88a3ef451e6d4794eb12dc53b00c8cf8d3a2b88b1bb32a21ff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70be8be8161a0f86ef3c0c12dd5ac340e57b0eb904080b2573de68634228c39d.webp","width":222,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229573:94754:4832:1","source":"bangumi"}]},{"characterId":"char_c31733","characterName":"ヒルデガード","sourceIds":{"bangumi":[{"characterId":"94755","match":"exact-normalized-name-in-linked-work","subjectId":"229572"},{"characterId":"94755","match":"exact-normalized-name-in-linked-work","subjectId":"229573"}],"egsCharacterIds":["13929"],"vndbCharacterId":"c31733"},"originalCharacterName":"ヒルデガード","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"162cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"48Kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大神・オーディンの娘で、陽だまりのような温かさを持つ「大地の戦乙女」。"},{"spoiler":false,"text":"天界の防衛についていたが、囚われた二人の戦乙女を奪回するため、"},{"spoiler":false,"text":"オーディンの制止を振り切って、単身、魔界へ攻め込んでくる。"},{"spoiler":false,"text":"だが、二人の戦乙女を人質に取られ、"},{"spoiler":false,"text":"結局、魔族側に囚われ、凌辱調教の餌食になってしまう。"},{"spoiler":false,"text":"その際、オーディンへの見せしめのため、調教されている映像が"},{"spoiler":false,"text":"天界へと実況されることに……。"}],"source":"egs","sourceCharacterId":"13929","sourceWorkId":"10459","spoiler":false},{"segments":[{"spoiler":false,"text":"天界を統べる大神・オーディンの娘。"},{"spoiler":false,"text":"レイアとアーリアを助けるべくデュークの居城に乗り込んでくるが、あえなく調教。"},{"spoiler":false,"text":"ミッドガルドの治安を守るという名目でデュークの傍にいるが、"},{"spoiler":false,"text":"父親へ実況中継をされながら調教を受けたため、"},{"spoiler":false,"text":"他人の視線を感じないとイケない身体になってしまった。"}],"source":"egs","sourceCharacterId":"13929","sourceWorkId":"11296","spoiler":false},{"segments":[{"spoiler":false,"text":"天界を統べる大神・オーディンの娘で、レイアとアリーヤを助けるべく"},{"spoiler":false,"text":"デュークの居城に乗り込んでくるが、あえなく調教されてしまった。"},{"spoiler":false,"text":"ミッドガルドの治安を守るという名目でデュークの側にいるが、父親に実況中継されながら"},{"spoiler":false,"text":"調教を受けたため、他人の視線を感じないとイケない身体になってしまった。"}],"source":"bangumi","sourceCharacterId":"94755"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/795925c414f6e2f0c5196d7250780c62442b9eaf1a52fd27e2590de4f5c31d3e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/ddf74de282ecb0d4d2ff1574b4957c05582730c952867e93141c18b8027ca37f.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"米島希","creatorId":"vndb:s281","sourcePersonId":"vndb:s281","canonicalEntityId":"vndb:s281","name":"米島 希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229573:94755:8055:1","source":"bangumi"}]},{"characterId":"char_c31734","characterName":"ファフニール","sourceIds":{"bangumi":[{"characterId":"94756","match":"exact-normalized-name-in-linked-work","subjectId":"229572"},{"characterId":"94756","match":"exact-normalized-name-in-linked-work","subjectId":"229573"}],"egsCharacterIds":["13930"],"vndbCharacterId":"c31734"},"originalCharacterName":"ファフニール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"170cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"80Kg（羽・尻尾20kg含む）"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公に籠絡され、骨抜きになったフェンリルの代わりに、"},{"spoiler":false,"text":"監視役となった超竜騎士団団長。"},{"spoiler":false,"text":"魔族とドラゴンのハーフで、圧倒的な戦闘力を誇り、"},{"spoiler":false,"text":"短気で怒りっぽい性格だが、面倒見の良い姉御肌気質でもあるため、"},{"spoiler":false,"text":"部下からの信頼は厚い。"},{"spoiler":false,"text":"実は、戦いに明け暮れていたため男性経験がない生娘。"},{"spoiler":false,"text":"それをひた隠しにしていたが主人公に見抜かれ、口止めのため処女を奪われることに。"}],"source":"egs","sourceCharacterId":"13930","sourceWorkId":"10459","spoiler":false},{"segments":[{"spoiler":false,"text":"フェンリルに代わってデュークの監視役になった魔族とドラゴンのハーフ。"},{"spoiler":false,"text":"本人は恥ずかしくて隠していたが、処女であることをデュークに見抜かれた。"},{"spoiler":false,"text":"そして、口止めにデュークに処女を捧げてしまった。"},{"spoiler":false,"text":"デュークの手で女にされたあとも、周囲に処女だったことをバラされたくないため"},{"spoiler":false,"text":"デュークのいいなりになっている。"}],"source":"egs","sourceCharacterId":"13930","sourceWorkId":"11296","spoiler":false},{"segments":[{"spoiler":false,"text":"フェンリルに代わってデュークの監視役になった魔族とドラゴンのハーフ。"},{"spoiler":false,"text":"本人は恥ずかしくて隠していたが、処女であることをデュークに見抜かれ、"},{"spoiler":false,"text":"口止めのために処女をデュークに捧げてしまった。"},{"spoiler":false,"text":"デュークの手で女にされた後も、周りに処女だったことをバラされたくないため、デュークのいいなりになっている。"}],"source":"bangumi","sourceCharacterId":"94756"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77caa00c6552299a554e62a1e63e744701330f320a3fcf6a8086d6d848a4a406.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/403b3825a3d5ac17d0794800273780530abbe8427a515187a926e80a671efe07.webp","width":256,"height":249,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229573:94756:4956:1","source":"bangumi"}]},{"characterId":"char_c31735","characterName":"ロキ","sourceIds":{"bangumi":[{"characterId":"94757","match":"exact-normalized-name-in-linked-work","subjectId":"229572"},{"characterId":"94757","match":"exact-normalized-name-in-linked-work","subjectId":"229573"}],"egsCharacterIds":["13931"],"vndbCharacterId":"c31735"},"originalCharacterName":"ロキ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"オーディンの側近を務めていた半神半魔の美女。"},{"spoiler":false,"text":"しかし、人間ごと魔族を滅ぼそうとするオーディンに愛想を尽かし、"},{"spoiler":false,"text":"魔族側である主人公に接触してくる。"},{"spoiler":false,"text":"何を考えているのかわからないミステリアスな雰囲気を纏い、"},{"spoiler":false,"text":"その出生から、自分の身体を「ふたなり」にすることもできる。"},{"spoiler":false,"text":"魔族と人間のハーフである主人公自身にも興味を持っている様子だが……。"}],"source":"egs","sourceCharacterId":"13931","sourceWorkId":"10459","spoiler":false},{"segments":[{"spoiler":false,"text":"ラグナロクを引き起こした張本人。"},{"spoiler":false,"text":"アースガルドの隠れ家で次の手を考えていた。"},{"spoiler":false,"text":"思案の末、逃げ出したオーディンの代わりに、ヒルデガードを傀儡として"},{"spoiler":false,"text":"アースガルドの新しい盟主に据えて裏から操ることを思いつく。"},{"spoiler":false,"text":"そのために大胆にもミッドガルドに舞い戻り、"},{"spoiler":false,"text":"デュークの虜になっているヒルデガードを奪いにやってくるが……。"}],"source":"egs","sourceCharacterId":"13931","sourceWorkId":"11296","spoiler":false},{"segments":[{"spoiler":false,"text":"ラグナロクを引き起こした張本人であるロキはアースガルドの隠れ家で次の手を考えていた。"},{"spoiler":false,"text":"思案のすえ、逃げ出したオーディンの代わりにヒルデガードを傀儡としてアースガルドの"},{"spoiler":false,"text":"新しい盟主にすえ、自分は裏から彼女を操ろうと思いつく。"},{"spoiler":false,"text":"大胆にもミッドガルドに舞い戻り、デュークの虜となっているヒルデガードを奪いにやってくるが……。"}],"source":"bangumi","sourceCharacterId":"94757"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42c12a530a747d75b5fd79d34232e41d31db2c899d250789a46022aa3606428b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1a790cec81ea4c9d1a331a6196f46c9ed18affa6a6340938846179db99602d9.webp","width":148,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229573:94757:5741:1","source":"bangumi"}]},{"characterId":"char_vndb_c127559","characterName":"デューク","sourceIds":{"vndbCharacterId":"c127559"},"originalCharacterName":"デューク","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"