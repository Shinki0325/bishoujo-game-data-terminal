":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_187908","characterName":"ひなうら しぐれ","sourceIds":{"bangumi":[{"characterId":"187908","match":"source-roster","subjectId":"378106"}]},"originalCharacterName":"ひなうら しぐれ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"竜胆流忍術を開祖とする雛浦薙刀術、免許皆伝の腕前をもつ。"},{"spoiler":false,"text":"現在は小夜学園に通う一年生で、ヤツハの後輩にあたる。"},{"spoiler":false,"text":"幼馴染であるヤツハとは恋仲。"},{"spoiler":false,"text":"厳しそうな見た目とはうらはらに、ヤツハの下着を巧みに入手し"},{"spoiler":false,"text":"それをおかずにオナニーしようとしたりと、特殊で意外な一面がある。"},{"spoiler":false,"text":"もちろんスケベは好き……"}],"source":"bangumi","sourceCharacterId":"187908"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcfaaa52374bb2bbe7234225daffddce7dba1d3e9242668f4216b5048250e1bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/746f08d7cd1ff649645affc9b811468bb55d1425ebf5d0acd2e341942a7e4623.webp","width":194,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_187909","characterName":"くぬぎみや ゆえ","sourceIds":{"bangumi":[{"characterId":"187909","match":"source-roster","subjectId":"378106"}]},"originalCharacterName":"くぬぎみや ゆえ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"古来より満月野に現れる異形、妖魔と戦っていた椚木宮家出身の巫女。"},{"spoiler":false,"text":"小夜学園に通う三年生で『小さくて可愛い先輩』と後輩からは覚えられている。"},{"spoiler":false,"text":"パートナーである都々栗コキアとは恋仲。"},{"spoiler":false,"text":"可愛い見た目とは違い、言葉には鋭さがあるときも。"},{"spoiler":false,"text":"一人で男湯に潜入捜査をしたりと、仲間に危ないことをさせないよう尽力する優しい一面を兼ね備えている。"},{"spoiler":false,"text":"もちろん淫行は好き……"}],"source":"bangumi","sourceCharacterId":"187909"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b2024b7c85b87fb8f0e38e611536d436266ada37efb61907081c1d38ed5bd4d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4dd8d0c758ff3aedbd85810939b6a410a0cd62a05878c7e51de85e889bf562cb.webp","width":194,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_187910","characterName":"つつぐり こきあ","sourceIds":{"bangumi":[{"characterId":"187910","match":"source-roster","subjectId":"378106"}]},"originalCharacterName":"つつぐり こきあ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"町を守る椚木宮家の巫女を護衛し、陰から支える使命を帯びた家の出身。"},{"spoiler":false,"text":"武器は細剣を扱い、実力はヤツハやしぐれに勝るとも劣らない。"},{"spoiler":false,"text":"現在は小夜学園に通う三年生で、護衛対象のゆえとは恋仲。"},{"spoiler":false,"text":"しかし見た目はゆえの正反対で長身ダイナマイトボディ。"},{"spoiler":false,"text":"おっとりしているお姉さんのような雰囲気だが、"},{"spoiler":false,"text":"エッチのときには責め続けることもあり強気な一面も。"},{"spoiler":false,"text":"もちろん色事は好き……"}],"source":"bangumi","sourceCharacterId":"187910"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2ace2e53f3fc59b7d83a06423794814e1850c470075f8c8ed3544156a18084a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c1419127d604a8d338ee0de343856f9190b806109e186fd0e85bf15303bb067.webp","width":194,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:5185","sourceCompanyId":"egs:brand:5185","canonicalEntityId":"egs:brand:5185","name":"月の水企画 -NewMoonLabel-","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:wor