{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"31614","model":{"presentationWorkId":"vndb:v32239","staff":{"artwork":[{"creditedName":"深泥正","creatorId":"vndb:s2572","sourcePersonId":"egs:creator:2428","canonicalEntityId":"vndb:s2572","name":"深泥正","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:238763","source":"egs"}],"scenario":[{"creditedName":"巽ヒロヲ","creatorId":"vndb:s2300","sourcePersonId":"egs:creator:1839","canonicalEntityId":"vndb:s2300","name":"巽ヒロヲ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:238764","source":"egs"}],"music":[],"other":[{"creditedName":"巽 ヒロヲ","creatorId":"vndb:s2300","sourcePersonId":"vndb:s2300","canonicalEntityId":"vndb:s2300","name":"巽 ヒロヲ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:177735","source":"vndb"}]},"cast":[{"characterId":"char_c100071","characterName":"家永 美桜","sourceIds":{"bangumi":[{"characterId":"105954","match":"exact-normalized-name-in-linked-work","subjectId":"360517"}],"egsCharacterIds":["23627"],"vndbCharacterId":"c100071"},"originalCharacterName":"家永 美桜","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Heroine of the story. When she was a high school student, she got molested on bus daily by a certain someone. However, she was too scared to confirm the culprit and just easily admitted the protagonist was the molester all along when her future husband who is a lawyer with strong sense of justice called him out."},{"spoiler":false,"text":"Ironically, this event was not only the fateful encounter for her and her beloved husband to get together but also the trigger of her ultimate misfortune which comes later when her life is at peak of happiness."}],"source":"vndb","sourceCharacterId":"c100071"},{"segments":[{"spoiler":false,"text":"本作品のヒロイン。"},{"spoiler":false,"text":"夫である雅芳を尊敬し愛する、真面目で貞淑な性格の人妻。"},{"spoiler":false,"text":"学生時代に痴漢被害にあっていたところを、新人弁護士だった雅芳に助けられ、雅芳とともに沼倉を犯人と信じ込み実刑に追い込む。"},{"spoiler":false,"text":"このことがきっかけで、雅芳と結婚し幸せな生活を送っている。"},{"spoiler":false,"text":"実は内心で専業夫婦生活に寂しさを覚え、また子宝に恵まれないことに悩んでいる。"},{"spoiler":false,"text":"専業主婦として時間を持て余していたこともあり、高級リラクゼーションサロン店『アロマ』の会員となり、通い始める。"}],"source":"egs","sourceCharacterId":"23627","sourceWorkId":"31614","spoiler":false},{"segments":[{"spoiler":false,"text":"本作品のヒロイン。"},{"spoiler":false,"text":"夫である雅芳を尊敬し愛する、真面目で貞淑な性格の人妻。"},{"spoiler":false,"text":"学生時代に、痴漢被害にあっていたところを、新人弁護士だった雅芳に助けられ、"},{"spoiler":false,"text":"雅芳とともに沼倉を犯人と信じ込み実刑に追い込む。"},{"spoiler":false,"text":"このことがきっかけで、雅芳と結婚し、幸せな生活を送っている。"},{"spoiler":false,"text":"実は内心で専業主婦生活に寂しさを覚え、また子宝に恵まれないことに悩んでいる。"},{"spoiler":false,"text":"専業主婦としての時間を持て余していたこともあり、"},{"spoiler":false,"text":"高級リラクゼーションサロン店『AROMA』の会員となり、通い始める。"}],"source":"bangumi","sourceCharacterId":"105954"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"23627","sourceWorkId":"31614","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"23627","sourceWorkId":"31614","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"23627","sourceWorkId":"31614","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a42a4912ee0838106a853ff732da4e02f43a330c9370ee252ad8949abc4f5302.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c69c54f54d3caf56ff1620926d99cfcebd200d4a6bc624efefc075018830796d.webp","width":91,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:360517:105954:6351:1","source":"bangumi"}]},{"characterId":"char_vndb_c100072","characterName":"沼倉 精治","sourceIds":{"vndbCharacterId":"c100072"},"originalCharacterName":"沼倉 精治","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Protagonist of the story. When he was young, his father committed suicide after being framed by the others and his mother also died from exhaustion of raising him alone. Therefore, he is very sensitive about false accusation."},{"spoiler":false,"text":"As if fate played cruel trick on him, he lost everything after receiving a jail sentence due to false accusation of molester from a young lawyer when he was trying to help a high school girl from the real molester on bus."},{"spoiler":false,"text":"While watching TV in jail, he gets furious when seeing the hateful couple got married to each other and is enjoying their life full of happiness after ruining his life. When he swears to take revenge, his conman jail mate teaches him about the special aroma which can hypnotize people."},{"spoiler":false,"text":"After getting his long-awaited freedom again, he takes advantage of his new trick to change his outward appearance, obtain fame and money in order to realize his goal of vengeance."}],"source":"vndb","sourceCharacterId":"c100072"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"ht