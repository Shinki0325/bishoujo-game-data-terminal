rce-native","relationId":"vndb:vn-staff:139349","source":"vndb"},{"creditedName":"三好 弘二","creatorId":"vndb:s14013","sourcePersonId":"vndb:s14013","canonicalEntityId":"vndb:s14013","name":"三好 弘二","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:139350","source":"vndb"},{"creditedName":"W.Dee","creatorId":"vndb:s14425","sourcePersonId":"vndb:s14425","canonicalEntityId":"vndb:s14425","name":"W.Dee","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:139351","source":"vndb"},{"creditedName":"梅鳥 うりり","creatorId":"vndb:s1081","sourcePersonId":"vndb:s1081","canonicalEntityId":"vndb:s1081","name":"梅鳥 うりり","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:139352","source":"vndb"},{"creditedName":"BB","creatorId":"vndb:s52261","sourcePersonId":"vndb:s52261","canonicalEntityId":"vndb:s52261","name":"BB","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:139354","source":"vndb"}]},"cast":[{"characterId":"char_c62570","characterName":"楠田 友彦","sourceIds":{"bangumi":[],"egsCharacterIds":["17574"],"vndbCharacterId":"c62570"},"originalCharacterName":"楠田 友彦","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Husband of Misa and father of Tomomi. He loves his wife and daughter but recently he felt that his daughter has been cold towards him.So he uses a health device from work to bring out his daughter hidden feelings towards him but in the process brings out his hidden feelings for his daughter as well."}],"source":"vndb","sourceCharacterId":"c62570"},{"segments":[{"spoiler":false,"text":"学生の頃、大恋愛の末に美佐枝を孕ませてでき婚。"},{"spoiler":false,"text":"学生結婚、さらには子育てをしながらの学生生活に苦労をしたが、二人で力を合わせてそれを乗り切り、今に至る。"},{"spoiler":false,"text":"そんな経緯もあってか、生活が安定した今の時点で、新婚気分を満喫しているような所がある。"},{"spoiler":false,"text":"子供については、学生時代は当然ながら第二子を考えている余裕も無く、定期的に美佐枝との性交渉はあるが、娘である友美が大きくなってしまった事もあって、なんとなく二人目に踏みきれずにいる。"},{"spoiler":false,"text":"大学卒業後は電気機器メーカーに就職。"},{"spoiler":false,"text":"今ではそのメーカーの健康機器開発部門で、開発主任を務めている。"},{"spoiler":false,"text":"実直で職人気質の技術者であり、社内での人望は厚い。"},{"spoiler":false,"text":"……が、一目惚れした美佐枝とつきあい始めて間を置かず結婚した為、恋愛面などでの女性心理に疎く、年頃になった友美との接し方に苦慮した結果、「状況をなんとか技術で解決しよう！」という技術者的思考に走り、それが事の発端となってしまう。"}],"source":"egs","sourceCharacterId":"17574","sourceWorkId":"25047","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_c62571","characterName":"楠田　美佐枝","sourceIds":{"bangumi":[{"characterId":"54414","match":"exact-normalized-name-in-linked-work","subjectId":"215972"}],"egsCharacterIds":["17573"],"vndbCharacterId":"c62571"},"originalCharacterName":"楠田　美佐枝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist wife and mother of Tomomi. She loves her husband and daughter dearly. She tells he husband that Tomomi is going through a phase."}],"source":"vndb","sourceCharacterId":"c62571"},{"segments":[{"spoiler":false,"text":"主人公の妻であり、友美の母親。"},{"spoiler":false,"text":"美人と言うより可愛い系で、俗に「娘と並んでいると姉妹のように見える」と言われるタイプ。"},{"spoiler":false,"text":"裏腹に、プロポーションはムッチリ系で巨乳、まだ発展途中の友美は、そんな母親のプロポーションにややコンプレックスを感じている。"},{"spoiler":false,"text":"世話好きで包容力のある、明るく、大らかな性格。"},{"spoiler":false,"text":"おっとりしていますが、芯は強いタイプ。"},{"spoiler":false,"text":"世間知らずという訳ではないが、やや世間とはズレた所があり、物事を人とは違った捉え方をする事もしばしば。"}],"source":"egs","sourceCharacterId":"17573","sourceWorkId":"25047","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の愛妻で、友美の母親。"},{"spoiler":false,"text":"包容力があり世話好きで、明る大らかなタイプ。"},{"spoiler":false,"text":"おっとりしているが芯は強い。"},{"spoiler":false,"text":"娘と並んでいると、姉妹に間違われるほど若々しく可愛い容姿。"},{"spoiler":false,"text":"やや世間とはズレたところがあり、人とは違った物事の捉え方をすることがしばしば。"}],"source":"bangumi","sourceCharacterId":"54414"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e297114b5347e929478865fab1c5588776ff62aa0e8333b1d4770281b5429944.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6aa939a150e10c33c1264544c9d8f87f785769acae31fc3aa45d0fdcc9ec3a51.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"平野響子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:215972:54414:5669:1","source":"bangumi"}]},{"characterId":"char_c62572","characterName":"楠田　友美","sourceIds":{"bangumi":[{"characterId":"54413","match":"exact-normalized-name-in-linked-work","subjectId":"215972"}],"egsCharacterIds":["17572"],"vndbCharacterId":"c62572"},"originalCharacterName":"楠田　友美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist and Misa daughter. She hides the fact she is in love with her father and dose not wish to destroy the relationship of her parents. she acts cold towards her father until he uses a health device to bring out her hidden feelings towards him"}],"source":"vndb","sourceCharacterId":"c62572"},{"segments":[{"spoiler":false,"text":"童顔で、どちらかというと可愛い系だが、ふと大人びた表情も見せる。"},{"spoiler":false,"text":"胸はまだ発展途中といった感じの美乳系で、母親譲りであれば将来は巨乳間違いなし。"},{"spoiler":false,"text":"主人公と美佐枝の娘で、衆目を集めるといった派手さは無く、「お、可愛い」ぐらいの感想を持たれるような、ごく普通の女子学生。"},{"spoiler":false,"text":"性格的にも、大人しめですが明るく素直な性格。"},{"spoiler":false,"text":"ただ、一度決めたら譲らないという頑固な一面もある。"}],"source":"egs","sourceCharacterId":"17572","sourceWorkId":"25047","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と妻・美佐枝の愛娘。"},{"spoiler":false,"text":"おとなしめだが明るく素直な性格。 一度決めたら譲らない頑固な一面も。"},{"spoiler":false,"text":"小さい頃はパパっ娘だったが、次第に異性としての好意が高まってしまい、"},{"spoiler":false,"text":"その気持ちを封印するために避けるようになってしまった。"},{"spoiler":false,"text":"本音を引き出す装置によって昔のように甘えられるようになるが、"},{"spoiler":false,"text":"同時に封印していた気持ちも抑えられなくなってしまい……。"}],"source":"bangumi","sourceCharacterId":"54413"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/2807b7c752a493c8e41b3b2fca117a55e9de70646445ee9b7448c06a2f25120a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/709d5d2419d5c8fb53157b5732589326b0b4762ad6ca7f71229c62ea9e24c42a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:215972:54413:4799:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p1079","sourceCompanyId":"egs:brand:2272","canonicalEntityId":"vndb:p1079","name":"オーバードーズ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:25047:2272","source":"egs"},{"companyId":"vndb:p15756","sourceCompanyId":"vndb:p15756","canonicalEntityId":"vndb:p15756","name":"SVN","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:131841:v21007","source":"vndb"},{"companyId":"vndb:p1079","sourceCompanyId":"vndb:p1079","canonicalEntityId":"vndb:p1079","name":"オーバードーズ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:58147:v21007","source":"vndb"},{"companyId":"vndb:p1079","sourceCompanyId":"vndb:p1079","canonicalEntityId":"vndb:p1079","name":