ndb","value":"1214"},"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"},"weight":{"reviewState":"source-only","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious princess the Hero meets in the Demon Castle."},{"spoiler":false,"text":"Uses summoning magic to summon the hero Hero to aid her escape from the Demon Castle."},{"spoiler":false,"text":"According to herself, the princess of a small and isolated island kingdom off the coast of the continent of Maygard."},{"spoiler":false,"text":"Having had very little contact with others, she has long dreamed of making friends."},{"spoiler":false,"text":"Because of this background, while Julietta rarely initiates conversation she always makes sure to properly answer when someone speaks to her, even if in an awkward manner. While she may be an introvert, that does not mean she is bad at communicating."}],"source":"vndb","sourceCharacterId":"c145124"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae1190514be985d983e69a4760a1b57a6748bc5365684378134da080f4795374.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f506757e5e60b71388526977c09f1b8b012ff738f7a30f28eb765d5479efcd0.webp","width":190,"height":256,"source":"static-detail"},"actors":[{"creditedName":"豊田 萌絵","creatorId":"vndb:s5721","sourcePersonId":"vndb:s5721","canonicalEntityId":"vndb:s5721","name":"豊田萌絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99397","source":"vndb"}]},{"characterId":"char_vndb_c145126","characterName":"ハメハメハ","sourceIds":{"vndbChara