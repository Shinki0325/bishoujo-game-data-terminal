date","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A stern female knight who swore her allegiance to Aria."},{"spoiler":false,"text":"A leader-like figure to the group, always troubled by the other girls' freewheeling actions."},{"spoiler":false,"text":"A keen and observant person, Charlotte understands the strengths and weaknesses of each party member and is able to give out orders appropriate to the situation, displaying her talent as a commander."},{"spoiler":false,"text":"While calm, collected, and able to be relied on most of the time, when Charlotte loses control of her emotions she loses sight of her surroundings, often repeating the phrase \"Ugh, kill me!\""}],"source":"vndb","sourceCharacterId":"c145875"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3d5a551ef771dcd0e3965c3ff16396d00bf5546ba5e969f60fc99bab562ff81.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d4b518765e19f62cce91990677baae34e424ad7b6a99bfb9685f580fc071f9c.webp","width":190,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中有紀","creatorId":"vndb:s36280","sourcePersonId":"vndb:s36280","canonicalEntityId":"vndb:s36280","name":"田中有紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99403","source":"vndb"}]},{"characterId":"char_vndb_c145876","characterName":"フィナンシェ","sourceIds":{"vndbCharacterId":"c145876"},"originalCharacterName":"フィナンシェ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mage from the kingdom of Aria Zaza."},{"spoiler":false,"text":"An apprentice to the sage who previously accompanied the Hero on his journey."},{"spoiler":false,"text":"Having lost her parents at a young age, Finanche was raised by the sage in their stead. To Finanche, the sage is both her master and a parental figure."},{"spoiler":false,"text":"In order to pay back the sage for having raised her, Finanche studied hard to become a skilled mage."},{"spoiler":false,"text":"Because of this past, she blames the Hero for the death of the sage and looks down on him as lacking in ability."}],"source":"vndb","sourceCharacterId":"c145876"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cb0719d7d7c3f46759a86a8126f221e18d79d91aba9a92db08bd3368cb51a6e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8724469b1c3c5014e51303e95a84eec73e16cc2c0628f52e4d44f6197c00784.webp","width":190,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上 ほの花","creatorId":"vndb:s20413","sourcePersonId":"vndb:s20413","canonicalEntityId":"vndb:s20413","name":"井上ほの花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99402","source":"vndb"}]},{"characterId":"char_vndb_c145877","characterName":"シューケット","sourceIds":{"vndbCharacterId":"c145877"},"originalCharacterName":"シューケット","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A dark elf and former bandit who now serves Aria."},{"spoiler":false,"text":"Becoming a bandit in order to provide for her kind, hated and looked down upon by the citizens of Aria Zaza, Chouquette was apprehended by Charlotte and became a prisoner awaiting execution."},{"spoiler":false,"text":"However, Aria, upon hearing the struggles of Chouquette and the dark elves, extended her support to them and spared Chouquette's life on the condition that she become Aria's personal guard. Moved by Aria's open-heartedness, Chouquette pledged her loyalty to Aria."}],"source":"vndb","sourceCharacterId":"c145877"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c35799794e9f403c7d253fa86e289de385d6f59594a94288f829c002caa75a9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc3e3acb370677c020e807bdda279ff043a3537ce0f018bc81fb11f4625580a9.webp","width":190,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真野 あゆみ","creatorId":"vndb:s18145","sourcePersonId":"vndb:s18145","canonicalEntityId":"vndb:s18145","name":"真野 あゆみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99399","source":"vndb"}]},{"characterId":"char_vndb_c145878","characterName":"ガナッシュ","sourceIds":{"vndbCharacterId":"c145878"},"originalCharacterName":"ガナッシュ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A bikini-armor clad warrior serving the kingdom of Zanji Zard."},{"spoiler":false,"text":"A firm believer of the mantra that \"Strength is power,\" Ganache looks down on technical skill in combat as second-rate. Because of this she often finds herself in conflict with Zena, a master swordsman, to the point that other party members have become fed up and refuse to engage with their arguments."},{"spoiler":false,"text":"Prone to taking action without thinking it through, Ganache often causes many problems. However, she also often manages to solve those same problems with her sheer strength."}],"source":"vndb","sourceCharacterId":"c145878"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/507288d2ec19add8d7a304b0ca89ad534c0ae0768d97684bf6594fe3cb47556f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71411eee2b3eab9bbcd4c329c4deef650fb3d489cb942695f0ad42b6b6565075.webp","width":190,"height":256,"source":"static-detail"},"actors":[{"creditedName":"社本 悠","creatorId":"vndb:s52584","sourcePersonId":"vndb:s52584","canonicalEntityId":"vndb:s52584","name":"社本 悠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99404","source":"vndb"}]},{"characterId":"char_vndb_c145879","characterName":"スフレ","sourceIds":{"vndbCharacterId":"c145879"},"originalCharacterName":"スフレ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A martial artist from Zanji Zard."},{"spoiler":false,"text":"The winner of a martial arts tournament held in Zanji Zard, Souffle was scouted by Zena for her fighting abilities to join her journey. Her response to Zena's invitation was: \"That sounds interesting! Okay!\""},{"spoiler":false,"text":"Her straightforward personality makes her stand out within the party, and often a word from her is enough to lighten the mood even if the party is faced with a dire situation."}],"source":"vndb","sourceCharacterId":"c145879"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a273825ab7f7652c539e2cc93cc23859e33cfdfa501cd8535d53885cf5f5dd4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/699d7d3d76a5af4bda6e50d6f621408510099dd989e1053d5f0ccc59c773e0e2.webp","width":190,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘 一花","creatorId":"vndb:s52585","sourcePersonId":"vndb:s52585","canonicalEntityId":"vndb:s52585","name":"橘 一花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99405","source":"vndb"}]},{"characterId":"char_vndb_c145880","characterName":"クラフティ","sourceIds":{"vndbCharacterId":"c145880"},"originalCharacterName":"クラフティ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An instructor of swordsmanship in Zanji Zard, and the one who taught Zena all that she knows about swordfighting."},{"spoiler":false,"text":"Loves to drink so much that she sips even during training sessions or while traveling. According to Zena, it is unbelievable how Crafti is able to keep a straight face considering how much she drinks."},{"spoiler":false,"text":"Not the type to care about small details, she carries a loose attitude towards most things. Although she gives off the impression of being constantly carefree, Crafti is capable of acting as a dependable big-sister like figure when the situation demands. Is more put -together than she seems, and for better or for worse her loose attitude pulls the party forward in their journey."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c145880"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d9cbd249345f95c4179f1a0048c3c085eb3d68e0318e0e408c078616ddf7ee5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ceb824a23aaf79e4224db616fb2d88f3031a5b98f85e07357db2d8dcbdee0c1c.webp","width":190,"height":256,"source":"static-detail"},"actors":[{"creditedName":"原田 彩楓","creatorId":"vndb:s18795","sourcePersonId":"vndb:s18795","canonicalEntityId":"vndb:s18795","name":"原田 彩楓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99400","source":"vndb"}]},{"characterId":"char_vndb_c87833","characterName":"アリア","sourceIds":{"vndbCharacterId":"c87833"},"originalCharacterName":"アリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"820"},"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"source-only","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The princess of the kingdom of Aria Zaza."},{"spoiler":false,"text":"Unable to venture far for most of her life, she doesn’t know too much about the world. She’s soft-spoken, but passionate and sincerely hopes for a world where people are happy and live out their lives in peace."},{"spoiler":false,"text":"She says the occasional dumb thing sometimes, but she’s booksmart and her astute, keen reasoning often surprises the people around her. She’s also exceptionally well-versed in magic."},{"spoiler":false,"text":"She has always wished she could meet Princess Zena and that the two could be friends, however, they have not had the fortune of meeting one another."}],"source":"vndb","sourceCharacterId":"c87833"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/8890247c54ae9eb4fa33c3b705b10104fea7abb9feab0ad691877ad1fde62dbd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7c07fbe99db068db6b10eb7c4a85217516