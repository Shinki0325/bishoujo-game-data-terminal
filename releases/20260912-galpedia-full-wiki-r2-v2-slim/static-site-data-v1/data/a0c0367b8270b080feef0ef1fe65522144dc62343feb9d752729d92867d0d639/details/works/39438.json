{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"39438","model":{"presentationWorkId":"vndb:v31727","staff":{"artwork":[{"creditedName":"ゆつき","creatorId":"vndb:s25322","sourcePersonId":"egs:creator:40203","canonicalEntityId":"vndb:s25322","name":"ゆつき","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:297981","source":"egs"}],"scenario":[{"creditedName":"館山緑","creatorId":"vndb:s3429","sourcePersonId":"egs:creator:901","canonicalEntityId":"vndb:s3429","name":"館山緑","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:297982","source":"egs"}],"music":[{"creditedName":"maru","creatorId":"vndb:s2546","sourcePersonId":"vndb:s2546","canonicalEntityId":"vndb:s2546","name":"丸山 公詳","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:176398","source":"vndb"}],"other":[{"creditedName":"Lira","creatorId":"vndb:s2543","sourcePersonId":"vndb:s2543","canonicalEntityId":"vndb:s2543","name":"Lira","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:176396","source":"vndb"},{"creditedName":"Lira","creatorId":"vndb:s2543","sourcePersonId":"vndb:s2543","canonicalEntityId":"vndb:s2543","name":"Lira","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:176397","source":"vndb"},{"creditedName":"館山 緑","creatorId":"vndb:s3429","sourcePersonId":"vndb:s3429","canonicalEntityId":"vndb:s3429","name":"館山緑","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:176400","source":"vndb"},{"creditedName":"KANAMI","creatorId":"vndb:s4333","sourcePersonId":"vndb:s4333","canonicalEntityId":"vndb:s4333","name":"KANAMI","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:176401","source":"vndb"},{"creditedName":"ゆつき","creatorId":"vndb:s25322","sourcePersonId":"vndb:s25322","canonicalEntityId":"vndb:s25322","name":"ゆつき","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:176402","source":"vndb"},{"creditedName":"mion","creatorId":"vndb:s43888","sourcePersonId":"vndb:s43888","canonicalEntityId":"vndb:s43888","name":"mion","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:176404","source":"vndb"}]},"cast":[{"characterId":"char_bangumi_98690","characterName":"ふなびき・あおい","sourceIds":{"bangumi":[{"characterId":"98690","match":"source-roster","subjectId":"168608"}]},"originalCharacterName":"ふなびき・あおい","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"心の傷　弟の殺害"},{"spoiler":false,"text":"１８歳。納賀宮高校三年生。受験生。長い髪、色素薄め。 普段は女の子っぽく見えるが、表情が消えると案外中性的で男っぽく見える時もある。怒ると表情があまり変わらないのに割と怖く感じる。"},{"spoiler":false,"text":"身長１６６センチ。痩せ型。声は静かなアルト。口調は意識して女性らしくしているが、あまりそう感じられない。"},{"spoiler":false,"text":"彼氏なし。ニックネームでは絶対呼ばれないタイプ。女子ばかりが憧れているが、男子には『冷たい眼で一瞥され、あっさり軽蔑されそう』に見えるせいで遠巻きにされている。基本的にはいつも一人でいたがる。"},{"spoiler":false,"text":"かなり美人だが、周囲に緊張を与えるタイプの少女で、一目置かれているがあまり友達にはなりたくないタイプ。その美貌のせいでいろいろ嫌な思いも味わっている。人から遠巻きにされている理由のひとつは、蒼が憑依しているせいで、不気味な気配が時折漂っているからでもある。"},{"spoiler":false,"text":"実は連続殺人を犯していた弟を止めようとして殺したことがあり、そのことが大きな傷となっている。"}],"source":"bangumi","sourceCharacterId":"98690"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7eb4bc5e3098101da431a072f7e72c6b393f7b3762c4150c260f371567c311f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/5749fbfab8f562582029a754268d578ff942fb94bf423366e826161846007d71.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_98691","characterName":"ふなびき・そう","sourceIds":{"bangumi":[{"characterId":"98691","match":"source-roster","subjectId":"168608"}]},"originalCharacterName":"ふなびき・そう","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"心の傷　姉「が」殺されたこと"},{"spoiler":false,"text":"享年１７歳。青の弟。双子ではないが、学年は同じ弟。最終学歴は納賀宮高校二年生。"},{"spoiler":false,"text":"外見はかなり青に似ているが、女性には全く見えない。双子というほど似ていないが、印象はかなり似ている。死んでいるのでそもそも恋人はいない。しかし標準レートが姉なので、結果的にものすごく面食いだろうと思われる。"},{"spoiler":false,"text":"身長１７３センチ。痩せ型。声は静かなテノール。"},{"spoiler":false,"text":"見た感じ冷たいと思われがちだが、ある種の快楽殺人者。何人も人を殺していたが、姉に見つかり殺されてしまった後、ずっと成仏せずに姉に憑依している。本来青には見えていなかったが、地獄へやってきた時から姿を現し、姉の協力者として行動する。"},{"spoiler":false,"text":"姉に殺されたことは怨んでいないが、姉が自分を忘れて幸せになることだけは許さない。形を変えたシスターコンプレックスを抱いている死霊。"}],"source":"bangumi","sourceCharacterId":"98691"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b01a7e085c1c9a450428329aac6b106a72b19410b95befc623b24d37f38a76ec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f097abf78322332c5b2489364844b1541d5cbdee83c5c8a36597318a092795ce.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_98692","characterName":"きくしま・とうじ","sourceIds":{"bangumi":[{"characterId":"98692","match":"source-roster","subjectId":"168608"}]},"originalCharacterName":"きくしま・とうじ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"心の傷　不詳"},{"spoiler":false,"text":"１９歳。大学生。私立七守学園大学の一年。身長１７８センチ。モテそうな感じのいい顔。髪の毛は黒。育ちはよさそうな美男子。穏やかな印象の声が特徴的。"},{"spoiler":false,"text":"彼女はいたが、死亡する半年前には別れており、現在はフリー。しかし、あまり恋愛に興味がある様子ではない。"},{"spoiler":false,"text":"死亡してさえいなければ、多分ほどほどの確率で勝ち組人生を送るだろうと思われるタイプ。"},{"spoiler":false,"text":"青と同じような時期に死亡したらしく、地獄へ来たばかり。"}],"source":"bangumi","sourceCharacterId":"98692"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/66e1f5cc5fcc5a3b0dcd4af8a086afbbafe01586f830e89fe571baa73080f3d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/5139d0d31d29726178006eecfe859ac2096f579b342a8bbc7dfedcf37d93dfd5.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_98693","characterName":"むじなづか・せい","sourceIds":{"bangumi":[{"characterId":"98693","match":"source-roster","subjectId":"168608"}]},"originalCharacterName":"むじなづか・せい","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"心の傷　不詳"},{"spoiler":false,"text":"年齢不詳。素性も不詳。１７５センチ。髪の色は白い長身の女。まるで雅楽か何かの衣装のような装束を身にまとった謎の人物。大きなからくり人形のように表情が読みにくい。"},{"spoiler":false,"text":"青に比翼を渡したらしいが、青の記憶がおぼろげなのでよく解らないまま。地獄についても多少詳しいらしいが、何故比翼をくれたかは不明。"}],"source":"bangumi","sourceCharacterId":"98693"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44c6718672cec756dd9ecf92b1d9e70793e585fa611786c8c6bdc0c3130e94c9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d17602719a0014d40042ae02168fa41ee9589d7ab99cdad27ad600f71c8c6ddf.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_98694","characterName":"うきたに・てつま","sourceIds":{"bangumi":[{"characterId":"98694","match":"source-roster","subjectId":"168608"}]},"originalCharacterName":"うきたに・てつま","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"心の傷　バス事故？"},{"spoiler":false,"text":"２６歳。１６９センチ。会社員。某一族経営の大会社会長の孫であり、社長の息子。本来は鷹揚なお坊ちゃんらしい青年だが、生前の事件のせいでどことなく荒んだ印象になることもある。"},{"spoiler":false,"text":"バス事故により命を落とし、地獄へとやってくる。同行している女性、高尾田比奈子とは旅行中に知り合い、意気投合している。"}],"source":"bangumi","sourceCharacterId":"98694"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/840598cd88c8d630f64c515c0c0643cfd599835a13759e958406a096bd619d4e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be28c75c5d0ad374c551ea042097c6a0915ffb8b0e03e7e2a7ceb6a57b6ab362.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_98695","characterName":"たこうだ・ひなこ","sourceIds":{"bangumi":[{"characterId":"98695","match":"source-roster","subjectId":"168608"}]},"originalCharacterName":"たこうだ・ひなこ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"心の傷　バス事故？"},{"spoiler":false,"text":"２８歳。１６４センチ＋パンプス。ある食品会社のＯＬ。有休を取って旅行中、旅先で宇城谷と逢って意気投合。その後は二人で旅行している。服や化粧などにはかなりお金がかかっており、宇城谷は知らない様子だが恋人は多いようだ。"},{"spoiler":false,"text":"宇城谷と同じくバス事故で死亡。"}],"source":"bangumi","sourceCharacterId":"98695"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ade913871de5398314b64fbbe30079336afaf575ae271276f137bd89434e4353.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff37220a61ade996b26059cfebd8d9e4359b507fd23fa9dd9e189a52b3d82ad4.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_98696","characterName":"まがき・わたる","sourceIds":{"bangumi":[{"characterId":"98696","match":"source-roster","subjectId":"168608"}]},"originalCharacterName":"まがき・わたる","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"心の傷　バス事故？"},{"spoiler":false,"text":"７歳。１２５センチ。小学校二年生。天使を思わせる可愛らしい笑顔の少年。自分のお年玉を使って、バスの終点までいく『旅行中』にバスが崖から転落。早すぎる死を迎える。"},{"spoiler":false,"text":"宇城谷、高尾田と同じくバス事故で死亡。"}],"source":"bangumi","sourceCharacterId":"98696"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbbee753076587fb9b791cfbfa1fd778cd452bfd93d6bb9a8edc22118ca8d9d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/5182719e46a4e13a9806b42ab7c513226536b9c5456b91e3b2f428df7b145e1a.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_98697","characterName":"しらどう・ゆきよし","sourceIds":{"bangumi":[{"characterId":"98697","match":"source-roster","subjectId":"168608"}]},"originalCharacterName":"しらどう・ゆきよし","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"心の傷 不詳"},{"spoiler":false,"text":"３１歳。１７９センチ。筋肉質の体躯で、眼光鋭く周囲に威圧感を与える男。生前から基本的に誰かと行動を共にしようとはしなかったが、その原則は死後も守られている。自らが死んだらしいと知った後、たった一人安堵していた。"},{"spoiler":false,"text":"彼もまたバス事故で死亡したが、他にも何か死ぬような心当たりがあるらしい。"}],"source":"bangumi","sourceCharacterId":"98697"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c69a320867863c2d2891bb912ac318f757f73ee7a737105c0607e3e70630bf0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f43c6e96fe60d7274fdd9232544139622b9e94479f5cd40708c81e65f5ddf3ae.webp","width":192,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p12189","sourceCompanyId":"egs:brand:4025","canonicalEntityId":"vndb:p12189","name":"granat","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:39438:4025","source":"egs"},{"companyId":"vndb:p12189","sourceCompanyId":"vndb:p12189","canonicalEntityId":"vndb:p12189","name":"granat","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:91169:v31727","source":"vndb"},{"companyId":"vndb:p12189","sourceCompanyId":"vndb:p12189","canonicalEntityId":"vndb:p12189","name":"granat","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:91170:v31727","source":"vndb"},{"companyId":"vndb:p12189","sourceCompanyId":"vndb:p12189","canonicalEntityId":"vndb:p12189","name":"granat","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:91171:v31727","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
