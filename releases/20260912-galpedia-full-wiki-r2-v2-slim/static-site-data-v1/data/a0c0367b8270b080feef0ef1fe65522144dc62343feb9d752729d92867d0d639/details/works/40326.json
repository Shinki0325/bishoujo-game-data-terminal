{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"40326","model":{"presentationWorkId":"vndb:v3541","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c16493","characterName":"橋場嵩都","sourceIds":{"vndbCharacterId":"c16493"},"originalCharacterName":"橋場嵩都","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Because his parents are on overseas business, Takato is living by himself in their home, attending university as a freshman. He seems to be an extremely ordinary young man, but happens to be the target for the \"White Soul\" that Prince Zale and Haruka are looking for."},{"spoiler":false,"text":"from Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c16493"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e4d640b2ce9b695f69d37ed4f79eddd768cb5e5a7d98c7c615fbdfea864779c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69d1e99f9a64ed9fa912f3f08a219ccb078254913a61c7d80436849a5f977c86.webp","width":182,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c1750","characterName":"ゼール王子","sourceIds":{"vndbCharacterId":"c1750"},"originalCharacterName":"ゼール王子","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Zale is a selfish prince who has a strong sense of intuition and acts quickly. He has an exceedingly strong spirit in magic, hand-to-hand combat, and wisdom. He is from fire magic lineage, so fire magic is his strong point. He is the fourth prince out of seven, but is the direct descendant of the Demon King because the other princes, his siblings, have died. Curious about the human world, he decides to leave his castle to search out a the \"White Soul\" of a human."},{"spoiler":false,"text":"from Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c1750"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb6abef4d684ab173d3bf4e322a83d2f299f22573890ec9b487574e074572341.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8ae2a023e62feb411efd9de159634262acc157aa74ba1779b5e1f7b661ef1b2d.webp","width":182,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c6306","characterName":"ハルカ","sourceIds":{"vndbCharacterId":"c6306"},"originalCharacterName":"ハルカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haruka serves as the prince's Watch Servant. Though he takes the appearance of a child due to various circumstances, he is actually a fiendish henchman, who is preeminent in combat and highly efficient in physical fighting. He is loyal to the prince and accompanies him in his travels."},{"spoiler":false,"text":"from Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c6306"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b46004b9a5185febb5f61e02b27df5fb4b5db0ecc23218f519fbdd317f503f22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f253c858a8edd3ffc53c8dabaf67732e155ffe0908864880e40b721fdfa4d2b9.webp","width":182,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c6307","characterName":"ベルフェゴール","sourceIds":{"vndbCharacterId":"c6307"},"originalCharacterName":"ベルフェゴール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Prince's political advisor and Soul Contractor. Though a fallen angel, in Hell he possesses the thick blood of a pure demon aristocrat. He is in need of a human \"White Soul\", which Prince Zale and Haruka are to collect."},{"spoiler":false,"text":"from Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c6307"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fecfe5233e90c00e669495574eb4aebd253e08742b057e31445bad7699c4ceb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2ec534079fc0f89a25b5c93befeaafc983959e57bc6320e8c41f4009a4e81117.webp","width":182,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1135","sourceCompanyId":"egs:brand:9544","canonicalEntityId":"vndb:p1135","name":"Black Joke Freak","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:40326:9544","source":"egs"},{"companyId":"vndb:p5989","sourceCompanyId":"vndb:p5989","canonicalEntityId":"vndb:p5989","name":"MichikoSan","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:59961:v3541","source":"vndb"},{"companyId":"vndb:p6229","sourceCompanyId":"vndb:p6229","canonicalEntityId":"vndb:p6229","name":"Danmei","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:59962:v3541","source":"vndb"},{"companyId":"vndb:p1135","sourceCompanyId":"vndb:p1135","canonicalEntityI