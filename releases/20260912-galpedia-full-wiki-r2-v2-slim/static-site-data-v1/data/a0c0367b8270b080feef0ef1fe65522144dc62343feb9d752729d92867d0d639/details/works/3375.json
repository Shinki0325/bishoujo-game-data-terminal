 porn production company."}],"source":"vndb","sourceCharacterId":"c65618"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3d8646161b44dbc630d520d2eb1de0a7dc04322bfc85fc69b98e8a2c1e2beab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23c844124cb17c12255d9865726b870375603e2d9265d93a6950488ab7f309f3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茉莉奈","creatorId":"vndb:s58","sourcePersonId":"vndb:s58","canonicalEntityId":"vndb:s58","name":"雪絵 れな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:27536","source":"vndb"}]},{"characterId":"char_vndb_c76322","characterName":"若木 春菜","sourceIds":{"vndbCharacterId":"c76322"},"originalCharacterName":"若木 春菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female teacher at a certain academy, she teaches chemistry and is a prodigy who graduated from a renowned international technical university by skipping grades. She has a serious demeanor, and her calm manner of conversation often makes it difficult for others to discern what she's thinking. While filled with a sense of mission as a teacher, she tends to be sloppy with household chores and organization. She always wears glasses and a lab coat. Her preferred hot springs are those with a low likelihood of being peered into from the outside, as she is not fond of open-air baths. Due to the remarriage of Chitose's sister and Haruna's father, she is actually Chitose's older niece by relation."}],"source":"vndb","sourceCharacterId":"c76322"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a855acdc974fedd2ce29fd0b8397bb1040b5451965e07a4d32b43162fa87a52a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f83f86457281a59f29b2696fc8d2385d0de0282c93608190749f6b585854d921.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"萌木 唯","creatorId":"vndb:s61","sourcePersonId":"vndb:s61","canonicalEntityId":"vndb:s61","name":"永瀬 いくみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:27537","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:573","sourceCompanyId":"egs:brand:573","canonicalEntityId":"egs:brand:573","name":"Riddle Soft","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:3375:573","source":"egs"},{"companyId":"vndb:p176","sourceCompanyId":"vndb:p176","canonicalEntityId":"vndb:p176","name":"N43 Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:34999:v4404","source":"vndb"},{"companyId":"vndb:p950","sourceCompanyId":"vndb:p950","canonicalEntityId":"vndb:p950","name":"リドルソフト","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:35000:v4404","source":"vndb"},{"companyId":"vndb:p819","sourceCompanyId":"vndb:p819","canonicalEntityId":"vndb:p819","name":"ポタージュ","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:35001:v4404","source":"vndb"},{"companyId":"vndb:p950","sourceCompanyId":"vndb:p950","canonicalEntityId":"vndb:p950","name":"リドルソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:35002:v4404