b:s37","sourcePersonId":"vndb:s37","canonicalEntityId":"vndb:s37","name":"鈴木 貴征","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21237:90306:40410:1","source":"bangumi"}]},{"characterId":"char_c13905","characterName":"霧谷 紅","sourceIds":{"bangumi":[{"characterId":"45067","match":"exact-normalized-name-in-linked-work","subjectId":"21237"}],"egsCharacterIds":["12477"],"vndbCharacterId":"c13905"},"originalCharacterName":"霧谷 紅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The proud fifth daughter"},{"spoiler":false,"text":"Although she has a friendly and cheerful personality, she is proud of her membership in the noble Kiritani family, and wishes to act accordingly like an aristocratic lady. This can also lead to her being a bit stubborn, and she can easily get angry if teased."},{"spoiler":false,"text":"She also tends to expect the same ideal from others, and dislikes sloppy and unrefined behavior and speech."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c13905"},{"segments":[{"spoiler":false,"text":"【誇り高き五女】"},{"spoiler":false,"text":"五女。奔放で快活。"},{"spoiler":false,"text":"親しみやすく明るい性格だが、華族としての霧谷家に誇りを抱いており、それ相応に貴族令嬢らしくあらねば、と背伸びしたがる。"},{"spoiler":false,"text":"それがやや意地っ張りな面にも繋がっていて、からかわれるとムキになりやすい。"},{"spoiler":false,"text":"また、自分のその理想を相手にも求める傾向があり、だらしない、はしたない行動や言動を嫌う。"}],"source":"egs","sourceCharacterId":"12477","sourceWorkId":"13702","spoiler":false},{"segments":[{"spoiler":false,"text":"奔放で快活。親しみやすく明るい性格だが、華族としての霧谷家に誇りを抱いており、それ相応に貴族令嬢らしくあらねば、と背伸びしたがる。"},{"spoiler":false,"text":"それがやや意地っ張りな面にも繋がっていて、からかわれるとムキになりやすい。"},{"spoiler":false,"text":"また、自分のその理想を相手にも求める傾向があり、だらしない、はしたない行動や言動を嫌う。"}],"source":"bangumi","sourceCharacterId":"45067"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe157d1c3784f495f62498c62f9d7d30049e4d1309706002a2a0dd97d1093724.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f46f26f0221f507abbe79fc0e1db5e9c6e90cd25b1651f0e358afaf2c59c2d1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日アン(春乃うらら)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21237:45067:6480:1","source":"bangumi"}]},{"characterId":"char_c13906","characterName":"霧谷 菫","sourceIds":{"bangumi":[{"characterId":"45068","match":"exact-normalized-name-in-linked-work","subjectId":"21237"}],"egsCharacterIds":["12478"],"vndbCharacterId":"c13906"},"originalCharacterName":"霧谷 菫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Kind-Hearted Sixth Daughter"},{"spoiler":false,"text":"The youngest child of the family, who is quiet, reserved, and somewhat shy."},{"spoiler":false,"text":"She looks up to Daisuke like an older brother and becomes attached to him."},{"spoiler":false,"text":"Because she is younger than most of her other sisters, she often spends time with Kurenai."},{"spoiler":false,"text":"Although she participates in the night-time rituals as a matter of tradition, she believes that she does not have the charm of her sisters, and so has little desire to actively compete with them."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c13906"},{"segments":[{"spoiler":false,"text":"【心優しき六女】"},{"spoiler":false,"text":"六女。大人しく控えめで、やや引っ込み思案の末っ子。"},{"spoiler":false,"text":"大輔を兄のように慕い、なついてくる。"},{"spoiler":false,"text":"上の姉たちとは歳が離れていることもあり、紅とよく一緒にいる。"}],"source":"egs","sourceCharacterId":"12478","sourceWorkId":"13702","spoiler":false},{"segments":[{"spoiler":false,"text":"大人しく控えめで、やや引っ込み思案の末っ子。"},{"spoiler":false,"text":"大輔を兄のように慕い、なついてくる。"},{"spoiler":false,"text":"上の姉たちとは歳が離れていることもあり、紅とよく一緒にいる。"},{"spoiler":false,"text":"しきたりとして夜伽に参加しているが、自分には姉たちのような魅力はない、と思い込んでいるため積極的に競おうという気持ちは薄い。"}],"source":"bangumi","sourceCharacterId":"45068"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/5947ec55f7475f353f0c84c2de95c51fa18b350f96bc8e19fd8029c7ff45431a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03efc2958da9dcc673c4f4b98c097dd82e25eb78ed0cfb40a6439657ae696a48.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大野まりな","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21237:45068:4434:1","source":"bangumi"}]},{"characterId":"char_c13907","characterName":"霧谷 撫子","sourceIds":{"bangumi":[{"characterId":"45069","match":"exact-normalized-name-in-linked-work","subjectId":"21237"}],"egsCharacterIds":["12479"],"vndbCharacterId":"c13907"},"originalCharacterName":"霧谷 撫子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The kind and loving eldest daughter"},{"spoiler":false,"text":"She has a gentle and maternal personality, compared to her strict mother, Sumi."},{"spoiler":false,"text":"She is beloved by her younger sisters and acts as a buffer between her and Sumi, keeping the family together."},{"spoiler":false,"text":"She accepts Daisuke as her \"future husband\" and tries to have fun with him, but perhaps because she grew up as the eldest sister, she naturally treats the younger Daisuke as her younger brother."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c13907"},{"segments":[{"spoiler":false,"text":"【慈愛溢れる長女】"},{"spoiler":false,"text":"長女。厳格な母、澄美に対して温和で母性的な性格。"},{"spoiler":false,"text":"妹たちからも慕われており、澄美との緩衝役として一家をまとめる。"},{"spoiler":false,"text":"長姉として育ってきたせいか、年下の大輔を自然と弟扱いしてしまう。"}],"source":"egs","sourceCharacterId":"12479","sourceWorkId":"13702","spoiler":false},{"segments":[{"spoiler":false,"text":"厳格な母・澄美に対して温和で母性的な性格。"},{"spoiler":false,"text":"妹たちからも慕われており、澄美との緩衝役として一家をまとめる。"},{"spoiler":false,"text":"大輔を 『未来の旦那様』 として受け入れ積極的に楽しもうとするが、長姉として育ってきたせいか、年下の大輔を自然と弟扱いしてしまう。"}],"source":"bangumi","sourceCharacterId":"45069"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/adb3939c55e746b1110d5743a74dd474cb5629068db1638924947ffe70c980f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46056f3a6868ba3ea11ca91e7e24f1a2aadd7c48f4a3f92e9fd3da63f77f713c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幡宮かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21237:45069:5940:1","source":"bangumi"}]},{"characterId":"char_c13908","characterName":"霧谷 藍","sourceIds":{"bangumi":[{"characterId":"45070","match":"exact-normalized-name-in-linked-work","subjectId":"21237"}],"egsCharacterIds":["12480"],"vndbCharacterId":"c13908"},"originalCharacterName":"霧谷 藍","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The silent third daughter"},{"spoiler":false,"text":"An emotionless girl who barely interacts with other people."},{"spoiler":false,"text":"She is cold-hearted and rarely shows her emotions."},{"spoiler":false,"text":"She seems to view people as if they are not even human. The only person she can have a proper conversation with is her older sister, Botan, who is one year older than her."},{"spoiler":false,"text":"As Sumi commands, Daisuke holds her like a doll."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c13908"},{"segments":[{"spoiler":false,"text":"【静寂の三女】"},{"spoiler":false,"text":"三女。ほとんど人と接しようとしない、無感情な少女。"},{"spoiler":false,"text":"冷徹で感情を表すことがなく、大輔のことも人ではないかのように見ている節がある。"},{"spoiler":false,"text":"まともに言葉を交わすのは、一つ上の姉・牡丹のみ。"}],"source":"egs","sourceCharacterId":"12480","sourceWorkId":"13702","spoiler":false},{"segments":[{"spoiler":false,"text":"ほとんど人と接しようとしない、無感情な少女。"},{"spoiler":false,"text":"冷徹で感情を表すことがなく、大輔のことも人ではないかのように見ている節がある。"},{"spoiler":false,"text":"まともに言葉を交わすのは、一つ上の姉・牡丹のみ。"},{"spoiler":false,"text":"澄美に命じられるまま、人形のように大輔に抱かれる。"}],"source":"bangumi","sourceCharacterId":"45070"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19b86b5c3d009f361bbaf5c79a0dac96fdee0f3de5a5780250fb83721fb13cd6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b458183bb43ff77a3d881ae393c612e08ee539c24fe534b40aee220e2f5d56f4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永瀬江美弥","creatorId":"vndb:s61","sourcePersonId":"vndb:s61","canonicalEntityId":"vndb:s61","name":"永瀬 いくみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21237:45070:6549:1","source":"bangumi"}]},{"characterId":"char_c13909","characterName":"霧谷 牡丹","sourceIds":{"bangumi":[{"characterId":"45071","match":"exact-normalized-name-in-linked-work","subjectId":"21237"}],"egsCharacterIds":["12482"],"vndbCharacterId":"c13909"},"originalCharacterName":"霧谷 牡丹","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Whimsical Second Daughter"},{"spoiler":false,"text":"She is the most flashy of the six Kiritani sisters, known for her hedonism and ephemeral beauty."},{"spoiler":false,"text":"A promiscuous woman who is sexually open-minded."},{"spoiler":false,"text":"Currently, she is studying abroad and has left the Kiritani family."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c13909"},{"segments":[{"spoiler":false,"text":"【気まぐれな二女】"},{"spoiler":false,"text":"次女。霧谷六姉妹の中でも飛び抜けて派手で、享楽的かつ刹那的な美女。"},{"spoiler":false,"text":"性的にもオープンな肉食系。"},{"spoiler":false,"text":"現在は海外留学中のため、霧谷家を離れている。"}],"source":"egs","sourceCharacterId":"12482","sourceWorkId":"13702","spoiler":false},{"segments":[{"spoiler":false,"text":"霧谷六姉妹の中でも飛び抜けて派手で、享楽的かつ刹那的な美女。"},{"spoiler":false,"text":"性的にもオープンな肉食系。"},{"spoiler":false,"text":"現在は海外留学中のため、霧谷家を離れている。"}],"source":"bangumi","sourceCharacterId":"45071"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a58bc91735c983440322ebbc1ecf5b0b1b0fc9c1f5e93c49d884d8c2b4fda928.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcfbb29a9dc438ac2ec63dd052672d1e99b2d4bbc76c01bb35b89ed33942f237.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"亜城めぐ","creatorId":"vndb:s454","sourcePersonId":"vndb:s454","canonicalEntityId":"vndb:s454","name":"亜城 めぐ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21237:45071:4833:1","source":"bangumi"}]},{"characterId":"char_c13910","characterName":"霧谷 藤乃","sourceIds":{"bangumi":[{"characterId":"45072","match":"exact-normalized-name-in-linked-work","subjectId":"21237"}],"egsCharacterIds":["12481"],"vndbCharacterId":"c13910"},"originalCharacterName":"霧谷 藤乃","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Fourth daughter who died young"},{"spoiler":false,"text":"Deceased. She had a calm demeanor for her age, and was intelligent and possessed eyes that seemed to see through everything."},{"spoiler":false,"text":"To her younger sisters Kurenai and Sumire, she was a kind older sister who taught them many things, but to Nadeshiko and Ai, she was a sister who was too intelligent and gave the impression of being somewhat fragile."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c13910"},{"segments":[{"spoiler":false,"text":"【早世した四女】"},{"spoiler":false,"text":"四女。故人。"},{"spoiler":false,"text":"年齢のわりに落ち着いた雰囲気をもち、聡明ですべてを見透かすような瞳の持ち主だった。"},{"spoiler":false,"text":"妹の紅や菫にとっては、色々なことを教えてくれる優しい姉であり、撫子や藍、牡丹にとっては、聡明すぎてどこか儚い印象の妹だった。"}],"source":"egs","sourceCharacterId":"12481","sourceWorkId":"13702","spoiler":false},{"segments":[{"spoiler":false,"text":"故人。年齢のわりに落ち着いた雰囲気をもち、聡明ですべてを見透かすような瞳の持ち主。"},{"spoiler":false,"text":"妹の紅や菫にとっては色々なことを教えてくれる優しい姉であり、撫子や藍にとっては聡明すぎてどこか儚い印象の妹だった。"}],"source":"bangumi","sourceCharacterId":"45072"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09115353f910d2c4b04cb013a0de20d6b1aa50d653dcc960646b7fa50d1fbfc9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2dd445e9303a0b46ecb905070ebdc1a00a57dbdbfd0d3e32907b1f661c4d22b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さくらなつみ","creatorId":"vndb:s666","sourcePersonId":"vndb:s666","canonicalEntityId":"vndb:s666","name":"岩泉まい(樋口まゆら、樋口まゆ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21237:45072:6279:1","source":"bangumi"}]},{"characterId":"char_c13911","characterName":"霧谷 澄美","sourceIds":{"bangumi":[{"characterId":"45073","match":"exact-normalized-name-in-linked-work","subjectId":"21237"}],"egsCharacterIds":["12483"],"vndbCharacterId":"c13911"},"originalCharacterName":"霧谷 澄美","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Female head of the Kiritani family"},{"spoiler":false,"text":"A strict lady who helps the sick head of the family manage the household."},{"spoiler":false,"text":"She does not succumb to various external pressures and will do anything to uphold the Kiritani name. There are even indications that she sees her own daughters as tools for her benefit."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c13911"},{"segments":[{"spoiler":false,"text":"【霧谷家の女当主】"},{"spoiler":false,"text":"病がちな当主を助け、一族を切り盛りする厳格な夫人。"},{"spoiler":false,"text":"外部からの様々な圧力に負けず、霧谷の家を守るためならばどんな手段も厭わない。"},{"spoiler":false,"text":"自らが産んだ娘たちでさえ、霧谷家のための道具として見る節がある。"}],"source":"egs","sourceCharacterId":"12483","sourceWorkId":"13702","spoiler":false},{"segments":[{"spoiler":false,"text":"病がちな当主を助け、一族を切り盛りする厳格な夫人。"},{"spoiler":false,"text":"外部からの様々な圧力に負けず、霧谷の家を守るためならばどんな手段も厭わない。"},{"spoiler":false,"text":"自らが産んだ娘たちでさえ、霧谷家のための道具として見る節がある。"}],"source":"bangumi","sourceCharacterId":"45073"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2cf92662e0c4f47d4bb5f2496cf86802eb8f756f29f88ef15c3e028962db9078.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/3664599c63813addc74b54efb119e20166d5e4d08de46ac68e94189f3eb3c5d2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21237:45073:6131:1","source":"bangumi"}]},{"characterId":"char_c13912","characterName":"嵯峨根 綾","sourceIds":{"bangumi":[{"characterId":"45074","match":"exact-normalized-name-in-linked-work","subjectId":"21237"}],"egsCharacterIds":["12484"],"vndbCharacterId":"c13912"},"originalCharacterName":"嵯峨根 綾","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The honest head maid"},{"spoiler":false,"text":"The head maid of the Kiritani family who has served them for many years. She serves as leader of the family's several maids. Her length of service is second only to the family's butler, Yaku."},{"spoiler":false,"text":"Like Sumi, she has a strict and serious personality and is also a tutor for the sisters."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c13912"},{"segments":[{"spoiler":false,"text":"【実直なメイド長】"},{"spoiler":false,"text":"長年、霧谷家に仕えているメイド長。数人いるメイドたちのまとめ役。"},{"spoiler":false,"text":"使用人歴は執事の夜久の次に長い。"},{"spoiler":false,"text":"澄美と同じように厳しく、かつ真面目な性格で姉妹たちの教育係でもある。"}],"source":"egs","sourceCharacterId":"12484","sourceWorkId":"13702","spoiler":false},{"segments":[{"spoiler":false,"text":"長年、霧谷家に仕えているメイド長。数人いるメイドたちのまとめ役。"},{"spoiler":false,"text":"使用人歴は執事の夜久の次に長い。"},{"spoiler":false,"text":"澄美と同じように厳しく、かつ真面目な性格で姉妹たちの教育係でもある。"}],"source":"bangumi","sourceCharacterId":"45074"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/6244d2631b35d801d1c10b152c186362f6c715f897522aa1a50b362d325d9f0f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fac05ae4fcd3df800b98d23827a38e0b3b5046c38fd93d9eb9684970c7378f5f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"悠","creatorId":"vndb:s1702","sourcePersonId":"vndb:s1702","canonicalEntityId":"vndb:s1702","name":"悠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26043","source":"vndb"}]},{"characterId":"char_c13913","characterName":"叶内 良子","sourceIds":{"bangumi":[{"characterId":"45075","match":"exact-normalized-name-in-linked-work","subjectId":"21237"}],"egsCharacterIds":["12485"],"vndbCharacterId":"c13913"},"originalCharacterName":"叶内 良子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The bright, recently-hired maid"},{"spoiler":false,"text":"She is the youngest of the Kiritani family's maids and has only recently arrived at the mansion."},{"spoiler":false,"text":"She is a gentle person who is easy to be around."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c13913"},{"segments":[{"spoiler":false,"text":"【明るい新人メイド】"},{"spoiler":false,"text":"霧谷家のメイドの中で一番若く、最近館へやって来たばかり。"},{"spoiler":false,"text":"穏和で一緒にいると安らぐタイプ。"}],"source":"egs","sourceCharacterId":"12485","sourceWorkId":"13702","spoiler":false},{"segments":[{"spoiler":false,"text":"霧谷家のメイドの中で一番若く、最近館へやって来たばかり。"},{"spoiler":false,"text":"穏和で一緒にいると安らぐタイプ。"}],"source":"bangu