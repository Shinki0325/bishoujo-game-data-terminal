rcePersonId":"vndb:s1161","canonicalEntityId":"vndb:s1161","name":"のり太","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:11932","source":"vndb"},{"creditedName":"ヨダ","creatorId":"vndb:s7018","sourcePersonId":"vndb:s7018","canonicalEntityId":"vndb:s7018","name":"ヨダ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:11935","source":"vndb"},{"creditedName":"エノモト","creatorId":"vndb:s10358","sourcePersonId":"vndb:s10358","canonicalEntityId":"vndb:s10358","name":"エノモト","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:11937","source":"vndb"},{"creditedName":"エノモト","creatorId":"vndb:s10358","sourcePersonId":"vndb:s10358","canonicalEntityId":"vndb:s10358","name":"エノモト","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:11939","source":"vndb"},{"creditedName":"おんだ","creatorId":"vndb:s14747","sourcePersonId":"vndb:s14747","canonicalEntityId":"vndb:s14747","name":"おんだ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:11940","source":"vndb"},{"creditedName":"浅海 梨江","creatorId":"vndb:s31512","sourcePersonId":"vndb:s31512","canonicalEntityId":"vndb:s31512","name":"浅海 梨江","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:11942","source":"vndb"},{"creditedName":"下田 芳裕","creatorId":"vndb:s46467","sourcePersonId":"vndb:s46467","canonicalEntityId":"vndb:s46467","name":"下田 芳裕","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:11943","source":"vndb"}]},"cast":[{"characterId":"char_c29260","characterName":"燕子花 こりす","sourceIds":{"bangumi":[{"characterId":"148283","match":"exact-normalized-name-in-linked-work","subjectId":"16860"}],"egsCharacterIds":["27283"],"vndbCharacterId":"c29260"},"originalCharacterName":"燕子花 こりす","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"画商であり、資産家としてもその名を世に轟かせる、燕子花家の息女。"},{"spoiler":false,"text":"主人公とは幼馴染の関係であるが、ずっと距離を置いてきた。"},{"spoiler":false,"text":"それは主人公の傍らには絶えずこまの存在があったから。"},{"spoiler":false,"text":"そうした確執をよそに、祖父同士が主人公と彼女の婚約を取り決め、許婚の関係になった。"},{"spoiler":false,"text":"今回、急遽、結婚式を執り行うことになり、主人公を東京に連れ戻すために舞台となる田舎町にやってきたが……。"}],"source":"egs","sourceCharacterId":"27283","sourceWorkId":"3014","spoiler":false},{"segments":[{"spoiler":false,"text":"画商であり、資産家としてもその名を世に轟かせる、燕子花家の息女。"},{"spoiler":false,"text":"主人公とは幼馴染のような関係だが、二人の仲はそれほど親密ではない。むしろ、主人公に対して距離を置くような素振りを見せる。主人公のそばには、常にこまの存在があったから。言葉の端々に散りばめられた棘(とげ)と、煙に巻くような態度。だがその裏にある、幼い頃から抱いてきた主人公への想い。"},{"spoiler":false,"text":"『それでもわたくしは・・・・"},{"spoiler":false,"text":"お兄様と一緒にいたかったんですの』"}],"source":"bangumi","sourceCharacterId":"148283"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcb26884147703d0c36a1c458ea1a7b7e166c4d1997167905424d0d2bfba3dfe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa97006c34648a8ab238b299ae141e6bc76a7c7b3458fa608fac4d0c49e0344e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16860:148283:4432:1","source":"bangumi"}]},{"characterId":"char_c4202","characterName":"麻生 こま","sourceIds":{"bangumi":[{"characterId":"148284","match":"exact-normalized-name-in-linked-work","subjectId":"16860"}],"egsCharacterIds":["27282"],"vndbCharacterId":"c4202"},"originalCharacterName":"麻生 こま","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の義理の妹。"},{"spoiler":false,"text":"不思議な力を持ち、周囲から異端視される主人公の唯一の味方だった。"},{"spoiler":false,"text":"しかし、主人公を守って三年前に他界してしまう。"},{"spoiler":false,"text":"舞台となる「ゆかり神社」の神様である結乃由姫命によって、彼女そっくりの御神体に魂を呼び戻し、現世に黄泉還るが……。"}],"source":"egs","sourceCharacterId":"27282","sourceWorkId":"3014","spoiler":false},{"segments":[{"spoiler":false,"text":"幼少期に主人公のもとにやってきた、義理の妹。"},{"spoiler":false,"text":"以来、人とは異なる力のせいで周囲に距離を置かれる事が多かった主人公の、ただ一人の味方だった。しかし三年前に、主人公を守って死んでしまう。主人公が写生の為に訪れた田舎町で、惹きつけられるように足を運んだ『ゆかり神社』。その本殿に安置されていた御神体は、こまに瓜二つだった──器は違えど、魂の帰還・・・・御神体はこまの魂を宿して動き出す。再会した\"お兄ちゃん\"と、他のヒロイン達との神社での共同生活。そんな日常のなか、彼女は主人公達と家族のような絆を築いていく。ここにいてはいけない存在だと、心を痛めながらも・・・・。"},{"spoiler":false,"text":"『お兄ちゃんに、もう一度微笑んでもらう為に"},{"spoiler":false,"text":"・・・・・・帰ってきたよ』"}],"source":"bangumi","sourceCharacterId":"148284"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/368bc944f6fabe4d7b6f285ceb551fd80fdf29dba26acc80dacae094e46e95ea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75fa141cf071a58c1311e7f9b22bd30345eec4d35e38cdcf42807f72332b3094.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16860:148284:4830:1","source":"bangumi"}]},{"characterId":"char_c4204","characterName":"春野千草","sourceIds":{"bangumi":[{"characterId":"148285","match":"exact-normalized-name-in-linked-work","subjectId":"16860"}],"egsCharacterIds":["27285"],"vndbCharacterId":"c4204"},"originalCharacterName":"春野千草","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公に取り憑いたメイド姿の幽霊。"},{"spoiler":false,"text":"のんびりした性格のためか、彼女自身には幽霊の自覚はない。"},{"spoiler":false,"text":"主人を信じ、それゆえ命を落としてしまった彼女は、この世に居るはずもない主人を捜し彷徨っているところを主人公の画に描き込まれたことから、主人公の守護霊になってしまう。"},{"spoiler":false,"text":"主人公のことをご主人様と思い込んでいるようだが……。"}],"source":"egs","sourceCharacterId":"27285","sourceWorkId":"3014","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公に取り憑いたメイド姿の幽霊。"},{"spoiler":false,"text":"のんびりしたその性格のためか、本人に幽霊である自覚はない。何があろうと、何が起ころうと。ただ一心に主人を信じ続け、それ故に命を落としてしまった彼女。主人公の事を\"ご主人様\"と思い込んでいる様子であるが、守護霊とは本来、両者に深い結びつきがなければなれない存在。出会ったばかりの二人に、そのような関わり合いなどない筈だが・・・・。"},{"spoiler":false,"text":"『・・・・信じてますもん。"},{"spoiler":false,"text":"だから見守っていますよ、ご主人様』"}],"source":"bangumi","sourceCharacterId":"148285"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72f5c9531aa598469c3340055787e8aed90bd8d9f99f9891cffd41681b632091.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63b28ad029a2248890aacdf5ecefe2323b7787a1f805c978ddd60253478d0f02.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16860:148285:4689:1","source":"bangumi"}]},{"characterId":"char_c4205","characterName":"咒吠君 鏡架","sourceIds":{"bangumi":[],"egsCharacterIds":["27286"],"vndbCharacterId":"c4205"},"originalCharacterName":"咒吠君 鏡架","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"一切を排他するような凍てついた表情と、感情の起伏を感じさせない言動――、その正体は、「ゆかり神社」の滝壷に封印されていた妖刀の化身。"},{"spoiler":false,"text":"咒吠君鏡架(じゅはいぎきょうか)の意味するところは、やかましく呪いを述べ立てる者の写し身。"},{"spoiler":false,"text":"黙ったまま、主人公と行動を共にする、その理由とはなんなのか？"}],"source":"egs","sourceCharacterId":"27286","sourceWorkId":"3014","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/656012371452dbbaf0709d2420842a30034f4166a956e94b71f7efccdc3ed00a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/429d6baf3b0b2eb89004d4dc3b9411e5594597c0f4486a652f5f9baea8b5de1e.webp","width":194,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴田 美夜子","creatorId":"vndb:s446","sourcePersonId":"vndb:s446","canonicalEntityId":"vndb:s446","name":"若林 直美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5482","source":"vndb"}]},{"characterId":"char_c4206","characterName":"結乃由姫命","sourceIds":{"bangumi":[{"characterId":"78029","match":"exact-normalized-name-in-linked-work","subjectId":"16860"}],"egsCharacterIds":["27284"],"vndbCharacterId":"c4206"},"originalCharacterName":"結乃由姫命","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「ゆかり神社」に祀られている縁結びの女神。"},{"spoiler":false,"text":"女神ゆえか、プライドが高く高慢尊大な態度をとるも、愛嬌があり憎めない性格。"},{"spoiler":false,"text":"実は、かなりの寂しがり屋で、ひとをからかったり、悪戯するのはその感情の裏返し。"},{"spoiler":false,"text":"すっかり寂れてしまった自分の神社を、昔のような参拝客で賑わう境内にしようと孤軍奮闘するが、詰めが甘いのか失敗ばかり。"}],"source":"egs","sourceCharacterId":"27284","sourceWorkId":"3014","spoiler":false},{"segments":[{"spoiler":false,"text":"『ゆかり神社』に祀られている縁結びの女神。"},{"spoiler":false,"text":"女神ゆえにプライドの高さは折り紙付きで、常に高慢尊大な態度を取るが、愛嬌もあり憎めない性格。『由(ゆえ)』の愛称で呼ばれる。実はとても寂しがり屋で、人をからかったり、悪戯をするのはその感情の裏返しである。すっかり寂れてしまっている自分の神社を、かつてのように参拝客で賑わう境内にしようと孤軍奮闘している。"},{"spoiler":false,"text":"『如何ように不思議な偶然も、"},{"spoiler":false,"text":"それがひとたび“縁”となれば、わらわが叶えてやろうぞ』"}],"source":"bangumi","sourceCharacterId":"78029"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/4887cff92d5dda6403db219c912a98fd6a618cecb64737e510ef43bc99edaa4c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/adf29fbbba8a89dda340aa8af4ad17bc0e60b9b78db5d64084916213c664b377.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16860:78029:5890:1","source":"bangumi"}]},{"characterId":"char_vndb_c4201","characterName":"麻生 智","sourceIds":{"vndbCharacterId":"c4201"},"originalCharacterName":"麻生 智","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/485f5c44370efd10fe3e89c911c40d3c7f5e19b5528cb1c45b73af8273834c8b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/195410cfd30237144b2aa1354b2c7c4a81a02efeea3a92d279315ab2c51bdfdc.webp","width":194,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c4203","characterName":"翁俊信","sourceIds":{"vndbCharacterId":"c4203"},"originalCharacterName":"翁俊信","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vnd