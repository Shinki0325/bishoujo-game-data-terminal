"roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:193860","source":"egs"},{"creditedName":"カサンドラ","creatorId":"vndb:s3053","sourcePersonId":"egs:creator:20500","canonicalEntityId":"vndb:s3053","name":"カサンドラ","detail":"主題歌「秋桜」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:193861","source":"egs"},{"creditedName":"下地 和彦","creatorId":"vndb:s1105","sourcePersonId":"vndb:s1105","canonicalEntityId":"vndb:s1105","name":"下地 和彦","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:145147","source":"vndb"},{"creditedName":"加古川 高","creatorId":"vndb:s2927","sourcePersonId":"vndb:s2927","canonicalEntityId":"vndb:s2927","name":"加古川高","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:145150","source":"vndb"},{"creditedName":"カサンドラ","creatorId":"vndb:s3053","sourcePersonId":"vndb:s3053","canonicalEntityId":"vndb:s3053","name":"カサンドラ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:145151","source":"vndb"},{"creditedName":"カサンドラ","creatorId":"vndb:s3053","sourcePersonId":"vndb:s3053","canonicalEntityId":"vndb:s3053","name":"カサンドラ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:145152","source":"vndb"},{"creditedName":"紫刀","creatorId":"vndb:s8282","sourcePersonId":"vndb:s8282","canonicalEntityId":"vndb:s8282","name":"紫刀","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:145153","source":"vndb"},{"creditedName":"みらくる☆みきぽん","creatorId":"vndb:s10710","sourcePersonId":"vndb:s10710","canonicalEntityId":"vndb:s10710","name":"ミラクル☆みきぽん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:145155","source":"vndb"}]},"cast":[{"characterId":"char_c65826","characterName":"楠木 秋桜香","sourceIds":{"bangumi":[{"characterId":"77486","match":"exact-normalized-name-in-linked-work","subjectId":"230348"}],"egsCharacterIds":["19639"],"vndbCharacterId":"c65826"},"originalCharacterName":"楠木 秋桜香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's younger sister, who will be entering a higher grade next year. She's quiet and shy around strangers. Since childhood, she's been completely devoted to her big brother, always trailing behind him, hiding in his shadow."},{"spoiler":false,"text":"She shows the protagonist how adorably she's grown, but both her heart and body are still too immature to be called a “woman.” Having always relied entirely on the protagonist and having few friends, she's also a bit more emotionally immature compared to other girls her age."},{"spoiler":false,"text":"She has waited endlessly for her brother, who vanished suddenly and inexplicably from her life. Her affection for him is blind; he has always been the most important person in the world to her."},{"spoiler":false,"text":"She carries a stuffed cat toy given to her by her brother long ago, never letting it out of her sight. Its name is “Chocolat-nya.”"},{"spoiler":false,"text":"Her fee for giving her father a shoulder massage is 20 yen per session."},{"spoiler":false,"text":"From Official website"}],"source":"vndb","sourceCharacterId":"c65826"},{"segments":[{"spoiler":false,"text":"「私は、お兄ちゃんさえ居てくれたら、それで……いいんだよ？」"},{"spoiler":false,"text":"来年から上の学校に行く、主人公の妹。"},{"spoiler":false,"text":"大人しくて人見知り。"},{"spoiler":false,"text":"小さい頃からお兄ちゃんっ子で、いつも主人公の影に隠れてついて回っていた。"},{"spoiler":false,"text":"可愛らしく成長した姿を主人公の前に見せるが、「女性」というには、まだまだ心も身体も未熟。"},{"spoiler":false,"text":"主人公に頼りきりだったこともあり、友達も少ないため、他の子に比べて精神的にやや幼いところも。"},{"spoiler":false,"text":"自分の目の前から理由もわからず突然居なくなってしまった兄のことを、ずっと待ち続けていた。"},{"spoiler":false,"text":"兄に対しての親愛は盲目的で、ずっと、お兄ちゃんが世の中で一番大事。"},{"spoiler":false,"text":"昔、兄にもらった猫（？）のぬいぐるみを肌身離さず持ち歩いている。名前は「ショコラーニャ」。"},{"spoiler":false,"text":"お父さんへの肩たたき料は、１回２０円。"}],"source":"egs","sourceCharacterId":"19639","sourceWorkId":"26107","spoiler":false},{"segments":[{"spoiler":false,"text":"来年から上の学校に行く、主人公の妹。"},{"spoiler":false,"text":"大人しくて人見知り。"},{"spoiler":false,"text":"小さい頃からお兄ちゃんっ子で、"},{"spoiler":false,"text":"いつも主人公の影に隠れてついて回っていた。"},{"spoiler":false,"text":"可愛らしく成長した姿を主人公の前に見せるが、"},{"spoiler":false,"text":"「女性」というには、まだまだ心も身体も未熟。"},{"spoiler":false,"text":"主人公に頼りきりだったこともあり、友達も少ないため、"},{"spoiler":false,"text":"他の子に比べて精神的にやや幼いところも。"},{"spoiler":false,"text":"自分の目の前から理由もわからず"},{"spoiler":false,"text":"突然居なくなってしまった兄のことを、ずっと待ち続けていた。"},{"spoiler":false,"text":"兄に対しての親愛は盲目的で、"},{"spoiler":false,"text":"ずっと、お兄ちゃんが世の中で一番大事。"},{"spoiler":false,"text":"昔、兄にもらった猫（？）のぬいぐるみを"},{"spoiler":false,"text":"肌身離さず持ち歩いている。名前は「ショコラーニャ」。"},{"spoiler":false,"text":"お父さんへの肩たたき料は、１回２０円。"}],"source":"bangumi","sourceCharacterId":"77486"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5edabad7a75145f00fb23d46b45a6c768746f871e5e419ac8b31816274491019.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5cde3e6b1c1df52245804584d1148a2a31a6254ffc1d952500b139c80c9169c.webp","width":121,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水神楓","creatorId":"vndb:s1493","sourcePersonId":"vndb:s1493","canonicalEntityId":"vndb:s1493","name":"水神 楓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230348:77486:22644:1","source":"bangumi"}]},{"characterId":"char_c65827","characterName":"桐野 暁","sourceIds":{"bangumi":[{"characterId":"125872","match":"exact-normalized-name-in-linked-work","subjectId":"230348"}],"egsCharacterIds":["19640"],"vndbCharacterId":"c65827"},"originalCharacterName":"桐野 暁","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's cousin and cousin and childhood friend of Asaka. She's an energetic, outgoing, and cheerful girl. She affectionately calls the protagonist “big brother.”"},{"spoiler":false,"text":"She used to be tomboyish as a child, but has since grown into a cute young woman with a distinctly feminine physique. Being at that age where she's infatuated with romance, she's developed feelings for the protagonist, who she's always been close with."},{"spoiler":false,"text":"She's extremely easily embarrassed; even the slightest teasing makes her ears and face turn bright red."},{"spoiler":false,"text":"At school, she belongs to the track and field club, which has only two members—she being the sole athlete. Her specialty is sprinting. She even practices on her own at school during summer break, giving her a healthy tan."},{"spoiler":false,"text":"She's a dependable person who often looks after the village children in place of the protagonist, who left their hometown. She has never left this village."},{"spoiler":false,"text":"From Official website"}],"source":"vndb","sourceCharacterId":"c65827"},{"segments":[{"spoiler":false,"text":"「お兄、あたしたちの関係は、いつまでも……変わらないよね？」"},{"spoiler":false,"text":"主人公の従妹にあたり、秋桜香とも幼なじみ。"},{"spoiler":false,"text":"活発で人当たりの良い、元気な女の子。"},{"spoiler":false,"text":"主人公のことを「お兄」と呼び慕っている。"},{"spoiler":false,"text":"小さい頃は男の子のようだったが、今では可愛く成長し、身体はすっかり「女の子」になった。"},{"spoiler":false,"text":"恋に恋するお年頃で、昔から仲が良かった主人公のことが気になっている。"},{"spoiler":false,"text":"極度の恥ずかしがり屋で、少しでもからかうと、耳と顔が真っ赤になる。"},{"spoiler":false,"text":"学校では部員２名の陸上部に所属しており、彼女が唯一の選手。得意なのは短距離走。"},{"spoiler":false,"text":"夏休みも学校で自主練していて、健康的に日焼けている。"},{"spoiler":false,"text":"故郷を去った主人公の代わりに、よく村の子供のお世話をしているしっかり者。"},{"spoiler":false,"text":"まだ、この村から一度も出たことがない。"}],"source":"egs","sourceCharacterId":"19640","sourceWorkId":"26107","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の従妹にあたり、秋桜香とも幼なじみ。"},{"spoiler":false,"text":"活発で人当たりの良い、元気な女の子。"},{"spoiler":false,"text":"主人公のことを「お兄」と呼び慕っている。"},{"spoiler":false,"text":"小さい頃は男の子のようだったが、"},{"spoiler":false,"text":"今では可愛く成長し、身体はすっかり「女の子」になった。"},{"spoiler":false,"text":"恋に恋するお年頃で、"},{"spoiler":false,"text":"昔から仲が良かった主人公のことが気になっている。"},{"spoiler":false,"text":"極度の恥ずかしがり屋で、"},{"spoiler":false,"text":"少しでもからかうと、耳と顔が真っ赤になる。"},{"spoiler":false,"text":"学校では部員２名の陸上部に所属しており、"},{"spoiler":false,"text":"彼女が唯一の選手。得意なのは短距離走。"},{"spoiler":false,"text":"夏休みも学校で自主練していて、健康的に日焼けている。"},{"spoiler":false,"text":"故郷を去った主人公の代わりに、"},{"spoiler":false,"text":"よく村の子供のお世話をしているしっかり者。"},{"spoiler":false,"text":"まだ、この村から一度も出たことがない。"}],"source":"bangumi","sourceCharacterId":"125872"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e8af7ab942a63e06218974607998718d8a81f09b8819f1c3d1755fe8b751fbe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61b48ec5e781168e5081d8cecac01119f928c4522caf77eb2ddbeba9cc3db2cc.webp","width":121,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浜田夏樹","creatorId":"vndb:s20635","sourcePersonId":"vndb:s20635","canonicalEntityId":"vndb:s20635","name":"浜田夏樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230348:125872:25250:1","source":"bangumi"},{"creditedName":"木野原 さやか","creatorId":"vndb:s1452","sourcePersonId":"vndb:s1452","canonicalEntityId":"vndb:s1452","name":"木野原 さやか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76235","source":"vndb"}]},{"characterId":"char_c65828","characterName":"黒谷 麻実","sourceIds":{"bangumi":[{"characterId":"125873","match":"exact-normalized-name-in-linked-work","subjectId":"230348"}],"egsCharacterIds":["19641"],"vndbCharacterId":"c65828"},"originalCharacterName":"黒谷 麻実","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A junior who is one year younger than Aki When she first moved from the city to the countryside, Aki reached out to her, and they became friends from there."},{"spoiler":false,"text":"Since then, she's admired Akatsuki and became the track team manager, supporting her wholeheartedly. She's friendly and easygoing. Great at teasing."},{"spoiler":false,"text":"An honor student academically and generally serious, but when it comes to Aki, she sometimes gets starry-eyed and lets her feelings show..."},{"spoiler":false,"text":"Honestly, she thinks the village is a boring place."},{"spoiler":false,"text":"From Official website"}],"source":"vndb","sourceCharacterId":"c65828"},{"segments":[{"spoiler":false,"text":"「アキ先輩～～お慕いしてますぅぅぅぅぅぅ～～★」"},{"spoiler":false,"text":"暁の１年後輩。"},{"spoiler":false,"text":"都会から田舎へ引っ越してきたばかりの時、暁が声をかけてくれて、そこから友人になる。"},{"spoiler":false,"text":"それ以来、暁を慕って陸上部のマネージャーになり、彼女を全力でサポートをしている。"},{"spoiler":false,"text":"人当たりがよくて気さく。からかい上手。"},{"spoiler":false,"text":"勉強面でも優等生で基本的に真面目なタイプだが、ひとたび暁のことになると、目をハートを浮かせて感情を露わにする場合も…。"}],"source":"egs","sourceCharacterId":"19641","sourceWorkId":"26107","spoiler":false},{"segments":[{"spoiler":false,"text":"暁の１年後輩。"},{"spoiler":false,"text":"都会から田舎へ引っ越してきたばかりの時、"},{"spoiler":false,"text":"暁が声をかけてくれて、そこから友人になる。"},{"spoiler":false,"text":"それ以来、"},{"spoiler":false,"text":"暁を慕って陸上部のマネージャーになり、"},{"spoiler":false,"text":"彼女を全力でサポートをしている。"},{"spoiler":false,"text":"人当たりがよくて気さく。からかい上手。"},{"spoiler":false,"text":"勉強面でも優等生で基本的に真面目なタイプだが、"},{"spoiler":false,"text":"ひとたび暁のことになると、"},{"spoiler":false,"text":"目をハートを浮かせて感情を露わにする場合も…。"},{"spoiler":false,"text":"村のことは正直、退屈な場所だと思っている。"}],"source":"bangumi","sourceCharacterId":"125873"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1a16f0e869b9d9b660662b82a72b8b6075fbe2ae06299e37dda0849316606c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/864ebb87851d065e1aff05d80725919d9a1c11746a49614f6951bdff3aa044ce.webp","width":121,"height":256,"source":"static-detail"},"actors":[{"creditedName":"mahilo","creatorId":"vndb:s1492","sourcePersonId":"vndb:s1492","canonicalEntityId":"vndb:s1492","name":"眞尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230348:125873:34633:1","source":"bangumi"}]},{"characterId":"char_vndb_c65829","characterName":"楠木 亮","sourceIds":{"vndbCharacterId":"c65829"},"originalCharacterName":"楠木 亮","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p512","sourceCompanyId":"egs:brand:2089","canonicalEntityId":"vndb:p512","name":"はむはむソフト","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:26107:2089","source":"egs"},{"companyId":"vndb:p512","sourceCompanyId":"vndb:p512","canonicalEntityId":"vndb:p512","name":"はむはむソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:62212:v22156","source":"vndb"},{"companyId":"vndb:p512","sourceCompanyId":"vndb:p512","canonicalEntityId":"vndb:p512","name":"はむはむソフト","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:62213:v22156","source":"vndb"},{"companyId":"vndb:p512","sourceCompanyId":"vndb:p512","canonicalEntityId":"vndb:p512","name":"はむはむソフト","roleCodes":["developer","publisher"