339"],"vndbCharacterId":"c96299"},"originalCharacterName":"篠宮 柊香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"亜麻色の美しい髪をなびかせる美人学生会長。常に物腰穏やかで、柔らかなお姉さん口調で喋る。"},{"spoiler":false,"text":"しかし、本当は優等生を演じることに強烈なストレスを感じている。"},{"spoiler":false,"text":"素の顔を主人公に知られ、二人っきりの時は自分をさらけ出しすようになり、夜の学校に忍び込んだりパフェを何個も食べたりとハメを外すことも。"},{"spoiler":false,"text":"エロい身体だという自覚を持っていて主人公を誘惑したり、甘えたりと色んな顔を見せるかわいい先輩女子。"}],"source":"egs","sourceCharacterId":"23339","sourceWorkId":"30781","spoiler":false},{"segments":[{"spoiler":false,"text":"亜麻色の美しい髪をなびかせる美人学生会長。常に物腰穏やかで、柔らかなお姉さん口調で喋る。"},{"spoiler":false,"text":"しかし、本当は優等生を演じることに強烈なストレスを感じている。"},{"spoiler":false,"text":"素の顔を主人公に知られ、二人っきりの時は自分をさらけ出しすようになり、夜の学校に忍び込んだりパフェを何個も食べたりとハメを外すことも。"},{"spoiler":false,"text":"エロい身体だという自覚を持っていて主人公を誘惑したり、甘えたりと色んな顔を見せるかわいい先輩女子。"}],"source":"bangumi","sourceCharacterId":"92752"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00c16b2f55c7cca67b5d46812c3fd99f2686752d2cdaac63136a9af32d96b7e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b187b1094a4416b7c9401105abb9ab22c14c2aaebabe20199119f5ef272a46a.webp","width":191,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大地葉","creatorId":"vndb:s10070","sourcePersonId":"vndb:s10070","canonicalEntityId":"vndb:s10070","name":"大地 葉","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:331070:92752:10869:1","source":"bangumi"}]},{"characterId":"char_c96300","characterName":"四ツ木 柑奈","sourceIds":{"bangumi":[{"characterId":"92753","match":"exact-normalized-name-in-linked-work","subjectId":"331070"},{"characterId":"92753","match":"exact-normalized-name-in-linked-work","su