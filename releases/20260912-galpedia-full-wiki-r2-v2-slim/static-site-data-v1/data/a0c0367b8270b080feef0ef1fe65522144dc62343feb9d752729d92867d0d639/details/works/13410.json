{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"13410","model":{"presentationWorkId":"egs:13410","staff":{"artwork":[],"scenario":[],"music":[],"other":[{"creditedName":"はしもとよしふみ(橋本嘉史)","creatorId":"egs:creator:28275","sourcePersonId":"egs:creator:28275","canonicalEntityId":"egs:creator:28275","name":"はしもとよしふみ(橋本嘉史)","detail":"原作、プロデューサー、キャスティングディレクター","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:171463","source":"egs"},{"creditedName":"岩崎美奈子","creatorId":"egs:creator:5236","sourcePersonId":"egs:creator:5236","canonicalEntityId":"egs:creator:5236","name":"岩崎美奈子","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"no-alias-hit","relationId":"egs:work-creator:179909","source":"egs"},{"creditedName":"Point Pictures(株式会社ポイント・ピクチャーズ)","creatorId":"vndb:s5820","sourcePersonId":"egs:creator:14524","canonicalEntityId":"vndb:s5820","name":"Point Pictures(株式会社ポイント・ピクチャーズ)","detail":"OPアニメーション&グラフィック","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:84270","source":"egs"}]},"cast":[{"characterId":"char_bangumi_76193","characterName":"マイス","sourceIds":{"bangumi":[{"characterId":"76193","match":"source-roster","subjectId":"3235"}]},"originalCharacterName":"マイス","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公。記憶喪失の少年。明朗な性格の少年で、見ず知らずだった村の住人ともすぐにうち解ける。"},{"spoiler":false,"text":"モンスターの母と人間の父の間に生まれた子供であるため、持っている「変身ベルト」でモンスターに姿を変えることができる。その能力に目をつけたアクナビートによって記憶を奪われ、計画に利用するためにシアレンスの村に送り込まれた。"},{"spoiler":false,"text":"かつてはいずこかの騎士団に所属しており、各地のボスキャラを追いかけていた記憶がある。最終ダンジョンでの決戦の後にアクナビートから記憶を奪った理由と真意を聞かされ、記憶の返却を持ちかけられたが、村にとどまることを選んだ。"}],"source":"bangumi","sourceCharacterId":"76193"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af787fbd08104073f943e853281b9fd0b69c2ceaeb98b99ce230795891529be2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b73e2bf9cd8d4df4454d4ec0f19b91da710d1a747571b9da77d072b20dc716e3.webp","width":122,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白石涼子","creatorId":"vndb:s953","sourcePersonId":"vndb:s953","canonicalEntityId":"vndb:s953","name":"白石涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3235:76193:4730:1","source":"bangumi"}]},{"characterId":"char_bangumi_76194","characterName":"シア","sourceIds":{"bangumi":[{"characterId":"76194","match":"source-roster","subjectId":"3235"}]},"originalCharacterName":"シア","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"花をこよなく愛する女の子。優しく、誰にでも分け隔てなく接するが、頑固な一面も持ち、花の事となるとさらに頑固になる。プリベラの森の花畑を世話している。やや天然ボケ気味で、結婚後の弁当に花を出してくることもある。草花が好き。"},{"spoiler":false,"text":"使用武器はジョウロ。"},{"spoiler":false,"text":"【家族】ウェルズ、モニカ"}],"source":"bangumi","sourceCharacterId":"76194"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02967a3710660a412e3ea431df02be6ac5755691bd6d6f30f946c4db2b6bb43e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/746c1afc5a4ca2b985fe6e79c423e3d91b78357662ffa4d1359db6a17101371b.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"福井裕佳梨","creatorId":"vndb:s10439","sourcePersonId":"vndb:s10439","canonicalEntityId":"vndb:s10439","name":"福井 裕佳梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3235:76194:4185:1","source":"bangumi"}]},{"characterId":"char_bangumi_76195","characterName":"トゥーナ","sourceIds":{"bangumi":[{"characterId":"76195","match":"source-roster","subjectId":"24962"},{"characterId":"76195","match":"source-roster","subjectId":"3235"}]},"originalCharacterName":"トゥーナ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ガジの鍛冶屋に住み込みで働いている女の子。周囲の人間に心を閉ざしており、知り合った当初は冷淡な態度を取るが、次第に主人公とうち解けて笑顔を見せるようになる。カリンとソフィアとは親友であり、例外的に心を開いてつきあっている。結晶やそれを用いて作ったペンダントが好き。恐がりな一面もあり、ドクロなど幽霊を思い浮かべる物は苦手。"},{"spoiler":false,"text":"使用武器は片手剣。"},{"spoiler":false,"text":"【家族】なし"}],"source":"bangumi","sourceCharacterId":"76195"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/129c5399d0b7bbf52342a7e4f73e7c5e616b7f08be877447ef6eaceca41a6b3c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5bc9be24fbd4dfde0facb3e508c0052afa6b9cefdc18731e30afceda9d53911e.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤英美里","creatorId":"vndb:s1190","sourcePersonId":"vndb:s1190","canonicalEntityId":"vndb:s1190","name":"加藤 英美里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3235:76195:4850:1","source":"bangumi"}]},{"characterId":"char_bangumi_76196","characterName":"マリオン","sourceIds":{"bangumi":[{"characterId":"76196","match":"source-roster","subjectId":"3235"}]},"originalCharacterName":"マリオン","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔女見習いのお医者さん見習い。医学に魔術を取り込む研究に奔走中。そしていつも暴走中。主人公が来るまでは大概ショコラが被害者だった。緑の野菜が好物だが、トマトは苦手。"},{"spoiler":false,"text":"手にしている独特の形状の注射器はマージョリーにもらったらしい。"},{"spoiler":false,"text":"使用武器は杖。"},{"spoiler":false,"text":"【家族】マージョリー"}],"source":"bangumi","sourceCharacterId":"76196"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0ff8316074d27c3cc465c3d5f4bd41c7c61c746c94454b37094d9e8b8207db55.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d16777fd3f402d074a6e3380144d300f3f62ff19247fee8abdce582b4b266a58.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤村歩","creatorId":"vndb:s1703","sourcePersonId":"vndb:s1703","canonicalEntityId":"vndb:s1703","name":"藤村 歩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3235:76196:4783:1","source":"bangumi"}]},{"characterId":"char_bangumi_76197","characterName":"ショコラ","sourceIds":{"bangumi":[{"characterId":"76197","match":"source-roster","subjectId":"3235"}]},"originalCharacterName":"ショコラ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"食堂の看板娘でスーシェフを務める。食べることが大好きで、大食いだがまったく大きくならない。主人公が来るまではマリオンの実験の標的だった。カレー料理が好きで、牛乳は全く飲めない。"},{"spoiler":false,"text":"低い身長をかなり気にしており、指摘されると機嫌が悪くなる。"},{"spoiler":false,"text":"使用武器は斧。"},{"spoiler":false,"text":"【家族】グルテン、ラスク"}],"source":"bangumi","sourceCharacterId":"76197"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c9615c1f56fa2cc4c97806333d260c41cc6118248296dac9bba89bafae001a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1a4c9e52e7547d30d3e78ead1b00f713d88e715afd9efd4dbb32e6c572d0cbb.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"喜多村英梨","creatorId":"vndb:s269","sourcePersonId":"vndb:s269","canonicalEntityId":"vndb:s269","name":"喜多村 英梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3235:76197:4251:1","source":"bangumi"}]},{"characterId":"char_bangumi_76198","characterName":"イオン","sourceIds":{"bangumi":[{"characterId":"76198","match":"source-roster","subjectId":"3235"}]},"originalCharacterName":"イオン","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魚釣りが大好きな女の子。兄が開いた釣り堀屋を手伝っている。元気がよすぎて、たまにパンチが飛んでくる。好物は魚料理で、結婚後の弁当もほとんどが魚関係。カボチャは苦手。"},{"spoiler":false,"text":"使用武器は釣り竿。"},{"spoiler":false,"text":"【家族】カルロス"}],"source":"bangumi","sourceCharacterId":"76198"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2ae8ffa7e7c45478e24a819e6b66b4fae05aec4826939c3fc0cdba71b88925a0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed3deb565973439e9141ab3eacbe94f48b9787a963cac1ca029aed9d81db5129.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"戸松遥","creatorId":"vndb:s5478","sourcePersonId":"vndb:s5478","canonicalEntityId":"vndb:s5478","name":"戸松 遥","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3235:76198:4856:1","source":"bangumi"}]},{"characterId":"char_bangumi_76199","characterName":"ペルシャ","sourceIds":{"bangumi":[{"characterId":"76199","match":"source-roster","subjectId":"3235"}]},"originalCharacterName":"ペルシャ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"お風呂屋を営むマーメイド。ボケ担当で色恋も良く分かってない。水につかると足がヒレになってしまうが水着姿は別に用意されている。魚を食べることに絡んだ話をすると本気で怒るが、イカを使った料理は好物としている。"},{"spoiler":false,"text":"使用武器は両手剣及び泡。"},{"spoiler":false,"text":"【家族】なし"}],"source":"bangumi","sourceCharacterId":"76199"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/acd952cd01a10cbc82fc4fd3fcb58fb4d9540a9a200a382199510319c614f5e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5ede44b89c015db818cd672ee9d04f74c95b745f43f7acf634333f84818c989.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"遠藤綾","creatorId":"vndb:s5699","sourcePersonId":"vndb:s5699","canonicalEntityId":"vndb:s5699","name":"遠藤 綾","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3235:76199:4893:1","source":"bangumi"}]},{"characterId":"char_bangumi_76200","characterName":"ダリア","sourceIds":{"bangumi":[{"characterId":"76200","match":"source-roster","subjectId":"3235"}]},"originalCharacterName":"ダリア","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"絵画、彫刻などをこなす芸術家。虹が大好きで、なんでも虹色にアレンジする。「レインボ〜♪」が口癖。主人公の事を勝手に助手呼ばわりする。家の付近とダンジョン中に置かれている奇妙なオブジェは彼女の作品。めざしと田楽が好き。"},{"spoiler":false,"text":"戦闘中、時折「レインボ〜♪」の声と共に虹色の波紋が広がるが特に何も起こらない。"},{"spoiler":false,"text":"使用武器はハンマー。"},{"spoiler":false,"text":"【家族】森の作品達"}],"source":"bangumi","sourceCharacterId":"76200"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b49549077bfe5fb43171cafb4c2869599b0f418af499abf60fb4fed5965a8bd5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef8ddb4e34901338ecb0282b0c788f8b665179637360983441b5e36bb030dc03.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"堀江由衣","creatorId":"vndb:s46","sourcePersonId":"vndb:s46","canonicalEntityId":"vndb:s46","name":"堀江 由衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3235:76200:3970:1","source":"bangumi"}]},{"characterId":"char_bangumi_76201","characterName":"さくや","sourceIds":{"bangumi":[{"characterId":"76201","match":"source-roster","subjectId":"3235"}]},"originalCharacterName":"さくや","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"旅が大好きな旅館の娘。突っ込み担当。行商人もしていて、モンスターに追われながら、落ちているものを拾ってお店に並べている。"},{"spoiler":false,"text":"料理（特に卵料理）が苦手で、大概失敗するが、結婚後は腕を磨いたのか作るのが難しい料理をたまに弁当にして渡してくれる。"},{"spoiler":false,"text":"使用武器は両手剣。"},{"spoiler":false,"text":"【家族】しののめ"}],"source":"bangumi","sourceCharacterId":"76201"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3c512e06be92da7b13e1c2804dc69816794413d6e01660e912c777b26157cda.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e06bbc1719e169b3105972de49bde99b6777e44fef7be95c872185d38c288f08.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新谷良子","creatorId":"vndb:s3626","sourcePersonId":"vndb:s3626","canonicalEntityId":"vndb:s3626","name":"新谷 良子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3235:76201:4305:1","source":"bangumi"}]},{"characterId":"char_bangumi_76202","characterName":"ソフィア・ハラペニョ・ヴィヴィアージュ","sourceIds":{"bangumi":[{"characterId":"76202","match":"source-roster","subjectId":"3235"}]},"originalCharacterName":"ソフィア・ハラペニョ・ヴィヴィアージュ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ルーンファクトリーシリーズおなじみのヴィヴィアージュ家の令嬢。"},{"spoiler":false,"text":"思っていることと正反対の事を言ってしまうため、発言を誤解されることが多いが、考え方は至って常識的。しかし他の人が嫌がるゴミ類や失敗作などの「役に立つ物」を貰うと喜ぶなど、趣向はかなりズレている。正反対に解釈するべきセリフは赤字で表記されるため、プレイヤーには判別は容易。"},{"spoiler":false,"text":"使用武器は片手剣。"},{"spoiler":false,"text":"【家族】ドンチャコス、エリザ"}],"source":"bangumi","sourceCharacterId":"76202"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02dc95ee88094438bc486a69fb94827e8042b6f26cd2c7f305989ae95f398ec1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/2330b7b1d75b430e204737303783590cd186b81945e1b62f77acaadf0c41ee62.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茅原実里","creatorId":"vndb:s1459","sourcePersonId":"vndb:s1459","canonicalEntityId":"vndb:s1459","name":"茅原 実里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3235:76202:4421:1","source":"bangumi"}]},{"characterId":"char_bangumi_76203","characterName":"カリン","sourceIds":{"bangumi":[{"characterId":"76203","match":"source-roster","subjectId":"3235"}]},"originalCharacterName":"カリン","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"とてもめんどくさがりで、いつも眠そうにしている雑貨屋の娘。都会に行くのが夢だが、それすらもめんどくさい。そもそも都会とは何なのかということ自体あまり知らない。特定の依頼を達成するまでは戦ってくれない。よく心の中で文句を言ったりする。"},{"spoiler":false,"text":"イベントを進めるとやる気を出して積極的に店の営業に携わろうとして、戦闘にも参加するようになる。"},{"spoiler":false,"text":"使用武器は杖。好きなものはダイヤモンド以外の宝石（アクセサリー、指輪）。"},{"spoiler":false,"text":"【家族】ヘーゼル"}],"source":"bangumi","sourceCharacterId":"76203"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0b8d0ac162ee6ba1b0c47578973d48eaf0602f19bebcd47bc8d69f9ca7d6c61.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e511a55047ec98055139975ce3be5943df6a487bb1c1012ef46dc54d61f4cd3a.webp","width":161,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤静","creatorId":"vndb:s516","sourcePersonId":"vndb:s516","canonicalEntityId":"vndb:s516","name":"伊藤 静","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3235:76203:4272:1","source":"bangumi"}]},{"characterId":"char_bangumi_76204","characterName":"クルルファ","sourceIds":{"bangumi":[{"characterId":"76204","match":"source-roster","subjectId":"3235"}]},"originalCharacterName":"クルルファ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"集落を治める長老。額に角を生やす有角人の生き残り。オンドルファとは幼い頃からの仲。はるか昔に人間たちとの間にあった諍いが原因で人間を極度に嫌っているが、ストーリー終盤で和解する。"},{"spoiler":false,"text":"集落の長として威厳ある態度を取ろうと務めている。が、甘いもの好きの性格を抑えられず、こっそりと主人公に調達を頼むことも。その出自故にモンスターの収集品を渡すと怒る。"},{"spoiler":false,"text":"使用武器は杖。"},{"spoiler":false,"text":"【家族】なし"}],"source":"bangumi","sourceCharacterId":"76204"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5bae9caa901ae8f02acc331002e2237b6e63b9718c72158c4d2587b6f06321c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/i