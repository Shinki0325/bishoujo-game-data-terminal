}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Till's classmates, she bumps into him on the first day at Equites. While she is smart enough to be class representative, she is inexperienced in other matters."},{"spoiler":true,"text":"Sefi's real name is Serafina Odorun, the Princess of Ederant. She hides her true identity as one of the qualifications to succeed the throne requires her to graduate from Equites without anyone knowing of her true identity."}],"source":"vndb","sourceCharacterId":"c35171"},{"segments":[{"spoiler":false,"text":"主人公と同じ騎士学園に通う新入生の少女。"},{"spoiler":false,"text":"武芸達者で頭脳明晰。入学生代表の挨拶を務めるなど、何かと注目を集める優等生。"},{"spoiler":false,"text":"けれども、城下町を歩いたことがない、下ネタには完全に置いてきぼりにされるなど、ちょっと世間知らずなのかなと思わせるところも。"},{"spoiler":false,"text":"ふとした仕草などに、気品や高貴さを感じさせる。"},{"spoiler":false,"text":"どことなくやんごとなき身分であることを匂わせているが、真相は不明。"},{"spoiler":false,"text":"『偶然』、国の王女セラフィナ＝オードルーンと誕生日が同じ。"}],"source":"egs","sourceCharacterId":"6899","sourceWorkId":"21644","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同じ騎士学園に通う新入生の少女。"},{"spoiler":false,"text":"部芸達者で頭脳明晰。 入学生代表の挨拶を務めるなど、何かと注目を集める優等生。"},{"spoiler":false,"text":"けれど城下町を歩いたことがなかったり、下ネタには完全に置いてきぼりにされたり、"},{"spoiler":false,"text":"ちょっと世間知らずなのかなと思わせるところも。"},{"spoiler":false,"text":"ふとした仕草などに、気品や高貴さを感じさせる。"},{"spoiler":false,"text":"どことなくやんごとなき身分であることを匂わせているが、真相は不明。"},{"spoiler":false,"text":"偶然にも、国の王女・ セラフィナ＝オードルーン と誕生日が同じ。"},{"spoiler":false,"text":"「呼び捨てにされたとき、なんだか不思議な気持ちになったんです。 これがきっと、友情というものなんですね！」"}],"source":"bangumi","sourceCharacterId":"33519"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"6899","sourceWorkId":"21644","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"6899","sourceWorkId":"21644","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"6899","sourceWorkId":"21644","sourceField":n