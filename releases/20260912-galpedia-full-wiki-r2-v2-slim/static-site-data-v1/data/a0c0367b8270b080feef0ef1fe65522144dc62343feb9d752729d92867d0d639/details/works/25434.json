,"relationId":"vndb:vn-staff:141104","source":"vndb"}]},"cast":[{"characterId":"char_c64423","characterName":"夏目 明彦","sourceIds":{"bangumi":[{"characterId":"201284","match":"exact-normalized-name-in-linked-work","subjectId":"217236"}],"egsCharacterIds":["17431"],"vndbCharacterId":"c64423"},"originalCharacterName":"夏目 明彦","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「はぁ……。俺が行くと思うか？　一人で、薄気味悪い廃城なんかに」"},{"spoiler":false,"text":"留学ではるばる英国までやってきた、日本の学生。"},{"spoiler":false,"text":"幼い頃に妹を亡くしてしまったことを、未だに悔やんでいる。"},{"spoiler":false,"text":"以来、生と死について考えるようになり、医学部で学ぶ。"}],"source":"egs","sourceCharacterId":"17431","sourceWorkId":"25434","spoiler":false},{"segments":[{"spoiler":false,"text":"留学ではるばる英国までやってきた、日本の学生。"},{"spoiler":false,"text":"幼い頃に妹を亡くしてしまったことを、未だに悔やんでいる。"},{"spoiler":false,"text":"以来、生と死について考えるようになり、医学部で学ぶ。"}],"source":"bangumi","sourceCharacterId":"201284"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7dfabb041bd3b6e54a319d273c6bbe183f0af5ea595c48b74b0e7859f7ab47c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d46698dff574a30261ef5314027a8013b34b0a839c2edb61476c9a4b6e15f07.webp","width":92,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c64424","characterName":"リネット","sourceIds":{"bangumi":[{"characterId":"142471","match":"exact-normalized-name-in-linked-work","subjectId":"217236"}],"egsCharacterIds":["17428"],"vndbCharacterId":"c64424"},"originalCharacterName":"リネット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「２１グラム――。それが、魂の重さなのだというわ。私には、それが足りないの。だから、虚っぽ」"},{"spoiler":false,"text":"意識というものが芽生えてからずっと、この城にいる自動人形。"},{"spoiler":false,"text":"造られてこのかた『魂』を欲している。"},{"spoiler":false,"text":"魂を渇望するが余り、残虐なことにも手を出してきたが、相手が城に迷い込んだ野盗などであったため、あまり気にしていない。"},{"spoiler":false,"text":"その態度は横柄で横暴。たまに暴走しそうになることもあるが、その度にメイドによってたしなめられている。"}],"source":"egs","sourceCharacterId":"17428","sourceWorkId":"25434","spoiler":false},{"segments":[{"spoiler":false,"text":"意識というものが芽生えてからずっと城にいる自動人形。"},{"spoiler":false,"text":"造られてこのかた “魂” を欲し続けている。"},{"spoiler":false,"text":"魂を渇望するあまり残虐なこともしてきたが、相手が野盗などであったため あまり気にしてはいない。"},{"spoiler":false,"text":"その態度は横柄で横暴。 たまに暴走しそうになることもあるが、その度にメイドによってたしなめられている。"},{"spoiler":false,"text":"「21グラム―― それが、魂の重さなのだというわ。 私には、それが足りないの。 だから、虚っぽ」"}],"source":"bangumi","sourceCharacterId":"142471"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f59ebe1e7d5c22f2b50eca098dde336309f719175e461c49340eb4082277d20a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99dc667efe1f29fbfca0cdd3c830af7324e08d23653ef38baf617203d43e5d6b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桐村まり","creatorId":"vndb:s1549","sourcePersonId":"vndb:s1549","canonicalEntityId":"vndb:s1549","name":"桐村 まり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217236:142471:23768:1","source":"bangumi"}]},{"characterId":"char_c64425","characterName":"アン","sourceIds":{"bangumi":[{"characterId":"142472","match":"exact-normalized-name-in-linked-work","subjectId":"217236"}],"egsCharacterIds":["17429"],"vndbCharacterId":"c64425"},"originalCharacterName":"アン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"s