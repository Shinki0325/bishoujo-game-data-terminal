ler":false,"text":"中でも一番のお気に入りは、自作のモーゼルC96レプリカ。"},{"spoiler":false,"text":"「失礼。御邪魔だったかな？」"}],"source":"bangumi","sourceCharacterId":"48581"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60efcc4e992490721be3f36553ef51535492e615beb0dc92bbf224bc51f80d53.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96289a01afa1212ce4f16b688b77c5e3b4415e8adbc888c9fd88318b72565581.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"折笠愛","creatorId":"vndb:s752","sourcePersonId":"vndb:s752","canonicalEntityId":"vndb:s752","name":"折笠 愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20714:48581:3831:1","source":"bangumi"}]},{"characterId":"char_c8238","characterName":"コールダー・ベンスン","sourceIds":{"bangumi":[{"characterId":"48580","match":"exact-normalized-name-in-linked-work","subjectId":"20714"}],"egsCharacterIds":["12204"],"vndbCharacterId":"c8238"},"originalCharacterName":"コールダー・ベンスン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Bounty hunter. A female gunslinger, her trademark is her blonde hair."},{"spoiler":false,"text":"No one knows her real name."},{"spoiler":false,"text":"She loves using her replica gun: the Remington New Model Army."}],"source":"vndb","sourceCharacterId":"c8238"},{"segments":[{"spoiler":false,"text":"レミントン・ニューモデルアーミーのレプリカを愛用する賞金稼ぎで、"},{"spoiler":false,"text":"美しい金髪がトレードマークの凄腕ガンマン。"},{"spoiler":false,"text":"“ブロンディ”“ミズ・ノーバディ”等の呼称で呼ばれるが、"},{"spoiler":false,"text":"決して名乗らないので、本名は誰にもわからない。"}],"source":"egs","sourceCharacterId":"12204","sourceWorkId":"9138","spoiler":false},{"segments":[{"spoiler":false,"text":"賞金稼ぎ。金髪がトレードマークの女ガンマン。"},