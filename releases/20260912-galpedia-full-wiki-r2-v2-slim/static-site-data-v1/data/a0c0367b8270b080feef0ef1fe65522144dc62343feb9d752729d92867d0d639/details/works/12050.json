tors":[{"creditedName":"芹園 みや","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26894","source":"vndb"}]},{"characterId":"char_c47588","characterName":"シンシア","sourceIds":{"bangumi":[],"egsCharacterIds":["2313"],"vndbCharacterId":"c47588"},"originalCharacterName":"シンシア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"常に魔法戦士セレナと共に行動し街の平和を守るため人知れず活躍する。"},{"spoiler":false,"text":"噂では異世界の戦士だとか宇宙人だとか色々言われているが真相は謎。"},{"spoiler":false,"text":"学園祭開催中に彼女達の活躍はあるのだろうか？"}],"source":"egs","sourceCharacterId":"2313","sourceWorkId":"12050","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士の系譜の最終形態　月を力の源とする。"},{"spoiler":false,"text":"お姉ちゃん娘の依存体質だが、シュガーに叱咤され独り立ちした変身ヒロインに変貌していく。"}],"source":"egs","sourceCharacterId":"2313","sourceWorkId":"19685","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a84b0ad17df67ac8b6081b1f9c16a9b97d0390f441a988a8ec10f6cafd99419.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37494270520ea843812be2381a8686dd6142e44a6c46558c19f744f1a30f5790.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野宮 香央里","creatorId":"vndb:s830","sourcePersonId":"vndb:s830","canonicalEntityId":"vndb:s830","name":"宮沢ゆあな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26897","source":"vndb"}]},{"characterId":"char_c47589","characterName":"シンフォニックシュガー","sourceIds":{"bangumi":[{"characterId":"96141","match":"exact-normalized-name-in-linked-work","subjectId":"222233"}],"egsCharacterIds":["2314"],"vndbCharacterId":"c47589"},"originalCharacterName":"シンフォニックシュガー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"AB"},"bust":{"reviewState":"source-only","source":"vndb","value":"76"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"普段は物静かな天才科学者。シンフォニックリリーに信頼以上の気持ちを寄せいている。"},{"spoiler":false,"text":"対ファルケ・シルヴァ抵抗組織『白薔薇』のメンバーとして莉々奈を奪回しようとエクセリウムで活動中。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"冷静沈着ながら敵対した相手には容赦のない攻撃をする。"},{"spoiler":false,"text":"今まで虚勢を張りながらも堕ちきらなかった彼女が心の支えのない中精神を疲労させていき姦計にはまっていく。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"19685","spoiler":false},{"segments":[{"spoiler":false,"text":"「私の声が聞こえたのなら、きっと莉々奈さんが私を呼んでくれたからです」"},{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"普段は物静かで冷静沈着な天才科学者。"},{"spoiler":false,"text":"莉々奈とは厚い信頼関係に結ばれており、理論・技術面から百合瀬財団の活動を支えている。"},{"spoiler":false,"text":"幼げな容姿に似合わない強靭な意思と折れない心を持つ。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士シンフォニックナイツ」ほか"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"天才的な頭脳を持つ世界的な科学者。"},{"spoiler":false,"text":"シンフォニックリリーとともに国際教導学園から身を引き、自らの魔法研究を進める傍ら魔法戦士として活動を続けている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"28226","spoiler":false},{"segments":[{"spoiler":false,"text":"歴戦の魔法戦士、シンフォニックナイツの一人。"},{"spoiler":false,"text":"物静かで冷静沈着、数々の魔法理論や技術を開発している天才科学者。"},{"spoiler":false,"text":"現在は異世界ロアにて研究活動を行っており、時折レムティアシータに技術的なアドバイスを与えている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"31509","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックナイツの一人、シンフォニックシュガー。本名は甘樹菜々芭。"},{"spoiler":false,"text":"優秀な技術者で、魔法戦士たちの新たな力をいくつも開発する。"},{"spoiler":false,"text":"国際教導学園で教師として働きながら、魔法技術の研究も怠らない。"},{"spoiler":false,"text":"シンフォニックリリーである百合瀬莉々奈とは深い絆で結ばれたパートナー。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックナイツの一人、シンフォニックシュガー。優秀な研究者、技術者として、魔法戦士たちの勝利を支えている。同じシンフォニックナイツの一人である莉々奈とは深い絆で結ばれており、彼女の経営する国際教導学園で教師としても働いている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"40423","spoiler":false},{"segments":[{"spoiler":false,"text":"見た目は幼げな、物静かで無表情な天才技術者"},{"spoiler":false,"text":"集中し始めると周りのことが全く目に入らなくなる"},{"spoiler":false,"text":"その明晰な頭脳を巡って両親が争い、挙げ句二人ともが不慮の死を遂げたため、自分の持つ才能に嫌悪感すら持ってしまっていた。そのためか、感情の表現もうまくない。"},{"spoiler":false,"text":"莉々奈に出会ったことでその頭脳を人類のために役立てることに喜びと、両親への贖罪を見いだす。また、自分の力を役立てる道を見つけてくれた莉々奈に対し、信頼関係以上の感情を抱いている。"}],"source":"bangumi","sourceCharacterId":"96141"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/8609a430ae70cca7f0b6e759a667e02697a36c766f741c77a34be38ffd50cffc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/1712c987ff84caddb112cef83a5939ceff92a62c4c53b935d6c40b3f59bc9fff.webp","width":156,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222234:96141:4810:1","source":"bangumi"}]},{"characterId":"char_c47590","characterName":"エリクシル・ローズ","sourceIds":{"bangumi":[{"characterId":"96146","match":"exact-normalized-name-in-linked-work","subjectId":"222233"}],"egsCharacterIds":["2315"],"vndbCharacterId":"c47590"},"originalCharacterName":"エリクシル・ローズ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"理知的で強い意志を持つエリクシルナイツの一人。"},{"spoiler":false,"text":"対ファルケ・シルヴァ抵抗組織『白薔薇』のメンバーとして"},{"spoiler":false,"text":"エリクシルライムを取り戻そうと、アマギスにてシルヴァと戦い続けている。"}],"source":"egs","sourceCharacterId":"2315","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"優しく丁寧な言葉づかいのお嬢様だが、やはり正義のためには熱いハートを剥き出しにする。"},{"spoiler":false,"text":"年長者の責任重圧の中、正義と性欲の葛藤に苦しむ。"}],"source":"egs","sourceCharacterId":"2315","sourceWorkId":"19685","spoiler":false},{"segments":[{"spoiler":false,"text":"「今回の事件……シルヴァが関係しているに違いありませんわ」"},{"spoiler":false,"text":"エリクシルナイツの一人。"},{"spoiler":false,"text":"成績優秀、理知的で強い意志を持ち、一見クールで近寄りがたい印象を与えるが、亜梨子がシルヴァに下っていたときも彼女を信じ続けるという友情に厚い一面も併せ持つ。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士エリクシルナイツ」ほか"}],"source":"egs","sourceCharacterId":"2315","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士エリクシルナイツの一人、エリクシルローズ。本名は鏡島樹。"},{"spoiler":false,"text":"エリクシルライムこと立花亜梨子とともに、国際教導学園の魔法科で教師として働いている。担当は座学。"},{"spoiler":false,"text":"鞭のように形状を変化させる剣で近距離戦から中距離戦までマルチにこなす万能型。"},{"spoiler":false,"text":"その冷静な判断力で仲間たちの危機を何度も救っている。"}],"source":"egs","sourceCharacterId":"2315","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"『次世代総合研究学園ネクスト』でもトップクラスの成績を誇る聡明な少女。"},{"spoiler":false,"text":"普段の物腰はやわらかいが、己の正しいと思ったことは、例え意見がぶつかり 合っても押し通す激しさも持っている。"},{"spoiler":false,"text":"エリクシルライムとシルヴァの戦いに巻き込まれ、この世界を侵略する者の存在を知り、エリクシルライムに憧れを抱く。"},{"spoiler":false,"text":"そして再びシルヴァと相まみえた時、変容魔法の素質に開花し、 エリクシルローズに変身する。"}],"source":"bangumi","sourceCharacterId":"96146"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7f78ae7e5f7ae0dafc81bd670d7a33bea81f18239e2f97cb087b8165ae83ea0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f33251a4ec7a044b4b87d92102ee08907490d977e77ce43952d98a7e3cccdc94.webp","width":114,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高口幸子","creatorId":"vndb:s261","sourcePersonId":"vndb:s261","canonicalEntityId":"vndb:s261","name":"高口 幸子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222234:96146:4838:1","source":"bangumi"}]},{"characterId":"char_c47592","characterName":"正義女王","sourceIds":{"bangumi":[{"characterId":"96161","match":"exact-normalized-name-in-linked-work","subjectId":"222240"}],"egsCharacterIds":["2316"],"vndbCharacterId":"c47592"},"originalCharacterName":"正義女王","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"137"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"正義を審判する魔法戦士の見定め役の彼女だが捕縛陵辱されない性欲を強制的に引き出される。"},{"spoiler":false,"text":"色々謎の多い彼女。"},{"spoiler":false,"text":"今作で黒幕のディラックとの過去の因縁と自身の出自が明かされる。"}],"source":"egs","sourceCharacterId":"2316","sourceWorkId":"19685","spoiler":false},{"segments":[{"spoiler":false,"text":"本編に出てくる謎の女の子。"},{"spoiler":false,"text":"学園祭の出し物「怪しいお店」の店番。"},{"spoiler":false,"text":"小さな体型で不遜な態度"},{"spoiler":false,"text":"主人公の事が何やら気になってる様子。"}],"source":"bangumi","sourceCharacterId":"96161"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac3078fe5e35923a979f2492bf74059bdf