urceIds":{"bangumi":[{"characterId":"66358","match":"exact-normalized-name-in-linked-work","subjectId":"260632"}],"egsCharacterIds":["20446"],"vndbCharacterId":"c75371"},"originalCharacterName":"北見 莉央","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"306"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Favorite series: Cube."},{"spoiler":false,"text":"Favorite character: Mamiya Yakumo."},{"spoiler":false,"text":"Rio is a second year high school student and classmates of Kyouya, Takuto and Azusa. She is a terrible gamer, a severe otaku and also a doujinshi author known enough for her yuri works on the characters in CUFFS Story's under the name \"Kawai Atsume\". Together with Takuto, she is the founding member of a game guild; she wants Kyouya to join it as well. A rather mediocre student, she is nevertheless very involved in her work as an artist, always finishing her work on time."},{"spoiler":false,"text":"Because of her strong taste for yuri, Rio is often teased by Azusa who tells Nana to be careful around Rio because she could \"attack\" her at any moment. However, Rio is heterosexual (but that doesn't stop her from making Azusa believe that she would prefer to \"attack\" her) and she dreams of one day finding a nice boy with whom she can share her passion."}],"source":"vndb","sourceCharacterId":"c75371"},{"segments":[{"spoiler":false,"text":"恭也のクラスメイトの女子。"},{"spoiler":false,"text":"同人誌の絵描きとして大手サークルを運営している、その筋では有名な絵師。"},{"spoiler":false,"text":"サークル名は「サークルＫＩＪ」（Kawaii Is Justice）"},{"spoiler":false,"text":"ペンネームはハンドルネームと同じ「河合あつめ」日常系の可愛らしい美少女イラスト・漫画中心のサークル。"},{"spoiler":false,"text":"恭也と拓人とは好きなアニメやゲームなどの趣味が合うため、時折会話に混ざってくる。"},{"spoiler":false,"text":"拓人の影響や世間で流行していることから、「CUFFS Story's」を始めてハマり、今は「CUFFS Story's」の同人誌をメインに活動している。"},{"spoiler":false,"text":"即売会では、自作のコスプレ衣装に身を包んで頒布する。"},{"spoiler":false,"text":"SNSでネタにしたり、同人誌に描くためガチャは必須。"},{"spoiler":false,"text":"同人誌の売り上げのほぼ全額を突っ込んでいる。"}],"source":"egs","sourceCharacterId":"20446","sourceWorkId":"27252","spoiler":false},{"segments":[{"spoiler":false,"text":"恭也のクラスメイトの女子。"},{"spoiler":false,"text":"同人誌の絵描きとして大手サークルを運営している、"},{"spoiler":false,"text":"その筋では有名な絵師。"},{"spoiler":false,"text":"サークル名は「サークルKIJ」（Kawaii Is Justice）"},{"spoiler":false,"text":"ペンネームはハンドルネームと同じ「河合あつめ」"},{"spoiler":false,"text":"日常系の可愛らしい美少女イラスト・漫画中心のサークル。"},{"spoiler":false,"text":"恭也と拓人とは好きなアニメやゲームなどの趣味が合うため、"},{"spoiler":false,"text":"時折会話に混ざってくる。"},{"spoiler":false,"text":"拓人の影響や世間で流行していることから、"},{"spoiler":false,"text":"「カフスト」を始めてハマり、"},{"spoiler":false,"text":"今は「カフスト」の同人誌をメインに活動している。"},{"spoiler":false,"text":"即売会では、自作のコスプレ衣装に身を包んで頒布する。"},{"spoiler":false,"text":"SNSでネタにしたり、同人誌に描くためガチャは必須。"},{"spoiler":false,"text":"同人誌の売り上げのほぼ全額を突っ込んでいる。"}],"source":"bangumi","sourceCharacterId":"66358"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c01fb8fc6ba64cacf333903f7286bafc47586c6f4e3ed429783deb93751fff07.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48db7af67fc1219f9ba39cd0bdbf8e66ea22870e5ba299ff4b97f861259dc156.webp","width":134,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高森奈津美","creatorId":"vndb:s979","sourcePersonId":"vndb:s979","canonicalEntityId":"vndb:s979","name":"高森 奈津美","roleCode":"voice-actor","roleLabel":"声优","identityStatus