oice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85369","source":"vndb"}]},{"characterId":"char_vndb_c91969","characterName":"響野 ゆかり","sourceIds":{"vndbCharacterId":"c91969"},"originalCharacterName":"響野 ゆかり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"312"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"G"},"height":{"reviewState":"source-only","source":"vndb","value":"144"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"School Year: Gap Year Before University"},{"spoiler":false,"text":"Occupation: Hibikino Shop Manager (Marketing, Product Procurement)"},{"spoiler":false,"text":"\"I'm the manager of an eroge shop, you know? Reading eroge during work is just another part of my duties!\""},{"spoiler":false,"text":"The oldest of the Hibikino sisters, she's the eroge-loving obsessive who had their family home renovated into an eroge shop."},{"spoiler":false,"text":"In contrast to her young appearance, she spews out dirty jokes like you wouldn't imagine."},{"spoiler":false,"text":"She loves talking about the eroge she likes, and channeled that passion into making an eroge shop. But she left all of the annoying stuff to Tsumugi."},{"spoiler":false,"text":"Despite being on a gap year after having failed to get into university, she doesn't seem to have any intention of studying."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c91969"}],"profileFacts":[],"metadataCandidateConflicts":{