er":false,"text":"料理は壊滅的。本当は英語の方が得意。日本史を教えることに思い入れがある。"},{"spoiler":false,"text":"【ツン状態】：主人公を下着ドロだと固く信じている。"},{"spoiler":false,"text":"「見つけたわよ、変質者」"},{"spoiler":false,"text":"【デレ状態】：下着ドロを捕まえたところからデレに。"},{"spoiler":false,"text":"「べ、別に恥ずかしがってなんかいないわよ……"},{"spoiler":false,"text":"生徒とお風呂に入るなんて、どうってこと無いんだから！」"}],"source":"egs","sourceCharacterId":"14918","sourceWorkId":"12792","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の担任教師で日本史を担当。"},{"spoiler":false,"text":"主人公のことを下着ドロと思い込んで四六時中、疑いの眼差しを向ける。"},{"spoiler":false,"text":"子供っぽく、自分が不利な状況に陥ると泣き出してしまう。料理は壊滅的。"},{"spoiler":false,"text":"本当は英語の方が得意なのだが、日本史を教えることに思い入れがある。"}],"source":"bangumi","sourceCharacterId":"45383"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/6928259866175a96cecd46586ae97ff0fd918fb1b22d015929775f0007432cbd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/069ebeaf3d47450597c1599e019ea90b40ce3fae22baa3867ab87b329633633b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽月理恵","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:163338:45383:5907:1","source":"bangumi"}]},{"characterId":"char_c7512","characterName":"楠城 歩美","sourceIds":{"bangumi":[{"characterId":"45384","match":"exact-normalized-name-in-linked-work","subjectId":"163338"}],"egsCharacterIds":["14919"],"vndbCharacterId":"c7512"},"originalCharacterName":"楠城 歩美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"職業：教師、担当：生物。"},{"spoiler":false,"text":"主人公に対して新しいおもちゃ＆召使いぐらいの感覚で接して来る。"},{"spoiler":false,"text":"暗い過去がある。お酒に飲まれる傾向有り。"},{"spoiler":false,"text":"科学者として非常に優秀。"},{"spoiler":false,"text":"【ツン状態】：使いっ走りの実験台。"},{"spoiler":false,"text":"「なによぉ～うるさいわね……今日は自習なの！　わかった？」"},{"spoiler":false,"text":"【デレ状態】：デレ化すると純情＆ドジッ娘に変身する。"},{"spoiler":false,"text":"「……初めてエッチするくせに"},{"spoiler":false,"text":"あたしをこんなに感じさせるなんて……生意気だぞ」"}],"source":"egs","sourceCharacterId":"14919","sourceWorkId":"12792","spoiler":false},{"segments":[{"spoiler":false,"text":"生物を担当する教師。"},{"spoiler":false,"text":"お祭り大好きで男っぽく大雑把。面白ければ万事OKな性格。"},{"spoiler":false,"text":"主人公の事を新しいおもちゃ＆召使いぐらいの感覚で扱う。"},{"spoiler":false,"text":"科学者としても優秀なのだが、実は暗い過去を持っているらしい。"}],"source":"bangumi","sourceCharacterId":"45384"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8323812a7f2d0421aeef03363463f16b9eb9f0d4cfca9834bd10d87bdc81c968.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9e6efea7307cca71bfa11de85ff3f6b981fc0ab3a13bd7f04bec5707bb65855.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"舘 あい","creatorId":"vndb:s9108","sourcePersonId":"vndb:s9108","canonicalEntityId":"vndb:s9108","name":"舘 あい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:16585","source":"vndb"}]},{"characterId":"char_c7513","characterName":"双木 絵真","sourceIds":{"bangumi":[{"characterId":"45385","match":"exact-normalized-name-in-linked-work","subjectId":"163338"}],"egsCharacterIds":["14920"],"vndbCharacterId":"c7513"},"originalCharacterName":"双木 絵真","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"職業：教師、担当：美術。"},{"spoiler":false,"text":"主人公は下僕として気に入っている。"},{"spoiler":false,"text":"その他：芸術に屈折したところあり。理事長の娘。"},{"spoiler":false,"text":"親からは校長になることを