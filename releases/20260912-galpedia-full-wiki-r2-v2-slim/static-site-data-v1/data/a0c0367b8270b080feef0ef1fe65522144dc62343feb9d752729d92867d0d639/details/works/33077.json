.date/terminal-wiki/v1/characters/v1/images/94/9462cc3a43987d691ba33a2275fb5214021a14acf846a5472472e9663841fda4.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c103279","characterName":"ハク・エカルラン","sourceIds":{"vndbCharacterId":"c103279"},"originalCharacterName":"ハク・エカルラン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1001"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"177"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The mystical bishop of the Cleanup Department. Her airheaded and relaxed personality, coupled with her slow manner of speaking and walking, tends to confuse others."},{"spoiler":false,"text":"Her behavior seems to change at night however, being more bright and blunt than usual."}],"source":"vndb","sourceCharacterId":"c103279"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/255c8cde2cb52bcd5d1a28dfc270783c62d4e271b29b81e9d5e7820f3cd1442e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26382f7b2a7fc17a301656fd4ebb2e143c3b48402a87c392f4bba32dc17c937c.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c103280","characterName":"グレーテ","sourceIds":{"vndbCharacterId":"c103280"},"originalCharacterName":"グレーテ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"505"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb"