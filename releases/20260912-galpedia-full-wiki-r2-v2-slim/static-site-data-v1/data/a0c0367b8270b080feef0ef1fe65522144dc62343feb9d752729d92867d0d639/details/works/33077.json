p","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30c6d3d8c36abba0dcb3f6fda8c2f223f779afd7e641fa85b8cb0c429d58ffb0.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c103283","characterName":"シーキュレット・レイフ","sourceIds":{"vndbCharacterId":"c103283"},"originalCharacterName":"シーキュレット・レイフ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"115"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"154"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A senior member of the Cleanup Department, who acts as Belial's and Maya's mentor, and additionally the temporary auxiliary bishop of the Cleanup Department."},{"spoiler":false,"text":"He's completely devoted to his job, but his attitude with other people is absolutely terrible."},{"spoiler":true,"text":"Birth name is Trudy Rafe."}],"source":"vndb","sourceCharacterId":"c103283"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f4648c0de5d92da0e708ddae0e63c6557a512e0eab62128735e259a2473e97b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/fff82c98564edb928ce80f906936cb71c7a843223b2b1bceb44ca5f60786c261.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c103284","characterName":"金髪の女性","sourceIds":{"vndbCharacterId":"c103284"},"originalCharacterName":"金髪の女性","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState"