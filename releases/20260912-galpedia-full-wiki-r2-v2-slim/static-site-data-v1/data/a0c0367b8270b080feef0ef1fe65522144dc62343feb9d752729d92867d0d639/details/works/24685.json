{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"24685","model":{"presentationWorkId":"vndb:v12050","staff":{"artwork":[{"creditedName":"四辻 躑躅","creatorId":"vndb:s21766","sourcePersonId":"vndb:s21766","canonicalEntityId":"vndb:s21766","name":"四辻 躑躅","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:96665","source":"vndb"}],"scenario":[{"creditedName":"四辻 十字","creatorId":"vndb:s21766","sourcePersonId":"vndb:s21766","canonicalEntityId":"vndb:s21766","name":"四辻 躑躅","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:96667","source":"vndb"},{"creditedName":"コトノハ","creatorId":"vndb:s23832","sourcePersonId":"vndb:s23832","canonicalEntityId":"vndb:s23832","name":"コトノハ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:96668","source":"vndb"}],"music":[{"creditedName":"oku","creatorId":"vndb:s2547","sourcePersonId":"vndb:s2547","canonicalEntityId":"vndb:s2547","name":"奥田 友幸","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:96663","source":"vndb"},{"creditedName":"H/MIX GALLERY","creatorId":"vndb:s18787","sourcePersonId":"vndb:s18787","canonicalEntityId":"vndb:s18787","name":"秋山 裕和","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:96664","source":"vndb"},{"creditedName":"JewelBeat","creatorId":"vndb:s23833","sourcePersonId":"vndb:s23833","canonicalEntityId":"vndb:s23833","name":"JewelBeat","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:96669","source":"vndb"}],"other":[{"creditedName":"真優","creatorId":"vndb:s1024","sourcePersonId":"vndb:s1024","canonicalEntityId":"vndb:s1024","name":"桂木 真優","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:96662","source":"vndb"},{"creditedName":"四辻 躑躅","creatorId":"vndb:s21766","sourcePersonId":"vndb:s21766","canonicalEntityId":"vndb:s21766","name":"四辻 躑躅","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:96666","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c60168","characterName":"一舎","sourceIds":{"vndbCharacterId":"c60168"},"originalCharacterName":"一舎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affiliation: The Round Table"},{"spoiler":false,"text":"Bug: Caterpillar"},{"spoiler":false,"text":"Ability: Adaptation - Metamorphosis. Creates a cocoon that automatically adapts the users' body in response to the needs posed by the outer environment, allowing her body to \"learn\" from threats and come up with a counter. However, this adaptation process takes a relatively long time."},{"spoiler":false,"text":"Due to both her very young age and the nature of her bug, she's the most childlike of the participants and isn't really capable of controlling her own powers, nor does she necessarily understand their repercussions."}],"source":"vndb","sourceCharacterId":"c60168"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64f3d861fac52c253ae87eddee3fbfc39bb71fbd62759032fa941e58768223dd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/507517b7e043afd0aa70c22ce0f0974b5ecf7c064ba3a8c9abbaa3577172556c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本村 伸子","creatorId":"vndb:s23836","sourcePersonId":"vndb:s23836","canonicalEntityId":"vndb:s23836","name":"本村 伸子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51414","source":"vndb"}]},{"characterId":"char_vndb_c60169","characterName":"二條久保","sourceIds":{"vndbCharacterId":"c60169"},"originalCharacterName":"二條久保","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affiliation: The Corporation"},{"spoiler":false,"text":"Bug: Dragonfly"},{"spoiler":false,"text":"Ability: Evacuation - Multi-Monitor. The weakest bug in Company history. Deploys a floating, movable tattoo-like symbol that acts as additional eyes, ears and nose for the user. While the Dragonfly itself is immune against all forms of physical interaction, it has zero fighting capabilities as well, forcing Nijoukubo to stay clear away from battles and rely on others to fight on her stead."},{"spoiler":false,"text":"The protagonist of the story, Nijoukubo accompanies her best friend Sanbara on the latter's research trip on bug mythology. Inexperienced and unfamiliar with the supernatural or the workings of the twisted game she finds herself in, she mostly follows more experienced Sanbara's lead and acts in a supporting role."}],"source":"vndb","sourceCharacterId":"c60169"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73ffb3e7930be718e4d81f2714edc218a539551499b3c671492b0abd9ac16754.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/150822dfd4f1265baa409e7b032176bd2d5cca1f17852d9ef0ab586ec1fef517.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹内 奈菜","creatorId":"vndb:s23834","sourcePersonId":"vndb:s23834","canonicalEntityId":"vndb:s23834","name":"竹内 奈菜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51412","source":"vndb"}]},{"characterId":"char_vndb_c60171","characterName":"三荊","sourceIds":{"vndbCharacterId":"c60171"},"originalCharacterName":"三荊","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affiliation: The Corporation"},{"spoiler":false,"text":"Bug: Stag Beetle"},{"spoiler":false,"text":"Ability: Evolution - Egoist. The strongest bug in Company history. Sanbara's ability allows her to transform her own body willingly and on the fly as the situation demands, providing overwhelming fighting prowess and adaptability."},{"spoiler":false,"text":"Nijoukubo's best friend and the one who also dragged her to Osakabe village in pursuit of bug mythology. Sanbara's prideful nature, intelligence and confidence has easily made her the popular \"queen\" of schools she's been to, however she treats Nijoukubo as her equal."}],"source":"vndb","sourceCharacterId":"c60171"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3bc3a647090dcd6fec008a203b516a38c6cb0b4e2fddecad301d80df4c21eb31.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9fcca7e6fb9280830b417a33227cf73d0112896ba56c44e3aa3c0d418b008d1.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"上川畑 亜美","creatorId":"vndb:s23835","sourcePersonId":"vndb:s23835","canonicalEntityId":"vndb:s23835","name":"上川畑 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51413","source":"vndb"}]},{"characterId":"char_vndb_c60175","characterName":"四月一日","sourceIds":{"vndbCharacterId":"c60175"},"originalCharacterName":"四月一日","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affiliation: The Association"},{"spoiler":false,"text":"Bug: Earthworm"},{"spoiler":false,"text":"Ability: Revival - Reset. Resurrection ability that automatically triggers on the user's death, returning her body and mind to a previous point in time."},{"spoiler":false,"text":"A silent and withdrawn girl, Watanuki mostly follows Rokusaidou's lead and holds unwavering loyalty towards her. Much like Rokusaidou, Watanuki shares a similar interest towards bugs and their research."}],"source":"vndb","sourceCharacterId":"c60175"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8ce1dc2d1351ed4a9f541768605f8d881829b3bfabf886c8582000de13952b48.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a588edfcdd5f69a98922487381ffbb4ef527e0a9e5841851074a96b2ab494dde.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮川 とみえ","creatorId":"vndb:s23839","sourcePersonId":"vndb:s23839","canonicalEntityId":"vndb:s23839","name":"宮川 とみえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51421","source":"vndb"}]},{"characterId":"char_vndb_c60178","characterName":"五百雀","sourceIds":{"vndbCharacterId":"c60178"},"originalCharacterName":"五百雀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affiliation: The Round Table"},{"spoiler":false,"text":"Bug: Praying Mantis"},{"spoiler":false,"text":"Ability: Elimination - Conquesta. Iojaku is capable of producing an extremely sharp \"line\" which she then shapes into contours of different cutting weapons capable of shredding through most defenses."},{"spoiler":false,"text":"A high schooler and the most hotblooded member of her group with a strong sense of duty, she tries her best to bring victory to Round Table, sometimes to a rather reckless degree. However, she also harbors deep respect for Nanahara and prioritizes her guidance and instructions, including the non-aggression pact with the Corporation."}],"source":"vndb","sourceCharacterId":"c60178"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a866686bed1fea00a6bfe010a5b835c1ac97157cf5644019228a6db7967eca58.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a669111ec7b91155372c9bc84f67751e7e2970a911191e551a2a8fe898f2beee.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"古俣 有紀枝","creatorId":"vndb:s23837","sourcePersonId":"vndb:s23837","canonicalEntityId":"vndb:s23837","name":"古俣 有紀枝","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51416","source":"vndb"}]},{"characterId":"char_vndb_c60180","characterName":"六斉堂","sourceIds":{"vndbCharacterId":"c60180"},"originalCharacterName":"六斉堂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affiliation: The Association"},{"spoiler":false,"text":"Bug: Chironomid"},{"spoiler":false,"text":"Ability: Group Growth - Mass Game. While looking like human, Rokusaidou's entire body is made of minuscule flies acting in unison and constantly reproducing, serving various uses and allowing her an extremely wide variety of fighting strategies and very high survivability that rivals Sanbara's."},{"spoiler":false,"text":"Nihilistic leading member of the Association and a bug researcher, Rokusaidou goes to great lengths in assuring victory for her group and doesn't shy away from playing dirty or using ruthless strategies to achieve her goals."}],"source":"vndb","sourceCharacterId":"c60180"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52aa419748ad4df9bc55824b500d54c00bc33f2877dfd0547992e105278489d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f93359bb5a176ed30a8ba580664298e89c6d67c3661090515108c350fc8f72f3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"片山 加奈","creatorId":"vndb:s23840","sourcePersonId":"vndb:s23840","canonicalEntityId":"vndb:s23840","name":"片山 加奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51423","source":"vndb"}]},{"characterId":"char_vndb_c60181","characterName":"七々原","sourceIds":{"vndbCharacterId":"c60181"},"originalCharacterName":"七々原","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affiliation: The Round Table"},{"spoiler":false,"text":"Bug: Rhinoceros Beetle"},{"spoiler":false,"text":"Ability: Rejection - My World. Nanahara wields an exoskeleton capable of projecting numerous, nigh impenetrable shields around herself and others that can also function as offensive tools due to their hardness. A bug excelling in both offense and defense."},{"spoiler":false,"text":"Befitting of her bug, Nanahara has a gentle personality and is very protective of those around her and considers herself the guardian of the group's two younger members. She's also a long-time friend with Sanbara and prefers a non-aggression pact with all Corporation members, instructing both Iojaku and Hitotsuya to stay their hand as well."}],"source":"vndb","sourceCharacterId":"c60181"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc45c4a3313e9ba6fba971234fb8ee3d7b5e4f3a3d7c95e300d24416e52f083c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/9642f429edb328d58e1614e93e608c833e9b8458fc19009572b560b1090b176f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"古橋 佳那","creatorId":"vndb:s23838","sourcePersonId":"vndb:s23838","canonicalEntityId":"vndb:s23838","name":"古橋 佳那","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51419","source":"vndb"}]},{"characterId":"char_vndb_c60185","characterName":"八木沢","sourceIds":{"vndbCharacterId":"c60185"},"originalCharacterName":"八木沢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affiliation: The Association"},{"spoiler":false,"text":"Bug: Centipede"},{"spoiler":false,"text":"Ability: Parasitism - Living Behind. A dangerous bug that gives its host great powers at the cost of destroying their body and mind."},{"spoiler":false,"text":"Newest and youngest member of the Association trio who likewise shares the other two's interest in bug history and research. The terrifying price of her Centipede and the difficulties in controlling it forces Yagisawa to be hospitalized most of the time, with Watanuki being her primary caretaker. She has also developed a friendship with Hitotsuya, and the usually introvert latter views Yagisawa with affection."}],"source":"vndb","sourceCharacterId":"c60185"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc2fd104d2804ef33ecb9645673069f92417fd0f6f1e30885b8e9c4c332bcfd8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cd191adc6fc900bbea70baf2b4b9a9802abf58b3dfa9a5a5f7f7323dc370e6f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"外村 茉莉子","creatorId":"vndb:s23841","sourcePersonId":"vndb:s23841","canonicalEntityId":"vndb:s23841","name":"外村 茉莉子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51425","source":"vndb"}]},{"characterId":"char_vndb_c60186","characterName":"九","sourceIds":{"vndbCharacterId":"c60186"},"originalCharacterName":"九","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affiliation: The Corporation"},{"spoiler":false,"text":"Bug: Spider"},{"spoiler":false,"text":"Ability: Retainers - Cluster. Ichijiku excels at puppeteering different lifeforms, humans and animals alike through the use of her web while also making use of their senses, making the villagers and small animals an effective network of spies and cannon fodder. However, the ability's limiting factor is being unable to put opponents stronger than herself under the influence. As secondary abilities of her web Ichijiku also camouflages herself and is able to direct long-range voice communications between other members of her group."},{"spoiler":false,"text":"The second support-oriented member of the Corporation along with Nijoukubo, Ichijiku has known Sanbara for a long time and considers it an honor to serve her. Due to awakening to her Spider in a very young age, Ichijiku learned to use her web to get around instead of regular human functions like walking or talking, meaning she prefers to hang from the ceiling and uses her web to imitate talking."}],"source":"vndb","sourceCharacterId":"c60186"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9dbb61c5b917053facb7d5b941c151c92a331559f48c24d5b06fccc7e47c690.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/6211aaa9f137aa4db705558fcbdcdebdf4f117ec2ac1080f1ebdd39916854590.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本村 伸子","creatorId":"vndb:s23836","sourcePersonId":"vndb:s23836","canonicalEntityId":"vndb:s23836","name":"本村 伸子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51415","source":"vndb"}]},{"characterId":"char_vndb_c60187","characterName":"八月一日","sourceIds":{"vndbCharacterId":"c60187"},"originalCharacterName":"八月一日","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Affiliation: The Three Worms"},{"spoiler":false,"text":"Bug: Tick"},{"spoiler":false,"text":"Ability: Sharing - Cloud. A bug focused on information processing with zero fighting capability."},{"spoiler":true,"text":"Capable of simultaneously sharing different senses, memories and experiences, including one's own between multiple people."},{"spoiler":false,"text":"Leading member of the Three Worms (三尸), neutral supervisors of the death game taking place who keep record of all battles and notable events. Poses a rather serious attitude and holds rules above all else."}],"source":"vndb","sourceCharacterId":"c60187"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2cfedae4577d0f5e74db7474f86ad5fe689818e05fe04ea6b1a9459b0d96dc9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/3720e4d1e168d818694976ce4681b9fcc3663f129c6587c16e83fb137c64a2c2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡本 悠希","creatorId":"vndb:s23843","sourcePersonId":"vndb:s23843","canonicalEntityId":"vndb:s23843","name":"岡本 悠希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51429","source":"vndb"}]},{"characterId":"char_vndb_c60188","characterName":"九十九　姉","sourceIds":{"vndbCharacterId":"c60188"},"originalCharacterName":"九十九　姉","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Affiliation: The Round Table"},{"spoiler":true,"text":"Bug: Fly"},{"spoiler":true,"text":"Ability: Optimization - Defrag. Gives the user the ability to always make the right decision regardless of the situation."},{"spoiler":true,"text":"A woman with a strong sense of justice. With the Fly's power giving her a natural disposition towards good decision making, she founded the Corporation subsidiary Round Table in an attempt to create a new organization with more humane approach to bug research and their users. She's a friend of Rikudou and like Nanahara, instructs her own members to hold a non-aggression pact with Corporation members."},{"spoiler":true,"text":"Her developed true ability of Defrag is shaping the world according to the user's wishes by ignoring the laws of causality, with the price of such action being the user's own unavoidable and instantaneous death."}],"source":"vndb","sourceCharacterId":"c60188"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d9a9107ff9e4f41c1cc93a67162659ce156b32f5614bd4d88644e3d35d289199.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/eec9cdf0207f1b2d5c3c6a5b7f3bbc5b2fa48d07069a17a6b5a5a08d1f86dce6.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瀬戸 奈保子","creatorId":"vndb:s15740","sourcePersonId":"vndb:s15740","canonicalEntityId":"vndb:s15740","name":"瀬戸 奈保子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51409","source":"vndb"}]},{"characterId":"char_vndb_c60189","characterName":"九十九　妹","sourceIds":{"vndbCharacterId":"c60189"},"originalCharacterName":"九十九　妹","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Affiliation: The Round Table"},{"spoiler":true,"text":"Bug: King Fly"},{"spoiler":true,"text":"Ability: Duplication - Mirror House. An ability dealing with all forms of duplication, ranging from forcefully creating a space as a form of teleportation, creating copies of herself and perfectly duplicating other bug users' powers."},{"spoiler":true,"text":"Younger of the Tsukumo sisters and also a participant in the previous death game. She holds deep respect and love for her elder sister, and after the latter's death attempts to realize the ideal world free of suffering of bug users in her own twisted way, manipulating and using all the current participants to further that end. She's also capable of using her sister's Defrag without restraint by sacrificing one of her own clones."}],"source":"vndb","sourceCharacterId":"c60189"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76eb83d29154af6d6c3ab95edc5aff2ea94f11867f0fd8ecfb051e4999a23bd8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4afa7b2244edd2d3081316b5d35b97595547a56d92d03f8d464c703aa52fdb7f.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成田 佳恵","creatorId":"vndb:s23842","sourcePersonId":"vndb:s23842","canonicalEntityId":"vndb:s23842","name":"成田 佳恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:51427","source":"vndb"}]},{"characterId":"char_vndb_c60190","characterName":"六道","sourceIds":{"vndbCharacterId":"c60190"},"originalCharacterName":"六道","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Affiliation: The Corporation"},{"spoiler":true,"text":"Bug: Snail"},{"spoiler":true,"text":"Ability: Extremity - Little Maria. A power holding properties of a little sun that excels in the manipulation of light."},{"spoiler":true,"text":"Like her ability, a cheerful person radiating happiness and childlike curiosity wherever she goes. Participant in the previous death game and like an elder sister to still young Hozumi and Nanahara. She's good friends with the elder of the Tsukumo sisters and even manages to make the otherwise serious and pragmatic Rokusaidou warm up to her."},{"spoiler":true,"text":"Fighting Tsumabira causes her ability to accidentally evolves to next stage, turning her into a living sun that risks destroying the Earth, forcing the elder Tsukumo sister to use her Defrag."}],"source":"vndb","sourceCharacterId":"c60190"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b307f687b291c2547142a4f5a150c142ccc64df1b4e767f6a5e97c9c1099e8ff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d6d1ddba1f78a0975929eb124c9c2e77756860b5dec994ce377716fd676e002.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大塚 みなみ","creatorId":"vndb:s23844","sourcePersonId":"vndb:s