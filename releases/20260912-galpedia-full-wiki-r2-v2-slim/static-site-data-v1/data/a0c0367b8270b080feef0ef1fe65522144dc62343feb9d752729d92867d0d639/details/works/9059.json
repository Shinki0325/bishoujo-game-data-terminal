ource":"egs"},{"creditedName":"佐久間 零式改","creatorId":"vndb:s7506","sourcePersonId":"vndb:s7506","canonicalEntityId":"vndb:s7506","name":"佐久間 零式改","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:66703","source":"vndb"},{"creditedName":"佐久間 零式改","creatorId":"vndb:s7506","sourcePersonId":"vndb:s7506","canonicalEntityId":"vndb:s7506","name":"佐久間 零式改","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:66704","source":"vndb"}]},"cast":[{"characterId":"char_c76577","characterName":"白鳥 千鶴","sourceIds":{"bangumi":[{"characterId":"199598","match":"exact-normalized-name-in-linked-work","subjectId":"224157"}],"egsCharacterIds":["21060"],"vndbCharacterId":"c76577"},"originalCharacterName":"白鳥 千鶴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"37"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"97"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The proprietress of the ryokan “Shizu” who runs the ryokan all by herself since her husband passed away. She looks so young that she is mistaken for a woman in her late twenties."},{"spoiler":false,"text":"She has been so busy that she has not been able to meet anyone and has missed the opportunity to remarry, so she has been spending her days without a man in her life."},{"spoiler":false,"text":"She has a calm personality, just like the proprietress of an inn. Her husband died a few months ago, and she often looks lonely."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c76577"},{"segments":[{"spoiler":false,"text":"亡き夫の残した温泉旅館「静」を娘・美雪と二人できりもりする女将。"},{"spoiler":false,"text":"性格はおっとりしており、40代に手が届く年齢ながら、まだまだ20代でも通るほど若々しい。"},{"spoiler":false,"text":"夫を亡くしてからまだ間も無く、まだまだ女としての肉体的な峠は越えていないことから、その熟れた豊満な肉体を持て余し、欲求不満気味。"}],"source":"egs","sourceCharacterId":"21060","sourceWorkId":"9059","spoiler":false},{"segments":[{"spoiler":false,"text":"37歳"},{"spoiler":false,"text":"夫に先立たれたため、旅館を一人で切り盛りしている旅館『静』の女将。"},{"spoiler":false,"text":"ニ十代後半に間違われるほど、見た目は結構若い。"},{"spoiler":false,"text":"忙しさから出会いがなく再婚する機会を逃しているため、男日照りの日々が続いている。"},{"spoiler":false,"text":"旅館の女将らしくおっとりした性格をしている。"},{"spoiler":false,"text":"夫を数ヶ月前に亡くしている事もあり、寂しそうな表情をする事もしばしば見受けられる。"}],"source":"bangumi","sourceCharacterId":"199598"}],"profileFacts":[{"label":"年龄（本版本）","value":"37 岁","valueContext":null,"source":"egs","sourceCharacterId":"21060","sourceWorkId":"9059","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"97 cm","valueContext":null,"source":"egs","sourceCharacterId":"21060","sourceWorkId":"9059","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"21060","sourceWorkId":"9059","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"21060","sourceWorkId":"9059","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"21060","sourceWorkId":"9059","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aea9ca2bc63bdec4cd4a0758bff79b49d269193353edfe8d516311d661bac4a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c47ad1880859743a33fa66db27868e5ebc37a864d81085b5bde84c51851d380.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MOMOKA","creatorId":"vndb:s11384","sourcePersonId":"vndb:s11384","canonicalEntityId":"vndb:s11384","name":"MOMOKA","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:37362","source":"vndb"}]},{"characterId":"char_c76578","characterName":"白鳥 美雪","sourceIds":{"bangumi":[{"characterId":"199599","match":"exact-normalized-name-in-linked-work","subjectId":"224157"}],"egsCharacterIds":["21061"],"vndbCharacterId":"c76578"},"originalCharacterName":"白鳥 美雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"19"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the only daughter of Chizuru and works as a cook at a ryokan. She follows in the footsteps of her father, who was a devoted cook, and works in the kitchen."},{"spoiler":false,"text":"She is a firm woman and often assists the calm Chizuru. She tries her best to support her mother, who is becoming unstable after the loss of her husband."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c76578"},{"segments":[{"spoiler":false,"text":"千鶴の一人娘。"},{"spoiler":false,"text":"料理人だった父親の跡を継いで、温泉旅館「静」の料理人を務めている。"},{"spoiler":false,"text":"気丈で母親思いの彼女は、夫を亡くし精神的に不安定な母親を一生懸命に支えようと頑張っている。"}],"source":"egs","sourceCharacterId":"21061","sourceWorkId":"9059","spoiler":false},{"segments":[{"spoiler":false,"text":"19歳"},{"spoiler":false,"text":"千鶴の一人娘で旅館の料理人を務める。"},{"spoiler":false,"text":"母親思いで料理人であった父親の跡を継ぎ、厨房に入っている。"},{"spoiler":false,"text":"しっかりもので、おっとりとしている千鶴の補佐をする事もしばしば。"},{"spoiler":false,"text":"夫をなくして不安定になり始めている母親を一生懸命に支えてやろうとしている。"}],"source":"bangumi","sourceCharacterId":"199599"}],"profileFacts":[{"label":"年龄（本版本）","value":"19 岁","valueContext":null,"source":"egs","sourceCharacterId":"21061","sourceWorkId":"9059","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"21061","sourceWorkId":"9059","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"21061","sourceWorkId":"9059","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"21061","sourceWorkId":"9059","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"21061","sourceWorkId":"9059","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/969eb599f416ef81239011359e7660b356312d3b2b54a9f4028bdcc97916e7fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffd4630549f2aafe272b406115075e01af60ba33f66f8c60cb4ab1d96c8130c5.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224157:199599:5890:1","source":"bangumi"}]},{"characterId":"char_vndb_c149351","characterName":"武蔵 龍魔","sourceIds":{"vndbCharacterId":"c149351"},"originalCharacterName":"武蔵 龍魔","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man who makes his living as a “corruptor.\" He uses drugs and forceful means to induce