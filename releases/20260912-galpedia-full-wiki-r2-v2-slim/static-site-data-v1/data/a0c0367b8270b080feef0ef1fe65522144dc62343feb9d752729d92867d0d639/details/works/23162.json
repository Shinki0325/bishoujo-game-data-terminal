"source":"vndb"},{"creditedName":"難波 一一","creatorId":"vndb:s12645","sourcePersonId":"vndb:s12645","canonicalEntityId":"vndb:s12645","name":"難波 一一","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:128351","source":"vndb"}]},"cast":[{"characterId":"char_c43065","characterName":"久保田 彩陽","sourceIds":{"bangumi":[{"characterId":"52772","match":"exact-normalized-name-in-linked-work","subjectId":"211834"}],"egsCharacterIds":["17933"],"vndbCharacterId":"c43065"},"originalCharacterName":"久保田 彩陽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is beautiful and has excellent grades. She is a talented girl who is well-known at school. Although she is out of reach, she has a bright and friendly personality and many friends. She became the student council president so that everyone at school could have a good time."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c43065"},{"segments":[{"spoiler":false,"text":"容姿端麗で成績優秀。"},{"spoiler":false,"text":"学校でも有名な才女。"},{"spoiler":false,"text":"高嶺の花だが明るく人なつっこい性格で友人も多い。"},{"spoiler":false,"text":"学園のみんなが楽しく過ごせるようにと、学生会会長になった。"}],"source":"egs","sourceCharacterId":"17933","sourceWorkId":"23162","spoiler":false},{"segments":[{"spoiler":false,"text":"容姿端麗で成績優秀な学生会の会長。 学園でも有名な才女で、高嶺の花。"},{"spoiler":false,"text":"ルールにうるさく、自己に厳しい分 周りにも厳しい。"},{"spoiler":false,"text":"主人公の “いい加減さ” が目に付き、何かと強めに当たってくる。"},{"spoiler":false,"text":"しかしそれは、入学試験の頃から主人公のことを少し意識しているから。"}],"source":"bangumi","sourceCharacterId":"52772"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb3c97715f55617532b584ef43d28836f23e8c4c522e8a775206204ad3c889d9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/553376ea1f23f0669aff99c48972a177de7a0aaf10dd51b63deb78183542c614.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘志穂","creatorId":"vndb:s738","sourcePersonId":"vndb:s738","canonicalEntityId":"vndb:s738","name":"橘 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:211834:52772:7169:1","source":"bangumi"}]},{"characterId":"char_c43066","characterName":"在澤 文佳","sourceIds":{"bangumi":[{"characterId":"52773","match":"exact-normalized-name-in-linked-work","subjectId":"211834"}],"egsCharacterIds":["17934"],"vndbCharacterId":"c43066"},"originalCharacterName":"在澤 文佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Disciplinary Committee Chair. G Her grades and appearance are on par with Asahi, and she has a polite demeanour and a gentle personality. She hates wrong and crooked things and corrects any irregularities in the school, but she fundamentally believes that people should act at their own risk. She has a close relationship with Asahi and a few trusted friends rather than a large number of friends."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c43066"},{"segments":[{"spoiler":false,"text":"風紀委員会。"},{"spoiler":false,"text":"彩陽と並ぶ成績と容姿を持ち、丁寧な物腰で人当たりも柔らかい。間違ったことや曲がったことが嫌いで、学園内の風紀の乱れを正しているが、基本的に自己責任で行動すべきだと考えている。"},{"spoiler":false,"text":"多数の友人よりも、少数の信頼できる友人と深く付き合っている。"}],"source":"egs","sourceCharacterId":"17934","sourceWorkId":"23162","spoiler":false},{"segments":[{"spoiler":false,"text":"風紀委員会の会長で、親友である彩陽に憧れている。"},{"spoiler":false,"text":"間違ったこと・曲がったことが大嫌いで、彩陽以上にルールに厳しい。"},{"spoiler":false,"text":"少しワガママなところがあり、あまり自分には厳しくない。"},{"spoiler":false,"text":"男嫌いで、彩陽に恋愛感情に近い憧れを抱いている。"}],"source":"bangumi","sourceCharacterId":"52773"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/6600cf0d38cc5be709f9ccdb78ebafb31891b1e613a8161821635b14cc513f09.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d231a69c1d8f8dd0ba6252ae96dd07d1314801cdeb04249628a44754f1d2d056.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平山ゆかり","creatorId":"vndb:s285","sourcePersonId":"vndb:s285","canonicalEntityId":"vndb:s285","name":"東かりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:211834:52773:5905:1","source":"bangumi"}]},{"characterId":"char_vndb_c50311","characterName":"栖本 輝","sourceIds":{"vndbCharacterId":"c50311"},"originalCharacterName":"栖本 輝","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p4883","sourceCompanyId":"egs:brand:4474","canonicalEntityId":"vndb:p4883","name":"include","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:23162:4474","source":"egs"},{"companyId":"vndb:p4883","sourceCompanyId":"vndb:p4883","canonicalEntityId":"vndb:p4883","name":"include","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:51428:v18909","source":"vndb"},{"companyId":"vndb:p4883","sourceCompanyId":"vndb:p4883","canonicalEntityId":"vndb:p4883","name":"include","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:54726:v18909","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
