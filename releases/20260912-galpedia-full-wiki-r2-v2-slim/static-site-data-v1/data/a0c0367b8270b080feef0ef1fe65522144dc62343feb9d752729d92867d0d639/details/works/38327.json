name":"月乃","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:215334","source":"vndb"},{"creditedName":"金子 わゆ","creatorId":"vndb:s26962","sourcePersonId":"vndb:s26962","canonicalEntityId":"vndb:s26962","name":"金子わゆ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:215335","source":"vndb"},{"creditedName":"八花","creatorId":"vndb:s28900","sourcePersonId":"vndb:s28900","canonicalEntityId":"vndb:s28900","name":"八花","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:215336","source":"vndb"},{"creditedName":"ARA","creatorId":"vndb:s31092","sourcePersonId":"vndb:s31092","canonicalEntityId":"vndb:s31092","name":"ARA","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:215337","source":"vndb"},{"creditedName":"じぐまる","creatorId":"vndb:s31108","sourcePersonId":"vndb:s31108","canonicalEntityId":"vndb:s31108","name":"じぐまる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:215338","source":"vndb"},{"creditedName":"桐下 暁","creatorId":"vndb:s31572","sourcePersonId":"vndb:s31572","canonicalEntityId":"vndb:s31572","name":"Sous le Paulownia","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:215339","source":"vndb"}]},"cast":[{"characterId":"char_c151483","characterName":"二条 初音","sourceIds":{"bangumi":[{"characterId":"174298","match":"exact-normalized-name-in-linked-work","subjectId":"553292"}],"egsCharacterIds":["27822"],"vndbCharacterId":"c151483"},"originalCharacterName":"二条 初音","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"428"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Gyaru Lover Crossdressing Protagonist"},{"spoiler":false,"text":"Since childhood, he has been fascinated by gyaru—not just in a physical sense, but ideologically as well. As a result, he developed a strong fondness for gyaru girls. However, because there were no gyaru-type girls around him, he found himself starved of what he loved."},{"spoiler":false,"text":"After much deliberation, he ended up taking up the unusual hobby of dressing as a gyaru himself to fill that void. He doesn’t see this hobby as something to be ashamed of. That said, he’s also aware that he's fundamentally a guy and knows he can't keep crossdressing as a gyaru forever."},{"spoiler":false,"text":"With that in mind, he takes selfies dressed in his ideal gyaru form and post them in a secret gyaru-themed crossdressing account on social media. However, he avoids showing his face, only posting photos from the neck down to prevent being recognized."},{"spoiler":false,"text":"Although he dresses as a gyaru, he's still a guy on the inside—his behavior and sexual orientation are completely normal."},{"spoiler":false,"text":"•His birthday it's the same day as the \"Gyaru's day\""},{"spoiler":false,"text":"•He is good at: Housework."},{"spoiler":false,"text":"•He is bad at: Making plans."}],"source":"vndb","sourceCharacterId":"c151483"},{"segments":[{"spoiler":false,"text":"幼い頃に、ギャルというものに対して思想的と肉体的と両方の意味で興味を持つ。その結果、ギャルというものが好きになるが、周囲にギャル系女子がいなくて供給が枯渇。"},{"spoiler":false,"text":"悩んだ末に、自身がギャル女装することで供給を満たすという謎趣味に手を染めることになる。その趣味を、恥ずかしいものとは思っていない。しかしその一方で、自分はあくまで男でありいつまでもギャル女装をしていられないとも思っている。"},{"spoiler":false,"text":"そんな考えもあって、自分の最高のギャル像を残しておくために、SNSの自身のギャル系女装アカウントに自撮り写真を上げている。ただし自分の顔は映さず、顔から下の写真を上げている。（身バレ防止）ギャル女装をしているが、中身は男であり言動や性的指向も至ってノーマルである。"}],"source":"egs","sourceCharacterId":"27822","sourceWorkId":"38327","spoiler":false},{"segments":[{"spoiler":false,"text":"幼い頃に、ギャルというものに対して思想的と肉体的と両方の意味で興味を持つ。その結果、ギャルというものが好きになるが、周囲にギャル系女子がいなくて供給が枯渇。"},{"spoiler":false,"text":"悩んだ末に、自身がギャル女装することで供給を満たすという謎趣味に手を染めることになる。その趣味を、恥ずかしいものとは思っていない。しかしその一方で、自分はあくまで男でありいつまでもギャル女装をしていられないとも思っている。"},{"spoiler":false,"text":"そんな考えもあって、自分の最高のギャル像を残しておくために、SNSの自身のギャル系女装アカウントに自撮り写真を上げている。ただし自分の顔は映さず、顔から下の写真を上げている。（身バレ防止）ギャル女装をしているが、中身は男であり言動や性的指向も至ってノーマルである。"}],"source":"bangumi","sourceCharacterId":"174298"}],"profileFacts":[{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"27822","sourceWorkId":"38327","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c151483","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"27822","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"27822","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"174298","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f29e4af6045532f5f951342997c4ccb7db8de29d9ee032a39dcf63718b29c051.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd9b00bd370ad98e90c1eb515a9f3cc9cf3dec4ccda3bdf80be3e8005147fb37.webp","width":93,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柚木雪那","creatorId":"vndb:s22613","sourcePersonId":"vndb:s22613","canonicalEntityId":"vndb:s22613","name":"柚木 雪那","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:553292:174298:44177:1","source":"bangumi"}]},{"characterId":"char_c151484","characterName":"天利 ひまり","sourceIds":{"bangumi":[{"characterId":"174358","match":"exact-normalized-name-in-linked-work","subjectId":"553292"}],"egsCharacterIds":["27823"],"vndbCharacterId":"c151484"},"originalCharacterName":"天利 ひまり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"707"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Gyaru who seems cheerful and outgoing, but is actually shy and easily flustered"},{"spoiler":false,"text":"A girl who belongs to the fashion design club."},{"spoiler":false,"text":"She appears to be a bright and sociable gyaru-type girl, but in reality, she struggles with stage fright and was originally more of an introverted \"gloomy\" type. Her club is currently facing the threat of being disbanded, and to meet the school’s conditions for keeping it alive, she's working on creating an outfit to enter in a design contest."},{"spoiler":false,"text":"She’s friends with Tsukune and had heard about Hatsune before, which sparked her curiosity. However, when they finally met, she was shocked to learn that Hatsune was actually a guy—she had been told he was Tsukune's \"sister\"."},{"spoiler":false,"text":"She’s also friends with Aoi, and they used to enjoy cosplaying together from time to time. Lately, though, they’ve grown distant, and she feels a bit lonely because of it."},{"spoiler":false,"text":"•Her birthday it's the same day as the \"Love day\""},{"spoiler":false,"text":"•She is good at: Gaming (on mobile), design, sports."},{"spoiler":false,"text":"•She is bad at: Talking to people she meets for the first time."},{"spoiler":false,"text":"\"I heard it was your older sister, but it’s actually your older brother………!!\""}],"source":"vndb","sourceCharacterId":"c151484"},{"segments":[{"spoiler":false,"text":"服飾デザイン部に所属している女の子。"},{"spoiler":false,"text":"明るく社交的なギャル系女子に見えるが、実はあがり症で、もともとは陰キャであった過去を持つ。所属している部活が、廃部の危機に瀕しており学園から出された部活存続の条件をクリアするためにデザインコンテストに出場するための衣装を制作している。"},{"spoiler":false,"text":"つくねとは友達で、初音のことは前から聞いていて興味を持っていた。だが実際にあった際に、姉だと聞かされていたので兄だったと知り驚愕。"},{"spoiler":false,"text":"葵とも友達であり、たまに一緒にコスプレを楽しんでいた。だが、最近疎遠で少し寂しく思っている。"}],"source":"egs","sourceCharacterId":"27823","sourceWorkId":"38327","spoiler":false},{"segments":[{"spoiler":false,"text":"「お姉ちゃんって聞いてたのに、"},{"spoiler":false,"text":"お兄ちゃんだったなんて……！」"},{"spoiler":false,"text":"服飾デザイン部に所属している女の子。"},{"spoiler":false,"text":"明るく社交的なギャル系女子に見えるが、実はあがり症で、もともとは陰キャであった過去を持つ。所属している部活が、廃部の危機に瀕しており学園から出された部活存続の条件をクリアするためにデザインコンテストに出場するための衣装を制作している。"},{"spoiler":false,"text":"つくねとは友達で、初音のことは前から聞いていて興味を持っていた。だが実際にあった際に、姉だと聞かされていたので兄だったと知り驚愕。"},{"spoiler":false,"text":"葵とも友達であり、たまに一緒にコスプレを楽しんでいた。だが、最近疎遠で少し寂しく思っている。"}],"source":"bangumi","sourceCharacterId":"174358"}],"profileFacts":[{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"27823","sourceWorkId":"38327","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"27823","sourceWorkId":"38327","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/291738f92e1fcde3e9198eea5b2716a51c6c2a0614d072f6c8ef0ac40e556dd6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61d18cc9f3f16683d0b46ba8602cc95ef3736b22db909dc5fb44aa93316878af.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"益子優衣","creatorId":"vndb:s25620","sourcePersonId":"vndb:s25620","canonicalEntityId":"vndb:s25620","name":"益子 優衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:553292:174358:49384:1","source":"bangumi"}]},{"characterId":"char_c151485","characterName":"神志那 葵","sourceIds":{"bangumi":[{"characterId":"174359","match":"exact-normalized-name-in-linked-work","subjectId":"553292"}],"egsCharacterIds":["27824"],"vndbCharacterId":"c151485"},"originalCharacterName":"神志那 葵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"pending-conflict","source":"vndb","value":"1130"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"I"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Headstrong, high-energy otaku gyaru"},{"spoiler":false,"text":"An otaku-type girl who mainly focuses on cosplay."},{"spoiler":false,"text":"When it comes to things she finds cute, she charges in headfirst—whether it's a guy, a girl, an animal, a non-human creature, or even an inanimate object, it doesn't matter. If she thinks it's cute, she's all in."},{"spoiler":false,"text":"After hearing that the fashion design club might be disbanded, she really wants to support her friend Himari. However, since they’ve grown distant lately, she hasn’t been able to find the right moment to reach out."},{"spoiler":false,"text":"She’s a hardcore otaku and absolutely loves cute things."},{"spoiler":false,"text":"When she gets too excited, she often loses sight of everything around her. Lately, she’s been totally obsessed with the “kind gyaru who’s nice to otaku” archetype."},{"spoiler":false,"text":"•Her birthday it's the same day as the \"Cosplay Day\""},{"spoiler":false,"text":"•She is good at: Cosplay, gaming (in general)."},{"spoiler":false,"text":"•She is bad at: Sports, cooking, holding back."},{"spoiler":false,"text":"\"A gyaru who's kind to otakus? Honestly, that's just irresistible!\""}],"source":"vndb","sourceCharacterId":"c151485"},{"segments":[{"spoiler":false,"text":"コスプレをメインに活動するオタク系女子。"},{"spoiler":false,"text":"異性だろうが同性だろうが動物だろうが、人外だろうが無機物だろうがなんだろうが、自分が可愛いと思うものに対しては猪突猛進突っ込んでいく。"},{"spoiler":false,"text":"服飾デザイン部が廃部になるかもと知り、友人であるひまりの力になりたいと思っているが、最近疎遠のため中々言い出せないでいる。かなりオタクで、可愛いものが大好物なタイプ。"},{"spoiler":false,"text":"また暴走すると周りが見えなくなることが多々ある。最近はオタクに優しいギャルというジャンルに夢中になっている。"}],"source":"egs","sourceCharacterId":"27824","sourceWorkId":"38327","spoiler":false},{"segments":[{"spoiler":false,"text":"「オタクに優しいギャルとか、"},{"spoiler":false,"text":"正直たまらんですなぁ！」"},{"spoiler":false,"text":"コスプレをメインに活動するオタク系女子。"},{"spoiler":false,"text":"異性だろうが同性だろうが動物だろうが、人外だろうが無機物だろうがなんだろうが、自分が可愛いと思うものに対しては猪突猛進突っ込んでいく。"},{"spoiler":false,"text":"服飾デザイン部が廃部になるかもと知り、友人であるひまりの力になりたいと思っているが、最近疎遠のため中々言い出せないでいる。かなりオタクで、可愛いものが大好物なタイプ。"},{"spoiler":false,"text":"また暴走すると周りが見えなくなることが多々ある。最近はオタクに優しいギャルというジャンルに夢中になっている。"}],"source":"bangumi","sourceCharacterId":"174359"}],"profileFacts":[{"label":"罩杯（本版本）","value":"i","valueContext":null,"source":"egs","sourceCharacterId":"27824","sourceWorkId":"38327","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"27824","sourceWorkId":"38327","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"birthday":[{"comparisonValue":"1130","source":"vndb","sourceCharacterId":"c151485","value":"1130"},{"comparisonValue":"1030","source":"egs","sourceCharacterId":"27824","value":"10/30"},{"comparisonValue":"1130","source":"bangumi","sourceCharacterId":"174359","value":"11月30日（コスプレの日）"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/491af674230cfe093c33ddadeea3fc3f158f69bc20a76eaba658e201db46742d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f82e82b63320a84affad79c173504b8be577c2181b1b15eb21c7cef17f9100c2.webp","width":85,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みたかりん","creatorId":"vndb:s5060","sourcePersonId":"vndb:s5060","canonicalEntityId":"vndb:s5060","name":"みたか りん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:553292:174359:25596:1","source":"bangumi"}]},{"characterId":"char_c151486","characterName":"東雲 すず","sourceIds":{"bangumi":[{"characterId":"174360","match":"exact-normalized-name-in-linked-work","subjectId":"553292"}],"egsCharacterIds":["27825"],"vndbCharacterId":"c151486"},"originalCharacterName":"東雲 すず","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"413"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Surprisingly Domestic Childhood Friend-Type Gyaru"},{"spoiler":false,"text":"A girl who’s both Hatsune’s childhood friend and current classmate."},{"spoiler":false,"text":"She’s had feelings for Hatsune since they were kids, but those feelings only grew stronger after she moved away."},{"spoiler":false,"text":"She’s good at cooking and genuinely enjoys it—her dream is to one day open her own restaurant. To work toward that goal, she’s currently studying while working part-time at a café. Back when they were kids, most people laughed at her dream, but Hatsune was the only one who didn’t mock her—he took her seriously and supported her. Because of that, even though she’s surprised to see Hatsune now crossdressing as a gyaru, she doesn’t reject it. Instead, she wants to support him."},{"spoiler":false,"text":"More than anything, she’s determined to cheer Hatsune on. No matter who he ends up dating, she’s committed to putting Hatsune’s happiness first."},{"spoiler":false,"text":"•Her birthday it's the same day as the \"Coffee shop Day\""},{"spoiler":false,"text":"•She is good at: Cooking, Housework."},{"spoiler":false,"text":"•She is bad at: Waking up early."},{"spoiler":false,"text":"\"Well, no matter who it is, I'll cheer them on! ♪\""}],"source":"vndb","sourceCharacterId":"c151486"},{"segments":[{"spoiler":false,"text":"初音の幼馴染でクラスメイトな女の子。"},{"spoiler":false,"text":"初音のことが昔から気になっていたが、引っ越してしまったことでその気持ちを強くする。"},{"spoiler":false,"text":"料理が得意で好きであり、将来自分の店を持ちたいと考えている。そのために喫茶店でバイトをしながら勉強をしている。子供のときに、その夢をみんなが笑っていた中、初音だけが否定せず、真面目に応援してくれていた。その為、再会した初音のギャル女装に驚きながらも否定はすることなく、応援してあげようと考えている。"},{"spoiler":false,"text":"初音を応援するということを第一に考えており誰と付き合おうとも初音優先で応援をすると心に決めている。"}],"source":"egs","sourceCharacterId":"27825","sourceWorkId":"38327","spoiler":false},{"segments":[{"spoiler":false,"text":"「ま、誰が相手でも"},{"spoiler":false,"text":"応援はしてあげるわよ♪」"},{"spoiler":false,"text":"初音の幼馴染でクラスメイトな女の子。"},{"spoiler":false,"text":"初音のことが昔から気になっていたが、引っ越してしまったことでその気持ちを強くする。"},{"spoiler":false,"text":"料理が得意で好きであり、将来自分の店を持ちたいと考えている。そのために喫茶店でバイトをしながら勉強をしている。子供のときに、その夢をみんなが笑っていた中、初音だけが否定せず、真面目に応援してくれていた。その為、再会した初音のギャル女装に驚きながらも否定はすることなく、応援してあげようと考えている。"},{"spoiler":false,"text":"初音を応援するということを第一に考えており誰と付き合おうとも初音優先で応援をすると心に決めている。"}],"source":"bangumi","sourceCharacterId":"174360"}],"profileFacts":[{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"27825","sourceWorkId":"38327","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"27825","sourceWorkId":"38327","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd279808896b7b8812c9e509d209d348d5a6c8fc74745ba25fc936016e6d5888.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2eb348b1eaa555eefbbe819be99883dfbdc25e5813220908d41e5dea970157f.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊ヶ崎綾香","creatorId":"vndb:s8564","sourcePersonId":"vndb:s8564","canonicalEntityId":"vndb:s8564","name":"伊ヶ崎綾香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:553292:174360:22078:1","source":"bangumi"}]},{"characterId":"char_c151487","characterName":"我楽多 真魚","sourceIds":{"bangumi":[{"characterId":"174361","match":"exact-normalized-name-in-linked-work","subjectId":"553292"}],"egsCharacterIds":["27826"],"vndbCharacterId":"c151487"},"originalCharacterName":"我楽多 真魚","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"222"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"H"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Cheerful and outgoing gyaru who loves club activities"},{"spoiler":false,"text":"A high-energy girl who’s all about her club and not so great at studying. She’s cheerful, super sociable, and has tons of friends."},{"spoiler":false,"text":"While academics aren’t her strong point, she has an amazing memory for faces and names. She’s a member of the swimming team, and to make it easy to jump straight into practice, she usually wears her swimsuit under a tracksuit."},{"spoiler":false,"text":"She’s close friends with Suzu—they’re both in the same remedial classes and also work part-time together. They often hang out, go on little outings, or visit each other’s homes. The two are practically inseparable."},{"spoiler":false,"text":"Fun fact: her mom used to be a cosplayer."},{"spoiler":false,"text":"•Her birthday it's the same day as the \"World Friendship Day\""},{"spoiler":false,"text":"•She is good at: Sports, instant memory (only for things she's interested in)."},{"spoiler":false,"text":"•She is bad at: Studying."},{"spoiler":false,"text":"\"Hey hey! Heading home? Let's go together then! ♪\""}],"source":"vndb","sourceCharacterId":"c151487"},{"segments":[{"spoiler":false,"text":"部活大好き、勉強苦手な元気娘。明るく社交的で友人がすごい多い。"},{"spoiler":false,"text":"勉強は苦手だが、人の顔や名前を覚えるのが超得意。水泳部に所属していて、基本的にすぐ部活に行けるように水着を着て、その上にジャージを羽織っている。すずとは補修仲間であり、バイト仲間でもある。たまに一緒に出かけたり、家に遊びに行ったりととても仲が良く親友同士である。"},{"spoiler":false,"text":"実は母親が元コスプレイヤーだったりする。"}],"source":"egs","sourceCharacterId":"27826","sourceWorkId":"38327","spoiler":false},{"segments":[{"spoiler":false,"text":"「おっすおす！　今帰り？"},{"spoiler":false,"text":"なら一緒に帰ろーよ♪」"},{"spoiler":false,"text":"部活大好き、勉強苦手な元気娘。明るく社交的で友人がすごい多い。"},{"spoiler":false,"text":"勉強は苦手だが、人の顔や名前を覚えるのが超得意。水泳部に所属していて、基本的にすぐ部活に行けるように水着を着て、その上にジャージを羽織っている。すずとは補修仲間であり、バイト仲間でもある。たまに一緒に出かけたり、家に遊びに行ったりととても仲が良く親友同士である。"},{"spoiler":false,"text":"実は母親が元コスプレイヤーだったりする。"}],"source":"bangumi","sourceCharacterId":"174361"}],"profileFacts":[{"label":"罩杯（本版本）","value":"h","valueContext":null,"source":"egs","sourceCharacterId":"27826","sourceWorkId":"38327","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"27826","sourceWorkId":"38327","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94208351deb834c5e267dab1ba734ee9b1b9d49bd0f1f2b9a2e7e3913d95a4d1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9bf31689a256a9ef057da1fbb732934e859ad0c0e1d50b12da29d30d5e33f4ae.webp","width":91,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水野七海","creatorId":"vndb:s2524","sourcePersonId":"vndb:s2524","canonicalEntityId":"vndb:s2524","name":"星野七海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:553292:174361:17078:1","source":"bangumi"}]},{"characterId":"char_c151488","characterName":"二条 つくね","sourceIds":{"bangumi":[{"characterId":"174362","match":"exact-normalized-name-in-linked-work","subjectId":"553292"}],"egsCharacterIds":["27827"],"vndbCharacterId":"c151488"},"originalCharacterName":"二条 つくね","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"pending-conflict","source":"vndb","value":"211"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Crossdressing little sister with a secret brother complex"},{"spoiler":false,"text":"Hatsune’s younger sister and a member of the fashion design club."},{"spoiler":false,"text":"While Hatsune dresses as a gyaru, she goes in the opposite direction—she dresses as a boy. People around her see her as a supportive sister who shares her brother’s interest in fashion and self-expression."},{"spoiler":false,"text":"But in reality, her choice to crossdress stems from a deeper, more personal feeling: Why didn’t my brother, who’s trying to become his ideal gyaru, come to me—the girl closest to him—for help? Her crossdressing is actually an expression of these complicated feelings toward her brother."},{"spoiler":false,"text":"In truth, she’s a full-blown brocon—a girl absolutely obsessed with her big brother—but no one around her has any idea. And she has no intention of letting them find out."},{"spoiler":false,"text":"•Her birthday it's the same day as the \"Dat that leads to good connections.\""},{"spoiler":false,"text":"•She is good at: Sports, studying."},{"spoiler":false,"text":"•She is bad at: Being active on days off."},{"spoiler":false,"text":"\"Nii-san, you're not overdoing it again, are you?\""}],"source":"vndb","sourceCharacterId":"c151488"},{"segments":[{"spoiler":false,"text":"初音の妹であり、服飾デザイン部に所属している女の子。"},{"spoiler":false,"text":"初音がギャル系女装をしているのに対して、男装をしている。周囲からは同じような趣味の理解のある妹と思われている。"},{"spoiler":false,"text":"がその実態は、理想のギャルを体現したいと思っている兄がなんで一番身近な異性の自分にお願いしなかったのか？という兄に対するうちに秘める想いの現れである。"},{"spoiler":false,"text":"実はお兄ちゃん大好き超絶ブラコン娘であるのだが、それは周囲の誰も知らないし、知られてもいない。"}],"source":"egs","sourceCharacterId":"27827","sourceWorkId":"38327","spoiler":false},{"segments":[{"spoiler":false,"text":"「兄さん、まーた"},{"spoiler":false,"text":"無理してるんじゃないの？」"},{"spoiler":false,"text":"初音の妹であり、服飾デザイン部に所属している女の子。"},{"spoiler":false,"text":"初音がギャル系女装をしているのに対して、男装をしている。周囲からは同じような趣味の理解のある妹と思われている。"},{"spoiler":false,"text":"がその実態は、理想のギャルを体現したいと思っている兄がなんで一番身近な異性の自分にお願いしなかったのか？という兄に対するうちに秘める想いの現れである。"},{"spoiler":false,"text":"実はお兄ちゃん大好き超絶ブラコン娘であるのだが、それは周囲の誰も知らないし、知られてもいない。"}],"source":"bangumi","sourceCharacterId":"174362"}],"profileFacts":[{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCharacterId":"27827","sourceWorkId":"38327","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"27827","sourceWorkId":"38327","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"birthday":[{"comparisonValue":"0211","source":"vndb","sourceCharacterId":"c151488","value":"211"},{"comparisonValue":"1102","source":"egs","sourceCharacterId":"27827","value":"11/2"},{"comparisonValue":"0112","source":"bangumi","sourceCharacterId":"174362","value":"11月2日（いい縁につながる日）"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5079b9beaea6feb5da0cba0f24561f782450c96d91a8d6d9ad5b05bff83cf19.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15185599ab3a697cc0f24ea035fbff2f7a8e207778b1c39fc1e1fdbc6cab5048.webp","width":62,"height":256,"source":"static-detail"},"actors":[{"creditedName":"能勢ともみ","creatorId":"vndb:s21251","sourcePersonId":"vndb:s21251","canonicalEntityId":"vndb:s21251","name":"能勢 ともみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:553292:174362:38792:1","source":"bangumi"}]},{"characterId":"char_c151489","characterName":"東雲 りりか","sourceIds":{"bangumi":[{"characterId":"174363","match":"exact-normalized-name-in-linked-work","subjectId":"553292"}],"egsCharacterIds":["27828"],"vndbCharacterId":"c151489"},"originalCharacterName":"東雲 りりか","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"511"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"J"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The ex-gyaru mom who unknowingly warped the protagonist’s tastes"},{"spoiler":false,"text":"Suzu’s mother, a former gyaru herself."},{"spoiler":false,"text":"After separating from her husband, she returned to her previous job as a teacher. She currently works at the school as the advisor for the fashion design club. When Hatsune was about to transfer schools due to his parents' circumstances, Tsukune—who was close friends with Suzu—threw a fit, not wanting to be apart from him. As a result, he ended up living with them."},{"spoiler":false,"text":"Lately, since her actual daughter Suzu has been busy with part-time work, she’s been doting on Tsukune like he were her own child. Back when she was a student, she was close friends with Mana’s mother, and the two used to cosplay together."},{"spoiler":false,"text":"She also happens to be the main reason Hatsune’s preferences turned out the way they did—but she’s completely unaware of that."},{"spoiler":false,"text":"•Her birthday it's the same day as the \"Mother's Day\""},{"spoiler":false,"text":"•She is good at: Cooking, cosplay (not doing it anymore)."},{"spoiler":false,"text":"•She is bad at: Organizing, sports."},{"spoiler":false,"text":"\"You admired me...? That’s such a sweet thing to say~♪\""}],"source":"vndb","sourceCharacterId":"c151489"},{"segments":[{"spoiler":false,"text":"すずの母親で元ギャルのママ。"},{"spoiler":false,"text":"夫と別れたことにより、元の仕事である教師に復帰。学園では服飾部の顧問も務めている。初音が両親の都合で転校するというときに、娘であるすずと仲の良かったつくねが引っ越したくないと駄々をこねた為に、一緒に暮らすことになった。"},{"spoiler":false,"text":"最近は、実の娘のすずがバイトで忙しいこともあり、つくねのことをまるで娘のように溺愛している。学園に通っていた頃は、真魚の母親と仲が良く、二人でコスプレをしたりしていた。"},{"spoiler":false,"text":"主人公の性癖を歪ませた原因でもあるのだが、本人にその自覚はまったくない。"}],"source":"egs","sourceCharacterId":"27828","sourceWorkId":"38327","spoiler":false},{"segments":[{"spoiler":false,"text":"「私に憧れた……なんて、"},{"spoiler":false,"text":"嬉しいこと言ってくれるのね♪」"},{"spoiler":false,"text":"すずの母親で元ギャルのママ。"},{"spoiler":false,"text":"夫と別れたことにより、元の仕事である教師に復帰。学園では服飾部の顧問も務めている。初音が両親の都合で転校するというときに、娘であるすずと仲の良かったつくねが引っ越したくないと駄々をこねた為に、一緒に暮らすことになった。"},{"spoiler":false,"text":"最近は、実の娘のすずがバイトで忙しいこともあり、つくねのことをまるで娘のように溺愛している。学園に通っていた頃は、真魚の母親と仲が良く、二人でコスプレをしたりしていた。"},{"spoiler":false,"text":"主人公の性癖を歪ませた原因でもあるのだが、本人にその自覚はまったくない。"}],"source":"bangumi","sourceCharacterId":"174363"}],"profileFacts":[{"label":"罩杯（本版本）","value":"j","valueContext":null,"source":"egs","sourceCharacterId":"27828","sourceWorkId":"38327","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"27828","sourceWorkId":"38327","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7b141d2bc25dfb630e4c245d1bb4ae60d087e4fe513ea97f98ca0ce459c51e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a51b1714ed0cc70d558f70504c851277804cb1965dfa9a27c2a66a07d135486.webp","width":103,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小日向みき","creatorId":"vndb:s13093","sourcePersonId":"vndb:s13093","canonicalEntityId":"vndb:s13093","name":"小日向 みき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:553292:174363:29176:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p5397","sourceCompanyId":"egs:brand:4619","canonicalEntityId":"vndb:p5397","name":"自宅すたじお","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:38327:4619","source":"egs"},{"companyId":"vndb:p5397","sourceCompanyId":"vndb:p5397","canonicalEntityId":"vndb:p5397","name":"自宅すたじお","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:145484:v55797","source":"vndb"},{"companyId":"vndb:p5397","sourceCompanyId":"vndb:p5397","canonicalEntityId":"vndb:p5397","name":"自宅すたじお","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:145485:v55797","source":"vndb"},{"companyId":"vndb:p9483","sourceCompanyId":"vndb:p9483","canonicalEntityId":"vndb:p9483","name":"Shiravune","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:163073:v55797","source":"vndb"},{"companyId":"vndb:p9483","sourceCompanyId":"vndb:p9483","canonicalEntityId":"vndb:p9483","name":"Shiravune","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:163075:v55797","source":"vndb"},{"companyId":"vndb:p24003","sourceCompanyId":"vndb:p24003","canonicalEntityId":"vndb:p24003","name":"Alyappy","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:169663:v55797","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
