{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"21028","model":{"presentationWorkId":"vndb:v16083","staff":{"artwork":[{"creditedName":"ヤサカニ・アン","creatorId":"vndb:s41829","sourcePersonId":"egs:creator:21707","canonicalEntityId":"vndb:s41829","name":"ヤサカニ・アン","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:137612","source":"egs"}],"scenario":[{"creditedName":"須々木鮎尾","creatorId":"vndb:s2319","sourcePersonId":"egs:creator:13991","canonicalEntityId":"vndb:s2319","name":"須々木鮎尾","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:137613","source":"egs"},{"creditedName":"草薙","creatorId":"vndb:s1964","sourcePersonId":"egs:creator:10804","canonicalEntityId":"vndb:s1964","name":"草薙","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:137614","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c26104","characterName":"南 佳奈子","sourceIds":{"bangumi":[{"characterId":"47591","match":"exact-normalized-name-in-linked-work","subjectId":"126541"}],"egsCharacterIds":["5536"],"vndbCharacterId":"c26104"},"originalCharacterName":"南 佳奈子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's classmate. She is very timid around most people. She is caught taking sexy pictures of self in the classroom by protag. At first she is half-assed blackmailed to be a model to take pics, but she turns it down and he gives up. But she then changes her mind when she hears the protag is passionate to be a photographer and she wouldn't have to do anything naughty."}],"source":"vndb","sourceCharacterId":"c26104"},{"segments":[{"spoiler":false,"text":"主人公の同級生で、クラスメート。"},{"spoiler":false,"text":"引っ込み思案の大人しい性格で、クラスでも地味で目立たない存在。"},{"spoiler":false,"text":"「自己表現、自己主張も出来ない自分を変えたい」という悩みを抱えていて、モデルを目指して芸能関係に携わる人材を一手に育成する学園に進むも土壇場で尻込みをしてしまい、何故かカメラマンの育成学科を選択してしまう。"},{"spoiler":false,"text":"そうして、悩みをこじらせた結果、勢い余って学園の教室で露出行為の自撮りに踏み切ってしまうのだが、初めてのその行為を主人公に見られてしまったのが事の発端となる。"}],"source":"egs","sourceCharacterId":"5536","sourceWorkId":"21028","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の同級生でクラスメイト。"},{"spoiler":false,"text":"引っ込み思案のおとなしい性格で、クラスでも地味で目立たない存在。"},{"spoiler":false,"text":"人と話すことにプレッシャーを感じるのか、あがり症で友達も少ない。"},{"spoiler":false,"text":"“自分を見てほしい” という欲求を心の奥底に秘めている。"},{"spoiler":false,"text":"アイドルやモデルを目指す学科には尻込みをしてしまい、何故かカメラマンの育成学科を選択してしまった。"},{"spoiler":false,"text":"自分の露出写真を撮って投稿するといったことも恐くて出来ず、欲求の行き場がなくて悩んでいる。"},{"spoiler":false,"text":"「……これからも、水着を着た私の写真…… 撮って、くれます……か？」"}],"source":"bangumi","sourceCharacterId":"47591"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26bb46afb05fc8411bc77cb86b673f3d0f5dec1daf86a787b894e042cafb9017.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc262f0773639a774e285227745694f788c08e68408561f64dab7809da48a97e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126541:47591:6359:1","source":"bangumi"}]},{"characterId":"char_c26105","characterName":"宮澤 里保奈","sourceIds":{"bangumi":[{"characterId":"47592","match":"exact-normalized-name-in-linked-work","subjectId":"126541"}],"egsCharacterIds":["5537"],"vndbCharacterId":"c26105"},"originalCharacterName":"宮澤 里保奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染み。"},{"spoiler":false,"text":"幼い頃は仲が良かったのだが、進級してゆくにつれて、すっかり疎遠になっていた。"},{"spoiler":false,"text":"モデルを目指して、芸能関係に携わる人材を一手に育成する学園に進んだのだが、主人公がそこにカメラマンを目指して入学したのは、まったくの偶然。"},{"spoiler":false,"text":"学園の方針で、モデル学科の学園生は全員、モデル事務所に所属する形となっていて、里保奈も駆け出しのモデルではあるが、それなりに仕事がもらえ始めている。"},{"spoiler":false,"text":"と言っても色気に乏しいので、スーパーのチラシなど地味な仕事ばかり。"},{"spoiler":false,"text":"負けん気が強く、ズバズバと物を言う性格だが、ちょっと素直ではない所も。"}],"source":"egs","sourceCharacterId":"5537","sourceWorkId":"21028","spoiler":false},{"segments":[{"spoiler":false,"text":"駆け出しではあるが、それなりに仕事がある学生モデル。"},{"spoiler":false,"text":"主人公とは幼なじみ。 気恥ずかしさからすっかり疎遠になっていたが、学園で偶然再会した。"},{"spoiler":false,"text":"負けん気が強く、ズバズバとモノを言う性格だが、ちょっと素直ではないところがある。"},{"spoiler":false,"text":"モデルなので人に見られることに馴れてはいるが、過激な水着を堂々と着られるほどに達観してもいない。"},{"spoiler":false,"text":"主人公の要求に対しては、戸惑いや羞恥を見せることも。"},{"spoiler":false,"text":"「あたしはモデルよ！　この程度の水着くらい、どってことないわ！」"}],"source":"bangumi","sourceCharacterId":"47592"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8382c9e6a88ae842362eb722ac2ccc54a858618e456e862f786c4aba57515afa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a50af3fc715f42f65fe8fda027769b92c807acee230464308e2ada40acd2b86.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126541:47592:10027:1","source":"bangumi"}]},{"characterId":"char_c26106","characterName":"蒼井 静","sourceIds":{"bangumi":[{"characterId":"47593","match":"exact-normalized-name-in-linked-work","subjectId":"126541"}],"egsCharacterIds":["5538"],"vndbCharacterId":"c26106"},"originalCharacterName":"蒼井 静","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水着の店、『ピーカブー(peek-a-boo)』の店長にして唯一の店員。"},{"spoiler":false,"text":"女性客がメインの店の前をウロウロしていた主人公に興味を持ち、店に引っ張り込んで話を聞いた事から知り合いとなり、色々と協力してくれるようになる。"},{"spoiler":false,"text":"ちなみに店で扱っている商品のモデルは、経費削減も兼ねて静が自ら務めていて、パンフレットなどに使う写真は、いちおう顔は入れずに首から下だけを写した形にトリミングしたり、髪や肌の色を弄ったりしてから掲載していたのだが、その写真のモデルが自分である事を見抜いたのも主人公に興味を持った理由の一つ。"}],"source":"egs","sourceCharacterId":"5538","sourceWorkId":"21028","spoiler":false},{"segments":[{"spoiler":false,"text":"水着とランジェリーの店 『ピーカブー（peek-a-boo）』 の店長にして唯一の店員。"},{"spoiler":false,"text":"店の前をウロウロしていた主人公に興味を持ち、店に引っ張り込んで話を聞いたとから知り合いとなる。"},{"spoiler":false,"text":"細かいことを気にしない性格なうえ、自分の容姿やスタイルが人の視線を惹き付けることをちゃんと理解している。"},{"spoiler":false,"text":"店で扱っている商品のモデルは、経費削減も兼ねて自ら務める。"},{"spoiler":false,"text":"状況に応じてではあるが、人前で過激な水着を着ることにも抵抗はない。"},{"spoiler":false,"text":"「フフフ…… コレ、さっきのコに着てもらうのかしら？」"}],"source":"bangumi","sourceCharacterId":"47593"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e138bd27f113daa093ff6d228e9e64797cca55ccb3d282b4547062b6c8bc7ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e755fd48a84b121db32de8fdd401c7f8a2af2a5c723e1c2ee21c69cbc43a8c2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126541:47593:5075:1","source":"bangumi"}]},{"characterId":"char_vndb_c122049","characterName":"山篠 信紀","sourceIds":{"vndbCharacterId":"c122049"},"originalCharacterName":"山篠 信紀","characterNameSource":n