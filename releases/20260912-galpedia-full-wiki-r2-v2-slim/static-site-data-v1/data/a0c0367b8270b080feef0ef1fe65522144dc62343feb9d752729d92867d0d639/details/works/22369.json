bCharacterId":"c33354"},"originalCharacterName":"郭嘉","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A strategist with great perception despite his youth who serves Sousou."}],"source":"vndb","sourceCharacterId":"c33354"},{"segments":[{"spoiler":false,"text":"曹魏のツンデレ軍師。主に実戦時の戦術を進言する軍師として、曹操に使えている。"},{"spoiler":false,"text":"いつも冷静で、曹操に対しても言葉を選ばずにキツイ口調で進言・諫言する。"}],"source":"egs","sourceCharacterId":"6825","sourceWorkId":"11334","spoiler":false},{"segments":[{"spoiler":false,"text":"魏の参謀長として、各地にのさばる盗賊の討伐に力を入れている稟。"},{"spoiler":false,"text":"今作では、軍師としての才能をいかんなく発揮……するのだろうか？"},{"spoiler":false,"text":"白蓮に隠れて地味だが、案外この子も結構残念な子だったりする。"}],"source":"egs","sourceCharacterId":"6825","sourceWorkId":"13835","spoiler":false},{"segments":[{"spoiler":false,"text":"妄想と鼻血でおなじみの魏の戦術参謀。"},{"spoiler":false,"text":"よく諫言するものの、実は華琳が大好き。"},{"spoiler":false,"text":"荀彧とは相性がよくなかったのだが、懐妊の後は事あるごと気にかけてくれる。"}],"source":"egs","sourceCharacterId":"6825","sourceWorkId":"21440","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c33354","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"6825","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"6825","value":"女性"},{"comparisonValue":"f","source":"bangumi","sourceCharacterId":"50028","value":"女"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c94208f0022b0a2fafb9dc1ecf6dd59f22d18232c21865958e084313efacd2d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/489282f1d6e2c1e2c86924e110adc77943c982f5a769948c7aacbbf66bccf435.webp","width":118,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴木 裕斗","creatorId":"vndb:s245","sourcePersonId":"vndb:s245","canonicalEntityId":"vndb:s245","name":"鈴木 裕斗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53574","source":"vndb"}]},{"characterId":"char_c33364","characterName":"黄蓋","sourceIds":{"bangumi":[{"characterId":"54623","match":"exact-normalized-name-in-linked-work","subjectId":"14463"},{"characterId":"54623","match":"exact-normalized-name-in-linked-work","subjectId":"2409"}],"egsCharacterIds":["7117"],"vndbCharacterId":"c33364"},"originalCharacterName":"黄蓋","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A military commander who has served Sonken's family for three generations."}],"source":"vndb","sourceCharacterId":"c33364"},{"segments":[{"spoiler":false,"text":"孫呉の生き字引にして、孫策の母、孫堅の同志として長年呉のために尽くしてきた宿将。"},{"spoiler":false,"text":"孫策の片腕として、皆から一目置かれている。豪毅な性格と共に、繊細な気遣いが出来る女性。粋な言動、粋な生き方、粋な振る舞い。"}],"source":"egs","sourceCharacterId":"7117","sourceWorkId":"11334","spoiler":false},{"segments":[{"spoiler":false,"text":"呉の武官筆頭にして、恋姫三熟女の一角。"},{"spoiler":false,"text":"酒とつまみと喧嘩と若者イジメが大好きな、呉の宿将。"},{"spoiler":false,"text":"今作では冷や水っぷりを発揮するとかしないとか？"}],"source":"egs","sourceCharacterId":"7117","sourceWorkId":"13835","spoiler":false},{"segments":[{"spoiler":false,"text":"孫呉の宿将。孫姉妹の母代わり、片腕として、皆一目置く存在。"},{"spoiler":false,"text":"粋な振る舞い、剛毅な性格、繊細な気遣いが同居する女性である。"},{"spoiler":false,"text":"本作では盟友程普だけでなく、蜀の熟女コンビを助っ人に迎えて、酒と男をこよなく愛する熟女四天王による女子会が実現する。"},{"spoiler":false,"text":"もう誰も彼女たちを止めることはできない……"}],"source":"egs","sourceCharacterId":"7117","sourceWorkId":"21441","spoiler":false},{"segments":[{"spoiler":false,"text":"孫呉の生き字引にして、孫策の母・孫堅の同志として長年呉のために尽くしてきた宿将。孫策の片腕として、皆から一目置かれている。"},{"spoiler":false,"text":"豪毅な性格と共に、繊細な気遣いが出来る女性。"},{"spoiler":false,"text":"孫策が連れてきた一刀のことを、腕は立たないが心根は強い人物と認め、なにくれとなく世話を焼いてくれるようになる。"},{"spoiler":false,"text":"「お主ら、そんなことも分からんのかい！」"}],"source":"bangumi","sourceCharacterId":"54623"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c33364","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"7117","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"7117","value":"女性"},{"comparisonValue":"f","source":"bangumi","sourceCharacterId":"54623","value":"女"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6ccc4e065964ed41d1d68b589733487286fd8144e95fcd68623347f4c5082a73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec66f8c3bd8b06db5b232b2df176d8143f537d299cc028d23b197759d08b9007.webp","width":251,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石井 康嗣","creatorId":"vndb:s4903","sourcePersonId":"vndb:s4903","canonicalEntityId":"vndb:s4903","name":"石井 康嗣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53585","source":"vndb"}]},{"characterId":"char_vndb_c33330","characterName":"関羽","sourceIds":{"vndbCharacterId":"c33330"},"originalCharacterName":"関羽","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl of the Maozoku."},{"spoiler":false,"text":"However, she is not a full cat, but a mixed blood born between a human and a cat. It is very rare for a human and a cat to have a child. She never knew her parents and grew up with Ryuu Bi and Chou Hi as brothers ever since she can remember. She is straightforward and courteous, and her exceptional military prowess makes her a trusted member of the clan. However, Kan'U herself feels very much inferior because she is not a full-fledged cat, and she is often afraid of being left alone because of her parents' abandonment. Therefore, she tends to work too hard for her family and for Ryuu Bi."},{"spoiler":false,"text":"translated from fammysgogo"}],"source":"vndb","sourceCharacterId":"c33330"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e7540fece28decaf7b835070a86fbbd7413d31dab642048c962c6cc865309ea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3ac88f349a9a81e87d8230b507852273336f9a808a2d800d5d88787ca659b0bc.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c33331","characterName":"劉備","sourceIds":{"vndbCharacterId":"c33331"},"originalCharacterName":"劉備","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chief of the Maozoku."},{"spoiler":false,"text":"His family has been revered by the villagers for generations."},{"spoiler":false,"text":"He is a bit overprotective of Kan'u."},{"spoiler":false,"text":"He's under the \"Kin Mei\" curse since he was born, which made him unable to grow up neither physically nor mentally but..."}],"source":"vndb","sourceCharacterId":"c33331"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8dd4ec59419c0cc2e66d61791b425a70efb36ee3f997d8cee0b9233fe0ca83b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e659ff65daa3d826bfd4f8e7f382526e1