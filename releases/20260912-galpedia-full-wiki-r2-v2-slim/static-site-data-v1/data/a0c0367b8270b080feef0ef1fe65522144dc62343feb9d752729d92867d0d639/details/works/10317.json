"vndb:s2139","canonicalEntityId":"vndb:s2139","name":"三五 美奈子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268532:153783:6103:1","source":"bangumi"}]},{"characterId":"char_c6196","characterName":"林田 律子","sourceIds":{"bangumi":[{"characterId":"153779","match":"exact-normalized-name-in-linked-work","subjectId":"165418"},{"characterId":"153779","match":"exact-normalized-name-in-linked-work","subjectId":"165419"},{"characterId":"153779","match":"exact-normalized-name-in-linked-work","subjectId":"268532"}],"egsCharacterIds":["18908"],"vndbCharacterId":"c6196"},"originalCharacterName":"林田 律子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"閨の作法"},{"spoiler":false,"text":"数年前に主人公の父と電撃結婚した義母（父の後妻）にして、学校の担任教師。犬丸学園の陰の支配者。"},{"spoiler":false,"text":"戦国時代から続く武家の末裔で、天賦の才を持つ剣の達人。"},{"spoiler":false,"text":"不良共のリーダーだった主人公のチームを1日で壊滅させたという「伝説」を持つ。"}],"source":"egs","sourceCharacterId":"18908","sourceWorkId":"6913","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の担任で、英語教師。"},{"spoiler":false,"text":"学園の影の支配者にして、実践向け殺人術の使い手でもあるすごいお方。"},{"spoiler":false,"text":"当人曰く「模造刀だ」という日本刀を、常に持ち歩いているが、どうみても本物くさい。"},{"spoiler":false,"text":"葵と結婚した息子とイメージが重なる主人公を、あれこれ構いたがるのだが……。"}],"source":"egs","sourceCharacterId":"18908","sourceWorkId":"9488","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の担任で、英語教師。"},{"spoiler":false,"text":"学園の影の支配者にして、実践向け殺人術の使い手でもあるすごいお方。"},{"spoiler":false,"text":"当人曰く「模造刀だ」という日本刀を、常に持ち歩いているが、どうみても本物くさい。"},{"spoiler":false,"text":"葵と結婚した息子とイメージが重なる主人公を、あれこれ構いたがるのだが……。"}],"source":"egs","sourceCharacterId":"18908","sourceWorkId":"10317","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公達兄妹の義母（父の後妻）にして学校の英語担任教師。"},{"spoiler":false,"text":"眉目秀麗＆妙齢の美女で犬神学園の影の支配者。実家は戦国時代から続く武家の末裔で、小太刀二刀や棒手裏剣、素手での体術にも秀でた実践向け殺人術の使い手で剣の天才。"},{"spoiler":false,"text":"数年前に、妻に先立たれた主人公の父、矢嶋良一（やじまりょういち）と電撃結婚。若くして2児の母となる。"},{"spoiler":false,"text":"新婚当時、不良共のリーダーとして無類の強さを誇っていた主人公のチームを、単身で乗り込み一日で壊滅させるという「伝説」を持つ。"}],"source":"bangumi","sourceCharacterId":"153779"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab4f2513711d4186baa361bcb4ce01554aef0c8e648b0fa41b9ac0bea30e910b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43517080c925def01bf73fcafe80cc67a9cab9aa31505539820c6afa53fb6091.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268532:153779:4832:1","source":"bangumi"}]},{"characterId":"char_c80847","characterName":"白鳥 葉月","sourceIds":{"bangumi":[{"characterId":"153780","match":"exact-normalized-name-in-linked-work","subjectId":"165419"}],"egsCharacterIds":["19845"],"vndbCharacterId":"c80847"},"originalCharacterName":"白鳥 葉月","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"葵の代役としてやってきた白鳥家の次女。"},{"spoiler":false,"text":"温厚で世話焼き、周りに気配りのできる性格。"},{"spoiler":false,"text":"白鳥三姉妹の中で、唯一、巫女として生きていこうと決めている少女だが、逆にそれが少しプレッシャーになっている面も。"},{"spoiler":false,"text":"恋愛にも興味があるのだが、「巫女＝処女」と信じており、男女関係に踏み込めずにいる。"}],"source":"egs","sourceCharacterId":"19845","sourceWorkId":"9488","spoiler":false},{"segments":[{"spoiler":false,"text":"犬丸学園に転校してきた白鳥家の次女。"},{"spoiler":false,"text":"産休に入る葵の代打として巫女委員会にも所属。"},{"spoiler":false,"text":"三姉妹の中では一番温厚で、世話焼きで気配りの利くタイプ。"},{"spoiler":false,"text":"三姉妹で巫女として生きていこうとするのは彼女だけで、逆にそれがプレッシャーになっている。"},{"spoiler":false,"text":"恋愛にも憧れるものの、「巫女＝処女でなければ」と信じており、踏み込めずにいる。"}],"source":"bangumi","sourceCharacterId":"153780"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f878cbca672136fc9f4c281434bf9120db1245d0310f27f80b64045b74f3ca7a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1f98b854c37b5cac4ef8acc029287c986871bb0474d64dae54957cee7f21276.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金松 由花","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:37606","source":"vndb"}]},{"characterId":"char_c80848","characterName":"白鳥 弥生","sourceIds":{"bangumi":[{"characterId":"153781","match":"exact-normalized-name-in-linked-work","subjectId":"165419"}],"egsCharacterIds":["19846"],"vndbCharacterId":"c80848"},"originalCharacterName":"白鳥 弥生","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"白鳥家の長女で、学園の科学教師。"},{"spoiler":false,"text":"クールで怜悧、大人の雰囲気を醸し出す彼女は、葵の同級生で、当時から天然だった彼女の言動を楽しんでいたようだ。"},{"spoiler":false,"text":"「本業は巫女」（本人談）ということで、巫女服の上から白衣を引っかける斬新なスタイルで、赴任早々、学園内の男子たちの若いリビドーを刺激しまくりである。"}],"source":"egs","sourceCharacterId":"19846","sourceWorkId":"9488","spoiler":false},{"segments":[{"spoiler":false,"text":"白鳥家の長女で犬丸学園の科学教師。"},{"spoiler":false,"text":"当人曰く「本業は巫女」と言うことで、巫女装束の上に白衣をひっかけている。"},{"spoiler":false,"text":"クールで怜悧、大人の女性を思わせる雰囲気の持ち主で、赴任早々学園内の女王として男子学生のリビドーを刺激しまくっている。"},{"spoiler":false,"text":"葵のかつての同級生で、当時から葵の天然ぶりを楽しんでいた。"}],"source":"bangumi","sourceCharacterId":"153781"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc06befc56a69916b4782ee02c1d00ee0389a290abb9d5080ea634af26472b32.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a36da35effc3a5d2701661bfafc5cc9547cc88d45c69af9ac3c790a451f9801d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大波 こなみ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:37604","source":"vndb"}]},{"characterId":"char_c80849","characterName":"白鳥 皐月","sourceIds":{"bangumi":[{"characterId":"153782","match":"exact-normalized-name-in-linked-work","subjectId":"165419"}],"egsCharacterIds":["19847"],"vndbCharacterId":"c80849"},"originalCharacterName":"白鳥 皐月","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同じクラスになった白鳥家の三女。"},{"spoiler":false,"text":"性格は明るく、魅力的な女の子なのだが、勉強が苦手で、それをバカにされると、鉄拳制裁も辞さない構え。"},{"spoiler":false,"text":"それゆえ、主人公の挑発にも乗りやすく、ケンカ三昧の毎日を送っているのだが……。"},{"spoiler":false,"text":"放課後や休日は、主人公の稼業である和菓子屋でウェイトレスのバイトをしている。"}],"source":"egs","sourceCharacterId":"19847","sourceWorkId":"9488","spoiler":false},{"segments":[{"spoiler":false,"text":"犬丸学園に転校してきた白鳥家の三女。"},{"spoiler":false,"text":"主人公と同じクラスになる。ツンデレな性格で、主人公とは毎日ケンカ三昧。"},{"spoiler":false,"text":"学業が苦手で、それを馬鹿にされると鉄拳制裁も多々飛び出す。とはいえ、性格は明るく、人を惹きつける魅力を持ち、"},{"spoiler":false,"text":"どこか憎めない。"},{"spoiler":false,"text":"放課後や休日は、主人公の家業の和菓子屋のウェイトレスのバイトをすることに。"}],"source":"bangumi","sourceCharacterId":"153782"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8aacbdbc0e3774770609334e8a13b0599824c67bc743ff649b60cafc9853879f.webp","fallbackUrl