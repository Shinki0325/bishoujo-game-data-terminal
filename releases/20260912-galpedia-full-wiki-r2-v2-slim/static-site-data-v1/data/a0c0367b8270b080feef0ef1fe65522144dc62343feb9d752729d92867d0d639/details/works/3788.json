{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"3788","model":{"presentationWorkId":"vndb:v3773","staff":{"artwork":[{"creditedName":"蓮(Louis_IGs、Louis&Visee)","creatorId":"vndb:s1924","sourcePersonId":"egs:creator:1701","canonicalEntityId":"vndb:s1924","name":"蓮(Louis_IGs、Louis&Visee)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5397","source":"egs"}],"scenario":[{"creditedName":"庵乃音人","creatorId":"vndb:s595","sourcePersonId":"egs:creator:2143","canonicalEntityId":"vndb:s595","name":"庵乃音人","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:5398","source":"egs"}],"music":[{"creditedName":"ミリオンバンブー(有限会社バンブー)","creatorId":"vndb:s1435","sourcePersonId":"egs:creator:2670","canonicalEntityId":"vndb:s1435","name":"ミリオンバンブー(有限会社バンブー)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:11844","source":"egs"}],"other":[{"creditedName":"大野 まりな","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:45019","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c25190","characterName":"紺野直道","sourceIds":{"vndbCharacterId":"c25190"},"originalCharacterName":"紺野直道","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is a doctor who specializes in treating a rare diseases like arrested development caused by psychological trauma."},{"spoiler":false,"text":"He rarely opens up and gives the impression of being stoic, he is often cold to those around him because of this."},{"spoiler":false,"text":"He is also constantly questioning himself as a doctor. Perhaps the person who was saved the most by meeting Kanata and Kurumi is the doctor himself."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c25190"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c25191","characterName":"宮下 くるみ","sourceIds":{"vndbCharacterId":"c25191"},"originalCharacterName":"宮下 くるみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Like Kanata, she is a girl whose “time” has stopped due to an accident, but mentally, she is a bit mature and enlightened. She also shows a slightly frightened side due to her special circumstances."},{"spoiler":false,"text":"She trusts the protagonist, calls him “Sensei”, and receives treatment from him. She puts her sister first and acts accordingly. She is characterized by her wavy blond hair and pale emerald eyes."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c25191"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/577a3241fad9f34c8e9d129580e921621ed4e21dfd35b422e1ca1f85d0efee08.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e5c96c52eb0c62ba544563581ee272fbec4315aabcb6e47b4f7616547029e44.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木葉 楓","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24868","source":"vndb"}]},{"characterId":"char_vndb_c25192","characterName":"宮下 かなた","sourceIds":{"vndbCharacterId":"c25192"},"originalCharacterName":"宮下 かなた","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The circumstances on the accident that lead to the death of her parents have resulted in a strange disorder that has stopped her mental and physical growth."},{"spoiler":false,"text":"Her speech and mannerisms are very juvenile, and it highlights the large gap between her actual age and behaviour. She always carries a stuffed orca around."},{"spoiler":false,"text":"She sometimes sees hallucinations of her mother and father from her memories before the accident. She has recently started seeing her father in the protagonist, and has begun calling him \"papa\" and adores him greatly."},{"spoiler":false,"text":"She is a shy girl who always acts as if she is hiding behind Kurumi, because her sister is her only living relative."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c25192"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0e3c29415d46d20723cd1adc2252d05a738ef49ba15e0a3392a5e2267799d3d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12490d3345b31755f677b0b8ffff3ed56c433c1d88fde52e816b230faa821f73.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"草柳 順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:24869","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p189","sourceCompanyId":"egs:brand:267","canonicalEntityId":"vndb:p189","name":"BLACK PACKAGE","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:3788:267"