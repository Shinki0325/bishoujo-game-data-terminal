b"},{"creditedName":"ピクセルビー","creatorId":"vndb:s3360","sourcePersonId":"vndb:s3360","canonicalEntityId":"vndb:s3360","name":"ピクセルビー","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:157063","source":"vndb"}],"other":[{"creditedName":"うん＝食太郎","creatorId":"vndb:s5845","sourcePersonId":"vndb:s5845","canonicalEntityId":"vndb:s5845","name":"うん＝食太郎","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:157064","source":"vndb"},{"creditedName":"リャオ","creatorId":"vndb:s6122","sourcePersonId":"vndb:s6122","canonicalEntityId":"vndb:s6122","name":"リャオ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:157066","source":"vndb"},{"creditedName":"漣 枕","creatorId":"vndb:s9828","sourcePersonId":"vndb:s9828","canonicalEntityId":"vndb:s9828","name":"漣 枕","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:157068","source":"vndb"}]},"cast":[{"characterId":"char_c57899","characterName":"ダニエル・ガルシア","sourceIds":{"bangumi":[{"characterId":"91710","match":"exact-normalized-name-in-linked-work","subjectId":"225200"}],"egsCharacterIds":["17580"],"vndbCharacterId":"c57899"},"originalCharacterName":"ダニエル・ガルシア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"193"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"98"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A tall macho boy who is bright and lively."},{"spoiler":false,"text":"He can speak Japanese, though he is far from being fluent."},{"spoiler":false,"text":"While he is from an emerging nation, his father is a wealthy company president."},{"spoiler":false,"text":"He has always had an interest in Japan, and through an acquaintance of his father he was referred to the protagonist's household."},{"spoiler":false,"text":"His nickname is Danny."},{"spoiler":false,"text":"Translated from the official site"},{"spoiler":false,"text":"---"},{"spoiler":false,"text":"Height in sequel: 195cm"},{"spoiler":false,"text":"He comes to Japan for the second time in search of a \"woman willing to become his mother\""},{"spoiler":false,"text":"He is a friendly and cheerful person who gets along with people"},{"spoiler":false,"text":"He is always sure to do muscle training reps in order to maintain his muscles"},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c57899"},{"segments":[{"spoiler":false,"text":"明るく元気な長身マッチョ青年。日本語も片言ながら喋れる。"},{"spoiler":false,"text":"新興国ながらも親は社長で裕福。"},{"spoiler":false,"text":"元々日本に興味があり、父の知り合いを通じて主人公の家を紹介して貰った。"},{"spoiler":false,"text":"愛称はダニー。"}],"source":"egs","sourceCharacterId":"17580","sourceWorkId":"24915","spoiler":false},{"segments":[{"spoiler":false,"text":"明るく元気な長身マッチョ青年。 愛称はダニー。"},{"spoiler":false,"text":"出身は新興国だが親は社長で裕福。 日本語もカタコトながら喋れる。"},{"spoiler":false,"text":"元々日本に興味があり、父の知り合いを通じて主人公の家を紹介してもらった。"}],"source":"bangumi","sourceCharacterId":"91710"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a6acfc97a815d7170ae58de663d1091f01fe783c49fbe665230ef3a308a65f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6bc0d4c99aeaac26de45495487c5dff10453900715aa863d9503ecbc5e453aee.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c137716","characterName":"大崎 明愛","sourceIds":{"vndbCharacterId":"c137716"},"originalCharacterName":"大崎 明愛","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions"