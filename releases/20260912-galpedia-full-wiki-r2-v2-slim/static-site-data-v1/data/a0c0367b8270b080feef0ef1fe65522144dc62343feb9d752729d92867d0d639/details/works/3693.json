タジオ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:17852","source":"vndb"},{"creditedName":"株式会杜ティー・エー・ビー","creatorId":"vndb:s37204","sourcePersonId":"vndb:s37204","canonicalEntityId":"vndb:s37204","name":"TAB act1(TABact1)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:17853","source":"vndb"}]},"cast":[{"characterId":"char_c1216","characterName":"水島 朝","sourceIds":{"bangumi":[{"characterId":"10903","match":"exact-normalized-name-in-linked-work","subjectId":"24223"}],"egsCharacterIds":["22672"],"vndbCharacterId":"c1216"},"originalCharacterName":"水島 朝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sophomore at East School. Swimming team member. She is from this town, but used to go to a school in a neighboring city. She just transferred to East School this semester."},{"spoiler":false,"text":"She has a rough and girly personality. However, she is actually shy, and is blunt and brusque with people she meets for the first time. Because of this, she has a hard time fitting in with her surroundings."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c1216"},{"segments":[{"spoiler":false,"text":"東校二年。水泳部員。この街出身だが、以前は隣市の学校に"},{"spoiler":false,"text":"通っていた。東校にはこの一学期に転校してきたばかり。"},{"spoiler":false,"text":"いっけん大ざっぱでオトコっぽい性格。だが実は人見知り"},{"spoiler":false,"text":"するところがあり、初対面の相手に対しては無愛想でぶっき"},{"spoiler":false,"text":"らぼう。それゆえに周囲にはなかなかとけこめずにいる。"},{"spoiler":false,"text":"成績やや悪。弌と一緒に古文の補習を受講する。同じ水泳部"},{"spoiler":false,"text":"の弌に対しては最初「ちゃらちゃらした軽いヤツ」とやや冷"},{"spoiler":false,"text":"たい視線。十三に対しては「変なヒト」と多少の興味。"},{"spoiler":false,"text":"菜摘芽には何やらわだかまりを持っている様子。"}],"source":"egs","sourceCharacterId":"22672","sourceWorkId":"3693","spoiler":false},{"segments":[{"spoiler":false,"text":"东校二年级，游泳部。"},{"spoiler":false,"text":"从小在这条街长大，不过之前在邻近的城市上学。这个学期才转到东校来。乍看是个大大咧咧的假小子。其实很怕生，对初次见面的人总是很冷淡。因此人际关系不是很融洽。学习成绩有些差。所以和弌一起补习古文。最初认为同属游泳部的弌是“轻浮的家伙”，所以对其态度冷淡。却对“怪人”十三有点兴趣。和菜摘芽有些隔阂。"}],"source":"bangumi","sourceCharacterId":"10903"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"22672","sourceWorkId":"3693","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"22672","sourceWorkId":"3693","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"22672","sourceWorkId":"3693","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"22672","sourceWorkId":"3693","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"22672","sourceWorkId":"3693","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"50(自称49)","valueContext":"原文","source":"egs","sourceCharacterId":"22672","sourceWorkId":"3693","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3ed8ed826d64c398e1b21888ef25f2d4cb2dfaa20aab6c31cdc5221671acf62c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1d0642c735304520499e0e99a9b1549b27b38e047d63d5914472919f0b671ca.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24223:10903:5890:1","source":"bangumi"}]},{"characterId":"char_c1217","characterName":"空山 菜摘芽","sourceIds":{"bangumi":[{"characterId":"31694","match":"exact-normalized-name-in-linked-work","subjectId":"24223"}],"egsCharacterIds":["22704"],"vndbCharacterId":"c1217"},"originalCharacterName":"空山 菜摘芽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sophomore at East School. A member of the floriculture and horticulture club. She transferred to the school in the third semester of her freshman year. She is from the Kansai area. She is seen by others as kind, modest, and neat. However, there is a little bit of a strange side to her."},{"spoiler":false,"text":"During the summer vacation, she manages a field adjacent to the swimming pool for practical training by herself, and asks the members of the swimming club if they would like to eat vegetables harvested in the field together. She seems to have special feelings for Hajime."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c1217"},{"segments":[{"spoiler":false,"text":"東校二年。花卉園芸部所属。一年の三学期に転校して"},{"spoiler":false,"text":"きた新顔さん。出身は関西方面。"},{"spoiler":false,"text":"まわりからは優しく控え目で清楚なイメージで見られている。"},{"spoiler":false,"text":"ただしちょっとだけ不思議な蔭あり。"},{"spoiler":false,"text":"夏休みの間、プールに隣接する広い実習用畑を一人で管理"},{"spoiler":false,"text":"しており、畑で穫れた野菜を一緒に食べないか？と水泳部の"},{"spoiler":false,"text":"面々に声をかける。"},{"spoiler":false,"text":"弌に対し何か特別な想いを抱いているようだが……。"}],"source":"egs","sourceCharacterId":"22704","sourceWorkId":"3693","spoiler":false},{"segments":[{"spoiler":false,"text":"东校2年生，女主角之一。花卉园艺部所属。"}],"source":"bangumi","sourceCharacterId":"31694"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"22704","sourceWorkId":"3693","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"22704","sourceWorkId":"3693","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"149 cm","valueContext":null,"source":"egs","sourceCharacterId":"22704","sourceWorkId":"3693","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"22704","sourceWorkId":"3693","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"22704","sourceWorkId":"3693","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"38 kg","valueContext":null,"source":"egs","sourceCharacterId":"22704","sourceWorkId":"3693","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5a2e1c2869a3fd58b1accd271fca9498fc17d50e5483062d68f690e9b858105.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91956de338a6b96e8fd06bb1e844c61e7b9a91420fbfa59fb773f1434e80dc89.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24223:31694:4830:1","source":"bangumi"}]},{"characterId":"char_vndb_c1213","characterName":"最所 弌","sourceIds":{"vndbCharacterId":"c1213"},"originalCharacterName":"最所 弌","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sophomore at East School. A member of the swimming club. He is a mood-maker in his class. He is what is known as a \"funny guy\". He talks to girls in a light-hearted manner, which sometimes makes him look like a playful person."},{"spoiler":false,"text":"His academic performance is not good, and he has to take remedial classes with Mizushima Asa during the summer vacation."},{"spoiler":false,"text":"He is a little curious about Mizushima Asa, who is also a member of the swimming club."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c1213"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59df2a88eebd02e9d1232f61d3cbdd6d23e9510657c21446555d58f24de5e7bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97929c5f95417c06bc4ea9e418c76f89b1ab7997e2b8faa9b493d87b8f31c539.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c1214","characterName":"伊部 本一郎","sourceIds":{"vndbCharacterId":"c1214"},"originalCharacterName":"伊部 本一郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characte