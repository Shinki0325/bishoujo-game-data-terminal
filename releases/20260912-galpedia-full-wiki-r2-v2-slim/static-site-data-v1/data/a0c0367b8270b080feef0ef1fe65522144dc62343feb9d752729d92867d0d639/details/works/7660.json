oice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41271:164291:5021:1","source":"bangumi"}]},{"characterId":"char_bangumi_164292","characterName":"Noayla Mater","sourceIds":{"bangumi":[{"characterId":"164292","match":"source-roster","subjectId":"41271"}]},"originalCharacterName":"Noayla Mater","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0923"},"height":{"reviewState":"source-only","source":"bangumi","value":"167"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"静かな微笑をたたえた美しい女性。 その正体は、ミストルースギルドの長。 かつては自身も凄腕のミストルースとして活躍し、異世界の住民からも一目置かれている。 ギルドの長として、またある時は人間の代表として多忙な毎日を送っているが、サバサバとした明るい性格でその重責を人に全く感じさせない。 年齢は秘密だが、どうやら微妙なお年頃らしい。"}],"source":"bangumi","sourceCharacterId":"164292"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"164292","value":"この街（ゼー・メルーズ）"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"164292","value":"約束にルーズな人"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/3751b4a2a83c0a4aac896ea31ac64b5433fc8f40589d7403aa0f25e2a63f2892.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/136c4304bdd4f1b9a3161cb8f8fd0075f129690fc0fc8cfeae66996bdccb72aa.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"倖月美和","creatorId":"vndb:s1637","sourcePersonId":"vndb:s1637","canonicalEntityId":"vndb:s1637","name":"倖月 美和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41271:164292:11300:1","source":"bangumi"}]},{"characterId":"char_bangumi_164293","characterName":"Anastra Selvatica","sourceIds":{"bangumi":[{"characterId":"164293","match":"source-roster","subjectId":"41271"}]},"originalCharacterName":"Anastra Selvatica","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"16"},"birthday":{"reviewState":"source-only","source":"bangumi","value":"1229"},"height":{"reviewState":"source-only","source":"bangumi","value":"152"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"内気でおとなしい、ミストルースギルドの受付嬢。 しっかりしなくちゃ！という思いが人一倍強く、仕事の時は、特に気を張ってがんばっているが、想定外のことが起きると地が出て、アワアワオロオロになってしまう。 仕事の終わりに彼女がかけてくれる「おつかれさま」の一言は多くのミストルースの心に、癒しを与えてくれる。"}],"source":"bangumi","sourceCharacterId":"164293"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"164293","value":"静かな場所、紅茶"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"164293","value":"がさつな人が苦手"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/025b7f887d046c7f69f27cf889d602f2ee413aa99e037c9b9e7d2260162ed09e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8ae7939b1eb824219922363434d172f3f816b98349963a49afb4922c37aee9a.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"上田純子","creatorId":"egs:creator:11568","sourcePersonId":"egs:creator:11568","canonicalEntityId":"egs:creator:11568","name":"上田純子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41271:164293:68108:1","source":"bangumi"}]},{"characterId":"char_bangumi_36074","characterName":"帕梅拉·伊碧斯","sourceIds":{"bangumi":[{"characterId":"36074","match":"source-roster","subjectId":"11436"},{"characterId":"36074","match":"source-roster","subjectId":"138202"},{"characterId":"36074","match":"source-roster","subjectId":"19494"},{"characterId":"36074","match":"source-roster","subjectId":"2250"},{"characterId":"36074","match":"source-roster","subjectId":"249447"},{"characterId":"36074","match":"source-roster","subjectId":"283338"},{"characterId":"36074","match":"source-roster","subjectId":"310881"},{"characterId":"36074","match":"source-roster","subjectId":"41265"},{"characterId":"36074","match":"source-roster","subjectId":"41271"},{"characterId":"36074","match":"source-roster","subjectId":"41272"}]},"originalCharacterName":"帕梅拉·伊碧斯","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"工作室系列的吉祥物之一。"},{"spoiler":false,"text":"在不同的世界观下，身世、性格稍有不同。"},{"spoiler":false,"text":"--------------------------------------------------"},{"spoiler":false,"text":"A4"},{"spoiler":false,"text":"最早登场是在メッテルブルグ宿屋的某房间，是在那里住了几十年的幽灵。以前那个房间因为有幽灵的传说，所以没人敢住。不过，后来尤蒂入住其中，并告诉大家帕梅拉并不是什么可怕东西的事实，于是那个房间又变得格外受欢迎了起来。"},{"spoiler":false,"text":"A5"},{"spoiler":false,"text":"25年后，原来的幽灵房间要事先预约也变得非常困难。但随着尤蒂回到自己的时代之后，帕梅拉渐渐开始有些觉得寂寞了，表情也没有以前看起来那么快乐。她也正在寻找新的朋友。"},{"spoiler":false,"text":"A6"},{"spoiler":false,"text":"アレーキア洞窟封印龙的祭品，后来成为幽灵后住过下水道、古堡、图书馆……虽然遇见过炼金很多代主角了、经历过很多冒险了，不过总是失忆的特性使得她仍如小白一般单纯天真。"},{"spoiler":false,"text":"A9"},{"spoiler":false,"text":"资料馆的幽灵，以惊吓学生为乐，剧情中加入了主角维恩所在的炼金工房，曾和现任校长是同学。"},{"spoiler":false,"text":"拥有该作最强技能，而且使用门槛很低。"},{"spoiler":false,"text":"A11"},{"spoiler":false,"text":"ロロナが拾ったクマのヌイグルミに宿っていた幽霊。悲壮感を感じさせないおっとりとした性格で後に自分のお店「パメラ屋さん」をオーブンする。"},{"spoiler":false,"text":"A12"},{"spoiler":false,"text":"トトリが住むアランヤ村にあるパメラ屋さんの店主。"},{"spoiler":false,"text":"何年か前にアーランドからやって来て、気づいたら店を開いていた。"},{"spoiler":false,"text":"のんびりぽや～っとした性格で、あまり物事を深く考えたりしない。"},{"spoiler":false,"text":"お店の管理もちゃんとできているのか、やや怪しいところがある。"},{"spoiler":false,"text":"見た目は若いが、年齢は不詳。"},{"spoiler":false,"text":"どうやら昔のことはあまり覚えていないらしい。"},{"spoiler":false,"text":"A13"},{"spoiler":false,"text":"经营量贩店，DLC可加入为战斗角色。"},{"spoiler":false,"text":"A17"},{"spoiler":false,"text":"教会のシスター。"},{"spoiler":false,"text":"おっとり、ほんわかとした性格。"},{"spoiler":false,"text":"常に間延びした口調でしゃべり、周囲を無意識に和ませる。"},{"spoiler":false,"text":"教会の仕事をほぼ一人で切り盛りしている他、街の子供たちを預かる託児所を開いているなど、わりと働き屋。"},{"spoiler":false,"text":"街の老人に対しても子供のように接するなど、彼女の年齢は謎。"},{"spoiler":false,"text":"A18"},{"spoiler":false,"text":"為了修女研修，離開家鄉基爾亨‧貝爾，出來旅行的修女。"},{"spoiler":false,"text":"但是在結束修女的培訓之後，因為買了太多土產導致盤纏都花完的關係，她不得不在萊森貝格經營店鋪工作賺錢。"},{"spoiler":false,"text":"總是從容不迫，也令人摸不著頭緒的個性。"},{"spoiler":false,"text":"A19"},{"spoiler":false,"text":"キルヘン・ベルでシスターを務めていた女性。今はヴェーニュ教会で、グレースとともにシスターの仕事に励んでいる。"},{"spoiler":false,"text":"キルヘン・ベルに戻るはずがなぜかメルヴェイユ行きの馬車に乗ってしまい、今は故郷に帰ることを目標に路銀を貯めている。"},{"spoiler":false,"text":"ぽわわんとした性格で、シスターとしての実力もある、教会でもかなりの人気者。"},{"spoiler":false,"text":"A20"},{"spoiler":false,"text":"在亚尔兹经营【帕梅拉的店】的女性。"},{"spoiler":false,"text":"因为个性温和又带着轻飘飘的感觉，让她的店成为亚尔兹的观光景点之一。似乎是萝乐娜的旧识。"},{"spoiler":false,"text":"A21"},{"spoiler":false,"text":"在库肯港初次登场。主线剧情后期，帕梅拉会作为旅行者在库肯港出现，并伴随一系列相关的支线任务。"},{"spoiler":false,"text":"A22"},{"spoiler":false,"text":"本作在王都初次登场。带着大量布丁，想把布丁推广到全世界。 机缘巧合加入了朵拉莉亚“盗贼”团，帮助盗贼团找到装满金币的宝箱分给了穷人们，盗贼团也帮助了帕梅拉推广布丁的愿望。"}],"source":"bangumi","sourceCharacterId":"36074"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/2304ac8c4bcdb34ff998c6c80281fdb7c6fa967e31baa0fc9baf2219a49d3c1e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afc34afc0557da8bf2a66c4a771137c06db970ca0d77810b85834ceeddb1208e.webp","width":187,"height":256,"source":"static-detail"},"actors":[{"creditedName":"利田優子","creatorId":"vndb:s8724","sourcePersonId":"vndb:s8724","canonicalEntityId":"vndb:s8724","name":"利田優子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41271:36074:15131:1","source":"bangumi"}]},{"characterId":"char_bangumi_59698","characterName":"ハゲル","sourceIds":{"bangumi":[{"characterId":"59698","match":"source-roster","subjectId":"11436"},{"characterId":"59698","match":"source-roster","subjectId":"19494"},{"characterId":"59698","match":"source-roster","subjectId":"2250"},{"characterId":"59698","match":"source-roster","subjectId":"24106"},{"characterId":"59698","match":"source-roster","subjectId":"28755"},{"characterId":"59698","match":"source-roster","subjectId":"41259"},{"characterId":"59698","match":"source-roster","subjectId":"41271"},{"characterId":"59698","match":"source-roster","subjectId":"41272"}]},"originalCharacterName":"ハゲル","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"190"}},"descriptions":[{"segments":[{"spoiler":false,"text":"工作室系列中多次登场的秃头铁匠。"},{"spoiler":false,"text":"在不同的世界观中都很在意自己的秃头。"},{"spoiler":false,"text":"--------------------------------------------------"},{"spoiler":false,"text":"A19　　43歳"},{"spoiler":false,"text":"メルヴェイユで鍛冶屋を営んでいる大柄な男性。その名のとおり、頭頂部は光り輝いている。"},{"spoiler":false,"text":"代々鍛冶屋を生業とする家系で、自らの鍛冶屋を守っていくことにかけては並々ならぬ情熱を注いでいる。"},{"spoiler":false,"text":"陽気で気の良い性格をしており、その名物っぷりは観光ガイドブックにも載るほどである。"}],"source":"bangumi","sourceCharacterId":"59698"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"59698","value":"铁匠"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee4837113b5bf8050b2792d9d9974fb1b119caf50aec519e469167df306d887a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fbf71ce9d57dbf5cca0bea4b28df2233fe85c137c92674d4751caf65de0e7fe.webp","width":132,"height":256,"source":"static-detail"},"actors":[{"creditedName":"河本邦弘","creatorId":"vndb:s2876","sourcePersonId":"vndb:s2876","canonicalEntityId":"vndb:s2876","name":"河本 邦弘","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41271:59698:5213:1","source":"bangumi"}]},{"characterId":"char_bangumi_78524","characterName":"Phenyl Neet","sourceIds":{"bangumi":[{"characterId":"78524","match":"source-roster","subjectId":"41271"}]},"originalCharacterName":"Phenyl Neet","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"12"},"birthday":{"reviewState":"source-only","source":"bangumi","value":"0222"},"height":{"reviewState":"source-only","source":"bangumi","value":"127"},"weight":{"reviewState":"source-only","source":"bangumi","value":"25"}},"descriptions":[{"segments":[{"spoiler":false,"text":"密斯特鲁斯的另一个看板娘。虽然年轻，却工作得得心应手，是个小大人（强装大人的小萝莉，可用酱+SAMA来概括）。即使她说话属于口无遮拦的类型，但没有人真的讨厌她……和同事阿娜（16岁的天然呆）的感情不错，以前辈的气场“主导”着阿娜，不过同年龄的朋友并不多。,小萝莉非常讨厌别人说她矮，一听就炸毛。曾经有个妖精喜欢上了菲妮尔，于是拜托主角们找人，外貌描述中有一条就是身高很矮——最后菲妮尔找上门去踢了妖精一脚又一脚，反而令妖精心中又萌生了新的感情——“啊啊，再踢我一次，再踢我一脚吧~~啊啊，好幸福啊~~”囧"}],"source":"bangumi","sourceCharacterId":"78524"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c72f4d87b9975a316cdea7d04c261a87b07f4d3f7ba87eda2f28c12a32b4e82.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3287f8b2ed8cf0fb5db048823f64a133724a5b8123b5411e59ef046410c09f2.webp","width":225,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成田紗矢香","creatorId":"vndb:s2882","sourcePersonId":"vndb:s2882","canonicalEntityId":"vndb:s2882","name":"成田 紗矢香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41271:78524:4861:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p910","sourceCompanyId":"egs:brand:766","canonicalEntityId":"vndb:p910","name":"ガスト","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:7660:766","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
