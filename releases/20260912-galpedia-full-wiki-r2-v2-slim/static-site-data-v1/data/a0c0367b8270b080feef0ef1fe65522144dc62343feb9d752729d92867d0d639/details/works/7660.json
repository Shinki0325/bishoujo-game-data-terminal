ngumi","value":"67"}},"descriptions":[{"segments":[{"spoiler":false,"text":"物語の主人公。異世界の探索を生業とするミストルースの一員。ギルドでのランクはまだ中の下だが、年に似合わぬ仕事ぶりは周りから高く評価されている。幼い頃に身寄りを亡くしてからは、イリスの家に世話になり、現在は工房で2人で暮らしている。無口でぶっきらぼうな態度のため誤解されがちだが、根は優しい。さしたる目的もない毎日を送り、エルスクーラリオを見つけた時も、ひとり冷めた気持ちでいた。だが、大切な人が過酷な運命に巻き込まれていく姿に、少しづつ心が突き動かされていく。"}],"source":"bangumi","sourceCharacterId":"164284"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"164284","value":"強いて言えば機械いじり"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"164284","value":"騒がしいもの"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5cd19b87b4f15df7bfa020d3c1e6096e22fbf9e009404be4c46c75ede1b87c24.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db9ebb2ec5f33791adc0df5a9ceaeecec99ceac9b924ac8cab6856d7bba4fdda.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐々木望","creatorId":"vndb:s9080","sourcePersonId":"vndb:s9080","canonicalEntityId":"vndb:s9080","name":"佐々木 望","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41271:164284:4188:1","source":"bangumi"}]},{"characterId":"char_bangumi_164285","characterName":"Iris Fortner","sourceIds":{"bangumi":[{"characterId":"164285","match":"source-roster","subjectId":"249447"},{"characterId":"164285","match":"source-roster","subjectId":"41271"}]},"originalCharacterName":"Iris Fortner","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"16"},"birthday":{"reviewState":"source-only","source":"bangumi","value":"0428"},"height":{"reviewState":"source-only","source":"bangumi","value":"158"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"41"}},"descriptions":[{"segments":[{"spoiler":false,"text":"物語のヒロイン。ミストルースの一員で、エッジとは幼なじみ。今の世の中では珍しい錬金術士の家系に育つ。錬金術初心者ながら簡単な調合ができ、街には自宅をかねた工房を構えている。ミストルースとしても錬金術士としてもまだまだ未熟だが、明るく前向きな性格で、周囲を巻き込みながら少しずつ成長していく。あらゆる願いが叶うエルスクーラリオの存在を知ってからは、単純な喜びと興味で、それを追い求めていくことになる。しかしその先には、世界でただひとり、イリスしか果たせない過酷な運命が待ち受けていた。"}],"source":"bangumi","sourceCharacterId":"164285"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"164285","value":"錬金術、動物"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"164285","value":"錬金術を悪く言う人"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03fab9dcb448a2ea930596e4f98554234454605ce94ed4074d954a2eb89be825.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/16a09c9df2839e6c181d295a16a2c79bbb7b72c40dbe6e9934222efd511be648.webp","width":239,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松来未祐","creatorId":"vndb:s1667","sourcePersonId":"vndb:s1667","canonicalEntityId":"vndb:s1667","name":"松来未祐(松木美愛子)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41271:164285:4353:1","source":"bangumi"}]},{"characterId":"char_bangumi_164286","characterName":"Nel Eles","sourceIds":{"bangumi":[{"characterId":"164286","match":"source-roster","subjectId":"41271"}]},"originalCharacterName":"Nel Eles","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"15"},"birthday":{"reviewState":"source-only","source":"bangumi","value":"0608"},"height":{"reviewState":"source-only","source":"bangumi","value":"148"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"うるさいほどに明るく元気な駆け出しのミストルース。遠い街の貴族の生まれだが、家は数年前に没落。ミストルースになって活躍し、家を再興しようと姉と二人でゼー・メルーズにやって来たが、エルスクーラリオを巡る騒動の中で、性格の豹変した姉とはケンカ別れ。異国の街で右も左もわからなくなっていた所をエッジたちに拾われ、行動を共にするようになる。パーティではお笑い担当のムードメーカー。"}],"source":"bangumi","sourceCharacterId":"164286"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"164286","value":"ぬいぐるみ、お菓子"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"164286","value":"怖い話"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/8705a10e056fe10955f9bce4d6236dfb5f662c9d9ea9a5cc3071d92f282d6511.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd868190e5340f3d4ca24094870d8403b6cc92f2ee3fe916a548c9a09f4f73d3.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41271:164286:4714:1","source":"bangumi"}]},{"characterId":"char_bangumi_164287","characterName":"Ewan Kleines","sourceIds":{"bangumi":[{"characterId":"164287","match":"source-roster","subjectId":"41271"}]},"originalCharacterName":"Ewan Kleines","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0131"},"height":{"reviewState":"source-only","source":"bangumi","value":"173"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"錬金術の研究を専門に扱っている、変わり者の学者。 女好きでナルシスト。 年齢、過去の経歴、研究の理由など多くの秘密を抱える。その割にミステリアスな印象にならないのは、言動と性格の軽さゆえか。 イリスのことを一目で気に入り、異世界やエルスクーラリオについて様々な助言を与えてくれる。世界の謎に最も近しい人物。"}],"source":"bangumi","sourceCharacterId":"164287"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"164287","value":"美しい女性、研究"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"164287","value":"男"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01185bace5994ad3d3dba29cdd456471656fcb73f2fd0caf2e8e2e3b34de6587.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/757d50f55ad3e5ec66ae8ca705b7255113138fcb5689b620c26272785693d5ad.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤木賢志","creatorId":"vndb:s16174","sourcePersonId":"vndb:s16174","canonicalEntityId":"vndb:s16174","name":"加藤木賢志","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:41271:164287:4395:1","source":"bangumi"}]},{"characterId":"char_bangumi_164288","characterName":"Ash F Abenstein","sourceIds":{"bangumi":[{"characterId":"164288","match":"source-roster","subjectId":"41271"}]},"originalCharacterName":"Ash F Abenstein","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"21"},"height":{"reviewState":"source-only","source":"bangumi","value":"185"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"74"}},"descriptions":[{"segments":[{"spoiler":false,"text":"世界でも数人しかいない、最高ランクのミストルース。アッシュを知る者は、誰もが彼を世界最強の男だと認めている。幼い頃より才能に恵まれ、望むものは何でも自分の力で手に入れてきた。満たされすぎた能力ゆえに、世界の全てを退屈に感じ、自分を退屈から解き放ってくれる何かを渇望している。異世界にこそ自分の望むものがあるのではとミストルースになったが、そこもやはり退屈な世界だった。エルスクーラリオに隠された、もう1つの意味を知るまでは…人に頼ることを必要としないため、常に1人で行動している孤高の男。"}],"source":"bangumi","sourceCharacterId":"164288"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"164288","value":"強い者"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"164288","value":"退屈な世界"}],"metadataCandidateConfli