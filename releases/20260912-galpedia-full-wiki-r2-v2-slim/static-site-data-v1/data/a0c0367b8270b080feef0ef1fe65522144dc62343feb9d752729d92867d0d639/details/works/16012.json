"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Miyu is Takahisa's younger sister and the quasi-caretaker of the Kanzaki home. Outside of her duties as cook and keeper of order in the house, Miyu is also an idol singer."},{"spoiler":false,"text":"As the keeper of order, Miyu is the responsible member of the trio. Because of this, her word is law in the Kanzaki house, and most outsiders notice that she is like the mother of the family (even if she is the youngest of the three)."},{"spoiler":false,"text":"From Yuumei's review."}],"source":"vndb","sourceCharacterId":"c3271"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd4d84534041d421f4fe3bdf81235bb964c1a6de1ec14c81222bf79dac580320.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23018815270f1ffa483836099708a80d6d27e0dcabe5147b29e44df4a49d4d6f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三菱 アイ","creatorId":"vndb:s416","sourcePersonId":"vndb:s416","canonicalEntityId":"vndb:s416","name":"清水 愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20597","source":"vndb"}]},{"characterId":"char_vndb_c3272","characterName":"清澄 芹夏","sourceIds":{"vndbCharacterId":"c3272"},"originalCharacterName":"清澄 芹夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"206"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Serika is introduced as Miyu's best friend and a rather enthusiastic admirer of Kanna."},{"spoiler":false,"text":"An active, energetic and compulsive girl, Serika is a member of the Megurimiya Academy's tennis club. While most of her screen time is spent following, harassing, and making passes at Kanna, she also holds Takahisa in high regard, and has taken to calling him \"ani\"; one could say that Serika considers herself Takahisa's surrogate younger sister next to Miyu."},{"spoiler":false,"text":"From Yuumei's review."}],"source":"vndb","sourceCharacterId":"c3272"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b2479c4037a4548b97b6804620691d434ad0800abe1ce290dbb3c5c8503ae19.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf75a2051aebf59ac2366a3477d87f8fd49d6e3b26a62970b784b7ce6fb6597c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松田 理沙","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20594","source":"vndb"}]},{"characterId":"char_vndb_c3273","characterName":"帷 千紗","sourceIds":{"vndbCharacterId":"c3273"},"originalCharacterName":"帷 千紗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1126"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"source-only","source":"vndb","value":"161"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chisa is a stoic and seemingly-cold girl that also happens to be Takahisa's childhood friend. Though she has little patience for the fooling around of the other characters (she's usually the one to tell Kanna to quiet down), she will not hesitate to take some playful jabs at the protagonist every once in a while."},{"spoiler":false,"text":"By the time the story begins, Chisa is already loaded with responsibilities between being the president of Takahisa's class, a member of the archery club, on top of working at her family's minshuku (word for a private home that offers tourist lodging). As such, she is often doing her own thing and has little time to waste. Incidentally, she and Takahisa have somewhat grown apart."},{"spoiler":false,"text":"From Yuumei's review."}],"source":"vndb","sourceCharacterId":"c3273"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd1289180997a6211329807534c456cfe484a4d9165312f19c86c26098e31578.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/024def1bedeb24f0b3c62c360a3adc8a330f5adfd1a0e88d09864c62bfc9c54d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村 あやか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20595","source":"vndb"}]},{"characterId":"char_vndb_c3274","characterName":"葉月 深景","sourceIds":{"vndbCharacterId":"c3274"},"originalCharacterName":"葉月 深景","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"912"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"95"},"height":{"reviewState":"source-only","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mikage is a girl that moves to Mizora Island during the prologue. She enrolls into Takahisa's school as a third year student, and is later revealed to be the priestess presiding over the Kamina Shrine."},{"spoiler":false,"text":"Our protagonist first meets Mikage during the welcoming festival that is held for her. Though she seems like a mature (if a little air-headed) girl, the cast quickly learns that Mikage has a tendency to establish her own flow, and more often than not easily sweeps everyone around her into it. Takahisa himself also discovers that she's actually very attentive and astute, to the point where she can easily turn a conversation around by using key words from the other person's argument."},{"spoiler":false,"text":"From Yuumei's review."}],"source":"vndb","sourceCharacterId":"c3274"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2dc79a7df22070cf5ee4ba867cd37fd479dd15f4cf37b966e954b27c11931c8b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8adcd13cf69d315757ac00b3976def59a4808d7af142263e20d44411aedbc732.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風音","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20592","source":"vndb"}]},{"characterId":"char_vndb_c50103","characterName":"隠神 穂乃里","sourceIds":{"vndbChara