metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"超ドSな高天原の女王。"},{"spoiler":false,"text":"カリスマ高く、自他共に認めるほどのサディスティックな性格をしている。"},{"spoiler":false,"text":"それゆえに昔から多くの神々から畏れられていたらしい。"},{"spoiler":false,"text":"大神照子＜オオガミテルコ＞という偽名を用い、配下の神二柱と共に稚彦の学園に在籍し、稚彦を七色の毒舌で虐げている姿がよく目撃されている。"},{"spoiler":false,"text":"以前より稚彦のことを知っているようなことを仄めかすが…………？"},{"spoiler":false,"text":"「このたわけ。妾を口説くなど二千年遅いわ」"}],"source":"egs","sourceCharacterId":"3459","sourceWorkId":"15325","spoiler":false},{"segments":[{"spoiler":false,"text":"超ドSな高天原の女王。"},{"spoiler":false,"text":"カリスマ高く、自他共に認めるほどのサディスティックな性格をしている。"},{"spoiler":false,"text":"それゆえに昔から多くの神々から畏れられていたらしい。"},{"spoiler":false,"text":"大神照子（おおがみ てるこ） という偽名を用い、配下の神二柱と共に稚彦の学園に在籍し、稚彦を七色の毒舌で虐げている姿がよく目撃されている。"},{"spoiler":false,"text":"以前より稚彦のことを知っているようなことを仄めかすが…………？"}],"source":"bangumi","sourceCharacterId":"13408"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4c742d3ba684bb0b54bb418d0626fccca047a27ba0d0930c01037d3d9bdca8d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fdab07b1605497ff832e07997cf2f1df152852eeed36d10914675269febcad4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:18969:13408:4432:1","source":"bangumi"}]},{"characterId":"char_c4612","characterName":"建御雷神","sourceIds":{"bangumi":[{"characterId":"13409","match":"exact-normalized-name-in-linked-work","subjectId":"18969"}],"egsCharacterIds":["3460"],"vndbCharacterId":"c4612"},"originalCharacterName":"建御雷神","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","meta