しており、女の子らしい服装や行動には照れがある。"},{"spoiler":false,"text":"性に関しては多少の知識があり、好奇心が強いためかなりの興味を持っている。"},{"spoiler":false,"text":"だが気位の高さ故、オナニー経験はあるが、実際の男性経験は皆無。"},{"spoiler":false,"text":"主人公のクロエにほのかな恋心を抱いている。"}],"source":"bangumi","sourceCharacterId":"52459"}],"profileFacts":[{"label":"年龄（本版本）","value":"21 岁","valueContext":null,"source":"egs","sourceCharacterId":"14507","sourceWorkId":"12988","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"14507","sourceWorkId":"12988","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"14507","sourceWorkId":"12988","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"14507","sourceWorkId":"12988","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"14507","sourceWorkId":"12988","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"waist":[{"comparisonValue":"58","source":"vndb","sourceCharacterId":"c48023","value":"58"},{"comparisonValue":"58","scope":"sourceWork","source":"egs","sourceCharacterId":"14507","sourceWorkId":"12988","value":"58"},{"comparisonValue":"57","source":"bangumi","sourceCharacterId":"52459","value":"57"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad2bbcc65e56ede57ede7b2bc2731d1cc65579aab1eefcabe88da24dd378e551.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81fe50d2195dfce3ae6b1e1793851922a80f19e106701fb0a3550f28d051aad7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤 麗羅","creatorId":"vndb:s12697","sourcePersonId":"vndb:s12697","canonicalEntityId":"vndb:s12697","name":"佐藤 麗羅","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19014","s