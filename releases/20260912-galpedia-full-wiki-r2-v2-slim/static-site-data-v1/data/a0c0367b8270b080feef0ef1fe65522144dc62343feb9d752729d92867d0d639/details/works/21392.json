":false,"text":"He's weak when it comes to things that he doesn't expect."},{"spoiler":false,"text":"He has a complex about his childlike face and unruly hair."},{"spoiler":false,"text":"He's Tomu's big brother and often dotes on him."},{"spoiler":false,"text":"His flower is the Marguerite."}],"source":"vndb","sourceCharacterId":"c27352"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9adc4df8d1f66bfd345a3b0500fd4aa3f637c01ed50a34e08a115a61d6d5ee3e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e7e90f840c056af2daba43b9b76d01c580c800a54df61f0dcc2d04a24064528.webp","width":202,"height":256,"source":"static-detail"},"actors":[{"creditedName":"置鮎 龍太郎","creatorId":"vndb:s747","sourcePersonId":"vndb:s747","canonicalEntityId":"vndb:s747","name":"置鮎 龍太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47661","source":"vndb"}]},{"characterId":"char_vndb_c27353","characterName":"土夢","sourceIds":{"vndbCharacterId":"c27353"},"originalCharacterName":"土夢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"29"},"birthday":{"reviewState":"source-only","source":"vndb","value":"303"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He's a nationally popular idol who sings and stars in dramas and on variety shows."},{"spoiler":false,"text":"Everyone loves him for his bright personality with no hidden sides."},{"spoiler":false,"text":"He has a quick response to everything and is surprisingly reliable, though he does have a spoiled side."},{"spoiler":false,"text":"He's Ryusei's little brother and he wants to be more relied upon."},{"spoiler":false,"text":"His flower is the Tulip."}],"sou