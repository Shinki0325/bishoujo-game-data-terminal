l":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:217806","source":"vndb"}]},"cast":[{"characterId":"char_c155457","characterName":"虹野 夢羽","sourceIds":{"bangumi":[{"characterId":"180098","match":"exact-normalized-name-in-linked-work","subjectId":"561591"}],"egsCharacterIds":["28141"],"vndbCharacterId":"c155457"},"originalCharacterName":"虹野 夢羽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"height":{"reviewState":"no-conflict","source":"vndb","value":"139"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who has just enrolled at the all-girls boarding school, Tensei Academy for Girls."},{"spoiler":false,"text":"She’s cheerful, a little clumsy, and full of energy—never one to give up. Always optimistic, she overflows with dreams and hope."},{"spoiler":false,"text":"Though she occasionally gets discouraged, she quickly bounces back thanks to her relentlessly positive mindset. She's your textbook main heroine type."},{"spoiler":false,"text":"Sometimes, her mind slips into a world of fantasy (or delusion), and once she's in, she won’t come back to reality until someone calls her out of it."},{"spoiler":false,"text":"\"That takes me back... I’ve grown distant from her now, but what was her name again…?\""}],"source":"vndb","sourceCharacterId":"c155457"},{"segments":[{"spoiler":false,"text":"全寮制の「天星学園」に入学してきた少女。"},{"spoiler":false,"text":"性格は明るく、少しおっちょこちょいで、くじけない、元気。"},{"spoiler":false,"text":"常に前向きで、夢と希望に満ち満ちている。"},{"spoiler":false,"text":"稀に落ち込むことがあるが、常にプラス思考の女の子。"},{"spoiler":false,"text":"エンブレイズ・ユメハに変身する。"}],"source":"egs","sourceCharacterId":"28141","sourceWorkId":"38750","spoiler":false},{"segments":[{"spoiler":false,"text":"「懐かしいなぁ……あの子とは疎遠になっちゃったけど、名前……なんだっけ……？」"}],"source":"bangumi","sourceCharacterId":"180098"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4cd2d5e1b3f3238cde2ea7992981192dcc2a3b071076aff97c88599b2888873.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e821087978158ea4f96a57a31ff2e0ca92a1fc0e1fe7ff7d45b1c2f7ef7efa6c.webp","width":182,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中理々","creatorId":"vndb:s1977","sourcePersonId":"vndb:s1977","canonicalEntityId":"vndb:s1977","name":"田中 理々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:561591:180098:17081:1","source":"bangumi"}]},{"characterId":"char_c155458","characterName":"月森 叶","sourceIds":{"bangumi":[{"characterId":"180099","match":"exact-normalized-name-in-linked-work","subjectId":"561591"}],"egsCharacterIds":["28142"],"vndbCharacterId":"c155458"},"originalCharacterName":"月森 叶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"37"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A magical girl who goes by the name \"Embrace.\""},{"spoiler":false,"text":"She lives in the same dorm as Yumeha and is also her classmate."},{"spoiler":false,"text":"Her personality is best described as cool-headed—or perhaps just overly serious."},{"spoiler":false,"text":"But it’s not that she’s a stick-in-the-mud or a bookworm. Rather, she carries the weight of a painful parting from her past—something that shaped her deeply."},{"spoiler":false,"text":"\"Sure, maybe I can’t do this alone..."},{"spoiler":false,"text":"But you were blessed and born to fulfill others’ hopes too, weren’t you—"},{"spoiler":false,"text":"Magical Girl Empress!\""}],"source":"vndb","sourceCharacterId":"c155458"},{"segments":[{"spoiler":false,"text":"夢羽が目撃した魔法少女の一人。"},{"spoiler":false,"text":"謎の敵「ラルファ」と戦いを繰り広げている。"},{"spoiler":false,"text":"夢羽と同じ寮に住み、クラスメイトでもある。"},{"spoiler":false,"text":"どこか周りから距離を置いているふしがある。"},{"spoiler":false,"text":"エンブレイス・キョウに変身する。"}],"source":"egs","sourceCharacterId":"28142","sourceWorkId":"38750","spoiler":false},{"segments":[{"spoiler":false,"text":"「確かに、私一人じゃ無理かもしれない……でも、あなただって人の希望を叶えるために祝福され、生まれてきた 魔法少女エンプレスじゃない！」"}],"source":"bangumi","sourceCharacterId":"180099"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7a54e65cb59e128535d6900fa4baa5800ed99fef428ce8701fac764e05078c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/353b77c3d81bd93164ce78a62db1a0eea8554777a30005603e1250354a6a3e51.webp","width":112,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井ありす","creatorId":"vndb:s1626","sourcePersonId":"vndb:s1626","canonicalEntityId":"vndb:s1626","name":"櫻井 ありす","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:561591:180099:19213:1","source":"bangumi"}]},{"characterId":"char_c155459","characterName":"明刻 希望","sourceIds":{"bangumi":[{"characterId":"180100","match":"exact-normalized-name-in-linked-work","subjectId":"561591"}],"egsCharacterIds":["28143"],"vndbCharacterId":"c155459"},"originalCharacterName":"明刻 希望","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"height":{"reviewState":"no-conflict","source":"vndb","value":"142"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"36"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A magical girl who opposes Yumeha and Kyo, having aligned herself with the Ralpha side."},{"spoiler":false,"text":"\"So you're asking me to cooperate?"},{"spoiler":false,"text":"For the two of us to walk hand in hand toward ruin?"},{"spoiler":false,"text":"No—because that’s wrong. That’s exactly why I’m trying to set things right.\""}],"source":"vndb","sourceCharacterId":"c155459"},{"segments":[{"spoiler":false,"text":"物腰は柔らかく優しい印象だが、叶と敵対しラルファ側に与している。"},{"spoiler":false,"text":"エンプレス・ノゾミに変身する。"}],"source":"egs","sourceCharacterId":"28143","sourceWorkId":"38750","spoiler":false},{"segments":[{"spoiler":false,"text":"「だから、私にも協力しろと？そして二人して滅びを迎えろと？それが間違っているから、私はそれを正そうとしているの」"}],"source":"bangumi","sourceCharacterId":"180100"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/253466eef83de1a806c1f21f900252ea8bf68f300c8825662d2235fe8dcf1d19.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/faf7ffab496627dd6e34c2c9192befcea308ddbe14ba32d024f7b89775e61cbb.webp","width":112,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:561591:180100:6349:1","source":"bangumi"}]},{"characterId":"char_c155751","characterName":"花崎 美咲","sourceIds":{"bangumi":[{"characterId":"217676","match":"exact-normalized-name-in-linked-work","subjectId":"561591"}],"egsCharacterIds":["28144"],"vndbCharacterId":"c155751"},"originalCharacterName":"花崎 美咲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"height":{"reviewState":"no-conflict","source":"vndb","value":"140"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"41"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A classmate of Yumeha’s who shares the same dorm room with her."},{"spoiler":false,"text":"She has a somewhat reserved personality, but gets along well with Yumeha, who transferred in."},{"spoiler":false,"text":"\"Yume-chan, you're so easily moved. I never get tired of watching you.\""}],"source":"vndb","sourceCharacterId":"c155751"},{"segments":[{"spoiler":false,"text":"夢羽のクラスメイトで、寮では夢羽と同じ部屋。"},{"spoiler":false,"text":"やや控えめな性格だが、転入してきた夢羽と仲がよい。"}],"source":"egs","sourceCharacterId":"28144","sourceWorkId":"38750","spoiler":false},{"segments":[{"spoiler":false,"text":"「夢ちゃんは感激屋さんだね。見てて飽きないなぁ」"},{"spoiler":false,"text":"原画：森山しじみ"},{"spoiler":false,"text":"夢羽のクラスメイトで、寮では夢羽と同じ部屋。"},{"spoiler":false,"text":"やや控えめな性格だが、転入してきた夢羽と仲がよい。"}],"source":"bangumi","sourceCharacterId":"217676"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/004381968fe8163ac4418cf3026e215881500c6b6ebcb2f974dca21eed9116ac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cc4f5da72fb5827705aa3b8892f3cf5d2cbf929ab3fb53b77e132c07349e872.webp","width":103,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p7501","sourceCompanyId":"egs:brand:5692","canonicalEntityId":"vndb:p7501","name":"CHAOS-R","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:38750:5692","source":"egs"},{"companyId":"vndb:p7501","sourceCompanyId":"vndb:p7501","canonicalEntityId":"vndb:p7501","name":"CHAOS-R","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:150896:v58310","source":"vndb"},{"c