relationId":"vndb:vn-staff:8748","source":"vndb"},{"creditedName":"真理絵","creatorId":"vndb:s47","sourcePersonId":"vndb:s47","canonicalEntityId":"vndb:s47","name":"真理絵","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:8749","source":"vndb"},{"creditedName":"茶太","creatorId":"vndb:s203","sourcePersonId":"vndb:s203","canonicalEntityId":"vndb:s203","name":"茶太","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:8750","source":"vndb"},{"creditedName":"片霧 烈火","creatorId":"vndb:s419","sourcePersonId":"vndb:s419","canonicalEntityId":"vndb:s419","name":"片霧 烈火","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:8751","source":"vndb"},{"creditedName":"瀬之本 久史","creatorId":"vndb:s1414","sourcePersonId":"vndb:s1414","canonicalEntityId":"vndb:s1414","name":"瀬之本 久史","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:8753","source":"vndb"}]},"cast":[{"characterId":"char_c37740","characterName":"敷島 桜","sourceIds":{"bangumi":[{"characterId":"11967","match":"exact-normalized-name-in-linked-work","subjectId":"11260"}],"egsCharacterIds":["25057"],"vndbCharacterId":"c37740"},"originalCharacterName":"敷島 桜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同じ予備校に通う浪人生にして、高校時代の同級生。"},{"spoiler":false,"text":"高校時代は成績優秀で、彼女曰く、本来なら本命大学に合格していたが、受験当日、風邪を引いてしまい、それが原因で落ちてしまい、予備校に通うことになった。"},{"spoiler":false,"text":"都会的な活発な女の子で、小さなことにこだわらず、気さくで社交的。"},{"spoiler":false,"text":"また勝気で口も達者な上に、ツンデレ。"},{"spoiler":false,"text":"誰とでもすぐに仲良くなるが、気を許して付き合っている友人はほんのわずかしかいない。"}],"source":"egs","sourceCharacterId":"25057","sourceWorkId":"8118","spoiler":false},{"segments":[{"spoiler":false,"text":"精神奕奕而且成绩优秀，与直也同年级的浪人学生。"},{"spoiler":false,"text":"除非考试当天感冒，否则绝对会考进大学的都市活泼美少女。拥有都市人的爽朗的性格。"},{"spoiler":false,"text":"做事不拘小节而机灵，因而很容易亲近别人，不过，对她而言真正重要的人只是那几位朋友而已。"},{"spoiler":false,"text":"做事不拖泥带水、说话毫无漏洞的厉害人物。"}],"source":"bangumi","sourceCharacterId":"11967"}],"profileFacts":[{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"25057","sourceWorkId":"8118","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"47 kg","valueContext":null,"source":"egs","sourceCharacterId":"25057","sourceWorkId":"8118","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d47ded98e9b7de6206aabdd23e3d2aff0cd1776bc1ac9e1ebfa2aab02e974cc7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/831a9b8d7393c3e79dea01f5d36c26e0f7fcc70ed1ce10f09b5a44df8535d390.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11260:11967:4432:1","source":"bangumi"}]},{"characterId":"char_c37741","characterName":"南野 泉","sourceIds":{"bangumi":[{"characterId":"11968","match":"exact-normalized-name-in-linked-work","subjectId":"11260"}],"egsCharacterIds":["25058"],"vndbCharacterId":"c37741"},"originalCharacterName":"南野 泉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"田舎の旅館で仲居をしている主人公の幼馴染。"},{"spoiler":false,"text":"おっとり天然ボケボケ倒しのマイペースな女の子。"},{"spoiler":false,"text":"また人を疑うことを知らない純粋さを持ち、世間知らずな行動が目立つ。"},{"spoiler":false,"text":"しかし、旅館の仕事は完璧にこなし、掃除に関してはチリ一つ残さない。"},{"spoiler":false,"text":"手際よりも完成度を求めるタイプ。"},{"spoiler":false,"text":"周囲は、知らぬ内に彼女のマイペースに巻き込まれているという……。"}],"source":"egs","sourceCharacterId":"25058","sourceWorkId":"8118","spoiler":false},{"segments":[{"spoiler":false,"text":"大方而天生愚笨的旅馆女侍应。"},{"spoiler":false,"text":"经常比人慢一拍子，不如说她是个只有语风戏云之心的吟遊詩人。"},{"spoiler":false,"text":"但是，不知为何总是将旅馆的工作圆满完成，扫除的地方一尘不染的哲人。"},{"spoiler":false,"text":"别人说什么也会相信，行动不懂世故。"},{"spoiler":false,"text":"做事但求快乐不计效率，但求完成不论方法。说话也好反映也好慢人一拍子，且容易钻进牛角尖。"},{"spoiler":false,"text":"以这样的做事方式而被周围的人所需要。"}],"source":"bangumi","sourceCharacterId":"11968"}],"profileFacts":[{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"25058","sourceWorkId":"8118","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"40 kg","valueContext":null,"source":"egs","sourceCharacterId":"25058","sourceWorkId":"8118","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/3849c78816d0b9494c7467ff6abafcbaf69414cb76fcb00a9178eae00e7f25cf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91a468225c22e69ce78ce24e640f9eb55c26bb5b0c096b8db92bd98bdedb6309.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11260:11968:4689:1","source":"bangumi"}]},{"characterId":"char_c37742","characterName":"飯塚 美由紀","sourceIds":{"bangumi":[{"characterId":"11969","match":"exact-normalized-name-in-linked-work","subjectId":"11260"}],"egsCharacterIds":["25059"],"vndbCharacterId":"c37742"},"originalCharacterName":"飯塚 美由紀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の義妹。女子校生。"},{"spoiler":false,"text":"明るく素直で、主人公に子犬のような懐きっぷりを見せる可愛らしい女の子。"},{"spoiler":false,"text":"一人暮らしの主人公を心配し、海外転勤中の両親の元から、主人公の家に突然やってきて居座る。"},{"spoiler":false,"text":"家事全般を得意としていて、ややだらしない男然とした主人公の生活にうるおいをもたらす。"},{"spoiler":false,"text":"知り合った桜に憧れを抱くようになり、次第に仲良くなった。泉とは幼い頃から顔見知りで仲良し。"},{"spoiler":false,"text":"でも主人公が一番好き。"}],"source":"egs","sourceCharacterId":"25059","sourceWorkId":"8118","spoiler":false},{"segments":[{"spoiler":false,"text":"怀念主人公的女子校生，义妹。明快坦率仿如小狗。"},{"spoiler":false,"text":"因为担心主人公的生活，从到了海外工作的双亲家里，突然搬到主人公的家中。"},{"spoiler":false,"text":"家务全能，接管了只会一个臭男人生活的直也的他的家务。"},{"spoiler":false,"text":"与桜会面以后就希望结为好朋友。与泉从小时侯开始就是好朋友。但是最喜欢的人是哥哥。"}],"source":"bangumi","sourceCharacterId":"11969"}],"profileFacts":[{"label":"身高（本版本）","value":"147 cm","valueContext":null,"source":"egs","sourceCharacterId":"25059","sourceWorkId":"8118","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"39 kg","valueContext":null,"source":"egs","sourceCharacterId":"25059","sourceWorkId":"8118","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13a2f98ef2c43e574e21ed2669c273481f5b09ad49ca0e6c30ac5af88b081923.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37d65700b23ce260a555ee3bcbbcdcab2576bfb20586b624207bea4b242a6791.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11260:11969:5020:1","source":"bangumi"}]},{"characterId":"char_c37750","characterName":"日比谷 富音","sourceIds":{"bangumi":[{"characterId":"11973","match":"exact-normalized-name-in-linked-work","subjectId":"11260"}],"egsCharacterIds":["25063"],"vndbCharacterId":"c37750"},"originalCharacterName":"日比谷 富音","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"空子の旅館で働く仲居。"},{"spoiler":false,"text":"何故か、メイドのコスプレをしており、同人誌制作、乙女ゲームなどが趣味のオタク眼鏡ッ娘。"},{"spoiler":false,"text":"都会に憧れる地方オタクで、年に二回の聖地巡礼が至高の悦び。"},{"spoiler":false,"text":"メイド服はお客に意外な人気を博すが、生来のドジさ加減が、余計な仕事を増やすことになり、戦力になっていない様子。"},{"spoiler":false,"text":"富音（ふね）という古風過ぎる名前にコンプレックスを持ち、サマンサを自称している。"}],"source":"egs","sourceCharacterId":"25063","sourceWorkId":"8118","spoiler":false},{"segments":[{"spoiler":false,"text":"旅館里唯一一个以女仆装COSPLAY打扮的女侍应，奇怪的御宅族少女。"},{"spoiler":false,"text":"憧憬都市的乡下御宅族，每年都会开心地巡回两次圣地。"},{"spoiler":false,"text":"尽管由于穿着女仆装而意外地获得人气，然而遗憾的是这并不足以构成战力。"},{"spoiler":false,"text":"嫌弃フネ这一带有古老风味的自己的名字，自称サマンサ。"}],"source":"bangumi","sourceCharacterId":"11973"}],"profileFacts":[{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"25063","sourceWorkId":"8118","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"40 kg","valueContext":null,"source":"egs","sourceCharacterId":"25063","sourceWorkId":"8118","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9fd129b77cf847bf3de7ff238813a0f9c8221fef1e0b8ee8265ce8fa0d446ab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/0397ece05271a2daeffd6bdb8f56e18cadd4ea9c92fb29cbefcb72cc4e7584f2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田佳代","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11260:11973:6038:1","source":"bangumi"}]},{"characterId":"char_c37753","characterName":"久我島 美玲","sourceIds":{"bangumi":[{"characterId":"11970","match":"exact-normalized-name-in-linked-work","subjectId":"11260"}],"egsCharacterIds":["25060"],"vndbCharacterId":"c37753"},"originalCharacterName":"久我島 美玲","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の憧れの女性。"},{"spoiler":false,"text":"進学前は、桜、健太、政宗、そして主人公と釣るんで一緒に遊んでいた。"},{"spoiler":false,"text":"彼女自身は、大学に合格し、現在は女子大生。"},{"spoiler":false,"text":"優しくクールビューティーで、桜をより洗練した都会的な女性。"},{"spoiler":false,"text":"進学前の清楚さが薄れ、やや派手になっているが、その美しさは変わらない。"},{"spoiler":false,"text":"主人公は彼女と同じ大学に進学することを目標にしている。"}],"source":"egs","sourceCharacterId":"25060","sourceWorkId":"8118","spoiler":false},{"segments":[{"spoiler":false,"text":"直也所憧憬的女性，与桜、健太、政宗、直也一起组成升学五人组。"},{"spoiler":false,"text":"体贴的COOL-BEAUTY比桜更要都市化。以前是清纯系，现在稍稍会化装打扮。"},{"spoiler":false,"text":"直也的目标是与她上同一间大学。"}],"source":"bangumi","sourceCharacterId":"11970"}],"profileFacts":[{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"25060","sourceWorkId":"8118","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"45 kg","valueContext":null,"source":"egs","sourceCharacterId":"25060","sourceWorkId":"8118","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7aa391ee3f82e8ac481290c5864f2522eb25e4636f90a9d35363355bd8ce45ad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0bb87f019b6c4e6715d616063f7a6c3bd37d8d28db5ac51193ee2c5a38eef625.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11260:11970:4714:1","source":"bangumi"}]},{"characterId":"char_c37754","characterName":"桐谷 桜花","sourceIds":{"bangumi":[{"characterId":"11971","match":"exact-normalized-name-in-linked-work","subjectId":"11260"}],"egsCharacterIds":["25061"],"vndbCharacterId":"c37754"},"originalCharacterName":"桐谷 桜花","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が通う予備校の先輩。"},{"spoiler":false,"text":"既に三浪しており、予備校の全てを把握する「女帝」と呼ばれている。"},{"spoiler":false,"text":"常に明るくハイテンションで、楽しいことをが何よりも大好きな姉御肌の女性。"},{"spoiler":false,"text":"頭は……だが、スタイル抜群で、魅惑の巨乳の持ち主。"},{"spoiler":false,"text":"尻軽女に見えて、実は身持ちが堅く、学費も自分で稼ぎ、大学合格後の資金すらも貯金している、非常に真面目で健全な暮らしをしている。"}],"source":"egs","sourceCharacterId":"25061","sourceWorkId":"8118","spoiler":false},{"segments":[{"spoiler":false,"text":"人称预备学校的女帝。因为三次考试失败而充分掌握了补习学校的魅力美女。"},{"spoiler":false,"text":"不允许别人提及胸部以及她那差透了的成绩。快乐至上。"},{"spoiler":false,"text":"全部学费由自己支付，为了大学合格后有备用的钱而在便利店以及快餐店努力工作中。"},{"spoiler":false,"text":"貌似在烟花之地工作，实际她品行良好，那才是她的真面目。"},{"spoiler":false,"text":"过着非常健全的生活。是个吸引着直也他们的御姐。"}],"source":"bangumi","sourceCharacterId":"11971"}],"profileFacts":[{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"25061","sourceWorkId":"8118","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"55 kg","valueContext":null,"source":"egs","sourceCharacterId":"25061","sourceWorkId":"8118","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1eebab48ca71a630715b493a4d8dd0d363064f31ba09bdf8bb25e9fb78ad1674.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a115bfc2cbba28cfbc2d5cdafd50d7209576961374f8a56d3106b584464d8ef6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"如月美琴","creatorId":"vndb:s1012","sourcePersonId":"vndb:s1012","canonicalEntityId":"vndb:s1012","name":"如月 美琴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11260:11971:6217:1","source":"bangumi"}]},{"characterId":"char_c37755","characterName":"南野 空子","sourceIds":{"bangumi":[{"characterId":"11972","match":"exact-normalized-name-in-linked-work","subjectId":"11260"}],"egsCharacterIds":["25062"],"vndbCharacterId":"c37755"},"originalCharacterName":"南野 空子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Izumi's stepmother."}],"source":"vndb","sourceCharacterId":"c37755"},{"segments":[{"spoiler":false,"text":"泉の父親が再婚した若干28歳の美人女将。"},{"spoiler":false,"text":"夫は既に他界し、その夫の残した旅館を細腕一本で切り盛りしている。"},{"spoiler":false,"text":"世間知らずな娘・泉の将来を心配する優しい母親だが、主人公にとっては自分を我侭に利用する鬼女将の印象が強い。"},{"spoiler":false,"text":"主人公と泉を結婚させて、旅館の将来を安定させようと目論んでいるが、最悪、自分と結婚すればいい、と思っている。"}],"source":"egs","sourceCharacterId":"25062","sourceWorkId":"8118","spoiler":false},{"segments":[{"spoiler":false,"text":"与泉的父亲结婚的大约28岁左右的美女旅馆老板娘。泉的父亲也业已下了黄泉。"},{"spoiler":false,"text":"凭借一介女流之力将旅馆搞得越发兴旺起来的经营者，如世人所知的担心自己儿女的体贴入微的母亲。"},{"spoiler":false,"text":"对主人公来说，是个物尽我用地利用直也的鬼老板娘。武器主要是美色。"},{"spoiler":false,"text":"策划着让泉与直也结婚，从而让旅馆的将来安定下来，最差的话也可以和自己结婚、从而安定下来的策士。"}],"source":"bangumi","sourceCharacterId":"11972"}],"profileFacts":[{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"25062","sourceWorkId":"8118","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"51 kg","valueContext":null,"source":"egs","sourceCharacterId":"25062","sourceWorkId":"8118","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/9550a1f934a4c7159bf7e8666ec6d67e8a10b30bdcde0ea10eb9ba84f3422caf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe725f1c4129427aba4fee484a6e317f729516ca388495690f641ffc6a4093e4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11260:11972:4489:1","source":"bangumi"}]},{"characterId":"char_vndb_c112489","characterName":"飯塚 直也","sourceIds":{"vndbCharacterId":"c112489"},"originalCharacterName":"飯塚 直也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"character