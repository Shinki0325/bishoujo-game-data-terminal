741d106c99153b5eb1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:377406:109343:6409:1","source":"bangumi"}]},{"characterId":"char_c55687","characterName":"菫姫","sourceIds":{"bangumi":[{"characterId":"109344","match":"exact-normalized-name-in-linked-work","subjectId":"377406"}],"egsCharacterIds":["26110"],"vndbCharacterId":"c55687"},"originalCharacterName":"菫姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"201"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"71"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"37"}},"descriptions":[{"segments":[{"spoiler":false,"text":"蝶よ花よと大事に育てられた平安貴族の三の姫。"},{"spoiler":false,"text":"教養人で頭も悪くないのだが、情報処理速度がきょくたんに遅いために、ポンコツ＆ボンクラと誤解されがち。"},{"spoiler":false,"text":"天然気質で、おっとりした物腰の雅な性格。"},{"spoiler":false,"text":"その育ちの良さ故に、些細なことでショックを受けて気絶する。"}],"source":"egs","sourceCharacterId":"26110","sourceWorkId":"6581","spoiler":false},{"segments":[{"spoiler":false,"text":"平安貴族の姫君。"},{"spoiler":false,"text":"現代の美的感覚からするとかなりの美形だが、平安人からするとあまり美人ではないらしく、男たちは歌のひとつも送ってこない寂しい境遇。けれど、本人はそれほど深刻には考えておらず、ひがな一日漢文や当時流行の書などを読んで過ごしている。"},{"spoiler":false,"text":"教養に溢れた才女なのだが、情報の処理速度が遅く、ポンコツな印象を与えてしまうことがある。"},{"spoiler":false,"text":"また、些細なショックですぐに気絶してしまう。"},{"spoiler":false,"text":"乳母子（めのとご）の夕日のことを強く慕っており、何かと頼りにしている。"}],"source":"bangumi","sourceCharacterId":"109344"}],"profileFacts":[{"label":"胸围（本版本）","value":"71 cm","valueContext":null,"source":"egs","sourceCharacterId":"26110","sourceWorkId":"6581","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"148 cm","valueContext":null,"source":"egs","sourceCharacterId":"26110","sourceWorkId":"6581","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"26110","sourceWorkId":"6581","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"26110","sourceWorkId":"6581","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"37 kg","valueContext":null,"source":"egs","sourceCharacterId":"26110","sourceWorkId":"6581","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/841d64ca2ac50ec1b836f53110baa4ceaf2f825b70a176b31049d210e94a59de.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0fb2aac6f097b8619b10e62873d4d112a19607ee2a42d6682a810fc54e3f1f64.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:377406:109344:4830:1","source":"bangumi"}]},{"characterId":"char_c55688","characterName":"夕日","sourceIds":{"bangumi":[{"characterId":"109345","match":"exact-normalized-name-in-linked-work","subjectId":"377406"}],"egsCharacterIds":["26111"],"vndbCharacterId":"c55688"},"originalCharacterName":"夕日","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"122"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"菫姫の乳母子（めのとご）。"},{"spoiler":false,"text":"姫のことは実の妹のように可愛がっている。"},{"spoiler":false,"text":"勇気凛々で、やる気も十分だが、非力で肝心なところでドジる。"},{"spoiler":false,"text":"また融通の利かない堅物だが、何処か抜けている。"},{"spoiler":false,"text":"さらには熱くなると、判断能力を失う。"},{"spoiler":false,"text":"それでも身軽さとしぶとさ、執念深さは他の追随を許さない。"}],"source":"egs","sourceCharacterId":"26111","sourceWorkId":"6581","spoiler":false},{"segments":[{"spoiler":false,"text":"菫姫の乳母子（めのとご）であり、忠臣である。いい年であるというのに、太刀を佩いて武官の真似事などをしている。"},{"spoiler":false,"text":"勇気凛々、やる気は十分。けれど非力。そしてドジ。ただ、幼い頃より野山を駆け回っていたので、運動能力とサバイバビリティは十分。口喧しい委員長気質で、融通が利かない。けれど案外抜けている。"},{"spoiler":false,"text":"年がら年中怒っているような感じだが、菫姫に対してだけはどこまでも優しい。"}],"source":"bangumi","sourceCharacterId":"109345"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"26111","sourceWorkId":"6581","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"26111","sourceWorkId":"6581","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"26111","sourceWorkId":"6581","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"26111","sourceWorkId":"6581","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"43 kg","valueContext":null,"source":"egs","sourceCharacterId":"26111","sourceWorkId":"6581","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3cab024efc45a411be91956cefd76982f68148fb9b2ea239f4154c8c07cd016.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0911819e8c45f8ec0a3ab832645591865a3c962b8d14b969cbae5d66c9ab7e7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結下みちる","creatorId":"vndb:s794","sourcePersonId":"vndb:s794","canonicalEntityId":"vndb:s794","name":"結下 みちる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:377406:109345:4705:1","source":"bangumi"}]},{"characterId":"char_c55689","characterName":"出水 祭","sourceIds":{"bangumi":[{"characterId":"109346","match":"exact-normalized-name-in-linked-work","subjectId":"377406"}],"egsCharacterIds":["26109"],"vndbCharacterId":"c55689"},"originalCharacterName":"出水 祭","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"101"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"62"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"上品な外見ながら、内面は姐御肌のチャキチャキ江戸っ子。"},{"spoiler":false,"text":"言葉使いが乱暴で厳しいところもあるが、包容力があり、クラスメイトや後輩から慕われている。"},{"spoiler":false,"text":"音楽好きでギターが趣味。その腕前もなかなかのもので、カバーだけでなく自作曲までも手掛ける。"}],"source":"egs","sourceCharacterId":"26109","sourceWorkId":"6581","spoiler":false},{"segments":[{"spoiler":false,"text":"外見は上品系、しかしてその実体は姐御肌のチャキチャキ江戸っ子。"},{"spoiler":false,"text":"細かいことは気にしないが、いい加減なのは嫌いなタイプ。"},{"spoiler":false,"text":"厳しいが包容力のあるタイプで、クラスメイトや後輩からは慕われている。"},{"spoiler":false,"text":"しかし、時折電波でも受信するのか突拍子も無い行動に出るときがある。その状態の祭は、まるで駄々っ子である。"},{"spoiler":false,"text":"男兄弟が多いため自分の事を「僕」と呼ぶ。"}],"source":"bangumi","sourceCharacterId":"109346"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"26109","sourceWorkId":"6581","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"26109","sourceWorkId":"6581","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"26109","sourceWorkId":"6581","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"62 cm","valueContext":null,"source":"egs","sourceCharacterId":"26109","sourceWorkId":"6581","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"52 kg","valueContext":null,"source":"egs","sourceCharacterId":"26109","sourceWorkId":"6581","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80f4cb618e3af3fcd18ad8d0c063bdb0f09f6d6a686d8b5a914dbe7237ddabde.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a899f689ec86ad0c71bec132aecde0114072d0d5782c013d7aaf10f309578387.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日 りか","creatorId":"vndb:s1622","sourcePersonId":"vndb:s1622","canonicalEntityId":"vndb:s1622","name":"春日 りか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:4079","source":"vndb"}]},{"characterId