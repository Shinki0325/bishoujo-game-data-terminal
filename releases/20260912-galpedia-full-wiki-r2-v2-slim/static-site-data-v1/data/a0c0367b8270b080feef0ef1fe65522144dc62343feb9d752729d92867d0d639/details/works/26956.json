ource-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An extraordinary man and providential hero during the Warring States Period, also feared as the Demon of the Sixth Heaven."},{"spoiler":false,"text":"He is summoned as the main character's \"father.\""},{"spoiler":false,"text":"He seems to know some things about his situation from the beginning, and speaks in riddles to try and test you."},{"spoiler":false,"text":"From in-game profile"}],"source":"vndb","sourceCharacterId":"c72484"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a439642898b2767ed8c0b0e9ec41c2d0dcc6ffdbdd740e431144906c73746f64.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/197f524b8340eace9d69bcf4f20f834c817ac52d5942fd1bdd95536c752cafe8.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c72485","characterName":"竹中 半兵衛","sourceIds":{"vndbCharacterId":"c72485"},"originalCharacterName":"竹中 半兵衛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A brilliant tactician who is cool-headed and composed and can sometimes seem cruel."},{"spoiler":false,"text":"He is summoned as the main character's \"fiance.\""},{"spoiler":false,"text":"He is the first to sense that something is wrong with his presence in the castle, and tries to prod you -- the woman he is supposed to be engaged to -- for information."},{"spoiler":false,"text":"From in-game profile"}],"source":"vndb","sourceCharacterId":"c72485"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.dat