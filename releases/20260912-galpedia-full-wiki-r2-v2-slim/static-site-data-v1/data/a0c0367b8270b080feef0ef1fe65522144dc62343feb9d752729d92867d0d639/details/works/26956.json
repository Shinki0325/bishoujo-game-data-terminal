only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is summoned as the \"ninja reinforcement\" who has come to the main character's castle. Originally served a neighboring country which was devastated by demons."},{"spoiler":false,"text":"Moves like a shadow and possesses nearly inhuman techniques."},{"spoiler":false,"text":"Somewhat of a loner, and dislikes groups. He dislikes being held back by rules imposed on him by others and lives a free and unrestrained life."},{"spoiler":false,"text":"From in-game profile"}],"source":"vndb","sourceCharacterId":"c72487"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/641d0e693a72f14943d88d39136b4550696fde5a68c61543bd9d8d91c54cbf80.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/773b3fc21ebc62b9eb6cd03fc4120e11a1983653b19830b0034e9252faed4150.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c72488","characterName":"真田 幸村","sourceIds":{"vndbCharacterId":"c72488"},"originalCharacterName":"真田 幸村","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A bold and daring general who can take on entire armies by himself."},{"spoiler":false,"text":"He is summoned as the main character's \"twin brother.\" Although he has feelings for you, he struggles with the blood relation between the two of you."},{"spoiler":false,"text":"From in-game profile"}],"source":"vndb","sourceCharacterId":"c72488"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b412493a38b81031bce8841fda955e1aca9d00e9c2b3f42cfe51699593d03be.webp","fallbackUrl":"https