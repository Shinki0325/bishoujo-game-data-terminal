e-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"After her twin brother was killed by the Heike, in order to get revenge and restore the Minamoto clan she takes up the name of Shanaou Yoshitsune and acts in his place."},{"spoiler":false,"text":"Her original personality was lively, but since she took up her brothers name she pretends at being cool and collected."},{"spoiler":false,"text":"She has gifted insight when it comes to battle tactics."}],"source":"vndb","sourceCharacterId":"c27171"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e6cacfcdc8109a5a7bb23b092c852781959ea5927584dd64865b3b4673b4788.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d24e814452ee03a6533b522c23ef9d60eec3e29ae803d5967e5b19438b940541.webp","width":215,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c27172","characterName":"武蔵坊 弁慶","sourceIds":{"vndbCharacterId":"c27172"},"originalCharacterName":"武蔵坊 弁慶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Originally a member of the Heike clan, the son of Tanzou the Head of Kumano. However he was too rough and was disinherited."},{"spoiler":false,"text":"If not a member of the Heike than not as a person he lamented over the decay in the state of the world and the government and awaited revolt."},{"spoiler":false,"text":"He had a predestined meeting with the protagonist on the Gojouoo Bridge."},{"spoiler":false,"text":"A cheerful man who laughs a lot."}],"source":"vndb","sourceCharacterId":"c27172"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/9406fba61a6b64f44f1a827ecacb418ce011c76fff073a6789972558601d85dd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf5489ebef4125b7add3529e2c2d35c0242e694028218dac9bcf5d0bcc6f6c34.webp","width":215,"height":256,"source":"static-detail"},"actors":[{"creditedName":"先割れスプーン","creatorId":"vndb:s45","sourcePersonId":"vndb:s45","canonicalEntityId":"vndb:s45","name":"鳥海浩輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15871","source":"vndb"}]},{"characterId":"char_vndb_c27173","characterName":"佐藤 継信","sourceIds":{"vndbCharacterId":"c27173"},"originalCharacterName":"佐藤 継信","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"By the order of Fujiwara no Hidehara he teaches Yoshitsune proper conduct as well as kendo."},{"spoiler":false,"text":"He works as a instructor at a kendo dojo in Hiraizumi."},{"spoiler":false,"text":"He's usually cool and collected, but he has a low boiling point. He won't tolerate rudeness from the protagonist."},{"spoiler":false,"text":"He has a strong sense of loyalty, in general the protagonist is number one."},{"spoiler":false,"text":"He works in order to protect the protagonist's life."}],"source":"vndb","sourceCharacterId":"c27173"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c4e4dc0c04d41e8ffe1fe48f5848aa1c6476a1c0c64c896683ecb7150947448.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad4004086ac801f7f7e8562cf754c896163673e3ba3e21b7c0fe97ee42d9099e.webp","width":215,"height":256,"source":"static-detail"},"actors":[{"creditedName":"露骨丸","creatorId":"vndb:s370","sourcePersonId":"vndb:s370","canonicalEntityId":"vndb:s370","name":"杉田智和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15873","source":"vndb"}]},{"characterId":"char_vndb_c27176","characterName":"佐藤 忠信","sourceIds":{"vndbCharacterId":"c27176"},"originalCharacterName":"佐藤 忠信","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsugunobu's little brother."},{"spoiler":false,"text":"Together with his brother he accompanies the protagonist by the order of Fujiwara no Hidehara."},{"spoiler":false,"text":"With his attractive face and figure and elegant words he is popular with the ladies...but, the man himself thinks that is nothing but troublesome."},{"spoiler":false,"text":"The person he respects the most is Hidehara, and compared to the other members of the group his loyalty towards the protagonist is the lowest."}],"source":"vndb","sourceCharacterId":"c27176"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdaa6d23d65032cba4b6d930f1a419501c4efb4ba1109bcdf0c8e9463401389a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c831a302b68a415eea68671a3e355498ebe15dcfc7df0ed20eb242672fcea67.webp","width":215,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瀧川 大輔","creatorId":"vndb:s90","sourcePersonId":"vndb:s90","canonicalEntityId":"vndb:s90","name":"鈴村 健一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15876","source":"vndb"}]},{"characterId":"char_vndb_c27187","characterName":"喜三太","sourceIds":{"vndbCharacterId":"c27187"},"originalCharacterName":"喜三太","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He's always thinking wholeheartedly about the protagonist, a bright and lively person."},{"spoiler":false,"text":"He's a childhood friend of the protagonist and usually fondly calls her Shana. But in order to clearly keep up their appearance of being master and servant in front of other people he calls her Yoshitsune-sama."},{"spoiler":false,"text":"He dislikes grown men, and has a strange dislike of standing behind them."}],"source":"vndb","sourceCharacterId":"c27187"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce7d6834dec050d9ca72dc88a6267161053597c68564b9a1fb4058d0b3242fbf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e74ef9511bed936eb63171c23ceef5f482128863309844ec6a44207ae7406a51.webp","width":215,"height":256,"source":"static-detail"},"actors":[{"creditedName":"東城 直樹","creatorId":"vndb:s387","sourcePersonId":"vndb:s387","canonicalEntityId":"vndb:s387","name":"宮田 幸季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15874","source":"vndb"}]},{"characterId":"char_vndb_c27190","characterName":"伊勢 三郎 義盛","sourceIds":{"vndbCharacterId":"c27190"},"originalCharacterName":"伊勢 三郎 義盛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A member of a group of thieves who attacked the protagonist on the way to Hiraizumi. However he changed his mind and ended up attacking his own men to help her."},{"spoiler":false,"text":"He noticed then that the protagonist was a a noble son of the Genji family and stubbornly followed her."},{"spoiler":false,"text":"He's usually a flashy and flirty person, but he has a crafty and eloquent side."},{"spoiler":false,"text":"Uniquely because of his past as a thief, he shows talent as a strategist with his free thinking ideas."}],"source":"vndb","sourceCharacterId":"c27190"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e653cd39da8b2d52a7febc6c13b727dffb02a1f341b9768fd10455bd7f549e3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0e13d861295fbcfcb12838db05b40c4cbfe7fc5ab2bde8123640b7b7e301087.webp","width":215,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳳凰院 龍彦","creatorId":"vndb:s10","sourcePersonId":"vndb:s10","canonicalEntityId":"vndb:s10","name":"子安 武人","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15877","source":"vndb"}]},{"characterId":"char_vndb_c27191","characterName":"源 頼朝","sourceIds":{"vndbCharacterId":"c27191"},"originalCharacterName":"源 頼朝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Eldest son of the Genji clan, third son of Minamoto no Yoshitomo, leader of the Genji. The protagonist's older brother."},{"spoiler":false,"text":"He has a lively and intimidating way of speaking."},{"spoiler":false,"text":"He thinks Goshirakawa Houou isn't someone he can underestimate, they have a mutual suspicion of each other."},{"spoiler":false,"text":"Because he thinks that having a women commander would bring shame to the Genji name so he treats the protagonist badly."}],"source":"vndb","sourceCharacterId":"c27191"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89f327e7ee