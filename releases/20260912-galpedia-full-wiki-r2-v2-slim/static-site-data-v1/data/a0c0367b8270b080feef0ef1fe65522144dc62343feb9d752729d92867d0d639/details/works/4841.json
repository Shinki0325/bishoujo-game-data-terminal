Id":"vndb:s697","name":"笹山 力郎","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:27383","source":"vndb"},{"creditedName":"笹＠","creatorId":"vndb:s697","sourcePersonId":"vndb:s697","canonicalEntityId":"vndb:s697","name":"笹山 力郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:27384","source":"vndb"},{"creditedName":"おだ ちえり","creatorId":"vndb:s6874","sourcePersonId":"vndb:s6874","canonicalEntityId":"vndb:s6874","name":"おだ ちえり","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:27387","source":"vndb"}]},"cast":[{"characterId":"char_c10734","characterName":"高見 瞳","sourceIds":{"bangumi":[{"characterId":"94444","match":"exact-normalized-name-in-linked-work","subjectId":"266032"}],"egsCharacterIds":["27714"],"vndbCharacterId":"c10734"},"originalCharacterName":"高見 瞳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hitomi is Akitoshi's older sister."},{"spoiler":false,"text":"She agrees to become pregnant with his child in order to save his life. She develops a fetish that consists of breastfeeding Akitoshi with her breast milk"}],"source":"vndb","sourceCharacterId":"c10734"},{"segments":[{"spoiler":false,"text":"Ｆカップの巨乳美少女にして主人公のお姉さん。"},{"spoiler":false,"text":"成績優秀で学園内でもトップの成績、所属している水泳部し、大会で優勝したこともあるほどの実力を持ち、気さくで優しく、思いやりもあり学園内でも男女問わず、人気のある彼女。"},{"spoiler":false,"text":"両親とは死別しており、現在は、弟“秋俊（主人公）”とふたり暮し。弟とは血は繋がっておらず、そのことを彼女は知っているが、弟は、その事実を知らない。"},{"spoiler":false,"text":"物心をついた頃から弟である主人公を異性として意識し、抑えらない衝動をグッと我慢していたのだが、主人公が彼女の下着でオナニーに耽るところを目撃してからは性的な興味も膨らんできて……。"}],"source":"egs","sourceCharacterId":"27714","sourceWorkId":"4841","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の姉。Ｆカップの巨乳美少女。主人公と同じ学校（2年生）に通っていて、成績優秀で学内トップ、クラブ活動も水泳部に所属していて大会で優勝したこともある。両親のいない高見家を切り盛りしているしっかり屋さんで、周囲に優しく同級生、後輩先輩、男女問わず人気がある。主人公と違い、自分と主人公は義理の姉弟であることを知っている。"},{"spoiler":false,"text":"物心がついた頃から弟を異性として意識し始め、いけないと自覚しつつ今では抑えきれないほどの恋心と弟に対する独占欲をもっている。主人公が始めてガールフレンドを連れて来た時には、激しく動揺して何かと理由を付けて別れさせる方向に誘導した。また、主人公が自分の下着を使ってひとりＨしていることを知っていて、それがキッカケで性的な興味も膨らませている。"}],"source":"bangumi","sourceCharacterId":"94444"}],"profileFacts":[{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"27714","sourceWorkId":"4841","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b12081d29edeb5d6ea7942f7d045082bdd2b768d5ec51551d42e8c245933a18b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54dd3c194d01fb4acedc0f1e4ba62bf16a438c886bb8163eb9b1aecdaf96aea7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"河原木志穂","creatorId":"vndb:s13","sourcePersonId":"vndb:s13","canonicalEntityId":"vndb:s13","name":"河原木 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266032:94444:4422:1","source":"bangumi"}]},{"characterId":"char_c10735","characterName":"魅奈","sourceIds":{"bangumi":[{"characterId":"94445","match":"exact-normalized-name-in-linked-work","subjectId":"266032"}],"egsCharacterIds":["27715"],"vndbCharacterId":"c10735"},"originalCharacterName":"魅奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mina is beautiful naive young girl who starts her job as Shinigami."},{"spoiler":false,"text":"She came for Akitoshi's soul. But have mercy on him and give him a chance to prolong his life if with some girl he conceives a child within a week."}],"source":"vndb","sourceCharacterId":"c10735"},{"segments":[{"spoiler":false,"text":"人間界のアニメ鑑賞が趣味の、ちょっと変わった死神1年生（本人談）。"},{"spoiler":false,"text":"天然ボケで、かなりお人好し性格。本来、人間界では透明化の魔法で人間には見えないようにするのが死神の決まりなのだが、透明化魔法の授業時間と大好きなアニメの放映時間とが重なっていたため、その授業をサボってしまい、透明化することが苦手（無理？）なようだ。"},{"spoiler":false,"text":"基本的には、死神界の落ちこぼれだったりする彼女。今回、主人公の命を刈りに人間界にやってきたのだが、瞳の主人公を想う心に感動した彼女は、主人公を延命させることに一肌脱ぐのだったが……。"}],"source":"egs","sourceCharacterId":"27715","sourceWorkId":"4841","spoiler":false},{"segments":[{"spoiler":false,"text":"死神1年生（本人談）瞳に負けず劣らずの美少女。趣味は人間界のアニメ鑑賞。奇天烈な衣装といつも抱えている大鎌さえなければとても死神には見えない。死神は、寿命がきた人間の魂を刈ることが仕事で、彼女は100年の死神修行ののち初仕事として主人公の命を刈りにきたのだが、瞳の主人公を思う心に感動し主人公を延命させることに協力することに。"},{"spoiler":false,"text":"死神としては相当落ちこぼれ＝かなりなお人良しで、かなり天然ボケちっくなところがある。本来は人間には見えないハズの彼女だが、透明化魔法の授業の時間が大好きなアニメの放映時間と重なりサボり倒したのが原因でうまく魔法が使えないため、しっかり目視できる。"}],"source":"bangumi","sourceCharacterId":"94445"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3a5d7ddae0ca024936578ac8746aea458d18a4efa757386ab2c525ca7f835d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d7d90ec943cedb7e9e6257f4c020726e19335fa89cc1ba90c6d035513a8e0b4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和田カヨ","creatorId":"vndb:s570","sourcePersonId":"vndb:s570","canonicalEntityId":"vndb:s570","name":"西田こむぎ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266032:94445:6045:1","source":"bangumi"}]},{"characterId":"char_vndb_c10733","characterName":"高見秋俊","sourceIds":{"vndbCharacterId":"c10733"},"originalCharacterName":"高見秋俊","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Akitoshi is first-year high school student who lives alone with his beautiful 