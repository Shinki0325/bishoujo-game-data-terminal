{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"22838","model":{"presentationWorkId":"vndb:v18730","staff":{"artwork":[{"creditedName":"ぶぶづけ","creatorId":"vndb:s4581","sourcePersonId":"egs:creator:2384","canonicalEntityId":"vndb:s4581","name":"ぶぶづけ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:159254","source":"egs"}],"scenario":[{"creditedName":"亮精類","creatorId":"vndb:s4582","sourcePersonId":"egs:creator:12751","canonicalEntityId":"vndb:s4582","name":"亮精類","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:159253","source":"egs"}],"music":[],"other":[{"creditedName":"亮精 類","creatorId":"vndb:s4582","sourcePersonId":"vndb:s4582","canonicalEntityId":"vndb:s4582","name":"亮精 類","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:126949","source":"vndb"}]},"cast":[{"characterId":"char_c25022","characterName":"ユカ","sourceIds":{"bangumi":[{"characterId":"49421","match":"exact-normalized-name-in-linked-work","subjectId":"221958"}],"egsCharacterIds":["4935"],"vndbCharacterId":"c25022"},"originalCharacterName":"ユカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A woman around her 30s, who has a charm similar to that of a housewife. She's the owner of the massage parlor \"Yuka\". She's moderately plump in the right places, and her breasts are on the larger side. She attends to anyone with kindness coupled with a lovely smile."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c25022"},{"segments":[{"spoiler":false,"text":"30歳ぐらいの、どこか人妻のような感じもする女性。マッサージ店のママ（店長）。"},{"spoiler":false,"text":"適度に肉付きが良く、胸も大きめ。笑顔が素敵で、誰にでも優しく接する。"},{"spoiler":false,"text":"「今日はどこがお疲れですか？　疲れている部分を、重点的にほぐしていきますね」"},{"spoiler":false,"text":"「ふふっ……ココ、もうこんなに固くなってますよ？」"}],"source":"egs","sourceCharacterId":"4935","sourceWorkId":"21031","spoiler":false},{"segments":[{"spoiler":false,"text":"30歳ぐらいの、どこか人妻のような感じもする女性。マッサージ店のママ（店長）。"},{"spoiler":false,"text":"適度に肉付きが良く、胸も大きめ。笑顔が素敵で、誰にでも優しく接する。"},{"spoiler":false,"text":"店を開いて初めて来た和也に対しては、少し過剰なサービスを提供する事もある。"}],"source":"egs","sourceCharacterId":"4935","sourceWorkId":"21758","spoiler":false},{"segments":[{"spoiler":false,"text":"30歳ぐらいの、どこか人妻のような感じもする女性。 マッサージ店のママ（店長）。"},{"spoiler":false,"text":"笑顔が素敵で、誰にでも優しく接する。"},{"spoiler":false,"text":"店を開いて初めて来た和也には、少し過剰なサービスを提供することもある。"},{"spoiler":false,"text":"「ふふっ、お疲れみたいですから、しっかりほぐしていきますね」"}],"source":"bangumi","sourceCharacterId":"49421"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e95d9c9a8a2df06f4ae7addbf7ad14a0f5bf1f82d31f8e01bb20944f8b62f3f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/723b72c90de4936f6ba8365bebc646fe69489d744274fd472ee74de53f69d05b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥川 久美子","creatorId":"vndb:s861","sourcePersonId":"vndb:s861","canonicalEntityId":"vndb:s861","name":"奥川 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67671","source":"vndb"}]},{"characterId":"char_c40873","characterName":"サキ","sourceIds":{"bangumi":[{"characterId":"49419","match":"exact-normalized-name-in-linked-work","subjectId":"213354"}],"egsCharacterIds":["10614"],"vndbCharacterId":"c40873"},"originalCharacterName":"サキ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A married woman in her 30s. She's a rookie who just started working at Yuka. A beautiful woman with a light complexion who has an air of gentleness around her. Sociable and not exactly bad with conversations, but because she's not yet proficient in her work, she's a little unconfident."},{"spoiler":false,"text":"Translated from Official Site"},{"spoiler":false,"text":"Relaxation Yuka M:"},{"spoiler":false,"text":"Aside from the massage parlor, she also works in an S&M club and is quite popular. She treats her customers kindly like in the massage parlor, but also inflicts pain cold-heartedly. Even in her private time, she keeps several slaves."},{"spoiler":false,"text":"Translated from Official Site"}],"source":"vndb","sourceCharacterId":"c40873"},{"segments":[{"spoiler":false,"text":"30歳。色白で細身、おとなしい感じの美人。"},{"spoiler":false,"text":"愛想が良くて、とても丁寧な口調で会話をする。"},{"spoiler":false,"text":"マッサージのセラピストとして働いており、程良い力を込めての指圧やオイルマッサージには定評がある。"},{"spoiler":false,"text":"一方SMクラブでも働いており、そちらでも人気がある。"},{"spoiler":false,"text":"マッサージの時のような優しい感じで、それでいて冷たく的確に男を責め立ててくる。"},{"spoiler":false,"text":"またプライベートでも数人の奴隷を飼っている。"},{"spoiler":false,"text":"「これからしっかりと調教してあげます」"},{"spoiler":false,"text":"「ちゃんと言葉に出してくれないと……止めますよ？」"},{"spoiler":false,"text":"「ご主人様への挨拶を忘れずに出来ましたね。偉いです」"}],"source":"egs","sourceCharacterId":"10614","sourceWorkId":"23953","spoiler":false},{"segments":[{"spoiler":false,"text":"30歳ぐらいの人妻。 新人として入店ばかり。"},{"spoiler":false,"text":"色白で細身、おとなしい感じの美人。"},{"spoiler":false,"text":"愛想は良く会話も不得意ではないが、技量不足や店慣れしていないためどこか自信なさげ。"},{"spoiler":false,"text":"「頑張りますので、よろしくお願いします」"}],"source":"bangumi","sourceCharacterId":"49419"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95225675f0ee13bd37f361978480534b7755614241dd8c2b01f891f5e1186d06.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fdadb8211a16d25f7eb97b239720b922366e83225cf6a72d9dcc31d8