me":"如月 朋","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"几帳面で、古風な雰囲気を持つ女教師。"},{"spoiler":false,"text":"良家のお嬢様の彼女は、大学卒業まで同系の女子校に通っていた。"},{"spoiler":false,"text":"そのため男性に対して免疫がなく、面と向かうと意識過剰になる。"}],"source":"egs","sourceCharacterId":"24103","sourceWorkId":"8550","spoiler":false},{"segments":[{"spoiler":false,"text":"几帳面で古風的な女性。良家のお嬢様で、大学卒業まで同系女子学校に通っていたため男性の免疫がない。"},{"spoiler":false,"text":"年齢も近いために生徒からは 「朋ちゃん」と慕われているが、本人は 「なめられているのでは？」とちょっぴり悩んでいる。"},{"spoiler":false,"text":"※『汁だく接待 汁だらけの街』をインストールしていると追加されるヒロイン。"}],"source":"bangumi","sourceCharacterId":"92236"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/023a7488b029e209fe2becd37f22d698c6bdd6ff0231e65803e65b54a0f46d89.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1ea3cec0610fd0f84005e2f3cd3e7530491932de110cafa2edde54aef4dfd181.webp","width":140,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c24862","characterName":"鳥居 梓菜","sourceIds":{"bangumi":[],"egsCharacterIds":["21212"],"vndbCharacterId":"c24862"},"originalCharacterName":"鳥居 梓菜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"エリート意識が強い美人OL。"},{"spoiler":false,"text":"高飛車で、無能な人間には容赦が無く、その性格が仇となって男性社員から敬遠されている。"},{"spoiler":false,"text":"しかし、恋人や同性の前ではしおらしく、女性的な一面をみせる。"},{"spoiler":false,"text":"郁美を大学時代からライバル視していたが、郁美には勝てず、暗い情念を抱いていた。"},{"spoiler":false,"text":"それが年齢を重ねるにつれて、郁美のような存在がいることが自分の成長に繋がっていると考えるようになった。"}],"source":"egs","sourceCharacterId":"21212","sourceWorkId":"8965","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/2678cd3f4bc89c314116a0e22f79f363b58ba5c364eae103d7722d5e21d09b4f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5d73c619d1c3fe82cfade416399e6f2a48530a997dac136e1b1067b12388ba8.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c24865","characterName":"秋月 菜留美","sourceIds":{"bangumi":[{"characterId":"92238","match":"exact-normalized-name-in-linked-work","subjectId":"269985"}],"egsCharacterIds":["18982"],"vndbCharacterId":"c24865"},"originalCharacterName":"秋月 菜留美","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学院生徒会長にして、前理事長の孫。"},{"spoiler":false,"text":"生粋のお嬢様で、プライドが高く孤高を好む。"},{"spoiler":false,"text":"男性嫌いなため、男に対してはよそよそしいが、唯一、尊敬する祖父の話になると、頬を染めたり、可愛らしい一面を見せる。"},{"spoiler":false,"text":"「わたくしも、大人になったということですわ。あの頃のままというわけにもいきませんもの。そうでしょう？」"}],"source":"egs","sourceCharacterId":"18982","sourceWorkId":"10191","spoiler":false},{"segments":[{"spoiler":false,"text":"聖華・葵女学院3年生・水泳部。学院の生徒会会長でもあり、前理事長の孫 （前妻の孫）でもある少女。"},{"spoiler":false,"text":"プライドが高く、欲しいものはなにをしてでも手に入れるという性格。"},{"spoiler":false,"text":"※『汁だく接待 おかわり二杯目』をインストールしていると追加されるヒロイン。"}],"source":"bangumi","sourceCharacterId":"92238"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b946df7ec9ddab9fca0cf