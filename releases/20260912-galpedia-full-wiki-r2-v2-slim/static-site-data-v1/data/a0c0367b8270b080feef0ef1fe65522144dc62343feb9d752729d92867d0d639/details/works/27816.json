手で、学園には行っていない。"},{"spoiler":false,"text":"オドオドした態度が抜けないのだが、"},{"spoiler":false,"text":"家族とは口数こそ少ないが普通に話せる。"},{"spoiler":false,"text":"寝ている最中お兄ちゃんの指を舐めるクセがあり、"},{"spoiler":false,"text":"その舐め方は執拗にして煽情的。"},{"spoiler":false,"text":"お兄ちゃんは毎朝大変だったりする。"},{"spoiler":false,"text":"引っ込み思案だが、お兄ちゃんに関する事への"},{"spoiler":false,"text":"好奇心だけは人一倍あり……"},{"spoiler":false,"text":"「おにいちゃんは今、いやされてる? すみも、お兄ちゃんにいやされてるよ……」"}],"source":"bangumi","sourceCharacterId":"60571"}],"profileFacts":[{"label":"胸围（本版本）","value":"71 cm","valueContext":null,"source":"egs","sourceCharacterId":"18742","sourceWorkId":"27816","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"142 cm","valueContext":null,"source":"egs","sourceCharacterId":"18742","sourceWorkId":"27816","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"69 cm","valueContext":null,"source":"egs","sourceCharacterId":"18742","sourceWorkId":"27816","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"18742","sourceWorkId":"27816","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33aa4b928678b6686f8e432957864dca3690c44c794cc2588b34351797c46a61.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9fb4f34d093c389b02144666e9a48d494227d69d8ea027e942fc86a9c773e30f.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"綾瀬 あかり","creatorId":"vndb:s601","sourcePersonId":"vndb:s601","canonicalEntityId":"vndb:s601","name":"松平 美波穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81042","source":"vndb"}]},{"characterId":"char_vndb_c71190","characterName":"お兄ちゃん","sourceIds":{"vndbCharacterId":"c71190"},"originalCharacterName":"お兄ちゃん","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authorit