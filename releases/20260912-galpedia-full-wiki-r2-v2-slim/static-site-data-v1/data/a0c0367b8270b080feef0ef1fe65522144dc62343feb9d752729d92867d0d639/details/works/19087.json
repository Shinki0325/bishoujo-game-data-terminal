ourceIds":{"bangumi":[],"egsCharacterIds":["2969"],"vndbCharacterId":"c17467"},"originalCharacterName":"川崎 舞子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"白薔薇学園所属の銃士兼技術者。"},{"spoiler":false,"text":"技術者としての能力は確かで、彩都らの活動をサポートする道具の開発や危険物処理などを担当している。"},{"spoiler":false,"text":"気の赴くままに発明品に変な機能を持たせたり、研究室内でうっかり爆発物を爆発させてしまったりと、かなり適当かつマイペースな性格。"},{"spoiler":false,"text":"常に気だるそうにしているが、頼まれた仕事などはきっちりこなすため、彩都たちには頼りにされている。"}],"source":"egs","sourceCharacterId":"2969","sourceWorkId":"19087","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/1643e4127fc73094ad48944dad41b180cdd81d663603d398a687a27b4af970f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4aaed5491344acbd9ecaf93915449ed9582fdb4bf902c35f1ea59b5cd7e530f3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ヒマリ","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53251","source":"vndb"}]},{"characterId":"char_c17468","characterName":"シャルル・リシュリュー","sourceIds":{"bangumi":[],"egsCharacterIds":["2970"],"vndbCharacterId":"c17468"},"originalCharacterName":"シャルル・リシュリュー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"真由の親友であり、銃器の修理やメンテナンスを行ういわゆるガンスミスの少女。"},{"spoiler":false,"text":"誰に対しても物怖じせず接するなど、明るくフレンドリーな性格をしている。"},{"spoiler":false,"text":"元気のよさもあいまってテンションとノリに任せて場を引っ掻き回すことも多いが、真由のことはとても大事に思っており、ガンスミスとして世界中を旅する彼女をサポートするなど友達思いな一面もある。"}],"source":"egs","sourceCharacterId":"2970","sourceWorkId":"19087","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58a4d5073ee936fa7edde166057417d6a1ed957fd4c603c3485426125f80082d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77c54ddfb6800a0991d4e9a8a5ce71c7abd60ecd81ff90f6c249deec609fa5b1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤咲 ウサ","creatorId":"vndb:s608","sourcePersonId":"vndb:s608","canonicalEntityId":"vndb:s608","name":"藤咲ウサ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53254","source":"vndb"}]},{"characterId":"char_c17469","characterName":"優奈・ド・メデシス","sourceIds":{"bangumi":[],"egsCharacterIds":["2971"],"vndbCharacterId":"c17469"},"originalCharacterName":"優奈・ド・メデシス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"怜奈の妹で、ブルボン王国の第二王女。"},{"spoiler":false,"text":"穏やかで落ち着いた雰囲気を持つ姉の怜奈とは対照的に快活で親しみやすく、勝ち気な性格をしている。"},{"spoiler":false,"text":"頭脳明晰で運動能力も高く、怜奈と同じく活動的に公務などを務めている。"},{"spoiler":false,"text":"幼い頃からどんなに忙しくても傍に居てくれた怜奈を大好きな姉として慕っており、現在では控えめなところのある怜奈を公私に渡ってサポートすることもある。"}],"source":"egs","sourceCharacterId":"2971","sourceWorkId":"19087","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bcd1609a7b6f22e32d14c8855bbda3a2ddfeb3f8071610c204b093b1140032c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7edc2b200c1828275ae825b1d52753036e1b32c815d9d91c1eca69d93e0771b5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedN