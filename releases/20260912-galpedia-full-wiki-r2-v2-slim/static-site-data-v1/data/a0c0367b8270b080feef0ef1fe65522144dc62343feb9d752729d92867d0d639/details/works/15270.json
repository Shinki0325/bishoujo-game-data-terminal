poiler":false,"text":"父親は新聞社員で、将来は自分も記者になりたいと思っている。"},{"spoiler":false,"text":"主人公については「ただのおっさん先生」くらいにしか思っていないほど無関心。"},{"spoiler":false,"text":"依代とは従姉妹同士。"},{"spoiler":false,"text":"胸が大きい。"}],"source":"egs","sourceCharacterId":"10231","sourceWorkId":"15270","spoiler":false},{"segments":[{"spoiler":false,"text":"学園2年生。明るく素直で元気いっぱい。"},{"spoiler":false,"text":"付き合いも良く皆から好かれるタイプ。"},{"spoiler":false,"text":"転校してきたばかりで、尊敬する依代のいる新聞部に入部した。依代とは従姉妹同士。"},{"spoiler":false,"text":"父親は新聞社の幹部で、将来は自分も記者になりたいと思っている。"},{"spoiler":false,"text":"主人公については、あまり興味が無い。"}],"source":"bangumi","sourceCharacterId":"90537"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/7550fc8baec91c558fc57b0ef8005f95e4c100eea1686ee5e913ec5b26431090.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6bdb932258c1246339819d3a5dbe617dd8f84b3febb7c2585deecee47aa4f75.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:267588:90537:6106:1","source":"bangumi"}]},{"characterId":"char_c20798","characterName":"湯河原 依代","sourceIds":{"bangumi":[{"characterId":"90538","match":"exact-normalized-name-in-linked-work","subjectId":"267588"}],"egsCharacterIds":["10232"],"vndbCharacterId":"c20798"},"originalCharacterName":"湯河原 依代","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園3年生。"},{"spoiler":false,"text":"真面目で落ち着きのある性格。眼鏡をかけている。"},{"spoiler":false,"text":"異性から人気はあるが、冷たい性格にみられがちなので、言い寄られる事は少ない。"},{"spoiler":false,"text":"主人公が顧問を務める新聞部の部長で、月に二度、校内新聞を