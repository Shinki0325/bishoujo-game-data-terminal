ue":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園3年生。"},{"spoiler":false,"text":"小柄で発展途上な身体をもつ、金髪のハーフ。"},{"spoiler":false,"text":"外見通り子供っぽい性格で、とにかく騒がしい。"},{"spoiler":false,"text":"笑いの感性がズレていて、冗談が寒い。"},{"spoiler":false,"text":"文芸部所属だが、昼休みや放課後は新聞部に入り浸っている。"},{"spoiler":false,"text":"胸は小さい。"}],"source":"egs","sourceCharacterId":"10233","sourceWorkId":"15270","spoiler":false},{"segments":[{"spoiler":false,"text":"学園3年生。小柄で発展途上な身体をもつ金髪のハーフ娘。"},{"spoiler":false,"text":"まだまだ大人になりきれていない性格で、とにかく騒がしい。"},{"spoiler":false,"text":"笑いの感性がズレていて、冗談が寒い。"},{"spoiler":false,"text":"文芸部所属だが、授業時間以外は新聞部に入り浸っている。"}],"source":"bangumi","sourceCharacterId":"90539"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e74b379d449e050570b6f16ada97796cb5015f602cb6fd44c41238a4cf0292a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/caac5a2f4da57453f4c09edd5939b15e12244b9dbfe294320ab91d67bf1efcfb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上みゆ","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:267588:90539:6558:1","source":"bangumi"}]},{"characterId":"char_c20888","characterName":"杉本 陽菜","sourceIds":{"bangumi":[{"characterId":"90526","match":"exact-normalized-name-in-linked-work","subjectId":"220718"}],"egsCharacterIds":["12260"],"vndbCharacterId":"c20888"},"originalCharacterName":"杉本 陽菜","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が教鞭を執る学園の女子生徒。一年生。"},{"spoiler":false,"text":"微笑むとうっすらとえくぼが浮かぶ、清楚で可愛らしい女の子。"},{"spoiler":false,"text":"根は明るいが、人見知りするタイプ。"},{"spoiler":false,"text":"最近、母親が再婚したが、義理の父親と馴染めず、自宅に自分の居場所がない。そのため、自宅に戻らず、たまたま外をぶらぶらしていたところを教師に見つかり、保護された。クラスに友達は居るが、まだ泊まらせて貰えるような深い関係の友人は居ない。"},{"spoiler":false,"text":"男子から交際を申し込まれたことはあるが、それで付き合ったことはない。"},{"spoiler":false,"text":"そのため、オナニー経験はあるが、男性経験はなく、処女。"}],"source":"egs","sourceCharacterId":"12260","sourceWorkId":"13760","spoiler":false},{"segments":[{"spoiler":false,"text":"学園1年生。成績は中の上。"},{"spoiler":false,"text":"クラス内での友達との交流はあるが、同じ学区からやってきた人がいないので、泊まり合うような仲にはまだなっていない。"},{"spoiler":false,"text":"根は明るいが、人見知りするタイプ。 清楚で可愛らしい顔立ちが特徴。微笑むとうっすらと片えくぼが出る。"},{"spoiler":false,"text":"告白してくる男子もいるが、今は付き合う気が無い。"},{"spoiler":false,"text":"最近、母親が再婚し義理の父の家に住んでいるが、馴染めていない。"},{"spoiler":false,"text":"初潮は小学6年生。中学生の頃オナニーを覚える。もっぱら布団の中でうつぶせでクリトリスいじり。おっぱい大きめで、乳首をいじられると弱い。アンダーヘアは薄目。"},{"spoiler":false,"text":"主人公のことは教科担任の先生だ……くらいの認識。クラス内女子の間ではキモイという意見が多いが、別に好きでも嫌いでもない。"},{"spoiler":false,"text":"以前通学中に偶然、犬に吠えられてビクッとしている主人公を見かけた事があり、その時はちょっとかわいいと思ってしまった。"}],"source":"bangumi","sourceCharacterId":"90526"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e83b6b0cf9fc86c9c6e948febb9e783da1d62e926c7fd6dba3e3c6a6f37f15d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/076fb2f85507d1bfcb0e72bfda1e82f2f8bdb3868075059b60eb80326235bb4f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐倉 もも花","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:37744","source":"vndb"}]},{"characterId":"char_c20889","characterName":"澤井 花純","sourceIds":{"bangumi":[{"characterId":"90527","match":"exact-normalized-name-in-linked-work","subjectId":"267578"}],"egsCharacterIds":["11995"],"vndbCharacterId":"c20889"},"originalCharacterName":"澤井 花純","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園一年生。"},{"spoiler":false,"text":"性格は真面目だが、気弱。"},{"spoiler":false,"text":"学業成績は良い方で、常に成績は上位で10位辺りをうろちょろしている。"},{"spoiler":false,"text":"最近、胸が大きくなり、痴漢に遭うようになった。"},{"spoiler":false,"text":"性格がら痴漢されても堪えていたが、そろそろ我慢の限界に来ていた。"},{"spoiler":false,"text":"就寝前は欠かさずオナニーをしているオナニーッ娘。そのため、陰唇が肥大気味。"},{"spoiler":false,"text":"主人公を痴漢と間違い、それがもとで酷い目に遭ってしまう。"}],"source":"egs","sourceCharacterId":"11995","sourceWorkId":"13866","spoiler":false},{"segments":[{"spoiler":false,"text":"学園1年生。　成績はいつも上位にいるが10位辺りをうろうろしている。"},{"spoiler":false,"text":"真面目だけど気弱な性格。"},{"spoiler":false,"text":"最近、急に胸が大きくなってきて、そのことを気にしている。"},{"spoiler":false,"text":"胸が大きくなると共に痴漢に遭うようになり、ずっと我慢していたがその執拗さに、我慢の限界が来ていた。"},{"spoiler":false,"text":"オナニーっ娘で、就寝前には欠かさずオナニーをするため陰唇が肥大ぎみ。"},{"spoiler":false,"text":"アンダーヘアは濃い目。"}],"source":"bangumi","sourceCharacterId":"90527"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f9f6d69a53ca35ede157ac158b2e1391e59fac11d1a56eb40faf8b1d16d70b6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afc94cd6e3e630dacb7956fed93de0d67cb8bbd5b5eb40a0355afca8638a1ae8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ヒマリ","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:37745","source":"vndb"}]},{"characterId":"char_c20890","characterName":"奈雲 優莉亜","sourceIds":{"bangumi":[{"characterId":"90528","match":"exact-normalized-name-in-linked-work","subjectId":"267578"}],"egsCharacterIds":["11996"],"vndbCharacterId":"c20890"},"originalCharacterName":"奈雲 優莉亜","characterNameSource":null,