3"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a01b3dc55ac984d8ddb12f46c2d010a1b051ab8e80fc2a0bfc05e23afd97515.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/822c0f4764e112d7d1321e1aec6716f41d096e13005dabc361c3566d9d31dcf1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"蒼井 ゆず","creatorId":"vndb:s23483","sourcePersonId":"vndb:s23483","canonicalEntityId":"vndb:s23483","name":"蒼井ゆず","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:83611","source":"vndb"}]},{"characterId":"char_c87949","characterName":"本多 御言","sourceIds":{"bangumi":[],"egsCharacterIds":["22128"],"vndbCharacterId":"c87949"},"originalCharacterName":"本多 御言","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公。"},{"spoiler":false,"text":"前世（地球）においては、駆け出しのアイドルプロデューサーだったのだが、シャルロッテとイーリスによって本作の舞台となる世界に召喚されてしまう。"},{"spoiler":false,"text":"召喚主である、シャルロッテとイーリスからの求めに応じて、魔王討伐に乗り出すのだが……"},{"spoiler":false,"text":"魔王討伐の任を終えた彼は、元職であるプロデューサーとして活動を開始する。"},{"spoiler":false,"text":"アイドルとその成長が最優先として行動するのだが、駆け出しであるため、その技量は完璧とはお世辞には言えない。"},{"spoiler":false,"text":"ただし、明るく温厚、真面目で誠実な性格は、ヒロイン達にとっては非常に好ましく受け止められている。"},{"spoiler":false,"text":"ヒロイン達の自主性を重んじる側面もあり、その意味ではアドバイスを送るというよりも、共に悩み考え成長していくタイプとも言える。"},{"spoiler":false,"text":"基本的にスーツを着用し、眼鏡をかけた一般人風の姿をしており、勇者というイメージからはかけ離れていると言える。"}],"source":"egs","sourceCharacterId":"22128","sourceWorkId":"29025","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca7a5178fcb184f43dafc831dde0ab8c8aeb50c4294f97c7eb467c03a9511064.webp","fallbackUrl":"https://wiki