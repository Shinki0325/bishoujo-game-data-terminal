y","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Clannad's leading protagonist; Tomoya is often labeled a delinquent at Hikarizaka High School as a result of his regular tardiness. Due to his mother dying in a car crash when he was young, Tomoya lives with his father with whom he argues incessantly. Despite his emotionally-disconnected demeanor and rude social tendencies, he is actually kindhearted and loyal to others. While walking to school one morning, Tomoya's life changes when he meets a girl by the name of Nagisa Furukawa."},{"spoiler":false,"text":"Taken from the English Official Website"}],"source":"vndb","sourceCharacterId":"c476"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/3276a37be188197913bb10dc1117cab69f4ac765dc5d0a0121ad21a43240b341.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/163c9fc8e43ad149daa336d7d1df662b2f1c488bd107c32cae1805f28fbcd282.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野島 健児","creatorId":"vndb:s380","sourcePersonId":"vndb:s380","canonicalEntityId":"vndb:s380","name":"野島 健児","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26145","source":"vndb"}]},{"characterId":"char_vndb_c478","characterName":"古河 渚","sourceIds":{"vndbCharacterId":"c478"},"originalCharacterName":"古河 渚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1224"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"source-only","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"source-only","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nagisa is Clannad's main heroine; timid and quirky, she struggles with self-confidence and has an obsession with the anachronous mascot group known as the Big Dango Family. She is in the midst of repeating her senior year of high school due to an illness that sidelined her during the last academic year. She values family, and works with her parents at their bakery in town. She meets Tomoya one morning on her way to school and befriends him—regardless of his harsh criticisms and verbal jabs at her naivety—to rebuild Hikarizaka High's defunct drama club."},{"spoiler":false,"text":"Taken from the English Official Website"}],"source":"vndb","sourceCharacterId":"c478"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcc84b36e89a4fdd8cb9a2c99a6c2c5778dbf3e908420ac49a911942edd42581.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/66f33099470fe9439cc038e8b5de889440419e40a6c8e2c089e8cb5f5d4da23d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中原 麻衣","creatorId":"vndb:s444","sourcePersonId":"vndb:s444","canonicalEntityId":"vndb:s444","name":"中原 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26146","source":"vndb"}]},{"characterId":"char_vndb_c488","characterName":"坂上 智代","sourceIds":{"vndbCharacterId":"c488"},"originalCharacterName":"坂上 智代","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1014"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewSt