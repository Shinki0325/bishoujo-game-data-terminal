etail"},"actors":[{"creditedName":"白石 涼子","creatorId":"vndb:s953","sourcePersonId":"vndb:s953","canonicalEntityId":"vndb:s953","name":"白石涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:26153","source":"vndb"}]},{"characterId":"char_vndb_c15855","characterName":"古河 早苗","sourceIds":{"vndbCharacterId":"c15855"},"originalCharacterName":"古河 早苗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1005"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sanae is Nagisa's mother who runs Furukawa Bread alongside her husband, and also tutors the children in Furukawa Cram School. Together with her husband, she takes care of their daughter,"},{"spoiler":true,"text":"and later, her child."},{"spoiler":false,"text":"Sanae is normally childish and a cry-baby, and a bad baker with her infamous Rainbow Bread, not only is her appearance youthful but also her mind and way of thinking. But when needed, she can be really dependable, strong-willed and strict, and deep inside she is thoughtful and very mature, considering how she manages to take care of her whole family and deals with their troubles."}],"source":"vndb","sourceCharacterId":"c15855"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/430edd0faf6da85012e81ae67fe36183e28d61d0952cc0b9ae615b7d7bdf9052.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b44e3b0460a85b9d9fd8015bebeb3d5d22eb771e9508ea742c4f9e9aad907123.webp","widt