Id":"c151423"},"originalCharacterName":"和田 康平","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Ariko's uncle on her mother's side."},{"spoiler":true,"text":"While still figuring out how to interact with his niece he suddenly re-united with, he is overjoyed as Ariko warms up to him more and more. But he has to keep up his cool image, so he won't show it. It bothers him slightly that he tends to be seen as older than he is."},{"spoiler":false,"text":"Edited from in-game profile"}],"source":"vndb","sourceCharacterId":"c151423"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e4100f64c45cdf045013e83acebaba73fb6863606bc682299d5e75111dba9cc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57b7efd3c1c835504f7dddc4ede21206b501c798b981782f20093f3d7cea389f.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c151424","characterName":"ビル","sourceIds":{"vndbCharacterId":"c151424"},"originalCharacterName":"ビル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A lizard who is in good competition to the Cheshire Cat in how laid-back he is."},{"spoiler":false,"text":"Quiet and polite, yet a sadistic aura hangs off him in sheets. Almost always has a slight smile on his face, but unlike the Cheshire Cat, he can do other expressions as well. If he wants to, that is."},{"spoiler":false,"text":"Edited from in-game profile"}],"source":"vndb","sourceCharacterId":"c151424"}],"profileFacts":[],"metadataCandidateConflicts":{},"i