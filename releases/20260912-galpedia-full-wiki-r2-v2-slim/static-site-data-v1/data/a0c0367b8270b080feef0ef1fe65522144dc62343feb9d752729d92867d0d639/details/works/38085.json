{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"38085","model":{"presentationWorkId":"vndb:v38033","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c151416","characterName":"葛木 亜莉子","sourceIds":{"vndbCharacterId":"c151416"},"originalCharacterName":"葛木 亜莉子","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main character."},{"spoiler":false,"text":"An open-minded girl who finds herself getting attached to strange types like the Cheshire Cat."},{"spoiler":false,"text":"She tends to direct her thoughts inward, which worries people around her sometimes. But she doesn't seem to be worried, content with the world she created for herself."},{"spoiler":false,"text":"She could probably do with a bit more worrying."},{"spoiler":false,"text":"From in-game profile"}],"source":"vndb","sourceCharacterId":"c151416"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b1fe1edb6d71c33626dbac5e3f4c15d43647780e9accc643b5787f32a2a1b04.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6e0e3d59e71e3b03296aeca231704d7d72c5b6da61f4192bfdea483e2a1e732.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c151417","characterName":"チェシャ猫","sourceIds":{"vndbCharacterId":"c151417"},"originalCharacterName":"チェシャ猫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"gender":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"