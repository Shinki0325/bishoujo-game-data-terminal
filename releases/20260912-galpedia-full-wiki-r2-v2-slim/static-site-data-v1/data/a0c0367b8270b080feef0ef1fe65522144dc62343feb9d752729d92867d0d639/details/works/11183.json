c68177"},{"segments":[{"spoiler":false,"text":"都内の女子校に通う女学生。"},{"spoiler":false,"text":"運動神経がよく、活発な振る舞いを見せる女の子だが、内心は、姉・裕未のような淑やかな女性に憧れ、そうなりたいと思っている。"},{"spoiler":false,"text":"感情の起伏が激しく、勝気で男勝りなところもあるが、将来の夢は「お嫁さん」という、乙女チックで可愛らしい一面も。"}],"source":"egs","sourceCharacterId":"17684","sourceWorkId":"11183","spoiler":false},{"segments":[{"spoiler":false,"text":"都内の女子校に通う学生。"},{"spoiler":false,"text":"特に部活には所属してないが運動神経はよい。"},{"spoiler":false,"text":"そのため活発な少女に思われがちで本人もそのように振舞うが、内心女性らしい女性（例えば姉である裕未）のようになりたいと思っている。"},{"spoiler":false,"text":"感情の起伏が激しく男勝りに見えるが、将来の夢はお嫁さんだと本気で思っている女の子。"}],"source":"bangumi","sourceCharacterId":"199504"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"17684","sourceWorkId":"11183","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"17684","sourceWorkId":"11183","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"17684","sourceWorkId":"11183","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"17684","sourceWorkId":"11183","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/9538917e9e104fbd2b56aa55370db928c8e668ea3d9788e99e71e8dde82024c7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84e64b4b997c8712f59d99a68e114e0405f7bb6d410688b55993042af23d603f.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊緒 れいあ","creatorId":"vndb:s15570","sourcePersonId":"vndb:s15570","canonicalEntityId":"vndb:s15570","name":"伊緒 れいあ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:17183","source":"vndb"}]},{"characterId":"char_c68178","characterName":"七瀬 裕未","