"segments":[{"spoiler":false,"text":"特進科の学生で、箱入り娘のお嬢様。"},{"spoiler":false,"text":"学内で最も魔術を持っている学生だが、コントロールができなくて常に不安定な状態。"},{"spoiler":false,"text":"また精神的にナイーブなため、些細なことでパニックを起こして力を暴走させてしまい、校舎を壊したり庭に大きい穴を開けることは日常茶飯事で、周囲から刺激を与えさせないように注意を払われている。"},{"spoiler":false,"text":"よく周りに迷惑を掛けて申し訳なく思っているので、人の役に立ちたいと思っているが、基本的にドジっ子なので空回りすることが多い。"}],"source":"bangumi","sourceCharacterId":"204537"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"11824","sourceWorkId":"13993","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"11824","sourceWorkId":"13993","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"11824","sourceWorkId":"13993","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27c73332e26b7292c857acda9dc148fa84654178953fa2f3fa0f54bed4d54fe5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f1dac5dd057f581f41fb0070ca10cef4c55a753b2ec71803ceb16090d6253a3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加乃みるく","creatorId":"vndb:s863","sourcePersonId":"vndb:s863","canonicalEntityId":"vndb:s863","name":"加乃 みるく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:50372:204537:11511:1","source":"bangumi"}]},{"characterId":"char_c39556","characterName":"エステリア・ヴィトウィック","sourceIds":{"bangumi":[{"characterId":"204540","match":"exact-normalized-name-in-linked-work","subjectId":"50372"}],"egsCharacterIds":["11826"],"vndbCharacterId":"c39556"},"originalCharacterName":"エステリア・ヴィトウィック","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","