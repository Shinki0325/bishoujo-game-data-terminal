-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Christina's older sister."}],"source":"vndb","sourceCharacterId":"c39547"},{"segments":[{"spoiler":false,"text":"主人公が通う魔法学校特進科の生徒で風紀委員をしている。"},{"spoiler":false,"text":"獣人とのハーフで妹のクリスとは対照的に大きく、生真面目で融通の利かない頑固で気が強い委員長タイプ。"},{"spoiler":false,"text":"男は自由に性行為を求めていいという風習の世界で、大きい胸やかわいい容姿を持つリリカはよく性行為を求められて男嫌いになっている。"},{"spoiler":false,"text":"また、下心を過敏に感じ取り、妹や自分に迫ろうとする軟派な主人公を敵視している。"},{"spoiler":false,"text":"一見、冷静そうに見えるが、妹のクリスを溺愛していて、クリスに関することは一層厳しくなり、口より先に手が動く激情家で、男から守るためになるべく傍にいようとしている。"}],"source":"egs","sourceCharacterId":"11822","sourceWorkId":"13993","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が通うことになった特進科の学生で風紀委員をしている。"},{"spoiler":false,"text":"貞操観念は硬くHなことが嫌いなため、主人公とは犬猿の仲で、邪な考えを読み取っては暴力をもって阻止しようとする。"},{"spoiler":false,"text":"また、妹のクリスを溺愛していて、クリスに関することは一層厳しくなり、大人しい妹を男から守るためになるべく傍にいようとしている。"}],"source":"bangumi","sourceCharacterId":"204535"}],"profileFacts":[{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"11822","sourceWorkId":"13993","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"11822","sourceWorkId":"13993","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"11822","sourceWorkId":"13993","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f8972995186ab6f48693d20cb4c7ad6014d8c69ba5eb04f21b55b24c095491d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6b0f2110a3e87b08a40c34f8bd43782530743b47c7434cce14e09ef661a9fd4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平松真奈実","creatorId":"vndb:s857","sourcePersonId":"vndb:s857","canonicalEntityId":"vndb:s857","name":"平松 真奈実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:50372:204535:19253:1","source":"bangumi"}]},{"characterId":"char_c39549","characterName":"クリスティーナ・ヴィソンスキー","sourceIds":{"bangumi":[{"characterId":"204539","match":"exact-normalized-name-in-linked-work","subjectId":"50372"}],"egsCharacterIds":["11825"],"vndbCharacterId":"c39549"},"originalCharacterName":"クリスティーナ・ヴィソンスキー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ririka's younger sister."}],"source":"vndb","sourceCharacterId":"c39549"},{"segments":[{"spoiler":false,"text":"主人公が通う魔法学校特進科の生徒で保健委員をしている。"},{"spoiler":false,"text":"獣人とのハーフの為、体系は小柄で性格は天真爛漫で純粋、世界中が平和になればいいと本当に願っていて人を疑うことをしらず、性知識もない純粋な女の子。"},{"spoiler":false,"text":"そんな聖人的な性格から騙されやすい為、よくリリカが傍に付いていて、クリスティーナの知らない所で守っている。"},{"spoiler":false,"text":"聖職者を目指していて、怪我をしている人を放っておけず、何でも助けてあげようとする。"},{"spoiler":false,"text":"一時期、主人公が特進科へ進む前に同じクラスに通っていて、主人公は時間をかけて口説こうと優しくしていたが、特進科に行ってしまったので手が出せなくなった。"},{"spoiler":false,"text":"クリスティーナは下心等全く気づかず、優しくしてくれた主人公に好印象を抱いていて、再度同じクラスになれたことを喜んでいる。"}],"source":"egs","sourceCharacterId":"11825","sourceWorkId":"13993","spoiler":false},{"segments":[{"spoiler":false,"text":"リリカの妹で特進科の保健委員をしている。"},{"spoiler":false,"text":"姉とは違い、人懐っこいわんこのような獣人で、人を疑おうとはしない純粋で暴力が嫌いな性格。"},{"spoiler":false,"text":"同じクラスの主人公を兄のように慕っていて、主人公がリリカに暴力を振るわれた後は、クリスが治療を率先して行っている。"},{"spoiler":false,"text":"リリカとは違って幼いため、たまに獣人特有の発情期が来てしまう。"}],"source":"bangumi","sourceCharacterId":"204539"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"11825","sourceWorkId":"13993","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"11825","sourceWorkId":"13993","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"11825","sourceWorkId":"13993","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/ebd7d98b071513a75363ae01fc384419856a7e562e50f913e60b4186835895e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/795e3928784cc4eefcfccf132b8898d89c9208a92e4442e17b6db5a2b57f245e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"有河春花","creatorId":"vndb:s877","sourcePersonId":"vndb:s877","canonicalEntityId":"vndb:s877","name":"春河 あかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:50372:204539:19159:1","source":"bangumi"}]},{"characterId":"char_c39550","characterName":"ナコ・ルールカ","sourceIds":{"bangumi":[{"characterId":"204536","match":"exact-normalized-name-in-linked-work","subjectId":"50372"}],"egsCharacterIds":["11823"],"vndbCharacterId":"c39550"},"originalCharacterName":"ナコ・ルールカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が通う魔法学校特進科の生徒で、人間ではなくエルフ。"},{"spoiler":false,"text":"本来森に住む種族ではあるが、ナコはダークエルフとエルフのハーフという相成れない関係間に生まれた子で、周りから遠ざけられるように、留学生として主人公の通う学校へ送られた。"},{"spoiler":false,"text":"クラス内では、エルフと言うことで一線引かれて扱われ、言いたいことは言うが、基本的に無口で、自分のこともあまり語らないため、学校に仲のいい人間はいない。"},{"spoiler":false,"text":"その反面、色んな動物になつかれやすく、動物の面倒を見ていて生活に寂しさを感じていない。"},{"spoiler":false,"text":"空いた時間は動物の世話をすることが殆どで、1日中かかることもある。"},{"spoiler":false,"text":"特に懐いている小型の龍が四六時中付いていて、周囲が怖がって近寄らず、1人でいる原因にもなっている。"}],"source":"egs","sourceCharacterId":"11823","sourceWorkId":"13993","spoiler":false},{"segments":[{"spoiler":false,"text":"本来なら森に住む種族のエルフであるが、ダークエルフとのハーフなため、遠ざけられるように留学生として学園へ送られた。"},{"spoiler":false,"text":"周囲は珍しく思うものの好奇の目を向けるだけで、ナコ自身も無口であまり話さないため学園に仲のいい人間はいない。"},{"spoiler":false,"text":"その反面、動物に懐かれやすく、空いた時間はほとんど動物の世話をしている。"},{"spoiler":false,"text":"中でも白い龍には母親ように思われていて、よく頭に乗せて共にいる。"}],"source":"bangumi","sourceCharacterId":"204536"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"11823","sourceWorkId":"13993","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"11823","sourceWorkId":"13993","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"11823","sourceWorkId":"13993","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7a343fb7c3b229b536a50cac3a4b34b660c4088c9df68f477a4bb87b11d897c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c72ed57c41ddc53d6807c769482fd658c9d835dc2a71f13b9673a3a6483a9c1b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紅月 ことね","creatorId":"vndb:s1649","sourcePersonId":"vndb:s1649","canonicalEntityId":"vndb:s1649","name":"琴音 有波","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:28540","source":"vndb"}]},{"characterId":"char_c39552","characterName":"アヤノ・スメラギ","sourceIds":{"bangumi":[{"characterId":"204541","match":"exact-normalized-name-in-linked-work","subjectId":"50372"}],"egsCharacterIds":["11827"],"vndbCharacterId":"c39552"},"originalCharacterName":"アヤノ・スメラギ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の義姉にあたる人物で、学校内にある購買の店主をしている。"},{"spoiler":false,"text":"主人公とは血が繋がっておらず、鬼の子で角が生えている。"},{"spoiler":false,"text":"そのせいか気性が荒くわがままで、主人公に対しては暴君の如く命令し、口答えには手を出して言うことを聞かせる。"},{"spoiler":false,"text":"放任主義で何もしていないように見えるが、主人公は亡き義母から託された為、アヤノなりに責任を持って育てている。"}],"source":"egs","sourceCharacterId":"11827","sourceWorkId":"13993","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の義姉にあたる人物で、学園内にある購買で働いている。"},{"spoiler":false,"text":"腹違いの姉なので、アヤノは鬼の血が混ざっており角が生えている。"},{"spoiler":false,"text":"そのせいか、気性が荒くわがままで、主人公に対しては暴君のように命令し、口答えには暴力をもって言うことを聞かせる。"},{"spoiler":false,"text":"主人公を酷く扱っているように見えるが、亡き義母から託されたため、本人なりに保護者としてしっかり育てている。"}],"source":"bangumi","sourceCharacterId":"204541"}],"profileFacts":[{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"11827","sourceWorkId":"13993","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"11827","sourceWorkId":"13993","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"11827","sourceWorkId":"13993","sourceField":null,"scoped":true}],"metadataCandidateCon