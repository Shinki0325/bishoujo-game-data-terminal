9555","source":"vndb"},{"creditedName":"あさり☆","creatorId":"vndb:s1420","sourcePersonId":"vndb:s1420","canonicalEntityId":"vndb:s1420","name":"あさり☆","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:39556","source":"vndb"},{"creditedName":"泉水 いこ","creatorId":"vndb:s7802","sourcePersonId":"vndb:s7802","canonicalEntityId":"vndb:s7802","name":"泉水 いこ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:39561","source":"vndb"},{"creditedName":"泉水 いこ","creatorId":"vndb:s7802","sourcePersonId":"vndb:s7802","canonicalEntityId":"vndb:s7802","name":"泉水 いこ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:39563","source":"vndb"}]},"cast":[{"characterId":"char_c15139","characterName":"美作 秋人","sourceIds":{"bangumi":[{"characterId":"12216","match":"exact-normalized-name-in-linked-work","subjectId":"14567"}],"egsCharacterIds":["12119"],"vndbCharacterId":"c15139"},"originalCharacterName":"美作 秋人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Main hero. Always takes care of his sister. Even though he keeps complainining, he still spoils her in the end. Ayako calls him male tsundere. Despite the events around him he keeps being an optimist."}],"source":"vndb","sourceCharacterId":"c15139"},{"segments":[{"spoiler":false,"text":"長きにわたる紆余曲折を経て、綾子と念願の恋人同士となる。"},{"spoiler":false,"text":"が、相変わらず姫歌、小春、綾子に振り回される日々。"},{"spoiler":false,"text":"なかなか “普通の恋人同士” のように振舞えない現状を愚痴りながらも享受している。"},{"spoiler":false,"text":"小春の “立派なお姉ちゃん宣言” 以降、"},{"spoiler":false,"text":"自分の重度の “甘やかし癖” と向き合うことになり、複雑な心境。"}],"source":"egs","sourceCharacterId":"12119","sourceWorkId":"13021","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公。姉・美作小春の保護者。"},{"spoiler":false,"text":"姉の無能っぷりと奇行に振り回され、いつも愚痴っているが結局は甘やかしてしまう。"},{"spoiler":false,"text":"綾子曰く、男版ツンデレキャラのお人好し。"},{"spoiler":false,"text":"しかしその境遇に悪態をつきつつも悲観はせず、基本的にはプラス思考。"},{"spoiler":false,"text":"諸々の事情により、その性格に反してクラスでは浮いた存在になってしまっており、友達がいない。"},{"spoiler":false,"text":"『はぁ…家事ができないことはもうあきらめてるけどさ、せめて邪魔しないでくれよな、ハル姉』"}],"source":"bangumi","sourceCharacterId":"12216"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c15139","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"12119","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"12119","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"12216","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53ead269d24127844e22fd369f046987fa076fe65efd9708e17f9b9b3074e064.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d55dcfef787bf38d17c310a230f80f79b9e536086435c9e8696061989d12ae06.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c15140","characterName":"姫歌","sourceIds":{"bangumi":[{"characterId":"12211","match":"exact-normalized-name-in-linked-work","subjectId":"14566"},{"characterId":"12211","match":"exact-normalized-name-in-linked-work","subjectId":"14567"}],"egsCharacterIds":["12113"],"vndbCharacterId":"c15140"},"originalCharacterName":"姫歌","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Deity enshrined in local shrine. Even though she looks like a child, she is more than 100 years old."},{"spoiler":false,"text":"By saving Akito she loses most of her power and needs to stay at Akito's house in order to regain it. Immature and somewhat depending, she wants Akito's attention and always fights with Koharu. She however becomes dutiful when it comes to her followers."},{"spoiler":false,"text":"She doesn't rememeber her past and her song seems to have mysterious power."}],"source":"vndb","sourceCharacterId":"c15140"},{"segments":[{"spoiler":false,"text":"詩乃塚神社に祀られている土地の守り神にして鬼の姫。見た目は少女だが、実際の年齢は100歳以上。"},{"spoiler":false,"text":"社の前で倒れていた秋人の命を救うが、そのことで自身の力の大半を失ってしまい、"},{"spoiler":false,"text":"力を取り戻すまで秋人に自分の面倒を見るように命じて家に居座る。"},{"spoiler":false,"text":"隙あらば秋人に甘えるため、小春とは犬猿の仲。"},{"spoiler":false,"text":"自身が鬼の姫であり土地の守り神であることは理解しているが、"},{"spoiler":false,"text":"自分がどうやって生まれたかさえ覚えておらず、他にも記憶の欠落が多々見受けられる。"},{"spoiler":false,"text":"昔から歌を歌うことが好きだったようで、その実力は聞くもの全てを魅了するほど。"}],"source":"egs","sourceCharacterId":"12113","sourceWorkId":"12120","spoiler":false},{"segments":[{"spoiler":false,"text":"歌を歌うことが好きな、詩乃塚神社に祀られし土地の守り神。"},{"spoiler":false,"text":"人々から忘れ去られつつあったが、前回開催した詩乃塚例大祭でのライブ以降、"},{"spoiler":false,"text":"その歌声は人々に知れ渡り、その容姿と相まって一躍御当地アイドルへ昇格。"},{"spoiler":false,"text":"今では、連日神社にて単独リサイタルを開催しており、その甲斐もあってかつてのカリスマを取り戻しつつある。"}],"source":"egs","sourceCharacterId":"12113","sourceWorkId":"13021","spoiler":false},{"segments":[{"spoiler":false,"text":"詩乃塚神社に祀られている土地の守り神にして鬼の姫。"},{"spoiler":false,"text":"見た目は少女だが、実際の年齢は100歳以上。"},{"spoiler":false,"text":"社の前で倒れていた秋人の命を救うが、そのことで自身の力の大半を失ってしまい、力を取り戻すまで秋人に自分の面倒を見るように命じて家に居座る。"},{"spoiler":false,"text":"隙あらば秋人に甘えるため、小春とは犬猿の仲。"},{"spoiler":false,"text":"自身が鬼の姫であり土地の守り神であることは理解しているが、自分がどうやって生まれたかさえ覚えておらず、他にも記憶の欠落が多々見受けられる。"},{"spoiler":false,"text":"昔から歌を歌うことが好きだったようで、その実力は聞くもの全てを魅了するほど。"},{"spoiler":false,"text":"『我の名は姫歌。この詩乃塚に祀られし守り神じゃ。"},{"spoiler":false,"text":"まぁ取り敢えず、汝の生命の恩人であるということは心得ていただきたいものじゃな。』"}],"source":"bangumi","sourceCharacterId":"12211"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b69d9761046edb98af4d0b75be99f9042f89a845abf9d76b0eea90f0505d4867.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f34b68522acb70cbfa793faad21fb289754162d0715bee843149c9b2341279c8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Rita","creatorId":"vndb:s102","sourcePersonId":"vndb:s102","canonicalEntityId":"vndb:s102","name":"平井 理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14567:12211:5742:1","source":"bangumi"}]},{"characterId":"char_c15141","characterName":"美作 小春","sourceIds":{"bangumi":[{"characterId":"12210","match":"exact-normalized-name-in-linked-work","subjectId":"14566"},{"characterId":"12210","match":"exact-normalized-name-in-linked-work","subjectId":"14567"}],"egsCharacterIds":["12114"],"vndbCharacterId":"c15141"},"originalCharacterName":"美作 小春","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Beautiful, yet completely useless older sister."},{"spoiler":false,"text":"She relies on Akito in all aspects of her daily life and is deeply in love with him. Himeka's arrival brings end to it as she tries to become (only a little) more reliable older sister."},{"spoiler":false,"text":"Her special skill in 100% accuracy in multiple answer questions."}],"source":"vndb","sourceCharacterId":"c15141"},{"segments":[{"spoiler":false,"text":"見かけは美人でスタイルも良いのだが、その他の性能は超ポンコツ。"},{"spoiler":false,"text":"知力、運動能力、生活能力と軒並み低い愚姉。"},{"spoiler":false,"text":"だが、類稀なる強運の持ち主で選択問題に限り100％の正答率を誇る。"},{"spoiler":false,"text":"秋人にべた惚れでその生活はほぼ全てを秋人に頼り、甘えまくる日々を送っており、"},{"spoiler":false,"text":"その様はすでに依存症の域にまで達している。"},{"spoiler":false,"text":"秋人と一緒にいる時間を邪魔されるのを嫌い、秋人の交友関係が広がることを邪魔してきた。"},{"spoiler":false,"text":"幼少期には秋人との結婚を夢見て方法を模索したりもしていたが、"},{"spoiler":false,"text":"今では結婚しなくても夫婦のようにいつまでも一緒に生きていくことは出来ると考え、そこに秋人との関係の救いを見出している。"}],"source":"egs","sourceCharacterId":"12114","sourceWorkId":"12120","spoiler":false},{"segments":[{"spoiler":false,"text":"容姿以外はポンコツな愚姉。"},{"spoiler":false,"text":"しかし、秋人と綾子が恋人同士になったことをキッカケに、"},{"spoiler":false,"text":"かつての一方的に甘えっぱなしの関係からは少し成長。"},{"spoiler":false,"text":"心機一転、“立派なお姉ちゃん” を目指して日々奮闘中。"},{"spoiler":false,"text":"だがそのポンコツが急に改善されるはずもなく、"},{"spoiler":false,"text":"現状は、その道程が大変険しいものであるということを周囲に再認識させるばかりである。"}],"source":"egs","sourceCharacterId":"12114","sourceWorkId":"13021","spoiler":false},{"segments":[{"spoiler":false,"text":"見かけは美人でスタイルも良いのだが、その他の性能は超ポンコツ。"},{"spoiler":false,"text":"知力、運動能力、生活能力と軒並み低い愚姉。"},{"spoiler":false,"text":"だが、類稀なる○運の持ち主で選択問題に限り100％の正答率を誇る。"},{"spoiler":false,"text":"秋人にべた惚れでその生活はほぼ全てを秋人に頼り、甘えまくる日々を送っており、その様はすでに依存症の域にまで達している。"},{"spoiler":false,"text":"秋人と一緒にいる時間を邪魔されるのを嫌い、秋人の交友関係が広がることを尽く邪魔してきた。"},{"spoiler":false,"text":"幼少期には秋人との結婚を夢見て方法を模索したりもしていたが、今では結婚しなくても夫婦のようにいつまでも一緒に生きていくことは出来ると考え、そこに秋人との関係の救いを見出している。"},{"spoiler":false,"text":"『でも、結婚なんかしなくたって夫婦みたいに暮らすことはできるし……』"}],"source":"bangumi","sourceCharacterId":"12210"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/0431fbbbad9257e3c55dad9d46ba3fd60794ad69831f8bbaed11de851a42d231.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc0c740a6a8e0329474022033c9e9b071fe7937a930ac74731272e262837038e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由宇翼","creatorId":"vndb:s1420","sourcePersonId":"vndb:s1420","canonicalEntityId":"vndb:s1420","name":"あさり☆","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14567:12210:18193:1","source":"bangumi"}]},{"characterId":"char_c15143","characterName":"宮部 綾子","sourceIds":{"bangumi":[{"characterId":"12212","match":"exact-normalized-name-in-linked-work","subjectId":"14566"},{"characterId":"12212","match":"exact-normalized-name-in-linked-work","subjectId":"14567"}],"egsCharacterIds":["12115"],"vndbCharacterId":"c15143"},"originalCharacterName":"宮部 綾子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mimasaka siblings' childhood friend. She is also Koharu's classmate and best friend and Akito's senpai as well as his first love."},{"spoiler":false,"text":"Usually a honor student. Calm, dignified and collected, always willing to listen and offer a helpful advice.... and yet at the same time stalker, tease and molester when it comes to Akito. Even though she turned down his confession she takes candid photos, wiretaps him and feels him up in the train."},{"spoiler":false,"text":"Has entire notebook of things she wishes to do to Akito."}],"source":"vndb","sourceCharacterId":"c15143"},{"segments":[{"spoiler":false,"text":"秋人、小春の幼馴染。"},{"spoiler":false,"text":"小春とは同級生の親友で、秋人にとっては先輩にあたる。"},{"spoiler":false,"text":"普段は優等生で、その佇まいは凛としており教師からの評判も上々。"},{"spoiler":false,"text":"包容力もあり、秋人や小春の悩み事の相談相手になったりと、美作姉弟にとって共通のお姉さん的な存在。"},{"spoiler":false,"text":"秋人が想いを寄せる相手であり、過去に告白もされているがこれを断っている。"},{"spoiler":false,"text":"にも関わらず、本人は秋人に対してセクハラ、ストーキング、盗聴、盗撮など日常的に行う変人。"},{"spoiler":false,"text":"自身の持つ手帳に秋人に対してしたいこと（殆どがセクハラなどの変態行為）を書き記しており、"},{"spoiler":false,"text":"書き加える内容に妄想の翼をはばたかせている。"}],"source":"egs","sourceCharacterId":"12115","sourceWorkId":"12120","spoiler":false},{"segments":[{"spoiler":false,"text":"美作姉弟の幼馴染にして精神的なお姉さん的存在。しかし変態。"},{"spoiler":false,"text":"大抵のことはソツなくこなせる完璧超人。しかし変態。"},{"spoiler":false,"text":"数多の紆余曲折を経て、晴れて秋人と恋人同士となり現在絶賛ラヴラヴフィールド展開中。しかし変態。"},{"spoiler":false,"text":"恋人同士となった今も、秋人に対するセクハラ、ストーカー行為はまるで止まる所を知らないが、"},{"spoiler":false,"text":"逆に “普通の恋人同士” がするような事に対しては免疫力が極端に低い。"}],"source":"egs","sourceCharacterId":"12115","sourceWorkId":"13021","spoiler":false},{"segments":[{"spoiler":false,"text":"秋人、小春の幼馴染。"},{"spoiler":false,"text":"小春とは同級生の親友で、秋人にとっては先輩にあたる。"},{"spoiler":false,"text":"普段は優等生で、その佇まいは凛としており教師からの評判も上々。"},{"spoiler":false,"text":"包容力もあり、秋人や小春の悩み事の相談相手になったりと、美作姉弟にとって共通のお姉さん的な存在。"},{"spoiler":false,"text":"秋人が想いを寄せる相手であり、過去に告白もされているがこれを断っている。"},{"spoiler":false,"text":"にも関わらず、本人は秋人に対してセクハラ、ストーキング、盗聴、盗撮など日常的に行う変人。"},{"spoiler":false,"text":"自身の持つ手帳に秋人に対してしたいこと（殆どがセクハラなどの変態行為）を書き記しており、書き加える内容に妄想の翼をはばたかせている。"},{"spoiler":false,"text":"『いやぁ…かねがね興味のあった『○○プレイ』を試せる日が来ようとは、永生きはするモノだな』"}],"source":"bangumi","sourceCharacterId":"12212"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b96079a178743f0d7c2b7959d23462aeba22c7d7eb7771e5c05f5e4787551a68.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef4be5c0a409388181ff6c579d8ba7346fde1171956caf2554c5604ed42462e7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14567:12212:10027:1","source":"bangumi"}]},{"characterId":"char_c15144","characterName":"浅倉 誠二","sourceIds":{"bangumi":[{"characterId":"12214","match":"exact-normalized-name-in-linked-work","subjectId":"14567"}],"egsCharacterIds":["12117"],"vndbCharacterId":"c15144"},"originalCharacterName":"浅倉 誠二","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Akito's classmate and friend."},{"spoiler":false,"text":"Friendly and sociable, he is the only male classmate that Akito is really close with."}],"source":"vndb","sourceCharacterId":"c15144"},{"segments":[{"spoiler":false,"text":"正真正銘男の子。"},{"spoiler":false,"text":"博愛主義者で交友関係は広く、万人から好感を持たれる。"},{"spoiler":false,"text":"それ故に万事に対して “執着” が無く、“周囲の人間関係に執着出来る人間” である秋人に憧れている。"},{"spoiler":false,"text":"無自覚ではあるが、秋人に対する怪しい言動で周囲に誤解を振りまくこともしばしば。"}],"source":"egs","sourceCharacterId":"12117","sourceWorkId":"13021","spoiler":false},{"segments":[{"spoiler":false,"text":"クラスで浮いてしまっている秋人にとっての唯一の友。"},{"spoiler":false,"text":"博愛主義者で男女ともに交友関係が広い。"},{"spoiler":false,"text":"何事にも執着せず、一定の距離を保つことに長けており、秋人とも親友とは程遠い関係。"},{"spoiler":false,"text":"事なかれ主義で女性関係も数多だが長続きせず、友人は多いが親友はいないタイプ。"},{"spoiler":false,"text":"『信じられないけど……でも、秋人たちがそこまで真剣に言うのなら、信じるよ』"}],"source":"bangumi","sourceCharacterId":"12214"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07121671f5c7a628e484d0ccc46cfb7dd941f47b2a3f0bc63aa7d519b22e89b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a58719b227371a14df6b2e568a06fcb9324835f1de3b8a16296f83c70c4f3284.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥川久美子","creatorId":"vndb:s861","sourcePersonId":"vndb:s861","canonicalEntityId":"vndb:s861","name":"奥川 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14567:12214:22331:1","source":"bangumi"}]},{"characterId":"char_c15145","characterName":"黒咲 暦","sourceIds":{"bangumi":[{"characterId":"12213","match":"exact-normalized-name-in-linked-work","subjectId":"14566"},{"characterId":"12213","match":"exact-normalized-name-in-linked-work","subjectId":"14567"}],"egsCharacterIds":["12116"],"vndbCharacterId":"c15145"},"originalCharacterName":"黒咲 暦","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Akito's classmate and member of an art club."},{"spoiler":false,"text":"Shy and reserved, opens up a little in Akito's circle of friends. She has a small crush on Akito."}],"source":"vndb","sourceCharacterId":"c15145"},{"segments":[{"spoiler":false,"text":"秋人のクラスメイトで美術部員。"},{"spoiler":false,"text":"しかし特筆するほどの実力があるわけでもなく、ただ絵を描くのが好きだから描いているレベル。"},{"spoiler":false,"text":"引っ込み思案のため自分から他人に話し掛けることは苦手だが、"},{"spoiler":false,"text":"小動物的な雰囲気のためか周りから人が寄ってくるタイプで友人は多い。"}],"source":"egs","sourceCharacterId":"12116","sourceWorkId":"12120","spoiler":false},{"segments":[{"spoiler":false,"text":"皆に愛されいぢめられる小動物のような少女。"},{"spoiler":false,"text":"秋人の数少ない女友達。というか、唯一 “普通” の女の子。"},{"spoiler":false,"text":"美術部員だが、特筆すべき技能も無し。"},{"spoiler":false,"text":"本人は隠しているつもりだが、かなり “腐った” 女の子な部分も持っている。"},{"spoiler":false,"text":"秘めたる想いはあるものの、持前の気の弱さゆえに完全に在庫を抱えた状態が続いている。"}],"source":"egs","sourceCharacterId":"12116","sourceWorkId":"13021","spoiler":false},{"segments":[{"spoiler":false,"text":"秋人のクラスメイトで美術部員。"},{"spoiler":false,"text":"しかし特筆するほどの実力があるわけでもなく、ただ絵を描くのが好きだから描いているレベル。"},{"spoiler":false,"text":"引っ込み思案のため自分から他人に話し掛けることは苦手だが、小動物的な雰囲気のためか周りから人が寄ってくるタイプで友人は多い。"},{"spoiler":false,"text":"『秋人くん……ですか？ 黒咲 暦です。ちょっと……、聞きたいことがあるんですけど』"}],"source":"bangumi","sourceCharacterId":"12213"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de835125ecf46b309d4d6b9ce44ab77d35bf771e80edcb2658581bb4a1f2f1f7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44b7b40de747beb648f69c00d4d613fd45b08339c0a7a1568029d0987c6ad0d7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻レオナ","creatorId":"vndb:s7025","sourcePersonId":"vndb:s7025","canonicalEntityId":"vndb:s7025","name":"櫻レオナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14567:12213:29845:1","source":"bangumi"}]},{"characterId":"char_c15146","characterName":"鑑 恭一郎","sourceIds":{"bangumi":[{"characterId":"12215","match":"exact-normalized-name-in-linked-work","subjectId":"14567"}],"egsCharacterIds":["12118"],"vndbCharacterId":"c15146"},"originalCharacterName":"鑑 恭一郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"New homeroom teacher."},{"spoiler":false,"text":"Reliable, friendly and supportive, boldly proclaims that he is only interested in little girls. He adores Himeka and is her biggest fan."}],"source":"vndb","sourceCharacterId":"c15146"},{"segments":[{"spoiler":false,"text":"本年度から、秋人たちのクラス担任となった新任の教師。だけど変態。"},{"spoiler":false,"text":"教師としては大変優秀で、教育に対する真摯な姿勢とその熱い情熱で、"},{"spoiler":false,"text":"教員、学生、親御さんたちからの評価は軒並み高い。だけど変態。"},{"spoiler":false,"text":"基本的に何でも完璧にこなせる超・完璧超人だが、"},{"spoiler":false,"text":"心の師は「ウラジーミル・ナボコフ」という一点が全てを台無しにする残念な人。"},{"spoiler":false,"text":"まさに変態。"}],"source":"egs","sourceCharacterId":"12118","sourceWorkId":"13021","spoiler":false},{"segments":[{"spoiler":false,"text":"秋人のクラスの担任として赴任してきた教師。"},{"spoiler":false,"text":"ウラジーミル・ナボコフを心の師と仰ぐ、特殊な性癖の変態先生。"},{"spoiler":false,"text":"小学校の教師になれなかったことを心底悔やんでいる。"},{"spoiler":false,"text":"性格に難はあるものの教師としては優秀で情にも厚く、生徒にも親身な対応で親しまれる良い先生。"},{"spoiler":false,"text":"『む？ こりゃあまた、おかしなことを言うな、美作は。神社なんて何処にもそんなもんだろ？』"}],"source":"bangumi","sourceCharacterId":"12215"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c15146","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"12118","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"12118","value":"女性"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/0184b0db097fe8907e700f018a9b5b8caf3720907b44ebdddd32de23d44b0bf5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efd2a85ffc23b03f81e4ee02c67