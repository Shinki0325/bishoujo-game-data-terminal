dentityStatus":"source-native","relationId":"vndb:vn-staff:152913","source":"vndb"},{"creditedName":"P&C design","creatorId":"vndb:s21013","sourcePersonId":"vndb:s21013","canonicalEntityId":"vndb:s21013","name":"P&C design","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:152914","source":"vndb"},{"creditedName":"こだまプロダクション","creatorId":"vndb:s19962","sourcePersonId":"vndb:s19962","canonicalEntityId":"vndb:s19962","name":"こだまプロダクション","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:152915","source":"vndb"},{"creditedName":"天倉 りぃ","creatorId":"vndb:s44929","sourcePersonId":"vndb:s44929","canonicalEntityId":"vndb:s44929","name":"天倉 りぃ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:152917","source":"vndb"}]},"cast":[{"characterId":"char_c76912","characterName":"如月 みたま","sourceIds":{"bangumi":[{"characterId":"67220","match":"exact-normalized-name-in-linked-work","subjectId":"262374"}],"egsCharacterIds":["20873"],"vndbCharacterId":"c76912"},"originalCharacterName":"如月 みたま","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A teacher at the protagonist's school with a license in healthcare...in other words, she's the school nurse."},{"spoiler":false,"text":"She is one of the few women at the all-boys' school, and her calm and gentle personality makes her very popular. This makes her the object of everyone's admiration on the surface, but in her private life, she is a total failure."},{"spoiler":false,"text":"She is a good-for-nothing older sister lacking in feminine energy, but she greatly excels in making others spoil her."},{"spoiler":false,"text":"Even today, she spends her time lazily relying on her beloved Na-kun (her nickname for the protagonist)."},{"spoiler":false,"text":"translated from official website"}],"source":"vndb","sourceCharacterId":"c76912"},{"segments":[{"spoiler":false,"text":"鳴海が通う男子校の養護教員、いわゆる保健の先生。見た目から溢れ出しているゆるふわ癒し系で、ムサい男どもが集まる男子校の中ではまさに華だったり。"},{"spoiler":false,"text":"鳴海とは古くから知り合っている関係で、血はつながっていないが本当の姉弟のような関係。"},{"spoiler":false,"text":"滅多に怒らず、優しさが服を着て歩いているかのようだが、そこは大人の女性。"},{"spoiler":false,"text":"先生らしく指導する時は指導するが、あまりに迫力がないため相手に伝わっていないことも。"},{"spoiler":false,"text":"優しくて包容力があり、かつしっかり者。"},{"spoiler":false,"text":"でも時々天然っぽいところが垣間見えたりするところが「スキがある」として人気の一翼を担っている。"}],"source":"egs","sourceCharacterId":"20873","sourceWorkId":"27284","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が通う男子校の養護教員…いわゆる保健の先生。"},{"spoiler":false,"text":"男子校の中では貴重な女性であり、"},{"spoiler":false,"text":"その穏やかで優しい性格から大きな人気を集めている。"},{"spoiler":false,"text":"表向きはそんな風に皆の憧れの的だが、プライベートではてんでダメだったり。"},{"spoiler":false,"text":"女子力はとても低いダメ姉だが甘えのテクニックは超一級。"},{"spoiler":false,"text":"今日も大好きななーくん（主人公のこと）に頼り切りでぐーたら過ごす。"},{"spoiler":false,"text":"「ふふっ♪身体は大きくなっても中身はまだ子供なんだから」"}],"source":"bangumi","sourceCharacterId":"67220"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0ea8df29304d7bb85d4ebb9b1dd5250b16e6a746be0744b739d57168e928b73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d2b2f8e13b7971c5d066348114c3215e652849ff948e0a33f6d37bdc77d66f1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:262374:67220:4830:1","source":"bangumi"}]},{"characterId":"char_c76913","characterName":"御堂 綾","sourceIds":{"bangumi":[{"characterId":"67221","match":"exact-normalized-name-in-linked-work","subjectId":"262374"}],"egsCharacterIds":["20874"],"vndbCharacterId":"c76913"},"originalCharacterName":"御堂 綾","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A science teacher feared by all the students, she has a cool posture that never breaks. With sharpness in her eyes and her default expression being a straight face, she is seen as a unsociable teacher."},{"spoiler":false,"text":"But contrary to how she's usually portrayed, she is very prone to worrying and lacks self confidence. She'll sometimes use her neat and together appearance to hide her timid nature."},{"spoiler":false,"text":"As a result of him knowing her true character, she is close to the protagonist, the only member the opposite sex she can show her true face to."},{"spoiler":false,"text":"translated from official website"}],"source":"vndb","sourceCharacterId":"c76913"},{"segments":[{"spoiler":false,"text":"目つきが鋭く、口角も横一文字がデフォルト。口数が少なく一言一言が重いため「厳しい」という印象を周囲に与える科学の先生。"},{"spoiler":false,"text":"鳴海のクラス担任でもあるため学園でも関わる機会は多い。"},{"spoiler":false,"text":"実際ルールに厳しい一面があるため、いわゆる「怖い先生」として広く知られている。"},{"spoiler":false,"text":"みたまとは教員同士として交友関係があり親しくしている。"}],"source":"egs","sourceCharacterId":"20874","sourceWorkId":"27284","spoiler":false},{"segments":[{"spoiler":false,"text":"目つきが鋭く、口角も横一文字がデフォルトの無愛想な科学の先生。"},{"spoiler":false,"text":"いかなる時も崩れないクールなスタンスから全学生に恐れられている。"},{"spoiler":false,"text":"だが実際は性格は見た目とは真逆で、"},{"spoiler":false,"text":"心配性なうえに自分に自信がないという弱気キャラそのもの。"},{"spoiler":false,"text":"普段のキリッとした姿はそれを隠すためだったりする。"},{"spoiler":false,"text":"故あってそんな素顔を知っている主人公とは親しい関係で、"},{"spoiler":false,"text":"異性の中では唯一素顔を見せられる関係だったりする。"},{"spoiler":false,"text":"「授業を始めます。各自、席に着きなさい」"}],"source":"bangumi","sourceCharacterId":"67221"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/180fc1cd359396ccd5ca1a1d60c21b83246b7e84747666016b933ec82e297872.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d628b2f891c043c0931769af2e7e4295f0cec4da1bc73841b4d769c439d8ff7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神保巴","creatorId":"vndb:s455","sourcePersonId":"vndb:s455","canonicalEntityId":"vndb:s455","name":"神保 巴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:262374:67221:12718:1","source":"bangumi"}]},{"characterId":"char_c76914","characterName":"パトリシア・ブラウン","sourceIds":{"bangumi":[{"characterId":"67222","match":"exact-normalized-name-in-linked-work","subjectId":"262374"}],"egsCharacterIds":["20875"],"vndbCharacterId":"c76914"},"originalCharacterName":"パトリシア・ブラウン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A foreigner studying abroad in Japan as a newly-appointed English teacher."},{"spoiler":false,"text":"Her honest and transparent character allows her to disregard the relationship of student and teacher and make friends with anyone."},{"spoiler":false,"text":"Due to a certain incident, she falls in love with Narumi at first sight and, as a show of how unpredictable she is, immediately starts engaging in sexual relations with him. She is admittedly lecherous, but not vulgar or lewd, and only engages in such activities with those she is comfortable with."},{"spoiler":false,"text":"This high-octane girl is the reason Mitama and Aya are spurred into action."},{"spoiler":false,"text":"translated and modified from official website"}],"source":"vndb","sourceCharacterId":"c76914"},{"segments":[{"spoiler":false,"text":"新しく学園にやってくることになった本物の英語の先生。始終陽気なハイテンション人。"},{"spoiler":false,"text":"行動力の塊で思ったら即行動するタイプ。何でもノープランで突撃するが、それでも何とかなってしまうラッキー体質でもある。"},{"spoiler":false,"text":"ボディタッチ全開で初対面でもとにかく精神的・物理的に距離が近い。"},{"spoiler":false,"text":"性的なことも気軽にネタにするが、恥ずかしげもなくあけっぴろげなため、かえっていやらしさを感じさせない。まさに役得。"},{"spoiler":false,"text":"そういった面から男女関係もルーズに思われがちだが、そこについてはちゃんと一線を引いている大人でもある（だからといって節操があるというわけではないので注意）"}],"source":"egs","sourceCharacterId":"20875","sourceWorkId":"27284","spoiler":false},{"segments":[{"spoiler":false,"text":"新しい英語の教師として留学してくる外国人の女性。"},{"spoiler":false,"text":"裏表のないあっけらかんとした性格で、"},{"spoiler":false,"text":"学生と教師という関係を無視して誰とでも親しくなれる、"},{"spoiler":false,"text":"生来の明るさを持った太陽のような人物。"},{"spoiler":false,"text":"とある事件から主人公に一目惚れし、"},{"spoiler":false,"text":"即座に肉体関係をもってしまうという破天荒っぷりを見せる。"},{"spoiler":false,"text":"確かに股はゆるいが下品で淫乱というわけではなく、"},{"spoiler":false,"text":"そんなことをするのは気を許した相手だけ。"},{"spoiler":false,"text":"パティの登場によってみたまと綾も行動に出ざるをえなくなった全ての元凶となるハイテンション・ガール。"},{"spoiler":false,"text":"「ハグぐらい普通デス♪アァ、もしかしておっぱいが気になりマスか？」"}],"source":"bangumi","sourceCharacterId":"67222"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e54984602380f57f9f3b8638f834803feff93e9655fdffb292cfc5e12b40df3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dda2b950c615cd1511c21e3b0699c8c9dc6f762f2a544949dcf549a32c41a8bb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朝比奈幸","creatorId":"vndb:s21648","sourcePersonId":"vndb:s21648","canonicalEntityId":"vndb:s21648","name":"朝比奈 幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:262374:67222:17080:1","source":"bangumi"},{"creditedName":"綾音 まこ","creatorId":"vndb:s2581","sourcePersonId":"vndb:s2581","canonicalEntityId":"vndb:s2581","name":"綾音 まこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:79533","source":"vndb"}]},{"characterId":"char_vndb_c76922","characterName":"石道 鳴海","sourceIds":{"vndbCharacterId":"c76922"},"originalCharacterName":"石道 鳴海","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The story's protagonist."},{"spoiler":false,"text":"A young man who has become exceedingly caring, mainly thanks to Mitama."},{"spoiler":false,"text":"Perhaps because of being around irresponsible people growing up, he has become a stable man. He is therefore a man of action, and often finds himself at the center of things. Despite being a bit of a hassle, he is fundamentally a good person who will always work for the good of others."},{"spoiler":false,"text":"translated and modified from official website"}],"source":"vndb","sourceCharacterId":"c76922"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fec5caba4c47d3cdc815c7b6f2ea99163985ca2ee376f65149615bb4e0576fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14afa04be5ddb65455454c7eac7f2a47a142a367cd17cfd4dec237b1466a3f55.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p4552","sourceCompanyId":"egs:brand:4679","canonicalEntityId":"vndb:p4552","name":"アストロノーツ・コメット","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:27284:4679","source":"egs"},{"companyId":"vndb:p25859","sourceCompanyId":"vndb:p25859","canonicalEntityId":"vndb:p25859","name":"ransuko","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:151880:v24507","source":"vndb"},{"companyId":"vndb:p2692","sourceCompanyId":"vndb:p2692","canonicalEntityId":"vndb:p2692","name":"Astronauts","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb: