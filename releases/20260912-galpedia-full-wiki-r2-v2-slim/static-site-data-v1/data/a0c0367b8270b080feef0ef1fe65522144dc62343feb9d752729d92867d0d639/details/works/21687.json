8571","canonicalEntityId":"vndb:s8571","name":"風李 たゆ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:101333","source":"vndb"},{"creditedName":"磯谷 佳江","creatorId":"vndb:s9818","sourcePersonId":"vndb:s9818","canonicalEntityId":"vndb:s9818","name":"磯谷 佳江","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:101334","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c25822","characterName":"ルシア・ソル","sourceIds":{"vndbCharacterId":"c25822"},"originalCharacterName":"ルシア・ソル","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist, a girl who lives together with her uncle Horik."},{"spoiler":false,"text":"She helps out at the cafe \"Kokono Kokono\"."},{"spoiler":false,"text":"Because of her calm atmosphere and kind personality, many customers come to the cafe just to talk with her."},{"spoiler":false,"text":"When the strange event hit the peaceful bustling streets her hourglass started giving off a strong light."}],"source":"vndb","sourceCharacterId":"c25822"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1e7716da00f2f6ef47fb14d90eac5176928fa0e37776ebe34bdd632e90ad608.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/735910263767018dd907e235ff3fb45f42d4f526f6e0911b5a29f261282161fe.webp","width":216,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c25823","characterName":"キョウゴ・ナギ","sourceIds":{"vndbCharacterId":"c25823"},"originalCharacterName":"キョウゴ・ナギ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He's curt and shy but despite that he's a helpful person, the protagonist's childhood friend."},{"spoiler":false,"text":"Using his natural good reflexes he works as a bodyguard."},{"spoiler":false,"text":"He tended to be teased a lot as a child, so he always stayed by the protagonist's side."},{"spoiler":false,"text":"For a certain reason he finds it distasteful to trade time, so he doesn't use the BANK at all."}],"source":"vndb","sourceCharacterId":"c25823"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/adb95398424481d64223a16209841e57760bee58e9b0fd08be7f304ceaef6185.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0413ecbf3526413f419d825b316597f91e218e4ee104e728bc566b2ac012e03.webp","width":216,"height":256,"source":"static-detail"},"actors":[{"creditedName":"逢坂 良太","creatorId":"vndb:s248","sourcePersonId":"vndb:s248","canonicalEntityId":"vndb:s248","name":"逢坂 良太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54197","source":"vndb"}]},{"characterId":"char_vndb_c25824","characterName":"ティオ","sourceIds":{"vndbCharacterId":"c25824"},"originalCharacterName":"ティオ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An unpredictable and spoiled child, however he is a famous artist who's paintings sell for exorbitant amounts of money."},{"spoiler":false,"text":"He's moved into a studio above the Kokono Kokono cafe. When he's excited he jumps up and down, when he's tired he sleeps on your lap, he's that kind of a cat-like person."},{"spoiler":false,"text":"However, for some reason he has the problem of not being able to keep his memories for more than one day."}],"source":"vndb","sourceCharacterId":"c25824"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/178548373b0783a25c6ea609625b89f32920ea204cf2d73b361a0f6e97146107.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/0378a20dcfe106a0d0ec4872b64dbadae9b5f94e5b1ea0cd41e038fb1824dbcc.webp","width":216,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松岡 禎丞","creatorId":"vndb:s748","sourcePersonId":"vndb:s748","canonicalEntityId":"vndb:s748","name":"松岡 禎丞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54201","source":"vndb"}]},{"characterId":"char_vndb_c25825","characterName":"クライヴ・ニール","sourceIds":{"vndbCharacterId":"c25825"},"originalCharacterName":"クライヴ・ニール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A genius who's called \"The Walking Royal Library\"."},{"spoiler":false,"text":"He has a haughty attitude and refuses to give in to anyone, he always respects the rules. Sometimes despite the fact that he's a genius he messes up his words, but he doesn't personally take notice at all."},{"spoiler":false,"text":"He's a high ranking member of the royal police \"Vanalgand\" that gets support from BANK."},{"spoiler":false,"text":"He has a cool headed way of speaking, but his weak point is sweets."}],"source":"vndb","sourceCharacterId":"c25825"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ceda44133daee5a45ef5d958850387e5e79b9322510b5b12a87c29475bcba8fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5a2af67ab57a5e5f0179ac9b36359a38b341a97f951328758cd8574b709c326.webp","width":216,"height":256,"source":"static-detail"},"actors":[{"creditedName":"緑川 光","creatorId":"vndb:s73","sourcePersonId":"vndb:s73","canonicalEntityId":"vndb:s73","name":"緑川 光","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54194","source":"vndb"}]},{"characterId":"char_vndb_c25826","characterName":"ホリック・ソル","sourceIds":{"vndbCharacterId":"c25826"},"originalCharacterName":"ホリック・ソル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Owner of the Kokono Kokono cafe."},{"spoiler":false,"text":"Ten years ago he started taking care of the protagonist who had lost all her relatives, they currently live together."},{"spoiler":false,"text":"He possesses the glamor of an adult combined with a tolerant personality, a \"wise man\", or possibly just an \"eccentric\"."},{"spoiler":false,"text":"Because he sometimes does things that transcend common sense, the meaning of his words is occasionally hard to understand."},{"spoiler":false,"text":"His outward face is just a cafe owner, however his true personality is shrouded in mystery."}],"source":"vndb","sourceCharacterId":"c25826"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c374da05d35078e05981854dd351369a1576f1022a82f5e4b8a5c99152b1fbf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec1c97e6a0cd3210c6cfdfd8fdce7096bedd7db1307a398afaf4510383b435b1.webp","width":216,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤原 啓治","creatorId":"vndb:s384","sourcePersonId":"vndb:s384","canonicalEntityId":"vndb:s384","name":"藤原 啓治","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54198","source":"vndb"}]},{"characterId":"char_vndb_c25827","characterName":"エヴァ","sourceIds":{"vndbCharacterId":"c25827"},"originalCharacterName":"エヴァ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He's a member of the extremely popular circus troupe \"Luna Kirks\", he's their pride, the Top Star Magician, almost like an Idol."},{"spoiler":false,"text":"Everyplace he performs he shows off astounding magic."},{"spoiler":false,"text":"The price of admission however is not money but people's \"time\"."},{"spoiler":false,"text":"Underneath his gentlemanly smiling face he holds a somewhat suspicious shadow."}],"source":"vndb","sourceCharacterId":"c25827"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4ffa963fc2e2e1f13e6a7b37c666d97dacf882cef2dd5da71bb8eb8e826472bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06e0eccff5c87dc8bdc5cb92f8c3859a7f2b48b063bac4ae71d0e09939c99e5d.webp","width":216,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阿部 敦","creatorId":"vndb:s633","sourcePersonId":"vndb:s633","canonicalEntityId":"vndb:s633","name":"阿部 敦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:54199","source":"vndb"}]},{"characterId":"char_vndb_c25828","characterName":"アダム","sourceIds":{"vndbCharacterId":"c25828"},"originalCharacterName":"アダム","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"seg