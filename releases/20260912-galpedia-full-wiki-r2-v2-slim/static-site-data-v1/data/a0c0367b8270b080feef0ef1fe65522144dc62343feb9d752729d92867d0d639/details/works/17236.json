"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/763dca17bd7b4b3cef241d2c09ddc41e8bcf5f2ea5a848bc7d02d4a5cb897224.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be363e496f0f78a2ea85e64ec1a2b07d390c388eadcae611d13f80b207e04ee2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みる","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41238","source":"vndb"}]},{"characterId":"char_c14843","characterName":"高階 なつみ","sourceIds":{"bangumi":[{"characterId":"12301","match":"exact-normalized-name-in-linked-work","subjectId":"14512"}],"egsCharacterIds":["9820"],"vndbCharacterId":"c14843"},"originalCharacterName":"高階 なつみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"近所にある神社が実家の、ひとつ年上の幼なじみ。"},{"spoiler":false,"text":"サバサバした性格で新しいものが好きな優しいお姉ちゃん。"},{"spoiler":false,"text":"実家ではずっと弟と相部屋で、それがイヤだったらしく、学園入学と同時に八嶋荘に入寮した。"},{"spoiler":false,"text":"幼い頃は主人公と一緒に空手道場に通っていて、数々の大会で軽く優勝したりする天才的才能を発揮。"},{"spoiler":false,"text":"だが、足が太くなるのがイヤという理由で今はやっていない。"},{"spoiler":false,"text":"得意の空手はバカ弟へのお仕置きによく使われる。"},{"spoiler":false,"text":"密かに料理が得意だけれど入寮してからは、主人公に甘えて作ってもらうばかり。"},{"spoiler":false,"text":"「大輔が本当の弟だったらよかったのにね」"}],"source":"egs","sourceCharacterId":"9820","sourceWorkId":"13247","spoiler":false},{"segments":[{"spoiler":false,"text":"近所にある神社が実家の、ひとつ年上の幼馴染。"},{"spoiler":false,"text":"サバサバした性格で新しいものが好きな優しいお姉ちゃん。"},{"spoiler":false,"text":"実家ではずっと弟と相部屋で、それがイヤだったらしく、学園入学と同時に八嶋荘に入寮した。"},{"spoiler":false,"text":"幼い頃は主人公と一緒に空手道場に通っていて、数々の大会で軽く優勝したりする天才的才能を発揮。"},{"spoiler":false,"text":"だが、足が太くなるのがイヤという理由で今はやっていない。"},{"spoiler":false,"text":"得意の空手はバカ弟へのお仕置きによく使われる。"},{"spoiler":false,"text":"密かに料理が得意だけれど入寮してからは、主人公に甘えて作ってもらうばかり。"}],"source":"egs","sourceCharacterId":"9820","sourceWorkId":"15924","spoiler":false},{"segments":[{"spoiler":false,"text":"老家是附近的神社，比主人公大一岁的青梅竹马。"},{"spoiler":false,"text":"性格五大三粗，喜欢新奇事物又有点温柔的姐姐。"},{"spoiler":false,"text":"因为不愿意在家里和弟弟共用一个房间，所以在入学就马上住进了八嶋荘。"},{"spoiler":false,"text":"小时候和主人公一起在空手道场认识，在各个大会获得过众多的奖项，被认为是空手道的天才，因为害怕脚变得粗起来所以现在已经没有练了。"},{"spoiler":false,"text":"那达人级的空手道现在只用在教训弟弟上面。"},{"spoiler":false,"text":"其实料理也相当的不错，不过住进宿舍之后就向主人公撒娇让他包办了一日三餐"}],"source":"bangumi","sourceCharacterId":"12301"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/30747632c8b5aca30f90430d98d1f7eede9f875b4fb485f4cb8c23bf1f231bc7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3e4262c3bee65d5e47eda106981e7dda84c7f78e6117c9071e9900cdbbb9e80.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柚木 かなめ","creatorId":"vndb:s13","sourcePersonId":"vndb:s13","canonicalEntityId":"vndb:s13","name":"河原木 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41236","source":"vndb"}]},{"characterId":"char_c28572","characterName":"宮園 瞳","sourceIds":{"bangumi":[{"characterId":"13119","match":"exact-normalized-name-in-linked-work","subjectId":"15182"}],"egsCharacterIds":["6778"],"vndbCharacterId":"c28572"},"originalCharacterName":"宮園 瞳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1010"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"height":{"reviewState":"no-conflict","source":"vndb","value":"146"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"70"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"As a first-year, she looks up to and admires Satoshi. She's a genius scientist, the type that only comes around once every century. She specializes in robotics, priding herself on having built a completely functional maid-robot. She's really passionate about her own \"Mage Club\", and her goal is to make friends."},{"spoiler":false,"text":"From Sol Press"}],"source":"vndb","sourceCharacterId":"c28572"},{"segments":[{"spoiler":false,"text":"学園の後輩で、主人公を慕い、懐いてくるお嬢様。"},{"spoiler":false,"text":"実は天才科学者で、特にロボット開発の分野に力を入れていて、瞳が制作したメイドロボがすでに稼動している。"},{"spoiler":false,"text":"幼い頃から研究者として働いていて、国内外数え切れない数の企業から技術利用収入を得ているが、お金には無関心。"},{"spoiler":false,"text":"仕事の空き時間には、自身が立ち上げた 『魔法部』 の活動を熱心に行い、友達をたくさん作る夢のために頑張っている。"}],"source":"egs","sourceCharacterId":"6778","sourceWorkId":"14500","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の後輩で、主人公を慕い、懐いてくるお嬢様。"},{"spoiler":false,"text":"実は天才科学者で、特にロボット開発の分野に力を入れていて、瞳が制作したメイドロボがすでに稼動している。"},{"spoiler":false,"text":"幼い頃から研究者として働いていて、国内外数え切れない数の企業から技術利用収入を得ているが、お金には無関心。"},{"spoiler":false,"text":"仕事の空き時間には、自身が立ち上げた 『魔法部』 の活動を熱心に行い、"},{"spoiler":false,"text":"友達をたくさん作る夢のために頑張っている。"},{"spoiler":false,"text":"「先輩、捕まえました！　もう離しませんよ！」"}],"source":"egs","sourceCharacterId":"6778","sourceWorkId":"17236","spoiler":false},{"segments":[{"spoiler":false,"text":"聡的学妹，仰慕着聡，总爱粘着他。"},{"spoiler":false,"text":"其实是天才科学家，尤其在开发机器人的领域上有着相当高的实力，她所制作的女仆机器人早已在正常运作了。"},{"spoiler":false,"text":"从小就作为研究人员努力着，现在已经从国内外诸多采用她技术的企业那里取得不菲收入，只是她对金钱却毫无兴趣。"},{"spoiler":false,"text":"一有空她就会积极举行自己创办的『魔法部』的社团活动，为了交上更多朋友而不懈努力中。"}],"source":"bangumi","sourceCharacterId":"13119"}],"profileFacts":[{"label":"胸围（本版本）","value":"72 cm","valueContext":null,"source":"egs","sourceCharacterId":"6778","sourceWorkId":"17236","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"146 cm","valueContext":null,"source":"egs","sourceCharacterId":"6778","sourceWorkId":"17236","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"6778","sourceWorkId":"17236","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"6778","sourceWorkId":"17236","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de62e3433a0a25ba3fc3ed0b466ab2183224118fa6e785dc9b96a18a0ce8b55e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d04d97be46f81786297d3869cc54e9c6db7e7c839f4731393684ff0a7282c3c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴田 美夜子","creatorId":"vndb:s446","sourcePersonId":"vndb:s446","canonicalEntityId":"vndb:s446","name":"若林 直美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41239","source":"vndb"}]},{"characterId":"char_c28574","characterName":"鷲尾 凛","sourceIds":{"bangumi":[{"characterId":"13121","match":"exact-normalized-name-in-linked-work","subjectId":"15182"}],"egsCharacterIds":["6780"],"vndbCharacterId":"c28574"},"originalCharacterName":"鷲尾 凛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"519"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"AB"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A hot-blooded, blunt girl from Satoshi's class. She's keeping her distance from her classmates, and is often seen wandering alone in the school. Her rude and uncaring personality gets turned on its head the moment she steps on stage as the popular idol, RIN. Her sweet smile and voice of an angel charms anyone who lays eyes on this side of hers."},{"spoiler":false,"text":"From Sol Press"}],"source":"vndb","sourceCharacterId":"c28574"},{"segments":[{"spoiler":false,"text":"同じクラスに在籍し、人気アイドル歌手・リン として活躍しているお嬢様。"},{"spoiler":false,"text":"実は極道の娘で、普段の学園での凛はクラスから浮いていて、周囲と一切関わろうとしない一匹狼。"},{"spoiler":false,"text":"声をかける主人公にも素っ気ない態度と罵倒を繰り返す。"},{"spoiler":false,"text":"その一方で少女漫画を密かに愛読していたり、暗闇やお化けを怖がったりする面もあるのだが……。"}],"source":"egs","sourceCharacterId":"6780","sourceWorkId":"14500","spoiler":false},{"segments":[{"spoiler":false,"text":"同じクラスに在籍し、人気アイドル歌手・リン として活躍しているお嬢様。"},{"spoiler":false,"text":"実は極道の娘で、普段の学園での凛はクラスから浮いていて、周囲と一切関わろうとしない一匹狼。"},{"spoiler":false,"text":"声をかける主人公にも素っ気ない態度と罵倒を繰り返す。"},{"spoiler":false,"text":"その一方で少女漫画を密かに愛読していたり、暗闇やお化けを怖がったりする面もあるのだが……。"},{"spoiler":false,"text":"「馴れ馴れしい。気安く話しかけるな！」"}],"source":"egs","sourceCharacterId":"6780","sourceWorkId":"17236","spoiler":false},{"segments":[{"spoiler":false,"text":"和聡是同班同学，可她却是以リン为艺名出道的活跃人气偶像歌手。"},{"spoiler":false,"text":"实际上她是黑社会家的女儿，平时在学校也跟他人显得格格不入，简直就是不溶入群体的一匹狼。"},{"spoiler":false,"text":"每次聡向她搭话也总被她冷言相向。"},{"spoiler":false,"text":"另一方面，暗地里她其实很喜欢看少女漫画，也胆小得极度害怕黑暗和鬼怪。"}],"source":"bangumi","sourceCharacterId":"13121"}],"profileFacts":[{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"6780"