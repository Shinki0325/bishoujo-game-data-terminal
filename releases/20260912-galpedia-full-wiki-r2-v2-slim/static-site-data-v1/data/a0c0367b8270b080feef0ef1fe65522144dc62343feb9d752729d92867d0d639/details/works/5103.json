{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"5103","model":{"presentationWorkId":"vndb:v6778","staff":{"artwork":[{"creditedName":"黒岩よしひろ","creatorId":"vndb:s6921","sourcePersonId":"egs:creator:2806","canonicalEntityId":"vndb:s6921","name":"黒岩よしひろ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:8768","source":"egs"}],"scenario":[{"creditedName":"めたるex8","creatorId":"vndb:s7383","sourcePersonId":"egs:creator:3817","canonicalEntityId":"vndb:s7383","name":"めたるex8","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:13704","source":"egs"}],"music":[{"creditedName":"井出今日子(KYOKO IDE)","creatorId":"vndb:s2568","sourcePersonId":"egs:creator:2552","canonicalEntityId":"vndb:s2568","name":"井出今日子(KYOKO IDE)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:13857","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c31925","characterName":"風鈴寺 舞衣","sourceIds":{"bangumi":[{"characterId":"48052","match":"exact-normalized-name-in-linked-work","subjectId":"197208"}],"egsCharacterIds":["26640"],"vndbCharacterId":"c31925"},"originalCharacterName":"風鈴寺 舞衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"メインヒロイン。"},{"spoiler":false,"text":"正義感が強く思い切りのいい、明るく前向きな性格。"},{"spoiler":false,"text":"剣技を駆使。属性は風。"},{"spoiler":false,"text":"幼少の頃から祖父と２人暮らし。"},{"spoiler":false,"text":"（現在は美羽、魔夜と学園近くのマンションで同居。）"},{"spoiler":false,"text":"剣技は祖父からの直伝。"},{"spoiler":false,"text":"母は舞衣を生んだ後病死。父は幼少の頃妖魔に殺されている。"},{"spoiler":false,"text":"幼少に父が亡くなっている為かファザコン気味。"},{"spoiler":false,"text":"戦いに身を投じるのは殺された父の復讐の思いよりも、むしろ正義感から。"},{"spoiler":false,"text":"当初はペンジュラムを使いこなせていなかったが目の前で子供が妖魔に襲われそうになり「救いたい」という純粋な気持ちから変身できるようになった。"},{"spoiler":false,"text":"自分の力で人が救えるなら、と戦いに関しては前向き。"}],"source":"egs","sourceCharacterId":"26640","sourceWorkId":"5103","spoiler":false},{"segments":[{"spoiler":false,"text":"幼少の頃から祖父と２人暮らし。剣技は祖父からの直伝。代々退魔の家系に育つ。"},{"spoiler":false,"text":"母は舞衣を生んだ後病死。父は幼少の頃妖魔に殺されている。"},{"spoiler":false,"text":"舞衣はその現場を目撃してしまいペンジュラムを自ら生成。"},{"spoiler":false,"text":"緋燕への憧れはこの為と幼少から剣の修行ばかりで男に免疫がなかったから。"},{"spoiler":false,"text":"敵との戦闘は殺された父の復讐の思いもありますが、むしろ正義感から。"},{"spoiler":false,"text":"当初はペンジュラムを使いこなせていなかったが目の前で子供が妖魔に襲われそうになり「目の前の人たちを救いたい」という純粋な正義感から変身できるようになった。"}],"source":"bangumi","sourceCharacterId":"48052"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64ba6fe9d679609ff9c17ecfbf820423811c64ef72679a1241003d828cb06877.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a370c91669c964e89f80f7e39f1902d69e8be22e92edbe602be16fb6bd239ca.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紬叶慧","creatorId":"vndb:s2920","sourcePersonId":"vndb:s2920","canonicalEntityId":"vndb:s2920","name":"紬 叶慧","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197208:48052:25798:1","source":"bangumi"}]},{"characterId":"char_c31926","characterName":"水蓮堂 美羽","sourceIds":{"bangumi":[{"characterId":"109994","match":"exact-normalized-name-in-linked-work","subjectId":"197208"}],"egsCharacterIds":["26641"],"vndbCharacterId":"c31926"},"originalCharacterName":"水蓮堂 美羽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"おっとりとしてとぼけた性格。飛び級という設定で舞衣達と同じ学園に席を置く。"},{"spoiler":false,"text":"信頼した相手にはべったり甘える。好き嫌いが激しく出るタイプ。"},{"spoiler":false,"text":"武器は杖。光弾を撃ったり防御用の壁を発生させたりと主にサポート役。属性は水。"},{"spoiler":false,"text":"一人称　美羽。幼少時不思議な力に目覚め自らペンジュラムを生成。"},{"spoiler":false,"text":"直後両親が美羽の元を離れており、それは自分の力を気味悪がられたせいだと美羽は思っている。（実際の理由は不明。）"},{"spoiler":false,"text":"ペンジュラムを狙った妖魔に襲われ感情が制御できず力が暴走。"},{"spoiler":false,"text":"妖魔と戦闘中だった舞衣が制止。"},{"spoiler":false,"text":"同じ力を持つ者として優しく迎え入れられ心を開き舞衣と共に戦うようになる。"},{"spoiler":false,"text":"舞衣や魔夜のおかげで幼少のトラウマは感じさせないが時折寂しそうな一面を見せる。"},{"spoiler":false,"text":"明るい性格とは裏腹に愛情に飢えており、メンバーにべったりと甘えている。"},{"spoiler":false,"text":"制御できないほどの自分の力に対する恐怖のため実力を発揮できていないところがある。"},{"spoiler":false,"text":"敵との戦闘理由はやっと見つけた暖かい仲間や友達を守るため。"},{"spoiler":false,"text":"だが、基本的に自分の力を嫌っているせいか戦いにはネガティブ。"}],"source":"egs","sourceCharacterId":"26641","sourceWorkId":"5103","spoiler":false},{"segments":[{"spoiler":false,"text":"幼少から不思議な力に目覚め自ら石を生成。その為両親から気味悪がられ施設を転々とする。"},{"spoiler":false,"text":"ペンジュラムを狙った妖魔に襲われ感情が制御できず力が暴走。妖魔と戦闘中だった舞衣が制止。"},{"spoiler":false,"text":"同じ力を持つ者として優しく迎え入れられて心を開くようになり共に戦うようになる。"},{"spoiler":false,"text":"舞衣や魔夜のおかげで幼少のトラウマは感じさせないがが時折寂しそうな顔を見せる。"}],"source":"bangumi","sourceCharacterId":"109994"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab991455d0ea147a8dab192f308a40ef83b569cf8118621363443c95389b70d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/787e892dd57dfe41e910a2e256aa5bab35612319000ed32a02a998adad11dfcd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹間千ノ美","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197208:109994:19333:1","source":"bangumi"}]},{"characterId":"char_c31927","characterName":"火練峰 魔夜","sourceIds":{"bangumi":[{"characterId":"109995","match":"exact-normalized-name-in-linked-work","subjectId":"197208"}],"egsCharacterIds":["26642"],"vndbCharacterId":"c31927"},"originalCharacterName":"火練峰 魔夜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"クールで物事には動じない性格。口数は少なく人とは距離を置くタイプ。"},{"spoiler":false,"text":"仲間を心から信用していても気が付くと何でも一人で背負ってしまおうとする。"},{"spoiler":false,"text":"戦闘は打撃攻撃。属性は火。"},{"spoiler":false,"text":"天涯孤独。自分の出生すら知らない。"},{"spoiler":false,"text":"強い心を持つために格闘技を始め、大会で優秀な成績を残す。"},{"spoiler":false,"text":"数年前、目の前で親友を妖魔に殺される。"},{"spoiler":false,"text":"強くなったと思っていた自分の力が妖魔に全く通用しなかったという虚無感と親友の喪失感から自らペンジュラムを生成。"},{"spoiler":false,"text":"親友の事件以来他人と接することに臆病になる。"},{"spoiler":false,"text":"一人暮らしが長いので家事全般は得意。"},{"spoiler":false,"text":"敵との戦闘は仲間を失いたくないという気持ちから。"},{"spoiler":false,"text":"その為仲間が傷つけられると過剰なまでに怒りを露にする。"},{"spoiler":false,"text":"戦うことに関しては前向きだが根底にあるのは復讐心なので舞衣とはまるで異なる。"}],"source":"egs","sourceCharacterId":"26642","sourceWorkId":"5103","spoiler":false},{"segments":[{"spoiler":false,"text":"天涯孤独。自分の出生すら知らない。"},{"spoiler":false,"text":"数年前、目の前で親友を妖魔に殺され自ら石を生成する。"},{"spoiler":false,"text":"ある戦いで舞衣達に敗れたことで人を思いやる心を思い出し、今までの抜け落ちていた心の一部が仲間と出会うことで取り戻し、共に戦うようになる。"}],"source":"bangumi","sourceCharacterId":"109995"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/2378a7bbc6caeff8459d1ae2f493672f3539b4b7a01b681fdea40abb9f058283.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7b6a29586e93efce11a8e8fa9f1bc85a4fa527313208eed1e6e2dfee16ac122.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:197208:109995:4940:1","so