e-only","source":"bangumi","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大人しく控えめな優等生であり、その可憐な容姿と相俟って、「理想の女の子像」として男子達の憧れの的となっていた。3年前、ふとしたきっかけで隆雪と仲良くなるが、クリスマスイブの日に交通事故に遭ってしまい…。"}],"source":"bangumi","sourceCharacterId":"166869"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"166869","value":"弓道、読書(主に詩集、ヘルマンヘッセ、中原中也、etc)"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8ccacde385c6225a3827cddda94421c93823448684ba621a55bb5157eebaa09.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b89217669e8b2358f54f5bc8e9e7e45a6da4252c6ba49623812cb374605ef15f.webp","width":180,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_166871","characterName":"たちばなゆりこ","sourceIds":{"bangumi":[{"characterId":"166871","match":"source-roster","subjectId":"320897"}]},"originalCharacterName":"たちばなゆりこ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0916"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"o"},"height":{"reviewState":"source-only","source":"bangumi","value":"162"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明るくサッパリとした性格のクラスメイト。美術部に所属しており、雅とは中学以来の親友である。紅茶に詳しく休日にはお菓子作りをするなど、繊細な一面も。隆雪は男友達のような感覚で彼女と接しているが…。"}],"source":"bangumi","sourceCharacterId":"166871"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"166871","value":"紅茶を飲むこと(自分でブレンドしたりもする)、洋菓子作り"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/689ead2e7bef13ea7b4fa4e09f850237b25ba9499bdda7b309306d42f971b725.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65a4449701daf95485393407827cd78813a6579f0600482bebc22a93a4be7df8.webp","width":180,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_166872","characterName":"しののめみゆき","sourceIds":{"bangumi":[{"characterId":"166872","match":"source-roster","subjectId":"320897"}]},"originalCharacterName":"しののめみゆき","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"bangumi","value":"b"},"height":{"reviewState":"source-only","source":"bangumi","value":"170"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"成績優秀、スポーツ万能にして美人。教師の信頼も篤く、学園内では生徒会副会長を務める隆雪の姉。一度家に帰るとその反動か、途端にだらしない本性を現す一面も。デパ地下が好きで、特に物産展にか欠かさず足を運ぶ。"}],"source":"bangumi","sourceCharacterId":"166872"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"166872","value":"ショッピング、カラオケ"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d05fcadeca4249d12fc9ff6cccc27b195414da81ea0cd497d999656c06a76ca9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e1382752a1f2161263002684633987173439b551ad3b0a8b492f34548cc719c.webp","width":180,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_166873","characterName":"はのさつき","sourceIds":{"bangumi":[{"characterId":"166873","match":"source-roster","subjectId":"320897"}]},"originalCharacterName":"はのさつき","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"151"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幼く見られがちな容姿をしているが、隆雪と1つ違うだけの下級生。独特の価値観と天真爛漫な性格で、いつも周りの人間を自分のペースに巻き込んでしまう。趣味が囲碁・将棋、好きな食べ物が栗饅頭、と意外に渋いのは、おじいちゃんの影響らしい。"}],"source":"bangumi","sourceCharacterId":"166873"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"166873","value":"ペンたゴングッズ集め、囲碁、将棋、ヘアピン集め"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95fe1a303ebd257c6227413756cc7a5967dc85c664b260f9dcdb54e5512f6853.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96a42b5ab12618ab503e1561ac4a277ec72d09f1151cf1b1ae8f208c2a296516.webp","width":180,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_166874","characterName":"みやまふうか","sourceIds":{"bangumi":[{"characterId":"166874","match":"source-roster","subjectId":"320897"}]},"originalCharacterName":"みやまふうか","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"bangumi","value":"0113"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"ab"},"height":{"reviewState":"source-only","source":"bangumi","value":"159"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「3年前」の学園生活においては1度も出会うことの無かった謎の美少女。学年的には下級生に当たるが、その瞳はひどく大人びて見える。時折主人公の前に現れては謎めいた言葉を残していく。隆雪の運命を少しずつ変えていく…。"}],"source":"bangumi","sourceCharacterId":"166874"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"166874","value":"料理、ガーデニング、(こっそり)ゲーム"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01d379ad204ae7f16ede2e2cb7b9b5ee2c20f359cf274e5da9a6869471a5a1c6.webp"