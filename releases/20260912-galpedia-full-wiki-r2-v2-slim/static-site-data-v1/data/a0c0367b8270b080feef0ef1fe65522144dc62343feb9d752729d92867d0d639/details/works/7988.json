:"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"”You’ll never know if you don’t try.”"},{"spoiler":false,"text":"Hiro is a full-time student, but moonlights as Shindou Nagi, a professional shoujo manga artist. He is the youngest sibling in a family where his father and sister are both renowned traditional artists. At his core he’s diligent and softhearted, but his outer personality shows otherwise. He communicates bluntly and has difficulty speaking his mind."},{"spoiler":false,"text":"He can also be indecisive. He is influenced by his sister, the Shindou twins (particularly the older one), and countless others, and has poor luck with women in general."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c1592"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0ab432969a76878e565846688060daa4bbab7d6bbab2d207557be0208f3075e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b9d320cf371e5db03a98be4e25b7d032a63e8ea4332985b14e42faf0797dbff7.webp","width":209,"height":256,"source":"static-detail"},"actors":[{"creditedName":"城樹 翔","creatorId":"vndb:s1124","sourcePersonId":"vndb:s1124","canonicalEntityId":"vndb:s1124","name":"泰 勇気","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9332","source":"vndb"}]},{"characterId":"char_vndb_c1593","characterName":"宮村 みやこ","sourceIds":{"vndbCharacterId":"c1593"},"originalCharacterName":"宮村 みやこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"908"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"},"weight":{"reviewState":"source-only","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"”Wha-a-at? Being a copycat is so boring!”"},{"spoiler":false,"text":"Boasting excellence in all facets, she is attractive, has top grades, and is quite athletic. She is, however, known to those around her for being whimsical and selfish."},{"spoiler":false,"text":"She hates being tied down, so skipping class and going home early is simply routine for her. Although most matters are uninteresting to her, she’ll relentlessly seize anything that takes her fancy."},{"spoiler":false,"text":"She’s a troublemaker and sets her own terms."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c1593"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/079a51219f07535941c951903f6885621e3bf25bd917f8597b52e9e0b89f54ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da52bb0816198f6f29baa747dc109ece3823496d4644a0148b054668765290a9.webp","width":209,"height":256,"source":"static-detail"},"actors":[{"creditedName":"赤沢 かえで","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9328","source":"vndb"}]},{"characterId":"char_vndb_c1594","characterName":"新藤 景","sourceIds":{"vndbCharacterId":"c1594"},"originalCharacterName":"新藤 景","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"602"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"76"},"height":{"reviewState":"source-only","source":"vndb","value":"150"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"source-only","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"”Onii-chan? I won’t get mad, so tell me.”"},{"spoiler":false,"text":"The elder of a set of identical twins. Very athletic. A first-year student, Kei is already a starter for the basketball team. She’s determined to win, knows no fear, and is a sadist. Due to the influence of Hirono Hiro, her ”Onii-chan” and friend since they were little, she’s developed a sharp tongue and talks like a man when she gets worked up."},{"spoiler":false,"text":"Proud and somewhat reckless, she gets embarrassed whenever she messes up. She is also not adept in romantic affairs, and has a tendency to believe in fortunes."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c1594"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8ccca20bdd9f979c3e04606af27b05b753131fda087d351fce640938d0fd266a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4117f67f88bc124eda6d66daa1f2a661dcd09aeb819f30d0bfc8b3e362f8d32.webp","width":209,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜井 美鈴","creatorId":"vndb:s1120","sourcePersonId":"vndb:s1120","canonicalEntityId":"vndb:s1120","name":"岡田 純子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9331","source":"vndb"}]},{"characterId":"char_vndb_c5217","characterName":"雨宮 優子","sourceIds":{"vndbCharacterId":"c5217"},"originalCharacterName":"雨宮 優子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"16"},"birthday":{"reviewState":"source-only","source":"vndb","value":"621"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"”Oh my, oh my! Are you that interested in me?”"},{"spoiler":false,"text":"A woman waiting for someone at the church. She could pass as a nun, but doesn’t seem to be affiliated with the church."},{"spoiler":false,"text":"Her origins are unknown, but claims she has some sort of job to perform. Roaming Otowa’s streets, she suddenly presents herself to those who interest her, leaving deep guidance and counsel in a jovial manner."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c5217"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e47019e4bb02cd6ffb73ece087aada3f711449b786fce0d6acf2f724abdc60ad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/18ca65c3c5dcff2aa65becf505f5f2c83917d63d40dc410469df54eba6814929.webp","width":209,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山田 ゆな","creatorId":"vndb:s1119","sourcePersonId":"vndb:s1119","canonicalEntityId":"vndb:s1119","name":"中島 裕美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9330","source":"vndb"}]},{"characterId":"char_vndb_c8626","characterName":"羽山 ミズキ","sourceIds":{"vndbCharacterId":"c8626"},"originalCharacterName":"羽山 ミズキ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1222"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"source-only","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"”Yes! Your dear Mizuki has arrived!”"},{"spoiler":false,"text":"An energetic girl belonging to the basketball team of Otowa Collegiate’s feeder school. Formerly Shindou Kei's junior, she is still quite a devoted fan. Mizuki has quite a few connections at Otowa Collegiate due to her relationship with Kei."},{"spoiler":false,"text":"Frank and spirited. Direct and rash. Charmed by too many things, and not wary of nearly enough, she’s a bit like a puppy. Admires her ”Kei-senpai” and aspires to be a ”cool woman”, though it’s obvious from her upbringing that it’s impossible. Loves shoujo manga."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c8626"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a00db4a523cadfc4e85e81fa9f2f40f0ffcb0dc61a1b1b898cd8dc7ab16f94a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7ea0c0ec5a591da446f6431a996783ba321c06d27deeda1f2950261e1377464.webp","width":209,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安玖深 音","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9329","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p27","sourceCompanyId":"egs:brand:527","canonicalEntityId":"vndb:p27","name":"minori","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:7988:527","source":"egs"},{"companyId":"vndb:p27","sourceCompanyId":"vndb:p27","canonicalEntityId":"vndb:p27","name":"minori","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:2348:v1025","source":"vndb"},{"companyId":"vndb:p28","sourceCompanyId":"vndb:p28","canonicalEntityId":"vndb:p28","name":"No Name Losers","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:2349:v1025","source":"vndb"},{"companyId":"vndb:p1324","sourceCompanyId":"vndb:p1324","canonicalEntityId":"vndb:p1324","name":"Galstars","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:28491:v1025","source":"vndb"}],"missingStates":["confirmed-character-relation-missing"],"source":"terminal-wiki-full-runtime-v7"}}
