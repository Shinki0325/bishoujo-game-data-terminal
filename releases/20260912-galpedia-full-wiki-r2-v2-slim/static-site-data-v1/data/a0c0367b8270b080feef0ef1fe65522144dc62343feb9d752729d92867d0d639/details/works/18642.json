{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"18642","model":{"presentationWorkId":"vndb:v12442","staff":{"artwork":[{"creditedName":"斎藤なつき","creatorId":"vndb:s2566","sourcePersonId":"egs:creator:105","canonicalEntityId":"vndb:s2566","name":"斎藤なつき","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:116493","source":"egs"},{"creditedName":"夕暮ぱいろ","creatorId":"vndb:s3720","sourcePersonId":"egs:creator:9124","canonicalEntityId":"vndb:s3720","name":"夕暮ぱいろ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:116494","source":"egs"}],"scenario":[{"creditedName":"反事象桂林","creatorId":"vndb:s3722","sourcePersonId":"egs:creator:106","canonicalEntityId":"vndb:s3722","name":"反事象桂林","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:116495","source":"egs"},{"creditedName":"坂本江麻","creatorId":"vndb:s913","sourcePersonId":"egs:creator:6852","canonicalEntityId":"vndb:s913","name":"坂本江麻","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:116511","source":"egs"}],"music":[],"other":[{"creditedName":"ひうら まさこ","creatorId":"vndb:s916","sourcePersonId":"vndb:s916","canonicalEntityId":"vndb:s916","name":"ひうら まさこ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:98826","source":"vndb"}]},"cast":[{"characterId":"char_c24728","characterName":"アーク・エテルナ","sourceIds":{"bangumi":[{"characterId":"48009","match":"exact-normalized-name-in-linked-work","subjectId":"77258"}],"egsCharacterIds":["737"],"vndbCharacterId":"c24728"},"originalCharacterName":"アーク・エテルナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"欧州の小国ハイムデールの、由緒ある貴族の出身。"},{"spoiler":false,"text":"不敗の剣「クラウ・ソラス」から力を得て変身し、アーク・エテルナとなって魔族と戦い続けている。"},{"spoiler":false,"text":"気品に溢れ、孤独を好み、正義を守る戦いに身を投じていることに対し、何よりも誇りを感じている。"},{"spoiler":false,"text":"自分にも他人にも厳しい理想主義者だが、その信念が揺らぐと脆い一面も見せてしまうことも。"},{"spoiler":false,"text":"人付き合いはどちらかというと不得手だが、一方で家庭的な面も持ち合わせており、料理を得意としている。戦い方は優雅で隙がない。"}],"source":"egs","sourceCharacterId":"737","sourceWorkId":"18642","spoiler":false},{"segments":[{"spoiler":false,"text":"不敗の剣 “クラウ・ソラス” から力を得て変身する、攻防一体の剣を振るう最強のヒロイン。"},{"spoiler":false,"text":"孤独を好み、自分にも他人にも厳しい理想主義者。 その分信念が揺らぐと脆さも見せる。"},{"spoiler":false,"text":"正義を守る戦いに身を投じていることを何よりも誇りに思っている。"},{"spoiler":false,"text":"人付き合いが不得手で愛想はない。 一方で家庭的な面もあり、家事全般は得意。"}],"source":"bangumi","sourceCharacterId":"48009"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96781a074026766631e0585761f8cfcb45ba941f1dd71b954cdf6e28f3670806.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64f4c3357377002a50376e4b4fac9bd67011241ca21a22202c8159592351aa76.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:77258:48009:5936:1","source":"bangumi"}]},{"characterId":"char_c24729","characterName":"アーク・レゾン","sourceIds":{"bangumi":[{"characterId":"48010","match":"exact-normalized-name-in-linked-work","subjectId":"77258"}],"egsCharacterIds":["738"],"vndbCharacterId":"c24729"},"originalCharacterName":"アーク・レゾン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"歴史ある神社の宮司の家系に育った少女。"},{"spoiler":false,"text":"裁きの剣「カテナ」から力を得て変身し、アーク・レゾンとなって学園とその周囲を守って戦っている。"},{"spoiler":false,"text":"無私・無欲で正義に身を捧げており、常に微笑みを絶やさない。"},{"spoiler":false,"text":"柔和な性格だが、芯は強く、本来は嫌がっているはずの戦いから逃げることなく使命を全うしている。たまに常人とは違う発想をしたり、周りを困惑させてしまう一面もある。料理なども得意だが、好みが渋すぎて朔夜などには不評。"},{"spoiler":false,"text":"戦いの際はあえて前へ出ずに周囲に気を配り、支援に回ることが多い。"}],"source":"egs","sourceCharacterId":"738","sourceWorkId":"18642","spoiler":false},{"segments":[{"spoiler":false,"text":"裁きの剣 “カテナ” から力を得て変身する。"},{"spoiler":false,"text":"常に冷静で参謀的な役割。 無私・無欲で正義に身を捧げている。"},{"spoiler":false,"text":"人懐っこく微笑みを絶やさないが、芯は強い。"},{"spoiler":false,"text":"どこか常人とは違う思考をしてしまうことがあり、周りを困惑させることも。"},{"spoiler":false,"text":"戦いの際は何でもこなすが、あえて前へ出ずに周囲に気を配り、支援に徹する。"}],"source":"bangumi","sourceCharacterId":"48010"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a34e9bd4892d358f7b50389721ee8db3f74094e888e69866d8f6a625dc7bf46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c732942ec01f8e2b149d66f20b918f06345f7cca11ed7ff56e9a732830011dcd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由倉奈於","creatorId":"vndb:s923","sourcePersonId":"vndb:s923","canonicalEntityId":"vndb:s923","name":"由倉 奈於","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:77258:48010:6083:1","source":"bangumi"}]},{"characterId":"char_c24730","characterName":"アーク・フラム","sourceIds":{"bangumi":[{"characterId":"48011","match":"exact-normalized-name-in-linked-work","subjectId":"77258"}],"egsCharacterIds":["739"],"vndbCharacterId":"c24730"},"originalCharacterName":"アーク・フラム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"両親を知らずに施設で育った少女。"},{"spoiler":false,"text":"征伐の刀「大蛇斬」から力を得て変身し、アーク・フラムとなってアーク・レゾンとともに戦っている。"},{"spoiler":false,"text":"転入してきたばかりの暮色をライバル視する。強気で負けず嫌い、後先考えずに行動してしまい、窮地に陥ることも。"},{"spoiler":false,"text":"戦い方は突撃や力押しが多い。"}],"source":"egs","sourceCharacterId":"739","sourceWorkId":"18642","spoiler":false},{"segments":[{"spoiler":false,"text":"征伐の刀 “大蛇斬（おろちぎり）” から力を得て変身する。"},{"spoiler":false,"text":"プライドの高い強気系。 負けず嫌いで後先考えずに行動し、暮芭をライバル視している。"},{"spoiler":false,"text":"幼い頃から剣術を習い、戦うことで自己の価値を高め、他人からの畏敬を集めたいと思っている。"},{"spoiler":false,"text":"素直じゃないが、認めた相手には甘えることも。"},{"spoiler":false,"text":"可愛く着飾るのが好きだが、人に見られるのは恥ずかしい。"},{"spoiler":false,"text":"戦い方は突撃＆力押し。"}],"source":"bangumi","sourceCharacterId":"48011"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffc8c953d341ef542e82902627517410b1af1d2bdb7dd1bb01775e339426591e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57879fbc71212cc3bcbfdd4a4b64f80b407db1b2028fa3744e868e2d842835dc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"峰岸由香里","creatorId":"vndb:s925","sourcePersonId":"vndb:s925","canonicalEntityId":"vndb:s925","name":"峰岸 由香里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:77258:48011:5939:1","source":"bangumi"}]},{"characterId":"char_c24731","characterName":"イブリル","sourceIds":{"bangumi":[{"characterId":"48012","match":"exact-normalized-name-in-linked-work","subjectId":"77258"}],"egsCharacterIds":["740"],"vndbCharacterId":"c24731"},"originalCharacterName":"イブリル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔族の中でも由緒ある生まれで美貌と才能に溢れており、子供っぽい残酷さと冷淡さを備えている。"},{"spoiler":false,"text":"いずれは魔族を統べる地位を約束されているが、尊大で高慢な態度から敵が多い。"},{"spoiler":false,"text":"見下していた主人公の罠に嵌り部下にされる。"}],"source":"egs","sourceCharacterId":"740","sourceWorkId":"18642","spoiler":false},{"segments":[{"spoiler":false,"text":"魔族の女幹部。"},{"spoiler":false,"text":"魔族の中でも由緒ある生まれで、美貌と才能にあふれており、子供っぽい残酷さと冷酷さを備えている。"},{"spoiler":false,"text":"いずれは魔族を統べる地位を約束されているが、尊大で高慢な態度から敵が多い。"},{"spoiler":false,"text":"見下していた主人公の罠にハマり、部下にされる。"}],"source":"bangumi","sourceCharacterId":"48012"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/092e8df11e8c6d0abc53eec2943ecd6503ac9e7cbb67b40eb48527474d611540.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cf870618061cecbf436a34a7498416818cd199f2167a7db0540a0dea466b970.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:77258:48012:5900:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:208","sourceCompanyId":"egs:brand:208","canonicalEntityId":"egs:brand:208","name":"Triangle","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:18642:208","source":"egs"},{"companyId":"vndb:p187","sourceCompanyId":"vndb:p187","canonicalEntityId":"vndb:p187","name":"アイチェリー","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:155865:v12442","source":"vndb"},{"companyId":"vndb:p332","sourceCompanyId":"vndb:p332","canonicalEntityId":"vndb:p332","name":"Triangle","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:155866:v12442","source":"vndb"},{"companyId":"vndb:p332","sourceCompanyId":"vndb:p332","canonicalEntityId":"vndb:p332","name":"Triangle","roleCodes":["dev