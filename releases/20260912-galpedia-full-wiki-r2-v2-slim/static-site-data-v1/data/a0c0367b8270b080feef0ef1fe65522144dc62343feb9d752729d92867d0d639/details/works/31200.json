d":"vndb:s18308","sourcePersonId":"vndb:s18308","canonicalEntityId":"vndb:s18308","name":"ポケットサウンド","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:175369","source":"vndb"},{"creditedName":"はるじおん","creatorId":"vndb:s26673","sourcePersonId":"vndb:s26673","canonicalEntityId":"vndb:s26673","name":"はるじおん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:175370","source":"vndb"},{"creditedName":"株式会社エモ","creatorId":"vndb:s26674","sourcePersonId":"vndb:s26674","canonicalEntityId":"vndb:s26674","name":"株式会社エモ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:175371","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c109947","characterName":"卜部 幸多","sourceIds":{"vndbCharacterId":"c109947"},"originalCharacterName":"卜部 幸多","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c97830","characterName":"お夏","sourceIds":{"vndbCharacterId":"c97830"},"originalCharacterName":"お夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Under the authority granted to her by the Royal Court of Kitsune and Tanuki, she governs the land of Toyoho Naminokuni. Her mom's aunt is a concubine to a loyal retainer serving the Ouji Great God of Harvest. In other words, she's some big-shot kitsune's distant relative, and she's tasked with overseeing the general area around Kouta's house."},{"spoiler":false,"text":"Influenced by human culture, her interests are very otaku-oriented, and she's so fond of kogals that she bought a tanning bed just to look like one. Her favorite food is fried tofu... actually, no, make that mayonnaise."},{"spoiler":false,"text":"Very much a product of modern society, Onatsu likes to browse the web, play multiplayer online games, and also maintains a food blog. She also sells cosplay photo albums online that feature herself and her best friend Otama. The two of them utilize their shape-shifting prowess to spice up their photoshoots."},{"spoiler":false,"text":"She's been acquainted with Kouta's family line for many, many decades (perhaps centuries), and she tends to get along particularly well with middle-aged men."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c97830"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d431007efbc280d043e234d04927f332682099f45afa39e4973277b1a9e1fb4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/7249f413ba805d3a1856e9ac8b206d7b6907e8b4c53ff5f73eab3f454f4243dc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高梨 はなみ","creatorId":"vndb:s5060","sourcePersonId":"vndb:s5060","canonicalEntityId":"vndb:s5060","name":"みたか りん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87991","source":"vndb"}]},{"characterId":"char_vndb_c97831","characterName":"お珠","sourceIds":{"vndbCharacterId":"c97831"},"originalCharacterName":"お珠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She's Onatsu’s childhood best friend, and the youngest child of the Venerable Tanuki Kajikaiwa Magoichiro. Under the authority granted to him by the Royal Court of Kitsune and Tanuki, he governs the land of Kokeshi Mizukuni. In other words, she comes from a wealthy, sheltered family and doesn't have any sort of job."},{"spoiler":false,"text":"Her many, considerably older siblings take care of any important family business, and her family loves doting on her. They're always pushing her to attend matchmaking events and other formal affairs. Otama eventually gets fed up with this lifestyle and proceeds to move in with Onatsu."},{"spoiler":false,"text":"In return, Otama helps Onatsu take care of the housekeeping and other menial activities. She also joins Onatsu in her cosplay photoshoots, so she does earn some cash for herself. Although she keeps said photoshoots a secret from her family, as they'd without question do something shady to ensure those photos would entirely cease to exist if they ever found out."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c97831"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b6c12cf40f89c4e9790123ff0d802087fb2680ee662b838122f8ab66894abdd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e115472017e64c39124b1679147e483c5fa570e17c1847543328b54119a333f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"御苑生 メイ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87990","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p1873","sourceCompanyId":"egs:brand:2884","canonicalEntityId":"vndb:p1873","name":"ORCSOFT","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:31200:2884","source":"egs"},{"companyId":"vndb:p7778","sourceCompanyId":"vndb:p7778","canonicalEntityId":"vndb:p7778","name":"FAKKU!","roleCodes":["publisher"],"identityStatus":"source-native","