{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"21451","model":{"presentationWorkId":"vndb:v16257","staff":{"artwork":[{"creditedName":"Aotonbo(tonbo、とんぼ)","creatorId":"vndb:s7109","sourcePersonId":"egs:creator:17236","canonicalEntityId":"vndb:s7109","name":"Aotonbo(tonbo、とんぼ)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:143514","source":"egs"}],"scenario":[{"creditedName":"フレーム","creatorId":"vndb:s621","sourcePersonId":"egs:creator:1565","canonicalEntityId":"vndb:s621","name":"フレーム","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:143515","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c29593","characterName":"藤原 泰明","sourceIds":{"vndbCharacterId":"c29593"},"originalCharacterName":"藤原 泰明","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"While being hospitalized due to broken arms after helping a child from accident, he was taken care of by his best friend's mother who works as nurse and also knew him since childhood. As the time went on, with his arms were still useless, he had no choice but to have her helping him in calming down his lust which kept piling up from long hospitalization period. However, little did he know this would become the trigger of his first love."}],"source":"vndb","sourceCharacterId":"c29593"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6dc7a8f04718550765607059be008ec3b8d2844860de0fb2ca2005fe800b5eeb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/803bea436763bb8413e3c6a315e4dc6016708e5424d3dc36b3369dbae8319e43.webp","width":108,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c29596","characterName":"入間 和代","sourceIds":{"vndbCharacterId":"c29596"},"originalCharacterName":"入間 和代","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Obachan from the neighborhood whom the protagonist has been indebted to since childhood. Veteran nurse and also mother of protagonist's best friend Takuto. She has good reputation from patients because of her friendly and caring personality. Since she is married with a grown-up child, she is no longer conscious of herself as a woman. Because of that, she always has strong and straightforward image."},{"spoiler":false,"text":"Instead of parents who are busy with work, she have been taking care of the protagonist since he was a child, and she loves him like her own son. Because she only see the protagonist as a child, she sometimes carelessly hugs and teases him."},{"spoiler":false,"text":"Powerful Obachan is busy with work and housework every day."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c29596"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07c752605c695c885ade09d5d9c94cbdde8759941f7ec761ec055586b8cee518.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/874922221565cc439eed4a1f8bc6bd2b57f1b4114a7361745a2443ca8ad304ce.webp","width":123,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南乃 こと","creatorId":"vndb:s5763","sourcePersonId":"vndb:s5763","canonicalEntityId":"vndb:s5763","name":"南乃 こと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:61489","source":"vndb"}]},{"characterId":"char_vndb_c29597","characterName":"入間 拓真","sourceIds":{"vndbCharacterId":"c29597"},"originalCharacterName":"入間 拓真","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Husband of heroine and father of Takuto."}],"source":"vndb","sourceCharacterId":"c29597"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfaf881e3680ed0f46f3ececb5962341d36c574c47bcb00f1796d7ae4ca16f09.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1ade24e1d582287f4d4ec482d1e5005695a43d28213d2155ed273e502c842d99.webp","width":126,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c29599","characterName":"入間 拓斗","sourceIds":{"vndbCharacterId":"c29599"},"originalCharacterName":"入間 拓斗","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Protagonist's best friend and heroine's son. He always makes fun of his mother but he actually respects and feels grateful to her. He cares about the protagonist and often invites him to group parties to introduce girls to him without knowing his best friend has a thing for his mother."}],"source":"vndb","sourceCharacterId":"c29599"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cdfdd0881cf07a45a573de5c87e5280136155a4b254ac8411989fc33f11cb871.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9af97aaeaa677ad91061cec7cf27d11bf3321e3ca8757af7dff1c9