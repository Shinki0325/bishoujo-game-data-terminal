{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"23568","model":{"presentationWorkId":"vndb:v19245","staff":{"artwork":[{"creditedName":"そらモチ","creatorId":"vndb:s2740","sourcePersonId":"egs:creator:21860","canonicalEntityId":"vndb:s2740","name":"そらモチ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:164022","source":"egs"}],"scenario":[{"creditedName":"狩野景","creatorId":"vndb:s8183","sourcePersonId":"egs:creator:17947","canonicalEntityId":"vndb:s8183","name":"狩野景","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:164023","source":"egs"}],"music":[],"other":[{"creditedName":"DaveGVN","creatorId":"vndb:s36818","sourcePersonId":"vndb:s36818","canonicalEntityId":"vndb:s36818","name":"DaveGVN","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:130035","source":"vndb"}]},"cast":[{"characterId":"char_c45620","characterName":"ベルファルード","sourceIds":{"bangumi":[{"characterId":"41096","match":"exact-normalized-name-in-linked-work","subjectId":"181505"}],"egsCharacterIds":["8393"],"vndbCharacterId":"c45620"},"originalCharacterName":"ベルファルード","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"After being betrayed by her second in command Zord she and the hero escape to the human world. Unfamiliar with how a demon female's body works she emits a powerful pheromone that makes her irresistible to men such that even the hero can't control himself and he rapes her."},{"spoiler":false,"text":"Afraid of becoming pregnant by the hero's baby she's desperate to make him stop but something else happens. Each time he ejaculates inside her some of her magic power returns. A new dangerous plan begins to form between them about how to gain her kingdom back ..."}],"source":"vndb","sourceCharacterId":"c45620"},{"segments":[{"spoiler":false,"text":"元々は、華奢で女性と見紛う容姿をした強力な魔力を有する少年魔王。"},{"spoiler":false,"text":"しかし勇者との戦闘中に女体化し、長い金髪と緑色の目を持つ美少女となってしまう。"},{"spoiler":false,"text":"手足がすらりと長いスレンダーな体型だが、巨乳で桃尻。"},{"spoiler":false,"text":"発情フェロモン体質になっており、勇者に何度も押し倒されることに。"},{"spoiler":false,"text":"プライドが高く自信にあふれており、尊大でしたたかな性格。"},{"spoiler":false,"text":"人格は基本的に男の時のままで、女扱いをされると怒り、男であると頑なに主張する。"},{"spoiler":false,"text":"名前が長ったらしいからと勇者には “ベル” という愛称で呼ばれている。"},{"spoiler":false,"text":"勇者に敵意と警戒心を持っているが、旅を続ける中で徐々に好意を持つようになる。"}],"source":"egs","sourceCharacterId":"8393","sourceWorkId":"23568","spoiler":false},{"segments":[{"spoiler":false,"text":"元々は、華奢で女性と見紛う容姿をした強力な魔力を有する少年魔王。"},{"spoiler":false,"text":"しかし勇者との戦闘中に女体化し、長い金髪と緑色の目を持つ美少女となってしまう。"},{"spoiler":false,"text":"手足がすらりと長いスレンダーな体型だが、巨乳で桃尻。"},{"spoiler":false,"text":"発情フェロモン体質になっており、勇者に何度も押し倒されることに。"},{"spoiler":false,"text":"プライドが高く自信にあふれており、尊大でしたたかな性格。"},{"spoiler":false,"text":"人格は基本的に男の時のままで、女扱いをされると怒り、男であると頑なに主張する。"},{"spoiler":false,"text":"名前が長ったらしいからと勇者には “ベル” という愛称で呼ばれている。"},{"spoiler":false,"text":"勇者に敵意と警戒心を持っているが、旅を続ける中で徐々に好意を持つようになる。"},{"spoiler":false,"text":"「……って、やめろ勇者っ、我は男だ！　近寄るな！」"}],"source":"bangumi","sourceCharacterId":"41096"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38274a4f2a8d6a465ab338e20a831f4ea120aa29760f8ae3407e9e1385356293.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7df904e44af9ed1503035704b9d89d7d775ec21eb05cf0f8925c314ffaf8190a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p314","sourceCompanyId":"egs:brand:2093","canonicalEntityId":"vndb:p314","name":"Norn","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-bran