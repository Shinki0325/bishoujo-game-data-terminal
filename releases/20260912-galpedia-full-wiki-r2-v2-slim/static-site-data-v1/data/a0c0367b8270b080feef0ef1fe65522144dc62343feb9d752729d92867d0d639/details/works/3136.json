52"},"originalCharacterName":"橘 けいじろ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Keijiro is Yuuji's father, Saki's uncle, and Takeaki's younger brother."},{"spoiler":false,"text":"He is a businessman from Tokyo that suddenly moved to Hawaii on a business transfer while his son Yuuji was still at school unaware of his parents moving out. He arranged for Yuuji to move him to Hokkaido where Yuuji's uncle and cousin are living and now occasionally sends video messages to Yuuji bragging about his fun times in Hawaii while mercilessly taunting Yuuji. He also has an uncanny ability to predict Yuuji's actions."},{"spoiler":false,"text":"Edited from Giant Bomb"}],"source":"vndb","sourceCharacterId":"c56152"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fb1b4e541c142879b731a98324258068832cae0dbdb9089f21abb3a2f83237e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9fc27eb070af29e0169ad37a2219e7f2b862345b55ed9e28c95c6a7beb084087.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c989","characterName":"宗谷 美咲","sourceIds":{"vndbCharacterId":"c989"},"originalCharacterName":"宗谷 美咲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuuji's 