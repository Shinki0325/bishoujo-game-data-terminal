"relationId":"vndb:vn-staff:76922","source":"vndb"},{"creditedName":"SugarLover","creatorId":"vndb:s13225","sourcePersonId":"vndb:s13225","canonicalEntityId":"vndb:s13225","name":"SugarLover","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:76927","source":"vndb"},{"creditedName":"上様","creatorId":"vndb:s15984","sourcePersonId":"vndb:s15984","canonicalEntityId":"vndb:s15984","name":"上様","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:76928","source":"vndb"},{"creditedName":"塚本 けむ","creatorId":"vndb:s14188","sourcePersonId":"vndb:s14188","canonicalEntityId":"vndb:s14188","name":"堀江 晶太","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:76930","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c11613","characterName":"長瀬 湊","sourceIds":{"vndbCharacterId":"c11613"},"originalCharacterName":"長瀬 湊","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"502"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"C"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is Jun`ichi's younger sister."},{"spoiler":false,"text":"She is a year younger than he is and attends the same school that he does as a first year high school student. She is capable in all areas of household related work and is proud of it. She also has unique abilities, like listening to the ground to detect the presence of animals, as well as be able to communicate with them. She has feelings for Jun'ichi. She mentions that she was an adopted sister once, but later says it was a joke. Minato is blood-related to Jun'ichi in the PC game, in the PS2 version she is not related to him, and it is implied that she is not blood-related to Jun'ichi in the anime."},{"spoiler":false,"text":"She's a friend of Yocchan. In Hoshizora e Kakaru Hashi she visits Yamabiko with her."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c11613"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/7145d6591701360f2d4a1dc85777ab1e525ffe5088bc194b80c96c1468d74dcf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/bad06431656c461765d1e58c358c28474f4082c8a122caa1ea4f3014a9faa74a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水沢 光","creatorId":"vndb:s240","sourcePersonId":"vndb:s240","canonicalEntityId":"vndb:s240","name":"今井 麻美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43046","source":"vndb"}]},{"characterId":"char_vndb_c11642","characterName":"白石 なごみ","sourceIds":{"vndbCharacterId":"c11642"},"originalCharacterName":"白石 なごみ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"721"},"bust":{"reviewState":"source-only","source":"vndb","value":"75"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"144"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A first year high school student in the same class as Minato. She has an air of mystery around her, strongly hinted of being an alien, and can be found just about anywhere at the right time. Is given the task of breaking up protagonist engagement."},{"spoiler":false,"text":"From Wikipedia."},{"spoiler":true,"text":"Has a twin sister that she cares for deeply. Her sister is a normal student and generic normal girl in comparison to Nagomi."}],"source":"vndb","sourceCharacterId":"c11642"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8bf5fa44eea3efb22edb458bbb1ef2146bdfe0145ee9645247fd4843596f17e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0d6a40ad86baa24e9094cd4d417db0f096fa3d63321abe6aebf77f7e26c5468.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みる","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43042","source":"vndb"}]},{"characterId":"char_vndb_c4741","characterName":"中津川 初","sourceIds":{"vndbCharacterId":"c4741"},"originalCharacterName":"中津川 初","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1017"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"C"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ui Nakatsugawa is the main female protagonist of the series. Lively and upbeat, Ui is a second-year high school student who is arguably the most iconic character of the series. She is the first girl Kazuma meets and without a doubt, the first to kiss him. An energetic, carefree individual, Ui is fun, outgoing and adored by everyone, though she is comparatively naive to her peers. Of her most outward traits, Ui has an outrageous appetite for food."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c4741"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/832b9de8881365ca31ca332454cfe82284ff118c3577b58dc6b1bbcca65072e9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/990cbc6a27fa184975f2dac902378f66bd649159d4566c74bdef8c34e1ed25c3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"日々野 蒔","creatorId":"vndb:s1648","sourcePersonId":"vndb:s1648","canonicalEntityId":"vndb:s1648","name":"中村 繪里子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43050","source":"vndb"}]},{"characterId":"char_vndb_c4742","characterName":"日向 伊吹","sourceIds":{"vndbCharacterId":"c4742"},"originalCharacterName":"日向 伊吹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"815"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"151"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ibuki Hinata is a fellow second-year student, her class representative, and Ui's closest if not best friend. Besides her academic excellence and status on the student council, she is also an active member of the archery club, having practiced the sport since middle school. Her first acquaintance with Kazuma is a suspicious and disparaging one; much to her own confusion, his kindness rubs off and she ultimately develops a soft-spot for him. Although Ibuki can be tough and difficult, she succumbs to her feelings and can be particularly tender and shy."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c4742"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/bac2556ce644102d53308b99bc0e2125461e8c2f2b2b9847b433354d1c618752.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f863740f05abbe251013b83a18cf15125c6a95caaa731d9cdda4dd4376f234b1.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉 りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43039","source":"vndb"}]},{"characterId":"char_vndb_c4743","characterName":"藤堂 こより","sourceIds":{"vndbCharacterId":"c4743"},"originalCharacterName":"藤堂 こより","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1005"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"146"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Koyori is a first-year student and the vivacious younger sister of Tsumugi, second oldest to Kasane. An animated, headstrong, tenacious and often loud girl, Koyori, much like Ibuki, does not welcome Kazuma with open arms at the start of their introduction, though after cushioning her fall from a tree she has a change of heart. In spite of her almost spitfire disposition, Koyori enjoys helping others and appreciates those who help her."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4743"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5f16455edda0025c0e48d1b8e8c9710dce5eaca89f7bb8af7cc1fd68ab6b859.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13af915c0e40d3d57b73609293145b88449efefad11adc5b603a24663ec35661.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桃井 いちご","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43041","source":"vndb"}]},{"characterId":"char_vndb_c4744","characterName":"酒井 陽菜","sourceIds":{"vndbCharacterId":"c4744"},"originalCharacterName":"酒井 陽菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"929"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Calm and peculiar, Hina Sakai is a third-year student, who unlike the rest of the cast, is one of the more difficult to discern. Her habitually aloof and reticent nature distinguish her as an intrapersonal, somewhat mysterious person, a trait she is well known and admired for at school; her encounter with Kazuma, and the time she spends with him and the group however, serve to relieve this. Despite her refined image, Hina madly adores anything cute and even personifies plush toys. Her parents own a famous distillery, a common motif of hers is to study marketing in college."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c4744"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a8588bbc9fe82f76b12ded30e4a5c8b6b1b624db86d3281ea524ea2fa833134.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4c47f0618e7e8a3f6593d8d822ea6302e3b88b147dcff48e642b9c3ca1a636d.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森谷 実園","creatorId":"vndb:s944","sourcePersonId":"vndb:s944","canonicalEntityId":"vndb:s944","name":"吉田 真弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43045","source":"vndb"}]},{"characterId":"char_vndb_c4746","characterName":"神本 円佳","sourceIds":{"vndbCharacterId":"c4746"},"originalCharacterName":"神本 円佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1013"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"source-only","source":"vndb","value":"153"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Koumoto Madoka is a first-year student, who outside of her time at school, doubles as the local Shinto shrine miko. Bashful and delicate, she is often found sweeping leaves off the sandou, reading books to children at the Yamabiko library or less commonly, in the company of friends. Having grown up sheltered, Madoka dresses old-fashioned, is mildly androphobic, and beyond her time in school, is not familiar with or interested in subcultures. Her history with Kazuma nonetheless is the longest of anyone, spanning at least a decade. Madoka enjoys writing and is skilled at nage-waza. Madoka is childhood friends with Kazuma. Madoka is also not good with males and if a male touches her, she will use martial arts to defend herself."},{"spoiler":false,"text":"Edited from Wikipedia."}],"source":"vndb","sourceCharacterId":"c4746"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4f634bb9944ca151a193ca0f8c84c1ae6fba7b7b6d5b9251cd2e53ee8cb2181.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37bdba504c5494d0f60051502e170d51ee523688bd801b8e7cbe6770a3ee42ae.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いすず あすか","creatorId":"vndb:s416","sourcePersonId":"vndb:s416","canonicalEntityId":"vndb:s416","name":"清水 愛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43043","source":"vndb"}]},{"characterId":"char_vndb_c4747","characterName":"藤堂 つむぎ","sourceIds":{"vndbCharacterId":"c4747"},"originalCharacterName":"藤堂 つむぎ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1209"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"F"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Prim and quaint, Tsumugi is a third-year student and one of the most respectable cast members. A gentle, down-home country girl, Tsumugi is courteous, knowledgeable and acts as a sort of mediator for those around her. Tsumugi is a lover of nature and the rural life, enforced by her part-time work at the Yorozuyo Inn. She is the oldest of three sisters, Koyori and Kasane Toudou."}],"source":"vndb","sourceCharacterId":"c4747"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02d363be5009f68a7b11c8a40e8081a84f3ce1a5e2f2c34ba2e1601efa272da5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee7e483a0c56d5751e2429df21cec62e17f62ddc0b9d7acc8d13bcca559b3bf6.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴木 らん","creatorId":"vndb:s287","sourcePersonId":"vndb:s287","canonicalEntityId":"vndb:s287","name":"たかはし 智秋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43048","source":"vndb"}]},{"characterId":"char_vndb_c4750","characterName":"星野 一馬","sourceIds":{"vndbCharacterId":"c4750"},"originalCharacterName":"星野 一馬","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"804"},"height":{"reviewState":"source-only","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kazuma Hoshino is the main male protagonist of the series. A rather ordinary, though warmhearted teenage boy, he moves out of the city and into the countryside for the sake of his brother Ayumu's delicate health. His acclimation to this environment is an initially rough and humiliating one, attracting the ridicule and distrust of some of his peers; overtime however, his gentleman demeanor and true intentions earn him respect and even the ardency of his female companions. Partially unaware that his childhood took place in Yamabaki, Kazuma experiences occasional flashbacks."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c4750"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/345a05379afcd63ff2a5b5a178686e3a7b606d28564e3a4407fba99b0ce8e2fa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8dd930558c1744d4779fc10ec85214cace70a6f15be54c8e410e867ef976eb65.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c4752","characterName":"星野 歩","sourceIds":{"vndbCharacterId":"c4752"},"originalCharacterName":"星野 歩","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1021"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ayumu Hoshino is the adorable younger brother of Kazuma. An affectionate little boy, he moves with Kazuma into the countryside on behalf of his asthma and meek health, and like his older sibling, enrolls in school. Much like Kazuma, Ayumu is friendly, altruistic and gregarious. Of his many hobbies, Ayumu enjoys drawing."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c4752"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d34194be5738c9a0437ed84002212390d5697573d614f29d3acb2df1ae25ef90.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ace4124288019cae919c8b0580751d53aaae546369c428c94a2f5f7da125df0e.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"卯衣","creatorId":"vndb:s1178","sourcePersonId":"vndb:s1178","canonicalEntityId":"vndb:s1178","name":"大橋 歩夕","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43047","source":"vndb"}]},{"characterId":"char_vndb_c4753","characterName":"万 千歌","sourceIds":{"vndbCharacterId":"c4753"},"originalCharacterName":"万 千歌","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1220"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"height":{"reviewState":"source-only","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Senka Yorozu is the titular owner of the Yorozuyo Inn. A friendly and hospitable woman, Senka, a friend of Kazuma and Ayumu's father, warmly welcomes the boys to live with her when they travel to Yamabiko. Though she is giving and considerate, Senka does not tolerate nonsense of any kind from anyone, including her guests. She does however have a mischievous side to her and does enjoy drinking."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c4753"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/689d120873ff96ce58ef605001ba0badf1d071f4b5e6fdbdc8278459469c6540.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/770763ccdb4b9e07264100385e7e76aec09136b4e097d99ed96cf132915b58a0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柚木 かなめ","creatorId":"vndb:s13","sourcePersonId":"vndb:s13","canonicalEntityId":"vndb:s13","name":"河原木 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43037","source":"vndb"}]},{"characterId":"char_vndb_c4754","characterName":"南国原 大吾","sourceIds":{"vndbCharacterId":"c4754"},"originalCharacterName":"南国原 大吾","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"605"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Spirited and somewhat eccentric, Daigo Minamikokubaru is a second-year student. A classmate, he befriends Kazuma almost immediately on his first day of the school, acquainting him with the campus and even the profiles of some of the girls he meets; jealous of his unintentional success with women. As a sign of brethren respect, he frequently addresses Kazuma \"brother\". Daigo is the son of the second-year homeroom instructor."},{"spoiler":false,"text":"From Wikipedia."}],"source":"vndb","sourceCharacterId":"c4754"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72beb5b910fc5067a5d2f8876fadc98dd33e5c6f05c360baf9d4e877879aa452.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d4a5ec7844450deac79d7d7edcfac488769c94e373eb77f79b717723fa938d5.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春野 風","creatorId":"vndb:s60","sourcePersonId":"vndb:s60","canonicalEntityId":"vndb:s60","name":"春野風","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43038","source":"vndb"}]},{"characterId":"char_vndb_c4758","characterName":"藤堂 かさね","sourceIds":{"vndbCharacterId":"c4758"},"originalCharacterName":"藤堂 かさね","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1008"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"A"},"height":{"reviewState":"source-only","source":"vndb","value":"142"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kasane is a middle school student who is Tsumugi and Koyori's youngest sister. Cheery and playful, Kasane is best known for indulging in the rumor and gossip of the town, earning her the nickname \"Fast ears\". Kasane is a fellow schoolmate of Ayumu and is a good friend of his."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c4758"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/3804d763dc652d95a951aa9b6cd9ecf281488f49ac0c36a7767ea8ffaa363b4f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c0c27c9df4ebabdcc0b69f0a749e729eb9623c25271b2f08f8d8f066b08e4f72.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杏子 御津","creatorId":"vndb:s440","sourcePersonId":"vndb:s440","canonicalEntityId":"vndb:s440","name":"門脇 舞以","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:43044","source":"vndb"}]},{"characterId":"char_vndb_c8310","characterName":"七森 星羅","sourceIds":{"vndbCharacterId":"c8310"},"originalCharacterName":"七森 星羅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"724"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"height":{"reviewState":"source-only","source":"vndb","value":"151"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nanamori Seira is the new heroine of the series. She is Kasane's classmate but not her friend. However, she used to refer to Ibuki as a sister. Seira used to be friends with the whole Hinata family, however, an accident set out their relationship to worse, and she became like what she is today. She and Ibuki are childhood friends"},{"spoiler":false,"text":"Seira appears antisocial and cool and really mature for her age, however, she is actually pretty clumsy. She loves watching the starry sky in the park every day. Seira also acts sometimes a little bit old-fashioned due to living with her grandmother."}],"source":"vndb","sourceCharacterId":"c8310"}],"profileFacts":[],"metadataCandidateCon