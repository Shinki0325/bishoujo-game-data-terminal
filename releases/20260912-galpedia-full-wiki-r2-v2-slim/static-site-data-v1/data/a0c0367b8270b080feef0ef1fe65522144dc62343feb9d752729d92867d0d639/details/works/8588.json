{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"8588","model":{"presentationWorkId":"vndb:v7416","staff":{"artwork":[{"creditedName":"大野哲也","creatorId":"vndb:s2932","sourcePersonId":"egs:creator:400","canonicalEntityId":"vndb:s2932","name":"大野哲也","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:21893","source":"egs"},{"creditedName":"娘太丸","creatorId":"vndb:s1439","sourcePersonId":"egs:creator:7","canonicalEntityId":"vndb:s1439","name":"娘太丸","detail":"SDイベント","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:21894","source":"egs"}],"scenario":[{"creditedName":"亜麻矢幹(まろにぃ)","creatorId":"vndb:s5695","sourcePersonId":"egs:creator:1736","canonicalEntityId":"vndb:s5695","name":"亜麻矢幹(まろにぃ)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:21895","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c58892","characterName":"フィーリア","sourceIds":{"bangumi":[{"characterId":"4353","match":"exact-normalized-name-in-linked-work","subjectId":"16989"}],"egsCharacterIds":["19340"],"vndbCharacterId":"c58892"},"originalCharacterName":"フィーリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"77"},"hip":{"reviewState":"source-only","source":"vndb","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ローゼンベルグ騎士養成学校で働く、ハヤウェイの妹。"},{"spoiler":false,"text":"お兄ちゃん大好き娘で、女の子と仲良くしていると真相を確かめにくる。"},{"spoiler":false,"text":"［■アフターストーリー］"},{"spoiler":false,"text":"王位を望まず、ハヤウェイとの甘い新婚（？）生活を始めたフィーリア。"},{"spoiler":false,"text":"二人の元には毎日のように親しい友人が訪れ、“裸エプロン”の話題（!?）で盛り上がる。"},{"spoiler":false,"text":"みんなの話に触発されたフィーリアは、自分も“裸エプロン”に挑戦することにするが……？"}],"source":"egs","sourceCharacterId":"19340","sourceWorkId":"9747","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹。主人公の近くにいたいが為に、ローゼンベルグ騎士養成学校で働くことにした典型的なブラコンさん。"},{"spoiler":false,"text":"校内の掃除や学食でウェイトレスをしていたりする。"},{"spoiler":false,"text":"お兄ちゃん大好きらぶらぶ娘で、主人公が他の女の子と仲良くしているとその真偽を確かめに乗り込んでくる。"},{"spoiler":false,"text":"照顾主角、爱吃醋的恋兄情结妹妹。常为了哈亚维而和菲尔吵架。口头禅是“～かな”。武器是拖把（学校的用品），但故事中几乎都不参战。"},{"spoiler":false,"text":"mask真正身份为前作主角マイステル和前作女主角プリンセア的独生女，也就是下落不明的温特兰德王国公主。本名フィーリアレーギス・フォン・グリューネヴァルト。由于她的攻略路线只能在最后才能攻略、而且是唯一结局有特别待遇的，也有人认为她的角色路线才是True Ending。拥有治疗魔法的才能，在菲莉亚路线后半可使用强力的回复魔法。名字“フィーリアレーギス”是拉丁语中“公主”的意思。在《LOVE2 MAXIMUM!》中完全没有要当公主的想法，继续著与普琳希亚互让权力的日子。/mask"},{"spoiler":false,"text":"原作中没有H场景，后来在FAN DISC“テレサとハート”中追加了（但是テレサとハート没有语音）。"}],"source":"bangumi","sourceCharacterId":"4353"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a60a1791d14514d8cfda25ef8768349e804a85ea8cfee590e6a12d4e811396ff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4cccbd71da3765132eed6741a4013fa82f1c3e7ddd8f1f6dd4111dfafc9c6c8e.webp","width":244,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c58894","characterName":"シスター・ヘル","sourceIds":{"vndbCharacterId":"c58894"},"originalCharacterName":"シスター・ヘル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec206f