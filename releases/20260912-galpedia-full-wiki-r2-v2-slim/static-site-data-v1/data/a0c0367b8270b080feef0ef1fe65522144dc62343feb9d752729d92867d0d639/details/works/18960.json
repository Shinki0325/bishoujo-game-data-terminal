ationId":"egs:work-creator:176663","source":"egs"},{"creditedName":"橋本 美佐","creatorId":"vndb:s44528","sourcePersonId":"vndb:s44528","canonicalEntityId":"vndb:s44528","name":"橋本 美佐","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:115631","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c123784","characterName":"真神 恭介","sourceIds":{"vndbCharacterId":"c123784"},"originalCharacterName":"真神 恭介","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"23"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A member of the Narumi Detective Agency. Kyousuke's a kind young man with a simple personality, and perhaps because of that, he easily gets into trouble. When Kyousuke was young, he had lost his parents in a car accident and as a result was raised by his grandfather."},{"spoiler":false,"text":"The main thing Kyousuke remembers from his childhood is an antique pendant his mother wore, which is currently missing. Because of this he wanted to at least find a pendant of the same type and use it as a memento, so he turned the Narumi Detective Agency to request an investigation about the origins pendant. However, when Kyuosuke learned that the office was managed by Kyouka alone and was no longer able to properly conduct detective work, Kyousuke sympathized with her and decides to work for her. He is, of course, investigating the origins of his mother's pendant in between his normal work."},{"spoiler":false,"text":"Translated from Wikipedia."}],"source":"vndb","sourceCharacterId":"c123784"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3daca1a50b72e1b090cedc45ea3df04d75bdd7a9e5d1351e8ab32f94e42674c9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e77273956c07f647908ce9338990958974f0ad2e2152cb0f2b6af8124dd31c5.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c123785","characterName":"鳴海 京香","sourceIds":{"vndbCharacterId":"c123785"},"originalCharacterName":"鳴海 京香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"28"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Narumi Detective Agency's deputy director. Kyouka is the daughter of Narumi Seiji, who was believed to be a great detective who had gone missing while Kyouka was studying abroad. When she learned of her father's disappearance, she returned to Japan to run the family office in his stead, as the acting director."},{"spoiler":false,"text":"Kyouka has a naive side and often receives requests out of the kindness of her heart rather than her monetary interests. Her abilities as a detective are in fact lacking, therefore she relies heavily on her new worker Kyousuke for the actual case investigations."},{"spoiler":false,"text":"Narumi had known Kyousuke since her childhood. She always quarrels with him when they meet, but in reality she relates to his situation and wishes to get along with him."},{"spoiler":false,"text":"Translated from Wikipedia."}],"source":"vndb","sourceCharacterId":"c123785"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0cc7cf51f1fff5b5639cf3159e46ba0d41ecd6e550b03c1f86f4ee813969b1f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f54a48dbc11055c8fabcf9f5cbfdde4f5b5110d5d558748a9ed8cb715da0fde0.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c123786","characterName":"月嶋 成美","sourceIds":{"vndbCharacterId":"c123786"},"originalCharacterName":"月嶋 成美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"27"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsukishima Narumi is the manager of the antique shop \"Secundum\" and Narumi Kyouka's childhood friend. Kyousuke agrees to help her out at the antique shop in exchange for Narumi's help in getting information about the pendant he is looking for."},{"spoiler":false,"text":"Narumi is a beautiful woman, but she has a selfish and arrogant queen-like personality. She doesn't like bright lights and always keeps her store in a dim environment, therefore she gives off the impression of a vampire. Interestingly enough, she owns a black cat named Hellsing."},{"spoiler":false,"text":"Translated from Wikipedia."}],"source":"vndb","sourceCharacterId":"c123786"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/165877da3d874fa6fbc36a5d5f96c30e55cfd1b2b3be377b5fb24592799712b6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9fc85bb48f123d5e5045ccefe8fd278695672f727082c6f43d3846a172871fd8.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c123787","characterName":"白石 哲平","sourceIds":{"vndbCharacterId":"c123787"},"originalCharacterName":"白石 哲平","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"24"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young man who lives in the house of Kashiwagi Kyuuzou, Narumi's mentor. Although he is a delinquent with bad attitude, to his closest buddies he is a friendly and funny character. He speaks in Kansai dialect. Since Kyousuke is a friend of his, in the game he sometimes plays the role of Watson and helps analyzing various cases with Kyousuke."},{"spoiler":false,"text":"Translated from Wikipedia."}],"source":"vndb","sourceCharacterId":"c123787"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71a585b615c4d1cd93c6924751c32226e9813831d934607b8d72af314ac8c1cd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7cdf6e2d4ebbe7969038d0eaa3103457d2bb1ca3f74f878f8b781935eb11019.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c123788","characterName":"鳴海 誠司","sourceIds":{"vndbCharacterId":"c123788"},"originalCharacterName":"鳴海 誠司","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"52"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Owner of the Narumi Detective Agency, and Kyouka's father. Originally a police detective, he later became an independent detective. After making a great name for himself at his field, he had unfortunately gone missing a year ago before the main story."},{"spoiler":false,"text":"Translated from Wikipedia."}],"source":"vndb","sourceCharacterId":"c123788"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c123789","characterName":"鴨居 奈々子","sourceIds":{"vndbCharacterId":"c123789"},"originalCharacterName":"鴨居 奈々子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Recurring character."},{"spoiler":false,"text":"A high school student who works part-time at Kyousuke's favorite internet café \"Cybaria\". She has a hobby of coming up with creative menus with rather strange combinations of products, and she is infamous for forcing the cafe's regular customers to try her creations."},{"spoiler":false,"text":"Translated from Wikipedia."}],"source":"vndb","sourceCharacterId":"c123789"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cab4d9892ea963227c822bca58393d620acc1156aedf311c7d28a0cca4749f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/751295b749346f8e95198c4ff3e3b2b2ddca46ee3a57d13dad540b50be698080.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c123791","characterName":"氷室 裕","sourceIds":{"vndbCharacterId":"c123791"},"originalCharacterName":"氷室 裕","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"45"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Recurring character."},{"spoiler":false,"text":"A middle-aged detective who belongs to the First Division of the Prefectural Police. He used to be Narumi Seiji's junior when the latter was a police detective, and because of that connection, he easily agrees to cooperate with Kyouka and Kyousuke. He has an aloof and elusive personality, but he also has a cunning side thanks to which he deliberately ignores police rules in order to solve some cases."},{"spoiler":false,"text":"Translated from Wikipedia."}],"source":"vndb","sourceCharacterId":"c123791"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32d8d5e3b80494211253dcfa04210dda1b6984c420112a4fb2326efdbb022af7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6dcf5fa139081be38d27332e2303f1fee6a0a7b9b3ddefa90ea3c52f3e602c6d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c123794","characterName":"諏訪 高貴","sourceIds":{"vndbCharacterId":"c123794"},"originalCharacterName":"諏訪 高貴","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"52"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An attorney at Suwa Law Office. Although Kouki is a talented man, he has a habit of slacking off from work, and is often seen spending his time in the internet cafe \"Cybaria\". Suwa Kouki is an old friend of Narumi Seiji, Kyouka's father who had gone missing."},{"spoiler":false,"text":"Translated from this website."}],"source":"vndb","sourceCharacterId":"c123794"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59ab9753b9fae44cbdca95afe8b5355e119e2473c2af2158dd874e5474b1d3f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99f5ca861f823b7ec30f0891d52e0c57f757bbb5bbbf4ce8a73a60ea21aff238.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c123797","characterName":"森川 直治","sourceIds":{"vndbCharacterId":"c123797"},"originalCharacterName":"森川 直治","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"28"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Recurring character."},{"spoiler":false,"text":"A young detective who works under Himuro Yutaka. Contrary to his superior, Naoharu is a hot-blooded man with a serious personality and is sometimes inflexible. He thinks that solving cases is the job of the police, and he doesn't trust private detectives. For some reason, each time he meets Kyousuke at the scene of a crime, they fight with each other."},{"spoiler":false,"text":"Translated from Wikipedia."}],"source":"vndb","sourceCharacterId":"c123797"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a30a848347bf4384d551f3fcd849bd56f8f192dea8c61cb49dc02a81aefe49c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4eee4ed5fd4b5be8bf2fb8740a53e846f6d1c323e0e8c77342265603a4d0851f.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c123799","characterName":"柏木 久蔵","sourceIds":{"vndbCharacterId":"c123799"},"originalCharacterName":"柏木 久蔵","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A retired antique dealer who is also Tsukishima Narumi's mentor."},{"spoiler":false,"text":"At first glance, he appears to be a kind and gentle old man, but deep down he seems to be harboring many mysteries and is very well-informed. As a result, he ends up cooperating with Kyousuke's investigation."},{"spoiler":false,"text":"Translated from MP episode 2's official website."}],"source":"vndb","sourceCharacterId":"c123799"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/8172122ed5ab763a4795201796fc6e2fd95332142e22de99c86ab1f2123d7a71.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8bb4b5d79035fc4f14dc6a1255735c65aa25254becf2989c0537053a6bc128ad.webp","width":100,"height":100,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c123800","characterName":"緒川 梨沙","sourceIds":{"vndbCharacterId":"c123800"},"originalCharacterName":"緒川 梨沙","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A talented and beautiful secretary at Suwa Law Office."},{"spoiler":false,"text":"Although she's incredibly graceful, she also can be ruthless at times."},{"spoiler":false,"text":"Translated from MP episode 2's official website."}],"source":"vndb","sourceCharacterId":"c123800"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/139976459ed3419643c31603d6e09f4583050aa8ba7e57b346880d7d421498b9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6dbd5514dd5b86fab9d117c59934bc326cb4ddcacc69a22364ddbbceae7ea970.webp","width":200,"height":200,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c123804","characterName":"嘉納 潤","sourceIds":{"vndbCharacterId":"c123804"},"originalCharacterName":"嘉納 潤","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A blind girl who was adopted by the prestigious Kihara family along with her older brother."},{"spoiler":false,"text":"She shows an extraordinary talent for music."},{"spoiler":false,"text":"Translated from t