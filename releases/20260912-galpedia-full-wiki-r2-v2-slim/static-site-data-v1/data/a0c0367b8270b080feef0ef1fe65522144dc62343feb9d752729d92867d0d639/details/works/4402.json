,"source":"egs","sourceCharacterId":"17622","sourceWorkId":"9637","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公。やさぐれた青年。"},{"spoiler":false,"text":"強力な読心能力(テレバシー)を持つが、そのために絶えず苦しみを味わう。"},{"spoiler":false,"text":"黒死病によって生まれ故郷の村を失い、ただ一人生き延びた。"},{"spoiler":false,"text":"黒の切符を得たことで、ただ死に場所を求め、故鄉へ帰ろうとしている。"},{"spoiler":false,"text":"「俺を乗せていけ。黒の列車で連れていってくれ。俺の故郷へ!俺の墓場へ!」"}],"source":"bangumi","sourceCharacterId":"118191"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8f580bf8762f29b07d942b0ef751ed789e44478ca0a226e15d49fdec97759c0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbe3f3785d2acf76c59aaed28fd07a1571818db173b667f2360546bf27d53847.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c35803","characterName":"エマ","sourceIds":{"bangumi":[{"characterId":"118192","match":"exact-normalized-name-in-linked-work","subjectId":"15864"}],"egsCharacterIds":["17623"],"vndbCharacterId":"c35803"},"originalCharacterName":"エマ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"出身不明。"},{"spoiler":false,"text":"黒の少女。"},{"spoiler":false,"text":"クゥに“黒の切符”を手渡し、それ以降、旅の道連れとなる。"},{"spoiler":false,"text":"言葉を持たず、クゥの読心能力でも心をうかがい知ることはできない。"},{"spoiler":false,"text":"つねに手足を黒い布で覆い隠し、決して肌を見せようとしない。"}],"source":"egs","sourceCharacterId":"17623","sourceWorkId":"4402","spoiler":false},{"segments":[{"spoiler":false,"text":"ライアーソフト第１３弾「SEVEN-BRIDGE」のヒロイン。"},{"spoiler":false,"text":"クゥに“黒の切符”を手渡して、プレステ＝ジョアンでの旅へと誘う、言葉を持たない少女。"}],"source":"egs","sourceCharacterId":"17623","sourceWorkId":"9637","spoiler":false},{"segments":[{"spoiler":false,"text":"ヒロイン。黒の少女。"},{"spoiler":false,"text":"クゥに“黒の切符”を手渡し、それ以降、旅の道連れとなる。"},{"spoiler":false,"text":"言葉を持たず、クゥの読心能力でも心をうかがい知ることはできない。"},{"spoiler":false,"text":"つねに手足を黒い布で覆い隠し、決して肌を見せようとしない。"},{"spoiler":false,"text":"「私の名前はエマです。喋れません。言っていることは聞こえます」"}],"source":"bangumi","sourceCharacterId":"118192"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/491456e8def8d05bc3a3c67827ab172861115065573d56eb813766328d4ab27c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02e4d5656b0b2dc26e4763cbaf228ce9dc49b2548b304cef5c8fcf07f8626719.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15864:118192:4432:1","source":"bangumi"}]},{"characterId":"char_c35807","characterName":"ナンシー","sourceIds":{"bangumi":[{"characterId":"118201","match":"exact-normalized-name-in-linked-work","subjectId":"15864"}],"egsCharacterIds":["17627"],"vndbCharacterId":"c35807"},"originalCharacterName":"ナンシー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"インド帝国出身（ロンドン生まれ）。"},{"spoiler":false,"text":"有力な藩王（マハラジャ）の跡取り娘。"},{"spoiler":false,"text":"いつも陽気で、三度のカリーよりもエロいことが好き。"},{"spoiler":false,"text":"従者をひきつれプレステ＝ジョアンに合流する。"}],"source":"egs","sourceCharacterId":"17627","sourceWorkId":"4402","spoiler":false},{"segments":[{"spoiler":false,"text":"インド帝国出身 (ロンドン生まれ)"},{"spoiler":false,"text":"有力な藩王(マハラジャ)の跡取り娘。"},{"spoiler":false,"text":"いつも陽気で、三度のカリーよりもエロいことが好き。"},{"spoiler":false,"text":"従者をひきつれプレステージョアンに合流する。"},{"spoiler":false,"text":"「作りますども。地球でいちばん素晴らしい国をねッ」"}],"source":"bangumi","sourceCharacterId":"118201"}],"profileF