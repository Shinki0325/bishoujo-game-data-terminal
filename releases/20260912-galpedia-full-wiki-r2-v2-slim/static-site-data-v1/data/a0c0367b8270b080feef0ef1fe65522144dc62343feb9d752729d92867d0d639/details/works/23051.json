ch":"exact-normalized-name-in-linked-work","subjectId":"266230"}],"egsCharacterIds":["8464"],"vndbCharacterId":"c41966"},"originalCharacterName":"伊集院 真矢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"８９"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"８５"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５８"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a young lady who has been reunited with her childhood friend at the school since they were separated in the past. She is an all-around athlete with excellent grades."},{"spoiler":false,"text":"She has an honest and cheerful personality that is liked by everyone without any preconceived notions of status."},{"spoiler":false,"text":"She is very happy to be reunited with the main character, whom she had loved as an older brother."},{"spoiler":false,"text":"She is an accomplished tennis player, having competed in national tournaments in junior high school."},{"spoiler":false,"text":"She is also making a name for herself at the school and is attracting a lot of attention from those around her."}],"source":"vndb","sourceCharacterId":"c41966"},{"segments":[{"spoiler":false,"text":"過去に別離して以来、学園で再会した幼馴染のお嬢様。"},{"spoiler":false,"text":"スポーツ万能で成績優秀、身分の先入観など持たずに誰からも好かれるような素直で朗らかな性格で、兄と慕っていた主人公との再会にも大いに喜ぶ。"},{"spoiler":false,"text":"テニスが得意で中学校では全国大会に出場し活躍するほどの経歴ががあり、学園でも頭角を現しつつあり周囲からも注目されている。"}],"source":"egs","sourceCharacterId":"8464","sourceWorkId":"23051","spoiler":false},{"segments":[{"spoiler":false,"text":"過去に別離して以来、学園で再会した幼馴染のお嬢様。"},{"spoiler":false,"text":"スポーツ万能で成績優秀、身分の先入観など持たずに誰からも好かれるような素直で朗らかな性格で、兄と慕っていた主人公との再会にも大いに喜ぶ。"},{"spoiler":false,"text":"テニスが得意で中学校では全国大会に出場し活躍するほどの経歴ががあり、学園でも頭角を現しつつあり周囲からも注目されている"}],"source":"egs","sourceCharacterId":"8464","sourceWorkId":"27151","spoiler":false},{"segments":[{"spoiler":false,"text":"過去に別離して以来、学園で再会した幼馴染のお嬢様。スポーツ万能で成績優秀、身分の先入観など持たずに誰からも好かれるような素直で朗らかな性格で、兄と慕っていた主人公との再会にも大いに喜ぶ。テニスが得意で中学校では全国大会に出場し活躍するほどの経歴ががあり、学園でも頭角を現しつつあり周囲からも注目されている。"}],"source":"bangumi","sourceCharacterId":"70202"}],"profileFacts":[{"label":"体型","source":"bangumi","sourceCharacterId":"70202","value":"グラビアアイドル系"},{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"8464","sourceWorkId":"23051","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"8464","sourceWorkId":"23051","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"8464","sourceWorkId":"23051","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"8464","sourceWorkId":"23051","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"8464","sourceWorkId":"23051","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f77c3cec3e025d8d9d1f6d3b62e541d87f799ccf59835864d0c623c7b36a52b3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed0c44dbd9451bca8cf0c6fcb8656d2ec7b0bcbc613b115c624390e86fb7d12a.webp","width":129,"height":256,"source":"static-detail"},"actors":[{"creditedName":"八幡七味","creatorId":"vndb:s1988","sourcePersonId":"vndb:s1988","canonicalEntityId":"vndb:s1988","name":"八幡 七味","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:216694:70202:21494:1","source":"bangumi"}]},{"characterId":"char_c41967","characterName":"神宮寺 桐華","sourceIds":{"bangumi":[{"characterId":"70203","match":"exact-normalized-name-in-linked-work","subjectId":"216694"},{"characterId":"70203","match":"exact-normalized-name-in-linked-work","subjectId":"266230"}],"egsCharacterIds":["8465"],"vndbCharacterId":"c41967"},"originalCharacterName":"神宮寺 桐華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"９３"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"８９"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５７"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the daughter of a famous historical family that founded Jingu City, but she has very few friends because of her appearance."},{"spoiler":false,"text":"She is a student with bad behavior who likes solitude and tends to skip classes."},{"spoiler":false,"text":"She seems to have a dream for the future, but her family rebels against it, forcing her to enroll in the school."},{"spoiler":false,"text":"She shows a strong dislike for the fact that her life is being determined by someone else's decision."},{"spoiler":false,"text":"She is feared by everyone around her because of her appearance, but she is good friends with Aoi, who is in the same class with her."}],"source":"vndb","sourceCharacterId":"c41967"},{"segments":[{"spoiler":false,"text":"神宮市を作った、歴史ある名士家系の令嬢だが、その風貌から友人が非常に少なく、孤独を好んでは授業もサボリがちな素行不良の生徒。"},{"spoiler":false,"text":"何か、将来の夢を抱いているようだが、それに反発する家系に、無理やり学園に入学させられ、自身の人生を決定づけられている事に対して強い嫌悪感を示している。"},{"spoiler":false,"text":"その風貌から、周囲から恐れられているが、同じクラスである葵とだけは仲が良い。"}],"source":"egs","sourceCharacterId":"8465","sourceWorkId":"23051","spoiler":false},{"segments":[{"spoiler":false,"text":"神宮市を作った、歴史ある名士家系の令嬢だが、その風貌から友人が非常に少なく、孤独を好んでは授業もサボリがちな素行不良の生徒。"},{"spoiler":false,"text":"何か、将来の夢を抱いているようだが、それに反発する家系に、無理やり学園に入学させられ、自身の人生を決定づけられている事に対して強い嫌悪感を示している。"},{"spoiler":false,"text":"その風貌から、周囲から恐れられているが、同じクラスである葵とだけは仲が良い。"}],"source":"egs","sourceCharacterId":"8465","sourceWorkId":"27151","spoiler":false},{"segments":[{"spoiler":false,"text":"神宮市を作った、歴史ある名士家系の令嬢だが、その風貌から友人が非常に少なく、孤独を好んでは授業もサボリがちな素行不良の生徒。何か、将来の夢を抱いているようだが、それに反発する家系に、無理やり学園に入学させられ、自身の人生を決定づけられている事に対して強い嫌悪感を示している。その風貌から、周囲から恐れられているが、同じクラスである葵とだけは仲が良い。"}],"source":"bangumi","sourceCharacterId":"70203"}],"profileFacts":[{"label":"体型","source":"bangumi","sourceCharacterId":"70203","value":"巨乳褐色ギャルＡＶ女優系"},{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"8465","sourceWorkId":"23051","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"8465","sourceWorkId":"23051","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"8465","sourceWorkId":"23051","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"8465","sourceWorkId":"23051","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"8465","sourceWorkId":"23051","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/845dd81cfac78949708d951e1df273129aecdb623769650e9f00801fd6cb4f5c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47c44672245f91c039e20ab4067538199670804b7549d9aab367199618de1d8c.webp","width":129,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水口まつり","creatorId":"vndb:s879","sourcePersonId":"vndb:s879","canonicalEntityId":"vndb:s879","name":"水口 まつり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:216694:70203:6380:1","source":"bangumi"}]},{"characterId":"char_c41968","characterName":"田所 葵","sourceIds":{"bangumi":[{"characterId":"70204","match":"exact-normalized-name-in-linked-work","subjectId":"216694"},{"characterId":"70204","match":"exact-normalized-name-in-linked-work","subjectId":"266230"}],"egsCharacterIds":["8466"],"vndbCharacterId":"c41968"},"originalCharacterName":"田所 葵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"８４"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"８５"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５６"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A hardworking student from an ordinary family who was admitted to the school on a scholarship after passing an exam."},{"spoiler":false,"text":"She is the eldest daughter in a family with a single father who lost her mother and had several younger brothers to take care of."},{"spoiler":false,"text":"She graduated from this school and is trying her best to help her family by pursuing a career in interpretation, a subject in which she is very good at."},{"spoiler":false,"text":"While studying hard, she works part-time in the purchasing department to send money home to her poor family."},{"spoiler":false,"text":"She is polite and friendly, but her financial situation and her status in her surroundings make her feel uncomfortable."},{"spoiler":false,"text":"She has a complex about being out of place."}],"source":"vndb","sourceCharacterId":"c41968"},{"segments":[{"spoiler":false,"text":"普通の家系から試験合格により奨学金入学した努力家の生徒。"},{"spoiler":false,"text":"母を亡くしたシングルファザーの家系の長女で、弟が数人いて世話をしていたが、この学園を卒業し、科目の中で得意な通訳進路で家系を助けようと頑張っており、勉学に励みつつも、貧乏な家庭へ仕送りを行う為に、購買部でアルバイトをしている。"},{"spoiler":false,"text":"礼儀正しく人懐っこい性格だが、金銭的感覚や周囲の身分の違いに場違いであるのではとコンプレックスを抱いている節がある。"}],"source":"egs","sourceCharacterId":"8466","sourceWorkId":"23051","spoiler":false},{"segments":[{"spoiler":false,"text":"普通の家系から試験合格により奨学金入学した努力家の生徒。"},{"spoiler":false,"text":"母を亡くしたシングルファザーの家系の長女で、弟が数人いて世話をしていたが、この学園を卒業し、科目の中で得意な通訳進路で家系を助けようと頑張っており、勉学に励みつつも、貧乏な家庭へ仕送りを行う為に、購買部でアルバイトをしている。"},{"spoiler":false,"text":"礼儀正しく人懐っこい性格だが、金銭的感覚や周囲の身分の違いに場違いであるのではとコンプレックスを抱いている節がある。"}],"source":"egs","sourceCharacterId":"8466","sourceWorkId":"27151","spoiler":false},{"segments":[{"spoiler":false,"text":"普通の家系から試験合格により奨学金入学した努力家の生徒。母を亡くしたシングルファザーの家系の長女で、弟が数人いて世話をしていたが、この学園を卒業し、科目の中で得意な通訳進路で家系を助けようと頑張っており、勉学に励みつつも、貧乏な家庭へ仕送りを行う為に、購買部でアルバイトをしている。礼儀正しく人懐っこい性格だが、金銭的感覚や周囲の身分の違いに場違いであるのではとコンプレックスを抱いている節がある。"}],"source":"bangumi","sourceCharacterId":"70204"}],"profileFacts":[{"label":"体型","source":"bangumi","sourceCharacterId":"70204","value":"トランジスタグラマー"},{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"8466","sourceWorkId":"23051","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"8466","sourceWorkId":"23051","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"147 cm","valueContext":null,"source":"egs","sourceCharacterId":"8466","sourceWorkId":"23051","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"8466","sourceWorkId":"23051","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"8466","sourceWorkId":"23051","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab512a1decfc33c354e31ec107e824fc8ff84dd62d6d5bed483ed05d128edf2b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/510a46140fc4e91e871db96c35b5306e91882c45178ce2fe9bb502680f91f476.webp","width":129,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小嶋めい","creatorId":"vndb:s795","sourcePersonId":"vndb:s795","canonicalEntityId":"vndb:s795","name":"小嶋 めい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:216694:70204:7506:1","source":"bangumi"}]},{"characterId":"char_c41969","characterName":"帝螢 リオ","sourceIds":{"bangumi":[{"characterId":"70205","match":"exact-normalized-name-in-linked-work","subjectId":"216694"},{"characterId":"70205","match":"exact-normalized-name-in-linked-work","subjectId":"266230"}],"egsCharacterIds":["8467"],"vndbCharacterId":"c41969"},"originalCharacterName":"帝螢 リオ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"８６"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"９０"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５８"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the daughter of the Tei Hotaru Zaibatsu family, which has expanded its business into various fields, centering on a paper manufacturing company that also influences the political world, and is the current student council president."},{"spoiler":false,"text":"She has the spirit that a family with a long history should be respected and be proud of its history and achievements."},{"spoiler":false,"text":"She is respected by many students for her high ability and honor student attitude."},{"spoiler":false,"text":"There are not a few students who rebel against the school, perhaps because of the autocratic management of public morals."},{"spoiler":false,"text":"Because of her ability, she tends not to trust others."}],"source":"vndb","sourceCharacterId":"c41969"},{"segments":[{"spoiler":false,"text":"政界にも影響する製紙会社を中心として様々な分野に事業を広げる帝螢財閥の令嬢で現生徒会長。"},{"spoiler":false,"text":"由緒ある家系はその歴史と実績に敬意を表し、誇りを持つべきという精神を持つ。"},{"spoiler":false,"text":"その高い能力と優等生っぷりから、多くの生徒達から尊敬の念を抱かれているが、独裁的な風紀管理からか反発する生徒も少なからずおり、その能力故に、他者を信用していない傾向がある。"}],"source":"egs","sourceCharacterId":"8467","sourceWorkId":"23051","spoiler":false},{"segments":[{"spoiler":false,"text":"政界にも影響する製紙会社を中心として様々な分野に事業を広げる帝螢財閥の令嬢で現生徒会長。"},{"spoiler":false,"text":"由緒ある家系はその歴史と実績に敬意を表し、誇りを持つべきという精神を持つ。"},{"spoiler":false,"text":"その高い能力と優等生っぷりから、多くの生徒達から尊敬の念を抱かれているが、独裁的な風紀管理からか反発する生徒も少なからずおり、その能力故に、他者を信用していない傾向がある。"}],"source":"egs","sourceCharacterId":"8467","sourceWorkId":"27151","spoiler":false},{"segments":[{"spoiler":false,"text":"政界にも影響する製紙会社を中心として様々な分野に事業を広げる帝螢財閥の令嬢で現生徒会長。由緒ある家系はその歴史と実績に敬意を表し、誇りを持つべきという精神を持つ。その高い能力と優等生っぷりから、多くの生徒達から尊敬の念を抱かれているが、独裁的な風紀管理からか反発する生徒も少なからずおり、その能力故に、他者を信用していない傾向がある。"}],"source":"bangumi","sourceCharacterId":"70205"}],"profileFacts":[{"label":"体型","source":"bangumi","sourceCharacterId":"70205","value":"モデル系の体系でスタイル抜群"},{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"8467","sourceWorkId":"23051","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"8467","sourceWorkId":"23051","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"8467","sourceWorkId":"23051","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"8467","sourceWorkId":"23051","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueCont