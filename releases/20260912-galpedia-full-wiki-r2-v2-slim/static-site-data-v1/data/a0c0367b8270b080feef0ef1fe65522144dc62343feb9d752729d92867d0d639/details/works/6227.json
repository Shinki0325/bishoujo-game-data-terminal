:false,"text":"そのため、失敗もそれなりに多い‥‥。"},{"spoiler":false,"text":"運動神経は抜群、加えて格闘技好き。よく、武が試し斬りに遭う。"},{"spoiler":false,"text":"はねっかえりだけど、女の子っぽい部分だってやっぱりある。"}],"source":"bangumi","sourceCharacterId":"165179"}],"profileFacts":[{"label":"年龄（本版本）","value":"26 岁","valueContext":null,"source":"egs","sourceCharacterId":"26294","sourceWorkId":"6227","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"26294","sourceWorkId":"6227","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7cdc47866e17eea6fc44ea89b97e98b0af402d2ab31252ec4b6ad85ac791388.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f4e178f64bdde5ed5661de505b0d78d97901c4826d26ff8e047083196a89f2f.webp","width":78,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224224:165179:4675:1","source":"bangumi"}]},{"characterId":"char_c16045","characterName":"来生 舞","sourceIds":{"bangumi":[{"characterId":"165184","match":"exact-normalized-name-in-linked-work","subjectId":"224224"}],"egsCharacterIds":["26299"],"vndbCharacterId":"c16045"},"originalCharacterName":"来生 舞","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"150cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の住むアパートの隣人。"},{"spoiler":false,"text":"性格はお転婆で子供っぽい。"},{"spoiler":false,"text":"好奇心旺盛で、どんなことでにでも首を突っ込みたがる。"},{"spoiler":false,"text":"主人公にほのかな恋心を抱いているようだが……。"}],"source":"egs","sourceCharacterId":"26299","sourceWorkId":"6227","spoiler":false},{"segments":[{"spoiler":false,"text":"18歳"},{"spoiler":false,"text":"武が住む、アパートの隣人の女の子。"},{"spoiler":false,"text":"子供っぽい性格で、好奇心旺盛でおてんば。童顔で見た目はお子様。"},{"spoiler":false,"text":"よく武のもとに遊びに来るし、物事に何かと首を突っ込みたがる。"},{"spoiler":false,"text":"それでいて、武にほのかな恋心を抱いているご様子。"}],"source":"bangumi","sourceCharacterId":"165184"}],"profileFacts":[{"label":"年龄（本版本）","value":"18 岁","valueContext":null,"source":"egs","sourceCharacterId":"26299","sourceWorkId":"6227","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"26299","sourceWorkId":"6227","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7b261f7d59dcaf7bb309f37fdf896892d9a7989b7c5537567eb807e4da6e228.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/3713f1a397c4a9d1e2e9c1761d9e70d3d741c9526929deda1dea0988766a3425.webp","width":63,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224224:165184:4490:1","source":"bangumi"}]},{"characterId":"char_c16046","characterName":"藤原 理恵","sourceIds":{"bangumi":[{"characterId":"165183","match":"exact-normalized-name-in-linked-work","subjectId":"224224"}],"egsCharacterIds":["26298"],"vndbCharacterId":"c16046"},"originalCharacterName":"藤原 理恵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"165cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"舞台となる「あけぼの支所」の女所長。"},{"spoiler":false,"text":"キャリアのエリートで、ハイミスのお局様。"},{"spoiler":false,"text":"男に負けない信念を持ち、男性の部下には非常に厳しい。"},{"spoiler":false,"text":"そのため、男が寄り付かず、男日照りで欲求不満気味。"},{"spoiler":false,"text":"何故か主人公には優しいようだが……。"}],"source":"egs","sourceCharacterId":"26298","sourceWorkId":"6227","spoiler":false},{"segments":[{"spoiler":false,"text":"あけぼの支所の女所長。いわゆるキャリアで、ハイミスのお局様。"},{"spoiler":false,"text":"日頃より、弥生や亜紀たち部下の素行に頭を悩ませている。"},{"spoiler":false,"text":"絶対に男には負けないという信念を持っており、"},{"spoiler":false,"text":"男性部下には非常に厳しい。"},{"spoiler":false,"text":"その性格が災いしてか、男日照りで欲求不満気味なご様子。"},{"spoiler":false,"text":"ちなみに、武には優しいようだ。"},{"spoiler":false,"text":"なお、あけぼの支所には、男性所員の比率が圧倒的に少ない。"}],"source":"bangumi","sourceCharacterId":"165183"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/adb103d5232f8b6c14633b180586189a177b3e7514c00b119a8223011cd9513e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4db84473cb6f658d36765001eb10a2b4301f386b8019d4d82d9d0aed07bc49cd.webp","width":73,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北条明日香","creatorId":"vndb:s1016","sourcePersonId":"vndb:s1016","canonicalEntityId":"vndb:s1016","name":"北条 明日香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224224:165183:32486:1","source":"bangumi"}]},{"characterId":"char_c16047","characterName":"長瀬 弥生","sourceIds":{"bangumi":[{"characterId":"165180","match":"exact-normalized-name-in-linked-work","subjectId":"224224"}],"egsCharacterIds":["26295"],"vndbCharacterId":"c16047"},"originalCharacterName":"長瀬 弥生","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"bangumi","value":"160cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"舞台となる「あけぼの支所」交通課勤務の婦人警固員。