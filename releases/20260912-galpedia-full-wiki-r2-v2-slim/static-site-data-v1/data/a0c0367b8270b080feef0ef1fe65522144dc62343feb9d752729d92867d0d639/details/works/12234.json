erIds":["14839"],"vndbCharacterId":"c2847"},"originalCharacterName":"新島 ほのか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The daughter of the owner of the video rental store \"Kokonoka\" that Makoto works part-time at. She's a reliable person that's kind to everyone, and is the class president. Her father is always nagging her to get married, and he recognizes her and Makoto as a couple even though they aren't in a relationship. She helps out a lot in the store, but doesn't go near the adult corner."}],"source":"vndb","sourceCharacterId":"c2847"},{"segments":[{"spoiler":false,"text":"誠のバイト先である、ビデオレンタル店ここのか\"を経営するオーナーの娘。"},{"spoiler":false,"text":"しっかり者で誰にでも優しく、クラス委員長も務めている。"},{"spoiler":false,"text":"父親からは「お前ら、さっさと結婚しろ」とうるさく言われ、"},{"spoiler":false,"text":"付き合ってもいないのに誠と公認の仲にされている。"},{"spoiler":false,"text":"無節操な父親の言動にあたふたすることもしばしば。"},{"spoiler":false,"text":"よく店の手伝いをしているが、アダルトコーナーにだけは近づけない。"}],"source":"egs","sourceCharacterId":"14839","sourceWorkId":"12234","spoiler":false},{"segments":[{"spoiler":false,"text":"誠のバイト先である、レンタル店\"ここのか\"を経営するオーナーの娘。"},{"spoiler":false,"text":"しっかり者で誰にでも優しく、クラス委員長も務めている。"},{"spoiler":false,"text":"父親からは「お前ら、さっさと結婚しろ」とうるさく言われ、付き合ってもいないのに誠と公認の仲にされている。"},{"spoiler":false,"text":"無節操な父親の言動にあたふたすることもしばしば。"},{"spoiler":false,"text":"よく店の手伝いをしているが、アダルトコーナーにだけは近づけない。"},{"spoiler":false,"text":"「……天宮くんも観たりするの？ ああいうエッチなの」"}],"source":"bangumi","sourceCharacterId":"22657"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"14839","sourceWorkId":"12234","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"153 cm","valueContext":null,"source":"egs","sourceCharacterId":"14839","sourceWorkId":"12234","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"14839","sourceWorkId":"12234","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"14839","sourceWorkId":"12234","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"42 kg","valueContext":null,"source":"egs","sourceCharacterId":"14839","sourceWorkId":"12234","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a05490d74396a7d387cc70b62423672a1becf9a703b4f08637ee9086a326d8f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c02d062ad43aa8bed478b7004caa8eaac16ecb48c741b4941e88fca8941ef1aa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"阪田佳代","creatorId":"vndb:s650","sourcePersonId":"vndb:s650","canonicalEntityId":"vndb:s650","name":"鮎川ひなた","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14963:22657:5133:1","source":"bangumi"}]},{"characterId":"char_c2848","characterName":"天宮 雫","sourceIds":{"bangumi":[{"characterId":"22658","match":"exact-normalized-name-in-linked-work","subjectId":"14963"}],"egsCharacterIds":["14840"],"vndbCharacterId":"c2848"},"originalCharacterName":"天宮 雫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"51"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's younger stepsister. When she was little, her father remarried and she had a hard time accepting Makoto as her older brother. She still doesn't talk to him much, but when she has spare time she'll go to his room and read magazines on his bed. She sleeps a lot, and always has to be woken up in the morning by her brother. She even says herself that she can't do anything without him."},{"spoiler":false,"text":"She rents a lot of horror movies from the store that Makoto works at, but since she's a scaredy-cat, she can't watch them unless he's with her."}],"source":"vndb","sourceCharacterId":"c2848"},{"segments":[{"spoiler":false,"text":"主人公である天宮誠の義妹。"},{"spoiler":false,"text":"義父の連れ子で、親の再婚当時は誠を兄として受け入れていなかった。"},{"spoiler":false,"text":"現在も口数はさほど多くないが、暇があればお兄ちゃんの部屋に来て、"},{"spoiler":false,"text":"ベッドを占領しながら女性誌を読んでいたりしている。"},{"spoiler":false,"text":"「お兄ちゃんはわたしがいないと何もできない」と家事をこなしつつも、自分の生理用品などは兄に買わせている。"},{"spoiler":false,"text":"誠のバイト先でホラー映画ばかり借りていくが、臆病で、お兄ちゃんと一緒じゃなければ観られない。"}],"source":"egs","sourceCharacterId":"14840","sourceWorkId":"12234","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公である天宮 誠の義妹。"},{"spoiler":false,"text":"義父の連れ子で、幼い頃はなかなか誠を兄として受け入れなかった。"},{"spoiler":false,"text":"現在も口数はさほど多くないが、暇があればお兄ちゃんの部屋に来て、ベッドで女性誌を読んでいたりする。"},{"spoiler":false,"text":"よく寝る子で、いつも朝はお兄ちゃんに起こされている。"},{"spoiler":false,"text":"本人は「お兄ちゃんはわたしがいないと何もできない」と言っているが、どちらかといえば、お兄ちゃんがいないと何もできない子。"},{"spoiler":false,"text":"誠のバイト先でホラー映画ばかり借りていくが、臆病で、お兄ちゃんと一緒じゃなければ観られない。"},{"spoiler":false,"text":"「わたしは、いい妹にはなれなかったね……」"}],"source":"bangumi","sourceCharacterId":"22658"}],"profileFacts":[{"label":"胸围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"14840","sourceWorkId":"12234","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"14840","sourceWorkId":"12234","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"14840","sourceWorkId":"12234","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"51 cm","valueContext":null,"source":"egs","sourceCharacterId":"14840","sourceWorkId":"12234","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"45 kg","valueContext":null,"source":"egs","sourceCharacterId":"14840","sourceWorkId":"12234","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03a39dd2650e7187abd75cf761cbf39a8acd5088546a00e66e52ced07afe4042.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee57688333de529c157553162cec6b9dcd500604f94ea241471c005fc9102088.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:14963:22658:4727:1","source":"bangumi"}]},{"characterId":"char_c2849","characterName":"琥珀","sourceIds":{"bangumi":[{"characterId":"22659","match":"exact-normalized-name-in-linked-work","subjectId":"14963"}],"egsCharacterIds":["14841"],"vndbCharacterId":"c2849"},"originalCharacterName":"琥珀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"70"},"height":{"reviewState":"no-conflict","source":"vndb","value":"146"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"69"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"48"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl that calls herself a shinigami. No one can see her except Makoto. Ever since he saw her at a murder scene carrying a large scythe, she's been appearing more frequently. She rarely shows any emotion, so you can't tell what she's thinking."},{"spoiler":false,"text":"Finding Makoto's room comfortable, she settles in before he realizes it, and enjoys watching him in the bath."}],"source":"vndb","sourceCharacterId":"c2849"},{"segments":[{"spoiler":false,"text":"自らを死神と名乗る少女。"},{"spoiler":false,"text":"他の人間はまったく気づかないが、誠だけはその姿を見ることができる。"},{"spoiler":false,"text":"殺人現場で巨大な鎌を手に佇んでいるところを誠に目撃され、それ以来、頻繁に姿を現すようになった。"},{"spoiler":false,"text":"ほとんど感情を表に出さず、何を考えているのかわからない。"},{"spoiler":false,"text":"誠の部屋は居心地がよいらしく、いつの間にか住み着いてしまう。"},{"spoiler":false,"text":"誠がお風呂で体を洗っているのを、じーっと見るのが好き。だが、股間に向けられるその眼差しは冷たい。"}],"source":"egs","sourceCharacterId":"14841","sourceWorkId":"12234","spoiler":false},{"segments":[{"spoiler":false,"text":"自らを死神と名乗る少女。"},{"spoiler":false,"text":"他の人間はまったく気づかないが、誠だけはその姿を見ることができる。"},{"spoiler":false,"text":"殺人現場で巨大な鎌を手に佇んでいるところを誠に目撃され、それ以来、頻繁に姿を現すようになった。"},{"spoiler":false,"text":"ほとんど感情を表に出さず、何を考えているのかわからない。"},{"spoiler":false,"text":"誠の部屋は居心地がよいらしく、いつの間にか住み着いてしまう。"},{"spoiler":false,"text":"誠がお風呂で体を洗っているのを、じーっと見るのが好き。"},{"spoiler":false,"text":"だが、股間に向けられるその眼差しは冷たい。"},{"spoiler":false,"text":"「あなたは、どんな顔をして死んでいくの？」"}],"source":"bangumi","sourceCharacterId":"22659"}],"profileFacts":[{"label":"胸围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"14841","sourceWorkId":"12234","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"146 cm","valueContext":null,"source":"egs","sourceCharacterId":"14841","sourceWorkId":"12234","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"69 cm","valueContext":null,"source":"egs