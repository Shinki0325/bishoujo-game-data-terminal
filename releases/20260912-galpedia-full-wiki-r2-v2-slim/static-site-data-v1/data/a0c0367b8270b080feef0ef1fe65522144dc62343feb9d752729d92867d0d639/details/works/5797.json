-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0ba3b138075b44b23a7387242f12aea4bdee0c632f25036b5ff8e12e1f788f8a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e729cc98796e46e5e4d5fd9ce4c0fceb26981d1d19d4108bfa16a6a40d18cd37.webp","width":217,"height":241,"source":"static-detail"},"actors":[{"creditedName":"田村 ゆかり","creatorId":"vndb:s104","sourcePersonId":"vndb:s104","canonicalEntityId":"vndb:s104","name":"田村 ゆかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76524","source":"vndb"}]},{"characterId":"char_vndb_c77389","characterName":"中原 小麦","sourceIds":{"vndbCharacterId":"c77389"},"originalCharacterName":"中原 小麦","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main character, a 17-year-old cosplayer who transforms into Nurse Witch Komugi. She works for a talent agency called Kiri Pro, where she acts and endorses products (usually while wearing silly looking costumes). She can be very hyper and silly, which usually gets her into trouble with her bosses. Her nurse witch costume is a cross between a nurse uniform and a rabbit costume. The running joke of her flat chest is used ad nauseam. Also, Komugi has a crush on Kyosuke."},{"spoiler":false,"text":"(Source: Wikipedia)"}],"source":"vndb","sourceCharacterId":"c77389"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f63b1ffeb7c96e1b6580c5439d1b81ad4cebb2f5c07255af7bef408c7495edee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/3225e3bb95d16d8c61555e4c0cc8c268670025c91fe37a71fb8ac3a072e7fb59.webp","width":195,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桃井 はるこ","creatorId":"vndb:s247","sourcePersonId":"vndb:s247","canonicalEntityId":"vndb:s247","name":"桃井 はるこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76525","source":"vndb"}]},{"characterId":"char_vndb_c77390","characterName":"国分寺こより","sourceIds":{"vndbCharacterId":"c77390"},"originalCharacterName":"国分寺こより","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Koyori is a friend of Komugi and works with her as a model and cosplayer. However, from time to time, Koyori will lose consciousness and transform into Magical Maid Koyori, her evil form. Koyori will then infect innocent people with viruses. She could be considered Komugi's rival. She often gets frustrated at being constantly defeated by Komugi and Mugimaru. After a time, she will revert to her good form again with no memory of anything she did in her evil form."},{"spoiler":false,"text":"(Source: Wikipedia)"}],"source":"vndb","sourceCharacterId":"c77390"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/484a7fd362a2cdaed21e075c290e826115f948ded25f8bdc3c666b6de7eb6103.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/0888eb6ff61afaba855eb2fc74ce25c9e8ba10f5615ddb7e702968ce40f9bb42.webp","width":206,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大谷 育江","creatorId":"vndb:s1320","sourcePersonId":"vndb:s1320","canonicalEntityId":"vndb:s1320","name":"