"sourceCharacterId":"c7389"},{"segments":[{"spoiler":false,"text":"不治の病を宣告された薄幸の少女。"},{"spoiler":false,"text":"おっとりとしていて、優しく気弱な性格。"},{"spoiler":false,"text":"しかし、内には強い意志と、芯の通った考えを持っている。"},{"spoiler":false,"text":"愛情が病的なほどに強く、それが盲目的な危うさとなって、周りが見えなくなってしまうことも。"},{"spoiler":false,"text":"幼馴染の平川洋介に片想いしているが、なかなか告白できないでいるところに不治の病を発病してしまう。担当医の人体改造を受ければ元気になれるという言葉を信じ、自らの体を差し出す……。"}],"source":"egs","sourceCharacterId":"17018","sourceWorkId":"11166","spoiler":false},{"segments":[{"spoiler":false,"text":"普段はおっとりしていて、気弱に見える少女。"},{"spoiler":false,"text":"自分の意見をあまり表に出せず、他人に対しても強く出ることができない。"},{"spoiler":false,"text":"だが単に気弱というわけではなく、自分の内には強い意思と芯が通った考えを持っている。"},{"spoiler":false,"text":"それゆえに盲目的な愛情を抱き、病気を治して告白をするために、主人公の怪しげな治療を受けることを決意してしまう。"}],"source":"bangumi","sourceCharacterId":"40810"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a25b3feaee53f7b2895f1e07297b8e9f8bedf26ce915a9cee06a02939e1d8efa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52bc08c69b0f0b72e748d98b0cff566532de4030c4a0405df56d31125b9ff542.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:73824:40810:5936:1","source":"bangumi"}]},{"characterId":"char_vndb_c62304","characterName":"榊 康治","sourceIds":{"vndbCharacterId":"c62304"},"originalCharacterName":"榊 康治","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p765","sourceCompanyId":"egs:brand:1121","canonicalEntity