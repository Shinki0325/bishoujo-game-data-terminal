:104507","source":"vndb"},{"creditedName":"社","creatorId":"vndb:s31222","sourcePersonId":"vndb:s31222","canonicalEntityId":"vndb:s31222","name":"社","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:104508","source":"vndb"},{"creditedName":"hira","creatorId":"vndb:s32389","sourcePersonId":"vndb:s32389","canonicalEntityId":"vndb:s32389","name":"hira","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:104509","source":"vndb"},{"creditedName":"じゅん","creatorId":"vndb:s34131","sourcePersonId":"vndb:s34131","canonicalEntityId":"vndb:s34131","name":"じゅん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:104510","source":"vndb"},{"creditedName":"橘 エリカ","creatorId":"vndb:s3691","sourcePersonId":"vndb:s3691","canonicalEntityId":"vndb:s3691","name":"橘 エリカ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:104511","source":"vndb"}]},"cast":[{"characterId":"char_c22928","characterName":"天瀬 愛美","sourceIds":{"bangumi":[{"characterId":"136994","match":"exact-normalized-name-in-linked-work","subjectId":"100594"}],"egsCharacterIds":["2667"],"vndbCharacterId":"c22928"},"originalCharacterName":"天瀬 愛美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"名門・都雲（つぐも）女子学園の学園生。都雲学園都市で寮生活をしている。"},{"spoiler":false,"text":"学園までは電車で通学。"},{"spoiler":false,"text":"内気な性格。主張するのが下手で、すぐ緊張する。"},{"spoiler":false,"text":"優しいというよりは依存体質で、入れ込むところがある。"},{"spoiler":false,"text":"誰かの期待に応えようと必死になり過ぎる。"}],"source":"egs","sourceCharacterId":"2667","sourceWorkId":"19787","spoiler":false},{"segments":[{"spoiler":false,"text":"名門・都雲（つぐも）女子学園の学園生。"},{"spoiler":false,"text":"都雲学園都市で寮生活をしていて、学園までは電車で通学。"},{"spoiler":false,"text":"内気な性格のせいで主張するのが下手で、すぐ緊張する。"},{"spoiler":false,"text":"優しいというよりは依存体質で、入れ込むところがある。"},{"spoiler":false,"text":"誰かの期待に応えようと必死になり過ぎる。"},{"spoiler":false,"text":"痴漢取締官の天瀬真琴は姉で、「何かあったらいつでも相談しなさい」 と言われているが、愛美が抱え込んでしまう性格のため 「特に問題はないんだな」 と思われてしまう。"},{"spoiler":false,"text":"「ち、ちがっ……ちがい、ますぅ……んんあっ、私、か、感じてなんか……！」"}],"source":"bangumi","sourceCharacterId":"136994"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b5156313a099dd89688d223523888282e376aeeb42b22325333f03a5d209ed5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e426d328a4364981e29e80a37d902ad82240e4013cf7ec747fd730afeaa0567.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤田しずく","creatorId":"vndb:s937","sourcePersonId":"vndb:s937","canonicalEntityId":"vndb:s937","name":"藤田 しずく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100594:136994:16178:1","source":"bangumi"}]},{"characterId":"char_c22929","characterName":"桃園 麗華","sourceIds":{"bangumi":[{"characterId":"136995","match":"exact-normalized-name-in-linked-work","subjectId":"100594"}],"egsCharacterIds":["2668"],"vndbCharacterId":"c22929"},"originalCharacterName":"桃園 麗華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"旧華族『桃園家』の令嬢。上流階級に属する生粋のお嬢様。強気で高飛車な性格。"},{"spoiler":false,"text":"都雲女子学園の規則により、リムジンでの通学を、電車通学に変更することに。"},{"spoiler":false,"text":"桃園グループの実質的中心人物が父親。"},{"spoiler":false,"text":"「最も出来がいい奴を後継者にする」と言われて育った。姉や兄よりも勉強などができて、他の技能についても申し分ない。"},{"spoiler":false,"text":"条件付けで愛されて育ったせいで、無条件に父に愛されたいという欲求を無意識のうちに持っている。"}],"source":"egs","sourceCharacterId":"2668","sourceWorkId":"19787","spoiler":false},{"segments":[{"spoiler":false,"text":"旧華族 『桃園家』 の令嬢。"},{"spoiler":false,"text":"上流階級に属する生粋のお嬢様であり、強気で高飛車な性格をしている。"},{"spoiler":false,"text":"都雲女子学園の規則により、リムジンでの通学を電車通学に変更することに。"},{"spoiler":false,"text":"桃園グループの実質的中心人物である父親に、「最も出来がいい奴を後継者にする」 と言われて育った。"},{"spoiler":false,"text":"姉や兄よりも勉強などができて、他の技能についても申し分ない実力を持つ。"},{"spoiler":false,"text":"条件付けで愛されて育ったせいで、無条件に父に愛されたいという欲求を無意識のうちに持っている。"},{"spoiler":false,"text":"「あっ……あぁ、やめなさい！　こんなところでセッ…クスなんて、……嫌ぁぁ!!」"}],"source":"bangumi","sourceCharacterId":"136995"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3ae47aa6055256e4013e14938e48bd990018a75d9e83f99b91d878a7f867c89.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/4858ba707e4397c82e0f7c21ff4b8d20f5972c24baaf6cf8c8572846ed035030.webp","width":165,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平井まみ","creatorId":"vndb:s939","sourcePersonId":"vndb:s939","canonicalEntityId":"vndb:s939","name":"平井 まみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100594:136995:18547:1","source":"bangumi"}]},{"characterId":"char_c22930","characterName":"野田 茜","sourceIds":{"bangumi":[{"characterId":"136996","match":"exact-normalized-name-in-linked-work","subjectId":"100594"}],"egsCharacterIds":["2669"],"vndbCharacterId":"c22930"},"originalCharacterName":"野田 茜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人妻。規格外の爆乳。温室育ちで世間知らず。羞恥心が強い。"},{"spoiler":false,"text":"挫折したことがなく、思い詰めてしまうところがある。"},{"spoiler":false,"text":"両親は資産家で、夫の家も名家。夫は一回り上野新人県会議員。お見合いで結婚。"},{"spoiler":false,"text":"夫はセックスに関して淡泊。"},{"spoiler":false,"text":"茜自身は軽いアクメにしか達したことがなく、本物の絶頂を知らないが、もっと気持ちいいことがあるなどと知るはずもない。"}],"source":"egs","sourceCharacterId":"2669","sourceWorkId":"19787","spoiler":false},{"segments":[{"spoiler":false,"text":"規格外の爆乳をもつ人妻。 羞恥心が強い。"},{"spoiler":false,"text":"温室育ちの世間知らずで、挫折したことがないせいか思い詰めてしまうところがある。"},{"spoiler":false,"text":"両親は資産家で、夫の家も名家。 夫は一回り上の新人 県会議員であり、お見合いで結婚。"},{"spoiler":false,"text":"夫がセックスに関して淡泊なせいで、茜自身は軽いアクメにしか達したことがない。"},{"spoiler":false,"text":"そのため本物の絶頂を知らないが、もっと気持ちいいことがあるなどと知るはずもない。"},{"spoiler":false,"text":"「はぅっ、やめてくださ……いままで夫にしか触られたことがないのに……！」"}],"source":"bangumi","sourceCharacterId":"136996"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2cf881138df4638b018d6f82bd10528be231be04b002158bd38d8801e74ecc67.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42110df02ad2a243f7be7cd75eb51cb9293ff44e86ba8f254b1b9acbea1028a7.webp","width":158,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山名枝里子","creatorId":"vndb:s17301","sourcePersonId":"vndb:s17301","canonicalEntityId":"vndb:s17301","name":"山名 枝里子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100594:136996:16083:1","source":"bangumi"},{"creditedName":"桜城 ちか","creatorId":"vndb:s1174","sourcePersonId":"vndb:s1174","canonicalEntityId":"vndb:s1174","name":"月ヶ瀬 あかね","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:55905","source":"vndb"}]},{"characterId":"char_c22931","characterName":"安城 流花","sourceIds":{"bangumi":[{"characterId":"136997","match":"exact-normalized-name-in-linked-work","subjectId":"100594"}],"egsCharacterIds":["2670"],"vndbCharacterId":"c22931"},"originalCharacterName":"安城 流花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"都雲学園都市で寮生活をしている学生。一年生。"},{"spoiler":false,"text":"貧乳・ロリ。背が低く、子どもっぽい。"},{"spoiler":false,"text":"性格は極度に内気な性格。おどおどしていて引っ込み思案。趣味は読書。"}],"source":"egs","sourceCharacterId":"2670","sourceWorkId":"19787","spoiler":false},{"segments":[{"spoiler":false,"text":"都雲学園都市で寮生活をしている学生。 一年生。"},{"spoiler":false,"text":"貧乳・ロリ。 背が低く、子どもっぽい。"},{"spoiler":false,"text":"極度に内気な性格で、おどおどしていて引っ込み思案。 趣味は読書。"},{"spoiler":false,"text":"昔から “あがり症＋人見知り” で、人と面と向かってしゃべることができない。"},{"spoiler":false,"text":"入学一週間前に行われたが学園主催の親睦会で流花だけ誰一人友達ができず、いわゆるボッチになってしまう。"},{"spoiler":false,"text":"「おじさん、どこを触って……！　電車の中で……だ、ダメェっ……!!」"}],"source":"bangumi","sourceCharacterId":"136997"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8ca37cc2627c6cd1a24c01be72d7d64dc98ff0edb272293473b74488e11c7fb6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a74b3dbdd3502dc92a599cc25fc0ec0d02226831617ab11a511735aa1c42813a.webp","width":184,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花野うさぎ","creatorId":"vndb:s1496","sourcePersonId":"vndb:s1496","canonicalEntityId":"vndb:s1496","name":"花野うさぎ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100594:136997:25349:1","source":"bangumi"}]},{"characterId":"char_c22932","characterName":"天瀬 真琴","sourceIds":{"bangumi":[{"characterId":"136998","match":"exact-normalized-name-in-linked-work","subjectId":"100594"}],"egsCharacterIds":["2671"],"vndbCharacterId":"c22932"},"originalCharacterName":"天瀬 真琴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"痴漢取締官。「天瀬 愛美」の姉。"},{"spoiler":false,"text":"正義感が強く、妹思い。幼い頃から愛美がいじめられるとすぐに駆けつけ相手をやっつけてきた。"},{"spoiler":false,"text":"大切なものを守るため強くなりたいと思い、学園生時代は合気道部に所属。"},{"spoiler":false,"text":"成人しているが、男性と付き合った経験はなく処女。"},{"spoiler":false,"text":"高校時代、痴漢に遭って恐怖で動けなかったことがあり、その弱い自分と決別するため大学を卒業後、取締官になった。"}],"source":"egs","sourceCharacterId":"2671","sourceWorkId":"19787","spoiler":false},{"segments":[{"spoiler":false,"text":"痴漢取締官。 天瀬愛美の姉。"},{"spoiler":false,"text":"正義感が強く、妹思い。 幼い頃から愛美がいじめられるとすぐに駆けつけ、相手をやっつけてきた。"},{"spoiler":false,"text":"大切なものを守るため強くなりたいと思い、学園生時代は合気道部に所属。"},{"spoiler":false,"text":"成人しているが、男性と付き合った経験はなく処女。"},{"spoiler":false,"text":"高校時代、痴漢に遭ったとき恐怖で動けなかったことがあり、その弱い自分と決別するため大学を卒業後、取締官になった。"},{"spoiler":false,"text":"「妹の代わりに、私がお前たちの相手をしてやる。 だから、愛美には手を出すな……！」"}],"source":"bangumi","sourceCharacterId":"136998"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c46f2351e1aa770fa6ce5305be726b4a2919b0018151c568a675182a247405d9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24b44d312b1fa5d85dd6596e8930d87828826302557021d32535d34be52a61a8.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中美智","creatorId":"vndb:s796","sourcePersonId":"vndb:s796","canonicalEntityId":"vndb:s796","name":"田中美智(多田美智)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100594:136998:6313:1","source":"bangumi"}]},{"characterId":"char_c22933","characterName":"ソフィア・イグルノフ","sourceIds":{"bangumi":[{"characterId":"136999","match":"exact-normalized-name-in-linked-work","subjectId":"100594"}],"egsCharacterIds":["2672"],"vndbCharacterId":"c22933"},"originalCharacterName":"ソフィア・イグルノフ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"スーツを着用したブロンド美女。頭が切れ、容姿端麗、スタイル抜群。"},{"spoiler":false,"text":"ロシア人だが、流暢な日本語で会話する。"},{"spoiler":false,"text":"メガネの奥から覗かせる鋭い目つきには、他人を無視させない力がある。"},{"spoiler":false,"text":"自分にも他人にも恐ろしく厳しい性格。"},{"spoiler":false,"text":"桃園グループの要である桃園麗華の父・桃園宗円（ももぞのそうえん）の第一秘書。"},{"spoiler":false,"text":"宗円に亡き父親の面影を重ねており、慕っているが普段はそのような素振りは微塵も見せない。"},{"spoiler":false,"text":"雇い主の令嬢・桃園麗華が痴漢に遭ったため、痴漢グループの調査をすることに。"},{"spoiler":false,"text":"しかし痴漢達によって、自らも無自覚であったＭの素質を見抜かれ、身体を開発されていく。"}],"source":"egs","sourceCharacterId":"2672","sourceWorkId":"19787","spoiler":false},{"segments":[{"spoiler":false,"text":"頭が切れ、容姿端麗、スタイル抜群。ロシア人だが、流暢な日本語で会話する。"},{"spoiler":false,"text":"メガネの奥から覗かせる鋭い目つきには、他人を無視させない力がある。"},{"spoiler":false,"text":"桃園グループの要である桃園宗円の第一秘書。"},{"spoiler":false,"text":"雇い主の令嬢・麗華が痴漢に遭ったため、痴漢グループの調査を開始することに。"},{"spoiler":false,"text":"しかし痴漢達によって、自らも無自覚であったMの素質を見抜かれ、身体を開発されていく。"},{"spoiler":false,"text":"「……社会のクズどもめ。今に私が一網打尽にしてやるわ」"}],"source":"bangumi","sourceCharacterId":"136999"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7db3807ea4b7c42b58fdb7f70708dbcdc2c461c5c517038c01fa75dda4bf452.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12939f98d5b6e1695597156378471fd68edc923127033626744112af55763d86.webp","width":158,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100594:136999:10027:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p2235","sourceCompanyId":"egs:brand:1724","canonicalEntityId":"vndb:p2235","name":"catwalkNERO","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:19787:1724","source":"egs"},{"companyId":"vndb:p220","sourceCompanyId":"vndb:p220","canonicalEntityId":"vndb:p220","name":"catwalk","roleCodes":["publisher"],"identityStatus":"source-native","relationId"