"vndb"},{"creditedName":"梓茵茵","creatorId":"vndb:s50821","sourcePersonId":"vndb:s50821","canonicalEntityId":"vndb:s50821","name":"梓茵茵","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:213236","source":"vndb"},{"creditedName":"遥溯","creatorId":"vndb:s50822","sourcePersonId":"vndb:s50822","canonicalEntityId":"vndb:s50822","name":"遥溯","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:213237","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c148005","characterName":"Hou Chiyuu","sourceIds":{"vndbCharacterId":"c148005"},"originalCharacterName":"Hou Chiyuu","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist. After losing his parents at the age of nine, he was adopted by his uncle. Fang passed the imperial examination at a young age and became a scholar. However, he chose to live alone, gave up pursuing an official career, and tried to spend the rest of his life as a writer."},{"spoiler":false,"text":"He tried to emulate the Scoffing Scholar of Lanling, who wrote The Plum in the Golden Vase inspired by Water Margin. Similarly, Fang Zhiyou created The Lion Camel Kingdom based on Journey to the West. However, the death of his friend Su Lianyan shocked him so deeply that he could no longer write. He lost his memories and developed an illness that caused him to see people as beasts. In 1645 on the 24th day of the fourth lunar month, after drinking heavily, he found himself transported to The Lion Camel Kingdom — the very world he had once written about."}],"source":"vndb","sourceCharacterId":"c148005"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efd12407ceb95f222d2d53155e30fb389d35729e7bf701b4a993e0030421ea12.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee0b512e63cd721324e75961deb56e4a01a53d9b999214a57d1077a71b08f92a.webp","width":180,"height":210,"source":"static-detail"},"actors":[{"creditedName":"秦 且歌","creatorId":"vndb:s24144","sourcePersonId":"vndb:s24144","canonicalEntityId":"vndb:s24144","name":"钟 巍","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99718","source":"vndb"},{"creditedName":"苗洋","creatorId":"vndb:s47496","sourcePersonId":"vndb:s47496","canonicalEntityId":"vndb:s47496","name":"苗洋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99722","source":"vndb"}]},{"characterId":"char_vndb_c161065","characterName":"蘇 怜煙","sourceIds":{"vndbCharacterId":"c161065"},"originalCharacterName":"蘇 怜煙","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A courtesan who never offered bed services. She was an artist with a natural talent for writing poems, drawing, and playing different instruments. Su Lingyan was so famous that people from the whole empire traveled to see her performances."},{"spoiler":false,"text":"The night of the 15th year of Chongzhen, she ended her life by jumping from the Twenty-four Bridge into the cold waters."}],"source":"vndb","sourceCharacterId":"c161065"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de4fb3e58b95903751b5bfcab05c08b0440aaad491b9a2276c0d0eb483df5809.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e0a19b8d638f6352524d7623379eb4befc1d4df7cf4ca1ae9f9d27c1e553f78.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"陈 婷婷","creatorId":"vndb:s50071","sourcePersonId":"vndb:s50071","canonicalEntityId":"vndb:s50071","name":"陈 婷婷","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99724","source":"vndb"}]},{"characterId":"char_vndb_c161066","characterName":"Little Yan","sourceIds":{"vndbCharacterId":"c161066"},"originalCharacterName":"Little Yan","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/760367d613513423bed3acafe036867b363bcb0a08e02448eef0b05fbeee6a9f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/bafeef425ae20603cd4cf1469d378de300ffa3feb59ade6227cf6825e127e1db.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"陈 婷婷","creatorId":"vndb:s50071","sourcePersonId":"vndb:s50071","canonicalEntityId":"vndb:s50071","name":"陈 婷婷","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99725","source":"vndb"}]},{"characterId":"char_vndb_c161067","characterName":"Rin Henhen","sourceIds":{"vndbCharacterId":"c161067"},"originalCharacterName":"Rin Henhen","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Pianpian was born in poverty. In the 13th year of Chongzhen, she was selling herself at the Willow Street of the 24th Bridge. She met Zhiyou out of coincidence, but they gradually drifted apart after Lianyan's death. With her sensational beauty, she rose to fame many times in the following years. By the time Yaoguai broke into the city in the year of Yiyou, she was already the most prestigious \"Red Courtesan\" in 24th Bridges."}],"source":"vndb","sourceCharacterId":"c161067"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1dc0a92558569a3a2ce166abfc52a0a8399b21db9003b684356025d5b07847a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58dcc87e0e56f6cf4e14e657d8c48ea3bfacdd93886a2530d39de1425226bbaa.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"赵 爽","creatorId":"vndb:s26395","sourcePersonId":"vndb:s26395","canonicalEntityId":"vndb:s26395","name":"赵 爽","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99719","source":"vndb"}]},{"characterId":"char_vndb_c161068","characterName":"瓊花","sourceIds":{"vndbCharacterId":"c161068"},"originalCharacterName":"瓊花","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The wife of a general. She got her nickname, Qionghua, after the white-jaded flower she always wears in her hair. She used to live in a shelter under the Twenty-four Bridges, gathering victims from all around the city and protecting them from murder and theft in the name of her husband, Wang. As she became popular, the people she saved started calling her Madam White-Jaded Flower, or Madam Qionghua."}],"source":"vndb","sourceCharacterId":"c161068"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e048468e6d3f12196dda8ec62776249cb5275764dec93119310086b066f1bc4c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee5606c08a3db980cbe012248b0cbb40a9d50ab7b4ba440641807f10305e15c8.webp","width":180,"height":210,"source":"static-detail"},"actors":[{"creditedName":"花玲","creatorId":"vndb:s37373","sourcePersonId":"vndb:s37373","canonicalEntityId":"vndb:s37373","name":"花玲","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99721","source":"vndb"}]},{"characterId":"char_vndb_c161069","characterName":"The Golden Winged Great Peng","sourceIds":{"vndbCharacterId":"c161069"},"originalCharacterName":"The Golden Winged Great Peng","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"31"},"birthday":{"reviewState":"source-only","source":"vndb","value":"402"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The responsible for the massacre of the city in The Lion Camel Kingdom. He is one of the three Yaoguai of Shituo Ridge. Of an unpredictable personality, his actions are hard to comprehend, yet he often accomplishes remarkable feats. The eldest Yaoguai brother is the violent Green Lion, the second is the cunning and scheming White Elephant, and Tathagata Buddha who is yet to become Buddha, is his own nephew."},{"spoiler":false,"text":"Based on Dodo, Prince Yu."}],"source":"vndb","sourceCharacterId":"c161069"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b0630f08701862e98864114f194face007a5d50a747f55d08d6f80d90b178aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/597be3fbee1a5e784460b659aec98a6a119ef1899faa788358b3242f79ba2ec6.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c161070","characterName":"Wang","sourceIds":{"vndbCharacter