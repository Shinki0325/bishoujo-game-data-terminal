spoiler":false,"text":"Minase’s classmate and one of Saeki’s followers. She finds out that Minase can use black magic, and asks him to chant an incantation for her."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c12312"},{"segments":[{"spoiler":false,"text":"水無瀬のクラスメイト。佐伯の取り巻きの一人。"},{"spoiler":false,"text":"彼氏とうまくいっているはずなのに、水無瀬に近づいてくる。"}],"source":"egs","sourceCharacterId":"17654","sourceWorkId":"11205","spoiler":false},{"segments":[{"spoiler":false,"text":"水無瀬のクラスメイトで、佐伯の取り巻きの一人。水無瀬が黒魔術を使うことを知り、まじないの依頼をしてくる。"}],"source":"bangumi","sourceCharacterId":"49732"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5ee169cdaf43b581cb93764d5120684678d5d6319c772fc0a0537304769587ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/4765c4b5e81cb72ef013658026bd6e275da17b86a38f07fb5b8bf6b0ace17670.webp","width":155,"height":240,"source":"static-detail"},"actors":[]},{"characterId":"char_c12313","characterName":"美樹本","sourceIds":{"bangumi":[{"characterId":"49729","match":"exact-normalized-name-in-linked-work","subjectId":"83940"}],"egsCharacterIds":["17657"],"vndbCharacterId":"c12313"},"originalCharacterName":"美樹本","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A member of the academy swim team. One of Kobayashi’s flunkies."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c12313"},{"segments":[{"spoiler":false,"text":"水泳部の一員。"}],"source":"egs","sourceCharacterId":"17657","sourceWorkId":"11205","spoiler":false},{"segments":[{"spoiler":false,"text":"水泳部の一員。小林の取り巻きの一人。"}],"source":"bangumi","sourceCharacterId":"49729"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3105d813519cedad827085005e53cce58a4bb2fbe1a6a847ca4c57fa42c0ea8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f44590b5902d009909e8dc19fed69c6f403fa174d22c09bcdbe22456ac07e69.webp","width":123,"height":240,"source":"static-detail"},"actors":[]},{"characterId":"char_c12314","characterName":"小林 忍","sourceIds":{"bangumi":[{"characterId":"49728","match":"exact-normalized-name-in-linked-work","subjectId":"83940"}],"egsCharacterIds":["17656"],"vndbCharacterId":"c12314"},"originalCharacterName":"小林 忍","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Captain of the academy swim team. She loathes Nonogusa."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c12314"},{"segments":[{"spoiler":false,"text":"水泳部の一員。"}],"source":"egs","sourceCharacterId":"17656","sourceWorkId":"11205","spoiler":false},{"segments":[{"spoiler":false,"text":"水泳部の一員。現部長で、自分よりも目立つ野々草を煙たがっている。"}],"source":"bangumi","sourceCharacterId":"49728"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36edc0e946f1e444c653cd79060b633491487200053b2e99c4f5930547191624.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7e333e395617b55d2852402d69119119b59e7afc3b330f18cbde892600d4103.webp","width":114,"height":240,"source":"static-detail"},"actors":[]},{"characterId":"char_c3584","characterName":"伊万里 胡桃","sourceIds":{"bangumi":[{"characterId":"21412","match":"exact-normalized-name-in-linked-work","subjectId":"83940"}],"egsCharacterIds":["17651"],"vndbCharacterId":"c3584"},"originalCharacterName":"伊万里 胡桃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Minase’s childhood friend and de facto girlfriend. She comes over to wake Minase up every morning. She knows everything about Minase, and tries to help him in every way. Note: She is black belt holder of shrinji kempo and very tough. She is good at cooking and takes care of Minase when Yukiko is away."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c3584"},{"segments":[{"spoiler":false,"text":"主人公の幼なじみであり彼女。"},{"spoiler":false,"text":"今も朝に弱い水無瀬を毎朝起こしにやってくる。"},{"spoiler":false,"text":"よく気が利くが、煙たがられてしまうことも。"}],"source":"egs","sourceCharacterId":"17651","sourceWorkId":"11205","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のヒロイン。右サイドポニーの髪型が特徴。縞パンを好んで穿く。"}],"source":"bangumi","sourceCharacterId":"21412"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68d7aa3aa6ac2e3b9a7b52618c2e26991f9c5ae5124c1caee7716f8aedc4dcd0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/6363c22669210f895af276b894871f5e684eb159c1e505d8c522df461ed98de5.webp","width":256,"height":192,"source":"static-detail"},"actors":[]},{"characterId":"char_c3595","characterName":"北見 麗華","sourceIds":{"bangumi":[{"characterId":"49723","match":"exact-normalized-name-in-linked-work","subjectId":"83940"}],"egsCharacterIds":["17659"],"vndbCharacterId":"c3595"},"originalCharacterName":"北見 麗華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The mysterious, seductive school nurse and the main antagonist of the series. She seems to take a liking for Minase, and she knows about his experiments with black magic. She has a lengthy history."},{"spoiler":true,"text":"Twelve years ago, Kitami was the chosen as a human sacrifice for the ritual to summon the devil. However, it resulted in all of the cult members' demise and she made contract with the devil to save her life. Now she has her eyes on Imari whose body she plans to exchange soul with in order to not be sent to hell."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c3595"},{"segments":[{"spoiler":false,"text":"亡くなる以前は学園の保健医。"},{"spoiler":false,"text":"事件の記憶を呼び覚まし、良からぬことが起こり始める。"}],"source":"egs","sourceCharacterId":"17659","sourceWorkId":"11205","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の保健医。水無瀬が苦手とする教師。その経歴には謎が多い。その妖しい色気からか、あまり良い噂は聞こえてこない。"}],"source":"bangumi","sourceCharacterId":"49723"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f81fc9324b865f0ba95e77db91d399fa9e8c38172a85d4dc4228043f82385fc0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a329cf278d72eb09320480e840ed3ffca06b08f9f0ceda31c2b2f3be99e848dc.webp","width":94,"height":240,"source":"static-detail"},"actors":[]},{"characterId":"char_c3596","characterName":"高城 寛子","sourceIds":{"bangumi":[{"characterId":"49722","match":"exact-normalized-name-in-linked-work","subjectId":"83940"}],"egsCharacterIds":["17652"],"vndbCharacterId":"c3596"},"originalCharacterName":"高城 寛子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The school art professor. She’s in charge of the art club, which both Minase and Imari are part of. She’s very popular among the students for her good looks and personality."},{"spoiler":true,"text":"She was the former leader of the mysterious witchcraft club from twelve years ago, Rose Cross, and the only survivor who once experience the horror of Dark Magic. Not wanting anyone else to fall into the temptation, she honed her magical skill which is put to use when history begins to repeat."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c3596"},{"segments":[{"spoiler":false,"text":"学園の美術教師。先生が不在の間に事態は急転していく。"}],"source":"egs","sourceCharacterId":"17652","sourceWorkId":"11205","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の美術教師。水無瀬と伊万里の所属する美術部の顧問を務めている。その容姿と良い性格から、女子からも男子からも人望が厚い。"}],"source":"bangumi","sourceCharacterId":"49722"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12fc43b19c87e6b70170054286718fd03561a3e84074886c2a5a5e1c255f0ee5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fcd22e997737e50c4df7575159a812854490d5b2b5742b6e6ac23fb8a10cf5a.webp","width":104,"height":240,"source":"static-detail"},"actors":[]},{"characterId":"char_c3597","characterName":"佐伯 香織","sourceIds":{"bangumi":[{"characterId":"49724","match":"exact-normalized-name-in-linked-work","subjectId":"83940"}],"egsCharacterIds":["6959"],"vndbCharacterId":"c3597"},"originalCharacterName":"佐伯 香織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Minase’s classmate. She’s obsessed with the occult, and has established a new occult group based on the one from twelve years ago. She knows a lot about black magic, and her fortune telling is very popular. She becomes interested in Minase after learning about Minase possessing the book."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c3597"},{"segments":[{"spoiler":false,"text":"ワルプルギスの夜以降、黒魔術まがいのことどころか、タロット占いさえも封印していた。"},{"spoiler":false,"text":"しかしなぜか、再び占いをするようになる。"}],"source":"egs","sourceCharacterId":"6959","sourceWorkId":"11205","spoiler":false},{"segments":[{"spoiler":false,"text":"水無瀬達のクラスメイト。オカルトヲタクで、１２年前の学生達を模したカルトサークルを作り、意欲的な活動をしている。黒魔術にも詳しく、彼女の占いはかなりの評判である。"}],"source":"bangumi","sourceCharacterId":"49724"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f64892dc794bd17c5a2a0b6fe280bb7af4dc744b8aaef873c1670da772650ba3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f38bd1fdd1100a1c771688bd77cbd864144a01e62d5d8b53170d50d1ac812833.webp","width":142,"height":240,"source":"static-detail"},"actors":[]},{"characterId":"char_c3599","characterName":"水無瀬 由起子","sourceIds":{"bangumi":[{"characterId":"49730","match":"exact-normalized-name-in-linked-work","subjectId":"83940"}],"egsCharacterIds":["17658"],"vndbCharacterId":"c3599"},"originalCharacterName":"水無瀬 由起子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"First presented to be his stepsister, she is actually Minase’s live-in cousin and guardian, with the two acting like siblings due to them being close. She’s a strong-willed person, and enjoys tormenting Minase as well as teasing him at home with flashy outfits. Since she learned Latin and French in grad school, she helps Minase translate the contents of the book."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c3599"},{"segments":[{"spoiler":false,"text":"水無瀬の姉。"}],"source":"egs","sourceCharacterId":"17658","sourceWorkId":"11205","spoiler":false},{"segments":[{"spoiler":false,"text":"水無瀬の姉。気が強く、水無瀬をいじめるのを趣味としている。大学でラテン語やフランス語を修得している為、魔導書の翻訳に役だってくれる。"}],"source":"bangumi","sourceCharacterId":"49730"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f1c735beae5ba6e69e4fe1cbc773c1985c98e509de2ef1f7db98162ecfc30f46.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c21173124145b04c1f3f65b40ee97bd123afb20b11a7a51a5a973fb12985b9f.webp","width":109,"height":240,"source":"static-detail"},"actors":[]},{"characterId":"char_c3600","characterName":"Itō Mika","sourceIds":{"bangumi":[{"characterId":"49731","match":"exact-normalized-name-in-linked-work","subjectId":"83940"}],"egsCharacterIds":["17653"],"vndbCharacterId":"c3600"},"originalCharacterName":"Itō Mika","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Minase’s classmate and one of Saeki’s followers. She defends Saeki when Minase makes fun of her. She’s the first victim of Minase's practice of the book."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c3600"},{"segments":[{"spoiler":false,"text":"水無瀬のクラスメイトで、佐伯の取り巻きの一人だったが、あの事件以来学園に姿を見せなくなった。"}],"source":"egs","sourceCharacterId":"17653","sourceWorkId":"11205","spoiler":false},{"segments":[{"spoiler":false,"text":"水無瀬のクラスメイトで、佐伯の取り巻きの一人。佐伯の事を馬鹿にする水無瀬につっかかってくる。魔導書の最初の犠牲者。"}],"source":"bangumi","sourceCharacterId":"49731"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79266dbc74df62f22bf119e4aa5bcbe1ea12d36a36b67a601212b087876f937f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4cef8a9c9550c509ae7fe45a337461cad4cf75b527d4d2740b870ca4a3d0c450.webp","width":99,"height":240,"source":"static-detail"},"actors":[]},{