"sourcePersonId":"vndb:s27050","canonicalEntityId":"vndb:s27050","name":"あき","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:28598","source":"vndb"},{"creditedName":"高岡 嘉子","creatorId":"vndb:s36781","sourcePersonId":"vndb:s36781","canonicalEntityId":"vndb:s36781","name":"高岡 嘉子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:28599","source":"vndb"},{"creditedName":"GAI","creatorId":"vndb:s43315","sourcePersonId":"vndb:s43315","canonicalEntityId":"vndb:s43315","name":"GAI","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:28600","source":"vndb"}]},"cast":[{"characterId":"char_c14025","characterName":"音羽 葉子","sourceIds":{"bangumi":[{"characterId":"140427","match":"exact-normalized-name-in-linked-work","subjectId":"120318"},{"characterId":"140427","match":"exact-normalized-name-in-linked-work","subjectId":"41747"}],"egsCharacterIds":["8366"],"vndbCharacterId":"c14025"},"originalCharacterName":"音羽 葉子","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The third heroine of Natsu Kagura and the elder of the Otowa Clan. A Freeloader of Minamori shrine and a gentle person. She is very calm in any situation. Youko is actually an incarnation of nine tailed fox spectre. She was sealed by the great grandfather of Otowa, long time ago, and since then she had been serving at the Otowa home. Due to the nature of a fox, her smile is unexpectedly a part of her scheming. She has a bad habit of teasing other people, especially Keika, even during sex with her. In many ocassion, she demonstrated her great knowledges regarding the situatiion, including the youkai's detail. Youko seems to know Kijima from Oni Kagura series since long time ago. She has daughter named Nanaka, who appears at Debo no Subako. Youko appears at Aozora Magiccer which is direct sequel of Youko's route from Natsu Kagura and take place in alternate (fantasy) universe. Youko also makes cameo at Kagura Douchukii."}],"source":"vndb","sourceCharacterId":"c14025"},{"segments":[{"spoiler":false,"text":"音羽家一番の年長者。 神社の居候。 音羽家で一番胸の大きい人。"},{"spoiler":false,"text":"一見おっとりさんで、大抵のことには動じず笑顔のままで対応できる大物。"},{"spoiler":false,"text":"しかし時々人をからかう悪い癖を持っていて、意外と腹黒い部分もある。"},{"spoiler":false,"text":"実は昔の大妖怪で狐の化身。 桂香たちの祖父に封じられ、以来音羽家に仕えている。"},{"spoiler":false,"text":"現在は霊力のほとんどが封じられているので簡単な雑務しか出来ないが、膨大な知識を持っていて妖怪や退魔についても詳しい。"}],"source":"egs","sourceCharacterId":"8366","sourceWorkId":"20961","spoiler":false},{"segments":[{"spoiler":false,"text":"音羽家一番の年長者。神社の居候。"},{"spoiler":false,"text":"音羽家で一番胸の大きい人。"},{"spoiler":false,"text":"一見おっとりさんで、常に微笑みをたたえています。"},{"spoiler":false,"text":"大抵のことには動じず、笑顔のままで対応出来る大物。"},{"spoiler":false,"text":"ただし本性が妖怪なので、腹黒い部分もあるようです。"},{"spoiler":false,"text":"年の功というか、策士の人。"}],"source":"bangumi","sourceCharacterId":"140427"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d55d252216ff2165c052a032126a0d9658816f70ae8a3c4b41052e26de9cc89.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/0788968f245192b9c7f86d8401dfc7a3b06796cdcc84fb22e2e2344b0280c8d8.webp","width":123,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青山 ゆかり","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14997","source":"vndb"}]},{"characterId":"char_c31180","characterName":"嵐山 いぶき","sourceIds":{"bangumi":[{"characterId":"34863","match":"exact-normalized-name-in-linked-work","subjectId":"115279"},{"characterId":"34863","match":"exact-normalized-name-in-linked-work","subject