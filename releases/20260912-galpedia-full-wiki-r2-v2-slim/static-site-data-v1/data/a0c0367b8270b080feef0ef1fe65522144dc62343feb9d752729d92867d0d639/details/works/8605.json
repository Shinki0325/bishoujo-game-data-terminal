erId":"25946","sourceWorkId":"6916","spoiler":false},{"segments":[{"spoiler":false,"text":"これで先生はまゆらのものよ───"},{"spoiler":false,"text":"鹿神の屋敷内における絶対的な支配者。命令者としてのS。"},{"spoiler":false,"text":"同時に屋敷内の人間が、心の底で望む責めを与える全体の奉仕者。"},{"spoiler":false,"text":"メイドと少女奴隷を使って、羞恥と快感で主人公を屈服させていく。"},{"spoiler":false,"text":"美しく高貴な雰囲気と無邪気さが同居する、あどけない魔性。"}],"source":"bangumi","sourceCharacterId":"88424"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c01b8fa37a9d9ab215ea1a3041ae650c1e9b0bf431a66dd6af465ae45892afec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a09876874652a9869982258fc9173e5215cc798049fc2bf3940fa30c4a57191.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひかる","creatorId":"vndb:s6374","sourcePersonId":"vndb:s6374","canonicalEntityId":"vndb:s6374","name":"ひかる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:30512","source":"vndb"}]},{"characterId":"char_c68557","characterName":"早紀坂 由梨江","sourceIds":{"bangumi":[{"characterId":"137233","match":"exact-normalized-name-in-linked-work","subjectId":"30215"}],"egsCharacterIds":["25947"],"vndbCharacterId":"c68557"},"originalCharacterName":"早紀坂 由梨江","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"gender":{"reviewState":"source-only","source":"vndb","value":"f"},"sex":{"reviewState":"source-only","source":"vndb","value":"b"}},"descriptions":[{"segments":[{"spoiler":false,"text":"まゆらに傅くメイド。"},{"spoiler":false,"text":"普段は屋敷内の全てをひとりで切り盛りしている。"},{"spoiler":false,"text":"彼女は両性具有の特殊な肉体を持ち、そのことにコンプレックスを抱いていたが、まゆらに両性の悦びを説かれ、彼女に従属することを誓った。"}],"source":"egs","sourceCharacterId":"25947","sourceWorkId":"6916","spoiler":false},{"segments":[{"spoiler":false,"text":"───私の身体の事、どう思われますか？"},{"spoiler":false,"text":"まゆらに仕えるメイド。普段は屋敷内の全てを一人で切り盛りしており、H時はまゆらの命令の元、主人公や恵美を責める事が多い。 ふたなりであり、その身体にコンプレックスを持っていたが、まゆらに両性の喜びを教えられ、以降彼女に尽くそうと決意する。 性的な欲求に弱く、ひとたび昂ぶってしまうと普段の冷静な態度をかなぐり捨て、あられもない姿をさらしてしまう。"}],"source":"bangumi","sourceCharacterId":"137233"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"b","source":"vndb","sourceCharacterId":"c68557","value":"b"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"25947","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"25947","value":"女性"},{"comparisonValue":"f","source":"bangumi","sourceCharacterId":"137233","value":"女"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10369acce1e0a435e7b03c00d6f42c0f3045044c8140ac3cac42c0ee46afa555.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbfee88ba356c4a60e7ac981c4db0cd2c21dd8dab777bf50ef0a4475c61711f4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"くるみ","creatorId":"vndb:s3489","sourcePersonId":"vndb:s3489","canonicalEntityId":"vndb:s3489","name":"くるみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:30511","source":"vndb"}]},{"characterId":"char_c68558","characterName":"鈴本 恵美","sourceIds":{"bangumi":[{"characterId":"137234","match":"exact-normalized-name-in-linked-work","subjectId":"30215"}],"egsCharacterIds":["25948"],"vndbCharacterId":"c68558"},"originalCharacterName":"鈴本 恵美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"まゆらのペットとして、屋敷に通い続ける少女。"},{"spoiler":false,"text":"依存心が高い気弱な性格で、まゆらに命令されることを至高の喜びとし、彼女に必要とされる人間になろうと努力を欠かさない。"},{"spoiler":false,"text":"また由梨江は彼女にとって尊敬の対象。"}],"source":"egs","sourceCharacterId":"25948","sourceWorkId":"6916","spoiler":false},{"segments":[{"spoiler":false,"text":"い