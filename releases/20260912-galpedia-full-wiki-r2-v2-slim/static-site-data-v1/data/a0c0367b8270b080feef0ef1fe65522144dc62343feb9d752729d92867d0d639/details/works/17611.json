"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"憧れだった騎士になるも、定まった目標や心構えを持たない新米。"},{"spoiler":false,"text":"自国（王国パロン）が大好きで、幼いながらも国の為に戦う。"},{"spoiler":false,"text":"新米といえど精鋭騎士団の一員で、戦闘は鬼才に溢れている。"},{"spoiler":false,"text":"家族は無く、親戚の家で育てられていたが、１５歳になると同時に家を出て、パロンの精鋭騎士を志望した。（死亡した父親が優秀な騎士だった）"}],"source":"egs","sourceCharacterId":"5045","sourceWorkId":"17611","spoiler":false},{"segments":[{"spoiler":false,"text":"憧れだった騎士になるも、目標や心構えを持たない新米。"},{"spoiler":false,"text":"王国パロンが大好きで、幼いながらも国のために戦う。"},{"spoiler":false,"text":"新米といえど精鋭騎士団の一員で、戦闘では鬼才を見せる。"},{"spoiler":false,"text":"拉致された後、あまり抵抗せずレオハルトに友好的に接した。"},{"spoiler":false,"text":"しかしその態度がレオハルトの癇に障り、抵抗せずとも調教されることに。"},{"spoiler":false,"text":"痛みには耐えられても快楽に対する知識が無く、必死に抵抗する。"}],"source":"bangumi","sourceCharacterId":"61722"}],"profileFacts":[{"label":"胸围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"5045","sourceWorkId":"17611","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"5045","sourceWorkId":"17611","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"5045","sourceWorkId":"17611","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2dc0d4159f47a82163e7c9a47d9f793220c9499dbf060b82637a2daac73a3dd9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4fd0bb5561bc3ee6b2d52315a2e990c640a4595bfc1d8ba1d57a9a329910ae2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平松真奈実","creatorId":"vndb:s857","sourcePersonId":"vndb:s857","canonicalEntityId":"vndb:s857","name":"平松 真奈実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confi