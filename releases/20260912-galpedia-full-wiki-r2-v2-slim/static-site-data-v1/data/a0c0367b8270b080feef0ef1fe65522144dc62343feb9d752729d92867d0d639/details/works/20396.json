tId":"108100"}],"egsCharacterIds":["5244"],"vndbCharacterId":"c23320"},"originalCharacterName":"月浦 亜依","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mysterious girl who always plays the piano in the music room after school."}],"source":"vndb","sourceCharacterId":"c23320"},{"segments":[{"spoiler":false,"text":"いつも放課後、音楽室でピアノを弾いているちょっと不思議な女の子。"},{"spoiler":false,"text":"長い黒髪で大人しい性格でそのイメージからか学年No.1美少女との呼び声が高い。"},{"spoiler":false,"text":"だが、人が見ていない所で変な行動を取ったり、なぜか自らを不良と呼んでいる。"}],"source":"egs","sourceCharacterId":"5244","sourceWorkId":"20396","spoiler":false},{"segments":[{"spoiler":false,"text":"总是会在放学后，在音乐室中弹奏着钢琴的"},{"spoiler":false,"text":"有些奇妙的女生。"},{"spoiler":false,"text":"黑色长发的她性格和善"},{"spoiler":false,"text":"也因为给人以这样的印象，“年级No.1美少女”的呼声也很高。"},{"spoiler":false,"text":"然而，在他人观望不见的地方，有时会采取奇怪的行动"},{"spoiler":false,"text":"并且原因不明的，称呼自己为“不良”。"},{"spoiler":false,"text":"——“没错。 我，就是不良”"}],"source":"bangumi","sourceCharacterId":"26406"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fdd3542ae9a750bb0c0d06d1d1caf2dd69a5ca777f66c0611685c318ba5e86b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7404e79a9061d0c16179309a7cda4d28b5bfee88a8dea8e76db74fb75f6c720.webp","width":143,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田恵","creatorId":"vndb:s11","sourcePersonId":"vndb:s11","canonicalEntityId":"vndb:s11","name":"前田 恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:108100:26406:8580:1","source":"bangumi"}]},{"characterId":"char_c23321","characterName":"荻浜 茜","sourceIds":{"bangumi":[{"characterId":"26405","match":"exact-normalized-name-in-linked-work","subjectId":"108100"}],"egsCharacterIds":["5245"],"vndbCharacterId":"c23321"},"originalCharacterName":"荻浜 茜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonists tsundere classmate with a passion for singing."}],"source":"vndb","sourceCharacterId":"c23321"},{"segments":[{"spoiler":false,"text":"主人公と隣の席の女の子。"},{"spoiler":false,"text":"ミーハーでテレビや雑誌が好きな所があり、主人公曰く「The普通女子」"},{"spoiler":false,"text":"意外にも歌手を目指しているらしい。"},{"spoiler":false,"text":"夜の公園で１人歌の練習をしている所を主人公に見られてしまう。"}],"source":"egs","sourceCharacterId":"5245","sourceWorkId":"20396","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公邻座的女生。"},{"spoiler":false,"text":"赶时髦且热爱电视节目以及杂志，"},{"spoiler":false,"text":"是主人公眼中的「The普通女生」"},{"spoiler":false,"text":"就是这样的她，却表里不如一的志愿成为一名歌手。"},{"spoiler":false,"text":"当她在月下的公园里独自练歌的时候，"},{"spoiler":false,"text":"让路过的主人公“逮了个正着”。"},{"spoiler":false,"text":"今天发生的事情"},{"spoiler":false,"text":"——“只有天知地知你知我知。 晓得吗？”"}],"source":"bangumi","sourceCharacterId":"26405"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e92e75a281ea0fa1e757affd93f98285ed163e30a39cfd8a52dbcde7d2c5cfe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/145d69533016267c1936a6d90bda0a5a96f536408148a3b33b5c8aa092a48110.webp","width":143,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:108100:26405:15637:1","source":"bangumi"}]},{"characterId":"char_c23322","characterName":"水押 カナ","sourceIds":{"bangumi":[{"characterId":"26419","match":"exact-normalized-name-in-linked-work","subjectId":"108100"}],"egsCharacterIds":["5246"],"vndbCharacterId":"c23322"},"originalCharacterName":"水押 カナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A childhood friend who lives next to the protagonist's house. Since the parents are absent for some business, she sometimes comes to the protagonist to cook him food."}],"source":"vndb","sourceCharacterId":"c23322"},{"segments":[{"spoiler":false,"text":"主人公の隣に住む幼馴染の女の子。"},{"spoiler":false,"text":"両親が単身赴任で不在の主人公の家に時々料理を作りに来てくれる。"},{"spoiler":false,"text":"料理研究会に入っており、料理の腕はピカイチ！"},{"spoiler":false,"text":"少しおっちょこちょいなのが玉に瑕。"}],"source":"egs","sourceCharacterId":"5246","sourceWorkId":"20396","spoiler":false},{"segments":[{"spoiler":false,"text":"家住主人公隔壁的“发小”女生。"},{"spoiler":false,"text":"对于父母双双长期出差了的主人公，"},{"spoiler":false,"text":"时不时地便会去到他的家里为其做饭。"},{"spoiler":false,"text":"加入了料理研究会的她，厨艺如同身高一样“高人一等”！"},{"spoiler":false,"text":"白璧微瑕的是，这个人有那么丁点儿的“马大哈”。"},{"spoiler":false,"text":"——“好希望大家能够和和美美地，坐下来吃顿饭呀！”"}],"source":"bangumi","sourceCharacterId":"26419"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e19a0a3ef51a4af4ef4cc9ecd360002cc46d4e865a6ee1551b09170fc5093fb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fc5c868f83f318f8137a88a24ebe1f41062191fa07ca47672808772005f19a9.webp","width":143,"height":256,"source":"static-detail"},"actors":[{"creditedName":"貴坂理緒","creatorId":"vndb:s946","sourcePersonId":"vndb:s946","canonicalEntityId":"vndb:s946","name":"貴坂 理緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:108100:26419:15550:1","source":"bangumi"}]},{"characterId":"char_c23323","characterName":"蛇田 汐里","sourceIds":{"bangumi":[{"characterId":"26420","match":"exact-normalized-name-in-linked-work","subjectId":"108100"}],"egsCharacterIds":["5247"],"vndbCharacterId":"c23323"},"originalCharacterName":"蛇田 汐里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A quiet girl and the protagonist's classmate. She always acts alone, and everyone in the class doesn't know her well. And she herself refuses to make friends."}],"source":"vndb","sourceCharacterId":"c23323"},{"segments":[{"spoiler":false,"text":"主人公と同じクラスのちょっと無口な女の子。"},{"spoiler":false,"text":"いつも１人で行動しており、クラスのみんなも彼女の素性をよく知らない。"},{"spoiler":false,"text":"そして彼女自身も周りと仲良くする事を拒んでいる。"},{"spoiler":false,"text":"どういう訳か幽霊を探しているようだ。"}],"source":"egs","sourceCharacterId":"5247","sourceWorkId":"20396","spoiler":false},{"segments":[{"spoiler":false,"text":"与主人公同班且“寡言少语”的女生。"},{"spoiler":false,"text":"平日独来独往的她，就连班里的同学们"},{"spoiler":false,"text":"都鲜少了解她的本来面貌。"},{"spoiler":false,"text":"并且她自己本身，也在拒绝着周围人们表示的友好。"},{"spoiler":false,"text":"虽不知是何种目的，但她似乎正在寻找着幽灵。"},{"spoiler":false,"text":"——“……你看起来，并不是幽灵呢”"}],"source":"bangumi","sourceCharacterId":"26420"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77a43d4ac1cf0102188f6e1e02f9330e42cbd9ee807ccb414bff1435edb864b3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bd4d8cae7adf86be5466d8ea7a01f8757015c3574125095bc596c96617f9fd6.webp","width":143,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:108100:26