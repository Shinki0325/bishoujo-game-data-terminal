ersonId":"vndb:s46660","canonicalEntityId":"vndb:s46660","name":"鶏野郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:184840","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c108877","characterName":"ミオ","sourceIds":{"vndbCharacterId":"c108877"},"originalCharacterName":"ミオ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"......Let's live a little bit longer.\""},{"spoiler":false,"text":"A girl was living an ordinary life in the city, until a global pandemic forced her to be alone."},{"spoiler":false,"text":"She couldn't live in a city full of dead bodies."},{"spoiler":false,"text":"\"If I'm going to die anyway, then I'm going to die in a beautiful place.\""},{"spoiler":false,"text":"But she was too directionally confused to go to the sea, and ended up in Yuuji's village, which is in the opposite direction from the sea."},{"spoiler":false,"text":"After several days of walking, she ran out of energy and was too tired to move. Yuuji took her in and she came to live with him."},{"spoiler":false,"text":"At first, she was a bit shy and cautious of Yuuji, as she had never been with an older man before."},{"spoiler":false,"text":"But once she realized that Yuuji is a good person, she gradually opened up to him."},{"spoiler":false,"text":"Translated and edited from Melonbooks"}],"source":"vndb","sourceCharacterId":"c108877"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b1e9b325a3b6351d6a4dc417ede130355b0c57433d19f1585ba58650b5e6fb3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e931502fda331512c51f16cd1cf5127d34f502cde104f7c9a0c73c07426dca8.webp","width":218,"height":256,"source