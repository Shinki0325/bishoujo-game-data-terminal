taff:49653","source":"vndb"}]},"cast":[{"characterId":"char_c9966","characterName":"メルJ・ヴァネット","sourceIds":{"bangumi":[{"characterId":"73279","match":"exact-normalized-name-in-linked-work","subjectId":"397069"}],"egsCharacterIds":["24328"],"vndbCharacterId":"c9966"},"originalCharacterName":"メルJ・ヴァネット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"98"},"height":{"reviewState":"no-conflict","source":"vndb","value":"180"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"64"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本名はメシェイル・イ・ハーン。"},{"spoiler":false,"text":"イギリス出身の女性で、かつては単独でキョムと戦っていた。"},{"spoiler":false,"text":"過去、生命の危機に瀕したとき、キョムに肉体改造を施されており、高い身体能力と常人の数十倍の回復力を持っている。"},{"spoiler":false,"text":"かつては、自分以外は全て敵、あるいは道具と見なす一面があったが、現在は考え方を改めて他者を思いやれるようになっている。"}],"source":"egs","sourceCharacterId":"24328","sourceWorkId":"33133","spoiler":false},{"segments":[{"spoiler":false,"text":"生真面目で自他ともに厳しいイギリス人女性。通称メルＪ。"},{"spoiler":false,"text":"やや警戒心が強く、仲間に対してあれこれ世話を焼く半面、"},{"spoiler":false,"text":"初対面の人間はなかなか信用しない。"},{"spoiler":false,"text":"本名で呼ぶことを許すのも、身内と認定した相手のみ。"}],"source":"bangumi","sourceCharacterId":"73279"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c74cb779e38be5dc80ea5f4f0a55974e3d375a8064c57d273586c5af73943f8b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65a152e8e74d95dd831b1bf8e2c8a2f7416b6888acfc745bd689b41c3d625a34.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹間千ノ美","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:6366:73279:19333:1","source":"bangumi"}]},{"characterId":"char_c9968","characterName":"小河原 両兵","sourceIds":{"bangumi":[{"characterId":"73277","match":"exact-normalized-name-in-linked-work","subjectId":"397069"}],"egsCharacterIds":["24329"],"vndbCharacterId":"c9968"},"originalCharacterName":"小河原 両兵","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"4月4日"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"キョムに対抗する組織・アンヘルのリーダー的存在。"},{"spoiler":false,"text":"人機の操縦にも長けているが、本人も剣士として高い腕前を持っている。"},{"spoiler":false,"text":"これまでに数々の修羅場を潜ったが、ゴキブリ並みの生命力で生き残ってきた。"},{"spoiler":false,"text":"キョムの総攻撃中に碧と出会い、彼女を戦火に導いていくこととなる。"}],"source":"egs","sourceCharacterId":"24329","sourceWorkId":"33133","spoiler":false},{"segments":[{"spoiler":false,"text":"記憶喪失の主人公。"},{"spoiler":false,"text":"生活に最低限必要な言葉、知識以外をすべて失っている。"},{"spoiler":false,"text":"赤緒や青葉たちとともに人機に乗っていたらしいのだが、"},{"spoiler":false,"text":"全く心当たりはない。"},{"spoiler":false,"text":"短気で割といい加減な性格。"},{"spoiler":false,"text":"中身は記憶を失う前とほとんど変わっていないらしい。"}],"source":"bangumi","sourceCharacterId":"73277"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82db1c409735f7f81e1777858513b05027d521800e325e1bccf8008a732d7276.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/2348671c0dbd4384460d457988fc0d55df98050e8486fb0d88c78254c7555165.webp","width":256,"height":210,"source":"static-detail"},"actors":[{"creditedName":"一条和矢","creatorId":"vndb:s256","sourcePersonId":"vndb:s256","canonicalEntityId":"vndb:s256","name":"一条 和矢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:chara