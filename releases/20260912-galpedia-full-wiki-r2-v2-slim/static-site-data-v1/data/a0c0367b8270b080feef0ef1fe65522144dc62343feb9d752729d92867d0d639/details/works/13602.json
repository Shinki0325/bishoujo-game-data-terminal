{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"13602","model":{"presentationWorkId":"vndb:v3491","staff":{"artwork":[{"creditedName":"あづみ一樹","creatorId":"vndb:s3377","sourcePersonId":"egs:creator:14522","canonicalEntityId":"vndb:s3377","name":"あづみ一樹","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:84236","source":"egs"}],"scenario":[{"creditedName":"苑脇つぐみ","creatorId":"vndb:s3403","sourcePersonId":"egs:creator:2236","canonicalEntityId":"vndb:s3403","name":"苑脇つぐみ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:84237","source":"egs"}],"music":[{"creditedName":"音姫project","creatorId":"vndb:s4046","sourcePersonId":"egs:creator:16959","canonicalEntityId":"vndb:s4046","name":"音姫project","detail":"音響制作","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:105634","source":"egs"}],"other":[{"creditedName":"高向慎也","creatorId":"vndb:s6797","sourcePersonId":"egs:creator:16960","canonicalEntityId":"vndb:s6797","name":"高向慎也","detail":"プロデューサー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:105635","source":"egs"},{"creditedName":"高向 慎也","creatorId":"vndb:s6797","sourcePersonId":"vndb:s6797","canonicalEntityId":"vndb:s6797","name":"高向 慎也","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:43447","source":"vndb"}]},"cast":[{"characterId":"char_c31178","characterName":"アニエス・ド・ジュノー","sourceIds":{"bangumi":[{"characterId":"58987","match":"exact-normalized-name-in-linked-work","subjectId":"224927"}],"egsCharacterIds":["12671"],"vndbCharacterId":"c31178"},"originalCharacterName":"アニエス・ド・ジュノー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本編ヒロイン。"},{"spoiler":false,"text":"古さと格式を持つ名門貴族であるジュノー家の令嬢。"},{"spoiler":false,"text":"しかし、家が領地経営に失敗し、多額の借金を抱えることになったジュノー家は、成金商社の主人公の父親の融資して貰う条件として、娘である彼女を主人公の妻として差し出した。"},{"spoiler":false,"text":"彼女自身は、自分一人の犠牲で済むならばと、今回の縁談について前向きに考えている。"},{"spoiler":false,"text":"目鼻立ちが整った美人で、やや澄ました感じが初対面の相手にキツイ印象を与えてしまう。"},{"spoiler":false,"text":"グラマラスなプロポーションをしているが、自身は太っていると思っているらしく、体型のことを触れられることを嫌う。"}],"source":"egs","sourceCharacterId":"12671","sourceWorkId":"13602","spoiler":false},{"segments":[{"spoiler":false,"text":"父親の借金のかたに、主人公の許婚として屋敷に連れてこられた本作のヒロイン。"},{"spoiler":false,"text":"本人も実家の経済状況を知っているので、自分ひとりの犠牲で融資が受けられるのであれば犠牲になっても……という覚悟がある。"},{"spoiler":false,"text":"身体つきは同年代の女性と比べるとかなりグラマラスだが、本人は太っていると思っている節があり、プロポーションのことを言われると急に不機嫌になる。"},{"spoiler":false,"text":"また、普段は大人しく目鼻立ちの整った顔つきのため実年齢よりも年上に見られ、初対面の相手に少しキツイ印象を与えてしまうことが本人の悩み。"}],"source":"bangumi","sourceCharacterId":"58987"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"12671","sourceWorkId":"13602","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"12671","sourceWorkId":"13602","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"12671","sourceWorkId":"13602","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"12671","sourceWorkId":"13602","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e26bca458a21cf37e21944e2e26ea24d2d58ea0920dc1b58adc54dcd4f0e9af.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af9e52896f7c79797f3d4d15a1c539669edcf3cca5ab8bbc3a6c2394e4fc2f6e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南月悠奈","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224927:58987:6349:1","source":"bangumi"}]},{"characterId":"char_c31179","characterName":"エルザ・バリエール","sourceIds":{"bangumi":[{"characterId":"58988","match":"exact-normalized-name-in-linked-work","subjectId":"224927"}],"egsCharacterIds":["12672"],"vndbCharacterId":"c31179"},"originalCharacterName":"エルザ・バリエール","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の腹違いの妹でこちらは本妻の娘。"},{"spoiler":false,"text":"商売に対して、まったく興味がなく、有り余る金を使って遊び呆けている。"},{"spoiler":false,"text":"父親自身も彼女を見放し、金だけを与えていっさい関わろうとしない。"},{"spoiler":false,"text":"可愛らしい世間知らずのお嬢様といった印象を受けるが、実はそうした表向きの顔は演技でしかなく、本性は腹黒い父親の血を色濃く受け継いで、残忍で酷薄。"},{"spoiler":false,"text":"アニエスへの蛮行に彼女が加担することになって、さらに性質が悪くなっていく。"}],"source":"egs","sourceCharacterId":"12672","sourceWorkId":"13602","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の腹違いの妹で、こちらは本妻の娘。"},{"spoiler":false,"text":"父親・兄と違って商売をする気はまったく無く、あり余る金を消費し遊び惚けている。"},{"spoiler":false,"text":"そんな彼女を父親は見放しており、小遣いを与えるだけで世話を使用人に任せ、ほとんど関わろうとしない。"},{"spoiler":false,"text":"しかし普段の彼女の姿は演技であり、本来は父親の暗黒面を色濃く受け継いだ残忍で冷酷な性格の持ち主。だが見た目は可愛らしい世間知らずのお嬢様なので、そこそこ社交界では人気がある。"},{"spoiler":false,"text":"今回の婚姻騒動では、面白いからといって主人公に加担することに。"},{"spoiler":false,"text":"しかもどこから仕入れてきたのか、淫具や怪しげな薬などを主人公に与えたりと、かなり性質の悪い関わりを持ってくる。"}],"source":"bangumi","sourceCharacterId":"58988"}],"profileFacts":[{"label":"胸围（本版本）","value":"72 cm","valueContext":null,"source":"egs","sourceCharacterId":"12672","sourceWorkId":"13602","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"145 cm","valueContext":null,"source":"egs","sourceCharacterId":"12672","sourceWorkId":"13602","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"12672","sourceWorkId":"13602","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"12672","sourceWorkId":"13602","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/ddfc5fc47411dfed1fc41cc2167c9114f3b2eb2915e505ec690f57afa07fd2d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3da70ef86ea86db09445dc449257d0f0f3a3b8743fb78044fa0abc2b5c4bb015.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224927:58988:5890:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:354","sourceCompanyId":"egs:brand:354","canonicalEntityId":"egs:brand:354","name":"RED-ZONE","roleCodes":["brand"],"identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-brand:13602:354","source":"egs"},{"companyId":"vndb:p5679","sourceCompanyId":"vndb:p5679","canonicalEntityId":"vndb:p5679","name":"ホビコレ","roleCodes