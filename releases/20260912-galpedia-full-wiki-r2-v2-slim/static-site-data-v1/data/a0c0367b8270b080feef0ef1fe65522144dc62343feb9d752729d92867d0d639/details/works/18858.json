{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"18858","model":{"presentationWorkId":"vndb:v12498","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c63083","characterName":"槙野 なつき","sourceIds":{"bangumi":[{"characterId":"30980","match":"exact-normalized-name-in-linked-work","subjectId":"128057"},{"characterId":"30980","match":"exact-normalized-name-in-linked-work","subjectId":"222174"}],"egsCharacterIds":["152"],"vndbCharacterId":"c63083"},"originalCharacterName":"槙野 なつき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"自分だけが利口と思っており、他人を平気で利用する。"},{"spoiler":false,"text":"遊ぶ金ほしさに、不良仲間に女学生を売りつけ稼いでいる。"},{"spoiler":false,"text":"――精液臭狂い"},{"spoiler":false,"text":"精液の匂いに興奮を覚える。"},{"spoiler":false,"text":"体中に精液がかかっても喜ぶほどの精液好き。"}],"source":"egs","sourceCharacterId":"152","sourceWorkId":"7742","spoiler":false},{"segments":[{"spoiler":false,"text":"『精液狂』のヒロイン。"},{"spoiler":false,"text":"売春をあっ旋している、女学生。"},{"spoiler":false,"text":"男たちに犯された少女たちの事後処理をしているうちに、精液の匂いに性的な興奮を覚えるようになってしまった。"}],"source":"egs","sourceCharacterId":"152","sourceWorkId":"9802","spoiler":false},{"segments":[{"spoiler":false,"text":"【学生/ヒロイン】"},{"spoiler":false,"text":"素行不良の問題学生。"},{"spoiler":false,"text":"誰に対しても物怖じせずに話せるが、すぐにけんか腰になる。"},{"spoiler":false,"text":"以前までは多大な影響を与えるほど裏の世界に通じていた。"},{"spoiler":false,"text":"だが、今は過去の話で足は洗っている。"},{"spoiler":false,"text":"それでも知人や顔見知りは多く、影響力は少なからずある。"},{"spoiler":false,"text":"感覚がシビアなところがあり、怒りの沸点が低い。"},{"spoiler":false,"text":"世の中を斜めに見ているような、すれた感じがある。"},{"spoiler":false,"text":"意外に友達思いの一面がある。"}],"source":"egs","sourceCharacterId":"152","sourceWorkId":"18858","spoiler":false},{"segments":[{"spoiler":false,"text":"不良。他人を利用しても平気で、自分だけが利口だと思っている。 男に金を貢いでおり、男の前では、大人しい。借金はないが貢ぐ金がいるので、男の不良仲間に学生を斡旋し、輪姦させて、金をもうけている。"},{"spoiler":false,"text":"精液の匂いに興奮する、精液好き。"}],"source":"bangumi","sourceCharacterId":"30980"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e551e00853734d234254f659c1189cffc9ade70ead1c699baa28c4aa88557236.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd4b3a20e7b71146b0f2c143d46bfb859f44d36eaa1eaf41bfa55a85b9f60692.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ゆいのあわゆき","creatorId":"vndb:s15996","sourcePersonId":"vndb:s15996","canonicalEntityId":"vndb:s15996","name":"ゆいのあわゆき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:52976","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p826","sourceCompanyId":"egs:brand:1885","canonicalEntityId":"vndb:p826","name":"Eroro","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:18858:1885","source":"egs"},{"companyId":"vndb:p826","sourceCompanyId":"vndb:p826","canonicalEntityId":"vndb:p826","name":"Eroro","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:156084:v12498","source":"vndb"},{"companyId":"vndb:p826","sourceCompanyId":"vndb:p826","canonicalEntityId":"vndb:p826","name":"Eroro","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:31010:v12498","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full