:s13632","name":"メンタンピン良いコッコ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:136786","source":"vndb"},{"creditedName":"イケちゃん","creatorId":"vndb:s13633","sourcePersonId":"vndb:s13633","canonicalEntityId":"vndb:s13633","name":"イケちゃん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:136787","source":"vndb"}]},"cast":[{"characterId":"char_c55643","characterName":"高宮 遙花","sourceIds":{"bangumi":[{"characterId":"50029","match":"exact-normalized-name-in-linked-work","subjectId":"202547"}],"egsCharacterIds":["13132"],"vndbCharacterId":"c55643"},"originalCharacterName":"高宮 遙花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: Holidays, sweets"},{"spoiler":false,"text":"Dislikes: Indecisive people"}],"source":"vndb","sourceCharacterId":"c55643"},{"segments":[{"spoiler":false,"text":"他界した両親から会社を引き継ぎ、ＩＴ業界で成功を収めている学生社長。何でもこなせるスーパーウーマン。学院きっての有名人で、生徒にも教師にも一目置かれているが、反面近寄りがたい存在でもあり、周囲との間に壁がある。"},{"spoiler":false,"text":"強気で自信家だが、恋愛ごとには疎く、ストレートに「カワイイ」とか言われたりすると異常に照れるツンデレなところも。物事を完璧にこなせる自分に誇りを持っている反面、心のどこかで常に孤独と重圧を感じている。"}],"source":"egs","sourceCharacterId":"13132","sourceWorkId":"24653","spoiler":false},{"segments":[{"spoiler":false,"text":"他界した両親より引き継いだ会社でIT業界へ進出し、成功を収めている学生社長。"},{"spoiler":false,"text":"会社の業績は目覚しく、マスコミからも注目を浴びている。"},{"spoiler":false,"text":"他人にも厳しいため、学院内では浮いた存在として自信家な面と冷静さが際立つが、"},{"spoiler":false,"text":"心のどこかで孤独と重圧を感じている。"},{"spoiler":false,"text":"性格は強気で、S系のツンデレ。 大胆不敵な超合理主義。"},{"spoiler":false,"text":"行動力があり、何でもこなせるスーパーウーマン。"},{"spoiler":false,"text":"人付き合いには興味がなく、自社の成長のために手段を選ばない。"},{"spoiler":false,"text":"一方で恋愛には疎く、かわいいと言われたり、積極的にされると異常に照れてしまう。"}],"source":"bangumi","sourceCharacterId":"50029"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"50029","value":"休み、甘味"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"50029","value":"優柔不断な人間、最近は淫魔による発情"},{"label":"所属","source":"bangumi","sourceCharacterId":"50029","value":"天王寺学院 2年、生徒会"},{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"13132","sourceWorkId":"24653","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"13132","sourceWorkId":"24653","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"13132","sourceWorkId":"24653","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"13132","sourceWorkId":"24653","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42ba2d3252d6393cfa30dd241abe01289c95d055237866becc02101e4b1a4b57.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0270fd6a9a078a7cfbcbee65ac8575f7c08218cb657a8f447583d6a707c2eeb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朝比奈幸","creatorId":"vndb:s21648","sourcePersonId":"vndb:s21648","canonicalEntityId":"vndb:s21648","name":"朝比奈 幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:202547:50029:17080:1","source":"bangumi"},{"creditedName":"綾音 まこ","creatorId":"vndb:s2581","sourcePersonId":"vndb:s2581","canonicalEntityId":"vndb:s2581","name":"綾音 まこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:72075","source":"vndb"}]},{"characterId":"char_c55644","characterName":"皇后崎 瑠璃","sourceIds":{"bangumi":[{"characterId":"50030","match":"exact-normalized-name-in-linked-work","subjectId":"202547"}],"egsCharacterIds":["13133"],"vndbCharacterId":"c55644"},"originalCharacterName":"皇后崎 瑠璃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"151"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"図書委員を勤める寡黙な少女。ミステリアスな雰囲気も相まって、クラスメイトからはやや距離を置かれている。本の虫で、片時も本を手放さない。父親は学院の理事長なのだが、余りそのことには触れられたくない様子。"},{"spoiler":false,"text":"無表情・無感情だが、好奇心と知識欲は人一倍旺盛で、その対象はオールジャンル。積極的に参加はしないものの、下世話な話題にも本を読むフリをしながら聞き耳を立てていたりする。物事に理解が早く、とても飲み込みが良い。"}],"source":"egs","sourceCharacterId":"13133","sourceWorkId":"24653","spoiler":false},{"segments":[{"spoiler":false,"text":"美少女だが地味でおとなしいため、あまり印象に残らない女の子。"},{"spoiler":false,"text":"寡黙でミステリアスな存在としてクラスメイトからも距離を置かれている。"},{"spoiler":false,"text":"実は学園創設者・天王寺金盛の娘だが、家の命令で隠し母親の旧姓を名乗っている。"},{"spoiler":false,"text":"無口キャラで無表情・無感情。"},{"spoiler":false,"text":"父親の命令に従うのが当然という教育を受け、本人もそれに疑問を持っていない。"},{"spoiler":false,"text":"趣味は、幼い頃から許された唯一の娯楽である読書。"},{"spoiler":false,"text":"おかげで夜更かしが習慣になっていて、眠そうにしていることが多い。"},{"spoiler":false,"text":"実は器用で理解力に優れ、挑戦すれば何でもできてしまう。"}],"source":"bangumi","sourceCharacterId":"50030"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"50030","value":"読書、本、学院の図書室"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"50030","value":"喧騒"},{"label":"所属","source":"bangumi","sourceCharacterId":"50030","value":"天王寺学院 1年、図書委員、生徒会 書記"},{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"13133","sourceWorkId":"24653","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"151 cm","valueContext":null,"source":"egs","sourceCharacterId":"13133","sourceWorkId":"24653","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"13133","sourceWorkId":"24653","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"13133","sourceWorkId":"24653","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02263bfa847494b9b5124ca4eff86d845953feb999d91e7f9c51aa3f0d160190.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/887bec7c43ee4409d6ceb3b4b899255b568b9847f7952d318d47a9d730182780.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原舞","creatorId":"vndb:s985","sourcePersonId":"vndb:s985","canonicalEntityId":"vndb:s985","name":"石原 舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:202547:50030:13372:1","source":"bangumi"}]},{"characterId":"char_c55645","characterName":"藤堂 葵","sourceIds":{"bangumi":[{"characterId":"50031","match":"exact-normalized-name-in-linked-work","subjectId":"202547"}],"egsCharacterIds":["13134"],"vndbCharacterId":"c55645"},"originalCharacterName":"藤堂 葵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"169"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Likes: All kinds of martial arts, sweets"},{"spoiler":false,"text":"Dislikes: All kinds of sexual topics"}],"source":"vndb","sourceCharacterId":"c55645"},{"segments":[{"spoiler":false,"text":"平安時代から続く貴族の家系で、お嬢様の多い学院でも群を抜いた名家の出身だが、それを鼻に掛けない人格者。風紀委員にして、全国クラスの剣道の腕前を持ち、学業も優秀と、全女生徒から憧れのまなざしを受ける存在。"},{"spoiler":false,"text":"真面目で努力家。女性的な魅力に欠けていると自己評価しており、それがコンプレックス。意外にカワイイモノや甘いモノが大好きなのだが、似合わないと思われるのが嫌で隠している。性的には潔癖でウブだが恋愛への憧れは強い。"}],"source":"egs","sourceCharacterId":"13134","sourceWorkId":"24653","spoiler":false},{"segments":[{"spoiler":false,"text":"通称：鋼鉄の貞操観念を持つ風紀委員長　 所属：天王寺学院 3年、風紀委員、生徒会"},{"spoiler":false,"text":"好き：武道全般、スイーツ　　嫌い：不順異性交遊、性的な話題"},{"spoiler":false,"text":"誇り高く、多くの女性ファンを抱えるカッコいい女性。"},{"spoiler":false,"text":"平安時代から続く貴族の家系で、学院内でも家の位は最も高い。"},{"spoiler":false,"text":"また剣道の有段者であり、全国クラスの実力者。 学力も優秀。"},{"spoiler":false,"text":"まじめな努力家で、性格は素直クール。"},{"spoiler":false,"text":"謙虚で自分に厳しく、自分には女性的な魅力があまりないと思っている。"},{"spoiler":false,"text":"さらに、かわいいもの や 甘いもの が好きという乙女な面を持つが、"},{"spoiler":false,"text":"それが似合わないと思い込んでしまっている。"}],"source":"bangumi","sourceCharacterId":"50031"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"50031","value":"武道全般、スイーツ"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"50031","value":"不順異性交遊、性的な話題"},{"label":"所属","source":"bangumi","sourceCharacterId":"50031","value":"天王寺学院"},{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"13134","sourceWorkId":"24653","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"169 cm","valueContext":null,"source":"egs","sourceCharacterId":"13134","sourceWorkId":"24653","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"13134","sourceWorkId":"24653","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"13134","sourceWorkId":"24653","sourceField":null,"scoped":true}],"metadataCandi