,"spoiler":false},{"segments":[{"spoiler":false,"text":"通称：弟大好きのスーパー生徒会長　　所属：天王寺学院 3年、生徒会 会長"},{"spoiler":false,"text":"好き：弟（主人公）、流行のファッション　　嫌い：特になし"},{"spoiler":false,"text":"生徒会長を務める才色兼備な女性。"},{"spoiler":false,"text":"天王寺学院がメディアに露出する際は広報役としてインタビューに答えたり、"},{"spoiler":false,"text":"ポスターのモデルになったりなど、学院の顔としても活躍している。。"},{"spoiler":false,"text":"なお主人公とは幼い頃から家族ぐるみで仲が良く、姉を自認して溺愛している。"},{"spoiler":false,"text":"性格は優しく敵を作らず、全学生が憧れる存在。"},{"spoiler":false,"text":"教師からの信頼も厚く、生徒会長の激務をテキパキこなしている。"},{"spoiler":false,"text":"また柔軟な考え方で規則に縛られることなく、淫魔事件に乗じて主人公と……"}],"source":"bangumi","sourceCharacterId":"50032"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"50032","value":"弟（主人公）、流行のファッション"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"50032","value":"特になし"},{"label":"所属","source":"bangumi","sourceCharacterId":"50032","value":"天王寺学院"},{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"13135","sourceWorkId":"24653","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"166 cm","valueContext":null,"source":"egs","sourceCharacterId":"13135","sourceWorkId":"24653","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"13135","sourceWorkId":"24653","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"13135","sourceWorkId":"24653","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d38f235cbb22748cd0f395a2b187a65cde933b8269fe8151f603d10219718575.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/1458de749d355a24119c2dec75f850c330fe30850a6cdb5f0df53beed28a21aa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vn