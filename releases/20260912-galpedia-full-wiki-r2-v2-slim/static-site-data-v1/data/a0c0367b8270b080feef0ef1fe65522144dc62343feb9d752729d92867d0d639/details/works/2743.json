tatus":"auto-confirmed","relationId":"egs:work-creator:3829","source":"egs"}],"music":[{"creditedName":"PaPa's Pleasure","creatorId":"vndb:s8588","sourcePersonId":"vndb:s8588","canonicalEntityId":"vndb:s8588","name":"PaPa's Pleasure","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:31658","source":"vndb"}],"other":[{"creditedName":"PaPa's Pleasure","creatorId":"vndb:s8588","sourcePersonId":"vndb:s8588","canonicalEntityId":"vndb:s8588","name":"PaPa's Pleasure","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:31659","source":"vndb"}]},"cast":[{"characterId":"char_c9148","characterName":"茅野 ヒカリ","sourceIds":{"bangumi":[{"characterId":"93224","match":"exact-normalized-name-in-linked-work","subjectId":"131223"}],"egsCharacterIds":["27722"],"vndbCharacterId":"c9148"},"originalCharacterName":"茅野 ヒカリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の義妹で、ヒナコは双子の妹。"},{"spoiler":false,"text":"過去の忌まわしい火災事件以来、主人公とは打ち解けずにおり、自分のせいで主人公が傷を負ったと負い目を感じているようだ。"},{"spoiler":false,"text":"本当は、主人公と打ち解け、普通に接したいと思っているが、どうして良いか解らず、素っ気無い態度になってしまう。"}],"source":"egs","sourceCharacterId":"27722","sourceWorkId":"2151","spoiler":false},{"segments":[{"spoiler":false,"text":"サリウの義妹でヒナコは双子の妹。"},{"spoiler":false,"text":"血の繋がりのない兄とは、火災事件以来うち解けられずにいる。その心の内には、どう言葉を交わしたらいいのか、どう謝ったらいいのか分からないと言った感情がある。兄が自分のせいで傷を受けたという負い目が年月を追い、歪んだ形となってしまっているのか…。それは当人以外わからない。"}],"source":"bangumi","sourceCharacterId":"93224"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a4ca59295bff1ec7823eb79f4323eee3aeede3959de6746d9d1f79bffe3fc36.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69ac672354602ada378d543013da48f5434d7ae52376611546c32e795593a40d.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"星野千寿子","creatorId":"vndb:s128","sourcePersonId":"vndb:s128","canonicalEntityId":"vndb:s128","name":"星野 千寿子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:131223:93224:4210:1","source":"bangumi"}]},{"characterId":"char_c9150","characterName":"茅野 ヒナコ","sourceIds":{"bangumi":[{"characterId":"93225","match":"exact-normalized-name-in-linked-work","subjectId":"131223"}],"egsCharacterIds":["27723"],"vndbCharacterId":"c9150"},"originalCharacterName":"茅野 ヒナコ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の義妹で、ヒカリの双子の姉。"},{"spoiler":false,"text":"分け隔てのない優しさを持ち、人を疑うことを知らない純朴な女の子。"},{"spoiler":false,"text":"いつも笑顔を絶やさず、過去の忌まわしい火災事故によって暗くなりがちだった茅野家を、その笑顔で支えてきた。"}],"source":"egs","sourceCharacterId":"27723","sourceWorkId":"2151","spoiler":false},{"segments":[{"spoiler":false,"text":"サリウの妹で、ヒカリの双子の姉。無償の愛の持ち主。"},{"spoiler":false,"text":"父と死別した火災事件の後、日陰の生活を送ることになった３人だったが笑顔を絶やすことのなかった彼女おかげで、サリウもヒカリも随分と救われている。分け隔てのないやさしさを持つ娘で、人を疑う事をあまり知らない。拒食症だったサリウの健康を、今も気にしている。"}],"source":"bangumi","sourceCharacterId":"93225"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d6161559da37b76ce34e57e26343fa0892f386e4721d2d156eff10740186d72.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e873b25b97a0a04f0e273e873c943d594f72d46be6d5af6d4468afab2353fa8.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor"