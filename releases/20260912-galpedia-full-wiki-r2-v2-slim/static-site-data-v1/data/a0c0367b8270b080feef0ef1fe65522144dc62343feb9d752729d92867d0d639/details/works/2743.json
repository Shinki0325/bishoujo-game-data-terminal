":false,"text":"主人公と同じ監査官であり、施設の同僚にあたる。"},{"spoiler":false,"text":"普段は、陽気で楽天的だが、時々別人のような声で語る。行動や言動に謎が多いのにも、何か理由があるのかもしれない。"}],"source":"bangumi","sourceCharacterId":"93227"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/551b1657f6ebdec5400ba0236ff3d3df6b84779d2f77fe13eacf59f57f1e7edd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c07e49824e0c8533f00042e54b6d1fe4ca1b9242b8726c601b1bfec9ad5f43e.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松田美菜","creatorId":"vndb:s1118","sourcePersonId":"vndb:s1118","canonicalEntityId":"vndb:s1118","name":"松田 美菜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:131223:93227:67452:1","source":"bangumi"}]},{"characterId":"char_c9154","characterName":"大友　小鳥","sourceIds":{"bangumi":[{"characterId":"93230","match":"exact-normalized-name-in-linked-work","subjectId":"131223"}],"egsCharacterIds":["27726"],"vndbCharacterId":"c9154"},"originalCharacterName":"大友　小鳥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が担当するオフェンサー。"},{"spoiler":false,"text":"主人公が監査官として働き出した時期を同じくして彼女も入所してきた。"},{"spoiler":false,"text":"男性恐怖症。"}],"source":"egs","sourceCharacterId":"27726","sourceWorkId":"2151","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が監査官として施設に来た時と時期を同じくして入所したオフェンサー。担当オフェンサーで、男性恐怖症の娘である。"}],"source":"bangumi","sourceCharacterId":"93230"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/780907aeeccc5c4122f553d2c01746c5e4b2ba81e143792a60845e9bc79a63bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/term