edName":"某","creatorId":"vndb:s10281","sourcePersonId":"vndb:s10281","canonicalEntityId":"vndb:s10281","name":"某","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:99586","source":"vndb"},{"creditedName":"某","creatorId":"vndb:s10281","sourcePersonId":"vndb:s10281","canonicalEntityId":"vndb:s10281","name":"某","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:99587","source":"vndb"},{"creditedName":"うきひと","creatorId":"vndb:s31207","sourcePersonId":"vndb:s31207","canonicalEntityId":"vndb:s31207","name":"うきひと","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:99588","source":"vndb"}]},"cast":[{"characterId":"char_c24385","characterName":"村沢 伊月","sourceIds":{"bangumi":[{"characterId":"90049","match":"exact-normalized-name-in-linked-work","subjectId":"132898"},{"characterId":"90049","match":"exact-normalized-name-in-linked-work","subjectId":"79488"}],"egsCharacterIds":["1519"],"vndbCharacterId":"c24385"},"originalCharacterName":"村沢 伊月","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Her parents died in a car accident, and she was raised by her grandparents. Not wanting her to cause any trouble, her grandparents enrolles her in an all-girls boarding school."},{"spoiler":false,"text":"Her mind has trouble processing the trauma of losing her parents-- Itsuki, formerly an ordinary girl, has shut off her heart completely and tries her best to avoid any sort of relationship with others. In her new school, she always spends her time alone and doesn't make any friends, and her classmates don't seem to want to have much to do with her either."},{"spoiler":false,"text":"Her hobby is reading, and her grades are a little bit above average."}],"source":"vndb","sourceCharacterId":"c24385"},{"segments":[{"spoiler":false,"text":"交通事故で両親を亡くし、祖父母に引き取られるが、迷惑が掛かるのを嫌い全寮制の女子校に転入し一人で生きていく事を決める。"}],"source":"egs","sourceCharacterId":"1519","sourceWorkId":"18798","spoiler":false},{"segments":[{"spoiler":false,"text":"体内に寄生した触手生物に、悩まされるもその生物と精神の一部を共有しながら様々な事件を乗り越え、共存するようになる。"},{"spoiler":false,"text":"教師に成り済まし生物駆除の為に現れた退魔師【神荘瑠依】から、他にも類似した事例がある事を聞き、触手生物から得られる能力を駆使し捜査に協力する事を決める。"},{"spoiler":false,"text":"触手を宿している事で人並み外れた免疫力や回復力を持ち、年齢が静止している。"}],"source":"egs","sourceCharacterId":"1519","sourceWorkId":"21779","spoiler":false},{"segments":[{"spoiler":false,"text":"交通事故で両親を亡くし祖父母に引き取られるが、迷惑が掛かるのを嫌い全寮制の女子校に転入し、一人で生きていくことを決める。"},{"spoiler":false,"text":"両親を失った精神的痛手は未だ癒えず、元々ごく普通の女の子だった伊月はすっかり心を閉ざしてしまい、人との関わりを避けるようになった。"},{"spoiler":false,"text":"転校以来、友達も作らず常に一人で過ごす。"},{"spoiler":false,"text":"クラスメイトもあまり彼女に関わろうとしない。"},{"spoiler":false,"text":"趣味は読書。 成績はほどほどに良くできるくらい。"}],"source":"egs","sourceCharacterId":"1519","sourceWorkId":"39660","spoiler":false},{"segments":[{"spoiler":false,"text":"交通事故で両親を亡くし祖父母に引き取られるが、迷惑が掛かるのを嫌い全寮制の女子校に転入し、一人で生きていくことを決める。"},{"spoiler":false,"text":"両親を失った精神的痛手は未だ癒えず、元々ごく普通の女の子だった伊月はすっかり心を閉ざしてしまい、人との関わりを避けるようになった。"},{"spoiler":false,"text":"転校以来、友達も作らず常に一人で過ごす。"},{"spoiler":false,"text":"クラスメイトもあまり彼女に関わろうとしない。"},{"spoiler":false,"text":"趣味は読書。 成績はほどほどに良くできるくらい。"}],"source":"bangumi","sourceCharacterId":"90049"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bcb5987b8f1ff586bef3b63c007704440f67630b2ee2b16e53f895872af16cc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60ab426cd74f91c53c3128ff47a9174948afd20dc4633b44605c3ec3e8aba59d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長瀬ゆずは","creatorId":"vndb:s2287","sourcePersonId":"vndb:s2287","canonicalEntityId":"vndb:s2287","name":"長瀬 ゆずは","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:79488:90049:24238:1","source":"bangumi"}]},{"characterId":"char_c24386","characterName":"藤守 ひより","sourceIds":{"bangumi":[{"characterId":"90050","match":"exact-normalized-name-in-linked-work","subjectId":"79488"}],"egsCharacterIds":["1520"],"vndbCharacterId":"c24386"},"originalCharacterName":"藤守 ひより","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"No one knows much about her home life, but her cheerful and kind character would suggest a happy family life."},{"spoiler":false,"text":"Hiyori is an energetic and somewhat foolish girl, with a habit of meddling in other people's affairs. She's good at exercising, but absolutely useless with her studies. She's the only student in Itsuki's class who actually talks to her."}],"source":"vndb","sourceCharacterId":"c24386"},{"segments":[{"spoiler":false,"text":"家庭環境は具体的には不明だが、性格や行動から比較的恵まれた幸せな家庭環境が伺える。"}],"source":"egs","sourceCharacterId":"1520","sourceWorkId":"18798","spoiler":false},{"segments":[{"spoiler":false,"text":"家庭環境は具体的には不明だが、性格や行動から比較的恵まれた幸せな家庭環境が伺える。"},{"spoiler":false,"text":"元気でおバカ系。 おせっかい焼きな性格。"},{"spoiler":false,"text":"運動は得意で勉強は全体的に駄目なほう。"},{"spoiler":false,"text":"クラスで唯一伊月に話しかける同級生。"}],"source":"egs","sourceCharacterId":"1520","sourceWorkId":"39660","spoiler":false},{"segments":[{"spoiler":false,"text":"家庭環境は具体的には不明だが、性格や行動から比較的恵まれた幸せな家庭環境が伺える。"},{"spoiler":false,"text":"元気でおバカ系。 おせっかい焼きな性格。"},{"spoiler":false,"text":"運動は得意で勉強は全体的に駄目なほう。"},{"spoiler":false,"text":"クラスで唯一伊月に話しかける同級生。"}],"source":"bangumi","sourceCharacterId":"90050"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/674c213e8e4c2d4cb7e809fb6822a037276c099a8094318e54bbad003198e43d.webp","fall