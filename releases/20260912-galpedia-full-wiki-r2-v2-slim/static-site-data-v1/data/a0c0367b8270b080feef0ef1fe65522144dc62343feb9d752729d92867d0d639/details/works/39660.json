恐がり。"}],"source":"bangumi","sourceCharacterId":"90051"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/895218f8969dc700666d2c22fc4b94852b02b0a6fa587320285e2a995dc8ff7b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c969861ce350c4e96585cdb0559c78284da8a22f7a48e38c5869b87107d41c8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あーにゃん","creatorId":"vndb:s5102","sourcePersonId":"vndb:s5102","canonicalEntityId":"vndb:s5102","name":"あーにゃん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:53222","source":"vndb"}]},{"characterId":"char_c24388","characterName":"神荘 瑠依","sourceIds":{"bangumi":[{"characterId":"90052","match":"exact-normalized-name-in-linked-work","subjectId":"132898"},{"characterId":"90052","match":"exact-normalized-name-in-linked-work","subjectId":"79488"}],"egsCharacterIds":["1522"],"vndbCharacterId":"c24388"},"originalCharacterName":"神荘 瑠依","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Though her public appearance is that of a part-timer working as a teacher, her true profession is solving paranormal phenomena using ancient techniques-- that is, an exorcist. She was hired to examine the school after a certain person told her about a nest of parasitic creatures that have infested it."},{"spoiler":false,"text":"She has a silent and cool personality, and only ever talks when it's necessary."}],"source":"vndb","sourceCharacterId":"c24388"},{"segments":[{"spoiler":false,"text":"非常勤教師はいくつもある表の顔の一つで、本業は人知れず古の技を用いて超自然現象を解決するという事を仕事としている所謂「退魔師」。"}],"source":"egs","sourceCharacterId":"1522","sourceWorkId":"18798","spoiler":false},{"segments":[