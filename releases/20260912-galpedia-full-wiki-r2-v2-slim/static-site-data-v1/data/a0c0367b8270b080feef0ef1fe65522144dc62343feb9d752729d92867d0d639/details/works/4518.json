{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"4518","model":{"presentationWorkId":"vndb:v11908","staff":{"artwork":[{"creditedName":"斉藤カホ(白井恵利子、黒井恵利子)","creatorId":"vndb:s4098","sourcePersonId":"egs:creator:2827","canonicalEntityId":"vndb:s4098","name":"斉藤カホ(白井恵利子、黒井恵利子)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:78517","source":"egs"}],"scenario":[{"creditedName":"松本竜","creatorId":"vndb:s708","sourcePersonId":"egs:creator:1245","canonicalEntityId":"vndb:s708","name":"松本竜","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:6530","source":"egs"}],"music":[{"creditedName":"谷上純三(CUBE)","creatorId":"egs:creator:3706","sourcePersonId":"egs:creator:3706","canonicalEntityId":"egs:creator:3706","name":"谷上純三(CUBE)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:13115","source":"egs"}],"other":[{"creditedName":"大野 まりな","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:96008","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c13512","characterName":"真納水 那由華","sourceIds":{"vndbCharacterId":"c13512"},"originalCharacterName":"真納水 那由華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"source-only","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"},"weight":{"reviewState":"source-only","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Obedient and devoted to the protagonist. She is deeply in love with him. She is energetic, but a screw-up."},{"spoiler":false,"text":"She is pure-hearted and single-minded. Although she was separated from the main character when she was young, she cherishes the memories of the past when she was with him. Some years ago, a picture of him was sent to the countryside, and there were many evil spirits in it. When she learns of this, she decides to become a miko to exorcise them."},{"spoiler":false,"text":"Favorite foods: Sanuki udon noodles, rice cooked in a pot, strawberry daifuku, oshiruko"},{"spoiler":false,"text":"Favorite movies: Movies with animals in them, Miyaz*ki films."},{"spoiler":false,"text":"Favorite music: Enka and Enka idols"},{"spoiler":false,"text":"Special Skills: 3rd dan in calligraphy, 1st dan in aiki"},{"spoiler":false,"text":"Hobbies: Cooking (Japanese food only), basking in the sun"},{"spoiler":false,"text":"Things to do during days off: Cleaning and Laundry"},{"spoiler":false,"text":"Future goals: Become the main character's miko bride"},{"spoiler":false,"text":"People I respect: the head miko"},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c13512"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f307e55deede696b045a758c461da152c09b95acfbb2cbff1fd9ff6ebc5ad07.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a97a5125e565d6edd03b474f910d5274fe95fdb5ba2a218c0f89eb7555c304f0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春瀬 みき","creatorId":"vndb:s1566","sourcePersonId":"vndb:s1566","canonicalEntityId":"vndb:s1566","name":"春瀬 みき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50992","source":"vndb"}]},{"characterId":"char_vndb_c80459","characterName":"日扇 御守","sourceIds":{"vndbCharacterId":"c80459"},"originalCharacterName":"日扇 御守","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the senior priestess of the Shrine. In fact, when the Masazaku was a child living in the village, she was the sister he used to play with during the summer."},{"spoiler":false,"text":"She wants Masakazu to call her \"Mimo-ane\" and treats her like a big sister. She is calm but sometimes forceful. Always at her own pace. She uses old fashioned words."},{"spoiler":false,"text":"The tool she uses for exorcism is a \"shimenawa whip."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c80459"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d62d77649708d8ab01745771dfb1f1a9948845fdf0ea3f14cde543037e99099f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5aa4e7402122df82b196c99e794aa4130528aba6805b7395fda4cee248612924.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村 あやか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50990","source":"vndb"}]},{"characterId":"char_vndb_c80460","characterName":"イングリッド","sourceIds":{"vndbCharacterId":"c80460"},"originalCharacterName":"イングリッド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is an exchange student miko from Germany. She is studying Japanese priestesses for her research on magic."},{"spoiler":false,"text":"She has blond hair, blue eyes, and the appearance of a Western doll, but she is a genius and not very sociable. She prides herself on being born into a venerable family of wizards."},{"spoiler":false,"text":"She is terrible at swimming, which is a secret complex of hers. Her favorite food is gummy candies, but she has a hard time finding them in the village where the story takes place."},{"spoiler":false,"text":"The tool she uses to exorcise spirits is \"Kottenforst cane,\" which she uses to remove the spirits of the dead."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c80460"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63fad54b0b3e74a21a4b544efe6b4bc61b846c57d11aa5f81bfdd9f041cac7f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc7035884bf6c9f262bfdd7542d93950390d6dfead270397e1f712cd5347e805.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"金田 めい","creatorId":"vndb:s2331","sourcePersonId":"vndb:s2331","canonicalEntityId":"vndb:s2331","name":"小橋 知子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50993","source":"vndb"}]},{"characterId":"char_vndb_c80461","characterName":"七尾","sourceIds":{"vndbCharacterId":"c80461"},"originalCharacterName":"七尾","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A seven-tailed fox."},{"spoiler":false,"text":"She was once sealed away by the ancestors of Shimizu, the chief priest of the shrine, but recently, she has begun to appear and harm the village once again."},{"spoiler":false,"text":"She swears revenge against the chief priest who sealed her away, and turns on Masakazu, who has become the chief priest even though he the replacement. She has a complex about the fact that he has only seven tails, and becomes enraged at any mention of it."},{"spoiler":false,"text":"She is interested in Masakazu because he has a constitution that attracts evil spirits, and he will try to mess with him in any way he can."},{"spoiler":false,"text":"Her favorite food is cup yakisoba."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c80461"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93eae4109a76fd4adc0cb73eab506046a22a38bf78ad16eca7baf6e866c01acb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e6585094e522a1fe8b6cfad29b17fcbfef094f0f5b18e951eb356c0cd09e0b4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村 あやか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50991","source":"vndb"}]},{"characterId":"char_vndb_c80462","characterName":"？？？","sourceIds":{"vndbCharacterId":"c80462"},"originalCharacterName":"？？？","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He seems to be a blood relative of Nanao. He carries a wooden cane that is used more for beating the hell out of others than for supporting his body."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c80462"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/764e3b5c571be1a87268036c9bb7b96e79ab4f3c6bd6290bebd55c52b92c8cf8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7248444358b6670345f909427eabdaf8754c8e13cd7ff11f56a2072754ca8d6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鉄 滝次","creatorId":"vndb:s5677","sourcePersonId":"vndb:s5677","canonicalEntityId":"vndb:s5677","name":"鉄滝次","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50994","source":"vndb"}]},{"characterId":"char_vndb_c80463","characterName":"日扇 鎮務","sourceIds":{"vndbCharacterId":"c80463"},"originalCharacterName":"日扇 鎮務","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is the young chief priest. He is calm and carefree. He is always smiling and laughing, but his ability as a priest is immeasurable."},{"spoiler":false,"text":"He was hospitalized after an accident on Masakazu's first day of work."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c80463"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2dc6e34c80c94d87819152388f8dc95e8655532697d394493b6d5627f5fd33c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a763a51f431124d0eee2bb78be9d0ba7e4a2314722b83bb527fbd9eb7d0aec56.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鉄 滝次","creatorId":"vndb:s5677","sourcePersonId":"vndb:s5677","canonicalEntityId":"vndb:s5677","name":"鉄滝次","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:50995","source":"vndb"}]},{"characterId":"char_vndb_c80464","characterName":"兄弟","sourceIds":{"vndbCharacterId":"c80464"},"originalCharacterName":"兄弟","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A brother and sister who just moved here from the city. They are having a hard time joining the children's group in the village. They come to the shrine to catch beetles."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c80464"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80ce284fc94cae5998f6d923818d60e8487dfbebf58591576e9b9c68405882cf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f96b5160ddaf33cbc9d9ce7b1b666af63fe33896fe324dde540aa2dfc7e72bb.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c80465","characterName":"生田 政和","sourceIds":{"vndbCharacterId":"c80465"},"originalCharacterName":"生田 政和","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main character. He is a childhood friend of the heroine Nayuka, who was born and raised in the village."},{"spoiler":false,"text":"This spring, he passed the entrance exam to a university after three failed attempts. In the previous work, \"Minyo!, Nayuka has been able to eliminate a large number of evil spirits that had been possessing him in the previous work."},{"spoiler":false,"text":"He has a body that attracts evil spirits."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c80465"}],"profileFacts":[],"metadataCandidateConflic