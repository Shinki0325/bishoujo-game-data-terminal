alue":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"52"},"weight":{"reviewState":"source-only","source":"bangumi","value":"32"}},"descriptions":[{"segments":[{"spoiler":false,"text":"拉卡斯王国浮游城侯爵的女儿，有魔法才能的活泼女孩，在战争之初亲眼目睹了父亲的死亡，而这件事也成了她心头一直挥之不去的阴影。"},{"spoiler":false,"text":"与羁绊之人迪哈尔特同踏上逃亡与复国之旅，成为传说中的一道靓影。"}],"source":"bangumi","sourceCharacterId":"72599"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/232ae1bc094d0aebd8c8b0ba238946d04e2a68ce32ca8f44589f02a6aa1c3b37.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2ae170a646ec0912c875a590704415f3b26d5baedf1462e46ecfa39c9adb01be.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"かないみか","creatorId":"vndb:s1818","sourcePersonId":"vndb:s1818","canonicalEntityId":"vndb:s1818","name":"かない みか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12466:72599:3896:1","source":"bangumi"}]},{"characterId":"char_bangumi_72606","characterName":"Leafani","sourceIds":{"bangumi":[{"characterId":"72606","match":"source-roster","subjectId":"12466"}]},"originalCharacterName":"Leafani","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"bangumi","value":"82"},"height":{"reviewState":"source-only","source":"bangumi","value":"164"},"hip":{"reviewState":"source-only","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"56"},"weight":{"reviewState":"source-only","source":"bangumi","value":"41"}},"descriptions":[{"segments":[{"spoiler":false,"text":"原本是王国首都拉卡西亚的贵族之后，在帝国的侵略中被迫逃离，与见习骑土皮耶鲁一起掩护平民撤离，与迪哈尔特一行相遇并加入了冒险。"},{"spoiler":false,"text":"自幼跟随父母学习魔法，在复国军的冒险中展露了无可取代的魔