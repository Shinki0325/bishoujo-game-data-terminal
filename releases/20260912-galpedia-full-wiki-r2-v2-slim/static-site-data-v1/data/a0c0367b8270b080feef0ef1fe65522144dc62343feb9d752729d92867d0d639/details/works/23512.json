inal-wiki/v1/characters/v1/images/a7/a7e3fb350c7fe11df8b24d754eb776c127bdef03894df0443cfc9a8d8c059cd9.webp","width":147,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水谷優子","creatorId":"vndb:s3229","sourcePersonId":"vndb:s3229","canonicalEntityId":"vndb:s3229","name":"水谷 優子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:12466:72607:4644:1","source":"bangumi"}]},{"characterId":"char_bangumi_72608","characterName":"Freya","sourceIds":{"bangumi":[{"characterId":"72608","match":"source-roster","subjectId":"12466"}]},"originalCharacterName":"Freya","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"bangumi","value":"85"},"height":{"reviewState":"source-only","source":"bangumi","value":"164"},"hip":{"reviewState":"source-only","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"waist":{"reviewState":"source-only","source":"bangumi","value":"56"},"weight":{"reviewState":"source-only","source":"bangumi","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"古代巴拉鲁王国的公主，亦是王国军队的指挥官，与寻常的公主不同，芙蕾雅经常身先土卒，带领军队冲锋。"},{"spoiler":false,"text":"剑术与腕力不输于男性战士，天生拥有极强的运动神经，而在天赋之下也是惊人的努力家。"},{"spoiler":false,"text":"在战争中因父王的命令而与复国军敌对，不得不一次又一次与迪哈尔特战斗。"}],"source":"bangumi","sourceCharacterId":"72608"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f41ad8459e871e59012e5018f56ca5faa2c81a5c57dcdbd08ed3b129b5f1173f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84602dabe67abccc5268bae7ce52b13dfcb293dd7859a0c6367199b85fabf0a3.webp","width":173,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉田小南美","creatorId":"vndb:s4725","sourcePersonId":"vndb:s4725","canonicalEntityId":"vndb