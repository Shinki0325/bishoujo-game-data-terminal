inalCharacterName":"水城 七瀬","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【学園に君臨する女王様】"},{"spoiler":false,"text":"本家・水城家の少女。主人公の姪。"},{"spoiler":false,"text":"本家の一人娘として島（学校）に君臨している。"},{"spoiler":false,"text":"水城家の人間である七瀬の言葉には島の大人も逆らえない。"},{"spoiler":false,"text":"母である美紗緒に楯突くこともしばしばだが、伯父である晴彦には唯一、頭が上がらない。"},{"spoiler":false,"text":"というよりも、男として惚れてしまっている。"},{"spoiler":false,"text":"その主人公が七海を気に掛けるため、七海に対して嫉妬心を燃やす。"},{"spoiler":false,"text":"生まれ育ちのせいか、我が強く、その言動は高慢と見られることがしばしばである。"},{"spoiler":false,"text":"嗜虐的な傾向があり、冗談めかして他人を弄ぶこともあるが、それにもやはり誰も逆らえない。"},{"spoiler":false,"text":"しかし彼女もまた、“巫女”に任ぜられてしまう。"},{"spoiler":false,"text":"「伯父様……七瀬、今日は伯父様とご一緒したいの。よろしいでしょう？ ね？」"}],"source":"egs","sourceCharacterId":"14237","sourceWorkId":"13249","spoiler":false},{"segments":[{"spoiler":false,"text":"島を支配する本家・水城家の少女。"},{"spoiler":false,"text":"本家の一人娘として島（学校）に君臨している。水城家の人間である七瀬の言葉には島の大人も逆らえない。"},{"spoiler":false,"text":"母である美紗緒に楯突くこともしばしばだが、伯父である晴彦には唯一、頭が上がらない。"},{"spoiler":false,"text":"その生まれ育ちのせいか、我が強く、その言動は高慢と見られることがしばしばである。"},{"spoiler":false,"text":"嗜虐的な傾向があり、冗談めかして他人を弄ぶこともあるが、それにもやはり誰も逆らえない。"},{"spoiler":false,"text":"「伯父様……七瀬、今日は伯父様とご一緒したいの。よろしいでしょう？ ね？」"}],"source":"bangumi","sourceCharacterId":"144828"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/7427a70fa94a580f67478e37aa82664462fe8d5dba6fa930e6d97c8ea71ff9c3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f776a096a66e3e1ac1ee2749410e25ae8ae72fd3214a8eba7fdf86a110cf941c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabe