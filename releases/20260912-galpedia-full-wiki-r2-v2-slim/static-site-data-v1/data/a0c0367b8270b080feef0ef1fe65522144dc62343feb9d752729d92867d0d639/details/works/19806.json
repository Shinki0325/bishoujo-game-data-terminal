b","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Misora's doppleganger. Because of it, Riku proposed to her when they first meet. She takes interest in him and accepts his proposal."}],"source":"vndb","sourceCharacterId":"c17498"},{"segments":[{"spoiler":false,"text":"唐突に転入してきた美空（主人公のかつての恋人）のそっくりさん。"},{"spoiler":false,"text":"容姿は似通っているが性格はまったく違う。"},{"spoiler":false,"text":"とある事件をきっかけに主人公と付き合うことに。"},{"spoiler":false,"text":"主人公が自分にかつての恋人の面影を重ねていることに気づいて、手玉にとって楽しんでいる。"},{"spoiler":false,"text":"周囲のヒロインたちが主人公に好意をよせていることにいち早く気づいているため、主人公にちょっかいをかけて反応を楽しんでいる。"},{"spoiler":false,"text":"本人は困った性格を自覚しているが、直すつもりはなく自分ではかなり気に入っている。"},{"spoiler":false,"text":"主人公を手に入れるまで正体を押さえて接している。"},{"spoiler":false,"text":"霧緒はこの性格を承知しつつも　「それくらいのタマではないと主人公と恋人になれない」　と思い、宮子に協力することに。"}],"source":"egs","sourceCharacterId":"2870","sourceWorkId":"19806","spoiler":false},{"segments":[{"spoiler":false,"text":"唐突に転入してきた美空 （主人公のかつての恋人） のそっくりさん。"},{"spoiler":false,"text":"容姿は似通っているが性格はまったく違う。"},{"spoiler":false,"text":"とある事件をきっかけに主人公と付き合うことに。"},{"spoiler":false,"text":"主人公が自分にかつての恋人の面影を重ねていることに気づいて、手玉にとって楽しんでいる。"},{"spoiler":false,"text":"本人は困った性格を自覚しているが直すつもりはなく、自分ではかなり気に入っている。"},{"spoiler":false,"text":"そして主人公を手に入れるまで正体を抑えて接している。"},{"spoiler":false,"text":"霧緒はこの性格を承知しつつも 「それくらいのタマでないと主人公と恋人になれない」 と思い、宮子に協力することに。"},{"spoiler":false,"text":"「OK、付き合っちゃおう♪」"}],"source":"bangumi","sourceCharacterId":"23940"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/0905abf5971b77db89504f4a9130d2b83a6b0234c8cc7e1704ab5d05c0176233.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0ff6b956f609a9f00c254d300cb06ebd9ad9b8ec5908261d18fa673d87a50540.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","role