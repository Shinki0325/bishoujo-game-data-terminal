tatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Childhood friend of the protagonist."},{"spoiler":false,"text":"Because of her attitude and looks she is popular among both boys and girls, though strangely enough she doesn't have any close relationships with anyone."}],"source":"vndb","sourceCharacterId":"c50913"},{"segments":[{"spoiler":false,"text":"幼なじみであり、久しぶりに再会した同級生の女の子。"},{"spoiler":false,"text":"人当たりのいい性格で容姿もいいため男女ともに好感を持たれるが、不思議と誰かと付き合ったり、特定の誰かと仲が良くなったりもせず、絶妙な距離感で人づきあいをしている。"},{"spoiler":false,"text":"学校の成績はいつも上位であるが、トップにはならず、スポーツも平均よりちょっと上くらいを意図的にキープし続けている。"}],"source":"egs","sourceCharacterId":"9817","sourceWorkId":"23917","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼なじみであり、久しぶりに再会した同級生。"},{"spoiler":false,"text":"人当たりが良く容姿も良いため、男女ともに好感を持たれている。"},{"spoiler":false,"text":"しかし不思議と深い仲になることはなく、絶妙な距離感で人付き合いをしている。"},{"spoiler":false,"text":"成績はいつも上位だがトップにはならず、運動も平均よりちょっと上をキープし続けている。"}],"source":"bangumi","sourceCharacterId":"48582"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/813414d3963ad8be993f1169ee9464a1ec7034e11195c3c72118a9208c884f39.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70a2ce91f2028c438d10322adbe34ad130c9bffbe8e77d3866bca2b7923bff31.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"口谷 亜夜","creatorId":"vndb:s1755","sourcePersonId":"vndb:s1755","canonicalEntityId":"vndb:s1755","name":"口谷亜夜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:70031","source":"vndb"}]},{"characterId":"char_c50914","characterName":"北大路 絢香","sourceIds":{"bangumi":[{"characterId":"48583","match":"exact-normalized-name-in-linked-work","subjectId":"186370"}],"egsCharacterIds":["9818"],"vndbCharacterId":"c50914"},"origina