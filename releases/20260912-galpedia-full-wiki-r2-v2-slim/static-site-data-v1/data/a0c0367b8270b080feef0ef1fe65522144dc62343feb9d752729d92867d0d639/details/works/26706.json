iki/v1/characters/v1/images/8c/8c7ce43dfae33880ed0dcca2a569ce32165dec5dfe9643bb5e47c30cb55a4342.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b06419a02a70a2963880656115d74e1ff424af0b0d6a0b90e223dd38140a8a49.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽真ちい","creatorId":"vndb:s14495","sourcePersonId":"vndb:s14495","canonicalEntityId":"vndb:s14495","name":"羽真ちい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:244935:64315:35609:1","source":"bangumi"}]},{"characterId":"char_c70265","characterName":"山城 若葉","sourceIds":{"bangumi":[{"characterId":"64316","match":"exact-normalized-name-in-linked-work","subjectId":"244935"}],"egsCharacterIds":["20449"],"vndbCharacterId":"c70265"},"originalCharacterName":"山城 若葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"とある大病院、「山城総合病院」院長の隠し子。"},{"spoiler":false,"text":"妾の子と、今まで冷遇されてきたのですが、主人公の嫁選びに適していると、父親に参加を命じられる事に。"},{"spoiler":false,"text":"あまり自己主張せず、言われるままに流されてしまう性格もあって、異を唱える事無く参加します。"},{"spoiler":false,"text":"そんな境遇にも、笑みを絶やさず明るく前向きですが、ちょっとおっとり天然系。"},{"spoiler":false,"text":"父親の病院で（娘という事は秘密で）看護婦として働いていて、世話好きという事も相まって、患者からは慕われています。"},{"spoiler":false,"text":"主人公に対して、生まれて初めて「お世話したい、可愛がりたい」という強い欲求を感じ、これまた初めて「自分から積極的に」主人公にアプローチしてゆく事に。"},{"spoiler":false,"text":"その欲求が、一目惚れによる恋愛感情なのかどうかは、本人も計りかねています。"},{"spoiler":false,"text":"積極的なアプローチを行いはしますが、父親に命じられている主人公との結婚に関しては拘泥していません。"},{"spoiler":false,"text":"あくまで自身の欲求に従って、アプローチを行っています。"}],"source":"egs","sourceCharacterId":"20449","sourceWorkId":"26706","spoiler":false},{"segments":[{"spoiler":false,"text":"とある大病院「山城総合病院」院長の隠し子。"},{"spoiler":false,"text":"今まで冷遇されてきたのですが、主人公の嫁選びに適していると、父親に参加を命じられる事に。"},{"spoiler":false,"text":"あまり自己主張せず、言われるままに流されてしまう性格もあって、異を唱える事無く参加します。"},{"spoiler":false,"text":"そんな境遇にも、笑みを絶やさず明るく前向きですが、ちょっとおっとり天然系。"},{"spoiler":false,"text":"父親の病院で（娘という事は秘密で）看護婦として働いていて、世話好きという事も相まって、患者からは慕われています。"},{"spoiler":false,"text":"主人公に対して、生まれて初めて「お世話したい、可愛がりたい」という強い欲求を感じ、"},{"spoiler":false,"text":"これまた初めて「自分から積極的に」主人公にアプローチしてゆく事に。"},{"spoiler":false,"text":"その欲求が、一目惚れによる恋愛感情なのかどうかは、本人も計りかねています。"},{"spoiler":false,"text":"積極的なアプローチを行いはしますが、父親に命じられている主人公との結婚に関しては拘泥していません。"},{"spoiler":false,"text":"あくまで自身の欲求に従って、アプローチを行っています。"},{"spoiler":false,"text":"仕事着は、当然ながら看護服。"},{"spoiler":false,"text":"私服はごく普通ですが、ちょっと可愛い系。"}],"source":"bangumi","sourceCharacterId":"64316"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1bc383461aaa099bfebb9939ea1f9c6484fd08ffd2185b978f4e4f2835d5182.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e2dce08f7e91f999b270811bc0b2b316fbec9fd2ccf19c5e499f97949aafc52.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"平野響子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:244935:64316:5669:1","source":"bangumi"}]},{"characterId":"char_vndb_c122050","characterName":"神楽木 旭","sourceIds":{"vndbCharacterId":"c122050"},"originalCharacterName":"神楽木 旭","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1079","sourceCompanyId":"egs:brand:2272","canonicalEntityId":"vndb:p1079","name":"オーバードーズ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:26706:2272","source"