ityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大世界下宿203号室の住人。"},{"spoiler":false,"text":"地球から100万光年離れた惑星から来たと自称する宇宙人。"},{"spoiler":false,"text":"本人はユニバール星人で地球に遊びに来たと言っているがどうやら他の目的があるらしい。"},{"spoiler":false,"text":"主人公、近衛慎一郎と同じ学校に通い、表向きは地球人の学生として暮らしている。"},{"spoiler":false,"text":"明るく楽観的で地球の小動物が大好き。"},{"spoiler":false,"text":"エーテルと呼ばれる地球では存在しないとされるエネルギーを使い獣よりも早く強くなることができる。"},{"spoiler":false,"text":"考えなしに行動するので、しょっちゅう下宿に大穴を空けてしまう。"},{"spoiler":false,"text":"ユニバール星では身分の高い人物らしいが、みんなには内緒にしている。"},{"spoiler":false,"text":"「輝け！　私のエーテル力（ぢから）!!」"}],"source":"egs","sourceCharacterId":"14353","sourceWorkId":"13104","spoiler":false},{"segments":[{"spoiler":false,"text":"地球から100万光年離れた惑星から来たと自称する宇宙人。"},{"spoiler":false,"text":"本人はユニバール星人で地球に遊びに来たと言っているが、どうやら他の目的があるらしい。"},{"spoiler":false,"text":"明るく楽観的で、地球の小動物が大好き。"},{"spoiler":false,"text":"エーテルと呼ばれる地球では存在しないとされるエネルギーを使い、獣よりも早く強くなることができる。"},{"spoiler":false,"text":"考えなしに行動するので、しょっちゅう下宿に大穴を空けてしまう。"},{"spoiler":false,"text":"「輝け！　私のエーテル力 !!」"}],"source":"bangumi","sourceCharacterId":"31972"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b484525f19cf9477612a97c579c0bea192708ca256625a51fbc495508ade6a47.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e67a96f8a54a3c870cbd7e35d82a3ca3a0a55d5f3e1e4aa98b40afba29c009e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:131004:31972:4675:1","source":"bangumi"}]},{"characterId":"char_c14713","characterName":"フウ","sourceIds":{"bangumi":[{"characterId":"31975","match":"exact-normalized-name-in-linked-work","subjectId":"131004"}],"egsCharacterIds":["14355"],"vndbCharacterId":"c14713"},"originalCharacterName":"フウ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大世界下宿103号室の住人。"},{"spoiler":false,"text":"主人公より一つ下の学年に在籍するが、本当の年齢は本人も忘れてしまったぐらい長生きしている。"},{"spoiler":false,"text":"自分と周囲にいる人間を不幸にする特殊な体質。"},{"spoiler":false,"text":"本人は自分のことを貧乏神といっている。"},{"spoiler":false,"text":"不幸で不死身が彼女のキャッチフレーズになっていて何かあるたびにスプラッタな状況に巻き込まれる。"},{"spoiler":false,"text":"骨折、串刺し、すりつぶし、様々な酷い目に合い続け不死身であることを証明し続けている。"},{"spoiler":false,"text":"大世界下宿が唯一彼女を受け入れてくれた場所なので今の生活を大事にしたいと考えている。"},{"spoiler":false,"text":"何事にも一生懸命で健気な性格。"},{"spoiler":false,"text":"下宿の中では一番の常識人。"},{"spoiler":false,"text":"「死ねないのは、死ぬより辛いんだよね……神様って辛いよね」"}],"source":"egs","sourceCharacterId":"14355","sourceWorkId":"13104","spoiler":false},{"segments":[{"spoiler":false,"text":"慎一郎より一つ下の学年に在籍するが、本当の年齢は本人も忘れてしまったぐらい長生きしている。"},{"spoiler":false,"text":"下宿の中では一番の常識人で、何事にも一生懸命で健気な性格。"},{"spoiler":false,"text":"自分と周りの人間を不幸にする特殊体質なため、自分のことを貧乏神と言っている。"},{"spoiler":false,"text":"なにかあるたびに様々な酷い目に遭い続け、不死身であることを証明し続けている。"},{"spoiler":false,"text":"大世界下宿が唯一自分を受け入れてくれた場所なので、今の生活を大事にしたいと考えている。"},{"spoiler":false,"text":"「死ねないのは、死ぬより辛いんだよね……神様って辛いよね」"}],"source":"bangumi","sourceCharacterId":"31975"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3fc453339daab7fdc8b178ecb4d9cbeea90998c20c96776eb91b5577acfb29b2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e7852ae626c7dbc329451029a763044a915f2e69ca42a54437e828a4f2d38d1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:131004:31975:4490:1","source":"bangumi"}]},{"characterId":"char_c14714","characterName":"綾風 かなえ","sourceIds":{"bangumi":[{"characterId":"31973","match":"exact-normalized-name-in-linked-work","subjectId":"131004"}],"egsCharacterIds":["14354"],"vndbCharacterId":"c14714"},"originalCharacterName":"綾風 かなえ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大世界下宿205号室の住人。"},{"spoiler":false,"text":"主人公より年上に見えるが年齢不詳。"},{"spoiler":false,"text":"特殊な技術を継承している魔法使い。"},{"spoiler":false,"text":"74人の魔法組合の1人で世の心理を追及し世界の構造を解明するのが目的。"},{"spoiler":false,"text":"その過程で様々な技術を生み出している。"},{"spoiler":false,"text":"理知的で潔癖。落ち着いた性格だが自称宇宙人のメグが相手になると、なぜかケンカになってしまう。"},{"spoiler":false,"text":"魔法使いとエーテル使いのケンカは戦争レベルの戦いになるため、大世界下宿は破壊と修繕を繰り返すことになる。"},{"spoiler":false,"text":"多額の借金があるらしく、バイトをいくつも掛け持ちしている。"},{"spoiler":false,"text":"「今日こそ、キミの力の秘密暴かせてもらおうかな」"}],"source":"egs","sourceCharacterId":"14354","sourceWorkId":"13104","spoiler":false},{"segments":[{"spoiler":false,"text":"慎一郎より年上に見えるが年齢不詳の魔法使い。"},{"spoiler":false,"text":"74人の魔法組合の1人で、世の真理を追究し世界の構造を解明するのが目的。"},{"spoiler":false,"text":"理知的で潔癖。落ち着いた性格だがメグが相手になると、なぜかケンカになってしまう。"},{"spoiler":false,"text":"この2人のケンカは戦争レベルの戦いになるため、大世界下宿は破壊と修繕を繰り返すことになる。"},{"spoiler":false,"text":"多額の借金があるらしく、バイトをいくつも掛け持ちしている。"},{"spoiler":false,"text":"「今日こそ、キミの力の秘密暴かせてもらおうかな」"}],"source":"bangumi","sourceCharacterId":"31973"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fd6f7610e1ffec5d825a0178378fbc1d02a100819ae5ecfd34f6748c7b6386f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8f29039de3d91ac91a895ce4efb61c95cc4c95fb