ons":[{"segments":[{"spoiler":false,"text":"A cool beauty fox youkai with a doting older sister vibe."},{"spoiler":false,"text":"She watches over the protagonist, cares for him, and pampers him when appropriate. She helps the protagonist grow while helping him heal his emotional wounds."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c77805"},{"segments":[{"spoiler":false,"text":"主人公を見守りつつ世話を焼き、適切な範囲で甘やかす。"},{"spoiler":false,"text":"主人公の心の傷を取り除かせつつ、しっかりと成長させてくれる。"}],"source":"egs","sourceCharacterId":"20540","sourceWorkId":"27357","spoiler":false},{"segments":[{"spoiler":false,"text":"桜花城の城主であり、桜花市一帯を支配する半人半妖の妖狐。"},{"spoiler":false,"text":"クールな面持ちと物言いが特徴的。"},{"spoiler":false,"text":"一見とっつきにくそうに見えるが、"},{"spoiler":false,"text":"面倒見が良かったり、天然な部分を持っていたりする。"},{"spoiler":false,"text":"世を忍ぶ仮の姿は看護師。"}],"source":"bangumi","sourceCharacterId":"67553"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f499c5e3c69c8f288e7241d8dac9ea0bc13b02547b3bc9dcf87705a8127c314.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0e8e4f2e7e86701bf7a34389cebc39356d7a26843a5ac7114ff6b5d7799d231.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"尾崎未來","creatorId":"vndb:s986","sourcePersonId":"vndb:s986","canonicalEntityId":"vndb:s986","name":"尾崎 未來","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268388:67553:13776:1","source":"bangumi"}]},{"characterId":"char_c77806","characterName":"皆木 深雪","sourceIds":{"bangumi":[{"characterId":"67554","match":"exact-normalized-name-in-linked-work","subjectId":"268388"}],"egsCharacterIds":["20541"],"vndbCharacterId":"c77806"},"originalCharacterName":"皆木 深雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A gentle, calm Yuki-onna with the air of a doting mother."},{"spoiler":false,"text":"She thoroughly pampers the protagonist, trying to make him dependent and completely infatuated with her. Her desire to be wanted and loved is much stronger than most."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c77806"},{"segments":[{"spoiler":false,"text":"主人公を徹底的に甘やかし、依存させ夢中にさせようとする。"},{"spoiler":false,"text":"自分を欲して欲しい、愛して欲しいという感情が人一倍強い。"}],"source":"egs","sourceCharacterId":"20541","sourceWorkId":"27357","spoiler":false},{"segments":[{"spoiler":false,"text":"桜花城の家事全般を取り仕切る雪女。"},{"spoiler":false,"text":"穏やかで他者に安心感を与える性格で、みんなのママ的存在。"},{"spoiler":false,"text":"世を忍ぶ仮の姿は保育士。"}],"source":"bangumi","sourceCharacterId":"67554"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/815560b661d310222baf2065736b624a941c3bae426277c90255d8d442ed66f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/171382502cd654b0205868d9b68fc295ce69969507cdffd215651a3561c826ea.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268388:67554:5928:1","source":"bangumi"}]},{"characterId":"char_c77807","characterName":"黒宮 一夏","sourceIds":{"bangumi":[{"characterId":"67555","match":"exact-normalized-name-in-linked-work","subjectId":"268388"}],"egsCharacterIds":["20542"],"vndbCharacterId":"c77807"},"originalCharacterName":"黒宮 一夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A cheerful, nerdy, NEET cat girl."},{"spoiler":false,"text":"She spends her days fully immersed in the entertainment of the human world. She's the most knowledgeable about human affairs. Her hobbies include the internet, gaming, and manga, and she basically lives like a NEET."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c77807"},{"segments":[{"spoiler":false,"text":"人間界の娯楽にたっぷりと浸る毎日を送っている。"},{"spoiler":false,"text":"一番人間界の事情に詳しい。"},{"spoiler":false,"text":"ネットやゲーム、漫画が趣味でほとんどニートのような生活を送っている。"}],"source":"egs","sourceCharacterId":"20542","sourceWorkId":"27357","spoiler":false},{"segments":[{"spoiler":false,"text":"桜花城の自宅警備員を務める猫娘。"},{"spoiler":false,"text":"陽気で調子者な性格でムードメーカー的存在。"},{"spoiler":false,"text":"ニュースからエンタメまで、一番人間界の事情に詳しい。"},{"spoiler":false,"text":"世を忍ぶ仮の姿は無職ニート。"}],"source":"bangumi","sourceCharacterId":"67555"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/040356c4b980e3330b48bb361aa3cd1bdd57e13c01551b50fa80c0b5ddab7b38.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/783470c3247e9ed83290c7afcd300c4fc375fbe46ace69387165e55ccabe1d9b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268388:67555:5906:1","source":"bangumi"}]},{"characterId":"char_vndb_c111027","characterName":"九鬼 創高","sourceIds":{"vndbCharacterId":"c111027"},"originalCharacterName":"九鬼 創高","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewS