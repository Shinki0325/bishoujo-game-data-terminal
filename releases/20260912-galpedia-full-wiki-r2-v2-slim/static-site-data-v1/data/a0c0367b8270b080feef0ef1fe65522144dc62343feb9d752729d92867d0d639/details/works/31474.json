{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"31474","model":{"presentationWorkId":"vndb:v31836","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c99098","characterName":"松乃 美琴","sourceIds":{"vndbCharacterId":"c99098"},"originalCharacterName":"松乃 美琴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"30"},"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The wife of Matsuno Nariyuki. She is disgusted at their neighbor Fukuda Tomio since he always looks at her in a dirty way. However, after learning about the large debt secretly incurred by her husband from gambling, she agreed to help Fukuda recover from his erectile dysfunction as a form of debt payment."},{"spoiler":false,"text":"While working with Fukuda, she realized that even though he is a pervert, he isn't as bad as she initially thought. She also wants a child, but not until her husband gets a proper job."}],"source":"vndb","sourceCharacterId":"c99098"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8eee1e03df8def52bf627965dc1dbd9ea0a3dd7f9ae8f865d72ac7e0d2cf409a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e85cba25cf70c3679cdd1be6c2fdcd63ee13df5102bcc95feb047c15cbd44e01.webp","width":74,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤村 莉央","creatorId":"vndb:s21197","sourcePersonId":"vndb:s21197","canonicalEntityId":"vndb:s21197","name":"藤村 莉央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:88985","source":"vndb"}]},{"characterId":"char_vndb_c99321","characterName":"松乃 也行","sourceIds":{"vndbCharacterId":"c99321"},"originalCharacterName":"松乃 也行","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"33"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The husband of Matsuno Mikoto. Ever since he was fired from his company, he is working part time at the convenience store. Even though his wife Mikoto constantly reminds him to look for a proper job, he avoids the issue most of the time and spends his free time fishing or gambling."},{"spoiler":false,"text":"He incurred a large debt due to gambling, but keeps it a secret to his wife. Because Fukuda didn't add any interest and isn't exactly pressuring him to pay, he doesn't seem to care much about his debt. Unknown to him, his wife is working extra hours to pay for his debt."}],"source":"vndb","sourceCharacterId":"c99321"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c40993f758b0392d560222506952cf1af1aa4e1ac2869db1573dd5bc8c64546d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a1ef458e270d7408051d9c54db29c6c8da1b788fba407a2111492d0aa0c2dc7.webp","width":115,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c99322","characterName":"福田 富雄","sourceIds":{"vndbCharacterId":"c99322"},"originalCharacterName":"福田 富雄","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"61"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A neighbor of the Matsuno couple. He and his wife manages a real estate business. However, after Fukuda's wife hurt her arm, he asked Nariyuki if he could get his wife Mikoto to work part time for them, to which she agreed."},{"spoiler":false,"text":"He is suffering from erectile dysfunction, but for some reason his manhood seems to react whenever looking at Mikoto. Back in his prime, he was known as a sexual prodigy at the brothels he used to frequent. He may be a pervert, but deep down he is a socially awkward man who is kind and considerate to others."}],"source":"vndb","sourceCharacterId":"c99322"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b2dd8fa13ab3f3c03744ccbe336d91372b25013505ac51b6c02f41296902650.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd9f42bed2ead295d9910a57e3bb2139f161542a983340f1bd09794a6ee78d8a.webp","width":110,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:3999","sourceCompanyId":"egs:brand:3999","canonicalEntityId":"egs:brand:3999","name":"らすこう(くちなわ)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:31474:3999","source":"egs"},{"companyId":"vndb:p3723","sourceCompanyId":"vndb:p3723","canonicalEntityId":"vndb:p3723","name":"らすこう","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:91467:v31836","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing"],"source":"terminal-wiki-full-runtime-v7"}}
