が、生来争いごとに向かない棗には未だ実戦を経験させていない。"}],"source":"bangumi","sourceCharacterId":"45550"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"22643","sourceWorkId":"8793","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"22643","sourceWorkId":"8793","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"22643","sourceWorkId":"8793","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"22643","sourceWorkId":"8793","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c290e4173be058062198d7c61915caccf900261a352e5333d2bab4bb673f512f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/ddca41569e068164bbad0bb96706c3bd30f7a1b295958c0fddb0586d969b1ba3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高瀬聖","creatorId":"vndb:s2061","sourcePersonId":"vndb:s2061","canonicalEntityId":"vndb:s2061","name":"高瀬聖","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:191940:45550:86477:1","source":"bangumi"}]},{"characterId":"char_c26886","characterName":"清白","sourceIds":{"bangumi":[{"characterId":"45551","match":"exact-normalized-name-in-linked-work","subjectId":"191940"}],"egsCharacterIds":["22645"],"vndbCharacterId":"c26886"},"originalCharacterName":"清白","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「破魔邪乃巫女」に属する巫女の一人。"},{"spoiler":false,"text":"元々は、蘇乃帋家に仕える侍女だったが、努力を重ねて、破魔邪乃巫女の資格を得る。"},{"spoiler":false,"text":"厳しいながらも優しく、面倒見が良い性格から、破魔邪乃巫女見習いの少女たちに慕われている。"},{"spoiler":false,"text":"彼女自身は、まだまだ「破魔邪乃巫女」として未熟であり、実戦に参加させるだけの経験を積んでいない。"}],"source":"egs","sourceCharacterId":"22645","sourceWorkId":"8793","spoiler":false},{"segments":[{"spoiler":false,"text":"もともとは蘇乃帋家に仕える侍女であったが、努力と勉学を重ね、破魔邪乃巫女の試験に合格した苦労人。"},{"spoiler":false,"text":"スラリとした身体で、強い気持ちをもつ巫女である。しかし、破魔邪乃巫女としては、駆け出しの存在であり、実戦を経験出来るような修練は未だ積んでいない。"},{"spoiler":false,"text":"その厳しくも優しい性格から、破魔邪乃巫女見習いの少女たちに慕われている。"}],"source":"bangumi","sourceCharacterId":"45551"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"22645","sourceWorkId":"8793","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"22645","sourceWorkId":"8793","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"22645","sourceWorkId":"8793","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"22645","sourceWorkId":"8793","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be1c8fc2491106fe461f3a4ba5dd4e1b8443ddaaf21d404da05c04b7a24e099c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/612202f66c61ae2570f9d180dceae95289c941da5656fe262ba97555467b75d4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","role