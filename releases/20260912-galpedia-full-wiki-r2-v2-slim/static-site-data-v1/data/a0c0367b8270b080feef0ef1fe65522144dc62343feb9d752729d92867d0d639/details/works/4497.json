ki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/ddc1e68ab07e48112f5e4b5e6d1821a7c2089b557afe85a33b31e70f1ecf2132.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d9cba61d18a4d4d81cba4d2a2b5cf62f5cda177352754b3733edb5d0e8e9d1a.webp","width":177,"height":256,"source":"static-detail"},"actors":[{"creditedName":"棟方 一志","creatorId":"vndb:s4569","sourcePersonId":"vndb:s4569","canonicalEntityId":"vndb:s4569","name":"棟方 一志","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:215","source":"vndb"}]},{"characterId":"char_c82635","characterName":"伊東 みつ枝","sourceIds":{"bangumi":[{"characterId":"135051","match":"exact-normalized-name-in-linked-work","subjectId":"1337"}],"egsCharacterIds":["26747"],"vndbCharacterId":"c82635"},"originalCharacterName":"伊東 みつ枝","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"わかばの祖母であり、銭湯『華の湯』の経営者。"},{"spoiler":false,"text":"わかばがそのまま年を取ったような、のほほんとした性格。"},{"spoiler":false,"text":"明るくお人好しなお年寄り、といった印象を与える。"},{"spoiler":false,"text":"孫のわかばとは、仕事の当番をじゃんけんで決めたりしながら飼い猫のヘンリー３世と一緒に、のんびりと毎日を過ごしている。"},{"spoiler":false,"text":"どんな時でも笑顔を浮かべているが実は渋蔵ですら頭が上がらないご町内の長老的存在。"},{"spoiler":false,"text":"「はい、たんとお上がり」"}],"source":"egs","sourceCharacterId":"26747","sourceWorkId":"4497","spoiler":false},{"segments":[{"spoiler":false,"text":"わかばの祖母であり、銭湯『華の湯』の経営者。"},{"spoiler":false,"text":"わかばがそのまま年を取ったような、のほほんとした性格。"},{"spoiler":false,"text":"明るくお人好しなお年寄り、といった印象を与える。"},{"spoiler":false,"text":"孫のわかばとは、仕事の当番をじゃんけんで決めたりしながら飼い猫のヘンリー３世と一緒に、のんびりと毎日を過ごしている。"},{"spoiler":false,"text":"どんな時でも笑顔を浮かべているが実は渋蔵ですら頭が上がらないご町内の長老的存在。"},{"spoiler":false,"text":"「はい、たんとお上がり」"}],"source":"bangumi","sourceCharacterId":"135051"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b67c41c2e4a33784ee9e6fc46a4f69d46f3e6759431195eef23b29b80aef7519.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/7264ad8b14f379a7a548025b066f4e74f0e245f1ec43e8f2dc2bffcee71d89a5.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田佳代","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1337:135051:6038:1","source":"bangumi"}]},{"characterId":"char_c82636","characterName":"春日 尚樹","sourceIds":{"bangumi":[{"characterId":"48448","match":"exact-normalized-name-in-linked-work","subjectId":"1337"}],"egsCharacterIds":["26748"],"vndbCharacterId":"c82636"},"originalCharacterName":"春日 尚樹","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"商店街の中にある電器屋『春日デンキ』の若き店主。"},{"spoiler":false,"text":"わかばや椿にとっては、やや年の離れた（困った）兄貴的な存在。"},{"spoiler":false,"text":"兵器や戦史関係に異常なほど詳しい、知識系軍事ヲタ。"},{"spoiler":false,"text":"店内にイタリア海軍の軍艦（模型）をレイアウトしては、一人で悦に浸っている。"},{"spoiler":false,"text":"『華の湯』の大きな浴槽に、栄光の連合艦隊（マヴチモーター付）を浮かべることが夢。"},{"spoiler":false,"text":"その口から出る言葉は、常人には理解不能な専門用語が大半を占める。"},{"spoiler":false,"text":"口癖である「それはそうと～」が出ると、人格が変わる危険サイン。"},{"spoiler":false,"text":"「他国に比べて抜きんでてあか抜けたデザイン！！"},{"spoiler":false,"text":"まさに地中海の女王！！"},{"spoiler":false,"text":"ヴィットリオ・ヴェネト級は史上最高の戦艦だよ」"}],"source":"egs","sourceCharacterId":"26748","sourceWorkId":"4497","spoiler":false},{"segments":[{"spoiler":false,"text":"白摘茶房の隣、ゆのはな町唯一の電器店・春日デンキを営む、若い店主。"},{"spoiler":false,"text":"茶髪のショートヘアー。強度の近視で、いつも小ぶりの眼鏡をかけている。見かけは好青年。インドアタイプで体力はあまりない。"},{"spoiler":false,"text":"実は大変な艦船マニア。「それはそうと」といった言葉が出たら、延々とイタリア艦隊の話が続くので、要注意である。"},{"spoiler":false,"text":"華の湯の湯船に戦艦のプラモデルを多数浮かべて戦闘風景の再現をしたがっているが、わかばにいつも却下されている。"},{"spoiler":false,"text":"穂波をイベントへ連れ出して軍服を着せ、売り子の「提督たん」をさせるという野望を持っている。"}],"source":"bangumi","sourceCharacterId":"48448"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49742c7d22fbc06da2bcba8a1a6e7cf3c0b000cd0e0b4a74d382bb7d36e1d713.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c4e7125385fed768d8b1366dba1d6cdec1ed46b556046ad3bf54007ec9bbecb.webp","width":148,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鈴木千尋","creatorId":"vndb:s182","sourcePersonId":"vndb:s182","canonicalEntityId":"vndb:s182","name":"鈴木 千尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1337:48448:3903:1","source":"bangumi"}]},{"characterId":"char_vndb_c82633","characterName":"草津 拓也","sourceIds":{"vndbCharacterId":"c82633"},"originalCharacterName":"草津 拓也","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d13957b2b8b40bdab918bbad0aefa39f5c8c47d70251c20b24da66352427668f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7980484929b646cd0b87d82ceadb9de4cd53111ccb6717570d6fb6c85c4e43d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c82637","characterName":"ヘンリー三世","sourceIds":{"vndbCharacterId":"c82637"},"originalCharacterName":"ヘンリー三世","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Itou family cat, he is a white cat with a red collar. He was named after Wakaba's grandfather."},{"spoiler":false,"text":"In Haruna, Calls him \"Shiro\" (しろ), and Naoki calls him \"Marshal Padlio\" (パドリオ元帥)."},{"spoiler":false,"text":"The boss cat in Yunohana town."}],"source":"vndb","sourceCharacterId":"c82637"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[{"creditedName":"萌原 ぷりん","creatorId":"vndb:s2339","sourcePersonId":"vndb:s2339","canonicalEntityId":"vndb:s2339","name":"萌原ぷりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:212","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p76","sourceCompanyId":"egs:brand:689","canonicalEntityId":"vndb:p76","name":"PULLTOP","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:4497:689","source":"egs"},{"companyId":"vndb:p76","sourceCompanyId":"vndb:p76","canonicalEntityId":"vndb:p76","name":"PULLTOP","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:130712:v16","source":"vndb"},{"companyId":"vndb:p224","sourceCompanyId":"vndb:p224","canonicalEntityId":"vndb:p224","name":"mints","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:130713:v16","source":"vndb"},{"companyId":"vndb:p76","sourceCompanyId":"vndb:p76","canonicalEntityId":"vndb:p76","name":"PULLTOP","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:17619:v16","source":"vndb"},{"companyId":"vndb:p408","sourceCompanyId":"vndb:p408","canonicalEntityId":"vndb:p408","name":"팀 우타마루","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:2166:v16","source":"vndb"},{"companyId":"vndb:p76","sourceCompanyId":"vndb:p76","canonicalEntityId":"vndb:p76","name":"PULLTOP","roleCodes":["developer","publisher"],"id