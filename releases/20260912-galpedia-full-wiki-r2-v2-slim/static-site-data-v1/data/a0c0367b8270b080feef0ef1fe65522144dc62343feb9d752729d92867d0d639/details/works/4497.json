","relationId":"egs:work-creator:230968","source":"egs"},{"creditedName":"椎名治美","creatorId":"egs:creator:9142","sourcePersonId":"egs:creator:9142","canonicalEntityId":"egs:creator:9142","name":"椎名治美","roleCode":"music","roleLabel":"作品音乐","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:44562","source":"egs"},{"creditedName":"NoBrand Sounds(ノーブランドサウンズ、雑音工房NOISE)","creatorId":"vndb:s1585","sourcePersonId":"egs:creator:2668","canonicalEntityId":"vndb:s1585","name":"NoBrand Sounds(ノーブランドサウンズ、雑音工房NOISE)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:8090","source":"egs"}],"other":[{"creditedName":"椎原旬","creatorId":"vndb:s1704","sourcePersonId":"egs:creator:620","canonicalEntityId":"vndb:s1704","name":"椎原旬","detail":"プロデュース、シナリオアシスト、演出","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:109758","source":"egs"},{"creditedName":"十睡みちたか","creatorId":"vndb:s4490","sourcePersonId":"egs:creator:15662","canonicalEntityId":"vndb:s4490","name":"十睡みちたか","detail":"シナリオアシスト","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:226306","source":"egs"},{"creditedName":"RMG(Rainbow-Motion-Graphics)","creatorId":"vndb:s2828","sourcePersonId":"egs:creator:12859","canonicalEntityId":"vndb:s2828","name":"RMG(Rainbow-Motion-Graphics)","detail":"OPムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:68249","source":"egs"},{"creditedName":"原田ひとみ","creatorId":"vndb:s1116","sourcePersonId":"egs:creator:10182","canonicalEntityId":"vndb:s1116","name":"原田ひとみ","detail":"OP曲「冬だより」、ED曲「約束 ～resume～」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:74590","source":"egs"},{"creditedName":"朝妻ユタカ","creatorId":"vndb:s4472","sourcePersonId":"egs:creator:15666","canonicalEntityId":"vndb:s4472","name":"朝妻ユタカ","detail":"企画・ディレクション、演出","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:99493","source":"egs"},{"creditedName":"原田 ひとみ","creatorId":"vndb:s1116","sourcePersonId":"vndb:s1116","canonicalEntityId":"vndb:s1116","name":"原田 ひとみ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:1049","source":"vndb"},{"creditedName":"椎原 旬","creatorId":"vndb:s1704","sourcePersonId":"vndb:s1704","canonicalEntityId":"vndb:s1704","name":"椎原 旬","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:1053","source":"vndb"},{"creditedName":"たけや まさみ","creatorId":"vndb:s2183","sourcePersonId":"vndb:s2183","canonicalEntityId":"vndb:s2183","name":"たけや まさみ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:1054","source":"vndb"},{"creditedName":"下原 正","creatorId":"vndb:s2184","sourcePersonId":"vndb:s2184","canonicalEntityId":"vndb:s2184","name":"下原 正","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:1055","source":"vndb"},{"creditedName":"藤原々々","creatorId":"vndb:s2289","sourcePersonId":"vndb:s2289","canonicalEntityId":"vndb:s2289","name":"藤原々々","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:1056","source":"vndb"},{"creditedName":"夏 椿","creatorId":"vndb:s3579","sourcePersonId":"vndb:s3579","canonicalEntityId":"vndb:s3579","name":"夏椿","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:1058","source":"vndb"},{"creditedName":"朝妻 ユタカ","creatorId":"vndb:s4472","sourcePersonId":"vndb:s4472","canonicalEntityId":"vndb:s4472","name":"朝妻 ユタカ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:1059","source":"vndb"},{"creditedName":"朝妻 ユタカ","creatorId":"vndb:s4472","sourcePersonId":"vndb:s4472","canonicalEntityId":"vndb:s4472","name":"朝妻 ユタカ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:1060","source":"vndb"},{"creditedName":"RMG","creatorId":"vndb:s2828","sourcePersonId":"vndb:s2828","canonicalEntityId":"vndb:s2828","name":"RMG Rainbow-Motion-Graphics","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:1063","source":"vndb"}]},"cast":[{"characterId":"char_c27960","characterName":"ゆのは","sourceIds":{"bangumi":[{"characterId":"11341","match":"exact-normalized-name-in-linked-work","subjectId":"1337"}],"egsCharacterIds":["26740"],"vndbCharacterId":"c27960"},"originalCharacterName":"ゆのは","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Self-proclaimed goddess of Yunohana Town. Pretends to be the protagonist's sister."}],"source":"vndb","sourceCharacterId":"c27960"},{"segments":[{"spoiler":false,"text":"『ゆのはな町』に棲む自称\"土地神さま\"。"},{"spoiler":false,"text":"巫女装束のような珍妙な格好をしているが霊感の無い者には普通の服装に見える。"},{"spoiler":false,"text":"名目上は拓也の妹ということになっており、監視と称して何かと付きまとってくる。"},{"spoiler":false,"text":"一見すると素直で天真爛漫に見えるが、その実態はアコギな守銭奴。"},{"spoiler":false,"text":"その口調こそ丁寧だが、さりげなくドギツい言葉を会話の端々に織り交ぜたりする。"},{"spoiler":false,"text":"賽銭箱型の貯金箱を持ち歩いており、拓也がバイトで得た賃金を問答無用で徴収していく。"},{"spoiler":false,"text":"貯まったお金の音を聞くのが何よりの楽しみ。"},{"spoiler":false,"text":"世知辛い現代を生き抜くために、ギブアンドテイクを信条としている。"},{"spoiler":false,"text":"特技は嘘泣きと三文芝居。"},{"spoiler":false,"text":"『冬を司る』神さまだと名乗っている割には、寒さが大の苦手であり、コタツの中でゴロゴロしたり、お風呂に入ることが大好き。"},{"spoiler":false,"text":"「この世にお金で買えないものなんてありません。"},{"spoiler":false,"text":"神さまのわたしが言うんだから間違いありません！」"}],"source":"egs","sourceCharacterId":"26740","sourceWorkId":"4497","spoiler":false},{"segments":[{"spoiler":false,"text":"自称是栖息在『ゆのはな町』的“土地神大人”。"},{"spoiler":false,"text":"穿着一身类似巫女装束的稀奇古怪的打扮，但没有灵感的人看上去只是普通的服装。"},{"spoiler":false,"text":"名义上算是拓也的妹妹，以监视为幌子老是缠着他。"}],"source":"bangumi","sourceCharacterId":"11341"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/138326b034a67d1ce40a8db1d3eb3a4e115eb9f168f23218702688ef60fafa96.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5f959c51d60bb036121c358c17a53aeac63e08610fdc99e552617a490dfaac3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"島村香織","creatorId":"vndb:s1070","sourcePersonId":"vndb:s1070","canonicalEntityId":"vndb:s1070","name":"島村 香織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1337:11341:5938:1","source":"bangumi"}]},{"characterId":"char_c27961","characterName":"伊東 わかば","sourceIds":{"bangumi":[{"characterId":"11342","match":"exact-normalized-name-in-linked-work","subjectId":"1337"}],"egsCharacterIds":["26741"],"vndbCharacterId":"c27961"},"originalCharacterName":"伊東 わかば","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"商店街の中にある、銭湯『華の湯』の孫娘。"},{"spoiler":false,"text":"両親は仕事の関係で海外に在住していて、祖母のみつ枝と二人暮で暮らし。"},{"spoiler":false,"text":"いかにも女の子な外見ではあるが、受付から清掃まで銭湯の仕事は何でもこなす。"},{"spoiler":false,"text":"普段は番台に座って本を読んでいることが多い。"},{"spoiler":false,"text":"誰にでも優しく穏やかな性格で、ほんわかとした微笑みがトレードマーク。"},{"spoiler":false,"text":"その場にいるだけで、周囲の空気を和ませてしまう存在。"},{"spoiler":false,"text":"ケーキよりも大福、流行のドラマより時代劇と、妙に年寄りじみた趣味を持つ。"},{"spoiler":false,"text":"将来の夢は絵本作家になることだが、怪獣が叫び声だけで会話するなど、その内容は他人に理解できないようなものが多い。"},{"spoiler":false,"text":"何かといえば、自分の描いた絵本で物事を説明しようとする癖がある。"},{"spoiler":false,"text":"『ゆのはな商店街』のマスコットキャラをデザインしたりもしている。"},{"spoiler":false,"text":"「朝ですよ。ラヂオ体操の時間ですよ」"}],"source":"egs","sourceCharacterId":"26741","sourceWorkId":"4497","spoiler":false},{"segments":[{"spoiler":false,"text":"位于商店街的澡堂『華の湯』的孙女。"},{"spoiler":false,"text":"双亲因为工作关系在海外居住，和祖母みつ枝两个人生活。"},{"spoiler":false,"text":"外貌很有少女气质，然而从接待客人到清扫以致澡堂活儿无所不能。"},{"spoiler":false,"text":"平时常常坐在收费台看书。"},{"spoiler":false,"text":"待人和善性格稳重，温和的微笑具有独特的魅力。"},{"spoiler":false,"text":"只要置身其地就能让周围气氛和睦下来的存在。"}],"source":"bangumi","sourceCharacterId":"11342"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a359b05858e644ec49f82db646d5ae583932f649cead0009d3c400c492f73128.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c9953a270d1aba0553bc5d1407d26269bf0813a863cc7332c09c396d1b52462.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"生田 香織","creatorId":"vndb:s1423","sourcePersonId":"vndb:s1423","canonicalEntityId":"vndb:s1423","name":"長谷 優里奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:211","source":"vndb"}]},{"characterId":"char_c27963","characterName":"桂沢 穂波","sourceIds":{"bangumi":[{"characterId":"11343","match":"exact-normalized-name-in-linked-work","subjectId":"1337"}],"egsCharacterIds":["26743"],"vndbCharacterId":"c27963"},"originalCharacterName":"桂沢 穂波","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"商店街の中にある喫茶店『白摘茶房（しろつめさぼう）』の娘。"},{"spoiler":false,"text":"『白摘茶房』では、ウエイトレスの手伝いをしている。"},{"spoiler":false,"text":"母親の榛名（はるな）とは、母娘というより姉妹のような接し方をしており、憧憬の念を抱いている。"},{"spoiler":false,"text":"店を閉めた後に、榛名の炒れてくれたコーヒーを飲みながら雑談することが楽しみ。"},{"spoiler":false,"text":"口数が少ないためにクールな印象を与えがちだが、実は好奇心旺盛な性格。"},{"spoiler":false,"text":"礼儀正しく口調も丁寧なため、少し大人びた雰囲気を漂わせている。"},{"spoiler":false,"text":"自分の気持ちをストレートに語るよりも「～なのです」という解説口調を好んで使うが、心を許して内面を語るときなどは、「～なんです」とくだけた感じになる。"},{"spoiler":false,"text":"早くに父親を亡くしているため、商店街の皆のことを家族のように思っている。"},{"spoiler":false,"text":"また、わかばや椿も、穂波のことを妹のように可愛がっている。"},{"spoiler":false,"text":"わかばの描く絵本の数少ない理解者の一人である。"},{"spoiler":false,"text":"幼い頃より霊感が強く、みんなには見えないモノが見える。"},{"spoiler":false,"text":"ゆのはの招待についても薄々気付いており、拓也とセットで興味を抱いている。"},{"spoiler":false,"text":"「コーヒーには、お砂糖を入れない派なのです」"}],"source":"egs","sourceCharacterId":"26743","sourceWorkId":"4497","spoiler":false},{"segments":[{"spoiler":false,"text":"位于商店街的饮茶店『白摘茶房（しろつめさぼう）』的女儿。"},{"spoiler":false,"text":"在『白摘茶房』帮手做女侍。"},{"spoiler":false,"text":"和母亲榛名（はるな）与其说是母女，不如说像是姐妹一般相处，对她怀有憧憬之感。"},{"spoiler":false,"text":"关门以后，一边品尝着榛名冲泡的咖啡一边拉扯些家长里短是乐趣所在。"},{"spoiler":false,"text":"因为话不多的关系常给人冷漠的印象，但其实是好奇心旺盛的性格。"}],"source":"bangumi","sourceCharacterId":"11343"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/ddf4c809b01c24ea1d24c1511c8045cd139545227ec69fcfd4b727276fa14660.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/315ba9ad318d5a8be75b10f1c538b415bd5a24197fc91ddda340a40b7b5f56c0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1337:11343:4689:1","source":"bangumi"}]},{"characterId":"char_c27964","characterName":"高尾 椿","sourceIds":{"bangumi":[{"characterId":"11344","match":"exact-normalized-name-in-linked-work","subjectId":"1337"}],"egsCharacterIds":["26742"],"vndbCharacterId":"c27964"},"originalCharacterName":"高尾 椿","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"商店街の中にある酒屋『高尾酒店』の娘。"},{"spoiler":false,"text":"わかばとは幼馴染にあたり、子供の頃から近所のお姉さんとして頼られている。"},{"spoiler":false,"text":"喧嘩っ早い上に言葉遣いも乱暴だが、サバサバしてきっぷの良い姐さん。"},{"spoiler":false,"text":"母親を幼い頃に失っており、気の弱い父を助けて店を切り回している。"},{"spoiler":false,"text":"基本的に困っている者を見ると放っておけない世話焼きタイプなので、何だかんだと言いながらも拓也とゆのはの面倒を見てやっている。"},{"spoiler":false,"text":"店の隅には立ち飲みできる一角（角打ち）もあり、常連の愛すべき酔っ払い親父たちを相手に談笑していることが多い。"},{"spoiler":false,"text":"酒を飲むことは大好きなのだが、アルコールに弱い体質なので直に寝てしまう。"},{"spoiler":false,"text":"店の仕事が終わると、部屋に篭ってこっそりと小説や詩を書いている。"},{"spoiler":false,"text":"その内容は、豪快かつ大胆な性格とは裏腹に、繊細な文体による可憐なものが多い。"},{"spoiler":false,"text":"暇潰しのつもりで書いていた小説が本となり、さらに予想外の人気作となってしまった。"},{"spoiler":false,"text":"今ではローティーン向け恋愛小説家という副業を持っているが、普段の言動とのギャップが激しいためにトップシークレット扱いとなっている。"},{"spoiler":false,"text":"「それが終わらなきゃ、今日の賃金は払えないねえ～」"}],"source":"egs","sourceCharacterId":"26742","sourceWorkId":"4497","spoiler":false},{"segments":[{"spoiler":false,"text":"位于商店街的酒店『高尾酒店』的女儿。"},{"spoiler":false,"text":"和わかば是青梅竹马的关系，从小时候开始就作为邻居大姐姐被信赖着。"},{"spoiler":false,"text":"喜欢以武服人，说话也很粗鲁，不过是个豪爽干脆的好大姐。"},{"spoiler":false,"text":"强势的性格遗传自祖父，毫不客气地使唤着前来打工的拓也。"},{"spoiler":false,"text":"在小时候失去了母亲，帮助弱气的父亲经营着店铺。"},{"spoiler":false,"text":"基本上是看到有困难的人没法放下不管的爱管闲事的类型，好说歹说还是有在关照拓也和ゆのは。"},{"spoiler":false,"text":"和ゆのは不知为啥貌似波长很合得来，这对拓也来说则成为了烦恼的根源。"}],"source":"bangumi","sourceCharacterId":"11344"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b764775fb6cff5e4541add8cf945b4077828bc14e89c792840098997f5a071bb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70d0d58ff373e5ac1f95147f86c825f551b989fbfbbe9f5dff0aaf36fb933c38.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1337:11344:4832:1","source":"bangumi"}]},{"characterId":"char_c82621","characterName":"宇奈月 由真","sourceIds":{"bangumi":[{"characterId":"11345","match":"exact-normalized-name-in-linked-work","subjectId":"1337"}],"egsCharacterIds":["26744"],"vndbCharacterId":"c82621"},"originalCharacterName":"宇奈月 由真","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ゆのはな町に古くからある旧家の一人娘。"},{"spoiler":false,"text":"良くも悪くも自分に正直な性格であり、思ったことは何でもはっきりと口にする。"},{"spoiler":false,"text":"思い込みが激しく、勝手に空想（妄想）を膨らませて暴走することも多々あり。"},{"spoiler":false,"text":"生意気な上に毒舌家だが、空回りすることの方が多いので皆から適当にあしらわれている。"},{"spoiler":false,"text":"特に椿からは、名前を『まゆ』と逆さまに呼ばれるなど完全にオモチャ扱いされており、どちらかといえば弄られ系のキャラにされている。"},{"spoiler":false,"text":"わかばとはクラスメートにあたり、性格から何から正反対であるものの、何故か仲は良い。"},{"spoiler":false,"text":"本人はわかばの保護者気取りでいるので、わかばに関することには、やたらと口を出したり世話を焼いたりしようとする。"},{"spoiler":false,"text":"その本心は単なる友情というより、恋愛感情に近いものがあるのだが、割と露骨なアプローチであるにもかかわらず、わかば本人は全く気付いていない。"},{"spoiler":false,"text":"わかばの家に居候している拓也とゆのは（特に拓也）のことを、「わかばに付いた悪い虫」と一方的にライバル視しており、わかばから引き離そうとして何かと間に割って入ってくる。"}],"source":"egs","sourceCharacterId":"26744","sourceWorkId":"4497","spoiler":false},{"segments":[{"spoiler":false,"text":"ゆのはな町自古已有的世家的独生女。"},{"spoiler":false,"text":"不管咋说都是对自己很老实的性格，想到就说心直口快。"},{"spoiler":false,"text":"极易钻牛角尖，老是自顾自在那里无限膨胀空想（妄想）然后暴走。"},{"spoiler":false,"text":"不仅神气活现而且还是个毒舌家，不过因为基本上都是在空忙活，被大家随便地应付着。"}],"source":"bangumi","sourceCharacterId":"11345"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b4781e8b57b40192a1b63658aecb1eefc70abe765ef9a37f864448a178d4e74.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b9008e8e2800884a477d428b06d730f9cd6bf05f912547a1765fbec4ec9e3f6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:1337:11345:6036:1","source":"bangumi"}]},{"characterId":"char_c82622","characterName":"マスター","sourceIds":{"bangumi":[{"characterId":"135052","match":"exact-normalized-name-in-linked-work","subjectId":"1337"}],"egsCharacterIds":["26745"],"vndbCharacterId":"c82622"},"originalCharacterName":"マスター","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"穂波の母であり、喫茶店『白摘茶房』の店主。"},{"spoiler":false,"text":"夫とは早くに死別しており、元々は夫が開いていた店を継ぐ形で続けている。"},{"spoiler":false,"text":"何故かママと呼ばれることを嫌っており、店ではマスターと名乗っている。"},{"spoiler":false,"text":"常に落ち着いた雰囲気を漂わせており、メガネの似合う知的な女性といった印象を与える。"},{"spoiler":false,"text":"基本的にはほのぼの系。いつもおっとりした態度だが、娘同様に優れた洞察力の持ち主。"},{"spoiler":false,"text":"「あらあらまぁまぁ、どうしましょう。"},{"spoiler":false,"text":"そんなの誉められても困りますわぁ」"}],"source":"egs","sourceCharacterId":"26745","sourceWorkId":"4497","spoiler":false},{"segments":[{"spoiler":false,"text":"穂波の母であり、喫茶店『白摘茶房』の店主。"},{"spoiler":false,"text":"夫とは早くに死別しており、元々は夫が開いていた店を継ぐ形で続けている。"},{"spoiler":false,"text":"何故かママと呼ばれることを嫌っており、店ではマスターと名乗っている。"},{"spoiler":false,"text":"常に落ち着いた雰囲気を漂わせており、メガネの似合う知的な女性といった印象を与える。"},{"spoiler":false,"text":"基本的にはほのぼの系。いつもおっとりした態度だが、娘同様に優れた洞察力の持ち主。"},{"spoiler":false,"text":"「あらあらまぁまぁ、どうしましょう。"},{"spoiler":false,"text":"そんなの誉められても困りますわぁ」"}],"source":"bangumi","sourceCharacterId":"135052"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6e48b5eccf791faae11fa9e5ef77da793e35966c1dabe1e63f9590f5e22bbd7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c7