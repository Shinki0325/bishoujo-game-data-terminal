iler":false},{"segments":[{"spoiler":false,"text":"芸能の才を認められ、特待生として櫻乃杜学園に籍を置く少女。"},{"spoiler":false,"text":"国民的アイドルグループ “ノワール・フルール” のエース。"},{"spoiler":false,"text":"美しい容姿と高い歌唱力、そして独特のキャラクターから多くのファンを持つ。"},{"spoiler":false,"text":"性格はまじめの一言に尽き、曲がったことは決して許さない。"},{"spoiler":false,"text":"礼儀は正しいが、愛想を振りまくこともなく他のアイドルと一線を画している。"},{"spoiler":false,"text":"学生の本分が学業と考えており、学園生活を最優先にしている。"},{"spoiler":false,"text":"そのため芸能活動は放課後、または週末限定としている。"},{"spoiler":false,"text":"「アイドルだからといって特別扱いはしないでください。 互いに特待生としてみんなの規範になれるよう精進に励みましょう」"}],"source":"bangumi","sourceCharacterId":"45244"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"45244","value":"舞台鑑賞"},{"label":"学年","source":"bangumi","sourceCharacterId":"45244","value":"1年"},{"label":"苦手なもの","source":"bangumi","sourceCharacterId":"45244","value":"妥協と手抜き"},{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"11183","sourceWorkId":"23952","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"11183","sourceWorkId":"23952","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"149 cm","valueContext":null,"source":"egs","sourceCharacterId":"11183","sourceWorkId":"23952","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"11183","sourceWorkId":"23952","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"11183","sourceWorkId":"23952","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f81c9f6981f27aa22b72d83157473f9de53c2fd32318b99e6b1fef1e4db37dce.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/784712d195708a5416896a9f010b6b87bdb9a7dc6304e981f847f8929f850203.webp","width":213,"height":256,"source":"static-detail"}