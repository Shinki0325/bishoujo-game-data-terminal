{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"12727","model":{"presentationWorkId":"vndb:v2214","staff":{"artwork":[{"creditedName":"鋼丸(鋼丸R、鋼丸S、鋼丸SS)","creatorId":"vndb:s6952","sourcePersonId":"egs:creator:444","canonicalEntityId":"vndb:s6952","name":"鋼丸(鋼丸R、鋼丸S、鋼丸SS)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:78885","source":"egs"}],"scenario":[{"creditedName":"里井捧","creatorId":"vndb:s39991","sourcePersonId":"egs:creator:13999","canonicalEntityId":"vndb:s39991","name":"里井捧","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:78886","source":"egs"}],"music":[{"creditedName":"TOSHI","creatorId":"vndb:s8325","sourcePersonId":"egs:creator:25572","canonicalEntityId":"vndb:s8325","name":"TOSHI","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:245550","source":"egs"},{"creditedName":"深雪まな","creatorId":"vndb:s3801","sourcePersonId":"egs:creator:20535","canonicalEntityId":"vndb:s3801","name":"深雪まな","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:245551","source":"egs"}],"other":[{"creditedName":"株式会社ワームスエンタテイメント(QLIE.net)","creatorId":"egs:creator:20329","sourcePersonId":"egs:creator:20329","canonicalEntityId":"egs:creator:20329","name":"株式会社ワームスエンタテイメント(QLIE.net)","detail":"スクリプトエンジン QLiE","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:125728","source":"egs"}]},"cast":[{"characterId":"char_c23770","characterName":"牧野 遥","sourceIds":{"bangumi":[{"characterId":"31704","match":"exact-normalized-name-in-linked-work","subjectId":"59893"}],"egsCharacterIds":["15031"],"vndbCharacterId":"c23770"},"originalCharacterName":"牧野 遥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【妹達を引っ張っていく、スタイル抜群の娘】"},{"spoiler":false,"text":"長女。学園3年生。明るくて元気。"},{"spoiler":false,"text":"どこか抜けているが、「なんとかなるなるー！」という持ち前の勢いで妹たちを引っ張っていく。"},{"spoiler":false,"text":"いい加減であっけらかんとした性格。"},{"spoiler":false,"text":"ファミレスでバイトをして、家計を助けている。妹想いの性格。"},{"spoiler":false,"text":"スタイルが良くて巨乳。勉強は普通進学したいが、家計的に就職しないとならないかな……と密かに悩んでいる。"},{"spoiler":false,"text":"「お疲れのお父さんにこれ、ビール！」"}],"source":"egs","sourceCharacterId":"15031","sourceWorkId":"12727","spoiler":false},{"segments":[{"spoiler":false,"text":"长女。学园3年级学生。明朗的元气少女。"},{"spoiler":false,"text":"身材高挑、巨乳，属于御姐类型。"},{"spoiler":false,"text":"有点小毛病，会说着“可能会如何如何”这样的拉着妹妹们走。"},{"spoiler":false,"text":"有着草率、而且无论发生什么都若无其事的性格。"},{"spoiler":false,"text":"在家庭餐馆打工补贴家用（店长是好人让她把临近保质期的食物带回家）"},{"spoiler":false,"text":"同时也有着想保护妹妹们的性格。学习方面普通。"},{"spoiler":false,"text":"想升学但是只能做和家庭有关的工作，一个人为这个而悄悄的烦恼着。"}],"source":"bangumi","sourceCharacterId":"31704"}],"profileFacts":[{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"15031","sourceWorkId":"12727","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"15031","sourceWorkId":"12727","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"15031","sourceWorkId":"12727","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"15031","sourceWorkId":"12727","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9cfcc8173707fa50450aa942e1237e08b283500e9c046b65854a986e22572d3d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12e3616e0c66c6d9affabfed33d84ad6930fbd63528115781b41a6d947bbba29.webp","width":184,"height":204,"source":"static-detail"},"actors":[{"creditedName":"計名 さや香","creatorId":"vndb:s859","sourcePersonId":"vndb:s859","canonicalEntityId":"vndb:s859","name":"かずなさやか(計名さや香)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:17492","source":"vndb"}]},{"characterId":"char_c23771","characterName":"牧野 棗","sourceIds":{"bangumi":[{"characterId":"31705","match":"exact-normalized-name-in-linked-work","subjectId":"59893"}],"egsCharacterIds":["15032"],"vndbCharacterId":"c23771"},"originalCharacterName":"牧野 棗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"73"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"68"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【剣道部所属で身長の低い、気の強い娘】"},{"spoiler":false,"text":"次女。学園2年生。気が強い性格。剣道部所属。"},{"spoiler":false,"text":"三女と双子の姉妹だが、背が四姉妹で一番小さく胸も貧弱。"},{"spoiler":false,"text":"毎朝牛乳1リットル飲んでいるが一向に背が伸びない。"},{"spoiler":false,"text":"おしゃれな服装をしたいのに、子供っぽい服しか着られないのが悩ましい。"},{"spoiler":false,"text":"身体は小さいが運動は得意。勉強は苦手で携帯電話が欲しいけど買ってもらえない。"},{"spoiler":false,"text":"交通事故後、父親からの視線がオカシイと気づきかけている。"},{"spoiler":false,"text":"「はぁ、また来たの？　弁当ぐらい一人で食べなさいよ」"}],"source":"egs","sourceCharacterId":"15032","sourceWorkId":"12727","spoiler":false},{"segments":[{"spoiler":false,"text":"次女。学园2年级学生。气势强的剑道部部员。"},{"spoiler":false,"text":"虽然和3女是双胞胎姐妹，但是在4姐妹中个子最矮，贫乳。"},{"spoiler":false,"text":"个性毒舌，但其实很为姐妹们着想，属于傲娇类型。"},{"spoiler":false,"text":"虽然坚持每天早晨喝一升牛奶，但是依旧长不高。"},{"spoiler":false,"text":"因为想穿华丽的衣服，而对自己只能穿小孩衣服的事十分苦恼。"},{"spoiler":false,"text":"身材娇小但擅长运动。学习不好所以虽然很想要个手机也不被准许。"},{"spoiler":false,"text":"在那次交通事故后，注意到父亲的眼神变得奇怪。"},{"spoiler":false,"text":"在OVA中被父亲欺骗说是养女。"}],"source":"bangumi","sourceCharacterId":"31705"}],"profileFacts":[{"label":"胸围（本版本）","value":"73 cm","valueContext":null,"source":"egs","sourceCharacterId":"15032","sourceWorkId":"12727","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"145 cm","valueContext":null,"source":"egs","sourceCharacterId":"15032","sourceWorkId":"12727","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"68 cm","valueContext":null,"source":"egs","sourceCharacterId":"15032","sourceWorkId":"12727","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"51 cm","valueContext":null,"source":"egs","sourceCharacterId":"15032","sourceWorkId":"12727","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/169fe75d44b9e415a7244d51525137d23d52ddc3a31319eaced33ac0fdc4ab9b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6fa89c86165d18746c893fc0b2531fa2bfbadeb1a3519e5f5a7e14792f2e3f4.webp","width":175,"height":201,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:59893:31705:6106:1","source":"bangumi"}]},{"characterId":"char_c23772","characterName":"牧野 晶","sourceIds":{"bangumi":[{"characterId":"31706","match":"exact-normalized-name-in-linked-work","subjectId":"59893"}],"egsCharacterIds":["15033"],"vndbCharacterId":"c23772"},"originalCharacterName":"牧野 晶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【料理が得意で勉強もできる、しっかり者のおとなしい娘】"},{"spoiler":false,"text":"三女。学園2年生。帰宅部。"},{"spoiler":false,"text":"おとなしい性格で中肉中背だが、オッパイは大きめ。"},{"spoiler":false,"text":"料理が得意。台所番。"},{"spoiler":false,"text":"勉強は得意で予習復習は欠かさない。しっかり者で責任感も強い。"},{"spoiler":false,"text":"オナニーっ娘で毎夜、就寝前に密かに行なっている。"},{"spoiler":false,"text":"「もう、子供っぽいんだから…お帰りなさい」"}],"source":"egs","sourceCharacterId":"15033","sourceWorkId":"12727","spoiler":false},{"segments":[{"spoiler":false,"text":"性格沉稳、中等身材中等身高，胸部却很大。"},{"spoiler":false,"text":"回家部（就是没参加任何社团，放学后直接回家），因为擅长料理而经常在厨房里忙活。"},{"spoiler":false,"text":"是个很可靠的人，责任感也强。但对于父亲对姐妹们的所作所为有时会黑化，属于隐藏病娇类型。"},{"spoiler":false,"text":"学习好，一直有着复习和预习的习惯。"},{"spoiler":false,"text":"经常自慰，每晚睡觉前都会偷偷地进行。"}],"source":"bangumi","sourceCharacterId":"31706"}],"profileFacts":[{"label":"胸围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"15033","sourceWorkId":"12727","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"15033","sourceWorkId":"12727","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"15033","sourceWorkId":"12727","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"15033","sourceWorkId":"12727","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b90951d64