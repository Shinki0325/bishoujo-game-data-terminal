eCharacterId":"6199","sourceWorkId":"21403","spoiler":false},{"segments":[{"spoiler":false,"text":"前作でエクスティアへと変身して侵略者と闘い、退けた真理奈。"},{"spoiler":false,"text":"しかし新たな侵略者の罠に嵌ってしまい変身できなくなってしまう。"},{"spoiler":false,"text":"果たして再び戦えるようになるのか。"}],"source":"egs","sourceCharacterId":"6199","sourceWorkId":"22701","spoiler":false},{"segments":[{"spoiler":false,"text":"エクスティアとして異世界からの侵略に対して戦ってきたヒロイン。"},{"spoiler":false,"text":"心優しく、皆の為に戦う芯の強さをもっている。"},{"spoiler":false,"text":"少々やきもち焼きでもある。"},{"spoiler":false,"text":"主人公である創真の恋人であり、一緒の大学に通っている。"},{"spoiler":false,"text":"そろそろ将来のことについて考えたりしている。"}],"source":"egs","sourceCharacterId":"6199","sourceWorkId":"39845","spoiler":false},{"segments":[{"spoiler":false,"text":"黒髪ロングの才女で、主人公とは幼なじみ。"},{"spoiler":false,"text":"心優しく人当たりも良いので、同性異性問わず人気が高い。"},{"spoiler":false,"text":"健気で強い正義感を持っており、困っている人を放っておけない性分。"},{"spoiler":false,"text":"潜在能力の高さゆえ、エクスティアに変身して皆を守って戦うことになる。"}],"source":"bangumi","sourceCharacterId":"48209"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f950e3f5d15be4cb8786ea122557bf9dddd27913ed97fa36c0a83424eea149b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33ac0632a89226f5e3a040eca06da380b00f91d96abd64454caf330ba070553b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"葉村 夏緒","creatorId":"vndb:s24","sourcePersonId":"vndb:s24","canonicalEntityId":"vndb:s24","name":"西口 有香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73512","source":"vndb"}]},{"characterId":"char_c32435","characterName":"天久保 百合","sourceIds":{"bangumi":[{"characterId":"48211","match":"exact-normalized-name-in-linked-work","subjectId":"126145"},{"characterId":"48211","match":"exact-normalized-name-in-linked-work","subjectId":"149249"},{"characterId":"48211","match":"exact-normalized-name-in-linked-work","subjectId":"211904"}],"egsC