"Yirba","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:26007","source":"vndb"},{"creditedName":"BalistaFreak","creatorId":"vndb:s27611","sourcePersonId":"vndb:s27611","canonicalEntityId":"vndb:s27611","name":"Sherwood Lin","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:26008","source":"vndb"},{"creditedName":"杉菜 水姫","creatorId":"vndb:s19","sourcePersonId":"vndb:s19","canonicalEntityId":"vndb:s19","name":"青木 史生","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26009","source":"vndb"},{"creditedName":"珈琲 貴族","creatorId":"vndb:s92","sourcePersonId":"vndb:s92","canonicalEntityId":"vndb:s92","name":"珈琲 貴族","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:26010","source":"vndb"}]},"cast":[{"characterId":"char_c33041","characterName":"倉橋 結依","sourceIds":{"bangumi":[{"characterId":"31872","match":"exact-normalized-name-in-linked-work","subjectId":"24162"}],"egsCharacterIds":["15409"],"vndbCharacterId":"c33041"},"originalCharacterName":"倉橋 結依","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The daughter of a wealthy family, Yui is ignorant of the ways of the world. She doesn’t have any close friends (as she had no time to make any), but she has a relatively wide social circle at school. She rebels against her parents and runs out of her house, joining the Free Friends message board that a friend of hers told her about."},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c33041"},{"segments":[{"spoiler":false,"text":"裕福な家庭に育った世間知らずのお嬢様。"},{"spoiler":false,"text":"美人でスタイルもよく、学園では優等生で通っている。"},{"spoiler":false,"text":"クラスメイトたちとはそれなりの交流はあるが、気が置けない友人は居ない。"},{"spoiler":false,"text":"親が教育熱心で、ずいぶんと勉強をさせられ、ずっと嫌な思いをしてきた。今後の人生まで押し付けられ、自分を道具のように扱う親と喧嘩して家を飛び出す。"},{"spoiler":false,"text":"そして、友人に騙され「フリフレ」と呼ばれる出会い系掲示板に自分自身を登録してしまい……。"}],"source":"egs","sourceCharacterId":"15409","sourceWorkId":"12367","spoiler":false},{"segments":[{"spoiler":false,"text":"裕福な家に育ったお嬢様ゆえに世間知らず。"},{"spoiler":false,"text":"深い付き合いの友人は居ない（作る時間がなかった）がクラスメイト達とはそれなりに交流している。"},{"spoiler":false,"text":"親に反発し家を飛び出すが行く当てもなく、友人にだまされて『フリフレ』に登録。"},{"spoiler":false,"text":"結果として主人公に純潔を奪われてしまう…。"}],"source":"bangumi","sourceCharacterId":"31872"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d38dc88cc3289463377d1242e9ad568ff1a90fbc456c5747479c1d5b664ccea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f49e345436b73d29ec12c99c9ef735037dfee24d6651af281dbbec43ba373de.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:24162:31872:6016:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p625","sourceCompanyId":"egs:brand:2178","canonicalEntityId":"vndb:p625","name":"Noesis","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:12367:2178","source":"egs"},{"companyId":"vndb:p187","sourceCompanyId":"vndb:p187","canonicalEntityId":"vndb:p187","name":"アイチェリー","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:11733:v1541","source":"vndb"},{"companyId":"vndb:p6036","sourceCompanyId":"vndb:p6036","canonicalEntityId":"vndb:p6036","name":"プチチェリー","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:11734:v1541","source":"vndb"},{"companyId":"vndb:p