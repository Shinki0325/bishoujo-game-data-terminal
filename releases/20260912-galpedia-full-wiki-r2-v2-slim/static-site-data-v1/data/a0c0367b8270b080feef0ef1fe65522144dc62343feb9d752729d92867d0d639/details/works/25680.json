acterName":"黒川 真鈴","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An idol who debuted at the age of 12. Despite her average appearance, she used her E-cup sized boobs to gain popularity, and managed to raise to the top."},{"spoiler":false,"text":"However, in recent years and as Marin grew up her popularity started diminishing, and as she turned 18, she's become very desperate and worried about her future. This is the reason she wants to turn into a full-fledged artist."},{"spoiler":false,"text":"Marin is also a good singer and regularly takes lessons for it."}],"source":"vndb","sourceCharacterId":"c64154"},{"segments":[{"spoiler":false,"text":"Jrアイドルとして12歳でデビュー。"},{"spoiler":false,"text":"その透明感溢れる佇まいとは裏腹に、Eカップの巨乳を活かした大胆な内容で人気を博していた。"},{"spoiler":false,"text":"しかし、近年は人気が陰り気味。"},{"spoiler":false,"text":"Jrアイドルとしての未来に絶望しており、本格的アーティストへの転身を願っている。"},{"spoiler":false,"text":"歌が得意で、定期的にレッスンに通っている。"}],"source":"egs","sourceCharacterId":"17217","sourceWorkId":"25680","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a12f3b6a35612b4783190d306bdf7e1bc9f142529bbf7e87c4d4836e0c484b73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c46d0d3abb4105448f20e72717852135e0b4f91cd406a837c7e1fe399246666.webp","width":123,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永瀬蜜柑","creatorId":"vndb:s13630","sourcePersonId":"vndb:s13630","canonicalEntityId":"vndb:s13630","name":"永瀬蜜柑","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222107:56789:30882:1","source":"bangumi"}]},{"characterId":"char_c64155"