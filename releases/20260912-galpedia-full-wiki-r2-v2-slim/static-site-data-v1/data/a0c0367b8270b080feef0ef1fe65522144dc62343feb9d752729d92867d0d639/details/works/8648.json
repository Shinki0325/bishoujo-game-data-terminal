,{"creditedName":"みゅうか(内山美裕&辻優香)","creatorId":"egs:creator:20539","sourcePersonId":"egs:creator:20539","canonicalEntityId":"egs:creator:20539","name":"みゅうか(内山美裕&辻優香)","detail":"ED曲「メイド(おとめ)より愛をこめて」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"no-alias-hit","relationId":"egs:work-creator:127645","source":"egs"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:7128","source":"vndb"},{"creditedName":"歌恋","creatorId":"vndb:s33181","sourcePersonId":"vndb:s33181","canonicalEntityId":"vndb:s33181","name":"歌恋","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:7132","source":"vndb"}]},"cast":[{"characterId":"char_c50067","characterName":"芥葉 鞠音","sourceIds":{"bangumi":[{"characterId":"38014","match":"exact-normalized-name-in-linked-work","subjectId":"152371"}],"egsCharacterIds":["24057"],"vndbCharacterId":"c50067"},"originalCharacterName":"芥葉 鞠音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"4/4"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"O"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園の先輩メイドで従事科の3年生。"},{"spoiler":false,"text":"成績優秀、無遅刻無欠席、容姿端麗、家事全般なんでもござれの完璧超人で、“伝説のメイド”などと呼ばれているが、本人はいたってマイペース。"},{"spoiler":false,"text":"しかし、優秀なのはメイドスキルだけで、それ以外は……察してください、というほどへっぽこだったりする。"},{"spoiler":false,"text":"「メイドたるもの～」が口癖で、常に主のために準備を怠らないのが信条。"}],"source":"egs","sourceCharacterId":"24057","sourceWorkId":"8648","spoiler":false},{"segments":[{"spoiler":false,"text":"鳳翼学園従事科3年生。無遅刻無欠席、成績優秀、抜群のプロポーション、家事全般を自在にこなす完全無欠、優秀なメイドさん。 学園内では『伝説のメイド』なんて呼ばれているけど、極めてマイペースなおねーさん。"},{"spoiler":false,"text":"優秀なのはメイドの部分だけで、それ以外については結構へっぽこ。例えば、絵を描いたり、歌ったりっていうのは……お察しください。しかも本人は、それを自覚していないからタチが悪い。"},{"spoiler":false,"text":"「メイドたるもの～」が口癖で、常に主人のために準備を怠らないのが信条。例えば、「メイドたるもの、主人のために裁縫道具を持ち歩いているものですわ～」と言った次の瞬間には、どこからともなく裁縫道具を取り出したりもする。"},{"spoiler":false,"text":"実はどこかのお嬢様だったらしいという噂もちらほら……。"}],"source":"bangumi","sourceCharacterId":"38014"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"24057","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"24057","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"24057","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"24057","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"24057","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"48 kg","valueContext":null,"source":"egs","sourceCharacterId":"24057","sourceWorkId":"8648","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/5937b09520b0b5446454d60aa7e0ea2b076656b13b12d53a4b6f0673e93bb9aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/716018c0d4ce6bf1e32222d83e5f7ece0799704f21821495a829f9141d2c3cc2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"澤宮菜穂","creatorId":"vndb:s838","sourcePersonId":"vndb:s838","canonicalEntityId":"vndb:s838","name":"澤宮 菜穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:152371:38014:6019:1","source":"bangumi"}]},{"characterId":"char_c50080","characterName":"疾瀬 凛","sourceIds":{"bangumi":[{"characterId":"38013","match":"exact-normalized-name-in-linked-work","subjectId":"152371"}],"egsCharacterIds":["24056"],"vndbCharacterId":"c50080"},"originalCharacterName":"疾瀬 凛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"9/4"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"A"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイトにして、ルームメイト"},{"spoiler":false,"text":"成績優秀で極めて真面目な性格だが、頑固でいじっぱりなため、打たれ弱い一面をひた隠しにしている。"},{"spoiler":false,"text":"好きなものは可愛い物とチーズケーキ。だが、やはりこのこともひた隠し。"},{"spoiler":false,"text":"実は女の子なのだが、実家の規律で男装を強制されており、執事志望として、学園に通っている。"}],"source":"egs","sourceCharacterId":"24056","sourceWorkId":"8648","spoiler":false},{"segments":[{"spoiler":false,"text":"鳳翼学園2年生。執事志望の少年（？）。一也のクラスメイトであり、学生寮のルームメイト。"},{"spoiler":false,"text":"性格は極めて真面目で成績優秀だが、俗っぽい知識は皆無。自分が決めたことに関しては、頑固で意地っぱり。曲げることはない。 肉体的にも精神的にも攻撃されると打たれ弱い一面も持つが、本人はひた隠しにしている。"},{"spoiler":false,"text":"好きな物はかわいいもの全般と、チーズケーキだが、やはりこのこともひた隠し。"},{"spoiler":false,"text":"実は女の子であり、実家の規律で男装を強制されていて、執事志望として学園に潜りこんでいる。本人の意思としては男らしい執事よりも、女の子らしいメイドでありたいのだが、実家の規律を守らねばならないため、自分の意思は極力押し殺している。"},{"spoiler":false,"text":"「背が低くて悪かったな！ ボクは男だよ！」"}],"source":"bangumi","sourceCharacterId":"38013"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"24056","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"c","valueContext":null,"source":"egs","sourceCharacterId":"24056","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"24056","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"24056","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"24056","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"47 kg","valueContext":null,"source":"egs","sourceCharacterId":"24056","sourceWorkId":"8648","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2cef4abb6c0db43d00153ad75a2bb078ba87e2409081714c773f9ce56f2086d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/7317d8f877d3b9afa28eb4b50f7d51e87681e62f0a58373db1253687d19fb98d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高城みつ","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:152371:38013:6469:1","source":"bangumi"}]},{"characterId":"char_c50745","characterName":"天王寺 レイカ","sourceIds":{"bangumi":[{"characterId":"38015","match":"exact-normalized-name-in-linked-work","subjectId":"152371"}],"egsCharacterIds":["24058"],"vndbCharacterId":"c50745"},"originalCharacterName":"天王寺 レイカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"11/11"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"B"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"日本屈指の財閥“天王寺グループ”のご令嬢。"},{"spoiler":false,"text":"トレードマークはドリルツインテールヘアー。"},{"spoiler":false,"text":"つり目で強気、負けず嫌いの性格で、学力、運動能力もトップクラスの成績を維持している。"},{"spoiler":false,"text":"入学当初から、彼女の従者を希望する者は多いが、本人は、何事も自力で解決しようとする信念の持ち主なため、現在、執事の必要性を感じていない様子。"}],"source":"egs","sourceCharacterId":"24058","sourceWorkId":"8648","spoiler":false},{"segments":[{"spoiler":false,"text":"鳳翼学園上級科1年。日本屈指の財閥、天王寺グループの御令嬢。 ツインテドリルヘアーの女の子。つり目がちで強気。"},{"spoiler":false,"text":"世の中のことは独力で全てを解決できると思っており、現在、執事はつけていない。高いところから、人を見下ろすのが大好き。（精神的にも、物理的にも）"},{"spoiler":false,"text":"負けることが大嫌いで、学力・運動能力などは非常に高く、歴代の上級科でもトップクラスの成績を維持している。"},{"spoiler":false,"text":"実家が大財閥ということもあることから、入学当初から彼女の従者を希望する人間は数多いが、いまだ彼女のお眼鏡に適った者はいない。"},{"spoiler":false,"text":"本人は何事も自力で解決しようとする信念を持ち、また、今までもほぼ全ての事象を自力で解決してきたため、現在、執事の必要性を感じていないとのこと。主人公との初対面は最悪の部類で、あまりいい印象を持って貰えない。というか、かなり怒られる。"},{"spoiler":false,"text":"「言葉通りにしか動けない男の助けなんて必要ないですわ」"}],"source":"bangumi","sourceCharacterId":"38015"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"24058","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"152 cm","valueContext":null,"source":"egs","sourceCharacterId":"24058","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"24058","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"24058","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"44 kg","valueContext":null,"source":"egs","sourceCharacterId":"24058","sourceWorkId":"8648","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbbc08713e2716c7601732b66938fd99274adf4d64a23ba144c5cbf79ace918e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99d61eb3fbff44b2f6dd2cfaabeae4a57901405119ad79590a99378f862c8ff5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平松真奈実","creatorId":"vndb:s857","sourcePersonId":"vndb:s857","canonicalEntityId":"vndb:s857","name":"平松 真奈実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:152371:38015:19253:1","source":"bangumi"}]},{"characterId":"char_c50782","characterName":"藤堂 彩姫","sourceIds":{"bangumi":[{"characterId":"38016","match":"exact-normalized-name-in-linked-work","subjectId":"152371"}],"egsCharacterIds":["24059"],"vndbCharacterId":"c50782"},"originalCharacterName":"藤堂 彩姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"6/9"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"AB"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大和撫子天然系のお嬢様。"},{"spoiler":false,"text":"舞踊の家元だった母親の影響で、幼いころから和服を着用、学園内でも、彼女の制服は和服として認識されている。"},{"spoiler":false,"text":"小さい頃から、よく一人で本を読んでいた影響か、漫画的なシチュエーションや恋愛に憧れており、その物語をマニュアルとしているかの様な行動も多いとか。"}],"source":"egs","sourceCharacterId":"24059","sourceWorkId":"8648","spoiler":false},{"segments":[{"spoiler":false,"text":"父は超巨大財閥の社長、母は舞踊の家元。母の影響で、小さい頃から和服を着ていて、学園内では彼女の制服として扱われているらしい。"},{"spoiler":false,"text":"小さい頃は病弱で、両親が多忙だったこともあり、よくひとりで本を読んでいたせいか、漫画にあるシチュエーションや恋愛に憧れる夢見がちな少女になってしまった。しかも困ったことに、物語をマニュアルのように誤解（曲解？）して行動するパターンが多いとか。"},{"spoiler":false,"text":"例えば、料理の腕前は普通なのに、「こういう時のヒロインは料理が下手なものなのです」と、意図的にヘタな料理を作ることもある。この辺の考え方は、どうも天然っぽいかもしれない。"}],"source":"bangumi","sourceCharacterId":"38016"}],"profileFacts":[{"label":"胸围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"24059","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCharacterId":"24059","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"148 cm","valueContext":null,"source":"egs","sourceCharacterId":"24059","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"24059","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"24059","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"40 kg","valueContext":null,"source":"egs","sourceCharacterId":"24059","sourceWorkId":"8648","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f94dcf6a2d4716f65621eb560b428abd3e02d8d7b55e5f923c41edfcee7d4599.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8b6547c8f2e19630c0118fb50434d2e5c6f996c7de2e2bcdcf157bb28f37aa7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑠月未来","creatorId":"vndb:s6521","sourcePersonId":"vndb:s6521","canonicalEntityId":"vndb:s6521","name":"瑠月 未来","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:152371:38016:37485:1","source":"bangumi"}]},{"characterId":"char_c50783","characterName":"くま","sourceIds":{"bangumi":[{"characterId":"38017","match":"exact-normalized-name-in-linked-work","subjectId":"152371"}],"egsCharacterIds":["24060"],"vndbCharacterId":"c50783"},"originalCharacterName":"くま","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公にピンチを助けられて以来、懐いてしまったメイド少女。"},{"spoiler":false,"text":"性格は、従順、素直、健気、時々ドジ。"},{"spoiler":false,"text":"メイド修行のため、主人公に付きまとい日々奮闘しているが、その姿は、どこか小動物チック。"},{"spoiler":false,"text":"主人公の言葉に、一喜一憂を見せるが、性的なことには、ただならぬ恥じらいを見せる。"}],"source":"egs","sourceCharacterId":"24060","sourceWorkId":"8648","spoiler":false},{"segments":[{"spoiler":false,"text":"ある日、主人公にピンチを助けられて以来、主人公に懐いてしまうメイドの少女。"},{"spoiler":false,"text":"メイドとしての修行を積むため、なにかと主人公のそばをウロチョロと付きまとうが、主人公からは半ばペットのような扱いを受けている。立派なメイドを夢見て日々奮闘しているが、その様はどこか小動物のようである。"},{"spoiler":false,"text":"性格は素直で従順で健気で、時々ドジ。主人公の単純な言葉に、 大げさな一喜一憂を見せる。ただし、性的なことには、ただならぬ恥じらいを見せる。"},{"spoiler":false,"text":"動植物が好きで、学園敷地内にある森には、彼女が世話をしている花畑がある。"},{"spoiler":false,"text":"「いろんなことを教えてくださいね、ご主人さまっ」"}],"source":"bangumi","sourceCharacterId":"38017"}],"profileFacts":[{"label":"胸围（本版本）","value":"72 cm","valueContext":null,"source":"egs","sourceCharacterId":"24060","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"aa","valueContext":null,"source":"egs","sourceCharacterId":"24060","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"142 cm","valueContext":null,"source":"egs","sourceCharacterId":"24060","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"73 cm","valueContext":null,"source":"egs","sourceCharacterId":"24060","sourceWorkId":"8648","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"24060","sourceWorkId":"8648","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/924cbf32cf71e12cd2c85d4c2dceabbabba340f849d53efcb49a4fec5ab2061f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffe780dd6b5a4d2464800503e45a34a32c85e7659579215a20969ba2043a7980.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"み～こ","creatorId":"vndb:s1897","sourcePersonId":"vndb:s1897","canonicalEntityId":"vndb:s1897","name":"み～こ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:152371:38017:29718:1","source":"bangumi"}]},{"characterId":"char_c50786","characterName":"豪徳胤 羅剛","sourceIds":{"bangumi":[{"characterId":"38021","match":"exact-normalized-name-in-linked-work","subje