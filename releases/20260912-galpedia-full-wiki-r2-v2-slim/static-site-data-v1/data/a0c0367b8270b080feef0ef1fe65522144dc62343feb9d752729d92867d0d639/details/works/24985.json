"vndb","sourceCharacterId":"c74270"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec40aa871cb5013b0c2980a2c8efc81fbc3c7fdf5586eea81d94f0e5409ab6ef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/873ad28bc87e5e41912b6a8096eb2993dc6de8097b1206f2ac1dac18bb289007.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶 裕貴","creatorId":"vndb:s84","sourcePersonId":"vndb:s84","canonicalEntityId":"vndb:s84","name":"梶 裕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73648","source":"vndb"}]},{"characterId":"char_vndb_c74271","characterName":"睦月 始","sourceIds":{"vndbCharacterId":"c74271"},"originalCharacterName":"睦月 始","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hajime is known to be of commanding presence, making him stand out compared to other people. With his naturally great amount of charisma, he often ends up being the center of the group without him realizing. He is hailed as if he were a \"King\" by many, not only because of his personal appeal, but also because he is good at taking care of those around him. While he is a man of very few words, he can be quite blunt, at times sarcastic and severe, but well-meaning. He also maintains a dislike for doing things half-done or half-way."}],"source":"vndb","sourceCharacterId":"c74271"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd9bc279cd02be911ce6d54ea9b8259b000f27d0eb9f0e25438da965293efa61.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b7160b33fba830b4