oiler":false,"text":"能力の実験台として静葉と付き合う事にし、ある程度成果を得た事で距離を置くように別れた。"},{"spoiler":false,"text":"琉魅穂を本当に大切に思っており、過保護な面もある。"}],"source":"egs","sourceCharacterId":"513","sourceWorkId":"18636","spoiler":false},{"segments":[{"spoiler":false,"text":"【対人関係】普通"},{"spoiler":false,"text":"【女性経験】静葉とのみ"},{"spoiler":false,"text":"学園の2年生で特待生にして成績トップ。"},{"spoiler":false,"text":"妹の琉魅穂と二人暮らし。飄々とした性格で他人に合わせて話をする為、聞き上手。"},{"spoiler":false,"text":"静葉らを除き、クラスメイトの女学生からの評判も男子学生の中では一番と中々だが、"},{"spoiler":false,"text":"自分と妹の為ならば、悪意なく手段を選ばない裏の面も持っており、かつて能力に目覚めたばかりの頃、"},{"spoiler":false,"text":"能力の実験台として静葉と付き合う事にし、ある程度成果を得た事で距離を置くように別れた。"},{"spoiler":false,"text":"琉魅穂を本当に大切に思っており、過保護な面もある。"},{"spoiler":false,"text":"能力にはシーズ（seize＝強奪）と名付けている。"}],"source":"bangumi","sourceCharacterId":"205613"}],"profileFacts":[{"label":"身高（本版本）","value":"175 cm","valueContext":null,"source":"egs","sourceCharacterId":"513","sourceWorkId":"18636","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1888","sourceCompanyId":"egs:brand:2388","canonicalEntityId":"vndb:p1888","name":"WitchFlame","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:18636:2388","source":"egs"},{"companyId":"vndb:p1888","sourceCompanyId":"vndb:p1888","canonicalEntityId":"vndb:p1888","name":"WitchFlame","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:30662:v12386","source":"vndb"},{"companyId":"vndb:p1888","sourceCompanyId":"vndb:p1888","canonicalEntityId":"vndb:p1888","name":"WitchFlame","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:31639:v12386","source":"vndb"},{"companyId":"vndb:p176","sourceCompanyId":"vndb:p176","canonicalEntityId":"vndb:p176","name":"N43 Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:37246:v12386","source":"vndb"},{"companyId":"vndb:p1888","so