se,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c128226"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c3de84df89833c7251a85ee110d2c1684e6cb8d94d07f6e4895a4dfcb033d39.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a6e2290f71e64784162a46d43477e3b1b531774e1e25c65574b3a083bc63e5b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"歩 サラ","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97054","source":"vndb"}]},{"characterId":"char_vndb_c128227","characterName":"春風 いのり","sourceIds":{"vndbCharacterId":"c128227"},"originalCharacterName":"春風 いのり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Formed Sub-Couple 02 with Kanda Kousei."},{"spoiler":false,"text":"Meguri's younger sister and the president of the student council. The unattainable high class flower with beauty and brains."},{"spoiler":false,"text":"However, she has strong prejudices against men and has always been against the idea of a co-educational school."},{"spoiler":false,"text":"Has a very different personality from her older sister's, and is often told that they look nothing alike."},{"spoiler":false,"text":"Despite her pure and grateful attitude, she has short stature, so Tokoyo always pats her on the head and treats her as if she were the younger one."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c128227"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/000d5755bd2f0c54a54416ec9eae08c216bea413ad8899912e1436d9dc1bb66a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/222fcec00f28300ab73b03e8dc24e20a6f300ab2d1b59506f319177c64148a61.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花寺 香蓮","creatorId":"vndb:s4474","sourcePersonId":"vndb:s4474","canonicalEntityId":"vndb:s4474","name":"平野 有紗","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97056","source":"vndb"}]},{"characterId":"char_vndb_c128228","characterName":"恋河原 未愛","sourceIds":{"vndbCharacterId":"c128228"},"originalCharacterName":"恋河原 未愛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Formed Sub-Couple 03 with Tokiya Rei."},{"spoiler":false,"text":"Kokoro's best friend, self-proclaimed to be the prettiest and most popular girl in the class. Indeed, she is cute."},{"spoiler":false,"text":"Determined to be the center of attention, she spares no effort. Although she acts all cutesy, she has a bad personality and a sharp tongue."},{"spoiler":false,"text":"All she cares about is being popular, so she is actually an inexpert who has no idea what it is like to be in love."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c128228"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/03ed74390af265cc7bc751a8ac1da29508b5e5ff67cf7dc4e3362d3ae4fddc73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0ea2b74da29549daeb7d045ee743f9b3cba6ef730d9c6b025999bf622a053e7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"飴川 紫乃","creatorId":"vndb:s15910","sourcePersonId":"vndb:s15910","canonicalEntityId":"vndb:s15910","name":"小澤 みのり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97059","source":"vndb"}]},{"characterId":"char_vndb_c128229","characterName":"鴇矢 怜","sourceIds":{"vndbCharacterId":"c128229"},"originalCharacterName":"鴇矢 怜","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Formed Sub-Couple 03 with Koigawara Mia."},{"spoiler":false,"text":"Outside, he is undoubtedly a good-looking man, if a little arrogant. But on the inside he is a narrow-minded weirdo."},{"spoiler":false,"text":"Has no desire to cooperate with others and always does whatever he pleases. He is filled with a strange self-confidence, you could call him an ultimate positive thinking monster."},{"spoiler":false,"text":"Obviously, he has no girlfriend or even a friend and is constantly talking to himself."},{"spoiler":false,"text":"The only good thing about him is his appearance, so he has personal beliefs on recognizing a wench who approaches him for his looks."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c128229"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a980576d6743f732e5a35739e4b281cc9b12b2f6d05aa58f240a8e43144b097.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64731251caefe6ba11b93a48401d4c5a31fd051db0c4be34c0220b38ecbf67b3.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鏑木 真","creatorId":"vndb:s15678","sourcePersonId":"vndb:s15678","canonicalEntityId":"vndb:s15678","name":"鏑木真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97058","source":"vndb"}]},{"characterId":"char_vndb_c128230","characterName":"神田 光生","sourceIds":{"vndbCharacterId":"c128230"},"originalCharacterName":"神田 光生","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Formed Sub-Couple 02 with Harukaze Inori."},{"spoiler":false,"text":"Kanata's best friend and rival. They share similar mindset, but he acts more logically."},{"spoiler":false,"text":"Eventhough he is smart, he has no romantic experience just like his peers, so his plans never work out."},{"spoiler":false,"text":"His name is often misread as Mitsuo, which became his nickname."},{"spoiler":false,"text":"Although he is not the type of person to fall in love at first sight, he confessed his love to Inori on the first day of school, which surprised Kanata and the others."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c128230"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f909feb852f0395cdda2289f4e7d5d8e50ab4125f9f8ed116f5d087a66e741bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aee67b0f512befed7b997316268589fda5fd7ef05bbb4c78f51b6d393b7fc9ec.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"椨 もんじゃ","creatorId":"vndb:s17728","sourcePersonId":"vndb:s17728","canonicalEntityId":"vndb:s17728","name":"椨もんじゃ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97060","source":"vndb"}]},{"characterId":"char_vndb_c128231","characterName":"堂島 大河","sourceIds":{"vndbCharacterId":"c128231"},"originalCharacterName":"堂島 大河","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Formed Sub-Couple 01 with Koeda Fumi."},{"spoiler":false,"text":"Kanata's best friend. Despite his fierce and massive appearance, he has a timid and kind personality."},{"spoiler":false,"text":"Although he lacks delicacy and tends to say whatever comes to mind, his pure nature which distinguish him from Kanata and Mitsuo makes it hard for people to blame him."},{"spoiler":false,"text":"As expected from his appearance, he's very strong and good at sports, but also bad at studying."},{"spoiler":false,"text":"Has a strange obsession with panties and seem to care about them more than love."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c128231"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/feabee1902bf0b3c7f837b8226f9eb44f0b74ebf49c15aa55050c47f4f0e3030.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e21031c8f62ec3e73e8ce9fde2bd17234d58009fb1dcae3cac60f09a0ae06533.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"志雄 子奨","creatorId":"vndb:s18108","sourcePersonId":"vndb:s18108","canonicalEntityId":"vndb:s18108","name":"志雄子奨(aki)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:97062","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p371","sourceCompanyId":"egs:brand:1511","canonicalEntityId":"vndb:p371","name":"ASa Project","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:35845:1511","source":"egs"},{"companyId":"vndb:p371","sourceCompanyId":"vndb:p371","canonicalEntity