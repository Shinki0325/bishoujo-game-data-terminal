,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:325655:143969:5741:1","source":"bangumi"}]},{"characterId":"char_c85262","characterName":"柳瀬 奈々美","sourceIds":{"bangumi":[{"characterId":"143965","match":"exact-normalized-name-in-linked-work","subjectId":"77003"}],"egsCharacterIds":["1503"],"vndbCharacterId":"c85262"},"originalCharacterName":"柳瀬 奈々美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"奈々美の転生後の姿。前世の記憶は無いはずなのだが、 時折記憶が混乱することがあった。"},{"spoiler":false,"text":"心配した父親は思い出深い町を離れ現在の街へ引越しを決意した。"},{"spoiler":false,"text":"新天地で喫茶店を経営し娘と二人で静かに暮らすために…。"},{"spoiler":false,"text":"“鎌“が奪われ、力を他人に使われることで奈々美本人にも何らかの影響が出ていると思われる。"},{"spoiler":false,"text":"喫茶店（MARHO）の常連加賀美のよき相談相手であり、良きお姉さんでもある。"},{"spoiler":false,"text":"誰にでも優しく、みんなに好かれるさっぱりしたお姉さんタイプ。"},{"spoiler":false,"text":"いかにも看板娘といった雰囲気。抜け殻の小勇座は喫茶店にディスプレイされている。"}],"source":"egs","sourceCharacterId":"1503","sourceWorkId":"19212","spoiler":false},{"segments":[{"spoiler":false,"text":"職業：杜邑学園２年"},{"spoiler":false,"text":"裕樹のクラスにやって来た転入生。ペットの小勇座（こゆうざ）とはいつも一緒。"},{"spoiler":false,"text":"かなりの美少女ではあるが、物静かな雰囲気と、神秘的とも言える白髪から"},{"spoiler":false,"text":"近寄りがたい雰囲気を醸し出している。"},{"spoiler":false,"text":"結果、男女ともに若干の距離を置かれている。"},{"spoiler":false,"text":"本当はクラスの皆と仲良くしたいと思っているが、口下手で上手く付き合えない。"},{"spoiler":false,"text":"唯一、裕樹と、彼に近い仲間にだけは普通に接することができる。"},{"spoiler":false,"text":"特に裕樹には相当に懐いている。"},{"spoiler":false,"text":"１０年前、裕樹、真帆と仲良くしていた時期があった。"},{"spoiler":false,"text":"その時、彼女にとって忘れ難い想い出があったらしいが……"}],"source":"bangumi","sourceCharacterId":"143965"}],"profileFacts":[],"metadataCandidateConflicts":{"bust":[{"comparisonValue":"72","source":"vndb","sourceCharacterId":"c85262","value":"72"},{"comparisonValue":"72","scope":"sourceWork","source":"egs","sourceCharacterId":"1503","sourceWorkId":"19212","value":"72"},{"comparisonValue":"75","source":"bangumi","sourceCharacterId":"143965","value":"75"}],"height":[{"comparisonValue":"150","source":"vndb","sourceCharacterId":"c85262","value":"150"},{"comparisonValue":"150","scope":"sourceWork","source":"egs","sourceCharacterId":"1503","sourceWorkId":"19212","value":"150"},{"comparisonValue":"153","source":"bangumi","sourceCharacterId":"143965","value":"153ｃｍ"}],"hip":[{"comparisonValue":"73","source":"vndb","sourceCharacterId":"c85262","value":"73"},{"comparisonValue":"73","scope":"sourceWork","source":"egs","sourceCharacterId":"1503","sourceWorkId":"19212","value":"73"},{"comparisonValue":"75","source":"bangumi","sourceCharacterId":"143965","value":"75"}],"waist":[{"comparisonValue":"53","source":"vndb","sourceCharacterId":"c85262","value":"53"},{"comparisonValue":"53","scope":"sourceWork","source":"egs","sourceCharacterId":"1503","sourceWorkId":"19212","value":"53"},{"comparisonValue":"55","source":"bangumi","sourceCharacterId":"143965","value":"55"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78e21ca656d27becfdbd433cd28113490fcb48f033a9d4ae288696f60c7bc997.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d06f979a2cd457e9494b755d58ccaee1f699d2b9802a2bc42d5186bccd910188.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleL