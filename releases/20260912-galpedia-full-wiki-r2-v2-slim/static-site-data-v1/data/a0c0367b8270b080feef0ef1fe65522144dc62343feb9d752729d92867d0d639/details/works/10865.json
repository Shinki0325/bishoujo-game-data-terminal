7e17eea6d178f234c4f78be92800be9c593683fe78cd38e3a8b44239f0c85.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf9a1b4034190185b8e2df7b5dbc56ac9ceef4571da1679c7916133c67bde9bf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229715:59022:4799:1","source":"bangumi"}]},{"characterId":"char_c32350","characterName":"セルマ・ベルイマン","sourceIds":{"bangumi":[{"characterId":"59023","match":"exact-normalized-name-in-linked-work","subjectId":"229715"}],"egsCharacterIds":["18158"],"vndbCharacterId":"c32350"},"originalCharacterName":"セルマ・ベルイマン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"日本の文化に興味津々な留学生。"},{"spoiler":false,"text":"日々の研究に余念がなく、伝統文化については日本人より詳しいことも。"},{"spoiler":false,"text":"母国にいたころから勉強していたらしく、日本語は流暢。"},{"spoiler":false,"text":"最近では、お淑やかな日本人女性に憧れ、自分もそうなれるよう努力している。"}],"source":"egs","sourceCharacterId":"18158","sourceWorkId":"10865","spoiler":false},{"segments":[{"spoiler":false,"text":"スウェーデンからの留学生。由緒正しき旧家の子女だが、日本の文化に興味を持ち、来日している。"},{"spoiler":false,"text":"日本文化の研究に余念がなく、伝統文化については、むしろ平均的な日本人よりも詳しい。日本語は母国にいるときから勉強していたので、かなり堪能。"},{"spoiler":false,"text":"日本女性の心意気を自分の中に生み出そうと、最近は淑やかな日本女性になれるよう、日々努めている。"}],"source":"bangumi","sourceCharacterId":"59023"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6d1aacb8784fae35aa862c114909cb18bb35277311ab88f137606afa8099a0d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c008b0b3a4e2cecb63b34fd833904a9ec95704eb1cd384f6325a1592e83211a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田内夏子","creatorId":"vndb:s3102","sourcePersonId":"vndb:s3102","canonicalEntityId":"vndb:s3102","name":"田内 夏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229715:59023:19410:1","source":"bangumi"}]},{"characterId":"char_c32351","characterName":"浜田 れんげ","sourceIds":{"bangumi":[{"characterId":"59024","match":"exact-normalized-name-in-linked-work","subjectId":"229715"}],"egsCharacterIds":["18159"],"vndbCharacterId":"c32351"},"originalCharacterName":"浜田 れんげ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ロリータボディに幼い顔立ちだが、これでも学園の三年生。"},{"spoiler":false,"text":"自分の容姿を逆手にとって、都合の悪いときは小さい子に成りすます小悪魔っ娘。"},{"spoiler":false,"text":"学園のロリコン教師に肉体関係を迫られ、幼い身体を調教開発された。"},{"spoiler":false,"text":"以来、快楽と成績の一石二鳥とばかりに、教師との関係を続けている。"},{"spoiler":false,"text":"その幼い容姿で、今まで痴漢にあったことがなかったが、変態主人公の視線は、彼女のロリータボディにも向いて……。"}],"source":"egs","sourceCharacterId":"18159","sourceWorkId":"10865","spoiler":false},{"segments":[{"spoiler":false,"text":"見た目は幼いが、実際は学園3年生。"},{"spoiler":false,"text":"背の低いロリ体型を逆手にとって、都合の悪い時は小さい子になりすます。"},{"spoiler":false,"text":"1年生のときに、ロリコンの教師に肉体関係をせまられ、以来関係をもつ。"},{"spoiler":false,"text":"変態教師に調教され、快楽と成績向上の一石二鳥と、れんげは関係を続けている。"},{"spoiler":false,"text":"幼い容姿のため痴漢にあったことはなかったが、変態主人公の毒牙にかかることに……。"}],"source":"bangumi","sourceCharacterId":"59024"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05c5537e3ae4874c24685719b7c7aa6d9badfe93c7b86e50226ef18cb2f43055.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c0e628e32242498f0bc96dc58202324791115777ce4aa55dd166333b51