5904:1","source":"bangumi"}]},{"characterId":"char_c22480","characterName":"君島 藍","sourceIds":{"bangumi":[{"characterId":"29642","match":"exact-normalized-name-in-linked-work","subjectId":"124972"}],"egsCharacterIds":["6371"],"vndbCharacterId":"c22480"},"originalCharacterName":"君島 藍","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aya’s elder twin sister, and the class mascot. While typically meek and docile, she’s actually very willful, and won’t budge once she’s set her mind on something."}],"source":"vndb","sourceCharacterId":"c22480"},{"segments":[{"spoiler":false,"text":"妹にべったりな、クラスのマスコットキャラ。"},{"spoiler":false,"text":"亜弥とは双子の姉妹で、自身は姉。どことなく猫っぽい性格で、クラスではマスコット的キャラクター。"},{"spoiler":false,"text":"妹の転入後、まるで仔猫を守る母猫の様に亜弥を構い続ける様になってしまいっている。"}],"source":"egs","sourceCharacterId":"6371","sourceWorkId":"21546","spoiler":false},{"segments":[{"spoiler":false,"text":"亜弥の双子の姉で、猫っぽい性格なクラスのマスコット。重度のシスコン（？）で、常に亜弥にべったり。"}],"source":"bangumi","sourceCharacterId":"29642"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2abf5bf4c1623eb26416afc74b2af83874a20e45591eb27621fca3f6f4e4102f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b91e2faae70606420431c50194fc1fb34fc15719695e952189b13652ae524d14.webp","width":81,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安田奈緒子","creatorId":"vndb:s1036","sourcePersonId":"vndb:s1036","canonicalEntityId":"vndb:s1036","name":"安田 奈緒子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:124972:29642:17130:1","source":"bangumi"}]},{"characterId":"char_c22481","characterName":"三澤 渚","sourceIds":{"bangumi":[{"characterId":"29644","match":"exact-normalized-name-in-linked-work","subjectId":"124972"}],"egsCharacterIds":["6373"],"vndbCharacterId":"c22481"},"originalCharacterName":"三澤 渚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The star of the track and field team, who’s always surrounded by fans. She and Rina have been best friends since they were little, and they can often be spotted together."}],"source":"vndb","sourceCharacterId":"c22481"},{"segments":[{"spoiler":false,"text":"幼馴染みの事をいつも気に掛けている、陸上部の王子様"},{"spoiler":false,"text":"明るい褐色肌のスポーツ少女で、外国人の父と日本人の母のハーフ。莉菜とは幼馴染みの仲。"},{"spoiler":false,"text":"誤解され易い莉菜をついつい甘やかしてしまいがちで、結果振り回される事が多い。"}],"source":"egs","sourceCharacterId":"6373","sourceWorkId":"21546","spoiler":false},{"segments":[{"spoiler":false,"text":"外国人ハーフで陸上部のエース。幼馴染みの莉菜に振り回されるも、つい甘やかしてしまう。"}],"source":"bangumi","sourceCharacterId":"29644"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/2992e1363699db2032cdc8ea2656edf121ba5946692f8c47cb868046e14d9bc9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce32d079d03cafc78508ee0e53ae69fb1a662b9508da5d60e1583622fab73a41.webp","width":79,"height":256,"source":"static-detail"},"actors":[{"creditedName":"カンザキカナリ","creatorId":"vndb:s1000","sourcePersonId":"vndb:s1000","canonicalEntityId":"vndb:s1000","name":"カンザキ カナリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:124972:29644:24747:1","source":"bangumi"}]},{"characterId":"char_c22482","characterName":"高幡 莉菜","sourceIds":{"bangumi":[{"characterId":"29643","match":"exact-normalized-name-in-linked-work","subjectId":"124972"}],"egsCharacterIds":["6372"],"vndbCharacterId":"c22482"},"originalCharacterName":"高幡 莉菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A spoiled and pushy princess. But for some reason, everybody loves her. In class, she’s treated like an actual princess. She has a particular fondness for Nagisa."}],"source":"vndb","sourceCharacterId":"c22482"},{"segments":[{"spoiler":false,"text":"甘えん坊でわがままな、クラスのお姫様"},{"spoiler":false,"text":"白い肌に金髪の超絶美少女。"},{"spoiler":false,"text":"幼馴染みの渚を一番の親友と公言し、時所を選ばずキスをしまくるキス魔。"},{"spoiler":false,"text":"甘えん坊でわがままな、悪い意味でのお嬢様体質だが、憎めない性格で周囲に好かれる事が多い。"}],"source":"egs","sourceCharacterId":"6372","sourceWorkId":"21546","spoiler":false},{"segments":[{"spoiler":false,"text":"白い肌に金髪の超絶美少女。幼馴染みの渚を一番の親友と公言し、時所を選ばずキスをしまくるキス魔。"}],"source":"bangumi","sourceCharacterId":"29643"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3d9522d8d412321e236c3701b29c100c36d236c3ccefd80ace9cfd448692df5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f540196280075f2f1afe67c21e9385c3e1555d637939cb2094951f7ece90800d.webp","width":81,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井ありす","creatorId":"vndb:s1626","sourcePersonId":"vndb:s1626","canonicalEntityId":"vndb:s1626","name":"櫻井 ありす","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:124972:29643:19213:1","source":"bangumi"}]},{"characterId":"char_c22483","characterName":"小野原 葉月","sourceIds":{"bangumi":[{"characterId":"29639","match":"exact-normalized-name-in-linked-work","subjectId":"124972"}],"egsCharacterIds":["6368"],"vndbCharacterId":"c22483"},"originalCharacterName":"小野原 葉月","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A transfer student who was admitted in the second term. She makes no attempts to hide her humble roots. She’s well-liked by everyone."}],"source":"vndb","sourceCharacterId":"c22483"},{"segments":[{"spoiler":false,"text":"強くて優しいサバサバ系少女……を演じるごく普通の少女"},{"spoiler":false,"text":"2学期からミカ女に編入して来た転校生で、行動的で明朗な性格の「女子が憧れる女子」としてすっかり人気者に。"},{"spoiler":false,"text":"ですが……実はその性格は彼女が転入時に自身で「キャラ付け」して演じている性格で……"}],"source":"egs","sourceCharacterId":"6368","sourceWorkId":"21546","spoiler":false},{"segments":[{"spoiler":false,"text":"強くて優しい「女子が憧れる女子」として人気者になるも、その性格は彼女が「演じている」偽りのもので……"}],"source":"bangumi","sourceCharacterId":"29639"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8cbf0a65e6dd8dc6cfe60cfc8055512049410695f01944fd34f1393b541e99f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6d75078cb79fba8ccc49bf1f44d0871a0a55448efecfaa3b1f91cbd0c5cbeb9.webp","width":81,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中理々","creatorId":"vndb:s1977","sourcePersonId":"vndb:s1977","canonicalEntityId":"vndb:s1977","name":"田中 理々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:124972:29639:17081:1","source":"bangumi"}]},{"characterId":"char_c22484","characterName":"蘇枋 愛実","sourceIds":{"bangumi":[{"characterId":"29640","match":"exact-normalized-name-in-linked-work","subjectId":"124972"}],"egsCharacterIds":["6369"],"vndbCharacterId":"c22484"},"originalCharacterName":"蘇枋 愛実","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A sheltered girl with an air of grace and refinement."},{"spoiler":true,"text":"Her true personality comes out through her internet idol persona “MANA”, where she’s cruel and abusive."}],"source":"vndb","sourceCharacterId":"c22484"},{"segments":[{"spoiler":false,"text":"奥ゆかしくも清楚な雰囲気を持つ、生粋のお嬢様"},{"spoiler":false,"text":"楚々とした雰囲気の生粋のお嬢様で、奥ゆかしく清楚な雰囲気を持つ箱入り娘。葉月にはだいぶ好意的。"},{"spoiler":false,"text":"その美貌と立ち振る舞いから周囲のファンも多いが、静寂を好む本人の希望により、目立ったファン活動等は自粛されている。"}],"source":"egs","sourceCharacterId":"6369","sourceWorkId":"21546","spoiler":false},{"segments":[{"spoiler":false,"text":"楚々とした雰囲気の生粋のお嬢様で「守ってあげたい女子」。その美貌と家柄、立ち振る舞いから周囲のファンも多い。"}],"source":"bangumi","sourceCharacterId":"29640"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a56a828c9be57724a26feed0ffdf510fefe49c8ce7999f195235b7a180c09599.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93167731ff11c7eb4795dd9dd91e062af458438cc7ad033de5947a95729ac202.webp","width":80,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天乙准花","creatorId":"vndb:s339","sourcePersonId":"vndb:s339","canonicalEntityId":"vndb:s339","name":"椎那 天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:124972:29640:7890:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p4812","sourceCompanyId":"egs:brand:4496","canonicalEntityId":"vndb:p4812","name":"聖ミカエル女子学園","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:21546:4496","source":"egs"},{"companyId":"vndb:p18672","sourceCompanyId":"vndb:p18672","canonicalEntityId":"vndb:p18672","name":"iqdhk8t0hxww","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:131931:v16262","source":"vndb"},{"companyId":"vndb:p14091","sourceCompanyId":"vndb:p14091","canonicalEntityId":"vndb:p14091","name":"GVNVH18","roleCodes":["publisher"],