us":"source-native","relationId":"vndb:vn-staff:52985","source":"vndb"},{"creditedName":"羽津樹","creatorId":"vndb:s1007","sourcePersonId":"vndb:s1007","canonicalEntityId":"vndb:s1007","name":"羽津樹","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:52986","source":"vndb"},{"creditedName":"たにチュウ","creatorId":"vndb:s1008","sourcePersonId":"vndb:s1008","canonicalEntityId":"vndb:s1008","name":"たにチュウ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:52987","source":"vndb"},{"creditedName":"のぶちゃん","creatorId":"vndb:s1019","sourcePersonId":"vndb:s1019","canonicalEntityId":"vndb:s1019","name":"のぶちゃん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:52988","source":"vndb"},{"creditedName":"Ｂｏａ＿ＵＰ","creatorId":"vndb:s7353","sourcePersonId":"vndb:s7353","canonicalEntityId":"vndb:s7353","name":"Ｂｏａ＿ＵＰ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:52989","source":"vndb"},{"creditedName":"風上 旬","creatorId":"vndb:s7351","sourcePersonId":"vndb:s7351","canonicalEntityId":"vndb:s7351","name":"風上 旬","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:52990","source":"vndb"},{"creditedName":"TakaTan","creatorId":"vndb:s11149","sourcePersonId":"vndb:s11149","canonicalEntityId":"vndb:s11149","name":"たかたん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:52993","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c105716","characterName":"ミナ・アマミヤ","sourceIds":{"vndbCharacterId":"c105716"},"originalCharacterName":"ミナ・アマミヤ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mina is a maid who has lost her memory. Having lived her mundane days serving at the mansion, one day she suddenly meets a person who calls her \"Irregular.\" And from that day on, various attacking incidents will happen to her."},{"spoiler":false,"text":"Whether Mina wants it or not, things go on and on, eventually leading to an incident that affects the survival of the house itself. The actions she takes during the story and the people she decides to get involved with will determine the game's ending."},{"spoiler":false,"text":"Translated from official website."}],"source":"vndb","sourceCharacterId":"c105716"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/215dd81bf78668c719ab3293ac8200f19be0244b08977d84df9bdca1178a8b57.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/418a06b5b93f3ad76b293d25f1f5da694adab68e89ed598e3be920e647b3f804.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c105717","characterName":"ミズキ・シャレード","sourceIds":{"vndbCharacterId":"c105717"},"originalCharacterName":"ミズキ・シャレード","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A maid with a dynamic personality who is friends with Mina and Stella. Mizuki is a girl who cares deeply about her friends, especially Mina her best friend whom she loves like a sister. She even shows Mina the ropes throughout the work in the mansion. Mizuki keeps a has pet turtle in her room."},{"spoiler":false,"text":"Translated from official website."}],"source":"vndb","sourceCharacterId":"c105717"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac880e2025e0adeca3098d9dcdcd886542e81617ddc780ef0884481d67867e55.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f7f0fadcaaccf9aaa4a01f97104144a88b018bade711aec15191586b1a5a838.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c105719","characterName":"プリステラ・カルナート","sourceIds":{"vndbCharacterId":"c105719"},"originalCharacterName":"プリステラ・カルナート","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who is a close friend of Mina and Mizuki. Stella is characterized by her straightforward personality and an elegant manner of speech. She loves cooking, but every dish she makes turns out deathly sweet. Most people are afraid of her and call her meals a \"headache-causing mystery drug\"."},{"spoiler":false,"text":"Translated from official website."}],"source":"vndb","sourceCharacterId":"c105719"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4861d4b9fbba96e36ce9e3c42642b726e228d5c0e8b56679f85fcb438da1f97.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/313ba2c7da4a7d4e4b27b1aad8e8990341fd7b7b9422b8597cc0f6d49eac8b14.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c105720","characterName":"セシリア・ローズウィップ","sourceIds":{"vndbCharacterId":"c105720"},"originalCharacterName":"セシリア・ローズウィップ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Cecil is a maid who is Mina and Mizuki's senior. Sheis very strict about work, which can be annoying. Despite this, Cecil acts as an older sister to all maids and usually takes good care of Mina and the others. She is an alcohol drinker who dislikes sweets, so Cecil does not get along well with Stella's excessively sweet cooking."},{"spoiler":false,"text":"Cecil wears glasses and looks quiet at first glance, but she can become scary when angered. What is especially peculiar about her is her habit to hang around the courtyard. She can be occasionally seen standing there in the afternoon."},{"spoiler":false,"text":"Translated from official website."}],"source":"vndb","sourceCharacterId":"c105720"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e727f413935052d9b8da3a056190829015815f3063cb524c7411cefbaf55b396.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd4c43834cb7a589888becda6900d517dab5c2e0690272f99339530c4dd673d7.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c105722","characterName":"シェファルディ・ローディスタント","sourceIds":{"vndbCharacterId":"c105722"},"originalCharacterName":"シェファルディ・ローディスタント","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Being the head of the maids, Rudy is an excellent maid. She happens to have a long history with the mansion's landlord, Meliagris, even rumored to be his ex-lover. For an unknown reason Shefardy wishes to subdue Mina Amamiya, and is one of the first to call her \"Irregular\"."},{"spoiler":false,"text":"Translated from official website."}],"source":"vndb","sourceCharacterId":"c105722"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e92a1cbd818e2f5f52cdb59a7d6e2c4d2abb2b64b99cc3112163907e3df2877.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/11dcefeeca8fb0f99aa524ef98c668b84acb5516e4dc84296c7e051c4693e08a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c105723","characterName":"リムフォ・ベル・カーチス","sourceIds":{"vndbCharacterId":"c105723"},"originalCharacterName":"リムフォ・ベル・カーチス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Because of Rimfo's avid loyalty to the head maid, she is known around the mansion as \"Shefardy's Hound\" or \"Shefardy's Samurai\". As soon as Shefardy becomes interested in Mina, Rimfo is the first one to get involved with Mina."},{"spoiler":false,"text":"Translated from official website."}],"source":"vndb","sourceCharacterId":"c105723"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff8ebfbe88b5be6b3f2f4706750ab22dcf645df6d2d68a6dbd8e907a289b4085.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b548446146e538ff1b31cd6f92031238aad1925a937a540e1acd1c5bb1302a9.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c105724","characterName":"ミオ・アサクラ","sourceIds":{"vndbCharacterId":"c105724"},"originalCharacterName":"ミオ・アサクラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A new maid that appears during the final stage of the story. With her hands she leads the whole story to a certain end."},{"spoiler":false,"text":"Translated from official website."}],"source":"vndb","sourceCharacterId":"c105724"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f65b3b9b62cd396aee4fdaba0064e82cad85cbd49166230c07b948782d672789.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24d52e0149df036dea63e0faf9aaf04c6bc66de60ceeca095940b5c7b3aea0d4.webp","width":212,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c105725","characterName":"フレゲリーラ","sourceIds":{"vndbCharacterId":"c105725"},"originalCharacterName":"フレゲリーラ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The wife of Meliagris the landlord, mother of Pterios, adoptive mother of Corelle."},{"spoiler":false,"text":"Frey has a jealous personality and she constantly wants to get rid of all the young maids in their house. But after she is impressed by Pristella Calnart's gentle, obedient and pure personality, Frey promises that she would never touch the maids as long as Stella stays as loyal as she is. And for now that promise is kept."},{"spoiler":false,"text":"Translated from official website."}],"source":"vndb","sourceCharacterId":"c105725"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b7ccd9f100de66602f223eb75ab3594e77b28015f2a017efb283e5920e56712.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/5008c74304d929d9d8b233daf39396e637deb5bf42c0ace4e6e0e2421a18c43a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c105726","characterName":"メリアグリス","sourceIds":{"vndbCharacterId":"c105726"},"originalCharacterName":"メリアグリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The harsh- looking owner of the mansion. Married to Fregerilla and father of two children, one of which is adopted."},{"spoiler":false,"text":"While being vary of Mina the \"Irregular\", Meliagris is also highly obsessed with her. What are his inner desires, and what does he want to do with Mina in the end? Those are the main narratives in the story."},{"spoiler":false,"text":"Translated from official website."}],"source":"vndb","sourceCharacterId":"c105726"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36b95d70554ba72c2cb4085ca879ab2c1c423edbd977fbc5edc7adc5153d823b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/030515bc82f0956ab58fe7757e8a9b7d52c1464c47b054b246805a9a8e17e6e4.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c105727","characterName":"プテリオス","sourceIds":{"vndbCharacterId":"c105727"},"originalCharacterName":"プテリオス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Son of Meliagris and Fregerilla. He is highly affected by the conflict between his secretive father and the jealousy and love of his mother. As a result someday he became frigid and keeps his heart closed to anyone new. Pterios gets involved in the main story only after his sister Corelle becomes interested in Mina."},{"spoiler":false,"text":"Translated from official website."}],"source":"vndb","sourceCharacterId":"c105727"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68baa0a62933f3bb604656257ab7367d270367baedc7782c8952928f496a099c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8e8abc2a2039dc12078474a5542d0bff4ad8ab1e38ed311be4a4f1370628efd.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c105728","characterName":"コレール","sourceIds":{"vndbCharacterId":"c105728"},"originalCharacterName":"コレール","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Corelle is the adoptive daughter of Meliagris and Fregerilla. She is called a sunny girl because of her warm, calm and gentle personality. She lost the usage of both legs due to air strikes in the war. Even though Corelle became handicap, her kind personality from before remained unchanged."},{"spoiler":false,"text":"Corelle is the only person Pterios can stand, but her disagreement with her parents is becoming a burden on her mind."},{"spoiler":false,"text":"Translated from official website."}],"source":"vndb","sourceCharacterId":"c105728"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b689b467a0f435f1caa3c039c2bb22ea3d68e0c6c33ac14c6575c6ac7d262a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4bb1e878c0f65e1df03e3084878ab199a8fe234318d782e7d02d29308466e47.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c105729","characterName":"カーディナル","sourceIds":{"vndbCharacterId":"c105729"},"originalCharacterName":"カーディナル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The person who was the first to call Mina \"Irregular\"."},{"spoiler":false,"text":"Cardinal seems to know some parts about the story of every person in the house and is definitely hiding some substantial secrets. He usually does not appear in front of the Mina and the others because somebody forces him to live in one of the basements of the vast mansion."},{"spoiler":false,"text":"Translated from official website."}],"source":"vndb","sourceCharacterId":"c105729"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82353aa17a636f03b4492d3f77bc2794f52473828ad13fbcf004d3614c7303ac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87ff51830c3c63065caeeaa67eadc152b5c096fc41677d2ef8b524b1f4d0fdd3.webp","width":213,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p72","sourceCompanyId":"egs:brand:21","canonicalEntityId":"vndb:p72","name":"Active","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:878:21","source":"egs"},{"companyId":"vndb:p72","sourceCompanyId":"vndb:p72","canonicalEntityId":"vndb:p72","name":"アクティブ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:10755:v4792","source":"vndb"},{"companyId":"vndb:p72","sourceCompanyId":"vndb:p72","canonicalEntityId":"vndb:p72","name":"アクティブ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:31309:v4792","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
