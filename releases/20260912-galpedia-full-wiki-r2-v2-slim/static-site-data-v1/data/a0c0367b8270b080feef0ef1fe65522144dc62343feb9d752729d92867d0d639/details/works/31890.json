52","sourcePersonId":"vndb:s952","canonicalEntityId":"vndb:s952","name":"三瓶 由布子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:58813","source":"vndb"}]},{"characterId":"char_vndb_c24668","characterName":"百瀬 志緒","sourceIds":{"vndbCharacterId":"c24668"},"originalCharacterName":"百瀬 志緒","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 2nd-year high school transfer student whose magical powers had suddenly awakened. She's a docile and honest person who is quick to trust others. So much so, that she even takes any frivolous comment by her peers seriously. Shio is highly adaptable and loves conversing with people. Strong-willed, she tries to choose the road which leads to everyone being happy as much as possible and the happiest ending."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c24668"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52708847b9d2db713b5291d272fdf23e44f917ae3cac62ab63ba174771585ed3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb17de37ba6fa9073fc7817e0a4e6a224d7a7f03952b5424058bf77df6a48ca9.webp","width":199,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c24676","characterName":"ヴィンス ヴィヴィアン ヴィッカーズ","sourceIds":{"vndbCharacterId":"c24676"},"originalCharacterName":"ヴィンス ヴィヴィアン ヴィッカーズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"710"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","