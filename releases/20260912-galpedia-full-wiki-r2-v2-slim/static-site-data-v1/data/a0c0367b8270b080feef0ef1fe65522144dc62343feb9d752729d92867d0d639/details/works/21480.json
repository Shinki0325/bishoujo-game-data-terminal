,"sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"153 cm","valueContext":null,"source":"egs","sourceCharacterId":"6011","sourceWorkId":"21480","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"6011","sourceWorkId":"21480","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"6011","sourceWorkId":"21480","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a75a9f68d4de49d03c3ae2f255c41f60c23f81b7191fe9ac3e9af16e4a1cdefb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/157ecef0ebd8e82627beb89116afcc34424012870c48aa0fda8303b6ac13297f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本田愛美","creatorId":"vndb:s4010","sourcePersonId":"vndb:s4010","canonicalEntityId":"vndb:s4010","name":"本田 愛美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:125648:29860:7648:1","source":"bangumi"}]},{"characterId":"char_c27543","characterName":"早蕨 すずな","sourceIds":{"bangumi":[{"characterId":"29861","match":"exact-normalized-name-in-linked-work","subjectId":"125648"}],"egsCharacterIds":["6012"],"vndbCharacterId":"c27543"},"originalCharacterName":"早蕨 すずな","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明るく好奇心旺盛なムードメーカー。とにかくよく喋る。"},{"spoiler":false,"text":"一見軽い感じのイマドキな女の子だが、その心は純情乙女。"},{"spoiler":false,"text":"悪戯っぽい笑みがトレードマーク。"},{"spoiler":false,"text":"母に似て、やたらと他人の世話を焼きたがる。"},{"spoiler":false,"text":"早とちりしやすいのが玉にキズ。"},{"spoiler":false,"text":"上の姉が村を出て就職しており、都会に憧れを抱いている。"},{"spoiler":false,"text":"甘いもの大好きだが、焼き芋をスイーツ呼ばわりするなど、ちょっとズレたところがある。"}],"source":"egs","sourceCharacterId":"6012","sourceWorkId":"21480","spoiler":false},{"segments":[{"spoiler":false,"text":"とにかくよく喋る、明るくて好奇心旺盛なムードメーカー。"},{"spoiler":false,"text":"一見軽い感じのイマドキな女の子だが、その心は純情乙女。"},{"spoiler":false,"text":"イタズラっぽい笑みがトレードマーク。"},{"spoiler":false,"text":"母に似て、やたらと他人の世話を焼きたがる。 ただし早とちりしやすいのが珠にキズ。"},{"spoiler":false,"text":"甘いものが大好きだが、焼き芋をスイーツ呼ばわりするなど少しズレたところがある。"},{"spoiler":false,"text":"上の姉が村を出て就職しており、都会に憧れを抱いている。"},{"spoiler":false,"text":"「ピンチはチャンスだよ！　よく分かんないけど昨日テレビで言ってた！」"}],"source":"bangumi","sourceCharacterId":"29861"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"6012","sourceWorkId":"21480","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"6012","sourceWorkId":"21480","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"6012","sourceWorkId":"21480","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"6012","sourceWorkId":"21480","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"6012","sourceWorkId":"21480","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb1f8f1e53d835afa16e6666a0c3f8db087f26bbb237a0b0dafae18fd87d185d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/i