ら――』"}],"source":"bangumi","sourceCharacterId":"27540"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/511722b3e2cb3b148fdf8619db6a421e4d9a48b76c72cf8280a3f574c4e6b225.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e14315cd571ba2e1a575e15bb579f57155f94c7513a48aa6030cac9e89123f49.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"なかせひな","creatorId":"vndb:s926","sourcePersonId":"vndb:s926","canonicalEntityId":"vndb:s926","name":"なかせ ひな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22379:27540:12719:1","source":"bangumi"}]},{"characterId":"char_c55883","characterName":"葛城 佳央","sourceIds":{"bangumi":[{"characterId":"27539","match":"exact-normalized-name-in-linked-work","subjectId":"22379"},{"characterId":"27539","match":"exact-normalized-name-in-linked-work","subjectId":"47636"}],"egsCharacterIds":["12100"],"vndbCharacterId":"c55883"},"originalCharacterName":"葛城 佳央","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"4/8"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"B"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"まずは行動！ 情熱少女"},{"spoiler":false,"text":"家庭科部の後輩"},{"spoiler":false,"text":"転校生で遥奈と同じクラスに編入。"},{"spoiler":false,"text":"活発、悪く言えば落ち着きがない。"},{"spoiler":false,"text":"思い込みが激しく、常識外れの暴走もざら。"},{"spoiler":false,"text":"流行に敏感。"}],"source":"egs","sourceCharacterId":"12100","sourceWorkId":"3009","spoiler":false},{"segments":[{"spoiler":false,"text":"家庭科部の後輩。"},{"spoiler":false,"text":"活発、悪く言えば落ち着きがない、"},{"spoiler":false,"text":"本城家のぺ―スメーカー（常にオーバーペース）。"},{"spoiler":false,"text":"愛生や遥奈からの扱いは酷いものだが"},{"spoiler":false,"text":"、本人はさほど気にしていない、やっぱり天動説の人。"},{"spoiler":false,"text":"どうでもいいことはよく知っているが、"},{"spoiler":false,"text":"基本的にはバカのようだ。魚獲って月一万円で暮らせるタイプ。"}],"source":"egs","sourceCharacterId":"12100","sourceWorkId":"3944","spoiler":false},{"segments":[{"spoiler":false,"text":"家庭科部の後輩で遥奈と同じクラス。"},{"spoiler":false,"text":"活発、悪く言えば落ち着きがない。"},{"spoiler":false,"text":"思い込みが激しい。"},{"spoiler":false,"text":"『時間なんか関係ない、理人はこれからあたしをどんどん好きになる！』"}],"source":"bangumi","sourceCharacterId":"27539"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/189744445ff58ac3d8cbbc2896f6220c2238dd3ea053706c36ec4ac36755c606.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38c56bd8db2ad29fbd469571d14a98b6880799125f2b204cbe3651174f44f95c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"すずきけいこ","creatorId":"vndb:s445","sourcePersonId":"vndb:s445","canonicalEntityId":"vndb:s445","name":"涼森ちさと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22379:27539:6275:1","source":"bangumi"}]},{"characterId":"char_c55884","characterName":"嘉島 早智子","sourceIds":{"bangumi":[],"egsCharacterIds":["12104"],"vndbCharacterId":"c55884"},"originalCharacterName":"嘉島 早智子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"いつも明るい聖の母親"},{"spoiler":false,"text":"聖の母親。"},{"spoiler":false,"text":"理人たちの利用するスーパーでイチゴの販売員のパート中。"},{"spoiler":false,"text":"真面目な聖と違ってかなり奔放な性格。"},{"spoiler":false,"text":"両親が留守がちな理人のある意味母親代わりの女性。"},{"spoiler":false,"text":"一見、いい加減で何も考えてなさそうに見えたりするが、"},{"spoiler":false,"text":"意外としっかりした人である。"},{"spoiler":false,"text":"ちなみに双子の妹が愛生の母親の翔子。"}],"source":"egs","sourceCharacterId":"12104","sourc