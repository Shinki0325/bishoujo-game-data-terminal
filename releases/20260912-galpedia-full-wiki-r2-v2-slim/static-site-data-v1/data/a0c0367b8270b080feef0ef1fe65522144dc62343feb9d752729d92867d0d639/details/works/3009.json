f","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:5801","source":"vndb"},{"creditedName":"みやま 零","creatorId":"vndb:s2794","sourcePersonId":"vndb:s2794","canonicalEntityId":"vndb:s2794","name":"みやま零(まやせろみ)","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:5802","source":"vndb"},{"creditedName":"元長 柾木","creatorId":"vndb:s3017","sourcePersonId":"vndb:s3017","canonicalEntityId":"vndb:s3017","name":"元長 柾木","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:5805","source":"vndb"}]},"cast":[{"characterId":"char_c55878","characterName":"本城 理人","sourceIds":{"bangumi":[{"characterId":"27541","match":"exact-normalized-name-in-linked-work","subjectId":"22379"},{"characterId":"27541","match":"exact-normalized-name-in-linked-work","subjectId":"47636"}],"egsCharacterIds":["12103"],"vndbCharacterId":"c55878"},"originalCharacterName":"本城 理人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公。線の細い美少年系の容姿だが、"},{"spoiler":false,"text":"なよなよしすぎ、女性的というわけではなく、"},{"spoiler":false,"text":"それなりに少年らしい面も持っている。"},{"spoiler":false,"text":"異性に対する好奇心も人並みにあるが、変態っぽくはない。"},{"spoiler":false,"text":"どちらかといえば状況に流されるタイプ。"}],"source":"egs","sourceCharacterId":"12103","sourceWorkId":"3009","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公。"},{"spoiler":false,"text":"聡明な少年だが恋愛初心者にはプリンセスゲームはやはり難問。"},{"spoiler":false,"text":"なかなか決心がつかない。"},{"spoiler":false,"text":"そんなぬるま湯に降って沸いた災厄。己自身と向き合い、"},{"spoiler":false,"text":"少女達のために戦うことで臆病な王子は勇敢な真の王子に成長することが出来るか。"},{"spoiler":false,"text":"…それより前に人間に戻れる！？"}],"source":"egs","sourceCharacterId":"12103","sourceWorkId":"3944","spoiler":false},{"segments":[{"spoiler":false,"text":"理人は都内の私立校の3年生。結構裕福な家庭の一人っ子。"},{"spoiler":false,"text":"線の細い美少年系の容姿だが、なよなよしすぎ、女性的というわけではなく、それなりに少年らしい面も持っている。異性に対する好奇心も人並みにあるが、変態っぽくはない。どちらかといえば状況に流されるタイプ。"}],"source":"bangumi","sourceCharacterId":"27541"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6b7a2480cf22da817ec272642cf938177b749d68e093aa6194adf5a8ee42c05.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/9565543b8d5c87675aa7b3fcd3ded257da13daf860f3ddc61e121e7cdd30c363.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"杏露花梨","creatorId":"vndb:s2925","sourcePersonId":"vndb:s2925","canonicalEntityId":"vndb:s2925","name":"杏露 花梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22379:27541:21538:1","source":"bangumi"}]},{"characterId":"char_c55879","characterName":"嘉島 聖","sourceIds":{"bangumi":[{"characterId":"27536","match":"exact-normalized-name-in-linked-work","subjectId":"22379"},{"characterId":"27536","match":"exact-normalized-name-in-linked-work","subjectId":"47636"}],"egsCharacterIds":["12098"],"vndbCharacterId":"c55879"},"originalCharacterName":"嘉島 聖","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"3/31"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"B"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"しっかり者の幼馴染み"},{"spoiler":false,"text":"理人とは幼馴染みでクラスメート。"},{"spoiler":false,"text":"クラス委員を務めるようなまじめな優等生。"},{"spoiler":false,"text":"理人よりも年下ながらしっかり者。"},{"spoiler":false,"text":"時々頼りない理人の世話を焼くのが趣味（？）。"},{"spoiler":false,"text":"家庭科クラブ副部長。"}],"source":"egs","sourceCharacterId":"12098","sourceWorkId":"3009","spoiler":false},{"segments":[{"spoiler":false,"text":"理人とは幼馴染みでクラスメート。"},{"spoiler":false,"text":"まじめで心やさしい反面、決断依存症、"},{"spoiler":false,"text":"周りに気を使いすぎなど、"},{"spoiler":false,"text":"恋愛ゲームにとってかなり致命的な弱点を抱えている。"},{"spoiler":false,"text":"すでに幼馴染みのアドバンテージはなく、"},{"spoiler":false,"text":"むしろ家政婦扱いされて影薄まり中。"},{"spoiler":false,"text":"ただ最近では悲劇のヒロイン的状況を楽しんでもいるようである。"}],"source":"egs","sourceCharacterId":"12098","sourceWorkId":"3944","spoiler":false},{"segments":[{"spoiler":false,"text":"理人とは幼馴染みでお隣さんでクラスメート。"},{"spoiler":false,"text":"クラス委員を務めるようなまじめな優等生。"},{"spoiler":false,"text":"理人よりも年下ながらしっかり者。"},{"spoiler":false,"text":"ただし自分で何か決めるのは苦手。"},{"spoiler":false,"text":"家庭科クラブ副部長。"},{"spoiler":false,"text":"『最初に理人ちゃんのこと好きになったのはわたしだから――』"}],"source":"bangumi","sourceCharacterId":"27536"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0bf6e14ac18548d0b8f8fdcd512966d384208bcc2a90b16128a85601f7985a62.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/1199a93d2af344ab5b91b7d4508fef1f9d050b9c25297485170087c8443a13fb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中美智","creatorId":"vndb:s796","sourcePersonId":"vndb:s796","canonicalEntityId":"vndb:s796","name":"田中美智(多田美智)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22379:27536:6313:1","source":"bangumi"}]},{"characterId":"char_c55880","characterName":"姫史 愛生","sourceIds":{"bangumi":[{"characterId":"27537","match":"exact-normalized-name-in-linked-work","subjectId":"22379"},{"characterId":"27537","match":"exact-normalized-name-in-linked-work","subjectId":"47636"}],"egsCharacterIds":["12099"],"vndbCharacterId":"c55880"},"originalCharacterName":"姫史 愛生","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"O"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"甘え上手の関西娘"},{"spoiler":false,"text":"聖のいとこにあたる（母親同士が双子）。"},{"spoiler":false,"text":"関西生まれの関西育ち。"},{"spoiler":false,"text":"一人っ子で両親の溺愛の中育ったので、幼く甘えん坊。"},{"spoiler":false,"text":"聖になついていて、なにかあるとすぐ頼ってしまう。"},{"spoiler":false,"text":"甘え上手。今年入学で理人や聖よりニつ下の学年。"},{"spoiler":false,"text":"聖にくっついて家庭科部に入部。"}],"source":"egs","sourceCharacterId":"12099","sourceWorkId":"3009","spoiler":false},{"segments":[{"spoiler":false,"text":"聖のいとこにあたる（母親同士が双子）。"},{"spoiler":false,"text":"理人と聖にとっては妹のような存在。神戸生まれの神戸育ち。"},{"spoiler":false,"text":"資産家の両親の溺愛の中育った天衣無縫娘。"},{"spoiler":false,"text":"世界（特に理人と聖）は彼女を中心に回っている天動説支持者。"},{"spoiler":false,"text":"それでも葛城よりは大人だとの自負はあるようだ。"}],"source":"egs","sourceCharacterId":"12099","sourceWorkId":"3944","spoiler":false},{"segments":[{"spoiler":false,"text":"聖のいとこ（母親が双子）。関西生まれの関西育ち。"},{"spoiler":false,"text":"一人っ子で両親に溺愛されて育ったので甘え上手。"},{"spoiler":false,"text":"今年入学で理人や聖よりニつ下の学年。"},{"spoiler":false,"text":"聖にくっついて家庭科部に入部。"},{"spoiler":false,"text":"『理人兄ちゃんは愛生のん！』"}],"source":"bangumi","sourceCharacterId":"27537"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff9ae2eec8ae71eb8e419e74647c83023a343891c1635e71bccd6e148787f7c9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af3c1d855ec10425e08f62e9b587fef48ffdf2281b9fe76f26c4b70a1f05df32.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐々木あかり","creatorId":"vndb:s1575","sourcePersonId":"vndb:s1575","canonicalEntityId":"vndb:s1575","name":"佐々木あかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22379:27537:19495:1","source":"bangumi"}]},{"characterId":"char_c55881","characterName":"逢坂 遥奈","sourceIds":{"bangumi":[{"characterId":"27538","match":"exact-normalized-name-in-linked-work","subjectId":"22379"},{"characterId":"27538","match":"exact-normalized-name-in-linked-work","subjectId":"47636"}],"egsCharacterIds":["12101"],"vndbCharacterId":"c55881"},"originalCharacterName":"逢坂 遥奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"1/15"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"AB"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"おっとり不思議系"},{"spoiler":false,"text":"家庭科部の後輩。"},{"spoiler":false,"text":"ゆったりとした話ぶりと態度で周りに暖かな雰囲気が出来る。"},{"spoiler":false,"text":"普段はのんきでとぼけた感じだが、以外とシビアで大人な一面も。"},{"spoiler":false,"text":"メガネさん。"}],"source":"egs","sourceCharacterId":"12101","sourceWorkId":"3009","spoiler":false},{"segments":[{"spoiler":false,"text":"家庭科部の後輩。"},{"spoiler":false,"text":"上品な話ぶりだが発言は結構辛らつ。"},{"spoiler":false,"text":"プリンセスゲームについての造詣も深いが、"},{"spoiler":false,"text":"最近はどこか一歩退いた感じ。"},{"spoiler":false,"text":"病弱な母親や奈帆という妹がいたりいなかったり、"},{"spoiler":false,"text":"葛城にちょっかいをかけてみたりと何が本当で嘘なの"},{"spoiler":false,"text":"かわからない謎多き女。"},{"spoiler":false,"text":"寝起きが超悪いのだけは真実。"}],"source":"egs","sourceCharacterId":"12101","sourceWorkId":"3944","spoiler":false},{"segments":[{"spoiler":false,"text":"家庭科部の後輩。メガネさん。"},{"spoiler":false,"text":"普段はのんきでとぼけた感じだが、以外とシビアで大人な一面も。"},{"spoiler":false,"text":"『わたし、気が長いのがとりえなんです。"},{"spoiler":false,"text":"だから・・・いくらでも、いくらでも、いくらでも待てますから――』"}],"source":"bangumi","sourceCharacterId":"27538"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6bf6e41d766b9502c336d629b9c021103e652c9ccdc5d2c0626e0c789a058ee4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98b14c9d57e53a60437ee4c296d60cf12233492f6d090d5ea7780765fff52f80.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"