{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"27917","model":{"presentationWorkId":"vndb:v25709","staff":{"artwork":[{"creditedName":"小宮山","creatorId":"vndb:s5302","sourcePersonId":"egs:creator:18304","canonicalEntityId":"vndb:s5302","name":"小宮山","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:208555","source":"egs"}],"scenario":[{"creditedName":"ボックマン","creatorId":"vndb:s18500","sourcePersonId":"egs:creator:33964","canonicalEntityId":"vndb:s18500","name":"ボックマン","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:208556","source":"egs"}],"music":[],"other":[{"creditedName":"SION","creatorId":"vndb:s4166","sourcePersonId":"egs:creator:17975","canonicalEntityId":"vndb:s4166","name":"SION","detail":"OP曲「shadow on light」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:209804","source":"egs"},{"creditedName":"SION","creatorId":"vndb:s4166","sourcePersonId":"vndb:s4166","canonicalEntityId":"vndb:s4166","name":"SION","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:157136","source":"vndb"}]},"cast":[{"characterId":"char_c84894","characterName":"ゆーり","sourceIds":{"bangumi":[{"characterId":"70882","match":"exact-normalized-name-in-linked-work","subjectId":"286446"}],"egsCharacterIds":["21558"],"vndbCharacterId":"c84894"},"originalCharacterName":"ゆーり","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"日向のように可愛らしく、純粋で少しドジな女の子。"},{"spoiler":false,"text":"性には疎く、ドラマでキスシーンを見ただけでドキドキしてしまう。"},{"spoiler":false,"text":"恋に興味が無いわけではないが積極的ではなく、そういった話も今までゼロ。"},{"spoiler":false,"text":"初恋もまだ。ゆえに「レズなの？」とからかわれる事も。"},{"spoiler":false,"text":"そんな、どちらかと言えば目立たない普通の女の子だったが、謎の小動物≪テンタ≫と出会うと、自分を変えたいという強い思いから魔法少女となる。"},{"spoiler":false,"text":"魔法少女時の武器はロッド。"},{"spoiler":false,"text":"魔法放出に優れた杖状の武器だが、そもそものゆーりの魔力が弱いため、小さな魔物を倒すのにも一苦労する。"},{"spoiler":false,"text":"他の魔法少女たちからも戦力としてあてにならないと見られており、本人も自信を持てずにいる。"}],"source":"egs","sourceCharacterId":"21558","sourceWorkId":"27917","spoiler":false},{"segments":[{"spoiler":false,"text":"日向のように可愛らしく、純粋で少しドジな女の子。"},{"spoiler":false,"text":"性には疎く、ドラマでキスシーンを見ただけでドキドキしてしまう。"},{"spoiler":false,"text":"恋に興味が無いわけではないが積極的ではなく、そういった話も今までゼロ。"},{"spoiler":false,"text":"初恋もまだ。ゆえに「レズなの？」とからかわれる事も。"},{"spoiler":false,"text":"そんな、どちらかと言えば目立たない普通の女の子だったが、"},{"spoiler":false,"text":"謎の小動物≪テンタ≫と出会うと、自分を変えたいという強い思いから魔法少女となる。"},{"spoiler":false,"text":"その思いのきっかけとなったのは、魔物に襲われた際、"},{"spoiler":false,"text":"自分を助けてくれた魔法少女であるが、"},{"spoiler":false,"text":"当人はそれが≪希依音≫である事にはに気付いていない。"},{"spoiler":false,"text":"魔法少女時の武器はロッド。"},{"spoiler":false,"text":"魔法放出に優れた杖状の武器だが、そもそもの夢莉の魔力が弱いため、"},{"spoiler":false,"text":"小さな魔物を倒すのにも一苦労する。"},{"spoiler":false,"text":"他の魔法少女たちからも最弱と蔑まれており、"},{"spoiler":false,"text":"本人も人助けができない情けない魔法少女だと自覚する。"},{"spoiler":false,"text":"それでも、友達と家族という大切な人に危険が及ぶと、"},{"spoiler":false,"text":"身を呈して立ち向かう事の出来る心の強さと優しさを持っている。"},{"spoiler":false,"text":"子供の頃から多少の習い事をしてきたが、特に打ち込めたものはなく、"},{"spoiler":false,"text":"自分はなにも成し遂げられない人間じゃないかという不安と悩みを抱いている。"},{"spoiler":false,"text":"だが、『魔法少女としての役割を果たすために強くなる』という"},{"spoiler":false,"text":"目標を見つけてからは、ひたむきに鍛錬にいそしみ、魔物たちと対峙する。"},{"spoiler":false,"text":"「うぅ。こ、怖いけど……。でも、ゆーりがやらなきゃ……みんなを助けなきゃ……！」"}],"source":"bangumi","sourceCharacterId":"70882"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"21558","sourceWorkId":"27917","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"21558","sourceWorkId":"27917","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/211bc67378a5e5e7d5a8c788d871e5e5b51ba5f5867d3a23604b02057cdea70b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f8723da250b75ffc779333570cebadfd68c304d3f2646be369bb6315853a37a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"清水美紗","creatorId":"vndb:s1975","sourcePersonId":"vndb:s1975","canonicalEntityId":"vndb:s1975","name":"よもぎかすみ(蓬かすみ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:286446:70882:21151:1","source":"bangumi"}]},{"characterId":"char_c84895","characterName":"榊 希依音","sourceIds":{"bangumi":[{"characterId":"70883","match":"exact-normalized-name-in-linked-work","subjectId":"286446"}],"egsCharacterIds":["21559"],"vndbCharacterId":"c84895"},"originalCharacterName":"榊 希依音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"凛とした目つきが特徴の、ストイックで冷静沈着で優等生な女の子。"},{"spoiler":false,"text":"一枚の絵から飛び出して来たように端麗な容姿をしているが、常に周囲を見下した態度を取り、突き放した話し方をする事から、学園内では変り者として距離を置かれている。"},{"spoiler":false,"text":"自身も他人に興味がなく、誰にでも冷酷ともとれる態度を取る。"},{"spoiler":false,"text":"喜びを表現するのが苦手で、人の好意を素直に受け止められない。"},{"spoiler":false,"text":"だが、カワイイものを前にするとデレてしまう一面も。"},{"spoiler":false,"text":"魔法少女時の武器はレイピア。"},{"spoiler":false,"text":"頭脳明晰さと運動神経の良さで沈着冷静に状況を判断し、その鋭い切っ先で相手を切り刻み、大胆な一撃でとどめを刺して残忍なまでに戦う。"}],"source":"egs","sourceCharacterId":"21559","sourceWorkId":"27917","spoiler":false},{"segments":[{"spoiler":false,"text":"凛とした目つきが特徴の、ストイックで冷静沈着で優等生な女の子。"},{"spoiler":false,"text":"同性からも異性からもモテるが、なんとなく近づき難いため、声をかけられない。"},{"spoiler":false,"text":"自身も他人に興味がなく、誰にでも冷酷ともとれる態度を取る。"},{"spoiler":false,"text":"喜びを表現するのが苦手で、人の好意を素直に受け止められない。"},{"spoiler":false,"text":"だが、カワイイものを前にするとデレてしまう一面も。"},{"spoiler":false,"text":"魔法少女時の武器はレイピア。"},{"spoiler":false,"text":"頭脳明晰さと運動神経の良さで沈着冷静に状況を判断し、"},{"spoiler":false,"text":"その鋭い切っ先で相手を切り刻み、大胆な一撃でとどめを刺して残忍なまでに戦う。"},{"spoiler":false,"text":"両親と共に魔物に襲われてしまい、ただひとり生き延びたという過去を持つ。"},{"spoiler":false,"text":"その時から、魔法少女となり力を得ることを望んでいた。"},{"spoiler":false,"text":"そして、その力を手に入れてからは、魔物を屠れるのは魔法少女のみであり、"},{"spoiler":false,"text":"戦う事が自分の使命であると強く信じ込んでいる。"},{"spoiler":false,"text":"その高い能力と、ケタ違いの撃破数に周囲の魔法少女たちからは畏れられ、"},{"spoiler":false,"text":"一目置かれている。"},{"spoiler":false,"text":"だが一方で、触手の快感に身を委ね、"},{"spoiler":false,"text":"嬉々として異形魔物出産をしてみせる事もあるというが……？"},{"spoiler":false,"text":"「そう。あなたがそうしたいなら、そうすればいいわ。惨めに死でもかまわなければね」"}],"source":"bangumi","sourceCharacterId":"70883"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"21559","sourceWorkId":"27917","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"21559","sourceWorkId":"27917","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e6ecd6ca490a8479ca420a293d6bc11e367bba758c3469d90155f5ee3775ab1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42e7da14436e5ff33d94f6ecc55d346ebf3e403ea2f461edba4bcaa2b66ebed7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘美月","creatorId":"vndb:s4602","sourcePersonId":"vndb:s4602","canonicalEntityId":"vndb:s4602","name":"橘 美月","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:286446:70883:30961:1","source":"bangumi"}]