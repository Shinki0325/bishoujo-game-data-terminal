"source-native","relationId":"vndb:vn-staff:23571","source":"vndb"},{"creditedName":"瀬之本 久史","creatorId":"vndb:s1414","sourcePersonId":"vndb:s1414","canonicalEntityId":"vndb:s1414","name":"瀬之本 久史","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:23572","source":"vndb"},{"creditedName":"iyuna","creatorId":"vndb:s1416","sourcePersonId":"vndb:s1416","canonicalEntityId":"vndb:s1416","name":"iyuna","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:23576","source":"vndb"},{"creditedName":"天ヶ咲 麗","creatorId":"vndb:s4314","sourcePersonId":"vndb:s4314","canonicalEntityId":"vndb:s4314","name":"天ヶ咲 麗","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:23578","source":"vndb"},{"creditedName":"茉白","creatorId":"vndb:s17090","sourcePersonId":"vndb:s17090","canonicalEntityId":"vndb:s17090","name":"茉白","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:23579","source":"vndb"}]},"cast":[{"characterId":"char_c12097","characterName":"アルエ","sourceIds":{"bangumi":[{"characterId":"12016","match":"exact-normalized-name-in-linked-work","subjectId":"11259"}],"egsCharacterIds":["18761"],"vndbCharacterId":"c12097"},"originalCharacterName":"アルエ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"王位継承権を持つ、王国の第四王女。"},{"spoiler":false,"text":"正式名は「アルエミーナ・リューシー・テクスフォルト・ゼフィランス」。"},{"spoiler":false,"text":"高潔で正義を重んじる性格だが、同時に世間知らずで負けず嫌い。"},{"spoiler":false,"text":"「知らない」「出来ない」「助けてほしい」などの言葉を素直に言えず、知ったかぶりしてボロを出すこともしばしば。"},{"spoiler":false,"text":"普段は、常に男装しており、自分のことも「ボク」と呼ぶ。"},{"spoiler":false,"text":"本人曰く「本当はボクは男なんだ。呪いをかけられて女の姿にされたんだ」"},{"spoiler":false,"text":"とのことだが……？"},{"spoiler":false,"text":"「なんとしても――ボクは、男に戻るんだっ！」"}],"source":"egs","sourceCharacterId":"18761","sourceWorkId":"10447","spoiler":false},{"segments":[{"spoiler":false,"text":"全名为アルエミーナ・リューシー・テクスフォルト・ゼフィランス。"},{"spoiler":false,"text":"テクスフォルト王国的第4公主、拥有王位继承权的少女。"},{"spoiler":false,"text":"父亲为现任国王，母亲为侧室（已故）。"},{"spoiler":false,"text":"从小就生活在王都这一远离世事之地，过着无拘无束的生活。"},{"spoiler":false,"text":"高洁而重正义的性格。不服输。"},{"spoiler":false,"text":"不懂平民生活、当然也不懂乡下生活的超级不懂世事。"},{"spoiler":false,"text":"不过也有不懂装懂乱说一通的可爱之处。"},{"spoiler":false,"text":"无法老实地说出「我不知道」「我做不到」「救救我」等话语。"},{"spoiler":false,"text":"希望自立，只是因为出身于温室之中，无论做什么事都是失败。"},{"spoiler":false,"text":"平时穿着男装，自称也是「ボク」。"},{"spoiler":false,"text":"对周围的人声称「其实我真的是个男的，因为被诅咒了才会变成女的」。"},{"spoiler":false,"text":"要知道这个是真还是假，随着故事的发展你就会知道了……"}],"source":"bangumi","sourceCharacterId":"12016"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/474221b997dcb06078e242f60f8f276587f1a9775664c4352e201f76c1959c5a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3ab2c04de2253c21755ee45a370134a328589172cbd3863572070a978483b74f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"島村香織","creatorId":"vndb:s1070","sourcePersonId":"vndb:s1070","canonicalEntityId":"vndb:s1070","name":"島村 香織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11259:12016:5938:1","source":"bangumi"}]},{"characterId":"char_c12101","characterName":"ロコナ","sourceIds":{"bangumi":[{"characterId":"12017","match":"exact-normalized-name-in-linked-work","subjectId":"11259"}],"egsCharacterIds":["18762"],"vndbCharacterId":"c12101"},"originalCharacterName":"ロコナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ポルカ村の娘で、辺境警備隊に属する唯一の兵士。"},{"spoiler":false,"text":"純真で素直、人を疑うことを知らない性格で、周囲にウソを吹き込まれて遊ばれるタイプ。"},{"spoiler":false,"text":"加えて、近衛騎士団出身のリュウを敬愛、神格化していることから、リュウが何をやっても信じてしまう。"},{"spoiler":false,"text":"普段は兵舎で暮らしており、手先が器用で料理もお手の物。"},{"spoiler":false,"text":"「初めてお会いしたとき、ぴぴーんときましたっ！」"}],"source":"egs","sourceCharacterId":"18762","sourceWorkId":"10447","spoiler":false},{"segments":[{"spoiler":false,"text":"村里的少女中，唯一一个隶属于边境警备队的兵士。"},{"spoiler":false,"text":"性格老实而不怀疑别人。"},{"spoiler":false,"text":"属于深信周围的人的玩笑、被人玩弄的类型。"},{"spoiler":false,"text":"在主人公未上任之前就一直崇拜神化出身于近卫骑士团的他。"},{"spoiler":false,"text":"因此，即使主人公做了什么傻事，都会相信「这个行动肯定有什么深意！」。"},{"spoiler":false,"text":"家人只有住在村里的老婆婆ヨーヨード一人而已。"},{"spoiler":false,"text":"了解地理与动物，手很巧。"},{"spoiler":false,"text":"擅长料理，精通边境很多菜肴的烹饪方法。"},{"spoiler":false,"text":"虽然不能干体力活，但刚好能干些细活。现在住在兵营中。"}],"source":"bangumi","sourceCharacterId":"12017"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2acca53766e9e9d91a5899e77e17363fda57f1256143c548ccfe4fe9bb866f6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/402968fca075d9943d33366cabcc210b9923c72e52bfebec43e154495362bbcd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"力丸乃りこ","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11259:12017:4689:1","source":"bangumi"}]},{"characterId":"char_c12108","characterName":"ミント・テトラ","sourceIds":{"bangumi":[{"characterId":"10909","match":"exact-normalized-name-in-linked-work","subjectId":"11259"}],"egsCharacterIds":["18764"],"vndbCharacterId":"c12108"},"originalCharacterName":"ミント・テトラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"王都の貧乏商家「テトラ商店」の経営者にして、ただ一人の従業員。"},{"spoiler":false,"text":"「チャンスを掴んで一攫千金」「細かいゼニからコツコツと」と頑張っているが、経営者としての手腕は微妙で、今一つ成功しない。"},{"spoiler":false,"text":"かなりの守銭奴っ娘だが、肝心な時には、「金に使われるな、金を使え」との家訓を、迷わず実行できるタイプでもある。"},{"spoiler":false,"text":"噂話、ゴシップ大好きで周りを引っ張りまわす迷惑少女だが、なぜかその行動は憎めない。"},{"spoiler":false,"text":"「いっひ♪　大もうけの匂いがしますなぁ♪」"}],"source":"egs","sourceCharacterId":"18764","sourceWorkId":"10447","spoiler":false},{"segments":[{"spoiler":false,"text":"王都中贩卖杂货的贫穷商家「テトラ商会」中，唯一一个全权经营者兼从业员。"},{"spoiler":false,"text":"虽然有着「把握机会、一本万利」的意气，不过因为没什么经营头脑，经常屡战屡败。"},{"spoiler":false,"text":"抱着「所谓经商，就是抓住细处不放手」的信条，只要事关金钱就会不择手段的天生守财奴。"},{"spoiler":false,"text":"但是，遵守着家训「了解关键时刻用钱的方法，不要被金钱所奴役，而应该奴役金钱」。"},{"spoiler":false,"text":"喜欢八卦新闻，运用自己知道的传闻把大家耍着玩的麻烦女生，不过不知为什么，讨厌不起她来。"}],"source":"bangumi","sourceCharacterId":"10909"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e26ac443ba3817ebbf61c3fbd47c1399e37ac00af74b9029d66787c30f872606.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10ee3c7ecd5f77079aecc293f649cde10ae06b4afcac71767fa246aeb16df5db.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11259:10909:5890:1","source":"bangumi"}]},{"characterId":"char_vndb_c12098","characterName":"モニカ","sourceIds":{"vndbCharacterId":"c12098"},"originalCharacterName":"モニカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"