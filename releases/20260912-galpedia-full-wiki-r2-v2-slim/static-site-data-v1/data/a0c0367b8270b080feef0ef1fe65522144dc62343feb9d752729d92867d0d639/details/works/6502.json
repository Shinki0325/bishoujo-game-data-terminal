db","sourceCharacterId":"c13854"},{"segments":[{"spoiler":false,"text":"桜美の同級生で、芹人の後輩。"},{"spoiler":false,"text":"無口であたり触りのない発言が多く、リアクションも薄い。"},{"spoiler":false,"text":"しかし、学業は優秀で、特に近代史は教師より知っていたりする事も。"},{"spoiler":false,"text":"人形（フィギュア・ぬいぐるみなど）にめっぽう弱く、クレーンゲームや玩具屋の前で、足を止めている姿をしばしば見かける。"},{"spoiler":false,"text":"「オルゴールはいつまでも同じメロディーを繰り返すの……なんだか、私みたい」"}],"source":"egs","sourceCharacterId":"17678","sourceWorkId":"11190","spoiler":false},{"segments":[{"spoiler":false,"text":"林海学園サーバント科1年。"},{"spoiler":false,"text":"桜美の同級生で芹人の後輩。桜美の能天気さに巻き込まれる形で、芹人たちとの人間関係に付き合うことになる。"},{"spoiler":false,"text":"無口であたり触りのない発言が多く、リアクションは薄い。"},{"spoiler":false,"text":"学業は優秀。特に近代史が得意で、教師よりもよく知っていたりすることも……。"},{"spoiler":false,"text":"フィギュアやヌイグルミ等、人形と言えるものにめっぽう弱いらしく、クレーンゲーム機や玩具屋の前で足を止めている様をしばしば見かける。"},{"spoiler":false,"text":"「オルゴールはいつまでも同じメロディーを繰り返すの……なんだか、私みたい。」"}],"source":"bangumi","sourceCharacterId":"137618"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa97452369c1bb3aa934865b072f5a62074ad07e8a2405ffb02e9b667937ca99.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e708e416e388f17c49efa0d27d91246aaad03737c0e50389a104112f294f6049.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高野直子","creatorId":"vndb:s14","sourcePersonId":"vndb:s14","canonicalEntityId":"vndb:s14","name":"高野 直子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217791:137618:4031:1","source":"bangumi"}]},{"characterId":"char_c17797","characterName":"三ツ峰 楓","sourceIds":{"bangumi":[{"characterId":"137619","match":"exact-normalized-name-in-linked-work","subjectId":"217792"}],"egsCharacterIds":["17672"],"vndbCharacterId":"c17797"},"originalCharacterName":"三ツ峰 楓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"502"},"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Classmate of the protagonist. Kaede is a refined and honorable lady who always follow the rules of etiquette and doesn't allow herself anything frivolous. Sometimes it's hard to understand, if she's completely indifferent to the love relationships or hides her feelings skillfully."}],"source":"vndb","sourceCharacterId":"c17797"},{"segments":[{"spoiler":false,"text":"芹人たちジェントリー科の、数少ない女子ぼクラスメイトで、英国領彩玉の西部・知々夫地方の有力者“三ツ峰家”のご令嬢。"},{"spoiler":false,"text":"社交的なタイプだが、どんなことにも社交的すぎるため、何を言っても社交辞令に聞こえてしまい、そっけなく見える。"},{"spoiler":false,"text":"家訓を重んじ、家のことを何より大事に考えているようだ。"},{"spoiler":false,"text":"「どうして？　速水家のご子息のお誘いなら、断るわけにはいかないでしょう？」"}],"source":"egs","sourceCharacterId":"17672","sourceWorkId":"11190","spoiler":false},{"segments":[{"spoiler":false,"text":"林海学園ジェントリー科2年。"},{"spoiler":false,"text":"芹人や桂、目黒たちの数少ない女子のクラスメイト。"},{"spoiler":false,"text":"英国領・彩玉の西部に位置する、知々夫地方の有力なジェントリー・三ツ峰家のご令嬢。"},{"spoiler":false,"text":"社交的な性格だが、社交的すぎてなにを言っても社交辞令に聞こえてしまうため、そっけなく見えることも。"},{"spoiler":false,"text":"家訓を重んじており、家のことをなにより大事に考えている。"},{"spoiler":false,"text":"サーバント科に長瀞という専属の付き人が通っている。"},{"spoiler":false,"text":"「どうして？　速水家のご子息のお誘いなら断るわけにはいかないでしょう？」"}],"source":"bangumi","sourceCharacterId":"137619"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbd443c099d7242d6a657e5f6d649f608fb177c623a465b7d668663f5861c2ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78740150d6c76fb9e57e31f160a05dde4a2533462796f36af37f38bdd3392672.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"四方田 美華","creatorId":"vndb:s1422","sourcePersonId":"vndb:s1422","canonicalEntityId":"vndb:s1422","name":"四方田 美華","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:3884","source":"vndb"}]},{"characterId":"char_c17798","characterName":"速水 桜美","sourceIds":{"bangumi":[{"characterId":"137613","match":"exact-normalized-name-in-linked-work","subjectId":"217791"},{"characterId":"137613","match":"exact-normalized-name-in-linked-work","subjectId":"217792"}],"egsCharacterIds":["17673"],"vndbCharacterId":"c17798"},"originalCharacterName":"速水 桜美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"403"},"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園長の義理の孫にして、芹人の義妹。"},{"spoiler":false,"text":"天真爛漫な性格にあどけない容姿と、外内ともにまだまだ子供だが、それを指摘されると、怒る、拗ねる、膨れる。"},{"spoiler":false,"text":"“速水家”の跡取りである兄と一緒にいたいため、メイドの道を選ぶが、サーバントクラスではオチこぼれ気味。"},{"spoiler":false,"text":"「ボクね、お兄ちゃんのメイドになるんだ。そうすればずっと一緒にいられるでしょ」"}],"source":"egs","sourceCharacterId":"17673","sourceWorkId":"11190","spoiler":false},{"segments":[{"spoiler":false,"text":"林海学園サーバント科1年。"},{"spoiler":false,"text":"林海学園学園長の義理の孫にして、主人公の義妹。"},{"spoiler":false,"text":"天真爛漫なその性格に違わず○○っぽい容姿と味覚をしているが、そのことを指摘すると怒る、拗ねる、膨れる。"},{"spoiler":false,"text":"速水家の跡取りである芹人とずっと一緒にいたいがために、メイドになることを決意！　サーバントクラスでメイドへの道を学ぶ今日に至る。ただし、学園ではオチこぼれ気味。"},{"spoiler":false,"text":"「ボクね、お兄ちゃんのメイドになるんだ。そうすればずっと一緒にいられるでしょ？」"}],"source":"bangumi","sourceCharacterId":"137613"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04104db46f6887957d0f2f4ab772c879d30334c23bd4529e709a51d8a555e66b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f0e4d6dc1316dd446f7f8519ca26076eb3533d3e1a810894111006879965948.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217791:137613:4463:1","source":"bangumi"}]},{"characterId":"char_c17799","characterName":"久留間 藤","sourceIds":{"bangumi":[{"characterId":"137614","match":"exact-normalized-name-in-linked-work","subjectId":"217791"},{"characterId":"137614","match":"exact-normalized-name-in-linked-work","subjectId":"217792"}],"egsCharacterIds":["17674"],"vndbCharacterId":"c17799"},"originalCharacterName":"久留間 藤","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"505"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"マイペースな、天然系の女の子。"},{"spoiler":false,"text":"幼い頃から実家（団子屋）のお使いで“速水家”に出入りしていて、家計を支えるため、メイドになることを目指している。"},{"spoiler":false,"text":"甘いもの（主にあんこ）とテレビをこよなく愛し、特に「昼ドラ」視聴タイムは、何人たりとも邪魔を許されないらしい。"},{"spoiler":false,"text":"「アンコの好きな人に悪い人はいません！　……昔の人も言ってますよぅ！」"}],"source":"egs","sourceCharacterId":"17674","sourceWorkId":"11190","spoiler":false},{"segments":[{"spoiler":false,"text":"林海学園サーバント科2年。"},{"spoiler":false,"text":"実家は団子屋。○○の頃から家のお使いで速水家に出入りし、芹人と仲良くなった。"},{"spoiler":false,"text":"家計を支えるために、メイドになることを目指す。"},{"spoiler":false,"text":"どこかぼけぼけしているマイペース娘だが、時として強引なことも……。"},{"spoiler":false,"text":"甘いもの（主にあんこ）が好きで、テレビ大好き。特に昼ドラにハマっており、その時間を邪魔することは何人たりとも許されないらしい。"},{"spoiler":false,"text":"「アンコの好きな人に悪い人はいません！　……昔の人も言ってますよぅ！」"}],"source":"bangumi","sourceCharacterId":"137614"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f92d30fd2be77dbd3e82471cafc30768f3a41f43c626b629a77a0339c829cb9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91e5c52f3c0ca59206699a0e829ca07b09fcbd9777c639e3feb9fbe8d3b5be9c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217791:137614:4956:1","source":"bangumi"},{"creditedName":"長崎 みなみ","creatorId":"vndb:s1073","sourcePersonId":"vndb:s1073","canonicalEntityId":"vndb:s1073","name":"長崎 みなみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:3883","source":"vndb"},{"creditedName":"石毛 佐和","creatorId":"vndb:s2222","sourcePersonId":"vndb:s2222","canonicalEntityId":"vndb:s2222","name":"石毛 佐和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:3887","source":"vndb"}]},{"cha