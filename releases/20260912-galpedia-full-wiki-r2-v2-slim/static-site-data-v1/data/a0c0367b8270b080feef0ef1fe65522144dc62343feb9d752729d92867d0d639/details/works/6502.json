iler":false,"text":"「紳士たるもの、立場を弁えてくださいまし」"}],"source":"egs","sourceCharacterId":"17677","sourceWorkId":"11190","spoiler":false},{"segments":[{"spoiler":false,"text":"林海学園特別講師。"},{"spoiler":false,"text":"本職は速水家のメイドであり、速水家ナンバー2のメイド長として現場のメイドたちを仕切る。"},{"spoiler":false,"text":"速水家に仕える名家・馴実家の息女で、高い教育を受けてきたインテリ層。"},{"spoiler":false,"text":"まじめで厳格な一面を持ち、学生や他のメイドたちからは立派なメイドとして尊敬されている。"},{"spoiler":false,"text":"非常にグラマラスなスタイルと色香の持ち主。だが周辺に男気はいっさい見えず、周囲からは宝の持ち腐れと揶揄されることもある模様。"},{"spoiler":false,"text":"「紳士たるもの、立場を弁えてくださいまし。」"}],"source":"bangumi","sourceCharacterId":"137617"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51c1bbf85ef3a65eee106955d87affd0c56cf221bf81c877a748e9b43161f4c8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b17177cf3ed97ab35270d36227ffb1a70966bc4616604de7cf949589ff121f9e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黒河奈美","creatorId":"vndb:s1062","sourcePersonId":"vndb:s1062","canonicalEntityId":"vndb:s1062","name":"本山美奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217791:137617:4754:1","source":"bangumi"}]},{"characterId":"char_c17802","characterName":"岡 クララ 直海","sourceIds":{"bangumi":[{"characterId":"137615","match":"exact-normalized-name-in-linked-work","subjectId":"217791"},{"characterId":"137615","match":"exact-normalized-name-in-linked-work","subjectId":"217792"}],"egsCharacterIds":["17675"],"vndbCharacterId":"c17802"},"originalCharacterName":"岡 クララ 直海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"605"},"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState