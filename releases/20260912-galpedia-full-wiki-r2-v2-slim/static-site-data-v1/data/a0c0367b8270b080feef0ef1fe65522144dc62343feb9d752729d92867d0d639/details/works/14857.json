/2d/2d052c04dfdaad4b31deb130572bb288a60928c08f4eef27165b1c6359c71643.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"堀川 忍","creatorId":"vndb:s392","sourcePersonId":"vndb:s392","canonicalEntityId":"vndb:s392","name":"宮下 栄治","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33690","source":"vndb"}]},{"characterId":"char_vndb_c67861","characterName":"彩香","sourceIds":{"vndbCharacterId":"c67861"},"originalCharacterName":"彩香","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf580d8de4f00bd7d71c65d145fc68cdc8f39776f70c80129e1dd4dbc7949b53.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71f6b78cfda79856723d964826d8c1e04629181cff0571700ba264c0dc5bac39.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安 ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33685","source":"vndb"}]},{"characterId":"char_vndb_c77583","characterName":"ふわり","sourceIds":{"vndbCharacterId":"c77583"},"originalCharacterName":"ふわり","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Fuwari is a strange and mysterious girl who often plays in the park. Seems to be very happy, but she seems unreal..."},{"spoiler":true,"text":"Her real identity is Tachibana Kaju (橘 花珠), she was the big sister of the real Fuwari and died in the same accident that put her little sister in a coma."}],"source":"vndb","sourceCharacterId":"c77583"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2534871c01f5c6a4e5c541c261544ab2c8e150d8f218d5f338bfb6716a5aefa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37eecadad37f785dc77b0b3c1c9200777a2bff5767232ed2741aba746c3d9a96.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"まき いづみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:33689","source":"vndb"}]},{"characterId":"char_vndb_c77621","characterName":"ちろる","sourceIds":{"vndbCharacterId":"c77621"},"originalCharacterName":"ちろる","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chiroru is the cat of Nene and the mascot of Sakurano dormitory. She is loved by all residents and tends to walk freely around the property."}],"source":"vndb","sourceCharacterId":"c77621"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80434feb7c6c38734a076abb9a2a6ab31f271d3eb94b9f4618282140caf0bb52.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/519fe023f3e19ccadc40da1a74f2c91ba98a6e0bc4a6d29729251d1f400752ce.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c77630","characterName":"ぼく","sourceIds":{"vndbCharacterId":"c77630"},"originalCharacterName":"ぼく","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Rin's big brother in a post-apocalyptic future where human have evolved differently and where they were annihilated by their \"creations\". He has taken care of his little sister alone since their mother abandoned them so that they could survive because they represent the last hope of humanity."},{"spoiler":true,"text":"They live alone in Sakurano, devastated by the war, where they hide. His favorite hobby is reading and writing fantasy stories that end well, where everyone is happy and he teaches his sister the pleasure of reading stories."},{"spoiler":true,"text":"However, their peaceful life is interrupted one day. The machines found them and they are forced to flee."},{"spoiler":true,"text":"\"Nii-san\" is heavily injured during his fights to protect his sister and at the end of these, after having secured her, he begins to die peacefully..."},{"spoiler":true,"text":"Before giving his last breath, he attends to the miracle awaited by all humanity. The sadness and pain of losing her brother awakens Rin's power and she creates a new temporality where her brother would finally find happiness."},{"spoiler":true,"text":"He is currently reincarnated in the person of Yuuma."}],"source":"vndb","sourceCharacterId":"c77630"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/9972398be463c9c645f878f0c401fec215751eda72c3bc7fc58ae10057fd393c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5cb261b4454cb262da07ad63d25390c6f724ad67716c06951b91ce86a387a43a.webp","width":174,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c77631","characterName":"あいつら","sourceIds":{"vndbCharacterId":"c77631"},"originalCharacterName":"あいつら","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"n"}},"descriptions":[{"segments":[{"spoiler":true,"text":"The machines responsible for the death of human beings in the post-apocalyptic world."},{"spoiler":true,"text":"They are pitiable to all those they hunt."}],"source":"vndb","sourceCharacterId":"c77631"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/6451933657c47d177a524d35183ec1842b1a14fc55cc35f2dd12ae1e87cace0f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/505a78cb97d8b1dbc54c1e337c48571d6aab816179f0afc4caa9f1a177b1916e.webp","width":256,"height":248,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c77632","characterName":"あいつら","sourceIds":{"vndbCharacterId":"c77632"},"originalCharacterName":"あいつら","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"n"}},"descriptions":[{"segments":[{"spoiler":true,"text":"The machines responsible for the death of human beings in the post-apocalyptic world."},{"spoiler":true,"text":"They are pitiable to all those they hunt."}],"source":"vndb","sourceCharacterId":"c77632"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b67b74f3e6ba9eb91e7d8cf3354a296f23f2879fa009595cc2de338b27693870.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94b40cf6affbc4258992655993ae903c76619576debe82de574fddc7ea2bf10b.webp","width":235,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c77633","characterName":