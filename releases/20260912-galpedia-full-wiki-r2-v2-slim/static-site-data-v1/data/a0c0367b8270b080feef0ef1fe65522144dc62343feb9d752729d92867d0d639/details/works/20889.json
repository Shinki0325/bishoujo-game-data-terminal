r":false,"text":"変態で親友である本田を師匠と煽って彼から"},{"spoiler":false,"text":"色々とエロスを勉強している。ＤＴ同士であるが。"},{"spoiler":false,"text":"日ごろから妄想は欠かさず、夢はツンデレの超絶可愛い姫騎士と結婚する事。"},{"spoiler":false,"text":"当然そのためには異世界への勇者転送は欠かせない。"}],"source":"egs","sourceCharacterId":"4385","sourceWorkId":"20889","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_c22987","characterName":"シャロン・ガレリア","sourceIds":{"bangumi":[{"characterId":"168815","match":"exact-normalized-name-in-linked-work","subjectId":"109747"}],"egsCharacterIds":["4384"],"vndbCharacterId":"c22987"},"originalCharacterName":"シャロン・ガレリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"異世界アースガルドを治めるガレリアの王女。"},{"spoiler":false,"text":"隣国アルタイルとの戦争で父を亡くし、その心労から母は病死し、兄弟姉妹もいないので現在は天涯孤独の身。"},{"spoiler":false,"text":"王位継承権はシャロンにあるがアルタイルを討ち父の仇をとるまではと王位に就いていない。"},{"spoiler":false,"text":"文武に長けた美しき王女として国民の人気を集める。"},{"spoiler":false,"text":"どんな人にも優しく接するも、芯の通らない事や、なよなよしている様子が嫌いで、そういう人を見ると心を入れなおすように世話を焼く。"},{"spoiler":false,"text":"主人公に対しても、そういう態度をとっている。"},{"spoiler":false,"text":"〝魔法王”と畏れられるアルタイル国の国王ヴァンダイクとの戦いでは自ら軍を率いて勇戦する姿は〝姫騎士”と称される一時はヴァンダイクを追い詰める。"},{"spoiler":false,"text":"しかし勇戦敵わずヴァンダイクの卑劣な戦略で戦況は劣勢となり、ガレリア存亡の危機に直面して王国の危機を救うため勇者召喚を決意する。"}],"source":"egs","sourceCharacterId":"4384","sourceWorkId":"20889","spoiler":false},{"segments":[{"spoiler":false,"text":"異世界アースガルドを治めるガレリアの王女。"},{"spoiler":false,"text":"隣国アルタイルとの戦争で父を亡くし、その心労から母は病死し、兄弟姉妹もいないので現在は天涯孤独の身。"},{"spoiler":false,"text":"王位継承権はシャロンにあるがアルタイルを討ち父の仇をとるまではと王位に就いていない。"},{"spoiler":false,"text":"文武に長けた美しき王女として国民の人気を集める。"},{"spoiler":false,"text":"どんな人にも優しく接するも、芯の通らない事や、なよなよしている様子が嫌いで、そういう人を見ると心を入れなおすように世話を焼く。"},{"spoiler":false,"text":"主人公に対しても、そういう態度をとっている。"},{"spoiler":false,"text":"〝魔法王”と畏れられるアルタイル国の国王ヴァンダイクとの戦いでは自ら軍を率いて勇戦する姿は〝姫騎士”と称される一時はヴァンダイクを追い詰める。"},{"spoiler":false,"text":"しかし勇戦敵わずヴァンダイクの卑劣な戦略で戦況は劣勢となり、ガレリア存亡の危機に直面して王国の危機を救うため勇者召喚を決意する。"}],"source":"bangumi","sourceCharacterId":"168815"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6f78549b73711355d66715325a38de0947f13c96dc69ad8c623715a9f315a99.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1989a5585f13c347347920dbe94ea81a85500553a9ef5185eda710d66747eb2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘志穂","creatorId":"vndb:s738","sourcePersonId":"vndb:s738","canonicalEntityId":"vndb:s738","name":"橘 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:109747:168815:7169:1","source":"bangumi"}]},{"characterId":"char_vndb_c155975","characterName":"本田 健","sourceIds":{"vndbCharacterId":"c155975"},"originalCharacterName":"本田 健","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a7e624b1f38c009927cfb01be055116829121c845f1931d77a04b540f49241b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c90a1a252b67b8a5fdacc365d3cc4343cf3758c4346490ecb9d52dd58e0ed85.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c155977","characterName":"三輪 曙","sourceIds":{"vndbCharacterId":"c155977"},"originalCharacterName":"三輪 曙","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metada