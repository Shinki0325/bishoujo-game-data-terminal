source-only","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The daughter of the famous Mitsuki family, who is famous in the area where the main character lives."},{"spoiler":false,"text":"She is a talented and athletic woman who is busy with her studies and lessons."},{"spoiler":false,"text":"She fell in love with subculture because of her suffocation and inconvenience in her daily life, and awoke to her cosplay hobby."},{"spoiler":false,"text":"She especially loves her masterpiece \"Time's Aegis -Another Mission-\", which was broadcast in her past and is known to those in the know, and she likes the cosplay of her heroine, Hiiragi Reese."},{"spoiler":false,"text":"However, all my friends are young ladies."},{"spoiler":false,"text":"I didn't have any acquaintances who were interested in subculture and could share my hobbies, so I took the initiative to participate in the event for the first time in my own costume."},{"spoiler":false,"text":"There she had a fateful encounter with the main character."}],"source":"vndb","sourceCharacterId":"c105655"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40797bda7e3617ef237231a7a4bf0f8c0216b7f68b75ef52271dd203819d3c31.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/ac67b8f4b6e6febc6f2ba4282688ab0553192a5b3ad552cfddc6d190a36c81e9.webp","width":188,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中 みかん","creatorId":"vndb:s943","sourcePersonId":"vndb:s943","canonicalEntityId":"vndb:s943","name":"野中みかん(尾野山みか)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:90799","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p8789","sourceCompanyId":"egs:brand:7227","canonicalEntityId":"vndb:p8789","name":"iMel","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"