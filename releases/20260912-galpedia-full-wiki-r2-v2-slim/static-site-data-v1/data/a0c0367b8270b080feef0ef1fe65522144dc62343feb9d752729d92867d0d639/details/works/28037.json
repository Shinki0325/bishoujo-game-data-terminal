e8725cf02e98f1bdd7c0ba6cde523f22cce94a988d971832bb61f0f92d0df8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間宮菜南子","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:289565:71487:15995:1","source":"bangumi"}]},{"characterId":"char_c84601","characterName":"渡瀬 乙葉","sourceIds":{"bangumi":[{"characterId":"71488","match":"exact-normalized-name-in-linked-work","subjectId":"289565"}],"egsCharacterIds":["21628"],"vndbCharacterId":"c84601"},"originalCharacterName":"渡瀬 乙葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mother of the family."},{"spoiler":false,"text":"Still in her mid-thirties, she is a gorgeous woman with a pretty face and a voluptuous body."},{"spoiler":false,"text":"At work, she is respected as a stern career woman, but at home, she is a soft person who jokes around and shows a kind expression."},{"spoiler":false,"text":"At home, she is naturally cheerful and carefree, such as taking a nap on the sofa. She lacks skills in housework, and while she did it when her daughters were young, she now leaves it all to Nagisa."},{"spoiler":false,"text":"She married at a young age and gave birth to two daughters. She shortly became a widow afterwards. With her husband's savings and her own hard work, she lived a happy life as a single parent."},{"spoiler":false,"text":"As a result, she cares deeply for children and her family. She loves her new husband and cares for his son as her own."}],"source":"vndb","sourceCharacterId":"c84601"},{"segments":[{"spoiler":false,"text":"一家の母親。"},{"spoiler":false,"text":"まだ３０代半ばと若く、キリッとした美貌とグラマラスな身体を持つ美女。"},{"spoiler":false,"text":"仕事中はクールで厳しく隙がないキャリアウーマンとして周りから恐れ敬われているが、家では力を抜いて、冗談を言ったり優しく柔らかい表情を見せる、剛柔併せ持った人物。"},{"spoiler":false,"text":"家にいる時の方が素であり、本来は明るくおおらかで、ソファーでうたた寝してしまうなどやや雑な所もある。"},{"spoiler":false,"text":"家事もあまり得意ではなく、娘達が幼かった頃は何とかこなしていたが、現在は完全に凪沙に任せている。"}],"source":"egs","sourceCharacterId":"21628","sourceWorkId":"28037","spoiler":false},{"segments":[{"spoiler":false,"text":"一家の母親。"},{"spoiler":false,"text":"まだ30代半ばと若く、キリッとした美貌とグラマラスな身体を持つ美女。"},{"spoiler":false,"text":"仕事中はクールで厳しく隙がないキャリアウーマンとして周りから恐れ敬われているが、"},{"spoiler":false,"text":"家では力を抜いて、冗談を言ったり優しく柔らかい表情を見せる、剛柔併せ持った人物。"},{"spoiler":false,"text":"家にいる時の方が素であり、本来は明るくおおらかで、ソファーでうたた寝してしまうなどやや雑な所もある。"},{"spoiler":false,"text":"家事もあまり得意ではなく、娘達が幼かった頃は何とかこなしていたが、現在は完全に凪沙に任せている。"},{"spoiler":false,"text":"早婚で姉妹を産み、末娘の楓夏の物心が付く頃に前夫と死別して未亡人になる波乱の人生を歩んできたが、"},{"spoiler":false,"text":"亡夫と作った蓄えと娘二人の支えもあり、母子家庭であっても満たされた生活を送ってきた。"},{"spoiler":false,"text":"それ故に家族に対する思いは強く、姉妹のどちらの行事への参加も欠かさないし、自身の生きがいにしている。"},{"spoiler":false,"text":"現在の夫である欽二を愛しており、その連れ子である主人公も自分の息子として実子と分け隔て無く接している。"}],"source":"bangumi","sourceCharacterId":"71488"}],"profileFacts":[{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"21628","sourceWorkId":"28037","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"21628","sourceWorkId":"28037","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"166 cm","valueContext":null,"source":"egs","sourceCharacterId":"21628","sourceWorkId":"28037","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"21628","sourceWorkId":"