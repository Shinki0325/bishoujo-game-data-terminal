ext":"As a result, she feels a little lonely because she can't find anyone who shares her exact taste in anime and can talk about it with her wholeheartedly."},{"spoiler":false,"text":"Her hobby is knitting, and she has a bit of a homely side to her."}],"source":"vndb","sourceCharacterId":"c54503"},{"segments":[{"spoiler":false,"text":"アニソンバー『Ｂｌｕｅ　Ｃｏｍｅｔ』の看板娘。"},{"spoiler":false,"text":"天真爛漫で活発、常に笑顔で一生懸命な、いい子。"},{"spoiler":false,"text":"お客様からの人気も非常に高い。"},{"spoiler":false,"text":"アニメが大好きだが、お気に入りになる作品はどうしてか、世間的に見てマイナーなものばかり。"},{"spoiler":false,"text":"なので、自分とアニメの好みが完全に合致する人がおらず、全力で語り合えないのがちょっとだけ寂しい。"},{"spoiler":false,"text":"趣味は編み物。なかなか家庭的。"}],"source":"egs","sourceCharacterId":"13987","sourceWorkId":"23225","spoiler":false},{"segments":[{"spoiler":false,"text":"アニソンバー 『Blue Comet』 の看板娘。"},{"spoiler":false,"text":"天真爛漫で活発、常に笑顔で一生懸命な いい子。 客からの人気も非常に高い。"},{"spoiler":false,"text":"アニメが大好きだが、お気に入り作品は世間的に見てマイナーなものばかり。"},{"spoiler":false,"text":"なので自分とアニメの好みが完全に合致する人がおらず、全力で語り合えないのがちょっとだけ寂しい。"},{"spoiler":false,"text":"趣味は編み物。 なかなか家庭的。"}],"source":"bangumi","sourceCharacterId":"49259"}],"profileFacts":[{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"13987","sourceWorkId":"23225","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"13987","sourceWorkId":"23225","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"151 cm","valueContext":null,"source":"egs","sourceCharacterId":"13987","sourceWorkId":"23225","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"13987","sourceWorkId":"23225","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"13987","sourceWorkId":"23225","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/ima