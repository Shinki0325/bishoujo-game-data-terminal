{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"37860","model":{"presentationWorkId":"vndb:v46374","staff":{"artwork":[],"scenario":[],"music":[],"other":[{"creditedName":"flankoi","creatorId":"vndb:s28194","sourcePersonId":"vndb:s28194","canonicalEntityId":"vndb:s28194","name":"flankoi","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:198315","source":"vndb"}]},"cast":[{"characterId":"char_bangumi_148140","characterName":"主人公","sourceIds":{"bangumi":[{"characterId":"148140","match":"source-roster","subjectId":"417567"}]},"originalCharacterName":"主人公","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"試験勉強の息抜きのためムーンパレスに来た。強いエビアレルギーを持っているとはいえ、店員に注文をする時「ソフトクリームにエビって入っていますか?」と質問するなど、気になったことは遠慮なく尋ねる性格。その好奇心は他のキャラクターとの会話にも垣間見える。"},{"spoiler":false,"text":"こんなに月が綺麗な夜はファミレスに行こうかな"}],"source":"bangumi","sourceCharacterId":"148140"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_bangumi_148141","characterName":"ガラスパン","sourceIds":{"bangumi":[{"characterId":"148141","match":"source-roster","subjectId":"417567"}]},"originalCharacterName":"ガラスパン","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"メイン画像上。いつもドリンクバーの酒を飲んで、明るく振る舞っている女性。しかしその享楽的な振る舞いには寂しさが見え隠れしている。元は友人とムーンパレスに来たのだが……"},{"spoiler":false,"text":"君のため、はじめに伝えておこう"},{"spoiler":false,"text":"ムーンパレスからは出られない"},{"spoiler":false,"text":"せいぜい楽しもう アッハッハ…"}],"source":"bangumi","sourceCharacterId":"148141"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58fa7e356fd956924d8edcf0a721679ec21c1add56371e5fa5e903adf201f715.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0bd56eaaaadef93f4c065e60ed8885a7a5c7a93ccfe2e9891637642e7570e1d.webp","width":228,"height":225,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_148142","characterName":"レイルロード・スパイク","sourceIds":{"bangumi":[{"characterId":"148142","match":"source-roster","subjectId":"417567"}]},"originalCharacterName":"レイルロード・スパイク","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"メイン画像右下。かつてはフォースプーンという小国の王だったという。中世の人物だが、ガラスパンよりも後にムーンパレスへと至ったらしく、時系列に矛盾があるが、とある人物に逃がされたことが関係しているらしい。"},{"spoiler":false,"text":"せっかくだ 貴公に歴史の特別授業をしてやろう"}],"source":"bangumi","sourceCharacterId":"148142"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/4885d811d4d8db4434f5d218c17c3f8c1ec5ee46e959a707be356f8f05cb728b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c46a8f56646e3b408fc9ef7b2c5aeb2a48b9a3f4c1979b05b6b4cfd74b3f1e2.webp","width":256,"height":254,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_148143","characterName":"ツェネズ","sourceIds":{"bangumi":[{"characterId":"148143","match":"source-roster","subjectId":"417567"}]},"originalCharacterName":"ツェネズ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"メイン画像中央のドアに閉ざされた部屋にずっと籠もっている女性。ムーンパレスの最古参。常に怯えており、部屋から出ようとしない。"},{"spoiler":false,"text":"事情があってここから出られないんです"},{"spoiler":false,"text":"広い場所が怖いというか…"}],"source":"bangumi","sourceCharacterId":"148143"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36a03c6e49a4444513c679558f230b60afcf17725e9b89c8b895fb8e3abc1918.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65a29a88018ee0b28173add9563ef6e7a621062cf9ac5982e060349c5dbfd456.webp","width":138,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_148144","characterName":"セロニカ","sourceIds":{"bangumi":[{"characterId":"148144","match":"source-roster","subjectId":"417567"}]},"originalCharacterName":"セロニカ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"メイン画像左下。普段は大学の図書館で事務をしている青年。素早く「永遠のファミレスに閉じ込められている」という状況を飲み込む冷静さや賢さが度々描写されており、ツェネズからは「優秀な人が持っている残酷さ」を感じると評されている。"},{"spoiler":false,"text":"僕はここから抜け出す方法を模索するのは"},{"spoiler":false,"text":"無駄ではないと思いますね"}],"source":"bangumi","sourceCharacterId":"148144"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a9bc6b9c50d619ea8848c9449ced3f1e421854bea180adad4aa7d2107fdca1c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67753ad2c70817223e92d83816bfb7342bab79ddb270047bdb3d236bc7100d61.webp","width":196,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_148145","characterName":"ラテラ","sourceIds":{"bangumi":[{"characterId":"148145","match":"source-roster","subjectId":"417567"}]},"originalCharacterName":"ラテラ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only",