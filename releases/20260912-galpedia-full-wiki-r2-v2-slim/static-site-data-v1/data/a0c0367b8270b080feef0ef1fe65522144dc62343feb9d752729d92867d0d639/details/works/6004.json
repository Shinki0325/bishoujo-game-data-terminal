{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"6004","model":{"presentationWorkId":"vndb:v687","staff":{"artwork":[{"creditedName":"しかげなぎ","creatorId":"vndb:s2942","sourcePersonId":"egs:creator:699","canonicalEntityId":"vndb:s2942","name":"しかげなぎ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:12158","source":"egs"}],"scenario":[{"creditedName":"仁村紳志","creatorId":"vndb:s1608","sourcePersonId":"egs:creator:2163","canonicalEntityId":"vndb:s1608","name":"仁村紳志","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:20181","source":"egs"},{"creditedName":"尾崎貞夫(小田崎コウ)","creatorId":"vndb:s2967","sourcePersonId":"egs:creator:2225","canonicalEntityId":"vndb:s2967","name":"尾崎貞夫(小田崎コウ)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:20921","source":"egs"},{"creditedName":"姫ノ宮レイ","creatorId":"vndb:s2968","sourcePersonId":"egs:creator:5244","canonicalEntityId":"vndb:s2968","name":"姫ノ宮レイ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:20962","source":"egs"},{"creditedName":"七央結日(安堂こたつ)","creatorId":"vndb:s1855","sourcePersonId":"egs:creator:2151","canonicalEntityId":"vndb:s1855","name":"七央結日(安堂こたつ)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:72195","source":"egs"}],"music":[{"creditedName":"Angel Note","creatorId":"vndb:s758","sourcePersonId":"egs:creator:2558","canonicalEntityId":"vndb:s758","name":"Angel Note","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:20922","source":"egs"},{"creditedName":"森 まもる","creatorId":"vndb:s3535","sourcePersonId":"vndb:s3535","canonicalEntityId":"vndb:s3535","name":"森 まもる","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:14108","source":"vndb"}],"other":[{"creditedName":"中山マミ(中山♡マミ)","creatorId":"vndb:s1609","sourcePersonId":"egs:creator:12569","canonicalEntityId":"vndb:s1609","name":"中山マミ(中山♡マミ)","detail":"OP曲 「咲く未来」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:136821","source":"egs"},{"creditedName":"パリオ","creatorId":"vndb:s2790","sourcePersonId":"egs:creator:12719","canonicalEntityId":"vndb:s2790","name":"パリオ","detail":"デモ・OPムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:67475","source":"egs"},{"creditedName":"中山♥マミ","creatorId":"vndb:s1609","sourcePersonId":"vndb:s1609","canonicalEntityId":"vndb:s1609","name":"中山♡マミ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:14101","source":"vndb"},{"creditedName":"中山♥マミ","creatorId":"vndb:s1609","sourcePersonId":"vndb:s1609","canonicalEntityId":"vndb:s1609","name":"中山♡マミ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:14102","source":"vndb"},{"creditedName":"パリオ","creatorId":"vndb:s2790","sourcePersonId":"vndb:s2790","canonicalEntityId":"vndb:s2790","name":"パリオ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:14104","source":"vndb"}]},"cast":[{"characterId":"char_c81543","characterName":"ルルホ","sourceIds":{"bangumi":[{"characterId":"193065","match":"exact-normalized-name-in-linked-work","subjectId":"155404"}],"egsCharacterIds":["26502"],"vndbCharacterId":"c81543"},"originalCharacterName":"ルルホ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young girl who adores Calt, and calls him \"Onii-chan.\" She's been living alone in Rat village, waiting for Calt to return. Even though they're not blood-related, she trusts Calt more than anyone else in the world."},{"spoiler":false,"text":"One fateful day, Ruruho had gone to a church's mass with her parents while on holiday. There was a sudden earthquake, and her life was saved by a priest, but her parents both died and suddenly Ruruho was alone. Since Calt's father had also died at that time, she'd come to live with him."},{"spoiler":false,"text":"translated from Getchu"}],"source":"vndb","sourceCharacterId":"c81543"},{"segments":[{"spoiler":false,"text":"出稼ぎに行った主人公・カルトの帰りを偏狭の村の家で待つ少女。"},{"spoiler":false,"text":"とある休日に、両親と主人公の教会に訪れていたときに大地震に遭い、そのときに両親が亡くなり、彼女自身も津波に呑み込まれそうになっていたところを主人公の父親に助けられ、命を取り留める。"},{"spoiler":false,"text":"主人公の父親もそのときに亡くなり、残された主人公と共に一緒に暮らすことになる。"},{"spoiler":false,"text":"性格は、気弱で、寂しがり屋で、甘えん坊。"},{"spoiler":false,"text":"主人公をお兄ちゃんと呼んで、慕っている。"}],"source":"egs","sourceCharacterId":"26502","sourceWorkId":"6004","spoiler":false},{"segments":[{"spoiler":false,"text":"カルトを“お兄ちゃん”と呼び慕っている少女。出稼ぎに行ったカルトの帰りを辺境の村の家で一人待っている。カルトとは血の繋がりはないが、カルトを誰よりも信頼し、頼りにしている。"},{"spoiler":false,"text":"とある休日にミサの為、教会へ両親と訪れていたルルホ。突然の大地震により教会が崩れ、危ないところを神父に救われ一命を取り留めるが、両親は失い、孤独になってしまったルルホ。その後、カルトと一緒に生活を始める。"}],"source":"bangumi","sourceCharacterId":"193065"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d64f91f4ea19fb2638529187862d10d1c46eade4e70a6947202f9223255ca1f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f3b58b02ab0421f969dcf282a4f7f9df22409b755ef58c0240f22c7f67d4a9d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤美佳子","creatorId":"vndb:s1137","sourcePersonId":"vndb:s1137","canonicalEntityId":"vndb:s1137","name":"佐藤 美佳子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155404:193065:6122:1","source":"bangumi"}]},{"characterId":"char_c81886","characterName":"メイリン","sourceIds":{"bangumi":[{"characterId":"193066","match":"exact-normalized-name-in-linked-work","subjectId":"155404"}],"egsCharacterIds":["26503"],"vndbCharacterId":"c81886"},"originalCharacterName":"メイリン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the maids of Baron von Rondman's mansion, in which the protagonist works as a migrant. She is intelligent and serious, recognized by Rondman for her excellent work performance, and is entrusted with the management of the entire mansion and its servants. Her clerical tone and inflexibility give her an air of unapproachability, but when it comes to those she's familiar with, she shows a kind, caring, sisterly side of herself."},{"spoiler":false,"text":"translated from Getchu"}],"source":"vndb","sourceCharacterId":"c81886"},{"segments":[{"spoiler":false,"text":"主人公の出稼ぎ先となるロンドマン男爵の屋敷のメイドのひとり。"},{"spoiler":false,"text":"知的で真面目な性格で、仕事ぶりも優秀であることから、ロンドマンに認められ、屋敷全体の管理（使用人の管理）を任されている。"},{"spoiler":false,"text":"事務的な口調で融通が利かないと、近寄り難い雰囲気を醸し出しているが、自分が認めた相手には、面倒見の良い優しいお姉さん的な顔を見せる。"}],"source":"egs","sourceCharacterId":"26503","sourceWorkId":"6004","spoiler":false},{"segments":[{"spoiler":false,"text":"ロンドマン男爵の屋敷の侍女。屋敷全体の管理（使用人の管理）を任されており、ロンドマンから信頼を得ている。"},{"spoiler":false,"text":"知的で真面目な性格、神秘的な美しさとインテリのイメージが強く印象に残る女性。一見すると、物静で事務的な口調で融通が利かないと、近寄りがたい雰囲気を醸し出している。実際は世話好きで面倒見が良い優しいお姉さんの一面も持っていて、それは真面目で努力家の人にのみ向けられる。特に様々なことを知っている賢い男性に魅力を感じる。反対に、いい加減でお調子者を毛嫌いする為、事務的で冷たい対応をする。"}],"source":"bangumi","sourceCharacterId":"193066"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fcf49ddeb9f45907318f510f6d77ae62a1e2b40663929aaee439feb572b1f71.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/4094f94a60cd7c42d34fd7c2dcf6165f4ffc6a7ba8e67b5bf3db387af5c3ab03.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155404:193066:5741:1","source":"bangumi"}]},{"characterId":"char_c81887","characterName":"キュウト","sourceIds":{"bangumi":[{"characterId":"193067","match":"exact-normalized-name-in-linked-work","subjectId":"155404"}],"egsCharacterIds":["26504"],"vndbCharacterId":"c81887"},"originalCharacterName":"キュウト","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the maids of Baron von Rondman's mansion, in which the protagonist works as a migrant. She is the most energetic girl in the mansion, and is regarded as a kind older sister figure by the servants. In addition, her maternal instincts are very strong, making it difficult for her to ignore any younger, fragile boys. For this reason, she is not at all interested in older men."},{"spoiler":false,"text":"translated from Getchu"}],"source":"vndb","sourceCharacterId":"c81887"},{"segments":[{"spoiler":false,"text":"主人公の出稼ぎ先となるロンドマン男爵の屋敷のメイドのひとり。"},{"spoiler":false,"text":"屋敷一の元気娘で、使用人から優しいお姉さん的な存在。"},{"spoiler":false,"text":"常にポジティブで、笑顔を絶やさない。"},{"spoiler":false,"text":"また母性本能が非常に敏感で、年下のか弱い男の子が居ると放っておけない。"},{"spoiler":false,"text":"そのため年上の男性には、まったく興味を示さない。"}],"source":"egs","sourceCharacterId":"26504","sourceWorkId":"6004","spoiler":false},{"segments":[{"spoiler":false,"text":"屋敷一の元気娘で、使用人からは優しいお姉さん的存在として慕われている。どんなことにも前向きで、笑顔で取り組む姿が印象的な女の子。年下のか弱い男性には母性本能が敏感に働き、放って置けないが、年上の男性にはだらしが無いの一言だけで興味を示さない。"}],"source":"bangumi","sourceCharacterId":"193067"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b35947dcf9eb09a038edc529004a4b6d5d9069bd9bc5fa0285e5a5ccbb4585d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/771cd8b38f9679f1a416adea9534afb63c91f3cd456aeddf188b2f833aa3557b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155404:193067:6036:1","source":"bangumi"}]},{"characterId":"char_c81888","characterName":"パレット","sourceIds":{"bangumi":[{"characterId":"193068","match":"exact-normalized-name-in-linked-work","subjectId":"155404"}],"egsCharacterIds":["26505"],"vndbCharacterId":"c81888"},"originalCharacterName":"パレット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the maids of Baron von Rondman's mansion, in which the protagonist works as a migrant. A girl with a pure and innocent personality who still has some childishness left in her. However, she is strong at heart and shows a tremendous amount of energy when she decides to do something. Although she is a bit of a naughty girl and makes many mistakes, she is always optimistic and tries her best, which makes her hard to hate."},{"spoiler":false,"text":"Her favorite saying is, \"Uuu, Palette won't be discouraged by this.\""},{"spoiler":false,"text":"translated from Getchu"}],"source":"vndb","sourceCharacterId":"c81888"},{"segments":[{"spoiler":false,"text":"主人公の出稼ぎ先となるロンドマン男爵の屋敷のメイドのひとり。"},{"spoiler":false,"text":"まだまだ幼さの残る純粋無垢な性格の女の子。"},{"spoiler":false,"text":"しかしながら、芯は強く、やると決めたら、とてつもない行動力を発揮。"},{"spoiler":false,"text":"そそっかしいところがありミスも多いが、常に前向きで一生懸命なので憎めない。"},{"spoiler":false,"text":"「ううぅ、パレットはこんなことじゃ挫けないですぅ。」が口癖。"}],"source":"egs","sourceCharacterId":"26505","sourceWorkId":"6004","spoiler":false},{"segments":[{"spoiler":false,"text":"純粋で無垢な性格で、あどけなさが残る使用人。しかし、芯は強く、思い込んだら凄い行動力を発揮する。何事にも全力で取り組むが、そそっかしい為ミスも多い。その為、いつも屋敷ではパレットの悲鳴が聞こえてくる。常に前向きで、多少のことではめげない女の子。「ううぅ、パレットはこんなことじゃ挫けないですぅ。」が口癖。"}],"source":"bangumi","sourceCharacterId":"193068"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35dbdbefdc7544edf7bd20d69a30a68bbd0b7ee79e77c42086978b943dfd581b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd09cf32c72165987f2a1ad3c0b09b23a31a5f6c7848c57e0d043bcf79222df9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155404:193068:4810:1","source":"bangumi"}]},{"characterId":"char_c81889","characterName":"達菜","sourceIds":{"bangumi":[{"characterId":"193070","match":"exact-normalized-name-in-linked-work","subjectId":"155404"}],"egsCharacterIds":["26507"],"vndbCharacterId":"c81889"},"originalCharacterName":"達菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl from a small Eastern island nation."},{"spoiler":false,"text":"She was the concubine of a lord whose lineage died out due to a big fire 20 years ago. She is quiet and reserved. She was loved immensely by her former lord, but suffered terrible treatment at the hands of the jealous queen. Now, she is said to be a ghost wandering around the old castle..."},{"spoiler":false,"text":"translated from Getchu"}],"source":"vndb","sourceCharacterId":"c81889"},{"segments":[{"spoiler":false,"text":"東洋の小さな島国出身の少女。"},{"spoiler":false,"text":"20年前の大きな火災が原因で家系が絶えた領主の妾だった。"},{"spoiler":false,"text":"物静かで控えめな性格の彼女。"},{"spoiler":false,"text":"かつての領主から絶大な愛を得ていたが、それに嫉妬した王妃から酷い仕打ち受けていた。"},{"spoiler":false,"text":"現在は、幽霊となって古城内を彷徨っているらしいが……。"}],"source":"egs","sourceCharacterId":"26507","sourceWorkId":"6004","spoiler":false},{"segments":[{"spoiler":false,"text":"20年前、大きな火災が原因で家系が絶えた領主の妾だった女性。"},{"spoiler":false,"text":"東洋の小さな島国の出身の達菜は、普段から着物を着ている。"},{"spoiler":false,"text":"控えめで、貢献的な言動を嫌味になることなく自然に出来てしまう東洋の女性らしさが領主から絶大な愛を得ていた。"},{"spoiler":false,"text":"しかしそれをよく思わなかった王妃から、何かにつけて酷い仕打ちを受けるのだった。"},{"spoiler":false,"text":"現在幽霊になっていて、古城内をさまよっていたところ、カルト達に出会う。"}],"source":"bangumi","sourceCharacterId":"193070"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/8048b8b2f39aa42dcb6cd42f8c4d08bd636251edb7c100f363c71a5a59b24338.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/931285a08b8e9cb6f8b332500c6b95f1e32bb96bdeccf35f7ff62eec4c624640.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155404:193070:4489:1","source":"bangumi"}]},{"characterId":"char_c81890","characterName":"ピュアティ","sourceIds":{"bangumi":[{"characterId":"193071","match":"exact-normalized-name-in-linked-work","subjectId":"155404"}],"egsCharacterIds":["26508"],"vndbCharacterId":"c81890"},"originalCharacterName":"ピュアティ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An immature goddess whose fear of heights prevents her from flying freely in the sky. By mistake, she had fallen down to earth from the heavens. When she hides her wings, she can easily pass for a normal human woman. She has a cheerful and openhearted personality."},{"spoiler":false,"text":"The Great Goddess has given her strict orders not to come into contact with the people of the earthly world, so it would seem that she's hiding by a lake deep in the forest so as not to be seen..."},{"spoiler":false,"text":"translated from Getchu"}],"source":"vndb","sourceCharacterId":"c81890"},{"segments":[{"spoiler":false,"text":"高所恐怖症で空を自由に飛べない未熟な女神様。"},{"spoiler":false,"text":"過って天界から地上界へと落ちてきてしまった彼女。"},{"spoiler":false,"text":"翼を隠していれば、普通の人間の女性と変わらない。"},{"spoiler":false,"text":"性格は明朗快活。"},{"spoiler":false,"text":"大女神様から地上界の人々と接触してはならないと厳命され、人目につかないよう森の奥にある湖畔に潜んでいるようだが……。"}],"source":"egs","sourceCharacterId":"26508","sourceWorkId":"6004","spoiler":false},{"segments":[{"spoiler":false,"text":"高所恐怖症で空を飛ぶことができない未熟な女神様のピュアティは、目を回して天界から地上界へと落ちてきてしまう。地上界へと落ちてきたピュアティは大女神様から地上界の人々とは接してはならないと言いつけられているため、人目につかない森の奥にある湖畔で寛いでいる。"},{"spoiler":false,"text":"明朗活発で、ルルホより少し年上のお姉さん的容姿をしている。大きな違いは、背中に翼を持っている事くらいで、翼を隠している時は人間と変わらない。普段は服を纏っているが翼を広げると身に付けていた服が消えて裸になる。"}],"source":"bangumi","sourceCharacterId":"193071"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d8a777250802e117118c6129297331c21c12f965621f18eb72b9d10fb0aa5d7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fe9e316a2bd4744b67b904e884172959166c588c22ac096b91bad94d7cc4f2f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:155404:193071:5890:1","source":"bangumi"}]},{"characterId":"char_c82812","characterName":"マウア","sourceIds":{"bangumi":[],"egsCharacterIds":["26506"],"vndbCharacterId":"c82812"},"originalCharacterName":"マウア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A waitress at the Mandrill bar. She is an intelligent woman with a relaxed atmosphere."},{"spoiler":false,"text":"A native of the mining town of Hyde, she has dreamt of opening a store selling rare goods in a strange city since she was a child, having heard stories of rare items and foreign cities from the peddlers who visited her town. Now, having turned 18, she visited the harbor city of Belford as the first step toward her dream."},{"spoiler":false,"text":"translated from Getchu"}],"source":"vndb","sourceCharacterId":"c82812"},{"segments":[{"spoiler":false,"text":"酒場「マンドリル」のウエイトレス。"},{"spoiler":false,"text":"知的で落ち着いた雰囲気のある女性。"},{"spoiler":false,"text":"鉱山の街ハイド出身の彼女は、幼い頃から街を訪れる行商人らから珍しいものや他の街の話を見聞きし、見知らぬ街で珍しい商品を扱う店を開きたいと夢見てきた。"},{"spoiler":false,"text":"そして、彼女が18歳のとき、その夢の第一歩として港町ベルファルドに訪れる。"}],"source":"egs","sourceCharacterId":"26506","sourceWorkId":"6004","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d71da4b808c72ee19d672c45f0f46803c73fc9f2f39d745b4ca5eafdb570dc8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf83c122d65c9ad0ed883e1075e07563259c583269994f63852814b4e471ea9a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"風音","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美