{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"7850","model":{"presentationWorkId":"vndb:v2520","staff":{"artwork":[{"creditedName":"相川亜利砂(あいかわ亜利砂)","creatorId":"vndb:s2040","sourcePersonId":"egs:creator:142","canonicalEntityId":"vndb:s2040","name":"相川亜利砂(あいかわ亜利砂)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:18755","source":"egs"}],"scenario":[{"creditedName":"三宅 蒼色","creatorId":"vndb:s1519","sourcePersonId":"vndb:s1519","canonicalEntityId":"vndb:s1519","name":"三宅 蒼色","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:35600","source":"vndb"}],"music":[{"creditedName":"Funczion SOUNDS","creatorId":"vndb:s1071","sourcePersonId":"egs:creator:2566","canonicalEntityId":"vndb:s1071","name":"Funczion SOUNDS","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:67023","source":"egs"}],"other":[{"creditedName":"三宅蒼色(蒼色)","creatorId":"vndb:s1519","sourcePersonId":"egs:creator:151","canonicalEntityId":"vndb:s1519","name":"三宅蒼色(蒼色)","detail":"一部シナリオライティング手伝い","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:18756","source":"egs"},{"creditedName":"Marica","creatorId":"vndb:s111","sourcePersonId":"egs:creator:12493","canonicalEntityId":"vndb:s111","name":"Marica","detail":"主題歌「KEEP OUT」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:84720","source":"egs"},{"creditedName":"Marica","creatorId":"vndb:s111","sourcePersonId":"vndb:s111","canonicalEntityId":"vndb:s111","name":"Marica","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:35598","source":"vndb"},{"creditedName":"相川 亜利砂","creatorId":"vndb:s2040","sourcePersonId":"vndb:s2040","canonicalEntityId":"vndb:s2040","name":"相川 亜利砂","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:35601","source":"vndb"}]},"cast":[{"characterId":"char_c8282","characterName":"建部 稲穂","sourceIds":{"bangumi":[{"characterId":"94848","match":"exact-normalized-name-in-linked-work","subjectId":"148413"},{"characterId":"94848","match":"exact-normalized-name-in-linked-work","subjectId":"148415"},{"characterId":"94848","match":"exact-normalized-name-in-linked-work","subjectId":"213278"}],"egsCharacterIds":["22726"],"vndbCharacterId":"c8282"},"originalCharacterName":"建部 稲穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"教育実習生。"},{"spoiler":false,"text":"ショートカットで清潔感溢れる美人。"},{"spoiler":false,"text":"まだ学生であるためか、その服装は教師らしくなく、際どい格好が目立つ。"},{"spoiler":false,"text":"そのため、学園の男子たちの熱い視線を集めている。"},{"spoiler":false,"text":"情熱的な性格だが、それが災いして事件に巻き込まれていく。"}],"source":"egs","sourceCharacterId":"22726","sourceWorkId":"4901","spoiler":false},{"segments":[{"spoiler":false,"text":"私立坂ノ下学園教育実習生"},{"spoiler":false,"text":"同学園の卒業生"},{"spoiler":false,"text":"大学四回生"},{"spoiler":false,"text":"担当教科：英語"},{"spoiler":false,"text":"正義感が強く、元気で活発。面倒見も良い。"},{"spoiler":false,"text":"明るい性格で、過ぎたことはクヨクヨと悩まない。"},{"spoiler":false,"text":"一本気で純粋だが、頑固というわけでもない。"},{"spoiler":false,"text":"周りに気を遣うことも忘れないが、"},{"spoiler":false,"text":"その態度から内面を察することができるほど、顔に感情が出る。"},{"spoiler":false,"text":"スレンダーな体型で、学生時代は陸上部でハードル選手として活躍していた。"},{"spoiler":false,"text":"かつての恩師である美甘櫻に憧れて教師を目指す。"}],"source":"egs","sourceCharacterId":"22726","sourceWorkId":"7395","spoiler":false},{"segments":[{"spoiler":false,"text":"私立薊学園新米教師・新聞部顧問。"},{"spoiler":false,"text":"「青春」と「愛」が口癖の新任教師。"},{"spoiler":false,"text":"顧問のいなかった新聞部の顧問をしている。"},{"spoiler":false,"text":"日々大人社会でストレスに苛まれながらも問題児達を温かく見守っているつもり。"}],"source":"egs","sourceCharacterId":"22726","sourceWorkId":"7850","spoiler":false},{"segments":[{"spoiler":false,"text":"薊学園を数年前に卒業した、教育実習生。"},{"spoiler":false,"text":"まだまだ学生気分が抜けておらず、"},{"spoiler":false,"text":"先生と生徒というより、友達感覚で接してくれる人間を好む。"},{"spoiler":false,"text":"教師になる理由をいまだ見つけられず、"},{"spoiler":false,"text":"口癖である「愛」について深く考える一面もあるが、"},{"spoiler":false,"text":"基本的には底抜けに明るくノリがいいおねーさん。"},{"spoiler":false,"text":"自分の将来について悩みつつ、"},{"spoiler":false,"text":"同年代の少年少女からそのヒントを貰うために日々努力している。"},{"spoiler":false,"text":"学校に短めのスカートを履いてくるなど、"},{"spoiler":false,"text":"無防備なところもあるが、貞操観念はしっかりしている。"},{"spoiler":false,"text":"スタイルはいい方。胸の大きさは普通。"},{"spoiler":false,"text":"真面目な人だけど、周囲に合わせて明るくなったり暗くなったり。"},{"spoiler":false,"text":"臨機応変になんにでも接する事ができる。"},{"spoiler":false,"text":"教師に向いているが、本人はそれに気付いていない。"}],"source":"bangumi","sourceCharacterId":"94848"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa94e9635329b6f255f354adb17f4a4a34f3e7ffa9a2515ddb94d413bc3b9131.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91bd71f1216f0bf496232ba7fd02136c428d3439da290d29942ae9e98fbc0d24.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:148415:94848:4463:1","source":"bangumi"}]},{"characterId":"char_vndb_c27252","characterName":"神目 楓","sourceIds":{"vndbCharacterId":"c27252"},"originalCharacterName":"神目 楓","characterNameSource":null,"