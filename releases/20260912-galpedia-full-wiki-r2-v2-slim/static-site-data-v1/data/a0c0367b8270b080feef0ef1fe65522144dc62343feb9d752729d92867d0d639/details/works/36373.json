{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"36373","model":{"presentationWorkId":"vndb:v50680","staff":{"artwork":[{"creditedName":"山本和枝(やまもと☆かずえ)","creatorId":"vndb:s2266","sourcePersonId":"egs:creator:168","canonicalEntityId":"vndb:s2266","name":"山本和枝(やまもと☆かずえ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:278407","source":"egs"}],"scenario":[{"creditedName":"シャア専用◎","creatorId":"vndb:s2261","sourcePersonId":"egs:creator:2171","canonicalEntityId":"vndb:s2261","name":"シャア専用◎","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:278408","source":"egs"}],"music":[{"creditedName":"Angel Note","creatorId":"vndb:s758","sourcePersonId":"egs:creator:2558","canonicalEntityId":"vndb:s758","name":"Angel Note","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:278409","source":"egs"}],"other":[{"creditedName":"山本 和枝","creatorId":"vndb:s2266","sourcePersonId":"vndb:s2266","canonicalEntityId":"vndb:s2266","name":"山本 和枝","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:206923","source":"vndb"}]},"cast":[{"characterId":"char_c13964","characterName":"音羽 桂香","sourceIds":{"bangumi":[{"characterId":"87298","match":"exact-normalized-name-in-linked-work","subjectId":"120318"},{"characterId":"87298","match":"exact-normalized-name-in-linked-work","subjectId":"320098"},{"characterId":"87298","match":"exact-normalized-name-in-linked-work","subjectId":"41747"}],"egsCharacterIds":["8364"],"vndbCharacterId":"c13964"},"originalCharacterName":"音羽 桂香","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Keika is the main heroine of Natsu Kagura and eldest daughter of Otowa sisters with a very long jet black hair. Gently mild and polite, a perfect Yamato Nadeshiko type shrine maiden, who's living at Minamori shrine. A second year student who attends school at the bottom of the mountain. Since she takes seriously whatever she's told, she often becomes subject of teasing by Youko and even sometimes by herown younger sister. Her weakness is her lack of awareness between male-female's relationship and her awkwardness for electronic equipment systems, though it seems that she's able to use the microwave oven. Despite of her modesty and gentle personality, she's shown to have an excessive sexual addiction during rape."},{"spoiler":false,"text":"Keika is prominent in kenjutsu. Her weapon is Shishio (獅子王), a legendary katana that possesses massive divine spiritual power & lightning properties, which can be summoned by her at anytime."}],"source":"vndb","sourceCharacterId":"c13964"},{"segments":[{"spoiler":false,"text":"温和で優しい水杜神社の長女。 礼儀正しい大和撫子タイプ。"},{"spoiler":false,"text":"長く美しい黒髪とバランスのとれたスタイルの持ち主。"},{"spoiler":false,"text":"神社では一番の常識人で、天然ボケ揃いな一家のツッコミ役と化している。"},{"spoiler":false,"text":"麓の学園に通う二年生で、主人公より1つ下。"},{"spoiler":false,"text":"物事を何でも素直に受け取るので、時々妹や居候のおもちゃにされている。"},{"spoiler":false,"text":"欠点は、男性に対してほとんど免疫がないのと、電子機器に対する不器用さ。"}],"source":"egs","sourceCharacterId":"8364","sourceWorkId":"20961","spoiler":false},{"segments":[{"spoiler":false,"text":"水杜神社の長女であり、初花の姉。"},{"spoiler":false,"text":"巫女としての修行に励む、温和で礼儀正しい美少女ではあるが、やや天然な部分もある。"},{"spoiler":false,"text":"何事にも真面目で、素直に全てを受け止める性格だが、電子機器に対して絶望的に相性が悪い。"}],"source":"egs","sourceCharacterId":"8364","sourceWorkId":"30023","spoiler":false},{"segments":[{"spoiler":false,"text":"水杜神社の長女である退魔巫女。"},{"spoiler":false,"text":"巫女として懸命に修行に励んでいる。"},{"spoiler":false,"text":"温和で礼儀正しい美少女であるが、やや天然な部分もある。"},{"spoiler":false,"text":"何事にも真面目で、素直に全てを受け止める。"}],"source":"egs","sourceCharacterId":"8364","sourceWorkId":"40479","spoiler":false},{"segments":[{"spoiler":false,"text":"水杜神社の長女であり、初花の姉。"},{"spoiler":false,"text":"巫女としての修行に励む、温和で礼儀正しい美少女ではあるが、やや天然な部分もある。"},{"spoiler":false,"text":"何事にも真面目で、素直に全てを受け止める性格だが、電子機器に対して絶望的に相性が悪い。"}],"source":"bangumi","sourceCharacterId":"87298"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/4612fb09532aa604edf154e4c6ef0802b18ac6ce15d8490bab563ecd0b6430c3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5bb2fa035850d06c73c130e9a7cd75bb6d995694a65b6018324d78f5d2d9d188.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮川美保","creatorId":"vndb:s3635","sourcePersonId":"vndb:s3635","canonicalEntityId":"vndb:s3635","name":"宮川 美保","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:492258:87298:4693:1","source":"bangumi"}]},{"characterId":"char_c13965","characterName":"音羽 初花","sourceIds":{"bangumi":[{"characterId":"78080","match":"exact-normalized-name-in-linked-work","subjectId":"120318"},{"characterId":"78080","match":"exact-normalized-name-in-linked-work","subjectId":"310182"},{"characterId":"78080","match":"exact-normalized-name-in-linked-work","subjectId":"41747"}],"egsCharacterIds":["8365"],"vndbCharacterId":"c13965"},"originalCharacterName":"音羽 初花","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The second heroine of Natsu Kagura and younger daughter of Minamori shrine. Hatsuka has black hair with pony tail. A bright, active, cheerful, and innocent personality."},{"spoiler":false,"text":"There is no right or wrong side in her mind. She has a behaviour to straight out her emotions over action. And... noisy anyway. Because of that, she is often scolded by Keika, her older sister."},{"spoiler":false,"text":"A freshman who attends school at the bottom of the mountain."},{"spoiler":false,"text":"Hatsuka is skilled in archery."}],"source":"vndb","sourceCharacterId":"c13965"},{"segments":[{"spoiler":false,"text":"天真爛漫な水杜神社の次女。 姉と同じく麓の学園に通う一年生。"},{"spoiler":false,"text":"運動神経はそこそこ良いが、それ以上に頭が良く手先が器用。"},{"spoiler":false,"text":"感情に裏表がなく活動的……というか、とにかく騒々しい。"},{"spoiler":false,"text":"しょっちゅう桂香に叱られている。"},{"spoiler":false,"text":"主人公に対しても遠慮がなく、後ろから抱き付いてきたりする。"},{"spoiler":false,"text":"桂香より胸が小さいのを気にしている。"}],"source":"egs","sourceCharacterId":"8365","sourceWorkId":"20961","spoiler":false},{"segments":[{"spoiler":false,"text":"水社神社の次女として生まれ、巫女の修行をしている元気いっぱいの少女。"},{"spoiler":false,"text":"その明るく裏表の無い性格は誰からも好かれるが、時には騒々しいと叱られることも。"},{"spoiler":false,"text":"得意の弓を手にして、妖怪達に立ち向かっていく。"}],"source":"egs","sourceCharacterId":"8365","sourceWorkId":"29786","spoiler":false},{"segments":[{"spoiler":false,"text":"水社神社の次女として生まれ、巫女の修行をしている元気いっぱいの少女。"},{"spoiler":false,"text":"その明るく裏表の無い性格は誰からも好かれるが、時には騒々しいと叱られることも。"},{"spoiler":false,"text":"得意の弓を手にして、妖怪達に立ち向かっていく。"}],"source":"bangumi","sourceCharacterId":"78080"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22730f29c923878fd38f52f0e43ebd103d0b12aa3f52f377cfbcc5d05ccdffe1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efee0670cfe136f90f5547e2aab16729e40f1cf164175c419d389d2823ea88c9.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幡宮かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:492258:78080:5940:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"egs:brand:2720","sourceCompanyId":"egs:brand:2720","canonicalEntityId":"egs:brand:2720"