se},{"segments":[{"spoiler":false,"text":"学園のマスコットキャラ的な存在。 ひとなつっこく、誰からも可愛がられる。"},{"spoiler":false,"text":"いつも気にかけ親切にしてくれる親友・春乃とは特に仲が良く、実の姉のように慕っている。"},{"spoiler":false,"text":"人の周りにまとわりつくのが好き。好きな人には特にまとわりつく。"},{"spoiler":false,"text":"この危機的な状況の中で、その人柄は無意識にみんなに元気を与え、場を和ませてくれる。"},{"spoiler":false,"text":"また、誰も思いつかないような突拍子もないアイデアでみんなをサポートする。"},{"spoiler":false,"text":"エッチはまったくの未経験。知識も乏しい。"},{"spoiler":false,"text":"人々が触手に犯されている事実もあまりよく分かっていない（食べられていると思っている）。"}],"source":"bangumi","sourceCharacterId":"61733"}],"profileFacts":[{"label":"胸围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"8842","sourceWorkId":"16865","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"8842","sourceWorkId":"16865","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"8842","sourceWorkId":"16865","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c3b42bd3e62adaa5da385542a207bbc719d75f742c533f0d640fa3a14cbe27e8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c64a00b54ebffd90b1ba4698dd337f5745da53c0a1254f7567c50e5fe9bc2bc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平松真奈実","creatorId":"vndb:s857","sourcePersonId":"vndb:s857","canonicalEntityId":"vndb:s857","name":"平松 真奈実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:81555:61733:19253:1","source":"bangumi"}]},{"characterId":"char_c46306","characterName":"五十嵐 悠葵","sourceIds":{"bangumi":[{"characterId":"61734","match":"exact-normalized-name-in-linked-work","subjectId":"81555"}],"egsCharacterIds":["8843"],"vndbCharacterId":"c46306"},"originalCharacterName":"五十嵐 悠葵","characterNameSource":null,"role":"primary","status":"s