gs:creator:40482","name":"机マンボウ","detail":"CG","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:275290","source":"egs"},{"creditedName":"nao","creatorId":"vndb:s935","sourcePersonId":"vndb:s935","canonicalEntityId":"vndb:s935","name":"nao","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:113083","source":"vndb"},{"creditedName":"nao","creatorId":"vndb:s935","sourcePersonId":"vndb:s935","canonicalEntityId":"vndb:s935","name":"nao","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:113084","source":"vndb"},{"creditedName":"瑠奈 璃亜","creatorId":"vndb:s1899","sourcePersonId":"vndb:s1899","canonicalEntityId":"vndb:s1899","name":"瑠奈 璃亜","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:113086","source":"vndb"},{"creditedName":"おとぎ 遊戯","creatorId":"vndb:s7537","sourcePersonId":"vndb:s7537","canonicalEntityId":"vndb:s7537","name":"おとぎ 遊戯","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:113089","source":"vndb"},{"creditedName":"上弦","creatorId":"vndb:s7983","sourcePersonId":"vndb:s7983","canonicalEntityId":"vndb:s7983","name":"上弦","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:113090","source":"vndb"},{"creditedName":"アッシュ 群田","creatorId":"vndb:s19141","sourcePersonId":"vndb:s19141","canonicalEntityId":"vndb:s19141","name":"ならしかあすか","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:113092","source":"vndb"},{"creditedName":"さいみん*ここあ","creatorId":"vndb:s48566","sourcePersonId":"vndb:s48566","canonicalEntityId":"vndb:s48566","name":"さいみん*ここあ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:113093","source":"vndb"}]},"cast":[{"characterId":"char_c29432","characterName":"熾 つぼみ","sourceIds":{"bangumi":[{"characterId":"30180","match":"exact-normalized-name-in-linked-work","subjectId":"116528"}],"egsCharacterIds":["5294"],"vndbCharacterId":"c29432"},"originalCharacterName":"熾 つぼみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"After being abandoned as a child by her mother because she was a Cast, the government chose her to be the protagonist personal maid. When she was devastated because she was abandoned because of her power the protagonist supported and cheered her, making her fall in love for him. After so many years these feelings only grew, but her position as maid made her unwilling to confess her feelings. She will do anything to support the protagonist, even support his love with someone else."},{"spoiler":false,"text":"Because she was abandoned she developed a trauma towards her Cast powers and she becomes extremely nervous when she uses it. She hates her powers and wanted to be a normal girl so maybe her mother wouldn't abandon her."},{"spoiler":false,"text":"Her Cast is Glass Shoes. Her right leg become adorned with a boot that can walk in the air and lance Kamaitachis (air blades)."},{"spoiler":false,"text":"Her power is based on Cinderella. She should be very powerful if not for the trauma as she's a Princess Class Cast."}],"source":"vndb","sourceCharacterId":"c29432"},{"segments":[{"spoiler":false,"text":"主人公に仕えるメイドであり、彼の幼馴染。"},{"spoiler":false,"text":"明るく笑顔の似合う女の子。"},{"spoiler":false,"text":"面倒見が良く、自分よりも他人の幸せを優先してしまう。"},{"spoiler":false,"text":"慎み深くて控えめで、主の三歩後ろをついて歩くような子。"},{"spoiler":false,"text":"彼女も≪キャスト≫であり、それも強力な力を持つ≪シンデレラ≫の≪ロアジュエル≫の持ち主。"},{"spoiler":false,"text":"しかし、ごく普通の女の子に生まれたかったと考えているためか、その力を完全に使いこなせていない。"}],"source":"egs","sourceCharacterId":"5294","sourceWorkId":"20949","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公に仕えるメイドであり、彼の幼なじみ。 明るく笑顔の似合う女の子。"},{"spoiler":false,"text":"慎み深くて控えめで、主の三歩後ろをついて歩くような子。"},{"spoiler":false,"text":"面倒見が良く、自分よりも他人の幸せを優先してしまう。"},{"spoiler":false,"text":"彼女もキャストであり、それも強い力を持つ “シンデレラ” のロアジュエルの持ち主。"},{"spoiler":false,"text":"しかし、ごく普通の女の子に生まれたかったと考えているためか、その力を完全に使いこなせていない。"},{"spoiler":false,"text":"「かしこまりました。 ご主人様の思いのままに、そのためにわたしはここにいるのですから」"}],"source":"bangumi","sourceCharacterId":"30180"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c322e2eb47369c2cd9b6d9700cedbde036364ddea468f5b6f2d86e1a5c35d341.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f448633f12901f3fb33d9b34a8cdb2f41432b623a9c0b485c9834af414d278cd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:116528:30180:6016:1","source":"bangumi"}]},{"characterId":"char_c29433","characterName":"白雪 美姫","sourceIds":{"bangumi":[{"characterId":"30181","match":"exact-normalized-name-in-linked-work","subjectId":"116528"}],"egsCharacterIds":["5295"],"vndbCharacterId":"c29433"},"originalCharacterName":"白雪 美姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daughter of the powerful Shirayuki family, Miki's trained her in many areas since it was announced a new Prince Cast was found. As result she's extremely powerful, prideful and yet very just. She's the most powerful cast in the school as she is challenged everyday(usually by boys in the condition of dating if they win) and never lost once. She's very confident in her beauty and skills, to the point it makes other girls angry at her, specially Tsubomi."},{"spoiler":false,"text":"She wants to become the Queen for her wish to come true, but she doesn't want to marry someone she doesn't love, so she decide she will fall for Kouji and make Kouji fall for her. However she falls for him first."},{"spoiler":false,"text":"Her power is Seven Blades. She summons seven swords that fly, shoots lasers and combine. She controls the swords with her thoughts."},{"spoiler":false,"text":"Her power is based on Snow White and her own surename is based on Snow White(Shirayuki). She's a powerful Princess Class Cast."}],"source":"vndb","sourceCharacterId":"c29433"},{"segments":[{"spoiler":false,"text":"主人公と同じ学年で、世界でも名だたる名家に生まれた令嬢。"},{"spoiler":false,"text":"≪キャスト≫として生まれた上に見目麗しく、幼い頃から才能豊かであったため、両親の過剰な期待と愛情のもとで育ってられたせいか、素直ではない性格をしている。"},{"spoiler":false,"text":"人間と≪キャスト≫との間に能力の差があって当然――だからこそ選ばれた自分には為すべき目的と責任がある、つまりはノブレス・オブリージュを信義としている。"},{"spoiler":false,"text":"その上で彼女は、≪キャスト≫と人間の間にある格差や確執をなくし、双方が手を取り合える世界を築きたいと考えている。"},{"spoiler":false,"text":"ただ性格とその言動もあるため、一番に必要なその部分を口にしないため、生意気と取られがちというのが欠点。"}],"source":"egs","sourceCharacterId":"5295","sourceWorkId":"20949","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同じ学年で、世界でも名だたる名家に生まれた令嬢。"},{"spoiler":false,"text":"キャストとして生まれたうえに見目麗しく、幼い頃から才能があった。"},{"spoiler":false,"text":"両親の過剰な期待と愛情のもとで育てられたせいか、素直ではない性格をしている。"},{"spoiler":false,"text":"人間とキャストとの間に能力の差があって当然――"},{"spoiler":false,"text":"だからこそ選ばれた自分には為すべき目的と責任がある。と、“ノブレス・オブリージュ” を信義としている。"},{"spoiler":false,"text":"その上で彼女は、人間とキャストとの間にある格差や確執をなくし、双方が手を取り合える世界を築きたいと考えている。"},{"spoiler":false,"text":"ただ自身の性格と必要なことを口にしないその言動のせいか、生意気と取られがちというのが欠点。"},{"spoiler":false,"text":"「ふん、アンタがときがこの私に敵うとでも思ったわけ？　甘いのよ、大甘よ。 ハチミツよりも甘いんじゃない」"}],"source":"bangumi","sourceCharacterId":"30181"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17ab929de4afc0960578f2dbe1389c02ba6ebce5cea9cc15d40544f1ba2b4dae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01cfc970a2b514360a794de585186b8c03686cd7c98492a1833da04390b1e527.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:116528:30181:6359:1","source":"bangumi"}]},{"characterId":"char_c29434","characterName":"蜜門 双葉","sourceIds":{"bangumi":[{"characterId":"30182","match":"exact-normalized-name-in-linked-work","subjectId":"116528"}],"egsCharacterIds":["5296"],"vndbCharacterId":"c29434"},"originalCharacterName":"蜜門 双葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The twin younger sister of Hansel. Futaba is very intelligent, to the point she only needs to hear the teacher to score full marks on every test she ever made, without the need to take any note or study beyond homework. When she was small her twin brother(whose real name is never clearly stated) died because he had a poor health. However, despite anyone being able to explain how, her late bother became part of her cast power and she can summon him as a a puppet with conscience and free will to help her fight."},{"spoiler":false,"text":"She knows that \"apparently there's something called love\" but she never was interested and doesn't notice she is falling for the protagonist, which makes her suffer when other girls monopolize him and she doesn't even know why she is suffering."},{"spoiler":false,"text":"Her power is string user. She can summon powerful strings to immobilize her enemies. She can also summon Hansel, a puppet, which originally was her brother's power. Her Hansel however is her late brother who has his memories, free will and personality, much to her dismay."},{"spoiler":false,"text":"Her powers, along with her brother's are based on Hansel and Gretel fairy tale. Her cast power isn't a big deal, but she is so smart she can use it to rival even the strongest students in the academy."}],"source":"vndb","sourceCharacterId":"c29434"},{"segments":[{"spoiler":false,"text":"頭脳明晰、無駄を好まない理論派少女。"},{"spoiler":false,"text":"しかし、そんな彼女にもわからないことはある。"},{"spoiler":false,"text":"それは自分が何を成せばいいのかということ。"},{"spoiler":false,"text":"なんのために生まれ生きていくのかという未来。"},{"spoiler":false,"text":"彼女が勉強に打ち込んできたのは、何を成せばわからないが､その時が来た時対応できる知恵を身につけておきたいという思いからである。"},{"spoiler":false,"text":"人には役割があると考えている。"},{"spoiler":false,"text":"自分には何が出来るかわからないが、≪キャスト≫として生まれたのも運命なのだろうと、それに従い生きている。その先に答えがあるに違いないと信じて。"}],"source":"egs","sourceCharacterId":"5296","sourceWorkId":"20949","spoiler":false},{"segments":[{"spoiler":false,"text":"頭脳明晰、無駄を好まない理論派少女。"},{"spoiler":false,"text":"人には役割があると考えており、自分が何を成せば良いのか、何のために生きていくのかを模索している。"},{"spoiler":false,"text":"自分のすべきことが見つかった時、それに対応できる知恵を身に付けておきたいと考え、今まで勉強に打ち込んできた。"},{"spoiler":false,"text":"“グレーテル” のキャスト。 キャストとして生まれたのも運命なのだろうと考えている。"},{"spoiler":false,"text":"自分に何が出来るのか分からないが、これからその答えが見つかるに違いないと信じて生きている。"},{"spoiler":false,"text":"「時間は有限なのです、無駄なことに消費するなど愚かな行為としか言いようがありませんね」"}],"source":"bangumi","sourceCharacterId":"30182"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38e5211f5075b337746969c11d4bbc9ce84579a322b47fb882b9686a4679e4ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/0887e1d3b2a9eb339d46e84ea426372cc556963bd6ff6d21527e6a2448411188.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:116528:30182:5075:1","source":"bangumi"}]},{"characterId":"char_c29435","characterName":"明星 千恵美","sourceIds":{"bangumi":[{"characterId":"30183","match":"exact-normalized-name-in-linked-work","subjectId":"116528"}],"egsCharacterIds":["5297"],"vndbCharacterId":"c29435"},"originalCharacterName":"明星 千恵美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Playful, energetic and friendly, Chiemi grew in a big family, and being the only girl among the children, she always played boys games, that made Chiemi a somewhat tomboyish. Despite being a Cast, she didn't receive any bullying nor special treatment, probably because of how friendly she is. Because people always said she wasn't feminine she never had interest in love and never believed someone would ever fall for her. She's always being challenged to duels to help clubs in need as she is very athletic and talented."},{"spoiler":false,"text":"Chiemi is always upfront about things and her catchphrase is \"I rather doing it than not doing and regret it\". When she realizes she fell in love with the protagonist she immediately confesses to him."},{"spoiler":false,"text":"Her Cast is Alice Card. She picks a card in a deck of 54 cards, with 2 jokers, wich she only drew once. The card suit will define the weapon: Swords become swords, Clubs become a gauntlet, Diamonds become a spear and Hearts become a bow. The card's number define the weapon strength or, in the bow case, the number of arrows shot at once. She needs to use the same card for 3 minutes, after that the weapon disappears, regardless of her wish and she may then draw another card."},{"spoiler":false,"text":"Her powers are inspired from Alice in Wonderland, and she's a Princess Level cast, but she loses a lot because she's dependent on luck."}],"source":"vndb","sourceCharacterId":"c29435"},{"segments":[{"spoiler":false,"text":"とにかく明るく天真爛漫で前向きな女の子。"},{"spoiler":false,"text":"身体を動かすことが好きで、とにかくスポーツ万能。"},{"spoiler":false,"text":"しかし大会に出て優勝しても、≪キャスト≫だから当然という風に思う人間が少なからずいる。"},{"spoiler":false,"text":"だけど、生まれを嘆いたり、屈折したり、鼻にかけることなく真っ直ぐに生きている。"},{"spoiler":false,"text":"楽しいことをしたい！　楽しくない人生なんて面白くない！　そんな姿勢を見習いたいと皇志は思う。"},{"spoiler":false,"text":"自分にとって楽しいこととはなんだろう。そして自分にも誰かを楽しませることが出来るだろうかと。"}],"source":"egs","sourceCharacterId":"5297","sourceWorkId":"20949","spoiler":false},{"segments":[{"spoiler":false,"text":"とにかく明るく天真爛漫で前向きな女の子。"},{"spoiler":false,"text":"身体を動かすことが大好きでスポーツ万能。"},{"spoiler":false,"text":"大会で優勝しても、キャストだから当然と思う人間が少なからずいたり妬まれたりもするが、 自分がキャストであることをきちんと受け入れ、屈折したり鼻に掛けたりすることなく真っ直ぐに生きている。"},{"spoiler":false,"text":"“楽しいことをしたい！ 楽しくない人生なんて面白くない！” と思っており、自分にとっての楽しいこと、そして誰かを楽しませることを常に考えている。"},{"spoiler":false,"text":"「あはは、やっぱり勝負は良いよね。 お互いの持てる力をぶつけ合ってしのぎを削る、最高に燃えるもの！」"}],"source":"bangumi","sourceCharacterId":"30183"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fe0058b81cb57b81be09102e87fcfdf0d8610f27d6d817cd66e190a10eb69dad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69f55a0e1f4cca6d8f8a877a7f111c2d7af342c0e09fef1121a1722e782b42a4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞田朱音","creatorId":"vndb:s610","sourcePersonId":"vndb:s610","canonicalEntityId":"vndb:s610","name":"眞田 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:116528:30183:5928:1","source":"bangumi"}]},{"characterId":"char_vndb_c41563","characterName":"吹雪 氷華","sourceIds":{"vndbCharacterId":"c41563"},"originalCharacterName":"吹雪 氷華","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The wife of the late King, the previous Prince Cast. She's know for her power and beauty. No one know how she can look so young even after past 50 years old."}],"source":"vndb","sourceCharacterId":"c41563"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a24f6d66a3f1a5a9f7b3fc7f5add6cbe6f581948c2e622890b2fb3819754ddb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73c741e9f383d049c3a390bddc7858d219b1313265374e5387a3791d16730eb8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"かわしま りの","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:60338","source":"vndb"}]},{"characterId":"char_vndb_c41564","characterName":"月見 清音","sourceIds":{"vndbCharacterId":"c41564"},"originalCharacterName":"月見 清音","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kouji and Tsubomi met her the morning he transferred to their school and she was a shy and apologetic girl. However when she entered the class she had a completely diferrent personality."},{"spoiler":false,"text":"Miki's childhood friend. When they were small she was bullied by casts and was saved by Miki. She's the spark that caused Miki to want to become the Queen to make society more just. She loves Miki and doesn't even try to hide. Seems to have a deep hatred for any Cast except Miki."}],"source":"vndb","sourceCharacterId":"c41564"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"ur