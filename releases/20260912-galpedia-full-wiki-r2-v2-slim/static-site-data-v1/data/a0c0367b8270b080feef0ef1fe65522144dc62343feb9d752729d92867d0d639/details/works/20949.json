{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"20949","model":{"presentationWorkId":"vndb:v15822","staff":{"artwork":[{"creditedName":"瑠奈璃亜","creatorId":"vndb:s1899","sourcePersonId":"egs:creator:5658","canonicalEntityId":"vndb:s1899","name":"瑠奈璃亜","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:136349","source":"egs"},{"creditedName":"上弦","creatorId":"vndb:s7983","sourcePersonId":"egs:creator:20569","canonicalEntityId":"vndb:s7983","name":"上弦","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:150048","source":"egs"}],"scenario":[{"creditedName":"宮村優","creatorId":"vndb:s973","sourcePersonId":"egs:creator:567","canonicalEntityId":"vndb:s973","name":"宮村優","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:136350","source":"egs"}],"music":[{"creditedName":"RYU","creatorId":"vndb:s3328","sourcePersonId":"egs:creator:21598","canonicalEntityId":"vndb:s3328","name":"RYU","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:136351","source":"egs"}],"other":[{"creditedName":"nao","creatorId":"egs:creator:14533","sourcePersonId":"egs:creator:14533","canonicalEntityId":"egs:creator:14533","name":"nao","detail":"OP曲「jewelic saga」、挿入歌「Folktales Princess」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-creator:136372","source":"egs"},{"creditedName":"わんこ社長","creatorId":"egs:creator:20322","sourcePersonId":"egs:creator:20322","canonicalEntityId":"egs:creator:20322","name":"わんこ社長","detail":"プロデューサー","roleCode":"other","roleLabel":"其他","identityStatus":"no-alias-hit","relationId":"egs:work-creator:138143","source":"egs"},{"creditedName":"倉持キョーリュー","creatorId":"egs:creator:20383","sourcePersonId":"egs:creator:20383","can