599","match":"exact-normalized-name-in-linked-work","subjectId":"150138"}],"egsCharacterIds":["4419"],"vndbCharacterId":"c22089"},"originalCharacterName":"伊予","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Though her outward appearance is that of an innocent young girl, she's actually an ancient zashiki-warashi. Iyo supports Makoto with her vast reserves of knowledge, a fact that is not lost upon the inexperienced young head of the Kagami family. As a zashiki-warashi, she supposedly brings fortune to everyone who resides in the same house as her, but her twisted personality and tendency to tease others makes that hard to believe."},{"spoiler":false,"text":"Iyo is a hardcore gamer and seems to stay in her room, on her computer, at all times unless there's food on the table. She mainly prefers online games too, where her dominant personality is fully unleashed."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c22089"},{"segments":[{"spoiler":false,"text":"見た目はあどけない少女だが、その正体は長い年月を生きる座敷わらし。"},{"spoiler":false,"text":"お役目に不慣れな真をその豊富な知識でサポートする。"},{"spoiler":false,"text":"座敷わらしの特性から加賀見家に福を呼ぶ存在ではあるが、性格はねじくれており他人（特に真）をおちょくる天才。"},{"spoiler":false,"text":"また重度のゲーマーで、食事時以外は自室に引きこもっている。"},{"spoiler":false,"text":"主にネトゲを好み、もちろんトップクラスの廃人である。"}],"source":"egs","sourceCharacterId":"4419","sourceWorkId":"20717","spoiler":false},{"segments":[{"spoiler":false,"text":"加賀見家に棲みつく座敷わらし。"},{"spoiler":false,"text":"見た目はあどけない少女だが、中身は下ネタ好きのおっさんである。"},{"spoiler":false,"text":"そして廃がつくほどのゲーマーで、一日中自室に引きこもっている。"},{"spoiler":false,"text":"加賀見家の相談役としてお役目の手助けをしていたが、真が経験を積み成長したことで、最近はあまり口を挟まなくなった。"}],"source":"egs","sourceCharacterId":"4419","sourceWorkId":"22473","spoiler":false},{"segments":[{"spoiler":false,"text":"見た目はあどけない少女だが、その正体は長い年月を生きる座敷わらし。"},{"spoiler":false,"text":"お役目に不慣れな真をその豊富な知識でサポートする。"},{"spoiler":false,"text":"座敷わらしの特性から加賀見家に福を呼ぶ存在ではあるが、性格はねじくれており他人 （特に真） をおちょくる天才。"},{"spoiler":false,"text":"また重度のゲーマーで、食事時以外は自室に引きこもっている。"},{"spoiler":false,"text":"主にネトゲを好み、もちろんトップクラスの廃人である。"}],"source":"bangumi","sourceCharacterId":"26599"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd13e2ae3ae9ed339e9c31d9a8450f6a08c0fd845cc8cf07297a5d4f2ab93205.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8e9ca35ec0f9bd6f7e47c20ec53e0deb707f1314b1dc0516bf32cd037a30518.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"柏木美優","creatorId":"vndb:s1030","sourcePersonId":"vndb:s1030","canonicalEntityId":"vndb:s1030","name":"柏木 美優","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:109758:26599:6540:1","source":"bangumi"}]},{"characterId":"char_c22090","characterName":"滝川 琴莉","sourceIds":{"bangumi":[{"characterId":"26596","match":"exact-normalized-name-in-linked-work","subjectId":"109758"}],"egsCharacterIds":["4416"],"vndbCharacterId":"c22090"},"originalCharacterName":"滝川 琴莉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"1/1"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"A"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who attends a school close to Makoto's house, who chooses to become his assistant after he helps her out of a rough situation. She has an unnaturally strong sixth sense, which allows her to see ghosts, though her abilities are still flawed compared to Makoto's. However, she can sense spirits near her, which is an ability that is wholly her own."},{"spoiler":false,"text":"Kotori is a bright, cheerful individual with a smile that never fades, but is sometimes so straightforward that she confuses those around her. She sees Makoto as an older brother of sorts and is constantly concerned about his safety."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c22090"},{"segments":[{"spoiler":false,"text":"付近の学園に通う少女。"},{"spoiler":false,"text":"真に助けてもらったことがきっかけで、お役目を手伝うようになる。"},{"spoiler":false,"text":"不完全ながら霊視の力を持っており、真が視ているモノを琴莉も視ることができる。"},{"spoiler":false,"text":"また、そばにいる霊の存在を感じることができるという、真にはない力を持っている。"},{"spoiler":false,"text":"とても明るく快活な性格で笑顔が絶えないが、まっすぐすぎて時折周りがびっくりしてしまうような行動をとることも。"},{"spoiler":false,"text":"真を兄のように慕っており、常に身を案じている。"}],"source":"egs","sourceCharacterId":"4416","sourceWorkId":"20717","spoiler":false},{"segments":[{"spoiler":false,"text":"付近の学園に通う少女。"},{"spoiler":false,"text":"真に助けてもらったことがきっかけで、お役目を手伝うようになる。"},{"spoiler":false,"text":"不完全ながら霊視の力を持っており、真が視ているモノを琴莉も視ることができる。"},{"spoiler":false,"text":"また、そばにいる霊の存在を感じることができるという、真にはない力を持っている。"},{"spoiler":false,"text":"とても明るく快活な性格で笑顔が絶えないが、まっすぐすぎて時折周りがびっくりしてしまうような行動をとることも。"},{"spoiler":false,"text":"真を兄のように慕っており、常に身を案じている。"}],"source":"bangumi","sourceCharacterId":"26596"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6f6c4177181bfe5dbb8e002ac41393bc1a5f4fe8b01db7a2033f61c71e180c5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e2c8086c043303e3ef946771af2557dd6c0f35840fea3b3afe95375c0efa9fa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:109758:26596:11646:1","source":"bangumi"}]},{"characterId":"char_c22091","characterName":"土方 由美","sourceIds":{"bangumi":[{"characterId":"26597","match":"exact-normalized-name-in-linked-work","subjectId":"109758"}],"egsCharacterIds":["4417"],"vndbCharacterId":"c22091"},"originalCharacterName":"土方 由美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A junior who attends the same university as Makoto, although their long-standing relationship stretches much further past that. Unfortunately, the two of them are rather distant and awkward around each other at present because of certain circumstances..."},{"spoiler":false,"text":"Yumi appears very bold and headstrong at a glance, but is actually quite shy and a bit of a late bloomer, even coming off as stiff and cold to the customers at the cafe where she works part-time. She completely lacks any kind of sixth sense, which means she views the world in a different light from Makoto. Still, despite everything, she desperately wishes to improve her relationship with him."},{"spoiler":false,"text":"From Steam"}],"source":"vndb","sourceCharacterId":"c22091"},{"segments":[{"spoiler":false,"text":"真と同じ大学に通い、学年も同じく三年生。"},{"spoiler":false,"text":"大学以前からの知り合いではあるようだが、真との関係はどこかよそよそしくぎこちない。"},{"spoiler":false,"text":"気が強そうに見えるが実際には奥手でかなりの人見知り。"},{"spoiler":false,"text":"喫茶店でアルバイトをしているが、接客態度は少し硬め。"},{"spoiler":false,"text":"霊感が一切なく、それが真との間に認識のズレを生んでしまうが、本人は真との関係を改善したいと思っている様子。"}],"source":"egs","sourceCharacterId":"4417","sourceWorkId":"20717","spoiler":false},{"segments":[{"spoiler":false,"text":"真と同じ大学に通い、学年も同じく三年生。"},{"spoiler":false,"text":"大学以前からの知り合いではあるようだが、真との関係はどこかよそよそしくぎこちない。"},{"spoiler":false,"text":"気が強そうに見えるが、実際には奥手でかなりの人見知り。"},{"spoiler":false,"text":"喫茶店でアルバイトをしているが接客態度は少し硬め。"},{"spoiler":false,"text":"霊感が一切なく、それが真との間に認識のズレを生んでしまうが、本人は真との関係を改善したいと思っている様子。"}],"source":"bangumi","sourceCharacterId":"26597"}],"profileFacts":[],"metadat