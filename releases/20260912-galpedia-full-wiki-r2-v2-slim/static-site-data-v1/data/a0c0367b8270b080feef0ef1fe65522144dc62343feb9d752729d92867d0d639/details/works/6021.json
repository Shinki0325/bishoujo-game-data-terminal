{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"6021","model":{"presentationWorkId":"vndb:v4819","staff":{"artwork":[{"creditedName":"丹下ゲンタ(氷雨げんた)","creatorId":"vndb:s4217","sourcePersonId":"egs:creator:1483","canonicalEntityId":"vndb:s4217","name":"丹下ゲンタ(氷雨げんた)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:10366","source":"egs"}],"scenario":[{"creditedName":"西矢沙広","creatorId":"vndb:s2600","sourcePersonId":"egs:creator:1902","canonicalEntityId":"vndb:s2600","name":"西矢沙広","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:10367","source":"egs"}],"music":[{"creditedName":"m.c.TOM","creatorId":"vndb:s6343","sourcePersonId":"egs:creator:2622","canonicalEntityId":"vndb:s6343","name":"m.c.TOM","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:10368","source":"egs"},{"creditedName":"小池正一","creatorId":"vndb:s5733","sourcePersonId":"egs:creator:3402","canonicalEntityId":"vndb:s5733","name":"小池正一","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:23549","source":"egs"}],"other":[{"creditedName":"鬼影 姚二","creatorId":"vndb:s206","sourcePersonId":"vndb:s206","canonicalEntityId":"vndb:s206","name":"鬼影 姚二","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:53203","source":"vndb"}]},"cast":[{"characterId":"char_c71424","characterName":"藤木 祭里","sourceIds":{"bangumi":[{"characterId":"149013","match":"exact-normalized-name-in-linked-work","subjectId":"230368"}],"egsCharacterIds":["26493"],"vndbCharacterId":"c71424"},"originalCharacterName":"藤木 祭里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"64"},"height":{"reviewState":"no-conflict","source":"vndb","value":"143"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"70"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"明るく素直な性格で、主人公にべったり気味。凛とは本当の姉妹のように仲が良いが、少し距離を置かれていることを悲しく思っているフシもある。義母にもあまり反感は持っていない。"},{"spoiler":false,"text":"凛を大切に思っているが、主人公と肉体関係を結んだことを知ってからは複雑な感情を抱く。"},{"spoiler":false,"text":"主人公には止めてほしいという感情。凛には同情を感じる反面、主人公を取られたという嫉妬もわずかに感じている。それらの想いがやがて独占欲と愛欲に歪んでいく。"}],"source":"egs","sourceCharacterId":"26493","sourceWorkId":"6021","spoiler":false},{"segments":[{"spoiler":false,"text":"明るめの性格で、素直に主人公を慕う。というか、やや（かなり？）"},{"spoiler":false,"text":"べったり気味。"},{"spoiler":false,"text":"義妹とは本当の姉妹のように仲が良いが、少し距離を置かれていることを"},{"spoiler":false,"text":"悲しく思っているフシも。"},{"spoiler":false,"text":"義母に対しても、あまり反感などは持っていない。"},{"spoiler":false,"text":"凛を大切に思っているが、主人公と肉体関係を結んだことを知ってからは、"},{"spoiler":false,"text":"複雑な感情を持つ。"},{"spoiler":false,"text":"主人公には止めて欲しいという感情。"},{"spoiler":false,"text":"凛には同情を感じる反面、主人公を取られたという僅かな嫉妬を。"},{"spoiler":false,"text":"それらの想いは、やがて独占欲と愛欲に歪んでいき……。"}],"source":"bangumi","sourceCharacterId":"149013"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d34f498388b8c31ced88eae11614308c978ff2fe72de39e2c546085c7b5cdb0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/668c6ef0093a8fa46fde22ace5758ad2e7a163246746471c00d30b1201c5f2c1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤本教子","creatorId":"vndb:s649","sourcePersonId":"vndb:s649","canonicalEntityId":"vndb:s649","name":"藤本 教子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230368:149013:5669:1","source":"bangumi"}]},{"characterId":"char_c71425","characterName":"藤木 凛","sourceIds":{"bangumi":[{"characterId":"149014","match":"exact-normalized-name-in-linked-work","subjectId":"230368"}],"egsCharacterIds":["26494"],"vndbCharacterId":"c71425"},"originalCharacterName":"藤木 凛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"68"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"70"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"父親が再婚した相手の連れ子。苦労を重ねてきたせいか、少し退廃的な雰囲気を持つ。順応や諦めが早く、物事に受動的。主人公に***されても、わが身の行く当てのなさと祭里への配慮から黙って受け入れた。だがそれが祭里と主人公の関係を修復不能にしたことに気付き戦慄する。"},{"spoiler":false,"text":"祭里のことは好きだが、自分と母のせいで主人公が家を出たと思っているため、どこか後ろめたく、完全に心を開けない。自分のことを「凛」と呼び捨てにするなど、自分を客観視するクセがある。"}],"source":"egs","sourceCharacterId":"26494","sourceWorkId":"6021","spoiler":false},{"segments":[{"spoiler":false,"text":"父が再婚した相手の連れ子。"},{"spoiler":false,"text":"苦労しているのか、少し退廃的な雰囲気を持つ。（普段は表に出ないが、"},{"spoiler":false,"text":"諦めが早かったり、状況への順応が早い。多くのことに対して受動的）"},{"spoiler":false,"text":"主人公に犯されるが、行く当てのない我が身と、祭里への配慮から、"},{"spoiler":false,"text":"黙ってそれを受け入れた。"},{"spoiler":false,"text":"祭里に肉体関係を知られてからは、自分こそが祭里と主人公の関係を"},{"spoiler":false,"text":"修復不能なまでに壊してしまったのだと、恐れおののくことになる。"},{"spoiler":false,"text":"祭里のことは好きだが、自分と母の所為で主人公が家を出てしまったと"},{"spoiler":false,"text":"思っているため、どこか後ろめたい感情も持っている。"},{"spoiler":false,"text":"義父との仲は良好だが、やはり負い目のためか、"},{"spoiler":false,"text":"心からは打ち解けられていない。"},{"spoiler":false,"text":"自分を『凛』と呼び捨てにしたりと、自分を他人のように"},{"spoiler":false,"text":"扱うクセがある。"}],"source":"bangumi","sourceCharacterId":"149014"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e640108097dca80ad45b7b7965555707d3cc439fbf42584303b9