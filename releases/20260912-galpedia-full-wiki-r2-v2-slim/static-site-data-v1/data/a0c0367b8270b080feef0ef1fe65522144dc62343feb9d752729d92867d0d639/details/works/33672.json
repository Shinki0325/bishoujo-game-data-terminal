{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"33672","model":{"presentationWorkId":"egs:33672","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_109352","characterName":"Cyrus","sourceIds":{"bangumi":[{"characterId":"109352","match":"source-roster","subjectId":"216488"},{"characterId":"109352","match":"source-roster","subjectId":"216489"},{"characterId":"109352","match":"source-roster","subjectId":"329299"},{"characterId":"109352","match":"source-roster","subjectId":"329300"}]},"originalCharacterName":"Cyrus","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"bangumi","value":"27"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"赤日是银河队的老大，他是一位没有情绪的男人，为了摧毁和重建世界而建立银河队。"},{"spoiler":false,"text":"他认为人心是不完美的东西，有著利用传说的宝可梦帝牙卢卡及帕路奇亚的力量，把现在的世界消灭，创造完美新世界的野心。"},{"spoiler":false,"text":"赤日总是采取冷静又有逻辑的言行举止，深得银河队部下的信赖。"}],"source":"bangumi","sourceCharacterId":"109352"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"109352","value":"企业家"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8da99da92c035a589c5608744ace355115d115168411ed7b5a3ac91b27da64c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/728cab6983b4f139143b2200fc002c9fcbe5bca4749e0b079a257f1ed4bca14b.webp","width":132,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_109353","characterName":"火星，玛姿","sourceIds":{"bangumi":[{"characterId":"109353","match":"source-roster","subjectId":"329299"},{"characterId":"109353","match":"source-roster","subjectId":"329300"}]},"originalCharacterName":"火星，玛姿","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"伙星是宝可梦中银河队的干部之一。"}],"source":"bangumi","sourceCharacterId":"109353"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/1248640817e2a370ee184c77d42325075668ffe2453de4cdf164141374eba8d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7d3baf69ec5604d2e666b9e8a27ca89ad92ac502d65169310dcb2c916cf60c5.webp","width":107,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_109354","characterName":"丘比特，朱庇特","sourceIds":{"bangumi":[{"characterId":"109354","match":"source-roster","subjectId":"329299"},{"characterId":"109354","match":"source-roster","subjectId":"329300"}]},"originalCharacterName":"丘比特，朱庇特","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"岁星是宝可梦中银河队的干部之一。"}],"source":"bangumi","sourceCharacterId":"109354"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/082b17ed9bdb56f949c61a86258efaea9da8b3852f8a0115d93fd2706a601087.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48aecb228511d87ff283f6392041df5d564e2580fb6a3c6cc4fbd4cb8a690907.webp","width":116,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_109355","characterName":"土星，萨坦，撒旦","sourceIds":{"bangumi":[{"characterId":"109355","match":"source-roster","subjectId":"329299"},{"characterId":"109355","match":"source-roster","subjectId":"329300"}]},"originalCharacterName":"土星，萨坦，撒旦","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"镇星是宝可梦中银河队的干部之一。"}],"source":"bangumi","sourceCharacterId":"109355"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a685f8fb415548edb33c0d02a21cc579723ea7fa6322fd15724ba062d7941353.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9f142ea9fa6f08b01dd9009b8c498fb5d5f55e465f01d96ce3b7510dbcb4be7.webp","width":121,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_204725","characterName":"大木雪成","sourceIds":{"bangumi":[{"characterId":"204725","match":"source-roster","subjectId":"329299"},{"characterId":"204725","match":"source-roster","subjectId":"329300"}]},"originalCharacterName":"大木雪成","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大木雪成博士是关都地区的宝可梦博士。"},{"spoiler":false,"text":"个性"},{"spoiler":false,"text":"大木博士是研究宝可梦的权威，主要研究课题为“宝可梦与人类的关系”。是他主张用属性对宝可梦进行分类的。他同时也担任石英高原宝可梦联盟的顾问。"},{"spoiler":false,"text":"大木博士曾经就读于玉虹大学理工科，毕业后继续在该大学读生物学硕士，现在是该大学的宝可梦学教授。大木博士以前是一位出色的训练家，四天王之一菊子和他曾经是好友。但后来他隐退了，开始研究起了宝可梦，菊子认为他变软弱了，因此疏远了他。钢铁家的照片显示他、大木博士、菊子都是好友。"},{"spoiler":false,"text":"经历"},{"spoiler":false,"text":"《红／绿／蓝／皮卡丘》"},{"spoiler":false,"text":"在一开始，当主角想要离开真新镇时，他会出现叫住主角。此时他会收服一只皮卡丘Y。之后他带领主角来到他的研究所，让主角和青绿领取最初的伙伴。之后来到常青市的友好商店，店员会让主角把包裹送到大木博士那里，那是他订做的宝可梦图鉴。送到后他会把图鉴给主角和青绿。他会在主角战胜冠军后出现，带领主角登入名人堂。"},{"spoiler":false,"text":"去研究所中找大木博士，他就会对主角的宝可梦图鉴的完成情况作出评价。"},{"spoiler":false,"text":"《金／银／水晶版》"},{"spoiler":false,"text":"大木博士出现在３０号道路的宝可梦爷爷家里。他会给主角宝可梦图鉴。他会在主角战胜冠军后出现，带领主角登入名人堂。获得16枚徽章后，去大木博士的研究所中与他对话即可获得前往白银山的资格。"},{"spoiler":false,"text":"去研究所中找大木博士，他会对主角的宝可梦图鉴的完成情况作出评价。"},{"spoiler":false,"text":"大木博士同时担任宝可装置节目大木博士的宝可梦讲座的主持人。最初大木博士想要推辞主持人邀请，但是不敌胡桃的热情。"},{"spoiler":false,"text":"《火红／叶绿》"},{"spoiler":false,"text":"大木博士的剧情与《红／绿／蓝》相同。额外的，登入名人堂后，当主角捕捉至少60只的不同宝可梦后，去研究所找他他会把主角的图鉴升级到全国图鉴。"},{"spoiler":false,"text":"《钻石／珍珠》"},{"spoiler":false,"text":"登入名人堂后，当主角遇见至少150只神奥地区的宝可梦后，在真砂镇的山梨研究所处与山梨博士谈话后由大木博士会出现，为主角升级全国图鉴。之后他会出现在２２１号道路，为主角介绍伙伴公园，并给了主角新的宝可表功能宝可追踪计数器。他还会出现在百代市的民居里，送出升级数据。"},{"spoiler":false,"text":"在百代市他也会对主角的全国图鉴的完成情况作出评价。"},{"spoiler":false,"text":"登入名人堂后，当主角持有大木的信来到２２４号道路，调查这里的白色岩石时，大木博士会出现并介绍这块白色岩石的事情。米依也会在这里出现，众人会遇见谢米，前往花之乐园。"},{"spoiler":false,"text":"《白金》"},{"spoiler":false,"text":"大木博士的剧情与《钻石／珍珠》相同，不同的是升级全国图鉴的条件变为遇见至少210只神奥地区的宝可梦。额外的，在百代市他还会讲述传说的鸟宝可梦的故事，之后传说的鸟宝可梦会在神奥地区四处游走。"},{"spoiler":false,"text":"《心金／魂银》"},{"spoiler":false,"text":"大木博士的剧情与《金／银／水晶版》大致相同。额外的，登入名人堂之后，大木博士会来到浅葱港，为主角升级全国图鉴。"},{"spoiler":false,"text":"获得16枚徽章后，去大木博士的研究所中与他对话即可获得前往白银山的资格，此时他会送出秘传学习器０８（攀岩）。战胜赤红后，在研究所中他会送给主角妙蛙种子、小火龙和杰尼龟三只其中一只作为礼物。之后他会发邮件给宝可梦爷爷，让后者送给主角朱红色宝珠/靛蓝色宝珠。与在埋藏之塔收服的固拉多和盖欧卡同时同行去研究所找大木博士，他会送出草绿色宝珠，可以在埋藏之塔召唤烈空坐。"},{"spoiler":false,"text":"完成全国图鉴后（不需要幻之宝可梦），可以在研究所中与他合影。"},{"spoiler":false,"text":"《Let's Go! 皮卡丘／Let's Go! 伊布》"},{"spoiler":false,"text":"大木博士的剧情《皮卡丘》大致相同。只不过收服教学改为了他在一旁指挥主角，宝可梦图鉴在赠送搭档宝可梦时一并送出，包裹改为了蔓莓果×20。而在石英高原宝可梦联盟，大木博士会在战胜阿渡后就提前登场。"},{"spoiler":false,"text":"此外，还可以通过宝可梦盒将收服的宝可梦传送给大木博士来换取糖果。获得的糖果类型取决于转移的种类和数量。每传送1只宝可梦，大木博士会奖励1个通用的糖果。每50只同种宝可梦，大木博士还会额外奖励该宝可梦特定的糖果。"}],"source":"bangumi","sourceCharacterId":"204725"}],"profileFacts":[{"label":"职业","source":"bangumi","sourceCharacterId":"204725","value":"宝可梦博士"},{"label":"职业","source":"bangumi","sourceCharacterId":"204725","value":"播音员"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e04df6340b84c83aa49abc971561b8f48f9d1081912bb306d5bb8387b44f67e7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3b8ef16351e27ed5a79007f0a7cf46d1332352c6ee1547dfe90ec720c39ba8b.webp","width":161,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_75705","characterName":"Dawn","sourceIds":{"bangumi":[{"characterId":"75705","match":"source-roster","subjectId":"329299"},{"characterId":"75705","match":"source-roster","subjectId":"329300"}]},"originalCharacterName":"Dawn","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"140"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"},"weight":{"reviewState":"source-only","source":"bangumi","value":"34"}},"descriptions":[{"segments":[{"spoiler":false,"text":"作為選擇的角色"},{"spoiler":false,"text":"小光是來自雙葉鎮的少女。"},{"spoiler":false,"text":"作為未被選擇的角色"},{"spoiler":false,"text":"若選擇光輝為主角，她會在同一遊戲中成为山梨博士的助手，住在真砂鎮。"}],"source":"bangumi","sourceCharacterId":"75705"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/230ed7fec944daf5bebb6381ef31fd9d0c3800d6962f39d50b55a61f5371676a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b992201dea91c7d703be94ab3b40d4b534afb726048ebf4090b18b88d2e64ff.webp","width":143,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_75818","characterName":"铜墙铁壁的女孩","sourceIds":{"bangumi":[{"characterId":"75818","match":"source-roster","subjectId":"329299"},{"characterId":"75818","match":"source-roster","subjectId":"329300"}]},"originalCharacterName":"铜墙铁壁的女孩","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"150"},"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"阿蜜是浅葱道馆的道馆馆主，精通钢属性，掌管钢铁徽章。"},{"spoiler":false,"text":"个性"},{"spoiler":false,"text":"阿蜜是一位给人清纯印象的女孩。她的食量意外地很大，会经常光顾浅葱食堂。因为她的性格有点怕羞，被看到在她的座位旁边堆满了吃剩的餐盘后，会用“这是前一个食客吃的”这样的理由来试图搪塞。阿蜜与莉佳是好朋友。"},{"spoiler":false,"text":"经历"},{"spoiler":false,"text":"《金／银／水晶版》"},{"spoiler":false,"text":"当浅葱灯塔里的电龙光儿病了的时候，阿蜜不分日夜地在旁边照顾。她委托主角去湛蓝市取秘传之药，治好了光儿她才会回去道馆。在道馆中战胜她可以获得钢铁徽章和招式学习器２３（铁尾）。"},{"spoiler":false,"text":"《钻石／珍珠／白金》"},{"spoiler":false,"text":"阿蜜会出现在滨海市北部的沙滩，她说这座城市勾起了她对故乡浅葱市的回忆。在主角打败滨海道馆的馆主电次后，她会送出秘传学习器０７（攀瀑）。她也会参加大师级的超级华丽大赛，使用名为奈儿（日文︰ネール，英文︰Rusty）的大钢蛇。"},{"spoiler":false,"text":"《心金／魂银》"},{"spoiler":false,"text":"阿蜜的剧情和《金／银》相同。额外的，登入名人堂后，每天13:00-14:00她会在浅葱食堂，可以在这时拿到她的宝可装置号码。之后，每天12:00-13:00可以在此和她合影。如果在星期三白天打给她的话，她会前往格斗道场等待再战。首次再战胜利后，在浅葱道馆她会用大钢蛇奈儿交换主角的任意宝可梦。"},{"spoiler":false,"text":"获得16枚徽章后，星期六、日15:00-17:00，阿蜜会在玉虹市的喷泉处与莉佳谈话，她对于自己过于普通不出色这件事感到有些苦恼，并表示对华丽大赛感兴趣。"},{"spoiler":false,"text":"阿蜜也会参加宝可全能竞技赛的全明星杯。"},{"spoiler":false,"text":"《黑２／白２》"},{"spoiler":false,"text":"阿蜜会参加宝可梦世界锦标赛的城都馆主赛、世界馆主赛、属性专家赛、租借大师赛以及集结！道馆馆主！。"},{"spoiler":false,"text":"《晶灿钻石／明亮珍珠》"},{"spoiler":false,"text":"阿蜜的剧情和《钻石／珍珠》相同，她也会参加超级华丽大赛。"}],"source":"bangumi","sourceCharacterId":"75818"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d33a062d3465da5cba9edd0e88ea9f9d19fc4e77f089f5af07d367b8e8f706a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb2875bb7ca2a01b0072af11249a6edd9ff096a699f4b5dd1ad5b6a4bf3d5a9e.webp","width":90,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_91896","characterName":"光辉，小辉","sourceIds":{"bangumi":[{"characterId":"91896","match":"source-roster","subjectId":"329299"},{"characterId":"91896","match":"source-roster","subjectId":"329300"}]},"originalCharacterName":"光辉，小辉","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"143"},"sex":{"reviewState":"source-only","source":"bangumi","value":"m"},"weight":{"reviewState":"source-only","source":"bangumi","value":"38"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77094d312533d4d2db65024024e6261cfc43616d93a87fa6d23451b3f778eab5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e0780485fa8cae160410311e9b51922595c18b30daf9eea821335e14dd9fbed.webp","width":110,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:6549","sourceCompanyId":"egs:brand:6549","canonicalEntityId":"egs:brand:6549","name":"ゲームフリーク","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:33672:6549","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
