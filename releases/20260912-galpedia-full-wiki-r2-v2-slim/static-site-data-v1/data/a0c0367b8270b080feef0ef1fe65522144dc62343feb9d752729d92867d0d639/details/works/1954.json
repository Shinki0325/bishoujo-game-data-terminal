images/7a/7a9f9e64b437cabf051187ad570f631108b83ab93ef13f00952c7a8bed871140.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"福田 賢二","creatorId":"vndb:s23263","sourcePersonId":"vndb:s23263","canonicalEntityId":"vndb:s23263","name":"福田 賢二","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1900","source":"vndb"}]},{"characterId":"char_vndb_c7177","characterName":"孔 濤羅","sourceIds":{"vndbCharacterId":"c7177"},"originalCharacterName":"孔 濤羅","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Kong Taoluo died in Macao. It is a demon that draws this blade now. A demon... of vengeance!\""},{"spoiler":false,"text":"A master swordsman and Neijia practitioner; Kong Taoluo was once the top assassin in the Shanghai-based crime syndicate known as the \"Qingyun Society.\" Renowned in the Chinese underworld as the \"Lightning Palm,\" a moniker attributed to his Neijia based ability to channel internal energy and kill cyber-warriors with a single touch of his palm. He is one of the few unaugmented people left in the underworld; loathed by Waijia practitioners."},{"spoiler":false,"text":"Betrayed, cut down and assumed dead by his childhood friend, fellow Society member and former Neijia master, Liu Haojun; Taoluo spends a year in hiding, recovering from his near-fatal injuries. Upon returning to Shanghai, he discovers the horrible truth of what has happened to his sister, Kong Ruili. He swears an oath of vengeance and sets out to murder those responsible, and to recover Ruili's soul fragments."}],"source":"vndb","sourceCharacterId":"c7177"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc4d14576e4fd922da09665506d989b5d7dc36257d453664f458fdef77dce744.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e0eb683419cb874615668c08b55822a940e1bb00a3f016d7ca9688cf026c1e1.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上 和彦","creatorId":"vndb:s374","sourcePersonId":"vndb:s374","canonicalEntityId":"vndb:s374","name":"井上 和彦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1890","source":"vndb"}]},{"characterId":"char_vndb_c7180","characterName":"瑞麗","sourceIds":{"vndbCharacterId":"c7180"},"originalCharacterName":"瑞麗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Bro... ther...?\""},{"spoiler":false,"text":"A specialized vessel made by Xie Yida, designed to contain the entirety of Kong Ruili's soul data. Kong Taoluo's companion."},{"spoiler":true,"text":"With each soul fragment recovered, Ruili gradually becomes her former self."}],"source":"vndb","sourceCharacterId":"c7180"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/50aa31ad34a2371346c820210c6e27ba74fbc8d19878603bbfa5f644c3e0753b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e534ed61a4a55a6dc92e16597602ac434769bcaadf5366e9881a5e4ffc2ad12.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田村 ゆかり","creatorId":"vndb:s104","sourcePersonId":"vndb:s104","canonicalEntityId":"vndb:s104","name":"田村 ゆかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1883","source":"vndb"}]},{"characterId":"char_vndb_c7182","characterName":"孔 瑞麗","sourceIds":{"vndbCharacterId":"c7182"},"originalCharacterName":"孔 瑞麗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I fear that you will forget everything - this peach garden, that I await your return - and vanish to some place where I cannot reach you.\""},{"spoiler":false,"text":"Kong Ruili, the most precious person in the world to Taoluo. She lived a sheltered life in the Kong family estate in the Kunlun Mountains, spending her days playing the guzheng in the peach garden; always worrying and awaiting Taoluo's return from his Society assignments. Ruili was highly educated and a skilled guzheng player - an art she pursued alongside Taoluo's calling for Daitian swordplay. They would often hone their crafts together in the garden."},{"spoiler":false,"text":"She was married to Liu Haojun, her and Taoluo's childhood friend. Brutally gang raped, tortured and ultimately the subject of an experimental soul transfer, leading to her brain death; what could possibly have lead to Haojun's actions remain unknown."}],"source":"vndb","sourceCharacterId":"c7182"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bcc4f0a3bc004e0fee3051d0b149353dee83ef40c15b33f4e46fbe942c5dad7e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e437dfafcb956c6f210f3849072c83dbe65a3b799af190483958d77bc4ba235.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田村 ゆかり","creatorId":"vndb:s104","sourcePersonId":"vndb:s104","canonicalEntityId":"vndb:s104","name":"田村 ゆかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1884","source":"vndb"}]},{"characterId":"char_vndb_c7183","characterName":"劉 豪軍","sourceIds":{"vndbCharacterId":"c7183"},"originalCharacterName":"劉 豪軍","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Come now, you make me sound like a villain.\""},{"spoiler":false,"text":"A master swordsman and former Neijia practitioner; Liu Haojun, known as the Demon-Eyed Adonis, was once Kong Taoluo's elder disciple and heir to the Neijia school of kung fu. Quickly rising through the ranks of the Qingyun Society, Haojun was forced to get cybernetic augmentations - effectively making him unable to channel internal energy, which Neijia is centered around."},{"spoiler":false,"text":"Taoluo's childhood friend and Ruili's husband; what caused him to cut down Taoluo and organize the gang rape, murder and experimental soul transfer of Ruili is unfathomable."}],"source":"vndb","sourceCharacterId":"c7183"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/188ec4cfe5c2e3fab345181024ff242c1730357a3aaedc355c9993ae55516b9b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2c69fdeeeb54329494c4f50682eafb30bdace01d8e53bc9e02d6cedfb979cf7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"速水 奨","creatorId":"vndb:s751","sourcePersonId":"vndb:s751","canonicalEntityId":"vndb:s751","name":"速水 奨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1893","source":"vndb"}]},{"characterId":"char_vndb_c7184","characterName":"樟 賈寶","sourceIds":{"vndbCharacterId":"c7184"},"originalCharacterName":"樟 賈寶","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"I guarantee you won't be disappointed.\""},{"spoiler":false,"text":"Zhang Jiabao is a high-ranking member of the Qingyun Society, and one of Liu Haojun's top lieutenants. He is the most successful pimp in Shanghai. A Waijia master known as the \"Six Vajra\" for his lightning fast strikes, surpassing the limits of human dynamic vision."},{"spoiler":false,"text":"One of the five responsible for Kong Ruili's rape and murder."}],"source":"vndb","sourceCharacterId":"c7184"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/9202d5d9a3688b5139fd70834415770ee48d7714ab76d3cfc5bdfbd00eb378b3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fcf3a85e283dd06d6fbe8cb9b609fc6493b612062c640792009a1e76d8b8db7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小杉 十郎太","creatorId":"vndb:s743","sourcePersonId":"vndb:s743","canonicalEntityId":"vndb:s743","name":"小杉 十郎太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1892","source":"vndb"}]},{"characterId":"char_vndb_c7185","characterName":"朱 笑嫣","sourceIds":{"vndbCharacterId":"c7185"},"originalCharacterName":"朱 笑嫣","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"gender":{"reviewState":"source-only","source":"vndb","value":"f"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Tonight you have 'til the count of 600. Got it?\""},{"spoiler":false,"text":"Zhu Shaoyan is a high-ranking member of the Qingyun Society, and one of Liu Haojun's top lieutenants. She serves as the Society's enforcer; dealing with internal conflicts and meting out punishment. A Waijia master known as the \"Demon Empress,\" wielding long claws and a cyber-whip."},{"spoiler":true,"text":"Zhu is notorious for her sadomasochism and habit of raping and murdering young women."},{"spoiler":false,"text":"One of the five responsible for Kong Ruili's rape and murder."}],"source":"vndb","sourceCharacterId":"c7185"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/13a1ed4fe0ef95a3332ebd135178ff272d4175364c03afc2f9c28d154636c1a8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f60a5c62ac2ac5254e9146930dc3a1acdffc4ea76861d09135e328f371b979d8.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"折笠 愛","creatorId":"vndb:s752","sourcePersonId":"vndb:s752","canonicalEntityId":"vndb:s752","name":"篠崎双葉","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1894","source":"vndb"}]},{"characterId":"char_vndb_c7186","characterName":"呉 榮成","sourceIds":{"vndbCharacterId":"c7186"},"originalCharacterName":"呉 榮成","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Heh, I'm a baby compared to you cyber-warriors.\""},{"spoiler":false,"text":"Ng Wing Shing is a high-ranking member of the Qingyun Society, and Liu Haojun's right-hand man, acting as the president of Shanghai Cybernetics. Ng is a legendary hacker and programmer known as the \"All-Consuming Poison\" for the deadly cyber virus he developed in his youth, which is still roaming the net and evolving. Ng is a hardcore gynoid doll lover and collector, spending his free time designing and dressing up gynoids."},{"spoiler":false,"text":"One of the five responsible for Kong Ruili's rape and murder."}],"source":"vndb","sourceCharacterId":"c7186"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/284457649d22a8cfab0cc71a038d649f28e2073e9ca2cf3b67e4544cc8c13297.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c937b3464bcb07663f4de8634c47c1f0106c84ac38b5220325aeca081860256.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大塚 芳忠","creatorId":"vndb:s1358","sourcePersonId":"vndb:s1358","canonicalEntityId":"vndb:s1358","name":"大塚 芳忠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1898","source":"vndb"}]},{"characterId":"char_vndb_c7187","characterName":"斌 偉信","sourceIds":{"vndbCharacterId":"c7187"},"originalCharacterName":"斌 偉信","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"...I have a matter of great importance to discuss.\""},{"spoiler":false,"text":"Bin Weixin is a high-ranking member of the Qingyun Society, and one of Liu Haojun's top lieutenants. He acts as the Society's advisor. A Waijia master known as the \"Hundred-Handed Weaver\" for his skill, speed and precision with throwing knives and tools of assassination."},{"spoiler":false,"text":"One of the five responsible for Kong Ruili's rape and murder."}],"source":"vndb","sourceCharacterId":"c7187"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73b145fa7a1b172d7a527e84c11d83f4e998a814200fa488056c14c210e3f7ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/109be44b3c1fb02a294d57d9e33a1bcfad084aac08daa6d97f611f9dd7d03062.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤原 啓治","creatorId":"vndb:s384","sourcePersonId":"vndb:s384","canonicalEntityId":"vndb:s384","name":"藤原 啓治","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:1891","source":"vndb"}]},{"characterId":"char_vndb_c7188","characterName":"謝 逸達","sourceIds":{"vndbCharacterId":"c7188"},"originalCharacterName":"謝 逸達","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Consider this. Suppose that the mind is like a bottle of water.\""},{"spoiler":false,"text":"Xie Yida, also known as the \"Profane Scalpel,\" is a notorious and brilliant scientist known for his advances in the research of soul transfer - digitalization and storage of a person's memories and personality. Due to the dangers of his research, he was blacklisted and cast out of the scientific society. He runs a black market clinic, providing augmentations for criminals to fund his research."},{"spoiler":false,"text":"He is the one who performed the soul transfer on Kong Ruili. Awaiting Kong Taoluo's return to Shanghai, he had prepared a specialized gynoid to store Ruili's soul data. The final step in his reseach being to store the entirety of the soul data within one body."}],"source":"vndb","sourceCharacterId":"c7188"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/0058f63faf7017ba511347a19fdb47573a26e1df9fd60a31e51be1a7a5b23c2c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/927687dde72f8c717c0d9231d65815fda939320435eec10ed1316c543d4a448b.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"家弓 家正","creatorId":"vndb:s1357","sourcePersonId":"vndb:s1357","canonicalEntityId":"vndb:s1357","name":"家弓 家正","roleCode":"voice-actor","roleLabel"