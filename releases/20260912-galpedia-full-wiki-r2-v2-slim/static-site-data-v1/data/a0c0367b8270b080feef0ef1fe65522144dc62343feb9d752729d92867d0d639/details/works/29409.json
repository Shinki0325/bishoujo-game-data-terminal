{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"29409","model":{"presentationWorkId":"egs:29409","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_104147","characterName":"Derek Stiles","sourceIds":{"bangumi":[{"characterId":"104147","match":"source-roster","subjectId":"49121"}]},"originalCharacterName":"Derek Stiles","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"超执刀与超执刀2的主人公。"},{"spoiler":false,"text":"因为年少丧父而立志当医生。实习期间吊儿郎当，常被上司与护士同事指责。后来一次突发意外唤醒了他的“超执刀”神技。成为新一代的神医。"}],"source":"bangumi","sourceCharacterId":"104147"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1ba5b37f4d2254f7030b2f17a843e550fd88841b27143cfa74558967a1f894a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f529e3b6e5954ed3919de370a24bc6191744a3c12953cd01aead3e88840b69d0.webp","width":85,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近藤孝行","creatorId":"vndb:s2121","sourcePersonId":"vndb:s2121","canonicalEntityId":"vndb:s2121","name":"近藤 孝行","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:49121:104147:3980:1","source":"bangumi"}]},{"characterId":"char_bangumi_104149","characterName":"君岛美罗","sourceIds":{"bangumi":[{"characterId":"104149","match":"source-roster","subjectId":"49121"},{"characterId":"104149","match":"source-roster","subjectId":"6926"}]},"originalCharacterName":"君岛美罗","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"虽是天才外科医生，却因神秘病无法握手术刀。与月森一样拥有“超执刀”能力，但过去是个谜的女医生。她的英文版名字“Nozomi Weaver”有着“编织希望”的意思。"},{"spoiler":false,"text":"在《HOSPITAL》中因罹患绝症而改任联邦调查局手下的验尸官。"}],"source":"bangumi","sourceCharacterId":"104149"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2dfc721c24398e1600b39c61127ac706b50f154b3508292caef07665f61adac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd6b88a7742c7c805ce36664505fb07620120d1d47e20c5cb2098cfe945fdf38.webp","width":80,"height":256,"source":"static-detail"},"actors":[{"creditedName":"渡辺明乃","creatorId":"vndb:s499","sourcePersonId":"vndb:s499","canonicalEntityId":"vndb:s499","name":"渡辺明乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:49121:104149:4032:1","source":"bangumi"}]},{"characterId":"char_bangumi_104154","characterName":"利根川安祺","sourceIds":{"bangumi":[{"characterId":"104154","match":"source-roster","subjectId":"49121"}]},"originalCharacterName":"利根川安祺","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"月森的女助手，拥有四分之一德国血统的混血儿。对医疗拥有丰富的知识，并拥有国际护理执照的精英份子。游戏开始时对月森没有信心，随着故事的发展，慢慢与月森建立信赖。"}],"source":"bangumi","sourceCharacterId":"104154"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82cfd91ff3d051f5f238f877491605d33738b467718e9b367dfe5cd0f613dcba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/297695c4721c66875d6981ac01deeacb889edd11f685d0ef98065318ccb80f71.webp","width":85,"height":256,"source":"static-detail"},"actors":[{"creditedName":"