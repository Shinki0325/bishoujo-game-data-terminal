{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"29870","model":{"presentationWorkId":"vndb:v28123","staff":{"artwork":[{"creditedName":"なお","creatorId":"vndb:s13613","sourcePersonId":"egs:creator:19516","canonicalEntityId":"vndb:s13613","name":"なお","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:223964","source":"egs"}],"scenario":[{"creditedName":"なお","creatorId":"vndb:s13613","sourcePersonId":"egs:creator:19516","canonicalEntityId":"vndb:s13613","name":"なお","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:223965","source":"egs"}],"music":[],"other":[{"creditedName":"なお","creatorId":"vndb:s13613","sourcePersonId":"vndb:s13613","canonicalEntityId":"vndb:s13613","name":"なお","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:165351","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c78127","characterName":"矢薙 千星","sourceIds":{"vndbCharacterId":"c78127"},"originalCharacterName":"矢薙 千星","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/4239a341105b10cfebfd756e743297b466c359535ae4829f2df9e9bdc03e7b88.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9cc384abe8952a4437b27c063800e7f889384d78e50e9a53a7ce445eeaaddc0f.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c78130","characterName":"一色 一人","sourceIds":{"vndbCharacterId":"c78130"},"originalCharacterName":"一色 一人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He was a distinguished employee at a major corporation, but due to a certain incident, he left his post."},{"spoiler":false,"text":"He felt like fleeing from society and decided to peacefully live off his savings for a while. He then found a reasonably priced apartment in the countryside town of Anoyama, and moved there from the city."},{"spoiler":false,"text":"He arrived in Anoyama with the intention keeping away from others until his positive outlook of life had recovered, but there he comes to know Tsubasa, Misao and Kaede."},{"spoiler":false,"text":"His life took a complete change from what he had pictured."},{"spoiler":false,"text":"He came to live a life of playing daily with the trio who were on their summer vacation."},{"spoiler":false,"text":"But meanwhile, he would also come to know something about himself that he had not realized until then."},{"spoiler":false,"text":"By the way, he is a virgin who hasn't had a girlfriend in his entire life. That's because he did nothing but study in order to enter into a good school and a good corporation. Or at least that's his excuse."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c78130"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c78131","characterName":"悠木 翼","sourceIds":{"vndbCharacterId":"c78131"},"originalCharacterName":"悠木 翼","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An upbeat and lively girl. With no parents, she came to Anoyama after being taken in by her grandfather."},{"spoiler":false,"text":"Misao saw her spending time alone and approached her, after which they came to play together."},{"spoiler":false,"text":"Her taking care of the neighborhood store on her own initiative shows that she has a responsible side to her as well."},{"spoiler":false,"text":"However, she gets made fun of and bullied at school for not having parents... Even then, Tsubasa won't let it show outwards."},{"spoiler":false,"text":"She adores Kazuto like a big brother and has gotten very attached to him."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c78131"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/926b73390251bba41ac511226e0cc66c1bddcf65650e5e51cafdb471239944ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eaedecbd16860b11496f49bc41057648e7a3b96f0e3cda27075affa82ac28e10.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c78132","characterName":"檜山 美紗緒","sourceIds":{"vndbCharacterId":"c78132"},"originalCharacterName":"檜山 美紗緒","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A high school girl who has yet to know love."},{"spoiler":false,"text":"He lives together with her mother in a fatherless home."},{"spoiler":false,"text":"She lives wild and free, and hates studying."},{"spoiler":false,"text":"Possibly because of perceived inferiority of living in the countryside, she has dyed her hair and likes to show off, but deep down she is kind and takes people's feeling into account before acting. However, she gets embarrassed when praised like she doesn't want to show that side of her."},{"spoiler":false,"text":"She often acts in a half-hearted manner as if things were out of her control."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c78132"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5efbb103f7fa91b837c856ff5192ff9ac7fd8326d86d6639a4136c25648494b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36efa1351764022734a301b3272132fb068872299113e760b31d755279fee9ce.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c78133","characterName":"馬場 楓","sourceIds":{"vndbCharacterId":"c78133"},"originalCharacterName":"馬場 楓","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Misao's childhood friend. He tends give an impression of a deliquent, but he is well-mannered and his dyed hair was only him following Misao's example. Studying is no problem to him either. He has a complex over his gender-neutral name \"Kaede.\""},{"spoiler":false,"text":"He hates how his father is fully compliant with his landowner uncle, and his next step in life is to enter a university in a city and move away from Anoyama."},{"spoiler":false,"text":"He thinks that Misao's inability to know how to love someone due to a certain reason is his own fault."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c78133"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cd73fa94927c37a0df3331cce1d07de41f51604f174b2c1f5c262463a1f3ee0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a0e6dc80bf3296e8c6d6537d97a3bc9a3e4530c038f048d0d7f905550b83c80d.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c78182","characterName":"八神 塔子","sourceIds":{"vndbCharacterId":"c78182"},"originalCharacterName":"八神 塔子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The owner of the cafe \"Stardust.\""},{"spoiler":false,"text":"The cafe was originally founded by her husband, but just when things were looking bright, he departed this world."},{"spoiler":false,"text":"She was at a loss whether to part with the store and start working not just for herself but also to raise her son, but decided not to abandon the store left behind by her husband and took up managing it herself."},{"spoiler":false,"text":"However, her husband's popular coffee blend was no longer available, thus leading to a gradual decrease in customers. The cafe is now a gathering spot for Anoyama's elderly and the sales slump continues, so the business is in a tough spot."},{"spoiler":false,"text":"She has her hands full with the store and is worried that she can't do anything for her son."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c78182"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9edf391095d1aa4d64374de73c15eb4746d8ecba9439204310497a99b243ad7c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4dd9371c309362fbc64639cc0f4609836c026ea2d30b757e67a785b00c502955.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c78853","characterName":"八神 幸宏","sourceIds":{"vndbCharacterId":"c78853"},"originalCharacterName":"八神 幸宏","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Touko's son. He is always going off to baseball practice, a sport that he loves."},{"spoiler":false,"text":"He is wary of men trying to get close to Touko, lashing out that he is the one to protect his mother."},{"spoiler":false,"text":"Whenever Tsubasa is mentioned, he runs away immediately with a blush on his face."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c78853"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f56bdc0a0566bc7ef5cd6cab40447dcc226edb6e682358957543ed3f872deec5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2aa6514d67da01f5362c66b722419106ab60793f8c63b09fe8c9f61f040f0b99.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c78855","characterName":"馬場 慶三","sourceIds":{"vndbCharacterId":"c78855"},"originalCharacterName":"馬場 慶三","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kaede's uncle and Anoyama's landowner. His wife passed away and he has been living alone for over a decade."},{"spoiler":false,"text":"For generations the Baba family tree has had pure-blooded Anoyama natives tying the knot, and Keizou too is insistent on having descendants with Anoyama blood in their veins."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c78855"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88d7617cda862e4d2966e9759ea1ee37afc792cef139207951a745b5ab91f6a0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/5304c4db461551690f885f684d41436d372fbf343013303a244a78ef73ba0b27.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c78857","characterName":"富田","sourceIds":{"vndbCharacterId":"c78857"},"originalCharacterName":"富田","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kazuto's boss at the corporation he quit. Cool and collected, he will dispose of those deemed of no use without mercy."},{"spoiler":false,"text":"His reputation in the eyes of the company manager is more important to him than anything else, and so he holds a grudge over Kazuto's resignation that caused a downturn in the assessment of his managerial skills."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c78857"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a78c906959005df5f90d9652050554b2c7bfeeb5fc051589d278d3399c0a7973.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab94ea071f76a635a47e89152c8fd7c30c8c1a229a38184417e3ba5215176532.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c78859","characterName":"悠木 大悟","sourceIds":{"vndbCharacterId":"c78859"},"originalCharacterName":"悠木 大悟","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tsubasa's grandfather. When she lost her parents and all of her relatives were hesitant to take custody, he gladly took her in."},{"spoiler":false,"text":"He frequents cafe Stardust and has grown interested in Touko."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c78859"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72abe256fd8f228e3e65b4c6ae4f027acd6824ee06d7c01cb925c8b98c4dd29f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/8869afb451684d9cb5958a8ac560997390507fb9c5983b1554a10b3b1d389cc8.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c78882","characterName":"尚樹","sourceIds":{"vndbCharacterId":"c78882"},"originalCharacterName":"尚樹","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be872f7fc10765c5f056f3960e9b18a35d8fb6dc15b75936d9e410be366c3fe9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3d449836d7e12fb7475db1d615e0e44b6d89dce51170fa8c04e1847fc207540.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c79910","characterName":"坂巻 守","sourceIds":{"vndbCharacterId":"c79910"},"originalCharacterName":"坂巻 守","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c89296","characterName":"今井 絢","sourceIds":{"vndbCharacterId":"c89296"},"originalCharacterName":"今井 絢","characterNameSource":null,"role":"side","status":"so