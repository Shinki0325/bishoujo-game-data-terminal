te":"source-only","source":"vndb","value":"72"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mage is the Secretary of the Student Council in Shikō Academy."},{"spoiler":false,"text":"He starts off as an arrogant and self-centered devil who lives impulsively—and still is pretty impulsive—and used to be quite a sadist."},{"spoiler":false,"text":"He can be quite reckless and thoughtless at times."}],"source":"vndb","sourceCharacterId":"c42159"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99989e5df8134f9e98559083cfa0684908418f56c776f50a35c61e34feb1382f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3fb0ef021003d839809411d2dcb6eb439c60223a1c0e1abc8028fdcfbde1a9d4.webp","width":212,"height":256,"source":"static-detail"},"actors":[{"creditedName":"木村 昴","creatorId":"vndb:s8109","sourcePersonId":"vndb:s8109","canonicalEntityId":"vndb:s8109","name":"木村 昴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76190","source":"vndb"}]},{"characterId":"char_vndb_c42160","characterName":"棗坂シキ","sourceIds":{"vndbCharacterId":"c42160"},"originalCharacterName":"棗坂シキ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"602"},"height":{"reviewState":"source-only","source":"vndb","value":"169"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Shiki is the Treasurer of Shikō Academy."},{"spoiler":false,"text":"He comes off as a strange, aloof person to most of the student body, and many claim that he's rarely seen at school."},{"spoiler":false,"text":"For the most part, Shiki acts and speaks mischievously, often with a smile and snide remark towards those around him. He's also extremely destructive."},{"spoiler":false,"text":"Despite his childish manner, Shiki's rather clever."},{"spoiler":false,"text":"He's insensitive of the feelings of others, and also appears to enjoy getting a rise out of people. When lashed out at, Shiki expresses great excitement, to the point where it nearly distracts him during more important moments. Consequently, his interaction with Urie and Mage are extremely antagonistic, as the two greatly dislike him as a fallen angel and frequently - and violently - lash out at him. He also has a hostile relationship with Roen, whom Shiki regularly torments."},{"spoiler":false,"text":"Although often troubling others, Shiki has a short, violent temper, leading him to leave others abruptly without any explanation."},{"spoiler":false,"text":"However, he is not above being serious when he must."}],"source":"vndb","sourceCharacterId":"c42160"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28ae8a12799698b0faff33c3fc229021615743cc882ed9cc9aa626c4621342e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/8637f434fec54e8bc5e27c9f458a92b1a88a6d88de6fae08d40e50eb8e8b9ebb.webp","width":212,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平川 大輔","creatorId":"vndb:s133","sourcePersonId":"vndb:s133","canonicalEntityId":"vndb:s133","name":"平川 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76185","source":"vndb"}]},{"characterId":"char_vndb_c42161","characterName":"ローエン","sourceIds":{"vndbCharacterId":"c42161"},"originalCharacterName":"ローエン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"408"},"height":{"reviewSt