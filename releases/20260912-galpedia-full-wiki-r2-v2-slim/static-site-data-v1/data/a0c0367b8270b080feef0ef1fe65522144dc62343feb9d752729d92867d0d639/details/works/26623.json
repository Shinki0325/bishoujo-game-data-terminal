ntityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"303"},"height":{"reviewState":"source-only","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"64"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Lindo is Ritsuka's brother and an exorcist."},{"spoiler":false,"text":"He is an independent person. He's caring towards the ones he loves and is very determined to protect Ritsuka from the devils. He is also stoic."},{"spoiler":false,"text":"He is also smart, resourceful, and determined. He is also shown to get furious and jealous whenever one of the devils does anything to Ritsuka."},{"spoiler":false,"text":"Lindo is not near as forgiving as Ritsuka, and will not trust someone once they betray him. He is also shown to be biased when is comes to dealing with the devils, refusing to believe that they are anything but liars, who only seek Ritsuka for the grimoire within her. He despises Rem most of all, and doesn't give him or the rest of the Student Council a chance to be anything other than what they are or appear to be."}],"source":"vndb","sourceCharacterId":"c42156"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/726b903761363c8521038817172b6908366f3ce31430891fbf783b2525b8e3f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba30744c1a80af365698b5cf7f971155986b6ce1ac5aebeb6a100c69a170220c.webp","width":212,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽多野 渉","creatorId":"vndb:s60","sourcePersonId":"vndb:s60","canonicalEntityId":"vndb:s60","name":"春野風","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:76183","source":"vndb"}]},{"characterId":"char_vndb_c42158","characterName":"楚神 ウリエ","s