Code":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:97769:51463:6480:1","source":"bangumi"}]},{"characterId":"char_c47058","characterName":"沢松 勇貴","sourceIds":{"bangumi":[{"characterId":"205612","match":"exact-normalized-name-in-linked-work","subjectId":"97769"}],"egsCharacterIds":["3509"],"vndbCharacterId":"c47058"},"originalCharacterName":"沢松 勇貴","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"身よりの無い青年だったが、先代総帥に拾われ、めきめきと頭角を顕し、能力を差し引いても優秀な側近へと成長していった。"},{"spoiler":false,"text":"先代の急死後は現総帥の姫紗羅の決めた人事により側近の一人となるも、変わった社内の状態に居心地の悪さを覚えている。"},{"spoiler":false,"text":"先代からは姫紗羅を支えるように言われていたが、遅れてきた反抗期もプラスされ、姫紗羅を徹底的に辱める事を前提に下克上を企てる。"},{"spoiler":false,"text":"能力に関しては先代に拾われる前は反則的な力であるとして、緊急時にしか使用しておらず、自力を磨いていたが、先代によってその生かし方を学び、利用される事もあったが、能力に対して肯定的になっていった。"},{"spoiler":false,"text":"姫紗羅については能力が効かない事から、自分とはまた違った能力者ではないか？と推論している。"},{"spoiler":false,"text":"性欲処理の過程で性的調教を施している、右腕で愛眼人形でもある「璃々香」の処女を、未だに取っておいているなど、歪なところがあり、情にも流される等々極悪人にはなりきれない。"},{"spoiler":false,"text":"生来の努力家で、先代の元で能力の有効利用法以外にも更に様々な事を学び、文武両道。"},{"spoiler":false,"text":"璃々香にはほとんどの面で勝っており、主人であり師匠のような存在となっている。"},{"spoiler":false,"text":"これまでの働きにより、人並み以上の財産を持っている。"}],"source":"egs","sourceCharacterId":"3509","sourceWorkId":"20274","spoiler":false},{"segments":[{"spoiler":false,"text":"身よりの無い青年だったが、先代総帥に拾われ、めきめきと頭角を顕し、"},{"spoiler":false,"text":"能力を差し引いても優秀な側近へと成長していった。"},{"spoiler":false,"text":"先代の急死後は現総帥の姫紗羅の決めた人事により側近の一人となるも、"},{"spoiler":false,"text":"変わった社内の状態に居心地の悪さを覚えている。"},{"spoiler":false,"text":"先代からは姫紗羅を支えるように言われていたが、遅れてきた反抗期もプラスされ、"},{"spoiler":false,"text":"姫紗羅を徹底的に辱める事を前提に下克上を企てる。"},{"spoiler":false,"text":"能力に関しては先代に拾われる前は反則的な力であるとして、"},{"spoiler":false,"text":"緊急時にしか使用しておらず、自力を磨いていたが、"},{"spoiler":false,"text":"先代によってその生かし方を学び、利用される事もあったが、能力に対して肯定的になっていった。"},{"spoiler":false,"text":"姫紗羅については能力が効かない事から、自分とはまた違った能力者ではないか？と推論している。"},{"spoiler":false,"text":"性欲処理の過程で性的調教を施している、右腕で愛玩人形でもある「璃々香」の処女を、"},{"spoiler":false,"text":"未だに取っておいているなど、歪なところがあり、情にも流される等々極悪人にはなりきれない。"},{"spoiler":false,"text":"生来の努力家で、先代の元で能力の有効利用法以外にも更に様々な事を学び、文武両道。"},{"spoiler":false,"text":"璃々香にはほとんどの面で勝っており、主人であり師匠のような存在となっている。"},{"spoiler":false,"text":"これまでの働きにより、人並み以上の財産を持っている。"},{"spoiler":false,"text":"【見つめた対象に勘違いや錯覚を起こさせる能力】"},{"spoiler":false,"text":"カメラなどの映像を介しても使用可能で、複数人同時に効果を発揮する事も出来る。"},{"spoiler":false,"text":"どんな錯覚を起こさせるかも主人公が自由に指定でき、"},{"spoiler":false,"text":"何かをスイッチとして時間差で発動させる事も解除も自在。"},{"spoiler":false,"text":"「おはようございます、総帥。先日の件は報告書にまとめておきましたので、後程確認をお願いしますね」"}],"source":"bangumi","sourceCharacterId":"205612"}],"profileFacts":[{"label":"身高（本版本）","value":"176 cm","valueContext":null,"source":"egs","sourceCharacterId":"3509","sourceWorkId":"20274","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1888","sourceCompanyId":"egs:brand:2388","canonicalEntityId":"vndb:p1888","name":"WitchFlame","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:20274:2388","source":"egs"},{"companyId":"vndb:p176","sourceCompanyId":"vndb:p176","canonicalEntityId":"vndb:p176","name":"N43 Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:163694:v14762","source":"vndb"},{"companyId":"vndb:p1888","sourceCompanyId":"vndb:p1888","canonicalEntityId":"vndb:p1888","name":"WitchFlame","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:163695:v14762","source":"vndb"},{"companyId":"vndb:p1888","sourceCompanyId":"vndb:p1888","canonicalEntityId":"vndb:p1888","name":"WitchFlame","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:37555:v14762","so