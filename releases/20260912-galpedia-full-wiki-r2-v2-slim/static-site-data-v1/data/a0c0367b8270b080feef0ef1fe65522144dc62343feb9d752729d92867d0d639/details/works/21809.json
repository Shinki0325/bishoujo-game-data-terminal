taff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:119040","source":"vndb"},{"creditedName":"八尋 まみ","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:119041","source":"vndb"},{"creditedName":"今谷 皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:119043","source":"vndb"},{"creditedName":"ふくみみ","creatorId":"vndb:s7331","sourcePersonId":"vndb:s7331","canonicalEntityId":"vndb:s7331","name":"ふくみみ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:119045","source":"vndb"},{"creditedName":"ふくみみ","creatorId":"vndb:s7331","sourcePersonId":"vndb:s7331","canonicalEntityId":"vndb:s7331","name":"ふくみみ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:119046","source":"vndb"},{"creditedName":"Miyashi","creatorId":"vndb:s7415","sourcePersonId":"vndb:s7415","canonicalEntityId":"vndb:s7415","name":"Miyashi","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:119049","source":"vndb"},{"creditedName":"株式会社キューン・プラント","creatorId":"vndb:s7417","sourcePersonId":"vndb:s7417","canonicalEntityId":"vndb:s7417","name":"株式会社キューン・プラント(quunplant)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:119050","source":"vndb"},{"creditedName":"鹿野 まなか","creatorId":"vndb:s8057","sourcePersonId":"vndb:s8057","canonicalEntityId":"vndb:s8057","name":"熊乃 可菜","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:119051","source":"vndb"},{"creditedName":"対馬 なな実","creatorId":"vndb:s8324","sourcePersonId":"vndb:s8324","canonicalEntityId":"vndb:s8324","name":"対馬なな実","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:119052","source":"vndb"}]},"cast":[{"characterId":"char_c43112","characterName":"天衣 みるく","sourceIds":{"bangumi":[{"characterId":"44903","match":"exact-normalized-name-in-linked-work","subjectId":"167870"}],"egsCharacterIds":["8592"],"vndbCharacterId":"c43112"},"originalCharacterName":"天衣 みるく","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A friendly, bright but somewhat spoiled girl. Her family owns a farm over on Motojima, and they make most of their money from their exceptionally delicious milk."},{"spoiler":false,"text":"Thus, she's very good at milking. Using her skilled fingers, she can squeeze white stuff out very well. Has a bit of a complex about the way her name is spelled. (The kanji for her name is \"美乳\", meaning \"beautiful milk.\")"},{"spoiler":false,"text":"She's somewhat simple-minded and easy to get worked up. Rin likes to bully her because of this."},{"spoiler":false,"text":"translated from Getchu"}],"source":"vndb","sourceCharacterId":"c43112"},{"segments":[{"spoiler":false,"text":"人懐っこくあまえんぼうさんで明るい女の子。"},{"spoiler":false,"text":"実家は本島で農場を営んでいて、島のシェア90％のおいしい牛乳が自慢。"},{"spoiler":false,"text":"特技は牛の乳搾り。"},{"spoiler":false,"text":"天才的な指使いで突起物を刺激し白い液体を絞り出す。"},{"spoiler":false,"text":"“美乳”と書いて“みるく”というキラキラネームがコンプレックス。"},{"spoiler":false,"text":"ちょっとおだてられると簡単に乗せられてしまうチョロイン。"},{"spoiler":false,"text":"凛によくイジられて転がされている。"}],"source":"egs","sourceCharacterId":"8592","sourceWorkId":"21809","spoiler":false},{"segments":[{"spoiler":false,"text":"人懐っこいあまえんぼうさんで明るい女の子。"},{"spoiler":false,"text":"実家は本島で農場を営んでいて、島のシェア 90％のおいしい牛乳が自慢。"},{"spoiler":false,"text":"特技は牛の乳搾り。 天才的な指使いで突起物を刺激し、白い液体を絞り出す。"},{"spoiler":false,"text":"“美乳” と書いて “みるく” というキラキラネームがコンプレックス。"},{"spoiler":false,"text":"ちょっとおだてられると簡単に乗せられてしまうチョロイン。 凛によくイジられて転がされている。"},{"spoiler":false,"text":"「ねぇねぇねぇ、これみるんちのミルクだよ！ 飲んでみる？」"}],"source":"bangumi","sourceCharacterId":"44903"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/962f52bd958f5229f1abedeb2e4b50fb9cb21d5c62d8a44ee069246598915852.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da7bef0887bfa8f40671f346cad05bdf4083f57fc1736de6c775d29f9918d547.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"今谷皆美","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:167870:44903:15684:1","source":"bangumi"}]},{"characterId":"char_c43113","characterName":"有栖川 瑠璃千代","sourceIds":{"bangumi":[{"characterId":"44902","match":"exact-normalized-name-in-linked-work","subjectId":"167870"}],"egsCharacterIds":["8591"],"vndbCharacterId":"c43113"},"originalCharacterName":"有栖川 瑠璃千代","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's niece, who calls him \"Ojisama.\" An elegant and sheltered young lady who's the great-granddaughter of the school's founder. Very calm and serene, with a polite way of speaking."},{"spoiler":false,"text":"As it's customary for members of the Arisugawa family to live out on Makishima once they reach a certain age, she lives with the rest of the girls in the dormitory. She dotes on all her friends, and is sort of a motherly figure to them."},{"spoiler":false,"text":"Her favorite food is instant ramen."},{"spoiler":false,"text":"translated from Getchu"}],"source":"vndb","sourceCharacterId":"c43113"},{"segments":[{"spoiler":false,"text":"主人公を「おじさま」と慕う姪っ子。"},{"spoiler":false,"text":"学園創設者のひ孫で、世俗に疎い箱入りお嬢様。"},{"spoiler":false,"text":"とてもおしとやかな性格でマイペース。"},{"spoiler":false,"text":"やんわり丁寧なしゃべり方で場を和ませてくれる。"},{"spoiler":false,"text":"ある年齢を迎えると先祖出身の巻島で独り立ちさせる有栖川家の習わしにより、別荘を女子寮にして共同生活をしている。"},{"spoiler":false,"text":"みんなのママのような存在で、甘やかしたがり。"},{"spoiler":false,"text":"カップラーメンに憧れがある。"}],"source":"egs","sourceCharacterId":"8591","sourceWorkId":"21809","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公を 「おじさま」 と慕う姪っ子。"},{"spoiler":false,"text":"学園創設者のひ孫で、世俗に疎い箱入りお嬢様。"},{"spoiler":false,"text":"とてもおしとやかな性格でマイペース。 やんわり丁寧なしゃべり方で場を和ませてくれる。"},{"spoiler":false,"text":"ある年齢を迎えると先祖出身の巻島で独り立ちさせる有栖川家の習わしにより、別荘を女子寮にして共同生活をしている。"},{"spoiler":false,"text":"みんなのママのような存在で、甘やかしたがり。"},{"spoiler":false,"text":"カップラーメンに憧れがある。"},{"spoiler":false,"text":"「あらあら、おねむですか？　瑠璃千代のおひざ、あいてますわよ」"}],"source":"bangumi","sourceCharacterId":"44902"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e69ae65b4931ae5c4c880d8800085f81bd9680770a32401c3d2f2d83a12c366c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4d9a06f8e4f837e9a6fdab9f435a50720359a4f358aac7f56054a928b51479b0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"熊乃可菜","creatorId":"vndb:s8057","sourcePersonId":"vndb:s8057","canonicalEntityId":"vndb:s8057","name":"熊乃 可菜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:167870:44902:20851:1","source":"bangumi"}]},{"characterId":"char_c43114","characterName":"乃木坂 凛","sourceIds":{"bangumi":[{"characterId":"44901","match":"exact-normalized-name-in-linked-work","subjectId":"167870"}],"egsCharacterIds":["8590"],"vndbCharacterId":"c43114"},"originalCharacterName":"乃木坂 凛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A calm girl who goes at her own pace, but is also mischievous and likes to play pranks. Calls the protagonist \"Niini.\" She likes to flip Miruku's skirt every morning to check the pattern on her underwear."},{"spoiler":false,"text":"An unparalleled lover of snacks. She has them hidden all over the place, and seems able to just grab some whenever she pleases. Her favorite candies are whiskey bonbons, but because they get her drunk and she ends up annoying people, she's not allowed to have them. (She still sneaks some from time to time however.)"},{"spoiler":false,"text":"translated from Getchu"}],"source":"vndb","sourceCharacterId":"c43114"},{"segments":[{"spoiler":false,"text":"主人公を「にぃに」と慕う、おとなしくマイペースだけどいたずら好きなお茶目な女の子。"},{"spoiler":false,"text":"「みるく」のスカートめくりをしてプリント柄を確認するのが日課になっている。"},{"spoiler":false,"text":"無類の駄菓子好き。"},{"spoiler":false,"text":"島のあらゆる所に駄菓子を隠していて、好きなときに取り出す。"},{"spoiler":false,"text":"大好物はウイスキーボンボン。"},{"spoiler":false,"text":"酔っ払って騒動を起こした為、禁止令が出されている。"},{"spoiler":false,"text":"（でもこっそり貯蔵している）"}],"source":"egs","sourceCharacterId":"8590","sourceWorkId":"21809","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公を 「にぃに」 と慕う、おとなしくてマイペースだけど いたずら好きなお茶目な女の子。"},{"spoiler":false,"text":"みるくのスカートめくりをして プリント柄を確認するのが日課になっている。"},{"spoiler":false,"text":"無類の駄菓子好き。 島のあらゆる所に駄菓子を隠していて、好きな時に取り出す。"},{"spoiler":false,"text":"大好物はウイスキーボンボン。 酔っ払って騒動を起こしたため、禁止令が出されている。"},{"spoiler":false,"text":"（でもこっそり貯蔵している）"},{"spoiler":false,"text":"「にぃに、またえっちな目してる……　ウィスキーボンボンくれるなら考えなくも、ない」"}],"source":"bangumi","sourceCharacterId":"44901"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a166204ce081f479a1849e4b2b7e3fab84186c112890314fd1ed1f956bb5512a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec2316246833c4c30511e41cf77b7130c1ab38dbe0a2d60866d3254bc10b2503.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"間宮菜南子","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:167870:44901:15995:1","source":"bangumi"}]},{"characterId":"char_vndb_c102608","characterName":"芝姫 はじめ","sourceIds":{"vndbCharacterId":"c102608"},"originalCharacterName":"芝姫 はじめ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c132552","characterName":"校長先生","sourceIds":{"vndbCharacterId":"c132552"},"originalCharacterName":"校長先生","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[{"creditedName":"八尋 まみ","creatorId":"vndb:s999","sourcePersonId":"vndb:s999","canonicalEntityId":"vndb:s999","name":"間宮 菜南子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:63701","source":"vndb"}]},{"characterId":"char_vndb_c132596","characterName":"有栖川 菊千代","sourceIds":{"vndbCharacterId":"c132596"},"originalCharacterName":"有栖川 菊千代","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Head of the Arisugawa family. Grandmother of Shibahime Hajime and great-grandmother of Arisugawa Rurichiyo."}],"source":"vndb","sourceCharacterId":"c132596"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d8a37a914f44126d02649bd475636938e4e5b3471f31f5096a27e6358f5420c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd4d67c20f71e7900e64e07fa1cb947e32b25cd8b3713c7de165d5834e037781.webp","width":114,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西乃 ころね","creatorId":"vndb:s934","sourcePersonId":"vndb:s934","canonicalEntityId":"vndb:s934","name":"西野 ゆみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:63699","source":"vndb"}]},{"characterId":"char_vndb_c43115","characterName":"ノノ＝フランシスカ＝フェアチャイルド","sourceIds":{"vndbCharacterId":"c43115"},"originalCharacterName":"ノノ＝フランシスカ＝フェアチャイルド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A diminutive genius student who skipped her grades to become a part-time teacher at Youjou Academy. The students call her \"Nonochan-sensei\" and are quite fond of her."},{"spoiler":false,"text":"Despite being a teacher and trying to act mature, she still enjoys childish things like \"Okosama\" (children's dinner menu) meals. If she notices one of her students sneaking sweets into class, she starts drooling...her true immaturity comes out."},{"spoiler":false,"text":"Has the protagonist help her when she's too short to reach things in high places."},{"spoiler":false,"text":"translated from Getchu"}],"source":"vndb","sourceCharacterId":"c43115"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99fe0647ba7f7b56efd3846d7b11d02b0714845b8e705994c23ddf6e1cfe9a01.we