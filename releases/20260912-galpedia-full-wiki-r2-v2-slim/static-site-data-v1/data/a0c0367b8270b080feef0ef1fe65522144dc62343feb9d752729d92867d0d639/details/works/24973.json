mage":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afc2ab54b65bc8b90543234b9e850176f4892ddbd23f5a47ba329cfdd5803f56.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b1fefcf8dde9e6ae2fad2d0d0c4414ab65eb0e51a51e830e866834859d90443.webp","width":165,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黒沢ともよ","creatorId":"vndb:s10496","sourcePersonId":"vndb:s10496","canonicalEntityId":"vndb:s10496","name":"黒沢 ともよ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190877:33603:9560:1","source":"bangumi"}]},{"characterId":"char_bangumi_56834","characterName":"アルーシェ・アナトミア","sourceIds":{"bangumi":[{"characterId":"56834","match":"source-roster","subjectId":"190877"}]},"originalCharacterName":"アルーシェ・アナトミア","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公で教皇庁の騎士。"},{"spoiler":false,"text":"巫女リリアーナを護衛中に、妖魔に襲われて死亡してしまう。"},{"spoiler":false,"text":"その後、人工の半妖となって蘇り、半妖となったことで妖魔を倒す力を得、リリアーナを救うために戦う。"},{"spoiler":false,"text":"真っ直ぐな性格で、考えるよりも行動で物事を示すタイプ。"},{"spoiler":false,"text":"リリアーナと、聖騎士ルーエンハイドとはいつも一緒に過ごしてきた幼馴染であり、ふたりとの再会に喜びを感じている。"}],"source":"bangumi","sourceCharacterId":"56834"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f61758f16019ed3b08f36ce0161613058c3c2130628bd08002358979e12f375.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/23664ee01db9d4627d94eb18faef497a5cfbd64f4b025589502c02d4444370b3.webp","width":197,"height":256,"source":"static-detail"},"actors":[{"creditedName":"千本木彩花","creatorId":"vndb:s12945","sourcePersonId":"vndb:s12945","canonicalEntityId":"vndb:s12945","name":"千本木 彩花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190877:56834:10838:1","source":"bangumi"}]},{"characterId":"char_bangumi_56835","characterName":"リリアーナ・セルフィン","sourceIds":{"bangumi":[{"characterId":"56835","match":"source-roster","subjectId":"190877"}]},"originalCharacterName":"リリアーナ・セルフィン","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"思慮深く、心優しき少女。"},{"spoiler":false,"text":"教皇庁に仕える巫女のひとりだったが、“月の女王”に捧げる「刻(とき)の花嫁」に選ばれる。"},{"spoiler":false,"text":"優しい性格で誰にでも分け隔てなく接するが、同時に芯の強さを持ち合わせている。"},{"spoiler":false,"text":"対象の時間を遅らせる能力を持っていて、過去にその力で邪妖に襲われていたアルーシェを助けたことがある。"}],"source":"bangumi","sourceCharacterId":"56835"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e7230220fbb12ffd92d3bca2029f7f6d1fd2e834e8a727f82949d70e34c7dd2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1cdd7b1d274ebf66879c79ae4afe4ecc2fab86d2a46111582b6e8682392be887.webp","width":197,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茅野愛衣","creatorId":"vndb:s630","sourcePersonId":"vndb:s630","canonicalEntityId":"vndb:s630","name":"茅野 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190877:56835:5847:1","source":"bangumi"}]},{"characterId":"char_bangumi_56836","characterName":"ルーエンハイド・アリアロド","sourceIds":{"bangumi":[{"characterId":"56836","match":"source-roster","subjectId":"190877"}]},"originalCharacterName":"ルーエンハイド・アリアロド","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アルーシェとリリアーナの幼馴染。"},{"spoiler":false,"text":"感情を力に変えて剣に集約させる「感情の刃」の使い手。"},{"spoiler":false,"text":"幼馴染であるアルーシェをよく理解し、好感を持っているが、教皇庁の対抗組織“ルルド教団”の聖騎士として、リリアーナを生け贄に捧げることを防ぐため、アルーシェの前に立ちはだかる。"},{"spoiler":false,"text":"熱い性格で自分の正義を振りかざすなど、やや高慢に見えることもあるが、根は素直。"}],"source":"bangumi","sourceCharacterId":"56836"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/0742686935725618fb3bc6ad1deb1b4364f330f8fae3564d5ac2ede78d3cea5c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f65a03ee1d882eab028e4da8e87d281936e504c159113b750e78a5171ccf649.webp","width":197,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小松未可子","creatorId":"vndb:s7545","sourcePersonId":"vndb:s7545","canonicalEntityId":"vndb:s7545","name":"小松 未可子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190877:56836:7498:1","source":"bangumi"}]},{"characterId":"char_bangumi_56837","characterName":"カミラ・有角（あるかど）","sourceIds":{"bangumi":[{"characterId":"56837","match":"source-roster","subjectId":"190877"}]},"originalCharacterName":"カミラ・有角（あるかど）","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人工半妖を研究している女博士。"},{"spoiler":false,"text":"冷たく観察するような目つきで物事に動じず、発言も淡白。"},{"spoiler":false,"text":"妖魔に心臓を貫かれたアルーシェを、半妖として蘇らせることに成功する。拠点となるホテルをアルーシェたちに提供し、サポートしてくれるがその真意は不明。"},{"spoiler":false,"text":"リリィとしてともに活動するときは、銃を使って邪妖と戦う。"}],"source":"bangumi","sourceCharacterId":"56837"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6dac51fab09417b555cd1c03e0dcea8346aaa24c24d004346644f32ed597de7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9d32709df3e3d36fa826f6f02ef7f97214c925c80034e6ef6c3b4aa8d8d44f6.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山村響","creatorId":"vndb:s1541","sourcePersonId":"vndb:s1541","canonicalEntityId":"vndb:s1541","name":"水崎来夢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190877:56837:12569:1","source":"bangumi"}]},{"characterId":"char_bangumi_56838","characterName":"ミュベール・フォーリン・ルー","sourceIds":{"bangumi":[{"characterId":"56838","match":"source-roster","subjectId":"190877"}]},"originalCharacterName":"ミュベール・フォーリン・ルー","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アルーシェにとって姉のように親しかった先輩騎士。"},{"spoiler":false,"text":"性格はクールな反面、熱い闘志を秘めている。"},{"spoiler":false,"text":"規律を重んじ、部下にも厳しく接するが、それでも部下から慕われる強さと優しさを持つ。"},{"spoiler":false,"text":"人工半妖化にはじめて成功した聖騎士として邪妖と戦っていたが、ある事件をきっかけに妖魔へと堕ちてしまう。"},{"spoiler":false,"text":"自分のようにならないかと、アルーシェを誘惑する。"}],"source":"bangumi","sourceCharacterId":"56838"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bbde1750dea1d2411faa1c8023e6736c2ad55b44dda42ad5359b20b6b07f7025.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/489f336f24a819b473d3284bfb27358c63108755afa4ee325ec4b38d9ae8ebd6.webp","width":197,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_56840","characterName":"ヴェルーシュカ","sourceIds":{"bangumi":[{"characterId":"56840","match":"source-roster","subjectId":"190877"}]},"originalCharacterName":"ヴェルーシュカ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アルーシェの所属する教皇庁と敵対するルルド教団に所属している半妖。幼いころ人工半妖の実験台にされ、廃棄寸前のところをルルド教団の長に救われる。"},{"spoiler":false,"text":"悲惨な過去の経験から感情に欠落がある。"},{"spoiler":false,"text":"さらには自らの意志も抑制され、自分を救ってくれたルルド教団だけを信じている。教団の命によりアルーシェを狙う。"}],"source":"bangumi","sourceCharacterId":"56840"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b59dbf114d330049ab03148ef6d0d99d9e991021a787b2312b30754b3c008712.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8de18694b8a7425e6e6fec10803fb21badc6fe4f49c1b44d42f34323a845d6d8.webp","width":197,"height":256,"source":"static-detail"},"actors":[{"creditedName":"富田美憂","creatorId":"vndb:s22553","sourcePersonId":"vndb:s22553","canonicalEntityId":"vndb:s22553","name":"富田 美憂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:190877:56840:20701:1","source":"bangumi"}]},{"characterId":"char_bangumi_56841","characterName":"エレノア","sourceIds":{"bangumi":[{"characterId":"56841","match":"source-roster","subjectId":"190877"}]},"originalCharacterName":"エレノア","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"チョコレート作りに情熱をささげるショコラティエ。その存在は妖魔の世界にも知れ渡る。究極の材料を求めて世界を旅し、商人として稼いだお金をチョコレート作りに注ぐ。"},{"spoiler":false,"text":"元気で明るいエレノアは、チョコレートのこととなると暴走する一面も。巨大ミキサーハンマーを振るい、リリィとしてアルーシェの戦いをサポートする。"}],"source":"bangumi","sourceCharacterId":"56841"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e78e87e91b899b51757718b1de99e0596eeb758fb57821c1fdc9c4fa