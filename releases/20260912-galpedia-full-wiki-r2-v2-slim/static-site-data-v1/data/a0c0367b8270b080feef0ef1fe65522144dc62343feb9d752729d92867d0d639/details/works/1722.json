s33803","name":"鷹匠早紀","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34751","source":"vndb"},{"creditedName":"北上孝也","creatorId":"vndb:s34106","sourcePersonId":"vndb:s34106","canonicalEntityId":"vndb:s34106","name":"北上孝也","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34752","source":"vndb"},{"creditedName":"水野 剛","creatorId":"vndb:s34107","sourcePersonId":"vndb:s34107","canonicalEntityId":"vndb:s34107","name":"水野 剛","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34753","source":"vndb"},{"creditedName":"おのあきひろ","creatorId":"vndb:s34108","sourcePersonId":"vndb:s34108","canonicalEntityId":"vndb:s34108","name":"おのあきひろ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34754","source":"vndb"},{"creditedName":"林田 隆之","creatorId":"vndb:s34109","sourcePersonId":"vndb:s34109","canonicalEntityId":"vndb:s34109","name":"林田 隆之","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34755","source":"vndb"},{"creditedName":"まばん","creatorId":"vndb:s36732","sourcePersonId":"vndb:s36732","canonicalEntityId":"vndb:s36732","name":"まばん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34756","source":"vndb"},{"creditedName":"うしだゆうじ","creatorId":"vndb:s36755","sourcePersonId":"vndb:s36755","canonicalEntityId":"vndb:s36755","name":"うしだゆうじ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34757","source":"vndb"},{"creditedName":"多聞","creatorId":"vndb:s36756","sourcePersonId":"vndb:s36756","canonicalEntityId":"vndb:s36756","name":"多聞","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34758","source":"vndb"},{"creditedName":"馨","creatorId":"vndb:s36757","sourcePersonId":"vndb:s36757","canonicalEntityId":"vndb:s36757","name":"馨。","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:34759","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c26150","characterName":"中條 和也","sourceIds":{"vndbCharacterId":"c26150"},"originalCharacterName":"中條 和也","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Zodiac sign: Capricorn"},{"spoiler":false,"text":"Kazuya is the \"leader\" among the three members of \"Birdie.\" He is a very bright and energetic person who is very friendly. Though only about average in academics, with his energy and quick reflexes, he is very good at a variety of sports, which he takes pride in. His power and vigor is also known to give him a slight aggressive streak, causing him to get pushy or bossy at times."},{"spoiler":false,"text":"However, behind his optimistic shell, Kazuya hides a deep loneliness within himself. Growing up without hardly seeing his parents who were two busy working since they needed two incomes to survive, Kazuya developed a strong desire for someone to be by his side and care about him. But because he fears finding someone and then losing their attentions, he always turns cowardly when it comes to love."},{"spoiler":false,"text":"Kazuya is the type whose feelings show on his face immediately. He's of good physique and is tanned from time outdoors. He has a bad habit about being late, especially about getting up in the morning, causing Matoba to have to give him a few wake-up calls every morning."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c26150"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37e20d674d3d025b3716b42e9fdcb07bc1f1512b315086c9559186d1c579bdf4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bdf155ce4bc3757680c57e854b8ed4e6ba346a6431d167fa1e35435148202f95.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"請一郎","creatorId":"vndb:s89","sourcePersonId":"vndb:s89","canonicalEntityId":"vndb:s89","name":"伊藤健太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18551","source":"vndb"}]},{"characterId":"char_vndb_c26151","characterName":"神沢 喬志","sourceIds":{"vndbCharacterId":"c26151"},"originalCharacterName":"神沢 喬志","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"23"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Zodiac sign: Cancer"},{"spoiler":false,"text":"Takashi is the oldest among the members of \"Birdie,\" even if he doesn't look like it. He is very eccentric and capricious with his actions, always acting on a whim. Sometimes he'll show up at work hours early, and other times be absurdly late. He's never predictable."},{"spoiler":false,"text":"He has a face that he can easily imitate expressions and still look natural and non-conspicuous, making it perfect for photography work, but when he isn't in front of a camera, usually he takes on an expression of being indifferent about everything. He dislikes being concerned with others, and dislikes for any concern to show even more. He often slants his head downward when talking with others to try to give off an attitude of disinterest."},{"spoiler":false,"text":"He suffers from insomnia, waking often during the night, and often he seems in a daze, his thoughts elsewhere. His words are often drawn out almost in a sing-song manner, occassionally feminine ways of speaking mixed into his words, and his tone portrays the boredom in his expressions. Takashi's trademark is the choker he always wears tight around his neck, but like his face and voice, this too seems to be hiding something buried within him."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c26151"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/38b44cc3892e70c8e3918b22d2a705c628d58754c906fece1b732955b3c2dba3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b2d551db2a27dd84107b2dccb2bd7f0f8d4490b575f9f56b179b42932c0a2b9.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"嶋野 裕","creatorId":"vndb:s379","sourcePersonId":"vndb:s379","canonicalEntityId":"vndb:s379","name":"野島 裕史","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18550","source":"vndb"}]},{"characterId":"char_vndb_c26152","characterName":"小野塚 葉","sourceIds":{"vndbCharacterId":"c26152"},"originalCharacterName":"小野塚 葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Zodiac sign: Aries"},{"spoiler":false,"text":"Though not the oldest physically, You is the most adult-like member in \"Birdie.\" When he's working with the group, he always has a smile for the camera, his face exuding a cool beauty that easily causes others to swoon. But without the camera and the make-up, You's face is rather expressionless, and he is very untalkative."},{"spoiler":false,"text":"Previously You did work in modeling under an excluse contract, but Masato convinced You to audition for \"Birdie,\" but had to use heavy persuasion over his agency to let him go, something You was grateful for, and he found himself with feelings for Masato ever since, something he keeps well-hidden within himself."},{"spoiler":false,"text":"You is smart and enjoys thinking logically, and often he employs simple, logistical thinking toward his co-workers. He is very introspective, and is constantly feeling intense ups and downs within himself, but since he does not want his private feelings to be made public to others, they fall behind his expressionless face and cool words. He also hides his feelings through acting: when he enters a role, he gives intense expressions that leave a lasting impression, and because of such, You has started to catch the eye of the drama industry."},{"spoiler":false,"text":"Short and slim, You gives a very delicate impression. Truly an introvert, when he is away from work he enjoys spending time on his personal computer surfing the internet, reading online newspaper articles, or researching information. He also enjoys reading books in his quiet time. When lost in thought, he has a habit of rubbing his fingers between his eyes."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c26152"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e9d04c25de3b5250b37dfabf1e06818760ef1f9c526f3a4fb9a3b6f32abde96.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f288e23bcc509d8bbcdb1c15bb8547d3f350fd7a555f459a70329d0b65dffc78.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"眞嶋 リョウ","creatorId":"vndb:s1699","sourcePersonId":"vndb:s1699","canonicalEntityId":"vndb:s1699","name":"眞嶋 リョウ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18553","source":"vndb"}]},{"characterId":"char_vndb_c26153","characterName":"椿 恭一","sourceIds":{"vndbCharacterId":"c26153"},"originalCharacterName":"椿 恭一","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"27"},"height":{"reviewState":"source-only","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kyouichi is a ballet dancer who is recruited as a choreographer for \"Birdie.\" Though he originally started his ballet dancing in Japan, he moved to America where he continued with his ballet and also branched out into work on Broadway in New York. After sealing a deal with Masato, Kyouichi returns to Japan and joins the staff of \"Birdie.\""},{"spoiler":false,"text":"Behind youthful good looks and personal charm, Kyouichi gives off the perfect public image. But behind the scenes, he's a brute man who takes a hobby in interfering with people and their affairs, getting amusement in watching them get hurt. He loves sex, but only in an epicurean manner; he enjoys the simple pleasure but has no interest in deeper feelings. He enjoys using sexual relations in his games to cause problems for others, never stopped by petty things such as guilt or regret. He takes what he wants when he wants, and the more others seem to suffer from it, the more amusement he receives."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c26153"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d76fc07e6327207572baa777825d27122a475b26b0f1963d69dcc5987865600.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/223d8fa8e9601aa0a600f17aa402fa80cbf3059a162c41812dd6f720f2a0bb00.webp","width":200,"height":200,"source":"static-detail"},"actors":[{"creditedName":"一条 和矢","creatorId":"vndb:s256","sourcePersonId":"vndb:s256","canonicalEntityId":"vndb:s256","name":"一条 和矢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18549","source":"vndb"}]},{"characterId":"char_vndb_c26154","characterName":"的場 久志","sourceIds":{"vndbCharacterId":"c26154"},"originalCharacterName":"的場 久志","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"42"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Matoba is the head manager of \"Birdie.\" He first entered the industry ten years ago as a graphic designer, but came to be in management when his friend took over as current president of the agency and changed his position. Though he leads the management for the entire group, on an individual basis he is responsible over Kazuya."},{"spoiler":false,"text":"When he isn't working, Matoba enjoys drinking, but he is not the top for noisy drinking; he likes a nice calming drink of alcohol. He will also smoke cigarettes on occassion, but doesn't inhale the smoke."},{"spoiler":false,"text":"He gives an overall feeling as an \"uncle\" over the boys, making slight jokes and acting friendly towards them. He takes special concern in Kazuya, since he is responsible for him, calling him up to force him out of bed so he won't be late or taking the time to show an interest in his problems."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c26154"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/2286dbb5697f57b39a40254bb6070e52d90ad0cae341f3d2cf7045e8dea68205.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40727a8fd99b34fba6cf843dd06441cc1f4791eb1b7a950e821b00c3be66096a.webp","width":200,"height":200,"source":"static-detail"},"actors":[{"creditedName":"上別府 仁資","creatorId":"vndb:s1196","sourcePersonId":"vndb:s1196","canonicalEntityId":"vndb:s1196","name":"上別府 仁資","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18552","source":"vndb"}]},{"characterId":"char_vndb_c26155","characterName":"柊 雅人","sourceIds":{"vndbCharacterId":"c26155"},"originalCharacterName":"柊 雅人","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"28"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Zodiac sign: Aries"},{"spoiler":false,"text":"Hiiragi is another manager of \"Birdie,\" though he does have to report under Matoba. He works as producer, coordinator, and negotiator of the group. On an individual basis, he is the charge of Takashi. He keeps contact with Takashi efficient to his job, though Takashi dislikes being bothered, keeping their relationship nothing more than strictly business-like."},{"spoiler":false,"text":"Hiiragi's main line of work was originally in New York. When the \"Birdie\" project first started, he returned to Japan to get the project underway, but then was asked to work further in the management of the group, and was transferred back formally, though he often still makes many business trips for the agency to New York. He knew Kyouichi from his past time in New York, where they became casual sex friends. Now with Kyouichi being transferred in to be staff for \"Birdie,\" Hiiragi has decided to leave those dealings in the past and there will be no more sexual play. But perhaps this is because Hiiragi is trying to look out for the better interests of You, who he'd felt fondness for ever since persuading him to the group..."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c26155"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f384087c6ddedf34681cf4288f9a3333becadba0d1dbfccb387bcf823be37620.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fcc1987740f729873c612540f833f0632c2ec806601638e9b3ac127c9aa878d7.webp","width":200,"height":200,"source":"static-detail"},"actors":[{"creditedName":"増谷 康紀","creatorId":"vndb:s2112","sourcePersonId":"vndb:s2112","canonicalEntityId":"vndb:s2112","name":"増谷 康紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18554","source":"vndb"}]},{"characterId":"char_vndb_c26156","characterName":"坂上 良太","sourceIds":{"vndbCharacterId":"c26156"},"originalCharacterName":"坂上 良太","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sakagami is also in the management of \"Birdie,\" but he is young and still new to management, and therefore is working as Matoba's assistant to gain experience. He is good with computers, and does a lot of the computer work and takes care of the peripheral equipment for the group."},{"spoiler":false,"text":"He is You's charge, and since they share an interest in websurfing, they have a small friendship unrelated to work, and Sakagami tries to be helpful for You."},{"spoiler":false,"text":"From Boys' Love Game Headquarters"}],"source":"vndb","sourceCharacterId":"c26156"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51271ed4694c475a98466d5defb63fed9d07ec47074d5b1547b22c29d38994a2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e7563dbc92966517fc22d7d0560efb423fe83f43a010fd8c1c4899f3267c015.webp","width":200,"height":200,"source":"static-detail"},"actors":[{"creditedName":"鈴木 千尋","creatorId":"vndb:s182","sourcePersonId":"vndb:s182","canonicalEntityId":"vndb:s182","name":"鈴木 千尋","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18548","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p748","sourceCompanyId":"egs:brand:564","canonicalEntityId":"vndb:p748","name":"アイン","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:1722:564","source":"egs"},{"companyId":"vndb:p748","sourceCompanyId":"vndb:p748","canonicalEntityId":"vndb:p748","name":"アイン","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:5653:v2414","source":"vndb"},{"companyId":"vndb:p1150","sourceCompanyId":"vndb:p1150","canonicalEntityId":"vndb:p1150","name":"Studio may-be","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:5654:v2414","source":"vndb"},{"companyId":"vndb:p748","sourceCompanyId":"vndb:p748","canonicalEntityId":"vndb:p748","name":"アイン","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:97415:v2414","source":"vndb"},{"companyId":"vndb:p1150","sourceCompanyId":"vndb: