tate":"no-conflict","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Demonic princess."}],"source":"vndb","sourceCharacterId":"c12035"},{"segments":[{"spoiler":false,"text":"魔王ザーバッハの娘。"},{"spoiler":false,"text":"ゴスロリドレスに身を包んだ姿は、まさに美しき悪魔。"},{"spoiler":false,"text":"勝ち気で執念深く、尊大でワガママな性格。"},{"spoiler":false,"text":"臣下を大事にする優しい一面も。"}],"source":"egs","sourceCharacterId":"25206","sourceWorkId":"7921","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のヒロイン。復讐と刑罰の魔王ザーバッハの十子の七。"},{"spoiler":false,"text":"三叉の魔鞭と猛々しい闇を自在に操る、高飛車なお嬢様。勝ち気で執念深く、尊大でワガママ。そのうえ、自己中心的だが、そこが曲者揃いの臣下には好かれている。受けた恨みはきっちり百倍にして返す主義で、臣下の仇を取るため魔神ギルバを追っている。マゾッ気を突かれるとかなり弱いのが悩みの種。"}],"source":"bangumi","sourceCharacterId":"72382"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/645f8af07fa1faff04f5e329de7cde0f6cdc1718c6c39f90b0e379f624a39015.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2ef08e15b9c6d1818a2d7d4b107c3be927ccb0223790434d179c7ff9a9c1a03.webp","width":210,"height":256,"source":"static-detail"},"actors":[{"creditedName":"黒河奈美","creatorId":"vndb:s1062","sourcePersonId":"vndb:s1062","canonicalEntityId":"vndb:s1062","name":"本山美奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269921:72382:4754:1","source":"bangumi"}]},{"characterId":"char_c41588","characterName":"木戸 茜","sourceIds":{"bangumi":[{"characterId":"72923","match":"exact-normalized-name-in-linked-work","subjectId":"269921"}],"egsCharacterIds":["25207"],"vndbCharacterId":"c41588"},"originalCharacterName":"木戸 茜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"退魔師の少女。"},{"spoiler":false,"text":"魔神ギルバを狙うが、間違えてシェリスを襲い、逆に下僕にされてしまう。"},{"spoiler":false,"text":"すぐ相手に拳銃を向ける悪い癖がある。"}],"source":"egs","sourceCharacterId":"25207","sourceWorkId":"7921","spoiler":false},{"segments":[{"spoiler":false,"text":"殺害された両親の復讐のために魔神ギルバを追う退魔師の少女。"},{"spoiler":false,"text":"直情径行でケンカっ早いが、基本的にお人好し。人界にやって来たシェリスの最初の犠牲者にして下僕となる。"},{"spoiler":false,"text":"魔術的な才能が皆無なのにもかかわらず、頑張って魔物と張り合う努力の人で、主武装は銃火器。"},{"spoiler":false,"text":"人外ばっかり相手にしている所為か、すぐ相手に拳銃を向ける悪い癖がなかなか直らない。"}],"source":"bangumi","sourceCharacterId":"72923"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c1e1112cdff2719210e4664f0bd1740d759c029813bc7fdd76760a16f5b5b75.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6a6ae821c6a839ab29e8c118ebbd0dfccaf1f19cb3166f956df58f81d0189f1.webp","width":168,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田ゆきえ","creatorId":"vndb:s790","sourcePersonId":"vndb:s790","canonicalEntityId":"vndb:s790","name":"前田 ゆきえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269921:72923:3952:1","source":"bangumi"}]},{"characterId":"char_c41589","characterName":"メデューナ","sourceIds":{"bangumi":[{"characterId":"109665","match":"exact-normalized-name-in-linked-work","subjectId":"269921"}],"egsCharacterIds":["25208"],"vndbCharacterId":"c41589"},"originalCharacterName":"メデューナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔神ギルバの部下の水使い。"},{"spoiler":false,"text":"愛嬌たっぷりの裏側に毒牙を隠す、敵にまわすとやっかいなタイプ。"},{"spoiler":false,"text":"実はレズビアン。"}],"source":"egs","sourceCharacterId":"25208","sourceWorkId":"7921","spoiler":false},{"segments":[{"spoiler":false,"text":"魔神ギルバに眷属として仕える卓越した水使いで、遠見の術の腕前などには目を見張るものがある。ノリのいい楽天家で、芸人気質。たっぷりの愛嬌に毒牙を隠すレズビアン。"},{"spoiler":false,"text":"戯けた態度に騙されがちだが、水術の特性上、敵に回すと非常に悪質。友好的な素振りで如何にもヒロイン側に寝返りそうで、実は最後まで敵側に残るタイプ。昔はもっと女王様風だったようで、時折その片鱗が見え隠れする。"}],"source":"bangumi","sourceCharacterId":"109665"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3aaa095c2d1fb04fa24c9422d8be9b6e8210ee45c1817c6dfaef522e082ebcc8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73ddbc4bed7bddb65e88d1792a6c0935928b5d9876194f2da1f0527dc1e1be6f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あらいしずか","creatorId":"vndb:s665","sourcePersonId":"vndb:s665","canonicalEntityId":"vndb:s665","name":"あらい しずか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:269921:109665:4647:1","source":"bangumi"}]},{"characterId":"char_c41590","characterName":"ミーティ","sourceIds":{"bangumi":[{"characterId":"72950","match":"exact-normalized-name-in-linked-work","subjectId":"269921"}],"egsCharacterIds":["25209"],"vndbCharacterId":"c41590"},"originalCharacterName":"ミーティ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔神ギルバの部下の糸使い。暗殺者。"},{"spoiler":false,"text":"性格はそうとうひねくれていて、サディスト。"},{"spoiler":false,"text":"ギルバ陣営の策士。"}],"source":"egs","sourceCharacterId":"25209","sourceWorkId":"7921","spoiler":false},{"segments":[{"spoiler":false,"text":"魔神ギルバに眷属として仕える熟練した糸使いの暗殺者で、倦怠感漂うひねくれ者＆サディスト。"},{"spoiler":false,"text":"蜘蛛にちなんだ能力を持ち、前述の暗殺や潜入工作を得意とする。"},{"spoiler":false,"text":"常に冷静沈着なギルバ陣営の策士（というか、物事を深く考えて処理するのが彼女だけ）。"},{"spoiler":false,"text":"ブツクサ文句を言いつつ、最後まで主君を裏切らないタイプ。"}],"source":"bangumi","sourceCharacterId":"72950"}],"profil