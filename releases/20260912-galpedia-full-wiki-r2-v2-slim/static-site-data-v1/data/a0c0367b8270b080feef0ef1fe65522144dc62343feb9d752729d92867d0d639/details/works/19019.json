s":["7487"],"vndbCharacterId":"c12586"},"originalCharacterName":"フラミンゴ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"更衣学院2年生。"},{"spoiler":false,"text":"学生会副会長兼、風紀委員長兼、月詠祭実行委員長兼、飼育部部長兼、剣道部部長を務める女傑。"},{"spoiler":false,"text":"伝統校の学生として折り目正しく生きることを信条にしており、物言いから態度まで、堅苦しくとっつきにくいところもあるが、世話焼きで、友情に厚い一面も。"},{"spoiler":false,"text":"調子にのってしばしば校則を逸脱する沙弥たちを、目の敵にしている。"},{"spoiler":false,"text":"「フラミンゴ」 と親愛を込めて呼ばれることがあるが、ひどく怒る。"}],"source":"egs","sourceCharacterId":"7487","sourceWorkId":"13423","spoiler":false},{"segments":[{"spoiler":false,"text":"更衣学院2年级学生。"},{"spoiler":false,"text":"学生会副会长兼风纪委员长兼月咏祭实行委员长兼饲养部部长兼剑道部部长，毫无争议的女中强人。"},{"spoiler":false,"text":"典型的传统派学生，以生活要中规中矩为信条。"},{"spoiler":false,"text":"无论措辞还是态度，都很死板严格，虽说有点难以相处，但很会照顾人，也很重友情。"},{"spoiler":false,"text":"经常胡搞瞎搞不守校规的沙弥他们，已俨然成了她的头号敌人了。"},{"spoiler":false,"text":"虽然被爱称为「火烈鸟（フラミンゴ）」，可一旦这么叫她，立马就发火"}],"source":"bangumi","sourceCharacterId":"12838"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/1366a10a613ca2650c247a17f83c260bb02d0b7854bfe426070d8025cab2d6a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82271d9ea7b37366734afc99b60357748824e32ddb97cc0ccaa0198dc337d713.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"すずきけいこ","creatorId":"vndb:s445","sourcePersonId":"vndb:s445","canonicalEntityId":"vndb:s445","name":"涼森ちさと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10137:12838:6275:1","source":"bangumi"}]},{"characterId":"char_c12587","characterName":"蓬田 奈々子","sourceIds":{"bangumi":[{"characterId":"12839","match":"exact-normalized-name-in-linked-work","subjectId":"10137"}],"egsCharacterIds":["7488"],"vndbCharacterId":"c12587"},"originalCharacterName":"蓬田 奈々子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"秋桜荘の近所に住む、おねーさん。"},{"spoiler":false,"text":"二見たち幼なじみとは、昔からの顔見知りで、しばしば相談に乗ってくれる。"},{"spoiler":false,"text":"大学を卒業後、実家の喫茶店 「イスタンブール」 を手伝っているらしく、ひとりで大変な時は、二見たちがバイトで手伝いに入ることもある。"},{"spoiler":false,"text":"名物の気まぐれランチは、本人の性格通り気まぐれ過ぎて、注文するには勇気がいりそう。"},{"spoiler":false,"text":"奈々子目当てに店を訪れる客も多いが、出されたコーヒーを飲むと、2度と現れなくなるという…。"}],"source":"egs","sourceCharacterId":"7488","sourceWorkId":"13423","spoiler":false},{"segments":[{"spoiler":false,"text":"住在秋桜荘附近的大姐姐。"},{"spoiler":false,"text":"和二見他们从小就相识，有什么事经常都会找她商量。"},{"spoiler":false,"text":"大学毕业后回到老家的喫茶店「イスタンブール」，有时一个人实在忙不过来，也会让二見他们来打工帮忙。"},{"spoiler":false,"text":"作为招牌菜的变幻莫测午餐，也和她本人的性格一样变幻莫测，想点这种菜着实需要相当的勇气。"},{"spoiler":false,"text":"以奈々子为目标而来的客人实在不在少数，然而却也有着一旦喝下她泡的咖啡就绝不会出现第二次的传闻……"}],"source":"bangumi","sourceCharacterId":"12839"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc630408a94f46f9909527d32de8292bafa7c693e67852aa491cce8d02309c8e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62fb3103b644234f5590f19d2956c9c74362e10a61ebd83d0c415977f0b22f0e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中美智","creatorId":"vndb:s796","sourcePersonId":"vndb:s796","canonicalEntityId":"vndb:s796","name":"田中美智(多田美智)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10137:12839:6313:1","source":"bangumi"}]},{"characterId":"char_c12588","characterName":"霧島 冬理","sourceIds":{"bangumi":[{"characterId":"12840","match":"exact-normalized-name-in-linked-work","subjectId":"10137"}],"egsCharacterIds":["7489"],"vndbCharacterId":"c12588"},"originalCharacterName":"霧島 冬理","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"長屋前で時々見かける、謎の少女。"},{"spoiler":false,"text":"取り澄ました顔で、下町の風情には似つかわしくない上品なたたずまいをしており、挨拶をしても、冷たくあしらわれてしまう。"},{"spoiler":false,"text":"更衣学院の1年生らしいが…"}],"source":"egs","sourceCharacterId":"7489","sourceWorkId":"13423","spoiler":false},{"segments":[{"spoiler":false,"text":"偶尔会在大杂院看到，浑身谜团的少女。"},{"spoiler":false,"text":"经常一脸正经，有着这种乡下地方难得一见的高贵气质。只是跟她打招呼总会被直接无视。"},{"spoiler":false,"text":"似乎是更衣学院的1年级学生，但其实……"}],"source":"bangumi","sourceCharacterId":"12840"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/746c7c7435a18ffdfd0edc6c18e438a41048a156c58c518928211a508dcf6574.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a9d5c83aa61dbe7024574042672a4c9ef4d9aa5a08d20a7d2db61a710b24416.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田愛衣","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10137:12840:6509:1","source":"bangumi"}]},{"characterId":"char_c12589","characterName":"岡部 早苗","sourceIds":{"bangumi":[{"characterId":"12841","match":"exact-normalized-name-in-linked-work","subjectId":"10137"}],"egsCharacterIds":["7490"],"vndbCharacterId":"c12589"},"originalCharacterName":"岡部 早苗","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"二見たちのクラスの担任。"},{"spoiler":false,"text":"沙弥が所属する声楽科の特別顧問も務めている。"},{"spoiler":false,"text":"若くして伝統校の更衣学院にて重用されている秀才で、音楽大学では奈々子とともに、将来を嘱望される存在だった。"},{"spoiler":false,"text":"厳格な教育方針を持っており、表面上は厳しい対応が目立つが、けっこう情に流されやすいところがあり、特に二見のことを気に掛けている節がある。"}],"source":"egs","sourceCharacterId":"7490","sourceWorkId":"13423","spoiler":false},{"segments":[{"spoiler":false,"text":"二見所在班级的班主任。"},{"spoiler":false,"text":"同时也是沙弥所属声乐科的特别顾问。"},{"spoiler":false,"text":"年纪轻轻就已是倍受更衣学院重用的才女，音乐大学时就和奈々子一样，对未来充满期待。"},{"spoiler":false,"text":"坚持贯彻严格的教育方针，经常一脸严肃，做事也是一板一眼，但其实很容易为情所动，尤其对二見很是关心。"}],"source":"bangumi","sourceCharacterId":"12841"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e365833b69dd2a4005228986d5af2f24340e9222ca9b90894921640845e5d26.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/6195581ac880c431d10cda9926c9f454fc591a9089626bb9f5215a75668502fc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田依子","creatorId":"vndb:s797","sourcePersonId":"vndb:s797","canonicalEntityId":"vndb:s797","name":"永田依子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10137:12841:5104:1","source":"bangumi"},{"creditedName":"大久保 藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29708","source":"vndb"}]},{"characterId":"char_c12593","characterName":"稲垣 梅子","sourceIds":{"bangumi":[{"characterId":"12842","match":"exact-normalized-name-in-linked-work","subjectId":"10137"}],"egsCharacterIds":["7491"],"vndbCharacterId":"c12593"},"originalCharacterName":"稲垣 梅子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"更衣学院2年生の特待生。"},{"spoiler":false,"text":"努力型の学生で、のびのびピアノを弾いている翼に、なにかにつけて突っかかってくる。"},{"spoiler":false,"text":"素直に話すということが出来ないので、敵を作ってしまうタイプ。"},{"spoiler":false,"text":"翼はそんな梅子にも怯まず話してくるので、いつしかいいライバル関係に。"},{"spoiler":false,"text":"華奢なのに胸が大きいことがコンプレックス。"}],"source":"egs","sourceCharacterId":"7491","sourceWorkId":"13423","spoiler":false},{"segments":[{"spoiler":false,"text":"更衣学院2年级的特别免费生。"},{"spoiler":false,"text":"由于本人是努力型的学生，对于向来悠哉悠哉弹钢琴的翼，她总看不顺眼。"},{"spoiler":false,"text":"总是不能坦率地将话说出来，也经常因此四面树敌。"},{"spoiler":false,"text":"对于这样的梅子，翼总能毫不介意地来搭话，不知不觉中也就建立起了竞争对手的关系。"},{"spoiler":false,"text":"明明生得小巧玲珑，胸部却相当有份量，她本人也对此而心情复杂。"}],"source":"bangumi","sourceCharacterId":"12842"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6daa53b8b70d608f770defa4e7510b6e243623517fbf460f3c6632c040f203c6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/6893be20b6b7f27ace4633f1752c1b8ec730341a742bb0cc1a7b356b6c93c9c0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10137:12842:6351:1","source":"bangumi"}]},{"characterId":"char_c12594","characterName":"藤堂 桂子","sourceIds":{"bangumi":[{"characterId":"12843","match":"exact-normalized-name-in-linked-work","subjectId":"10137"}],"egsCharacterIds":["7492"],"vndbCharacterId":"c12594"},"originalCharacterName":"藤堂 桂子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"更衣学院1年生。いちかと同じ、剣道部の特待生"},{"spoiler":false,"text":"類い稀な剣の才があり、技の巧みさなら部内でも随一。"},{"spoiler":false,"text":"が、病弱な身体がたたり、なかなか実力を出し切れない。"}],"source":"egs","sourceCharacterId":"7492","sourceWorkId":"13423","spoiler":false},{"segments":[{"spoiler":false,"text":"更衣学院1年级学生。和いちか一样，是剑道部的特别免费生。"},{"spoiler":false,"text":"少有的剑术奇才，剑技在部里也是首屈一指的。"},{"spoiler":false,"text":"虽说如此，但由于体弱多病，总是没能将实力好好展现出来。"}],"source":"bangumi","sourceCharacterId":"12843"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c150277e8802674ae9d65926af7ed100f782a53791c4bb987d9f1ab50db66ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8aa8463bf19662a72ca5e28ddfde7fefc573380385e1813f17e8345d8f9b4ee1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10137:12843:4727:1","source":"bangumi"}]},{"characterId":"char_c12595","characterName":"田辺 葉月","sourceIds":{"bangumi":[{"characterId":"213363","match":"exact-normalized-name-in-linked-work","subjectId":"10137"}],"egsCharacterIds":["7493"],"vndbCharacterId":"c12595"},"originalCharacterName":"田辺 葉月","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"同学年の少女。"},{"spoiler":false,"text":"恋するお年頃な少女。"},{"spoiler":false,"text":"家は例によって名家で、異性との付き合いなどまったくの未経験。"},{"spoiler":false,"text":"けどこっそり少女漫画なんかを愛読して、ロマンチックな恋に、人並み以上に憧れている。"}],"source":"egs","sourceCharacterId":"7493","sourceWorkId":"13423","spoiler":false},{"segments":[{"spoiler":false,"text":"同学年の少女。"},{"spoiler":false,"text":"恋するお年頃な少女。家は例によって、名家で、"},{"spoiler":false,"text":"異性との付き合いなどまったくの未経験。"},{"spoiler":false,"text":"けどこっそり少女漫画なんかを愛読して、ロマンチックな恋に、"},{"spoiler":false,"text":"人並み以上に憧れている。"}],"source":"bangumi","sourceCharacterId":"213363"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/754ce67c056cb252db56f04da71dbbb618d73e9dff2e9e3c2011909c29acc0aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/061721ec1257dc33c0f12aacf4d66d6aee67edb64d78b54870013b4142909e17.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"海 みちる","creatorId":"vndb:s3295","sourcePersonId":"vndb:s3295","canonicalEntityId":"vndb:s3295","name":"海 みちる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29725","source":"vndb"}]},{"characterId":"char_c12597","characterName":"久遠 三日","sourceIds":{"bangumi":[{"characterId":"36700","match":"exact-normalized-name-in-linked-work","subjectId":"10137"},{"characterId":"36700","match":"exact-normalized-name-in-linked-work","subjectId":"154080"}],"egsCharacterIds":["7494"],"vndbCharacterId":"c12597"},"originalCharacterName":"久遠 三日","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"更衣学院1年生。"},{"spoiler":false,"text":"声楽科の学生で、沙弥のことをとても慕っているようだ。"},{"spoiler":false,"text":"風変わりな制服の着こなしをしており、言動も他の学生に比べると、どこか特殊な不思議な子。"}],"source":"egs","sourceCharacterId":"7494","sourceWorkId":"13423","spoiler":false},{"segments":[{"spoiler":false,"text":"更衣学院1年生。声楽科の生徒で、沙弥のことを、とても慕っているようだ。風変わりな制服の着こなしをしており、言動も他の生徒に比べると、どこか特殊な不思議な子。"}],"source":"bangumi","sourceCharacterId":"36700"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a006e88e76cd3de776f3d9f7f2b1e4951d683ff1e8407f053f6c5de9e0e4abef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c5a872dd19759aca745c67102926cba88498b830c480246f637d7320b72b662.webp","width":214,"height":240,"source":"static-detail"},"actors":[{"creditedName":"南川のりこ","creatorId":"vndb:s2308","sourcePersonId":"vndb:s2308","canonicalEntityId":"vndb:s2308","name":"南川 のりこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:154080:36700:20327:1","source":"bangumi"}]},{"characterId":"char_c6757","characterName":"遠藤 沙弥","sourceIds":{"bangumi":[{"characterId":"12833","match":"exact-normalized-name-in-linked-work","subjectId":"10137"}],"egsCharacterIds":["7482"],"vndbCharacterId":"c6757"},"originalCharacterName":"遠藤 沙弥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公にとって頼りになったり （ほとんどないけど） ならなかったり。"},{"spoiler":false,"text":"バカにしたり、されたり。　とにかく、馬が合う相棒。"},{"spoiler":false,"text":"気持ちがいい性格で裏表がまったくない。裏と表がわかってない（ちょっとおバカ）。"},{"spoiler":false,"text":"誰にでも同じように話して、同じように笑ってくれる。"},{"spoiler":false,"text":"そんなことが素で出来る彼女は、独特の魅力があって学院の人気者。"},{"spoiler":false,"text":"みんなに、幸せをプレゼントしたい！ という理由で、歌手を目指している。"},{"spoiler":false,"text":"ほとんど悩みのない彼女だが、「さやえんどう」 と呼ぶのはやめていただきたい！ と思っている。"}],"source":"egs","sourceCharacterId":"7482","sourceWorkId":"13423","spoiler":false},{"segments":[{"spoiler":false,"text":"对于二見而言，有时她会是个值得依赖的伙伴（虽然这种时候少之又少），经常靠不住。"},{"spoiler":false,"text":"偶尔会干些蠢事，也会被当作笨蛋。总之是个很容易谈得来的青梅竹马。"},{"spoiler":false,"text":"性格直爽，表里如一，拐弯抹角的行动向来不会有（或者该说她其实是笨蛋一个）。"},{"spoiler":false,"text":"不管对谁都会是同样的态度，同样的笑容。"},{"spoiler":false,"text":"也正因她这种独具魅力的直爽性格，让她在学校里很受欢迎。"},{"spoiler":false,"text":"以成为歌手为奋斗目标，理由很简单——我要把幸福送给大家！"},{"spoiler":false,"text":"基本上她是不会有烦恼的，唯独对被叫做「さやえんどう（荷兰豆）」很是排斥。"}],"source":"bangumi","sourceCharacterId":"12833"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c4958b75c59c4c006469b334246237de83067879abfaad5369f448e275eb402.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/019ce0b00ce542c0a52d2f2fb5c9e462e2329347de2894493c18a38b8093af1f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小嶋めい","creatorId":"vndb:s795","sourcePersonId":"vndb:s795","canonicalEntityId":"vndb:s795","name":"小嶋 めい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10137:12833:7506:1","source":"bangumi"}]},{"characterId":"char_c6759","characterName":"よう","sourceIds":{"bangumi":[{"characterId":"12834","match":"exact-normalized-name-in-linked-work","subjectId":"10137"}],"egsCharacterIds":["7483"],"vndbCharacterId":"c6759"},"originalCharacterName":"よう","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"166"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幼なじみのまとめ役的な存在。"},{"spoiler":false,"text":"清楚で頭も良くて、なによりかわいい！ と、学院でも大人気。"},{"spoiler":false,"text":"結婚したい女子学生ナンバーワン。"},{"spoiler":false,"text":"だが、それは表の顔でしかなかった…。"},{"spoiler":false,"text":"裏では、下町育ちの雑草根性を発揮して、容赦の無い頑張りを見せる、意外性の少女。"},{"spoiler":false,"text":"主人公への片想いは尋常ではなく、妄想しまくる日々。"},{"spoiler":false,"text":"自分では主人公にアタックしているつもりだが、元来のドジっこが出てしまい、全然想いが通じない。"},{"spoiler":false,"text":"もちろん、二見との仲を邪魔する者にも裏バージョン発動。"}],"source":"egs","sourceCharacterId":"7483","sourceWorkId":"13423","spoiler":false},{"segments":[{"spoiler":false,"text":"她是能将青梅竹马的大家团结起来的存在。"},{"spoiler":false,"text":"外秀内中，加之可爱非常，自然地，在学校里也是很受欢迎的人，公认的“最想娶回家当老婆”的NO.1人选。"},{"spoiler":false,"text":"只是，那些都是表面形象而已……"},{"spoiler":false,"text":"其实是个将庶民的杂草禀性发挥至极致之人，有着近乎蛮不讲理的顽固一面。"},{"spoiler":false,"text":"对二見的单恋已经到了不能自拔的地步，基本上每天都会进入妄想模式。"},{"spoiler":false,"text":"虽然深深喜欢着二見，但因本身的天然呆属性，总是没能好好表达出来。"},{"spoiler":false,"text":"当然，对于想来抢走二見的情敌，她就会里人格全开。"}],"source":"bangumi","sourceCharacterId":"12834"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15a480826bca6f24fe72714e4a3a65b834393733619f55fe1165f1dd8cb33295.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/324dbd928b2f8aa5188e885322705bb0500c2083fe3dc663684404328dda420d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉住梢","creatorId":"vndb:s777","sourcePersonId":"vndb:s777","canonicalEntityId":"vndb:s777","name":"吉住 梢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10137:12834:4087:1","source":"bangumi"}]},{"characterId":"char_c6760","characterName":"新田 いちか","sourceIds":{"bangumi":[{"characterId":"12835","match":"exact-normalized-name-in-linked-work","subjectId":"10137"}],"egsCharacterIds":["7484"],"vndbCharacterId":"c6760"},"originalCharacterName":"新田 いちか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"151"},"hip":{"reviewState":"source-only","source":"vndb","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"強気な妹。主人公にしか飼い慣らせない。"},{"spoiler":false,"text":"沙弥にはべたべただが、沙弥が優しくてなんでも許しちゃうので、主人公だけが言うことを聞かせられる。"},{"spoiler":false,"text":"でも、食べ物を出すと結構ききわけがいい。"},{"spoiler":false,"text":"ちっこいが剣道をこよなく愛してる。スポーツや勝負ごとは、大の負けず嫌い。"},{"spoiler":false,"text":"しっかり者でいたいという気持ちが強いが気持ちだけで、そそっかしく、抜けている。"},{"spoiler":false,"text":"小さくてお人形さんみたいという周囲の評判に関わらず体育会系少女で、身体をいっぱい鍛えて強くなりたいらしい。"}],"source":"egs","sourceCharacterId":"7484","sourceWorkId":"13423","spoiler":false},{"segments":[{"spoiler":false,"text":"强硬的妹妹，却唯独对二見很是体贴。"},{"spoiler":false,"text":"很爱粘着沙弥，加之沙弥本来就很温柔，经常都是任着她胡来,也只有二見说的话她才会听从。"},{"spoiler":false,"text":"然而，一旦拿出食物来，她还是会老老实实听话的。"},{"spoiler":false,"text":"对剑道非一般的狂热。体育也好，打赌也罢，很讨厌输。"},{"spoiler":false,"text":"虽然她本人是很想当一个能干的人，但似乎只是美好奢望而已，其实是冒失鬼一个，经常性地笨手笨脚。"},{"spoiler":false,"text":"有着小巧玲珑的体形，出乎意料的是体育系少女，似乎想通过努力锻炼身体来让自己变得坚强。"}],"source":"bangumi","sourceCharacterId":"12835"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a308d00dbe8c1a1e5dbf1ad27a1d4f52e732427da97b69b1401fe98c9895663.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49c7101bfa05abf55ebc376bc9297ac9407e0ced188fcd7f5e87db61e2219744.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結下みちる","creatorId":"vndb:s794","sourcePersonId":"vndb:s794","canonicalEntityId":"vndb:s794","name":"結下 みちる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10137:12835:4705:1","source":"bangumi"}]},{"characterId":"char_c6761","characterName":"藤丸 命","sourceIds":{"bangumi":[{"characterId":"12836","match":"exact-normalized-name-in-linked-work","subjectId":"10137"}],"egsCharacterIds":["7485"],"vndbCharacterId":"c6761"},"originalCharacterName":"藤丸 命","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"下町育ちとは思えない気品を漂わせる、大和撫子。"},{"spoiler":false,"text":"ちょっとした物腰や仕草に、おんぼろ長屋には似つかわしくない上品さがにじみでている。"},{"spoiler":false,"text":"どこか古風な口調で、幼なじみたちに対しても、しばしば物言いがきつくなる。"},{"spoiler":false,"text":"人を寄せ付けない凛とした空気をまとっているが、本当は寂しがり屋でひとりは苦手。"},{"spoiler":false,"text":"絵を描くのが大好きで、黙々とクラスメイトの様子をスケッチしていたりする。"},{"spoiler":false,"text":"人の喜ぶ顔が好きだけど、好きすぎて、凝視するあまり、ちょっと怖い顔になってしまう。　別に怒っていないのに……。"},{"spoiler":false,"text":"それで近寄りがたいと、誤解されたりする。"}],"source":"egs","sourceCharacterId":"7485","sourceWorkId":"13423","spoiler":false},{"segments":[{"spoiler":false,"text":"虽然是在小城镇里边长大的，却有着大和抚子般高贵文雅的氛围。"},{"spoiler":false,"text":"无论何时，言行举止间都透露出一种与那破烂大杂院大不相符的高贵。"},{"spoiler":false,"text":"虽说如此，措辞也是古朴老派，就算对着青梅竹马的伙伴们，偶尔也会说得有点尖刻。"},{"spoiler":false,"text":"浑身上下都散发出难以接近、威风凛凛的气氛，但其实很容易寂寞的人，很不习惯一个人独处。"},{"spoiler":false,"text":"最喜欢画画，经常都是静静看着同班同学的样子来画草稿。"},{"spoiler":false,"text":"也喜欢别人高兴的样子，但因为喜欢过头，总会变成认真凝视，结果反倒让人觉得她有点恐怖——虽说她完全没有发怒的意图。"},{"spoiler":false,"text":"基于此，也就被大伙严重误会成难以交往的人了。"}],"source":"bangumi","sourceCharacterId":"12836"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24a683803bebc165c8a3841d4998b6203fb6b149baafecf5abb7ff87383df01c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b13d8872aa222aac25cad86f0a48a0376d786dbf8b4fef19aabfe228d1632ffc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"咲乃藍里","creatorId":"vndb:s436","sourcePersonId":"vndb:s436","canonicalEntityId":"vndb:s436","name":"咲乃 藍里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10137:12836:5692:1","source":"bangumi"}]},{"characterId":"char_c6762","characterName":"流川 瞳","sourceIds":{"bangumi":[{"characterId":"12837","match":"exact-normalized-name-in-linked-work","subjectId":"10137"}],"egsCharacterIds":["7486"],"vndbCharacterId":"c6762"},"originalCharacterName":"流川 瞳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"二見と同じ長屋に住む少年。"},{"spoiler":false,"text":"すらりと背が高く、整った涼しい顔立ちをしているため、女の子からのウケが良い。"},{"spoiler":false,"text":"やたら女友達がいるが、特定の誰かと付き合ってはいない。二見たちが知らないところに本命がいるらしい。"},{"spoiler":false,"text":"綺麗な顔立ちのせいで、幼少の頃に男に迫られたトラウマがあるらしく、大の男嫌い。"},{"spoiler":false,"text":"だけど、幼なじみの二見だけは別らしい。「ひとみとふたみで、兄弟みたいな関係だよね！」 と、"},{"spoiler":false,"text":"周りから怪しい噂を立てられるくらい、二見にベタベタすることがある。"},{"spoiler":false,"text":"軽薄に見えるけど、二見への友情と服飾デザイナーを目指す熱意だけは本物。"},{"spoiler":false,"text":"バイトなどで得たお金は、服か二見と遊ぶかにつぎ込んでいるらしい。"}],"source":"egs","sourceCharacterId":"7486","sourceWorkId":"13423","spoiler":false},{"segments":[{"spoiler":false,"text":"和二見一样，是居住在大杂院里的少年。"},{"spoiler":false,"text":"身形修长，加之五官端正、目光清澈，很受女孩子们欢迎。"},{"spoiler":false,"text":"有女性朋友，却不见他跟特定的人交往。似乎有着连二見他们都不知晓的真命天女。"},{"spoiler":false,"text":"因他那漂亮脸蛋，让他在小时候就留下了被男性骚扰的精神创伤，结果很是讨厌男人。"},{"spoiler":false,"text":"然而，唯独青梅竹马的二見是个特例，本人还特别强调「我和二見可是兄弟一般的！」。"},{"spoiler":false,"text":"成天粘着二見，都已经到了让周围古怪谣言四起的亲密程度了。"},{"spoiler":false,"text":"看上去有点轻佻，但与二見他们的友情、以服饰设计师为奋斗目标的热情却都不是虚情假意。"},{"spoiler":false,"text":"通过打工等赚到的钱，似乎也都花在和二見他们游玩或服饰上了。"}],"source":"bangumi","sourceCharacterId":"12837"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/781ef06c22a9a51db150af8e1c7ed29a329f5e44201eb4a3bb405a93ede16505.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a0d6a4c52e1ac5114cf6a97a310eb59611577e2d225e2c0eb5f5fa7e3cc490e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"相馬ユウタ","creatorId":"vndb:s3296","sourcePersonId":"vndb:s3296","canonicalEntityId":"vndb:s3296","name":"相馬 ユウタ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:10137:12837:88713:1","source":"bangumi"}]},{"characterId":"char_vndb_c118651","characterName":"にちか","sourceIds":{"vndbCharacterId":"c118651"},"originalCharacterName":"にちか","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"height":{"reviewState":"source-only","source":"vndb","value":"151"},"hip":{"reviewState":"source-only","source":"vndb","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/1742f299a30c8c3eefdb4260eea3d6723e0b14cdb49af8efefcaeeb1dbfe2734.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a2d06420673ae41c82c054d2fe3b054b7c452187e90648834f092813fae40e3.webp","width":249,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐本 二厘","creatorId":"vndb:s794","sourcePersonId":"vndb:s794","canonicalEntityId":"vndb:s794","name":"結下 みちる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29719","source":"vndb"}]},{"characterId":"char_vndb_c6758","characterName":"新田 二見","sourceIds":{"vndbCharacterId":"c6758"},"originalCharacterName":"新田 二見","characterName