-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"1st year student at St. Gabriele Academy, and third princess of Bergstrasse, a small principality in central Europe."},{"spoiler":false,"text":"She is renowned for her angelic voice, which she makes good use of while singing hymns. However, it is unclear how much self-awareness she has about this."},{"spoiler":false,"text":"At any rate, she is a constantly languid soul, and lacks the motivation to do much of anything."},{"spoiler":false,"text":"Whenever she becomes too lazy to even walk, she incites the protagonist to carry her on his shoulders."},{"spoiler":false,"text":"Her exact motives for wanting to study abroad in Japan are unknown."},{"spoiler":false,"text":"\"There's no point in using my full name. Just call me Aa-chan.\""},{"spoiler":false,"text":"Hobbies: Sleeping"}],"source":"vndb","sourceCharacterId":"c45018"},{"segments":[{"spoiler":false,"text":"聖ガブリエレ学園、１年生。"},{"spoiler":false,"text":"中欧の小国、ベルクシュトラーセ公国の第三公女で、彼女の歌う賛美歌は、天使の美声と賞賛されている。"},{"spoiler":false,"text":"本人にどこまでその自覚があるかは不明。"},{"spoiler":false,"text":"なにせ、いつでも気だるげで、基本的にやる気を感じられない。"},{"spoiler":false,"text":"歩くのさえ面倒なときは、ぐでーんとだらけた格好のまま主人公の肩に担がれて運搬される。"},{"spoiler":false,"text":"そんな彼女がなにゆえ突然、日本へ留学してきたのかは謎である。"}],"source":"egs","sourceCharacterId":"8616","sourceWorkId":"23433","spoiler":false},{"segments":[{"spoiler":false,"text":"聖ガブリエレ学園 1年生。 中欧の小国・ベルクシュトラーセ公国の第三公女。"},{"spoiler":false,"text":"彼女の歌う賛美歌は天使の美声と賞賛されている。"},{"spoiler":false,"text":"が、本人にどこまでその自覚があるのかは不明。"},{"spoiler":false,"text":"なにせ いつでも気だるげで、基本的にやる気を感じられない。"},{"spoiler":false,"text":"歩くのも面倒な時は、ぐでーんとだらけた格好のまま主人公に担がれて運搬される。"},{"spoiler":false,"text":"そんな彼女が突然なにゆえ日本へ留学してきたのかは謎である。"},{"spoiler":false,"text":"「長い名前なんて無駄なんです、あーちゃんと呼んでくれていいですよ」"}],"source":"bangumi","sourceCharacterId":"42300"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"42300","value":"寝ること"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/1700edc7c1fd13f63dfe49ba1d061538e070aee6e0aae7ab96b8262987f24bc4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc649c67932dd4569fee088d02673b6c76a6ef258addbfbd4971c49b753e131e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あさみほとり","creatorId":"vndb:s902","sourcePersonId":"vndb:s902","canonicalEntityId":"vndb:s902","name":"あさみ ほとり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:172842:42300:11646:1","source":"bangumi"}]},{"characterId":"char_c45455","characterName":"斉須 莉玖","sourceIds":{"bangumi":[{"characterId":"42302","match":"exact-normalized-name-in-linked-work","subjectId":"172842"}],"egsCharacterIds":["8618"],"vndbCharacterId":"c45455"},"originalCharacterName":"斉須 莉玖","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"106"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"73"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Games & manga"},{"spoiler":true,"text":"Her original form is that of an angel named Rikiel"}],"source":"vndb","sourceCharacterId":"c45455"},{"segments":[{"spoiler":false,"text":"感情が薄く、どこか冷たい人形のような印象のある少女。"},{"spoiler":false,"text":"兄の主人公のことも呼び捨てにし、常に命令口調で話す。"},{"spoiler":false,"text":"その実、子供っぽく、超が付くわがままなのに、とびっきりの甘えん坊でもある。"},{"spoiler":false,"text":"そのため、ちゃんとかまってやらないと機嫌が悪くなってしまう。"},{"spoiler":false,"text":"兄の膝の上がお気に入りで、よくゲームやマンガを一緒に見るよう要求してくる。"},{"spoiler":false,"text":"でも下手くそなので、自分ではプレイしない。"}],"source":"egs","sourceCharacterId":"8618","sourceWorkId":"23433","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹。 感情が薄くどこか冷たい、人形のような印象のある少女。"},{"spoiler":false,"text":"普段から兄を呼び捨てにして、常に命令口調で話す。"},{"spoiler":false,"text":"その実 子供っぽく、超が付くワガママなのにとびっきりの甘えん坊でもある。"},{"spoiler":false,"text":"そのため、ちゃんと構ってやらないと機嫌が悪くなってしまう。"},{"spoiler":false,"text":"兄の膝の上がお気に入りで、よくゲームやマンガを一緒に見るよう要求してくる。"},{"spoiler":false,"text":"でもゲームは下手くそなので、自分ではプレーしない。"},{"spoiler":false,"text":"「おい柾鷹、ゲームをするぞ。 お前に世界の平和を守らせてやる」"}],"source":"bangumi","sourceCharacterId":"42302"}],"profileFacts":[{"label":"趣味","source":"bangumi","sourceCharacterId":"42302","value":"ゲーム、マンガ"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e1e767d411914fdc10fafdd577ea263c14ab6029ff36b7035cefacb95750c0f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86f9cb65d945e736cd5bc209eded00c76e751505c989305a8d1e3bcff3cea099.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高森奈津美","creatorId":"vndb:s979","sourcePersonId":"vndb:s979","canonicalEntityId":"vndb:s979","name":"高森 奈津美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:172842:42302:7302:1","source":"bangumi"}]},{"characterId":"char_c45456","characterName":"碧衣 愁","sourceIds":{"bangumi":[{"characterId":"42303","match":"exact-normalized-name-in-linked-work","subjectId":"172842"}],"egsCharacterIds":["8619"],"vndbCharacterId":"c45456"},"originalCharacterName":"碧衣 愁","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1225"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"height":{"reviewState":"no-conflict","source":"vndb","valu