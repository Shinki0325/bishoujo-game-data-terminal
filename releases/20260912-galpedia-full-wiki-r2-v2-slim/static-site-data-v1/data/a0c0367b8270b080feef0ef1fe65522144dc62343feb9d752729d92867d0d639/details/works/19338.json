え、25才ですよ。 どこか変ですか？　なにか不審なところでも？」"}],"source":"bangumi","sourceCharacterId":"22293"}],"profileFacts":[{"label":"胸围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"2023","sourceWorkId":"19338","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"142 cm","valueContext":null,"source":"egs","sourceCharacterId":"2023","sourceWorkId":"19338","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"71 cm","valueContext":null,"source":"egs","sourceCharacterId":"2023","sourceWorkId":"19338","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"2023","sourceWorkId":"19338","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71b90421126fcde3da2de2cb0c4de7b55a3de4ddd5e270dfb51c007aebf1a1b4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d4002960be79345292f0d18a9ea9231e312b65c11945ae5b2ca0a6628d9c645d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:78636:22293:4830:1","source":"bangumi"}]},{"characterId":"char_c21122","characterName":"姫乃宮 鉄男","sourceIds":{"bangumi":[{"characterId":"22294","match":"exact-normalized-name-in-linked-work","subjectId":"78636"}],"egsCharacterIds":["2024"],"vndbCharacterId":"c21122"},"originalCharacterName":"姫乃宮 鉄男","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"２年生。明るく元気でノリの良い性格。"},{"spoiler":false,"text":"トニックシャンプーと深夜アニメを愛する、色んな意味で男らしい男。"},{"sp