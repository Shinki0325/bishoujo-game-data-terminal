":"小市民代表の妹にとっては、それは嬉しいよりも不安が勝っていた。"},{"spoiler":false,"text":"子供の頃はお兄ちゃんべったりだったが、ここ数年ほど疎遠になっていたため、再び一緒に過ごすことができて喜んでいる。"},{"spoiler":false,"text":"ポテチが大好物。"},{"spoiler":false,"text":"「うぅ、どうしようお兄ちゃん… ちょっとわたし怖いかも…」"}],"source":"bangumi","sourceCharacterId":"22289"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"2019","sourceWorkId":"19338","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"153 cm","valueContext":null,"source":"egs","sourceCharacterId":"2019","sourceWorkId":"19338","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"2019","sourceWorkId":"19338","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"2019","sourceWorkId":"19338","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b141d52c45891fec9e9a68b3fff68ec6b0390c5b52de6e16f43a14cf67617ef0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d335c670de3b134583852e3e1867aa3599ae0eaf6005d4b056dd0e94164be538.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中理々","creatorId":"vndb:s1977","sourcePersonId":"vndb:s1977","canonicalEntityId":"vndb:s1977","name":"田中 理々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:78636:22289:17081:1","source":"bangumi"}]},{"characterId":"char_c21118","characterName":"成瀬 しづ花","sourceIds":{"bangumi":[{"characterId":"22290","match":"exact-normalized-name-in-linked-work","subjectId":"78636"}],"egsCharacterIds":["2020"],"vndbCharacterId":"c21118"},"originalCharacterName":"成瀬 しづ花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState