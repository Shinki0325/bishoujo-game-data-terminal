8434"},"originalCharacterName":"舛添 聖羅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the manager of a high-class club and one of the candidates for the Takeshi's maman. She has a refreshing personality and a mature way of thinking."},{"spoiler":false,"text":"Seira herself was aware that she could never be Takeshi's mother. However, as she gets to know Takeshi, she thinks that it would be nice if she really was his mother..."},{"spoiler":false,"text":"She is a woman who frequently engages in activities with Mishima Sae. She loves boys who are full of youth."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c8434"},{"segments":[{"spoiler":false,"text":"高級クラブの経営者であり、武士のママン候補の一人。"},{"spoiler":false,"text":"性格はサッパリしており、大人の考え方が出来る女性。"},{"spoiler":false,"text":"最初は聖羅自身、武士の母親である筈がないと自覚していた。"},{"spoiler":false,"text":"しかし武士と接していくうちに、自分が本当に武士の母親だったらいいかも…、と思うようになってしまう。"},{"spoiler":false,"text":"三嶋小枝とは頻繁に、行動を共にする。"},{"spoiler":false,"text":"若さに満ち溢れた男の子が大好物である。"}],"source":"egs","sourceCharacterId":"8795","sourceWorkId":"16892","spoiler":false},{"segments":[{"spoiler":false,"text":"高級クラブの経営者であり、武士のママン候補の一人。"},{"spoiler":false,"text":"性格はサッパリしており、大人の考え方が出来る女性。"},{"spoiler":false,"text":"最初は聖羅自身、武士の母親である筈がないと自覚していた。"},{"spoiler":false,"text":"しかし武士と接していくうちに、"},{"spoiler":false,"text":"自分が本当に武士の母親だったらいいかも…、"},{"spoiler":false,"text":"と思うようになってしまう。"},{"spoiler":false,"text":"三嶋小枝とは頻繁に、行動を共にする。"},{"spoiler":false,"text":"若さに満ち溢れた男の子が大好物である。"}],"source":"bangumi","sourceCharacterId":"157435"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4b0ae9549550d8bdc8deba14e538e7d487633a3913c99d6df6cca65691329d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b9bfb5ca49a55c736ae34a8a3d954f363857f4f1e624b8d332980fcb12293fa.webp","width":114,"height":256,"source":"static-detail"},"actors":[{"creditedName":"犬飼あお","creatorId":"vndb:s942","sourcePersonId":"vndb:s942","canonicalEntityId":"vndb:s942","name":"犬飼 あお","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224235:157435:32277:1","source":"bangumi"}]},{"characterId":"char_c8435","characterName":"石田　弥生","sourceIds":{"bangumi":[{"characterId":"157434","match":"exact-normalized-name-in-linked-work","subjectId":"224235"}],"egsCharacterIds":["8794"],"vndbCharacterId":"c8435"},"originalCharacterName":"石田　弥生","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Board chairman of the academy attended by Takeshi. She is well connected with politicians."},{"spoiler":false,"text":"She is also a resident of the dormitory where Yae and Karin live. She does not get along well with Mutsumi."},{"spoiler":false,"text":"She exudes a sense of intimidation, where spartan education awaits anyone."},{"spoiler":false,"text":"However, her bewitching beauty and body, and beautiful legs clad in stockings are exactly Takeshi's taste."},{"spoiler":false,"text":"Her chuckle, when she sees right through things, is a charm point."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c8435"},{"segments":[{"spoiler":false,"text":"武士が通う学園の理事長。政治家とも癒着している。"},{"spoiler":false,"text":"そして、八重とかりんが住む社員寮の住人。"},{"spoiler":false,"text":"須崎むつみとは、あまり仲が宜しくない。"},{"spoiler":false,"text":"もし、武士の本当の母親だったならば、スパルタ教育が待っているような威圧感を醸し出している。"},{"spoiler":false,"text":"しかし、その妖艶な美貌、身体つき、ストッキングを纏った美脚は、武士の趣向の直球ド真ん中。"},{"spoiler":false,"text":"それを見透かしたような含み笑いがチャームポイント。"}],"source":"egs","sourceCharacterId":"8794","sourceWorkId":"16892","spoiler":false},{"segments":[{"spoiler":false,"text":"武士が通う学園の理事長。政治家とも癒着している。"},{"spoiler":false,"text":"そして、八重とかりんが住む社員寮の住人。"},{"spoiler":false,"text":"須崎むつみとは、あまり仲が宜しくない。"},{"spoiler":false,"text":"もし、武士の本当の母親だったならば、"},{"spoiler":false,"text":"スパルタ教育が待っているような威圧感を醸し出している。"},{"spoiler":false,"text":"しかし、その妖艶な美貌、身体つき、"},{"spoiler":false,"text":"ストッキングを纏った美脚は、武士の趣向の直球ド真ん中。"},{"spoiler":false,"text":"それを見透かしたような含み笑いがチャームポイント。"}],"source":"bangumi","sourceCharacterId":"157434"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/476bbd5dfa02484156041935d5d7ee4abe8c15bf4d2a2e344f69dda3b9145d6d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20ae1ac91345f8b4c919f6c07c60dfdd988f4c0a3350eb48389b8bb9cd7fb8c7.webp","width":114,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藍川珪","creatorId":"vndb:s872","sourcePersonId":"vndb:s872","canonicalEntityId":"vndb:s872","name":"藍川珪","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224235:157434:14421:1","source":"bangumi"}]},{"characterId":"char_c8436","characterName":"五十嵐　智恵","sourceIds":{"bangumi":[{"characterId":"157433","match":"exact-normalized-name-in-linked-work","subjectId":"224235"}],"egsCharacterIds":["8793"],"vndbCharacterId":"c8436"},"originalCharacterName":"五十嵐　智恵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a part-time swimming instructor at the school that Takeshi attends, and is an all-around sportswoman."},{"spoiler":false,"text":"She is also a resident of the company dormitory where Yae and Karin live. Takeshi had never imagined that Chie-sensei was a candidate for his maman."},{"spoiler":false,"text":"To begin with, Chie was the daughter of a city councilor, and was also involved in the landowner business. She was also involved in the loan shark business, and was therefore well connected to the underworld."},{"spoiler":false,"text":"She is also a close friend of Masuzoe Seira and Mishima Sae. Her Somber expression makes it difficult to tell whether she is a good person or a bad person, but she is surprisingly loyal and has a strong sense of duty,"},{"spoiler":false,"text":"Her motto is \"Be strict with others and strict with yourself.\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c8436"},{"segments":[{"spoiler":false,"text":"武士が通う学園の、スポーツ万能な非常勤水泳講師。"},{"spoiler":false,"text":"そして、八重とかりんが住む社員寮の住人。"},{"spoiler":false,"text":"武士にとって、智恵先生が自分のママン候補だったとは想像もしていなかった。"},{"spoiler":false,"text":"そもそも智恵は市議会議員の娘で、地上げ屋事業などにも手を出していたことから、裏社会にも顔が利く。"},{"spoiler":false,"text":"舛添聖羅や三嶋小枝との交友も深い。"},{"spoiler":false,"text":"気難しい表情からは、善人なのか悪人なのか判別しづらいが、意外に義理堅く、姐御肌でもある。"},{"spoiler":false,"text":"本人曰く『人に厳しく、自分に厳しく』がモットーらしい。"}],"source":"egs","sourceCharacterId":"8793","sourceWorkId":"16892","spoiler":false},{"segments":[{"spoiler":false,"text":"武士が通う学園の、スポーツ万能な非常勤水泳講師。"},{"spoiler":false,"text":"そして、八重とかりんが住む社員寮の住人。"},{"spoiler":false,"text":"武士にとって、智恵先生が自分のママン候補だったとは"},{"spoiler":false,"text":"想像もしていなかった。"},{"spoiler":false,"text":"そもそも智恵は市議会議員の娘で、地上げ屋事業などにも"},{"spoiler":false,"text":"手を出していたことから、裏社会にも顔が利く。"},{"spoiler":false,"text":"舛添聖羅や三嶋小枝との交友も深い。"},{"spoiler":false,"text":"気難しい表情からは、善人なのか悪人なのか判別しづらいが、"},{"spoiler":false,"text":"意外に義理堅く、姐御肌でもある。"},{"spoiler":false,"text":"本人曰く『人に厳しく、自分に厳しく』がモットーらしい。"}],"source":"bangumi","sourceCharacterId":"157433"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/eda2cf016a7124cd8b33cac2895d73b3c8801a9d4d155c50206dae8810e10420.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21fac7f20957cde9f6ad38c4fe7de495f9bbc1e7ad5243e4b3557eaf9b644719.webp","width":114,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天乙准花","creatorId":"vndb:s339","sourcePersonId":"vndb:s339","canonicalEntityId":"vndb:s339","name":"椎那 天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224235:157433:7890:1","source":"bangumi"}]},{"characterId":"char_c8437","characterName":"Karin-sama (かりん様)","sourceIds":{"bangumi":[{"characterId":"157432","match":"exact-normalized-name-in-linked-work","subjectId":"224235"}],"egsCharacterIds":["8792"],"vndbCharacterId":"c8437"},"originalCharacterName":"Karin-sama (かりん様)","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has a lisp and her thoughts are always the same as when she was a little girl."},{"spoiler":false,"text":"For some reason, she is taken good care of by the other mamans so she can live without any inconvenience. She has no ability to provide for Takeshi though. But her kindness is greater than any of the others."},{"spoiler":false,"text":"The other mamans call her Karin-sama. Even Takeshi is overly attentive to Karin."},{"spoiler":false,"text":"She loves flowers. She has no inhibitions regarding sex. Her toy duck \"Yosshii\" is her precious pet and friend."},{"spoiler":true,"text":"She would always offer herself to receive the worst punishments by Takeshi's late father in order to protect the others. It damaged her mental health greatly, and is the reason why everyone is protective of her."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c8437"},{"segments":[{"spoiler":false,"text":"舌ったらずな口調で、思考は常に少女時代のまま。"},{"spoiler":false,"text":"なぜかママン連中には手厚く面倒を見て貰える為、不自由なく生活していける。"},{"spoiler":false,"text":"武士に対しての保護者能力は皆無だが、その優しさは、他のママン連中の誰よりも勝る。"},{"spoiler":false,"text":"他のママン連中は、かりんのことを『かりん様』、もしくは『果凛様』と呼び崇める。"},{"spoiler":false,"text":"武士も、かりんに対しては過剰な気配りをしてしまう。"},{"spoiler":false,"text":"お花が大好き。エッチにも抵抗感はゼロ。"},{"spoiler":false,"text":"おもちゃのアヒル『ヨッシー』が大切なペットであり、お友達。"}],"source":"egs","sourceCharacterId":"8792","sourceWorkId":"16892","spoiler":false},{"segments":[{"spoiler":false,"text":"舌ったらずな口調で、思考は常に少女時代のまま。"},{"spoiler":false,"text":"なぜかママン連中には手厚く面倒を見て貰える為、"},{"spoiler":false,"text":"不自由なく生活していける。"},{"spoiler":false,"text":"武士に対しての保護者能力は皆無だが、"},{"spoiler":false,"text":"その優しさは、他のママン連中の誰よりも勝る。"},{"spoiler":false,"text":"他のママン連中は、かりんのことを"},{"spoiler":false,"text":"『かりん様』、もしくは『果凛様』と呼び崇める。"},{"spoiler":false,"text":"武士も、かりんに対しては過剰な気配りをしてしまう。"},{"spoiler":false,"text":"お花が大好き。エッチにも抵抗感はゼロ。"},{"spoiler":false,"text":"おもちゃのアヒル『ヨッシー』が大切なペットであり、お友達。"}],"source":"bangumi","sourceCharacterId":"157432"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/994ed205bd9f0c7bea215dd3596b42a3c1ca0c34d059f7bd8ee69ede37bc0a34.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e3d158f106bb6b1e04e313af6ae958529f5bc46be5681d7996cd6b93237fec7.webp","width":114,"height":256,"source":"static-detail"},"actors":[{"creditedName":"津軽 りんご","creatorId":"vndb:s2586","sourcePersonId":"vndb:s2586","canonicalEntityId":"vndb:s2586","name":"津軽 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47674","source":"vndb"}]},{"characterId":"char_c8438","characterName":"倉敷　八重","sourceIds":{"bangumi":[{"characterId":"157431","match":"exact-normalized-name-in-linked-work","subjectId":"224235"}],"egsCharacterIds":["8791"],"vndbCharacterId":"c8438"},"originalCharacterName":"倉敷　八重","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An ordinary widow She has been a friend of Yuka's for a long time and is also acquainted with Takeshi."},{"spoiler":false,"text":"Like Yuka, she has a mild-mannered personality. In fact, she is too quiet. Her face, which always looks dissatisfied, has a shadow over it."},{"spoiler":false,"text":"She is usually in a lonely mood, To Takeshi she appears like a \"mysterious widow\"."},{"spoiler":false,"text":"When the \"Search for Maman\" started, Takeshi had to move to the company dormitory where Yae lived. Takeshi did not show strong opposition to it, he gets to see Yae and Karin, whom he has longed to see."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c8438"},{"segments":[{"spoiler":false,"text":"平凡を形にした未亡人。"},{"spoiler":false,"text":"昔から結花の友達として、武士とも面識がある。"},{"spoiler":false,"text":"結花と同じく温厚な性格。むしろオットリし過ぎな感じである。"},{"spoiler":false,"text":"常に不満そうな表情からは、何やら影が差している。"},{"spoiler":false,"text":"普段から寂しそうな雰囲気を漂わせている為、武士にとっては『謎めいた未亡人』に映っていた。"},{"spoiler":false,"text":"『ママン捜し』が始まった際、武士は八重の住んでいる"},{"spoiler":false,"text":"社員寮へ引っ越す羽目になったが、武士が結花に強固な反対の意思を示さなかった理由は、憧れの八重や、かりんに会えるからだった。"}],"source":"egs","sourceCharacterId":"8791","sourceWorkId":"16892","spoiler":false},{"segments":[{"spoiler":false,"text":"平凡を形にした未亡人。"},{"spoiler":false,"text":"昔から結花の友達として、武士とも面識がある。"},{"spoiler":false,"text":"結花と同じく温厚な性格。むしろオットリし過ぎな感じである。"},{"spoiler":false,"text":"常に不満そうな表情からは、何やら影が差している。"},{"spoiler":false,"text":"普段から寂しそうな雰囲気を漂わせている為、"},{"spoiler":false,"text":"武士にとっては『謎めいた未亡人』に映っていた。"},{"spoiler":false,"text":"『ママン捜し』が始まった際、武士は八重の住んでいる"},{"spoiler":false,"text":"社員寮へ引っ越す羽目になったが、"},{"spoiler":false,"text":"武士が結花に強固な反対の意思を示さなかった理由は、"},{"spoiler":false,"text":"憧れの八重や、かりんに会えるからだった。"}],"source":"bangumi","sourceCharacterId":"157431"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfa7bd6c367dbfd41f12777fcdf86f2c5354247829c3614308fe4638f23c69c5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/4478f1aa5e3429f2369bd5676cc6dc7e9ca8cc30567ea01aaee5e8daef173d62.webp","width":114,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加乃みるく","creatorId":"vndb:s863","sourcePersonId":"vndb:s863","canonicalEntityId":"vndb:s863","name":"加乃 みるく","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224235:157431:11511:1","source":"bangumi"}]},{"characterId":"char_c8439","characterName":"姫園　結花","sourceIds":{"bangumi":[{"characterId":"157430","match":"exact-normalized-name-in-linked-work","subjectId":"224235"}],"egsCharacterIds":["8790"],"vndbCharacterId":"c8439"},"originalCharacterName":"姫園　結花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the step mother of Takeshi and the leader of the \"8 Maman\" candidates."},{"spoiler":false,"text":"She is usually mild-mannered and rarely gets angry. However, people have two sides to them. Yuka is no exception."},{"spoiler":false,"text":"The search for Maman came as a surprise to Takeshi. For Yuka and the other mamans, it was a major project that they had been working on for many years."},{"spoiler":false,"text":"What was Yuka's experience as the step mother of Takeshi? And were her feelings for Takeshi only as a step mother? What is the true meaning of \"Searching for Maman\"?"},{"spoiler":false,"text":"Mystery after mystery, Takeshi himself begins to harbor doubts about Yuka."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c8439"},{"segments":[{"spoiler":false,"text":"（＝主人公が『ママン捜し』をする際、『金堂』から旧姓に戻る）"},{"spoiler":false,"text":"武士の義母であり、『８人のママン候補者達』のリーダー的存在。"},{"spoiler":false,"text":"普段は温厚な性格で、怒ることは滅多にない。"},{"spoiler":false,"text":"しかし人には表裏がある。結花も例外ではなかった。"},{"spoiler":false,"text":"『ママン捜し』は、武士にとって突然の出来事だったが、結花率いるママン連中には、長年の一大プロジェクト。"},{"spoiler":false,"text":"結花にとって、武士の義母としての歳月は如何なるものだったのか。"},{"spoiler":false,"text":"そして武士に対しての想いは、義母としてだけの想いだったのか。"},{"spoiler":false,"text":"『ママン捜し』の真意とは？"},{"spoiler":false,"text":"謎が謎を呼び、武士自身も結花に対して疑心を抱いていくことになる。"}],"source":"egs","sourceCharacterId":"8790","sourceWorkId":"16892","spoiler":false},{"segments":[{"spoiler":false,"text":"（＝主人公が『ママン捜し』をする際、『金堂』から旧姓に戻る）"},{"spoiler":false,"text":"武士の義母であり、『８人のママン候補者達』のリーダー的存在。"},{"spoiler":false,"text":"普段は温厚な性格で、怒ることは滅多にない。"},{"spoiler":false,"text":"しかし人には表裏がある。結花も例外ではなかった。"},{"spoiler":false,"text":"『ママン捜し』は、武士にとって突然の出来事だったが、"},{"spoiler":false,"text":"結花率いるママン連中には、長年の一大プロジェクト。"},{"spoiler":false,"text":"結花にとって、武士の義母としての歳月は如何なるものだったのか。"},{"spoiler":false,"text":"そして武士に対しての想いは、義母としてだけの想いだったのか。"},{"spoiler":false,"text":"『ママン捜し』の真意とは？"},{"spoiler":false,"text":"謎が謎を呼び、武士自身も結花に対して疑心を抱いていくことになる。"}],"source":"bangumi","sourceCharacterId":"157430"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32562a9d25acd63e72d8b2f2da555a83f64c032b1c70aeeb8a090de1614a2e5e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f82dab2b3dc7da9d6a2e4b5d566b7b2e6a79c9d8f2b960071c91416007b9119.webp","width":114,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上みゆ","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224235:157430:6558:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p467","sourceCompanyId":"egs:brand:707","canonicalEntityId":"vndb:p467","name":"TRYSET","roleCodes":["br