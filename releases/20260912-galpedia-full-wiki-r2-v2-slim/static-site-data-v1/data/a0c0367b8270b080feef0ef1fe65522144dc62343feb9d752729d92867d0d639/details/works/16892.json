ceWorkId":"16892","spoiler":false},{"segments":[{"spoiler":false,"text":"そんじょ、そこらに居そうな、気の強い典型的ワルガキ。"},{"spoiler":false,"text":"しかも重度のおっぱい好きで、マセたエロガキでもある。"},{"spoiler":false,"text":"直情的な割には、気の弱いところも見え隠れする。"},{"spoiler":false,"text":"自分を『ボク』と言ってしまうところも、乳離れ出来ていない証拠と言えよう。"},{"spoiler":false,"text":"これまで、結花を自分の母親だと思い続けながら、ワガママに生きてきた。"},{"spoiler":false,"text":"しかし、結花への想いは母親としての情にとどまらず、"},{"spoiler":false,"text":"いつしか一人の女性として恋心を抱いてしまっていたのである。"},{"spoiler":false,"text":"そんな折での、日常を覆す『ママン捜し』。"},{"spoiler":false,"text":"感受性豊かなエロガキの行く末は、如何に！？"}],"source":"bangumi","sourceCharacterId":"157429"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/4973dea7eb29bd0aca1697974834ba904441c5614c2e053f74d61bdf89be261c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af0181822c0788d69f3626c2ca9db0ac5166ab15ce72b3df01073f59ab62dc1c.webp","width":114,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c8431","characterName":"須崎　美穂","sourceIds":{"bangumi":[{"characterId":"157438","match":"exact-normalized-name-in-linked-work","subjectId":"224235"}],"egsCharacterIds":["8798"],"vndbCharacterId":"c8431"},"originalCharacterName":"須崎　美穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daughter of Mutsumi and classmate of Takeshi. She and Takeshi have known each other since childhood."},{"spoiler":false,"text":"She has a strong tolerance and is eager to take care of Takeshi. As a result, she frequently quarrels with Takeshi."},{"spoiler":false,"text":"At first glance, she appears calm and collected, but in front of Takeshi, she has a clear sense of joy, anger, sorrow, and pleasure. Her smile often makes even Takeshi's cheeks turn red."},{"spoiler":f