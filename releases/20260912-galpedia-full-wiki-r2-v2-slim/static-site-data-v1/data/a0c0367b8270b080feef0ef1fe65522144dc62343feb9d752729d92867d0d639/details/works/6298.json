ll,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who transferred to your class in the beginning of the year. Quiet and a bit odd, since an incident shortly after she arrived she has become isolated and a butt of practical jokes. The whole class tends to laugh at her or ignore her problems, even if not directly involved in bullying her."},{"spoiler":false,"text":"From J-List and Wikipedia"}],"source":"vndb","sourceCharacterId":"c1630"},{"segments":[{"spoiler":false,"text":"途中から転入してきた主人公のクラスメイト。"},{"spoiler":false,"text":"クラス・デビューに見事に失敗して以来、一人っきりでいる。"},{"spoiler":false,"text":"傍観者として自己を認識するようになる精神疾患「離人症」の兆候がある。"},{"spoiler":false,"text":"そのせいか。けっこうイジメられているのに、けろっとしている。"}],"source":"egs","sourceCharacterId":"14250","sourceWorkId":"6298","spoiler":false},{"segments":[{"spoiler":false,"text":"中途转校而来的主人公的同班同学。"},{"spoiler":false,"text":"在班里初次登场就华丽丽失败后，如今变得孤单一人。"},{"spoiler":false,"text":"稍稍有点孤僻，明明经常被欺负，却还是满不在乎似的。"}],"source":"bangumi","sourceCharacterId":"11370"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffddd3932125c3d5ed404ee9fa7e576f8bc25ba5ecde8ea62815e34a1d1537a2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/586b8692d82e3aa78e97c1e18c72638998c46d5ba70f58968e92f72fc37165ee.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"河原木志穂","creatorId":"vndb:s13","sourcePersonId":"vndb:s13","canonicalEntityId":"vndb:s13","name":"河原木 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:838:11370:4422:1","source":"bangumi"}]},{"characterId":"char_c1631","characterName":"桐宮 弥津紀","sourceIds":{"bangumi":[{"characterId":"11371","match":"exact-normalized-name-in-linked-work","subjectId":"838"}],"egsCharacterIds":["14251"],"vndbCharacterId":"c1631"},"originalCharacterName":"桐宮 弥津紀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mizuki comes from a rich family and is the student council president. To people who don't know her, she is the typical student idol, out of reach to most. To those who do know her, she can be slightly annoying, as she pushes all work onto other people. Beautiful, intelligent, seemingly self-assured and a natural leader, she hides a mortal fear of the future beneath her confident exterior."},{"spoiler":false,"text":"From J-List and Wikipedia"}],"source":"vndb","sourceCharacterId":"c1631"},{"segments":[{"spoiler":false,"text":"成績は抜群でちょっとした天才肌な先輩。美人。"},{"spoiler":false,"text":"しっかり者として見られることが多く、本人もそういうキャラを維持している。"},{"spoiler":false,"text":"本当はかなりダメな人間。自分の将来について病的に怯えている。"},{"spoiler":false,"text":"目前の重圧からは力一杯逃避するタイプ。"},{"spoiler":false,"text":"そして進路決定という大きな問題が、体面大崩壊の序曲とともに、迫りつつあるのであった。"}],"source":"egs","sourceCharacterId":"14251","sourceWorkId":"6298","spoiler":false},{"segments":[{"spoiler":false,"text":"成绩超群，宛如天才般的前辈。"},{"spoiler":false,"text":"表面看来是威风凛凛的美女，其实是不怎么样的人，对于未来是异常地胆怯。"},{"spoiler":false,"text":"然而经常还是看到她能干的一面居多，本人也在刻意维持着那样的形象。"}],"source":"bangumi","sourceCharacterId":"11371"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/803d659b4467948cac3c159bf135d08367456f027fe49ea6ecc6188ffbf9cc05.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc54cf4df819e48bbc312532c96ee7488818c9647d27e4c6e61675a50cc0d9fc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:838:11371:4832:1","source":"bangumi"}]},{"characterId":"char_c1632","characterName":"ケットシー・ねこ子","sourceIds":{"bangumi":[{"characterId":"11372","match":"exact-normalized-name-in-linked-work","subjectId":"838"}],"egsCharacterIds":["14252"],"vndbCharacterId":"c1632"},"originalCharacterName":"ケットシー・ねこ子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who has recently been running amok in the downtown shopping district. She introduces herself as a \"fairy of the night\", and possesses a strange, yet appealing vital energy."},{"spoiler":false,"text":"From J-List"}],"source":"vndb","sourceCharacterId":"c1632"},{"segments":[{"spoiler":false,"text":"繁華街で出会う、年下の女の子。"},{"spoiler":false,"text":"主人公には「自分は夜の妖精」などと自己紹介するイタタっ娘。"},{"spoiler":false,"text":"異様にハイな少女で、独特のノリ、バイタリティを感じさせる少女。"},{"spoiler":false,"text":"薬を常用しているためハイになっているが、普段はもの凄く暗い。"},{"spoiler":false,"text":"彼女はそのことを『心がからっぽ』と呼んでいて、"},{"spoiler":false,"text":"それを補うための手段がアッパー系のドラッグと夜の繁華街と妖精妄想である。"},{"spoiler":false,"text":"要するに、薬で心を作ろうと無理している。"}],"source":"egs","sourceCharacterId":"14252","sourceWorkId":"6298","spoiler":false},{"segments":[{"spoiler":false,"text":"在繁华街道遇到的低年纪女孩子，自我介绍为「我是夜的妖精」，以自我为中心的人。"},{"spoiler":false,"text":"情绪异常high，有着自己的独特作风，活力无限的少女。"},{"spoiler":false,"text":"因为经常用药，总是保持着高涨情绪。"}],"source":"bangumi","sourceCharacterId":"11372"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d6340955e37c5ca72783e623d40cef537d2602d8c65761d8868581574ecd04d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c7c6afc8846842ff49809084b328bf9613c3dc6832519a9f8547c04777a9ee3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田佳代","creatorId":"vndb:s266","sourcePersonId":"vndb:s266","canonicalEntityId":"vndb:s266","name":"永田 佳代","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:838:11372:6038:1","source":"bangumi"}]},{"characterId":"char_c1634","characterName":"加々見 綾","sourceIds":{"bangumi":[{"characterId":"11373","match":"exact-normalized-name-in-linked-work","subjectId":"838"}],"egsCharacterIds":["14253"],"vndbCharacterId":"c1634"},"originalCharacterName":"加々見 綾","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aya is Kouhei's younger adopted sister. Kouhei often makes fun of her flat chest. She's a good girl, though she takes jokes a bit too seriously."},{"spoiler":false,"text":"From J-List and Wikipedia"}],"source":"vndb","sourceCharacterId":"c1634"},{"segments":[{"spoiler":false,"text":"主人公の義理の妹。"},{"spoiler":false,"text":"お兄ちゃんっ娘で、今どきの娘さん。"},{"spoiler":false,"text":"自分を含めた主人公の家族に対する距離感を鋭敏に察していて、最近はいつも不機嫌気味。"}],"source":"egs","sourceCharacterId":"14253","sourceWorkId":"6298","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公没有血缘关系的妹妹，也是爱粘哥哥的妹妹。"},{"spoiler":false,"text":"然而也不愧是今时今日的妹系，对主人公的家人（包括他），因为敏锐地察觉到距离感的存在，最近心情总是不太好。"}],"source":"bangumi","sourceCharacterId":"11373"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5f1ee598fb18de546b598add7272c1647cff8c2c4598c6dfbd66468d6c129d85.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc2296aee5d5c9ed1c4c30992b6a7a047224d0761b1f032e92daf0288e3404d4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"島村香織","creatorId":"vndb:s1070","sourcePersonId":"vndb:s1070","canonicalEntityId":"vndb:s1070","name":"島村 香織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:838:11373:5938:1","source":"bangumi"}]},{"characterId":"char_c1636","characterName":"南条 京香","sourceIds":{"bangumi":[{"characterId":"11374","match":"exact-normalized-name-in-linked-work","subjectId":"838"}],"egsCharacterIds":["14254"],"vndbCharacterId":"c1636"},"originalCharacterName":"南条 京香","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A student in Kouhei's class. She has a grudge against Aeka and is the reason why the class picks on her so much. She likes to flirt with everyone, especially Kouhei. Kouhei doesn't like her though and gives her the nickname Antoinette, after Marie Antoinette, because of her attitude and personality."}],"source":"vndb","sourceCharacterId":"c1636"},{"segments":[{"spoiler":false,"text":"主人公のクラスメイト。"},{"spoiler":false,"text":"クラスの女の中で最大の権力を持ってる。"},{"spoiler":false,"text":"可愛いが、威圧的で主人公はちょっと苦手に感じている。"},{"spoiler":false,"text":"アントワネットは主人公内部での蔑称。"}],"source":"egs","sourceCharacterId":"14254","sourceWorkId":"6298","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的同班同学，也是女同学中拥有最大权力的家伙。"},{"spoiler":false,"text":"虽说也算蛮可爱，但给人一种威压感，让他有点不擅长应付。"},{"spoiler":false,"text":"アントワネット是主人公对她的蔑称。"}],"source":"bangumi","sourceCharacterId":"11374"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/4792a54d9c89e11a32e0c5e8d1c145ba193cd187911d71a87077ddf5533815ab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b656cb43956744a36a9c23b0eb8e2f4dea095a99ad3136cfcc86ec7c489a36db.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜庭わかな","creatorId":"vndb:s807","sourcePersonId":"vndb:s807","canonicalEntityId":"vndb:s807","name":"桜庭 わかな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:838:11374:11261:1","source":"bangumi"}]},{"characterId":"char_vndb_c1633","characterName":"加々見 公平","sourceIds":{"vndbCharacterId":"c1633"},"originalCharacterName":"加々見 公平","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kouhei is the stereotypical average Japanese high school student. He often hears the sound of a train when he is bored or otherwise unoccupied."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c1633"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/adb6bc39fa77833208d16aade358ba180d1eef1de553972883040b20a6040f4e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a40254f2e2cfa1772ae36e27d01fa1a4dcc2ea513f2854360c699e0d330af0e.webp","width":250,"height":250,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c1635","characterName":"椿 弘文","sourceIds":{"vndbCharacterId":"c1635"},"originalCharacterName":"椿 弘文","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hirofumi is a senior employee at the convenience store where Kouhei works, and has a friendly relationship with Kouhei. Hirofumi is gay and always goes out of his way to act gay around Kouhei. He is always trying to get Kouhei to play erotic games."},{"spoiler":false,"text