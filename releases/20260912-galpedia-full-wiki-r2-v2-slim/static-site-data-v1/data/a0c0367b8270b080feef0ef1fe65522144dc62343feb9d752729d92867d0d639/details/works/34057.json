db:vn-staff:13752","source":"vndb"},{"creditedName":"中村 光一","creatorId":"vndb:s8826","sourcePersonId":"vndb:s8826","canonicalEntityId":"vndb:s8826","name":"中村 光一","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:13753","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c135840","characterName":"公平","sourceIds":{"vndbCharacterId":"c135840"},"originalCharacterName":"公平","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the story, and Nami's boyfriend."}],"source":"vndb","sourceCharacterId":"c135840"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c135885","characterName":"奈美","sourceIds":{"vndbCharacterId":"c135885"},"originalCharacterName":"奈美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"birthday":{"reviewState":"source-only","source":"vndb","value":"703"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kouhei's girlfriend."},{"spoiler":true,"text":"She is the twin sister of Naomi, adopted into a different family following some tragedy. In most routes, she is the antagonists' target."},{"spoiler":true,"text":"In the Mother & Father Ending, she is possessed by her mother's spirit and temporarily turned into a mummy."},{"spoiler":true,"text":"In the Shadows Ending, her \"shadow\" is revealed as the source of the supernatural attacks in the mansion, using Nami's psychic powers."},{"spoiler":true,"text":"In the Monster Bloodlines Ending, she is revealed as a vampire, unconsciously luring Kouhei into her father's trap."},{"spoiler":true,"text":"In the Epilogues, its revealed all of the routes were tests set up by her family to prove Kouhei's feelings for her."}],"source":"vndb","sourceCharacterId":"c135885"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c135899","characterName":"ナオミ","sourceIds":{"vndbCharacterId":"c135899"},"originalCharacterName":"ナオミ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"birthday":{"reviewState":"source-only","source":"vndb","value":"703"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nami's twin sister. Her appearance and history is different in each route."},{"spoiler":true,"text":"In the Burned Route and Fish Monster Ending, Naomi is a living human. In the former, she is delusional and living alone at the mansion, believing her mother or (non-existent) brother are still alive. In the latter, she is trying to appease the bloodthirsty Naoki."},{"spoiler":true,"text":"In the Mother & Father Ending and Twin's Curse Ending, she is a ghost haunting the Mansion. In the former she is trying to help her malevolent mother, while in the latter she is controlled by the Spirit of the mansion to enact the curse."},{"spoiler":true,"text":"In the Shadows Ending, she was turned into the Mummy due to Nami's shadow."},{"spoiler":true,"text":"In the Monster Curse Ending, she is a ghost forced to feed Naoki. In the Monster Bloodlines Ending, she is a vampire attempting to perform her father's ceremony."},{"spoiler":true,"text":"In the Fireflies Ending, she's a ghost that also transforms into the Fish Monster."},{"spoiler":true,"text":"In the Epilogues, she is revealed to be just a normal human."}],"source":"vndb","sourceCharacterId":"c135899"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35b1892d1fbadebd2c107c1c84a5e04834ab94044d10d98ae66abdf61f4e0282.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4a971c1525fad6307542e85777e91e248d3723d7080c755e5eba882d10d273e.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c135968","characterName":"ナオミの母親","sourceIds":{"vndbCharacterId":"c135968"},"originalCharacterName":"ナオミの母親","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Naomi and Nami's mother."},{"spoiler":true,"text":"In the Burned Route, she died and her corpse mummified."},{"spoiler":true,"text":"In the Shadows Ending, her ghost possessed the mansion itself."},{"spoiler":true,"text":"In the rest of the routes, she is a reanimated mummy:"},{"spoiler":true,"text":"In the Mother & Father Ending, she is the antagonist driven by wrath against Kouhei's father for betraying her love, attempting to claim Kouhei for herself."},{"spoiler":true,"text":"In the Twins' Curse Ending and Monster Fish Ending, she attempts to protect Nami and Kouhei from the curses after them."},{"spoiler":true,"text":"In the Monster Curse Ending, she is forced to sate Naoki's hunger."},{"spoiler":true,"text":"In the Monster Family Ending, she was always a mummy and helps with her husband's ceremony."},{"spoiler":true,"text":"In the Fireflies Ending, she is a spirit that can manifest as a mummy, lusting over and assaulting Kouhei."},{"spoiler":true,"text":"In the Epilogues, she is revealed as having simply been disguised as a mummy."}],"source":"vndb","sourceCharacterId":"c135968"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c135969","characterName":"Spirit of the mansion","sourceIds":{"vndbCharacterId":"c135969"},"originalCharacterName":"Spirit of the mansion","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"In the \"cursed twins\" route, she is the original owner of the mansion."},{"spoiler":false,"text":"A woman of authority in Bourgogne. In 1800, she gave birth to twin daughters, who eventually murdered her for the title. She cursed the mansion and all of its inhabitants, manifesting as a green cat."}],"source":"vndb","sourceCharacterId":"c135969"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/2252fc80d741afab914551889e87305676ecd6937eacc5965175472c03b8dbd8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df5a56dc8ac389d135697da39a3f8956a1cea74f783b3746f350575796165072.webp","width":256,"height":152,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c136149","characterName":"ミイラ","sourceIds":{"vndbCharacterId":"c136149"},"originalCharacterName":"ミイラ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A mummy found inside the mansion."},{"spoiler":true,"text":"In nearly all routes, the mummy is the reanimated corpse of Naomi's mother. She is an ally in most route, and an antagonist in the Mother & Father Ending and Monster Curse Ending."},{"spoiler":true,"text":"In the Burned Route, the mummy is both Naomi in disguise as well as her mother's dead body."},{"spoiler":true,"text":"In the Shadows Ending, the mummy is the reanimated corpse of Naomi."},{"spoiler":true,"text":"In the Epilogues, it reveals the Mummy was just the mother in disguise."}],"source":"vndb","sourceCharacterId":"c136149"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ada3a29a9dd5d0b007a74fd584a127c2664ce4cb7159aba6009b4ef950a81dfa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f0c6aff8721979d378b381fbea8f8b5efc717713ec22c4686919a07b773f517.webp","width":137,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c136150","characterName":"公平の父親","sourceIds":{"vndbCharacterId":"c136150"},"originalCharacterName":"公平の父親","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kouhei's father, who passed away when Kouhei was young."},{"spoiler":true,"text":"In the \"Mother and Father\" route, he was in an affair with Naomi's mother. In that same route, Kouhei's physical appearance transforms into his father, and suffers the wrath of Naomi's mother's revenge."}],"source":"vndb","sourceCharacterId":"c136150"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c136962","characterName":"怪魚","sourceIds":{"vndbCharacterId":"c136962"},"originalCharacterName":"怪魚","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Fish Monster that is seen roaming the mansion on subsequent playthroughs."},{"spoiler":true,"text":"Nami and Naomi's younger brother."},{"spoiler":true,"text":"In most endings, Naoki and the Fish Monster don't exist at all."},{"spoiler":true,"text":"In the Delusional Ending, Naoki is a figment of Naomi's delusion."},{"spoiler":true,"text":"In the Shadows Ending, Naoki died in a car accident alongside their father. A Fish Monster is conjured by Nami's shadow."},{"spoiler":true,"text":"In the Fish Monster Ending and Monster Family Route, Naoki is transformed into a Fish Monster. He is either trying to eat Nami, or participate in their father's ceremony."},{"spoiler":true,"text":"In the Fireflies Ending, the Fish Monster is a transformed Naomi."},{"spoiler":true,"text":"In the Epilogues, it reveals the Fish Monster was just Naoki in disguise."}],"source":"vndb","sourceCharacterId":"c136962"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed79a3f39cd104e594cd0181c36391c90db7a52b8fa91be8b79ae0505286c631.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/443ddbdf046df7b0c64ac0260ddfc265040e1c1f660789ae202a1642300d8c37.webp","width":256,"height":224,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c136963","characterName":"アインシュタイン博","sourceIds":{"vndbCharacterId":"c136963"},"originalCharacterName":"アインシュタイン博","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nami's grandfather. In the game's hidden Epilogues, he secretly orchestrated the horrors within the mansion alongside Nami's family in order to test Kouhei's feelings for Nami."}],"source":"vndb","sourceCharacterId":"c136963"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c137267","characterName":"ヨロイ","sourceIds":{"vndbCharacterId":"c137267"},"originalCharacterName":"ヨロイ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A suit of armor that roams around the mansion."},{"spoiler":true,"text":"In almost all routes, the suit or armor is worn or possessed by the antagonists of each route."},{"spoiler":true,"text":"In the Monster Curse Ending, the armor is possessed by the ghost of Nami and Naomi's father, forced to sate Naoki's hunger."},{"spoiler":true,"text":"In the Monster Bloodlines Ending, the armor is also their father, but as a monstrous ghoul that has always been a suit of armor."},{"spoiler":true,"text":"In the Firefly Ending, the armor is possessed by an unnamed businessman who lusts over and assaults Nami."},{"spoiler":true,"text":"In the Epilogues, it reveals the armor was just their father in disguise."}],"source":"vndb","sourceCharacterId":"c137267"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c7cefb34b2e5a0ff29a0c8c15becb0bb29f1cca729310a9e2827aa13335186af.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae26bfc9dad595fa8151943ae1b46b70c52fde01972147b66f605af3707d056e.webp","width":256,"height":241,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c137953","characterName":"透明人間","sourceIds":{"vndbCharacterId":"c137953"},"originalCharacterName":"透明人間","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the managers of Dr. Einstein's test in one of the hidden epilogues. When he appears, he gives Kouhei a perfect score."}],"source":"vndb","sourceCharacterId":"c137953"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c137954","characterName":"フランケンシュタインの怪物","sourceIds":{"vndbCh