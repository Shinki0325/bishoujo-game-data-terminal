e":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"25"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist and P.E teacher of Hanabatake Academy."},{"spoiler":false,"text":"Having been discounted from the position of advisor for the School science club during the teacher's assembly by the principal, he vows revenge against the academy and establishes the \"Second Science Club\". Together with his Assistant Fuuka, begins exacting revenge...Beginning with the Principal who didn't give him the role of Advisor."},{"spoiler":true,"text":"Has a Son in the Sequel"}],"source":"vndb","sourceCharacterId":"c14150"},{"segments":[{"spoiler":false,"text":"峡哉の父親で現花畑学園の学園長。"},{"spoiler":false,"text":"突き抜けた言動が目立つが、生徒思いで器が大きく、そのカリスマ性は絶大。"},{"spoiler":false,"text":"毎回の学園朝礼の時に、前学園長である妻、つまり峡哉の母親の惚気話をするのが、生徒間での御馴染みとして評判であるが、峡哉に取っては拷問の様な時間である。"},{"spoiler":false,"text":"峡介と比べられて育ってきた峡哉に取っては、父親として尊敬はしているが、コンプレックスを感じる大きな壁でもある。"}],"source":"egs","sourceCharacterId":"10836","sourceWorkId":"14708","spoiler":false},{"segments":[{"spoiler":false,"text":"本編主人公。"},{"spoiler":false,"text":"花畑学園の体育教師で、風花や祭璃の担任。"},{"spoiler":false,"text":"かの“ドクター○松”の発明に感動し、発明家の道を進もうとするが、生活のため体育教師になった。"},{"spoiler":false,"text":"同校において、栄光と実績のある科学部の復活に狂喜乱舞するが、その顧問の座を科学教師に奪われ、逆ギレし、「第二科学部」設立を宣言。自らを“ブラック総統”と名乗り、悪事を働き始める。"}],"source":"egs","sourceCharacterId":"14917","sourceWorkId":"12793","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/655a4c814967b4ba9e94b05270e102e3bdc42eb4f9f855d38e92a0789591fc1e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d94e399442cc5bca09f678e36253dfcfb191926cc0b0969d907392566aad600c.webp","width":172,"height":256,"source":"static-detail"},"actors