acts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07b4110313f230974eb8536969b36dfe9a298b69d3f54ba2ac4902a9bb79651a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a40a8f96ae77b4325dee19375d44741ab4d6f81f9f85718fbf01a0230c2853e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"坂田有希","creatorId":"vndb:s1595","sourcePersonId":"vndb:s1595","canonicalEntityId":"vndb:s1595","name":"坂田 有希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230385:75071:15687:1","source":"bangumi"}]},{"characterId":"char_c60015","characterName":"花市 弥生","sourceIds":{"bangumi":[{"characterId":"137537","match":"exact-normalized-name-in-linked-work","subjectId":"230385"}],"egsCharacterIds":["21327"],"vndbCharacterId":"c60015"},"originalCharacterName":"花市 弥生","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園でも有名な堅物数学教師。"},{"spoiler":false,"text":"生真面目で実直。不純異性交遊に対して厳しい態度を示す。"},{"spoiler":false,"text":"学園の風紀を乱す六華とはことごとく対立する。"},{"spoiler":false,"text":"学生時代に彼氏にひどい振られ方をしたらしく、それが原因で男嫌い。"}],"source":"egs","sourceCharacterId":"21327","sourceWorkId":"8867","spoiler":false},{"segments":[{"spoiler":false,"text":"学園でも有名な堅物数学教師。"},{"spoiler":false,"text":"生真面目で実直。不純異性交遊に対して厳しい態度を示す。"},{"spoiler":false,"text":"学園の風紀を乱す六華とはことごとく対立する。"},{"spoiler":false,"text":"学生時代に彼氏にひどい振られ方をしたらしく、それが原因で男嫌い。"}],"source":"bangumi","sourceCharacterId":"137537"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28be1b26b03b0305c517e1f38cc02bd3bfeafb2db27a5678b6239bf88fff1d70.webp","fallbackUrl":"https://wiki-assets.bishoj