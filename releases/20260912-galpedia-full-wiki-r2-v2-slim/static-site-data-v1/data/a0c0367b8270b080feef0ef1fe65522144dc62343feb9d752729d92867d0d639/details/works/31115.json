creditedName":"合資会社ワムソフト","creatorId":"vndb:s15832","sourcePersonId":"vndb:s15832","canonicalEntityId":"vndb:s15832","name":"WAMSOFT(合資会社ワムソフト)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:154718","source":"vndb"},{"creditedName":"Dario Nitri","creatorId":"vndb:s29596","sourcePersonId":"vndb:s29596","canonicalEntityId":"vndb:s29596","name":"Dario Nitri","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:154719","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c59701","characterName":"野上 姫子","sourceIds":{"vndbCharacterId":"c59701"},"originalCharacterName":"野上 姫子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nogami has worked as Sengoku Ichiru's assistant ever since her time in CIRS’ Special Medical Division, and she continues to uphold that role at Mihama Academy."},{"spoiler":false,"text":"While brilliant, she also possesses several personal faults that get in the way of her day-to-day life. Case in point: the fact that her room is always such a total mess. Haruto thinks of her as a sort of surrogate older sister, turning to her first whenever he has issues that he's reluctant to discuss with Principal Sengoku."},{"spoiler":false,"text":"\"Nogami is fine.\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c59701"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/9388933b0d1b4e837ec3d76bcdbd7f6bac73276c5eaea54aad0c2ac0e7659926.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/015b52c2aec366e0facba61eba14f3a41283686fca6dd178b0db4aeb08a3905c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近江 知永","creatorId":"vndb:s6907","sourcePersonId":"vndb:s6907","canonicalEntityId":"vndb:s6907","name":"近江 知永","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80216","source":"vndb"}]},{"characterId":"char_vndb_c59707","characterName":"井ノ原 真紀","sourceIds":{"vndbCharacterId":"c59707"},"originalCharacterName":"井ノ原 真紀","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"404"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"93"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"F"},"hip":{"reviewState":"source-only","source":"vndb","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"AKA “Soul Speed”."},{"spoiler":false,"text":"Maki is affiliated with a hostile Russian crime syndicate; it is likely that she is being employed by the organization as both a contract killer and bagman."},{"spoiler":false,"text":"Maki is strong and well-built, making her handy in a fight. She wields four Glock 26s, and goes by many aliases. Though wary of others and very quick to anger, Maki’s actually remarkably naïve."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c59707"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/208223c03ed4f8efaa8c02d0340308906f671cd0bf672768ef41c43bf65a995c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/90e07f672e4b5cc4f5569631bdfc93d31c239a43d9b69d8197caa83127fa7532.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南條 愛乃","creatorId":"vndb:s62","sourcePersonId":"vndb:s62","canonicalEntityId":"vndb:s62","name":"南條 愛乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80203","source":"vndb"}]},{"characterId":"char_vndb_c59708","characterName":"宇川 千尋","sourceIds":{"vndbCharacterId":"c59708"},"originalCharacterName":"宇川 千尋","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A handler at SORD’s Keihin Sakuragaoka campus, Ukawa is responsible for instructing Vanilla and Choco."},{"spoiler":false,"text":"He used to work for CIRS, and even served in the same unit as Haruto."},{"spoiler":false,"text":"\"You two - put a stop to it right now.\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c59708"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/765bd68c3a7f3c026ce65d516d9fdc89b6a766a9783a57b93f6fe332c314fea8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d87ce27a8edefa233dea97b181011b9690d71e8266e2251036852cb676b3a1d7.webp","width":222,"height":256,"source":"static-detail"},"actors":[{"creditedName":"須藤 翔","creatorId":"vndb:s4816","sourcePersonId":"vndb:s4816","canonicalEntityId":"vndb:s4816","name":"やじまのぼる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80215","source":"vndb"}]},{"characterId":"char_vndb_c62418","characterName":"九真城 恵","sourceIds":{"vndbCharacterId":"c62418"},"originalCharacterName":"九真城 恵","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1118"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"E"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A sniper from the SORD unit based at St. Aile’s International, sister school to Mihama Academy."},{"spoiler":false,"text":"It’s said that once she has you in her sights, there’s no escape - hence her nickname, “Mystic Eye”. Her main weapon is a Blaser R93."},{"spoiler":false,"text":"Gumi behaves like an old-school war veteran, and tends to adopt a ludicrously single-minded approach to her duties. Burning with a powerful sense of justice, Gumi takes a hard line against unscrupulous behavior; the harshness of her rebukes can come as quite a shock."},{"spoiler":false,"text":"Her special skill is speed eating, and she won’t be beaten in this by anyone."},{"spoiler":false,"text":"\"Sorry, senpai. There's still something I need to do - one task I have to complete.\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c62418"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a27cc28a6d01148bbc9f150ca76412fbf697a54f71c55a544e245477a0d1504.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/9061433466960d92af3dcbd46029aa318443ffc8faa5d306316f82496f10d435.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三森 すずこ","creatorId":"vndb:s627","sourcePersonId":"vndb:s627","canonicalEntityId":"vndb:s627","name":"三森 すずこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80208","source":"vndb"}]},{"characterId":"char_vndb_c66510","characterName":"仙石 大雅","sourceIds":{"vndbCharacterId":"c66510"},"originalCharacterName":"仙石 大雅","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"729"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"67"},"hip":{"reviewState":"source-only","source":"vndb","value":"72"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"First cousin to Sengoku Ichiru, and an elementary student in Mihama Academy’s sapper school. Taiga’s always lived a pampered life, having grown up as heiress to the Sengoku estate. She’s a quick-witted and intelligent girl, as evidenced by the fact that she’s already passed her university entrance exams."},{"spoiler":false,"text":"With all the expectations heaped on her, it’s only natural that Taiga should come across as a little arrogant. This is one of the reasons why she tends to keep her distance from other people - though she’s quite happy on her own. Rena calls her “The Milquik Master”, following a serendipitous encounter back when she first arrived at Mihama."},{"spoiler":false,"text":"Taiga is intent on participating in activities that are usually closed to children of her stature; she cares little for age restrictions, nor other people’s opinions of her. Eventually her persistence pays off, when Haruto finally heeds her request to join Class A."},{"spoiler":false,"text":"\"Kujirase... Where am I to be allowed out into the field?\""},{"spoiler":false,"text":"From the official site"}],"source":"vndb","sourceCharacterId":"c66510"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2bad3a50b2218cd8f41666d81eb4c23ceeab51d6af36cff7125f6e4bb6220be.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/898762bc520a3ce3bf8961511fd30153c15600096ee272fa1520e1b418668184.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高森 奈津美","creatorId":"vndb:s979","sourcePersonId":"vndb:s979","canonicalEntityId":"vndb:s979","name":"高森 奈津美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80209","source":"vndb"}]},{"characterId":"char_vndb_c71600","characterName":"狗駒 悠希","sourceIds":{"vndbCharacterId":"c71600"},"originalCharacterName":"狗駒 悠希","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1101"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"100"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"I"},"hip":{"reviewState":"source-only","source":"vndb","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Murasaki's older sister, and a Ninja Master of the same rank. She returns to Mihama after having been away to work abroad for an extended period of time."},{"spoiler":false,"text":"While she has many acquaintances of all shapes and sizes, she doesn't appear to have anybody she can call a true friend. A cheerful girl with a mischievous side, she stands out due to her carefree behavior. She openly expresses her affection, which makes her come off as a bit easy, but this is merely a façade to hide her true nature."},{"spoiler":false,"text":"Her weapons of choice are a suppressor-equipped Bulgarian Makarov and a Kalashnikov (AKS-74U)."},{"spoiler":false,"text":"\"Jeez! How can you spew such lies without battin' an eyelid?!\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c71600"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f3186e2c056bfc914ba7e373790066137b13cb9fbd77bd53c2c2adcac3dd60ae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91642dd1fa16d15888d217e3f3e66676d7432611ae8fa08a7c01701c522c97b2.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐々木 未来","creatorId":"vndb:s3660","sourcePersonId":"vndb:s3660","canonicalEntityId":"vndb:s3660","name":"佐々木 未来","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80213","source":"vndb"}]},{"characterId":"char_vndb_c82644","characterName":"漆原 縁","sourceIds":{"vndbCharacterId":"c82644"},"originalCharacterName":"漆原 縁","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A former member of the Phantom Triggers, the organization that evolved into SORD, who doubled as the team's instructor and handler."},{"spoiler":false,"text":"His main job was to teach his students the skills they needed to prevent them from being killed in action. While he's normally a calm and collected thinker, it is rumored that he's seriously scary on the battlefield."},{"spoiler":false,"text":"He never bragged about his accomplishments on the field, though he could be quite talkative when he was off the clock."},{"spoiler":false,"text":"As the only responsible adult on the team, he is the only father figure that Haruto has ever had."},{"spoiler":false,"text":"\"Aoi-kun, this isn't a game. Get a move on and wrap things up. There's no need to go all out on a simple job like this.\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c82644"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05152df6bbdf0bdaacf8bd84e14056e925b14b9e8124e6e68a7441231bcadd59.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/27/27c480494acc144545bd31c90c5d08b14f91a971a0c9c4e6ce2e3e8a61add021.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浜田 賢二","creatorId":"vndb:s385","sourcePersonId":"vndb:s385","canonicalEntityId":"vndb:s385","name":"浜田 賢二","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80205","source":"vndb"}]},{"characterId":"char_vndb_c82645","characterName":"鮫島 黒江","sourceIds":{"vndbCharacterId":"c82645"},"originalCharacterName":"鮫島 黒江","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kuroe was a reserve student at Mihama Academy's CIRS division, also known as the \"Phantom Triggers\" back in the day. She also acted as Enishi's personal bodyguard and secretary. While she is a Hollow graduate from the same dangerous generation as Aoi, the clever and quiet Kuroe is classified as a \"downer\" type."},{"spoiler":false,"text":"She's extremely loyal to her master Enishi, and doesn't have much interest in anything else."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c82645"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9ac9e2d3cfdfe2e668bfadc57fdfc71840e2b8fef8a66c5cc17e0b9d8dcbc146.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/66a23d7779e2c884eff8fe85f4452d487f9fb1fd38a00b1df553ba6e7e74a3c7.webp","width":166,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加隈 亜衣","creatorId":"vndb:s603","sourcePersonId":"vndb:s603","canonicalEntityId":"vndb:s603","name":"加隈 亜衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80206","source":"vndb"}]},{"characterId":"char_vndb_c83700","characterName":"蒼井 碧","sourceIds":{"vndbCharacterId":"c83700"},"originalCharacterName":"蒼井 碧","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A reserve student and shooter in Mihama Academy's CIRS division, also known as the \"Phantom Triggers\" back in the day."},{"spoiler":false,"text":"An upper-type assassin from Hollow House, Aoi was given to her master, Sengoku Ichiru, as a gift when she left her family home. As she graduated from Hollow before the regulations were tightened, her generation is seen as one of the most dangerous - maybe it would be more accurate to call her a tool of \"national offense,\" rather than \"national defense.\""},{"spoiler":false,"text":"She often tried to resist her \"brainwashing\" by disobeying her master's orders, which tended to cause her great agony."},{"spoiler":false,"text":"Her full name may seem like a joke, but Aoi liked it because it was easy to remember. She ended up looking after baby Haruto whenever Ichiru entrusted him to her."},{"spoiler":false,"text":"\"Ya heard the man. Sorry, but I ain't got no time to beat ya to death at leisure.\""},{"spoiler":false,"text":"From official English site"}],"source":"vndb","sourceCharacterId":"c83700"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2dbc14d93030e4a8c92aece61ba93aeeec3ff27b165af1a1d70f52c0abc29813.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f964aff2ded9b09e7f116ec3cf4625997752b576fc55bbccdb27043967193dad.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小清水 亜美","creatorId":"vndb:s622","sourcePersonId":"vndb:s622","canonicalEntityId":"vndb:s622","name":"小清水 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80207","source":"vndb"}]},{"characterId":"char_vndb_c91917","characterName":"仙石 綾芽","sourceIds":{"vndbCharacterId":"c91917"},"originalCharacterName":"仙石 綾芽","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ichiru's younger brother, and the eldest son of the Sengoku family. Though a handler at St. Aile's, in charge of Sylvia and Velvet, he's also a complete recluse; he hardly shows his face in public."},{"spoiler":false,"text":"Even more outspoken than his sister, he usually comes across as haughty or just plain rude."},{"spoiler":false,"text":"\"And who the hell are you, anyway? Tell me your name, and you can be damn sure I won't forget it. How about that?\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c91917"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/facaa4d62b59b8c839b121ef0fafcc9710cf84bf4912c2535158d5152db940e3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72a22c60e82d8cd267be1a6707688e7fbc0e8c29926bbedc09298a6b04742626.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林 直人","creatorId":"vndb:s1093","sourcePersonId":"vndb:s1093","canonicalEntityId":"vndb:s1093","name":"水樹空","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80219","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p26","sourceCompanyId":"egs:brand:1866","canonicalEntityId":"vndb:p26","name":"PROTOTYPE","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:31115:1866","source":"egs"},{"companyId":"vndb:p26","sourceCompanyId":"vndb:p26","canonicalEntityId":"vndb:p26","name":"株式会社プロトタイプ","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:117600:v24938","source":"vndb"},{"companyId":"vndb:p336","sourceCompanyId":"vndb:p336","canonicalEntityId":"vndb:p336","name":"Frontwing","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:117601:v24938","source":"vndb"},{"companyId":"vndb:p26","sourceCompanyId":"vndb:p26","canonicalEntityId":"vndb:p26","name":"株式会社プロトタイプ","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:120324:v24938","source":"vndb"},{"companyId":"vndb:p336","sourceCompanyId":"vndb:p336","canonicalEntityId":"vndb:p336","name":"Frontwing","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:120325:v24938","source":"vndb"},{"companyId":"vndb:p18672","sourceCompanyId":"vndb:p18672","canonicalEntityId":"vndb:p18672","name":"iqdhk8t0hxww","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:131128:v24938","source":"vndb"},{"companyId":"vndb:p336","sourceCompanyId":"vndb:p336","canonicalEntityId":"vndb:p336","name":"Frontwing","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:140774:v24938","source":"vndb"},{"companyId":"vndb:p23052","sourceCompanyId":"vndb:p23052","canonicalEntityId":"vndb:p23052","name":"Crunchyroll, LLC","roleCodes":["publisher"],"identitySt