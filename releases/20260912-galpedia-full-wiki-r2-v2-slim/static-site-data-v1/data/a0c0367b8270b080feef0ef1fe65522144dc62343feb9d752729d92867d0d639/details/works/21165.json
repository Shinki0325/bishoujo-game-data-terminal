ishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce8dd1616a9b94bb303d60ab6c2d06fb4a2553013293b5c85156e5664f42ca14.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/750cc35cf09ae0f2c93c1a9d311a3f7903771bc60d66007cad8853bd1fbcdc58.webp","width":101,"height":256,"source":"static-detail"},"actors":[{"creditedName":"茉莉奈","creatorId":"vndb:s58","sourcePersonId":"vndb:s58","canonicalEntityId":"vndb:s58","name":"雪絵 れな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:61885","source":"vndb"}]},{"characterId":"char_c23719","characterName":"アメリア・ヴォルーネ・エルターニア","sourceIds":{"bangumi":[{"characterId":"142170","match":"exact-normalized-name-in-linked-work","subjectId":"271213"}],"egsCharacterIds":["3613"],"vndbCharacterId":"c23719"},"originalCharacterName":"アメリア・ヴォルーネ・エルターニア","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"領土の大部分を森に覆われたレノファ地方にて、古きエルフの生活を守り続けていたエルフの国・エルターニア古王国の第一王女。"},{"spoiler":false,"text":"代々女王が治めたこの国の次期女王にして唯一の王位継承者だった。"},{"spoiler":false,"text":"エルターニア古王国が、グュグ・ボロス族（亜オーク族）との戦争で敗れ、滅ぼされてからは長く行方不明だった。"},{"spoiler":false,"text":"性格は穏和にして活発。王女としての慎みと自覚に欠けるところはあるが、民を統べる者としての覚悟は、年とともに芽生えてきている。"},{"spoiler":false,"text":"人の死と争いごとが何より苦手であり、達人の師が認めるほどの弓の腕前を、狩りや競技以外で披露することはない。反面、王族でありながら魔法が苦手。"},{"spoiler":false,"text":"古エルフの例に漏れず、異種族が嫌い。特に自分たちを獲物か商品としか見ない人間や、自分たちを食料か性処理道具としかみないグュグ・ボロス族には憎しみすら抱いている。"},{"spoiler":false,"text":"エルフ族にしては珍しく大食いの食欲魔人。"},{"spoiler":false,"text":"「おはようございます、お母様、お兄様。はうっ……お、お腹空いた…」"}],"source":"egs","sourceCharacterId":"3613","sourceWorkId":"20136","spoiler":false},{"segments":[{"spoiler":false,"text":"領土の大部分を森に覆われたレノファ地方にて、古きエルフの生活を守り続けていたエルフの国の第一王女。"},{"spoiler":false,"text":"次期女王であったが、国が戦争によって滅ぼされてからは長く行方不明だった。"},{"spoiler":false,"text":"性格は穏和にして活発。 王女としての慎みと自覚に欠けるところはあるが、民を統べる者としての覚悟は、年とともに芽生えてきている。"},{"spoiler":false,"text":"人の死と争いごとが何より苦手であり、達人である師が認めるほどの弓の腕前を、狩りや競技以外で披露することはない。"},{"spoiler":false,"text":"反面、王族でありながら魔法が苦手。"},{"spoiler":false,"text":"古エルフの例に漏れず、異種族が嫌い。 特に自分たちを獲物か商品としか見ない人間や、自分たちを食料か性処理道具としかみないグュグ・ボロス族には憎しみすら抱いている。"},{"spoiler":false,"text":"エルフ族にしては珍しく、大食いの食欲魔人。"}],"source":"bangumi","sourceCharacterId":"142170"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c37a26e0c4a1ebee133fbd30cf3048c7b73186f7a6090c82b1f1bda15c0403ff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd1c0765fd409fe5baeb709e0c207c3143718756f293141a5e24c6bd0d839f83.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥山 歩","creatorId":"vndb:s857","sourcePersonId":"vndb:s857","canonicalEntityId":"vndb:s857","name":"平松 真奈実","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:61888","source":"vndb"}]},{"characterId":"char_c23720","characterName":"ソフィ・ミィルゲイジ・ダー・ガヴィエロ","sourceIds":{"bangumi":[{"characterId":"142171","match":"exact-normalized-name-in-linked-work","subjectId":"271213"}],"egsCharacterIds":["3614"],"vndbCharacterId":"c23720"},"originalCharacterName":"ソフィ・ミィルゲイジ・ダー・ガヴィエロ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"徹底した植樹で緑化した多層構造の都市国家に住む闇エルフの末姫。"},{"spoiler":false,"text":"名前のダーとは闇エルフ語でいう４であり、闇エルフ王の四人目の子どもにして四女の意味である。"},{"spoiler":false,"text":"伝統的に末子相続である闇エルフにとって、一番年若い彼女こそが王位の第一継承者であり、次代の王になるはずだった。ドワーフ・人間の連合軍に敗れ、降伏し、すべての民が奴隷階級に堕とされる直前に脱出し、現在は行方不明で生死不明とされている。"},{"spoiler":false,"text":"性格は無邪気で天真爛漫。おてんば姫と愛されながらも、重臣たちからは将来を不安がられもしていた。"},{"spoiler":false,"text":"敗戦で国を失ったことへの無念さはあるが、闇エルフらしいシニカルさと天然が同居していて、「負けた方が悪い」と人間に対する敵意はほぼ無い。"},{"spoiler":false,"text":"特技は短剣で、闇エルフ特有の影技と呼ばれる魔法技術と体術の融合技が得意。"},{"spoiler":false,"text":"「んー…ふぁーぁ……。あたし、いつの間に眠ったんだろ…あ。おはよー」"}],"source":"egs","sourceCharacterId":"3614","sourceWorkId":"20136","spoiler":false},{"segments":[{"spoiler":false,"text":"徹底した植樹で緑化した多層構造の都市国家に住む闇エルフの末姫。"},{"spoiler":false,"text":"伝統的に末子相続である闇エルフにとって、一番年若い彼女こそが王位の第一継承者であり、次代の王になるはずだった。"},{"spoiler":false,"text":"しかしドワーフ・人間の連合軍に敗れた後、すべての民が○○階級に堕とされる直前に脱出し、現在は生死不明とされている。"},{"spoiler":false,"text":"性格は無邪気で天真爛漫。 おてんば姫と愛されながらも、重臣たちからは将来を不安がられもしていた。"},{"spoiler":false,"text":"敗戦で国を失ったことへの無念はあるが、闇エルフらしいシニカルさと天然が同居していて、「負けたほうが悪い」 と人間に対する敵意はほぼ無い。"},{"spoiler":false,"text":"特技は短剣で、闇エルフ特有の影技と呼ばれる魔法技術と体術の融合技が得意。"}],"source":"bangumi","sourceCharacterId":"142171"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47b0dd24837acbf7aff9b26e0066a6ea888aad4ceefe038589fd130be2aa6e0e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f2460c167a1037a56579161bd49900579b769e8cd049117259196c3b73393e4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐倉 江美","creatorId":"vndb:s896","sourcePersonId":"vndb:s896","canonicalEntityId":"vndb:s896","name":"永井 真衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:61889","source":"vndb"}]},{"characterId":"char_c51181","characterName":"雪野 ちとせ","sourceIds":{"bangumi":[{"characterId":"13313","match":"exact-normalized-name-in-linked-work","subjectId":"212672"},{"characterId":"13313","match":"exact-normalized-name-in-linked-work","subjectId":"271211"}],"egsCharacterIds":["4738"],"vndbCharacterId":"c51181"},"originalCharacterName":"雪野 ちとせ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"28"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main heroine of the story. She steps in as the young proprietress of the Kinhou-rou, the hot spring inn that the protagonist visits."},{"spoiler":false,"text":"Due to the original proprietress eloping with a younger man for the seventh time, Chitose, who happened to be on winter break, is called in to fill the role. Currently a student preparing for her entrance exams, she is under considerable stress, balancing her duties as an innkeeper with her studies, as the exams are less than a month away. Despite her youth, her directions as the proprietress are precise, earning her the respect and fondness of most of the inn's employees. She tends to be stubborn and obstinate when corrected by others, yet she does not resist changing her own opinions. She is somewhat egotistical and determined to thwart the protagonist's lecherous misdeeds at every turn."}],"source":"vndb","sourceCharacterId":"c51181"},{"segments":[{"spoiler":false,"text":"本作のメインヒロイン。"},{"spoiler":false,"text":"主人公の訪れる温泉の若女将。"},{"spoiler":false,"text":"宿の従業員からも、好意的に受け止められている。"},{"spoiler":false,"text":"主人公のスケベな悪事をことごとく邪魔しようとする。"}],"source":"egs","sourceCharacterId":"4738","sourceWorkId":"3375","spoiler":false},{"segments":[{"spoiler":false,"text":"温泉旅館・金峰館の若女将。"},{"spoiler":false,"text":"しっかりものだが根はお人好し。"},{"spoiler":false,"text":"※「秘湯めぐり～欲情蹂躙温泉記」に登場"}],"source":"egs","sourceCharacterId":"4738","sourceWorkId":"7682","spoiler":false},{"segments":[{"spoiler":false,"text":"【一般宿泊客】"},{"spoiler":false,"text":"薫の代理人として主人公へ定期的に接触してくる謎の女性。"},{"spoiler":false,"text":"柳条組のフロント企業・金峰ファイナンスの女社長。"},{"spoiler":false,"text":"途中からは宿泊客として桂城荘へやってくる。今年で28歳。"}],"source":"egs","sourceCharacterId":"4738","sourceWorkId":"17832","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のメインヒロイン。主人公の訪れる温泉宿・金峰楼（キンホウロウ）の若女将。"},{"spoiler":false,"text":"本来の女将が若い男と７回目の蒸発をしてしまったため、たまたま冬休みだった彼女が呼ばれた。現在、受験生。試験まであと１ヶ月ないため、女将の仕事と受験勉強とで、かなりピリピリきている。若いながら、女将としての指図は的確で、宿の従業員からも、一部を除いてかなり好意的に受け止められている。人かのら注意には、頑固で意固地な性格を発揮するが、自分から意見を変えることにはあまり抵抗がない。唯我独尊タイプ。主人公のスケベな悪事をことごとく邪魔しようとする。"}],"source":"bangumi","sourceCharacterId":"13313"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/106a9f2a72af7e964d1846a7fa2715625d0bf4f0197fa4d642593495754f9310.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57f43e2a1380c4bed1ed0775ba87e6bc7c9f6eac57f7b803c8c5f6d23dd4d45b.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:126136:13313:5890:1","source":"bangumi"}]},{"characterId":"char_c76192","characterName":"柳条 薫","sourceIds":{"bangumi":[{"characterId":"90267","match":"exact-normalized-name-in-linked-work","subjectId":"79208"}],"egsCharacterIds":["4737"],"vndbCharacterId":"c76192"},"originalCharacterName":"柳条 薫","char