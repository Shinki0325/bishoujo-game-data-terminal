n-linked-work","subjectId":"98078"},{"characterId":"23091","match":"source-roster","subjectId":"98078"}],"egsCharacterIds":["7252"],"vndbCharacterId":"c14680"},"originalCharacterName":"魔想 志津香","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"730"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A powerful magic user who was one of the Four Witches of Kathtom. According to her teacher, Ragishss, Shizuka had the greatest talent of the four and was considered the strongest among his students."},{"spoiler":true,"text":"With the additional power gained from her ring, she became even stronger than Ragishss Cryhausen, whom she ended up killing during her betrayal. She is very concerned with her father's death. Ever since Rance stopped her from altering the past during the events of the Kathtom Incident, she has been trying to find her father's killer in order to seek revenge."},{"spoiler":false,"text":"Despite the fact that Shizuka is one of ten girls who are fated for Rance, she hates Rance and will always try to kick him away whenever possible. But it appears that she still have some kind of soft spot for him, albeit often misused by the latter."},{"spoiler":false,"text":"She was living with her best friend, Maria, as they were studying magic together and had a similar interest in magic, with Maria being on development side, and Shizuka on the research side."},{"spoiler":false,"text":"From AliceSoft Wiki"}],"source":"vndb","sourceCharacterId":"c14680"},{"segments":[{"spoiler":false,"text":"カスタム防衛隊隊長。元カスタム四魔女のひとり。"},{"spoiler":false,"text":"魔法使いとしてはAランクに位置する。"},{"spoiler":false,"text":"マリアとは仲がよく、一緒に旅行に出かける。"},{"spoiler":false,"text":"父の仇ラガールを捜している。"}],"source":"egs","sourceCharacterId":"7252","sourceWorkId":"3852","spoiler":false},{"segments":[{"spoiler":false,"text":"技術都市カスタムの守護者・カスタム四魔女の"},{"spoiler":false,"text":"元リーダーにして、大陸屈指の天才魔法使い。めちゃくちゃ強い。"},{"spoiler":false,"text":"人をあまり信用しない性格だが、唯一の親友であるマリアには心を許している。"},{"spoiler":false,"text":"ランスの事が好きなマリアを放っておけず、毎回行動を共にしては、ランスに振り回されることに……。"},{"spoiler":false,"text":"ランスには未だに心を許していない。"},{"spoiler":false,"text":"というより、「毎度迷惑をかけられまくりのランスはぶっちゃけ大嫌い」らしい。"}],"source":"egs","sourceCharacterId":"7252","sourceWorkId":"14858","spoiler":false},{"segments":[{"spoiler":false,"text":"自由都市カスタムに住む、高レベルの魔法使い。"},{"spoiler":false,"text":"過去の事件でランスとは因縁があり、嫌っている。"},{"spoiler":false,"text":"クールなようで激情家。"},{"spoiler":false,"text":"「これはカスタムの問題よ、あんたに頼るつもりはない」"}],"source":"egs","sourceCharacterId":"7252","sourceWorkId":"22060","spoiler":false},{"segments":[{"spoiler":false,"text":"自由都市地帯カスタム出身の魔法使い。"},{"spoiler":false,"text":"mask幼少の頃から数年前まで、父を殺し母をさらった男、"},{"spoiler":false,"text":"ラガールへの復讐心にとらわれて生きていた。"},{"spoiler":false,"text":"ラガールの死後、その娘であり、志津香の異父姉妹でもあるナギ"},{"spoiler":false,"text":"・ス・ラガールに恨まれ、今度は自分が復讐を誓われてしまう。"},{"spoiler":false,"text":"現在は、妹を倒すことをよしとせず、たびたび来るナギの襲撃を"},{"spoiler":false,"text":"かわして居所を転転とする日々を過ごしている。"},{"spoiler":false,"text":"ランスのことは大嫌いだと言っているが、結局行動を共にする"},{"spoiler":false,"text":"ことが多い腐れ縁。/mask"}],"source":"bangumi","sourceCharacterId":"23091"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06cef3f89bb93920a28c4b6d23701c23de434cc03c81253a9a7070f471def2e7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc20b04ddfb207c2e7e837870bb77c22d752edf2b0a20851fe3eb405cffd84e8.webp","width":167,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:295256:23091:15637:1","source":"bangumi"}]},{"characterId":"char_c2310","characterName":"水城 ゆきかぜ","sourceIds":{"bangumi":[{"characterId":"25646","match":"exact-normalized-name-in-linked-work","subjectId":"126046"},{"characterId":"25646","match":"source-roster","subjectId":"126046"},{"characterId":"25646","match":"exact-normalized-name-in-linked-work","subjectId":"21330"},{"characterId":"25646","match":"source-roster","subjectId":"21330"},{"characterId":"25646","match":"source-roster","subjectId":"295256"}],"egsCharacterIds":["6207"],"vndbCharacterId":"c2310"},"originalCharacterName":"水城 ゆきかぜ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"203"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"76"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Main heroine of Taimanin Yukikaze. Fights with twin handguns which amplifies her lightning attacks."}],"source":"vndb","sourceCharacterId":"c2310"},{"segments":[{"spoiler":false,"text":"新世代の戦力と期待される若き対魔忍。"},{"spoiler":false,"text":"代々、“雷遁の術”使いを輩出する名門で彼女も亡き父親同様、“雷遁の術”を使う。"},{"spoiler":false,"text":"“雷遁の術”とは雷を操る強力な術で攻撃系忍法では最強の火力と言われているもの。"},{"spoiler":false,"text":"その中でも彼女の操る雷撃は強力すぎて自身制御が難しいため、術を行使する触媒として特別に制作された銃を使用している。"},{"spoiler":false,"text":"ゆきかぜはその銃に雷撃の弾丸を生み出し、強力な雷撃弾を発射する事ができる。"},{"spoiler":false,"text":"二丁拳銃を得物に、舞うように雷撃弾を放つその姿から電撃の対魔忍の異名を持つ。"},{"spoiler":false,"text":"勝気で負けず嫌い、プライドの高さがたまにキズで唯一心許せる存在が幼馴染の秋山達郎となかなか恋愛関係に進展できないのが悩み。"},{"spoiler":false,"text":"とにかく体を動かして遊ぶのが好きで年中日焼けしている美少女。"}],"source":"egs","sourceCharacterId":"6207","sourceWorkId":"15881","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のヒロイン。"},{"spoiler":false,"text":"新世代の戦力と期待される若き対魔忍。"},{"spoiler":false,"text":"代々、“雷遁の術”使いを排出する名門で彼女も亡き父親同様、“雷遁の術”を使う。"},{"spoiler":false,"text":"“雷遁の術”とは雷を操る強力な術で攻撃系忍法では最強の火力と言われているもの。その中でも彼女の操る雷撃は強力すぎて自身制御が難しいため、術を行使する触媒として特別に制作された銃を使用している。ゆきかぜはその銃に雷撃の弾丸を生み出し、強力な雷撃弾を発射する事ができる。"},{"spoiler":false,"text":"二丁拳銃を得物に、舞うように雷撃弾を放つその姿から〝電撃の対魔忍”の異名を持つ。"},{"spoiler":false,"text":"勝気で負けず嫌い、プライドの高さがたまにキズで唯一心許せる存在が幼馴染の秋山達郎となかなか恋愛関係に進展できないのが悩み。"},{"spoiler":false,"text":"とにかく体を動かして遊ぶのが好きで年中日焼けしている美少女。"}],"source":"egs","sourceCharacterId":"6207","sourceWorkId":"21248","spoiler":false},{"segments":[{"spoiler":false,"text":"新世代の戦力と期待される若き対魔忍。"},{"spoiler":false,"text":"代々、“雷遁の術”使いを輩出する名門で彼女も亡き父親同様、“雷遁の術”を使う。"},{"spoiler":false,"text":"“雷遁の術”とは雷を操る強力な術で攻撃系忍法では最強の火力と言われているもの。"},{"spoiler":false,"text":"その中でも彼女の操る雷撃は強力すぎて自身制御が難しいため、術を行使する触媒として特別に制作された銃を使用している。"},{"spoiler":false,"text":"ゆきかぜはその銃に雷撃の弾丸を生み出し、強力な雷撃弾を発射する事ができる。"},{"spoiler":false,"text":"二丁拳銃を得物に、舞うように雷撃弾を放つその姿から電撃の対魔忍の異名を持つ。"},{"spoiler":false,"text":"勝気で負けず嫌い、プライドの高さがたまにキズで唯一心許せる存在が幼馴染の秋山達郎となかなか恋愛関係に進展できないのが悩み。"},{"spoiler":false,"text":"とにかく体を動かして遊ぶのが好きで年中日焼けしている美少女。"},{"spoiler":false,"text":"「そ、そう！　達郎がそう言うなら期待しておいてあげる……！」"}],"source":"egs","sourceCharacterId":"6207","sourceWorkId":"21820","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のヒロイン。新世代の戦力と期待される若き対魔忍。"},{"spoiler":false,"text":"代々 “雷遁の術”使いを排出する名門で、彼女も雷遁の術を使う。"},{"spoiler":false,"text":"雷遁は攻撃系忍法では最強の火力と言われており、その中でも彼女の操る雷撃は強力すぎて制御が難しいため、触媒として特別に製作された銃を使用している。"},{"spoiler":false,"text":"二丁拳銃を得物に、舞うように雷撃弾を放つその姿から “電撃の対魔忍” の異名を持つ。"},{"spoiler":false,"text":"勝気で負けず嫌い。プライドの高さがたまにキズで、唯一心許せる存在が幼なじみの秋山達郎だが、なかなか恋愛関係に進展できないのが悩み。"},{"spoiler":false,"text":"とにかく身体を動かして遊ぶのが好きで、年中日焼けしている美少女。"},{"spoiler":false,"text":"＜忍法・雷銃撃＞"},{"spoiler":false,"text":"雷遁の術を応用した強力な攻撃系忍法。二丁拳銃を触媒に雷を集約をさせて雷球を放つ。"},{"spoiler":false,"text":"打ち出された雷球は半プラズマ化しているため、目標を高熱で溶解して大穴を空け、瞬時に雷エネルギーが解放され5000Ｖの雷撃で対象を引き裂く。"},{"spoiler":false,"text":"「そ、そう！　達郎がそう言うなら期待しておいてあげる……！」"}],"source":"bangumi","sourceCharacterId":"25646"}],"profileFacts":[{"label":"出身","source":"bangumi","sourceCharacterId":"25646","value":"水城家"},{"label":"属性","source":"bangumi","sourceCharacterId":"25646","value":"自然"},{"label":"所属","source":"bangumi","sourceCharacterId":"25646","value":"対魔忍"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee14a8bddad789c38111748c3b38a2d2774a3324369b29dfe2bf3ae850519cbe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c3ac063bf787fe70efdd0cf4ef0b5d7c846ab733b9a3e8992eec236e4a5001a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c2316","characterName":"水城 不知火","sourceIds":{"bangumi":[{"characterId":"89551","match":"exact-normalized-name-in-linked-work","subjectId":"126046"},{"characterId":"89551","match":"source-roster","subjectId":"126046"},{"characterId":"89551","match":"source-roster","subjectId":"21330"},{"characterId":"89551","match":"source-roster","subjectId":"295256"}],"egsCharacterIds":["6210"],"vndbCharacterId":"c2316"},"originalCharacterName":"水城 不知火","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"112"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yukikaze's mother."}],"source":"vndb","sourceCharacterId":"c2316"},{"segments":[{"spoiler":false,"text":"ゆきかぜの母親。"},{"spoiler":false,"text":"対魔忍不知火として勇名をはせていたが、５年前にある任務中に行方不明に。"},{"spoiler":false,"text":"夫は彼女が行方不明になってから4年後に任務中に死亡している。"},{"spoiler":false,"text":"対魔忍の隊長を務めるアサギの良きサポート役として戦闘能力だけでなく知略に長けたゆきかぜにとって憧れの母親であった。"}],"source":"egs","sourceCharacterId":"6210","sourceWorkId":"21248","spoiler":false},{"segments":[{"spoiler":false,"text":"対魔忍ユキカゼシリーズの主人公兼メインヒロインの一人である水城ゆきかぜの実母であり、薙刀や忍法『水遁の術』の使い手でもある。"},{"spoiler":false,"text":"対魔忍として井河アサギに匹敵するほどの勇名を馳せ、ゆきかぜにとっても憧れの母親そのものであった。"},{"spoiler":false,"text":"ルートによっては（手負いというハンデも込みであったとはいえ）剣の達人である秋山凜子も太刀打ち出来なかった程。"}],"source":"bangumi","sourceCharacterId":"89551"}],"profileFacts":[{"label":"属性","source":"bangumi","sourceCharacterId":"89551","value":"魔性イラスト"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/267c72210095cafbb8617573eb2d15f43baebb3ef704df459225ce6e24771c09.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d94ec1255f526ce6d0f3c4ec3d320d25c7e1fcfa2864b4c37b368b56d58e14c.webp","width":256,"height":244,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:295256:89551:6131:1","source":"bangumi"}]},{"characterId":"char_c26444","characterName":"エドウィン・ブラック","sourceIds":{"bangumi":[{"characterId":"91867","match":"source-roster","subjectId":"126047"},{"characterId":"91867","match":"source-roster","subjectId":"126050"},{"characterId":"91867","match":"source-roster","subjectId":"145539"},{"characterId":"91867","match":"source-roster","subjectId":"157929"},{"characterId":"91867","match":"source-roster","subjectId":"194251"},{"characterId":"91867","match":"source-roster","subjectId":"295256"},{"characterId":"91867","match":"source-roster","subjectId":"330857"},{"characterId":"91867","match":"exact-normalized-name-in-linked-work","subjectId":"523724"},{"characterId":"91867","match":"source-roster","subjectId":"523724"},{"characterId":"91867","match":"source-roster","subjectId":"59663"}],"egsCharacterIds":["9259"],"vndbCharacterId":"c26444"},"originalCharacterName":"エドウィン・ブラック","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ノマドの創始者。吸血鬼の始祖。"},{"spoiler":false,"text":"吸血鬼の始祖とは、生まれながらの吸血鬼であることを意味し、人間が変じた吸血鬼と違い、完全に不死身で伝承にあるように弱点はなく、日光のもとも平気でいることができる。"},{"spoiler":false,"text":"別名、「デイ・ウォーカー」とも言われる。"},{"spoiler":false,"text":"魔界では支配者階級に属する強力な存在。"},{"spoiler":false,"text":"永遠不滅の生命の中で、彼は永劫の虚無にあり、常に刺激や快楽を求めている。"},{"spoiler":false,"text":"陰謀と生死をかけた戦闘こそ唯一彼に生の充足を与えるものとなっている。"}],"source":"egs","sourceCharacterId":"9259","sourceWorkId":"16312","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c75c9bff4925a2122a2dbc878bb008e9b3a21485f0fbde980c95865c0b663e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96c58c0f9ced11f921b70f241ec7b198a80249f5d8ecacf8eb25baa80363f046.webp","width":159,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c35667","characterName":"鷹守 ハルカ","sourceIds":{"bangumi":[{"characterId":"11031","match":"exact-normalized-name-in-linked-work","subjectId":"11172"},{"characterId":"11031","match":"source-roster","subjectId":"11172"},{"characterId":"11031","match":"source-roster","subjectId":"295256"}],"egsCharacterIds":["12865"],"vndbCharacterId":"c35667"},"originalCharacterName":"鷹守 ハルカ","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"7月31日"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Blade, the title given to the Crescent Moons’ strongest kunoichis, who chased after Noroi from the past into the future. For Takamaru’s protection, and to study the current world herself, she began to attend Jippou Academy. Most of the time, she’s just a normal girl observing modern society and trying to fit in. Despite being in the same year of school as Takamaru, she’s actually older than he is."},{"spoiler":false,"text":"Her talent is so great that she achieved the rank of Blade far faster than most, but she could never bring herself to cross the line of giving her past master her chastity, leaving her not truly a Blade at the time she arrived in the modern age."},{"spoiler":false,"text":"While normally a kind, warm, big-hearted girl, she becomes an elegant warrior in battle."}],"source":"vndb","sourceCharacterId":"c35667"},{"segments":[{"spoiler":false,"text":"ノロイを追って、過去からやってきた上弦衆の閃忍。"},{"spoiler":false,"text":"タカマルのボディガード兼現代勉強のため、"},{"spoiler":false,"text":"十宝学園に学生として転入してくる。"},{"spoiler":false,"text":"穏和で優しく、心優しい少女だが、"},{"spoiler":false,"text":"戦闘時には、最も短期間で「閃忍」となった才能を発揮し、"},{"spoiler":false,"text":"凛々しい忍者となって気丈に戦う。"},{"spoiler":false,"text":"過去において、頭領に貞操を捧げることを踏み切れなかったようで……。"}],"source":"egs","sourceCharacterId":"12865","sourceWorkId":"9967","spoiler":false},{"segments":[{"spoiler":false,"text":"追踪ノロイ而从过去来到现代的上弦众闪忍。为了保护タカマル以及熟悉现代而以学生的身份转入了タカマル就读的十宝学园。"},{"spoiler":false,"text":"平时以一个普通女孩子的身份，努力学习着现代生活。虽然在学园里和タカマル同级，但实际上年纪要比タカマル大。"},{"spoiler":false,"text":"才华横溢，用比其他人更短的时间获得了上弦众中高级战斗员“闪忍”的资格。"},{"spoiler":false,"text":"平时是个温柔体贴，心地善良的女孩。战斗时则会变成一个威风凛凛的战士。"}],"source":"bangumi","sourceCharacterId":"11031"}],"profileFacts":[],"metadataCandidateConflicts":{"bloodType":[{"comparisonValue":"a","source":"vndb","sourceCharacterId":"c35667","value":"a"},{"comparisonValue":"o","source":"bangumi","sourceCharacterId":"11031","value":"O型"}],"waist":[{"comparisonValue":"62","source":"vndb","sourceCharacterId":"c35667","value":"62"},{"comparisonValue":"62","scope":"sourceWork","source":"egs","sourceCharacterId":"12865","sourceWorkId":"9967","value":"62"},{"comparisonValue":"60","source":"bangumi","sourceCharacterId":"11031","value":"60"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/7174fea2f30becbb90076013e9c983a9189f11500ca30b10986bded266ed3d82.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d487f31c4e437d420315ac9a00bc065494ef4ae2732100b5298e90eea21b84f.webp","width":179,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:1036","sourceCompanyId":"egs:brand:1036","canonicalEntityId":"egs:brand:1036","name":"LiLiTH","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:29923:1036","source":"egs"}],"missingStates":["current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
