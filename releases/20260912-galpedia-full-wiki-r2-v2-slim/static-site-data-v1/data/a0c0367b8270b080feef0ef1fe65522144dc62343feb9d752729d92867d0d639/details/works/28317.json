angumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ritsu's mother, who was once a genius swimmer."},{"spoiler":false,"text":"Though she seems strict, she's actually a kind mother deeply devoted to her daughter. She confessed her masochistic tendencies to the protagonist and stopped pretending to be someone she's not, but she still lacks confidence and keeps her distance from him."},{"spoiler":false,"text":"She can't hide her confusion when her daughter Ritsu becomes affectionate towards him, yet she truly cherishes Ritsu. Her biggest worry is that Ritsu is starting to resemble her."},{"spoiler":false,"text":"\"I no longer have any charm as a woman...\""},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c85319"},{"segments":[{"spoiler":false,"text":"『律』の母で教師。"},{"spoiler":false,"text":"誰に対しても厳しく、何事にも真剣に取り組む性格。"},{"spoiler":false,"text":"『佐和子』とは学生時代からの友人で、佐和子の破天荒な行動に毎度悩まされている。"},{"spoiler":false,"text":"また佐和子と同様、主人公が学生時代の教師でもありその厳しさから“鬼ババア“と称され恐れられていた。"},{"spoiler":false,"text":"なにかと口煩くて厳しい人間と思われているが、教え子達の将来を誰よりも考えて、敢えて厳しく接している。"},{"spoiler":false,"text":"特に娘の『律』には厳しく接していて進路に関して、考え方の違いから確執を抱えてしまっている。"},{"spoiler":false,"text":"母親としてよりも教師として律の将来を考えてしまっている。"},{"spoiler":false,"text":"夏場でもジャージを着こみ、露出の多い服装を見た者は居ない。"}],"source":"egs","sourceCharacterId":"21895","sourceWorkId":"28317","spoiler":false},{"segments":[{"spoiler":false,"text":"天才水泳選手の過去を持つ律の母。"},{"spoiler":false,"text":"厳しい母と思いきや、実は娘想いの優しい母。"},{"spoiler":false,"text":"ドＭという性癖を主人公に打ち明け、自分を偽る事を止めたが、まだ自分に自信が無く、主人公に対しては一歩引いてしまっている。"},{"spoiler":false,"text":"娘の律がなついてくる事に、まだ戸惑い隠せないが、律の事は本当に大切に思っている。"},{"spoiler":false,"text":"律が自分に似てきてしまってきているのが心配の種。"}],"source":"egs","sourceCharacterId":"21895","sourceWorkId":"29278","spoiler":false},{"segments":[{"spoiler":false,"text":"「律」の母で教師。誰に対しても厳しく、何事にも真剣に取り組む性格。"},{"spoiler":false,"text":"「佐和子」とは学生時代からの友人で佐和子の破天荒な行動に毎度悩まされている。"},{"spoiler":false,"text":"また佐和子と同様、主人公が学生時代の教師でもあり、"},{"spoiler":false,"text":"その厳しさから “鬼ババア “と称され恐れられていた。"},{"spoiler":false,"text":"なにかと口煩くて厳しい人間と思われているが、"},{"spoiler":false,"text":"教え子達の将来を誰よりも考えて、敢えて厳しく接している。"},{"spoiler":false,"text":"特に娘の「律」には厳しく接していて進路に関して、"},{"spoiler":false,"text":"考え方の違いから確執を抱えてしまっている。"},{"spoiler":false,"text":"母親としてよりも教師として律の将来を考えてしまっている。"},{"spoiler":false,"text":"夏場でもジャージを着こんでおり、露出の多い服装を見た者は居ない。"},{"spoiler":false,"text":"「私に女としての魅力はもうありません」"}],"source":"bangumi","sourceCharacterId":"73677"}],"profileFacts":[{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"21895","sourceWorkId":"28317","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"163 cm","valueContext":null,"source":"egs","sourceCharacterId":"21895","sourceWorkId":"28317","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"21895","sourceWorkId":"28317","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"21895","sourceWorkId":"28317","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"59 kg","valueContext":null,"source":"egs","sourceCharacterId":"21895","sourceWorkId":"28317","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"waist":[{"comparisonValue":"59","source":"vndb","sourceCharacterId":"c85319","value":"59"},{"comparisonValue":"59","scope":"sourceWork","source":"egs","sourceCharacterId":"21895","sourceWorkId":"28317","value":"59"},{"comparisonValue":"59","scope":"sourceWork","source":"egs","sourceCharacterId":"21895","sourceWorkId":"29278","value":"59"},{"comparisonValue":"56","source":"bangumi","sourceCharacterId":"73677","value":"56"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/037088a12f6ea4