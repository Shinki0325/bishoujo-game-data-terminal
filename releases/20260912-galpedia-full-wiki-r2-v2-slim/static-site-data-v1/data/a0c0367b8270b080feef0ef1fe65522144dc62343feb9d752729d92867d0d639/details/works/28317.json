b","sourceCharacterId":"c85316"},{"segments":[{"spoiler":false,"text":"真面目で少々潔癖な性格の為、エッチな事が大嫌い。"},{"spoiler":false,"text":"母の『佐和子』を尊敬してはいるが、破廉恥なところに関しては軽蔑している。"},{"spoiler":false,"text":"誰にでも礼儀正しく察するが、母に対しては時折厳しい物言いをする事も。"},{"spoiler":false,"text":"幼少期に主人公に勉強を教えてもらい、褒めて貰った事から『教』を慕っているが、恥ずかしくて『教』に想いを告げられずにいる。"},{"spoiler":false,"text":"『教』に対して積極的な母『佐和子』に嫉妬してしまう。"},{"spoiler":false,"text":"母のような破廉恥的行為に大きな抵抗があり、真面目と破廉恥の間で葛藤してしまう。"}],"source":"egs","sourceCharacterId":"21892","sourceWorkId":"28317","spoiler":false},{"segments":[{"spoiler":false,"text":"佐和子の娘。"},{"spoiler":false,"text":"破廉恥な事を嫌っている真面目な性格だったが、今では、破廉恥な事も頑張る恋する乙女。"},{"spoiler":false,"text":"母『佐和子』を尊敬しているが、まだ佐和子のように、破廉恥になる事には抵抗があって戸惑っている。"},{"spoiler":false,"text":"周囲の人間が飛びぬけて破廉恥の為、自分に破廉恥の自覚があまり無く、自分はまだ破廉恥じゃないと思っている。"}],"source":"egs","sourceCharacterId":"21892","sourceWorkId":"29278","spoiler":false},{"segments":[{"spoiler":false,"text":"真面目で少々潔癖な性格の為、エッチな事が大嫌い。"},{"spoiler":false,"text":"母の「佐和子」を尊敬してはいるが、破廉恥なところに関しては軽蔑している。"},{"spoiler":false,"text":"誰にでも礼儀正しく接するが、母に対しては時折厳しい物言いをする事も。"},{"spoiler":false,"text":"幼少期に「教」に勉強を教えてもらい、褒めて貰った事から「教」を慕っているが、"},{"spoiler":false,"text":"恥ずかしくて「教」に想いを告げられずにいる。"},{"spoiler":false,"text":"「教」に対して積極的な母「佐和子」に嫉妬してしまう。"},{"spoiler":false,"text":"母のような破廉恥的行為に大きな抵抗があり、"},{"spoiler":false,"text":"真面目と破廉恥の間で葛藤してしまう。"},{"spoiler":false,"text":"「先生は破廉恥な女性の方が好きなんですか？」"}],"source":"bangumi","sourceCharacterId":"73674"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"21892","sourceWorkId":"28317","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"21892","sourceWorkId":"28317","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"21892","sourceWorkId":"28317","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":