{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"25882","model":{"presentationWorkId":"vndb:v20862","staff":{"artwork":[{"creditedName":"Wanaca","creatorId":"vndb:s5464","sourcePersonId":"vndb:s5464","canonicalEntityId":"vndb:s5464","name":"Wanaca","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:138780","source":"vndb"}],"scenario":[],"music":[],"other":[{"creditedName":"Wanaca","creatorId":"vndb:s5464","sourcePersonId":"vndb:s5464","canonicalEntityId":"vndb:s5464","name":"Wanaca","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:138779","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c61588","characterName":"Yuki","sourceIds":{"vndbCharacterId":"c61588"},"originalCharacterName":"Yuki","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuki is someone who wholeheartedly believes in her mission as a magical girl. She is energetic and performs her job with a passion. There is a slight awkwardness about her when she ends up in an embarrassing situation."},{"spoiler":false,"text":"She possesses a number of powerful spells and techniques, some of which hardly seem befitting of a girl who supposedly uses the power of love to cast magic."},{"spoiler":false,"text":"From Winged-Cloud Wiki | Fandom powered by Wikia"}],"source":"vndb","sourceCharacterId":"c61588"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/0807af005307563467df44455fa3d0b37a5b383e3a1822fdfb7fad4ef326f14c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc3b88fb441712fe9766946a155d616cbc5d998c71dd744025f47a314b3c0322.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c61589","characterName":"Hikari","sourceIds":{"vndbCharacterId":"c61589"},"originalCharacterName":"Hikari","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Although she enjoys her work as a magical girl, Hikari seems to treat it as she would any other job. She is kind, and the more level headed girl between her and Yuki. She believes in eradicating evil, and is someone who very much holds love dearly in her heart. She seems to be troubled by something at times, but does her best to make sure that she gets the job done."},{"spoiler":false,"text":"From Winged-Cloud Wiki | Fandom powered by Wikia"}],"source":"vndb","sourceCharacterId":"c61589"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b847ee810034245c84d776bee2bc06d063c5414bd46978276c30eed0e3f99c10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b7a28a0ed707517e0f90f851a299676ad74c642fa583df2d5eeec70bf1b354a.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c61590","characterName":"Ayame","sourceIds":{"vndbCharacterId":"c61590"},"originalCharacterName":"Ayame","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a domineering personality and seems to relish teasing Taichi, saying whatever she can to get a reaction out of him. However, Taichi suspects that her actions and words do not reflect who she truly is."},{"spoiler":false,"text":"Although she is a magical girl, Ayame is very different from Yuki and Hikari. She does not draw her power from love, but rather through the manipulation of what she calls ‘negative karma’. Through this power, she is able to control evil entities she encounters."},{"spoiler":false,"text":"From Winged-Cloud Wiki | Fandom powered by Wikia"}],"source":"vndb","sourceCharacterId":"c61590"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21f22fd7e856a83ba02bfaee137cc102e84be1e53f1202bac0c9739e61c9b0ec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/794e9b44d4dd8011ff306c371e8b842449db9812d097f22f54a98f534cd46d27.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c61591","characterName":"Taichi","sourceIds":{"vndbCharacterId":"c61591"},"originalCharacterName":"Taichi","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Taichi’s in a rough spot in his life. In debt and without any other options, he ended up with a low paying cleaning job at a resort with a manager who won’t get off his back. He thought that it would be boring and uneventful…but then, two wand wielding girls appear before him. In the few moments that follow, he learns that evil is a real, tangible force and that magic is also real."},{"spoiler":false,"text":"Although he tries his best to avoid getting involved, the two girls drag him into their battle with the forces of evil. A third girl later appears, tempting him with work that is a bit darker than what he is used to."},{"spoiler":false,"text":"From Winged-Cloud Wiki | Fandom powered by Wikia"}],"source":"vndb","sourceCharacterId":"c61591"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p4019","sourceCompanyId":"egs:brand:4611","canonicalEntityId":"vndb:p4019","name":"Winged Cloud","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:25882:4611","source":"egs"},{"companyId":"vndb:p11862","sourceCompanyId":"vndb:p11862","canonicalEntityId":"vndb:p11862","name":"Gamuzumi","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:114463:v20862","source":"vndb"},{"companyId":"vndb:p18672","sourceCompanyId":"vndb:p18672","canonicalEntityId":"vndb:p18672","name":"iqdhk8t0hxww","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:132295:v20862","source":"vndb"},{"companyId":"vndb:p4019","sourceCompanyId":"vndb:p4019","canonicalEntityId":"vndb:p4019","name":"Winged Cloud","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:140966:v20862","source":"vndb"},{"companyId":"vndb:p4019","sourceCompanyId":"vndb:p4019","canonicalEntityId":"vndb:p4019","name":"Winged Cloud","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:57653:v20862","source":"vndb"},{"companyId":"vndb:p4019","sourceCompanyId":"vndb:p4019","canonicalEntityId":"vndb:p4019","name":"Winged Cloud","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:57997:v20862","source":"vndb"},{"companyId":"vndb:p6056","sourceCompanyId":"vndb:p6056","canonicalEntityId":"vndb:p6056","name":"LuiggiixD","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:74411:v20862","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","egs-creator-credit-missing"],"source":"terminal-wiki-full-runtime-v7"}}
