s":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfb8d68b40e61c0182c2472e9c066da63d429e4bf2675a005e6a86005fee215d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28d54c1046f48d54397bc1edebc17a392b625ea97674df56a793bd2550bd9b4d.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"洲崎 綾","creatorId":"vndb:s3893","sourcePersonId":"vndb:s3893","canonicalEntityId":"vndb:s3893","name":"洲崎 綾","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:56146","source":"vndb"}]},{"characterId":"char_vndb_c53969","characterName":"エマヌエーラ・ポルラローラ","sourceIds":{"vndbCharacterId":"c53969"},"originalCharacterName":"エマヌエーラ・ポルラローラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An Italian girl whom Youto met in the past. Due to her wish on the Stony Cat statue, she temporarily acts as Ponta's sister who came back from Italy. Beneath her cute and optimistic personality, Emi is quite rude. Similarly to Azusa, Emi frequently uses strange analogies in conversation, only she uses plant similes such as calling someone a \"stupid pumpkin\"."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c53969"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4b77153234da63fde848b1a9ef89ccbd718d24c5946b8e2b1a32142d3aaef015.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b614b55ec0d3b9af90b56844bf44d7829fd9a441498e10826b0aca15b5feb599.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"寺川 愛美","creatorId":