ntityStatus":"source-native","relationId":"vndb:vn-staff:104745","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c53963","characterName":"筒隠 月子","sourceIds":{"vndbCharacterId":"c53963"},"originalCharacterName":"筒隠 月子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"726"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"150"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main heroine of the series and a first-year student. She shows her emotions easily and goes to the Stony Cat statue where she wishes to become more mature and less open with her emotions. The Stony Cat statue takes her words literally, and as a result, she has become unable to express any emotions on her face, regardless of the situation. She is often compared to a cat by Youto, and has a tendency to bite him when she gets angry. Tsukiko lives together with her older sister because their parents died when they were younger, but has a bad and distant relationship with her."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c53963"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c4b6b3dd6043072b212b039312f85f7fa1d6d450c5aecda5efdcac8831559da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fbbfcae7fcb32ef083ffa9a197a5623e2bc103c687a8708ff25c1781134904bc.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉 唯","creatorId":"vndb:s3972","sourcePersonId":"vndb:s3972","canonicalEntityId":"vndb:s3972","name":"小倉 唯","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:56147","source":"vndb"}]},{"characterId":"char_vndb_c53964","characterName":"小豆 梓","sourceIds":{"vndbCharacterId":"c53964"},"originalCharacterName":"小豆 梓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Azusa is a second-year student who is very popular. . She is a loner and has rejected all of the confessions she has received. She likes animals and tends to include bizarre animal similes in conversation and owns a pet turtle as well. As a result of Youto's wish on the Stony Cat statue, she temporarily becomes unable to express her honest feelings, but later begins to open up to those around her including him for whom she starts to develop feelings. While she pretends to be a rich elite, she actually lives in a small apartment and keeps several jobs in a neighboring town - as a waitress in a maid cafe, construction worker and paper girl - in order to be able to afford the act."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c53964"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e07d5f1e117bad13d2fc5dacb03f40ecced609abfc40606b40ef424a62fa5d3b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/1715e970a1af4ee7647297fd43c2cb1a42cab330fd405f4a9e716e84b8f92dc9.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原 夏織","creatorId":"vndb:s5713","sourcePersonId":"vndb:s5713","canonicalEntityId":"vndb:s5713","name":"石原 夏織","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:56149","source":"vndb"}]},{"characterId":"char_vndb_c53967","characterName":"モリイ","sourceIds":{"vndbCharacterId":"c53967"},"