ister she never had. If Selphine's obsessive curiosity ever got the best of her, Ritona would always there to guide her back with a stern, yet affectionate lecture."}],"source":"vndb","sourceCharacterId":"c24362"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5a281fc9786ebaf96e1489db66461e5a8b53c89136cac27635990583751e96ec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6aec08596df98af59314582e046554365adda7f82c92d99139d1f7345e6123b2.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c27784","characterName":"リトナ・レインヴァスタ","sourceIds":{"vndbCharacterId":"c27784"},"originalCharacterName":"リトナ・レインヴァスタ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"169"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Selphine's royal guardian."}],"source":"vndb","sourceCharacterId":"c27784"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/8956912ae432d694a1383fece33afd831484b6d113c60633eff95e7ad21a46ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/949063fdae22dd1297f7238ca9fdab4bc315d4a0e4df0e7ce09beb9399f0eebf.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c27788","characterName":"ルド・ゼヴィツ","sourceIds":{"vndbCharacterId":"c27788"},"originalCharacterName":"ルド・ゼヴィツ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text"