{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"6061","model":{"presentationWorkId":"vndb:v2355","staff":{"artwork":[{"creditedName":"林原ひかり","creatorId":"vndb:s6712","sourcePersonId":"egs:creator:2640","canonicalEntityId":"vndb:s6712","name":"林原ひかり","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:10585","source":"egs"}],"scenario":[{"creditedName":"モルデカイ","creatorId":"vndb:s4993","sourcePersonId":"egs:creator:2638","canonicalEntityId":"vndb:s4993","name":"モルデカイ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:12893","source":"egs"}],"music":[{"creditedName":"CHRIS","creatorId":"vndb:s3180","sourcePersonId":"egs:creator:5037","canonicalEntityId":"vndb:s3180","name":"CHRIS","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:19898","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c159407","characterName":"観月　茉麻","sourceIds":{"bangumi":[{"characterId":"143912","match":"exact-normalized-name-in-linked-work","subjectId":"181323"}],"egsCharacterIds":["14463"],"vndbCharacterId":"c159407"},"originalCharacterName":"観月　茉麻","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『いもうと妊娠2～淫・胎・悶・絶～』のヒロイン。"},{"spoiler":false,"text":"観月家の長女。学生。主人公・武人の年の離れた妹。"},{"spoiler":false,"text":"明るく天真爛漫な性格。兄妹の仲もよく、主人公の言うことなら何でも信じてしまうような無垢で素直な女の子。"},{"spoiler":false,"text":"胸の膨らみ始めた程度で、まだまだ発育途上。ブラジャーを付けるといった考えもまだなく、無防備で、袖の脇から胸の膨らみや乳首をチラ見させてしまうこともしばしば。"},{"spoiler":false,"text":"性知識についてはまったくなく、主人公との行為を通じて、徐々にそれが何であるかを知っていく。"}],"source":"egs","sourceCharacterId":"14463","sourceWorkId":"13011","spoiler":false},{"segments":[{"spoiler":false,"text":"観月家の長女。学生。"},{"spoiler":false,"text":"兄の武人とは少し大きく歳の差がある兄妹。"},{"spoiler":false,"text":"明るくて天真爛漫。"},{"spoiler":false,"text":"他の家庭に見られる兄妹喧嘩もそれほど多く見られることは無く、"},{"spoiler":false,"text":"兄の言うことであれば、信じ、何でも聞く素直な子。"},{"spoiler":false,"text":"胸は少し膨らみ始め、陰毛も少しだけ生えかけているが、よく見ないと わからない程度。"},{"spoiler":false,"text":"ブラをするという考えも無く、時折服の下に乳首を透けさせたり、"},{"spoiler":false,"text":"袖の脇から胸の膨らみを晒してしまう。"},{"spoiler":false,"text":"性知識に関しては無知であるが、兄との行為を通じて、"},{"spoiler":false,"text":"それがなんであるのかを徐々に知り、その上で兄との行為に耽っていく。"}],"source":"bangumi","sourceCharacterId":"143912"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f2e12bfd653ab899789145cc7670cc45753f71f995682f0b3a068b2d67934c8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c032850e591d7a0a720d3d1a62531b59f07ac2550496127d9d0d672f0d08e869.webp","width":256,"height":192,"source":"static-detail"},"actors":[{"creditedName":"さくらなつみ","creatorId":"vndb:s666","sourcePersonId":"vndb:s666","canonicalEntityId":"vndb:s666","name":"岩泉まい(樋口まゆら、樋口まゆ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:181337:143912:6279:1","source":"bangumi"}]},{"characterId":"char_c37727","characterName":"観月 りんね","sourceIds":{"bangumi":[{"characterId":"143911","match":"exact-normalized-name-in-linked-work","subjectId":"181323"},{"characterId":"143911","match":"exact-normalized-name-in-linked-work","subjectId":"181342"}],"egsCharacterIds":["14462"],"vndbCharacterId":"c37727"},"originalCharacterName":"観月 りんね","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"『いもうと妊娠』のヒロイン。"},{"spoiler":false,"text":"観月家の長女。学生。主人公・智之の年の離れた妹。"},{"spoiler":false,"text":"天真爛漫で明るくやんちゃな女の子。"},{"spoiler":false,"text":"胸も膨らみ始め、ようやく自分が女であることを認識し出した。それにともなって性についても興味が抱き始めている。"},{"spoiler":false,"text":"しかし、まだ無邪気な年頃ゆえに、無防備な格好をしてしまう。"},{"spoiler":false,"text":"主人公が毎夜自分の部屋に忍び込んで、自分をオカズにしてオチン○ンを弄っていることに対して見て見ぬふりをしていた。それは彼女自身も主人公を愛してしまっていたから……。"}],"source":"egs","sourceCharacterId":"14462","sourceWorkId":"13011","spoiler":false},{"segments":[{"spoiler":false,"text":"セミロングの髪にサイドで三つ編みを作っており、"},{"spoiler":false,"text":"それを束ねるリボンのよく似合う少女。"},{"spoiler":false,"text":"胸はようやく膨らみかけてきた。陰毛はちょぼちょぼ。"},{"spoiler":false,"text":"普段は明るく、兄にいたづらやちょっかいを出してくる、軽いおてんば。"},{"spoiler":false,"text":"兄が毎夜自分の部屋に忍び込み、オナニーをしているのを見てみぬフリをしている。"},{"spoiler":false,"text":"しかし、彼女は自分を思ってくれてる兄を愛しく思っている。"},{"spoiler":false,"text":"性については拙いながらも、学校の保健の授業程度の知識は有。"}],"source":"bangumi","sourceCharacterId":"143911"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05e0244dcf4a49d0a82333ec6ff76287782bb9ddaeec4e0241342c2bb0bacc15.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68ba37ab238725f98f42df74d2a57e5d0f645e988a1eec815f630a5ed65eda0d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩泉 まい","creatorId":"vndb:s666","sourcePersonId":"vndb:s666","canonicalEntityId":"vndb:s666","name":"岩泉まい(樋口まゆら、樋口まゆ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:18226","source":"vndb"}]},{"characterId":"char_vndb_c159409","characterName":"観月　武人","sourceIds":{"vndbCharacterId":"c159409"},"originalCharacterName":"観月　武人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p765","sourceCompanyId":"egs:brand:1121","canonicalEntityId":"vndb:p765","name":"わるき