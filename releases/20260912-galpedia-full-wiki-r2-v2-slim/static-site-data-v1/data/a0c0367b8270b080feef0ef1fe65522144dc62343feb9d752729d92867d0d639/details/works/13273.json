e-native","relationId":"vndb:vn-staff:14358","source":"vndb"},{"creditedName":"bbsacon","creatorId":"vndb:s2267","sourcePersonId":"vndb:s2267","canonicalEntityId":"vndb:s2267","name":"bbsacon","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:14359","source":"vndb"},{"creditedName":"okomeman","creatorId":"vndb:s2269","sourcePersonId":"vndb:s2269","canonicalEntityId":"vndb:s2269","name":"okomeman","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:14361","source":"vndb"},{"creditedName":"okomeman","creatorId":"vndb:s2269","sourcePersonId":"vndb:s2269","canonicalEntityId":"vndb:s2269","name":"okomeman","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:14362","source":"vndb"},{"creditedName":"優歌","creatorId":"vndb:s14398","sourcePersonId":"vndb:s14398","canonicalEntityId":"vndb:s14398","name":"工藤 由佳","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:14365","source":"vndb"}]},"cast":[{"characterId":"char_c26890","characterName":"ミミィ・フェイミン","sourceIds":{"bangumi":[{"characterId":"45557","match":"exact-normalized-name-in-linked-work","subjectId":"191942"}],"egsCharacterIds":["19328"],"vndbCharacterId":"c26890"},"originalCharacterName":"ミミィ・フェイミン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"小柄な体でしなやかに立ちまわり、相手を翻弄する反乱軍の副将。"},{"spoiler":false,"text":"全身を青の装備で固めていることから「碧い豹」と呼ばれ、故郷復興のために打倒帝国の反乱軍に参加した。"},{"spoiler":false,"text":"故郷に婚約者がいるが、「結婚するまで純潔を守る」とのしきたりから、性的に未熟で、快楽に対する免疫は低い"},{"spoiler":false,"text":"「そんな怪物たちの後ろに隠れてないで、前に出てきたら？　もしかして恐いの？　オモラシしちゃいそうなの？」"}],"source":"egs","sourceCharacterId":"19328","sourceWorkId":"9752","spoiler":false},{"segments":[{"spoiler":false,"text":"華奢で小さいながらも、猫のようにしなやかに立ち回り敵を翻弄するテクニカルファイター。"},{"spoiler":false,"text":"アイラスと同じモクゾース反乱軍の戦士。その外見はアジア系の小悪魔的美少女然としている。"},{"spoiler":false,"text":"アイラスとは3年前に知り合い意気投合。といっても、彼女はすこしおすましで意地悪なところがあるために、アイラスに対して憎まれ口を叩く。"},{"spoiler":false,"text":"『猫剣（ビョウケン）』と呼ばれる細身の剣を愛用する。アイラスに対抗しているわけではないが、全身を青で包んでいる事から『モクゾースの碧い豹』と呼ばれている。"},{"spoiler":false,"text":"彼女の目的はギラン連邦を打倒し、かつての『カナカナの里』という自治国を再興させる事にある。小悪魔的でアイラス同様プライドが高いが、ギャリコとサラドの奸策により、脳内に蟲をねじこまれ合図ひとつで性奴隷と化す玩具にされる。なおカナカナの里にチャウという名の婚約者がいる。カナカナの里では結婚するまで純潔を守らなければいけないため性的に未熟であり、快楽に対する免疫は低い。"},{"spoiler":false,"text":"「そんな怪物達の後ろに隠れてないで、前に出てきたら？もしかして怖いの？オモラシしちゃいそうなの？」"}],"source":"bangumi","sourceCharacterId":"45557"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df2479738fb08b01939cceffc34ee7374644f49219bacbde127cc37e21bbdd33.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/9799a71cc425ed8f782ab9e5ddfcc7adae715c4cbc234607845edb24731b79ae.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽高 なる","creatorId":"vndb:s923","sourcePersonId":"vndb:s923","canonicalEntityId":"vndb:s923","name":"由倉 奈於","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7175","source":"vndb"}]},{"characterId":"char_c26891","characterName":"フィーラ・フェリシアド","sourceIds":{"bangumi":[{"characterId":"45560","match":"exact-normalized-name-in-linked-work","subjectId":"191942"}],"egsCharacterIds":["19329"],"vndbCharacterId":"c26891"},"originalCharacterName":"フィーラ・フェリシアド","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"滅亡したフェリシアド王家の末裔。"},{"spoiler":false,"text":"防御や治癒の魔導に長けた魔術師で、時折、奇跡のような治癒術を見せるため、現状では「フェリシアド教の教祖様」が本業。"},{"spoiler":false,"text":"おっとりしているが動揺しやすく、些細なことを気にとめてしまう心配症。"},{"spoiler":false,"text":"過去、アイラスに救われたことから彼女を絶対的に信頼しており、王家に伝わる「世界儀」で「蟲城」の腐毒を中和するため、アイラスと共にジョビル島へ乗り込むが……。"},{"spoiler":false,"text":"「ですが、逃げることは出来ません。なぜならば、試練の前にはアイラスが立っているからです」"}],"source":"egs","sourceCharacterId":"19329","sourceWorkId":"9752","spoiler":false},{"segments":[{"spoiler":false,"text":"フェリシアド王族の直系子孫。フェリシアド王国の再興を願い、家臣達の子孫によって守られてきたお姫様。"},{"spoiler":false,"text":"おっとりとしていて、動揺しやすい性格であるが、アイラスを姉とも母ともした絶対の信頼を置いている。"},{"spoiler":false,"text":"フェリシアドを次ぐべく姫君にして、天性の白魔力を持つ魔術師でもある。その魔導の力は攻撃にはまったくいかされず、防御や治癒に威力を発揮する。ときおり奇跡に近い治癒をみせるために、現状ではどちらかといえば「フェリシアド教の教祖様」の方が本業に思える。"},{"spoiler":false,"text":"追いつめられたサラドがギャリコと契約を交わし、常人では正気を保つことの出来ないほどに淫の力が満ちた『蟲城』に篭城したために、フェリシアド王国に代々伝わる『世界儀』をもって腐毒を中和させる為にアイラスに依頼されてジョビル島に乗り込む。『世界儀の杖』はその清い摩動力で腐毒を無効化し、邪悪な黒魔導を打ち砕くフェリシアドに伝わる秘宝である。"},{"spoiler":false,"text":"「ですが、逃げることはできません。なぜならば、試練の前にはアイラスが立っているからです」"}],"source":"bangumi","sourceCharacterId":"45560"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82aaba5b2f8dfa8b40bdbb556b71591776e74dd8be7ddf9dd6283b46ef12f458.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/6247c4b10b1f7a11de1f45d9ed70884a4681a7eac2d683b37118c41397950637.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"渋谷 ひめ","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7173","source":"vndb"}]},{"characterId":"char_c26892","characterName":"ギャリコ","sourceIds":{"bangumi":[{"characterId":"45562","match":"exact-normalized-name-in-linked-work","subjectId":"191942"}],"egsCharacterIds":["19330"],"vndbCharacterId":"c26892"},"originalCharacterName":"ギャリコ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幼い外見に大きな黒い翼を持ち、二百年以上生きる「人ならざる者」。"},{"spoiler":false,"text":"純粋すぎるほどに無邪気で残忍な性格。"},{"spoiler":false,"text":"追い詰められていたザラドをジョビル島へ呼び寄せ、ある条件と引き換えに契約し、サラドに力を与える。"},{"spoiler":false,"text":"なにやら独自の目的があり、サラドを利用しているようだが……？"},{"spoiler":false,"text":"「この身体の、忌まわしき三つの枷を奪い取って。そして、この煉獄から連れ去って。うふふふっ。くすくすっ。」"}],"source":"egs","sourceCharacterId":"19330","sourceWorkId":"9752","spoiler":false},{"segments":[{"spoiler":false,"text":"南海の孤島『ジョビル島』に閉じ込められている少女。"},{"spoiler":false,"text":"追い詰められたサラドに蟲を寄生させたアホウドリを送り、自らを『サラドの窮状をすくう蟲の女王』としてジョビル島へ呼び寄せた。サラドにある条件と引き換えに『触手を自在に操る力』『淫気から蟲を作る力』などを与える。"},{"spoiler":false,"text":"なにやら独自の目的がありサラドを利用しているようなのだが……？"},{"spoiler":false,"text":"「この身体の、忌まわしき3つの枷を奪い取って。そして、この煉獄から連れ去って。うふふふっ。くすくすっ」"}],"source":"bangumi","sourceCharacterId":"45562"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/6886db8119959b9ab4c74ac453962c15ce9248fdd4da4e00be6185a56ffdf249.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d056db6f3e72f35dd6750feebca0976cfbfc89d98b7f9ced9818025e407e3068.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安 ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7172","source":"vndb"}]},{"characterId":"char_c83603","characterName":"アッシュ・ジム・ヴォール","sourceIds":{"bangumi":[{"characterId":"210403","match":"exact-normalized-name-in-linked-work","subjectId":"191942"}],"egsCharacterIds":["19331"],"vndbCharacterId":"c83603"},"originalCharacterName":"アッシュ・ジム・ヴォール","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"お姫様・フィーラを守る魔導騎士。"},{"spoiler":false,"text":"攻撃系の魔導具操縦はピカイチで、潜在能力が高く、対帝国戦では、フェリシアド王国に伝わる「鼓動の杖」を操り、戦いに臨む。"},{"spoiler":false,"text":"フィズとは幼馴染の間柄"},{"spoiler":false,"text":"「共感……。わかんない、でも、わかるよ。ボクが、やらなきゃならないって……」"}],"source":"egs","sourceCharacterId":"19331","sourceWorkId":"9752","spoiler":false},{"segments":[{"spoiler":false,"text":"フィーラを守護する魔導騎士。"},{"spoiler":false,"text":"フェリシアドに代々庭師として仕えているジム庄の庭師だったが、"},{"spoiler":false,"text":"サラド討伐のため正式に魔導騎士として取り立てられる。"},{"spoiler":false,"text":"身分は魔導騎士三等士官。所属はフェリシアド魔法省・攻撃部署第一師団。"},{"spoiler":false,"text":"攻撃系の魔導具操縦はピカイチで、潜在魔導力は高い。"},{"spoiler":false,"text":"そのため今回のサラド討伐にはフェリシアド王国に代々伝わる魔導具『鼓動の杖』を授けられ、これに臨む。"},{"spoiler":false,"text":"幼い頃よりフィズと面識がある、所謂幼馴染。"}],"source":"bangumi","sourceCharacterId":"210403"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3fd1029dbadb9eb9201ed162a0f7af4905c91704d29d2e244c275d4030b5f010.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/635b748ed6f307e138e75a57ff5eb48a0cf0b70807ea4f03f5cab96f696def85.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"SHIN","creatorId":"vndb:s8603","sourcePersonId":"vndb:s8603","canonicalEntityId":"vndb:s8603","name":"SHIN","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7178","source":"vndb"}]},{"characterId":"char_c83604","characterName":"フィズ・ロット・マイヤー","sourceIds":{"bangumi":[{"characterId":"210405","match":"exact-normalized-name-in-linked-work","subjectId":"191942"}],"egsCharacterIds":["19333"],"vndbCharacterId":"c83604"},"originalCharacterName":"フィズ・ロット・マイヤー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"フィーラを守護する魔法省攻撃隊長。"},{"spoiler":false,"text":"普段は冷静沈着。クールな女性だが、誰よりもフィーラを心配し、どんなことからも護り抜く覚悟を持つ。"},{"spoiler":false,"text":"クワントが味方を守り、フィズが攻撃に専念するといった戦術を得意とする。"},{"spoiler":false,"text":"「ならば。私たちが全力でフィーラ姫様を守るしかない。そう言うことになりそうね」"}],"source":"egs","sourceCharacterId":"19333","sourceWorkId":"9752","spoiler":false},{"segments":[{"spoiler":false,"text":"フィーラを守護する魔法省攻撃隊長。"},{"spoiler":false,"text":"フィーラの護衛隊長として誰よりもフィーラを心配し、守り抜く覚悟をもつ。"},{"spoiler":false,"text":"クワントとは反対に、フェリシアドでも珍しい攻撃系白魔導のエキスパートで、"},{"spoiler":false,"text":"クワントが味方を守り、フィズが攻撃に専念する戦術を得意とする。"},{"spoiler":false,"text":"幼馴染であるアッシュの才能を見抜き、魔導戦士に推薦する。"}],"source":"bangumi","sourceCharacterId":"210405"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fcc8d33c5b9f0434030dcc1de561a2dac547a3be07b64fe6f2bca037b696693.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/954cb90c77b569ec63e9cc6962a35ffc8268a47efa66101583e170433abfd715.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"月山 かなる","creatorId":"vndb:s4988","sourcePersonId":"vndb:s4988","canonicalEntityId":"vndb:s4988","name":"月山 かなる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7177","source":"vndb"}]},{"characterId":"char_c83605","characterName":"クワント・ラクゥ・レイヴァ","sourceIds":{"bangumi":[{"characterId":"210404","match":"exact-normalized-name-in-linked-work","subjectId":"191942"}],"egsCharacterIds":["19332"],"vndbCharacterId":"c83605"},"originalCharacterName":"クワント・ラクゥ・レイヴァ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"フィーラを守護する魔法省戦略隊長で、彼女の教育係も担当する少女。"},{"spoiler":false,"text":"おっとり物静か、控え目な性格だが、フィーラに対する敬愛心は人一倍高い。"},{"spoiler":false,"text":"様々な戦略に長け、味方を補助する白魔法のエキスパートであり、攻撃系が得意なフィズと組むことで、無敵に近い魔導戦術を展開する。"},{"spoiler":false,"text":"「そうです。我々の使命は、姫様を護ることです。だから……護らなければならないのです」"}],"source":"egs","sourceCharacterId":"19332","sourceWorkId":"9752","spoiler":false},{"segments":[{"spoiler":false,"text":"フィーラを守護する魔法省戦略隊長。"},{"spoiler":false,"text":"フェリシアド魔導省の頭脳と呼ばれるほど戦略に長けており、"},{"spoiler":false,"text":"予知や治癒といった味方を補助する白魔導のエキスパートである。"},{"spoiler":false,"text":"攻撃系の白魔導を得意とするフィズと組むことで無敵に近い魔導戦術をほこる。"},{"spoiler":false,"text":"フィーラの教育担当で、博識。"}],"source":"bangumi","sourceCharacterId":"210404"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af91b739e7b4a9df721317bb602bb780bebf343a07ba45f3fd80db8d60475128.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9a1de2ee0c9483a0232b5ec12062d3a036a52ec36e86df59f194e5925a4d106.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"珠 ひよこ","creatorId":"vndb:s4987","sourcePersonId":"vndb:s4987","canonicalEntityId":"vndb:s4987","name":"珠 ひよこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:7176","source":"vndb"}]},{"characterId":"char_vndb_c26889","characterName":"アイラス・ランドクルス","sourceIds":{"vndbCharacterId":"c26889"},"originalCharacterName":"アイラス・ランドクルス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/733084fcd2b13aeec1e1faca62f2aa8cbb4f5413d69647c24fdb9ddbbba42437.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37a8135e7ddd75bc1b1b5494ec8a87fe3603f54ea646362ad03d17edd8b3a38b.webp","width":213,"height":256,"source"