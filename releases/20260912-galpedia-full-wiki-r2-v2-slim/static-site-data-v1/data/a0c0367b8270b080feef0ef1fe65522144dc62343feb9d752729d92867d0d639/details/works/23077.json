,"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/2936670033eb52ed7013ed7dbefd5ffd0897e0101edb1796386e3f855650c30e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4cc8e7d05a9cf98de1a042696095ed8d8e526e2238701e41988d20f8d84a0f67.webp","width":189,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせ なつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67698","source":"vndb"}]},{"characterId":"char_vndb_c6579","characterName":"篠原 千尋","sourceIds":{"vndbCharacterId":"c6579"},"originalCharacterName":"篠原 千尋","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Himeko's younger sister. She is a devout Christian believer with a kind personality and a hospice volunteer on hospital's 7th floor."},{"spoiler":false,"text":"From Wikipedia & Neechin.net"}],"source":"vndb","sourceCharacterId":"c6579"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/2139665e8ea3d58c9e20da083002002631db1e92dbcb6b5a9bed84aac15b82b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a89fac3370a4d058d9dc656a68640cd8706923181e8e3ec729fc1a8e94297963.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤 邑子","creatorId":"vndb:s833","sourcePersonId":"vndb:s833","canonicalEntityId":"vndb:s833","name":"後藤邑子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67699","source":"vndb"}]},{"characterId":"char_vndb_c939","characterName":"佐倉 瀬津美","sourceIds":{"vndbCharacterId":"c939"},"originalCharacterName":"佐倉 瀬津美","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Age in Narcissu: 22"},{"spoiler":false,"text":"Age in Narcissu Side 2nd: 15"},{"spoiler":false,"text":"Setsumi has a childlike physique. She has a taciturn and stoic kind of personality. She loves cars and is knowledgeable about them. Because of her terminal illness, she has no friends and is always seen alone. After many years of receiving treatment, she became totally desperate about everything - life or time, or each day passing doesn't matter to her anymore. It is just like she stated once: \"My time came to a halt\". Everything is very painful to her because she was left behind alone as the world around her continued to move on."},{"spoiler":false,"text":"In Narcissu, she met Atou Yuu, a new resident of the hospital's 7th floor, the hospice, and for a short moment did she come to know something like hope."},{"spoiler":true,"text":"They escaped together and headed to Awajishima, to watch the beautiful blooming narcissus. Along the way, they grew attached to each other and the girl found herself emotional again, happy with her new skirt, blushing... At the end of their journey, she asked for a bikini, and after a long day of playing at the beach, she went into the sea and ended her very life."},{"spoiler":false,"text":"In Narcissu Side 2nd, when she was still an outpatient at her age of 15, she met a resident of the hospital's 7th floor, one of hospice's patients, called Himeko. Their bond grew quickly as Himeko and Setsumi enjoyed their summer days together."},{"spoiler":false,"text":"Edited from Wikipedia & Neechin.net"}],"source":"vndb","sourceCharacterId":"c939"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d18ea2711d1d8f535320647cfc1a7bad8f75cb127bac98ca9ea1821e5df4711c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17658a11a43db493bdd09d34617ce272a3a69ec19c984e759876933ce488dde7.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"綾川 りの","creatorId":"vndb:s1054","sourcePersonId":"vndb:s1054","canonicalEntityId":"vndb:s1054","name":"綾川 りの","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:67700","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p11","sourceCompanyId":"egs:brand:1351","canonicalEntityId":"vndb:p11","name":"ステージ☆なな","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:23077:1351","source":"egs"},{"companyId":"vndb:p2998","sourceCompanyId":"vndb:p2998","canonicalEntityId":"vndb:p2998","name":"风铃汉化组","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:139951:v18739","source":"vndb"},{"companyId":"vndb:p11","sourceCompanyId":"vndb:p11","canonicalEntityId":"vndb:p11","name":"ステージなな","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:147177:v18739","source":"vndb"},{"companyId":"vndb:p162","sourceCompanyId":"vndb:p162","canonicalEntityId":"vndb:p162","name":"Sekai Project","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:147178:v18739","source":"vndb"},{"companyId":"vndb:p11","sourceCompanyId":"vndb:p11","canonicalEntityId":"vndb:p11","name":"ステージなな","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:50724:v18739","source":"vndb"},{"companyId":"vndb:p11","sourceCompanyId":"vndb:p11","canonicalEntityId":"vndb:p11","name":"ステージなな"