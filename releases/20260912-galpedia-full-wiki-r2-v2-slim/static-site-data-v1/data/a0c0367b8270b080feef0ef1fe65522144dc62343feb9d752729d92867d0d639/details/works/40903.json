ments":[{"spoiler":false,"text":"The protagonist of the Hayarigami series."},{"spoiler":false,"text":"He was once a promising detective in the Tokyo Metropolitan Police Department's Criminal Investigation Bureau's Section 1. At the start of the game, he was ordered to be transferred to the MPD's Historical Archives Section instead, located on the 5th basement floor, due to a troubling incident that involved him."},{"spoiler":false,"text":"His rank is lieutenant. He has good running skills, and he rarely misses the criminal in the chase."}],"source":"vndb","sourceCharacterId":"c143381"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e2857f0604c2d2ff95394b324a94f58f428454a5af95fac2c735cbaf113786b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee81ce807f357726bc973cd35614835e6584df714f321be6524f03c38f200e08.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c143382","characterName":"小暮  宗一郎","sourceIds":{"vndbCharacterId":"c143382"},"originalCharacterName":"小暮  宗一郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"27"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He was partnered with the protagonist during the first case they handled. Afterwards, he began working in the Historical Archives Section alongside the protagonist. His rank is sergeant."},{"spoiler":false,"text":"Despite his appearance as a veteran detective, he is still in his 20s and single. He is a third-degree black belt in judo, a third-degree black belt in kendo, and a second-degree black belt in karate, and is a passionate and enthusiastic person. However, contrary to his appearance, he is extremely averse to blood and ghost stories."}],"source":"vndb","sourceCharacterId":"c143382"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41afa31c7bff4145faf588800012bdff20dd89bda3716b04adab2dbd75e6a767.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/012d7f5681da1359eb3f7fe954b786c7bfbb380b58cc1f8be2c10fdb5fcacf00.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c143383","characterName":"犬童 蘭子","sourceIds":{"vndbCharacterId":"c143383"},"originalCharacterName":"犬童 蘭子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female police inspector who speaks in a suspicious Osaka dialect and is in charge of the Historical Archives Section. She is the protagonist's superior, but she rarely does any real work, instead spending most of her time watching TV or engaging in public gambling."},{"spoiler":false,"text":"Occasionally, she shows her extensive knowledge of the occult, making her a mysterious figure."}],"source":"vndb","sourceCharacterId":"c143383"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/3485e4c29eea3ddc34a2ab2f9269d67f48a351b4934b0303456d98a288490fc3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/009d114b2ca706b18123b5f9fd1d8683afee90fc35243ad5fe5ce452d206fa92.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c143384","characterName":"霧崎 水明","sourceIds":{"vndbCharacterId":"c143384"},"originalCharacterName":"霧崎 水明","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He works as a folklore lecturer at an university in Tokyo and is well-versed in the occult and urban legends. He lost his parents during his middle school years and was taken in by the protagonist's family. To the protagonist, he is like an older brother."}],"source":"vndb","sourceCharacterId":"c143384"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/6553c68810c01a4e4d890e37132c5a294db390597580a7dcf3747f28cf2677bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c29e8be71575384fa7ddfd859e3e638eff456031b1849a3d64d5ae62c56de487.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c143387","characterName":"賀茂泉 かごめ","sourceIds":{"vndbCharacterId":"c143387"},"originalCharacterName":"賀茂泉 かごめ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is part of the Crime Investigation Laboratory's Profiling Research Team."},{"spoiler":false,"text":"She has a strong belief in science and completely denies the existence of the occult, often clashing with the protagonist."}],"source":"vndb","sourceCharacterId":"c143387"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3637b36dc9ea6bc0d2581b243b667b39596ab886a8df5cfa3585118d6541d54.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77ac88e01608167a02227f9c7950816d1b524f7ea9c3839e26e78374d8fc9d52.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"charact