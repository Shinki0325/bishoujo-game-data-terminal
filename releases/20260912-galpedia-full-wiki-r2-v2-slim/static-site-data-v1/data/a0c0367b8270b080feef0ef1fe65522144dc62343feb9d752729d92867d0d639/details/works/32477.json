{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"32477","model":{"presentationWorkId":"vndb:v36310","staff":{"artwork":[{"creditedName":"marui","creatorId":"vndb:s808","sourcePersonId":"egs:creator:13428","canonicalEntityId":"vndb:s808","name":"marui","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:246261","source":"egs"}],"scenario":[{"creditedName":"風間ぼなんざ","creatorId":"vndb:s1131","sourcePersonId":"egs:creator:3864","canonicalEntityId":"vndb:s1131","name":"風間ぼなんざ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:246262","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c14219","characterName":"幸崎 羽海","sourceIds":{"bangumi":[{"characterId":"23933","match":"exact-normalized-name-in-linked-work","subjectId":"79838"}],"egsCharacterIds":["2182"],"vndbCharacterId":"c14219"},"originalCharacterName":"幸崎 羽海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Soutarou's junior at the university. She talks in a stern, but polite way, and she gives off an aura which makes her difficult to approach. Thus she doesn't really have friends. She doesn't particularly like talking to other people either, but finds Soutarou to be easy to talk with since he's cut from the same cloth. She is usually calm and determined, but tends to jump into wrong conclusions. Sometimes she can become childishly stubborn. When other girls get close to Soutarou, she acts jealously as girls of her age usually do."}],"source":"vndb","sourceCharacterId":"c14219"},{"segments":[{"spoiler":false,"text":"主人公（宗太郎）が通う大学の後輩。"},{"spoiler":false,"text":"宗太郎をバイトに誘い、一緒にコテージのある南の島を訪れる。"},{"spoiler":false,"text":"凛とした丁寧な口ぶりでしゃべる、美人な後輩。"},{"spoiler":false,"text":"冷静沈着かつ毅然とした近寄り難い雰囲気を発してはいるが、早とちりしたり真面目だけどドジっ子だったりと、どこか抜けている一面を持っている。"},{"spoiler":false,"text":"不可抗力（？）により羽海の胸を触ってしまった宗太郎の「責任を取る」発言に対し、その責任の取り方を監視するという名目で接しているうち、次第に宗太郎の言動が気になっていく。"},{"spoiler":false,"text":"大人びた言動をとるが基本的には意地っ張りで子供っぽいところも多く、宗太郎に近づく女子にヤキモチを焼く姿は年相応のもの。"}],"source":"egs","sourceCharacterId":"2182","sourceWorkId":"19367","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・宗太郎が通う大学の後輩。"},{"spoiler":false,"text":"宗太郎をバイトに誘い、一緒にコテージのある南の島を訪れる。"},{"spoiler":false,"text":"凛とした丁寧な口調でしゃべる美人。"},{"spoiler":false,"text":"冷静沈着かつ毅然とした近寄り難い雰囲気を発してはいるが、早とちりしたり、まじめだけどドジっ子だったりと、どこか抜けている一面を持っている。"},{"spoiler":false,"text":"不可抗力（？）により羽海の胸を触ってしまった宗太郎の 「責任を取る」 発言に対し、その責任の取り方を監視するという名目で接しているうち、次第に宗太郎の言動が気になっていく。"},{"spoiler":false,"text":"大人びた言動をとるが基本的には意地っ張りで子供っぽいところも多く、宗太郎に近づく女子にヤキモチを焼く姿は年相応のもの。"},{"spoiler":false,"text":"「……そういうことなら、ぜ、善処してあげてもいいと思いました」"}],"source":"bangumi","sourceCharacterId":"23933"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/304e844a3f87f0712a3b4a539f525e5bba0cab1014c8a0d952c975f0e03cb0c6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/689fd8a2455d84315c2d65fcc1da049af6605c8608b77f4b277ae42dd1a9fb2f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"波奈束 風景","creatorId":"vndb:s44","sourcePersonId":"vndb:s44","canonicalEntityId":"vndb:s44","name":"中島 沙樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91423","source":"vndb"}]},{"characterId":"char_c14223","characterName":"狩生 渚","sourceIds":{"bangumi":[{"characterId":"23937","match":"exact-normalized-name-in-linked-work","subjectId":"79838"}],"egsCharacterIds":["2186"],"vndbCharacterId":"c14223"},"originalCharacterName":"狩生 渚","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Umi's childhood friend and the resort manager. Her duties as a manager is perfect, no matter what problem she comes across, she solves them very neatly. For people that make a mistake or break the rules, she will calmly ask for the reason and will not harshly blame them and will try to understand them. Because of her intellectual side her words might seem stern, but she is very kind and cares a lot about her workers. She fell in love with Soutarou at first sight, and always tries to separate the work from her feelings."}],"source":"vndb","sourceCharacterId":"c14223"},{"segments":[{"spoiler":false,"text":"羽海の幼馴染みでありコテージの管理人を務める。"},{"spoiler":false,"text":"管理人としての仕事は完璧で、指示出しからなにから、テキパキとこなす。"},{"spoiler":false,"text":"ミスをした人や、ルールをやぶった人には淡々と原因について問いただすが、厳しくしかりつけるわけではなく、相応の理解も示す柔軟な面を見せる。"},{"spoiler":false,"text":"知性溢れるストレートな言葉遣いなのでやわらかさはあまり感じないものの、気遣いと優しさは節々に感じることが出来る。"},{"spoiler":false,"text":"羽海だけではなく、バイトメンバー全員のことを優しく見守っているが、時折見せる鋭い目つきは一部の人間にとっては大好物となるはず。"}],"source":"egs","sourceCharacterId":"2186","sourceWorkId":"19367","spoiler":false},{"segments":[{"spoiler":false,"text":"羽海の幼なじみであり、コテージの管理人を務める。"},{"spoiler":false,"text":"管理人としての仕事は完璧で、指示出しから何からテキパキとこなす。"},{"spoiler":false,"text":"ミスをした人やルールを破った人には淡々と原因について問いただすが、厳しく叱りつけるわけではなく、相応の理解も示す柔軟な面を見せる。"},{"spoiler":false,"text":"知性あふれるストレートな言葉遣いなので柔らかさはあまり感じないものの、気遣いと優しさは節々に感じることができる。"},{"spoiler":false,"text":"羽海だけでなくバイトメンバー全員のことを優しく見守っているが、時折見せる鋭い目つきは一部の人間にとっては大好物となるはず。"},{"spoiler":false,"text":"「早く仕事を覚えて、此処での生活になれて頂戴。 いいわね」"}],"source":"bangumi","sourceCharacterId":"23937"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/643a3b7d29caab9d0513a445698b0db7fc0323205c4e65648833fa4190da2369.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/0941c98ab4fa2cd76fbe3b6db8d81de4b06ce04e1dccaf8c15e78266ac55190a.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c14224","characterName":"大在 宗太郎","sourceIds":{"bangumi":[{"characterId":"205029","match":"exact-normalized-name-in-linked-work","subjectId":"180946"},{"characterId":"205029","match":"exact-normalized-name-in-linked-work","subjectId":"79838"}],"egsCharacterIds":["2187"],"vndbCharacterId":"c14224"},"originalCharacterName":"大在 宗太郎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"175"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist. He lives an independent life so he is a very poor student."}],"source":"vndb","sourceCharacterId":"c14224"},{"segments":[{"spoiler":false,"text":"親に頼らず生活しているので万年金欠の苦学生。"},{"spoiler":false,"text":"なるようになる、しなければどうにもならない――と、背水の陣的に生きているが、見方によっては、真面目で努力家、決断が早く、落ち着いているようにも見える。"},{"spoiler":false,"text":"いろいろあって彼女と一緒に南の島でバイトをすることになったのだが、現地で突然「彼氏として過ごして下さい」と言われ、前途多難な運命に巻き込まれていく。"}],"source":"egs","sourceCharacterId":"2187","sourceWorkId":"19367","spoiler":false},{"segments":[{"spoiler":false,"text":"親に頼らず生活しているので万年金欠の苦学生。"},{"spoiler":false,"text":"なるようになる、しなければどうにもならない――と、背水の陣的に生きているが、見方によってはまじめで努力家、決断が早く、落ち着いているようにも見える。"},{"spoiler":false,"text":"あまり世間の流行などに興味はなく、一般的・常識的なものに沿って生きる。"},{"spoiler":false,"text":"不可抗力（？）で後輩の羽海の胸を触ってしまい、そこから羽海と接することになる。"},{"spoiler":false,"text":"いろいろあって彼女と一緒に南の島でバイトをすることになったのだが、現地で突然 「彼氏として過ごして下さい」 と言われ、前途多難な運命に巻き込まれていく。"},{"spoiler":false,"text":"「俺くらいは、俺を好きでいてあげたいなって、そう思っているんだ」"}],"source":"bangumi","sourceCharacterId":"205029"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bf42c7338d5d50f1f7b61204a76c4175854caf3fe45882522d2516f8b04955f4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/595c8f82a6a9184de3397ba4e36c6f84c824981ea50ea1d33c926953d2c527c6.webp","width":146,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c14227","characterName":"天ヶ瀬 航","sourceIds":{"bangumi":[{"characterId":"205030","match":"exact-normalized-name-in-linked-work","subjectId":"79838"}],"egsCharacterIds":["2190"],"vndbCharacterId":"c14227"},"originalCharacterName":"天ヶ瀬 航","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"181"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Works as a cook for both the resort cafeteria and the open air cafe. Very smart, likes talking and is very polite. He appears to be in his late 20s and early 30s but his real age is unknown."}],"source":"vndb","sourceCharacterId":"c14227"},{"segments":[{"spoiler":false,"text":"リゾート施設の食堂やカフェテラスで働いている料理長。"},{"spoiler":false,"text":"頭がよく話し好きで、言葉遣いは丁寧。"},{"spoiler":false,"text":"自分が一番好きで、男女関係なく恋愛対象としての他人には興味が無い。"},{"spoiler":false,"text":"ただし、他者と比較しての美しさを追求する性格もあり、人間そのものには強い関心がある。"},{"spoiler":false,"text":"外見は20代後半～30代前半だが、本当の年齢は誰も知らない。"}],"source":"egs","sourceCharacterId":"2190","sourceWorkId":"19367","spoiler":false},{"segments":[{"spoiler":false,"text":"リゾート施設の食堂やカフェテラスで働いている料理長。"},{"spoiler":false,"text":"頭が良く話し好きで、言葉遣いは丁寧。"},{"spoiler":false,"text":"自分が一番好きで、男女関係なく恋愛対象としての他人には興味が無い。"},{"spoiler":false,"text":"ただし、他者と比較しての美しさを追求する性格もあり、人間そのものには強い関心がある。"},{"spoiler":false,"text":"外見は20代後半～30代前半だが、本当の年齢は誰も知らない。"},{"spoiler":false,"text":"「僕が作る料理は美味しいですよ。なぜなら、僕が美しいからです」"}],"source":"bangumi","sourceCharacterId":"205030"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5dca59a6f764cfd0f9cc63afbcbbedf0f9f71a352e2d2f177437ea2e3ecbf25.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76578907360de810e17a344b0fe0b1b93e263a4c45b21d53e4d41151bba0e8de.webp","width":117,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p2953","sourceCompanyId":"egs:brand:3692","canonicalEntityId":"vndb:p2953","name":"PULLTOP LATTE","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:32477:3692","source":"egs"},{"companyId":"vndb:p2953","sourceCompanyId":"vndb:p2953","canonicalEntityId":"vndb:p2953","name":"PULLTOP LATTE","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:102243:v36310","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
