{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"23795","model":{"presentationWorkId":"egs:23795","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_12688","characterName":"十六夜 咲夜","sourceIds":{"bangumi":[{"characterId":"12688","match":"source-roster","subjectId":"104009"},{"characterId":"12688","match":"source-roster","subjectId":"1146"},{"characterId":"12688","match":"source-roster","subjectId":"1148"},{"characterId":"12688","match":"source-roster","subjectId":"1150"},{"characterId":"12688","match":"source-roster","subjectId":"1151"},{"characterId":"12688","match":"source-roster","subjectId":"1153"},{"characterId":"12688","match":"source-roster","subjectId":"2134"},{"characterId":"12688","match":"source-roster","subjectId":"329342"},{"characterId":"12688","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"十六夜 咲夜","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"她是住在红魔馆并在里面工作的女仆。是被称之为恶魔之馆的红魔馆中唯一的人类，是女仆们的仆长。"},{"spoiler":false,"text":"她是个在普通人类不敢接近的地方工作的不可思议的少女。"},{"spoiler":false,"text":"没人见过她在进入红魔馆之前是怎样的。而且她对幻想乡里人类的来访极为冷淡，常站在妖怪的阵营之中。所以人们觉得她不是幻想乡的人类，有可能是外面世界或者是别的世界来的人。"},{"spoiler":false,"text":"她没有和村落里任何人类亲近，身上含有许多谜。"},{"spoiler":false,"text":"不过，当她去村落买东西时，她会一脸愉快，一点也没有敌视人类的样子。"}],"source":"bangumi","sourceCharacterId":"12688"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"12688","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"12688","value":"操纵时间的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/badfc65679c51a64f83971b2fbcf3fd13d46dab33013f71db781edf64f76f640.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a45982af2e686a3ac26458362bc4b1715751ec4821b9bd2da5964412df51d2bd.webp","width":186,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_20994","characterName":"栖息于淡水的人鱼","sourceIds":{"bangumi":[{"characterId":"20994","match":"source-roster","subjectId":"104009"},{"characterId":"20994","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"栖息于淡水的人鱼","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"TH14 1面BOSS　栖息于淡水的人鱼"},{"spoiler":false,"text":"若鹭姬"},{"spoiler":false,"text":"Wakasagihime"},{"spoiler":false,"text":"种族：人鱼"},{"spoiler":false,"text":"能力：在水中就能增强实力程度的能力"},{"spoiler":false,"text":"稳重派的淡水人鱼。"},{"spoiler":false,"text":"平常就是唱唱歌、拣拣石头过着平稳生活的妖怪。"},{"spoiler":false,"text":"对人类也没有任何敌对心理。"},{"spoiler":false,"text":"这次因为被万宝槌魔力影响，正当她变得慷慨激昂之时就被"},{"spoiler":false,"text":"灵梦等人狠狠教训了一顿。"},{"spoiler":false,"text":"如今又再度变得温顺了。"}],"source":"bangumi","sourceCharacterId":"20994"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"20994","value":"人鱼"},{"label":"能力","source":"bangumi","sourceCharacterId":"20994","value":"在水中就能增强实力程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/8810ed7b45e07cd45f8f02d9a0e7539cbced4a8745ba0f128b2a40b58daab9df.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2aca2eed7a9e973e5c3e77df02dcf1010b2db77c9faa3b8b56c9caa2b0db4b5.webp","width":194,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_20995","characterName":"辘轳首的怪奇","sourceIds":{"bangumi":[{"characterId":"20995","match":"source-roster","subjectId":"104009"},{"characterId":"20995","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"辘轳首的怪奇","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"TH14 2面BOSS　　辘轳首的怪奇"},{"spoiler":false,"text":"赤蛮奇"},{"spoiler":false,"text":"Sekibanki"},{"spoiler":false,"text":"种族：辘轳首"},{"spoiler":false,"text":"能力：让头飞出去程度的能力"},{"spoiler":false,"text":"在村落里混在人类当中生活的妖怪。"},{"spoiler":false,"text":"因为能让头飞出去所以在很多时候十分方便。"},{"spoiler":false,"text":"性格方面自尊心有点高，与人类和妖怪都没法打成一片。"},{"spoiler":false,"text":"总给人一种高高在上的感觉。"},{"spoiler":false,"text":"今年夏天，在人类的村落里由宗教家们所发起的祭典也闹了好一阵子，"},{"spoiler":false,"text":"就在人类和妖怪都欢欣雀跃之时，她却对那些流行文化抱着否定的"},{"spoiler":false,"text":"态度，一个人独自生活着。"},{"spoiler":false,"text":"因为被万宝槌的魔力所影响，正当她洋洋自得时就被灵梦等人狠狠"},{"spoiler":false,"text":"教训了一顿。"},{"spoiler":false,"text":"如今又再度变得温顺了。"}],"source":"bangumi","sourceCharacterId":"20995"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"20995","value":"辘轳首"},{"label":"能力","source":"bangumi","sourceCharacterId":"20995","value":"让头飞出去程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20288632d440ca8bbab7ccb99ce867b38699bedc46f30fc3220554663fdff6c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41b458f4194520856da9fe91647ccf5d7160a3425babf0a0404d7e94d72dd1ca.webp","width":131,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_20996","characterName":"竹林的狼人","sourceIds":{"bangumi":[{"characterId":"20996","match":"source-roster","subjectId":"104009"},{"characterId":"20996","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"竹林的狼人","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"TH14 3面BOSS　　竹林的狼人"},{"spoiler":false,"text":"今泉 影狼"},{"spoiler":false,"text":"Imaizumi Kagerou"},{"spoiler":false,"text":"种族：狼女"},{"spoiler":false,"text":"能力：在满月之夜变身成狼程度的能力"},{"spoiler":false,"text":"本人性格非常沉稳。"},{"spoiler":false,"text":"沉稳到即使变身为狼也一样不会丧失冷静。"},{"spoiler":false,"text":"不知是不是因为月人在迷途的竹林里住下的缘故，"},{"spoiler":false,"text":"那里与月亮相关的妖怪似乎很多。"},{"spoiler":false,"text":"而她也是其中一员。"},{"spoiler":false,"text":"顺便一提，她是在外面的世界已经绝种的日本狼的狼女。"},{"spoiler":false,"text":"因为比较在意满月之夜的时候全身体毛会变多"},{"spoiler":false,"text":"所以平常都遮住皮肤，一个人静静的生活。"},{"spoiler":false,"text":"因为被万宝槌的魔力所影响，正当她变得凶暴之时就被灵梦等人"},{"spoiler":false,"text":"狠狠的教训了一顿。"},{"spoiler":false,"text":"如今又再度变得温顺了。"}],"source":"bangumi","sourceCharacterId":"20996"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"20996","value":"狼女"},{"label":"能力","source":"bangumi","sourceCharacterId":"20996","value":"在满月之夜变身成狼程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2d08d45f8cb6353a8bc049550412ae54b58de4f5c43d9d14b0a3a3bd183a09c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6ff26a535504eeae42623252a6c072681cf8d590f205993e9b3b3e2cf981433c.webp","width":162,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_21001","characterName":"古琵琶的付丧神","sourceIds":{"bangumi":[{"characterId":"21001","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"古琵琶的付丧神","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"TH14 4面boss"},{"spoiler":false,"text":"古琵琶的付丧神"},{"spoiler":false,"text":"九十九 弁弁"},{"spoiler":false,"text":"Tsukumo Benben"},{"spoiler":false,"text":"古琴的付丧神"},{"spoiler":false,"text":"九十九 八桥"},{"spoiler":false,"text":"Tsukumo Yatsuhashi"},{"spoiler":false,"text":"种族：付丧神"},{"spoiler":false,"text":"能力：能够自己发出声音进行演奏程度的能力"},{"spoiler":false,"text":"各自都是传统乐器的付丧神。"},{"spoiler":false,"text":"扮演冷静成熟的姐姐角色的弁弁和扮演争强好胜却少根筋的妹妹角色的八桥。"},{"spoiler":false,"text":"二人虽然都以姐妹相称，但其实只是因为她们是在同一时期成为付丧神而并无血缘关系。"},{"spoiler":false,"text":"她们意识到，自身的力量之源来自于空中出现的那座逆城，于是便朝着那里前进。"},{"spoiler":false,"text":"她们俩的目的是让道具征服世界。也就是常说的下克上。"},{"spoiler":false,"text":"她们的梦想是要实现一个道具能够自由行动，能够毫无遗憾的发挥全部力量的理想乡。"},{"spoiler":false,"text":"但她们的梦想却受到了灵梦等人的阻挠。"},{"spoiler":false,"text":"但她们并没有因此而放弃。"},{"spoiler":false,"text":"后来她们发现自己的那些想法是因为受到了万宝槌魔力的影响，于是她们便开始尝试"},{"spoiler":false,"text":"其他可以把自己的力量置换成魔力的咒法。"}],"source":"bangumi","sourceCharacterId":"21001"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"21001","value":"付丧神"},{"label":"能力","source":"bangumi","sourceCharacterId":"21001","value":"能够自己发出声音进行演奏程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22cebd6be098d40befe25311e809d2cefd52413966734c2f43d89fe4c49ecfd0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/126c7a5058c4e5a9c5086a17c98307a8f1500be45d39c248e5e6991ba034297b.webp","width":167,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_21002","characterName":"古琴的付丧神","sourceIds":{"bangumi":[{"characterId":"21002","match":"source-roster","subjectId":"104009"},{"characterId":"21002","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"古琴的付丧神","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"TH14 4面boss"},{"spoiler":false,"text":"古琵琶的付丧神"},{"spoiler":false,"text":"九十九 弁弁"},{"spoiler":false,"text":"Tsukumo Benben"},{"spoiler":false,"text":"古琴的付丧神"},{"spoiler":false,"text":"九十九 八桥"},{"spoiler":false,"text":"Tsukumo Yatsuhashi"},{"spoiler":false,"text":"种族：付丧神"},{"spoiler":false,"text":"能力：能够自己发出声音进行演奏程度的能力"},{"spoiler":false,"text":"各自都是传统乐器的付丧神。"},{"spoiler":false,"text":"扮演冷静成熟的姐姐角色的弁弁和扮演争强好胜却少根筋的妹妹角色的八桥。"},{"spoiler":false,"text":"二人虽然都以姐妹相称，但其实只是因为她们是在同一时期成为付丧神而并无血缘关系。"},{"spoiler":false,"text":"她们意识到，自身的力量之源来自于空中出现的那座逆城，于是便朝着那里前进。"},{"spoiler":false,"text":"她们俩的目的是让道具征服世界。也就是常说的下克上。"},{"spoiler":false,"text":"她们的梦想是要实现一个道具能够自由行动，能够毫无遗憾的发挥全部力量的理想乡。"},{"spoiler":false,"text":"但她们的梦想却受到了灵梦等人的阻挠。"},{"spoiler":false,"text":"但她们并没有因此而放弃。"},{"spoiler":false,"text":"后来她们发现自己的那些想法是因为受到了万宝槌魔力的影响，于是她们便开始尝试"},{"spoiler":false,"text":"其他可以把自己的力量置换成魔力的咒法。"}],"source":"bangumi","sourceCharacterId":"21002"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"21002","value":"付丧神"},{"label":"能力","source":"bangumi","sourceCharacterId":"21002","value":"能够自己发出声音进行演奏程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa2d2f82622754ced053281bad28d3f820841014097342790f872ea52b494ac3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78b2a1663c7f44b952d5a4cc0bb7cd47d5b916784a111eb3316e98d713bb1755.webp","width":227,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_21003","characterName":"逆袭的天邪鬼","sourceIds":{"bangumi":[{"characterId":"21003","match":"source-roster","subjectId":"104009"},{"characterId":"21003","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"逆袭的天邪鬼","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"TH14 5面boss"},{"spoiler":false,"text":"鬼人 正邪"},{"spoiler":false,"text":"Kijin Seija"},{"spoiler":false,"text":"种族：天邪鬼"},{"spoiler":false,"text":"能力：能让任何事物都翻转过来程度的能力"},{"spoiler":false,"text":"企图下克上的天邪鬼。"},{"spoiler":false,"text":"天邪鬼不属于鬼，只是一种性格扭曲的妖怪。"},{"spoiler":false,"text":"她一天到晚脑子里总想着和其他人相反的事情。"},{"spoiler":false,"text":"别人一反感她就高兴，看到别人一高兴她就开始心生厌恶。"},{"spoiler":false,"text":"绝对不服从命令。就算自己赚了也绝不会把别人应得的给对方。"},{"spoiler":false,"text":"这样的家伙当然会被人类、妖怪双方都厌恶，但别人越是讨厌她自然就越高兴。"},{"spoiler":false,"text":"而她的野心就是把幻想乡整个翻转过来。"},{"spoiler":false,"text":"毁掉如今这个由强者稳定支配的幻想乡，把这里变成一个由弱者说了算"},{"spoiler":false,"text":"的世界。"},{"spoiler":false,"text":"只是，她没有能够实现这个梦想的力量。"},{"spoiler":false,"text":"因此她就盯上了小人手上的秘宝『万宝槌』。"}],"source":"bangumi","sourceCharacterId":"21003"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"21003","value":"天邪鬼"},{"label":"能力","source":"bangumi","sourceCharacterId":"21003","value":"能让任何事物都翻转过来程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5ed5c080d839cf66ca8bdb6fdf8d7fc53a03fd359224fb0b75993649c43a10cc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fac7314156068a83b03682b5ffed88e6147b7eb62c1379139675a0ae6abb94f8.webp","width":138,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_21004","characterName":"小人的末裔","sourceIds":{"bangumi":[{"characterId":"21004","match":"source-roster","subjectId":"104009"},{"characterId":"21004","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"小人的末裔","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"她是一寸法师的末裔。"},{"spoiler":false,"text":"因此能够使用万宝槌。"},{"spoiler":false,"text":"初代的一寸法师治退了鬼，得到了鬼的秘宝『万宝槌』。"},{"spoiler":false,"text":"初代获得了长大的身体和公主这些事都如同传说中所说的一样。"},{"spoiler":false,"text":"除此以外再也没有使用过万宝槌。"},{"spoiler":false,"text":"因为万宝槌是鬼的法宝，由此引发的奇迹也同样来自鬼的魔力。"},{"spoiler":false,"text":"若是随便使用必招来杀身之祸，这就是初代当时的想法。"},{"spoiler":false,"text":"但是，随着时代的推移一寸法师的信念逐渐被人遗忘。"},{"spoiler":false,"text":"然后有一天发生了这样的事件。"},{"spoiler":false,"text":"分明手上就有着能够实现任何愿望的万宝槌，但却不能使用它这叫什么事情啊。"},{"spoiler":false,"text":"就这样末裔中的一人，终于打破了祖先的禁忌。"},{"spoiler":false,"text":"他用小槌的魔力穷奢极欲，终于说出了最后的愿望。"},{"spoiler":false,"text":"「我要建起一座豪华的城来统治人民」"},{"spoiler":false,"text":"一瞬间，那座名为辉针城的城就这样出现，而万宝槌的魔力也因此耗尽。"},{"spoiler":false,"text":"然后，悲剧就这样发生了。"},{"spoiler":false,"text":"辉针城整个逆转，城池连同小人族一起被幽闭在了鬼的世界里。"},{"spoiler":false,"text":"在那个世界里，没有可供其统治的人民……。"},{"spoiler":false,"text":"从那以后，小人族就再也不为人类所知。"},{"spoiler":false,"text":"万宝槌是鬼的法宝。"},{"spoiler":false,"text":"实现愿望的同时，必会给予其同等的代价。"},{"spoiler":false,"text":"过于巨大的愿望，其代价可能会在愿望本身实现之前就显现。"},{"spoiler":false,"text":"小人族明白了这个道理。"},{"spoiler":false,"text":"然后再次封印了万宝槌。"}],"source":"bangumi","sourceCharacterId":"21004"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"21004","value":"小人"},{"label":"能力","source":"bangumi","sourceCharacterId":"21004","value":"能够使用万宝槌程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f16ba1a179bda0b357f649873f5e9937d4f6a7f8a209aadfb14f8a99097fdde.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/872ae57434677e702a0ea8914d8ff6ce9302f1739df7a271458a92f98ad248cd.webp","width":251,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_21005","characterName":"梦幻的打击乐手","sourceIds":{"bangumi":[{"characterId":"21005","match":"source-roster","subjectId":"104009"},{"characterId":"21005","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"梦幻的打击乐手","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"TH14 EX面boss"},{"spoiler":false,"text":"堀川 雷鼓"},{"spoiler":false,"text":"Horikawa Raiko"},{"spoiler":false,"text":"种族：付丧神"},{"spoiler":false,"text":"能力：什么都能配合上节奏程度的能力"},{"spoiler":false,"text":"她是和太鼓的付丧神。"},{"spoiler":false,"text":"在被人类敲击当中产生喜悦，生存至今。"},{"spoiler":false,"text":"但是，突然在身体中感受到了强烈的魔力。"},{"spoiler":false,"text":"同时心中也涌现出了凶暴的情感。"},{"spoiler":false,"text":"现在，正是道具们复仇之时。"},{"spoiler":false,"text":"但聪明的她，很快就发现那似乎是因为受到鬼的魔力（万宝槌的魔力）"},{"spoiler":false,"text":"影响造成的。"},{"spoiler":false,"text":"她感觉到，这样下去的话会遭其控制。"},{"spoiler":false,"text":"此时她下了一个巨大的赌注。"},{"spoiler":false,"text":"她舍弃了作为自己身体的和太鼓，与作为魔力之源的太鼓演奏者，"},{"spoiler":false,"text":"去寻求新的魔力。而且还是在禁止进入的外面世界。"},{"spoiler":false,"text":"终于，她得到了新的鼓和演奏者。"},{"spoiler":false,"text":"这毫无疑问，是外界的魔力。"},{"spoiler":false,"text":"身体当中已经不再残留有鬼的魔力。"},{"spoiler":false,"text":"这样一来即便万宝槌进入魔力的回收期，也不会再变回一般的道具了。"},{"spoiler":false,"text":"于是她开始向自己周围的付丧神们到处传授这个办法。"},{"spoiler":false,"text":"道具也是想以自己的意志享乐的！"},{"spoiler":false,"text":"没错，来构筑一个属于道具的乐园吧！"}],"source":"bangumi","sourceCharacterId":"21005"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"21005","value":"付丧神"},{"label":"能力","source":"bangumi","sourceCharacterId":"21005","value":"什么都能配合上节奏程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0bd434ae313f6bd65ab5d42be251a113681767750112e7014b3bb88da5c0541c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6f9cf6475a27bbbeab691b05ab5fba43ecb04b31ed77cf64c9dd843e61bb1b5.webp","width":205,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_485","characterName":"博麗靈夢","sourceIds":{"bangumi":[{"characterId":"485","match":"source-roster","subjectId":"104009"},{"characterId":"485","match":"source-roster","subjectId":"1146"},{"characterId":"485","match":"source-roster","subjectId":"1148"},{"characterId":"485","match":"source-roster","subjectId":"1150"},{"characterId":"485","match":"source-roster","subjectId":"1151"},{"characterId":"485","match":"source-roster","subjectId":"1153"},{"characterId":"485","match":"source-roster","subjectId":"1155"},{"characterId":"485","match":"source-roster","subjectId":"1157"},{"characterId":"485","match":"source-roster","subjectId":"1160"},{"characterId":"485","match":"source-roster","subjectId":"12696"},{"characterId":"485","match":"source-roster","subjectId":"131875"},{"characterId":"485","match":"source-roster","subjectId":"1395"},{"characterId":"485","match":"source-roster","subjectId":"2134"},{"characterId":"485","match":"source-roster","subjectId":"329342"},{"characterId":"485","match":"source-roster","subjectId":"430567"},{"characterId":"485","match":"source-roster","subjectId":"5752"},{"characterId":"485","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"博麗靈夢","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幻想乡境内博丽神社的现有巫女。"},{"spoiler":false,"text":"博丽神社是专门守护幻想乡不可缺少的大结界的神社。博丽的巫女代代以解决异变为事业。"},{"spoiler":false,"text":"她是历代巫女中最缺乏危机感的一位，不知是因为修行不足，还是因为已经拥有足够的实力。"},{"spoiler":false,"text":"她天生地幸运和敏锐，也退治了不少妖怪。"}],"source":"bangumi","sourceCharacterId":"485"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"485","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"主要是在空中飞行的程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"作为博丽巫女的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"在空中飞行的程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"操纵灵气的程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f33007c417ade7c73b7ee78244285c2ff601da86919605a6f56c0570deb01c0c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc26d83763ce8144e0a342eaeb5a41bf3e1756ec782d0268170ef9bac39c8489.webp","width":237,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_486","characterName":"霧雨魔理沙","sourceIds":{"bangumi":[{"characterId":"486","match":"source-roster","subjectId":"104009"},{"characterId":"486","match":"source-roster","subjectId":"1146"},{"characterId":"486","match":"source-roster","subjectId":"1148"},{"characterId":"486","match":"source-roster","subjectId":"1150"},{"characterId":"486","match":"source-roster","subjectId":"1151"},{"characterId":"486","match":"source-roster","subjectId":"1153"},{"characterId":"486","match":"source-roster","subjectId":"1155"},{"characterId":"486","match":"source-roster","subjectId":"1157"},{"characterId":"486","match":"source-roster","subjectId":"1160"},{"characterId":"486","match":"source-roster","subjectId":"12696"},{"characterId":"486","match":"source-roster","subjectId":"131875"},{"characterId":"486","match":"source-roster","subjectId":"1395"},{"characterId":"486","match":"source-roster","subjectId":"2134"},{"characterId":"486","match":"source-roster","subjectId":"329342"},{"characterId":"486","match":"source-roster","subjectId":"430567"},{"characterId":"486","match":"source-roster","subjectId":"5752"},{"characterId":"486","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"霧雨魔理沙","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"居住于魔法森林的人类魔法使，常骑着扫把，「霧雨店」的独生女。會使用魔法森林的蘑菇調製火藥，所使用的魔法幾乎只有把東西破壞的效果，而且燃料需要長時間準備，但是其效果非常強力，在Spell Card規則成立下，純粹的破壞力在人類當中屬於最高等級。此外在幻想乡是出了名的小偷，帕邱莉的图书馆、香霖堂，如果不是古明地觉会读心术，甚至连地灵殿都会惨遭毒手。"}],"source":"bangumi","sourceCharacterId":"486"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"486","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"486","value":"使用魔法程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e00e4df671f5f80d5733c44e4b69596b901aad88177fc335789c2dd5ea6b2d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3bd6c6ab5c1df20f216ccf8f7e1581841d4fed04fe2cad0f92ce726df7fb8d1.webp","width":237,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_890","characterName":"湖上的冰精","sourceIds":{"bangumi":[{"characterId":"890","match":"source-roster","subjectId":"104009"},{"characterId":"890","match":"source-roster","subjectId":"1146"},{"characterId":"890","match":"source-roster","subjectId":"1150"},{"characterId":"890","match":"source-roster","subjectId":"2134"},{"characterId":"890","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"湖上的冰精","characterNameSource":null,"role":"客串","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"在雾之湖的附近，即使是夏天也会出现极端低温。这时候常能遇到的妖精就是冰之妖精。"},{"spoiler":false,"text":"她是湖附近妖精们中的领袖般的存在，力量也比其他妖精强。她是属于好战型的，所以必须留神。"},{"spoiler":false,"text":"她身高颇低，穿蓝色的衣服，背后有冰之羽翼。"},{"spoiler":false,"text":"她有操控冷气的能力。能瞬间冻结小东西，比普通的妖精更危险。一直在释放冷气的她周围总是很寒冷。"},{"spoiler":false,"text":"人们不知道她住在哪里，也无法得知她平时的生活是怎样的。不光是琪露诺，所有的妖精都能溶入大自然之中，所以人类们看不见。"}],"source":"bangumi","sourceCharacterId":"890"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"890","value":"妖精"},{"label":"能力","source":"bangumi","sourceCharacterId":"890","value":"操控冷气程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25af4f6889a331e39b0794d719a1f9518b4db2435d771266f0facafae6918544.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bbae3be8cbaf201d20a01a4252681feb495db0eacefea46e8410e4782bb64341.webp","width":180,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:997","sourceCompanyId":"egs:brand:997","canonicalEntityId":"egs:brand:997","name":"上海アリス幻樂団","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:23795:997","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","egs-creator-credit-missing","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
