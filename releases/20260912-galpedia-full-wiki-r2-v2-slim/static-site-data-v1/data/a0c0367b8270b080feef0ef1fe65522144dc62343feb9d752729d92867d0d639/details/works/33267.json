ntityStatus":"source-native","relationId":"vndb:vn-staff:126665","source":"vndb"},{"creditedName":"Badriel","creatorId":"vndb:s1838","sourcePersonId":"vndb:s1838","canonicalEntityId":"vndb:s1838","name":"Badriel","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:126667","source":"vndb"},{"creditedName":"Inma","creatorId":"vndb:s8024","sourcePersonId":"vndb:s8024","canonicalEntityId":"vndb:s8024","name":"Inma Ruiz","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:126671","source":"vndb"},{"creditedName":"Joshua \"Ryechu\" Renner","creatorId":"vndb:s10391","sourcePersonId":"vndb:s10391","canonicalEntityId":"vndb:s10391","name":"Joshua \"Ryechu\" Renner","roleCode":"editor","roleLabel":"编辑","identityStatus":"source-native","relationId":"vndb:vn-staff:126672","source":"vndb"},{"creditedName":"Joshua \"Ryechu\" Renner","creatorId":"vndb:s10391","sourcePersonId":"vndb:s10391","canonicalEntityId":"vndb:s10391","name":"Joshua \"Ryechu\" Renner","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:126673","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c41771","characterName":"Itsumi","sourceIds":{"vndbCharacterId":"c41771"},"originalCharacterName":"Itsumi","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Koji’s childhood friend that moved away after middle school. She always really liked Koji, and wished that she could be with him again. By chance, the two end up meeting in the shopping district, and Koji doesn’t recognize the now much more mature girl. She is typically very blunt, and even more shameless when it comes to her job at the cafe."},{"spoiler":false,"text":"Will Koji finally realize his feelings for his best friend from middle school, or will he crack under the pressure of working in the fast-paced food business?"},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c41771"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0bcc558510a78ef2bdf159bf996cd16aba578df2a9fe524f6cd1acb52f76e66f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78266b8c3bfc9f92e2bc6dee4ebb444e7ce72580bb92da62a06ad6bb4e9e04e3.webp","width":216,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c41772","characterName":"Akina","sourceIds":{"vndbCharacterId":"c41772"},"originalCharacterName":"Akina","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A fox spirit at a local shrine. Thanks to the vague wish Koji made about wanting a friend, she is able to show herself to him. After witnessing Koji do something nice for no other reason than because he wanted to, she offers to be his friend, and immediately asks him out on a date!"},{"spoiler":false,"text":"She is a very cheeky girl who loves to tease Koji at every opportunity. Will he fall for her shenanigans, or will the spirit world get in their way?"},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c41772"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6de3c6367e707dcfd883f3903c853eff94bbcf96b7e1a977c690325882389af0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68605576e6ec0e892e04c2fb39e4d9b849ba0207a64040a6bfce725cee881a42.webp","width":216,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c41773","characterName":"Santa","sourceIds":{"vndbCharacterId":"c41773"},"originalCharacterName":"Santa","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the many daughters of the big man in the red suit, Santa is a naive, clumsy girl who loves to make toys for all the good little girls and boys. She meets Koji by accident, and after helping her find her \"wand,\" she offers to be Koji’s friend. Wielding Christmas magic, Santa can turn something dull into something fantastic."},{"spoiler":false,"text":"Will Koji believe in the Christmas spirit enough to meet the big man himself? Only time will tell!"},{"spoiler":false,"text":"From MangaGamer"}],"source":"vndb","sourceCharacterId":"c41773"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b6331894ed06271b1eba5b91ce06033d250244039ca53fc2f15b33908960701.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/6626517f6235d7372a7d6ba4de65ae2f169297a724702bbdad521a5ef42831ca.webp","width":216,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c41774","characterName":"Koji","sourceIds":{"vndbCharacterId":"c41774"},"originalCharacterName":"Koji","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p4019","sourceCompanyId":"egs:brand:4611","canonicalEntityId":"vndb:p4019","name":"Winged Cloud","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:33267:4611","source