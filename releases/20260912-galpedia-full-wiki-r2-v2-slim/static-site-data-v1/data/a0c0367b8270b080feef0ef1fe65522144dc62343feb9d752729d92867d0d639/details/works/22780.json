","sourceIds":{"bangumi":[{"characterId":"118209","match":"source-roster","subjectId":"170015"}]},"originalCharacterName":"ギルド","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"謎の青年"},{"spoiler":false,"text":"物語の全般で、主人公へ様々な助言をしてくれる知識人。かなりの情報通で、様々な人脈がありそうな兄貴分に見えるものの、その正体は不明。"},{"spoiler":false,"text":"主人公シャーロットは彼の情報に助けられ、歴史の表舞台で活躍します。"}],"source":"bangumi","sourceCharacterId":"118209"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/0443498527cfa35fd6416e7184d0734cf39c7b85c92b8638829bb0876a4ca37a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4bcb2797efb4f08070f7c759dcc2353ad2d25ebe6d45fa9010e723060805f6e.webp","width":103,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_118210","characterName":"エドワード王太子","sourceIds":{"bangumi":[{"characterId":"118210","match":"source-roster","subjectId":"170015"}]},"originalCharacterName":"エドワード王太子","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ランカスター家の貴公子"},{"spoiler":false,"text":"イングランド王ヘンリー６世の跡継ぎとして、幼い頃より英才教育を受けてきた王太子。"},{"spoiler":false,"text":"母親である王妃マーガレットの影響を強く受けており、百年戦争でフランスに奪われた失地回復を強く願っています。"}],"source":"bangumi","sourceCharacterId":"118210"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d90251c73e0470f8a00e39f5eaaff12fd65740ea541cd0c9305e7e4ddc67cd07.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2ad2397ba0dd953203e29a4e