ers/v1/images/8a/8a69d27580f6ccbaea071472291698776f8471111ada8054510f3e534bb7828b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/3918a74ea07593182d35b2ec0a709109babcc3f50315bb14c5dc39980a7088b6.webp","width":103,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_118213","characterName":"クラレンス公","sourceIds":{"bangumi":[{"characterId":"118213","match":"source-roster","subjectId":"170015"}]},"originalCharacterName":"クラレンス公","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"他人の話を聞かない俺様王子"},{"spoiler":false,"text":"父ヨーク公リチャードや兄のマーチ伯を尊敬し、兄に負けないだけの武功を立てる事に執着する自信家。"},{"spoiler":false,"text":"周囲をよく観察して動向を考察するものの、他人の話を聞かない性格が災いし、ついつい敵を作ってしまいます。"}],"source":"bangumi","sourceCharacterId":"118213"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/732ce98ea6af9efd106f7b56b061d7c43ad7d9bcb46ede4ebc9f52a5d50b6268.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da703dd54d759f99ef018ceb782273f683ead53ec1ff4f6f1feae3102a747655.webp","width":103,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_118214","characterName":"ジョン・クリフォード","sourceIds":{"bangumi":[{"characterId":"118214","match":"source-roster","subjectId":"170015"}]},"originalCharacterName":"ジョン・クリフォード","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"忠義の隻眼騎士"},{"spoiler":false,"text":"イングランド王に忠誠を誓う貴族。"},{"spoiler":false,"text":"戦争で父親をヨーク公リチャードに殺された事から、ヨーク派への復讐心が強く、戦場では中心的な役割を担う激昂家。しかし、普段は森の小さな動物たちに優しい一面も持っています。"}],"source":"bangumi","sourceCharacterId":"118214"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ac/acfa2153603cab3a2a6ddced8640411c2a917292c68896cb8f20fd741b1a43f5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c31fc3d8c9611539188088788a27cbad90ae8d52172357ccae453a99517e104.webp","width":103,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_118215","characterName":"リチャード・ネヴィル","sourceIds":{"bangumi":[{"characterId":"118215","match":"source-roster","subjectId":"170015"}]},"originalCharacterName":"リチャード・ネヴィル","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"稀代のカリスマ演説家"},{"spoiler":false,"text":"ヨーク公リチャードとは共に戦ってきた盟友で、商工業が発達しているフランドル地方との関係強化を望み、ヨーク家を支え続ける頭脳派貴族。"},{"spoiler":false,"text":"巧みな演説から民衆に人気が高いものの、敵からは口先だけと疎まれています。"}],"source":"bangumi","sourceCharacterId":"118215"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c5928c8d6a333aee72331d2e46489b0f95f01ad958b4f5e5234040407aa91aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a721e269836ec739f62545f793e7d1054f459f0d0b2dee547169bf0b152b60ba.webp","width":103,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_118216","characterName":"ヘンリー６世","sourceIds":{"bangumi":[{"characterId":"118216","match":"source-roster","subjectId":"170015"}]},"originalCharacterName":"ヘンリー６世","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"生まれながらのイングランド王"},{"spoiler":false,"text":"百年戦争の経緯により、生後間もなくフランス王となったイングランド王。"},{"spoiler":false,"text":"しかしその後の戦いで負け続けて、多くの領土を失ってしまい、フランスのアンジューから嫁いできた王妃マーガレットの信頼を失ってしまいます。"}],"source":"bangumi","sourceCharacterId":"118216"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46e3645ddb405a820fa88f28788271721781ff99f387e62f019ce505fdb9c2ec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/95f88e372b8ec839077b0395fa8d1ecc0dbd59f5a9e9f066ca08fd6a99526af4.webp","width":103,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_118217","characterName":"ヨーク公リチャード","sourceIds":{"bangumi":[{"characterId":"118217","match":"source-roster","subjectId":"170015"}]},"originalCharacterName":"ヨーク公リチャード","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"血統の良い歴戦の勇士"},{"spoiler":false,"text":"父方はエドワード３世の五男ヨーク公の家系、母方はエドワード３世の三男クラレンス公の家系という血統高き歴戦の勇士。"},{"spoiler":false,"text":"汚職蔓延る国内の状況に憂い、清らかな政治を願う姿勢から王妃マーガレットと対立しています。"}],"source":"bangumi","sourceCharacterId":"118217"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b324d02358b3f0dface4682b94c4ce0b377f06d0fa0dc38cb017004c0b9aec76.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20b35b6de9b0d27ce77f87586d27d2dc1ebe9827c1f5ec6df51e3db1b53652c4.webp","width":103,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_118218","characterName":"マーガレットオブアンジュー","sourceIds":{"bangumi":[{"characterId":"118218","match":"source-roster","subjectId":"170015"}]},"originalCharacterName":"マーガレットオブアンジュー","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"フランス出身の気品高き王妃"},{"spoiler":false,"text":"フランスのアンジューから、遥々嫁いできたイングランド王妃。"},{"spoiler":false,"text":"古のフランク王国の継承を息子であるエドワード王太子に託し、頼りにならないヘンリー６世に代わって派閥を形成する事から、ヨーク派と対立しています。"}],"source":"bangumi","sourceCharacterId":"118218"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54a0c632489aab1f6935b735868d587a41162abd7110be62ba6aa10c597db620.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/dfa4100588d1aadae2e7dd33aa38b70273ac4ca9f34123e9c182cdf375387202.webp","width":103,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_118219","characterName":"トム","sourceIds":{"bangumi":[{"characterId":"118219","match":"source-roster","subjectId":"170015"}]},"originalCharacterName":"トム","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ランカスター親衛隊"},{"spoiler":false,"text":"戦争孤児だったがペンブルック伯に養育され、一緒にロンドンに出てきてランカスター家の王太子に仕える親衛隊員となりました。"},{"spoiler":false,"text":"ペンブルックを伯父と呼び慕っています。ヘンリー(リッチモンド伯)、ノアと共に幼少期を育ち、ノアには恋心を抱いています。"}],"source":"bangumi","sourceCharacterId":"118219"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea520fdc5e4c57175b492b5a6c82b491dc0f4908d7ad7e3f52cc3c7136000187.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba47092d67ad4a3ec2a504da8abddb22223dbba6ab9380e530a27d875870fc70.webp","width":103,"height":256,"source":"static-detail"},"acto