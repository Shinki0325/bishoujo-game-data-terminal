体は女らしく成長している。"}],"source":"egs","sourceCharacterId":"18553","sourceWorkId":"10607","spoiler":false},{"segments":[{"spoiler":false,"text":"学園2年生"},{"spoiler":false,"text":"実家は地方の資産家。"},{"spoiler":false,"text":"本人は格式ばった家が好きではなく男子とつるんでいたのでお嬢様らしさがかけている。"},{"spoiler":false,"text":"水泳部に所属していて地区大会でトップを取れるほどの実力を持っている。"},{"spoiler":false,"text":"内面で女らしさが欠ける反面、身体の方はすっかり女らしく成長している。"}],"source":"bangumi","sourceCharacterId":"199519"}],"profileFacts":[{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"18553","sourceWorkId":"10607","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"18553","sourceWorkId":"10607","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"18553","sourceWorkId":"10607","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"18553","sourceWorkId":"10607","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e9b14208b8522c8a09332707b205160a61318a66b0e661977e80fdfc2e1e693.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2bc17cf75838ddbbf81075bac6f6ac218ab8c18c428c53cfac08327e68eab2d.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あえか","creatorId":"vndb:s9085","sourcePersonId":"vndb:s9085","canonicalEntityId":"vndb:s9085","name":"あえか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:15090","source":"vndb"}]},{"characterId":"char_c71948","characterName":"水原 花梨","sourceIds":{"bangumi":[{"characterId":"199520","match":"exact-normalized-name-in-linked-work","subjectId":"224160"}],"egsCharacterIds":["18554"],"vndbCharacterId":"c71948"},"originalCharacterName":"水原 花梨","characte