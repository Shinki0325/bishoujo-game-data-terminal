dbCharacterId":"c14000"},"originalCharacterName":"ファイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"20"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1116"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Phi is a player in the Nonary Game: Ambidex Edition. She first appears in the Elevator along with Sigma and seems to know him, or at least his name. She like everyone else was kidnapped after a cloud of white smoke engulfed her knocking her out, forcing her to participate in the Nonary Game."},{"spoiler":false,"text":"Generally Phi is rather cold, methodical, and not to mention curt. She does not trust everyone and is willing to betray others to preserve herself. Phi possesses a vast amount of intelligence including philosophical topics such as Shrödinger's Cat and even basic Latin words and phrases."},{"spoiler":false,"text":"From Zero Escape Wiki"}],"source":"vndb","sourceCharacterId":"c14000"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2ffcf1910dcb065d4163cd20488ed20f05adbb5abca848f942a95f1655c5368a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4085e55946e3024dbe72ecf9bd8bb762364a920284092b5f66b3ba851233be0.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小見川 千明","creatorId":"vndb:s8797","sourcePersonId":"vndb:s8797","canonicalEntityId":"vndb:s8797","name":"小見川 千明","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41535","source":"vndb"},{"creditedName":"Karen Strassman","creatorId":"vndb:s10073","sourcePersonId":"vndb:s10073","canonicalEntityId":"vndb:s10073","name":"Karen Strassman","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41542","source":"vndb"}]},{"characterId":"char_vndb_c14003","characterName":"シグマ・クライム","sourceIds":{"vndbCharacterId":"c14003"},"originalCharacterName":"シグマ・クライム","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sigma is the protagonist of Zero Escape: Virtue's Last Reward. He is an ordinary college student who has been abducted and thrown into the Nonary Game. Sigma is a generally kind, honest young man, although he can be a little inappropriate at times. He’s easily swayed by his emotions, which makes him a poor choice for a game about trust and betrayal."},{"spoiler":false,"text":"Edited from Zero Escape Wiki"}],"source":"vndb","sourceCharacterId":"c14003"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc5ffe08c5ae87b679816b42f089b323d31d8995b5b88e86c9b1836f2ae739cb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e25d471cf0bbf7aee5e6c7883163eab0628eb38b67c6323b6921006529634e0.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c14006","characterName":"ルナ","sourceIds":{"vndbCharacterId":"c14006"},"originalCharacterName":"ルナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Luna is a kind and quietly intelligent young woman. She speaks softly, and always advocates for the most peaceful, optimistic solution. She is extremely soft spoken and rarely gets angered. She also has a medical license and can operate medical machinery."},{"spoiler":true,"text":"She is actually a GAULEM, a type of android, whose AI is based on Diana."},{"spoiler":false,"text":"Edited from Zero Escape Wiki"}],"source":"vndb","sourceCharacterId":"c14006"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5cf785e3dea477882ee990d859f7082724e78f42e3a70304437a4184e6ebe87d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/3656e8349b0ec5607143a89e3f174eb80ca717ef3ef5820f0b4b75a315f10688.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"能登 麻美子","creatorId":"vndb:s468","sourcePersonId":"vndb:s468","canonicalEntityId":"vndb:s468","name":"能登麻美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41531","source":"vndb"},{"creditedName":"Laura Bailey","creatorId":"vndb:s8478","sourcePersonId":"vndb:s8478","canonicalEntityId":"vndb:s8478","name":"Laura Bailey","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41534","source":"vndb"}]},{"characterId":"char_vndb_c17599","characterName":"倉式 茜","sourceIds":{"vndbCharacterId":"c17599"},"originalCharacterName":"倉式 茜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"birthday":{"reviewState":"source-only","source":"vndb","value":"217"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The childhood friend of Junpei. Akane Kurashiki is her actual name, although she chooses the codename June once she accidentally reveals Junpei's name. She is a delicate girl who wants no one to be left behind during the Nonary Game. Her bracelet number is 6, from the month June."},{"spoiler":false,"text":"From Zero Escape Wikia"},{"spoiler":true,"text":"She is actually the true identity of Zero, and the purpose of the Nonary Game she created is to save her 12-year-old self from being burned in an incinerator."}],"source":"vndb","sourceCharacterId":"c17599"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55d7f8ac0259d0a129853cecb1afbed5128c0e864ad8aa0f9fdbf1aa5026ebbe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/176551f296cf9e0e3623900c31a6feaabbb6360702e6a3adfe4dd25caaf8dcf1.webp","width":167,"height":256,"source":"static-detail"},"actors":[{"creditedName":"沢城 みゆき","creatorId":"vndb:s43","sourcePersonId":"vndb:s43","canonicalEntityId":"vndb:s43","name":"沢城 みゆき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41525","source":"vndb"},{"creditedName":"Rena Strober","creatorId":"vndb:s10970","sourcePersonId":"vndb:s10970","canonicalEntityId":"vndb:s10970","name":"Rena Strober","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41550","source":"vndb"},{"creditedName":"Ali Hillis","creatorId":"vndb:s15820","sourcePersonId":"vndb:s15820","canonicalEntityId":"vndb:s15820","name":"Ali Hillis","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41551","source":"vndb"}]},{"characterId":"char_vndb_c17603","characterName":"天明寺","sourceIds":{"vndbCharacterId":"c17603"},"originalCharacterName":"天明寺","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"68"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A stubborn, grumpy old man. He seems to have no patience and less trust for an