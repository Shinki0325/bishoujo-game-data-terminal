st":[{"characterId":"char_c29391","characterName":"美鈴 雪子","sourceIds":{"bangumi":[{"characterId":"43039","match":"exact-normalized-name-in-linked-work","subjectId":"186397"}],"egsCharacterIds":["21065"],"vndbCharacterId":"c29391"},"originalCharacterName":"美鈴 雪子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の通う北野聖風学園の保険医兼、体育教師。"},{"spoiler":false,"text":"しかしてその正体は「全ての毒の御子」と呼ばれるスネークガイスト。"},{"spoiler":false,"text":"北野聖風学園に通う生徒や教師をモルモットにしてガイストを増やそうと暗躍している。"},{"spoiler":false,"text":"御子と呼ばれるガイストの中において彼女は異質な存在。"},{"spoiler":false,"text":"快楽主義者である彼女は、自由気ままに欲望のまま人間社会に溶け込んで暮らしていくことを望んでいるようだ。"}],"source":"egs","sourceCharacterId":"21065","sourceWorkId":"9017","spoiler":false},{"segments":[{"spoiler":false,"text":"北野聖風学園で保険医兼体育教師を兼任する美人先生。"},{"spoiler":false,"text":"実は『全ての毒の御子』と呼ばれるスネークガイスト。"},{"spoiler":false,"text":"北野聖風学園でガイストを増やすべく、あるいは趣味の毒薬を調合してその成果を確かめるべく生徒や教師をモルモットに気付かれぬよう活動している。"},{"spoiler":false,"text":"快楽主義者で刹那主義的なところがあり、御子と呼ばれるガイストの中では変り種で自由気まま欲望のまま人間社会に溶け込んで暮らしてゆくことを望んでいる。"}],"source":"bangumi","sourceCharacterId":"43039"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/212bebaf0426f6fc9b9847e468f97ae16dd18861331c6c5c5d55f6b07ddeb136.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82f037a499d0d78a8d61a32060ad9f20f6be0c1795c53a0dc4ac0eac021c758e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"ももぞの薫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:186397:43039:6131:1","source":"bangumi"}]},{"characterId":"char_vndb_c29390","characterN