aracterName":"北園 千佳","sourceIds":{"bangumi":[{"characterId":"45570","match":"exact-normalized-name-in-linked-work","subjectId":"187478"}],"egsCharacterIds":["10578"],"vndbCharacterId":"c50247"},"originalCharacterName":"北園 千佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Reading, cooking"},{"spoiler":false,"text":"The prominent Kitasono family's refined daughter. She is quite serious about her and Wataru's relationship, but has zero experience with both love and sex. At school, she is an excellent student. She appreciates kindness and honesty more than anything."},{"spoiler":false,"text":"In order to live up to her family and Wataru's expectations, she keeps up a diary about her and Wataru's love activities. Due to her zero experience, she has only read about all kinds of things from girls' magazines she borrowed from her friends. She often tries mimicking the things she learned from them, and sometimes manages to surprise or catch Wataru off his guard."}],"source":"vndb","sourceCharacterId":"c50247"},{"segments":[{"spoiler":false,"text":"名家北園家のお嬢様。"},{"spoiler":false,"text":"学園では主人公・渉以上に優秀な学生だが、どこかズレている。"},{"spoiler":false,"text":"真面目さと家族愛を持つ点に加え、恋愛・性体験がゼロの点が渉との共通項。"},{"spoiler":false,"text":"家族と渉の期待に応えようとして、恋人日記活動を主導する。男女関係の知識がゼロのため、女友達や女性誌などを真に受けて時に過激な行為へ渉を誘う。"},{"spoiler":false,"text":"自分の行為への渉の反応を気にしつつも、その「誠実さ」「思いやり」に惹かれていく。"}],"source":"egs","sourceCharacterId":"10578","sourceWorkId":"23907","spoiler":false},{"segments":[{"spoiler":false,"text":"名家・北園家のお嬢様。"},{"spoiler":false,"text":"学園では渉以上に優秀な学生だが、どこかズレている。"},{"spoiler":false,"text":"渉との共通項は、まじめで家族愛が強い点、そして恋愛・性体験がゼロであること。"},{"spoiler":false,"text":"家族と渉の期待に応えようとして、恋愛日記活動を主導する。"},{"spoiler":false,"text":"男女関係の知識がゼロのため、女友達や女性誌などを真に受けて、時に過激な行為へ渉を誘う。"},{"spoiler":false,"text":"自分の行為への渉の反応を気にしつつも、その“誠実さ” “思いやり”に惹かれていく。"},{"spoiler":false,"text":"「これから結ばれるまで、その間に“本当の恋人”を二人で一緒に目指してみませんか？」"}],"source":"bangumi","sourceCharacterId":"45570"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"45570","value":"後期課程"},{"label":"趣味","source":"bangumi","sourceCharacterId":"45570","value":"読書、料理"},{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"10578","sourceWorkId":"23907","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"10578","sourceWorkId":"23907","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"161 cm","valueContext":null,"source":"egs","sourceCharacterId":"10578","sourceWorkId":"23907","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"10578","sourceWorkId":"23907","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"10578","sourceWorkId":"23907","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"49 kg","valueContext":null,"source":"egs","sourceCharacterId":"10578","sourceWorkId":"23907","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/94cecea686dfae1ad262fefed955013b51592efa7006f63923d2514227345110.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44ce