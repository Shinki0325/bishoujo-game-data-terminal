elationId":"vndb:vn-staff:49265","source":"vndb"}]},"cast":[{"characterId":"char_c57503","characterName":"天宮 聖里香","sourceIds":{"bangumi":[{"characterId":"65211","match":"exact-normalized-name-in-linked-work","subjectId":"218685"}],"egsCharacterIds":["25112"],"vndbCharacterId":"c57503"},"originalCharacterName":"天宮 聖里香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"95"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が一目惚れした爆乳コスプレイヤー。"},{"spoiler":false,"text":"その正体は、主人公の友人の姉で、紅艶女学院に通う三年生。"},{"spoiler":false,"text":"胸は95センチのGカップでスタイルは抜群。"},{"spoiler":false,"text":"美人だが、性格は、かなりきつく高飛車なところが難点。"}],"source":"egs","sourceCharacterId":"25112","sourceWorkId":"8120","spoiler":false},{"segments":[{"spoiler":false,"text":"紅艶女学院3年。修平の姉。スリーサイズは95G・55・85。みんながよく知っているアニメやコミック、ゲームのコスプレではなく、みんながあまり知らないコスプレ、自分でいいと思ったフィギュアのコスプレをしている。"},{"spoiler":false,"text":"性格はかなりきつく、高飛車。美人だが、一見して声をかけづらい。密かにコスプレをやっているが、それで人気者になろうとか、芸能界に行こうとかういう気もないらしい。ただの気晴らしで気まぐれに出ているだけの話。"},{"spoiler":false,"text":"実は、遺産を相続できないことになっている。弟とは異母兄弟。父親が密かに書いていた遺書を覗き見してしまってから、父親との関係が悪化してしまう。遺書を見たことは父親には話していない。彼女がどんどん高飛車になっていったのはそのあたりから。"},{"spoiler":false,"text":"「わたし、愛されていないのよ。娼婦の子なんだもの。芸者の娘なのよ。だから、こんなに淫乱なのよ」"}],"source":"bangumi","sourceCharacterId":"65211"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"25112","sourceWorkId":"8120","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"25112","sourceWorkId":"8120","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image"