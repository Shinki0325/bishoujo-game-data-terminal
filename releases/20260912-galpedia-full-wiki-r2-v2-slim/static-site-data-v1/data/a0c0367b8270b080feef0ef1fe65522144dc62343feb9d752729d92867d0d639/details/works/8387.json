tors":[]},{"characterId":"char_vndb_c78380","characterName":"矢島 真琴","sourceIds":{"vndbCharacterId":"c78380"},"originalCharacterName":"矢島 真琴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's older sister. Beautiful but short tempered. An office worker. The protagonist also calls her Makoto-nee-chan."},{"spoiler":false,"text":"She's basically capable, so her frustration with her unreliable younger brother boils over. She ends up being harsh. She comes up with extreme ideas to “raise him into a proper man.”"},{"spoiler":false,"text":"Despite being popular, she has no interest in dating guys—she's basically has a big brother complex. Is her strictness just love in disguise?"},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c78380"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53dd139cb36f9d8d45494ad560de5a6ab5cb455470c1f34dddd36a4dba9f4a4d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8adc3871e488aba76bcfd4f52d2a47bcbc7022a88ba0135000ea85680d7c6c35.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c78381","characterName":"川辺 真理","sourceIds":{"vndbCharacterId":"c78381"},"originalCharacterName":"川辺 真理","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's next-door neighbor and relative. A kindergarten teacher. She's actually Aunt Makoto, but she gets angry if called “aunt,” so they call her Makoto-neechan. Hence the confusion."},{"spoiler":false,"text":"In contrast to Makoto, she's lenient with Hikaru. However, she and Makoto—who share the same name and age—don't get along, bickering whenever they meet."},{"spoiler":false,"text":"Hikaru's cuteness & her competitive spirit toward Makoto lead to trouble."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c78381"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/838a8874fc2dc4e88b78db53ef46f3b820fcaddfa019de7a88d692507c01a6bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ceae59fc4b01f57d36139c741915a9f2e3630dd7e26da5c6f1144ee853d43c08.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c78382","characterName":"西滝川 慶子","sourceIds":{"vndbCharacterId":"c78382"},"originalCharacterName":"西滝川 慶子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The instructor at the sports club Makoto attends. She's sexually frustrated."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c78382"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb90e50569065aa11a63d6f39c636532587d85ab855e460d809502893b452c83.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63a2ae94bf38d4fe475c2b4d38b9d6c20f1cc429e0beb407d53157c9c4ca80a3.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c78383","characterName":"吉沢 ゆかり","sourceIds":{"vndbCharacterId":"c78383"},"originalCharacterName":"吉沢 ゆかり","characterNameSource":null,"role":"primary","status":"source-only-