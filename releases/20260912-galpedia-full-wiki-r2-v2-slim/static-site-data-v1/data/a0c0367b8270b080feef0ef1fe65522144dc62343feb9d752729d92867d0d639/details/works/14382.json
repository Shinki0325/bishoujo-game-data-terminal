ff:54759","source":"vndb"}]},"cast":[{"characterId":"char_c66283","characterName":"ぴこ","sourceIds":{"bangumi":[{"characterId":"16738","match":"exact-normalized-name-in-linked-work","subjectId":"453626"}],"egsCharacterIds":["11351"],"vndbCharacterId":"c66283"},"originalCharacterName":"ぴこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"09月07日"},"bloodType":{"reviewState":"no-conflict","source":"bangumi","value":"3"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A very popular shota idol."},{"spoiler":false,"text":"Looks like a girl, but he's a boy."},{"spoiler":false,"text":"He's shy, and gets lonely easily. Is particularly skilled at sulking."},{"spoiler":false,"text":"He wants to get to know \"Onii-chan\" at soon as possible, and work happily with him."}],"source":"vndb","sourceCharacterId":"c66283"},{"segments":[{"spoiler":false,"text":"大人気のショタアイドル。"},{"spoiler":false,"text":"女の子みたいだけど男の子。"},{"spoiler":false,"text":"ちょっとさびしがり＆ひとみしり。"},{"spoiler":false,"text":"スキルは“拗ねる”。"},{"spoiler":false,"text":"お兄ちゃんと早くうちとけて、一緒にお仕事をしたいなって思っているぞ。"}],"source":"egs","sourceCharacterId":"11351","sourceWorkId":"14382","spoiler":false},{"segments":[{"spoiler":false,"text":"本作のヒロインに相当。一見して女の子と見紛う雰囲気を持っており、タモツも最初は女の子だと思ってしまう。"},{"spoiler":false,"text":"名前の由来は幼い男の子の勃起の形容「ぴんこ勃ち」から。（製作総指揮のとっちんによると、男性の名前によく使われる「彦」からであるとされる）"},{"spoiler":false,"text":"2007年5月5日に行われたトークイベント「ショタナイト2」ではファンのアンケート回答結果と投票により誕生日は9月7日、血液型はAB型であることが決まった。誕生日は「シリーズぴこ」すべての始まりである第1作目『ぼくのぴこ』発売日に由来する。"},{"spoiler":false,"text":"本系列作主角。有着一眼会让人有觉得是女孩子的外貌，就连阿保当初见到他时也以为他是女孩。名字由来来自于幼小男子勃起时的形容语“ぴんこ勃起”（不过根据总制作人とっちん的表示，他们经常用“彦”这个男性名字来称呼他）。"},{"spoiler":false,"text":"经由在2007年5月5日“第2回正太之夜”活动中粉丝们的投票结果，将Pico的生日定为9月7日、血型AB型。生日由来来自于“Pico系列”的第1作‘我的Pico’的发售日。"}],"source":"bangumi","sourceCharacterId":"16738"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c66283","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"11351","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"11351","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"16738","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e3b85cb792bbe35a3e94f9a56a7c03cad69a70d7987115357d3830c455fdc81.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5c2703d6039584b0c15d85e95b80587e3ec0a80ebcf0d3d8b3f306a2e1150a0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"池田ひかる","creatorId":"vndb:s1451","sourcePersonId":"vndb:s1451","canonicalEntityId":"vndb:s1451","name":"池田 ひかる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:453626:16738:4486:1","source":"bangumi"}]},{"characterId":"char_c66284","characterName":"ちこ","sourceIds":{"bangumi":[{"characterId":"31076","match":"exact-normalized-name-in-linked-work","subjectId":"453626"}],"egsCharacterIds":["11352"],"vndbCharacterId":"c66284"},"originalCharacterName":"ちこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"5月5日"},"bloodType":{"reviewState":"no-conflict","source":"bangumi","value":"2"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A very popular shota idol."},{"spoiler":false,"text":"He looks good in a dress, but is a boy."},{"spoiler":false,"text":"Has a bright, cheerful and energetic personality. His skill is eating."},{"spoiler":false,"text":"He's excited that he gets to play a lot with \"Onii-chan.\""}],"source":"vndb","sourceCharacterId":