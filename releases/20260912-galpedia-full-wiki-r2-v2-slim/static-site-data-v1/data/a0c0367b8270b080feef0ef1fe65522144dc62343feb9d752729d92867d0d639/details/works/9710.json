calist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:102870","source":"egs"},{"creditedName":"遊女","creatorId":"vndb:s2022","sourcePersonId":"vndb:s2022","canonicalEntityId":"vndb:s2022","name":"遊女","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:26369","source":"vndb"},{"creditedName":"株式会社キューブ","creatorId":"vndb:s2651","sourcePersonId":"vndb:s2651","canonicalEntityId":"vndb:s2651","name":"CUBE(株式会社キューブ)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26373","source":"vndb"},{"creditedName":"佐倉 はなつみ","creatorId":"vndb:s9977","sourcePersonId":"vndb:s9977","canonicalEntityId":"vndb:s9977","name":"佐倉 はなつみ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:26375","source":"vndb"},{"creditedName":"くるぶし","creatorId":"vndb:s10570","sourcePersonId":"vndb:s10570","canonicalEntityId":"vndb:s10570","name":"くるぶし","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:26377","source":"vndb"},{"creditedName":"くるぶし","creatorId":"vndb:s10570","sourcePersonId":"vndb:s10570","canonicalEntityId":"vndb:s10570","name":"くるぶし","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26378","source":"vndb"},{"creditedName":"にくきゅう","creatorId":"vndb:s32381","sourcePersonId":"vndb:s32381","canonicalEntityId":"vndb:s32381","name":"にくきゅう","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:26379","source":"vndb"}]},"cast":[{"characterId":"char_c79766","characterName":"エア","sourceIds":{"bangumi":[{"characterId":"136736","match":"exact-normalized-name-in-linked-work","subjectId":"218149"},{"characterId":"136736","match":"exact-normalized-name-in-linked-work","subjectId":"218150"}],"egsCharacterIds":["18373"],"vndbCharacterId":"c79766"},"originalCharacterName":"エア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"素敵な王子さまとのラブロマンスに憧れる、おっとりほんわかした、アースト王国のお姫さま。"},{"spoiler":false,"text":"芸術全般に造詣が深く、美しいものに見とれ、月や星にうっとりした表情を浮かべるなど、日々、健やかに暮らしている。"},{"spoiler":false,"text":"そんな政治にあまり興味のないエアではあるが、彼女の何気ない一言で、飢饉に苦しむ村に寄付が集まったり、反乱が未然に防がれたりと、国民の受けは、むしろかなり良好だったりする。"}],"source":"egs","sourceCharacterId":"18373","sourceWorkId":"9710","spoiler":false},{"segments":[{"spoiler":false,"text":"シンと恋に落ち、ジャンヌ、トトと共にシンと結婚したお姫様。"},{"spoiler":false,"text":"現在は、人材不足なサプルで内政を担当している。"},{"spoiler":false,"text":"シンと結婚し、幾度も身体を重ね「女の悦び」「男女の営み」の経験を積んだエアだが、生来の「妄想癖」は収まることなく、むしろ拡大した様子。"},{"spoiler":false,"text":"今では、イメクラに近い「なりきりエッチ」がほとんどだが、そんな妄想プレイに、どこまでも着いてきてくれるシンを、心から愛している。"},{"spoiler":false,"text":"今回、幼馴染のビィがやってきたことに喜ぶ一方で、今一番大切なもの「夫＝シン」が奪われるのではないかと戦々恐々としている。"}],"source":"egs","sourceCharacterId":"18373","sourceWorkId":"10724","spoiler":false},{"segments":[{"spoiler":false,"text":"歴史あるアースト王国のおっとりほんわかとしたお姫さま。"},{"spoiler":false,"text":"素敵な王子さまとのラブロマンスに憧れている。"},{"spoiler":false,"text":"穏やかで優しくてやわらかく微笑むけれど、ちょっぴりわがまま。"},{"spoiler":false,"text":"芸術全般に造詣が深く、ウィットに富んだ会話に惹かれてしまう。"},{"spoiler":false,"text":"ややドジ。"},{"spoiler":false,"text":"父王はエアの政略結婚の相手を誰にするかで頭を悩ませているが、"},{"spoiler":false,"text":"そんなことはお構いなしに、エアは楽しい時間をはしゃぎ、美しいものに見とれ、"},{"spoiler":false,"text":"月や星を見上げてうっとりして日々健やかに暮らしている。"},{"spoiler":false,"text":"姫としての勤めももちろん果たしているが、エアの興味はむしろ、美しいものに向けられている。"},{"spoiler":false,"text":"政治にあまり興味のないエアであるが、そんなエアの何気ない一言で、"},{"spoiler":false,"text":"飢饉にあえぐ村に寄付が集まったり、反乱が未然に防がれたりと、国民の受けはむしろかなり良好である。"},{"spoiler":false,"text":"もしかするとそれは、気取らず強がらず、一国のお姫さまとして自然体でいられるエアの、"},{"spoiler":false,"text":"姫としての才能なのかもしれない。"}],"source":"bangumi","sourceCharacterId":"136736"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/1384a472246eccb2ae39f8e7bb597bd35a321937ac78d7b801368e9444d2806f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/28414928a736b42b7ec1811e3251246d3db2ab28fa0af0045df4bce0ade2d5b1.webp","width":129,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218149:136736:4799:1","source":"bangumi"}]},{"characterId":"char_c79769","characterName":"ジャンヌ","sourceIds":{"bangumi":[{"characterId":"136737","match":"exact-normalized-name-in-linked-work","subjectId":"218149"},{"characterId":"136737","match":"exact-normalized-name-in-linked-work","subjectId":"218151"}],"egsCharacterIds":["17280"],"vndbCharacterId":"c79769"},"originalCharacterName":"ジャンヌ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"長剣を軽々と振り回す、軍事国家グランジュの姫将軍。"},{"spoiler":false,"text":"幼い頃より、女としての自分から目を背け、剣士としての修行に明け暮れる彼女は、政治の道具よりも、武の力で王を守る道を選ぶ。"},{"spoiler":false,"text":"しかし、現在のグランジュには嫡子がいないため、いずれ婿を取らなければならないのだが、「女らしい男を婿にとればよろしいではないですか」と言ってきかない、男勝りなジャンヌは父王の悩みの種だとか。"}],"source":"egs","sourceCharacterId":"17280","sourceWorkId":"9710","spoiler":false},{"segments":[{"spoiler":false,"text":"シンと恋に落ち、“エア”、“トト”と共にシンと結婚したお姫さま。"},{"spoiler":false,"text":"現在は、人材不足なサプルで軍事を担当している。"},{"spoiler":false,"text":"女であることを頑なに否定していた自分の心を解かし、「女性として、愛する悦び」を教えてくれたシンを、愛しく見つめる日々に、幸せを感じる毎日。"},{"spoiler":false,"text":"だが、その「愛しい視線」は、他者には「厳しい視線」と受け取られることも珍しくなく、その辺りは相変わらずである。"}],"source":"egs","sourceCharacterId":"17280","sourceWorkId":"11241","spoiler":false},{"segments":[{"spoiler":false,"text":"武の国の姫将軍。"},{"spoiler":false,"text":"男でも扱いの難しいくらいの長い剣を、軽々と振り回す。"},{"spoiler":false,"text":"華麗にたなびく長髪に見とれると、痛い目にあうこと請け合い。"},{"spoiler":false,"text":"きつい目付きが、さらにその精悍さを引き立てている。"},{"spoiler":false,"text":"剣術として学んだ流派・九剣（アール・ドゥ・ヌフ・エペ）は、免許皆伝の腕前。"},{"spoiler":false,"text":"強大な軍事国家グランジュ王国の姫として生まれ、"},{"spoiler":false,"text":"政治の切り札の一枚として生きるより、自ら剣士となって、王を守る道を選んだ。"},{"spoiler":false,"text":"女としての自分からは目を背け、幼き頃からただ剣士としての修行にあけくれた。"},{"spoiler":false,"text":"グランジュには嫡子がおらず、いずれ婿を取らねばならなかった。"},{"spoiler":false,"text":"男勝りなジャンヌを案ずる父王にジャンヌは、"},{"spoiler":false,"text":"「ならば、女らしい男を婿にとればよろしいではありませんか」と言って聞かない。"},{"spoiler":false,"text":"とはいえ、王族に面なる女として、最低限の教育は受けたが、"},{"spoiler":false,"text":"いまのところ、国内では他の男たちと同様の扱いを受けている。"},{"spoiler":false,"text":"いまやジャンヌはグランジュの有能な将軍の一人であり、戦となれば、自ら先陣を切って兵士を指揮する。"}],"source":"bangumi","sourceCharacterId":"136737"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/439872524161522b1ae3cbc4b50727526fcc3621b5fc2380b8bd69ae9022b119.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f96a8d26f98955156375981761064fffa3e66a97cd6d9d4e44e6412904daffcc.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石松千恵美","creatorId":"vndb:s1164","sourcePersonId":"vndb:s1164","canonicalEntityId":"vndb:s1164","name":"石松 千恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218149:136737:4273:1","source":"bangumi"}]},{"characterId":"char_c79772","characterName":"トト","sourceIds":{"bangumi":[{"characterId":"136738","match":"exact-normalized-name-in-linked-work","subjectId":"218149"},{"characterId":"136738","match":"exact-normalized-name-in-linked-work","subjectId":"218153"}],"egsCharacterIds":["16030"],"vndbCharacterId":"c79772"},"originalCharacterName":"トト","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔術の才能に溢れる、魔導国家タイロンの幼姫。"},{"spoiler":false,"text":"直情的で感じたままに動き、かつ甘えん坊と、幼い外見はそのまま、中身もまだまだ子供である。"},{"spoiler":false,"text":"しかし、強い魔力を持つ王族の中でも、飛び抜けた才を持っている彼女は、いずれ“千年に一人の大魔導師”に成長するのではないかと、宮廷の者たちから高く評価されている。"},{"spoiler":false,"text":"だが当のトトは、そんな大人たちをしり目に、さんざん魔法で遊び倒した後は、宿題もせずに疲れて寝てしまうという、楽しい日々を過ごしている。"}],"source":"egs","sourceCharacterId":"16030","sourceWorkId":"9710","spoiler":false},{"segments":[{"spoiler":false,"text":"【甘えん坊の魔女ッ子姫】"},{"spoiler":false,"text":"魔道国家タイロン王国の姫だったが今はシンを愛する妻。"},{"spoiler":false,"text":"代々魔術の才に秀でた家系であり、また王の一族には男女を問わず、厳しい魔術修行も課せられるため、王族は皆、優秀な魔術師である。"},{"spoiler":false,"text":"幼い外見のとおり、中身も小さな女の子のまま。"},{"spoiler":false,"text":"しかし魔術の才だけは飛びぬけていて、小さな身体からは想像できないことを引き起こす。"},{"spoiler":false,"text":"直情的で直感的。強い末っ子体質で、甘えん坊。"},{"spoiler":false,"text":"知恵は回り、あどけない笑顔ではしゃぎ回り、なんでもごまかそうとする。"}],"source":"egs","sourceCharacterId":"16030","sourceWorkId":"11707","spoiler":false},{"segments":[{"spoiler":false,"text":"魔道国家タイロン王国の姫。"},{"spoiler":false,"text":"幼い外見のとおり、中身も小さな女の子のまま。"},{"spoiler":false,"text":"直情的で直感的、且つ甘えん坊。"},{"spoiler":false,"text":"しかし魔術の才だけは飛びぬけていて、小さな身体からは想像できないことを引き起こす。"},{"spoiler":false,"text":"身にまとうマントは、初級魔術師過程終了の証である。"},{"spoiler":false,"text":"王族は代々魔術の才に秀でた家系であり、厳しい魔術修行も課せられるため、皆、優秀な魔術師である。"},{"spoiler":false,"text":"飛びぬけトトは天賦の才に恵まれていたため、果ては千年に一人の大魔道師になるのではないかと、"},{"spoiler":false,"text":"お世辞交じりにも、宮廷の人間たちからは高く評価されている。"},{"spoiler":false,"text":"もっとも、魔力を自在に操る術は、絶えることのない修練と研鑚によってのみ修得できるものであり、"},{"spoiler":false,"text":"天才といえ、その才が担保するのはパワースケールの違いに過ぎない。"},{"spoiler":false,"text":"だからこそトトの家庭教師たちは、トトに厳しい修行を課し、その才に溺れぬよう温かく見守っている。"},{"spoiler":false,"text":"もちろんトトは、そんな大人たちの心配や憂慮なぞお構いもせず、日々を楽しく生きている。"},{"spoiler":false,"text":"「宿題は遊んだあとでー」と言いながら、さんざ魔法で遊び倒し、遊ぶだけ遊んだら疲れて寝てしまう。"},{"spoiler":false,"text":"トトはそんなお年頃。"}],"source":"bangumi","sourceCharacterId":"136738"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/720eb1e90772839a31a8f5d4e9b556cba942ffba7c49fc9c875a9589ce20909c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee1bc701feec36746e1e9d47af432839285d329d65d69bb7082c0bd529d462ae.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永田依子","creatorId":"vndb:s797","sourcePersonId":"vndb:s797","canonicalEntityId":"vndb:s797","name":"永田 依子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218149:136738:5104:1","source":"bangumi"}]},{"characterId":"char_c79774","characterName":"リーナ","sourceIds":{"bangumi":[{"characterId":"136739","match":"exact-normalized-name-in-linked-work","subjectId":"218149"},{"characterId":"136739","match":"exact-normalized-name-in-linked-work","subjectId":"218150"},{"characterId":"136739","match":"exact-normalized-name-in-linked-work","subjectId":"218151"},{"characterId":"136739","match":"exact-normalized-name-in-linked-work","subjectId":"218154"}],"egsCharacterIds":["15445","17281","18374"],"vndbCharacterId":"c79774"},"originalCharacterName":"リーナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"遺跡を探す途中で立ち寄った、とある町の酒場で出会った少女。"},{"spoiler":false,"text":"その時から、なぜか主人公にずっとついてくる。"},{"spoiler":false,"text":"卓越したメイドの身のこなしを持っており、その技術で、頼みもしないのに身の回りの世話に勤しむ。"},{"spoiler":false,"text":"謎の多い女の子だが、常に主人公を気にかけており、そのにっこり笑顔は、彼のやる気を何倍にもしちゃったりする。"}],"source":"egs","sourceCharacterId":"15445","sourceWorkId":"9710","spoiler":false},{"segments":[{"spoiler":false,"text":"完全無欠のポジティブシンキングを持ち、シン王子を甲斐甲斐しく世話するメイド。"},{"spoiler":false,"text":"かつての古サプル王国がそうであったように、新生サプルもまた、いずれ大陸全土を平和にすると信じている。"},{"spoiler":false,"text":"新生サプル建国以前から、主人公の言葉を信じ、共に旅をしてきた。"},{"spoiler":false,"text":"王子の世話を一手に引き受け、サプル城のメイド長となった今でも変わらず王子を支えている。"},{"spoiler":false,"text":"忙しなく過ぎていく毎日だが、疲れたときに限って王子がかわいがってくれるので、本人にとっては充実した日々である。"},{"spoiler":false,"text":"感じやすい身体なので、仕事中でもいじられちゃうともうたまらなくなってしまう。"},{"spoiler":false,"text":"サプル完全再建も目前の今日この頃だが、さすがのリーナも一人でのお城の切り盛りには少々バテ気味！？"}],"source":"egs","sourceCharacterId":"15445","sourceWorkId":"12350","spoiler":false},{"segments":[{"spoiler":false,"text":"新生サプル建国以前から、シンと共に旅をしてきたメイド。"},{"spoiler":false,"text":"現在は、シンの世話を一手に引き受けるメイド長となって忙しい日々を送っているが、疲れた時には、シンが必ず可愛がってくれるので、本人にとってはとても充実している。"},{"spoiler":false,"text":"感じやすく、仕事中でも弄られると堪らなくなってしまう身体を持つ。"},{"spoiler":false,"text":"ちなみに、完全無欠のスーパーポジティブシンキングは、本作でも健在。"}],"source":"egs","sourceCharacterId":"17281","sourceWorkId":"11241","spoiler":false},{"segments":[{"spoiler":false,"text":"新生サプル建国以前から、シンと共に旅をしてきたメイド。"},{"spoiler":false,"text":"現在は、シンの世話を一手に引き受けるメイド長となって忙しい日々を送っているが、疲れた時にはシンが可愛がってくれるので、とても充実している。"},{"spoiler":false,"text":"感じやすく、仕事中でも弄られると堪らなくなってしまう身体を持つ。"},{"spoiler":false,"text":"ちなみに、完全無欠のスーパーポジティブシンキングは、本作でも健在。"}],"source":"egs","sourceCharacterId":"18374","sourceWorkId":"10724","spoiler":false},{"segments":[{"spoiler":false,"text":"サプルの遺跡を探す途上、とある町の酒場で出会った女の子。"},{"spoiler":false,"text":"その時から、なぜだかずっと付いて来ている。"},{"spoiler":false,"text":"なぜだか、頼まれもしないのに王子の身の回りの世話をし、"},{"spoiler":false,"text":"なぜだかエプロンドレスを着ている。"},{"spoiler":false,"text":"卓越したメイドの身のこなしを見せる、謎の多い女の子。"},{"spoiler":false,"text":"にっこり笑顔は、王子のやる気を何倍にもする。"},{"spoiler":false,"text":"完全無欠のポジティブシンキングを持ち、常に王子を気遣う。"}],"source":"bangumi","sourceCharacterId":"136739"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88020e2aeba0cfd72c5ade0d44732dec850c91553a4a9e855af40792bbecd38d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e05ebe1d3fd33c981f33080192df48e772daa037273dbd03cba9872d72aefbf.webp","width":127,"height":256,"source":"static-detail"},"actors":[{"creditedName":"南川のりこ","creatorId":"vndb:s2308","sourcePersonId":"vndb:s2308","canonicalEn