tyId":"vndb:s48783","name":"LostUno","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:24540","source":"vndb"},{"creditedName":"Twilight","creatorId":"vndb:s48784","sourcePersonId":"vndb:s48784","canonicalEntityId":"vndb:s48784","name":"Twilight","roleCode":"qa","roleLabel":"品质保证","identityStatus":"source-native","relationId":"vndb:vn-staff:24541","source":"vndb"},{"creditedName":"Twilight","creatorId":"vndb:s48784","sourcePersonId":"vndb:s48784","canonicalEntityId":"vndb:s48784","name":"Twilight","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:24542","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c13019","characterName":"マイト","sourceIds":{"vndbCharacterId":"c13019"},"originalCharacterName":"マイト","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Might is war orphan from the battle with Herdeus that occurred ten years prior, and grew up in an orphanage with his friend Adonis. Now a rather talented swordsman from one of the top training schools, when Adonis is captured by a demon to save his life, he sets out on a quest to save Adonis."},{"spoiler":false,"text":"Edited from: Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c13019"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e96395e879cab456ca2e7d7f5505feab1df0596db69a464553cc02651f116530.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b7f587b6f365e1dc0c777965dcf3baa0b1bb2e254ee1ab38752b8e80c7d4823e.webp","width":188,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瀧川 大輔","creatorId":"vndb:s90","sourcePersonId":"vndb:s90","canonicalEntityId":"vndb:s90","name":"鈴村 健一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12619","source":"vndb"}]},{"characterId":"char_vndb_c13020","characterName":"アドニス","sourceIds":{"vndbCharacterId":"c13020"},"originalCharacterName":"アドニス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Adonis is also an orphan who grew up alongside Might, training in the magical arts. When Might was wounded, he cast a powerful demonic spell to save his life, and was taken captive by the demon. Just what consequences does he now face?"},{"spoiler":false,"text":"From Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c13020"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/267113f5f4a166d9957af68dadccc73fbf668e270a912eaac8076e1eccf02009.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40528a30be51cecccfffd84775a1f0e857ea2dc0478b279aa2e0ef361f68c81d.webp","width":188,"height":256,"source":"static-detail"},"actors":[{"creditedName":"プログレス","creatorId":"vndb:s400","sourcePersonId":"vndb:s400","canonicalEntityId":"vndb:s400","name":"千葉進歩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12618","source":"vndb"}]},{"characterId":"char_vndb_c13021","characterName":"ライカ・キート","sourceIds":{"vndbCharacterId":"c13021"},"originalCharacterName":"ライカ・キート","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"184"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Leica appears as a strong fighter, bearing the battle scars of a missing eye and arm, and he is skilled with a blade. He meets Might and decides to help him on his quest, adding not only brawn to the party, but also a playful and humorous attitude."},{"spoiler":true,"text":"But there is much more to this seemingly rogue-ish character: he is actually a cheerful individual with a Kansai-dialect who runs an orphanage, taking care of the children there."},{"spoiler":false,"text":"Edited from: Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c13021"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e10827450c748e95f151cfeee065acc86e6d88bad9aee1be4bb41f1e640d955e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3faf7b2ecb85cd01122ecdc7e2712cb24bb1eb8fc04536f9da74087248780dd6.webp","width":188,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小西 克幸","creatorId":"vndb:s65","sourcePersonId":"vndb:s65","canonicalEntityId":"vndb:s65","name":"小西 克幸","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12615","source":"vndb"}]},{"characterId":"char_vndb_c13022","characterName":"ロレンス・ランカスター","sourceIds":{"vndbCharacterId":"c13022"},"originalCharacterName":"ロレンス・ランカスター","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"190"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Lawrence is the Head of the Royal Guard under King Sergei. He joins Might on his quest by order of the king. He is a strong individual and a talented swordsman with a sturdy and serious attitude. He is very dedicated to the battle against Herdeus."},{"spoiler":false,"text":"From: Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c13022"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c00ee6592d8b60dc8b1b5a01792e40f3bd240829eb5ccb18d37082c22eb4ac4b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd668693271ed0c6147004a12f88f3efd991d9564dd9c103132ec095b6f36477.webp","width":188,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浜五郎","creatorId":"vndb:s743","sourcePersonId":"vndb:s743","canonicalEntityId":"vndb:s743","name":"小杉 十郎太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12620","source":"vndb"}]},{"characterId":"char_vndb_c13023","characterName":"パム","sourceIds":{"vndbCharacterId":"c13023"},"originalCharacterName":"パム","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"132"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Pam is an animal-child that Might encounters. An orphan who has seen much hardship in his life, Might's soft heart can't bring him to leave Pam behind, and he follows Might on his quest. He tends to whine a lot and say things with a child's honesty, even when they get him into trouble."},{"spoiler":false,"text":"From: Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c13023"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/4275f276bab0f4cb8f7a0bf31c4c2bb13970ad1179f0ae949d39da49bd7a691c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62c65fbc48891f4c5a5243a736ea87f6ea6dc03b9e0648725a4e7815203f6a7f.webp","width":188,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮田 幸季","creatorId":"vndb:s387","sourcePersonId":"vndb:s387","canonicalEntityId":"vndb:s387","name":"宮田 幸季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12617","source":"vndb"}]},{"characterId":"char_vndb_c13024","characterName":"ヘクター・ブライス","sourceIds":{"vndbCharacterId":"c13024"},"originalCharacterName":"ヘクター・ブライス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"186"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"After witnessing the murder of his mother, Hector grew into a dark and twisted individual that started to use the dark arts to rape and torture people to fulfill his own selfish needs. While typically an antagonist, there is a chance you can gain Hector as an ally on your quest."},{"spoiler":false,"text":"From: Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c13024"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06e4500013901c76441494c480452519c8e1006aa100cc1377a1e50e84390857.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6beff844602ca9e0c0f4d6390461560207300722e906d78a41321e92822d63cc.webp","width":188,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤木 達哉","creatorId":"vndb:s1443","sourcePersonId":"vndb:s1443","canonicalEntityId":"vndb:s1443","name":"うえだ ゆうじ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12622","source":"vndb"}]},{"characterId":"char_vndb_c13025","characterName":"クルト・ハウエル","sourceIds":{"vndbCharacterId":"c13025"},"originalCharacterName":"クルト・ハウエル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kurt is a priest who runs a temple to the god Ragsiel. He meets Might and his allies when they come to his temple to receive help on their quest from Ragsiel, and Kurt also joins the quest against Herdeus. He is a somewhat quiet and extremely polite individual who is very devoted to his god."},{"spoiler":false,"text":"From: Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c13025"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4115e9ce59b3f17411c21fa1de43347d12a4b1008383f0411a2d0311cf58166.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/caed313845158f87c2da0556f3615acd5e1313fbebd6c23b0de517d66e5ad6bc.webp","width":188,"height":256,"source":"static-detail"},"actors":[{"creditedName":"津久井 教生","creatorId":"vndb:s1445","sourcePersonId":"vndb:s1445","canonicalEntityId":"vndb:s1445","name":"津久井 教生","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12623","source":"vndb"}]},{"characterId":"char_vndb_c13027","characterName":"ヴェルナー・クラウディウス","sourceIds":{"vndbCharacterId":"c13027"},"originalCharacterName":"ヴェルナー・クラウディウス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Werne is the prince of the kingdom and heir to the throne. He has lived an isolated and sheltered life, receiving anything he wished at his beck and call. Now he has become a spoiled and selfish individual, who longs to be away from the castle and see the world, instead of feeling like a prisoner within the safety of the palace. However, his attitude often gets him into trouble."},{"spoiler":false,"text":"Edited from: Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c13027"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2ae9bc2743f3c7ff0f5cd24ecf5e3e754f0f5beef88d58b1e2928be42878ea62.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5dce8f2f9318b4072145b8bd2b1b3b0d70daea8a6d4553f30a984b91abb83233.webp","width":188,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩永 哲哉","creatorId":"vndb:s1088","sourcePersonId":"vndb:s1088","canonicalEntityId":"vndb:s1088","name":"岩永 哲哉","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:12621","source":"vndb"}]},{"characterId":"char_vndb_c13028","characterName":"ラグシエル","sourceIds":{"vndbCharacterId":"c13028"},"originalCharacterName":"ラグシエル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ragsiel is a god, who's power countered that of Herdeus's in the past. Might travels to his temple to ask for Ragsiel's help in overcoming this demon again, and Ragsiel provides Might his aid to his quest."},{"spoiler":false,"text":"From: Boys' Love Games Headquarters"}],"source":"vndb","sourceCharacterId":"c13028"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wik