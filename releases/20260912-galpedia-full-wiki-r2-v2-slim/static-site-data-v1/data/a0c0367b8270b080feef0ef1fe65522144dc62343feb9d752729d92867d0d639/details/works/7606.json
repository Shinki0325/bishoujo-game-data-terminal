ginalCharacterName":"霞 真由","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The older of the twin sisters. She has a permanent poker face, so no one except for her sister can tell what she's thinking. Despite her expression, she loves playing around with Yuma, pranking people and re-enacting scenes from their favorite mahou shoujo anime Doricchu. She always wears a hat with cat ears and a tail, imitating Doricchu's looks."},{"spoiler":false,"text":"Calls the protagonist \"Anii\"."}],"source":"vndb","sourceCharacterId":"c51914"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9bb50835fe4dd971da6427fa5f126d6b24b3d3651d4bd4086071f5e8bed1ce1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5ee663b3476bed3bac0c09d21154af64afd07f38cd7d0d5180a4b2afd1ae524c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐々 留美子","creatorId":"vndb:s194","sourcePersonId":"vndb:s194","canonicalEntityId":"vndb:s194","name":"あおきさやか(青木静香)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80098","source":"vndb"}]},{"characterId":"char_vndb_c51915","characterName":"霞 由真","sourceIds":{"vndbCharacterId":"c51915"},"originalCharacterName":"霞 由真","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Younger of the twin sisters. A carefree and talkative hyperactive girl. The twins never leave each other's side, with Yuma looking after her older sister. They go swimming almost every day, so sh