mary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A highly energetic girl. Mia's very honest, but quickly sulks when she's not paid enough attention. She loves dogs, most of all her puppy Margarita, and her dream is to become a dog breeder."},{"spoiler":false,"text":"Calls the protagonist \"Onii-chan\"."}],"source":"vndb","sourceCharacterId":"c51911"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c7c7127649275eeb5349fdf8f5aebfea720ccc28727bbe6f00fac5a17f4540f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99b0e690bbfa326add5a37447582db4a100176eeb9252581e02fb2688c70ce57.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北都 南","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:80097","source":"vndb"}]},{"characterId":"char_vndb_c51912","characterName":"本木 るい","sourceIds":{"vndbCharacterId":"c51912"},"originalCharacterName":"本木 るい","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The only daughter of an American CEO. Competes with Mia in just about everything. She's never seen without her stuffed bear Reinhardt."},{"spoiler":false,"text":"Calls the protagonist \"Nii-sama\"."}],"source":"vndb","sourceCharacterId":"c51912"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/90/903fd13f43ae2f8e6361680c54b27ee0f68