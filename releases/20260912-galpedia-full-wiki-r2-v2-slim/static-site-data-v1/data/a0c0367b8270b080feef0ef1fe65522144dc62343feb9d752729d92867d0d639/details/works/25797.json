","relationId":"egs:work-creator:191549","source":"egs"},{"creditedName":"若葉みやび","creatorId":"vndb:s14544","sourcePersonId":"egs:creator:31636","canonicalEntityId":"vndb:s14544","name":"若葉みやび","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:191550","source":"egs"}],"music":[{"creditedName":"Glassroad","creatorId":"vndb:s3135","sourcePersonId":"egs:creator:22563","canonicalEntityId":"vndb:s3135","name":"Glassroad","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:193519","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c64687","characterName":"詩多音 ゆとり","sourceIds":{"bangumi":[{"characterId":"58436","match":"exact-normalized-name-in-linked-work","subjectId":"224780"}],"egsCharacterIds":["18586"],"vndbCharacterId":"c64687"},"originalCharacterName":"詩多音 ゆとり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Childhood friend of the protagonist."},{"spoiler":false,"text":"A mysterious girl who is famous as \"eccentric girl\", \"delusional girl\" etc."},{"spoiler":false,"text":"Her actions are always contrary to expectations."},{"spoiler":false,"text":"Naturally, everything is for the protagonist she loves."},{"spoiler":false,"text":"\"Underwear? I am wearing right now... Would you like to see it?\""}],"source":"vndb","sourceCharacterId":"c64687"},{"segments":[{"spoiler":false,"text":"「下着ですか？ 履いてますよ……見てみます?」"},{"spoiler":false,"text":"主人公の幼馴染、「不思議ちゃん」で「電波っ子」でといろいろ謎すぎる女の子、その行動は常に予想の斜め上を行く。"},{"spoiler":false,"text":"勿論、全ては愛する主人公のために。"}],"source":"egs","sourceCharacterId":"18586","sourceWorkId":"25797","spoiler":false},{"segments":[{"spoiler":false,"text":"こころが初めて家に連れてきた友達。"},{"spoiler":false,"text":"その正体は、数年ぶりに会う幼馴染だった。"},{"spoiler":false,"text":"しかも、見違えるほど可愛くなっていた。"},{"spoiler":false,"text":"でも、少し変わっているというか……"},{"spoiler":false,"text":"毎朝どうやって侵入しているのか、気付けば家にいたり、"},{"spoiler":false,"text":"ジュース買ってきてって言われて買ってきてあげると"},{"spoiler":false,"text":"「イラない」って言われたり、"},{"spoiler":false,"text":"すると何故かいきなりキスされたりと、"},{"spoiler":false,"text":"いつもゆとりちゃんの謎行動には困惑している。"}],"source":"bangumi","sourceCharacterId":"58436"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7b37d0dd002b424319843c3a8bffd2dac505e7c16115b757bc688178c6919575.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1ef2ae0a759d6bf855024d8c2189ff0e0bbb0e78070a2e241fb1c227921c9bc2.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高村優里","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224780:58436:13512:1","source":"bangumi"}]},{"characterId":"char_c64688","characterName":"小鳥遊 雅","sourceIds":{"bangumi":[{"characterId":"58435","match":"exact-normalized-name-in-linked-work","subjectId":"224780"}],"egsCharacterIds":["18587"],"vndbCharacterId":"c64688"},"originalCharacterName":"小鳥遊 雅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One year older Senpai of the protagonist."},{"spoiler":false,"text":"Outstanding in both studies and sports."},{"spoiler":false,"text":"Is liked by everyone, the most popular person in the school....Hides a devil like personality."},{"spoiler":false,"text":"\"I am not stupider than you.\""}],"source":"vndb","sourceCharacterId":"c64688"},{"segments":[{"spoiler":false,"text":"「私があんたよりバカな筈ないじゃない」"},{"spoiler":false,"text":"主人公の一つ上の先輩。"},{"spoiler":false,"text":"成績、運動神経ともに抜群、人当たりもよくみんなに好かれる"},{"spoiler":false,"text":"学園一の有名人……の皮をかぶった悪魔。"}],"source":"egs","sourceCharacterId":"18587","sourceWorkId":"25797","spoiler":false},{"segments":[{"spoiler":false,"text":"一つ上の先輩。"},{"spoiler":false,"text":"いつも元気で、みんなを引っ張ってくれるリーダー的存在。"},{"spoiler":false,"text":"パッと見は計画的に物事をすすめているように見えるが、"},{"spoiler":false,"text":"その行動の殆どが勢い任せな上、"},{"spoiler":false,"text":"割と抜けているところがありおっちょこちょい。"},{"spoiler":false,"text":"しかし、そんな一生懸命で猪突猛進なところが"},{"spoiler":false,"text":"雅先輩の良いところだとみんな尊敬している。"}],"source":"bangumi","sourceCharacterId":"58435"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c24e05289a73116ecafa135e912994912e1f4bce048e6dfbb7c0c36a58ea8a64.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/0624cd6b6bbf6adf7ad23982092e065eed4daa8f7a28ae8859263429b4dc5e5a.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天海玖美","creatorId":"vndb:s2832","sourcePersonId":"vndb:s2832","canonicalEntityId":"vndb:s2832","name":"天海 玖美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224780:58435:15998:1","source":"bangumi"}]},{"characterId":"char_c64689","characterName":"間宮 洋子","sourceIds":{"bangumi":[{"characterId":"58437","match":"exact-normalized-name-in-linked-work","subjectId":"224780"}],"egsCharacterIds":["18588"],"vndbCharacterId":"c64689"},"originalCharacterName":"間宮 洋子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Similar to Miyabi, one year older Senpai."},{"spoiler":false,"text":"Treats the protagonist like her pet."},{"spoiler":false,"text":"However, the protagonist doesn't resist at all against those actions..."},{"spoiler":false,"text":"Everything is because of those breasts!"},{"spoiler":false,"text":"\"Ahaha... Good child.. Hey, come a bit more closer♪\""}],"source":"vndb","sourceCharacterId":"c64689"},{"segments":[{"spoiler":false,"text":"「あはは、良い子だ♪ ほら、もっとこっちおいで♪」"},{"spoiler":false,"text":"雅と同じく、一つ上の先輩。"},{"spoiler":false,"text":"主人公のことをペットか何かのように、扱ってくる。"},{"spoiler":false,"text":"しかしその行為に主人公は一切抵抗することが出来ない…全てはあのおっぱいのせいだ！"}],"source":"egs","sourceCharacterId":"18588","sourceWorkId":"25797","spoiler":false},{"segments":[{"spoiler":false,"text":"雅と同じ学年でみんなのお姉さん的存在。"},{"spoiler":false,"text":"みんなと一緒になって主人公を弄りまくるが、"},{"spoiler":false,"text":"最後にはいつも助けてくれる。"},{"spoiler":false,"text":"その気さくな性格と包容力のせいか、"},{"spoiler":false,"text":"二人きりになるといつも何かあるのではないかと期待してしまう。"},{"spoiler":false,"text":"そして、そんな気持ちすら見透かされてるような言動に"},{"spoiler":false,"text":"ドキドキさせられる。"}],"source":"bangumi","sourceCharacterId":"58437"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/69faa84d7757c6c5508d74d83ca9e922a08c860b80f840fa6c33f31901554079.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/57de2301766503e41c2c57d163234ee7e9536b3a7a1955f35c9004235eea3c2e.webp","width":208,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224780:58437:6351:1","source":"bangumi"}]},{"characterId":"char_vndb_c64685","characterName":"市ケ谷 こころ","sourceIds":{"vndbCharacterId":"c64685"},"originalCharacterName":"市ケ谷 こころ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"t