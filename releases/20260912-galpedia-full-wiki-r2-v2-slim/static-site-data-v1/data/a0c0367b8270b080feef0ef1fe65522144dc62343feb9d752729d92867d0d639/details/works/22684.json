"value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is usually reserved, but Haruka is a pure and straightforward girl. Sometimes, she sees some strange film footage-like flashbacks (memories?) in her head. For some reason, she's often approached by those of the opposite sex. Due to this, she gets bullied by her female classmates. Her older brother, Masato, is always kind to Haruka and is her emotional support."},{"spoiler":false,"text":"Translation of her official website profile."}],"source":"vndb","sourceCharacterId":"c30126"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72a4b61b06312373d69b34b1b8f5cc666fae8416614d7107b93f1967e61a687d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/77edd21e62b2bf76a06e85113122cb32067635b23b87a4d79944962b4d17302f.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c30127","characterName":"細波 エース","sourceIds":{"vndbCharacterId":"c30127"},"originalCharacterName":"細波 エース","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"214"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"64"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Since he doesn't speak much, Ace leaves an impression of being cold, but his passion for tennis is strong. He's an extremely hardworking person and leads a stoic life. However, when it comes to things unrelated to tennis, Ace is somewhat absentminded. There are many people who say that they can't leave him to his own devices because of this."},{"spoiler":false,"text":"Translation of his official website profile."}],"source":"vndb","sourceCharacterId":"c30127"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22ff377d1d541756f7fcce6c4e8b90bce8a42d807dd52ac3573b0d07d4c58fc1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b66ae80cb3d55e6cf25c98f1536754a554d0b9bd68e89d75286308eb26f1605.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳥海 浩輔","creatorId":"vndb:s45","sourcePersonId":"vndb:s45","canonicalEntityId":"vndb:s45","name":"鳥海 浩輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62970","source":"vndb"}]},{"characterId":"char_vndb_c30128","characterName":"弓倉 ネジ","sourceIds":{"vndbCharacterId":"c30128"},"originalCharacterName":"弓倉 ネジ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"915"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"183"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"68"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A super-fast runner, Neji is the ace of the track and field club. Due to his cheerful disposition and smile, he has many friends and is like the life of his classroom. Though his future in track and field sports is promising, his strong will and sharp tongue can cause problems."},{"spoiler":false,"text":"Translation of his official website profile."}],"source":"vndb","sourceCharacterId":"c30128"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1b39bafe0ad05f9254966c798ac338303de31cd10c49f245a45049b469fd4bf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f034b1c0a08b87404ddf6d740851ec925dc9de9ba8cfffa48c9380d28a2dbead.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浪川 大輔","creatorId":"vndb:s135","sourcePersonId":"vndb:s135","canonicalEntityId":"vndb:s135","name":"浪川 大輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62976","source":"vndb"}]},{"characterId":"char_vndb_c30129","characterName":"神里 キョウ","sourceIds":{"vndbCharacterId":"c30129"},"originalCharacterName":"神里 キョウ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"102"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"185"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"72"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Half-American, half-Japanese, Kyou's beautiful looks makes him popular amongst the female students. They pine for and call him \"Kyou-sama\". However, he finds this a nuisance and doesn't seem to be proud of it. His apathetic, lazy conduct when it comes to his school life stands out. Perhaps because he has a younger sister, he has a caring side to him."},{"spoiler":false,"text":"Translation of his official website profile."}],"source":"vndb","sourceCharacterId":"c30129"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/ch