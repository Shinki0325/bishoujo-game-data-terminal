s":{"bangumi":[],"egsCharacterIds":["6741"],"vndbCharacterId":"c31340"},"originalCharacterName":"月宮 龍三郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"内閣総理大臣。"},{"spoiler":false,"text":"『強い日本』を作ることを理想にかかげ、自らも言葉通りのリーダーシップ・決断力を示している。"},{"spoiler":false,"text":"そのため多くの国民から支持を得ているが、諸外国からは警戒されている。"},{"spoiler":false,"text":"内閣情報調査室の権限を強化し、国内での諜報戦を自ら指揮している。"},{"spoiler":false,"text":"「……今更引き返すことなど、できんさ」"}],"source":"egs","sourceCharacterId":"6741","sourceWorkId":"17246","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/817f2060018a3f4e3d6bf726d3d4fff6fd5e7b5db82ce2b0b6646a59fd3d22eb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/847f30a1a6d761e8c732d3d0f08bd91255b40c3ea257484a728db55a552ec391.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"秋山 樹","creatorId":"vndb:s48","sourcePersonId":"vndb:s48","canonicalEntityId":"vndb:s48","name":"鶴岡 聡","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47501","source":"vndb"}]},{"characterId":"char_c31341","characterName":"御園 京","sourceIds":{"bangumi":[],"egsCharacterIds":["6742"],"vndbCharacterId":"c31341"},"originalCharacterName":"御園 京","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"内閣情報調査室の捜査官。"},{"spoiler":false,"text":"颯一の直属の上司で、内閣情報調査室の実質上のトップ。"},{"spoiler":false,"text":"月宮総理からの信頼も厚く、エージェントとしての能力も高い。"},{"spoiler":false,"text":"本人は破天荒で型破りなタイプながら、立場上独断専行しがちな部下のブレーキ役となることが多い。"},{"spoiler":false,"text":"人情に厚い女性で、颯一や舞からは「お京さん」と呼ばれ慕われている。"},{"spoiler":false,"text":"「なあに。車の凹みは保険できれいに元通りになります。骨の１本や２本だってきれいに治っちゃいますよ」"}],"source":"egs","sourceCharacterId":"6742","sourceWorkId":"17246","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/efa146bd28a4f1d12007ed506415ef64167a107508e1cea72d88352bdd746def.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39876de287969b73d814500e370d7eb09c9e74474b46c03f289765337a778eab.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一色 ヒカル","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:47488","source":"vndb"}]},{"characterId":"char_c31342","characterName":"汐街 凪","sourceIds":{"bangumi":[],"egsCharacterIds":["6743"],"vndbCharacterId":"c31342"},"originalCharacterName":"汐街 凪","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"徹がたまたま街中で暴漢たちから助けた少年。"},{"spoiler":false,"text":"聖ユリウス学園の学生ではないが、徹とは縁があるのか、なにかとよく遭遇する。"},{"spoiler":false,"text":"自分を助けてくれた徹に人懐っこく接してくるが、それが原因で事件に巻き込まれることも……。"},{"spoiler":false,"text":"「これでボクと徹さんはただの友達ではなく親友です！」"}],"source":"egs","sourceCharacterId":"6743","sourceWorkId":"17246","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c31342","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"6743","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"6743","value":"女性"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04608efd1a05efced03056acd2d2965db