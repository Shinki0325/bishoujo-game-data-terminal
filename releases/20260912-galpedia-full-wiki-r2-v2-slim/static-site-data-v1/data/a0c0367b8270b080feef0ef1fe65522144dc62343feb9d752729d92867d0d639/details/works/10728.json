{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"10728","model":{"presentationWorkId":"vndb:v999","staff":{"artwork":[{"creditedName":"浮月たく","creatorId":"vndb:s842","sourcePersonId":"egs:creator:1904","canonicalEntityId":"vndb:s842","name":"浮月たく","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:66710","source":"egs"},{"creditedName":"鳥取砂丘","creatorId":"vndb:s4207","sourcePersonId":"egs:creator:2102","canonicalEntityId":"vndb:s4207","name":"鳥取砂丘","detail":"SD原画","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:70873","source":"egs"}],"scenario":[{"creditedName":"イ也","creatorId":"vndb:s7893","sourcePersonId":"egs:creator:2031","canonicalEntityId":"vndb:s7893","name":"イ也","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:66711","source":"egs"}],"music":[{"creditedName":"マッツミュージックスタジオ","creatorId":"vndb:s414","sourcePersonId":"vndb:s414","canonicalEntityId":"vndb:s414","name":"マッツミュージックスタジオ","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:18543","source":"vndb"},{"creditedName":"五十嵐 芳樹","creatorId":"vndb:s6239","sourcePersonId":"vndb:s6239","canonicalEntityId":"vndb:s6239","name":"五十嵐 芳樹","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:18546","source":"vndb"}],"other":[{"creditedName":"西沢はぐみ","creatorId":"vndb:s394","sourcePersonId":"egs:creator:12829","canonicalEntityId":"vndb:s394","name":"西沢はぐみ","detail":"OP曲「Flapping wish」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:84634","source":"egs"},{"creditedName":"西沢 はぐみ","creatorId":"vndb:s394","sourcePersonId":"vndb:s394","canonicalEntityId":"vndb:s394","name":"西沢 はぐみ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:18542","source":"vndb"}]},"cast":[{"characterId":"char_c51687","characterName":"錘木 ゆうろ","sourceIds":{"bangumi":[{"characterId":"109469","match":"exact-normalized-name-in-linked-work","subjectId":"133378"}],"egsCharacterIds":["18364"],"vndbCharacterId":"c51687"},"originalCharacterName":"錘木 ゆうろ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の義妹で、かなりのおバカさん。"},{"spoiler":false,"text":"ドジ・料理ベタ・臆病者と、あらゆる面で役立たず。"},{"spoiler":false,"text":"しかし、兄への愛情だけは誰にも負けない！"},{"spoiler":false,"text":"最近は主人公に近寄る女の子が増え、内心穏やかで無い様だ。"},{"spoiler":false,"text":"「わふぅ。お兄ちゃんが、わたしに見とれているよぉ…やっぱりイヌミミって悪くないかも～」"}],"source":"egs","sourceCharacterId":"18364","sourceWorkId":"10728","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の義妹。かなりのお馬鹿さん。主人公は自分を好きだと固く信じている。"},{"spoiler":false,"text":"家事全般は主人公に任せっきりで、ほとんどやったことがない。"},{"spoiler":false,"text":"あらゆる面で役立たずな、臆病者のへたれ。"},{"spoiler":false,"text":"すっかり独占欲を発揮するようになり、近頃は主人公の周りに女の子が増えて気が気でない。"},{"spoiler":false,"text":"犬好きだからか、自分の頭に生えたものをイヌミミだと言い張っている。"}],"source":"bangumi","sourceCharacterId":"109469"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3adb8d871b5ddfacbdfb24a34ebe2caffca2fa3fa8879730c71b3f294512370c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb9683d672b6b08c43100a7ed085c536e8689ffecfde0e06b5a0f5668c60e557.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"坂田有希","creatorId":"vndb:s1595","sourcePersonId":"vndb:s1595","canonicalEntityId":"vndb:s1595","name":"坂田 有希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:133378:109469:15687:1","source":"bangumi"}]},{"characterId":"char_c51700","characterName":"纏山 はずみ","sourceIds":{"bangumi":[{"characterId":"109470","match":"exact-normalized-name-in-linked-work","subjectId":"133378"}],"egsCharacterIds":["18365"],"vndbCharacterId":"c51700"},"originalCharacterName":"纏山 はずみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ゆうろのクラスメイトで、主人公の後輩。"},{"spoiler":false,"text":"真面目でしっかりとした性格で、クラス委員長も務める優等生。"},{"spoiler":false,"text":"お節介でお人好しな性分で、文句を言いながらも面倒見が良い。"},{"spoiler":false,"text":"主人公に対しては特にキツく、やたらと突っかかってくる。"},{"spoiler":false,"text":"小さな胸を、ちょっと気にしている。"},{"spoiler":false,"text":"「あ、あんたなんかと仲が良いとかなんだとか……お、思われたくないからに決まってるじゃないっ……」"}],"source":"egs","sourceCharacterId":"18365","sourceWorkId":"10728","spoiler":false},{"segments":[{"spoiler":false,"text":"妹のクラスで委員長をしている優等生。"},{"spoiler":false,"text":"基本的にはしっかり者だが、大事な物を落として無くすような粗忽なところもある。"},{"spoiler":false,"text":"いつも不機嫌そうにしており、明らかに主人公が嫌いな態度を常日頃から露わにしている。"},{"spoiler":false,"text":"相手を突き放すような言葉を口にしつつも、お節介でお人好しな側面を覗かせる。"},{"spoiler":false,"text":"怒りっぽくて、暴力に訴えがち。"}],"source":"bangumi","sourceCharacterId":"109470"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d22a05e90971a5a360a9cad3932453eb17a7e75cdc119c1d12eec21aff6c54c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb2177c6be7f083c859b6409061a3ecfa90525d6349340b82028944ddf2e3ca5.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:133378:109470:4956:1","source":"bangumi"}]},{"characterId":"char_c51701","characterName":"尖堂 近衛","sourceIds":{"bangumi":[{"characterId":"109471","match":"exact-normalized-name-in-linked-work","subjectId":"133378"}],"egsCharacterIds":["18366"],"vndbCharacterId":"c51701"},"originalCharacterName":"尖堂 近衛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"教会でシスターをしている、お淑やかで優しい先輩。"},{"spoiler":false,"text":"お菓子を作るのが趣味の料理上手で、良いお嫁さんになりそう。"},{"spoiler":false,"text":"災難に遭った主人公を気にかけてか、何かと面倒見が良い。"},{"spoiler":false,"text":"その分、やきもちも強烈かも？"},{"spoiler":false,"text":"「ふふふ。まるで幸運がどこかから降ってきたみたいな顔するのね」"}],"source":"egs","sourceCharacterId":"18366","sourceWorkId":"10728","spoiler":false},{"segments":[{"spoiler":false,"text":"お淑やかで優しい先輩。"},{"spoiler":false,"text":"うらぶれた教会でシスターをしているが、あまり自分のことを話そうとしない。"},{"spoiler":false,"text":"慎重な性格のため、偶然を装って主人公に近づきイヌミミの情報を探ろうとする。"},{"spoiler":false,"text":"どうやらイヌミミ以外にも人には言えない秘密を背負っているらしい。"},{"spoiler":false,"text":"お菓子を作るのが趣味で料理上手。落ち着いているようで意外とやきもち焼き。"}],"source":"bangumi","sourceCharacterId":"109471"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/418c9a3cda49f2940ea0ef8b75fe6c8b060dc33c0416215097ea562ba0a35d9d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c646c5c715413207f74e3e81e521b35c9e221b829af8f82d48913015489b9846.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:133378:109471:4830:1","source":"bangumi"}]},{"characterId":"char_c51702","characterName":"尖堂 えいる","sourceIds":{"bangumi":[{"characterId":"109472","match":"exact-normalized-name-in-linked-work","subjectId":"133378"}],"egsCharacterIds":["18367"],"vndbCharacterId":"c51702"},"originalCharacterName":"尖堂 えいる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"教会で養われている女の子。"},{"spoiler":false,"text":"血の繋がりは無いが、近衛を実の姉の様に慕う。"},{"spoiler":false,"text":"人見知りなところがあるが、主人公には良く懐き一緒に遊ぶのを楽しみにしている様だ。"},{"spoiler":false,"text":"「ぴきぴきぴき～～どか～ん」"}],"source":"egs","sourceCharacterId":"18367","sourceWorkId":"10728","spoiler":false},{"segments":[{"spoiler":false,"text":"教会で養われている女の子。"},{"spoiler":false,"text":"近衛を『おねえちゃん』と呼び慕うが血の繋がりはない。"},{"spoiler":false,"text":"言動が見た目以上に幼く、近衛の手を焼かせる。"},{"spoiler":false,"text":"人見知りが激しいが主人公には懐く。"}],"source":"bangumi","sourceCharacterId":"109472"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b503d71cbbc701a8688e408da154d9c625d018d770975b19fa5a746592757128.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a429f5e2b1426d4bdc431fb71f707c82004364c62ef87dc3670861ebc846ecf.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青空 ちはる","creatorId":"vndb:s10469","sourcePersonId":"vndb:s10469","canonicalEntityId":"vndb:s10469","name":"青空 ちはる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9094","source":"vndb"}]},{"characterId":"char_c51703","characterName":"箍谷 芙柘","sourceIds":{"bangumi":[{"characterId":"109473","match":"exact-normalized-name-in-linked-work","subjectId":"133378"}],"egsCharacterIds":["18370"],"vndbCharacterId":"c51703"},"originalCharacterName":"箍谷 芙柘","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同じ学年の女生徒。"},{"spoiler":false,"text":"最近学園に登校していないらしいが、詳しい事情は誰も知らない。"},{"spoiler":false,"text":"おおらかでおっとりとした、素直すぎる女の子。"},{"spoiler":false,"text":"年中ぽやーっとしている為、放っておくと危ない。"},{"spoiler":false,"text":"「なんといいますか……芙柘ったら、運命とゆうものを感じてしまいまして」"}],"source":"egs","sourceCharacterId":"18370","sourceWorkId":"10728","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同じ学年の女生徒。"},{"spoiler":false,"text":"最近学園に姿を見せなくなったらしいが、詳しい事情は誰も知らない。"},{"spoiler":false,"text":"おおらかでおっとりした性格。"},{"spoiler":false,"text":"素直すぎるため、放置すると危険。あまりにも身の安全に無頓着。"},{"spoiler":false,"text":"料理が極めて下手だが、自覚はない。"}],"source":"bangumi","sourceCharacterId":"109473"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd53bf0f1afee89f871d6243b2e950e75c80496f43db7da95e61905e4b2ff29f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99177c82f9f73aab29743df0b819be4839fb3a2691657f2ff889aa7380d1f2b6.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あえか","creatorId":"vndb:s9085","sourcePersonId":"vndb:s9085","canonicalEntityId":"vndb:s9085","name":"あえか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9091","source":"vndb"}]},{"characterId":"char_c51704","characterName":"箍谷 莉玖","sourceIds":{"bangumi":[{"characterId":"109474","match":"exact-normalized-name-in-linked-work","subjectId":"133378"}],"egsCharacterIds":["18371"],"vndbCharacterId":"c51704"},"originalCharacterName":"箍谷 莉玖","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"芙柘の双子の妹で、現在は行方をくらませているらしい。"},{"spoiler":false,"text":"人懐っこい芙柘とは対照的に、自立心が強く寡黙な性格。"},{"spoiler":false,"text":"真っ直ぐ目的に向かう余り、周りが見えなくなってしまうことも。"},{"spoiler":false,"text":"「……斬る」"}],"source":"egs","sourceCharacterId":"18371","sourceWorkId":"10728","spoiler":false},{"segments":[{"spoiler":false,"text":"芙柘の双子の妹。姉とは別の学園に通っている。"},{"spoiler":false,"text":"現在は行方をくらましているが、その事情は芙柘にも話していない。"},{"spoiler":false,"text":"姉思いで、芙柘のためならどんな苦労も厭わない。"},{"spoiler":false,"text":"寡黙で口数は少ない。"}],"source":"bangumi","sourceCharacterId":"109474"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3079dbdbe33028b743837dcffbecd3e977721dbbc9e2552c6873a97e736c45f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35e274a5c63168f7e174f8e2f4309e086e33e58a124790afaf5e8c9f35b97902.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和泉忍","creatorId":"vndb:s1623","sourcePersonId":"vndb:s1623","canonicalEntityId":"vndb:s1623","name":"伊藤 葉純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:133378:109474:6379:1","source":"bangumi"}]},{"characterId":"char_c51706","characterName":"祠島 アヤメ","sourceIds":{"bangumi":[{"characterId":"109475","match":"exact-normalized-name-in-linked-work","subjectId":"133378"}],"egsCharacterIds":["18368"],"vndbCharacterId":"c51706"},"originalCharacterName":"祠島 アヤメ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"学園の生徒会長兼理事長代理を務め、祠島家の次期当主。"},{"spoiler":false,"text":"そんな仰々しい肩書きとは裏腹に、とても親しみやすいお嬢様。"},{"spoiler":false,"text":"変わりモノ好きで浮き世離れした感性の持ち主。"},{"spoiler":false,"text":"おっとりとした物言いと態度には、どこか大器を感じる。"},{"spoiler":false,"text":"「そんなに堅苦しくなさらないで……楽しく紅茶を頂きましょう」"}],"source":"egs","sourceCharacterId":"18368","sourceWorkId":"10728","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の生徒会長兼、理事長代理を務めるお嬢様。"},{"spoiler":false,"text":"代々この地域に絶大な影響力を有する祠島家の次期当主でもある。"},{"spoiler":false,"text":"変わりモノ好きで浮き世離れした感性の持ち主。"},{"spoiler":false,"text":"主人公とその妹・ゆうろをいたく気に入っている。"},{"spoiler":false,"text":"遠縁である纏山はずみに『お姉様』と慕われている。"}],"source":"bangumi","sourceCharacterId":"109475"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a12184e6aed378c1b06e9c23ea801f10a1e257ad24b87a93334b204656e1c923.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5cf65d9a0c9a7314be35edf36ac57fd34cb1d2db5725dadd7a10d0e9e0a9dbc6.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:133378:109475:4810:1","source":"bangumi"}]},{"characterId":"char_c51707","characterName":"祠島 タタラ","sourceIds":{"bangumi":[{"characterId":"109476","match":"exact-normalized-name-in-linked-work","subjectId":"133378"}],"egsCharacterIds":["18369"],"vndbCharacterId":"c51707"},"originalCharacterName":"祠島 タタラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"周囲の人から『タタラ様』と呼ばれ敬われている小娘。"},{"spoiler":false,"text":"茶や香を好み、やたらと年寄り臭い言い回しが目立つ。"},{"spoiler":false,"text":"アヤメの曾祖父の妹を名乗るが、その真偽は不明。"},{"spoiler":false,"text":"少なくとも、外見的には主人公より年下に見えるが……。"},{"spoiler":false,"text":"「最近の若い者ときたら、まったく破廉恥きわまりないのう……」"}],"source":"egs","sourceCharacterId":"18369","sourceWorkId":"10728","spoiler":false},{"segments":[{"spoiler":false,"text":"学園のとある場所で隠遁生活をおくる少女。"},{"spoiler":false,"text":"自らをアヤメの曾祖父の妹であると言うが、真偽のほどは不明。"},{"spoiler":false,"text":"周囲の人間から『タタラ様』と呼ばれ敬われている。"},{"spoiler":false,"text":"年寄り臭い言い回しで、小さいくせにやたら偉そうに振る舞う。"},{"spoiler":false,"text":"茶や香を嗜む。"}],"source":"bangumi","sourceCharacterId":"109476"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df984fb486271e70b4da1deb790cc260defde40743441fb30e6dfa186fdb8141.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0efb6a343e5d46a33008f6135cb1c9b582c10e0d21b31251eb3320496c6f627b.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"苺野あいす","creatorId":"vndb:s7529","sourcePersonId":"vndb:s7529","canonicalEntityId":"vndb:s7529","name":"苺野 あいす","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:133378:109476:88534:1","source":"bangumi"}]},{"characterId":"char_vndb_c102350","characterName":"錘木 裏人","sourceIds":{"vndbCharacterId":"c102350"},"originalCharacterName":"錘木 裏人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0aaf9bb22e81afe32643e11effeed010035b9a04819dd29300cbc3a967b158af.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/2473f2c92cc1efbe8166d6a5c71be9fe7878950c943f80083bf2b7247a7bbd30.webp","width":256,"height":187,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c51690","characterName":"乃籐 七緒","sourceIds":{"vndbCharacterId":"c51690"},"originalCharacterName":"乃籐 七緒","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"des