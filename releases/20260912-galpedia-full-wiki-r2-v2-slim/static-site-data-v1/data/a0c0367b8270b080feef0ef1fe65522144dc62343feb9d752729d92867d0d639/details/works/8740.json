tyStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼馴染にして、クラスメイト。"},{"spoiler":false,"text":"自宅が主人公の真向かいにあり、初顔合わせが生後二ヶ月と筋金入りの幼馴染。"},{"spoiler":false,"text":"素直でやや単純な性格。"},{"spoiler":false,"text":"主人公よりも1日だけ早生まれなことから、お姉さんぶるが、天性のドジっぷりから、すぐに立場が逆転してしまう。"},{"spoiler":false,"text":"努力家で、主人公に喜んで貰おうと修練を重ねた料理の腕は抜群。"}],"source":"egs","sourceCharacterId":"23185","sourceWorkId":"8740","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼なじみにして、クラスメイト。得意な教科は家庭科、苦手な教科は数学。成績は見事に平均レベル。"},{"spoiler":false,"text":"自宅は主人公の家の真向かいにあり、「産まれて2ヶ月以来」の幼なじみ。誕生日が主人公より1日だけ早く、それを根拠にお姉さんぶり、主人公を弟のように扱うが、天性のドジっぷりで自滅することが多く、立場はほとんどの場合逆転している。"},{"spoiler":false,"text":"ひたすらに前向きであり、いつもひとりで努力してほとんど他人を頼らない。"},{"spoiler":false,"text":"「もー、ダメなんだよー。"},{"spoiler":false,"text":"そういうのは、ちゃんと自分で決めないと」"}],"source":"bangumi","sourceCharacterId":"146666"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bfde3cba37c7dd049fe26ed9cc8167f05890c600e7222d79a4e644bea29c5c18.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7d5d9cea348224d7b2305c0247b0b56e39aa452bce4c2560d02e03bfb463ccfa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:17058:146666:5020:1","source":"bangumi"}]},{"characterId":"char_c27092","characterName":"翠川 悠","sourceIds":{"bangumi":[{"characterId":"146667","match":"exact-normalized-name-in-linked-work","subjectId":"17058"}],"egsCharacterIds":["23186"],"vndbCharacterId":"c27092"},"originalCharacterName":"翠川 悠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"廃部寸前の温泉部の部長。"},{"spoiler":false,"text":"主人公と愛歌とはクラスは違うが、温泉部に引き入れようと熱心に誘ってくる。"},{"spoiler":false,"text":"常に元気ハツラツで、何事にも全力で取り組み、人生をフルスロットルで生き抜く、そんな女の子。"},{"spoiler":false,"text":"困った人を放っておけない性格。"},{"spoiler":false,"text":"頭を使う科目は苦手で、体育は得意。要するに体育以外は不得意。"},{"spoiler":false,"text":"廊下を全速力で走り回り、彼女に撥ねられる被害者も続出。"}],"source":"egs","sourceCharacterId":"23186","sourceWorkId":"8740","spoiler":false},{"segments":[{"spoiler":false,"text":"つぶれかけている温泉部の部長。主人公や愛歌とは別のクラスだが、二人を温泉部に引き入れようと熱心に迫ってくる。"},{"spoiler":false,"text":"得意な教科は体育、苦手な教科は頭を使う科目全般。体育以外の成績はとても悪い。"},{"spoiler":false,"text":"いつでも元気ハツラツ、常に元気100％全力スタイル、人生フルスロットル。困った人をほっておけない性格で、いつも学園中を走り回っている。"},{"spoiler":false,"text":"ただ廊下を全速力で走ったりするので、彼女に撥ねられる○○者も毎日量産されている。"},{"spoiler":false,"text":"「うーっす、優哉。 入部、考えてくれた？」"}],"source":"bangumi","sourceCharacterId":"146667"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2bf2e3ad7ec7196fe45f55a73448f653ae7777d1beaa6c0a23d5027a4b02d420.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53e7cbe8026a97fcf53b0d6b4e6fecddf5d4238b4e8fbe40d83f87afafaab150.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:17058:146667:4956:1","source":"bangumi"}]},{"characterId":"char_c27093","characterName":"葛城 恋鳥","sourceIds":{"bangumi":[{"characterId":"88184","match":"exact-normalized-name-in-linked-work","subjectId":"17058"}],"egsCharacterIds":["23187"],"vndbCharacterId":"c27093"},"originalCharacterName":"葛城 恋鳥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"温泉部、唯一の部員。"},{"spoiler":false,"text":"悠とは同じクラスで、唯一の親友と呼べる存在。"},{"spoiler":false,"text":"口数も少なく、抑揚のないぶっきらぼうな喋り方が特徴。"},{"spoiler":false,"text":"常に沈着冷静で、理論的な考えた方をする彼女だが、時折、常識外れのぶっ飛んだ天然ボケをかましてくれる。"},{"spoiler":false,"text":"成績は常にベスト10内にランクする学業優秀。"},{"spoiler":false,"text":"義父・鉄太郎と暮らしていたが、その鉄太郎が亡くなってから一人暮らし。"},{"spoiler":false,"text":"主人公の入部を認めず、敵視するのは鉄太郎と比較して男ぶりが劣ることに原因があるらしい。"}],"source":"egs","sourceCharacterId":"23187","sourceWorkId":"8740","spoiler":false},{"segments":[{"spoiler":false,"text":"温泉部、唯一の部員。悠とは同じクラス、同じ温泉部員で、唯一の親友とも呼べる存在。"},{"spoiler":false,"text":"得意科目は数学。苦手科目は特にないが、強いて言えば体育。成績は順位1ケタ後半を常にキープしている。あまり抑揚のない、ぶっきらぼうなしゃべりが特徴。口数も少ない。しかし、たまに常識からかけ離れた天然ボケをぶちかましてくれる。"},{"spoiler":false,"text":"かつて「お爺ちゃんと孫」ほど年の離れた義父・鉄太郎と暮らしていたが、鉄太郎が亡くなってからは一人暮らし。"},{"spoiler":false,"text":"かなりのお爺ちゃん子だったらしく、鉄太郎と比較して男ぶりの劣る主人公の入部を認めず、敵視している。"},{"spoiler":false,"text":"「……これは恋鳥のだぞ」"}],"source":"bangumi","sourceCharacterId":"88184"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb6718a8c54b2830f29ed7bfcf8742f7be13af0bc998dd25f6df533e4ef47f75.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07b184ddaeac5d4c6bd65cba76240c25b3a23b7f11d43e86964154e2a39969c1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"鳴海エリカ","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:17058:88184:4489:1","source":"bangumi"}]},{"characterId":"char_c27097","characterName":"墨崎 千沙","sourceIds":{"bangumi":[{"characterId":"88185","match":"exact-normalized-name-in-linked-work","subjectId":"17058"}],"egsCharacterIds":["23189"],"vndbCharacterId":"c27097"},"originalCharacterName":"墨崎 千沙","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の義妹。"},{"spoiler":false,"text":"明朗快活で、お兄ちゃん大好きッ娘。"},{"spoiler":false,"text":"最近、兄を想う気持ちが「恋愛感情」に変化していることから、戸惑いを感じている。"},{"spoiler":false,"text":"兄のために料理を作りたがるが、その腕前は破壊的に下手なことから、料理上手な愛歌からレッスンを受けているものの、まるで上達しない。"},{"spoiler":false,"text":"恋愛感情に気付いてから、兄の周囲にいる大人っぽい女性と、幼い自分との差に悩んでいるらしい。"}],"source":"egs","sourceCharacterId":"23189","sourceWorkId":"8740","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の義妹。いつも元気な、お兄ちゃん大好きっ子。最近、兄を想う気持ちが「恋愛感情」に変化してきていることに気付き、戸惑い始めている。"},{"spoiler":false,"text":"兄のためによく料理を作りたがるが、その腕前は破滅的に下手である。料理上手な愛歌からレッスンを受けているものの、上達の兆しは一向に見えない。"},{"spoiler":false,"text":"恋愛感情に気付いてからは、兄のまわりにいる（千沙から見て）「大人っぽい女性」と、幼い自分との差に悩み始めている模様。"},{"spoiler":false,"text":"「お兄ちゃん、ホットケーキ食べる？　千沙が作ってあげよっか」"}],"source":"bangumi","sourceCharacterId":"88185"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/0957b9604fe67ede731382c64a24ca8169c12f48f68b24bc8ddc0a4940918d7c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1f5bdcd21079494c17ac345b1441dadc911ae29331629871ad86472b98456da.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"文月かな","creatorId":"vndb:s54","sourcePersonId":"vndb:s54","canonicalEntityId":"vndb:s54","name":"文月 かな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:17058:88185:22926:1","source":"bangumi"}]},{"characterId":"char_c27128","characterName":"墨崎 陽向","sourceIds":{"bangumi":[{"characterId":"207083","match":"exact-normalized-name-in-linked-work","subjectId":"17058"}],"egsCharacterIds":["23190"],"vndbCharacterId":"c27128"},"originalCharacterName":"墨崎 陽向","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の義弟。"},{"spoiler":false,"text":"いつも笑顔を絶やさない、おっとりほがらかな雰囲気の少年。"},{"spoiler":false,"text":"性格は純粋で素直。兄である主人公に全面的な思慕と信頼を寄せているが、あまりにも過剰なため、やや不安を感じることも。"},{"spoiler":false,"text":"主人公や、千沙と違って学校の成績は優秀。"}],"source":"egs","sourceCharacterId":"23190","sourceWorkId":"8740","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の義弟。いつもおっとりほがらかな笑顔を絶やさない、純粋で素直な心の少年。兄である優哉には、全面的な思慕と信頼を寄せている。寄せすぎという不安もなくはない。"},{"spoiler":false,"text":"ちなみに、一見ぽやぽやした感じではあるが、兄や千沙と違って学校の勉○はかなりできる。"},{"spoiler":false,"text":"「あ、お兄ちゃん……。"},{"spoiler":false,"text":"となり、座ってもいい？ えへへっ」"}],"source":"bangumi","sourceCharacterId":"207083"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c27128","value":"m"},{"comparisonValue":"m","source":"egs","sourceCharacterId":"23190","value":"男性"},{"comparisonValue":"m","source":"egs","sourceCharacterId":"23190","value":"男性"},{"comparisonValue":"f","source":"bangumi","sourceCharacterId":"207083","value":"女"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fcf95aa1a534380ffdc0213f04e0693a4d416cf2f7abf22008f67e6c37c549b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7859b18f419c02a28be0cc1167fe41c57ed4bb9df46d4544be2ca3ba093ace8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:17058:207083:4956:1","source":"bangumi"}]},{"characterId":"char_c27137","characterName":"紫藤 明日香","sourceIds":{"bangumi":[{"characterId":"88186","match":"exact-normalized-name-in-linked-work","subjectId":"17058"}],"egsCharacterIds":["23191"],"vndbCharacterId":"c27137"},"originalCharacterName":"紫藤 明日香","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yamato's younger sister."}],"source":"vndb","sourceCharacterId":"c27137"},{"segments":[{"spoiler":false,"text":"主人公の親友にして、観光業界大手「紫藤グループ」御曹司・紫藤大和の妹。"},{"spoiler":false,"text":"主人公の義妹・千紗とは同級生で、親友の間柄。"},{"spoiler":false,"text":"破天荒な性格の兄とは対照的に、理知的で落ち着いた物腰のお嬢様。"},{"spoiler":false,"text":"気さくで礼儀正しく、実年齢よりもやや大人びた雰囲気を持つ。"},{"spoiler":false,"text":"兄である主人公への想いに揺れ動く千紗の良き相談相手になっているが、それは彼女自身が、かつて身を裂かれるような失恋を経験したから、というのは内緒。"}],"source":"egs","sourceCharacterId":"23191","sourceWorkId":"8740","spoiler":false},{"segments":[{"spoiler":false,"text":"紫藤大和の妹。千紗とは同級生であり、親友の間柄。"},{"spoiler":false,"text":"実兄の大和とは対照的に、理知的で落ち着いた物腰のお嬢様。礼儀正しく人当たりも良いので、大人たちの受けは非常に良い。実年齢よりかなり大人びていて、兄への想いに悩む千紗の良き相談相手でもある。"},{"spoiler":false,"text":"ただ、千紗の話を親身になって聞くのは、かつて明日香自身も身を引き裂かれるような失恋を経験したから……ということは、誰も知らない。"},{"spoiler":false,"text":"……ただひとり、その相手を除いて。"},{"spoiler":false,"text":"「すみません、いつも兄が御迷惑をおかけしまして」"}],"source":"bangumi","sourceCharacterId":"88186"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98f3bfe8472dc1da88a06b61e88c54b1fa8ec5215783c49c48c38e37862eb6dd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44dbc5a69236e716819bbc630ebc68973c687e0b8f94efab6327daf8fbd355eb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中茉理花","creatorId":"vndb:s2571","sourcePersonId":"vndb:s2571","canonicalEntityId":"vndb:s2571","name":"田中 茉理花","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:17058:88186:15994:1","source":"bangumi"}]},{"characterId":"char_c27146","characterName":"雫色 つむぎ","sourceIds":{"bangumi":[{"characterId":"146665","match":"exact-normalized-name-in-linked-work","subjectId":"17058"}],"egsCharacterIds":["23188"],"vndbCharacterId":"c27146"},"originalCharacterName":"雫色 つむぎ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の父親が経営する温泉旅館「すみさき」の仲居。"},{"spoiler":false,"text":"後に主人公のクラスに転校してくる。"},{"spoiler":false,"text":"不幸の星の下に生まれたような幸の薄い女の子。"},{"spoiler":false,"text":"機械類から徹底的に嫌われているらしく、自動ドアは反応しないことも多く、自動販売機に硬貨を入れても戻ってきて買えない。"},{"spoiler":false,"text":"物静かで奥ゆかしく、健気な性格。極度のあがり症で、緊張し過ぎて喋れなくなってしまうこともしばしば。"}],"source":"egs","sourceCharacterId":"23188","sourceWorkId":"8740","spoiler":false},{"segments":[{"spoiler":false,"text":"健気ではかない雰囲気の女性。主人公の父親・英俊が経営する温泉旅館「すみさき」の仲居をしているが、のちに主人公のクラスに転校してくる。"},{"spoiler":false,"text":"やることなすことすぐ裏目に出る、不幸な星回りの女性。なにかと薄幸。とにかく薄幸。また機械類から徹底的に嫌われているらしく、自動ドアは反応しないし自動販売機に入れた硬貨も戻ってきてしまう。"},{"spoiler":false,"text":"性格はかなりおとなしいが、内にひたむきさを秘めている。奥ゆかしく、所作もすごく綺麗。上がり症で、まれに緊張が過ぎてしゃべれなくなる時がある。"},{"spoiler":false,"text":"「大丈夫です。 私は……大丈夫ですから」"}],"source":"bangumi","sourceCharacterId":"146665"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/49/49c5f8995d80c4c8aac920188e76f9d10577f18653bb27f7cd73e3b7bee262d3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/079f4e554936d90ae240e0f1a4bf2723524377fc3594aa97ae2d541920347f18.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"やなせなつみ","creatorId":"vndb:s365","sourcePersonId":"vndb:s365","canonicalEntityId":"vndb:s365","name":"やなせ なつみ","roleCode":"voice-actor","roleLabel":"声优","ide