vndb"},{"creditedName":"Yu-Ko","creatorId":"vndb:s10771","sourcePersonId":"vndb:s10771","canonicalEntityId":"vndb:s10771","name":"Yu-Ko","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:20318","source":"vndb"},{"creditedName":"紫 カジマ","creatorId":"vndb:s44993","sourcePersonId":"vndb:s44993","canonicalEntityId":"vndb:s44993","name":"かじむら カジマ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:20319","source":"vndb"}]},"cast":[{"characterId":"char_c59350","characterName":"フィリア・カーネリアス","sourceIds":{"bangumi":[{"characterId":"131426","match":"exact-normalized-name-in-linked-work","subjectId":"228961"},{"characterId":"131426","match":"exact-normalized-name-in-linked-work","subjectId":"54036"}],"egsCharacterIds":["16938"],"vndbCharacterId":"c59350"},"originalCharacterName":"フィリア・カーネリアス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「私立聖泉エンゲル魔法学院」に通う魔女ッ娘女子学生。"},{"spoiler":false,"text":"ロザリオ（＝セントクルスト）を使った神聖魔法の腕前は学園でもトップクラス。"},{"spoiler":false,"text":"しかし、魔法薬生成の授業では、よく爆発事故を起こす。またほうきに乗れば居眠り運転してしまうなど、ドジな一面も。"},{"spoiler":false,"text":"料理や裁縫が得意な上に、掃除が大好きな家庭的で優しい女の子。"},{"spoiler":false,"text":"朝が弱い。趣味はぬいぐるみ集め。"}],"source":"egs","sourceCharacterId":"16938","sourceWorkId":"4390","spoiler":false},{"segments":[{"spoiler":false,"text":"ちょっぴりドジな白の魔女。"},{"spoiler":false,"text":"でもロザリオ（セントクルスト）を使った神聖魔法の腕前は本物で学院でもトップクラス成績。"},{"spoiler":false,"text":"でも魔法薬生成の授業ではよく爆発事故を起こすし、"},{"spoiler":false,"text":"ほうきに乗るとたまに居眠り運転をして人身事故を起こす。"},{"spoiler":false,"text":"朝に弱く、料理や裁縫が得意で、掃除も好きなのでほうきは手放さない。"},{"spoiler":false,"text":"また、絵が幼児並にへたくそだったりする。"},{"spoiler":false,"text":"ぬいぐるみを集めるのが好きな畑山憧れの女性。"}],"source":"bangumi","sourceCharacterId":"131426"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce19264e6bcd7a6a6f4a4bb9cd0a2122c7a1b323fc5b52d3a70e86ada81d464f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a48645dfd2e0579fa80b0aaa036edc12de898a64146882a1a8d2219357854b6.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"比未子","creatorId":"vndb:s1499","sourcePersonId":"vndb:s1499","canonicalEntityId":"vndb:s1499","name":"比未子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228961:131426:18171:1","source":"bangumi"}]},{"characterId":"char_c59351","characterName":"ビビアン・カーネリアス","sourceIds":{"bangumi":[{"characterId":"131427","match":"exact-normalized-name-in-linked-work","subjectId":"228961"},{"characterId":"131427","match":"exact-normalized-name-in-linked-work","subjectId":"54036"}],"egsCharacterIds":["16939"],"vndbCharacterId":"c59351"},"originalCharacterName":"ビビアン・カーネリアス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「私立聖泉エンゲル魔法学院」に通う魔女ッ娘女子学生。フィリアの妹。"},{"spoiler":false,"text":"絵に描いたものを現実世界に呼び出せるマジカルペンシルを使った魔法を操る。"},{"spoiler":false,"text":"マジカルペンシルは天才絵描きでプロの魔女ッ娘だった母親の形見。"},{"spoiler":false,"text":"魔法に関しては、高い潜在能力を持つ天才だが、手加減を知らないため、彼女と一緒に授業を受けると命の危険が……。"},{"spoiler":false,"text":"姉と同じく優しい性格だが、料理の腕前はからっきし。"}],"source":"egs","sourceCharacterId":"16939","sourceWorkId":"4390","spoiler":false},{"segments":[{"spoiler":false,"text":"フィリア・カーネリアスの妹。いわゆる天才児で性格もおとなしいが、ちょっと変人っぽい。"},{"spoiler":false,"text":"絵に描いたものを現実の世界に呼び出せるマジカルペンシルを使って魔法を操る。"},{"spoiler":false,"text":"また、マジカルペンシルは天才絵描きだった母の形見でもある。"},{"spoiler":false,"text":"朝に強く、料理の腕は破壊的だが、天才的な絵の才能を持っていたりと姉とは正反対の能力を持つ。"},{"spoiler":false,"text":"ちなみに姉同様、魔法の潜在能力はかなり高いものを持っているが、"},{"spoiler":false,"text":"手加減を知らないので彼女と一緒に授業を受けていると命がいくつあっても足りない。"},{"spoiler":false,"text":"また語尾に「～なのだ」をつけてしゃべり、「ぴこぴこぴー」やら「べろべろベー」など変な発言が多い。"}],"source":"bangumi","sourceCharacterId":"131427"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cdcaafbf5fca2297e8319c8f89af4fe0a978f612bf96ad0163ac8345610c38f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/19d6a8de0b900450f867c010b4d93afc2a8c6c18d1e0f100232b786b9771b8aa.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"しまだかおり","creatorId":"vndb:s2665","sourcePersonId":"vndb:s2665","canonicalEntityId":"vndb:s2665","name":"しまだ かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228961:131427:18664:1","source":"bangumi"}]},{"characterId":"char_c59353","characterName":"趙鈴玲","sourceIds":{"bangumi":[{"characterId":"131428","match":"exact-normalized-name-in-linked-work","subjectId":"228961"},{"characterId":"131428","match":"exact-normalized-name-in-linked-work","subjectId":"54036"}],"egsCharacterIds":["16940"],"vndbCharacterId":"c59353"},"originalCharacterName":"趙鈴玲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「私立聖泉エンゲル魔法学院」に通うチャイニーズウィッチ女子学生。"},{"spoiler":false,"text":"語尾に「アル」を付けるのが特徴。非常に健康的で、中国拳法も得意とする。"},{"spoiler":false,"text":"彼女の持つ「でんでん太鼓（＝マジカルでんでん）」は、打ち鳴らすことで様々な物体を変化させることが可能。"},{"spoiler":false,"text":"主人公とは犬猿の仲で、顔を合わせれば喧嘩ばかりしている。"},{"spoiler":false,"text":"故郷にいる八人の兄弟姉妹を養うため、魔女修行をしている、優しく気丈なクーニャン（＝姑娘）。"}],"source":"egs","sourceCharacterId":"16940","sourceWorkId":"4390","spoiler":false},{"segments":[{"spoiler":false,"text":"語尾に「アル」をつけて話すチャイーニーズウィッチ。"},{"spoiler":false,"text":"彼女の持つでんでん太鼓（マジカルでんでん）は打ち鳴らすことで、"},{"spoiler":false,"text":"剣（銘：問答無用天地逆鱗剣）や、はりせん（銘：問答無用烈風衝撃紙）などに変化させることができる。"},{"spoiler":false,"text":"空を飛ぶときはマジカルでんでんをほうきやロケットに変化させて飛ぶ。中国拳法も得意。"},{"spoiler":false,"text":"また畑山のことを全く信用しておらず、何かよくない事件が起こるとすぐにハタヤマのせいではないかと疑ってくる。"},{"spoiler":false,"text":"そのとき、ハタヤマのダブついたおなかをタプタプさせながら問い詰めるのが癖。"},{"spoiler":false,"text":"実は故郷にいるたくさんの兄弟姉妹を養うために魔女修行をしている。"}],"source":"bangumi","sourceCharacterId":"131428"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4d1cc952a183c24c508a1fc15a91f4d9ad3ed5128f73617963c5f571b53227e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36e81b0394d3a5159fa4c4ab1eb32f5c66152f1d435e459d1e60ba7fd38307d7.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天天","creatorId":"vndb:s2922","sourcePersonId":"vndb:s2922","canonicalEntityId":"vndb:s2922","name":"天天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228961:131428:18086:1","source":"bangumi"}]},{"characterId":"char_c59355","characterName":"ルシフェル・ナナリ","sourceIds":{"bangumi":[{"characterId":"131429","match":"exact-normalized-name-in-linked-work","subjectId":"228961"},{"characterId":"131429","match":"exact-normalized-name-in-linked-work","subjectId":"54036"}],"egsCharacterIds":["16941"],"vndbCharacterId":"c59355"},"originalCharacterName":"ルシフェル・ナナリ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「私立聖泉エンゲル魔法学院」に通う女子学生。"},{"spoiler":false,"text":"鏡（陰陽鏡）を使った魔法“鏡魔術”を操る黒の魔女。"},{"spoiler":false,"text":"何処か他人を寄せ付けない雰囲気を漂わせている女の子。"},{"spoiler":false,"text":"あまり他人と接したがらず、周囲から悪い印象を持たれがちな彼女だが、根は優しくて、友情や愛情に厚い。"},{"spoiler":false,"text":"そんな彼女には、生贄の儀式を行っているなどの噂があったり、非常に謎が多い。時折、狐化するというが……。"}],"source":"egs","sourceCharacterId":"16941","sourceWorkId":"4390","spoiler":false},{"segments":[{"spoiler":false,"text":"鴉のように真っ黒な髪と紫の瞳を持ち、どこか人を寄せつけない雰囲気を漂わせている女の子。"},{"spoiler":false,"text":"鏡（陰陽鏡）を使った魔法“鏡魔術”を操る黒の魔女。"},{"spoiler":false,"text":"空を飛ぶときは金色の杖に乗って飛ぶ。占いも得意。"},{"spoiler":false,"text":"なぜかハタヤマとは気が合い、冗談を言うこともあるがブラック過ぎてあまり笑えない。"},{"spoiler":false,"text":"また、彼女には生贄の儀式をやっているなどの噂があるが……"},{"spoiler":false,"text":"たまに狐化する。"}],"source":"bangumi","sourceCharacterId":"131429"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9eb7ee9651c4442d09e7478b04b50db26f409305eaee1f609c7444c8995f98ab.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55e6ef1944be0f98faeb366fc033edfc249357fe21db76e7b0f7951434d5a5a2.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春野 萌","creatorId":"vndb:s5766","sourcePersonId":"vndb:s5766","canonicalEntityId":"vndb:s5766","name":"春野 萌","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:10239","source":"vndb"}]},{"characterId":"char_c59358","characterName":"シオリ・サンダース","sourceIds":{"bangumi":[{"characterId":"131431","match":"exact-normalized-name-in-linked-work","subjectId":"228961"},{"characterId":"131431","match":"exact-normalized-name-in-linked-work","subjectId":"54036"}],"egsCharacterIds":["16943"],"vndbCharacterId":"c59358"},"originalCharacterName":"シオリ・サンダース","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「私立聖泉エンゲル魔法学院」に通う三つ編み眼鏡ッ娘な女子学生。学校では図書委員を務めている。"},{"spoiler":false,"text":"普段は物静かで大人しく、人畜無害だが、怒ると暴力を振るうこともあり、また頑固な一面も。"},{"spoiler":false,"text":"非常に厳格な家庭に育ち、規律やルールを守ることが正義を信じているが……。"},{"spoiler":false,"text":"怪物に襲われたあと、彼女の性格が大きく変わってしまう。"}],"source":"egs","sourceCharacterId":"16943","sourceWorkId":"4390","spoiler":false},{"segments":[{"spoiler":false,"text":"私立エンゲル魔法学院で図書委員を務めるメガネ三つ編みの女の子。普段は大人しく、"},{"spoiler":false,"text":"人畜無害だが、怒ると暴力を振るうこともあり、頑固な一面もうかがえる。"},{"spoiler":false,"text":"厳格な家庭（体罰も含む）で育った彼女は決まりを守ることを１番に考えてきた。"},{"spoiler":false,"text":"しかし、実はそういう風に決まりを守ったり、それを守らせる行為に本当にそれが自分の意志なのかと疑問も持っている。"},{"spoiler":false,"text":"怪物に襲われたあと、娼婦のような女に変身しているのはその辺に理由がある。"},{"spoiler":false,"text":"舌足らずなしゃべり方をする。"}],"source":"bangumi","sourceCharacterId":"131431"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5efaa0487ae087187d11025710bc534390a345b8396c3d055acba582ce814fe2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a3cd7ef3f1cd819ca6ad8d263bfb792cb8e921535c08e80fc93003174e7dd7d.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由宇翼","creatorId":"vndb:s1420","sourcePersonId":"vndb:s1420","canonicalEntityId":"vndb:s1420","name":"あさり☆","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228961:131431:18193:1","source":"bangumi"}]},{"characterId":"char_c59359","characterName":"シルフェ","sourceIds":{"bangumi":[{"characterId":"131430","match":"exact-normalized-name-in-linked-work","subjectId":"228961"},{"characterId":"131430","match":"exact-normalized-name-in-linked-work","subjectId":"54036"}],"egsCharacterIds":["16942"],"vndbCharacterId":"c59359"},"originalCharacterName":"シルフェ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「私立聖泉エンゲル魔法学院」に通う妖精の女の子で、主人公と同じ「使い魔科」に所属している。"},{"spoiler":false,"text":"気まぐれで、ワガママな上に、神出鬼没でクラスのトラブルメーカー的な存在。"},{"spoiler":false,"text":"しかし、天真爛漫で明るく、楽天的な性格は、同時にムードメーカーとしてもその存在感を発揮している。"},{"spoiler":false,"text":"主人公に興味を抱いているようで、彼の怪しげな行動も黙認してくれている。"}],"source":"egs","sourceCharacterId":"16942","sourceWorkId":"4390","spoiler":false},{"segments":[{"spoiler":false,"text":"畑山と同じ使い魔科で、畑山の後ろの席に座っている妖精の女の子。"},{"spoiler":false,"text":"わがまま＆気まぐれな上、神出鬼没でなんにでも首を突っ込みたがるため、トラブルメーカーである。"},{"spoiler":false,"text":"でも彼女の持つ生来の明るさとあきれるほどの楽天的発想は"},{"spoiler":false,"text":"いっしょにいる者まで楽しい気分にさせてくれるものがあり、どうしても憎めない奴である。"},{"spoiler":false,"text":"なぜか畑山に興味を持っており、彼の怪しげな行動を黙認してくれている。"}],"source":"bangumi","sourceCharacterId":"131430"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/173b3e9ae95f253fbadce4ce77e07b84ebc559aeac24fe39a5959b2abe5d9ad6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24cfcb91751e9ba9046e5176607060f7f9a6bb6ef767001848eb9fb63e721878.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紬叶慧","creatorId":"vndb:s2920","sourcePersonId":"vndb:s2920","canonicalEntityId":"vndb:s2920","name":"紬 叶慧","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228961:131430:25798:1","source":"bangumi"}]},{"characterId":"char_vndb_c59360","characterName":"ハタヤマ ヨシノリ","sourceIds":{"vndbCharacterId":"c59360"},"originalCharacterName":"ハタヤマ ヨシノリ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e3a04404650caddbfc09fc2372937d7b6c6c3e7efc0bf213853589758e95b01.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a511f7d3faf8cf0636db6c0c3eb5af53bdb31f54730d6e15341370d108a32c