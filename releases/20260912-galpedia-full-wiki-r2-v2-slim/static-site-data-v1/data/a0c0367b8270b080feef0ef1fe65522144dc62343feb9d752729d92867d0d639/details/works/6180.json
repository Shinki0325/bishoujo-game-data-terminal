ource":"vndb"}]},"cast":[{"characterId":"char_c76709","characterName":"芹緒 カンナ","sourceIds":{"bangumi":[{"characterId":"203940","match":"exact-normalized-name-in-linked-work","subjectId":"224828"}],"egsCharacterIds":["26315"],"vndbCharacterId":"c76709"},"originalCharacterName":"芹緒 カンナ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本編の主人公。"},{"spoiler":false,"text":"喫茶店「ANGEL-TIME」を任されている美形の青年マスター。"},{"spoiler":false,"text":"普段は飄々としてつかみ所がなく、にこやかに致命的なことを指摘する毒のある性格。"},{"spoiler":false,"text":"また女性に対してはとにかく節操がなく、口説いたら即ベッドインが挨拶代わりという困った人。しかも、本人には悪気が無い上に“普通はそうするもの”と思っているようだ。"},{"spoiler":false,"text":"ただ、非常識なのは女性関係に限らず、一般常識も欠如している。唯一救いは、関係を持ったり好意を持たれた相手に、危険が迫れば命掛けで守ろうとするところだろうか。"},{"spoiler":false,"text":"“何者にも縛られない自由な性格”と言うよりは“無責任かつ自由奔放”と言う言葉が似合う。"}],"source":"egs","sourceCharacterId":"26315","sourceWorkId":"6180","spoiler":false},{"segments":[{"spoiler":false,"text":"喫茶店「ANGEL-TIME」を任されている美形の青年マスター。"},{"spoiler":false,"text":"普段は飄々としてつかみ所がなく、にこやかに致命的なことを指摘する毒のある性格。また、女性に対してはとにかく節操がなく、口説いたら即ベッドインが挨拶代わりという困った人。しかも、本人には悪気が無い上に“普通はそうするもの”と思っているよう。ただ、非常識なのは女性関係に限らず、一般的常識に欠如している。唯一救いは、関係を持ったり好意を持たれた相手に、危険が迫れば命掛けで守ろうとする義理堅いところがかろうじてあるということだけ。“何者にも縛られない自由な性格”と言うよりは“無責任かつ自由奔放”と言う言葉が似合う青年。"}],"source":"bangumi","sourceCharacterId":"203940"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"26315","sourceWorkId":"6180","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"178 cm","valueContext":null,"source":"egs","sourceCharacterId":"26315","sourceWorkId":"6180","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"26315","sourceWorkId":"6180","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"69 cm","valueContext":null,"source":"egs","sourceCharacterId":"26315","sourceWorkId":"6180","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e060c7f43736d5f15e63e869a33d8f7bed8ec1754b38f606f68763a6b1c0aee3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6faa5fef9b20094741d319a21d6438135efe08d739691e105ab72a9658d82cad.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"下野紘","creatorId":"vndb:s70","sourcePersonId":"vndb:s70","canonicalEntityId":"vndb:s70","name":"下野 紘","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224828:203940:4262:1","source":"bangumi"}]},{"characterId":"char_c76710","characterName":"貝念 ひなげし","sourceIds":{"bangumi":[{"characterId":"147307","match":"exact-normalized-name-in-linked-work","subjectId":"224828"}],"egsCharacterIds":["26317"],"vndbCharacterId":"c76710"},"originalCharacterName":"貝念 ひなげし","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本編のメイン（？）ヒロイン。"},{"spoiler":false,"text":"元々は都内に暮らす普通の女子学生だった、一ヶ月ほど前から自分の中に、もう一つの人格があり、自分の知らない出来事を周囲から話されることが多くなった。"},{"spoiler":false,"text":"以前にも何度か同じようなことがあったが、それまでは頻繁にあったわけではなく、“寝ぼけていたのかな？”程度の認識だった。しかし、今回は自分の中に別の人格があることをはっきりと自覚するほど頻繁におき、その人格を抑えようとすると性的な興奮状態に陥ってしまうなど、症状が悪化するようになった。"}],"source":"egs","sourceCharacterId":"26317","sourceWorkId":"6180","spoiler":false},{"segments":[{"spoiler":false,"text":"本編のメイン（？）ヒロイン。"},{"spoiler":false,"text":"元々は都内に暮らす普通の女子学生だったが、自分の中に、もう一つの人格があり、自分の知らない出来事を周囲から話されることが多くなる。それは自分の中に別の人格があることをはっきりと自覚するほど頻繁になり、その人格を抑えようとすると性的な興奮状態に陥ってしまうなど、症状が悪化する一方。"}],"source":"bangumi","sourceCharacterId":"147307"}],"profileFacts":[{"label":"胸围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"26317","sourceWorkId":"6180","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"26317","sourceWorkId":"6180","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"26317","sourceWorkId":"6180","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"26317","sourceWorkId":"6180","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0b8c7b8367963219bc30d048c68d9bdb9e1c9b013cd60e3b96c384d82550a3a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4744b22ec52a51c21ae4dabdf0b02fced5299f5e4b18599a14f5b5778bca2d0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224828:147307:6106:1","source":"bangumi"}]},{"characterId":"char_c76711","characterName":"音々子 ふう子","sourceIds":{"bangumi":[{"characterId":"147306","match":"exact-normalized-name-in-linked-work","subjectId":"224828"}],"egsCharacterIds":["26316"],"vndbCharacterId":"c76711"},"originalCharacterName":"音々子 ふう子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"70"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"source-only","source":"vndb","value":"76"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"}},"descriptions":[{"segments":[{"spoiler":false,"text":"天使・アルにより仔猫から転生した女の子。"},{"spoiler":false,"text":"元々が0歳のお子ちゃまだったため、人間になってからも“何も考えていない脳天気”な上に“何を言っても素直に従う　”ちょっとおバカな元気者。"},{"spoiler":false,"text":"本来は“猫の王”となる立場だったらしく、たまに「愚民」とか「いっしょに世界征服っ！」など電波的な発言をするが、根は素直で極度に気弱なため、主人公やアルには良いようにあしらわれている。"}],"source":"egs","sourceCharacterId":"26316","sourceWorkId":"6180","spoiler":false},{"segments":[{"spoiler":false,"text":"天使・アルにより仔猫から転生した女の子。"},{"spoiler":false,"text":"元々が0歳のお子ちゃまだった為、人間になってからも何も考えておらず脳天気な上に何を言っても素直に従うちょっとおバカな元気者。本来は“猫の王”となる立場だったらしく、たまに「愚民」とか「いっしょに世界征服っ！」など電波的な発言をするが、根は素直で極度に気弱なためカンナやアルには良いようにあしらわれている。"}],"source":"bangumi","sourceCharacterId":"147306"}],"profileFacts":[{"label":"胸围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"26316","sourceWorkId":"6180","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"148 cm","valueContext":null,"source":"egs","sourceCharacterId":"26316","sourceWorkId":"6180","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"76 cm","valueContext":null,"source":"egs","sourceCharacterId":"26316","sourceWorkId":"6180","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"26316","sourceWorkId":"6180","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/709fe442d3433c79fe5e8c0efa599996923e7b2f7d5e24094c43649521335849.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37a0fb1c7af548787e6f2c04e58897323badae310f2862b1fa9bdadd87bd2594.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224828:147306:4956:1","source":"bangumi"}]},{"characterId":"char_c76712","characterName":"α","sourceIds":{"bangumi":[],"egsCharacterIds":["26318"],"vndbCharacterId":"c76712"},"originalCharacterName":"α","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"101"},"height":{"reviewState":"no-conflict","source":"vndb","value":"172"},"hip":{"reviewState":"source-only","source":"vndb","value":"95"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"なくしたものが集い、神が創る宇宙の運行から外れた魂のゆりかご……。"},{"spoiler":false,"text":"物語の舞台「銀座○×街」はそんな場所で、彼女はその街が生まれると共に、その街のシンボルだった天使の像から具現化した天使。"},{"spoiler":false,"text":"アルたち、天使たちは神の運行表である“運命の連鎖　アカシックレコード＝エーテル”の記録を書き換える力を有しており、その力は強大。"},{"spoiler":false,"text":"しかし、運命を書き換えるためには対象となるものの強い意志と力が必要で、アルたち天使が自分たちの意志で書き換える事はできない。"}],"source":"egs","sourceCharacterId":"26318","sourceWorkId":"6180","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"101 cm","valueContext":null,"source":"egs","sourceCharacterId":"26318","sourceWorkId":"6180","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"172 cm","valueContext":null,"source":"egs","sourceCharacterId":"26318","sourceWorkId":"6180","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"26318","sourceWorkId":"6180","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"61 cm","valueContext":null,"source":"egs","sourceCharacterId":"26318","sourceWorkId":"6180","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-asset