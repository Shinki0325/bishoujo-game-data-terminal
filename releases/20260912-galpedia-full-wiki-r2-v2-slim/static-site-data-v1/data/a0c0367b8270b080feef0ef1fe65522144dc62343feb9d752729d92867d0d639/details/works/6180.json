","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"普段は街にいて、人や街に害をなす亡霊達を刈り取る冷酷なハンター。"},{"spoiler":false,"text":"しかし根は素直で子供っぽいところがある。"},{"spoiler":false,"text":"彼女も何か動物の生まれ変わりらしく、世間的な常識はまるで理解していない。"},{"spoiler":false,"text":"何しろ、あのふう子にいろいろと教えを受けてしまうくらい疎い。"},{"spoiler":false,"text":"剣の腕は超一流。物質だけではなく、霊体や炎などの通常では切れないモノまで斬り裂く。"},{"spoiler":false,"text":"また過去にカンナと何かの因縁があるらしいが……。"}],"source":"egs","sourceCharacterId":"26320","sourceWorkId":"6180","spoiler":false},{"segments":[{"spoiler":false,"text":"人や街に害をなす亡霊達を刈り取る冷酷なハンター。"},{"spoiler":false,"text":"根は素直で○○っぽいところがある。彼女も何か動物の生まれ変わりらしく、世間的な常識はまるで理解していない。剣の腕は超一流。また、過去にカンナと何かの因縁があるらしく、カンナを良く思っていない。後に、主人公の経営する喫茶店『ANGEL TIME』に居候することに…"}],"source":"bangumi","sourceCharacterId":"147315"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"26320","sourceWorkId":"6180","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"175 cm","valueContext":null,"source":"egs","sourceCharacterId":"26320","sourceWorkId":"6180","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"26320","sourceWorkId":"6180","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"26320","sourceWorkId":"6180","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/427b81e8954ac28aba5929f796ee53a552a05a280829d691fedafc271fe86a2d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b8fafce92e95b3c3a7d319af99491d8b480724477dff69fe85c79553e3f2707.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"生天目仁美","creatorId":"vndb:s270","sourcePersonId":"vndb:s270","canonicalEntityId":"vndb:s270","name":"生天目 仁美","roleCode":"voice-actor","roleLabel":"声优","identityStatu