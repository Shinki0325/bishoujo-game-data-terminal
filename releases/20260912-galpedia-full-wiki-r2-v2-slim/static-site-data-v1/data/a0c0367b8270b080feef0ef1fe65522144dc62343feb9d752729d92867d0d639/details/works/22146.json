:[{"segments":[{"spoiler":false,"text":"淫獣から人類を守る秘密結社・アルゴーのエース。"},{"spoiler":false,"text":"「月氷姫（げっひょうき）」と呼ばれ、恐れられている一流のハンター。"},{"spoiler":false,"text":"ロングの黒髪が印象的なクール美少女。巨大な斬魔剣を片手で操る。"},{"spoiler":false,"text":"以前からカドレア王国王女アフロディアを淫獣から守るべくマークしており、同じ学園に転入していた。"}],"source":"egs","sourceCharacterId":"6982","sourceWorkId":"22146","spoiler":false},{"segments":[{"spoiler":false,"text":"淫獣から人類を守る秘密結社・アルゴーのエース。"},{"spoiler":false,"text":"ロングの黒髪が印象的なクール美少女。"},{"spoiler":false,"text":"“月氷姫” と呼ばれ恐れられている一流のハンターで、巨大な斬魔剣を片手で操る。"},{"spoiler":false,"text":"カドレア王国王女・アフロディアを淫獣から守るべくマークしており、同じ学園に転入していた。"}],"source":"bangumi","sourceCharacterId":"214585"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cae084fc98772f3e32d8aafd9f0a30e5a9a4dcece0c61b374368c1ee3842e82.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fe/fef309a1c4de9b3abfbdda433aa2acbeecb8effa5bbd2abbc421df7690a30f81.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平井まみ","creatorId":"vndb:s939","sourcePersonId":"vndb:s939","canonicalEntityId":"vndb:s939","name":"平井 まみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222340:214585:18547:1","source":"bangumi"}]},{"characterId":"char_c61483","characterName":"夜刀神 アリサ","sourceIds":{"bangumi":[{"characterId":"214586","match":"exact-normalized-name-in-linked-work","subjectId":"222340"}],"egsCharacterIds":["6983"],"vndbCharacterId":"c61483"},"originalCharacterName":"夜刀神 アリサ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"レイの相棒。探知能力に優れ、無線でレイに情報を提供する。"},{"spoiler":false,"text":"「千里眼のアリサ」という異名を持つ。"},{"spoiler":false,"text":"自らは、狙撃銃で攻撃する。接近戦には弱い。"},{"spoiler":false,"text":"クールなレイとは対照的に、明るく饒舌で、かなり生意気。"},{"spoiler":false,"text":"レイとは幼馴染みで、互いに唯一無二のパートナー。男嫌い。"}],"source":"egs","sourceCharacterId":"6983","sourceWorkId":"22146","spoiler":false},{"segments":[{"spoiler":false,"text":"レイの幼なじみで唯一無二の相棒。 戦いでは狙撃と斥候を担当している。"},{"spoiler":false,"text":"その優れた探知能力から、“千里眼のアリサ” という異名を持つ。"},{"spoiler":false,"text":"クールなレイとは対照的に、明るく饒舌でかなり生意気。 そして男嫌い。"},{"spoiler":false,"text":"「ふん……クズの顔なんかいちいち覚えてるわけがないでしょ？」"}],"source":"bangumi","sourceCharacterId":"214586"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0eae2ae701b47859f3a4bb8fddc58968ab0efd08f842d44a02ef3eb171db8ea4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/9317e2ba33513bb1d82a127bc176707c6aa0a2f536e815c497edf82c5b4474a9.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222340:214586:4937:1","source":"bangumi"}]},{"characterId":"char_c61484","characterName":"アフロディア","sourceIds":{"bangumi":[{"characterId":"214587","match":"exact-normalized-name-in-linked-work","subjectId":"222340"}],"egsCharacterIds":["6984"],"vndbCharacterId":"c61484"},"originalCharacterName":"アフロディア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"欧州の小国・カドレア王国の姫。可憐な美少女。"},{"spoiler":false,"text":"明るく人を惹き付ける魅力を持っている。"},{"spoiler":false,"text":"両親は既に死亡。祖父に育てられ溺愛されているが、真っ直ぐ素直に育った。"},{"spoiler":false,"text":"心優しく、気丈で聡明。現在は名門・聖マディナ学園の１年生として日本で暮らしている。"},{"spoiler":false,"text":"なぜか、淫獣たちのターゲットになっている。"}],"source":"egs","sourceCharacterId":"6984","sourceWorkId":"22146","spoiler":false},{"segments":[{"spoiler":false,"text":"欧州の小国・カドレア王国の姫。 可憐な美少女。"},{"spoiler":false,"text":"両親はすでに死亡しているが、祖父に溺愛され まっすぐ素直に育った。"},{"spoiler":false,"text":"性格は明るく、心優しく気丈で聡明。 人を惹き付ける魅力を持っている。"},{"spoiler":false,"text":"現在は名門・聖マディナ学園の 1年生として日本で暮らしている。"},{"spoiler":false,"text":"なぜか、淫獣たちのターゲットになっている。"},{"spoiler":false,"text":"「わたくしが従えば、他の方々に危害は加えないのですね？」"}],"source":"bangumi","sourceCharacterId":"214587"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aaddd347767146bd61bb240265493601f5da6f988fd107cb2cbfcfe6f8b6557b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61e699490dfb1b8cb4ed5dc1c05abe5fa9ee071fff6a8a6a9c27a554282d4c8c.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松平美波穂","creatorId":"vndb:s601","sourcePersonId":"vndb:s601","canonicalEntityId":"vndb:s601","name":"松平 美波穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:222340:214587:15488:1","source":"bangumi"}]},{"characterId":"char_c61485","characterName":"メディア","sourceIds":{"bangumi":[{"characterId":"214588","match":"exact-normalized-name-in-linked-work","subjectId":"222340"}],"egsCharacterIds":["6985"],"vndbCharacterId":"c61485"},"originalCharacterName":"メディア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ミステリアスな美少女。蜃気楼のように現れ、ヒロインたちに警告や忠告をする。"},{"spoiler":false,"text":"全体的に色素が薄く、天使や妖精めいた雰囲気。"},{"spoiler":false,"text":"メッセージを伝えると幻のように消えるが、実態は存在している。"},{"spoiler":false,"text":"罠をはった敵に捕らえられ、彼女もまた嬲られてしまう。"}],"source":"egs","sourceCharacterId":"6985","sourceWorkId":"22146","spoiler":false},{"segments":[{"spoiler":false,"text":"ミステリアスな美少女。 蜃気楼のように現れ、ヒロインたちに警告や忠告をする。"},{"spoiler":false,"text":"メッセージを伝えると幻のように消えるが、実体は存在している。"},{"spoiler":false,"text":"全体的に色素が薄く、天使や妖精めいた雰囲気を醸し出している。"},{"spoiler":false,"text":"罠を張った敵に捕らえられ、彼女もまた嬲られてしまう。"},{"spoiler":false,"text":"「あたなを見守る存在── としか、今は言えません」"}],"source":"bangumi","sourceCharacterId":"214588"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfc2363ef3abac2fa8292d2e8e4b91a5d4a76f159ddffd4386dd9e664e8d7c53.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/0325a0e765e8e5f0f7838be335d3a70536d58cfe8a4a9ae1e52c85d8f1570f37.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小鳥遊ことり","creatorId":"vndb:s11452","sourcePersonId":"vndb:s11452","canonicalEntityId":"vndb:s11452","name":"小鳥遊ことり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:64779","source":"vndb"}]},{"characterId":"char_c61486","characterName":"三好 由梨香","sourceIds":{"bangumi":[{"characterId":"214589","match":"exact-normalized-name-in-linked-work","subjectId":"222340"}],"egsCharacterIds":["6986"],"vndbCharacterId":"c61486"},"originalCharacterName":"三好 由梨香","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"名門・聖マディナ学園の女学生。"},{"spoiler":false,"text":"アフロディアの学友の１人であり、レイのクラスメイト。"},{"spoiler":false,"text":"淫獣によって占拠された館で、女学生たちと共に人質となる。"}],"source":"egs","sourceCharacterId":"6986","sourceWorkId":"22146","spoiler":false},{"segments":[{"spoiler":false,"text":"名門・聖マディナ学園の女学生。"},{"spoiler":false,"text":"アフロディアの学友の一人であり、レイのクラスメイト。"},{"spoiler":false,"text":"淫獣によって占拠された館で、他の女学生たちと共に人質となってしまう。"},{"spoiler":false,"text":"「お願い、た、助けてください！　他のことなら……どんなことでもしますからぁッ！」"}],"source":"bangumi","sourceCharacterId":"214589"}],"p