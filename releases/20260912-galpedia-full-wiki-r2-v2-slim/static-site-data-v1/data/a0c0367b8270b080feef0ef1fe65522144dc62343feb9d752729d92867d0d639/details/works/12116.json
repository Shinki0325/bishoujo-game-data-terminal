value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"吉原遊郭一の大見世、「三浦屋」の中でも一番人気の太夫。つまり吉原一の太夫。"},{"spoiler":false,"text":"その美貌は全ての男を虜にし、女性達も彼女の気品に満ちた行動に憧れずにはいられない。"},{"spoiler":false,"text":"飛鳥のことが気に入っているのか、吉原の作法を教えたり、男を喜ばせる性技を教えてくれたりする。"}],"source":"egs","sourceCharacterId":"15607","sourceWorkId":"12116","spoiler":false},{"segments":[{"spoiler":false,"text":"吉原遊郭一の大見世、「三浦屋」の中でも一番人気の太夫。"},{"spoiler":false,"text":"その美貌は全ての男を虜にし、女性達も彼女の気品に満ちた行動に憧れずにはいられない。"},{"spoiler":false,"text":"飛鳥のことが気に入っているのか、吉原の作法を教えたり、男を喜ばせる性技を教えてくれたりする。"}],"source":"bangumi","sourceCharacterId":"145981"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f9f55b9dc3d08e6eaacf07dcea9f7e7928fc5cfb0a7dec0f141b031fe14b9cf7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b47f089d8d3225bbdf56ebf09b8c092ff389d0029325452b818eb182c1b770d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村恵子","creatorId":"vndb:s282","sourcePersonId":"vndb:s282","canonicalEntityId":"vndb:s282","name":"中村 恵子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:265558:145981:6020:1","source":"bangumi"}]},{"characterId":"char_c8976","characterName":"飛鳥","sourceIds":{"bangumi":[{"characterId":"145978","match":"exact-normalized-name-in-linked-work","subjectId":"265558"}],"egsCharacterIds":["15605"],"vndbCharacterId":"c8976"},"originalCharacterName":"飛鳥","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"月影衆に所属する”くノ一”。"},{"spoiler":false,"text":"孤児として月影衆の頭領に拾われ、そのまま忍術や剣術を仕込まれた。"},{"spoiler":false,"text":"小さい時から山の中で育てられたため世間知らずで、仕事を与えるには少し不安な部分がある。"},{"spoiler":false,"text":"だが、剣術などの強さは申し分なく、女性であるにも