","spoiler":false},{"segments":[{"spoiler":false,"text":"日本でも有数の名家の出身で、生徒会長を務める才女。"},{"spoiler":false,"text":"その家柄に負けず劣らず、多方面に優れた才能を発揮する完璧超人。"},{"spoiler":false,"text":"常に柔らかな物腰を崩さず、どこか妖艶でミステリアスな雰囲気を漂わせている。"},{"spoiler":false,"text":"宗一郎のことをいたく気に入っており、顔を合わせる度に生徒会に入らないかと誘うが、現在に至るまで袖にされ続けている模様。"}],"source":"egs","sourceCharacterId":"7043","sourceWorkId":"22396","spoiler":false},{"segments":[{"spoiler":false,"text":"日本でも有数の名家の出身で、生徒会長を務める才女。"},{"spoiler":false,"text":"その家柄に負けず劣らず、多方面に優れた才能を発揮する完璧超人。"},{"spoiler":false,"text":"常に柔らかな物腰を崩さず、どこか妖艶でミステリアスな雰囲気を漂わせている。"},{"spoiler":false,"text":"宗一郎のことをいたく気に入っており、顔を合わせる度に生徒会に入らないかと誘うが、現在に至るまで袖にされ続けている模様。"}],"source":"egs","sourceCharacterId":"7043","sourceWorkId":"22397","spoiler":false},{"segments":[{"spoiler":false,"text":"日本でも有数の名家の出身で、生徒会長を務める才女。その家柄に負けず劣らず、多方面に優れた才能を発揮する完璧超人。 常に柔らかな物腰を崩さず、どこか妖艶でミステリアスな雰囲気を漂わせている。"},{"spoiler":false,"text":"宗一郎をいたく気に入っており、顔を合わせる度に生徒会に入らないかと誘っている。現在に至るまで袖にされ続けていたはずだったが……？"}],"source":"egs","sourceCharacterId":"7043","sourceWorkId":"22398","spoiler":false},{"segments":[{"spoiler":false,"text":"日本でも有数の名家の出身で、生徒会長を務める才女。"},{"spoiler":false,"text":"その家柄に負けず劣らず、多方面に優れた才能を発揮する完璧超人。"},{"spoiler":false,"text":"常に柔らかな物腰を崩さず、どこか妖艶でミステリアスな雰囲気を漂わせている。"},{"spoiler":false,"text":"主人公をいたく気に入っており、顔を合わせる度に生徒会に入らないかと誘うが、"},{"spoiler":false,"text":"現在に至るまで袖にされ続けている模様。"},{"spoiler":false,"text":"「貴方を手に入れるためだもの。 多少はしつこくしないと、熱意が伝わらないでしょう？」"}],"source":"bangumi","sourceCharacterId":"35759"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"35759","value":"後期課程3年"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/25/25262631742dd2aa4d62ce8b0dee4e9c602cae150425807c4206a59ae47b5e5c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b7df0bd7fd1c635d9d63dd4c50dbfc9da0017d8c81ecc4ab146ac34fd939ccf.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊原 ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66673","source":"vndb"}]},{"characterId":"char_c38608","characterName":"月上 アリア","sourceIds":{"bangumi":[{"characterId":"37742","match":"exact-normalized-name-in-linked-work","subjectId":"147450"}],"egsCharacterIds":["7470"],"vndbCharacterId":"c38608"},"originalCharacterName":"月上 アリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"49"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Because I was born under this star, I'm sure that this star is a blessing one\""}],"source":"vndb","sourceCharacterId":"c38608"},{"segments":[{"spoiler":false,"text":"麻保志学園の天文時計に宿る『星霊』。"},{"spoiler":false,"text":"『星霊』であるため、人間の感覚には慣れない節がある。"},{"spoiler":false,"text":"人に『幸せ』を与える力があるが、実は『幸せ』とは何かよく理解していないため、う上手く力を使いこなせていない。"},{"spoiler":false,"text":"大河に『幸せ』を与えようとするも、「『幸せ』とは心に湧き出すもので、ほんと貰えるじゃない」と拒否されてしまう。"},{"spoiler":false,"text":"持ち前の無邪気な性格と重なり、「『幸せ』は貰って困るものじゃないから、与えればいいんだよ」という考えがあり、大河と意見が食い違い、困惑してしまう。"}],"source":"egs","sourceCharacterId":"7470","sourceWorkId":"22623","spoiler":false},{"segments":[{"spoiler":false,"text":"麻保志学園の天文時計に宿る “星霊”。"},{"spoiler":false,"text":"無邪気な性格で、また星霊であるため人間とは少し感性がズレている。"},{"spoiler":false,"text":"人に “幸せ” を与える力があるが、実は “幸せ” とは何かよく分かっていない。"},{"spoiler":false,"text":"大河に “幸せ” を与えようとするも、「それは簡単にもらえるものではない」 と拒否されてしまう。"},{"spoiler":false,"text":"困惑したアリアは、本当の “幸せ” とは何か知るため、人間となって大河のクラスメイトに。"},{"spoiler":false,"text":"最初は大河の考えによく反発するが、共に過ごすことで次第に理解を深めていく。"},{"spoiler":false,"text":"「この星で生まれたんだから、それはきっと星が祝福してくれたんだよ」"}],"source":"bangumi","sourceCharacterId":"37742"}],"profileFacts":[{"label":"学年","source":"bangumi","sourceCharacterId":"37742","value":"後期課程 2年"},{"label":"胸围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"7470","sourceWorkId":"22623","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"7470","sourceWorkId":"22623","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"7470","sourceWorkId":"22623","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"7470","sourceWorkId":"22623","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"49 cm","valueContext":null,"source":"egs","sourceCharacterId":"7470","sourceWorkId":"22623","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"45 kg","valueContext":null,"source":"egs","sourceCharacterId":"7470","sourceWorkId":"22623","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d396b83cbdc21daa8ec8e7503c5974d2164446a74850ff8585b26a588c16e9c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b50ac31c87bd44d293e40ef6f44d713269d0a05a5765e8ae0f7f09ea07b0f6c4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:147450:37742:15637:1","source":"bangumi"}]}],"songs":[],"companies":[{"com