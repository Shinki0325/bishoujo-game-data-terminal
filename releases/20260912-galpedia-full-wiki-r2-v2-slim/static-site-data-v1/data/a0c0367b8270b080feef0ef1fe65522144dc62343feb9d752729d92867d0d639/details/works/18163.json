er":true,"text":"Plays a virtual girl named Kokona online."}],"source":"vndb","sourceCharacterId":"c21964"},{"segments":[{"spoiler":false,"text":"オタク趣味全開なお兄ちゃん大好きっ娘。"},{"spoiler":false,"text":"主人公の妹である。"},{"spoiler":false,"text":"主にゲームが好きであり、どんなゲームも好む雑食系である。"},{"spoiler":false,"text":"特に音ゲーが得意である。"},{"spoiler":false,"text":"当然、エロゲーも大好きだったりする。"},{"spoiler":false,"text":"最近はネットゲームにもはまっているらしい。"},{"spoiler":false,"text":"オタクであるが、社交的かつアクティブな性格。"},{"spoiler":false,"text":"オタ友達は多く、学園のクラスでもそれなりに人気がある。"},{"spoiler":false,"text":"恋愛に関しては、オタゆえに、モテナイというか草食的である。"},{"spoiler":false,"text":"あまり好きではないがスポーツ系はかなり優秀。"}],"source":"egs","sourceCharacterId":"362","sourceWorkId":"18163","spoiler":false},{"segments":[{"spoiler":false,"text":"オタク趣味全開なお兄ちゃん大好きっ娘。 主人公の妹。"},{"spoiler":false,"text":"主にゲームが好きで、どんなゲームも好む雑食系。 特に音ゲーが得意。"},{"spoiler":false,"text":"当然、エロゲーも大好きだったりする。 最近はネットゲームにもハマっているらしい。"},{"spoiler":false,"text":"オタクではあるが、社交的かつアクティブな性格。"},{"spoiler":false,"text":"オタ友達は多く、学園のクラスでもそれなりに人気がある。"},{"spoiler":false,"text":"恋愛に関してはオタゆえに、モテナイというか草食系。"},{"spoiler":false,"text":"あまり好きではないがスポーツはかなり優秀。"}],"source":"bangumi","sourceCharacterId":"47740"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c049e8c5cfc0d76bfc9e4f2b21b92b2d19dabdb33f52288591c9c15c03cf204.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aef421d8739ac1a85c7fb84caf6dba69436e4f996a13cd0e80a5f656189e74eb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:66762:47740:5906:1","source":"bangumi"}]},{"characterId":"char_c21965","characterName":"らいらい","sourceIds":{"bangumi":[{"characterId":"47743","match":"exact-normalized-name-in-linked-work"