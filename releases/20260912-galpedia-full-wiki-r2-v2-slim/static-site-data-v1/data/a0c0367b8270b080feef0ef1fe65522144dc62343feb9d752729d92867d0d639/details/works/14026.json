{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"14026","model":{"presentationWorkId":"vndb:v5220","staff":{"artwork":[{"creditedName":"スミスミ","creatorId":"vndb:s7028","sourcePersonId":"egs:creator:50","canonicalEntityId":"vndb:s7028","name":"スミスミ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:87483","source":"egs"}],"scenario":[{"creditedName":"黒井弘騎","creatorId":"vndb:s6852","sourcePersonId":"egs:creator:5442","canonicalEntityId":"vndb:s6852","name":"黒井弘騎","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:87484","source":"egs"},{"creditedName":"七瀬流","creatorId":"vndb:s7377","sourcePersonId":"egs:creator:5542","canonicalEntityId":"vndb:s7377","name":"七瀬流","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:87485","source":"egs"},{"creditedName":"高橋直樹(NTak_indies、NTak_hobby)","creatorId":"vndb:s2917","sourcePersonId":"egs:creator:683","canonicalEntityId":"vndb:s2917","name":"高橋直樹(NTak_indies、NTak_hobby)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:87486","source":"egs"}],"music":[{"creditedName":"HT-SOUND","creatorId":"vndb:s184","sourcePersonId":"egs:creator:3364","canonicalEntityId":"vndb:s184","name":"HT-SOUND","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:87487","source":"egs"}],"other":[{"creditedName":"阿部四百(400、阿部400)","creatorId":"vndb:s3914","sourcePersonId":"egs:creator:15433","canonicalEntityId":"vndb:s3914","name":"阿部四百(400、阿部400","detail":"彩色","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:167682","source":"egs"}]},"cast":[{"characterId":"char_c52935","characterName":"高岡 幻夢","sourceIds":{"bangumi":[{"characterId":"153091","match":"exact-normalized-name-in-linked-work","subjectId":"187612"}],"egsCharacterIds":["9971"],"vndbCharacterId":"c52935"},"originalCharacterName":"高岡 幻夢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公たちが通う学園の養護教諭（保健医）。"},{"spoiler":false,"text":"女子生徒たちの相談や、カウンセリングも行っている。"},{"spoiler":false,"text":"彼女は思春期の女の子たちを淫夢に引きずり込む謎の存在であり、異常性欲に悩み相談に訪れた主人公を淫靡な快楽の世界へと誘う。"}],"source":"egs","sourceCharacterId":"9971","sourceWorkId":"4962","spoiler":false},{"segments":[{"spoiler":false,"text":"正体は淫魔。学園に転校してくるが外見はかなり幼い。"},{"spoiler":false,"text":"過去の失敗により魔力を失い、少女の様な外見に自分を固定する事で魔力の消費を抑えている。"},{"spoiler":false,"text":"卵を2人に与え、互いに競わせる事で魔力を吸収し復活しようと企む。"},{"spoiler":false,"text":"魔力の収集を目的としており、何らかの取り立てに追われているようだが、魔力収集ノルマを果たせずに微妙にワープア化している。"}],"source":"egs","sourceCharacterId":"9971","sourceWorkId":"14026","spoiler":false},{"segments":[{"spoiler":false,"text":"特定の嗜好な方々に好まれるような体型を強いられ、ワープア、貧乏一直線。"},{"spoiler":false,"text":"知り合いのツテでネットショップを運営中。"},{"spoiler":false,"text":"不慣れな仕事でのミスの結果、蒔絵と出会い彼女の『妄想の世界』を利用しようと画策する。"}],"source":"egs","sourceCharacterId":"9971","sourceWorkId":"15559","spoiler":false},{"segments":[{"spoiler":false,"text":"『侵蝕』シリーズに登場する淫魔。 外見上はシリーズ最年少に。"},{"spoiler":false,"text":"三姉妹を巻き込んで、遺跡の魔力を回収しようと企んでいる。"},{"spoiler":false,"text":"迷宮の水先案内人を装い、ヒロインたちを騙して誘導したりもする。"}],"source":"bangumi","sourceCharacterId":"153091"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76df2e6ab2fcbca767bc649b4598cd067bdd73b23a46d1d5e13242b255abde70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cebc304ee99ccf80c4bec71ca1791e68178026127d16c281783bd4ae54b52fe.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"飯野ユウ","creatorId":"vndb:s931","sourcePersonId":"vndb:s931","canonicalEntityId":"vndb:s931","name":"飯野 ユウ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:236650:153091:6377:1","source":"bangumi"}]},{"characterId":"char_c52937","characterName":"秋沢 くるみ","sourceIds":{"bangumi":[{"characterId":"153337","match":"exact-normalized-name-in-linked-work","subjectId":"396986"}],"egsCharacterIds":["19344"],"vndbCharacterId":"c52937"},"originalCharacterName":"秋沢 くるみ","characterNameSource":null,"role":"appears","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"図書委員の一人で千沙の親戚。"},{"spoiler":false,"text":"人がいいタイプで、千沙共々、よく朱鷺坂にからかわれている。"},{"spoiler":false,"text":"チアリーディング部に所属しているが、彼女の爆乳が揺れる様が堪らないと、男子のギャラリーは増える一方とか。"}],"source":"egs","sourceCharacterId":"19344","sourceWorkId":"9804","spoiler":false},{"segments":[{"spoiler":false,"text":"千紗の親戚で、千紗と一緒に図書委員。"},{"spoiler":false,"text":"人が良すぎるせいで、朱鷺坂先輩に"},{"spoiler":false,"text":"よくだまされているようだ。"},{"spoiler":false,"text":"チアリーディング部でもあるが、"},{"spoiler":false,"text":"その巨乳故に…"}],"source":"bangumi","sourceCharacterId":"153337"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5360abe8a537f5e220c6238ce2ca8af35ec1568a93ca649dbcd7b93395bff17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae9f08052c4efc49e87cb75a7ee3d9fd43a9eadd881eca12e5050dedf58c262b.webp","width":129,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c53049","characterName":"桐原 夏姫","sourceIds":{"bangumi":[{"characterId":"153172","match":"exact-normalized-name-in-linked-work","subjectId":"236650"}],"egsCharacterIds":["11639"],"vndbCharacterId":"c53049"},"originalCharacterName":"桐原 夏姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"姉思いの妹で活発な性格、思った事をそのまま喋ってしまう正直な性格。"},{"spoiler":false,"text":"両親の離婚の際、取り決めにより母方に引き取られる。"},{"spoiler":false,"text":"母親とも没交渉で一人で家を与えられ生活している為に寂しい生活をしている。"},{"spoiler":false,"text":"母親は魔術師の取り決めの為に子供を引き取っただけで父親同様愛情に乏しい。"},{"spoiler":false,"text":"魔術の研鑽を指定通りにこなしていれば干渉もして来ない為本人は気楽。"},{"spoiler":false,"text":"仲が良かった姉と、学校で会える事だけが楽しみだった。"},{"spoiler":false,"text":"活発に見える性格も、引っ込み思案な姉を庇おうとした結果かもしれない。"},{"spoiler":false,"text":"豹変してしまった父親には悲しんでいるが、距離を置いている。"},{"spoiler":false,"text":"姉同様、触手の淫辱に溺れて行く。"},{"spoiler":false,"text":"調教の傾向：乳辱/露出羞恥系調教"}],"source":"egs","sourceCharacterId":"11639","sourceWorkId":"14026","spoiler":false},{"segments":[{"spoiler":false,"text":"姉思いの妹で、活発な性格。思ったことをそのまま喋ってしまう。"},{"spoiler":false,"text":"両親の離婚の際、取り決めにより母方に引き取られる。"},{"spoiler":false,"text":"母親からの愛情は薄く、家を与えられひとりで生活しているため寂しい思いをしている。"},{"spoiler":false,"text":"仲の良い姉と学園で会えることだけが楽しみ。"},{"spoiler":false,"text":"活発に見える性格も、引っ込み思案な姉を庇おうとした結果かもしれない。"},{"spoiler":false,"text":"豹変してしまった父親には悲しんでいるが距離を置いている。"},{"spoiler":false,"text":"姉同様、触手の淫辱に溺れていく。"}],"source":"bangumi","sourceCharacterId":"153172"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72da67e785e360637ff34e6592ed292a043d393861dccb2007a1b1db1163935c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/56/56a9f0ff93db6807bf5e8801fb180ad1eb15b63e325edfcd50761c47a513b308.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平山ゆかり","creatorId":"vndb:s285","sourcePersonId":"vndb:s285","canonicalEntityId":"vndb:s285","name":"東かりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:236650:153172:5905:1","source":"bangumi"}]},{"characterId":"char_v