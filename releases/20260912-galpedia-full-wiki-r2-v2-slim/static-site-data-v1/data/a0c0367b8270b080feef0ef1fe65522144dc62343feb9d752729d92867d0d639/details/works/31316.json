{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"31316","model":{"presentationWorkId":"vndb:v31461","staff":{"artwork":[{"creditedName":"波多","creatorId":"vndb:s24945","sourcePersonId":"egs:creator:36994","canonicalEntityId":"vndb:s24945","name":"波多","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:236661","source":"egs"}],"scenario":[{"creditedName":"真田クロ","creatorId":"vndb:s21220","sourcePersonId":"egs:creator:22779","canonicalEntityId":"vndb:s21220","name":"真田クロ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:236662","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c124759","characterName":"スレーブ・ラピス","sourceIds":{"vndbCharacterId":"c124759"},"originalCharacterName":"スレーブ・ラピス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"729"},"bust":{"reviewState":"source-only","source":"vndb","value":"76"},"height":{"reviewState":"source-only","source":"vndb","value":"144"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Poisonous thorns devoted to the Lord!!\""},{"spoiler":false,"text":"Having achieved perfect compatibility with Knight Gear, and obtaining the power of a Magical Girl that she has always dreamt of, Lapis has fulfilled her long-held wish. However, as a result, her female slave transformation has accelerated, and she now trembles with fear and even enters heat simply by catching a glimpse of the root of her past trauma, Kai Haibara."},{"spoiler":false,"text":"Despite this, Lapis, with her high pride, rallied herself and challenged Haibara bravely, only to suffer a humiliating defeat at his hands. Fascinated by Haibara's terrifying and ferocious nature, she became completely subservient to him and was reborn as a new utterly servile evil female slave, Slave Lapis."},{"spoiler":false,"text":"Her once lively, proud and radiant smile has changed to a power-drunk, vulgar and wicked one towards all those who oppose her master and her... an arrogant expression reminiscent of her new master."},{"spoiler":false,"text":"Translated from the official character description"}],"source":"vndb","sourceCharacterId":"c124759"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/affd40884cd3ca0651c4a76fda68066a787b6b805a482687456dc9c2c1b8cd1c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/33102555795b9ac7aab707f67034273cc7b9f9d9aede67612dc55571e6430248.webp","width":164,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c83254","characterName":"ナイト・ラピス","sourceIds":{"vndbCharacterId":"c83254"},"originalCharacterName":"ナイト・ラピス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"1024"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"76"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"144"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"\"Green breath that inherits the earth!!\""},{"spoiler":false,"text":"Knight Lapis is a member of the Morning Star Knights. She is a skilled fighter who was dispatched from the headquarters to the Japanese branch, which is weakened and confused after the assassination of its leader, Leonard."},{"spoiler":false,"text":"She is the daughter of the family that owns the Oukazaibatsu which sponsors the Morning Star Knights. Although she can be forceful and high-spirited at times, she is an attractive girl who is friendly, kind and humble. However, she is a semi-compliant artifact and cannot demonstrate the same level of power as Ignis as a Magical Girl."},{"spoiler":false,"text":"Translated from the official character description"}],"source":"vndb","sourceCharacterId":"c83254"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/6309b8fff4c307bfe8b37c2c186170e6d71bc4dc0e70c7d3d551ec96a76d4f20.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52b72d244743fd9edb36b8787fb3a8b3eca3b3fd873a696bc52b055333d72dd5.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c91109","characterName":"灰原 カイ","sourceIds":{"vndbCharacterId":"c91109"},"originalCharacterName":"灰原 カイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4f2f042088861da315ff35ae625d770847e4d5c2302f1efb8d8ae04aff7e777.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6e9b633d9f7f4a8c03ad3b746ed3e87028ca7af4ff35ed8a8d5233aac0b92ff4.webp","width":203,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:4263","sourceCompanyId":"egs: