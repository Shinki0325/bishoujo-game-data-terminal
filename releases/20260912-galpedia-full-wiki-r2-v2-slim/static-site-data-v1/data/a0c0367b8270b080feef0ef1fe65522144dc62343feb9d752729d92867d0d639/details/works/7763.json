に弱い。"}],"source":"bangumi","sourceCharacterId":"211107"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/baed8e6b5f748f1247131a97e7827431ccb3a4b8a4459929e9b971ae6d73f0da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b50df3778ff0db14dfca26be6b92f84dfc68e01ab1028334ffc7f8e857f69a0a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤咲かおり","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"藤咲 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:202162:211107:6105:1","source":"bangumi"}]},{"characterId":"char_c13367","characterName":"綾河 春生","sourceIds":{"bangumi":[{"characterId":"211068","match":"exact-normalized-name-in-linked-work","subjectId":"202162"}],"egsCharacterIds":["7415"],"vndbCharacterId":"c13367"},"originalCharacterName":"綾河 春生","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"D"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"美也子の娘。女子校生。"},{"spoiler":false,"text":"母に似てスタイル抜群の美少女。"},{"spoiler":false,"text":"陽気な性格で、家の中でも一人で騒ぎまわるムードメーカー的な存在。"},{"spoiler":false,"text":"叔母である美桜乃とは仲が良く、何かと一緒に居ることが多い。"},{"spoiler":false,"text":"美桜乃の影響でやや耳年増だが、男性経験はなく処女。"}],"source":"egs","sourceCharacterId":"7415","sourceWorkId":"7763","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の生物講師。貴樹の従姉でもある。"},{"spoiler