elationId":"vndb:vn-staff:25371","source":"vndb"},{"creditedName":"佐藤 ひろ美","creatorId":"vndb:s398","sourcePersonId":"vndb:s398","canonicalEntityId":"vndb:s398","name":"佐藤 ひろ美","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:25372","source":"vndb"},{"creditedName":"有里亜","creatorId":"vndb:s983","sourcePersonId":"vndb:s983","canonicalEntityId":"vndb:s983","name":"有里亜","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:25375","source":"vndb"},{"creditedName":"RMG Rainbow-Motion-Graphics","creatorId":"vndb:s2828","sourcePersonId":"vndb:s2828","canonicalEntityId":"vndb:s2828","name":"RMG Rainbow-Motion-Graphics","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:25379","source":"vndb"},{"creditedName":"しんたろー","creatorId":"vndb:s4224","sourcePersonId":"vndb:s4224","canonicalEntityId":"vndb:s4224","name":"しんたろー","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:25380","source":"vndb"},{"creditedName":"山川 竜一郎","creatorId":"vndb:s6198","sourcePersonId":"vndb:s6198","canonicalEntityId":"vndb:s6198","name":"山川 竜一郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:25382","source":"vndb"},{"creditedName":"molion","creatorId":"vndb:s12614","sourcePersonId":"vndb:s12614","canonicalEntityId":"vndb:s12614","name":"石森 昭博","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:25384","source":"vndb"},{"creditedName":"Bee'","creatorId":"vndb:s25513","sourcePersonId":"vndb:s25513","canonicalEntityId":"vndb:s25513","name":"Bee'","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:25385","source":"vndb"},{"creditedName":"兎月","creatorId":"vndb:s50976","sourcePersonId":"vndb:s50976","canonicalEntityId":"vndb:s50976","name":"兎月","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:25387","source":"vndb"},{"creditedName":"されな姫","creatorId":"vndb:s51995","sourcePersonId":"vndb:s51995","canonicalEntityId":"vndb:s51995","name":"されな姫","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:25388","source":"vndb"},{"creditedName":"烏丸 紅雪","creatorId":"vndb:s52674","sourcePersonId":"vndb:s52674","canonicalEntityId":"vndb:s52674","name":"烏丸紅雪","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:25389","source":"vndb"}]},"cast":[{"characterId":"char_c1074","characterName":"翼美羽","sourceIds":{"bangumi":[{"characterId":"133467","match":"exact-normalized-name-in-linked-work","subjectId":"99049"}],"egsCharacterIds":["13534"],"vndbCharacterId":"c1074"},"originalCharacterName":"翼美羽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Miu is a girl that met Yuuta ten years before the story begins, as the daughter of a family that had just moved into the town of Tokimori. Miu and Chizuru get along extremely well and compliment each other through their naturally playful personalities. In general, Miu can be thought of as a simple person, finding joy and fun in things that the other members of the cast shrug off. At the same time, she is very insightful and likes to stay under the radar when it comes to what she knows. Her lack of understanding when it comes to certain things lead to comic situations that put our protagonist on the spot, as well."},{"spoiler":false,"text":"From Moroboshi Yuumei's review"}],"source":"vndb","sourceCharacterId":"c1074"},{"segments":[{"spoiler":false,"text":"【「想い出の塔」で出会う、不思議な少女】"},{"spoiler":false,"text":"街外れの塔のふもとに倒れていた少女。"},{"spoiler":false,"text":"記憶がなく、自分の名前以外は覚えていないため、"},{"spoiler":false,"text":"主人公の従姉妹の家で面倒を見ることになる。"},{"spoiler":false,"text":"記憶は無いのだが、でもなぜか主人公のことが好き。"},{"spoiler":false,"text":"性格は明るくて活発、主人公が好きであることを周りにもアピール。"},{"spoiler":false,"text":"素直で自分の気持ちに対してまっすぐ。"}],"source":"egs","sourceCharacterId":"13534","sourceWorkId":"5132","spoiler":false},{"segments":[{"spoiler":false,"text":"「にっひっひ、雄太だーい好き」"},{"spoiler":false,"text":"街外れの塔のふもとに倒れていた少女。"},{"spoiler":false,"text":"記憶がなく、自分の名前以外は覚えていないため、主人公の従姉妹の家で面倒を見ることになる。"},{"spoiler":false,"text":"記憶は無いのだが、でもなぜか主人公のことが好き。"},{"spoiler":false,"text":"性格は明るくて活発、主人公が好きであることを周りにもアピール。"},{"spoiler":false,"text":"素直で自分の気持ちに対してまっすぐ。"}],"source":"bangumi","sourceCharacterId":"133467"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1c8928cb5d5a24ebd209f2adbe26e630934cab6018f8e8319998c38f04d8f7b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/242c2738205c61d560d15177714c2176ac3bdc8f69682a73c758866994d065ee.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99049:133467:4832:1","source":"bangumi"}]},{"characterId":"char_c1075","characterName":"春日野陽菜","sourceIds":{"bangumi":[{"characterId":"133468","match":"exact-normalized-name-in-linked-work","subjectId":"99049"}],"egsCharacterIds":["13535"],"vndbCharacterId":"c1075"},"originalCharacterName":"春日野陽菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haruna is one of the two girls Yuuta used to know from ten years before BMG begins. Unlike Miu, Haruna has always been shy and reserved."},{"spoiler":false,"text":"Haruna used to play with Yuuta and Miu back when they were kids, and got along quite well with both. Still, she always felt as the odd man in their trio, since the chemistry between our protagonist and Miu was very strong. Her feelings for Yuuta are so strong that she has managed to remember many things about him from ten years ago, hoping to one day meet with him again and tell him how she feels."},{"spoiler":false,"text":"As a second year high school student, Haruna is president of the school's Magical Club. Contrary to its name, the club actually focuses on doing volunteer work and helping out when called upon. Much to her chagrin, the Science Club's president constantly tries to instigate competition between the two clubs, convinced that the idea of magic is silly compared to the tangible results gained through scientific research."},{"spoiler":false,"text":"Her shyness aside, Haruna is easily led on for the most part. She's not a complete pushover, though, as going too far will get some sort of physical reaction. She's also notably jealous, and her demeanor can easily change if her buttons are pushed too much."},{"spoiler":false,"text":"From Moroboshi Yuumei's review."}],"source":"vndb","sourceCharacterId":"c1075"},{"segments":[{"spoiler":false,"text":"【主人公の事を一途に想い続ける健気な幼馴染】"},{"spoiler":false,"text":"時森学園2年生で主人公の幼なじみ。"},{"spoiler":false,"text":"主人公がこの町を去った後、"},{"spoiler":false,"text":"自分の怪我を治した「白馬の王子様」ならぬ、"},{"spoiler":false,"text":"「私の魔法使い」である、主人公への想いをずっと秘め、"},{"spoiler":false,"text":"来る日も来る日も主人公が残していった「魔法の本」を眺めていた。"},{"spoiler":false,"text":"そのうちそれは魔法自体への興味となり、"},{"spoiler":false,"text":"それを調べていれば主人公が帰ってくると思い込むようになる。"},{"spoiler":false,"text":"そしてその思いが、「まじかる部」なる同好会を作ってしまう。"},{"spoiler":false,"text":"まじかる部が有名になれば、きっと主人公が帰ってくるに違いないと…。"},{"spoiler":false,"text":"性格はおとなしいが努力家。控えめで極端に謙遜する。"},{"spoiler":false,"text":"クラスのみんなには慕われている。"}],"source":"egs","sourceCharacterId":"13535","sourceWorkId":"5132","spoiler":false},{"segments":[{"spoiler":false,"text":"「だって……また会えるなんて、思わなかった」"},{"spoiler":false,"text":"時森学園2年生で主人公の幼なじみ。"},{"spoiler":false,"text":"主人公がこの町を去った後、自分の怪我を治した「白馬の王子様」ならぬ、「私の魔法使い」である、主人公への想いをずっと秘め、来る日も来る日も主人公が残していった「魔法の本」を眺めていた。"},{"spoiler":false,"text":"そのうちそれは魔法自体への興味となり、それを調べていれば主人公が帰ってくると思い込むようになる。"},{"spoiler":false,"text":"そしてその思いが、「まじかる部」なる同好会を作ってしまう。まじかる部が有名になれば、きっと主人公が帰ってくるに違いないと…。"},{"spoiler":false,"text":"性格はおとなしいが努力家。控えめで極端に謙遜する。"},{"spoiler":false,"text":"クラスのみんなには慕われている。"}],"source":"bangumi","sourceCharacterId":"133468"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3ccfb0efb6c48b1bf9d2ff8557f17c517f7bebea2597beb1f1c25f6f7711cb60.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/3620aaa2752c021296bfe79c854bee8357fd17ed1697912ca6291fd785a921b0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神田理江","creatorId":"vndb:s858","sourcePersonId":"vndb:s858","canonicalEntityId":"vndb:s858","name":"神田 理江","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99049:133468:4618:1","source":"bangumi"}]},{"characterId":"char_c1076","characterName":"真行寺真央","sourceIds":{"bangumi":[{"characterId":"133469","match":"exact-normalized-name-in-linked-work","subjectId":"99049"}],"egsCharacterIds":["13536"],"vndbCharacterId":"c1076"},"originalCharacterName":"真行寺真央","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mao is introduced as an underclassman that is also the vice-president of the Magical Club. At the beginning of the story, Mao acts like the jealous first year girl that is set on protecting Haruna from Yuuta. She can tell that her senpai has feelings for our protagonist, so she at first tries to keep him from joining the Magical Club."},{"spoiler":false,"text":"Despite initial antagonism and her attempts to make Yuuta look bad in front of Haruna, Mao realizes that Haruna's happiness is more important, and later decides to turn our protagonist into the \"ideal guy\" for her beloved senpai. Unsurprisingly, some her ideas on how a guy should be like tend to be outlandish, but at times does give worthwhile advice. The focus shifts to getting to know our protagonist when she realizes he won't be transforming into a cool guy any time soon."},{"spoiler":false,"text":"Personality-wise, Mao is generally cheerful, if extremely protective of Haruna. She willingly does anything Haruna asks her to. She also has a very perverse imagination that manifests whenever she thinks about herself and Yuuta."},{"spoiler":false,"text":"From Moroboshi Yuumei's review"}],"source":"vndb","sourceCharacterId":"c1076"},{"segments":[{"spoiler":false,"text":"【陽菜とエロゲが大好きな後輩】"},{"spoiler":false,"text":"陽菜への密かな憧れをもつ下級生。というかむしろラヴ。"},{"spoiler":false,"text":"性格はちょっとおっちょこちょい。"},{"spoiler":false,"text":"でも陽菜を立てたい一心で主人公に食って掛かったりする。"},{"spoiler":false,"text":"陽菜に一目ぼれして、まじかる部に入部。"},{"spoiler":false,"text":"家庭環境は、両親と兄一人。"},{"spoiler":false,"text":"兄の部屋にある、エロゲー、エロ漫画を良く盗み見する。"},{"spoiler":false,"text":"その影響で、よくエロい妄想にふけってしまう。"}],"source":"egs","sourceCharacterId":"13536","sourceWorkId":"5132","spoiler":false},{"segments":[{"spoiler":false,"text":"「陽菜先輩には、指一本触れさせませんからね！！」"},{"spoiler":false,"text":"陽菜への密かな憧れをもつ下級生。というかむしろラヴ。"},{"spoiler":false,"text":"性格はちょっとおっちょこちょい。でも陽菜を立てたい一心で主人公に食って掛かったりする。"},{"spoiler":false,"text":"陽菜に一目ぼれして、まじかる部に入部。"},{"spoiler":false,"text":"家庭環境は、両親と兄一人。"},{"spoiler":false,"text":"兄の部屋にある、エロゲー、エロ漫画を良く盗み見する。"},{"spoiler":false,"text":"その影響で、よくエロい妄想にふけってしまう。"}],"source":"bangumi","sourceCharacterId":"133469"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c5be9136eddaefabe2d4368646f1878215a351a12564788d4201383a02d82ef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67415a048b7266967ec639c43e85a6b4183d70a9594bd69ecd662a8387fa3e00.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99049:133469:4463:1","source":"bangumi"}]},{"characterId":"char_c1077","characterName":"雲谷千鶴","sourceIds":{"bangumi":[{"characterId":"133470","match":"exact-normalized-name-in-linked-work","subjectId":"99049"}],"egsCharacterIds":["13537"],"vndbCharacterId":"c1077"},"originalCharacterName":"雲谷千鶴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Chizuru is Yuuta's older cousin, and is in charge of the house she shares with our protagonist while her parents are away on business."},{"spoiler":false,"text":"At a first glance, Chizuru is a very non-serious character, preferring to joke around and do the occasional odd thing. At heart, however, she is a very responsible girl who feels a little overwhelmed by having to run her family's coffeehouse, \"The Mysterious Spire\". Her playfulness aside, Chizuru is actually very strict when it comes to the rules of the house, and often penalizes those that break curfew or fail to do as they're told with \"fines\" that must be paid by dropping money into her piggy bank."},{"spoiler":false,"text":"A constant running gag with Chizuru is that despite making a living brewing coffee and baking snacks, she's actually a terrible cook."},{"spoiler":true,"text":"This trait goes from gag to plot point when we discover that the reason her cooking is so questionable is because she lost her sense of taste a couple of years before BMG began. The cause is left unknown for the most part, but Chizuru has the feeling that it might be connected to the Spire of Memories."},{"spoiler":false,"text":"As the older sister of the group (even if she's only a year older than Yuuta, Haruna and Miu), Chizuru is held in high regard by the other members of the cast. She prefers to be cute and playful, but can very easily put Yuuta in his place. At times her sense of humor gets the better of her, causing her to do more harm than good when it comes to some of the predicaments Yuuta gets into."},{"spoiler":false,"text":"From Moroboshi Yuumei's review"}],"source":"vndb","sourceCharacterId":"c1077"},{"segments":[{"spoiler":false,"text":"【面倒見の良い頼りになるお姉さん】"},{"spoiler":false,"text":"主人公の従姉。時森学園3年生。"},{"spoiler":false,"text":"非常に面倒見がよく、精神年齢も高い良いお姉さん。"},{"spoiler":false,"text":"もちろん、居候の主人公の面倒も見て、家事全般もこなす…が、"},{"spoiler":false,"text":"ちょっと性格と言動がへんなのがたまにきず。"},{"spoiler":false,"text":"主人公と陽菜とは幼少からの付き合いで、"},{"spoiler":false,"text":"それぞれ弟、妹のように可愛がりよく相談に乗ってあげる。"},{"spoiler":false,"text":"放課後はすぐに家に帰り、"},{"spoiler":false,"text":"家に併設された両親の経営する喫茶店を手伝っている。"}],"source":"egs","sourceCharacterId":"13537","sourceWorkId":"5132","spoiler":false},{"segments":[{"spoiler":false,"text":"「いいの。とにかく、わたしがしたいんだから、"},{"spoiler":false,"text":"黙って言うこと聞きなさい」"},{"spoiler":false,"text":"主人公の従姉。時森学園3年生。"},{"spoiler":false,"text":"非常に面倒見がよく、精神年齢も高い良いお姉さん。"},{"spoiler":false,"text":"もちろん、居候の主人公の面倒も見て、家事全般もこなす…が、ちょっと性格と言動がへんなのがたまにきず。"},{"spoiler":false,"text":"主人公と陽菜とは幼少からの付き合いで、それぞれ弟、妹のように可愛がりよく相談に乗ってあげる。"},{"spoiler":false,"text":"放課後はすぐに家に帰り、家に併設された両親の経営する喫茶店を手伝っている。"}],"source":"bangumi","sourceCharacterId":"133470"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/9254628596cfe25d392a0f334e23ecaf1252dd8bf85a490294094555f4b172b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/ba68dcda13467d8730509eeb7721c0ade0d871eb51ae8a3baa5cf1fe2d35e2c4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高野直子","creatorId":"vndb:s14","sourcePersonId":"vndb:s14","canonicalEntityId":"vndb:s14","name":"高野 直子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99049:133470:4031:1","source":"bangumi"}]},{"characterId":"char_c1078","characterName":"相馬七海","sourceIds":{"bangumi":[{"characterId":"133471","match":"exact-normalized-name-in-linked-work","subjectId":"99049"}],"egsCharacterIds":["13538"],"vndbCharacterId":"c1078"},"originalCharacterName":"相馬七海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Nanami is a girl that lives next door to the Kumotani family, and is good friends with Chizuru."},{"spoiler":false,"text":"Being at least two years younger than Yuuta, Nanami still has many things to learn and understand ahead of her. As she is something of a slow learner, Chizuru at one point was tutoring her in math and English. Sadly, after Chizuru's parents went away, there was no one to help her keep up in school until Yuuta came along."},{"spoiler":false,"text":"From Moroboshi Yuumei's review."}],"source":"vndb","sourceCharacterId":"c1078"},{"segments":[{"spoiler":false,"text":"【カニ玉が好物なマジメでおとなしい下級生】"},{"spoiler":false,"text":"千鶴に家庭教師をしてもらっている、近所の学院生。"},{"spoiler":false,"text":"いつも、喫茶店で勉強を教えてもらっている。"},{"spoiler":false,"text":"結構気弱で、まじめなおとなしい女の子。"},{"spoiler":false,"text":"好きな食べ物はカニ玉。"}],"source":"egs","sourceCharacterId":"13538","sourceWorkId":"5132","spoiler":false},{"segments":[{"spoiler":false,"text":"「七海、こんな気持ちになったの初めてだよ……」"},{"spoiler":false,"text":"千鶴に家庭教師をしてもらっている、近所の学院生。"},{"spoiler":false,"text":"いつも、喫茶店で勉強を教えてもらっている。"},{"spoiler":false,"text":"結構気弱で、まじめなおとなしい女の子。"},{"spoiler":false,"text":"好きな食べ物はカニ玉。"}],"source":"bangumi","sourceCharacterId":"133471"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/697e01ada8da0f50f31dbe9fae3b9c7340e7b98561d1f93113a68c1c67758827.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58bae4548a8db1e08cea48b3cb166f46ca740ed4c38b23e0748d555c9834fbfe.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本井えみ","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99049:133471:4177:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p336","sourceCompanyId":"egs:brand:275","canonicalEntityId":"vndb:p336","name":"FrontWing","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:5132:275","source":"egs"},{"companyId":"vndb:p336","sourceCompanyId":"vndb:p336","canonicalEntityId":"vndb:p336","name":"Frontwing","roleCodes":["developer","publisher"],"identityStatus":"source-native","relat