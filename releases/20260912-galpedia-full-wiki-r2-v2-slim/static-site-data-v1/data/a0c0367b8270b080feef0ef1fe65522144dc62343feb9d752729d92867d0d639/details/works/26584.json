or","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:147348","source":"vndb"},{"creditedName":"野山 風一郎","creatorId":"vndb:s8747","sourcePersonId":"vndb:s8747","canonicalEntityId":"vndb:s8747","name":"野山 風一郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:147351","source":"vndb"},{"creditedName":"Umi.","creatorId":"vndb:s6199","sourcePersonId":"vndb:s6199","canonicalEntityId":"vndb:s6199","name":"umi","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:147355","source":"vndb"},{"creditedName":"Aintops","creatorId":"vndb:s6186","sourcePersonId":"vndb:s6186","canonicalEntityId":"vndb:s6186","name":"吉田 省吾","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:147357","source":"vndb"}]},"cast":[{"characterId":"char_c47589","characterName":"シンフォニックシュガー","sourceIds":{"bangumi":[{"characterId":"96141","match":"exact-normalized-name-in-linked-work","subjectId":"222233"}],"egsCharacterIds":["2314"],"vndbCharacterId":"c47589"},"originalCharacterName":"シンフォニックシュガー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"AB"},"bust":{"reviewState":"source-only","source":"vndb","value":"76"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"普段は物静かな天才科学者。シンフォニックリリーに信頼以上の気持ちを寄せいている。"},{"spoiler":false,"text":"対ファルケ・シルヴァ抵抗組織『白薔薇』のメンバーとして莉々奈を奪回しようとエクセリウムで活動中。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"冷静沈着ながら敵対した相手には容赦のない攻撃をする。"},{"spoiler":false,"text":"今まで虚勢を張りながらも堕ちきらなかった彼女が心の支えのない中精神を疲労させていき姦計にはまっていく。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"19685","spoiler":false},{"segments":[{"spoiler":false,"text":"「私の声が聞こえたのなら、きっと莉々奈さんが私を呼んでくれたからです」"},{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"普段は物静かで冷静沈着な天才科学者。"},{"spoiler":false,"text":"莉々奈とは厚い信頼関係に結ばれており、理論・技術面から百合瀬財団の活動を支えている。"},{"spoiler":false,"text":"幼げな容姿に似合わない強靭な意思と折れない心を持つ。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士シンフォニックナイツ」ほか"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"天才的な頭脳を持つ世界的な科学者。"},{"spoiler":false,"text":"シンフォニックリリーとともに国際教導学園から身を引き、自らの魔法研究を進める傍ら魔法戦士として活動を続けている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"28226","spoiler":false},{"segments":[{"spoiler":false,"text":"歴戦の魔法戦士、シンフォニックナイツの一人。"},{"spoiler":false,"text":"物静かで冷静沈着、数々の魔法理論や技術を開発している天才科学者。"},{"spoiler":false,"text":"現在は異世界ロアにて研究活動を行っており、時折レムティアシータに技術的なアドバイスを与えている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"31509","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックナイツの一人、シンフォニックシュガー。本名は甘樹菜々芭。"},{"spoiler":false,"text":"優秀な技術者で、魔法戦士たちの新たな力をいくつも開発する。"},{"spoiler":false,"text":"国際教導学園で教師として働きながら、魔法技術の研究も怠らない。"},{"spoiler":false,"text":"シンフォニックリリーである百合瀬莉々奈とは深い絆で結ばれたパートナー。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックナイツの一人、シンフォニックシュガー。優秀な研究者、技術者として、魔法戦士たちの勝利を支えている。同じシンフォニックナイツの一人である莉々奈とは深い絆で結ばれており、彼女の経営する国際教導学園で教師としても働いている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"40423","spoiler":false},{"segments":[{"spoiler":false,"text":"見た目は幼げな、物静かで無表情な天才技術者"},{"spoiler":false,"text":"集中し始めると周りのことが全く目に入らなくなる"},{"spoiler":false,"text":"その明晰な頭脳を巡って両親が争い、挙げ句二人ともが不慮の死を遂げたため、自分の持つ才能に嫌悪感すら持ってしまっていた。そのためか、感情の表現もうまくない。"},{"spoiler":false,"text":"莉々奈に出会ったことでその頭脳を人類のために役立てることに喜びと、両親への贖罪を見いだす。また、自分の力を役立てる道を見つけてくれた莉々奈に対し、信頼関係以上の感情を抱いている。"}],"source":"bangumi","sourceCharacterId":"96141"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/8609a430ae70cca7f0b6e759a667e02697a36c766f741c77a34be38ffd50cffc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/1712c987ff84caddb112cef83a5939ceff92a62c4c53b935d6c40b3f59bc9fff.webp","width":156,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271689:96141:4810:1","source":"bangumi"}]},{"characterId":"char_c83231","characterName":"イクシードアイリス","sourceIds":{"bangumi":[{"characterId":"96172","match":"exact-normalized-name-in-linked-work","subjectId":"271689"},{"characterId":"96172","match":"exact-normalized-name-in-linked-work","subjectId":"279307"},{"characterId":"96172","match":"exact-normalized-name-in-linked-work","subjectId":"421425"}],"egsCharacterIds":["21108"],"vndbCharacterId":"c83231"},"originalCharacterName":"イクシードアイリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"国際教導学園の中でも特に優秀なエリート。"},{"spoiler":false,"text":"責任感が強く完璧主義で潔癖症。"},{"spoiler":false,"text":"エリートゆえの使命感が強く、正義とは秩序であり、強者により与えられるものだと考えており、それこそが全てを守る唯一の方法だと信じている。"}],"source":"egs","sourceCharacterId":"21108","sourceWorkId":"26584","spoiler":false},{"segments":[{"spoiler":false,"text":"国際教導学園の生徒。"},{"spoiler":false,"text":"イクシードナイツの一人、イクシードアイリス。"},{"spoiler":false,"text":"学業、実技ともに優秀で、将来を嘱望されている魔法科のエリート。"},{"spoiler":false,"text":"生徒会長でもある。"},{"spoiler":false,"text":"秩序を守ることが正義を実現する唯一の方法だと信じていたが。"},{"spoiler":false,"text":"様々な体験を通じて柔軟に考えるようになった。"}],"source":"egs","sourceCharacterId":"21108","sourceWorkId":"27830","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士イクシードナイツの一人、イクシードアイリス。本名は裁明寺紫鶴。"},{"spoiler":false,"text":"国際教導学園の学生の中でも特に優秀で、生徒会長を務めている。"},{"spoiler":false,"text":"完璧主義で潔癖症なところがあったが、様々な経験を経て最近は柔軟にものを考えるようになった。"},{"spoiler":false,"text":"魔法戦士の使命と巨大財団総帥の仕事を同時にこなす莉々奈をとても尊敬している。"}],"source":"egs","sourceCharacterId":"21108","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"国際教導学園の生徒。"},{"spoiler":false,"text":"イクシードナイツの一人、イクシードアイリス。"},{"spoiler":false,"text":"学業、実技ともに優秀で、将来を嘱望されている魔法科のエリート。"},{"spoiler":false,"text":"生徒会長でもある。"},{"spoiler":false,"text":"秩序を守ることが正義を実現する唯一の方法だと信じていたが。"},{"spoiler":false,"text":"様々な体験を通じて柔軟に考えるようになった。"},{"spoiler":false,"text":"「同じく、魔法戦士イクシードアイリスです。魔法戦士が来た以上、魔物たちの好きにはさせません。安心して避難してください。」"}],"source":"bangumi","sourceCharacterId":"96172"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39c176f570cc18f492c22cc2e9002b67ed2d594d0133ab4e5466e092d6596874.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b90b03d366b515a0991c9a3d0ccc64cb5b51d78557ba4ed3d2eeb6c225198d11.webp","width":234,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北村彩","creatorId":"vndb:s912","sourcePersonId":"vndb:s912","canonicalEntityId":"vndb:s912","name":"北村 彩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271689:96172:6046:1","source":"bangumi"}]},{"characterId":"char_c83232","characterName":"ノエル","sourceIds":{"bangumi":[{"characterId":"96175","match":"exact-normalized-name-in-linked-work","subjectId":"271689"},{"characterId":"96175","match":"exact-normalized-name-in-linked-work","subjectId":"279307"},{"characterId":"96175","match":"exact-normalized-name-in-linked-work","subjectId":"421425"}],"egsCharacterIds":["21110"],"vndbCharacterId":"c83232"},"originalCharacterName":"ノエル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の副官を務める不思議な雰囲気の少女。"},{"spoiler":false,"text":"ある日突然現れ、主人公に特別な力があると告げて、悪の野望へと導く。身の回りの世話や魔法知識のアドバイスなど、様々なサポートを行ってくれる。"},{"spoiler":false,"text":"性格は明るく、お茶目で憎めない。出身などは不明。"}],"source":"egs","sourceCharacterId":"21110","sourceWorkId":"26584","spoiler":false},{"segments":[{"spoiler":false,"text":"副官としてキールをサポートしていた少女。"},{"spoiler":false,"text":"ココノ・アクアの代行者を名乗り、キールの陰になり日向になり支えていた。"},{"spoiler":false,"text":"明るく茶目っ気のある性格で、主であるキールもからかったりする。"},{"spoiler":false,"text":"過去や出身などパーソナルな部分については不明な点が多い。"},{"spoiler":false,"text":"魔法戦士との戦いで瀕死の重傷を負い、ゲートの奥深くで眠りについている。"}],"source":"egs","sourceCharacterId":"21110","sourceWorkId":"27830","spoiler":false},{"segments":[{"spoiler":false,"text":"キールとともに未来の並行世界からやってきた少女。メッツァーの息子であるキールを、父親と同じ覇王の道へと導き、副官として彼を支えている。"},{"spoiler":false,"text":"キールに強い愛情を抱いており、キールもまたノエルのことを大切に思っている。"},{"spoiler":false,"text":"生い立ちなど謎の多い彼女だが、その真実が明かされた時、最悪の悲劇が彼女たちを襲うことになる。"}],"source":"egs","sourceCharacterId":"21110","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"副官としてキールをサポートしていた少女。"},{"spoiler":false,"text":"ココノ・アクアの代行者を名乗り、"},{"spoiler":false,"text":"キールの陰になり日向になり支えていた。"},{"spoiler":false,"text":"明るく茶目っ気のある性格で、"},{"spoiler":false,"text":"主であるキールもからかったりする。"},{"spoiler":false,"text":"過去や出身などパーソナルな部分については不明な点が多い。"},{"spoiler":false,"text":"魔法戦士との戦いで瀕死の重傷を負い、"},{"spoiler":false,"text":"ゲートの奥深くで眠りについている。"},{"spoiler":false,"text":"「キール様、実は今日、何と危険日なんです！チャンスです！今がチャンスですよ！さあ、レッツベッドイン！」"}],"source":"bangumi","sourceCharacterId":"96175"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c36e7d14292b0ee8f81a7303f16109e4ba930aa573bce2068641e40456581393.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96b686a10a1823b182bac78dd13a99a3051315aa91cfd5ddcc90acbd0d617bc5.webp","width":160,"height":256,"source":"static-detail"},"actors":[{"creditedName":"八ッ橋きなこ","creatorId":"vndb:s353","sourcePersonId":"vndb:s353","canonicalEntityId":"vndb:s353","name":"八ッ橋きなこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:271689:96175:16170:1","source":"bangumi"}]},{"characterId":"char_c83235","characterName":"イクシードピーチ","sourceIds":{"bangumi":[{"characterId":"96171","match":"exact-normalized-name-in-linked-work","subjectId":"271689"},{"characterId":"96171","match":"exact-normalized-name-in-linked-work","subjectId":"279307"},{"characterId":"96171","match":"exact-normalized-name-in-linked-work","subjectId":"421425"}],"egsCharacterIds":["21107"],"vndbCharacterId":"c83235"},"originalCharacterName":"イクシードピーチ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"国際教導学園の生徒。"},{"spoiler":false,"text":"正義感が強く素直で純真。 運動神経優秀。"},{"spoiler":false,"text":"何事にも一生懸命で魔法戦士にあこがれており、「変身して悪と戦う」ことに高揚感を持っている。"},{"spoile