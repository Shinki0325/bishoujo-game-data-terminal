"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"５１"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人懐っこく、無垢な笑顔を振りまく少女"},{"spoiler":false,"text":"――ではなく、これでもれっきとした大人の女性で、王立学校の教師も務めている。"},{"spoiler":false,"text":"魔術専攻学級を受け持つ彼女は、類稀なる才能から、グラマンの筆頭魔術師と称される実力の持ち主。"}],"source":"egs","sourceCharacterId":"27060","sourceWorkId":"3524","spoiler":false},{"segments":[{"spoiler":false,"text":"人懐こく、いかなる時も無垢な笑顔を絶やさない明朗な少女――ではなく、これでも歴とした大人の女性。外見だけを見るなら○○のそれに違いないのだが、その実はマグランにあって筆頭魔術師と称されるほど強い力を秘めており、若くして王立学校の教師に就いた。学校では魔術専攻学級を受け持っている。教師としても才能豊かで、また生徒からは妹的位置づけとしても好かれている。"}],"source":"bangumi","sourceCharacterId":"77743"}],"profileFacts":[{"label":"胸围（本版本）","value":"64 cm","valueContext":null,"source":"egs","sourceCharacterId":"27060","sourceWorkId":"3524","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"139 cm","valueContext":null,"source":"egs","sourceCharacterId":"27060","sourceWorkId":"3524","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"65 cm","valueContext":null,"source":"egs","sourceCharacterId":"27060","sourceWorkId":"3524","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"51 cm","valueContext":null,"source":"egs","sourceCharacterId":"27060","sourceWorkId":"3524","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/170fc051c9e3478c01c749e532e7a24fc3b8e1dc6ab70dacea2a528810432978.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f7b87877d221e98b546c0012d92df0a1e2dbf006d56760eb93eb0c2d06e25b4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99023:77743:5890:1","source":"bangumi"}]},{"characterId":"char_vndb_c51713