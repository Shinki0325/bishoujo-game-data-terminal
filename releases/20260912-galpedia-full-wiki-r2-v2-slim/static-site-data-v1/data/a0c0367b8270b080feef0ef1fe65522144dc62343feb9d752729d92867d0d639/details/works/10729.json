47b061817b70aa656f406cdc0dbbf091e9863dab05dc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72dc2e83521a9861636a2c64220bac464242498e03eb70226ad494709302043e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150340:142868:4830:1","source":"bangumi"}]},{"characterId":"char_c44113","characterName":"神千院 マリエ","sourceIds":{"bangumi":[{"characterId":"88328","match":"exact-normalized-name-in-linked-work","subjectId":"150340"}],"egsCharacterIds":["18355"],"vndbCharacterId":"c44113"},"originalCharacterName":"神千院 マリエ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【つるぺたのツンデレお嬢様】"},{"spoiler":false,"text":"優太朗の幼馴染で、大富豪のお嬢様。"},{"spoiler":false,"text":"花嫁候補だが、お嬢様らしく家事はまるっきりダメ。"},{"spoiler":false,"text":"すぐにテンパる泣き虫娘だが、めげることなく頑張って生きている。"},{"spoiler":false,"text":"未知のパワーで『武装花嫁ユニティマリエル』に変身！"},{"spoiler":false,"text":"護衛ロボ“エリザベス”に乗り込み、敵に立ち向かう。"},{"spoiler":false,"text":"「あんなザコ、さっさとやっつけちゃうわよ、リズ！」"}],"source":"egs","sourceCharacterId":"18355","sourceWorkId":"10729","spoiler":false},{"segments":[{"spoiler":false,"text":"ユニティマリアージュ ～ふたりの花嫁～ユニゾンシフト・アクセント"},{"spoiler":false,"text":"大富豪のツンデレお嬢様。料理をはじめ家事全般がまるでダメだが、"},{"spoiler":false,"text":"護衛ロボ「エリザベス」に乗り込み「武装花嫁ユニティマリエル」に変身し悪に立ち向かう。"}],"source":"egs","sourceCharacterId":"18355","sourceWorkId":"16176","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼なじみで大富豪のツンデレお嬢様。"},{"spoiler":false,"text":"すぐにテンパる泣き虫娘だが、がんばって生きようとする。家事は全然ダメ。好物はねこまんま。"},{"spoiler":false,"text":"指輪から溢れる未知のパワーを使って、正義のヒロイン『武装花嫁ユニティマリエル』に変身！"},{"spoiler":false,"text":"さらに護衛ロボのエリザベスに乗り込んで機械帝国に立ち向かう。"},{"spoiler":false,"text":"「あんなザコ、さっさとやっつけちゃうわよ、リズ！」"}],"source":"bangumi","sourceCharacterId":"88328"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a6cde59e27ea9efc3aca13d3bb8223bcb17a4cd5731cd82ca16760aeb97f5f2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb082041db0d55df734746e1e7c9b7a407e5f5eb4ed40fba1d77d6a7d4ce1766.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"すずきけいこ","creatorId":"vndb:s445","sourcePersonId":"vndb:s445","canonicalEntityId":"vndb:s445","name":"涼森ちさと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150340:88328:6275:1","source":"bangumi"}]},{"characterId":"char_c44114","characterName":"風見 芽衣","sourceIds":{"bangumi":[{"characterId":"142869","match":"exact-normalized-name-in-linked-work","subjectId":"150340"}],"egsCharacterIds":["18356"],"vndbCharacterId":"c44114"},"originalCharacterName":"風見 芽衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【素直でクールなスレンダーメガネっ子】"},{"spoiler":false,"text":"機械帝国によって生み出されたアンドロイド。"},{"spoiler":false,"text":"人間の性に興味津々、エッチなことも平気で尋ねてくる。"},{"spoiler":false,"text":"指輪から溢れる未知のパワーで変身、『鉄腕花嫁ユニティメイ』となって、機械大統領を邪険に扱いながら、"},{"spoiler":false,"text":"妨害してくるが……？"},{"spoiler":false,"text":"「人間のこと、もっと教えて」"}],"source":"egs","sourceCharacterId":"18356","sourceWorkId":"10729","spoiler":false},{"segments":[{"spoiler":false,"text":"機械帝国の力によって生み出されたアンドロイド。"},{"spoiler":false,"text":"人間の性に興味津々でエッチなことも平気で尋ねる。"},{"spoiler":false,"text":"指輪から溢れる未知のパワーを使って変身！"},{"spoiler":false,"text":"機械大統領を邪険に扱いつつ、『鉄腕花嫁ユニティメイ』になって妨害してくる！"},{"spoiler":false,"text":"「人間のこと、もっと教えて」"}],"source":"ba