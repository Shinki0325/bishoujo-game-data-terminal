r":false,"text":"料理上手で家事もそつなくこなす良い奥さんタイプだが、ちょっぴり抜けていることも。"},{"spoiler":false,"text":"正義のヒロイン『怪傑花嫁Zオンナ』になって、機械帝国と戦う柚乃やマリエをこっそりサポートする。"},{"spoiler":false,"text":"「お仕置きされたいコはかかっておいで！」"}],"source":"bangumi","sourceCharacterId":"142870"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6abda99e33ea1c1671b2c8db95719c8aed4e5139db26dcba1855191e31f10ac6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64045416a4cf40319dee058617243131d44568fbc607ad410859fc185eaf90b1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:150340:142870:4832:1","source":"bangumi"}]},{"characterId":"char_c44116","characterName":"ブルンダーさん","sourceIds":{"bangumi":[],"egsCharacterIds":["18360"],"vndbCharacterId":"c44116"},"originalCharacterName":"ブルンダーさん","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"【人生の酸いも甘いも噛みしめたいぶし銀】"},{"spoiler":false,"text":"柚乃のマスコットロボで、人生を達観している大人なロボット犬。"},{"spoiler":false,"text":"渋い発言が多く、「オレはいーんだよ」が口癖。"},{"spoiler":false,"text":"ギャルギャルした女の子が苦手な様子。"},{"spoiler":false,"text":"「仕方ねぇ。愛する人に幸せを与えられるのが、たまたまオレたちじゃなかっただけさ」"}],"source":"egs","sourceCharacterId":"18360","sourceWorkId":"10729","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8a35976bf5383967a307750f028dbe51f2d74df7647429ca23eeb224500d083.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46da374333ffe8817d6b47389700f908735ca0f01f5604996fe20c97d297acad.webp","width"