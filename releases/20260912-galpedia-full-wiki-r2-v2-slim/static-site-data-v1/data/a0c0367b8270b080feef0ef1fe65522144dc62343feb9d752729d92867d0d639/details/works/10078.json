"source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"坂之上コンツェルン・社長の一人娘。"},{"spoiler":false,"text":"運動良し、成績良しの文武両道タイプだが、直情径行で猪突猛進、目的をのためなら手段を選ばない爆弾娘。"},{"spoiler":false,"text":"ちなみに坂之上コンツェルンは、世界大戦のドサクサに紛れて荒稼ぎした旧華族である。"},{"spoiler":false,"text":"「今宵の夜伽のお相手は……わ、わわわ私を指名してくださいませ！」"}],"source":"egs","sourceCharacterId":"19123","sourceWorkId":"10078","spoiler":false},{"segments":[{"spoiler":false,"text":"第二次世界大戦のどさぐさに紛れて荒稼ぎした旧華族、"},{"spoiler":false,"text":"坂之上コンツェルン・現社長の一人娘。"},{"spoiler":false,"text":"文武両面に秀でているが、性格は直情径行で、"},{"spoiler":false,"text":"目的のためなら手段を選ばないところがある。"},{"spoiler":false,"text":"「今宵の夜伽のお相手は……わ、わわわ私を指名してくださいませ！」"}],"source":"bangumi","sourceCharacterId":"138481"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c9/c98d4298808bca3ad53de67db913c4ccd24221836cee51feb87b04795611da2b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd2a66ffb79395abafa48ca3779cc9552e0238edbe41951bfa18aed2eedda4a4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"谷川涼子","creatorId":"vndb:s18593","sourcePersonId":"vndb:s18593","canonicalEntityId":"vndb:s18593","name":"谷川涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:11268","source":"vndb"}]},{"characterId":"char_c41450","characterName":"昼風 火織","sourceIds":{"bangumi":[{"characterId":"138482","match":"exact-normalized-name-in-linked-work","subjectId":"180916"}],"egsCharacterIds":["19124"],"vndbCharacterId":"c41450"},"originalCharacterName":"昼風 火織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幼い頃より合気道を習わせられていた女の子で、世界でも三本の指に入ると言われるほどの実力を持つ。"},{"spoiler":false,"text":"しかし本人は、武道＝暴力という考えを持っているため、めったなことでは、人前でその技を披露することはない。"},{"spoiler":false,"text":"ちなみに父は元有名野球選手で、男手一つで育てられた。"},{"spoiler":false,"text":"「お前のためなら……死ねる」"}],"source":"egs","sourceCharacterId":"19124","sourceWorkId":"10078","spoiler":false},{"segments":[{"spoiler":false,"text":"元有名野球選手の父の手一つで育てられた。"},{"spoiler":false,"text":"幼い頃より合気道を習わされ、その腕前は現在、"},{"spoiler":false,"text":"世界でも三本の指に入ると言われている。"},{"spoiler":false,"text":"だが、武道は○○に繋がると考えており、"},{"spoiler":false,"text":"人前でその技を披露することは滅多にない。"},{"spoiler":false,"text":"「お前のためなら……死ねる」"}],"source":"bangumi","sourceCharacterId":"138482"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63413e2fdb04a54c637f5b825e38da8ebcf6117384421cb07b00d1ba9ba01a79.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/7745c5b5d5db7e5e735776f09b66d297cf795772f813d48fa4bc20ce4e9d6170.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中涼子","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:180916:138482:4832:1","source":"bangumi"}]},{"characterId":"char_c41451","characterName":"百合草 柚","sourceIds":{"bangumi":[{"characterId":"138483","match":"exact-normalized-name-in-linked-work","subjectId":"180916"}],"egsCharacterIds":["19125"],"vndbCharacterId":"c41451"},"originalCharacterName":"百合草 柚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"類稀なる存在感とリーダーシップを持つ少女。"},{"spoiler":false,"text":"小さい頃から人の上に立つ立場を任されてきた事もあり、その性格は誇り高く、「獅子のようだ」と形容されるほど。"},{"spoiler":false,"text":"だが、意外と純情かつおっちょこちょいな面もあり、心を開いた者には、とたんに優しくなったりもする。"},{"spoiler":false,"text":"ちなみに両親は、世界の巨匠と呼ばれる父とベストセラー作家の母。"},{"spoiler":false,"text":"「くぬぅ……どうして私があなたなんかとぉぉぉ！」"}],"source":"egs","sourceCharacterId":"19125","sourceWorkId":"10078","spoiler":false},{"segments":[{"spoiler":false,"text":"映画監督の父と、作家の母との間に生まれる。"},{"spoiler":false,"text":"幼少から人の上に立つ立場を任せられてきた。"},{"spoiler":false,"text":"普段はとても厳しいが女の子らしい純情な面も持ち、心を開いた者に対しては"},{"spoiler":false,"text":"どこまでも優しくなる。"},{"spoiler":false,"text":"「くぬぅ……どうして私があなたなんかとぉぉぉ！」"}],"source":"bangumi","sourceCharacterId":"138483"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9ab5f46bb439ba300266b292ba3c777d5f242d8e321ed3123cc405800b8a9a8d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c761e62e971c00f72b2e46312f1fdc77c03e2004ae3bf0d0f0caee998d616ea.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"儀武ゆう子","creatorId":"vndb:s263","sourcePersonId":"vndb:s263","canonicalEntityId":"vndb:s263","name":"儀武 ゆう子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:180916:138483:4744:1","source":"bangumi"}]},{"characterId":"char_c41452","characterName":"美咲森 五穂","sourceIds":{"bangumi":[{"characterId":"138484","match":"exact-normalized-name-in-linked-work","subjectId":"180916"}],"egsCharacterIds":["19126"],"vndbCharacterId":"c41452"},"originalCharacterName":"美咲森 五穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幼いころより流石の遊び相手を務めてきた幼馴染で、結婚の約束までしたラブラブ進行中の彼女。"},{"spoiler":false,"text":"普段はほんわかした雰囲気を漂わせているが、流石が他の女の子に目移りしていると、笑顔で酷いことをしたする。"},{"spoiler":false,"text":"世界のためとは言え、自分以外の女の子とエッチするなんて絶対ダメと、器候補の女の子たちを、あの手この手で妨害するが……。"},{"spoiler":false,"text":"「いけませんねぇ、流石さん……」"}],"source":"egs","sourceCharacterId":"19126","sourceWorkId":"10078","spoiler":false},{"segments":[{"spoiler":false,"text":"母は長瀬家の元使用人であり、その縁から、幼少より"},{"spoiler":false,"text":"流石の遊び相手になってきた。"},{"spoiler":false,"text":"流石とは相思相愛であり、既に結婚の約束もしている。"},{"spoiler":false,"text":"一見、ほんわかとしているが、笑顔で人を刺したりしそうな恐ろしい一面を持っている。"},{"spoiler":false,"text":"「いけませんねぇ、流石さん……」"}],"source":"bangumi","sourceCharacterId":"138484"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8d95ab76c2a31823b4ca8cb2801eb848a61d0ffcefd630e0cb86fd6c3180207.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c082aee40d29a2de873e2a8cc869b145e5006010dc135a449d6ad62bf6a7ab20.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:180916:138484:4799:1","source":"bangumi"}]},{"characterId":"char_vndb_c41453","characterName":"長瀬 流石","sourceIds":{"vndbCharacterId":"c41453"},"originalCharacterName":"長瀬 流石","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7df78d09def2c23370f229744bd14c45ea559a946e359a6aa90d5bdac757eeac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cc/cc2d107b80539326eb08db1095d12f97358fc1861a21714839a76d99fa3ad3f4.webp","width":172,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:271","sourceCompanyId":"egs:brand:271","canonicalEntityId":"egs:brand:271","name":"BLUE GALE","roleCodes