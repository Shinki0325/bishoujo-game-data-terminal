roject","creatorId":"vndb:s10795","sourcePersonId":"vndb:s10795","canonicalEntityId":"vndb:s10795","name":"Cy-Rim Project","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:45553","source":"vndb"},{"creditedName":"あきた みこと","creatorId":"vndb:s50820","sourcePersonId":"vndb:s50820","canonicalEntityId":"vndb:s50820","name":"あきた みこと","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:45555","source":"vndb"}],"other":[{"creditedName":"呉","creatorId":"vndb:s507","sourcePersonId":"vndb:s507","canonicalEntityId":"vndb:s507","name":"呉","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:45543","source":"vndb"},{"creditedName":"恋純 ほたる","creatorId":"vndb:s1908","sourcePersonId":"vndb:s1908","canonicalEntityId":"vndb:s1908","name":"恋純 ほたる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:45545","source":"vndb"},{"creditedName":"菱野 優希","creatorId":"vndb:s2791","sourcePersonId":"vndb:s2791","canonicalEntityId":"vndb:s2791","name":"菱野 優希","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:45547","source":"vndb"},{"creditedName":"みるく","creatorId":"vndb:s4182","sourcePersonId":"vndb:s4182","canonicalEntityId":"vndb:s4182","name":"みるく","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:45552","source":"vndb"},{"creditedName":"Cy-Rim Project","creatorId":"vndb:s10795","sourcePersonId":"vndb:s10795","canonicalEntityId":"vndb:s10795","name":"Cy-Rim Project","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:45554","source":"vndb"}]},"cast":[{"characterId":"char_c4633","characterName":"ミカ アルステッド ハイネ","sourceIds":{"bangumi":[{"characterId":"12725","match":"exact-normalized-name-in-linked-work","subjectId":"7188"}],"egsCharacterIds":["12654"],"vndbCharacterId":"c4633"},"originalCharacterName":"ミカ アルステッド ハイネ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A love angel, it's her job to help people who are in love. She has a ring around her neck that glows when someone nearby is in love. She runs in to Satoru and joins his school to help him fall in love and win the girl of his dreams."},{"spoiler":false,"text":"She has the ability to fly and change into a dove."}],"source":"vndb","sourceCharacterId":"c4633"},{"segments":[{"spoiler":false,"text":"主人公が拾った鳩。"},{"spoiler":false,"text":"その正体は人と人を愛のリングで繋ぐ愛天使だった。"},{"spoiler":false,"text":"だがこのところ、人の心からは愛が乏しくなる一方で、彼女やその仲間たちの力は失われつつある。"},{"spoiler":false,"text":"“Angel Ring”で人と人とを繋いで、世の中をもっと愛に満ちた世界にしたい、というのが願い。"},{"spoiler":false,"text":"……そんな殊勝な願いとは裏腹に、性格はいたって勝ち気かつ身勝手。"},{"spoiler":false,"text":"口うるさいし手も早い。"},{"spoiler":false,"text":"愛天使としての実績ゼロなのは彼女を含め二人しかいないので、必ずしも世の中のせいばかりにはできないのだった。"},{"spoiler":false,"text":"主人公の下宿に居候し、愛宕学園に通うことになる。"},{"spoiler":false,"text":"「家に置いてくれなんて、誰が、いつ、頼んだのよ!?」"}],"source":"egs","sourceCharacterId":"12654","sourceWorkId":"13610","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公捡到的鸽子。原形是缔结人与人之间的爱之指环的爱天使。"},{"spoiler":false,"text":"但是最近因为人的心里的爱不断消失，她和伙伴们的力量正在丧失。"},{"spoiler":false,"text":"通过“Angel Ring”联系人与人，是世界充满爱是爱天使们的共同的愿望。"},{"spoiler":false,"text":"……但是和值得赞扬的愿望相反，ミカ的性格不仅好胜而且任性。"},{"spoiler":false,"text":"不仅口水多过茶还喜欢动手动脚。"},{"spoiler":false,"text":"因为爱天使中实际成果为零的包括她只有两个人，这不全都是外界的原因。"},{"spoiler":false,"text":"在主人公的家蹭饭蹭住，来往愛宕学園。"},{"spoiler":false,"text":"【就这样把我扔在家里，是谁，在什么时候，要求你的啊！？】"}],"source":"bangumi","sourceCharacterId":"12725"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9ff866799aad5ee04d6adb0a9522238bea46908df612c53a21776ce5ba96c004.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5a776efc9c6cfb641d1cf1585e8ee4e9291e02cc50f11276d15bc34af7f9c52.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7188:12725:5922:1","source":"bangumi"}]},{"characterId":"char_c4634","characterName":"藤井 澄佳","sourceIds":{"bangumi":[{"characterId":"12726","match":"exact-normalized-name-in-linked-work","subjectId":"7188"}],"egsCharacterIds":["12655"],"vndbCharacterId":"c4634"},"originalCharacterName":"藤井 澄佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Satoru's childhood friend. She often comes by in the mornings to walk with him and Sana to school. Cute and sweet she's always nice to both Satoru and Sana although she confronts Satoru about being an otaku."}],"source":"vndb","sourceCharacterId":"c4634"},{"segments":[{"spoiler":false,"text":"主人公の隣に住む幼馴染。"},{"spoiler":false,"text":"すっかりオタクになってしまった主人公に対し、それでも見捨てることなく、昔と同じように接してくれる優しい女の子。"},{"spoiler":false,"text":"成績優秀で、美人で、それでいて人当たりもいいせいか、男女問わず人気が高い。"},{"spoiler":false,"text":"ちょっとおっちょこちょいなところがあり、家事が苦手。"},{"spoiler":false,"text":"「ずっと一緒にいて、いいよね？」"}],"source":"egs","sourceCharacterId":"12655","sourceWorkId":"13610","spoiler":false},{"segments":[{"spoiler":false,"text":"住在主人公附近的青梅竹马。"},{"spoiler":false,"text":"对完全陷入宅男泥沼的主人公不离不弃，和以前一样对待他的温柔的女孩子。"},{"spoiler":false,"text":"成绩优秀，还是美人，再加上待人接物的态度很好，非常受男女之间的欢迎。"},{"spoiler":false,"text":"【一直在一起，好吗？】"}],"source":"bangumi","sourceCharacterId":"12726"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b50a7ff7e997d5cf74834c32fa80575b5211ffcdfec3d37c06da8ff5bb728360.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f75b10069c9742709cafa9fc52cfca9f64a03d8759530104ecb543112010159d.webp","width":166,"height":200,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7188:12726:5075:1","source":"bangumi"}]},{"characterId":"char_c4635","characterName":"遠海 佐奈","sourceIds":{"bangumi":[{"characterId":"12727","match":"exact-normalized-name-in-linked-work","subjectId":"7188"}],"egsCharacterIds":["12656"],"vndbCharacterId":"c4635"},"originalCharacterName":"遠海 佐奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Satoru's cute younger sister. She does most of the housework. She really disapproves of him being an otaku and will often yell at him for playing eroge and is prone to kicking him when she's mad. She calls him \"aniki\" rather than \"onii-chan\"."},{"spoiler":false,"text":"She attends the middle school next to Satoru's high school and wears a different uniform than the other girls."}],"source":"vndb","sourceCharacterId":"c4635"},{"segments":[{"spoiler":false,"text":"主人公の妹。"},{"spoiler":false,"text":"昔はお兄ちゃん子で、よく主人公の後ろにくっつくようにしていたというのに、"},{"spoiler":false,"text":"いまはオタクなアニキをすっかりさげすんでいる。"},{"spoiler":false,"text":"PCのディスプレイに向かっている主人公の背中を見つめるまなざしに、もはや昔日の面影はないのだった。"},{"spoiler":false,"text":"主人公に対しては暴言暴力は日常茶飯事だが、根は親切。"},{"spoiler":false,"text":"家事については万能。"},{"spoiler":false,"text":"「“お兄ちゃん”なんて呼んであげること、金輪際ないんだからねっ」"}],"source":"egs","sourceCharacterId":"12656","sourceWorkId":"13610","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的妹妹。"},{"spoiler":false,"text":"在小时候是哥哥的跟屁虫，而现在则完全地鄙视着宅男哥哥。"},{"spoiler":false,"text":"对总是盯着PC显示器的主人公的目光已经不如从前了。"},{"spoiler":false,"text":"对主人公使用暴力是常有的事，不过其实是亲切。"},{"spoiler":false,"text":"家务万能。"},{"spoiler":false,"text":"【要我叫“哥哥”，这是绝对不可能的事】"}],"source":"bangumi","sourceCharacterId":"12727"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b684a78b94527a0fe92a42141a5dcbdfb051f16c7faa75eb101b5e245f68136.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/4152503a39555f9a949a2848d233e909ba5d71a2e5e27710afd5ec920d2a0c5e.webp","width":166,"height":200,"source":"static-detail"},"actors":[{"creditedName":"高橋かな","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7188:12727:6016:1","source":"bangumi"}]},{"characterId":"char_c4636","characterName":"周防 美鶴","sourceIds":{"bangumi":[{"characterId":"12728","match":"exact-normalized-name-in-linked-work","subjectId":"7188"}],"egsCharacterIds":["12657"],"vndbCharacterId":"c4636"},"originalCharacterName":"周防 美鶴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One year older than the others she attends a different class than Satoru. Known as the \"madonna\" of the school she's incredibly beautiful, wealthy, and smart. She never goes anywhere without her butler Jiiya although she'll try to run away from him if she can."}],"source":"vndb","sourceCharacterId":"c4636"},{"segments":[{"spoiler":false,"text":"1学年上の先輩。"},{"spoiler":false,"text":"学校内はおろか県内全体でも知らない者のまずいない、有名なお嬢様。"},{"spoiler":false,"text":"世界に冠たる周防グループの一粒種。"},{"spoiler":false,"text":"そんな生粋のお嬢様である美鶴だが、人当たりは至って柔らかく、その出自を鼻にかけることもない。"},{"spoiler":false,"text":"だがあまりに箱入りに育てられたせいか、一般常識や世間のことにはかなり疎い。"},{"spoiler":false,"text":"決して悪気はないのだが、その天然ボケな言動で周囲を唖然とさせることもしばしばである。"},{"spoiler":false,"text":"「爺やが来ないうちに、二人だけで行ってしまいましょう」"}],"source":"egs","sourceCharacterId":"12657","sourceWorkId":"13610","spoiler":false},{"segments":[{"spoiler":false,"text":"年长一岁的前辈。世界第一的周防集团的独生女。"},{"spoiler":false,"text":"别说是学园甚至是全县没有一个不知道她的名字的有名的大小姐。"},{"spoiler":false,"text":"作为真正的大小姐的美鶴待人温和，并不炫耀自己的出身。"},{"spoiler":false,"text":"但或许太过深居闺出，对一般常识和世间的事相当一知半解。"},{"spoiler":false,"text":"虽然没有恶意，但她天然呆的言行经常是周围无语。"},{"spoiler":false,"text":"【在爷爷还没来之前，我们两个人先走吧】"}],"source":"bangumi","sourceCharacterId":"12728"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffac5423dd3a5f444214849d61409102791ddcf8ed88c97f7b44b23562c42ab9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/7068ee999ff5d76c1765938f81892175db6c24c9ba89be7cc3b960605138afe8.webp","width":166,"height":200,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7188:12728:4727:1","source":"bangumi"}]},{"characterId":"char_c4637","characterName":"ルキア・ルミナス・スイレン","sourceIds":{"bangumi":[{"characterId":"12729","match":"exact-normalized-name-in-linked-work","subjectId":"7188"}],"egsCharacterIds":["12658"],"vndbCharacterId":"c4637"},"originalCharacterName":"ルキア・ルミナス・スイレン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"159"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A love angel and friend/rival of Mika. She sets up a chair and sign on the side of the shopping district to help couples and people in love. Not very bright. She approves of Satoru's eroge. When she transfers into Satoru's school she attends a different class."},{"spoiler":false,"text":"Like Mika her angel ring will glow when someone nearby is in love."}],"source":"vndb","sourceCharacterId":"c4637"},{"segments":[{"spoiler":false,"text":"ミカと双璧をなす落ちこぼれ愛天使。"},{"spoiler":false,"text":"ただし、天使学校は首席で卒業したという実績がある。"},{"spoiler":false,"text":"そのせいか、傲岸なほどに自信満々で高飛車な態度。"},{"spoiler":false,"text":"決して悪い人ではないのだが、根拠不明な自信がなかなかやっかい。"},{"spoiler":false,"text":"また、「周りが自分のために奉仕するのは当然のこと」と思っているフシがある。"},{"spoiler":false,"text":"主人公の下宿に居候し、愛宕学園に通うことになる。"},{"spoiler":false,"text":"「わたしが本気を出せば、こんなものじゃないんですから」"}],"source":"egs","sourceCharacterId":"12658","sourceWorkId":"13610","spoiler":false},{"segments":[{"spoiler":false,"text":"和ミカ是吊车尾爱天使双人组。"},{"spoiler":false,"text":"但有着在天使学校首席毕业的成绩。因此态度态度相当自信，骄傲且强横。"},{"spoiler":false,"text":"绝对不是坏人，不过自己无理由的自信却相当令人厌烦。"},{"spoiler":false,"text":"同时固执地认为【周围的人侍奉自己是当然的事】。"},{"spoiler":false,"text":"在主人公的家蹭饭蹭住，来往愛宕学園。"},{"spoiler":false,"text":"【如果我动真格的话，决不仅仅只此而已哦】"}],"source":"bangumi","sourceCharacterId":"12729"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffe973b03467340d1ca205a1d0f946053c6fb8e89216f084662cb0bdbd50f010.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/31d21369c369d3903cc29ecf45201d3a319ef0780ee26eafa3207e5c0809c88d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幡宮かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7188:12729:5940:1","source":"bangumi"}]},{"characterId":"char_c4638","characterName":"志木 梓","sourceIds":{"bangumi":[{"characterId":"12730","match":"exact-normalized-name-in-linked-work","subjectId":"7188"}],"egsCharacterIds":["12659"],"vndbCharacterId":"c4638"},"originalCharacterName":"志木 梓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Satoru's classmate and coworker at Lavage. She's high-spirited and straightforward. She likes hanging around Satoru both at school and at work. She's cute but she has no boobs."}],"source":"vndb","sourceCharacterId":"c4638"},{"segments":[{"spoiler":false,"text":"澄佳の部活仲間で親友。"},{"spoiler":false,"text":"クラスがずっと違っていたため主人公とは面識がなかったのだが、新学年になってクラスメートとなった。"},{"spoiler":false,"text":"明るくて、裏表のない性格。良くも悪くもおおらかで、思ったことをストレートに口にしてしまう。"},{"spoiler":false,"text":"容姿はかなりの美形だが、恋愛にはうとく、あまり興味もない。"},{"spoiler":false,"text":"そんな女っ気のない梓だが、胸のないことだけは気にしているのだった。"},{"spoiler":false,"text":"主人公と同じく、ラヴァージュでバイトをしている。"},{"spoiler":false,"text":"「あっはは。なるほどね、これがオタクの生態か～」"}],"source":"egs","sourceCharacterId":"12659","sourceWorkId":"13610","spoiler":false},{"segments":[{"spoiler":false,"text":"澄佳的俱乐部伙伴兼朋友。"},{"spoiler":false,"text":"因为班级不同不认识主人公，不过在新学年成为了同学。"},{"spoiler":false,"text":"性格开朗，表里如一。"},{"spoiler":false,"text":"对好事坏事都万分宽容，对想说的事从不拐弯抹角。"},{"spoiler":false,"text":"外表虽然漂亮，但对恋爱不仅陌生且不太感兴趣。"},{"spoiler":false,"text":"如此没有女人味的她只介意着自己没有胸部。"},{"spoiler":false,"text":"和主人公一起、在餐馆・ラヴァージュ打工。"},{"spoiler":false,"text":"【啊哈哈。原来如此，这就是宅男的生态吗~】"}],"source":"bangumi","sourceCharacterId":"12730"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04297cc860b8210a3220ed2cd42b0f57504f7412a70214751880ebf3772e9c57.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e43b9f5dfb8c303d0738c8cd9fc618a32407fa88c2b01865d4f562dca6344c0c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"宮沢ゆあな","creatorId":"vndb:s830","sourcePersonId":"vndb:s830","canonicalEntityId":"vndb:s830","name":"宮沢ゆあな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7188:12730:5915:1","source":"bangumi"}]},{"characterId":"char_c46