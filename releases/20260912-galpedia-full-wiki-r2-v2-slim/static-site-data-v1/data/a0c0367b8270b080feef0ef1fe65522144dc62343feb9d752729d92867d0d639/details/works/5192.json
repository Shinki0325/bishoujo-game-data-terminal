ler":false,"text":"同性なのならず異性にも人気がある。"},{"spoiler":false,"text":"学園内では、しばし男子生徒に声をかけられている。"}],"source":"bangumi","sourceCharacterId":"144871"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15a912a04484d8bf7c36ba37e76e61567aff02e43e4bb21be6bab7be6d30cf5a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54397cf4da2e1401d1b8aa86c68d2c968230bcdb288b64c066028e7cb3447494.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"伊藤静","creatorId":"vndb:s516","sourcePersonId":"vndb:s516","canonicalEntityId":"vndb:s516","name":"伊藤 静","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99012:144871:4272:1","source":"bangumi"}]},{"characterId":"char_c63455","characterName":"野々宮 鈴華","sourceIds":{"bangumi":[{"characterId":"144877","match":"exact-normalized-name-in-linked-work","subjectId":"99012"}],"egsCharacterIds":["26541"],"vndbCharacterId":"c63455"},"originalCharacterName":"野々宮 鈴華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"清楚で凛々しく才色兼備なお嬢様。"},{"spoiler":false,"text":"颯爽としたその姿は、多くの女学生を魅了する。"},{"spoiler":false,"text":"しかし、極度の「男性恐怖症」で、男性と軽く接するだけでも吐き気や目眩などをもよおしてしまうほどの重症。"}],"source":"egs","sourceCharacterId":"26541","sourceWorkId":"5192","spoiler":false},{"segments":[{"spoiler":false,"text":"清楚で凛々しく才色兼備、落ち着いた雰囲気と颯爽とした性格を持ち合わす彼女に、"},{"spoiler":false,"text":"多くの女生徒達が魅了されていた。"},{"spoiler":false,"text":"しかし完璧な人間があり得ないように、彼女もまた、一つの大きな問題を抱えている。"},{"spoiler":false,"text":"彼女は、極度の「男性恐怖症」なのであった。"},{"spoiler":false,"text":"男性と軽く接触するだけで冷や汗が垂れ、"},{"spoiler":false,"text":"無意識に身体が硬直してしまい、吐き気や眩暈をもよおす。"},{"spoiler":false,"text":"さすがに学園内であからさまな態度に出るわけにはいかないので、"},{"spoiler":false,"text":"極力距離を取るようにしつつ、何事もないように振る舞っている。"}],"source":"bangumi","sourceCharacterId":"144877"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ffb9077b3987e280b71bac819371896b1e4b08a2c6f42e4ce66903418b77d802.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f5a97b53a3ef4623775082bd263cb128768b37d8e58c2255f66c2d71ac8d35b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"児玉さとみ","creatorId":"vndb:s115","sourcePersonId":"vndb:s115","canonicalEntityId":"vndb:s115","name":"児玉 さとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99012:144877:15954:1","source":"bangumi"}]},{"characterId":"char_c63456","characterName":"長岑 一姫","sourceIds":{"bangumi":[{"characterId":"144878","match":"exact-normalized-name-in-linked-work","subjectId":"99012"}],"egsCharacterIds":["26542"],"vndbCharacterId":"c63456"},"originalCharacterName":"長岑 一姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"前作ヒロイン・長岑流風のひとり娘。主人公とは幼馴染の関係。"},{"spoiler":false,"text":"気品とプライドの高さは母親譲りではあるが、出来過ぎた母親の存在が大きいせいか、人一倍コンプレックスが強い。"},{"spoiler":false,"text":"性格的に他人を遠ざけてしまうところがあり、親しい友人は居ない。"}],"source":"egs","sourceCharacterId":"26542","sourceWorkId":"5192","spoiler":false},{"segments":[{"spoiler":false,"text":"前作ヒロインである長岑流風の一人娘であり、主人公の雅章とは幼なじみ。"},{"spoiler":false,"text":"気品とプライドの高さは母親譲りで、成績も優秀。"},{"spoiler":false,"text":"だが出来すぎた母を持ったせいか、人一倍コンプレックスが強く、"},{"spoiler":false,"text":"何かにつけ自分と母を比べ、自身の至らなさを腹立たしく思っている。"},{"spoiler":false,"text":"性格的に他人を遠ざける傾向があり、あまり親しい友人はいない。"},{"spoiler":false,"text":"だが自身を高める──そして母親に追いつくことを願う彼女には、"},{"spoiler":false,"text":"それは些細な問題でしかなかった。"}],"source":"bangumi","sourceCharacterId":"144878"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/440561f1ede0b79742a2b25f525ba07cb93bd4e34ccbbf8a855f0e69cf91c151.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d32340d455b766e8cf44b8a97c552a69ec686119b89c17b00b011fd14dbd2aaa.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"及川ひとみ","creatorId":"vndb:s110","sourcePersonId":"vndb:s110","canonicalEntityId":"vndb:s110","name":"及川 ひとみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99012:144878:13696:1","source":"bangumi"}]},{"characterId":"char_c63457","characterName":"水瀬 七海","sourceIds":{"bangumi":[{"characterId":"144879","match":"exact-normalized-name-in-linked-work","subjectId":"99012"}],"egsCharacterIds":["26543"],"vndbCharacterId":"c63457"},"originalCharacterName":"水瀬 七海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"前作ヒロイン・水瀬奈月の娘。"},{"spoiler":false,"text":"自己中心的でワガママな母親とあらゆる面で似通っており、ある面では母親を凌ぐ。"},{"spoiler":false,"text":"少々ファザコンの気があり、同世代の男性は子供っぽく感じ、ほぼ無関心。"}],"source":"egs","sourceCharacterId":"26543","sourceWorkId":"5192","spoiler":false},{"segments":[{"spoiler":false,"text":"前作ヒロインである水瀬奈月の娘。"},{"spoiler":false,"text":"母親のことをすごく慕い、またその生き様、考え方を尊敬している。"},{"spoiler":false,"text":"性格も価値基準も非常に奈月によく似ていて、自己中心的で自分勝手。"},{"spoiler":false,"text":"影響しやすい環境で育ったせいかワガママ度は彼女の上をいく。"},{"spoiler":false,"text":"そして同じくらい父親を好いており、慕っていた。"},{"spoiler":false,"text":"そのせいか同年代の異性はすべて○○っぽく見え、"},{"spoiler":false,"text":"寄せる関心は寄せられる関心に比べ皆無といってよかった。"}],"source":"bangumi","sourceCharacterId":"144879"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e51d1c49f6f49c78a6339d72f3855d575e38bdfd0c1dcf3b4e25ce70906a9505.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1c23589b78ef6319fd138ad8eed6352fead16240ad231a99fe603d557acce63.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"永瀬江美弥","creatorId":"vndb:s61","sourcePersonId":"vndb:s61","canonicalEntityId":"vndb:s61","name":"永瀬 いくみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99012:144879:6549:1","source":"bangumi"}]},{"characterId":"char_c63458","characterName":"篠生 沙樹","sourceIds":{"bangumi":[{"characterId":"144881","match":"exact-normalized-name-in-linked-work","subjectId":"99012"}],"egsCharacterIds":["26545"],"vndbCharacterId":"c63458"},"originalCharacterName":"篠生 沙樹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"前作ヒロイン・篠生藍の娘。"},{"spoiler":false,"text":"極度の対人恐怖症から、保健室登校をしている少女。"},{"spoiler":false,"text":"学力は高いため、ほとんど教師が保健室に訪れることはなく自習していることが多い。"},{"spoiler":false,"text":"本人は、その方が気楽と思っているようだ。"}],"source":"egs","sourceCharacterId":"26545","sourceWorkId":"5192","spoiler":false},{"segments":[{"spoiler":false,"text":"前作ヒロインである篠生藍の娘。"},{"spoiler":false,"text":"対人関係が苦手で、一定数以上の人間がいるような場所には近づけない。"},{"spoiler":false,"text":"そのため、今は保健室登校の日々を送っている。"},{"spoiler":false,"text":"症状を鑑みての配慮というのが学校側の見解と判断であり、それ自体に嘘はないが、"},{"spoiler":false,"text":"彼女自身の希望と家柄による融通がその判断を後押ししたのも事実だった。"},{"spoiler":false,"text":"また学力は高いため、教師が保健室に教えに来ることはあまりなく、自習が多い。"},{"spoiler":false,"text":"本人もその方が気楽と思っている。"}],"source":"bangumi","sourceCharacterId":"144881"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/dd5584b9f5