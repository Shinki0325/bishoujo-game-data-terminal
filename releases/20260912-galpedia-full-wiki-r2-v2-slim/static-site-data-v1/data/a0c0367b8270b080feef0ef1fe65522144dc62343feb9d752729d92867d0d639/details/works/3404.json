:{"bangumi":[{"characterId":"97840","match":"exact-normalized-name-in-linked-work","subjectId":"22342"}],"egsCharacterIds":["24504"],"vndbCharacterId":"c1967"},"originalCharacterName":"有馬 柚鈴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"有馬神社宮司・一哉の末っ子。"},{"spoiler":false,"text":"物静かで人見知りが激しく、極度の対人恐怖症。"},{"spoiler":false,"text":"生まれながらにして銀髪で、奇異な目で見られることが多く、それが対人恐怖症の一因にもなっている。"},{"spoiler":false,"text":"そのため家族以外では友人の幸野双葉を除いて、普通に接することが出来ず、境内から出ることをしない。"}],"source":"egs","sourceCharacterId":"24504","sourceWorkId":"1648","spoiler":false},{"segments":[{"spoiler":false,"text":"有馬神社宮司・一哉の末っ子。"},{"spoiler":false,"text":"物静かで人見知りが激しく、極度の対人恐怖症。"},{"spoiler":false,"text":"生まれながらにして銀髪で、奇異な目で見られることが多く、それが対人恐怖症の一因にもなっている。"},{"spoiler":false,"text":"そのため家族以外では友人の幸野双葉を除いて、普通に接することが出来ず、境内から出ることをしない。"}],"source":"egs","sourceCharacterId":"24504","sourceWorkId":"3404","spoiler":false},{"segments":[{"spoiler":false,"text":"有馬一哉の末っ子。生まれながらの銀髪。人見知りが激しく、対人恐怖症で口数も少なく自分から人に寄っていこうとしない。"}],"source":"bangumi","sourceCharacterId":"97840"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/356c9fadab8f0b1491e4e1051753d794e4dfb4bce53a94d4ab23100f0e77723c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae8f435a5d66b5890bce9b9ce124bd4518f9c8495b3db9c626a6cafbbce6017b.webp","width":150,"height":219,"source":"static-detail"},"actors":[{"creditedName":"藤咲かおり","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"韮井叶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22342:97840:6105:1","source":"bangumi"}]},{"characterId":"char_c1968","characterName":"幸野 双葉","sourceId