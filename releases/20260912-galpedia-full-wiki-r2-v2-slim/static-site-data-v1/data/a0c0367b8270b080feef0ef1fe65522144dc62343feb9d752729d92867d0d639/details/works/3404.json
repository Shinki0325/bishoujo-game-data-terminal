ce":"bangumi"}]},{"characterId":"char_c1970","characterName":"有馬 葉桐","sourceIds":{"bangumi":[{"characterId":"97843","match":"exact-normalized-name-in-linked-work","subjectId":"22342"}],"egsCharacterIds":["24507"],"vndbCharacterId":"c1970"},"originalCharacterName":"有馬 葉桐","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"有馬神社宮司・一哉の後妻で、美月の実母。"},{"spoiler":false,"text":"優しく争そいごとを好まない性格。"},{"spoiler":false,"text":"良妻賢母で、血の繋がらない義理の娘達に愛情を注いでいるものの、後妻でることにある種の引け目を感じ、また鈴香にはあまり好く思われていないことを気に病んでいる。"}],"source":"egs","sourceCharacterId":"24507","sourceWorkId":"1648","spoiler":false},{"segments":[{"spoiler":false,"text":"有馬神社宮司・一哉の後妻で、美月の実母。"},{"spoiler":false,"text":"優しく争そいごとを好まない性格。"},{"spoiler":false,"text":"良妻賢母で、血の繋がらない義理の娘達に愛情を注いでいるものの、後妻でることにある種の引け目を感じ、また鈴香にはあまり好く思われていないことを気に病んでいる。"}],"source":"egs","sourceCharacterId":"24507","sourceWorkId":"3404","spoiler":false},{"segments":[{"spoiler":false,"text":"一哉の後妻で美月の実母。外見通りの良妻賢母。性格は非常に優しく、争い事を好まないが、芯の強いところもある。後妻であることの社会からの視線、鈴香があまり懐いてくれないこと、美月が貧血持ち等の悩みはあるものの、優しい笑顔を見せる。"}],"source":"bangumi","sourceCharacterId":"97843"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/9928beee3b09507ba489ce476d2a4434e79e6b726a6032fd8c681d0feb0eafc8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3c9aa904b2e18befa90b0f5d02cadeb6b1632565f9cd71d4d6391cdb90748b9.webp","width":150,"height":223,"source":"static-detail"},"actors":[{"creditedName":"関和美","creatorId":"vndb:s1314","sourcePersonId":"vndb:s1314","canonicalEntityId":"vndb:s1314","name":"小倉 文江","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22342:97843:20825:1","source":"bangumi"}]},{"characterId":"char_c1971","characterName":"有馬 鈴香","sourceIds":{"bangumi":[{"characterId":"97842","match":"exact-normalized-name-in-linked-work","subjectId":"22342"}],"egsCharacterIds":["24506"],"vndbCharacterId":"c1971"},"originalCharacterName":"有馬 鈴香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"有馬神社宮司・一哉の長女。"},{"spoiler":false,"text":"病床の一哉に代わって社務を取り仕切っている。"},{"spoiler":false,"text":"礼儀正しく、しっかりしている反面、事務的で相手に冷たい印象を与えてしまう。"},{"spoiler":false,"text":"髪の色やその生誕に纏わる軋轢から妹・柚鈴を守らなければならないと使命感が強い。"}],"source":"egs","sourceCharacterId":"24506","sourceWorkId":"1648","spoiler":false},{"segments":[{"spoiler":false,"text":"有馬神社宮司・一哉の長女。"},{"spoiler":false,"text":"病床の一哉に代わって社務を取り仕切っている。"},{"spoiler":false,"text":"礼儀正しく、しっかりしている反面、事務的で相手に冷たい印象を与えてしまう。"},{"spoiler":false,"text":"髪の色やその生誕に纏わる軋轢から妹・柚鈴を守らなければならないと使命感が強い。"}],"source":"egs","sourceCharacterId":"24506","sourceWorkId":"3404","spoiler":false},{"segments":[{"spoiler":false,"text":"有馬一哉の実子で長女。柚鈴の姉で美月の異母姉妹にあたる。どこか冷たい感じのする少女。物心つく時には実母が亡くなっており、自分が長女であること、そして髪の色やその生誕にまつわる軋轢から柚鈴を守らなければならないという使命感もあり、かなりしっかりしている娘。"}],"source":"bangumi","sourceCharacterId":"97842"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f5a56e00a278713004f8806bd47a96fe792d20f41c3f33a7dd486c8ce16c1e6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0ca755c9f9dd04909c754786cb8a1f474bb5368ea31e97b491ec3eeabad7b1cd.webp","width":150,"height":221,"source":"static-detail"},"actors":[{"creditedName":"静木亜美","creatorId":"vndb:s663","sourcePersonId":"vndb:s663","canonicalEntityId":"vndb:s663","name":"静木 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:22342:97842:8575:1","sourc