{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"34207","model":{"presentationWorkId":"vndb:v44107","staff":{"artwork":[{"creditedName":"高橋レコード","creatorId":"vndb:s3877","sourcePersonId":"egs:creator:4238","canonicalEntityId":"vndb:s3877","name":"高橋レコード","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:263976","source":"egs"}],"scenario":[{"creditedName":"天城悠理","creatorId":"vndb:s2413","sourcePersonId":"egs:creator:5090","canonicalEntityId":"vndb:s2413","name":"天城悠理","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:263977","source":"egs"}],"music":[{"creditedName":"オフィス山根22","creatorId":"vndb:s2615","sourcePersonId":"egs:creator:17849","canonicalEntityId":"vndb:s2615","name":"オフィス山根22","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:263978","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c126752","characterName":"夜鶴","sourceIds":{"bangumi":[],"egsCharacterIds":["24649"],"vndbCharacterId":"c126752"},"originalCharacterName":"夜鶴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"125"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"Q"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"hip":{"reviewState":"source-only","source":"vndb","value":"96"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"66"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"62"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Courtesan at the Ochaya \"Tsurunoya\". She is ranked at Tayu, the highest rank an Oiran can achieve. Her high ranking means that she has control over who she sleeps with. As a result, she is a virgin contrary to her profession."},{"spoiler":false,"text":"She stands at 5'6\" (170cm). She has excellent proportions, and has the dignity of a first-class Oiran. She has a gentle and soft smile, and conducts herself elegantly. However, the closer you get to her the more likely she is to tease you."},{"spoiler":false,"text":"She keeps her preferences to herself, but she seems very fond of the protagonist."}],"source":"vndb","sourceCharacterId":"c126752"},{"segments":[{"spoiler":false,"text":"香坂深町(しんまち)の茶屋『鶴之屋』の遊女松の位、太夫、夜鶴姉さん"},{"spoiler":false,"text":"５尺６寸１分(170cm)と身長が高く、抜群のプロポーションを持ち、色街を代表する一流の遊女の貫禄を備える。優しげで柔らかな笑みを浮かべ、嫋やかで優雅な物腰。"},{"spoiler":false,"text":"ただし、親密になればなるほど相手をからかったり困らせるような言動が多くなる。"},{"spoiler":false,"text":"相手の好みは秘密としているが、主人公を大変好んでいる様子。"}],"source":"egs","sourceCharacterId":"24649","sourceWorkId":"34207","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"125 cm","valueContext":null,"source":"egs","sourceCharacterId":"24649","sourceWorkId":"34207","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"170 cm","valueContext":null,"source":"egs","sourceCharacterId":"24649","sourceWorkId":"34207","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"24649","sourceWorkId":"34207","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"66 cm","valueContext":null,"source":"egs","sourceCharacterId":"24649","sourceWorkId":"34207","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/40ac89f6df21fa145765aa76a0b3100f3cb8f50b70fff9ed0b76722f27bdecea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6ff139b50a6207d32f547dc817ee99fc32980a4c0eb027beba1983e7d24cd1e7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"赤井 リア","creatorId":"vndb:s3891","sourcePersonId":"vndb:s3891","canonicalEntityId":"vndb:s3891","name":"赤井リア(赤井いちご)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:94952","source":"vndb"}]},{"characterId":"char_c126753","characterName":"小鷺","sourceIds":{"bangumi":[],"egsCharacterIds":["24650"],"vndbCharacterId":"c126753"},"originalCharacterName":"小鷺","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"117"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"O"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"source-only","source":"vndb","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"65"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Just like Yozuru, she is a courtesan at Tsurunoya. She is ranked at tenjin, the second highest rank after Tayu. Her high rank means that she has control over who she decides to sleep with. As a result, she remains a virgin contrary to her profession."},{"spoiler":false,"text":"She stands at 5'5\" (168cm) and her body proportions are comparable to Yozuru. Her sensual charms are even said to exceed those of even a Tayu. With her long, beautiful eyes and dignified expression, she equals Yozuru in terms of popularity."},{"spoiler":false,"text":"She's always striving towards her goal of becoming like Yozuru. She is earnest and working hard to learn from her, but sometimes she gets in over her head."}],"source":"vndb","sourceCharacterId":"c126753"},{"segments":[{"spoiler":false,"text":"夜鶴と同じく鶴之屋の遊女梅の位、天神、小鷺姉さん"},{"spoiler":false,"text":"５尺５寸５分(約168cm)の長身に夜鶴に引けを取らないプロポーションを備え、また漂う色香は太夫をも凌ぐと言われる。"},{"spoiler":false,"text":"切れ長で美しい目、凛とした表情、夜鶴と人気を二分する双璧とも言える存在。"},{"spoiler":false,"text":"常に夜鶴を目標としており、真面目で勉強熱心だが、頭に血が上りやすいのが玉に瑕。"}],"source":"egs","sourceCharacterId":"24650","sourceWorkId":"34207","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"117 cm","valueContext":null,"source":"egs","sourceCharacterId":"24650","sourceWorkId":"34207","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"o","valueContext":null,"source":"egs","sourceCharacterId":"24650","sourceWorkId":"34207","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"24650","sourceWorkId":"34207","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"24650","sourceWorkId":"34207","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"65 cm","valueContext":null,"source":"egs","sourceCharacterId":"24650","sourceWorkId":"34207","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/58996c739d32ee4a78f81b07067942ba666eb1a0e7867c592fcddea6a034d8ee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0cedaa68dd198616e415c94fae857f3cb04fc18d424125a5b7bb739e2def883c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"陽乃 ゆゆ","creatorId":"vndb:s22136","sourcePersonId":"vndb:s22136","canonicalEntityId":"vndb:s22136","name":"陽乃ゆゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:94954","source":"vndb"}]},{"characterId":"char_c126754","characterName":"うずら","sourceIds":{"bangumi":[{"characterId":"132451","match":"exact-normalized-name-in-linked-work","subjectId":"432764"}],"egsCharacterIds":["24651"],"vndbCharacterId":"c126754"},"originalCharacterName":"うずら","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"70"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"138"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"50"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a young girl working as a maid at Tsurunoya. She stands at 4'5\" (~138cm). She is very fond of Ennosuke who is not much older than her but holds a full-fledged job."},{"spoiler":false,"text":"She wants to help him in any way she can. She sometimes looks like she's making a point but always comes up with weird explanations."},{"spoiler":false,"text":"She wants to become a fully-fledged Oiran, but she lacks the experience and has a long way to go. In addition to being a live in maid, she is a Kamuro, a servant to a high class courtesan. She trains diligently to become a high-class courtesan herself."},{"spoiler":false,"text":"She is also in charge of taking care of Yozuru's personal needs."}],"source":"vndb","sourceCharacterId":"c126754"},{"segments":[{"spoiler":false,"text":"深町鶴之屋で奉公している小間使いの少女おちょぼ。４尺５寸６分(約138cm)"},{"spoiler":false,"text":"自分とそう変わらない身長なのに、一人前の仕事をしている燕之介を大変気に入っており、何かにつけお役に立ちたいと思っている。時折、核心をついたようなそうでもないような、おかしな推理を燕之介に披露する。"},{"spoiler":false,"text":"一人前扱いして欲しいがまだまだ未熟で、一流の遊女に憧れている。"},{"spoiler":false,"text":"実際はかむろであり、高級遊女になるための修行中の身で、夜鶴の身の回りの世話をしている。"}],"source":"egs","sourceCharacterId":"24651","sourceWorkId":"34207","spoiler":false},{"segments":[{"spoiler":false,"text":"深町鶴之屋で奉公している小間使いの少女、おちょぼ。"},{"spoiler":false,"text":"4尺5寸6分(約138cm)自分とそう変わらない身長なのに、"},{"spoiler":false,"text":"一人前の仕事をしている燕之介を大変気に入っており、何かにつけお役に立ちたいと思っている。"},{"spoiler":false,"text":"時折、核心をついたようなそうでもないような、おかしな推理を燕之介に披露する。"},{"spoiler":false,"text":"一人前扱いして欲しいがまだまだ未熟で、一流の遊女に憧れている。"},{"spoiler":false,"text":"実際はかむろであり、高級遊女になるための修行中の身で、夜鶴の身の回りの世話をしている。"}],"source":"bangumi","sourceCharacterId":"132451"}],"profileFacts":[{"label":"胸围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"24651","sourceWorkId":"34207","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCharacterId":"24651","sourceWorkId":"34207","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"138 cm","valueContext":null,"source":"egs","sourceCharacterId":"24651","sourceWorkId":"34207","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"24651","sourceWorkId":"34207","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"50 cm","valueContext":null,"source":"egs","sourceCharacterId":"24651","sourceWorkId":"34207","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fd59d5adc40512bd45d830a4abc0d924e9f899e3b9497f3f2b64c65bbbfadb0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f23922bc1e0c60011268183cef606d638067c73d06c6247475614f515b219ba.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"麦畑穂香","creatorId":"vndb:s33212","sourcePersonId":"vndb:s33212","canonicalEntityId":"vndb:s33212","name":"麦畑 穂香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:432764:132451:47605:1","source":"bangumi"}]},{"characterId":"char_vndb_c126751","characterName":"鷲塚 燕之介","sourceIds":{"vndbCharacterId":"c126751"},"originalCharacterName":"鷲塚 燕之介","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"gender":{"reviewState":"source-only","source":"vndb","value":"m"},"height":{"reviewState":"source-only","source":"vndb","value":"140"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"b"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"},"weight":{"reviewState":"source-only","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of this work. He is the illegitimate child of a certain samurai family. He lost his father before he was born and his mother went missing."},{"spoiler":false,"text":"He is under the care of a temple and is thus permitted to live at the temple. He typically works as a scribe or as helper for a merchant family, other times he does requests on the behalf of Kuroji, a close friend."},{"spoiler":false,"text":"He stands at 4'6\" (140cm). He has a thin and slender figure. When you use the \"Futanari Girls Patch\" the main character becomes a futanari and a becomes voiced. Their bust is 60cm as a boy and 72cm when futanari."}],"source":"vndb","sourceCharacterId":"c126751"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/590a66892cf8f4364aca56faac4fcdda595238c41518863cd50a5e7efdd0f4a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8509060224ed4f26453539ce0894953a22b6675910748d3b8bd0e65b8e8b345.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花杜 めい","creatorId":"vndb:s19554","sourcePersonId":"vndb:s19554","canonicalEntityId":"vndb:s19554","name":"花杜めい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:94953","source":"vndb"}]},{"characterId":"char_vndb_c133278","characterName":"大鷹黒鵐","sourceIds":{"vndbCharacterId":"c133278"},"originalCharacterName":"大鷹黒鵐","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"186"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The owner of Otaka-ya located in Dojima. He is often referred to as either \"Jiki\" or Otaka-ya's Master\""},{"spoiler":false,"text":"He is 6'1.5\" (~186cm), and always wears a fancy kimono."},{"spoiler":false,"text":"He became the owner of Otaka-ya at a young age, and his store is thriving with the skills he learned from his predecessor. Otaka-ya is nowadays a so-called \"security company\", offering security for brokers during transactions."},{"spoiler":false,"text":"Being a man of vast wealth, he can be incredibly reckless with his spending habits. He enjoys buying prostitutes out of bondage during the first auction of the year. He saved Yozuru, Kosagi, and Uzura from being trafficked. He intends on marrying off the girls to Ennosuke."},{"spoiler":false,"text":"Although he works at the stock exchange in Dojima, he can be found in every red-light district, from the south to the north, and in many other places."},{"spoiler":false,"text":"He and Ennosuke are like brothers, and takes care of him in every way possible. He is aloof but is always looking out for anyone who needs help. He may look careless with alcohol and women, but in fact he is a resourceful man with a sense of justice, compassion, and duty."}],"source":"vndb","sourceCharacterId":"c133278"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f468e22a89fa7792c757d2068d71ea34e76519519c4a771538121889fcbdc6a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e87a1fe867f31ca2ea3202d6d209cafabbbc303e4fd19a00671075dd17b7689.webp","width":256,"height":205,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c133279","characterName":"青葉東吉","sourceIds":{"vndbCharacterId":"c133279"},"originalCharacterName":"青葉東吉","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"182"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He works at the town's magistrate office as an interrogator. He is carries a Jitte entrusted to him by the shogunate."},{"spoiler":false,"text":"He is just over 6 feet tall (about 182 cm)."},{"spoiler":false,"text":"Although he is armed with a Jitte, he does not have a strait-laced image. He is amiable and friendly demeanor has earned him the nickname \"Aoba-no\" from the people of the city."},{"spoiler":false,"text":"He has a somewhat unreliable appearance, but he has a strong sense of justice and cooperates with the protagonists in pursuing cases that occur in the city."},{"spoiler":false,"text":"He is teasingly called \"aza-ji\" by Kuroji and \"aoto-san\" by the protagonist. Every time he tells them to stop they just can't help but laugh."},{"spoiler":false,"text":"He especially dislikes being called \"aoto\" because it's pronounced similarly to chili peppers."}],"source":"vndb","sourceCharacterId":"c133279"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dcee82881fb5bf07a08ca76db6337bfc4a705f91a7e19b55f6c955522f0eff22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36c914cdb1f71740e3216ba4227ace6d5fdc5d60b237d124f235cc4bd7c76c9b.webp","width":256,"height":205,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c133280","characterName":"鶴賀福郎太","sourceIds":{"vndbCharacterId":"c133280"},"originalCharacterName":"鶴賀福郎太","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"135"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The owner of Tsurunoya. A humble and courteous old man."},{"spoiler":false,"text":"He is a short man standing 4'4\" (~135 cm). He always has a smile on his face and is a gentleman through and through. A man with an amiable personality."},{"spoiler":false,"text":"He and Kuroji saved Yozuru, Kosagi and Uzura from being trafficked. He adopted them and are under his care. He is beloved by his adopted daughters and he loves them dearly."}],"source":"vndb","sourceCharacterId":"c133280"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8fb637f603b5fe9cd8be625b558315e13e5ab90dbe81ea1cdbad523b5a131a23.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8f3feb30ed218ab93970e6fd20806394de055a47c98d862c835e121a81b124c.webp","width":256,"height":205,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c133281","characterName":"張谷常次郎","sourceIds":{"vndbCharacterId":"c133281"},"originalCharacterName":"張谷常次郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is known as Haritsune-san. He is the head clerk of an employment agency that specializes in young girls as housemaids."},{"spoiler":false,"text":"He stands at 5'9\"(~180cm)."},{"spoiler":false,"text":"Publicly, his job is to assist girls finding employment. but behind the scenes, he is rumored to be a dangerous human trafficker. He has a certain aesthetic regarding what Ochaya's he visits. He has no interest in anyone being his playmates unless they are young prostitutes."},{"spoiler":false,"text":"He has a bitter feelings toward Kurojii, who snatches up the best prostitutes. He is polite to everyone. Strangely enough, he is very friendly to Ennosuke."}],"source":"vndb","sourceCharacterId":"c133281"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2fa01d2b8b550069e42e0670614ef0929b41431a39eefcdbd378b08e24ee1603.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c4691bc7824691ded3e3d9cf2f2b2e390f8842f60acc85903ccbd326a119f119.webp","width":256,"height":205,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c133282","characterName":"八頭幸右衛門","sourceIds":{"vndbCharacterId":"c133282"},"originalCharacterName":"八頭幸右衛門","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"190"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is one of the officials working at the Azumachi Magistrate's Office and is Aoba Toukichi's superior."},{"spoiler":false,"text":"He stands at 6'2\"(~190cm)."},{"spoiler":false,"text":"He has a massive physique like a boulder and is a man with monstrous strength. He excels at swordsmanship and sometimes competes in imperial tournaments."},{"spoiler":false,"text":"He has the appearance of a man who is forceful and rough around the edges, but in reality he is a well-educated man with a penchant for calligraphy and a thorough knowledge of various subjects."}],"source":"vndb","sourceCharacterId":"c133282"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e3888d58fd07897f28e492764fed5d159562ebc427e2621f18a4e0b3bc53672.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f9ad6eab9da30450a6a0635a586424cdd2204037812a51657b1c287ab33076ff.webp","width":256,"height":205,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c133283","characterName":"金腹和尚","sourceIds":{"vndbCharacterId":"c133283"},"originalCharacterName":"金腹和尚","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The head priest of Shofukuji Temple, where Ennosuke is allowed to live."},{"spoiler":false,"text":"He stands at 5'3\" (~162cm)"},{"spoiler":false,"text":"He is a compassionate but serious person, and does not like it when strange people like Kuroji and Toukichi come to Ennosuke's aid."},{"spoiler":false,"text":"He especially does not like Kurojii because of his occupation. He always lectures him every time they meet, telling him to get a decent job and hard work."},{"spoiler":false,"text":"He is called \"Oshou-sama\" by Ennosuke, \"Oju-ssan\" by Kuroji, and \"Osho-san/sama\" by others."}],"source":"vndb","sourceCharacterId":"c133283"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4fd84261324e7c8047ba6a4bb572b6e8e59c896ab16bab91bf572a03173efdff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51d62a2b7ecd646feeb506efdc7bcea91071ac087505d941b397c597692fc776.webp","width":256,"height":205,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c133284","characterName":"尾武三十郎","sourceIds":{"vndbCharacterId":"c133284"},"originalCharacterName":"尾武三十郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"168"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is owner of the employment agency and Haritsune's boss."},{"spoiler":false,"text":"He stands at 5'5\" (~168cm)."},{"spoiler":false,"text":"He used to be an owner of an Ochaya which had several prostitutes. He went out of business for treating the women poorly. Thanks to the quick thinking of Haritsune, his failed business was transformed into an employment agency."},{"spoiler":false,"text":"He doesn't do anything in particular even though he is the owner. He simply drinks alcohol and smokes from his pipe during the day."},{"spoiler":false,"text":"Just like Haritsune, he is viewed as dangerous by those around him. He is rumored to capture young girls and sell them as prostitutes."},{"spoiler":false,"text":"He is bossy, overbearing, unfriendly and incompetent."}],"source":"vndb","sourceCharacterId":"c133284"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bd/bd3ee26167111b00c4128b5cdb8b6aeb652a0278097306192388bf6b178ebf4d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/caab149dd0bee63aa1c0e5bea3296349f34de93440db8c379e097fe5418a0a48.webp","width":256,"height":205,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1698","sourceCompanyId":"egs:brand:3086","canonicalEntityId":"vndb:p1698","name":"エレクトリップ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:34207:3086","source":"egs"},{"companyId":"vndb:p1698","sourceCompanyId":"vndb:p1698","canonicalEntityId":"vndb:p1698","name":"エレクトリップ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:117104:v44107","source":"vndb"},{"companyId":"vndb:p1698","sourceCompanyId":"vndb:p1698","canonicalEntityId":"vndb:p1698","name":"エレクトリップ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:117105:v44107","source":"vndb"},{"companyId":"vndb:p1698","sourceCompanyId":"vndb:p1698","canonicalEntityId":"vndb:p1698","name":"エレクトリップ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:124705:v44107","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
