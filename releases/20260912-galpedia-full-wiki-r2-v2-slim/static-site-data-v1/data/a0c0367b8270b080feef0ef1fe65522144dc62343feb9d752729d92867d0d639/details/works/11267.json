{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"11267","model":{"presentationWorkId":"vndb:v1654","staff":{"artwork":[{"creditedName":"水原優","creatorId":"vndb:s5166","sourcePersonId":"egs:creator:3387","canonicalEntityId":"vndb:s5166","name":"水原優","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:70392","source":"egs"}],"scenario":[{"creditedName":"六月の玉子(水無月セツオ)","creatorId":"vndb:s4939","sourcePersonId":"egs:creator:9548","canonicalEntityId":"vndb:s4939","name":"六月の玉子(水無月セツオ)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:70393","source":"egs"}],"music":[],"other":[{"creditedName":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","creatorId":"vndb:s592","sourcePersonId":"egs:creator:13068","canonicalEntityId":"vndb:s592","name":"KIZAWA studio(株式会社KIZAWA studio、キザワスタジオ)","detail":"デモムービー","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:74102","source":"egs"}]},"cast":[{"characterId":"char_c46567","characterName":"エレオノラ・マイエル","sourceIds":{"bangumi":[{"characterId":"205529","match":"exact-normalized-name-in-linked-work","subjectId":"223708"}],"egsCharacterIds":["16806"],"vndbCharacterId":"c46567"},"originalCharacterName":"エレオノラ・マイエル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"異世界ウルザードにあるマイエル王家の姫君。"},{"spoiler":false,"text":"良家の子女として育てられ、心根は優しいが、プライドが高く、世間知らずなところも。また意志が強く、思い込みも激しい。さらには感情表現が下手。"},{"spoiler":false,"text":"王家のしきたりに従って、無作為に選ばれた婚約者である主人公を、最初は気に入らず、殺そうと考えていたが、主人公の優しさに触れ、徐々に好意を抱くようになっていく。"},{"spoiler":false,"text":"魔法の弾丸を放つ魔銃を得意として、よく主人公へのツッコミに使われる。"}],"source":"egs","sourceCharacterId":"16806","sourceWorkId":"11267","spoiler":false},{"segments":[{"spoiler":false,"text":"『はらはらフィアンセ ～』登場のヒロイン。"},{"spoiler":false,"text":"異世界ウルザードにあるマイエル王家の姫君。"},{"spoiler":false,"text":"良家の子女として育てられ、心根は優しいが、プライドが高く、世間知らずなところも。また意志が強く、思い込みも激しい。さらには感情表現が下手。"},{"spoiler":false,"text":"王家のしきたりに従って、無作為に選ばれた婚約者である主人公を、最初は気に入らず、殺そうと考えていたが、主人公の優しさに触れ、徐々に好意を抱くようになっていく。"},{"spoiler":false,"text":"魔法の弾丸を放つ魔銃を得意として、よく主人公へのツッコミに使われる。"}],"source":"egs","sourceCharacterId":"16806","sourceWorkId":"16003","spoiler":false},{"segments":[{"spoiler":false,"text":"異世界・ウルザードの住人で、マイエル王家の姫。"},{"spoiler":false,"text":"根は優しいがプライドが高く、世間知らずで感情表現も下手。"},{"spoiler":false,"text":"マイエル王家では無作為に選ばれた婚約者の子を孕むことで一人前の王女として認められるが、エレオノラは幸也の地味でうだつの上がらなそうな外見を嫌い、抹殺し、婚約者を変えようとして現代世界にやってくる。"},{"spoiler":false,"text":"しかし、幸也を抹殺しようとするも逆に命を助けられ、彼の素直さに毒気を抜かれてしまう。"},{"spoiler":false,"text":"また、奥手な幸也に子作りを拒否されたことでプライドが傷つき、意地でも彼から子種を得ようとする。"}],"source":"bangumi","sourceCharacterId":"205529"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12244c633259e8bf0ab0940911c57a38267e29000e356589ee1c3a55762eccc7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88373c849f1a8470fefed7f234af8248dade4af40d38775dad50ee16d3acba2b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七生 みこと","creatorId":"vndb:s1697","sourcePersonId":"vndb:s1697","canonicalEntityId":"vndb:s1697","name":"七生 みこと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14103","source":"vndb"}]},{"characterId":"char_c46568","characterName":"支倉 琴乃","sourceIds":{"bangumi":[{"characterId":"205530","match":"exact-normalized-name-in-linked-work","subjectId":"223708"}],"egsCharacterIds":["14090"],"vndbCharacterId":"c46568"},"originalCharacterName":"支倉 琴乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の家の隣に棲む幼馴染のお姉さん。"},{"spoiler":false,"text":"物腰柔らかで優しく、家事全般も得意で、お嫁さんにしたくなる理想的な女性。"},{"spoiler":false,"text":"主人公にずっと好意を抱いていたが、奥手な性格もあってなかなか想いを伝えることが出来なかった。"},{"spoiler":false,"text":"しかし、エレオノラが現れたことによって、主人公を奪われまいとこれまでの自分をかなぐり捨てて積極的に主人公にアタックするようになる。"}],"source":"egs","sourceCharacterId":"14090","sourceWorkId":"11267","spoiler":false},{"segments":[{"spoiler":false,"text":"『はらはらフィアンセ～貴方を争奪！姫様とお姉ちゃんの懐妊レース!!～』登場のヒロイン。"},{"spoiler":false,"text":"主人公の家の隣に棲む幼馴染のお姉さん。"},{"spoiler":false,"text":"物腰柔らかで優しく、家事全般も得意で、お嫁さんにしたくなる理想的な女性。"},{"spoiler":false,"text":"主人公にずっと好意を抱いていたが、奥手な性格もあってなかなか想いを伝えることが出来なかった。"},{"spoiler":false,"text":"しかし、エレオノラが現れたことによって、主人公を奪われまいとこれまでの自分をかなぐり捨てて積極的に主人公にアタックするようになる。"}],"source":"egs","sourceCharacterId":"14090","sourceWorkId":"13401","spoiler":false},{"segments":[{"spoiler":false,"text":"幸也のお隣さんで、幼い頃からお姉ちゃん役を務めている。"},{"spoiler":false,"text":"優しく物腰は柔らかで、その上家事も万能な理想的なお姉ちゃん。"},{"spoiler":false,"text":"親しい幸也の前でだけ、茶目っ気や甘えた面も垣間見せる。"},{"spoiler":false,"text":"今まで姉弟の域を越えられなかったが、エレオノラの登場でその一線を越えてしまう。"},{"spoiler":false,"text":"外見や表面的には羞恥心が強く奥手なようにも見えるが、一線を越えてからは幸也を手に入れるため、積極的な誘惑に乗り出す。"},{"spoiler":false,"text":"幸也が喜ぶなら大胆なことも……。"},{"spoiler":false,"text":"エレオノラがやってきた経緯を聞き、自分が幸也と子を作って継承権を得て、エレオノラにそれをやると宣言する。"}],"source":"bangumi","sourceCharacterId":"205530"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35c84821f7df880e08d78ee7039548e817b7f508dad5a215e55779a65cc77dcb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f66c0c4715b922ec9295e8e36f79c71e40fce134707eed4424cf87bc223b377.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さくらなつみ","creatorId":"vndb:s666","sourcePersonId":"vndb:s666","canonicalEntityId":"vndb:s666","name":"岩泉まい(樋口まゆら、樋口まゆ)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:223708:205530:6279:1","source":"bangumi"}]},{"characterId":"char_c84181","characterName":"桃沢 可憐","sourceIds":{"bangumi":[{"characterId":"205531","match":"exact-normalized-name-in-linked-work","subjectId":"223708"}],"egsCharacterIds":["16807"],"vndbCharacterId":"c84181"},"originalCharacterName":"桃沢 可憐","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイトで、委員長。"},{"spoiler":false,"text":"地味で大人しい眼鏡ッ娘。"},{"spoiler":false,"text":"何かと気にかけてくれる主人公に想いを寄せるようになるが、引っ込み思案で内気な性格からその想いを伝えられずにいる。"},{"spoiler":false,"text":"そうこうしているうちに、エレオノラが現れ、ますます主人公との距離が遠のいてしまい、何とか主人公を振り向かせようとラブレター作戦に打って出るが、失敗に終わる。"},{"spoiler":false,"text":"失意の彼女は、エレオノラの異母妹で、自らも王位を狙うラビニアに精神を乗っ取られ、彼女の操りに人形と化してしまう。"}],"source":"egs","sourceCharacterId":"16807","sourceWorkId":"11267","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f0f0d83df4105174277dea6ec3aecb94bec3a3ebda9a0e48c3d2bd00545b9a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/1194bac3d1e57e068f9271b737c1f816156b5942b767b169ff64a3de12b8e802.webp","width":184,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c46566","characterName":"岩永 幸也","sourceIds":{"vndbCharacterId":"c46566"},"originalCharacterName":"岩永 幸也","characterNameSource":null,"role":"main","status":"source-only-candidate","identit