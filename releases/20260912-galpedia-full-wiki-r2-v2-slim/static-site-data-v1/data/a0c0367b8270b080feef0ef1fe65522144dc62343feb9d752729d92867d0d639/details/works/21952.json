{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"21952","model":{"presentationWorkId":"egs:21952","staff":{"artwork":[{"creditedName":"あき(原画)","creatorId":"egs:creator:23759","sourcePersonId":"egs:creator:23759","canonicalEntityId":"egs:creator:23759","name":"あき(原画)","roleCode":"artwork","roleLabel":"原画","identityStatus":"alias-only-review","relationId":"egs:work-creator:150332","source":"egs"},{"creditedName":"うめあずき","creatorId":"egs:creator:23763","sourcePersonId":"egs:creator:23763","canonicalEntityId":"egs:creator:23763","name":"うめあずき","roleCode":"artwork","roleLabel":"原画","identityStatus":"alias-only-review","relationId":"egs:work-creator:150336","source":"egs"},{"creditedName":"冨井","creatorId":"egs:creator:23762","sourcePersonId":"egs:creator:23762","canonicalEntityId":"egs:creator:23762","name":"冨井","roleCode":"artwork","roleLabel":"原画","identityStatus":"no-alias-hit","relationId":"egs:work-creator:150337","source":"egs"},{"creditedName":"よしお","creatorId":"egs:creator:23761","sourcePersonId":"egs:creator:23761","canonicalEntityId":"egs:creator:23761","name":"よしお","roleCode":"artwork","roleLabel":"原画","identityStatus":"ambiguous-alias-review","relationId":"egs:work-creator:150338","source":"egs"},{"creditedName":"りぅ","creatorId":"egs:creator:23760","sourcePersonId":"egs:creator:23760","canonicalEntityId":"egs:creator:23760","name":"りぅ","roleCode":"artwork","roleLabel":"原画","identityStatus":"no-alias-hit","relationId":"egs:work-creator:150339","source":"egs"},{"creditedName":"ぬノ介","creatorId":"egs:creator:23770","sourcePersonId":"egs:creator:23770","canonicalEntityId":"egs:creator:23770","name":"ぬノ介","roleCode":"artwork","roleLabel":"原画","identityStatus":"no-alias-hit","relationId":"egs:work-creator:150568","source":"egs"}],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_egs_7550","characterName":"サクラ","sourceIds":{"egsCharacterIds":["7550"]},"origina