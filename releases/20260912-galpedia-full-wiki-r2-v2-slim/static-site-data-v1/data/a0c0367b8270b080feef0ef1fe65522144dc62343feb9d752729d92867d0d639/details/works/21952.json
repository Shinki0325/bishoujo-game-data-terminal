ee90d501fe045e113d363b93dbbc16dba5a3942d3eee681be03d83fa41e1c1c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/3985b5446d06787a1143041f519814f2cc0fa9179519b71bc1b2c9d6b6230e79.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_egs_7552","characterName":"クロハ","sourceIds":{"egsCharacterIds":["7552"]},"originalCharacterName":"クロハ","characterNameSource":null,"role":"1","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"サクラの妹的な存在。その正体は、「禁断の鏡」の影響で生まれた、サクラの分身。やや強気な性格。戦闘ではサクラをサポートする。本体はサクラの心の中におり、その身体はサクラの術によって維持しているため、サクラが睡眠したり、気絶したり、激しく消耗したりすると身体を維持できなくなる。そのとき、彼女の言うには「こころの裏側」に潜ってしまい、サクラからは一切の意思疎通ができなくなる。"}],"source":"egs","sourceCharacterId":"7552","sourceWorkId":"21952","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5da320fb497524716477c8cb89031cbef96894be0b28dffbac58aef84869db44.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f9126d70eca55da802e77c97a71451ef7fe62cf957250f9a633c9f25782c10c.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_egs_7553","characterName":"アウラ ＆ ヴィアーチ","sourceIds":{"egsCharacterIds":["7553"]},"originalCharacterName":"アウラ ＆ ヴィアーチ","characterNameSource":null,"role":"1","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descripti