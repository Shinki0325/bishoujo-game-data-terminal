","canonicalEntityId":"vndb:s12485","name":"猫生 いづる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:17528","source":"vndb"},{"creditedName":"原田 雄一","creatorId":"vndb:s21223","sourcePersonId":"vndb:s21223","canonicalEntityId":"vndb:s21223","name":"原田 たけひと","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:17529","source":"vndb"}]},"cast":[{"characterId":"char_c32838","characterName":"牧野 那波","sourceIds":{"bangumi":[{"characterId":"73350","match":"exact-normalized-name-in-linked-work","subjectId":"7990"}],"egsCharacterIds":["24453"],"vndbCharacterId":"c32838"},"originalCharacterName":"牧野 那波","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"707"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメート。"},{"spoiler":false,"text":"視力がなく、また体も弱く、線が細い感じ。"},{"spoiler":false,"text":"しかし、体のハンディを感じさせないくらい行動が自然。"},{"spoiler":false,"text":"夢に現れる少女と瓜二つ。また、主人公にとても好意的なので、戸惑うことも。"}],"source":"egs","sourceCharacterId":"24453","sourceWorkId":"2019","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的同级生。"},{"spoiler":false,"text":"一头乌黑亮丽的长发、白皙的皮肤让人印象深刻的女孩。身线细长，如同给人的印象一样身体比较弱。"},{"spoiler":false,"text":"贵族小姐般彬彬有礼的口吻和脱线的行动，言行将人翻弄与手掌之中。只是，本人完全不坏恶意因而更显得性质恶劣。不知是不是因稳重的性格而气味相投的关系，与新城和泉出人意料的很要好。"},{"spoiler":false,"text":"根据周围人的话来看，与主人公并非有着什么亲近的血缘关系，不知为何有点单方面粘着主人公的样子。加上奇妙的言行，在主人公眼里，感觉是充满谜团的少女。"}],"source":"bangumi","sourceCharacterId":"73350"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df18e2db17dd5aad7ecb7a22e6d2f7fdf8f761e73a3b3f7e7bb0a3c2a9bca0fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5cbdc2a6b86ee4120e752124d855e783362e2079a217cac61c6b8991a2c0e8a.webp","width":183,"height":220,"source":"static-detail"},"actors":[{"creditedName":"倖月美和","creatorId":"vndb:s1637","sourcePersonId":"vndb:s1637","canonicalEntityId":"vndb:s1637","name":"倖月 美和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7990:73350:11300:2","source":"bangumi"},{"creditedName":"真木碧","creatorId":"vndb:s2000","sourcePersonId":"vndb:s2000","canonicalEntityId":"vndb:s2000","name":"真木 碧","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7990:73350:6130:1","source":"bangumi"}]},{"characterId":"char_c32839","characterName":"琴乃宮 雪","sourceIds":{"bangumi":[{"characterId":"73351","match":"exact-normalized-name-in-linked-work","subjectId":"7990"}],"egsCharacterIds":["24454"],"vndbCharacterId":"c32839"},"originalCharacterName":"琴乃宮 雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公専属のメイドさん（自称）。"},{"spoiler":false,"text":"美人で、性格もよくて、仕事は完璧。まさに非の打ち所がない女性なので、本人の主張するようにメイドとして黙認されている。"},{"spoiler":false,"text":"主人公には恋愛感情を上乗せしたご奉仕精神を持って、尽くしている。ただ、メイドであるため、主人への想いは抑えるという複雑な感情。"}],"source":"egs","sourceCharacterId":"24454","sourceWorkId":"2019","spoiler":false},{"segments":[{"spoiler":false,"text":"女仆。"},{"spoiler":false,"text":"与主人公同居屋檐下，实质可说是家人一般。然而，不知为何硬是要说成自己是主人公的女仆，真是一名奇妙的女子。虽然声称自己是女仆时，让刚醒过来的主人公不知所措，但人长得漂亮，性格又温顺，工作出色，让人觉得非常可靠，结果就这么默认地取得了胜利，自然而然的成为了主人公的女仆。"},{"spoiler":false,"text":"虽然基本可说是言行举止成熟可靠，但意外的有着可爱的性格。有时调戏主人公，但正如此认为时，又会很不可思议的展现出言小孩子般的一面向主人公撒娇。另外，非常宠着主人公，不管发生任何事都会以温柔的笑容接受。只不过，对主人公的着想太过执着固执，其结果很是让主人公苦恼。"}],"source":"bangumi","sourceCharacterId":"73351"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6a631f5a0ff2516e026007ad6b3ef553cc29660447c465e5df7d51ccb9c420c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1b4fbc1b5782868ea2a29908773741048cf972fdb9c07f724be221b08e887d7.webp","width":183,"height":220,"source":"static-detail"},"actors":[{"creditedName":"森山理来","creatorId":"vndb:s563","sourcePersonId":"vndb:s563","canonicalEntityId":"vndb:s563","name":"森山 理来","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7990:73351:18156:2","source":"bangumi"},{"creditedName":"大野まりな","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7990:73351:4434:1","source":"bangumi"}]},{"characterId":"char_c32840","characterName":"宮代 花梨","sourceIds":{"bangumi":[{"characterId":"73354","match":"exact-normalized-name-in-linked-work","subjectId":"7990"}],"egsCharacterIds":["24455"],"vndbCharacterId":"c32840"},"originalCharacterName":"宮代 花梨","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の幼なじみ。"},{"spoiler":false,"text":"勉強は苦手だが、体を動かすことは得意。主人公と続けていた弓道の腕前もなかなかのもの。"},{"spoiler":false,"text":"主人公とは男女を越えた友情みたいもので結ばれた関係だっが、彼の記憶喪失から、すこしチグハグしたものに。"},{"spoiler":false,"text":"新城和泉とは大の親友。"}],"source":"egs","sourceCharacterId":"24455","sourceWorkId":"2019","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的青梅竹马。"},{"spoiler":false,"text":"神社家的女孩。性格活泼，属于动手先于动口的类型。运动神经超群，稍稍不太爱学习，表情易懂的孩子。弓道尤其擅长，会钻牛角尖。往好点说是心胸大度，往差点说是粗线条的性格，易亲近，无论男女都对她心怀爱慕。"},{"spoiler":false,"text":"与主人公关系深厚，青梅竹马外加家离得近，同一班级，同一部活动，其结果就是上下学都在一起，在家门外几乎都是共同行动的感觉。"},{"spoiler":false,"text":"就这样，不知是不是一起惯了的关系，花梨一直找机会想再跟主人公混在一起。"},{"spoiler":false,"text":"然而，失去记忆的主人公不能如其所想的给予相应的反应，花梨对此感到不满和不知所措。"}],"source":"bangumi","sourceCharacterId":"73354"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a93b53b5577988754328fb896a3023c707bfb5217ef00cf8d33b518980585e8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/de5d6f2c3276c61d23c48dddb25dffb3b0796387372e24075dd100ca2858ed19.webp","width":183,"height":220,"source":"static-detail"},"actors":[{"creditedName":"なかせひな","creatorId":"vndb:s926","sourcePersonId":"vndb:s926","canonicalEntityId":"vndb:s926","name":"なかせ ひな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7990:73354:12719:2","source":"bangumi"},{"creditedName":"友永朱音","creatorId":"vndb:s83","sourcePersonId":"vndb:s83","canonicalEntityId":"vndb:s83","name":"友永 朱音","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7990:73354:4432:1","source":"bangumi"},{"creditedName":"芹澤真琴","creatorId":"vndb:s18802","sourcePersonId":"vndb:s18802","canonicalEntityId":"vndb:s18802","name":"芹澤真琴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:8655","source":"vndb"}]},{"characterId":"char_c32841","characterName":"新城 和泉","sourceIds":{"bangumi":[{"characterId":"73360","match":"exact-normalized-name-in-linked-work","subjectId":"7990"}],"egsCharacterIds":["24456"],"vndbCharacterId":"c32841"},"originalCharacterName":"新城 和泉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公、花梨のクラスメート。"},{"spoiler":false,"text":"特に花梨とは大親友の関係。"},{"spoiler":false,"text":"花梨とは正反対で、運動御地だけど勉強は得意。"},{"spoiler":false,"text":"おっとりした性格で、笑顔で周囲を和ませる。"},{"spoiler":false,"text":"しかし、のんびりしすぎてドジを踏むことも多々……。"}],"source":"egs","sourceCharacterId":"24456","sourceWorkId":"2019","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公的同级生。"},{"spoiler":false,"text":"父亲因工作关系而着手于町的开发。也就是说本人是社长的大小姐。虽然运动不行，但成绩优秀。性格内向兴趣是读书，照这样来看感觉应该是内房的大小姐般，但是看上去孩子气，异常大条因而易生祸端，不太给人有那种大小姐的印象。不过话说回来，从生长环境和认生的程度来看，极易招生人误解。不过，只要关系要好了，就会看到她开朗和天正无邪的一面。"},{"spoiler":false,"text":"基本上来说，性格无忧无虑。与主人公或花梨等要好的人在一起时，其温文的举止和微笑的面庞，使周围的气氛非常和谐。"},{"spoiler":false,"text":"很会照顾人，有理性，对主人公来说――特别是在学园生活中――属于值得依靠的存在。不过，当事人很粗线条，托她办的事，屡屡会演变成更令人头痛的事态。"}],"source":"bangumi","sourceCharacterId":"73360"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/818cc98bc90a265a385961a75c37a3d27332a3d589effb7257c7129a7d647ed6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee5c21b9b1fc70d4e98c73a99caa1c933f4ce855abe74537c5fd2e974c266a2d.webp","width":183,"height":220,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7990:73360:4463:1","source":"bangumi"},{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日アン(春乃うらら)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7990:73360:6480:2","source":"bangumi"}]},{"characterId":"char_c32842","characterName":"香坂 アリス","sourceIds":{"bangumi":[{"characterId":"73362","match":"exact-normalized-name-in-linked-work","subjectId":"7990"}],"egsCharacterIds":["24457"],"vndbCharacterId":"c32842"},"originalCharacterName":"香坂 アリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"831"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"教会に住む、双子の姉妹の姉。"},{"spoiler":false,"text":"大人っぽい、キツイ性格。"},{"spoiler":false,"text":"妹のマリアの保護者的存在。しかし、マリアには甘すぎて、どちらがペースを握っているのか分からない。"}],"source":"egs","sourceCharacterId":"24457","sourceWorkId":"2019","spoiler":false},{"segments":[{"spoiler":false,"text":"住在附近教会中的双胞胎姐姐。"},{"spoiler":false,"text":"因为刚搬家过来，所以与主人公没见过面。性格死板。言行理性成熟。而实际上，比起看上去的孩子气，本人远要牢靠到难以想象，而且头脑也很好。"},{"spoiler":false,"text":"姐妹之间完全的作为『姐姐』，口中说这说那，并一直在靠不住的妹妹身旁，有什么万一就立刻帮忙…话是这么说，结果总是哭着脸输掉。有着排外的一面，避开除妹妹以外的人都尽可能的的避开与其接触。另外，靠近自己最爱的妹妹的家伙――特别是，男性――绝不宽恕。"},{"spoiler":false,"text":"因此，对マリア中意的主人公，极其厌恶，尽自己尽自己最大努力想把两人拉远。然而，却意外地容易被身为好人的主人公及周围的人打乱步调……"}],"source":"bangumi","sourceCharacterId":"73362"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b23c273c225e056605e02f67b68e33d0dfd5d86a1feff11cf03ec874cb79c26.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c3/c36a53056f4fa9ac79edd084c9c4e82cb6ddee2dafaee592b2aee7b0f39ceff7.webp","width":183,"height":220,"source":"static-detail"},"actors":[{"creditedName":"竹間千ノ美","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7990:73362:19333:2","source":"bangumi"},{"creditedName":"後藤邑子","creatorId":"vndb:s833","sourcePersonId":"vndb:s833","canonicalEntityId":"vndb:s833","name":"後藤邑子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7990:73362:4514:1","source":"bangumi"}]},{"characterId":"char_c32843","characterName":"香坂 マリア","sourceIds":{"bangumi":[{"characterId":"73363","match":"exact-normalized-name-in-linked-work","subjectId":"7990"}],"egsCharacterIds":["24458"],"vndbCharacterId":"c32843"},"originalCharacterName":"香坂 マリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"831"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"教会に住む、双子の姉妹の妹。"},{"spoiler":false,"text":"純真無垢な性格で、アリスとは正反対。"},{"spoiler":false,"text":"かなりのお姉ちゃん子。"},{"spoiler":false,"text":"主人公を一目見て気に入り、大好きになる。"}],"source":"egs","sourceCharacterId":"24458","sourceWorkId":"2019","spoiler":false},{"segments":[{"spoiler":false,"text":"住在附近教会中的双胞胎妹妹。"},{"spoiler":false,"text":"因为刚搬家过来，所以与主人公没见过面。温柔纯真，有着一颗一往直前的心灵。一有麻烦立刻找姐姐，不管做什么事也喜欢跟姐姐在一起――说起来，属于非常的离不开姐姐。"},{"spoiler":false,"text":"不知为何，对主人公一见倾心，并渐渐的互相成为『朋友』。身为姐姐的アリス对此深感不快，尽可能的想出手阻碍，但当事人却不服输，对主人公投以天真无邪的笑容。旁人看起来可能觉得像可爱的妹妹一样的感觉，但从『失去记忆的主人公』这一角度来看的话，可说是自己唯一的、重要的朋友。"}],"source":"bangumi","sourceCharacterId":"73363"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10def93a6f88587fa7452eda7dd96f99cdcf26811632ec15624c155a2da2d9e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/dab7619f7cfc385ec17d323d391cc300fde293aca76173ce92d94ac8dc5c1ca3.webp","width":183,"height":220,"source":"static-detail"},"actors":[{"creditedName":"あおきさやか","creatorId":"vndb:s194","sourcePersonId":"vndb:s194","canonicalEntityId":"vndb:s194","name":"あおき さやか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7990:73363:4869:1","source":"bangumi"},{"creditedName":"深田愛衣","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:7990:73363:6509:2","source":"bangumi"}]},{"characterId":"char_vndb_c116665","characterNa