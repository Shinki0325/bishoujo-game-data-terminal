er":false,"text":"Second eldest girl in the Yatou household."},{"spoiler":false,"text":"Her personality is less ditzy and she is more reliable than her sister Emoshichi."},{"spoiler":false,"text":"Sometimes she tries to seduce Suguha but it is hard to tell if she is serious or just teasing."},{"spoiler":false,"text":"She quietly brags about how her chest has recently grown larger than Emoshischi's"}],"source":"vndb","sourceCharacterId":"c16543"},{"segments":[{"spoiler":false,"text":"矢頭家の次女。 直刃と右衛門七の妹。"},{"spoiler":false,"text":"勝ち気な性格で、姉の右衛門七よりもしっかりしている面が多々ある。"},{"spoiler":false,"text":"マセた言動で直刃をよく困らせている。"},{"spoiler":false,"text":"具体的な例は直刃の妙技？ ちんちん踊り をせがむなど。"},{"spoiler":false,"text":"地獄修羅子との異名を持つ。 ただし、その名は他人には浸透していない模様。"}],"source":"egs","sourceCharacterId":"4803","sourceWorkId":"20729","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35840217af362a7cd57427587845baf9f1336eb558cb0f0100a8bde15727fec4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b21d35a04a320e317881b4522718dde48461d5a986dc0a81aab4bc6507368e6.webp","width":125,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c34569","characterName":"風早 永遠","sourceIds":{"bangumi":[{"characterId":"38588","match":"exact-normalized-name-in-linked-work","subjectId":"138443"}],"egsCharacterIds":["7168"],"vndbCharacterId":"c34569"},"originalCharacterName":"風早 永遠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"225"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewSt