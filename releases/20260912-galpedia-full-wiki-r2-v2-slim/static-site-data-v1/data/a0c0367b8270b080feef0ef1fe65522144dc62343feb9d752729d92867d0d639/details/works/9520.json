"vndb:s8785","canonicalEntityId":"vndb:s8785","name":"八重桜","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:17657","source":"vndb"},{"creditedName":"身から出た鯖","creatorId":"vndb:s19125","sourcePersonId":"vndb:s19125","canonicalEntityId":"vndb:s19125","name":"身から出た鯖","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:17658","source":"vndb"}]},"cast":[{"characterId":"char_c1519","characterName":"北嶋 楓","sourceIds":{"bangumi":[{"characterId":"16345","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16345","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["557"],"vndbCharacterId":"c1519"},"originalCharacterName":"北嶋 楓","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1021"},"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An extremely shy and fairly nerdish girl. She is also Sara's cousin and is very protective of her. Second year student of St. Michael's Girl's Academy. She has been elected as class president two years in a row."}],"source":"vndb","sourceCharacterId":"c1519"},{"segments":[{"spoiler":false,"text":"ミカ女の2年生で、クラス委員長を務める才女。"},{"spoiler":false,"text":"眼鏡に三つ編みという比較的地味なイメージ。"},{"spoiler":false,"text":"性格はおとなしめで地味だが、責任感がありクラスの信頼も高い。"},{"spoiler":false,"text":"背も高く胸も大きいナイスバディの持ち主。"},{"spoiler":false,"text":"眼鏡＆三つ編み無しの姿が実は美少女であることが発覚し、現在は有名人に。"},{"spoiler":false,"text":"従妹の紗良とは校内の公認カップルで、楓からも積極的に愛情表現をする関係に。"}],"source":"egs","sourceCharacterId":"557","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"ミカ女の３年生で、クラス委員長を務める才女。眼鏡に三つ編みという比較的地味なイメージ。"},{"spoiler":false,"text":"性格はおとなしめで地味だが、責任感がありクラスの信頼も高い。背も高く胸も大きいナイスバディの持ち主。"},{"spoiler":false,"text":"従妹の紗良とは校内の公認カップルで、楓からも積極的に愛情表現をする関係に。"},{"spoiler":false,"text":"現在は紗良とペアで芸能活動をするハメになり、テレビにも出演する多忙な日々を送っている模様。"}],"source":"egs","sourceCharacterId":"557","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"二年级学生，性格内向，是个传统意义上的好孩子，也因此而朋友不多。每个学期都会被高票选为班长，但自己却不喜欢引人注目，又反而因自认为过于平庸而自卑，实际上相当受欢迎。一直很细心照顾堂妹纱良。另外，与松原优菜关系良好。"},{"spoiler":false,"text":"声：五行なずな(=小野涼子)"}],"source":"bangumi","sourceCharacterId":"16345"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b2e81feffc951b839f4a720908c3478783ac619fc43ca6f866fec23a137be2f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf5bc87f114ac07c93eb837dc484b9a3e67866b896f7fe3c736045680c9b093d.webp","width":86,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小野涼子","creatorId":"vndb:s367","sourcePersonId":"vndb:s367","canonicalEntityId":"vndb:s367","name":"小野 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5357:16345:4727:1","source":"bangumi"}]},{"characterId":"char_c1520","characterName":"北嶋 紗良","sourceIds":{"bangumi":[{"characterId":"16649","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16649","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["558"],"vndbCharacterId":"c1520"},"originalCharacterName":"北嶋 紗良","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1124"},"bust":{"reviewState":"source-only","source":"vndb","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A popular teen model who has return from overseas to attend St. Michael's to be with her cousin Kaede. Sara has harbored feelings for Kaede ever since childhood."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c1520"},{"segments":[{"spoiler":false,"text":"ミカ女の1年生で、楓の年下の従妹。"},{"spoiler":false,"text":"ファッション誌などの人気学生モデルで、母は女優というサラブレッド。"},{"spoiler":false,"text":"性格は極めて明るく社交的。その人柄と容姿もあり、無意識に人を惹きつけるカリスマ体質の持ち主。"},{"spoiler":false,"text":"いわゆる裏表のない性格と物言いで、ある意味天然体質。"},{"spoiler":false,"text":"特に楓に対する好意は公私ともに全開状態。"},{"spoiler":false,"text":"人目があろうが真顔で楓に抱き付いて愛情表現しては、その仲の良さを生徒達に羨ましがられている模様。"}],"source":"egs","sourceCharacterId":"558","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"ミカ女の２年生で、楓の年下の従妹。学生モデルを経て現在はＴＶタレント、母は女優というサラブレッド。"},{"spoiler":false,"text":"性格は極めて明るく社交的。その人柄と容姿もあり、無意識に人を惹きつけるカリスマ体質の持ち主。"},{"spoiler":false,"text":"いわゆる裏表のない性格と物言いで、ある意味天然体質。特に楓に対する好意は公私ともに全開状態。"},{"spoiler":false,"text":"現在は恋人の楓とペアでタレント活動を行う、ある意味校内で有名なカップルでもある。"}],"source":"egs","sourceCharacterId":"558","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"枫的堂妹，性格开朗，很有社交天分。小时候二人十分亲密，因为纱良搬家而分离。后来当上了模特，并取得了超高的人气。很喜欢枫，梦想是与堂姐一起穿上婚纱，于是为了追随她而进入了米卡女校，并且搬入了枫的住所与其同住。"},{"spoiler":false,"text":"声：羽里さつき (bgm.tv查不到…)"}],"source":"bangumi","sourceCharacterId":"16649"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ee/ee2fd8d45f087d05c8c5d8fc1bf8086166f8bee58cd300edf67f498739fb0e5a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db6c23b7e66e9079d69b220008b326f1794ae495568584280dd8dfb77b415303.webp","width":87,"height":256,"source":"static-detail"},"actors":[{"creditedName":"椿理沙","creatorId":"vndb:s3863","sourcePersonId":"vndb:s3863","canonicalEntityId":"vndb:s3863","name":"椿 理沙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5357:16649:20162:1","source":"bangumi"}]},{"characterId":"char_c1521","characterName":"松原優菜","sourceIds":{"bangumi":[{"characterId":"16346","match":"exact-normalized-name-in-linked-work","subjectId":"45060"},{"characterId":"16346","match":"exact-normalized-name-in-linked-work","subjectId":"85276"}],"egsCharacterIds":["556"],"vndbCharacterId":"c1521"},"originalCharacterName":"松原優菜","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1104"},"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A second-year high school student. She is smart, attractive, popular and rich girl who is admired by the students of St. Michael's. Yet she falls in love with the clumsy and average Nanami."},{"spoiler":false,"text":"Edited from Wikipedia"}],"source":"vndb","sourceCharacterId":"c1521"},{"segments":[{"spoiler":false,"text":"ミカ女の2年生で、実質上の学生会である「環境整備委員会」の委員長で、両親は大病院の院長というお嬢様。"},{"spoiler":false,"text":"ややおっとりはしているものの、知的美人で性格も温厚。"},{"spoiler":false,"text":"スポーツ万能で巨乳の持ち主という正に完璧超人。"},{"spoiler":false,"text":"下級生はもちろん、上級生にまで慕われる学園のアイドル的存在だが、当人にその自覚はなくやや天然体質。"},{"spoiler":false,"text":"ところが……実はかなりの甘えん坊でエロ乙女。"},{"spoiler":false,"text":"で、身も心もめいっぱい尽くさないと気が済まない困った性格。"}],"source":"egs","sourceCharacterId":"556","sourceWorkId":"17326","spoiler":false},{"segments":[{"spoiler":false,"text":"ミカ女の３年生で、実質上の学生会である「環境整備委員会」の委員長で、両親は大病院の院長というお嬢様。"},{"spoiler":false,"text":"ややおっとりはしているものの、知的美人で性格も温厚。スポーツ万能で巨乳の持ち主という正に完璧超人。"},{"spoiler":false,"text":"相変わらずかなりの甘えん坊でエロ乙女。七海の事となると、なりふり構わず取り乱してしまう一面も。"},{"spoiler":false,"text":"委員長の引退を前に、恋人でもある七海相手に、猛スパルタの特訓中の毎日を過ごしているらしい。"}],"source":"egs","sourceCharacterId":"556","sourceWorkId":"19119","spoiler":false},{"segments":[{"spoiler":false,"text":"米卡女校二年级学生，环境整备委员会会长，在同学之间很吸引目光，是个各方面都很完美的大小姐，而内心十分天然呆以及好色。未来的志向是当医生。与织田七海邂逅的同时也喜欢上了她。"}],"source":"bangumi","sourceCharacterId":"16346"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9c072803dc6fbb6f24e92724427bc16b55006ea909060fd3e71c384d64c961c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/3558bbc922b5417b53a3a81266db79cd6c97917360352188772a3f0c479c9aba.webp","width":84,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岩村琴美","creatorId":"vndb:s1172","sourcePersonId":"vndb:s1172","canonicalEntityId":"vndb:s1172","name":"岩村 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:5357:16346:4813:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p437","sourceCompanyId":"egs:brand:1942","canonicalEntityId":"vndb:p437","name":"ふぐり屋","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:9520:1942","source":"egs"},{"companyId":"vndb:p21699","sourceCompanyId":"vndb:p21699","canonicalEntityId":"vndb:p21699","name":"AleksaPsi","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:124911:v922","source":"vndb"},{"companyId":"vndb:p21699","sourceCompanyId":"vndb:p21699","canonicalEntityId":"vndb:p21699","name":"AleksaPsi","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:124955:v922","source":"vndb"},{"companyId":"vndb:p18672","sourceCompanyId":"vndb:p18672","canonicalEntityId":"vndb:p18672","name":"iqdhk8t0hxww","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:131931:v922","source":"vndb"},{"companyId":"vndb:p1835","sourceCompanyId":"vndb:p1835","canonicalEntityId":"vndb:p1835","name":"Petals' Garden","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:13891:v922","source":"vndb"},{"compan