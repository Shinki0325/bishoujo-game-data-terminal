":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/063baf46b5d53e188ae6fdfae70b2aaba296efcf588cbfa64deeb778e2eb14c9.webp","width":256,"height":191,"source":"static-detail"},"actors":[{"creditedName":"沢城 みゆき","creatorId":"vndb:s43","sourcePersonId":"vndb:s43","canonicalEntityId":"vndb:s43","name":"沢城 みゆき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22225","source":"vndb"},{"creditedName":"Rena Strober","creatorId":"vndb:s10970","sourcePersonId":"vndb:s10970","canonicalEntityId":"vndb:s10970","name":"Rena Strober","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22238","source":"vndb"}]},{"characterId":"char_vndb_c57656","characterName":"セブン","sourceIds":{"vndbCharacterId":"c57656"},"originalCharacterName":"セブン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"45"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A large, bumbling mountain of a man, his appearance and behavior hide an intelligent mind well-equipped for solving problems. His size gives him the strength to do certain functions that only he or Ace are able to do. His bracelet number is 7 and obviously, his codename is his bracelet number."},{"spoiler":false,"text":"From Zero Escape Wikia"}],"source":"vndb","sourceCharacterId":"c57656"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d494d25335a65f854314394abc869710cc71c4a52d55ef4bc63059bac4598fbe.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b267b0d992c48b34f55f5bbcc326f3e507ba9d26cd5eedd0089de61d21c9d2b.webp","width":167,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Edward Bosco","creatorId":"vndb:s178","sourcePersonId":"vndb:s178","canonicalEntityId":"vndb:s178","name":"Edward Bosco","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22230","source":"vndb"},{"creditedName":"三宅 健太","creatorId":"vndb:s2119","sourcePersonId":"vndb:s2119","canonicalEntityId":"vndb:s2119","name":"三宅 健太","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22235","source":"vndb"}]},{"characterId":"char_vndb_c60221","characterName":"一宮","sourceIds":{"vndbCharacterId":"c60221"},"originalCharacterName":"一宮","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"50"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A tall, grave older man with a streak of gray in his hair, he is often the voice of calm reason when events descend into chaos. His bracelet number is 1, hence the codename Ace."},{"spoiler":true,"text":"Gentarou Hongou is the main antagonist of the game, and was ultimately responsible for the event that resulted in its necessity. Despite this, he is actually not the mastermind behind the game's events."},{"spoiler":true,"text":"Hongou suffers from prosopagnosia, which is the inability to recognize faces. It is never clarified how he acquired the condition, nor what type it is. However, it's implied that he both cannot \"see\" faces nor distinguish between them."},{"spoiler":false,"text":"Edited from Zero Escape Wikia"}],"source":"vndb","sourceCharacterId":"c60221"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86fbf19fabee6ccad7a383b7781ff3a9f16ec680c447001ae142955e72724160.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a45ed3d054d9dcd79c638193ab6dc339563d4cb2c075eb9177c15206010d72d5.webp","width":167,"height":256,"source":"static-detail"},"actors":[{"creditedName":"土師 孝也","creatorId":"vndb:s1444","sourcePersonId":"vndb:s1444","canonicalEntityId":"vndb:s1444","name":"土師 孝也","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22233","source":"vndb"},{"creditedName":"Richard Epcar","creatorId":"vndb:s11860","sourcePersonId":"vndb:s11860","canonicalEntityId":"vndb:s11860","name":"Richard Epcar","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22240","source":"vndb"}]},{"characterId":"char_vndb_c60222","characterName":"ニルス","sourceIds":{"vndbCharacterId":"c60222"},"originalCharacterName":"ニルス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"24"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young man with a princely demeanor, he is an unending source of information, but tends to only reveal it when there is no other option. His bracelet number is 2, from the term \"snake eyes\". Ironically, Snake is blind but that does not stop him from being able to work as well as another normal person."},{"spoiler":true,"text":"His real name is Light Field. Light is Clover's older brother."},{"spoiler":false,"text":"From Zero Escape Wikia"}],"source":"vndb","sourceCharacterId":"c60222"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91382e12d8241e2104d22f8c13c68c5f125ab5e9fda75397a71cdfbdb26b66a7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e20568f7e7fef6a10d2150217b1e6328e65e10de5a360ca7b2fad94ea1ed1aaa.webp","width":167,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井 孝宏","creatorId":"vndb:s50","sourcePersonId":"vndb:s50","canonicalEntityId":"vndb:s50","name":"櫻井 孝宏","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22226","source":"vndb"},{"creditedName":"Taliesin Jaffe","creatorId":"vndb:s15819","sourcePersonId":"vndb:s15819","canonicalEntityId":"vndb:s15819","name":"Taliesin Jaffe","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22243","source":"vndb"}]},{"characterId":"char_vndb_c60224","characterName":"サンタ","sourceIds":{"vndbCharacterId":"c60224"},"originalCharacterName":"サンタ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"24"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Little more than a punk with silver hair and a bad attitude at first glance, this clever guy keeps pushing forward and doesn't like dealing with indecisiveness. His bracelet number is 3 so his name comes from \"san\", the Japanese word for \"three\" and that he references Santa Claus several times."},{"spoiler":true,"text":"In reality, Aoi is the co-mastermind of the game, working alongside his sister, Akane Kurashiki. His bracelet number appears to be 3, although his true value is 0."},{"spoiler":false,"text":"From Zero Escape Wikia"}],"source":"vndb","sourceCharacterId":"c60224"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2fd51caae778b32a57edf8414b01b261838799afef28a36f2d4d6208a598dcc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bca7d918b5efc340ede07ebd61f70673945948d47ae81e3817beed77b5fccbd7.webp","width":167,"height":256,"source":"static-detail"},"actors":[{"creditedName":"谷山 紀章","creatorId":"vndb:s59","sourcePersonId":"vndb:s59","canonicalEntityId":"vndb:s59","name":"谷山 紀章","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22227","source":"vndb"},{"creditedName":"Sean Chiplock","creatorId":"vndb:s101","sourcePersonId":"vndb:s101","canonicalEntityId":"vndb:s101","name":"Sean Chiplock","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22228","source":"vndb"}]},{"characterId":"char_vndb_c60225","characterName":"八代","sourceIds":{"vndbCharacterId":"c60225"},"originalCharacterName":"八代","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"40"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A self-serving, barely-dressed woman with unknown skills and knowledge, she does whatever she can to find her way out. Her bracelet number is 8 and Lotus comes from the flower itself, which has 8 petals."},{"spoiler":false,"text":"From Zero Escape Wikia"}],"source":"vndb","sourceCharacterId":"c60225"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e39e5f4bccb870077f715fb4062ec4c252e02a79cf5f2b67b84c61754c885112.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6a7223544a0fed60ddeffbc6c11dce9d572f025cf0a28ac31bc1caf088913394.webp","width":167,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中 理恵","creatorId":"vndb:s1665","sourcePersonId":"vndb:s1665","canonicalEntityId":"vndb:s1665","name":"田中理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22234","source":"vndb"},{"creditedName":"Valerie Arem","creatorId":"vndb:s10971","sourcePersonId":"vndb:s10971","canonicalEntityId":"vndb:s10971","name":"Valerie Arem","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:22239","source":"vndb"}]},{"characterId":"char_vndb_c60226","characterName":"9番の男","sourceIds":{"vndbCharacterId":"c60226"},"originalCharacterName":"9番の男","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A fidgety, nervous man from the start, he knows more than he's letting on. The 9th Man is the only one who does not get to pick what his codename is so the rest of the players refer to him as the 9th Man during the Nonary Game."},{"spoiler":true,"text":"His real name is Teruaki Kubota. Not much about Kubota's early life is known, other than that he was a member of Free the Soul."},{"spoiler":true,"text":"During the First Nonary Game, Kubota was one of the four executives of Cradle Pharmaceutical and was Cradle Pharmaceutical R&D Supervisor. He was part of the creation of the Nonary Project, also known as the First Nonary Game. The First Nonary Game's purpose was to see whether humans could telepathically connect through the morphogenetic field. He created the necessary technology required for the Nonary Game."},{"spoiler":true,"text":"As the supervisor of the R&D department, he was the creator of the RED and DEAD devices used to open the numbered doors and conducted the actual experiments to test them. He also created the numbered bracelets worn by players in the First Nonary Game, since the bracelets were needed to open the numbered doors because of the concept of digital roots involved."},{"spoiler":false,"text":"From Zero Escape Wikia"}],"source":"vndb","sourceCharacterId":"c60226"}],"profileFacts":[],"metadataCandidateCo