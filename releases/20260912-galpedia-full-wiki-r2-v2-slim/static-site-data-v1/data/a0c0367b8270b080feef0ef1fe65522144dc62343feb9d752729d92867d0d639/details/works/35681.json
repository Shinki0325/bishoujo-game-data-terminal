b:vn-staff:174576","source":"vndb"},{"creditedName":"利波 創造","creatorId":"vndb:s4272","sourcePersonId":"vndb:s4272","canonicalEntityId":"vndb:s4272","name":"利波 創造","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:174577","source":"vndb"},{"creditedName":"上島 向陽","creatorId":"vndb:s6789","sourcePersonId":"vndb:s6789","canonicalEntityId":"vndb:s6789","name":"上島 向陽","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:174581","source":"vndb"},{"creditedName":"やなぎ いろ","creatorId":"vndb:s26076","sourcePersonId":"vndb:s26076","canonicalEntityId":"vndb:s26076","name":"やなぎ いろ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:174582","source":"vndb"},{"creditedName":"百日紅 こあ","creatorId":"vndb:s26077","sourcePersonId":"vndb:s26077","canonicalEntityId":"vndb:s26077","name":"百日紅こあ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:174583","source":"vndb"}],"music":[],"other":[{"creditedName":"乃美 糸","creatorId":"vndb:s2929","sourcePersonId":"vndb:s2929","canonicalEntityId":"vndb:s2929","name":"乃美 糸","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:174575","source":"vndb"}]},"cast":[{"characterId":"char_c97154","characterName":"塔夜 水咲","sourceIds":{"bangumi":[{"characterId":"96456","match":"exact-normalized-name-in-linked-work","subjectId":"333989"}],"egsCharacterIds":["23432"],"vndbCharacterId":"c97154"},"originalCharacterName":"塔夜 水咲","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has a bright and not shy personality, is good at getting a sense of distance, and quickly becomes friends with people."},{"spoiler":false,"text":"She and Hyouka are twins, but after losing their parents at a young age, they were adopted into different families and lived separately."},{"spoiler":false,"text":"Her adoptive parents were very kind to her, but her adoptive father died of illness, and her adoptive mother also fell ill and is now living in an orphanage while undergoing rehabilitation."},{"spoiler":false,"text":"As a result, she currently lives alone."},{"spoiler":false,"text":"She wants to work in a job that helps people, and is considering going into medicine in the future."},{"spoiler":false,"text":"Her birth mother is a flute player, and she started playing the flute because of her influence. She is mostly self-taught, but has acquired the skill to perform in front of people."}],"source":"vndb","sourceCharacterId":"c97154"},{"segments":[{"spoiler":false,"text":"明るく人見知りをしない性格で、距離感を掴むのが上手く、人と仲良くなるのが早い。"},{"spoiler":false,"text":"氷花とは双子なのだが、幼い頃に両親を亡くした後、違う家に養子として引き取られ、別々に暮らしてきた。"},{"spoiler":false,"text":"暖かく育ててくれた養親だが、養父は病で亡くなってしまい、養母も病気を患った後、リハビリをしながら養護施設で暮らしている。"},{"spoiler":false,"text":"そのため、現在は一人暮らし。"},{"spoiler":false,"text":"人を助ける仕事がしたいと思っていて、将来は医療の道へ進もうと考えている。"},{"spoiler":false,"text":"生みの母はフルート奏者で、その影響でフルートを始めた。"},{"spoiler":false,"text":"ほぼ独学だが、人前で演奏できるくらいの腕を身につけた。"}],"source":"egs","sourceCharacterId":"23432","sourceWorkId":"30952","spoiler":false},{"segments":[{"spoiler":false,"text":"私立藍ヶ丘学園2年生。"},{"spoiler":false,"text":"帰宅部。"},{"spoiler":false,"text":"明るく人見知りをしない性格で、距離感を掴むのが上手く、人と仲良くなるのが早い。"},{"spoiler":false,"text":"氷花とは双子なのだが、幼い頃に両親を亡くした後、"},{"spoiler":false,"text":"違う家に養子として引き取られ、別々に暮らしてきた。"},{"spoiler":false,"text":"暖かく育ててくれた養親だが、養父は病で亡くなってしまい、"},{"spoiler":false,"text":"養母も病気を患った後、リハビリをしながら養護施設で暮らしている。"},{"spoiler":false,"text":"そのため、現在は一人暮らし。"},{"spoiler":false,"text":"人を助ける仕事がしたいと思っていて、将来は医療の道へ進もうと考えている。"},{"spoiler":false,"text":"生みの母はフルート奏者で、その影響でフルートを始めた。"},{"spoiler":false,"text":"ほぼ独学だが、人前で演奏できるくらいの腕を身につけた。"}],"source":"bangumi","sourceCharacterId":"96456"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b6ea40e2b9682ecdffe58167e7fe8c0320a545af7a19674f54ac74bc0dcfe39.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8facea4e813dfc403a3973f4b174beeb8615db14161a45a73322d3828c82e79.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西連寺亜希","creatorId":"vndb:s14876","sourcePersonId":"vndb:s14876","canonicalEntityId":"vndb:s14876","name":"西連寺 亜希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:333989:96456:36177:1","source":"bangumi"}]},{"characterId":"char_c97155","characterName":"貴嶋 氷花","sourceIds":{"bangumi":[{"characterId":"96457","match":"exact-normalized-name-in-linked-work","subjectId":"333989"}],"egsCharacterIds":["23433"],"vndbCharacterId":"c97155"},"originalCharacterName":"貴嶋 氷花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the younger twin sister of Mizusaki."},{"spoiler":false,"text":"Her emotions are not very volatile, and her facial expressions rarely change drastically. She rarely voices her opinions, and people often say, \"I don't know what she's thinking.\""},{"spoiler":false,"text":"She was adopted by the Kijima family at a young age, and grew up separately from Mizusaki."},{"spoiler":false,"text":"Her biological father is a painter, and perhaps influenced by him, she began to paint."},{"spoiler":false,"text":"She is a member of the art club at school, and is often found staying up late to paint in silence."}],"source":"vndb","sourceCharacterId":"c97155"},{"segments":[{"spoiler":false,"text":"水咲の双子の妹。"},{"spoiler":false,"text":"感情の起伏が小さめで、表情を大きく変えることがほとんどない。"},{"spoiler":false,"text":"自分の意見を口にすることは少なく「何を考えているのかわからない」と言われることも多い。"},{"spoiler":false,"text":"幼い頃に貴嶋家に養子として引き取られ、水咲とは別々に育ってきた。"},{"spoiler":false,"text":"実の父親が画家で、その影響からか絵を描き始める。"},{"spoiler":false,"text":"学園では美術部に所属していて、遅くまで残って黙々と絵を描いていることが多い。"}],"source":"egs","sourceCharacterId":"23433","sourceWorkId":"30952","spoiler":false},{"segments":[{"spoiler":false,"text":"私立藍ヶ丘学園2年生。"},{"spoiler":false,"text":"美術部。"},{"spoiler":false,"text":"水咲の双子の妹。"},{"spoiler":false,"text":"感情の起伏が小さめで、表情を大きく変えることがほとんどない。"},{"spoiler":false,"text":"自分の意見を口にすることは少なく「何を考えているのかわからない」と言われることも多い。"},{"spoiler":false,"text":"幼い頃に貴嶋家に養子として引き取られ、水咲とは別々に育ってきた。"},{"spoiler":false,"text":"実の父親が画家で、その影響からか絵を描き始める。"},{"spoiler":false,"text":"学園では美術部に所属していて、遅くまで残って黙々と絵を描いていることが多い。"}],"source":"bangumi","sourceCharacterId":"96457"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c339fad73d84c0459fc2d673298a54901bbe607380fa81f65b7f55e8fa73eee.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09364c87ca15ac9f3b5509d0c6c786fe0c2b4e8a5dc38bba8fa76fccbdbdda43.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"優希知冴","creatorId":"vndb:s12252","sourcePersonId":"vndb:s12252","canonicalEntityId":"vndb:s12252","name":"優希 知冴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:333989:96457:18452:1","source":"bangumi"}]},{"characterId":"char_c97156","characterName":"瓜生 一穂","sourceIds":{"bangumi":[{"characterId":"96459","match":"exact-normalized-name-in-linked-work","subjectId":"333989"}],"egsCharacterIds":["23434"],"vndbCharacterId":"c97156"},"originalCharacterName":"瓜生 一穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She has a calm personality and is caring, so she is relied upon by her classmates and juniors."},{"spoiler":false,"text":"She is the captain of the club and is an active point getter for the team."},{"spoiler":false,"text":"Her father is the president of a small but well-known local factory."},{"spoiler":false,"text":"Her house is in the neighborhood of the Toya family, and she has known Mizusaki since she was a child."},{"spoiler":false,"text":"To Mizusaki, she is like a real older sister."},{"spoiler":false,"text":"Kazuho also thinks of Mizusaki as a younger sister to some extent."},{"spoiler":false,"text":"She has a sweet tooth, and although she doesn't show it much, she looks forward to the sweets that Futaba makes."}],"source":"vndb","sourceCharacterId":"c97156"},{"segments":[{"spoiler":false,"text":"落ち着いた性格で面倒見が良く、同級生や後輩たちから頼りにされている。"},{"spoiler":false,"text":"部ではキャプテンで、チームのポイントゲッターとして活躍している。"},{"spoiler":false,"text":"父は、規模は小さいけれども技術力で有名な町工場の社長。"},{"spoiler":false,"text":"家は塔夜家と近所で、水咲とは幼いころからの付き合い。"},{"spoiler":false,"text":"水咲にとっては実の姉のような存在。"},{"spoiler":false,"text":"一穂も水咲のことは妹のように思っている部分がある。"},{"spoiler":false,"text":"甘い物好きで、あまり表には出さないけれど双葉の作る菓子を楽しみにしている。"}],"source":"egs","sourceCharacterId":"23434","sourceWorkId":"30952","spoiler":false},{"segments":[{"spoiler":false,"text":"私立藍ヶ丘学園3年生。"},{"spoiler":false,"text":"ホッケー部キャプテン。"},{"spoiler":false,"text":"落ち着いた性格で面倒見が良く、同級生や後輩たちから頼りにされている。"},{"spoiler":false,"text":"部ではキャプテンで、チームのポイントゲッターとして活躍している。"},{"spoiler":false,"text":"父は、規模は小さいけれども技術力で有名な町工場の社長。"},{"spoiler":false,"text":"家は塔夜家と近所で、水咲とは幼いころからの付き合い。"},{"spoiler":false,"text":"水咲にとっては実の姉のような存在。"},{"spoiler":false,"text":"一穂も水咲のことは妹のように思っている部分がある。"},{"spoiler":false,"text":"甘い物好きで、あまり表には出さないけれど双葉の作る菓子を楽しみにしている。"}],"source":"bangumi","sourceCharacterId":"96459"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d0225889515c35380dddff807b87c10b250e6e63e74086514755658a32d1848.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7141898aeccd445b73c0f8eadbe9de4d54525bbfdc30bb7ef3dd23d6f73b44d.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤崎紗矢香","creatorId":"vndb:s6866","sourcePersonId":"vndb:s6866","canonicalEntityId":"vndb:s6866","name":"藤崎 紗矢香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:333989:96459:30075:1","source":"bangumi"}]},{"characterId":"char_c97157","characterName":"瓜生 双葉","sourceIds":{"bangumi":[{"characterId":"96460","match":"exact-normalized-name-in-linked-work","subjectId":"333989"}],"egsCharacterIds":["23435"],"vndbCharacterId":"c97157"},"originalCharacterName":"瓜生 双葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kazuho's younger sister."},{"spoiler":false,"text":"Like Kazuho, ​​she grew up with Mizusaki like sisters."},{"spoiler":false,"text":"She is the complete opposite of her older sister, with a mischievous personality."},{"spoiler":false,"text":"It takes her a while to get motivated to do anything, but she can do it once she puts her mind to it."},{"spoiler":false,"text":"Although she is generally easygoing, she is loyal and values ​​her friends and comrades."},{"spoiler":false,"text":"She cannot leave people in trouble alone, and is quite a busybody."},{"spoiler":false,"text":"To put it in a good way, she is a kind person, but to put it in a bad way, she is a pushover."},{"spoiler":false,"text":"She also has a lonely side, and is always following Kazuho and Mizusaki around."},{"spoiler":false,"text":"She is generally bad at cooking, but is good at making sweets, and often gives the sweets that the club makes to Kazuho."}],"source":"vndb","sourceCharacterId":"c97157"},{"segments":[{"spoiler":false,"text":"一穂の妹。"},{"spoiler":false,"text":"一穂と同じく水咲とは姉妹のようにして育った。"},{"spoiler":false,"text":"姉の一穂とはまったくの正反対で、やんちゃな性格。"},{"spoiler":false,"text":"何事もやる気を出すまでに時間がかかるけれども、やればできる子。"},{"spoiler":false,"text":"基本的にノリは軽めだが義理人情に厚く、友達・仲間を大切にする。"},{"spoiler":false,"text":"困っている人を放っておけない性格で、わりとお節介焼き。"},{"spoiler":false,"text":"よく言えば人が良いのだが、悪く言うとお人好し。"},{"spoiler":false,"text":"また、さみしがり屋な面があり、何かと一穂や水咲について歩いてる。"},{"spoiler":false,"text":"料理は全般的に下手だが、菓子作りは上手で、部で作ったお菓子をよく一穂にあげている。"}],"source":"egs","sourceCharacterId":"23435","sourceWorkId":"30952","spoiler":false},{"segments":[{"spoiler":false,"text":"私立藍ヶ丘学園1年生。"},{"spoiler":false,"text":"菓子研究部。"},{"spoiler":false,"text":"一穂の妹。"},{"spoiler":false,"text":"一穂と同じく水咲とは姉妹のようにして育った。"},{"spoiler":false,"text":"姉の一穂とはまったくの正反対で、やんちゃな性格。"},{"spoiler":false,"text":"何事もやる気を出すまでに時間がかかるけれども、やればできる子。"},{"spoiler":false,"text":"基本的にノリは軽めだが義理人情に厚く、友達・仲間を大切にする。"},{"spoiler":false,"text":"困っている人を放っておけない性格で、わりとお節介焼き。"},{"spoiler":false,"text":"よく言えば人が良いのだが、悪く言うとお人好し。"},{"spoiler":false,"text":"また、さみしがり屋な面があり、何かと一穂や水咲について歩いてる。"},{"spoiler":false,"text":"料理は全般的に下手だが、菓子作りは上手で、部で作ったお菓子をよく一穂にあげている。"}],"source":"bangumi","sourceCharacterId":"96460"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/699d23a9a08070d88288cbb9f01670b03b8001cd5be672e91a605ad34b3e002c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f03fe23ba30cb0a399bec70bcf826091d26b7ce5a511cfc7e70da31dceb23950.webp","width":256,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:333989:96460:10026:1","source":"bangumi"}]},{"characterId":"char_c97158","characterName":"百合本 由奈","sourceIds":{"bangumi":[{"characterId":"96461","match":"exact-normalized-name-in-linked-work","subjectId":"333989"}],"egsCharacterIds":["23436"],"vndbCharacterId":"c97158"},"originalCharacterName":"百合本 由奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Secretary to the president of Kijima System Co., Ltd."},{"spoiler":false,"text":"She lives in the Kijima household and also looks after their private life."},{"spoiler":false,"text":"After graduating from junior college, she worked as a secretary to the president of another company, but due to various circumstances she became a secretary at Kijima System and started living with the Kijima household."},{"spoiler":false,"text":"She has a calm personality and rarely gets emotional, and treats everyone equally."},{"spoiler":false,"text":"She is very polite and competent in her work, and has a good reputation with clients, and is often called upon by members of meetings, etc."},{"spoiler":false,"text":"She has a younger brother, but he suffers from an incurable disease and is constantly hospitalized."}],"source":"vndb","sourceCharacterId":"c97158"},{"segments":[{"spoiler":false,"text":"株式会社キジマシステム・社長秘書。"},{"spoiler":false,"text":"貴嶋家に住み込みで、プライベートの世話も兼ねている。"},{"spoiler":false,"text":"短大卒業後、別の会社で社長秘書をしていたのだが、諸事情あってキジマシステムの秘書になり、貴嶋家で暮らすことになった。"},{"spoiler":false,"text":"落ち着いた性格で、感情的になることはほとんど無く、どんな相手でも分け隔て無く接する。"},{"spoiler":false,"text":"仕事は非常に丁寧かつ有能で、取引先の評判も良く、打ち合わせ等のメンバーにわざわざ使命されることも多い。"},{"spoiler":false,"text":"弟がいるのだが、難病を患っていて入院生活が続いている。"}],"source":"egs","sourceCharacterId":"23436","sourceWorkId":"30952","spoiler":false},{"segments":[{"spoiler":false,"text":"株式会社キジマシステム・社長秘書。"},{"spoiler":false,"text":"貴嶋家に住み込みで、プライベートの世話も兼ねている。"},{"spoiler":false,"text":"短大卒業後、別の会社で社長秘書をしていたのだが、"},{"spoiler":false,"text":"諸事情あってキジマシステムの秘書になり、貴嶋家で暮らすことになった。"}