edName":"じろう","creatorId":"vndb:s6465","sourcePersonId":"vndb:s6465","canonicalEntityId":"vndb:s6465","name":"じろう","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:33089","source":"vndb"},{"creditedName":"IIG","creatorId":"vndb:s3179","sourcePersonId":"vndb:s3179","canonicalEntityId":"vndb:s3179","name":"辻 和也","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:33091","source":"vndb"}]},"cast":[{"characterId":"char_c64193","characterName":"エルミア","sourceIds":{"bangumi":[{"characterId":"213764","match":"exact-normalized-name-in-linked-work","subjectId":"227097"}],"egsCharacterIds":["13967"],"vndbCharacterId":"c64193"},"originalCharacterName":"エルミア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"人間族の父と、エルフ族の母を持つハーフエルフの少女。"},{"spoiler":false,"text":"一緒に暮らす父親が重病を患い、薬を求めて人里に降りてきたところを運悪く見つかり、教会に連行される。"},{"spoiler":false,"text":"エルフの高い素養を受け継ぎつつ、博識で敬虔な宗教家の父の影響もあって、高い教養を身に付けているが、俗世間から離れ、山奥で暮らしていることから、一般常識などに疎く、ほとんど知らないと云っても良い。"},{"spoiler":false,"text":"そのため「中つ国」において大きな力を持つ教会の非情さを噂でしか知らず、また畏怖の対象である異端審問官に対しても物怖じせず、むしろ堂々とした態度を見せるが……。"}],"source":"egs","sourceCharacterId":"13967","sourceWorkId":"12377","spoiler":false},{"segments":[{"spoiler":false,"text":"一緒に暮らしていた父親が重い病気を患い、"},{"spoiler":false,"text":"彼女は薬を求めてフードを被り人里に降りてくる。"},{"spoiler":false,"text":"そこを、運悪く見つかってしまった。"},{"spoiler":false,"text":"エルフの高い素養を受け継ぎつつ、博識で敬虔な宗教家であった父の影響もあり"},{"spoiler":false,"text":"教養は高い水準にあるが、一般常識や俗世についての知識は皆無。"},{"spoiler":false,"text":"教会の強大さや非情さを噂でしか知らないため、"},{"spoiler":false,"text":"畏怖の対象である異端審問官に対しても物怖じせずハッキリと発言する。"},{"spoiler":false,"text":"その高潔な精神を最後まで、どこまで保つように審問の采配を振るうかどうかが、"},{"spoiler":false,"text":"物語の命運を分けるだろう。"}],"source":"bangumi","sourceCharacterId":"213764"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78fe4a87adf9c3200afd142b6dfa998a51651738fa6b9365734526e9028a831c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e8d60c58b12a02e33235113f7b593cc2e6f8be859626c089ba5934254c5a679.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安倍ようこ","creatorId":"vndb:s1369","sourcePersonId":"vndb:s1369","canonicalEntityId":"vndb:s1369","name":"安倍 ようこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:227097:213764:24814:1","source":"bangumi"}]},{"characterId":"char_c64194","characterName":"クロエ","sourceIds":{"bangumi":[{"characterId":"213771","match":"exact-normalized-name-in-linked-work","subjectId":"227097"}],"egsCharacterIds":["13968"],"vndbCharacterId":"c64194"},"originalCharacterName":"クロエ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公に付き従う女神官。"},{"spoiler":false,"text":"常に柔和な微笑みを絶やさず、異端の嫌疑をかけられているエルミアに対しても、親切丁寧に接する。"},{"spoiler":false,"text":"しかし、その笑顔の裏側には、うすら寒い何かを感じさせる。"}],"source":"egs","sourceCharacterId":"13968","sourceWorkId":"12377","spoiler":false},{"segments":[{"spoiler":false,"text":"異端の疑いをかけられているエルミアに対しても親切丁寧であり、"},{"spoiler":false,"text":"常に柔和な笑みを絶やさない。"},{"spoiler":false,"text":"しかしエルミアはその笑顔の裏に、"},{"spoiler":false,"text":"初対面の時から何か言いようのない不安を感じている。"}],"source":"bangumi","sourceCharacterId":"213771"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc2a05d7b3acfa53265bbdc1ec8fd8b6440be33478f545dcb388fdd8350b3657.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d5dc5bed4fa2f321c229fa4e1