":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"65"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Female executive of an evil organization. Being at wits end after being told by her superiors that she hasn't met her recruitment quota, she sets her eyes on the protagonist, who exudes a negative aura."},{"spoiler":false,"text":"She is serious about the fight with magical girls, but she always slips up and makes some airheaded mistake."},{"spoiler":false,"text":"She awakens to the fact that she's into domination when she watches the protagonist violate a magical girl. After that, she starts to forget her actual purpose and works to violate magical girls together with the protagonist."},{"spoiler":false,"text":"Translated from Getchu"}],"source":"vndb","sourceCharacterId":"c154921"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2e342a90e9f76f451392aa49124f3c395ec60101945cc42b2d4f468ae65cce2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2defa41a8f5b8f04354fdc0c813a209cc7f2260ab92afac6a44a46222bbdad97.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花安 未羽","creatorId":"vndb:s16620","sourcePersonId":"vndb:s16620","canonicalEntityId":"vndb:s16620","name":"花安 未羽","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:101633","source":"vndb"}]},{"characterId":"char_vndb_c154922","characterName":"アンジェリク・ローゼ","sourceIds":{"vndbCharacterId":"c154922"},"originalCharacterName":"アンジェリク・ローゼ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"source-only","source":"vndb","value":"148"},"hip":{"reviewState":"source-only","source":"vndb","value":"68"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Angelic Rose is a pure and innocent girl, who usually lives as a student. Everyone adores her like an idol. She has a strong sense of self-sacrifice, and she puts protecting others first."},{"spoiler":false,"text":"Her weapon of choice is a wand. She is skilled in healing and recovery magic, and can use basic offensive magic (to the extent of tearing clothes and causing scratches)."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c154922"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9f1fe3ff8b7eafa4d2cba314a3215e77a3f6dd26536a2cb0dd18205876cf7b72.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/5081771bb1a2e53739eafbea78023281744d4097ed12625d93a6bfdc9ddf0193.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"舞薗 凛華","creatorId":"vndb:s18921","sourcePersonId":"vndb:s18921","canonicalEntityId":"vndb:s18921","name":"舞薗 凛華","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:101634","source":"vndb"}]},{"characterId":"char_vndb_c156637","characterName":"アンジェリク・アクア","sourceIds":{"vndbCharacterId":"c156637"},"originalCharacterName":"アンジェリク・アクア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"source-onl