{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"26108","model":{"presentationWorkId":"vndb:v21718","staff":{"artwork":[{"creditedName":"とぅえる","creatorId":"vndb:s11525","sourcePersonId":"vndb:s11525","canonicalEntityId":"vndb:s11525","name":"とぅえる","roleCode":"art","roleLabel":"原画","identityStatus":"source-native","relationId":"vndb:vn-staff:142936","source":"vndb"}],"scenario":[{"creditedName":"うろじのしは","creatorId":"vndb:s14393","sourcePersonId":"vndb:s14393","canonicalEntityId":"vndb:s14393","name":"うろじのしは","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:142937","source":"vndb"}],"music":[],"other":[{"creditedName":"AKKO","creatorId":"vndb:s5624","sourcePersonId":"vndb:s5624","canonicalEntityId":"vndb:s5624","name":"AKKO","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:142934","source":"vndb"},{"creditedName":"とぅえる","creatorId":"vndb:s11525","sourcePersonId":"vndb:s11525","canonicalEntityId":"vndb:s11525","name":"とぅえる","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:142935","source":"vndb"}]},"cast":[{"characterId":"char_c65787","characterName":"和泉 華音","sourceIds":{"bangumi":[{"characterId":"64875","match":"exact-normalized-name-in-linked-work","subjectId":"224217"}],"egsCharacterIds":["17875"],"vndbCharacterId":"c65787"},"originalCharacterName":"和泉 華音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Second year high school student."},{"spoiler":false,"text":"Actions and speech are a bit cold and old fashioned."},{"spoiler":false,"text":"Appearance is quite graceful and attractive. Results are also countrywide top-level."},{"spoiler":false,"text":"However since she is quite reserved, she doesn't have any social circle and friends are nearly non-existent."},{"spoiler":false,"text":"She is under the impression that \"I don't have any girl-like qualities\". Has not noticed that she is an object of adoration from her surroundings."},{"spoiler":false,"text":"She seems to be aware that she is an out of place existance so she tries as much as possible to not stand out."},{"spoiler":false,"text":"Her true identity is of a holy warrior who protects the academy. She continues fighting against monsters to carry out the mission for righteousness."},{"spoiler":false,"text":"Her battle class is the Holy Knight, which uses magic swords."},{"spoiler":false,"text":"While her strength is of highest level even among the holy warriors, she gets defeated by monsters who pokes at the kindness she hides within herself."}],"source":"vndb","sourceCharacterId":"c65787"},{"segments":[{"spoiler":false,"text":"学園２年生。"},{"spoiler":false,"text":"言葉づかいや仕草がちょっと古風なクール系。"},{"spoiler":false,"text":"容姿端麗で成績は全国トップレベル、スポーツも万能なオールマイティーな美少女だが、極めて寡黙なため人付き合いがなく、友人もまったくいない。"},{"spoiler":false,"text":"『自分には女の子らしいところはない』と思い込んでおり、周囲から憧れの的になっていることにもまったく気づいていない。"},{"spoiler":false,"text":"ちょっと浮いた存在であることは自覚しているらしく、日頃はなるべく目立たないように振る舞っている。"},{"spoiler":false,"text":"その正体は学園を守護する聖戦士であり、正義の使命を果たすべく妖魔との闘いを続けている。"},{"spoiler":false,"text":"戦闘時のクラスタイプは魔法剣を扱う聖騎士。"},{"spoiler":false,"text":"戦闘能力は聖戦士の中でも最上級レベルであり無類の強さを誇るが、内面に隠された優しさを突かれて妖魔に敗北してしまうことになる。"}],"source":"egs","sourceCharacterId":"17875","sourceWorkId":"25599","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9b0cce1fcba52de1286e544db3b399e65841cb580032b7547d0e213a4e9d13c4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54538d19ae7630e9bf176ef3d453847db46dba50ab4132282ced7cb5c97158c8.webp","width":229,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天乙准花","creatorId":"vndb:s339","sourcePersonId":"vndb:s339","canonicalEntityId":"vndb:s339","name":"椎那 天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224217:64875:7890:1","source":"bangumi"}]},{"characterId":"char_c65788","characterName":"神楽 笑子","sourceIds":{"bangumi":[{"characterId":"64876","match":"exact-normalized-name-in-linked-work","subjectId":"224217"}],"egsCharacterIds":["17876"],"vndbCharacterId":"c65788"},"originalCharacterName":"神楽 笑子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Is a second year student. At the beginning of the story, she transfers to the school and becomes classmates with Kanon."},{"spoiler":false,"text":"Personality is very sociable and becomes intimate with anyone immediately. Appearance is also very cute."},{"spoiler":false,"text":"At the time of transferring, she receives treatment as an idol from her peers."},{"spoiler":false,"text":"While very optimistic, she has a clumsy side. However there is a sense of mystery around her as well."},{"spoiler":false,"text":"She seems to be behaving cheerful on purpose to conceal her original self."},{"spoiler":false,"text":"She woke up to her ability as a holy warrior after being attacked by a demon. From there on, she starts fighting against monsters alongside Kanon."},{"spoiler":false,"text":"Her class is of a magic archer. Using her bow to fire magic arrows, she covers for Kanon, who is the vanguard type."},{"spoiler":false,"text":"For Kanon, she is a reliable comrade and close friend, however after being violated by a monster, her body was controlled by the darkness."},{"spoiler":false,"text":"Yielding to the temptation she turned traitor to Kanon and drags her into the humiliating world of depravity."}],"source":"vndb","sourceCharacterId":"c65788"},{"segments":[{"spoiler":false,"text":"学年は２年生で、物語の序盤に学園へ転入してきて華音とクラスメイトになる。"},{"spoiler":false,"text":"性格は非常に社交的で、ひとなつこく、誰とでもすぐに親しくなり、非常に愛らしい容姿ということもあり、転入早々に学園のアイドル的な扱いを受ける。"},{"spoiler":false,"text":"普段は楽天的でちょっとドジっ子な雰囲気を感じさせる行動をとるが、どことなく謎めいたところもあり、本来の自分を隠すためにわざと明るく振る舞っているようにも感じられる。"},{"spoiler":false,"text":"淫獣に襲われたことで聖戦士としての能力に目覚め、以降は華音とともに妖魔と闘う。"},{"spoiler":false,"text":"クラスは魔弓士で、魔法矢を放つ弓を扱い、前衛アタッカータイプの華音を援護射撃でサポートする。"},{"spoiler":false,"text":"華音にとっては頼もしい戦友であり親友でもあるが、妖魔に犯され肉体を闇に支配されてしまい、誘惑に負けて華音を裏切り、屈辱的な堕落の世界へ華音を引きずり込んでいく。"}],"source":"egs","sourceCharacterId":"17876","sourceWorkId":"25599","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00927d9443ddc3400bc7f3a06667821568c1549d5b101e3940bdb25b9fab7a73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74c2d8fd2388b708d8e04833414042549cb951c78c7f550b339b857b468aa877.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"沢野ぽぷら","creatorId":"vndb:s6358","sourcePersonId":"vndb:s6358","canonicalEntityId":"vndb:s6358","name":"冬川 羽衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224217:64876:33029:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p5994","sourceCompanyId":"egs:brand:4893","canonicalEntityId":"vndb:p5994","name":"Rebecca","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:26108:4893","source":"egs"},{"companyId":"vndb:p5994","sourceCompanyId":"vndb:p5994","canonicalEntityId":"vndb:p5994","name":"レベッカ","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:121346:v21718","source":"vndb"},{"companyId":"vndb:p7234","sourceCompanyId":"vndb:p7234","canonicalEntityId":"vndb:p7234","name":"TRYSET Break","roleCodes":[