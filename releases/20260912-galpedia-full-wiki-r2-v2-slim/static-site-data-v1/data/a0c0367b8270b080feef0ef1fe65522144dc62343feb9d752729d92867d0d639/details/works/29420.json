ame":"みやざー","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:165672","source":"vndb"},{"creditedName":"馬場 信繁","creatorId":"vndb:s47876","sourcePersonId":"vndb:s47876","canonicalEntityId":"vndb:s47876","name":"馬場信繁","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:165673","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c79479","characterName":"大鳥 あい","sourceIds":{"vndbCharacterId":"c79479"},"originalCharacterName":"大鳥 あい","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"21"},"birthday":{"reviewState":"source-only","source":"vndb","value":"216"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Assistant Director (Trainee)"},{"spoiler":false,"text":"Ai adores her younger sister, Kokoro. She's meek and diligent, but thinks she's a boring person."},{"spoiler":false,"text":"She has a gloomy, negative temperament, but is a bit of an airhead. People around her think she's interesting."},{"spoiler":false,"text":"When she gets excited, her hometown accent colors her speech."},{"spoiler":false,"text":"She used to enjoy making art, but she fell into a slump and currently isn't drawing."},{"spoiler":false,"text":"Following her sister, she moved to Tokyo alone and got hired by Eureka Software."},{"spoiler":false,"text":"From Official site"}],"source":"vndb","sourceCharacterId":"c79479"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a5308a74160f99aab900219524a5ba1aae7938ac7b5ab1cf27f627d1b2583e0f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b7b9deaa2ea3a7d839274afce5425638ea655f3240625329c388ecc4494492a.webp","width":179,"height":256,"source":"static-detail"},"actors":[{"creditedName":"吉岡 麻耶","creatorId":"vndb:s5512","sourcePersonId":"vndb:s5512","canonicalEntityId":"vndb:s5512","name":"吉岡 麻耶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84369","source":"vndb"}]},{"characterId":"char_vndb_c79480","characterName":"柳谷 こころ","sourceIds":{"vndbCharacterId":"c79480"},"originalCharacterName":"柳谷 こころ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"19"},"birthday":{"reviewState":"source-only","source":"vndb","value":"216"},"height":{"reviewState":"source-only","source":"vndb","value":"153"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Game Director"},{"spoiler":false,"text":"Back when she was still in her hometown with her older sister Ai, before she joined Eureka Software, she was a cheerful, friendly, puppy-like girl. Now that she's become an adult, Kokoro is cool young woman who says whatever is on her mind."},{"spoiler":false,"text":"It's unclear why she's so harsh toward her sister Ai."},{"spoiler":false,"text":"As she's still a novice director, her job is demanding day-in and day-out, leaving her constantly in a bad mood."},{"spoiler":false,"text":"From Official site"}],"source":"vndb","sourceCharacterId":"c79480"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b5b00534cc6274bc603f828f021692dbd9dcafaa9d4c552fd90b25b01ba4a53.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0c4ff12326e421980c933709a8a7aac16df6a8a0cc631de7281d447b21b7501d.webp","width":179,"height":256,"source":"static-detail"},"actors":[{"creditedName":"沼倉 愛美","creatorId":"vndb:s5613","sourcePersonId":"vndb:s5613","canonicalEntityId":"vndb:s5613","name":"沼倉愛美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84370","source":"vndb"}]},{"characterId":"char_vndb_c79481","characterName":"無間堂 さき","sourceIds":{"vndbCharacterId":"c79481"},"originalCharacterName":"無間堂 さき","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"26"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1226"},"height":{"reviewState":"source-only","source":"vndb","value":"147"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Narrative Writer"},{"spoiler":false,"text":"Eureka Software's lead narrative writer."},{"spoiler":false,"text":"Always wearing headphones, Saki is a self-centered girl who doesn't listen when people talk to her and goes about things the way she feels like."},{"spoiler":false,"text":"She always wears a track suit and looks younger than she is due to her short height and cute looks."},{"spoiler":false,"text":"She was the writer for the original version of Dreams and Reality - Nie, the Witch, and the End of the World that they are remaking now and is a veteran of Eureka Software."},{"spoiler":false,"text":"She's always going \"roar!!\" so people call her Tinysaurus."},{"spoiler":false,"text":"From Official site"}],"source":"vndb","sourceCharacterId":"c79481"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/403d413a68669f7212f6ed82c5fe2276aa64edf0e54373880dbae557df6611a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55835baeda00b634a12111b0edab3ef9f6fdf044d788f47162a0587062dd5c7c.webp","width":179,"height":256,"source":"static-detail"},"actors":[{"creditedName":"徳井 青空","creatorId":"vndb:s5614","sourcePersonId":"vndb:s5614","canonicalEntityId":"vndb:s5614","name":"徳井 青空","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:84371","source":"vndb"}]},{"characterId":"char_vndb_c79482","characterName":"太刀花 なな","sourceIds":{"vndbCharacterId":"c79482"},"originalCharacterName":"太刀花 なな","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"birthday":{"reviewState":"source-only","source":"vndb","value":"201"},"height":{"reviewState":"source-only","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Office Staff (Voice Actor)"},{"spoiler":false,"text":"Part-time worker who does administrative work other than Eureka Software development, like answering phones and making tea."},{"spoiler":false,"text":"Nana is actually a struggling voice actor who can't pay the bills yet on acting alone."},{"spoiler":false,"text":"She creates a pleasant atmosphere at Eureka. Her bright personality lets her join in on any fun and she's friendly and open with everyone."},{"spoiler":false,"text":"A self-professed \"Banana Maid.\" Cosplaying is just her hobby."},{"spoiler":false,"text":"From Official site"}],"source":"vndb","sourceCharacterId":"c79482"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2bcd15f3c5dc49841e7f94468fae964c8cde1955c717c2743ab30212d03d991e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02682c0e66873d15a85bb7d44c5a5173bdea4c36f990fd9e3e4941864c124f79.webp","width":179,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井澤 詩織","creatorId":"vndb:s7962","sourc