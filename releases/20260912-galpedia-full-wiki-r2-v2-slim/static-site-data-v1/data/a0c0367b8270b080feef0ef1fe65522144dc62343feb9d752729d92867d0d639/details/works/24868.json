{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"24868","model":{"presentationWorkId":"vndb:v28707","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c166405","characterName":"ドナ・フロイド","sourceIds":{"vndbCharacterId":"c166405"},"originalCharacterName":"ドナ・フロイド","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist."},{"spoiler":false,"text":"She is the daughter of a large farm in the countryside and helps out with the farmwork herself. She is painfully out of touch with fashion and trends. When her grandmother, who lived in London, passes away, she is saddled with the task of sorting through her grandmother’s belongings, leading her to visit the city for the first time in her life."}],"source":"vndb","sourceCharacterId":"c166405"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e10255e899e81c670c57a4fe383eba5b2ea10e0f2db05963e1def495688201e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d227d3e4742edead5ce6affe2cc793e1dae01efdd37558593be73feca305092e.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c166406","characterName":"C・ライナス・ キャヴェンディッシュ","sourceIds":{"vndbCharacterId":"c166406"},"originalCharacterName":"C・ライナス・ キャヴェンディッシュ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Favorite Tea: Darjeeling"},{"spoiler":false,"text":"The young head of the prestigious Cavendish family. Though he comes from an ancient lineage, he dislikes conservative thinking. With his outspoken personality and firm belief in meritocracy, he has many enemies among the aristocracy, who place class above all else. However, he is also well-liked because he takes good care of those he favors. When it comes to tea, he prefers it simple and served straight."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c166406"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/6392cbbe83db4ca141ecd8fdc328d724aca93e4b67bca2fb2571d0d117a576fb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae0782e2f0cfbace974412481441aa2314472568f1f9782803b435ed98df0f0a.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c166407","characterName":"フレッド・バージェス","sourceIds":{"vndbCharacterId":"c166407"},"originalCharacterName":"フレッド・バージェス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Favorite tea: Herbal tea."},{"spoiler":false,"text":"He works alongside his older sister at their grandmother’s house in London. He has a charming personality that makes him popular with everyone, though he can be a bit clueless at times. As a result, he’s often scolded by his responsible older sister, but he never lets it get him down. He loves gardening and is often seen out in the garden. He knows a lot about herbs. For him, the benefits of tea matter more than the taste. The Floyd family’s herbal tea is his own creation."}],"source":"vndb","sourceCharacterId":"c166407"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/008a245564332a6926130d3fa8fb305996b7a0eaecd77fac1a13c67e046cd5a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c28c89a6cf7dd1324fd9261f2ed7cf578bf347f016517e6df0baab9da6a1a3d.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c166408","characterName":"ジェナ・バージェス","sourceIds":{"vndbCharacterId":"c166408"},"originalCharacterName":"ジェナ・バージェス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Fred’s older sister, she works as a maid alongside her brother at Donna's grandmother’s house in London. She takes her job seriously, and is often seen scolding her brother when he makes a mistake. Although she is often perceived as quick-tempered, she is actually a kind and devoted woman. Apparently, she is quite skilled at sewing."},{"spoiler":false,"text":"Translated from the official website"}],"source":"vndb","sourceCharacterId":"c166408"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0b4cce1497f83d135e0b38dd62be9352e714714d865fc65d24ee13f63b47b22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/3027f507145e2bcf2c3eabc4454e5fea5c18095c23f4386084176082cf886cd6.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c166409","characterName":"フレッド父","sourceIds":{"vndbCharacterId":"c166409"},"originalCharacterName":"フレッド父","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConfli