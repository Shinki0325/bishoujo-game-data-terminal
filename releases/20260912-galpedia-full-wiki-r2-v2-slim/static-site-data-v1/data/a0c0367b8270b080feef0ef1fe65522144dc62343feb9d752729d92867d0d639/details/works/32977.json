"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d73138d7bec569c866d876cda8e38721a6461ffa3edf4e97f8a9d7e5463dfd68.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b41a5796e5b2f015c7f81075b17fcf59dbeccc1d32353208c8ae339bb3eb2c45.webp","width":185,"height":256,"source":"static-detail"},"actors":[{"creditedName":"湯宮由海","creatorId":"vndb:s5006","sourcePersonId":"vndb:s5006","canonicalEntityId":"vndb:s5006","name":"湯宮 由海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:392140:114024:19558:1","source":"bangumi"}]},{"characterId":"char_c91241","characterName":"ハル","sourceIds":{"bangumi":[{"characterId":"77724","match":"exact-normalized-name-in-linked-work","subjectId":"308933"},{"characterId":"77724","match":"exact-normalized-name-in-linked-work","subjectId":"330502"},{"characterId":"77724","match":"exact-normalized-name-in-linked-work","subjectId":"392140"}],"egsCharacterIds":["22795"],"vndbCharacterId":"c91241"},"originalCharacterName":"ハル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The Dragon Princess who resides with Takeru after a fateful encounter."}],"source":"vndb","sourceCharacterId":"c91241"},{"segments":[{"spoiler":false,"text":"全ての竜を率いる竜種の女王の娘で、ある意味、地球の命運すら左右するファクター的な存在。"},{"spoiler":false,"text":"物語冒頭、何故か一人（一匹？）小竜の状態で地球に下りてきたことで主人公と出会い、そのままペットとして飼われることに。"},{"spoiler":false,"text":"覚醒を果たして色々ご立派になった今も立場やスタンスはあまり変わっていない。"},{"spoiler":false,"text":"食べたり寝たりゴロゴロしたり、相撲を見たりとスローライフを満喫している。"},{"spoiler":false,"text":"(「竜という種族そのものが古来からそういう在り方」というのが本人の弁。違いない)"},{"spoiler":false,"text":"主人公のことは遺伝子レベルで慕っていて、一緒にいられるだけで幸せ。"},{"spoiler":false,"text":"でも、おなかが空いたら話は別。"},{"spoiler":false,"text":"好物はお隣の『和菓子いちのせ』のおまんじゅう。"},{"spoiler":false,"text":"アイスも好き。ハンバーガーとかも好き。"},{"spoiler":false,"text":"食べられるものはだいたい好きって言うという噂も。"}],"source":"egs","sourceCharacterId":"22795","sourceWorkId":"29727","spoiler":false},{"segments":[{"spoiler":false,"text":"ドラゴン達の王、『天』の王の娘。"},{"spoiler":false,"text":"ニートも板についてきたちゃっかり系ドラゴン姫。"},{"spoiler":false,"text":"相変わらず主人公のことが大好きで一緒にいられるだけで幸せ。"},{"spoiler":false,"text":"だが最近はちょっとした買い物やザリガニ釣りには付いてこなくなってきた。"},{"spoiler":false,"text":"(外は暑いから)"},{"spoiler":false,"text":"お隣の『和菓子いちのせ』に縄張りを広げ、よく遊びに行ったりしている。"},{"spoiler":false,"text":"今回は初めて主人公と海に一緒に行くのでワクワクドキドキ。"},{"spoiler":false,"text":"ちょっぴり進んだ大人な自分をアピールすることを企んでるとかいないとか。"}],"source":"egs","sourceCharacterId":"22795","sourceWorkId":"30778","spoiler":false},{"segments":[{"spoiler":false,"text":"ドラゴン達の王・天竜王の一人娘で、やがてドラゴンを統治する無敵の竜姫。"},{"spoiler":false,"text":"夫(自称)である主人公の元、相変わらずのんびりニートな生活を満喫している。"},{"spoiler":false,"text":"最近は、海バカンスの後で押しかけてきたイリスやさんごの存在がちょっとした悩みの種。"},{"spoiler":false,"text":"特にイリスとは主人公を巡ってよく喧嘩している。"},{"spoiler":false,"text":"だが、「自分の夫ともあろう男がモテるのは仕方ない」という寛容さも持ち合わせている様子。"},{"spoiler":false,"text":"人間でもドラゴンでも、恋は目を曇らせるということかもしれない。"},{"spoiler":false,"text":"姉妹同然(なお覚えてない)とも言うべきメイの登場にはさすがに困惑……。"},{"spoiler":false,"text":"というようなこともなく、今はお祭りが楽しみで仕方ない。"}],"source":"egs","sourceCharacterId":"22795","sourceWorkId":"32977","spoiler":false},{"segments":[{"spoiler":false,"text":"全ての竜を率いる竜種の女王の娘で、"},{"spoiler":false,"text":"ある意味、地球の命運すら左右するファクター的な存在。"},{"spoiler":false,"text":"物語冒頭、何故か一人（一匹？）小竜の状態で"},{"spoiler":false,"text":"地球に下りてきたことで主人公と出会い、"},{"spoiler":false,"text":"そのままペットとして飼われることに。"},{"spoiler":false,"text":"覚醒を果たして色々ご立派になった今も立場やスタンスはあまり変わっていない。"},{"spoiler":false,"text":"食べたり寝たりゴロゴロしたり、相撲を見たりとスローライフを満喫している。"},{"spoiler":false,"text":"(「竜という種族そのものが古来からそういう在り方」というのが"},{"spoiler":false,"text":"本人の弁。違いない)"},{"spoiler":false,"text":"主人公のことは遺伝子レベルで慕っていて、一緒にいられるだけで幸せ。"},{"spoiler":false,"text":"でも、おなかが空いたら話は別。"},{"spoiler":false,"text":"好物はお隣の『和菓子いちのせ』のおまんじゅう。"},{"spoiler":false,"text":"アイスも好き。ハンバーガーとかも好き。"},{"spoiler":false,"text":"食べられるものはだいたい好きって言うという噂も。"}],"source":"bangumi","sourceCharacterId":"77724"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/395b3ea807e347bbbbba381b47917405b74e274082ca64937d7b9506be2e776e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43a5d07f93301d4ed845b630659e5bfa6e27d7c83d4a71d4ab73dc049503cdeb.webp","width":193,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小澤みのり","creatorId":"vndb:s15910","sourcePersonId":"vndb:s15910","canonicalEntityId":"vndb:s15910","name":"小澤 みのり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:392140:77724:32659:1","source":"bangumi"}]},{"characterId":"char_c91242","characterName":"一ノ瀬 鈴夏","sourceIds":{"bangumi":[{"characterId":"77725","match":"exact-normalized-name-in-linked-work","subjectId":"308933"},{"characterId":"77725","match":"exact-normalized-name-in-linked-work","subjectId":"330502"},{"characterId":"77725","match":"exact-normalized-name-in-linked-work","subjectId":"392140"}],"egsCharacterIds":["22796"],"vndbCharacterId":"c91242"},"originalCharacterName":"一ノ瀬 鈴夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Takeru's childhood friend who works at her mothers sweetshop nextdoor."}],"source":"vndb","sourceCharacterId":"c91242"},{"segments":[{"spoiler":false,"text":"主人公の幼馴染で家もお隣さん。"},{"spoiler":false,"text":"廃墟同然の宮本流なんとかかんとか道場と違い、『和菓子いちのせ』は代々続く地元の名店として客が絶えない。"},{"spoiler":false,"text":"その一人娘である鈴夏がギャルギャルしてるのはちょっとしたミステリー。"},{"spoiler":false,"text":"現在は名前が書ければ入れると噂される地元の大学に通っている。"},{"spoiler":false,"text":"主人公には(義務感と責任感から)何かと上から目線でちょっかいを出してくるが、すぐ言いくるめられる残念ちょろ子。"},{"spoiler":false,"text":"面倒見のよさもあって、色んな意味でカモられてる。"},{"spoiler":false,"text":"見た目の割に意外と家庭的で、家の手伝いも積極的にしている。"},{"spoiler":false,"text":"昔から主人公のことが大好きで、もうちょっとしっかりして欲しいと思いつつ、今の「だめな男を養ってあげる健気なあたし」的なポジションに満足してる様子も窺える。"},{"spoiler":false,"text":"あれこれ事件に巻き込まれたり、角と尻尾が生えたりと何気に不幸体質。でも元気。"}],"source":"egs","sourceCharacterId":"22796","sourceWorkId":"29727","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼馴染で、お隣の『和菓子いちのせ』の一人娘。"},{"spoiler":false,"text":"前回なんやかんやあって古の竜（ほとんど意思疎通は不可能）に憑依され、ドラゴン娘としてデビューした。"},{"spoiler":false,"text":"だからといって何がどうなったわけではなく、感情が乱れると角や尻尾が出るくらいのもの。"},{"spoiler":false,"text":"……十分大事にも思えるが、本人は特に気にしてない。"},{"spoiler":false,"text":"ドラゴンになろうがライバル増えようが、世話焼き女房ポジションは不動。"},{"spoiler":false,"text":"「またあたしばっかり」みたいなことを思いながらもバカに尽くしてしまう、微笑ましくも不憫なポジション。"},{"spoiler":false,"text":"あれ（主人公）の何がいいのかは不明。"}],"source":"egs","sourceCharacterId":"22796","sourceWorkId":"30778","spoiler":false},{"segments":[{"spoiler":false,"text":"残念ポジションも板についてきた、主人公の幼馴染で『和菓子いちのせ』の一人娘。"},{"spoiler":false,"text":"古の竜に憑依されたドラゴン娘状態は変わらず、気を抜くとつい変身してしまう。"},{"spoiler":false,"text":"真面目で明るくて勤勉でオタクと、いいセンいってる純情系ギャル。"},{"spoiler":false,"text":"欠点は男を見る目が悪いことくらい(周囲・談)。"},{"spoiler":false,"text":"その相手(主人公)とは前回の海バカンスでも、それほど関係の進展はなし。"},{"spoiler":false,"text":"このまま夏が終わりそうなことに頭を悩ませている。"},{"spoiler":false,"text":"とはいえ、ハルやさんご達にもしっかり友情は感じているし、あまり刺激したくないのも本音。"},{"spoiler":false,"text":"とりあえずは町内会の夏祭りで特別な思い出作りを画策している模様。"}],"source":"egs","sourceCharacterId":"22796","sourceWorkId":"32977","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼馴染で家もお隣さん。"},{"spoiler":false,"text":"廃墟同然の宮本流なんとかかんとか道場と違い、"},{"spoiler":false,"text":"『和菓子いちのせ』は代々続く地元の名店として客が絶えない。"},{"spoiler":false,"text":"その一人娘である鈴夏がギャルギャルしてるのはちょっとしたミステリー。"},{"spoiler":false,"text":"現在は名前が書ければ入れると噂される地元の大学に通っている。"},{"spoiler":false,"text":"主人公には(義務感と責任感から)何かと上から目線でちょっかいを出してくるが、"},{"spoiler":false,"text":"すぐ言いくるめられる残念ちょろ子。"},{"spoiler":false,"text":"面倒見のよさもあって、色んな意味でカモられてる。"},{"spoiler":false,"text":"見た目の割に意外と家庭的で、家の手伝いも積極的にしている。"},{"spoiler":false,"text":"昔から主人公のことが大好きで、もうちょっとしっかりして欲しいと思いつつ、"},{"spoiler":false,"text":"今の「だめな男を養ってあげる健気なあたし」的なポジションに満足してる様子も窺える。"},{"spoiler":false,"text":"あれこれ事件に巻き込まれたり、角と尻尾が生えたりと何気に不幸体質。でも元気。"}],"source":"bangumi","sourceCharacterId":"77725"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e835aad71776a70504678fda024c6a7f350aad0408bc4203a0baca27a24b0b20.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1c21c44bee80b3501070c4bf2cf4a4ac2da550965839bf6f663dbd8e2ffe2bde.webp","width":86,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長妻樹里","creatorId":"vndb:s1197","sourcePersonId":"vndb:s1197","canonicalEntityId":"vndb:s1197","name":"長妻 樹里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:392140:77725:8493:1","source":"bangumi"}]},{"characterId":"char_c91243","characterName":"一ノ瀬 秋乃","sourceIds":{"bangumi":[{"characterId":"77727","match":"exact-normalized-name-in-linked-work","subjectId":"308933"},{"characterId":"77727","match":"exact-normalized-name-in-linked-work","subjectId":"330502"},{"characterId":"77727","match":"exact-normalized-name-in-linked-work","subjectId":"392140"}],"egsCharacterIds":["22798"],"vndbCharacterId":"c91243"},"originalCharacterName":"一ノ瀬 秋乃","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Suzuka's mother and owner of the sweetshop."}],"source":"vndb","sourceCharacterId":"c91243"},{"segments":[{"spoiler":false,"text":"『和菓子いちのせ』の店主で、鈴夏の母親。"},{"spoiler":false,"text":"おっとりのんびりで、誰にでも優しい彼女目当てに足繁くお店に通う常連もいるとかいないとか。"},{"spoiler":false,"text":"「ママ」「鈴夏ちゃん」と呼びあっていたりと親子仲は良好。"},{"spoiler":false,"text":"主人公のことも子供の頃から知っていて、家に寄り付かない彼の父親(ゴリラ)の代わりに面倒を見ていた時期もある。"},{"spoiler":false,"text":"そういう意味では、主人公が頭が上がらない唯一の大人と言っていい。"}],"source":"egs","sourceCharacterId":"22798","sourceWorkId":"29727","spoiler":false},{"segments":[{"spoiler":false,"text":"代々続く地元の名店『和菓子いちのせ』の店主で、鈴夏の母親。"},{"spoiler":false,"text":"おっとりのんびりな性格で、ドラゴンにも偏見がない。"},{"spoiler":false,"text":"日々を穏やかに生きながら主人公の成長（微速）や鈴夏とのあれこれを優しく見守ってきた。"},{"spoiler":false,"text":"……が、最近は雲行きの怪しさを感じていたりいなかったり。"},{"spoiler":false,"text":"母の苦悩の日々は続く。"},{"spoiler":false,"text":"「そんなにあれ(バカ)跡継ぎに欲しいか？」とか言うのは野暮である。"}],"source":"egs","sourceCharacterId":"22798","sourceWorkId":"30778","spoiler":false},{"segments":[{"spoiler":false,"text":"代々続く地元の名店『和菓子いちのせ』の店主で、鈴夏の母親。"},{"spoiler":false,"text":"ご町内の誰もが知るおっとりうふふー美人。"},{"spoiler":false,"text":"だが、最近は笑顔に翳りが見えることも。"},{"spoiler":false,"text":"夏の海バカンスで婿候補(バカ)が嫁候補(ドラゴンの王)を増やして戻ってきたのが理由。"},{"spoiler":false,"text":"いざという時に臆病になってしまう娘の消極性を愛おしく思いつつも、そこは女の大先輩。"},{"spoiler":false,"text":"「勝負に出なければいつまでも都合のいい女として扱われてしまう」と、『いちのせ』も参加する夏祭りを上手く使うよう娘にアドバイスするが……？"},{"spoiler":false,"text":"基本的にため息が似合うトホホな立ち位置は相変わらず。"}],"source":"egs","sourceCharacterId":"22798","sourceWorkId":"32977","spoiler":false},{"segments":[{"spoiler":false,"text":"『和菓子いちのせ』の店主で、鈴夏の母親。"},{"spoiler":false,"text":"おっとりのんびりで、誰にでも優しい彼女目当てに"},{"spoiler":false,"text":"足繁くお店に通う常連もいるとかいないとか。"},{"spoiler":false,"text":"「ママ」「鈴夏ちゃん」と呼びあっていたりと親子仲は良好。"},{"spoiler":false,"text":"主人公のことも子供の頃から知っていて、"},{"spoiler":false,"text":"家に寄り付かない彼の父親(ゴリラ)の代わりに面倒を見ていた時期もある。"},{"spoiler":false,"text":"そういう意味では、主人公が頭が上がらない唯一の大人と言っていい。"}],"source":"bangumi","sourceCharacterId":"77727"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8aa792933b0d2a60574d6ec804b021403e12049d2ad3aca6ed96fe3e0c30b289.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/197b6398cc48257700d395fdf82c2f97de02b421bc52d44974a46d8664c1f4dd.webp","width":72,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長みこと","creatorId":"vndb:s18525","sourcePersonId":"vndb:s18525","canonicalEntityId":"vndb:s18525","name":"鳴瀬なごみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:392140:77727:34378:1","source":"bangumi"}]},{"characterId":"char_c91244","characterName":"グレンテル","sourceIds":{"bangumi":[{"characterId":"77726","match":"exact-normalized-name-in-linked-work","subjectId":"308933"},{"characterId":"77726","match":"exact-normalized-name-in-linked-work","subjectId":"330502"},{"characterId":"77726","match":"exact-normalized-name-in-linked-work","subjectId":"392140"}],"egsCharacterIds":["22797"],"vndbCharacterId":"c91244"},"originalCharacterName":"グレンテル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A dragon VIP who has a lot of respect for Haru and her powers."}],"source":"vndb","sourceCharacterId":"c91244"},{"segments":[{"spoiler":false,"text":"主人公達が暮らす町を根城に、『竜珠教(自ら創始)』の指導者として信徒をまとめあげている厄介で残念なドラゴン。"},{"spoiler":false,"text":"カルト宗教とも言う。"},{"spoiler":false,"text":"主人公にはドラ美と名付けられたが、少し目を離した隙に『轟竜グレンテル』と名乗っていた。"},{"spoiler":false,"text":"見栄っ張りで傲慢で意地汚い、およそテンプレ通りの中ボス級ドラゴン。"},{"spoiler":false,"text":"案の定というか、信徒達もいまいち慕ってる素振りがない。"},{"spoiler":false,"text":"ただ、容姿は超がつく美貌で、かつて(何千年か前？)神として崇められていたのもどうやら本当。"},{"spoiler":false,"text":"主人公というよりはハルにご執心で、何かと仲良くしたがったり(意図せず？)トラブルを持ち込んだりする。"}],"source":"egs","sourceCharacterId":"22797","sourceWorkId":"29727","spoiler":false},{"segments":[{"spoiler":false,"text":"飛ぶ鳥を落とす勢い（自称）で成長を続ける『竜珠教』の指導者であり、象徴でもあるドラゴン。"},{"spoiler":false,"text":"自分では轟竜グレンテルと名乗っている。"},{"spoiler":false,"text":"「小狡くしぶとく欲深く」をスローガンに、今回も独特のムーブを繰り広げる。"},{"spoiler":false,"text":"これまで「中ボスポジション」と言われていたが、今回「もっと雑魚なのでは」という疑惑が新たに浮上した。"},{"spoiler":false,"text":"自派閥のトップ、『水』の王とか出てきちゃったので仕方ない部分も。"},{"spoiler":false,"text":"いっそう磨きがかかった卑屈な姿と相変わらずなドラ美っぷりをお楽しみください。"}],"source":"egs","sourceCharacterId":"22797","sourceWorkId":"30778","spoiler":false},{"segments":[{"spoiler":false,"text":"今やすっかり全国区になった『竜珠教』の指導者であり、象徴でもあるドラゴン。"},{"spoiler":false,"text":"轟竜グレンテルと名乗っている。"},{"spoiler":false,"text":"自らが属する『水』派閥の王・さんごやイリスとも接点を得て、いよいよ風が吹き始めた。"},{"spoiler":false,"text":"……はずなのだが、最後のひと押しのところで停滞気味。"},{"spoiler":false,"text":"二人を懐柔するために借りたマンションも、ほぼ放置されている。"},{"spoiler":false,"text":"贅沢接待の予定も空回り。"},{"spoiler":false,"text":"ぐだぐだ続きで信徒の信心離れの兆しも見え始めている…等々。"},{"spoiler":false,"text":"『竜珠教』としては正念場を迎えつつあると言えるが本編にはなんの関係もない(ネタバレ)。"}],"source":"egs","sourceCharacterId":"22797","sourceWorkId":"32977","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公達が暮らす町を根城に、『竜珠教(自ら創始)』の指導者として"},{"spoiler":false,"text":"信徒をまとめあげている厄介で残念なドラゴン。"},{"spoiler":false,"text":"カルト宗教とも言う。"},{"spoiler":false,"text":"主人公にはドラ美と名付けられたが、"},{"spoiler":false,"text":"少し目を離した隙に『轟竜グレンテル』と名乗っていた。"},{"spoiler":false,"text":"見栄っ張りで傲慢で意地汚い、およそテンプレ通りの中ボス級ドラゴン。"},{"spoiler":false,"text":"案の定というか、信徒達もいまいち慕ってる素振りがない。"},{"spoiler":false,"text":"ただ、容姿は超がつく美貌で、"},{"spoiler":false,"text":"かつて(何千年か前？)神として崇められていたのもどうやら本当。"},{"spoiler":false,"text":"主人公というよりはハルにご執心で、"},{"spoiler":false,"text":"何かと仲良くしたがったり(意図せず？)トラブルを持ち込んだりする。"}],"source":"bangumi","sourceCharacterId":"77726"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/882e6062ab7259b92aef367f1d1bec46d5b0f3cba64c5fb596e8550b56a25a82.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea2dc0a70386f31c5f8592b995c6f227f190b0a76fd38afdc622221b54720599.webp","width":188,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤沢れい香","creatorId":"vndb:s14338","sourcePersonId":"vndb:s14338","canonicalEntityId":"vndb:s14338","name":"藤沢 れい香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:392140:77726:32998:1","source":"bangumi"}]},{"characterId":"char_c93685","characterName":"宮本 武","sourceIds":{"bangumi":[{"characterId":"77728","match":"exact-normalized-name-in-linked-work","subjectId":"392140"}],"egsCharacterIds":["12183"],"vndbCharacterId":"c93685"},"originalCharacterName":"宮本 武","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the story. An airheaded martial artist who has lived most of his life in poverty and has no hesitation about sponging off his neighbors and childhood friend Suzuka. He is a skilled fighter but about as lazy as can be. He is technology-incompetent due to having little to do with modern tech throughout his childhood, and he has almost no sense of self-control."},{"spoiler":false,"text":"He will do anything to get out of working a normal job, up to and including sponging off anyone who will let him, hunting crawfish in the river, and selling live insects to children."}],"source":"vndb","sourceCharacterId":"c93685"},{"segments":[{"spoiler":false,"text":"なぜかドラゴンに好かれることでおなじみの、パワー系ニート。"},{"spoiler":false,"text":"前回の海旅行でもドラゴンを二匹ほど連れて戻ってきた。"},{"spoiler":false,"text":"四人家族になったことで食い扶持が増えたし、色々ややこしいことになっているが、あまり気にしてない。"},{"spoiler":false,"text":"というより、何かに動じてたことがあまりない（過去を振り返りながら）。"},{"spoiler":false,"text":"実は大物なのかもしれない。ニートなのに。"},{"spoiler":false,"text":"町を占めるお祭りの気配にドラゴンたちがわくわくしているのをよそに、「金と気力・体力を消費する催しには興味がない」と頑な。"},{"spoiler":false,"text":"もちろん、どうせ巻き込まれる。"}],"source":"egs","sourceCharacterId":"12183","sourceWorkId":"32977","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公。アクティブ系ニート。"},{"spoiler":false,"text":"放浪癖があって浪費家で人類最強(推定)な父親と二人暮らし。"},{"spoiler":false,"text":"実家の道場の師範代だが、残念ながら門下生がいたことは一度もない。"},{"spoiler":false,"text":"竜姫の身元引受人として、なんだか世界の命運を背負い込むことになったが"},{"spoiler":false,"text":"本人は気にしてないどころか自覚すらない。"},{"spoiler":false,"text":"カロリーが高くて味が濃ければなんでも大好物。"},{"spoiler":false,"text":"得意料理は宮本風ボイルドザリガニ(川で捕まえてきたザリガニを煮るだけ)。"}],"source":"bangumi","sourceCharacterId":"77728"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b40e4456cf9c13d7fe8d2215721b7b293b750bcc5c3969e2a30db1d8c3a84f06.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/00/00b78a81528cf23944c8948bb8f8d5b344afee92d55784bad79eac6261a085e4.webp","width":162,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c96331","characterName":"イリス","sourceIds":{"bangumi":[{"characterId":"92730","match":"exact-normalized-name-in-linked-work","subjectId":"330502"},{"characterId":"92730","match":"exact-normalized-name-in-linked-work","subjectId":"392140"}],"egsCharacterIds":["23335"],"vndbCharacterId":"c96331"},"originalCharacterName":"イリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"海竜族最強の虹竜。"},{"spoiler":false,"text":"先代の海竜王から存在の多くを引き継いで生まれたばかりの若いドラゴンで、『海』派閥を束ねる王。"},{"spoiler":false,"text":"見た目からしてゴージャス。"},{"spoiler":false,"text":"ドラゴンにしては珍しく、自ら海に架かる虹の王・イリスと名乗っている。"},{"spoiler":false,"text":"根っから明るくて勢い重視。細かいことは気にならない。"},{"spoiler":false,"text":"星界生まれで地球の海を知らなかったイリスは、母なる海の美しさにぞっこん。"},{"spoiler":false,"text":"海を汚す者（＝人間）は許さないという思想に染まりきっている。"},{"spoiler":false,"text":"これでもドラゴン派閥の最深層の一角、『海』の王でありスーパー強い。"},{"spoiler":false,"text":"頭は悪い。"}],"source":"egs","sourceCharacterId":"23335","sourceWorkId":"30778","spoiler":false},{"segments":[{"spoiler":false,"text":"全ての海竜族を束ねる『海』の王。偉大なる虹竜。"},{"spoiler":false,"text":"海でのあれこれを通じて主人公のことを気に入り、押しかけてきた。"},{"spoiler":false,"text":"現在は宮本家の道場部分を占拠して、一緒に生活している。"},{"spoiler":false,"text":"イリスの私物も順調に増えているが、門下生はいないのでこれといって問題はない。"},{"spoiler":false,"text":"同居生活を通じて、持ち前の江戸っ子気質もだいぶ丸くなってきた模様。"},{"spoiler":false,"text":"具体的にはハルと喧嘩しても物を壊さなくなってきた。"},{"spoiler":false,"text":"子犬は子犬同士でケンカをすることで力の加減を覚えるというが。"},{"spoiler":false,"text":"見るもの全てが珍しくて楽しいモードに入っていて、基本は遊び歩いている。"},{"spoiler":false,"text":"一方で主人公が付き合ってくれないことが不満。"},{"spoiler":false,"text":"その分、今度のお祭りには(主人公を巻き込む意味でも)意気込んでいる。"}],"source":"egs","sourceCharacterId":"23335","sourceWorkId":"32977","spoiler":false},{"segments":[{"spoiler":false,"text":"海竜族最強の虹竜。"},{"spoiler":false,"text":"先代の海竜王から存在の多くを引き継いで生まれたばかりの"},{"spoiler":false,"text":"若いドラゴンで、『海』派閥を束ねる王。"},{"spoiler":false,"text":"見た目からしてゴージャス。"},{"spoiler":false,"text":"ドラゴンにしては珍しく、自ら海に架かる虹の王・イリスと名乗っている。"},{"spoiler":false,"text":"根っから明るくて勢い重視。細かいことは気にならない。"},{"spoiler":false,"text":"星界生まれで地球の海を知らなかったイリスは、母なる海の美しさにぞっこん。"},{"spoiler":false,"text":"海を汚す者（＝人間）は許さないという思想に染まりきっている。"},{"spoiler":false,"text":"これでもドラゴン派閥の最深層の一角、『海』の王でありスーパー強い。"},{"spoiler":false,"text":"頭は悪い。"}],"source":"bangumi","sourceCharacterId":"92730"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6f7d3355f801d1a8933a1938c595e95b9099cec2754394cd9aab1ccc66c6b658.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a5c189ad78ffcf42aa493dbe821c18edca6bc4f3a3f4bcd54a19060d0ccf35e.webp","width":212,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さいとうよしえ","creatorId":"vndb:s1545","sourcePersonId":"vndb:s1545","canonicalEntityId":"vndb:s1545","name":"さいとう よしえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:392140:92730:20696:1","source":"bangumi"}]},{"characterId":"char_c96332","characterName":"さんご","sourceIds":{"bangumi":[{"characterId":"92731","match":"exact-normalized-name-in-linked-work","subjectId":"330502"},{"characterId":"92731","match":"exact-normalized-name-in-linked-work","subjectId":"392140"}],"egsCharacterIds":["23336"],"vndbCharacterId":"c96332"},"originalCharacterName":"さんご","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"無敵にして最硬の鎧竜。"},{"spoiler":false,"text":"『海』派閥とは永遠の盟友関係にある『水』の姫で、イリスとタイミングをあわせて先代の王から地位を譲り受けた。"},{"spoiler":false,"text":"イリスを自らの王と認める一方、妹としてはダメな姉への思いやりにあふれている。"},{"spoiler":false,"text":"ドラゴンにしては珍しくちゃんとしていてお行儀もいいが、ダウナー気質でとにかく面倒くさがり。"},{"spoiler":false,"text":"いわば引きこもり系ニート。"},{"spoiler":false,"text":"たまたま手に入れたタブレットがきっかけでアニメが大好き。"},{"spoiler":false,"text":"アニメが見れない(wifiが使えなくなる)」ということで"},{"spoiler":false,"text":"日本近海にとどまってる模様。"}],"source":"egs","sourceCharacterId":"23336","sourceWorkId":"30778","spoiler":false},{"segments":[{"spoiler":false,"text":"イリスの相棒で、全ての海竜族を共に束ねる『水』の王。最強・最硬の鎧竜。"},{"spoiler":false,"text":"現在はイリスと一緒に宮本家の道場部分に居候している。"},{"spoiler":false,"text":"よく言えば温厚、アレな言い方をすればものぐさな性格にはいっそう磨きがかかった。"},{"spoiler":false,"text":"ほぼ、テレビの前から動かない。"},{"spoiler":false,"text":"なんなら冷蔵庫とかに行くのすら面倒くさい。コーラを持ってきて欲しい。"},{"spoiler":false,"text":"ドラゴンは食事も排泄も、眠ることすら基本は不要なので、徹夜アニメも徹夜ゲームも余裕。"},{"spoiler":false,"text":"誰もが(？)憧れるニート像を体現している。"},{"spoiler":false,"text":"最近はちょっと昔のロボットアニメがお気に入りで、全48話とかのやつをよく見ている。"},{"spoiler":false,"text":"夏祭りはアニメやゲームで知ってるので、まあまあ興味がある。"}],"source":"egs","sourceCharacterId":"23336","sourceWorkId":"32977","spoiler":false},{"segments":[{"spoiler":false,"text":"無敵にして最硬の鎧竜。"},{"spoiler":false,"text":"『海』派閥とは永遠の盟友関係にある『水』の姫で、"},{"spoiler":false,"text":"イリスとタイミングをあわせて先代の王から地位を譲り受けた。"},{"spoiler":false,"text":"イリスを自らの王と認める一方、妹としてはダメな姉への思いやりにあふれている。"},{"spoiler":false,"text":"ドラゴンにしては珍しくちゃんとしていてお行儀もいいが、"},{"spoiler":false,"text":"ダウナー気質でとにかく面倒くさがり。"},{"spoiler":false,"text":"いわば引きこもり系ニート。"},{"spoiler":false,"text":"たまたま手に入れたタブレットがきっかけでアニメが大好き。"},{"spoiler":false,"text":"アニメが見れない(wifiが使えなくなる)」ということで"},{"spoiler":false,"text":"日本近海にとどまってる模様。"}],"source":"bangumi","sourceCharacterId":"92731"}],"profileFacts":[],"met