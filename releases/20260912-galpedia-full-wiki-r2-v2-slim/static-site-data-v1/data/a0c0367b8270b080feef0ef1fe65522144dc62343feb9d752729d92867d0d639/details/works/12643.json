5","source":"vndb"},{"creditedName":"パリオ","creatorId":"vndb:s2790","sourcePersonId":"vndb:s2790","canonicalEntityId":"vndb:s2790","name":"パリオ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:19046","source":"vndb"}]},"cast":[{"characterId":"char_c2961","characterName":"みくみく","sourceIds":{"bangumi":[{"characterId":"12289","match":"exact-normalized-name-in-linked-work","subjectId":"3904"},{"characterId":"12289","match":"exact-normalized-name-in-linked-work","subjectId":"464004"}],"egsCharacterIds":["15763"],"vndbCharacterId":"c2961"},"originalCharacterName":"みくみく","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"212"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"南とお揃いな晃範の携帯電話だが、買ってからしばらく放置されていたために、擬人化して役に立とうと奮闘する。"},{"spoiler":false,"text":"口調や仕草はクールなので、肝心の晃範には伝わりづらいのが玉に瑕。"},{"spoiler":false,"text":"晃範に頼られると一瞬フリーズするのがラブリーな所。"},{"spoiler":false,"text":"厄介ごとを背負う晃範の良きパートナー。"},{"spoiler":false,"text":"「……可能性は否定できない」"}],"source":"egs","sourceCharacterId":"15763","sourceWorkId":"10853","spoiler":false},{"segments":[{"spoiler":false,"text":"南とお揃いな晃範の携帯電話だが、買ってからしばらく放置されていたために、擬人化して役に立とうと奮闘する。"},{"spoiler":false,"text":"口調や仕草はクールなので、肝心の晃範には伝わりづらいのが玉に瑕。"},{"spoiler":false,"text":"晃範に頼られると一瞬フリーズするのがラブリーな所。"},{"spoiler":false,"text":"厄介ごとを背負う晃範の良きパートナー。"}],"source":"egs","sourceCharacterId":"15763","sourceWorkId":"12017","spoiler":false},{"segments":[{"spoiler":false,"text":"和南的配成一对的晃範的手机、买来不久就被闲置了、拟人化后努力奋斗想要起作用。"},{"spoiler":false,"text":"口调以及行为很酷、但是却不能顺利传达给关键的晃範。"},{"spoiler":false,"text":"还拥有被フリーズ拜托事情的话就会死机的可爱的一面。"},{"spoiler":false,"text":"要成为晃範的能够背负麻烦的事情的优秀的伙伴。"},{"spoiler":false,"text":"「……不能否定这个可能性」"}],"source":"bangumi","sourceCharacterId":"12289"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9d2866d4f291eefb2a95a7b40c909f5e6cb76f25c802416cafc1ae70a934c326.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6c6ba97eac041e1e1604a72fafa958f70548e1bd7616241889e991bcc38b84e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北野 妙","creatorId":"vndb:s2701","sourcePersonId":"vndb:s2701","canonicalEntityId":"vndb:s2701","name":"北野 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9419","source":"vndb"}]},{"characterId":"char_c2962","characterName":"高岡 あさがお","sourceIds":{"bangumi":[{"characterId":"12288","match":"exact-normalized-name-in-linked-work","subjectId":"3904"}],"egsCharacterIds":["18181"],"vndbCharacterId":"c2962"},"originalCharacterName":"高岡 あさがお","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"714"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"74"},"height":{"reviewState":"no-conflict","source":"vndb","value":"140"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ある日突然擬人化し、晃範の元へ落ちてくる。"},{"spoiler":false,"text":"明るく正義に燃える心を持ち、授業中だろうが何だろうが、センサーにSOS信号をキャッチした瞬間に、飛び出していく熱血漢。"},{"spoiler":false,"text":"その割には世間知らずで、良く騙されたりもする無垢な人工衛星。"},{"spoiler":false,"text":"平和のために今日も飛んでいく。"},{"spoiler":false,"text":"「誰かが学園内でピンチです！　あさがお、助けに行ってきます」"}],"source":"egs","sourceCharacterId":"18181","sourceWorkId":"10853","spoiler":false},{"segments":[{"spoiler":false,"text":"某天突然拟人化坠落到晃範身边的人工卫星。"},{"spoiler":false,"text":"拥有开朗并且燃烧着正义的心、不管是不是上课中、只要探测器一捕捉到SOS信号就飞奔出去的热血汉。"},{"spoiler":false,"text":"但是相对的却不懂世间常识、是个经常被欺骗的纯洁的女孩子。"},{"spoiler":false,"text":"为了和平今天也要飞翔。"},{"spoiler":false,"text":"「学园内谁有危机了！あさがお、救援开始」"}],"source":"bangumi","sourceCharacterId":"12288"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5d8f7aa2acec8761b0f0043d5fd9c1f0707ba53f0216f213bb90d823b3f4c966.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6ec675b553ac03b570eb4a6c9e94f28f19c7c249bb5307d6aa15d0a1383f4832.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜木アミサ","creatorId":"vndb:s2281","sourcePersonId":"vndb:s2281","canonicalEntityId":"vndb:s2281","name":"桜木 アミサ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3904:12288:15996:1","source":"bangumi"}]},{"characterId":"char_c2964","characterName":"みなみん","sourceIds":{"bangumi":[{"characterId":"12287","match":"exact-normalized-name-in-linked-work","subjectId":"3904"}],"egsCharacterIds":["18180"],"vndbCharacterId":"c2964"},"originalCharacterName":"みなみん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1003"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"恐ろしい程のポジティブシンキングの持ち主。"},{"spoiler":false,"text":"持ち前の行動力で、晃範を度々困らせ、胃薬づけにしている張本人。"},{"spoiler":false,"text":"楽しければすべて良しという考えの元、生徒会長にまで上り詰めたのは、褒めてもいいことかもしれない。"},{"spoiler":false,"text":"楽しいこと面白いことを企て、学園を巻き込んでいく。"},{"spoiler":false,"text":"「生徒会長推参！　君達の悪事もここまでだ!!」"}],"source":"egs","sourceCharacterId":"18180","sourceWorkId":"10853","spoiler":false},{"segments":[{"spoiler":false,"text":"拥有令人恐怖的积极思维。"},{"spoiler":false,"text":"不假思索的行动力常常让晃範困惑、是让晃範灌胃药的本人。"},{"spoiler":false,"text":"以只要快乐什么事情都OK的想法、成为了学生会会长、这是不是应该表扬她呢。"},{"spoiler":false,"text":"平常就一直企图着快乐的事情、把全校学生都卷入里面。"},{"spoiler":false,"text":"「学生会会长登场！你们的恶性到此为止了!!」"}],"source":"bangumi","sourceCharacterId":"12287"}],"profileFacts":[],"metadataCandidateConflicts":{"birthday":[{"comparisonValue":"1003","source":"vndb","sourceCharacterId":"c2964","value":"1003"},{"comparisonValue":"1003","source":"egs","sourceCharacterId":"18180","value":"10/3"},{"comparisonValue":"0103","source":"bangumi","sourceCharacterId":"12287","value":"10月3日(天秤座)"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/443963eaa60b7028935f924eeb8b1f12bd3cddf0686302e644e28d6c6b9c077d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7b/7bc59dd8520c64bb1698b05bb032c127c6053a2c2d8866374586a0aa7ca8568b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"儀武ゆう子","creatorId":"vndb:s263","sourcePersonId":"vndb:s263","canonicalEntityId":"vndb:s263","name":"儀武 ゆう子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3904:12287:4744:1","source":"bangumi"}]},{"characterId":"char_c2967","characterName":"ゴミ","sourceIds":{"bangumi":[{"characterId":"12291","match":"exact-normalized-name-in-linked-work","subjectId":"3904"}],"egsCharacterIds":["18183"],"vndbCharacterId":"c2967"},"originalCharacterName":"ゴミ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"223"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"142"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"謎の転校生。"},{"spoiler":false,"text":"転校初日、いきなり生徒会と敵対宣言をするも、なんだかんだとお節介を焼いたり巻き込まれたり。"},{"spoiler":false,"text":"意外と性格は良いらしい？"},{"spoiler":false,"text":"いつもグスタフという犬を連れて縦横無尽に歩き回る。"},{"spoiler":false,"text":"おさがおと未来を見ても、あんまり驚かないようだが、何か理由があるんだろうか？"},{"spoiler":false,"text":"「うっさい、ゴミ言うな！　アタシは五味だ！」"}],"source":"egs","sourceCharacterId":"18183","sourceWorkId":"10853","spoiler":false},{"segments":[{"spoiler":false,"text":"转学过来第一天就突然发出对学生会的敌对宣言的问题学生。"},{"spoiler":false,"text":"但是性格却是意外的好？"},{"spoiler":false,"text":"看到あさがお和未来也不怎么惊讶、好像知道些什么事情？"},{"spoiler":false,"text":"经常带着叫做Gustav的狗无止尽的来回走。"},{"spoiler":false,"text":"「罗索、不要叫我垃圾！我名字叫五味！」"}],"source":"bangumi","sourceCharacterId":"12291"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7cdb10bb518818e2a229a93d6d7dfc6297ff3684fc971182f14a59c1f8f867c6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0cc91a4f669cf8ba8fb377c5e1234f13293c1433641d96f4f0fd18275d6e2d17.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"咲乃藍里","creatorId":"vndb:s436","sourcePersonId":"vndb:s436","canonicalEntityId":"vndb:s436","name":"咲乃 藍里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:3904:12291:5692:1","source":"bangumi"}]},{"characterId":"char_c2968","characterName":"ゆずきち","sourceIds":{"bangumi":[{"characterId":"12290","match":"exact-normalized-name-in-linked-work","subjectId":"3904"}],"egsCharacterIds":["18182"],"vndbCharacterId":"c2968"},"originalCharacterName":"ゆずきち","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1227"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"転校してきた国民的アイドル。"},{"spoiler":false,"text":"当然学園は大騒ぎ。生徒会が身辺警護を担当することに。"},{"spoiler":false,"text":"本人はわらわらとやってくるファンにも明るく振舞う気立ての良い子。"},{"spoiler":false,"text":"週刊誌や噂を覆すほどに、学園内外に愛されてる。"},{"spoiler":false,"text":"だが、そんな姿勢のために、度々トラブルが起こったりもする。"},{"spoiler":false,"text":"「皆さん、賭け事はダメです。しっかり反省してくださいね」"}],"source":"egs","sourceCharacterId":"18182","sourceWorkId":"10853","spoiler":false},{"segments":[{"spoiler":false,"text":"转学过来的国民偶像。"},{"spoiler":false,"text":"当然学园里引发的大骚动、学生会开始担当她的贴身护卫。"},{"spoiler":false,"text":"本人还是和连续不断过来的FAN开朗的打招呼的好孩子。"},{"spoiler":false,"text":"「大家、赌博是不行的哦。要好好反省一下」"}],"source":"bangumi","sourceCharacterId":"12290"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/8883fb792894a9e6004d02193ab2e974f6530e625b5e107b8a64e3c321b8471f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/