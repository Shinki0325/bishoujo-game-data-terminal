tus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1215"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"97"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"大学卒業後に、数年越しの交際を続けていた夫と結婚した、幸せいっぱいの新結婚3年目。"},{"spoiler":false,"text":"おっとりしていて面倒見がよく、包容力のある性格。子供好き。"},{"spoiler":false,"text":"芯が強く真面目な性格をしており、とくに「約束」は絶対に守ることにしている。"},{"spoiler":false,"text":"男性関係は夫のみで早く子供は欲しいと考えているが、夫が子供嫌いのため、ゴムなしでのセックス経験はなく、特殊なプレイもほぼ未経験。"},{"spoiler":false,"text":"友人の保証人になったことから、多額の借金を負ってしまう。"}],"source":"egs","sourceCharacterId":"2665","sourceWorkId":"19837","spoiler":false},{"segments":[{"spoiler":false,"text":"「膣内射精AV撮影～借金妻～」のメインヒロイン。"},{"spoiler":false,"text":"同じマンションに住む彩の友人で彩とは学生時代からの仲良しで付き合いは長い。"},{"spoiler":false,"text":"彩から見ると理想の夫婦像で、夫婦仲はとても良く見える。"},{"spoiler":false,"text":"彼女が彩の懐妊記念パーティーを開いてくれたところから始まる。"}],"source":"egs","sourceCharacterId":"2665","sourceWorkId":"27409","spoiler":false},{"segments":[{"spoiler":false,"text":"本作品のメインヒロイン。"},{"spoiler":false,"text":"おっとりしていて面倒見がよく、包容力のある性格。"},{"spoiler":false,"text":"大学卒業後に、数年越しの交際を続けていた夫（主人公）と結婚した。 結婚3年目。"},{"spoiler":false,"text":"男性関係は夫のみで、避妊しているが早く子供は欲しいと考えている。"},{"spoiler":false,"text":"ゴムなしでのセックス経験はなく、フェラチオ等のプレイもほぼ未経験。"},{"spoiler":false,"text":"夫のことは心から愛しているものの、セックスで快楽を得た経験はほとんどない。"},{"spoiler":false,"text":"旧家の出身でお嬢様育ち、家事は得意だが世間知らずな面がある。"},{"spoiler":false,"text":"大学時代の友人の保証人になったことから、1千万円の借金を負ってしまう。"}],"source":"bangumi","sourceCharacterId":"25642"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63b86da514c90f5bec108ab025d25c28e2e74b12f93b5319135edfa5d63885c9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/df/df07fa5d3548056c1db9fac051ffd7c371d30c204a25f3983e7910bbd3a0d1c5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"渡邊優佳","creatorId":"vndb:s1040","sourcePersonId":"vndb:s1040","canonicalEntityId":"vndb:s1040","name":"渡邊 優佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268571:25642:24788:1","source":"bangumi"}]},{"characterId":"char_c68437","characterName":"沼田 甚六","sourceIds":{"bangumi":[{"characterId":"25643","match":"exact-normalized-name-in-linked-work","subjectId":"268571"}],"egsCharacterIds":["21043"],"vndbCharacterId":"c68437"},"originalCharacterName":"沼田 甚六","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"三度登場、借金妻、ＪＫ女将に出てきたヤクザにして、やり手ＡＶ男優。"},{"spoiler":false,"text":"今回は、悪徳弁護士と言う、知的な面も見せる。"},{"spoiler":false,"text":"外見はデブで汚いおっさんだが、ネチネチと心を汚す手腕は寝取り親父として優秀。"},{"spoiler":false,"text":"彩の弁護士事務所が邪魔なので、彩を切っ掛けに潰しにかかろうとしている。"}],"source":"egs","sourceCharacterId":"21043","sourceWorkId":"27409","spoiler":false},{"segments":[{"spoiler":false,"text":"友理奈を追い込む中堅ヤクザ。"},{"spoiler":false,"text":"見た目は小太りの中年オヤジで冴えない感じだが、頭の回転は速い。"},{"spoiler":false,"text":"組の中ではAV製作業務の責任者という立場にあり、数名の若い手下がいる。"},{"spoiler":false,"text":"セックス中毒で男優を兼務、AVに出演させた女性を自分の愛人にしている。"},{"spoiler":false,"text":"性経験が豊富で非常にねちっこく、そのテクニックはかなりのもの。"}],"source":"bangumi","sourceCharacterId":"25643"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"m","source":"vndb","sourceCharacterId":"c68437","value":"m"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"21043","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"21043","value":"女性"},{"comparisonValue":"m","source":"bangumi","sourceCharacterId":"25643","value":"男"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3b47dfff2cd9241d65899e3876b40db6e0b693ccf02e75fb4215434e5cd35f82.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/377c3f5e336598d000bfc5738ec38f23613443005508a951b6de6a3d16477c4c.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c80837","characterName":"遠山 彩","sourceIds":{"bangumi":[{"characterId":"173156","match":"exact-normalized-name-in-linked-work","subjectId":"268571"}],"egsCharacterIds":["21042"],"vndbCharacterId":"c80837"},"originalCharacterName":"遠山 彩","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1125"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"98"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"I"},"height":{"reviewState":"no-conflict","source":"vndb","value":"170"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"正義感に溢れる真面目な性格。"},{"spoiler":false,"text":"几帳面で、分析が好きと、一見しっかりとした大人の女性にみえるがその実は熱くなりやすく、隙が多い。"},{"spoiler":false,"text":"イレギュラーな質問に弱い。"},{"spoiler":false,"text":"子供が大好きで、早く子供を授かりたいと思っていた。"},{"spoiler":false,"text":"自分を引っ張ってくれる、夫を頼もしくて大好き。"},{"spoiler":false,"text":"夫との関係は週に2-3回程度、お互い愛情のある夫婦関係。"}],"source":"egs","sourceCharacterId":"21042","sourceWorkId":"27409","spoiler":false},{"segments":[{"spoiler":false,"text":"職業は弁護士。"},{"spoiler":false,"text":"正義感に溢れる真面目な性格で、女性に対する犯罪を専門に日々頑張っている。"},{"spoiler":false,"text":"その外見と丁寧な仕事に、メディアでも取り上げられる人気弁護士である。"},{"spoiler":false,"text":"5年がかりで、待望の子供を授かり、幸せの絶頂である。"},{"spoiler":false,"text":"自分を引っ張ってくれる、夫を頼もしく思っている。"},{"spoiler":false,"text":"沼田は法曹界を巣くうあってはならない人物と忌避している。"},{"spoiler":false,"text":"「龍平さんとの待望の第一子を授かって、今とても幸せです。」"},{"spoiler":false,"text":"「信じてください、お腹の子供はあなたの子供です‼」"}],"source":"bangumi","sourceCharacterId":"173156"}],"profileFacts":[{"label":"胸围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"21042","sourceWorkId":"27409","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"i","valueContext":null,"source":"egs","sourceCharacterId":"21042","sourceWorkId":"27409","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"21042","sourceWorkId":"27409","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"21042","sourceWorkId":"27409","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"bloodType":[{"comparisonValue":"a","source":"vndb","sourceCharacterId":"c80837","value":"a"},{"comparisonValue":"a","source":"egs","sourceCharacterId":"21042","value":"A"},{"comparisonValue":"o","source":"bangumi","sourceCharacterId":"173156","value":"O型"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6d/6d780d6c539a97ce6caee017e6885e4442c8ab338a04a63ba09b5465b2dc9a22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10c69fd52fcd75ff09e5b87dc5b33f5a9a0d9f319920ad20c6261216167a7d58.webp","width":148,"height":256,"source":"static-detail"},"actors":[{"creditedName":"長谷川知子","creatorId":"vndb:s694","sourcePersonId":"vndb:s694","canonicalEntityId":"vndb:s694","name":"ひむろゆり(氷室百合)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268571:173156:5924:1","source":"bangumi"}]},{"characterId":"char_vndb_c80838","characterName":"レイ","sourceIds":{"vndbCharacterId"