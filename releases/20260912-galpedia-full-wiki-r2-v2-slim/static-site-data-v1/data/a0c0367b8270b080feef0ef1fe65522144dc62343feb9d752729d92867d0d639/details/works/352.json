{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"352","model":{"presentationWorkId":"vndb:v4884","staff":{"artwork":[{"creditedName":"佐野俊英(さのとしひで、さぬ)","creatorId":"vndb:s1121","sourcePersonId":"egs:creator:10","canonicalEntityId":"vndb:s1121","name":"佐野俊英(さのとしひで、さぬ)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:1860","source":"egs"}],"scenario":[{"creditedName":"猫柳まんぼ(山田びんご)","creatorId":"vndb:s1122","sourcePersonId":"egs:creator:435","canonicalEntityId":"vndb:s1122","name":"猫柳まんぼ(山田びんご","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:1861","source":"egs"}],"music":[{"creditedName":"荒川 憲一","creatorId":"vndb:s1265","sourcePersonId":"vndb:s1265","canonicalEntityId":"vndb:s1265","name":"荒川 憲一","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:53817","source":"vndb"}],"other":[{"creditedName":"海原 エレナ","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:53812","source":"vndb"},{"creditedName":"木村 あやか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:53813","source":"vndb"},{"creditedName":"佐野 俊英","creatorId":"vndb:s1121","sourcePersonId":"vndb:s1121","canonicalEntityId":"vndb:s1121","name":"佐野 俊英","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:53814","source":"vndb"}]},"cast":[{"characterId":"char_c19155","characterName":"藍澤 眞穂","sourceIds":{"bangumi":[{"characterId":"141351","match":"exact-normalized-name-in-linked-work","subjectId":"129590"},{"characterId":"141351","match":"exact-normalized-name-in-linked-work","subjectId":"217003"}],"egsCharacterIds":["27451"],"vndbCharacterId":"c19155"},"originalCharacterName":"藍澤 眞穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の義理の妹（姉妹の姉）。華穂とは一卵性双生児。"},{"spoiler":false,"text":"性格は物静かで礼儀正しく、なかなかクール。"},{"spoiler":false,"text":"また運動は苦手で、身体が弱く、体調を崩すこともしばしば。"},{"spoiler":false,"text":"創作世界に興味がある文学少女で、文章作家である主人公を純粋に尊敬している。"},{"spoiler":false,"text":"ボケ役の妹に対し、彼女はツッコミ役。"},{"spoiler":false,"text":"激しいツッコミではなく、軽くたしなめる感じのツッコミで、歯止めが利かなくなると平気で放置しておくことも……。"}],"source":"egs","sourceCharacterId":"27451","sourceWorkId":"2685","spoiler":false},{"segments":[{"spoiler":false,"text":"恭輔の義理の妹（姉妹の姉）。華穂とは一卵性双生児。"},{"spoiler":false,"text":"姉妹においてはツッコミ役。とはいえ激しく突っ込むのではなく、華穂の扱いに慣れているのか、軽くたしなめ、最終的には華穂を放置して先に進むこともある。礼儀正しく大人しい性格。茶目っ気はほぼ皆無と言っても良い。運動が苦手、あまり体が強くない。文系で創作の世界に興味があり、純粋に文章作家としての義兄を尊敬している。"},{"spoiler":false,"text":"高所恐怖症。驚いたときは体をこわばらせる。"}],"source":"bangumi","sourceCharacterId":"141351"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/107a9169fe9c99a1772b2c897894ab91ebcdec9e2987ba6159eba8b5f435906f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/837efe3317c18d6880d9a54e6e3bf92ffaf6abbd31b5115f1f0e239e3d8d23db.webp","width":190,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷青","creatorId":"vndb:s125","sourcePersonId":"vndb:s125","canonicalEntityId":"vndb:s125","name":"海原エレナ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217003:141351:4937:1","source":"bangumi"},{"creditedName":"紗綾","creatorId":"vndb:s15115","sourcePersonId":"vndb:s15115","canonicalEntityId":"vndb:s15115","name":"紗綾","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29858","source":"vndb"}]},{"characterId":"char_c19156","characterName":"美也","sourceIds":{"bangumi":[],"egsCharacterIds":["27454"],"vndbCharacterId":"c19156"},"originalCharacterName":"美也","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"眞穂達の従妹。"},{"spoiler":false,"text":"人見知りするタイプだが、一度、心を許してしまえば友達のように無邪気に接してくる。"},{"spoiler":false,"text":"好奇心も旺盛で、何かと興味を示す。"},{"spoiler":false,"text":"お気に入りのサルのぬいぐるみは「にゃー」と鳴くらしい。"}],"source":"egs","sourceCharacterId":"27454","sourceWorkId":"2685","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73506fec9730acd83855bbded4e9c49d06dd43f9537a560009700cb125de234f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d44221a7811ae593ebbe7b30dc0d000ff1ffc3c3af14ace22450a3ff855e610c.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬 未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29855","source":"vndb"},{"creditedName":"稲葉 みこ","creatorId":"vndb:s1897","sourcePersonId":"vndb:s1897","canonicalEntityId":"vndb:s1897","name":"み～こ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29860","source":"vndb"}]},{"characterId":"char_c19157","characterName":"リオ","sourceIds":{"bangumi":[{"characterId":"206796","match":"exact-normalized-name-in-linked-work","subjectId":"129590"},{"characterId":"206796","match":"exact-normalized-name-in-linked-work","subjectId":"217003"}],"egsCharacterIds":["27455"],"vndbCharacterId":"c19157"},"originalCharacterName":"リオ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の官能小説の読者。"},{"spoiler":false,"text":"主人公のナンバーワン読者を自称し、作品の感想を電話でしてくるほどの熱の入れよう。"},{"spoiler":false,"text":"性欲が強く、エッチなこと以外は何を考えているのかわからない。"},{"spoiler":false,"text":"甘ったるい口調が特徴。"}],"source":"egs","sourceCharacterId":"27455","sourceWorkId":"2685","spoiler":false},{"segments":[{"spoiler":false,"text":"恭輔の自称Ｎｏ１読者のプータローで現在は２０歳。"},{"spoiler":false,"text":"恭輔の官能小説の感想のお電話をよく掛けて来る。"},{"spoiler":false,"text":"性欲が服を着て歩いているような女性で、Ｈ以外のことに関しては、何を考えているかわからない。"},{"spoiler":false,"text":"口調が甘ったるい、というよりだるい感じ。"}],"source":"bangumi","sourceCharacterId":"206796"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92c542ae6b76a8e31a45e909836489e1e8268867700f73d0d261a34a0792308a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5e8338c22b80bdd280f45b44227320ca93c84113a108b444213845859ded927.webp","width":190,"height":256,"source":"static-detail"},"actors":[{"creditedName":"星野千寿子","creatorId":"vndb:s128","sourcePersonId":"vndb:s128","canonicalEntityId":"vndb:s128","name":"星野 千寿子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217003:206796:4210:1","source":"bangumi"},{"creditedName":"しなの あずさ","creatorId":"vndb:s3544","sourcePersonId":"vndb:s3544","canonicalEntityId":"vndb:s3544","name":"しなのあずさ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29857","source":"vndb"}]},{"characterId":"char_c19159","characterName":"氷室 さやか","sourceIds":{"bangumi":[{"characterId":"206795","match":"exact-normalized-name-in-linked-work","subjectId":"129590"},{"characterId":"206795","match":"exact-normalized-name-in-linked-work","subjectId":"217003"}],"egsCharacterIds":["27453"],"vndbCharacterId":"c19159"},"originalCharacterName":"氷室 さやか","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の高校時代の恋人で、現在は人妻。"},{"spoiler":false,"text":"雑誌の編集部に所属し、主人公の担当編集者を務める。"},{"spoiler":false,"text":"性格はサバサバした感じで、遠慮がない。"},{"spoiler":false,"text":"主人公がもっとも地が出てしまう相手。"}],"source":"egs","sourceCharacterId":"27453","sourceWorkId":"2685","spoiler":false},{"segments":[{"spoiler":false,"text":"恭輔の高校時代の恋人で、現在は人妻。"},{"spoiler":false,"text":"編集部所属で、現在は恭輔の担当編集者。年齢は恭輔に同じ。首都在住。さばさばした性格。遠慮がなく、会話の中で恭輔の地が一番表れる相手。会話内容はもっぱら仕事と、知人の話。"}],"source":"bangumi","sourceCharacterId":"206795"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/204e0e060e347246c510d2053c217f68b6c18c8b9caaa1428d9ef23c518bb96f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/77/772269e37742a1004afee6b1e78bdb51d99ba47f01e2623f5566f44cabdd9134.webp","width":190,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤原美央子","creatorId":"vndb:s462","sourcePersonId":"vndb:s462","canonicalEntityId":"vndb:s462","name":"藤原 美央子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217003:206795:13824:1","source":"bangumi"},{"creditedName":"葉崎 みなと","creatorId":"vndb:s15140","sourcePersonId":"vndb:s15140","canonicalEntityId":"vndb:s15140","name":"葉崎 みなと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29859","source":"vndb"}]},{"characterId":"char_c19160","characterName":"藍澤 華穂","sourceIds":{"bangumi":[{"characterId":"141352","match":"exact-normalized-name-in-linked-work","subjectId":"129590"},{"characterId":"141352","match":"exact-normalized-name-in-linked-work","subjectId":"217003"}],"egsCharacterIds":["27452"],"vndbCharacterId":"c19160"},"originalCharacterName":"藍澤 華穂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の義理の妹（姉妹の妹）。眞穂とは一卵性双生児。"},{"spoiler":false,"text":"明朗快活で、自分の気持ちや感情に素直な性格。"},{"spoiler":false,"text":"ワガママなところもあり、精神的には眞穂よりも子供。"},{"spoiler":false,"text":"身体の弱い眞穂と違い、身体が丈夫で運動が大好き。"},{"spoiler":false,"text":"また機械（パソコン）弄りが趣味。"},{"spoiler":false,"text":"基本ボケ役で、突っ走るだけ突っ走り、ツッコミ役の眞穂にも相手にされず、誰も乗ってくれないこともしばしば。"}],"source":"egs","sourceCharacterId":"27452","sourceWorkId":"2685","spoiler":false},{"segments":[{"spoiler":false,"text":"恭輔の義理の妹（姉妹の妹）。 姉妹においてはボケ役。ただ、突っ走るも周りが乗ってくれないことから、逆に置いてきぼりを食らうことが多い。元気で明るく、自分の気持ちにストレート。わがままな部分もあり、眞穂よりは精神的に○○。眞穂には頭が上がらない様子。こと遊びとなると眞穂を引っ張り回す。姉と違って運動が得意で、陸上部所属。 お兄さんが出来て純粋に嬉しいとともに、単純に男性に興味がある。"}],"source":"bangumi","sourceCharacterId":"141352"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/9787ce7dd6dc9fbea364bb132e7545c0c65b835b65895cf832608b71660dfbcb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9a4c5bad03b9066a0802497e4a4b445492d1f89ac8e4218181445d17fc4fe644.webp","width":190,"height":256,"source":"static-detail"},"actors":[{"creditedName":"いのくちゆか","creatorId":"vndb:s590","sourcePersonId":"vndb:s590","canonicalEntityId":"vndb:s590","name":"いのくち ゆか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:217003:141352:4490:1","source":"bangumi"},{"creditedName":"仲路 未花","creatorId":"vndb:s34075","sourcePersonId":"vndb:s34075","canonicalEntityId":"vndb:s34075","name