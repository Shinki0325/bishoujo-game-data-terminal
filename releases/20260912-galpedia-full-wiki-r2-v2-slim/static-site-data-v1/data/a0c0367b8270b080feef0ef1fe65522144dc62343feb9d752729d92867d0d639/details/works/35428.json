"},{"creditedName":"亜佐美 晶","creatorId":"vndb:s10983","sourcePersonId":"vndb:s10983","canonicalEntityId":"vndb:s10983","name":"亜佐美 晶","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:201454","source":"vndb"},{"creditedName":"久野 藍","creatorId":"vndb:s35186","sourcePersonId":"vndb:s35186","canonicalEntityId":"vndb:s35186","name":"久野 藍","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:201458","source":"vndb"}]},"cast":[{"characterId":"char_c119035","characterName":"獅子喰 桜雅","sourceIds":{"bangumi":[{"characterId":"120343","match":"exact-normalized-name-in-linked-work","subjectId":"407711"}],"egsCharacterIds":["24460"],"vndbCharacterId":"c119035"},"originalCharacterName":"獅子喰 桜雅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kento's childhood friend. For unknown reason, they have always been in the same class since they were young. She is an extremely shy girl and becomes quiet when in front of others, but talks a lot when she is with Kento, whom she trusts the most. Ouga is the daughter of Shishikura Yotsuba, who is considered to be the strongest woman in Japan."},{"spoiler":false,"text":"Translated and edited from Getchu"}],"source":"vndb","sourceCharacterId":"c119035"},{"segments":[{"spoiler":false,"text":"なぜか子供の頃から常に同じ学校の同じクラスになる腐れ縁。"},{"spoiler":false,"text":"極度の人見知りで人前では基本的に無口。"},{"spoiler":false,"text":"それでも絶対的に信頼している主人公の前だけではよく喋ってはしゃぐ内弁慶。"}],"source":"egs","sourceCharacterId":"24460","sourceWorkId":"33548","spoiler":false},{"segments":[{"spoiler":false,"text":"なぜか子供の頃から常に同じ学校の同じクラスになる腐れ縁。"},{"spoiler":false,"text":"極度の人見知りで人前では基本的に無口だが、"},{"spoiler":false,"text":"本当は極度のあがり症。"},{"spoiler":false,"text":"その一面をひた隠すためポーカーフェイスを貫いている。"},{"spoiler":false,"text":"それでも絶対的に信頼している主人公の前だけではよく喋ってはしゃぐ内弁慶。"},{"spoiler":false,"text":"空手の日本女王である母親を持ち、"},{"spoiler":false,"text":"本人にも巨大な力が秘められているとか……？"}],"source":"bangumi","sourceCharacterId":"120343"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/69/695d87a38e953cbbbce632dd7c57121f87911823b327b42d76e806941ed33b6d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4dc0c1adf0ae40011ae04d78a04a9415da434c63ac645bd01e318209ad95dd0e.webp","width":120,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤沢れい香","creatorId":"vndb:s14338","sourcePersonId":"vndb:s14338","canonicalEntityId":"vndb:s14338","name":"藤沢 れい香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:465816:120343:32998:1","source":"bangumi"}]},{"characterId":"char_c119036","characterName":"天枝 千羽","sourceIds":{"bangumi":[{"characterId":"120344","match":"exact-normalized-name-in-linked-work","subjectId":"407711"}],"egsCharacterIds":["24461"],"vndbCharacterId":"c119036"},"originalCharacterName":"天枝 千羽","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"151"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl whom Kento meets on his school trip and also his cousin's best friend. One year later, because of their parents' remarriage, they reunite and become step-siblings. Because of her petite appearance and cheerful personality, she is adored by everyone around her. She is in love with Kento due to his \"kindness\", and tries to win him over, no matter the cost."},{"spoiler":false,"text":"Translated and edited from Getchu"}],"source":"vndb","sourceCharacterId":"c119036"},{"segments":[{"spoiler":false,"text":"修学旅行先で出会った一年後、親の再婚相手の連れ子として再会し義妹という関係に。"},{"spoiler":false,"text":"過保護な主人公の“厚意”を“好意”と受け取ってしまった結果、お兄ちゃん大好き状態で何としてでも主人公を振り向かせようと奔走する。"}],"source":"egs","sourceCharacterId":"24461","sourceWorkId":"33548","spoiler":false},{"segments":[{"spoiler":false,"text":"修学旅行で出会った一年後、"},{"spoiler":false,"text":"親の再婚相手の連れ子として再会し義妹という関係に。"},{"spoiler":false,"text":"過保護な主人公の\"好意\"を\"厚意\"と受け取ってしまった結果、"},{"spoiler":false,"text":"お兄ちゃん大好き状態で何としてでも主人公を振り向かせようと奔走する。"},{"spoiler":false,"text":"小柄かつ明るいキャラもあり、"},{"spoiler":false,"text":"周囲からはマスコット的な愛されキャラとして可愛がられている。"},{"spoiler":false,"text":"時には自身の好意が兄の負担になっていないかと気にかける場面も。"}],"source":"bangumi","sourceCharacterId":"120344"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/99e6798befe50d5cade5a64086d449d97bf90ed505881f30fb0aa8c34a6d0f01.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/50/508bae05d152089a3d5cbde43d16c7835a62b7d1032193b073ac06a21c1d1790.webp","width":120,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七種結花","creatorId":"vndb:s22881","sourcePersonId":"vndb:s22881","canonicalEntityId":"vndb:s22881","name":"佐藤 詩乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:465816:120344:56606:1","source":"bangumi"}]},{"characterId":"char_c119108","characterName":"唐朽 氷華","sourceIds":{"bangumi":[{"characterId":"120345","match":"exact-normalized-name-in-linked-work","subjectId":"407711"}],"egsCharacterIds":["24462"],"vndbCharacterId":"c119108"},"originalCharacterName":"唐朽 氷華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"163"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl whom Kento helps out on his school trip and later becomes acquainted with each other. Attending a prestigious all-girls school and is admired by the students there due to her personality, she has a strong sense of justice, but can sometime be too honest. Even though she does not know much about it, she longs to experience romance."},{"spoiler":false,"text":"Translated and edited from Getchu"}],"source":"vndb","sourceCharacterId":"c119108"},{"segments":[{"spoiler":false,"text":"修学旅行先で偶然ピンチを助けることになり、それをきっかけに仲を深めていく。"},{"spoiler":false,"text":"とにかく真面目で他人にも身内にも正論を振りかざし、融通がきかないところがある。"},{"spoiler":false,"text":"その一方で夢見がちな一面があり、恋愛に対してはロマンチックな願望を抱いている。"}],"source":"egs","sourceCharacterId":"24462","sourceWorkId":"33548","spoiler":false},{"segments":[{"spoiler":false,"text":"修学旅行先で偶然ピンチを助けることになり、"},{"spoiler":false,"text":"それをきっかけに仲を深めていくことになったお嬢様。"},{"spoiler":false,"text":"超お嬢様校として知られている織音女学園に通っており、"},{"spoiler":false,"text":"本人の人柄と気品のある佇まいで学院の生徒達からも慕われている。"},{"spoiler":false,"text":"とにかく真面目で正義感が強く、時には融通がきかないところがある。"},{"spoiler":false,"text":"その一方で夢見がちな一面があり、"},{"spoiler":false,"text":"恋愛に対してはロマンチックな願望を抱いている。"},{"spoiler":false,"text":"本人にあまり恋愛の知識がなく、"},{"spoiler":false,"text":"異性を意識する場面では初々しい反応をみせることも。"}],"source":"bangumi","sourceCharacterId":"120345"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec0c0241289f19fba7605dbf32e8334d605835b08da8bc16378258a9a390426e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08d159c3a9725770c05bdc45dcef506785c324f0c7accae6afb418e1ed0bb692.webp","width":120,"height":256,"source":"static-detail"},"actors":[{"creditedName":"さいとうよしえ","creatorId":"vndb:s1545","sourcePersonId":"vndb:s1545","canonicalEntityId":"vndb:s1545","name":"さいとう よしえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:465816:120345:20696:1","source":"bangumi"}]},{"characterId":"char_c119109","characterName":"藍城 満留","sourceIds":{"bangumi":[{"characterId":"120348","match":"exact-normalized-name-in-linked-work","subjectId":"407711"}],"egsCharacterIds":["24463"],"vndbCharacterId":"c119109"},"originalCharacterName":"藍城 満留","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl whom Kento meets at a coffee shop on his school trip, they meet again three years later in his hometown. She likes to drink in order to make up for her feeling of homesickness and loneliness. After the place where Kento works part-time suddenly goes out of business, Michiru hires him as a live-in housekeeper."},{"spoiler":false,"text":"Translated and edited from Getchu"},{"spoiler":false,"text":"She is the heroine of the official novel Koi ni wa Amae ga Hitsuyou Desu feat. Aijou Michiru and short story Michiru-san no Valentine, Michiru-san no White Day."}],"source":"vndb","sourceCharacterId":"c119109"},{"segments":[{"spoiler":false,"text":"修学旅行先の喫茶店で出会い、その三年後に主人公の地元で再会する。"},{"spoiler":false,"text":"ホームシックの寂しさを埋めるため酒に逃げていたヒロインだが、突然バイト先が潰れて困っている主人公を住み込みの家政夫として雇うことに。"}],"source":"egs","sourceCharacterId":"24463","sourceWorkId":"33548","spoiler":false},{"segments":[{"spoiler":false,"text":"修学旅行先の喫茶店で出会い、その三年後に主人公の地元で再会する。"},{"spoiler":false,"text":"ホームシックの寂しさを埋めるために酒に逃げていた満留だが、"},{"spoiler":false,"text":"突然バイト先が潰れて困っている主人公を住み込みの家政夫として雇うことに。"},{"spoiler":false,"text":"おっとりした雰囲気もあって「悪い人に騙されないか」と心配されがちだが、実際には地頭も良く、勉強もできるしっかりもの。"},{"spoiler":false,"text":"優等生タイプに見られやすいが友達とはしゃぐのが好き。"},{"spoiler":false,"text":"主人公との生活を気に入って、毎日の手料理を楽しみに会社から帰宅している。"}],"source":"bangumi","sourceCharacterId":"120348"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/termin