105484"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/672a9d6b0920042e90b5571a74e25bd19ea512de9725d19fd82c340f402a8fa0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e1cfe7142ab20e008b77127930906b133f515e33b43c33364ee2932500c0091b.webp","width":179,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_105485","characterName":"Cyllene","sourceIds":{"bangumi":[{"characterId":"105485","match":"source-roster","subjectId":"329302"}]},"originalCharacterName":"Cyllene","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"银河队调查组组长。"},{"spoiler":false,"text":"无论是对自己还是对别人都很严格。在她了解到主人公的资质后，会允许主人公参加银河队的入队考试。"},{"spoiler":false,"text":"此后，她会委托主人公做各种各样的调查，并在一旁守望主人公的成长。"}],"source":"bangumi","sourceCharacterId":"105485"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c9a13827530be613cc6ab2d81c0b06cd2e618c7cab5597fa79d69186e48237a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68a572c3be2acb22757282a3d91fc239656e7383d00b8780f2c108a9cca69823.webp","width":100,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_105486","characterName":"Adaman","sourceIds":{"bangumi":[{"characterId":"105486","match":"source-roster","subjectId":"329302"}]},"originalCharacterName":"Adaman","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"率领金刚队的首领，搭档是叶伊布。"},{"spoiler":false,"text":"他性格豪爽，讨厌耗费在慢慢等待上的时间，会不拘小节地奋勇前进。因为与珍珠队的首领珠贝理念不同而时常争执。"},{"spoiler":false,"text":"信仰着称为“神奥大尊”的帝牙卢卡，认为是神奥大尊时间的力量创造了宇宙。起初他认为珍珠队信仰的“神奥大尊”帕路奇亚是伪物，但随着银河队将帝牙卢卡与帕路奇亚的资料公开在图鉴上，与珍珠队之间的分歧也逐渐消弭。"}],"source":"bangumi","sourceCharacterId":"105486"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91736e0986a1743a89730525edcb8d557add453e8e42e15ca19df48549c5b5d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06744aaab7556b67511b92ee995cb67239fe224daf4c476d4c2b93bffea28fdc.webp","width":124,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_105487","characterName":"珠貝","sourceIds":{"bangumi":[{"characterId":"105487","match":"source-roster","subjectId":"329302"}]},"originalCharacterName":"珠貝","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"珍珠队的首领，搭档是冰伊布。"},{"spoiler":false,"text":"身为首领，她十分重视对洗翠广阔大地的无畏之心。起初她对主角有所怀疑，但在镇抚王的时候借助了主角的力量，也因此开始信任主角。"},{"spoiler":false,"text":"很討厭炎熱，但卻對寒冷不以為然，身在纯白冻土非但不覺得寒冷，反而還覺得熱，剛石對此感到無語。"},{"spoiler":false,"text":"信仰着称为“神奥大尊”的帕路奇亚，认为是神奥大尊使用空间的力量创造了宇宙。起初她认为金刚队信仰的“神奥大尊”帝牙卢卡是伪物，但随着银河队将帝牙卢卡与帕路奇亚的资料公开在图鉴上，与金刚队之间的分歧也逐渐消弭。"}],"source":"bangumi","sourceCharacterId":"105487"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b8e043b604415a17b997b13e804109776d88419c04b7126ebb413b5fd87bb8d0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/137f0408e0768b2fc4d84abfbe043b7df256fb31b42330aae9470bd6de9de8da.webp","width":111,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_105488","characterName":"Mai","sourceIds":{"bangumi":[{"characterId":"105488","match":"source-roster","subjectId":"329302"}]},"originalCharacterName":"Mai","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主角在冒险中最先遇到的场长，隶属于金刚队。"},{"spoiler":false,"text":"负责照顾栖息在洗翠地区黑曜原野的特别的诡角鹿。"},{"spoiler":false,"text":"她与搭档小卡比兽情同手足，从小一起长大。"}],"source":"bangumi","sourceCharacterId":"105488"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7db0a42cb20fa9c3a167045623bdd5ad86c80dd828902a56a8bef7a7054fed7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/4467114a559e4b4a725e825c8c7aae3bb67ec6b5d239d53ba3b10e3b27deb473.webp","width":117,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_105489","characterName":"Lian","sourceIds":{"bangumi":[{"characterId":"105489","match":"source-roster","subjectId":"329302"}]},"originalCharacterName":"Lian","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"洗翠地区黑曜原野的场长，隶属于珍珠队。"},{"spoiler":false,"text":"负责照顾黑曜原野的王，也就是劈斧螳螂的场长。"},{"spoiler":false,"text":"虽然年轻，但是非常优秀，因此受任担当场长。他似乎很崇拜又强又帅的劈斧螳螂。"},{"spoiler":false,"text":"搭档是黏黏宝。"}],"source":"bangumi","sourceCharacterId":"105489"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/6086bc91dab36bca8cf51ac09327f03e2a6fd1aa2a24178d353d306dfabe92b1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46b1b305a9692133dc67d580a88d77760c44b736318d62db277e37d9d104a159.webp","width":107,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_105490","characterName":"Arezu","sourceIds":{"bangumi":[{"characterId":"105490","match":"source-roster","subjectId":"329302"}]},"originalCharacterName":"Arezu","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"洗翠地区红莲湿地的场长，隶属于金刚队。"},{"spoiler":false,"text":"性格活泼。身为场长，她拥有比任何人都强的责任感，但也因此似乎有时会独自承担一切。负责照顾金刚队的山道女王裙儿小姐。"},{"spoiler":false,"text":"特长是理发。在主角镇抚裙儿小姐之后会来到祝庆村，兼职理发店的工作。"}],"source":"bangumi","sourceCharacterId":"105490"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/04/04379a8110d410e654405b8a059acc116f34be11a7d010f6eb1af04134b6384b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97b71b948c484dd75cb9e99a0359ce5a793ef06f24dd931c355be0e9c5fc22be.webp","width":102,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_105790","characterName":"Volus","sourceIds":{"bangumi":[{"characterId":"105790","match":"source-roster","subjectId":"329302"}]},"originalCharacterName":"Volus","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"游走于洗翠地区各地的银杏商会旅行商人，时不时会突然不知从何而来地出现在主人公面前。他对稀有的人和物品抱有强烈的兴趣，拥有旺盛的好奇心。"},{"spoiler":false,"text":"知晓帝牙卢卡，帕路奇亚与骑拉帝纳的知识。知晓真正的神奥大尊是阿尔宙斯。"},{"spoiler":false,"text":"真实身份是古代神奥人的直系后代。"}],"source":"bangumi","sourceCharacterId":"105790"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0ea06f746bf96ca20f03ad906664c858d94b11e562888839e60a1d121e86905f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74438bbc67276f743c7c24be92a1438ca11ffecf9ab57a8fe17f050c7b71a199.webp","width":101,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_105795","characterName":"Ingo","sourceIds":{"bangumi":[{"characterId":"105795","match":"source-roster","subjectId":"329302"},{"characterId":"105795","match":"source-roster","subjectId":"8641"},{"characterId":"105795","match":"source-roster","subjectId":"8642"}]},"originalCharacterName":"Ingo","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"《黑／白》和《黑２／白２》：对战地铁的其中一名首领。他和胞弟南厦一同担任地铁总管。在《黑／白》和《黑２／白２》中可以在绿线和深绿线同北尚进行单打对战，以及在橙线和黄线同他和南厦进行多人对战。"},{"spoiler":false,"text":"《传说 阿尔宙斯》：北尚在《传说 阿尔宙斯》再次登场。他是偶然间来到洗翠地区的场长，隶属于珍珠队。负责照顾大狃拉。任务过程中北尚会告诉主角，他与主角一样同为穿越者，因为未知原因穿越到了洗翠地区。并且丧失了除名字之外几乎所有的记忆。"}],"source":"bangumi","sourceCharacterId":"105795"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f5d568971aeb47aa8b80da96c0831cb6a2920771bed579bbb518b7fc43291ca4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f40d0d6019708be8e7f82186651e23bb937f6968591fe05a29eefce23d146226.webp","width":191,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_107465","characterName":"Calaba","sourceIds":{"bangumi":[{"characterId":"107465","match":"source-roster","subjectId":"329302"}]},"originalCharacterName":"Calaba","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"洗翠地区红莲湿地的场长，隶属于珍珠队。"},{"spoiler":false,"text":"99岁的老者，是负责照顾获得神奇庇佑的特别的宝可梦的年迈场长。"},{"spoiler":false,"text":"她原先负责照顾月月熊。在火夏到祝庆村兼职理发师后，暂替她照顾山道女王裙儿小姐和管理舞台战场。"},{"spoiler":false,"text":"她性格有着顽固的一面，无法轻易信任银河队和金刚队。"}],"source":"bangumi","sourceCharacterId":"107465"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d2cb6a4991d02e41b4912f4f5ff5fb86dcba74f3a422c27fe8c3435d9f103945.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1bd32679be5c37d52a373cbac6b3d225caa008f06d1d54d67ffe50a38cf3d64.webp","width":152,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_107466","characterName":"Iscan","sourceIds":{"bangumi":[{"characterId":"107466","match":"source-roster","subjectId":"329302"}]},"originalCharacterName":"Iscan","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"洗翠地区群青海岸的场长，隶属于金刚队。"},{"spoiler":false,"text":"住在海岸附近，负责照顾特别的幽尾玄鱼。性格腼腆内向，但内心温柔。他有着胆小的一面，似乎害怕幽灵属性的宝可梦。"}],"source":"bangumi","sourceCharacterId":"107466"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41388b8421539e228b0fcdfe5487147edb9d14e2c2b26028fc7cdecbf08d74b3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f04d111edd247c9a7d68d406d0c7a518fd62385523fe6d097ef6f9f95845f5ac.webp","width":126,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_107467","characterName":"Palina","sourceIds":{"bangumi":[{"characterId":"107467","match":"source-roster","subjectId":"329302"}]},"originalCharacterName":"Palina","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"洗翠地区群青海岸的场长，隶属于珍珠队。"},{"spoiler":false,"text":"负责照顾珍珠队上一代岛屿王风速狗的子嗣。在同地区的阿芒因为经常给予她帮助，两人的关系很好。"},{"spoiler":false,"text":"珠贝因为在成为首领的过程中受过瓜娜的帮助，因而很亲切地对她以昵称称呼，但瓜娜却不太喜欢她对外使用此昵称。"},{"spoiler":false,"text":"因为知道上一代岛屿王的死对卡蒂狗造成的阴影，并没有逼迫它成长为新的岛屿王，但因此能力受到了部分珍珠队成员的质疑，令珠贝很担忧。"}],"source":"bangumi","sourceCharacterId":"107467"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f327219b6784a7f58b46e7b95bd84906a1b7af0733ceb6a516cb41d5ead5d8a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dce4d06cd36b2de69766de9e9f7c93b6eb25cc20194dc4c8743e2ec78b4783ad.webp","width":61,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_107468","characterName":"Melli","sourceIds":{"bangumi":[{"characterId":"107468","match":"source-roster","subjectId":"329302"}]},"originalCharacterName":"Melli","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"洗翠地区天冠山麓的场长，隶属于金刚队。"},{"spoiler":false,"text":"负责照顾金刚队的洞窟王顽皮雷弹。"},{"spoiler":false,"text":"性格高傲，就算在面对作为首领的刚石时仍保持嚣张的态度，但仰慕着首领刚石，并称他为“刚石哥”。偶尔对其出言不逊，即便被训话了也丝毫没变。总是装腔作势，又有些冲动，但他其实对金刚队的伙伴抱有相当的热情。很看不起金刚队以外的组织。"}],"source":"bangumi","sourceCharacterId":"107468"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/485578774bee80d5cd382900fef62aab08f488386edea2daf8e86de9aba26e2a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24f1ffeda6c68c52bb29f2529b3af75588053a47a3fafd5173fb347c1e5d98e8.webp","width":139,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_107469","characterName":"Sabi","sourceIds":{"bangumi":[{"characterId":"107469","match":"source-roster","subjectId":"329302"}]},"originalCharacterName":"Sabi","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"洗翠地区纯白冻土的场长，隶属于金刚队。"},{"spoiler":false,"text":"负责照顾勇士雄鹰。拥有千里眼。"},{"spoiler":false,"text":"个性被刚石评为难以捉摸，喜欢到雪峰神殿玩捉迷藏，以至于神殿的门卫会给她放行。"},{"spoiler":false,"text":"她在所有场长之中是最年轻的，会让洗翠的样子的勇士雄鹰抓着在空中四处飞翔。时而说出仿佛能看到未来的发言，有着不可思议的气质。"}],"source":"bangumi","sourceCharacterId":"107469"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db76cdcbfacad94d2e165f63be221f2c75cacb76d770622d6722cb5272bab0a9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7c1b75ee91c957a2dc9034a23e5ca979587b27dca57b37e60c20806ef9aa8c19.webp","width":206,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_107470","characterName":"Gaeric","sourceIds":{"bangumi":[{"characterId":"107470","match":"source-roster","subjectId":"329302"}]},"originalCharacterName":"Gaeric","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"洗翠地区纯白冻土的场长，隶属于珍珠队。"},{"spoiler":false,"text":"负责照顾珍珠队的雪原王冰岩怪。但对于是否有必要镇抚狂暴的王一事抱有疑问。"},{"spoiler":false,"text":"受到珠贝的仰慕，并被其称为“滨师傅”。"},{"spoiler":false,"text":"在常年积雪的寒冷地带仍致力于赤膊锻炼肌肉，毫不在意寒冷。"}],"source":"bangumi","sourceCharacterId":"107470"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/986e2a30010483d5d48323e896e14b1b2608aa2ded04479a7af8519f1e48f595.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed0ce55c51e8a7e4ea5fe007669f92d9980667948ba1d23411949bf6d2077453.webp","width":110,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_107471","characterName":"Cogita","sourceIds":{"bangumi":[{"characterId":"107471","match":"source-roster","subjectId":"329302"}]},"originalCharacterName":"Cogita","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"居住在古昔隐居地，谜团重重的人物。"},{"spoiler":false,"text":"会将传承自祖先的传说讲述给主人公。"}],"source":"bangumi","sourceCharacterId":"107471"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55115e0fdca17919a0bf2a2637142b928df2700af4f06fe1797bae2dcc26d7d1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74729a97001e0b01bdb3e5ed2d91e468a26e04ebb19295272279b4bbb023de8c.webp","width":109,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_16701","characterName":"Oshawott","sourceIds":{"bangumi":[{"characterId":"16701","match":"source-roster","subjectId":"329302"},{"characterId":"16701","match":"source-roster","subjectId":"60896"},{"characterId":"16701","match":"source-roster","subjectId":"60897"}]},"originalCharacterName":"Oshawott","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"50"},"weight":{"reviewState":"source-only","source":"bangumi","value":"5.9"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水水獭是海獭类的宝可梦。它的头部和爪子都是白色，身体是蓝色。它的头上有两个深蓝色的尖状物，眼睛下面有类似于雀斑的黑点，还有一个褐色的椭圆形鼻子。它的腹部有贝壳状的扇贝贝，可以把它摘下来使用。"},{"spoiler":false,"text":"水水獭可以摘下腹部的扇贝贝当武器使用，诸如像使用小刀一样攻击，或是用扇贝贝来防御。"},{"spoiler":false,"text":"调皮好斗，没事把自己胸前的扇贝敲得“咚咚”作响。"}],"source":"bangumi","sourceCharacterId":"16701"}],"profileFacts":[{"label":"体形","source":"bangumi","sourceCharacterId":"16701","value":"双足兽形"},{"label":"属性","source":"bangumi","sourceCharacterId":"16701","value":"水"},{"label":"特性","source":"bangumi","sourceCharacterId":"16701","value":"激流"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72b5800699bf4616ffbcdb64ddcbb5d17304026475da0cbe98ee37b3347eea15.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e33d493be27d6e4eb560eea5680d891a98c53f91088d8c904d166977e266460.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_188415","characterName":"ガーディ（ヒスイのすがた）","sourceIds":{"bangumi":[{"characterId":"188415","match":"source-roster","subjectId":"329302"}]},"originalCharacterName":"ガーディ（ヒスイのすがた）","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"bangumi","value":"80"},"weight":{"reviewState":"source-only","source":"bangumi","value":"22.7"}},"descriptions":[{"segments":[{"spoiler":false,"text":"两只一组共同负责地盘的警卫工作。体毛中混有火成岩的成分，可以推想这是受到火山活动的影响。"}],"source":"bangumi","sourceCharacterId":"188415"}],"profileFacts":[{"label":"属性","source":"bangumi","sourceCharacterId":"188415","value":"火、岩石"},{"label":"特性","source":"bangumi","sourceCharacterId":"188415","value":"威吓、引火"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2b/2b42039995109c5943d92b3e2b5bfb27c5f5f8a53defdbad6a76ee7f90537a38.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f47a0a2693c20d8c7dbdd2041e68a0d3833ecc1077e9aae55f83452db9739cce.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_188416","characterName"