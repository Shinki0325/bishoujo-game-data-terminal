ceCharacterId":"5347","sourceWorkId":"21109","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の姪。"},{"spoiler":false,"text":"厳格な父親の教育によって、昔は素直で真面目な優等生だった。"},{"spoiler":false,"text":"しかし、父親の単身赴任を機に気が緩み、さらに進学してから出来た遊び人の友達の影響を受け、"},{"spoiler":false,"text":"派手で享楽的な「ギャル」になってしまった。"},{"spoiler":false,"text":"ただし、根は真面目なので完全にグレているわけではなく、ある程度のモラルは残っているので、"},{"spoiler":false,"text":"素行不良も暴力を振るったり犯罪に手を染めたりといった取り返しのつかないレベルではない。"},{"spoiler":false,"text":"あくまでも反抗期の延長程度。（援助交際やプチ家出は経験あり）"},{"spoiler":false,"text":"遊び仲間の先輩チャラ男に言い寄られて処女を奪われた。現在は、チャラ男とはセフレ状態で恋愛関係ではない。"},{"spoiler":false,"text":"快楽目的だけでなくお金目的の援助交際をしたこともあり、経験人数はそれなりに多い。"}],"source":"bangumi","sourceCharacterId":"89993"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9e0897fa85d34b3dd8c789492c1224d5bb1cb0a8d5852b8b5533e6a27d3c737f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/59/59ced34cca3a14d736f5bceab07fce9dff383855a53173fc50023554974adf17.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"近藤祐記","creatorId":"vndb:s1412","sourcePersonId":"vndb:s1412","canonicalEntityId":"vndb:s1412","name":"近藤 祐記","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:133501:89993:5904:1","source":"bangumi"}]},{"characterId":"char_vndb_c113486","characterName":"芦原 弘樹","sourceIds":{"vndbCharacterId":"c113486"},"originalCharacterName":"芦原 弘樹","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p2034","sourceCompanyId":"egs:brand:1863","canonicalEntityId":"vndb:p2034","name":"Blue Devil","roleCodes":["brand"],"identityStatus":"auto-confirmed",