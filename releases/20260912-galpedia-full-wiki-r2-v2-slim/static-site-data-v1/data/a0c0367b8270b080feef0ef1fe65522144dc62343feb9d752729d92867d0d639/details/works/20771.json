roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:111756","source":"vndb"},{"creditedName":"KANAMI","creatorId":"vndb:s4333","sourcePersonId":"vndb:s4333","canonicalEntityId":"vndb:s4333","name":"KANAMI","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:111757","source":"vndb"}]},"cast":[{"characterId":"char_c27922","characterName":"高藤 理彩","sourceIds":{"bangumi":[{"characterId":"214303","match":"exact-normalized-name-in-linked-work","subjectId":"660268"}],"egsCharacterIds":["4121"],"vndbCharacterId":"c27922"},"originalCharacterName":"高藤 理彩","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幼馴染、とは言ってもクラスがずっと同じだったわけではなく、付き合い自体は薄かった。ただ、久々に一緒のクラスになって既にラッキースケベを身につけていた彼にびっくり。"},{"spoiler":false,"text":"以降「更生させなきゃ！」と日々何かと彼に突っかかり、何かと文句を言ってくる。"},{"spoiler":false,"text":"春孝にとっては少々煩わしい存在。とはいえ、特別な感情も相まってラッキースケベの被害を食い止めるべく自ら人身御供を買って出たり（周囲には主人公狙いなのが見え見え）、しまいには「パンツ脱いでお尻を出してたら○○○が入ってくる確率って？」みたいな頭の悪いことを、真剣に考えてしまうしまう子だったり……。"},{"spoiler":false,"text":"純粋だけど、ちょいおバカ。そんな彼女の努力が、のらりくらりな彼に通用する日は果たして来るのか……？"}],"source":"egs","sourceCharacterId":"4121","sourceWorkId":"20771","spoiler":false},{"segments":[{"spoiler":false,"text":"なずな・春孝のクラスメイトで春孝とは幼馴染みの間柄。"},{"spoiler":false,"text":"誰に対してもストレートな物言いが特徴。"},{"spoiler":false,"text":"なずなの数少ない友人として相談に乗ってくれたり、アドバイスをくれたりするが的確かどうかは疑問の残るところ。"}],"source":"egs","sourceCharacterId":"4121","sourceWorkId":"21018","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼なじみ…… ではあるが、付き合い自体は薄かった。"},{"spoiler":false,"text":"久々に一緒のクラスになって、彼がラッキースケベになっていてびっくり。"},{"spoiler":false,"text":"以降 「更生させなきゃ！」 と、日々なにかと彼に突っかかり、やたら文句を言ってくる。"},{"spoiler":false,"text":"そのため、主人公にとっては少々わずらわしい存在。"},{"spoiler":false,"text":"自らラッキースケベの人身御供を買って出て、しまいには 「パンツ脱いでお尻を出してたら○○○が入ってくる確率って？」　みたいな頭の悪いことを、真剣に考えてしまう。"},{"spoiler":false,"text":"純粋だけど ちょいおバカ。　そんな彼女の努力が、のらりくらりな彼に通用する日は果たして来るのか……？"}],"source":"bangumi","sourceCharacterId":"214303"}],"profileFacts":[{"label":"胸围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"4121","sourceWorkId":"20771","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"4121","sourceWorkId":"20771","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"4121","sourceWorkId":"20771","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"4121","sourceWorkId":"20771","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"4121","sourceWorkId":"20771","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"46 kg","valueContext":null,"source":"egs","sourceCharacterId":"4121","sourceWorkId":"20771","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3a60f3ffd1aa5568449a40f73e1e23bc6db15732554d6aa9c350c3920dad229.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/63/63be9bae7bfd0f085dc0096ae44d3425c2f0cbae203b08cedbac62b12e39839a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:660268:214303:15637:1","source":"bangumi"}]},{"characterId":"char_c28162","characterName":"氷見 なずな","sourceIds":{"bangumi":[],"egsCharacterIds":["4122"],"vndbCharacterId":"c28162"},"originalCharacterName":"氷見 なずな","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"春考も所属する学生会の総務。基本的にちょっと鈍くさくて人の意見に反論できない、おどおど系女子。気は小さいけれど胸は非常に大きい。"},{"spoiler":false,"text":"学年で唯一、春考のラッキースケベの餌食になっていないのが悩みの種。本人はそれを異性として認識してもらえていないと捉え、なんとか春考に振り向いてもらおうと意を決して猛アタックを開始する。"},{"spoiler":false,"text":"しかし執拗なアピールを繰り返した結果、春考もついイラっとして手荒く扱ってしまい……言ってわからないのであれば身体に言い聞かせる、という感じで。"},{"spoiler":false,"text":"結果わかったのは彼女はＭ気質で、かつ非常にＨに貪欲という事だった……。"}],"source":"egs","sourceCharacterId":"4122","sourceWorkId":"20771","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・春孝、理彩のクラスメイトで同じ学生会に所属する地味系な巨乳の少女。"},{"spoiler":false,"text":"目立たない存在から脱却しようと近しい存在の春孝にすがるも、くせ者の春孝にとっては面倒くさい事この上ない。結果、手荒くあしらわれた挙げ句にとうとう処女まで捧げてしまうことに。"},{"spoiler":false,"text":"しかしそれを機に二人の距離は近づき、スパンキングやアダルトグッズプレイなど段々とエスカレートしていく始末。なずなが春孝に拘るのは好意なのか、更なる快楽を与えてくれるからなのか。なずなの底知れない欲望はとどまるところを知らない……。"}],"source":"egs","sourceCharacterId":"4122","sourceWorkId":"21018","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"4122","sourceWorkId":"20771","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"4122","sourceWorkId":"20771","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"154 cm","valueContext":null,"source":"egs","sourceCharacterId":"4122","sourceWorkId":"20771","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"4122","sourceWorkId":"20771","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"4122","sourceWorkId":"20771","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"48 kg","valueContext":null,"source":"egs","sourceCharacterId":"4122","sourceWorkId":"20771","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6c5eec48f95df5699b06d30572ad2eab34675ed0c40a4b1f84b70e389a0875e7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bbe9d0875a483556a5dbbba0ccecc13503b37351a79cd805bf63788deb609a23.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"篠原 ゆみ","creatorId":"vndb:s692","sourcePersonId":"vndb:s692","canonicalEntityId":"vndb:s692","name":"水瀬 沙季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59749","source":"vndb"}]},{"characterId":"char_c51149","characterName":"結城 沙耶","sourceIds":{"bangumi":[],"egsCharacterIds":["4123"],"vndbCharacterId":"c51149"},"originalCharacterName":"結城 沙耶","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"春考たちの一つ年上の学生会会長。ちっこいちっぱいすばしっこい。外見だけだととても年上には見えない。"},{"spoiler":false,"text":"面倒くさいと自分からは絶対に動かない春孝を、どうにか能動的なヤツにしてやろうと画策するが……本心は自分の思い通りに動かしたい、自分に傅かせたいだけだったり。"},{"spoiler":false,"text":"とはいえ、どこか分かった風の春考が早々なびくはずもなく、沙耶は一つの賭けに出る。相手に屈するか屈しないか、一週間限定のプライド勝負。"},{"spoiler":false,"text":"沙耶は、春孝を快楽で絡め取ろうと、面倒くさがり屋の男の身体を教育しにかかって……。"}],"source":"egs","sourceCharacterId":"4123","sourceWorkId":"20771","spoiler":false},{"segments":[{"spoiler":false,"text":"なずな・春孝が所属する学生会の会長。"},{"spoiler":false,"text":"見た目とは逆に年上らしい知識と判断力を持つ頼れる先輩。"},{"spoiler":false,"text":"ただその場が面白ければいいという考えが見え隠れしていて中々油断のならない相手でもある。"}],"source":"egs","sourceCharacterId":"4123","sourceWorkId":"21018","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"73 cm","valueContext":null,"source":"egs","sourceCharacterId":"4123","sourceWorkId":"20771","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCharacterId":"4123","sourceWorkId":"20771","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"146 cm","valueContext":null,"source":"egs","sourceCharacterId":"4123","sourceWorkId":"20771","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"4123","sourceWorkId":"20771","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"4123","sourceWorkId":"20771","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"42 kg","valueContext":null,"source":"egs","sourceCharacterId":"4123","sourceWorkId":"20771","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b1f8530e31182bd2b1ca047c17a4e84a0b24ef10f1d3dcb1c6d896af5c37677.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8ae7f0ab843639b65b7d48237a04f14230aee9953ceb6fd117a1b7b39ca13b67.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"手塚 りょうこ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:59748","source":"vndb"}]},{"characterId":"char_vndb_c121820","characterName":"湯上 春孝","sourceIds":{"v