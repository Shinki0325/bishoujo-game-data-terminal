{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"12904","model":{"presentationWorkId":"vndb:v2561","staff":{"artwork":[{"creditedName":"ふゆの春秋","creatorId":"vndb:s1587","sourcePersonId":"egs:creator:14117","canonicalEntityId":"vndb:s1587","name":"ふゆの春秋","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:80065","source":"egs"}],"scenario":[{"creditedName":"タシロハヤト(鬼畜人タムー)","creatorId":"vndb:s780","sourcePersonId":"egs:creator:102","canonicalEntityId":"vndb:s780","name":"タシロハヤト(鬼畜人タムー)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:80066","source":"egs"}],"music":[],"other":[{"creditedName":"TotSamiyMisha","creatorId":"vndb:s28234","sourcePersonId":"vndb:s28234","canonicalEntityId":"vndb:s28234","name":"TotSamiyMisha","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:35884","source":"vndb"},{"creditedName":"Hidari Yana","creatorId":"vndb:s41925","sourcePersonId":"vndb:s41925","canonicalEntityId":"vndb:s41925","name":"Hidari Yana","roleCode":"translator","roleLabel":"翻译","identityStatus":"source-native","relationId":"vndb:vn-staff:35885","source":"vndb"},{"creditedName":"ふゆの 春秋","creatorId":"vndb:s1587","sourcePersonId":"vndb:s1587","canonicalEntityId":"vndb:s1587","name":"ふゆの 春秋","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:35887","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c93774","characterName":"古乃宮 遥","sourceIds":{"vndbCharacterId":"c93774"},"originalCharacterName":"古乃宮 遥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"},"weight":{"reviewState":"source-only","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A classmate of the protagonist."},{"spoiler":false,"text":"She is the very image of a refined young lady and comes from a wealthy family. Shy and reserved, she struggles with social interactions. While she has quite a few female friends, she can hardly bring herself to speak to boys. Her feelings for the protagonist only make matters worse—she becomes so self-conscious around him that even saying his name proves difficult."},{"spoiler":false,"text":"During this year’s summer vacation, she joined a small group of classmates on a four-day seaside trip, staying at her family’s villa in Izu. Having the protagonist there with them allowed the distance between them to close, if only slightly. Yet even after the new term began, their relationship showed no real signs of change."},{"spoiler":false,"text":"Then came Hayami Kaede’s sudden confession—an event that finally drove her to make a momentous decision."}],"source":"vndb","sourceCharacterId":"c93774"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/80/80331691c0633a0588146ebb47316e2b53062b6fb00e6fb9a71103201b383696.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87179efd3c0bb2fcf817447b75497d30b7d3baf1b7036db69e3c98b9ec6cdec5.webp","width":202,"height":256,"source":"static-detail"},"actors":[{"creditedName":"堀江 由衣","creatorId":"vndb:s46","sourcePersonId":"vndb:s46","canonicalEntityId":"vndb:s46","name":"堀江 由衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19228","source":"vndb"},{"creditedName":"辻 あゆみ","creatorId":"vndb:s271","sourcePersonId":"vndb:s271","canonicalEntityId":"vndb:s271","name":"辻 あゆみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19232","source":"vndb"},{"creditedName":"能登 麻美子","creatorId":"vndb:s468","sourcePersonId":"vndb:s468","canonicalEntityId":"vndb:s468","name":"能登麻美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19236","source":"vndb"},{"creditedName":"平野 綾","creatorId":"vndb:s1500","sourcePersonId":"vndb:s1500","canonicalEntityId":"vndb:s1500","name":"平野 綾","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19240","source":"vndb"}]},{"characterId":"char_vndb_c93775","characterName":"倉沢陽菜","sourceIds":{"vndbCharacterId":"c93775"},"originalCharacterName":"倉沢陽菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"65"},"height":{"reviewState":"source-only","source":"vndb","value":"140"},"hip":{"reviewState":"source-only","source":"vndb","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"},"weight":{"reviewState":"source-only","source":"vndb","value":"36"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She’s a third-year middle school student and the protagonist’s childhood friend. Her older sister, Runa, is his classmate."},{"spoiler":false,"text":"Cheerful, lively, and a little cheeky, she’s not the type to be easily intimidated. During lunch breaks, she often drops by his high school classroom to eat with him and his friends. He treats her like a younger sister—more like a kid than an equal. She’s not entirely happy about that, but she’s accepted it, telling herself it’s fine as long as he dotes on her."},{"spoiler":false,"text":"However, everything changes when she learns that Kaede and the other girls have confessed to him. That’s when she decides to step out of the “little sister” role and become something more."}],"source":"vndb","sourceCharacterId":"c93775"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12d2726e59efcc92eb0865620625c099195c56eeaf13b9920f82a1e8dffb6069.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d52df3e0437258533b51f2419324ed099e62c255d61ecba17595a4c4bbc81a7.webp","width":202,"height":256,"source":"static-detail"},"actors":[{"creditedName":"堀江 由衣","creatorId":"vndb:s46","sourcePersonId":"vndb:s46","canonicalEntityId":"vndb:s46","name":"堀江 由衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19229","source":"vndb"},{"creditedName":"辻 あゆみ","creatorId":"vndb:s271","sourcePersonId":"vndb:s271","canonicalEntityId":"vndb:s271","name":"辻 あゆみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19233","source":"vndb"},{"creditedName":"能登 麻美子","creatorId":"vndb:s468","sourcePersonId":"vndb:s468","canonicalEntityId":"vndb:s468","name":"能登麻美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19237","source":"vndb"},{"creditedName":"平野 綾","creatorId":"vndb:s1500","sourcePersonId":"vndb:s1500","canonicalEntityId":"vndb:s1500","name":"平野 綾","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19241","source":"vndb"}]},{"characterId":"char_vndb_c93776","characterName":"速水 楓","sourceIds":{"vndbCharacterId":"c93776"},"originalCharacterName":"速水 楓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"source-only","source":"vndb","value":"170"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"61"},"weight":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A transfer student with refined features and a dignified, almost noble presence. She is the protagonist’s childhood friend."},{"spoiler":false,"text":"Although they are childhood friends, they didn’t grow up together—she was a girl who lived near his maternal grandparents' home."},{"spoiler":false,"text":"Whenever the protagonist visited his relatives with his mother, they would always play together. But one day, her family moved away."},{"spoiler":false,"text":"All this time, Kaede has continued to harbor feelings for him. When they unexpectedly reunite at her new school, long-suppressed emotions overflow, leading her to make a sudden confession."}],"source":"vndb","sourceCharacterId":"c93776"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9aae6af9d8ffe0e692e300d1308728b220ddec8acd46ad7b2c856ef3ff524d62.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97f7e5668d4bf79922b73942ccc4d2ac15927c2b33924fd5667f7d83af20ea8e.webp","width":202,"height":256,"source":"static-detail"},"actors":[{"creditedName":"堀江 由衣","creatorId":"vndb:s46","sourcePersonId":"vndb:s46","canonicalEntityId":"vndb:s46","name":"堀江 由衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19230","source":"vndb"},{"creditedName":"辻 あゆみ","creatorId":"vndb:s271","sourcePersonId":"vndb:s271","canonicalEntityId":"vndb:s271","name":"辻 あゆみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19234","source":"vndb"},{"creditedN