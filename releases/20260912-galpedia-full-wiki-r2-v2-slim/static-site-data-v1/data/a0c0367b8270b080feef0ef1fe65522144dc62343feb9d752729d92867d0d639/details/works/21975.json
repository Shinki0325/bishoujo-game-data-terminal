k","subjectId":"205860"}],"egsCharacterIds":["6563"],"vndbCharacterId":"c53151"},"originalCharacterName":"赤坂 花音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"二人組の魔法少女の一人。"},{"spoiler":false,"text":"困っている人をほっとけない性格。"},{"spoiler":false,"text":"敵を作りやすい理々を気遣ったり、赴任したばかりの主人公の面倒を見たりと何かと世話をやく。"},{"spoiler":false,"text":"頼られることを嬉しく思っているが、その反面、頼りがいがある人が好みで、いつも相談に乗ってくれる主人公が好き"}],"source":"egs","sourceCharacterId":"6563","sourceWorkId":"21975","spoiler":false},{"segments":[{"spoiler":false,"text":"理々とコンビで悪と戦う魔法少女。"},{"spoiler":false,"text":"困っている人を放っておけない性格。"},{"spoiler":false,"text":"今時の女の子として学生生活を満喫しており、持ち前の明るさと優しさでみんなから慕われている。"},{"spoiler":false,"text":"頼られることを嬉しく思う反面 甘えん坊な一面もあり、頼り甲斐のある主人公に恋心を抱いている。"},{"spoiler":false,"text":"相棒の理々とは親友の間柄で、理々がクラスで孤立しないように気を掛けている。"},{"spoiler":false,"text":"「わたしは悪には屈しないから！」"}],"source":"bangumi","sourceCharacterId":"50017"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4c/4c9e9af215e747fe1a7897ce4558be8f6dbf0348c4c324efd7c583b92a1e97ea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60e3753241a88cf4cb89ec2d15aad2b78e199c88ad93df3f69f33cff3ae3e47b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大野まりな","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:205860:50017:4434:1","source":"bangumi"}]},{"characterId":"char_c53152","characterName":"青野 理々","sourceIds":{"bangumi":[{"characterId":"50018","match":"exact-normalized-name-in-linked-work","subjectId":"205860"}],"egsCharacterIds":["6564"],"vndbCharacterId":"c53152"},"originalCharacterName":"青野 理々","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"花音とコンビを組む魔法少女。"},{"spoiler":false,"text":"真面目な性格で、正義感が強く正論が好き。"},{"spoiler":false,"text":"理屈っぽいところもある。"},{"spoiler":false,"text":"生真面目すぎるせいで、クラスで疎んじられることもあるが、不器用なだけ。"},{"spoiler":false,"text":"市民を守る魔法少女としてプライドを持っており、悪は許さない。"}],"source":"egs","sourceCharacterId":"6564","sourceWorkId":"21975","spoiler":false},{"segments":[{"spoiler":false,"text":"花音とコンビで悪と戦う正義の味方。"},{"spoiler":false,"text":"まじめな性格で、正義感が強く正論が好き。"},{"spoiler":false,"text":"そんな性格が災いして、クラスメイトからは疎んじられている。"},{"spoiler":false,"text":"市民を守る魔法少女としてプライドを持っており、悪は許さない。"},{"spoiler":false,"text":"相棒の花音とは親友で、主人公との恋も陰ながら応援している。"},{"spoiler":false,"text":"「悪と戦う正義の味方は孤独な存在よ」"}],"source":"bangumi","sourceCharacterId":"50018"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15b01428aecf4cf1eabb1e87003411b3a8cd4be8ed14706404630912a5630534.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/40/407cd02077e6f4480469d55c3d4087cbe91e6d12581c7053d8e8d125eeab3321.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:205860:50018:10026:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p384","sourceCompanyId":"egs:brand:1869","canonicalEntityId":"vndb:p384","name":"HEAT-SOFT","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:21975:1869","source":"egs"},{"companyId":"vndb:p384","sourceCompanyId":"vndb:p384","canonicalEntityId