している。なお、『フレンズ』では特に過去の設定が変更されている。9月23日生まれ。A型。身長163cm。体重48kg。スリーサイズB83/W56/H82。"}],"source":"bangumi","sourceCharacterId":"22742"}],"profileFacts":[],"metadataCandidateConflicts":{"height":[{"comparisonValue":"164","source":"vndb","sourceCharacterId":"c6250","value":"164"},{"comparisonValue":"164","scope":"sourceWork","source":"egs","sourceCharacterId":"22723","sourceWorkId":"1468","value":"164"},{"comparisonValue":"163","scope":"sourceWork","source":"egs","sourceCharacterId":"22723","sourceWorkId":"1577","value":"163"},{"comparisonValue":"164","scope":"sourceWork","source":"egs","sourceCharacterId":"22723","sourceWorkId":"473","value":"164"},{"comparisonValue":"163","source":"bangumi","sourceCharacterId":"22742","value":"163cm"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47848db117c31df6a4050c03901463da7ead96164bce4e53c08ecf82a29382ca.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b3f6a1353ba6166a05e0e98c9be0fd9049bfd37dc67fa605942755e19eb4266.webp","width":202,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤咲かおり","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"韮井叶","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224738:22742:6105:1","source":"bangumi"}]},{"characterId":"char_c6253","characterName":"若林 鮎","sourceIds":{"bangumi":[{"characterId":"22743","match":"exact-normalized-name-in-linked-work","subjectId":"224693"},{"characterId":"22743","match":"exact-normalized-name-in-linked-work","subjectId":"224738"}],"egsCharacterIds":["22722"],"vndbCharacterId":"c6253"},"originalCharacterName":"若林 鮎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"122"},"bloodType":{"reviewState":"no-conflict","source":"v