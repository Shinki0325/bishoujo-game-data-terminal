:"vndb:s9032","sourcePersonId":"egs:creator:16844","canonicalEntityId":"vndb:s9032","name":"上木乃アロエ","detail":"キャラ彩色","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:218673","source":"egs"},{"creditedName":"田中 理々","creatorId":"vndb:s1977","sourcePersonId":"vndb:s1977","canonicalEntityId":"vndb:s1977","name":"田中 理々","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:108702","source":"vndb"},{"creditedName":"もりたみ よを","creatorId":"vndb:s15669","sourcePersonId":"vndb:s15669","canonicalEntityId":"vndb:s15669","name":"もりたみ よを","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:108706","source":"vndb"},{"creditedName":"もりたみ よを","creatorId":"vndb:s15669","sourcePersonId":"vndb:s15669","canonicalEntityId":"vndb:s15669","name":"もりたみ よを","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:108707","source":"vndb"}]},"cast":[{"characterId":"char_c79288","characterName":"山代 マイ","sourceIds":{"bangumi":[{"characterId":"25459","match":"exact-normalized-name-in-linked-work","subjectId":"100420"}],"egsCharacterIds":["3752"],"vndbCharacterId":"c79288"},"originalCharacterName":"山代 マイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"翔太の幼馴染で現在は同居人でもある。高原学園二回生。"},{"spoiler":false,"text":"学業の傍ら、父親が宮司を務める山代神社で巫女をしており、須賀町の夏祭りでは毎年、巫女神楽を奉納している。"},{"spoiler":false,"text":"料理は苦手だが、果敢に新たなメニューにチャレンジし続けている。ただ、塩むすびだけは絶品と周囲の評価も高い。"},{"spoiler":false,"text":"幼なじみの翔太のことをいつも気にかけている。"}],"source":"egs","sourceCharacterId":"3752","sourceWorkId":"20358","spoiler":false},{"segments":[{"spoiler":false,"text":"翔太の幼なじみで、現在は同居人でもある。 高原学園二回生。"},{"spoiler":false,"text":"学業のかたわら、父親が宮司を務める山代神社で巫女をしており、須賀町の夏祭りでは毎年、巫女神楽を奉納している。"},{"spoiler":false,"text":"料理は苦手だが、果敢に新たなメニューにチャレンジし続け、大敗し続けている。"},{"spoiler":false,"text":"ただ、塩むすびだけは絶品と周囲の評価も高い。"},{"spoiler":false,"text":"部活動は飼育部。小動物が大好きで、動物にも不思議なぐらいに懐かれる。"},{"spoiler":false,"text":"本人を前にすると口やかましくなってしまうが、いつも翔太のことを気に掛けている。"}],"source":"bangumi","sourceCharacterId":"25459"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89cc7718063c471755186bd58c5565a74c9e25277c303524431c539eb31d4665.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b287c29b8d47cfd9237a5fe12bad99e82371a58c22f742d281fa1439e7e2e0df.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤美佳子","creatorId":"vndb:s1137","sourcePersonId":"vndb:s1137","canonicalEntityId":"vndb:s1137","name":"佐藤美佳子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100420:25459:6122:1","source":"bangumi"}]},{"characterId":"char_c79289","characterName":"八樹 さゆり","sourceIds":{"bangumi":[{"characterId":"25461","match":"exact-normalized-name-in-linked-work","subjectId":"100420"}],"egsCharacterIds":["3753"],"vndbCharacterId":"c79289"},"originalCharacterName":"八樹 さゆり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"夏休み前という妙な時期に高原学園に編入きた。翔太たちと同じクラス。"},{"spoiler":false,"text":"それ以来、何故か翔太にしつこく絡んでくる。ことあるごとに翔太を付けまわし、まるでストーカーのようだが、本人によるとそれは『監視』なのだという。何のために翔太を監視する必要があるのかはまったく意味不明。本人もまともな説明はしない。"},{"spoiler":false,"text":"私生活に関しては謎が多い。"}],"source":"egs","sourceCharacterId":"3753","sourceWorkId":"20358","spoiler":false},{"segments":[{"spoiler":false,"text":"二年の夏休み前という妙な時期に高原学園に編入してきた。 翔太たちとは同じクラス。"},{"spoiler":false,"text":"転校してきて以来、何故か翔太にしつこく絡んでくる。"},{"spoiler":false,"text":"ことあるごとに翔太を付けまわし、まるでストーカーのようだが、本人によるとそれは “監視” なのだという。"},{"spoiler":false,"text":"何のために翔太を監視する必要があるのかは、まったく意味不明。"},{"spoiler":false,"text":"本人もまともな説明はしない。"},{"spoiler":false,"text":"私生活に関しても謎が多い。"},{"spoiler":false,"text":"写真部に所属しており、いつもカメラを持ち歩いている。"}],"source":"bangumi","sourceCharacterId":"25461"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8c2a9a3a02ac936337760041ff21656a0e8fba17ab6759432195cc7a3140389.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d5/d5472fa595db19be783504eca4e4e2e1ac48a43e6957faadaf80ff0967705ef6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田中理々","creatorId":"vndb:s1977","sourcePersonId":"vndb:s1977","canonicalEntityId":"vndb:s1977","name":"田中 理々","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100420:25461:17081:1","source":"bangumi"}]},{"characterId":"char_c79290","characterName":"橘 ゆずの","sourceIds":{"bangumi":[{"characterId":"25460","match":"exact-normalized-name-in-linked-work","subjectId":"100420"}],"egsCharacterIds":["3754"],"vndbCharacterId":"c79290"},"originalCharacterName":"橘 ゆずの","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"マイ、翔太とは幼馴染。高原学園二回生。"},{"spoiler":false,"text":"今年の夏休みだけ山代神社で巫女のバイトをすることになったため、二人とは現在は同居中。マイ以外の人間に対して人見知りが激しく、翔太とも打ち解けた訳ではない。マイとは違って料理全般が得意。ただ塩むすびだけはマイにかなわないらしい。"},{"spoiler":false,"text":"大のゾンビ好きでその手の映画やグッズを見るとメロメロになる。運動神経は抜群。"}],"source":"egs","sourceCharacterId":"3754","sourceWorkId":"20358","spoiler":false},{"segments":[{"spoiler":false,"text":"マイ・翔太とは幼なじみ。 高原学園二回生。"},{"spoiler":false,"text":"今年の夏休みだけ山代神社で巫女のバイトをすることになったため、ふたりとは現在は同居人でもある。"},{"spoiler":false,"text":"マイ以外の人間に対しては人見知りが激しく、翔太とも打ち解けたわけではない。"},{"spoiler":false,"text":"両親はそんなゆずのの人見知りな性格を心配しているらしい。"},{"spoiler":false,"text":"マイとは違って料理全般が得意。 ただ、塩むすびだけはマイにかなわないらしい。"},{"spoiler":false,"text":"大のゾンビ好きで、その手の映画やグッズを見るとメロメロになる。"},{"spoiler":false,"text":"部活動は薙刀部。 運動神経は抜群。"}],"source":"bangumi","sourceCharacterId":"25460"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79900b0e8f7ba16149c9225d5a9cd9f3a0125fb62d5b80d24d3a313452ac9b9e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/287788ce3245f75ebe9deb57e7af3fad0ccb71dd15b23e6140a649104e87bf95.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"竹間千ノ美","creatorId":"vndb:s574","sourcePersonId":"vndb:s574","canonicalEntityId":"vndb:s574","name":"緒田 マリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100420:25460:19333:1","source":"bangumi"}]},{"characterId":"char_c79291","characterName":"播磨 幸穂","sourceIds":{"bangumi":[{"characterId":"25462","match":"exact-normalized-name-in-linked-work","subjectId":"100420"}],"egsCharacterIds":["3755"],"vndbCharacterId":"c79291"},"originalCharacterName":"播磨 幸穂","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"高原学園三回生。現在、学園代表をしている。"},{"spoiler":false,"text":"おっとりとした性格。紅茶が大好きで、お菓子作りが得意。お菓子作りの腕前はプロ級ともいわれており、学園主催のお茶会では皆から絶賛されている。"},{"spoiler":false,"text":"美人な上に面倒見がよくて誰に対しても優しく、同級生からも下級生からも絶大な人気と信頼を得ている。翔太の友人である慎吾が学園副代表をしている縁で、翔太とも会えば話をする仲。"}],"source":"egs","sourceCharacterId":"3755","sourceWorkId":"20358","spoiler":false},{"segments":[{"spoiler":false,"text":"高原学園三回生。 現在、学園代表をしている。"},{"spoiler":false,"text":"おっとりとした性格。 紅茶が大好きで、お菓子作りが得意。"},{"spoiler":false,"text":"お菓子作りの腕前はプロ級とも言われており、学園主催のお茶会では皆から絶賛されている。"},{"spoiler":false,"text":"美人なうえに面倒見が良く、誰に対しても優しくて、同級生からも下級生からも絶大な人気と信頼を得ている。"},{"spoiler":false,"text":"翔太の友人である慎吾が学園副代表をしている縁で、翔太とも会えば話をする仲。"},{"spoiler":false,"text":"成績は常に学年トップをキープしている優等生。"}],"source":"bangumi","sourceCharacterId":"25462"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1309ccdb7fb9cb6db24987d1f21b39f150af7524afe3e9afb6f29d0c9eee647.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/35d3847d8c9f8d20f687cad2478d4d47dab31d715a9671d2254efabfb30763ac.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥川久美子","creatorId":"vndb:s861","sourcePersonId":"vndb:s861","canonicalEntityId":"vndb:s861","name":"奥川 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100420:25462:22331:1","source":"bangumi"}]},{"characterId":"char_c79292","characterName":"越野 夢子","sourceIds":{"bangumi":[{"characterId":"25463","match":"exact-normalized-name-in-linked-work","subjectId":"100420"}],"egsCharacterIds":["3756"],"vndbCharacterId":"c79292"},"originalCharacterName":"越野 夢子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"高原学園の化学教師。翔太たちの担任でもある。学園生たちが可愛くて仕方がないらしい。"},{"spoiler":false,"text":"苦手意識を持つ学園生の多い化学を分かりやすく丁寧に説明してくれ、しかも優しくて気さくなので、みんなにも人気がある。天然なところがあり、ときどき抜けた行動をしてしまうのも愛嬌があって良いとさらに人気を高めている原因になっている。"},{"spoiler":false,"text":"部活動は化学部の顧問をしている。幽霊部員が多いので、部員が来るととても無邪気に喜ぶ。しかし、その正体は……。"}],"source":"egs","sourceCharacterId":"3756","sourceWorkId":"20358","spoiler":false},{"segments":[{"spoiler":false,"text":"高原学園の化学教師。 翔太たちの担任でもある。"},{"spoiler":false,"text":"学園生たちが可愛くて仕方がないらしい。"},{"spoiler":false,"text":"苦手意識を持つ学園生が多い化学を分かりやすく丁寧に説明してくれ、しかも優しくて気さくなのでみんなから人気がある。"},{"spoiler":false,"text":"天然なところがあり、時々抜けた行動をしてしまうのも愛嬌があって良いと、さらに人気を高めている原因になっているようだ。"},{"spoiler":false,"text":"部活は化学部の顧問をしている。"},{"spoiler":false,"text":"幽霊部員が多いので、部員が来ると とても無邪気に喜ぶ。"}],"source":"bangumi","sourceCharacterId":"25463"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9ce62c72b37eda04b24c7d2e65dd538d5334d9379d722e1e3564cd84e6dd1a5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/29/29be2faf260821f27e2a04c0ca6629115d242aaaa12b9aa9a33ff5c27e8ec2c3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天乙准花","creatorId":"vndb:s339","sourcePersonId":"vndb:s339","canonicalEntityId":"vndb:s339","name":"椎那 天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:100420:25463:7890:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p4253","sourceCompanyId":"egs:brand:4214","canonicalEntityId":"vndb:p4253","name":"ソフトハウスSORA","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:20358:4214","source":"egs"},{"companyId":"vndb:p4253","sourceCompanyId":"vndb:p4253","canonicalEntityId":"vndb:p4253","name":"ソフトハウスSORA","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:38078:v14894","source":"vndb"},{"companyId":"vndb:p4253","sourceCompanyId":"vndb:p4253","canonicalEntityId":"vndb:p4253","name":"ソフトハウスSORA","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:39511:v14894","source":"vndb"},{"companyId":"vndb:p4253","sourceCompanyId":"vndb:p4253","canonicalEntityId":"vndb:p4253","name":"ソフトハウスSORA","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:40261:v14894","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],