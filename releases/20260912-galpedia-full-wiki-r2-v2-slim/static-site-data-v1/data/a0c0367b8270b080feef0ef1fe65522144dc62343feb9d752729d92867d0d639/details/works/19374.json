ce-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73314","source":"vndb"}]},{"characterId":"char_vndb_c31379","characterName":"富士見 鈴","sourceIds":{"vndbCharacterId":"c31379"},"originalCharacterName":"富士見 鈴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"214"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A part-time worker at \"Supernova\", and the bassist and leader of the all-girls' band Dai Ichi Uchuu Sokudo. She is also Ena's older sister. Once upon a time she used do girls' wrestling, and knows how to drop some good drop kicks. She often threatens to use these whenever she gets annoyed."}],"source":"vndb","sourceCharacterId":"c31379"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b77027981da7ad8c74ceeacd903843e76e47fc6ce5e6161a5d234af39850bc7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/12e1b71331a95ad182527d19a5a1c8e9ab9253c23b4da26406b4a5dc5e63a836.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤 麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:73313","source":"vndb"}]},{"characterId":"char_vndb_c3643","characterName":"すーぱーそに子","sourceIds":{"vndbCharacterId":"c3643"},"originalCharacterName":"すーぱーそに子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1014"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Date of Birth (Creation): 2006/10/14"},{"spoiler":false,"text":"From: Musashino-shi, Tokyo."},{"spoiler":false,"text":"Hobbies: Bathing, playing with cats, gaming."},{"spoiler":false,"text":"Special skill: Guitar, cooking (Japanese food)."},{"spoiler":false,"text":"Favorite food: Ramen (pork noodles), macaroon."},{"spoiler":false,"text":"Favorite artists: Nirvana, Foo Fighters, Sonic Youth, Iggy and The Stooges, The Clash, Patti Smith, Avril Lavigne."},{"spoiler":false,"text":"Recent favorites: Maximum the Hormone and Grizzly Bear."},{"spoiler":false,"text":"Super Sonico was created by the Nitroplus Company in 2007 to be the mascot for their yearly Nitro Super Sonic (NSS) Music Festival held in Japan each year. Since her creation, she has become quite popular and has even starred in her own video game: SoniComi, the PS3/PSV game Motto! SoniComi and the 3DS idol producing game SoniPro. She even starred in her own anime, SoniAni."},{"spoiler":false,"text":"She also a member of band Dai Ichi Uchuu Sokudo and has released several singles and albums."},{"spoiler":false,"text":"From 2011.03.01 till 2011.05.31 Sonico starred in Kimisho as a limited time heroine."},{"spoiler":false,"text":"Profile details translated from her official site."},{"spoiler":false,"text":"Summary from Anime Vice."}],"source":"vndb","sourceCharacterId":"c3643"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/