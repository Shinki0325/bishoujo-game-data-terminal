:"ED曲 「From that day」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:191307","source":"egs"},{"creditedName":"カサンドラ","creatorId":"vndb:s3053","sourcePersonId":"vndb:s3053","canonicalEntityId":"vndb:s3053","name":"カサンドラ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:131726","source":"vndb"},{"creditedName":"カサンドラ","creatorId":"vndb:s3053","sourcePersonId":"vndb:s3053","canonicalEntityId":"vndb:s3053","name":"カサンドラ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:131727","source":"vndb"},{"creditedName":"築山 さえ","creatorId":"vndb:s4165","sourcePersonId":"vndb:s4165","canonicalEntityId":"vndb:s4165","name":"築山 さえ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:131729","source":"vndb"},{"creditedName":"築山 さえ","creatorId":"vndb:s4165","sourcePersonId":"vndb:s4165","canonicalEntityId":"vndb:s4165","name":"築山 さえ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:131730","source":"vndb"},{"creditedName":"文月 きょう","creatorId":"vndb:s9875","sourcePersonId":"vndb:s9875","canonicalEntityId":"vndb:s9875","name":"文月 きょう","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:131733","source":"vndb"},{"creditedName":"Midpine","creatorId":"vndb:s15894","sourcePersonId":"vndb:s15894","canonicalEntityId":"vndb:s15894","name":"Midpine","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:131735","source":"vndb"}]},"cast":[{"characterId":"char_c68899","characterName":"乾 まなみ","sourceIds":{"bangumi":[{"characterId":"45063","match":"exact-normalized-name-in-linked-work","subjectId":"185618"}],"egsCharacterIds":["10342"],"vndbCharacterId":"c68899"},"originalCharacterName":"乾 まなみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公と同い年の幼馴染です。"},{"spoiler":false,"text":"性格はかなり大人しく、人見知りが激しく、そしてかなりの恥ずかしがり屋です。"},{"spoiler":false,"text":"ただし人嫌いではなく、また自分の性格を改善しようと、何とかしてクラスメートたちと仲良くなろうとしています。"},{"spoiler":false,"text":"そのためにどんなふうに話しかけ、どんなふうに会話すればいいか、いろいろとシミュレートしてはいるのですが、しかし今の彼女の性格ではおおよそ悲しい結末しか予想できないため、ズーーーンと落ち込んだり、ほろほろと泣き出すことを繰り返しています。"},{"spoiler":false,"text":"子供の頃から主人公のことを慕っており、彼が初恋です。"},{"spoiler":false,"text":"けれど、その性格から自分の気持ちをまだ告白できていません。"}],"source":"egs","sourceCharacterId":"10342","sourceWorkId":"23858","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同い年の幼なじみ。"},{"spoiler":false,"text":"性格はかなりおとなしく、人見知りが激しく、そしてかなりの恥ずかしがり屋。"},{"spoiler":false,"text":"なんとか性格を改善して、クラスメイトたちと仲良くなろうと努力している。"},{"spoiler":false,"text":"また疎遠になってしまった幼なじみとも、昔のような関係に戻れないか思い悩んでいる。"},{"spoiler":false,"text":"子供の頃から主人公を慕っていて、彼が初恋の相手。"},{"spoiler":false,"text":"しかしその性格から、自分の気持ちをまだ告白できていない。"}],"source":"bangumi","sourceCharacterId":"45063"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/07513ae19ffd83b4165764205e0c66ce92642636c543149ad7b282e8fa898232.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/891094e451fc450f374808c5a29fcf161eb796ce8805de0e614ee189a78f16a9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185618:45063:15637:1","source":"bangumi"}]},{"characterId":"char_c68900","characterName":"呉内 れいこ","sourceIds":{"bangumi":[{"characterId":"45064","match":"exact-normalized-name-in-linked-work","subjectId":"185618"}],"egsCharacterIds":["10343"],"vndbCharacterId":"c68900"},"originalCharacterName":"呉内 れいこ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の従姉です。"},{"spoiler":false,"text":"れいこは主人公の自宅より少し離れたところに住んでいましたが、周囲に遊ぶ者がいないため、彼のところによく遊びに来ていました（その折にまなみ達主人公の幼馴染と知り合っています）。"},{"spoiler":false,"text":"運動神経がよく、子供の頃から男の子のような活発な遊び方をしていたため、小学校の頃までは近所の子供の中でリーダー的な存在でした。"},{"spoiler":false,"text":"その性格は天真爛漫でポジティブなもので、細かいことに拘らないものです。"},{"spoiler":false,"text":"今年の春に引退するまでクラブ中心の学園生活を送っていたためか、浮いた話は一つもありません。"},{"spoiler":false,"text":"そのためにれいこは恋愛と、そしてそれ以上に性的な知識が全くといっていいほどありません。"},{"spoiler":false,"text":"女性的な羞恥心はあるものの、しかしごく親しい男性――主人公にはそれもなくなり、子供の頃同様のスキンシップを行い、彼をパニくらせてしまうことも少なくありません。"}],"source":"egs","sourceCharacterId":"10343","sourceWorkId":"23858","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公より年上の従姉。"},{"spoiler":false,"text":"運動神経が良く、子供の頃は活発に遊び回り近所のリーダー的な存在だった。"},{"spoiler":false,"text":"天真爛漫でポジティブ思考、細かいことにこだわらない性格。"},{"spoiler":false,"text":"部活動中心の学園生活を送り、恋愛や性的な知識には非常に疎い。"},{"spoiler":false,"text":"女性的な羞恥心はあるものの、主人公などの親しい相手にはそれもなくなり、"},{"spoiler":false,"text":"子供の頃と同じようにスキンシップをとって驚かせることも少なくない。"}],"source":"bangumi","sourceCharacterId":"45064"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c66f4fd11fb0538eab0108a4851797be0d829cefa950e3ae317e8c169a43b38b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e8/e8b4db94902cb058e79d789bcfc071c6647f06079339f2711c7289d060797fb1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185618:45064:5936:1","source":"bangumi"}]},{"characterId":"char_c68901","characterName":"門野 つかさ","sourceIds":{"bangumi":[{"characterId":"45065","match":"exact-normalized-name-in-linked-work","subjectId":"185618"}],"egsCharacterIds":["10344"],"vndbCharacterId":"c68901"},"originalCharacterName":"門野 つかさ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公とは同い年の幼馴染です。"},{"spoiler":false,"text":"快活で明るく、さっぱりとした気性の持ち主で、性別関係なく友人が多いタイプです。"},{"spoiler":false,"text":"子供の頃から主人公のことが大好きですが、友達として付き合ってきたため、その思いを告白できていません。"},{"spoiler":false,"text":"また、打ち明けたときに彼が自分のことを好きでなかった場合、当然今の関係が壊れてしまうため、やはり気持ちを告げられずにいます。"},{"spoiler":false,"text":"そんな悩みと自分に対する苛立ち、そして思いを隠そうとするあまり、主人公といっしょにいるとどうにも粗野で不機嫌な態度を取ってしまいます。"}],"source":"egs","sourceCharacterId":"10344","sourceWorkId":"23858","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同い年の幼なじみ。"},{"spoiler":false,"text":"まなみとは対照的に快活で明るく、サッパリした性格で男女問わず友人が多い。"},{"spoiler":false,"text":"子供の頃から主人公のことが好きで、だけど友達だからと告白はできていない。"},{"spoiler":false,"text":"告白して今の関係が壊れてしまうのではないかという恐怖を抱え、"},{"spoiler":false,"text":"主人公への想いを隠そうとし、そんな煮え切らない自分に対する苛立ちからも、"},{"spoiler":false,"text":"つい主人公と一緒にいるとどうにも粗野で不機嫌な態度を取ってしまう。"}],"source":"bangumi","sourceCharacterId":"45065"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7dcf6f195c057982376ce23cc19bf557c7cc72c57cdea58613164097f4f679d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5ae39083d1e769e70623314f4fa9dfd2391f92d694925b6b377f40b9d85111b2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:185618:45065:6351:1","source":"bangumi"}]},{"characterId":"char_c68902","characterName":"杜毬 もも","sourceIds":{"bangumi":[{"characterId":"45066","match":"exact-normalized-name-in-linked-work","subjectId":"185618"}],"egsCharacterIds":["10345"],"vndbCharacterId":"c68902"},"originalCharacterName":"杜毬 もも","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の１つ年下の妹です。"},{"spoiler":false,"text":"頭がよく、年齢以上に大人びて落ち着き、何に対しても動じず、その顔に感情らしいものが表れたことがありません。"},{"spoiler":false,"text":"主人公のことを異性として好きであり、彼の姿を見るだけでものすごく幸せになり、本人いわくしまりがなく、ものすごくたせらしない笑顔を浮かべてしまいます。"},{"spoiler":false,"text":"例えば、物陰からこっそり覗いたり、座っていた椅子に腰掛けて温もりを感じたり、その臭いをかいだり、彼の後に続いて風呂に入って残り香と、残り湯を飲んでみたり、さらに洗濯物の自室に持ち帰ってその臭いを堪能したり、などなど……"},{"spoiler":false,"text":"ただし、そのことを彼に気づかれたら嫌われてしまうと考えており、またその兆候――自分の思いに気づかれてはならないとも考えています。"},{"spoiler":false,"text":"そのため主人公のことを考えるだけでニヘラ～とだらしなく笑うその顔を見せないようにしており、主人公といるときには顔に力をこめて笑わないようにしています。"}],"source":"egs","sourceCharacterId":"10345","sourceWorkId":"23858","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹。"},{"spoiler":false,"text":"頭が良く何事にも動じず、無表情で年齢以上に大人びて見える少女。"},{"spoiler":false,"text":"主人公のことを異性として好きで、姿を見るだけでものすごく幸せになってしまう。"},{"spoiler":false,"text":"本人曰く、ものすごくだらしない笑顔を浮かべてしまうらしい。"},{"spoiler":false,"text":"物陰からこっそり覗いたり、座っていた椅子に腰掛けて温もりを感じたり、"},{"spoiler":false,"text":"その臭いを嗅いだり、続いて風呂に入って残り香と残り湯を味わってみたり……"},{"spoiler":false,"text":"ただし気づかれたら嫌われてしまうと考え、自分の想いもひた隠しにしている。"},{"spoiler":false,"text":"もちろん締まりのない顔は見せないよう、主人公の前では顔に力を込めて笑わないようにしている。"}],"source":"bangumi","sourceCharacterId":"45066"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1c/1cb0f847bb1358a931dc50d4349744c849566a4135eee99ad4d1db773714579a.webp","fallbackUrl":"https