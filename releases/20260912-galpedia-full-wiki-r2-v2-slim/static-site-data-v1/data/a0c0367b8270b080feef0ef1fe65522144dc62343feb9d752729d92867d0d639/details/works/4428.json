{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"4428","model":{"presentationWorkId":"vndb:v6910","staff":{"artwork":[{"creditedName":"丹下ゲンタ(氷雨げんた)","creatorId":"vndb:s4217","sourcePersonId":"egs:creator:1483","canonicalEntityId":"vndb:s4217","name":"丹下ゲンタ(氷雨げんた)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:7087","source":"egs"},{"creditedName":"トシぞー","creatorId":"vndb:s3065","sourcePersonId":"egs:creator:1339","canonicalEntityId":"vndb:s3065","name":"トシぞー","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:7088","source":"egs"}],"scenario":[{"creditedName":"西矢沙広","creatorId":"vndb:s2600","sourcePersonId":"egs:creator:1902","canonicalEntityId":"vndb:s2600","name":"西矢沙広","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:7089","source":"egs"},{"creditedName":"鬼影姚二","creatorId":"vndb:s206","sourcePersonId":"egs:creator:1484","canonicalEntityId":"vndb:s206","name":"鬼影姚二","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:7090","source":"egs"}],"music":[{"creditedName":"m.c.TOM","creatorId":"vndb:s6343","sourcePersonId":"egs:creator:2622","canonicalEntityId":"vndb:s6343","name":"m.c.TOM","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:7906","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c19737","characterName":"久枝 円香","sourceIds":{"bangumi":[{"characterId":"149028","match":"exact-normalized-name-in-linked-work","subjectId":"230364"}],"egsCharacterIds":["26893"],"vndbCharacterId":"c19737"},"originalCharacterName":"久枝 円香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"フェンシング部に所属する、自信家でプライドの高い女の子。"},{"spoiler":false,"text":"お嬢様を絵に描いたような容姿で、絶滅種と危惧される縦巻きロールな髪型がチャームポイント。"},{"spoiler":false,"text":"資産家の彼女が、部のトレーニング設備を貸与して提供しているため、将来を見据え、器具の購入を希望。"}],"source":"egs","sourceCharacterId":"26893","sourceWorkId":"4428","spoiler":false},{"segments":[{"spoiler":false,"text":"紅花学園３年生。フェンシング部所属。"},{"spoiler":false,"text":"いわゆるお嬢様を絵に描いたような容姿の持ち主で、今時レアな縦まきロール。自信家でプライドも高く、それを支えるだけの実力も持っている。フェンシング個人戦全国大会優勝の実力者で、部員からも信頼を集めている。剣道部の朝比奈を永遠のライバルと（一方的に）認めている。"},{"spoiler":false,"text":"古きよき鍛錬方法を取り入れている剣道部とは対照的に、フェンシング部は、近代的トレーニング方法を多く取り入れ、その結果着実に成績を伸ばしてきた。その成果が、全国大会優勝へと現れている。鍛錬やその他考え方の相違で、よく朝比奈とはぶつかる。彼女の家が資産家のため、近代トレーニング設備を貸与というカタチで部に提供しているが、将来的なことを考えて、部で器具を購入したいというのが、フェンシング部の願いである。"}],"source":"bangumi","sourceCharacterId":"149028"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70634dc00093eaa5bb1368ea0b975aea6a7b9a476be8e6b6a63d616b5a2a740d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a0/a01af4e1ecafb2c2d2811b60ade187db00f23b26ff4c24cc29a549e0518b2053.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230364:149028:4799:1","source":"bangumi"}]},{"characterId":"char_c19738","characterName":"小野　美貴","sourceIds":{"bangumi":[{"characterId":"149024","match":"exact-normalized-name-in-linked-work","subjectId":"230364"}],"egsCharacterIds":["26889"],"vndbCharacterId":"c19738"},"originalCharacterName":"小野　美貴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"チアリーディング部に所属する、主人公の年下の幼馴染。"},{"spoiler":false,"text":"童顔で身体も小さいが、オッパイはなかなか。"},{"spoiler":false,"text":"その可愛らしい容姿から、チアリーディング部ではマスコット的な存在。"}],"source":"egs","sourceCharacterId":"26889","sourceWorkId":"4428","spoiler":false},{"segments":[{"spoiler":false,"text":"紅花学園１年生で、主人公の後輩。"},{"spoiler":false,"text":"主人公の近所に住んでいて、未和と共にいつも一緒に居る幼馴染み。主人公を「せんぱい、せんぱい」と呼んで慕っている。童顔で身体も小さめだが、胸の辺りはなかなかに成長しているようだ。可愛らしい容姿と性格で、チアリーディング部のマスコット的存在に収まっている。"},{"spoiler":false,"text":"主人公と末和と美貴、いつも一緒にいるのが当たり前だった毎日の中で、主人公への想いを次第に自覚していった美貴。今の温かい関係を壊すのも怖くて、踏み出せなかった美貴にとって、今回のことは大きな転機となる可能性を持っていた。果たして美貴の想いは、どのような結果を迎えるのだろうか？"}],"source":"bangumi","sourceCharacterId":"149024"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f258ebb9578e4930ad38ffe16df0467cef78c40477fd1aa19b266e3837170047.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad090948cb039323877f393c651a1a4f4311ad4c17790bcb1a6c54827fdde9fd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230364:149024:4830:1","source":"bangumi"}]},{"characterId":"char_c19739","characterName":"丘信 沙希","sourceIds":{"bangumi":[{"characterId":"149023","match":"exact-normalized-name-in-linked-work","subjectId":"230364"}],"egsCharacterIds":["26888"],"vndbCharacterId":"c19739"},"originalCharacterName":"丘信 沙希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"陸上部に所属する、誰にでも丁寧に話すクセのある女の子。"},{"spoiler":false,"text":"県大会の上位に名を連ねるものの、全国大会では今一つの成績なことから、トレーニング施設の拡充を希望。"}],"source":"egs","sourceCharacterId":"26888","sourceWorkId":"4428","spoiler":false},{"segments":[{"spoiler":false,"text":"紅花学園２年生。陸上部所属。"},{"spoiler":false,"text":"陸上選手としては平凡ながら、部活に傾ける情熱はなかなかのもの。主人公のクラスメートながら、今までに会話をしたことはなかったが、話してみれば付き合いやすい性格のようだ。誰に対しても丁寧な言葉で話すというクセ（？）を持っている。交渉役に選ばれた沙希は、主人公と交流を深めてゆくのだが……。県大会の上位に名を連ねる陸上部だが、全国大会では今一つの成績。更なる飛躍を求めて、トレーニング施設の拡充を目指している。"}],"source":"bangumi","sourceCharacterId":"149023"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/0148dd420d4cceed0b908227feb3f0b4c16394693dcc3fb85084f01c2d63a966.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a0d7647deb3910674595851d486d45ab4daa700cf822cecd5cc198accb6fb1b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"川瀬ゆづき","creatorId":"vndb:s3658","sourcePersonId":"vndb:s3658","canonicalEntityId":"vndb:s3658","name":"川瀬 ゆづき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230364:149023:25163:1","source":"bangumi"}]},{"characterId":"char_c19740","characterName":"千川　芽衣","sourceIds":{"bangumi":[{"characterId":"149029","match":"exact-normalized-name-in-linked-work","subjectId":"230364"}],"egsCharacterIds":["26894"],"vndbCharacterId":"c19740"},"originalCharacterName":"千川　芽衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"茶道部に所属する、物腰柔らかく、常に柔和な笑顔を絶やさない女の子。"},{"spoiler":false,"text":"彼女の力なのか、ここ数年は充実した資金を得ているものの、さらに専用の茶室を希望。"}],"source":"egs","sourceCharacterId":"26894","sourceWorkId":"4428","spoiler":false},{"segments":[{"spoiler":false,"text":"紅花学園３年生。茶道部所属。"},{"spoiler":false,"text":"物腰柔らかく、柔和な笑顔を絶やさない美人。ただし、その瞳の奥に、時折鋭い光が走るとか走らないとか……。言葉使いや態度が柔らかいのに、気付いてみれば話の主導権を奪われていることもしばしば。どうやら、かなりの策士らしいが……？茶道部はこれといった成績を残していないものの、ここ数年は規模の割に充実した資金を得ているらしい。今年は、中庭の芸術棟に専用の茶室を作るつもりらしい。"}],"source":"bangumi","sourceCharacterId":"149029"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cd/cd98ffef1ec7fbba423a243ece2af07b75e004e595e1e5cae317791ecfce87c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72745e47640de80ddd809b3a05d1ea1a66f2484a8131db1f94ab9b79ca21c050.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"ももぞの薫","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230364:149029:6131:1","source":"bangumi"}]},{"characterId":"char_c19741","characterName":"朝比奈 優希","sourceIds":{"bangumi":[{"characterId":"149027","match":"exact-normalized-name-in-linked-work","subjectId":"230364"}],"egsCharacterIds":["26892"],"vndbCharacterId":"c19741"},"originalCharacterName":"朝比奈 優希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"剣道部に所属する、武士然とした凛々しい女の子。"},{"spoiler":false,"text":"頑固一徹で、自分に厳しく、他人にも厳しい性格。"},{"spoiler":false,"text":"自分の性格から大会等で迷惑をかけていることから、自ら交渉役を買って出た。"}],"source":"egs","sourceCharacterId":"26892","sourceWorkId":"4428","spoiler":false},{"segments":[{"spoiler":false,"text":"紅花学園３年生。剣道部所属。"},{"spoiler":false,"text":"自分に厳しく、他人にも厳しい性格。武士然とした、凛とした美人。性格が悪い訳ではないのだが、頑固そうで冗談が通じない雰囲気。実家が古流剣術の道場で、本人も幼い頃からそれを叩き込まれて育つ。そのため、現行の剣道では頭の固い審判に反則をとられてしまう技をついつい使ってしまうため、いいところで反則負けになることが多い。"},{"spoiler":false,"text":"類稀な運動神経と集中力が災いして、中途半端に手を抜くことが出来ない。部員からは信頼されているが、部に迷惑をかけていることに必要以上に責任を感じてしまい、予算交渉と伝統の内容を知って、役に立ちたい思いで自ら交渉役として『犠牲』になることを願い出た。"}],"source":"bangumi","sourceCharacterId":"149027"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/71a6bcab9a945f96eda4bcff6dfe994fb7315b7ce787c235fd4263e5a6817033.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f50ca238ea3487064502771ac7cfd46b8f210fbbecfc603bc0af3e1133a2ed6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"坂田有希","creatorId":"vndb:s1595","sourcePersonId":"vndb:s1595","canonicalEntityId":"vndb:s1595","name":"坂田 有希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230364:149027:15687:1","source":"bangumi"}]},{"characterId":"char_c19743","characterName":"多山　末和","sourceIds":{"bangumi":[{"characterId":"149021","match":"exact-normalized-name-in-linked-work","subjectId":"230364"}],"egsCharacterIds":["26886"],"vndbCharacterId":"c19743"},"originalCharacterName":"多山　末和","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ソフトボール部に所属する、明朗快活でさっぱりとした感じの女の子。"},{"spoiler":false,"text":"主人公に想いを寄せており、他の部活の面々が主人公にご奉仕接待をしようとすると妨害工作をすることも……。"},{"spoiler":false,"text":"全国まであと一歩手が届かないことから、夜間練習のための照明施設設置を希望。"}],"source":"egs","sourceCharacterId":"26886","sourceWorkId":"4428","spoiler":false},{"segments":[{"spoiler":false,"text":"紅花学園２年生で、主人公の幼馴染。"},{"spoiler":false,"text":"ソフトボール部所属のレギュラー、６番ショート。明るく活動的な容姿と、さっぱりした性格で気軽に話せる女の子としてクラスメートの中では人気がある。主人公に密かな想いを寄せているが、今の関係以上に"},{"spoiler":false,"text":"なかなか発展させられないでいる。しかし、主人公が査察員として各部の女の子に言い寄られていることを察し、怒りとも焦りともとれる感情を抱く。"},{"spoiler":false,"text":"時として、他の部員の『おねだり』に妨害工作をすることも……。チアリーディング部の美貴とは仲が良く、妹のように思っている。県大会上位でありながらも、全国まであと一歩手が届かないソフトボール部は、"},{"spoiler":false,"text":"夜間練習のための照明施設設置を希望している。……とは言っているが、主人公の邪魔をするための方便という噂もある。"}],"source":"bangumi","sourceCharacterId":"149021"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b777785e3badb2257ceb2e62b3f2509882e0f70f163470cd60caa57053066069.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da944b21b081e37522042647d4e7b74dd96725ac4bce587799980b52861ab63d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230364:149021:4799:1","source":"bangumi"}]},{"characterId":"char_c19744","characterName":"川本　喜久子","sourceIds":{"bangumi":[{"characterId":"149032","match":"exact-normalized-name-in-linked-work","subjectId":"230364"}],"egsCharacterIds":["26897"],"vndbCharacterId":"c19744"},"originalCharacterName":"川本　喜久子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アニメ研究会に所属する、三つ編みおさげの眼鏡ッ娘。"},{"spoiler":false,"text":"普段はあまり多くを話さない彼女だが、アニメや自分の興味のある話題になると、いきなり饒舌になる。"},{"spoiler":false,"text":"部室に大型プロジェクターの設置を希望。"}],"source":"egs","sourceCharacterId":"26897","sourceWorkId":"4428","spoiler":false},{"segments":[{"spoiler":false,"text":"紅花学園２年生。アニメ研究会所属。"},{"spoiler":false,"text":"３つ編みおさげのメガネ少女。普段はうつむきがちだが、アニメの話や自分の興味がある話になると饒舌になる。サバイバル研究会の田森　圭とは、衣装を作ったり映画の演出の話題で論議したりと何かと交流がある。部室で大型プロジェクターで大撮影会を開けたら、これ以上ない幸せとなるだろう。"}],"source":"bangumi","sourceCharacterId":"149032"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/85/854be68f0ca36cbfc5bb86006d632103e131e2014582da909d85ccb4cf52dc0b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec4fe8c3d86a68c6db4c86e02cda9d45daf3bbff562b27ad8757d351f0417a22.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230364:149032:4956:1","source":"bangumi"}]},{"characterId":"char_c19745","characterName":"真行寺　知佳","sourceIds":{"bangumi":[{"characterId":"149030","match":"exact-normalized-name-in-linked-work","subjectId":"230364"}],"egsCharacterIds":["26895"],"vndbCharacterId":"c19745"},"originalCharacterName":"真行寺　知佳","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"科学部に所属する、ナイスバディとロリバディの2つの肉体を併せ持つ奇妙奇天烈な女の子。"},{"spoiler":false,"text":"自分専用のラボ（研究室）を所望し、予算の大幅アップを希望。"}],"source":"egs","sourceCharacterId":"26895","sourceWorkId":"4428","spoiler":false},{"segments":[{"spoiler":false,"text":"紅花学園３年生。科学部所属。"},{"spoiler":false,"text":"時にはナイスボディのおねーさま、時には純真無垢な（あくまで外見のみ）のロリロリボディの少女と、２種類の身体を併せ持つ奇跡の女。"},{"spoiler":false,"text":"本人曰く、科学の力らしいが、部室を覗けばどう見てもオカルトが混じっている。享楽的な性格で、主人公を体のいいオモチャとして認識したのか、『少年』と呼んでは色々なちょっかいをかけてくる。"},{"spoiler":false,"text":"だが、面倒見の良い所もあるので、分からないことなどを教えてくれるかもしれない。予算をせしめて、自分専用の研究室を作ろうと画策しているらしいが、果たしてその試みは成功するのか？"}],"source":"bangumi","sourceCharacterId":"149030"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e78faa8b4d5a916d924241f8eedf1f02c949ab0122565a3df72e93b72da0265a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fddfb44f014eca3380c24c1111d977a79cd1fd57f8773efc5ba614725154a1c0.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c19746","characterName":"田村　由香里","sourceIds":{"bangumi":[{"characterId":"149026","match":"exact-normalized-name-in-linked-work","subjectId":"230364"}],"egsCharacterIds":["26891"],"vndbCharacterId":"c19746"},"originalCharacterName":"田村　由香里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"新体操部に所属する、真面目でちょっと男性不信気味の女の子。"},{"spoiler":false,"text":"予算の追加申請で、有能なコーチの招聘を希望。"}],"source":"egs","sourceCharacterId":"26891","sourceWorkId":"4428","spoiler":false},{"segments":[{"spoiler":false,"text":"紅花学園３年生。新体操部所属。"},{"spoiler":false,"text":"ちょっときつい感じがするが、顔立ちは美人。新体操に対しては真面目だが、決して堅物ではない。胸がやや慎ましい感じだが、本人が気にしているかは謎。新体操の演技の上で、技術以外に重要な何かが欠けていることを感じ、演技向上に限界を覚えている。"},{"spoiler":false,"text":"友人は男っ気のない彼女に、『彼氏でも作れば、気分転換にもなって"},{"spoiler":false,"text":"いいんじゃないの？』と勧めるが、彼女自身が軽い男性不信に陥っているため、その気は全く無いらしい。予算の追加申請で、有能なコーチを呼ぶことを切望しているが……？"}],"source":"bangumi","sourceCharacterId":"149026"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/952effb3b79d538407b728461d95e4635c55f6cdbf5fdfb277568fad2b1f0055.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e3f1f272ba99d1ca91661b3c10183c0e43571b59ebca401f5ccecdc8f3356fb4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"川瀬ゆづき","creatorId":"vndb:s3658","sourcePersonId":"vndb:s3658","canonicalEntityId":"vndb:s3658","name":"川瀬 ゆづき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230364:149026:25163:1","source":"bangumi"}]},{"characterId":"char_c19747","characterName":"甲院　歩","sourceIds":{"bangumi":[{"characterId":"149031","match":"exact-normalized-name-in-linked-work","subjectId":"230364"}],"egsCharacterIds":["26896"],"vndbCharacterId":"c19747"},"originalCharacterName":"甲院　歩","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"応援団に所属する、男の子になりたい症候群のちびっちゃい女の子。"},{"spoiler":false,"text":"部室の新設のため予算を求めているが、彼女が交渉役となったことが、吉と出るか凶と出るか……。"}],"source":"egs","sourceCharacterId":"26896","sourceWorkId":"4428","spoiler":false},{"segments":[{"spoiler":false,"text":"紅花学園１年生。応援団所属。"},{"spoiler":false,"text":"男むさい応援団に混じった異物、ちまい身なりの可愛らしい少女。ただし、本人は『男の子』になりたくて必死らしい。どうひいき目に見ても、背伸びした少年にしか見えないのはご愛嬌。『男を見せる』ために交渉役に名乗り出たが、主人公にはからかわれて遊ばれてしまう始末。"},{"spoiler":false,"text":"応援団の部室を新設するために予算を求めているが、歩に任せて大丈夫かは定かではない。"}],"source":"bangumi","sourceCharacterId":"149031"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83c27d4374f81ef01497ee254b943454416692625d287503782a4ec67d9e63e4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c867bc6d1a57a250be78734f7ca9d9b843edfff9b99148b77bf4e6b915b7bd70.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"坂田有希","creatorId":"vndb:s1595","sourcePersonId":"vndb:s1595","canonicalEntityId":"vndb:s1595","name":"坂田 有希","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230364:149031:15687:1","source":"bangumi"}]},{"characterId":"char_c19748","characterName":"原 澄夏","sourceIds":{"bangumi":[{"characterId":"149022","match":"exact-normalized-name-in-linked-work","subjectId":"230364"}],"egsCharacterIds":["26887"],"vndbCharacterId":"c19748"},"originalCharacterName":"原 澄夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"水泳部に所属する、ふんわりほわほわした穏やかな雰囲気を持った女の子。"},{"spoiler":false,"text":"弱小の部類に入る水泳部の梃入れすべく、冬季練習のため市営の温水プールのフリーパスと、競泳用の水着を希望。"}],"source":"egs","sourceCharacterId":"26887","sourceWorkId":"4428","spoiler":false},{"segments":[{"spoiler":false,"text":"紅花学園１年生。水泳部所属。"},{"spoiler":false,"text":"無口で大人しく、穏やかで暖かい雰囲気を持った少女。ふんわりほわほわ。言葉が拙いのを本人も知っているため、意思を伝える手段は表情や仕草が主になっている。そのため、表情はころころと変わる。何となく勢いで主人公と一次接触したあと、次第に好意を覚えていく。弱小の部類に入る水泳部は、冬季練習のための市内温水プールのフリーパスと、専用競泳水着の購入という慎ましい申請を出している。"}],"source":"bangumi","sourceCharacterId":"149022"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c956ba300758cb235afbec1583e5035aeb0cd83879fcf03d2a941aa825c87ff.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2dd9c06d1686ef6c5f4305f838131d9fc76c716b3991d2cd29d999112364d7f5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"壱智村小真","creatorId":"vndb:s364","sourcePersonId":"vndb:s364","canonicalEntityId":"vndb:s364","name":"壱智村 小真","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230364:149022:4830:1","source":"bangumi"}]},{"characterId":"char_c19749","characterName":"半沢 百合","sourceIds":{"bangumi":[{"characterId":"149025","match":"exact-normalized-name-in-linked-work","subjectId":"230364"}],"egsCharacterIds":["26890"],"vndbCharacterId":"c19749"},"originalCharacterName":"半沢 百合","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"バレー部に所属する、おっとりした面倒見の良い女の子。"},{"spoiler":false,"text":"全国大会常連であるバレー部は部費的に恵まれているものの、専用体育館増設の積み立て資金上乗せを希望。"}],"source":"egs","sourceCharacterId":"26890","sourceWorkId":"4428","spoiler":false},{"segments":[{"spoiler":false,"text":"紅花学園２年生、バレー部所属。"},{"spoiler":false,"text":"主人公が１年生の時のクラスメート。身長に恵まれている彼女は、バレー部の中でも有望な選手だが、本人自体は、身長が大きいことを微妙にコンプレックスに感じており、大きくてウスノロと言われるのを恐れている。そのことを意識しないように性格矯正もかねてバレー部で熱心な練習に励むが、まだ男子学生に不意に話し掛けられると慌ててどもることもしばしば。"},{"spoiler":false,"text":"元々の性格はおっとりとして面倒見がいいため、後輩の女子からはお姉さんのように慕われることが多い。全国大会常連バレー部の、専用体育館増設のための年度ごとの積み立て資金上乗せのための交渉役候補のうちの一人として選ばれ、主人公と知り合いというのが決め手となり、正式に交渉役に収まった。"}],"source":"bangumi","sourceCharacterId":"149025"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96a9258285af68e7ab93d44ea357d3d4ca4d38776b2384232093571b5a590021.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f894aaab8cdedd81ce5ec6081e76136e7446948f8dfd1ad76ef708607fe087f2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:230364:149025:4956:1","source":"bangumi"}]},{"characterId":"char_vndb_c105315","characterName":"三嶋 誠哉","sourceIds":{"vndbCharacterId":"c105315"},"originalCharacterName":"三嶋 誠哉","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p339","sourceCompanyId":"egs:brand:557","canonicalEntityId":"vndb:p339","name":"West Vision","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:4428:557","source":"egs"},{"companyId":"vndb:p339","sourceCompanyId":"vndb:p339","canonicalEntityId":"vndb:p339","name":"ウェストビジョン","roleCodes