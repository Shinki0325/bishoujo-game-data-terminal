s","sourceCharacterId":"5182","sourceWorkId":"17485","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の住む陣富荘（じんぷそう）の管理人。"},{"spoiler":false,"text":"穏やかでおっとりした性格。 スタイルが良く、胸が大きい。"},{"spoiler":false,"text":"住人のことを大切にしている、よき理解者。"},{"spoiler":false,"text":"主人公と綾乃の同居を知るも、綾乃の礼儀正しさと主人公の普段の素行の良さから見逃してくれる。"},{"spoiler":false,"text":"「いってらっしゃい。松上さん。お気をつけて」"}],"source":"bangumi","sourceCharacterId":"26030"}],"profileFacts":[{"label":"胸围（本版本）","value":"93 cm","valueContext":null,"source":"egs","sourceCharacterId":"5182","sourceWorkId":"17485","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"5182","sourceWorkId":"17485","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"159 cm","valueContext":null,"source":"egs","sourceCharacterId":"5182","sourceWorkId":"17485","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"5182","sourceWorkId":"17485","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"5182","sourceWorkId":"17485","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0ad6ebd95e6ddb4a094f5c0f2649dceaa55dd60f49382f630f38af71933cff70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/01/01beab4317a51b4372b78aa80af728392eb7d21d0db3ace2a9bea44e696f959f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡嶋妙","creatorId":"vndb:s359","sourcePersonId":"vndb:s359","canonicalEntityId":"vndb:s359","name":"岡嶋 妙","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:46870:26030:4646:1","source":"bangumi"}]},{"characterId":"char_c10371","characterName":"美萩野 小乃花","sourceIds":{"bangumi":[{"characterId":"26031","match":"exact-normalized-name-in-linked-work","subjectId":"46870"}],"egsCharacterIds":["5183"],"vndbCharacterId":"c10371"},"originalCharacterName":"美萩野 小乃花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"154"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ayano's sister who is 3 years younger than her. Mischievous, energetic and a cheerful girl who likes her sister very much. Because she's interested in Haruto, she moves in with him and Ayano. She loves to teasing Ayano and making her jealous."}],"source":"vndb","sourceCharacterId":"c10371"},{"segments":[{"spoiler":false,"text":"知徳学院中等院"},{"spoiler":false,"text":"綾乃の妹。"},{"spoiler":false,"text":"天真爛漫で明るい性格、好奇心が旺盛。"},{"spoiler":false,"text":"姉の卒業旅行というのがどうも怪しいので尾行し、主人公のアパートに入っていくところを目撃。"},{"spoiler":false,"text":"姉がそこまで好きになった人というのが気になり、ちょうど春休みなので純粋に興味本位で主人公宅に居座る。"},{"spoiler":false,"text":"姉の反応が面白いので主人公にちょっかいを出してからかう。"},{"spoiler":false,"text":"「ふふ、お兄さん、なかなか見る目がありますよ」"}],"source":"egs","sourceCharacterId":"5183","sourceWorkId":"17485","spoiler":false},{"segments":[{"spoiler":false,"text":"綾乃とは3つ違いの妹。"},{"spoiler":false,"text":"いたずらっ子で、姉のことが大好きな元気で明るい女の子。"},{"spoiler":false,"text":"綾乃が主人公の家へ行く時に、面白そうという理由で後をつけて来た。"},{"spoiler":false,"text":"主人公のことを気に入り、何かにつけては遊びに来る。"},{"spoiler":false,"text":"ヤキモチを焼く綾乃や動揺する遥人をからかって楽しんでいる。"},{"spoiler":false,"text":"「ふふ、お兄さん、なかなか見る目がありますよ」"}],"source":"bangumi","sourceCharacterId":"26031"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"5183","sourceWorkId":"