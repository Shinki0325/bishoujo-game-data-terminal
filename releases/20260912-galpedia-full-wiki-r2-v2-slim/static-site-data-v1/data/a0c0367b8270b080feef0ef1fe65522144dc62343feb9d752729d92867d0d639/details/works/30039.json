rce":"bangumi"}]},{"characterId":"char_c93085","characterName":"丹羽 風薫","sourceIds":{"bangumi":[{"characterId":"85998","match":"exact-normalized-name-in-linked-work","subjectId":"309299"}],"egsCharacterIds":["22975"],"vndbCharacterId":"c93085"},"originalCharacterName":"丹羽 風薫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"208"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"おっぱいばいんばいんのメイドさん。"},{"spoiler":false,"text":"あいるが生まれてる前から水無月家に仕えている。"},{"spoiler":false,"text":"あいるや頼斗をついついからかっちゃうおちゃめな先輩。"},{"spoiler":false,"text":"あいるは甘いがきちんと叱るのであいるに気に入られておりお姉さん的存在。"},{"spoiler":false,"text":"妖怪の力は制御できておりあいるとは違い感情に左右されない。"}],"source":"egs","sourceCharacterId":"22975","sourceWorkId":"30039","spoiler":false},{"segments":[{"spoiler":false,"text":"おっぱいばいんばいんのメイドさん。あいるが生まれる前から水無月家に仕えている。あいるや頼斗をついついからかっちゃうおちゃめな先輩。あいるには甘いがきちんと叱るのであいるに気に入られているお姉さん的存在。妖怪の力は制御できておりあいるとは違い感情に左右されない。"}],"source":"bangumi","sourceCharacterId":"85998"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65ef71e4f9b06e1a277a1a210c25e73a48bf9254f1a9f98bc89c73ee751acd68.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1b3a4ce9df384ba35f56a18f7f135067d4b4d27f8a4467e0f4292a46f53c6ab4.webp","width":160,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:309299:85998:15637:1","source":"bangumi"}]},{"characterId":"char_c93086","characterName":"天道寺 紗愛耶","sourceIds":{"bangumi":[{"characterId":"86000","match":"exact-normalized-name-in-linked-work","subjectId":"309299"}],"egsCharacterIds":["22977"],"vndbCharacterId":"c93086"},"originalCharacterName":"天道寺 紗愛耶","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"701"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"あいるの友達。"},{"spoiler":false,"text":"自分の執事の事が好きなあいるの友達。"},{"spoiler":false,"text":"あいるとは違い感情だけで生きているので喜怒哀楽が激しい。"},{"spoiler":false,"text":"お嬢様とはこうあるべきと「ですの」「ますの」「ですわ」を付けようとするがよくに忘れる。"},{"spoiler":false,"text":"アンチ巨乳、自分にないものが憎い！だからのんのおっぱいをわしづかみによくする。"}],"source":"egs","sourceCharacterId":"22977","sourceWorkId":"30039","spoiler":false},{"segments":[{"spoiler":false,"text":"あいるの友達。自分の執事の事が好きなあいるの友達。あいるとは違い感情だけで生きているので喜怒哀楽が激しい。お嬢様とはこうあるべきと語尾に「ですの」「ますの」「ですわ」を付けようとするがよくに忘れる。アンチ巨乳、自分にないものが憎い！だからのんのおっぱいをわしづかみによくする。"}],"source":"bangumi","sourceCharacterId":"86000"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/550782cfa33915380ef1fc84432ab795b6f579c2d4512026d75e0565303ebdf4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7facd22c8aa5068f145458190aa1850151b581c9b18f567fd7c3888901631ce.webp","width":117,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野々原 まどか","creatorId":"vndb:s9112","sourcePersonId":"vndb:s9112","canonicalEntityId":"vndb:s9112","name":"野々原まどか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85762","source":"vndb"}]},{"characterId":"char_c93087","characterName":"春夏秋冬 のん","sourceIds":{"bangumi":[{"characterId":"85999","match":"exact-normalized-name-in-linked-work","subjectId":"309299"}],"egsCharacterIds":["22976"],"vndbCharacterId":"c93087"},"originalCharacterName":"春夏秋冬 のん","characterNameSource":null,"role":"side","status":"