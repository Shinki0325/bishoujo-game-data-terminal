"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e9c23be46ed94d9e6802cdbfe9350bc5cf132378587d903f1d212598bf31280.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48d3ff0742b23524b4410a467d966a0960c3499b1578713283b2044512c89971.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:58561:20278:5075:1","source":"bangumi"}]},{"characterId":"char_c17105","characterName":"剣咲 ノエル","sourceIds":{"bangumi":[{"characterId":"20277","match":"exact-normalized-name-in-linked-work","subjectId":"58561"}],"egsCharacterIds":["340"],"vndbCharacterId":"c17105"},"originalCharacterName":"剣咲 ノエル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"赫をご主人と呼ぶベオウルフの“幻ビト＜イデア＞”。"},{"spoiler":false,"text":"彼とは対照的に人間の文化にも精通しており、裏社会への顔も広い。"},{"spoiler":false,"text":"無気力で大雑把。退廃的な雰囲気を漂わせている。"},{"spoiler":false,"text":"基本的に静止している時間が最大の幸せであり、やるべき事は手短に終わらせる手際の良さも備えている。"},{"spoiler":false,"text":"極度の面倒臭がりだが、赫の事となると異常な行動力を見せる。"},{"spoiler":false,"text":"学生として学ぶのも全ては主人のため。"},{"spoiler":false,"text":"時に浮気を疑い、人を雇って赫本人を拷問させるなど執着心は計り知れないが、"},{"spoiler":false,"text":"全ては赫を想う一途な気持ちの表れ。"},{"spoiler":false,"text":"ちなみに赫の浮気はほぼ全てノエルの勘違いである。"},{"spoiler":false,"text":"「私がご主人を疑うわけないじゃないですか。もし仮に疑いを持ったとしても、私に咎める権利はないですよ」"}],"source":"egs","sourceCharacterId":"340","sourceWorkId":"18025","spoiler":false},{"segments":[{"spoiler":false,"text":"【メイドインラブ】"},{"spoiler":false,"text":"赫をご主人と呼ぶベオウルフの“幻ビト＜イデア＞”。"},{"spoiler":false,"text":"彼とは対照的に人間の文化にも精通しており、裏社会への顔も広い。"},{"spoiler":false,"text":"無気力で大雑把。退廃的な雰囲気を漂わせている。"},{"spoiler":false,"text":"基本的に静止している時間が最大の幸せであり、やるべき事は手短に終わらせる手際の良さも備えている。"},{"spoiler":false,"text":"極度の面倒臭がりだが、赫の事となると異常な行動力を見せる。"},{"spoiler":false,"text":"学生として学ぶのも全ては主人のため。"},{"spoiler":false,"text":"時に浮気を疑い、人を雇って赫本人を拷問させるなど執着心は計り知れないが、"},{"spoiler":false,"text":"全ては赫を想う一途な気持ちの表れ。"},{"spoiler":false,"text":"ちなみに赫の浮気はほぼ全てノエルの勘違いである。"}],"source":"bangumi","sourceCharacterId":"20277"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/168e71528e0d8a6349b036212e998c4ca00ec310929137f2c20b609d9ce4737d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f1/f10ebb0e8989c0175130a568efe33465fcc90cb7913c62e484af6005cdab7bf2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:58561:20277:5922:1","source":"bangumi"}]},{"characterId":"char_c17106","characterName":"紫護 リノン","sourceIds":{"bangumi":[{"characterId":"20276","match":"exact-normalized-name-in-linked-work","subjectId":"58561"}],"egsCharacterIds":["339"],"vndbCharacterId":"c17106"},"originalCharacterName":"紫護 リノン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ケルベロスの化身。“幻ビト＜イデア＞”。"},{"spoiler":false,"text":"“Re:non”として活躍する“AS＜アーカイブスクエア＞”の看板アイドル。"},{"spoiler":false,"text":"現在、最もブレイクしているアイドルで、コンビニの雑誌の表紙を独占している。"},{"spoiler":false,"text":"昼は挑発的な笑みで世界中の男を魅了し、夜は“現ビト＜イデア＞”としての貌を持つ。"},{"spoiler":false,"text":"“稀ビト＜フール＞”を捕獲・研究する特殊組織に属し、戦闘面においても非常に優秀。"},{"spoiler":false,"text":"どちらも本業だが、どちらも目的の為に利用しているに過ぎない。"},{"spoiler":false,"text":"あらゆる