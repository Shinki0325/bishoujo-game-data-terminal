leCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:103317","source":"vndb"},{"creditedName":"あきら","creatorId":"vndb:s7579","sourcePersonId":"vndb:s7579","canonicalEntityId":"vndb:s7579","name":"ありか","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:103319","source":"vndb"},{"creditedName":"カンキセン","creatorId":"vndb:s15531","sourcePersonId":"vndb:s15531","canonicalEntityId":"vndb:s15531","name":"カンキセン","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:103321","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c106114","characterName":"池上 辰彦","sourceIds":{"vndbCharacterId":"c106114"},"originalCharacterName":"池上 辰彦","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tatsuhiko decides to return to his hometown in search of the source of a mysterious stone that came into his possession. One of the villagers, Yuuka, tells Tatsuhiko an old tale about a Yuki-Onna's daughter which was trapped somewhere in the area. Whilst only half-believing that story, he starts exploring and one night he comes across a girl named Miyuki, who is a Yuki-Onna's daughter."},{"spoiler":false,"text":"Translated from official website."}],"source":"vndb","sourceCharacterId":"c106114"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]},{"characterId":"char_vndb_c106115","characterName":"水雪","sourceIds":{"vndbCharacterId":"c106115"},"originalCharacterName":"水雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A long time ago, there was a tale of the daughter of a Yuki-Onna, who fascinated the men in the village and did awful things. Lately she had escaped from the place where she was trapped, by taking advantage of the protagonist, who knew almost nothing about her. Once out Miyuki starts exacting vengeance upon the villagers who had previously imprisoned her. Contrary to her beauty, she is willing to stain herself with their blood. No one knows what Miyuki is really thinking, as she wears the same sneer on her face at all times. Can the protagonist possibly stop her?"},{"spoiler":false,"text":"Translated from official website."}],"source":"vndb","sourceCharacterId":"c106115"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a42b0fafca547d8e8955f4e14696e55b40bd3facc1801cd12d84dc6b90b7cafd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bc847ea39f2cbb11e8f320f8904388167c6d5747c08fb05bb268476947a6ee8e.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c106116","characterName":"宮坂 優香","sourceIds":{"vndbCharacterId":"c106116"},"originalCharacterName":"宮坂 優香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e544de4ad65e33654e4ae9e55c4a344901529a765b2d28d3b5ffc7358b77b56.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b1cf9c8d210470e66fa50f7038ca06b180bfe6f78f90bb02a4c5c3b1ece66dd.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c106117","characterName":"宮坂 凪","sourceIds":{"vndbCharacterId":"c106117"},"originalCharacterName":"宮坂 凪","characterNameSource":n