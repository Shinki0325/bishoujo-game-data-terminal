4862","name":"こごめ さくら","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:136650","source":"vndb"},{"creditedName":"こごめ さくら","creatorId":"vndb:s4862","sourcePersonId":"vndb:s4862","canonicalEntityId":"vndb:s4862","name":"こごめ さくら","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:136651","source":"vndb"}]},"cast":[{"characterId":"char_c69127","characterName":"どれみ","sourceIds":{"bangumi":[{"characterId":"47772","match":"exact-normalized-name-in-linked-work","subjectId":"196254"}],"egsCharacterIds":["13677"],"vndbCharacterId":"c69127"},"originalCharacterName":"どれみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"両親が離婚し母子家庭で育つが、父親のことを親として愛している。"},{"spoiler":false,"text":"大好きな父親につけられた名前を良くからかわれ、仕事を押しつけられるようになっていく。"},{"spoiler":false,"text":"母親に看護師の仕事を聞かされ、献身的な気持ちが身についている。"},{"spoiler":false,"text":"父親が子供っぽい男だったためか、大変に母性が強く、男性を甘やかそうとする。"},{"spoiler":false,"text":"真面目で目立たないが、街で私服のどれみとすれちがう男子は、ドキッとする。"},{"spoiler":false,"text":"自分の気持ちよさよりも、相手の気持ちよさが大事"}],"source":"egs","sourceCharacterId":"13677","sourceWorkId":"24378","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が担当するクラスで学級委員となった女子学生。"},{"spoiler":false,"text":"両親は離婚して母子家庭で育つが、父親のことを家族として愛している。"},{"spoiler":false,"text":"そんな父親に付けられた名前をよくからかわれてしまい、悲しい思いをすることも。"},{"spoiler":false,"text":"まじめで目立たないが、私服のどれみとすれ違った男子はドキッとするくらい可愛い。"},{"spoiler":false,"text":"父親が子供っぽい男だったためか大変母性が強く、男性を甘やかそうとする。"},{"spoiler":false,"text":"また母親から看護師の話を聞かされており、献身的な気持ちが身に付いている。"},{"spoiler":false,"text":"処女でオナニー経験もない。 性的知識も皆無。"},{"spoiler":false,"text":"自分より相手が気持ち良いかが大事で、セックスでは気持ちいいかをよく聞いてくる。"}],"source":"bangumi","sourceCharacterId":"47772"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/termina