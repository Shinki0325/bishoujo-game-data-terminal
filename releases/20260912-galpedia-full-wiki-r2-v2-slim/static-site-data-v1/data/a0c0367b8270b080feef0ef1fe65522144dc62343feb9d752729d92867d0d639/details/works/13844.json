racterId":"char_vndb_c28353","characterName":"出水 由香利","sourceIds":{"vndbCharacterId":"c28353"},"originalCharacterName":"出水 由香利","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 2nd year student at St. Claus Academy. Yukari is Yumi's classmate, and likes to take care of others. She is the treasurer of the student council. Since Yukari follows fads closely, she is quite well-informed. She became best friends with Yumi after the later's transferral into the academy, and is supportive of her."},{"spoiler":false,"text":"Translation of her official website profile."}],"source":"vndb","sourceCharacterId":"c28353"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c182f3ecb8979a869d57d51578454ac10e19a44a197cb70e50d006cdb5717d08.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05581774445a84b248dba5ea229806b5cbb857c974fd14c28c2be01035eeb2ef.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水廉","creatorId":"vndb:s1881","sourcePersonId":"vndb:s1881","canonicalEntityId":"vndb:s1881","name":"水廉","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21045","source":"vndb"}]},{"characterId":"char_vndb_c28356","characterName":"上条 隼斗","sourceIds":{"vndbCharacterId":"c28356"},"originalCharacterName":"上条 隼斗","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"178"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 2nd year student at St. Claus Academy, and Yumi's classmate. He's very impertinent and sharp-tongued."},{"spoiler":false,"text":"Hayato is straightforward and hates to lose, so he's the type to rush on forward once his mind is set on something. He tends to be perceived as a moody person due to stating things directly about anything to anyone. As a result, the other students slightly disassociate themselves from him, and he often goes about things on his own."},{"spoiler":false,"text":"Since he caught the attention of the president of the student council, Tozu Michinaru, the latter keeps his eye on Hayato at every opportunity. Due to this, they're at loggerheads with one another."},{"spoiler":false,"text":"Translation of his official website profile."}],"source":"vndb","sourceCharacterId":"c28356"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/81/81530bf160cfa7134e121cc30dd9bc7b72afe6f7ce2544f288703838453c8e1c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a9e6f2811e67b323b4c92f2e05c8d56468cc77e644864d4b533bc29f102b48f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐藤 タカオ","creatorId":"vndb:s734","sourcePersonId":"vndb:s734","canonicalEntityId":"vndb:s734","name":"梯篤司","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21042","source":"vndb"}]},{"characterId":"char_vndb_c28358","characterName":"最勝寺 嘉隆","sourceIds":{"vndbCharacterId":"c28358"},"originalCharacterName":"最勝寺 嘉隆","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"177"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 3rd year student of St. Claus Academy, Yoshitaka is the board chairman's son. He will be the successor of one of the top 5 zaibatsu of Japan, the Saishouji Group. A returnee to Japan, he is cheerful and open-hearted. Yoshitaka is easy to get along with, and treats anybody he comes across in a frank manner. Naturally, all of this opens him to a never-ending stream of \"invitations\" from girls- none of which he turns down. Furthermore, he gets through all of those invitations splendidly and perfectly."},{"spoiler":false,"text":"Translation of his official website profile."}],"source":"vndb","sourceCharacterId":"c28358"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b31d9712b46691ca8817db131de76c6f82ae76a276ca4a11ad8f93c420e4b3ba.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb6fd1b62fc0a22c64e0d266bfdbe8a8f1b60bbb2813b57581db6573e7b72efc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神凪 儚","creatorId":"vndb:s633","sourcePersonId":"vndb:s633","canonicalEntityId":"vndb:s633","name":"阿部 敦","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21041","source":"vndb"}]},{"characterId":"char_vndb_c28360","characterName":"十津 道也","sourceIds":{"vndbCharacterId":"c28360"},"originalCharacterName":"十津 道也","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"180"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 3rd year student of St. Claus Academy, Michinari is its student council president. He looks down on people a bit, but thanks to his charisma, high level of insight, proactivity, ability to get things done and competence, he's said to be an outstanding talent only seen once every 10 years."},{"spoiler":false,"text":"With his sharp gaze, he attends to and works everything out in a calm and collected manner. As a result, Michinari is respected by those around him, but is considered somebody who is difficult to approach."},{"spoiler":false,"text":"Kamijou Hayato's actions trouble Michinari everyday, so Michinari can't help but nitpick Hayato. This might make some think that he likes looking out for others."},{"spoiler":false,"text":"Translation of his official website profile."}],"source":"vndb","sourceCharacterId":"c28360"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9e/9eb5633407a3a5cd09bea08e1a2d03c839ab282c4f94dc7fc2209514b0a0c601.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4d/4dd91e6400012a47c83054d5ede59254bc7522af216270ffb2212edaa0d70fa1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"先割れスプーン","creatorId":"vndb:s45","sourcePersonId":"vndb:s45","canonicalEntityId":"vndb:s45","name":"鳥海 浩輔","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21040","source":"vndb"}]},{"characterId":"char_vndb_c28361","characterName":"浅葱 樹","sourceIds":{"vndbCharacterId":"c28361"},"originalCharacterName":"浅葱 樹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"167"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A 1st year student at St. Claus Academy, he is the son of the gardner employed by the Saishouji family. Very innocent, Itsuki has a tendency to trust others quickly due his extreme lack of interaction with people. He's introverted and taciturn."},{"spoiler":false,"text":"Since he was born with a weak body, he spent most of his time around the Saishouji family garden's flowers from a very young age. Yoshitaka and Riko were the only friends he had to play with, so the three are as close as siblings."},{"spoiler":false,"text":"He grew up watching his father at work, so when it comes to plants, he is very bright and knowledgeable. Itsuki spends most of his time around plants, so the other students tend to see him as a gentle, yet eccentric person."},{"spoiler":false,"text":"Translation of his official website profile."}],"source":"vndb","sourceCharacterId":"c28361"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/79c82816c077a716bc58398035550261702425735ee292577755c5da06d54450.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d9/d93f36bf07428c364a46b10f68cc8f740fcd87434f862c6714e69d6eab5ce749.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"神奈 紘飛","creatorId":"vndb:s291","sourcePersonId":"vndb:s291","canonicalEntityId":"vndb:s291","name":"代永 翼","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21043","source":"vndb"}]},{"characterId":"char_vndb_c28362","characterName":"小野瀬 敦司","sourceIds":{"vndbCharacterId":"c28362"},"originalCharacterName":"小野瀬 敦司","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"height":{"reviewState":"source-only","source":"vndb","value":"187"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"64"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A prodigious teacher having become the headmaster of St. Claus at a young age. Atsushi is a hardworker who has put his everything into all he has achieved in his life."},{"spoiler":false,"text":"He doesn't have a boastful or prideful personality, but instead, is mild-mannered and pacifistic. His students included, Atsushi is kind and polite to anybody. One of the reasons why he's popular amongst the students is because he tries to view things from their perspective rather than from \"up above everyone else\"."},{"spoiler":false,"text":"However, the number one reason he is popular appears to be because his calm demeanour and politeness exerts the alluring aura of a mature man, as well as his looks that keep his age a mystery."},{"spoiler":false,"text":"Translation of his official website profile."}],"source":"vndb","sourceCharacterId":"c28362"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/134091bf9a76412fea15e9272883c7713b765b29df604c5846d3922174e33df6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bbc201ab8d8eed17b983daddabc2e7b0f1583151a54fc8febc1f9a41bffaa5dc.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青島 刃","creatorId":"vndb:s179","sourcePersonId":"vndb:s179","canonicalEntityId":"vndb:s179","name":"成田剣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:21039","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"vndb:p1001","sourceCompanyId":"egs:brand:2955","canonicalEntityId":"vndb:p1001","name":"ショコラティエ","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:13844:2955","source":"egs"},{"companyId":"vndb:p1001","sourceCompanyId":"vndb:p1001","canonicalEntityId":"vndb:p1001","name":"ショコラティエ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:52891:v2914","source":"vndb"},{"companyId":"vndb:p1001","sourceCompanyId":"vndb:p1001","canonicalEntityId":"vndb:p1001","name":"ショコラティエ","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:6833:v2914","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
