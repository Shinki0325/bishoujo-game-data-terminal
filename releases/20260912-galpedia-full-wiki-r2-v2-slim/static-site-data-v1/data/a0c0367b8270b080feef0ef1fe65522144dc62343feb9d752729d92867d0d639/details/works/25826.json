に」という本音だが、母と周りがそれを許してくれない。"},{"spoiler":false,"text":"「姉様とは争いたくないのに……どうして、こうなってしまうの？」"}],"source":"bangumi","sourceCharacterId":"60507"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"17535","sourceWorkId":"25826","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"17535","sourceWorkId":"25826","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"17535","sourceWorkId":"25826","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"17535","sourceWorkId":"25826","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"17535","sourceWorkId":"25826","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9a/9ad985c5f47efaa3f88773405dbfa0a01479951e284053037d345a473285190b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d526827db5fc25d75a057493906e189bca3f0fdf5362b0905691cc04fa4976c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽月理恵","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:229794:60507:5907:1","source":"bangumi"}]},{"characterId":"char_c65166","characterName":"タマンナ・クルシュ","sourceIds":{"bangumi":[{"characterId":"60508","match":"exact-normalized-name-in-linked-work","subjectId":"229794"}],"egsCharacterIds":["17536"],"vndbCharacterId":"c65166"},"originalCharacterName":"タマンナ・クルシュ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect