0","source":"vndb"},{"creditedName":"サブロー","creatorId":"vndb:s7177","sourcePersonId":"vndb:s7177","canonicalEntityId":"vndb:s7177","name":"サブロー","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:153522","source":"vndb"}]},"cast":[{"characterId":"char_c79970","characterName":"雪宮 秋乃","sourceIds":{"bangumi":[{"characterId":"67905","match":"exact-normalized-name-in-linked-work","subjectId":"268459"}],"egsCharacterIds":["20631"],"vndbCharacterId":"c79970"},"originalCharacterName":"雪宮 秋乃","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"19"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"憲秋と元同級生。19歳。"},{"spoiler":false,"text":"可憐な容姿とほんわかした、見る者を安心させる雰囲気を持っている。"},{"spoiler":false,"text":"聡明で自分の意見をはっきりと述べる意志の強さも持ち、暴力・脅迫にも安易に屈しないが、十代でまだ世間ずれしていないため、理屈押しに弱い。"},{"spoiler":false,"text":"年上は敬うべきという母親からの躾が悪い風に作用し、特に目上(大人)から理屈押しされると、流れてしまうところがある。"}],"source":"egs","sourceCharacterId":"20631","sourceWorkId":"27398","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の元同級生で、初恋の相手。"},{"spoiler":false,"text":"中学高校では、学業優秀、生活態度問題なしの優等生として先生たちの評判は良かった。"},{"spoiler":false,"text":"人当たりも良く友人も多い。同性の友人も多いが、可愛いとして男子から注目され、"},{"spoiler":false,"text":"愛想の良い優しげな雰囲気から、特に主人公のような内気な男子からの評判が高かった。"},{"spoiler":false,"text":"母子家庭で兄妹はなし。蒸発した父親の借金のせいで、家計はずっと火の車。"},{"spoiler":false,"text":"資格を持たない母親が必死にやりくりしてきた。"},{"spoiler":false,"text":"秋乃本人は高校卒業後、すぐに働いて家計を助けるつもりだったが、"},{"spoiler":false,"text":"母親の強い薦めにより、大学進学を決意（大学の学費は奨学金）。"},{"spoiler":false,"text":"しかし不幸なことに、大学入学後、これまでの苦労がたたり、母親がついに倒れてしまう。"},{"spoiler":false,"text":"現在、大学は休学中。"},{"spoiler":false,"text":"強い焦燥感に負け、家計のために母親に秘密でソープ嬢として働き始めるが……。"}],"source":"bangumi","sourceCharacterId":"67905"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a01f5c267382a83d7110da1aa5ade5ca03c851047d740c235608d01f11cb5b5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65a56908ea63fe90761ca3d96fff674a0eddb2c284023c28594a68384c2c5cf7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"松山紗香","creatorId":"vndb:s904","sourcePersonId":"vndb:s904","canonicalEntityId":"vndb:s904","name":"松山 紗香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:268459:67905:10662:1","source":"bangumi"}]},{"characterId":"char_vndb_c110977","characterName":"社長","sourceIds":{"vndbCharacterId":"c110977"},"originalCharacterName":"社長","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8b9c74e7c4a095d6a6a61f29e0845d043a0bd08d63515fe787508ea1b341d01.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e9773a6d3a8a3f423c2b8d97f3fbfa8ae84a6403af22de47f46770f4295204e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"三谷 元一","creatorId":"vndb:s18636","sourcePersonId":"vndb:s18636","canonicalEntityId":"vndb:s18636","name":"三谷 元一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:79718","source":"vndb"}]},{"characterId":