20397","spoiler":false},{"segments":[{"spoiler":false,"text":"未来の少子化対策省の職員。"},{"spoiler":false,"text":"現代で草食系男子を肉食系男子にして、未来の人口減を食い止めるためにやってきた。"},{"spoiler":false,"text":"1年間、宗太の彼女（トレーナー）として生活することになる。"},{"spoiler":false,"text":"まじめな性格でしっかり者。 料理も勉強も一通り何でもこなせるエリート。"},{"spoiler":false,"text":"自分の仕事に誇りを持っており、宗太を立派な男にすべく奔走する。"},{"spoiler":false,"text":"「あなたを恐ろしい運命から救いに来ました。 今から500年後の未来から。」"}],"source":"bangumi","sourceCharacterId":"53153"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d793704a69b47e76a43f8219f08b1e319ca57f2f2ad44df8eb134590446a653.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/adcfad4387005faf6135f134fd028dfe941994d02d5866696a4810b567644ba9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"貴坂理緒","creatorId":"vndb:s946","sourcePersonId":"vndb:s946","canonicalEntityId":"vndb:s946","name":"貴坂 理緒","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:110512:53153:15550:1","source":"bangumi"}]},{"characterId":"char_c47079","characterName":"野中 宗太","sourceIds":{"bangumi":[],"egsCharacterIds":["4304"],"vndbCharacterId":"c47079"},"originalCharacterName":"野中 宗太","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"千南学園2年生の草食系男子。穏やかで優しい性格。"},{"spoiler":false,"text":"勉強も運動も人並みにはできるがこれといった長所がない。"},{"spoiler":false,"text":"そのため引っ込み思案で自分に自信が持てず、女の子に積極的になれないでいる。"},{"spoiler":false,"text":"クラスの女子からの評価は、悪い人ではないのだが、いわゆる「良い人」止まりのポジション。"},{"spoiler":false,"text":"玲香と出会い肉食系男子を目指し、男を磨いていくことになる。"}],"source":"egs","sourceCharacterId":"4304","sourceWorkId":"20397","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"comp