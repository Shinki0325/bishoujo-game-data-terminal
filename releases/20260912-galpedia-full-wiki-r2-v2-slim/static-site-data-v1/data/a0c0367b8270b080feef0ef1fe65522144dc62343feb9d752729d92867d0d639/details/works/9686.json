ource-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"16"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"913"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ある日突然やってきた、やたら元気な転校生。"},{"spoiler":false,"text":"お気楽極楽能天気なタイプで、気がつくといつもクルクル回っている。"},{"spoiler":false,"text":"良く言えば『前向きで素直』、悪く言えば『無知でアホっ子』。"},{"spoiler":false,"text":"高志曰く、「ちょっと危なっかしくて放っておけない感じ」。"}],"source":"egs","sourceCharacterId":"18272","sourceWorkId":"10783","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公のクラスに転校生としてやってくる元気少女。"},{"spoiler":false,"text":"自分の周囲にトラブルを引きよせてしまうという難儀な体質の持ち主。"},{"spoiler":false,"text":"かなりのポジティブシンキングで、素直な反面、人に騙されやすい性格。"},{"spoiler":false,"text":"なにかにつけて、すぐ回転（渦巻）するクセがある。"},{"spoiler":false,"text":"かなりの方向音痴。日本地図が書けない。"}],"source":"bangumi","sourceCharacterId":"37722"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9d/9defc856d795b9a7cf2e520b2be0d4d9fd943db83b4d39e0388eca7a2100bbd4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/be09e10b619ec5dd8efa01db28d7a3c9a07c3fbdcd4ca6316f3533e80f3a17a1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あおきさやか","creatorId":"vndb:s194","sourcePersonId":"vndb:s194","canonicalEntityId":"vndb:s194","name":"あおきさやか(青木静香)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:109992:37722:4869:1","source":"bangumi"}]},{"characterId":"char_c55366","characterName":"晴瑠夜 天音","sourceIds":{"bangumi":[{"characterId":"37723","match":"exact-normalized-name-in-linked-work","subjectId":"109992"}],"egsCharacterIds":["18273"],"vndbCharacterId":"c55366"},"originalCharacterName":"晴瑠夜 天音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"17"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"507"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"47"}},"descriptions":[{"segments":[{"spoiler":false,"text":"高志のクラスメイトで、バトミントン部主将。"},{"spoiler":false,"text":"容姿端麗、成績優秀、運動神経抜群"},{"spoiler":false,"text":"凛とした雰囲気がカッコよく、おまけに資産家のお嬢様。"},{"spoiler":false,"text":"一般人にケンカを売っているような、ハイスペック・パーフェクトガール。"},{"spoiler":false,"text":"欠点があるとすれば、容赦のないキツイ性格ぐらいだが、根はいいヤツ。"}],"source":"egs","sourceCharacterId":"18273","sourceWorkId":"10783","spoiler":false},{"segments":[{"spoiler":false,"text":"負けん気が強く、プライドの塊で、基本的に自分がナンバー1でないと気が済まない。"},{"spoiler":false,"text":"容姿端麗、成績優秀、スポーツ万能、さらに資産家の娘と、非の打ち所のないハイスペックを誇るが、なぜかともえの引きよせるトラブルに巻きこまれて被害を受けることが多い、不運な少女。"},{"spoiler":false,"text":"雲唯のことを、ちょっとライバル視している。"},{"spoiler":false,"text":"育ちがいいため、「徹する」ことがやや苦手で、肝心なところでは詰めが甘い。"}],"source":"bangumi","sourceCharacterId":"37723"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc81044a8fc8e59d2aef84a6c96bf8cda97eed755a69e8b3b59baa4f1d3093e2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f4ca618c835763d988c969cb9d334957facdaeb67d96570ea3db0e47d63e827.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"星野千寿子","creatorId":"vndb:s128","sourcePersonId":"vndb:s128","canonicalEntityId":"vndb:s128","name":"星野 千寿子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:109992:37723:4210:1","source":"bangumi"}]},{"characterId":"char_c55367","characterName":"神風 雲唯","sourceIds":{"bangumi":[{"characterId":"37724","match":"exact-normalized-name-in-linked-work","subjectId":"109992"}],"egsCharacterIds":["18274"],"vndbCharacterId":"c55367"},"originalCharacterName":"神風 雲唯","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"16"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1217"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「清楚可憐」と言う言葉がピタっとハマるクラスメイト。"},{"spoiler":false,"text":"ふんわりとしたやわらかな雰囲気、控え目で優しい性格から、男女問わず、学園内で絶大な人気を誇る。"},{"spoiler":false,"text":"運動神経もちょっぴり控え目だが、そこがまた良かったりする。"}],"source":"egs","sourceCharacterId":"18274","sourceWorkId":"10783","spoiler":false},{"segments":[{"spoiler":false,"text":"メインヒロインの幼なじみで、かつての親友。"},{"spoiler":false,"text":"ふんわりしたやわらかいルックスとおっとした優しい人柄で老若男女問わず幅広い人気がある。"},{"spoiler":false,"text":"ともえとは反対に、ささやかな幸運を引きよせることの多いラッキーガール。"},{"spoiler":false,"text":"運動神経はゼロで、身体を動かすことが大の苦手。なにもないところで転ぶのが特技。"},{"spoiler":false,"text":"成績は中の上。図書委員を務めている。"},{"spoiler":false,"text":"異性からモテるわりに同性からあまり敵意をもたれないタイプ（天音はのぞく）。"}],"source":"bangumi","sourceCharacterId":"37724"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a6461debb8859f415205f5d5ce911e4dd8912162febb854513165af4560407db.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/338b4d0494685b88b48e0593c2657949e68708d0f707cdad2f520f04644d5812.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"北原美和","creatorId":"vndb:s1108","sourcePersonId":"vndb:s1108","canonicalEntityId":"vndb:s1108","name":"北原 美和","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:109992:37724:16229:1","source":"bangumi"}]},{"characterId":"char_c55368","characterName":"霧谷 まひる","sourceIds":{"bangumi":[{"characterId":"37725","match":"exact-normalized-name-in-linked-work","subjectId":"109992"}],"egsCharacterIds":["18275"],"vndbCharacterId":"c55368"},"originalCharacterName":"霧谷 まひる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"19"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"425"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"no-conflict","source":"vndb","value":"150"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"見た目は「従妹」、その実体は「従姉」の年上のお姉さん。"},{"spoiler":false,"text":"音楽学校に通っているが、ちょくちょく高志の元へ遊びにくる。"},{"spoiler":false,"text":"家事全般をそつなくこなす、すぐにでもお嫁さんに行ける能力を持つが、その性格、言動はハイテンション過ぎて、高志ですらちょっと引き気味。"}],"source":"egs","sourceCharacterId":"18275","sourceWorkId":"10783","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の従姉の音大生。外見的には年下ロリっ子に見えるが、実際は年上。"},{"spoiler":false,"text":"世話焼きが趣味で、主人公の家に押しかけては勝手に家事をやって去っていく。"},{"spoiler":false,"text":"スキンシップが好きな寂しがり屋で、かなりのヤキモチやき。"},{"spoiler":false,"text":"アーティストタイプなせいか、異常にカンが鋭く、霊感等も強い。"},{"spoiler":false,"text":"常人にはついていけない、思考論理のブッとんだ奇矯な言動も多く見られる。"}],"source":"bangumi","sourceCharacterId":"37725"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4ec47fade7ec9714a594ba5baa3f87c10bcab039cbf053b959e27f2f1c3bfa73.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/52e0424c717f86a5883a31e0a3784feae00e44cc3d6ed9d64ccbf0ebe3399d9b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"前田ゆきえ","creatorId":"vndb:s790","sourcePersonId":"vndb:s790","canonicalEntityId":"vndb:s790","name":"前田 ゆきえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:109992:37725:3952:1","source":"bangumi"}]},{"characterId":"char_c55369","characterName":"春日 陽子","sourceIds":{"bangumi":[{"characterId":"37726","match":"exact-normalized-name-in-linked-work","subjectId":"109992"}],"egsCharacterIds":["18276"],"vndbCharacterId":"c55369"},"originalCharacterName":"春日 陽子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"24"},"birthday":{"reviewState":"no-conflict","source":"vndb","value":"113"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"h