ityStatus":"source-native","relationId":"vndb:vn-staff:174901","source":"vndb"},{"creditedName":"フューチャーハンズ","creatorId":"vndb:s15938","sourcePersonId":"vndb:s15938","canonicalEntityId":"vndb:s15938","name":"Future-hands(フューチャーハンズ)","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:174904","source":"vndb"},{"creditedName":"Jin.","creatorId":"vndb:s46803","sourcePersonId":"vndb:s46803","canonicalEntityId":"vndb:s46803","name":"Jin.","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:174907","source":"vndb"}]},"cast":[{"characterId":"char_c97496","characterName":"栗山 兎鞠","sourceIds":{"bangumi":[{"characterId":"96228","match":"exact-normalized-name-in-linked-work","subjectId":"336122"}],"egsCharacterIds":["23528"],"vndbCharacterId":"c97496"},"originalCharacterName":"栗山 兎鞠","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"304"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Neighbors with the protagonist growing up, and of the same age. As a child, she was a crybaby always crying and depended on the protagonist to take care of her. In reaction to this, she wants to repay the protagonist by taking care of him now that they have reunited. She treasures a hairpin that the protagonist gave her before moving away."},{"spoiler":false,"text":"\"If you tell me, I will pamper you as much as you want.\""}],"source":"vndb","sourceCharacterId":"c97496"},{"segments":[{"spoiler":false,"text":"同い年で子供の頃は家が隣同士。"},{"spoiler":false,"text":"子供時代はいつも泣いてばかりの泣き虫で、主人公が面倒を見ていた。その反動から、再会後は恩返しの気持ちで自分が世話を焼こうとする。主人公が引っ越し間際にくれた髪留めが宝物。"}],"source":"egs","sourceCharacterId":"23528","sourceWorkId":"31089","spoiler":false},{"segments":[{"spoiler":false,"text":"同い年で子供の頃は家が隣同士。"},{"spoiler":false,"text":"子供時代はいつも泣いてばかりの泣き虫で、主人公が面倒を見ていた。その反動から、再会後は恩返しの気持ちで自分が世話を焼こうとする。主人公が引っ越し間際にくれた髪留めが宝物。"}],"source":"bangumi","sourceCharacterId":"96228"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1ec0b0952f1c96828ca6346f464d60b60079a67532f6a305d646a7ad181942f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/44d5c2942f0bc5f087f56b8db2c1f47430fc1602e15dff9640671885d24f6535.webp","width":149,"height":256,"source":"static-detail"},"actors":[{"creditedName":"末柄里恵","creatorId":"vndb:s6837","sourcePersonId":"vndb:s6837","canonicalEntityId":"vndb:s6837","name":"実羽ゆうき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:336122:96228:12356:1","source":"bangumi"}]},{"characterId":"char_c97497","characterName":"州郷 千聖","sourceIds":{"bangumi":[{"characterId":"96229","match":"exact-normalized-name-in-linked-work","subjectId":"336122"}],"egsCharacterIds":["23529"],"vndbCharacterId":"c97497"},"originalCharacterName":"州郷 千聖","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"707"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the older sister of the protagonist's best friend Takuma and is one year older. During their childhood, she was a tomboy, but she seems to have left that behind and now portrays the ideal female image that boys have in mind. However, she has mischievous tendencies and enjoys playing pranks on the protagonist and the childhood friends. She may appear ladylike, but her playful personality shines through."},{"spoiler":false,"text":"\"Well, well... Shall I give you a kiss in front of everyone next time?\""}],"source":"vndb","sourceCharacterId":"c97497"},{"segments":[{"spoiler":false,"text":"親友の姉で一つ年上。"},{"spoiler":false,"text":"やんちゃだった子供時代が黒歴史になっており、その反動で現在は男子の考える理想の女性像を演じている。ただし根がオチャメなため、幼なじみの主人公たちに対しては昔のままの言動でイタズラを仕掛けてくる。"}],"source":"egs","sourceCharacterId":"23529","sourceWorkId":"31089","spoiler":false},{"segments":[{"spoiler":false,"text":"親友の姉で一つ年上。"},{"spoiler":false,"text":"やんちゃだった子供時代が黒歴史になっており、その反動で現在は男子の考える理想の女性像を演じている。ただし根がオチャメなため、幼なじみの主人公たちに対しては昔のままの言動でイタズラを仕掛けてくる。"}],"source":"bangumi","sourceCharacterId":"96229"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/398ad8f631c20fe9768aab2c31a48c070e67fb2918b07ef78a95d399a6cd72cd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a6/a68f9e6f7a78bb1ed746fe6d6bb5022ab0859fad20c4dfcca693bdc1081c6797.webp","width":149,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小日向みき","creatorId":"vndb:s13093","sourcePersonId":"vndb:s13093","canonicalEntityId":"vndb:s13093","name":"小日向 みき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:336122:96229:29176:1","source":"bangumi"}]},{"characterId":"char_c97498","characterName":"所沢 郁","sourceIds":{"bangumi":[{"characterId":"96230","match":"exact-normalized-name-in-linked-work","subjectId":"336122"}],"egsCharacterIds":["23530"],"vndbCharacterId":"c97498"},"originalCharacterName":"所沢 郁","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"119"},"height":{"reviewState":"no-conflict","source":"vndb","value":"171"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is one year younger and admires the protagonist as an older brother figure. Sacrificing her academic performance, she focused all her energy on physical activities and became a sports genius. She was strongly influenced by the popular manga \"The Prince of Tennis\" at the time and now receives enthusiastic cheers from girls as a prince-like character."},{"spoiler":false,"text":"On the other hand, she approaches the protagonist like a friendly puppy and always stays by his side. She is good at reading the atmosphere and acts like a pure little sister."},{"spoiler":false,"text":"\"I owe my coolness to you, my lovely princesses.\""}],"source":"vndb","sourceCharacterId":"c97498"},{"segments":[{"spoiler":false,"text":"一つ年下で、主人公を兄のように慕う。"},{"spoiler":false,"text":"学力を犠牲にしつつ、運動神経全振りにした結果、スポーツ超人として開花。当時の大人気マンガの影響を強く受けており、現在は王子様キャラとして女子たちから熱狂的な声援を受けている。一方で兄のように慕う主人公には、子犬のように人懐っこくつきまとう。"}],"source":"egs","sourceCharacterId":"23530","sourceWorkId":"31089","spoiler":false},{"segments":[{"spoiler":false,"text":"一つ年下で、主人公を兄のように慕う。"},{"spoiler":false,"text":"学力を犠牲にしつつ、運動神経全振りにした結果、スポーツ超人として開花。当時の大人気マンガの影響を強く受けており、現在は王子様キャラとして女子たちから熱狂的な声援を受けている。一方で兄のように慕う主人公には、子犬のように人懐っこくつきまとう。"}],"source":"bangumi","sourceCharacterId":"96230"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/35/3558afc08478ff53a2c038bdb694d5f851c6da0c2a29fabf957b7f77ca9c50ed.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c962c9237f3ba48f45c3334dcec9e98a280b95b2826c84a9e9480c2e22522eb.webp","width":149,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桐村まり","creatorId":"vndb:s1549","sourcePersonId":"vndb:s1549","canonicalEntityId":"vndb:s1549","name":"桐村 まり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:336122:96230:23768:1","source":"bangumi"}]},{"characterId":"char_c97499","characterName":"春ノ原 優菜","sourceIds":{"bangumi":[{"characterId":"96231","match":"exact-normalized-name-in-linked-work","subjectId":"336122"}],"egsCharacterIds":["23531"],"vndbCharacterId":"c97499"},"originalCharacterName":"春ノ原 優菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"503"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the same age as the protagonist and they used to be rivals in a card game they played together. After the protagonist saved her from a difficult situation, she began to look up to him as a hero. While she currently has an aversion to men due to that incident, she seeks advice and relies on the protagonist when they reunite. Although she is shy, she shows a cheerful side of herself and enjoys teasing the protagonist."},{"spoiler":false,"text":"\"Oh no, Sakawa-kun is interesting. He's going to put a hole in my head♪\""}],"source":"vndb","sourceCharacterId":"c97499"},{"segments":[{"spoiler":false,"text":"同い年で、当時一緒に遊んでいたカードゲームのライバル関係。"},{"spoiler":false,"text":"優菜にとってのピンチを救ったことで、主人公に対してはヒーローとして目を向けており一目置いている。そのため当時のピンチが原因で現在は男性への苦手意識を持つが、再会した主人公に対しては逆になにかと相談を持ちかけ頼ってくる。"}],"source":"egs","sourceCharacterId":"23531","sourceWorkId":"31089","spoiler":false},{"segments":[{"spoiler":false,"text":"同い年で、当時一緒に遊んでいたカードゲームのライバル関係。"},{"spoiler":false,"text":"優菜にとってのピンチを救ったことで、主人公に対してはヒーローとして目を向けており一目置いている。そのため当時のピンチが原因で現在は男性への苦手意識を持つが、再会した主人公に対しては逆になにかと相談を持ちかけ頼ってくる。"}],"source":"bangumi","sourceCharacterId":"96231"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cbd60b5b38af341f1294b40321ab4a58b65d87e7cc6ff67c5b485ac11439cc5e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/791744adf0ef25ed354f6c6f12bd680b9b20d4a017c468a426a90d1d082e0906.webp","width":149,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七種結花","creatorId":"vndb:s22881","sourcePersonId":"vndb:s22881","canonicalEntityId":"vndb:s22881","name":"佐藤 詩乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:336122:96231:56606:1","source":"bangumi"}]},{"characterId":"char_c97500","characterName":"西渓 静流","sourceIds":{"bangumi":[{"characterId":"96232","match":"exact-normalized-name-in-linked-work","subjectId":"336122"}],"egsCharacterIds":["23532"],"vndbCharacterId":"c97500"},"originalCharacterName":"西渓 静流","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1024"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Although the same age, Shizuru moved into town just before the protagonist moved away."},{"spoiler":false,"text":"For Shizuru, who has always been shy and had no friends, the protagonist was the first friend she made after moving to town."},{"spoiler":false,"text":"She remembers the kindness and wants to be friends with the protagonist again, but her shyness gets in the way, causing her to act tsundere and then regret it."},{"spoiler":false,"text":"\"By the way, the most hurtful thing was when he said, 'I've never seen Nishitani-san smile before.'\""}],"source":"vndb","sourceCharacterId":"c97500"},{"segments":[{"spoiler":false,"text":"同い年だが、主人公が引っ越していく直前にこの街に引っ越してきた。"},{"spoiler":false,"text":"昔から恥ずかしがりやで友達がいなかった静流にとって、この街に引っ越してきて初めて出来た友達が主人公だった。その恩を覚えており、再会後もすぐに主人公と仲良くしたいと思うのだが、人見知りの性格が災いしてついツンツンした態度で接しては後悔を繰り返す。"}],"source":"egs","sourceCharacterId":"23532","sourceWorkId":"31089","spoiler":false},{"segments":[{"spoiler":false,"text":"同い年だが、主人公が引っ越していく直前にこの街に引っ越してきた。"},{"spoiler":false,"text":"昔から恥ずかしがりやで友達がいなかった静流にとって、この街に引っ越してきて初めて出来た友達が主人公だった。その恩を覚えており、再会後もすぐに主人公と仲良くしたいと思うのだが、人見知りの性格が災いしてついツンツンした態度で接しては後悔を繰り返す。"}],"source":"bangumi","sourceCharacterId":"96232"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f7/f7adb0633ba102038223e68aabeae4a67993fa4e1c1a634a3ad467e8016d9490.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef9c4376b3d63df7d7315d5f00fa4cf348c0d3828adb7f46245c8b5fcf2479dd.webp","width":149,"height":256,"source":"static-detail"},"actors":[{"creditedName":"花澤さくら","creatorId":"vndb:s947","sourcePersonId":"vndb:s947","canonicalEntityId":"vndb:s947","name":"花澤 さくら","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:336122:96232:17075:1","source":"bangumi"}]},{"characterId":"char_vndb_c100532","characterName":"四月一日 恋舞","sourceIds":{"vndbCharacterId":"c100532"},"originalCharacterName":"四月一日 恋舞","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6bfb4c80d07c2544c46fc3397433fb93f316bbcce44bcc010cd89a2edc9a2f3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b2/b2c3a4893aa0a357995b44ddcf08daa11bb08413e686c6f3832f9d54fad4058a.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"衣央里 全","creatorId":"vndb:s2988","sourcePersonId":"vndb:s2988","canonicalEntityId":"vndb:s2988","name":"衣央里 全","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87801","source":"vn