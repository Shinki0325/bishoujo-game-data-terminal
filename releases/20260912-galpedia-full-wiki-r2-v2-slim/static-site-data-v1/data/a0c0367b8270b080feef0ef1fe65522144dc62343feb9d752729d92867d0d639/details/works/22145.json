{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"22145","model":{"presentationWorkId":"vndb:v20540","staff":{"artwork":[],"scenario":[],"music":[],"other":[]},"cast":[{"characterId":"char_c31031","characterName":"グリグラ","sourceIds":{"bangumi":[{"characterId":"32275","match":"exact-normalized-name-in-linked-work","subjectId":"122928"}],"egsCharacterIds":["6007"],"vndbCharacterId":"c31031"},"originalCharacterName":"グリグラ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl trained as a Ranger, the most agile of all classes of Knight. She lives in constant starvation in the Republic of Lancelot, and is something like a stray kitten."},{"spoiler":true,"text":"She was Bolonious's favorite student. She was an orphan trained at Ranger Academy and sold off by the Academy to Rochefort as her new master."},{"spoiler":false,"text":"From Mangagamer"}],"source":"vndb","sourceCharacterId":"c31031"},{"segments":[{"spoiler":false,"text":"騎士の中でも素早さを信条とするレンジャー技術を習得している少女。"},{"spoiler":false,"text":"ランスロット共和国で野良にゃんにゃんのような野宿生活を送りいつもお腹を減らしている。"}],"source":"egs","sourceCharacterId":"6007","sourceWorkId":"21531","spoiler":false},{"segments":[{"spoiler":false,"text":"将骑士中被认为最高敏捷型的“游侠（レンジャー）技术”习得的少女。在兰斯洛特（ランスロット）共和国里像野猫一样过着流浪生活，总是肚子空空的状态。"},{"spoiler":false,"text":"「唔，为了能让大家露出笑容，把坏人们都干掉吧。毕竟，那就是骑士的任务嘛」"}],"source":"bangumi","sourceCharacterId":"32275"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7fd77d671f4f7354be25ff95089ab1713384016695f21591e8e55e73b4aac11d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bf/bfb31adf3fb162f46cc9ebe8a5a0e10b8dbcfbbbc35244c217a39daf22e725f4.webp","width":189,"height":256,"source":"static-detail"},"actors":[{"creditedName":"峰岸由香里","creatorId":"vndb:s925","sourcePersonId":"vndb:s925","canonicalEntityId":"vndb:s925","name":"峰岸 由香里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:137384:32275:5939:1","source":"bangumi"}]},{"characterId":"char_c31033","characterName":"キノウ","sourceIds":{"bangumi":[{"characterId":"32277","match":"exact-normalized-name-in-linked-work","subjectId":"122928"}],"egsCharacterIds":["6009"],"vndbCharacterId":"c31033"},"originalCharacterName":"キノウ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Asterisk's sisters, and Kyou's twin sister, who looked after Asterisk."},{"spoiler":false,"text":"They taught Asterisk everything about fighting monsters and living life to the fullest, as well as having encouraged him to travel to the mainland."},{"spoiler":true,"text":"A dragon, and member of the Witches of the Round Table. During the Arthur Tragedy, Asterisk's parents entrusted Asterisk to the twins."}],"source":"vndb","sourceCharacterId":"c31033"},{"segments":[{"spoiler":false,"text":"姉としてアスタリスクを育てた双子の姉妹。"},{"spoiler":false,"text":"モンスターと戦う技術や生活する術を教え、大陸への旅立ちを後押しした。"}],"source":"egs","sourceCharacterId":"6009","sourceWorkId":"21531","spoiler":false},{"segments":[{"spoiler":false,"text":"作为姐姐抚养阿斯塔的双子姐妹。教会了阿斯塔与怪物战斗的技术与生活技巧，为他在大陆的旅行提供着后援。"},{"spoiler":false,"text":"「通过正当途径来迎娶众多媳妇的阿斯塔，才是值得我们二人献出纯洁的人呢」"}],"source":"bangumi","sourceCharacterId":"32277"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da5141d00de1278978646abc2bbbec4414047e3ae37abdc42f080bb51cf0c4de.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c0/c04bc579cc15edc780b65810b746db41d8f32204113683fbdb63405476422987.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c31034","characterName":"キョウ","sourceIds":{"bangumi":[{"characterId":"32278","match":"exact-normalized-name-in-linked-work","subjectId":"122928"}],"egsCharacterIds":["6010"],"vndbCharacterId":"c31034"},"originalCharacterName":"キョウ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of Asterisk's sisters, and Kinou's twin sister, who looked after Asterisk."},{"spoiler":false,"text":"They taught Asterisk everything about fighting monsters and living life to the fullest, as well as having encouraged him to travel to the mainland."},{"spoiler":true,"text":"A dragon, and member of the Witches of the Round Table. During the Arthur Tragedy, Asterisk's parents entrusted Asterisk to the twins."}],"source":"vndb","sourceCharacterId":"c31034"},{"segments":[{"spoiler":false,"text":"姉としてアスタリスクを育てた双子の姉妹。"},{"spoiler":false,"text":"モンスターと戦う技術や生活する術を教え、大陸への旅立ちを後押しした。"}],"source":"egs","sourceCharacterId":"6010","sourceWorkId":"21531","spoiler":false},{"segments":[{"spoiler":false,"text":"作为姐姐抚养阿斯塔的双子姐妹。教会了阿斯塔与怪物战斗的技术与生活技巧，为他在大陆的旅行提供着后援。"},{"spoiler":false,"text":"「那么，为了能娶回众多可爱的女孩子，努力再努力地奋斗吧」"}],"source":"bangumi","sourceCharacterId":"32278"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0997355200a5fb8e4e38a51161ec05708c6890680f27ff05e67a16bcbbdf092.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a132c85386a4526c72019564145dac8ca0f8f159b60f3ce845a3fee9f466792e.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c32069","characterName":"アスタ","sourceIds":{"bangumi":[{"characterId":"68789","match":"exact-normalized-name-in-linked-work","subjectId":"122928"}],"egsCharacterIds":["6004"],"vndbCharacterId":"c32069"},"originalCharacterName":"アスタ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A man from the barely-populated Fresh Fish Island, he was raised by a pair of beautiful twins named Kinou and Kyou . Seeking to have sex with both of the sisters by becoming a Knight, he decides to go on a journey. His primary goal, and one that the sisters encourage, is to become a great enough man to marry lots of women."},{"spoiler":true,"text":"He is the prince of Kingdom of Arthur, and is a half-dragon. His father Tram was a human, while his mother Ruto was a dragon and a member of the Witch of the Round Table."},{"spoiler":false,"text":"From Mangagamer"}],"source":"vndb","sourceCharacterId":"c32069"},{"segments":[{"spoiler":false,"text":"魚鮮島という過疎の島で双子の美人姉妹に育てられた青年。"},{"spoiler":false,"text":"双子の姉妹とエッチするために騎士となるべく旅に出る。"},{"spoiler":false,"text":"双子姉妹の後押しも有り、お嫁さんをたくさんもらえる立派な男になるのが当面の目的である。"}],"source":"egs","sourceCharacterId":"6004","sourceWorkId":"21531","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法剑士，在人烟稀少的小岛上长大，对异性有超出常人的兴趣。"}],"source":"bangumi","sourceCharacterId":"68789"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b12e4f47116cff3f6742fc311a584dc8290c5013cec9caf507de0d6f0be0463.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2452d697d5a53e53c4e814940fda6412cf2d08e3b53e4212837830b48954534.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c31029","characterName":"リッシュ・エデン","sourceIds":{"vndbCharacterId":"c31029"},"originalCharacterName":"リッシュ・エデン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The second princess of the Kingdom of Eden."},{"spoiler":false,"text":"She’s pursuing Snake Crest, an evil organization plotting to put the world at war, all by herself. At the same time, she’s searching for a personal Knight she can trust to assist her. Childhood friends with Ramius."},{"spoiler":false,"text":"From Mangagamer"}],"source":"vndb","sourceCharacterId":"c31029"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/ebf051a589fe5dda51b8e5567b631453dc9937b7ef50254696ad9a8fa6ee619a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1c19ef65f57ce8e0a40e88d95defbfabe85c51f244b25b1bd1c873fae0807eb.webp","width":256,"height":225,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c31030","characterName":"ラミアス・ドライセン","sourceIds":{"vndbCharacterId":"c31030"},"originalCharacterName":"ラミアス・ドライセン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Knight serving the Kingdom of Eden."},{"spoiler":false,"text":"She has a legendary mother and a talented brother who she struggles to live up to, but continually fails to do so. Even her fellow Knights keep their distance from her, but she’s still striving to improve for the sake of defending her nation. Riche's childhood friend."},{"spoiler":false,"text":"From Mangagamer"}],"source":"vndb","sourceCharacterId":"c31030"}],"profileFacts":[],"metada