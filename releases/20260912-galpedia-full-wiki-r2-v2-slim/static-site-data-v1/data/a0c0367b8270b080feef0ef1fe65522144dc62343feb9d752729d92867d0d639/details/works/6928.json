{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"6928","model":{"presentationWorkId":"egs:6928","staff":{"artwork":[],"scenario":[],"music":[],"other":[{"creditedName":"樋口香里","creatorId":"vndb:s12757","sourcePersonId":"egs:creator:5612","canonicalEntityId":"vndb:s12757","name":"樋口香里","roleCode":"character-design","roleLabel":"角色设计","identityStatus":"auto-confirmed","relationId":"egs:work-creator:269208","source":"egs"}]},"cast":[{"characterId":"char_bangumi_188297","characterName":"たてしな あかり","sourceIds":{"bangumi":[{"characterId":"188297","match":"source-roster","subjectId":"145088"},{"characterId":"188297","match":"source-roster","subjectId":"554763"}]},"originalCharacterName":"たてしな あかり","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"音大付属高校1年生。"},{"spoiler":false,"text":"現在行方不明の天才作曲家、蓼科光一"},{"spoiler":false,"text":"（たてしなこういち）の娘で、幼い頃より父から"},{"spoiler":false,"text":"音楽の教育を受け、高い音楽感性を"},{"spoiler":false,"text":"身につけている。"},{"spoiler":false,"text":"友人のオーデションに付き合った事をきっかけに、"},{"spoiler":false,"text":"偶然音楽業界のマネージャーに、 その才能を"},{"spoiler":false,"text":"見出され、歌手としてデビューすることになる。"}],"source":"bangumi","sourceCharacterId":"188297"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d19c77177225b38010aa49239a0e3fcd7cce19c9b7f86e7ce8c71287ae43e9ad.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/527e321fc2c131877390c83c90f8c41999a9bda5c38ef5e79816f3e71e5615ac.webp","width":250,"height":188,"source":"static-detail"},"actors":[{"creditedName":"今井由香","creatorId":"vndb:s1078","sourcePersonId":"vndb:s1078","canonicalEntityId":"vndb:s1078","name":"今井 由香","roleCode":"voi