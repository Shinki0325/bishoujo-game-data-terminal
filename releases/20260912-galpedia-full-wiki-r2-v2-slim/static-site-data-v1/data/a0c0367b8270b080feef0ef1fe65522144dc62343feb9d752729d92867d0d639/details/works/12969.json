{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"12969","model":{"presentationWorkId":"vndb:v2607","staff":{"artwork":[{"creditedName":"リャオ","creatorId":"vndb:s6122","sourcePersonId":"egs:creator:12789","canonicalEntityId":"vndb:s6122","name":"リャオ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:80303","source":"egs"}],"scenario":[{"creditedName":"田中一郎","creatorId":"vndb:s4013","sourcePersonId":"egs:creator:424","canonicalEntityId":"vndb:s4013","name":"田中一郎","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:242099","source":"egs"},{"creditedName":"漣枕","creatorId":"vndb:s9828","sourcePersonId":"egs:creator:14135","canonicalEntityId":"vndb:s9828","name":"漣枕","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:80305","source":"egs"},{"creditedName":"シャア専用◎","creatorId":"vndb:s2261","sourcePersonId":"egs:creator:2171","canonicalEntityId":"vndb:s2261","name":"シャア専用◎","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:80306","source":"egs"}],"music":[{"creditedName":"墨染サウンド","creatorId":"vndb:s9082","sourcePersonId":"egs:creator:16560","canonicalEntityId":"vndb:s9082","name":"墨染サウンド","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:242098","source":"egs"}],"other":[{"creditedName":"漣 枕","creatorId":"vndb:s9828","sourcePersonId":"vndb:s9828","canonicalEntityId":"vndb:s9828","name":"漣 枕","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:36255","source":"vndb"}]},"cast":[{"characterId":"char_c13814","characterName":"東堂 綾妃","sourceIds":{"bangumi":[{"characterId":"92172","match":"exact-normalized-name-in-linked-work","subjectId":"320406"}],"egsCharacterIds":["14540"],"vndbCharacterId":"c13814"},"originalCharacterName":"東堂 綾妃","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本編ヒロイン。大企業である東堂ホールディングス会長の娘で、裕福な家庭に育ったお嬢様。"},{"spoiler":false,"text":"父親の会社のエリート社員・圭一郎と見合い結婚し、一女・綺羅羅を授かる。"},{"spoiler":false,"text":"夫婦仲は円満で、年齢を重ねた今でも夜の営みは盛んである。"},{"spoiler":false,"text":"他人をあまり疑わない素直で、穏やかな性格。また押しに弱く流されやすい。"},{"spoiler":false,"text":"長女であるため、東堂家の莫大な遺産の相続権を有しており、それを狙って主治医である野山忠通が暗躍する。"}],"source":"egs","sourceCharacterId":"14540","sourceWorkId":"12969","spoiler":false},{"segments":[{"spoiler":false,"text":"落ち着いた雰囲気を漂わせる女性。"},{"spoiler":false,"text":"東堂ホールディングス会長の娘という裕福な家庭の生まれで、長女のため莫大な遺産を相続する権利を有している。"},{"spoiler":false,"text":"夫の圭一郎とはお見合いで知り合い、結婚してすぐに妊娠・出産するも、そのメリハリのきいたグラマーな肉体はほぼ維持されたままである。"},{"spoiler":false,"text":"穏やかで人をあまり疑わず、他者からの申し入れを強く断れないなど押しに弱い性格をしており、圭一郎との結婚を決めたのもこの性格が影響しているところがある。"},{"spoiler":false,"text":"東堂家の主治医である野山忠通とは子供の頃から交流があったが、全寮制の女学園へ進学し、数年の間疎遠になった。"},{"spoiler":false,"text":"そのためか、野山に対しては幼い頃のイメージが強く、良い印象を持っている。"}],"source":"bangumi","sourceCharacterId":"92172"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"14540","sourceWorkId":"12969","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"14540","sourceWorkId":"12969","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"14540","sourceWorkId":"12969","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"14540","sourceWorkId":"12969","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"56 kg","valueContext":null,"source":"egs","sourceCharacterId":"14540","sourceWorkId":"12969","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2ce4b3d0ecde1274c8c405f51cd837a7a33d2d7a2044b5be504c0e6c8187fbae.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/414b11b864d0dc263aae9cdc2eb6f772b6ec66516266bca1e91d244ff090c210.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽吹梨里","creatorId":"vndb:s57","sourcePersonId":"vndb:s57","canonicalEntityId":"vndb:s57","name":"羽吹 梨里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:320406:92172:6547:1","source":"bangumi"}]},{"characterId":"char_c13815","characterName":"東堂 綺羅羅","sourceIds":{"bangumi":[{"characterId":"92173","match":"exact-normalized-name-in-linked-work","subjectId":"320406"}],"egsCharacterIds":["14541"],"vndbCharacterId":"c13815"},"originalCharacterName":"東堂 綺羅羅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"168"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"東堂家の一人娘。"},{"spoiler":false,"text":"学生である彼女は、文武両道の才女で、学業も上位に食い込むほど優秀。所属する弓道部では、地区優勝レベルの腕前を持つ。しかし、家事全般が不得手で、料理も裁縫もまったくできない。"},{"spoiler":false,"text":"性格は勝気でクールな面が強く表面に出ているが、一度親しくなった相手には格別な信頼と親愛を寄せる。"},{"spoiler":false,"text":"男性経験はなく、処女だが、想い人はいるらしい。"},{"spoiler":false,"text":"東堂家に来訪する主治医の野山医師に対しては嫌悪感を抱いているようだ。"}],"source":"egs","sourceCharacterId":"14541","sourceWorkId":"12969","spoiler":false},{"segments":[{"spoiler":false,"text":"圭一郎と綾妃の愛娘。 弓道部に入っており、腕前は地区優勝レベルとなかなかのものである。"},{"spoiler":false,"text":"文武両道の才女で学業も上位に食い込むほどの秀才ではあるが、料理や裁縫など家事の才能がほとんどない。"},{"spoiler":false,"text":"知的でクールな面を見せるも、一度親しくなった相手に対しては格別な信頼と親愛の情をよせる傾向にある。"},{"spoiler":false,"text":"想い人はいるが、家族にも言わずに心の中に秘めている。男性経験はまだなく処女である。"},{"spoiler":false,"text":"野山医師に嫌悪感を抱いており、露骨に嫌な態度をとることはないが、極力顔を合わせない様にしている。"}],"source":"bangumi","sourceCharacterId":"92173"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"14541","sourceWorkId":"12969","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"168 cm","valueContext":null,"source":"egs","sourceCharacterId":"14541","sourceWorkId":"12969","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"14541","sourceWorkId":"12969","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"14541","sourceWorkId":"12969","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"54 kg","valueContext":null,"source":"egs","sourceCharacterId":"14541","sourceWorkId":"12969","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3b/3bf19e956d2718fd2666bdf21d6e1ec2fd4b5ede454395463a2585b7708b3c1a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1a/1a3d422f38a6910b29e18c90730299c346c5213f3922baaa3c603d6a33e6449b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"