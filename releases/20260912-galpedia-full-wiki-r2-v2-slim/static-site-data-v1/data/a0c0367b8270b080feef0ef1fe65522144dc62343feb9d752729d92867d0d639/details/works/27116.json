","relationId":"vndb:vn-staff:150884","source":"vndb"},{"creditedName":"織倉 まこと","creatorId":"vndb:s48451","sourcePersonId":"vndb:s48451","canonicalEntityId":"vndb:s48451","name":"織倉 まこと","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:150886","source":"vndb"}]},"cast":[{"characterId":"char_c67746","characterName":"神蛇 玲","sourceIds":{"bangumi":[{"characterId":"51169","match":"exact-normalized-name-in-linked-work","subjectId":"197445"}],"egsCharacterIds":["11860"],"vndbCharacterId":"c67746"},"originalCharacterName":"神蛇 玲","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"bangumi","value":"1月27日"},"bloodType":{"reviewState":"source-only","source":"bangumi","value":"a"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"155cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"元気で明るい一方、物事を深く考えすぎて暗くなってしまうことがある。"},{"spoiler":false,"text":"幼い頃は島の伝承にならい兄の丞 と結婚する事を望んでたが、話題避ける兄と不機嫌になる母親・鏡佳の影響で男装をして妹であること隠すようになる。"},{"spoiler":false,"text":"名前も本来の読み方は“れい”であるが、“あきら”と名乗り周囲にもそう呼ばせている。"},{"spoiler":false,"text":"家事をしない鏡佳に代わり家事全般行ってた為、料理が得意。"}],"source":"egs","sourceCharacterId":"11860","sourceWorkId":"24109","spoiler":false},{"segments":[{"spoiler":false,"text":"瀬戸内海の孤島【祈背島】で暮らす、零雅の姪。"},{"spoiler":false,"text":"島に古より伝わる蛇神“コウミガミ”を奉る「巳重神社」で代々宮司を務める家系の生まれ。"},{"spoiler":false,"text":"五年前に起きた事件の後、実の兄と近親婚を交わし、現在は一女の母。"},{"spoiler":false,"text":"娘の子育てがひと段落したこともあり、島から単身、叔母である零雅へと会いに来た。"}],"source":"egs","sourceCharacterId":"11860","sourceWorkId":"27116","spoiler":false},{"segments":[{"spoiler":false,"text":"神蛇家の長女、丞の妹。"},{"spoiler":false,"text":"性格は元気で明るい一方、物事を深く考えすぎて暗くなってしまう事がある。"},{"spoiler":false,"text":"丞に密かに想いを寄せており、幼い頃にも島の伝承にならって兄の丞と結婚する事を望んでいたが、"},{"spoiler":false,"text":"話題を避ける丞と不機嫌になる母親・鏡佳の影響で、いつしか男装をして妹であることを隠すようになった。"},{"spoiler":false,"text":"名前も本来の読み方は“れい”であるが、“あきら”と名乗り周囲にもそう呼ばせている。"},{"spoiler":false,"text":"家事をしない鏡佳に代わり家事全般を行っている。"}],"source":"bangumi","sourceCharacterId":"51169"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/996801d8a45609cda46e0ad60ae28aec6e8dbf44f4d87fce703ded53dfed3843.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d0f3455f4f5c23e5ac38e80476851e3707c380a808f0104fae5b3c4166dc5305.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c67750","characterName":"コウミガミ","sourceIds":{"bangumi":[{"characterId":"51173","match":"exact-normalized-name-in-linked-work","subjectId":"197445"}],"egsCharacterIds":["11864"],"vndbCharacterId":"c67750"},"originalCharacterName":"コウミガミ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"祈背島の伝承に出てくる蛇神で、巳重社祭られている多産の神。"},{"spoiler":false,"text":"元々、力の強い神ではなく物事を見守り、時に神託を授けるために蛇の姿で人の前に姿を現す程度であったが、主人公達の前には、試練与える為に現れる。"}],"source":"egs","sourceCharacterId":"11864","sourceWorkId":"24109","spoiler":false},{"segments":[{"spoiler":false,"text":"一見、可憐な少女の姿をしているが、その正体は蛇神。"},{"spoiler":false,"text":"瀬戸内海の【祈背島】にて、多産の神として奉られている。"},{"spoiler":false,"text":"五年前に島で起きた事件以降、零雅へひとかたならぬ想いを寄せており、会いたいという気持ちから、玲と共に零雅の元を訪れる。"},{"spoiler":false,"text":"外見に相応しく無邪気な振る舞いが目立つが、寂しがりで疑り深い一面も。"}],"source":"egs","sourceCharacterId":"11864","sourceWorkId":"27116","spoiler":false},{"segments":[{"spoiler":false,"text":"祈背島の伝承に出てくる蛇神で、巳重神社にて多産の神として奉られている。"},{"spoiler":false,"text":"伝承によれば、コウミガミの望みである「兄妹婚」が成されなければ恐ろしい罰が下るといわれているが……。"}],"source":"bangumi","sourceCharacterId":"51173"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/