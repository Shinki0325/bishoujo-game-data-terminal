Status":"auto-confirmed","relationId":"egs:work-creator:142398","source":"egs"},{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"egs:creator:5968","canonicalEntityId":"vndb:s295","name":"青葉りんご","detail":"OP曲「Lunatic Shadow」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:145842","source":"egs"},{"creditedName":"青葉 りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:117529","source":"vndb"},{"creditedName":"KIZAWA studio","creatorId":"vndb:s592","sourcePersonId":"vndb:s592","canonicalEntityId":"vndb:s592","name":"KIZAWA studio","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:117530","source":"vndb"},{"creditedName":"Mad Pierrot","creatorId":"vndb:s3471","sourcePersonId":"vndb:s3471","canonicalEntityId":"vndb:s3471","name":"Mad Pierrot","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:117534","source":"vndb"},{"creditedName":"天乃 啓示","creatorId":"vndb:s4312","sourcePersonId":"vndb:s4312","canonicalEntityId":"vndb:s4312","name":"天乃 啓示","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:117536","source":"vndb"},{"creditedName":"うらかん","creatorId":"vndb:s5604","sourcePersonId":"vndb:s5604","canonicalEntityId":"vndb:s5604","name":"うらかん","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:117537","source":"vndb"},{"creditedName":"城疋砂馬也","creatorId":"vndb:s5612","sourcePersonId":"vndb:s5612","canonicalEntityId":"vndb:s5612","name":"城疋砂馬也","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:117540","source":"vndb"},{"creditedName":"大内 純","creatorId":"vndb:s9545","sourcePersonId":"vndb:s9545","canonicalEntityId":"vndb:s9545","name":"大内 純","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:117541","source":"vndb"}]},"cast":[{"characterId":"char_c41425","characterName":"朱雀","sourceIds":{"bangumi":[{"characterId":"46716","match":"exact-normalized-name-in-linked-work","subjectId":"128900"}],"egsCharacterIds":["5644"],"vndbCharacterId":"c41425"},"originalCharacterName":"朱雀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"169"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"物心つかぬうちに両親を戦火で失い、周囲に疎まれる失意の幼少期を過ごす。その中で、忍の技に天賦の際を発揮し、その資質に認める里の上忍会議である神部の裁定により、その身に荒神・炎帝朱鳥（えんていすちょう）を宿して荒人神となった。"},{"spoiler":false,"text":"通常くのいちは房中術などで相手を虜にするような任務が多いため、性行為にも抵抗が無いように訓練を施されるが、隠密行動よりは戦闘行為によって対象を殺傷する事に重きを置いた星宿の里の忍びの掟により、乙女のまま忍びの術をマスターしている。"},{"spoiler":false,"text":"さらに荒神を憑依させて荒人神となってからは、「朱雀の炎」と呼ばれる消せない炎を自在に操れるため、さらに他人との接触等が難しくなっている為、未だ処女。"},{"spoiler":false,"text":"その不幸な生い立ちもあってか、己の力では抗えない宿命の中で冷めたシニカルな忍として、粛々と忍務をこなすクールな女性。くのいちとしての任務にそなえ日々訓練を怠らないためスタイルは抜群。"}],"source":"egs","sourceCharacterId":"5644","sourceWorkId":"21352","spoiler":false},{"segments":[{"spoiler":false,"text":"物心つかぬうちに両親を戦火で失い、周囲に疎まれ失意の幼少期を過ごす。"},{"spoiler":false,"text":"その不幸な生い立ちもあってか、冷めたシニカルな忍として粛々と忍務をこなす。"},{"spoiler":false,"text":"くのいちとしての任務に備え、日々訓練を怠らないためスタイルは抜群。"},{"spoiler":false,"text":"その身に荒神・炎帝朱鳥 を宿して 荒人神 となった。"},{"spoiler":false,"text":"“朱雀の炎” と呼ばれる消えない炎を自在に操ることができる。"},{"spoiler":false,"text":"荒人神となり他人との接触が難しくなっているため、いまだ処女。"},{"spoiler":false,"text":"「朱雀の炎にその身を焼かれたければ、かかってくるが良い！」"}],"source":"bangumi","sourceCharacterId":"46716"}],"profileFacts":[{"label":"身高（本版本）","value":"169 cm","valueContext":null,"source":"egs","sourceCharacterId":"5644","sourceWorkId":"21352","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20b7506513228f002ed9d02aa83cabed0a4183016d066365cbfc748353e5e576.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2db394bc043903a5b55f388d7eb555fa32aff1ab747173f9d04ad8dbd74ea81.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水口まつり","creatorId":"vndb:s879","sourcePersonId":"vndb:s879","canonicalEntityId":"vndb:s879","name":"水口 まつり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:128900:46716:6380:1","source":"bangumi"}]},{"characterId":"char_c41426","characterName":"白虎","sourceIds":{"bangumi":[{"characterId":"46717","match":"exact-normalized-name-in-linked-work","subjectId":"128900"}],"egsCharacterIds":["5645"],"vndbCharacterId":"c41426"},"originalCharacterName":"白虎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"荒神・白帝天河（はくていてんが）を宿し「白虎の爪」と呼ばれるカマイタチ現象を操る事ができるが、本人の実力不足により荒神を完璧に使役できないくのいち。熱血空回りキャラ。同門で同じ荒人神でもある朱雀を一方的にライバル視している。"},{"spoiler":false,"text":"里の上忍の跡取り娘でもあり、忍びの才能については朱雀にも負けない素質をもっているものの、直情径行形であり常に自分の思いこみで行動するので、任務の達成率は高いものの味方への被害なども多く結果としてプラマイゼロくらいの結果"},{"spoiler":false,"text":"に終わる事が多い。"},{"spoiler":false,"text":"今回、ライバルでもある朱雀が荒人神になったにもかかわらず、敵国の忍びに捕らえられてしまったため、渋る神部を強引に説得し自分にも荒神を降臨させて朱雀を助け出し長年の因縁に決着を付けようと主人公の元に乗り込んでくる。"},{"spoiler":false,"text":"まるで分身しているかのような本人の超体術と相まって「白虎の百爪」で主人公を追いつめるものの、ライバル朱雀の話を振られて頭に血が上り主人公にその隙をつかれ捕らえられてしまう。"},{"spoiler":false,"text":"くのいちとしての鍛錬は怠っていないため、朱雀ほど肉感的ではないもののスタイルの良い美少女。口を開かなければだが。"}],"source":"egs","sourceCharacterId":"5645","sourceWorkId":"21352","spoiler":false},{"segments":[{"spoiler":false,"text":"熱血空回りキャラ。 口を開かなければ美少女。"},{"spoiler":false,"text":"くのいちとしての鍛錬は怠っていないため、朱雀ほどではないもののスタイルは良い。"},{"spoiler":false,"text":"里の上忍の跡取り娘でもあり、忍びの才能についても朱雀に負けない素質をもつ。"},{"spoiler":false,"text":"荒神・白帝天河 を宿す荒人神だが、実力不足により荒神を完璧に使役できていない。"},{"spoiler":false,"text":"まだ不完全だが、“白虎の爪” と呼ばれるカマイタチ現象を操ることができる。"},{"spoiler":false,"text":"同門で同じ荒人神でもある朱雀を一方的にライバル視している。"},{"spoiler":false,"text":"敵国に捕らえられてしまった朱雀を助け出すため、主人公のもとに乗り込んでくる。"},{"spoiler":false,"text":"「アンタが朱雀を捕まえた奴ね！　あたしと勝負しなさい！」"}],"source":"bangumi","sourceCharacterId":"46717"}],"profileFacts":[{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"5645","sourceWorkId":"21352","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4476c16dc8293701e78ea2d8226555851ab1ec18385f73908869af861814cbc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb862b94ad2ef8c6415c031147de4dece1a71ff551d85b2a5ad6d9747a16e4e9.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"立石めぐみ","creatorId":"vndb:s646","sourcePersonId":"vndb:s646","canonicalEntityId":"vndb:s646","name":"立石 めぐみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:128900:46717:10027:1","source":"bangumi"}]},{"characterId":"char_c41427","characterName":"御咲 珠茂","sourceIds":{"bangumi":[{"characterId":"46718","match":"exact-normalized-name-in-linked-work","subjectId":"128900"}],"egsCharacterIds":["5646"],"vndbCharacterId":"c41427"},"originalCharacterName":"御咲 珠茂","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"星宿の里にほど近いが長年敵対を続けてきた虚宿の里の女頭領。目的の為ならどのような卑怯な手段も使う、忍びらしいといえば忍びらしい隠密集団の長ともあって、任務の為なら部下を失っても構わないタイプの冷徹な上忍。"},{"spoiler":false,"text":"朱雀たち荒人神の存在を知り、なんとかその力を手に入れられないか画策して主人公の力を利用しようとする。"},{"spoiler":false,"text":"本人も過去に荒神・天狐大神（てんこたいしん）を降臨させようとしたが失敗し、その名残で狐の耳と尻尾が身体に残ってしまっている。"},{"spoiler":false,"text":"眉目秀麗、頭脳明晰であるものの、忍術よりは怪力をつかった体術の方が得意というくのいちにしては珍しいタイプ。"}],"source":"egs","sourceCharacterId":"5646","sourceWorkId":"21352","spoiler":false},{"segments":[{"spoiler":false,"text":"朱雀たちの里と長年敵対を続けている、虚宿の里の女頭領。"},{"spoiler":false,"text":"任務のためなら手段を選ばず、また部下を失っても構わないという冷徹な上忍。"},{"spoiler":false,"text":"眉目秀麗、頭脳明晰であるものの、忍術より怪力を使った体術のほうが得意。"},{"spoiler":false,"text":"朱雀たち 荒人神 の存在を知り、その力を手に入れられないか画策している。"},{"spoiler":false,"text":"自身も過去に 荒神・天狐大神 を降臨させようとしたが失敗し、その名残で狐の耳と尻尾が身体に残ってしまっている。"},{"spoiler":false,"text":"「妾が、かの悪名高き女頭領・御咲珠茂さね…… それを知ってもこの話、受けるかい？」"}],"source":"bangumi","sourceCharacterId":"46718"}],"profileFacts":[{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"5646","sourceWorkId":"21352","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7dc9601f997d2b8e9d8d84a5c12b8159e3f748ee7f9454465ba5ccdecaf4200f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c36f29f95866d691c11b2f5c94cab9ffd5ba0cb7d73f3d6530cfe0b2bc4dbbd.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井晴美","creatorId":"vndb:s518","sourcePersonId":"vndb:s518","canonicalEntityId":"vndb:s518","name":"浅井 晴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:128900:46718:6131:1","source":"bangumi"}]},{"characterId":"char_c41428","characterName":"沙雪","sourceIds":{"bangumi":[{"characterId":"46719","match":"exact-normalized-name-in-linked-work","subjectId":"128900"}],"egsCharacterIds":["5647"],"vndbCharacterId":"c41428"},"originalCharacterName":"沙雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"161"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の養女。幼い頃に戦地で親に捨てられていた所を主人公の気まぐれで拾われ骸谷で育てられる。"},{"spoiler":false,"text":"おとなしく引っ込み思案な性格で、はぐれ谷に来てからもいつも主人公の後に控えて目立たないようにしている。本人にはくのいちとしての訓練などは施されていない。"},{"spoiler":false,"text":"過去に事故で両目を怪我してしまい盲目の身となってしまっているが、主人公の身の回りの世話などをかいがいしく行っている。"}],"source":"egs","sourceCharacterId":"5647","sourceWorkId":"21352","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の養女。 おとなしく引っ込み思案な性格。"},{"spoiler":false,"text":"過去に事故で両目を怪我してしまい、盲目となっている。"},{"spoiler":false,"text":"幼い頃に戦地で親に捨てられたが、主人公の気まぐれで拾われた。"},{"spoiler":false,"text":"それ以降、主人公の身の回りの世話などを甲斐甲斐しく行っている。"},{"spoiler":false,"text":"くのいち としての訓練などは施されていない。"},{"spoiler":false,"text":"「お父（とう）…… 早く、帰ってきてね……」"}],"source":"bangumi","sourceCharacterId":"46719"}],"profileFacts":[{"label":"身高（本版本）","value":"151 cm","valueContext":null,"source":"egs","sourceCharacterId":"5647","sourceWorkId":"21352","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2f/2f35916be72b61952714d513fb202c55ee662d45774d258eb65c59853700f38f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51170c17faeb8237ca1a09fb868d637a51ff0d09cd0d009ae8cbf546513ba4c7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紅月 奏美","creatorId":"vndb:s1652","sourcePersonId":"vndb:s1652","canonicalEntityId":"vndb:s1652","name":"紅月 奏美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:63017","source":"vndb"}]},{"characterId":"char_vndb_c127340","characterName":"九頭神 幻内","sourceIds":{"vndbCharacterId":"c127340"},"originalCharacterName":"九頭神 幻内","characterNameSource":null,"role":"main","status":"source-only-candidate","identity