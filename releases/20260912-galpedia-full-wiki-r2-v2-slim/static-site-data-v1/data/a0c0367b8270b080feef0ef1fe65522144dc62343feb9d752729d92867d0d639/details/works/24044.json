e","relationId":"vndb:vn-staff:129642","source":"vndb"},{"creditedName":"ポリゴン番長","creatorId":"vndb:s42713","sourcePersonId":"vndb:s42713","canonicalEntityId":"vndb:s42713","name":"ニトロアーツ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:129643","source":"vndb"}]},"cast":[{"characterId":"char_c17147","characterName":"湊斗 景明","sourceIds":{"bangumi":[{"characterId":"20955","match":"exact-normalized-name-in-linked-work","subjectId":"3243"}],"egsCharacterIds":["12168"],"vndbCharacterId":"c17147"},"originalCharacterName":"湊斗 景明","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young man secretly working under orders from the prince to subjugate the Silver Star. His Tsurugi is Muramasa. While on a mission, he introduces himself as a policeman working part-time for the Kamakura Police Department."},{"spoiler":true,"text":"Under normal circumstances, he spends his days in his cell at the Kamakura Detention House as an unconvicted prisoner due to committing a variety of crimes, including matricide."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c17147"},{"segments":[{"spoiler":false,"text":"物語の主人公。陰鬱な風貌の青年。"},{"spoiler":false,"text":"警官と称して殺戮者『銀星号』を追うが、その過程で奇怪な殺人を積み重ねる。"}],"source":"egs","sourceCharacterId":"12168","sourceWorkId":"10469","spoiler":false},{"segments":[{"spoiler":false,"text":"物語の主人公。"},{"spoiler":false,"text":"陰鬱な風貌の青年。"},{"spoiler":false,"text":"警官と称して殺戮者『銀星号』を追うが、その過程で奇怪な殺人 を積み重ねる。"}],"source":"bangumi","sourceCharacterId":"20955"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/78298a23b2987eb5e30e51b35e953be69f0f718d6ec5a9a7bd6aab55dd919285.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24e5a273d769db8c25aecdc817d4e1aa356aa7cd9d71101b81eaf78e7ae97b76.webp","width":219,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c17148","characterName":"綾弥 一条","sourceIds":{"bangumi":[],"egsCharacterIds":["12169"],"vndbCharacterId":"c17148"},"originalCharacterName":"綾弥 一条","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ayane Ichijou is a school girl with a strong sense of justice. At first she dislikes Kageaki after witnessing a “cowardly” side of him that didn’t bother to fight back against yakuza, but eventually warms up to him after finding out his identity and becomes his assistant."},{"spoiler":false,"text":"[From"}],"source":"vndb","sourceCharacterId":"c17148"},{"segments":[{"spoiler":false,"text":"鎌倉市内に住む学生。"},{"spoiler":false,"text":"正義感が異常なほど強く、非道を行う者には力の及ぶ限り挑もうとする。"},{"spoiler":false,"text":"景明と出会った当初は、臆病者と思って軽蔑するが、とある事件をきっかけに景明と行動を共にすることになる。"}],"source":"egs","sourceCharacterId":"12169","sourceWorkId":"10469","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/cac112a8a74502c311ff44396802ee92eecd281daab2926edec4c936004b7aaa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d5c722f8badf4d40fd8a2d1087d90435394566b973e4aadf553e38026b72717.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c17150","characterName":"大鳥 香奈枝","sourceIds":{"bangumi":[{"characterId":"20958","match":"exact-normalized-name-in-linked-work","subjectId":"3243"}],"egsCharacterIds":["12170"],"vndbCharacterId":"c17150"},"originalCharacterName":"大鳥 香奈枝","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ootori Kanae is a well-endowed ojou-sama from a rich family with an influential history. She is currently employed in the GHQ as a First Lieutenant, and also ends up assisting Kageaki on his mission. She is well-mannered and walks around with an old lady as a personal servant, and likes to tease and flirt with Kageaki for fun."},{"spoiler":false,"text":"[From"}],"source":"vndb","sourceCharacterId":"c17150"},{"segments":[{"spoiler":false,"text":"流麗な長身を持つ女性。"},{"spoiler":false,"text":"大和の名族大鳥家の娘だが、現在はGHQに所属している。"},{"spoiler":false,"text":"とある任務の最中に景明と出会い、以後彼に好意を示して何それとなく近付く。"},{"spoiler":false,"text":"コントラバスの演奏が趣味。"}],"source":"egs","sourceCharacterId":"12170","sourceWorkId":"10469","spoiler":false},{"segments":[{"spoiler":false,"text":"流麗な長身を持つ女性。"},{"spoiler":false,"text":"大和の名族大鳥家の娘だが、現在はGHQに所属している。"},{"spoiler":false,"text":"とある 任務の最中に景明と出会い、以後彼に好意を示して何それとなく近 付く。コントラバスの演奏が趣味。"}],"source":"bangumi","sourceCharacterId":"20958"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f23b17a6cafc6a4b746dfd04c0a1452dcbfde42e1422953650bba887f806c2da.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/10b8d17ed16346aa528ac302811e329acaed0c47b4833cd5773b212f067b0c76.webp","width":219,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c20932","characterName":"菊池 明尭","sourceIds":{"vndbCharacterId":"c20932"},"originalCharacterName":"菊池 明尭","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The chief of the Kamakura Police Department and the boss of Kageaki. He also serves as an adviser to the Imperial Prince."}],"source":"vndb","sourceCharacterId":"c20932"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/540eece69ee85dc3783d0632db325f423da2009bacc92fc403f0bc32961d7b05.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/236038fccf93c84d7c30002581795168c577e7031359c4107b5775ab76417593.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c20952","characterName":"村正","sourceIds":{"vndbCharacterId":"c20952"},"originalCharacterName":"村正","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Third-generation Seishuusengou Uemon-no-jou Muramasa. Female. She was once housed in the depths of the Minato residence, but due to various circumstances, made a contract with Kageaki. The two of them are now working together as partners in stopping the Silver Star."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c20952"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/11/119f46d4e7c37e8a22844b2faeff33b611f0b5cdfc116a39386bbeb3c2a6fe28.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/22/22cbf6ed7cc48893f84f93c700092dbb6068af3e1ce7b7335b8c6109e76975ff.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c21179","characterName":"オーリガ","sourceIds":{"vndbCharacterId":"c21179"},"originalCharacterName":"オーリガ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","va