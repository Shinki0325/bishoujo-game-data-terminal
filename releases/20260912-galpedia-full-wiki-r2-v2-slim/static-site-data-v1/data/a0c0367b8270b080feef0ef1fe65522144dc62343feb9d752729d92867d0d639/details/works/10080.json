{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"10080","model":{"presentationWorkId":"vndb:v1721","staff":{"artwork":[{"creditedName":"うさみ☆","creatorId":"vndb:s13282","sourcePersonId":"egs:creator:4748","canonicalEntityId":"vndb:s13282","name":"うさみ☆","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:62400","source":"egs"}],"scenario":[{"creditedName":"鈴菜 萌","creatorId":"vndb:s11595","sourcePersonId":"vndb:s11595","canonicalEntityId":"vndb:s11595","name":"鈴菜 萌","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:27736","source":"vndb"}],"music":[],"other":[{"creditedName":"榎津まお","creatorId":"vndb:s106","sourcePersonId":"egs:creator:6012","canonicalEntityId":"vndb:s106","name":"榎津まお","detail":"主題歌 「あわだっちゃ☆パニクリバニラ」","roleCode":"vocalist","roleLabel":"歌手","identityStatus":"auto-confirmed","relationId":"egs:work-creator:106090","source":"egs"},{"creditedName":"榎津 まお","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:27735","source":"vndb"}]},"cast":[{"characterId":"char_c7673","characterName":"たまも","sourceIds":{"bangumi":[{"characterId":"134222","match":"exact-normalized-name-in-linked-work","subjectId":"448082"}],"egsCharacterIds":["19119"],"vndbCharacterId":"c7673"},"originalCharacterName":"たまも","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A self-proclaimed nine-tailed-fox that recently began haunting the protagonist. Her powers seem to have disappeared, and though she's stuck in this miniature body, she's apparently a powerful spirit from hundreds of years ago. She's got an innocent personality...well, she's actually a bit of an idiot."}],"source":"vndb","sourceCharacterId":"c7673"},{"segments":[{"spoiler":false,"text":"ひょんなことから主人公に取り憑いた、“自称”九尾の狐。"},{"spoiler":false,"text":"数百年を生きる大妖怪で、強い妖力を持っている……ハズなのだが、何故かその力のほとんどが失われている。"},{"spoiler":false,"text":"性格は天真爛漫……と言えば聞こえはいいが、ストレートに言うと、おバカで自己中。"}],"source":"egs","sourceCharacterId":"19119","sourceWorkId":"10080","spoiler":false},{"segments":[{"spoiler":false,"text":"ふとしたきっかけで主人公に取り憑いた、自称九尾の狐。"},{"spoiler":false,"text":"なぜか妖力が殆ど失われていて、ちみっこい姿になっているが、"},{"spoiler":false,"text":"これでも数百年生きる大妖怪らしいけど…。"},{"spoiler":false,"text":"性格は天真爛漫、といえば聞こえはいいが、いたってバカ。"}],"source":"bangumi","sourceCharacterId":"134222"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5cd301f84170263d7bd3ca00cdb2f3f0200554223fb6c52bfd396c484f27129.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/4348be870ef90905ff5546bb6a156bba18890567ea9b0c4c11eec737b079c3ae.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:448082:134222:6409:1","source":"bangumi"}]},{"characterId":"char_c7676","characterName":"此花　咲姫","sourceIds":{"bangumi":[{"characterId":"134223","match":"exact-normalized-name-in-linked-work","subjectId":"448082"}],"egsCharacterIds":["19120"],"vndbCharacterId":"c7676"},"originalCharacterName":"此花　咲姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's childhood friend. When the protagonist left home, she began working at the local cafe, Swallowtail. Saki has a very strong and energetic image, but secretly harbors feelings for the protagonist. She often plays the role of \"tsukkomi\" (voice of reason/straight man) for him as well."}],"source":"vndb","sourceCharacterId":"c7676"},{"segments":[{"spoiler":false,"text":"主人公の幼馴染で「スワローテイル」スタッフの一人。"},{"spoiler":false,"text":"主人公へのツッコミ役で、いつでも強気なイメージがあるが、その裏では、誰よりも彼を想う気持ちが隠されている。"},{"spoiler":false,"text":"とある事がきっかけで、主人公を取られてしまわないか焦り出し……。"}],"source":"egs","sourceCharacterId":"19120","sourceWorkId":"10080","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の幼馴染。"},{"spoiler":false,"text":"主人公が町を離れている間も、ずっとスワローテイルで働いていた。"},{"spoiler":false,"text":"いつも強気なイメージだが、その裏には誰より主人公を思う心が隠されている。"},{"spoiler":false,"text":"主人公の良きツッコミ役。"},{"spoiler":false,"text":"とある事をきっかけに主人公を取られてしまわないかと、焦りだしてしまう。"}],"source":"bangumi","sourceCharacterId":"134223"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e40c65a88ab41b6d84c17c9d618686c8135f2b7fa0f9d4e974610bca76430f35.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/41651613ca0a9bf6994a3d4d29c54d48961c05b704a81a1bc6bddfbaa55e9b0d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:448082:134223:6106:1","source":"bangumi"}]},{"characterId":"char_c7677","characterName":"生野　シエラ","sourceIds":{"bangumi":[{"characterId":"134224","match":"exact-normalized-name-in-linked-work","subjectId":"448082"}],"egsCharacterIds":["19121"],"vndbCharacterId":"c7677"},"originalCharacterName":"生野　シエラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A talented patissier working at Swallowtail. She's very relaxed and lives at her own pace, and has a sort of elegance to her. Many consider her true power to be her large breasts, though. Apparently she's already dating someone, but things aren't going very well between the two of them."}],"source":"vndb","sourceCharacterId":"c7677"},{"segments":[{"spoiler":false,"text":"「スワローテイル」で腕を振う敏腕パティシエ。"},{"spoiler":false,"text":"マイペースでおっとりした性格だが、年上の貫録と、見る者を圧倒するほどに、たわわに実った胸で現在の「スワローテイル」の実質的な責任者になっている。"},{"spoiler":false,"text":"付き合っている恋人がいるが、最近あまりうまくいっていない様子で……。"}],"source":"egs","sourceCharacterId":"19121","sourceWorkId":"10080","spoiler":false},{"segments":[{"spoiler":false,"text":"スワローテイルにある全てのケーキを作る敏腕パティシエ。"},{"spoiler":false,"text":"マイペースでおっとりとした性格と、年上の貫禄、それから見るものを圧倒する"},{"spoiler":false,"text":"豊満な胸で事実上スワローテイルの実権を握っている。"},{"spoiler":false,"text":"実は現在付き合っている恋人がいるらしいが、どうも最近うまく行っていないらしい。"}],"source":"bangumi","sourceCharacterId":"134224"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/8252ebea38aacee3ae28e0148a2283eaa77d271e76ad48394aa14750dea5817d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/62/62164cc5a66d77c7a4a1832ea85cf5c4dab6049d07b411089096ebb658642a59.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山内 花梨","creatorId":"vndb:s2980","sourcePersonId":"vndb:s2980","canonicalEntityId":"vndb:s2980","name":"山内 花梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14484","source":"vndb"}]},{"characterId":"char_c7678","characterName":"曽根崎　命","sourceIds":{"bangumi":[{"characterId":"134225","match":"exact-normalized-name-in-linked-work","subjectId":"448082"}],"egsCharacterIds":["19122"],"vndbCharacterId":"c7678"},"originalCharacterName":"曽根崎　命","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's underclassman. After seeing him at school during club activities, she had a bit of a crush on him, but hid these feelings once he moved away. But after reuniting with him, these feelings have resurfaced, and she began working at Swallowtail to get closer to him."}],"source":"vndb","sourceCharacterId":"c7678"},{"segments":[{"spoiler":false,"text":"主人公の学生時代の後輩。"},{"spoiler":false,"text":"部活に打ち込む主人公の姿に憧れて、ずっと想い続けてきた。"},{"spoiler":false,"text":"しかし彼が実家を離れてからは、会う機会もなくなり、その想いを胸の奥にしまい込んだのだが、帰ってきた主人公と再会を果たすと、その想いが再び燃え上がって……。"}],"source":"egs","sourceCharacterId":"19122","sourceWorkId":"10080","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の後輩。"},{"spoiler":false,"text":"主人公が部活に打ち込む姿を見てから、ずっと淡い気持ちを抱き続けていたが、"},{"spoiler":false,"text":"主人公が実家を離れてからはその想いを胸の奥へしまいこんでいた。"},{"spoiler":false,"text":"そして、主人公との再会を果たす事で、その思いが再び燃え上がり、"},{"spoiler":false,"text":"スワローテイルへと通うようになる。"}],"source":"bangumi","sourceCharacterId":"134225"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/1244bd762aac597b468874fdd4b50dd8597b95862e87869984fb2079b78a54b9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6a4d21afe8fefd70b024b5627841bdb5954611fa6c66b10b452741bc40f72d8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"平山ゆかり","creatorId":"vndb:s285","sourcePersonId":"vndb:s285","canonicalEntityId":"vndb:s285","name":"東かりん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:448082:134225:5905:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p686","sourceCompan