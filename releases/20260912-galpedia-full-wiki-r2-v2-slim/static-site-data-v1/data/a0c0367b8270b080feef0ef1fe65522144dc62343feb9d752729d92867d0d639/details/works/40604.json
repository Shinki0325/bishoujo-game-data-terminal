"static-detail"},"actors":[{"creditedName":"江崎 クレア","creatorId":"vndb:s1089","sourcePersonId":"vndb:s1089","canonicalEntityId":"vndb:s1089","name":"浅倉 杏美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:100129","source":"vndb"}]},{"characterId":"char_vndb_c20566","characterName":"新田 剣丞","sourceIds":{"vndbCharacterId":"c20566"},"originalCharacterName":"新田 剣丞","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main protagonist of the Sengoku†Koihime series, a student at Franchesca Academy and Kazuto's nephew. He serves the Oda Clan as a retainer and general and is assigned the leader of the Kensuke Squad."},{"spoiler":true,"text":"He was trained extensively and harshly by Hongou Kazuto's many wives (all the girls from Shin Koihime Musou), and while he isn't a match for them, he is more than skilled enough to make him an above-average warrior in the Sengoku era."},{"spoiler":false,"text":"Kensuke possesses a varied lineup of skills ranging from weaponscraft and tactics to cooking and the making of simple devices like smoke bombs and signal flares. He is also brave and level-headed, tending to take circumstances as they come without letting them get him down. He has inherited his uncle's natural philandering ways (though he protests this frequently when others point it out to him), and he gathers women without even realizing he is doing it."}],"source":"vndb","sourceCharacterId":"c20566"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/89934f888f7873c3b4a190174f0290d5f2dafce47c4ce8aabc2297e579fab2bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8ce40af7b416e7f3e52f4c02139930326084d5e031d70cd04552e55c04ec6a49.webp","width":256,"height":241,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c20583","characterName":"足利 一葉 義輝","sourceIds":{"vndbCharacterId":"c20583"},"originalCharacterName":"足利 一葉 義輝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Kazuha is the head of the Ashikaga Clan, shogun of the Ashikaga Shogunate, and one of the main female protagonists and main heroines in the Sengoku†Koihime series. She is whimsical, impulsive, and fundamentally a person that needs looking after. That job generally goes to her attendant, Yuu, who takes care of most of the details."},{"spoiler":false,"text":"She is a master of the blade and a student of Tsukahara Bokuden. She is far more at ease giving a beat-down to thugs in the streets than sitting behind a curtain in the palace."}],"source":"vndb","sourceCharacterId":"c20583"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/6561bdad932315a029ad3ced1375288b298484af69f8610e177ce4894cb3e7a6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0c/0ca78ea044c6877292788a1c283b419b443c2fd88f9a6c479d0d7c5b820c4e23.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"遥 そら","creatorId":"vndb:s195","sourcePersonId":"vndb:s195","canonicalEntityId":"vndb:s195","name":"仙台 エリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:100114","source":"vndb"}]},{"characterId":"char_vndb_c20584","characterName":"足利 双葉 義秋","sourceIds":{"vndbCharacterId":"c20584"},"originalCharacterName":"足利 双葉 義秋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Futaba is the strategist of the Ashikaga Clan and Kazuha's younger sister."}],"source":"vndb","sourceCharacterId":"c20584"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/54/54c6d92f8009510a5c11dc87d6fffba843287cbf7478f16d06c2a31dd01ad962.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cc1d5abf722eab07b190403e6578ecd6e757b60ed91885f82f9ea24a9c1e817.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"江崎 クレア","creatorId":"vndb:s1089","sourcePersonId":"vndb:s1089","canonicalEntityId":"vndb:s1089","name":"浅倉 杏美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:100128","source":"vndb"}]},{"characterId":"char_vndb_c20586","characterName":"細川 与一郎 幽 藤孝","sourceIds":{"vndbCharacterId":"c20586"},"originalCharacterName":"細川 与一郎 幽 藤孝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Yuu is a retainer and general in the Ashikaga Clan."}],"source":"vndb","sourceCharacterId":"c20586"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/5726fd0cc13f3e67ad1591b0bff0f234ecdd4b6c91d9205c10a2a723718130a9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/138aef637af004977ebe923ff492a2888a828cc6f602ba9c00808cab8a326056.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桐谷 華","creatorId":"vndb:s196","sourcePersonId":"vndb:s196","canonicalEntityId":"vndb:s196","name":"種﨑 敦美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:100115","source":"vndb"}]},{"characterId":"char_vndb_c20597","characterName":"今川 彦五郎 鞠 氏真","sourceIds":{"vndbCharacterId":"c20597"},"originalCharacterName":"今川 彦五郎 鞠 氏真","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mari is the daughter of Imagawa Yoshimoto, who was defeated by Kuon at the Battle of Dengaku Hazama. While her manner is childish and innocent, she was raised as a leader first and foremost. As the child of a daimyo, she was raised to see death in battle as a matter of course and an inevitability of fate."},{"spoiler":true,"text":"As such, she does not resent the loss of her mother, though she does grieve."},{"spoiler":false,"text":"Like Kazuha, she as a student of Tsukahara Bokuden and is a master of the sword."}],"source":"vndb","sourceCharacterId":"c20597"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/4565f91eb6a0fded736d5c2ec5820ff109ab8cf8c3c0383ff8fe87ec83fc3d0f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51ea62ac5a354293fa80d03df46f77cf84cd7d5a9e2fe88818ffffaa0fa20501.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真宮 ゆず","creatorId":"vndb:s1030","sourcePersonId":"vndb:s1030","canonicalEntityId":"vndb:s1030","name":"柏木 美優","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:100124","source":"vndb"}]},{"characterId":"char_vndb_c20604","characterName":"蒲生 忠三郎 梅 賦秀","sourceIds":{"vndbCharacterId":"c20604"},"originalCharacterName":"蒲生 忠三郎 梅 賦秀","characterNameSource":null,"role":"primary","status":"source-only-candida