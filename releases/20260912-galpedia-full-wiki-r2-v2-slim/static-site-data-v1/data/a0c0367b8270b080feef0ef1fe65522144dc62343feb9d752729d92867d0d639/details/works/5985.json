:null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"26518","sourceWorkId":"5985","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"26518","sourceWorkId":"5985","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"26518","sourceWorkId":"5985","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"44 kg","valueContext":null,"source":"egs","sourceCharacterId":"26518","sourceWorkId":"5985","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e469b80981d9126b1f873cd9517c12c684ca73413d053b1524578c67d3d2b62.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/094b07083c0a49183c32038b5ec9b634f46cb7b1162005920730739b501007db.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"嶋崎はるか","creatorId":"vndb:s1013","sourcePersonId":"vndb:s1013","canonicalEntityId":"vndb:s1013","name":"嶋崎 はるか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218176:190800:6302:1","source":"bangumi"}]},{"characterId":"char_c102568","characterName":"久坂 綾乃","sourceIds":{"bangumi":[{"characterId":"190801","match":"exact-normalized-name-in-linked-work","subjectId":"218176"}],"egsCharacterIds":["26519"],"vndbCharacterId":"c102568"},"originalCharacterName":"久坂 綾乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"6/6"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の後輩。藤乃の妹。"},{"spoiler":false,"text":"物静かな姉とは対照的に、明朗快活で積極的な女の子。"},{"spoiler":false,"text":"オプチミスト（楽天家）で、好きな言葉は「なんとかなる」。"},{"spoiler":false,"text":"気さくで誰かれなく親しく接するものの、あまり深く関わろうとしない。"},{"spoiler":false,"text":"姉に対して、若干、コンプレックスを抱いているようだ。"}],"source":"egs","sourceCharacterId":"26519","sourceWorkId":"5985","spoiler":false},{"segments":[{"spoiler":false,"text":"修一郎の後輩で藤乃の妹。一年生。"},{"spoiler":false,"text":"姉の藤乃とは対照的に、活発で積極的な性格の持ち主。外見的にも生気に満ちあふれており、身体を動かすことが好き。"},{"spoiler":false,"text":"世渡り上手で今風な女の子。天性の楽天家で、好きな言葉は「なんとかなる」。ある意味で無責任。雰囲気も気さくなので、周囲からの人気も高い。が、相手が一線を越えて深く踏みこもうとするとかわしてしまう。"},{"spoiler":false,"text":"姉の藤乃に対しては、ややコンプレックス気味。"}],"source":"bangumi","sourceCharacterId":"190801"}],"profileFacts":[{"label":"胸围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"26519","sourceWorkId":"5985","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"26519","sourceWorkId":"5985","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"26519","sourceWorkId":"5985","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"26519","sourceWorkId":"5985","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"46 kg","valueContext":null,"source":"egs","sourceCharacterId":"26519","sourceWorkId":"5985","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8c87d431b9f2834af8d80d5ae4372af691318818af92b3d43e72353d655f8dc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d5aa95b76b444c111da4d94a7081f9689aefc6dfed338c07a5ad31c864704d5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"Rita","creatorId":"vndb:s102","sourcePersonId":"vndb:s102","canonicalEntityId":"vndb:s102","name":"平井 理子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218176:190801:5742:1","source":"bangumi"}]},{"characterId":"char_c102569","characterName":"小日向 ころな","sourceIds":{"bangumi":[{"characterId":"190802","match":"exact-normalized-name-in-linked-work","subjectId":"218176"}],"egsCharacterIds":["26520"],"vndbCharacterId":"c102569"},"originalCharacterName":"小日向 ころな","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"4/1"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公のクラスメイトにして、幼馴染。"},{"spoiler":false,"text":"家庭創作料理研究部に所属しているが、主人公のサークルにも名前だけ在籍となっている。"},{"spoiler":false,"text":"何かと不器用な主人公を心配し、母親のような気持ちで世話を焼いてくれる。"},{"spoiler":false,"text":"手先だけでなく、人間関係もそつなく器用にこなしているが、逆にこれといった強い個性がないことにコンプレックスを抱いている。"}],"source":"egs","sourceCharacterId":"26520","sourceWorkId":"5985","spoiler":false},{"segments":[{"spoiler":false,"text":"修一郎のクラスメイトで腐れ縁の幼なじみ。二年生。"},{"spoiler":false,"text":"家庭創作料理研究部という、地味だが実績のあるサークルと、修一郎のいるサークルをかけもちしている（主体は前者で、後者はほとんど名前を貸しているだけの状態）。"},{"spoiler":false,"text":"努力が空回りになりがちな修一郎のことを、ほとんど母親のような気持ちで心配している。つきあいがよく、なんでもそつなくそれなりにこなすことができるが、逆にこれといって突出したポイントがないことを本人は気にしている。"}],"source":"bangumi","sourceCharacterId":"190802"}],"profileFacts":[{"label":"胸围（本版本）","value":"72 cm","valueContext":null,"source":"egs","sourceCharacterId":"26520","sourceWorkId":"5985","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"150 cm","valueContext":null,"source":"egs","sourceCharacterId":"26520","sourceWorkId":"5985","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"77 cm","valueContext":null,"source":"egs","sourceCharacterId":"26520","sourceWorkId":"5985","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"26520","sourceWorkId":"5985","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"38 kg","valueContext":null,"source":"egs","sourceCharacterId":"26520","sourceWorkId":"5985","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/9200e2af00f55e422c412da460fc4e41bc30701f2025597111023157cd428f7e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0bab07611caf1b41878bfcbd08557a2162bcbb37af5faba98812b730c91f6595.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中田順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218176:190802:4463:1","source":"bangumi"}]},{"characterId":"char_c102570","characterName":"井上 美由紀","sourceIds":{"bangumi":[{"characterId":"190803","match":"exact-normalized-name-in-linked-work","subjectId":"218176"}],"egsCharacterIds":["26521"],"vndbCharacterId":"c102570"},"originalCharacterName":"井上 美由紀","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ころなの友人で、デザイナー志望の美術少女。"},{"spoiler":false,"text":"当初は美術部に所属していたが、美術部の実態がただの漫研でしかないことに憂いて退部し、アート系のサークルをほぼ彼女一人で旗揚げする。"},{"spoiler":false,"text":"アーティスト志向の強い彼女は、一つのことに熱中し出すとまわりが見えなくなる。神経質で負けず嫌いの頑張り屋だが、他人と協調するのが苦手。"},{"spoiler":false,"text":"当然、彼女のサークルも解散の危機にあり、主人公らのサークルと共闘することに……。"}],"source":"egs","sourceCharacterId":"26521","sourceWorkId":"5985","spoiler":false},{"segments":[{"spoiler":false,"text":"小日向ころなの友人で、修一郎たちのサークルのとなりの部室に巣くうデザイナー志望の美術少女。二年生。"},{"spoiler":false,"text":"美術部の実態がただの漫研であったために退部し、今年になってからほぼ一人でアート系のサークルを旗揚げした。しかし修一郎のサークル同様、活動実績不足で早くも廃部の危機にある。"},{"spoiler":false,"text":"典型的なアーティスト（オタク）気質で、ひとつのものごとに熱中するとまわりのことがなにも見えなくなってしまう。また、一度始めたことは自分の納得がいくレベルまで持っていかないと気が済まない。神経質で負けず嫌いのがんばり屋。人づきあいは苦手。"},{"spoiler":false,"text":"着飾ると美人のくせに、普段は身だしなみに全然気を使っていないため、その事実に気づいている者はほとんどいない（本人も含む）。"}],"source":"bangumi","sourceCharacterId":"190803"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"26521","sourceWorkId":"5985","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"26521","sourceWorkId":"5985","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"26521","sourceWorkId":"5985","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"26521","sourceWorkId":"5985","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"47 kg","valueContext":null,"source":"egs","sourceCharacterId":"26521","sourceWorkId":"5985","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cfb495ad6c6e5d4d70b8b6e44dc8e5c24d0e077d9c81af5996b799c34e2e9198.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/893ee146c3cbbdb81308d4941df0001c0e1c9db3da264c3f12b2d6e92250d1a4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218176:190803:5741:1","source":"bangumi"}]},{"characterId":"char_c102571","characterName":"黒崎 夕","sourceIds":{"bangumi":[{"characterId":"190804","match":"exact-normalized-name-in-linked-work","subjectId":"218176"}],"egsCharacterIds":["26522"],"vndbCharacterId":"c102571"},"originalCharacterName":"黒崎 夕","characterNameSource":null,"role":"primary","status":"source-only-candidat