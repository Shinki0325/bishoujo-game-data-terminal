staff:1413","source":"vndb"},{"creditedName":"たけじん","creatorId":"vndb:s47087","sourcePersonId":"vndb:s47087","canonicalEntityId":"vndb:s47087","name":"たけじん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:1414","source":"vndb"},{"creditedName":"安威 拓郎","creatorId":"vndb:s47089","sourcePersonId":"vndb:s47089","canonicalEntityId":"vndb:s47089","name":"安威 拓郎","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:1415","source":"vndb"},{"creditedName":"ひろりん","creatorId":"vndb:s47094","sourcePersonId":"vndb:s47094","canonicalEntityId":"vndb:s47094","name":"ひろりん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:1416","source":"vndb"},{"creditedName":"株式会社ブリコ","creatorId":"vndb:s47103","sourcePersonId":"vndb:s47103","canonicalEntityId":"vndb:s47103","name":"株式会社ブリコ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:1417","source":"vndb"},{"creditedName":"㌧様","creatorId":"vndb:s47113","sourcePersonId":"vndb:s47113","canonicalEntityId":"vndb:s47113","name":"㌧様","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:1418","source":"vndb"}]},"cast":[{"characterId":"char_c465","characterName":"おねーさま","sourceIds":{"bangumi":[{"characterId":"35778","match":"exact-normalized-name-in-linked-work","subjectId":"11627"}],"egsCharacterIds":["24868"],"vndbCharacterId":"c465"},"originalCharacterName":"おねーさま","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"526"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Saku’s self-proclaimed wife. Appearing on day one in Saku's house, she is a frank, straight girl that is good with housekeeping. While very knowledgeable, she lacks a bit of common sense. Her nickname at school, the Super Saintly Sister, perhaps describes her the best. She represents Gemini."},{"spoiler":false,"text":"from warum's review."},{"spoiler":true,"text":"Her real surname is 雲戌亥 (Kumoinui), which Saku is unable to perceive correctly at first."}],"source":"vndb","sourceCharacterId":"c465"},{"segments":[{"spoiler":false,"text":"唐突に「オマエのヨメだ」と主人公の前に現れた少女。"},{"spoiler":false,"text":"主人公が入居したばかりの屋敷に結婚を前提として引っ越してきた。"},{"spoiler":false,"text":"家事全般が得意……、というよりも家事ジャンキー。"},{"spoiler":false,"text":"感情表現に乏しく、無表情になっていることが多い。"},{"spoiler":false,"text":"言葉選びが壊滅的なまでに下手で、結果的に毒舌女としての不名誉なレッテルを貼られ、「裏ボランティア」「逆懺悔僧（ぎゃくさんげそう）」「超聖母（ちょうせいぼ）」と数々の異名を持つ。"}],"source":"egs","sourceCharacterId":"24868","sourceWorkId":"8025","spoiler":false},{"segments":[{"spoiler":false,"text":"「オマエのヨメだ」と、策の前へ唐突に現れた少女。"},{"spoiler":false,"text":"とにかく無表情で、入居したばかりの屋敷に結婚を前提として引っ越してきた。"},{"spoiler":false,"text":"結婚を意識しているからか自ら進んで家事を引き受け、文句一つ言わず見事にこなす、家事全般が得意な少女……というか、家事ジャンキー。"},{"spoiler":false,"text":"得意技は「善意の追い込み」。「コミュニケーションにおける妥当な言葉の選択」が根本的に間違っているので、本人は慰めているつもりだが、"},{"spoiler":false,"text":"相手に逆効果なのは勿論、最悪、自殺寸前まで追い込んだりする。だが、やっている事そのものはとても思いやりに溢れている。"},{"spoiler":false,"text":"その為、『裏ボランティア』『逆懺悔僧（ぎゃくさんげそう）』『超聖母』などと数々の異名で呼ばれている。"},{"spoiler":false,"text":"『双子座』の天文委員であり、策を騒動に巻き込む張本人。"},{"spoiler":false,"text":"「知らないのか？本当に無知なオトコだな。"},{"spoiler":false,"text":"ヨメというのは、無休無給で一生こき使われる家政婦の総称だぞ？」"}],"source":"bangumi","sourceCharacterId":"35778"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5c08824270c99d92b85253436ce284e9d9909e9eb226370cf5c2929619de209.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6a/6abaac017504f250d23f786c56eaa9cd1be77553aa0bf9533b2a4893134cb907.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"高野直子","creatorId":"vndb:s14","sourcePersonId":"vndb:s14","canonicalEntityId":"vndb:s14","name":"高野 直子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11627:35778:4031:1","source":"bangumi"}]},{"characterId":"char_c469","characterName":"お姉様","sourceIds":{"bangumi":[{"characterId":"35779","match":"exact-normalized-name-in-linked-work","subjectId":"11627"}],"egsCharacterIds":["24869"],"vndbCharacterId":"c469"},"originalCharacterName":"お姉様","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"902"},"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The yamato nadeshiko heroine, classmate of Saku. Her grace and intellect can be felt just from her speech, always using words at it’s primitive meaning. Though usually calm and mild, she gets into fights with Futami (often with Futami not even realizing it). Also possess a secret with Saku, perhaps the reason as to why she panics around him? ;)"},{"spoiler":false,"text":"From Warum's review."}],"source":"vndb","sourceCharacterId":"c469"},{"segments":[{"spoiler":false,"text":"空明市における名家・桜守姫家の息女。"},{"spoiler":false,"text":"未だ成功者のいない「照陽菜」（夜空の雲を掃う事を目的とした行事）を「彼女ならもしかして……」と周囲から期待されている。"},{"spoiler":false,"text":"その優雅な立ち振る舞いから育ちの良さを感じさせ、理知的にして良識ある気遣いが窺い知れる人格者。自分を「わらわ」と呼ぶなど、お嬢様というよりもお姫様といった感じの女の子。"},{"spoiler":false,"text":"何故か、初対面の主人公に対して嫌われるような発言を繰り返すが、その真意は？"}],"source":"egs","sourceCharacterId":"24869","sourceWorkId":"8025","spoiler":false},{"segments":[{"spoiler":false,"text":"空明市における名家・桜守姫家の息女。"},{"spoiler":false,"text":"古い歴史を持ちながら、未だ成功者のいない『照陽菜』──しかし「彼女ならば、もしかして」と期待されている『乙女座』の天文委員。"},{"spoiler":false,"text":"立ち居振る舞いは非常に優雅であり、育ちのよさと共に理知的・良識ある気遣いがうかがい知れる人格者で、常に周囲から尊敬と羨望を集める。"},{"spoiler":false,"text":"その様は「お嬢様」というよりも、策曰く「物語から飛び出したお姫様」。彼女のすごいところはその風貌にまったく違和感がない事であるのだが、"},{"spoiler":false,"text":"初対面のはずの策を前にしてひどく動揺し、なぜか嫌われる方向へ努力を始めた。"},{"spoiler":false,"text":"とはいっても他人を侮辱・中傷するような言動をそもそも取る事をしない（できない）性格であるので、本人は頑張っているつもりなのだが、"},{"spoiler":false,"text":"素敵に弾けた空回りっぷりを見せる。彼女の今後の課題は、もっとひどい事が言えるようになる事である。"},{"spoiler":false,"text":"「こ、これだけ申し上げてもおわかりになられませんか。"},{"spoiler":false,"text":"其方は、ば、ば、ば……、えと、やっぱりこういう言い方は……あっ……お、お馬鹿ですねっ！」"}],"source":"bangumi","sourceCharacterId":"35779"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d762c4634f06938d1df3e91a99273d42b8ca32e4ae957268673a9fb81799c206.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/319cd8353fc9d401c014a3da10e0f170a9ec1a2fb59670fcd9f16531c15e3a1e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828","name":"きみづか 縁","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11627:35779:6036:1","source":"bangumi"}]},{"characterId":"char_c470","characterName":"おねさま","sourceIds":{"bangumi":[{"characterId":"35780","match":"exact-normalized-name-in-linked-work","subjectId":"11627"}],"egsCharacterIds":["24870"],"vndbCharacterId":"c470"},"originalCharacterName":"おねさま","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"808"},"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"hip":{"reviewState":"source-only","source":"vndb","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The mysterious oneesan who possess a even more mysterious umbrella (rumour has it that it connects to the fourth dimension). Kind, caring and smart, San’s presence sweeps away worries and bad atmospheres alike. She is, however, very gluttonous; always seen eating…something out of her umbrella."},{"spoiler":false,"text":"From the Warum's review."},{"spoiler":true,"text":"She received the name San when she became the head of the Asuku Family at 7 years old. Her original name was 晴 Teru."}],"source":"vndb","sourceCharacterId":"c470"},{"segments":[{"spoiler":false,"text":"独特の雰囲気を持つ、おっとりした先輩。"},{"spoiler":false,"text":"誰にでも分け隔てなく優しい良きお姉さん。"},{"spoiler":false,"text":"彼女が居るだけで例え険悪なムードであっても途端に癒してしまう。"},{"spoiler":false,"text":"いつものんびりにこにこしているが、かなり食い意地が張っている。"}],"source":"egs","sourceCharacterId":"24870","sourceWorkId":"8025","spoiler":false},{"segments":[{"spoiler":false,"text":"独特の不思議オーラを振り撒く、おっとりとした先輩。策の一つ年上で、『獅子座』の天文委員。"},{"spoiler":false,"text":"分け隔てなく誰にでも優しい皆のよきお姉さんで、ふたみには殊の外に慕われている。"},{"spoiler":false,"text":"ときどき突拍子もない事を言い出すが、彼女が口にすると本当にそうなのではないかと思えてしまうから不思議だ──。"},{"spoiler":false,"text":"周囲がどれほど険悪なムードであっても、ただそこにいるだけで癒してしまう。"},{"spoiler":false,"text":"その時点ですでに、彼女のアスク時空に呑み込まれているという事なのだが。"},{"spoiler":false,"text":"恐ろしいほど食い意地が張っており……というか、そんな次元はすでに超越している食の王者。"},{"spoiler":false,"text":"彼女が肌身離さず持っている和傘は謎が多く、なかから様々なものが飛び出す。"},{"spoiler":false,"text":"「恋人とか、夫婦とか──片思いの相手とか、友達とか、そんな事は関係ないよ。"},{"spoiler":false,"text":"自分の心にいつの間にか住み着いちゃった人は、やっぱり大切な存在なの」"}],"source":"bangumi","sourceCharacterId":"35780"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15ba5e18a1409c70d4932e6fa965051c77169b7d7b7568c34747a374c35fbf96.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b6/b6b8dcf19ea0d55b3738c7d3e6054b20cde820757e911cd942ec51689acd0eed.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11627:35780:4675:1","source":"bangumi"}]},{"characterId":"char_c493","characterName":"めかけさん","sourceIds":{"bangumi":[{"characterId":"35781","match":"exact-normalized-name-in-linked-work","subjectId":"11627"}],"egsCharacterIds":["24871"],"vndbCharacterId":"c493"},"originalCharacterName":"めかけさん","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"73"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AA"},"hip":{"reviewState":"source-only","source":"vndb","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Aries of a Astronomy Club member. Simplistic mind. Doesn't like Ousuki family."},{"spoiler":false,"text":"Roughly translated some parts from Chinese wikipedia."}],"source":"vndb","sourceCharacterId":"c493"},{"segments":[{"spoiler":false,"text":"空明市の人々の願いが形となった幻想的な空間「空明の里」管理者の娘。"},{"spoiler":false,"text":"常に元気いっぱいで、屈託のない笑顔で周囲を明るい気分にさせるムードメーカー。"},{"spoiler":false,"text":"学園最強の武闘派という噂も……。"}],"source":"egs","sourceCharacterId":"24871","sourceWorkId":"8025","spoiler":false},{"segments":[{"spoiler":false,"text":"ふたみに懐いている『牡羊座』の天文委員。友達にはメメと呼ばれる。この街の願いが形となった幻想的な空間、『空明の里』管理者の娘。"},{"spoiler":false,"text":"常に元気いっぱいで明るく、屈託のない笑顔で笑うムードメーカー。ただし、ふたみにちょっかいをかけると魔人モードに移行。"},{"spoiler":false,"text":"実は学園最強の武闘派。どうやら此芽をよく思っていないようだが……？"},{"spoiler":false,"text":"「じゃ、策。覚えておいて。愛はいつだって、おねーさまの味方だって事。"},{"spoiler":false,"text":"例えおねーさまが間違っていても、愛はおねーさまの味方をするの。忘れないで」"}],"source":"bangumi","sourceCharacterId":"35781"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/43562eef83c226f147d89a665aa2327dab1e232b2b0092bf4e753b9922f14715.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e522ee1e5a7786102dc0b23eb0e22d1df798947c63a5b6e64bef71610d25b1f3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"なかせひな","creatorId":"vndb:s926","sourcePersonId":"vndb:s926","canonicalEntityId":"vndb:s926","name":"なかせ ひな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11627:35781:12719:1","source":"bangumi"}]},{"characterId":"char_c654","characterName":"トリマキ","sourceIds":{"bangumi":[{"characterId":"35782","match":"exact-normalized-name-in-linked-work","subjectId":"11627"}],"egsCharacterIds":["24872"],"vndbCharacterId":"c654"},"originalCharacterName":"トリマキ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"hip":{"reviewState":"source-only","source":"vndb","value":"87"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Her constellation is Taurus and one of the Astronomy Club. She respects Konome very much."},{"spoiler":false,"text":"Edited from Chinese wikipedia."}],"source":"vndb","sourceCharacterId":"c654"},{"segments":[{"spoiler":false,"text":"みどのの親友。"},{"spoiler":false,"text":"此芽を人生の手本として慕い、此芽に近付きたい欲求からか、その振る舞いや言動も此芽の真似が入っている。"},{"spoiler":false,"text":"とにかく勝気で短気な性格のため、トラブルを招くこともしばしば。"},{"spoiler":false,"text":"何かと此芽に喧嘩を売るふたみに突っかかるが、ふたみが無自覚で喧嘩を売っていることも理解しており、いつも切ない気分になってしまう。"}],"source":"egs","sourceCharacterId":"24872","sourceWorkId":"8025","spoiler":false},{"segments":[{"spoiler":false,"text":"此芽を慕う『牡牛座』の天文委員。みどのの親友。"},{"spoiler":false,"text":"とにかく気が強く、短気な面も手伝ってトラブルを拡大するが、性格的にそう見えないだけで、実はなかなかの頭脳の持ち主。"},{"spoiler":false,"text":"此芽を人生の手本としており、少しでも近付きたいという欲求からか、言動もどこかしら彼女の真似が入っている。"},{"spoiler":false,"text":"会う度に此芽に喧嘩を売るふたみに対して突っかかるが、無自覚で売っている事もなんとなくわかっているので、毎回、なんだか切ない気持ちになる。"},{"spoiler":false,"text":"結構、苦労性なのかもしれない。"},{"spoiler":false,"text":"「そうですっ！ようやくお姉様の偉大さをご理解なされましたかっ!?」"}],"source":"bangumi","sourceCharacterId":"35782"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb64ece8f1f37d8915c2530f718629ce11f27d1a2103f4d9b71d3d4686b9f8d2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/520a7d1c04ba6414d8832075a9440ab021c95341692d345a82a9dad9e8840d73.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"後藤麻衣","creatorId":"vndb:s469","sourcePersonId":"vndb:s469","canonicalEntityId":"vndb:s469","name":"後藤 麻衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11627:35782:4809:1","source":"bangumi"}]},{"characterId":"char_c69145","characterName":"桜守姫 みどの","sourceIds":{"bangumi":[{"characterId":"35783","match":"exact-normalized-name-in-linked-work","subjectId":"11627"}],"egsCharacterIds":["24873"],"vndbCharacterId":"c69145"},"originalCharacterName":"桜守姫 みどの","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"81"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"hip":{"reviewState":"source-only","source":"vndb","value":"82"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Konome's younger sister. Midono is the Cancer member of the Astronomy Club. She is always hiding behind her best friend Non."}],"source":"vndb","sourceCharacterId":"c69145"},{"segments":[{"spoiler":false,"text":"此芽の妹。"},{"spoiler":false,"text":"何かと騒がしく、いつの間にやら話題の中心になっている姉に比べ、極端に影が薄い。"},{"spoiler":false,"text":"かなりの引っ込み思案で内気な性格から、いつも親友ののんの背中に隠れている。"},{"spoiler":false,"text":"堂々と自分の思いを伝えられるのんを羨ましく思っている。"},{"spoiler":false,"text":"姉が大好きだが、その控えめ過ぎる性格から、姉妹でありながら他人行儀な空気を作ってしまっていることが大きな悩み。"}],"source":"egs","sourceCharacterId":"24873","sourceWorkId":"8025","spoiler":false},{"segments":[{"spoiler":false,"text":"いつも親友のんの背後に隠れている、『蟹座』の天文委員。此芽の妹。"},{"spoiler":false,"text":"必然的に周囲に持ち上げられ、気付けば話題の中心となっている姉に比べて極端に影が薄く、性格的にもかなりの引っ込み思案で、"},{"spoiler":false,"text":"消え入りそうな小声で話す。姉が大好きで、いつも影から見つめている。「好き」という気持ちを堂々と表す事ができるのんを羨ましく思っており、"},{"spoiler":false,"text":"自分の性格が姉妹でありながらどこか他人行儀な空気を作ってしまっている事に悩んでいる。"},{"spoiler":false,"text":"「姉に何かご用でも……？」"}],"source":"bangumi","sourceCharacterId":"35783"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7270bdc764f7f54c207818b01780023e25aa48708093740c7e9765ac3abf464.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c28a8d0e772c1443ba3d2c6a646f074469dbb41c712dabfa0ab569df1f03f61f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤咲かおり","creatorId":"vndb:s1182","sourcePersonId":"vndb:s1182","canonicalEntityId":"vndb:s1182","name":"藤咲 かおり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:11627:35783:6105:1","s