."}],"source":"vndb","sourceCharacterId":"c90105"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae3db893c4fd55babed915b16b470c7a1d6aa603e72333178a5ef26ff218e608.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a7516b1147d43d4c5c3059fd4fc379e0a3a3ea22b79e4e6131b028a244e1df13.webp","width":187,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤岡 あかね","creatorId":"vndb:s21023","sourcePersonId":"vndb:s21023","canonicalEntityId":"vndb:s21023","name":"藤岡 あかね","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:83625","source":"vndb"}]},{"characterId":"char_vndb_c90106","characterName":"吹原玲花","sourceIds":{"vndbCharacterId":"c90106"},"originalCharacterName":"吹原玲花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"508"},"bust":{"reviewState":"source-only","source":"vndb","value":"84"},"height":{"reviewState":"source-only","source":"vndb","value":"160"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hiro's junior and the leader and manager of the Syouba High School's cheerleading team. She is self-confident, flamboyant, vivacious, very approachable, and got along well with everyone."}],"source":"vndb","sourceCharacterId":"c90106"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32550e5221ddc44ceba7aaf8cd8c129274ac4cf6afca6364fe25f83ac602727c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06618e452eeca8c105f861ca61c6e74db470fd9c41067071a5c84352786cd8e6.webp","width":180,"height":256,"source":"static-detail"},"actors":[{"creditedName":"涼花 みなせ","creatorId":"vndb:s20164","sourcePersonId":"vndb:s20164","canonicalEntityId":"vndb:s20164","name":"涼花 みなせ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:83624","source":"vndb"}]},{"characterId":"char_vndb_c90107","characterName":"小笹恵","sourceIds":{"vndbCharacterId":"c90107"},"originalCharacterName":"小笹恵","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"birthday":{"reviewState":"source-only","source":"vndb","value":"926"},"bust":{"reviewState":"source-only","source":"vndb","value":"80"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hiro's classmate and student of Syouba High School. She is an individualistic, firm, overbearing, and a bit impulsive person. She is typically not a very good student, but actually was not as bad as she looked. She often caused trouble and started fights because her grades were not very good, and the dean of students often scolded her."},{"spoiler":true,"text":"After she found out about Moe Miyazawa’s relationship with Hiro Fujiwara, she put forth extra effort to slander and humiliate her."}],"source":"vndb","sourceCharacterId":"c90107"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce9f7fce4bbd38c89f2edbf47ab7decc7f20d11cba2fe914c6aab0cee1ba736d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/20/20ab85709bd22f7e03f3c2be5410b727b07732a17b8be938bc5cda1e67ecc34a.webp","width":169,"height":256,"source":"static-detail"},"actors":[{"creditedName":"口谷 亜夜","creatorId":"vndb:s1755","sourc