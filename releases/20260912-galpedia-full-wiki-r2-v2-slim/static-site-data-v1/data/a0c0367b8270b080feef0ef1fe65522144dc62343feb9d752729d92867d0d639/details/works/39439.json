{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"39439","model":{"presentationWorkId":"vndb:v31726","staff":{"artwork":[{"creditedName":"ゆつき","creatorId":"vndb:s25322","sourcePersonId":"egs:creator:40203","canonicalEntityId":"vndb:s25322","name":"ゆつき","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:297983","source":"egs"}],"scenario":[{"creditedName":"館山緑","creatorId":"vndb:s3429","sourcePersonId":"egs:creator:901","canonicalEntityId":"vndb:s3429","name":"館山緑","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:297984","source":"egs"}],"music":[{"creditedName":"シロ","creatorId":"vndb:s6716","sourcePersonId":"vndb:s6716","canonicalEntityId":"vndb:s6716","name":"シロ","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:176392","source":"vndb"}],"other":[{"creditedName":"Lira","creatorId":"vndb:s2543","sourcePersonId":"vndb:s2543","canonicalEntityId":"vndb:s2543","name":"Lira","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:176388","source":"vndb"},{"creditedName":"Lira","creatorId":"vndb:s2543","sourcePersonId":"vndb:s2543","canonicalEntityId":"vndb:s2543","name":"Lira","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:176389","source":"vndb"},{"creditedName":"館山 緑","creatorId":"vndb:s3429","sourcePersonId":"vndb:s3429","canonicalEntityId":"vndb:s3429","name":"館山緑","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:176391","source":"vndb"},{"creditedName":"project lights","creatorId":"vndb:s2542","sourcePersonId":"vndb:s2542","canonicalEntityId":"vndb:s2542","name":"project lights","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:176393","source":"vndb"},{"creditedName":"ゆつき","creatorId":"vndb:s25322","sourcePersonId":"vndb:s25322","canonicalEntityId":"vndb:s25322","name":"ゆつき","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:176394","source":"vndb"}]},"cast":[{"characterId":"char_bangumi_98706","characterName":"なかがみ・りい","sourceIds":{"bangumi":[{"characterId":"98706","match":"source-roster","subjectId":"168609"}]},"originalCharacterName":"なかがみ・りい","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"１４歳。深山学園でたったひとり『転校生』と呼ばれている少女。深山学園近辺の病院の個室に住んでおり、そこから学校へ通っている。周囲には正体不明だと思われている。"},{"spoiler":false,"text":"身長１６６センチ。痩せ型。手足は長い。シルエットだけ見ると男子生徒に見られることもあるが、制服はセーラー服なので間違われない。やや色が白いのと、病院暮らしであることで一部では病弱だと思われているが、本人の体力、運動能力は割と高め。"},{"spoiler":false,"text":"声は澄んだメゾソプラノ。印象に残る声。一人称はわたし。"},{"spoiler":false,"text":"私服の趣味はややスポーティな感じ。"},{"spoiler":false,"text":"バイオコンピュータの実験に協力しており、そのために病院暮らしをしている。"}],"source":"bangumi","sourceCharacterId":"98706"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a73f6ed43e4a925cb4878b9844135a14d07f1e13a476e252968ca97df029a41.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af25db6c9c68cc0c6248ba4305ff01554269af7eb28ce0643eac93bca81cd287.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_98707","characterName":"はいばら・こう","sourceIds":{"bangumi":[{"characterId":"98707","match":"source-roster","subjectId":"168609"}]},"originalCharacterName":"はいばら・こう","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"享年１５歳。理維のクラスメートで、あまり口を利いたことのなかった少年。あまり登校してきていなかったが、理維とは別の意味で特別待遇を受けていて、文句を言われることはなかったが、ゲーム序盤で自殺。"},{"spoiler":false,"text":"身長１７０センチ。痩せ型。髪の毛は黒。理維より色が白い。"},{"spoiler":false,"text":"線の細い感じの声。一人称は僕。"},{"spoiler":false,"text":"引き籠もりレベルに学校に来なくて、インドア派を既に越えている。実習系の教科以外は万年一位。でも学校にほとんど来ない。定期テストの時くらいしかまともに教室へは来ない。"},{"spoiler":false,"text":"理維に思いを寄せており、自分のＰＣを形見に残すが、何の意図があるのかは不明。"}],"source":"bangumi","sourceCharacterId":"98707"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/7279da01f69e60b359f0e49fcbba1d985e80b0cbb5fccb3da7a9a7d1f141879c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1fcd3d7f34bee2d212668745e569a0d04a9f59de6e3d0b6d452f4d02073b354.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_98708","characterName":"なゆた","sourceIds":{"bangumi":[{"characterId":"98708","match":"source-roster","subjectId":"168609"}]},"originalCharacterName":"なゆた","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{},"descriptions":[{"segments":[{"spoiler":false,"text":"劫が理維に対して形見に残した擬似人格ソフト。理維をデフォルメしたような姿をしており、四六時中行動を共にすることになる。一人称はナユタ。"},{"spoiler":false,"text":"グラフィックに関しては劫が適当にデフォルメキャラを生成するツールで作ったらしい。"},{"spoiler":false,"text":"インストールされた後には、声を出さずに会話が可能。"},{"spoiler":false,"text":"案外ぴょこぴょこ跳ねる。"}],"source":"bangumi","sourceCharacterId":"98708"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6d024d0e1778e1126627ad48080e194febe0031e65a94dc38a22897eaa41f70.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1330e240f0ff0fcfcc611509ff4b3bad23b6752eb58f975e3a45336d6f5ede4.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_98709","characterName":"なかがみ・だいご","sourceIds":{"bangumi":[{"characterId":"98709","match":"source-roster","subjectId":"168609"}]},"originalCharacterName":"なかがみ・だいご","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"若くしてアリタ取締役になった有能な男性。理維の義父ということになっている。身長１８２センチ。３８歳。離婚経験があるが現在は独身。理維とは同居していない。"},{"spoiler":false,"text":"性格的にはかなりのリアリストで、一応養女の理維に対しても扱いは不器用。"},{"spoiler":false,"text":"今までは月に一度ほど面会するのみだったが、劫の死をきっかけに頻繁に話すようになる。"}],"source":"bangumi","sourceCharacterId":"98709"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42db695c4df4744587e7cf28a1e9652b1ffc31ba27fa4f08d1bb4cdfef4b3424.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7896f073a8e75b6a9841de0b3e2f512b2316ac634a474aaae6e96725a54183c.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_98710","characterName":"なぞのしょうねん","sourceIds":{"bangumi":[{"characterId":"98710","match":"source-roster","subjectId":"168609"}]},"originalCharacterName":"なぞのしょうねん","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"どこで出逢うとも知れない謎の少年。身長１６８センチ。年齢不詳。氏名不詳。理維にそっくりだが男性。"},{"spoiler":false,"text":"彼の現れる時、理維の周囲に不穏な風が吹くことになる……。"}],"source":"bangumi","sourceCharacterId":"98710"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6e/6ee8848858c22384ffc47ea4664c3a5608e3f4ece5568d37c7852f5bd50f52aa.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f9c9d7d24263e517a4bc203094e1f5cc77380e710cd52816a0b91afde021e23.webp","width":192,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p12189","sourceCompanyId":"egs:brand:4025","canonicalEntityId":"vndb:p12189","name":"granat","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:39439:4025","source":"egs"},{"companyId":"vndb:p12189","sourceCompanyId":"vndb:p12189","canonicalEntityId":"vndb:p12189","name":"granat","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:91166:v31726","source":"vndb"},{"companyId":"vndb:p12189","sourceCompanyId":"vndb:p12189","canonicalEntityId":"vndb:p12189","name":"granat","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:91167:v31726","source":"vndb"},{"companyId":"vndb:p12189","sourceCompanyId":"vndb:p12189","canonicalEntityId":"vndb:p12189","name":"granat","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:91168:v31726","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
