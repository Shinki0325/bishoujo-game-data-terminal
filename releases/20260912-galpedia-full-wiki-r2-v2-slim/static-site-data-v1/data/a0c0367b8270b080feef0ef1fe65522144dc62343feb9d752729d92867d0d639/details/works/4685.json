acterId":"16062","sourceWorkId":"10796","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af1603bd6689dad1257bbfec206401b19a7d17f4fd0330e39ca782c4f0b2421b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a574d65016691135c08a847e819144c04f1b35adfc045e1a194f2c21793c285.webp","width":203,"height":256,"source":"static-detail"},"actors":[{"creditedName":"荒木 幸男","creatorId":"vndb:s1989","sourcePersonId":"vndb:s1989","canonicalEntityId":"vndb:s1989","name":"島香 裕","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5888","source":"vndb"}]},{"characterId":"char_c9845","characterName":"アリア・ヴァンクリフ","sourceIds":{"bangumi":[],"egsCharacterIds":["16052"],"vndbCharacterId":"c9845"},"originalCharacterName":"アリア・ヴァンクリフ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"143"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the protagonist's pupils. She is confident and determined, and to make matters worse, she is rash. However, deep down she is obedient and hard-working. She is a little too self-conscious and often compares herself to others. She likes sweets and cute Western clothing."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9845"},{"segments":[{"spoiler":false,"text":"主人公の弟子。"},{"spoiler":false,"text":"大貴族ヴァンクリフ家の次女。兄２人と姉が一人いる。"},{"spoiler":false,"text":"親に勝手に決められた婚約が嫌で家出し、魔法院に入った。"},{"spoiler":false,"text":"ちょっと勝気で、自信家。無鉄砲。根は素直で努力する性格。"},{"spoiler":false,"text":"好きなものは甘いお菓子とかわいいお洋服＆お着替え。家事は下手。"},{"spoiler":false,"text":"多少自意識過剰で、他人と自分を比べて凹むところがある。"}],"source":"egs","sourceCharacterId":"16052","sourceWorkId":"10796","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/439e4617cac7f5d9005207dac621c7337c2b26b86f5a7371b72ead4158750ae0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3a86841ac8ecf1ffe1b59141ba9fcbe6e665c298dd386170ed94d5c3a0b522a.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野神 奈々","creatorId":"vndb:s124","sourcePersonId":"vndb:s124","canonicalEntityId":"vndb:s124","name":"本井 えみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5869","source":"vndb"}]},{"characterId":"char_c9846","characterName":"カヤ・シャビエ","sourceIds":{"bangumi":[{"characterId":"116280","match":"exact-normalized-name-in-linked-work","subjectId":"16248"}],"egsCharacterIds":["16053"],"vndbCharacterId":"c9846"},"originalCharacterName":"カヤ・シャビエ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"133"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"One of the protagonist's pupils. A simple and serious girl. She is very sensitive and will be deeply moved by little things. She likes naps, stories, and taking baths."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9846"},{"segments":[{"spoiler":false,"text":"主人公の弟子。"},{"spoiler":false,"text":"典型的な巻き込まれ型ヒロイン。"},{"spoiler":false,"text":"閉鎖的な少数民族ロシタリ出身。"},{"spoiler":false,"text":"純血を重んじる一族の中で、混血児だったために村を追われた。"},{"spoiler":false,"text":"魔法の血の濃いロシタリだったということで魔法院に迎えられたが、"},{"spoiler":false,"text":"都会的な魔法院にはなじめなかったようだ。"},{"spoiler":false,"text":"質素で、朴訥で、真面目な女の子。小さなことに感動する。"},{"spoiler":false,"text":"好きなのは昼寝、お話、あとお風呂。"}],"source":"egs","sourceCharacterId":"16053","sourceWorkId":"10796","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の弟子。閉鎖的な少数民族ロシタリ出身。純血を重んじる一族の中で、混血児だったために村を追われることに。母親と死別し、自身も衰弱していたところを魔法院の関係者に発見される。魔法院に迎えられて、ロシタリ語の辞書の編纂に携わるが、多くの人間に囲まれた活動や、都会的な魔法院での生活にはなじめないようだ。"},{"spoiler":false,"text":"質素で素朴、そして真面目な女の子。小さなことに感動できる感受性の豊かさを持つ。好きなことは昼寝、お話、あとはお風呂に入ること。"}],"source":"bangumi","sourceCharacterId":"116280"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/142af835636ea630d53f142a3ced733cebc15419a7a9292b56d36a1ad122755f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e4d6b638a237fc9f730fd87f3435c4cea574f7c187ccb738b2d703b67e7d88db.webp","width":93,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和田カヨ","creatorId":"vndb:s570","sourcePersonId":"vndb:s570","canonicalEntityId":"vndb:s570","name":"西田こむぎ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16248:116280:6045:1","source":"bangumi"}]},{"characterId":"char_c9847","characterName":"フィアンナ・メロワ","sourceIds":{"bangumi":[{"characterId":"116285","match":"exact-normalized-name-in-linked-work","subjectId":"16248"}],"egsCharacterIds":["16054"],"vndbCharacterId":"c9847"},"originalCharacterName":"フィアンナ・メロワ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The emperor's only daughter. Because she can't sense people's ill will, she is friendly to everyone. Since she is a princess, her way of thinking is considerably different than normal people's."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9847"},{"segments":[{"spoiler":false,"text":"現皇帝の一人娘。「花のフィアンナ姫」と呼ばれ、慕われている。"},{"spoiler":false,"text":"天然系。他人の悪意を感じ取れないので、何事も好意的に受け取ってしまう。"},{"spoiler":false,"text":"皇女ゆえ、一般人とは考え方や感じ方がかなり違っている。"},{"spoiler":false,"text":"いつでも躁状態。超前向き。不快という状況がわからない。"},{"spoiler":false,"text":"世の中で一番頭を使うことは、午後のお茶の選択。２番目は文化振興策。"},{"spoiler":false,"text":"他は何も考えていない。"}],"source":"egs","sourceCharacterId":"16054","sourceWorkId":"10796","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef288bc8093a37a2f0d70bd6cecca6fc6ac804b12ea6b09301a410710fc8e851.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0efc05bbf050ecf02fe5076dbaa7fff8f788ff85b52a96c25c809aefaa725512.webp","width":148,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘志穂","creatorId":"vndb:s738","sourcePersonId":"vndb:s738","canonicalEntityId":"vndb:s738","name":"橘 志穂","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16248:116285:7169:1","source":"bangumi"}]},{"characterId":"char_c9848","characterName":"ティエ","sourceIds":{"bangumi":[{"characterId":"116284","match":"exact-normalized-name-in-linked-work","subjectId":"16248"}],"egsCharacterIds":["16055"],"vndbCharacterId":"c9848"},"originalCharacterName":"ティエ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Fianna's maid. She has cat ears and a tail. Her special talent is making tea. She was going to be a slave in the emperor's harem, but she caught Fianna's eye and was made to be her maid."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9848"},{"segments":[{"spoiler":false,"text":"フィアンナ姫お付きのメイド。"},{"spoiler":false,"text":"ねこ耳、ねこしっぽを持つシャオ族出身。"},{"spoiler":false,"text":"耳は頭の上の２つのみ。ぴくぴく動く。"},{"spoiler":false,"text":"特技はお茶を淹れること。"},{"spoiler":false,"text":"皇帝のハーレムに献上される奴隷だったが、"},{"spoiler":false,"text":"フィアンナ姫の目にとまり、そのままお付きのメイドに。"}],"source":"egs","sourceCharacterId":"16055","sourceWorkId":"10796","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b803a8fcb3250ed7242b712f912ecaecd2ad564c1954faa3ce4055dd5088448.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8ef8948b6b8331c3395ff95d4adbab4e332c457254f76c6962a2605ed09d9bc9.webp","width":99,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あおきさやか","creatorId":"vndb:s194","sourcePersonId":"vndb:s194","canonicalEntityId":"vndb:s194","name":"あおきさやか(青木静香)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16248:116284:4869:1","source":"bangumi"},{"creditedName":"門脇 舞以","creatorId":"vndb:s440","sourcePersonId":"vndb:s440","canonicalEntityId":"vndb:s440","name":"杏子御津","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5877","source":"vndb"}]},{"characterId":"char_c9849","characterName":"オリヴィア","sourceIds":{"bangumi":[{"characterId":"116281","match":"exact-normalized-name-in-linked-work","subjectId":"16248"}],"egsCharacterIds":["16057"],"vndbCharacterId":"c9849"},"originalCharacterName":"オリヴィア","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A unique woman who was a gladiator. She was so overwhelmingly popular that she won her freedom from slavery. Now, she is a bounty hunter."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9849"},{"segments":[{"spoiler":false,"text":"異色の女性剣闘士として、奴隷出身ながら圧倒的人気を誇り、自由を勝ち得た。"},{"spoiler":false,"text":"「魔嬢オリヴィア」は剣闘士時代のニックネーム。"},{"spoiler":false,"text":"６匹の猟犬を自在に操り、無敗の伝説を残した。"},{"spoiler":false,"text":"現在は賞金稼ぎを生業にしている。"},{"spoiler":false,"text":"激しい気性。プライドが高い。サディスティック。"}],"source":"egs","sourceCharacterId":"16057","sourceWorkId":"10796","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2a11c28a4b4fe868b550a09321b5eea1f7b11246d37e1b0068e82896e4280f92.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/42c41befbef1032e468b9eab93e0db93aceb86ee909c40a9231bdec688597a3a.webp","width":151,"height":256,"source":"static-detail"},"actors":[{"creditedName":"あらいしずか","creatorId":"vndb:s665","sourcePersonId":"vndb:s665","canonicalEntityId":"vndb:s665","name":"あらい しずか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16248:116281:4647:1","source":"bangumi"}]},{"characterId":"char_c9850","characterName":"オルガ・クローゼ","sourceIds":{"bangumi":[],"egsCharacterIds":["16058"],"vndbCharacterId":"c9850"},"originalCharacterName":"オルガ・クローゼ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A woman able to perform healing miracles since she was a child. She was awarded the title of \"Healing Saint\" by the Vatican. The Vatican deeply trusts her and people love her. She is a simple, serious, and kind Onee-san type."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9850"},{"segments":[{"spoiler":false,"text":"幼い頃から\"癒し\"の奇蹟が使えたため、"},{"spoiler":false,"text":"法王庁から正式に\"癒しの聖女\"の称号を授けられている。"},{"spoiler":false,"text":"聖女は世界に何人もいない存在で、"},{"spoiler":false,"text":"ゆえに法王庁の多大な信頼を受け、また民衆から慕われている。"},{"spoiler":false,"text":"真面目な人。質素で、素朴で、優しいお姉さん。"},{"spoiler":false,"text":"何かあるたびにお祈りを欠かさない。"},{"spoiler":false,"text":"封印が解かれた「黒の塔」の存在を重く見た法王庁から、"},{"spoiler":false,"text":"調査の依頼を受けてやってくる。"}],"source":"egs","sourceCharacterId":"16058","sourceWorkId":"10796","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/db6e5fb721ad143a5e7326b95007785a9eee0c5d7bf0d2703f8c35d7834aa251.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f968f057d51154530877b2c6bae1262d57aa26187c21f23f00b550d4911ef01.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"和葉","creatorId":"vndb:s1623","sourcePersonId":"vndb:s1623","canonicalEntityId":"vndb:s1623","name":"伊藤 葉純","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5885","source":"vndb"}]},{"characterId":"char_c9851","characterName":"マリエラ・グランバック","sourceIds":{"bangumi":[{"characterId":"116286","match":"exact-normalized-name-in-linked-work","subjectId":"16248"}],"egsCharacterIds":["16059"],"vndbCharacterId":"c9851"},"originalCharacterName":"マリエラ・グランバック","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A famous architect. She likes beautiful buildings and finds them irresistible. She is a perfectionist who will never compromise. She fell in love with the Black Tower, so she decided to live in it."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9851"},{"segments":[{"spoiler":false,"text":"有名な建築家。しかし悪い噂も多い。天才ゆえにねたまれている。"},{"spoiler":false,"text":"美しい建築物が好きでたまらない。"},{"spoiler":false,"text":"衣食住全てにこだわりを持つ。妥協を許さない完璧主義者。"},{"spoiler":false,"text":"詩的表現を好んで使うので、芝居がかって見える。"},{"spoiler":false,"text":"古代から立つ遺跡などの建築物の調査もしている。"},{"spoiler":false,"text":"黒の塔の建築物としての素晴らしさに惚れて、そのまま住み込んでしまう。"},{"spoiler":false,"text":"塔の増築、改装をしてくれる。"}],"source":"egs","sourceCharacterId":"16059","sourceWorkId":"10796","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c16ac9e74e6bfc0b3198b75e2c8255937bd6e5e079a8b1566b43f277b64b271e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8b/8b56d08a0b3dac80868e7bdb2b92bb5a58ebc4030c03336fd0697575006b49be.webp","width":114,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小林眞紀","creatorId":"vndb:s279","sourcePersonId":"vndb:s279","canonicalEntityId":"vndb:s279","name":"小林 眞紀","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16248:116286:5906:1","source":"bangumi"}]},{"characterId":"char_c9852","characterName":"メレット","sourceIds":{"bangumi":[],"egsCharacterIds":["16056"],"vndbCharacterId":"c9852"},"originalCharacterName":"メレット","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An adventurer's companion. She is good at taking care of people. Her manners are good as well. But she has a habit of telling lies by exaggerating everything. When she is troubled she digs a hole and buries herself."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9852"},{"segments":[{"spoiler":false,"text":"美人でいかにもエルフの神秘的な外見をしているのに嘘つき。"},{"spoiler":false,"text":"面倒見はいい。人当たりもよい。でも嘘をつく。"},{"spoiler":false,"text":"おまけにその嘘を維持するために一緒に行動までしてくれる。"},{"spoiler":false,"text":"ある意味では自分で穴を掘ってそこに埋まりに行く感じ。"},{"spoiler":false,"text":"物事は常に大げさに言う。1匹いれば100匹になる理論。"},{"spoiler":false,"text":"オオトカゲがドラゴンになったりする。"},{"spoiler":false,"text":"エルフに伝わる魔法と占いが得意。"},{"spoiler":false,"text":"二年目に塔に遊びにやってくる。一年間だけ塔に滞在し、"},{"spoiler":false,"text":"ヒロインたちに魔法を教えてくれる。"}],"source":"egs","sourceCharacterId":"16056","sourceWorkId":"10796","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fabe25df45ac45244ca7ab362111720e13e5e1c33e0bdf215bdf3ef515c97811.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f5/f539ee73cbd97ba7e75a5236821b3120bac72b8589aa63933da50c8363b873fa.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"本山 美奈","creatorId":"vndb:s1062","sourcePersonId":"vndb:s1062","canonicalEntityId":"vndb:s1062","name":"本山美奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:5884","source":"vndb"}]},{"characterId":"char_c9853","characterName":"コンスタンティーヌ","sourceIds":{"bangumi":[{"characterId":"116282","match":"exact-normalized-name-in-linked-work","subjectId":"16248"}],"egsCharacterIds":["16060"],"vndbCharacterId":"c9853"},"originalCharacterName":"コンスタンティーヌ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The ruler of sprites that is living in the world of humans. She is super powerful and has the ability to make magic tools. Her personality is nonsensical. She is abnormally forgetful and the type that is unable to read the situation."},{"spoiler":false,"text":"Based on the official site"}],"source":"vndb","sourceCharacterId":"c9853"},{"segments":[{"spoiler":false,"text":"人間界に住む元妖精王。"},{"spoiler":false,"text":"人間の男性と交わってしまったため、妖精界に帰れなくなってしまった。"},{"spoiler":false,"text":"超強力な魔法の道具を生み出す能力がある。"},{"spoiler":false,"text":"性格滅茶苦茶。王冠コレクター。"},{"spoiler":false,"text":"波乱万丈の人生こそ人間の幸せと思い込んでいる。歴史に干渉しまくり。"},{"spoiler":false,"text":"異常に忘れっぽく、話が通じない。空気を読まない