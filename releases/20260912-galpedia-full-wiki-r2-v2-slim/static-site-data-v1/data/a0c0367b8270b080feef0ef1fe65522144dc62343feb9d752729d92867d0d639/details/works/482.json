{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"482","model":{"presentationWorkId":"vndb:v15714","staff":{"artwork":[{"creditedName":"朱雀","creatorId":"vndb:s12362","sourcePersonId":"egs:creator:693","canonicalEntityId":"vndb:s12362","name":"朱雀","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:17259","source":"egs"}],"scenario":[{"creditedName":"ぴぃたあ","creatorId":"egs:creator:695","sourcePersonId":"egs:creator:695","canonicalEntityId":"egs:creator:695","name":"ぴぃたあ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:17260","source":"egs"}],"music":[{"creditedName":"高瀬 一矢","creatorId":"vndb:s4455","sourcePersonId":"vndb:s4455","canonicalEntityId":"vndb:s4455","name":"高瀬 一矢","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:112551","source":"vndb"},{"creditedName":"中沢 伴行","creatorId":"vndb:s4892","sourcePersonId":"vndb:s4892","canonicalEntityId":"vndb:s4892","name":"中沢 伴行","roleCode":"music","roleLabel":"作品音乐","identityStatus":"source-native","relationId":"vndb:vn-staff:112553","source":"vndb"}],"other":[{"creditedName":"SHIHO","creatorId":"vndb:s4554","sourcePersonId":"vndb:s4554","canonicalEntityId":"vndb:s4554","name":"SHIHO","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:112552","source":"vndb"},{"creditedName":"SAYUMI","creatorId":"vndb:s37797","sourcePersonId":"vndb:s37797","canonicalEntityId":"vndb:s37797","name":"木田 亜由美","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:112555","source":"vndb"}]},"cast":[{"characterId":"char_c57767","characterName":"タチアナ・オークレール","sourceIds":{"bangumi":[{"characterId":"140771","match":"exact-normalized-name-in-linked-work","subjectId":"218640"}],"egsCharacterIds":["27987"],"vndbCharacterId":"c57767"},"originalCharacterName":"タチアナ・オークレール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"407"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"77"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"34"}},"descriptions":[{"segments":[{"spoiler":false,"text":"オリガの娘。"},{"spoiler":false,"text":"物心ついた頃から母は周囲から疎んじられた存在で、そうした非難の目は彼女自身にも注がれていた。"},{"spoiler":false,"text":"そうしたことから、唯一、心を許せるのは母のみであって、他人に対しては敵対心を抱くようになった。"}],"source":"egs","sourceCharacterId":"27987","sourceWorkId":"482","spoiler":false},{"segments":[{"spoiler":false,"text":"オリガの娘 149cm34kg 77A-59-78"},{"spoiler":false,"text":"4/7生。 牡羊座 AB ロシア人（父はどっかの貴族のぼんぼん）"},{"spoiler":false,"text":"あだ名は「ターニャ」。"},{"spoiler":false,"text":"境遇ゆえに感情の生き物。嫌は嫌とはっきり言うが、嫌でも、しなくてはいけないことはするし、攻撃的というわけではない。"},{"spoiler":false,"text":"しかし、秘めた感情に直接反映される。"},{"spoiler":false,"text":"母は、母というより姉に近い感覚。しかし、母には逆らわない。"},{"spoiler":false,"text":"物心ついたころには、母は周囲から疎んじられる存在だった。もちろん、自分も。"},{"spoiler":false,"text":"母は耐えることでタチアナを守ろうとし、タチアナは盾になることで母を守ろうとした。"},{"spoiler":false,"text":"周囲は、自分達にとって敵であり、それが当たり前のことであった。"}],"source":"bangumi","sourceCharacterId":"140771"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afbb25bcf872002905cea9e202fd081db8f1f731c7dbbaf4769b573df3b933a2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d2560d1e96cd4526e5091d1fe3d21cf13befff84a5a7bd5cb1d6a299c4846d8.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c57768","characterName":"オリガ・オークレール","sourceIds":{"bangumi":[{"characterId":"140770","match":"exact-normalized-name-in-linked-work","subjectId":"218640"}],"egsCharacterIds":["27986"],"vndbCharacterId":"c57768"},"originalCharacterName":"オリガ・オークレール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"812"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"C"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"タチアナの母。"},{"spoiler":false,"text":"元ロシア貴族の娘だったが、革命によって国を追われ、国境を越えたところを人買いに捕らわれ、主人公の養父に買われる。"},{"spoiler":false,"text":"娘を産んだのが、若（幼い？）かったこともあり、親子でありながら姉妹に間違われることも。"},{"spoiler":false,"text":"若過ぎる出産のため、当時の主治医に子供が出来ない身体と診断されているようだ。"}],"source":"egs","sourceCharacterId":"27986","sourceWorkId":"482","spoiler":false},{"segments":[{"spoiler":false,"text":"タチアナの母 160cm43kg 83C-57-84"},{"spoiler":false,"text":"8/12生。 獅子座 A ロシア人"},{"spoiler":false,"text":"あだ名は「オーリャ」。"},{"spoiler":false,"text":"ロシアの貴族の娘だった。両親とは死別。革命に追われ、国内に居場所がなく、国境を越えてきた。"},{"spoiler":false,"text":"白ロシア人の集団にも馴染めなかったよう。"},{"spoiler":false,"text":"僅かな蓄えも使い果たし、途方にくれているところを人買いに捕まる。"},{"spoiler":false,"text":"幼い恋の過ちが、今の娘。あまり歳が離れておらず、姉妹のように見える。"},{"spoiler":false,"text":"若すぎる出産のために、オリガは○○の出来ない身体になっている。…というのが当時の主治医の診断。"}],"source":"bangumi","source