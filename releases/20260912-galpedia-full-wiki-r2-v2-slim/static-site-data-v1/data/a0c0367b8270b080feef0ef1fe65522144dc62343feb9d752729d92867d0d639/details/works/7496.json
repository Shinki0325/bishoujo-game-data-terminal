":"c73950"},"originalCharacterName":"デ・ジ･キャラット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"10"},"birthday":{"reviewState":"source-only","source":"vndb","value":"208"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"148"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Dejiko is the main protagonist of the series. She is also known as Chocola but despite this alternate name implying she likes chocolate, she prefers broccoli. Dejiko has a type A personality and can be aggressive at times."},{"spoiler":false,"text":"Dejiko dresses up as a white catgirl and is the princess of Planet Di Gi Charat. She is ten years old when she comes to Earth with hopes of becoming an idol singer. She has green eyes, green hair, and her maid-like uniform consists of a white and navy blue dress with large cat bells tied to her hair with navy blue ribbons. She attacks using her eye-beam weapon."},{"spoiler":false,"text":"She has the ability to use her eye-beam weapon called the Me Kara Beam. She ends each sentence that she speaks with nyo."}],"source":"vndb","sourceCharacterId":"c73950"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d8efeafdfdb88ec9c600641307ab5ff8d56ff7708eabe5a6b8f070ce92a6685.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b5/b5403f68e5fe052c39f9380a6fa32387fdc7c5df4b237d3f4b82f2917407d4d7.webp","width":149,"height":256,"source":"static-detail"},"actors":[{"creditedName":"真田 アサミ","creatorId":"vndb:s1712","sourcePersonId":"vndb:s1712","canonicalEntityId":"vndb:s1712","name":"真田 アサミ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40048","source":"vndb"}]},{"characterId":"char_vndb_c73951","characterName":"プチ・キャラット","sourceIds":{"vndbCharacterId":"c73951"},"originalCharacterName":"プチ・キャラット","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"5"},"birthday":{"reviewState":"source-only","source":"vndb","value":"121"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"103"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"18"}},"descriptions":[{"segments":[{"spoiler":false,"text":"At the beginning of the story it is explained that Puchiko, also known as Cappuccino, is Dejiko's five-year-old sidekick and is a catgirl. Her relationship to Dejiko is not explained in the original series, but Gema states that she is a princess in the Di Gi Charat Movie and it is seen that she lives with Dejiko in the castle in Panyo Panyo Di Gi Charat. According to Di Gi Charat Complete 2002, Dejiko saved her by pulling her out of a hole, and so Puchiko followed Dejiko to thank her. Although in Winter Garden, it said that Puchiko is Dejiko's sister and share the same parents."},{"spoiler":false,"text":"Puchiko has a type B personality and is known to be quiet and calm. She has the ability to use an eye-beam similar to Dejiko's but is often too docile to conjure the aggression required to perform such a feat. This has caused many things to come out of her eyes, including sludge, when she attempts to use it."},{"spoiler":false,"text":"Puchiko dresses as an orange tabby catgirl and has brown hair and dark brown eyes. She wears a seifuku plus cat bells in her hair, though they are much smaller than Dejiko's. She ends each sentence that she speaks with nyu."}],"source":"vndb","sourceCharacterId":"c73951"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/838b982a237a6407e6e34dfea629a8c86f348f53176547039600520df36d3ac4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/6645b9c23acb60e383fd860722eecd98e72ceb9a27f222c1d9ad3aeaf6b095e5.webp","width":202,"height":250,"source":"static-detail"},"actors":[{"creditedName":"沢城 みゆき","creatorId":"vndb:s43","sourcePersonId":"vndb:s43","canonicalEntityId":"vndb:s43","name":"沢城 みゆき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40040","source":"vndb"}]},{"characterId":"char_vndb_c73952","characterName":"うさだ ヒカル","sourceIds":{"vndbCharacterId":"c73952"},"originalCharacterName":"うさだ ヒカル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"birthday":{"reviewState":"source-only","source":"vndb","value":"830"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"164"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rabi~en~Rose is Dejiko's rival. Her name was decided following a request for reader submissions, and may be a play on a number of things. \"Rabi~en~Rose\" may be a play on the common French saying \"La Vie en Rose\" which means \"life in rose-pink\". The Japanese expression \"spend a life in rose-pink\" means to spend a life without any worries. \"Rabi\" which resembles the English word \"rabbit\" replaced \"La vie\" to form a pun to mean \"Rabbit in life without worries\", which suggests her personality. Her real name is Hikaru Usada, which she hates being called. Her \"Usada\" surname also is a pun, as the \"Usa\" part is a shortening of the word \"usagi\", which means \"rabbit\" in Japanese. Her name is also meant to resemble the famous Japanese pop singer, Hikaru Utada."}],"source":"vndb","sourceCharacterId":"c73952"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1bfffe1f509b44454e705c31185c7b64e9a897b204f770c4ffe79cf37c5de00d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed0197434013ded6e3535b6c1f1fa47c231b687c11ca9db06f65bcc9ece41a1c.webp","width":180,"height":256,"source":"static-detail"},"actors":[{"creditedName":"氷上 恭子","creatorId":"vndb:s1590","sourcePersonId":"vndb:s1590","canonicalEntityId":"vndb:s1590","name":"氷上 恭子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40046","source":"vndb"}]},{"characterId":"char_vndb_c73953","characterName":"ゲマ","sourceIds":{"vndbCharacterId":"c73953"},"originalCharacterName":"ゲマ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Gema is explained to be the guardian of Dejiko and Puchiko. Essentially he is a floating yellow balloon that is always upside-down with very small eyes and mouth. Creator Koge Donbo once joked that Gema was the best character because anyone can draw him. He ends his sentences with gema. He can shoot darts out of bamboo sticks; but they have little effect on anyone."}],"source":"vndb","sourceCharacterId":"c73953"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c7/c763cd3a7b7eb76f19d140386d30dc4da75f880be78c3244f9202da17cf209b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cc5e853abdd3a87565ec403959826ffe16ff16d372f269c55b0131f833b865d.webp","width":199,"height":171,"source":"static-detail"},"actors":[{"creditedName":"亀井 芳子","creatorId":"vndb:s16616","sourcePersonId":"vndb:s16616","canonicalEntityId":"vndb:s16616","name":"亀井 芳子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40052","source":"vndb"}]},{"characterId":"char_vndb_c73954","characterName":"雛菊","sourceIds":{"vndbCharacterId":"c73954"},"originalCharacterName":"雛菊","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"14"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A shrine maiden living with her father, the village priest. She lost her mother in a battle against the evil god eight years ago and struggles with self-confidence. Still, she admires her mother and endures her father’s strict training every day to get closer to that ideal. She takes care of the protagonist and Dejiko, who wandered into this world."}],"source":"vndb","sourceCharacterId":"c73954"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bcfed1a7758a9ceafdb1dcd4a7a6ea6ac41d690e8c5796acf7d54ebb53f26c22.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/5542276ed069eb467cb7d96f61f06a981c8a7d31b5bb33711618c8d3a5e47962.webp","width":160,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小暮 英麻","creatorId":"vndb:s654","sourcePersonId":"vndb:s654","canonicalEntityId":"vndb:s654","name":"小暮 英麻","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40043","source":"vndb"}]},{"characterId":"char_vndb_c73955","characterName":"エリカ","sourceIds":{"vndbCharacterId":"c73955"},"originalCharacterName":"エリカ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female sheriff assigned to the village several years ago. Her specialty is using a lasso. She is caring and well-liked by the villagers. She has a strong appetite for spicy food and makes everything extremely spicy."}],"source":"vndb","sourceCharacterId":"c73955"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e1263e0d79a5e4f38c13bfcb7c0d4ad52ae1fdfa8562e9716f2f15ceeadd63f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7d/7df452182cbb2758d35f4747f94de4f2e626dcd2d2e49ec4e72ef8cdcd8bcc3a.webp","width":158,"height":256,"source":"static-detail"},"actors":[{"creditedName":"沢海 陽子","creatorId":"vndb:s5103","sourcePersonId":"vndb:s5103","canonicalEntityId":"vndb:s5103","name":"沢海 陽子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40049","source":"vndb"}]},{"characterId":"char_vndb_c73956","characterName":"セシル","sourceIds":{"vndbCharacterId":"c73956"},"originalCharacterName":"セシル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The daughter of the Glasse family and Kain’s younger sister. She is intelligent but a bit absent-minded, which endears her to others. Traumatized by past events, she is extremely afraid of cats, even fearing Puchiko in her cat-eared hat. She possesses great power but usually suppresses it. She is very close friends with Wendy."}],"source":"vndb","sourceCharacterId":"c73956"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/45/451338369a54657b46c2e82b1ca925c2f5ead25c67ed1e6c21f10f5e20b9ad3f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dd/ddd34ac0cf90b8e6e9092bac09fa3d6aa356770fa5d16f82de4f2cbc6b400d06.webp","width":160,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中島 沙樹","creatorId":"vndb:s44","sourcePersonId":"vndb:s44","canonicalEntityId":"vndb:s44","name":"中島 沙樹","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40041","source":"vndb"}]},{"characterId":"char_vndb_c73957","characterName":"ルーン","sourceIds":{"vndbCharacterId":"c73957"},"originalCharacterName":"ルーン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"13"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The winged twin older brother. He escaped from an orphanage with his younger brother Luna, and they have lived together ever since. He is skillful with his hands, making accessories to sell for a living. He cares deeply for Luna and is very nurturing. In addition to being able to fly, he can manipulate wind and fire."}],"source":"vndb","sourceCharacterId":"c73957"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/18/1847ee955699386bdb1450654921114068278a0030b99c4ae3a2532d75d16eaf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d6bd7a71da4cf44cacede39bd8d4270d923e53c10686942b4ddc8615c40db4f.webp","width":158,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小島 幸子","creatorId":"vndb:s16617","sourcePersonId":"vndb:s16617","canonicalEntityId":"vndb:s16617","name":"小島幸子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40053","source":"vndb"}]},{"characterId":"char_vndb_c73958","characterName":"ルナ","sourceIds":{"vndbCharacterId":"c73958"},"originalCharacterName":"ルナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"13"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Rune’s twin younger brother. He is weak, gentle, and kind-hearted. Unlike Rune, he cannot fly, which is a source of insecurity. He has a healing ability that allows him to heal injuries by holding out his hand. Frustrated by how little he can do compared to Rune, he constantly seeks ways to contribute in his own way."}],"source":"vndb","sourceCharacterId":"c73958"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e68938d7b335523e33043377fc1ac880274a087d5dcf5c140a35e535b6eaa20a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c906bce20d97a8bea93e3ae54138cb4b9de8787154fd510f4de22cee0c0aca8.webp","width":158,"height":256,"source":"static-detail"},"actors":[{"creditedName":"増田 ゆき","creatorId":"vndb:s1364","sourcePersonId":"vndb:s1364","canonicalEntityId":"vndb:s1364","name":"増田 ゆき","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40045","source":"vndb"}]},{"characterId":"char_vndb_c73959","characterName":"カイン","sourceIds":{"vndbCharacterId":"c73959"},"originalCharacterName":"カイン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"19"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The eldest son of the Glasse family, a knight apprentice, and Cecil’s older brother. He wields the family heirloom “Guardian Sword” and is highly skilled with it. He dislikes formality and is friendly with everyone, also a feminist. He fell in love at first sight with Usada and became her huge fan. He dotes on Cecil and often follows her when she wanders off."}],"source":"vndb","sourceCharacterId":"c73959"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a57af33dccf9aad3cb6c9fcb9566e7f2d49264df120b9b1cbeec303caf7ae18b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/51f16361df08a1db7f0456f00ad88526a197b9a737c1d92b7f01551eeb495c7b.webp","width":159,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石田 彰","creatorId":"vndb:s74","sourcePersonId":"vndb:s74","canonicalEntityId":"vndb:s74","name":"石田 彰","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40042","source":"vndb"}]},{"characterId":"char_vndb_c73960","characterName":"ウェンディ","sourceIds":{"vndbCharacterId":"c73960"},"originalCharacterName":"ウェンディ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"15"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A thief girl living in the forest. She was abandoned as a child and raised among boys, so she speaks with masculine pronouns like “boku.” Despite her past, she is bright, active, and proactive, and shows a girlish side by cooking for those she cares about. She is very close friends with Cecil."}],"source":"vndb","sourceCharacterId":"c73960"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/55/55463216905ecdbbb6cf30cd55701f286557428cd45a4c71e176a2cc557fe827.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/82/82030e836443d05b51a8206eb0be7ccf99a3f17a2f23b3b8654d82756a1e5d5c.webp","width":158,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅井 清己","creatorId":"vndb:s771","sourcePersonId":"vndb:s771","canonicalEntityId":"vndb:s771","name":"大花どん","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:40044","source":"vndb"}]},{"characterId":"char_vndb_c73961","characterName":"カレラ","sourceIds":{"vndbCharacterId":"c73961"},"originalCharacterName":"カレラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"19"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female alchemist. She admires and respects her scientist father, Greg, but cannot be completely honest with him, so she pursued the path of alchemy. Like her father, she has a mad scientist streak and is obsessed with fantasies of world domination. She refers to the protagonist as “Servant No. 1” and wears a claw on her right hand for some reason. In the novel version, Gema is her servant."}],"source":"vndb","sourceCharacterId":"c73961"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5be1f0d9c64e5ab5d55fa367eea946344041a2c8ddc0f6082a71a98580f744cc.webp","fallbackUrl":"https://wiki-assets.bis