o.date/terminal-wiki/v1/characters/v1/images/62/62500572bec485690e8ef782c92f9d4840877e724d1b8cd3618a4e6fbd940de5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/15/15c3645d1a3dcb4ecb3868c49ad923053974f386b83cdfd25fc52580d171f492.webp","width":256,"height":192,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_139404","characterName":"雨宮志穂","sourceIds":{"bangumi":[{"characterId":"139404","match":"source-roster","subjectId":"376218"},{"characterId":"139404","match":"source-roster","subjectId":"376219"}]},"originalCharacterName":"雨宮志穂","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アメリア姫の護衛として付き添っており、数学教師をしています。"},{"spoiler":false,"text":"とても優秀な騎士なのですが、真面目すぎるあまり一度たがが外れると暴走してしまう一面も。"},{"spoiler":false,"text":"魔族の姿に変身すると露出度の高い衣装になりますが、実はエッチなことに関しては耐性がありません。"},{"spoiler":false,"text":"前作『学園パンデモニウム』では主人公でしたが、今回は脇役としての登場です。"}],"source":"bangumi","sourceCharacterId":"139404"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/48/48e3e900a130bc285a9d4be1f458d995ca458ad9301a8902cc40e1a5e4d15921.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32482d9a3f5d4f65396fe1c13ca053e58dc68325200bc52e03625c6f75090585.webp","width":256,"height":192,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_139405","characterName":"リリス","sourceIds":{"bangumi":[{"characterId":"139405","match":"source-roster","subjectId":"376218"},{"characterId":"139405","match":"source-roster","subjectId":"376219"}]},"originalCharacterName":"リリス","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アメリア姫とは幼なじみで、現在ではメイドとして雨宮家で働いています。"},{"spoiler":false,"text":"表向きは悪戯好きで、つかみ所の無い性格ですが姫様に対する想いは本物で、とてもピュアです。"},{"spoiler":false,"text":"姫様に多大な恩義を感じている一方でユナ・ララーナの計画に賛同し、王国に対して裏切りを企てます。"},{"spoiler":false,"text":"前作では報われない展開もあった彼女ですが、今回は運命を変えることができるでしょうか?"}],"source":"bangumi","sourceCharacterId":"139405"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/464dd5bac3dc7032fb917cdf64020ece324db223e1bb383eca29047f56176d0a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e6c11ef3744e93aef8b4572cad53e77b35e58e6cc11e43258c3665aecf73d76b.webp","width":256,"height":192,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_139406","characterName":"デイジー","sourceIds":{"bangumi":[{"characterId":"139406","match":"source-roster","subjectId":"376219"}]},"originalCharacterName":"デイジー","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ユナ・ララーナに協力するサキュバスの賢者です。"},{"spoiler":false,"text":"おっぱいが大好きで、人間の女の子を改造してミルク奴隷にするという怪しげな研究をしています。"},{"spoiler":false,"text":"ユナが人間界を支配した暁には奴隷を集めて牧場を作ることが彼女の夢です。"},{"spoiler":false,"text":"しかし、自分の興味の無いことにはあまりにも無関心でそれが原因で大失敗してしまうことも……"}],"source":"bangumi","sourceCharacterId":"139406"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17b0f551086ec49439da527184191cf1d5258392ba3e72762aef25a9515e6368.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/61169744d45110ce0c22f7e67cbb347b622088fc69a7cdeefef7b2f50d419888.webp","width":256,"height":192,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_139407","characterName":"ユナ・ララーナ","sourceIds":{"bangumi":[{"characterId":"139407","match":"source-roster","subjectId":"376218"},{"characterId":"139407","match":"source-roster","subjectId":"376219"}]},"originalCharacterName":"ユナ・ララーナ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"500年前に作り出され、ずっと封印されていたサキュバスの兵器です。"},{"spoiler":false,"text":"古のサキュバスの生き方を取り戻すために魔界で反乱を起こしますが戦いに敗れ人間界に逃亡します。"},{"spoiler":false,"text":"そして、現在では自らの能力を最大限に生かして人間界の支配を目論んでいます。"},{"spoiler":false,"text":"刃向かう者に対しては容赦がありませんが、賛同する者や協力者には愛情を注ぎます。"}],"source":"bangumi","sourceCharacterId":"139407"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/ebf0c83e23d1df51698990cd981eb3ae9b351e0ddb5a5f3554e990da7b5b834f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e30e237743f6a58b240118c0820b0e5870e3bb6155b1bd810f7dd5257de6a1b7.webp","width":256,"height":192,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p12678","sourceCompanyId":"egs:brand:4919","canonicalEntityId":"vndb:p12678","name":"レベル1","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:29648:4919","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
