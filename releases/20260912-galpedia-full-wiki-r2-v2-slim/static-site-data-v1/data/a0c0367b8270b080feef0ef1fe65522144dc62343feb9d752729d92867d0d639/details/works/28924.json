ourcePersonId":"vndb:s15373","canonicalEntityId":"vndb:s15373","name":"牧野真児","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:163146","source":"vndb"},{"creditedName":"柊木 環希","creatorId":"vndb:s15586","sourcePersonId":"vndb:s15586","canonicalEntityId":"vndb:s15586","name":"柊木 環希","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:163147","source":"vndb"},{"creditedName":"明日葉","creatorId":"vndb:s15587","sourcePersonId":"vndb:s15587","canonicalEntityId":"vndb:s15587","name":"明日葉","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:163148","source":"vndb"},{"creditedName":"風吹 実里","creatorId":"vndb:s45967","sourcePersonId":"vndb:s45967","canonicalEntityId":"vndb:s45967","name":"風吹 実里","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:163151","source":"vndb"},{"creditedName":"animone","creatorId":"vndb:s49191","sourcePersonId":"vndb:s49191","canonicalEntityId":"vndb:s49191","name":"animone","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:163153","source":"vndb"}]},"cast":[{"characterId":"char_c53406","characterName":"八重桜 みる","sourceIds":{"bangumi":[{"characterId":"48117","match":"exact-normalized-name-in-linked-work","subjectId":"193206"},{"characterId":"48117","match":"exact-normalized-name-in-linked-work","subjectId":"226209"}],"egsCharacterIds":["12684"],"vndbCharacterId":"c53406"},"originalCharacterName":"八重桜 みる","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"79"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"A"},"height":{"reviewState":"pending-conflict","source":"vndb","value":"152"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Hobbies: Reading fishing magazines"},{"spoiler":false,"text":"Likes: Drinking, smoking, tsumami"},{"spoiler":false,"text":"Dislikes: Alcohol & smoking prohibition, talking about her age, milk (boobs don't grow at all from drinking it!!)"},{"spoiler":false,"text":"Shinobu's class teacher who is very easy to talk to and has a friendly personality, which is why she's popular with her students. A very heavy drinker and smoker whose mood gets even worse when she needs her fix of nicotine, and hates talking about both marriage and her age. Miru is Nazuna's former classmate and the two remain close friends even after graduation; in fact, Nazuna still keeps taking care of Miru. Instead of going to her own house, she crashes into Shinobu's house almost every day."}],"source":"vndb","sourceCharacterId":"c53406"},{"segments":[{"spoiler":false,"text":"婚期を逃した可哀想な忍のクラスの担任。なずなの元同級生であり今でも仲良しな親友同士。"},{"spoiler":false,"text":"歳の割に、見た目が若く身長も低いのでよく未成年に間違われる。"},{"spoiler":false,"text":"重度のヘビースモーカーで酒豪。"},{"spoiler":false,"text":"ニコチンが切れると授業中でもなんでも機嫌が悪くなる。"},{"spoiler":false,"text":"また、年齢と結婚の話をされても機嫌が悪くなる"},{"spoiler":false,"text":"なずなには昔から世話を焼いてもらっており、今でもそれは変わっていない。"},{"spoiler":false,"text":"なので、ほぼ毎日なずなのいる忍の家へと通い詰めている。"},{"spoiler":false,"text":"（自宅はあるのだが、ほぼ帰っていないらしい……）"},{"spoiler":false,"text":"そのいい加減な言葉とは裏腹に、生徒思いの良い先生なので、生徒からの信頼は厚い。"}],"source":"egs","sourceCharacterId":"12684","sourceWorkId":"24263","spoiler":false},{"segments":[{"spoiler":false,"text":"いまだに未婚、婚期を逃した合法ロ○教師。生徒会顧問。"},{"spoiler":false,"text":"前作「リアルエロゲシチュエーション！」で赴任していた学園から異動。"},{"spoiler":false,"text":"重度のヘビースモーカーで酒豪、だが最近アイ○スに変えるなど喫煙については意識を改めている。禁酒はする気はまったくない。"},{"spoiler":false,"text":"かつての飲み友達に気軽に会えなくなったので、新たなる飲み友を探している。"},{"spoiler":false,"text":"いい加減な言動とは裏腹に、生徒想いの良い先生。そのため信頼は厚い。"},{"spoiler":false,"text":"恋愛経験はないのだが、以前の経験から学園生の恋愛事情についてはある程度アドバイスができるようになった。"},{"spoiler":false,"text":"そのため、透の置かれた状況を即座に理解してアドバイスをくれるようになる。"},{"spoiler":false,"text":"最近、花嫁修業として料理を始めたことでコンビニ弁当生活から遠ざかっている。"},{"spoiler":false,"text":"だが雲雀の店に入り浸るようになり、結果以前のようにだらんだらんな生活に戻っていく。"}],"source":"egs","sourceCharacterId":"12684","sourceWorkId":"28924","spoiler":false},{"segments":[{"spoiler":false,"text":"婚期を逃した、かわいそうなクラス担任。"},{"spoiler":false,"text":"いい加減な発言とは裏腹に学生想いの良い先生なので、教え子からの信頼は厚い。"},{"spoiler":false,"text":"歳のわりに見た目が若く、身長も低いのでよく未成年に間違われる。"},{"spoiler":false,"text":"重度のヘビースモーカーで酒豪。 ニコチンが切れると授業中でも機嫌が悪くなる。"},{"spoiler":false,"text":"また年齢と結婚の話をされても機嫌が悪くなる。"},{"spoiler":false,"text":"なずなの元同級生であり、今でも仲良しな親友同士。"},{"spoiler":false,"text":"なずなには昔から世話を焼いてもらっており、今でもそれは変わっていない。"},{"spoiler":false,"text":"自宅には帰らず、ほぼ毎日なずなが居る忍の家へ通い詰めている。"},{"spoiler":false,"text":"「おらぁー！　席つけガキどもっ！　出席簿で殴んぞコラァー!!」"}],"source":"bangumi","sourceCharacterId":"48117"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"48117","value":"飲酒、喫煙、お酒のツマミ"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"48117","value":"禁酒、禁煙、年齢に関する話、牛乳（飲んでも胸なんて大きくならないんだよぉ!!）"},{"label":"趣味","source":"bangumi","sourceCharacterId":"48117","value":"婚活雑誌を読み漁ること"},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"12684","sourceWorkId":"28924","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"12684","sourceWorkId":"28924","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"height":[{"comparisonValue":"152","source":"vndb","sourceCharacterId":"c53406","value":"152"},{"comparisonValue":"142","scope":"sourceWork","source":"egs","sourceCharacterId":"12684","sourceWorkId":"24263","value":"142"},{"comparisonValue":"155","scope":"sourceWork","source":"egs","sourceCharacterId":"12684","sourceWorkId":"28924","value":"155"},{"comparisonValue":"142","source":"bangumi","sourceCharacterId":"48117","value":"142cm"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f69685e640cda39fe9f0df08fe4e1d14ab52b538f8782991eeffc3b228bf8770.webp","fallbackUrl":"https://wiki-asse