{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"25819","model":{"presentationWorkId":"egs:25819","staff":{"artwork":[{"creditedName":"緑木邑","creatorId":"vndb:s832","sourcePersonId":"egs:creator:12954","canonicalEntityId":"vndb:s832","name":"緑木邑","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:191745","source":"egs"}],"scenario":[{"creditedName":"坂元星日","creatorId":"vndb:s913","sourcePersonId":"egs:creator:14704","canonicalEntityId":"vndb:s913","name":"坂元星日","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:191746","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_bangumi_109779","characterName":"セーラ","sourceIds":{"bangumi":[{"characterId":"109779","match":"source-roster","subjectId":"266716"}]},"originalCharacterName":"セーラ","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"セインティア王国の第1王女。"},{"spoiler":false,"text":"愛らしい見た目とおとなしい性格から、国民のアイドルとして厚い信望を得ている。"},{"spoiler":false,"text":"王からも寵愛されており、国で最も強いがまだ若いレティシアを"},{"spoiler":false,"text":"専属騎士として任命するほど。"},{"spoiler":false,"text":"女性も見蕩れる美しさを持つレティシアとの仲は良く、姉のように慕っている。"},{"spoiler":false,"text":"ルジアスの罠に嵌められて拐われ、奴隷国家の王に売られてしまうが、"},{"spoiler":false,"text":"レティシアが必ず助けに来てくれると信じている。"},{"spoiler":false,"text":"ルビーのように赤い髪を持つ。小柄で、貧乳なのを内心気にしている。"}],"source":"bangumi","sourceCharacterId":"109779"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[{"creditedName":"渡邊優佳","creatorId":"vndb:s1040","sourcePersonId":"vndb:s1040","canonicalEntityId":"vndb:s1040","name":"渡邊 優佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266716:109779:24788:1","source":"bangumi"}]},{"characterId":"char_bangumi_109780","characterName":"レティシア","sourceIds":{"bangumi":[{"characterId":"109780","match":"source-roster","subjectId":"266716"}]},"originalCharacterName":"レティシア","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"セインティア王国に仕える近衛騎士。"},{"spoiler":false,"text":"国と姫への忠誠は誰よりも強く、美しさと強さをも併せ持ち、若くして姫の専属騎士に任命される。"},{"spoiler":false,"text":"しかしそれが理由で、一部からは嫉妬と羨望を被ることに。"},{"spoiler":false,"text":"騎士としての強さと気高さを追い求めるあまり、それ以外のことに対しては少し疎い面がある。"},{"spoiler":false,"text":"特に性的な知識は最低限しか知らないほど初心。"},{"spoiler":false,"text":"母譲りのサラサラとした金髪は誇りだが、胸の大きさは戦闘の邪魔になる為、不要だと感じている。"}],"source":"bangumi","sourceCharacterId":"109780"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[{"creditedName":"天乙准花","creatorId":"vndb:s339","sourcePersonId":"vndb:s339","canonicalEntityId":"vndb:s339","name":"椎那 天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266716:109780:7890:1","source":"bangumi"}]},{"characterId":"char_bangumi_109781","characterName":"ネリア","sourceIds":{"bangumi":[{"characterId":"109781","match":"source-roster","subjectId":"266716"}]},"originalCharacterName":"ネリア","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"辺境の地で占いをしている女性。"},{"spoiler":false,"text":"いつも意味深な微笑を浮かべ、ときおり女騎士や客をからかう言動を見せる。"},{"spoiler":false,"text":"高い金を払うほどその占いの正確さが増すため、金持ちからは重宝されている。"},{"spoiler":false,"text":"闇をイメージさせる黒を基調とした服を着ており、漆黒の髪、白い肌、蒼瞳の美少女。"},{"spoiler":false,"text":"髪で片目が隠れている。"}],"source":"bangumi","sourceCharacterId":"109781"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[{"creditedName":"英みらい","c