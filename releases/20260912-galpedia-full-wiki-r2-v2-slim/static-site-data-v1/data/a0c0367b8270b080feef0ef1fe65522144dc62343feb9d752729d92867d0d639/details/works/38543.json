tatus":"source-native","relationId":"vndb:vn-staff:215439","source":"vndb"},{"creditedName":"nao","creatorId":"vndb:s935","sourcePersonId":"vndb:s935","canonicalEntityId":"vndb:s935","name":"nao","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:215441","source":"vndb"},{"creditedName":"るび様","creatorId":"vndb:s4248","sourcePersonId":"vndb:s4248","canonicalEntityId":"vndb:s4248","name":"るび様","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:215443","source":"vndb"},{"creditedName":"天ヶ咲 麗","creatorId":"vndb:s4314","sourcePersonId":"vndb:s4314","canonicalEntityId":"vndb:s4314","name":"天ヶ咲 麗","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:215445","source":"vndb"},{"creditedName":"紫咲 ほたる","creatorId":"vndb:s10769","sourcePersonId":"vndb:s10769","canonicalEntityId":"vndb:s10769","name":"紫咲 ほたる","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:215448","source":"vndb"}]},"cast":[{"characterId":"char_c151671","characterName":"飛鳥凛","sourceIds":{"bangumi":[{"characterId":"178272","match":"exact-normalized-name-in-linked-work","subjectId":"554401"}],"egsCharacterIds":["28055"],"vndbCharacterId":"c151671"},"originalCharacterName":"飛鳥凛","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1201"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A girl who dreams of becoming an idol, inspired by her late mother who was a singer."},{"spoiler":false,"text":"She has a cheerful and lively personality and is always at the center of attention in her class."},{"spoiler":false,"text":"Currently, she's a trainee at a small talent production company, working hard on singing and dancing lessons."},{"spoiler":false,"text":"However, her father, having witnessed the hardships of his late wife up close, is not very supportive of his daughter's pursuit of a career in entertainment. He allowed her to join the agency under the condition that if she doesn't make a major debut, she must go to college."},{"spoiler":false,"text":"Now that her father has been assigned to work overseas, the official story is that she's sharing a place with another trainee, but in reality, she's renting a room at the home of the agency president, Toya."},{"spoiler":false,"text":"Moreover, the trainee she had been living with has since quit, so she is now living alone with Toya."},{"spoiler":false,"text":"Although she's aiming to debut as a solo idol, the harsh reality of the industry is beginning to make her feel increasingly anxious."},{"spoiler":false,"text":"Likes: Her mother, who was a singer"},{"spoiler":false,"text":"Dislikes: Compromising"}],"source":"vndb","sourceCharacterId":"c151671"},{"segments":[{"spoiler":false,"text":"歌手だった亡き母に憧れ、アイドルを夢見る少女。"},{"spoiler":false,"text":"明るく活発な性格で、クラスでも常に人の中心にいる存在。"},{"spoiler":false,"text":"現在は小さな芸能プロダクションの練習生として、歌とダンスのレッスンに励んでいる。"},{"spoiler":false,"text":"しかし、亡き妻の苦労を間近で見ていた父親は、娘の芸能活動に前向きではなく、「メジャーデビューできなければ大学進学」という約束で事務所所属を許可した。"},{"spoiler":false,"text":"そんな父が海外赴任することになり、表向きは練習生同士でルームシェアをしていることになっているが、実際は社長・遠矢の自宅に間借りしている状態。"},{"spoiler":false,"text":"さらに、同居していた練習生が辞めてしまい、現在は遠矢と二人きりで生活をしている。"},{"spoiler":false,"text":"ソロアイドルとしてメジャーデビューを目指しているものの、現実は厳しく、焦りを感じ始めている。"}],"source":"egs","sourceCharacterId":"28055","sourceWorkId":"38543","spoiler":false},{"segments":[{"spoiler":false,"text":"歌手だった亡き母に憧れ、アイドルを夢見る少女。"},{"spoiler":false,"text":"明るく活発な性格で、クラスでも常に人の中心にいる存在。"},{"spoiler":false,"text":"現在は小さな芸能プロダクションの練習生として、歌とダンスのレッスンに励んでいる。"},{"spoiler":false,"text":"しかし、亡き妻の苦労を間近で見ていた父親は、娘の芸能活動に前向きではなく、「メジャーデビューできなければ大学進学」という約束で事務所所属を許可した。"},{"spoiler":false,"text":"そんな父が海外赴任することになり、表向きは練習生同士でルームシェアをしていることになっているが、実際は社長・遠矢の自宅に間借りしている状態。"},{"spoiler":false,"text":"さらに、同居していた練習生が辞めてしまい、現在は遠矢と二人きりで生活をしている。"},{"spoiler":false,"text":"ソロアイドルとしてメジャーデビューを目指しているものの、現実は厳しく、焦りを感じ始めている。"},{"spoiler":false,"text":"「えへへ、どうかな？ ステージ衣装なんだ」"},{"spoiler":false,"text":"「社長の言う通り、ソロアイドルとしてデビュー出来る可能性だって……あるかもしれないから」"},{"spoiler":false,"text":"「まだデビュー前のアイドルの卵だけど、今日は私の歌を聴いて、顔と名前を覚えていってねー！」"}],"source":"bangumi","sourceCharacterId":"178272"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"178272","value":"歌手だった母親"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"178272","value":"妥協すること"},{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"28055","sourceWorkId":"38543","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"28055","sourceWorkId":"38543","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"28055","sourceWorkId":"38543","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"28055","sourceWorkId":"38543","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"28055","sourceWorkId":"38543","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b3/b3d8431ea02d4d8c91f9a982fbbea9d9032cab449b40a9c950c067de25a4996e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b88fc201b8c5365208004aa42571b410e5f89f0c5edde7e1837c842ade2c0926.webp","width":140,"height":256,"source":"static-detail"},"actors":[{"creditedName":"青葉りんご","creatorId":"vndb:s295","sourcePersonId":"vndb:s295","canonicalEntityId":"vndb:s295","name":"青葉 りんご","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:554401:178272:5922:1","source":"bangumi"}]},{"characterId":"char_c151672","characterName":"和泉遠矢","sourceIds":{"bangumi":[{"characterId":"202173","match":"exact-normalized-name-in-linked-work","subjectId":"554401"}],"egsCharacterIds":["28056"],"vndbCharacterId":"c151672"},"originalCharacterName":"和泉遠矢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"104"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"height":{"reviewState":"no-conflict","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He originally gained popularity as a vocalist active on the internet."},{"spoiler":false,"text":"Using the profits from that success, he founded a talent production company and began producing female idols while continuing his own activities."},{"spoiler":false,"text":"He has already debuted several idol groups, and despite his young age, he's building a reputation within the industry as a highly skilled producer."},{"spoiler":false,"text":"However, even during his time as a vocalist, he was infamous for getting involved with his fans."},{"spoiler":false,"text":"He lets girls he takes a liking to live in his home, seduces them with his smooth, experienced ways, and then toys with them. He employs his ex-girlfriends and casual flings at his company."}],"source":"vndb","sourceCharacterId":"c151672"},{"segments":[{"spoiler":false,"text":"元々はネットで活動する歌い手として人気を博していた。"},{"spoiler":false,"text":"その収益を元に芸能プロダクションを立ち上げ、自身の活動と並行して女性アイドルのプロデュースを開始。"},{"spoiler":false,"text":"すでに何組かのアイドルをデビューさせており、若手ながら業界内で敏腕プロデューサーとして評価を高めている。"},{"spoiler":false,"text":"しかし、歌い手時代からファンに手を出しているとして有名だった。"},{"spoiler":false,"text":"気に入った女の子は自宅に住まわせ、女慣れした手練手管で籠絡しては弄んでいる。"},{"spoiler":false,"text":"元カノやセフレ等を自分の会社で働かせている。"}],"source":"egs","sourceCharacterId":"28056","sourceWorkId":"38543","spoiler":false},{"segments":[{"spoiler":false,"text":"元々はネットで活動する歌い手として人気を博していた。"},{"spoiler":false,"text":"その収益を元に芸能プロダクションを立ち上げ、自身の活動と並行して女性アイドルのプロデュースを開始。"},{"spoiler":false,"text":"すでに何組かのアイドルをデビューさせており、若手ながら業界内で敏腕プロデューサーとして評価を高めている。"},{"spoiler":false,"text":"しかし、歌い手時代からファンに手を出しているとして有名だった。"},{"spoiler":false,"text":"気に入った女の子は自宅に住まわせ、女慣れした手練手管で籠絡しては弄んでいる。"},{"spoiler":false,"text":"元カノやセフレ等を自分の会社で働かせている。"}],"source":"bangumi","sourceCharacterId":"202173"}],"profileFacts":[{"label":"身高（本版本）","value":"176 cm","valueContext":null,"source":"egs","sourceCharacterId":"28056","sourceWorkId":"38543","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5e/5e2990e72b1afad6e24e2208df8ca09d19764f48ae60c29ff64b4cdebad79e10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c55d26df41fec8d85b6dd98f0317e2685c2269696991cd7f8d8efaa93034df72.webp","width":117,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c151673","characterName":"土岐 譲","sourceIds":{"vndbCharacterId":"c151673"},"originalCharacterName":"土岐 譲","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"b"},"height":{"reviewState":"source-only","source":"vndb","value":"171"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"source-only","source":"vndb","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He is friends with Rin since childhood."},{"spoiler":false,"text":"Wanting to spend as much time as possible with his first love, Rin, he hides the fact that he is a childhood friend and applies to do odd jobs at Rin's production company."},{"spoiler":false,"text":"He is in awe of Rin's efforts every day in preparation for her debut."},{"spoiler":false,"text":"His hobby is computers, and he has recently been teaching himself video editing. He hopes to get a job in video production in the future."},{"spoiler":false,"text":"He is unaware that Rin is living alone with Toya."}],"source":"vndb","sourceCharacterId":"c151673"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p980","sourceCompanyId":"egs:brand:1815","canonicalEntityId":"vndb:p980","name":"LiLiM DARKNESS","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:38543:1815","source":"egs"},{"companyId":"vndb:p980","sourceCompanyId":"vndb:p980","canonicalEntityId":"vndb:p980","name":"LiLiM DARKNESS","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:145691:v55873","source":"vndb"},{"companyId":"vndb:p980","sourceCompanyId":"vndb:p980","canonicalEntityId":"vndb:p980","name":"LiLiM DARKNESS","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:145758:v55873","source":"vndb"},{"companyId":"vndb:p980","sourceCompanyId":"vndb:p980","canonicalEntityId":"vndb:p980","name":"LiLiM DARKNESS","roleCodes":["developer"],"identityStatus":"source-native","relationId":"vndb:release-producer:175751:v55873","source":"vndb"},{"companyId":"vndb:p10008","sourceCompanyId":"vndb:p10008","canonicalEntityId":"vndb:p10008","name":"ホビコレD","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:175752:v55873","source":"vndb"}],"m