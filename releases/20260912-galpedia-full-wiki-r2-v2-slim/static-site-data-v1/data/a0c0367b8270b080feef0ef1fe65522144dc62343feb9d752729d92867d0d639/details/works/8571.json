s":[{"segments":[{"spoiler":false,"text":"主人公と同じ専門学校に通う一年生。"},{"spoiler":false,"text":"歳は主人公より一つ上だが、社会人を経て入学したため、学年は一つ下。"},{"spoiler":false,"text":"主人公と“くるみ”とは子供の頃から仲良しで、弟、妹のように可愛がっている。"},{"spoiler":false,"text":"特に「放っておけない」雰囲気のある主人公に対しては、ついつい過剰に世話を焼いてしまう傾向がある。"}],"source":"egs","sourceCharacterId":"21985","sourceWorkId":"8571","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公と同じ専門学校に通う一年生。"},{"spoiler":false,"text":"歳は主人公より一つ上だが、学年は一年後輩。"},{"spoiler":false,"text":"『くるみ』と同じ学科を専攻している。"},{"spoiler":false,"text":"『喫茶、陽だまり』でアルバイト中。"},{"spoiler":false,"text":"主人公と『くるみ』とは子供の頃からの仲良しで、実の弟、妹のようにかわいがっている。"},{"spoiler":false,"text":"一つ年下の主人公のことが危なっかしくてつい世話を焼いてしまう。"},{"spoiler":false,"text":"「困ったことがあったらいつでも相談してね」"}],"source":"bangumi","sourceCharacterId":"67069"}],"profileFacts":[{"label":"罩杯（本版本）","value":"e","valueContext":null,"source":"egs","sourceCharacterId":"21985","sourceWorkId":"8571","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3785a7dd59d06927b8137175738d5da5b9da1098fcadfc44cd9fc8f680a3fb9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5b0067afee5fa0c353ed2cc8c3ed1dbe94db176a969b56af3269c15df460980b.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"瑞沢渓","creatorId":"vndb:s28","sourcePersonId":"vndb:s28","canonicalEntityId":"vndb:s28","name":"瑞沢 渓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:70419:67069:5741:1","source":"bangumi"}]},{"characterId":"char_c53749","characterName":"南 くるみ","sourceIds":{"bangumi":[{"characterId":"67070","match":"exact-normalized-name-in-linked-work","subjectId":"70419"}],"egsCharacterIds":["21986"],"vndbCharacterId":"c53749"},"originalCharacterName":"南 くるみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","