s27051","name":"忍花","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:169386","source":"vndb"},{"creditedName":"あつお","creatorId":"vndb:s32387","sourcePersonId":"vndb:s32387","canonicalEntityId":"vndb:s32387","name":"あつお","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:169387","source":"vndb"},{"creditedName":"内山義隆","creatorId":"vndb:s34009","sourcePersonId":"vndb:s34009","canonicalEntityId":"vndb:s34009","name":"内山義隆","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:169388","source":"vndb"}]},"cast":[{"characterId":"char_c93311","characterName":"マリア・ローレンス","sourceIds":{"bangumi":[{"characterId":"95755","match":"exact-normalized-name-in-linked-work","subjectId":"315165"}],"egsCharacterIds":["26039"],"vndbCharacterId":"c93311"},"originalCharacterName":"マリア・ローレンス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"100"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"G"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"63"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A talented captain at a young age and bears the expectations of the military. She's kind, treats everyone equally and doesn't make anyone feel like they are beneath her elite status..."},{"spoiler":false,"text":"...On the surface. She never reveals her true face, but she is actually a ruthless commander. She views her subordinates as disposable and practices unreasonable strategies. So, except for some senior officials, everyone is completely deceived."}],"source":"vndb","sourceCharacterId":"c93311"},{"segments":[{"spoiler":false,"text":"若くして艦長になった秀才で、軍の期待。"},{"spoiler":false,"text":"優しく、誰にでも等しく接し、上層部にあるエリート感はそこまで感じさせない。"},{"spoiler":false,"text":"……というのは表面。決して表に出さないが、実際は冷酷な指揮官。"},{"spoiler":false,"text":"下の人間を使い捨てと考え、無茶な作戦なんかも実践する。"},{"spoiler":false,"text":"なので、一部の高官以外は完全に騙されている。"}],"source":"egs","sourceCharacterId":"26039","sourceWorkId":"29907","spoiler":false},{"segments":[{"spoiler":false,"text":"若くして艦長になった才媛。"},{"spoiler":false,"text":"誰にでも優しく等しく接するなど、上層部にあるエリート感のない誰からも慕われる理想の艦長。"},{"spoiler":false,"text":"……というのは表向き。"},{"spoiler":false,"text":"実際は冷酷な指揮官の顔を隠しており、"},{"spoiler":false,"text":"下の人間を使い捨てと考え、無茶な作戦も眉ひとつ動かさず実行する。"},{"spoiler":false,"text":"その顔は一部の高官以外は知らず、ほかの者たちは完全に騙されている。"}],"source":"bangumi","sourceCharacterId":"95755"}],"profileFacts":[{"label":"胸围（本版本）","value":"100 cm","valueContext":null,"source":"egs","sourceCharacterId":"26039","sourceWorkId":"29907","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"g","valueContext":null,"source":"egs","sourceCharacterId":"26039","sourceWorkId":"29907","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"26039","sourceWorkId":"29907","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"26039","sourceWorkId":"29907","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"63 cm","valueContext":null,"source":"egs","sourceCharacterId":"26039","sourceWorkId":"29907","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/57/578818c09c7a8c5d5ada0a1afe8b2bb27ae2123f9097a592709dc1bb5deda7cd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3ca156b8e6403f35f1a666c5e2cd398f18ef54615e1470fd1de513b9f7ed7b0e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"なかせひな","creatorId":"vndb:s926","sourcePersonId":"vndb:s926","canonicalEntityId":"vndb:s926","name":"なかせ ひな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:315165:95755:12719:1","source":"bangumi"}]},{"characterId":"char_c93312","characterName":"リサ・リンディ","sourceIds":{"bangumi":[{"characterId":"95756","match":"exact-normalized-name-in-linked-work","subjectId":"315165"}],"egsCharacterIds":["26040"],"vndbCharacterId":"c93312"},"originalCharacterName":"リサ・リンディ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An ace of military with high expectations who has begun to stand out as a genius pilot. She is strong and unyielding. While she is confident, she also works hard. Therefore, she is cold to people who do not make efforts or who do not live up to their expectations."},{"spoiler":false,"text":"Coupled with her appearance, she is also an idol who is used by the military for advertising, and she does not find this special treatment to be unpleasant but rather, \"It is natural for me\""}],"source":"vndb","sourceCharacterId":"c93312"},{"segments":[{"spoiler":false,"text":"天才パイロットとして頭角を現し始めた、軍期待のエース。"},{"spoiler":false,"text":"気が強く負けず嫌い。自信家だが、努力を怠らない一面も持つ。"},{"spoiler":false,"text":"そのため努力しない人間や、自分の期待に応えない人間には冷たい。"},{"spoiler":false,"text":"容姿も相まって、軍が広告に使ったりもしているアイドル的存在でもあり、そんな扱いにも嫌な顔はせず、むしろ「私なら当然の事」と積極的に協力している。"}],"source":"egs","sourceCharacterId":"26040","sourceWorkId":"29907","spoiler":false},{"segments":[{"spoiler":false,"text":"天才パイロットとして頭角を現し始めた、軍期待のエース。"},{"spoiler":false,"text":"気が強く負けず嫌い。自信家だが、努力を怠らない一面も持つ。"},{"spoiler":false,"text":"そのため努力しない人間や、自分の期待に応えない人間には冷たい。"},{"spoiler":false,"text":"容姿も良いため軍が広告にも起用され、アイドル的存在でもある。"},{"spoiler":false,"text":"そんな扱いにも嫌な顔はせず、「私なら当然の事」と積極的に協力している。"}],"source":"bangumi","sourceCharacterId":"95756"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"26040","sourceWorkId":"29907","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"26040","sourceWorkId":"29907","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"26040","sourceWorkId":"29907","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"26040","sourceWorkId":"29907","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"26040","sourceWorkId":"29907","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/4482245bfccd3e8912c5c31d4c3b8d4eb1941c886b4476f95ad041610f827f5d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8da944e80a4df965d4f961ebad85891d0161d3a59c68fbe2265d42ecec2fa9df.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤吉 ローズ","creatorId":"vndb:s22420","sourcePersonId":"vndb:s22420","canonicalEntityId":"vndb:s22420","name":"藤吉 ローズ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:85812","source":"vndb"}]},{"characterId":"char_c93313","characterName":"ゼニア・エドワーズ","sourceIds":{"bangumi":[{"characterId":"95757","match":"exact-normalized-name-in-linked-work","subjectId":"315165"}],"egsCharacterIds":["26041"],"vndbCharacterId":"c93313"},"originalCharacterName":"ゼニア・エドワーズ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"94"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"93"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"61"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Since her parents are soldiers, she is a soldier from the ground up. She is delighted to be faithful to her assigned duties and to achieve maximum results. Therefore, she is unforgiving to layabouts and those who interfere with orders."},{"spoiler":false,"text":"She's not silent and stoic but she doesn't say anything extra and handles orders in a straightforward manner."}],"source":"vndb","sourceCharacterId":"c93313"},{"segments":[{"spoiler":false,"text":"両親が軍人のため、根っからの軍人。"},{"spoiler":false,"text":"与えられた任務を忠実に、かつ最大成果を出す事に喜びを感じている。"},{"spoiler":false,"text":"それ故、命令の邪魔をする人間や足を引っ張る人間には容赦ない。"},{"spoiler":false,"text":"無口＆無表情……ではないが、余計な事を言わず、淡々と命令をこなす。"},{"spoiler":false,"text":"その仕事ぶりと優秀さから、一目置かれている。"}],"source":"egs","sourceCharacterId":"26041","sourceWorkId":"29907","spoiler":false},{"segments":[{"spoiler":false,"text":"両親が軍人のため、根っからの軍人。"},{"spoiler":false,"text":"与えられた任務を忠実にこなし、最大成果を出す事に喜びを感じる。"},{"spoiler":false,"text":"そのため、遂行の邪魔をしたり、足を引っ張る人間には容赦がない。"},{"spoiler":false,"text":"無口で無表情というほどではないが、余計な事を言わず、淡々と命令をこなす。"},{"spoiler":false,"text":"その仕事ぶりと優秀さで一目置かれている。"}],"source":"bangumi","sourceCharacterId":"95757"}],"profileFacts":[{"label":"胸围（本版本）","value":"94 cm","valueContext":null,"source":"egs","sourceCharacterId":"26041","sourceWorkId":"29907","sourceField":null,"scoped":true},{"label