eatorId":"vndb:s3589","sourcePersonId":"vndb:s3589","canonicalEntityId":"vndb:s3589","name":"黒木 雅弘","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:52783","source":"vndb"},{"creditedName":"Yuki","creatorId":"vndb:s23112","sourcePersonId":"vndb:s23112","canonicalEntityId":"vndb:s23112","name":"Yuki","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:52786","source":"vndb"}]},"cast":[{"characterId":"char_c33437","characterName":"ジュピター","sourceIds":{"bangumi":[{"characterId":"146111","match":"exact-normalized-name-in-linked-work","subjectId":"296146"}],"egsCharacterIds":["26704"],"vndbCharacterId":"c33437"},"originalCharacterName":"ジュピター","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"異世界からやってきた隻眼ネコ耳のサムライ少女。"},{"spoiler":false,"text":"彼女は人間ではなく、彼女の世界における人間の生活をサポートするために創造された「ヒトガタ」と呼ばれる人工生命体。"},{"spoiler":false,"text":"主人公と「エンゲージ」を交わした彼女は、はるると共に主人公の家に住み着く。"},{"spoiler":false,"text":"大胆不敵にして奔放、曲がったことが大嫌いな一本筋の通った性格。"},{"spoiler":false,"text":"普段は猫のようにのんびりしているが、いざというときにビシッと決める。"}],"source":"egs","sourceCharacterId":"26704","sourceWorkId":"4542","spoiler":false},{"segments":[{"spoiler":false,"text":"隻眼ネコ耳のサムライ少女。"},{"spoiler":false,"text":"トランクに美少女ひとりを詰め込んで、突然主人公の前に現れた。"},{"spoiler":false,"text":"自らが未来で造られた「ヒトガタ」である、という説明もそこそこに、"},{"spoiler":false,"text":"そのまま隆司の家に居着いてしまう。"},{"spoiler":false,"text":"性格は奔放で大胆不敵、曲がったことが大嫌い。"},{"spoiler":false,"text":"普段はのんきに構えているが、やるときはビシッと決めるタイプ。"}],"source":"bangumi","sourceCharacterId":"146111"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fcf5e7e83d37c85dca6652e9cb7bb6820177c8852d7f4964972ea5f15810a742.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a2/a2341c5b94e931008f31fb3b7a649918369af196eefd21452470e7f05a9d6362.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梨々華","creatorId":"vndb:s25548","sourcePersonId":"vndb:s25548","canonicalEntityId":"vndb:s25548","name":"梨々華","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:29232","source":"vndb"}]},{"characterId":"char_c33438","characterName":"東雲 はるる","sourceIds":{"bangumi":[{"characterId":"146112","match":"exact-normalized-name-in-linked-work","subjectId":"296146"}],"egsCharacterIds":["26705"],"vndbCharacterId":"c33438"},"originalCharacterName":"東雲 はるる","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ジュピターが異世界から持ち込んだトランクの中に入っていた「ヒトガタ」の少女。"},{"spoiler":false,"text":"素直で礼儀正しく、好奇心旺盛なおませさん。"},{"spoiler":false,"text":"やや思い込みも激しいところもあり、子供扱いされるのが大嫌い。"},{"spoiler":false,"text":"家事全般をこなし、料理も得意。"},{"spoiler":false,"text":"主人公の身の回りの世話を一手に引き受ける。"}],"source":"egs","sourceCharacterId":"26705","sourceWorkId":"4542","spoiler":false},{"segments":[{"spoiler":false,"text":"ジュピターが未来から持ち込んだトランクに入っていた「ヒトガタ」の女の子。"},{"spoiler":false,"text":"愛らしい外見の通り、いつも素直で礼儀正しいが、"},{"spoiler":false,"text":"名前ぐらいしか憶えていない隆司をはるばる訪ねてくるあたり、"},{"spoiler":false,"text":"ちょっと思い込みの強いところがある。家事、特に料理が好きで、"},{"spoiler":false,"text":"隆司の身の回りの世話を一手に引き受ける。"},{"spoiler":false,"text":"好奇心と向上心が強いおませさんで、"},{"spoiler":false,"text":"○○扱いされる事がなにより嫌い。"}],"source":"bangumi","sourceCharacterId":"146112"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5dd915b3b67db501f22a0f3712c433db29d40ba31e6ade71e370c53ca723358.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2d92f65a5fcaa8f89627e6e5371d58e1ac7a1c15177623dc4c0443fc61dd39e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:296146:146112:4675:1","source":"bangumi"}]},{"characterId":"char_c33439","characterName":"紺野 理香子","sourceIds":{"bangumi":[{"characterId":"146113","match":"exact-normalized-name-in-linked-work","subjectId":"296146"}],"egsCharacterIds":["26706"],"vndbCharacterId":"c33439"},"originalCharacterName":"紺野 理香子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の同級生にして幼馴染。"},{"spoiler":false,"text":"文武両道の優等生で、人柄も良く、誰にでも優しく接する女の子。"},{"spoiler":false,"text":"人に弱みを見せたり、甘えたりするのが苦手で、意地っ張りなところも。"},{"spoiler":false,"text":"数年ぶりに再会した主人公に、はじめはそっけない態度をとるが、ジュピターらと同居していることを知ってからは、ちょくちょく主人公宅に顔を出すようになる。"}],"source":"egs","sourceCharacterId":"26706","sourceWorkId":"4542","spoiler":false},{"segments":[{"spoiler":false,"text":"隆司の同級生で、幼なじみ。"},{"spoiler":false,"text":"文武両道でみんなに優しい、絵に描いたような優等生だが。"},{"spoiler":false,"text":"人に弱みを見せたり、甘えたりするのが苦手。"},{"spoiler":false,"text":"数年ぶりに戻ってきた隆司に対してそっけない態度を取るが、"},{"spoiler":false,"text":"ジュピターやはるると鉢合わせしてからは、"},{"spoiler":false,"text":"なにかと理由をつけては隆司の家に顔を出すようになる。"}],"source":"bangumi","sourceCharacterId":"146113"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2a8842f33f88669d34ba54ccac9b372f9021ab97fa1037a8f060553133f800a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8a4055eef852df7eadc6369c6cf062fc6d79ec250757705dcb58d397ce713e7d.webp","width":213,"height":256,"