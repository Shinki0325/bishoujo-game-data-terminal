れない性格で根が純粋。"},{"spoiler":false,"text":"主人公に強く当たるが、すべて愛情の裏返しであることを周囲全員に見透かされてる、ツンデレ失敗作。"},{"spoiler":false,"text":"スク水について特別な感情は無く、「学校の水着でしょ」くらいの認識。"},{"spoiler":false,"text":"怒っても全然怖くない。"},{"spoiler":false,"text":"「あ、あんたたち……、兄妹で、何やってんのよぉぉお～～～～っ！？」"}],"source":"bangumi","sourceCharacterId":"136188"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"21084","sourceWorkId":"8983","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"21084","sourceWorkId":"8983","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"21084","sourceWorkId":"8983","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"21084","sourceWorkId":"8983","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"47 kg","valueContext":null,"source":"egs","sourceCharacterId":"21084","sourceWorkId":"8983","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"hip":[{"comparisonValue":"83","source":"vndb","sourceCharacterId":"c90773","value":"83"},{"comparisonValue":"84","scope":"sourceWork","source":"egs","sourceCharacterId":"21084","sourceWorkId":"8983","value":"84"},{"comparisonValue":"84","source":"bangumi","sourceCharacterId":"136188","value":"84"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f2/f2ed6e5e902d0a51b896d71acfe2096de4372707332b9e6e3561e29d6d8d03d5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/af58f60df1eab3de3968833a80f80b993aeae342665b76827e4be6e80ad700a1.webp","width":205,"height":256,"source":"static-detail"},"actors":[{"creditedName":"由宇翼","creatorId":"vndb:s1420","sourcePersonId":"vndb:s1420","canonicalEntityId":"vndb:s1420","name":"由宇 翼","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirme