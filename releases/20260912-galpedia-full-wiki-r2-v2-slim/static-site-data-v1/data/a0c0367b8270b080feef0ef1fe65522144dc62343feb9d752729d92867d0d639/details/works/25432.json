[{"spoiler":false,"text":"有名なアイドルグループに所属しているが、本業は退魔師。"},{"spoiler":false,"text":"防御系の優秀な術師で、香織とペアで行動している。 鈴子とは犬猿の仲。"},{"spoiler":false,"text":"アニメ・特撮オタクで変身美少女に憧れており、退魔の仕事中はマスク着用。"},{"spoiler":false,"text":"顔バレ防止と言い張っているがコスプレで、よく鈴子にいじられている。"},{"spoiler":false,"text":"また猫又のハーフなので猫耳と尻尾が出たり、マタタビで酔ったりする。"},{"spoiler":false,"text":"性格は子供っぽくツンデレ泣き虫。 幼児体型で下半身太りを気にしている。"},{"spoiler":false,"text":"またナイチチがコンプレックスで、その点においては鈴子と気が合う様子。"}],"source":"bangumi","sourceCharacterId":"91669"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9185fbe5b431759b25b9c96229ecd647dfa9c7ba4abebbd28a4f6dc20d91232.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4a/4a85d95e86369e47cd31752a5ee0c3ed5526202dc8d8e2f936518dd8e9e52bb4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"湯宮由海","creatorId":"vndb:s5006","sourcePersonId":"vndb:s5006","canonicalEntityId":"vndb:s5006","name":"湯宮 由海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:414024:91669:19558:1","source":"bangumi"}]},{"characterId":"char_c43149","characterName":"桐島 香織","sourceIds":{"bangumi":[{"characterId":"91670","match":"exact-normalized-name-in-linked-work","subjectId":"183218"}],"egsCharacterIds":["8034"],"vndbCharacterId":"c43149"},"originalCharacterName":"桐島 香織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"神庭 空と同じアイドルグループに所属"},{"spoiler":false,"text":"性格はおっとり言葉遣いは丁寧"},{"spoiler":false,"text":"妖しい色気を持っている"},{"spoiler":false,"text":"空や鈴子の事を妹のように思っている"},{"spoiler":false,"text":"怒ると怖い"}],"source":"egs","sourceCharacterId":"8034","sourceWorkId":"23117","spoiler":false},{"segments":[{"spoiler":false,"text":"妖し