Status":"source-native","relationId":"vndb:vn-staff:136633","source":"vndb"},{"creditedName":"STRIKERS","creatorId":"vndb:s15588","sourcePersonId":"vndb:s15588","canonicalEntityId":"vndb:s15588","name":"STRIKERS","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:136636","source":"vndb"}]},"cast":[{"characterId":"char_c55641","characterName":"ルナライト・ベイカー","sourceIds":{"bangumi":[{"characterId":"50164","match":"exact-normalized-name-in-linked-work","subjectId":"203020"}],"egsCharacterIds":["14096"],"vndbCharacterId":"c55641"},"originalCharacterName":"ルナライト・ベイカー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"707"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"height":{"reviewState":"no-conflict","source":"vndb","value":"151"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The magician-in-training Lunalight who wants to understand love in order to become a full-fledged magician. Her hobby is watching the starry sky."}],"source":"vndb","sourceCharacterId":"c55641"},{"segments":[{"spoiler":false,"text":"優斗のひとつ年下の後輩で、魔法使い見習いの少女。"},{"spoiler":false,"text":"由緒正しい家柄の一人娘で、言葉端や動作からは気品さを漂わせながら、どこか蠱惑的な魅力を併せ持つ。"},{"spoiler":false,"text":"また、何事に対してもはっきりと物事を言い、行動に移すのも早く、芯がしっかりとしている性格。"},{"spoiler":false,"text":"興味のない人間に対しては冷淡な対応をするも、『気に入った人物の困った顔を見るのが好き』という小悪魔気質な部分を備えており、そのため気に入られてしまった優斗は苦労することに。"},{"spoiler":false,"text":"魔法の素養も知識も十分ではあるが、恋を知らないためか未だ魔法使いになれていないことが唯一のコンプレックス。"},{"spoiler":false,"text":"本人は早く失恋し、魔法使いになりたいと考えているものの、とある事情から未だ恋をすることが出来ず、今に至る。"}],"source":"egs","sourceCharacterId":"14096","sourceWorkId":"24616","spoiler":false},{"segments":[{"spoiler":false,"text":"優斗の一つ年下の後輩で、魔法使い見習いの少女。"},{"spoiler":false,"text":"名家の一人娘で、所作に気品を漂わせながら、どこか蠱惑的な魅力を併せ持つ。"},{"spoiler":false,"text":"また物事をはっきりと言い、行動に移すのも早く、芯がしっかりとしている。"},{"spoiler":false,"text":"興味のない人間には冷淡だが、“気に入った人物の困った顔を見るのが好き”"},{"spoiler":false,"text":"という小悪魔気質な部分を備え、そのため優斗は苦労することに。"},{"spoiler":false,"text":"魔法の素養は十分だが、恋を知らず魔法使いになれていないことが唯一のコンプレックス。"},{"spoiler":false,"text":"早く失恋して魔法使いになりたいと考えているが、とある事情から恋をすることが出来ず今に至る。"},{"spoiler":false,"text":"「先輩のことを好きになったら、その時はちゃんとわたしを振ってくださいね？　約束ですよ？」"}],"source":"bangumi","sourceCharacterId":"50164"}],"profileFacts":[{"label":"好き","source":"bangumi","sourceCharacterId":"50164","value":"読書、気に入っている人物の困った表情"},{"label":"嫌い","source":"bangumi","sourceCharacterId":"50164","value":"特別ではないもの、無駄な時間、辛いもの"},{"label":"所属","source":"bangumi","sourceCharacterId":"50164","value":"麻保志学園 前期過程 3年"},{"label":"趣味","source":"bangumi","sourceCharacterId":"50164","value":"星を眺めること"},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"14096","sourceWorkId":"24616","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"151 cm","valueContext":null,"source":"egs","sourceCharacterId":"14096","sourceWorkId":"24616","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8c21997990d120988cb550eafc9d43a2ba83d661b64b408f69108440103697e1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/61/618dfb3ce81b90dbb39063706581777c114b807feadf443ea49815cc84d449de.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"岡本理絵","creatorId":"vndb:s874","sourcePersonId":"vndb:s874","canonicalEntityId":"vndb:s874","name":"岡本 理絵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:203020:50164:13368:1","source":"bangumi"}]},{"characterId":"char_c55642","characterName":"ちびっこ先生","sourceIds":{"bangumi":[{"characterId":"50165","match":"exact-normalized-name-in-linked-work"