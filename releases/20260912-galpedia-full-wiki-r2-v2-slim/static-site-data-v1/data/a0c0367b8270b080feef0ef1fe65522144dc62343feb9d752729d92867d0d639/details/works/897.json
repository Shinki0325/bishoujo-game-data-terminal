":false,"text":"大事に育てられた箱入りの娘で、人を疑うことを知らない純粋無垢な性格。"}],"source":"egs","sourceCharacterId":"27901","sourceWorkId":"897","spoiler":false},{"segments":[{"spoiler":false,"text":"ヤーパンの古都にある、それほど大きくはない神社の末娘。生まれつき霊力が高く、また、笛の才能にも恵まれている。箱入り娘のため、性格は純真無垢。そのため、人にだまされやすい。"}],"source":"bangumi","sourceCharacterId":"151024"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea503f44158e724263ddb57643474f117038d259bff54c6a1205c622bc12a5b8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b0/b0d439e42d40dc220571a5d8ba71c2a31a75459ed36a6d186d79ee479e13d92e.webp","width":150,"height":220,"source":"static-detail"},"actors":[{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日 アン","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:325666:151024:6480:1","source":"bangumi"}]},{"characterId":"char_c85795","characterName":"杏","sourceIds":{"bangumi":[{"characterId":"151023","match":"exact-normalized-name-in-linked-work","subjectId":"325666"}],"egsCharacterIds":["27900"],"vndbCharacterId":"c85795"},"originalCharacterName":"杏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"旅芸人一座の一人娘。"},{"spoiler":false,"text":"旅暮らしで気苦労も絶えないが、そうした憂いも、くよくよしないポジティブで明るい性格で吹き飛ばす。"},{"spoiler":false,"text":"しかし、時折、一座の仲間のことを思い出して、センチメンタルになってしまうことも……。"}],"source":"egs","sourceCharacterId":"27900","sourceWorkId":"897","spoiler":false},{"segments":[{"spoiler":false,"text":"旅芸人一座の一人娘で、生まれついての旅暮らし。くよくよしない性格で、旅の苦労もさらっと流すすべを身につけている。しかし、時折一座の仲間を思いだして、寂しくなることもある。"}],"source":"bangumi","sourceCharacterId":"151023"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"