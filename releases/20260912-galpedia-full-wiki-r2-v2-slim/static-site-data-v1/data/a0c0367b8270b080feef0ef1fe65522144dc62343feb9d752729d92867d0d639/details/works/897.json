"characterId":"151022","match":"exact-normalized-name-in-linked-work","subjectId":"325666"}],"egsCharacterIds":["27899"],"vndbCharacterId":"c85851"},"originalCharacterName":"ミモザ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"発明家の少女。"},{"spoiler":false,"text":"ずっと自宅にこもって研究に没頭しているため、やや世間ズレしているところがある。"},{"spoiler":false,"text":"しかし、時折、ズバッと鋭いことを言って、周囲を驚かせることも。"}],"source":"egs","sourceCharacterId":"27899","sourceWorkId":"897","spoiler":false},{"segments":[{"spoiler":false,"text":"発明家。自宅にこもりっきりで発明に興じているため、世間一般からはかなりズレた考えをする。しかし、時折するどいことを言ったりもする。"}],"source":"bangumi","sourceCharacterId":"151022"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7f/7f28b2e4376b4ac29399951b5ea809ca0edfd2fc1437e31644315b4d597e5359.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d4/d42bd2b7af3a24d64de3dbd9ac8425c5bac6e58ba995d27a8816ef99ba94e814.webp","width":150,"height":221,"source":"static-detail"},"actors":[]},{"characterId":"char_c85852","characterName":"コーネリア","sourceIds":{"bangumi":[{"characterId":"151016","match":"exact-normalized-name-in-linked-work","subjectId":"325666"}],"egsCharacterIds":["27895"],"vndbCharacterId":"c85852"},"originalCharacterName":"コーネリア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"隣国の軍事国家「ザルツラング」の王女。"},{"spoiler":false,"text":"第一王位継承者でもあり、その地位から弟・シオンに命を狙われ、「シェオン・エル」を頼ってきた。"},{"spoiler":false,"text":"穏やかで心優しい性格だが、芯は強く、自分の信念を決して曲げない頑固な一面を持つ。"}],"source":"egs","sourceCharacterId":"27895","sourceWorkId":"897","spoiler":false},{"segments":[{"spoiler":false,"text":"隣国の王女。第一王位継承者でもある。穏かで心優しいが、芯は強く己の信念を決して曲げない、意外と頑固で一途な面がある。"}],"source":"bangumi","sourceCharacterId":"151016"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/38/3819fa52f4f0f83281627fe65d337835e51eb259e6b75060de7f335c161d1561.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6c/6cee18d812f35cb784f914528168c2ed18f7fdaad80ed0c02a90f5552ee2d844.webp","width":150,"height":218,"source":"static-detail"},"actors":[]},{"characterId":"char_c85853","characterName":"ソフィ","sourceIds":{"bangumi":[{"characterId":"151019","match":"exact-normalized-name-in-linked-work","subjectId":"325666"}],"egsCharacterIds":["27904"],"vndbCharacterId":"c85853"},"originalCharacterName":"ソフィ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a carpenter."}],"source":"vndb","sourceCharacterId":"c85853"},{"segments":[{"spoiler":false,"text":"「シェオン・エル」にある町の拡充整備を一手に引き受ける大工の棟梁の娘。"},{"spoiler":false,"text":"小さい頃から大工仲間に囲まれて育ったため、性格は非常に男勝り。"},{"spoiler":false,"text":"仕事に関しては、非常に丁寧で手を抜いたりしない。"},{"spoiler":false,"text":"仲間からの信頼も厚く、女だてらに次期棟梁にも……。"}],"source":"egs","sourceCharacterId":"27904","sourceWorkId":"897","spoiler":false},{"segments":[{"spoiler":false,"text":"大工の少女。幼少時から大工仲間に囲まれて育ったために、男勝りの性格になったが、がさつというわけではなく、仕事は手を抜いたりしない。そのため仲間の人望は厚い。"}],"source":"bangumi","sourceCharacterId":"151019"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7c/7ced92c015444d44e98906c2bc27db13b4094e9e2f797855d91baace0aa68ece.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/089cf5477250cb983a29ae4796683ee643a8cb3472788cd383063b71429f0449.webp","width":150,"height":220,"source":"static-detail"},"actors":[{"creditedName":"静木亜美","creatorId":"vndb:s663","sourcePersonId":"vndb:s663","canonicalEntityId":"vndb:s663","name":"静木 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:325666:151019:8575:1","source":"bangumi"}]},{"characterId":"char_c85870","characterName":"清風","sourceIds":{"bangumi":[{"characterId":"151018","match":"exact-normalized-name-in-linked-work","subjectId":"325666"}],"egsCharacterIds":["27902"],"vndbCharacterId":"c85870"},"originalCharacterName":"清風","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"かつて東方に栄えた国の戦士。"},{"spoiler":false,"text":"西方から攻め込んできた軍隊の未知なる術によって異空間に閉じ込められ、長い間、封印されていた。"},{"spoiler":false,"text":"そのため、人間らしい感情や心が失われ、闘争本能のみが残ってしまい、敵を倒すことに何のためらいも感じない冷徹な殺戮マシーンになってしまっている。"}],"source":"egs","sourceCharacterId":"27902","sourceWorkId":"897","spoiler":false},{"segments":[{"spoiler":false,"text":"もとは、かつて東方に栄えたある国の戦士。しかし、西方から攻め込んできた軍隊の未知の術に、肉体ごと異空間に封印された。長い間封印されていたため、人としての心はそげ落ち、闘争本能のみがつまっている。敵を殺すことに何のためらいも感じない冷徹な戦闘マシーン。"}],"source":"bangumi","sourceCharacterId":"151018"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/9643fee0d290a69d9b05d2baa385b03807754fa551d6fb7faa4f4fb820dde63d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c1cf3f73afb7eaddf21b37d5f01b875037dd342f3ce02fde9f7db72d60c7ef0.webp","width":150,"height":219,"source":"static-detail"},"actors":[{"creditedName":"季蓮崎 みこと","creatorId":"vndb:s8137","sourcePersonId":"vndb:s8137","canonicalEntityId":"vndb:s8137","name":"季蓮崎 みこと","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:60018","source":"vndb"}]},{"characterId":"char_c85871","characterName":"フィーヌゼルブ","sourceIds":{"bangumi":[{"characterId":"151021","match":"exact-normalized-name-in-linked-work","subjectId":"325666"}],"egsCharacterIds":["27897"],"vndbCharacterId":"c85871"},"originalCharacterName":"フィーヌゼルブ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「シェオン・エル」の政治に代々関わってきた一族の家系に生まれた女性。"},{"spoiler":false,"text":"色気と知性を兼ね備えた才女。"},{"spoiler":false,"text":"常に主人公の傍らにあって、色々と政（まつりごと）のサポートをしてくれる。"},{"spoiler":false,"text":"主人公にとっての母親代わりでもあり、主人公を猫可愛がりしている。"}],"source":"egs","sourceCharacterId":"27897","sourceWorkId":"897","spoiler":false},{"segments":[{"spoiler":false,"text":"代々国の政治に関わってきた政治家一族の家系に生まれる。たおやかで、色気と知性が漂う大人の女性。"}],"source":"bangumi","sourceCharacterId":"151021"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e06903e655029565dac5d5b6f4562917d364091c1adda8fea0afd19e324afde.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/75e62e0dba506f991dd0ea6fec28c642c0386f3f21d52ba7f076790ac6bc09c1.webp","width":150,"height":220,"source":"static-detail"},"actors":[{"creditedName":"春日アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日 アン","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:325666:151021:6480:1","source":"bangumi"}]},{"characterId":"char_c85872","characterName":"ナーラ","sourceIds":{"bangumi":[{"characterId":"151017","match":"exact-normalized-name-in-linked-work","subjectId":"325666"}],"egsCharacterIds":["27896"],"vndbCharacterId":"c85872"},"originalCharacterName":"ナーラ","characterNameSource":null,"role":"primary","status":"source-only-candid