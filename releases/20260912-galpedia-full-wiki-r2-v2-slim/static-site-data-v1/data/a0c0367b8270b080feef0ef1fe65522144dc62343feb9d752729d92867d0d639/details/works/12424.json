,"identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公たちの住む愛見市にある、新良城神社の娘。"},{"spoiler":false,"text":"主人公たちと同じ照陽学園に通う3年生。"},{"spoiler":false,"text":"祖父とともに、新良城神社の裏手にある家に住んでいる。"},{"spoiler":false,"text":"恋愛経験のなかった彼女だが、自分の神社で出会った主人公に一目惚れ。"},{"spoiler":false,"text":"主人公たちの関係に一石を投じる。"},{"spoiler":false,"text":"一見クールな彼女だが、外見より抜けてるところもアリ。"},{"spoiler":false,"text":"初めての恋愛に戸惑いながらも、主人公へと一生懸命アピールしてくる。"},{"spoiler":false,"text":"「一目惚れって、本当にあるんですよ」"}],"source":"egs","sourceCharacterId":"15315","sourceWorkId":"12424","spoiler":false},{"segments":[{"spoiler":false,"text":"愛見市にある、新良城神社の娘で、主人公たちと同じ照陽学園に通う3年生の先輩。"},{"spoiler":false,"text":"祖父とともに、神社の裏手にある家に住んでいる。"},{"spoiler":false,"text":"恋愛経験のなかった彼女だが、自分の神社で出会った主人公に一目惚れをして告白、意図せず、ややこしい状況を作り出した。"},{"spoiler":false,"text":"一見クールな彼女だが、外見より抜けてるところもアリ。"},{"spoiler":false,"text":"初めての恋愛に戸惑いながらも、主人公に対して一生懸命アピールしてくる。"},{"spoiler":false,"text":"「あなたのことが好きなのは、誰にも負けません」"}],"source":"bangumi","sourceCharacterId":"38003"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8320148ba28c616ba7df5a3d5b5fa4a61fcecd4baac154bf3eb14d3185256e69.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0a42504a06b2f8d165924020302b3e3359911265b3b4f944ff80897bcac6df88.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"計名 さや香","creatorId":"vndb:s859","sourcePersonId":"vndb:s859","canonicalEntityId":"vndb:s859","name":"かずなさやか(計名さや香)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:14581","source":"vndb"}]},{"characterId":"char_c5635","characterName":"水森 明日夏","sourceIds":{"bangumi":[{"characterId":"38000","match":"exact-normalized-name-in-linked-work","subjectId":"16164"}],"egsCharacterIds":["15312"],"vndbCharacterId":"c5635"},"originalCharacterName":"水森 明日夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の隣の家に住む、腐れ縁な幼なじみの少女。"},{"spoiler":false,"text":"なんにでも一生懸命で一途、一点集中。"},{"spoiler":false,"text":"何をするにもアクティブなのだが、恋愛沙汰だけはとても奥手。"},{"spoiler":false,"text":"特にエッチなことに関しては耐性がまったくなく、すぐ顔を真っ赤にしてしまうほど苦手。"},{"spoiler":false,"text":"運動全般得意なのだが、泳げない。その昔、海で溺れたのがトラウマになっており、水に浸かるのが苦手で、お風呂よりもシャワー派である。"},{"spoiler":false,"text":"主人公のために料理を作ってくれるが、腕はそこそこ。"},{"spoiler":false,"text":"いつまでも若々しく、料理の上手い主人公の母親に憧れている。"},{"spoiler":false,"text":"「べ、別にあんたのために作ってあげたわけじゃないわよ。ちょっと多く作りすぎただけなんだからっ」"}],"source":"egs","sourceCharacterId":"15312","sourceWorkId":"12424","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の隣の家に住む、腐れ縁な幼なじみ。"},{"spoiler":false,"text":"何をするにも一生懸命で一途、一点集中。"},{"spoiler":false,"text":"アクティブなのだが、恋愛沙汰には奥手。"},{"spoiler":false,"text":"特にエッチなことに関しては耐性がなく、すぐに顔を真っ赤にしてしまう。"},{"spoiler":false,"text":"運動全般得意なのだが、泳げない。"},{"spoiler":false,"text":"その昔、海で溺れたのがトラウマになっていて、水を顔にかけられるのも苦手なほど。"},{"spoiler":false,"text":"シャワーよりもお風呂が好きだけど、頭を洗う時は未だにシャンプーハットが欠かせない。"},{"spoiler":false,"text":"「ハーレムとかって、不潔、不潔ッ、超不潔ッ！そういうのって、絶対よくない！」"}],"source":"bangumi","sourceCharacterId":"38000"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2daf4886b22916f394413925ec136b45a39b9f878295ff95f74a3ddaba37997c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb68c283c127fc48bc0c4ff3e5fade5198539f29cddc9e0d93b42be2f4d13727.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16164:38000:6351:1","source":"bangumi"}]},{"characterId":"char_c5728","characterName":"五十鈴 えみり","sourceIds":{"bangumi":[{"characterId":"38001","match":"exact-normalized-name-in-linked-work","subjectId":"16164"}],"egsCharacterIds":["15313"],"vndbCharacterId":"c5728"},"originalCharacterName":"五十鈴 えみり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"同級生の小悪魔系エロテロリスト。"},{"spoiler":false,"text":"無口で大人しそうに見えるが、押しが強く、ツッコミは容赦ない。"},{"spoiler":false,"text":"面白そうだと思ったら、努力を惜しまずアクティブに。"},{"spoiler":false,"text":"実はかなりの策士で、尊敬する人物は越後屋。"},{"spoiler":false,"text":"優しくされるのに慣れてない。"},{"spoiler":false,"text":"あまり恋愛ごとには積極的ではないが、本気で好きになったら情報収集をし、心理や行動を考えて、相手を本気にさせようとする。"},{"spoiler":false,"text":"他人のことは良く気付くのに、自分のこととなるとからっきし。"},{"spoiler":false,"text":"「フフフ……既にあなたは私の策にはまったも同然。右往左往しなさいな」"}],"source":"egs","sourceCharacterId":"15313","sourceWorkId":"12424","spoiler":false},{"segments":[{"spoiler":false,"text":"無口で大人しそうに見えるが、押しが強く、ツッコミは容赦ない。"},{"spoiler":false,"text":"面白そうだと思ったら、努力を惜しまずアクティブに動く。"},{"spoiler":false,"text":"実はかなりの策士、尊敬する人物は越後屋。"},{"spoiler":false,"text":"恋愛に積極的ではないが、本気で好きになったら情報収集をし、心理や行動を考えて、相手を本気にさせようとする。"},{"spoiler":false,"text":"優しくされるのに慣れてないせいか、気を引くためにイジワルをしてしまうが、本音では可愛がって欲しいと思っている……はず。"},{"spoiler":false,"text":"「油断大敵、わずかな隙が命取りよ。さぁ、覚悟を決めて大人しくお縄になって」"}],"source":"bangumi","sourceCharacterId":"38001"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2c/2c1d44c7e854947c837b26a1431ae5244c381d82d66ae7501c12093fc643fd56.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9bf99dd59a0b29f9467b7c6bccbc3b19b3d6b7e9f637a53f1cac39dca3b3f30.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:16164:38001:5890:1","source":"bangumi"}]},{"characterId":"char_c5729","characterName":"桐原 小枝","sourceIds":{"bangumi":[{"characterId":"38002","match":"exact-normalized-name-in-linked-work","subjectId":"16164"}],"egsCharacterIds":["15314"],"vndbCharacterId":"c5729"},"originalCharacterName":"桐原 小枝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"照陽学園1年C組。親友の大樹の妹。"},{"spoiler":false,"text":"表情は豊かで、感情がモロに顔に出る。全体的に活発な印象。リス・ネズミ系。"},{"spoiler":false,"text":"素直で明るく、元気でしっかり者だが、動揺したり慌てたりすると、信じられないようなドジをかますことも。"},{"spoiler":false,"text":"兄のことは嫌いではないが、過保護気味のため、少しウザいと思っている。"},{"spoiler":false,"text":"主人公には理想の兄貴像を重ねているらしく、人前でも気にせずに甘えてくる。困った時は乙女の勘頼り。"},{"spoiler":false,"text":"思い込みの激しいタイプ。思考中、ボーっと自分の世界に入り込んで、人の話を聞かなくなることも。"},{"spoiler":false,"text":"園芸部に所属し、校庭の片隅でこっそりと菜園を作って、プチ野菜を育てている。"},{"spoiler":false,"text":"「本っ当にすいません。またウチの兄がご迷惑てんこ盛りで……もぅ、困っちゃいますよね」"}],"source":"egs","sourceCharacterId":"15314","sourceWorkId":"12424","spoiler":false},{"segments":[{"spoiler":false,"text":"素直で明るく、元気でしっかり者だが、動揺したり慌てたりすると、信じられないようなドジをかますことも。"},{"spoiler":false,"text":"過保護気味の兄・大樹に頭を抱える一方、主人公に理想の兄貴像を重ねているらしく、人前でも気にせずに甘えてくる。"},{"spoiler":false,"text":"思い込みの激しいタイプ。思考中、ボーっと自分の世界に入り込んで、人の話を聞かなくなることも。"},{"spoiler":false,"text":"園芸部に所属し、校庭の片隅でこっそりと菜園を作って、プチ野菜を育てている。"},{"spoiler":false,"text":"「本っ当にすいません。またウチの兄がご迷惑てんこ盛りで……もぅ、困っちゃいますよね」"}],"source":"bangumi","sourceCharacterId":"38002"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/715478b24a3ba0da9ffa93e1e5ce6ec15ad28fc143f719ceb7fdf5270a0d2293.webp","fallbackUrl":"htt