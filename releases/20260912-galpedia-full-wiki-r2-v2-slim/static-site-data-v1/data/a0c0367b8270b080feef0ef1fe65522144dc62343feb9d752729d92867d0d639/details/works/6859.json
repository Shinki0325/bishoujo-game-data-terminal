{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"6859","model":{"presentationWorkId":"vndb:v1096","staff":{"artwork":[{"creditedName":"浅賀葵","creatorId":"vndb:s4556","sourcePersonId":"egs:creator:884","canonicalEntityId":"vndb:s4556","name":"浅賀葵","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:14398","source":"egs"},{"creditedName":"桐沢しんじ","creatorId":"vndb:s8590","sourcePersonId":"egs:creator:42","canonicalEntityId":"vndb:s8590","name":"桐沢しんじ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:20758","source":"egs"},{"creditedName":"米倉きひろ","creatorId":"vndb:s9914","sourcePersonId":"egs:creator:4889","canonicalEntityId":"vndb:s9914","name":"米倉きひろ","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:20759","source":"egs"}],"scenario":[{"creditedName":"assault(あさのじ)","creatorId":"vndb:s1510","sourcePersonId":"egs:creator:1929","canonicalEntityId":"vndb:s1510","name":"assault(あさのじ)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:14399","source":"egs"},{"creditedName":"有島悠也","creatorId":"vndb:s5564","sourcePersonId":"egs:creator:437","canonicalEntityId":"vndb:s5564","name":"有島悠也","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:14401","source":"egs"},{"creditedName":"紅羽一葉","creatorId":"vndb:s7502","sourcePersonId":"egs:creator:4714","canonicalEntityId":"vndb:s7502","name":"紅羽一葉","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:17672","source":"egs"}],"music":[{"creditedName":"春日森(家宇治森)","creatorId":"vndb:s594","sourcePersonId":"egs:creator:2484","canonicalEntityId":"vndb:s594","name":"春日森(家宇治森)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:19085","source":"egs"}],"other":[{"creditedName":"パリオ","creatorId":"vndb:s2790","sourcePersonId":"egs:creator:12719","canonicalEntityId":"vndb:s2790","name":"パリオ","detail":"ムービー全般","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:67435","source":"egs"}]},"cast":[{"characterId":"char_c35143","characterName":"綾文 すずり","sourceIds":{"bangumi":[{"characterId":"147283","match":"exact-normalized-name-in-linked-work","subjectId":"295890"}],"egsCharacterIds":["19073"],"vndbCharacterId":"c35143"},"originalCharacterName":"綾文 すずり","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"過去に鬼に家族を殺され、鬼に恨みを持つ少女。"},{"spoiler":false,"text":"年齢は穂乃香と同年代であるが、鬼に魂を傷つけられたことから、成長が止まってしまっている。"},{"spoiler":false,"text":"鬼への復讐心が強いためか、勝気で近寄り難い雰囲気を醸し出している。"}],"source":"egs","sourceCharacterId":"19073","sourceWorkId":"6859","spoiler":false},{"segments":[{"spoiler":false,"text":"白兎隊に所属している友人の土岐穂乃香と一緒に行動する事が多い。"},{"spoiler":false,"text":"すずり本人には白兎隊に所属している事を否定しているが、誰もが白兎隊に所属しているような物だと思っている。"},{"spoiler":false,"text":"武器は『潰屠・・かいと』と呼ばれる拳銃を模した武器。"},{"spoiler":false,"text":"威力もそれなりに高く、飛び道具であるために多様な状況に対応出来るが、接近戦などは苦手としている。"}],"source":"egs","sourceCharacterId":"19073","sourceWorkId":"10107","spoiler":false},{"segments":[{"spoiler":false,"text":"姉が姫巫女だったが、それが原因ですずり以外の家族は殺され、姉は鬼達に犯されてしまう事に。そういった過去の事もあり、本人は姫巫女に対して良い感情を持っていない。"},{"spoiler":false,"text":"感情的で毒舌家で、天才肌な一面を持っており、穂乃香に対しては敵対的な行動を取る事もある。"},{"spoiler":false,"text":"※滅鬼…姫巫女と同じように力を持っていながらも、姫巫女に属せずに独自の行動によって鬼を滅ぼす人間"}],"source":"bangumi","sourceCharacterId":"147283"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad62091d257df4bc98836de97ec70087081e1e177065be2232942f0a0477d91b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c5/c5c280fba17fec4fa45f7f769f4400ec56c52f3331f8fdabe3d39a6b9cc8bc90.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:206039:147283:6106:1","source":"bangumi"}]},{"characterId":"char_c35144","characterName":"土岐 穂乃香","sourceIds":{"bangumi":[{"characterId":"50094","match":"exact-normalized-name-in-linked-work","subjectId":"295890"}],"egsCharacterIds":["19074"],"vndbCharacterId":"c35144"},"originalCharacterName":"土岐 穂乃香","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「姫巫女」として「鬼」と戦うことを決意した少女。"},{"spoiler":false,"text":"穏やかで凛とした印象を与える彼女。"},{"spoiler":false,"text":"自己犠牲的な性格で、しっかりとした意思を持っている。"},{"spoiler":false,"text":"学校では頼りにされる存在で、模範的な学生でもある。"}],"source":"egs","sourceCharacterId":"19074","sourceWorkId":"6859","spoiler":false},{"segments":[{"spoiler":false,"text":"黒紙ロングのポニーテイール。"},{"spoiler":false,"text":"正義感も強く目の前で困っている人がいたら、考えるよりも先に身体を動かしてしまう所もある。"},{"spoiler":false,"text":"何事にも真剣に前向きに取り組む所があり、自身の中に鬼と戦う巫女の力が宿っている事を知った時、迷わず戦うことを選んだ。"},{"spoiler":false,"text":"白兎隊に所属している、まだ発展途上の新人巫女。"}],"source":"egs","sourceCharacterId":"19074","sourceWorkId":"10107","spoiler":false},{"segments":[{"spoiler":false,"text":"将来は医者になろうと日々勉強をしている明るく活発な少女。時々頑固な一面も見せる。"},{"spoiler":false,"text":"幼い頃に医者に命を助けられたという事があり、自分も将来は命を助ける仕事をしたいと思っている。"},{"spoiler":false,"text":"姫巫女としての朱鷺家は途絶えてしまったのだが、数代後に女子として生を受けた穂乃香に、隔世遺伝で巫女としての素質が備わっていた。"}],"source":"bangumi","sourceCharacterId":"50094"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/89/8965d917eb012a351d9b1d084e21fc079d36c4645bf1690e666896f27ca95640.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/34/348f3733a2505146706dda7a467c9d3a81cb9e6862b98f978a3a281d6692b1e4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"幡宮かのこ","creatorId":"vndb:s260","sourcePersonId":"vndb:s260","canonicalEntityId":"vndb:s260","name":"幡宮 かのこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:206039:50094:5940:1","source":"bangumi"}]},{"characterId":"char_c35145","characterName":"雀宮 小鳥","sourceIds":{"bangumi":[{"characterId":"147284","match":"exact-normalized-name-in-linked-work","subjectId":"295890"}],"egsCharacterIds":["19075"],"vndbCharacterId":"c35145"},"originalCharacterName":"雀宮 小鳥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"関東南部を中心に活動する「白兎隊」の隊長を務めている「姫巫女」。"},{"spoiler":false,"text":"性格はおおらかでマイペース、細かい仕事は副隊長の真魚に任せっきりだが、戦闘力は群を抜いて高い。"}],"source":"egs","sourceCharacterId":"19075","sourceWorkId":"6859","spoiler":false},{"segments":[{"spoiler":false,"text":"やや長身でスタイルのバランスが良い、姉御肌の女性。"},{"spoiler":false,"text":"白兎隊の隊長ではあるが、性格はややちゃらんぽらんでずぼら。"},{"spoiler":false,"text":"しかしその反面、鬼を前にした時の戦闘力は隊の中でも群を抜いている。"},{"spoiler":false,"text":"かなりのビール好きで、血液みたいな物だと。"},{"spoiler":false,"text":"また、すずりの姉である茉莉とは親友であった。"},{"spoiler":false,"text":"だがそいのあたりについて、小鳥はまだすずりとは言葉をあまり交わしていない。"}],"source":"egs","sourceCharacterId":"19075","sourceWorkId":"10107","spoiler":false},{"segments":[{"spoiler":false,"text":"白兎隊の隊長で、真魚の良き先輩（？）。"},{"spoiler":false,"text":"お茶目な言動や形式に縛られない行動が多かったりするが、その実力は折り紙付き。軽薄な言動や冗談が好きで、酒を好む為に真面目には見えない所も多いが、姫巫女としての本分はきっちりと果たしている。"},{"spoiler":false,"text":"現在は武器を損傷し、本来持っている力を大きく失っている。"}],"source":"bangumi","sourceCharacterId":"147284"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ec5da446d5c16fb0211325f1f9508d7c6a7f84219282f0535f0e71079ed207e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/72/72bbe6d5dcee73049f0fd108896a72d663b1420c3242c9fd424e74da42d74848.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井浩美","creatorId":"vndb:s449","sourcePersonId":"vndb:s449","canonicalEntityId":"vndb:s449","name":"櫻井 浩美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:206039:147284:4956:1","source":"bangumi"}]},{"characterId":"char_c35146","characterName":"鶴来 真魚","sourceIds":{"bangumi":[{"characterId":"50123","match":"exact-normalized-name-in-linked-work","subjectId":"295890"}],"egsCharacterIds":["19076"],"vndbCharacterId":"c35146"},"originalCharacterName":"鶴来 真魚","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"関東南部を中心に活動する「白兎隊」の副隊長を務めている「姫巫女」。"},{"spoiler":false,"text":"鶴来家の女性は、代々、姫巫女としての役割を担う一族で、彼女は母親からその役目を受け継いだ。"},{"spoiler":false,"text":"鬼と戦う宿命を幼い頃から叩き込まれており、姫巫女であることに誇りを持っている。"},{"spoiler":false,"text":"やや世間知らずな面があり、それを隊長である小鳥からからかわれることもしばしば。"}],"source":"egs","sourceCharacterId":"19076","sourceWorkId":"6859","spoiler":false},{"segments":[{"spoiler":false,"text":"普段はどこか世間知らずで抜けている所のある女性だが、訓練になると人が変わったように部下をしごく鬼教官となる。"},{"spoiler":false,"text":"また、普段はいい加減な小鳥に変わって、副隊長という立場ながら隊としての行動や方針をとりまとめている。"},{"spoiler":false,"text":"また、白兎隊の中で唯一『治療能力』の巫力を使える存在でもある。"}],"source":"egs","sourceCharacterId":"19076","sourceWorkId":"10107","spoiler":false},{"segments":[{"spoiler":false,"text":"姫巫女の中で『白兎隊：はくとたい』を率いる副隊長だった女性。"},{"spoiler":false,"text":"白兎隊は、先日の鬼との激しい交戦で、隊長格以外の人間は任務を果たせない状態に陥っている。"},{"spoiler":false,"text":"普段の言動は厳しく、他人をすぐに叱るが、面倒見は良く優しい一面もある。"}],"source":"bangumi","sourceCharacterId":"50123"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/674c287b301ad2b8c68b25908f80636ed0d06c6b7e67a35f54f7d2b6cc77de62.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/17f9e99476b12f7c5d2ce83539d70375c87476249bbd41f2568058191717365e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"ひと美","creatorId":"vndb:s113","sourcePersonId":"vndb:s113","canonicalEntityId":"vndb:s113","name":"ひと美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:206039:50123:4675:1","source":"bangumi"}]},{"characterId":"char_vndb_c49551","characterName":"小原 幸","sourceIds":{"vndbCharacterId":"c49551"},"originalCharacterName":"小原 幸","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce9d8ef490ae8a809d500df780b08c5b3e460919ae6a138b74b748cdce7306a3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91d4a20ee0465474af4467a0fd718173ede67ab8531924d16a0aa4e86de815d7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"草柳 順子","creatorId":"vndb:s631","sourcePersonId":"vndb:s631","canonicalEntityId":"vndb:s631","name":"中田 順子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:9943","source":"vndb"}]},{"characterId":"char_vndb_c49552","characterName":"藤沢 美由","sourceIds":{"vndbCharacterId":"c49552"},"originalChar