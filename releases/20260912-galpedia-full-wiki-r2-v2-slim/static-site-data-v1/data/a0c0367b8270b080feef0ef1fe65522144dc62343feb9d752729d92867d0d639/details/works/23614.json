bjectId":"178911"}],"egsCharacterIds":["8640"],"vndbCharacterId":"c46249"},"originalCharacterName":"甘利 絢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The eldest of the three Amari sisters."},{"spoiler":false,"text":"A popular girl since she was a child and has a lot of friends, but because she always compares men with her older brother, she never had a boyfriend even now that she's a college student."},{"spoiler":false,"text":"She is a bit selfish and sometimes self-centered, but actually it's all out of affection for her brother, which she doesn't realize her feelings yet. She's quite petite and emotional, which makes her seem a little childish for her age."},{"spoiler":false,"text":"She's the first of the sisters to realize her romantic feelings for her brother. Once she realizes that, she seduced him without hesitation due to her straightforward personality."},{"spoiler":false,"text":"\"What? It's your fault, isn't it?\""},{"spoiler":false,"text":"Edited from DLsite"}],"source":"vndb","sourceCharacterId":"c46249"},{"segments":[{"spoiler":false,"text":"甘利家三姉妹の長女。"},{"spoiler":false,"text":"小さい頃からモテモテで交友関係も広いのだが、兄を通して男を見るた"},{"spoiler":false,"text":"め、大学生になっても彼氏ができずに焦っている。"},{"spoiler":false,"text":"そんな自分の気持ちには気づいていない為、"},{"spoiler":false,"text":"兄には少し当たりが強く、わがままを言って振り回すこともあるが、"},{"spoiler":false,"text":"何だかんだで愛情の裏返し。"},{"spoiler":false,"text":"小柄で感情豊かなため、年齢のわりに少々子供っぽい印象を受けるが、"},{"spoiler":false,"text":"兄に対する恋愛感情に気付くのが姉妹の中で一番早い。"},{"spoiler":false,"text":"一度兄が好きだと分かってからは持ち前の性格から、躊躇なくアタックを"},{"spoiler":false,"text":"繰り返す。"},{"spoiler":false,"text":"「はあ？ そんなのアニキが悪いんでしょ？」"}],"source":"egs","sourceCharacterId":"8640"},{"segments":[{"spoiler":false,"text":"甘利家三姉妹の長女。"},{"spoiler":false,"text":"小さい頃からモテモテで交友関係も広いのだが兄を通して男を見るため、大学生になっても彼氏ができずに焦っている。"},{"spoiler":false,"text":"そんな自分の気持ちには気づいていない為、兄には少し当たりが強く、わがままを言って振り回すこともあるが何だかんだで愛情の裏返し。"},{"spoiler":false,"text":"小柄で表情豊かなため年齢のわりに少々子供っぽい印象を受けるが兄に対する恋愛感情に気付くのが姉妹の中で一番早い。"},{"spoiler":false,"text":"一度兄が好きだとわかってからは持ち前の性格から躊躇なくアタックを繰り返す。"}],"source":"egs","sourceCharacterId":"8640","sourceWorkId":"23614","spoiler":false},{"segments":[{"spoiler":false,"text":"甘利家三姉妹の長女。"},{"spoiler":false,"text":"小さい頃からモテモテで交友関係も広いが、兄を通して男を見るため未だに交際は0。"},{"spoiler":false,"text":"さすがに大学生になって焦りを感じていて、そのためか兄への当たりが強くなったり"},{"spoiler":false,"text":"ワガママを言って振り回したりすることが多くなった。"},{"spoiler":false,"text":"しかしそれも、やはりなんだかんだで愛情の裏返し。"},{"spoiler":false,"text":"小柄で感情表現豊かなため、年齢のわりに子供っぽい印象を受ける。"},{"spoiler":false,"text":"それでも兄に対する恋愛感情に気づくのは姉妹の中で一番早い。"},{"spoiler":false,"text":"一度兄が好きだと分かってからは持ち前の性格から、躊躇なくアタックを繰り返す。"},{"spoiler":false,"text":"「はあ？ そんなのアニキが悪いんでしょ？」"}],"source":"bangumi","sourceCharacterId":"95950"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"8640","sourceWorkId":"23614","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"8640","sourceWorkId":"23614","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"8640","sourceWorkId":"23614","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"8640","sourceWorkId":"23614","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5ae06a19db68ebda2ccea4f4923f161053c330405b0fa02dea644149377e0c5f.webp","fallbackUrl":"https://wiki