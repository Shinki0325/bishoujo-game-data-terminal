reditedName":"夏希 美羽","creatorId":"vndb:s1693","sourcePersonId":"vndb:s1693","canonicalEntityId":"vndb:s1693","name":"夏希 美羽","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:65557","source":"vndb"},{"creditedName":"Massan","creatorId":"vndb:s4134","sourcePersonId":"vndb:s4134","canonicalEntityId":"vndb:s4134","name":"Massan","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:65561","source":"vndb"},{"creditedName":"かつらぎ","creatorId":"vndb:s4147","sourcePersonId":"vndb:s4147","canonicalEntityId":"vndb:s4147","name":"かつらぎ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:65562","source":"vndb"},{"creditedName":"船亀 由真人","creatorId":"vndb:s4241","sourcePersonId":"vndb:s4241","canonicalEntityId":"vndb:s4241","name":"船亀 由真人","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:65565","source":"vndb"}]},"cast":[{"characterId":"char_c27464","characterName":"日比野 薫子","sourceIds":{"bangumi":[{"characterId":"12622","match":"exact-normalized-name-in-linked-work","subjectId":"15346"}],"egsCharacterIds":["8833"],"vndbCharacterId":"c27464"},"originalCharacterName":"日比野 薫子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"egs","value":"8/18"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"156"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公より一つ年上の姉。"},{"spoiler":false,"text":"明るい性格で天然系。垂れた目元と意外にも隠れ巨乳なボディが特徴。"},{"spoiler":false,"text":"工学畑出身の両親の影響が強かったのか、ロボット工学に秀でていており、"},{"spoiler":false,"text":"現在は科学部にて空を飛ぶロボット開発に勤しんでいる天才肌。"}],"source":"egs","sourceCharacterId":"8833","sourceWorkId":"15168","spoiler":false},{"segments":[{"spoiler":false,"text":"比主人公大一岁的姐姐。"},{"spoiler":false,"text":"有着清秀的眉目和引人遐想的巨乳，开朗乐观的天然系少女。"},{"spoiler":false,"text":"不知是不是受到置身于工程学研究的双亲影响，她在机器人制作方面相当有才能，现在正全力开发能够飞翔的机器人。"},{"spoiler":false,"text":"然而，由于过于强烈地渴望达到目标，结果反倒经常华丽丽地将事情搞砸，不知不觉就成为坊间流传的『献身科学的圣少女（サイエンティスト・オブ・ジャンヌダルク）』。"},{"spoiler":false,"text":"立志成为科学家，但本来就是花季少女，加之毫无以理服人的耐心，经常都是任着感情横冲直撞。"},{"spoiler":false,"text":"正因如此，对于久别重逢的主人公，她自是以不减当年的激情努力进行肌肤交流。"},{"spoiler":false,"text":"「哎呀，我们是姐弟，不用那么害羞嘛♪」"}],"source":"bangumi","sourceCharacterId":"12622"}],"profileFacts":[{"label":"胸围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"8833","sourceWorkId":"15168","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"8833","sourceWorkId":"15168","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"8833","sourceWorkId":"15168","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"8833","sourceWorkId":"15168","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0de12fd7505e44e9b3ecf1fc1aaa8ad02711b61aeccfeb6aa17042c131592859.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5c690766ddef73d9ae271701b5d905644280f66fc95fad4fe4ed7df42fb738a7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:15346:12622:5936:1","source":"bangumi"}]},{"characte