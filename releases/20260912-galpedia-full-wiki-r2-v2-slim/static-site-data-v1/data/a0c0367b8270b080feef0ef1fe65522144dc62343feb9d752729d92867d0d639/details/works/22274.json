height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The transfer student. From her outside looks, she captures everyone's hearts with her friendly personality. She happens to stumble upon the Shinji's secret by accident, then ends up threatening to reveal his secret unless..."}],"source":"vndb","sourceCharacterId":"c37157"},{"segments":[{"spoiler":false,"text":"学園に転校してきた女の子。清楚で優しそうな感じの見た目から、主人公が一目惚れしてしまう。実際、明るく真面目な性格で成績優秀、瞬く間にクラスメイトや教師たちの信任を得た。そんな彼女を見て主人公は自分の体質を治し、告白することを決意。だが、とあることが原因でたまたま主人公は彼女の本性を垣間見てしまい、それを知った彼女から半ば脅迫され秘密を共有することに。"}],"source":"egs","sourceCharacterId":"7157","sourceWorkId":"22274","spoiler":false},{"segments":[{"spoiler":false,"text":"学園に転校してきた女の子。"},{"spoiler":false,"text":"清楚で優しそうな感じの見た目から、主人公が一目惚れしてしまう。"},{"spoiler":false,"text":"実際、明るくまじめな性格で成績優秀、瞬く間にクラスメイトや教師の信任を得た。"},{"spoiler":false,"text":"しかし、ひょんなことから主人公に本性を知られてしまう。"},{"spoiler":false,"text":"それからは主人公を半ば脅迫し、秘密を共有することになる。"}],"source":"bangumi","sourceCharacterId":"36209"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"7157","sourceWorkId":"22274","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"7157","sourceWorkId":"22274","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"7157","sourceWorkId":"22274","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"7157","sourceWorkId":"22274","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5ffcb