[{"spoiler":false,"text":"明るい家族のおかげか、人見知りをせず積極的に挨拶をしにくるような礼儀正しい女の子。"},{"spoiler":false,"text":"お母さんっ子で、料理など家事が得意。"},{"spoiler":false,"text":"父親はサラリーマンで土日も会社に行くことがあるが、そんな父親を責めることはせず、一生懸命働いてくれているお父さんにお返しがしたいと思える心優しい子。"},{"spoiler":false,"text":"スラリと長い黒髪が特徴的で、やさしそうな少したれ目がちの顔立ち。"},{"spoiler":false,"text":"おっとりではなくしっかり者。"},{"spoiler":false,"text":"涙もろいが我慢強く、一人でお留守番や買い物もへっちゃら。"}],"source":"bangumi","sourceCharacterId":"78870"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"78870","value":"かわいいもの、動物"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"78870","value":"虫"},{"label":"身高（本版本）","value":"137 cm","valueContext":null,"source":"egs","sourceCharacterId":"3857","sourceWorkId":"20480","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae8d6ad153199c05e15dd99ef9e61ba910be39d8da7485e77375ef3cb3c271c2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ab/ab60b4ae6e8b46515651e673e69fad0615d51d5a3ca44e1f0e6465726acbde2d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西野ゆみこ","creatorId":"vndb:s934","sourcePersonId":"vndb:s934","canonicalEntityId":"vndb:s934","name":"西野 ゆみこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:106518:78870:14142:1","source":"bangumi"}]},{"characterId":"char_c22817","characterName":"西村 ゆず","sourceIds":{"bangumi":[{"characterId":"78871","match":"exact-normalized-name-in-linked-work","subjectId":"106518"}],"egsCharacterIds":["3858"],"vndbCharacterId":"c22817"},"originalCharacterName":"西村 ゆず","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"128"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"n