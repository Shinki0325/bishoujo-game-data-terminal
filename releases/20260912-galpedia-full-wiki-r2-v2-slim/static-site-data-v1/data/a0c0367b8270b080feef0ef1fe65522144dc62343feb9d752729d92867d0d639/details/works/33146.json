ource":"static-detail"},"actors":[{"creditedName":"植田 佳奈","creatorId":"vndb:s17","sourcePersonId":"vndb:s17","canonicalEntityId":"vndb:s17","name":"植田 佳奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41129","source":"vndb"}]},{"characterId":"char_vndb_c1458","characterName":"近藤 勇","sourceIds":{"vndbCharacterId":"c1458"},"originalCharacterName":"近藤 勇","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A very direct person, Kondou is also known as a womanizer and some see him as frivolous, even insincere. However, beyond that light-hearted persona is a very deep sense of justice and duty and devotion to \"Makoto\", the code of the Shinsengumi and the way of the samurai."},{"spoiler":false,"text":"From BRS no Koibito"}],"source":"vndb","sourceCharacterId":"c1458"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/795b82b9c6dd52d24478cc8478c8cff9f2c4e61823966f4583ffea0516edd07a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fbbfddef81fc5c38eb35dd85ee324fafdc30841070828bc2bfc5a07264ffccd8.webp","width":134,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森田 成一","creatorId":"vndb:s176","sourcePersonId":"vndb:s176","canonicalEntityId":"vndb:s176","name":"森田 成一","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41137","source":"vndb"}]},{"characterId":"char_vndb_c1459","characterName":"土方 歳三","sourceIds":{"vndbCharacterId":"c1459"},"originalCharacterName":"土方 歳三","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A calm and calculating man, but he is devoted to Kondou and works hard for him. Serious and somewhat formal, speaking without caution around him will arise his suspicions. However, in those he trusts he trusts completely."},{"spoiler":false,"text":"From BRS no Koibito"}],"source":"vndb","sourceCharacterId":"c1459"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/33/3364638464541da71812293cf4e80bacfcbeaada29035094fd4ca2f60affa558.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/1037ee1e91fc3d2d345b594da810415f0c2604df85ee3a59f08d62027c8b38da.webp","width":151,"height":256,"source":"static-detail"},"actors":[{"creditedName":"置鮎 龍太郎","creatorId":"vndb:s747","sourcePersonId":"vndb:s747","canonicalEntityId":"vndb:s747","name":"置鮎 龍太郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:41145","source":"vndb"}]},{"characterId":"char_vndb_c1460","characterName":"沖田 総司","sourceIds":{"vndbCharacterId":"c1460"},"originalCharacterName":"沖田 総司","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A kind young man who always seems to be smiling, but there is more than that to him. The one who fights with great skill with his sword is the same one that plays with neighborhood children. Totally devoted to the Shinsengumi."},{"spoiler":false,"text":"From BRS no Koibito"}],"source":"vndb","sourceCharacterId":"c1460"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4b/4bf31ea8cdf0f1d4a5bcb80361fdfe1af2dad90981540a8a0ec9abc2b4e5becf.webp",