ue":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"自分の兄を下僕のように扱っている上の妹。"},{"spoiler":false,"text":"極度のSで兄に対してだけ態度が悪く、言動がきつい。"},{"spoiler":false,"text":"周りから兄と兄弟だと思われたくないと一緒に外を歩くことを嫌がっている。"},{"spoiler":false,"text":"学園ではお姫様のようなキャラで憧れの目で見られているが、家ではただのわがままなお姫様になる。"},{"spoiler":false,"text":"兄をアゴでこき使っていつも困らせていて、兄いじめを趣味にしている。"},{"spoiler":false,"text":"下の妹「莉絵」にはいつも論破され、口げんかでは勝てない。"},{"spoiler":false,"text":"頭脳派の莉絵に負けずとスポーツは得意で、さまざまな種目ができる。"},{"spoiler":false,"text":"興奮して暴走するとろれつが回らなくなる癖がある。"}],"source":"egs","sourceCharacterId":"862","sourceWorkId":"18116","spoiler":false},{"segments":[{"spoiler":false,"text":"兄を下僕のように扱っている上の妹。"},{"spoiler":false,"text":"兄に対してだけ態度が悪く、言動がきつい。"},{"spoiler":false,"text":"兄イジリが大好きで、いつも庵を困らせている。"}],"source":"bangumi","sourceCharacterId":"53393"}],"profileFacts":[{"label":"胸围（本版本）","value":"82 cm","valueContext":null,"source":"egs","sourceCharacterId":"862","sourceWorkId":"18116","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"148 cm","valueContext":null,"source":"egs","sourceCharacterId":"862","sourceWorkId":"18116","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"862","sourceWorkId":"18116","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"862","sourceWorkId":"18116","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"40 kg","valueContext":null,"source":"egs","sourceCharacterId":"862","sourceWorkId":"18116","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8a/8aff0a26ea33a72d4b55d451d4ee8def1365f99ea880209e753f5047ad474b97.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/52/5257aa19fe5f793b20237d0f8658d94638c96ae8c3531bac30c89a0eb6588ee0.webp","