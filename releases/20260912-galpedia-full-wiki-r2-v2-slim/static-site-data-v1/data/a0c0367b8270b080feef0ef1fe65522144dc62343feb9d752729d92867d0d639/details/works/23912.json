{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"23912","model":{"presentationWorkId":"vndb:v19763","staff":{"artwork":[{"creditedName":"Pikazo","creatorId":"vndb:s1959","sourcePersonId":"egs:creator:13152","canonicalEntityId":"vndb:s1959","name":"Pikazo","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:168277","source":"egs"}],"scenario":[{"creditedName":"マイケル内藤","creatorId":"vndb:s6829","sourcePersonId":"egs:creator:20441","canonicalEntityId":"vndb:s6829","name":"マイケル内藤","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:168278","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c50626","characterName":"芽衣","sourceIds":{"bangumi":[{"characterId":"53101","match":"exact-normalized-name-in-linked-work","subjectId":"212421"}],"egsCharacterIds":["10114"],"vndbCharacterId":"c50626"},"originalCharacterName":"芽衣","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The daughter of the uncle's older brother and his wife. Her grades weren't great before summer break, but after receiving her uncle's guidance, it became clear she's actually capable if she puts her mind to it."},{"spoiler":false,"text":"She has a boyfriend she started dating after he confessed before summer break, but they haven't even kissed yet."},{"spoiler":false,"text":"Her boyfriend is going on a short overseas study trip during summer break, so she decides to visit her uncle's rural home with her parents. Driven by curiosity, she loses her virginity to her uncle."},{"spoiler":false,"text":"She also awakens to the joy of learning, and to devote herself to both sex and her studies, she decides to spend the rest of her summer break alone with her uncle in the countryside."},{"spoiler":false,"text":"From the Official website"}],"source":"vndb","sourceCharacterId":"c50626"},{"segments":[{"spoiler":false,"text":"おじさんの兄夫婦の娘。"},{"spoiler":false,"text":"夏休み前までの成績は良くないが、おじさんの教えを受けて実はやればできる娘であることが判る。"},{"spoiler":false,"text":"夏休み前に告白をされて付き合い始めた彼氏がいるが、まだキスもしていない。"},{"spoiler":false,"text":"彼氏が夏休みを利用した海外短期留学へ行ってしまい、両親と一緒におじさんの住む田舎へとやってきた。"},{"spoiler":false,"text":"おじさんによって学ぶ楽しさに目覚め、彼氏と同じ進路を目指して勉強にセックスにと励む。"}],"source":"egs","sourceCharacterId":"10114","sourceWorkId":"23912","spoiler":false},{"segments":[{"spoiler":false,"text":"おじさんの兄夫婦の娘。"},{"spoiler":false,"text":"夏休み前に告白されて彼氏がいるが、まだキスもしていない。"},{"spoiler":false,"text":"おじさんによって学ぶ楽しさに目覚め、彼氏と同じ進路を目指して勉強にセックスにと励む。"}],"source":"bangumi","sourceCharacterId":"53101"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e40a5caf51f23d81281c778fc242b008e1ba33d03353760838e5cd214203adb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bc/bcfef1a793ada7d978a977ad023458132d0ea3f18fde0adf84aedece36091ea3.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"七瀬あかり","creatorId":"vndb:s8769","sourcePersonId":"vndb:s8769","canonicalEntityId":"vndb:s8769","name":"七瀬 あかり","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:212421:53101:25290:1","source":"bangumi"}]}],"songs":[],"companies":[{"companyId":"vndb:p964","sourceCompanyId":"egs:brand:385","canonicalEntityId":"vndb:p964","name":"フェアリーテール","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:23912:385","source":"egs"},{"companyId":"vndb:p6087","sourceCompanyId":"vndb:p6087","canonicalEntityId":"vndb:p6087","name":"心愿屋汉化组","roleCodes":["publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:123842:v19763",