oiler":false,"text":"転校してから何年も経っているが、未だに関西弁が抜けていない。"},{"spoiler":false,"text":"家事もそれなりにこなすが、やや大雑把で乱暴なところがある。"},{"spoiler":false,"text":"主人公にせよもう一人の幼なじみであるめぐるにせよ、不器用な人間を放っておけない世話焼き体質なのかもしれない。"}],"source":"egs","sourceCharacterId":"13121","sourceWorkId":"14685","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/84/84697fedde60cc555f385fe638e97e70f8697298ac00a9f32e698d39b5854b5b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/23/233ab8fff2e6fa44e0bcafa1c2c595338c66cabcad893b6f09c02649bf505d96.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"カスミ","creatorId":"vndb:s18011","sourcePersonId":"vndb:s18011","canonicalEntityId":"vndb:s18011","name":"カスミ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13454","source":"vndb"}]},{"characterId":"char_vndb_c67718","characterName":"鷹取 晶","sourceIds":{"vndbCharacterId":"c67718"},"originalCharacterName":"鷹取 晶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c1591e063694297d1704046446a7d6424775a4efac572862e08b16c5cadaeff0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8d5088a2d8a5ba4841c56a0164b69a92a1f84b10cb2206ff01ba506ad7b2671.webp","width":171,"height":256,"source":"static-detail"},"actors":[{"creditedName":"AKIRA (seiyuu)","creatorId":"vndb:s4555","sourcePersonId":"vndb:s4555","canonicalEntityId":"vndb:s4555","name":"AKIRA (seiyuu)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13452","sour