{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"23161","model":{"presentationWorkId":"vndb:v18922","staff":{"artwork":[{"creditedName":"鋼丸(鋼丸R、鋼丸S、鋼丸SS)","creatorId":"vndb:s6952","sourcePersonId":"egs:creator:444","canonicalEntityId":"vndb:s6952","name":"鋼丸(鋼丸R、鋼丸S、鋼丸SS)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:161567","source":"egs"}],"scenario":[{"creditedName":"照","creatorId":"vndb:s7034","sourcePersonId":"egs:creator:268","canonicalEntityId":"vndb:s7034","name":"照","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:161568","source":"egs"}],"music":[{"creditedName":"TOSHI","creatorId":"vndb:s8325","sourcePersonId":"egs:creator:25572","canonicalEntityId":"vndb:s8325","name":"TOSHI","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:161569","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c23774","characterName":"秋月 真理奈","sourceIds":{"bangumi":[{"characterId":"31699","match":"exact-normalized-name-in-linked-work","subjectId":"267561"},{"characterId":"31699","match":"exact-normalized-name-in-linked-work","subjectId":"29301"}],"egsCharacterIds":["7844"],"vndbCharacterId":"c23774"},"originalCharacterName":"秋月 真理奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A third-year student at Seifu Academy. The older sister. A virgin."},{"spoiler":false,"text":"She’s a studious, reserved, and serious girl."},{"spoiler":false,"text":"She’s half-French with strong Japanese heritage, but she has quite large breasts."},{"spoiler":false,"text":"She helps her mother with household chores."},{"spoiler":false,"text":"She’s been dating her boyfriend for a year, but it seems they haven’t had sex yet."},{"spoiler":false,"text":"However, they’ve apparently promised to have sex after her midterms, and because of her serious nature, she’s feeling conflicted."},{"spoiler":false,"text":"She wants to support her mother and father."},{"spoiler":false,"text":"Translated and edited from Gyutto"}],"source":"vndb","sourceCharacterId":"c23774"},{"segments":[{"spoiler":false,"text":"聖楓学園三年生。美姉妹の姉。処女。"},{"spoiler":false,"text":"成績優秀、控えめで真面目な女の子。"},{"spoiler":false,"text":"フランス人とのハーフで、日系の血が濃いがおっぱいはかなり大きめ。"},{"spoiler":false,"text":"母親の手伝いで家事もこなす。"},{"spoiler":false,"text":"付き合って一年の彼氏がいるが、まだエッチはしていない様子。"},{"spoiler":false,"text":"しかし、定期テストが終わったらエッチする約束をしたようで、真面目な性格なため、悩んでいる。"},{"spoiler":false,"text":"母親と父親のことを応援したいと考えている。"}],"source":"egs","sourceCharacterId":"7844","sourceWorkId":"11361","spoiler":false},{"segments":[{"spoiler":false,"text":"聖楓学園3年生。"},{"spoiler":false,"text":"成績優秀、スポーツはそこそこ。"},{"spoiler":false,"text":"控えめで、真面目な性格。"},{"spoiler":false,"text":"多忙な母親に代わり、家事もこなす。"},{"spoiler":false,"text":"母親の新しいパートナーである父が出来たのが嬉しく、応援したいと思っている。"}],"source":"egs","sourceCharacterId":"7844","sourceWorkId":"23161","spoiler":false},{"segments":[{"spoiler":false,"text":"圣枫学园3年生。日法混血儿，秋月爱莉的姐姐。成绩优秀，体育方面却不怎样。"},{"spoiler":false,"text":"由于母亲工作忙，为了分担母亲的压力而在家中包揽了家务活，有着保守、认真性格。为母亲找到新的伴侣（后父•秋月孝三）而高兴，与妹妹的不承认相反，真理奈非常支持后父加入自己的家庭并对后父有着相当的信任。"}],"source":"bangumi","sourceCharacterId":"31699"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e902292e8c18db3dbd4fd87a8808dec188f582761fde7167b3612221f7d05d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9f/9fae2ad21c7b53414f92147528df6334857c74da79b3eb957152118bbe0d761c.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c87197","characterName":"秋月 孝三","sourceIds":{"vndbCharacterId":"c87197"},"originalCharacterName":"秋月 孝三","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist. A researcher who managed to create an aphrodisiac while experimenting on hormone secretion. He often gets called to teach at the school his step daughters attend."},{"spoiler":false,"text":"After an accident where he was exposed to certain chemicals he became sexually impotent for a while, but regains it after seeing Airi and Marina. Soon after this he realized that he only gets aroused by younger girls, and he decides to marry Airi and Marina's mother in order to get closer to them."}],"source":"vndb","sourceCharacterId":"c87197"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/792ade648d6da17b139f6e9f8b0e2f12d38075d68d2aeda0a6001a615facbf6a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/763944ceeb0f1e5faf9b6621565020b5969f168936740e22c407b31204a9a47e.webp","width":256,"height":175,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:271","sourceCompanyId":"egs:brand:271","canonicalEntityId":"egs:brand:271","name":"BLUE GALE","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:23161:271","source":"egs"},{"companyId":"vndb:p182","sourceCompanyId":"vndb:p182","canonicalEntityId":"vndb:p182","name":"Blue Gale","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:51469:v18922","source":"vndb"},{"companyId":"vndb:p182","sourceCompanyId":"vndb:p182","canonicalEntityId":"vndb:p182","name":"Blue Gale","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:52021:v18922","source":"v