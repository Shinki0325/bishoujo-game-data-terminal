":"オカザワ","creatorId":"vndb:s12547","sourcePersonId":"vndb:s12547","canonicalEntityId":"vndb:s12547","name":"オカザワ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:117000","source":"vndb"},{"creditedName":"＠y＠","creatorId":"vndb:s13838","sourcePersonId":"vndb:s13838","canonicalEntityId":"vndb:s13838","name":"＠y＠","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:117001","source":"vndb"},{"creditedName":"アッキー","creatorId":"vndb:s14179","sourcePersonId":"vndb:s14179","canonicalEntityId":"vndb:s14179","name":"アッキー","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:117002","source":"vndb"}]},"cast":[{"characterId":"char_c31027","characterName":"月村 楓","sourceIds":{"bangumi":[{"characterId":"46744","match":"exact-normalized-name-in-linked-work","subjectId":"132744"}],"egsCharacterIds":["6147"],"vndbCharacterId":"c31027"},"originalCharacterName":"月村 楓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"洋光学園の２年５組所属。"},{"spoiler":false,"text":"英一と同じく図書委員会に所属する、本が好きで物静かな女の子。"},{"spoiler":false,"text":"地味なだけでなく、いわゆる極度のコミュ障なため、友達もおらず常に独りでいる。"},{"spoiler":false,"text":"だが最近は、望田英一という彼氏ができたため、少しずつ社交的になってきた。"},{"spoiler":false,"text":"本に詳しく、口べたな自分にもとても優しい真弓のことが大好きで、尊敬している。"},{"spoiler":false,"text":"それ以上に、自分と根気よくコミュニケーションを取ってくれた英一にベタ惚れしている。"}],"source":"egs","sourceCharacterId":"6147","sourceWorkId":"21535","spoiler":false},{"segments":[{"spoiler":false,"text":"洋光学園の 2年5組所属。"},{"spoiler":false,"text":"英一と同じく図書委員会に所属する、本が好きで物静かな女の子。"},{"spoiler":false,"text":"地味なだけでなくいわゆる極度のコミュ障なため、友達もおらず常に独りでいる。"},{"spoiler":false,"text":"だが最近は英一という彼氏ができたため、少しずつ社交的になってきた。"},{"spoiler":false,"text":"本に詳しく口べたな自分にもとても優しい真弓のことが大好きで、尊敬している。"},{"spoiler":false,"text":"それ以上に、自分と根気よくコミュニケーションを取ってくれた英一にベタ惚れしている。"},{"spoiler":false,"text":"「わたしみたいな、ど、どもっちゃって、お話もろくにできない、お、女に、い、い、言われても、め、迷惑、だと、お、おも……思う、んだけど……」"}],"source":"bangumi","sourceCharacterId":"46744"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/06ecc5d03d679692298879e37a771b5592b847b0b89d193eac12e1808eb31635.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/42/420b43c1a84d3e6e4ae1dfa2bd4205fc8ae8f065cab0c446dfd439e65c8328f4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:132744:46744:10026:1","source":"bangumi"}]},{"characterId":"char_c31028","characterName":"南条 真弓","sourceIds":{"bangumi":[{"characterId":"46745","match":"exact-normalized-name-in-linked-work","subjectId":"132744"}],"egsCharacterIds":["6148"],"vndbCharacterId":"c31028"},"originalCharacterName":"南条 真弓","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"元々は望田家のすぐ近くに住んでいた英一の幼なじみであり、現在は洋光学園の国語科教師。"},{"spoiler":false,"text":"しかし望田家は数年前に引っ越しており、両家の関係も途絶えていたが、偶然教師として赴任した学園へ英一が入学してきた。"},{"spoiler":false,"text":"若いながら勉強の教え方が上手く、性格もサッパリしている上に優しいため、教師・学生問わずに人気。"},{"spoiler":false,"text":"独り暮らしをしている英一の保護者代わりをしていたり、他人とのコミュニケーションに難のある楓を気にかけている面倒見の良い女性。"},{"spoiler":false,"text":"幼なじみである英一と２人きりだと気が抜けて、フランクな喋り方になる。"}],"source":"egs","sourceCharacterId":"6148","sourceWorkId":"21535","spoiler":false},{"segments":[{"spoiler":false,"text":"望田家のすぐ近くに住んでいた英一の幼なじみであり、洋光学園の国語科教師。"},{"spoiler":false,"text":"勉強の教え方が上手く、性格もサッパリしていて優しいため、教師・学生問わずに人気。"},{"spoiler":false,"text":"また面倒見が良く、他人とのコミュニケーションに難のある楓を気に掛けている。"},{"spoiler":false,"text":"望田家が引っ越してからは関係も途絶えていたが、洋光学園に英一が入学したことで再会。"},{"spoiler":false,"text":"現在は一人暮らしをする英一の保護者代わりをしており、二人きりだと気が抜けてフランクな喋り方になることも。"},{"spoiler":false,"text":"「うんっ、ごちそうさまでした！　今日も美味しかったよ。 後片付けは私がやっておくね？」"}],"source":"bangumi","sourceCharacterId":"46745"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e5f631b213e06a2d3c0a3b3cfb8a880035557f95ea97a2d796dee9b61aff7c59.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fcbf6e5c04f6af3e07fafa24e769602dffda2f3afe668599282ceffdb0ec39c1.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"計名 さや香","creatorId":"vndb:s859","sourcePersonId":"vndb:s859","canonicalEntityId":"vndb:s859","name":"かずなさやか(計名さや香)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:62776","source":"vndb"}]},{"characterId":"char_c65981","characterName":"望田 英一","sourceIds":{"bangumi":[],"egsCharacterIds":["6149"],"vndbCharacterId":"c65981"},"originalCharacterName":"望田 英一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"洋光学園の２年６組所属。"},{"spoiler":false,"text":"これと言って強い個性の無い、よく言えばまともな、悪く言えば面白みの無い平凡な男子学生。"},{"spoiler":false,"text":"父親が単身赴任で遠くへ行くと共に、母親もついて行ってしまったため、実家なのに独り暮らしという状況を強いられている……が、本人はその状況を楽しんでいる。"},{"spoiler":false,"text":"月村楓の彼氏であり、南条真弓の幼なじみでもある。"},{"spoiler":false,"text":"楓に対しては友達という感覚でいたため、恋心は余り抱いていないが、告白された喜びと女性への興味から付き合い始める。"},{"spoiler":false,"text":"しかし、一途な好意を向けてくれる楓に、段々と心が惹かれていっている。"}],"source":"egs","sourceCharacterId":"6149","sourceWorkId":"21535","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date