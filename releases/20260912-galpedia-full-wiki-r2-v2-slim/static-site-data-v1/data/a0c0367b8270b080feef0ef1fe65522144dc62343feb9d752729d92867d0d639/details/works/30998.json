{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"30998","model":{"presentationWorkId":"egs:30998","staff":{"artwork":[{"creditedName":"ZUN","creatorId":"egs:creator:2843","sourcePersonId":"egs:creator:2843","canonicalEntityId":"egs:creator:2843","name":"ZUN","roleCode":"artwork","roleLabel":"原画","identityStatus":"alias-only-review","relationId":"egs:work-creator:236896","source":"egs"}],"scenario":[{"creditedName":"ZUN","creatorId":"egs:creator:2843","sourcePersonId":"egs:creator:2843","canonicalEntityId":"egs:creator:2843","name":"ZUN","roleCode":"scenario","roleLabel":"剧本","identityStatus":"alias-only-review","relationId":"egs:work-creator:236897","source":"egs"}],"music":[{"creditedName":"ZUN","creatorId":"egs:creator:2843","sourcePersonId":"egs:creator:2843","canonicalEntityId":"egs:creator:2843","name":"ZUN","roleCode":"music","roleLabel":"作品音乐","identityStatus":"alias-only-review","relationId":"egs:work-creator:236898","source":"egs"}],"other":[]},"cast":[{"characterId":"char_bangumi_12688","characterName":"十六夜 咲夜","sourceIds":{"bangumi":[{"characterId":"12688","match":"source-roster","subjectId":"104009"},{"characterId":"12688","match":"source-roster","subjectId":"1146"},{"characterId":"12688","match":"source-roster","subjectId":"1148"},{"characterId":"12688","match":"source-roster","subjectId":"1150"},{"characterId":"12688","match":"source-roster","subjectId":"1151"},{"characterId":"12688","match":"source-roster","subjectId":"1153"},{"characterId":"12688","match":"source-roster","subjectId":"2134"},{"characterId":"12688","match":"source-roster","subjectId":"329342"},{"characterId":"12688","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"十六夜 咲夜","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"她是住在红魔馆并在里面工作的女仆。是被称之为恶魔之馆的红魔馆中唯一的人类，是女仆们的仆长。"},{"spoiler":false,"text":"她是个在普通人类不敢接近的地方工作的不可思议的少女。"},{"spoiler":false,"text":"没人见过她在进入红魔馆之前是怎样的。而且她对幻想乡里人类的来访极为冷淡，常站在妖怪的阵营之中。所以人们觉得她不是幻想乡的人类，有可能是外面世界或者是别的世界来的人。"},{"spoiler":false,"text":"她没有和村落里任何人类亲近，身上含有许多谜。"},{"spoiler":false,"text":"不过，当她去村落买东西时，她会一脸愉快，一点也没有敌视人类的样子。"}],"source":"bangumi","sourceCharacterId":"12688"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"12688","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"12688","value":"操纵时间的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ba/badfc65679c51a64f83971b2fbcf3fd13d46dab33013f71db781edf64f76f640.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a45982af2e686a3ac26458362bc4b1715751ec4821b9bd2da5964412df51d2bd.webp","width":186,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_485","characterName":"博麗靈夢","sourceIds":{"bangumi":[{"characterId":"485","match":"source-roster","subjectId":"104009"},{"characterId":"485","match":"source-roster","subjectId":"1146"},{"characterId":"485","match":"source-roster","subjectId":"1148"},{"characterId":"485","match":"source-roster","subjectId":"1150"},{"characterId":"485","match":"source-roster","subjectId":"1151"},{"characterId":"485","match":"source-roster","subjectId":"1153"},{"characterId":"485","match":"source-roster","subjectId":"1155"},{"characterId":"485","match":"source-roster","subjectId":"1157"},{"characterId":"485","match":"source-roster","subjectId":"1160"},{"characterId":"485","match":"source-roster","subjectId":"12696"},{"characterId":"485","match":"source-roster","subjectId":"131875"},{"characterId":"485","match":"source-roster","subjectId":"1395"},{"characterId":"485","match":"source-roster","subjectId":"2134"},{"characterId":"485","match":"source-roster","subjectId":"329342"},{"characterId":"485","match":"source-roster","subjectId":"430567"},{"characterId":"485","match":"source-roster","subjectId":"5752"},{"characterId":"485","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"博麗靈夢","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"幻想乡境内博丽神社的现有巫女。"},{"spoiler":false,"text":"博丽神社是专门守护幻想乡不可缺少的大结界的神社。博丽的巫女代代以解决异变为事业。"},{"spoiler":false,"text":"她是历代巫女中最缺乏危机感的一位，不知是因为修行不足，还是因为已经拥有足够的实力。"},{"spoiler":false,"text":"她天生地幸运和敏锐，也退治了不少妖怪。"}],"source":"bangumi","sourceCharacterId":"485"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"485","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"主要是在空中飞行的程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"作为博丽巫女的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"在空中飞行的程度的能力"},{"label":"能力","source":"bangumi","sourceCharacterId":"485","value":"操纵灵气的程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f3/f33007c417ade7c73b7ee78244285c2ff601da86919605a6f56c0570deb01c0c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc26d83763ce8144e0a342eaeb5a41bf3e1756ec782d0268170ef9bac39c8489.webp","width":237,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_486","characterName":"霧雨魔理沙","sourceIds":{"bangumi":[{"characterId":"486","match":"source-roster","subjectId":"104009"},{"characterId":"486","match":"source-roster","subjectId":"1146"},{"characterId":"486","match":"source-roster","subjectId":"1148"},{"characterId":"486","match":"source-roster","subjectId":"1150"},{"characterId":"486","match":"source-roster","subjectId":"1151"},{"characterId":"486","match":"source-roster","subjectId":"1153"},{"characterId":"486","match":"source-roster","subjectId":"1155"},{"characterId":"486","match":"source-roster","subjectId":"1157"},{"characterId":"486","match":"source-roster","subjectId":"1160"},{"characterId":"486","match":"source-roster","subjectId":"12696"},{"characterId":"486","match":"source-roster","subjectId":"131875"},{"characterId":"486","match":"source-roster","subjectId":"1395"},{"characterId":"486","match":"source-roster","subjectId":"2134"},{"characterId":"486","match":"source-roster","subjectId":"329342"},{"characterId":"486","match":"source-roster","subjectId":"430567"},{"characterId":"486","match":"source-roster","subjectId":"5752"},{"characterId":"486","match":"source-roster","subjectId":"73138"}]},"originalCharacterName":"霧雨魔理沙","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"居住于魔法森林的人类魔法使，常骑着扫把，「霧雨店」的独生女。會使用魔法森林的蘑菇調製火藥，所使用的魔法幾乎只有把東西破壞的效果，而且燃料需要長時間準備，但是其效果非常強力，在Spell Card規則成立下，純粹的破壞力在人類當中屬於最高等級。此外在幻想乡是出了名的小偷，帕邱莉的图书馆、香霖堂，如果不是古明地觉会读心术，甚至连地灵殿都会惨遭毒手。"}],"source":"bangumi","sourceCharacterId":"486"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"486","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"486","value":"使用魔法程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0e/0e00e4df671f5f80d5733c44e4b69596b901aad88177fc335789c2dd5ea6b2d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3bd6c6ab5c1df20f216ccf8f7e1581841d4fed04fe2cad0f92ce726df7fb8d1.webp","width":237,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_889","characterName":"東風谷 早苗","sourceIds":{"bangumi":[{"characterId":"889","match":"source-roster","subjectId":"104009"},{"characterId":"889","match":"source-roster","subjectId":"12696"},{"characterId":"889","match":"source-roster","subjectId":"131875"},{"characterId":"889","match":"source-roster","subjectId":"1395"},{"characterId":"889","match":"source-roster","subjectId":"2134"},{"characterId":"889","match":"source-roster","subjectId":"329342"},{"characterId":"889","match":"source-roster","subjectId":"430567"},{"characterId":"889","match":"source-roster","subjectId":"5752"}]},"originalCharacterName":"東風谷 早苗","characterNameSource":null,"role":"主角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"住在妖怪之山上的守矢神社的巫女。"}],"source":"bangumi","sourceCharacterId":"889"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"889","value":"人类"},{"label":"能力","source":"bangumi","sourceCharacterId":"889","value":"引发奇迹程度的能力"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6b1c4cec24100603ccda5fb96eda4303e1cc0ee88841ee32d35f05a2905a1efd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/46/46d80e50773b6c9b14e3ada0d949ea2c94dd248ab95c87a252bcd67ab59d5f22.webp","width":171,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_95690","characterName":"ひめむし ももよ","sourceIds":{"bangumi":[{"characterId":"95690","match":"source-roster","subjectId":"329342"}]},"originalCharacterName":"ひめむし ももよ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"○EXTRA BOSS"},{"spoiler":false,"text":"漆黑的噬龙者"},{"spoiler":false,"text":"姫虫 百百世"},{"spoiler":false,"text":"Himemushi Momoyo"},{"spoiler":false,"text":"种族：大蜈蚣"},{"spoiler":false,"text":"能力：噬龙程度的能力"},{"spoiler":false,"text":"大蜈蚣"},{"spoiler":false,"text":"拥有丑恶的外表和令人不快的毒液，算是很受人厌恶的妖怪。"},{"spoiler":false,"text":"就连强大的龙也不会靠近他们。在山脚他们被认为是屠龙的最强妖怪，深受畏惧。"},{"spoiler":false,"text":"从扑面而来的负能量中精炼出来的魔力是庞大的，她拥有着强大的魔力。"},{"spoiler":false,"text":"本身也没有人愿意接近她，这也为她的最强传说再添一笔。"},{"spoiler":false,"text":"实际上，没有人知道她到底能不能噬龙。"},{"spoiler":false,"text":"但是，她的确是在虹龙洞中寻求被称为是龙的所有物的“龙珠”。"},{"spoiler":false,"text":"正当她从洞窟中挖出了龙珠，从不厌恶与自己相会的亲友大天狗饭纲丸，"},{"spoiler":false,"text":"向她提出了做生意的事情。"},{"spoiler":false,"text":"百百世接受了开山挖掘虹龙洞的职责。报酬就是龙珠。"},{"spoiler":false,"text":"比起吃掉自己的亲友大天狗（饭纲丸）龙，龙珠已经足够了。"},{"spoiler":false,"text":"就当她每天辛辛苦苦挖龙珠的时候，她闻知终于有盗采者出现了。"},{"spoiler":false,"text":"当然，她高兴万分。"},{"spoiler":false,"text":"“龙珠我已经吃腻了。"},{"spoiler":false,"text":"盗采者可以说是最棒的点心了！”"}],"source":"bangumi","sourceCharacterId":"95690"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"95690","value":"大蜈蚣"},{"label":"能力","source":"bangumi","sourceCharacterId":"95690","value":"噬龙程度的能力（虹龙洞）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32081e9430238ba4843f4744a2cd695fd421a39771959598267909cbf596ae61.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8ff4b124c05f3e06a2ce2b8159d2061259443f67d6c93bc0d6752e0f118d6314.webp","width":168,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_95691","characterName":"くだまき　つかさ","sourceIds":{"bangumi":[{"characterId":"95691","match":"source-roster","subjectId":"329342"},{"characterId":"95691","match":"source-roster","subjectId":"430567"}]},"originalCharacterName":"くだまき　つかさ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"○５面中BOSS"},{"spoiler":false,"text":"耳边低语的邪恶白狐"},{"spoiler":false,"text":"菅牧 典"},{"spoiler":false,"text":"Kudamaki Tsukasa"},{"spoiler":false,"text":"种族：管狐"},{"spoiler":false,"text":"能力：抓住灵魂弱点乘虚而入程度的能力"},{"spoiler":false,"text":"她是饭纲丸龙可靠的助手，能带来超出命令预期的成果……至少是被这样认为的。"},{"spoiler":false,"text":"实际上她则是抓住对手心灵上的弱点乘虚而入，引发混乱的元凶。"},{"spoiler":false,"text":"她不仅要主持大天狗和集市之神之间的交涉，还要向大蜈蚣作出指示，一副很忙的样子。"},{"spoiler":false,"text":"不论大天狗、集市之神还是大蜈蚣，都对她信赖备至，找她询问各种意见。"},{"spoiler":false,"text":"但她的真实身份是管狐。"},{"spoiler":false,"text":"听从她的建议的人都会得到金钱上的恩惠。"},{"spoiler":false,"text":"但也不能忘记，等待着这些人的是毁灭性的结局。"},{"spoiler":false,"text":"不论集市之神还是大蜈蚣，都发展成不得不与灵梦等人战斗的地步，罪魁祸首还是她的教唆。"}],"source":"bangumi","sourceCharacterId":"95691"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"95691","value":"管狐"},{"label":"能力","source":"bangumi","sourceCharacterId":"95691","value":"抓住灵魂弱点乘虚而入程度的能力（虹龙洞）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/19/1965849da6d7d52e83717045fde2f34b0723ed980dc80f58e51acc439c0f0c8c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8c/8cceed932203169c50bf70305e608483a706d42a0521a756799ceb6bbb3e24ec.webp","width":109,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_95692","characterName":"てんきゅう　ちまた","sourceIds":{"bangumi":[{"characterId":"95692","match":"source-roster","subjectId":"329342"}]},"originalCharacterName":"てんきゅう　ちまた","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"○６面BOSS"},{"spoiler":false,"text":"无主物之神"},{"spoiler":false,"text":"天弓 千亦"},{"spoiler":false,"text":"Tenkyu Chimata"},{"spoiler":false,"text":"种族：神明"},{"spoiler":false,"text":"能力：剥夺所有权程度的能力"},{"spoiler":false,"text":"对于人类来说，放弃一样事物是很难的。"},{"spoiler":false,"text":"就算把东西给人，这个东西是谁赠送的这样的信息会一直保留下去。"},{"spoiler":false,"text":"就算把东西扔进垃圾箱里，非法丢弃在山里，是谁扔的这种信息也会留存下来。"},{"spoiler":false,"text":"失去所有权，并不是一项容易的事情。"},{"spoiler":false,"text":"但是，有一个地方可以完完全全地做到这种事。"},{"spoiler":false,"text":"那就是人唯一可以交换事物的场所——集市。"},{"spoiler":false,"text":"通过在集市上售出，人就能够完全地丧失所有权。"},{"spoiler":false,"text":"她是司掌这方面的神明。"},{"spoiler":false,"text":"最近世间多了很多不经过集市的物品交易，导致所有权在世间泛滥，为此她哀叹不已。"},{"spoiler":false,"text":"当饭纲丸向她提出想要召开集市的时候，她心想决不能放过这个机会，"},{"spoiler":false,"text":"于是提出只要能像原本的集市一样，以严格的条件进行交易，就可以帮她的忙。"},{"spoiler":false,"text":"她深知自己是在被饭纲丸利用来做生意。"},{"spoiler":false,"text":"但她觉得，等到生意成功之时，她就会取回自己作为神明的力量，"},{"spoiler":false,"text":"区区大天狗不足为惧。"},{"spoiler":false,"text":"第一次集市，是在彩虹架在月上之时，于山顶召开的。"},{"spoiler":false,"text":"参加者只有千亦、饭纲丸、管狐典、和大蜈蚣百百世四人。"},{"spoiler":false,"text":"在第一次集市上，她们贩卖了封入了自身能力的卡牌。"},{"spoiler":false,"text":"她们在月虹之下，相互交换了卡牌。"},{"spoiler":false,"text":"正如她们所想，被封入卡牌中的复制的能力，"},{"spoiler":false,"text":"完全与原本的能力所有者分离，成为了新的所有者的能力的一部分。"},{"spoiler":false,"text":"对于这个结果，饭纲丸和百百世都兴奋不已。"},{"spoiler":false,"text":"在那之后，集市一次又一次召开，卡牌以山为中心广为流通。"},{"spoiler":false,"text":"为了使用卡牌的能力，就要遵从规则来购买。"},{"spoiler":false,"text":"不能靠抢、靠丢、靠捡、靠送。"},{"spoiler":false,"text":"这也是为了让集市之神千亦获得力量的规则。"},{"spoiler":false,"text":"在饭纲丸眼里集市是一门生意，但对于千亦来说集市是为了取回神的力量的祭礼。"},{"spoiler":false,"text":"当两人的冲突开始浮现于表面的时候，终结一切的破坏者到来了。"},{"spoiler":false,"text":"这些破坏者试图以暴力解决一切事物，也就是所谓的市场破坏者——“贼”。"},{"spoiler":false,"text":"巧合的是，人类的“贼”来临的时候，正好和第一次集市一样，是彩虹架在月上的夜晚。"}],"source":"bangumi","sourceCharacterId":"95692"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"95692","value":"神明"},{"label":"能力","source":"bangumi","sourceCharacterId":"95692","value":"剥夺所有权程度的能力（虹龙洞）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b8/b88f1b7357fb18b4742035620e561b531b2e5c2aa34be8367bad3c2a5fda976d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3e7f746a6df2d406f079e0e135a3cf619e73c8014c564df6697d8978c299d44.webp","width":200,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_95693","characterName":"いいずなまる めぐむ","sourceIds":{"bangumi":[{"characterId":"95693","match":"source-roster","subjectId":"329342"}]},"originalCharacterName":"いいずなまる めぐむ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"○５面BOSS"},{"spoiler":false,"text":"鸦天狗的首领"},{"spoiler":false,"text":"饭纲丸 龙"},{"spoiler":false,"text":"Iizunamaru Megumu"},{"spoiler":false,"text":"种族：大天狗"},{"spoiler":false,"text":"能力：操纵星空程度的能力"},{"spoiler":false,"text":"住在山顶附近的大天狗之一。"},{"spoiler":false,"text":"天狗的社会是阶级层次分明的社会，大天狗在天狗社会中相当于老大。"},{"spoiler":false,"text":"因为他们也可以向普通的天狗发布命令。大天狗的命令是绝对的。"},{"spoiler":false,"text":"有些时候他们也会向山中的其他妖怪指派命令。但有些妖怪会违抗他们的命令。"},{"spoiler":false,"text":"虽说他们拥有命令人的权力，但他们基本上不会为了一己私利下达命令。"},{"spoiler":false,"text":"大天狗身上承担着发展、维系天狗社会的义务。"},{"spoiler":false,"text":"她将视线放在了沉眠于山中的龙珠上。"},{"spoiler":false,"text":"龙珠就算不加工成勾玉，也有些许能够注入灵魂的效果。"},{"spoiler":false,"text":"如果使用这个效果制作出想让人互相交换的娱乐用品，肯定能大赚一笔。"},{"spoiler":false,"text":"然而，单纯只是制作完销售，盈利也只会是一时的，数额也可想而知。"},{"spoiler":false,"text":"因此她决定建立一个能广泛流通、专门用来交换的通货系统。"},{"spoiler":false,"text":"每当卡牌贩子和人进行交换，通货系统也能得到推广，也就可以相应地从中盈利。"},{"spoiler":false,"text":"她明白这样比制作东西拿去贩卖比起来，能赚更多的钱。"},{"spoiler":false,"text":"但是，为此她所需要的，是人们会用她独自的通货系统进行交换的理由。"},{"spoiler":false,"text":"此时她所关注的，是失去了立足之地而濒临消失的“集市之神”。"},{"spoiler":false,"text":"她设置了一个机关，仅限在集市之神的力量下成交的生意，卡牌的魔力才会得到补充，"},{"spoiler":false,"text":"能力卡的能力才会显现。除此之外的场合下，能力卡牌仅仅是纸片而已。"},{"spoiler":false,"text":"正如大天狗的预期，能力卡牌得以自由地流通，她也获得了十足的利益。"},{"spoiler":false,"text":"然而这时问题发生了。"},{"spoiler":false,"text":"由于卡牌流通的活性化，集市之神取回了原本的力量，"},{"spoiler":false,"text":"发展到了能够威胁天狗社会的地步。"}],"source":"bangumi","sourceCharacterId":"95693"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"95693","value":"大天狗"},{"label":"能力","source":"bangumi","sourceCharacterId":"95693","value":"操纵星空程度的能力（虹龙洞）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/58/581b2b15c3039bfce6f18d6375b40f9b699485d56950fac58a1600cd4a53f7fb.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/0691b8cec78a54308a61edb8ce0961fb9d63a484925d4af50818241f189e6059.webp","width":137,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_95694","characterName":"たまつくり　みすまる","sourceIds":{"bangumi":[{"characterId":"95694","match":"source-roster","subjectId":"329342"}]},"originalCharacterName":"たまつくり　みすまる","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"○４面BOSS"},{"spoiler":false,"text":"真正的勾玉匠人"},{"spoiler":false,"text":"玉造 魅须丸"},{"spoiler":false,"text":"Tamatsukuri Misumaru"},{"spoiler":false,"text":"种族：神明"},{"spoiler":false,"text":"能力：制造勾玉程度的能力"},{"spoiler":false,"text":"从古代的矿物制造勾玉的神明。"},{"spoiler":false,"text":"勾玉是能够将生物的灵魂注入其中的魔法器具。"},{"spoiler":false,"text":"虽然程度微小，但也能复制他人的能力、气质和记忆收纳其中。"},{"spoiler":false,"text":"只要使用勾玉的力量，复制他人的能力和读取对手的情报是很容易的。"},{"spoiler":false,"text":"在虹龙洞中开采的龙珠是非常适合制造勾玉的矿物。"},{"spoiler":false,"text":"听闻大天狗在山中四处打洞开采这个矿物，她连忙来到现场考察。"},{"spoiler":false,"text":"这是因为，龙珠落入恶人手中是很危险的。除此之外，她也比较担心对山的环境破坏。"},{"spoiler":false,"text":"她已经看过无数任由欲望开山，又随着资源耗竭而被抛弃的矿山遗址了。"},{"spoiler":false,"text":"虹龙洞的内部结构十分复杂，很难轻易了解矿洞的全貌。"},{"spoiler":false,"text":"在她的调查过程中，有人类闯了进来。"},{"spoiler":false,"text":"她使用勾玉的力量调查她们的目的，发现似乎是在调查能力卡牌的事情。"},{"spoiler":false,"text":"她说这里面并不是人类能够进入的地方，将那些闯进来的人赶走了。"},{"spoiler":false,"text":"她继续调查虹龙洞。"},{"spoiler":false,"text":"在矿洞深处的，是不停开采这座山的危险妖怪——大蜈蚣……"}],"source":"bangumi","sourceCharacterId":"95694"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"95694","value":"神明"},{"label":"能力","source":"bangumi","sourceCharacterId":"95694","value":"制造勾玉程度的能力（虹龙洞）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d2/d23f62eef795033e6b2fb9c834a7cf3bbcf432bd5066548486f3bc5cfde19cac.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/652a10b22cd82754b3048552cc6587e595609d3877d4b41ee6f8521d0de20761.webp","width":127,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_95695","characterName":"駒草太夫","sourceIds":{"bangumi":[{"characterId":"95695","match":"source-roster","subjectId":"329342"}]},"originalCharacterName":"駒草太夫","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"○３面BOSS"},{"spoiler":false,"text":"栖息于高地的山女郎"},{"spoiler":false,"text":"本名　驹草 山如"},{"spoiler":false,"text":"Komakusa Sannyo"},{"spoiler":false,"text":"通称　驹草太夫"},{"spoiler":false,"text":"种族：山女郎"},{"spoiler":false,"text":"能力：以烟草的烟操纵精神程度的能力"},{"spoiler":false,"text":"喜欢烟草的山中妖怪。栖息于妖怪之山的高地。"},{"spoiler":false,"text":"山里的妖怪们，由于她的风貌，对她以驹草太夫这个爱称称呼，很是亲近。"},{"spoiler":false,"text":"她面向天狗、山童和河童们开办赌场，以赌博的庄家为生计。"},{"spoiler":false,"text":"赌博对于山中的妖怪来说，是最好的娱乐。"},{"spoiler":false,"text":"100%天然妖怪之山生产的烟草，以将烟吸入后会产生种种效果知名。"},{"spoiler":false,"text":"有时可以让内心平静，有时也反而会让人心潮澎湃。"},{"spoiler":false,"text":"她巧妙地运用这个烟雾，避免赌场中常见的狂暴事件发生。"},{"spoiler":false,"text":"她开办的赌场，是绅士们的社交场所。由于充斥在赌场内的烟草烟雾……。"},{"spoiler":false,"text":"突然涌现的能力卡牌，对于山中妖怪来说是用来赌博的最好的彩头。"},{"spoiler":false,"text":"她如此作想。"}],"source":"bangumi","sourceCharacterId":"95695"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"95695","value":"山女郎"},{"label":"能力","source":"bangumi","sourceCharacterId":"95695","value":"以烟草的烟操纵精神程度的能力（虹龙洞）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d0/d09072c343101e534e1a500c66b3c3b1b88d859074c606fe933db55459e777f0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/91/91b8c5ecd9abe8076a9a529b9899101788de1d881c510963a6ac21dc134f5e36.webp","width":215,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_95696","characterName":"やましろ たかね","sourceIds":{"bangumi":[{"characterId":"95696","match":"source-roster","subjectId":"329342"}]},"originalCharacterName":"やましろ たかね","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"○２面BOSS"},{"spoiler":false,"text":"深山的经商妖怪"},{"spoiler":false,"text":"山城 高岭"},{"spoiler":false,"text":"Yamashiro Takane"},{"spoiler":false,"text":"种族：山童"},{"spoiler":false,"text":"能力：操纵森林的气程度的能力"},{"spoiler":false,"text":"住在山中的人型妖怪。妖怪的性质与河童相似。"},{"spoiler":false,"text":"她们在妖怪之山的深处建立大本营，过着集体生活。"},{"spoiler":false,"text":"她们是在森林中生活的专家，技术水准也很高。"},{"spoiler":false,"text":"明明她们住在森林里，经济研究却很先进，构筑着复杂的金钱系统。"},{"spoiler":false,"text":"她们与河童之间会相互称对方为『区区住在河里的两栖类』和『区区住在林子里的猴子』，是好对手。"},{"spoiler":false,"text":"河童的机械如果没有山童就无法完成，山童的经济若没有河童的制造能力也是暴殄天物。"},{"spoiler":false,"text":"不论是在技术上还是在经商上，她们都相互依存着。"},{"spoiler":false,"text":"而她则是山童中领袖一般的人物。"},{"spoiler":false,"text":"据说其中理由，是因为她和其他山童比起来，说话方式些许更文明一些。"}],"source":"bangumi","sourceCharacterId":"95696"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"95696","value":"山童"},{"label":"能力","source":"bangumi","sourceCharacterId":"95696","value":"操纵森林的气程度的能力（虹龙洞）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/96964802afc7a604da437f109a839f6511a292cfd6599ec3dd9eb941d3de3388.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/64260f19ba8d1b4dcb1a24631cd628d12f7affe44a4dc32cdb5ac85a2fa6e990.webp","width":142,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_bangumi_95697","characterName":"ごうとくじ みけ","sourceIds":{"bangumi":[{"characterId":"95697","match":"source-roster","subjectId":"329342"}]},"originalCharacterName":"ごうとくじ みけ","characterNameSource":null,"role":"配角","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"bangumi","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"○１面BOSS"},{"spoiler":false,"text":"生意兴隆的吉祥物"},{"spoiler":false,"text":"豪德寺 三花"},{"spoiler":false,"text":"Goutokuzi Mike"},{"spoiler":false,"text":"种族：招财猫"},{"spoiler":false,"text":"能力：招财或者招客程度的能力"},{"spoiler":false,"text":"住在豪德寺的招财猫原本是白猫。"},{"spoiler":false,"text":"然而作为三花猫诞生的她，因为她的外观吃了不少苦头。"},{"spoiler":false,"text":"有时她被当作异类疏远，有时她险些面临毛发被染色的命运。"},{"spoiler":false,"text":"但是，由于她反倒主张身为三花猫有什么错，所以她被彻底排挤，"},{"spoiler":false,"text":"未能进行招财猫的修行。"},{"spoiler":false,"text":"可能因为这般原因，她作为招财猫的能力并不完全。"},{"spoiler":false,"text":"招财猫本应既能招财又能招客，但她只要招了财和客的其中之一，"},{"spoiler":false,"text":"就会让另外一方远离。"},{"spoiler":false,"text":"这样一来把她放在店里也没什么价值。自然而然，也没有人愿意接手。"},{"spoiler":false,"text":"她反而觉得这是她的幸运，以清爽的心情离开了招财猫社会。"},{"spoiler":false,"text":"于是，她开始在山中过起了悠然自得的新生活。"}],"source":"bangumi","sourceCharacterId":"95697"}],"profileFacts":[{"label":"种族","source":"bangumi","sourceCharacterId":"95697","value":"招财猫"},{"label":"能力","source":"bangumi","sourceCharacterId":"95697","value":"招财或者招客程度的能力（虹龙洞）"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/10/108069ea44e5a5eaad23afd55feed5445d3fb80318ce2e0c0a63e3ba897acdfd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/743c351e9a4c948dda67c29e05080644011acff8ea8d0acc81ce3c4cd20dc373.webp","width":121,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:997","sourceCompanyId":"egs:brand:997","canonicalEntityId":"egs:brand:997","name":"上海アリス幻樂団","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:30998:997","source":"egs"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable","vndb-work-mapping-pending"],"source":"terminal-wiki-full-runtime-v7"}}
