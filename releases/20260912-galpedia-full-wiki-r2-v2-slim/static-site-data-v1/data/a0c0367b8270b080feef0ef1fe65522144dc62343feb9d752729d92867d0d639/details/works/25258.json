us":"source-native","relationId":"vndb:vn-staff:140774","source":"vndb"},{"creditedName":"華憐","creatorId":"vndb:s2434","sourcePersonId":"vndb:s2434","canonicalEntityId":"vndb:s2434","name":"華憐","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:140777","source":"vndb"},{"creditedName":"花山 和夫","creatorId":"vndb:s5399","sourcePersonId":"vndb:s5399","canonicalEntityId":"vndb:s5399","name":"天翔 狗","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:140780","source":"vndb"},{"creditedName":"花山 和夫","creatorId":"vndb:s5399","sourcePersonId":"vndb:s5399","canonicalEntityId":"vndb:s5399","name":"天翔 狗","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:140781","source":"vndb"}]},"cast":[{"characterId":"char_c62663","characterName":"大羽 涼","sourceIds":{"bangumi":[{"characterId":"55492","match":"exact-normalized-name-in-linked-work","subjectId":"218447"}],"egsCharacterIds":["17551"],"vndbCharacterId":"c62663"},"originalCharacterName":"大羽 涼","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"b"}},"descriptions":[{"segments":[{"spoiler":false,"text":"階級は【准尉】"},{"spoiler":false,"text":"容姿端麗、鋭い目つき、長い黒髪の体つき豊満な少女。"},{"spoiler":false,"text":"内戦が続いていた、戦国時代と呼ばれた帝国の中でも、有数の武家貴族の家系に生まれる。"},{"spoiler":false,"text":"代々続く軍事系の家系で、涼も出生前は有力な軍人となる事を、期待されていた。"},{"spoiler":false,"text":"だが、フタナリであるために、幼い頃からここまで、苦難の日々を送っていた。"},{"spoiler":false,"text":"自分と同様に虐げられている者たちの解放を夢見ている。"}],"source":"egs","sourceCharacterId":"17551","sourceWorkId":"25258","spoiler":false},{"segments":[{"spoiler":false,"text":"本作の主人公。 女性の准士官で階級は准尉。"},{"spoiler":false,"text":"内戦が続いていた帝国内でも有数の武家貴族の家系に生まれ、"},{"spoiler":false,"text":"将来を期待されていたが3歳の時にフタナリであることが発覚し、"},{"spoiler":false,"text":"以降は実子でありながら使用人として育てられた。"},{"spoiler":false,"text":"帝国と大公国による極東大戦が勃発すると父や兄は戦死し、母も自害してしまう。"},{"spoiler":false,"text":"天涯孤独の身となった彼女は名門・大羽家の名を背負い、"},{"spoiler":false,"text":"フタナリとしての抑圧された生活からの脱却を目指し苛烈な戦いに身を投じていく。"}],"source":"bangumi","sourceCharacterId":"55492"}],"profileFacts":[],"metadataCandidateConflicts":{"sex":[{"comparisonValue":"b","source":"vndb","sourceCharacterId":"c62663","value":"b"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"17551","value":"女性"},{"comparisonValue":"f","source":"egs","sourceCharacterId":"17551","value":"女性"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c4/c44637ff622880cd7b76c51fc595837b95c636741d73db284b2193679fa50b75.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/260ec8692eb8e059d0c867707171e7630b28d93bbeb853182c1b88b2122ef9d7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"櫻井ありす","creatorId":"vndb:s1626","sourcePersonId":"vndb:s1626","canonicalEntityId":"vndb:s1626","name":"櫻井 ありす","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218447:55492:19213:1","source":"bangumi"}]},{"characterId":"char_c62664","characterName":"明石 達矢","sourceIds":{"bangumi":[],"egsCharacterIds":["17552"],"vndbCharacterId":"c62664"},"originalCharacterName":"明石 達矢","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"階級は【曹長】"},{"spoiler":false,"text":"大羽家と敵対していた華族【明石家】の養子。"},{"spoiler":false,"text":"明石家は大羽家と戦国時代からの因縁があれ、全滅を狙う。"},{"spoiler":false,"text":"涼の存在が明らかになる直前まで、大羽家の血筋は絶えたと思われていたが、大羽姓を名乗る涼を暗殺する為、派遣された。"},{"spoiler":false,"text":"だが、大羽のひたむきに努力する姿や、苛烈な戦地を乗り越えていく姿を見て、彼女への殺意は次第に揺らいでいく。"}],"source":"egs","sourceCharacterId":"17552","sourceWorkId":"25258","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"