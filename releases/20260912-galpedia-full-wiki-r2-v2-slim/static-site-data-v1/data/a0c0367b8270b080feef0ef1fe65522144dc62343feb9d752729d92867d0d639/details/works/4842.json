,"roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:51340","source":"vndb"}]},"cast":[{"characterId":"char_c28813","characterName":"桐沢 レイ","sourceIds":{"bangumi":[{"characterId":"69599","match":"exact-normalized-name-in-linked-work","subjectId":"266101"}],"egsCharacterIds":["26864"],"vndbCharacterId":"c28813"},"originalCharacterName":"桐沢 レイ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"警視庁特務捜査部七課、通称「麻薬特捜」の課長補佐。"},{"spoiler":false,"text":"豊満な肉体と美貌を持ちながら、特殊警棒を使った接近戦においては警視庁最強と謳われている。"},{"spoiler":false,"text":"また警視庁に引き抜かれる前は防衛庁のテロ対策課に在籍し、爆発を始めとした専門知識を有している。"},{"spoiler":false,"text":"冷静沈着で隙がなく、近寄り難い雰囲気を醸し出している彼女。"},{"spoiler":false,"text":"そんな彼女に懐いてくれている相棒・風子を出来の悪い妹のように思っている。"}],"source":"egs","sourceCharacterId":"26864","sourceWorkId":"4842","spoiler":false},{"segments":[{"spoiler":false,"text":"警視庁特務捜査部七課、通称「麻薬特捜」の課長補佐。"},{"spoiler":false,"text":"冷静沈着、細身の身体に豊満な胸が魅力的な凛とした美女。"},{"spoiler":false,"text":"警視庁に入る前は、防衛庁のテロ対策課に在籍していたため、"},{"spoiler":false,"text":"爆発物を始め様々な専門知識を有している。"},{"spoiler":false,"text":"また、接近戦でも神道夢想流杖術の皆伝者で、"},{"spoiler":false,"text":"「特殊電磁警棒」を使った接近戦では警視庁で右に出るものはいないほど。"},{"spoiler":false,"text":"その優秀さが見込まれて警視庁特務捜査部に引き抜かれた。"},{"spoiler":false,"text":"何かと抜けが多い相棒の風子にイライラして冷たく接したりしているが、"},{"spoiler":false,"text":"どちらかと言えば人に避けられる自分に何故か懐いる風子を"},{"spoiler":false,"text":"出来の悪い妹のように思っている。"}],"source":"bangumi","sourceCharacterId":"69599"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/87/87f9f7c6bb7ba732f5aa253e6385404a3c27873359e956bb109b7efde8515c9e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/bb/bb592f5b7b7d841f3cb4d0c308e6b1f8aad666c5f5e10587672fef19b4b1a61f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"MARIO","creatorId":"vndb:s632","sourcePersonId":"vndb:s632","canonicalEntityId":"vndb:s632","name":"紫苑 みやび","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266101:69599:4918:1","source":"bangumi"}]},{"characterId":"char_c28814","characterName":"泉 風子","sourceIds":{"bangumi":[{"characterId":"94342","match":"exact-normalized-name-in-linked-work","subjectId":"266101"}],"egsCharacterIds":["26865"],"vndbCharacterId":"c28814"},"originalCharacterName":"泉 風子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「麻薬特捜」の新人捜査官。レイの相棒。"},{"spoiler":false,"text":"政界や財界で有力な資産家の一人娘。"},{"spoiler":false,"text":"世間知らずのお嬢様で、何かと抜けが多い彼女だが、その実、頭脳明晰で、警察大学を主席で卒業。"},{"spoiler":false,"text":"父親の反対を押し切り、危険と隣り合わせの「麻麻薬特捜」への配属が決まる。"},{"spoiler":false,"text":"電子技術を専門とし、ジャミングなどを得意とする。"},{"spoiler":false,"text":"そのため、この時代の主流となっているコンピューター制御の銃などを一瞬で無効化させることもお手のもの。"},{"spoiler":false,"text":"何事にも完璧なレイに憧れ、何かとくっついて離れない。"}],"source":"egs","sourceCharacterId":"26865","sourceWorkId":"4842","spoiler":false},{"segments":[{"spoiler":false,"text":"「麻薬特捜」の新人捜査官。レイの相棒。"},{"spoiler":false,"text":"政界や財界で有力な資産家の一人娘。世間知らずのお嬢様育ちで"},{"spoiler":false,"text":"何かと抜けが多い彼女だが、実は成績優秀で飛び級を重ね、"},{"spoiler":false,"text":"14歳で警察大学を首席で卒業し、彼女のたっての希望で特務捜査部七課に配属された。"},{"spoiler":false,"text":"ところがそれを後で知った彼女の父親は辞めさせようとしたが、"},{"spoiler":false,"text":"風子は頑として聞かず、困った父親は娘のために優秀な捜査官を"},{"spoiler":false,"text":"相棒にと警察上層部に圧力をかけ、最も優秀なレイを相棒にあてがわれたという経緯がある。"},{"spoiler":false,"text":"電子技術が専門で、最も得意とする技術がジャミング。"},{"spoiler":false,"text":"この時代の主流となっているコンピュータ制御の銃なら一瞬で 無効化することができるほど。"},{"spoiler":false,"text":"何でも完璧なレイに憧れており、"},{"spoiler":false,"text":"何かに付けて彼女のあとを金魚のフンのように付きまとっている。"}],"source":"bangumi","sourceCharacterId":"94342"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/94/941eb0bfa422d9e3bf7954afddd7600742dc2118c4bdeb35c8479245e0f5f7c3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9c256e0150c3e7841e246b44cac3c188cf563c7ce37cb1a4af4adeffee6d6fc0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"静木亜美","creatorId":"vndb:s663","sourcePersonId":"vndb:s663","canonicalEntityId":"vndb:s663","name":"静木 亜美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266101:94342:8575:1","source":"bangumi"}]},{"characterId":"char_c28815","characterName":"黄龍","sourceIds":{"bangumi":[{"characterId":"92026","match":"exact-normalized-name-in-linked-work","subjectId":"266101"},{"characterId":"92026","match":"exact-normalized-name-in-linked-work","subjectId":"303919"}],"egsCharacterIds":["9965"],"vndbCharacterId":"c28815"},"originalCharacterName":"黄龍","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"透き通るような白い肌に、美しい銀髪の少女ながら、東京に強大な勢力を誇る麻薬組織「12天使」の女ボス。"},{"spoiler":false,"text":"「12天使」のボスだった父親に幼い頃から暗殺術を仕込まれ、六歳のときに敵対する組織の幹部の暗殺に成功し、以後、数々の修羅場を潜り抜けてきた。"},{"spoiler":false,"text":"自分の父親さえも10歳のときに暗殺して組織を乗っ取ると、優れた手腕を発揮し、飛躍的に組織を成長させた。"}],"source":"egs","sourceCharacterId":"9965","sourceWorkId":"4842","spoiler":false},{"segments":[{"spoiler":false,"text":"東京に強大な勢力を持つ「12天使」と呼ばれる麻薬組織のボス。"},{"spoiler":false,"text":"透き通るような白い肌に銀髪のエキゾチックな美少女。"},{"spoiler":false,"text":"暗器の達人。"},{"spoiler":false,"text":"「12天使」のボスであった父親に、幼い頃からあらゆる暗殺術を叩き込まれており、6歳の時に敵対する組織の幹部を暗殺したのを始めに数え切れない修羅場を生きてきた。"},{"spoiler":false,"text":"10歳の時に父親を殺して組織を乗っ取ると、飛躍的に組織を成長させて現在の勢力まで育てあげた。"},{"spoiler":false,"text":"特務捜査官であったレイと風子を捕らえ、触手調教を施し十二天使の恐怖を特捜課に解らせようと思っていたが最後の締めの調教を施そうとした最中に、特捜課に強襲され彼女達を奪還されてしまう。"},{"spoiler":false,"text":"また片腕であった趙紫煙は黄龍を庇い瀕死の重傷をおうも彼女を逃がす。"},{"spoiler":false,"text":"命辛々逃げ切ることが出来た黄龍だったが、部下の反乱にあい十二天使のボスの座を追われる。"}],"source":"egs","sourceCharacterId":"9965","sourceWorkId":"15578","spoiler":false},{"segments":[{"spoiler":false,"text":"東京に強大な勢力を持つ 『12天使』 と呼ばれる麻薬組織のボス。"},{"spoiler":false,"text":"透き通るような白い肌に銀髪の、エキゾチックな美少女。"},{"spoiler":false,"text":"暗器の達人。『12天使』 のボスであった父親に、幼い頃からあらゆる暗殺術を叩き込まれており、6歳の時に敵対する組織の幹部を暗殺したのを始めに、数え切れないほどの修羅場をくぐってきた。"},{"spoiler":false,"text":"10歳の時に父親を殺して組織を乗っ取ると、飛躍的に組織を成長させて現在の勢力まで育てあげた。"},{"spoiler":false,"text":"特務捜査官であったレイと風子を捕らえ、触手調教を施し 『12天使』 の恐怖を特捜課に分からせようと思っていたが、最後の締めの調教を施そうとした最中に特捜課に強襲され、彼女たちを奪還されてしまう。"},{"spoiler":false,"text":"また片腕であった趙紫煙は黄龍を庇い、瀕死の重傷を負うも彼女を逃がす。"},{"spoiler":false,"text":"命からがら逃げ切ることが出来た黄龍だったが、部下の反乱にあい 『12天使』 のボスの座を追われる。"}],"source":"bangumi","sourceCharacterId":"92026"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c80de0096f65d61b8c5f921988e764bdad0cc49b22da91089d39be4f0b8dc1fc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6df1e085b7694a23b5585771479115fdd450a307ee04fd92a2866dacf133c96.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"野中カオリ","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:266101:92026:6409:1","source":"bangumi"}]},{"characterId":"char_vndb_c132423","characterName":"趙紫煙","sourceIds":{"vndbCharacterId":"c132423"},"originalCharacterName":"趙紫煙","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflict