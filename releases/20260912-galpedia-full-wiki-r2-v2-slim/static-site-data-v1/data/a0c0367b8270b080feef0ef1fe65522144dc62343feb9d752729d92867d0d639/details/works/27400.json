e":"星谷 美友","creatorId":"vndb:s1958","sourcePersonId":"vndb:s1958","canonicalEntityId":"vndb:s1958","name":"星谷 美友","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:153252","source":"vndb"},{"creditedName":"星谷 美友","creatorId":"vndb:s1958","sourcePersonId":"vndb:s1958","canonicalEntityId":"vndb:s1958","name":"星谷 美友","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:153253","source":"vndb"}]},"cast":[{"characterId":"char_c76667","characterName":"鳴宮 千沙","sourceIds":{"bangumi":[{"characterId":"67716","match":"exact-normalized-name-in-linked-work","subjectId":"268032"}],"egsCharacterIds":["20560"],"vndbCharacterId":"c76667"},"originalCharacterName":"鳴宮 千沙","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Favorite things: Her husband, cats, nature"},{"spoiler":false,"text":"Dislikes: Deadlines, ghosts, natto"},{"spoiler":false,"text":"Hobbies: Hanging out with Yuuki, reading"},{"spoiler":false,"text":"Strengths: Beauty and intelligence, honesty"},{"spoiler":false,"text":"Weaknesses: Too mischievous, a bit sluggish"},{"spoiler":false,"text":"Alcohol Tolerance: Normal (gets hungover easily)"},{"spoiler":false,"text":"She was Yuuki's older next-door neighbor and has always liked him. She's also a writer who mainly works on novels."},{"spoiler":false,"text":"She's the rare sort of person to have actually followed through on a childhood marriage proposal."},{"spoiler":false,"text":"She still has some fun at Yuuki's expense now that they're together, possibly because that's how they were when they met."},{"spoiler":false,"text":"She is good at housework and her job, is very generally talented, and has a lot of income."},{"spoiler":false,"text":"Perhaps that's why she \"forcibly\" pays for most of the living expenses."},{"spoiler":false,"text":"She was worried she wouldn't get to marry Yuuki, but still stayed pure all those years. After two decades of waiting, though, her inner beast gets unleashed in bed."}],"source":"vndb","sourceCharacterId":"c76667"},{"segments":[{"spoiler":false,"text":"元々は幼い頃から結城を可愛がってきた近所のお姉さんで、子供の頃によくある「けっこんしよー」を成就させてしまった人。"},{"spoiler":false,"text":"その頃の名残か結婚している今でも結城を少しからかったり、甘やかしたり、少し茶目っ気のあるさばさばした姉御肌のお嫁さん。"},{"spoiler":false,"text":"家事に仕事にすべて優秀という才色兼備で収入も多い。"},{"spoiler":false,"text":"そのためか、生活費のほとんどは彼女が“無理やり”払っている。"},{"spoiler":false,"text":"職業は小説をメインとした物書き。"},{"spoiler":false,"text":"幼い頃の約束をかなわないと思いつつも、二十数年間、純潔を守り続けていた反動か、初めてのHをしたときからちょっと性獣として目覚めている様子。"}],"source":"egs","sourceCharacterId":"20560","sourceWorkId":"27400","spoiler":false},{"segments":[{"spoiler":false,"text":"元々は幼い頃から結城を可愛がってきた近所のお姉さんで、"},{"spoiler":false,"text":"子供の頃によくある「けっこんしよー」を成就させてしまった人。"},{"spoiler":false,"text":"その頃の名残か結婚している今でも結城を少しからかったり、甘やかしたり、"},{"spoiler":false,"text":"少し茶目っ気のあるさばさばした姉御肌のお嫁さん。"},{"spoiler":false,"text":"家事に仕事にすべて優秀という才色兼備で収入も多い。"},{"spoiler":false,"text":"そのためか、生活費のほとんどは彼女が “無理やり” 払っている。"},{"spoiler":false,"text":"職業は小説をメインとした物書き。"},{"spoiler":false,"text":"幼い頃の約束をかなわないと思いつつも、"},{"spoiler":false,"text":"二十数年間、純潔を守り続けていた反動か、"},{"spoiler":false,"text":"初めてのHをしたときからちょっと性獣として目覚めている様子。"}],"source":"bangumi","sourceCharacterId":"67716"}],"profileFacts":[{"label":"好きなもの","source":"bangumi","sourceCharacterId":"67716","value":"主人公、猫、自然"},{"label":"嫌いなもの","source":"bangumi","sourceCharacterId":"67716","value":"締切、お化け、納豆"},{"label":"職業","source":"bangumi","sourceCharacterId":"67716","value":"小説家"},{"label":"趣味","source":"bangumi","sourceCharacterId":"67716","value":"結城いじり、読書、散歩。"},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"20560","sourceWorkId":"27400","so