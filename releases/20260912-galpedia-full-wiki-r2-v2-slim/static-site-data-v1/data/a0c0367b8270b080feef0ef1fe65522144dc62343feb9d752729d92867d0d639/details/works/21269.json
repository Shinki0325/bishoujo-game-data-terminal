Id":"118171"}],"egsCharacterIds":["6434"],"vndbCharacterId":"c37085"},"originalCharacterName":"保科 雪子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本編のヒロイン。"},{"spoiler":false,"text":"通いの家政婦として草間の身の回りの世話をする少女。"},{"spoiler":false,"text":"貿易商の令嬢であったが震災の影響で破産、現在は庶民として暮らす。"},{"spoiler":false,"text":"父親は失踪しており、現在は母親と二人暮らし。"},{"spoiler":false,"text":"草間の援助で女学校へと通っており、学校帰りにやってくる。"},{"spoiler":false,"text":"令嬢時代には家庭教師である草間に淡い憧れを抱いていたが、再会後、少女としてでなく女性としてその想いを新たにする。"},{"spoiler":false,"text":"聡明で美しい理想的なやまとなでしこ。"},{"spoiler":false,"text":"元資産家令嬢だが気取らず、よく気がつき、よく働く。"},{"spoiler":false,"text":"多少天然なところはあるものの、穏やかで微笑みを絶やさない。"},{"spoiler":false,"text":"清楚な容姿ながら芯は強い。弱音を吐かず自分の中に押し込めてしまう。"}],"source":"egs","sourceCharacterId":"6434","sourceWorkId":"21269","spoiler":false},{"segments":[{"spoiler":false,"text":"本編のヒロイン。"},{"spoiler":false,"text":"通いの家政婦として草間の身の回りの世話をする少女。"},{"spoiler":false,"text":"貿易商の令嬢であったが震災の影響で破産、現在は庶民として暮らす。"},{"spoiler":false,"text":"令嬢時代には家庭教師である草間に淡い憧れを抱いていたが、再会後、少女としてでなく女性としてその想いを新たにする。"},{"spoiler":false,"text":"「お久しぶりです、先生」"}],"source":"bangumi","sourceCharacterId":"29114"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc5a80bee8cff7abdb7325481f165a65b474d08ca44e8e2738ef2e9b3c060105.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14faddd821fa44820f2f294474986ea2c750f36f9a66a09821385d00bf6c6479.webp","width":120,"height":160,"source":"static-detail"},"actors":[{"creditedName":"松代真由","creatorId":"vndb:s3931","sourcePersonId":"vndb:s3931","canonicalEntityId":"vndb:s3931","name":"三つ木ちかる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:118171:29114:25293:1","source":"bangumi"}]},{"characterId":"char_c37086","characterName":"橘 奈緒美","sourceIds":{"bangumi":[{"characterId":"29113","match":"exact-normalized-name-in-linked-work","subjectId":"118171"}],"egsCharacterIds":["6435"],"vndbCharacterId":"c37086"},"originalCharacterName":"橘 奈緒美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"もう一人のヒロイン。"},{"spoiler":false,"text":"草間が出入りするサロンを仕切る銀髪碧眼の美少女。"},{"spoiler":false,"text":"欧州貴族の落胤と称し、たちまちサロンの華となった彼女の正体は草間が学生時代に出会った娼婦であった。"},{"spoiler":false,"text":"震災の混乱に乗じて上流階級に潜り込んだ彼女は、その美貌と狡猾さで見る間に社交界で成り上がる。"},{"spoiler":false,"text":"自らの秘密を知る草間に接近する。"},{"spoiler":false,"text":"天真爛漫な振る舞いと人懐こい笑顔に、接する者は皆魅了される。"},{"spoiler":false,"text":"目的に対する強い意志を持ち、そのためには手段を選ばないところがある。"},{"spoiler":false,"text":"悪女を気取っているが完全に強靱な精神の持ち主ではなく、時折理性が感情に振り回されてしまうことがある。"},{"spoiler":false,"text":"自分の魅せ方を自覚しており、歳のわりに妖艶な雰囲気だが、ふと子供っぽい表情を見せることもある。"}],"source":"egs","sourceCharacterId":"6435","sourceWorkId":"21269","spoiler":false},{"segments":[{"spoiler":false,"text":"もう一人のヒロイン。"},{"spoiler":false,"text":"草間が出入りするサロンを仕切る銀髪碧眼の美少女。"},{"spoiler":false,"text":"彼女の正体は草間が学生時代に出会った娼婦であった。"},{"spoiler":false,"text":"自分の魅せ方を自覚しており、歳のわりに妖艶な雰囲気だが、ふと子供っぽい表情を見せることもある。"},{"spoiler":false,"text":"「ふふ、サロンでわたしにそんな口をきくのは貴方だけよ」"}],"source":"bangumi","sourceCharacterId":"29113"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a86b02a33bb121c3a95f6b77a91a608c1b46e18ad166dc319ee38a9f449745c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a78f232b51cf90260732cdd9c0b2aec65620cfb317359db17f63a42f248f71e8.webp","width":120,"height":160,"source":"static-detail"},"actors":[{"creditedName":"柚原みう","creatorId":"vndb:s977","sourcePersonId":"vndb:s977","canonicalEntityId":"v