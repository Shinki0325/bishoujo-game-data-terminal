ンにはかなりのこだわりがあるらしく、食堂には “かれんスペシャル” という裏メニューが存在しているとかなんとか。"},{"spoiler":false,"text":"「お父さん言ってました、プリンにおしょうゆかけるとスペシャルなウニの味がするですぅ」"}],"source":"bangumi","sourceCharacterId":"23298"}],"profileFacts":[{"label":"身高（本版本）","value":"148 cm","valueContext":null,"source":"egs","sourceCharacterId":"2419","sourceWorkId":"19584","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/93/93eb2f56fc4e6a1e2f7a4596b37037e37d8ab16c73d383c2aaba0979a2828b7d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09c3a09f201854183ab9db88af769bec169bfbb6f76edab5c86fe15a37ae7f87.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"英みらい","creatorId":"vndb:s996","sourcePersonId":"vndb:s996","canonicalEntityId":"vndb:s996","name":"英みらい(大山チロル、ひつじまる)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:84911:23298:8069:1","source":"bangumi"}]},{"characterId":"char_c23029","characterName":"尾形 千晶","sourceIds":{"bangumi":[{"characterId":"23299","match":"exact-normalized-name-in-linked-work","subjectId":"84911"}],"egsCharacterIds":["2420"],"vndbCharacterId":"c23029"},"originalCharacterName":"尾形 千晶","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1111"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"45"}},"descriptions":[{"segments":[{"spoiler":false,"text":"六条学園二年生。"},{"spoiler":false,"text":"主人公の幼馴染みでクラスメイト。スポーツ、勉強、なんでもそつなくこなす優等生。"},{"spoiler":false,"text":"幼馴染みの主人公と真とはいつも行動を共にしている。同性友達いない系女子かと思いきや、愛紗とは大の仲良し。"},{"spoiler":false,"text":"面倒見がいいためクラスでは男女問わず人気がある。テスト前はいつも主人公と真の二人に勉強を教えるという大義名分を借りて二人をしごいて楽しんでいる。"},{"spoiler":false,"text":"普段から男子のような口調だが、意外に乙女チックな一面も？"}],"source":"egs","sourceCharacterId":"2420","sourceWorkId":"19584","spoiler":false},{"segments":[{"spoiler":false,"text":"六条学園二年生。 主人公の幼なじみでクラスメイト。"},{"spoiler":false,"text":"スポーツ、勉強、なんでもそつなくこなす優等生。"},{"spoiler":false,"text":"幼なじみの主人公と真とはいつも行動を共にしている。 同性友達いない系女子かと思いきや、愛紗とは大の仲良し。"},{"spoiler":false,"text":"面倒見が良いためクラスでは男女問わず人気がある。"},{"spoiler":false,"text":"テスト前はいつも主人公と真の二人を、勉強を教えるという大義名分を得てしごき楽しんでいる。"},{"spoiler":false,"text":"普段から男子のような口調だが、意外に乙女チックな一面も？"},{"spoiler":false,"text":"「お安いご用！　気にすんなって！」"}],"source":"bangumi","sourceCharacterId":"23299"}],"profileFacts":[{"label":"身高（本版本）","value":"157 cm","valueContext":null,"source":"egs","sourceCharacterId":"2420","sourceWorkId":"19584","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6b/6bf6b085363dc679ef092418d654e640d3e9f6760b7d76a0e1c00a9d8192908e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/78/781c7091f69e4da041504c4cf59cb1c392941b3bd68213a60bde5428e4174ba5.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"涼貴涼","creatorId":"vndb:s519","sourcePersonId":"vndb:s519","canonicalEntityId":"vndb:s519","name":"涼貴 涼","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:84911:23299:22923:1","source":"bangumi"}]},{"characterId":"char_c23030","characterName":"天谷 まおみ","sourceIds":{"bangumi":[{"characterId":"23300","match":"exact-normalized-name-in-linked-work","subjectId":"84911"}],"egsCharacterIds":["2421"],"vndbCharacterId":"c23030"},"originalCharacterName":"天谷 まおみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","sou