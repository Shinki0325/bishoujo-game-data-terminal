nts":[{"spoiler":false,"text":"長い黒髪が美しい人妻。"},{"spoiler":false,"text":"エリートの夫に不満はないが、温かみのない家庭に疲れを感じていたことと友人・ちとせに誘われたこともあり、夫にナイショでアルバイトを始める。"},{"spoiler":false,"text":"頼まれたらイヤと言えない性格から、母乳を提供するようになった。"},{"spoiler":false,"text":"恥かしがりの上、夫以外との男性経験がなかったので、SEXに対する知識に疎い。"},{"spoiler":false,"text":"本人は大きすぎてみっともないと思っている美乳を毎日主人公にもまれるうちに、敏感なカラダが反応していく。"}],"source":"egs","sourceCharacterId":"19109","sourceWorkId":"7686","spoiler":false},{"segments":[{"spoiler":false,"text":"前作『人妻搾乳飯店』のヒロイン。"},{"spoiler":false,"text":"控え目で清楚、黒髪が美しい、主人公の理想の女性。"},{"spoiler":false,"text":"前の夫と離婚し主人公と同棲しているが、300日規定のため入籍はまだ。"},{"spoiler":false,"text":"普段は奥手で恥ずかしがり屋だが、感じ始めると止まらなくなる。"},{"spoiler":false,"text":"「もう……もうすぐパパになるっていうのに、大きな赤ちゃんみたいなんだから……」"}],"source":"egs","sourceCharacterId":"19109","sourceWorkId":"10087","spoiler":false},{"segments":[{"spoiler":false,"text":"長い黒髪が美しく、控えめで清楚。主人公にとっては理想的な女性。"},{"spoiler":false,"text":"前の夫とはすでに離婚しており、主人公とは同棲しているが300日規定のために入籍はしていない。"},{"spoiler":false,"text":"他の人妻たちに比べたら奥手で恥ずかしがりやなので、自分から積極的にHを仕掛けるわけではないが、感じ始めるととまらない。H後は毎回自分の乱れ具合を思い出して赤面してしまう。"},{"spoiler":false,"text":"「もう……、もうすぐパパになるっていうのに、大きな赤ちゃんみたいなんだから……」"}],"source":"bangumi","sourceCharacterId":"54385"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"19109","sourceWorkId":"7686","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"19109","sourceWorkId":"7686","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"19109","sourceWorkId":"7686","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1adbbb55ace7ac01b0f7deec85a67860dffd307713cf456a31b89270796fb1c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/66/662c112f2e3b7ef6bc640c383b65fc7e8d4b58200b44c179e6b15c61bd0a4dce.webp","width":100,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮侑布","creatorId":"vndb:s1450","sourcePersonId":"vndb:s1450","canonicalEntityId":"vndb:s1450","name":"雨宮 侑布","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:215935:54385:4940:1","source":"bangumi"}]},{"characterId":"char_c19370","characterName":"和泉 ちとせ","sourceIds":{"bangumi":[{"characterId":"54394","match":"exact-normalized-name-in-linked-work","subjectId":"215935"}],"egsCharacterIds":["19110"],"vndbCharacterId":"c19370"},"originalCharacterName":"和泉 ちとせ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"お団子ヘアーが似合うフェミニンな人妻。"},{"spoiler":false,"text":"結婚前から相当遊んでいたが、今の夫と出来ちゃった結婚でゴールイン。"},{"spoiler":false,"text":"ただ、子供のことは本当に愛しており、普段は良い母親。"},{"spoiler":false,"text":"母乳についても天然である。"},{"spoiler":false,"text":"バイト先にはいってきた若い男性（主人公）で、自分の欲求をみたそうと誘惑してくる。"},{"spoiler":false,"text":"ダンナの趣味も手伝って、コスプレ用の衣装をかなり持っているようだ。"}],"source":"egs","sourceCharacterId":"19110","sourceWorkId":"7686","spoiler":false},{"segments":[{"spoiler":false,"text":"前作『人妻搾乳飯店』のヒロイン。"},{"spoiler":false,"text":"忙しい主人公と身重の美紀をサポートする有能な人妻スタッフ、その1。"},{"spoiler":false,"text":"二人を祝福しながらも、主人公とのエッチはやめない。"},{"spoiler":false,"text":"本人曰く「自分とのエッチは浮気じゃなくて、スキンシップの一種」"},{"spoiler":false,"text":"「美紀だけ孕ませるっていうのがズルいのよ！　私たちもちゃんと妊娠させてほしいわ！」"}],"source":"egs","sourceCharacterId":"19110","sourceWorkId":"10087","spoiler":false},{"segments":[{"spoiler":false,"text":"お団子ヘアーが似合うフェミニンな人妻。"},{"spoiler":false,"text":"結婚前から相当遊んでいて、男性経験も豊富だったが、今の夫と出来ちゃった結婚でゴールイン。"},{"spoiler":false,"text":"ただ、自分の子供のことは愛しており、普段は良い母親。母乳についても天然である。"},{"spoiler":false,"text":"嫉妬深い夫が会社の近所ということで、唯一許したのが『乳々飯店』でのバイトであったが"},{"spoiler":false,"text":"そこに若い男性（主人公）がはいってきたので、自分の欲求をみたそうと誘惑してくる。"},{"spoiler":false,"text":"ダンナの趣味も手伝って、コスプレ用の衣装をかなり持っているようだ。"},{"spoiler":false,"text":"「こんなカチンカチンに勃起させといて、"},{"spoiler":false,"text":"男らしくないわよ？ ……って、うわ、すごーい！」"}],"source":"bangumi","sourceCharacterId":"54394"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"19110","sourceWorkId":"7686","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"19110","sourceWorkId":"7686","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"19110","sourceWorkId":"7686","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5f/5ffc0aa70d231b1c90d6cb450f93dc92a9d524e7b38ae07d2e277e69e177c97a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/035d096aeaba9e85bf4d5812b417c96370378c2c81e4c5775fd8239b59bc8b02.webp","width":104,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:215935:54394:6106:1","source":"bangumi"}]},{"characterId":"char_c19372","characterName":"杵島 聖華","sourceIds":{"bangumi":[{"characterId":"54395","match":"exact-normalized-name-in-linked-work","subjectId":"215935"}],"egsCharacterIds":["19111"],"vndbCharacterId":"c19372"},"originalCharacterName":"杵島 聖華","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"83"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"「夫がリストラされ生活に困っており雇って欲しい」とやってきた美貌の人妻。"},{"spoiler":false,"text":"面接に応対した主人公は、強引に迫られエッチしてしまい、なし崩し的に雇うことに。"},{"spoiler":false,"text":"本人はタダの主婦だといっているが、その立ち振る舞いと言動、そして時折見せる世間とのズレから、とてもそうだとは思えない。"},{"spoiler":false,"text":"どうも、乳々飯店の名物「乳々豆腐」に興味があるようだが……！？"}],"source":"egs","sourceCharacterId":"19111","sourceWorkId":"7686","spoiler":false},{"segments":[{"spoiler":false,"text":"前作『人妻搾乳飯店』のヒロイン。"},{"spoiler":false,"text":"忙しい主人公と身重の美紀をサポートする有能な人妻スタッフ、その2。"},{"spoiler":false,"text":"真面目な性格で数字に強いことから、店の経理を一手に引き受ける。"},{"spoiler":false,"text":"しかし主人公とのエッチは忘れられず、肉体関係は続いている様子。"},{"spoiler":false,"text":"「私もいっぱい膣内出ししてもらって、早く店長の赤ちゃんを妊娠させてほしいですわ！」"}],"source":"egs","sourceCharacterId":"19111","sourceWorkId":"10087","spoiler":false},{"segments":[{"spoiler":false,"text":"夫がリストラされたのでどうか雇って欲しい、ということで乳々飯店にやってきた、美貌の人妻。"},{"spoiler":false,"text":"面接に応対した主人公だったが、強引に迫られその場でエッチしてしまい、なし崩し的に雇うことになる。"},{"spoiler":false,"text":"本人はタダの主婦だといっているが、その立ち振る舞いと言動、そして時折見せる世間とのズレからとてもそうだとは思えない。"},{"spoiler":false,"text":"どうも、乳々飯店の名物「乳々豆腐」に興味があるようだが……!?"},{"spoiler":false,"text":"「夫がリストラされて生活に困ってるんです、"},{"spoiler":false,"text":"雇っていただく為なら何でもしますわ……」"}],"source":"bangumi","sourceCharacterId":"54395"}],"profileFacts":[{"label":"胸围（本版本）","value":"83 cm","valueContext":null,"source":"egs","sourceCharacterId":"19111","sourceWorkId":"7686","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"19111","sourceWorkId":"7686","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"19111","sourceWorkId":"7686","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets