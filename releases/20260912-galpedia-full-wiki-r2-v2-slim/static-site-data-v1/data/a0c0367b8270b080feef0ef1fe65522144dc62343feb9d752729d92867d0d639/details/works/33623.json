didate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"82"},"height":{"reviewState":"no-conflict","source":"vndb","value":"152"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"異世界ロアの女神近衛団から、レムティアシータの援護と監視のために新たに地上に派遣された魔法戦士。"},{"spoiler":false,"text":"由緒ある家系に生まれ、魔法や武器の扱いにも長けたエリート。"},{"spoiler":false,"text":"自信家で使命感が強く能力は一級品だが、融通が利かないところがあり、実戦経験は乏しく、敵の狡猾さにたびたび翻弄されてしまう。"},{"spoiler":false,"text":"教養があり芸術などにも造詣が深い。"}],"source":"egs","sourceCharacterId":"23877","sourceWorkId":"31509","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士レムティアナイツの一人、レムティアイオタ。本名はメルフィーネ・レオニス。"},{"spoiler":false,"text":"由緒ある家に生まれたエリート。レムティアシータとともに難局を乗り越えたことで、心のつながったパートナーとなる。"},{"spoiler":false,"text":"生真面目でお堅く見えるが、ぬいぐるみを集めるのが趣味など、可愛らしい一面もある。"},{"spoiler":false,"text":"レムティアシータとともに魔法療法士として医療機関で働いている。"}],"source":"egs","sourceCharacterId":"23877","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"異世界ロアの女神近衛団から、レムティアシータの援護と監視のために新たに地上に派遣された魔法戦士。"},{"spoiler":false,"text":"由緒ある家系に生まれ、魔法や武器の扱いにも長けたエリート。"},{"spoiler":false,"text":"自信家で使命感が強く能力は一級品だが、融通が利かないところがあり、実戦経験は乏しく、敵の狡猾さにたびたび翻弄されてしまう。"},{"spoiler":false,"text":"教養があり芸術などにも造詣が深い。"}],"source":"bangumi","sourceCharacterId":"99771"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/75/7541eb4a73ff95330782ed8d5ad95ef124cbae91a85e812d03d76551cefd7ce2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/ae2562d5d28f73923dd4d3291a1989075af2c58af09d311761967859e475fcf0.webp","width":199,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽崎 浮木","creatorId":"vndb:s33125","sourcePersonId":"vndb:s33125","canonicalEntityId":"vndb:s33125","name":"羽崎 浮木","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:93952","source":"vndb"}]},{"characterId":"char_c125383","characterName":"エターナルティア","sourceIds":{"bangumi":[{"characterId":"96135","match":"exact-normalized-name-in-linked-work","subjectId":"421425"}],"egsCharacterIds":["24899"],"vndbCharacterId":"c125383"},"originalCharacterName":"エターナルティア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔法戦士にして、異世界ロアの女王。本名はティアナ・リリアン・トランシルヴェール。先代女王グロリアから王位を引き継いだ。"},{"spoiler":false,"text":"しばらくは安定した統治をおこなっていたが、並行世界からやってきた息子、キールの出現によってティアナの治世は不信に揺らぐ。"},{"spoiler":false,"text":"そして封印されていた「銀髪の魔王」メッツァー・ハインケルがキールの手によって復活。窮地に立たされたティアナは、自らの手でメッツァーやキールとの決着をつけるべく、地上世界へと向かう。"}],"source":"egs","sourceCharacterId":"24899","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"異世界ロアを治めるクイーン・グロリアの娘、第一王女。"},{"spoiler":false,"text":"プリンセス・ティアという、魔法によって戦士に変身した別の姿を持つ。"},{"spoiler":false,"text":"性格は純粋無垢で清純そのもの。"},{"spoiler":false,"text":"多くの騎士団員たちが自分を助けるために捕らわれたことに心を痛め、"},{"spoiler":false,"text":"彼女たちを救い出すために、"},{"spoiler":false,"text":"変身によって身体が快楽に敏感になっていくことに耐えながら、"},{"spoiler":false,"text":"悲壮な決意で悪の組織ゼーロウと戦い続ける。"}],"source":"bangumi","sourceCharacterId":"96135"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f9a9830f9a28104a74a3ab931d3a3e51df58f7cc96e6254977bf9803e1fe900.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/79/7991078d4018c08eec5fc4e47a6ab099de1b910e59a2a0e530c1e1869743fa01.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤野 むらさき","creatorId":"vndb:s1545","sourcePersonId":"vndb:s1545","canonicalEntityId":"vndb:s1545","name":"さいとう よしえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:93950","source":"vndb"}]},{"characterId":"char_c125384","characterName":"エスフィナ・インヴィディア","sourceIds":{"bangumi":[{"characterId":"142959","match":"exact-normalized-name-in-linked-work","subjectId":"421425"}],"egsCharacterIds":["24900"],"vndbCharacterId":"c125384"},"originalCharacterName":"エスフィナ・インヴィディア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"女神近衛団第一騎士団エンジェルナイツの騎士団長。ティアナの片腕としてロアのために尽力している。"},{"spoiler":false,"text":"決してエリートではなく、努力で才能を開花させた叩き上げの戦士。"},{"spoiler":false,"text":"血筋ではなく実力で女王直属の騎士団団長の座を手に入れた。"},{"spoiler":false,"text":"ティアナに救われた過去があり、篤い忠誠心で彼女に仕えている。"}],"source":"egs","sourceCharacterId":"24900","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"女神近衛団第一騎士団エンジェルナイツの騎士団長。ティアナの片腕としてロアのために尽力している。"},{"spoiler":false,"text":"決してエリートではなく、努力で才能を開花させた叩き上げの戦士。"},{"spoiler":false,"text":"血筋ではなく実力で女王直属の騎士団団長の座を手に入れた。"},{"spoiler":false,"text":"ティアナに救われた過去があり、篤い忠誠心で彼女に仕えている。"}],"source":"bangumi","sourceCharacterId":"142959"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e9a0402607936d27e615d47492b846749e2e1e6e84b961e002bb8c5579e8c735.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f6/f6e5c7754ba110fa16c6496f7be05f9b968802b51c9b24171baa6b3178ea42c0.webp","width":165,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤吉ローズ","creatorId":"vndb:s22420","sourcePersonId":"vndb:s22420","canonicalEntityId":"vndb:s22420","name":"藤吉 ローズ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:567131:142959:88819:1","source":"bangumi"}]},{"characterId":"char_c125392","characterName":"スイートキッス","sourceIds":{"bangumi":[{"characterId":"96132","match":"exact-normalized-name-in-linked-work","subjectId":"347354"},{"characterId":"96132","match":"exact-normalized-name-in-linked-work","subjectId":"421425"}],"egsCharacterIds":["985"],"vndbCharacterId":"c125392"},"originalCharacterName":"スイートキッス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"a"},"bust":{"reviewState":"source-only","source":"vndb","value":"74"},"height":{"reviewState":"no-conflict","source":"vndb","value":"148"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"},"waist":{"reviewState":"source-only","source":"vndb","value":"50"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"その小さな身体で健気にメッツァーに立ち向かう儚い戦士。"},{"spoiler":false,"text":"心の傷を克服し戦いに舞い戻っただけあって、芯の強さは人一倍かも。"}],"source":"egs","sourceCharacterId":"985","sourceWorkId":"18638","spoiler":false},{"segments":[{"spoiler":false,"text":"「凛々子さんの迷いや辛さ、私にも背負わせてください」"},{"spoiler":false,"text":"スイートナイツの一人。"},{"spoiler":false,"text":"健気で心優しく、お菓子作りが得意。"},{"spoiler":false,"text":"かつては戦いで傷つき変身出来なくなっていたこともあったが、正義のために戦う気持ちを取り戻している。"},{"spoiler":false,"text":"現在は難民キャンプで支援のボランティアをしている。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士スイートナイツ」ほか"}],"source":"egs","sourceCharacterId":"985","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"歴戦の魔法戦士、スイートナイツの一人。"},{"spoiler":false,"text":"健気で心優しく、かつては戦いで傷つき変身出来なくなっていたこともあったが、今では主に支援系魔法面のエキスパートとして、後進の指導も行う。"},{"spoiler":false,"text":"普段はパティシエを務めながら、レムティアシータをサポートしている。"}],"source":"egs","sourceCharacterId":"985","sourceWorkId":"31509","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士スイートナイツの一人、スイートキッス。本名は柚木香那葉。"},{"spoiler":false,"text":"支援系魔法のエキスパートで、仲間たちを勝利に導くべく的確にサポートする。"},{"spoiler":false,"text":"戦いの傷に耐えられず、心が折れてしまったこともあったが、平和のために再び立ち上がった。優しくも強い女性。"},{"spoiler":false,"text":"普段はパティシエとして働いており、その腕前は若くして注目の的となっている。"}],"source":"egs","sourceCharacterId":"985","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"事故で家族を失っており、その寂しさと、彼女の ようになりたいという憧れから、七瀬凛々子を姉 のように慕っている。"},{"spoiler":false,"text":"壊れやすい硝子のような繊細な雰囲気を持ってい て、本来戦うことを好まないが、自分を変えたい と願い、懸命に健気に戦う。"},{"spoiler":false,"text":"天才的な料理の才能を持ち、その才能を認められ てこの学園に入学したが、自分自身に自信を持て ないでいる。一流のシェフを育成する芸術部料理 科に属している。"}],"source":"bangumi","sourceCharacterId":"96132"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/8333f255d509f24888bd1c6329867d638017430392bb9b7656df7f5cbb4cc4f8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1b/1ba67467ef13ffd8832f3e13d14785c595b8fe5819dea7dad15e22b5ea940481.webp","width":154,"height":256,"source":"static-detail"},"actors":[{"creditedName":"結城 ほのか","creatorId":"vndb:s6018","sourcePersonId":"vndb:s6018","canonicalEntityId":"vndb:s6018","name":"結城 ほのか","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:93949","source":"vndb"}]},{"characterId":"char_c33542","characterName":"彩姫 くるみ","sourceIds":{"bangumi":[{"characterId":"96151","match":"exact-normalized-name-in-linked-work","subjectId":"222234"}],"egsCharacterIds":["15750"],"vndbCharacterId":"c33542"},"originalCharacterName":"彩姫 くるみ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"source-only","source":"vndb","value":"a"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"source-only","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"魔法戦士レムティアシータ"},{"spoiler":false,"text":"私立白耀学園の生徒会執行部員にして白耀学園最強の魔法戦士。"},{"spoiler":false,"text":"昔その力をコントロールできず放出してしまい街を一時的に機能停止させた事から、その力を使う事を拒んでいた。"},{"spoiler":false,"text":"しかし学園執行部員の説得と協力により今では執行部が持つ切り札としての抑止力となる。"},{"spoiler":false,"text":"学園執行部員達を心から尊敬している。"}],"source":"egs","sourceCharacterId":"15750","sourceWorkId":"12050","spoiler":false},{"segments":[{"spoiler":false,"text":"国際教導学園・現代文学科に通う学生。"},{"spoiler":false,"text":"清楚な雰囲気、丁寧で優しげな物腰、黙っていても目立ってしまう端麗な容姿を持つ聡明な少女。"},{"spoiler":false,"text":"魔法戦士の存在を噂程度には知っていて、秘かに憧れを持っていた。"},{"spoiler":false,"text":"正義感や人の役に立ちたいという思いが強く、クイーンティアナに与えられた力と白薔薇の助力によって魔法戦士となる。"}],"source":"bangumi","sourceCharacterId":"96151"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e6/e66a3d7aeb9bc45d84e30aee81b2e3e1601ed43a2c62f32d4c2cf2ccd9009878.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0ab609ad9384029a7de08822ce5f629596553e24ed25d8e60f8ee430ce21a40b.webp","width":256,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c47589","characterName":"シンフォニックシュガー","sourceIds":{"bangumi":[{"characterId":"96141","match":"exact-normalized-name-in-linked-work","subjectId":"222233"}],"egsCharacterIds":["2314"],"vndbCharacterId":"c47589"},"originalCharacterName":"シンフォニックシュガー","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"AB"},"bust":{"reviewState":"source-only","source":"vndb","value":"76"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"普段は物静かな天才科学者。シンフォニックリリーに信頼以上の気持ちを寄せいている。"},{"spoiler":false,"text":"対ファルケ・シルヴァ抵抗組織『白薔薇』のメンバーとして莉々奈を奪回しようとエクセリウムで活動中。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"冷静沈着ながら敵対した相手には容赦のない攻撃をする。"},{"spoiler":false,"text":"今まで虚勢を張りながらも堕ちきらなかった彼女が心の支えのない中精神を疲労させていき姦計にはまっていく。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"19685","spoiler":false},{"segments":[{"spoiler":false,"text":"「私の声が聞こえたのなら、きっと莉々奈さんが私を呼んでくれたからです」"},{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"普段は物静かで冷静沈着な天才科学者。"},{"spoiler":false,"text":"莉々奈とは厚い信頼関係に結ばれており、理論・技術面から百合瀬財団の活動を支えている。"},{"spoiler":false,"text":"幼げな容姿に似合わない強靭な意思と折れない心を持つ。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士シンフォニックナイツ」ほか"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"天才的な頭脳を持つ世界的な科学者。"},{"spoiler":false,"text":"シンフォニックリリーとともに国際教導学園から身を引き、自らの魔法研究を進める傍ら魔法戦士として活動を続けている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"28226","spoiler":false},{"segments":[{"spoiler":false,"text":"歴戦の魔法戦士、シンフォニックナイツの一人。"},{"spoiler":false,"text":"物静かで冷静沈着、数々の魔法理論や技術を開発している天才科学者。"},{"spoiler":false,"text":"現在は異世界ロアにて研究活動を行っており、時折レムティアシータに技術的なアドバイスを与えている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"31509","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックナイツの一人、シンフォニックシュガー。本名は甘樹菜々芭。"},{"spoiler":false,"text":"優秀な技術者で、魔法戦士たちの新たな力をいくつも開発する。"},{"spoiler":false,"text":"国際教導学園で教師として働きながら、魔法技術の研究も怠らない。"},{"spoiler":false,"text":"シンフォニックリリーである百合瀬莉々奈とは深い絆で結ばれたパートナー。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックナイツの一人、シンフォニックシュガー。優秀な研究者、技術者として、魔法戦士たちの勝利を支えている。同じシンフォニックナイツの一人である莉々奈とは深い絆で結ばれており、彼女の経営する国際教導学園で教師としても働いている。"}],"source":"egs","sourceCharacterId":"2314","sourceWorkId":"40423","spoiler":false},{"segments":[{"spoiler":false,"text":"見た目は幼げな、物静かで無表情な天才技術者"},{"spoiler":false,"text":"集中し始めると周りのことが全く目に入らなくなる"},{"spoiler":false,"text":"その明晰な頭脳を巡って両親が争い、挙げ句二人ともが不慮の死を遂げたため、自分の持つ才能に嫌悪感すら持ってしまっていた。そのためか、感情の表現もうまくない。"},{"spoiler":false,"text":"莉々奈に出会ったことでその頭脳を人類のために役立てることに喜びと、両親への贖罪を見いだす。また、自分の力を役立てる道を見つけてくれた莉々奈に対し、信頼関係以上の感情を抱いている。"}],"source":"bangumi","sourceCharacterId":"96141"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/8609a430ae70cca7f0b6e759a667e02697a36c766f741c77a34be38ffd50cffc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/17/1712c987ff84caddb112cef83a5939ceff92a62c4c53b935d6c40b3f59bc9fff.webp","width":156,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c49543","characterName":"ココノ・アクア","sourceIds":{"bangumi":[{"characterId":"96134","match":"exact-normalized-name-in-linked-work","subjectId":"222229"},{"characterId":"96134","match":"exact-normalized-name-in-linked-work","subjectId":"222230"},{"characterId":"96134","match":"exact-normalized-name-in-linked-work","subjectId":"222233"},{"characterId":"96134","match":"exact-normalized-name-in-linked-work","subjectId":"222242"}],"egsCharacterIds":["989"],"vndbCharacterId":"c49543"},"originalCharacterName":"ココノ・アクア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公に忠実で、よく気のつく優秀な副官。"},{"spoiler":false,"text":"もとはスイートナイツと同じく正義を守る戦士だったが、"},{"spoiler":false,"text":"主人公に捕らえられ、調教されて、彼の従順な奴隷となった。"},{"spoiler":false,"text":"冷静な反面、一途で甲斐甲斐しい一面を持つ。"}],"source":"egs","sourceCharacterId":"989","sourceWorkId":"2055","spoiler":false},{"segments":[{"spoiler":false,"text":"流浪の身となっても、メッツァーに変わらぬ忠誠を誓っている。"},{"spoiler":false,"text":"むしろ、彼と二人きりの時間を多く過ごせる今の方が、"},{"spoiler":false,"text":"彼女にとっては幸せなのかもしれない。"}],"source":"egs","sourceCharacterId":"989","sourceWorkId":"3373","spoiler":false},{"segments":[{"spoiler":false,"text":"メッツァーの副官。"},{"spoiler":false,"text":"陰から日なたからメッツァーを助力する。"},{"spoiler":false,"text":"元女神近衛団アップルナイツの魔法戦士。"}],"source":"egs","sourceCharacterId":"989","sourceWorkId":"10418","spoiler":false},{"segments":[{"spoiler":false,"text":"メッツァーをサポートし続ける忠実な副官。"},{"spoiler":false,"text":"冷静、沈着にして有能、家事一般にも秀でる。"},{"spoiler":false,"text":"相変わらずメッツァーに対して一途な気持ちを持ち続けている。"}],"source":"egs","sourceCharacterId":"989","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"メッツアーの右腕にして愛らしい性奴隷。"},{"spoiler":false,"text":"メッツアーの初めての獲物でもある。"},{"spoiler":false,"text":"冷静で良く気が利き、全てをメッツァーに捧げる最高の副官。"}],"source":"egs","sourceCharacterId":"989","sourceWorkId":"18638","spoiler":false},{"segments":[{"spoiler":false,"text":"メッツァー・ハインケルの副官。"},{"spoiler":false,"text":"もともとは女神近衛団第二騎士団アップルナイツの副団長を務める魔法戦士であったが、メッツァーに捕獲された際に調教を受け、彼に忠実な下僕となり果てた。"},{"spoiler":false,"text":"メッツァーのことを心から愛しており、メッツァーもまた、ココノに対し副官以上の感情を抱いている。"},{"spoiler":false,"text":"メッツァーが封印された後、潜伏しながら封印を無効化する方法を探し続けていた。"}],"source":"egs","sourceCharacterId":"989","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公に忠実で、よく気のつく優秀な副官。 もとはスイートナイツと同じく正義を守る戦士だ ったが、主人公に捕らえられ、調教されて、彼の 従順な奴隷となった。"},{"spoiler":false,"text":"冷静な反面、一途で甲斐甲斐しい一面を持つ。"}],"source":"bangumi","sourceCharacterId":"96134"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e9404b24147e340d10c3aa39f48b8548dda57054ea61d61351247374858bc75.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9c/9ce0793bc2c5a49fba998b91f67873e5fb419327e1eb375fe3c9c16264b8cba8.webp","width":154,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c49836","characterName":"シンフォニックリリー","sourceIds":{"bangumi":[{"characterId":"96140","match":"exact-normalized-name-in-linked-work","subjectId":"200512"},{"characterId":"96140","match":"exact-normalized-name-in-linked-work","subjectId":"222233"},{"characterId":"96140","match":"exact-normalized-name-in-linked-work","subjectId":"222234"},{"characterId":"96140","match":"exact-normalized-name-in-linked-work","subjectId":"222242"}],"egsCharacterIds":["15746","16092"],"vndbCharacterId":"c49836"},"originalCharacterName":"シンフォニックリリー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"826"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"A"},"bust":{"reviewState":"source-only","source":"vndb","value":"87"},"height":{"reviewState":"no-conflict","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"聡明で頭がよく、清楚、純真で強い正義感を持つ。"},{"spoiler":false,"text":"世界有数の百合瀬財閥の令嬢だが、そういったことをひけらかすことのない控えめな性格。"},{"spoiler":false,"text":"しかし、自分の立場や出自が持つ重要性は十分自覚している。"},{"spoiler":false,"text":"人にはない“魔力”という力を自分が持ってしまったことを恐れ、 悩んでいたが、ある日、かつてメッツァーと戦ったスイートナイツの存在を知り、彼女たちのように自分の力を正義のために使って悪と戦うことを決意。"},{"spoiler":false,"text":"魔力を利用した強化変身システムの開発を財閥の研究部門に指示、 自ら被験者となって研究を主導し、同時に運用・管理・バックアップを行う機関「ミネルヴァ・ガード」を創設。"},{"spoiler":false,"text":"完成したシステムを自ら装備し、はびこる悪と戦うためにシンフォニックナイツとなった。"}],"source":"egs","sourceCharacterId":"15746","sourceWorkId":"8708","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックリリー"},{"spoiler":false,"text":"私立白耀魔法学園の生徒会長にして百合瀬財閥の頭取。"},{"spoiler":false,"text":"常に冷静な判断力と柔らかな人当たりで生徒からの信頼も厚い。"},{"spoiler":false,"text":"趣味は音楽鑑賞。"},{"spoiler":false,"text":"特に生徒会室では常にクラシックが流れている。"}],"source":"egs","sourceCharacterId":"15746","sourceWorkId":"12050","spoiler":false},{"segments":[{"spoiler":false,"text":"百合瀬財団当主として忙しい日々を送りながら、次世代の魔法戦士を育てるために、国際教導学園を買い取って魔法教育に力を入れている。"}],"source":"egs","sourceCharacterId":"15746","sourceWorkId":"26584","spoiler":false},{"segments":[{"spoiler":false,"text":"聡明、清楚、純真で強い正義感を持つ。"},{"spoiler":false,"text":"世界有数の百合瀬財閥の令嬢。"},{"spoiler":false,"text":"『魔法戦士シンフォニックナイツ』に登場するヒロイン。"},{"spoiler":false,"text":"今作ではファルケの毒牙にかかり、彼を支援する。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"10418","spoiler":false},{"segments":[{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"清純可憐な百合瀬財団の当主だったが、そのあまりにも正義に純粋な心を利用されて、ファルケに調教されてしまう。"},{"spoiler":false,"text":"現在はファルケの配下となって彼の野望のために活動中。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"11289","spoiler":false},{"segments":[{"spoiler":false,"text":"「あなたに身も心も翻弄されていた、以前の私とは違います」"},{"spoiler":false,"text":"シンフォニックナイツの一人。"},{"spoiler":false,"text":"清純可憐で聡明な、世界的財閥である百合瀬財団の当主。"},{"spoiler":false,"text":"ファルケに調教されて配下となっていたが、今は正義の心を取り戻して平和のために尽くしており、『ゲート計画』の危険性を見抜き、計画を阻止すべく行動している。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士シンフォニックナイツ」ほか"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"世界的財閥である百合瀬財団の当主。"},{"spoiler":false,"text":"様々な事情から国際教導学園の運営から退き、魔法戦士としての任務を全うするべく日々活動している。"},{"spoiler":false,"text":"現在は魔法犯罪者の大量脱走事件を追っている。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"28226","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士シンフォニックナイツの一人、シンフォニックリリー。本名は百合瀬莉々奈。"},{"spoiler":false,"text":"世界有数の規模を誇る百合瀬財団の総帥。国際教導学園の理事長でもある。"},{"spoiler":false,"text":"生まれ持ったカリスマ性、優れた知力、卓越した戦術眼で、魔法戦士の指揮官のようなポジションとして活躍している。"},{"spoiler":false,"text":"指揮だけでなく、自ら前線で戦うことも珍しくない。"},{"spoiler":false,"text":"財界や政界とのつながりもあり、魔法戦士が十全に活躍できるよう各界と様々な調整を行っている。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"世界有数の財閥である百合瀬財閥の総帥にして、魔法戦士シンフォニックナイツの一人、シンフォニックリリー。魔法戦士が多く集まる国際教導学園の理事長でもある。その卓越した能力とカリスマ性で、前線で戦いながら魔法戦士たちを指揮することも多い。財界や政界とのつながりもあり、魔法戦士の障害にならぬよう各界と様々な調整を行っている。最近、過去の調教の記憶を悪夢としてみるようになり、そのことで悩んでいる。"}],"source":"egs","sourceCharacterId":"16092","sourceWorkId":"40423","spoiler":false},{"segments":[{"spoiler":false,"text":"聡明で頭がよく、清楚、純真で強い正義感を持つ。"},{"spoiler":false,"text":"世界有数の百合瀬財閥の令嬢だが、そういったことをひけらかすことのない控えめな性格。"},{"spoiler":false,"text":"しかし、自分の立場や出自が持つ重要性は十分自覚している。"},{"spoiler":false,"text":"人にはない“魔力”という力を自分が持ってしまったことを恐れ、 悩んでいたが、ある日、かつてメッツァーと戦ったスイートナイツの存在を知り、彼女たちのように自分の力を正義のために使って悪と戦うことを決意。"},{"spoiler":false,"text":"魔力を利用した強化変身システムの開発を財閥の研究部門に指示、 自ら被験者となって研究を主導し、同時に運用・管理・バックアップを行う機関『ミネルヴァ・ガード』を創設。"},{"spoiler":false,"text":"完成したシステムを自ら装備し、はびこる悪と戦うためにシンフォニックナイツとなった。"}],"source":"bangumi","sourceCharacterId":"96140"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/265b82f2a42d6fc45d4e7fe1bfdd98cf7d11568ff4b703a4ff4ff08f76e8a55f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/968d921c14904fe34f7955a05b9572d701679c10f058cb86ad083c96446f3e0c.webp","width":156,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤邑 鈴香","creatorId":"vndb:s2309","sourcePersonId":"vndb:s2309","canonicalEntityId":"vndb:s2309","name":"藤邑鈴香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:93948","source":"vndb"}]},{"characterId":"char_c51666","characterName":"スイートパッション","sourceIds":{"bangumi":[{"characterId":"96138","match":"exact-normalized-name-in-linked-work","subjectId":"200512"}],"egsCharacterIds":["986"],"vndbCharacterId":"c51666"},"originalCharacterName":"スイートパッション","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"B"},"height":{"reviewState":"source-only","source":"vndb","value":"154"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"},"weight":{"reviewState":"source-only","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"小生意気で気の強い、第四のスイートナイツ。"},{"spoiler":false,"text":"抜群の身体能力で経験の浅さをカバーしている。"},{"spoiler":false,"text":"だがその分、心には隙があるようだ。"}],"source":"egs","sourceCharacterId":"986","sourceWorkId":"18638","spoiler":false},{"segments":[{"spoiler":false,"text":"「汚らわしい魔物なんかに好きにさせないんだから！」"},{"spoiler":false,"text":"スイートナイツの一人。"},{"spoiler":false,"text":"プライドが高く向う気の強い、小悪魔的雰囲気ながら、憧れていた先輩への想いを持ち続ける一途な面もある。"},{"spoiler":false,"text":"現在は高い身体能力を生かして諜報的な任務をこなしている。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士スイートナイツ」ほか"}],"source":"egs","sourceCharacterId":"986","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"歴戦の魔法戦士、スイートナイツの一人。 プライドが高く向う気の強い、小悪魔的雰囲気ながら、正義感に溢れる仲間想い。"},{"spoiler":false,"text":"高い身体能力を生かした格闘技術に長けており、スイートキッスとともに時々シータのもとを訪れて、シータに頼まれて戦闘面の訓練を行っている。"}],"source":"egs","sourceCharacterId":"986","sourceWorkId":"31509","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士スイートナイツの一人、スイートパッション。本名は宮守麻由希。"},{"spoiler":false,"text":"高い身体能力を活かした接近戦を得意とし、先陣を切って仲間たちの続く道を作る。"},{"spoiler":false,"text":"勝気な性格をしているが、優しく正義感に溢れている。"},{"spoiler":false,"text":"ジムでトレーナーとして働いている。"}],"source":"egs","sourceCharacterId":"986","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"スイートナイツ四番目の戦士。メッツァーが潜む学園の学生。"},{"spoiler":false,"text":"凛々子の一つ下で、香那葉と同級。"},{"spoiler":false,"text":"身体能力の高さや気の強さなど、戦士としての資質を全て備えている。"},{"spoiler":false,"text":"一人で戦うスイートリップを助けるため、"},{"spoiler":false,"text":"クイーングロリアが純粋な正義の心を持つ彼女に聖涙石の欠片を宿らせ、"},{"spoiler":false,"text":"魔法戦士に生まれ変わらせた。"},{"spoiler":false,"text":"プライドが高く、はっきりとものを言う。"},{"spoiler":false,"text":"自分のルックスやプロポーションに自信を持っていて、"},{"spoiler":false,"text":"男子の視線を浴び、ちやほやされることを当然と思っている小悪魔的美少女。"},{"spoiler":false,"text":"だが実は性的なことに関してはほとんど免疫が無い。"},{"spoiler":false,"text":"ただ一人戦い続けている凛々子を尊敬し、"},{"spoiler":false,"text":"戦えないでいる香那葉を蔑むような態度をとる。"}],"source":"bangumi","sourceCharacterId":"96138"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/aa/aa27aef812e86430ee6638e91d8b73a5ed2b68f738d3655a81e4a8167e434e2d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b4ef9d876ac526c544240eef078ae735a2da2ecaf1b0e88ed31d2fe2305d6cd1.webp","width":192,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c83230","characterName":"エメロードミスティ","sourceIds":{"bangumi":[{"characterId":"96170","match":"exact-normalized-name-in-linked-work","subjectId":"279307"},{"characterId":"96170","match":"exact-normalized-name-in-linked-work","subjectId":"421425"}],"egsCharacterIds":["21112"],"vndbCharacterId":"c83230"},"originalCharacterName":"エメロードミスティ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"74"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"hip":{"reviewState":"source-only","source":"vndb","value":"77"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"国際教導学園の生徒。"},{"spoiler":false,"text":"晴香のクラスに編入してきた季節外れの転校生。"},{"spoiler":false,"text":"その正体は、エメロードフィーネのEMEROADシステムを狙う諜報員。"},{"spoiler":false,"text":"引っ込み思案で人付き合いが苦手な性格の霞は、面倒見のいい晴香のペースに巻き込まれる形で、徐々に交流が深まっていく。"},{"spoiler":false,"text":"だがそれが、スパイとしての彼女を悩ませることになる。"},{"spoiler":false,"text":"物語の中で、ある出来事をきっかけに霞は自分自身の新しい可能性を手に入れる。"}],"source":"egs","sourceCharacterId":"21112","sourceWorkId":"27830","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士エメロードナイツの一人、エメロードミスティ。本名は黒宇霞。"},{"spoiler":false,"text":"接近戦を得意とするエメロードフィーネを、弓での遠距離攻撃でサポートするパートナー。"},{"spoiler":false,"text":"不幸な境遇に生きていたが、魔法戦士との間に紡がれた絆のおかげで、光の当たる場所へと歩み出すことができた。"},{"spoiler":false,"text":"晴香を敬愛しているため、キールに対しては色々と複雑な感情を抱いている。"}],"source":"egs","sourceCharacterId":"21112","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"国際教導学園の生徒。"},{"spoiler":false,"text":"晴香のクラスに編入してきた季節外れの転校生。"},{"spoiler":false,"text":"その正体は、エメロードフィーネのEMEROADシステムを狙う諜報員。"},{"spoiler":false,"text":"引っ込み思案で人付き合いが苦手な性格の霞は、"},{"spoiler":false,"text":"面倒見のいい晴香のペースに巻き込まれる形で、"},{"spoiler":false,"text":"徐々に交流が深まっていく。"},{"spoiler":false,"text":"だがそれが、スパイとしての彼女を悩ませることになる。"},{"spoiler":false,"text":"物語の中で、ある出来事をきっかけに霞は自分自身の新しい可能性を手に入れる。"},{"spoiler":false,"text":"「しかし、これは任務…… 出来損ないである私に与えられた…… 失敗するわけにはいかないのです……！」"}],"source":"bangumi","sourceCharacterId":"96170"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c1/c141f9b84725a66b42027e84da0e022d71acff4cd3c6578e0ff34b9ea6964d61.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/13/1336e73d07b7590d98a975884acde2d2718d36ad058982868e02211b5445c7d3.webp","width":256,"height":190,"source":"static-detail"},"actors":[{"creditedName":"榎津 まお","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:93943","source":"vndb"}]},{"characterId":"char_c83231","characterName":"イクシードアイリス","sourceIds":{"bangumi":[{"characterId":"96172","match":"exact-normalized-name-in-linked-work","subjectId":"271689"},{"characterId":"96172","match":"exact-normalized-name-in-linked-work","subjectId":"279307"},{"characterId":"96172","match":"exact-normalized-name-in-linked-work","subjectId":"421425"}],"egsCharacterIds":["21108"],"vndbCharacterId":"c83231"},"originalCharacterName":"イクシードアイリス","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"91"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"source-only","source":"vndb","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"国際教導学園の中でも特に優秀なエリート。"},{"spoiler":false,"text":"責任感が強く完璧主義で潔癖症。"},{"spoiler":false,"text":"エリートゆえの使命感が強く、正義とは秩序であり、強者により与えられるものだと考えており、それこそが全てを守る唯一の方法だと信じている。"}],"source":"egs","sourceCharacterId":"21108","sourceWorkId":"26584","spoiler":false},{"segments":[{"spoiler":false,"text":"国際教導学園の生徒。"},{"spoiler":false,"text":"イクシードナイツの一人、イクシードアイリス。"},{"spoiler":false,"text":"学業、実技ともに優秀で、将来を嘱望されている魔法科のエリート。"},{"spoiler":false,"text":"生徒会長でもある。"},{"spoiler":false,"text":"秩序を守ることが正義を実現する唯一の方法だと信じていたが。"},{"spoiler":false,"text":"様々な体験を通じて柔軟に考えるようになった。"}],"source":"egs","sourceCharacterId":"21108","sourceWorkId":"27830","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士イクシードナイツの一人、イクシードアイリス。本名は裁明寺紫鶴。"},{"spoiler":false,"text":"国際教導学園の学生の中でも特に優秀で、生徒会長を務めている。"},{"spoiler":false,"text":"完璧主義で潔癖症なところがあったが、様々な経験を経て最近は柔軟にものを考えるようになった。"},{"spoiler":false,"text":"魔法戦士の使命と巨大財団総帥の仕事を同時にこなす莉々奈をとても尊敬している。"}],"source":"egs","sourceCharacterId":"21108","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"国際教導学園の生徒。"},{"spoiler":false,"text":"イクシードナイツの一人、イクシードアイリス。"},{"spoiler":false,"text":"学業、実技ともに優秀で、将来を嘱望されている魔法科のエリート。"},{"spoiler":false,"text":"生徒会長でもある。"},{"spoiler":false,"text":"秩序を守ることが正義を実現する唯一の方法だと信じていたが。"},{"spoiler":false,"text":"様々な体験を通じて柔軟に考えるようになった。"},{"spoiler":false,"text":"「同じく、魔法戦士イクシードアイリスです。魔法戦士が来た以上、魔物たちの好きにはさせません。安心して避難してください。」"}],"source":"bangumi","sourceCharacterId":"96172"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39c176f570cc18f492c22cc2e9002b67ed2d594d0133ab4e5466e092d6596874.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b9/b90b03d366b515a0991c9a3d0ccc64cb5b51d78557ba4ed3d2eeb6c225198d11.webp","width":234,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桜 水季","creatorId":"vndb:s912","sourcePersonId":"vndb:s912","canonicalEntityId":"vndb:s912","name":"北村 彩","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:93947","source":"vndb"}]},{"characterId":"char_vndb_c125391","characterName":"甘樹 菜々芭","sourceIds":{"vndbCharacterId":"c125391"},"originalCharacterName":"甘樹 菜々芭","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"606"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"ab"},"bust":{"reviewState":"source-only","source":"vndb","value":"76"},"height":{"reviewState":"source-only","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"},"weight":{"reviewState":"source-only","source":"vndb","value":"39"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fb/fb447f2d258b4fd0e72b6b88b3586da31e099e18546563e1f703fedcec4354a9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/03/034aa8e326efc4ea8444ba02edb77235d3fffd38c861