NameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Vice president of the opposing brass band."}],"source":"vndb","sourceCharacterId":"c6592"},{"segments":[{"spoiler":false,"text":"円山ブラスバンド部の副部長。サックス担当。"},{"spoiler":false,"text":"ナルシストで芝居がかった言動が多く、恥ずかしいことを真顔で言ったりする。"},{"spoiler":false,"text":"また、可愛い女の子には目が無く「子猫ちゃん」と呼ぶ。"}],"source":"egs","sourceCharacterId":"13472","sourceWorkId":"7535","spoiler":false},{"segments":[{"spoiler":false,"text":"圆山学园管乐部副部长，担任萨克斯风手。"},{"spoiler":false,"text":"追求罗曼蒂克，学园女性杀手。"},{"spoiler":false,"text":"个性随和、自尊心强，对自己的演奏相当有自信。"},{"spoiler":false,"text":"在认识妙后对她一见钟情，之后皆以天使称呼她，让妙感到相当害羞。"}],"source":"bangumi","sourceCharacterId":"96535"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc4d6e475a5f8c556f407b42c9a71225130f22fb977f8b9b6431278b32cab8f1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f0bfb33985c1d508156445bdb7aba96f7d3fd68ed87e4ce8ef56a97123a0fa6b.webp","width":256,"height":251,"source":"static-detail"},"actors":[{"creditedName":"三木眞一郎","creatorId":"vndb:s252","sourcePersonId":"vndb:s252","canonicalEntityId":"vndb:s252","name":"三木眞一郎","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21757:96535:4101:1","source":"bangumi"}]},{"characterId":"char_c6593","characterName":"大河原 甚五郎","sourceIds":{"bangumi":[{"characterId":"96536","match":"exact-normalized-name-in-linked-work","subjectId":"21757"}],"egsCharacterIds":["13473"],"vndbCharacterId":"c6593"},"originalCharacterName":"大河原 甚五郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"円山ブラスバンド部の顧問であるが、高飛車な態度と陰湿な性格から誰からも嫌われている。"}],"source":"egs","sourceCharacterId":"13473","sourceWorkId":"7535","spoiler":false},{"segments":[{"spoiler":false,"text":"圆山学园管乐部顾问，行事态度高调，自以为是，连由贵都受不了他。"},{"spoiler":false,"text":"对赤城山管乐部相当有意见，为剥夺他们的练习场地不择手段。"}],"source":"bangumi","sourceCharacterId":"96536"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/16/166a18977546ac5f81f61307b8193f05edd8df8a3c35c8f64e1d12cf82245983.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7629bc36e7817ddc4034dca35321845cd940925d44b8533f875696d1b436372.webp","width":232,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一条和矢","creatorId":"vndb:s256","sourcePersonId":"vndb:s256","canonicalEntityId":"vndb:s256","name":"一条 和矢","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21757:96536:4612:1","source":"bangumi"}]},{"characterId":"char_c77336","characterName":"伊丹 杏子","sourceIds":{"bangumi":[{"characterId":"96533","match":"exact-normalized-name-in-linked-work","subjectId":"21757"}],"egsCharacterIds":["13475"],"vndbCharacterId":"c77336"},"originalCharacterName":"伊丹 杏子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"円山ブラスバンド部の部員。"},{"spoiler":false,"text":"須美が大好きで親友。明るく元気な少女。"}],"source":"egs","sourceCharacterId":"13475","sourceWorkId":"7535","spoiler":false},{"segments":[{"spoiler":false,"text":"円山ブラスバンド部の部員。"},{"spoiler":false,"text":"須美の親友。明るく元気な少女。本人曰く「好きなものは…須美です!」と須美に抱きつくなど、少々百合気味。しかしながら須美を大切に思う気持ちは本物で、イジメまがいの行為をする部員に対してハッキリと物申すなど、幾度となく須美を支えている。"}],"source":"bangumi","sourceCharacterId":"96533"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f870379f2f522aaabbe6780a3dd045f6567bdda1e4a0e62fb1797d4ed9159a5b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a92bedf23790b9a0c7ea94a5d8e715c4592cc5ae6049553c2a360d58bf4cb55a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"安田未央","creatorId":"vndb:s25","sourcePersonId":"vndb:s25","canonicalEntityId":"vndb:s25","name":"安田 未央","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:21757:96533:4957:1","source":"bangumi"}]},{"characterId":"char_c77337","characterName":"香住 純","sourceIds":{"bangumi":[{"characterId":"96532","match":"exact-normalized-name-in-linked-work","subjectId":"21757"}],"egsCharacterIds":["13476"],"vndbCharacterId":"c77337"},"originalCharacterName":"香住 純","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"本作の主人公。赤城山ブラスバンド部所属で、元はトランペット担当。"},{"spoiler":false,"text":"父親が有名アーティストとして世界中を飛び回っており、音楽に造詣が深い。"},{"spoiler":false,"text":"このことから、和音により部長兼指揮に任命されてしまう。"}],"source":"egs","sourceCharacterId":"13476","sourceWorkId":"7535","spoiler":false},{"segments":[{"spoiler":false,"text":"本作主人公，目前高二，赤城山学园管乐部部长，被和音要求担任指挥。独生子，父亲是有名的作曲家，在世界各地深造，通常家里只有他和母亲两个人住。指挥的才能优秀，拥有绝对音感，能准确判断音阶的差异。喜欢开健太郎的玩笑，经常对健太郎拳打脚踢。"}],"source":"bangumi","sourceCharacterId":"96532"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5a/5af9074577b3cb7ce8246d97ae559c8c3be7eeebec26e89dbf861301915feb83.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/41/4187ac12e0b46bb2eb22128540b2c0156b8b60023dfcb78d8d27ad09868bacb9.webp","width"