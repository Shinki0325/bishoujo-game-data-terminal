ityStatus":"source-native","relationId":"vndb:vn-staff:133246","source":"vndb"},{"creditedName":"Yugo Ichikawa","creatorId":"vndb:s11725","sourcePersonId":"vndb:s11725","canonicalEntityId":"vndb:s11725","name":"Yugo Ichikawa","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:133248","source":"vndb"},{"creditedName":"maimi","creatorId":"vndb:s14554","sourcePersonId":"vndb:s14554","canonicalEntityId":"vndb:s14554","name":"maimi","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:133249","source":"vndb"},{"creditedName":"雨音","creatorId":"vndb:s32714","sourcePersonId":"vndb:s32714","canonicalEntityId":"vndb:s32714","name":"雨音","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:133250","source":"vndb"},{"creditedName":"有限会社スタジオナレッジ","creatorId":"vndb:s44614","sourcePersonId":"vndb:s44614","canonicalEntityId":"vndb:s44614","name":"有限会社スタジオナレッジ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:133251","source":"vndb"}]},"cast":[{"characterId":"char_c54884","characterName":"ソフィア・アルディス・フェアグリン","sourceIds":{"bangumi":[{"characterId":"48691","match":"exact-normalized-name-in-linked-work","subjectId":"198435"}],"egsCharacterIds":["13695"],"vndbCharacterId":"c54884"},"originalCharacterName":"ソフィア・アルディス・フェアグリン","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"父親の薦めにより龍太郎が研究室を持つ大学に『研究助手兼非常勤臨時講師』として在籍する、純粋なエルフ族の女性。"},{"spoiler":false,"text":"種族的特徴により大人びた外見、成熟したプロポーションだが、中身はまだ十代そこそこの少女っぽい部分があり、世慣れてはいない。"},{"spoiler":false,"text":"父親同士の関係から拓真とは幼馴染であり、同時に唯一知っていた同年代の人間族の男。"},{"spoiler":false,"text":"将来は父親と同じくエルフ学の研究者となることを目指していて、《主人公の父》を補佐しつつ、自分も講義に参加して勉強に励んでいる。成績は非常に優秀。"},{"spoiler":false,"text":"性格は落ち着いていて穏やかだが、男女関係には潔癖なところが多分にあり、セックスは当然結婚してから子供をつくるため、キスは恋人同士でなければ絶対にダメ、という信念の持ち主。"},{"spoiler":false,"text":"拓真に対しては常に、余裕ある年上のお姉さんとして見られたい・"},{"spoiler":false,"text":"振る舞いたいと考えており、実際そういう態度が多いが、油断したときなどに子供っぽい部分を見せてしまう事もある。"},{"spoiler":false,"text":"料理・洗濯・掃除など家事全般は得意な方であり、苦にならない。"},{"spoiler":false,"text":"むしろ拓真や龍太郎の為に尽くせることに喜びを感じている。"},{"spoiler":false,"text":"最近では拓真の受験のための家庭教師もやっていて、同じ大学に通える日を心待ちにしている。"}],"source":"egs","sourceCharacterId":"13695","sourceWorkId":"24089","spoiler":false},{"segments":[{"spoiler":false,"text":"父親の薦めにより龍太郎が研究室を持つ大学に"},{"spoiler":false,"text":"『研究助手兼非常勤臨時講師』として在籍する、純粋なエルフ族の女性。"},{"spoiler":false,"text":"種族的特徴により大人びた外見、成熟したプロポーションだが、"},{"spoiler":false,"text":"中身はまだ十代そこそこの少女っぽい部分があり、世慣れてはいない。"},{"spoiler":false,"text":"父親同士の関係から拓真とは幼馴染であり、"},{"spoiler":false,"text":"同時に唯一知っていた同年代の人間族の男。"},{"spoiler":false,"text":"将来は父親と同じくエルフ学の研究者となることを目指していて、"},{"spoiler":false,"text":"《主人公の父》を補佐しつつ、自分も講義に参加して勉強に励んでいる。"},{"spoiler":false,"text":"成績は非常に優秀。"},{"spoiler":false,"text":"性格は落ち着いていて穏やかだが、"},{"spoiler":false,"text":"男女関係には潔癖なところが多分にあり、"},{"spoiler":false,"text":"セックスは当然結婚してから子供をつくるため、"},{"spoiler":false,"text":"キスは恋人同士でなければ絶対にダメ、という信念の持ち主。"},{"spoiler":false,"text":"拓真に対しては常に、余裕ある年上のお姉さんとして"},{"spoiler":false,"text":"見られたい・振る舞いたいと考えており、実際そういう態度が多いが、"},{"spoiler":false,"text":"油断したときなどに子供っぽい部分を見せてしまう事もある。"},{"spoiler":false,"text":"料理・洗濯・掃除など家事全般は得意な方であり、苦にならない。"},{"spoiler":false,"text":"むしろ拓真や龍太郎の為に尽くせることに喜びを感じている。"},{"spoiler":false,"text":"最近では拓真の受験のための家庭教師もやっていて、"},{"spoiler":false,"text":"同じ大学に通える日を心待ちにしている。"}],"source":"bangumi","sourceCharacterId":"48691"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/682998f1bde4bac915e9ebc1c490cfdd3d669e9c2d2c5e23c313f6e23d10608b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/44/448c827e62d9d2bbc5862eb88b28d6cf5ec67e8881aa347551488b3b62c5c628.webp","width":192,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎木実佳","creatorId":"vndb:s987","sourcePersonId":"vndb:s987","canonicalEntityId":"vndb:s987","name":"榎木 実佳","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:198435:48691:10026:1","source":"bangumi"}]},{"characterId":"char_c54885","characterName":"霧原 拓真","sourceIds":{"bangumi":[{"characterId":"94210","match":"exact-normalized-name-in-linked-work","subjectId":"198435"}],"egsCharacterIds":["13696"],"vndbCharacterId":"c54885"},"originalCharacterName":"霧原 拓真","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"エルフ学の権威を父に持つ、ごく普通の学生。"},{"spoiler":false,"text":"小さい頃からソフィアに憧れを抱いており、今では完全に恋愛感情に発展している。"},{"spoiler":false,"text":"美貌のエルフをずっと見続けてきたからか、人間族の女性とは付き合ったことが無く、好きになったこともない。"},{"spoiler":false,"text":"気が優しくやや奥手な性格のせいでソフィアに想いを伝えられないままだが、それは受験を成功させて彼女と同じ大学に合格してから、と決めている。"}],"source":"egs","sourceCharacterId":"13696","sourceWorkId":"24089","spoiler":false},{"segments":[{"spoiler":false,"text":"エルフ学の権威を父に持つ、ごく普通の学生。"},{"spoiler":false,"text":"小さい頃からソフィアに憧れを抱いており、今では完全に恋愛感情に発展している。"},{"spoiler":false,"text":"美貌のエルフをずっと見続けてきたためか、人間族の女性には興味を抱けない。"},{"spoiler":false,"text":"気が優しくやや奥手な性格のためソフィアに想いを伝えられないままだが、"},{"spoiler":false,"text":"それは受験を乗り越えて彼女と同じ大学に合格してから、と決めている。"}],"source":"bangumi","sourceCharacterId":"94210"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f43f56d9b0506310c64c1d0814dbde216461002cf2d51188f1a18f4ac4c380ec.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e921167488dc1a86a6b6b2bb2e9cbb2bcf07ea8a11cdd984037a46e6dac1c14.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c54886","characterName":"守野 史弥","sourceIds":{"bangumi":[{"characterId":"94211","match":"exact-normalized-name-in-linked-work","subjectId":"198435"}],"egsCharacterIds":["13698"],"vndbCharacterId":"c54886"},"originalCharacterName":"守野 史弥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"龍太郎のゼミに所属する学生。"},{"spoiler":false,"text":"ソフィアを口説き落として自分のものにしようと接近する男。"},{"spoiler":false,"text":"ゼミの中ではリーダー的ポジションであり、取り巻きの学生が男女問わず多い。"},{"spoiler":false,"text":"見かけは爽やか系の好青年。"},{"spoiler":false,"text":"女好きで常にその手の噂が絶えず、連れている女の子も移り変わりが激しいが、不思議と女性絡みのトラブルになったことはなく、龍太郎以外の教授たちから評判も良い。"},{"spoiler":false,"text":"だが裏の顔は……。"}],"source":"egs","sourceCharacterId":"13698","sourceWorkId":"24089","spoiler":false},{"segments":[{"spoiler":false,"text":"拓真の父・龍太郎のゼミに所属する学生。"},{"spoiler":false,"text":"ソフィアを口説いて自分のものにしようと接近する。"},{"spoiler":false,"text":"ゼミの中ではリーダー的ポジションであり、取り巻きの学生が男女問わず多い。"},{"spoiler":false,"text":"女好きで常にその手の噂が絶えず、連れている女性も移り変わりが激しいが、"},{"spoiler":false,"text":"不思議とトラブルになったことはなく、龍太郎以外の教授たちからも評判が良い。"},{"spoiler":false,"text":"しかし、裏の顔は……"}],"source":"bangumi","sourceCharacterId":"94211"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2e/2e2d605e2ed73ee74cef3730bbc052cfe8cdee491a2561e3c494e4b030a24fb2.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/32374b4aba435160b3fcb75b8e135e4eb95eccd497ad6ee0ce24d26f1f2f8aff.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c54887","characterName":"霧原 龍太郎","sourceIds":{"bangumi":[],"egsCharacterIds":["13697"],"vndbCharacterId":"c54887"},"originalCharacterName":"霧原 龍太郎","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"エルフ学の代表的研究者で、学会の主流派閥を築く権威。"},{"spoiler":false,"text":"性格は厳格で公平な人格者であり、息子と言えど拓真には親としての教育以上のことはせず、見守っている。"},{"spoiler":false,"text":"大学でも厳しい教授として知られているが、有名教授でもあるためその講義やゼミは常に人気で抽選方式になることも。"},{"spoiler":false,"text":"ソフィアについては、友人の一人娘ということで後見人としての責任感がとても強い。"},{"spoiler":false,"text":"そのため、彼女に言い寄る学生にはことのほか厳しく目を光らせている。"},{"spoiler":false,"text":"史弥については、彼の裏表のある性格や、要領の良さについて何となく察しているが、むしろ自分が教育者として導いてやらなくては、と考えている。"}],"source":"egs","sourceCharacterId":"13697","sourceWorkId":"24089","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1413","sourceCompanyId":"egs:brand:1023","canonicalEntityId":"vndb:p1413","name":"Black Lilith","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:24089:1023","source":"egs"},{"companyId":"vndb:p1413","sourceCompanyId":"vndb:p1413","canonicalEntityId":"vndb:p1413","name":"Black Lilith","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:54254:v19824","source":"vndb"},{"companyId":"vndb:p1413","sourceCompanyId":"vndb:p1413","canonicalEntityId":"vndb:p1413","name":"Black Lilith","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:54255:v19824","source":"vndb"}],"missingStates":[],"source":"terminal-wiki-full-runtime-v7"}}
