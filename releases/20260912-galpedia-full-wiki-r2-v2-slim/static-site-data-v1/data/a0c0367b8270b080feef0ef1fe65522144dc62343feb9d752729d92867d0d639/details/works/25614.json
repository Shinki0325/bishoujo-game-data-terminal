ersonId":"vndb:s31108","canonicalEntityId":"vndb:s31108","name":"じぐまる","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:142299","source":"vndb"},{"creditedName":"りこ子","creatorId":"vndb:s31110","sourcePersonId":"vndb:s31110","canonicalEntityId":"vndb:s31110","name":"りこ子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:142300","source":"vndb"},{"creditedName":"いちのすけ","creatorId":"vndb:s49608","sourcePersonId":"vndb:s49608","canonicalEntityId":"vndb:s49608","name":"いちのすけ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:142301","source":"vndb"},{"creditedName":"Bashi@めろん。","creatorId":"vndb:s55112","sourcePersonId":"vndb:s55112","canonicalEntityId":"vndb:s55112","name":"Bashi@めろん。","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:142302","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c63039","characterName":"綾瀬川 綾瀬","sourceIds":{"vndbCharacterId":"c63039"},"originalCharacterName":"綾瀬川 綾瀬","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"88"},"height":{"reviewState":"source-only","source":"vndb","value":"163"},"hip":{"reviewState":"source-only","source":"vndb","value":"86"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is a well-performing and well-behaved student council president and is a well-known local neighbor."},{"spoiler":false,"text":"She is a soloist who treats everyone indiscriminately, but who keeps a certain distance without exception. The only exception to her is the protagonist. No one knows her true intentions as to why she decided to start her \"playing her friends\".... At least for now."},{"spoiler":false,"text":"She looks perfect in everything she does, but she's vulnerable to unexpected events and improvisations. She occasionally shows her a pompous side. She loves reading, she has a deep knowledge of various cultures, and she has a wealth of subculture knowledge. Perhaps because of that, she sometimes says lines and phrases that she has read somewhere."},{"spoiler":false,"text":"\"It's okay to play-play' because we can't be real friends.\""}],"source":"vndb","sourceCharacterId":"c63039"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7e/7e1abed334abf41985983d7cd824cd3595e6b86150826d45ee2218665643a3d6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d30bc03020823fd19cf716db967f7f58ed70f68afcf8f9b2cb2bca81f8c0ef95.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小倉 結衣","creatorId":"vndb:s267","sourcePersonId":"vndb:s267","canonicalEntityId":"vndb:s267","name":"石原 愛依梨","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74914","source":"vndb"}]},{"characterId":"char_vndb_c63040","characterName":"遠野 希","sourceIds":{"vndbCharacterId":"c63040"},"originalCharacterName":"遠野 希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"69"},"height":{"reviewState":"source-only","source":"vndb","value":"145"},"hip":{"reviewState":"source-only","source":"vndb","value":"73"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A poor student who spends her days working part-time to pay for her scholarship. She is short but is a senior."},{"spoiler":false,"text":"She is often misunderstood as a cool person because of her quiet tone and her calm appearance. She is actually a very emotional ordinary girl who just can't express herself well."},{"spoiler":false,"text":"Her hobby is saving money, and it seems that her target amount of 1 million yen is just around the corner. Her favorite food is bread ears."},{"spoiler":false,"text":"She has both adultness and girlishness, and her dream for the future is a civil servant or a bride. She cares a little about her poorly growing body, especially her small breasts complex."},{"spoiler":false,"text":"Because of her innocent personality, she can't realize her love for the protagonist"},{"spoiler":false,"text":"\"... Bread ears, do you eat?\""}],"source":"vndb","sourceCharacterId":"c63040"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/536cc5b9ad10d712f7286648f9241782df6f7f0584cad38563e7ecf0bd54861e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc774c768f8cff1598fbcb8368c522ba61a60f4a896fda0724c77fea90235b79.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤森 ゆき奈","creatorId":"vndb:s280","sourcePersonId":"vndb:s280","canonicalEntityId":"vndb:s280","name":"藤森 ゆき奈","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74915","source":"vndb"}]},{"characterId":"char_vndb_c63041","characterName":"茶屋原 初音","sourceIds":{"vndbCharacterId":"c63041"},"originalCharacterName":"茶屋原 初音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"92"},"height":{"reviewState":"source-only","source":"vndb","value":"157"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A weak junior who has a habit of saying \"I'm sorry\" all the time. She always has a confident look on her face, hiding in the shadows her low self-esteem and insecurities."},{"spoiler":false,"text":"She is not good at communicating with others, and she becomes more prominent when dealing with the opposite sex. On the other hand, she can interact naturally with non-humans, especially small animals such as dogs and cats."},{"spoiler":false,"text":"She is the most common sense person and hard worker among the members full of individuality. She is mature and has a strong appetite that does not match her appearance,"},{"spoiler":false,"text":"The nutrition she takes in is reflected as a result of the least mature part of her body."},{"spoiler":false,"text":"She's still pretty sloppy."},{"spoiler":false,"text":"\"I'm sorry ... I'm sorry ...\""}],"source":"vndb","sourceCharacterId":"c63041"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26a29c92a95d1af0c33aad9cd14c9c8616b3f06cb2b3347c60b5836573d64e21.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f8/f8f426afe838e9396e3e34560627508146e524f54d3e08ee264f130470fcfc4c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐倉 江美","creatorId":"vndb:s896","sourcePersonId":"vndb:s896","canonicalEntityId":"vndb:s896","name":"永井 真衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74916","source":"vndb"}]},{"characterId":"char_vndb_c63042","characterName":"花小路 いろは","sourceIds":{"vndbCharacterId":"c63042"},"originalCharacterName":"花小路 いろは","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"83"},"height":{"reviewState":"source-only","source":"vndb","value":"159"},"hip":{"reviewState":"source-only","source":"vndb","value":"85"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A transfer student who has moved from the city, her father is the president of the large company The Hanakoji Group. She has no friends at all because of her sharp and intimidating gaze. She is currently living alone away from her parents' home because of her social studies."},{"spoiler":false,"text":"Iroha always suffers from prejudice because of her appearance, everyone thinks she is an arrogant, cold-hearted, spoiled, and manipulative person, but in reality, she is a good person; Once she breaks down, she starts making very hurtful and rude comments, she demonstrates her natural tsundere and deredere."},{"spoiler":false,"text":"She is a young lady, so she does a lot of things, She is apt to be tampered with because she has a lot of misguided words and deeds and her resistance to fanning is low. Her favorite convenience store lunch is Heaven Eleven's Marvo Bowl."},{"spoiler":false,"text":"\"It's a million light-years early for a fucking commoner like you to speak to me on an equal footing!\""}],"source":"vndb","sourceCharacterId":"c63042"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/08423fa5de07e845cc9677ebe92ea11f0e9a325b4ec0d065af546dc7af696c9a.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d643296e64c98688f3631d2d0abf13a2666e46b8e72f2b9456212c89df4c5442.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘 まお","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74917","source":"vndb"}]},{"characterId":"char_vndb_c63043","characterName":"山崎 弥","sourceIds":{"vndbCharacterId":"c63043"},"originalCharacterName":"山崎 弥","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"He looks and behaves more like a girl than any other girl, but he's a decent straight guy. The reason he is dressed as a woman is that \"this one looks better and is cute ☆\". Each of the gestures is rough, but I feel somehow intentional."},{"spoiler":false,"text":"He is always a mood maker with a bright and friendly personality. He looks like a free man, and in fact, he is the unsung hero who is more attentive than anyone else."},{"spoiler":false,"text":"He is aware that he is not very smart (an airhead), he is sometimes ridiculed because he takes the lead in buying his role, he even likes to accept it. On the other hand, he is not accustomed to being evaluated by others, and when he is praised, he is shy and flirting."},{"spoiler":false,"text":"He helps the girls to advance in their respective relationship with the protagonist"},{"spoiler":false,"text":"\"Let's get along with each other\""}],"source":"vndb","sourceCharacterId":"c63043"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbdc1cce7e7a9f67e2dbcf54dc0e4f048b7da2522020e001148e8aacea88cbbf.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a8168860f46d5604138a310f5d3837c2c5bed065ba772b2c8a9c5696f73c73ff.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"水野 七海","creatorId":"vndb:s2524","sourcePersonId":"vndb:s2524","canonicalEntityId":"vndb:s2524","name":"星野七海","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:74918","source":"vndb"}]},{"characterId":"char_vndb_c63044","characterName":"相葉 優人","sourceIds":{"vndbCharacterId":"c63044"},"originalCharacterName":"相葉 優人","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the story, for some reason he doesn't care about making friends, he is usually very cold and rude with his classmates, especially with the girls."},{"spoiler":false,"text":"\"Friends are overrated...\""}],"source":"vndb","sourceCharacterId":"c63044"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e36ff692e52e15beb18054632038883a8e5048d3f485fab7bf485881ea337677.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/98e0b12c3605d883b14c91015d4699a1b30b00e7896049255f62baac9ab81e14.webp","width":204,"height":256,"source":"static-detail"},"actors":[]}],"songs":[],"companies":[{"companyId":"egs:brand:5494","sourceCompanyId":"egs:brand:5494","canonicalEntityId":"egs:brand:5494","name":"Curefull Base","roleCodes":["brand"],"identityStatus":"ambiguous-shared-work-review","relationId":"egs:work-brand:25614:5494","source":"egs"},{"companyId":"vndb:p7037","sourceCompanyId":"vndb:p7037","canonicalEntityId":"vndb:p7037","name":"キュアフルベース","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:60015:v21537","source":"vndb"},{"companyId":"vndb:p7037","sourceCompanyId":"vndb:p7037","canonicalEntityId":"vndb:p7037","name":"キュアフルベース","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:60593:v21537","source":"vndb"},{"companyId":"vndb:p7037","sourc