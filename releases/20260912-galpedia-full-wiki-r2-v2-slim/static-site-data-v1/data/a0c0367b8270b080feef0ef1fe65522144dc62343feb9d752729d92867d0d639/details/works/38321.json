":"source-native","relationId":"vndb:vn-staff:174180","source":"vndb"},{"creditedName":"くろさわ 凛子","creatorId":"vndb:s9311","sourcePersonId":"vndb:s9311","canonicalEntityId":"vndb:s9311","name":"くろさわ 凛子","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:174183","source":"vndb"},{"creditedName":"くろさわ 凛子","creatorId":"vndb:s9311","sourcePersonId":"vndb:s9311","canonicalEntityId":"vndb:s9311","name":"くろさわ 凛子","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:174186","source":"vndb"},{"creditedName":"川名 唯","creatorId":"vndb:s9314","sourcePersonId":"vndb:s9314","canonicalEntityId":"vndb:s9314","name":"川名 唯","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:174187","source":"vndb"},{"creditedName":"高淤龍","creatorId":"vndb:s46711","sourcePersonId":"vndb:s46711","canonicalEntityId":"vndb:s46711","name":"高淤龍","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:174189","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c100652","characterName":"船野 呉一郎","sourceIds":{"vndbCharacterId":"c100652"},"originalCharacterName":"船野 呉一郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"202"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"188"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Your suspect."},{"spoiler":false,"text":"A hired servant who runs two abandoned inns on Ooejima, the Crescent Moon and the Yaegaki. He is in charge of taking care of the meals for the attendees, making the preparations for the memorial service and all rituals carried on the island. He leaves nothing undone and is often seen running around as he’s very busy. He is usually laid-back and the purity of his heart is such that even the island’s butterflies are fond of him."},{"spoiler":false,"text":"…For some reason, he only fears Oosaki."},{"spoiler":false,"text":"Translated from the official website."}],"source":"vndb","sourceCharacterId":"c100652"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/437b000948bbd7563d7a75fd5e4eeea96186217e6399c2dc2dc34ac1d998b673.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/aff35915e2add91667f8a78ea38ef1b4e25d4f793d1a756280b47907f35cab23.webp","width":256,"height":248,"source":"static-detail"},"actors":[{"creditedName":"久喜 大","creatorId":"vndb:s3829","sourcePersonId":"vndb:s3829","canonicalEntityId":"vndb:s3829","name":"久喜大","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87434","source":"vndb"}]},{"characterId":"char_vndb_c98652","characterName":"有明","sourceIds":{"vndbCharacterId":"c98652"},"originalCharacterName":"有明","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"25"},"birthday":{"reviewState":"source-only","source":"vndb","value":"707"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Your self-appointed assistant."},{"spoiler":false,"text":"Crematorium employee involved in the funeral of An Ooe. He’s extremely caring and cannot look away from those in trouble. Since breaking his dominant arm, he has been constantly helped by those around him and has become accustomed to saying ‘thank you’. He was saved by Oosaki when he was about to fall off the boat on the way to their destination, and they have gotten along ever since."},{"spoiler":false,"text":"Translated from the official website."},{"spoiler":true,"text":"Full name: Ariake Shoutarou / 有明勝太郎"}],"source":"vndb","sourceCharacterId":"c98652"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cc58fa5b00497568f798b42171824fc00c1b9d19b5346177674bdbfedfe6be9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fd/fd0f7c06bee9d6e8ad96b6ec302df9fbe646c3a133e6aa6b84493294ce4586fd.webp","width":254,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白上奏","creatorId":"vndb:s35616","sourcePersonId":"vndb:s35616","canonicalEntityId":"vndb:s35616","name":"白上奏","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87439","source":"vndb"}]},{"characterId":"char_vndb_c98653","characterName":"新橋","sourceIds":{"vndbCharacterId":"c98653"},"originalCharacterName":"新橋","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1111"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Your opponent."},{"spoiler":false,"text":"A stage playwright. He has a strange manner of talking, a combination of over-polite speech and venomous remarks, and always sets himself apart from the other attendees. He has a suspicious air about him, but wears elegant attire. Adjectives such as scrupulous and lofty suit him very well."},{"spoiler":false,"text":"He revered An Ooe as an actor, and her unfortunate death affected him as he had the intent of giving her the lead role in one of his plays."},{"spoiler":false,"text":"Translated from the official website."},{"spoiler":true,"text":"Full name: Shimbashi Mei / 新橋冥"}],"source":"vndb","sourceCharacterId":"c98653"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fc/fc4cb8d36f3bc77e10a2e387bedac406d6786b9b022243119432d05e7c08e203.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/0843bd45e49305c3b6b8ddddd72c9ef772e6189677f06c55914eb60612ebc06c.webp","width":256,"height":245,"source":"static-detail"},"actors":[{"creditedName":"皇 帝","creatorId":"vndb:s55","sourcePersonId":"vndb:s55","canonicalEntityId":"vndb:s55","name":"立花 慎之介","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87431","source":"vndb"}]},{"characterId":"char_vndb_c98654","characterName":"青海","sourceIds":{"vndbCharacterId":"c98654"},"originalCharacterName":"青海","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"28"},"birthday":{"reviewState":"source-only","source":"vndb","value":"909"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"177"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Your listener."},{"spoiler":false,"text":"A taciturn beauty who speaks in a small voice and makes use of short sentences. An inherent characteristic of his is being straightforward in every aspect of his life without making anyone uncomfortable. He teaches piano to a small number of people at the music school he runs."},{"spoiler":false,"text":"He also taught music to An Ooe. Has a successful career, but is reluctant to talk about his own achievements in life."},{"spoiler":false,"text":"Translated from the official website."},{"spoiler":true,"text":"Full name: Aomi Kaede / 青海楓"}],"source":"vndb","sourceCharacterId":"c98654"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ae/aefa4a37ba785e9299b4c95a3cd703c1acba57b9ea38e9b253187170ff497559.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad34511574dc842f34c68b466a2436c26f5b05cac4953102ced3afd4171c2564.webp","width":246,"height":256,"source":"static-detail"},"actors":[{"creditedName":"天野 晴","creatorId":"vndb:s547","sourcePersonId":"vndb:s547","canonicalEntityId":"vndb:s547","name":"田丸 篤志","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87433","source":"vndb"}]},{"characterId":"char_vndb_c98655","characterName":"日出","sourceIds":{"vndbCharacterId":"c98655"},"originalCharacterName":"日出","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"13"},"birthday":{"reviewState":"source-only","source":"vndb","value":"101"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"158"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Someone you have to protect."},{"spoiler":false,"text":"A boy who came on behalf of his mother. Has some sort of mental illness and cannot express himself clearly. Sometimes, his legs stop working all of a sudden. He weighs heavily on Oosaki’s mind. What’s more, he doesn’t even know what kind of person An Ooe was. He tends to be in low spirits when he thinks about life on the deserted island, which is being increasingly driven to extreme poverty, but he doesn’t blame anyone for it."},{"spoiler":false,"text":"Translated from the official website."},{"spoiler":true,"text":"Full name: Hinode Riichi / 日出理一"}],"source":"vndb","sourceCharacterId":"c98655"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5b/5bc04c13fc8a897b96b9b51aa1b4e520e50c3742bb73555769566a6deba93934.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/7322b49fdd46133fcddf6fdeab2bf5881d481c13dd6e407acabc6fce332f392d.webp","width":239,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c98656","characterName":"大崎","sourceIds":{"vndbCharacterId":"c98656"},"originalCharacterName":"大崎","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"22"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1010"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"181"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A young detective working for the Shinkiba Detective Agency. He’s a large man, six feet tall, and when people meet him for the first time they say he’s too blunt or unfriendly. He’s often thought of as unapproachable, but in reality he’s just a serious and quiet person."},{"spoiler":false,"text":"Due to them both having a similar appearance, he accepts a strange request to attend a funeral on behalf of his client, Daiba Shizuma."},{"spoiler":false,"text":"Translated from the official website."},{"spoiler":true,"text":"Full name: Shinkiba Hiiro / 新木場緋色"}],"source":"vndb","sourceCharacterId":"c98656"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1ebc3af94c92febd79ed82a4cbddb12443ae6e4445abdf286c2b8eb14c39323b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/86/86a55badbbd78d0f81288b22faaa3026660a48a97acc26a35ec48aa2f450beb0.webp","width":256,"height":240,"source":"static-detail"},"actors":[{"creditedName":"凛星凛","creatorId":"vndb:s36678","sourcePersonId":"vndb:s36678","canonicalEntityId":"vndb:s36678","name":"凛星凛","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87440","source":"vndb"}]},{"characterId":"char_vndb_c98657","characterName":"竹芝 葉蔵","sourceIds":{"vndbCharacterId":"c98657"},"originalCharacterName":"竹芝 葉蔵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"33"},"birthday":{"reviewState":"source-only","source":"vndb","value":"303"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"173"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Candidate for being your partner."},{"spoiler":false,"text":"A successful illusionist with a gentle Kansai accent. His ‘plain clothes’ consist of a white suit and red tie, so it could be said that he’s quite extravagant. He has a strong aversion to dampened moods and arguments. He’s that kind of mature friend who acts like a buffoon to liven things up when everyone is at each other’s throat. When he got to play a minor role in a film, he was approached by An Ooe and immediately fell in love with her."},{"spoiler":false,"text":"Translated from the official website ."},{"spoiler":true,"text":"Nicknakes: Yo-chan, Take-chan"}],"source":"vndb","sourceCharacterId":"c98657"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a9/a9816d73081e49ef44ebdd3acd837e20d7992aed7e5cb23d67bf99b22ddadbfc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cb/cb7af4a65585af0a5e543853623d1ebad363cfe10ba39bcbf86fd359772b8ed6.webp","width":256,"height":225,"source":"static-detail"},"actors":[{"creditedName":"桜花 大夫","creatorId":"vndb:s10199","sourcePersonId":"vndb:s10199","canonicalEntityId":"vndb:s10199","name":"岡田 悠","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:87437","source":"vndb"}]},{"characterId":"char_vndb_c98658","characterName":"豊洲","sourceIds":{"vndbCharacterId":"c98658"},"originalCharacterName":"豊洲","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"67"},"birthday":{"reviewState":"source-only","source":"vndb","value":"1212"},"bloodType":{"reviewState":"source-only","source":"vndb","value":"o"},"height":{"reviewState":"source-only","source":"vndb","value":"166"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Your Sabbath."},{"spoiler":false,"text":"Priest at Nisshuji, a small temple in Ibaraki. Affiliated with the True Pure Land sect of Buddhism. He is soft-spoken and his gestures are delicate. There is always a gentle air about him. He was invited to this memorial service as a monk, but has never interacted with the Ooe family so what ties him to the family remains unknown. He decided to come to the island in order to ascertain the true intentions of the event’s coordinator."},{"spoiler":false,"text":"Translated from the official website."},{"spoiler":true,"text":"Full name: Toyosu Rouren / 豊洲浪蓮"},{"spoiler":true,"text":"Real name: Ooe Rouren / 大江浪蓮"}],"source":"vndb","sourceCharac