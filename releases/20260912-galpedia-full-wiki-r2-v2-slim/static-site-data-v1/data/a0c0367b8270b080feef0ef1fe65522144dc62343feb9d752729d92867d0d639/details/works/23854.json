b"},{"creditedName":"濱田 智之","creatorId":"vndb:s5526","sourcePersonId":"vndb:s5526","canonicalEntityId":"vndb:s5526","name":"濱田 智之","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:131069","source":"vndb"},{"creditedName":"佐々木 恵梨","creatorId":"vndb:s6700","sourcePersonId":"vndb:s6700","canonicalEntityId":"vndb:s6700","name":"佐々木 恵梨","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:131070","source":"vndb"},{"creditedName":"松原 達也","creatorId":"vndb:s9047","sourcePersonId":"vndb:s9047","canonicalEntityId":"vndb:s9047","name":"松原 達也","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:131072","source":"vndb"},{"creditedName":"株式会社動画工房","creatorId":"vndb:s14820","sourcePersonId":"vndb:s14820","canonicalEntityId":"vndb:s14820","name":"株式会社動画工房","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:131073","source":"vndb"},{"creditedName":"水野 枝里子","creatorId":"vndb:s36627","sourcePersonId":"vndb:s36627","canonicalEntityId":"vndb:s36627","name":"水野 枝里子","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:131075","source":"vndb"}]},"cast":[{"characterId":"char_vndb_c48488","characterName":"アイラ","sourceIds":{"vndbCharacterId":"c48488"},"originalCharacterName":"アイラ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Isla is a female Giftia with twin-tails and has a childish appearance which causes those around her to feel the fleetingness of life. She is a veteran at the department Tsukasa works in and was also partnered with Kazuki in the past. After that, all she does is serve tea for her fellow co-workers. When Tsukasa arrives, she becomes his partner and goes back into the field again."},{"spoiler":false,"text":"She is extremely clumsy and retreating in personal life, but her true personality is revealed to be slightly childish, lively, fun loving and caring."},{"spoiler":true,"text":"It is revealed Isla only has 2000 hours left in her lifespan. It is also revealed that her retreating behavior is all because of her short remaining time span, and her bad experiences from the past, including breaking up with her initial partner, Kazuki. Throughout the series, her relationship with Tsukasa develops from partnership to friendship, and ultimately to love, which Isla greatly regrets, as she has very little time left, but thanks to their colleagues and friends, both Tsukasa and Isla are able to admit their true feelings to each other."},{"spoiler":false,"text":"From MyAnimeList"}],"source":"vndb","sourceCharacterId":"c48488"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea98f9ce7dc5e473b79c6d6d4229767130fbc44451261f8e01b339be0a31dbea.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/7380c49c3e684ccfd42c4dbed4ee89daaf20129757d9e972b294468868b89603.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"雨宮 天","creatorId":"vndb:s7409","sourcePersonId":"vndb:s7409","canonicalEntityId":"vndb:s7409","name":"雨宮 天","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:69663","source":"vndb"}]},{"characterId":"char_vndb_c48489","characterName":"水柿 ツカサ","sourceIds":{"vndbCharacterId":"c48489"},"originalCharacterName":"水柿 ツカサ","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"18"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"After failing his college entrance exams due to medical problems, he eventually gets a job through his father on Terminal Service One, although he initially does not know what they do. He is assigned as Isla's spotter and soon becomes attached to her, unaware that she is at the end of her lifespan. When he finally finds out, he refuses to abandon Isla and continues to be her partner. He has developed feelings for Isla ever since their first encounter, but only realizes it during their partnership."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c48489"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf9da2b0f377691fb6c5060aa0e0bdbaa558abbf2ae73a5a1b178c788a7f7977.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60a0523fe7884dcfc40e478c7956f4c972bf443adae82a94321fbb88bb68a8ae.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"内匠 靖明","creatorId":"vndb:s2364","sourcePersonId":"vndb:s2364","canonicalEntityId":"vndb:s2364","name":"内匠 靖明","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:69658","source":"vndb"}]},{"characterId":"char_vndb_c48490","characterName":"ザック","sourceIds":{"vndbCharacterId":"c48490"},"originalCharacterName":"ザック","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Giftia with the appearance of a high-class young boy. He is Michiru's marksman. He loves to tease people around him and reveal their innermost secrets."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c48490"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ff/ff25568e9ba5e952c818eafef7a047386d5c6528a871fb01314dee7fd1cefe20.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4f/4f68ae13fbdcc3ba6212b165dc4c88e686f02765747677a329d8d61d69f10a89.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"矢作 紗友里","creatorId":"vndb:s670","sourcePersonId":"vndb:s670","canonicalEntityId":"vndb:s670","name":"矢作紗友里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:69656","source":"vndb"}]},{"characterId":"char_vndb_c48491","characterName":"絹島 ミチル","sourceIds":{"vndbCharacterId":"c48491"},"originalCharacterName":"絹島 ミチル","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"age":{"reviewState":"source-only","source":"vndb","value":"17"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An employee who works at SAI Terminal Service One and is Tsukasa's superior by one year. She seems to be developing feelings for Tsukasa, but refuses to admit it. She was raised by a Giftia, so she empathizes with the \"android children\", people who were raised by Giftia or other androids. She had tried to protect her guardian from being retrieved, resulting in him becoming a \"Wanderer\", and he was later shot down by members of the private security firm R. Security, resulting in her longstanding hatred of them. This experience has since resulted in her joining Terminal Service One."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c48491"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1f151bd08d9380be07dc3591adf52ea12743bec165cb09f3bc40a3b2e0066bb9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e7355047a246d45260299af281b8bb6935ce74478630ac3857c54c4a01ddbd98.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"赤﨑 千夏","creatorId":"vndb:s6132","sourcePersonId":"vndb:s6132","canonicalEntityId":"vndb:s6132","name":"赤﨑千夏(赤崎千夏)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:69662","source":"vndb"}]},{"characterId":"char_vndb_c48492","characterName":"コンスタンス","sourceIds":{"vndbCharacterId":"c48492"},"originalCharacterName":"コンスタンス","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A Giftia who works at SAI Terminal Service One. He is Kazuki's current marksman and is known for his gentle personality."},{"spoiler":false,"text":"From Wikipedia"}],"source":"vndb","sourceCharacterId":"c48492"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/97/97cea5a4cf3be8e1ad161915240d94de9a7df0a201b05ff41c1a5af59ef7376c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c6/c6d352e5b62366e0d76194b3286a27bc6a08608cb2d85a89fb420034c74fbd74.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"日野 聡","creatorId":"vndb:s82","sourcePersonId":"vndb:s82","canonicalEntityId":"vndb:s82","name":"日野 聡","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:69654","source":"vndb"}]},{"characterId":"char_vndb_c48493","characterName":"桑乃実 カヅキ","sourceIds":{"vndbCharacterId":"c48493"},"originalCharacterName":"桑乃実 カヅキ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","