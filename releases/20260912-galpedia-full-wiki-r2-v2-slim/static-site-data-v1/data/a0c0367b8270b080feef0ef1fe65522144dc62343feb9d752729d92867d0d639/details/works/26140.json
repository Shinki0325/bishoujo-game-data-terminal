{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"26140","model":{"presentationWorkId":"vndb:v23302","staff":{"artwork":[{"creditedName":"天音蓮人","creatorId":"vndb:s15908","sourcePersonId":"egs:creator:31212","canonicalEntityId":"vndb:s15908","name":"天音蓮人","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:194106","source":"egs"},{"creditedName":"巽レイ","creatorId":"egs:creator:25388","sourcePersonId":"egs:creator:25388","canonicalEntityId":"egs:creator:25388","name":"巽レイ","roleCode":"artwork","roleLabel":"原画","identityStatus":"no-alias-hit","relationId":"egs:work-creator:194107","source":"egs"}],"scenario":[{"creditedName":"武藤FP","creatorId":"egs:creator:18191","sourcePersonId":"egs:creator:18191","canonicalEntityId":"egs:creator:18191","name":"武藤FP","roleCode":"scenario","roleLabel":"剧本","identityStatus":"no-alias-hit","relationId":"egs:work-creator:194108","source":"egs"},{"creditedName":"おむつ(妹尾睦月)","creatorId":"vndb:s9478","sourcePersonId":"egs:creator:13551","canonicalEntityId":"vndb:s9478","name":"おむつ(妹尾睦月)","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:194109","source":"egs"}],"music":[{"creditedName":"ぽれゆきお(セツゲン-1937)","creatorId":"egs:creator:20945","sourcePersonId":"egs:creator:20945","canonicalEntityId":"egs:creator:20945","name":"ぽれゆきお(セツゲン-1937)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"no-alias-hit","relationId":"egs:work-creator:194110","source":"egs"}],"other":[]},"cast":[{"characterId":"char_vndb_c111076","characterName":"浦島次郎","sourceIds":{"vndbCharacterId":"c111076"},"originalCharacterName":"浦島次郎","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The famous younger brother of Urashima Taro."},{"spoiler":false,"text":"Using the treasure brought back from Ryuuguu as political funds, he to climb to the top and become the governor of Kagawa prefecture."},{"spoiler":false,"text":"Hobbies include picking up girls, gastronomy, fishing, sightseeing, and wearing shiny things."},{"spoiler":false,"text":"He is a nouveau riche spender, but he is generous to everyone, so nobody can hate him."},{"spoiler":false,"text":"Since he has been in Ryuuguu for a long time, he isn't familiar with the geography of Shikoku, despite being the governor of Kagawa prefecture."},{"spoiler":false,"text":"He doubts that he can't even find Kagawa prefecture on a Japanese map."}],"source":"vndb","sourceCharacterId":"c111076"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/92f74b5cd9af7addc26f6b22d5f4badb886f6e3a2a9bd72e57e15d042678acb3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1096c927d2b019d8b1e925c6c053918ff18d9d80d98cdb3d2434d36da99399f.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c111077","characterName":"女木鬼姫","sourceIds":{"vndbCharacterId":"c111077"},"originalCharacterName":"女木鬼姫","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Loli Grandma (with big breasts) with Sanuki dialect."},{"spoiler":false,"text":"She was appointed as Vice Governor by Urashima Jirou just because she's cute."},{"spoiler":false,"text":"Born in the Oninashi district of Takamatsu city."},{"spoiler":false,"text":"There is a folklore that the demon was subdued by Momotaro in the Oninashi district, Megi is a descendant of the surviving demon."},{"spoiler":false,"text":"Contrary to her appearance, she seems to be over 200 years old."},{"spoiler":false,"text":"While advising to Urashima, who has no common sense, as a deputy governor, she is also an ambitious person aiming to unify Shikoku."},{"spoiler":false,"text":"Her main business is the chief priest of the \"Udon Temple\", and she always carries a huge rolling pin on her back."},{"spoiler":false,"text":"She makes Urashima eat Udon everyday, so Urashima is tired of it."},{"spoiler":false,"text":"Her hobby is eating, which she eats so much that she can be mistaken for a food fighter."},{"spoiler":false,"text":"Her taste in enjoying food is better than Urashima's and never loses to him, every food that looks yummy to her, there is always a reason for her to eat all of them."},{"spoiler":false,"text":"Her other hobbies include frugality, bonsai,etc and sightseeing."}],"source":"vndb","sourceCharacterId":"c111077"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c2/c2e34c151d05531f3f891e4146e465b7a84bd51d689abcbb3bb2ac0f6eecce3f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70bd454892df4263eb833ccfa7b38b85937c0824457a486d4bd5c90fd86ca4ca.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c111078","characterName":"阿波姫","sourceIds":{"vndbCharacterId":"c111078"},"originalCharacterName":"阿波姫","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A beautiful dancer who always attracts attention at Awa Odori Festival."},{"spoiler":false,"text":"However, she is not a member of any other group and has a mysterious atmosphere."},{"spoiler":false,"text":"The name Awa Hime is derived from the name of Tokushima during the Ritsuryo period, but of course it is not a real name."},{"spoiler":false,"text":"The real reason Awa Hime is her name, is just \"Queen of Soap\""}],"source":"vndb","sourceCharacterId":"c111078"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a1/a1923d99acca422b03899ffca87ab1f907a75b97cd84acb9fced2aeda5f0be87.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/14/14dd97ded5727a4160aab760bb648958309023f18632f177a6140ecaa26dabfd.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c111079","characterName":"ソフィ","sourceIds":{"vndbCharacterId":"c111079"},"originalCharacterName":"ソフィ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The daughter of the president of a paper manufacturing company called \"Otama's Charm\" in Ehime Prefecture."},{"spoiler":false,"text":"She lives without any inconvenience, so she's a little naive."},{"spoiler":false,"text":"However, one day, his father made a debt of 10 billion yen at the casino, and the family became desperate of financial situation."}],"source":"vndb","sourceCharacterId":"c111079"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e3/e31911b5194adb81fa1f12fe2f2ea1d1e7bdf688ec3381faec046234ecf40cb3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3c/3cdbabc7b5af92abd1d74cb99ceb3421ee579d8a35a9cf55f612d36a88038511.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c111080","characterName":"黒潮ゆず子","sourceIds":{"vndbCharacterId":"c111080"},"originalCharacterName":"黒潮ゆず子","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A signboard girl of a bonito shop in Kouchi city."},{"spoiler":false,"text":"She is a tall and cheerful beauty, and it seems that sales are visibly different on the day she stands in the store."},{"spoiler":false,"text":"Recently, due to the poor catch of tuna for bonito, she's worried that she have to decline orders from customers."}],"source":"vndb","sourceCharacterId":"c111080"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/af/afc22317e9bac4a44c0d9c62d6f43ed898a044c930dbc7a11f1eebc70a172674.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24103b29a7e621d28697b9732714e1c63bb5edccc66e71d3d7ae4efa1d4c72db.webp","width":218,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c111081","characterName":"荘内乙姫","sourceIds":{"vndbCharacterId":"c111081"},"originalCharacterName":"荘内乙姫","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"An erotic princess who welcomes people that comes to the Ryuuguu Castle."},{"spoiler":false,"text":"It seems that if you stay in Ryuuguu for a long time, you will be corrupted by the luxury and entertainment from her."},{"spoiler":false,"text":"Those who return to the ground will be handed a treasure according to the length of stay and Urashima's casket (in the story of Urashima Tarou)."}],"source":"vndb","sourceCharacterId":"c111081"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/05610a