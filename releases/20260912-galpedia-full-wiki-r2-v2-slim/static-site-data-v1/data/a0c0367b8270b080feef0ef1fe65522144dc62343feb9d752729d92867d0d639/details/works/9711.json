l":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49800","source":"vndb"},{"creditedName":"シロたん","creatorId":"vndb:s6016","sourcePersonId":"vndb:s6016","canonicalEntityId":"vndb:s6016","name":"シロたん","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49802","source":"vndb"},{"creditedName":"影花","creatorId":"vndb:s6488","sourcePersonId":"vndb:s6488","canonicalEntityId":"vndb:s6488","name":"影花","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49803","source":"vndb"},{"creditedName":"クロセンパイ","creatorId":"vndb:s43229","sourcePersonId":"vndb:s43229","canonicalEntityId":"vndb:s43229","name":"クロセンパイ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:49805","source":"vndb"}]},"cast":[{"characterId":"char_c18460","characterName":"須和 朱音","sourceIds":{"bangumi":[{"characterId":"34733","match":"exact-normalized-name-in-linked-work","subjectId":"142621"}],"egsCharacterIds":["19426"],"vndbCharacterId":"c18460"},"originalCharacterName":"須和 朱音","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"純情系「泣き虫」巫女。"},{"spoiler":false,"text":"唯一、主人公が守ってあげたいと思う泣き虫巫女。"},{"spoiler":false,"text":"主人公が苛めているというウワサも……。"},{"spoiler":false,"text":"「あ、朱音は……みんながおもっているほど……な、泣き虫ではありませんの…」"}],"source":"egs","sourceCharacterId":"19426","sourceWorkId":"9711","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公にとって、敵ばかりの学園内で唯一守ってあげたくなる、妹のような可愛らしい存在。生来の性格が災いしてか、呪文が失敗したりアイスを落とした程度で泣いてしまう。"},{"spoiler":false,"text":"「あ、朱音は…みんなが思っているほど……な、泣き虫ではありませんの」"},{"spoiler":false,"text":"「えと…し、失敗だって……時々しか、しませ……あれ……と、とき……」"},{"spoiler":false,"text":"「あの……と、時々し……か……えと……あの……くすん……えーん！」"}],"source":"bangumi","sourceCharacterId":"34733"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5c/5cb41f6df6196592e17ec866589079a66c3271d0a86ac5ec8303e0ba0471a318.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68e1a796fd585392188c824843332c760f652302a38bf0c4de63e595c0875b03.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上みゆ","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:142621:34733:6558:1","source":"bangumi"}]},{"characterId":"char_c18461","characterName":"伊瀬 麻祐奈","sourceIds":{"bangumi":[{"characterId":"34731","match":"exact-normalized-name-in-linked-work","subjectId":"142621"}],"egsCharacterIds":["19424"],"vndbCharacterId":"c18461"},"originalCharacterName":"伊瀬 麻祐奈","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"正統派「ツンデレ」巫女。"},{"spoiler":false,"text":"主人公を目の敵にするツンツン委員長。"},{"spoiler":false,"text":"最悪の出逢い方をするが……。"},{"spoiler":false,"text":"「そんなに巫女服がいいなら、巫女服に埋もれて一生を過ごしなさい！」"}],"source":"egs","sourceCharacterId":"19424","sourceWorkId":"9711","spoiler":false},{"segments":[{"spoiler":false,"text":"学園の委員長にして、主人公の学園生活最大の敵。 主人公との出会いが最悪だったためか、「変態」「巫女フェチ」等の噂を流し、主人公は変態扱いされることに。"},{"spoiler":false,"text":"「ただの巫女好きですって？…ああ、自分は変態ですって言いたいわけ？」"},{"spoiler":false,"text":"「巫女さんだったら誰でもいいっていうの？なんて節操ないのかしら！」"},{"spoiler":false,"text":"「そんなに巫女服がいいなら、巫女服に埋もれて一生を過ごしなさい！」"}],"source":"bangumi","sourceCharacterId":"34731"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/4e/4e15a88a0a9c671fe4bc142bae5b971a6b7e42af5057d5eb2dd323cc97e9c8e7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/76/76ef734a0852c55f8acc990bf72a8b05316d497c1340616fe3c4006c6998ebf8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"新堂真弓","creatorId":"vndb:s1427","sourcePersonId":"vndb:s1427","canonicalEntityId":"vndb:s1427","name":"新堂 真弓","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:142621:34731:6166:1","source":"bangumi"}]},{"characterId":"char_c18462","characterName":"亜蔦 玖良々","sourceIds":{"bangumi":[{"characterId":"34736","match":"exact-normalized-name-in-linked-work","subjectId":"142621"}],"egsCharacterIds":["19429"],"vndbCharacterId":"c18462"},"originalCharacterName":"亜蔦 玖良々","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"不思議系「天然」巫女。"},{"spoiler":false,"text":"自作のユル～い歌ばかり歌う、マイペース巫女。"},{"spoiler":false,"text":"「おちゃっぱ、ちゃぱちゃぱ、みどりいろ～。茶渋の黄ばみはとれないぞー」"}],"source":"egs","sourceCharacterId":"19429","sourceWorkId":"9711","spoiler":false},{"segments":[{"spoiler":false,"text":"自分で作った変な「ゆるい」歌ばかり歌っている不思議ちゃん。天然の性格ゆえか、学園の常識からも微妙にズレている。どんなときもマイペース。"},{"spoiler":false,"text":"「おちゃっぱ、ちゃぱちゃぱ、みどりいろ～。茶渋の黄ばみはとれないぞー」"},{"spoiler":false,"text":"「せんたく、ちゃぷちゃぷ、アワまみれ～。大きな桃もどんぶらこ～」"},{"spoiler":false,"text":"「まよらーきゅぴぴゅぴ、カロリー……あっ、鳥」"}],"source":"bangumi","sourceCharacterId":"34736"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/39/39762da496f942a2f581cad1923f11d6160dc3b75d5e9e5c667c9353814a598e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/adb9f18912f8addb764a1ae9dbe871c7913c6a4c155343e6b6e303cb92b3c4f6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"深田愛衣","creatorId":"vndb:s607","sourcePersonId":"vndb:s607","canonicalEntityId":"vndb:s607","name":"深田 愛衣","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:142621:34736:6509:1","source":"bangumi"}]},{"characterId":"char_c18463","characterName":"八酒 鈴葉","sourceIds":{"bangumi":[{"characterId":"34737","match":"exact-normalized-name-in-linked-work","subjectId":"142621"}],"egsCharacterIds":["19430"],"vndbCharacterId":"c18463"},"originalCharacterName":"八酒 鈴葉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"お嬢様系「おしとやか」巫女。"},{"spoiler":false,"text":"礼節のしっかりした上品な巫女。"},{"spoiler":false,"text":"ただ、とてつもない大食漢……。"},{"spoiler":false,"text":"「遅くまで勉強ご苦労様です。お夜食におにぎりをご用意しました」"}],"source":"egs","sourceCharacterId":"19430","sourceWorkId":"9711","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公を異端者扱いする学園で、先生を除けば唯一最初から邪魔者扱いしなかった巫女。主人公曰く、「彼女のような人格者こそ巫女にふさわしい」とのこと。一升飯をおかわりするような、見た目からは想像できないようなところも。"},{"spoiler":false,"text":"「遅くまでご苦労様です。お夜食におにぎりを用意しましたので、どうぞ」"},{"spoiler":false,"text":"「あの、わたくしもお夜食をご一緒させていただいてよろしいですか？」"},{"spoiler":false,"text":"「え？このトンカツはおやつですよ。カレーは飲み物じゃないですか」"}],"source":"bangumi","sourceCharacterId":"34737"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d7/d7a55e5abc153f9e20f625ecb39713c23ebd7bcd96ffc3c6821fc7327e9806d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/ed6790d18b7a13e40aa50ccc3a7789c41636cbe65a5c2049016614fa3a43d0a7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤邑鈴香","creatorId":"vndb:s2309","sourcePersonId":"vndb:s2309","canonicalEntityId":"vndb:s2309","name":"藤邑 鈴香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:142621:34737:16173:1","source":"bangumi"}]},{"characterId":"char_c18464","characterName":"羽沙 珠夏","sourceIds":{"bangumi":[{"characterId":"34732","match":"exact-normalized-name-in-linked-work","subjectId":"142621"}],"egsCharacterIds":["19425"],"vndbCharacterId":"c18464"},"originalCharacterName":"羽沙 珠夏","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"トラブル系「商売人」巫女。"},{"spoiler":false,"text":"金の亡者。困っている人を助けたら、平然とお金を要求する。"},{"spoiler":false,"text":"「いつもニコニコ現金払いでお願いしますねー」"}],"source":"egs","sourceCharacterId":"19425","sourceWorkId":"9711","spoiler":false},{"segments":[{"spoiler":false,"text":"儲け話が大好きで、金の匂いをかぎつけるのが天才的な巫女。 困っている人を見つけると、助ける代わりにお金を要求する。"},{"spoiler":false,"text":"「はーい、集金にきましたよん。いつもニコニコ現金払いでお願いしますねー」"},{"spoiler":false,"text":"「だめじゃん、ニュースを見なきゃ！ ほらっ、世の中の動きに乗り遅れるよ！」"},{"spoiler":false,"text":"「おおっ！なんでこの株動いてるん？ 完全に仕手系銘柄じゃん！」"}],"source":"bangumi","sourceCharacterId":"34732"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/02/02f1b87eb3210d2717dfd3a27d18b3dd28e758e73bd8ad2430c1646c541a0f7e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/32/3255890818a32f5ab35ccce56fa128097cb1b84a07fa39478e2510a8922a619d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"大野まりな","creatorId":"vndb:s1253","sourcePersonId":"vndb:s1253","canonicalEntityId":"vndb:s1253","name":"大野 まりな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:142621:34732:4434:1","source":"bangumi"}]},{"characterId":"char_c18465","characterName":"高天 和琴","sourceIds":{"bangumi":[{"characterId":"34734","match":"exact-normalized-name-in-linked-work","subjectId":"142621"}],"egsCharacterIds":["19427"],"vndbCharacterId":"c18465"},"originalCharacterName":"高天 和琴","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ミステリアス系「クール」巫女。"},{"spoiler":false,"text":"何を考えているのか分からない不思議巫女。"},{"spoiler":false,"text":"他の巫女とはちがう独特のオーラが出ている。"},{"spoiler":false,"text":"「知っておるか？　この箱は携帯電話といって、離れた相手と会話できるのじゃ」"}],"source":"egs","sourceCharacterId":"19427","sourceWorkId":"9711","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公曰く、正体不明の、妙な雰囲気で近寄りがたい、不思議な感じのする巫女。時々大ボケをかますなど、見かけによらないところも。"},{"spoiler":false,"text":"「知っておるか？この箱は携帯電話といって、離れた相手と会話できるのじゃ」"},{"spoiler":false,"text":"「ただし、アンテナが立たねば会話できんのだが、未だに立ったことはないらしい」"},{"spoiler":false,"text":"「ということで、まったくの役立たずというわけじゃな。うん、巫女だけにお払い箱じゃな」"}],"source":"bangumi","sourceCharacterId":"34734"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d3/d3b5598538cd164ec0d24462e2c2867056c4c8efef44496758f8e1c13daeb42c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e9/e94d1f34182ac42f4fab6d78549dc638ec3e5e239c2185d54b013e7d1fbec74c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"井上みゆ","creatorId":"vndb:s538","sourcePersonId":"vndb:s538","canonicalEntityId":"vndb:s538","name":"井上 みゆ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:142621:34734:6558:1","source":"bangumi"}]},{"characterId":"char_c18466","characterName":"南知 千莉","sourceIds":{"bangumi":[{"characterId":"34738","match":"exact-normalized-name-in-linked-work","subjectId":"142621"}],"egsCharacterIds":["19431"],"vndbCharacterId":"c18466"},"originalCharacterName":"南知 千莉","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ボーイッシュ系「さっぱり」巫女。"},{"spoiler":false,"text":"自分を「ボク」と呼ぶボクっ娘。"},{"spoiler":false,"text":"悪気のない、でも致命傷になるようなひとことをサラっと言う。"},{"spoiler":false,"text":"まさに「会心の一撃」娘。"},{"spoiler":false,"text":"「それだけ？　……それ以外に、なんか理由なんてあるの？」"}],"source":"egs","sourceCharacterId":"19431","sourceWorkId":"9711","spoiler":false},{"segments":[{"spoiler":false,"text":"自分のことを「ボク」と呼ぶ「ボクっ娘」。相手の心臓に突き刺さるような一言を、ポロっと漏らす悪い癖がある。本人に悪気はないため始末におえない。意図せずに発動し、一撃で相手を凹ませてしまう。"},{"spoiler":false,"text":"ついたあだ名が「会心の一撃娘」。"},{"spoiler":false,"text":"「なに？ボクが巫女さんになろうと思ったきっかけ？」"},{"spoiler":false,"text":"「そりゃ時給770円の割に、結構楽なバイトだったからだよ」"},{"spoiler":false,"text":"「それだけって？……それ以外になんか理由なんてある？」"}],"source":"bangumi","sourceCharacterId":"34738"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/607223b0ac40a8f028c3bd088e7e8f5dd08deb451d4a87143cf11c9b74c5b0e5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b7/b77cd4e808265147afe3195d260da4a8d9525e9b3d15cbb83629736ad7b763c3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"奥川久美子","creatorId":"vndb:s861","sourcePersonId":"vndb:s861","canonicalEntityId":"vndb:s861","name":"奥川 久美子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:142621:34738:22331:1","source":"bangumi"}]},{"characterId":"char_c18467","characterName":"櫛菜田 一颯","sourceIds":{"bangumi":[{"characterId":"34735","match":"exact-normalized-name-in-linked-work","subjectId":"142621"}],"egsCharacterIds":["19428"],"vndbCharacterId":"c18467"},"originalCharacterName":"櫛菜田 一颯","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"癒し系「おねえさん」巫女。"},{"spoiler":false,"text":"学園の教師兼巫女さん。包容力抜群でスキンシップ大好き。"},{"spoiler":false,"text":"もちろん主人公にも抱きついてくる。"},{"spoiler":false,"text":"「今からお勉強する呪文はとても危険です。失敗するとかなりアレなことになります"}],"source":"egs","sourceCharacterId":"19428","sourceWorkId":"9711","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公が通う学園の教師兼巫女。主人公曰く、彼が学園に入学できたのは、なんでも受け入れる彼女のおかげ。スキンシップが大好きで、学生に抱きついたり腕を組んだりしている。女生徒だけでなく、主人公にも抱きつく事も。"},{"spoiler":false,"text":"「今からお勉強する呪文はとても危険です。失敗するとかなりアレなことになります」"},{"spoiler":false,"text":"「ここはひとつ、成功することを願って、みんなで神様にお祈りをしましょう」"},{"spoiler":false,"text":"「はーい、そこも折ってください。ヘタするとみんなが死んじゃいますよー」"}],"source":"bangumi","sourceCharacterId":"34735"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/65777a30b1737015fa7c7c4f49f316a2e8d132687a70a22e3b7003bcf6b24bb4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8e/8e215b1edc011c28d5af9d78912ad83cb387f1458ad63aeb43eb1629a6cbadeb.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森山葵","creatorId":"vndb:s2926","sourcePersonId":"vndb:s2926","canonicalEntityId":"vndb:s2926","name":"森山 葵","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:142621:34735:22079:1","source":"bangumi"}]},{"characterId":"char_vndb_c18459","characterName":"賀往 修治","sourceIds":{"vndbCharacterId":"c18459"},"originalCharacterName":"賀往 修治","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Transfer student with a fetish for miko."}],"source":"vndb","sourceCharacterId":"c18459"}],"profileFacts":[],"metadataCandidateConflicts":{}