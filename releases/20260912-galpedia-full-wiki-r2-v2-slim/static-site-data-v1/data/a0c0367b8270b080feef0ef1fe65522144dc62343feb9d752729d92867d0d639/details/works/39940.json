{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"39940","model":{"presentationWorkId":"vndb:v61332","staff":{"artwork":[{"creditedName":"天坂隆志","creatorId":"vndb:s2005","sourcePersonId":"egs:creator:116","canonicalEntityId":"vndb:s2005","name":"天坂隆志","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:299779","source":"egs"},{"creditedName":"和真","creatorId":"vndb:s4682","sourcePersonId":"egs:creator:16132","canonicalEntityId":"vndb:s4682","name":"和真","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:299780","source":"egs"},{"creditedName":"兼臼たと","creatorId":"vndb:s4683","sourcePersonId":"egs:creator:21049","canonicalEntityId":"vndb:s4683","name":"兼臼たと","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:299781","source":"egs"}],"scenario":[{"creditedName":"sh@i","creatorId":"vndb:s4685","sourcePersonId":"egs:creator:21050","canonicalEntityId":"vndb:s4685","name":"sh@i","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:299782","source":"egs"},{"creditedName":"ジュウシロウ","creatorId":"vndb:s4687","sourcePersonId":"egs:creator:16131","canonicalEntityId":"vndb:s4687","name":"ジュウシロウ","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:299783","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c23383","characterName":"ユリナ","sourceIds":{"bangumi":[{"characterId":"32742","match":"exact-normalized-name-in-linked-work","subjectId":"114734"},{"characterId":"32742","match":"exact-normalized-name-in-linked-work","subjectId":"163121"},{"characterId":"32742","match":"exact-normalized-name-in-linked-work","subjectId":"616627"}],"egsCharacterIds":["5257","28344"],"vndbCharacterId":"c23383"},"originalCharacterName":"ユリナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"819"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"162"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"アルビオン国王位継承権第４７位のお姫様。"},{"spoiler":false,"text":"淑やかな物腰と優しい微笑を湛え、気品を兼ね備えているだけでなく、剣才の無さを戦略で補う知性を併せ持つ"},{"spoiler":false,"text":"賢剣才女。"},{"spoiler":false,"text":"身内の前では年相応な女の子であり、本質はイタズラっぽい性格。"},{"spoiler":false,"text":"子供の頃に主人公と出会い、それ以来ずっと淡い恋心を抱いている。"},{"spoiler":false,"text":"主人公と交わした『約束』を今なお大切にしている。"}],"source":"egs","sourceCharacterId":"5257","sourceWorkId":"20421","spoiler":false},{"segments":[{"spoiler":false,"text":"アルビオン国王位継承権第47位の王女。"},{"spoiler":false,"text":"大人びた淑やかな雰囲気と物腰、気品と優雅さを兼ね備えたお姫様。"},{"spoiler":false,"text":"剣才の無さを知略・戦略で補い戦う賢剣才女。"},{"spoiler":false,"text":"子供の頃にアキトと出会い、それ以来淡い恋心を抱いていた。"},{"spoiler":false,"text":"アキトと昔し交わした『約束』を今なお大切にしている。"},{"spoiler":false,"text":"自らの騎士団にアキトを勧誘し優勝を目指した大決闘祭では、仲間と共に見事優勝を果たした。"}],"source":"egs","sourceCharacterId":"5257","sourceWorkId":"22496","spoiler":false},{"segments":[{"spoiler":false,"text":"少し髪が伸び、体もより女性らしく、少女から大人の女性へと変わりつつあるアルビオン国王位継承権第３９位の王女。"},{"spoiler":false,"text":"皇族公務や学術研究などの成績を認められ継承権位が上がるなど才女としても成長中。"},{"spoiler":false,"text":"現在は公務の傍ら、学園長のお手伝い(という尻拭い)をさせられる日々で常に忙しい。"},{"spoiler":false,"text":"シルヴェリアの恋人であり従騎士になったアキトを陰ながらバックアップするなど“想い人への気持ち”を貫いている。"},{"spoiler":false,"text":"３年ぶりに帰ってきたアキトとシルヴェリアにテンションを上げつつ今回の騒動に巻き込まれていく。"}],"source":"egs","sourceCharacterId":"28344","sourceWorkId":"39940","spoiler":false},{"segments":[{"spoiler":false,"text":"アルビオン国 王位継承権第47位のお姫様。"},{"spoiler":false,"text":"淑やかな物腰と優しい微笑を湛え、気品を兼ね備えているだけでなく、剣才の無さを戦略で補う知性を併せ持つ賢剣才女。"},{"spoiler":false,"text":"普段は落ち着いた雰囲気だが、身内だけになると気取らず、年下の主人公をからかったりする。"},{"spoiler":false,"text":"子供の頃に主人公と出会い、それ以来ずっと淡い恋心を抱いている。"},{"spoiler":false,"text":"主人公と交わした “約束” を今なお大切にしている。"},{"spoiler":false,"text":"「頼りにしてるわよ…… 私のナイトくんっ♪」"}],"source":"bangumi","sourceCharacterId":"32742"}],"profileFacts":[{"label":"胸围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"28344","sourceWorkId":"39940","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"28344","sourceWorkId":"39940","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"87 cm","valueContext":null,"source":"egs","sourceCharacterId":"28344","sourceWorkId":"39940","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"28344","sourceWorkId":"39940","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d1/d1935d18380d3c09a9bd5e634da9306aa99c0dc69ca8cc30dd4af2950b8e0896.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/26/26640d60d008aad8686fbc93d06d881f400d695126c6764e31c26587756753ee.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"橘 まお","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:101981","source":"vndb"}]},{"characterId":"char_c23387","characterName":"シルヴェリア・レオディール","sourceIds":{"bangumi":[{"characterId":"32746","match":"exact-normalized-name-in-linked-work","subjectId":"114734"},{"characterId":"32746","match":"exact-normalized-name-in-linked-work","subjectId":"163121"},{"characterId":"32746","match":"exact-normalized-name-in-linked-work","subjectId":"616627"}],"egsCharacterIds":["5261","28343"],"vndbCharacterId":"c23387"},"originalCharacterName":"シルヴェリア・レオディール","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"902"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"95"},"height":{"reviewState":"no-conflict","source":"vndb","value":"172"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"89"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"55"}},"descriptions":[{"segments":[{"spoiler":false,"text":"代々有名な騎士を輩出してきた由緒ある騎士の家柄に生まれ育った少女。"},{"spoiler":false,"text":"学園では一度も負けたことがない程の圧倒的な実力を持つ“学園最強”の存在。"},{"spoiler":false,"text":"その強さだけでなく、誰にでも分け隔てなく接するところから周囲からもお姉様として敬われている。"},{"spoiler":false,"text":"クールで物静かな雰囲気に学生たちが敬遠し、友達と呼べるほど親しい人がいないことを悩んでいる。"},{"spoiler":false,"text":"自身は普通の女の子だと思っているが……少し世間とズレているところがある。"},{"spoiler":false,"text":"大決闘祭での優勝を目指すアキト達の、最大の敵となって立ちはだかる。"}],"source":"egs","sourceCharacterId":"5261","sourceWorkId":"20421","spoiler":false},{"segments":[{"spoiler":false,"text":"学園に入学してから一度も負けたことがない程の圧倒的な実力を持つ“学園最強”の騎士生……だったが、これまでの功績を評価され、学園で“教師”も兼任することになった。"},{"spoiler":false,"text":"強さだけでなく、クールな性格と優雅さを備えた騎士候補生憧れの存在。"},{"spoiler":false,"text":"アキトとの出会いによって初めての恋心を感じ、もっと距離を近づけたいと想いながらも不器用な性格からなかなかうまくいかないことに悩んでいる。"}],"source":"egs","sourceCharacterId":"5261","sourceWorkId":"22496","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公・近衛アキトと正式なお付き合いを始め恋人同士になった、元・学園最強の騎士の一人"},{"spoiler":false,"text":"アキトを従騎士に迎え“円卓の騎士・ランスロット”として学外へと活動の場を移し３年。"},{"spoiler":false,"text":"数々の戦いを経て“新鋭騎士”と呼ばれ、フェーダ界で注目を集めている。"},{"spoiler":false,"text":"実力と謙虚、礼節と気品、まさに現代騎士の肖像……と周囲の見方が変わりこそすれ、彼女自体は変わっておらず、いつも通りちょっと天然で頼れる優しいお姉さん。"},{"spoiler":false,"text":"恋人の影響で、以前よりも少しだけ(えっちに)積極的になり彼の望むことならできるだけシてあげたいと恋人への献身性がマシマシになっている。"}],"source":"egs","sourceCharacterId":"28343","sourceWorkId":"39940","spoiler":false},{"segments":[{"spoiler":false,"text":"代々有名な騎士を輩出してきた由緒ある騎士の家柄に生まれ育った少女。"},{"spoiler":false,"text":"誰にでも分け隔てなく接するため、周囲から “お姉様” と敬われている。"},{"spoiler":false,"text":"大決闘祭で優勝を目指すアキトたちの、最大の敵となって立ちはだかる。"},{"spoiler":false,"text":"クールで物静かな雰囲気のため敬遠されてしまい、友達と呼べるほど親しい者がいないことを悩んでいる。"},{"spoiler":false,"text":"自身は普通の女の子だと思っているが…… 少し世間とズレているところがある。"},{"spoiler":false,"text":"「私に気兼ねなく話しかけてくるのは、君くらいだよ」"}],"source":"bangumi","sourceCharacterId":"32746"}],"profileFacts":[{"label":"胸围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"28343","sourceWorkId":"39940","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"173 cm","valueContext":null,"source":"egs","sourceCharacterId":"28343","sourceWorkId":"39940","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"28343","sourceWorkId":"39940","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"28343","sourceWorkId":"39940","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/71/718c60dcbedca5e96e7cdbe5b42833edcd94d7ea95273e8d3e773720849e0c92.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f0/f07ae78f45dbb3744fefea48588f1545f7d7d945fb79d6e18860c3fe38381e9e.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"成瀬 未亜","creatorId":"vndb:s470","sourcePersonId":"vndb:s470","canonicalEntityId":"vndb:s470","name":"成瀬 未亜","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:101980","source":"vndb"}]},{"characterId":"char_c23388","characterName":"マリエル・エステリード","sourceIds":{"bangumi":[{"characterId":"32747","match":"exact-normalized-name-in-linked-work","subjectId":"114734"},{"characterId":"32747","match":"exact-normalized-name-in-linked-work","subjectId":"163121"},{"characterId":"32747","match":"exact-normalized-name-in-linked-work","subjectId":"616627"}],"egsCharacterIds":["5262","28346"],"vndbCharacterId":"c23388"},"originalCharacterName":"マリエル・エステリード","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"508"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"98"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ユリナが幼い頃から仕えているメイド。"},{"spoiler":false,"text":"いつも朗らかで笑顔を絶やさず、周囲に癒やしをもたらしてくれてみんなを見守ってくれるお姉さん的存在。"},{"spoiler":false,"text":"家事を完璧にこなす一方で、かつての騎士として名を馳せた実力者。"},{"spoiler":false,"text":"大の日本文化好きだが、日本語の言い回しをよく間違える。"},{"spoiler":false,"text":"ユリナから主人公のことを聞いていて、会う前から興味津々で、お世話をするようになってからも何かと気にかける。"}],"source":"egs","sourceCharacterId":"5262","sourceWorkId":"20421","spoiler":false},{"segments":[{"spoiler":false,"text":"いつもニコニコ笑顔の似合うメイドさん。"},{"spoiler":false,"text":"主人のユリナだけでなく、屋敷に住むみんなを癒してくれるお姉さん的存在。"},{"spoiler":false,"text":"あらゆることを知っていて、『困った時のマリエルさん』と呼ばれている。"},{"spoiler":false,"text":"大決闘祭ではユリナに頼まれてアキトの師匠となった。"},{"spoiler":false,"text":"かつてはアキトたちと同じ学園に通っていた学園生で、その頃は『鬼神』と恐れられていた。"},{"spoiler":false,"text":"シルヴェリア、みなもとはその頃からの知り合い。"},{"spoiler":false,"text":"大決闘祭後、学園の教師をすることになって、ちょっと緊張気味。"}],"source":"egs","sourceCharacterId":"5262","sourceWorkId":"22496","spoiler":false},{"segments":[{"spoiler":false,"text":"“メイドと言ったら彼女。彼女と言ったらメイド”と呼ばれるほどに認知されているユリナ付きの万能メイドさん。"},{"spoiler":false,"text":"学園での教師姿も見慣れたものとなり、騎士候補生に慕われるまでに。"},{"spoiler":false,"text":"メイドさんとして、いつも笑顔で朗らか、優しさの体現、でありながら騎士として、かつての豪名が色褪せない実力は保っている。"},{"spoiler":false,"text":"新しい目的と自分の楽しみのためにトゥアーリ・フェーダへの参加要請を受ける。"}],"source":"egs","sourceCharacterId":"28346","sourceWorkId":"39940","spoiler":false},{"segments":[{"spoiler":false,"text":"ユリナに幼い頃から仕えているメイド。"},{"spoiler":false,"text":"いつも朗らかで笑顔を絶やさず、周囲に癒しをもたらしみんなを見守ってくれるお姉さん的存在。"},{"spoiler":false,"text":"家事を完璧にこなす一方で、かつて騎士として名を馳せた実力者。"},{"spoiler":false,"text":"大の日本文化好きだが、日本語の言い回しをよく間違える。"},{"spoiler":false,"text":"ユリナから主人公のことを聞いており会う前から興味津々で、お世話をするようになってからも何かと気にかける。"},{"spoiler":false,"text":"「メイドに不可能なんてないですよ♪」"}],"source":"bangumi","sourceCharacterId":"32747"}],"profileFacts":[{"label":"胸围（本版本）","value":"98 cm","valueContext":null,"source":"egs","sourceCharacterId":"28346","sourceWorkId":"39940","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"28346","sourceWorkId":"39940","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"28346","sourceWorkId":"39940","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"28346","sourceWorkId":"39940","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24f19247aeb87e76d67da6815fcf177de3c44bb46ad9f2c34cd317692a20dd69.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/70d17bfc84e8d450b43ebfbb1445c67a13aff70aa86cd697200aef7af378b123.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"香澄 りょう","creatorId":"vndb:s29","sourcePersonId":"vndb:s29","canonicalEntityId":"vndb:s29","name":"高城 みつ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:101978","source":"vndb"}]},{"characterId":"char_c45319","characterName":"セルフィーネ・フローライト","sourceIds":{"bangumi":[{"characterId":"43887","match":"exact-normalized-name-in-linked-work","subjectId":"163121"},{"characterId":"43887","match":"exact-normalized-name-in-linked-work","subjectId":"616627"}],"egsCharacterIds":["9812","28345"],"vndbCharacterId":"c45319"},"originalCharacterName":"セルフィーネ・フローライト","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"501"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"96"},"height":{"reviewState":"no-conflict","source":"vndb","value":"169"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"}},"descriptions":[{"segments":[{"spoiler":false,"text":"世界に数少ない強力な剣『聖剣・ガラティーン』を所有しているフローライト家の少女。"},{"spoiler":false,"text":"円卓の騎士（ナイト・オブ・ガウェイン）に選ばれたのだが、未だ円卓騎士章の力を引き出せていない。"},{"spoiler":false,"text":"年齢はアキトよりも少し上。礼節と厳しさ、凛として凛々しい騎士を形にしたような性格。"},{"spoiler":false,"text":"大人の女性のように振る舞っているが、実際には頑固で負けず嫌いと、けっこう子供っぽい部分もある。"},{"spoiler":false,"text":"アーシェと幼馴染で、互いに認め合う友人同士。"}],"source":"egs","sourceCharacterId":"9812","sourceWorkId":"22496","spoiler":false},{"segments":[{"spoiler":false,"text":"世界に数少ない“聖剣(ガラティーン)”の所有者であり円卓の騎士（ナイト・オブ・ガウェイン）。"},{"spoiler":false,"text":"円卓の騎士としての公務の傍ら、教師として教える側に立つ。"},{"spoiler":false,"text":"３年が経ち、容姿もさらに大人の女性へと成長しているが、本人にその自覚はなく、礼儀・礼節、凛とした佇まいはそのままに彼女らしく、彼女のまま、日々を送っている。"},{"spoiler":false,"text":"ユリナ邸に居を移し、その間にユリナ＆マリエルの影響を受けたようで、ちょっと(？)趣味の方向性が変わったよう……。"},{"spoiler":false,"text":"今回のトゥアーリ・フェーダにはある目的で参加の要請を受ける。"}],"source":"egs","sourceCharacterId":"28345","sourceWorkId":"39940","spoiler":false},{"segments":[{"spoiler":false,"text":"“聖剣・ガラティーン” を所有しているフローライト家の少女。"},{"spoiler":false,"text":"円卓の騎士（ナイト・オブ・ガウェイン）に選ばれたのだが、未だ円卓騎士章の力を引き出せていない。"},{"spoiler":false,"text":"年齢はアキトよりも少し上。 礼節と厳しさ、凛とした騎士を形にしたような性格。"},{"spoiler":false,"text":"大人っぽく振る舞っているが、実際には頑固で負けず嫌いと、けっこう子供っぽい部分もある。"},{"spoiler":false,"text":"アーシェと幼なじみで、互いに認め合う友人同士。"},{"spoiler":false,"text":"【個別ストーリー】"}],"source":"bangumi","sourceCharacterId":"43887"}],"profileFacts":[{"label":"胸围（本版本）","value":"99 cm","valueContext":null,"source":"egs","sourceCharacterId":"28345","sourceWorkId":"39940","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"169 cm","valueContext":null,"source":"egs","sourceCharacterId":"28345","sourceWorkId":"39940","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"28345","sourceWorkId":"39940","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"66 cm","valueContext":null,"source":"egs","sourceCharacterId":"28345","sourceWorkId":"39940","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a3352fc2ec91bfb48d0b7ef43e4440ec37bf47605177bd78da05d0a881dd0189.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/64/647368bdf0397a69208b5f132096e0b5e44c38366a07ca97ccc1341145812ac6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"一色 ヒカル","creatorId":"vndb:s6","sourcePersonId":"vndb:s6","canonicalEntityId":"vndb:s6","name":"田中 涼子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:101977","source":"vndb"}]},{"characterId":"char_c57572","characterName":"ステラ・マリスディア","sourceIds":{"bangumi":[{"characterId":"89016","match":"exact-normalized-name-in-linked-work","subjectId":"616627"}],"egsCharacterIds":["28347"],"vndbCharacterId":"c57572"},"originalCharacterName":"ステラ・マリスディア","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect