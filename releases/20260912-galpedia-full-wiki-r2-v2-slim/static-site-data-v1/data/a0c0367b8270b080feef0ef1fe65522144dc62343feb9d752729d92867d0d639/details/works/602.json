{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"602","model":{"presentationWorkId":"vndb:v8370","staff":{"artwork":[{"creditedName":"かんの糖子","creatorId":"vndb:s9913","sourcePersonId":"egs:creator:553","canonicalEntityId":"vndb:s9913","name":"かんの糖子","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:1889","source":"egs"}],"scenario":[],"music":[{"creditedName":"くるがみ龍","creatorId":"vndb:s1621","sourcePersonId":"egs:creator:544","canonicalEntityId":"vndb:s1621","name":"くるがみ龍","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:15890","source":"egs"},{"creditedName":"森藤晶司","creatorId":"vndb:s6232","sourcePersonId":"egs:creator:3416","canonicalEntityId":"vndb:s6232","name":"森藤晶司","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:218164","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c78816","characterName":"織部 美樹","sourceIds":{"bangumi":[{"characterId":"152745","match":"exact-normalized-name-in-linked-work","subjectId":"144045"}],"egsCharacterIds":["27683"],"vndbCharacterId":"c78816"},"originalCharacterName":"織部 美樹","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"hip":{"reviewState":"source-only","source":"vndb","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"}},"descriptions":[{"segments":[{"spoiler":false,"text":"館の主人の娘。"},{"spoiler":false,"text":"幼い頃に母親と死別。その分父親に溺愛され、何不自由なく育つ。"},{"spoiler":false,"text":"引っ込み思案でやや人見知りな性格のため、学校での友だちはあまり多くないらしい。それだけに奈菜のことは親友だと思っている。"},{"spoiler":false,"text":"人見知りのわりには人恋しい面があるので、打ち解けさえすれば相手になつくようだ。"}],"source":"egs","sourceCharacterId":"27683","sourceWorkId":"602","spoiler":false},{"segments":[{"spoiler":false,"text":"館の主人の娘。B型魚座（2/19）。引っ込み思案で、同情心が厚く、何でも相手に合わせる大人しい性格。すこし甘えん坊の妹系キャラクター。母親とは幼い頃に死別しており、その分父親に溺愛され何不自由なく育つ。お嬢様系学校の生徒。引っ込み思案でやや人見知りする為、学校での友達はあまり多くない。それだけに、一緒に生活しているとも言える奈菜の事は、親友だと思っている。重義の居ないところではお互いに「ちゃん」付けで呼び合うようにさせている。人見知りする割には人恋しい所があるので、打ち解けさえすれば相手になつくようである。"}],"source":"bangumi","sourceCharacterId":"152745"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e141416b1985ac257d3fe9b03ec8e7c75904055248e44b80f387a4edb99fea1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/99/995c63354534ffc49c15bf9543a090842601dd5e6f9fc0023c8d59bed109fc93.webp","width":130,"height":229,"source":"static-detail"},"actors":[]},{"characterId":"char_c78817","characterName":"中元 奈菜","sourceIds":{"bangumi":[{"characterId":"152747","match":"exact-normalized-name-in-linked-work","subjectId":"144045"}],"egsCharacterIds":["27684"],"vndbCharacterId":"c78817"},"originalCharacterName":"中元 奈菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"館のメイド。"},{"spoiler":false,"text":"美樹の世話役として連れてこられたらしいが、本人は深く語らない。"},{"spoiler":false,"text":"何事にも一生懸命だがドジな元気娘。"},{"spoiler":false,"text":"身分の差にかかわらず自分を親友として扱う美樹に感謝し、彼女を大切に思っている。"}],"source":"egs","sourceCharacterId":"27684","sourceWorkId":"602","spoiler":false},{"segments":[{"spoiler":false,"text":"館のメイド。O型おひつじ座（3/29）。一生懸命で健気な性格だが、一目ぼれしがちでちょっとドジな所がある。美樹の世話役として連れてこられた。美樹と同じ学校へ通っている。美樹には重義の居ないところでは「ちゃん」付けで呼ぶように言われているので、そのようにしている。身分の差に関わらず、自分を「親友」として扱ってくれる美樹を、非常に有りがたく、また大切に思っている。性経験はない。"}],"source":"bangumi","sourceCharacterId":"152747"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3e/3e71c682b98a0cda605b1e11342db91747d07fee4c948d9c97b76d5479717149.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1d/1d9eb1c737484f608e90123166c365102cff5ea9d684f8daef8b6f0b72c80ce2.webp","width":140,"height":178,"source":"static-detail"},"actors":[]},{"characterId":"char_c78818","characterName":"逢瀬 遼子","sourceIds":{"bangumi":[{"characterId":"152746","match":"exact-normalized-name-in-linked-work","subjectId":"144045"}],"egsCharacterIds":["27685"],"vndbCharacterId":"c78818"},"originalCharacterName":"逢瀬 遼子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"館のメイド。"},{"spoiler":false,"text":"中学生のときに両親を交通事故で失い、重義の元に身請けされたらしい。重義を恩人、育ての親だという意識がある。"},{"spoiler":false,"text":"面倒見がよく、美樹と奈菜のお姉さん的立場。"},{"spoiler":false,"text":"両親を早くに亡くして愛に飢えていたのか、彼女たちには慈愛を注いでいるように見える。"}],"source":"egs","sourceCharacterId":"27685","sourceWorkId":"602","spoiler":false},{"segments":[{"spoiler":false,"text":"館のメイド。A型おうし座（4/28）。真面目で堅実、やさしく温和で思慮深く、ちょっと影は有るが周囲に安らぎを与えるお姉さん系キャラ。面倒見がよく、美樹と奈菜のお姉さん的立場にある。中学生の時に両親が交通事故で死んで、館の主人に身請けされる。重義とは性交済み。ただし、重義は恩人だという気持ちがある。両親を早くに亡くし、愛に飢えていたのかも知れない。それだけに、美樹や奈菜には慈愛を注いでいるのであろう。ちなみに、由佳の件は知っている。また由佳の自殺を救い、現在は重義には秘密で匿って看病している。誠が館へ来たことで、良心の呵責に迫られている。"}],"source":"bangumi","sourceCharacterId":"152746"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4e4745dc8b6788fc751ffecbee3e50b8c29adf18154c7cb335bbc49c50fe0a1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/db/dbe15504e7088f355e36eff9af47fcf69b21d9e67551476c00e406881070ff1c.webp","width":140,"height":215,"source":"static-detail"},"actors":[{"creditedName":"きみづか縁","creatorId":"vndb:s828","sourcePersonId":"vndb:s828","canonicalEntityId":"vndb:s828"