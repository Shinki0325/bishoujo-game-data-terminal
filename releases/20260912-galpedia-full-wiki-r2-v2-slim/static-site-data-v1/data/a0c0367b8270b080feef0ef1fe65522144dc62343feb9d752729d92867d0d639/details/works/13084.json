{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"13084","model":{"presentationWorkId":"vndb:v2701","staff":{"artwork":[{"creditedName":"にの子","creatorId":"vndb:s3300","sourcePersonId":"egs:creator:3794","canonicalEntityId":"vndb:s3300","name":"にの子","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:80779","source":"egs"}],"scenario":[{"creditedName":"沖水ミル","creatorId":"vndb:s4000","sourcePersonId":"egs:creator:4986","canonicalEntityId":"vndb:s4000","name":"沖水ミル","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:80780","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_c18875","characterName":"尾上 沙緒里","sourceIds":{"bangumi":[{"characterId":"199404","match":"exact-normalized-name-in-linked-work","subjectId":"224285"}],"egsCharacterIds":["14376"],"vndbCharacterId":"c18875"},"originalCharacterName":"尾上 沙緒里","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"102"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"J"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"95"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"63"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mother of Saki and Risa. She is a widow. She always likes to say \"oh my\". She is a calm and carefree woman who always smiles and goes at her own pace."},{"spoiler":false,"text":"Because she is calm and free-spirited, she has a lot of vulnerabilities. Her body exudes tremendous amounts of pheromones. The protagonist is almost forced to receive blood transfusions on numerous occasions. There is no doubt that Saki's big-breasted glamorous gene comes from her."},{"spoiler":false,"text":"In fact, she is quite scary when she gets angry, Saki is careful not to cross that critical point."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c18875"},{"segments":[{"spoiler":false,"text":"沙希の母親。未亡人。35歳。"},{"spoiler":false,"text":"物腰柔らかく、マイペースな女性。口癖は「あらあら」。"},{"spoiler":false,"text":"おっとりボケボケしているためか、隙が多く、その巨乳でグラマラスな肢体からとてつもないフェロモンを撒き散らし、知らぬ間に主人公を悩殺している。"},{"spoiler":false,"text":"いつも笑顔を絶やさないが、実は怒ると怖い。"}],"source":"egs","sourceCharacterId":"14376","sourceWorkId":"13084","spoiler":false},{"segments":[{"spoiler":false,"text":"沙希の母親。未亡人。口癖は「あらあら」。"},{"spoiler":false,"text":"マイペースでおっとりとした鷹揚な女性で、いつもニコニコしている。"},{"spoiler":false,"text":"おっとりボケボケしているため隙が多く、"},{"spoiler":false,"text":"とてつもなくフェロモンを撒き散らす肢体に、"},{"spoiler":false,"text":"主人公は幾度となく輸血を受けさせられそうになることも。"},{"spoiler":false,"text":"沙希の巨乳グラマラス遺伝子はこの人からきているであろうと"},{"spoiler":false,"text":"疑う余地もないほどの巨乳。"},{"spoiler":false,"text":"実は怒るとかなり怖いので、"},{"spoiler":false,"text":"沙希もその臨界点は越えないように注意している。"}],"source":"bangumi","sourceCharacterId":"199404"}],"profileFacts":[{"label":"年龄（本版本）","value":"35 岁","valueContext":null,"source":"egs","sourceCharacterId":"14376","sourceWorkId":"13084","sourceField":null,"scoped":true},{"label":"胸围（本版本）","value":"102 cm","valueContext":null,"source":"egs","sourceCharacterId":"14376","sourceWorkId":"13084","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"j","valueContext":null,"source":"egs","sourceCharacterId":"14376","sourceWorkId":"13084","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"14376","sourceWorkId":"13084","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"95 cm","valueContext":null,"source":"egs","sourceCharacterId":"14376","sourceWorkId":"13084","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"63 cm","valueContext":null,"source":"egs","sourceCharacterId":"14376","sourceWorkId":"13084","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"49 kg","valueContext":null,"source":"egs","sourceCharacterId":"14376","sourceWorkId":"13084","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/92/925fc2322134e492205867507179d3ce5451dd7b69229da4500b9e9c1863c067.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a7/a76376b532b888b8137332c76ce57c0b60bcda0d152770886d27d500ee175666.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"白井うさぎ","creatorId":"vndb:s3002","sourcePersonId":"vndb:s3002","canonicalEntityId":"vndb:s3002","name":"白井 うさぎ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224285:199404:26282:1","source":"bangumi"}]},{"characterId":"char_c18876","characterName":"尾上 沙希","sourceIds":{"bangumi":[{"characterId":"199403","match":"exact-normalized-name-in-linked-work","subjectId":"224285"}],"egsCharacterIds":["14375"],"vndbCharacterId":"c18876"},"originalCharacterName":"尾上 沙希","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"89"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"F"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"91"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"50"}},"descriptions":[{"segments":[{"spoiler":false,"text":"She is the eldest daughter of the Onoe family and is an active schoolgirl who attends an advanced school in Tokyo. She is a member of the swimming club and is a promising prospect for the club."},{"spoiler":false,"text":"She is good-looking and popular among both boys and girls at the school, but she has never been in a relationship with the opposite sex and is a virgin. She is also the chairperson of her class."},{"spoiler":false,"text":"She is an athletic girl with a very competitive side who puts her hands before her mouth. On the other hand, she is surprisingly girlish and hates men."},{"spoiler":false,"text":"She is a childhood friend of the main character, and as a child, she was fond of him. Saki, who is a manly girl, used to carry him around as her henchman."},{"spoiler":false,"text":"She seems to have an aversion to the protagonist, who is a housemate whom his mother has accepted on her own accord, despite their reunion after 10 years, She is always acting in an unfriendly manner."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c18876"},{"segments":[{"spoiler":false,"text":"静香と同じ、都内のエリート校に通う現役女子校生。"},{"spoiler":false,"text":"静香とは幼馴染で、ともすれば苛められやすい静香を守ってきた保護者的な面のある親友。"},{"spoiler":false,"text":"面倒見がよく、頼りがいのある女の子で、クラス委員を任されたりもする。"},{"spoiler":false,"text":"基本的に勝ち気で男勝り、空手の有段者でもあり、なかなか腕っぷしも強い。"},{"spoiler":false,"text":"その反面、意外に少女趣味で、可愛いものに目がなく、眼鏡を外した静香の可愛らしさにゾッコンLOVEな状態で、レズ的な妄想を膨らませるようになっているが、それをおくびにも出さない。"},{"spoiler":false,"text":"愛する（？）静香に近付いてきた主人公を排除しようとするが、逆に静香に巻き込まれるかたちで、静香のセックス体験に参加させられてしまう。"}],"source":"egs","sourceCharacterId":"14375","sourceWorkId":"11514","spoiler":false},{"segments":[{"spoiler":false,"text":"尾上家の長女で、都内の進学校に通う現役女子校生の少女。"},{"spoiler":false,"text":"学園では、水泳部に所属し、期待のホープとして注目を集めている。"},{"spoiler":false,"text":"その可愛らしい容姿から男女問わず人気はあるが、異性との交際は未だないらしい。"},{"spoiler":false,"text":"勝気で男勝り、口より先に手が出るような性格だが、クラス委員長を務めるなど頼りにされている。"},{"spoiler":false,"text":"意外に少女趣味で、男嫌いな面も。"},{"spoiler":false,"text":"また素直になれないツンなところがあり、10年ぶりに再会した主人公に対してもツレない態度をとってしまう。"}],"source":"egs","sourceCharacterId":"14375","sourceWorkId":"13084","spoiler":false},{"segments":[{"spoiler":false,"text":"尾上家の長女で、都内の進学校に通う現役女子校生の少女。"},{"spoiler":false,"text":"水泳部所属で、水泳部期待のホープ。"},{"spoiler":false,"text":"容姿もよく、学園では男女問わず人気があるが、"},{"spoiler":false,"text":"異性との交際経験はなく処女。"},{"spoiler":false,"text":"クラスの委員長を勤めたり、"},{"spoiler":false,"text":"スポーツ万能で口より先に手が出てしまう非常に勝気な面のある女の子。"},{"spoiler":false,"text":"その反面、意外と少女趣味で、男嫌いな側面がある。"},{"spoiler":false,"text":"主人公とは幼馴染で、子供の頃は主人公のことを、"},{"spoiler":false,"text":"男勝りな沙希がいつも子分として連れ歩いていた。"},{"spoiler":false,"text":"母親が勝手に受け入れた居候である主人公に対しては、"},{"spoiler":false,"text":"10年振りの再会にもかかわらず、嫌悪感を抱いているようで、"},{"spoiler":false,"text":"何かとツレない態度をとる。"}],"source":"bangumi","sourceCharacterId":"199403"}],"profileFacts":[{"label":"胸围（本版本）","value":"89 cm","valueContext":null,"source":"egs","sourceCharacterId":"14375","sourceWorkId":"13084","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"f","valueContext":null,"source":"egs","sourceCharacterId":"14375","sourceWorkId":"13084","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"14375","sourceWorkId":"13084","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"91 cm","valueContext":null,"source":"egs","sourceCharacterId":"14375","sourceWorkId":"13084","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"14375","sourceWorkId":"13084","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"50 kg","valueContext":null,"source":"egs","sourceCharacterId":"14375","sourceWorkId":"13084","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/cf/cf19980fd48f2b2d52616c4b24064c14b96b3ce890aee9ea747955bf7fe0cb66.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e4/e493199ee5216402b5a4bc48a5031682faaf2bbb804066478a1da6c308dfdde4.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"千早 美来","creatorId":"vndb:s8048","sourcePersonId":"vndb:s8048","canonicalEntityId":"vndb:s8048","name":"千早 美来","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:19907","source":"vndb"}]},{"characterId":"char_c18877","characterName":"尾上 璃沙","sourceIds":{"bangumi":[{"characterId":"199405","match":"exact-normalized-name-in-linked-work","subjectId":"224285"}],"egsCharacterIds":["14377"],"vndbCharacterId":"c18877"},"originalCharacterName":"尾上 璃沙","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"70"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"AAA"},"height":{"reviewState":"no-conflict","source":"vndb","value":"138"},"hip":{"reviewState":"source-only","source":"vndb","value":"68"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"52"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"40"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Second daughter of the Onoe family. She is Saki's younger sister. She is calmer than Saki. She is a mature and sophisticated girl with a mature way of thinking."},{"spoiler":false,"text":"She admonishes Saki with cold eyes for her impulsive nature and gives her a stern talking to. In reality, however, she is just a child with superficial knowledge."},{"spoiler":false,"text":"She has knowledge but no experience when it comes to actually dealing with things. When she actually responds to a situation, she may be a little nervous inside, even though she pretends to be calm."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c18877"},{"segments":[{"spoiler":false,"text":"尾上家の次女。沙希の妹。"},{"spoiler":false,"text":"性格はクールで、大人びた考え方をするマセた女の子。"},{"spoiler":false,"text":"直情的ですぐに噴火する姉を冷めた目で見ながら諫めたり、毒のある言葉で厳しく突っ込む。"},{"spoiler":false,"text":"知識はあっても経験はなく、基本的には耳年増。"},{"spoiler":false,"text":"冷静に装いつつも、内心はドキドキしていたりする。"}],"source":"egs","sourceCharacterId":"14377","sourceWorkId":"13084","spoiler":false},{"segments":[{"spoiler":false,"text":"尾上家の次女。沙希の妹。"},{"spoiler":false,"text":"性格的には、沙希より冷静でクール。"},{"spoiler":false,"text":"大人びた考え方をするマセた女の子。"},{"spoiler":false,"text":"直情的な沙希を冷たい目で見つつ諌めたり、厳しい突っ込みをする。"},{"spoiler":false,"text":"ただし、実際には歳相応に子供であり、単なる耳年増。"},{"spoiler":false,"text":"知識はあっても経験はなく、実際に物事に応じるときは、"},{"spoiler":false,"text":"冷静を装いつつも内心ではドキドキしている小心系だったりする。"}],"source":"bangumi","sourceCharacterId":"199405"}],"profileFacts":[{"label":"胸围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"14377","sourceWorkId":"13084","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"aaa","valueContext":null,"source":"egs","sourceCharacterId":"14377","sourceWorkId":"13084","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"138 cm","valueContext":null,"source":"egs","sourceCharacterId":"14377","sourceWorkId":"13084","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"68 cm","valueContext":null,"source":"egs","sourceCharacterId":"14377","sourceWorkId":"13084","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"14377","sourceWorkId":"13084","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"40 kg","valueContext":null,"source":"egs","sourceCharacterId":"14377","sourceWorkId":"13084","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/eab16e9068f2d4227874047a3d6e063e95fc753e316b20fc448d0eef409bbdd0.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/de/dee3f83e297381e6604e1d26d9a98eedab57ab6f957d81818cb06c4935731588.webp","width":128,"height":256,"source":"static-detail"},"actors":[{"creditedName":"加藤雅美","creatorId":"vndb:s656","sourcePersonId":"vndb:s656","canonicalEntityId":"vndb:s656","name":"加藤 雅美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224285:199405:13773:1","source":"bangumi"}]},{"characterId":"char_vndb_c18878","characterName":"高坂 新司","sourceIds":{"vndbCharacterId":"c18878"},"originalCharacterName":"高坂 新司","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"His parents transferred overseas. He is a high school sophomore who moves in with the Onoue family, where the story takes place."},{"spoiler":false,"text":"He used to live next door to the Onoue family, but moved out 10 years ago when his father was transferred. He used to be a frail, lazy boy, but he has grown up to be a manly man in proportion to his age."},{"spoiler":false,"text":"His personality is a male version of tsundere, honest but innocent at heart. He is often at odds with Saki, who is not so friendly to him after their reunion."},{"spoiler":false,"text":"He has had feelings for Saki since they were children, however, they sometimes have a harsh attitude towards each other because of their personalities."},{"spoiler":false,"text":"From official site"}],"source":"vndb","sourceCharacterId":"c18878"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p1574","sourceCompanyId":"egs:brand:2277","canonicalEntityId":"vndb:p1574","name":"萌雛","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:13084:2277","source":"egs"},{"companyId":"vndb:p381","sourceCompanyId":"vndb:p381","canonicalEntityId":"vndb:p381","name":"Hina Soft","roleCodes":["publisher"],"identityStatus":"source-nativ