icalEntityId":"vndb:s7565","name":"翠波 たかふみ","roleCode":"director","roleLabel":"导演","identityStatus":"source-native","relationId":"vndb:vn-staff:38418","source":"vndb"},{"creditedName":"翠波 たかふみ","creatorId":"vndb:s7565","sourcePersonId":"vndb:s7565","canonicalEntityId":"vndb:s7565","name":"翠波 たかふみ","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:38419","source":"vndb"},{"creditedName":"弐駆緒","creatorId":"vndb:s9050","sourcePersonId":"vndb:s9050","canonicalEntityId":"vndb:s9050","name":"にくしょ","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:38420","source":"vndb"}]},"cast":[{"characterId":"char_c69456","characterName":"市ノ瀬 遥","sourceIds":{"bangumi":[{"characterId":"61598","match":"exact-normalized-name-in-linked-work","subjectId":"240069"},{"characterId":"61598","match":"exact-normalized-name-in-linked-work","subjectId":"240070"}],"egsCharacterIds":["14582"],"vndbCharacterId":"c69456"},"originalCharacterName":"市ノ瀬 遥","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"D"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【変態兄を嫌う美乳の妹】"},{"spoiler":false,"text":"体型：引き締まったメリハリのある体型、Dカップ美乳。"},{"spoiler":false,"text":"主人公の妹で、コスプレ好きの兄を嫌悪している。水泳部所属。"},{"spoiler":false,"text":"その反面、学園で見せる恰好良くて辣腕を振るう兄は頼り甲斐があって好きなタイプ。"},{"spoiler":false,"text":"だが、自分に対しては変態的な本性しか見せない兄に対して苛立ちと嫌悪を抱いている。"},{"spoiler":false,"text":"ゲーム開始時は無自覚だが、精液の臭いや手触りで性的欲求のスイッチが入ってしまう性癖の持ち主で、顔射や口内射精、精液を飲み込むなどの行為でイってしまう。"},{"spoiler":false,"text":"「妹相手になにしてんのよっ!!　このバカっ！　変態兄貴っ!!」"}],"source":"egs","sourceCharacterId":"14582","sourceWorkId":"12934","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の妹で、コスプレ好きの兄を嫌悪している。その反面、学園で見せる恰好良くて辣腕を振るう兄は頼り甲斐があって好きなタイプ。"},{"spoiler":false,"text":"だが、自分に対しては変態的な本性しか見せない兄に対して苛立ちと嫌悪を抱いている。"},{"spoiler":false,"text":"水泳部に所属していて、かなり期待されている選手。"},{"spoiler":false,"text":"ゲーム開始時は無自覚だが、精液の臭いや手触りで性的欲求のスイッチが入ってしまう性癖の持ち主で、顔射や口内射精、精液を飲み込むなどの行為でイってしまう。"},{"spoiler":false,"text":"家事はあまり得意ではなく、食事当番の日はレトルトやインスタント中心のメニューが多い。"},{"spoiler":false,"text":"掃除は、不必要なものはどんどん捨てていくためゴミ屋敷にはならないものの、兄の趣味のグッズも容赦なく捨てるためタチが悪い。"},{"spoiler":false,"text":"「妹相手になにしてんのよっ!! このバカっ！変態兄貴っ!!」"}],"source":"bangumi","sourceCharacterId":"61598"}],"profileFacts":[{"label":"体型","source":"bangumi","sourceCharacterId":"61598","value":"引き締まったメリハリのある体型　Dカップ美乳"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ec/ecfd878262c977fce3c66c97c8ca219ab5cfb9b661bf7c3e1bfde1853673082b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e7/e717f8997397a02d92d3fa2e20d1c3619af595968cc6dedf96b947232c96b174.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:240069:61598:6106:1","source":"bangumi"},{"creditedName":"大久保藍子","creatorId":"vndb:s361","sourcePersonId":"vndb:s361","canonicalEntityId":"vndb:s361","name":"大久保 藍子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:240070:61598:5075:1","source":"bangumi"}]},{"characterId":"char_c69458","characterName":"文野 琴美","sourceIds":{"bangumi":[{"characterId":"61599","match":"exact-normalized-name-in-linked-work","subjectId":"240069"},{"characterId":"61599","match":"exact-normalized-name-in-linked-work","subjectId":"240070"}],"egsCharacterIds":["14583"],"vndbCharacterId":"c69458"},"originalCharacterName":"文野 琴美","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"【主人公に憧れる妹の親友】"},{"spoiler":false,"text":"体型：細身の整った体型、手のひらサイズ（Bくらい）の美乳。"},{"spoiler":false,"text":"遥の同級生で、親友。のんびりとした天然少女。"},{"spoiler":false,"text":"勝気な遥に振り回されている印象があるものの、何故か気が合うようでよく一緒にいる。"},{"spoiler":false,"text":"自分と違い、何でもテキパキと物事をこなす主人公に憧れを抱いており、それがほのかな恋心になっている。"},{"spoiler":false,"text":"料理部所属で、普段の性格からは想像できないほど料理上手で、両親のいない市ノ瀬家にたびたび差し入れを持ってきている。"},{"spoiler":false,"text":"「またお料理作ったら、おすそわけしますね」"}],"source":"egs","sourceCharacterId":"14583","sourceWorkId":"12934","spoiler":false},{"segments":[{"spoiler":false,"text":"遥の同級生で、親友。"},{"spoiler":false,"text":"のんびりとした天然少女で、勝気な遥に振り回されている印象があるものの、何故か気が合うようでよく一緒にいる。"},{"spoiler":false,"text":"自分と違い、何でもテキパキと物事をこなす完璧超人（に見える）主人公に憧れを抱いており、それがほのかな恋心になっている。"},{"spoiler":false,"text":"料理部所属で、普段の性格からは想像できないほど料理上手で、両親のいない市ノ瀬家にたびたび差し入れを持ってきている。"},{"spoiler":false,"text":"ツバメが雛にエサをやっている様子を見て、口移しが愛情表現の最高の形だと思い込んでいて、それ以来キスに妙な憧れを持っている。"},{"spoiler":false,"text":"「またお料理作ったら、おすそ分けしますね」"}],"source":"bangumi","sourceCharacterId":"61599"}],"profileFacts":[{"label":"体型","source":"bangumi","sourceCharacterId":"61599","value":"細身の整った体型／手のひらサイズの美乳"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/31/3102f0e6b19283477fb914f8172b0dc8f5f45a38755950d17d5ebd96a0d106d8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/24/24b7d360deb1e1fdd15833d5828c17df5e8859d5df67d1764ed2ac3341a5a57a.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"紬叶慧","creatorId":"vndb:s2920","sourcePersonId":"vndb:s2920","canonicalEntityId":"vndb:s2920","name":"紬 叶慧","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:240069:61599:25798:1","source":"bangumi"},{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEnt