:"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:33733","source":"vndb"}]},"cast":[{"characterId":"char_c23877","characterName":"戦場 法子","sourceIds":{"bangumi":[{"characterId":"178099","match":"exact-normalized-name-in-linked-work","subjectId":"224921"}],"egsCharacterIds":["14847"],"vndbCharacterId":"c23877"},"originalCharacterName":"戦場 法子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"o"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"72"},"height":{"reviewState":"no-conflict","source":"vndb","value":"147"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"75"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が赴任した診療所のある村に住む村娘。"},{"spoiler":false,"text":"天真爛漫で、いつも明るく元気な女の子。基本的に頭で考えるよりも先に身体が動くタイプ。人見知りもせず、主人公にも気さく（馴れ馴れしく？）に話しかけてくる。"},{"spoiler":false,"text":"大人しい那織とはまったく性格が違うものの、仲が良く、いつも一緒にいる。"},{"spoiler":false,"text":"最近、女らしい体つきになってきた那織に劣等感を持ち始めた"},{"spoiler":false,"text":"「私の診察を受ければ胸が大きくなる」と主人公にそそのかされ……。"}],"source":"egs","sourceCharacterId":"14847","sourceWorkId":"12825","spoiler":false},{"segments":[{"spoiler":false,"text":"村で主人公が一番初めに出会う女の子。いつも元気いっぱいで野山を駆け回っている。"},{"spoiler":false,"text":"大人しい那織とはまったく性格が違うが、なぜか馬が合い、一緒に居ることが多い。"},{"spoiler":false,"text":"（というより、法子が那織を○引に連れまわしているようだが）最近、体形が女らしくなってきた那織に対して劣等感を持っている。"},{"spoiler":false,"text":"基本的に頭で考えるよりも体が先に動くタイプ。"},{"spoiler":false,"text":"人見知りをまったくしない子で、そこを主人公につけこまれ「私の診察を受ければ胸が大きくなる」という言葉に誑かされてしまう。"}],"source":"bangumi","sourceCharacterId":"178099"}],"profileFacts":[{"label":"胸围（本版本）","value":"72 cm","valueContext":null,"source":"egs","sourceCharacterId":"14847","sourceWorkId":"12825","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"147 cm","valueContext":null,"source":"egs","sourceCharacterId":"14847","sourceWorkId":"12825","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"75 cm","valueContext":null,"source":"egs","sourceCharacterId":"14847","sourceWorkId":"12825","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"14847","sourceWorkId":"12825","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"38 kg","valueContext":null,"source":"egs","sourceCharacterId":"14847","sourceWorkId":"12825","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a3/a37135bcb13ef539132f69755bb0fe12f0f7ed75285eec9bb50a0057557ecf10.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad769ddacbbda752793c52eec021c10cb19594e87ce44995c1941942a27940a8.webp","width":87,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:224921:178099:5890:1","source":"bangumi"}]},{"characterId":"char_c23878","characterName":"星弓 那織","sourceIds":{"bangumi":[{"characterId":"178100","match":"exact-normalized-name-in-linked-work","subjectId":"224921"}],"egsCharacterIds":["14848"],"vndbCharacterId":"c23878"},"originalCharacterName":"星弓 那織","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"ab"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"153"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"80"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"58"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"44"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公が赴任した診療所のある村に住む村娘。"},{"spoiler":false,"text":"法子とは対照的に物静かで大人しい女の子。本当は室内で本を読むなどして静かに過ごすことが好きなのだが、活発な法子に外に連れ出され、望まないアウトドアライフを送っている。"},{"spoiler":false,"text":"最近、胸の大きく膨らんで、女性らしい体格になってきた。"},{"spoiler":false,"text":"若い男性に対して極度の上がり症のため、ほとんど喋ることができない。その性格を改善しようと主人公に相談するが……。"}],"source":"egs","sourceCharacterId":"14848","sourceWorkId":"12825","spoiler":false},{"segments":[{"spoiler":false,"text":"村で主人公が出会う女の子。"},{"spoiler":false,"text":"本人は室内で本を読んだりして過ごすのが好きなのだが、活発な法子に引っ張られる形でいつも一緒にいることが多い。"},{"spoiler":false,"text":"若い男性に対して極度のあがり症で、殆どしゃべる事ができない。"},{"spoiler":false,"text":"そんな性格を少しでも改善しようと、主人公に協力してもらい改善しようと努力する。"},{"spoiler":false,"text":"法子に比べてグラマーな体格。"},{"spoiler":false,"text":"主人公にあがり症克服の治療の一環として、様々な場所での露出を要求されることになる。"}],"source":"bangumi","sourceCharacterId":"178100"}],"profileFacts":[{"label":"胸围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"14848","sourceWorkId":"12825","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"153 cm","valueContext":null,"source":"egs","sourceCharacterId":"14848","sourceWorkId":"12825","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"14848","sourceWorkId":"12825","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"14848","sourceWorkId":"12825","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"44 kg","valueContext":null,"source":"egs","sourceCharacterId":"14848","sourceWorkId":"12825","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/37/37d9b6ab07cc55b8a0aa3f240e7b2f504bc563516