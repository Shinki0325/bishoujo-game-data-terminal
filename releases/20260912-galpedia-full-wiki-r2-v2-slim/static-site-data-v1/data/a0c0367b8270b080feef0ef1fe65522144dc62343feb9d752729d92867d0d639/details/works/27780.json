d":"129222","match":"exact-normalized-name-in-linked-work","subjectId":"279276"}],"egsCharacterIds":["20989"],"vndbCharacterId":"c83316"},"originalCharacterName":"ノエイン","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ビアンカの双子の妹で、出生時に里子に出され、旅芸人の一座で働いていた。"},{"spoiler":false,"text":"一座の解散後は、ひとりで旅をしていたが、ビアンカが魔王たちの手に落ちたことで、天使ラファエルによって拘束され、新たな聖女となる。"},{"spoiler":false,"text":"本来は明るく元気で異種族にも偏見がない少女だったが、天使ラファエルにより、唯一神の教えに忠実で、自分の欲望に忠実、魔族を忌み嫌う、という別人格を設定されて、それに心を上書きされてしまい、わがままなお姫様となっている。"},{"spoiler":false,"text":"『神の子』を受胎したビアンカには劣るが、ほぼ万能で強大な魔法の力を備えているために、誰も逆らうことができない。"}],"source":"egs","sourceCharacterId":"20989","sourceWorkId":"27780","spoiler":false},{"segments":[{"spoiler":false,"text":"ビアンカとは双子の妹。"},{"spoiler":false,"text":"生まれて直ぐに『双子の聖女は凶』との言い伝えにより殺害される所だったが、とある地方の部族に匿われる事となった。"},{"spoiler":false,"text":"ノエインとは異なり聖女としての教育は受けていないが、神の子の器としての能力は見た目同様ビアンカと同じ。"},{"spoiler":false,"text":"「シェイラァ」と呼ばれる少女を引き連れている。"},{"spoiler":false,"text":"ビアンカとは異なり、ノエインは『天使』に犯され天使の子を生み続ける事となっていく。"}],"source":"bangumi","sourceCharacterId":"129222"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/5d/5dab72d31272f02dc19dc2b461ddcc4c74bdf153285f73cf029e3ce7f39529c8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/dc/dc2f37f602471f2bd0277770d86278b4db821d55dcd1a2ecf85db6892db9240d.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"計名 さや香","creatorId":"vndb:s859","sourcePersonId":"vndb:s859","canonicalEntityId":"vndb:s859","name":"かずなさやか(計名さや香)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:81005","source":"vndb"}]},{"characterId":"char_vndb_c134197","characterName":"タルタロス","sourceIds":{"vn