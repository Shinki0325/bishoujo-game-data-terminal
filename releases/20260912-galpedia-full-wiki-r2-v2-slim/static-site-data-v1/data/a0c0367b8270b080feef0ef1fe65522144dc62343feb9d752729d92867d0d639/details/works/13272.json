{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"13272","model":{"presentationWorkId":"vndb:v3404","staff":{"artwork":[{"creditedName":"さくやついたち(サクヤ、さくや朔日)","creatorId":"vndb:s2800","sourcePersonId":"egs:creator:1294","canonicalEntityId":"vndb:s2800","name":"さくやついたち(サクヤ、さくや朔日)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:84849","source":"egs"}],"scenario":[{"creditedName":"なつみかんさい","creatorId":"vndb:s2974","sourcePersonId":"egs:creator:10367","canonicalEntityId":"vndb:s2974","name":"なつみかんさい","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:85168","source":"egs"},{"creditedName":"庵乃音人","creatorId":"vndb:s595","sourcePersonId":"egs:creator:2143","canonicalEntityId":"vndb:s595","name":"庵乃音人","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:85169","source":"egs"}],"music":[{"creditedName":"Corey&Carter","creatorId":"vndb:s2994","sourcePersonId":"egs:creator:5071","canonicalEntityId":"vndb:s2994","name":"Corey&Carter","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:112118","source":"egs"}],"other":[]},"cast":[{"characterId":"char_c27921","characterName":"門倉 心乃","sourceIds":{"bangumi":[{"characterId":"45263","match":"exact-normalized-name-in-linked-work","subjectId":"20150"}],"egsCharacterIds":["14204"],"vndbCharacterId":"c27921"},"originalCharacterName":"門倉 心乃","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の隣家に住む門倉姉妹の妹。"},{"spoiler":false,"text":"主人公よりも二つ年下の幼馴染。"},{"spoiler":false,"text":"外見的にはロリっ子。真面目で頑張り屋の妹タイプ。"},{"spoiler":false,"text":"主人公に対して一途で、いつも主人公のことを考えているくらい大好き。"},{"spoiler":false,"text":"しっかりしているように見えて、子供っぽいところがあったり、間が抜けていたり、何かと可愛らしい。"},{"spoiler":false,"text":"主人公の「オナニーを見られることに興奮する」性癖を知って、当初はショックを受けていたが、好きな人のしたいことを叶えてあげたいと思い、そのオナニーを見てあげようとするが……。"},{"spoiler":false,"text":"「だって、カズくん以上に、出来る人とかいないし。」"}],"source":"egs","sourceCharacterId":"14204","sourceWorkId":"13272","spoiler":false},{"segments":[{"spoiler":false,"text":"和より二個年下の女の子。"},{"spoiler":false,"text":"和とは幼なじみで、家も隣。ベランダ同士がほとんどくっついていて、そこから行き来できる。"},{"spoiler":false,"text":"外見的にはロリっ子。真面目で頑張り屋の妹タイプ。"},{"spoiler":false,"text":"和に対してかなり一途で、いつも和のことを考えているくらい和が好き。言動の節々に和に対する信頼が見え隠れする。"},{"spoiler":false,"text":"しっかり者だが間の抜けたところがあったり、成績が良くなかったり、子供っぽいところがまだまだあったりと、なにかと和に面倒を見てもらっている。"},{"spoiler":false,"text":"朝に弱いのが最大の欠点。子供の頃から、朝はいつも和に学校へ連れて行ってもらっている。"},{"spoiler":false,"text":"和の “オナニーを見られることに興奮する” 性癖を知り最初はショックを受けて気まずい思いをするが、好きな人のしたいことは叶えてあげたいと思い、和のオナニーを見ることに協力を申し出る。"},{"spoiler":false,"text":"その後も、和がエッチな言葉を言われ感じることを知ると、自ら色々な調べ物をして（インターネットやエッチな作品を見るなど）、エッチな言葉や行為ををどんどん覚えるようになっていく。"},{"spoiler":false,"text":"「うん、カズくんだったら、大丈夫だよ～。きっと生徒会長とかにもなれるから」"}],"source":"bangumi","sourceCharacterId":"45263"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/9b/9be4baad9537c89bfbb888c4e9cc71d2210a71260c894f524a4dab925434c208.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/60/60dc0a5b56cf058eb05ea505fafd0a5a9920198ff9024c9ba85b8e3b2e2b8c92.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"西沢 広香","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:20150:45263:5890:1","source":"bangumi"}]},{"characterId":"char_c27971","characterName":"門倉 雅","sourceIds":{"bangumi":[{"characterId":"45264","match":"exact-normalized-name-in-linked-work","subjectId":"20150"}],"egsCharacterIds":["14205"],"vndbCharacterId":"c27971"},"originalCharacterName":"門倉 雅","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の隣家に住む門倉姉妹の姉。"},{"spoiler":false,"text":"主人公より一つ年上の幼馴染。"},{"spoiler":false,"text":"容姿端麗、明朗活発で、人望も厚く、教師生徒問わず慕われており、全国クラスのテニスの腕の持ち主で、ピアノコンクールや、美術コンクールなどでも、賞を総なめにするなど、スーパー才女ぶりを発揮している。"},{"spoiler":false,"text":"一見大人びた風貌をしているが、悪戯っ子のような子供のような面も持っている。"},{"spoiler":false,"text":"主人公が「オナニーするところを見せることで興奮する性癖」を持っていることを知ると、そのことをネタにして責め始めるが……。"},{"spoiler":false,"text":"「ふふ、冗談よ。あかくなった和って可愛いね。」"}],"source":"egs","sourceCharacterId":"14205","sourceWorkId":"13272","spoiler":false},{"segments":[{"spoiler":false,"text":"和より一つ年上の少女。門倉心乃の姉。"},{"spoiler":false,"text":"家が隣であるため、和のことを実の弟のようにかわいがっている。"},{"spoiler":false,"text":"容姿端麗、明朗活発で人望も厚く、教師・生徒問わず慕われている。"},{"spoiler":false,"text":"全国クラスのテニス選手でありながら、ピアノコンクールや、美術コンクールなどでも賞を総なめにした。"},{"spoiler":false,"text":"たいして努力をしなくても他を圧倒する、とんでもないスペックの持ち主。"},{"spoiler":false,"text":"一見大人びた風貌をしているが、悪戯っ子で子供っぽい面も持っていて、特に和に対しては、慌てるのが楽しくて女の子を意識させ楽しんでいたりする。"},{"spoiler":false,"text":"“オナニーするところを見せることで興奮する性癖” を和が持っていることを知ると、そのことをネタに和をどんどん責めていく。"},{"spoiler":false,"text":"「隠さなくても分かるんだから、そっか～、和ももうそんな年頃なんだねぇ、なんだったら、私が色々と教えてあげよっか？」"}],"source":"bangumi","sourceCharacterId":"45264"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3f/3f7e39d73cce0e16a807ab69cb47efa30a2aac807f8314de243d94a3dca33c55.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/2840775adff22c638d5d336b89dc37fe0ff2116b813363deb8215134b1228d04.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"羽月理恵","creatorId":"vndb:s928","sourcePersonId":"vndb:s928","canonicalEntityId":"vndb:s928","name":"羽月 理恵","roleCode"