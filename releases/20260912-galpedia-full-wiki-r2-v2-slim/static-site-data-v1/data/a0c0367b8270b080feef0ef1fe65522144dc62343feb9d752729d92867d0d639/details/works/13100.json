tor:141128","source":"egs"},{"creditedName":"快楽ずぼっと(快楽ズボット)","creatorId":"vndb:s12338","sourcePersonId":"egs:creator:18649","canonicalEntityId":"vndb:s12338","name":"快楽ずぼっと(快楽ズボット)","detail":"グラフィック","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:141129","source":"egs"},{"creditedName":"山本虎穴","creatorId":"vndb:s53069","sourcePersonId":"egs:creator:18573","canonicalEntityId":"vndb:s53069","name":"山本虎穴","detail":"グラフィック","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:141130","source":"egs"},{"creditedName":"加納保宏","creatorId":"vndb:s19317","sourcePersonId":"egs:creator:18572","canonicalEntityId":"vndb:s19317","name":"加納保宏","detail":"グラフィック","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:141131","source":"egs"},{"creditedName":"吉見一","creatorId":"vndb:s31102","sourcePersonId":"egs:creator:22284","canonicalEntityId":"vndb:s31102","name":"吉見一","detail":"グラフィック","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:141132","source":"egs"},{"creditedName":"ao","creatorId":"egs:creator:20012","sourcePersonId":"egs:creator:20012","canonicalEntityId":"egs:creator:20012","name":"ao","detail":"グラフィック","roleCode":"other","roleLabel":"其他","identityStatus":"ambiguous-alias-review","relationId":"egs:work-creator:141133","source":"egs"},{"creditedName":"きみなみなみき","creatorId":"vndb:s37418","sourcePersonId":"egs:creator:21722","canonicalEntityId":"vndb:s37418","name":"きみなみなみき","detail":"グラフィック","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:141134","source":"egs"},{"creditedName":"モリタケンジ","creatorId":"vndb:s14102","sourcePersonId":"egs:creator:1092","canonicalEntityId":"vndb:s14102","name":"モリタケンジ","detail":"ディレクター","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:141135","source":"egs"},{"creditedName":"ソフト開発Paprika","creatorId":"vndb:s31112","sourcePersonId":"egs:creator:21724","canonicalEntityId":"vndb:s31112","name":"ソフト開発Paprika","detail":"企画・開発","roleCode":"other","roleLabel":"其他","identityStatus":"auto-confirmed","relationId":"egs:work-creator:141136","source":"egs"}]},"cast":[{"characterId":"char_vndb_c35271","characterName":"保科 彩香","sourceIds":{"vndbCharacterId":"c35271"},"originalCharacterName":"保科 彩香","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The main heroine of this work. She left her family home during university and lived alone in a distant place, but was suddenly transferred to the academy the protagonist attends."},{"spoiler":false,"text":"An outstanding student, beautiful, athletically gifted—a flawless superwoman. Her exceptional social skills and dependable personality made her a constant favorite among her peers since childhood."},{"spoiler":false,"text":"Conversely, her abilities and pride have warped her perspective, leading her to view others as little more than “puppets to be manipulated.”"},{"spoiler":false,"text":"She rarely shows this side, but occasionally revealed it to the protagonist—her closest confidant (one might say she trusted him)."},{"spoiler":false,"text":"Perhaps taking this too far, she has a history of sexually molesting the young protagonist, causing him life-altering trauma. To her, however, it seems to have been nothing more than “just another prank.”"},{"spoiler":false,"text":"Surprisingly, due to her “too perfect” appearance, she has never had a boyfriend and remains a virgin. While she has an intense interest in sexual matters, her high pride prevents her from ever discussing it with anyone."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c35271"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a8/a807d2d2b11121381c90358c0573aeb88c021041fc778779a46c62efd310fc55.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a417891c93c051f225c3da8b5647f3c1d0b7b5e766b4b1faf32d38de1573a01c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榎津 まお","creatorId":"vndb:s106","sourcePersonId":"vndb:s106","canonicalEntityId":"vndb:s106","name":"野中 カオリ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20790","source":"vndb"}]},{"characterId":"char_vndb_c35272","characterName":"神谷 江利奈","sourceIds":{"vndbCharacterId":"c35272"},"originalCharacterName":"神谷 江利奈","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A female student who harbors feelings for the protagonist. Though she speaks little, her sharp, incisive remarks stand out—a classic cool beauty."},{"spoiler":false,"text":"Contrary to her appearance, she is a pure masochist, spending her days trembling (secretly) while being treated like a toy by the protagonist."},{"spoiler":false,"text":"Simultaneously, she possesses a significant sadistic streak, occasionally revealing a merciless side toward others."},{"spoiler":false,"text":"Though barely discernible, she harbors a faintly dark emotion deep within her heart toward Ayaka, who has become the protagonist's target."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c35272"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e0/e0f00febc3b8b4c03a0be80837bee13ca0312d3a8faf61c3d6fcd6ba5ae79fe6.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/7a/7a728d2a71c712daad0d1d996252a77efec7d89d8537fdc6e8a29dc83f689131.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"春日 アン","creatorId":"vndb:s638","sourcePersonId":"vndb:s638","canonicalEntityId":"vndb:s638","name":"春日アン(春乃うらら)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20793","source":"vndb"}]},{"characterId":"char_vndb_c35273","characterName":"早坂 美樹","sourceIds":{"vndbCharacterId":"c35273"},"originalCharacterName":"早坂 美樹","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Ayaka's former classmate and the school nurse at the academy the protagonist attends. With her gentle appearance and personality, she's immensely popular with the male students."},{"spoiler":false,"text":"Contrary to her outward demeanor, she has a tendency to look down on others."},{"spoiler":false,"text":"However, aided by her skill at navigating social situations, which surpasses even Ayaka's, few notice the occasional cold glances she gives."},{"spoiler":false,"text":"She once toyed with the protagonist alongside Ayaka, though neither the protagonist nor Miki remember this incident."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c35273"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/95/9561e8291e7139da8d29610eb2ed25ab6f2d0273d42fa5f6a301972c52ce5cc5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d8/d8da92ed4a34e178918384962d2c3e180132ab570c1477614c8631e32785a74f.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"渋谷 ひめ","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20791","source":"vndb"}]},{"characterId":"char_vndb_c35274","characterName":"保科 啓","sourceIds":{"vndbCharacterId":"c35274"},"originalCharacterName":"保科 啓","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist's classmate and Ayaka's younger brother, the youngest of the three Hoshina siblings."},{"spoiler":false,"text":"He is the step brother of the two older siblings, his mother remarried and is the second wife of the father of the protagonist and Ayaka. He attends the same academy as the protagonist."},{"spoiler":false,"text":"Unlike his sharp-looking older sister and brother, he inherited his gentle mother's traits and has an affable personality."},{"spoiler":false,"text":"He looks much younger than his actual age, and combined with his airheaded nature, he is often teased by those around him (especially girls)."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c35274"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1f/1fd0ecfcbad4d6a1f43b31db79fe210f6f573294a285f1c6eab5a78aa3dfc7ef.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/fa/fa1899505568dc0785911d3ed0678328e521cc95b2b55884393934bcb7570dc3.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"渋谷 ひめ","creatorId":"vndb:s354","sourcePersonId":"vndb:s354","canonicalEntityId":"vndb:s354","name":"高村 優里","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:20792","source":"vndb"}]},{"characterId":"char_vndb_c60463","characterName":"保科 修一","sourceIds":{"vndbCharacterId":"c60463"},"originalCharacterName":"保科 修一","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The protagonist of the main story. Average build and height, with abilities that are merely adequate across the board, though his mental agility is exceptionally sharp."},{"spoiler":false,"text":"He appears to be an ordinary male student, but due to the sexual abuse he suffered in the past at the hands of his older sister and her friends, a deep-seated distrust and aversion toward women swirls within him."},{"spoiler":false,"text":"However, perhaps his lack of expectations toward women paradoxically makes him appealing? Reluctantly, he tends to be quite popular with girls."},{"spoiler":false,"text":"Perhaps due to his trauma, he is highly wary of those around him. Regarding women specifically, his attitude goes beyond mere disregard—he views them as little more than tools."},{"spoiler":false,"text":"Consequently, even towards Erina, who harbors feelings for him, he consistently treats her solely as a means to an end."},{"spoiler":false,"text":"From Getchu"}],"source":"vndb","sourceCharacterId":"c60463"}],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p996","sourceCompanyId":"egs:brand:1929","canonicalEntityId":"vndb:p996","name":"メガロマンス","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:13100:1929","source":"egs"},{"companyId":"vndb:p996","sourceCompanyId":"vndb:p996","canonicalEntityId":"vndb:p996","name":"メガロマンス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:166012:v2870","source":"vndb"},{"companyId":"vndb:p996","sourceCompanyId":"vndb:p996","canonicalEntityId":"vndb:p996","name":"メガロマンス","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:6724:v2870","source":"vndb"}],"missingStates":["confirmed-character-relation-missing","current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
