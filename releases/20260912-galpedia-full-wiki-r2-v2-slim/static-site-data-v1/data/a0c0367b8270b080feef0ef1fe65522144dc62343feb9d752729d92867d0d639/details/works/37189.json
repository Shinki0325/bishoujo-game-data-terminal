{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"37189","model":{"presentationWorkId":"vndb:v52860","staff":{"artwork":[{"creditedName":"さいもん","creatorId":"vndb:s4758","sourcePersonId":"egs:creator:23343","canonicalEntityId":"vndb:s4758","name":"さいもん","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:284915","source":"egs"}],"scenario":[{"creditedName":"須々木鮎尾","creatorId":"vndb:s2319","sourcePersonId":"egs:creator:13991","canonicalEntityId":"vndb:s2319","name":"須々木鮎尾","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:284916","source":"egs"}],"music":[],"other":[]},"cast":[{"characterId":"char_vndb_c154613","characterName":"アイナ・レミネン","sourceIds":{"vndbCharacterId":"c154613"},"originalCharacterName":"アイナ・レミネン","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A foreign student from Finland who loves Japanese anime and manga."},{"spoiler":false,"text":"With a bright and carefree personality, she quickly adapted to life in Japan."},{"spoiler":false,"text":"She expresses her emotions clearly and is the type to speak her mind openly."},{"spoiler":false,"text":"She never changes what she believes to be right, but is honest enough to apologize when she feels she is wrong."},{"spoiler":false,"text":"Although she is pure Finnish,"},{"spoiler":false,"text":"she loves Japanese anime and has been watching it since she was little,"},{"spoiler":false,"text":"and as a result, she can speak Japanese fluently."},{"spoiler":false,"text":"Her playing is just as free-spirited as her personality, and she often leads her friends around during ensembles."},{"spoiler":false,"text":"She is a genius, and she balances her playing to the very limit without ruining the performance."},{"spoiler":false,"text":"She lives alone in an apartment, and her room is filled with love for anime."},{"spoiler":false,"text":"In the future, she aims to become a professional viola player."},{"spoiler":false,"text":"While essentially identical to another version of herself, the main difference is that this version exists in a timeline where the plot of the main series title did not unfold."}],"source":"vndb","sourceCharacterId":"c154613"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/51/510f97e94732713b10d140ddd9412b408a763a18b5534c37f1767a7cc462d2bc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/c8/c8aeac61e9020dd91b7ed87d5b20d4aac4663941cf3da0af595ca2f116280343.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"藤野 むらさき","creatorId":"vndb:s1545","sourcePersonId":"vndb:s1545","canonicalEntityId":"vndb:s1545","name":"さいとう よしえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:99037","source":"vndb"}]},{"characterId":"char_vndb_c154818","characterName":"三宅功","sourceIds":{"vndbCharacterId":"c154818"},"originalCharacterName":"三宅功","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"His skin is oily, his body is ugly, fat and flabby."},{"spoiler":false,"text":"He's a womanizer, and there are constant rumors that he uses his position to prey on young women in the music industry."},{"spoiler":false,"text":"Translated from the official site"}],"source":"vndb","sourceCharacterId":"c154818"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.d