State":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"元々は約2500年ほど前に猛威を振るった魔王の一人。"},{"spoiler":false,"text":"しかし、暴れすぎたため時の勇者一行に封印される。"},{"spoiler":false,"text":"その際に、仲間の魔王と共に666年後に目覚めて再び暴れることを誓うが、不覚にも2000年ほど寝坊してしまった。"},{"spoiler":false,"text":"その後、彼女を封印していた魔法具は、流れ流れて舞台となる街にやってくる。"},{"spoiler":false,"text":"性格は傲慢不遜、勝ち気、図々しい、戦闘好きだが、どこか憎めない人物。"},{"spoiler":false,"text":"何故か子供には好かれるために、近所の子供達とガチでサッカーや野球に興じることもしばしば。"},{"spoiler":false,"text":"そんな性格に相反して、非常に女性らしい体型をしている。"},{"spoiler":false,"text":"とはいっても、本人にとっては胸は邪魔らしい。"},{"spoiler":false,"text":"最近の不満は、歴史書に自らが『歴史上最悪の無慈悲な魔王』と記述されていること。"}],"source":"egs","sourceCharacterId":"17530","sourceWorkId":"25659","spoiler":false},{"segments":[{"spoiler":false,"text":"元々は約2500年ほど前に猛威を振るった魔王の一人。"},{"spoiler":false,"text":"しかし、暴れすぎたため時の勇者一行に封印される。"},{"spoiler":false,"text":"その際に、仲間の魔王と共に666年後に目覚めて再び暴れることを誓うが、"},{"spoiler":false,"text":"不覚にも2000年ほど寝坊してしまった。"},{"spoiler":false,"text":"その後、彼女を封印していた魔法具は、流れ流れて舞台となる街にやってくる。"},{"spoiler":false,"text":"性格は傲慢不遜、勝ち気、図々しい、戦闘好きだが、どこか憎めない人物。"},{"spoiler":false,"text":"何故か子供には好かれるために、近所の子供達とガチでサッカーや野球に興じることもしばしば。"},{"spoiler":false,"text":"そんな性格に相反して、非常に女性らしい体型をしている。"},{"spoiler":false,"text":"とはいっても、本人にとっては胸は邪魔らしい。"},{"spoiler":false,"text":"最近の不満は、歴史書に自らが『歴史上最悪の無慈悲な魔王』と記述されていること。"}],"source":"bangumi","sourceCharacterId":"66809"}],"profileFacts":[{"label":"好物","source":"bangumi","sourceCharacterId":"66809","value":"自然。褒め言葉。頼りにされること。"},{"label":"性格","source":"bangumi","sourceCharacterId":"66809","value":"傲慢不遜"},{"label":"所属","source":"bangumi","sourceCharacterId":"66809","value":"組長であり元魔王"},{"label":"種族","source":"bangumi","sourceCharacterId":"66809","value":"有角族"},{"label":"趣味","source":"bangumi","sourceCharacterId":"66809","value":"戦闘。歴史書を読むこと。配下との交流"}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/06/067