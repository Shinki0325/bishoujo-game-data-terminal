wState":"source-only","source":"vndb","value":"85"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"84"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"56"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The multi-talented head maid of the Alhazred mansion who is in charge of everything related to it. A spirit summoned by Carmilla and bound to a magical ring, she can be likened to a ghost who signed a contract of subservience to the master who summoned her. She always wishes for the happiness of her master, and will do anything to ensure that her master is well cared for and happy."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c31315"},{"segments":[{"spoiler":false,"text":"キャルミラお付きの侍女長。"},{"spoiler":false,"text":"アルハザード領主の屋敷の一切を取り仕切る万能メイド。"},{"spoiler":false,"text":"魔法の指輪を依り代にしてキャルミラに召喚され、主従の契約をしているゴーストに近しい存在。"},{"spoiler":false,"text":"キャルミラの幸せを常に願い、キャルミラが喜ぶためなら一切の手間と労力を惜しまない。"},{"spoiler":false,"text":"キャルミラのあるところ、どこにでも現れて世話をする。"},{"spoiler":false,"text":"「不肖ながら、このヴァニラが誠心誠意、ご奉仕させて頂きます」"}],"source":"egs","sourceCharacterId":"2000","sourceWorkId":"19336","spoiler":false},{"segments":[{"spoiler":false,"text":"キャルミラお付きの侍女長。アルハザード領主の屋敷の一切を取り仕切る万 能メイド。"},{"spoiler":false,"text":"魔法の指輪を依り代にしてキャルミラに召喚さ れ、主従の契約をしているゴーストに近しい存在。 キャルミラの幸せを常に願い、キャルミラが喜 ぶためなら一切の手間と労力を惜しまない。 キャルミラのあるところ、どこにでも現れて世話をする。"}],"source":"bangumi","sourceCharacterId":"64562"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ed/edad56bf02bba21a26f0d2c9a6ec25cdb8447e77c60a9eab01601ec3aa0c2405.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3a/3a1138319993537092cdca116f72e1e94a587b397c7c3130153e093e9b93f054.webp","width":203,"height":256,"source":"static-detail"},"actors":[{"creditedName":"御苑生 メイ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91160","source":"vndb"}]},{"characterId":"char_c97273","characterName":"キャルミラ・ド・アルハザード十三世","sourceIds":{"bangumi":[{"characterId":"64561","match":"exact-normalized-name-in-linked-work","subjectId":"447791"},{"characterId":"64561","match":"exact-normalized-name-in-linked-work","subjectId":"78640"}],"egsCharacterIds":["1999"],"vndbCharacterId":"c97273"},"originalCharacterName":"キャルミラ・ド・アルハザード十三世","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"source-only","source":"vndb","value":"72"},"height":{"reviewState":"no-conflict","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"74"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"51"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The leader of the Nation of Everlasting Night Alhazred, and a Miko of the Divine Beast. A true Ancestor and a Vampire, she is not only well loved by her citizens for her natural charisma, but also for her natural aptitude for magic and deep wealth of knowledge. No matter the adversity she faces, she never complains and always remains calm and takes it all with the grace and elegance you would expect from Nobility."},{"spoiler":false,"text":"From the official website"}],"source":"vndb","sourceCharacterId":"c97273"},{"segments":[{"spoiler":false,"text":"常時上空を闇の霧が覆う、永遠なる夜の国アルハザードを治める当主にして神獣の巫女。"},{"spoiler":false,"text":"吸血鬼の真祖であり、アルハザードに棲む夜の眷属の頂点に位置する。"},{"spoiler":false,"text":"どんな状況でも優雅に振る舞う事を良しとしており、人前で弱みは絶対に見せない。"},{"spoiler":false,"text":"アイドル的なカリスマを持っており、芸術や魔術を奨励する内政の手腕も高く、彼女の力と美貌に惚れ込んでいる者は数多い。"},{"spoiler":false,"text":"元来アルハザード公国自体が他国に対して閉鎖的なため、長らくその文化と国の内情は秘密となっている。"},{"spoiler":false,"text":"「お～っほっほっほ！　何事もエレガントに、ですわ！」"}],"source":"egs","sourceCharacterId":"1999","sourceWorkId":"19336","spoiler":false},{"segments":[{"spoiler":false,"text":"常時上空を闇の霧が覆う、永遠なる夜の国アルハザードを治める当主にして神獣の巫女。 吸血鬼の真祖であり、アルハザードに棲む夜の眷属の頂点に位置する。 どんな状況でも優雅に振る舞う事を良しとしており、人前で弱みは絶対に見せない。"},{"spoiler":false,"text":"アイドル的なカリスマを持っており、芸術や魔術を奨励する内政の手腕も高く、 彼女の力と美貌に惚れ込んでいる者は数多い。 元来アルハザード公国自体が他国に対して閉鎖的なため、長らくその文化と国の内情は秘密となっている。"}],"source":"bangumi","sourceCharacterId":"64561"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/09/09e24555bda718d97ef172e4cb71803064711563dbd42e1ed6143fda072c180f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/3d/3d3c65709a6b438c754db08c3dd4b09d2868de25ac25b8eae74de6339073bb6d.webp","width":256,"height":221,"source":"static-detail"},"actors":[{"creditedName":"今谷 みなみ","creatorId":"vndb:s648","sourcePersonId":"vndb:s648","canonicalEntityId":"vndb:s648","name":"今谷 皆美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:91161","source":"vndb"}]}],"songs":[],"companies":[{"companyId":"egs:brand:2058","sourceCompanyId":"egs:brand:2058","canonicalEntityId":"egs:brand:2058","name":"DualTail(DualMage)","roleCodes":["brand"],"identityStatus":"no-alias-hit","relationId":"egs:work-brand:32560:2058","source":"egs"},{"companyId":"vndb:p507","sourceCompanyId":"vndb:p507","canonicalEntityId":"vndb:p507","name":"dualtail","roleCodes":["developer","publisher"],"identityStatus":"source-native","relationId":"vndb:release-producer:100530:v35508","source":"vndb"}],"missingStates":["current-runtime-cover-unavailable"],"source":"terminal-wiki-full-runtime-v7"}}
