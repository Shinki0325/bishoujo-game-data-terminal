{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"4634","model":{"presentationWorkId":"vndb:v20057","staff":{"artwork":[{"creditedName":"白猫参謀(最神扇道)","creatorId":"vndb:s1371","sourcePersonId":"egs:creator:1489","canonicalEntityId":"vndb:s1371","name":"白猫参謀(最神扇道)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:10402","source":"egs"}],"scenario":[{"creditedName":"朝凪 軽","creatorId":"vndb:s3018","sourcePersonId":"vndb:s3018","canonicalEntityId":"vndb:s3018","name":"朝凪 軽","roleCode":"scenario","roleLabel":"剧本","identityStatus":"source-native","relationId":"vndb:vn-staff:134327","source":"vndb"}],"music":[{"creditedName":"NSN(西野尚利)","creatorId":"vndb:s3584","sourcePersonId":"egs:creator:3536","canonicalEntityId":"vndb:s3584","name":"NSN(西野尚利)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:112875","source":"egs"}],"other":[]},"cast":[{"characterId":"char_vndb_c29768","characterName":"シャルミ","sourceIds":{"vndbCharacterId":"c29768"},"originalCharacterName":"シャルミ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Sharumi is the only child of a wealthy family. Her father, Mr. Maxim, is a very influential businessman who has a very good relationship with the current government. Sharumi has a very stubborn, shrew, immature and childish kind of personality but unusually for people of her social status she also appears to be very kind towards her servants Haresu and Riru. Her strong sense of justice might just prove out to be fatal for her once Lieutenant Prosper's military unit stations themselves at her villa."},{"spoiler":false,"text":"Edited from MangaGamer"}],"source":"vndb","sourceCharacterId":"c29768"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36c7c3d08aba0f9c4067233dfd55368c6b45e7e3f6c56567bc2489f5d820684f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e1/e106d451c0988823d50433188da860c8e7adf1d571dbee4a16c71acfa2418ee4.webp","width":197,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c29769","characterName":"ハレス","sourceIds":{"vndbCharacterId":"c29769"},"originalCharacterName":"ハレス","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Haresu works as a servant at Mr. Maxim's mansion together with Riru. He is a rather timid guy who has fears of authority figures but despite his flaws he will try his best to save people he holds dear to himself. Little does he know that his life is about to change in a very dramatic way after Lieutenant Prosper's military unit stations themselves at Mr. Maxim's villa."}],"source":"vndb","sourceCharacterId":"c29769"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/21/21655e6acf6ed77990bed0230199cc940b6ecf74f85f66780cd3747083293ca3.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74ebb50ec30e4f9d68ea03be776a9d5c74d4176a1b321ba211024a22b9585e5b.webp","width":197,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c30063","characterName":"リル","sourceIds":{"vndbCharacterId":"c30063"},"originalCharacterName":"リル","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Riru is a maid at Mr. Maxim's mansion that works alongside Haresu. She is a gentle, reliable, kind, caring and modest person that values her virginity. Little does she know that her life is about to turn upside down once the Lieutenant Prosper's military unit comes to station themselves at her residence."},{"spoiler":false,"text":"Edited from MangaGamer"}],"source":"vndb","sourceCharacterId":"c30063"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/05/059344ab2551405a301bf92791ed659317b282805c2713146b59f422a8037adc.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/98/987eedf9ed03cba5640d7395613259c9abe8028482cb69363c9bcadf14be4ef2.webp","width":197,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c30065","characterName":"アルフィナ","sourceIds":{"vndbCharacterId":"c30065"},"originalCharacterName":"アルフィナ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Alfina is a private female teacher who lives in the same village as Haresu. She is a good advisor and acts like an older sister to him. She is probably the most intellectual person in the village and she is also sexually very attractive."},{"spoiler":false,"text":"Edited from MangaGamer"}],"source":"vndb","sourceCharacterId":"c30065"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/70/705a999d7f4942f66f4d767606d53a078aabd8f97cdb52a638cd90b14f9037c1.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/83/83687be1dfa12415dd362c2bc5a7b1440c352aef04b4f99c2150816c8e12e27c.webp","width":1