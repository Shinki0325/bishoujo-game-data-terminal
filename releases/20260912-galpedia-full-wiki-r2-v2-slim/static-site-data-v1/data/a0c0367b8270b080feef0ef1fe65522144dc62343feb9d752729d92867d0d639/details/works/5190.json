 committee chairman (The 風紀委員長)."}],"source":"vndb","sourceCharacterId":"c7467"},{"segments":[{"spoiler":false,"text":"秩序を愛してやまない風紀委員。"},{"spoiler":false,"text":"度を超した真面目な性格は、時に独善的にも見える。"},{"spoiler":false,"text":"正義感が強い睦峰を気に入っていたので、後からやってきて、睦峰にベタベタする転校生たちを煙たがっている。"},{"spoiler":false,"text":"また、密かに征服欲のようなものも持っている様子。"}],"source":"egs","sourceCharacterId":"27078","sourceWorkId":"5190","spoiler":false},{"segments":[{"spoiler":false,"text":"～風紀委員長～"},{"spoiler":false,"text":"風紀委員を務める、"},{"spoiler":false,"text":"秩序を愛して止まない人物。"},{"spoiler":false,"text":"度を超して真面目な性格で、"},{"spoiler":false,"text":"時に独善的な部分も垣間見える。"},{"spoiler":false,"text":"正義感が強い主人公の事を気に入っており、"},{"spoiler":false,"text":"後からやってきて勝手にベタベタしている"},{"spoiler":false,"text":"転校生達を煙たく思っている。"},{"spoiler":false,"text":"また、密かに征服欲の様なモノを持っている。"},{"spoiler":false,"text":"眼鏡キャラ。"},{"spoiler":false,"text":"お父さんは自Ａ隊勤務。"}],"source":"bangumi","sourceCharacterId":"201088"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"27078","sourceWorkId":"5190","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"27078","sourceWorkId":"5190","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueContext":null,"source":"egs","sourceCharacterId":"27078","sourceWorkId":"5190","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"58 cm","valueContext":null,"source":"egs","sourceCharacterId":"27078","sourceWorkId":"5190","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{"height":[{"comparisonValue":"156","source":"vndb","sourceCharacterId":"c7467","value":"156"},{"comparisonValue":"162","scope":"sourceWork","source":"egs","sourceCharacterId":"27078","sourceWorkId":"5190","value":"162"},{"comparisonValue":"162","source":"bangumi","sourceCharacterId":"201088","value":"162cm"}]},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/53/53360c67179