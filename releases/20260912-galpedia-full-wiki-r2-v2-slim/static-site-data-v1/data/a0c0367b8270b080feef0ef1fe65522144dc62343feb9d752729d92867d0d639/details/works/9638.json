a":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"AB"},"bust":{"reviewState":"source-only","source":"vndb","value":"74"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"B"},"height":{"reviewState":"no-conflict","source":"vndb","value":"164"},"hip":{"reviewState":"source-only","source":"vndb","value":"78"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"54"}},"descriptions":[{"segments":[{"spoiler":false,"text":"スラリと伸びた手足が魅力的な生徒会副会長。"},{"spoiler":false,"text":"成績優秀、容姿端麗、明るくハッキリした性格。"},{"spoiler":false,"text":"自分のルックスに自信があり、また水着モデルをしていたことから、見られることには慣れている様子。"},{"spoiler":false,"text":"主人公を意識しているが、素直になれないツンデレタイプの彼女は、まっすぐに好意をぶつける他のメンバーをうらやましく思っている。"},{"spoiler":false,"text":"「あ、明人がどうしても水着姿が見たいって言うなら、見せてあげないこともないわよ？」"}],"source":"egs","sourceCharacterId":"19541","sourceWorkId":"9638","spoiler":false},{"segments":[{"spoiler":false,"text":"成績優秀、容姿端麗で強気な生徒会副会長。"},{"spoiler":false,"text":"すぐ無軌道に暴走しはじめる姉・陽子のブレーキ役だが、最近は押され気味。"},{"spoiler":false,"text":"ボケの多い生徒会でのツッコミ担当でもある。"},{"spoiler":false,"text":"スレンダーでスラリと足の長いツンデレ美少女で、明るくハキハキした性格、ゆえに学内でも男子生徒の人気が高い。時折ワガママなお姫様体質が噴出し、水星がパシらされるのはご愛嬌。"},{"spoiler":false,"text":"主人公に対しては、ちょっと意識してしまって素直になれない、微妙なカンケイ。"},{"spoiler":false,"text":"素直に好意をぶつけるはずむと樹里をうらやましく思っている。"},{"spoiler":false,"text":"「あ、明人がどうしても水着姿が見たいって言うなら、見せてあげないこともないわよ？」"}],"source":"bangumi","sourceCharacterId":"147399"}],"profileFacts":[{"label":"胸围（本版本）","value":"74 cm","valueContext":null,"source":"egs","sourceCharacterId":"19541","sourceWorkId":"9638","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"19541","sourceWorkId":"9638","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"164 cm","valueContext":null,"source":"egs","sourceCharacterId":"19541","sourceWorkId":"9638","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"78 cm","valueContext":null,"source":"egs","sourceCharacterId":"19541","sourceWorkId":"9638","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"54 cm","valueContext":null,"source":"egs","sourceCharacterId":"19541","sourceWorkId":"9638","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/74/74535999a591a24cd177686e4a0907288101182eb15cc078f37b3cf64f8e90c9.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/eb/eb6115c6fea6c94e70b48899e18ba4ba7b196627582cac7144313a752561aca4.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小山さほみ","creatorId":"vndb:s278","sourcePersonId":"vndb:s278","canonicalEntityId":"vndb:s278","name":"小山 さほみ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218770:147399:6359:1","source":"bangumi"}]},{"characterId":"char_c52649","characterName":"峰 はずむ","sourceIds":{"bangumi":[{"characterId":"147401","match":"exact-normalized-name-in-linked-work","subjectId":"218770"}],"egsCharacterIds":["19542"],"vndbCharacterId":"c52649"},"originalCharacterName":"峰 はずむ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bloodType":{"reviewState":"no-conflict","source":"egs","value":"A"},"bust":{"reviewState":"source-only","source":"vndb","value":"96"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"I"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"source-only","source":"vndb","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"60"}},"descriptions":[{"segments":[{"spoiler":false,"text":"書記を担当している幼馴染のブラコンお姉ちゃん。"},{"spoiler":false,"text":"入学当初は水泳部に所属していたが、急成長した胸が気になり、一年次の夏でリタイア。"},{"spoiler":false,"text":"いじられキャラで、“胸、はずむ～”と生徒会メンバーに呼ばれるが、その度に「ムネっていうな！　私は胸じゃないです、峰！」"},{"spoiler":false,"text":"と抗議するが、みんな取り合ってくれない。"},{"spoiler":false,"text":"「あっくんは、胸の大きな女のコって好き……かな？」"}],"source":"egs","sourceCharacterId":"19542","sourceWorkId":"9638","spoiler":false},{"segments":[{"spoiler":false,"text":"生徒会書記の3年生で、幼馴染のお姉ちゃん。"},{"spoiler":false,"text":"姉といっても、主人公と一日違いの誕生日で、4／1生まれの為、一学年上に上がってしまった。本人はそれを寂しく思っていて、意識はして無いが結構なブラコン少女。"},{"spoiler":false,"text":"水泳が得意で入学当時は水泳部だったが、急成長してきたムネが邪魔で、1年次の夏を越えたところで結局リタイヤ。運動神経はいいのだが、どうしても揺れる胸が邪魔をする。胸の大きさで水泳を断念してから、美月に誘われて生徒会に入った。"},{"spoiler":false,"text":"本人は隠しているが、夢はお嫁さんなので家事料理は得意。よくおっぱいネタでいじられるので、胸周りがコンプレックス。"},{"spoiler":false,"text":"歩いてるとムネが揺れて、樹里に〝ムネムネ～〟、とか、みんなに〝胸、はずむ～〟と呼ばれて愛されているいじられキャラ。「ムネっていうな！　私は胸じゃないです、峰！」と言うが、皆、可愛いじゃないと、あまり取り合ってくれない。そんな時は「むぅ～～～～……」とうなって抗議している。"},{"spoiler":false,"text":"「あっくんは、胸の大きな女のコって好き……かな？」"}],"source":"bangumi","sourceCharacterId":"147401"}],"profileFacts":[{"label":"胸围（本版本）","value":"96 cm","valueContext":null,"source":"egs","sourceCharacterId":"19542","sourceWorkId":"9638","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"i","valueContext":null,"source":"egs","sourceCharacterId":"19542","sourceWorkId":"9638","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"19542","sourceWorkId":"9638","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"19542","sourceWorkId":"9638","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"60 cm","valueContext":null,"source":"egs","sourceCharacterId":"19542","sourceWorkId":"9638","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/08/0888c97635a822c3a331e1b7d12610ff004a7287f711216e30a3478a55c12d2d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/3004c3c4975239692ca45e14056549c4308ef5bfcff66f36bff859de8913e3ff.webp","wi