false,"text":"無邪気で堂々＋あっけらかんとしているので、水着姿を見られても、特に恥ずかしさは感じない。"},{"spoiler":false,"text":"「ねぇねぇ、あきとー、一緒に遊ぼーよ！」"}],"source":"bangumi","sourceCharacterId":"147403"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"19543","sourceWorkId":"9638","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"d","valueContext":null,"source":"egs","sourceCharacterId":"19543","sourceWorkId":"9638","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"162 cm","valueContext":null,"source":"egs","sourceCharacterId":"19543","sourceWorkId":"9638","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"85 cm","valueContext":null,"source":"egs","sourceCharacterId":"19543","sourceWorkId":"9638","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"19543","sourceWorkId":"9638","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e2/e2d7c33b6b574b85341f96e5023ff9692fb1b15e35d04b7892e1300ffe46da20.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/e5/e51f6ce942ec0b559ecc1d46a3c9605df98126783fc30c990f947be88d21c3e8.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"梶田夕貴","creatorId":"vndb:s485","sourcePersonId":"vndb:s485","canonicalEntityId":"vndb:s485","name":"梶田 夕貴","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:218770:147403:6106:1","source":"bangumi"}]},{"characterId":"char_c52651","characterName":"弓弦 陽子","sourceIds":{"bangumi":[{"characterId":"147405","match":"exact-normalized-name-in-linked-work","subjectId":"218770"}],"egsCharacterIds":["19544"],"vndbCharacterId":"c52651"},"originalCharacterName":"弓弦 陽子","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirm