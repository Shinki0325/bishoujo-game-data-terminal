"984"],"vndbCharacterId":"c33540"},"originalCharacterName":"スイートリップ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"source-only","source":"egs","value":"公式情報なし"},"bloodType":{"reviewState":"no-conflict","source":"egs","value":"O"},"height":{"reviewState":"source-only","source":"vndb","value":"156"},"sex":{"reviewState":"source-only","source":"egs","value":"女性"},"weight":{"reviewState":"source-only","source":"vndb","value":"42"}},"descriptions":[{"segments":[{"spoiler":false,"text":"ゲームのメインヒロイン。"},{"spoiler":false,"text":"中流家庭で何不自由なく幸せに育った優等生で、学園のアイドル的存在。"},{"spoiler":false,"text":"学園生の代表で組織する自治委員会の委員長でもある。"},{"spoiler":false,"text":"清純で、誰にでも優しく、困っている人を見ると放っておけない。"},{"spoiler":false,"text":"頭脳明晰、母性的で潔癖症。正義感が強く、"},{"spoiler":false,"text":"スイートナイツとなって学園を守る ことに強い使命感を持っている。"},{"spoiler":false,"text":"将来は外交官を目指しており、難民を救うために尽くしたいと考えている。"},{"spoiler":false,"text":"国際上級官僚を育成する総合部国際科に属している。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"2055","spoiler":false},{"segments":[{"spoiler":false,"text":"『魔法戦士スイートナイツ』のヒロイン。"},{"spoiler":false,"text":"清楚で正義感の強いスイートナイツの中心的存在。"},{"spoiler":false,"text":"メッツァーに対して敵同士以上の想いがある。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"10418","spoiler":false},{"segments":[{"spoiler":false,"text":"第一世代魔法戦士のリーダー格。"},{"spoiler":false,"text":"現在はかつての学び舎である国際教導学園に復学し、外交官となるための勉強を続けながら、特別講師として時折後輩たちのために教鞭を執っている。"},{"spoiler":false,"text":"明るく積極的な性格で、誰からも好かれる優等生。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"17330","spoiler":false},{"segments":[{"spoiler":false,"text":"メッツァーの宿敵。"},{"spoiler":false,"text":"清純な容姿と純真な正義の心に、淫らな肉体を併せ持つ美しい戦士。"},{"spoiler":false,"text":"一度覚えてしまった被虐の悦びからは二度と逃げられない……。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"18638","spoiler":false},{"segments":[{"spoiler":false,"text":"「こんな自分にはもう、魔法戦士の資格なんてないのかも……」"},{"spoiler":false,"text":"スイートナイツの一人。"},{"spoiler":false,"text":"現在地上で活動している魔法戦士たちのリーダー格。"},{"spoiler":false,"text":"明るく積極的な性格で、誰からも好かれる優等生。"},{"spoiler":false,"text":"国際教導学園で特別講師を務めていたが、講師退任後行方が分からなくなっている。"},{"spoiler":false,"text":"主な登場作品"},{"spoiler":false,"text":"「魔法戦士スイートナイツ」ほか"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"24214","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士のリーダー格の一人。"},{"spoiler":false,"text":"明るく積極的な性格で、誰からも好かれる優等生。"},{"spoiler":false,"text":"以前の戦いで、悪の野望を防ぐためにゲートに飛び込み、取り込まれたままいまだ帰還していない。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"26584","spoiler":false},{"segments":[{"spoiler":false,"text":"魔法戦士スイートナイツのリーダー、スイートリップ。本名は七瀬凛々子。"},{"spoiler":false,"text":"世界の支配を企む悪と戦い続けてきた歴戦の魔法戦士。その優しさと悪に屈することない強さで他の魔法戦士たちからも慕われている。"},{"spoiler":false,"text":"以前の戦いでゲートと呼ばれる魔導演算装置に取り込まれ、しばらくの間消息不明となっていたが、仲間たちによって無事救出される。"},{"spoiler":false,"text":"しかし、異空間に長期間囚われたことで、彼女は戦うための力を失ってしまう。 現在は国際教導学園の学生として、自身の次の道を模索している。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"33143","spoiler":false},{"segments":[{"spoiler":false,"text":"スイートナイツの一人、魔法戦士スイートリップ。"},{"spoiler":false,"text":"現在は特別魔法外交官として活躍している。"},{"spoiler":false,"text":"かつて倒した悪の組織の残党が暗躍しているという情報を聞き、調査へと赴く。"}],"source":"egs","sourceCharacterId":"984","sourceWorkId":"37809","spoiler":false},{"segments":[{"spoiler":false,"text":"ゲームのメインヒロイン。"},{"spoiler":false,"text":"中流家庭で何不自由なく幸せに育った優等生で、 学園のアイドル的存在。学園生の代表で組織する 自治委員会の委員長でもある。"},{"spoiler":false,"text":"清純で、誰にでも優しく、困っている人を見ると 放っておけない。頭脳明晰、母性的で潔癖症。正義感が強く、スイートナイツとなって学園を守る ことに強い使命感を持っている。"},{"spoiler":false,"text":"将来は外交官を目指しており、難民を救うために 尽くしたいと考えている。国際上級官僚を育成す る総合部国際科に属している。"}],"source":"bangumi","sourceCharacterId":"96131"}],"profileFacts":[{"label":"胸围（本版本）","value":"80 cm","valueContext":null,"source":"egs","sourceCharacterId":"984","sourceWorkId":"37809","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"156 cm","valueContext":null,"source":"egs","sourceCharacterId":"984","sourceWorkId":"37809","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"84 cm","valueC