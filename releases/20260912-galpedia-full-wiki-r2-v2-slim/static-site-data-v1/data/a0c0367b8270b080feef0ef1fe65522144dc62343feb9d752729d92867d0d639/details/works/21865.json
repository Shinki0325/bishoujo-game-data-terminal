あひる","creatorId":"vndb:s21606","sourcePersonId":"vndb:s21606","canonicalEntityId":"vndb:s21606","name":"あひる","roleCode":"songs","roleLabel":"歌曲","identityStatus":"source-native","relationId":"vndb:vn-staff:124852","source":"vndb"}]},"cast":[{"characterId":"char_c37589","characterName":"らむにゃー","sourceIds":{"bangumi":[{"characterId":"39003","match":"exact-normalized-name-in-linked-work","subjectId":"146910"}],"egsCharacterIds":["8378"],"vndbCharacterId":"c37589"},"originalCharacterName":"らむにゃー","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1025"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"height":{"reviewState":"no-conflict","source":"vndb","value":"165"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"57"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Luna's and Corona's childhood friend. The daughter of ramune manufacturers, she always loved ramune and if she doesn't have some ramune even for an hour, she starts shaking and having vertigo. Any ramune tastes delicious to her if she drinks it in a ramune bottle, no matter how bad it really tastes. She's the group's pet, along with Luna, and is often treated like a pet for comedic purposes. She loves Luna and gives him ramune every single morning. She is very popular among girls."},{"spoiler":false,"text":"She's often made fun of inside the group, especially by Corona and Iris. The girls in the group also touch and kiss her to embarrass her, and after the usual tsukkomi, she doesn't seem to care much. Like Luna, she's naive when it comes to romantic matters and get flustered easily. She loves the girls just as much as she loves Luna, and because of that she doesn't want to break the group apart by starting a romantic relationship with him."},{"spoiler":false,"text":"Recently her family has started to run into financial problems. Despite their ramune being very delicious, it is not very popular. She's trying to win the \"B-Grade Gourmet Contest\", a contest regularly held by RMC, so her family's business can become an RMC business partner."}],"source":"vndb","sourceCharacterId":"c37589"},{"segments":[{"spoiler":false,"text":"その名の通り、爽やかで快活な彼女は、"},{"spoiler":false,"text":"老若男女問わず、街のみんなの人気者です。"},{"spoiler":false,"text":"人気すぎて、よく触られたり、いじられたりします"}],"source":"egs","sourceCharacterId":"8378","sourceWorkId":"21865","spoiler":false},{"segments":[{"spoiler":false,"text":"その名の通り、爽やかで快活な少女。"},{"spoiler":false,"text":"老若男女問わず、街のみんなの人気者。"},{"spoiler":false,"text":"人気すぎて、よく触られたり、いじられたりする。"},{"spoiler":false,"text":"「デートのお誘いだよ。 恐縮だが、乗ってくれるかい？」"}],"source":"bangumi","sourceCharacterId":"39003"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"8378","sourceWorkId":"21865","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"165 cm","valueContext":null,"source":"egs","sourceCharacterId":"8378","sourceWorkId":"21865","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"81 cm","valueContext":null,"source":"egs","sourceCharacterId":"8378","sourceWorkId":"21865","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"57 cm","valueContext":null,"source":"egs","sourceCharacterId":"8378","sourceWorkId":"21865","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"49 kg","valueContext":null,"source":"egs","sourceCharacterId":"8378","sourceWorkId":"21865","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b1/b1ecda83eacd08d10e79d6daa39e7d29633114ddd57bde2c96cb2c1fbc66d126.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8f/8f90b2de8a87212ad179f65a9ba99aec18878d3db800be9f883bb41d891b40ee.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"中村麻未","creatorId":"vndb:s980","sourcePersonId":"vndb:s980","canonicalEntityId":"vndb:s980","name":"中村 麻未","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:146910:39003:15637:1","source":"bangumi"}]},{"characterId":"char_c37590","characterName":"紅星 陽菜","sourceIds":{"bangumi":[{"characterId":"39004","match":"exact-normalized-name-in-linked-work","subjectId":"146910"}],"egsCharacterIds":["8379"],"vndbCharacterId":"c37590"},"originalCharacterName":"紅星 陽菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"921"},"bust":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"cupSize":{"reviewState":"no-conflict","source":"vndb","value":"E"},"height":{"reviewState":"no-conflict","source":"vndb","value":"155"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"79"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"53"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"43"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Luna's twin younger sister. Romantically loves her brother and doesn't make much effort to hide. She is a genius and she herself made the car that the group uses to go to school. Just like Luna and Lamune, drinks ramune everyday."},{"spoiler":false,"text":"She's recently started thinking about happiness and decided that just being together with her friends and brother is \"enough\". Now she wants her friends to live happy lives and so invites her brother to make everyone happy."},{"spoiler":false,"text":"Knows that Lamune, Iris and Rayla love Luna, but she isn't jealous. In fact she says she's waiting for someone to make her advance so everyone can have their share of Luna as otherwise Luna would be too much embarrassed to agree to do anything more, specially with his twin sister."}],"source":"vndb","sourceCharacterId":"c37590"},{"segments":[{"spoiler":false,"text":"IQ200の陽菜ちゃんは一切容赦しません。"},{"spoiler":false,"text":"理性的に、計算高く、効率的に兄や友人を幸せにしようとしてきます。"}],"source":"egs","sourceCharacterId":"8379","sourceWorkId":"21865","spoiler":false},{"segments":[{"spoiler":false,"text":"IQ200の超絶妹。"},{"spoiler":false,"text":"一切容赦せず、理性的に、計算高く、効率的に、兄や友人を幸せにしようとしていく。"},{"spoiler":false,"text":"「ブラザーコンプレックスだって、家族愛と解釈すれば合理的でしょ？」"}],"source":"bangumi","sourceCharacterId":"39004"}],"profileFacts":[{"label":"胸围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"8379","sourceWorkId":"21865","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"155 cm","valueContext":null,"source":"egs","sourceCharacterId":"8379","sourceWorkId":"21865","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"79 cm","valueContext":null,"source":"egs","sourceCharacterId":"8379","sourceWorkId":"21865","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"53 cm","valueContext":null,"source":"egs","sourceCharacterId":"8379","sourceWorkId":"21865","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"43 kg","valueContext":null,"source":"egs","sourceCharacterId":"8379","sourceWorkId":"21865","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ad/ad90f19da8b99ba792038aecf25b48405f17ea909255665dc16fe5e0fe60572b.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/28/289292f59b8ec4a6e3c740cc131f4e2ffa204af729e6493f543648c8de36301c.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"石原舞","creatorId":"vndb:s985","sourcePersonId":"vndb:s985","canonicalEntityId":"vndb:s985","name":"石原 舞","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:146910:39004:13372:1","source":"bangumi"}]},{"characterId":"char_c37594","characterName":"紅星 月菜","sourceIds":{"bangumi":[{"characterId":"39007","match":"exact-normalized-name-in-linked-work","subjectId":"146910"}],"egsCharacterIds":["8377"],"vndbCharacterId":"c37594"},"originalCharacterName":"紅星 月菜","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"921"},"height":{"reviewState":"no-conflict","source":"bangumi","value":"？？？cm"},"sex":{"reviewState":"source-only","source":"vndb","value":"m"},"weight":{"reviewState":"no-conflict","source":"bangumi","value":"？？kg"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A bright and pure boy, Corona's older twin. He spends all day bathing naked in his jacuzzi. He's extremely popular with men for some reason, especially with foreign men. Luna and Corona's parents are famous engineers and sometimes even appear on TV. Because their parents are always traveling Luna and Corona live by themselves."},{"spoiler":false,"text":"Despite being very good friends with the heroines, he doesn't allows anyone inside his jacuzzi except for himself and rubber ducks. He has a weird personality where despite being naked all the time, being seen without a problem, he is very embarrassed being seen changing or seeing naked girls. He's also becomes embarrassed by romantic/erotic stuff other people does, especially females. Just seeing panties his faces get red, he freezes and after some time runs away in a panic. He doesn't get dirty jokes and innuendos at all. Great fan of disco."},{"spoiler":false,"text":"The story starts when his sister asks if he's living a happy life and invites him to make everyone happy. After thinking whats happiness for him, he realizes he doesn't really care about his happiness and decides to make everyone, starting by his closest friends, happy."},{"spoiler":false,"text":"Luna is the town's hero as he can make almost anything from stopping a downhill baby cart to defeating octopus-like destruction gods. Because of this he's hired by RMC to do exactly that. Even though he's that amazing he's very simple-minded and doesn't realize all the girls around him love him."}],"source":"vndb","sourceCharacterId":"c37594"},{"segments":[{"spoiler":false,"text":"彼が何を考えているか……謎です。"},{"spoiler":false,"text":"まぁ……多分何も考えてないんでしょう。"},{"spoiler":false,"text":"お風呂とゴムのアヒルが大好きだそうです。"}],"source":"egs","sourceCharacterId":"8377","sourceWorkId":"21865","spoiler":false},{"segments":[{"spoiler":false,"text":"彼が何を考えているのかは謎。 恐らく何も考えていない。"},{"spoiler":false,"text":"お風呂とゴムのアヒルが大好きらしい。"},{"spoiler":false,"text":"「よく見ておくんだな。 これがホヤだ」"}],"source":"bangumi","sourceCharacterId":"39007"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/6f/6fdcb02e9da9289fd17b89948d227572fd44c587740b6eeb83c0d424a1252a35.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a5/a596c10557d82b190a6a120629a8894552e423d6ac1616cf3b85f422d28d0a6d.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_vndb_c37591","characterName":"レイラ・プラテアード","sourceIds":{"vndbCharacterId":"c37591"},"originalCharacterName":"レイラ・プラテアード","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"228"},"bust":{"reviewState":"source-only","source":"vndb","value":"90"},"cupSize":{"reviewState":"source-only","source":"vndb","value":"G"},"height":{"reviewState":"source-only","source":"vndb","value":"165"},"hip":{"reviewState":"source-only","source":"vndb","value":"81"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"source-only","source":"vndb","value":"49"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Iris' younger twin. She a famous chef and works in the Cherry Crown Diner. She and her sister are best friends with Corona, Lamune and Luna. Every school morning she and her sister bring breakfast to Luna, Corona and Lamune, usually throwing the food at them."},{"spoiler":false,"text":"She has a mysterious personality and is always planning something. She, along with Corona, want Luna to stay pure, so they usually diverge his attention, cover his eyes, change the channel, etc. when they think the impact is going to be too intense on him."},{"spoiler":false,"text":"She doesn't even try to hide she loves Luna. At many times she warns Lamune to take action or else she and her sister \"won't be able to resist\". Just like her sister, isn't planning to confess her love for Luna as it could hurt the other girls. Rayla and Corona decide then to transform the group in a harem, making everyone happy. Is in a relationship much more intimate than sisters with Isis."}],"source":"vndb","sourceCharacterId":"c37591"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ce/ce22f643d3faf0b0699fad3395abfcd16dbd629baeb150bd25431fa75b29f659.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0d/0d664b5ae4fdad99f11f12fc392034a5664228927e4247ce6107f40eae9a97f2.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"榊原 ゆい","creatorId":"vndb:s272","sourcePersonId":"vndb:s272","canonicalEntityId":"vndb:s272","name":"榊原 ゆい","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66551","source":"vndb"}]},{"characterId":"char_vndb_c37592","characterName":"アイリス・プラテアード","sourceIds":{"vndbCharacterId":"c37592"},"originalCharacterName":"アイリス・プラテアード","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"birthday":{"reviewState":"source-only","source":"vndb","value":"228"},"bust":{"reviewState":"source-only","source":"vndb","value":"78"},"height":{"reviewState":"source-only","source":"vndb","value":"149"},"hip":{"reviewState":"source-only","source":"vndb","value":"69"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"53"},"weight":{"reviewState":"source-only","source":"vndb","value":"39"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A funny and energetic girl and Reyla's older twin. Probably the group's closest to a normal girl, if a normal girl goes following her friends on dates while wearing a giant squirrel costume in the middle of the summer. She works in her parent's american style diner Cherry Crown Diner as waitress and poster girl. She and her sister are best friends with Corona, Lamune and Luna. Every school morning she and her sister bring breakfast to them, usually by throwing the food at them."},{"spoiler":false,"text":"She's very honest and pure, which is why she's called Crystal Heart, contrary to her sister, who is mysterious and seems to be always be planning something. When Lamune is not around or not able to make the tsukkomis, Iris is the one to take up the task."},{"spoiler":false,"text":"She loves Luna, but also loves the group, and doesn't wants the group to disband because of a fight for Luna's love. When her sister proposes the \"Harem Plan\", she agrees happily, as long everyone on the group is happy too."}],"source":"vndb","sourceCharacterId":"c37592"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/472e1e759d849211cf8fff895e3d67ac45eee754df181fb1485983a0e32f8f47.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0f/0f4d65afec5ccc25030e848339ed5a57e94ccd214c5acdd08ab30226bfdcb9be.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"民安 ともえ","creatorId":"vndb:s23","sourcePersonId":"vndb:s23","canonicalEntityId":"vndb:s23","name":"民安 ともえ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66550","source":"vndb"}]},{"characterId":"char_vndb_c61704","characterName":"魔女","sourceIds":{"vndbCharacterId":"c61704"},"originalCharacterName":"魔女","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"A strange girl. Luna and Corona know her and are always on guard when shes around. When Luna and Corona's friends are around, they pretend they don't know one another."},{"spoiler":false,"text":"For some reason Luna and Corona seem to want nothing to do with her and warn her to \"Don't try to do anything\" around them or their friends."}],"source":"vndb","sourceCharacterId":"c61704"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ea/ea6ec0bc382f714b5f8978c0d49be0559c07e5dff8883db215f9785fbe83e2a8.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/9609d2aa3de784df94938ca713f439aea506954838e7f1f547d5d188eff4cb7c.webp","width":254,"height":256,"source":"static-detail"},"actors":[{"creditedName":"浅倉 ともよ","creatorId":"vndb:s5493","sourcePersonId":"vndb:s5493","canonicalEntityId":"vndb:s5493","name":"浅倉 ともよ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:66556","source":"vndb"}]},{"characterId":"char_vndb_c61705","characterName":"ゴムのアヒル","so