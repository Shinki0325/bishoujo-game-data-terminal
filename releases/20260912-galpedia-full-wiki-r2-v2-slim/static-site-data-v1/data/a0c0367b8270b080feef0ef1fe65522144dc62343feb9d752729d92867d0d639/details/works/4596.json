"},{"creditedName":"TABact1","creatorId":"vndb:s37204","sourcePersonId":"vndb:s37204","canonicalEntityId":"vndb:s37204","name":"株式会杜ティー・エー・ビー","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:56845","source":"vndb"},{"creditedName":"梺乃","creatorId":"vndb:s7332","sourcePersonId":"vndb:s7332","canonicalEntityId":"vndb:s7332","name":"梺乃 みこと","roleCode":"staff","roleLabel":"制作人员","identityStatus":"source-native","relationId":"vndb:vn-staff:56848","source":"vndb"}]},"cast":[{"characterId":"char_c6131","characterName":"古坂 あや","sourceIds":{"bangumi":[{"characterId":"88212","match":"exact-normalized-name-in-linked-work","subjectId":"99026"}],"egsCharacterIds":["26681"],"vndbCharacterId":"c6131"},"originalCharacterName":"古坂 あや","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mysterious girl that appeared when Yuuya returned to the town. Doesn't remember who she is or where she came from. Very energetic, quickly became attached to Yuuya and became a little sister for him. Has the powers of \"Shinsou\" (soul performance) and \"Shinwan\" (divine arm)."}],"source":"vndb","sourceCharacterId":"c6131"},{"segments":[{"spoiler":false,"text":"霊木の前で、突如として、虚空から出現した記憶喪失の少女。"},{"spoiler":false,"text":"主人公の義妹が行方不明であることを知り、能天気に「主人公の義妹」を宣言。"},{"spoiler":false,"text":"以来、主人公の実家で巫女として働きながら、一緒に暮らすことになる。"},{"spoiler":false,"text":"明るく純粋無垢で、騙されやすい性格。"},{"spoiler":false,"text":"しかし、主人公と暮らしていく中で、自分ではない記憶が取り戻し、思い悩んでいく。"},{"spoiler":false,"text":"彼女もまた、テレパシーと怪力の、二つの共神を持つ。"}],"source":"egs","sourceCharacterId":"26681","sourceWorkId":"4596","spoiler":false},{"segments":[{"spoiler":false,"text":"天外孤独で、ひょんなことから主人公の「義妹にさせられた少女」。"},{"spoiler":false,"text":"主人公の実家である神社で巫女として働くのだが、"},{"spoiler":false,"text":"同居人の静名に騙されて、巫女装束姿に猫耳や尻尾までつけられてしまう。"},{"spoiler":false,"text":"「あやが、お兄ちゃんの義妹になってあげる！」"}],"source":"bangumi","sourceCharacterId":"88212"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ef/ef88078312e3b54ab9a2a1ea15f05da5afdb9d01a96bb1c04030698715b8ab86.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/68/68b81107052b854925c3e67761a8965fb4a7b493f8e01312b8cc88c62bf28be6.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"小暮英麻","creatorId":"vndb:s654","sourcePersonId":"vndb:s654","canonicalEntityId":"vndb:s654","name":"小暮 英麻","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99026:88212:4282:1","source":"bangumi"}]},{"characterId":"char_c6132","characterName":"ソルネ","sourceIds":{"bangumi":[{"characterId":"142490","match":"exact-normalized-name-in-linked-work","subjectId":"99026"}],"egsCharacterIds":["26678"],"vndbCharacterId":"c6132"},"originalCharacterName":"ソルネ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"age":{"reviewState":"no-conflict","source":"vndb","value":"100"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Director of the Monogami Museum, museum where Monogami (objects that acquired sentience after a long time of use) who lost their masters stay until they can find a new one. She herself is a 100 years old monogami, and became director after the death of the previous one several decades before, who also was who made her. Believes that Yuuya is the reincarnation of him. Has the power of \"Soujou\" (thought transfer), which allows her to speak with other monogami or even objects that haven't yet become one."}],"source":"vndb","sourceCharacterId":"c6132"},{"segments":[{"spoiler":false,"text":"心を持った器物――物神（ものがみ）を保護する博物館のメイド館長さん。"},{"spoiler":false,"text":"彼女自身も100年を生きる物神（＝人形）であり、他の物神からはお母さんのように慕われている。"},{"spoiler":false,"text":"おっとりとした優しく、母性溢れる性格。"},{"spoiler":false,"text":"流石は100歳を数えるだけあって、芯が強く、しっかりしている。"},{"spoiler":false,"text":"器物にかりそめの命を与える共神を持つ。"}],"source":"egs","sourceCharacterId":"26678","sourceWorkId":"4596","spoiler":false},{"segments":[{"spoiler":false,"text":"心を持った器物―物神（ものがみ）を保護する博物館の「メイド館長さん」。"},{"spoiler":false,"text":"ソルネ自身も人形で、物神達からはお母さんのように慕われている。"},{"spoiler":false,"text":"性格はおっとりさんで、百年も生きているだけあって芯が強い。"},{"spoiler":false,"text":"「これでも百歳のおばあちゃんですから」"}],"source":"bangumi","sourceCharacterId":"142490"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0a/0aadfe8d858d6943e5a6bc44cdc5824d2acbf88c11ee77dd9492578f1011502f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/65/650fb7cc441adfa4f488a3671066dc0191671c15586f04bebeca9dd5053aebd0.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"田口宏子","creatorId":"vndb:s5","sourcePersonId":"vndb:s5","canonicalEntityId":"vndb:s5","name":"田口 宏子","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99026:142490:5020:1","source":"bangumi"}]},{"characterId":"char_c6133","characterName":"風崎 夏輝","sourceIds":{"bangumi":[],"egsCharacterIds":["26680"],"vndbCharacterId":"c6133"},"originalCharacterName":"風崎 夏輝","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Childhood friend of Yuuya, works as a nurse in the local hospital and is also Yuuya's bodyguard, protecting him from the misfortune that brings the use of \"Yui\". Current owner of \"Ugachihomura\" (piercing flame), the sword that can face the \"Magatsukaze\". Cooks very well. Despite living in a town where the supernatural is habitual, is very afraid of ghost and aliens stories."}],"source":"vndb","sourceCharacterId":"c6133"},{"segments":[{"spoiler":false,"text":"主人公と一つ屋根の下で暮らす、姉御肌の幼馴染。"},{"spoiler":false,"text":"普段は病院に勤めている看護婦さん。"},{"spoiler":false,"text":"明朗快活な性格だが、意外にへこみやすく、何かと落ち込む。"},{"spoiler":false,"text":"主人公を「自分を救ってくれた大切な恩人」と云ってはばからず、主人公のことになると、自己犠牲をいとわず、果敢に危険に身を晒す。"},{"spoiler":false,"text":"予知能力を持ち、また神剣「穿焔」の使い手でもある。"}],"source":"egs","sourceCharacterId":"26680","sourceWorkId":"4596","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/a4/a4269d99fc8e1a7b17cfa0d9355e389c15c8855b58f3b970b1f76a7dcf51a090.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/8d/8d6a6a1bc74608035c04505c1718a322ac566e9f236f5492473f7fce8235db1c.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"芹園 みや","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31653","source":"vndb"}]},{"characterId":"char_c6134","characterName":"紗雪","sourceIds":{"bangumi":[{"characterId":"88213","match":"exact-normalized-name-in-linked-work","subjectId":"99026"}],"egsCharacterIds":["26679"],"vndbCharacterId":"c6134"},"originalCharacterName":"紗雪","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Guardian of the Other World, she's actually a part of it. Doesn't show many emotions, but is particularly attached to Yuuya."}],"source":"vndb","sourceCharacterId":"c6134"},{"segments":[{"spoiler":false,"text":"主人公と幼い頃から一緒に暮らしてきた狐の霊獣少女。"},{"spoiler":false,"text":"気の遠くなるほど長く生きているらしく、こう見えて霊獣達の王女である。"},{"spoiler":false,"text":"性格は、何事にも動じず、常に平然とした表情を崩さず、マイペース。"},{"spoiler":false,"text":"何故か、主人公に懐いており、その主人公が異界で危機に陥ると、何処からともなく現れ、救ってくれたりする。"},{"spoiler":false,"text":"強大な妖怪さえも一瞬で封印する黄金の霧の使い手。"}],"source":"egs","sourceCharacterId":"26679","sourceWorkId":"4596","spoiler":false},{"segments":[{"spoiler":false,"text":"何故か主人公になついている「狐の霊獣少女」で、霊獣達の王女でもある。"},{"spoiler":false,"text":"どれくらい生きているのか覚えていないほど長生きで、神秘的な雰囲気を持つ。"},{"spoiler":false,"text":"性格はマイペースの一言。どんな物事にも動じず、"},{"spoiler":false,"text":"平然とした表情か小首を傾げてキョトンとした表情をしている。"},{"spoiler":false,"text":"「覚えていてくれなくて…いい。…側にいられれば…幸せ」"}],"source":"bangumi","sourceCharacterId":"88213"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/07/074d4a0f4598ca80405ae8a7079faf9a331676e973b254690c2e97ec5a56e0d4.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f945c5ca9aea2437154aa50f587b4347ad999595700666fdc73f46aa25858503.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"文月かな","creatorId":"vndb:s54","sourcePersonId":"vndb:s54","canonicalEntityId":"vndb:s54","name":"文月 かな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:99026:88213:22926:1","source":"bangumi"}]},{"characterId":"char_c6135","characterName":"鈴森 静名","sourceIds":{"bangumi":[],"egsCharacterIds":["26682"],"vndbCharacterId":"c6135"},"originalCharacterName":"鈴森 静名","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Became guardian of Yuuya after his parents death. Is very kind and trustworthy, but is also terrible frightful, and is an absolute authority in Yuuya's household. Owner of the café Kaguraya, in which also Yuuya, and later Aya and Solne, work. Her power is \"Kyokou\" (hollow happiness)."}],"source":"vndb","sourceCharacterId":"c6135"},{"segments":[{"spoiler":false,"text":"両親を亡くした主人公の母親代わりに育ててきたお姉さん。"},{"spoiler":false,"text":"優しいときもあれば、凶悪なときもあり、非常に掴みづらい性格。"},{"spoiler":false,"text":"それでいて、強引で、マイペース、自分で決めたことは必ず実現させる傍若無人さもある。しかし、そのほとんどは自分のためでなく、他人のためであることから、憎めない。"},{"spoiler":false,"text":"実は、守人の屈強の戦士で、主人公の持つ魔剣「禍風」の暴走を防ぎ、主人公を命がけの守っている。"},{"spoiler":false,"text":"また記憶操作の力を持ち、その力を使ったときの代償は自らの記憶を消すことらしい。"}],"source":"egs","sourceCharacterId":"26682","sourceWorkId":"4596","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/96/969059cbe2e0f64800bb83be835c5a087dcc23274df43471c1fc7275c77d56c5.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2a/2ae49f1eef4e54f202b8c8f9f266f9fc3fbe1d3c8bb28c7d384d03952d729100.webp","width":218,"height":256,"source":"static-detail"},"actors":[{"creditedName":"桐島 やよい","creatorId":"vndb:s471","sourcePersonId":"vndb:s471","canonicalEntityId":"vndb:s471","name":"力丸 乃りこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31651","source":"vndb"}]},{"characterId":"char_c6137","characterName":"刃菊","sourceIds":{"bangumi":[],"egsCharacterIds":["26683"],"vndbCharacterId":"c6137"},"originalCharacterName":"刃菊","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Several centuries old monogami of a katana. Her purpose was protecting her master, but after her death people treated her like a monstrous sword whose purpose was to kill, and her heart came to bear a deep wound."}],"source":"vndb","sourceCharacterId":"c6137"},{"segments":[{"spoiler":false,"text":"戦国の時代を駆け抜けた刀の物神。博物館の住人。"},{"spoiler":false,"text":"礼儀正しく、穏やかな性格の武人。"},{"spoiler":false,"text":"しかし、歪んだ伝説によって、妖刀扱いされ、それを気に病み、自暴自棄になって人を傷つけそうになっていたところを主人公に救われる。"},{"spoiler":false,"text":"以来、主人公を「生涯の主」と忠誠を誓い、主人公を守護する刀となる。"},{"spoiler":false,"text":"しかし、主人公と接していくうちに、忠誠心とは違った別の感情が心の中に渦巻き始める。"}],"source":"egs","sourceCharacterId":"26683","sourceWorkId":"4596","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1ea9557e9c1f880cc4368a24cb0974986057b4887537c5043a4db01ab9df475c.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1eadb88d7e4a579d4a5db59779d902f02c6d31f7c7ccc1a0100ae0470a735ed0.webp","width":147,"height":256,"source":"static-detail"},"actors":[{"creditedName":"楠 鈴音","creatorId":"vndb:s112","sourcePersonId":"vndb:s112","canonicalEntityId":"vndb:s112","name":"鳴海 エリカ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31647","source":"vndb"}]},{"characterId":"char_c6138","characterName":"紺屋美奈","sourceIds":{"bangumi":[],"egsCharacterIds":["26684"],"vndbCharacterId":"c6138"},"originalCharacterName":"紺屋美奈","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Daughter of one of the most prominent Moribito families. Timid and reserved, found happiness in playing tennis, but a severe wound in her feet has cast a shadow over her future."}],"source":"vndb","sourceCharacterId":"c6138"},{"segments":[{"spoiler":false,"text":"交通事故で足に大怪我を負ったときに、主人公の力で癒され、以来、主人公の師事し、守人の一員になるべく訓練を始めた少女。"},{"spoiler":false,"text":"そうしたことから、主人公は彼女の師匠であり、先輩。"},{"spoiler":false,"text":"気弱な上に、臆病な性格で、その幼い外見に違わず、その話し方もたどたどしい。"},{"spoiler":false,"text":"しかし、どんな辛い修行にも耐えようとする芯の強さを持つ。"},{"spoiler":false,"text":"彼女自身も、念動力の使い手。"}],"source":"egs","sourceCharacterId":"26684","sourceWorkId":"4596","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/0b/0b931877a08ab2497931de7367261e019cee67790fc310e5301e5ff36f42ce00.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/6763364c2afd167603802072fc32d1ea536e48b717d1a702382ddb951f2889d8.webp","width":111,"height":256,"source":"static-detail"},"actors":[{"creditedName":"佐々 留美子","creatorId":"vndb:s194","sourcePersonId":"vndb:s194","canonicalEntityId":"vndb:s194","name":"あおきさやか(青木静香)","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31649","source":"vndb"}]},{"characterId":"char_vndb_c103395","characterName":"真雪","sourceIds":{"vndbCharacterId":"c103395"},"originalCharacterName":"真雪","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Mysterious character strangely similar to Sayuki."}],"source":"vndb","sourceCharacterId":"c103395"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/47/47cbae154c642a8e24664bb44e8fb005570e4193cad31a8c94c0339e65dda7fd.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/12/1288d0f4d5d0981d0efc06844d09db41f0072bea0eebbb9df255acf673a82e54.webp","width":160,"height":256,"source":"static-detail"},"actors":[{"creditedName":"文月 かな","creatorId":"vndb:s54","sourcePersonId":"vndb:s54","canonicalEntityId":"vndb:s54","name":"文月 かな","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:31646","source":"vndb"}]},{"characterId":"char_vndb_c6130","characterName":"古坂 優夜","sourceIds":{"vndbCharacterId":"c6130"},"originalCharacterName