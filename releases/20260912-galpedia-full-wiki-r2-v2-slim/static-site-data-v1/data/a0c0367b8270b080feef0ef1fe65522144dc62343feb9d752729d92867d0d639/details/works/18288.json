ns":[{"segments":[{"spoiler":false,"text":"The protagonist. He makes a living delivering newspapers in the morning and working at a toy store in the afternoon. Upon meeting Nicole on the island he lives on, he becomes her apprentice as Santa Claus. He's good with people, diligent and is the type to take on the burdens of other people to help them. He likes children, and his personality allows him him to get along well with them."}],"source":"vndb","sourceCharacterId":"c18021"},{"segments":[{"spoiler":false,"text":"主人公。"},{"spoiler":false,"text":"午前中は新聞配達、午後はおもちゃ屋さんのバイトを掛け持ちするフリーター。"},{"spoiler":false,"text":"住んでいる島でサンタのニコルと出会い、サンタクロース見習いとなる。"},{"spoiler":false,"text":"人が良く、真面目で、他人の仕事まで背負い込むタイプ。"},{"spoiler":false,"text":"子供好きで、子供と対等につきあえる性格の持ち主。"}],"source":"egs","sourceCharacterId":"307","sourceWorkId":"18288","spoiler":false}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f4/f4616767d645c34da651fdef506f0f75e7cb72a9f3ef76c45e2e9777dd1c3019.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/30/304a5d5cdc60c02882abd2753b184f4755a1c8e981a680724ded09501342c6a8.webp","width":213,"height":256,"source":"static-detail"},"actors":[]},{"characterId":"char_c18022","characterName":"桐ケ谷 初花","sourceIds":{"bangumi":[{"characterId":"77478","match":"exact-normalized-name-in-linked-work","subjectId":"65581"}],"egsCharacterIds":["301"],"vndbCharacterId":"c18022"},"originalCharacterName":"桐ケ谷 初花","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"birthday":{"reviewState":"no-conflict","source":"vndb","value":"1225"},"bloodType":{"reviewState":"no-conflict","source":"vndb","value":"b"},"bust":{"reviewState":"source-only","source":"vndb","value":"65"},"height":{"reviewState":"no-conflict","source":"vndb","value":"145"},"hip":{"reviewState":"source-only","source":"vndb","value":"70"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"source-only","source":"vndb","value":"55"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"38"}},"descriptions":[{"segments":[{"spoiler":false,"text":"The tsundere daughter of a wealthy family who has lived on the island for 7 years. She's at the age where she wants to grow up quickly, so she often pretends to be tougher than she is and acts as though she is an adult, but in her heart she wishes to meet the real Santa. Christmas is her birthday."}],"source":"vndb","sourceCharacterId":"c18022"},{"segments":[{"spoiler":false,"text":"島に移り住んで7年目のツンデレお嬢様。"},{"spoiler":false,"text":"背伸びがしたいお年頃で、強がったり、大人の真似をしてみたり。"},{"spoiler":false,"text":"でも心の中では、本当のサンタに会いたいと思っている。"},{"spoiler":false,"text":"クリスマスが誕生日。"},{"spoiler":false,"text":"「あたしは、寂しくなんかないもん。別に……ひとりでも平気だし。だから、こどもあつかいしないで！」"}],"source":"egs","sourceCharacterId":"301","sourceWorkId":"18288","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"65 cm","valueContext":null,"source":"egs","sourceCharacterId":"301","sourceWorkId":"18288","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"b","valueContext":null,"source":"egs","sourceCharacterId":"301","sourceWorkId":"18288","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"145 cm","valueContext":null,"source":"egs","sourceCharacterId":"301","sourceWorkId":"18288","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"301","sourceWorkId":"18288","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"55 cm","valueContext":null,"source":"egs","sourceCharacterId":"301","sourceWorkId":"18288","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"38 kg","valueContext":null,"source":"egs","sourceCharacterId":"301","sourceWorkId":"18288","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/