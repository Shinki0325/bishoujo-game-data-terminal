らパパ、お兄ちゃん貸してっ。一緒に遊ぶの！」"}],"source":"egs","sourceCharacterId":"302","sourceWorkId":"18288","spoiler":false}],"profileFacts":[{"label":"胸围（本版本）","value":"63 cm","valueContext":null,"source":"egs","sourceCharacterId":"302","sourceWorkId":"18288","sourceField":null,"scoped":true},{"label":"罩杯（本版本）","value":"a","valueContext":null,"source":"egs","sourceCharacterId":"302","sourceWorkId":"18288","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"137 cm","valueContext":null,"source":"egs","sourceCharacterId":"302","sourceWorkId":"18288","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"70 cm","valueContext":null,"source":"egs","sourceCharacterId":"302","sourceWorkId":"18288","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"52 cm","valueContext":null,"source":"egs","sourceCharacterId":"302","sourceWorkId":"18288","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"34 kg","valueContext":null,"source":"egs","sourceCharacterId":"302","sourceWorkId":"18288","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/73/73fb41b101baaa9600218c14d0f1e2ba9a00ca37598aec975a757e767e6661b7.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/be/befdfeff1561f73ed7b0c74575eca7bd7acf8987b26806c1a124b3650c586943.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"朋永真季","creatorId":"vndb:s284","sourcePersonId":"vndb:s284","canonicalEntityId":"vndb:s284","name":"朋永 真季","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:65581:77485:6351:1","source":"bangumi"}]},{"characterId":"char_c18024","characterName":"ニコル","sourceIds":{"bangumi":[{"characterId":"77483","match":"exact-normalized-name-in-linked-work","subjectId":"65581"}],"egsCharacterIds":["303"],"vndbCharacterId":"c18024"},"originalCharacterName":"ニコル","characterNameSo