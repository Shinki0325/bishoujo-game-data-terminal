cterId":"c79769"},"originalCharacterName":"ジャンヌ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"長剣を軽々と振り回す、軍事国家グランジュの姫将軍。"},{"spoiler":false,"text":"幼い頃より、女としての自分から目を背け、剣士としての修行に明け暮れる彼女は、政治の道具よりも、武の力で王を守る道を選ぶ。"},{"spoiler":false,"text":"しかし、現在のグランジュには嫡子がいないため、いずれ婿を取らなければならないのだが、「女らしい男を婿にとればよろしいではないですか」と言ってきかない、男勝りなジャンヌは父王の悩みの種だとか。"}],"source":"egs","sourceCharacterId":"17280","sourceWorkId":"9710","spoiler":false},{"segments":[{"spoiler":false,"text":"シンと恋に落ち、“エア”、“トト”と共にシンと結婚したお姫さま。"},{"spoiler":false,"text":"現在は、人材不足なサプルで軍事を担当している。"},{"spoiler":false,"text":"女であることを頑なに否定していた自分の心を解かし、「女性として、愛する悦び」を教えてくれたシンを、愛しく見つめる日々に、幸せを感じる毎日。"},{"spoiler":false,"text":"だが、その「愛しい視線」は、他者には「厳しい視線」と受け取られることも珍しくなく、その辺りは相変わらずである。"}],"source":"egs","sourceCharacterId":"17280","sourceWorkId":"11241","spoiler":false},{"segments":[{"spoiler":false,"text":"武の国の姫将軍。"},{"spoiler":false,"text":"男でも扱いの難しいくらいの長い剣を、軽々と振り回す。"},{"spoiler":false,"text":"華麗にたなびく長髪に見とれると、痛い目にあうこと請け合い。"},{"spoiler":false,"text":"きつい目付きが、さらにその精悍さを引き立てている。"},{"spoiler":false,"text":"剣術として学んだ流派・九剣（アール・ドゥ・ヌフ・エペ）は、免許皆伝の腕前。"},{"spoiler":false,"text":"強大な軍事国家グランジュ王国の姫として生まれ、"},{"spoiler":false,"text":"政治の切り札の一枚として生きるより、自ら剣士となって、王を守る道を選んだ。"},{"spoiler":false,"text":"女としての自分からは目を背け、幼き頃からただ剣士としての修行にあけくれた。"},{"spoiler":false,"text":"グランジュには嫡子がおらず、いずれ婿を取らねばならなかった。"},{"spoiler":false,"text":"男勝りなジャンヌを案ずる父王にジャンヌは、"},{"spoiler":false,"text":"「ならば、女らしい男を婿にとればよろしいではありませんか」と言って聞かない。"},{"spoiler":false,"text":"とはいえ、王族に面なる女として、最低限の教育は受けたが、"},{"spoiler":false,"text":"いまのところ、国内では他の男たちと同様の扱いを受けている。"},{"spoiler":false,"text":"いまやジャンヌはグランジュの有能な将軍の一人であり、戦となれば、自ら先陣を切って兵士を指揮する。"}],"source":"bangumi","sourceCharacterId":"136737"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/43/439872524161522b1ae3cbc4b50727526fcc3621b5fc2380b8bd69ae9022b119.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/f9/f96a8d26f98955156375981761064fffa3e66a97cd6d9d4e44e6412904daffcc.webp","width":131,"height":256,"source":"static-detail"},"actors":[{"creditedName":"みすみ","creatorId":"vndb:s1164","sourcePersonId":"vndb:s1164","canonicalEntityId":"vndb:s1164","name":"石松 千恵美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13645","source":"vndb"}]},{"characterId":"char_c79774","characterName":"リーナ","sourceIds":{"bangumi":[{"characterId":"136739","match":"exact-normalized-name-in-linked-work","subjectId":"218149"},{"characterId":"136739","match":"exact-normalized-name-in-linked-work","subjectId":"218150"},{"characterId":"136739","match":"exact-normalized-name-in-linked-work","subjectId":"218151"},{"characterId":"136739","match":"exact-normalized-name-in-linked-work","subjectId":"218154"}],"egsCharacterIds":["15445","17281","18374"],"vndbCharacterId":"c79774"},"originalCharacterName":"リーナ","characterNameSource":null,"role":"side","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"遺跡を探す途中で立ち寄った、とある町の酒場で出会った少女。"},{"spoiler":false,"text":"その時から、なぜか主人公にずっとついてくる。"},{"spoiler":false,"text":"卓越したメイドの身のこなしを持っており、その技術で、頼みもしないのに身の回りの世話に勤しむ。"},{"spoiler":false,"text":"謎の多い女の子だが、常に主人公を気にかけており、そのにっこり笑顔は、彼のやる気を何倍にもしちゃったりする。"}],"source":"egs","sourceCharacterId":"15445","sourceWorkId":"9710","spoiler":false},{"segments":[{"spoiler":false,"text":"完全無欠のポジティブシンキングを持ち、シン王子を甲斐甲斐しく世話するメイド。"},{"spoiler":false,"text":"かつての古サプル王国がそうであったように、新生サプルもまた、いずれ大陸全土を平和にすると信じている。"},{"spoiler":false,"text":"新生サプル建国以前から、主人公の言葉を信じ、共に旅をしてきた。"},{"spoiler":false,"text":"王子の世話を一手に引き受け、サプル城のメイド長となった今でも変わらず王子を支えている。"},{"spoiler":false,"text":"忙しなく過ぎていく毎日だが、疲れたときに限って王子がかわいがってくれるので、本人にとっては充実した日々である。"},{"spoiler":false,"text":"感じやすい身体なので、仕事中でもいじられちゃうともうたまらなくなってしまう。"},{"spoiler":false,"text":"サプル完全再建も目前の今日この頃だが、さすがのリーナも一人でのお城の切り盛りには少々バテ気味！？"}],"source":"egs","sourceCharacterId":"15445","sourceWorkId":"12350","spoiler":false},{"segments":[{"spoiler":false,"text":"新生サプル建国以前から、シンと共に旅をしてきたメイド。"},{"spoiler":false,"text":"現在は、シンの世話を一手に引き受けるメイド長となって忙しい日々を送っているが、疲れた時には、シンが必ず可愛がってくれるので、本人にとってはとても充実している。"},{"spoiler":false,"text":"感じやすく、仕事中でも弄られると堪らなくなってしまう身体を持つ。"},{"spoiler":false,"text":"ちなみに、完全無欠のスーパーポジティブシンキングは、本作でも健在。"}],"source":"egs","sourceCharacterId":"17281","sourceWorkId":"11241","spoiler":false},{"segments":[{"spoiler":false,"text":"新生サプル建国以前から、シンと共に旅をしてきたメイド。"},{"spoiler":false,"text":"現在は、シンの世話を一手に引き受けるメイド長となって忙しい日々を送っているが、疲れた時にはシンが可愛がってくれるので、とても充実している。"},{"spoiler":false,"text":"感じやすく、仕事中でも弄られると堪らなくなってしまう身体を持つ。"},{"spoiler":false,"text":"ちなみに、完全無欠のスーパーポジティブシンキングは、本作でも健在。"}],"source":"egs","sourceCharacterId":"18374","sourceWorkId":"10724","spoiler":false},{"segments":[{"spoiler":false,"text":"サプルの遺跡を探す途上、とある町の酒場で出会った女の子。"},{"spoiler":false,"text":"その時から、なぜだかずっと付いて来ている。"},{"spoiler":false,"text":"なぜだか、頼まれもしないのに王子の身の回りの世話をし、"},{"spoiler":false,"text":"なぜだかエプロンドレスを着ている。"},{"spoiler":false,"text":"卓越したメイドの身のこなしを見せる、謎の多い女の子。"},{"spoiler":false,"text":"にっこり笑顔は、王子のやる気を何倍にもする。"},{"spoiler":false,"text":"完全無欠のポジティブシンキングを持ち、常に王子を気遣う。"}],"source":"bangumi","sourceCharacterId":"136739"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/88/88020e2aeba0cfd72c5ade0d44732dec850c91553a4a9e855af40792bbecd38d.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/1e/1e05ebe1d3fd33c981f33080192df48e772daa037273dbd03cba9872d72aefbf.webp","width":127,"height":256,"source":"static-detail"},"actors":[{"creditedName":"森 藍子","creatorId":"vndb:s2308","sourcePersonId":"vndb:s2308","canonicalEntityId":"vndb:s2308","name":"南川 のりこ","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"source-native","relationId":"vndb:vn-seiyuu:13646","source":"vndb"}]},{"characterId":"char_c79780","characterName":"カスミ","sourceIds":{"bangumi":[{"characterId":"136771","match":"exact-normalized-name-in-linked-work","subjectId":"218151"}],"egsCharacterIds":["17279"],"vndbCharacterId":"c79780"},"originalCharacterName":"カスミ","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"f"}},"descriptions":[{"segments":[{"spoiler":false,"text":"“ジャンヌ”の幼馴染のくの一姫。"},{"spoiler":false,"text":"卓越したスパイ活動能力を持つ小国「風雅の国」のプリンセスで、暗殺術・体術に長け、ジャンヌも一目置く存在。"},{"spoiler":false,"text":"しかし、姫さまらしく箱入りで育てられたため、一般常識に欠けており、特に性体験・知識は皆無で、異性にも興味が湧かない様子。"},{"spoiler":false,"text":"生真面目・几帳面な性格で、自国の巫女が予言した「とあるモノ」のために、一生懸命、努力するのだが……。"}],"source":"egs","sourceCharacterId":"17279","sourceWorkId":"11241","spoiler":false},{"segments":[{"spoiler":false,"text":"グランジュ王国の同盟国の忍の国（風雅の国）のくノ一プリンセス。"},{"spoiler":false,"text":"グランジュ王国の式典へ参加しにきた。"},{"spoiler":false,"text":"風雅の国は小国ながら、その卓越した情報収集能力、暗殺等のスパイ活動で大陸に確固たる位置を築いている。"},{"spoiler":false,"text":"風雅の国とグランジュ王国とは長年の友好国。カスミは子供のころから何度も遊びに来ており、"},{"spoiler":false,"text":"カスミとジャンヌは一緒に剣術の稽古などをしたこともある幼馴染。"},{"spoiler":false,"text":"暗殺術、体術の達人で、ジャンヌも一目置く存在である。"},{"spoiler":false,"text":"暗殺術や体術などの戦闘能力は鍛えられているが、箱入り姫としての生活のため、一般常識に欠ける面がある。"},{"spoiler":false,"text":"性体験はなく、その手の知識もほとんどないし、異性に対する興味もない。"},{"spoiler":false,"text":"非常に生真面目で几帳面な性格のため、自国の巫女の予言に従い一生懸命に努力をするが…。"}],"source":"bangumi","sourceCharacterId":"136771"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/da/da76684834823ce6f41c59fc1f9c573ae4bb98958152f6e90a8f8fd8ea7ede17.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/d6/d6c19d7d21c1e40d630b952c0c06859cc2ad228af571e2382e23a8d873c90e86.we