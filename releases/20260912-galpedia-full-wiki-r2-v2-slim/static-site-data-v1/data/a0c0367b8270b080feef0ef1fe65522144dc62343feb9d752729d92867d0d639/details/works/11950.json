{"schemaVersion":"galpedia-static-detail-model-v1","dataRevision":"a0c0367b8270b080feef0ef1fe65522144dc62343feb9d752729d92867d0d639","workId":"11950","model":{"presentationWorkId":"vndb:v2722","staff":{"artwork":[{"creditedName":"ティータ.J(椿T太、湊みなも)","creatorId":"vndb:s1835","sourcePersonId":"egs:creator:5033","canonicalEntityId":"vndb:s1835","name":"ティータ.J(椿T太、湊みなも)","roleCode":"artwork","roleLabel":"原画","identityStatus":"auto-confirmed","relationId":"egs:work-creator:74806","source":"egs"}],"scenario":[{"creditedName":"七瀬流","creatorId":"vndb:s7377","sourcePersonId":"egs:creator:5542","canonicalEntityId":"vndb:s7377","name":"七瀬流","roleCode":"scenario","roleLabel":"剧本","identityStatus":"auto-confirmed","relationId":"egs:work-creator:76558","source":"egs"}],"music":[{"creditedName":"マッツミュージックスタジオ(M.U.T.S.MusicStudio)","creatorId":"vndb:s414","sourcePersonId":"egs:creator:19409","canonicalEntityId":"vndb:s414","name":"マッツミュージックスタジオ(M.U.T.S.MusicStudio)","roleCode":"music","roleLabel":"作品音乐","identityStatus":"auto-confirmed","relationId":"egs:work-creator:242100","source":"egs"}],"other":[{"creditedName":"ティータ・J","creatorId":"vndb:s1835","sourcePersonId":"vndb:s1835","canonicalEntityId":"vndb:s1835","name":"ティータ・J","roleCode":"chardesign","roleLabel":"角色设计","identityStatus":"source-native","relationId":"vndb:vn-staff:37360","source":"vndb"}]},"cast":[{"characterId":"char_c33316","characterName":"古河 華絵","sourceIds":{"bangumi":[{"characterId":"89390","match":"exact-normalized-name-in-linked-work","subjectId":"265126"}],"egsCharacterIds":["15798"],"vndbCharacterId":"c33316"},"originalCharacterName":"古河 華絵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"90"},"height":{"reviewState":"no-conflict","source":"vndb","value":"160"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"92"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"59"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"48"}},"descriptions":[{"segments":[{"spoiler":false,"text":"Tomonori's Step-Mother."}],"source":"vndb","sourceCharacterId":"c33316"},{"segments":[{"spoiler":false,"text":"誠一の後妻。主人公の義母。30代後半。"},{"spoiler":false,"text":"40歳に近い年齢ながら、それを感じさせない若々しさと、熟れた女の色香を併せ持つ和服美人。良妻賢母でもあり、優しく母性に溢れ、芯もしっかりしている。"},{"spoiler":false,"text":"貞操観念が強いながらも、十数年前に主人公の父親・誠一と妻子がいることを知らず、関係を持ち、妊娠してしまう。その不倫関係は三年続くが、はっきりしない態度の誠一に愛想を尽かし、彼女は誠一と別れる。しかし、10年ぶりに誠一と再会し、紆余曲折もあって、ようやく一緒になる。"},{"spoiler":false,"text":"誠一の亡くなった先妻に対して、拭いきれない罪の意識を抱えている。"}],"source":"egs","sourceCharacterId":"15798","sourceWorkId":"11950","spoiler":false},{"segments":[{"spoiler":false,"text":"古河家に後妻として迎えられた、友則の義母。"},{"spoiler":false,"text":"和服の似合う古風な顔立ちをした、清楚な佇まいの美人。"},{"spoiler":false,"text":"普段は自慢の美しい黒髪をアップにしてまとめている。年齢を感じさせない若さと、熟れきった大人の女の色香をあわせ持っている。"},{"spoiler":false,"text":"10数年前、誠一に妻子がいるとは知らず恋愛関係になり、望まぬ妊娠をしてしまう。"},{"spoiler":false,"text":"不倫関係は3年あまり続くも、いつまで経っても華絵と一緒になろうとしない彼に愛想を尽かして離れていった。"},{"spoiler":false,"text":"だが、10年振りに再会し、どうしてもやりなおしたいと言う誠一にほだされて再び不倫関係になり、誠一の妻の死後、ようやく正妻に迎えられる。"},{"spoiler":false,"text":"性格は優しく母性本能にあふれており、芯もしっかりしている。家庭的で料理が得意。"},{"spoiler":false,"text":"貞操観念が強く、不倫とわかった後は誠一との関係に苦悩していた。また、亡くなった誠一の先妻に対して、拭いきれない罪の意識を抱えている。"},{"spoiler":false,"text":"恋愛経験は少なく、性交渉を持ったのは後にも先にも誠一のみ。昼は清楚だが、夜になると熟れきった女の顔を見せる。"}],"source":"bangumi","sourceCharacterId":"89390"}],"profileFacts":[{"label":"胸围（本版本）","value":"90 cm","valueContext":null,"source":"egs","sourceCharacterId":"15798","sourceWorkId":"11950","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"160 cm","valueContext":null,"source":"egs","sourceCharacterId":"15798","sourceWorkId":"11950","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"92 cm","valueContext":null,"source":"egs","sourceCharacterId":"15798","sourceWorkId":"11950","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"59 cm","valueContext":null,"source":"egs","sourceCharacterId":"15798","sourceWorkId":"11950","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"48 kg","valueContext":null,"source":"egs","sourceCharacterId":"15798","sourceWorkId":"11950","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/36/36926609f75756ae9008bc298e4bb354652a7dc2ff50588c28f6744479ffa65e.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/2d/2d8b1695382d70740043da6fb22354529f0fbf83898889e86e237ab104d42d09.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"山川琴美","creatorId":"vndb:s1173","sourcePersonId":"vndb:s1173","canonicalEntityId":"vndb:s1173","name":"山川 琴美","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:265126:89390:4799:1","source":"bangumi"}]},{"characterId":"char_c33317","characterName":"古河 茉莉絵","sourceIds":{"bangumi":[{"characterId":"89391","match":"exact-normalized-name-in-linked-work","subjectId":"265126"}],"egsCharacterIds":["15799"],"vndbCharacterId":"c33317"},"originalCharacterName":"古河 茉莉絵","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"bust":{"reviewState":"no-conflict","source":"bangumi","value":"86"},"height":{"reviewState":"no-conflict","source":"vndb","value":"158"},"hip":{"reviewState":"no-conflict","source":"bangumi","value":"88"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"waist":{"reviewState":"no-conflict","source":"bangumi","value":"56"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"46"}},"descriptions":[{"segments":[{"spoiler":true,"text":"Tomonori's blood-related sister, same father with different Mother."}],"source":"vndb","sourceCharacterId":"c33317"},{"segments":[{"spoiler":false,"text":"華絵の連れ子で、主人公の義妹。"},{"spoiler":false,"text":"母親譲りの整った顔立ちと、抜群のプロポーションを持った、可愛らしい少女。"},{"spoiler":false,"text":"まだ学生で、学校ではチアリーディング部に所属。"},{"spoiler":false,"text":"明るく元気で、ハツラツとした感じの彼女。楽天的でくよくよ悩んだり、落ち込んだりしない。また負けず嫌いで、こうと決めたら譲らない頑固な一面も。"},{"spoiler":false,"text":"これまで母子家庭に育った彼女は、今回の再婚には大賛成で、父と兄が出来たことに大いに喜んでいる。そして、新しい生活の中で、主人公に対して兄妹を超えた恋愛感情が芽生え始める。"}],"source":"egs","sourceCharacterId":"15799","sourceWorkId":"11950","spoiler":false},{"segments":[{"spoiler":false,"text":"華絵の連れ子で、友則にとっては義理の妹にあたる。"},{"spoiler":false,"text":"チアリーディング部に所属する学生で、セミロングの髪に明るい笑顔の似合う可愛らしい女の子。"},{"spoiler":false,"text":"母親譲りの美貌と成長しきった抜群のプロポーションを誇り、年の割には大人びて見える。"},{"spoiler":false,"text":"性格はハツラツとしていて、常に楽天的。あまりくよくよと悩んだりはしない主義。"},{"spoiler":false,"text":"可愛い顔に似合わず負けずギライで、こうと思い込んだら我を曲げないところがある。"},{"spoiler":false,"text":"これまで母ひとり子ひとりで暮らしてきたため、華絵の再婚で父と兄ができたことを喜んでいる。"},{"spoiler":false,"text":"義兄である友則に対して兄妹の域を超えた恋愛感情を抱いており、事あるごとに世話を焼きたがる。"}],"source":"bangumi","sourceCharacterId":"89391"}],"profileFacts":[{"label":"胸围（本版本）","value":"86 cm","valueContext":null,"source":"egs","sourceCharacterId":"15799","sourceWorkId":"11950","sourceField":null,"scoped":true},{"label":"身高（本版本）","value":"158 cm","valueContext":null,"source":"egs","sourceCharacterId":"15799","sourceWorkId":"11950","sourceField":null,"scoped":true},{"label":"臀围（本版本）","value":"88 cm","valueContext":null,"source":"egs","sourceCharacterId":"15799","sourceWorkId":"11950","sourceField":null,"scoped":true},{"label":"腰围（本版本）","value":"56 cm","valueContext":null,"source":"egs","sourceCharacterId":"15799","sourceWorkId":"11950","sourceField":null,"scoped":true},{"label":"体重（本版本）","value":"46 kg","valueContext":null,"source":"egs","sourceCharacterId":"15799","sourceWorkId":"11950","sourceField":null,"scoped":true}],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/ca/ca5d29404f442589b7f6ce9ddafed232a47027868cf46e224850f844bdc4ef1f.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/ch