7515","sourcePersonId":"vndb:s7515","canonicalEntityId":"vndb:s7515","name":"星 もえる","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228960:209709:20814:1","source":"bangumi"}]},{"characterId":"char_c39488","characterName":"黄緑 憐菜","sourceIds":{"bangumi":[{"characterId":"209696","match":"exact-normalized-name-in-linked-work","subjectId":"228960"},{"characterId":"209696","match":"exact-normalized-name-in-linked-work","subjectId":"24743"}],"egsCharacterIds":["16990"],"vndbCharacterId":"c39488"},"originalCharacterName":"黄緑 憐菜","characterNameSource":null,"role":"primary","status":"source-only-candidate","identityStatus":"confirmed-redirect","metadata":{"height":{"reviewState":"no-conflict","source":"vndb","value":"176"},"sex":{"reviewState":"source-only","source":"vndb","value":"f"},"weight":{"reviewState":"no-conflict","source":"vndb","value":"58"}},"descriptions":[{"segments":[{"spoiler":false,"text":"主人公の通う大学の先輩で、"},{"spoiler":false,"text":"主人公と同じサークルに所属している女性オタク。"},{"spoiler":false,"text":"しかも男性向けの同人誌マニアで、ヤオイ系や百合系は嫌い。"},{"spoiler":false,"text":"身長176センチの長身は、彼女のコンプレックスでしかなく、"},{"spoiler":false,"text":"そのためロリキャラに憧れを抱いており、マジ狩る怪盗メメ子の大ファン。"},{"spoiler":false,"text":"そのコスプレをしたいが、似合わないと思っているので、半ば諦めているようだ。"},{"spoiler":false,"text":"趣味はオタクだが、性格は至って大真面目。"},{"spoiler":false,"text":"世話好きで、頼りがいがあり、人望も厚いが、説教癖が玉に瑕。"}],"source":"egs","sourceCharacterId":"16990","sourceWorkId":"7842","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の通う大学の先輩で、主人公と同じサークル『アニメ研究会（仮）』に所属している。"},{"spoiler":false,"text":"極度の同人誌マニアで、男性向け同人誌を主に収集している。反面ヤオイや百合は嫌い。"},{"spoiler":false,"text":"よく育った自分の身体がコンプレックスとなっており、"},{"spoiler":false,"text":"憧れからロリキャラが好き。特にマジ狩る怪盗メメ子が大好きで、"},{"spoiler":false,"text":"コスプレしたいと思っているが、似合わないと思ってできないでいる。"},{"spoiler":false,"text":"まるっきり趣味はオタクなのだが、性格は堅く真面目一直線。"},{"spoiler":false,"text":"世話好きで、頼られることが多く、人望も厚い。"},{"spoiler":false,"text":"しかし説教好きなのがたまに傷だったりする。"}],"source":"egs","sourceCharacterId":"16990","sourceWorkId":"8768","spoiler":false},{"segments":[{"spoiler":false,"text":"主人公の通う大学の先輩で、主人公と同じサークル 『アニメ研究会（仮）』 に所属している。"},{"spoiler":false,"text":"極度の同人誌マニアで、男性向け同人誌を主に収集している。反面ヤオイや百合は嫌い。"},{"spoiler":false,"text":"よく育った自分の身体がコンプレックスとなっており、憧れからロリキャラが好き。"},{"spoiler":false,"text":"特に 『マジ狩る怪盗メメ子』 が大好きで、コスプレしたいと思っているが、似合わないと思ってできないでいる。"},{"spoiler":false,"text":"まるっきり趣味はオタクなのだが、性格は堅く真面目一直線。"},{"spoiler":false,"text":"世話好きで、頼られることが多く、人望も厚い。しかし説教好きなのがたまに傷だったりする。"},{"spoiler":false,"text":"「威張って言わない！」"}],"source":"bangumi","sourceCharacterId":"209696"}],"profileFacts":[],"metadataCandidateConflicts":{},"image":{"url":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/b4/b450de8a0a577badf29fa06988af0c80df4177cda1a81a38b9a7194907e0a354.webp","fallbackUrl":"https://wiki-assets.bishojo.date/terminal-wiki/v1/characters/v1/images/67/67ac8027b13aa475901d5caae5350c30fbfa3863db7b31698096cba132410ef7.webp","width":213,"height":256,"source":"static-detail"},"actors":[{"creditedName":"西沢広香","creatorId":"vndb:s609","sourcePersonId":"vndb:s609","canonicalEntityId":"vndb:s609","name":"榊木春乃","roleCode":"voice-actor","roleLabel":"声优","identityStatus":"auto-confirmed","relationId":"bangumi:character-voice:228960:209696:5890:1","source":"bangumi"}]},{"characterId":"char_vndb_c117961","characterName":"渡馬 景護","sourceIds":{"vndbCharacterId":"c117961"},"originalCharacterName":"渡馬 景護","characterNameSource":null,"role":"main","status":"source-only-candidate","identityStatus":"source-authoritative","metadata":{"sex":{"reviewState":"source-only","source":"vndb","value":"m"}},"descriptions":[],"profileFacts":[],"metadataCandidateConflicts":{},"actors":[]}],"songs":[],"companies":[{"companyId":"vndb:p403","sourceCompanyId":"egs:brand:63","canonicalEntityId":"vndb:p403","name":"Escu:de","roleCodes":["brand"],"identityStatus":"auto-confirmed","relationId":"egs:work-brand:8768:63","source":"egs"},{"companyId":"vndb:p403","sourceCompanyId":"vndb:p403","canonicalEntityId":"vndb:p403","name